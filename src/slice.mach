# owned copies of slices and byte views, their comparison and hashing, and
# vectors filled with one value

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

# a copy of a slice the caller owns, with nil data when it is empty
pub fun copy[T](a: *allocator.Allocator, s: Slice[T]) res[Slice[T], allocator.Error] {
    var out: Slice[T];
    out.data = nil;
    out.size = s.size;
    if (s.size == 0) { ret res[Slice[T], allocator.Error].ok{out}; }
    val got: res[*T, allocator.Error] = allocator.allocate[T](a, s.size);
    if (sel got.err) { ret res[Slice[T], allocator.Error].err{got.err}; }
    out.data = got.ok;
    var i: usize = 0;
    for (i < s.size) {
        out.data[i] = s.data[i];
        i           = i + 1;
    }
    ret res[Slice[T], allocator.Error].ok{out};
}

# push n copies of x onto a vector, taking the room for them at once
pub fun fill[T](v: *vector.Vector[T], n: usize, x: T) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[T](v, n);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < n) {
        vector.push[T](v, x);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# give back a slice copied by `copy`
pub fun release[T](a: *allocator.Allocator, s: Slice[T]) err[allocator.Error] {
    if (s.size == 0) { ret err[allocator.Error].ok{}; }
    ret allocator.deallocate[T](a, s.data, s.size);
}

# a copy of a byte view the caller owns
pub fun copy_view(a: *allocator.Allocator, v: View) res[View, allocator.Error] {
    val c: res[Slice[char], allocator.Error] = copy[char](a, Slice[char]{data: v.data, size: v.len});
    if (sel c.err) { ret res[View, allocator.Error].err{c.err}; }
    ret res[View, allocator.Error].ok{View{data: c.ok.data, len: c.ok.size}};
}

# give back a byte view copied by `copy_view`
pub fun release_view(a: *allocator.Allocator, v: View) err[allocator.Error] {
    ret release[char](a, Slice[char]{data: v.data, size: v.len});
}

# whether two byte views have the same bytes
pub fun same_view(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# fold one word into the running fnv-1a hash h
pub fun mix(h: u64, w: u64) u64 {
    ret (h ^ w) * 0x100000001b3;
}

# fold the bytes of a view into the running fnv-1a hash h
pub fun hash_view(h: u64, v: View) u64 {
    var acc: u64   = h;
    var i:   usize = 0;
    for (i < v.len) {
        acc = mix(acc, v.data[i]::u64);
        i   = i + 1;
    }
    ret acc;
}
