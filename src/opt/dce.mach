# dead code removal: blocks the entry cannot reach, then every instruction and
# block parameter nothing live reads
#
# an instruction may go when its opcode row states no effect on it: it is not a
# terminator, writes no memory, traps never and is not volatile, so a kept
# store or fill always stays where it is reached. a call may go as well when
# its callee's declaration states it writes nothing, never traps and always
# returns (`FunctionData.effects`). liveness grows
# from every instruction that stays, and a branch argument is read only when
# the parameter it is passed for is, so parameters that only feed each other go
# together. a value binding record never keeps code alive, since reading a
# value is no use of it. a record reading a result that goes is salvaged as a
# step over the instruction's operand when a step row names its opcode, and
# otherwise becomes unavailable at its point, never dropped. the pass adds no
# branch and never reads a secret, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.block.Predecessor;
use mirl.ir.body;
use mirl.ir.function.Body;
use mirl.ir.function.Effects;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Traps;
use mirl.ir.opcode.rule.Trap;
use mirl.ir.opcode.table;
use mirl.ir.value.Def;
use mirl.pass.analysis.read;
use mirl.pass.cache;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.pass.refusal.edit;
use mirl.pass.refusal.lost;

# the pass: it can remove blocks and values, so no analysis outlives it
pub val DCE: Pass = Pass{name: "dce", kind: Kind.optimise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}};

# one run over a function
# ---
# m:     the module
# f:     the function
# b:     its body
# block: per block, whether the entry reaches it
# value: per value, whether something live reads it
# inst:  per instruction, whether it stays
# work:  the values whose readers are not yet marked
rec Sweep {
    m:     *Module;
    f:     Function;
    b:     *Body;
    block: vector.Vector[u8];
    value: vector.Vector[u8];
    inst:  vector.Vector[u8];
    work:  vector.Vector[Value];
}

fun zeros(v: *vector.Vector[u8], n: usize) err[refusal.Error] {
    var i: usize = 0;
    for (i < n) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](v, 0);
        if (sel res_pushed.err) { ret lost(res_pushed.err); }
        i = i + 1;
    }
    ret err[refusal.Error].ok{};
}

# the row of a placed instruction, which always has one
fun row_of(d: *InstructionData) res[*Row, refusal.Error] {
    val opt_found: opt[*Row] = table.at(d.opcode);
    if (!(sel opt_found.some)) { ret res[*Row, refusal.Error].err{refusal.Error.reason{"an instruction whose opcode has no row"}}; }
    ret res[*Row, refusal.Error].ok{opt_found.some};
}

# whether an instruction may go when nothing reads it, from its row, or for a call from its callee's effects
fun removable(s: *Sweep, d: *InstructionData) res[bool, refusal.Error] {
    if (d.metadata.flags.volatile) { ret res[bool, refusal.Error].ok{false}; }
    val res_row_of: res[*Row, refusal.Error] = row_of(d);
    if (sel res_row_of.err) { ret res[bool, refusal.Error].err{res_row_of.err}; }
    val row: *Row = res_row_of.ok;
    if (read.calls(d) && !d.metadata.flags.kept) {
        val opt_callee: opt[Function] = read.callee(s.m, s.b, d);
        if (sel opt_callee.none) { ret res[bool, refusal.Error].ok{false}; }
        val stated: Effects = s.m.functions.data[opt_callee.some].data.effects;
        if (sel stated.unstated) { ret res[bool, refusal.Error].ok{false}; }
        ret res[bool, refusal.Error].ok{sel stated.stated.writes.none && !stated.stated.traps && !stated.stated.ends};
    }
    if (row.terminator || row.effects.writes) { ret res[bool, refusal.Error].ok{false}; }
    var t: usize = 0;
    for (t < $length_of(Traps)) {
        val trap: Trap = row.effects.traps[t];
        if (!(sel trap.unstated)) { ret res[bool, refusal.Error].ok{false}; }
        t = t + 1;
    }
    ret res[bool, refusal.Error].ok{true};
}

# mark a block reached, true when it was not marked before
fun mark_block(s: *Sweep, k: Block) bool {
    if (s.block.data[k] != 0) { ret false; }
    s.block.data[k] = 1;
    ret true;
}

# mark the blocks the entry reaches
fun reach(s: *Sweep) err[refusal.Error] {
    var todo: vector.Vector[Block] = vector.init[Block](s.m.a);
    fin { vector.dnit[Block](?todo); }
    mark_block(s, 0);
    val res_first: res[usize, allocator.Error] = vector.push[Block](?todo, 0);
    if (sel res_first.err) { ret lost(res_first.err); }
    for (todo.len != 0) {
        val k: Block = todo.data[todo.len - 1];
        vector.truncate[Block](?todo, todo.len - 1);
        var i: Instruction = s.b.blocks.data[k].first;
        for (i != NO_INSTRUCTION) {
            val d: *InstructionData = ?s.b.instructions.data[i];
            var e: usize            = 0;
            for (e < d.edges.len) {
                val to: Block = d.edges.data[e].block;
                if (mark_block(s, to)) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[Block](?todo, to);
                    if (sel res_pushed.err) { ret lost(res_pushed.err); }
                }
                e = e + 1;
            }
            i = s.b.instructions.data[i].next;
        }
    }
    ret err[refusal.Error].ok{};
}

# remove the blocks the entry does not reach, with their instructions
fun prune(s: *Sweep) res[bool, refusal.Error] {
    var gone: vector.Vector[Block] = vector.init[Block](s.m.a);
    fin { vector.dnit[Block](?gone); }
    var k: usize = 0;
    for (k < s.b.blocks.len) {
        if (s.block.data[k] == 0 && !s.b.blocks.data[k].erased) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Block](?gone, (k::u32));
            if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
        }
        k = k + 1;
    }
    if (gone.len == 0) { ret res[bool, refusal.Error].ok{false}; }
    val err_taken: err[refusal.Error] = edit(body.erase_unreached(s.m, s.f, Slice[Block]{data: gone.data, size: gone.len}));
    if (sel err_taken.err) { ret res[bool, refusal.Error].err{err_taken.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# mark a value read by something live and queue it, once
fun want(s: *Sweep, v: Value) err[refusal.Error] {
    if (s.value.data[v] != 0) { ret err[refusal.Error].ok{}; }
    s.value.data[v] = 1;
    val res_pushed: res[usize, allocator.Error] = vector.push[Value](?s.work, v);
    if (sel res_pushed.err) { ret lost(res_pushed.err); }
    ret err[refusal.Error].ok{};
}

# keep an instruction and want what it reads
fun keep(s: *Sweep, i: Instruction) err[refusal.Error] {
    if (s.inst.data[i] != 0) { ret err[refusal.Error].ok{}; }
    s.inst.data[i] = 1;
    val d: *InstructionData = ?s.b.instructions.data[i];
    var k: usize            = 0;
    for (k < d.operands.len) {
        val err_want: err[refusal.Error] = want(s, d.operands.data[k]);
        if (sel err_want.err) { ret err_want; }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# a wanted parameter wants the argument every edge into its block passes for it
fun feed(s: *Sweep, v: Value) err[refusal.Error] {
    val at: Def = s.b.values.data[v].def;
    if (sel at.result)       { ret keep(s, at.result.instruction); }
    if (!(sel at.parameter)) { ret err[refusal.Error].ok{}; }
    val preds: *vector.Vector[Predecessor] = ?s.b.blocks.data[at.parameter.block].predecessors;
    var p:     usize                       = 0;
    for (p < preds.len) {
        val d: *InstructionData = ?s.b.instructions.data[preds.data[p].instruction];
        var e: usize            = 0;
        for (e < d.edges.len) {
            if (d.edges.data[e].block == at.parameter.block) {
                val err_want: err[refusal.Error] = want(s, d.edges.data[e].arguments.data[at.parameter.index]);
                if (sel err_want.err) { ret err_want; }
            }
            e = e + 1;
        }
        p = p + 1;
    }
    ret err[refusal.Error].ok{};
}

# grow liveness from every instruction that stays and the entry's parameters
fun live(s: *Sweep) err[refusal.Error] {
    var k: usize = 0;
    for (k < s.b.blocks.len) {
        if (!s.b.blocks.data[k].erased) {
            var i: Instruction = s.b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                val res_may: res[bool, refusal.Error] = removable(s, ?s.b.instructions.data[i]);
                if (sel res_may.err) { ret err[refusal.Error].err{res_may.err}; }
                if (!res_may.ok) {
                    val err_keep: err[refusal.Error] = keep(s, i);
                    if (sel err_keep.err) { ret err_keep; }
                }
                i = s.b.instructions.data[i].next;
            }
        }
        k = k + 1;
    }
    val entry: *vector.Vector[Value] = ?s.b.blocks.data[0].parameters;
    k = 0;
    for (k < entry.len) {
        val err_want: err[refusal.Error] = want(s, entry.data[k]);
        if (sel err_want.err) { ret err_want; }
        k = k + 1;
    }
    for (s.work.len != 0) {
        val v: Value = s.work.data[s.work.len - 1];
        vector.truncate[Value](?s.work, s.work.len - 1);
        val err_feed: err[refusal.Error] = feed(s, v);
        if (sel err_feed.err) { ret err_feed; }
    }
    ret err[refusal.Error].ok{};
}

# whether a value goes with this sweep: the result of an instruction that
# goes, or a parameter nothing live reads
# salvage every record that reads a result that goes: a step over the
# instruction's operand by the step row naming its opcode, again while that
# operand goes too, and unavailable when no row applies
fun salvage(s: *Sweep, v: Value) err[refusal.Error] {
    ret edit(body.salvage_bound(s.m, s.f, v, Slice[u8]{data: s.inst.data, size: s.inst.len}, Slice[u8]{data: s.value.data, size: s.value.len}));
}

# remove what nothing live reads
fun sweep(s: *Sweep) res[bool, refusal.Error] {
    var gone: vector.Vector[Instruction] = vector.init[Instruction](s.m.a);
    var dead: vector.Vector[Value]       = vector.init[Value](s.m.a);
    fin {
        vector.dnit[Instruction](?gone);
        vector.dnit[Value](?dead);
    }
    var k: usize = 0;
    for (k < s.b.blocks.len) {
        if (!s.b.blocks.data[k].erased) {
            var i: Instruction = s.b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                if (s.inst.data[i] == 0) {
                    val results: *List[Value] = ?s.b.instructions.data[i].results;
                    var r:       usize        = 0;
                    for (r < results.len) {
                        val err_saved: err[refusal.Error] = salvage(s, results.data[r]);
                        if (sel err_saved.err) { ret res[bool, refusal.Error].err{err_saved.err}; }
                        r = r + 1;
                    }
                    val res_pushed: res[usize, allocator.Error] = vector.push[Instruction](?gone, i);
                    if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
                }
                i = s.b.instructions.data[i].next;
            }
            if (k != 0) {
                val params: *vector.Vector[Value] = ?s.b.blocks.data[k].parameters;
                var j:      usize                 = 0;
                for (j < params.len) {
                    if (s.value.data[params.data[j]] == 0) {
                        val res_pushed: res[usize, allocator.Error] = vector.push[Value](?dead, params.data[j]);
                        if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
                    }
                    j = j + 1;
                }
            }
        }
        k = k + 1;
    }
    if (gone.len == 0 && dead.len == 0) { ret res[bool, refusal.Error].ok{false}; }
    val err_taken: err[refusal.Error] = edit(body.remove_dead(s.m, s.f, Slice[Instruction]{data: gone.data, size: gone.len}, Slice[Value]{data: dead.data, size: dead.len}));
    if (sel err_taken.err) { ret res[bool, refusal.Error].err{err_taken.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# prune the unreached blocks, then grow liveness and sweep what is dead, true
# when either removed something
fun run(s: *Sweep) res[bool, refusal.Error] {
    val err_shape: err[refusal.Error] = zeros(?s.block, s.b.blocks.len);
    if (sel err_shape.err) { ret res[bool, refusal.Error].err{err_shape.err}; }
    val err_reached: err[refusal.Error] = reach(s);
    if (sel err_reached.err) { ret res[bool, refusal.Error].err{err_reached.err}; }
    val res_cut: res[bool, refusal.Error] = prune(s);
    if (sel res_cut.err) { ret res_cut; }
    val err_sized: err[refusal.Error] = zeros(?s.value, s.b.values.len);
    if (sel err_sized.err) { ret res[bool, refusal.Error].err{err_sized.err}; }
    val err_counted: err[refusal.Error] = zeros(?s.inst, s.b.instructions.len);
    if (sel err_counted.err) { ret res[bool, refusal.Error].err{err_counted.err}; }
    val err_grown: err[refusal.Error] = live(s);
    if (sel err_grown.err) { ret res[bool, refusal.Error].err{err_grown.err}; }
    val res_swept: res[bool, refusal.Error] = sweep(s);
    if (sel res_swept.err) { ret res_swept; }
    ret res[bool, refusal.Error].ok{res_cut.ok || res_swept.ok};
}

# remove the dead code of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val m:        *Module                  = u.context.m;
    val res_body: res[*Body, module.Error] = module.body(m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    var s: Sweep = Sweep{m: m, f: u.f, b: res_body.ok, block: vector.init[u8](m.a), value: vector.init[u8](m.a), inst: vector.init[u8](m.a), work: vector.init[Value](m.a)};
    fin {
        vector.dnit[u8](?s.block);
        vector.dnit[u8](?s.value);
        vector.dnit[u8](?s.inst);
        vector.dnit[Value](?s.work);
    }
    ret run(?s);
}
