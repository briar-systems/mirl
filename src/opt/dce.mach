# dead code removal: blocks the entry cannot reach, then every instruction and
# block parameter nothing live reads
#
# an instruction may go when its opcode row states no effect on it: it is not a
# terminator, writes no memory, traps never and is not volatile. liveness grows
# from every instruction that stays, and a branch argument is read only when
# the parameter it is passed for is, so parameters that only feed each other go
# together. a debug binding never keeps code alive, since it is a fact of the
# instruction it names. one on code that goes moves onto a live instruction
# that computes the same value, and is otherwise dropped with the code. the
# pass adds no branch and never reads a secret, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mirl.ir.body;
use mirl.ir.debug.Binding;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata.Bindings;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Traps;
use mirl.ir.opcode.rule.Ordering;
use mirl.ir.opcode.rule.Trap;
use mirl.ir.opcode.table;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.value.Def;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.cache.Cache;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use targets: mirl.target;
use mirl.target.Target;
use mirl.verify;

# the pass: it can remove blocks and values, so no analysis outlives it
pub val DCE: Pass = Pass{name: "dce", kind: Kind.optimise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}};

# one run over a function
# ---
# m:     the module
# f:     the function
# b:     its body
# block: per block, whether the entry reaches it
# value: per value, whether something live reads it
# inst:  per instruction, whether it stays
# work:  the values whose readers are not yet marked
rec Sweep {
    m:     *Module;
    f:     Function;
    b:     *Body;
    block: vector.Vector[u8];
    value: vector.Vector[u8];
    inst:  vector.Vector[u8];
    work:  vector.Vector[Value];
}

fun lost(e: allocator.Error) err[Why] {
    ret err[Why].err{Why.alloc{e}};
}

fun edit(r: err[module.Error]) err[Why] {
    if (sel r.err) { ret err[Why].err{Why.ir{r.err}}; }
    ret err[Why].ok{};
}

fun zeros(v: *vector.Vector[u8], n: usize) err[Why] {
    var i: usize = 0;
    for (i < n) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, 0);
        if (sel pushed.err) { ret lost(pushed.err); }
        i = i + 1;
    }
    ret err[Why].ok{};
}

# whether an instruction may go when nothing reads it, from its row alone
fun removable(d: *InstructionData) bool {
    if (d.metadata.flags.volatile) { ret false; }
    val found: opt[Row] = table.row(d.opcode);
    if (!(sel found.some)) { ret false; }
    val row: Row = found.some;
    if (row.terminator || row.effects.writes) { ret false; }
    var t: usize = 0;
    for (t < $length_of(Traps)) {
        val trap: Trap = row.effects.traps[t];
        if (!(sel trap.unstated)) { ret false; }
        t = t + 1;
    }
    ret true;
}

fun mark_block(s: *Sweep, k: Block) bool {
    if (s.block.data[k.index] != 0) { ret false; }
    s.block.data[k.index] = 1;
    ret true;
}

# mark the blocks the entry reaches
fun reach(s: *Sweep) err[Why] {
    var todo: vector.Vector[Block] = vector.init[Block](s.m.a);
    fin { vector.dnit[Block](?todo); }
    mark_block(s, Block{index: 0});
    val first: res[usize, allocator.Error] = vector.push[Block](?todo, Block{index: 0});
    if (sel first.err) { ret lost(first.err); }
    for (todo.len != 0) {
        val k: Block = todo.data[todo.len - 1];
        todo.len = todo.len - 1;
        val list: *vector.Vector[Instruction] = ?s.b.blocks.data[k.index].instructions;
        var i:    usize                       = 0;
        for (i < list.len) {
            val d: *InstructionData = ?s.b.instructions.data[list.data[i].index];
            var e: usize            = 0;
            for (e < d.edges.len) {
                val to: Block = d.edges.data[e].block;
                if (mark_block(s, to)) {
                    val pushed: res[usize, allocator.Error] = vector.push[Block](?todo, to);
                    if (sel pushed.err) { ret lost(pushed.err); }
                }
                e = e + 1;
            }
            i = i + 1;
        }
    }
    ret err[Why].ok{};
}

# remove the blocks the entry does not reach, with their instructions
fun prune(s: *Sweep) res[bool, Why] {
    var gone: vector.Vector[Instruction] = vector.init[Instruction](s.m.a);
    fin { vector.dnit[Instruction](?gone); }
    var k:   usize = 0;
    var any: bool  = false;
    for (k < s.b.blocks.len) {
        if (s.block.data[k] == 0 && !s.b.blocks.data[k].erased) {
            any = true;
            val list: *vector.Vector[Instruction] = ?s.b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                val pushed: res[usize, allocator.Error] = vector.push[Instruction](?gone, list.data[i]);
                if (sel pushed.err) { ret res[bool, Why].err{Why.alloc{pushed.err}}; }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    if (!any) { ret res[bool, Why].ok{false}; }
    val taken: err[Why] = edit(body.remove_dead(s.m, s.f, Slice[Instruction]{data: gone.data, size: gone.len}, Slice[Value]{data: nil, size: 0}));
    if (sel taken.err) { ret res[bool, Why].err{taken.err}; }
    k = 0;
    for (k < s.b.blocks.len) {
        if (s.block.data[k] == 0 && !s.b.blocks.data[k].erased) {
            val erased: err[Why] = edit(body.erase_block(s.m, s.f, Block{index: k::u32}));
            if (sel erased.err) { ret res[bool, Why].err{erased.err}; }
        }
        k = k + 1;
    }
    ret res[bool, Why].ok{true};
}

fun want(s: *Sweep, v: Value) err[Why] {
    if (s.value.data[v.index] != 0) { ret err[Why].ok{}; }
    s.value.data[v.index] = 1;
    val pushed: res[usize, allocator.Error] = vector.push[Value](?s.work, v);
    if (sel pushed.err) { ret lost(pushed.err); }
    ret err[Why].ok{};
}

# keep an instruction and want what it reads
fun keep(s: *Sweep, i: Instruction) err[Why] {
    if (s.inst.data[i.index] != 0) { ret err[Why].ok{}; }
    s.inst.data[i.index] = 1;
    val d: *InstructionData = ?s.b.instructions.data[i.index];
    var k: usize            = 0;
    for (k < d.operands.len) {
        val r: err[Why] = want(s, d.operands.data[k]);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    ret err[Why].ok{};
}

# a wanted parameter wants the argument every edge into its block passes for it
fun feed(s: *Sweep, v: Value) err[Why] {
    val at: Def = s.b.values.data[v.index].def;
    if (sel at.result)       { ret keep(s, at.result.instruction); }
    if (!(sel at.parameter)) { ret err[Why].ok{}; }
    val preds: *vector.Vector[Instruction] = ?s.b.blocks.data[at.parameter.block.index].predecessors;
    var p:     usize                       = 0;
    for (p < preds.len) {
        val d: *InstructionData = ?s.b.instructions.data[preds.data[p].index];
        var e: usize            = 0;
        for (e < d.edges.len) {
            if (d.edges.data[e].block.index == at.parameter.block.index) {
                val r: err[Why] = want(s, d.edges.data[e].arguments.data[at.parameter.index]);
                if (sel r.err) { ret r; }
            }
            e = e + 1;
        }
        p = p + 1;
    }
    ret err[Why].ok{};
}

# grow liveness from every instruction that stays and the entry's parameters
fun live(s: *Sweep) err[Why] {
    var k: usize = 0;
    for (k < s.b.blocks.len) {
        if (!s.b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?s.b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                if (!removable(?s.b.instructions.data[list.data[i].index])) {
                    val r: err[Why] = keep(s, list.data[i]);
                    if (sel r.err) { ret r; }
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    val entry: *vector.Vector[Value] = ?s.b.blocks.data[0].parameters;
    k = 0;
    for (k < entry.len) {
        val r: err[Why] = want(s, entry.data[k]);
        if (sel r.err) { ret r; }
        k = k + 1;
    }
    for (s.work.len != 0) {
        val v: Value = s.work.data[s.work.len - 1];
        s.work.len = s.work.len - 1;
        val r: err[Why] = feed(s, v);
        if (sel r.err) { ret r; }
    }
    ret err[Why].ok{};
}

fun same_ordering(a: Ordering, b: Ordering) bool {
    if (sel a.relaxed) { ret sel b.relaxed; }
    if (sel a.acquire) { ret sel b.acquire; }
    if (sel a.release) { ret sel b.release; }
    if (sel a.acq_rel) { ret sel b.acq_rel; }
    ret sel b.seq_cst;
}

fun same_lanes(a: Slice[u32], b: Slice[u32]) bool {
    if (a.size != b.size) { ret false; }
    var i: usize = 0;
    for (i < a.size) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_immediate(a: Immediate, b: Immediate) bool {
    if (sel a.ty)        { ret sel b.ty && a.ty.index == b.ty.index; }
    if (sel a.alignment) { ret sel b.alignment && a.alignment == b.alignment; }
    if (sel a.lane)      { ret sel b.lane && a.lane == b.lane; }
    if (sel a.ordering)  { ret sel b.ordering && same_ordering(a.ordering, b.ordering); }
    if (sel a.lanes)     { ret sel b.lanes && same_lanes(a.lanes, b.lanes); }
    ret false;
}

# whether two instructions of a mergeable opcode give the same results
fun twins(s: *Sweep, a: *InstructionData, b: *InstructionData) bool {
    if (a.opcode.index != b.opcode.index)     { ret false; }
    if (a.operands.len != b.operands.len)     { ret false; }
    if (a.immediates.len != b.immediates.len) { ret false; }
    if (a.results.len != b.results.len)       { ret false; }
    var i: usize = 0;
    for (i < a.operands.len) {
        if (a.operands.data[i].index != b.operands.data[i].index) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.immediates.len) {
        if (!same_immediate(a.immediates.data[i], b.immediates.data[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.results.len) {
        if (s.b.values.data[a.results.data[i].index].type.index != s.b.values.data[b.results.data[i].index].type.index) { ret false; }
        i = i + 1;
    }
    ret true;
}

# add the bindings of a dead instruction to a live one that computes the same
fun move_bindings(s: *Sweep, from: Instruction, to: Instruction) err[Why] {
    val given: res[Slice[Binding], module.Error] = module.bound(s.m, s.b.instructions.data[from.index].metadata.bindings);
    if (sel given.err) { ret err[Why].err{Why.ir{given.err}}; }
    val held: res[Slice[Binding], module.Error] = module.bound(s.m, s.b.instructions.data[to.index].metadata.bindings);
    if (sel held.err) { ret err[Why].err{Why.ir{held.err}}; }
    var list: vector.Vector[Binding] = vector.init[Binding](s.m.a);
    fin { vector.dnit[Binding](?list); }
    var n: usize = 0;
    for (n < held.ok.size) {
        val pushed: res[usize, allocator.Error] = vector.push[Binding](?list, held.ok.data[n]);
        if (sel pushed.err) { ret lost(pushed.err); }
        n = n + 1;
    }
    var fresh: bool = false;
    n = 0;
    for (n < given.ok.size) {
        var known: bool  = false;
        var k:     usize = 0;
        for (k < held.ok.size) {
            if (held.ok.data[k].index == given.ok.data[n].index) { known = true; }
            k = k + 1;
        }
        if (!known) {
            val pushed: res[usize, allocator.Error] = vector.push[Binding](?list, given.ok.data[n]);
            if (sel pushed.err) { ret lost(pushed.err); }
            fresh = true;
        }
        n = n + 1;
    }
    if (!fresh) { ret err[Why].ok{}; }
    val made: res[Bindings, module.Error] = module.bindings(s.m, Slice[Binding]{data: list.data, size: list.len});
    if (sel made.err) { ret err[Why].err{Why.ir{made.err}}; }
    var md: Metadata = s.b.instructions.data[to.index].metadata;
    md.bindings = made.ok;
    ret edit(body.set_metadata(s.m, s.f, to, md));
}

# move the bindings of an instruction that goes onto a live twin if it has one
fun salvage(s: *Sweep, i: Instruction) err[Why] {
    val d: *InstructionData = ?s.b.instructions.data[i.index];
    if (d.metadata.bindings.index == 0 || d.operands.len == 0 || d.results.len == 0) { ret err[Why].ok{}; }
    val found: opt[Row] = table.row(d.opcode);
    if (!(sel found.some)) { ret err[Why].ok{}; }
    val row: Row = found.some;
    if (!row.effects.mergeable) { ret err[Why].ok{}; }
    val users: *vector.Vector[Instruction] = ?s.b.values.data[d.operands.data[0].index].uses;
    var u:     usize                       = 0;
    for (u < users.len) {
        val c: Instruction = users.data[u];
        if (c.index != i.index && s.inst.data[c.index] != 0 && twins(s, d, ?s.b.instructions.data[c.index])) {
            ret move_bindings(s, i, c);
        }
        u = u + 1;
    }
    ret err[Why].ok{};
}

# remove what nothing live reads
fun sweep(s: *Sweep) res[bool, Why] {
    var gone: vector.Vector[Instruction] = vector.init[Instruction](s.m.a);
    var dead: vector.Vector[Value]       = vector.init[Value](s.m.a);
    fin {
        vector.dnit[Instruction](?gone);
        vector.dnit[Value](?dead);
    }
    var k: usize = 0;
    for (k < s.b.blocks.len) {
        if (!s.b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?s.b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                if (s.inst.data[list.data[i].index] == 0) {
                    val saved: err[Why] = salvage(s, list.data[i]);
                    if (sel saved.err) { ret res[bool, Why].err{saved.err}; }
                    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?gone, list.data[i]);
                    if (sel pushed.err) { ret res[bool, Why].err{Why.alloc{pushed.err}}; }
                }
                i = i + 1;
            }
            if (k != 0) {
                val params: *vector.Vector[Value] = ?s.b.blocks.data[k].parameters;
                i = 0;
                for (i < params.len) {
                    if (s.value.data[params.data[i].index] == 0) {
                        val pushed: res[usize, allocator.Error] = vector.push[Value](?dead, params.data[i]);
                        if (sel pushed.err) { ret res[bool, Why].err{Why.alloc{pushed.err}}; }
                    }
                    i = i + 1;
                }
            }
        }
        k = k + 1;
    }
    if (gone.len == 0 && dead.len == 0) { ret res[bool, Why].ok{false}; }
    val taken: err[Why] = edit(body.remove_dead(s.m, s.f, Slice[Instruction]{data: gone.data, size: gone.len}, Slice[Value]{data: dead.data, size: dead.len}));
    if (sel taken.err) { ret res[bool, Why].err{taken.err}; }
    ret res[bool, Why].ok{true};
}

fun run(s: *Sweep) res[bool, Why] {
    val shape: err[Why] = zeros(?s.block, s.b.blocks.len);
    if (sel shape.err) { ret res[bool, Why].err{shape.err}; }
    val reached: err[Why] = reach(s);
    if (sel reached.err) { ret res[bool, Why].err{reached.err}; }
    val cut: res[bool, Why] = prune(s);
    if (sel cut.err) { ret cut; }
    val sized: err[Why] = zeros(?s.value, s.b.values.len);
    if (sel sized.err) { ret res[bool, Why].err{sized.err}; }
    val counted: err[Why] = zeros(?s.inst, s.b.instructions.len);
    if (sel counted.err) { ret res[bool, Why].err{counted.err}; }
    val grown: err[Why] = live(s);
    if (sel grown.err) { ret res[bool, Why].err{grown.err}; }
    val swept: res[bool, Why] = sweep(s);
    if (sel swept.err) { ret swept; }
    ret res[bool, Why].ok{cut.ok || swept.ok};
}

# remove the dead code of one function
fun visit(u: *Unit) res[bool, Why] {
    val m:   *Module                  = u.context.m;
    val got: res[*Body, module.Error] = module.body(m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }
    var s: Sweep = Sweep{m: m, f: u.f, b: got.ok, block: vector.init[u8](m.a), value: vector.init[u8](m.a), inst: vector.init[u8](m.a), work: vector.init[Value](m.a)};
    fin {
        vector.dnit[u8](?s.block);
        vector.dnit[u8](?s.value);
        vector.dnit[u8](?s.inst);
        vector.dnit[Value](?s.work);
    }
    ret run(?s);
}

#[testing]
fun check(before: str, after: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.row(0);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    var c: Cache   = cache.init(?m, analysis.rows());
    var x: Context = Context{m: ?m, t: row.some, cache: ?c, pass: ?DCE};
    fin { cache.dnit(?c); }
    var u:   Unit           = Unit{context: ?x, f: Function{index: 0}};
    val ran: res[bool, Why] = visit(?u);
    if (sel ran.err) { ret 4; }
    if (!ran.ok)     { ret 4; }
    val checked: err[verify.Error] = verify.against(?m, row.some);
    if (sel checked.err) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    var again: res[bool, Why] = visit(?u);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 7; }
    ret 0;
}

test dce__unused_is_removed_and_trapping_is_kept {
    val before: str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"v\" !t0 declared !l0 value\nfunction @f: fun(i32, i32) -> (i32) {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y\n    %d = add %x, %y bind [!v0]\n    %unused = mul %x, %y\n    %q = div.s %x, %y\n    ret %a\n}\n";
    val after:  str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"v\" !t0 declared !l0 value\nfunction @f: fun(i32, i32) -> (i32) {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y bind [!v0]\n    %q = div.s %x, %y\n    ret %a\n}\n";
    ret check(before, after);
}

test dce__unreachable_block_goes_with_its_arguments {
    val before: str = "target \"riscv64-linux\"\nfunction @g: fun(i32) -> (i32) {\n^entry(%x: i32):\n    br ^head(%x, %x)\n^orphan(%o: i32):\n    %z = add %o, %o\n    br ^head(%z, %z)\n^head(%v: i32, %c: i32):\n    %next = add %c, i32 1\n    %again = lt.s %v, i32 10\n    cbr %again, ^head(%v, %next), ^exit\n^exit:\n    ret %v\n}\n";
    val after:  str = "target \"riscv64-linux\"\nfunction @g: fun(i32) -> (i32) {\n^entry(%x: i32):\n    br ^head(%x)\n^head(%v: i32):\n    %again = lt.s %v, i32 10\n    cbr %again, ^head(%v), ^exit\n^exit:\n    ret %v\n}\n";
    ret check(before, after);
}
