# text tests of common subexpression elimination, run through the driver

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.cse.CSE;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.register.machine;

#[testing]
fun check(before: str, after: str, changes: bool) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, machine.BARE, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?CSE);
    if (sel ran.err)       { ret 4; }
    if (ran.ok != changes) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, ?CSE);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 7; }
    ret 0;
}

test cse__repeated_computation_is_merged {
    # a swapped commutative repeat in one block, and a repeat in a dominated block
    val before: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y\n    %b = add %y, %x\n    %c = mul %a, %b\n    %t = lt.s %c, i32 10\n    cbr %t, ^then, ^exit(%c)\n^then:\n    %d = add %x, %y\n    %e = sub %d, i32 1\n    br ^exit(%e)\n^exit(%r: i32):\n    ret %r\n}\n";
    val after:  str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y\n    %c = mul %a, %a\n    %t = lt.s %c, i32 10\n    cbr %t, ^then, ^exit(%c)\n^then:\n    %e = sub %a, i32 1\n    br ^exit(%e)\n^exit(%r: i32):\n    ret %r\n}\n";
    ret check(before, after, true);
}

test cse__load_across_aliasing_store_is_not_merged {
    # the pointer may alias the store, so its two loads stay. a store to a slot of its own cannot touch the other slot, so those two loads merge
    val before: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @g: fun(ptr, i32) -> (i32) linkage global visibility default {\n^entry(%p: ptr, %v: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    %t = alloca type i32, pointer ptr, align 4\n    %a = load %p, type i32, align 4\n    store %p, %v, align 4\n    %b = load %p, type i32, align 4\n    %c = load %s, type i32, align 4\n    store %t, %v, align 4\n    %d = load %s, type i32, align 4\n    %e = add %a, %b\n    %f = add %c, %d\n    %r = add %e, %f\n    ret %r\n}\n";
    val after:  str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @g: fun(ptr, i32) -> (i32) linkage global visibility default {\n^entry(%p: ptr, %v: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    %t = alloca type i32, pointer ptr, align 4\n    %a = load %p, type i32, align 4\n    store %p, %v, align 4\n    %b = load %p, type i32, align 4\n    %c = load %s, type i32, align 4\n    store %t, %v, align 4\n    %e = add %a, %b\n    %f = add %c, %c\n    %r = add %e, %f\n    ret %r\n}\n";
    ret check(before, after, true);
}

test cse__different_secrecy_is_not_merged {
    val text: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @s: fun(i32, i32, ptr) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32, %p: ptr):\n    %a = add %x, %y\n    %b = add %x, %y secret\n    store %p, %b, align 4\n    ret %a\n}\n";
    ret check(text, text, false);
}
