# text tests of loop invariant code motion, run through the driver

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.licm.LICM;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.register.machine;

#[testing]
fun check(before: str, after: str, changes: bool) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, machine.BARE, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?LICM);
    if (sel ran.err)       { ret 4; }
    if (ran.ok != changes) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, ?LICM);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 7; }
    ret 0;
}

test licm__invariant_computation_moves_to_the_preheader {
    # a loop entered from two blocks gets one preheader, the invariant product goes there and its record keeps reading it
    val before: str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"k\" !t0 declared !l0\nfunction @f: fun(i1, i32, i32) -> (i32) linkage global visibility default {\n^entry(%f: i1, %x: i32, %y: i32):\n    cbr %f, ^left, ^right\n^left:\n    br ^head(i32 0)\n^right:\n    br ^head(i32 1)\n^head(%i: i32):\n    %k = mul %x, %y\n    bind !v0 = %k\n    %c = lt.s %i, %k\n    cbr %c, ^body, ^exit\n^body:\n    %next = add %i, i32 1\n    br ^head(%next)\n^exit:\n    ret %i\n}\n";
    val after:  str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"k\" !t0 declared !l0\nfunction @f: fun(i1, i32, i32) -> (i32) linkage global visibility default {\n^entry(%f: i1, %x: i32, %y: i32):\n    cbr %f, ^left, ^right\n^left:\n    br ^pre(i32 0)\n^right:\n    br ^pre(i32 1)\n^pre(%s: i32):\n    %k = mul %x, %y\n    br ^head(%s)\n^head(%i: i32):\n    bind !v0 = %k\n    %c = lt.s %i, %k\n    cbr %c, ^body, ^exit\n^body:\n    %next = add %i, i32 1\n    br ^head(%next)\n^exit:\n    ret %i\n}\n";
    ret check(before, after, true);
}

test licm__trapping_operation_stays_in_a_loop_that_may_not_run {
    # the division by a variable stays since the loop may run no trip, the one by three cannot trap and moves
    val before: str = "target \"riscv64-linux\"\nfunction @f: fun(i32, i32, i32) -> (i32) linkage global visibility default {\n^entry(%n: i32, %a: i32, %b: i32):\n    br ^head(i32 0, i32 0)\n^head(%i: i32, %acc: i32):\n    %c = lt.s %i, %n\n    cbr %c, ^body, ^exit\n^body:\n    %q = div.s %a, %b\n    %r = div.s %a, i32 3\n    %next = add %i, i32 1\n    %s = add %q, %r\n    %sum = add %acc, %s\n    br ^head(%next, %sum)\n^exit:\n    ret %acc\n}\n";
    val after:  str = "target \"riscv64-linux\"\nfunction @f: fun(i32, i32, i32) -> (i32) linkage global visibility default {\n^entry(%n: i32, %a: i32, %b: i32):\n    %r = div.s %a, i32 3\n    br ^head(i32 0, i32 0)\n^head(%i: i32, %acc: i32):\n    %c = lt.s %i, %n\n    cbr %c, ^body, ^exit\n^body:\n    %q = div.s %a, %b\n    %next = add %i, i32 1\n    %s = add %q, %r\n    %sum = add %acc, %s\n    br ^head(%next, %sum)\n^exit:\n    ret %acc\n}\n";
    ret check(before, after, true);
}

test licm__load_is_not_hoisted_past_an_aliasing_store {
    # a store to the slot a load reads keeps it, a store to the other slot does not, and a store through a pointer of no known base keeps every load
    val before: str = "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%n: i32, %v: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    %t = alloca type i32, pointer ptr, align 4\n    store %s, %v, align 4\n    store %t, %v, align 4\n    br ^head(i32 0, i32 0)\n^head(%i: i32, %acc: i32):\n    %x = load %s, type i32, align 4\n    %y = load %t, type i32, align 4\n    %c = lt.s %i, %n\n    cbr %c, ^body, ^exit\n^body:\n    %m = add %x, %y\n    store %t, %m, align 4\n    %next = add %i, i32 1\n    %sum = add %acc, %m\n    br ^head(%next, %sum)\n^exit:\n    ret %acc\n}\nfunction @g: fun(ptr, i32) -> (i32) linkage global visibility default {\n^entry(%p: ptr, %n: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    store %s, %n, align 4\n    br ^head(i32 0)\n^head(%i: i32):\n    %x = load %s, type i32, align 4\n    %c = lt.s %i, %x\n    cbr %c, ^body, ^exit\n^body:\n    store %p, %i, align 4\n    %next = add %i, i32 1\n    br ^head(%next)\n^exit:\n    ret %i\n}\n";
    val after:  str = "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%n: i32, %v: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    %t = alloca type i32, pointer ptr, align 4\n    store %s, %v, align 4\n    store %t, %v, align 4\n    %x = load %s, type i32, align 4\n    br ^head(i32 0, i32 0)\n^head(%i: i32, %acc: i32):\n    %y = load %t, type i32, align 4\n    %c = lt.s %i, %n\n    cbr %c, ^body, ^exit\n^body:\n    %m = add %x, %y\n    store %t, %m, align 4\n    %next = add %i, i32 1\n    %sum = add %acc, %m\n    br ^head(%next, %sum)\n^exit:\n    ret %acc\n}\nfunction @g: fun(ptr, i32) -> (i32) linkage global visibility default {\n^entry(%p: ptr, %n: i32):\n    %s = alloca type i32, pointer ptr, align 4\n    store %s, %n, align 4\n    br ^head(i32 0)\n^head(%i: i32):\n    %x = load %s, type i32, align 4\n    %c = lt.s %i, %x\n    cbr %c, ^body, ^exit\n^body:\n    store %p, %i, align 4\n    %next = add %i, i32 1\n    br ^head(%next)\n^exit:\n    ret %i\n}\n";
    ret check(before, after, true);
}
