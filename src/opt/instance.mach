# what a pass may ask of an instance and its row before it merges or moves it
#
# one owner for the questions common subexpression elimination and the loop
# passes both put to a row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mirl.ir.instruction.InstructionData;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.table;
use mirl.pass.refusal;

# whether a row only reads memory, with no ordering to state
pub fun reads_only(r: *Row) bool {
    if (r.effects.mergeable || !r.effects.reads || r.effects.writes) { ret false; }
    var i: u32 = 0;
    for (i < opcode_row.slots(r)) {
        if (sel r.immediates[i].holds.ordering) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether an instance gives results, ends nothing, and is neither volatile nor
# kept, so it may stand for another or move
pub fun plain(d: *InstructionData, r: *Row) bool {
    ret !r.terminator && d.edges.len == 0 && d.results.len != 0 && !d.metadata.flags.volatile && !d.metadata.flags.kept;
}

# the row of an instruction's opcode, or why it has none
pub fun row_of(d: *InstructionData) res[*Row, refusal.Error] {
    val found: opt[*Row] = table.at(d.opcode);
    if (!(sel found.some)) { ret res[*Row, refusal.Error].err{refusal.Error.reason{"an instruction whose opcode has no row"}}; }
    ret res[*Row, refusal.Error].ok{found.some};
}
