# float reassociation: a sequential float sum or product reduction becomes
# a reassociable one where the build permits float reassociation
#
# a sequential reduction combines its lanes one after another from the first,
# and a reassociable one in any order and grouping, so the rewrite is exactly
# the liberty mirl.pass.relaxation.FLOAT_REASSOC grants: `+` and `*` treated
# as associative, and nothing else. it applies only to a build that holds the
# member, so a build that holds none runs it not at all. the reductions it
# rewrites are the rows below, a sequential row and its reassociable
# counterpart, and the minimum and maximum reductions have no order to
# regroup. the ir has no subtraction or division reduction, which no
# relaxation would admit. the rewrite keeps the operand, the type, the nan
# rule and the secrecy of what it rewrites, and adds no branch, so it keeps
# constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.build;
use mirl.build.Builder;
use mirl.build.Failure;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.pass.analysis;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.relaxation;

# the pass: it puts one instruction in the slot of another and never touches
# an edge or a block
pub val REASSOCIATE: Pass = Pass{name: "reassociate", kind: Kind.optimise{}, scope: Scope.function{visit}, preserves: analysis.FLOW, time: Time.keeps{}, applies: permitted};

# a sequential reduction and the reassociable one that stands in for it
# ---
# from: the sequential reduction
# to:   the reassociable one
rec Regroup {
    from: Opcode;
    to:   Opcode;
}

val REGROUPS: [2]Regroup = [2]Regroup{
    Regroup{from: opcode.REDUCE_FADD_SEQ, to: opcode.REDUCE_FADD_ANY},
    Regroup{from: opcode.REDUCE_FMUL_SEQ, to: opcode.REDUCE_FMUL_ANY},
};

# whether the build permits float reassociation
fun permitted(g: *Ground) bool {
    ret relaxation.holds(g.floats, relaxation.FLOAT_REASSOC);
}

# the reassociable reduction that stands in for an opcode, none for one that
# is no sequential reduction
fun regrouped(code: Opcode) opt[Opcode] {
    var i: usize = 0;
    for (i < $length_of(REGROUPS)) {
        if (REGROUPS[i].from.index == code.index) { ret opt[Opcode].some{REGROUPS[i].to}; }
        i = i + 1;
    }
    ret opt[Opcode].none{};
}

# put the reassociable reduction in the slot of an instruction that is a
# sequential one, answering whether it was
fun rewrite(bld: *Builder, b: *Body, i: Instruction) bool {
    val d:  *InstructionData = ?b.instructions.data[i.index];
    val to: opt[Opcode]      = regrouped(d.opcode);
    if (sel to.none) { ret false; }
    var x: [1]Value = [1]Value{d.operands.data[0]};
    build.derive(bld, i);
    build.replacing(bld, i);
    build.value(bld, Request{opcode: to.some, operands: Slice[Value]{data: ?x[0], size: 1}, immediates: Slice[Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: nil, size: 0}});
    ret true;
}

# regroup the sequential float reductions of one function
fun visit(u: *Unit) res[bool, Why] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }
    val b: *Body = got.ok;

    var bld: Builder = build.init(c.m);
    build.enter(?bld, u.f);
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                if (rewrite(?bld, b, b.blocks.data[k].instructions.data[n])) { changed = true; }
                val built: err[Failure] = build.done(?bld);
                if (sel built.err) { ret res[bool, Why].err{Why.build{built.err}}; }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret res[bool, Why].ok{changed};
}
