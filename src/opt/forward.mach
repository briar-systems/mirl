# load elimination past common subexpressions: a load of the bytes a store on its one way in just wrote is the value
# the store wrote
#
# common subexpression elimination merges a load with an earlier load of the same place. this pass takes what it leaves:
# a load whose bytes an earlier store wrote, with nothing between that may write any of them on any path, becomes the
# stored value. the blocks are walked in reverse postorder, keeping the accesses whose bytes still hold what they stored
# or loaded: a plain store or load of one sized place joins the list, and an instruction that may write a byte a listed
# access covers ends that access's place in it, as the memory analysis places both (an access through no address, as a
# call that may write, ends every one but those of a slot whose address never escapes, and an ordered access ends every
# one). a copy (`mem.copy`) between two places at constant offsets of frame slots, of one stated size, holds after it
# what the list held of the bytes it reads at the bytes it writes, each at the same distance into the copy (`through`),
# since it moves those bytes unchanged. a load is taken when a listed access's place is exactly its own (`must`), the
# value held is of the load's type and of its secrecy, and the type is a scalar: an integer, a float, a pointer or a
# vector.
#
# a value crosses an edge only as a constant, so forwarding past an edge never holds a value across the blocks between:
# a stored constant crosses every edge, and a value the branch ending its block tests equal to a constant (`eq` or `ne`
# against one) crosses the edge that branch takes when they are equal, as that constant, since on that edge the bytes
# hold the value and the value is the constant (`arriving`). each block keeps its whole list, and each edge out of it
# takes what crosses that edge. a block starts from what the edges into it carry, when every edge into it leaves a block
# the walk has already ended, and empty otherwise: a block a back edge enters starts empty, since the walk has not ended
# that edge's source. every run of a block's first instruction comes straight from the terminator of one of its
# predecessors, whose own effect that predecessor's walk has already applied, so no instruction runs between the end of
# a predecessor and the start of the block, and an edge passes values, never memory. a block starts with a place an edge
# carries where every other edge carries a value of exactly that place (`must`) with one type and one secrecy, or leaves
# a `br`: on every path through an edge that carries one the bytes hold the value it carries. where every edge carries
# one value the block takes it as it is. otherwise a load the block reads them by becomes a new parameter of the block,
# each edge passing the value it carries, a constant, so on every path the parameter is what the bytes hold. an edge
# that carries none passes a copy of the load made at the end of its source, just before the `br`, which reads the bytes
# the load would read: this is taken only where the load runs straight from the block's start after instructions that
# touch no memory, never trap and read only what is defined above the block or by each other, which are copied with it,
# and slot markers, which are not, since none writes a byte the load reads (`leads`), so the copy runs on exactly the
# paths the load ran on, and nothing between them writes the bytes. the parameter is made only when a load of that block
# is taken, once per such place, so it lands where the test of the case reads it (`given`). the place's offset bounds
# (`Place.starts`) are the hull of the predecessors' bounds, each true on the paths through its own predecessor, and
# none where an edge carries no value. this is the copy of a call the inliner expands: each of its return blocks stores
# the result's case into the slot the result is built in, as a constant, and branches to the block that continues the
# caller, whose test of the case loads it straight back. the load becomes a parameter each return passes a constant, and
# jump threading (`mirl.opt.thread`) takes each edge straight to the arm the constant decides. a return that hands on
# the result of a call it makes leaves the case unknown, and passes it loaded again. where the expanded call is itself
# the return of an outer expansion, its test of the case sends one arm on to the outer join, and on that arm the case is
# the constant it was tested equal to, so the outer test takes a parameter too.
#
# an aggregate is never forwarded, since no value of one is in hand: the aggregate legalisation holds it as its
# leaves or in a slot of its own, and moves a load whose only use is a store from memory to memory. forwarding one
# saves no access and gives the stored value a second use, so the copy that went from memory to memory becomes a
# load of every leaf where the value is made, held, and spilled across each call, to the store and the use it was
# forwarded to. that is the copy propagation of bytes through memory, which needs the bytes' source unwritten at
# the new use, not a load replaced by a value already held.
#
# the rule by which a load is left alone: it is volatile, ordered or kept, it loads an aggregate, no listed access
# covers exactly its bytes (a wider or a narrower one, or one whose place only may be the same), the held value's
# type or secrecy is not the load's, or the access is kept, volatile or ordered, since a kept write is a fixed fact
# nothing forwards away.
#
# it costs, per block, its instructions times the accesses still listed, and per edge into a block entered from two
# or more, the list of the edge's source times the places the first edge carries. a block's list is kept until every
# block that starts from it has. it reads the memory analysis (and through it ranges, loops, slots and inductions) and the graph and
# dominance, for the reverse postorder. it removes a load, which can change when a function's memory traffic
# happens, so it is held to no constant-time proof of its own and breaks constant time: every function that
# requires it is skipped.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.table;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.type.table.same;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.pass.analysis;
use mirl.pass.analysis.memory;
use mirl.pass.analysis.memory.Alias;
use mirl.pass.analysis.memory.Base;
use mirl.pass.analysis.memory.Effect;
use mirl.pass.analysis.memory.Memory;
use mirl.pass.analysis.memory.Place;
use mirl.pass.analysis.memory.Span;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.pass.refusal.edit;

# the pass: it removes loads in place, adds a parameter to a block and an argument to each edge into it, and changes no
# edge
pub val FORWARD: Pass = Pass{name: "forward", kind: Kind.optimise{}, scope: Scope.function{visit}, needs: analysis.OF_MEMORY | analysis.OF_GRAPH | analysis.OF_DOMINANCE, preserves: analysis.FLOW, time: Time.breaks{}};

# an access whose bytes still hold what it stored or loaded
# ---
# place: where it stored or loaded
# value: what it stored or loaded, where `join` is none
# join:  the join that gives what the edges into a block carry, by its position in `Walk.joins`, none
#        for the value stored or loaded
rec Held {
    place: Place;
    value: Value;
    join:  u32;
}

# no join
val NO_JOIN: u32 = 0xffffffff;

# the values the edges into a block carry at one place, which a load in the block reads as a parameter of the block
# ---
# block:   the block
# first:   where the values each edge into the block passes start in `Walk.incoming`, one per entry of the block's
#          predecessor list and in its order
# type:    the type of every value
# secret:  the secrecy of every value
# made:    the parameter is made
# value:   the parameter, where it is made
# missing: an edge carries no value, NO_VALUE in its place, and leaves a `br`, before which the load the parameter
#          takes is made again when it is made
rec Join {
    block:   Block;
    first:   usize;
    type:    Type;
    secret:  bool;
    made:    bool;
    value:   Value;
    missing: bool;
}

# no value an edge carries
val NO_VALUE: Value = 0xffffffff;

# the list a block ends with, kept for the blocks that start from it
# ---
# held: the stores
# left: how many of those blocks have not started from it yet
rec Saved {
    held: vector.Vector[Held];
    left: u32;
}

# one run over a function
# ---
# c, mem, b, f: the context, the memory analysis, the body and the function
# g, d:         the graph and the dominance, valid for the whole run, since the pass changes no edge
# held:     the accesses the block being walked holds
# saved:    the lists of the blocks ended so far that a block not yet started will start from
# joins:    every join made so far
# incoming: the values the edges of each join pass
rec Walk {
    c:        *Context;
    mem:      *Memory;
    b:        *Body;
    f:        Function;
    g:        *Graph;
    d:        *Dominance;
    held:     vector.Vector[Held];
    saved:    map.Map[u32, Saved];
    joins:    vector.Vector[Join];
    incoming: vector.Vector[Value];
}

# whether an instruction is a plain access: not volatile, kept or ordered
fun plain(d: *InstructionData, e: *Effect) bool {
    ret !d.metadata.flags.volatile && !d.metadata.flags.kept && !e.ordered;
}

# drop each held access a write of effect `e` may reach
fun written(held: *vector.Vector[Held], e: *Effect) {
    if (!e.writes && !e.ordered) { ret; }
    var k: usize = 0;
    for (k < held.len) {
        var ends: bool  = e.ordered || (e.anywhere && !held.data[k].place.private);
        var j:    usize = 0;
        for (j < e.places.len && !ends) {
            val al: Alias = memory.alias(e.places.data[j], held.data[k].place);
            if (!(sel al.no)) { ends = true; }
            j = j + 1;
        }
        if (ends) {
            held.data[k] = held.data[held.len - 1];
            vector.truncate[Held](held, held.len - 1);
        }
        or { k = k + 1; }
    }
}

# whether a value of type `ty` is a scalar, which a forwarded load can be: an aggregate is held in memory or as its
# leaves, never as a value in hand
fun scalar(c: *Context, ty: Type) bool {
    val res_kind: res[type_table.Kind, type_table.Error] = type_table.kind(?c.m.types, ty);
    if (sel res_kind.err) { ret false; }
    ret !(sel res_kind.ok.structure || sel res_kind.ok.array || sel res_kind.ok.union);
}

# a copy of instruction `i` made just before instruction `before`, each operand read as `run` maps it, its result
fun copied(w: *Walk, i: Instruction, before: Instruction, run: *map.Map[u32, Value]) res[Value, refusal.Error] {
    var ops:  vector.Vector[Value]     = vector.init[Value](w.c.m.a);
    var imms: vector.Vector[Immediate] = vector.init[Immediate](w.c.m.a);
    fin {
        vector.dnit[Value](?ops);
        vector.dnit[Immediate](?imms);
    }
    var n: usize = 0;
    for (n < w.b.instructions.data[i].operands.len) {
        var key:     u32         = w.b.instructions.data[i].operands.data[n]::u32;
        var v:       Value       = w.b.instructions.data[i].operands.data[n];
        val opt_new: opt[*Value] = map.get[u32, Value](run, ?key);
        if (sel opt_new.some) { v = @opt_new.some; }
        val res_op: res[usize, allocator.Error] = vector.push[Value](?ops, v);
        if (sel res_op.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_op.err}}; }
        n = n + 1;
    }
    n = 0;
    for (n < w.b.instructions.data[i].immediates.len) {
        val res_imm: res[usize, allocator.Error] = vector.push[Immediate](?imms, w.b.instructions.data[i].immediates.data[n]);
        if (sel res_imm.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_imm.err}}; }
        n = n + 1;
    }
    val d:  *InstructionData = ?w.b.instructions.data[i];
    var md: Metadata;
    md.location = d.metadata.location;
    md.site     = d.metadata.site;
    md.flags    = d.metadata.flags;
    md.secret   = d.metadata.secret;
    md.publics  = d.metadata.publics;
    val opcode:  u32       = d.opcode;
    val opt_row: opt[*Row] = table.at(opcode);
    if (sel opt_row.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a copied instruction has no opcode row"}}; }
    val res_made: res[Instruction, Error] = body.builder_make(w.c.m, w.f, opt_row.some, Request{opcode: opcode, operands: Slice[Value]{data: ops.data, size: ops.len}, immediates: Slice[Immediate]{data: imms.data, size: imms.len}, targets: Slice[Branch]{data: nil, size: 0}}, md);
    if (sel res_made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{res_made.err}}; }
    val err_placed: err[refusal.Error] = edit(body.insert(w.c.m, w.f, before, res_made.ok));
    if (sel err_placed.err) { ret res[Value, refusal.Error].err{err_placed.err}; }
    ret res[Value, refusal.Error].ok{w.b.instructions.data[res_made.ok].results.data[0]};
}

# a copy of load `load` of block `at`, and of the instructions before it there but slot markers, made just before
# instruction `before`, the copy of the load's result
fun reload(w: *Walk, at: Block, load: Instruction, before: Instruction) res[Value, refusal.Error] {
    var run: map.Map[u32, Value] = map.init[u32, Value](w.c.m.a);
    fin { map.dnit[u32, Value](?run); }
    var i: Instruction = w.b.blocks.data[at].first;
    for (true) {
        if (table.marks(w.b.instructions.data[i].opcode)) {
            i = w.b.instructions.data[i].next;
            cnt;
        }
        val res_copy: res[Value, refusal.Error] = copied(w, i, before, ?run);
        if (sel res_copy.err) { ret res_copy; }
        if (i == load)        { ret res_copy; }
        val res_set: res[bool, allocator.Error] = map.insert[u32, Value](?run, w.b.instructions.data[i].results.data[0]::u32, res_copy.ok);
        if (sel res_set.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_set.err}}; }
        i = w.b.instructions.data[i].next;
    }
    ret res[Value, refusal.Error].err{refusal.Error.reason{"a load ran past its block"}};
}

# the value of a held access, making its join's parameter when it has none yet, for load `load`
fun value_of(w: *Walk, h: *Held, load: Instruction) res[Value, refusal.Error] {
    if (h.join == NO_JOIN) { ret res[Value, refusal.Error].ok{h.value}; }
    val j: *Join = ?w.joins.data[h.join];
    if (j.made) { ret res[Value, refusal.Error].ok{j.value}; }
    val count: usize = w.b.blocks.data[j.block].predecessors.len;
    if (j.missing) {
        var e: usize = 0;
        for (e < count) {
            if (w.incoming.data[j.first + e] == NO_VALUE) {
                val res_again: res[Value, refusal.Error] = reload(w, j.block, load, w.b.blocks.data[j.block].predecessors.data[e]);
                if (sel res_again.err) { ret res_again; }
                w.incoming.data[j.first + e] = res_again.ok;
            }
            e = e + 1;
        }
    }
    val incoming: Slice[Value]      = Slice[Value]{data: ?w.incoming.data[j.first], size: count};
    val res_made: res[Value, Error] = body.add_parameter(w.c.m, w.f, j.block, Declaration{type: j.type, secret: j.secret, name: opt[View].none{}}, incoming);
    if (sel res_made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{res_made.err}}; }
    val k: *Join = ?w.joins.data[h.join];
    k.made  = true;
    k.value = res_made.ok;
    ret res[Value, refusal.Error].ok{res_made.ok};
}

# the type and secrecy of what a held access holds
fun typed(w: *Walk, h: *Held, ty: *Type, secret: *bool) {
    if (h.join == NO_JOIN) {
        @ty     = w.b.values.data[h.value].type;
        @secret = w.b.values.data[h.value].secret;
        ret;
    }
    @ty     = w.joins.data[h.join].type;
    @secret = w.joins.data[h.join].secret;
}

# whether value `v`, read by an instruction of block `at`, is defined where a copy of that instruction at the end of
# each predecessor reads it: above the block, or by an instruction of the block before the reader, which the copy
# copies too. a parameter of the block is neither
fun available(w: *Walk, at: Block, v: Value) bool {
    val def: Def = w.b.values.data[v].def;
    if (sel def.parameter) { ret def.parameter.block != at; }
    ret true;
}

# whether the load `load` of block `at` runs on every path into the block, after only slot markers and instructions
# that touch no memory, never trap and give one result each, which with the load read only what is defined above the
# block or by them. a copy of that run but its markers at the end of each predecessor runs where the load does, and
# reads what it reads: a marker before the load writes no byte it reads, or the place would not be held there
fun leads(w: *Walk, at: Block, load: Instruction) bool {
    var i: Instruction = w.b.blocks.data[at].first;
    for (i != NO_INSTRUCTION) {
        val d: *InstructionData = ?w.b.instructions.data[i];
        if (i != load && table.marks(d.opcode) && !d.metadata.flags.kept && !d.metadata.flags.volatile) {
            i = d.next;
            cnt;
        }
        var n: usize = 0;
        for (n < d.operands.len) {
            if (!available(w, at, d.operands.data[n])) { ret false; }
            n = n + 1;
        }
        if (i == load)                                                                                    { ret true; }
        if (d.metadata.flags.kept || d.metadata.flags.volatile || d.results.len != 1 || d.edges.len != 0) { ret false; }
        val opt_row: opt[*Row] = table.at(d.opcode);
        if (sel opt_row.none) { ret false; }
        val r: *Row = opt_row.some;
        if (r.terminator || r.effects.reads || r.effects.writes)                      { ret false; }
        if (!(sel r.effects.traps[0].unstated) || !(sel r.effects.traps[1].unstated)) { ret false; }
        i = d.next;
    }
    ret false;
}

# the value a held access gives load `load` at `place` whose result is `result`, in block `at`, none where none
# does. a join whose parameter is not made gives a value only to a load of its own block: there the parameter is read
# where the load was, holds no register across anything, and is what a test of the block reads, which jump threading
# decides for each edge that passes a constant. made at an earlier join, it would be live from that join across
# every block down to the load, and no test there reads a parameter of its own block, so it costs a register and a
# copy on each edge for one load. a join an edge carries no value into takes only a load that `leads` its block,
# made again at the end of that edge's source
fun given(w: *Walk, place: Place, result: Value, at: Block, load: Instruction) res[opt[Value], refusal.Error] {
    var k: usize = 0;
    for (k < w.held.len) {
        val al: Alias = memory.alias(w.held.data[k].place, place);
        if (sel al.must) {
            var ty:     Type = w.b.values.data[result].type;
            var secret: bool = false;
            typed(w, ?w.held.data[k], ?ty, ?secret);
            val h:     *Held = ?w.held.data[k];
            var apart: bool  = false;
            if (h.join != NO_JOIN && !w.joins.data[h.join].made) {
                apart = w.joins.data[h.join].block != at || (w.joins.data[h.join].missing && !leads(w, at, load));
            }
            if (same(ty, w.b.values.data[result].type) && secret == w.b.values.data[result].secret && !apart) {
                val res_value: res[Value, refusal.Error] = value_of(w, ?w.held.data[k], load);
                if (sel res_value.err) { ret res[opt[Value], refusal.Error].err{res_value.err}; }
                ret res[opt[Value], refusal.Error].ok{opt[Value].some{res_value.ok}};
            }
        }
        k = k + 1;
    }
    ret res[opt[Value], refusal.Error].ok{opt[Value].none{}};
}

# whether place `p` lies at a constant offset in a frame slot, so another such place is apart from it or within it by
# their offsets alone
fun framed(p: Place) bool {
    ret sel p.base.slot && !p.offset.has && p.sized;
}

# the held accesses whose bytes a copy of effect `e` (to its first place from its second, of one size) moves, each
# as the access of the bytes it moved them to, into `into`: those bytes hold what the source's did. a join an edge
# carries no value into is left behind, since its load is made again at the end of each such edge's source, where it
# reads the source of the copy and not the bytes the copy moves it to
fun through(w: *Walk, e: *Effect, into: *vector.Vector[Held]) err[allocator.Error] {
    if (e.places.len != 2) { ret err[allocator.Error].ok{}; }
    val to:   Place = e.places.data[0];
    val from: Place = e.places.data[1];
    if (!framed(to) || !framed(from) || to.size != from.size) { ret err[allocator.Error].ok{}; }
    var k: usize = 0;
    for (k < w.held.len) {
        val h:      *Held = ?w.held.data[k];
        val own:    Base  = h.place.base;
        val source: Base  = from.base;
        var whole:  bool  = h.join == NO_JOIN || w.joins.data[h.join].made || !w.joins.data[h.join].missing;
        if (sel own.slot) {
            if (sel source.slot) {
                val lo: i128 = h.place.offset.constant::i128 - from.offset.constant::i128;
                if (whole && framed(h.place) && own.slot == source.slot && lo >= 0 && lo + h.place.size::i128 <= from.size::i128) {
                    var spot: Place = to;
                    spot.offset.constant = (to.offset.constant::i128 + lo)::i64;
                    spot.size            = h.place.size;
                    spot.starts          = opt[Span].none{};
                    val res_pushed: res[usize, allocator.Error] = vector.push[Held](into, Held{place: spot, value: h.value, join: h.join});
                    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
                }
            }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

# forward the stores `w.held` lists and those of block `at`, whose first instruction is `first`, to its loads,
# answering whether a load went
fun block(w: *Walk, at: Block, first: Instruction) res[bool, refusal.Error] {
    val b:       *Body       = w.b;
    var changed: bool        = false;
    var i:       Instruction = first;
    for (i != NO_INSTRUCTION) {
        val next:       Instruction                = b.instructions.data[i].next;
        val d:          *InstructionData           = ?b.instructions.data[i];
        var res_effect: res[Effect, refusal.Error] = memory.effect_of(w.mem, i);
        if (sel res_effect.err) { ret res[bool, refusal.Error].err{res_effect.err}; }
        var e: Effect = res_effect.ok;
        fin { memory.dnit(?e); }
        var taken: bool = false;
        if (d.opcode == table.LOAD && d.results.len == 1 && scalar(w.c, b.values.data[d.results.data[0]].type) && e.places.len == 1 && e.places.data[0].sized && plain(d, ?e)) {
            val result:    Value                          = d.results.data[0];
            val res_given: res[opt[Value], refusal.Error] = given(w, e.places.data[0], result, at, i);
            if (sel res_given.err) { ret res[bool, refusal.Error].err{res_given.err}; }
            if (sel res_given.ok.some) {
                val err_replaced: err[refusal.Error] = edit(body.replace(w.c.m, w.f, result, res_given.ok.some, Records.follow{}));
                if (sel err_replaced.err) { ret res[bool, refusal.Error].err{err_replaced.err}; }
                val err_erased: err[refusal.Error] = edit(body.erase(w.c.m, w.f, i));
                if (sel err_erased.err) { ret res[bool, refusal.Error].err{err_erased.err}; }
                taken   = true;
                changed = true;
            }
        }
        if (!taken) {
            var copies: vector.Vector[Held] = vector.init[Held](w.c.m.a);
            fin { vector.dnit[Held](?copies); }
            if (d.opcode == table.MEM_COPY && plain(d, ?e)) {
                val err_copied: err[allocator.Error] = through(w, ?e, ?copies);
                if (sel err_copied.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_copied.err}}; }
            }
            written(?w.held, ?e);
            var c: usize = 0;
            for (c < copies.len) {
                val res_moved: res[usize, allocator.Error] = vector.push[Held](?w.held, copies.data[c]);
                if (sel res_moved.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_moved.err}}; }
                c = c + 1;
            }
            # a plain access of one sized place leaves its bytes holding the value stored or loaded
            var opt_held: opt[Value] = opt[Value].none{};
            val one:      bool       = e.places.len == 1 && e.places.data[0].sized && plain(d, ?e);
            if (one && d.opcode == table.STORE && d.operands.len == 2)                                                     { opt_held = opt[Value].some{d.operands.data[1]}; }
            or (one && d.opcode == table.LOAD && d.results.len == 1 && scalar(w.c, b.values.data[d.results.data[0]].type)) { opt_held = opt[Value].some{d.results.data[0]}; }
            if (sel opt_held.some) {
                val res_pushed: res[usize, allocator.Error] = vector.push[Held](?w.held, Held{place: e.places.data[0], value: opt_held.some, join: NO_JOIN});
                if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
            }
        }
        i = next;
    }
    ret res[bool, refusal.Error].ok{changed};
}

# whether the walk has ended every block an edge into `n` leaves before it starts `n`: each is reached and comes
# before `n` in reverse postorder, so no back edge enters `n`
fun ready(w: *Walk, n: u32) bool {
    val preds: Slice[u32] = graph.predecessors(w.g, n);
    if (preds.size == 0) { ret false; }
    var k: usize = 0;
    for (k < preds.size) {
        val p: u32 = preds.data[k];
        if (!dominance.reachable(w.d, p) || dominance.rank(w.d, p) >= dominance.rank(w.d, n)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `n` appears in `list` before position `upto`
fun listed(list: Slice[u32], upto: usize, n: u32) bool {
    var k: usize = 0;
    for (k < upto) {
        if (list.data[k] == n) { ret true; }
        k = k + 1;
    }
    ret false;
}

# how many distinct blocks start from the list a block ends with
fun ways_out(w: *Walk, n: u32) u32 {
    val succs: Slice[u32] = graph.successors(w.g, n);
    var count: u32        = 0;
    var k:     usize      = 0;
    for (k < succs.size) {
        if (!listed(succs, k, succs.data[k]) && ready(w, succs.data[k])) { count = count + 1; }
        k = k + 1;
    }
    ret count;
}

# the list a block ended with, which it must have kept
fun saved_of(w: *Walk, n: u32) *Saved {
    var key:       u32         = n;
    val opt_saved: opt[*Saved] = map.get[u32, Saved](?w.saved, ?key);
    if (sel opt_saved.some) { ret opt_saved.some; }
    ret nil;
}

# the value a held access holds where it is in hand, none for a join whose parameter is not made, which a later join
# does not read, so a join no load takes makes no parameter
fun concrete(w: *Walk, h: *Held) opt[Value] {
    if (h.join == NO_JOIN)         { ret opt[Value].some{h.value}; }
    if (w.joins.data[h.join].made) { ret opt[Value].some{w.joins.data[h.join].value}; }
    ret opt[Value].none{};
}

# the constant branch `from` proves `v` equal to on its edge `edge`: the branch tests `v` against a constant for
# equality and the edge is the one it takes when they are equal. none otherwise
fun equal_on(b: *Body, from: Instruction, edge: usize, v: Value) opt[Value] {
    val d: *InstructionData = ?b.instructions.data[from];
    if (d.opcode != table.CBR || d.operands.len != 1 || d.edges.len != 2) { ret opt[Value].none{}; }
    if (d.edges.data[0].block == d.edges.data[1].block)                   { ret opt[Value].none{}; }
    val def: Def = b.values.data[d.operands.data[0]].def;
    if (!(sel def.result)) { ret opt[Value].none{}; }
    val c: *InstructionData = ?b.instructions.data[def.result.instruction];
    if (c.operands.len != 2 || c.results.len != 1 || c.immediates.len != 0) { ret opt[Value].none{}; }
    var equal: usize = 2;
    if (c.opcode == table.EQ) { equal = 0; }
    if (c.opcode == table.NE) { equal = 1; }
    if (edge != equal)        { ret opt[Value].none{}; }
    val left:  Value = c.operands.data[0];
    val right: Value = c.operands.data[1];
    if (left == v && sel b.values.data[right].def.constant) { ret opt[Value].some{right}; }
    if (right == v && sel b.values.data[left].def.constant) { ret opt[Value].some{left}; }
    ret opt[Value].none{};
}

# what the bytes of held access `h`, listed at the end of the block branch `from` leaves, hold on the branch's edge
# `edge`, none where it crosses no edge: a constant crosses every edge, and a value the branch tests equal to a
# constant crosses the edge taken when it is equal, as that constant
fun arriving(w: *Walk, h: *Held, from: Instruction, edge: usize) opt[Value] {
    val opt_in: opt[Value] = concrete(w, h);
    if (sel opt_in.none) { ret opt_in; }
    val v:   Value = opt_in.some;
    val def: Def   = w.b.values.data[v].def;
    if (h.join == NO_JOIN && sel def.constant) { ret opt_in; }
    ret equal_on(w.b, from, edge, v);
}

# the edge of instruction `from` that is entry `rank` of the predecessor list of block `n`
fun edge_of(b: *Body, n: Block, from: Instruction, rank: usize) usize {
    var e: usize = 0;
    for (e < b.instructions.data[from].edges.len) {
        val edge: Edge = b.instructions.data[from].edges.data[e];
        if (edge.block == n && edge.rank::usize == rank) { ret e; }
        e = e + 1;
    }
    ret e;
}

# the held access of a list at exactly `place`, of a type and secrecy, that crosses edge `edge` of `from`, none where
# the list holds none
fun matching(w: *Walk, list: *vector.Vector[Held], place: Place, ty: Type, secret: bool, from: Instruction, edge: usize) opt[usize] {
    var k: usize = 0;
    for (k < list.len) {
        val al:      Alias      = memory.alias(list.data[k].place, place);
        val opt_out: opt[Value] = arriving(w, ?list.data[k], from, edge);
        if (sel al.must && sel opt_out.some) {
            var t: Type = ty;
            var s: bool = false;
            typed(w, ?list.data[k], ?t, ?s);
            if (same(t, ty) && s == secret) { ret opt[usize].some{k}; }
        }
        k = k + 1;
    }
    ret opt[usize].none{};
}

# the hull of two offset bounds, none where either is none
fun hull(a: opt[Span], b: opt[Span]) opt[Span] {
    if (sel a.none) { ret opt[Span].none{}; }
    if (sel b.none) { ret opt[Span].none{}; }
    var lo: i128 = a.some.lo;
    var hi: i128 = a.some.hi;
    if (b.some.lo < lo) { lo = b.some.lo; }
    if (b.some.hi > hi) { hi = b.some.hi; }
    ret opt[Span].some{Span{lo: lo, hi: hi}};
}

# whether a place exactly `p` (`must`) is among `places`
fun among(places: *vector.Vector[Place], p: Place) bool {
    var k: usize = 0;
    for (k < places.len) {
        val al: Alias = memory.alias(places.data[k], p);
        if (sel al.must) { ret true; }
        k = k + 1;
    }
    ret false;
}

# start block `n` from what the edges into it carry, into `w.held`, emptied first. a place any edge carries is
# started with where every other edge carries it too, or leaves a `br`, whose source the load that takes it is made
# again at the end of
fun start(w: *Walk, n: u32) err[refusal.Error] {
    vector.truncate[Held](?w.held, 0);
    if (!ready(w, n)) { ret err[refusal.Error].ok{}; }
    val entries: *vector.Vector[Instruction] = ?w.b.blocks.data[n].predecessors;
    var tried:   vector.Vector[Place]        = vector.init[Place](w.c.m.a);
    fin { vector.dnit[Place](?tried); }
    var s: usize = 0;
    for (s < entries.len) {
        val lead:    Instruction      = entries.data[s];
        val at_lead: *InstructionData = ?w.b.instructions.data[lead];
        if (!(sel at_lead.place.placed)) { ret err[refusal.Error].err{refusal.Error.reason{"an edge into a block from an instruction placed in no block"}}; }
        val first: *vector.Vector[Held] = ?saved_of(w, at_lead.place.placed).held;
        val out:   usize                = edge_of(w.b, n, lead, s);
        var h:     usize                = 0;
        for (h < first.len) {
            val opt_own: opt[Value] = arriving(w, ?first.data[h], lead, out);
            if (sel opt_own.some && !among(?tried, first.data[h].place)) {
                val res_noted: res[usize, allocator.Error] = vector.push[Place](?tried, first.data[h].place);
                if (sel res_noted.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_noted.err}}; }
                val err_tried: err[refusal.Error] = joined(w, n, s, ?first.data[h], opt_own);
                if (sel err_tried.err) { ret err_tried; }
            }
            h = h + 1;
        }
        s = s + 1;
    }
    ret err[refusal.Error].ok{};
}

# start block `n` with held access `h` of the list of the source of its entry `s`, which carries `opt_own` into it,
# where the edges agree. no earlier entry carried its place
fun joined(w: *Walk, n: u32, s: usize, h: *Held, opt_own: opt[Value]) err[refusal.Error] {
    if (sel opt_own.none) { ret err[refusal.Error].ok{}; }
    val entries: *vector.Vector[Instruction] = ?w.b.blocks.data[n].predecessors;
    val place:   Place                       = h.place;
    var ty:      Type;
    var secret:  bool                        = false;
    typed(w, h, ?ty, ?secret);
    val at:      usize     = w.incoming.len;
    var missing: bool      = false;
    var same:    bool      = true;
    var starts:  opt[Span] = place.starts;
    var e:       usize     = 0;
    for (e < entries.len) {
        val from: Instruction      = entries.data[e];
        val spot: *InstructionData = ?w.b.instructions.data[from];
        if (!(sel spot.place.placed)) { ret err[refusal.Error].err{refusal.Error.reason{"an edge into a block from an instruction placed in no block"}}; }
        val edge:   usize                = edge_of(w.b, n, from, e);
        val list:   *vector.Vector[Held] = ?saved_of(w, spot.place.placed).held;
        var opt_at: opt[usize]           = opt[usize].none{};
        if (e != s) { opt_at = matching(w, list, place, ty, secret, from, edge); }
        var value: Value = NO_VALUE;
        if (e == s) { value = opt_own.some; }
        or (sel opt_at.some) {
            val opt_value: opt[Value] = arriving(w, ?list.data[opt_at.some], from, edge);
            if (sel opt_value.none) { ret err[refusal.Error].err{refusal.Error.reason{"a held access that crosses an edge gave no value"}}; }
            value  = opt_value.some;
            starts = hull(starts, list.data[opt_at.some].place.starts);
        }
        or (spot.opcode == table.BR && spot.edges.len == 1) {
            missing = true;
            starts  = opt[Span].none{};
        }
        or {
            vector.truncate[Value](?w.incoming, at);
            ret err[refusal.Error].ok{};
        }
        if (e > 0 && value != w.incoming.data[at]) { same = false; }
        val res_pushed: res[usize, allocator.Error] = vector.push[Value](?w.incoming, value);
        if (sel res_pushed.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
        e = e + 1;
    }
    var spot: Place = place;
    spot.starts = starts;
    var held: Held = Held{place: spot, value: opt_own.some, join: NO_JOIN};
    if (same && !missing) { vector.truncate[Value](?w.incoming, at); }
    or {
        held.join = w.joins.len::u32;
        val res_join: res[usize, allocator.Error] = vector.push[Join](?w.joins, Join{block: n, first: at, type: ty, secret: secret, made: false, value: opt_own.some, missing: missing});
        if (sel res_join.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_join.err}}; }
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[Held](?w.held, held);
    if (sel res_pushed.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
    ret err[refusal.Error].ok{};
}

# give back what the blocks that started from a block's list took of it, freeing it when the last has
fun release(w: *Walk, n: u32) {
    if (!ready(w, n)) { ret; }
    val preds: Slice[u32] = graph.predecessors(w.g, n);
    var k:     usize      = 0;
    for (k < preds.size) {
        if (!listed(preds, k, preds.data[k])) {
            var key: u32    = preds.data[k];
            val s:   *Saved = saved_of(w, key);
            s.left = s.left - 1;
            if (s.left == 0) {
                vector.dnit[Held](?s.held);
                map.remove[u32, Saved](?w.saved, ?key);
            }
        }
        k = k + 1;
    }
}

# copy a list into another, emptied first
fun copy(into: *vector.Vector[Held], from: *vector.Vector[Held]) err[allocator.Error] {
    vector.truncate[Held](into, 0);
    var k: usize = 0;
    for (k < from.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[Held](into, from.data[k]);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

fun walk_dnit(w: *Walk, order: Slice[u32]) {
    var k: usize = 0;
    for (k < order.size) {
        val s: *Saved = saved_of(w, order.data[k]);
        if (s != nil) { vector.dnit[Held](?s.held); }
        k = k + 1;
    }
    map.dnit[u32, Saved](?w.saved);
    vector.dnit[Held](?w.held);
    vector.dnit[Join](?w.joins);
    vector.dnit[Value](?w.incoming);
}

# forward the stores of each reachable block of one function, in reverse postorder, each block starting from what
# the lists of its predecessors agree on
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val res_memory_of: res[*Memory, refusal.Error] = analysis.memory_of(c.cache, u.f);
    if (sel res_memory_of.err) { ret res[bool, refusal.Error].err{res_memory_of.err}; }
    val res_graph_of: res[*Graph, refusal.Error] = analysis.graph_of(c.cache, u.f);
    if (sel res_graph_of.err) { ret res[bool, refusal.Error].err{res_graph_of.err}; }
    val res_dominance_of: res[*Dominance, refusal.Error] = analysis.dominance_of(c.cache, u.f);
    if (sel res_dominance_of.err) { ret res[bool, refusal.Error].err{res_dominance_of.err}; }
    var w:     Walk       = Walk{c: c, mem: res_memory_of.ok, b: res_body.ok, f: u.f, g: res_graph_of.ok, d: res_dominance_of.ok, held: vector.init[Held](c.m.a), saved: map.init[u32, Saved](c.m.a), joins: vector.init[Join](c.m.a), incoming: vector.init[Value](c.m.a)};
    val order: Slice[u32] = dominance.order(w.d);
    fin { walk_dnit(?w, order); }
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < order.size) {
        val n:         u32                = order.data[k];
        val err_start: err[refusal.Error] = start(?w, n);
        if (sel err_start.err) { ret res[bool, refusal.Error].err{err_start.err}; }
        release(?w, n);
        val res_block: res[bool, refusal.Error] = block(?w, n, w.b.blocks.data[n].first);
        if (sel res_block.err) { ret res_block; }
        if (res_block.ok)      { changed = true; }
        val left: u32 = ways_out(?w, n);
        if (left > 0) {
            var kept:       vector.Vector[Held]  = vector.init[Held](c.m.a);
            val err_copied: err[allocator.Error] = copy(?kept, ?w.held);
            if (sel err_copied.err) {
                vector.dnit[Held](?kept);
                ret res[bool, refusal.Error].err{refusal.Error.alloc{err_copied.err}};
            }
            val res_set: res[bool, allocator.Error] = map.insert[u32, Saved](?w.saved, n, Saved{held: kept, left: left});
            if (sel res_set.err) {
                vector.dnit[Held](?kept);
                ret res[bool, refusal.Error].err{refusal.Error.alloc{res_set.err}};
            }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
