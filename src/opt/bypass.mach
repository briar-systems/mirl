# forwarder bypass: a block that only jumps on is bypassed by the edges that enter it
#
# a forwarder is a block that holds nothing but a `br`, whose parameters nothing but that `br` reads. each edge into
# it moves to the block its `br` enters, passing the arguments its `br` passes with each of the forwarder's parameters
# read as the edge's argument for it, in whatever order and as often as the `br` passes them. a value the `br` passes
# that is no parameter is a constant or is defined above the forwarder, so it is defined where every edge into it
# starts. the forwarder goes once no edge enters it. a moved edge skips nothing that runs: the forwarder holds no
# instruction but the jump, and the values of its parameters go on in the arguments. the jump's own location goes
# with it.
#
# the rule by which a forwarder stays: it is the entry or the entry does not reach it, its `br` enters itself or is
# kept or volatile, it or its `br` holds a value binding record or a record reads one of its parameters, so no
# description of a variable is dropped, or it stands in a loop's shape that a pass after it reads: it or its target
# is a loop's header (a preheader or a latch: licm, the vectoriser and the unroller read them), or an edge leaving a
# loop enters it (the unroller takes a loop whose exits leave to a block nothing outside the loop enters).
#
# a block that holds slot markers (`slot.begin`, `slot.end`) and then its `br` becomes a forwarder in one of two ways.
# where its `br` is the only edge into its target, the markers move, in their order, to the start of the target
# (`sink`): every path through the block enters the target straight after them. otherwise, where every edge into it is
# the one edge of a `br` from a block it does not dominate (`lone_ways_in`), the markers move, in their order, to the
# end of each predecessor before its `br` (`hoist`). the block is then bypassed as any other. each path through the
# block runs the same markers once with nothing between their old point and their new one, so no access crosses a marker
# and their alternation on every path is the one the verifier checked (doc/ir.md). where one edge into the block leaves
# a `cbr` or a multi-way branch and the target is entered from elsewhere too, a marker appended there would run on its
# other edges, so the block keeps its markers and stays. the pass runs in a function that requires constant time as in
# any other: the events each path runs are the same, in the same order, so the stale stack check
# (`mirl.pass.analysis.slots`) and the frame's storage dataflow read the same on every path. an edge stays where it
# leaves an instruction other than `br` or `cbr`, or a `cbr` whose other edge already enters the target, or where it
# leaves a `cbr`, the `br` passes arguments and the target is entered from elsewhere: the forwarder is then where that
# path gives the target's parameters their values, which an edge of a conditional branch into a block it does not alone
# enter has no place for (the back end would make the block again), and a chain of tests becomes a multi-way branch only
# while each case enters a block of its own (`mirl.opt.switch`).
#
# it costs each forwarder its predecessors and the uses of its parameters. it reads the loops as they were when it
# began: a bypass moves no edge into a header, and an edge leaving a loop leaves it to the same block as
# before, so every loop it read keeps its header, its latches and the blocks its exits leave to. it adds no branch and
# decides none, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.body;
use mirl.ir.body.Source;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.loops;
use mirl.ir.cfg.loops.Loops;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.table;
use mirl.ir.value.Def;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.record.did;
use mirl.pass.refusal;
use mirl.pass.refusal.edit;

# the pass: it moves edges and removes blocks, so it keeps no analysis
pub val BYPASS: Pass = Pass{name: "bypass", kind: Kind.optimise{}, scope: Scope.function{visit}, needs: analysis.OF_DOMINANCE | analysis.OF_LOOPS, preserves: cache.NONE, time: Time.keeps{}, counts: "blocks bypassed"};

# a run of the pass over one function
# ---
# c:       the run
# f:       the function
# b:       its body
# d:       its dominator tree as the run began
# l:       its loops as the run began
# scratch: storage for one forwarder's edges
rec Run {
    c:       *Context;
    f:       Function;
    b:       *Body;
    d:       *Dominance;
    l:       *Loops;
    scratch: *allocator.Allocator;
}

# whether block `k` is a loop's header
fun header(l: *Loops, k: Block) bool {
    val opt_loop: opt[u32] = loops.innermost(l, k);
    ret sel opt_loop.some && loops.loop(l, opt_loop.some).header == k;
}

# whether an edge leaving a loop enters block `k`: a predecessor stands in a loop that does not hold it
fun exit(x: *Run, k: Block) bool {
    val b: *Body = x.b;
    var p: usize = 0;
    for (p < b.blocks.data[k].predecessors.len) {
        val place: Place = b.instructions.data[b.blocks.data[k].predecessors.data[p].instruction].place;
        if (sel place.placed) {
            val opt_loop: opt[u32] = loops.innermost(x.l, place.placed);
            if (sel opt_loop.some && !loops.contains(x.l, opt_loop.some, k)) { ret true; }
        }
        p = p + 1;
    }
    ret false;
}

# whether every instruction of block `k` before its last, `jump`, is a slot marker no record stands before, which the
# pass may move to the predecessors (`hoist`)
fun markers_only(b: *Body, k: Block, jump: Instruction) bool {
    var i: Instruction = b.blocks.data[k].first;
    for (i != jump) {
        val d: *InstructionData = ?b.instructions.data[i];
        if (!table.marks(d.opcode) || d.points.first != 0 || d.metadata.flags.kept || d.metadata.flags.volatile) { ret false; }
        i = d.next;
    }
    ret true;
}

# whether every edge into block `k` is the one edge of a `br`, from a block `k` does not dominate, so a marker appended
# to each such block before its `br` runs on exactly the paths that entered `k`, and no back edge enters `k`
fun lone_ways_in(x: *Run, k: Block) bool {
    val b: *Body = x.b;
    if (b.blocks.data[k].predecessors.len == 0) { ret false; }
    var p: usize = 0;
    for (p < b.blocks.data[k].predecessors.len) {
        val d: *InstructionData = ?b.instructions.data[b.blocks.data[k].predecessors.data[p].instruction];
        if (d.opcode != table.BR || d.edges.len != 1 || d.metadata.flags.kept || d.metadata.flags.volatile) { ret false; }
        if (!(sel d.place.placed))                                                                          { ret false; }
        if (dominance.dominates(x.d, k, d.place.placed))                                                    { ret false; }
        p = p + 1;
    }
    ret true;
}

# the `br` of block `k` where it is a forwarder the pass bypasses, NO_INSTRUCTION where it stays. a block that holds
# slot markers before its `br` is one where every edge into it may take them (`lone_ways_in`)
fun forwarder(x: *Run, k: Block) Instruction {
    val b: *Body = x.b;
    if (k == 0 || !dominance.reachable(x.d, k)) { ret NO_INSTRUCTION; }
    val jump: Instruction = b.blocks.data[k].last;
    if (jump == NO_INSTRUCTION || !markers_only(b, k, jump))   { ret NO_INSTRUCTION; }
    if (jump != b.blocks.data[k].first && !lone_ways_in(x, k)) { ret NO_INSTRUCTION; }
    val d: *InstructionData = ?b.instructions.data[jump];
    if (d.opcode != table.BR || d.edges.len != 1)                  { ret NO_INSTRUCTION; }
    if (d.metadata.flags.kept || d.metadata.flags.volatile)        { ret NO_INSTRUCTION; }
    if (d.points.first != 0 || b.blocks.data[k].ending.first != 0) { ret NO_INSTRUCTION; }
    val to: Block = d.edges.data[0].block;
    if (to == k || to == 0) { ret NO_INSTRUCTION; }
    var j: usize = 0;
    for (j < b.blocks.data[k].parameters.len) {
        val v: Value = b.blocks.data[k].parameters.data[j];
        if (b.values.data[v].bound.len != 0) { ret NO_INSTRUCTION; }
        var u: usize = 0;
        for (u < b.values.data[v].uses.len) {
            if (b.values.data[v].uses.data[u].instruction != jump) { ret NO_INSTRUCTION; }
            u = u + 1;
        }
        j = j + 1;
    }
    if (header(x.l, k) || header(x.l, to) || exit(x, k)) { ret NO_INSTRUCTION; }
    ret jump;
}

# whether instruction `from` has an edge into block `to`
fun enters(b: *Body, from: Instruction, to: Block) bool {
    var e: usize = 0;
    for (e < b.instructions.data[from].edges.len) {
        if (b.instructions.data[from].edges.data[e].block == to) { ret true; }
        e = e + 1;
    }
    ret false;
}

# move every edge into forwarder `k` that may move to the block its `br` enters, answering whether one moved
fun bypass(x: *Run, k: Block, jump: Instruction) res[bool, refusal.Error] {
    val b:       *Body                 = x.b;
    val to:      Block                 = b.instructions.data[jump].edges.data[0].block;
    var sources: vector.Vector[Source] = vector.init[Source](x.scratch);
    var p:       usize                 = 0;
    for (p < b.blocks.data[k].predecessors.len) {
        val from: Instruction = b.blocks.data[k].predecessors.data[p].instruction;
        val op:   u32         = b.instructions.data[from].opcode;
        var e:    usize       = 0;
        for ((op == table.BR || op == table.CBR) && e < b.instructions.data[from].edges.len) {
            if (b.instructions.data[from].edges.data[e].block == k) {
                val res_pushed: res[usize, allocator.Error] = vector.push[Source](?sources, Source{branch: from, edge: e::u32});
                if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
            }
            e = e + 1;
        }
        p = p + 1;
    }

    var args:  vector.Vector[Value] = vector.init[Value](x.scratch);
    var moved: bool                 = false;
    var s:     usize                = 0;
    for (s < sources.len) {
        val from:  Instruction = sources.data[s].branch;
        val edge:  usize       = sources.data[s].edge::usize;
        val plain: bool        = b.instructions.data[from].opcode == table.BR || b.instructions.data[jump].edges.data[0].arguments.len == 0 || b.blocks.data[to].predecessors.len == 1;
        if (plain && !enters(b, from, to)) {
            vector.truncate[Value](?args, 0);
            var n: usize = 0;
            for (n < b.instructions.data[jump].edges.data[0].arguments.len) {
                var v:   Value = b.instructions.data[jump].edges.data[0].arguments.data[n];
                val def: Def   = b.values.data[v].def;
                if (sel def.parameter) {
                    if (def.parameter.block == k) { v = b.instructions.data[from].edges.data[edge].arguments.data[def.parameter.index::usize]; }
                }
                val res_pushed: res[usize, allocator.Error] = vector.push[Value](?args, v);
                if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
                n = n + 1;
            }
            val err_moved: err[refusal.Error] = edit(body.retarget(x.c.m, x.f, from, edge::u32, to, Slice[Value]{data: args.data, size: args.len}));
            if (sel err_moved.err) { ret res[bool, refusal.Error].err{err_moved.err}; }
            moved = true;
        }
        s = s + 1;
    }
    if (moved && b.blocks.data[k].predecessors.len == 0) {
        var gone:       [1]Block           = [1]Block{k};
        val err_erased: err[refusal.Error] = edit(body.erase_unreached(x.c.m, x.f, Slice[Block]{data: ?gone[0], size: 1}));
        if (sel err_erased.err) { ret res[bool, refusal.Error].err{err_erased.err}; }
        did(x.c, x.f, 1);
    }
    ret res[bool, refusal.Error].ok{moved};
}

# move the slot markers of forwarder `k`, which stand before its `br`, to the end of each predecessor, before its own
# `br`, in their order, so `k` holds its `br` alone. every edge into `k` is a lone `br` (`lone_ways_in`), so each path
# through `k` runs the same markers at the same point relative to every access, now just before the edge rather than
# just after it
fun hoist(x: *Run, k: Block, jump: Instruction) err[refusal.Error] {
    val b: *Body = x.b;
    var p: usize = 0;
    for (p < b.blocks.data[k].predecessors.len) {
        val at: Instruction = b.blocks.data[k].predecessors.data[p].instruction;
        var i:  Instruction = b.blocks.data[k].first;
        for (i != jump) {
            val next: Instruction = b.instructions.data[i].next;
            var ops:  [1]Value    = [1]Value{b.instructions.data[i].operands.data[0]};
            var md:   Metadata;
            md.location = b.instructions.data[i].metadata.location;
            md.site     = b.instructions.data[i].metadata.site;
            val opt_row: opt[*Row] = table.at(b.instructions.data[i].opcode);
            if (sel opt_row.none) { ret err[refusal.Error].err{refusal.Error.reason{"a slot marker has no opcode row"}}; }
            val res_made: res[Instruction, module.Error] = body.builder_make(x.c.m, x.f, opt_row.some, Request{opcode: b.instructions.data[i].opcode, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: Slice[Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: nil, size: 0}}, md);
            if (sel res_made.err) { ret err[refusal.Error].err{refusal.Error.ir{res_made.err}}; }
            val err_placed: err[refusal.Error] = edit(body.insert(x.c.m, x.f, at, res_made.ok));
            if (sel err_placed.err) { ret err_placed; }
            i = next;
        }
        p = p + 1;
    }
    var i: Instruction = b.blocks.data[k].first;
    for (i != jump) {
        val next:       Instruction        = b.instructions.data[i].next;
        val err_erased: err[refusal.Error] = edit(body.erase(x.c.m, x.f, i));
        if (sel err_erased.err) { ret err_erased; }
        i = next;
    }
    ret err[refusal.Error].ok{};
}

# whether block `k` holds slot markers before a `br` whose one edge is the only edge into its target, so the markers
# may move to the start of that target (`sink`), which every path through `k` enters straight after them
fun sinks(x: *Run, k: Block) bool {
    val b: *Body = x.b;
    if (k == 0 || !dominance.reachable(x.d, k)) { ret false; }
    val jump: Instruction = b.blocks.data[k].last;
    if (jump == NO_INSTRUCTION || jump == b.blocks.data[k].first || !markers_only(b, k, jump)) { ret false; }
    val d: *InstructionData = ?b.instructions.data[jump];
    if (d.opcode != table.BR || d.edges.len != 1 || d.metadata.flags.kept || d.metadata.flags.volatile) { ret false; }
    val to: Block = d.edges.data[0].block;
    ret to != k && to != 0 && b.blocks.data[to].predecessors.len == 1;
}

# move the slot markers of block `k`, in their order, to the start of the one block its `br` enters, which no other
# edge enters. each path through `k` runs them at the same point relative to every access, now just after the edge
# rather than just before it, and `k` holds its `br` alone
fun sink(x: *Run, k: Block) err[refusal.Error] {
    val b:    *Body       = x.b;
    val jump: Instruction = b.blocks.data[k].last;
    val to:   Block       = b.instructions.data[jump].edges.data[0].block;
    val head: Instruction = b.blocks.data[to].first;
    var i:    Instruction = b.blocks.data[k].first;
    for (i != jump) {
        val next:      Instruction        = b.instructions.data[i].next;
        val err_moved: err[refusal.Error] = edit(body.relocate(x.c.m, x.f, i, head));
        if (sel err_moved.err) { ret err_moved; }
        i = next;
    }
    ret err[refusal.Error].ok{};
}

# bypass every forwarder of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val b:                *Body                          = res_body.ok;
    val res_dominance_of: res[*Dominance, refusal.Error] = analysis.dominance_of(c.cache, u.f);
    if (sel res_dominance_of.err) { ret res[bool, refusal.Error].err{res_dominance_of.err}; }
    val res_loops_of: res[*Loops, refusal.Error] = analysis.loops_of(c.cache, u.f);
    if (sel res_loops_of.err) { ret res[bool, refusal.Error].err{res_loops_of.err}; }
    var ar:       arena.Arena;
    val err_made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.allocator(?scratch, ?ar);
    var x:       Run   = Run{c: c, f: u.f, b: b, d: res_dominance_of.ok, l: res_loops_of.ok, scratch: ?scratch};
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            arena.reset(?ar);
            var jump: Instruction = forwarder(?x, k::u32);
            if (jump == NO_INSTRUCTION && sinks(?x, k::u32)) {
                val err_sunk: err[refusal.Error] = sink(?x, k::u32);
                if (sel err_sunk.err) { ret res[bool, refusal.Error].err{err_sunk.err}; }
                changed = true;
                jump    = forwarder(?x, k::u32);
            }
            if (jump != NO_INSTRUCTION && jump != b.blocks.data[k].first) {
                val err_hoisted: err[refusal.Error] = hoist(?x, k::u32, jump);
                if (sel err_hoisted.err) { ret res[bool, refusal.Error].err{err_hoisted.err}; }
                changed = true;
            }
            if (jump != NO_INSTRUCTION) {
                val res_moved: res[bool, refusal.Error] = bypass(?x, k::u32, jump);
                if (sel res_moved.err) { ret res_moved; }
                if (res_moved.ok)      { changed = true; }
            }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
