# text tests of algebraic simplification, run through the driver

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.format;

use mirl.fold.algebra;
use mirl.fold.algebra.Algebra;
use mirl.fold.algebra.Element;
use mirl.fold.algebra.Facts;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.algebraic.ALGEBRAIC;
use mirl.opt.fold.FOLD;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.record.Pass;
use targets: mirl.target;
use mirl.target.Target;

#[testing]
fun parse(a: *allocator.Allocator, text: str, m: *Module) i32 {
    var got: res[Module, Refusal] = parse_body(a, View{data: text, len: str_len(text)});
    if (sel got.err) { ret 1; }
    @m = got.ok;
    ret 0;
}

# parse a text into m and run a pass over it, which must change it as expected,
# and again, which must change nothing
#[testing]
fun reduce(a: *allocator.Allocator, text: str, pass: *Pass, expect: bool, m: *Module) i32 {
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 2; }
    val parsed: i32 = parse(a, text, m);
    if (parsed != 0) { ret parsed; }
    var d: Driver = driver.init(m, row.some, Options{level: 1, checked: true});
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, pass);
    if (sel ran.err)      { ret 3; }
    if (ran.ok != expect) { ret 4; }
    val again: res[bool, Error] = driver.apply(?d, pass);
    if (sel again.err) { ret 5; }
    if (again.ok)      { ret 6; }
    ret 0;
}

#[testing]
fun same(x: *Module, y: *Module) i32 {
    val eq: res[bool, printer.Error] = equal.same(x, y);
    if (sel eq.err) { ret 7; }
    if (!eq.ok)     { ret 8; }
    ret 0;
}

#[testing]
fun make(a: *allocator.Allocator, entry: str, plain: str, ty: str, body: str) str {
    val got: res[str, format.FormatError] = format.sprint(a, "target \"riscv64-linux\"\nfunction @f: fun({}) -> ({}) {{\n^entry(%x: {}):\n{}}}\n", plain, ty, entry, body);
    if (sel got.err) { ret ""; }
    ret got.ok;
}

# the body of a function holding text, its result of type ty, simplified by
# the algebraic pass and compared with what the expected body gives unsimplified
#[testing]
fun check(a: *allocator.Allocator, param: str, ty: str, before: str, after: str) i32 {
    var got:  Module;
    var want: Module;
    val r:    i32 = reduce(a, make(a, param, param, ty, before), ?ALGEBRAIC, true, ?got);
    fin { module.dnit(?got); }
    if (r != 0) { ret r; }
    val p: i32 = parse(a, make(a, param, param, ty, after), ?want);
    fin { module.dnit(?want); }
    if (p != 0) { ret p; }
    ret same(?got, ?want);
}

# the element's spelling as an integer constant
#[testing]
fun spell(e: Element) str {
    if (sel e.zero) { ret "0"; }
    if (sel e.one)  { ret "1"; }
    ret "-1";
}

#[testing]
fun line(a: *allocator.Allocator, fmt: str, va: ...) str {
    val got: res[str, format.FormatError] = format.sprint(a, fmt, va...);
    if (sel got.err) { ret ""; }
    ret got.ok;
}

# one operand is the element, on the right and, for a commutative operation,
# on the left, and the result is what after names
#[testing]
fun element(a: *allocator.Allocator, name: str, ty: str, e: Element, commutes: bool, after: str) i32 {
    val right: i32 = check(a, ty, ty, line(a, "    %r = {} %x, {} {}\n    ret %r\n", name, ty, spell(e)), after);
    if (right != 0) { ret right; }
    if (!commutes)  { ret 0; }
    ret check(a, ty, ty, line(a, "    %r = {} {} {}, %x\n    ret %r\n", name, ty, spell(e)), after);
}

# an operation of two equal operands against the folder's constant on two zeros
#[testing]
fun settled(a: *allocator.Allocator, name: str, ty: str, out: str) i32 {
    var got:  Module;
    var want: Module;
    val r:    i32 = reduce(a, make(a, ty, ty, out, line(a, "    %r = {} %x, %x\n    ret %r\n", name)), ?ALGEBRAIC, true, ?got);
    fin { module.dnit(?got); }
    if (r != 0) { ret r; }
    val f: i32 = reduce(a, make(a, ty, ty, out, line(a, "    %r = {} {} 0, {} 0\n    ret %r\n", name, ty, ty)), ?FOLD, true, ?want);
    fin { module.dnit(?want); }
    if (f != 0) { ret f; }
    ret same(?got, ?want);
}

# every identity of the algebra table, applied to a function written for it
#[testing]
fun identities(a: *allocator.Allocator, i: u32) i32 {
    val op:  Opcode   = Opcode{index: i};
    val got: opt[Row] = opcode.row(op);
    if (sel got.none) { ret 1; }
    val name: str     = got.some.name;
    val alg:  Algebra = algebra.algebra(op);
    var ty:   str     = "i32";
    if (sel alg.op.flip || sel alg.op.magnitude) { ty = "binary32"; }
    var out: str = ty;
    if (sel alg.op.compare) { out = "i1"; }
    val f: Facts = alg.facts;
    if (!(sel f.neutral.none)) {
        val r: i32 = element(a, name, ty, f.neutral, alg.commutative, "    ret %x\n");
        if (r != 0) { ret r; }
    }
    if (!(sel f.absorbing.none)) {
        val r: i32 = element(a, name, ty, f.absorbing, alg.commutative, line(a, "    ret {} {}\n", ty, spell(f.absorbing)));
        if (r != 0) { ret r; }
    }
    if (!(sel f.vanishing.none)) {
        val r: i32 = element(a, name, ty, f.vanishing, false, line(a, "    ret {} 0\n", ty));
        if (r != 0) { ret r; }
    }
    if (sel f.same.operand) {
        val r: i32 = check(a, ty, ty, line(a, "    %r = {} %x, %x\n    ret %r\n", name), "    ret %x\n");
        if (r != 0) { ret r; }
    }
    if (sel f.same.zero) {
        val r: i32 = check(a, ty, ty, line(a, "    %r = {} %x, %x\n    ret %r\n", name), line(a, "    ret {} 0\n", ty));
        if (r != 0) { ret r; }
    }
    if (sel f.same.settled) {
        val r: i32 = settled(a, name, ty, out);
        if (r != 0) { ret r; }
    }
    if (sel f.twice.undo) {
        val r: i32 = check(a, ty, ty, line(a, "    %a = {} %x\n    %r = {} %a\n    ret %r\n", name, name), line(a, "    %a = {} %x\n    ret %x\n", name));
        if (r != 0) { ret r; }
    }
    if (sel f.twice.same) {
        val r: i32 = check(a, ty, ty, line(a, "    %a = {} %x\n    %r = {} %a\n    ret %r\n", name, name), line(a, "    %a = {} %x\n    ret %a\n", name));
        if (r != 0) { ret r; }
    }
    ret 0;
}

test algebraic__every_identity_of_the_table_applies {
    var a: allocator.Allocator;
    page.make(?a);
    var i: u32 = 0;
    for (i < opcode.rows()) {
        val r: i32 = identities(?a, i);
        if (r != 0) { ret (i * 16 + r::u32)::i32; }
        i = i + 1;
    }
    ret 0;
}

# a function the pass leaves as it is
#[testing]
fun stays(a: *allocator.Allocator, param: str, plain: str, ty: str, body: str) i32 {
    var got: Module;
    val r:   i32 = reduce(a, make(a, param, plain, ty, body), ?ALGEBRAIC, false, ?got);
    fin { module.dnit(?got); }
    if (r != 0) { ret r; }
    var want: Module;
    val p:    i32 = parse(a, make(a, param, plain, ty, body), ?want);
    fin { module.dnit(?want); }
    if (p != 0) { ret p; }
    ret same(?got, ?want);
}

test algebraic__identities_that_would_be_wrong_stay {
    # a sum with positive zero changes negative zero, a product with one
    # quiets a signalling not-a-number, and a difference of a value with itself
    # or a product with zero is not zero for infinity or not-a-number. a secret
    # result is never given a public constant, and a division of a value by
    # itself traps at zero
    var a: allocator.Allocator;
    page.make(?a);
    val floats: str = "    %a = fadd %x, binary32 0x00000000\n    %b = fmul %x, binary32 0x3f800000\n    %c = fsub %x, %x\n    %d = fmul %x, binary32 0x00000000\n    %e = fsub %x, binary32 0x80000000\n    ret %a\n";
    val f:      i32 = stays(?a, "binary32", "binary32", "binary32", floats);
    if (f != 0) { ret f; }
    val secret: str = "    %a = sub %x, %x\n    %b = mul %x, i32 0\n    %c = and %x, i32 0\n    ret %a\n";
    val s:      i32 = stays(?a, "secret i32", "i32", "i32", secret);
    if (s != 0) { ret 10 + s; }
    val traps: str = "    %a = div.u %x, %x\n    %b = rem.s %x, %x\n    ret %a\n";
    ret stays(?a, "i32", "i32", "i32", traps);
}
