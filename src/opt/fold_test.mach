# text tests of constant folding, run through the driver

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.fold.FOLD;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine.Machine;

#[testing]
fun check(before: str, after: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, opt[*Machine].none{}, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel ran.err) { ret 4; }
    if (!ran.ok)     { ret 4; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 7; }
    ret 0;
}

test fold__constants_fold_and_a_constant_branch_becomes_a_jump {
    # the operation folds, the branch on its result takes one edge, the block
    # the other edge led to goes, and the parameter that one edge fed is the
    # constant it was passed. a secret computation from constants stays
    val before: str = "target \"riscv64-linux\"\nfunction @f: fun(i32) -> (i32) {\n^entry(%x: i32):\n    %a = add i32 2, i32 3\n    %b = mul %a, %x\n    %c = eq %a, i32 5\n    %z = add i32 2, i32 3 secret\n    cbr %c, ^yes(%a), ^no\n^yes(%p: i32):\n    ret %p\n^no:\n    ret %b\n}\n";
    val after:  str = "target \"riscv64-linux\"\nfunction @f: fun(i32) -> (i32) {\n^entry(%x: i32):\n    %b = mul i32 5, %x\n    %z = add i32 2, i32 3 secret\n    br ^yes\n^yes:\n    ret i32 5\n}\n";
    ret check(before, after);
}

test fold__trapping_operation_is_left_to_run {
    val before: str = "target \"riscv64-linux\"\nfunction @g: fun() -> (i32) {\n^entry:\n    %a = add i32 1, i32 2\n    %q = div.s i32 7, i32 0\n    %r = add %a, %q\n    ret %r\n}\n";
    val after:  str = "target \"riscv64-linux\"\nfunction @g: fun() -> (i32) {\n^entry:\n    %q = div.s i32 7, i32 0\n    %r = add i32 3, %q\n    ret %r\n}\n";
    ret check(before, after);
}
