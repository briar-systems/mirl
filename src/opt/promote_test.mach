# text tests of the promotion of stack slots, run through the driver

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.promote.PROMOTE;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.basis;

# promote the text, and compare it with the text it should become
#[testing]
fun becomes(before: str, after: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, basis.NONE, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?PROMOTE);
    if (sel ran.err) { ret 4; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 5; }
    if (!same.ok)     { ret 5; }
    ret 0;
}

test promote__a_slot_whose_address_escapes_stays_in_memory {
    val text: str = "target \"riscv64-linux\"\nfunction @sink: fun(ptr) -> () linkage global visibility default\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    %p = alloca type i32, pointer ptr, align 4\n    store %p, %x, align 4\n    call ptr @sink, %p, signature fun(ptr) -> (), named all\n    %v = load %p, type i32, align 4\n    ret %v\n}\n";
    ret becomes(text, text);
}

test promote__a_value_merged_at_a_join_becomes_a_block_parameter {
    val input: str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"x\" !t0 declared !l0\nfunction @f: fun(i1, i32, i32) -> (i32) linkage global visibility default {\n^entry(%c: i1, %a: i32, %b: secret i32):\n    %p = alloca type i32, pointer ptr, align 4 bind [!v0]\n    cbr %c, ^left, ^right\n^left:\n    store %p, %a, align 4\n    br ^join\n^right:\n    store %p, %b, align 4\n    br ^join\n^join:\n    %v = load %p, type i32, align 4 secret\n    ret %v\n}\n";
    val want:  str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"x\" !t0 declared !l0\nfunction @f: fun(i1, i32, i32) -> (i32) linkage global visibility default {\n^entry(%c: i1, %a: i32, %b: secret i32):\n    bind !v0 unavailable\n    cbr %c, ^left, ^right\n^left:\n    bind !v0 = %a\n    br ^join(%a)\n^right:\n    bind !v0 = %b\n    br ^join(%b)\n^join(%v: secret i32):\n    bind !v0 = %v\n    ret %v\n}\n";
    ret becomes(input, want);
}

test promote__a_slot_read_before_any_store_gives_zero {
    val input: str = "target \"riscv64-linux\"\nfunction @f: fun() -> (i32) linkage global visibility default {\n^entry:\n    %p = alloca type i32, pointer ptr, align 4\n    %v = load %p, type i32, align 4\n    ret %v\n}\n";
    val want:  str = "target \"riscv64-linux\"\nfunction @f: fun() -> (i32) linkage global visibility default {\n^entry:\n    ret i32 zero\n}\n";
    ret becomes(input, want);
}

test promote__a_slot_with_a_kept_store_stays_in_memory {
    val text: str = "target \"riscv64-linux\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    %p = alloca type i32, pointer ptr, align 4\n    store %p, %x, align 4\n    %v = load %p, type i32, align 4\n    store %p, i32 0, align 4 kept\n    ret %v\n}\n";
    ret becomes(text, text);
}
