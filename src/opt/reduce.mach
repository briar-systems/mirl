# reduction of a division or remainder by a constant to multiplies and shifts
#
# a quotient by a power of two is a shift, a signed one first adding the divisor less one to a negative dividend so it
# truncates toward zero. a quotient by any other constant is the high half of a product by a magic number, shifted:
# for an unsigned width N, the least shift s for which m = ceil(2^(N+s) / d) holds in N bits and m*d - 2^(N+s) is at
# most 2^s, and where none does, m of N+1 bits at s = ceil(log2 d), its top bit added back as half the difference
# between the dividend and the high half. a signed quotient takes the least s for which m = ceil(2^(N+s) / |d|) holds
# in N bits and m*|d| - 2^(N+s) lies in (0, 2^(s+1)], which s = ceil(log2 |d|) - 1 always meets, reads m as signed and
# adds the dividend back where its top bit is set, adds one for a negative dividend, and is negated for a negative
# divisor. a remainder is the dividend less the quotient times the divisor.
#
# each magic number is checked in closed form as it is made: m*d - 2^(N+s) lies in [0, 2^s] for an unsigned one,
# whose dividends are below 2^N, and in (0, 2^(s+1)] for a signed one, whose dividends are at most 2^(N-1) in
# magnitude, which is what makes the product exact for every dividend of the width, and a divisor whose magic fails
# the check keeps its division.
#
# a division is reduced only where the target states the high half it needs: a form of it at the width, or a multiply
# at a width the narrow integer legalisation widens the high half to (`mirl.legal.narrow.runs_at`), the multiply's
# condition met as the helper legalisation reads it (`mirl.legal.helper.multiplies`). a divisor of zero, one, minus
# one or the least signed number, a vector, a width above the word the folder reads, and a division marked kept,
# volatile or secret, or of a secret dividend, keep their division.
#
# it adds no branch, no memory access and no edge, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.arena;

use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.table;
use mirl.ir.type.table.Type;
use mirl.legal.emit;
use mirl.legal.emit.Lane;
use mirl.legal.emit.Site;
use mirl.legal.helper;
use mirl.legal.narrow;
use mirl.pass.analysis;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.capability;
use mirl.target.capability.Sign;

# the pass: it rewrites instructions in place within their blocks, never an edge
pub val REDUCE: Pass = Pass{name: "reduce", kind: Kind.optimise{}, scope: Scope.function{visit}, needs: 0, preserves: analysis.FLOW, time: Time.keeps{}};

# a magic number and the shift after the high half of the product by it
# ---
# m:     the multiplier, of the width's bits
# shift: the shift after the high half
# add:   the multiplier has one more bit than the width, added back after the high half
rec Magic {
    m:     u64;
    shift: u32;
    add:   bool;
}

# a reduction in progress
# ---
# c:   the run
# s:   the rewrite site
# met: the build meets the condition of the target's multiply
rec Work {
    c:   *Context;
    s:   *Site;
    met: bool;
}

# the least `l` with 2^l at least `d`
fun log2_up(d: u64) u32 {
    var l: u32 = 0;
    for (l < 64 && (1::u128 << l::u128) < d::u128) { l = l + 1; }
    ret l;
}

# the magic of an unsigned division at width `n` by `d`, not a power of two and above one, none where no check holds
fun unsigned_magic(n: u32, d: u64) opt[Magic] {
    val l: u32 = log2_up(d);
    var s: u32 = 0;
    for (s < l) {
        val two: u128 = 1::u128 << (n + s)::u128;
        val m:   u128 = (two + d::u128 - 1) / d::u128;
        if (m < (1::u128 << n::u128)) {
            val e: u128 = m * d::u128 - two;
            if (e <= (1::u128 << s::u128)) { ret opt[Magic].some{Magic{m: m::u64, shift: s, add: false}}; }
        }
        s = s + 1;
    }
    # m - 2^n, of n bits, as ceil(2^n * (2^l - d) / d), and m*d - 2^(n+l) as m'*d - 2^n * (2^l - d)
    val gap: u128 = (1::u128 << l::u128) - d::u128;
    val top: u128 = gap << n::u128;
    val low: u128 = (top + d::u128 - 1) / d::u128;
    if (low >= (1::u128 << n::u128)) { ret opt[Magic].none{}; }
    val e: u128 = low * d::u128 - top;
    if (e > (1::u128 << l::u128)) { ret opt[Magic].none{}; }
    ret opt[Magic].some{Magic{m: low::u64, shift: l, add: true}};
}

# the magic of a signed division at width `n` by a divisor of magnitude `a`, not a power of two and above one, none
# where no check holds
fun signed_magic(n: u32, a: u64) opt[Magic] {
    val l: u32 = log2_up(a);
    var s: u32 = 0;
    for (s < l) {
        val two: u128 = 1::u128 << (n + s)::u128;
        val m:   u128 = (two + a::u128 - 1) / a::u128;
        val e:   u128 = m * a::u128 - two;
        if (m < (1::u128 << n::u128) && e > 0 && e <= (1::u128 << (s + 1)::u128)) {
            ret opt[Magic].some{Magic{m: m::u64, shift: s, add: m >= (1::u128 << (n - 1)::u128)}};
        }
        s = s + 1;
    }
    ret opt[Magic].none{};
}

# whether the target has the high half of a product at width `n` read by `sign`, as the gate of the pass states
fun high(w: *Work, n: u32, code: Opcode, sign: Sign) bool {
    if (!helper.multiplies(w.c.t, w.met, n))                       { ret false; }
    if (capability.computes_high(?w.c.t.caps.arithmetic, n, sign)) { ret true; }
    val opt_at: opt[u32] = narrow.runs_at(?w.c.t.caps, code, n);
    ret sel opt_at.some;
}

# a constant of the type of the rewrite
fun word(w: *Work, ty: Type, x: u64) res[Value, refusal.Error] {
    ret emit.word_constant(w.s, ty, x);
}

# the bits of width `n` of `x`
fun masked(n: u32, x: u64) u64 {
    if (n >= 64) { ret x; }
    ret x & ((1::u64 << n::u64) - 1);
}

# the unsigned quotient of `x` of type `ty` by the divisor magic `g` is made for, made ahead of the instruction
fun quotient_u(w: *Work, ty: Type, x: Value, g: Magic) res[Value, refusal.Error] {
    val res_m: res[Value, refusal.Error] = word(w, ty, g.m);
    if (sel res_m.err) { ret res_m; }
    val t: Value = emit.binary(w.s, table.MUL_HIGH_U, x, res_m.ok);
    if (!g.add) {
        if (g.shift == 0) { ret res[Value, refusal.Error].ok{t}; }
        val res_s: res[Value, refusal.Error] = word(w, ty, g.shift::u64);
        if (sel res_s.err) { ret res_s; }
        ret res[Value, refusal.Error].ok{emit.binary(w.s, table.SHR_U, t, res_s.ok)};
    }
    val res_one: res[Value, refusal.Error] = word(w, ty, 1);
    if (sel res_one.err) { ret res_one; }
    val half: Value = emit.binary(w.s, table.SHR_U, emit.binary(w.s, table.SUB, x, t), res_one.ok);
    val sum:  Value = emit.binary(w.s, table.ADD, half, t);
    if (g.shift == 1) { ret res[Value, refusal.Error].ok{sum}; }
    val res_s: res[Value, refusal.Error] = word(w, ty, (g.shift - 1)::u64);
    if (sel res_s.err) { ret res_s; }
    ret res[Value, refusal.Error].ok{emit.binary(w.s, table.SHR_U, sum, res_s.ok)};
}

# the signed quotient of `x` at width `n` and type `ty` by a divisor of magnitude `a` and sign `negative`
fun quotient_s(w: *Work, ty: Type, n: u32, x: Value, a: u64, negative: bool, pow: opt[u32]) res[Value, refusal.Error] {
    val res_top: res[Value, refusal.Error] = word(w, ty, (n - 1)::u64);
    if (sel res_top.err) { ret res_top; }
    var q: Value = 0;
    if (sel pow.some) {
        val k:      u32                       = pow.some;
        val sign:   Value                     = emit.binary(w.s, table.SHR_S, x, res_top.ok);
        val res_up: res[Value, refusal.Error] = word(w, ty, (n - k)::u64);
        if (sel res_up.err) { ret res_up; }
        val bias:  Value                     = emit.binary(w.s, table.SHR_U, sign, res_up.ok);
        val res_k: res[Value, refusal.Error] = word(w, ty, k::u64);
        if (sel res_k.err) { ret res_k; }
        q = emit.binary(w.s, table.SHR_S, emit.binary(w.s, table.ADD, x, bias), res_k.ok);
    }
    or {
        val opt_magic: opt[Magic] = signed_magic(n, a);
        if (sel opt_magic.none) { ret res[Value, refusal.Error].ok{0xffffffff}; }
        val g:     Magic                     = opt_magic.some;
        val res_m: res[Value, refusal.Error] = word(w, ty, g.m);
        if (sel res_m.err) { ret res_m; }
        var t: Value = emit.binary(w.s, table.MUL_HIGH_S, x, res_m.ok);
        if (g.add) { t = emit.binary(w.s, table.ADD, t, x); }
        if (g.shift != 0) {
            val res_s: res[Value, refusal.Error] = word(w, ty, g.shift::u64);
            if (sel res_s.err) { ret res_s; }
            t = emit.binary(w.s, table.SHR_S, t, res_s.ok);
        }
        q = emit.binary(w.s, table.SUB, t, emit.binary(w.s, table.SHR_S, x, res_top.ok));
    }
    if (negative) { q = emit.unary(w.s, table.NEG, q); }
    ret res[Value, refusal.Error].ok{q};
}

# the power of two `d` is, none for any other
fun power(d: u64) opt[u32] {
    if (d == 0 || (d & (d - 1)) != 0) { ret opt[u32].none{}; }
    var k: u32 = 0;
    for ((1::u64 << k::u64) != d) { k = k + 1; }
    ret opt[u32].some{k};
}

# reduce division or remainder `i` when it divides by a constant the pass takes, and say whether it did
fun reduce(w: *Work, i: Instruction) res[bool, refusal.Error] {
    val b:      *Body            = w.s.b;
    val d:      *InstructionData = ?b.instructions.data[i];
    val code:   Opcode           = d.opcode;
    val signed: bool             = code == table.DIV_S || code == table.REM_S;
    val rem:    bool             = code == table.REM_S || code == table.REM_U;
    if (!signed && code != table.DIV_U && code != table.REM_U)                   { ret res[bool, refusal.Error].ok{false}; }
    if (d.operands.len != 2 || d.results.len != 1 || d.immediates.len != 0)      { ret res[bool, refusal.Error].ok{false}; }
    if (d.metadata.flags.kept || d.metadata.flags.volatile || d.metadata.secret) { ret res[bool, refusal.Error].ok{false}; }
    val x: Value = d.operands.data[0];
    if (b.values.data[x].secret) { ret res[bool, refusal.Error].ok{false}; }
    val opt_raw: opt[u64] = emit.known(w.s, d.operands.data[1]);
    if (sel opt_raw.none) { ret res[bool, refusal.Error].ok{false}; }
    val ty:       Type                          = b.values.data[x].type;
    val res_lane: res[opt[Lane], refusal.Error] = emit.lane_of(w.s.m, ty);
    if (sel res_lane.err)     { ret res[bool, refusal.Error].err{res_lane.err}; }
    if (sel res_lane.ok.none) { ret res[bool, refusal.Error].ok{false}; }
    val n: u32 = res_lane.ok.some.bits;
    if (res_lane.ok.some.lanes != 0 || n < 2 || n > 64) { ret res[bool, refusal.Error].ok{false}; }
    val raw:      u64  = masked(n, opt_raw.some);
    var a:        u64  = raw;
    var negative: bool = false;
    if (signed && (raw >> (n - 1)::u64) != 0) {
        negative = true;
        a        = masked(n, 0 - raw);
    }
    if (a <= 1)                                  { ret res[bool, refusal.Error].ok{false}; }
    if (signed && a == (1::u64 << (n - 1)::u64)) { ret res[bool, refusal.Error].ok{false}; }
    val pow: opt[u32] = power(a);
    var g:   Magic    = Magic{m: 0, shift: 0, add: false};
    if (sel pow.none) {
        var hi:   Opcode = table.MUL_HIGH_U;
        var sign: Sign   = Sign.unsigned{};
        if (signed) {
            hi   = table.MUL_HIGH_S;
            sign = Sign.signed{};
        }
        if (!high(w, n, hi, sign)) { ret res[bool, refusal.Error].ok{false}; }
        if (!signed) {
            val opt_magic: opt[Magic] = unsigned_magic(n, a);
            if (sel opt_magic.none) { ret res[bool, refusal.Error].ok{false}; }
            g = opt_magic.some;
        }
        or {
            val opt_magic: opt[Magic] = signed_magic(n, a);
            if (sel opt_magic.none) { ret res[bool, refusal.Error].ok{false}; }
        }
    }
    if (rem && !helper.multiplies(w.c.t, w.met, n) && (sel pow.none || signed)) { ret res[bool, refusal.Error].ok{false}; }

    emit.begin(w.s, i);
    var q: Value = 0;
    if (!signed) {
        if (sel pow.some) {
            if (rem) {
                val res_mask: res[Value, refusal.Error] = word(w, ty, a - 1);
                if (sel res_mask.err) { ret res[bool, refusal.Error].err{res_mask.err}; }
                emit.end(w.s, i);
                emit.binary(w.s, table.AND, x, res_mask.ok);
                val err_built: err[refusal.Error] = emit.done(w.s);
                if (sel err_built.err) { ret res[bool, refusal.Error].err{err_built.err}; }
                ret res[bool, refusal.Error].ok{true};
            }
            val res_k: res[Value, refusal.Error] = word(w, ty, pow.some::u64);
            if (sel res_k.err) { ret res[bool, refusal.Error].err{res_k.err}; }
            emit.end(w.s, i);
            emit.binary(w.s, table.SHR_U, x, res_k.ok);
            val err_built: err[refusal.Error] = emit.done(w.s);
            if (sel err_built.err) { ret res[bool, refusal.Error].err{err_built.err}; }
            ret res[bool, refusal.Error].ok{true};
        }
        val res_q: res[Value, refusal.Error] = quotient_u(w, ty, x, g);
        if (sel res_q.err) { ret res[bool, refusal.Error].err{res_q.err}; }
        q = res_q.ok;
    }
    or {
        val res_q: res[Value, refusal.Error] = quotient_s(w, ty, n, x, a, negative, pow);
        if (sel res_q.err) { ret res[bool, refusal.Error].err{res_q.err}; }
        q = res_q.ok;
    }
    if (rem) {
        val res_d: res[Value, refusal.Error] = word(w, ty, raw);
        if (sel res_d.err) { ret res[bool, refusal.Error].err{res_d.err}; }
        val product: Value = emit.binary(w.s, table.MUL, q, res_d.ok);
        emit.end(w.s, i);
        emit.binary(w.s, table.SUB, x, product);
        val err_built: err[refusal.Error] = emit.done(w.s);
        if (sel err_built.err) { ret res[bool, refusal.Error].err{err_built.err}; }
        ret res[bool, refusal.Error].ok{true};
    }
    val err_built: err[refusal.Error] = emit.done(w.s);
    if (sel err_built.err) { ret res[bool, refusal.Error].err{err_built.err}; }
    val old:           Value              = b.instructions.data[i].results.data[0];
    val err_forwarded: err[refusal.Error] = refusal.edit(body.replace(w.s.m, w.s.f, old, q, Records.follow{}));
    if (sel err_forwarded.err) { ret res[bool, refusal.Error].err{err_forwarded.err}; }
    val err_gone: err[refusal.Error] = refusal.edit(body.erase(w.s.m, w.s.f, i));
    if (sel err_gone.err) { ret res[bool, refusal.Error].err{err_gone.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# reduce the divisions by constants of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val b:       *Body                  = res_body.ok;
    val res_met: res[bool, basis.Error] = basis.meets(c.basis, c.t.caps.arithmetic.multiplied);
    if (sel res_met.err) { ret res[bool, refusal.Error].err{refusal.Error.condition{res_met.err}}; }
    var ar:       arena.Arena;
    val err_made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.allocator(?scratch, ?ar);
    var site: Site = emit.init(c.m, u.f, b, ?scratch);
    fin { emit.dnit(?site); }
    var w:       Work  = Work{c: c, s: ?site, met: res_met.ok};
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                val next:        Instruction              = b.instructions.data[i].next;
                val res_reduced: res[bool, refusal.Error] = reduce(?w, i);
                if (sel res_reduced.err) { ret res[bool, refusal.Error].err{res_reduced.err}; }
                if (res_reduced.ok)      { changed = true; }
                i = next;
            }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
