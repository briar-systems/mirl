# text tests of dead code removal, run through the driver

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.opt.dce.DCE;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.basis;

#[testing]
fun check(before: str, after: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (!(sel row.some)) { ret 1; }
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, basis.NONE, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?DCE);
    if (sel ran.err) { ret 4; }
    if (!ran.ok)     { ret 4; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, ?DCE);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 7; }
    ret 0;
}

test dce__unused_is_removed_and_trapping_is_kept {
    # a record of a value that goes is salvaged over the operands that outlive
    # it, or left unavailable
    val before: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!t1 = type \"i64\" \"i64\" base signed 64\n!v0 = variable \"v\" !t0 declared !l0\n!v1 = variable \"w\" !t1 declared !l0\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y\n    %d = add %x, %y\n    bind !v0 = %d\n    %e = add i32 4, %x\n    %g = ext.s %e, to i64\n    bind !v1 = %g\n    %unused = mul %x, %y\n    %q = div.s %x, %y\n    ret %a\n}\n";
    val after:  str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i32\" \"i32\" base signed 32\n!t1 = type \"i64\" \"i64\" base signed 64\n!v0 = variable \"v\" !t0 declared !l0\n!v1 = variable \"w\" !t1 declared !l0\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %a = add %x, %y\n    bind !v0 unavailable\n    bind !v1 = %x, add i32 4, ext.s i64\n    %q = div.s %x, %y\n    ret %a\n}\n";
    ret check(before, after);
}

test dce__unreachable_block_goes_with_its_arguments {
    val before: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @g: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    br ^head(%x, %x)\n^orphan(%o: i32):\n    %z = add %o, %o\n    br ^head(%z, %z)\n^head(%v: i32, %c: i32):\n    %next = add %c, i32 1\n    %again = lt.s %v, i32 10\n    cbr %again, ^head(%v, %next), ^exit\n^exit:\n    ret %v\n}\n";
    val after:  str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @g: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    br ^head(%x)\n^head(%v: i32):\n    %again = lt.s %v, i32 10\n    cbr %again, ^head(%v), ^exit\n^exit:\n    ret %v\n}\n";
    ret check(before, after);
}
