# a queue of instructions to look at, each at most once at a time
#
# a pass that works from a fixed point queues what it reads and what a change
# makes worth reading again, so it never rescans the function.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.pass.failure;
use mirl.pass.failure.Why;

# the instructions waiting and whether each, by index, is waiting
pub rec Queue {
    ready:  vector.Vector[Instruction];
    queued: vector.Vector[u8];
}

pub fun init(a: *allocator.Allocator) Queue {
    ret Queue{ready: vector.init[Instruction](a), queued: vector.init[u8](a)};
}

pub fun dnit(q: *Queue) {
    vector.dnit[Instruction](?q.ready);
    vector.dnit[u8](?q.queued);
}

# extend a flag list with zeros to n entries
pub fun grow(v: *vector.Vector[u8], n: usize) err[Why] {
    for (v.len < n) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, 0);
        if (sel pushed.err) { ret failure.lost(pushed.err); }
    }
    ret err[Why].ok{};
}

# queue an instruction unless it waits already
pub fun want(q: *Queue, i: Instruction) err[Why] {
    val sized: err[Why] = grow(?q.queued, i.index::usize + 1);
    if (sel sized.err)               { ret sized; }
    if (q.queued.data[i.index] != 0) { ret err[Why].ok{}; }
    q.queued.data[i.index] = 1;
    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?q.ready, i);
    if (sel pushed.err) { ret failure.lost(pushed.err); }
    ret err[Why].ok{};
}

pub fun empty(q: *Queue) bool {
    ret q.ready.len == 0;
}

# take the instruction queued last, which the queue must hold
pub fun take(q: *Queue) Instruction {
    val i: Instruction = q.ready.data[q.ready.len - 1];
    q.ready.len            = q.ready.len - 1;
    q.queued.data[i.index] = 0;
    ret i;
}

# copy the users of a value, which an edit about to be made rewrites
pub fun copy_uses(b: *Body, v: Value, out: *vector.Vector[Instruction]) err[Why] {
    val list: *vector.Vector[Instruction] = ?b.values.data[v.index].uses;
    var n:    usize                       = 0;
    for (n < list.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Instruction](out, list.data[n]);
        if (sel pushed.err) { ret failure.lost(pushed.err); }
        n = n + 1;
    }
    ret err[Why].ok{};
}

# queue every instruction of a list
pub fun want_all(q: *Queue, list: *vector.Vector[Instruction]) err[Why] {
    var n: usize = 0;
    for (n < list.len) {
        val r: err[Why] = want(q, list.data[n]);
        if (sel r.err) { ret r; }
        n = n + 1;
    }
    ret err[Why].ok{};
}
