# common subexpression elimination: a computation that repeats an earlier one
# is replaced by the earlier result
#
# the blocks are walked down the dominator tree, so an earlier instruction
# always dominates the later one it stands for. two instructions are the same
# computation when they have the same opcode, flags, secrecy, result types,
# immediates and operands, an operand being the same value or a constant of
# the same bits, so distinct zeros and nan payloads stay apart. a commutative
# operation, as the algebra table states it, matches with its operands
# swapped. they are found through a table keyed by that identity, scoped to the
# tree, never by comparing pairs.
#
# a row that states itself mergeable is a candidate. a row that reads memory,
# writes none and states no memory ordering is a candidate too, and its
# instance stands for an earlier one only while nothing between them may write
# what it reads. the memory analysis states what each instruction may touch.
# the loads still available are indexed by the group of the place they read,
# so a write is asked of the loads of its own group alone, and an ordered
# access or a write whose place has no group ends the availability of every
# load. a write that may reach anywhere, as a call, ends every load but those
# of a slot whose address never escapes, which it cannot reach. a block with more than one way in starts
# with no load available, since a path into it may have written. a volatile
# or ordered access, and a kept write, are never merged, and a write that is
# kept ends availability as any other.
#
# the survivor keeps its own metadata. both of two merged instructions are
# equal in secrecy, so no public use comes to read a secret value, and the
# body edits refuse the rest. the pass adds no branch and reads no secret, so
# it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice.hash_view;
use mirl.base.slice.mix;
use mirl.base.slice.same_view;
use mirl.fold.algebra;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.rule;
use mirl.ir.place;
use mirl.ir.value.ValueData;
use mirl.opt.instance.plain;
use mirl.opt.instance.reads_only;
use mirl.opt.instance.row_of;
use mirl.pass.analysis;
use mirl.pass.analysis.memory;
use mirl.pass.analysis.memory.Effect;
use mirl.pass.analysis.memory.Memory;
use mirl.pass.cache;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.pass.refusal.edit;
use mirl.pass.refusal.lost;

# the pass: it removes instructions and values, so only the control flow
# analyses outlive it
pub val CSE: Pass = Pass{name: "cse", kind: Kind.optimise{}, scope: Scope.function{visit}, needs: analysis.OF_DOMINANCE | analysis.OF_MEMORY, preserves: analysis.FLOW, time: Time.keeps{}};

val NONE: u32 = 0xffffffff;

val UNDO_DEAD:    u8 = 1;
val UNDO_BARRIER: u8 = 2;
val UNDO_CLEARED: u8 = 3;
val UNDO_SHARED:  u8 = 4;

# a computation available at this point of the walk
# ---
# inst:   the instruction
# prev:   the older entry of the same computation, or none
# load:   it reads memory, so it can be ended by a write
# seq:    when it was made, counting every entry of the walk
# dead:   a write has ended it
# group:  the group of the place a load reads, zero for no group
# next:   the older entry of the same group, or none
# effect: what a load reads
rec Entry {
    inst:   Instruction;
    prev:   u32;
    load:   bool;
    seq:    u32;
    dead:   bool;
    group:  u64;
    next:   u32;
    effect: Effect;
}

# the loads of one group
# ---
# head:    the newest entry
# cleared: the entries made up to this count are ended
rec Bucket {
    head:    u32;
    cleared: u32;
}

# a change of the availability a block's subtree undoes on leaving it
# ---
# kind:  which change
# at:    the entry ended, or the count a barrier or a bucket had before
# group: the bucket changed
rec Undo {
    kind:  u8;
    at:    u32;
    group: u64;
}

# a block of the walk
# ---
# block:   the block
# child:   how many of its children are done
# entries: how many entries stood before it
# log:     how many changes stood before it
rec Frame {
    block:   u32;
    child:   usize;
    entries: usize;
    log:     usize;
}

# an instruction as the table sees it
rec Key {
    s:    *Sweep;
    inst: u32;
}

# one run over a function
# ---
# m, f, b: the module, the function and its body
# dom:     its dominance
# cache:   the cache the memory analysis is read from
# mem:     the memory analysis, nil until a load asks for it
# seen:    for each computation, its newest entry
# groups:  for each group of loads, its entries
# entries: the available computations in the order they were made
# log:     the changes of availability, to undo on leaving a subtree
# stack:   the blocks of the walk
# gone:    the instructions of the block being walked that were merged
# barrier: the entries made up to this count are ended
# shared:  the entries made up to this count are ended unless they load from a
#          slot whose address never escapes
# count:   the entries made so far
# loads:   how many entries are loads
# changed: something was merged
# failed:  hashing or comparing found an unreadable constant
# why:     why
rec Sweep {
    m:       *Module;
    f:       Function;
    b:       *Body;
    dom:     *Dominance;
    cache:   *cache.Cache;
    mem:     *Memory;
    seen:    map.MapBy[Key, u32];
    groups:  map.Map[u64, Bucket];
    entries: vector.Vector[Entry];
    log:     vector.Vector[Undo];
    stack:   vector.Vector[Frame];
    gone:    vector.Vector[Instruction];
    barrier: u32;
    shared:  u32;
    count:   u32;
    loads:   usize;
    changed: bool;
    failed:  bool;
    why:     refusal.Error;
}

fun fault(s: *Sweep, e: module.Error) {
    if (s.failed) { ret; }
    s.failed = true;
    s.why    = refusal.Error.ir{e};
}

fun hash_wide(h: u64, x: Wide) u64 {
    var acc: u64 = h;
    var i:   u32 = 0;
    for (i < word.words()) {
        acc = mix(acc, x[i]);
        i   = i + 1;
    }
    ret acc;
}

fun same_wide(x: Wide, y: Wide) bool {
    var i: u32 = 0;
    for (i < word.words()) {
        if (x[i] != y[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bits a constant holds when it is a number or a zero, whose bits are all clear
fun bits_of(d: ConstantData) opt[Wide] {
    if (sel d.integer) { ret opt[Wide].some{word.of(d.integer.words)}; }
    if (sel d.float)   { ret opt[Wide].some{word.of(d.float.words)}; }
    if (sel d.zero)    { ret opt[Wide].some{word.zero()}; }
    ret opt[Wide].none{};
}

fun hash_symbol(h: u64, y: Symbol) u64 {
    if (sel y.function) { ret mix(mix(h, 1), y.function::u64); }
    ret mix(mix(h, 2), y.global::u64);
}

fun same_symbol(x: Symbol, y: Symbol) bool {
    if (sel x.function) {
        if (sel y.function) { ret x.function == y.function; }
        ret false;
    }
    if (sel y.global) { ret x.global == y.global; }
    ret false;
}

fun hash_constant(s: *Sweep, c: Constant) u64 {
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(s.m, c);
    if (sel res_constant_data.err) {
        fault(s, res_constant_data.err);
        ret 0;
    }
    val d: ConstantData = res_constant_data.ok;
    if (sel d.integer)  { ret hash_wide(1, word.of(d.integer.words)); }
    or (sel d.float)    { ret hash_wide(1, word.of(d.float.words)); }
    or (sel d.absolute) { ret hash_wide(6, word.of(d.absolute.words)); }
    or (sel d.zero)     { ret hash_wide(1, word.zero()); }
    or (sel d.aggregate) {
        var h: u64   = mix(2, d.aggregate.elements.size::u64);
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            h = mix(h, hash_constant(s, d.aggregate.elements.data[i]));
            i = i + 1;
        }
        ret h;
    }
    or (sel d.address) {
        ret mix(hash_symbol(3, d.address.symbol), d.address.offset::u64);
    }
    or (sel d.bytes) {
        var h: u64   = mix(5, d.bytes.data.size::u64);
        var i: usize = 0;
        for (i < d.bytes.data.size) {
            h = mix(h, d.bytes.data.data[i]::u64);
            i = i + 1;
        }
        ret h;
    }
    ret mix(4, d.spec.id::u64);
}

fun same_constant(s: *Sweep, x: Constant, y: Constant) bool {
    if (x == y) { ret true; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(s.m, x);
    if (sel res_constant_data.err) {
        fault(s, res_constant_data.err);
        ret false;
    }
    val res_constantdata: res[ConstantData, module.Error] = module.constant_data(s.m, y);
    if (sel res_constantdata.err) {
        fault(s, res_constantdata.err);
        ret false;
    }
    val a:           ConstantData = res_constant_data.ok;
    val b:           ConstantData = res_constantdata.ok;
    val opt_bits_of: opt[Wide]    = bits_of(a);
    val opt_b_bits:  opt[Wide]    = bits_of(b);
    if (sel opt_bits_of.some) {
        if (sel opt_b_bits.some) { ret same_wide(opt_bits_of.some, opt_b_bits.some); }
        ret false;
    }
    if (sel opt_b_bits.some) { ret false; }
    if (sel a.aggregate) {
        if (!(sel b.aggregate))                                     { ret false; }
        if (a.aggregate.elements.size != b.aggregate.elements.size) { ret false; }
        var i: usize = 0;
        for (i < a.aggregate.elements.size) {
            if (!same_constant(s, a.aggregate.elements.data[i], b.aggregate.elements.data[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel a.address) {
        if (!(sel b.address))                                     { ret false; }
        if (sel a.address.minus.some != sel b.address.minus.some) { ret false; }
        if (sel a.address.minus.some) {
            if (!(sel b.address.minus.some))                              { ret false; }
            if (!same_symbol(a.address.minus.some, b.address.minus.some)) { ret false; }
        }
        ret same_symbol(a.address.symbol, b.address.symbol) && a.address.offset == b.address.offset && a.address.type == b.address.type;
    }
    if (sel a.absolute) {
        if (!(sel b.absolute)) { ret false; }
        ret a.absolute.type == b.absolute.type && same_wide(word.of(a.absolute.words), word.of(b.absolute.words));
    }
    if (sel a.spec) {
        if (!(sel b.spec)) { ret false; }
        ret a.spec.id == b.spec.id && a.spec.default.type == b.spec.default.type;
    }
    if (sel a.bytes) {
        if (!(sel b.bytes)) { ret false; }
        ret a.bytes.type == b.bytes.type && same_view(View{data: a.bytes.data.data, len: a.bytes.data.size}, View{data: b.bytes.data.data, len: b.bytes.data.size});
    }
    ret false;
}

fun hash_operand(s: *Sweep, v: Value) u64 {
    val vd: *ValueData = ?s.b.values.data[v];
    if (sel vd.def.constant) { ret mix(mix(1, vd.type::u64), hash_constant(s, vd.def.constant)); }
    ret mix(2, v::u64);
}

fun same_operand(s: *Sweep, x: Value, y: Value) bool {
    if (x == y) { ret true; }
    val vx: *ValueData = ?s.b.values.data[x];
    val vy: *ValueData = ?s.b.values.data[y];
    if (!(sel vx.def.constant)) { ret false; }
    if (!(sel vy.def.constant)) { ret false; }
    if (vx.type != vy.type)     { ret false; }
    ret same_constant(s, vx.def.constant, vy.def.constant);
}

fun hash_immediate(h: u64, i: Immediate) u64 {
    if (sel i.ty)        { ret mix(mix(h, 1), i.ty::u64); }
    or (sel i.alignment) { ret mix(mix(h, 2), i.alignment); }
    or (sel i.ordering)  { ret mix(mix(h, 3), rule.index(i.ordering)::u64); }
    or (sel i.lane)      { ret mix(mix(h, 4), i.lane::u64); }
    or (sel i.lanes) {
        var acc: u64   = mix(h, 5);
        var n:   usize = 0;
        for (n < i.lanes.size) {
            acc = mix(acc, i.lanes.data[n]::u64);
            n   = n + 1;
        }
        ret acc;
    }
    or (sel i.named) {
        if (sel i.named.first) { ret mix(mix(h, 6), i.named.first::u64 + 1); }
        ret mix(h, 6);
    }
    or (sel i.places) { ret mix(mix(h, 7), i.places.size::u64); }
    or (sel i.member) { ret mix(mix(h, 8), i.member::u64); }
    or (sel i.cases) {
        var acc: u64   = mix(h, 9);
        var n:   usize = 0;
        for (n < i.cases.size) {
            acc = mix(acc, i.cases.data[n]);
            n   = n + 1;
        }
        ret acc;
    }
    or (sel i.function) { ret mix(mix(h, 10), i.function::u64); }
    or (sel i.op)       { ret hash_view(hash_view(mix(h, 11), i.op.set), i.op.name); }
    or (sel i.state)    { ret hash_view(mix(h, 12), i.state); }
    or (sel i.assembly) { ret mix(h, 13); }
}

fun same_immediate(x: Immediate, y: Immediate) bool {
    if (sel x.ty)        { ret sel y.ty && x.ty == y.ty; }
    or (sel x.alignment) { ret sel y.alignment && x.alignment == y.alignment; }
    or (sel x.ordering)  { ret sel y.ordering && rule.index(x.ordering) == rule.index(y.ordering); }
    or (sel x.lane)      { ret sel y.lane && x.lane == y.lane; }
    or (sel x.lanes) {
        if (!(sel y.lanes))               { ret false; }
        if (x.lanes.size != y.lanes.size) { ret false; }
        var n: usize = 0;
        for (n < x.lanes.size) {
            if (x.lanes.data[n] != y.lanes.data[n]) { ret false; }
            n = n + 1;
        }
        ret true;
    }
    or (sel x.named) {
        if (!(sel y.named))    { ret false; }
        if (sel x.named.first) { ret sel y.named.first && y.named.first == x.named.first; }
        ret (sel x.named.all) == (sel y.named.all);
    }
    or (sel x.member)   { ret sel y.member && x.member == y.member; }
    or (sel x.function) { ret sel y.function && x.function == y.function; }
    or (sel x.op) {
        if (!(sel y.op)) { ret false; }
        ret same_view(x.op.set, y.op.set) && same_view(x.op.name, y.op.name);
    }
    or (sel x.state)    { ret sel y.state && same_view(x.state, y.state); }
    or (sel x.assembly) { ret sel y.assembly && x.assembly == y.assembly; }
    or (sel x.cases) {
        if (!(sel y.cases))               { ret false; }
        if (x.cases.size != y.cases.size) { ret false; }
        var n: usize = 0;
        for (n < x.cases.size) {
            if (x.cases.data[n] != y.cases.data[n]) { ret false; }
            n = n + 1;
        }
        ret true;
    }
    or (sel x.places) {
        if (!(sel y.places))                { ret false; }
        if (x.places.size != y.places.size) { ret false; }
        var n: usize = 0;
        for (n < x.places.size) {
            if (!place.same(x.places.data[n], y.places.data[n])) { ret false; }
            n = n + 1;
        }
        ret true;
    }
}

fun hash_key(k: *Key) u64 {
    val s: *Sweep           = k.s;
    val d: *InstructionData = ?s.b.instructions.data[k.inst];
    var h: u64              = mix(0xcbf29ce484222325, d.opcode::u64);
    h = mix(h, d.metadata.secret::u64);
    h = mix(h, d.metadata.flags.volatile::u64);
    h = mix(h, d.metadata.flags.kept::u64);
    h = mix(h, d.metadata.flags.bounded::u64);
    h = mix(h, d.metadata.flags.checked::u64);
    h = mix(h, d.metadata.flags.public::u64);
    h = mix(h, d.metadata.flags.ascending::u64);
    h = mix(h, d.metadata.flags.descending::u64);
    var i: usize = 0;
    for (i < d.results.len) {
        h = mix(h, s.b.values.data[d.results.data[i]].type::u64);
        h = mix(h, s.b.values.data[d.results.data[i]].secret::u64);
        i = i + 1;
    }
    i = 0;
    for (i < d.immediates.len) {
        h = hash_immediate(h, d.immediates.data[i]);
        i = i + 1;
    }
    if (d.operands.len == 2 && algebra.algebra(d.opcode).commutative) {
        ret mix(h, hash_operand(s, d.operands.data[0]) + hash_operand(s, d.operands.data[1]));
    }
    i = 0;
    for (i < d.operands.len) {
        h = mix(h, hash_operand(s, d.operands.data[i]));
        i = i + 1;
    }
    ret h;
}

fun same_key(x: *Key, y: *Key) bool {
    if (x.inst == y.inst) { ret true; }
    val s: *Sweep           = x.s;
    val a: *InstructionData = ?s.b.instructions.data[x.inst];
    val b: *InstructionData = ?s.b.instructions.data[y.inst];
    if (a.opcode != b.opcode)                                                   { ret false; }
    if (!metadata.same_flags(a.metadata.flags, b.metadata.flags))               { ret false; }
    if (a.metadata.secret != b.metadata.secret)                                 { ret false; }
    if (a.results.len != b.results.len || a.immediates.len != b.immediates.len) { ret false; }
    if (a.operands.len != b.operands.len)                                       { ret false; }
    var i: usize = 0;
    for (i < a.results.len) {
        val va: *ValueData = ?s.b.values.data[a.results.data[i]];
        val vb: *ValueData = ?s.b.values.data[b.results.data[i]];
        if (va.type != vb.type || va.secret != vb.secret) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.immediates.len) {
        if (!same_immediate(a.immediates.data[i], b.immediates.data[i])) { ret false; }
        i = i + 1;
    }
    if (a.operands.len == 2 && algebra.algebra(a.opcode).commutative) {
        val straight: bool = same_operand(s, a.operands.data[0], b.operands.data[0]) && same_operand(s, a.operands.data[1], b.operands.data[1]);
        if (straight) { ret true; }
        ret same_operand(s, a.operands.data[0], b.operands.data[1]) && same_operand(s, a.operands.data[1], b.operands.data[0]);
    }
    i = 0;
    for (i < a.operands.len) {
        if (!same_operand(s, a.operands.data[i], b.operands.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a row states that its instance may be merged with an equal one
fun merges(r: *Row) bool {
    ret r.effects.mergeable;
}

fun bucket(s: *Sweep, g: u64) opt[*Bucket] {
    val key: u64 = g;
    ret map.get[u64, Bucket](?s.groups, ?key);
}

# whether a write or a join has not ended an entry
fun live(s: *Sweep, e: *Entry) bool {
    if (e.dead || e.seq <= s.barrier)                                    { ret false; }
    if (e.load && e.seq <= s.shared && !e.effect.places.data[0].private) { ret false; }
    val opt_bucket: opt[*Bucket] = bucket(s, e.group);
    if (sel opt_bucket.some) { ret e.seq > opt_bucket.some.cleared; }
    ret true;
}

# the bucket of a group that has one
fun held(s: *Sweep, g: u64) res[*Bucket, refusal.Error] {
    val opt_bucket: opt[*Bucket] = bucket(s, g);
    if (!(sel opt_bucket.some)) { ret res[*Bucket, refusal.Error].err{refusal.Error.reason{"a group of loads is missing its bucket"}}; }
    ret res[*Bucket, refusal.Error].ok{opt_bucket.some};
}

# the bucket of a group, made when the group has none
fun bucket_make(s: *Sweep, g: u64) res[*Bucket, refusal.Error] {
    val opt_bucket: opt[*Bucket] = bucket(s, g);
    if (sel opt_bucket.some) { ret res[*Bucket, refusal.Error].ok{opt_bucket.some}; }
    val res_made: res[bool, allocator.Error] = map.insert[u64, Bucket](?s.groups, g, Bucket{head: NONE, cleared: 0});
    if (sel res_made.err) { ret res[*Bucket, refusal.Error].err{refusal.Error.alloc{res_made.err}}; }
    ret held(s, g);
}

fun set_head(s: *Sweep, g: u64, head: u32) err[refusal.Error] {
    val res_held: res[*Bucket, refusal.Error] = held(s, g);
    if (sel res_held.err) { ret err[refusal.Error].err{res_held.err}; }
    res_held.ok.head = head;
    ret err[refusal.Error].ok{};
}

fun set_cleared(s: *Sweep, g: u64, count: u32) err[refusal.Error] {
    val res_held: res[*Bucket, refusal.Error] = held(s, g);
    if (sel res_held.err) { ret err[refusal.Error].err{res_held.err}; }
    res_held.ok.cleared = count;
    ret err[refusal.Error].ok{};
}

fun push_log(s: *Sweep, u: Undo) err[refusal.Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[Undo](?s.log, u);
    if (sel res_pushed.err) { ret lost(res_pushed.err); }
    ret err[refusal.Error].ok{};
}

# end every load
fun end_all(s: *Sweep) err[refusal.Error] {
    val err_push_log: err[refusal.Error] = push_log(s, Undo{kind: UNDO_BARRIER, at: s.barrier, group: 0});
    if (sel err_push_log.err) { ret err_push_log; }
    s.barrier = s.count;
    ret err[refusal.Error].ok{};
}

# end every load but those of a slot whose address never escapes
fun end_shared(s: *Sweep) err[refusal.Error] {
    val err_push_log: err[refusal.Error] = push_log(s, Undo{kind: UNDO_SHARED, at: s.shared, group: 0});
    if (sel err_push_log.err) { ret err_push_log; }
    s.shared = s.count;
    ret err[refusal.Error].ok{};
}

fun end_group(s: *Sweep, g: u64) err[refusal.Error] {
    val opt_bucket: opt[*Bucket] = bucket(s, g);
    if (!(sel opt_bucket.some)) { ret err[refusal.Error].ok{}; }
    val err_push_log: err[refusal.Error] = push_log(s, Undo{kind: UNDO_CLEARED, at: opt_bucket.some.cleared, group: g});
    if (sel err_push_log.err) { ret err_push_log; }
    ret set_cleared(s, g, s.count);
}

# end the loads a write may change: every load for an access that orders, and
# every load but a private slot's for a write that reaches anywhere
fun end_by(s: *Sweep, w: Effect) err[refusal.Error] {
    if (!w.writes && !w.ordered) { ret err[refusal.Error].ok{}; }
    if (w.ordered)               { ret end_all(s); }
    if (w.anywhere) {
        val err_ended: err[refusal.Error] = end_shared(s);
        if (sel err_ended.err) { ret err_ended; }
    }
    var p: usize = 0;
    for (p < w.places.len) {
        val opt_group: opt[u64] = memory.group(w.places.data[p]);
        if (!(sel opt_group.some)) { ret end_all(s); }
        val opt_bucket: opt[*Bucket] = bucket(s, opt_group.some);
        if (sel opt_bucket.some) {
            var e: u32 = opt_bucket.some.head;
            for (e != NONE) {
                val at: *Entry = ?s.entries.data[e];
                if (live(s, at) && memory.conflicts(w, at.effect)) {
                    val err_push_log: err[refusal.Error] = push_log(s, Undo{kind: UNDO_DEAD, at: e, group: opt_group.some});
                    if (sel err_push_log.err) { ret err_push_log; }
                    at.dead = true;
                }
                e = at.next;
            }
        }
        val err_end_group: err[refusal.Error] = end_group(s, 0);
        if (sel err_end_group.err) { ret err_end_group; }
        p = p + 1;
    }
    ret err[refusal.Error].ok{};
}

fun need_memory(s: *Sweep) err[refusal.Error] {
    if (s.mem != nil) { ret err[refusal.Error].ok{}; }
    val res_memory_of: res[*Memory, refusal.Error] = analysis.memory_of(s.cache, s.f);
    if (sel res_memory_of.err) { ret err[refusal.Error].err{res_memory_of.err}; }
    s.mem = res_memory_of.ok;
    ret err[refusal.Error].ok{};
}

# the entry a computation is available as, if it is
fun find(s: *Sweep, i: Instruction) res[opt[u32], refusal.Error] {
    var k:      Key       = Key{s: s, inst: i};
    val opt_by: opt[*u32] = map.get_by[Key, u32](?s.seen, ?k);
    if (s.failed)           { ret res[opt[u32], refusal.Error].err{s.why}; }
    if (!(sel opt_by.some)) { ret res[opt[u32], refusal.Error].ok{opt[u32].none{}}; }
    ret res[opt[u32], refusal.Error].ok{opt[u32].some{@opt_by.some}};
}

# make an instruction available
fun offer(s: *Sweep, i: Instruction, prev: opt[u32], load: bool, effect: Effect, g: u64) err[refusal.Error] {
    var e: Entry;
    e.inst   = i;
    e.prev   = NONE;
    e.load   = load;
    e.group  = g;
    e.next   = NONE;
    e.effect = effect;
    if (sel prev.some) { e.prev = prev.some; }
    s.count = s.count + 1;
    e.seq   = s.count;
    val at: u32 = s.entries.len::u32;
    if (load) {
        val res_opened: res[*Bucket, refusal.Error] = bucket_make(s, g);
        if (sel res_opened.err) { ret err[refusal.Error].err{res_opened.err}; }
        e.next = res_opened.ok.head;
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[Entry](?s.entries, e);
    if (sel res_pushed.err) { ret lost(res_pushed.err); }
    var k:       Key                        = Key{s: s, inst: i};
    val res_set: res[bool, allocator.Error] = map.insert_by[Key, u32](?s.seen, k, at);
    if (sel res_set.err) {
        vector.pop[Entry](?s.entries);
        ret lost(res_set.err);
    }
    if (load) {
        s.loads = s.loads + 1;
        ret set_head(s, g, at);
    }
    ret err[refusal.Error].ok{};
}

# stand an instruction down for an earlier one
fun merge(s: *Sweep, i: Instruction, by: Instruction) err[refusal.Error] {
    val old: *InstructionData = ?s.b.instructions.data[i];
    val new: *InstructionData = ?s.b.instructions.data[by];
    var r:   usize            = 0;
    for (r < old.results.len) {
        val err_done: err[refusal.Error] = edit(body.replace(s.m, s.f, old.results.data[r], new.results.data[r], Records.follow{}));
        if (sel err_done.err) { ret err_done; }
        r = r + 1;
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[Instruction](?s.gone, i);
    if (sel res_pushed.err) { ret lost(res_pushed.err); }
    s.changed = true;
    ret err[refusal.Error].ok{};
}

# an instruction that touches memory without being merged
fun touch(s: *Sweep, i: Instruction) err[refusal.Error] {
    if (s.loads == 0) { ret err[refusal.Error].ok{}; }
    var res_effect_of: res[Effect, refusal.Error] = memory.effect_of(s.mem, i);
    if (sel res_effect_of.err) { ret err[refusal.Error].err{res_effect_of.err}; }
    val err_ended: err[refusal.Error] = end_by(s, res_effect_of.ok);
    memory.dnit(?res_effect_of.ok);
    ret err_ended;
}

# merge a computation that touches no memory into the entry it repeats, or
# make it available when none is found
fun merge_pure(s: *Sweep, i: Instruction) err[refusal.Error] {
    val res_find: res[opt[u32], refusal.Error] = find(s, i);
    if (sel res_find.err)     { ret err[refusal.Error].err{res_find.err}; }
    if (sel res_find.ok.some) { ret merge(s, i, s.entries.data[res_find.ok.some].inst); }
    var none: Effect;
    ret offer(s, i, opt[u32].none{}, false, none, 0);
}

# merge a load into a live entry it repeats, or make it available. a load
# that orders, reaches anywhere or reads other than one place ends loads instead
fun merge_load(s: *Sweep, i: Instruction) err[refusal.Error] {
    val err_need: err[refusal.Error] = need_memory(s);
    if (sel err_need.err) { ret err_need; }
    var res_effect_of: res[Effect, refusal.Error] = memory.effect_of(s.mem, i);
    if (sel res_effect_of.err) { ret err[refusal.Error].err{res_effect_of.err}; }
    if (res_effect_of.ok.ordered || res_effect_of.ok.anywhere || res_effect_of.ok.places.len != 1) {
        val err_ended: err[refusal.Error] = end_by(s, res_effect_of.ok);
        memory.dnit(?res_effect_of.ok);
        ret err_ended;
    }
    var g:       u64      = 0;
    val opt_grp: opt[u64] = memory.group(res_effect_of.ok.places.data[0]);
    if (sel opt_grp.some) { g = opt_grp.some; }
    val res_find: res[opt[u32], refusal.Error] = find(s, i);
    if (sel res_find.err) {
        memory.dnit(?res_effect_of.ok);
        ret err[refusal.Error].err{res_find.err};
    }
    if (sel res_find.ok.some) {
        if (live(s, ?s.entries.data[res_find.ok.some])) {
            val by: Instruction = s.entries.data[res_find.ok.some].inst;
            memory.dnit(?res_effect_of.ok);
            ret merge(s, i, by);
        }
    }
    val err_offered: err[refusal.Error] = offer(s, i, res_find.ok, true, res_effect_of.ok, g);
    if (sel err_offered.err) { memory.dnit(?res_effect_of.ok); }
    ret err_offered;
}

# take one instruction of the walk: merge it as a computation or a load, or
# end the loads it may change when it touches memory
fun step(s: *Sweep, i: Instruction) err[refusal.Error] {
    val d:          *InstructionData         = ?s.b.instructions.data[i];
    val res_row_of: res[*Row, refusal.Error] = row_of(d);
    if (sel res_row_of.err) { ret err[refusal.Error].err{res_row_of.err}; }
    val r: *Row = res_row_of.ok;
    if (plain(d, r) && merges(r))                                         { ret merge_pure(s, i); }
    if (plain(d, r) && reads_only(r))                                     { ret merge_load(s, i); }
    if (r.effects.reads || r.effects.writes || d.metadata.flags.volatile) { ret touch(s, i); }
    ret err[refusal.Error].ok{};
}

# undo the changes of availability down to a mark
fun unwind(s: *Sweep, entries: usize, log: usize) err[refusal.Error] {
    for (s.log.len > log) {
        val u: Undo = s.log.data[s.log.len - 1];
        vector.truncate[Undo](?s.log, s.log.len - 1);
        if (u.kind == UNDO_DEAD)    { s.entries.data[u.at].dead = false; }
        if (u.kind == UNDO_BARRIER) { s.barrier = u.at; }
        if (u.kind == UNDO_SHARED)  { s.shared = u.at; }
        if (u.kind == UNDO_CLEARED) {
            val err_set_cleared: err[refusal.Error] = set_cleared(s, u.group, u.at);
            if (sel err_set_cleared.err) { ret err_set_cleared; }
        }
    }
    for (s.entries.len > entries) {
        val e: *Entry = ?s.entries.data[s.entries.len - 1];
        var k: Key    = Key{s: s, inst: e.inst};
        if (e.prev == NONE) { map.remove_by[Key, u32](?s.seen, ?k); }
        or {
            val res_set: res[bool, allocator.Error] = map.insert_by[Key, u32](?s.seen, k, e.prev);
            if (sel res_set.err) { ret lost(res_set.err); }
        }
        if (e.load) {
            val err_set_head: err[refusal.Error] = set_head(s, e.group, e.next);
            if (sel err_set_head.err) { ret err_set_head; }
            memory.dnit(?e.effect);
            s.loads = s.loads - 1;
        }
        vector.truncate[Entry](?s.entries, s.entries.len - 1);
    }
    ret err[refusal.Error].ok{};
}

# walk one block: the loads a way in may have changed are ended, then each
# instruction is merged or noted, then the merged ones go
fun block(s: *Sweep, k: u32) err[refusal.Error] {
    if (k != 0 && s.b.blocks.data[k].predecessors.len != 1) {
        val err_end_all: err[refusal.Error] = end_all(s);
        if (sel err_end_all.err) { ret err_end_all; }
    }
    var x: Instruction = s.b.blocks.data[k].first;
    for (x != NO_INSTRUCTION) {
        val err_data_stepped: err[refusal.Error] = step(s, x);
        if (sel err_data_stepped.err) { ret err_data_stepped; }
        x = s.b.instructions.data[x].next;
    }
    var i: usize = 0;
    for (i < s.gone.len) {
        val err_edit: err[refusal.Error] = edit(body.erase(s.m, s.f, s.gone.data[i]));
        if (sel err_edit.err) { ret err_edit; }
        i = i + 1;
    }
    vector.truncate[Instruction](?s.gone, 0);
    ret err[refusal.Error].ok{};
}

# open a frame for a block, marking what stood before it, and walk the block
fun enter(s: *Sweep, k: u32) err[refusal.Error] {
    val frame:      Frame                       = Frame{block: k, child: 0, entries: s.entries.len, log: s.log.len};
    val res_pushed: res[usize, allocator.Error] = vector.push[Frame](?s.stack, frame);
    if (sel res_pushed.err) { ret lost(res_pushed.err); }
    ret block(s, k);
}

# walk the dominator tree from the entry
fun walk(s: *Sweep) err[refusal.Error] {
    val err_first: err[refusal.Error] = enter(s, 0);
    if (sel err_first.err) { ret err_first; }
    for (s.stack.len != 0) {
        val top:  *Frame     = ?s.stack.data[s.stack.len - 1];
        val kids: Slice[u32] = dominance.children(s.dom, top.block);
        if (top.child < kids.size) {
            val next: u32 = kids.data[top.child];
            top.child = top.child + 1;
            val err_enter: err[refusal.Error] = enter(s, next);
            if (sel err_enter.err) { ret err_enter; }
        }
        or {
            val done: Frame = @top;
            vector.truncate[Frame](?s.stack, s.stack.len - 1);
            val err_unwind: err[refusal.Error] = unwind(s, done.entries, done.log);
            if (sel err_unwind.err) { ret err_unwind; }
        }
    }
    ret err[refusal.Error].ok{};
}

fun sweep_dnit(s: *Sweep) {
    var i: usize = 0;
    for (i < s.entries.len) {
        if (s.entries.data[i].load) { memory.dnit(?s.entries.data[i].effect); }
        i = i + 1;
    }
    map.dnit_by[Key, u32](?s.seen);
    map.dnit[u64, Bucket](?s.groups);
    vector.dnit[Entry](?s.entries);
    vector.dnit[Undo](?s.log);
    vector.dnit[Frame](?s.stack);
    vector.dnit[Instruction](?s.gone);
}

# merge the repeated computations of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val res_tree: res[*Dominance, refusal.Error] = analysis.dominance_of(c.cache, u.f);
    if (sel res_tree.err) { ret res[bool, refusal.Error].err{res_tree.err}; }
    var s: Sweep;
    s.m       = c.m;
    s.f       = u.f;
    s.b       = res_body.ok;
    s.dom     = res_tree.ok;
    s.cache   = c.cache;
    s.mem     = nil;
    s.seen    = map.init_by[Key, u32](c.m.a, hash_key, same_key);
    s.groups  = map.init[u64, Bucket](c.m.a);
    s.entries = vector.init[Entry](c.m.a);
    s.log     = vector.init[Undo](c.m.a);
    s.stack   = vector.init[Frame](c.m.a);
    s.gone    = vector.init[Instruction](c.m.a);
    fin { sweep_dnit(?s); }
    val err_ran: err[refusal.Error] = walk(?s);
    if (sel err_ran.err) { ret res[bool, refusal.Error].err{err_ran.err}; }
    ret res[bool, refusal.Error].ok{s.changed};
}
