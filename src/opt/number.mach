# numbers as the folder reads them: a constant value of a function read as the
# folder's value, a folder value placed back as a constant, and the equality of
# two such values. the folding passes share it so no pass reads a constant its
# own way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.fold.eval;
use mirl.fold.record;
use mirl.fold.word;
use mirl.ir.body;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.pass.record.Context;
use mirl.pass.refusal;
use target_basis: mirl.target.basis;
use mirl.target.capability.Nans;

fun zeros(scratch: *allocator.Allocator, n: usize) res[Slice[u64], refusal.Error] {
    val res_zallocate: res[*u64, allocator.Error] = allocator.zallocate[u64](scratch, n);
    if (sel res_zallocate.err) { ret res[Slice[u64], refusal.Error].err{refusal.Error.alloc{res_zallocate.err}}; }
    ret res[Slice[u64], refusal.Error].ok{Slice[u64]{data: res_zallocate.ok, size: n}};
}

# the bits of one lane of a constant, a zero given its words
fun lane(m: *Module, scratch: *allocator.Allocator, ty: Type, c: ConstantData) res[Bits, refusal.Error] {
    if (sel c.integer) { ret res[Bits, refusal.Error].ok{c.integer}; }
    if (sel c.float)   { ret res[Bits, refusal.Error].ok{c.float}; }
    if (!(sel c.zero)) { ret res[Bits, refusal.Error].err{refusal.Error.reason{"a number lane that is no number"}}; }
    val res_bits: res[u32, record.Error] = eval.bits_of(?m.types, ty);
    if (sel res_bits.err) { ret res[Bits, refusal.Error].err{refusal.Error.reason{"a number lane whose width is unknown"}}; }
    val res_zeros: res[Slice[u64], refusal.Error] = zeros(scratch, word.words_for(res_bits.ok)::usize);
    if (sel res_zeros.err) { ret res[Bits, refusal.Error].err{res_zeros.err}; }
    ret res[Bits, refusal.Error].ok{Bits{type: ty, words: res_zeros.ok}};
}

# whether a type is an integer or a float
fun number(m: *Module, ty: Type) res[bool, refusal.Error] {
    val res_kind: res[table.Kind, table.Error] = table.kind(?m.types, ty);
    if (sel res_kind.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{res_kind.err}}}; }
    ret res[bool, refusal.Error].ok{sel res_kind.ok.integer || sel res_kind.ok.float};
}

# a constant value as the folder reads it, none when it is not a number or a
# vector of numbers, or when its consumer sets it
pub fun read(m: *Module, b: *Body, scratch: *allocator.Allocator, v: Value) res[opt[record.Value], refusal.Error] {
    val def: Def = b.values.data[v].def;
    if (!(sel def.constant))                 { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    if (module.specialized(m, def.constant)) { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_constant_data.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{res_constant_data.err}}; }
    val ty:        Type                          = b.values.data[v].type;
    val res_shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel res_shape.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel res_shape.ok.vector) {
        one  = res_shape.ok.vector.element;
        many = res_shape.ok.vector.lanes::usize;
    }
    or (!(sel res_shape.ok.integer || sel res_shape.ok.float)) { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    val res_num: res[bool, refusal.Error] = number(m, one);
    if (sel res_num.err) { ret res[opt[record.Value], refusal.Error].err{res_num.err}; }
    if (!res_num.ok)     { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }

    val res_room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel res_room.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.alloc{res_room.err}}; }
    var n: usize = 0;
    for (n < many) {
        var at: ConstantData = res_constant_data.ok;
        if (sel res_constant_data.ok.aggregate) {
            val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, res_constant_data.ok.aggregate.elements.data[n]);
            if (sel res_constant_data.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{res_constant_data.err}}; }
            at = res_constant_data.ok;
        }
        val res_bits: res[Bits, refusal.Error] = lane(m, scratch, one, at);
        if (sel res_bits.err) { ret res[opt[record.Value], refusal.Error].err{res_bits.err}; }
        res_room.ok[n] = res_bits.ok;
        n              = n + 1;
    }
    ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].some{record.Value{type: ty, lanes: Slice[Bits]{data: res_room.ok, size: many}}}};
}

fun same_bits(x: Bits, y: Bits) bool {
    if (!table.same(x.type, y.type) || x.words.size != y.words.size) { ret false; }
    var n: usize = 0;
    for (n < x.words.size) {
        if (x.words.data[n] != y.words.data[n]) { ret false; }
        n = n + 1;
    }
    ret true;
}

# whether two folder values are the same type with the same bits in every lane
# ---
# x:   one value
# y:   the other
# ret: true when type, lane count and every word of every lane agree
pub fun same_value(x: record.Value, y: record.Value) bool {
    if (!table.same(x.type, y.type) || x.lanes.size != y.lanes.size) { ret false; }
    var n: usize = 0;
    for (n < x.lanes.size) {
        if (!same_bits(x.lanes.data[n], y.lanes.data[n])) { ret false; }
        n = n + 1;
    }
    ret true;
}

# the value of a folded constant in the function
pub fun place(m: *Module, f: Function, scratch: *allocator.Allocator, v: record.Value) res[Value, refusal.Error] {
    val res_lanes: res[*Constant, allocator.Error] = allocator.zallocate[Constant](scratch, v.lanes.size);
    if (sel res_lanes.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_lanes.err}}; }
    var n: usize = 0;
    for (n < v.lanes.size) {
        val bits:    Bits                         = v.lanes.data[n];
        val res_num: res[table.Kind, table.Error] = table.kind(?m.types, bits.type);
        if (sel res_num.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{res_num.err}}}; }
        var data: ConstantData = ConstantData.float{bits};
        if (sel res_num.ok.integer) { data = ConstantData.integer{bits}; }
        val res_made: res[Constant, module.Error] = module.add_constant(m, data);
        if (sel res_made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{res_made.err}}; }
        res_lanes.ok[n] = res_made.ok;
        n               = n + 1;
    }
    var c:        Constant                     = res_lanes.ok[0];
    val res_kind: res[table.Kind, table.Error] = table.kind(?m.types, v.type);
    if (sel res_kind.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{res_kind.err}}}; }
    if (sel res_kind.ok.vector) {
        val res_made: res[Constant, module.Error] = module.add_constant(m, ConstantData.aggregate{Aggregate{type: v.type, elements: Slice[Constant]{data: res_lanes.ok, size: v.lanes.size}}});
        if (sel res_made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{res_made.err}}; }
        c = res_made.ok;
    }
    val res_constant: res[Value, module.Error] = body.constant(m, f, c);
    if (sel res_constant.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{res_constant.err}}; }
    ret res[Value, refusal.Error].ok{res_constant.ok};
}

# the nan the build's float operations return in each format, at the format's
# index, as the folder reads it, owned by the caller until `rules_free`
pub fun rules(c: *Context, a: *allocator.Allocator) res[Slice[Nans], refusal.Error] {
    val n:            usize                       = format.rows()::usize;
    val res_allocate: res[*Nans, allocator.Error] = allocator.allocate[Nans](a, n);
    if (sel res_allocate.err) { ret res[Slice[Nans], refusal.Error].err{refusal.Error.alloc{res_allocate.err}}; }
    val out: Slice[Nans] = Slice[Nans]{data: res_allocate.ok, size: n};
    var f:   usize       = 0;
    for (f < n) {
        val res_nans: res[Nans, target_basis.Error] = target_basis.nans(c.basis, ?c.t.caps, (f::u32));
        if (sel res_nans.err) {
            allocator.deallocate[Nans](a, out.data, n);
            ret res[Slice[Nans], refusal.Error].err{refusal.Error.condition{res_nans.err}};
        }
        out.data[f] = res_nans.ok;
        f           = f + 1;
    }
    ret res[Slice[Nans], refusal.Error].ok{out};
}

# give back the rules `rules` made
pub fun rules_free(a: *allocator.Allocator, r: Slice[Nans]) {
    allocator.deallocate[Nans](a, r.data, r.size);
}

# the refusal a folder error stands for
# ---
# r:   the folder's error
# ret: an allocation failure as itself, any other error as a reason naming it
pub fun unfolded(r: record.Error) refusal.Error {
    if (sel r.alloc)   { ret refusal.Error.alloc{r.alloc}; }
    if (sel r.check)   { ret refusal.Error.reason{"the folder found an instruction mistyped"}; }
    if (sel r.operand) { ret refusal.Error.reason{"the folder found a constant that is not as wide as its type"}; }
    ret refusal.Error.reason{"the folder could not read a type"};
}

# the zero of a type, an integer, a float or a vector of either
pub fun zero_of(m: *Module, scratch: *allocator.Allocator, ty: Type) res[record.Value, refusal.Error] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel res_shape.err) { ret res[record.Value, refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel res_shape.ok.vector) {
        one  = res_shape.ok.vector.element;
        many = res_shape.ok.vector.lanes::usize;
    }
    val res_room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel res_room.err) { ret res[record.Value, refusal.Error].err{refusal.Error.alloc{res_room.err}}; }
    var n: usize = 0;
    for (n < many) {
        val res_bits: res[Bits, refusal.Error] = lane(m, scratch, one, ConstantData.zero{one});
        if (sel res_bits.err) { ret res[record.Value, refusal.Error].err{res_bits.err}; }
        res_room.ok[n] = res_bits.ok;
        n              = n + 1;
    }
    ret res[record.Value, refusal.Error].ok{record.Value{type: ty, lanes: Slice[Bits]{data: res_room.ok, size: many}}};
}
