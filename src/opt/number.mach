# numbers as the folder reads them: a constant value of a function read as the
# folder's value, a folder value placed back as a constant, and the equality of
# two such values. the folding passes share it so no pass reads a constant its
# own way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.fold.eval;
use mirl.fold.record;
use mirl.fold.word;
use mirl.ir.body;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.pass.record.Context;
use mirl.pass.refusal;
use target_basis: mirl.target.basis;
use mirl.target.capability.Nans;

fun zeros(scratch: *allocator.Allocator, n: usize) res[Slice[u64], refusal.Error] {
    val got: res[*u64, allocator.Error] = allocator.zallocate[u64](scratch, n);
    if (sel got.err) { ret res[Slice[u64], refusal.Error].err{refusal.Error.alloc{got.err}}; }
    ret res[Slice[u64], refusal.Error].ok{Slice[u64]{data: got.ok, size: n}};
}

# the bits of one lane of a constant, a zero given its words
fun lane(m: *Module, scratch: *allocator.Allocator, ty: Type, c: ConstantData) res[Bits, refusal.Error] {
    if (sel c.integer) { ret res[Bits, refusal.Error].ok{c.integer}; }
    if (sel c.float)   { ret res[Bits, refusal.Error].ok{c.float}; }
    if (!(sel c.zero)) { ret res[Bits, refusal.Error].err{refusal.Error.reason{"a number lane that is no number"}}; }
    val bits: res[u32, record.Error] = eval.bits_of(?m.types, ty);
    if (sel bits.err) { ret res[Bits, refusal.Error].err{refusal.Error.reason{"a number lane whose width is unknown"}}; }
    val ws: res[Slice[u64], refusal.Error] = zeros(scratch, word.words_for(bits.ok)::usize);
    if (sel ws.err) { ret res[Bits, refusal.Error].err{ws.err}; }
    ret res[Bits, refusal.Error].ok{Bits{type: ty, words: ws.ok}};
}

# whether a type is an integer or a float
fun number(m: *Module, ty: Type) res[bool, refusal.Error] {
    val k: res[table.Kind, table.Error] = table.kind(?m.types, ty);
    if (sel k.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{k.err}}}; }
    ret res[bool, refusal.Error].ok{sel k.ok.integer || sel k.ok.float};
}

# a constant value as the folder reads it, none when it is not a number or a
# vector of numbers, or when its consumer sets it
pub fun read(m: *Module, b: *Body, scratch: *allocator.Allocator, v: Value) res[opt[record.Value], refusal.Error] {
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant))                 { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    if (module.specialized(m, def.constant)) { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{got.err}}; }
    val ty:    Type                          = b.values.data[v.index].type;
    val shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel shape.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{module.Error.types{shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel shape.ok.vector) {
        one  = shape.ok.vector.element;
        many = shape.ok.vector.lanes::usize;
    }
    or (!(sel shape.ok.integer || sel shape.ok.float)) { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }
    val num: res[bool, refusal.Error] = number(m, one);
    if (sel num.err) { ret res[opt[record.Value], refusal.Error].err{num.err}; }
    if (!num.ok)     { ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].none{}}; }

    val room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel room.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.alloc{room.err}}; }
    var n: usize = 0;
    for (n < many) {
        var at: ConstantData = got.ok;
        if (sel got.ok.aggregate) {
            val e: res[ConstantData, module.Error] = module.constant_data(m, got.ok.aggregate.elements.data[n]);
            if (sel e.err) { ret res[opt[record.Value], refusal.Error].err{refusal.Error.ir{e.err}}; }
            at = e.ok;
        }
        val bits: res[Bits, refusal.Error] = lane(m, scratch, one, at);
        if (sel bits.err) { ret res[opt[record.Value], refusal.Error].err{bits.err}; }
        room.ok[n] = bits.ok;
        n          = n + 1;
    }
    ret res[opt[record.Value], refusal.Error].ok{opt[record.Value].some{record.Value{type: ty, lanes: Slice[Bits]{data: room.ok, size: many}}}};
}

fun same_bits(x: Bits, y: Bits) bool {
    if (!table.same(x.type, y.type) || x.words.size != y.words.size) { ret false; }
    var n: usize = 0;
    for (n < x.words.size) {
        if (x.words.data[n] != y.words.data[n]) { ret false; }
        n = n + 1;
    }
    ret true;
}

pub fun same_value(x: record.Value, y: record.Value) bool {
    if (!table.same(x.type, y.type) || x.lanes.size != y.lanes.size) { ret false; }
    var n: usize = 0;
    for (n < x.lanes.size) {
        if (!same_bits(x.lanes.data[n], y.lanes.data[n])) { ret false; }
        n = n + 1;
    }
    ret true;
}

# the value of a folded constant in the function
pub fun place(m: *Module, f: Function, scratch: *allocator.Allocator, v: record.Value) res[Value, refusal.Error] {
    val lanes: res[*Constant, allocator.Error] = allocator.zallocate[Constant](scratch, v.lanes.size);
    if (sel lanes.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{lanes.err}}; }
    var n: usize = 0;
    for (n < v.lanes.size) {
        val bits: Bits                         = v.lanes.data[n];
        val num:  res[table.Kind, table.Error] = table.kind(?m.types, bits.type);
        if (sel num.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{num.err}}}; }
        var data: ConstantData = ConstantData.float{bits};
        if (sel num.ok.integer) { data = ConstantData.integer{bits}; }
        val made: res[Constant, module.Error] = module.add_constant(m, data);
        if (sel made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{made.err}}; }
        lanes.ok[n] = made.ok;
        n           = n + 1;
    }
    var c: Constant                     = lanes.ok[0];
    val k: res[table.Kind, table.Error] = table.kind(?m.types, v.type);
    if (sel k.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{k.err}}}; }
    if (sel k.ok.vector) {
        val made: res[Constant, module.Error] = module.add_constant(m, ConstantData.aggregate{Aggregate{type: v.type, elements: Slice[Constant]{data: lanes.ok, size: v.lanes.size}}});
        if (sel made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{made.err}}; }
        c = made.ok;
    }
    val at: res[Value, module.Error] = body.constant(m, f, c);
    if (sel at.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{at.err}}; }
    ret res[Value, refusal.Error].ok{at.ok};
}

# the nan the build's float operations return in each format, at the format's
# index, as the folder reads it, owned by the caller until `release_rules`
pub fun rules(c: *Context, a: *allocator.Allocator) res[Slice[Nans], refusal.Error] {
    val n:   usize                       = format.rows()::usize;
    val got: res[*Nans, allocator.Error] = allocator.allocate[Nans](a, n);
    if (sel got.err) { ret res[Slice[Nans], refusal.Error].err{refusal.Error.alloc{got.err}}; }
    val out: Slice[Nans] = Slice[Nans]{data: got.ok, size: n};
    var f:   usize       = 0;
    for (f < n) {
        val r: res[Nans, target_basis.Error] = target_basis.nans(c.basis, ?c.t.caps, format.Format{index: f::u32});
        if (sel r.err) {
            allocator.deallocate[Nans](a, out.data, n);
            ret res[Slice[Nans], refusal.Error].err{refusal.Error.condition{r.err}};
        }
        out.data[f] = r.ok;
        f           = f + 1;
    }
    ret res[Slice[Nans], refusal.Error].ok{out};
}

# give back the rules `rules` made
pub fun release_rules(a: *allocator.Allocator, r: Slice[Nans]) {
    allocator.deallocate[Nans](a, r.data, r.size);
}

pub fun unfolded(r: record.Error) refusal.Error {
    if (sel r.alloc)   { ret refusal.Error.alloc{r.alloc}; }
    if (sel r.check)   { ret refusal.Error.reason{"the folder found an instruction mistyped"}; }
    if (sel r.operand) { ret refusal.Error.reason{"the folder found a constant that is not as wide as its type"}; }
    ret refusal.Error.reason{"the folder could not read a type"};
}

# the zero of a type, an integer, a float or a vector of either
pub fun zero_of(m: *Module, scratch: *allocator.Allocator, ty: Type) res[record.Value, refusal.Error] {
    val shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel shape.err) { ret res[record.Value, refusal.Error].err{refusal.Error.ir{module.Error.types{shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel shape.ok.vector) {
        one  = shape.ok.vector.element;
        many = shape.ok.vector.lanes::usize;
    }
    val room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel room.err) { ret res[record.Value, refusal.Error].err{refusal.Error.alloc{room.err}}; }
    var n: usize = 0;
    for (n < many) {
        val bits: res[Bits, refusal.Error] = lane(m, scratch, one, ConstantData.zero{one});
        if (sel bits.err) { ret res[record.Value, refusal.Error].err{bits.err}; }
        room.ok[n] = bits.ok;
        n          = n + 1;
    }
    ret res[record.Value, refusal.Error].ok{record.Value{type: ty, lanes: Slice[Bits]{data: room.ok, size: many}}};
}
