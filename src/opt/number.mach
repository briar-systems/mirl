# numbers as the folder reads them: a constant value of a function read as the
# folder's value, a folder value placed back as a constant, and the equality of
# two such values. the folding passes share it so no pass reads a constant its
# own way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use folder: mirl.fold;
use mirl.fold.word;
use mirl.ir.body;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.module.Module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.pass.failure.Why;

fun zeros(scratch: *allocator.Allocator, n: usize) res[Slice[u64], Why] {
    val got: res[*u64, allocator.Error] = allocator.zallocate[u64](scratch, n);
    if (sel got.err) { ret res[Slice[u64], Why].err{Why.alloc{got.err}}; }
    ret res[Slice[u64], Why].ok{Slice[u64]{data: got.ok, size: n}};
}

# the bits of one lane of a constant, a zero given its words
fun lane(m: *Module, scratch: *allocator.Allocator, ty: Type, c: ConstantData) res[Bits, Why] {
    if (sel c.integer) { ret res[Bits, Why].ok{c.integer}; }
    if (sel c.float)   { ret res[Bits, Why].ok{c.float}; }
    if (!(sel c.zero)) { ret res[Bits, Why].err{Why.reason{"a number lane that is no number"}}; }
    val bits: res[u32, folder.Refusal] = folder.bits_of(?m.types, ty);
    if (sel bits.err) { ret res[Bits, Why].err{Why.reason{"a number lane whose width is unknown"}}; }
    val ws: res[Slice[u64], Why] = zeros(scratch, word.words_for(bits.ok)::usize);
    if (sel ws.err) { ret res[Bits, Why].err{ws.err}; }
    ret res[Bits, Why].ok{Bits{type: ty, words: ws.ok}};
}

# whether a type is an integer or a float
fun number(m: *Module, ty: Type) res[bool, Why] {
    val k: res[types.Kind, types.Error] = types.kind(?m.types, ty);
    if (sel k.err) { ret res[bool, Why].err{Why.ir{module.Error.types{k.err}}}; }
    ret res[bool, Why].ok{sel k.ok.integer || sel k.ok.float};
}

# a constant value as the folder reads it, none when it is not a number or a
# vector of numbers
pub fun read(m: *Module, b: *Body, scratch: *allocator.Allocator, v: Value) res[opt[folder.Value], Why] {
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret res[opt[folder.Value], Why].ok{opt[folder.Value].none{}}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret res[opt[folder.Value], Why].err{Why.ir{got.err}}; }
    val ty:    Type                          = b.values.data[v.index].type;
    val shape: res[types.Shape, types.Error] = types.shape(?m.types, ty);
    if (sel shape.err) { ret res[opt[folder.Value], Why].err{Why.ir{module.Error.types{shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel shape.ok.vector) {
        one  = shape.ok.vector.element;
        many = shape.ok.vector.lanes::usize;
    }
    or (!(sel shape.ok.integer || sel shape.ok.float)) { ret res[opt[folder.Value], Why].ok{opt[folder.Value].none{}}; }
    val num: res[bool, Why] = number(m, one);
    if (sel num.err) { ret res[opt[folder.Value], Why].err{num.err}; }
    if (!num.ok)     { ret res[opt[folder.Value], Why].ok{opt[folder.Value].none{}}; }

    val room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel room.err) { ret res[opt[folder.Value], Why].err{Why.alloc{room.err}}; }
    var n: usize = 0;
    for (n < many) {
        var at: ConstantData = got.ok;
        if (sel got.ok.aggregate) {
            val e: res[ConstantData, module.Error] = module.constant_data(m, got.ok.aggregate.elements.data[n]);
            if (sel e.err) { ret res[opt[folder.Value], Why].err{Why.ir{e.err}}; }
            at = e.ok;
        }
        val bits: res[Bits, Why] = lane(m, scratch, one, at);
        if (sel bits.err) { ret res[opt[folder.Value], Why].err{bits.err}; }
        room.ok[n] = bits.ok;
        n          = n + 1;
    }
    ret res[opt[folder.Value], Why].ok{opt[folder.Value].some{folder.Value{type: ty, lanes: Slice[Bits]{data: room.ok, size: many}}}};
}

fun same_bits(x: Bits, y: Bits) bool {
    if (!types.same(x.type, y.type) || x.words.size != y.words.size) { ret false; }
    var n: usize = 0;
    for (n < x.words.size) {
        if (x.words.data[n] != y.words.data[n]) { ret false; }
        n = n + 1;
    }
    ret true;
}

pub fun same_value(x: folder.Value, y: folder.Value) bool {
    if (!types.same(x.type, y.type) || x.lanes.size != y.lanes.size) { ret false; }
    var n: usize = 0;
    for (n < x.lanes.size) {
        if (!same_bits(x.lanes.data[n], y.lanes.data[n])) { ret false; }
        n = n + 1;
    }
    ret true;
}

# the value of a folded constant in the function
pub fun place(m: *Module, f: Function, scratch: *allocator.Allocator, v: folder.Value) res[Value, Why] {
    val lanes: res[*Constant, allocator.Error] = allocator.zallocate[Constant](scratch, v.lanes.size);
    if (sel lanes.err) { ret res[Value, Why].err{Why.alloc{lanes.err}}; }
    var n: usize = 0;
    for (n < v.lanes.size) {
        val bits: Bits                         = v.lanes.data[n];
        val num:  res[types.Kind, types.Error] = types.kind(?m.types, bits.type);
        if (sel num.err) { ret res[Value, Why].err{Why.ir{module.Error.types{num.err}}}; }
        var data: ConstantData = ConstantData.float{bits};
        if (sel num.ok.integer) { data = ConstantData.integer{bits}; }
        val made: res[Constant, module.Error] = module.add_constant(m, data);
        if (sel made.err) { ret res[Value, Why].err{Why.ir{made.err}}; }
        lanes.ok[n] = made.ok;
        n           = n + 1;
    }
    var c: Constant                     = lanes.ok[0];
    val k: res[types.Kind, types.Error] = types.kind(?m.types, v.type);
    if (sel k.err) { ret res[Value, Why].err{Why.ir{module.Error.types{k.err}}}; }
    if (sel k.ok.vector) {
        val made: res[Constant, module.Error] = module.add_constant(m, ConstantData.aggregate{Aggregate{type: v.type, elements: Slice[Constant]{data: lanes.ok, size: v.lanes.size}}});
        if (sel made.err) { ret res[Value, Why].err{Why.ir{made.err}}; }
        c = made.ok;
    }
    val at: res[Value, module.Error] = body.constant(m, f, c);
    if (sel at.err) { ret res[Value, Why].err{Why.ir{at.err}}; }
    ret res[Value, Why].ok{at.ok};
}

pub fun refusal(r: folder.Refusal) Why {
    if (sel r.alloc)   { ret Why.alloc{r.alloc}; }
    if (sel r.check)   { ret Why.reason{"the folder found an instruction mistyped"}; }
    if (sel r.operand) { ret Why.reason{"the folder found a constant that is not as wide as its type"}; }
    ret Why.reason{"the folder could not read a type"};
}

# the zero of a type, an integer, a float or a vector of either
pub fun zero_of(m: *Module, scratch: *allocator.Allocator, ty: Type) res[folder.Value, Why] {
    val shape: res[types.Shape, types.Error] = types.shape(?m.types, ty);
    if (sel shape.err) { ret res[folder.Value, Why].err{Why.ir{module.Error.types{shape.err}}}; }
    var one:  Type  = ty;
    var many: usize = 1;
    if (sel shape.ok.vector) {
        one  = shape.ok.vector.element;
        many = shape.ok.vector.lanes::usize;
    }
    val room: res[*Bits, allocator.Error] = allocator.zallocate[Bits](scratch, many);
    if (sel room.err) { ret res[folder.Value, Why].err{Why.alloc{room.err}}; }
    var n: usize = 0;
    for (n < many) {
        val bits: res[Bits, Why] = lane(m, scratch, one, ConstantData.zero{one});
        if (sel bits.err) { ret res[folder.Value, Why].err{bits.err}; }
        room.ok[n] = bits.ok;
        n          = n + 1;
    }
    ret res[folder.Value, Why].ok{folder.Value{type: ty, lanes: Slice[Bits]{data: room.ok, size: many}}};
}
