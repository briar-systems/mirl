# the shape of mirl's diagnostics: a headline, the place it points at, and tagged lines under it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.format;
use io: std.io.writer;

use mink.base.diag;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

use mirl.ir.debug.place;
use mirl.ir.debug.record;
use mirl.ir.debug.table;
use mirl.ir.module.Module;

# where a failure is worded
# ---
# a:    the allocator a wording takes its scratch storage from
# w:    the writer the words go to
# file: the file the module was read from, nil when it was read from none
# head: the word every headline leads with, as `error`, nil for none when the
#       reader frames each failure itself
pub rec Out {
    a:    *A.Allocator;
    w:    *io.Writer;
    file: str;
    head: str;
}

# what a failure's leaf is, which a tool's exit code follows
# ---
# refused:     the input breaks a rule the source can clear, or asks what mirl does not do yet
# internal:    a broken invariant of mirl's
# environment: the allocator refused storage, or the output was not written
pub tag Class: u8 {
    refused;
    internal;
    environment;
}

# the lead of a headline, `error[key] ` or `error ` when key is nil, its word the out's head
# ---
# o:   where the diagnostic goes
# key: the rule or kind the error belongs to, nil for none
pub fun lead(o: *Out, key: str) {
    keyed(o, nil, key);
}

# the lead of a headline whose key is `prefix` then `key`, as `error[verify.rule] `
fun keyed(o: *Out, prefix: str, key: str) {
    var led: bool = false;
    if (o.head != nil) {
        format.write_str(o.w, o.head);
        led = true;
    }
    if (key != nil) {
        format.write_str(o.w, "[");
        if (prefix != nil) { format.write_str(o.w, prefix); }
        format.write_str(o.w, key);
        format.write_str(o.w, "]");
        led = true;
    }
    if (led) { format.write_str(o.w, " "); }
}

# a headline with its message as one string
pub fun headline(o: *Out, key: str, message: str) {
    lead(o, key);
    format.write_str(o.w, message);
    format.write_str(o.w, "\n");
}

# the place a diagnostic points at, `@ path:line:column`
pub fun at(o: *Out, path: str, line: u64, column: u64) {
    format.write_str(o.w, "  @ ");
    format.write_str(o.w, path);
    format.write_str(o.w, ":");
    format.write_u64(o.w, line);
    format.write_str(o.w, ":");
    format.write_u64(o.w, column);
    format.write_str(o.w, "\n");
}

# the source place the instruction a refusal names was built for,
# `@ path:line:column`, the column left out when it states none. nothing
# when it states no place
pub fun source(o: *Out, m: *Module, l: opt[record.Location]) {
    if (sel l.none) { ret; }
    val res_position: res[record.Position, table.Error] = place.position(?m.debug, l.some);
    if (sel res_position.err) { ret; }
    val res_path: res[View, table.Error] = place.path(?m.debug, res_position.ok.file);
    if (sel res_path.err) { ret; }
    format.write_str(o.w, "  @ ");
    view(o, res_path.ok);
    format.write_str(o.w, ":");
    format.write_u64(o.w, res_position.ok.line::u64);
    if (res_position.ok.column > 0) {
        format.write_str(o.w, ":");
        format.write_u64(o.w, res_position.ok.column::u64);
    }
    format.write_str(o.w, "\n");
}

# the file a diagnostic points at, when no line within it is named
pub fun in_file(o: *Out, path: str) {
    format.write_str(o.w, "  @ ");
    format.write_str(o.w, path);
    format.write_str(o.w, "\n");
}

# a tagged line under a diagnostic, `tag text`
pub fun tagged(o: *Out, tag: str, text: str) {
    format.write_str(o.w, "  ");
    format.write_str(o.w, tag);
    format.write_str(o.w, " ");
    format.write_str(o.w, text);
    format.write_str(o.w, "\n");
}

# a view of the text written as it is
pub fun view(o: *Out, v: View) {
    format.write_bytes(o.w, v.data::*u8, v.len);
}

# an error that names what it failed on, `error message 'name'`
pub fun named(o: *Out, message: str, name: str) {
    lead(o, nil);
    format.write_str(o.w, message);
    format.write_str(o.w, " '");
    format.write_str(o.w, name);
    format.write_str(o.w, "'\n");
}

# an error that names what it failed on and why, `error message 'name' (cause)`
pub fun named_because(o: *Out, message: str, name: str, cause: str) {
    lead(o, nil);
    format.write_str(o.w, message);
    format.write_str(o.w, " '");
    format.write_str(o.w, name);
    format.write_str(o.w, "' (");
    format.write_str(o.w, cause);
    format.write_str(o.w, ")\n");
}

# a headline and why, `error message (cause)`
pub fun headline_because(o: *Out, message: str, cause: str) {
    lead(o, nil);
    format.write_str(o.w, message);
    format.write_str(o.w, " (");
    format.write_str(o.w, cause);
    format.write_str(o.w, ")\n");
}

# where in the object a refusal is, `at section n, offset 0x...`
pub fun placed(o: *Out, section: u32, offset: u64) {
    format.write_str(o.w, "  at section ");
    format.write_u64(o.w, section::u64);
    format.write_str(o.w, ", offset 0x");
    format.write_hex_u64(o.w, offset, false);
    format.write_str(o.w, "\n");
}

# a verifier refusal, `error[verify.rule] message`
pub fun rule(o: *Out, name: str, message: str) {
    keyed(o, "verify.", name);
    format.write_str(o.w, message);
    format.write_str(o.w, "\n");
}

# the symbol a refusal is in, `in @name`, when it names one
pub fun symbol(o: *Out, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(o.w, "  in @");
    view(o, name);
    format.write_str(o.w, "\n");
}

# the target op a refusal names, `op "set" "op"`, when it names one
pub fun op(o: *Out, set: View, name: View) {
    if (set.len == 0 && name.len == 0) { ret; }
    format.write_str(o.w, "  op \"");
    view(o, set);
    format.write_str(o.w, "\" \"");
    view(o, name);
    format.write_str(o.w, "\"\n");
}

# the ir form a refusal names in place of a target op, `use form`, when it names one
pub fun form(o: *Out, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(o.w, "  use ");
    view(o, name);
    format.write_str(o.w, "\n");
}

# the extension a refusal names, `extension name`, when it names one
pub fun extension(o: *Out, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(o.w, "  extension ");
    view(o, name);
    format.write_str(o.w, "\n");
}

# a failure of mink's under a diagnostic, as a note in mink's own words
pub fun failure(o: *Out, a: *A.Allocator, f: Fail) {
    var line: Sink = sink.init(a, LITTLE);
    fin { sink.dnit(?line); }
    val err_drawn: err[Fail] = diag.summary(f, ?line);
    if (sel err_drawn.err) { ret; }
    format.write_str(o.w, "  note ");
    format.write_bytes(o.w, sink.data(?line), sink.len(?line));
    format.write_str(o.w, "\n");
}

# where the failures a tool reports to the writer `w` go, each headline led by `error`
# ---
# a:    the allocator a wording takes its scratch storage from
# w:    the writer
# file: the file the module was read from, nil for none
# ret:  the place the tool's failures are worded into
pub fun tool(a: *A.Allocator, w: *io.Writer, file: str) Out {
    ret Out{a: a, w: w, file: file, head: "error"};
}
