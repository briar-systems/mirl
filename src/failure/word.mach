# the wording of every failure of mirl's, from its outer case to its leaf, and the class of what refused
#
# each function words one error and the errors it holds, naming the function, the value, the type and the
# pass it holds, and answers whether the source can clear it. the allocator's refusal is classed apart, by
# `starved`, wherever it stands in the chain

use masc_ct: masc.core.ct;
use masc.core.ct;
use masc.core.extension;
use masc.core.requirement;
use mset: masc.core.set;
use masc.core.unmet;
use mink.base.fail;
use mink.base.fail.Fail;
use mink.catalog.output;
use build_error:   mirl.build.error;
use build_failure: mirl.build.failure;
use mct:           mirl.ct;
use mirl.debug.records;
use mirl.failure.text;
use mirl.failure.text.Class;
use mirl.failure.text.Out;
use mirl.ir.block.BlockData;
use cfg:         mirl.ir.cfg.failure;
use debug_place: mirl.ir.debug.place;
use debug_table: mirl.ir.debug.table;
use mirl.ir.function;
use mirl.ir.id;
use mirl.ir.id.Function;
use mirl.ir.id.Symbol;
use mirl.ir.instruction;
use mirl.ir.module;
use irow:         mirl.ir.opcode.row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.text.item;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.ir.type.calling;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.machine.alloc.allocate;
use mirl.machine.alloc.check;
use mirl.machine.alloc.live;
use mirl.machine.alloc.rewrite;
use mirl.machine.alloc.scan;
use mirl.machine.alloc.spill;
use mcompile: mirl.machine.compile;
use mirl.machine.copy.lower;
use mirl.machine.emit.handover;
use mirl.machine.frame.code;
use mirl.machine.frame.finish;
use minline: mirl.machine.inline;
use lrow:    mirl.machine.loop.row;
use mirl.machine.select.engine;
use mirl.machine.timing;
use mirl.pass.analysis;
use mirl.pass.cache;
use pass_failure: mirl.pass.failure;
use mirl.pass.refusal;
use mirl.pass.relaxation;
use pass_schedule: mirl.pass.schedule;
use mirl.target.assemble;
use target_basis: mirl.target.basis;
use mirl.target.basis;
use mirl.target.compile;
use mirl.target.family;
use thead: mirl.target.head;
use mirl.target.layout;
use mirl.target.options;
use mirl.target.record;
use mirl.target.record.Target;
use spirv_error:    mirl.target.spirv.error;
use wasm_error:     mirl.target.wasm.error;
use verify_failure: mirl.verify.failure;
use verify_table:   mirl.verify.table;
use A:              std.allocator;
use std.args;
use std.collections.slice.Slice;
use std.collections.vector;
use fs: std.filesystem;
use std.format;
use io: std.io.writer;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

# report a failed compilation: a target no family serves, a family that
# writes no image or no listing, a module a pass or a stage refuses and a
# module holding an opcode its target's family does not serve are refused
# input, a build that was not opened is reported by `unopened`, a refusal of
# storage is the environment's, and anything else is internal
pub fun failed(o: *Out, m: *module.Module, t: *Target, added: Slice[str], e: family.Error) Class {
    if (sel e.unserved) {
        text.headline(o, nil, "no family serves the target's declarations");
        ret Class.refused{};
    }
    or (sel e.several) {
        text.headline(o, nil, "more than one family admits the target's declarations");
        ret Class.internal{};
    }
    or (sel e.schedule) { ret pass_failed(o, m, e.schedule); }
    or (sel e.register) { ret refused(o, m, e.register); }
    or (sel e.wasm)     { ret refused_wasm(o, m, e.wasm); }
    or (sel e.spirv)    { ret refused_spirv(o, m, e.spirv); }
    or (sel e.timing)   { ret timed(o, m, e.timing); }
    or (sel e.alloc) {
        text.headline(o, nil, "the allocator refused storage");
        ret Class.environment{};
    }
    or (sel e.format || sel e.link || sel e.write) { ret unwritten(o, e); }
    or (sel e.output) {
        text.headline(o, nil, "the target's family writes relocatable objects alone, which a link makes an image of");
        ret Class.refused{};
    }
    or (sel e.unlisted) {
        text.headline(o, nil, "the target's family writes no listing, because its back end hands no code to masc's builder");
        ret Class.refused{};
    }
    or (sel e.open)       { ret unopened(o, t, added, e.open); }
    or (sel e.foreign)    { ret foreign(o, "the module holds an opcode the target's family does not serve", e.foreign, Class.refused{}); }
    or (sel e.introduced) { ret foreign(o, "the schedule left an opcode the target's family does not serve", e.introduced, Class.internal{}); }
}

# report a module the back end refused: a function a stage refuses, a target
# mirl carries no machine for, code emission refuses and a relocation the
# object's format does not map are refused input, a refusal of storage is the
# environment's, and a function a stage leaves invalid and anything else is internal
fun refused(o: *Out, m: *module.Module, failed: mcompile.Failed) Class {
    val c: mcompile.Error = failed.error;
    if (sel failed.function.some) {
        val fn: id.Function = failed.function.some;
        if (sel c.widening) { ret widened(o, m, fn, c.widening); }
        val f: View = module.name_of(m, m.functions.data[fn].data.name);
        if (sel c.timing) {
            val found: timing.Error = c.timing;
            ret timed(o, m, mct.refused(fn, mct.Where.instruction{found.instruction}, found.refusal, failed.location));
        }
        if (sel c.verify) {
            text.headline(o, nil, "a stage left a function invalid");
            text.source(o, m, failed.location);
            text.symbol(o, f);
            ret Class.internal{};
        }
        text.headline(o, nil, "a stage refused a function");
        text.source(o, m, failed.location);
        text.symbol(o, f);
        staged(o, m, fn, failed);
        if (sel c.alloc) { ret Class.environment{}; }
        ret Class.refused{};
    }
    if (sel c.walked) {
        # every function the walk refused is reported, the first deciding the exit
        val every: Slice[mct.Error] = c.walked;
        var code:  Class            = Class.refused{};
        var i:     usize            = 0;
        for (i < every.size) {
            val unmet: mct.Error = every.data[i];
            var one:   Class     = Class.refused{};
            if (sel unmet.refused)      { one = timed(o, m, unmet.refused); }
            or (sel unmet.unfollowed)   { one = unfollowed(o, m, unmet.unfollowed); }
            or (sel unmet.stale)        { one = stale(o, m, unmet.stale); }
            or (sel unmet.unguaranteed) { one = unguaranteed(o, m, unmet.unguaranteed); }
            if (i == 0)                 { code = one; }
            i = i + 1;
        }
        ret code;
    }
    if (sel c.uncarried) {
        text.headline(o, nil, "mirl carries no selection table for the target's instruction set");
        ret Class.refused{};
    }
    if (sel c.emit) {
        val opt_handed_over: opt[Class] = handed(o, m, c.emit);
        if (sel opt_handed_over.some) { ret opt_handed_over.some; }
        val opt_placed_global: opt[Class] = misplaced(o, m, c.emit);
        if (sel opt_placed_global.some) { ret opt_placed_global.some; }
        if (sel c.emit.section) {
            val named: id.Symbol = c.emit.section;
            if (sel named.function) { ret unsectioned(o, m, named.function); }
        }
        if (sel c.emit.init)     { ret uninitialised(o, m, c.emit.init); }
        if (sel c.emit.unmapped) { ret unmapped(o, m, c.emit.unmapped); }
        if (sel c.emit.export)   { ret unexported(o, m, c.emit.export); }
        if (sel c.emit.builder) {
            var opt_why: opt[Fail] = opt[Fail].none{};
            if (sel c.emit.builder.detail.object) { opt_why = opt[Fail].some{c.emit.builder.detail.object}; }
            ret unmade(o, "the object was not made, as masc refused the module", opt[str].some{c.emit.builder.message}, opt_why, Class.internal{});
        }
        if (sel c.emit.lowering) { ret unmade(o, "the object was not made, as mink states no registration of its format", opt[str].none{}, opt[Fail].some{c.emit.lowering}, Class.internal{}); }
        if (sel c.emit.listing)  { ret unlistable(o, m, c.emit.listing); }
    }
    if (sel c.table) {
        if (sel c.table.table) {
            text.lead(o, nil);
            format.write_str(o.w, "the module was not compiled, as the target's selection table breaks its schema at ");
            if (c.table.table.constant) { format.write_str(o.w, "materialisation "); }
            format.write_str(o.w, "rule ");
            format.write_u64(o.w, c.table.table.rule::u64);
            format.write_str(o.w, ", a ");
            format.write_str(o.w, c.table.table.what);
            format.write_str(o.w, "\n");
            ret Class.internal{};
        }
        if (sel c.table.breached) {
            val b: engine.Breached = c.table.breached;
            text.lead(o, nil);
            format.write_str(o.w, "the module was not compiled, as the loop '");
            format.write_str(o.w, b.loop.name);
            format.write_str(o.w, "' of the target's selection table breaks its constraint, as ");
            format.write_str(o.w, breach(b.breach));
            format.write_str(o.w, "\n");
            ret Class.internal{};
        }
        text.lead(o, nil);
        format.write_str(o.w, "the module was not compiled, as selection refused the target's table (");
        format.write_str(o.w, unselected(c.table));
        format.write_str(o.w, ")\n");
        ret Class.internal{};
    }
    text.lead(o, nil);
    format.write_str(o.w, "the module was not compiled, as ");
    format.write_str(o.w, uncompiled(c));
    format.write_str(o.w, "\n");
    ret uncompiled_code(c);
}

# report the extensions a function admits past the build's that were not
# opened: a name the target's instruction set does not know and names whose
# closure conflicts are refused input, and anything else is internal
fun widened(o: *Out, m: *module.Module, fn: id.Function, e: target_basis.Error) Class {
    val f: View = module.name_of(m, m.functions.data[fn].data.name);
    text.lead(o, nil);
    if (sel e.named) {
        format.write_str(o.w, "the instruction set of the target knows no extension named '");
        text.view(o, e.named);
        format.write_str(o.w, "', which a function admits\n");
        text.symbol(o, f);
        ret Class.refused{};
    }
    format.write_str(o.w, "the extensions a function admits past the build's were not opened, as ");
    format.write_str(o.w, target_basis.fact(e));
    format.write_str(o.w, "\n");
    text.symbol(o, f);
    if (sel e.extensions) { ret Class.refused{}; }
    ret Class.internal{};
}

# report an instruction emission cannot hand over: why, the function, where
# the instruction was built for, and the instruction and operand. it is
# refused input, and none when emission refused anything else
fun handed(o: *Out, m: *module.Module, e: handover.Error) opt[Class] {
    val opt_held: opt[handover.At] = instruction_at(e);
    if (sel opt_held.none) { ret opt[Class].none{}; }
    val at: handover.At = opt_held.some;
    text.headline(o, nil, "emission cannot hand an instruction over");
    text.source(o, m, at.location);
    function_name(o, m, at.function);
    if (sel e.inline) {
        format.write_str(o.w, "  why masc refused an inline assembly block with its operands placed (");
        format.write_str(o.w, e.inline.message);
        format.write_str(o.w, ")\n");
    }
    or { text.tagged(o, "why", reason(e)); }
    format.write_str(o.w, "  at instruction ");
    format.write_u64(o.w, at.at::u64);
    format.write_str(o.w, " of the code");
    if (at.operand != handover.NO_OPERAND) {
        format.write_str(o.w, ", operand ");
        format.write_u64(o.w, at.operand::u64);
    }
    format.write_str(o.w, "\n");
    ret opt[Class].some{Class.refused{}};
}

# the instruction emission cannot hand over, none when it refused anything
# else
fun instruction_at(e: handover.Error) opt[handover.At] {
    if (sel e.inline)     { ret opt[handover.At].some{e.inline.at}; }
    if (sel e.pseudo)     { ret opt[handover.At].some{e.pseudo}; }
    if (sel e.unplaced)   { ret opt[handover.At].some{e.unplaced}; }
    if (sel e.cell)       { ret opt[handover.At].some{e.cell}; }
    if (sel e.shape)      { ret opt[handover.At].some{e.shape}; }
    if (sel e.unbound)    { ret opt[handover.At].some{e.unbound}; }
    if (sel e.ambiguous)  { ret opt[handover.At].some{e.ambiguous}; }
    if (sel e.label)      { ret opt[handover.At].some{e.label}; }
    if (sel e.span)       { ret opt[handover.At].some{e.span}; }
    if (sel e.fact)       { ret opt[handover.At].some{e.fact}; }
    if (sel e.table)      { ret opt[handover.At].some{e.table}; }
    if (sel e.declassify) { ret opt[handover.At].some{e.declassify}; }
    ret opt[handover.At].none{};
}

# why emission cannot hand an instruction over
fun reason(e: handover.Error) str {
    if (sel e.pseudo)     { ret "a pseudo-instruction or loop no stage expanded, which encodes to nothing"; }
    if (sel e.unplaced)   { ret "a virtual register or a frame slot, which allocation and the frame replace"; }
    if (sel e.cell)       { ret "a location of a memory-backed class, which no register machine holds in an object"; }
    if (sel e.shape)      { ret "an operand of a kind its position does not take, or a list longer than an instruction keeps room for"; }
    if (sel e.unbound)    { ret "a relocation kind the instruction set binds no fixup kind to"; }
    if (sel e.ambiguous)  { ret "a relocation kind the instruction set binds several fixup kinds to, none the operand's own"; }
    if (sel e.label)      { ret "a label two instructions hold, or inside a sequence, or a partner naming a label no instruction holds"; }
    if (sel e.span)       { ret "a relocation covering more instructions than the block has after it"; }
    if (sel e.fact)       { ret "a call frame fact at an instruction layout left in no block"; }
    if (sel e.declassify) { ret "a declassifying instruction of a constant-time function that leaves no declassify point of its own"; }
    ret "a jump table on a target that states no address model or no pointer";
}

# report a global emission cannot place: the global and its fault. it is
# refused input, and none when emission refused anything else
fun misplaced(o: *Out, m: *module.Module, e: handover.Error) opt[Class] {
    val opt_held: opt[id.Global] = global_of(e);
    if (sel opt_held.none) { ret opt[Class].none{}; }
    val g: id.Global = opt_held.some;
    text.headline(o, nil, "emission cannot place a global");
    if (g::usize < m.globals.len) { text.symbol(o, module.name_of(m, m.globals.data[g].data.name)); }
    text.tagged(o, "why", fault(e));
    ret opt[Class].some{Class.refused{}};
}

# the global emission cannot place, none when it refused anything else
fun global_of(e: handover.Error) opt[id.Global] {
    if (sel e.contents) { ret opt[id.Global].some{e.contents.global}; }
    if (sel e.model)    { ret opt[id.Global].some{e.model}; }
    if (sel e.layout)   { ret opt[id.Global].some{e.layout.global}; }
    if (sel e.width)    { ret opt[id.Global].some{e.width}; }
    if (sel e.section) {
        val named: id.Symbol = e.section;
        if (sel named.global) { ret opt[id.Global].some{named.global}; }
    }
    ret opt[id.Global].none{};
}

# why emission cannot place a global
fun fault(e: handover.Error) str {
    if (sel e.contents) { ret "the module refused a read of its initial value"; }
    if (sel e.model)    { ret "its initial value holds an address and the target states no address model"; }
    if (sel e.section)  { ret "it names a section a function or another global names with another kind"; }
    if (sel e.layout)   { ret "the data layout gives its type or a part of its initial value no extent"; }
    ret "an address in its initial value is wider than any datum masc relocates";
}

# report a function whose section a global or another function names with another kind. it is refused input
fun unsectioned(o: *Out, m: *module.Module, f: id.Function) Class {
    text.headline(o, nil, "emission cannot place a function");
    if (f::usize < m.functions.len) { text.symbol(o, module.name_of(m, m.functions.data[f].data.name)); }
    text.tagged(o, "why", "it names a section a global or another function names with another kind");
    ret Class.refused{};
}

# report a function the loader runs at load on a target that states no pointer width. it is refused input
fun uninitialised(o: *Out, m: *module.Module, f: id.Function) Class {
    text.headline(o, nil, "emission cannot place a function");
    if (f::usize < m.functions.len) { text.symbol(o, module.name_of(m, m.functions.data[f].data.name)); }
    text.tagged(o, "why", "the loader runs it at load and the target states no pointer width for its table entry");
    ret Class.refused{};
}

# the step a function was refused at and what refused it, under its headline
fun staged(o: *Out, m: *module.Module, fn: id.Function, f: mcompile.Failed) {
    format.write_str(o.w, "  ");
    if (sel f.step.some) {
        format.write_str(o.w, "at the step '");
        format.write_str(o.w, f.step.some);
        format.write_str(o.w, "', ");
    }
    format.write_str(o.w, stage(f.error));
    val s: mcompile.Error = f.error;
    if (sel s.select) {
        if (sel s.select.machine) {
            if (sel s.select.machine.refused) {
                format.write_str(o.w, ", a ");
                format.write_str(o.w, s.select.machine.refused.what);
            }
        }
    }
    if (sel s.select) {
        if (sel s.select.assembly) {
            val r: minline.Error = s.select.assembly.refusal;
            if (sel r.parsed) {
                format.write_str(o.w, " (");
                format.write_str(o.w, r.parsed);
                format.write_str(o.w, ")");
            }
            if (sel r.unadmitted) { unadmitted(o, ?r.unadmitted); }
            if (sel r.head) {
                format.write_str(o.w, " (");
                format.write_str(o.w, thead.fact(r.head));
                format.write_str(o.w, ")");
            }
        }
    }
    format.write_str(o.w, "\n");
    if (sel s.select) {
        if (sel s.select.unmatched) { unmatched(o, m, fn, s.select.unmatched); }
        if (sel s.select.misaligned) {
            var p: printer.Printer = printer.init(o.w, m);
            fin { printer.dnit(?p); }
            format.write_str(o.w, "  type ");
            printer.ty(?p, s.select.misaligned);
            format.write_str(o.w, "\n");
        }
    }
}

# the operation no rule matched, `operation ...`, its opcode and the types
# of its operands and results, and where it stands in its function,
# `at ...`
fun unmatched(o: *Out, m: *module.Module, f: id.Function, u: engine.Unmatched) {
    var p: printer.Printer = printer.init(o.w, m);
    fin { printer.dnit(?p); }
    var held: engine.Unmatched = u;
    format.write_str(o.w, "  operation ");
    if (sel u.operation.opcode) {
        val opt_row: opt[*irow.Row] = opcode_table.at(u.operation.opcode);
        if (sel opt_row.some) { format.write_str(o.w, opt_row.some.name); }
        or                    { format.write_str(o.w, "an opcode with no row"); }
        format.write_str(o.w, " ");
        typed(?p, Slice[Type]{data: ?held.operands[0], size: $length_of(irow.Operands)}, u.operand_count);
        format.write_str(o.w, " -> ");
        typed(?p, Slice[Type]{data: ?held.results[0], size: $length_of(irow.Results)}, u.result_count);
    }
    or {
        format.write_str(o.w, "a constant of ");
        printer.ty(?p, u.operands[0]);
        format.write_str(o.w, " to materialise");
    }
    format.write_str(o.w, "\n  at ");
    placed(o, m, f, u.instruction);
    format.write_str(o.w, "\n");
}

# a parenthesised list of count types, of which selection kept the first
# kept.size, `...` standing for the rest
fun typed(p: *printer.Printer, kept: Slice[Type], count: u32) {
    format.write_str(p.w, "(");
    var k: usize = 0;
    for (k < count::usize && k < kept.size) {
        if (k > 0) { format.write_str(p.w, ", "); }
        printer.ty(p, kept.data[k]);
        k = k + 1;
    }
    if (count::usize > kept.size) { format.write_str(p.w, ", ..."); }
    format.write_str(p.w, ")");
}

# where an instruction stands in its function: its place in its block and
# the block's name or index when it is placed, then its index in the body
fun placed(o: *Out, m: *module.Module, f: id.Function, i: id.Instruction) {
    val res_body: res[*function.Body, module.Error] = module.body(m, f);
    if (sel res_body.ok) {
        val b: *function.Body = res_body.ok;
        if (i::usize < b.instructions.len) {
            val place: instruction.Place = b.instructions.data[i].place;
            if (sel place.placed) {
                val k:    id.Block   = place.placed;
                val held: *BlockData = ?b.blocks.data[k];
                var at:   usize      = 0;
                for (at < held.instructions.len && held.instructions.data[at] != i) { at = at + 1; }
                format.write_str(o.w, "instruction ");
                format.write_u64(o.w, at::u64);
                format.write_str(o.w, " of block ");
                val opt_name: opt[View] = held.name;
                if (sel opt_name.some) {
                    format.write_str(o.w, "^");
                    text.view(o, opt_name.some);
                }
                or { format.write_u64(o.w, k::u64); }
                format.write_str(o.w, ", ");
            }
        }
    }
    format.write_str(o.w, "instruction ");
    format.write_u64(o.w, i::u64);
    format.write_str(o.w, " of the body");
}

# what refused a function
fun stage(s: mcompile.Error) str {
    if (sel s.select)   { ret unselected(s.select); }
    if (sel s.effects)  { ret "what its instructions read and write was not read"; }
    if (sel s.pointer)  { ret "the frame's need of a pointer was not read"; }
    if (sel s.allowed)  { ret "the locations the allocator may assign were not listed"; }
    if (sel s.allocate) { ret unallocated(s.allocate); }
    if (sel s.frame) {
        val e: finish.Error = s.frame;
        if (sel e.lay)        { ret "its frame was not laid out"; }
        if (sel e.code)       { ret framed(e.code); }
        if (sel e.made)       { ret "a register, slot or block of its frame was not made"; }
        if (sel e.operand)    { ret "a dynamic allocation of its frame names a register past the file"; }
        if (sel e.dropped)    { ret "an instruction names a slot the frame's layout dropped"; }
        if (sel e.unnumbered) { ret "a register a call frame rule names has no dwarf column under the build"; }
        if (sel e.scavenge)   { ret "the emergency slots its frame needs were not counted"; }
        ret "a call frame rule stands at an offset that scales";
    }
    if (sel s.copies) {
        ret uncopied(s.copies);
    }
    if (sel s.configure)  { ret "the states its instructions run under were not established"; }
    if (sel s.loops)      { ret "its loops were not expanded into their steps"; }
    if (sel s.layout)     { ret "its blocks were not laid out"; }
    if (sel s.ranges)     { ret "where its variables are was not read"; }
    if (sel s.verify)     { ret "the verifier refused it after the step"; }
    if (sel s.misplaced)  { ret "the step reads a form of it the steps before did not leave"; }
    if (sel s.unfinished) { ret "the steps ended before it was laid out"; }
    if (sel s.convention) { ret "it or a call it makes is under a convention row other than the target's default"; }
    if (sel s.alloc)      { ret "the allocator refused storage"; }
    ret "a step refused it";
}

# why register allocation refused a function
fun unallocated(e: allocate.Error) str {
    if (sel e.alloc)   { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.foreign) { ret "register allocation refused it (its locations are of another register file than the function's)"; }
    if (sel e.clobber) { ret "register allocation refused it (a clobber names an instruction or a set the function does not have)"; }
    if (sel e.form)    { ret unformed(e.form); }
    if (sel e.live)    { ret unlive(e.live); }
    if (sel e.scan)    { ret unscanned(e.scan); }
    if (sel e.rewrite) { ret unrewritten(e.rewrite); }
    if (sel e.check)   { ret unchecked_allocation(e.check); }
    ret "register allocation refused it (a value of a class never spilled would be carried in pieces)";
}

# why a round's virtual form was not built
fun unformed(e: spill.Error) str {
    if (sel e.alloc) { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.refused) {
        if (sel e.refused.alloc) { ret "register allocation refused it (the allocator refused storage for a spill, reload or copy)"; }
        ret "register allocation refused it (the function's maker refused a spill, reload or copy)";
    }
    if (sel e.class) { ret "register allocation refused it (a value in pieces of a class the target's locations do not have)"; }
    ret "register allocation refused it (a value in pieces whose class's storage no slot states)";
}

# why liveness was refused
fun unlive(e: live.Error) str {
    if (sel e.alloc)     { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.foreign)   { ret "register allocation refused it (its locations are of another register file than the function's)"; }
    if (sel e.unlocated) { ret "register allocation refused it at liveness (an effect register or a clobber the locations do not number)"; }
    if (sel e.refused)   { ret "register allocation refused it at liveness (an operand names a register or cell the locations refused)"; }
    if (sel e.conflict)  { ret "register allocation refused it at liveness (two values held in one location at one position)"; }
    if (sel e.ungrouped) { ret "register allocation refused it at liveness (an instruction whose grouping is refused)"; }
    if (sel e.undecided) { ret "register allocation refused it at liveness (an instruction whose footprint masc leaves undecided)"; }
    ret "register allocation refused it at liveness (its positions do not fit)";
}

# why a round's scan was refused
fun unscanned(e: scan.Error) str {
    if (sel e.alloc)       { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.pinned)      { ret "register allocation refused it at scan (an operand pinned to a location the target does not let the allocator assign)"; }
    if (sel e.stuck)       { ret "register allocation refused it at scan (values no location holds and no split helps)"; }
    if (sel e.unlocated)   { ret "register allocation refused it at scan (a register a copy names that the locations refused)"; }
    if (sel e.constrained) { ret "register allocation refused it at scan (no location of a value's class meets its instruction's constraints)"; }
    ret "register allocation refused it at scan (a value of a list's registers would be carried in pieces)";
}

# why the rewrite of an allocated function was refused
fun unrewritten(e: rewrite.Error) str {
    if (sel e.alloc) { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.refused) {
        if (sel e.refused.alloc) { ret "register allocation refused it at rewrite (the allocator refused storage for a rewritten instruction)"; }
        ret "register allocation refused it at rewrite (the function's maker refused a rewritten instruction)";
    }
    if (sel e.unassigned) { ret "register allocation refused it at rewrite (an operand names a value with no location)"; }
    ret "register allocation refused it at rewrite (an operand names a value through a view its location holds no register of)";
}

# why the checker refused a checked allocation
fun unchecked_allocation(e: check.Error) str {
    if (sel e.alloc)      { ret "register allocation refused it (the allocator refused storage)"; }
    if (sel e.live)       { ret unlive(e.live); }
    if (sel e.count)      { ret "the allocation checker refused it (it assigns a different number of values than the form has)"; }
    if (sel e.unassigned) { ret "the allocation checker refused it (a live value has no location)"; }
    if (sel e.outside)    { ret "the allocation checker refused it (a value is at a location the target does not allow)"; }
    if (sel e.class)      { ret "the allocation checker refused it (a value is at a location outside its class)"; }
    if (sel e.meet)       { ret "the allocation checker refused it (two values share one location at one position)"; }
    if (sel e.unpinned)   { ret "the allocation checker refused it (a pinned read or write is outside the location its row fixes)"; }
    if (sel e.shape)      { ret "the allocation checker refused it (a rewritten instruction is not the form's)"; }
    ret "the allocation checker refused it (a rewritten instruction breaks its row's register constraints)";
}

# why a function's copies were not lowered to the set's moves
fun uncopied(e: lower.Error) str {
    if (sel e.alloc) { ret "its copies were not lowered (the allocator refused storage)"; }
    if (sel e.live)  { ret "its copies were not lowered (liveness of the framed function was refused)"; }
    if (sel e.made) {
        if (sel e.made.alloc) { ret "its copies were not lowered (the allocator refused storage for an instruction)"; }
        ret "its copies were not lowered (the function's maker refused an instruction)";
    }
    if (sel e.code)      { ret framed(e.code); }
    if (sel e.unlocated) { ret "its copies were not lowered (a register the frame or the convention names has no location)"; }
    ret unlowered(e);
}

# why one copy was not lowered
fun unlowered(r: lower.Error) str {
    if (sel r.operand)    { ret "its copies were not lowered (a copy names an operand that is not a register, cell or slot)"; }
    if (sel r.label)      { ret "its copies were not lowered (a partner names a copy, which may make no instruction)"; }
    if (sel r.implied)    { ret "its copies were not lowered (a copy states locations beyond its operands)"; }
    if (sel r.twice)      { ret "its copies were not lowered (two pairs of a copy write one storage)"; }
    if (sel r.unmoved)    { ret "its copies were not lowered (the set states no move for a pair, directly or through a register)"; }
    if (sel r.scratch)    { ret "its copies were not lowered (a pair of memory locations has no free location to go through)"; }
    if (sel r.sizes)      { ret "its copies were not lowered (a pair of memory locations differ in size)"; }
    if (sel r.cycle)      { ret "its copies were not lowered (a cycle has no free location to break it and no swap)"; }
    if (sel r.dropped)    { ret "its copies were not lowered (a copy names a slot the frame dropped)"; }
    if (sel r.unnumbered) { ret "its copies were not lowered (a copy names a register or cell the locations refused)"; }
    ret "its copies were not lowered (no free location meets every instruction of the moves through it)";
}

# why the target's frame code refused a move of a function's frame
fun framed(r: code.Error) str {
    if (sel r.alloc)      { ret "the allocator refused storage to the target's frame code"; }
    if (sel r.foreign)    { ret "the target's frame code names a class of no row of the selection's file"; }
    if (sel r.twice)      { ret "the target's frame code admits two loads or stores of one class and one storage"; }
    if (sel r.reach)      { ret "the target's frame code reaches no slot at an offset of the frame"; }
    if (sel r.scaled)     { ret "the target's frame code forms no offset per unit of a scale of the frame"; }
    if (sel r.mask)       { ret "the target's frame code masks to no alignment of the frame"; }
    if (sel r.access)     { ret "the target's frame code has no load or store of a register the frame moves"; }
    if (sel r.unadmitted) { ret "the target's frame code moves through a row the selection does not admit"; }
    if (sel r.made) {
        if (sel r.made.alloc) { ret "the allocator refused storage for an instruction of the frame code"; }
        ret "the function's maker refused an instruction of the frame code";
    }
    if (sel r.constrained) { ret "an instruction of the frame code breaks its row's register constraints"; }
    if (sel r.unpaired)    { ret "the target's frame code moves two registers in no one instruction"; }
    if (sel r.unreserved)  { ret "the frame has no emergency slot left of the kind of a register it saves"; }
    if (sel r.unleft)      { ret "the function returns through a routine the target's frame code leaves through none of"; }
    if (sel r.unpushed)    { ret "the target's frame code pushes or pops no register the frame saves by a push"; }
    ret "the frame moves through a probe routine the target's frame code makes none of";
}

# how a loop's body breaks its constraint
fun breach(b: lrow.Breach) str {
    if (sel b.long)   { ret "it holds more instructions than the limit"; }
    if (sel b.opened) { ret "it does not open with the load of the reserved pair"; }
    if (sel b.access) { ret "a step touches memory other than as its atomic access, or a second time"; }
    if (sel b.stored) { ret "it holds no store of the pair, or no swap"; }
    if (sel b.row)    { ret "a step needs an extension past the plain ones, or serialises"; }
    if (sel b.branch) { ret "a step transfers control other than by a conditional branch"; }
    ret "it branches back to its start before the store or the swap, or twice";
}

# the fact selection refused a target's table on
fun unselected(e: engine.Error) str {
    if (sel e.alloc)      { ret "the allocator refused storage"; }
    if (sel e.module)     { ret "the module refused a read"; }
    if (sel e.types)      { ret "the type table refused a read"; }
    if (sel e.unmatched)  { ret "no rule matches an operation"; }
    if (sel e.unheld)     { ret "no class the build meets holds a value of a type"; }
    if (sel e.ambiguous)  { ret "more than one class the build meets holds a value of a type"; }
    if (sel e.reach)      { ret "a type the target reaches has no class or two in the table"; }
    if (sel e.removed)    { ret "a value's definition was removed"; }
    if (sel e.machine)    { ret "the machine form refused an instruction the table built"; }
    if (sel e.aggregate)  { ret "a value of an aggregate type, which no register holds"; }
    if (sel e.unlocated)  { ret "a register a call clobbers has no location"; }
    if (sel e.placed)     { ret "a piece stands at a place selection does not carry"; }
    if (sel e.transfer)   { ret "a piece form instruction neither calls nor returns"; }
    if (sel e.lookup)     { ret "the target's thread lookup function is not named"; }
    if (sel e.cell)       { ret "the target's thread-local index cell is not declared"; }
    if (sel e.layout)     { ret "the target's layout gives no size for a slot's type"; }
    if (sel e.unplaced)   { ret "a function's entry has parameters the abi legalisation did not place"; }
    if (sel e.undecided)  { ret "an instruction's transfer turns on an operand that names no register yet"; }
    if (sel e.unchecked)  { ret "a division stands with no test of the trap it gives a result for"; }
    if (sel e.breached)   { ret "a loop of the table breaks the constraint its body keeps"; }
    if (sel e.assembly)   { ret assembled(e.assembly.refusal); }
    if (sel e.naked)      { ret "a naked function holds an instruction other than an inline assembly block that binds nothing or an unreachable"; }
    if (sel e.switched)   { ret e.switched.why; }
    if (sel e.misaligned) { ret "a load or store states an alignment below its type's own, which the target does not carry out"; }
    ret "the table breaks its schema";
}

# what an inline assembly block uses that its selection does not hold, as ` (`andn` needs zbb, or zbkb)` or
# ` (`vpaddd` with `ymm0` needs avx)`
fun unadmitted(o: *Out, u: *minline.Unadmitted) {
    var spelled: vector.Vector[u8] = vector.init[u8](o.a);
    fin { vector.dnit[u8](?spelled); }
    val err_spelled: err[A.Error] = unmet.spell_unmet(?u.unmet, ?spelled);
    format.write_str(o.w, " (`");
    text.view(o, u.mnemonic);
    if (u.spelled.data != u.mnemonic.data) {
        format.write_str(o.w, "` with `");
        text.view(o, u.spelled);
    }
    format.write_str(o.w, "` ");
    if (sel err_spelled.ok) { format.write_bytes(o.w, spelled.data::*u8, spelled.len); }
    format.write_str(o.w, ")");
}

# why selection refused an inline assembly block
fun assembled(r: minline.Error) str {
    if (sel r.alloc)      { ret "the allocator refused storage"; }
    if (sel r.parsed)     { ret "masc refused an inline assembly block"; }
    if (sel r.unadmitted) { ret "an inline assembly block uses what its selection does not hold"; }
    if (sel r.head)       { ret "masc refused the selection of an inline assembly block"; }
    if (sel r.returns)    { ret "an inline assembly block may return from its function, which would skip its epilogue"; }
    if (sel r.switched)   { ret "an inline assembly block switches an execution state in a function that is not naked"; }
    if (sel r.operands)   { ret "an inline assembly block binds more operands than one block may"; }
    if (sel r.class)      { ret "an inline assembly block binds an operand in another class than its constraint's"; }
    ret "an inline assembly block binds an address as an immediate, which the machine form carries no relocation for yet";
}

# why the module's debug records were not stated on the object
fun debugging(e: records.Error) str {
    if (sel e.alloc)   { ret "the allocator refused storage while the debug records were stated"; }
    if (sel e.object)  { ret "mink refused a debug record or its name"; }
    if (sel e.table)   { ret "the debug records could not read the module's debug table"; }
    if (sel e.module)  { ret "the debug records could not read the module"; }
    if (sel e.layout)  { ret "the layout gave a type of the debug table no size or offset"; }
    if (sel e.refused) { ret "dwarf does not write a variable's location"; }
    if (sel e.number)  { ret "masc's dwarf column numbers no register a variable's location names"; }
    ret "a label the debug records name has no place or symbol in the object";
}

# the code a back end refusal `uncompiled` words exits with: the environment's
# when the allocator refused storage, internal otherwise
fun uncompiled_code(c: mcompile.Error) Class {
    if (sel c.alloc) { ret Class.environment{}; }
    if (sel c.emit) {
        val e: handover.Error = c.emit;
        if (sel e.alloc) { ret Class.environment{}; }
    }
    ret Class.internal{};
}

# the step a module was not compiled at and the fact it failed on, for a
# refusal `refused` reports no more closely
fun uncompiled(c: mcompile.Error) str {
    if (sel c.alloc)     { ret "the allocator refused storage"; }
    if (sel c.foreign)   { ret "the build was opened for another target than the one given"; }
    if (sel c.locations) { ret "the locations of the target's registers and memories were not numbered"; }
    if (sel c.table)     { ret "selection refused the target's table"; }
    if (sel c.moves)     { ret "the instruction set's moves were not indexed for the target"; }
    if (sel c.code)      { ret "the frame code was not bound to the target's selection"; }
    if (sel c.machine)   { ret "the machine form text was not printed"; }
    if (sel c.write)     { ret "the listing was not written"; }
    if (sel c.emit) {
        val e: handover.Error = c.emit;
        if (sel e.alloc)      { ret "the allocator refused storage while the object was made"; }
        if (sel e.symbol)     { ret "an instruction names a symbol the module does not have"; }
        if (sel e.unlabelled) { ret "a label the emission made at an instruction has no place in the finished object"; }
        if (sel e.convention) { ret "the target states no calling convention, so its objects follow no psabi row"; }
        if (sel e.abi)        { ret "the convention names no psabi row of mink's catalog for the architecture"; }
        if (sel e.fill)       { ret "the target's code fill is not one byte repeated, which masc's alignment takes"; }
        if (sel e.dialect)    { ret "masc states no assembly dialect of the object format, which the listing is written in"; }
        if (sel e.listing)    { ret "masc refused to list the object it made"; }
        if (sel e.debug)      { ret debugging(e.debug); }
        if (sel e.lowering)   { ret "mink states no registration of the object's format"; }
        if (sel e.export)     { ret "the object refused to export a symbol the module marks exported"; }
    }
    ret "the back end refused it";
}

# report a module the webassembly back end refused: what wasm has no form of
# yet, an inline assembly block it refuses, an atomic access on a build that
# runs threads, a value no wasm value type holds, an address the table has no
# slot of, an address no relocation writes, a signature the convention does
# not place and a constant-time function the walk refuses are refused input,
# and anything else is internal
fun refused_wasm(o: *Out, m: *module.Module, e: wasm_error.Error) Class {
    if (sel e.unselected) {
        text.headline(o, nil, "an instruction webassembly has no form of yet");
        text.source(o, m, e.unselected.location);
        text.symbol(o, module.name_of(m, m.functions.data[e.unselected.function].data.name));
        ret Class.refused{};
    }
    if (sel e.assembly) {
        text.headline_because(o, "webassembly refused an inline assembly block", e.assembly.message);
        text.source(o, m, e.assembly.at.location);
        text.symbol(o, module.name_of(m, m.functions.data[e.assembly.at.function].data.name));
        ret Class.refused{};
    }
    if (sel e.threads) {
        text.headline(o, nil, "an atomic access on a build that runs threads, which reach no atomic yet");
        text.source(o, m, e.threads.location);
        text.symbol(o, module.name_of(m, m.functions.data[e.threads.function].data.name));
        ret Class.refused{};
    }
    if (sel e.unvalued) {
        text.headline(o, nil, "a value of a type no webassembly value type holds");
        ret Class.refused{};
    }
    if (sel e.offset) {
        text.headline(o, nil, "the address of a function at an offset, which its table index has none of");
        text.symbol(o, module.name_of(m, m.functions.data[e.offset].data.name));
        ret Class.refused{};
    }
    if (sel e.width) {
        text.headline(o, nil, "an address in an initial value of a width no webassembly relocation writes");
        text.symbol(o, module.name_of(m, m.globals.data[e.width].data.name));
        ret Class.refused{};
    }
    if (sel e.timing)       { ret timed(o, m, e.timing); }
    if (sel e.unfollowed)   { ret unfollowed(o, m, e.unfollowed); }
    if (sel e.stale)        { ret stale(o, m, e.stale); }
    if (sel e.unguaranteed) { ret unguaranteed(o, m, e.unguaranteed); }
    if (sel e.placement) {
        text.headline(o, nil, "a signature the convention does not place");
        ret Class.refused{};
    }
    if (sel e.encoding) {
        text.headline_because(o, "masc refused the module", e.encoding.message);
        ret Class.internal{};
    }
    text.headline(o, nil, "the module was not compiled");
    ret Class.internal{};
}

# the symbol line of a function, `in @name`, when the module has it
fun function_name(o: *Out, m: *module.Module, f: id.Function) {
    if (f::usize < m.functions.len) { text.symbol(o, module.name_of(m, m.functions.data[f].data.name)); }
}

# the symbol line of a global, `in @name`, when the module has it
fun global_name(o: *Out, m: *module.Module, g: id.Global) {
    if (g::usize < m.globals.len) { text.symbol(o, module.name_of(m, m.globals.data[g].data.name)); }
}

# where a spir-v refusal stands: its instruction's place and function, or its global
fun site(o: *Out, m: *module.Module, s: spirv_error.Site) {
    if (sel s.at) {
        text.source(o, m, s.at.location);
        function_name(o, m, s.at.function);
        ret;
    }
    global_name(o, m, s.global);
}

# the rule of a stage's interface a refusal names, as its headline, and the
# entry points and globals the rule names besides its site
fun interface(o: *Out, m: *module.Module, r: spirv_error.Rule) {
    if (sel r.builtin) {
        text.named(o, "a built-in reached from a stage it does not exist in", r.builtin.builtin);
        function_name(o, m, r.builtin.entry);
        ret;
    }
    if (sel r.handle) {
        text.named(o, "a handle binding reached from a stage it does not exist in, which exists in", r.handle.exists);
        function_name(o, m, r.handle.entry);
        ret;
    }
    if (sel r.shared) {
        text.headline(o, nil, "a Workgroup variable reached from a stage other than compute");
        function_name(o, m, r.shared.entry);
        ret;
    }
    if (sel r.output) {
        text.headline(o, nil, "an Output variable reached from a stage that has no outputs");
        function_name(o, m, r.output.entry);
        ret;
    }
    if (sel r.flat) {
        text.headline(o, nil, "an input a fragment stage reads as Flat that a vertex stage reads too");
        function_name(o, m, r.flat.fragment);
        function_name(o, m, r.flat.vertex);
        ret;
    }
    if (sel r.push) {
        text.headline(o, nil, "two push-constant blocks one entry point uses");
        function_name(o, m, r.push.entry);
        global_name(o, m, r.push.other);
        ret;
    }
    if (sel r.spec) {
        text.headline(o, nil, "two specialization constants with one id");
        global_name(o, m, r.spec.other);
        ret;
    }
    if (sel r.workgroup) {
        text.headline(o, nil, "compute stages whose workgroup sizes differ where one WorkgroupSize built-in sizes them all");
        function_name(o, m, r.workgroup.first);
        function_name(o, m, r.workgroup.second);
        ret;
    }
    if (sel r.narrow) {
        text.headline(o, nil, "a stage input or output of integers no stage's interface carries at their width");
        ret;
    }
    if (sel r.layout) {
        text.named(o, "a block laid out against the rules of its class", r.layout.rules);
        ret;
    }
}

# the intrinsic call a refusal names, its place and function, and its argument,
# `argument n`, from one
fun operand(o: *Out, m: *module.Module, given: spirv_error.Operand) {
    text.source(o, m, given.at.location);
    function_name(o, m, given.at.function);
    format.write_str(o.w, "  argument ");
    format.write_u64(o.w, given.operand::u64 + 1);
    format.write_str(o.w, "\n");
}

# report why the spir-v back end refused a module: what spir-v or the build
# cannot hold is refused input, named by its function or global, and anything
# else is internal
fun refused_spirv(o: *Out, m: *module.Module, e: spirv_error.Error) Class {
    if (sel e.unselected) {
        text.headline(o, nil, "an instruction spir-v has no form of yet");
        text.source(o, m, e.unselected.location);
        function_name(o, m, e.unselected.function);
        ret Class.refused{};
    }
    if (sel e.untyped) {
        text.headline(o, nil, "a type spir-v holds no value of here");
        ret Class.refused{};
    }
    if (sel e.unpointed) {
        text.headline(o, nil, "a pointer parameter whose pointee no use states");
        text.source(o, m, e.unpointed.location);
        function_name(o, m, e.unpointed.function);
        ret Class.refused{};
    }
    if (sel e.reinterpreted) {
        text.headline(o, nil, "an access that reinterprets memory, which logical addressing cannot");
        text.source(o, m, e.reinterpreted.location);
        function_name(o, m, e.reinterpreted.function);
        ret Class.refused{};
    }
    if (sel e.variable) {
        text.headline(o, nil, "a pointer chosen at run time, which logical addressing reaches only through variable pointers");
        text.source(o, m, e.variable.location);
        function_name(o, m, e.variable.function);
        ret Class.refused{};
    }
    if (sel e.storage) {
        text.headline(o, nil, "a global used in another storage class than its own, or one its class holds no value of");
        text.symbol(o, module.name_of(m, m.globals.data[e.storage].data.name));
        ret Class.refused{};
    }
    if (sel e.slot) {
        text.headline(o, nil, "a stack slot whose pointer is not into the Function storage class");
        text.source(o, m, e.slot.location);
        function_name(o, m, e.slot.function);
        ret Class.refused{};
    }
    if (sel e.passed) {
        text.named(o, "a call passes a pointer into a storage class no call can pass", e.passed.class);
        text.source(o, m, e.passed.at.location);
        function_name(o, m, e.passed.at.function);
        ret Class.refused{};
    }
    if (sel e.mixed) {
        text.headline(o, nil, "a pointer parameter one call passes a whole block variable and another a member or an element of one, which SPIR-V types apart. split the function into one for each");
        text.source(o, m, e.mixed.at.location);
        function_name(o, m, e.mixed.callee);
        ret Class.refused{};
    }
    if (sel e.atomic) {
        text.named(o, "an atomic on memory of a storage class it may not operate on", e.atomic.class);
        text.source(o, m, e.atomic.at.location);
        function_name(o, m, e.atomic.at.function);
        ret Class.refused{};
    }
    if (sel e.entry) {
        text.headline(o, nil, "an entry point that takes or returns a value, or has no body");
        function_name(o, m, e.entry);
        ret Class.refused{};
    }
    if (sel e.workgroup) {
        text.headline(o, nil, "a workgroup dimension named by no 32-bit integer specialization constant of the module");
        function_name(o, m, e.workgroup);
        ret Class.refused{};
    }
    if (sel e.imported) {
        text.headline(o, nil, "an image that imports what no other object defines for it");
        if (sel e.imported.function) { function_name(o, m, e.imported.function); }
        if (sel e.imported.global)   { text.symbol(o, module.name_of(m, m.globals.data[e.imported.global].data.name)); }
        ret Class.refused{};
    }
    if (sel e.replaceable) {
        text.headline(o, nil, "a linkage unit that defines a replaceable symbol, which spir-v has no form of");
        if (sel e.replaceable.function) { function_name(o, m, e.replaceable.function); }
        if (sel e.replaceable.global)   { text.symbol(o, module.name_of(m, m.globals.data[e.replaceable.global].data.name)); }
        ret Class.refused{};
    }
    if (sel e.unmet) {
        text.named(o, "the module needs what the build's selection does not hold", e.unmet.name);
        ret Class.refused{};
    }
    if (sel e.interface) {
        interface(o, m, e.interface.rule);
        site(o, m, e.interface.site);
        ret Class.refused{};
    }
    if (sel e.pointee) {
        text.headline(o, nil, "memory a physical pointer reaches laid out against the rules of a storage buffer");
        text.source(o, m, e.pointee.at.location);
        function_name(o, m, e.pointee.at.function);
        ret Class.refused{};
    }
    if (sel e.readonly) {
        if (sel e.readonly.why.push) { text.headline(o, nil, "a store reaches a push-constant block, which only the host writes"); }
        or                           { text.headline(o, nil, "a store reaches a binding qualified readonly"); }
        site(o, m, e.readonly.site);
        global_name(o, m, e.readonly.binding);
        ret Class.refused{};
    }
    if (sel e.writeonly) {
        text.headline(o, nil, "a load reaches a binding qualified writeonly");
        site(o, m, e.writeonly.site);
        global_name(o, m, e.writeonly.binding);
        ret Class.refused{};
    }
    if (sel e.operand_value) {
        val v: spirv_error.Valued = e.operand_value;
        if (sel v.why.outside) { text.named(o, "an operand value the instruction does not admit, which admits", v.why.outside); }
        or                     { text.headline(o, nil, "an operand value whose operands the call does not pass"); }
        operand(o, m, v.operand);
        format.write_str(o.w, "  value ");
        format.write_u64(o.w, v.value::u64);
        if (sel v.why.brought) {
            format.write_str(o.w, ", which brings ");
            format.write_u64(o.w, v.why.brought.brings::u64);
            format.write_str(o.w, " operands where the call passes ");
            format.write_u64(o.w, v.why.brought.passed::u64);
        }
        format.write_str(o.w, "\n");
        ret Class.refused{};
    }
    if (sel e.not_constant) {
        text.headline(o, nil, "an operand that must be a constant and is not one");
        operand(o, m, e.not_constant);
        ret Class.refused{};
    }
    if (sel e.signature) {
        text.named(o, "an operand of a kind the instruction does not admit there, which takes", e.signature.admits);
        operand(o, m, e.signature.operand);
        ret Class.refused{};
    }
    if (sel e.executed) {
        text.named(o, "an instruction reached from a stage it does not execute in, which executes in", e.executed.models);
        text.source(o, m, e.executed.at.location);
        function_name(o, m, e.executed.entry);
        ret Class.refused{};
    }
    if (sel e.image) {
        text.named(o, "an image or image operands the instruction does not take, which takes", e.image.why);
        operand(o, m, e.image.operand);
        ret Class.refused{};
    }
    if (sel e.flow) {
        text.headline(o, nil, "a result used where its instruction's result cannot flow");
        text.source(o, m, e.flow.location);
        function_name(o, m, e.flow.function);
        ret Class.refused{};
    }
    if (sel e.unstructured) {
        text.headline(o, nil, "a function whose structure the emitter cannot follow");
        function_name(o, m, e.unstructured);
        ret Class.internal{};
    }
    if (sel e.recursion) {
        text.headline(o, nil, "a call an entry point's call tree holds back to the function that makes it, which spir-v has no call stack for");
        text.source(o, m, e.recursion.location);
        function_name(o, m, e.recursion.function);
        ret Class.refused{};
    }
    if (sel e.encoding) {
        text.headline_because(o, "masc refused the module", e.encoding.message);
        ret Class.internal{};
    }
    if (sel e.builder) {
        text.headline_because(o, "masc refused the module", e.builder.message);
        ret Class.internal{};
    }
    if (sel e.bounded) {
        text.named(o, "the build's selection holds what the target's environment can hold no way", e.bounded.atom);
        format.write_str(o.w, "  environment ");
        format.write_str(o.w, e.bounded.env);
        format.write_str(o.w, "\n");
        ret Class.refused{};
    }
    text.headline(o, nil, "the module was not compiled");
    ret Class.internal{};
}

# report a function refused as constant time: masc's one wording of the
# refusal, the function, where in its code it stands and the unchecked callee
# a secret reached where the call names one. it is refused input
fun timed(o: *Out, m: *module.Module, r: mct.Refused) Class {
    var words: vector.Vector[u8] = vector.init[u8](o.a);
    fin { vector.dnit[u8](?words); }
    var held:        masc_ct.Refusal = r.refusal;
    val err_spelled: err[A.Error]    = mct.spell(?held, ?words);
    text.lead(o, nil);
    if (sel err_spelled.err) { format.write_str(o.w, masc_ct.message(?held)); }
    or                       { text.view(o, View{data: words.data, len: words.len}); }
    format.write_str(o.w, "\n");
    text.source(o, m, r.location);
    text.symbol(o, module.name_of(m, m.functions.data[r.function].data.name));
    located(o, r.at);
    val opt_callee: opt[id.Function] = r.callee;
    if (sel opt_callee.some) {
        format.write_str(o.w, "  callee @");
        text.view(o, module.name_of(m, m.functions.data[opt_callee.some].data.name));
        format.write_str(o.w, "\n");
    }
    ret Class.refused{};
}

# where in a function's code a constant-time refusal stands, `at ...`
fun located(o: *Out, at: mct.Where) {
    if (sel at.whole) { ret; }
    format.write_str(o.w, "  at ");
    if (sel at.instruction) {
        format.write_str(o.w, "instruction ");
        format.write_u64(o.w, at.instruction::u64);
    }
    if (sel at.offset) {
        format.write_str(o.w, "byte ");
        format.write_u64(o.w, at.offset);
        format.write_str(o.w, " of its code");
    }
    format.write_str(o.w, "\n");
}

# report a constant-time function whose code the walk could not follow on a
# set that classifies its rows, so the requirement is not met. it is refused
# input
fun unfollowed(o: *Out, m: *module.Module, u: mct.Unfollowed) Class {
    text.headline(o, nil, "constant time required of code the walk of its instructions could not follow");
    text.tagged(o, "why", u.unread.message);
    text.source(o, m, u.location);
    text.symbol(o, module.name_of(m, m.functions.data[u.function].data.name));
    located(o, mct.Where.offset{u.unread.offset});
    ret Class.refused{};
}

# report a hard constant-time function whose code needs a timing mode the build does not guarantee, naming the
# feature that would guarantee it, or a set that guarantees no instruction's timing. it is refused input
fun unguaranteed(o: *Out, m: *module.Module, u: mct.Unguaranteed) Class {
    text.headline(o, nil, "hard constant time required of code the build's target does not guarantee the timing of");
    text.source(o, m, u.location);
    text.symbol(o, module.name_of(m, m.functions.data[u.function].data.name));
    if (u.needs == mct.NO_NEEDS) {
        format.write_str(o.w, "  the target's instruction set guarantees no instruction's timing\n");
        ret Class.refused{};
    }
    var words: vector.Vector[u8] = vector.init[u8](o.a);
    fin { vector.dnit[u8](?words); }
    val err_spelled: err[A.Error] = mct.missing(u.set, u.needs, ?words);
    format.write_str(o.w, "  missing ");
    if (sel err_spelled.err) { format.write_str(o.w, "a timing mode"); }
    or                       { text.view(o, View{data: words.data, len: words.len}); }
    format.write_str(o.w, "\n");
    ret Class.refused{};
}

# report a constant-time function whose own frame reads a slot no store reaches first, which its walk would take as
# public: the function and the slot's alloca, by its instruction and the name of its address where it has one. it is
# refused input
fun stale(o: *Out, m: *module.Module, s: mct.Stale) Class {
    text.headline(o, nil, "constant time required of a function whose own frame reads a slot no store reaches first");
    text.source(o, m, s.location);
    text.symbol(o, module.name_of(m, m.functions.data[s.function].data.name));
    located(o, s.at);
    if (sel s.at.instruction) {
        val b: *function.Body               = ?m.functions.data[s.function].body;
        val d: *instruction.InstructionData = ?b.instructions.data[s.at.instruction::usize];
        if (d.results.len > 0) {
            val opt_name: opt[View] = b.values.data[d.results.data[0]].name;
            if (sel opt_name.some) {
                format.write_str(o.w, "  slot ");
                text.view(o, opt_name.some);
                format.write_str(o.w, "\n");
            }
        }
    }
    ret Class.refused{};
}

# report a relocation the target's object format does not map: the module
# needs what the target cannot write, so it is refused input, named by the
# symbol it aims at and by mink's failure, which names the kind and the format
fun unmapped(o: *Out, m: *module.Module, u: handover.Unmapped) Class {
    text.headline(o, nil, "the target's object format maps no relocation of a kind the module needs");
    if (sel u.symbol.some) {
        val s: id.Symbol = u.symbol.some;
        if (sel s.function) { text.symbol(o, module.name_of(m, m.functions.data[s.function].data.name)); }
        or (sel s.global)   { text.symbol(o, module.name_of(m, m.globals.data[s.global].data.name)); }
    }
    if (sel u.refusal.detail.object) { text.failure(o, o.a, u.refusal.detail.object); }
    ret Class.refused{};
}

# report an object masc refused to list, which is internal: the construct the
# listing has no form of in masc's words, with where in the object it was found
# and the printer's refusal when an instruction's values have no spelling, and
# the function or global it is about
fun unlistable(o: *Out, m: *module.Module, u: handover.Unlisted) Class {
    text.headline(o, nil, "masc cannot list the object it made");
    text.failure(o, o.a, u.refusal.failure);
    if (sel u.symbol.some) {
        val s: id.Symbol = u.symbol.some;
        if (sel s.function) { text.symbol(o, module.name_of(m, m.functions.data[s.function].data.name)); }
        or (sel s.global)   { text.symbol(o, module.name_of(m, m.globals.data[s.global].data.name)); }
    }
    ret Class.internal{};
}

# report a symbol the module marks exported that the object refused to export,
# which is internal, as the export states nothing past its symbol and name
fun unexported(o: *Out, m: *module.Module, u: handover.Unexported) Class {
    text.headline(o, nil, "the object refused to export a symbol the module marks exported");
    val s: id.Symbol = u.symbol;
    if (sel s.function)     { text.symbol(o, module.name_of(m, m.functions.data[s.function].data.name)); }
    or (sel s.global)       { text.symbol(o, module.name_of(m, m.globals.data[s.global].data.name)); }
    if (sel u.failure.some) { text.failure(o, o.a, u.failure.some); }
    ret Class.internal{};
}

# report an object masc or mink did not make or write, the one report every
# such refusal goes through: its headline, masc's message where masc refused
# it, and mink's failure where mink refused it, so no refusal is reported
# without what refused it
fun unmade(o: *Out, headline: str, message: opt[str], why: opt[Fail], code: Class) Class {
    text.headline(o, nil, headline);
    if (sel message.some) { text.tagged(o, "masc", message.some); }
    if (sel why.some)     { text.failure(o, o.a, why.some); }
    ret code;
}

# report an object or image that was not written, each cause by what refused
# it: a link or a format mink refused the object in is named by mink's
# failure, refused input where the format has no form for what the module
# states, as a protected symbol in mach-o, the environment's where the host
# refused it, and internal otherwise. output that took only part of the bytes
# is the environment's and says how many it took
fun unwritten(o: *Out, e: family.Error) Class {
    val opt_none: opt[str] = opt[str].none{};
    if (sel e.link) {
        val f:    Fail  = e.link;
        var code: Class = Class.internal{};
        if (sel f.cause.unsupported || sel f.cause.malformed) { code = Class.refused{}; }
        or (sel f.cause.refused || sel f.cause.io)            { code = Class.environment{}; }
        ret unmade(o, "the image was not written, as mink's link refused the object", opt_none, opt[Fail].some{f}, code);
    }
    if (sel e.format) {
        val f:    Fail  = e.format;
        var code: Class = Class.internal{};
        if (sel f.cause.unsupported) { code = Class.refused{}; }
        or (sel f.cause.refused)     { code = Class.environment{}; }
        ret unmade(o, "the object was not written, as mink refused it in the format of the target's system", opt_none, opt[Fail].some{f}, code);
    }
    val code: Class = unmade(o, "the object was not written, as the output took only part of its bytes", opt_none, opt[Fail].none{}, Class.environment{});
    if (!(sel e.write)) { ret code; }
    val w: io.WriteError = e.write;
    if (sel w.native) {
        format.write_str(o.w, "  written ");
        format.write_u64(o.w, w.native.written::u64);
        format.write_str(o.w, " bytes\n");
    }
    ret code;
}

# report a failed run: a module the verifier refuses and a pass that cannot
# rewrite the module are refused input, a refusal of storage is the
# environment's, and anything else is an internal failure of the pipeline
pub fun pass_failed(o: *Out, m: *module.Module, e: pass_failure.Error) Class {
    if (sel e.input) { ret refused_verify(o, m, e.input); }
    if (sel e.refused) {
        val r: pass_failure.Refusal = e.refused;
        text.named(o, "a pass refused the module", r.pass);
        if (sel r.why.slot) { text.source(o, m, r.why.slot.location); }
        val opt_function: opt[Function] = r.function;
        if (sel opt_function.some) {
            if (opt_function.some::usize < m.functions.len) { text.symbol(o, module.name_of(m, m.functions.data[opt_function.some].data.name)); }
        }
        why(o, m, r.why);
        ret Class.refused{};
    }
    if (sel e.oblivious) {
        text.named(o, "a pass left a function that requires constant time holding a secret where it may hold none", e.oblivious.pass);
        timed(o, m, e.oblivious.refused);
        ret Class.internal{};
    }
    if (sel e.unverified) {
        text.named(o, "a pass left the module invalid", e.unverified.pass);
        val v: verify_failure.Error = e.unverified.error;
        if (sel v.refused) {
            detail(o, m, v.refused);
            ret Class.internal{};
        }
        text.tagged(o, "why", "the verifier had no storage");
        ret Class.environment{};
    }
    if (sel e.foreign) {
        text.headline(o, nil, "the build was opened for another target than the run's");
        ret Class.internal{};
    }
    if (sel e.schedule) {
        text.headline(o, nil, "the pass schedule is malformed");
        ret Class.internal{};
    }
    text.headline(o, nil, "out of memory");
    ret Class.environment{};
}

# why a pass refused, `why ...`, with what the refusal names
pub fun why(o: *Out, m: *module.Module, w: refusal.Error) {
    if (sel w.alloc)      { text.tagged(o, "why", "the allocator refused storage"); }
    or (sel w.ir)         { refused_ir(o, m, w.ir); }
    or (sel w.cfg)        { refused_cfg(o, m, w.cfg); }
    or (sel w.build)      { refused_build(o, m, w.build); }
    or (sel w.reason)     { text.tagged(o, "why", w.reason); }
    or (sel w.convention) { text.tagged(o, "why", "a call, an entry or a return was not classified"); }
    or (sel w.pieces)     { text.tagged(o, "why", "an assignment is not carried in pieces of the ir"); }
    or (sel w.text) {
        format.write_str(o.w, "  why a function the pass delivers in the text form was not read, at line ");
        format.write_u64(o.w, w.text.line::u64);
        format.write_str(o.w, ", column ");
        format.write_u64(o.w, w.text.column::u64);
        format.write_str(o.w, " of its text\n");
    }
    or (sel w.timing) {
        var held:  ct.Refusal        = ct.refusal(w.timing.reason, w.timing.operand);
        var words: vector.Vector[u8] = vector.init[u8](o.a);
        fin { vector.dnit[u8](?words); }
        format.write_str(o.w, "  why ");
        val err_spelled: err[A.Error] = mct.spell(?held, ?words);
        if (sel err_spelled.err) { format.write_str(o.w, ct.message(?held)); }
        or                       { text.view(o, View{data: words.data, len: words.len}); }
        format.write_str(o.w, "\n");
    }
    or (sel w.condition) { text.tagged(o, "why", "a capability's condition was not read on the build's machine"); }
    or (sel w.unheld) {
        var p: printer.Printer = printer.init(o.w, m);
        fin { printer.dnit(?p); }
        format.write_str(o.w, "  why a value of ");
        printer.ty(?p, w.unheld);
        format.write_str(o.w, ", whose format the target holds no unit for and no legalisation computes yet\n");
    }
    or (sel w.threaded) {
        text.tagged(o, "why", "a thread-local global on a target whose build runs threads, which reach no thread-local variable yet");
        global_name(o, m, w.threaded);
    }
    or (sel w.exported) {
        text.tagged(o, "why", "an exported thread-local global, which no image of the target exports as a thread-local variable");
        format.write_str(o.w, "  target ");
        format.write_str(o.w, w.exported.arch);
        format.write_str(o.w, "-");
        format.write_str(o.w, w.exported.sys);
        format.write_str(o.w, "\n");
        global_name(o, m, w.exported.global);
    }
    or (sel w.absent) {
        text.tagged(o, "why", "a thread-local global, on a system that keeps no thread-local storage");
        global_name(o, m, w.absent);
    }
    or (sel w.resolved) {
        text.tagged(o, "why", "a constant-time function reaches a thread-local global through the runtime's resolver, which the constant-time check cannot see into");
        global_name(o, m, w.resolved.global);
    }
    or (sel w.specialized) {
        format.write_str(o.w, "  why specialization constant ");
        format.write_u64(o.w, w.specialized::u64);
        format.write_str(o.w, ", on a target that holds none\n");
    }
    or (sel w.slot) {
        format.write_str(o.w, "  why a slot the target holds no pointer in stays in memory, as ");
        format.write_str(o.w, kept(w.slot.kept));
        format.write_str(o.w, "\n  at instruction ");
        format.write_u64(o.w, w.slot.slot::u64);
        format.write_str(o.w, " of the body\n");
    }
    or (sel w.taken) {
        format.write_str(o.w, "  why a symbol of the module has the name mirl gives ");
        format.write_str(o.w, w.taken.wanted);
        format.write_str(o.w, ", and mirl never takes it for its own\n");
        val s: Symbol = w.taken.symbol;
        if (sel s.global) { global_name(o, m, s.global); }
        or (sel s.function) {
            if (s.function::usize < m.functions.len) { text.symbol(o, module.name_of(m, m.functions.data[s.function].data.name)); }
        }
    }
    or (sel w.unneeded) {
        val rows: Slice[cache.Row] = analysis.rows();
        var row:  str              = "an unregistered analysis";
        if (w.unneeded::usize < rows.size) { row = rows.data[w.unneeded].name; }
        text.named(o, "why the pass read an analysis its record does not need", row);
    }
}

# why a slot stays in memory
fun kept(k: refusal.Kept) str {
    if (sel k.escapes)  { ret "its address is used other than by loads and stores at its type"; }
    if (sel k.held)     { ret "a kept or volatile access holds it in memory"; }
    if (sel k.merged)   { ret "the pointers stored to it are merged where paths join, which only variable pointers carry"; }
    if (sel k.unstored) { ret "a load no store reaches, which no pointer stands for"; }
    ret "a load would read a value whose secrecy differs from its own";
}

# report a build that was not opened, and the exit code: a target mirl
# carries no convention for, an extension the instruction set does not know,
# extensions added to a target with no baseline and added extensions that
# conflict are refused input, a refusal of storage is the environment's, and
# anything else is an internal failure
# ---
# o:     where the words go
# t:     the target the build was to open for
# added: the extensions the build added
# e:     why the build was not opened
# ret:   the class of the failure
pub fun unopened(o: *Out, t: *Target, added: Slice[str], e: basis.Error) Class {
    if (sel e.convention) {
        if (sel e.convention.uncarried) {
            named_target(o, "mirl carries no calling convention for the target", t);
            ret Class.refused{};
        }
    }
    if (sel e.unknown) {
        text.named(o, "the instruction set of the target knows no extension named", e.unknown);
        ret Class.refused{};
    }
    if (sel e.baseline && added.size > 0) {
        named_target(o, "extensions are added to a target that states no baseline", t);
        ret Class.refused{};
    }
    if (sel e.extensions) {
        if (sel e.extensions.conflict) {
            if (added.size > 0) { ret conflicting(o, t, e.extensions.conflict); }
        }
    }
    text.lead(o, nil);
    format.write_str(o.w, "the build of the target was not opened, as ");
    format.write_str(o.w, basis.fact(e));
    format.write_str(o.w, " '");
    record.write_name(o.w, o.a, t);
    format.write_str(o.w, "'\n");
    if (sel e.alloc) { ret Class.environment{}; }
    ret Class.internal{};
}

# report an instruction whose opcode row the target does not admit, by its
# opcode, with the exit code: refused input when the module held it, and
# internal when the schedule left it
pub fun foreign(o: *Out, what: str, f: family.Foreign, code: Class) Class {
    text.headline(o, nil, what);
    text.named(o, "the opcode is", f.row.name);
    ret code;
}

# report two added extensions the selection cannot hold together, by their
# names in the target's instruction set, as refused input
fun conflicting(o: *Out, t: *Target, pair: extension.Conflict) Class {
    val res_set: res[*mset.Set, basis.Error] = basis.set_of(t);
    if (sel res_set.err) {
        named_target(o, "the build of the target was not opened", t);
        if (sel res_set.err.alloc) { ret Class.environment{}; }
        ret Class.internal{};
    }
    val c: *extension.Catalog = res_set.ok.extensions;
    text.lead(o, nil);
    format.write_str(o.w, "the extensions '");
    format.write_str(o.w, c.extensions[pair.a].name);
    format.write_str(o.w, "' and '");
    format.write_str(o.w, c.extensions[pair.b].name);
    format.write_str(o.w, "' cannot be selected together\n");
    ret Class.refused{};
}

# report a failure that names the target it failed on, by its derived name
fun named_target(o: *Out, message: str, t: *Target) {
    text.lead(o, nil);
    format.write_str(o.w, message);
    format.write_str(o.w, " '");
    record.write_name(o.w, o.a, t);
    format.write_str(o.w, "'\n");
}

# the name of the rule a verifier refusal broke
fun rule_name(f: verify_failure.Failure) str {
    val opt_row: opt[verify_table.Row] = verify_table.row(f.rule);
    if (sel opt_row.some) { ret opt_row.some.name; }
    ret "rule";
}

# report a verifier refusal: the rule it broke, the fact, the source place of
# the instruction it names, and the symbol it is in
pub fun refused_verify(o: *Out, m: *module.Module, f: verify_failure.Failure) Class {
    text.rule(o, rule_name(f), f.what);
    text.in_file(o, o.file);
    text.source(o, m, f.at.location);
    text.symbol(o, f.at.name);
    text.op(o, f.at.set, f.at.op);
    text.form(o, f.at.form);
    text.extension(o, f.at.extension);
    ret Class.refused{};
}

# a verifier refusal under another headline: the rule, the fact, the source
# place of the instruction it names, and the symbol it is in
pub fun detail(o: *Out, m: *module.Module, f: verify_failure.Failure) {
    text.tagged(o, "rule", rule_name(f));
    text.tagged(o, "why", f.what);
    text.source(o, m, f.at.location);
    text.symbol(o, f.at.name);
    text.op(o, f.at.set, f.at.op);
    text.form(o, f.at.form);
    text.extension(o, f.at.extension);
}

# why a graph edit or a copy was refused, `why ...`, down to the module's refusal under it
fun refused_cfg(o: *Out, m: *module.Module, e: cfg.Error) {
    if (sel e.ir)    { ret refused_ir(o, m, e.ir); }
    if (sel e.build) { ret refused_build(o, m, e.build); }
    format.write_str(o.w, "  why a graph edit or a copy was refused, at ");
    if (sel e.position) {
        format.write_str(o.w, "position ");
        format.write_u64(o.w, e.position::u64);
        format.write_str(o.w, ", which the block holds no instruction at\n");
        ret;
    }
    if (sel e.merge) {
        format.write_str(o.w, "block ");
        format.write_u64(o.w, e.merge::u64);
        format.write_str(o.w, ", which exactly one unconditional branch from another block does not enter\n");
        ret;
    }
    if (sel e.undefined) {
        format.write_str(o.w, "value ");
        format.write_u64(o.w, e.undefined::u64);
        format.write_str(o.w, ", defined in the region and used where no copy of it can have been made first\n");
    }
}

# why the builder refused a call, `why ...`, down to the module's refusal under it
fun refused_build(o: *Out, m: *module.Module, e: build_failure.Error) {
    val stopped: build_error.Error = e.error;
    if (sel stopped.ir) { ret refused_ir(o, m, stopped.ir); }
    format.write_str(o.w, "  why the builder refused ");
    if (sel stopped.function) { format.write_str(o.w, "an instruction, block or constant value asked for with no function entered"); }
    or (sel stopped.terminated) {
        format.write_str(o.w, "to build at the end of block ");
        format.write_u64(o.w, stopped.terminated::u64);
        format.write_str(o.w, ", which already ends in a terminator");
    }
    or (sel stopped.position) {
        format.write_str(o.w, "insertion position ");
        format.write_u64(o.w, stopped.position::u64);
        format.write_str(o.w, ", which the block does not have");
    }
    or (sel stopped.terminator) { format.write_str(o.w, "a terminator where it cannot end its block"); }
    or (sel stopped.result) {
        format.write_str(o.w, "result position ");
        format.write_u64(o.w, stopped.result::u64);
        format.write_str(o.w, ", which the instruction does not have");
    }
    or { format.write_str(o.w, "a binding asked for with the cursor in no block"); }
    format.write_str(o.w, "\n");
}

# why the module or a body refused an edit or a read, `why ...`, naming the value, block, instruction, symbol
# or type its case holds
fun refused_ir(o: *Out, m: *module.Module, e: module.Error) {
    format.write_str(o.w, "  why the module refused an edit or a read: ");
    if (sel e.alloc)       { format.write_str(o.w, "the allocator refused storage"); }
    or (sel e.types)       { format.write_str(o.w, "the type table refused a read"); }
    or (sel e.typing)      { format.write_str(o.w, "an instruction's opcode row refused it"); }
    or (sel e.name)        { format.write_str(o.w, "an empty name"); }
    or (sel e.taken)       { format.write_str(o.w, "a symbol name a function or global already has"); }
    or (sel e.function)    { numbered(o, "function ", e.function::u64, ", which the module did not give out"); }
    or (sel e.global)      { numbered(o, "global ", e.global::u64, ", which the module did not give out"); }
    or (sel e.constant)    { numbered(o, "constant ", e.constant::u64, ", which the module did not give out"); }
    or (sel e.specialized) { numbered(o, "specialization constant ", e.specialized::u64, ", whose bits are its consumer's to set, read as a number"); }
    or (sel e.bindings)    { format.write_str(o.w, "a binding list the module did not give out"); }
    or (sel e.publics)     { format.write_str(o.w, "a public range list the module did not give out"); }
    or (sel e.expression)  { format.write_str(o.w, "a salvage expression the module did not give out"); }
    or (sel e.step)        { numbered(o, "salvage step ", e.step::u64, ", of a kind with no row or with an argument its row does not take"); }
    or (sel e.binding)     { format.write_str(o.w, "a binding the debug table did not give out"); }
    or (sel e.point)       { numbered(o, "record position ", e.point::u64, ", which the block does not have"); }
    or (sel e.bound)       { numbered(o, "value ", e.bound::u64, ", which a record outside what is taken back reads"); }
    or (sel e.block)       { numbered(o, "block ", e.block::u64, ", which the body did not give out"); }
    or (sel e.value)       { numbered(o, "value ", e.value::u64, ", which the body did not give out"); }
    or (sel e.instruction) { numbered(o, "instruction ", e.instruction::u64, ", which the body did not give out"); }
    or (sel e.linkage)     { format.write_str(o.w, "a linkage that is no row of mink's symbol bindings"); }
    or (sel e.visibility)  { format.write_str(o.w, "a visibility that is no row of mink's symbol visibilities"); }
    or (sel e.section)     { format.write_str(o.w, "a section kind that is no row of mink's section kinds"); }
    or (sel e.mismatch) {
        var p: printer.Printer = printer.init(o.w, m);
        fin { printer.dnit(?p); }
        format.write_str(o.w, "the type ");
        printer.ty(?p, e.mismatch);
        format.write_str(o.w, ", which is not the type or kind the request needs");
    }
    or (sel e.alignment)  { numbered(o, "alignment ", e.alignment, ", which is not a power of two"); }
    or (sel e.words)      { format.write_str(o.w, "a number whose words do not fit its type's width"); }
    or (sel e.elements)   { numbered(o, "an aggregate of ", e.elements::u64, " elements, not what its type holds"); }
    or (sel e.element)    { numbered(o, "aggregate element ", e.element::u64, ", which is not of its member's type"); }
    or (sel e.incoming)   { numbered(o, "", e.incoming::u64, " incoming arguments, not one per edge into the block"); }
    or (sel e.parameter)  { numbered(o, "parameter ", e.parameter::u64, ", which the block does not have"); }
    or (sel e.used)       { numbered(o, "value ", e.used::u64, ", which still has uses"); }
    or (sel e.secret)     { numbered(o, "value ", e.secret::u64, ", secret, where only a public value may stand"); }
    or (sel e.placed)     { numbered(o, "instruction ", e.placed::u64, ", already placed in a block"); }
    or (sel e.detached)   { numbered(o, "instruction ", e.detached::u64, ", placed in no block"); }
    or (sel e.erased)     { numbered(o, "instruction ", e.erased::u64, ", taken out of its body"); }
    or (sel e.results)    { numbered(o, "an instruction of ", e.results::u64, " results, not as many as the one it replaces"); }
    or (sel e.circular)   { numbered(o, "value ", e.circular::u64, ", a result of the instruction its replacement replaces"); }
    or (sel e.edge)       { numbered(o, "edge ", e.edge::u64, ", which the instruction does not have"); }
    or (sel e.position)   { numbered(o, "position ", e.position::u64, ", which the block does not have"); }
    or (sel e.arguments)  { numbered(o, "", e.arguments::u64, " arguments, not one per parameter of the target"); }
    or (sel e.removed)    { numbered(o, "block ", e.removed::u64, ", taken out of its body"); }
    or (sel e.entry)      { format.write_str(o.w, "the entry block, which stays in its body"); }
    or (sel e.reached)    { numbered(o, "block ", e.reached::u64, ", which an edge still enters"); }
    or (sel e.occupied)   { numbered(o, "block ", e.occupied::u64, ", which still holds instructions"); }
    or (sel e.lowered)    { numbered(o, "instruction ", e.lowered::u64, ", whose secrecy mark the edit would lower"); }
    or (sel e.unkept)     { numbered(o, "instruction ", e.unkept::u64, ", whose kept mark the edit would take off"); }
    or (sel e.same)       { numbered(o, "block ", e.same::u64, ", asked to take instructions from itself"); }
    or (sel e.terminator) { numbered(o, "instruction ", e.terminator::u64, ", which ends its block and the edit would move"); }
    or (sel e.piece)      { numbered(o, "a record split at part ", e.piece::u64, ", into no part or parts that share a bit"); }
    or (sel e.secrecy)    { format.write_str(o.w, "secret ranges or parameters not stated as they may be"); }
    or                    { format.write_str(o.w, "a signature's convention row, which the target's architecture has no row of that name for"); }
    format.write_str(o.w, "\n");
}

# a fact that names one number, `lead<n>tail`
fun numbered(o: *Out, lead: str, n: u64, tail: str) {
    format.write_str(o.w, lead);
    format.write_u64(o.w, n);
    format.write_str(o.w, tail);
}
