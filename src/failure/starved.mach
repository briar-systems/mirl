# the allocator's refusal a failure's chain ends at, wherever it stands
#
# the one rule a failure's class follows: storage the allocator refused is the environment's, so a tool exits
# as for a machine that ran out, never as for a defect or refused input. each error type that may hold such a
# refusal answers it through its own `starved`, and the cases of the outer errors of a compilation and of a
# run of the pass schedule, which no lower error carries, are read here, so a case that holds one is read where
# it is added

use std.allocator;
use std.types.option.opt;

use mink.base.fail.Fail;

use build_refusal: masc.build.refusal;
use masc.core.extension;

use mirl.ir.module;
use type_table: mirl.ir.type.table;
use mirl.legal.abi;
use mcompile: mirl.machine.compile;
use mirl.machine.emit.data;
use pass_failure: mirl.pass.failure;
use mirl.pass.refusal;
use mirl.target.abi.call;
use mirl.target.basis;
use mirl.target.family;
use spirv_error:    mirl.target.spirv.error;
use wasm_error:     mirl.target.wasm.error;
use verify_failure: mirl.verify.failure;

# the allocator's refusal a compilation's failure ends at
# ---
# e:   the compilation's failure
# ret: the allocator's refusal, none for a failure that does not end at one
pub fun compiled(e: family.Error) opt[allocator.Error] {
    if (sel e.alloc)    { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.open)     { ret basis.starved(e.open); }
    if (sel e.schedule) { ret scheduled(e.schedule); }
    if (sel e.register) { ret mcompile.starved(e.register.error); }
    if (sel e.wasm)     { ret of_wasm(e.wasm); }
    if (sel e.spirv)    { ret of_spirv(e.spirv); }
    if (sel e.format)   { ret of_fail(e.format); }
    if (sel e.link)     { ret of_fail(e.link); }
    ret opt[allocator.Error].none{};
}

# the allocator's refusal a failed run of the pass schedule ends at
# ---
# e:   the run's failure
# ret: the allocator's refusal, none for a failure that does not end at one
pub fun scheduled(e: pass_failure.Error) opt[allocator.Error] {
    if (sel e.alloc)      { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.refused)    { ret refusal.starved(e.refused.why); }
    if (sel e.unverified) { ret of_verify(e.unverified.error); }
    ret opt[allocator.Error].none{};
}

fun of_verify(e: verify_failure.Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    ret opt[allocator.Error].none{};
}

fun of_fail(f: Fail) opt[allocator.Error] {
    if (sel f.cause.refused) { ret opt[allocator.Error].some{f.cause.refused}; }
    ret opt[allocator.Error].none{};
}

fun of_extension(e: extension.Error) opt[allocator.Error] {
    if (sel e.memory) { ret opt[allocator.Error].some{e.memory}; }
    ret opt[allocator.Error].none{};
}

fun of_data(e: data.Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.ir)    { ret module.starved(e.ir); }
    ret opt[allocator.Error].none{};
}

fun of_abi(e: abi.Error) opt[allocator.Error] {
    if (sel e.signature) { ret type_table.starved(e.signature); }
    if (sel e.classify)  { ret call.starved(e.classify); }
    ret opt[allocator.Error].none{};
}

fun of_wasm(e: wasm_error.Error) opt[allocator.Error] {
    if (sel e.alloc)     { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.ir)        { ret module.starved(e.ir); }
    if (sel e.analysis)  { ret refusal.starved(e.analysis); }
    if (sel e.placement) { ret of_abi(e.placement); }
    if (sel e.image)     { ret of_data(e.image); }
    if (sel e.object)    { ret of_fail(e.object); }
    ret opt[allocator.Error].none{};
}

fun of_spirv(e: spirv_error.Error) opt[allocator.Error] {
    if (sel e.alloc)     { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.ir)        { ret module.starved(e.ir); }
    if (sel e.basis)     { ret basis.starved(e.basis); }
    if (sel e.analysis)  { ret refusal.starved(e.analysis); }
    if (sel e.builder)   { ret build_refusal.starved(e.builder); }
    if (sel e.container) { ret of_fail(e.container); }
    if (sel e.bound)     { ret of_extension(e.bound); }
    ret opt[allocator.Error].none{};
}
