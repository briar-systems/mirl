# where a source variable's value is: the one tag every debug producer reads
#
# the tag is named `Where`, apart from the ir's source location
# (`mirl.ir.debug.record.Location`), so no file names the two alike.
#
# a value binding record of the ir reads one, through `of_record`, and a
# lowering below the ir gives each variable one per range of its code. a kind is a case of the tag,
# and a producer states the kinds it writes as a set, so a location of a kind
# it does not state is refused by its kind, never written as another.
#
# unavailable is no location at all: the value is gone, and every producer
# writes it as optimised out, so no set needs to state it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.point;
use mirl.ir.point.Expression;
use mirl.ir.point.Reads;
use mirl.ir.type.table.Type;
use mirl.machine.frame.record.Offset;

use rf: masc.core.register;

# one part of a variable held in several places
# ---
# location:   where the part is, never itself pieces
# bits:       the bits of the variable it holds, the parts in order from the
#             variable's lowest bit
# expression: the salvage steps that give the part from what its location
#             holds, PLAIN for that as it is
# from:       the ir type of what its location holds, which the steps start
#             from
pub rec Piece {
    location:   Where;
    bits:       u64;
    expression: Expression;
    from:       Type;
}

# where a variable's value is
#
# unavailable is the first case, so a zeroed location names nothing.
# ---
# unavailable: nowhere, since the value is gone
# register:    in a register, by masc's identity, which names a part of a
#              wider register by the part's own row
# slot:        in memory at an offset from the frame base its family states:
#              a register machine's frame base, or the variable spir-v
#              declares for the storage
# local:       in the webassembly local of this index
# global:      in the global of the module that symbol names
# operand:     on the webassembly operand stack, at this depth from the top
# ssa:         the ir value of this id, which a family that keeps ssa ids
#              names by its own
# constant:    the constant of the module of this id
# pieces:      in parts, each at its own location, valid as long as whoever
#              made the location keeps them
pub tag Where: u8 {
    unavailable;
    register: rf.Id;
    slot:     Offset;
    local:    u32;
    global:   Symbol;
    operand:  u32;
    ssa:      Value;
    constant: Constant;
    pieces:   Slice[Piece];
}

# a kind of location, the case of the tag it is, as one bit so a set of
# kinds is the kinds joined
pub def Kind: u16;

pub val UNAVAILABLE: Kind = 0x1;
pub val REGISTER:    Kind = 0x2;
pub val SLOT:        Kind = 0x4;
pub val LOCAL:       Kind = 0x8;
pub val GLOBAL:      Kind = 0x10;
pub val OPERAND:     Kind = 0x20;
pub val SSA:         Kind = 0x40;
pub val CONSTANT:    Kind = 0x80;
pub val PIECES:      Kind = 0x100;

# a set of kinds, the bits of its kinds joined
pub def Kinds: u16;

# the kind of a location
pub fun kind(l: Where) Kind {
    if (sel l.unavailable) { ret UNAVAILABLE; }
    if (sel l.register)    { ret REGISTER; }
    if (sel l.slot)        { ret SLOT; }
    if (sel l.local)       { ret LOCAL; }
    if (sel l.global)      { ret GLOBAL; }
    if (sel l.operand)     { ret OPERAND; }
    if (sel l.ssa)         { ret SSA; }
    if (sel l.constant)    { ret CONSTANT; }
    ret PIECES;
}

# whether a set holds a kind, unavailable held by every set
pub fun holds(set: Kinds, k: Kind) bool {
    ret ((set | UNAVAILABLE) & k) != 0;
}

# whether two locations name one place, pieces alike part by part
pub fun same(x: Where, y: Where) bool {
    if (sel x.unavailable) { ret sel y.unavailable; }
    if (sel x.register)    { ret sel y.register && x.register == y.register; }
    if (sel x.slot) {
        if (!(sel y.slot)) { ret false; }
        ret x.slot.fixed == y.slot.fixed && x.slot.per == y.slot.per && x.slot.scale == y.slot.scale;
    }
    if (sel x.local)    { ret sel y.local && x.local == y.local; }
    if (sel x.global)   { ret sel y.global && same_symbol(x.global, y.global); }
    if (sel x.operand)  { ret sel y.operand && x.operand == y.operand; }
    if (sel x.ssa)      { ret sel y.ssa && x.ssa == y.ssa; }
    if (sel x.constant) { ret sel y.constant && x.constant == y.constant; }
    if (sel x.pieces) {
        if (sel y.pieces) { ret same_pieces(x.pieces, y.pieces); }
    }
    ret false;
}

fun same_symbol(x: Symbol, y: Symbol) bool {
    if (sel x.function) { ret sel y.function && x.function == y.function; }
    ret sel y.global && x.global == y.global;
}

fun same_pieces(x: Slice[Piece], y: Slice[Piece]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        val p: *Piece = ?x.data[i];
        val q: *Piece = ?y.data[i];
        if (p.bits != q.bits || p.expression != q.expression || p.from != q.from) { ret false; }
        if (!same(p.location, q.location))                                       { ret false; }
        i = i + 1;
    }
    ret true;
}

# the location a value binding record of the ir reads, its salvage expression
# read from the record beside it
#
# a value the record reads is ssa, a constant's value as well, since a family
# that keeps ssa ids names a constant by its own id. a lowering below the ir
# gives a constant the constant kind where its family writes that.
pub fun of_record(r: Reads) Where {
    val v: opt[Value] = point.read(r);
    if (sel v.some) { ret Where.ssa{v.some}; }
    ret Where.unavailable{};
}
