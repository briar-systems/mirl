# the debug producer rows: the kinds of location each producer writes
#
# a producer reads its own row and admits each location through it before it
# writes one, so a kind it does not state is refused, never approximated.

use mirl.debug.location.CONSTANT;
use mirl.debug.location.GLOBAL;
use mirl.debug.location.LOCAL;
use mirl.debug.location.OPERAND;
use mirl.debug.location.PIECES;
use mirl.debug.location.REGISTER;
use mirl.debug.location.SLOT;
use mirl.debug.location.SSA;
use mirl.debug.producer.Producer;

# dwarf 5: registers, frame slots, constants and pieces, and the webassembly
# local, global and operand stack locations
pub val DWARF: Producer = Producer{name: "dwarf", writes: REGISTER | SLOT | CONSTANT | PIECES | LOCAL | GLOBAL | OPERAND};

# codeview: registers and frame slots
pub val CODEVIEW: Producer = Producer{name: "codeview", writes: REGISTER | SLOT};

# the spir-v non-semantic debug info: ssa ids, and slots as the variable an
# OpVariable declares
pub val SPIRV: Producer = Producer{name: "spirv", writes: SSA | SLOT};
