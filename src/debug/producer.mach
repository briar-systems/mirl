# what a debug producer declares: the kinds of location it writes
#
# a producer is one row, and its kinds are read from the row and never from
# which format it writes, so a new producer is a new row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.size.usize;
use std.types.string.str;

#[testing]
use std.collections.slice.Slice;

use mirl.debug.location;
use mirl.debug.location.Kind;
use mirl.debug.location.Kinds;
#[testing]
use mirl.debug.location.Piece;
use mirl.debug.location.Where;
#[testing]
use mirl.ir.id.Value;
#[testing]
use mirl.ir.point;
#[testing]
use mirl.machine.frame.record.Offset;

#[testing]
use rf: masc.core.register;

# one debug producer
# ---
# name:   its name in a diagnostic
# writes: the kinds of location it writes
pub rec Producer {
    name:   str;
    writes: Kinds;
}

# why a producer refused a location
# ---
# unwritten: a location, or a piece of one, of a kind it does not write
# nested:    a piece that is itself pieces
pub tag Refusal: u8 {
    unwritten: Kind;
    nested;
}

# whether a producer writes a location, every piece of it included
# ---
# p:   the producer
# l:   the location
# ret: ok, or the kind it does not write
pub fun admit(p: *Producer, l: Where) err[Refusal] {
    val k: Kind = location.kind(l);
    if (!location.holds(p.writes, k)) { ret err[Refusal].err{Refusal.unwritten{k}}; }
    if (!(sel l.pieces))              { ret err[Refusal].ok{}; }
    var i: usize = 0;
    for (i < l.pieces.size) {
        val part: Where = l.pieces.data[i].location;
        if (sel part.pieces) { ret err[Refusal].err{Refusal.nested{}}; }
        val pk: Kind = location.kind(part);
        if (!location.holds(p.writes, pk)) { ret err[Refusal].err{Refusal.unwritten{pk}}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# whether a producer refuses a location as of a kind it does not write
#[testing]
fun unwritten(p: *Producer, l: Where, k: Kind) bool {
    val got: err[Refusal] = admit(p, l);
    if (sel got.ok)               { ret false; }
    if (!(sel got.err.unwritten)) { ret false; }
    ret got.err.unwritten == k;
}

test producer__admits_the_kinds_it_writes_and_refuses_the_rest {
    # a producer of registers and pieces, and a riscv frame slot past a
    # vector register's spill, sixteen bytes and eight per unit of vlen below
    # the frame base
    var p:    Producer = Producer{name: "test", writes: location.REGISTER | location.PIECES};
    val reg:  Where    = Where.register{rf.make(0, 10)};
    val slot: Where    = Where.slot{Offset{fixed: -16, per: -8, scale: 0}};

    val held: err[Refusal] = admit(?p, reg);
    if (sel held.err) { ret 1; }
    val gone: err[Refusal] = admit(?p, Where.unavailable{});
    if (sel gone.err)                                             { ret 2; }
    if (!unwritten(?p, slot, location.SLOT))                      { ret 3; }
    if (!unwritten(?p, Where.ssa{Value{index: 0}}, location.SSA)) { ret 4; }
    if (!unwritten(?p, Where.local{0}, location.LOCAL))           { ret 5; }

    # a 64-bit variable whose low half is in a register and whose high half is gone
    var halves: [2]Piece     = [2]Piece{Piece{location: reg, bits: 32, expression: point.PLAIN}, Piece{location: Where.unavailable{}, bits: 32, expression: point.PLAIN}};
    val split:  err[Refusal] = admit(?p, Where.pieces{Slice[Piece]{data: ?halves[0], size: 2}});
    if (sel split.err) { ret 6; }

    # each piece is admitted by its own kind, and a piece is never pieces
    halves[1] = Piece{location: slot, bits: 32, expression: point.PLAIN};
    if (!unwritten(?p, Where.pieces{Slice[Piece]{data: ?halves[0], size: 2}}, location.SLOT)) { ret 7; }
    var inner: [1]Piece = [1]Piece{Piece{location: reg, bits: 32, expression: point.PLAIN}};
    halves[1] = Piece{location: Where.pieces{Slice[Piece]{data: ?inner[0], size: 1}}, bits: 32, expression: point.PLAIN};
    val nested: err[Refusal] = admit(?p, Where.pieces{Slice[Piece]{data: ?halves[0], size: 2}});
    if (sel nested.ok)            { ret 8; }
    if (!(sel nested.err.nested)) { ret 8; }
    ret 0;
}
