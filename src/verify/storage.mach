# the storage rule: every `slot.begin` and `slot.end` names an alloca of its
# function, on every path from the entry a slot's markers alternate, a begin
# where the slot is begun on no path and an end where it is begun on every
# path, and every access through a slot's address, and every use that lets it
# out, stands where the slot is begun on every path
#
# begun on some path and begun on every path are the forward dataflows of
# `mirl.ir.cfg.storage` over the graph view of the blocks the entry reaches.
# a slot no marker names lasts the whole function and is not checked, and
# neither is a block the entry does not reach.
#
# a value carries a slot's address where it is the alloca's result, or is a
# result an instruction that touches no memory derives from a value that
# carries it, or is a block parameter an edge passes one to. what a row's
# result may hold is the opcode table's (`carried`): every result but a truth
# value, which holds no address, and a part taken from an aggregate or vector
# whose type cannot hold one, which is a number kept beside the address. so a
# step past it, by its base or its index, a `select`, an aggregate or vector
# it is put in, a part of pointer type taken out, a change of type, a
# declassify, a target op and integer arithmetic on it all carry it, and a
# compare does not. a row the table does not know carries it, so a row added
# later is checked until it says otherwise. forming a value touches no
# storage, so it stands anywhere, as an address hoisted above a loop or an
# aggregate built before the slot begins. every use by an instruction that
# reads or writes memory (a load, store, copy or fill through the address, an
# atomic, a call or an assembly block given it, a store of it as a value) and
# every return of it stands where the slot is begun on every path, so on no
# path is the slot not yet begun or already ended there, an access of no
# bytes, as a copy of length zero, among them. a marker's operand is the slot
# it marks.
#
# a value that may carry the addresses of two slots, or of a slot and
# something else, is not checked: a parameter some edges pass one slot's
# address and others another value, or a `select` between them. that is the
# first limit. the second is an address kept in an integer part of an
# aggregate or vector and taken out again, which is not traced. the third is
# where an address goes once it is out: the verifier sees the call, store or
# return that lets it out and nothing after. a call that is given it returns
# before the next marker of the slot runs, so every access the callee makes
# while it runs is inside the slot's storage, but an address stored, kept by a
# callee or returned may be used after the slot ends, and keeping that from
# happening is the producer's, as the ir spec's storage rule states.
#
# cost: the values carrying an address rise through their uses, each at most
# twice (to one slot, then to more than one), then a pass over the parameters
# and selects finds those joined with something else, and the check is one
# walk of the reached blocks with the dataflow's state, a test per operand of
# each instruction that touches memory.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use cfg_storage: mirl.ir.cfg.storage;
use mirl.ir.cfg.storage.Storage;
use mirl.ir.cfg.storage.Stray;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module.Module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Row;
use opcode_rule: mirl.ir.opcode.rule;
use mirl.ir.opcode.table;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.verify.failure.Error;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;
use mirl.verify.failure.walks;
use mirl.verify.flow;

# the finding of a marker whose operand is no alloca of its function
pub val STRAY: str = "a slot.begin or slot.end whose operand is no alloca of its function";

# the finding of a begin where its slot may be begun already
pub val BEGUN: str = "a slot.begin where its slot may be begun already";

# the finding of an end where its slot may not be begun
pub val UNBEGUN: str = "a slot.end where its slot may not be begun";

# the finding of a use of a slot's address where the slot may not be begun
pub val OUTSIDE: str = "a use of a slot's address where the slot may not be begun, on some path not yet begun or already ended";

# the value no marked slot's address is, or not yet known to be
val NONE: u32 = cfg_storage.NONE;

# the value that may be the address of a marked slot or of something else
val MANY: u32 = 0xfffffffe;

# the addresses of the marked slots of one body
# ---
# m:     the module, whose types say which parts of an aggregate or vector may hold an address
# root:  each value's slot where it is an address of that one marked slot's alloca, MANY where it may be one and may
#        be something else, NONE where it is none
# work:  the values whose root rose and whose uses are still to be read
# holds: each type, whether a value of it may hold an address: 0 not yet asked, 1 no, 2 yes
rec Addresses {
    m:     *Module;
    root:  vector.Vector[u32];
    work:  vector.Vector[Value];
    holds: vector.Vector[u8];
}

fun join(x: u32, y: u32) u32 {
    if (x == NONE)           { ret y; }
    if (y == NONE || x == y) { ret x; }
    ret MANY;
}

fun rise(ad: *Addresses, v: Value, r: u32) err[allocator.Error] {
    val now: u32 = join(ad.root.data[v], r);
    if (now == ad.root.data[v]) { ret err[allocator.Error].ok{}; }
    ad.root.data[v] = now;
    val res_pushed: res[usize, allocator.Error] = vector.push[Value](?ad.work, v);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# whether instruction `d` touches memory or hands its operands out of the function: a read or write of memory, which a
# call, an assembly block and every access are, or a return. every other instruction computes values from values
fun touches(d: *InstructionData) bool {
    if (d.opcode == table.RET || d.opcode == table.RET_PLACED) { ret true; }
    val opt_row: opt[*Row] = table.at(d.opcode);
    if (sel opt_row.none) { ret true; }
    ret opt_row.some.effects.reads || opt_row.some.effects.writes;
}

# whether a value of type `ty` may hold an address: a pointer, or an aggregate or vector with a part that may
fun holds(ad: *Addresses, ty: Type) bool {
    if (ty::usize < ad.holds.len && ad.holds.data[ty] != 0) { ret ad.holds.data[ty] == 2; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?ad.m.types, ty);
    if (sel res_shape.err) { ret true; }
    val sh:  type_table.Shape = res_shape.ok;
    var yes: bool             = false;
    if (sel sh.pointer) { yes = true; }
    or (sel sh.vector)  { yes = holds(ad, sh.vector.element); }
    or (sel sh.array)   { yes = holds(ad, sh.array.element); }
    or (sel sh.structure) {
        var k: usize = 0;
        for (k < sh.structure.members.size && !yes) {
            yes = holds(ad, sh.structure.members.data[k]);
            k   = k + 1;
        }
    }
    or (sel sh.union) {
        var k: usize = 0;
        for (k < sh.union.members.size && !yes) {
            yes = holds(ad, sh.union.members.data[k]);
            k   = k + 1;
        }
    }
    if (ty::usize < ad.holds.len) {
        ad.holds.data[ty] = 1;
        if (yes) { ad.holds.data[ty] = 2; }
    }
    ret yes;
}

# whether result `k` of instruction `d`, which touches no memory, may hold what its operands hold, as its row derives
# it: every result but a truth value (`mask`), which holds no address, and a part taken from an aggregate or vector
# (`member`, `element`) of a type that cannot hold one, a number kept beside the address and not the address. a row
# the table does not know, or a result past the ones its row derives, holds it
fun carried(ad: *Addresses, b: *Body, d: *InstructionData, k: usize) bool {
    val opt_row: opt[*Row] = table.at(d.opcode);
    if (sel opt_row.none)                    { ret true; }
    if (k >= $length_of(opcode_row.Results)) { ret true; }
    val how: opcode_rule.Result = opt_row.some.results[k];
    if (sel how.mask)                      { ret false; }
    if (sel how.member || sel how.element) { ret holds(ad, b.values.data[d.results.data[k]].type); }
    ret true;
}

# the address value `v` gives to what use `d` makes of it: each result an instruction that touches no memory may hold
# it in (`carried`), and each parameter an edge of it passes `v` to
fun carry(ad: *Addresses, b: *Body, d: *InstructionData, v: Value) err[allocator.Error] {
    val r: u32   = ad.root.data[v];
    var k: usize = 0;
    for (!touches(d) && k < d.results.len) {
        if (carried(ad, b, d, k)) {
            val err_risen: err[allocator.Error] = rise(ad, d.results.data[k], r);
            if (sel err_risen.err) { ret err_risen; }
        }
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        var n:    usize = 0;
        for (n < edge.arguments.len) {
            if (edge.arguments.data[n] == v) {
                val err_risen: err[allocator.Error] = rise(ad, b.blocks.data[edge.block].parameters.data[n], r);
                if (sel err_risen.err) { ret err_risen; }
            }
            n = n + 1;
        }
        e = e + 1;
    }
    ret err[allocator.Error].ok{};
}

fun drain(ad: *Addresses, b: *Body) err[allocator.Error] {
    for (ad.work.len > 0) {
        val v: Value = ad.work.data[ad.work.len - 1];
        vector.truncate[Value](?ad.work, ad.work.len - 1);
        var u: usize = 0;
        for (u < b.values.data[v].uses.len) {
            val err_carried: err[allocator.Error] = carry(ad, b, ?b.instructions.data[b.values.data[v].uses.data[u].instruction], v);
            if (sel err_carried.err) { ret err_carried; }
            u = u + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

# whether value `v`, an address of one slot, is joined with a value that is none: a parameter some edge passes such
# a value for, or a select with such a choice
fun mixed(ad: *Addresses, b: *Body, v: Value) bool {
    val def: Def = b.values.data[v].def;
    if (sel def.parameter) {
        val k: Block = def.parameter.block;
        var p: usize = 0;
        for (p < b.blocks.data[k].predecessors.len) {
            val d: *InstructionData = ?b.instructions.data[b.blocks.data[k].predecessors.data[p].instruction];
            var e: usize            = 0;
            for (e < d.edges.len) {
                if (d.edges.data[e].block == k && ad.root.data[d.edges.data[e].arguments.data[def.parameter.index]] == NONE) { ret true; }
                e = e + 1;
            }
            p = p + 1;
        }
        ret false;
    }
    if (sel def.result) {
        val d: *InstructionData = ?b.instructions.data[def.result.instruction];
        if (d.opcode == table.SELECT && d.operands.len == 3) { ret ad.root.data[d.operands.data[1]] == NONE || ad.root.data[d.operands.data[2]] == NONE; }
    }
    ret false;
}

# the addresses of the marked slots of body `b`: rising from each marked alloca through the uses that form an address
# with every value not yet reached taken as none of them, then each parameter or select one of whose inputs stayed
# none taken as more than one thing, which rises through its uses in turn
fun addresses(ad: *Addresses, s: *Storage, b: *Body) err[allocator.Error] {
    vector.clear[u32](?ad.root);
    vector.clear[Value](?ad.work);
    val err_filled: err[allocator.Error] = slice.fill[u32](?ad.root, b.values.len, NONE);
    if (sel err_filled.err) { ret err_filled; }
    var i: usize = 0;
    for (i < b.instructions.len) {
        if (cfg_storage.marked(s, i::u32) && b.instructions.data[i].results.len == 1) {
            val err_risen: err[allocator.Error] = rise(ad, b.instructions.data[i].results.data[0], i::u32);
            if (sel err_risen.err) { ret err_risen; }
        }
        i = i + 1;
    }
    val err_drained: err[allocator.Error] = drain(ad, b);
    if (sel err_drained.err) { ret err_drained; }
    var v: usize = 0;
    for (v < b.values.len) {
        val r: u32 = ad.root.data[v];
        if (r != NONE && r != MANY && mixed(ad, b, v::u32)) {
            ad.root.data[v] = MANY;
            val res_pushed: res[usize, allocator.Error] = vector.push[Value](?ad.work, v::u32);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        v = v + 1;
    }
    ret drain(ad, b);
}

# block `k` walked from the state into it, each marker and each use of a slot's address checked before the
# instruction moves the state
fun across(run: *Run, s: *Storage, ad: *Addresses, f: Function, b: *Body, k: u32) err[Error] {
    var i: Instruction = b.blocks.data[k].first;
    for (i != NO_INSTRUCTION) {
        val d: *InstructionData = ?b.instructions.data[i];
        if (table.marks(d.opcode)) {
            val x: u32 = cfg_storage.alloca_of(b, d);
            if (d.opcode == table.SLOT_BEGIN && cfg_storage.may(s, x)) { ret broken(at_instruction(run.m, f, k, i), BEGUN); }
            if (d.opcode == table.SLOT_END && !cfg_storage.must(s, x)) { ret broken(at_instruction(run.m, f, k, i), UNBEGUN); }
        }
        or (touches(d)) {
            var j: usize = 0;
            for (j < d.operands.len) {
                val r: u32 = ad.root.data[d.operands.data[j]];
                if (r != NONE && r != MANY && !cfg_storage.must(s, r)) {
                    ret broken(at_instruction(run.m, f, k, i), OUTSIDE);
                }
                j = j + 1;
            }
        }
        cfg_storage.step(s, b, d);
        i = d.next;
    }
    ret err[Error].ok{};
}

fun function_of(run: *Run, s: *Storage, ad: *Addresses, f: Function) err[Error] {
    val m: *Module = run.m;
    val b: *Body   = ?m.functions.data[f].body;
    if (b.blocks.len == 0) { ret err[Error].ok{}; }
    val res_numbered: res[opt[Stray], allocator.Error] = cfg_storage.numbered(s, b);
    if (sel res_numbered.err)     { ret exhausted(res_numbered.err); }
    if (sel res_numbered.ok.some) { ret broken(at_instruction(m, f, res_numbered.ok.some.block, res_numbered.ok.some.at), STRAY); }
    if (s.slots == 0)             { ret err[Error].ok{}; }
    var g:        Graph;
    var dom:      Dominance;
    val err_read: err[Error] = flow.shape(m, f, ?g, ?dom);
    if (sel err_read.err) { ret err_read; }
    fin {
        dominance.dnit(?dom);
        graph.dnit(?g);
    }
    val err_solved: err[allocator.Error] = cfg_storage.solve(s, b, ?g, ?dom);
    if (sel err_solved.err) { ret exhausted(err_solved.err); }
    val err_found: err[allocator.Error] = addresses(ad, s, b);
    if (sel err_found.err) { ret exhausted(err_found.err); }
    val order: Slice[u32] = dominance.order(?dom);
    var n:     usize      = 0;
    for (n < order.size) {
        cfg_storage.enter(s, ?g, ?dom, order.data[n]);
        val err_checked: err[Error] = across(run, s, ad, f, b, order.data[n]);
        if (sel err_checked.err) { ret err_checked; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# every marker names an alloca of its function, a slot's markers alternate on
# every path, and every use of a slot's address stands inside its storage, as
# the module header says
pub fun storage(run: *Run) err[Error] {
    var s:  Storage   = cfg_storage.init(run.m.a);
    var ad: Addresses = Addresses{m: run.m, root: vector.init[u32](run.m.a), work: vector.init[Value](run.m.a), holds: vector.init[u8](run.m.a)};
    fin {
        cfg_storage.dnit(?s);
        vector.dnit[u32](?ad.root);
        vector.dnit[Value](?ad.work);
        vector.dnit[u8](?ad.holds);
    }
    val err_sized: err[allocator.Error] = slice.fill[u8](?ad.holds, run.m.types.nodes.len, 0);
    if (sel err_sized.err) { ret exhausted(err_sized.err); }
    var f: usize = 0;
    for (f < run.m.functions.len) {
        if (walks(run, f)) {
            val err_function: err[Error] = function_of(run, ?s, ?ad, f::u32);
            if (sel err_function.err) { ret err_function; }
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}
