# the storage rule: every `slot.begin` and `slot.end` names an alloca of its
# function, and on every path from the entry a slot's markers alternate, a
# begin where the slot is begun on no path and an end where it is begun on
# every path
#
# begun on some path and begun on every path are the forward dataflows of
# `mirl.ir.cfg.storage` over the graph view of the blocks the entry reaches.
# a slot no marker names is not checked, and neither is a block the entry
# does not reach.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use cfg_storage: mirl.ir.cfg.storage;
use mirl.ir.cfg.storage.Storage;
use mirl.ir.cfg.storage.Stray;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module.Module;
use mirl.ir.opcode.table;
use mirl.verify.failure.Error;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;
use mirl.verify.failure.walks;
use mirl.verify.flow;

# the finding of a marker whose operand is no alloca of its function
pub val STRAY: str = "a slot.begin or slot.end whose operand is no alloca of its function";

# the finding of a begin where its slot may be begun already
pub val BEGUN: str = "a slot.begin where its slot may be begun already";

# the finding of an end where its slot may not be begun
pub val UNBEGUN: str = "a slot.end where its slot may not be begun";

# block `k` walked from the state into it, each marker checked before it moves the state
fun across(run: *Run, s: *Storage, f: Function, b: *Body, k: u32) err[Error] {
    var i: Instruction = b.blocks.data[k].first;
    for (i != NO_INSTRUCTION) {
        val d: *InstructionData = ?b.instructions.data[i];
        if (table.marks(d.opcode)) {
            val x: u32 = cfg_storage.alloca_of(b, d);
            if (d.opcode == table.SLOT_BEGIN && cfg_storage.may(s, x)) { ret broken(at_instruction(run.m, f, k, i), BEGUN); }
            if (d.opcode == table.SLOT_END && !cfg_storage.must(s, x)) { ret broken(at_instruction(run.m, f, k, i), UNBEGUN); }
        }
        cfg_storage.step(s, b, d);
        i = d.next;
    }
    ret err[Error].ok{};
}

fun function_of(run: *Run, s: *Storage, f: Function) err[Error] {
    val m: *Module = run.m;
    val b: *Body   = ?m.functions.data[f].body;
    if (b.blocks.len == 0) { ret err[Error].ok{}; }
    val res_numbered: res[opt[Stray], allocator.Error] = cfg_storage.numbered(s, b);
    if (sel res_numbered.err)     { ret exhausted(res_numbered.err); }
    if (sel res_numbered.ok.some) { ret broken(at_instruction(m, f, res_numbered.ok.some.block, res_numbered.ok.some.at), STRAY); }
    if (s.slots == 0)             { ret err[Error].ok{}; }
    var g:        Graph;
    var dom:      Dominance;
    val err_read: err[Error] = flow.shape(m, f, ?g, ?dom);
    if (sel err_read.err) { ret err_read; }
    fin {
        dominance.dnit(?dom);
        graph.dnit(?g);
    }
    val err_solved: err[allocator.Error] = cfg_storage.solve(s, b, ?g, ?dom);
    if (sel err_solved.err) { ret exhausted(err_solved.err); }
    val order: Slice[u32] = dominance.order(?dom);
    var n:     usize      = 0;
    for (n < order.size) {
        cfg_storage.enter(s, ?g, ?dom, order.data[n]);
        val err_checked: err[Error] = across(run, s, f, b, order.data[n]);
        if (sel err_checked.err) { ret err_checked; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# every marker names an alloca of its function, and a slot's markers
# alternate on every path, as the module header says
pub fun storage(run: *Run) err[Error] {
    var s: Storage = cfg_storage.init(run.m.a);
    fin { cfg_storage.dnit(?s); }
    var f: usize = 0;
    for (f < run.m.functions.len) {
        if (walks(run, f)) {
            val err_function: err[Error] = function_of(run, ?s, f::u32);
            if (sel err_function.err) { ret err_function; }
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}
