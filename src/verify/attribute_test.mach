# the attribute rule over a schema shaped like spir-v's entry points and
# interface, which only these tests define, and over the register family's

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.slice.Slice;

use mink.model.symbol;
use mirl.build;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.attribute.Kind;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.module.Module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.slice;
use targets: mirl.target;
use mirl.target.Attached;
use mirl.target.Attaches;
use mirl.target.Attributes;
use mirl.target.Entry;
use mirl.target.Schema;
use mirl.target.Target;
use mirl.target.Violation;
use mirl.target.register.schema.SCHEMA;
use mirl.verify.failure.Error;
use mirl.verify.failure.Stage;
use mirl.verify.module.Unfit;
use mirl.verify.module.unfit;
use mirl.verify.table;

fun view(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# the datum of the attribute of a name on the same symbol, none when it has none
fun sibling(a: *Attached, name: str) opt[Datum] {
    var i: usize = 0;
    for (i < a.symbol.size) {
        if (slice.same_view(a.symbol.data[i].name, view(name))) { ret opt[Datum].some{a.symbol.data[i].datum}; }
        i = i + 1;
    }
    ret opt[Datum].none{};
}

fun one_of(d: Datum, names: Slice[str]) bool {
    if (!(sel d.text)) { ret false; }
    var i: usize = 0;
    for (i < names.size) {
        if (slice.same_view(d.text, view(names.data[i]))) { ret true; }
        i = i + 1;
    }
    ret false;
}

val STAGES:    [3]str = [3]str{"compute", "fragment", "vertex"};
val CLASSES:   [5]str = [5]str{"input", "output", "storage_buffer", "uniform", "uniform_constant"};
val DESCRIBED: [3]str = [3]str{"storage_buffer", "uniform", "uniform_constant"};

val NO_MODEL:      Violation = Violation{name: "model", what: "a stage of no execution model"};
val NOT_COUNTS:    Violation = Violation{name: "counts", what: "a workgroup size that is not three nonzero counts"};
val NOT_COMPUTE:   Violation = Violation{name: "compute", what: "a workgroup size on no compute entry point"};
val NO_CLASS:      Violation = Violation{name: "class", what: "a storage class of no variable"};
val NO_DESCRIPTOR: Violation = Violation{name: "descriptor", what: "a descriptor on a variable no descriptor holds"};

fun stage(a: *Attached) opt[*Violation] {
    if (!one_of(a.datum, Slice[str]{data: ?STAGES[0], size: 3})) { ret opt[*Violation].some{?NO_MODEL}; }
    ret opt[*Violation].none{};
}

# a workgroup size of three nonzero counts, on a compute entry point
fun local_size(a: *Attached) opt[*Violation] {
    if (!(sel a.datum.integers)) { ret opt[*Violation].some{?NOT_COUNTS}; }
    val n: Slice[u64] = a.datum.integers;
    if (n.size != 3 || n.data[0] == 0 || n.data[1] == 0 || n.data[2] == 0) { ret opt[*Violation].some{?NOT_COUNTS}; }
    var compute: [1]str     = [1]str{"compute"};
    val at:      opt[Datum] = sibling(a, "stage");
    if (sel at.some) {
        if (one_of(at.some, Slice[str]{data: ?compute[0], size: 1})) { ret opt[*Violation].none{}; }
    }
    ret opt[*Violation].some{?NOT_COMPUTE};
}

fun storage(a: *Attached) opt[*Violation] {
    if (!one_of(a.datum, Slice[str]{data: ?CLASSES[0], size: 5})) { ret opt[*Violation].some{?NO_CLASS}; }
    ret opt[*Violation].none{};
}

# a descriptor set or binding, on a variable of a class a descriptor holds
fun described(a: *Attached) opt[*Violation] {
    val class: opt[Datum] = sibling(a, "storage");
    if (sel class.some) {
        if (one_of(class.some, Slice[str]{data: ?DESCRIBED[0], size: 3})) { ret opt[*Violation].none{}; }
    }
    ret opt[*Violation].some{?NO_DESCRIPTOR};
}

val SHADER_ENTRIES: [5]Entry = [5]Entry{
    Entry{name: "binding", datum: Kind.integer{}, attaches: Attaches.global{}, check: described},
    Entry{name: "local_size", datum: Kind.integers{}, attaches: Attaches.function{}, check: local_size},
    Entry{name: "set", datum: Kind.integer{}, attaches: Attaches.global{}, check: described},
    Entry{name: "stage", datum: Kind.text{}, attaches: Attaches.function{}, check: stage},
    Entry{name: "storage", datum: Kind.text{}, attaches: Attaches.global{}, check: storage},
};

val SHADER: Schema = Schema{family: "shader", entries: Slice[Entry]{data: ?SHADER_ENTRIES[0], size: 5}};

# a declared function @main and a declared global @buffer, on a register
# target whose attributes are those of a schema
rec Case {
    m:      Module;
    t:      Target;
    main:   Symbol;
    buffer: Symbol;
}

#[testing]
fun fixture(a: *allocator.Allocator, c: *Case, schema: *Schema) bool {
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none) { ret false; }
    c.t = @row.some;
    if (schema != nil) { c.t.caps.attributes = Attributes.schema{schema}; }
    val made: res[Module, module.Error] = module.init(a, targets.tuple(?c.t));
    if (sel made.err) { ret false; }
    c.m = made.ok;
    var b:     build.Builder = build.init(?c.m);
    val sig:   Type          = build.signature(?b, types.plain(Slice[Type]{data: nil, size: 0}, Slice[Type]{data: nil, size: 0}));
    val bound: Linkage       = Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT};
    c.main = Symbol.function{build.function(?b, FunctionData{name: view("main"), signature: sig, linkage: bound})};
    val word: res[Type, types.Error] = types.intern(?c.m.types, types.Shape.integer{types.Integer{width: 32}});
    if (sel word.err) { ret false; }
    c.buffer = Symbol.global{build.global(?b, GlobalData{name: view("buffer"), type: word.ok, initial: opt[Constant].none{}, linkage: bound})};
    val ended: err[build.Failure] = build.done(?b);
    ret sel ended.ok;
}

fun attach(c: *Case, s: Symbol, family: str, name: str, datum: Datum) bool {
    val at: err[module.Error] = module.attach(?c.m, s, Attribute{family: view(family), name: view(name), datum: datum});
    ret sel at.ok;
}

# the verifier's answer and the rule's reason for a symbol's attributes
rec Verdict {
    refused: bool;
    unfit:   opt[Unfit];
}

fun judge(c: *Case, s: Symbol) opt[Verdict] {
    val list: res[Slice[Attribute], module.Error] = module.attributes(?c.m, s);
    if (sel list.err) { ret opt[Verdict].none{}; }
    var kind: Attaches = Attaches.function{};
    if (sel s.global) { kind = Attaches.global{}; }
    val why: opt[Unfit] = unfit(?c.t.caps, kind, list.ok);
    val got: err[Error] = table.against(?c.m, ?c.t, Stage.open{});
    if (sel got.ok)                                          { ret opt[Verdict].some{Verdict{refused: false, unfit: why}}; }
    if (!(sel got.err.refused))                              { ret opt[Verdict].none{}; }
    if (got.err.refused.rule.index != table.ATTRIBUTE.index) { ret opt[Verdict].none{}; }
    ret opt[Verdict].some{Verdict{refused: true, unfit: why}};
}

# build the case in an arena, attach one attribute and judge its symbol
#[testing]
fun one(back: *allocator.Allocator, schema: *Schema, global: bool, family: str, name: str, datum: Datum) opt[Verdict] {
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, back, 0);
    if (sel made.err) { ret opt[Verdict].none{}; }
    fin { arena.dnit(?ar); }
    var a: allocator.Allocator;
    arena.make(?a, ?ar);
    var c: Case;
    if (!fixture(?a, ?c, schema)) { ret opt[Verdict].none{}; }
    var s: Symbol = c.main;
    if (global)                              { s = c.buffer; }
    if (!attach(?c, s, family, name, datum)) { ret opt[Verdict].none{}; }
    ret judge(?c, s);
}

test verify__refuses_an_attribute_its_schema_does_not_define {
    var back: allocator.Allocator;
    page.make(?back);
    val v: opt[Verdict] = one(?back, ?SHADER, false, "shader", "colour", Datum.integer{1});
    if (sel v.none)                                             { ret 1; }
    if (!v.some.refused)                                        { ret 2; }
    if (!(sel v.some.unfit.some && sel v.some.unfit.some.name)) { ret 3; }
    ret 0;
}

test verify__refuses_an_attribute_of_the_wrong_datum_kind {
    var back: allocator.Allocator;
    page.make(?back);
    val v: opt[Verdict] = one(?back, ?SHADER, false, "shader", "stage", Datum.integer{5});
    if (sel v.none)                                              { ret 1; }
    if (!v.some.refused)                                         { ret 2; }
    if (!(sel v.some.unfit.some && sel v.some.unfit.some.datum)) { ret 3; }
    ret 0;
}

test verify__refuses_an_attribute_on_the_wrong_kind_of_symbol {
    var back: allocator.Allocator;
    page.make(?back);
    val v: opt[Verdict] = one(?back, ?SHADER, true, "shader", "stage", Datum.text{view("compute")});
    if (sel v.none)                                                 { ret 1; }
    if (!v.some.refused)                                            { ret 2; }
    if (!(sel v.some.unfit.some && sel v.some.unfit.some.attaches)) { ret 3; }
    ret 0;
}

test verify__refuses_an_attribute_of_another_family {
    var back: allocator.Allocator;
    page.make(?back);
    val v: opt[Verdict] = one(?back, ?SHADER, false, "register", "stage", Datum.text{view("compute")});
    if (sel v.none)                                               { ret 1; }
    if (!v.some.refused)                                          { ret 2; }
    if (!(sel v.some.unfit.some && sel v.some.unfit.some.family)) { ret 3; }
    ret 0;
}

# a compute entry point and a storage buffer at a descriptor verify, and a
# workgroup size on a vertex entry point breaks its entry's rule
test verify__keeps_each_entry_rule_beside_the_symbols_other_attributes {
    var back: allocator.Allocator;
    page.make(?back);
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, ?back, 0);
    if (sel made.err) { ret 1; }
    fin { arena.dnit(?ar); }
    var a: allocator.Allocator;
    arena.make(?a, ?ar);
    var c: Case;
    if (!fixture(?a, ?c, ?SHADER)) { ret 1; }
    var size: [3]u64 = [3]u64{8, 8, 1};
    if (!attach(?c, c.main, "shader", "stage", Datum.text{view("compute")}))                              { ret 2; }
    if (!attach(?c, c.main, "shader", "local_size", Datum.integers{Slice[u64]{data: ?size[0], size: 3}})) { ret 2; }
    if (!attach(?c, c.buffer, "shader", "storage", Datum.text{view("storage_buffer")}))                   { ret 2; }
    if (!attach(?c, c.buffer, "shader", "set", Datum.integer{0}))                                         { ret 2; }
    if (!attach(?c, c.buffer, "shader", "binding", Datum.integer{1}))                                     { ret 2; }
    val kept: opt[Verdict] = judge(?c, c.main);
    if (sel kept.none)            { ret 3; }
    if (kept.some.refused)        { ret 4; }
    if (sel kept.some.unfit.some) { ret 4; }
    val list: res[Slice[Attribute], module.Error] = module.attributes(?c.m, c.main);
    if (sel list.err) { ret 5; }
    list.ok.data[0].datum = Datum.text{view("vertex")};
    val broke: opt[Verdict] = judge(?c, c.main);
    if (sel broke.none)               { ret 5; }
    if (!broke.some.refused)          { ret 6; }
    if (!(sel broke.some.unfit.some)) { ret 7; }
    val why: Unfit = broke.some.unfit.some;
    if (!(sel why.check))          { ret 7; }
    if (why.check != ?NOT_COMPUTE) { ret 8; }
    ret 0;
}

# a register target states the register family's schema, which defines no
# attribute and so refuses one of its own family by name
test verify__register_family_defines_no_attribute {
    var back: allocator.Allocator;
    page.make(?back);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none)                                                                         { ret 1; }
    if (!(sel row.some.caps.attributes.schema && row.some.caps.attributes.schema == ?SCHEMA)) { ret 2; }
    val v: opt[Verdict] = one(?back, nil, false, "register", "stage", Datum.integer{5});
    if (sel v.none)                                             { ret 3; }
    if (!v.some.refused)                                        { ret 4; }
    if (!(sel v.some.unfit.some && sel v.some.unfit.some.name)) { ret 5; }
    ret 0;
}
