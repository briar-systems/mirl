# the verifier's refusals: the rule a module broke, where, and why
#
# a refusal is a defect of the producer that made the module, never a
# diagnostic about the program it was made from.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;

use mirl.ir.debug.record.Location;
use ir_function: mirl.ir.function;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.type.table.Type;
use mirl.structure.region.Structure;
use mirl.target.layout.Layout;
use mirl.target.record.Target;

# a rule, as an id into the rule table
# ---
# index: the rule's row in the table
pub rec Rule {
    index: u32;
}

# where a refusal happened, each id none when it does not apply
# ---
# function:    the function
# block:       the block of the function
# instruction: the instruction of the function
# location:    the source location the instruction was built for, none for
#              none
# global:      the global
# constant:    the constant
# type:        the type
# name:        the symbol name of the function or global, empty for neither
# referenced:  the symbol name of the symbol a refusal finds the address of, empty for none
# set:         the instruction set a refused target op names, empty for none
# op:          the op that target op names in its set, empty for none
# form:        the ir form written in place of a refused target op, empty for none
# extension:   the extension a function admits that its target's instruction
#              set does not know, empty for none
pub rec Where {
    function:    opt[Function];
    block:       opt[Block];
    instruction: opt[Instruction];
    location:    opt[Location];
    global:      opt[Global];
    constant:    opt[Constant];
    type:        opt[Type];
    name:        View;
    referenced:  View;
    set:         View;
    op:          View;
    form:        View;
    extension:   View;
}

# one refusal, an internal failure of the module's producer
# ---
# rule: the rule broken, which the walker states of what a check found
# at:   where
# what: a short description of the fact that does not hold
pub rec Failure {
    rule: Rule;
    at:   Where;
    what: str;
}

# why the verifier did not answer valid, or a check did not hold
# ---
# alloc:   the allocator refused storage, so nothing was verified
# refused: the module breaks a rule
pub tag Error: u8 {
    alloc:   allocator.Error;
    refused: Failure;
}

# the region tree of a function, read from what holds it, refused as a finding
# that says in a few words why the structure analysis refused the function
pub def Tree: fun(ptr, Function) res[*Structure, Error];

# the region trees of a module's functions, as the structure analysis holds
# them
# ---
# holder: what the lookup reads
# of:     the tree of one function, valid until the holder changes
pub rec Trees {
    holder: ptr;
    of:     Tree;
}

# how far a module has come through its schedule
# ---
# given: as a front end gives it to a schedule, before any pass, so it holds no opcode only a pass makes and no rule
#        that holds of legal code applies
# open:  before legalisation, so no rule that holds of legal code applies
# legal: past every legalisation, with the region tree of each function
pub tag Stage: u8 {
    given;
    open;
    legal: Trees;
}

# whose bodies a run walks. the module-wide facts, its globals, signatures,
# declarations and type table, are held whatever the scope
# ---
# whole:   every function's
# changed: the functions a pass changed, one mark per function, every other
#          one held to the rules by the run before it. a function past the
#          marks is one the pass added, and is walked
pub tag Scope: u8 {
    whole;
    changed: Slice[bool];
}

# what every check reads
# ---
# m:       the module
# target:  the target it was built for
# layout:  the module's types laid out for that target
# stage:   how far the module has come
# scope:   whose bodies the run walks
# secrecy: the first instruction whose results' secrecy is not its row's, as
#          the typing walk found it for the secrecy rule, none for none
pub rec Run {
    m:       *Module;
    target:  *Target;
    layout:  Layout;
    stage:   Stage;
    scope:   Scope;
    secrecy: opt[Failure];
}

# whether a run walks the body of function `f`
pub fun walks(run: *Run, f: usize) bool {
    if (sel run.scope.whole)         { ret true; }
    if (f >= run.scope.changed.size) { ret true; }
    ret run.scope.changed.data[f];
}

# a rule's check: ok, or the first place the module breaks the rule, whose
# rule the walker states
pub def Check: fun(*Run) err[Error];

# nowhere in particular, a module-wide fact
pub fun module_wide() Where {
    var w: Where;
    w.function    = opt[Function].none{};
    w.block       = opt[Block].none{};
    w.instruction = opt[Instruction].none{};
    w.location    = opt[Location].none{};
    w.global      = opt[Global].none{};
    w.constant    = opt[Constant].none{};
    w.type        = opt[Type].none{};
    w.name        = View{data: nil, len: 0};
    w.referenced  = View{data: nil, len: 0};
    w.set         = View{data: nil, len: 0};
    w.op          = View{data: nil, len: 0};
    w.form        = View{data: nil, len: 0};
    w.extension   = View{data: nil, len: 0};
    ret w;
}

# a function, named
pub fun in_function(m: *Module, f: Function) Where {
    var w: Where = module_wide();
    w.function = opt[Function].some{f};
    w.name     = module.name_of(m, m.functions.data[f.index].data.name);
    ret w;
}

# a block of a function
pub fun in_block(m: *Module, f: Function, k: Block) Where {
    var w: Where = in_function(m, f);
    w.block = opt[Block].some{k};
    ret w;
}

# an instruction of a block of a function
pub fun at_instruction(m: *Module, f: Function, k: Block, i: Instruction) Where {
    var w: Where = in_block(m, f, k);
    w.instruction = opt[Instruction].some{i};
    w.location    = ir_function.location(?m.functions.data[f.index].body, i);
    ret w;
}

# a global, named
pub fun at_global(m: *Module, g: Global) Where {
    var w: Where = module_wide();
    w.global = opt[Global].some{g};
    w.name   = module.name_of(m, m.globals.data[g.index].data.name);
    ret w;
}

# a constant
pub fun at_constant(c: Constant) Where {
    var w: Where = module_wide();
    w.constant = opt[Constant].some{c};
    ret w;
}

# a type
pub fun at_type(ty: Type) Where {
    var w: Where = module_wide();
    w.type = opt[Type].some{ty};
    ret w;
}

# a check's finding that its rule does not hold, the rule left to the walker
pub fun finding(at: Where, what: str) Failure {
    ret Failure{rule: Rule{index: 0}, at: at, what: what};
}

# a check's finding that its rule does not hold
pub fun broken(at: Where, what: str) err[Error] {
    ret err[Error].err{Error.refused{finding(at, what)}};
}

# the allocator's refusal, which is never an answer of valid
pub fun exhausted(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}
