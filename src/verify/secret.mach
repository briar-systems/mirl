# the secrecy of memory: what a global states of its secret bytes, and what an access states it reads
#
# a global's secret ranges lie within its storage, and an instruction that
# reads memory and gives results states secret ones wherever the bytes it reads
# may share one with a secret range of the global its address is formed from,
# so a front end reads a secret global into a public value only through
# `declassify`. an access that states its secrecy (`opcode_row.states_access`,
# a store, `opcode_row.states_write`, and a copy, `opcode_row.states_copy`,
# of both what it reads and what it writes) states it secret with its secret mark
# or public with the public flag, from the type of the pointer it reads or
# writes through, and states neither where it does not know. the public flag stands on no other row, never beside a secret
# result, and an access stated public reads and writes no secret operand, so
# what it states holds of the memory and its results. an address the ir does
# not place is not held here, and the walk of a constant-time function's code
# takes what each access states as its seed and holds the rest. an alloca
# stated public states the storage it makes holds no secret, as the type of
# what the front end keeps there holds none, which the walk takes as a typed
# frame extent of the slot selection makes for it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ct.frame;
use secret_globals: mirl.ct.global;
use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.function.parameter_secrecy;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Range;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata;
use mirl.ir.metadata.NO_PUBLICS;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.table;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.DEFAULT_SPACE;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.record;
use mirl.verify.failure.Error;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_global;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.in_function;
use mirl.verify.failure.walks;

# every secret range of global `g` lies within its size, where its type lays out
fun within(run: *Run, g: Global) err[Error] {
    val d: *GlobalData = ?run.m.globals.data[g].data;
    if (!(sel d.secret.ranges)) { ret err[Error].ok{}; }
    val sized: res[u64, record.Error] = layout.size(?run.layout, d.type, DEFAULT_SPACE);
    if (sel sized.err) { ret broken(at_global(run.m, g), "secret ranges of a global whose type lays out to no size"); }
    var i: usize = 0;
    for (i < d.secret.ranges.size) {
        val r: Range = d.secret.ranges.data[i];
        if (r.offset + r.length > sized.ok || r.offset + r.length < r.offset) { ret broken(at_global(run.m, g), "a secret range outside the global's storage"); }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether instruction `d` of body `b` states a public result, or none, while it reads bytes of a global that may share
# one with a secret range: a row that reads memory, at an address operand formed from such a global, the length read its first
# result's size, every byte when that is not known
fun leaks(run: *Run, b: *Body, d: *InstructionData) bool {
    if (d.results.len == 0) { ret false; }
    val row: opt[*Row] = table.at(d.opcode);
    if (sel row.none)            { ret false; }
    if (!row.some.effects.reads) { ret false; }
    var public: bool  = false;
    var r:      usize = 0;
    for (r < d.results.len) {
        if (!b.values.data[d.results.data[r]].secret) { public = true; }
        r = r + 1;
    }
    if (!public) { ret false; }
    var length: u64                    = 0;
    val sized:  res[u64, record.Error] = layout.size(?run.layout, b.values.data[d.results.data[0]].type, DEFAULT_SPACE);
    if (sel sized.ok) { length = sized.ok; }
    var k: usize = 0;
    for (k < d.operands.len && k < $length_of(opcode_row.Operands)) {
        val role: opcode_row.Role = row.some.operands[k].role;
        if (sel role.address) {
            if (length == 0) {
                if (secret_globals.of_secret(run.m, ?run.layout, b, d.operands.data[k])) { ret true; }
            }
            or (secret_globals.secret_at(run.m, ?run.layout, b, d.operands.data[k], length)) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# why instruction `d` of body `b` states its access wrongly: the public flag on a row that states no access, beside a
# secret result, or on an access with a secret operand. none when it states it rightly or not at all
fun misstated(b: *Body, d: *InstructionData) opt[str] {
    if (!d.metadata.flags.public) { ret opt[str].none{}; }
    val row: opt[*Row] = table.at(d.opcode);
    if (sel row.none)                        { ret opt[str].some{"the public flag on an instruction that states no memory access"}; }
    if (!opcode_row.states_memory(row.some)) { ret opt[str].some{"the public flag on an instruction that states no memory access"}; }
    if (d.metadata.secret)                   { ret opt[str].some{"an access stated public and secret"}; }
    var k: usize = 0;
    for (k < d.operands.len) {
        if (b.values.data[d.operands.data[k]].secret) { ret opt[str].some{"an access stated public with a secret operand"}; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# why instruction `d` of body `b` states public ranges wrongly: on an instruction that is no alloca, a list the module
# did not give out, or a range past the slot the alloca makes. none when it states them rightly or none. that the type
# of what the slot keeps lays those bytes out as public is the front end's, which nothing here can check, as the ir's
# types carry no secrecy
fun mispublished(run: *Run, b: *Body, d: *InstructionData) opt[str] {
    if (d.metadata.publics == NO_PUBLICS) { ret opt[str].none{}; }
    if (d.opcode != table.ALLOCA)         { ret opt[str].some{"public ranges on an instruction that is no alloca"}; }
    val got: res[Slice[global.Range], module.Error] = module.public_ranges(run.m, d.metadata.publics);
    if (sel got.err)        { ret opt[str].some{"public ranges of a list the module did not give out"}; }
    if (d.results.len != 1) { ret opt[str].some{"public ranges on an alloca of no slot"}; }
    val def: Def = b.values.data[d.results.data[0]].def;
    if (!(sel def.result)) { ret opt[str].some{"public ranges on an alloca of no slot"}; }
    val size: opt[u64] = frame.slot_size(?run.layout, b, def.result.instruction);
    if (sel size.none)    { ret opt[str].some{"public ranges in a slot of no size"}; }
    if (got.ok.size == 0) { ret opt[str].none{}; }
    val last: global.Range = got.ok.data[got.ok.size - 1];
    if (last.offset + last.length > size.some) { ret opt[str].some{"public ranges past the slot"}; }
    ret opt[str].none{};
}

# why instruction `d` of body `b` states a frame extent wrongly: on an instruction that is no load or store, naming a
# frame slot, at an address formed from no alloca of the body, past the slot that alloca makes, narrower than what
# the access reaches, or not holding the bytes it reaches where its address is at a constant offset in the slot. none
# when it states one rightly or none
fun misframed(run: *Run, b: *Body, d: *InstructionData) opt[str] {
    if (!metadata.states_extent(?d.metadata)) { ret opt[str].none{}; }
    val e: metadata.Extent = d.metadata.extent;
    if (d.opcode != table.LOAD && d.opcode != table.STORE) { ret opt[str].some{"a frame extent on an instruction that is no load or store"}; }
    if (e.slot != metadata.NO_SLOT)                        { ret opt[str].some{"a frame extent naming a slot, which the ir names by the address"}; }
    if (d.operands.len == 0)                               { ret opt[str].some{"a frame extent on an access of no address"}; }
    val slot: opt[Instruction] = frame.slot_of(b, d.operands.data[0]);
    if (sel slot.none) { ret opt[str].some{"a frame extent on an access whose address is formed from no alloca"}; }
    val size: opt[u64] = frame.slot_size(?run.layout, b, slot.some);
    if (sel size.none)                                                     { ret opt[str].some{"a frame extent in a slot of no size"}; }
    if (e.offset + e.length < e.offset || e.offset + e.length > size.some) { ret opt[str].some{"a frame extent past the slot"}; }
    var reached: opt[u64] = opt[u64].none{};
    if (d.opcode == table.LOAD && d.results.len == 1)   { reached = frame.bytes_of(?run.layout, b.values.data[d.results.data[0]].type); }
    if (d.opcode == table.STORE && d.operands.len == 2) { reached = frame.bytes_of(?run.layout, b.values.data[d.operands.data[1]].type); }
    if (sel reached.none)                               { ret opt[str].some{"a frame extent on an access of no size"}; }
    if (reached.some > e.length)                        { ret opt[str].some{"a frame extent narrower than its access"}; }
    # an address at a constant offset in its slot shows the bytes it reaches, which the range must hold
    val at: opt[u64] = frame.offset_in(run.m, ?run.layout, b, d.operands.data[0]);
    if (sel at.none)                                                        { ret opt[str].none{}; }
    if (at.some < e.offset || at.some + reached.some > e.offset + e.length) { ret opt[str].some{"a frame extent its access, at a constant offset in the slot, reaches past"}; }
    ret opt[str].none{};
}

# every instruction states its access and its frame extent rightly or not at all
fun accesses(run: *Run) err[Error] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val fn: Function = (f::u32);
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction = bd.instructions.data[i];
                    val why:  opt[str]    = misstated(b, ?b.instructions.data[inst]);
                    if (sel why.some) { ret broken(at_instruction(m, fn, (k::u32), inst), why.some); }
                    val framed: opt[str] = misframed(run, b, ?b.instructions.data[inst]);
                    if (sel framed.some) { ret broken(at_instruction(m, fn, (k::u32), inst), framed.some); }
                    val published: opt[str] = mispublished(run, b, ?b.instructions.data[inst]);
                    if (sel published.some) { ret broken(at_instruction(m, fn, (k::u32), inst), published.some); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}

# every secret range of function `f`'s parameters lies within its parameter, where its type lays out, and before its
# entry is placed each parameter of a body is secret exactly where its declaration states some of it secret
fun declared(run: *Run, f: Function) err[Error] {
    val d:   *FunctionData                              = ?run.m.functions.data[f].data;
    val sig: res[type_table.Function, type_table.Error] = type_table.signature(?run.m.types, d.signature);
    if (sel sig.err) { ret err[Error].ok{}; }
    var k: usize = 0;
    for (k < d.secrets.size) {
        val s: global.Secrecy = d.secrets.data[k];
        if (sel s.ranges) {
            val sized: res[u64, record.Error] = layout.size(?run.layout, sig.ok.params.data[k], DEFAULT_SPACE);
            if (sel sized.err) { ret broken(in_function(run.m, f), "secret ranges of a parameter whose type lays out to no size"); }
            val last: Range = s.ranges.data[s.ranges.size - 1];
            if (last.offset + last.length > sized.ok) { ret broken(in_function(run.m, f), "a secret range outside its parameter"); }
        }
        k = k + 1;
    }
    val b: *Body = ?run.m.functions.data[f].body;
    if (b.blocks.len == 0 || sel b.entry.placed) { ret err[Error].ok{}; }
    val params: *vector.Vector[Value] = ?b.blocks.data[0].parameters;
    k = 0;
    for (k < params.len) {
        val stated: global.Secrecy = parameter_secrecy(d, k);
        if (b.values.data[params.data[k]].secret == sel stated.public) { ret broken(in_function(run.m, f), "an entry parameter secret where its declaration states none of it secret, or public where it states some"); }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# every secret range of a global and of a function's parameter lies within its storage, every entry parameter is as
# secret as its declaration, every access states its secrecy rightly or not at all, and every read of a global's
# secret bytes states a secret result
pub fun globals(run: *Run) err[Error] {
    val m: *Module = run.m;
    var g: usize   = 0;
    for (g < m.globals.len) {
        val held: err[Error] = within(run, (g::u32));
        if (sel held.err) { ret held; }
        g = g + 1;
    }
    var f: usize = 0;
    for (f < m.functions.len) {
        if (walks(run, f)) {
            val held: err[Error] = declared(run, (f::u32));
            if (sel held.err) { ret held; }
        }
        f = f + 1;
    }
    val stated: err[Error] = accesses(run);
    if (sel stated.err)         { ret stated; }
    if (!secret_globals.any(m)) { ret err[Error].ok{}; }
    f = 0;
    for (f < m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val fn: Function = (f::u32);
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction = bd.instructions.data[i];
                    if (leaks(run, b, ?b.instructions.data[inst])) { ret broken(at_instruction(m, fn, (k::u32), inst), "a read of a global's secret bytes that does not state a secret result"); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}
