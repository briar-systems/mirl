# the secrecy of globals: what a global states of its secret bytes, and what code reads of them
#
# a global's secret ranges lie within its storage, and an instruction that
# reads memory and gives results gives secret ones wherever the bytes it reads
# may share one with a secret range of the global its address is formed from,
# so a front end reads a secret global into a public value only through
# `declassify`. an address the ir does not place is not held, and the walk of
# a constant-time function's code holds what it reaches.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use secret_globals: mirl.ct.global;
use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Range;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Row;
use mirl.ir.type.DEFAULT_SPACE;
use mirl.target.layout;
use mirl.target.record;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_global;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;

# every secret range of global `g` lies within its size, where its type lays out
fun within(run: *Run, g: Global) err[Found] {
    val d: *GlobalData = ?run.m.globals.data[g.index].data;
    if (!(sel d.secret.ranges)) { ret err[Found].ok{}; }
    val sized: res[u64, record.Error] = layout.size(?run.layout, d.type, DEFAULT_SPACE);
    if (sel sized.err) { ret broken(at_global(run.m, g), "secret ranges of a global whose type lays out to no size"); }
    var i: usize = 0;
    for (i < d.secret.ranges.size) {
        val r: Range = d.secret.ranges.data[i];
        if (r.offset + r.length > sized.ok || r.offset + r.length < r.offset) { ret broken(at_global(run.m, g), "a secret range outside the global's storage"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# whether instruction `d` of body `b` gives a public result while it reads bytes of a global that may share one with a
# secret range: a row that reads memory, at an address operand formed from such a global, the length read its first
# result's size, every byte when that is not known
fun leaks(run: *Run, b: *Body, d: *InstructionData) bool {
    if (d.results.len == 0) { ret false; }
    val row: opt[*Row] = opcode.at(d.opcode);
    if (sel row.none)            { ret false; }
    if (!row.some.effects.reads) { ret false; }
    var public: bool  = false;
    var r:      usize = 0;
    for (r < d.results.len) {
        if (!b.values.data[d.results.data[r].index].secret) { public = true; }
        r = r + 1;
    }
    if (!public) { ret false; }
    var length: u64                    = 0;
    val sized:  res[u64, record.Error] = layout.size(?run.layout, b.values.data[d.results.data[0].index].type, DEFAULT_SPACE);
    if (sel sized.ok) { length = sized.ok; }
    var k: usize = 0;
    for (k < d.operands.len && k < $length_of(opcode.Operands)) {
        val role: opcode.Role = row.some.operands[k].role;
        if (sel role.address) {
            if (length == 0) {
                if (secret_globals.of_secret(run.m, ?run.layout, b, d.operands.data[k])) { ret true; }
            }
            or (secret_globals.secret_at(run.m, ?run.layout, b, d.operands.data[k], length)) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# every secret range of a global lies within its storage, and no instruction reads a global's secret bytes into a
# public result
pub fun globals(run: *Run) err[Found] {
    val m: *Module = run.m;
    var g: usize   = 0;
    for (g < m.globals.len) {
        val held: err[Found] = within(run, Global{index: g::u32});
        if (sel held.err) { ret held; }
        g = g + 1;
    }
    if (!secret_globals.any(m)) { ret err[Found].ok{}; }
    var f: usize = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction = bd.instructions.data[i];
                    if (leaks(run, b, ?b.instructions.data[inst.index])) { ret broken(at_instruction(m, fn, Block{index: k::u32}, inst), "a read of a global's secret bytes into a public result"); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}
