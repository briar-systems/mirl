# the ssa rule: every use is dominated by its definition, and the binding
# rule: every value binding record stands at a point of its block and reads a
# value that dominates that point
#
# dominance is mirl.ir.cfg's over the body's graph. a block parameter is
# defined at its block's entry, a result just after its instruction, and a
# constant everywhere. an edge argument is used at the instruction that holds
# the edge. a block the entry does not reach is dominated by every block, so
# each use in it holds vacuously, while a definition in it dominates no use in
# a reached block. a record is a point just before the instruction it names,
# so it reads a value as an operand of that instruction would.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.block.BlockData;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use cfg_view: mirl.ir.cfg.view;
use mirl.ir.debug.entry;
use debug_place:  mirl.ir.debug.place;
use debug_record: mirl.ir.debug.record;
use debug_table:  mirl.ir.debug.table;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Place;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.point;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.verify.failure.Error;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;
use mirl.verify.failure.in_block;
use mirl.verify.failure.in_function;
use mirl.verify.failure.walks;

# whether a definition reaches a use at position `at` of block `k`
fun reaches(b: *Body, dom: *Dominance, positions: *vector.Vector[u32], k: Block, at: u32, v: Value) bool {
    val def: Def = b.values.data[v].def;
    if (sel def.constant)  { ret true; }
    if (sel def.parameter) { ret dominance.dominates(dom, def.parameter.block, k); }
    if (!(sel def.result)) { ret false; }
    val maker: Instruction = def.result.instruction;
    val place: Place       = b.instructions.data[maker].place;
    if (!(sel place.placed))           { ret false; }
    if (place.placed == k) { ret positions.data[maker] < at; }
    ret dominance.dominates(dom, place.placed, k);
}

fun uses_of(m: *Module, f: Function, b: *Body, dom: *Dominance, positions: *vector.Vector[u32]) err[Error] {
    var k: usize = 0;
    for (k < b.blocks.len) {
        val id: Block      = (k::u32);
        val bd: *BlockData = ?b.blocks.data[k];
        if (!bd.erased && dominance.reachable(dom, id)) {
            var i: usize = 0;
            for (i < bd.instructions.len) {
                val inst: Instruction      = bd.instructions.data[i];
                val d:    *InstructionData = ?b.instructions.data[inst];
                var o:    usize            = 0;
                for (o < d.operands.len) {
                    if (!reaches(b, dom, positions, id, i::u32, d.operands.data[o])) { ret broken(at_instruction(m, f, id, inst), "an operand whose definition does not dominate it"); }
                    o = o + 1;
                }
                var e: usize = 0;
                for (e < d.edges.len) {
                    var j: usize = 0;
                    for (j < d.edges.data[e].arguments.len) {
                        if (!reaches(b, dom, positions, id, i::u32, d.edges.data[e].arguments.data[j])) { ret broken(at_instruction(m, f, id, inst), "an argument whose definition does not dominate its edge"); }
                        j = j + 1;
                    }
                    e = e + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# a value the body gave out whose definition has not been removed
fun defined(b: *Body, v: Value) bool {
    if (v::usize >= b.values.len) { ret false; }
    val def: Def = b.values.data[v].def;
    ret !(sel def.removed);
}

fun point_of(m: *Module, f: Function, b: *Body, dom: *Dominance, positions: *vector.Vector[u32], id: Block, inst: Instruction, pt: Point) err[Error] {
    val known: res[debug_record.Variable, debug_table.Error] = debug_place.variable(?m.debug, pt.binding);
    if (sel known.err) { ret broken(at_instruction(m, f, id, inst), "a value binding record naming no variable of the debug table"); }
    if (!point.whole(pt.piece)) {
        val described: res[debug_record.Shape, debug_table.Error] = entry.shape(?m.debug, known.ok.type);
        if (sel described.ok) {
            val held: debug_record.Shape = described.ok;
            if (sel held.base) {
                if (pt.piece.offset::u64 + pt.piece.size::u64 > held.base.width::u64) { ret broken(at_instruction(m, f, id, inst), "a value binding record of bits past its variable's width"); }
            }
        }
    }
    val reads: Reads = pt.reads;
    if (!(sel reads.operand)) { ret err[Error].ok{}; }
    val v: Value = reads.operand.value;
    if (!defined(b, v)) { ret broken(at_instruction(m, f, id, inst), "a value binding record reading a value the body does not define"); }
    val given: res[Type, module.Error] = module.salvaged(m, b.values.data[v].type, reads.operand.expression);
    if (sel given.err)                                                                                        { ret broken(at_instruction(m, f, id, inst), "a salvage expression that does not apply to the value it reads"); }
    if (dominance.reachable(dom, id) && !reaches(b, dom, positions, id, positions.data[inst], v)) { ret broken(at_instruction(m, f, id, inst), "a value binding record whose value does not dominate its point"); }
    ret err[Error].ok{};
}

# whether a record of a piece shares a bit with a later piece of its variable in its run, from position `next`
fun shares_bits(b: *Body, pt: Point, next: u32) bool {
    if (point.whole(pt.piece)) { ret false; }
    var r:    u32   = next;
    var seen: usize = 0;
    for (r != 0 && r::usize <= b.points.len && seen < b.points.len) {
        val later: Point = b.points.data[r - 1];
        if (later.binding == pt.binding && !point.whole(later.piece) && point.overlap(pt.piece, later.piece)) { ret true; }
        r    = later.next;
        seen = seen + 1;
    }
    ret false;
}

fun points_of(m: *Module, f: Function, b: *Body, dom: *Dominance, positions: *vector.Vector[u32]) err[Error] {
    var k: usize = 0;
    for (k < b.blocks.len) {
        val id: Block      = (k::u32);
        val bd: *BlockData = ?b.blocks.data[k];
        if (!bd.erased) {
            if (bd.ending.first != 0) { ret broken(in_block(m, f, id), "a value binding record after its block's last instruction"); }
            var i: usize = 0;
            for (i < bd.instructions.len) {
                val inst: Instruction = bd.instructions.data[i];
                var r:    u32         = b.instructions.data[inst].points.first;
                var seen: usize       = 0;
                for (r != 0) {
                    if (r::usize > b.points.len || seen == b.points.len) { ret broken(at_instruction(m, f, id, inst), "a run of value binding records the body does not hold"); }
                    val pt:    Point      = b.points.data[r - 1];
                    val found: err[Error] = point_of(m, f, b, dom, positions, id, inst, pt);
                    if (sel found.err)               { ret found; }
                    if (shares_bits(b, pt, pt.next)) { ret broken(at_instruction(m, f, id, inst), "value binding records of one variable at one point whose pieces share a bit"); }
                    r    = pt.next;
                    seen = seen + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# a walk of a body that reads its dominance and each placed instruction's
# position in its block
def Walk: fun(*Module, Function, *Body, *Dominance, *vector.Vector[u32]) err[Error];

fun dominance_of(m: *Module, f: Function, walk: Walk) err[Error] {
    val b: *Body = ?m.functions.data[f].body;
    if (b.blocks.len == 0) { ret err[Error].ok{}; }
    var positions: vector.Vector[u32] = vector.init[u32](m.a);
    fin { vector.dnit[u32](?positions); }
    val room: res[usize, allocator.Error] = vector.reserve[u32](?positions, b.instructions.len);
    if (sel room.err) { ret exhausted(room.err); }
    var i: usize = 0;
    for (i < b.instructions.len) {
        vector.push[u32](?positions, graph.NONE);
        i = i + 1;
    }
    var k: usize = 0;
    for (k < b.blocks.len) {
        val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
        var p:    usize                       = 0;
        for (!b.blocks.data[k].erased && p < list.len) {
            positions.data[list.data[p]] = p::u32;
            p                                  = p + 1;
        }
        k = k + 1;
    }

    var view: Graph;
    var dom:  Dominance;
    val read: err[Error] = shape(m, f, ?view, ?dom);
    if (sel read.err) { ret read; }
    fin {
        dominance.dnit(?dom);
        graph.dnit(?view);
    }
    ret walk(m, f, b, ?dom, ?positions);
}

# the graph of a function's body and its dominance, both the caller's to give
# back once this is ok
pub fun shape(m: *Module, f: Function, g: *Graph, d: *Dominance) err[Error] {
    val read: res[Graph, module.Error] = cfg_view.of(m, f);
    if (sel read.err) {
        if (sel read.err.alloc) { ret exhausted(read.err.alloc); }
        ret broken(in_function(m, f), "a body whose graph cannot be read");
    }
    @g = read.ok;
    val dom: res[Dominance, allocator.Error] = dominance.compute(m.a, g);
    if (sel dom.err) {
        graph.dnit(g);
        ret exhausted(dom.err);
    }
    @d = dom.ok;
    ret err[Error].ok{};
}

fun each_function(run: *Run, walk: Walk) err[Error] {
    var f: usize = 0;
    for (f < run.m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val r: err[Error] = dominance_of(run.m, (f::u32), walk);
        if (sel r.err) { ret r; }
        f = f + 1;
    }
    ret err[Error].ok{};
}

# every use in a block the entry reaches is dominated by its definition
pub fun ssa(run: *Run) err[Error] {
    ret each_function(run, uses_of);
}

# every value binding record stands before an instruction of its block, in
# the order of their points, names a variable of the debug table, and reads a
# defined value through an expression that applies to it, a value that
# dominates its point when the entry reaches its block
pub fun bindings(run: *Run) err[Error] {
    ret each_function(run, points_of);
}
