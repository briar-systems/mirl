# the typing rule's admission of opcode rows a family owns, over a family and
# a row only these tests define

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use mirl.ir.module.Tuple;
use mirl.ir.opcode;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.families;
use mirl.target.families.Listing;
use mirl.target.families.Owners;
use mirl.target.family.Family;
use mirl.target.family.Unserved;
use register: mirl.target.register.family;

fun admits_logical(c: *targets.Capabilities) bool {
    ret sel c.addressing.logical;
}

fun logical(t: *Target) bool {
    ret sel t.caps.addressing.logical;
}

# the family of a registry serving a target, none when no one family does
fun serving(registry: Slice[*Family], t: *Target) opt[*Family] {
    val f: res[*Family, Unserved] = families.serving(registry, ?t.caps);
    if (sel f.err) { ret opt[*Family].none{}; }
    ret opt[*Family].some{f.ok};
}

# a row a test family owns is refused on riscv64-linux, which the register
# family serves, and admitted on a target the test family serves, and a core
# row stands on both. a row two families list has no owner and is refused
test typing__a_family_row_stands_only_where_its_family_serves {
    var a: allocator.Allocator;
    page.make(?a);
    val core: opt[*opcode.Row] = opcode.at(opcode.ADD);
    if (sel core.none) { ret 1; }
    var own: opcode.Row = @core.some;
    own.name = "test.add";
    var listed:   [1]*opcode.Row = [1]*opcode.Row{?own};
    var test:     Family         = Family{name: "test", admits: admits_logical, opcodes: Slice[*opcode.Row]{data: ?listed[0], size: 1}};
    var both:     [2]*Family     = [2]*Family{?register.FAMILY, ?test};
    val registry: Slice[*Family] = Slice[*Family]{data: ?both[0], size: 2};

    val built: res[Owners, Listing] = families.owners(?a, registry);
    if (sel built.err) { ret 2; }
    var owners: Owners = built.ok;
    fin { families.release(?owners); }

    val machine: opt[*Target] = targets.row_of(Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}});
    if (sel machine.none) { ret 3; }
    val there: opt[*Family] = serving(registry, machine.some);
    if (sel there.none)                                  { ret 4; }
    if (there.some != ?register.FAMILY)                  { ret 5; }
    if (families.admits(?owners, there, ?own))           { ret 6; }
    if (!families.admits(?owners, there, core.some))     { ret 7; }

    val shader: opt[*Target] = targets.first(logical);
    if (sel shader.none) { ret 8; }
    val here: opt[*Family] = serving(registry, shader.some);
    if (sel here.none)                                   { ret 9; }
    if (here.some != ?test)                              { ret 10; }
    if (!families.admits(?owners, here, ?own))           { ret 11; }
    if (!families.admits(?owners, here, core.some))      { ret 12; }

    var other:  Family     = Family{name: "other", admits: admits_logical, opcodes: Slice[*opcode.Row]{data: ?listed[0], size: 1}};
    var twice:  [2]*Family = [2]*Family{?test, ?other};
    val shared: res[Owners, Listing] = families.owners(?a, Slice[*Family]{data: ?twice[0], size: 2});
    if (!(sel shared.err))             { ret 13; }
    if (!(sel shared.err.twice))       { ret 14; }
    if (shared.err.twice != ?own)      { ret 15; }

    val production: res[Owners, Listing] = families.owners(?a, families.rows());
    if (sel production.err) { ret 16; }
    var held: Owners = production.ok;
    families.release(?held);
    ret 0;
}
