# the typing rule's admission of family rows, over a family and a row only
# these tests define

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.view.View;

use std.collections.slice.Slice;

use mirl.ir.module.Tuple;
use mirl.ir.opcode;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.families;
use mirl.target.family.Family;
use mirl.target.family.Unserved;
use register: mirl.target.register.family;

fun admits_logical(c: *targets.Capabilities) bool {
    ret sel c.addressing.logical;
}

fun logical(t: *Target) bool {
    ret sel t.caps.addressing.logical;
}

# a test family serving the targets whose addressing is logical, and nothing
# else of it is read
val TEST: Family = Family{name: "test", admits: admits_logical};

# the family serving a target in a registry of the register family and the test one
fun serving(t: *Target) opt[*Family] {
    var both: [2]*Family             = [2]*Family{?register.FAMILY, ?TEST};
    val f:    res[*Family, Unserved] = families.serving(Slice[*Family]{data: ?both[0], size: 2}, ?t.caps);
    if (sel f.err) { ret opt[*Family].none{}; }
    ret opt[*Family].some{f.ok};
}

# a row of the test family is refused on a register target, riscv64-linux,
# and admitted on a target the test family serves, and a core row stands on both
test typing__a_family_row_stands_only_where_its_family_serves {
    val core: opt[opcode.Row] = opcode.row(opcode.ADD);
    if (sel core.none) { ret 1; }
    var add: opcode.Row = core.some;
    var own: opcode.Row = core.some;
    own.name   = "test.add";
    own.family = opt[*Family].some{?TEST};

    val machine: opt[*Target] = targets.row_of(Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}});
    if (sel machine.none) { ret 2; }
    val there: opt[*Family] = serving(machine.some);
    if (sel there.none)                    { ret 3; }
    if (there.some != ?register.FAMILY)    { ret 4; }
    if (opcode.admitted(?own, there))      { ret 5; }
    if (!opcode.admitted(?add, there))     { ret 6; }

    val shader: opt[*Target] = targets.first(logical);
    if (sel shader.none) { ret 7; }
    val here: opt[*Family] = serving(shader.some);
    if (sel here.none)                     { ret 8; }
    if (here.some != ?TEST)                { ret 9; }
    if (!opcode.admitted(?own, here))      { ret 10; }
    if (!opcode.admitted(?add, here))      { ret 11; }

    if (opcode.admitted(?own, opt[*Family].none{}))  { ret 12; }
    if (!opcode.admitted(?add, opt[*Family].none{})) { ret 13; }
    ret 0;
}
