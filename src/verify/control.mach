# the structured control rule: past legalisation on a target that declares
# structured control, every function is the tree of regions its structure
# analysis holds, and the tree keeps the rules of structured control
#
# the rules are stated here from what the tree means, apart from the finder
# that builds it, so a flaw the finder misses is refused here. a selection or
# a loop is a construct whose header strictly dominates its merge, and no
# block is the merge or the continue target of two constructs. each region of
# a sequence goes on to the next, and the last one ends at the merge of the
# construct around it, by a break to the innermost loop's merge, by a
# continue to its continue target, or by leaving the function. a selection's
# arms start at its header's edges in order, a loop's body at its header and
# its continue sequence at its continue target, and a loop is entered back by
# exactly one edge, from that target. every block the entry reaches is in
# exactly one region, so every edge is one the tree allows: a construct is
# entered only at its header and left only to its merge, a break or a
# continue.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.NONE;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.slice.fill;
use mirl.structure.region;
use mirl.structure.region.Region;
use mirl.structure.region.Structure;
use mirl.verify.failure.Found;
use mirl.verify.failure.Missing;
use mirl.verify.failure.Run;
use mirl.verify.failure.Tree;
use mirl.verify.failure.Trees;
use mirl.verify.failure.Where;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;
use mirl.verify.failure.in_block;
use mirl.verify.failure.in_function;
use mirl.verify.flow;

# the mark of a region the walk has opened and must close
val CLOSE: u32 = 0x80000000;

# what the walk keeps of one region
# ---
# up:    the region it is a child of, NONE for the function's sequence
# exit:  the merge a sequence's last region may end at, NONE for none
# brk:   a sequence's break target, the innermost loop's merge
# cont:  a sequence's continue target
# head:  the header of the construct a sequence is part of, NONE for the
#        function's sequence
# loop:  the innermost loop around a sequence, NONE outside every loop
# enter: its position in the walk
# leave: the position of its last descendant
# backs: a loop's back edges
# seen:  whether the walk reached it
rec Frame {
    up:    u32;
    exit:  u32;
    brk:   u32;
    cont:  u32;
    head:  u32;
    loop:  u32;
    enter: u32;
    leave: u32;
    backs: u32;
    seen:  bool;
}

# what the walk keeps of one block
# ---
# named: the regions that name it
# scope: the sequence it is in, for a loop's header the one around the loop
# role:  the construct it is the merge or the continue target of, NONE for
#        none
rec Spot {
    named: u32;
    scope: u32;
    role:  u32;
}

rec Walk {
    m:      *Module;
    f:      Function;
    g:      *Graph;
    d:      *Dominance;
    s:      *Structure;
    frames: vector.Vector[Frame];
    spots:  vector.Vector[Spot];
    stack:  vector.Vector[u32];
}

fun where(k: *Walk, b: u32) Where {
    if (b == NONE) { ret in_function(k.m, k.f); }
    ret in_block(k.m, k.f, Block{index: b});
}

fun malformed(k: *Walk) err[Found] {
    ret broken(in_function(k.m, k.f), "the tree of regions is malformed");
}

# the header of the construct a sequence is part of, or b in the function's
fun construct(k: *Walk, seq: u32, b: u32) u32 {
    val h: u32 = k.frames.data[seq].head;
    if (h == NONE) { ret b; }
    ret h;
}

fun at(k: *Walk, r: u32) Region {
    ret region.region(k.s, r);
}

# whether a sequence lies within another, or is it
fun within(k: *Walk, inner: u32, outer: u32) bool {
    val i: u32 = k.frames.data[inner].enter;
    ret k.frames.data[outer].enter <= i && i <= k.frames.data[outer].leave;
}

# take a region as a child of its parent, refusing one with two parents
fun adopt(k: *Walk, parent: u32, c: u32) err[Found] {
    if (c >= region.count(k.s) || c == region.root(k.s)) { ret malformed(k); }
    if (k.frames.data[c].up != NONE)                     { ret malformed(k); }
    k.frames.data[c].up = parent;
    val pushed: res[usize, allocator.Error] = vector.push[u32](?k.stack, c);
    if (sel pushed.err) { ret exhausted(pushed.err); }
    ret err[Found].ok{};
}

# give a sequence its context
fun context(k: *Walk, seq: u32, exit: u32, brk: u32, cont: u32, head: u32, loop: u32) {
    val fr: *Frame = ?k.frames.data[seq];
    fr.exit = exit;
    fr.brk  = brk;
    fr.cont = cont;
    fr.head = head;
    fr.loop = loop;
}

fun name(k: *Walk, b: u32, seq: u32) err[Found] {
    if (b >= k.g.count)               { ret malformed(k); }
    if (!dominance.reachable(k.d, b)) { ret broken(where(k, b), "a block the entry does not reach is in the tree"); }
    val spot: *Spot = ?k.spots.data[b];
    spot.named = spot.named + 1;
    if (spot.named > 1)     { ret broken(where(k, construct(k, seq, b)), "a block is in more than one region of the tree"); }
    if (spot.scope == NONE) { spot.scope = seq; }
    ret err[Found].ok{};
}

# make a block the merge or the continue target of construct x at header h
fun role(k: *Walk, x: u32, h: u32, b: u32) err[Found] {
    if (k.spots.data[b].role != NONE) { ret broken(where(k, h), "a block is the merge or the continue target of more than one construct"); }
    k.spots.data[b].role = x;
    ret err[Found].ok{};
}

fun merge(k: *Walk, x: u32, h: u32, m: u32) err[Found] {
    if (m == NONE)                                 { ret err[Found].ok{}; }
    if (m >= k.g.count)                            { ret malformed(k); }
    if (m == h || !dominance.dominates(k.d, h, m)) { ret broken(where(k, h), "a header does not strictly dominate its merge"); }
    ret role(k, x, h, m);
}

fun items(k: *Walk, seq: u32) err[Found] {
    var c: u32 = at(k, seq).child;
    for (c != NONE) {
        val taken: err[Found] = adopt(k, seq, c);
        if (sel taken.err) { ret taken; }
        val item: Region = at(k, c);
        if (sel item.kind.sequence) { ret malformed(k); }
        c = item.next;
    }
    ret err[Found].ok{};
}

fun selection(k: *Walk, x: u32) err[Found] {
    val r:     Region     = at(k, x);
    val seq:   u32        = k.frames.data[x].up;
    val named: err[Found] = name(k, r.block, seq);
    if (sel named.err) { ret named; }
    val merged: err[Found] = merge(k, x, r.block, r.merge);
    if (sel merged.err) { ret merged; }
    val outer: Frame = k.frames.data[seq];
    var arm:   u32   = r.child;
    var arms:  usize = 0;
    for (arm != NONE) {
        val taken: err[Found] = adopt(k, x, arm);
        if (sel taken.err) { ret taken; }
        val seen: Region = at(k, arm);
        if (!(sel seen.kind.sequence)) { ret malformed(k); }
        context(k, arm, r.merge, outer.brk, outer.cont, r.block, outer.loop);
        arms = arms + 1;
        arm  = seen.next;
    }
    if (arms != graph.successors(k.g, r.block).size) { ret broken(where(k, r.block), "a selection's arms are not its header's edges"); }
    ret err[Found].ok{};
}

# a sequence starts at a block, by a region that is no loop for a loop's
# body, or the rule what is broken at the construct of header h
fun starts(k: *Walk, seq: u32, b: u32, body: bool, h: u32, what: str) err[Found] {
    val c: u32 = at(k, seq).child;
    if (c == NONE)              { ret broken(where(k, h), what); }
    if (c >= region.count(k.s)) { ret malformed(k); }
    val first: Region = at(k, c);
    if ((body && sel first.kind.loop) || first.block != b) { ret broken(where(k, h), what); }
    ret err[Found].ok{};
}

# take a loop's body or continue sequence, giving it its context
fun part(k: *Walk, x: u32, seq: u32, cont: u32) err[Found] {
    val r:     Region     = at(k, x);
    val taken: err[Found] = adopt(k, x, seq);
    if (sel taken.err) { ret taken; }
    val got: Region = at(k, seq);
    if (!(sel got.kind.sequence)) { ret malformed(k); }
    context(k, seq, NONE, r.merge, cont, r.block, x);
    ret err[Found].ok{};
}

fun loop(k: *Walk, x: u32) err[Found] {
    val r:   Region = at(k, x);
    val seq: u32    = k.frames.data[x].up;
    val h:   u32    = r.block;
    if (h >= k.g.count || r.latch >= k.g.count) { ret malformed(k); }
    if (!dominance.reachable(k.d, h))           { ret broken(where(k, h), "a block the entry does not reach is in the tree"); }
    k.spots.data[h].scope = seq;
    val merged: err[Found] = merge(k, x, h, r.merge);
    if (sel merged.err) { ret merged; }
    if (r.latch != h) {
        val latched: err[Found] = role(k, x, h, r.latch);
        if (sel latched.err) { ret latched; }
    }

    val body: u32 = r.child;
    if (body == NONE) { ret broken(where(k, h), "a loop's body does not start at its header"); }
    val inner: err[Found] = part(k, x, body, r.latch);
    if (sel inner.err) { ret inner; }
    val opens: err[Found] = starts(k, body, h, true, h, "a loop's body does not start at its header");
    if (sel opens.err) { ret opens; }

    val cont: u32 = at(k, body).next;
    if (r.latch == h) {
        if (cont != NONE) { ret malformed(k); }
        ret err[Found].ok{};
    }
    if (cont == NONE) { ret broken(where(k, h), "a loop's continue sequence does not start at its continue target"); }
    val back: err[Found] = part(k, x, cont, h);
    if (sel back.err)             { ret back; }
    if (at(k, cont).next != NONE) { ret malformed(k); }
    ret starts(k, cont, r.latch, false, h, "a loop's continue sequence does not start at its continue target");
}

# walk the tree from its root once, checking its shape and naming its blocks
fun place(k: *Walk) err[Found] {
    val root: u32 = region.root(k.s);
    # a region's id keeps its top bit clear for the walk's mark
    if (region.count(k.s) == 0 || region.count(k.s) >= CLOSE) { ret malformed(k); }
    val top: Region = at(k, root);
    if (!(sel top.kind.sequence)) { ret malformed(k); }
    val first: res[usize, allocator.Error] = vector.push[u32](?k.stack, root);
    if (sel first.err) { ret exhausted(first.err); }
    var step: u32 = 0;
    for (k.stack.len > 0) {
        val x: u32 = k.stack.data[k.stack.len - 1];
        k.stack.len = k.stack.len - 1;
        if ((x & CLOSE) != 0) {
            k.frames.data[x & ~CLOSE].leave = step - 1;
            cnt;
        }
        if (k.frames.data[x].seen) { ret malformed(k); }
        k.frames.data[x].seen  = true;
        k.frames.data[x].enter = step;
        step                   = step + 1;
        val closed: res[usize, allocator.Error] = vector.push[u32](?k.stack, x | CLOSE);
        if (sel closed.err) { ret exhausted(closed.err); }
        val r:      Region = at(k, x);
        var opened: err[Found];
        if (sel r.kind.sequence)  { opened = items(k, x); }
        or (sel r.kind.block)     { opened = name(k, r.block, k.frames.data[x].up); }
        or (sel r.kind.selection) { opened = selection(k, x); }
        or                        { opened = loop(k, x); }
        if (sel opened.err)       { ret opened; }
    }
    ret err[Found].ok{};
}

# every block the entry reaches is in a region, the function's sequence first
# at the entry
fun covered(k: *Walk) err[Found] {
    var b: u32 = 0;
    for (b < k.g.count) {
        if (dominance.reachable(k.d, b) && k.spots.data[b].named == 0) { ret broken(where(k, b), "a block the entry reaches is in no region of the tree"); }
        b = b + 1;
    }
    ret starts(k, region.root(k.s), k.g.entry, false, k.g.entry, "the function's sequence does not start at its entry");
}

# an edge from u in sequence seq to y the tree does not allow, named by the
# rule it breaks
fun stray(k: *Walk, u: u32, y: u32, seq: u32) err[Found] {
    val to: u32 = k.spots.data[y].scope;
    if (to == seq)           { ret broken(where(k, construct(k, seq, u)), "a region does not go on to the region after it"); }
    if (!within(k, seq, to)) { ret broken(where(k, construct(k, to, y)), "a construct is entered other than at its header"); }
    ret broken(where(k, construct(k, seq, u)), "a construct is left other than to its merge, a break or a continue");
}

# an edge from u in sequence seq to y that leaves by a break or a continue,
# counting a loop's back edge
fun crossing(k: *Walk, u: u32, y: u32, seq: u32) err[Found] {
    val fr: Frame = k.frames.data[seq];
    if (y == fr.brk)  { ret err[Found].ok{}; }
    if (y != fr.cont) { ret stray(k, u, y, seq); }
    if (fr.loop != NONE && y == at(k, fr.loop).block) {
        if (u != at(k, fr.loop).latch) { ret broken(where(k, y), "a loop is entered back other than from its continue target"); }
        k.frames.data[fr.loop].backs = k.frames.data[fr.loop].backs + 1;
    }
    ret err[Found].ok{};
}

fun block(k: *Walk, b: u32, seq: u32, next: u32, after: u32) err[Found] {
    val succs: Slice[u32] = graph.successors(k.g, b);
    if (succs.size > 1) { ret broken(where(k, b), "a block that branches more than one way heads no selection"); }
    if (succs.size == 0) {
        if (next != NONE) { ret broken(where(k, construct(k, seq, b)), "a region does not go on to the region after it"); }
        ret err[Found].ok{};
    }
    val y: u32 = succs.data[0];
    if (next != NONE) {
        if (y == after) { ret err[Found].ok{}; }
        ret stray(k, b, y, seq);
    }
    if (y == k.frames.data[seq].exit) { ret err[Found].ok{}; }
    ret crossing(k, b, y, seq);
}

fun arms(k: *Walk, x: u32, seq: u32) err[Found] {
    val r:     Region     = at(k, x);
    val succs: Slice[u32] = graph.successors(k.g, r.block);
    var arm:   u32        = r.child;
    var i:     usize      = 0;
    for (arm != NONE) {
        val y:    u32 = succs.data[i];
        val head: u32 = at(k, arm).child;
        if (head != NONE) {
            if (at(k, head).block != y) { ret broken(where(k, r.block), "an arm does not start at its edge's target"); }
        }
        or (y != r.merge) {
            val crossed: err[Found] = crossing(k, r.block, y, seq);
            if (sel crossed.err) { ret crossed; }
        }
        arm = at(k, arm).next;
        i   = i + 1;
    }
    ret err[Found].ok{};
}

# check every region against the edges of the blocks it names
fun edges(k: *Walk) err[Found] {
    var x: u32 = 0;
    for (x < region.count(k.s)) {
        val r: Region = at(k, x);
        if (k.frames.data[x].seen && !(sel r.kind.sequence)) {
            val seq:   u32 = k.frames.data[x].up;
            var after: u32 = NONE;
            if (r.next != NONE) { after = at(k, r.next).block; }
            var found: err[Found] = err[Found].ok{};
            if (sel r.kind.block) { found = block(k, r.block, seq, r.next, after); }
            or {
                if (sel r.kind.selection)             { found = arms(k, x, seq); }
                if (sel found.ok && r.merge != after) { found = broken(where(k, r.block), "a construct's merge is not the region after it"); }
            }
            if (sel found.err) { ret found; }
        }
        x = x + 1;
    }
    x = 0;
    for (x < region.count(k.s)) {
        val r: Region = at(k, x);
        if (k.frames.data[x].seen && sel r.kind.loop && k.frames.data[x].backs != 1) { ret broken(where(k, r.block), "a loop is entered back by other than one edge"); }
        x = x + 1;
    }
    ret err[Found].ok{};
}

fun walk(k: *Walk) err[Found] {
    val placed: err[Found] = place(k);
    if (sel placed.err) { ret placed; }
    val whole: err[Found] = covered(k);
    if (sel whole.err) { ret whole; }
    ret edges(k);
}

fun function(m: *Module, f: Function, trees: Trees) err[Found] {
    val of:   Tree                     = trees.of;
    val held: res[*Structure, Missing] = of(trees.holder, f);
    if (sel held.err) {
        if (sel held.err.alloc) { ret exhausted(held.err.alloc); }
        ret broken(in_function(m, f), held.err.reason);
    }
    var g:    Graph;
    var d:    Dominance;
    val read: err[Found] = flow.shape(m, f, ?g, ?d);
    if (sel read.err) { ret read; }
    fin {
        dominance.dnit(?d);
        graph.dnit(?g);
    }
    var k: Walk = Walk{m: m, f: f, g: ?g, d: ?d, s: held.ok, frames: vector.init[Frame](m.a), spots: vector.init[Spot](m.a), stack: vector.init[u32](m.a)};
    fin {
        vector.dnit[Frame](?k.frames);
        vector.dnit[Spot](?k.spots);
        vector.dnit[u32](?k.stack);
    }
    val none:   Frame                = Frame{up: NONE, exit: NONE, brk: NONE, cont: NONE, head: NONE, loop: NONE, enter: 0, leave: 0, backs: 0, seen: false};
    var failed: err[allocator.Error] = fill[Frame](?k.frames, region.count(held.ok)::usize, none);
    keep(?failed, fill[Spot](?k.spots, g.count::usize, Spot{named: 0, scope: NONE, role: NONE}));
    if (sel failed.err) { ret exhausted(failed.err); }
    ret walk(?k);
}

# past legalisation on a target that declares structured control, every
# function with a body is the structured tree its structure analysis holds
pub fun structured(run: *Run) err[Found] {
    if (!(sel run.stage.legal))                    { ret err[Found].ok{}; }
    if (!(sel run.target.caps.control.structured)) { ret err[Found].ok{}; }
    val trees: Trees = run.stage.legal;
    var f:     usize = 0;
    for (f < run.m.functions.len) {
        if (run.m.functions.data[f].body.blocks.len != 0) {
            val r: err[Found] = function(run.m, Function{index: f::u32}, trees);
            if (sel r.err) { ret r; }
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}
