# the debug rule: every location, inlining site and binding an instruction
# carries names a live entry of the module's debug table

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.block.BlockData;
use mirl.ir.debug;
use mirl.ir.debug.Binding;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;

# whether every debug entry a metadata record names is in the module's tables
fun live(m: *Module, md: Metadata) bool {
    if (sel md.location.some) {
        val p: res[debug.Position, debug.Error] = debug.position(?m.debug, md.location.some);
        if (sel p.err) { ret false; }
    }
    if (sel md.site.some) {
        val s: res[debug.Inlining, debug.Error] = debug.inlining(?m.debug, md.site.some);
        if (sel s.err) { ret false; }
    }
    val list: res[Slice[Binding], module.Error] = module.bound(m, md.bindings);
    if (sel list.err) { ret false; }
    var i: usize = 0;
    for (i < list.ok.size) {
        val v: res[debug.Variable, debug.Error] = debug.variable(?m.debug, list.ok.data[i]);
        if (sel v.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every walked instruction's location, site and bindings are entries of the debug table
pub fun entries(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData = ?b.blocks.data[k];
            var i:  usize      = 0;
            for (!bd.erased && i < bd.instructions.len) {
                val inst: Instruction = bd.instructions.data[i];
                if (!live(m, b.instructions.data[inst.index].metadata)) { ret broken(at_instruction(m, fn, Block{index: k::u32}, inst), "debug metadata naming no entry of the debug table"); }
                i = i + 1;
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}
