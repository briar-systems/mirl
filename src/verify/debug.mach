# the debug rule: every location, inlining site and binding an instruction
# carries names a live entry of the module's debug table, and every global's
# debug variable is one of its bindings, with no parameter position

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.block.BlockData;
use mirl.ir.debug.place;
use mirl.ir.debug.record;
use mirl.ir.debug.record.Binding;
use debug_table: mirl.ir.debug.table;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.verify.failure.Error;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_global;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.walks;

# whether every debug entry a metadata record names is in the module's tables
fun live(m: *Module, md: Metadata) bool {
    if (sel md.location.some) {
        val res_position: res[record.Position, debug_table.Error] = place.position(?m.debug, md.location.some);
        if (sel res_position.err) { ret false; }
    }
    if (sel md.site.some) {
        val res_inlining: res[record.Inlining, debug_table.Error] = place.inlining(?m.debug, md.site.some);
        if (sel res_inlining.err) { ret false; }
    }
    val res_list: res[Slice[Binding], module.Error] = module.bound(m, md.bindings);
    if (sel res_list.err) { ret false; }
    var i: usize = 0;
    for (i < res_list.ok.size) {
        val res_variable: res[record.Variable, debug_table.Error] = place.variable(?m.debug, res_list.ok.data[i]);
        if (sel res_variable.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a global's debug variable, when it states one, is a variable of the debug table and no parameter
fun described(m: *Module, g: usize) bool {
    val opt_debug_binding: opt[Binding] = m.globals.data[g].data.debug;
    if (sel opt_debug_binding.none) { ret true; }
    val res_variable: res[record.Variable, debug_table.Error] = place.variable(?m.debug, opt_debug_binding.some);
    if (sel res_variable.err) { ret false; }
    ret sel res_variable.ok.parameter.none;
}

# every walked instruction's location, site and bindings, and every global's variable, are entries of the debug table
pub fun entries(run: *Run) err[Error] {
    val m: *Module = run.m;
    var g: usize   = 0;
    for (g < m.globals.len) {
        if (!described(m, g)) { ret broken(at_global(m, (g::u32)), "a global's debug variable naming no variable of the debug table, or a parameter"); }
        g = g + 1;
    }
    var f: usize = 0;
    for (f < m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val fn: Function = (f::u32);
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData  = ?b.blocks.data[k];
            var i:  Instruction = bd.first;
            for (!bd.erased && i != NO_INSTRUCTION) {
                val inst: Instruction = i;
                if (!live(m, b.instructions.data[inst].metadata)) { ret broken(at_instruction(m, fn, (k::u32), inst), "debug metadata naming no entry of the debug table"); }
                i = b.instructions.data[i].next;
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}
