# the rule table and the verifier that walks it
#
# a rule is a row: its id, a short description and its check. the rows run in
# order, each over the whole module, so a later rule reads only what the
# earlier ones hold, and the first rule broken is the refusal.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.allocator.testing;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.section;
use mink.model.symbol;
use mirl.build;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
