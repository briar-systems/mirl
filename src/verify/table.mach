# the rule table and the verifier that walks it
#
# a rule is a row: its id, a short description and its check. the rows run in
# order, each over the whole module, so a later rule reads only what the
# earlier ones hold, and the first rule broken is the refusal.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use core_state: masc.core.state;
use mirl.ir.module;

use mirl.ir.module.Module;
use mirl.target;
use mirl.target.Target;
use mirl.verify.body;
use mirl.verify.call;
use mirl.verify.control;
use rules_debug: mirl.verify.debug;
use mirl.verify.failure;
use mirl.verify.failure.Check;
use mirl.verify.failure.Error;
use mirl.verify.failure.Failure;
use mirl.verify.failure.Found;
use mirl.verify.failure.Rule;
use mirl.verify.failure.Run;
use mirl.verify.failure.Stage;
use mirl.verify.failure.Where;
use mirl.verify.flow;
use tables: mirl.verify.module;
use mirl.verify.secret;
use mirl.verify.typing;

# one rule, whose id is its position in the table
# ---
# name:  its short name
# what:  what it holds of a module
# check: its check
pub rec Row {
    name:  str;
    what:  str;
    check: Check;
}

pub val TARGET:         Rule = Rule{index: 0};
pub val WIDTH:          Rule = Rule{index: 1};
pub val LAYOUT:         Rule = Rule{index: 2};
pub val CONSTANT:       Rule = Rule{index: 3};
pub val INITIAL:        Rule = Rule{index: 4};
pub val ATTRIBUTE:      Rule = Rule{index: 5};
pub val REFERENCE:      Rule = Rule{index: 6};
pub val TERMINATOR:     Rule = Rule{index: 7};
pub val EDGE:           Rule = Rule{index: 8};
pub val TYPING:         Rule = Rule{index: 9};
pub val SECRECY:        Rule = Rule{index: 10};
pub val DOMINANCE:      Rule = Rule{index: 11};
pub val DEBUG:          Rule = Rule{index: 12};
pub val BINDING:        Rule = Rule{index: 13};
pub val STRUCTURED:     Rule = Rule{index: 14};
pub val CALL:           Rule = Rule{index: 15};
pub val LINKAGE:        Rule = Rule{index: 16};
pub val PLACEMENT:      Rule = Rule{index: 17};
pub val THREAD:         Rule = Rule{index: 18};
pub val ADDRESSING:     Rule = Rule{index: 19};
pub val FUNCTIONS:      Rule = Rule{index: 20};
pub val CONVENTION:     Rule = Rule{index: 21};
pub val ASSEMBLY:       Rule = Rule{index: 22};
pub val OP:             Rule = Rule{index: 23};
pub val SPECIALIZATION: Rule = Rule{index: 24};
pub val HANDLE:         Rule = Rule{index: 25};
pub val EXTENSIONS:     Rule = Rule{index: 26};
pub val SECRET:         Rule = Rule{index: 27};

def Rows: [28]Row;

val ROWS: Rows = [28]Row{
    Row{name: "target", what: "the module names a tuple that assembles to the target, which declares every fact", check: tables.target_named},
    Row{name: "width", what: "every integer width is 1 or a power of two from 8 to 512", check: tables.widths},
    Row{name: "layout", what: "every pointer names an address space the target's data layout states, every defined global's type has an extent in the default space, and every structure's stated offsets and every array's stated stride are ones a space of the target's data layout keeps", check: tables.offsets},
    Row{name: "constant", what: "every constant is of its type, and an address names a function or global", check: tables.constants},
    Row{name: "initial", what: "every global's initial value is a constant of its type", check: tables.initials},
    Row{name: "attribute", what: "every attribute is one its target's family schema defines, of its entry's datum kind and attachment, and keeps its entry's rule", check: tables.attributes},
    Row{name: "reference", what: "every id a block or instruction names is one its body holds and has not removed", check: body.references},
    Row{name: "terminator", what: "every block ends in exactly one terminator, with none before it", check: body.terminators},
    Row{name: "edge", what: "every edge passes its target's parameters in count and type and leads to a block other than the entry, and the entry takes the signature's, or one per place once placed", check: body.edges},
    Row{name: "typing", what: "every instruction is an instance its opcode's row types, giving the results it holds, and a stack slot's pointer is into the target's slot space", check: typing.typing},
    Row{name: "secrecy", what: "every result is secret exactly as its row's secrecy rule gives, and no edge makes a secret public", check: typing.secrecy},
    Row{name: "dominance", what: "every use in a reached block is dominated by its definition", check: flow.ssa},
    Row{name: "debug", what: "every location, inlining site and binding names an entry of the debug table, and every global's debug variable is a variable of it and no parameter", check: rules_debug.entries},
    Row{name: "binding", what: "every value binding record stands before an instruction of its block, names a variable and reads a value that dominates its point through an expression that applies to it", check: flow.bindings},
    Row{name: "structured", what: "past legalisation on a target that declares structured control, every function is the structured tree of regions its structure analysis holds", check: control.structured},
    Row{name: "call", what: "every call whose callee is a function of the module states the extension of each parameter and result that function's signature does", check: call.calls},
    Row{name: "linkage", what: "every function and global another module defines has a binding other objects may refer to, and every exported one is defined and seen by other images", check: tables.linkages},
    Row{name: "placement", what: "every section a global states is thread-local exactly when it is, writable unless it is constant, and zero filled only for a global it may write whose initial value is every bit zero, and a function states a section or an alignment only on a target that honours it, and every section it states executes", check: tables.placements},
    Row{name: "thread", what: "no global's initial value holds the address of a thread-local global", check: tables.threads},
    Row{name: "addressing", what: "past legalisation on a target that declares logical addressing, no instruction forms or reads an address as a number", check: body.addressing},
    Row{name: "functions", what: "code names a function's address only through func.addr, on a target whose code has function addresses, whose function immediate names a function of the module, and a call names the function it calls as its callee", check: body.functions},
    Row{name: "convention", what: "every function type names no convention row, for its target's default, or one of the rows its target states", check: tables.conventions},
    Row{name: "assembly", what: "every immediate an inline assembly block binds is a constant, an integer or, where a symbol may stand for it, an address", check: body.assembly},
    Row{name: "op", what: "every target op names an instruction set of its target's catalog and an op in it, passes the operands and states the results the op's row binds, declares the memory the row touches, and, where a build is open, its selection admits the row's requirement", check: body.ops},
    Row{name: "specialization", what: "every specialization constant agrees with every other of its id, on a target that states it to its consumer or folds it before legalisation ends", check: tables.specializations},
    Row{name: "handle", what: "every handle type is of a kind its target's family mints, with the operands its kind's row takes", check: tables.handles},
    Row{name: "extensions", what: "every extension a function admits past the build's is named, and named once", check: tables.extensions},
    Row{name: "secret", what: "every secret range of a global lies within its storage, the public flag stands only on an access that states its secrecy, with no secret result or operand, and every read of bytes of a global the ir places at a secret range states a secret result", check: secret.globals},
};

# the number of rules
pub fun rows() usize {
    ret $length_of(Rows);
}

# the row of a rule, none for an id past the last
pub fun row(r: Rule) opt[Row] {
    if (r.index::usize >= rows()) { ret opt[Row].none{}; }
    ret opt[Row].some{ROWS[r.index]};
}

fun refused(rule: Rule, at: Where, what: str) err[Error] {
    ret err[Error].err{Error.refused{Failure{rule: rule, at: at, what: what}}};
}

# verify a module against a target
#
# the verifier allocates from the module's allocator, and gives everything back.
# ---
# m:     the module
# t:     the target the module names
# ctx:   the context the build's selection opened, which types are laid out
#        under, `target.NO_BUILD` where no family opened one
# stage: how far the module has come, open before legalisation
# ret:   ok when every rule holds, the first rule broken, or the allocator's
#        refusal, which is never an answer of valid
pub fun against(m: *Module, t: *Target, ctx: opt[*core_state.Context], stage: Stage) err[Error] {
    var run: Run   = Run{m: m, target: t, layout: target.of(t, ?m.types, ctx), stage: stage};
    var i:   usize = 0;
    for (i < rows()) {
        val rule: Check      = ROWS[i].check;
        val r:    err[Found] = rule(?run);
        if (sel r.err) {
            if (sel r.err.alloc) { ret err[Error].err{Error.alloc{r.err.alloc}}; }
            ret refused(Rule{index: i::u32}, r.err.broken.at, r.err.broken.what);
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# verify a module before legalisation against the target its tuple
# assembles to
# ---
# m:   the module
# ret: ok when every rule holds, the target rule's refusal naming the rule of
#      assembly the tuple breaks, the first rule broken, or the allocator's
#      refusal
pub fun check(m: *Module) err[Error] {
    val made: res[Target, target.Refusal] = target.assemble(m.a, module.target(m));
    if (sel made.err) {
        if (sel made.err.alloc) { ret err[Error].err{Error.alloc{made.err.alloc}}; }
        ret refused(TARGET, failure.module_wide(), target.rule(made.err));
    }
    var t: Target = made.ok;
    fin { target.release(m.a, ?t); }
    ret against(m, ?t, target.NO_BUILD, Stage.open{});
}
