# one rule, whose id is its position in the table
# ---
# name:  its short name
# what:  what it holds of a module
# check: its check
pub rec Row {
    name:  str;
    what:  str;
    check: Check;
}

pub val TARGET:     Rule = Rule{index: 0};
pub val WIDTH:      Rule = Rule{index: 1};
pub val LAYOUT:     Rule = Rule{index: 2};
pub val CONSTANT:   Rule = Rule{index: 3};
pub val INITIAL:    Rule = Rule{index: 4};
pub val ATTRIBUTE:  Rule = Rule{index: 5};
pub val REFERENCE:  Rule = Rule{index: 6};
pub val TERMINATOR: Rule = Rule{index: 7};
pub val EDGE:       Rule = Rule{index: 8};
pub val TYPING:     Rule = Rule{index: 9};
pub val SECRECY:    Rule = Rule{index: 10};
pub val DOMINANCE:  Rule = Rule{index: 11};
pub val DEBUG:      Rule = Rule{index: 12};
pub val BINDING:    Rule = Rule{index: 13};
pub val STRUCTURED: Rule = Rule{index: 14};
pub val CALL:       Rule = Rule{index: 15};
pub val LINKAGE:    Rule = Rule{index: 16};
pub val PLACEMENT:  Rule = Rule{index: 17};
pub val THREAD:     Rule = Rule{index: 18};

def Rows: [19]Row;

val ROWS: Rows = [19]Row{
    Row{name: "target", what: "the module names a target of mirl.target's rows that declares every fact", check: tables.target_named},
    Row{name: "width", what: "every integer width is 1 or a power of two from 8 to 512", check: tables.widths},
    Row{name: "layout", what: "every structure's stated offsets are ones the target's data layout keeps", check: tables.offsets},
    Row{name: "constant", what: "every constant is of its type, and an address names a function or global", check: tables.constants},
    Row{name: "initial", what: "every global's initial value is a constant of its type", check: tables.initials},
    Row{name: "attribute", what: "every attribute is of a family the target accepts", check: tables.attributes},
    Row{name: "reference", what: "every id a block or instruction names is one its body holds and has not removed", check: body.references},
    Row{name: "terminator", what: "every block ends in exactly one terminator, with none before it", check: body.terminators},
    Row{name: "edge", what: "every edge passes its target's parameters in count and type, and the entry takes the signature's, or one per place once placed", check: body.edges},
    Row{name: "typing", what: "every instruction is an instance its opcode's row types, giving the results it holds", check: typing.typing},
    Row{name: "secrecy", what: "every result is secret exactly as its row's secrecy rule gives, and no edge makes a secret public", check: typing.secrecy},
    Row{name: "dominance", what: "every use in a reached block is dominated by its definition", check: flow.ssa},
    Row{name: "debug", what: "every location, inlining site and binding names an entry of the debug table", check: rules_debug.entries},
    Row{name: "binding", what: "every value binding record stands before an instruction of its block, names a variable and reads a value that dominates its point through an expression that applies to it", check: flow.bindings},
    Row{name: "structured", what: "past legalisation on a target that declares structured control, every function is the structured tree of regions its structure analysis holds", check: control.structured},
    Row{name: "call", what: "every call whose callee is a function of the module states the extension of each parameter and result that function's signature does", check: call.calls},
    Row{name: "linkage", what: "every function and global another module defines has a binding other objects may refer to", check: tables.linkages},
    Row{name: "placement", what: "every section a global states is thread-local exactly when it is, writable unless it is constant, and zero filled only for a global it may write whose initial value is every bit zero", check: tables.placements},
    Row{name: "thread", what: "no global's initial value holds the address of a thread-local global", check: tables.threads},
};

# the number of rules
pub fun rows() usize {
    ret $length_of(Rows);
}

# the row of a rule, none for an id past the last
pub fun row(r: Rule) opt[Row] {
    if (r.index::usize >= rows()) { ret opt[Row].none{}; }
    ret opt[Row].some{ROWS[r.index]};
}

fun refused(rule: Rule, at: Where, what: str) err[Error] {
    ret err[Error].err{Error.refused{Failure{rule: rule, at: at, what: what}}};
}

# verify a module against a target
#
# the verifier allocates from the module's allocator, and gives everything back.
# ---
# m:     the module
# t:     the target the module names
# stage: how far the module has come, open before legalisation
# ret:   ok when every rule holds, the first rule broken, or the allocator's
#        refusal, which is never an answer of valid
pub fun against(m: *Module, t: *Target, stage: Stage) err[Error] {
    var run: Run   = Run{m: m, target: t, layout: target.of(t, ?m.types), stage: stage};
    var i:   usize = 0;
    for (i < rows()) {
        val rule: Check      = ROWS[i].check;
        val r:    err[Found] = rule(?run);
        if (sel r.err) {
            if (sel r.err.alloc) { ret err[Error].err{Error.alloc{r.err.alloc}}; }
            ret refused(Rule{index: i::u32}, r.err.broken.at, r.err.broken.what);
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the row of mirl.target's that a module's tuple is, none when no row is
fun named(m: *Module) opt[*Target] {
    ret target.row_of(module.target(m));
}

# verify a module before legalisation against the target of mirl.target's
# rows it names
# ---
# m:   the module
# ret: ok when every rule holds, the target rule's refusal when no row has the
#      module's target name, the first rule broken, or the allocator's refusal
pub fun check(m: *Module) err[Error] {
    val t: opt[*Target] = named(m);
    if (sel t.some) { ret against(m, t.some, Stage.open{}); }
    ret refused(TARGET, failure.module_wide(), "the module names no target of mirl.target's rows");
}

# a well-formed module and the ids its malformed copies break
rec Case {
    m:       Module;
    f:       Function;
    g:       Function;
    entry:   Block;
    then:    Block;
    other:   Block;
    join:    Block;
    c:       Value;
    x:       Value;
    p:       Value;
    s:       Value;
    sum:     Instruction;
    split:   Instruction;
    total:   Instruction;
    call:    Instruction;
    seven:   Constant;
    addr:    Constant;
    pair:    Constant;
    counter: Global;
    i32:     Type;
    ptr:     Type;
    shape:   Type;
    signed:  Type;
    tree:    Structure;
    legal:   bool;
}

fun intern(m: *Module, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(?m.types, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun values(data: *Value, size: usize) Slice[Value] {
    ret Slice[Value]{data: data, size: size};
}

fun op(code: opcode.Opcode, operands: Slice[Value], targets: Slice[Branch]) Request {
    ret Request{opcode: code, operands: operands, immediates: Slice[opcode.Immediate]{data: nil, size: 0}, targets: targets};
}

fun none() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

# f(c: i1, x: i32, y: i32) i32 branches on c to `then` passing x + y or to
# `other`, both join passing a value, and join returns it plus y. a global
# holds an aggregate of the address of another and a constant, the sum
# carries a location, and a record binds a variable to it before the branch.
#[testing]
fun fixture(a: *allocator.Allocator, c: *Case) bool {
    val made: res[Module, module.Error] = module.init(a, module.TESTING);
    if (sel made.err) { ret false; }
    c.m = made.ok;
    val m: *Module = ?c.m;

    val i1: Type = intern(m, types.Shape.integer{types.Integer{width: 1}});
    c.i32 = intern(m, types.Shape.integer{types.Integer{width: 32}});
    c.ptr = intern(m, types.Shape.pointer{types.Pointer{space: 0}});
    var members: [2]Type = [2]Type{c.ptr, c.i32};
    var at:      [2]u64  = [2]u64{0, 8};
    c.shape = intern(m, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?members[0], size: 2}, offsets: opt[Slice[u64]].some{Slice[u64]{data: ?at[0], size: 2}}}});
    var params:  [3]Type = [3]Type{i1, c.i32, c.i32};
    var results: [1]Type = [1]Type{c.i32};
    val sig:     Type    = intern(m, types.Shape.function{types.plain(Slice[Type]{data: ?params[0], size: 3}, Slice[Type]{data: ?results[0], size: 1})});

    var b:     build.Builder = build.init(m);
    var seven: [1]u64        = [1]u64{7};
    c.seven   = build.constant(?b, ConstantData.integer{Bits{type: c.i32, words: Slice[u64]{data: ?seven[0], size: 1}}});
    c.counter = build.global(?b, GlobalData{name: View{data: "counter", len: 7}, type: c.i32, initial: opt[Constant].some{c.seven}, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    c.addr    = build.constant(?b, ConstantData.address{Address{type: c.ptr, symbol: Symbol.global{c.counter}, offset: 0}});
    var elements: [2]Constant = [2]Constant{c.addr, c.seven};
    c.pair = build.constant(?b, ConstantData.aggregate{Aggregate{type: c.shape, elements: Slice[Constant]{data: ?elements[0], size: 2}}});
    build.global(?b, GlobalData{name: View{data: "table", len: 5}, type: c.shape, initial: opt[Constant].some{c.pair}, linkage: Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.HIDDEN}});

    c.f = build.function(?b, FunctionData{name: View{data: "f", len: 1}, signature: sig, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    var taken: [1]Type            = [1]Type{c.i32};
    var kinds: [1]types.Extension = [1]types.Extension{types.Extension.sext{}};
    c.signed = build.signature(?b, types.Function{
        params:     Slice[Type]{data: ?taken[0], size: 1},
        results:    Slice[Type]{data: nil, size: 0},
        param_ext:  Slice[types.Extension]{data: ?kinds[0], size: 1},
        result_ext: Slice[types.Extension]{data: nil, size: 0},
    });
    c.g = build.function(?b, FunctionData{name: View{data: "g", len: 1}, signature: c.signed, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    val callee: Constant = build.constant(?b, ConstantData.address{Address{type: c.ptr, symbol: Symbol.function{c.g}, offset: 0}});
    build.enter(?b, c.f);
    var decls: [3]Declaration = [3]Declaration{Declaration{type: i1, secret: false}, Declaration{type: c.i32, secret: false}, Declaration{type: c.i32, secret: false}};
    c.entry = build.block(?b, Slice[Declaration]{data: ?decls[0], size: 3});
    c.then  = build.block(?b, Slice[Declaration]{data: ?decls[1], size: 1});
    c.other = build.block(?b, Slice[Declaration]{data: nil, size: 0});
    c.join  = build.block(?b, Slice[Declaration]{data: ?decls[1], size: 1});
    c.c     = build.parameter(?b, c.entry, 0);
    c.x     = build.parameter(?b, c.entry, 1);
    val y: Value = build.parameter(?b, c.entry, 2);
    c.p = build.parameter(?b, c.then, 0);
    val q: Value = build.parameter(?b, c.join, 0);
    if (build.failed(?b)) { ret false; }

    val file: res[debug.File, debug.Error] = debug.file(?m.debug, View{data: "f.mach", len: 6});
    if (sel file.err) { ret false; }
    val loc: res[debug.Location, debug.Error] = debug.location(?m.debug, debug.Position{file: file.ok, line: 1, column: 1});
    if (sel loc.err) { ret false; }
    val int: res[debug.Declared, debug.Error] = debug.declare(?m.debug, ?m.types, debug.Entry{key: View{data: "i32", len: 3}, name: View{data: "int", len: 3}, head: debug.Head.base{debug.Base{encoding: debug.Encoding.signed{}, width: 32}}});
    if (sel int.err)         { ret false; }
    if (!(sel int.ok.fresh)) { ret false; }
    val bound: res[debug.Binding, debug.Error] = debug.bind(?m.debug, debug.Variable{name: View{data: "s", len: 1}, type: int.ok.fresh, declared: loc.ok});
    if (sel bound.err) { ret false; }

    build.at_end(?b, c.entry);
    build.locate(?b, opt[debug.Location].some{loc.ok});
    var xy: [2]Value = [2]Value{c.x, y};
    c.sum = build.emit(?b, op(opcode.ADD, values(?xy[0], 2), none()));
    c.s   = build.result(?b, c.sum, 0);
    build.locate(?b, opt[debug.Location].none{});
    build.bind_at(?b, bound.ok, Reads.operand{Operand{value: c.s, expression: point.PLAIN}});
    var into:  [1]Value  = [1]Value{c.s};
    var cond:  [1]Value  = [1]Value{c.c};
    var sides: [2]Branch = [2]Branch{Branch{block: c.then, arguments: values(?into[0], 1)}, Branch{block: c.other, arguments: values(nil, 0)}};
    c.split = build.emit(?b, op(opcode.CBR, values(?cond[0], 1), Slice[Branch]{data: ?sides[0], size: 2}));
    build.at_end(?b, c.then);
    var from_then: [1]Value  = [1]Value{c.p};
    var to_join:   [1]Branch = [1]Branch{Branch{block: c.join, arguments: values(?from_then[0], 1)}};
    build.emit(?b, op(opcode.BR, values(nil, 0), Slice[Branch]{data: ?to_join[0], size: 1}));
    build.at_end(?b, c.other);
    var through: [2]Value            = [2]Value{build.use_constant(?b, callee), c.x};
    var stated:  [2]opcode.Immediate = [2]opcode.Immediate{opcode.Immediate.ty{c.signed}, opcode.Immediate.named{Named.all{}}};
    c.call = build.emit(?b, Request{opcode: opcode.CALL, operands: values(?through[0], 2), immediates: Slice[opcode.Immediate]{data: ?stated[0], size: 2}, targets: none()});
    var from_other: [1]Value  = [1]Value{c.x};
    var other_join: [1]Branch = [1]Branch{Branch{block: c.join, arguments: values(?from_other[0], 1)}};
    build.emit(?b, op(opcode.BR, values(nil, 0), Slice[Branch]{data: ?other_join[0], size: 1}));
    build.at_end(?b, c.join);
    var qy: [2]Value = [2]Value{q, y};
    c.total = build.emit(?b, op(opcode.ADD, values(?qy[0], 2), none()));
    var back: [1]Value = [1]Value{build.result(?b, c.total, 0)};
    build.emit(?b, op(opcode.RET, values(?back[0], 1), none()));
    val ended: err[build.Failure] = build.done(?b);
    ret sel ended.ok;
}

fun body_of(c: *Case) *Body {
    ret ?c.m.functions.data[c.f.index].body;
}

fun break_target(c: *Case) bool {
    c.m.target.system = View{data: "nowhere", len: 7};
    ret true;
}

fun break_width(c: *Case) bool {
    c.m.types.nodes.data[c.i32.index].shape = types.Shape.integer{types.Integer{width: 12}};
    ret true;
}

fun break_layout(c: *Case) bool {
    val o: res[opt[Slice[u64]], types.Error] = types.offsets(?c.m.types, c.shape);
    if (sel o.err)        { ret false; }
    if (!(sel o.ok.some)) { ret false; }
    o.ok.some.data[1] = 9;
    ret true;
}

fun break_constant(c: *Case) bool {
    c.m.constants.data[c.addr.index] = ConstantData.address{Address{type: c.ptr, symbol: Symbol.global{Global{index: 99}}, offset: 0}};
    ret true;
}

fun break_initial(c: *Case) bool {
    c.m.globals.data[c.counter.index].data.initial = opt[Constant].some{c.pair};
    ret true;
}

fun break_attribute(c: *Case) bool {
    val at: err[module.Error] = module.attach(?c.m, Symbol.function{c.f}, Attribute{family: View{data: "spirv", len: 5}, name: View{data: "stage", len: 5}, datum: Datum.integer{0}});
    ret sel at.ok;
}

fun break_reference(c: *Case) bool {
    body_of(c).instructions.data[c.total.index].operands.data[1] = Value{index: 9999};
    ret true;
}

fun break_terminator(c: *Case) bool {
    val list:  *vector.Vector[Instruction] = ?body_of(c).blocks.data[c.join.index].instructions;
    val first: Instruction                 = list.data[0];
    list.data[0] = list.data[1];
    list.data[1] = first;
    ret true;
}

fun break_edge(c: *Case) bool {
    body_of(c).instructions.data[c.split.index].edges.data[0].arguments.data[0] = c.c;
    ret true;
}

fun break_operands(c: *Case) bool {
    body_of(c).instructions.data[c.sum.index].operands.data[0] = c.c;
    ret true;
}

fun break_condition(c: *Case) bool {
    body_of(c).instructions.data[c.split.index].operands.data[0] = c.x;
    ret true;
}

fun break_secrecy(c: *Case) bool {
    body_of(c).values.data[c.s.index].secret = true;
    ret true;
}

fun break_dominance(c: *Case) bool {
    body_of(c).instructions.data[c.total.index].operands.data[0] = c.p;
    ret true;
}

fun break_debug(c: *Case) bool {
    body_of(c).instructions.data[c.sum.index].metadata.location = opt[debug.Location].some{debug.Location{index: 99}};
    ret true;
}

fun break_binding(c: *Case) bool {
    val total: Value = body_of(c).instructions.data[c.total.index].results.data[0];
    body_of(c).points.data[0].reads = Reads.operand{Operand{value: total, expression: point.PLAIN}};
    ret true;
}

# f past legalisation for a target that declares structured control, with a
# tree whose first arm starts at the second edge's target
fun break_structured(c: *Case) bool {
    c.tree = region.init(c.m.a);
    val s:    *Structure                = ?c.tree;
    val none: u32                       = NONE;
    val root: res[u32, allocator.Error] = region.add(s, Kind.sequence{}, none);
    if (sel root.err) { ret false; }
    val split: res[u32, allocator.Error] = region.under(s, root.ok, none, Kind.selection{}, c.entry.index);
    if (sel split.err) { ret false; }
    s.regions.data[split.ok].merge = c.join.index;
    val first: res[u32, allocator.Error] = region.under(s, split.ok, none, Kind.sequence{}, none);
    if (sel first.err) { ret false; }
    val other: res[u32, allocator.Error] = region.under(s, first.ok, none, Kind.block{}, c.other.index);
    if (sel other.err) { ret false; }
    val second: res[u32, allocator.Error] = region.under(s, split.ok, first.ok, Kind.sequence{}, none);
    if (sel second.err) { ret false; }
    val then: res[u32, allocator.Error] = region.under(s, second.ok, none, Kind.block{}, c.then.index);
    if (sel then.err) { ret false; }
    val join: res[u32, allocator.Error] = region.under(s, root.ok, split.ok, Kind.block{}, c.join.index);
    if (sel join.err) { ret false; }
    c.legal = true;
    ret true;
}

# the call states its callee's parameter with no extension
fun break_call(c: *Case) bool {
    var taken: [1]Type = [1]Type{c.i32};
    val bare:  Type    = intern(?c.m, types.Shape.function{types.plain(Slice[Type]{data: ?taken[0], size: 1}, Slice[Type]{data: nil, size: 0})});
    body_of(c).instructions.data[c.call.index].immediates.data[0] = opcode.Immediate.ty{bare};
    ret true;
}

# g, which f calls and another module defines, is bound local to its object
fun break_linkage(c: *Case) bool {
    c.m.functions.data[c.g.index].data.linkage.binding = ?symbol.LOCAL;
    ret true;
}

# counter, which the program writes and whose initial value is seven, states
# a section of a kind that does not hold it, for the reason it gives
fun misplace(c: *Case, kind: *section.Kind) opt[tables.Misplaced] {
    c.m.globals.data[c.counter.index].data.section = opt[global.Section].some{global.Section{name: View{data: ".x", len: 2}, kind: kind}};
    ret tables.misplaced(?c.m, ?c.m.globals.data[c.counter.index]);
}

fun break_filled(c: *Case) bool {
    val why: opt[tables.Misplaced] = misplace(c, ?section.BSS);
    ret sel why.some && sel why.some.filled;
}

fun break_written(c: *Case) bool {
    val why: opt[tables.Misplaced] = misplace(c, ?section.RODATA);
    ret sel why.some && sel why.some.written;
}

fun break_thread(c: *Case) bool {
    val why: opt[tables.Misplaced] = misplace(c, ?section.TLS_DATA);
    ret sel why.some && sel why.some.thread;
}

# counter, whose address table's initial value holds, is thread-local
fun break_address(c: *Case) bool {
    c.m.globals.data[c.counter.index].data.tls = opt[Tls].some{Tls.general_dynamic{}};
    ret true;
}

def Break: fun(*Case) bool;

# a malformed module: the rule it breaks and the one fact it breaks
rec Malformed {
    rule:   Rule;
    breaks: Break;
}

def Cases: [22]Malformed;

val MALFORMED: Cases = [22]Malformed{
    Malformed{rule: TARGET, breaks: break_target},
    Malformed{rule: WIDTH, breaks: break_width},
    Malformed{rule: LAYOUT, breaks: break_layout},
    Malformed{rule: CONSTANT, breaks: break_constant},
    Malformed{rule: INITIAL, breaks: break_initial},
    Malformed{rule: ATTRIBUTE, breaks: break_attribute},
    Malformed{rule: REFERENCE, breaks: break_reference},
    Malformed{rule: TERMINATOR, breaks: break_terminator},
    Malformed{rule: EDGE, breaks: break_edge},
    Malformed{rule: TYPING, breaks: break_operands},
    Malformed{rule: TYPING, breaks: break_condition},
    Malformed{rule: SECRECY, breaks: break_secrecy},
    Malformed{rule: DOMINANCE, breaks: break_dominance},
    Malformed{rule: DEBUG, breaks: break_debug},
    Malformed{rule: BINDING, breaks: break_binding},
    Malformed{rule: STRUCTURED, breaks: break_structured},
    Malformed{rule: CALL, breaks: break_call},
    Malformed{rule: LINKAGE, breaks: break_linkage},
    Malformed{rule: PLACEMENT, breaks: break_filled},
    Malformed{rule: PLACEMENT, breaks: break_written},
    Malformed{rule: PLACEMENT, breaks: break_thread},
    Malformed{rule: THREAD, breaks: break_address},
};

# build the fixture in an arena, break it with one case, and verify it
#[testing]
fun verify_broken(back: *allocator.Allocator, breaks: opt[Break], out: *err[Error]) bool {
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, back, 0);
    if (sel made.err) { ret false; }
    fin { arena.dnit(?ar); }
    var a: allocator.Allocator;
    arena.make(?a, ?ar);
    var c: Case;
    if (!fixture(?a, ?c)) { ret false; }
    if (sel breaks.some) {
        val fault: Break = breaks.some;
        if (!fault(?c)) { ret false; }
    }
    if (!c.legal) {
        @out = check(?c.m);
        ret true;
    }
    val row: opt[*Target] = named(?c.m);
    if (sel row.none) { ret false; }
    var t: Target = @row.some;
    t.caps.control = Control.structured{};
    @out           = against(?c.m, ?t, Stage.legal{control.fixed(?c.tree)});
    ret true;
}

test verify__refuses_each_malformed_module_by_the_rule_it_breaks {
    var back: allocator.Allocator;
    page.make(?back);
    var got: err[Error];
    if (!verify_broken(?back, opt[Break].none{}, ?got)) { ret 1; }
    if (sel got.err)                                    { ret 2; }

    var i: usize = 0;
    for (i < rows()) {
        var named: bool  = false;
        var k:     usize = 0;
        for (k < $length_of(Cases)) {
            if (MALFORMED[k].rule.index::usize == i) { named = true; }
            k = k + 1;
        }
        if (!named) { ret 4; }
        i = i + 1;
    }

    i = 0;
    for (i < $length_of(Cases)) {
        val code: i32 = 16 + (i * 4)::i32;
        if (!verify_broken(?back, opt[Break].some{MALFORMED[i].breaks}, ?got)) { ret code; }
        if (!(sel got.err))                                                    { ret code + 1; }
        if (!(sel got.err.refused))                                            { ret code + 1; }
        if (got.err.refused.rule.index != MALFORMED[i].rule.index)             { ret code + 2; }
        i = i + 1;
    }
    ret 0;
}

test verify__refusal_is_an_internal_failure_record {
    var t: testing.Testing;
    testing.make(?t);
    fin { testing.dnit(?t); }
    var c: Case;
    if (!fixture(testing.allocator_of(?t), ?c)) { ret 1; }
    fin { module.dnit(?c.m); }
    val fine: err[Error] = check(?c.m);
    if (sel fine.err) { ret 2; }
    testing.fail_at_ordinal(?t, testing.attempt_count(?t) + 1);
    val starved: err[Error] = check(?c.m);
    testing.clear_failure(?t);
    if (!(sel starved.err))       { ret 3; }
    if (!(sel starved.err.alloc)) { ret 3; }

    if (!break_operands(?c)) { ret 4; }
    val got: err[Error] = check(?c.m);
    if (!(sel got.err))         { ret 5; }
    if (!(sel got.err.refused)) { ret 5; }
    val f: Failure = got.err.refused;
    if (f.rule.index != TYPING.index)                                               { ret 6; }
    if (!(sel f.at.function.some && f.at.function.some.index == c.f.index))         { ret 7; }
    if (!(sel f.at.block.some && f.at.block.some.index == c.entry.index))           { ret 8; }
    if (!(sel f.at.instruction.some && f.at.instruction.some.index == c.sum.index)) { ret 9; }
    if (!spelled(f.at.name, "f"))                                                   { ret 10; }
    if (f.what == nil)                                                              { ret 11; }
    ret 0;
}

test verify__refuses_an_initial_value_holding_a_thread_local_address {
    var t: testing.Testing;
    testing.make(?t);
    fin { testing.dnit(?t); }
    var c: Case;
    if (!fixture(testing.allocator_of(?t), ?c)) { ret 1; }
    fin { module.dnit(?c.m); }
    if (!break_address(?c)) { ret 2; }
    val got: err[Error] = check(?c.m);
    if (!(sel got.err)) { ret 3; }
    if (sel got.err.refused) {
        val f: Failure = got.err.refused;
        if (f.rule.index != THREAD.index)         { ret 4; }
        if (!spelled(f.at.name, "table"))         { ret 5; }
        if (!spelled(f.at.referenced, "counter")) { ret 6; }
        ret 0;
    }
    ret 3;
}
