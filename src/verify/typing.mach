# the rules the opcode rows state: each instruction's typing and its results' secrecy
#
# the verifier holds no typing rule of its own. it reads each walked
# instruction to the one checker and holds the stored results to the answer,
# and refuses a family's row on a target that family does not serve.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.target.families;
use mirl.target.family.Family;
use mirl.target.family.Unserved;
use mirl.target.record.Target;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;

# what the checker made of an instruction
# ---
# alloc:   the allocator refused storage for the reading
# refused: the row refused the instance
# typed:   the row typed it, its results' secrecy by the row's rule
tag Reading: u8 {
    alloc:   allocator.Error;
    refused: opcode.Error;
    typed:   bool;
}

# read an instruction to the checker, pushing its result types to out
fun read(m: *Module, f: Function, d: *InstructionData, out: *vector.Vector[Type]) Reading {
    val b:   *Body                            = ?m.functions.data[f.index].body;
    val sig: res[types.Function, types.Error] = types.signature(?m.types, m.functions.data[f.index].data.signature);
    if (sel sig.err) { ret Reading.refused{opcode.Error.types{sig.err}}; }

    var total: usize = d.operands.len;
    var e:     usize = 0;
    for (e < d.edges.len) {
        total = total + d.edges.data[e].arguments.len + b.blocks.data[d.edges.data[e].block.index].parameters.len;
        e     = e + 1;
    }
    var tys:     vector.Vector[Type]        = vector.init[Type](m.a);
    var secrets: vector.Vector[bool]        = vector.init[bool](m.a);
    var edges:   vector.Vector[opcode.Edge] = vector.init[opcode.Edge](m.a);
    fin {
        vector.dnit[Type](?tys);
        vector.dnit[bool](?secrets);
        vector.dnit[opcode.Edge](?edges);
    }
    val room: res[usize, allocator.Error] = vector.reserve[Type](?tys, total);
    if (sel room.err) { ret Reading.alloc{room.err}; }
    val marks: res[usize, allocator.Error] = vector.reserve[bool](?secrets, d.operands.len);
    if (sel marks.err) { ret Reading.alloc{marks.err}; }
    val held: res[usize, allocator.Error] = vector.reserve[opcode.Edge](?edges, d.edges.len);
    if (sel held.err) { ret Reading.alloc{held.err}; }

    var i: usize = 0;
    for (i < d.operands.len) {
        vector.push[Type](?tys, b.values.data[d.operands.data[i].index].type);
        vector.push[bool](?secrets, b.values.data[d.operands.data[i].index].secret);
        i = i + 1;
    }
    e = 0;
    for (e < d.edges.len) {
        val edge:   *Edge                 = ?d.edges.data[e];
        val params: *vector.Vector[Value] = ?b.blocks.data[edge.block.index].parameters;
        val first:  usize                 = tys.len;
        var j:      usize                 = 0;
        for (j < edge.arguments.len) {
            vector.push[Type](?tys, b.values.data[edge.arguments.data[j].index].type);
            j = j + 1;
        }
        val second: usize = tys.len;
        j = 0;
        for (j < params.len) {
            vector.push[Type](?tys, b.values.data[params.data[j].index].type);
            j = j + 1;
        }
        vector.push[opcode.Edge](?edges, opcode.Edge{
            arguments:  Slice[Type]{data: ?tys.data[first], size: second - first},
            parameters: Slice[Type]{data: ?tys.data[second], size: tys.len - second},
        });
        e = e + 1;
    }

    var inst: opcode.Instance;
    inst.operands   = Slice[Type]{data: tys.data, size: d.operands.len};
    inst.secret     = Slice[bool]{data: secrets.data, size: secrets.len};
    inst.declared   = d.metadata.secret;
    inst.kept       = d.metadata.flags.kept;
    inst.bounded    = d.metadata.flags.bounded;
    inst.checked    = d.metadata.flags.checked;
    inst.immediates = Slice[opcode.Immediate]{data: d.immediates.data, size: d.immediates.len};
    inst.edges      = Slice[opcode.Edge]{data: edges.data, size: edges.len};
    inst.returns    = sig.ok.results;
    val checked: res[bool, opcode.Error] = opcode.check(?m.types, d.opcode, inst, out);
    if (sel checked.err) {
        if (sel checked.err.alloc) { ret Reading.alloc{checked.err.alloc}; }
        ret Reading.refused{checked.err};
    }
    ret Reading.typed{checked.ok};
}

# whether an instruction's stored results are the row's, in number, type and
# for secrecy whether each is marked as the row's rule gives
fun holds(secrecy: bool, b: *Body, d: *InstructionData, out: *vector.Vector[Type], secret: bool) bool {
    if (!secrecy) {
        if (d.results.len != out.len) { ret false; }
        var i: usize = 0;
        for (i < out.len) {
            if (!types.same(b.values.data[d.results.data[i].index].type, out.data[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    var i: usize = 0;
    for (i < d.results.len) {
        if (b.values.data[d.results.data[i].index].secret != secret) { ret false; }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        var j:    usize = 0;
        for (j < edge.arguments.len) {
            val param: Value = b.blocks.data[edge.block.index].parameters.data[j];
            if (b.values.data[edge.arguments.data[j].index].secret && !b.values.data[param.index].secret) { ret false; }
            j = j + 1;
        }
        e = e + 1;
    }
    ret true;
}

fun mismatch(secrecy: bool) str {
    if (secrecy) { ret "secrecy that is not what its row's rule gives"; }
    ret "results that are not the ones its row derives";
}

# the family that serves a target, none when no one family does
fun serving(t: *Target) opt[*Family] {
    val f: res[*Family, Unserved] = families.served(t);
    if (sel f.err) { ret opt[*Family].none{}; }
    ret opt[*Family].some{f.ok};
}

# whether the target admits an instruction's row. an opcode naming no row is
# the checker's refusal
fun admits(d: *InstructionData, family: opt[*Family]) bool {
    val got: opt[opcode.Row] = opcode.row(d.opcode);
    if (sel got.none) { ret true; }
    var r: opcode.Row = got.some;
    ret opcode.admitted(?r, family);
}

# walk every walked instruction through the checker, holding its results to
# the row's types or to its secrecy, and for typing its row to the target
fun walk(run: *Run, secrecy: bool) err[Found] {
    val m:      *Module             = run.m;
    val family: opt[*Family]        = serving(run.target);
    var out: vector.Vector[Type] = vector.init[Type](m.a);
    fin { vector.dnit[Type](?out); }
    var f: usize = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val id: Block      = Block{index: k::u32};
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction      = bd.instructions.data[i];
                    val d:    *InstructionData = ?b.instructions.data[inst.index];
                    if (!secrecy && !admits(d, family)) { ret broken(at_instruction(m, fn, id, inst), "an opcode of a family that does not serve its target"); }
                    out.len = 0;
                    val r: Reading = read(m, fn, d, ?out);
                    if (sel r.alloc)                                         { ret exhausted(r.alloc); }
                    if (sel r.refused)                                       { ret broken(at_instruction(m, fn, id, inst), "an instance its opcode's row refuses"); }
                    if (sel r.typed && !holds(secrecy, b, d, ?out, r.typed)) { ret broken(at_instruction(m, fn, id, inst), mismatch(secrecy)); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# every walked instruction's row is one its target admits, and the row types
# the instance, giving the results it holds
pub fun typing(run: *Run) err[Found] {
    ret walk(run, false);
}

# every result is secret exactly when its row's secrecy rule says, and no edge passes a secret value to a public parameter
pub fun secrecy(run: *Run) err[Found] {
    ret walk(run, true);
}
