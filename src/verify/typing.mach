# the rules the opcode rows state: each instruction's typing and its results' secrecy
#
# the verifier holds no typing rule of its own. it reads each walked
# instruction to the one checker and holds the stored results to the answer.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.target.record;
use mirl.verify.failure.Error;
use mirl.verify.failure.Failure;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.exhausted;
use mirl.verify.failure.finding;
use mirl.verify.failure.walks;

# what the checker made of an instruction
# ---
# alloc:   the allocator refused storage for the reading
# refused: the row refused the instance
# typed:   the row typed it, its results' secrecy by the row's rule
tag Reading: u8 {
    alloc:   allocator.Error;
    refused: opcode.Error;
    typed:   bool;
}

# the storage a walk reads every instruction into, taken once and reused
# ---
# out:     the result types the checker derives
# tys:     the operand types, then each edge's argument and parameter types
# secrets: whether each operand is secret
# edges:   each edge's arguments and parameters, as slices of tys
rec Scratch {
    out:     vector.Vector[Type];
    tys:     vector.Vector[Type];
    secrets: vector.Vector[bool];
    edges:   vector.Vector[opcode.Edge];
}

# read an instruction of body `b`, whose function's signature is `sig`, to the
# checker, its result types left in the scratch's out
fun read(m: *Module, b: *Body, sig: res[types.Function, types.Error], d: *InstructionData, s: *Scratch) Reading {
    if (sel sig.err) { ret Reading.refused{opcode.Error.types{sig.err}}; }
    vector.truncate[Type](?s.out, 0);
    vector.truncate[Type](?s.tys, 0);
    vector.truncate[bool](?s.secrets, 0);
    vector.truncate[opcode.Edge](?s.edges, 0);

    var total: usize = d.operands.len;
    var e:     usize = 0;
    for (e < d.edges.len) {
        total = total + d.edges.data[e].arguments.len + b.blocks.data[d.edges.data[e].block.index].parameters.len;
        e     = e + 1;
    }
    # the edges' slices point into tys, so it takes all its room before any
    val room: res[usize, allocator.Error] = vector.reserve[Type](?s.tys, total);
    if (sel room.err) { ret Reading.alloc{room.err}; }
    val marks: res[usize, allocator.Error] = vector.reserve[bool](?s.secrets, d.operands.len);
    if (sel marks.err) { ret Reading.alloc{marks.err}; }
    val held: res[usize, allocator.Error] = vector.reserve[opcode.Edge](?s.edges, d.edges.len);
    if (sel held.err) { ret Reading.alloc{held.err}; }

    var i: usize = 0;
    for (i < d.operands.len) {
        vector.push[Type](?s.tys, b.values.data[d.operands.data[i].index].type);
        vector.push[bool](?s.secrets, b.values.data[d.operands.data[i].index].secret);
        i = i + 1;
    }
    e = 0;
    for (e < d.edges.len) {
        val edge:   *Edge                 = ?d.edges.data[e];
        val params: *vector.Vector[Value] = ?b.blocks.data[edge.block.index].parameters;
        val first:  usize                 = s.tys.len;
        var j:      usize                 = 0;
        for (j < edge.arguments.len) {
            vector.push[Type](?s.tys, b.values.data[edge.arguments.data[j].index].type);
            j = j + 1;
        }
        val second: usize = s.tys.len;
        j = 0;
        for (j < params.len) {
            vector.push[Type](?s.tys, b.values.data[params.data[j].index].type);
            j = j + 1;
        }
        vector.push[opcode.Edge](?s.edges, opcode.Edge{
            arguments:  Slice[Type]{data: ?s.tys.data[first], size: second - first},
            parameters: Slice[Type]{data: ?s.tys.data[second], size: s.tys.len - second},
        });
        e = e + 1;
    }

    var inst: opcode.Instance;
    inst.operands   = Slice[Type]{data: s.tys.data, size: d.operands.len};
    inst.secret     = Slice[bool]{data: s.secrets.data, size: s.secrets.len};
    inst.declared   = d.metadata.secret;
    inst.kept       = d.metadata.flags.kept;
    inst.bounded    = d.metadata.flags.bounded;
    inst.checked    = d.metadata.flags.checked;
    inst.trap       = d.metadata.flags.trap;
    inst.immediates = Slice[opcode.Immediate]{data: d.immediates.data, size: d.immediates.len};
    inst.edges      = Slice[opcode.Edge]{data: s.edges.data, size: s.edges.len};
    inst.returns    = sig.ok.results;
    val checked: res[bool, opcode.Error] = opcode.check(?m.types, d.opcode, inst, ?s.out);
    if (sel checked.err) {
        if (sel checked.err.alloc) { ret Reading.alloc{checked.err.alloc}; }
        ret Reading.refused{checked.err};
    }
    ret Reading.typed{checked.ok};
}

# whether an instruction's stored results are the row's, in number and type
fun typed_as(b: *Body, d: *InstructionData, out: *vector.Vector[Type]) bool {
    if (d.results.len != out.len) { ret false; }
    var i: usize = 0;
    for (i < out.len) {
        if (!types.same(b.values.data[d.results.data[i].index].type, out.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether each of an instruction's results is marked secret as the row's rule
# gives, and no edge passes a secret value to a public parameter
fun secret_as(b: *Body, d: *InstructionData, secret: bool) bool {
    var i: usize = 0;
    for (i < d.results.len) {
        if (b.values.data[d.results.data[i].index].secret != secret) { ret false; }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        var j:    usize = 0;
        for (j < edge.arguments.len) {
            val param: Value = b.blocks.data[edge.block.index].parameters.data[j];
            if (b.values.data[edge.arguments.data[j].index].secret && !b.values.data[param.index].secret) { ret false; }
            j = j + 1;
        }
        e = e + 1;
    }
    ret true;
}

# whether a stack slot's pointer is into the target's slot space, true for any
# other instruction
fun slotted(run: *Run, d: *InstructionData) bool {
    if (d.opcode.index != opcode.ALLOCA.index) { ret true; }
    if (d.immediates.len < 2)                  { ret false; }
    val imm: opcode.Immediate = d.immediates.data[1];
    if (!(sel imm.ty)) { ret false; }
    val want: res[u32, record.Error] = record.slot_space(run.target);
    val have: res[u32, types.Error]  = types.space(?run.m.types, imm.ty);
    if (sel want.ok) {
        if (sel have.ok) { ret want.ok == have.ok; }
    }
    ret false;
}

fun scratch(m: *Module) Scratch {
    ret Scratch{out: vector.init[Type](m.a), tys: vector.init[Type](m.a), secrets: vector.init[bool](m.a), edges: vector.init[opcode.Edge](m.a)};
}

fun release(s: *Scratch) {
    vector.dnit[Type](?s.out);
    vector.dnit[Type](?s.tys);
    vector.dnit[bool](?s.secrets);
    vector.dnit[opcode.Edge](?s.edges);
}

# walk every walked instruction through the checker once, holding its results
# to the row's types, and keeping the first whose secrecy is not the row's for
# the secrecy rule, which a typing fault anywhere comes before
fun walk(run: *Run) err[Error] {
    val m: *Module = run.m;
    var s: Scratch = scratch(m);
    fin { release(?s); }
    run.secrecy = opt[Failure].none{};
    var faulted: bool  = false;
    var f:       usize = 0;
    for (f < m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val fn:  Function                         = Function{index: f::u32};
        val b:   *Body                            = ?m.functions.data[f].body;
        val sig: res[types.Function, types.Error] = types.signature(?m.types, m.functions.data[f].data.signature);
        var k:   usize                            = 0;
        for (k < b.blocks.len) {
            val id: Block      = Block{index: k::u32};
            val bd: *BlockData = ?b.blocks.data[k];
            var i:  usize      = 0;
            for (!bd.erased && i < bd.instructions.len) {
                val inst: Instruction      = bd.instructions.data[i];
                val d:    *InstructionData = ?b.instructions.data[inst.index];
                val r:    Reading          = read(m, b, sig, d, ?s);
                if (sel r.alloc)             { ret exhausted(r.alloc); }
                if (sel r.refused)           { ret broken(at_instruction(m, fn, id, inst), "an instance its opcode's row refuses"); }
                if (!typed_as(b, d, ?s.out)) { ret broken(at_instruction(m, fn, id, inst), "results that are not the ones its row derives"); }
                if (!slotted(run, d))        { ret broken(at_instruction(m, fn, id, inst), "a stack slot whose pointer is not into the target's slot space"); }
                if (!faulted) {
                    if (sel r.typed && !secret_as(b, d, r.typed)) {
                        run.secrecy = opt[Failure].some{finding(at_instruction(m, fn, id, inst), "secrecy that is not what its row's rule gives")};
                        faulted     = true;
                    }
                }
                i = i + 1;
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Error].ok{};
}

# every walked instruction is an instance its opcode's row types, giving the
# results it holds, each read once for this rule and the secrecy rule
pub fun typing(run: *Run) err[Error] {
    ret walk(run);
}

# every result is secret exactly when its row's secrecy rule says, and no edge
# passes a secret value to a public parameter, as the typing rule's walk found
pub fun secrecy(run: *Run) err[Error] {
    if (sel run.secrecy.some) { ret err[Error].err{Error.refused{run.secrecy.some}}; }
    ret err[Error].ok{};
}
