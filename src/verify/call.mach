# the rule on calls: a call states the signature its callee declares
#
# a call through the address of a function of the module is a call whose
# callee is known. the signature it states must give its named parameters and
# its results the callee's types and extensions, since the caller passes and
# extends by the one and the callee reads by the other. a call naming every
# argument passes exactly the callee's parameters. a C-variadic call names the
# callee's declared parameters and passes the rest unnamed, so it states a
# named count equal to the callee's parameter count and any arguments after
# them. a call through any other address has no callee to agree with.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.block.BlockData;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.place.Named;
use types: mirl.ir.type;
use mirl.ir.value.Def;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.walks;

# the function a call's callee names, none when it is not the address of one
fun callee(m: *Module, b: *Body, d: *InstructionData) opt[Function] {
    if (d.operands.len == 0) { ret opt[Function].none{}; }
    val def: Def = b.values.data[d.operands.data[0].index].def;
    if (!(sel def.constant)) { ret opt[Function].none{}; }
    val c: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel c.err)                           { ret opt[Function].none{}; }
    if (!(sel c.ok.address))                 { ret opt[Function].none{}; }
    if (!(sel c.ok.address.symbol.function)) { ret opt[Function].none{}; }
    if (c.ok.address.offset != 0)            { ret opt[Function].none{}; }
    ret opt[Function].some{c.ok.address.symbol.function};
}

# whether a call has a known callee and states a signature that is not its callee's
fun disagrees(m: *Module, b: *Body, d: *InstructionData) bool {
    if (d.opcode.index != opcode.CALL.index || d.immediates.len == 0) { ret false; }
    val target: opt[Function] = callee(m, b, d);
    if (sel target.none) { ret false; }
    val stated: Immediate = d.immediates.data[0];
    if (!(sel stated.ty)) { ret false; }
    val named: res[types.Function, types.Error] = types.signature(?m.types, m.functions.data[target.some.index].data.signature);
    if (sel named.err) { ret true; }
    val given: res[types.Function, types.Error] = types.signature(?m.types, stated.ty);
    if (sel given.err) { ret true; }
    ret !agree(named.ok, given.ok, naming(d));
}

# how many of a call's arguments it names, every one when it states no count
fun naming(d: *InstructionData) Named {
    if (d.immediates.len < 2)                { ret Named.all{}; }
    if (!(sel d.immediates.data[1].named))   { ret Named.all{}; }
    ret d.immediates.data[1].named;
}

# every call whose callee is a function of the module states that function's
# extensions
pub fun calls(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        if (!walks(run, f)) {
            f = f + 1;
            cnt;
        }
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val id: Block      = Block{index: k::u32};
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction      = bd.instructions.data[i];
                    val d:    *InstructionData = ?b.instructions.data[inst.index];
                    if (disagrees(m, b, d)) { ret broken(at_instruction(m, fn, id, inst), "a call that states other named parameters or results than its callee's signature"); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# whether a call's stated signature, naming `named` of its arguments, gives
# the callee's parameters as its named ones and the callee's results, each of
# the same type and extension, passing unnamed arguments only past them
fun agree(callee: types.Function, stated: types.Function, named: Named) bool {
    if (sel named.first) {
        if (named.first::usize != callee.params.size || stated.params.size < callee.params.size) { ret false; }
    }
    or {
        if (stated.params.size != callee.params.size) { ret false; }
    }
    ret same(callee.params, stated.params, callee.param_ext, stated.param_ext)
        && callee.results.size == stated.results.size
        && same(callee.results, stated.results, callee.result_ext, stated.result_ext);
}

# whether the first `of.size` types of `to` are those of `of`, each with the same extension
fun same(of: Slice[types.Type], to: Slice[types.Type], of_ext: Slice[types.Extension], to_ext: Slice[types.Extension]) bool {
    var i: usize = 0;
    for (i < of.size) {
        if (!types.same(of.data[i], to.data[i])) { ret false; }
        i = i + 1;
    }
    ret types.same_extensions(of, of_ext, to_ext);
}
