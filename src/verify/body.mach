# the rules over the shape of each body: what it names, how its blocks end, and its edges
#
# an erased block is never walked, and an instruction is walked only where a
# live block lists it, so an erased or detached instruction is skipped. the
# reference rule refuses a walked instruction that names any of them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use me:         masc.core.effect;
use mo:         masc.core.operand;
use mrow:       masc.core.row;
use core_state: masc.core.state;

use mirl.base.slice;
use ia: mirl.ir.assembly;
use mirl.ir.block.BlockData;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Place;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.native.Op;
use mirl.ir.opcode;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.target.Catalog;
use mirl.target.OpSet;
use mirl.target.Ops;
use mirl.target.Refused;
use mirl.target.Target;
use mirl.target.handle_of;
use mirl.target.op_row;
use mirl.target.op_set;
use mirl.target.refusal;
use mirl.target.supplies;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.Where;
use mirl.verify.failure.at_instruction;
use mirl.verify.failure.broken;
use mirl.verify.failure.in_block;
use mirl.verify.failure.in_function;

# a block the body gave out and has not erased
pub fun live(b: *Body, k: Block) bool {
    ret k.index::usize < b.blocks.len && !b.blocks.data[k.index].erased;
}

# a value the body gave out whose definition has not been removed
fun defined(b: *Body, v: Value) bool {
    if (v.index::usize >= b.values.len) { ret false; }
    val def: Def = b.values.data[v.index].def;
    ret !(sel def.removed);
}

# how many times a block lists an instruction
fun listed(k: *BlockData, i: Instruction) usize {
    var n: usize = 0;
    var p: usize = 0;
    for (p < k.instructions.len) {
        if (k.instructions.data[p].index == i.index) { n = n + 1; }
        p = p + 1;
    }
    ret n;
}

fun named(m: *Module, f: Function, b: *Body, k: Block, i: Instruction) err[Found] {
    val d:  *InstructionData = ?b.instructions.data[i.index];
    val at: Place            = d.place;
    if (!(sel at.placed && at.placed.index == k.index)) { ret broken(at_instruction(m, f, k, i), "a block lists an instruction placed elsewhere or nowhere"); }
    if (listed(?b.blocks.data[k.index], i) != 1)        { ret broken(at_instruction(m, f, k, i), "a block lists an instruction more than once"); }
    val r: opt[opcode.Row] = opcode.row(d.opcode);
    if (sel r.none) { ret broken(at_instruction(m, f, k, i), "an opcode that names no row"); }
    var o: usize = 0;
    for (o < d.operands.len) {
        if (!defined(b, d.operands.data[o])) { ret broken(at_instruction(m, f, k, i), "an operand the body does not define"); }
        o = o + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        if (!live(b, edge.block)) { ret broken(at_instruction(m, f, k, i), "an edge into a block the body does not hold"); }
        var j: usize = 0;
        for (j < edge.arguments.len) {
            if (!defined(b, edge.arguments.data[j])) { ret broken(at_instruction(m, f, k, i), "an argument the body does not define"); }
            j = j + 1;
        }
        e = e + 1;
    }
    var n: usize = 0;
    for (n < d.results.len) {
        val v: Value = d.results.data[n];
        if (v.index::usize >= b.values.len) { ret broken(at_instruction(m, f, k, i), "a result the body does not hold"); }
        val def: Def = b.values.data[v.index].def;
        if (!(sel def.result))                                                       { ret broken(at_instruction(m, f, k, i), "a result defined by something else"); }
        if (def.result.instruction.index != i.index || def.result.index::usize != n) { ret broken(at_instruction(m, f, k, i), "a result defined by something else"); }
        n = n + 1;
    }
    ret err[Found].ok{};
}

fun references_of(m: *Module, f: Function) err[Found] {
    val b: *Body = ?m.functions.data[f.index].body;
    if (b.blocks.len != 0 && b.blocks.data[0].erased) { ret broken(in_function(m, f), "an erased entry block"); }
    var k: usize = 0;
    for (k < b.blocks.len) {
        val id: Block      = Block{index: k::u32};
        val d:  *BlockData = ?b.blocks.data[k];
        if (!d.erased) {
            var p: usize = 0;
            for (p < d.parameters.len) {
                val v: Value = d.parameters.data[p];
                if (v.index::usize >= b.values.len) { ret broken(in_block(m, f, id), "a parameter the body does not hold"); }
                val def: Def = b.values.data[v.index].def;
                if (!(sel def.parameter))                                                     { ret broken(in_block(m, f, id), "a parameter defined by something else"); }
                if (def.parameter.block.index != id.index || def.parameter.index::usize != p) { ret broken(in_block(m, f, id), "a parameter defined by something else"); }
                p = p + 1;
            }
            var i: usize = 0;
            for (i < d.instructions.len) {
                val inst: Instruction = d.instructions.data[i];
                if (inst.index::usize >= b.instructions.len) { ret broken(in_block(m, f, id), "a block lists an instruction the body does not hold"); }
                val r: err[Found] = named(m, f, b, id, inst);
                if (sel r.err) { ret r; }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    var i: usize = 0;
    for (i < b.instructions.len) {
        val at: Place = b.instructions.data[i].place;
        if (sel at.placed) {
            val inst: Instruction = Instruction{index: i::u32};
            if (!live(b, at.placed))                                { ret broken(in_function(m, f), "an instruction placed in a block the body does not hold"); }
            if (listed(?b.blocks.data[at.placed.index], inst) != 1) { ret broken(at_instruction(m, f, at.placed, inst), "an instruction placed in a block that does not list it"); }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every id a walked block or instruction names is one the body holds and has not removed
pub fun references(run: *Run) err[Found] {
    var f: usize = 0;
    for (f < run.m.functions.len) {
        val r: err[Found] = references_of(run.m, Function{index: f::u32});
        if (sel r.err) { ret r; }
        f = f + 1;
    }
    ret err[Found].ok{};
}

fun ends(d: *InstructionData) bool {
    val r: opt[opcode.Row] = opcode.row(d.opcode);
    ret sel r.some && r.some.terminator;
}

# every live block ends in exactly one terminator, with none before it
pub fun terminators(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val id: Block      = Block{index: k::u32};
            val d:  *BlockData = ?b.blocks.data[k];
            if (!d.erased) {
                if (d.instructions.len == 0) { ret broken(in_block(m, fn, id), "a block with no terminator"); }
                var i: usize = 0;
                for (i < d.instructions.len) {
                    val inst: Instruction = d.instructions.data[i];
                    val last: bool        = i + 1 == d.instructions.len;
                    val term: bool        = ends(?b.instructions.data[inst.index]);
                    if (term && !last) { ret broken(at_instruction(m, fn, id, inst), "a terminator before the end of its block"); }
                    if (!term && last) { ret broken(at_instruction(m, fn, id, inst), "a block that does not end in a terminator"); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# whether the values passed are the parameters' types, one each
fun agree(b: *Body, args: *vector.Vector[Value], params: *vector.Vector[Value]) bool {
    if (args.len != params.len) { ret false; }
    var j: usize = 0;
    for (j < args.len) {
        if (!types.same(b.values.data[args.data[j].index].type, b.values.data[params.data[j].index].type)) { ret false; }
        j = j + 1;
    }
    ret true;
}

fun edges_of(m: *Module, f: Function) err[Found] {
    val b: *Body = ?m.functions.data[f.index].body;
    if (b.blocks.len == 0) { ret err[Found].ok{}; }
    val sig: res[types.Function, types.Error] = types.signature(?m.types, m.functions.data[f.index].data.signature);
    if (sel sig.err) { ret broken(in_function(m, f), "a signature that is not a function type"); }
    val entry:  *vector.Vector[Value] = ?b.blocks.data[0].parameters;
    val params: Slice[types.Type]     = sig.ok.params;
    if (sel b.entry.placed) {
        if (b.entry.placed.len != entry.len) { ret broken(in_block(m, f, Block{index: 0}), "entry parameters that are not one per place"); }
    }
    or {
        var same: bool  = entry.len == params.size;
        var p:    usize = 0;
        for (same && p < params.size) {
            same = types.same(b.values.data[entry.data[p].index].type, params.data[p]);
            p    = p + 1;
        }
        if (!same) { ret broken(in_block(m, f, Block{index: 0}), "entry parameters that are not the signature's parameters"); }
    }
    var k: usize = 0;
    for (k < b.blocks.len) {
        val id: Block      = Block{index: k::u32};
        val d:  *BlockData = ?b.blocks.data[k];
        if (!d.erased) {
            var i: usize = 0;
            for (i < d.instructions.len) {
                val inst: Instruction      = d.instructions.data[i];
                val data: *InstructionData = ?b.instructions.data[inst.index];
                var e:    usize            = 0;
                for (e < data.edges.len) {
                    val edge: *Edge = ?data.edges.data[e];
                    if (!agree(b, ?edge.arguments, ?b.blocks.data[edge.block.index].parameters)) { ret broken(at_instruction(m, f, id, inst), "an edge whose arguments are not its target's parameters"); }
                    e = e + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret err[Found].ok{};
}

# every edge passes one argument of each parameter's type, and the entry's
# parameters are the signature's, or one per place once they are placed
pub fun edges(run: *Run) err[Found] {
    var f: usize = 0;
    for (f < run.m.functions.len) {
        val r: err[Found] = edges_of(run.m, Function{index: f::u32});
        if (sel r.err) { ret r; }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# past legalisation on a target whose addressing is logical, no instruction
# forms or reads an address as a number, since a logical address has none
pub fun addressing(run: *Run) err[Found] {
    if (!(sel run.stage.legal))                    { ret err[Found].ok{}; }
    if (!(sel run.target.caps.addressing.logical)) { ret err[Found].ok{}; }
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val id: Block      = Block{index: k::u32};
            val d:  *BlockData = ?b.blocks.data[k];
            if (!d.erased) {
                var i: usize = 0;
                for (i < d.instructions.len) {
                    val inst: Instruction     = d.instructions.data[i];
                    val r:    opt[opcode.Row] = opcode.row(b.instructions.data[inst.index].opcode);
                    if (sel r.some && sel r.some.forms.arithmetic) { ret broken(at_instruction(m, fn, id, inst), "an address formed or read as a number under logical addressing"); }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# whether a constant holds the address of a function, at any depth
fun names_function(m: *Module, c: Constant) bool {
    val got: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel got.err) { ret false; }
    val d: ConstantData = got.ok;
    if (sel d.address) { ret sel d.address.symbol.function; }
    if (sel d.aggregate) {
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            if (names_function(m, d.aggregate.elements.data[i])) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

# whether a value is a constant holding the address of a function
fun function_constant(m: *Module, b: *Body, v: Value) bool {
    if (!defined(b, v)) { ret false; }
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret false; }
    ret names_function(m, def.constant);
}

# whether an operand is a call's callee naming the function it calls, the
# address of that function with no offset
fun names_callee(m: *Module, r: *opcode.Row, d: *InstructionData, k: usize, b: *Body) bool {
    if (k >= $length_of(opcode.Operands) || !(sel r.operands[k].role.callee)) { ret false; }
    val def: Def = b.values.data[d.operands.data[k].index].def;
    if (!(sel def.constant)) { ret false; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret false; }
    val c: ConstantData = got.ok;
    if (!(sel c.address)) { ret false; }
    ret sel c.address.symbol.function && c.address.offset == 0;
}

# the rule an instruction keeps on functions: it takes no function's address
# on a target whose code has none, each function immediate names a function
# of the module, and no operand or edge argument is a constant
# holding a function's address except a callee naming the function it calls
fun functions_of(m: *Module, t: *Target, fn: Function, k: Block, inst: Instruction) err[Found] {
    val b: *Body            = ?m.functions.data[fn.index].body;
    val d: *InstructionData = ?b.instructions.data[inst.index];
    val r: opt[opcode.Row]  = opcode.row(d.opcode);
    if (sel r.none) { ret err[Found].ok{}; }
    var row: opcode.Row = r.some;
    if (sel row.forms.function && sel t.caps.functions.none) { ret broken(at_instruction(m, fn, k, inst), "a function's address on a target whose code has none"); }
    var j: usize = 0;
    for (j < d.immediates.len) {
        val imm: opcode.Immediate = d.immediates.data[j];
        if (sel imm.function) {
            if (imm.function.index::usize >= m.functions.len) { ret broken(at_instruction(m, fn, k, inst), "a function immediate naming no function of the module"); }
        }
        j = j + 1;
    }
    j = 0;
    for (j < d.operands.len) {
        if (function_constant(m, b, d.operands.data[j]) && !names_callee(m, ?row, d, j, b)) { ret broken(at_instruction(m, fn, k, inst), "a constant naming a function's address in code, which only func.addr names"); }
        j = j + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val args: Slice[Value] = Slice[Value]{data: d.edges.data[e].arguments.data, size: d.edges.data[e].arguments.len};
        j = 0;
        for (j < args.size) {
            if (function_constant(m, b, args.data[j])) { ret broken(at_instruction(m, fn, k, inst), "a constant naming a function's address in code, which only func.addr names"); }
            j = j + 1;
        }
        e = e + 1;
    }
    ret err[Found].ok{};
}

# code names a function's address only through func.addr, on a target whose
# code has them, and a call names the function it calls as its callee
pub fun functions(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val d: *BlockData = ?b.blocks.data[k];
            if (!d.erased) {
                var i: usize = 0;
                for (i < d.instructions.len) {
                    val found: err[Found] = functions_of(m, run.target, fn, Block{index: k::u32}, d.instructions.data[i]);
                    if (sel found.err) { ret found; }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# whether value `v` is a constant an immediate operand of a block binds: an
# integer, or an address where a symbol may stand for it
fun immediate_constant(m: *Module, b: *Body, v: Value, symbolic: bool) bool {
    if (!defined(b, v)) { ret false; }
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret false; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret false; }
    val c: ConstantData = got.ok;
    if (sel c.integer || sel c.zero) { ret true; }
    ret symbolic && sel c.address;
}

# the rule an inline assembly item keeps on what it binds
fun assembly_of(m: *Module, fn: Function, k: Block, inst: Instruction) err[Found] {
    val b: *Body            = ?m.functions.data[fn.index].body;
    val d: *InstructionData = ?b.instructions.data[inst.index];
    if (d.opcode.index != opcode.ASM.index || d.immediates.len == 0) { ret err[Found].ok{}; }
    val imm: opcode.Immediate = d.immediates.data[0];
    if (!(sel imm.assembly)) { ret err[Found].ok{}; }
    val blk: *ia.Assembly = imm.assembly;
    var at:  usize        = 0;
    var j:   usize        = 0;
    for (j < blk.operands.size && at < d.operands.len) {
        val c: *ia.Operand = ?blk.operands.data[j];
        if (sel c.constraint.immediate) {
            if (!immediate_constant(m, b, d.operands.data[at], c.constraint.immediate.symbolic)) { ret broken(at_instruction(m, fn, k, inst), "an immediate an inline assembly block binds that is not an integer constant, or an address one where a symbol may stand for it"); }
        }
        if (ia.takes(c)) { at = at + 1; }
        j = j + 1;
    }
    ret err[Found].ok{};
}

# every immediate an inline assembly block binds is a constant
pub fun assembly(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val d: *BlockData = ?b.blocks.data[k];
            if (!d.erased) {
                var i: usize = 0;
                for (i < d.instructions.len) {
                    val found: err[Found] = assembly_of(m, fn, Block{index: k::u32}, d.instructions.data[i]);
                    if (sel found.err) { ret found; }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}

# where a target op stands, naming its set and its op
fun at_op(m: *Module, fn: Function, k: Block, inst: Instruction, o: *Op) Where {
    var w: Where = at_instruction(m, fn, k, inst);
    w.set = o.set;
    w.op  = o.name;
    ret w;
}

# the role an access of a row's effect reads and writes memory in: its own,
# or the role of the memory operand it is the access of
fun access_role(r: *mrow.Row, a: *me.Access) mo.Role {
    if (a.role != mo.NONE || a.operand::u32 >= r.operands.len) { ret a.role; }
    ret r.operands.at[a.operand].role;
}

# whether a row's effect reads, or writes, memory, as its accesses state
fun row_touches(r: *mrow.Row, write: bool) bool {
    var want: mo.Role = mo.READ;
    if (write) { want = mo.WRITE; }
    var i: u32 = 0;
    for (i < r.effect.memory.len) {
        if ((access_role(r, ?r.effect.memory.at[i]) & want) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether an operand of a row's own takes a value: a register or an id, or an
# integer constant for an immediate, an enumerant or a number written inline,
# and nothing for any other shape
fun bindable(s: mo.Shape) bool {
    if (sel s.register || sel s.id || sel s.immediate || sel s.enumerant) { ret true; }
    if (sel s.literal)                                                    { ret s.literal.content == mo.NUMBER && s.literal.width_of == 0; }
    ret false;
}

# whether an operand of a row's own is one the instruction gives a constant for
fun constant_shape(s: mo.Shape) bool {
    ret sel s.immediate || sel s.enumerant || sel s.literal;
}

# the bits of an integer constant value, none for any other value
fun constant_word(m: *Module, b: *Body, v: Value) opt[u64] {
    if (!defined(b, v)) { ret opt[u64].none{}; }
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret opt[u64].none{}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret opt[u64].none{}; }
    val c: ConstantData = got.ok;
    if (sel c.zero) { ret opt[u64].some{0}; }
    if (sel c.integer) {
        if (c.integer.words.size > 0) { ret opt[u64].some{c.integer.words.data[0]}; }
    }
    ret opt[u64].none{};
}

# whether a type is the handle kind an op's catalog names for one of its
# row's operands, true where it names none
fun handled(m: *Module, s: *OpSet, o: *Op, operand: u32, ty: Type) bool {
    val kind: opt[str] = handle_of(s, o.name, operand);
    if (sel kind.none) { ret true; }
    val got: res[View, types.Error] = types.handle_kind(?m.types, ty);
    if (sel got.err) { ret false; }
    ret slice.same_view(got.ok, View{data: kind.some, len: str_len(kind.some)});
}

# a target op's operands as its row's own operands take them, the params of
# an enumerant's members among them
# ---
# m:     the module
# b:     the body the op is in
# d:     the op
# taken: how many of its operands are taken
rec Binding {
    m:     *Module;
    b:     *Body;
    d:     *InstructionData;
    taken: usize;
}

# take the values one read operand of a row binds, and after an enumerant
# the params of the members its value names, none when they bind, or why not
fun take(g: *Binding, x: *mo.Operand) opt[str] {
    if (!bindable(x.shape)) { ret opt[str].some{"a target op whose op's row has an operand of a shape no value binds"}; }
    val left:  usize = g.d.operands.len - g.taken;
    var count: usize = 1;
    if (x.quantity == mo.VARIADIC)              { count = left; }
    if (x.quantity == mo.OPTIONAL && left == 0) { count = 0; }
    if (count > left)                           { ret opt[str].some{"a target op passing fewer operands than its op's row takes"}; }
    var n: usize = 0;
    for (n < count) {
        val v: Value = g.d.operands.data[g.taken];
        g.taken = g.taken + 1;
        if (constant_shape(x.shape) && !immediate_constant(g.m, g.b, v, false)) { ret opt[str].some{"a target op passing a value where its op's row takes an integer constant"}; }
        if (sel x.shape.enumerant) {
            val why: opt[str] = take_params(g, x.shape.enumerant, v);
            if (sel why.some) { ret why; }
        }
        n = n + 1;
    }
    ret opt[str].none{};
}

# take the params of the members an enumerant's value names, its member's or
# a mask's in ascending bit order, as masc reads them
fun take_params(g: *Binding, e: mo.Enumeration, v: Value) opt[str] {
    val word: opt[u64] = constant_word(g.m, g.b, v);
    if (sel word.none)                                             { ret opt[str].none{}; }
    if (word.some > 0xFFFF_FFFF || !mo.member(?e, word.some::u32)) { ret opt[str].some{"a target op passing an enumerant its op's row does not name"}; }
    val value: u32 = word.some::u32;
    val count: u32 = mo.param_count(?e, value);
    var k:     u32 = 0;
    for (k < count) {
        val p: *mo.Operand = mo.param(?e, value, k);
        if (p == nil) { ret opt[str].some{"a target op passing an enumerant its op's row does not name"}; }
        val why: opt[str] = take(g, p);
        if (sel why.some) { ret why; }
        k = k + 1;
    }
    ret opt[str].none{};
}

# the rule a target op keeps against its op's row: the set and the op are in
# its target's catalog and the catalog refuses neither, its operands and
# results are the ones the row's own operands bind, each a handle of the kind
# the catalog names where it names one, its memory is what the row states,
# and the build, where one is open, admits the row's requirement
fun op_of(run: *Run, fn: Function, k: Block, inst: Instruction) err[Found] {
    val m: *Module          = run.m;
    val b: *Body            = ?m.functions.data[fn.index].body;
    val d: *InstructionData = ?b.instructions.data[inst.index];
    if (!opcode.target_op(d.opcode) || d.immediates.len == 0) { ret err[Found].ok{}; }
    val imm: opcode.Immediate = d.immediates.data[0];
    if (!(sel imm.op)) { ret err[Found].ok{}; }
    val o:    *Op   = imm.op;
    var at:   Where = at_op(m, fn, k, inst, o);
    val held: Ops   = run.target.caps.ops;
    if (sel held.none)       { ret broken(at, "a target op on a target whose catalog holds no instruction set"); }
    if (!(sel held.catalog)) { ret err[Found].ok{}; }
    val c:   *Catalog    = held.catalog;
    val set: opt[*OpSet] = op_set(c, o.set);
    if (sel set.none) { ret broken(at, "a target op naming an instruction set its target's catalog does not hold"); }
    val s:       *OpSet        = set.some;
    val refused: opt[*Refused] = refusal(s, o.name);
    if (sel refused.some) {
        at.form = View{data: refused.some.form, len: str_len(refused.some.form)};
        ret broken(at, "a target op naming an op the ir has a form of, which is written in its place");
    }
    val found: opt[*mrow.Row] = op_row(c, s, o.name);
    if (sel found.none) { ret broken(at, "a target op naming an op its instruction set does not hold"); }
    val r: *mrow.Row = found.some;
    if (sel s.form.own) {
        if (r.effect.control.transfer != me.NONE) { ret broken(at, "a target op naming an op that transfers control, which the ir's control flow states"); }
        if (sel s.form.own.memory.missing) {
            if (r.effect.memory.len == 0) { ret broken(at, "a target op naming an op whose row masc states no memory of yet, so it cannot be told from one that touches none"); }
        }
    }
    if (o.reads != row_touches(r, false) || o.writes != row_touches(r, true)) { ret broken(at, "a target op declaring memory its op's row does not state, or not declaring memory it does"); }

    var g:       Binding = Binding{m: m, b: b, d: d, taken: 0};
    var defined: usize   = 0;
    if (r.effect.values.defines != 0 && o.results.size > 0) {
        defined = 1;
        if (!handled(m, s, o, r.effect.values.defines::u32 - 1, o.results.data[0])) { ret broken(at, "a target op whose result is not the handle kind its op's catalog names"); }
    }
    var given: usize = defined;
    var j:     u32   = supplies(s, r);
    for (j < r.operands.len) {
        val x:     *mo.Operand = ?r.operands.at[j];
        val start: usize       = g.taken;
        if (!bindable(x.shape)) { ret broken(at, "a target op whose op's row has an operand of a shape no value binds"); }
        if ((x.role & mo.READ) != 0) {
            val why: opt[str] = take(?g, x);
            if (sel why.some) { ret broken(at, why.some); }
            if (g.taken > start) {
                val ty: Type = b.values.data[d.operands.data[start].index].type;
                if (!handled(m, s, o, j, ty)) { ret broken(at, "a target op passing a value that is not the handle kind its op's catalog names for the operand"); }
            }
        }
        if ((x.role & mo.WRITE) != 0) {
            if (given >= o.results.size) { ret broken(at, "a target op stating fewer results than its op's row gives"); }
            if ((x.role & mo.READ) != 0 && g.taken == start + 1) {
                val ty: Type = b.values.data[d.operands.data[start].index].type;
                if (!types.same(ty, o.results.data[given])) { ret broken(at, "a target op whose operand its op's row reads and writes is not of the type of the result it gives"); }
            }
            if (!handled(m, s, o, j, o.results.data[given])) { ret broken(at, "a target op whose result is not the handle kind its op's catalog names"); }
            given = given + 1;
        }
        j = j + 1;
    }
    if (g.taken != d.operands.len) { ret broken(at, "a target op passing more operands than its op's row takes"); }
    if (given != o.results.size)   { ret broken(at, "a target op stating more results than its op's row gives"); }

    val ctx: opt[*core_state.Context] = run.layout.ctx;
    if (sel ctx.some && !core_state.admits(ctx.some, r.requires)) { ret broken(at, "a target op whose op's row requires what the build's selection does not hold"); }
    ret err[Found].ok{};
}

# every target op is an op of its target's catalog, binding what the op's row
# binds and declaring the memory the row states
pub fun ops(run: *Run) err[Found] {
    val m: *Module = run.m;
    var f: usize   = 0;
    for (f < m.functions.len) {
        val fn: Function = Function{index: f::u32};
        val b:  *Body    = ?m.functions.data[f].body;
        var k:  usize    = 0;
        for (k < b.blocks.len) {
            val d: *BlockData = ?b.blocks.data[k];
            if (!d.erased) {
                var i: usize = 0;
                for (i < d.instructions.len) {
                    val found: err[Found] = op_of(run, fn, Block{index: k::u32}, d.instructions.data[i]);
                    if (sel found.err) { ret found; }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret err[Found].ok{};
}
