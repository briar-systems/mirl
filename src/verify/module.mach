# the rules over a module's own tables: its target, types, constants, globals,
# attributes and linkage

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.attribute.Attribute;
use mirl.ir.function;
use mirl.ir.global;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.linkage;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.target;
use mirl.target.Attributes;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.at_constant;
use mirl.verify.failure.at_global;
use mirl.verify.failure.at_type;
use mirl.verify.failure.broken;
use mirl.verify.failure.in_function;
use mirl.verify.failure.module_wide;

# whether a view holds exactly the bytes of a string
pub fun spelled(v: View, s: str) bool {
    if (s == nil) { ret false; }
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the target is the one the module names, and declares every fact
pub fun target_named(run: *Run) err[Found] {
    if (!spelled(run.m.target, run.target.name)) { ret broken(module_wide(), "the module names another target"); }
    val d: err[target.Error] = target.declared(run.target);
    if (sel d.err) { ret broken(module_wide(), "the target leaves a declaration unstated"); }
    ret err[Found].ok{};
}

# every integer type of the type table has a legal width
pub fun widths(run: *Run) err[Found] {
    var i: u32 = 0;
    for {
        val ty: Type                          = Type{index: i};
        val s:  res[types.Shape, types.Error] = types.shape(?run.m.types, ty);
        if (sel s.err)                                                  { brk; }
        if (sel s.ok.integer && !types.legal_width(s.ok.integer.width)) { ret broken(at_type(ty), "an integer width that is neither 1 nor a power of two from 8 to 512"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every structure with stated offsets lays out at them on the target
pub fun offsets(run: *Run) err[Found] {
    var i: u32 = 0;
    for {
        val ty: Type                          = Type{index: i};
        val s:  res[types.Shape, types.Error] = types.shape(?run.m.types, ty);
        if (sel s.err) { brk; }
        if (sel s.ok.structure && sel s.ok.structure.offsets.some) {
            val e: res[target.Extent, target.Error] = target.extent(?run.layout, ty);
            if (sel e.err) { ret broken(at_type(ty), "stated offsets the target's data layout refuses"); }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every constant is well formed, an address naming a function or global of the module
pub fun constants(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.constants.len) {
        val c: err[module.Error] = module.check_constant(run.m, ?run.m.constants.data[i]);
        if (sel c.err) { ret broken(at_constant(Constant{index: i::u32}), "a constant that is not of its type, or an address of no symbol"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every global's initial value is a constant of its type
pub fun initials(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.globals.len) {
        val g: Global        = Global{index: i::u32};
        val c: opt[Constant] = run.m.globals.data[i].data.initial;
        if (sel c.some) {
            val ty: res[Type, module.Error] = module.constant_type(run.m, c.some);
            if (sel ty.err)                                          { ret broken(at_global(run.m, g), "an initial value that names no constant"); }
            if (!types.same(ty.ok, run.m.globals.data[i].data.type)) { ret broken(at_global(run.m, g), "an initial value not of the global's type"); }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}

fun accepted(accepts: Attributes, list: *vector.Vector[Attribute]) bool {
    var i: usize = 0;
    for (i < list.len) {
        if (!(sel accepts.families)) { ret false; }
        val families: Slice[str] = accepts.families;
        var found:    bool       = false;
        var k:        usize      = 0;
        for (k < families.size) {
            if (spelled(list.data[i].family, families.data[k])) { found = true; }
            k = k + 1;
        }
        if (!found) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every attribute is of a family the target accepts
pub fun attributes(run: *Run) err[Found] {
    val accepts: Attributes = run.target.caps.attributes;
    var i:       usize      = 0;
    for (i < run.m.functions.len) {
        if (!accepted(accepts, ?run.m.functions.data[i].attributes)) { ret broken(in_function(run.m, Function{index: i::u32}), "an attribute of a family the target does not accept"); }
        i = i + 1;
    }
    i = 0;
    for (i < run.m.globals.len) {
        if (!accepted(accepts, ?run.m.globals.data[i].attributes)) { ret broken(at_global(run.m, Global{index: i::u32}), "an attribute of a family the target does not accept"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every function and global another module defines has a binding other objects
# may refer to, so the definition can be found
pub fun linkages(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.functions.len) {
        val n: *function.Node = ?run.m.functions.data[i];
        if (n.body.blocks.len == 0 && !linkage.external(n.data.linkage)) { ret broken(in_function(run.m, Function{index: i::u32}), "a declared function whose binding no other object may refer to"); }
        i = i + 1;
    }
    i = 0;
    for (i < run.m.globals.len) {
        val g: *global.Node = ?run.m.globals.data[i];
        if (sel g.data.initial.none && !linkage.external(g.data.linkage)) { ret broken(at_global(run.m, Global{index: i::u32}), "a declared global whose binding no other object may refer to"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}
