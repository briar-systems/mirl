# the rules over a module's own tables: its target, types, constants, globals,
# attributes, linkage and placement

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.section;

use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.of_kind;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.linkage;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.target;
use mirl.target.Attached;
use mirl.target.Attaches;
use mirl.target.Attributes;
use mirl.target.Capabilities;
use mirl.target.Check;
use mirl.target.Entry;
use mirl.target.Schema;
use mirl.verify.failure.Found;
use mirl.verify.failure.Run;
use mirl.verify.failure.Where;
use mirl.verify.failure.at_constant;
use mirl.verify.failure.at_global;
use mirl.verify.failure.at_type;
use mirl.verify.failure.broken;
use mirl.verify.failure.in_function;
use mirl.verify.failure.module_wide;

# whether a view holds exactly the bytes of a string
pub fun spelled(v: View, s: str) bool {
    if (s == nil) { ret false; }
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the target is the one the module names, and declares every fact
pub fun target_named(run: *Run) err[Found] {
    if (!spelled(run.m.target, run.target.name)) { ret broken(module_wide(), "the module names another target"); }
    val d: err[target.Error] = target.declared(run.target);
    if (sel d.err) { ret broken(module_wide(), "the target leaves a declaration unstated"); }
    ret err[Found].ok{};
}

# every integer type of the type table has a legal width
pub fun widths(run: *Run) err[Found] {
    var i: u32 = 0;
    for {
        val ty: Type                          = Type{index: i};
        val s:  res[types.Shape, types.Error] = types.shape(?run.m.types, ty);
        if (sel s.err)                                                  { brk; }
        if (sel s.ok.integer && !types.legal_width(s.ok.integer.width)) { ret broken(at_type(ty), "an integer width that is neither 1 nor a power of two from 8 to 512"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every structure with stated offsets lays out at them on the target
pub fun offsets(run: *Run) err[Found] {
    var i: u32 = 0;
    for {
        val ty: Type                          = Type{index: i};
        val s:  res[types.Shape, types.Error] = types.shape(?run.m.types, ty);
        if (sel s.err) { brk; }
        if (sel s.ok.structure && sel s.ok.structure.offsets.some) {
            val e: res[target.Extent, target.Error] = target.extent(?run.layout, ty);
            if (sel e.err) { ret broken(at_type(ty), "stated offsets the target's data layout refuses"); }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every constant is well formed, an address naming a function or global of the module
pub fun constants(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.constants.len) {
        val c: err[module.Error] = module.check_constant(run.m, ?run.m.constants.data[i]);
        if (sel c.err) { ret broken(at_constant(Constant{index: i::u32}), "a constant that is not of its type, or an address of no symbol"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every global's initial value is a constant of its type
pub fun initials(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.globals.len) {
        val g: Global        = Global{index: i::u32};
        val c: opt[Constant] = run.m.globals.data[i].data.initial;
        if (sel c.some) {
            val ty: res[Type, module.Error] = module.constant_type(run.m, c.some);
            if (sel ty.err)                                          { ret broken(at_global(run.m, g), "an initial value that names no constant"); }
            if (!types.same(ty.ok, run.m.globals.data[i].data.type)) { ret broken(at_global(run.m, g), "an initial value not of the global's type"); }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# why an attribute does not fit the schema of the target the module names
# ---
# family:   it is of a family other than the schema's, or the target accepts none
# name:     the schema defines no attribute of its name
# attaches: its entry attaches to the other kind of symbol
# datum:    its datum is not of its entry's kind
# check:    it breaks its entry's rule, for the reason the rule gives
pub tag Unfit: u8 {
    family;
    name;
    attaches;
    datum;
    check: str;
}

fun same_attachment(a: Attaches, b: Attaches) bool {
    if (sel a.function) { ret sel b.function; }
    ret sel b.global;
}

fun fit(caps: *Capabilities, attaches: Attaches, list: Slice[Attribute], at: *Attribute) opt[Unfit] {
    val accepts: Attributes = caps.attributes;
    if (!(sel accepts.schema)) { ret opt[Unfit].some{Unfit.family{}}; }
    val s: *Schema = accepts.schema;
    if (!spelled(at.family, s.family)) { ret opt[Unfit].some{Unfit.family{}}; }
    val e: opt[*Entry] = target.entry(s, at.name);
    if (sel e.none)                                  { ret opt[Unfit].some{Unfit.name{}}; }
    if (!same_attachment(e.some.attaches, attaches)) { ret opt[Unfit].some{Unfit.attaches{}}; }
    if (!of_kind(at.datum, e.some.datum))            { ret opt[Unfit].some{Unfit.datum{}}; }
    var held:  Attached = Attached{datum: at.datum, symbol: list, caps: caps};
    val check: Check    = e.some.check;
    val broke: opt[str] = check(?held);
    if (sel broke.some) { ret opt[Unfit].some{Unfit.check{broke.some}}; }
    ret opt[Unfit].none{};
}

# why the first of a symbol's attributes that does not fit the schema of the
# target the module names does not, none when every one fits
# ---
# caps:     the target's declarations
# attaches: the kind of symbol the attributes are attached to
# list:     every attribute attached to the symbol
pub fun unfit(caps: *Capabilities, attaches: Attaches, list: Slice[Attribute]) opt[Unfit] {
    var i: usize = 0;
    for (i < list.size) {
        val why: opt[Unfit] = fit(caps, attaches, list, ?list.data[i]);
        if (sel why.some) { ret why; }
        i = i + 1;
    }
    ret opt[Unfit].none{};
}

fun unfitting(why: Unfit) str {
    if (sel why.family)   { ret "an attribute of a family other than the target's schema"; }
    if (sel why.name)     { ret "an attribute its family's schema does not define"; }
    if (sel why.attaches) { ret "an attribute attached to a kind of symbol its entry does not attach to"; }
    if (sel why.check)    { ret why.check; }
    ret "an attribute whose datum is not of its entry's kind";
}

fun listed(list: *vector.Vector[Attribute]) Slice[Attribute] {
    ret Slice[Attribute]{data: list.data, size: list.len};
}

# every attribute is one the schema of the target's family defines, of its
# kind of datum and attachment, and keeps its entry's rule
pub fun attributes(run: *Run) err[Found] {
    val caps: *Capabilities = ?run.target.caps;
    var i:    usize         = 0;
    for (i < run.m.functions.len) {
        val why: opt[Unfit] = unfit(caps, Attaches.function{}, listed(?run.m.functions.data[i].attributes));
        if (sel why.some) { ret broken(in_function(run.m, Function{index: i::u32}), unfitting(why.some)); }
        i = i + 1;
    }
    i = 0;
    for (i < run.m.globals.len) {
        val why: opt[Unfit] = unfit(caps, Attaches.global{}, listed(?run.m.globals.data[i].attributes));
        if (sel why.some) { ret broken(at_global(run.m, Global{index: i::u32}), unfitting(why.some)); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# every function and global another module defines has a binding other objects
# may refer to, so the definition can be found
pub fun linkages(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.functions.len) {
        val n: *function.Node = ?run.m.functions.data[i];
        if (n.body.blocks.len == 0 && !linkage.external(n.data.linkage)) { ret broken(in_function(run.m, Function{index: i::u32}), "a declared function whose binding no other object may refer to"); }
        i = i + 1;
    }
    i = 0;
    for (i < run.m.globals.len) {
        val g: *global.Node = ?run.m.globals.data[i];
        if (sel g.data.initial.none && !linkage.external(g.data.linkage)) { ret broken(at_global(run.m, Global{index: i::u32}), "a declared global whose binding no other object may refer to"); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# why a section a global states does not hold it
# ---
# thread:   it is thread-local exactly when the global is not
# written:  the program cannot write it, and the global is not constant
# constant: it is zero filled, and the global is constant
# filled:   it is zero filled, and the global's initial value is not every bit zero
pub tag Misplaced: u8 {
    thread;
    written;
    constant;
    filled;
}

# why a global's stated section does not hold it, none when it does or it states none
pub fun misplaced(m: *module.Module, g: *global.Node) opt[Misplaced] {
    if (sel g.data.section.none) { ret opt[Misplaced].none{}; }
    val k:      *section.Kind = g.data.section.some.kind;
    val thread: bool          = (k.flags & section.TLS) != 0;
    if (thread != sel g.data.tls.some)                      { ret opt[Misplaced].some{Misplaced.thread{}}; }
    if ((k.flags & section.WRITE) == 0 && !g.data.constant) { ret opt[Misplaced].some{Misplaced.written{}}; }
    if (section.has(k, section.BITS))                       { ret opt[Misplaced].none{}; }
    if (g.data.constant)                                    { ret opt[Misplaced].some{Misplaced.constant{}}; }
    if (sel g.data.initial.none)                            { ret opt[Misplaced].none{}; }
    val held: res[module.Contents, module.Error] = module.contents(m, g.data.initial.some);
    if (sel held.ok && sel held.ok.zeros) { ret opt[Misplaced].none{}; }
    ret opt[Misplaced].some{Misplaced.filled{}};
}

fun misplacement(why: Misplaced) str {
    if (sel why.thread)   { ret "a section that is thread-local exactly when its global is not"; }
    if (sel why.written)  { ret "a section the program cannot write, for a global it writes"; }
    if (sel why.constant) { ret "a zero filled section, for a constant global"; }
    ret "a zero filled section, for an initial value not every bit zero";
}

# every section a global states holds it: thread-local exactly when the global
# is, writable unless the global is constant, and zero filled only for a
# global that is not constant and whose initial value is every bit zero
pub fun placements(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.globals.len) {
        val why: opt[Misplaced] = misplaced(run.m, ?run.m.globals.data[i]);
        if (sel why.some) { ret broken(at_global(run.m, Global{index: i::u32}), misplacement(why.some)); }
        i = i + 1;
    }
    ret err[Found].ok{};
}

# the global a constant holds the address of when it is thread-local, at any
# depth, none when it holds no such address
fun thread_address(m: *module.Module, c: Constant) opt[Global] {
    val d: ConstantData = m.constants.data[c.index];
    if (sel d.address) {
        val at: Symbol = d.address.symbol;
        if (sel at.global) {
            val g: Global       = at.global;
            val n: *global.Node = ?m.globals.data[g.index];
            if (sel n.data.tls.some) { ret opt[Global].some{g}; }
        }
        ret opt[Global].none{};
    }
    if (sel d.aggregate) {
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            val held: opt[Global] = thread_address(m, d.aggregate.elements.data[i]);
            if (sel held.some) { ret held; }
            i = i + 1;
        }
    }
    ret opt[Global].none{};
}

# no initial value holds the address of a thread-local global, which has no one
# static address, whether the global is stated in the module or declared
pub fun threads(run: *Run) err[Found] {
    var i: usize = 0;
    for (i < run.m.globals.len) {
        val c: opt[Constant] = run.m.globals.data[i].data.initial;
        if (sel c.some) {
            val held: res[module.Contents, module.Error] = module.contents(run.m, c.some);
            if (sel held.ok && sel held.ok.addresses) {
                val target: opt[Global] = thread_address(run.m, c.some);
                if (sel target.some) {
                    var w: Where = at_global(run.m, Global{index: i::u32});
                    w.referenced = run.m.globals.data[target.some.index].data.name;
                    ret broken(w, "an initial value holding the address of a thread-local global");
                }
            }
        }
        i = i + 1;
    }
    ret err[Found].ok{};
}
