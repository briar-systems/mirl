# the rows of a register file by identity, indexed once
#
# masc finds a register's row by scanning its file. this index sorts the rows
# by identity once, so every reader of the machine form finds a row by binary
# search.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.sort;
use std.collections.vector;

use rf: masc.core.register;

# a register row and its identity
# ---
# id:    the register's identity
# index: the row's position in the file
pub rec Spot {
    id:    rf.Id;
    index: u32;
}

# the rows of a register file sorted by identity
# ---
# file:  the register file, nil for a set with none
# spots: every row, sorted by identity
pub rec Rows {
    file:  *rf.File;
    spots: vector.Vector[Spot];
}

fun by_id(a: *Spot, b: *Spot) i64 {
    if (a.id < b.id) { ret -1; }
    if (a.id > b.id) { ret 1; }
    ret 0;
}

# the index of a file's rows, empty for a nil file
# ---
# a:    the allocator the index takes
# file: the register file
# ret:  the index, or the allocator's refusal
pub fun init(a: *allocator.Allocator, file: *rf.File) res[Rows, allocator.Error] {
    var x: Rows = Rows{file: file, spots: vector.init[Spot](a)};
    if (file == nil) { ret res[Rows, allocator.Error].ok{x}; }
    val room: res[usize, allocator.Error] = vector.reserve[Spot](?x.spots, file.register_count::usize);
    if (sel room.err) { ret res[Rows, allocator.Error].err{room.err}; }
    var i: u32 = 0;
    for (i < file.register_count) {
        vector.push[Spot](?x.spots, Spot{id: rf.id_of(?file.registers[i]), index: i});
        i = i + 1;
    }
    sort.sort_by[Spot](x.spots.data, x.spots.len, by_id);
    ret res[Rows, allocator.Error].ok{x};
}

# give back the index's storage
pub fun dnit(x: *Rows) err[allocator.Error] {
    ret vector.dnit[Spot](?x.spots);
}

# the position of a register's row in the file, none when the file has none
pub fun row(x: *Rows, id: rf.Id) opt[u32] {
    var lo: usize = 0;
    var hi: usize = x.spots.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (x.spots.data[mid].id < id) { lo = mid + 1; }
        or                             { hi = mid; }
    }
    if (lo >= x.spots.len || x.spots.data[lo].id != id) { ret opt[u32].none{}; }
    ret opt[u32].some{x.spots.data[lo].index};
}
