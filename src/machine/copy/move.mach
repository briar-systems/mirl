# the moves a set states between locations, and their index
#
# a set states each way it moves the whole value of one location into
# another as a row of masc's catalog and what each of its operand positions
# takes, and each way it exchanges two locations of one class. the lowering of
# copies finds the row of a pair here and nowhere else, so it names no
# instruction. a move is found by the classes of its two locations and the
# storage they take through the selection, which must be exactly the bits it
# moves, so one class whose width follows an extension, as risc-v's float
# registers follow f, d and q, states one move per width and the selection
# admits the one that fits.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Physical;
use mirl.machine.class.Storage;
use mirl.machine.select.rule.Holder;

use masc.core.extension;
use rf:   masc.core.register;
use rows: masc.core.row;

# what an operand position of a move takes
# ---
# to:      the location written, for a swap the first of the two
# from:    the location read, for a swap the second
# literal: a fixed immediate
pub tag Part: u8 {
    to;
    from;
    literal: i64;
}

# parts as a pointer to static parts and a count
pub rec Parts {
    at:  *Part;
    len: u32;
}

# one way the set moves the whole value of a location into another
# ---
# to:    the class of the location written
# from:  the class of the location read, for a swap the class of both
# bits:  the bits it moves, scaled as masc states widths, which both
#        locations' storage through the selection must be exactly
# row:   the row of masc's catalog, which the selection must admit
# parts: what each operand position of the row takes, in order
pub rec Move {
    to:    Holder;
    from:  Holder;
    bits:  rf.Scaled;
    row:   *rows.Row;
    parts: Parts;
}

# moves as a pointer to static moves and a count
pub rec Moves {
    at:  *Move;
    len: u32;
}

# a set's moves
# ---
# moves: the moves between two locations
# swaps: the exchanges of two locations of one class, none for a set with none
pub rec Table {
    moves: Moves;
    swaps: Moves;
}

# an admitted move, the storage it moves through the selection and its place
# in its list
rec Entry {
    key:     u32;
    storage: Storage;
    move:    *Move;
    at:      u32;
}

# the admitted moves of a table, for one selection and one set of locations
# ---
# keys:  how many classes the locations are members of
# moves: the moves by the key of the class written times keys plus the key of
#        the class read, each list by the storage it moves
# swaps: the swaps by the key of their class, each list by storage
pub rec Index {
    keys:  u32;
    moves: Lists[Entry];
    swaps: Lists[Entry];
}

# a move of the table the index refuses
# ---
# swap: whether it is a swap
# at:   its place in its list
pub rec Defect {
    swap: bool;
    at:   u32;
}

# why a table was not indexed
# ---
# alloc:   the allocator refused storage
# foreign: a move naming a class of no register file of the locations, or a
#          swap between two classes
# twice:   a second admitted move of one pair of classes and one storage
pub tag Error: u8 {
    alloc:   allocator.Error;
    foreign: Defect;
    twice:   Defect;
}

fun by_key(a: *Entry, b: *Entry) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret class.order(a.storage, b.storage);
}

# the key of a holder's class, none for a memory class the locations do not
# number, which a target that supplies no such class leaves out
fun keyed(at: *Locations, h: Holder, d: Defect) res[opt[u32], Error] {
    if (sel h.hardware) {
        val c: opt[Class] = class.handled(at.file, h.hardware);
        if (sel c.none) { ret res[opt[u32], Error].err{Error.foreign{d}}; }
        val k: opt[u32] = location.key(at, c.some);
        if (sel k.none) { ret res[opt[u32], Error].err{Error.foreign{d}}; }
        ret res[opt[u32], Error].ok{k};
    }
    ret res[opt[u32], Error].ok{location.key(at, Class.memory{h.memory})};
}

# the entry of an admitted move, keyed by pair or, for a swap, by its one class
fun add(out: *vector.Vector[Entry], regs: *rf.Available, m: *Move, i: u32, swap: bool, to: u32, from: u32, keys: u32) err[Error] {
    var key: u32 = to * keys + from;
    if (swap) {
        if (to != from) { ret err[Error].err{Error.foreign{Defect{swap: swap, at: i}}}; }
        key = to;
    }
    val pushed: res[usize, allocator.Error] = vector.push[Entry](out, Entry{key: key, storage: class.through(regs, m.bits), move: m, at: i});
    if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
    ret err[Error].ok{};
}

# the admitted moves of one list as entries, keyed by pair or, for swaps, by class
fun entries(at: *Locations, regs: *rf.Available, list: Moves, swap: bool, out: *vector.Vector[Entry]) err[Error] {
    val keys: u32 = location.keys(at);
    var i:    u32 = 0;
    for (i < list.len) {
        val m:  *Move                = ?list.at[i];
        val d:  Defect               = Defect{swap: swap, at: i};
        val to: res[opt[u32], Error] = keyed(at, m.to, d);
        if (sel to.err) { ret err[Error].err{to.err}; }
        val from: res[opt[u32], Error] = keyed(at, m.from, d);
        if (sel from.err) { ret err[Error].err{from.err}; }
        val tk: opt[u32] = to.ok;
        val fk: opt[u32] = from.ok;
        if (sel tk.some) {
            if (sel fk.some) {
                if (extension.admits(regs.selection, m.row.requires)) {
                    val added: err[Error] = add(out, regs, m, i, swap, tk.some, fk.some, keys);
                    if (sel added.err) { ret added; }
                }
            }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun grouped(a: *allocator.Allocator, at: *Locations, regs: *rf.Available, list: Moves, swap: bool, count: u32) res[Lists[Entry], Error] {
    var all: vector.Vector[Entry] = vector.init[Entry](a);
    fin { vector.dnit[Entry](?all); }
    val listed: err[Error] = entries(at, regs, list, swap, ?all);
    if (sel listed.err) { ret res[Lists[Entry], Error].err{listed.err}; }
    sort.sort_by[Entry](all.data, all.len, by_key);
    var keys: vector.Vector[u32] = vector.init[u32](a);
    fin { vector.dnit[u32](?keys); }
    var i: usize = 0;
    for (i < all.len) {
        if (i > 0 && by_key(?all.data[i - 1], ?all.data[i]) == 0) { ret res[Lists[Entry], Error].err{Error.twice{Defect{swap: swap, at: all.data[i].at}}}; }
        val pushed: res[usize, allocator.Error] = vector.push[u32](?keys, all.data[i].key);
        if (sel pushed.err) { ret res[Lists[Entry], Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val made: res[Lists[Entry], allocator.Error] = graph.lists[Entry](a, count, Slice[u32]{data: keys.data, size: keys.len}, Slice[Entry]{data: all.data, size: all.len});
    if (sel made.err) { ret res[Lists[Entry], Error].err{Error.alloc{made.err}}; }
    ret res[Lists[Entry], Error].ok{made.ok};
}

# index a set's moves for a selection and the locations of a target
# ---
# a:    the allocator the index takes
# t:    the set's moves
# at:   the locations of the target
# regs: the registers the selection gives, which admits each row and fixes
#       the storage each move takes
# ret:  the index, or why it was refused
pub fun index(a: *allocator.Allocator, t: *Table, at: *Locations, regs: *rf.Available) res[Index, Error] {
    val keys:  u32                      = location.keys(at);
    val moves: res[Lists[Entry], Error] = grouped(a, at, regs, t.moves, false, keys * keys);
    if (sel moves.err) { ret res[Index, Error].err{moves.err}; }
    var m:     Lists[Entry]             = moves.ok;
    val swaps: res[Lists[Entry], Error] = grouped(a, at, regs, t.swaps, true, keys);
    if (sel swaps.err) {
        graph.release[Entry](?m);
        ret res[Index, Error].err{swaps.err};
    }
    ret res[Index, Error].ok{Index{keys: keys, moves: m, swaps: swaps.ok}};
}

# give back an index's storage
pub fun dnit(x: *Index) err[allocator.Error] {
    var failed: err[allocator.Error] = graph.release[Entry](?x.moves);
    keep(?failed, graph.release[Entry](?x.swaps));
    ret failed;
}

# the storage a location takes through the selection, none for a register
# whose storage no fixed part plus a part per unit states
pub fun storage_of(at: *Locations, regs: *rf.Available, p: Physical) opt[Storage] {
    if (sel p.cell) { ret opt[Storage].some{Storage{fixed: p.cell.class.width::u64, per: 0, scale: 0}}; }
    val row: opt[*rf.Register] = rf.row_of(at.file, p.register);
    if (sel row.none) { ret opt[Storage].none{}; }
    ret class.register_storage(regs, row.some);
}

# the entry of a list that moves exactly a storage, by binary search
fun exact(list: Slice[Entry], s: Storage) opt[*Move] {
    var lo: usize = 0;
    var hi: usize = list.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (class.order(list.data[mid].storage, s) < 0) { lo = mid + 1; }
        or                                              { hi = mid; }
    }
    if (lo < list.size && class.order(list.data[lo].storage, s) == 0) { ret opt[*Move].some{list.data[lo].move}; }
    ret opt[*Move].none{};
}

# the storage two locations both take, none when they differ or either is unstated
fun shared(at: *Locations, regs: *rf.Available, to: u32, from: u32) opt[Storage] {
    val a: opt[Storage] = storage_of(at, regs, location.physical(at, to));
    val b: opt[Storage] = storage_of(at, regs, location.physical(at, from));
    if (sel a.none)                       { ret a; }
    if (sel b.none)                       { ret b; }
    if (class.order(a.some, b.some) != 0) { ret opt[Storage].none{}; }
    ret a;
}

# the move of a pair of locations, none when the set states none
# ---
# x:    the index
# at:   the locations
# regs: the registers the selection gives
# to:   the location written
# from: the location read
pub fun move_of(x: *Index, at: *Locations, regs: *rf.Available, to: u32, from: u32) opt[*Move] {
    val s: opt[Storage] = shared(at, regs, to, from);
    if (sel s.none) { ret opt[*Move].none{}; }
    val key: u32 = location.key_at(at, to) * x.keys + location.key_at(at, from);
    ret exact(graph.list[Entry](?x.moves, key), s.some);
}

# the swap of two locations of one class, none when the set states none
pub fun swap_of(x: *Index, at: *Locations, regs: *rf.Available, a: u32, b: u32) opt[*Move] {
    val k: u32 = location.key_at(at, a);
    if (location.key_at(at, b) != k) { ret opt[*Move].none{}; }
    val s: opt[Storage] = shared(at, regs, a, b);
    if (sel s.none) { ret opt[*Move].none{}; }
    ret exact(graph.list[Entry](?x.swaps, k), s.some);
}
