# tests of the lowering of copies, machine form text in and text out, on the
# risc-v rows

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.filesystem;
use io: std.io.writer;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.isa.riscv.frame.FRAME;
use mirl.isa.riscv.move.MOVES;
use mirl.machine.alloc.allowed;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.copy.lower;
use mirl.machine.copy.move;
use mirl.machine.frame.finish;
use mirl.machine.frame.lay;
use mirl.machine.frame.lay.Plan;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Framed;
use mirl.machine.function.Function;
use mirl.machine.text.equal;
use mirl.machine.text.item;
use reader:   mirl.machine.text.parse;
use printing: mirl.machine.text.print;
use targets:  mirl.target;
use mirl.target.Target;
use mirl.target.machine;
use mirl.target.machine.Machine;

#[testing]
val MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a test's module, machine, locations, allowed locations and moves
#[testing]
rec Fixture {
    a:       allocator.Allocator;
    m:       Module;
    mach:    Machine;
    at:      Locations;
    allowed: vector.Vector[Physical];
    moves:   move.Index;
}

#[testing]
fun open(x: *Fixture) i32 {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    x.m = made.ok;
    val t: opt[*Target] = targets.by_name(x.m.target);
    if (sel t.none) { ret 2; }
    val opened: err[machine.Error] = machine.open(?x.mach, ?x.a, t.some);
    if (sel opened.err) { ret 3; }
    val got: res[Locations, location.Error] = location.init(?x.a, x.mach.registers.file, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 4; }
    x.at = got.ok;
    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_machine(?x.a, ?x.mach, ?x.at, false);
    if (sel listed.err) { ret 5; }
    x.allowed = listed.ok;
    val indexed: res[move.Index, move.Error] = move.index(?x.a, ?MOVES, ?x.at, ?x.mach.registers);
    if (sel indexed.err) { ret 6; }
    x.moves = indexed.ok;
    ret 0;
}

#[testing]
fun close(x: *Fixture) {
    move.dnit(?x.moves);
    vector.dnit[Physical](?x.allowed);
    location.dnit(?x.at);
    machine.close(?x.mach);
    module.dnit(?x.m);
}

# print a function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, f: Function) {
    var items: [1]item.Item;
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print(?out, m, Slice[item.Item]{data: ?items[0], size: 1});
}

# frame @f of a text, lower its copies and compare it with the expected text
# ---
# text: the machine text of @f, every operand a location or a slot
# want: the expected text of @f framed and lowered
# ret:  0, or the step that failed
#[testing]
fun lowers(text: str, want: str) i32 {
    var x:      Fixture;
    val opened: i32 = open(?x);
    if (opened != 0) { ret opened; }
    fin { close(?x); }
    val input: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(text));
    if (sel input.err) { ret 10; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val expected: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(want));
    if (sel expected.err) { ret 11; }
    var e: reader.Unit = expected.ok;
    fin { reader.dnit(?e); }
    val r:    lay.Request          = lay.Request{convention: ?x.mach.convention, at: ?x.at};
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, r);
    if (sel laid.err) { ret 12; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val framed: res[Framed, finish.Error] = finish.finish(?x.a, ?u.items.data[0].function, ?p, ?FRAME);
    if (sel framed.err) { ret 13; }
    var out: Framed = framed.ok;
    fin { record.release(?out); }
    var request: lower.Request = lower.Request{
        at:        ?x.at,
        registers: ?x.mach.registers,
        clobbered: x.mach.convention.clobbered,
        allowed:   Slice[Physical]{data: x.allowed.data, size: x.allowed.len},
        code:      ?FRAME,
        moves:     ?x.moves,
    };
    val done: err[lower.Error] = lower.lower(?x.a, ?out, ?request);
    if (sel done.err) { ret 14; }
    val same: res[bool, printer.Error] = equal.same_function(?x.m, ?out.function, ?x.m, ?e.items.data[0].function);
    if (sel same.err) { ret 15; }
    if (!same.ok) {
        show(?x.m, out.function);
        ret 16;
    }
    ret 0;
}

# a parallel copy exchanging a0 and a1, both read after it, with t0 free
#[testing]
val SWAP: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    pseudo parallel_copy x10, x11, x11, x10\n    add x12, x10, x11\n    jalr x0, x1, 0\n}\n";

#[testing]
val SWAP_OUT: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    addi x5, x10, 0\n    addi x10, x11, 0\n    addi x11, x5, 0\n    add x12, x10, x11\n    jalr x0, x1, 0\n}\n";

test copy__a_two_register_cycle_moves_through_a_free_scratch_register {
    ret lowers(SWAP, SWAP_OUT);
}

#[testing]
val SAME: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    pseudo copy x10, x10\n    jalr x0, x1, 0\n}\n";

#[testing]
val SAME_OUT: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    jalr x0, x1, 0\n}\n";

test copy__a_copy_to_its_own_location_disappears {
    ret lowers(SAME, SAME_OUT);
}

#[testing]
val SLOTS: str = "target \"riscv64-linux\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    pseudo copy [0], [1]\n    jalr x0, x1, 0\n}\n";

#[testing]
val SLOTS_OUT: str = "target \"riscv64-linux\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    addi x2, x2, -16\n    ld x5, x2, 8\n    sd x2, x5, 0\n    addi x2, x2, 16\n    jalr x0, x1, 0\n}\n";

test copy__a_slot_to_slot_copy_goes_through_a_register {
    ret lowers(SLOTS, SLOTS_OUT);
}
