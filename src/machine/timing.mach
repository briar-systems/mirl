# the machine form's constant-time check of a selected function
#
# selection leaves every value in a virtual register, and a virtual register
# holds a secret when any instruction writing it is secret, as the metadata
# record it carries from the ir says. for an instruction of a row, a secret
# in an operand the row reads is asked of the row's class under the context
# the function runs under (`mirl.ct.latency`), and a secret in a register an
# address is formed from is a memory access whose address is formed from a
# secret. the walk of the encoded bytes decides the rest, as the copies,
# frame and loops the later steps make, so a target's loops and the
# target-neutral pseudo-instructions are not asked here. a refusal is masc's
# one record, at the instruction and the operand that holds the secret.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mct: mirl.ct;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;

use masc.core.ct;
use mo: masc.core.operand;
use masc.core.state;

# a secret where constant-time code may hold none
# ---
# instruction: the instruction, by its index in the function
# refusal:     masc's record
pub rec Found {
    instruction: u32;
    refusal:     ct.Refusal;
}

fun secret_in(secret: *vector.Vector[bool], r: Register) bool {
    if (sel r.virtual) { ret r.virtual.index::usize < secret.len && secret.data[r.virtual.index]; }
    ret false;
}

fun mark(secret: *vector.Vector[bool], r: Register) {
    if (sel r.virtual) {
        if (r.virtual.index::usize < secret.len) { secret.data[r.virtual.index] = true; }
    }
}

# each virtual register is secret when any instruction writing it is
fun secrecy(f: *Function, secret: *vector.Vector[bool]) {
    var k: usize = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            val d:     *InstructionData = function.data(f, list.data[i]);
            val count: u32              = d.operands.size::u32;
            var n:     u32              = 0;
            for (d.metadata.secret && n < count) {
                val o:      Operand = d.operands.data[n];
                val writes: bool    = (instruction.role(d.opcode, count, n) & mo.WRITE) != 0;
                if (sel o.virtual) {
                    if (writes) { mark(secret, Register.virtual{o.virtual}); }
                }
                if (sel o.tied) { mark(secret, o.tied.dest); }
                if (sel o.list) {
                    if (writes) { mark(secret, o.list.first); }
                }
                if (sel o.address) {
                    val base: opt[Register] = o.address.base;
                    if (sel base.some) {
                        if (operand.writes_back(o.address)) { mark(secret, base.some); }
                    }
                }
                n = n + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

# whether operand `o` reads a secret register its value is held in, and whether its address is formed from one
fun reads_secret(secret: *vector.Vector[bool], o: Operand) bool {
    if (sel o.virtual) { ret secret_in(secret, Register.virtual{o.virtual}); }
    if (sel o.tied)    { ret secret_in(secret, o.tied.source); }
    if (sel o.list)    { ret secret_in(secret, o.list.first); }
    ret false;
}

fun addressed_by_secret(secret: *vector.Vector[bool], o: Operand) bool {
    if (!(sel o.address)) { ret false; }
    val base:  opt[Register] = o.address.base;
    val index: opt[Register] = o.address.index;
    if (sel base.some) {
        if (secret_in(secret, base.some)) { ret true; }
    }
    if (sel index.some) {
        if (secret_in(secret, index.some)) { ret true; }
    }
    ret false;
}

# the first refusal of instruction `d` of `f`, whose virtual registers are secret as `secret` says
fun refusal(d: *InstructionData, ctx: *state.Context, secret: *vector.Vector[bool]) opt[ct.Refusal] {
    if (!(sel d.opcode.row)) { ret opt[ct.Refusal].none{}; }
    val count: u32 = d.operands.size::u32;
    var n:     u32 = 0;
    for (n < count) {
        val o: Operand = d.operands.data[n];
        if (addressed_by_secret(secret, o)) { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
        val reads: bool = (instruction.role(d.opcode, count, n) & mo.READ) != 0;
        if (reads && reads_secret(secret, o)) {
            val late: opt[ct.Refusal] = mct.latency(d.opcode.row, ctx, ct.Input.operand{n::u8});
            if (sel late.some) { ret late; }
        }
        n = n + 1;
    }
    ret opt[ct.Refusal].none{};
}

# the machine form's constant-time check of the selected function `f`, run under the context `ctx`
# ---
# ret: the first secret it holds where it may hold none, none when it holds none, or why there was no storage
pub fun check(a: *allocator.Allocator, f: *Function, ctx: *state.Context) res[opt[Found], allocator.Error] {
    var secret: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?secret); }
    var v: usize = 0;
    for (v < f.virtuals.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?secret, false);
        if (sel pushed.err) { ret res[opt[Found], allocator.Error].err{pushed.err}; }
        v = v + 1;
    }
    secrecy(f, ?secret);
    var k: usize = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            val r: opt[ct.Refusal] = refusal(function.data(f, list.data[i]), ctx, ?secret);
            if (sel r.some) { ret res[opt[Found], allocator.Error].ok{opt[Found].some{Found{instruction: list.data[i].index, refusal: r.some}}}; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret res[opt[Found], allocator.Error].ok{opt[Found].none{}};
}

# whether instruction `d` may write a secret: it is secret, or it reads a secret register
fun writes_secret(d: *InstructionData, secret: *vector.Vector[bool]) bool {
    if (d.metadata.secret) { ret true; }
    val count: u32 = d.operands.size::u32;
    var n:     u32 = 0;
    for (n < count) {
        if ((instruction.role(d.opcode, count, n) & mo.READ) != 0 && reads_secret(secret, d.operands.data[n])) { ret true; }
        n = n + 1;
    }
    ret false;
}

# each slot of `into` that an instruction of `f` writing a secret writes is marked secret, the slots of `f` being the
# first of `into`'s in order
fun mark_written(f: *Function, secret: *vector.Vector[bool], into: *Function) {
    var k: usize = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            val d: *InstructionData = function.data(f, list.data[i]);
            if (writes_secret(d, secret)) {
                val count: u32 = d.operands.size::u32;
                var n:     u32 = 0;
                for (n < count) {
                    val o: Operand = d.operands.data[n];
                    if (sel o.slot) {
                        if ((instruction.role(d.opcode, count, n) & mo.WRITE) != 0 && o.slot.index::usize < into.slots.len) { into.slots.data[o.slot.index].secret = true; }
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

# the slots of the allocated function `allocated` that may hold a secret marked so: a frame local of the selected
# function `selected` that an instruction writing a secret stores into, and a spill slot the allocator gave a secret
# value, as the spill that writes it is secret. allocation keeps the selected function's slots first, in order
pub fun mark_slots(a: *allocator.Allocator, selected: *Function, allocated: *Function) err[allocator.Error] {
    var secret: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?secret); }
    var v: usize = 0;
    for (v < selected.virtuals.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?secret, false);
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        v = v + 1;
    }
    secrecy(selected, ?secret);
    mark_written(selected, ?secret, allocated);
    var none: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?none); }
    mark_written(allocated, ?none, allocated);
    ret err[allocator.Error].ok{};
}
