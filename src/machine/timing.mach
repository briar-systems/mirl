# the machine form's constant-time check of a selected function
#
# selection leaves every value in a virtual register, and a virtual register
# holds a secret when the function states it may, as the ir value it was
# made for is secret. for an instruction of a row, a secret
# in an operand the row reads is asked of the row's class under the context
# the function runs under (`mirl.ct.latency`), and a secret in a register an
# address is formed from is a memory access whose address is formed from a
# secret. the walk of the encoded bytes decides the rest, as the copies,
# frame and loops the later steps make, so a target's loops and the
# target-neutral pseudo-instructions are not asked here. a refusal is masc's
# one record, at the instruction and the operand that holds the secret. a
# conditional branch selection marked as declassifying reads what it tests as
# public, as the walk's declassify point there says, and any other
# declassifying instruction leaves what it writes public.
#
# the timing of the integer multiply at a width (`multiply`) is read the same
# way, off the rows of every rule of the build's selection table that covers
# the multiply at that width, so a front end asks mirl, as mach's
# `$mach.build.ct_mul` does, and never states it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mct: mirl.ct;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;

use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.rule.Class;
use mirl.machine.isa;
use mirl.machine.isa.Isa;
use mirl.machine.isa.Isas;
use mirl.machine.select.rule;
use mirl.machine.select.rule.Rule;
use mirl.target.build.Build;
use mirl.target.capability.Bits;

use masc.core.ct;
use mo:   masc.core.operand;
use rows: masc.core.row;
use masc.core.state;

# a secret where constant-time code may hold none
# ---
# instruction: the instruction, by its index in the function
# refusal:     masc's record
pub rec Error {
    instruction: u32;
    refusal:     ct.Refusal;
}

fun secret_in(secret: *vector.Vector[bool], r: Register) bool {
    if (sel r.virtual) { ret r.virtual::usize < secret.len && secret.data[r.virtual]; }
    ret false;
}

# whether operand `o` reads a secret register its value is held in, and whether its address is formed from one
fun reads_secret(secret: *vector.Vector[bool], o: Operand) bool {
    if (sel o.virtual) { ret secret_in(secret, Register.virtual{o.virtual}); }
    if (sel o.member)  { ret secret_in(secret, Register.virtual{o.member.virtual}); }
    if (sel o.tied)    { ret secret_in(secret, o.tied.source); }
    if (sel o.list)    { ret secret_in(secret, o.list.first); }
    ret false;
}

fun addressed_by_secret(secret: *vector.Vector[bool], o: Operand) bool {
    if (!(sel o.address)) { ret false; }
    val base:  opt[Register] = o.address.base;
    val index: opt[Register] = o.address.index;
    if (sel base.some) {
        if (secret_in(secret, base.some)) { ret true; }
    }
    if (sel index.some) {
        if (secret_in(secret, index.some)) { ret true; }
    }
    ret false;
}

# the first refusal of instruction `d` of `f`, whose virtual registers are secret as `secret` says
fun refusal(d: *InstructionData, ctx: *state.Context, secret: *vector.Vector[bool]) opt[ct.Refusal] {
    if (!(sel d.opcode.row)) { ret opt[ct.Refusal].none{}; }
    val public: bool = d.declassifies && d.opcode.row.effect.control.conditional;
    val count:  u32  = d.operands.size::u32;
    var n:      u32  = 0;
    for (n < count) {
        val o: Operand = d.operands.data[n];
        if (addressed_by_secret(secret, o)) { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
        val reads: bool = (instruction.role(d.opcode, count, n) & mo.READ) != 0;
        if (reads && !public && reads_secret(secret, o)) {
            val late: opt[ct.Refusal] = mct.latency(d.opcode.row, ctx, ct.Input.operand{n::u8});
            if (sel late.some) { ret late; }
        }
        n = n + 1;
    }
    ret opt[ct.Refusal].none{};
}

# the machine form's constant-time check of the selected function `f`, run under the context `ctx`
# ---
# ret: the first secret it holds where it may hold none, none when it holds none, or why there was no storage
pub fun check(a: *allocator.Allocator, f: *Function, ctx: *state.Context) res[opt[Error], allocator.Error] {
    var timed: mct.Timed = mct.plain(ctx);
    fin { mct.release(?timed); }
    val assumed: err[allocator.Error] = mct.assume(a, ctx, ?timed);
    if (sel assumed.err) { ret res[opt[Error], allocator.Error].err{assumed.err}; }
    var k: usize = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, (k::u32));
        var i:    usize              = 0;
        for (i < list.size) {
            val r: opt[ct.Refusal] = refusal(function.data(f, list.data[i]), ?timed.context, ?f.secret);
            if (sel r.some) { ret res[opt[Error], allocator.Error].ok{opt[Error].some{Error{instruction: list.data[i], refusal: r.some}}}; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret res[opt[Error], allocator.Error].ok{opt[Error].none{}};
}

# whether instruction `d` may write a secret: it is secret, or it reads a secret register
fun writes_secret(d: *InstructionData, secret: *vector.Vector[bool]) bool {
    if (d.metadata.secret) { ret true; }
    val count: u32 = d.operands.size::u32;
    var n:     u32 = 0;
    for (n < count) {
        if ((instruction.role(d.opcode, count, n) & mo.READ) != 0 && reads_secret(secret, d.operands.data[n])) { ret true; }
        n = n + 1;
    }
    ret false;
}

# each slot of `into` that an instruction of `f` writing a secret writes is marked secret, the slots of `f` being the
# first of `into`'s in order
fun mark_written(f: *Function, secret: *vector.Vector[bool], into: *Function) {
    var k: usize = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, (k::u32));
        var i:    usize              = 0;
        for (i < list.size) {
            val d: *InstructionData = function.data(f, list.data[i]);
            if (writes_secret(d, secret)) {
                val count: u32 = d.operands.size::u32;
                var n:     u32 = 0;
                for (n < count) {
                    val o: Operand = d.operands.data[n];
                    if (sel o.slot) {
                        if ((instruction.role(d.opcode, count, n) & mo.WRITE) != 0 && o.slot::usize < into.slots.len) { into.slots.data[o.slot].secret = true; }
                    }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        k = k + 1;
    }
}

# the slots of the allocated function `allocated` that may hold a secret marked so: a frame local of the selected
# function `selected` that an instruction writing a secret stores into, and a spill slot the allocator gave a value
# that may hold a secret, as the spill that writes it is secret. allocation keeps the selected function's slots
# first, in order
pub fun mark_slots(selected: *Function, allocated: *Function) {
    mark_written(selected, ?selected.secret, allocated);
    mark_written(allocated, ?allocated.secret, allocated);
}

# whether an integer multiply of a width runs in time independent of its operands on a build
# ---
# constant:     it does under the timing modes the system sets for every process
# under:        it does only under these timing modes too (`mirl.ct.Needs`), each named by the feature that
#               guarantees it (`mirl.ct.missing`), as dit on aarch64 and zkt on riscv
# variable:     it does under no timing mode the set has
# helper:       no rule of the build's selection table covers it at that width, so a helper computes it
# unclassified: the build's instruction set classifies no instruction's timing, or guarantees none, or mirl carries no
#               selection table for it
pub tag Multiply: u8 {
    constant;
    under: mct.Needs;
    variable;
    helper;
    unclassified;
}

# whether type test `t` of a rule admits an integer of `width` bits, against the target's register of `register`
fun admits_width(t: *rule.Test, width: u32, register: u32) bool {
    if (t.lanes) { ret false; }
    val c: Class = t.class;
    if (sel c.width) {
        if (c.width != width) { ret false; }
    }
    or (!(sel c.integer) && !(sel c.any) && !(sel c.scalar)) { ret false; }
    val w: rule.Width = t.width;
    if (sel w.any)      { ret true; }
    if (sel w.register) { ret width == register; }
    if (sel w.part)     { ret w.part != 0 && width * w.part::u32 == register; }
    if (sel w.whole)    { ret width == register * w.whole::u32; }
    ret false;
}

# whether rule `r` covers an instruction of opcode `op` and its every type test admits an integer of `width` bits
fun covers(r: *Rule, op: Opcode, width: u32, register: u32) bool {
    var found: bool = false;
    var n:     u32  = 0;
    for (n < r.nodes.len) {
        if (r.nodes.at[n].opcode == op) { found = true; }
        n = n + 1;
    }
    if (!found) { ret false; }
    var t: u32 = 0;
    for (t < r.tests.len) {
        if (!admits_width(?r.tests.at[t], width, register)) { ret false; }
        t = t + 1;
    }
    ret true;
}

# whether every row of the expansion of rule `r` is admitted under `ctx`
fun available(r: *Rule, ctx: *state.Context) bool {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *rule.Emit = ?r.expansion.at[e];
        var n:    u32        = 0;
        for (n < instruction.rows_in(emit.opcode)) {
            if (!state.admits(ctx, instruction.row_in(emit.opcode, n).requires)) { ret false; }
            n = n + 1;
        }
        e = e + 1;
    }
    ret true;
}

# whether some row of the expansion of rule `r` takes a time that depends on one of its operands under `timed`
pub fun dependent(r: *Rule, timed: *state.Context) bool {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *rule.Emit = ?r.expansion.at[e];
        var n:    u32        = 0;
        for (n < instruction.rows_in(emit.opcode)) {
            val row: *rows.Row = instruction.row_in(emit.opcode, n);
            var k:   u32       = 0;
            for (k < row.operands.len) {
                val late: opt[ct.Refusal] = mct.latency(row, timed, ct.Input.operand{k::u8});
                if (sel late.some) { ret true; }
                k = k + 1;
            }
            n = n + 1;
        }
        e = e + 1;
    }
    ret false;
}

# whether some rule of `table` the build admits that covers `op` at `width` is dependent under `timed`, and whether
# any is admitted at all
fun any_dependent(table: *rule.Table, ctx: *state.Context, timed: *state.Context, op: Opcode, width: u32, register: u32, seen: *bool) bool {
    @seen = false;
    var i: u32 = 0;
    for (i < table.rules.len) {
        val r: *Rule = ?table.rules.at[i];
        if (covers(r, op, width, register) && available(r, ctx)) {
            @seen = true;
            if (dependent(r, timed)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether the integer multiply `op` of `width` bits runs in time independent of its operands on build `b`
# ---
# a:     the allocator a context with a timing mode's extension takes
# isas:  the instruction sets mirl carries for the build's family
# b:     the build, opened for its target
# op:    the multiply, `mul` for the low half or one of `mul.high.u`, `mul.high.s` and `mul.high.su`
# width: the width of its operands, in bits
# ret:   how its time depends on its operands, or why there was no storage
pub fun multiply(a: *allocator.Allocator, isas: *Isas, b: *Build, op: Opcode, width: u32) res[Multiply, allocator.Error] {
    val asked: ct.Required = ct.required(b.basis.set.ct);
    if (!(sel asked.held)) { ret res[Multiply, allocator.Error].ok{Multiply.unclassified{}}; }
    val found: opt[*Isa] = isa.of(isas, b.basis.set);
    if (sel found.none) { ret res[Multiply, allocator.Error].ok{Multiply.unclassified{}}; }
    val reg: Bits = b.basis.target.caps.widths.register;
    if (!(sel reg.bits)) { ret res[Multiply, allocator.Error].ok{Multiply.helper{}}; }
    val ctx:   *state.Context = ?b.basis.context;
    var seen:  bool           = false;
    var timed: state.Context  = mct.stated(ctx);
    if (!any_dependent(found.some.table, ctx, ?timed, op, width, reg.bits, ?seen)) {
        if (!seen) { ret res[Multiply, allocator.Error].ok{Multiply.helper{}}; }
        ret res[Multiply, allocator.Error].ok{Multiply.constant{}};
    }
    val lifted: mct.Needs = mct.liftable_modes(ctx);
    if (lifted == mct.NO_NEEDS) { ret res[Multiply, allocator.Error].ok{Multiply.variable{}}; }
    var t: mct.Timed = mct.plain(ctx);
    fin { mct.release(?t); }
    val opened: err[allocator.Error] = mct.under(a, ctx, lifted, ?t);
    if (sel opened.err)                                                               { ret res[Multiply, allocator.Error].err{opened.err}; }
    if (any_dependent(found.some.table, ctx, ?t.context, op, width, reg.bits, ?seen)) { ret res[Multiply, allocator.Error].ok{Multiply.variable{}}; }
    ret res[Multiply, allocator.Error].ok{Multiply.under{lifted}};
}

# whether the integer multiply `op` of `width` bits on build `b` runs in time independent of its operands under the
# timing modes the build guarantees (`mirl.ct.guaranteed`), as a hard constant-time function holds it
pub fun multiply_guaranteed(a: *allocator.Allocator, isas: *Isas, b: *Build, op: Opcode, width: u32) res[bool, allocator.Error] {
    val got: res[Multiply, allocator.Error] = multiply(a, isas, b, op, width);
    if (sel got.err) { ret res[bool, allocator.Error].err{got.err}; }
    val m: Multiply = got.ok;
    if (sel m.constant) { ret res[bool, allocator.Error].ok{true}; }
    if (sel m.under)    { ret res[bool, allocator.Error].ok{(m.under & ~mct.guaranteed(b.basis.set, ?b.basis.context)) == 0}; }
    ret res[bool, allocator.Error].ok{false};
}
