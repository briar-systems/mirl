# the vector state an instruction runs under
#
# some rows' register groups and element widths turn on state no operand
# holds, which masc publishes as a record of the instruction set that sets
# it, as risc-v's vector type. a state holds that record, so the machine form
# carries it and names no set, and asks masc a row's grouping under it, or
# with none whether the row needs one. this is the one module of the machine
# form that names a set's record, the only kind masc publishes. a second kind
# makes the state a tag of one member each, with its grouping and spelling
# here and a keyword in the text form.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use mc:          masc.core.constraint;
use rows:        masc.core.row;
use riscv_vtype: masc.isa.riscv.vtype;

# a vector state
# ---
# vtype: risc-v's vector type, its element width, multiplier, tail and mask policy
pub rec State {
    vtype: riscv_vtype.Vtype;
}

# the state of an instruction that states none
pub val NONE: opt[State] = opt[State].none{};

# a state read from text, and the bytes of the text it covers
pub rec Read {
    state: State;
    len:   usize;
}

# whether two instructions state one vector state, or both none
pub fun same(a: opt[State], b: opt[State]) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel b.none) { ret false; }
    val v: riscv_vtype.Vtype = a.some.vtype;
    val w: riscv_vtype.Vtype = b.some.vtype;
    ret v.sew == w.sew && v.lmul == w.lmul && v.ta == w.ta && v.ma == w.ma;
}

# masc's grouping of row `r` under state `s`, or under no state, which
# answers whether the row needs one
pub fun grouping(r: *rows.Row, s: opt[State]) mc.Grouped {
    if (sel s.none) { ret mc.grouping(r.operands.at, r.operands.len, opt[mc.State].none{}); }
    ret riscv_vtype.grouping(r, s.some.vtype);
}

# the first operand of row `r` whose groups turn on a state, none when the
# row needs no state
pub fun needs(r: *rows.Row) opt[u32] {
    val g: mc.Grouped = grouping(r, NONE);
    if (sel g.needs) { ret opt[u32].some{g.needs::u32}; }
    ret opt[u32].none{};
}

# the state an instruction of row `r` takes of state `s` it was stated
# under, as a loop's step of the loop's: `s` when the row needs one, none
# otherwise
pub fun under(r: *rows.Row, s: opt[State]) opt[State] {
    val n: opt[u32] = needs(r);
    if (sel n.some) { ret s; }
    ret NONE;
}

# the vector type `text` starts with, in masc's spelling, as `e32, m2, ta, ma`
# with every field after the element width optional, none when it starts
# with none
pub fun read_vtype(text: View) opt[Read] {
    val got: opt[riscv_vtype.Read] = riscv_vtype.read(text);
    if (sel got.none) { ret opt[Read].none{}; }
    ret opt[Read].some{Read{state: State{vtype: got.some.vtype}, len: got.some.len}};
}

# word `k` of a state's spelling, every field of it in the order its reader
# reads them, none past the last or for a state with no encoding
pub fun word(s: State, k: u32) opt[str] {
    val v:    riscv_vtype.Vtype = s.vtype;
    val bits: opt[u64]          = riscv_vtype.encode(v);
    if (sel bits.none)  { ret opt[str].none{}; }
    if (k == 0)         { ret opt[str].some{riscv_vtype.SEW_NAMES[(bits.some >> 3) & 7]}; }
    if (k == 1)         { ret opt[str].some{riscv_vtype.LMUL_NAMES[bits.some & 7]}; }
    if (k == 2 && v.ta) { ret opt[str].some{"ta"}; }
    if (k == 2)         { ret opt[str].some{"tu"}; }
    if (k == 3 && v.ma) { ret opt[str].some{"ma"}; }
    if (k == 3)         { ret opt[str].some{"mu"}; }
    ret opt[str].none{};
}
