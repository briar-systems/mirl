# the configuration state an instruction runs under
#
# some rows' register groups turn on state an instruction sets at run time
# and no operand holds, as risc-v's vtype that vsetvli sets. masc states it as
# its configuration hooks over an opaque state: the set's hooks read and
# write the state's spelling, say what groups a row's operands form under it,
# and name it. a state holds those bits only, so the machine form carries it
# and names no set, and its text spells it after the hooks' name.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use A: std.allocator;
use std.collections.vector;

use core_config: masc.core.config;
use masc.core.effect;
use masc.core.footprint;
use rows: masc.core.row;
use mset: masc.core.set;

# a configuration state
# ---
# config: the bits masc's hooks of the set read
pub rec State {
    config: core_config.State;
}

# the state of an instruction that states none
pub val NONE: opt[State] = opt[State].none{};

# a state read from text, and the bytes of the text it covers
pub rec Read {
    state: State;
    len:   usize;
}

# whether two instructions state one configuration state, or both none
pub fun same(a: opt[State], b: opt[State]) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel b.none) { ret false; }
    ret a.some.config.bits == b.some.config.bits;
}

# the configuration a query of set `s` asks under for state `st`: the set's
# hooks and the state in force, none for an instruction that states none
pub fun configured(s: *mset.Set, st: opt[State]) core_config.Configured {
    var hooks: *core_config.Hooks = nil;
    if (s != nil)    { hooks = s.config; }
    if (sel st.none) { ret core_config.Configured{hooks: hooks, state: opt[core_config.State].none{}}; }
    ret core_config.Configured{hooks: hooks, state: opt[core_config.State].some{st.some.config}};
}

# the first operand of row `r` whose groups turn on a configuration state,
# none when the row needs no state. masc answers it from the row alone, as
# with no state in force it reads no context
pub fun needs(r: *rows.Row) opt[u32] {
    if (r.operands.len == 0) { ret opt[u32].none{}; }
    val n: effect.Answer[u32] = footprint.covers(r, 0, nil, core_config.UNKNOWN);
    if (sel n.undecided) {
        val why: effect.Undecided = n.undecided;
        if (sel why.configured) { ret opt[u32].some{why.configured::u32}; }
    }
    ret opt[u32].none{};
}

# the state an instruction of row `r` takes of state `s` it was stated
# under, as a loop's step of the loop's: `s` when the row needs one, none
# otherwise
pub fun under(r: *rows.Row, s: opt[State]) opt[State] {
    val n: opt[u32] = needs(r);
    if (sel n.some) { ret s; }
    ret NONE;
}

# the name set `s` gives its configuration state, which its text form spells
# a state after, none for a set with none
pub fun name_of(s: *mset.Set) opt[str] {
    if (s == nil || s.config == nil) { ret opt[str].none{}; }
    ret opt[str].some{s.config.name};
}

# the state `text` starts with in the spelling of set `s`, as risc-v's
# `e32, m2, ta, ma`, none when it starts with none or the set has none
pub fun read(s: *mset.Set, text: View) opt[Read] {
    if (s == nil || s.config == nil) { ret opt[Read].none{}; }
    val got: opt[core_config.Parsed] = s.config.parse(text);
    if (sel got.none) { ret opt[Read].none{}; }
    ret opt[Read].some{Read{state: State{config: got.some.state}, len: got.some.len}};
}

# state `st` spelled onto `out` in the spelling of the hooks of a set that
# has a configuration state, refused only when `out` cannot grow
pub fun spell(hooks: *core_config.Hooks, st: State, out: *vector.Vector[u8]) err[A.Error] {
    ret hooks.print(st.config, out);
}
