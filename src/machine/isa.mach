# the record of one instruction set mirl carries, and a registry of them
#
# a record joins masc's set to everything mirl writes for it: the selection
# table, the frame code, the moves between locations, the loops, the
# memory-backed classes and how it establishes its configuration state. the registry is data the caller hands in, so the
# selection engine, the compilation and the machine text read the record of
# a set and never name a set, a table or a registry of their own. a second
# set is a second record of the registry the target family states.

use std.types.option.opt;

use std.collections.slice.Slice;

use masc.core.mode;
use mset: masc.core.set;

use mirl.machine.class.Memory;
use mirl.machine.configure.StateRules;
use mirl.machine.copy.move;
use mirl.machine.frame.code.Code;
use mirl.machine.loop.row.Loops;
use mirl.machine.select.rule.Table;

# one carried instruction set
# ---
# set:      masc's instruction set, as its registry holds it
# table:    the selection table for it
# frame:    the code of its frame moves
# moves:    its moves between locations
# loops:    its loops, each spelled by its name and kept to its constraint
# memories: the memory-backed register classes it supplies, each named, none
#           for a set whose registers are all in its register file
# state:    how it establishes its configuration state, nil for a set with none
# relax:    the assembler mode that lets the linker relax its code, nil for a
#           set whose linker relaxes nothing
pub rec Isa {
    set:      *mset.Set;
    table:    *Table;
    frame:    *Code;
    moves:    *move.Table;
    loops:    Loops;
    memories: Slice[Memory];
    state:    *StateRules;
    relax:    *Relaxing;
}

# the settings of a set's assembler mode under which the linker may relax its
# code or may not, which a build's relax option chooses between
# ---
# on:  the linker may relax it, so masc marks each relocation it may resize
# off: the linker may not, so masc writes no relaxation marker
pub rec Relaxing {
    on:  mode.Setting;
    off: mode.Setting;
}

# a registry of records as a pointer to static records and a count
pub rec Isas {
    at:  *Isa;
    len: u32;
}

# the registry that carries no set, for a machine text read with no record
pub val NO_ISAS: Isas = Isas{at: nil, len: 0};

# the record of masc's set in a registry, none when the registry carries none
# ---
# r:   the registry
# s:   the set, as masc's registry finds it for the target's architecture
# ret: the record whose set it is
pub fun of(r: *Isas, s: *mset.Set) opt[*Isa] {
    var i: u32 = 0;
    for (i < r.len) {
        if (r.at[i].set == s) { ret opt[*Isa].some{?r.at[i]}; }
        i = i + 1;
    }
    ret opt[*Isa].none{};
}
