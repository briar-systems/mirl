# the record of one instruction set mirl carries, and a registry of them
#
# a record joins masc's set to everything mirl writes for it: the selection
# table, the frame code, the moves between locations, the loops, the
# memory-backed classes, how it establishes its configuration state and the
# short forms, zeroing, joined, tested and clearing rows it writes once registers are allocated. the registry is data
# the caller hands in, so the selection engine, the compilation, the hand-over
# and the machine text read the record of a set and never name a set, a table
# or a registry of their own. a second set is a second record of the registry
# the target family states.

use std.types.bool.bool;
use std.types.option.opt;

use std.collections.slice.Slice;

use masc.core.mode;
use rf: masc.core.register;
use masc.core.row;
use mset: masc.core.set;

use mirl.machine.class.Memory;
use mirl.machine.configure.StateRules;
use mirl.machine.copy.move;
use mirl.machine.frame.code.Code;
use mirl.machine.loop.row.Loops;
use mirl.machine.select.rule.Table;

# one carried instruction set
# ---
# set:       masc's instruction set, as its registry holds it
# table:     the selection table for it
# frame:     the code of its frame moves
# moves:     its moves between locations
# loops:     its loops, each spelled by its name and kept to its constraint
# memories:  the memory-backed register classes it supplies, each named, none
#            for a set whose registers are all in its register file
# state:     how it establishes its configuration state, nil for a set with none
# relax:     the assembler mode that lets the linker relax its code, nil for a
#            set whose linker relaxes nothing
# shorts:    the rows its instructions are written in once their registers are
#            allocated, none for a set whose rows read back whatever registers
#            they hold
# zeroings:  the rows an instruction of a register and zero is written in
#            once its register is allocated, none for a set that has none
# joinings:  the rows a copy and the row after it that reads and writes its
#            destination are written in as one, none for a set that has none
# testings:  the rows that leave flags as the test after them would, none for
#            a set that has none
# clearings: the rows a whole write of a register before a row that merges
#            into it is written in, none for a set that has none
pub rec Isa {
    set:       *mset.Set;
    table:     *Table;
    frame:     *Code;
    moves:     *move.Table;
    loops:     Loops;
    memories:  Slice[Memory];
    state:     *StateRules;
    relax:     *Relaxing;
    shorts:    Shorts;
    zeroings:  Zeroings;
    joinings:  Joinings;
    testings:  Testings;
    clearings: Clearings;
}

# a row an instruction is handed to masc in, in place of the row selection
# chose, when the registers allocation gave it are the ones the short row
# fixes, as x86's `cmp al, imm8`, which masc reads back from its text as 3C ib
# where 80 /7 ib was written. selection runs before allocation and cannot
# know the register, so the choice is the hand-over's. several shorts of one
# long row are tried in the order masc's reader prefers them, and the first
# whose fixed registers hold and whose requirement the view admits is taken
# ---
# long:  the row selection writes, for any register
# short: the row of the same operands that fixes one or more of them to a register
pub rec Short {
    long:  *row.Row;
    short: *row.Row;
}

# shorts as a pointer to static shorts and a count
pub rec Shorts {
    at:  *Short;
    len: u32;
}

# no shorts
pub val NO_SHORTS: Shorts = Shorts{at: nil, len: 0};

# a row an instruction of a register and zero is written in once the register is
# allocated, its two register operands both that register: x86's `xor eax,
# eax` for `mov eax, 0`, two bytes where the move takes five, `test rax, rax`
# for `cmp rax, 0`, and `xorps xmm0, xmm0` for a load of a float zero from
# read-only data. the zeroing states that the two leave every location both
# leave defined the same. the rows may differ in what else they write or
# leave unspecified, as xor writes the flags and the move does not, so the
# zeroing stage (`mirl.machine.zero`) writes the row only where every location
# the two leave unlike each other is dead. selection runs before allocation,
# when a register read at both operands would be a read of a value nothing
# wrote, so the choice is that stage's
# ---
# long:  the row selection writes, its register at operand 0 and zero at operand 1, an immediate or a memory operand
# short: the row of two registers that leaves what `long` does of zero when both are one register
pub rec Zeroing {
    long:  *row.Row;
    short: *row.Row;
}

# zeroings as a pointer to static zeroings and a count
pub rec Zeroings {
    at:  *Zeroing;
    len: u32;
}

# no zeroings
pub val NO_ZEROINGS: Zeroings = Zeroings{at: nil, len: 0};

# a copy and the row after it that reads and writes the copy's destination,
# written once registers are allocated as one row of three operands whose
# address sums the copy's source and the second row's other operand, as
# x86's `mov rcx, rax` and `add rcx, 8` as `lea rcx, [rax + 8]`. the joining
# states that the joined row leaves the destination as the two leave it
# where the copy is at least as wide as the second row, the address
# computing at the copy's width. the joined row writes less, as lea writes no
# flags, so the fusing stage (`mirl.machine.fuse`) writes it only where every
# location the two and the joined row leave unlike each other is dead
# ---
# copy:    the copy, its destination at operand 0 and its source at operand 1
# tied:    the row after it, the destination at operand 0, read and written, and a register or an immediate at operand 1
# joined:  the row of the destination at operand 0 and an address at operand 1
# negated: the immediate enters the address negated, as a subtraction's
# address: the register class whose register of the same number the address names
pub rec Joining {
    copy:    *row.Row;
    tied:    *row.Row;
    joined:  *row.Row;
    negated: bool;
    address: u16;
}

# joinings as a pointer to static joinings and a count
pub rec Joinings {
    at:  *Joining;
    len: u32;
}

# no joinings
pub val NO_JOININGS: Joinings = Joinings{at: nil, len: 0};

# a row that leaves flags as a test of its result would, so the test after it
# of the register it writes against itself is dropped once registers are
# allocated, as x86's `and rax, 15` before `test rax, rax`. the testing
# states the flags `row` leaves as `test` leaves them of the same register.
# the fusing stage (`mirl.machine.fuse`) drops the test only where every
# other flag the test leaves defined is dead after it
# ---
# row:  the row, its result at operand 0
# test: the test, the register at both operands, at the width `row` writes
# same: the flags `row` leaves as `test` does
pub rec Testing {
    row:  *row.Row;
    test: *row.Row;
    same: Slice[rf.Id];
}

# testings as a pointer to static testings and a count
pub rec Testings {
    at:  *Testing;
    len: u32;
}

# no testings
pub val NO_TESTINGS: Testings = Testings{at: nil, len: 0};

# a whole write of a register right before a row that merges into it, its
# write of some bits of the register reading the rest, written once registers
# are allocated as a row of that register at both operands that writes it
# whole: x86's `movd xmm0, eax` before `cvtsi2ss xmm0, eax` as `xorps xmm0,
# xmm0`, which reads no general register. the write stands there only to
# define the bits the merge keeps, as mirl writes no result in part. the
# clearing states that the write and the clear row leave the register unlike
# only in bits the merge writes, so the merge leaves it the same after
# either. the fusing stage (`mirl.machine.fuse`) writes the clear row only
# where the merge reads the register at operand 0 alone and every other
# location the write and the clear row leave unlike is dead. selection runs
# before allocation, when a register read at both operands would be a read
# of a value nothing wrote, so the choice is that stage's
# ---
# write: the whole write, its register at operand 0
# merge: the row after it, the same register at operand 0, read and written
# clear: the row of two registers that writes the register whole when both are one register
pub rec Clearing {
    write: *row.Row;
    merge: *row.Row;
    clear: *row.Row;
}

# clearings as a pointer to static clearings and a count
pub rec Clearings {
    at:  *Clearing;
    len: u32;
}

# no clearings
pub val NO_CLEARINGS: Clearings = Clearings{at: nil, len: 0};

# the settings of a set's assembler mode under which the linker may relax its
# code or may not, which a build's relax option chooses between
# ---
# on:  the linker may relax it, so masc marks each relocation it may resize
# off: the linker may not, so masc writes no relaxation marker
pub rec Relaxing {
    on:  mode.Setting;
    off: mode.Setting;
}

# a registry of records as a pointer to static records and a count
pub rec Isas {
    at:  *Isa;
    len: u32;
}

# the record of masc's set in a registry, none when the registry carries none
# ---
# r:   the registry
# s:   the set, as masc's registry finds it for the target's architecture
# ret: the record whose set it is
pub fun of(r: *Isas, s: *mset.Set) opt[*Isa] {
    var i: u32 = 0;
    for (i < r.len) {
        if (r.at[i].set == s) { ret opt[*Isa].some{?r.at[i]}; }
        i = i + 1;
    }
    ret opt[*Isa].none{};
}
