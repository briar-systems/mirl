# the target-neutral pseudo-instructions, which emit no bytes
#
# each pseudo is one row of the table below: the kind and role of each of its
# operand positions. a variadic row repeats every position the same number of
# times, each position's repeats together and in order, so a parallel copy is
# its destinations and then its sources.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mo: masc.core.operand;

# a pseudo-instruction, as its row in the table
pub def Pseudo: u8;

pub val COPY:          Pseudo = 0;
pub val PARALLEL_COPY: Pseudo = 1;
pub val SPILL:         Pseudo = 2;
pub val RELOAD:        Pseudo = 3;
pub val FRAME_SETUP:   Pseudo = 4;
pub val FRAME_DESTROY: Pseudo = 5;

# what a pseudo's operand position admits
# ---
# REGISTER: a register of any class
# SLOT:     a frame slot
pub def Kind: u8;

pub val REGISTER: Kind = 0;
pub val SLOT:     Kind = 1;

# one operand position of a pseudo
# ---
# kind: what it admits
# role: how the pseudo uses it
pub rec Position {
    kind: Kind;
    role: mo.Role;
}

# one pseudo
# ---
# name:      the spelling the text form prints
# positions: its operand positions
# count:     how many positions there are
# variadic:  whether the positions repeat, at least once
pub rec Row {
    name:      str;
    positions: *Position;
    count:     u32;
    variadic:  bool;
}

val MOVE:  [2]Position = [2]Position{Position{kind: REGISTER, role: mo.WRITE}, Position{kind: REGISTER, role: mo.READ}};
val STORE: [2]Position = [2]Position{Position{kind: SLOT, role: mo.WRITE}, Position{kind: REGISTER, role: mo.READ}};
val LOAD:  [2]Position = [2]Position{Position{kind: REGISTER, role: mo.WRITE}, Position{kind: SLOT, role: mo.READ}};

val ROWS: [6]Row = [6]Row{
    Row{name: "copy", positions: ?MOVE[0], count: 2, variadic: false},
    Row{name: "parallel_copy", positions: ?MOVE[0], count: 2, variadic: true},
    Row{name: "spill", positions: ?STORE[0], count: 2, variadic: false},
    Row{name: "reload", positions: ?LOAD[0], count: 2, variadic: false},
    Row{name: "frame_setup", positions: nil, count: 0, variadic: false},
    Row{name: "frame_destroy", positions: nil, count: 0, variadic: false},
};

# the row of a pseudo, none when it names none
pub fun row(p: Pseudo) opt[*Row] {
    if (p::usize >= $length_of(ROWS)) { ret opt[*Row].none{}; }
    ret opt[*Row].some{?ROWS[p]};
}

# the position an operand stands at among `operands` of a pseudo's row, none
# when the count does not fit the row
pub fun position(r: *Row, operands: u32, at: u32) opt[*Position] {
    if (!r.variadic) {
        if (operands != r.count || at >= operands) { ret opt[*Position].none{}; }
        ret opt[*Position].some{?r.positions[at]};
    }
    if (r.count == 0 || operands == 0 || operands % r.count != 0 || at >= operands) { ret opt[*Position].none{}; }
    ret opt[*Position].some{?r.positions[at / (operands / r.count)]};
}
