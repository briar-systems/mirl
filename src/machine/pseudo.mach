# the target-neutral pseudo-instructions, which emit no bytes
#
# each pseudo is one row of the table below: the kind and role of each of its
# operand positions. a variadic row repeats every position the same number of
# times, each position's repeats together and in order, so a parallel copy is
# its destinations and then its sources. a copy moves a value between any two
# locations, registers, cells or frame slots, which the lowering of copies
# turns into the target's moves once the frame has placed every slot. a
# table names blocks, the targets of the indirect jump before it, which every
# walk of block operands reads as its block's successors.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view_eq_str;

use mo: masc.core.operand;

# a pseudo-instruction, as its row in the table
pub def Pseudo: u8;

pub val COPY:          Pseudo = 0;
pub val PARALLEL_COPY: Pseudo = 1;
pub val SPILL:         Pseudo = 2;
pub val RELOAD:        Pseudo = 3;
pub val FRAME_SETUP:   Pseudo = 4;
pub val FRAME_DESTROY: Pseudo = 5;
# a dynamic allocation: its destination gets the address of a new block of
# as many bytes as its source holds, below every slot of the frame, which the
# frame expands into its stack pointer moves
pub val DYNAMIC: Pseudo = 6;
# the address of a frame slot plus a displacement, which the frame expands once offsets are known
pub val ADDRESS: Pseudo = 7;
# a jump table: one entry per operand, the address of its block, in order.
# it ends the block after the indirect jump that reads it, emits no code, and
# is laid out as data at its label, which the jump's address names as a partner
pub val TABLE: Pseudo = 8;
# where the storage of a frame slot begins and ends, as the ir's `slot.begin` and `slot.end` state it: neither reads
# nor writes the slot, the sharing of frame slots reads them, and the lowering of copies drops them
pub val SLOT_BEGIN: Pseudo = 9;
pub val SLOT_END:   Pseudo = 10;

# what a pseudo's operand position admits
# ---
# REGISTER:  a register of any class
# SLOT:      a frame slot
# LOCATION:  a register of any class or a frame slot
# BLOCK:     a block of the function
# IMMEDIATE: a number
pub def Kind: u8;

pub val REGISTER:  Kind = 0;
pub val SLOT:      Kind = 1;
pub val LOCATION:  Kind = 2;
pub val BLOCK:     Kind = 3;
pub val IMMEDIATE: Kind = 4;

# one operand position of a pseudo
# ---
# kind: what it admits
# role: how the pseudo uses it
pub rec Position {
    kind: Kind;
    role: mo.Role;
}

# one pseudo
# ---
# name:      the spelling the text form prints
# positions: its operand positions
# count:     how many positions there are
# variadic:  whether the positions repeat, at least once
pub rec Row {
    name:      str;
    positions: *Position;
    count:     u32;
    variadic:  bool;
}

val MOVE:       [2]Position = [2]Position{Position{kind: REGISTER, role: mo.WRITE}, Position{kind: REGISTER, role: mo.READ}};
val STORE:      [2]Position = [2]Position{Position{kind: SLOT, role: mo.WRITE}, Position{kind: REGISTER, role: mo.READ}};
val LOAD:       [2]Position = [2]Position{Position{kind: REGISTER, role: mo.WRITE}, Position{kind: SLOT, role: mo.READ}};
val COPYING:    [2]Position = [2]Position{Position{kind: LOCATION, role: mo.WRITE}, Position{kind: LOCATION, role: mo.READ}};
val ADDRESSING: [3]Position = [3]Position{Position{kind: REGISTER, role: mo.WRITE}, Position{kind: SLOT, role: mo.READ}, Position{kind: IMMEDIATE, role: mo.NONE}};
val ENTRY:      [1]Position = [1]Position{Position{kind: BLOCK, role: mo.NONE}};
val MARKED:     [1]Position = [1]Position{Position{kind: SLOT, role: mo.NONE}};

val ROWS: [11]Row = [11]Row{
    Row{name: "copy", positions: ?COPYING[0], count: 2, variadic: false},
    Row{name: "parallel_copy", positions: ?COPYING[0], count: 2, variadic: true},
    Row{name: "spill", positions: ?STORE[0], count: 2, variadic: false},
    Row{name: "reload", positions: ?LOAD[0], count: 2, variadic: false},
    Row{name: "frame_setup", positions: nil, count: 0, variadic: false},
    Row{name: "frame_destroy", positions: nil, count: 0, variadic: false},
    Row{name: "dynamic", positions: ?MOVE[0], count: 2, variadic: false},
    Row{name: "address", positions: ?ADDRESSING[0], count: 3, variadic: false},
    Row{name: "table", positions: ?ENTRY[0], count: 1, variadic: true},
    Row{name: "slot_begin", positions: ?MARKED[0], count: 1, variadic: false},
    Row{name: "slot_end", positions: ?MARKED[0], count: 1, variadic: false},
};

# whether a pseudo is a copy: a copy, a parallel copy, a spill or a reload, each its destinations then its sources. it
# moves a value whole between its locations, and a frame slot among them holds as many bytes as the move does, so a
# slot a copy names is sized by the value it holds
pub fun copies(p: Pseudo) bool {
    ret p == COPY || p == PARALLEL_COPY || p == SPILL || p == RELOAD;
}

# whether a pseudo marks where a slot's storage begins or ends
pub fun marks(p: Pseudo) bool {
    ret p == SLOT_BEGIN || p == SLOT_END;
}

# the row of a pseudo, none when it names none
pub fun row(p: Pseudo) opt[*Row] {
    if (p::usize >= $length_of(ROWS)) { ret opt[*Row].none{}; }
    ret opt[*Row].some{?ROWS[p]};
}

# the position an operand stands at among `operands` of a pseudo's row, none
# when the count does not fit the row
pub fun position(r: *Row, operands: u32, at: u32) opt[*Position] {
    if (!r.variadic) {
        if (operands != r.count || at >= operands) { ret opt[*Position].none{}; }
        ret opt[*Position].some{?r.positions[at]};
    }
    if (r.count == 0 || operands == 0 || operands % r.count != 0 || at >= operands) { ret opt[*Position].none{}; }
    ret opt[*Position].some{?r.positions[at / (operands / r.count)]};
}

# the pseudo a row's name spells, none when the table has no such row
pub fun named(name: View) opt[Pseudo] {
    var k: usize = 0;
    for (k < $length_of(ROWS)) {
        if (view_eq_str(name, ROWS[k].name)) { ret opt[Pseudo].some{k::Pseudo}; }
        k = k + 1;
    }
    ret opt[Pseudo].none{};
}
