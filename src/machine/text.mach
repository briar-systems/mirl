# the text form of the machine form: its grammar, the printer, the parser and
# structural equality
#
# a machine function and its text are interchangeable, as a module and its ir
# text are. selection and allocation tests are machine form text in and text
# out. this is not the assembly listing, which is masc's syntax for the encoded
# bytes and comes after emission: the text shows virtual registers, tied
# operands and the state before allocation, which assembly cannot express.
#
# the text begins with the version of mirl that wrote it and names the target,
# as the ir text form does, and promises no stability across versions. it names
# the module it is the code of: a function and a symbol operand are named by
# the symbols of that module, and a location, site or binding by its entry in
# that module's debug table. the target line must be the module's.
#
# the text holds no name table. a register is spelled by its name, or an alias
# of it, in the register file of the target's instruction set, and an
# instruction by a mnemonic of its catalog, so a register or instruction added
# to masc needs no change here. a name masc does not hold is refused, naming
# its line and column. a mnemonic with several encodings is several catalog
# rows in preference order, and a row after the first is spelled by its place
# among them in angle brackets.
#
# grammar
#
# the tokens are those of the ir text form, and the grammar is ebnf as there.
#
#   unit        = version target { item } ;
#   item        = newline | function ;
#   function    = "function" symbol "{" newline { line } "}" newline ;
#   line        = newline | virtual | slot | block | instruction newline ;
#   virtual     = "virtual" local ":" class newline ;
#   class       = "class" uint | "memory" uint ;
#   slot        = "slot" "[" uint "]" ":" "size" uint "align" uint newline ;
#   block       = label ":" newline ;
#   instruction = opcode [ operand { "," operand } ] [ "loc" dref ]
#                 [ "site" dref ] [ "volatile" ] [ "secret" ]
#                 [ "bind" "[" [ dref { "," dref } ] "]" ] ;
#   opcode      = name [ "<" uint ">" ] | "pseudo" word ;
#   operand     = register | register "=" register | immediate | slot
#               | symbol | label ;
#   register    = local | name | cell ;
#   cell        = "{" uint ":" uint "}" ;
#   immediate   = [ "-" ] uint ;
#   slot        = "[" uint "]" ;
#   symbol      = symbol [ ( "+" | "-" ) uint ] ":" word ;
#
# a class is a class row of the target's register file by its position, or a
# memory-backed class by its position in the list the target supplies. a
# virtual register prints as `%` and its number, a block as `^` and its number
# and a slot by its number, and a reader takes any name for a virtual register
# or block and gives it to the one it declares or labels. a name is a word, or
# quoted when it is a word the grammar reads as a keyword: loc, site,
# volatile, secret, bind, pseudo, virtual and slot. `a = b` is a tied operand,
# a written and b read, which allocation gives one location. a cell is a
# location of a memory-backed class. a symbol operand ends with the name of its
# relocation kind in mink's vocabulary. a pseudo-instruction is spelled by the
# name of its row in the pseudo table. a function names the symbol it is the
# code of, its virtual registers and slots in order, and its blocks, the first
# the entry.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.filesystem;
use io:   std.io.writer;
use diag: std.print;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.machine.class.Memory;
use mirl.machine.function;
use mirl.machine.text.equal;
use mirl.machine.text.item;
use reader:   mirl.machine.text.parse;
use printing: mirl.machine.text.print;

fwd item.Env;
fwd item.Item;

fwd printing.print;

fwd reader.Unit;
fwd reader.parse;
fwd reader.parse_body;
fwd reader.dnit;

fwd equal.same;
fwd equal.same_function;

#[testing]
val MEMORIES: [1]*Memory = [1]*Memory{?function.T_PAGE};

#[testing]
fun environment() item.Env {
    ret item.Env{set: ?function.T_SET, memories: Slice[*Memory]{data: ?MEMORIES[0], size: 1}};
}

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

val ONE_FUNCTION: str = "target \"mtest\"\nfunction @f: fun(i32) -> (i32) {\n^entry(%a: i32):\n    ret %a\n}\n";

test text__refuses_a_register_masc_does_not_know {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ONE_FUNCTION));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    var env: item.Env = environment();

    val good: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, ?env, view_of("target \"mtest\"\n\nfunction @f {\n^0:\n    add r0, r1\n}\n"));
    if (sel good.err) { ret 2; }
    var kept: reader.Unit = good.ok;
    reader.dnit(?kept);

    val bad: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, ?env, view_of("target \"mtest\"\n\nfunction @f {\n^0:\n    add r9, r1\n}\n"));
    if (sel bad.ok)                                           { ret 3; }
    if (bad.err.line != 5 || bad.err.column != 9)             { ret 4; }
    if (!(sel bad.err.reason.unknown))                        { ret 5; }
    if (!str_equals(bad.err.reason.unknown.what, "register")) { ret 6; }
    ret 0;
}

fun path_of(buf: *u8, name: str) str {
    val dir: str   = "test/machine/";
    var n:   usize = 0;
    var i:   usize = 0;
    for (i < str_len(dir)) {
        buf[n] = dir[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(name)) {
        buf[n] = name[i];
        n      = n + 1;
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf;
}

fun read_file(a: *allocator.Allocator, name: str, swap_ir: bool) opt[vector.Vector[u8]] {
    var buf:  [256]u8;
    val path: str = path_of(?buf[0], name);
    if (swap_ir) { buf[str_len(path) - 1] = 'l'; }
    val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, path);
    if (sel file.err) { ret opt[vector.Vector[u8]].none{}; }
    ret opt[vector.Vector[u8]].some{file.ok};
}

#[testing]
# print the text of a module's machine functions, read it back and compare
fun round_trip(a: *allocator.Allocator, name: str) u32 {
    val ir: opt[vector.Vector[u8]] = read_file(a, name, true);
    val mt: opt[vector.Vector[u8]] = read_file(a, name, false);
    if (sel ir.none) { ret 1; }
    if (sel mt.none) { ret 1; }
    var made: res[Module, Refusal] = ir_reader.parse_body(a, View{data: ir.some.data, len: ir.some.len});
    if (sel made.err) { ret 2; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    var env:   item.Env                  = environment();
    var first: res[reader.Unit, Refusal] = reader.parse_body(a, ?m, ?env, View{data: mt.some.data, len: mt.some.len});
    if (sel first.err) {
        var out: io.Writer = filesystem.writer(filesystem.STDERR);
        diag.eprintf("{}:", name);
        ir_reader.describe(?out, first.err);
        diag.eprintln("");
        ret 3;
    }
    var one: reader.Unit = first.ok;
    fin { reader.dnit(?one); }
    var text: sink.Sink = sink.init(a);
    fin { sink.dnit(?text); }
    var w:     io.Writer          = sink.writer(?text);
    val wrote: err[printer.Error] = printing.print(?w, ?m, ?env, Slice[item.Item]{data: one.items.data, size: one.items.len});
    if (sel wrote.err) { ret 4; }
    var second: res[reader.Unit, Refusal] = reader.parse(a, ?m, ?env, sink.view(?text));
    if (sel second.err) {
        diag.eprintlnf("{}: printed text refused at {}:{}", name, second.err.line, second.err.column);
        ret 5;
    }
    var two: reader.Unit = second.ok;
    fin { reader.dnit(?two); }
    val same: res[bool, printer.Error] = equal.same(?m, Slice[item.Item]{data: one.items.data, size: one.items.len}, ?m, Slice[item.Item]{data: two.items.data, size: two.items.len});
    if (sel same.err) { ret 6; }
    if (!same.ok) {
        diag.eprintlnf("{}: the functions are not the functions read back", name);
        ret 7;
    }
    ret 0;
}

# every machine form text file of test/machine, each beside the ir text file of
# the module it is the code of, which `mach test` reaches from the project root
test text__every_machine_text_file_prints_and_reads_back_equal {
    var a: allocator.Allocator;
    page.make(?a);
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(?a, "test/machine");
    if (sel names.err) { ret 1; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirm")) {
            val code: u32 = round_trip(?a, name);
            if (code != 0) { ret 10 + code::i32; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 3; }
    ret 0;
}
