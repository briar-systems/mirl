# a registry, architecture and target given as data, for the tests whose
# instruction set no registry of the tree holds
#[testing]
rec Given {
    registry: *mset.Registry;
    arch:     *arches.Arch;
    target:   *Target;
}

# the synthetic set and its target
#[testing]
fun fixture() Given {
    ret Given{registry: ?synthetic.REGISTRY, arch: ?synthetic.ARCH, target: ?synthetic.TARGET};
}

#[testing]
fun read_text(a: *allocator.Allocator, m: *Module, given: opt[Given], text: View, versioned: bool) res[reader.Unit, Refusal] {
    if (sel given.some) {
        if (versioned) { ret reader.parse_in(a, m, given.some.registry, given.some.arch, given.some.target, text); }
        ret reader.parse_body_in(a, m, given.some.registry, given.some.arch, given.some.target, text);
    }
    if (versioned) { ret reader.parse(a, m, text); }
    ret reader.parse_body(a, m, text);
}

#[testing]
fun write_text(w: *io.Writer, m: *Module, given: opt[Given], items: Slice[item.Item]) err[printer.Error] {
    if (sel given.some) { ret printing.print_in(w, m, given.some.registry, given.some.arch, given.some.target, items); }
    ret printing.print(w, m, items);
}

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

val ONE_FUNCTION: str = "target \"mtest\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%a: i32):\n    ret %a\n}\n";

test text__refuses_a_register_masc_does_not_know {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ONE_FUNCTION));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val given: opt[Given] = opt[Given].some{fixture()};

    val good: res[reader.Unit, Refusal] = read_text(?a, ?m, given, view_of("target \"mtest\"\n\nfunction @f {\n^0:\n    add r0, r1\n}\n"), false);
    if (sel good.err) { ret 2; }
    var kept: reader.Unit = good.ok;
    reader.dnit(?kept);

    val bad: res[reader.Unit, Refusal] = read_text(?a, ?m, given, view_of("target \"mtest\"\n\nfunction @f {\n^0:\n    add r9, r1\n}\n"), false);
    if (sel bad.ok)                                           { ret 3; }
    if (bad.err.line != 5 || bad.err.column != 9)             { ret 4; }
    if (!(sel bad.err.reason.unknown))                        { ret 5; }
    if (!str_equals(bad.err.reason.unknown.what, "register")) { ret 6; }
    ret 0;
}

test text__refuses_a_memory_class_the_target_does_not_supply {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ONE_FUNCTION));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val bad: res[reader.Unit, Refusal] = read_text(?a, ?m, opt[Given].some{fixture()}, view_of("target \"mtest\"\n\nfunction @f {\n    virtual %0: memory missing\n^0:\n}\n"), false);
    if (sel bad.ok)                                               { ret 2; }
    if (!(sel bad.err.reason.unknown))                            { ret 3; }
    if (!str_equals(bad.err.reason.unknown.what, "memory class")) { ret 4; }
    ret 0;
}

# a target whose architecture no registered set serves is refused, naming the architecture
test text__refuses_a_target_whose_architecture_has_no_registered_set {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of("target \"x86_64-linux\"\n"));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val bad: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, view_of("target \"x86_64-linux\"\n"));
    if (sel bad.ok)                                                { ret 2; }
    if (!(sel bad.err.reason.target))                              { ret 3; }
    if (!(sel bad.err.reason.target.unregistered))                 { ret 4; }
    if (!str_equals(bad.err.reason.target.unregistered, "x86_64")) { ret 5; }
    var sink_text: sink.Sink = sink.init(?a);
    fin { sink.dnit(?sink_text); }
    var w:     io.Writer          = sink.writer(?sink_text);
    val wrote: err[printer.Error] = printing.print(?w, ?m, Slice[item.Item]{data: nil, size: 0});
    if (!(sel wrote.err))                     { ret 6; }
    if (!(sel wrote.err.target))              { ret 7; }
    if (!(sel wrote.err.target.unregistered)) { ret 8; }
    ret 0;
}

# a target the table does not hold has no environment either
test text__refuses_a_target_the_table_does_not_hold {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ONE_FUNCTION));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val bad: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, view_of("target \"mtest\"\n"));
    if (sel bad.ok)                          { ret 2; }
    if (!(sel bad.err.reason.target))        { ret 3; }
    if (!(sel bad.err.reason.target.target)) { ret 4; }
    ret 0;
}

# two memory classes of one name are refused
test text__refuses_a_target_that_names_two_memory_classes_alike {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ONE_FUNCTION));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    var twice: [2]Memory = [2]Memory{function.T_PAGE, function.T_PAGE};
    var t:     Target    = synthetic.TARGET;
    t.memories = Slice[Memory]{data: ?twice[0], size: 2};
    val bad: res[reader.Unit, Refusal] = reader.parse_body_in(?a, ?m, ?synthetic.REGISTRY, ?synthetic.ARCH, ?t, view_of("target \"mtest\"\n"));
    if (sel bad.ok)                                        { ret 2; }
    if (!(sel bad.err.reason.target))                      { ret 3; }
    if (!(sel bad.err.reason.target.memory))               { ret 4; }
    if (!str_equals(bad.err.reason.target.memory, "page")) { ret 5; }
    ret 0;
}

fun path_of(buf: *u8, name: str) str {
    val dir: str   = "test/machine/";
    var n:   usize = 0;
    var i:   usize = 0;
    for (i < str_len(dir)) {
        buf[n] = dir[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(name)) {
        buf[n] = name[i];
        n      = n + 1;
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf;
}

fun read_file(a: *allocator.Allocator, name: str, swap_ir: bool) opt[vector.Vector[u8]] {
    var buf:  [256]u8;
    val path: str = path_of(?buf[0], name);
    if (swap_ir) { buf[str_len(path) - 1] = 'l'; }
    val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, path);
    if (sel file.err) { ret opt[vector.Vector[u8]].none{}; }
    ret opt[vector.Vector[u8]].some{file.ok};
}

#[testing]
# print a module's machine functions, read the text back and compare
fun round_trip_text(a: *allocator.Allocator, name: str, m: *Module, given: opt[Given], text: View) u32 {
    var first: res[reader.Unit, Refusal] = read_text(a, m, given, text, false);
    if (sel first.err) {
        var out: io.Writer = filesystem.writer(filesystem.STDERR);
        diag.eprintf("{}:", name);
        ir_reader.describe(?out, first.err);
        diag.eprintln("");
        ret 3;
    }
    var one: reader.Unit = first.ok;
    fin { reader.dnit(?one); }
    var text_out: sink.Sink = sink.init(a);
    fin { sink.dnit(?text_out); }
    var w:     io.Writer          = sink.writer(?text_out);
    val wrote: err[printer.Error] = write_text(?w, m, given, Slice[item.Item]{data: one.items.data, size: one.items.len});
    if (sel wrote.err) { ret 4; }
    var second: res[reader.Unit, Refusal] = read_text(a, m, given, sink.view(?text_out), true);
    if (sel second.err) {
        diag.eprintlnf("{}: printed text refused at {}:{}", name, second.err.line, second.err.column);
        ret 5;
    }
    var two: reader.Unit = second.ok;
    fin { reader.dnit(?two); }
    val same: res[bool, printer.Error] = equal.same(m, Slice[item.Item]{data: one.items.data, size: one.items.len}, m, Slice[item.Item]{data: two.items.data, size: two.items.len});
    if (sel same.err) { ret 6; }
    if (!same.ok) {
        diag.eprintlnf("{}: the functions are not the functions read back", name);
        ret 7;
    }
    ret 0;
}

# print the text of a module's machine functions, read it back and compare
#[testing]
fun round_trip(a: *allocator.Allocator, name: str) u32 {
    val ir: opt[vector.Vector[u8]] = read_file(a, name, true);
    val mt: opt[vector.Vector[u8]] = read_file(a, name, false);
    if (sel ir.none) { ret 1; }
    if (sel mt.none) { ret 1; }
    var made: res[Module, Refusal] = ir_reader.parse_body(a, View{data: ir.some.data, len: ir.some.len});
    if (sel made.err) { ret 2; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    ret round_trip_text(a, name, ?m, opt[Given].none{}, View{data: mt.some.data, len: mt.some.len});
}

val DEMO_IR: str = "target \"mtest\"\n\n!f0 = file \"demo.mach\"\n!l0 = location !f0 3:1\n!l1 = location !f0 4:2\n!s0 = site !l1 \"inner\"\n!t0 = type \"i32\" \"i32\" base signed 32\n!v0 = variable \"x\" !t0 declared !l0\n!v1 = variable \"y\" !t0 declared !l1\n\nglobal @g: i32 linkage global visibility default\n\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%a: i32):\n    ret %a\n}\n\nfunction @h: fun(i32) -> (i32) linkage global visibility default {\n^entry(%a: i32):\n    ret %a\n}\n";

val DEMO_TEXT: str = "target \"mtest\"\n\n; every kind of operand and every part of the metadata record\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    virtual %2: class r\n    virtual %3: memory page\n    slot [0]: size 4 align 4\n    slot [1]: size 8 align 8\n^0:\n    load %0, [0] loc !l0\n    load %1, @g + 8 : abs32\n    load r2, {page: 3}\n    add %1 = %0, %2 loc !l1 site !s0 secret bind [!v0, !v1]\n    load %2, [0] volatile kept declassifies\n    add r2 = r2, r1 volatile\n    wide r0, r1, r3 reads [r1, r2] writes [r0] label 0\n    load %1, partner 0 : abs32\n    pseudo copy %3, %2\n    pseudo spill [1], %3\n    pseudo reload %2, [1]\n    pseudo parallel_copy %0, %1, %1, %0\n    pseudo frame_setup\n    bnz %1, ^2\n    jump ^1\n^1:\n    add %2 = %2, %0\n    bnz %2, ^1\n    jump @h - 4 : pc32\n^2:\n    jump @f : pc32\n}\n\nfunction @h {\n^0:\n    jump ^0\n}\n";

# every kind of operand and metadata of the synthetic set, whose instruction set no registry holds
test text__synthetic_set_prints_and_reads_back_equal {
    var a: allocator.Allocator;
    page.make(?a);
    var made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(DEMO_IR));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val code: u32 = round_trip_text(?a, "synthetic", ?m, opt[Given].some{fixture()}, view_of(DEMO_TEXT));
    if (code != 0) { ret 10 + code::i32; }
    ret 0;
}

# every machine form text file of test/machine, each beside the ir text file of
# the module it is the code of, which `mach test` reaches from the project root
test text__every_machine_text_file_prints_and_reads_back_equal {
    var a: allocator.Allocator;
    page.make(?a);
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(?a, "test/machine");
    if (sel names.err) { ret 1; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirm")) {
            val code: u32 = round_trip(?a, name);
            if (code != 0) { ret 10 + code::i32; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 3; }
    ret 0;
}
