# the text form of the machine form: its grammar, the printer, the parser and
# structural equality
#
# a machine function and its text are interchangeable, as a module and its ir
# text are. selection and allocation tests are machine form text in and text
# out. this is not the assembly listing, which is masc's syntax for the encoded
# bytes and comes after emission: the text shows virtual registers, tied
# operands and the state before allocation, which assembly cannot express.
#
# the text begins with the version of mirl that wrote it and names the target,
# as the ir text form does, and promises no stability across versions. it names
# the module it is the code of: a function and a symbol operand are named by
# the symbols of that module, and a location, site or binding by its entry in
# that module's debug table. the target line must be the module's.
#
# the text holds no name table. a register is spelled by its name, or an alias
# of it, in the register file of the target's instruction set, and an
# instruction by the key of its catalog row, so a register or instruction added
# to masc needs no change here. a class is spelled by its name in the register
# file. a name masc does not hold is refused, naming its line and column. a
# key names one row of the set, so no text depends on the place of a row or a
# class in masc's tables.
#
# grammar
#
# the tokens are those of the ir text form, and the grammar is ebnf as there.
#
#   unit        = version target { item } ;
#   item        = newline | function ;
#   function    = "function" symbol "{" newline { line } "}" newline ;
#   line        = newline | virtual | slot | block | instruction newline ;
#   virtual     = "virtual" local ":" class newline ;
#   class       = "class" name | "memory" name ;
#   slot        = "slot" "[" uint "]" ":" "size" uint "align" uint
#                 [ "addressed" ] newline ;
#   block       = label ":" newline ;
#   instruction = opcode [ operand { "," operand } ] [ "vtype" vtype ]
#                 [ "reads" locations ] [ "writes" locations ]
#                 [ "label" uint ] [ "loc" dref ]
#                 [ "site" dref ]
#                 [ "volatile" ] [ "kept" ] [ "secret" ]
#                 [ "bind" "[" [ dref { "," dref } ] "]" ] [ "declassifies" ] ;
#   locations   = "[" [ register { "," register } ] "]" ;
#   opcode      = name | "pseudo" word | "loop" word ;
#   operand     = register | register "=" register | immediate | slot
#               | symbol | label | partner ;
#   register    = local | name | cell ;
#   cell        = "{" name ":" uint "}" ;
#   immediate   = [ "-" ] uint ;
#   slot        = "[" uint "]" ;
#   symbol      = symbol [ ( "+" | "-" ) uint ] ":" word ;
#   partner     = "partner" uint ":" word ;
#   vtype       = word [ "," word [ "," word [ "," word ] ] ] ;
#
# a class is a class row of the target's register file by its name, or a
# memory-backed class by the name the row of its set states for it. a
# virtual register prints as `%` and its number, a block as `^` and its number
# and a slot by its number, and a reader takes any name for a virtual register
# or block and gives it to the one it declares or labels. a name is a word, or
# quoted when it is a word the grammar reads as a keyword: function, virtual,
# slot, class, memory, size, align, addressed, pseudo, loop, loc, site, volatile,
# secret, bind, kept, declassifies, reads, writes, label and partner, the
# list item.KEYWORDS holds, and the name the set's configuration hooks give
# its configuration state. that name states the state an instruction runs
# under, in the spelling the set's hooks read and print, as risc-v's
# `vtype e32, m2, ta, ma`. an instruction states one exactly when masc says
# its row's groups turn on one. `reads` and `writes` list the physical registers or
# cells an instruction reads or writes beyond its operands and its row, as a
# call reads its arguments' registers. `label n` marks an instruction, and
# `partner n : kind` is the address of the instruction marked n under a
# relocation kind, as a pc-relative low part names its high part. `a = b` is
# a tied operand,
# a written and b read, which allocation gives one location. a cell is a
# location of a memory-backed class. a symbol operand ends with the name of its
# relocation kind in mink's vocabulary. a pseudo-instruction is spelled by the
# name of its row in the pseudo table, and a loop by its name among the
# loops mirl carries for the set, a parameter an immediate. a function names the symbol it is the
# code of, its virtual registers and slots in order, and its blocks, the first
# the entry.

use mirl.machine.text.equal;
use mirl.machine.text.item;
use reader:   mirl.machine.text.parse;
use printing: mirl.machine.text.print;
use mirl.machine.text.refusal;
use mirl.machine.text.resolve;

fwd item.Item;
fwd resolve.Failure;
fwd refusal.Refusal;
fwd refusal.Reason;
fwd refusal.describe;

fwd printing.Error;

fwd printing.print;

fwd reader.Unit;
fwd reader.parse;
fwd reader.parse_body;
fwd reader.dnit;

fwd equal.same;
fwd equal.same_function;
