# the text form of the machine form, which `emit -e machine` writes
#
# it shows a module's machine functions as selection and allocation leave
# them: virtual registers, tied operands, frame slots and the state before
# encoding, which assembly cannot express. this is not the assembly listing,
# which is masc's syntax for the encoded bytes and comes after emission. it is
# written only, and no reader takes it back.
#
# the text begins with the version, target and language statements of the ir
# text form and promises no stability across versions. it names the module it
# is the code of: a function and a symbol by the module's symbol names, and a
# location, site or binding by its entry in that module's debug table, as the
# ir text names them.
#
# the text holds no name table. a physical register is spelled by its name in
# the register file of the target's instruction set, an instruction by the key
# of its catalog row and a class by its name in the register file, so a
# register or instruction added to masc needs no change here. what the
# machine form names itself takes `%`, which no row's name starts with: a
# virtual register `%` and its number, a frame slot `%s` and its number and a
# block `%b` and its number. a name that is one of the grammar's words, the
# list item.WORDS holds, is quoted.
#
# grammar
#
#   unit        = version target [ language ] { function } ;
#   function    = [ "#[placed(" places ")]" ] "fun" name "{" { virtual }
#                 { slot } { block } "}" ;
#   virtual     = "var" "%" uint ":" ( name | "memory" "(" name ")" ) ";" ;
#   slot        = "slot" "%s" uint ":" "size" uint [ "per" uint "scale" uint ]
#                 "," "align" uint [ "," area ] [ "," "addressed" ]
#                 [ "," "secret" ] ";" ;
#   area        = ( "incoming" | "outgoing" ) uint [ "per" uint ] ;
#   block       = "%b" uint ":" { instruction } ;
#   instruction = { decorator } opcode "(" [ operand { "," operand } ] ")"
#                 [ state ] [ "reads" locations ] [ "writes" locations ]
#                 [ "places" places ] [ "label" uint ]
#                 [ "at" ident ] [ "in" ident ] [ "holds" "[" [ ident { "," ident } ] "]" ] ";" ;
#   decorator   = "#[volatile]" | "#[kept]" | "#[bounded]" | "#[checked]"
#               | "#[public]" | "#[secret]" | "#[declassifies]" ;
#   opcode      = name | "pseudo" name | "loop" name | "asm" string ;
#   locations   = "[" [ physical { "," physical } ] "]" ;
#   operand     = register | register "=" register | [ "-" ] uint | "%s" uint
#               | reference | "%b" uint | "partner" "(" uint "," name ")"
#               | address | "list" "(" register "," uint ")"
#               | "bytes" "(" [ uint { "," uint } ] ")" | "%" uint "[" uint "]" ;
#   register    = "%" uint | physical ;
#   physical    = name | "{" name ":" uint "}" ;
#   reference   = name "(" "?" name [ ( "+" | "-" ) uint ] ")" ;
#   address     = "[" field { "," field } "]" ;
#   field       = ( "base" | "index" | "segment" ) ":" register
#               | ( "scale" | "mode" | "extend" | "broadcast" ) ":" uint
#               | "disp" ":" [ "-" ] uint | "symbol" ":" reference ;
#   places      = "[" [ place { "," place } ] "]" ;
#   state       = name words ;
#
# a place is the ir text's, with its register by name. a class is a class row
# of the register file by its name, or a memory-backed class by the name the
# row of its set states for it, and a cell `{class: n}` is a location of one.
# `a = b` is a tied operand, a written and b read, which allocation gives one
# location. a reference is a symbol's address under a relocation kind of
# mink's vocabulary, the kind written as applied to it, and `partner(n, kind)`
# is the address of the instruction marked `label n` under the kind, as a
# pc-relative low part names its high part. an address writes each field that
# is not its zero, and its displacement where every field is its zero.
# `bytes` are literal bytes. `%n[k]` is member k of a virtual register of a
# tuple class. a pseudo-instruction is spelled by the name of its row in the
# pseudo table, a loop by its name among the loops mirl carries for the set,
# and an inline assembly block by its text. `reads` and `writes` list the
# physical registers or cells an instruction touches beyond its operands and
# its row, as a call reads its arguments' registers. a state is the
# configuration state an instruction runs under, after the name the set's
# hooks give it and in the spelling they write, as risc-v's
# `vtype e32, m2, ta, ma`, written exactly when masc says the row's groups turn
# one on. a function's virtual registers and slots are listed in order, then
# its blocks, the first the entry.

use mirl.machine.text.item;
use printing: mirl.machine.text.print;
use mirl.machine.text.resolve;

fwd item.Item;
fwd resolve.Failure;

fwd printing.Error;

fwd printing.print;
