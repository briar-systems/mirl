# the frame code a target supplies
#
# the frame decides every move of the stack and frame pointers and every
# access of a slot, and a target supplies the instructions of each, as rows
# of masc's catalog appended through the function's maker. this is the only
# part of the frame that knows an instruction set, as the selection table is
# the only part of selection that does.
#
# a move is made through `make`, which gives the code the first scratch the
# caller offers under which every instruction the move makes stands against
# its row's register constraints. it finds it by making the move into a
# function of its own for each scratch in turn, and makes it for real once
# one stands.
#
# the code states each width it loads and stores a class at as a row of data,
# and the code bound to a selection admits a width only where the selection
# admits its row and the register's storage through the selection takes all
# of it, so a load or store is never a row the selection lacks and never moves
# fewer bytes than asked. every row the code appends goes through `append`,
# which refuses one the selection does not admit.
#
# a register the frame saves by a push is pushed and popped by the row of
# its width in the code's push widths, bound to the selection the same way,
# and the stack pointer is released before the pops by the code's release,
# the one form an unwinder that reads an epilogue by its shape takes.
#
# an offset that scales is formed as the code states for it through
# `scaled`: by instructions that step by the scale's unit themselves, or
# through the register that measures the scale, which is masc's to name on
# the scale's quantity. `make` refuses a move at an offset the code forms
# none of before the code is asked.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.debug.Location;
use mirl.ir.debug.Site;
use mirl.ir.id;
use mirl.ir.metadata.Metadata;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.metadata.UNBOUND;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.constraint;
use mirl.machine.constraint.Breach;
use mirl.machine.frame.record.Offset;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.storage;
use mirl.machine.storage.Storage;
use mirl.machine.vstate;

use masc.core.quantity;
use rf: masc.core.register;
use masc.core.row.Row;
use core_state: masc.core.state;

# where the code appends and what it may use
# ---
# admitted:  the frame code bound to the build's selection
# f:         the function
# block:     the block it appends to
# metadata:  the metadata of the instructions it appends
# stack:     the stack pointer
# scratches: the registers it may overwrite beside its destination, in the
#            order the caller prefers them
# scratch:   the one of them `make` gives the code for a move, none when
#            there are none
pub rec Emit {
    admitted:  *Admitted;
    f:         *Function;
    block:     Block;
    metadata:  Metadata;
    stack:     rf.Id;
    scratches: Slice[rf.Id];
    scratch:   opt[rf.Id];
}

# no scratch register
pub val NO_SCRATCH: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};

# why the code wrote nothing
# ---
# reach:       an offset it cannot add or address without a scratch register, or
#              at all
# scaled:      an offset per unit of a scale it cannot form
# mask:        an alignment it cannot mask to
# access:      a register of a class or size it has no load or store for
#              that the selection admits
# unadmitted:  a row the selection does not admit
# made:        the function's maker refused an instruction
# constrained: an instruction of the move does not stand against its row's
#              register constraints under any scratch offered, the breach
#              under the first
# unpaired:    two registers the code moves in no one instruction, by the
#              lower of them, which the frame then moves one at a time
# unprobed:    a move through a probe routine the code makes none of
# unreserved:  a register no emergency slot of its kind is left to save in
# unpushed:    a register the code pushes or pops by no row the selection
#              admits at the size asked, or the stack pointer of a release
#              where the code pushes nothing
pub tag Refusal: u8 {
    reach:       Offset;
    scaled:      Offset;
    mask:        u64;
    access:      rf.Id;
    unadmitted:  *Row;
    made:        function.Error;
    constrained: Breach;
    unpaired:    rf.Id;
    unprobed;
    unreserved: rf.Id;
    unleft;
    unpushed: rf.Id;
}

# one width the code loads and stores a register of a class at
# ---
# class:  the class, by the handle masc publishes for it
# bits:   the bits it moves, scaled as masc states widths
# load:   the row loading them into a register
# store:  the row storing them from a register
# offset: whether its rows take an offset beside the base register, else the
#         base register alone holds the address
# most:   the most scratches one load or store at it takes, at any offset. a
#         width of 0 never goes through a scratch, so nothing tries one
pub rec Width {
    class:  *rf.Class;
    bits:   quantity.Scaled;
    load:   *Row;
    store:  *Row;
    offset: bool;
    most:   u32;
}

# widths as a pointer to static widths and a count
pub rec Widths {
    at:  *Width;
    len: u32;
}

# how the code forms the part of an offset that scales
# ---
# none:     it forms none, so a move at such an offset is refused `scaled`
# native:   by instructions that add or address a multiple of the scale's unit
#           themselves, as sve's addvl and addpl and its mul vl addressing,
#           and sme's addsvl under the streaming scale
# measured: by reading the register that measures the scale's quantity into
#           a register, then multiplying it by the bytes per unit and adding
#           the fixed part, as rvv's vlenb
pub tag Steps: u8 {
    none;
    native;
    measured;
}

# the instructions of a pair of registers of one width stored at, or loaded
# from, adjacent addresses, as aarch64's stp and ldp: the lower register at
# the base plus the offset and the upper one the width's bytes above it,
# stored when the last argument says so and loaded otherwise
pub def Pair: fun(*Emit, *Width, rf.Id, rf.Id, rf.Id, Offset, bool) err[Refusal];

# how the code moves two registers at once
# ---
# none: it moves every register alone
# code: by its pair code, which refuses `unpaired` for a pair it has no row for
pub tag Pairs: u8 {
    none;
    code: Pair;
}

# one width the code pushes and pops a register of a class at
# ---
# class: the class, by the handle masc publishes for it
# bits:  the bits it moves, as many as the stack pointer moves by
# push:  the row storing them just below the stack pointer and moving it
#        down past them
# pop:   the row loading them at the stack pointer and moving it up past
#        them
pub rec Push {
    class: *rf.Class;
    bits:  quantity.Scaled;
    push:  *Row;
    pop:   *Row;
}

# how the code pushes and pops the registers a frame saves by a push
# ---
# at:      its push widths
# len:     their count
# stacked: a register pushed by its width's row, when the last argument says
#          so, or popped
# release: the stack pointer moved up by fixed bytes in the form an unwinder
#          that reads an epilogue by its shape takes for the release before
#          the pops, as windows x64's `add rsp, n`
pub rec Pushing {
    at:      *Push;
    len:     u32;
    stacked: fun(*Emit, *Push, rf.Id, bool) err[Refusal];
    release: fun(*Emit, rf.Id, Offset) err[Refusal];
}

# how the code saves a register by a push
# ---
# none: it pushes none, so a frame that pushes a save is refused `unpushed`
# rows: by its push widths
pub tag Pushes: u8 {
    none;
    rows: Pushing;
}

# a target's frame code, each entry appending the instructions of one move
# ---
# add:    dest is src plus an offset, dest the scratch it may use when it is
#         not src
# mask:   dest is src rounded down to a multiple of a power of two
# sub:    dest is a minus b
# store:  the bytes of a register stored at a base register plus an offset,
#         by the width chosen for its class and size
# load:   a register loaded with the bytes at a base register plus an offset,
#         by the width chosen for its class and size
# widths: every width it loads and stores a class at
# scaled: how it forms an offset that scales, by its scale and bytes
# pairs:  how it moves two registers at once, none for a set that never does
# probe:  how it moves the stack pointer down past pages through the
#         convention's probe routine
# pushes: how it pushes and pops a save, none for a set that never does
# adding: the most scratches one add takes, at any offset
# leave:  how a return leaves through the routine a global holds, in place of
#         returning
pub rec Code {
    add:    fun(*Emit, rf.Id, rf.Id, Offset) err[Refusal];
    mask:   fun(*Emit, rf.Id, rf.Id, u64) err[Refusal];
    sub:    fun(*Emit, rf.Id, rf.Id, rf.Id) err[Refusal];
    store:  fun(*Emit, *Width, rf.Id, rf.Id, Offset) err[Refusal];
    load:   fun(*Emit, *Width, rf.Id, rf.Id, Offset) err[Refusal];
    widths: Widths;
    scaled: fun(Offset) Steps;
    pairs:  Pairs;
    probe:  Probes;
    pushes: Pushes;
    adding: u32;
    leave:  Leaves;
}

# how the code leaves a function through the routine a global holds, past its
# epilogue, as an arm64ec entry thunk leaves through __os_arm64x_dispatch_ret
# ---
# none:    it leaves through none, so a frame that needs it is refused
# through: the routine's address loaded from the global and jumped to, the
#          return registers, the link register and the stack as they are
pub tag Leaves: u8 {
    none;
    through: fun(*Emit, id.Symbol) err[Refusal];
}

# a return made through the routine a global holds
# ---
# routine: the global's symbol in the module
pub rec Leave {
    routine: id.Symbol;
}

# how the code moves the stack pointer down by a fixed amount past pages,
# calling the convention's probe routine to touch each in order
# ---
# none:   it calls none, so a frame that needs it is refused when laid out
# called: the stack pointer moved down by the bytes through a call of the
#         routine, as windows x64's `mov eax, n; call __chkstk; sub rsp, rax`
pub tag Probes: u8 {
    none;
    called: fun(*Emit, rf.Id, u64, id.Symbol) err[Refusal];
}

# the stack pointer moved down by some bytes through a probe routine
# ---
# stack:  the stack pointer
# bytes:  the bytes it moves down by
# helper: the routine's symbol in the module
pub rec Probe {
    stack:  rf.Id;
    bytes:  u64;
    helper: id.Symbol;
}

# an admitted width, the bits it moves through the selection and its place
# in the code's widths
rec Entry {
    key:   u32;
    bits:  Storage;
    width: *Width;
    at:    u32;
}

# a target's frame code bound to a context
# ---
# code:    the frame code
# context: the build's context, which admits each row
# loads:   the widths whose load the selection admits, by the class's row
#          in the file, each list by the bits it moves
# stores:  the widths whose store the selection admits, the same way
# most:    the most scratches one add, load or store of the code takes, the
#          emergency slots a frame reserves at most for scavenging them
pub rec Admitted {
    code:    *Code;
    context: *core_state.Context;
    loads:   Lists[Entry];
    stores:  Lists[Entry];
    most:    u32;
}

# a width the binding refuses
# ---
# store: whether it was refused among the stores
# at:    its place in the code's widths
pub rec Defect {
    store: bool;
    at:    u32;
}

# why frame code was not bound to a selection
# ---
# alloc:   the allocator refused storage
# foreign: a width naming a class of no row of the selection's file, by its place
# twice:   a second admitted load or store of one class and one storage
pub tag Error: u8 {
    alloc:   allocator.Error;
    foreign: u32;
    twice:   Defect;
}

fun by_key(a: *Entry, b: *Entry) i64 {
    if (a.key < b.key) { ret -1; }
    if (a.key > b.key) { ret 1; }
    ret storage.order(a.bits, b.bits);
}

# the widths whose load or store the selection admits, grouped by class
fun grouped(a: *allocator.Allocator, c: *Code, ctx: *core_state.Context, store: bool) res[Lists[Entry], Error] {
    val regs: *rf.Available        = ctx.view;
    var all:  vector.Vector[Entry] = vector.init[Entry](a);
    fin { vector.dnit[Entry](?all); }
    var i: u32 = 0;
    for (i < c.widths.len) {
        val w: *Width     = ?c.widths.at[i];
        val k: opt[Class] = class.handled(regs.file, w.class);
        if (sel k.none) { ret res[Lists[Entry], Error].err{Error.foreign{i}}; }
        val held: Class = k.some;
        if (!(sel held.hardware)) { ret res[Lists[Entry], Error].err{Error.foreign{i}}; }
        var row: *Row = w.load;
        if (store) { row = w.store; }
        if (core_state.admits(ctx, row.requires)) {
            val pushed: res[usize, allocator.Error] = vector.push[Entry](?all, Entry{key: held.hardware.index::u32, bits: storage.through(regs, w.bits), width: w, at: i});
            if (sel pushed.err) { ret res[Lists[Entry], Error].err{Error.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    sort.sort_by[Entry](all.data, all.len, by_key);
    var keys: vector.Vector[u32] = vector.init[u32](a);
    fin { vector.dnit[u32](?keys); }
    var n: usize = 0;
    for (n < all.len) {
        if (n > 0 && by_key(?all.data[n - 1], ?all.data[n]) == 0) { ret res[Lists[Entry], Error].err{Error.twice{Defect{store: store, at: all.data[n].at}}}; }
        val pushed: res[usize, allocator.Error] = vector.push[u32](?keys, all.data[n].key);
        if (sel pushed.err) { ret res[Lists[Entry], Error].err{Error.alloc{pushed.err}}; }
        n = n + 1;
    }
    val made: res[Lists[Entry], allocator.Error] = graph.lists[Entry](a, regs.file.class_count, Slice[u32]{data: keys.data, size: keys.len}, Slice[Entry]{data: all.data, size: all.len});
    if (sel made.err) { ret res[Lists[Entry], Error].err{Error.alloc{made.err}}; }
    ret res[Lists[Entry], Error].ok{made.ok};
}

# the most scratches any add, load or store the code states takes
fun most_of(c: *Code) u32 {
    var most: u32 = c.adding;
    var i:    u32 = 0;
    for (i < c.widths.len) {
        if (c.widths.at[i].most > most) { most = c.widths.at[i].most; }
        i = i + 1;
    }
    ret most;
}

# bind a target's frame code to a selection
# ---
# a:   the allocator the binding takes
# c:   the frame code
# ctx: the build's context, which admits each row, and whose view fixes the
#      bits each width moves
# ret: the binding, or why it was refused
pub fun admit(a: *allocator.Allocator, c: *Code, ctx: *core_state.Context) res[Admitted, Error] {
    val loads: res[Lists[Entry], Error] = grouped(a, c, ctx, false);
    if (sel loads.err) { ret res[Admitted, Error].err{loads.err}; }
    var l:      Lists[Entry]             = loads.ok;
    val stores: res[Lists[Entry], Error] = grouped(a, c, ctx, true);
    if (sel stores.err) {
        graph.release[Entry](?l);
        ret res[Admitted, Error].err{stores.err};
    }
    ret res[Admitted, Error].ok{Admitted{code: c, context: ctx, loads: l, stores: stores.ok, most: most_of(c)}};
}

# give back a binding's storage
pub fun dnit(x: *Admitted) err[allocator.Error] {
    var failed: err[allocator.Error] = graph.release[Entry](?x.loads);
    keep(?failed, graph.release[Entry](?x.stores));
    ret failed;
}

# the bits of a size in bytes, folded through a selection
pub fun bits_of(regs: *rf.Available, size: Offset) Storage {
    ret storage.fold(regs, Storage{fixed: size.fixed::u64 * 8, per: size.per::u64 * 8, scale: size.scale});
}

# the admitted widths of a register's class, loads or stores, empty for a
# register of no row of the file
fun listed(x: *Admitted, reg: rf.Id, store: bool) Slice[Entry] {
    val k: u16 = rf.class_of(reg);
    if (k::u32 >= x.context.view.file.class_count) { ret Slice[Entry]{data: nil, size: 0}; }
    if (store)                                     { ret graph.list[Entry](?x.stores, k::u32); }
    ret graph.list[Entry](?x.loads, k::u32);
}

# whether a register's storage through the selection takes all of some bits
fun takes(x: *Admitted, reg: rf.Id, bits: Storage) bool {
    val row: opt[*rf.Register] = rf.row_of(x.context.view.file, reg);
    if (sel row.none) { ret false; }
    val s: opt[Storage] = storage.of_register(x.context.view, row.some);
    if (sel s.none) { ret false; }
    ret storage.covers(s.some, bits);
}

# the entry of a list moving exactly some bits, by binary search
fun exact(list: Slice[Entry], bits: Storage) opt[*Width] {
    var lo: usize = 0;
    var hi: usize = list.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (storage.order(list.data[mid].bits, bits) < 0) { lo = mid + 1; }
        or                                                { hi = mid; }
    }
    if (lo < list.size && storage.order(list.data[lo].bits, bits) == 0) { ret opt[*Width].some{list.data[lo].width}; }
    ret opt[*Width].none{};
}

# the admitted width moving exactly a size into or out of a register, none
# when the code states none the selection admits or the register's storage
# does not take all of it
# ---
# x:     the binding
# reg:   the register
# size:  the bytes moved
# store: whether the width stores the register, else loads it
pub fun width_of(x: *Admitted, reg: rf.Id, size: Offset, store: bool) opt[*Width] {
    val bits: Storage = bits_of(x.context.view, size);
    if (!takes(x, reg, bits)) { ret opt[*Width].none{}; }
    ret exact(listed(x, reg, store), bits);
}

# the most scratches a load or store takes, by the width it moves at, 0 for
# one of no width
fun width_most(x: *Admitted, a: Access, store: bool) u32 {
    val w: opt[*Width] = width_of(x, a.register, a.size, store);
    if (sel w.none) { ret 0; }
    ret w.some.most;
}

# the most scratches a move of an add, load or store takes, as the code states
# for that move, and the most of any for another
# ---
# x: the bound frame code
# s: the move
pub fun takes_at_most(x: *Admitted, s: Step) u32 {
    if (sel s.add)   { ret x.code.adding; }
    or (sel s.store) { ret width_most(x, s.store, true); }
    or (sel s.load)  { ret width_most(x, s.load, false); }
    ret x.most;
}

# whether a part of n bytes is aligned at an address of a power of two
# alignment: the widest power of two n is a multiple of is at most it
fun aligned(n: u64, align: u64) bool {
    var p: u64 = 1;
    for (n % (p * 2) == 0) {
        p = p * 2;
    }
    ret p <= align;
}

# the most fixed bytes, at most `room`, that the code both loads into and
# stores from a register at an address of a power of two alignment, 0 when
# none fits
# ---
# x:     the binding
# reg:   the register
# room:  the bytes left to move
# align: the alignment the address has
pub fun widest(x: *Admitted, reg: rf.Id, room: u64, align: u64) u64 {
    val list: Slice[Entry] = listed(x, reg, false);
    var most: u64          = 0;
    var i:    usize        = 0;
    for (i < list.size) {
        val b: Storage = list.data[i].bits;
        if (b.per == 0 && b.fixed % 8 == 0 && b.fixed > 0) {
            val n: u64 = b.fixed / 8;
            if (n <= room && n > most && aligned(n, align)) {
                val back: opt[*Width] = width_of(x, reg, Offset{fixed: n::i64, per: 0, scale: 0}, true);
                if (sel back.some) { most = n; }
            }
        }
        i = i + 1;
    }
    ret most;
}

# the push width the code pushes and pops a register at a size by, none when
# it states none the selection admits both rows of or the register's storage
# does not take all of it
# ---
# x:    the binding
# reg:  the register
# size: the bytes pushed
pub fun push_of(x: *Admitted, reg: rf.Id, size: Offset) opt[*Push] {
    val pushes: Pushes = x.code.pushes;
    if (!(sel pushes.rows)) { ret opt[*Push].none{}; }
    val regs: *rf.Available = x.context.view;
    val bits: Storage       = bits_of(regs, size);
    if (!takes(x, reg, bits)) { ret opt[*Push].none{}; }
    var i: u32 = 0;
    for (i < pushes.rows.len) {
        val p: *Push      = ?pushes.rows.at[i];
        val k: opt[Class] = class.handled(regs.file, p.class);
        if (sel k.some) {
            val held: Class = k.some;
            if (sel held.hardware) {
                if (held.hardware.index::u32 == rf.class_of(reg)::u32 && storage.order(storage.through(regs, p.bits), bits) == 0) {
                    if (core_state.admits(x.context, p.push.requires) && core_state.admits(x.context, p.pop.requires)) { ret opt[*Push].some{p}; }
                }
            }
        }
        i = i + 1;
    }
    ret opt[*Push].none{};
}

# append one row, refused when the selection does not admit it
# ---
# e:   where it appends
# row: the row
# ops: its operands
# ret: ok, or why nothing was appended
pub fun append(e: *Emit, row: *Row, ops: Slice[Operand]) err[Refusal] {
    if (!core_state.admits(e.admitted.context, row.requires)) { ret err[Refusal].err{Refusal.unadmitted{row}}; }
    val made: res[Instruction, function.Error] = function.append(e.f, e.block, Opcode.row{row}, ops, e.metadata, false, vstate.NONE);
    if (sel made.err) { ret err[Refusal].err{Refusal.made{made.err}}; }
    ret err[Refusal].ok{};
}

# dest is src plus an offset
pub rec Add {
    dest: rf.Id;
    src:  rf.Id;
    by:   Offset;
}

# dest is src rounded down to a multiple of a power of two
pub rec Mask {
    dest:  rf.Id;
    src:   rf.Id;
    align: u64;
}

# dest is a minus b
pub rec Sub {
    dest: rf.Id;
    a:    rf.Id;
    b:    rf.Id;
}

# the bytes of a register stored at, or loaded from, a base register plus an offset
pub rec Access {
    register: rf.Id;
    base:     rf.Id;
    at:       Offset;
    size:     Offset;
}

# two registers of one size moved at adjacent addresses, the lower at the
# base plus the offset
pub rec Paired {
    lower: rf.Id;
    upper: rf.Id;
    base:  rf.Id;
    at:    Offset;
    size:  Offset;
}

# a register of a size pushed below the stack pointer, or popped at it
pub rec Stacked {
    register: rf.Id;
    size:     Offset;
}

# the stack pointer moved up by some bytes in an epilogue, before its pops
pub rec Release {
    stack: rf.Id;
    by:    Offset;
}

# one move of the frame code
pub tag Step: u8 {
    add:        Add;
    mask:       Mask;
    sub:        Sub;
    store:      Access;
    load:       Access;
    store_pair: Paired;
    load_pair:  Paired;
    probe:      Probe;
    leave:      Leave;
    push:       Stacked;
    pop:        Stacked;
    release:    Release;
}

# a load or store by the width admitted for its register and size
fun access(e: *Emit, a: Access, store: bool) err[Refusal] {
    val w: opt[*Width] = width_of(e.admitted, a.register, a.size, store);
    if (sel w.none) { ret err[Refusal].err{Refusal.access{a.register}}; }
    if (store)      { ret e.admitted.code.store(e, w.some, a.register, a.base, a.at); }
    ret e.admitted.code.load(e, w.some, a.register, a.base, a.at);
}

# a pair by the width admitted for both its registers and their size
fun pair(e: *Emit, a: Paired, store: bool) err[Refusal] {
    val pairs: Pairs = e.admitted.code.pairs;
    if (!(sel pairs.code)) { ret err[Refusal].err{Refusal.unpaired{a.lower}}; }
    val w: opt[*Width] = width_of(e.admitted, a.lower, a.size, store);
    val v: opt[*Width] = width_of(e.admitted, a.upper, a.size, store);
    if (sel w.none)       { ret err[Refusal].err{Refusal.access{a.lower}}; }
    if (sel v.none)       { ret err[Refusal].err{Refusal.access{a.upper}}; }
    if (w.some != v.some) { ret err[Refusal].err{Refusal.unpaired{a.lower}}; }
    ret pairs.code(e, w.some, a.lower, a.upper, a.base, a.at, store);
}

# a push or pop by the push width admitted for its register and size
fun stack(e: *Emit, a: Stacked, push: bool) err[Refusal] {
    val pushes: Pushes = e.admitted.code.pushes;
    if (!(sel pushes.rows)) { ret err[Refusal].err{Refusal.unpushed{a.register}}; }
    val p: opt[*Push] = push_of(e.admitted, a.register, a.size);
    if (sel p.none) { ret err[Refusal].err{Refusal.unpushed{a.register}}; }
    ret pushes.rows.stacked(e, p.some, a.register, push);
}

# the stack pointer's release by the code's own form
fun release(e: *Emit, a: Release) err[Refusal] {
    val pushes: Pushes = e.admitted.code.pushes;
    if (!(sel pushes.rows)) { ret err[Refusal].err{Refusal.unpushed{a.stack}}; }
    ret pushes.rows.release(e, a.stack, a.by);
}

# the offset a move adds or addresses at, none for one at no offset
fun offset_of(s: Step) opt[Offset] {
    if (sel s.add)        { ret opt[Offset].some{s.add.by}; }
    or (sel s.store)      { ret opt[Offset].some{s.store.at}; }
    or (sel s.load)       { ret opt[Offset].some{s.load.at}; }
    or (sel s.store_pair) { ret opt[Offset].some{s.store_pair.at}; }
    or (sel s.load_pair)  { ret opt[Offset].some{s.load_pair.at}; }
    or (sel s.release)    { ret opt[Offset].some{s.release.by}; }
    ret opt[Offset].none{};
}

# whether the code forms the offset of a move, every fixed one and a scaled
# one it states steps for
fun formed(c: *Code, s: Step) err[Refusal] {
    val o: opt[Offset] = offset_of(s);
    if (sel o.none) { ret err[Refusal].ok{}; }
    val at: Offset = o.some;
    if (at.per == 0) { ret err[Refusal].ok{}; }
    val steps: Steps = c.scaled(at);
    if (sel steps.none) { ret err[Refusal].err{Refusal.scaled{at}}; }
    ret err[Refusal].ok{};
}

fun run(e: *Emit, s: Step) err[Refusal] {
    val c: *Code = e.admitted.code;
    if (sel s.add)        { ret c.add(e, s.add.dest, s.add.src, s.add.by); }
    or (sel s.mask)       { ret c.mask(e, s.mask.dest, s.mask.src, s.mask.align); }
    or (sel s.sub)        { ret c.sub(e, s.sub.dest, s.sub.a, s.sub.b); }
    or (sel s.store)      { ret access(e, s.store, true); }
    or (sel s.load)       { ret access(e, s.load, false); }
    or (sel s.store_pair) { ret pair(e, s.store_pair, true); }
    or (sel s.load_pair)  { ret pair(e, s.load_pair, false); }
    or (sel s.leave) {
        val l: Leaves = c.leave;
        if (!(sel l.through)) { ret err[Refusal].err{Refusal.unleft{}}; }
        ret l.through(e, s.leave.routine);
    }
    or (sel s.push)    { ret stack(e, s.push, true); }
    or (sel s.pop)     { ret stack(e, s.pop, false); }
    or (sel s.release) { ret release(e, s.release); }
    val p: Probes = c.probe;
    if (!(sel p.called)) { ret err[Refusal].err{Refusal.unprobed{}}; }
    ret p.called(e, s.probe.stack, s.probe.bytes, s.probe.helper);
}

# the first breach of an instruction a move makes under the emit's scratch,
# made into a function of its own
fun trial(e: *Emit, s: Step) res[opt[Breach], Refusal] {
    var probe: Function = function.init(e.f.a, e.f.set, true);
    fin { function.dnit(?probe); }
    val b: res[Block, function.Error] = function.block(?probe);
    if (sel b.err) { ret res[opt[Breach], Refusal].err{Refusal.made{b.err}}; }
    var pe:   Emit         = Emit{admitted: e.admitted, f: ?probe, block: b.ok, metadata: e.metadata, stack: e.stack, scratches: e.scratches, scratch: e.scratch};
    val done: err[Refusal] = run(?pe, s);
    if (sel done.err) { ret res[opt[Breach], Refusal].err{done.err}; }
    var i: usize = 0;
    for (i < probe.instructions.len) {
        val d:   *InstructionData = ?probe.instructions.data[i];
        val got: opt[Breach]      = constraint.stands(?probe, e.admitted.context, d);
        if (sel got.some) { ret res[opt[Breach], Refusal].ok{got}; }
        i = i + 1;
    }
    ret res[opt[Breach], Refusal].ok{opt[Breach].none{}};
}

# whether the frame code makes a move with no scratch register, every
# instruction of it standing, tried in a function of its own
# ---
# x:     the bound frame code
# f:     a function whose allocator and set the trial takes
# stack: the stack pointer
# s:     the move
pub fun bare(x: *Admitted, f: *Function, stack: rf.Id, s: Step) bool {
    val stepped: err[Refusal] = formed(x.code, s);
    if (sel stepped.err) { ret false; }
    val md:    Metadata                  = Metadata{location: opt[Location].none{}, site: opt[Site].none{}, flags: NO_FLAGS, secret: false, bindings: UNBOUND};
    var e:     Emit                      = Emit{admitted: x, f: f, block: Block{index: 0}, metadata: md, stack: stack, scratches: NO_SCRATCH, scratch: opt[rf.Id].none{}};
    val tried: res[opt[Breach], Refusal] = trial(?e, s);
    if (sel tried.err) { ret false; }
    ret sel tried.ok.none;
}

# make one move of a target's frame code under the first scratch the emit
# offers that every instruction of the move stands under
# ---
# e:   where it appends, with the bound frame code and the scratches it is
#      offered
# s:   the move
# ret: ok, or why the code made nothing
pub fun make(e: *Emit, s: Step) err[Refusal] {
    val stepped: err[Refusal] = formed(e.admitted.code, s);
    if (sel stepped.err) { ret stepped; }
    var n: usize = e.scratches.size;
    if (n == 0) { n = 1; }
    var first: Breach;
    var i:     usize = 0;
    for (i < n) {
        e.scratch = opt[rf.Id].none{};
        if (e.scratches.size > 0) { e.scratch = opt[rf.Id].some{e.scratches.data[i]}; }
        val tried: res[opt[Breach], Refusal] = trial(e, s);
        if (sel tried.err) { ret err[Refusal].err{tried.err}; }
        val got: opt[Breach] = tried.ok;
        if (sel got.some) {
            if (i == 0) { first = got.some; }
        }
        or { ret run(e, s); }
        i = i + 1;
    }
    ret err[Refusal].err{Refusal.constrained{first}};
}
