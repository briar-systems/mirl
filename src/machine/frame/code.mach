# the frame code a target supplies
#
# the frame decides every move of the stack and frame pointers and every
# access of a slot, and a target supplies the instructions of each, as rows
# of masc's catalog appended through the function's maker. this is the only
# part of the frame that knows an instruction set, as the selection table is
# the only part of selection that does.

use std.types.error.err;
use std.types.option.opt;

use mirl.ir.metadata.Metadata;
use mirl.machine.frame.record.Offset;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.operand.Block;

use rf: masc.core.register;

# where the code appends and what it may use
# ---
# f:        the function
# block:    the block it appends to
# metadata: the metadata of the instructions it appends
# stack:    the stack pointer
# scratch:  a register it may overwrite beside its destination, which the
#           frame gives in the prologue and epilogues and nowhere else
pub rec Emit {
    f:        *Function;
    block:    Block;
    metadata: Metadata;
    stack:    rf.Id;
    scratch:  opt[rf.Id];
}

# why the code wrote nothing
# ---
# reach:  an offset it cannot add or address without a scratch register, or
#         at all
# scaled: an offset per unit of a scale it cannot form
# mask:   an alignment it cannot mask to
# access: a register of a class or size it has no load or store for
# made:   the function's maker refused an instruction
pub tag Refusal: u8 {
    reach:  Offset;
    scaled: Offset;
    mask:   u64;
    access: rf.Id;
    made:   function.Error;
}

# a target's frame code, each entry appending the instructions of one move
# ---
# add:   dest is src plus an offset, dest the scratch it may use when it is
#        not src
# mask:  dest is src rounded down to a multiple of a power of two
# sub:   dest is a minus b
# store: the bytes of a register stored at a base register plus an offset
# load:  a register loaded with the bytes at a base register plus an offset
pub rec Code {
    add:   fun(*Emit, rf.Id, rf.Id, Offset) err[Refusal];
    mask:  fun(*Emit, rf.Id, rf.Id, u64) err[Refusal];
    sub:   fun(*Emit, rf.Id, rf.Id, rf.Id) err[Refusal];
    store: fun(*Emit, rf.Id, rf.Id, Offset, Offset) err[Refusal];
    load:  fun(*Emit, rf.Id, rf.Id, Offset, Offset) err[Refusal];
}
