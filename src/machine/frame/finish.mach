# the writing of a laid out frame
#
# the framed function is made anew through the function's maker: the input's
# virtual registers, slots and blocks, then a slot for each saved register.
# the prologue opens the entry block, an epilogue comes before every exit,
# and an exit of a row whose returns leave through a routine is the frame
# code's leave through it in place of the return,
# each dynamic allocation is expanded through the target's frame code, and
# every other instruction is copied. a spill, reload or slot address is
# copied as a copy is, for the lowering of copies to make its store, load or
# add under a scratch that liveness of the framed function shows free. each
# move of
# the stack or frame pointer and each save and restore states its call frame
# rule beside the instruction that makes it true, as mink's frame record with
# each register numbered by masc's dwarf column under the build's context. a
# row whose code no unwinder walks states none, and a row whose encoding
# states the prologue alone marks the prologue's end and states no epilogue's
# rules, unless it states epilogue scopes, as windows' arm64 codes do, and
# then marks where each epilogue begins, its rules and its end before the
# return. the saves the layout marks pushed are pushed first and popped last,
# behind a release of the stack in the code's own form, so an epilogue has
# the shape an unwinder that reads one by its shape takes. every instruction
# copied holds the input's operands in place, so the input is unchanged but for
# its operand storage, which moves to the framed function once it is written.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use ia: mirl.ir.assembly;
use mirl.ir.id;
use IrSymbol: mirl.ir.id.Symbol;
use mirl.ir.metadata.Metadata;
use mirl.machine.class.Physical;
use mirl.machine.frame.code;
use mirl.machine.frame.code.Access;
use mirl.machine.frame.code.Add;
use mirl.machine.frame.code.Admitted;
use mirl.machine.frame.code.Emit;
use mirl.machine.frame.code.Mask;
use mirl.machine.frame.code.Paired;
use mirl.machine.frame.code.Release;
use mirl.machine.frame.code.Stacked;
use mirl.machine.frame.code.Step;
use mirl.machine.frame.code.Sub;
use mirl.machine.frame.lay;
use mirl.machine.frame.lay.Plan;
use mirl.machine.frame.lay.Spot;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Address;
use mirl.machine.frame.record.Fact;
use mirl.machine.frame.record.Framed;
use mirl.machine.frame.record.Layout;
use mirl.machine.frame.record.Offset;
use mirl.machine.frame.record.Place;
use mirl.machine.frame.record.Save;
use mirl.machine.frame.record.Statement;
use mirl.machine.frame.scavenge;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.inline.Inline;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use OperandAddress: mirl.machine.operand.Address;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;
use OperandSymbol: mirl.machine.operand.Symbol;
use mirl.machine.operand.Virtual;
use mirl.machine.pseudo;

use mo:         masc.core.operand;
use rf:         masc.core.register;
use core_state: masc.core.state;
use mink.model.frame;

# why a frame was not written
# ---
# lay:        the layout was refused
# code:       the target's frame code refused a move
# made:       the function's maker refused a virtual register, slot or block
# operand:    a dynamic allocation whose register is not a register of the
#             file, at this instruction
# dropped:    an instruction naming a slot the layout dropped
# moved:      an inline block that moves the stack pointer and names a slot
#             addressed off it, or one at an offset that scales
# rebased:    an inline block that writes the base register and names a slot
#             addressed off it
# unnumbered: a register a call frame rule names that masc's dwarf column
#             does not number under the build's context
# scaled:     a call frame rule at an offset that scales, which mink's frame
#             records state no rule for but by expression bytes
# scavenge:   the emergency slots the frame needs were not counted
pub tag Error: u8 {
    lay:        lay.Error;
    code:       code.Error;
    made:       function.Error;
    operand:    Instruction;
    dropped:    Instruction;
    moved:      Instruction;
    rebased:    Instruction;
    unnumbered: rf.Id;
    scaled:     Offset;
    scavenge:   scavenge.Error;
}

# what the writing of one frame shares
# ---
# closing: whether an epilogue is being written
rec Writer {
    src:     *Function;
    p:       *Plan;
    code:    *Admitted;
    out:     *Framed;
    closing: bool;
}

fun alloc_err(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.code{code.Error.made{function.Error.alloc{e}}}};
}

fun refused(r: err[code.Error]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.code{r.err}}; }
    ret err[Error].ok{};
}

# the origin of every instruction made since `from`
fun origins(w: *Writer, from: usize, origin: u32) err[Error] {
    var i: usize = from;
    for (i < w.out.function.instructions.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.out.origins, origin);
        if (sel res_pushed.err) { ret alloc_err(res_pushed.err); }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun last(w: *Writer) Instruction {
    ret ((w.out.function.instructions.len - 1)::u32);
}

# whether the frame states call frame rules where the writer is: none for a
# frame that states none, and none in an epilogue of a frame that states its
# prologue alone and no epilogue scope
fun stating(w: *Writer) bool {
    ret w.p.unwound && !(w.p.bounded && !w.p.scoped && w.closing);
}

# the fact of a frame that states call frame rules, none for one that does not
fun fact(w: *Writer, at: Instruction, after: bool, stated: Statement) err[Error] {
    if (!stating(w)) { ret err[Error].ok{}; }
    val res_pushed: res[usize, allocator.Error] = vector.push[Fact](?w.out.facts, Fact{at: at, after: after, stated: stated});
    if (sel res_pushed.err) { ret alloc_err(res_pushed.err); }
    ret err[Error].ok{};
}

# a rule after the last instruction, when the move made one
fun after(w: *Writer, from: usize, rule: frame.Rule) err[Error] {
    if (w.out.function.instructions.len == from) { ret err[Error].ok{}; }
    ret fact(w, last(w), true, Statement.rule{rule});
}

# a register's number in mink's frame records, masc's dwarf number for it
fun numbered(w: *Writer, reg: rf.Id) res[u16, Error] {
    val ctx:              *core_state.Context = w.code.context;
    val opt_debug_number: opt[u32]            = core_state.debug_number(ctx.view.file, reg, rf.DWARF, ctx);
    if (sel opt_debug_number.none) { ret res[u16, Error].err{Error.unnumbered{reg}}; }
    val got: u32 = opt_debug_number.some;
    if (got > 0xffff) { ret res[u16, Error].err{Error.unnumbered{reg}}; }
    ret res[u16, Error].ok{got::u16};
}

# a register and a fixed offset as mink's frame records state them
fun at_register(w: *Writer, reg: rf.Id, o: Offset) res[frame.Offset, Error] {
    if (o.per != 0) { ret res[frame.Offset, Error].err{Error.scaled{o}}; }
    val res_numbered: res[u16, Error] = numbered(w, reg);
    if (sel res_numbered.err) { ret res[frame.Offset, Error].err{res_numbered.err}; }
    ret res[frame.Offset, Error].ok{frame.Offset{reg: res_numbered.ok, offset: o.fixed}};
}

# the canonical frame address is now a register plus an offset, .cfi_def_cfa
fun cfa(w: *Writer, from: usize, reg: rf.Id, o: Offset) err[Error] {
    if (!stating(w)) { ret err[Error].ok{}; }
    val res_at_register: res[frame.Offset, Error] = at_register(w, reg, o);
    if (sel res_at_register.err) { ret err[Error].err{res_at_register.err}; }
    ret after(w, from, frame.Rule.def_cfa{res_at_register.ok});
}

fun nonzero(o: Offset) bool {
    ret o.fixed != 0 || o.per != 0;
}

fun add(w: *Writer, e: *Emit, dest: rf.Id, src: rf.Id, o: Offset) err[Error] {
    if (dest == src && !nonzero(o)) { ret err[Error].ok{}; }
    ret refused(code.make(e, Step.add{Add{dest: dest, src: src, by: o}}));
}

fun fixed(n: i64) Offset {
    ret record.bytes(n);
}

fun register_of(o: Operand) opt[rf.Id] {
    if (!(sel o.physical)) { ret opt[rf.Id].none{}; }
    val p: Physical = o.physical;
    if (!(sel p.register)) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{p.register};
}

# a saved register's slot from the stack pointer while the prologue or an
# epilogue has it `above` bytes and `per` bytes per unit below the canonical
# frame address
fun at_depth(w: *Writer, s: Spot, above: i64, per: i64) Offset {
    val d: i64 = s.depth::i64;
    if (s.scaled) { ret Offset{fixed: above - w.p.top::i64, per: per - d, scale: w.p.scale}; }
    ret Offset{fixed: above - d, per: per, scale: w.p.scale};
}

# a save as mink's frame records state it, at the width the layout gives it, the part of the slot an unwinder restores
fun saved_at(w: *Writer, at: Save) res[frame.Saved, Error] {
    val res_at_register: res[frame.Offset, Error] = at_register(w, at.register, at.offset);
    if (sel res_at_register.err) { ret res[frame.Saved, Error].err{res_at_register.err}; }
    ret res[frame.Saved, Error].ok{frame.Saved{reg: res_at_register.ok.reg, offset: res_at_register.ok.offset, width: at.width}};
}

# a register saved at an offset from the canonical frame address, .cfi_offset
fun save(w: *Writer, e: *Emit, s: Spot, above: i64, per: i64, at: Save) err[Error] {
    val from:     usize      = w.out.function.instructions.len;
    val size:     Offset     = record.size_of(w.p.added.data[s.slot]);
    val err_done: err[Error] = refused(code.make(e, Step.store{Access{register: s.register, base: w.out.layout.stack, at: at_depth(w, s, above, per), size: size}}));
    if (sel err_done.err) { ret err_done; }
    if (!stating(w))      { ret err[Error].ok{}; }
    val res_saved_at: res[frame.Saved, Error] = saved_at(w, at);
    if (sel res_saved_at.err) { ret err[Error].err{res_saved_at.err}; }
    ret after(w, from, frame.Rule.offset{res_saved_at.ok});
}

# whether two saves are a pair the prologue may store in one instruction:
# both fixed, of one size, at adjacent slots
fun pairs(w: *Writer, a: Spot, b: Spot) bool {
    if (!w.p.paired || a.scaled || b.scaled || a.pushed || b.pushed) { ret false; }
    val sa: Offset = record.size_of(w.p.added.data[a.slot]);
    val sb: Offset = record.size_of(w.p.added.data[b.slot]);
    if (sa.per != 0 || sb.per != 0 || sa.fixed != sb.fixed) { ret false; }
    ret a.depth == b.depth + sa.fixed::u64 || b.depth == a.depth + sa.fixed::u64;
}

# the pair of two adjacent saves, the deeper one at the lower address
fun paired_of(w: *Writer, a: Spot, b: Spot, base: rf.Id, above: i64) Paired {
    var lower: Spot = a;
    var upper: Spot = b;
    if (b.depth > a.depth) {
        lower = b;
        upper = a;
    }
    ret Paired{lower: lower.register, upper: upper.register, base: base, at: at_depth(w, lower, above, 0), size: record.size_of(w.p.added.data[a.slot])};
}

# saves k and k + 1 stored in one instruction, false when the code has none for them
fun save_pair(w: *Writer, e: *Emit, k: usize, above: i64) res[bool, Error] {
    val a:        Spot            = w.p.spots.data[k];
    val b:        Spot            = w.p.spots.data[k + 1];
    val from:     usize           = w.out.function.instructions.len;
    val err_done: err[code.Error] = code.make(e, Step.store_pair{paired_of(w, a, b, w.out.layout.stack, above)});
    if (sel err_done.err) {
        val r: code.Error = err_done.err;
        if (sel r.unpaired) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].err{Error.code{r}};
    }
    if (!stating(w)) { ret res[bool, Error].ok{true}; }
    val l: *Layout = ?w.out.layout;
    var i: usize   = k;
    for (i < k + 2) {
        val res_saved_at: res[frame.Saved, Error] = saved_at(w, l.saves.data[i]);
        if (sel res_saved_at.err) { ret res[bool, Error].err{res_saved_at.err}; }
        val err_noted: err[Error] = after(w, from, frame.Rule.offset{res_saved_at.ok});
        if (sel err_noted.err) { ret res[bool, Error].err{err_noted.err}; }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}

# the saves the layout marks pushed, in order, each moving the stack pointer
# down past its slot from the return address, .cfi_def_cfa and .cfi_offset
fun push_saves(w: *Writer, e: *Emit) err[Error] {
    val l:     *Layout = ?w.out.layout;
    var depth: i64     = l.entry::i64;
    var k:     usize   = 0;
    for (k < w.p.spots.len) {
        val s: Spot = w.p.spots.data[k];
        if (s.pushed) {
            val from:     usize      = w.out.function.instructions.len;
            val size:     Offset     = record.size_of(w.p.added.data[s.slot]);
            val err_done: err[Error] = refused(code.make(e, Step.push{Stacked{register: s.register, size: size}}));
            if (sel err_done.err) { ret err_done; }
            depth = depth + size.fixed;
            val err_framed: err[Error] = cfa(w, from, l.stack, fixed(depth));
            if (sel err_framed.err) { ret err_framed; }
            if (stating(w)) {
                val res_saved_at: res[frame.Saved, Error] = saved_at(w, l.saves.data[k]);
                if (sel res_saved_at.err) { ret err[Error].err{res_saved_at.err}; }
                val err_noted: err[Error] = after(w, from, frame.Rule.offset{res_saved_at.ok});
                if (sel err_noted.err) { ret err_noted; }
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the pushed saves popped, last pushed first, each moving the stack pointer
# up past its slot, from where the pushes left it, .cfi_def_cfa and
# .cfi_restore
fun pop_saves(w: *Writer, e: *Emit) err[Error] {
    val l:     *Layout = ?w.out.layout;
    var depth: i64     = l.entry::i64 + w.p.pushed::i64;
    var k:     usize   = w.p.spots.len;
    for (k > 0) {
        k = k - 1;
        val s: Spot = w.p.spots.data[k];
        if (s.pushed) {
            val from:     usize      = w.out.function.instructions.len;
            val size:     Offset     = record.size_of(w.p.added.data[s.slot]);
            val err_done: err[Error] = refused(code.make(e, Step.pop{Stacked{register: s.register, size: size}}));
            if (sel err_done.err) { ret err_done; }
            depth = depth - size.fixed;
            val err_framed: err[Error] = cfa(w, from, l.stack, fixed(depth));
            if (sel err_framed.err) { ret err_framed; }
            if (stating(w)) {
                val res_numbered: res[u16, Error] = numbered(w, s.register);
                if (sel res_numbered.err) { ret err[Error].err{res_numbered.err}; }
                val err_noted: err[Error] = after(w, from, frame.Rule.restore{res_numbered.ok});
                if (sel err_noted.err) { ret err_noted; }
            }
        }
    }
    ret err[Error].ok{};
}

# the fixed saves the layout does not push, in order, two at a time where they pair
fun save_fixed(w: *Writer, e: *Emit, above: i64) err[Error] {
    val l: *Layout = ?w.out.layout;
    var k: usize   = 0;
    for (k < w.p.spots.len) {
        val s: Spot = w.p.spots.data[k];
        if (!s.scaled && !s.pushed) {
            var two: bool = false;
            if (k + 1 < w.p.spots.len && pairs(w, s, w.p.spots.data[k + 1])) {
                val res_tried: res[bool, Error] = save_pair(w, e, k, above);
                if (sel res_tried.err) { ret err[Error].err{res_tried.err}; }
                two = res_tried.ok;
            }
            if (two) { k = k + 1; }
            or {
                val err_done: err[Error] = save(w, e, s, above, 0, l.saves.data[k]);
                if (sel err_done.err) { ret err_done; }
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# saves k - 1 and k loaded in one instruction, false when the code has none for them
fun restore_pair(w: *Writer, e: *Emit, k: usize, base: rf.Id, above: i64) res[bool, Error] {
    val a:        Spot            = w.p.spots.data[k - 1];
    val b:        Spot            = w.p.spots.data[k];
    val from:     usize           = w.out.function.instructions.len;
    val err_done: err[code.Error] = code.make(e, Step.load_pair{paired_of(w, a, b, base, above)});
    if (sel err_done.err) {
        val r: code.Error = err_done.err;
        if (sel r.unpaired) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].err{Error.code{r}};
    }
    if (!stating(w)) { ret res[bool, Error].ok{true}; }
    var i: usize = k + 1;
    for (i > k - 1) {
        i = i - 1;
        val res_numbered: res[u16, Error] = numbered(w, w.p.spots.data[i].register);
        if (sel res_numbered.err) { ret res[bool, Error].err{res_numbered.err}; }
        val err_noted: err[Error] = after(w, from, frame.Rule.restore{res_numbered.ok});
        if (sel err_noted.err) { ret res[bool, Error].err{err_noted.err}; }
    }
    ret res[bool, Error].ok{true};
}

# a register holds its value at the call again, .cfi_restore
fun restore(w: *Writer, e: *Emit, s: Spot, base: rf.Id, o: Offset) err[Error] {
    val from:     usize      = w.out.function.instructions.len;
    val size:     Offset     = record.size_of(w.p.added.data[s.slot]);
    val err_done: err[Error] = refused(code.make(e, Step.load{Access{register: s.register, base: base, at: o, size: size}}));
    if (sel err_done.err) { ret err_done; }
    if (!stating(w))      { ret err[Error].ok{}; }
    val res_numbered: res[u16, Error] = numbered(w, s.register);
    if (sel res_numbered.err) { ret err[Error].err{res_numbered.err}; }
    ret after(w, from, frame.Rule.restore{res_numbered.ok});
}

# the frame pointer set from the stack pointer `above` bytes below the
# canonical frame address, where the frame keeps one, .cfi_def_cfa
fun set_pointer(w: *Writer, e: *Emit, above: i64) err[Error] {
    val l: *Layout = ?w.out.layout;
    if (l.pointer == rf.NONE) { ret err[Error].ok{}; }
    val at:      usize      = w.out.function.instructions.len;
    val err_set: err[Error] = add(w, e, l.pointer, l.stack, fixed(above + l.at));
    if (sel err_set.err) { ret err_set; }
    ret cfa(w, at, l.pointer, fixed(0 - l.at));
}

fun prologue(w: *Writer, e: *Emit) err[Error] {
    val p:     *Plan   = w.p;
    val l:     *Layout = ?w.out.layout;
    val sp:    rf.Id   = l.stack;
    val fp:    rf.Id   = l.pointer;
    val entry: i64     = l.entry::i64;
    val top:   i64     = p.top::i64;
    val total: i64     = top + p.locals::i64;
    val per:   i64     = p.per::i64;
    if (p.empty)    { ret err[Error].ok{}; }
    if (l.red != 0) { ret save_fixed(w, e, entry); }
    # the pushes come first and the first move takes the rest of the saves
    # from where they leave the stack pointer, and every fixed part too when
    # the scaled area is empty and the prologue does not move apart. the
    # frame pointer is set after the stored saves, or before them where the
    # plan sets it early. the scaled outgoing area is a move of its own after
    # them. a prologue moving apart takes the locals in a move of its own
    # after the saves, which is the one it probes
    val err_pushed: err[Error] = push_saves(w, e);
    if (sel err_pushed.err) { ret err_pushed; }
    val base:  i64 = entry + p.pushed::i64;
    val out:   i64 = p.out::i64;
    var above: i64 = top;
    if (per == 0 && !p.apart) { above = total; }
    val from:      usize          = w.out.function.instructions.len;
    var err_moved: err[Error]     = err[Error].ok{};
    val opt_probe: opt[id.Symbol] = p.layout.probe;
    var opt_first: opt[id.Symbol] = opt_probe;
    if (p.apart)            { opt_first = opt[id.Symbol].none{}; }
    if (sel opt_first.some) { err_moved = refused(code.make(e, Step.probe{code.Probe{stack: sp, bytes: (above - base)::u64, helper: opt_first.some}})); }
    or                      { err_moved = add(w, e, sp, sp, fixed(base - above)); }
    if (sel err_moved.err)  { ret err_moved; }
    val err_framed: err[Error] = cfa(w, from, sp, fixed(above));
    if (sel err_framed.err) { ret err_framed; }
    if (p.early) {
        val err_set: err[Error] = set_pointer(w, e, above);
        if (sel err_set.err) { ret err_set; }
    }
    val err_fixed_saves: err[Error] = save_fixed(w, e, above);
    if (sel err_fixed_saves.err) { ret err_fixed_saves; }
    if (!p.early) {
        val err_set: err[Error] = set_pointer(w, e, above);
        if (sel err_set.err) { ret err_set; }
    }
    if (p.apart && per == 0 && p.locals != 0) {
        val at:        usize      = w.out.function.instructions.len;
        var err_taken: err[Error] = err[Error].ok{};
        if (sel opt_probe.some) { err_taken = refused(code.make(e, Step.probe{code.Probe{stack: sp, bytes: p.locals, helper: opt_probe.some}})); }
        or                      { err_taken = add(w, e, sp, sp, fixed(0 - p.locals::i64)); }
        if (sel err_taken.err)  { ret err_taken; }
        if (fp == rf.NONE) {
            val err_rule: err[Error] = cfa(w, at, sp, fixed(total));
            if (sel err_rule.err) { ret err_rule; }
        }
    }
    if (per != 0) {
        val at:        usize      = w.out.function.instructions.len;
        val err_grown: err[Error] = add(w, e, sp, sp, Offset{fixed: 0, per: 0 - per, scale: p.scale});
        if (sel err_grown.err) { ret err_grown; }
        if (fp == rf.NONE) {
            val err_rule: err[Error] = cfa(w, at, sp, Offset{fixed: top, per: per, scale: p.scale});
            if (sel err_rule.err) { ret err_rule; }
        }
        var k: usize = 0;
        for (k < p.spots.len) {
            val s: Spot = p.spots.data[k];
            if (s.scaled) {
                val err_done: err[Error] = save(w, e, s, top, per, l.saves.data[k]);
                if (sel err_done.err) { ret err_done; }
            }
            k = k + 1;
        }
        val below:    usize      = w.out.function.instructions.len;
        val err_rest: err[Error] = add(w, e, sp, sp, fixed(0 - p.locals::i64));
        if (sel err_rest.err) { ret err_rest; }
        if (fp == rf.NONE) {
            val err_rule: err[Error] = cfa(w, below, sp, Offset{fixed: total, per: per, scale: p.scale});
            if (sel err_rule.err) { ret err_rule; }
        }
    }
    if (out != 0) {
        val at:        usize      = w.out.function.instructions.len;
        val err_grown: err[Error] = add(w, e, sp, sp, Offset{fixed: 0, per: 0 - out, scale: p.scale});
        if (sel err_grown.err) { ret err_grown; }
        if (fp == rf.NONE) {
            val err_rule: err[Error] = cfa(w, at, sp, Offset{fixed: total, per: per + out, scale: p.scale});
            if (sel err_rule.err) { ret err_rule; }
        }
    }
    ret err[Error].ok{};
}

# the stack pointer aligned to the widest local slot, and copied into the
# base register where the frame keeps one. a frame whose unwind encoding
# states the prologue alone does it after the prologue ends, in the body,
# where the frame pointer already says where the frame is
fun realign(w: *Writer, e: *Emit) err[Error] {
    val l: *Layout = ?w.out.layout;
    if (l.realign == 0) { ret err[Error].ok{}; }
    val err_masked: err[Error] = refused(code.make(e, Step.mask{Mask{dest: l.stack, src: l.stack, align: l.realign}}));
    if (sel err_masked.err) { ret err_masked; }
    if (l.base == rf.NONE)  { ret err[Error].ok{}; }
    ret add(w, e, l.base, l.stack, fixed(0));
}

# the base register derived again after an instruction wrote it: the stack
# pointer as the prologue left it, from the frame pointer, realigned. it
# takes no scratch, the base register holding the sum the mask reads
fun rebase(w: *Writer, e: *Emit) err[Error] {
    val l:         *Layout    = ?w.out.layout;
    val err_added: err[Error] = add(w, e, l.base, l.pointer, Offset{fixed: 0 - l.at - l.size.fixed, per: 0 - l.size.per, scale: l.size.scale});
    if (sel err_added.err) { ret err_added; }
    ret refused(code.make(e, Step.mask{Mask{dest: l.base, src: l.base, align: l.realign}}));
}

# the restores of the saves of one kind the layout does not push, last saved
# first
fun restores(w: *Writer, e: *Emit, scaled: bool, base: rf.Id, above: i64, per: i64) err[Error] {
    var k: usize = w.p.spots.len;
    for (k > 0) {
        k = k - 1;
        val s:   Spot = w.p.spots.data[k];
        var two: bool = false;
        if (s.pushed) { cnt; }
        if (s.scaled == scaled && k > 0 && pairs(w, w.p.spots.data[k - 1], s)) {
            val res_tried: res[bool, Error] = restore_pair(w, e, k, base, above);
            if (sel res_tried.err) { ret err[Error].err{res_tried.err}; }
            two = res_tried.ok;
        }
        if (two) { k = k - 1; }
        or (s.scaled == scaled) {
            val err_done: err[Error] = restore(w, e, s, base, at_depth(w, s, above, per));
            if (sel err_done.err) { ret err_done; }
        }
    }
    ret err[Error].ok{};
}

fun epilogue(w: *Writer, e: *Emit) err[Error] {
    w.closing = true;
    val err_done: err[Error] = close(w, e);
    w.closing = false;
    ret err_done;
}

fun close(w: *Writer, e: *Emit) err[Error] {
    val p:     *Plan   = w.p;
    val l:     *Layout = ?w.out.layout;
    val sp:    rf.Id   = l.stack;
    val fp:    rf.Id   = l.pointer;
    val entry: i64     = l.entry::i64;
    val top:   i64     = p.top::i64;
    val total: i64     = top + p.locals::i64;
    val per:   i64     = p.per::i64;
    if (p.empty) { ret err[Error].ok{}; }
    # an epilogue scope's begin remembers the body's state, which masc restores past the return
    var begun: Statement = Statement.rule{frame.Rule.remember{}};
    if (p.scoped) { begun = Statement.begin{}; }
    val err_kept: err[Error] = fact(w, (w.out.function.instructions.len::u32), false, begun);
    if (sel err_kept.err) { ret err_kept; }
    if (l.red != 0) {
        val err_done: err[Error] = restores(w, e, false, sp, entry, 0);
        if (sel err_done.err) { ret err_done; }
        ret restores(w, e, true, sp, entry, 0);
    }
    if (p.pushed != 0) { ret unpush(w, e); }
    var above: i64 = total;
    if (fp == rf.NONE && p.out != 0) {
        val at:         usize      = w.out.function.instructions.len;
        val err_shrunk: err[Error] = add(w, e, sp, sp, Offset{fixed: 0, per: p.out::i64, scale: p.scale});
        if (sel err_shrunk.err) { ret err_shrunk; }
        var left: Offset = fixed(total);
        if (per != 0) { left = Offset{fixed: total, per: per, scale: p.scale}; }
        val err_rule: err[Error] = cfa(w, at, sp, left);
        if (sel err_rule.err) { ret err_rule; }
    }
    if (fp != rf.NONE) {
        # scaled saves from the frame pointer, which is where the frame
        # pointer is minus the bytes down to the saves
        val err_scaled: err[Error] = restores(w, e, true, fp, 0 - l.at, 0);
        if (sel err_scaled.err) { ret err_scaled; }
        val at:        usize      = w.out.function.instructions.len;
        val err_moved: err[Error] = add(w, e, sp, fp, fixed(0 - l.at - top));
        if (sel err_moved.err) { ret err_moved; }
        val err_rule: err[Error] = cfa(w, at, sp, fixed(top));
        if (sel err_rule.err) { ret err_rule; }
        above = top;
    }
    or (per != 0) {
        val at:        usize      = w.out.function.instructions.len;
        val err_moved: err[Error] = add(w, e, sp, sp, fixed(p.locals::i64));
        if (sel err_moved.err) { ret err_moved; }
        val err_rule: err[Error] = cfa(w, at, sp, Offset{fixed: top, per: per, scale: p.scale});
        if (sel err_rule.err) { ret err_rule; }
        val err_scaled: err[Error] = restores(w, e, true, sp, top, per);
        if (sel err_scaled.err) { ret err_scaled; }
        val past:       usize      = w.out.function.instructions.len;
        val err_shrunk: err[Error] = add(w, e, sp, sp, Offset{fixed: 0, per: per, scale: p.scale});
        if (sel err_shrunk.err) { ret err_shrunk; }
        val err_again: err[Error] = cfa(w, past, sp, fixed(top));
        if (sel err_again.err) { ret err_again; }
        above = top;
    }
    val err_fixed_saves: err[Error] = restores(w, e, false, sp, above, 0);
    if (sel err_fixed_saves.err) { ret err_fixed_saves; }
    val from:     usize      = w.out.function.instructions.len;
    val err_back: err[Error] = add(w, e, sp, sp, fixed(above - entry));
    if (sel err_back.err) { ret err_back; }
    ret cfa(w, from, sp, fixed(entry));
}

# the epilogue of a frame that pushes, which has no scaled area, in the one
# shape windows' x64 unwinder takes for an epilogue: the stored saves
# restored while the stack still holds them, the stack released down to the
# pushes by `lea` from the frame pointer where it is kept and by the code's
# release from the stack pointer otherwise, then the pops in reverse
fun unpush(w: *Writer, e: *Emit) err[Error] {
    val p:     *Plan   = w.p;
    val l:     *Layout = ?w.out.layout;
    val sp:    rf.Id   = l.stack;
    val fp:    rf.Id   = l.pointer;
    val total: i64     = p.top::i64 + p.locals::i64;
    val base:  i64     = l.entry::i64 + p.pushed::i64;
    if (fp != rf.NONE) {
        # the frame pointer is the canonical frame address plus l.at
        val err_stored: err[Error] = restores(w, e, false, fp, 0 - l.at, 0);
        if (sel err_stored.err) { ret err_stored; }
        val from:      usize      = w.out.function.instructions.len;
        val err_moved: err[Error] = add(w, e, sp, fp, fixed(0 - l.at - base));
        if (sel err_moved.err) { ret err_moved; }
        val err_rule: err[Error] = cfa(w, from, sp, fixed(base));
        if (sel err_rule.err) { ret err_rule; }
    }
    or {
        val err_stored: err[Error] = restores(w, e, false, sp, total, 0);
        if (sel err_stored.err) { ret err_stored; }
        if (total != base) {
            val from:         usize      = w.out.function.instructions.len;
            val err_released: err[Error] = refused(code.make(e, Step.release{Release{stack: sp, by: fixed(total - base)}}));
            if (sel err_released.err) { ret err_released; }
            val err_rule: err[Error] = cfa(w, from, sp, fixed(base));
            if (sel err_rule.err) { ret err_rule; }
        }
    }
    ret pop_saves(w, e);
}

# a dynamic allocation: the size rounded up to the stack's alignment taken
# off the stack pointer, the block just above the outgoing area
fun dynamic(w: *Writer, e: *Emit, dest: rf.Id, size: rf.Id, align: u64) err[Error] {
    val sp:          rf.Id      = w.out.layout.stack;
    val err_rounded: err[Error] = add(w, e, dest, size, fixed((align - 1)::i64));
    if (sel err_rounded.err) { ret err_rounded; }
    val err_masked: err[Error] = refused(code.make(e, Step.mask{Mask{dest: dest, src: dest, align: align}}));
    if (sel err_masked.err) { ret err_masked; }
    val err_taken: err[Error] = refused(code.make(e, Step.sub{Sub{dest: sp, a: sp, b: dest}}));
    if (sel err_taken.err) { ret err_taken; }
    ret refused(code.make(e, Step.add{Add{dest: dest, src: sp, by: Offset{fixed: w.out.layout.outgoing::i64, per: w.p.out::i64, scale: w.p.scale}}}));
}

fun slot_address(w: *Writer, at: Instruction, s: Slot) res[Address, Error] {
    val pl: Place = w.out.layout.slots.data[s];
    if (sel pl.dropped) { ret res[Address, Error].err{Error.dropped{at}}; }
    ret res[Address, Error].ok{pl.at};
}

fun copy(w: *Writer, b: Block, d: *InstructionData) err[Error] {
    val res_made: res[Instruction, function.Error] = function.carry_held(?w.out.function, b, d);
    if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
    ret err[Error].ok{};
}

# whether an inline block moves the stack pointer `sp`, by its stack effect or a write of it
fun moves(x: *Inline, sp: rf.Id) bool {
    if (!(sel x.stack.none)) { ret true; }
    var k: usize = 0;
    for (k < x.writes.size) {
        if (x.writes.data[k] == sp) { ret true; }
        k = k + 1;
    }
    ret false;
}

# an inline block copied with each frame slot it reaches memory through as the
# address of the slot's place
fun copy_inline(w: *Writer, b: Block, at: Instruction, d: *InstructionData, x: *Inline) err[Error] {
    if (d.operands.size > ia.MOST_OPERANDS::usize) { ret err[Error].err{Error.operand{at}}; }
    var ops: [ia.MOST_OPERANDS]Operand;
    var k:   usize = 0;
    for (k < d.operands.size) {
        val o: Operand = d.operands.data[k];
        ops[k] = o;
        if (sel o.slot) {
            val res_slot_address: res[Address, Error] = slot_address(w, at, o.slot);
            if (sel res_slot_address.err) { ret err[Error].err{res_slot_address.err}; }
            val base: rf.Id = record.base_of(?w.out.layout, res_slot_address.ok);
            if (res_slot_address.ok.offset.per != 0)                                                           { ret err[Error].err{Error.moved{at}}; }
            if (base == w.out.layout.stack && moves(x, w.out.layout.stack))                                    { ret err[Error].err{Error.moved{at}}; }
            if (base == w.out.layout.base && lay.block_writes(w.code.context.view.file, d, w.out.layout.base)) { ret err[Error].err{Error.rebased{at}}; }
            ops[k] = Operand.address{OperandAddress{base: opt[Register].some{Register.physical{Physical.register{base}}}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: res_slot_address.ok.offset.fixed, symbol: opt[OperandSymbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
        }
        k = k + 1;
    }
    val res_made: res[Instruction, function.Error] = function.carry(?w.out.function, b, d, Slice[Operand]{data: ?ops[0], size: d.operands.size});
    if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
    ret err[Error].ok{};
}

fun instruction(w: *Writer, b: Block, id: Instruction) err[Error] {
    val d:  *InstructionData = function.data(w.src, id);
    val op: Opcode           = d.opcode;
    if (w.p.facts.exits.data[id]) {
        var outer:     Emit       = Emit{admitted: w.code, f: ?w.out.function, block: b, metadata: d.metadata, stack: w.out.layout.stack, scratches: w.p.scratches, scratch: opt[rf.Id].none{}};
        val from:      usize      = w.out.function.instructions.len;
        val err_ended: err[Error] = epilogue(w, ?outer);
        if (sel err_ended.err) { ret err_ended; }
        val err_origins: err[Error] = origins(w, from, record.NONE);
        if (sel err_origins.err) { ret err_origins; }
        val mid:        usize         = w.out.function.instructions.len;
        var err_copied: err[Error]    = err[Error].ok{};
        val opt_exit:   opt[IrSymbol] = w.p.exit;
        if (sel opt_exit.some)  { err_copied = refused(code.make(?outer, Step.leave{code.Leave{routine: opt_exit.some}})); }
        or                      { err_copied = copy(w, b, d); }
        if (sel err_copied.err) { ret err_copied; }
        val err_origins_mid: err[Error] = origins(w, mid, id);
        if (sel err_origins_mid.err) { ret err_origins_mid; }
        if (w.p.empty)               { ret err[Error].ok{}; }
        if (w.p.scoped)              { ret fact(w, last(w), false, Statement.end{}); }
        if (w.p.bounded)             { ret err[Error].ok{}; }
        ret fact(w, last(w), true, Statement.rule{frame.Rule.restore_state{}});
    }
    val from:     usize         = w.out.function.instructions.len;
    var err_done: err[Error]    = err[Error].ok{};
    var kind:     pseudo.Pseudo = pseudo.COPY;
    var expands:  bool          = false;
    if (sel op.pseudo) {
        kind    = op.pseudo;
        expands = kind == pseudo.DYNAMIC;
    }
    if (expands) {
        val opt_dest: opt[rf.Id] = register_of(d.operands.data[0]);
        val opt_size: opt[rf.Id] = register_of(d.operands.data[1]);
        if (sel opt_dest.none) { ret err[Error].err{Error.operand{id}}; }
        if (sel opt_size.none) { ret err[Error].err{Error.operand{id}}; }
        var e: Emit = Emit{admitted: w.code, f: ?w.out.function, block: b, metadata: d.metadata, stack: w.out.layout.stack, scratches: code.NO_SCRATCH, scratch: opt[rf.Id].none{}};
        err_done = dynamic(w, ?e, opt_dest.some, opt_size.some, w.p.align);
    }
    or (sel op.inline)    { err_done = copy_inline(w, b, id, d, op.inline); }
    or                    { err_done = copy(w, b, d); }
    if (sel err_done.err) { ret err_done; }
    if (w.out.layout.base != rf.NONE && lay.block_writes(w.code.context.view.file, d, w.out.layout.base)) {
        var e:           Emit       = Emit{admitted: w.code, f: ?w.out.function, block: b, metadata: d.metadata, stack: w.out.layout.stack, scratches: code.NO_SCRATCH, scratch: opt[rf.Id].none{}};
        val err_rebased: err[Error] = rebase(w, ?e);
        if (sel err_rebased.err) { ret err_rebased; }
    }
    ret origins(w, from, id);
}

# write a laid out frame
# ---
# a:    the allocator the framed function takes
# f:    the function the plan was laid out for, unchanged on a refusal, and
#       left no operand storage once framed
# p:    the plan, whose layout moves into the result
# code: the target's frame code bound to the build's selection
# ret:  the framed function, or why it was refused
pub fun finish(a: *allocator.Allocator, f: *Function, p: *Plan, code: *Admitted) res[Framed, Error] {
    var out: Framed = Framed{function: function.init(a, f.set, f.checked), layout: p.layout, facts: vector.init[Fact](a), origins: vector.init[u32](a)};
    p.layout.slots    = vector.init[Place](a);
    p.layout.saves    = vector.init[record.Save](a);
    p.layout.reserved = vector.init[record.Emergency](a);
    var w:        Writer     = Writer{src: f, p: p, code: code, out: ?out, closing: false};
    val err_done: err[Error] = write(?w);
    if (sel err_done.err) {
        record.dnit(?out);
        ret res[Framed, Error].err{err_done.err};
    }
    var first:       vector.Vector[u32]   = vector.init[u32](a);
    var err_carried: err[allocator.Error] = function.firsts(f.instructions.len, Slice[u32]{data: out.origins.data, size: out.origins.len}, ?first);
    val counted:     bool                 = sel err_carried.ok;
    if (counted) { err_carried = function.carry_points(?out.function, f, Slice[u32]{data: first.data, size: first.len}); }
    vector.dnit[u32](?first);
    if (!sel err_carried.err) { err_carried = function.adopt(?out.function, f); }
    if (sel err_carried.err) {
        record.dnit(?out);
        ret res[Framed, Error].err{Error.made{function.Error.alloc{err_carried.err}}};
    }
    ret res[Framed, Error].ok{out};
}

fun write(w: *Writer) err[Error] {
    val f:             *Function            = w.src;
    val err_inherited: err[allocator.Error] = function.inherit(?w.out.function, f);
    if (sel err_inherited.err) { ret alloc_err(err_inherited.err); }
    var i: usize = 0;
    for (i < f.virtuals.len) {
        val res_made: res[Virtual, function.Error] = function.virtual(?w.out.function, f.virtuals.data[i], f.secret.data[i]);
        if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
        i = i + 1;
    }
    i = 0;
    for (i < f.slots.len) {
        val res_made: res[Slot, function.Error] = function.slot(?w.out.function, f.slots.data[i]);
        if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
        i = i + 1;
    }
    i = 0;
    for (i < w.p.added.len) {
        val res_made: res[Slot, function.Error] = function.slot(?w.out.function, w.p.added.data[i]);
        if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
        i = i + 1;
    }
    i = 0;
    for (i < f.blocks.len) {
        val res_made: res[Block, function.Error] = function.block(?w.out.function);
        if (sel res_made.err) { ret err[Error].err{Error.made{res_made.err}}; }
        i = i + 1;
    }
    val err_room: err[allocator.Error] = function.lists_of(?w.out.function, f);
    if (sel err_room.err) { ret alloc_err(err_room.err); }
    i = 0;
    for (i < f.blocks.len) {
        val b: Block = (i::u32);
        if (i == 0) {
            var md:       Metadata;
            var e:        Emit       = Emit{admitted: w.code, f: ?w.out.function, block: b, metadata: md, stack: w.out.layout.stack, scratches: w.p.scratches, scratch: opt[rf.Id].none{}};
            val from:     usize      = w.out.function.instructions.len;
            val err_done: err[Error] = prologue(w, ?e);
            if (sel err_done.err) { ret err_done; }
            if (w.p.bounded) {
                val err_ended: err[Error] = after(w, from, frame.Rule.prologue_end{});
                if (sel err_ended.err) { ret err_ended; }
            }
            val err_aligned: err[Error] = realign(w, ?e);
            if (sel err_aligned.err) { ret err_aligned; }
            val err_origins: err[Error] = origins(w, from, record.NONE);
            if (sel err_origins.err) { ret err_origins; }
        }
        val list: Slice[Instruction] = function.instructions(f, b);
        var k:    usize              = 0;
        for (k < list.size) {
            val err_done: err[Error] = instruction(w, b, list.data[k]);
            if (sel err_done.err) { ret err_done; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}
