# the sharing of frame slots whose contents are never live at once
#
# after allocation, a local slot of fixed size whose address never leaves the
# registers (`mirl.machine.addressed`) is read and written only where the
# function names it: a spill writes a spill slot whole, a reload reads it,
# and every other access reaches a slot through a register holding its
# address. a slot is live at a point when some path from there reaches such a
# read or access before a spill writes it whole, which a backward dataflow
# over the blocks solves (`mirl.ir.cfg.flow`). two slots interfere when one
# is written whole while the other is live, or both are live where the
# function starts, which holds for every slot live anywhere the other is,
# since a slot no spill writes is live from the start. slots that do not
# interfere, of one size, the same secrecy and the same public bytes, share
# one slot: the first of them in slot order takes the largest alignment of
# the group, every operand, extent and record naming another names it instead,
# and the others take no space, as a slot no operand names takes none. a
# secret slot never shares with a public one.
#
# a slot whose address leaves the registers is a candidate too when its
# storage is scoped: the ir stated where it begins and ends (`slot.begin`,
# `slot.end`), which selection carries as the `slot_begin` and `slot_end`
# pseudo-instructions, and no access of it stands where its storage has
# ended. such a slot lasts wherever it is begun on some path, a forward
# dataflow over the blocks, and within a block, walked from its end, an end
# makes it last before it and a begin makes it not, the begin then meeting
# every slot that lasts there as a spill does. a slot within a scoped slot
# follows it to its group's first. markers are neither reads nor writes of
# their slot.
#
# with s candidate slots, i instructions, b blocks and h the candidates live
# or begun into or out of a block summed over the blocks, the gathering and
# each block's sets are O(s + b + i), each dataflow O(s + b + i + h) and the
# edges of each block a candidate holds into (`mirl.ir.cfg.flow`), the
# interference O(i + h) plus one for each candidate live where a spill or a
# begin meets it, and the grouping O(s g) for g groups, over s s bits.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;
use std.math.bits;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.global;
use mirl.ir.metadata;
use mirl.machine.addressed;
use mirl.machine.addressed.Reach;
use mirl.machine.function;
use mirl.machine.function.Area;
use mirl.machine.function.Function;
use mirl.machine.function.SlotData;
use mirl.machine.function.Within;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Slot;
use mirl.machine.point.Reading;
use mirl.machine.pseudo;

val NONE: u32 = 0xffffffff;

# what the sharing works in
# ---
# index:    each slot's candidate number, NONE for a slot that is not one
# slots:    each candidate's slot
# escaped:  whether each slot lets its address out
# named:    whether an instruction other than a marker names each slot, or a slot within it
# scoped:   whether each slot lets its address out and a marker names it
# reached:  where each slot is reached through a register
# gen:      what each block reads before it writes, by candidate
# kill:     what each block writes whole
# live_in:  what is live into each block
# live_out: what is live out of each block
# opens:    what each block's last marker of a scoped candidate begins
# marks:    the scoped candidates a marker of each block names
# begun:    the scoped candidates begun out of each block on some path
# flow:     the storage the dataflow works in
# seen:     each candidate's mark of the block the walk is in, where it is written whole there already
# genned:   each candidate's mark of the block, where its gen holds it already
# marked:   each candidate's mark of the block, where a marker of the block names it
# begins:   for a candidate a marker of the block names, whether the last such begins it
# listed:   the candidates a marker of the block names
# read:     the candidates the instruction the walk is at reads
# live:     what is live at the instruction the walk is at
# place:    each candidate's place in `live`, which holds it where `live` has it there
# meets:    each candidate's row of words, whether it interferes with each other
# groups:   each candidate's row of words, for the first of a group the
#           interference of the group's members
# group:    each candidate's group, by its first candidate
# heads:    the first candidate of each group, ascending
# rep:      each slot's slot after sharing
# lists:    the module's lists of public byte ranges, by id
rec Work {
    index:    vector.Vector[u32];
    slots:    vector.Vector[u32];
    escaped:  vector.Vector[bool];
    named:    vector.Vector[bool];
    scoped:   vector.Vector[bool];
    reached:  vector.Vector[Reach];
    at:       vector.Vector[u32];
    gen:      Lists[u32];
    kill:     Lists[u32];
    live_in:  Lists[u32];
    live_out: Lists[u32];
    opens:    Lists[u32];
    marks:    Lists[u32];
    begun:    Lists[u32];
    flow:     flow.Work;
    seen:     vector.Vector[u32];
    genned:   vector.Vector[u32];
    marked:   vector.Vector[u32];
    begins:   vector.Vector[bool];
    listed:   vector.Vector[u32];
    read:     vector.Vector[u32];
    live:     vector.Vector[u32];
    place:    vector.Vector[u32];
    meets:    vector.Vector[u64];
    groups:   vector.Vector[u64];
    group:    vector.Vector[u32];
    heads:    vector.Vector[u32];
    rep:      vector.Vector[u32];
    lists:    Slice[Slice[global.Range]];
}

fun work_init(a: *allocator.Allocator, lists: Slice[Slice[global.Range]]) Work {
    ret Work{
        index:    vector.init[u32](a),
        slots:    vector.init[u32](a),
        escaped:  vector.init[bool](a),
        named:    vector.init[bool](a),
        scoped:   vector.init[bool](a),
        reached:  vector.init[Reach](a),
        at:       vector.init[u32](a),
        gen:      graph.lists_init[u32](a),
        kill:     graph.lists_init[u32](a),
        live_in:  graph.lists_init[u32](a),
        live_out: graph.lists_init[u32](a),
        opens:    graph.lists_init[u32](a),
        marks:    graph.lists_init[u32](a),
        begun:    graph.lists_init[u32](a),
        flow:     flow.work(a),
        seen:     vector.init[u32](a),
        genned:   vector.init[u32](a),
        marked:   vector.init[u32](a),
        begins:   vector.init[bool](a),
        listed:   vector.init[u32](a),
        read:     vector.init[u32](a),
        live:     vector.init[u32](a),
        place:    vector.init[u32](a),
        meets:    vector.init[u64](a),
        groups:   vector.init[u64](a),
        group:    vector.init[u32](a),
        heads:    vector.init[u32](a),
        rep:      vector.init[u32](a),
        lists:    lists,
    };
}

fun work_dnit(w: *Work) {
    vector.dnit[u32](?w.index);
    vector.dnit[u32](?w.slots);
    vector.dnit[bool](?w.escaped);
    vector.dnit[bool](?w.named);
    vector.dnit[bool](?w.scoped);
    vector.dnit[Reach](?w.reached);
    vector.dnit[u32](?w.at);
    graph.lists_dnit[u32](?w.gen);
    graph.lists_dnit[u32](?w.kill);
    graph.lists_dnit[u32](?w.live_in);
    graph.lists_dnit[u32](?w.live_out);
    graph.lists_dnit[u32](?w.opens);
    graph.lists_dnit[u32](?w.marks);
    graph.lists_dnit[u32](?w.begun);
    flow.work_dnit(?w.flow);
    vector.dnit[u32](?w.seen);
    vector.dnit[u32](?w.genned);
    vector.dnit[u32](?w.marked);
    vector.dnit[bool](?w.begins);
    vector.dnit[u32](?w.listed);
    vector.dnit[u32](?w.read);
    vector.dnit[u32](?w.live);
    vector.dnit[u32](?w.place);
    vector.dnit[u64](?w.meets);
    vector.dnit[u64](?w.groups);
    vector.dnit[u32](?w.group);
    vector.dnit[u32](?w.heads);
    vector.dnit[u32](?w.rep);
}

fun bit(words: *u64, n: u32) bool {
    ret ((words[(n / 64)::usize] >> (n % 64)::u64) & 1) != 0;
}

fun set(words: *u64, n: u32) {
    words[(n / 64)::usize] = words[(n / 64)::usize] | ((1::u64) << (n % 64)::u64);
}

# whether a slot may share: a local of fixed size that something names, whose address stays in and that no slot lies
# within, or whose storage is scoped. a slot only markers name takes no space, so it never heads a group
fun candidate(w: *Work, s: *SlotData, n: usize) bool {
    if (!(sel s.area.local) || s.per != 0 || s.size == 0 || !w.named.data[n]) { ret false; }
    ret !w.escaped.data[n] || w.scoped.data[n];
}

# each slot an instruction other than a marker names, and each slot one named lies within, as the frame lays out only
# those (`mirl.machine.frame.scan`)
fun names(w: *Work, f: *Function) err[allocator.Error] {
    val err_filled: err[allocator.Error] = slice.fill[bool](?w.named, f.slots.len, false);
    if (sel err_filled.err) { ret err_filled; }
    var b: usize = 0;
    for (b < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, b::u32);
        var i:    usize              = 0;
        for (i < list.size) {
            val d: *InstructionData = function.data(f, list.data[i]);
            if (!marker(d)) {
                var n: usize = 0;
                for (n < d.operands.size) {
                    val o: u32 = slot_of(?d.operands.data[n]);
                    if (o::usize < w.named.len) { w.named.data[o::usize] = true; }
                    n = n + 1;
                }
            }
            i = i + 1;
        }
        b = b + 1;
    }
    var s: usize = f.slots.len;
    for (s > 0) {
        s = s - 1;
        val area: function.Area = f.slots.data[s].area;
        if (sel area.within) {
            if (w.named.data[s] && area.within.slot::usize < w.named.len) { w.named.data[area.within.slot::usize] = true; }
        }
    }
    ret err[allocator.Error].ok{};
}

# whether an instruction marks where its slot's storage begins or ends
fun marker(d: *InstructionData) bool {
    val op: Opcode = d.opcode;
    ret sel op.pseudo && pseudo.marks(op.pseudo) && d.operands.size == 1;
}

# whether an instruction marks where its slot's storage begins
fun begins(d: *InstructionData) bool {
    val op: Opcode = d.opcode;
    ret sel op.pseudo && op.pseudo == pseudo.SLOT_BEGIN;
}

# the candidate a slot operand names, NONE for none
fun named(w: *Work, o: Operand) u32 {
    if (!(sel o.slot))                { ret NONE; }
    if (o.slot::usize >= w.index.len) { ret NONE; }
    ret w.index.data[o.slot::usize];
}

# the candidate an instruction writes whole, a spill's slot, NONE for none
fun written(w: *Work, d: *InstructionData) u32 {
    val op: Opcode = d.opcode;
    if (!(sel op.pseudo))                                  { ret NONE; }
    if (op.pseudo != pseudo.SPILL || d.operands.size != 2) { ret NONE; }
    ret named(w, d.operands.data[0]);
}

# whether a pseudo reads every slot it names: any but a spill, which writes its slot whole, and a marker, which
# neither reads nor writes
fun named_by(p: pseudo.Pseudo) bool {
    ret p != pseudo.SPILL && !pseudo.marks(p);
}

# the scoped candidate a marker names, NONE for any other instruction
fun scoped_by(w: *Work, d: *InstructionData) u32 {
    if (!marker(d)) { ret NONE; }
    val c: u32 = named(w, d.operands.data[0]);
    if (c == NONE || !lasting(w, c)) { ret NONE; }
    ret c;
}

# whether a candidate's storage is scoped, so its markers alone say where it lasts
fun lasting(w: *Work, c: u32) bool {
    ret w.scoped.data[w.slots.data[c::usize]::usize];
}

# every candidate an instruction reads, a reload's slot, a slot address's
# slot and every slot it reaches through a register, each listed in `read`,
# but a scoped one, which lasts where its markers say whatever reads it
fun reads(w: *Work, d: *InstructionData, i: Instruction) err[allocator.Error] {
    vector.clear[u32](?w.read);
    val op: Opcode = d.opcode;
    if (sel op.pseudo && named_by(op.pseudo)) {
        var n: usize = 0;
        for (n < d.operands.size) {
            val c: u32 = named(w, d.operands.data[n]);
            if (c != NONE && !lasting(w, c)) {
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.read, c);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
            n = n + 1;
        }
    }
    var k: u32 = w.at.data[i::usize];
    for (k != NONE && k::usize < w.reached.len && w.reached.data[k::usize].at == i) {
        val s: u32 = w.reached.data[k::usize].slot;
        if (s::usize < w.index.len && w.index.data[s::usize] != NONE && !lasting(w, w.index.data[s::usize])) {
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.read, w.index.data[s::usize]);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

fun by_at(a: *Reach, b: *Reach) i64 {
    if (a.at < b.at) { ret -1; }
    if (a.at > b.at) { ret 1; }
    ret 0;
}

# the first reach of each instruction, NONE for none, the reaches sorted by instruction
fun index_reaches(w: *Work, count: usize) err[allocator.Error] {
    sort.sort_by[Reach](w.reached.data, w.reached.len, by_at);
    val err_filled: err[allocator.Error] = slice.fill[u32](?w.at, count, NONE);
    if (sel err_filled.err) { ret err_filled; }
    var k: usize = w.reached.len;
    for (k > 0) {
        k = k - 1;
        val i: usize = w.reached.data[k].at::usize;
        if (i < count) { w.at.data[i] = k::u32; }
    }
    ret err[allocator.Error].ok{};
}

# a candidate block `b` writes whole, or a marker of it begins
fun ends(w: *Work, b: u32, c: u32) err[allocator.Error] {
    if (w.seen.data[c] == b + 1) { ret err[allocator.Error].ok{}; }
    w.seen.data[c] = b + 1;
    ret flow.fact(?w.kill, c);
}

# a candidate block `b` reads, or a marker of it ends: in its gen unless the block wrote it whole before
fun uses(w: *Work, b: u32, c: u32) err[allocator.Error] {
    if (w.seen.data[c] == b + 1 || w.genned.data[c] == b + 1) { ret err[allocator.Error].ok{}; }
    w.genned.data[c] = b + 1;
    ret flow.fact(?w.gen, c);
}

# block `b`'s gen and kill, and what its markers begin and name, walked from its start: an instruction reads before
# a marker of it acts and a spill writes after both, and the last marker of a candidate says whether it is begun at
# the block's end
fun transfer(w: *Work, f: *Function, b: u32) err[allocator.Error] {
    vector.clear[u32](?w.listed);
    val list:       Slice[Instruction]   = function.instructions(f, b);
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (!(sel err_failed.err) && i < list.size) {
        val d: *InstructionData = function.data(f, list.data[i]);
        keep(?err_failed, reads(w, d, list.data[i]));
        var r: usize = 0;
        for (r < w.read.len) {
            keep(?err_failed, uses(w, b, w.read.data[r]));
            r = r + 1;
        }
        val s: u32 = scoped_by(w, d);
        if (s != NONE) {
            if (w.marked.data[s] != b + 1) {
                w.marked.data[s] = b + 1;
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.listed, s);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
            w.begins.data[s] = begins(d);
            if (begins(d)) { keep(?err_failed, ends(w, b, s)); }
            or             { keep(?err_failed, uses(w, b, s)); }
        }
        val c: u32 = written(w, d);
        if (c != NONE) { keep(?err_failed, ends(w, b, c)); }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < w.listed.len) {
        val s: u32 = w.listed.data[k];
        keep(?err_failed, flow.fact(?w.marks, s));
        if (w.begins.data[s]) { keep(?err_failed, flow.fact(?w.opens, s)); }
        k = k + 1;
    }
    keep(?err_failed, flow.next(?w.gen));
    keep(?err_failed, flow.next(?w.kill));
    keep(?err_failed, flow.next(?w.opens));
    keep(?err_failed, flow.next(?w.marks));
    ret err_failed;
}

fun meet(w: *Work, words: usize, x: u32, y: u32) {
    if (x == y) { ret; }
    set(?w.meets.data[x::usize * words], y);
    set(?w.meets.data[y::usize * words], x);
}

# every candidate live at the walk made to interfere with `c`
fun meet_live(w: *Work, words: usize, c: u32) {
    var k: usize = 0;
    for (k < w.live.len) {
        meet(w, words, c, w.live.data[k]);
        k = k + 1;
    }
}

# whether a candidate is live at the walk
fun is_live(w: *Work, c: u32) bool {
    val at: u32 = w.place.data[c];
    ret at::usize < w.live.len && w.live.data[at] == c;
}

# a candidate made live at the walk
fun enliven(w: *Work, c: u32) err[allocator.Error] {
    if (is_live(w, c)) { ret err[allocator.Error].ok{}; }
    w.place.data[c] = w.live.len::u32;
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.live, c);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# a candidate no longer live at the walk, the last taking its place
fun deaden(w: *Work, c: u32) {
    if (!is_live(w, c)) { ret; }
    val at:   u32 = w.place.data[c];
    val last: u32 = w.live.data[w.live.len - 1];
    w.live.data[at]    = last;
    w.place.data[last] = at;
    vector.truncate[u32](?w.live, w.live.len - 1);
}

# the interference of block `b`, walked from its end with what is live out of it
fun interfere(w: *Work, f: *Function, b: u32, words: usize) err[allocator.Error] {
    vector.clear[u32](?w.live);
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    val out:        Slice[u32]           = flow.row(?w.live_out, b);
    var k:          usize                = 0;
    for (k < out.size) {
        keep(?err_failed, enliven(w, out.data[k]));
        k = k + 1;
    }
    val begun: Slice[u32] = flow.row(?w.begun, b);
    k = 0;
    for (k < begun.size) {
        keep(?err_failed, enliven(w, begun.data[k]));
        k = k + 1;
    }
    val list: Slice[Instruction] = function.instructions(f, b);
    var i:    usize              = list.size;
    for (!(sel err_failed.err) && i > 0) {
        i = i - 1;
        val d: *InstructionData = function.data(f, list.data[i]);
        val c: u32              = written(w, d);
        if (c != NONE) {
            meet_live(w, words, c);
            deaden(w, c);
        }
        val s: u32 = scoped_by(w, d);
        if (s != NONE && begins(d)) {
            meet_live(w, words, s);
            deaden(w, s);
        }
        or (s != NONE) { keep(?err_failed, enliven(w, s)); }
        keep(?err_failed, reads(w, d, list.data[i]));
        var r: usize = 0;
        for (r < w.read.len) {
            keep(?err_failed, enliven(w, w.read.data[r]));
            r = r + 1;
        }
    }
    ret err_failed;
}

# whether two statements of public bytes state the same ranges: one list, or
# two lists of equal ranges, while no statement is alike only no statement
fun same_publics(w: *Work, x: metadata.Publics, y: metadata.Publics) bool {
    if (x == y)                                               { ret true; }
    if (x == metadata.NO_PUBLICS || y == metadata.NO_PUBLICS) { ret false; }
    if (x::usize >= w.lists.size || y::usize >= w.lists.size) { ret false; }
    val p: Slice[global.Range] = w.lists.data[x];
    val q: Slice[global.Range] = w.lists.data[y];
    if (p.size != q.size) { ret false; }
    var k: usize = 0;
    for (k < p.size) {
        if (p.data[k].offset != q.data[k].offset || p.data[k].length != q.data[k].length) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether two slots may hold one slot's storage, past their interference: of
# one size, since a spill or reload moves its slot's whole size, and of one
# secrecy and the same public bytes
fun alike(w: *Work, f: *Function, s: u32, q: u32) bool {
    val x: *SlotData = ?f.slots.data[s::usize];
    val y: *SlotData = ?f.slots.data[q::usize];
    if (x.size != y.size || x.secret != y.secret) { ret false; }
    ret same_publics(w, x.publics, y.publics);
}

# each candidate put in the first earlier group of its kind none of whose
# members it interferes with, or a group of its own, and each slot given its
# group's first slot
fun colour(w: *Work, f: *Function, m: u32, words: usize) err[allocator.Error] {
    var c: u32 = 0;
    for (c < m) {
        val s:    u32   = w.slots.data[c::usize];
        var head: u32   = c;
        var h:    usize = 0;
        for (h < w.heads.len) {
            val r: u32 = w.heads.data[h];
            if (alike(w, f, s, w.slots.data[r::usize]) && !bit(?w.groups.data[r::usize * words], c)) {
                head = r;
                brk;
            }
            h = h + 1;
        }
        if (head == c) {
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.heads, c);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        w.group.data[c::usize] = head;
        var k: usize = 0;
        for (k < words) {
            w.groups.data[head::usize * words + k] = w.groups.data[head::usize * words + k] | w.meets.data[c::usize * words + k];
            k                                      = k + 1;
        }
        w.rep.data[s::usize] = w.slots.data[head::usize];
        c                    = c + 1;
    }
    ret err[allocator.Error].ok{};
}

# the slot operand `o` names, NONE for any other operand
fun slot_of(o: *Operand) u32 {
    if (sel o.slot) { ret o.slot; }
    ret NONE;
}

# every operand, extent, record and slot within naming a shared slot made to
# name its group's first, which takes the group's largest alignment
fun rename(w: *Work, f: *Function) {
    var s: usize = 0;
    for (s < f.slots.len) {
        val r: u32 = w.rep.data[s];
        if (r::usize != s) {
            if (f.slots.data[s].align > f.slots.data[r::usize].align) { f.slots.data[r::usize].align = f.slots.data[s].align; }
        }
        val area: Area = f.slots.data[s].area;
        if (sel area.within) {
            if (area.within.slot::usize < w.rep.len) { f.slots.data[s].area = Area.within{Within{slot: w.rep.data[area.within.slot::usize], offset: area.within.offset}}; }
        }
        s = s + 1;
    }
    var i: usize = 0;
    for (i < f.instructions.len) {
        val d: *InstructionData = ?f.instructions.data[i];
        var n: usize            = 0;
        for (n < d.operands.size) {
            val named: u32 = slot_of(?d.operands.data[n]);
            if (named::usize < w.rep.len) { d.operands.data[n] = Operand.slot{w.rep.data[named::usize]}; }
            n = n + 1;
        }
        if (metadata.states_extent(?d.metadata) && d.metadata.extent.slot::usize < w.rep.len) { d.metadata.extent.slot = w.rep.data[d.metadata.extent.slot::usize]; }
        i = i + 1;
    }
    var p: usize = 0;
    for (p < f.points.len) {
        val reads: Reading = f.points.data[p].reads;
        if (sel reads.slot) {
            if (reads.slot::usize < w.rep.len) { f.points.data[p].reads = Reading.slot{w.rep.data[reads.slot::usize]}; }
        }
        p = p + 1;
    }
}

fun shared(a: *allocator.Allocator, w: *Work, f: *Function) err[allocator.Error] {
    val err_found: err[allocator.Error] = addressed.reaches(a, f, ?w.escaped, ?w.reached);
    if (sel err_found.err) { ret err_found; }
    var err_failed: err[allocator.Error] = slice.fill[u32](?w.index, f.slots.len, NONE);
    keep(?err_failed, slice.fill[u32](?w.rep, f.slots.len, 0));
    keep(?err_failed, slice.fill[bool](?w.scoped, f.slots.len, false));
    keep(?err_failed, names(w, f));
    if (sel err_failed.err) { ret err_failed; }
    var s: usize = 0;
    for (s < f.slots.len) {
        val area: function.Area = f.slots.data[s].area;
        if (sel area.within) {
            if (area.within.slot::usize < w.escaped.len) { w.escaped.data[area.within.slot::usize] = true; }
        }
        s = s + 1;
    }
    var i: usize = 0;
    for (i < f.instructions.len) {
        val d: *InstructionData = ?f.instructions.data[i];
        if (marker(d)) {
            val o: Operand = d.operands.data[0];
            if (sel o.slot) {
                if (o.slot::usize < w.scoped.len && o.slot::usize < w.escaped.len) { w.scoped.data[o.slot::usize] = w.escaped.data[o.slot::usize]; }
            }
        }
        i = i + 1;
    }
    s = 0;
    for (s < f.slots.len) {
        w.rep.data[s] = s::u32;
        if (candidate(w, ?f.slots.data[s], s)) {
            w.index.data[s] = w.slots.len::u32;
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.slots, s::u32);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        s = s + 1;
    }
    val m: u32 = w.slots.len::u32;
    if (m < 2) { ret err[allocator.Error].ok{}; }
    val err_indexed: err[allocator.Error] = index_reaches(w, f.instructions.len);
    if (sel err_indexed.err) { ret err_indexed; }
    val words:     usize                = ((m + 63) / 64)::usize;
    val blocks:    usize                = f.blocks.len;
    var err_sized: err[allocator.Error] = slice.fill[u32](?w.seen, m::usize, 0);
    keep(?err_sized, slice.fill[u32](?w.genned, m::usize, 0));
    keep(?err_sized, slice.fill[u32](?w.marked, m::usize, 0));
    keep(?err_sized, slice.fill[bool](?w.begins, m::usize, false));
    keep(?err_sized, slice.fill[u32](?w.place, m::usize, 0));
    keep(?err_sized, slice.fill[u64](?w.meets, m::usize * words, 0));
    keep(?err_sized, slice.fill[u64](?w.groups, m::usize * words, 0));
    keep(?err_sized, slice.fill[u32](?w.group, m::usize, 0));
    keep(?err_sized, flow.rows(?w.gen));
    keep(?err_sized, flow.rows(?w.kill));
    keep(?err_sized, flow.rows(?w.opens));
    keep(?err_sized, flow.rows(?w.marks));
    var b: usize = 0;
    for (!(sel err_sized.err) && b < blocks) {
        keep(?err_sized, transfer(w, f, b::u32));
        b = b + 1;
    }
    if (sel err_sized.err) { ret err_sized; }
    val res_graph: res[Graph, allocator.Error] = function.graph_of(f);
    if (sel res_graph.err) { ret err[allocator.Error].err{res_graph.err}; }
    var g: Graph = res_graph.ok;
    fin { graph.dnit(?g); }
    var err_solved: err[allocator.Error] = flow.backward(?w.flow, ?g, flow.Problem{facts: m, gen: ?w.gen, kill: ?w.kill}, ?w.live_in, ?w.live_out);
    keep(?err_solved, flow.forward(?w.flow, ?g, flow.Problem{facts: m, gen: ?w.opens, kill: ?w.marks}, nil, ?w.begun));
    b = 0;
    for (!(sel err_solved.err) && b < blocks) {
        keep(?err_solved, interfere(w, f, b::u32, words));
        b = b + 1;
    }
    if (sel err_solved.err) { ret err_solved; }
    val entry: Slice[u32] = flow.row(?w.live_in, graph.entry(?g));
    var x:     usize      = 0;
    for (x < entry.size) {
        var y: usize = 0;
        for (y < entry.size) {
            meet(w, words, entry.data[x], entry.data[y]);
            y = y + 1;
        }
        x = x + 1;
    }
    val err_coloured: err[allocator.Error] = colour(w, f, m, words);
    if (sel err_coloured.err) { ret err_coloured; }
    rename(w, f);
    ret err[allocator.Error].ok{};
}

# share the frame slots of an allocated function whose contents are never
# live at once, as the module header says
# ---
# a:     the allocator the sharing works in
# f:     the allocated function, every virtual register replaced by its
#        location, whose slots and operands are rewritten in place
# lists: the module's lists of public byte ranges, which its slots' statements
#        name by id
# out:   filled with the slots that share another's storage, ascending, which
#        nothing names any more and the frame lays out none of
# ret:   why there was no storage, the function then left as it was
pub fun share(a: *allocator.Allocator, f: *Function, lists: Slice[Slice[global.Range]], out: *vector.Vector[Slot]) err[allocator.Error] {
    vector.clear[Slot](out);
    var w: Work = work_init(a, lists);
    fin { work_dnit(?w); }
    val err_shared: err[allocator.Error] = shared(a, ?w, f);
    if (sel err_shared.err) { ret err_shared; }
    var s: usize = 0;
    for (s < w.rep.len) {
        if (w.rep.data[s] != s::u32) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Slot](out, s::u32);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        s = s + 1;
    }
    ret err[allocator.Error].ok{};
}
