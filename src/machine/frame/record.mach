# what a frame states: where each slot is, which registers it saves where,
# and the call frame facts of its prologue and epilogues
#
# an offset is bytes fixed plus bytes per unit of the multiplier of one scale
# of the register file, the shape of masc's scaled widths, so a slot of
# scaled size and every slot past it have an offset scaled at run time. the
# call frame facts are data shaped for masc's cfi calls: a register is named
# by masc's identity and masc numbers it from its own rows.

use std.types.bool.bool;
use std.types.error.err;

use std.allocator;
use std.collections.vector;

use mirl.fail.keep;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.function.SlotData;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Slot;

use rf: masc.core.register;

# bytes fixed plus bytes per unit of the multiplier of a scale
# ---
# fixed: the bytes no scale changes
# per:   the bytes for each unit of the multiplier, 0 when none scales
# scale: the scale of the register file, read only when per is nonzero
pub rec Offset {
    fixed: i64;
    per:   i64;
    scale: u8;
}

# an offset of fixed bytes
pub fun bytes(n: i64) Offset {
    ret Offset{fixed: n, per: 0, scale: 0};
}

# the size of a slot as an offset
pub fun size_of(s: SlotData) Offset {
    ret Offset{fixed: s.size::i64, per: s.per::i64, scale: s.scale};
}

# the register an address is taken from
# ---
# stack: the stack pointer, after the prologue
# frame: the frame pointer
pub tag Base: u8 {
    stack;
    frame;
}

# where a slot is
# ---
# base:   the register its address is taken from
# offset: added to that register
pub rec Address {
    base:   Base;
    offset: Offset;
}

# where a slot of the function is
# ---
# dropped: nothing names it, so it has no place in the frame
# at:      its address
pub tag Place: u8 {
    dropped;
    at: Address;
}

# a register the frame saves
# ---
# register: the register
# slot:     the slot it is saved in
# offset:   where that slot is, from the canonical frame address
pub rec Save {
    register: rf.Id;
    slot:     Slot;
    offset:   Offset;
}

# the canonical frame address as a register plus an offset
# ---
# register: the register
# offset:   added to it
pub rec Cfa {
    register: rf.Id;
    offset:   Offset;
}

# a register saved at an offset from the canonical frame address
# ---
# register: the register
# offset:   where it is saved
pub rec Saved {
    register: rf.Id;
    offset:   Offset;
}

# one call frame rule, each one of masc's cfi calls
# ---
# cfa:      the canonical frame address is now this, .cfi_def_cfa
# saved:    a register is saved here, .cfi_offset
# restored: a register holds its value at the call again, .cfi_restore
# remember: the rules are kept, .cfi_remember_state
# restore:  the rules kept last are the rules again, .cfi_restore_state
pub tag Rule: u8 {
    cfa:      Cfa;
    saved:    Saved;
    restored: rf.Id;
    remember;
    restore;
}

# a rule at a point of the function
# ---
# at:    the instruction it is placed beside
# after: whether it follows that instruction, else it comes before it
# rule:  the rule
pub rec Fact {
    at:    Instruction;
    after: bool;
    rule:  Rule;
}

# the layout of a frame
# ---
# entry:    the bytes from the canonical frame address to the stack pointer at
#           entry, the return address a call pushed
# size:     the bytes from the canonical frame address to the stack pointer
#           after the prologue, 0 for a frame in the red zone
# outgoing: the bytes at the stack pointer reserved for the stack arguments
#           and shadow space of the function's calls
# red:      the bytes below the stack pointer the frame takes in the red zone,
#           the stack pointer never moving
# stack:    the stack pointer
# pointer:  the frame pointer when the frame keeps one, pointing at the
#           canonical frame address plus `at`, masc's no register when not
# at:       where the frame pointer points, from the canonical frame address
# realign:  the alignment the prologue realigns the stack pointer to, 0 for none
# slots:    where each slot of the framed function is
# saves:    the registers it saves, in the order the prologue saves them
pub rec Layout {
    entry:    u64;
    size:     Offset;
    outgoing: u64;
    red:      u64;
    stack:    rf.Id;
    pointer:  rf.Id;
    at:       i64;
    realign:  u64;
    slots:    vector.Vector[Place];
    saves:    vector.Vector[Save];
}

# the register an address of a layout is taken from
pub fun base_of(l: *Layout, a: Address) rf.Id {
    if (sel a.base.frame) { ret l.pointer; }
    ret l.stack;
}

# a framed function
# ---
# function: the function, its prologue and epilogues written, its dynamic
#           allocations expanded and a slot made for each register it saves
# layout:   its frame
# facts:    the call frame rules of its prologue and epilogues
# origins:  each instruction's instruction of the input, NONE for one the
#           frame wrote
pub rec Framed {
    function: Function;
    layout:   Layout;
    facts:    vector.Vector[Fact];
    origins:  vector.Vector[u32];
}

# no instruction of the input
pub val NONE: u32 = 0xffffffff;

# give back a layout's storage
pub fun release_layout(l: *Layout) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[Place](?l.slots);
    keep(?failed, vector.dnit[Save](?l.saves));
    ret failed;
}

# give back a framed function's storage
pub fun release(x: *Framed) err[allocator.Error] {
    var failed: err[allocator.Error] = function.dnit(?x.function);
    keep(?failed, release_layout(?x.layout));
    keep(?failed, vector.dnit[Fact](?x.facts));
    keep(?failed, vector.dnit[u32](?x.origins));
    ret failed;
}
