# the layout of a frame, read from the convention row and masc's rows
#
# a downward stack, from the canonical frame address down:
# - the return address a call pushed, where the row says a call pushes it
# - the saved registers: the frame record at the offsets the row states when
#   the frame keeps its pointer, then every other callee-saved register the
#   function writes, each at its own slot of the width the row keeps it at,
#   then the fixed emergency slots of a frame that keeps its pointer and
#   reserves them
# - the scaled area: the slots whose size scales, each at an offset per unit
#   of the scale's multiplier, the area's size per unit a multiple of the
#   stack's alignment so every multiplier keeps it: the saves, then the
#   emergency slots of a kind that scales, then the local slots
# - the local slots, largest alignment first, below them the fixed emergency
#   slots of a frame that keeps no pointer and reserves them
# - the outgoing area at the stack pointer: the largest stack argument of any
#   call, and at least the row's shadow space when there is a call, in fixed
#   bytes and, where a call passes a stack piece of scaled size or at an
#   offset that scales, bytes per unit too. its scaled part is its own move of
#   the stack pointer, after the fixed parts' in the prologue and before them
#   in each epilogue
#
# a call's stack pieces are addressed from the stack pointer at the call: a
# fixed piece at its fixed offset, and a scaled one at its offset's fixed
# bytes plus its bytes per unit, the convention placing every scaled piece
# past the fixed ones. the outgoing area's fixed bytes are the most any
# piece's fixed part reaches and its bytes per unit the most any scaled part
# reaches, rounded to the stack's alignment, so every piece of every call
# lies within it and every slot above it sits that many bytes per unit
# further from the stack pointer
# every part is rounded so the stack pointer keeps the row's alignment at each
# call. a leaf that keeps no frame pointer and fits the row's red zone takes it
# and never moves the stack pointer. incoming stack arguments are at the
# canonical frame address plus their offsets.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.id;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.alloc.spill;
use mirl.machine.class;
use mirl.machine.class.Physical;
use mirl.machine.constraint.Constrained;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Address;
use mirl.machine.frame.record.Base;
use mirl.machine.frame.record.Emergency;
use mirl.machine.frame.record.Layout;
use mirl.machine.frame.record.Offset;
use mirl.machine.frame.record.Place;
use mirl.machine.frame.record.Save;
use mirl.machine.frame.scan;
use mirl.machine.frame.scan.Facts;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.function.SlotData;
use mirl.machine.instruction;
use mirl.machine.operand.Slot;
use mirl.machine.storage;
use mirl.machine.storage.Storage;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Frame;
use mirl.target.abi.convention.Keeper;
use mirl.target.abi.convention.Kept;
use mirl.target.abi.convention.Linked;
use mirl.target.abi.convention.Page;
use mirl.target.abi.convention.Part;
use mirl.target.abi.convention.Probe;
use mirl.target.abi.convention.Prologue;
use mirl.target.abi.convention.Record;
use mirl.target.abi.convention.Registers;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Stack;
use mirl.target.abi.convention.Unwind;
use mirl.target.abi.convention.held;

use rf: masc.core.register;
use mink.model.frame;

# what the frame reads beside the function
# ---
# convention: the target's convention row resolved against its selection
# at:         the locations of the target
# helper:     the module's symbol for the routine the row's prologue calls to
#             probe, none where it calls none or the module declares none
# naked:      the function states `naked`, so its body is laid as written
pub rec Request {
    convention: *Resolved;
    at:         *Locations;
    helper:     opt[id.Symbol];
    naked:      bool;
}

# why a frame was not laid out
# ---
# alloc:     the allocator refused storage
# foreign:   the convention's register file is not the function's
# stackless: the row has no stack in memory and the function needs one
# stack:     the row homes its stack pointer in no register
# unlocated: a register the frame reads that the locations refused, and why
# pointer:   the frame needs a frame pointer and the row has none
# taken:     the allocation took the frame pointer the frame keeps, or an
#            inline block's footprint writes it
# base:      a realigned frame that also allocates dynamically, which needs a
#            base register the row does not state
# record:    the row's record saves the return address away from where a call
#            pushes it
# outgoing:  an outgoing slot in a function that makes no call
# slot:      a slot of both fixed and scaled size, or a scaled one aligned past
#            the stack's alignment
# scales:    slots scaled by more than one scale
# storage:   a register to save whose storage is no slot's size
# reach:     a frame larger than an offset holds
# undecided: an instruction whose transfer or touched turns on an operand that
#            names no register
# ungrouped: an instruction whose grouping is refused, and why
# naked:     a naked function that needs a slot, which it has no frame for
# probe:     a frame the row's prologue probes that moves its stack pointer
#            past a page with no helper routine the module declares, or by a
#            scaled or dynamic amount, which the frame writes no probe for
#            yet, or whose saves alone move past a page where the prologue
#            moves them apart from the locals
# unwind:    a frame that moves or saves under a row whose unwind encoding
#            states only a shape the frame does not keep: under windows'
#            unwind codes a frame with a scaled area or a frame pointer set
#            more than 240 bytes above the stack pointer, under windows'
#            arm64 unwind codes a frame with a scaled area or a frame pointer
#            set more than 2040 bytes above the stack pointer or at no
#            multiple of 8, and under compact unwind a frame whose record is
#            not its first pair saved
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    stackless;
    stack;
    unlocated: location.Unlocated;
    pointer;
    taken: rf.Id;
    base;
    record;
    outgoing: Slot;
    slot:     Slot;
    scales;
    storage: rf.Id;
    reach;
    undecided: instruction.Undecided;
    ungrouped: Constrained;
    naked;
    probe;
    unwind;
}

# the emergency slots of one kind a frame reserves
# ---
# like:  a register of the kind, whose storage sizes each slot
# count: how many
pub rec Bank {
    like:  rf.Id;
    count: u32;
}

# a register to save and where
# ---
# register: the register
# slot:     its slot among the slots the frame adds, from 0
# depth:    for a fixed slot, the bytes from the canonical frame address down
#           to it, and for a scaled one its bytes per unit below the saves
# scaled:   whether it is in the scaled area
# width:    the bytes of it an unwinder restores from a fixed slot, as mink's
#           frame records state a save's width
pub rec Spot {
    register: rf.Id;
    slot:     u32;
    depth:    u64;
    scaled:   bool;
    width:    u16;
}

# a laid out frame and what writing it needs
# ---
# layout:    the layout, over the function's slots and then the added ones
# added:     the slots the frame adds, one per saved register, then its
#            emergency slots
# spots:     where each saved register goes, in the order the prologue saves
# facts:     what the function's instructions show
# empty:     the frame moves nothing and saves nothing
# top:       the bytes from the canonical frame address to the bottom of the
#            saved registers, a multiple of the stack's alignment
# per:       the scaled area's bytes per unit, a multiple of the alignment
# out:       the scaled outgoing area's bytes per unit, a multiple of the
#            alignment, at the bottom of the frame
# scale:     its scale
# locals:    the bytes of the local slots and the outgoing area
# scratches: the registers the prologue and epilogues may overwrite, in the
#            order the frame code is offered them
# align:     the stack's alignment at a call
# unwound:   whether the frame states call frame rules, which a row whose
#            code no unwinder walks leaves out
# bounded:   whether those rules state the prologue alone, its end marked,
#            and no epilogue, as windows' unwind codes, which state no rule
#            past the prologue
# paired:    whether the prologue and epilogues move two adjacent saves of
#            one size in one instruction where the frame code has one
# probe:     the helper routine the prologue calls to probe the pages its
#            move of the stack pointer takes, the one move or, where it moves
#            apart, the locals' move, none where it probes none
# apart:     whether the prologue moves the stack pointer for the saves and
#            then for the locals, the row's prologue's
pub rec Plan {
    layout:    Layout;
    added:     vector.Vector[SlotData];
    spots:     vector.Vector[Spot];
    facts:     Facts;
    empty:     bool;
    top:       u64;
    per:       u64;
    out:       u64;
    scale:     u8;
    locals:    u64;
    scratches: vector.Vector[rf.Id];
    align:     u64;
    unwound:   bool;
    bounded:   bool;
    paired:    bool;
    probe:     opt[id.Symbol];
    apart:     bool;
}

# give back a plan's storage
pub fun release(p: *Plan) err[allocator.Error] {
    var failed: err[allocator.Error] = record.release_layout(?p.layout);
    keep(?failed, vector.dnit[SlotData](?p.added));
    keep(?failed, vector.dnit[Spot](?p.spots));
    keep(?failed, scan.release(?p.facts));
    keep(?failed, vector.dnit[rf.Id](?p.scratches));
    ret failed;
}

fun up(v: u64, to: u64) u64 {
    if (to <= 1) { ret v; }
    ret (v + to - 1) / to * to;
}

fun alloc_err(e: allocator.Error) Error {
    ret Error.alloc{e};
}

# the register the row homes its stack pointer in, none for a row with no
# registers or one that homes it elsewhere
fun stack_pointer(r: *Resolved) opt[rf.Id] {
    val regs: *Registers = held(r);
    if (regs == nil) { ret opt[rf.Id].none{}; }
    ret regs.stack;
}

fun listed(s: Slice[rf.Id], reg: rf.Id) bool {
    var i: usize = 0;
    for (i < s.size) {
        if (s.data[i] == reg) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun named_opt(o: opt[rf.Id], reg: rf.Id) bool {
    ret sel o.some && o.some == reg;
}

# the registers the prologue and epilogues may overwrite: those calls clobber
# of a class that holds values as the stack pointer does (`class.addresses`)
# that carry no argument, result, indirect address, variadic count or return
# address, in the order the convention lists its clobbers
fun scratches_of(r: *Registers, stack: rf.Id, out: *vector.Vector[rf.Id]) err[Error] {
    var i: usize = 0;
    for (i < r.clobbered.size) {
        val c: rf.Id = r.clobbered.data[i];
        if (class.addresses(r.context.view.file, stack, rf.class_of(c)) && !listed(r.passing.registers, c) && !listed(r.returning.registers, c)) {
            if (!named_opt(r.carrier, c) && !named_opt(r.returned, c) && !named_opt(r.count, c) && !named_opt(r.link, c)) {
                val pushed: res[usize, allocator.Error] = vector.push[rf.Id](out, c);
                if (sel pushed.err) { ret err[Error].err{alloc_err(pushed.err)}; }
            }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun written(x: *Facts, at: *Locations, reg: rf.Id) res[bool, Error] {
    val row: res[u32, location.Unlocated] = location.locate(at, Physical.register{reg});
    if (sel row.err) { ret res[bool, Error].err{Error.unlocated{row.err}}; }
    ret res[bool, Error].ok{x.written.data[row.ok]};
}

fun scan_err(e: scan.Error) Error {
    if (sel e.alloc)     { ret Error.alloc{e.alloc}; }
    or (sel e.undecided) { ret Error.undecided{e.undecided}; }
    or (sel e.ungrouped) { ret Error.ungrouped{e.ungrouped}; }
    ret Error.unlocated{e.unlocated};
}

# a slot's order in its area: largest alignment first, then by number
rec Ordered {
    align: u64;
    index: u32;
}

fun by_align(a: *Ordered, b: *Ordered) i64 {
    if (a.align > b.align) { ret -1; }
    if (a.align < b.align) { ret 1; }
    if (a.index < b.index) { ret -1; }
    if (a.index > b.index) { ret 1; }
    ret 0;
}

# whether a frame is one the frame keeps a pointer for, which the
# allocator's allowed set must then leave the pointer out of: the row keeps
# it always, or the function allocates dynamically, moves its stack pointer,
# has a local slot aligned past the stack's alignment, or under a row whose
# call stack is unwound may have a slot that scales
# ---
# a:   the allocator the scan takes
# f:   the function
# r:   the convention and locations
# ret: whether it keeps one, or why the scan was refused
pub fun keeps_pointer(a: *allocator.Allocator, f: *Function, r: Request) res[bool, Error] {
    val row: *Resolved = r.convention;
    if (!(sel row.row.stack.memory)) { ret res[bool, Error].ok{false}; }
    val frame: Frame = row.row.stack.memory;
    if (!(sel frame.pointer.register)) { ret res[bool, Error].ok{false}; }
    if (r.naked)                       { ret res[bool, Error].ok{false}; }
    if (frame.pointer.register.always) { ret res[bool, Error].ok{true}; }
    val sp: opt[rf.Id] = stack_pointer(row);
    if (sel sp.none) { ret res[bool, Error].err{Error.stack{}}; }
    val stack: res[u32, location.Unlocated] = location.locate(r.at, Physical.register{sp.some});
    if (sel stack.err) { ret res[bool, Error].err{Error.unlocated{stack.err}}; }
    val got: res[Facts, scan.Error] = scan.scan(a, f, held(row).context, r.at, stack.ok, Slice[u32]{data: nil, size: 0});
    if (sel got.err) { ret res[bool, Error].err{scan_err(got.err)}; }
    var x: Facts = got.ok;
    fin { scan.release(?x); }
    ret res[bool, Error].ok{needs_pointer(?x, f, frame, held(row).context.view)};
}

# whether the stack pointer alone cannot address the frame, or a frame whose
# call stack is unwound would move it by an amount that scales, which no
# canonical frame address rule mirl states can follow
fun needs_pointer(x: *Facts, f: *Function, frame: Frame, view: *rf.Available) bool {
    if (x.dynamic || x.moves || realigns(f, frame.align)) { ret true; }
    if (sel frame.prologue.unwind.none)                   { ret false; }
    ret scales(f, view);
}

# whether a function may have a slot that scales: one of its own, or a
# virtual register of a class whose spill slot scales
fun scales(f: *Function, view: *rf.Available) bool {
    var i: usize = 0;
    for (i < f.slots.len) {
        val s: SlotData = f.slots.data[i];
        if (s.per != 0) { ret true; }
        if (sel s.area.outgoing) {
            if (s.area.outgoing.per != 0) { ret true; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < f.virtuals.len) {
        val slot: opt[SlotData] = spill.group_slot(view, f.virtuals.data[i], 1);
        if (sel slot.some) {
            if (slot.some.per != 0) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

fun realigns(f: *Function, align: u64) bool {
    var i: usize = 0;
    for (i < f.slots.len) {
        val s: SlotData = f.slots.data[i];
        if (sel s.area.local && s.per == 0 && s.align > align) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a register saved in a slot of the frame's own, at the width its row keeps it
fun push_spot(p: *Plan, regs: *rf.Available, row: *Convention, reg: rf.Id) err[Error] {
    val got: res[SlotData, Error] = kept_slot(regs, row, reg);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val s:    SlotData                    = got.ok;
    val slot: u32                         = p.added.len::u32;
    val a:    res[usize, allocator.Error] = vector.push[SlotData](?p.added, s);
    if (sel a.err) { ret err[Error].err{alloc_err(a.err)}; }
    val spot: Spot                        = Spot{register: reg, slot: slot, depth: 0, scaled: s.per != 0, width: unwound(row, reg, s)};
    val b:    res[usize, allocator.Error] = vector.push[Spot](?p.spots, spot);
    if (sel b.err) { ret err[Error].err{alloc_err(b.err)}; }
    ret err[Error].ok{};
}

# the slot a register is saved in: the low part a row keeps of a preserved
# register narrower than the register through the selection, as aapcs64's d8
# of v8, so the frame code moves it at that width, and all of it otherwise
fun kept_slot(regs: *rf.Available, row: *Convention, reg: rf.Id) res[SlotData, Error] {
    val whole: res[SlotData, Error] = save_slot(regs, reg);
    if (sel whole.err) { ret whole; }
    val k: opt[Kept] = convention.kept_of(row, reg);
    if (sel k.none) { ret whole; }
    val part: Part = k.some.bits;
    if (!(sel part.low)) { ret whole; }
    val low: u64 = part.low::u64;
    if (low % 8 != 0)                                  { ret res[SlotData, Error].err{Error.storage{reg}}; }
    if (whole.ok.per == 0 && low >= whole.ok.size * 8) { ret whole; }
    ret res[SlotData, Error].ok{spill.slot_of(Storage{fixed: low, per: 0, scale: 0})};
}

# the width an unwinder restores of a register saved in a fixed slot, as
# mink's frame records state it: frame.NATURAL where the slot holds the part
# the architecture's own convention keeps, and the slot's bytes where the row
# keeps more. a scaled save's rule states no width
fun unwound(row: *Convention, reg: rf.Id, s: SlotData) u16 {
    val k: opt[Kept] = convention.kept_of(row, reg);
    if (sel k.none)                        { ret frame.NATURAL; }
    if (k.some.natural == 0 || s.per != 0) { ret frame.NATURAL; }
    if (s.size * 8 == k.some.natural::u64) { ret frame.NATURAL; }
    ret s.size::u16;
}

fun save_slot(regs: *rf.Available, reg: rf.Id) res[SlotData, Error] {
    val row: opt[*rf.Register] = rf.row_of(regs.file, reg);
    if (sel row.none) { ret res[SlotData, Error].err{Error.storage{reg}}; }
    val st: opt[Storage] = storage.of_register(regs, row.some);
    if (sel st.none) { ret res[SlotData, Error].err{Error.storage{reg}}; }
    val s: SlotData = spill.slot_of(st.some);
    if (s.per != 0 && s.size != 0) { ret res[SlotData, Error].err{Error.storage{reg}}; }
    ret res[SlotData, Error].ok{s};
}

fun to_i(v: u64) res[i64, Error] {
    if (v > 0x7fff_ffff_ffff_ffff) { ret res[i64, Error].err{Error.reach{}}; }
    ret res[i64, Error].ok{v::i64};
}

fun place(base: Base, fixed: i64, per: i64, scale: u8) Place {
    ret Place.at{Address{base: base, offset: Offset{fixed: fixed, per: per, scale: scale}}};
}

fun empty_plan(a: *allocator.Allocator, stack: rf.Id) Plan {
    ret Plan{
        layout:    Layout{entry: 0, size: record.bytes(0), outgoing: 0, red: 0, stack: stack, pointer: rf.NONE, at: 0, realign: 0, slots: vector.init[Place](a), saves: vector.init[Save](a), reserved: vector.init[Emergency](a)},
        added:     vector.init[SlotData](a),
        spots:     vector.init[Spot](a),
        facts:     Facts{calls: false, dynamic: false, moves: false, written: vector.init[bool](a), named: vector.init[bool](a), exits: vector.init[bool](a)},
        empty:     true,
        top:       0,
        per:       0,
        out:       0,
        scale:     0,
        locals:    0,
        scratches: vector.init[rf.Id](a),
        align:     1,
        unwound:   false,
        bounded:   false,
        paired:    false,
        probe:     opt[id.Symbol].none{},
        apart:     false,
    };
}

# empty a plan's layout, saves and fields for its frame to be laid out again,
# keeping its facts and scratches
fun relay(p: *Plan) {
    vector.clear[Place](?p.layout.slots);
    vector.clear[Save](?p.layout.saves);
    vector.clear[Emergency](?p.layout.reserved);
    vector.clear[SlotData](?p.added);
    vector.clear[Spot](?p.spots);
    p.layout  = Layout{entry: 0, size: record.bytes(0), outgoing: 0, red: 0, stack: p.layout.stack, pointer: rf.NONE, at: 0, realign: 0, slots: p.layout.slots, saves: p.layout.saves, reserved: p.layout.reserved};
    p.empty   = true;
    p.top     = 0;
    p.per     = 0;
    p.out     = 0;
    p.scale   = 0;
    p.locals  = 0;
    p.align   = 1;
    p.unwound = false;
    p.bounded = false;
    p.paired  = false;
    p.probe   = opt[id.Symbol].none{};
    p.apart   = false;
}

# lay out the frame of an allocated function
# ---
# a:       the allocator the plan takes
# f:       the function, every operand a location
# used:    the locations its allocation assigned
# r:       the convention and locations
# reserve: the emergency slots the frame reserves, by kind, each holding one
#          register of its kind
# ret:     the plan, or why the frame was refused
pub fun lay(a: *allocator.Allocator, f: *Function, used: Slice[u32], r: Request, reserve: Slice[Bank]) res[Plan, Error] {
    val conv: *Resolved  = r.convention;
    val regs: *Registers = held(conv);
    if (regs == nil || regs.context.view.file != function.file(f) || r.at.file != function.file(f)) { ret res[Plan, Error].err{Error.foreign{}}; }
    val st: Stack = conv.row.stack;
    # a resolved row states its stack, so a stack not in memory is none
    if (!(sel st.memory)) {
        if (f.slots.len != 0) { ret res[Plan, Error].err{Error.stackless{}}; }
        ret res[Plan, Error].ok{empty_plan(a, rf.NONE)};
    }
    val sp: opt[rf.Id] = stack_pointer(conv);
    if (sel sp.none) { ret res[Plan, Error].err{Error.stack{}}; }
    val stack_row: res[u32, location.Unlocated] = location.locate(r.at, Physical.register{sp.some});
    if (sel stack_row.err) { ret res[Plan, Error].err{Error.unlocated{stack_row.err}}; }
    var p:   Plan                   = empty_plan(a, sp.some);
    val got: res[Facts, scan.Error] = scan.scan(a, f, regs.context, r.at, stack_row.ok, used);
    if (sel got.err) {
        release(?p);
        ret res[Plan, Error].err{scan_err(got.err)};
    }
    scan.release(?p.facts);
    p.facts = got.ok;
    # a naked function's body is its frame, so it is laid out as one that moves and saves nothing
    if (r.naked) {
        if (f.slots.len == 0) { ret res[Plan, Error].ok{p}; }
        release(?p);
        ret res[Plan, Error].err{Error.naked{}};
    }
    val listed_scratch: err[Error] = scratches_of(regs, sp.some, ?p.scratches);
    if (sel listed_scratch.err) {
        release(?p);
        ret res[Plan, Error].err{listed_scratch.err};
    }
    # a frame whose prologue calls the probe routine for its locals and did
    # not save the link register is laid out again saving it, as any call
    # writes it
    var laid: res[bool, Error] = layout(a, f, conv, regs, st.memory, r.at, r.helper, false, reserve, ?p);
    if (sel laid.ok && laid.ok) {
        relay(?p);
        laid = layout(a, f, conv, regs, st.memory, r.at, r.helper, true, reserve, ?p);
    }
    if (sel laid.err) {
        release(?p);
        ret res[Plan, Error].err{laid.err};
    }
    ret res[Plan, Error].ok{p};
}

# whether a frame's record is its first pair saved, the shape compact unwind
# states: the frame pointer and the register saved beside it, the link, at
# adjacent slots above every other save, so the frame pointer points at the
# record and the other saves lie below it, which the object format states
# compactly where they fit its encoding and by call frame information
# otherwise
fun record_first(p: *Plan) bool {
    if (p.layout.pointer == rf.NONE || p.spots.len < 2) { ret false; }
    val a: Spot = p.spots.data[0];
    val b: Spot = p.spots.data[1];
    if (a.register != p.layout.pointer || a.scaled || b.scaled) { ret false; }
    var low:  u64 = a.depth;
    var high: u64 = b.depth;
    if (low > high) {
        low  = b.depth;
        high = a.depth;
    }
    if (high - low != p.added.data[a.slot].size) { ret false; }
    var k: usize = 2;
    for (k < p.spots.len) {
        val s: Spot = p.spots.data[k];
        if (!s.scaled && s.depth <= high) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether an encoding states a pair saved together only with its lower
# numbered register at the lower address, as windows' arm64 codes do
# (`stp x19, x20`, `stp d8, d9`)
fun rising(u: Unwind) bool {
    ret sel u.seh_arm64;
}

# each pair of fixed saves the prologue stores together, as the frame writes
# them two by two in save order, laid with its lower numbered register at the
# lower address, the record's two left where the row puts them
fun rise(p: *Plan, file: *rf.File, linked: bool, fp: rf.Id, link: rf.Id) {
    var k: usize = 0;
    for (k + 1 < p.spots.len) {
        val a: *Spot = ?p.spots.data[k];
        val b: *Spot = ?p.spots.data[k + 1];
        if (!together(p, file, linked, fp, link, a, b)) {
            k = k + 1;
            cnt;
        }
        val ra:   opt[*rf.Register] = rf.row_of(file, a.register);
        val rb:   opt[*rf.Register] = rf.row_of(file, b.register);
        var low:  *Spot             = a;
        var high: *Spot             = b;
        if (sel ra.some) {
            if (sel rb.some) {
                if (rb.some.number < ra.some.number) {
                    low  = b;
                    high = a;
                }
            }
        }
        if (low.depth < high.depth) {
            val d: u64 = low.depth;
            low.depth  = high.depth;
            high.depth = d;
        }
        k = k + 2;
    }
}

# whether two adjacent saves are a pair the frame may store together: both
# fixed, of one class and one size at adjacent slots, neither of the record
fun together(p: *Plan, file: *rf.File, linked: bool, fp: rf.Id, link: rf.Id, a: *Spot, b: *Spot) bool {
    if (a.scaled || b.scaled)                                                                         { ret false; }
    if (linked && (a.register == fp || a.register == link || b.register == fp || b.register == link)) { ret false; }
    if (rf.class_of(a.register) != rf.class_of(b.register))                                           { ret false; }
    val ra: opt[*rf.Register] = rf.row_of(file, a.register);
    val rb: opt[*rf.Register] = rf.row_of(file, b.register);
    if (sel ra.none || sel rb.none) { ret false; }
    val size: u64 = p.added.data[a.slot].size;
    if (p.added.data[b.slot].size != size || p.added.data[a.slot].per != 0 || p.added.data[b.slot].per != 0) { ret false; }
    ret a.depth + size == b.depth || b.depth + size == a.depth;
}

# whether the frame keeps the row's prologue shape, and whether it states
# call frame rules
# ---
# prologue: the row's prologue shape
# p:        the plan, its saves, scaled area, locals and emptiness laid out
# x:        what the function's instructions show
# red:      whether the frame is in the red zone, its stack pointer never moving
# kept:     whether the frame keeps its pointer
# moved:    the fixed bytes the prologue moves the stack pointer by otherwise
# helper:   the module's symbol for the row's probe routine
#
# a frame moving past a page under a row that probes through a routine calls
# it for that one move, or where the prologue moves apart for the locals'
# move, the saves' own never past a page. windows' unwind codes state one
# fixed allocation, the saves at offsets from the stack pointer below it and
# a frame pointer set at most 240 bytes above it, a multiple of 16, which the
# one move, the saves and the frame pointer set at the bottom of the saves
# meet while the locals take no more. windows' arm64 unwind codes state the
# frame pointer set at most 2040 bytes above the stack pointer, a multiple of
# 8 ("arm64 exception handling", add_fp), which a frame moving apart meets
# where its saves take no more
fun keeps_shape(prologue: Prologue, p: *Plan, x: *Facts, red: bool, kept: bool, moved: u64, helper: opt[id.Symbol]) err[Error] {
    p.apart = prologue.apart;
    var probed: u64 = moved;
    if (p.apart) { probed = p.locals; }
    val probe: Probe = prologue.probe;
    if (sel probe.page) {
        val scaled: bool = p.per != 0 || p.out != 0;
        if (!p.empty && !red && (scaled || x.dynamic || probed > probe.page.bytes)) {
            if (sel probe.page.helper.none || scaled || x.dynamic) { ret err[Error].err{Error.probe{}}; }
            if (sel helper.none)                                   { ret err[Error].err{Error.probe{}}; }
            p.probe = helper;
        }
        if (!p.empty && !red && p.apart && p.top - p.layout.entry > probe.page.bytes) { ret err[Error].err{Error.probe{}}; }
    }
    p.paired = prologue.pair_saves;
    val unwind: Unwind = prologue.unwind;
    if (sel unwind.compact && !p.empty && !record_first(p)) { ret err[Error].err{Error.unwind{}}; }
    if (sel unwind.seh && !p.empty) {
        if (p.per != 0 || p.out != 0)                       { ret err[Error].err{Error.unwind{}}; }
        if (kept && (p.locals > 240 || p.locals % 16 != 0)) { ret err[Error].err{Error.unwind{}}; }
    }
    if (sel unwind.seh_arm64 && !p.empty) {
        if (p.per != 0 || p.out != 0) { ret err[Error].err{Error.unwind{}}; }
        if (kept) {
            var above: i64 = (p.top + p.locals)::i64;
            if (p.apart) { above = p.top::i64; }
            val set: i64 = above + p.layout.at;
            if (set < 0 || set > 2040 || set % 8 != 0) { ret err[Error].err{Error.unwind{}}; }
        }
    }
    p.unwound = !(sel unwind.none);
    p.bounded = sel unwind.seh || sel unwind.seh_arm64;
    ret err[Error].ok{};
}

# whether a prologue moving apart calls its probe routine for the locals'
# move of this many bytes
fun calls_for_locals(prologue: Prologue, locals: u64) bool {
    val probe: Probe = prologue.probe;
    if (!prologue.apart) { ret false; }
    if (sel probe.page) {
        val page: Page = probe.page;
        ret sel page.helper.some && locals > page.bytes;
    }
    ret false;
}

# lay out a frame, or say it must be laid out again saving the link register,
# true, where the prologue calls the probe routine for the locals' move and
# `relink` did not ask the link saved. its `reserve` emergency slots of a
# fixed size go where the frame code reaches them at a fixed offset: below
# the saves off the frame pointer in a frame that keeps one, and at the
# bottom of the locals, just above the outgoing area, off the stack pointer
# otherwise. those of a kind that scales go in the scaled area below its
# saves
fun layout(a: *allocator.Allocator, f: *Function, conv: *Resolved, regs: *Registers, frame: Frame, at: *Locations, helper: opt[id.Symbol], relink: bool, reserve: Slice[Bank], p: *Plan) res[bool, Error] {
    val x:    *Facts = ?p.facts;
    var word: u64    = 0;
    if (sel conv.row.word.bits) { word = conv.row.word.bits::u64 / 8; }
    val align: u64 = frame.align;
    var entry: u64 = 0;
    if (sel frame.link.stack) { entry = word; }
    p.layout.entry = entry;
    p.align        = align;

    # the frame pointer
    val realign: bool = realigns(f, align);
    val needs:   bool = needs_pointer(x, f, frame, regs.context.view);
    var kept:    bool = false;
    var keeper:  Keeper;
    if (sel frame.pointer.register) {
        keeper = frame.pointer.register;
        kept   = keeper.always || needs;
    }
    or (needs)                { ret res[bool, Error].err{Error.pointer{}}; }
    if (realign && x.dynamic) { ret res[bool, Error].err{Error.base{}}; }
    var fp: rf.Id = rf.NONE;
    if (kept) {
        if (sel regs.pointer.none) { ret res[bool, Error].err{Error.pointer{}}; }
        fp = regs.pointer.some;
        val taken: res[bool, Error] = written(x, at, fp);
        if (sel taken.err) { ret res[bool, Error].err{taken.err}; }
        if (taken.ok)      { ret res[bool, Error].err{Error.taken{fp}}; }
        p.layout.pointer = fp;
    }
    var linked: bool   = false;
    var chain:  Linked;
    val shape:  Record = keeper.record;
    if (sel shape.linked) {
        linked = kept;
        chain  = shape.linked;
    }

    # the registers to save: the record first, then the others by identity
    var link: rf.Id = rf.NONE;
    if (sel regs.link.some) { link = regs.link.some; }
    var save_link: bool = false;
    if (link != rf.NONE) {
        val wrote: res[bool, Error] = written(x, at, link);
        if (sel wrote.err) { ret res[bool, Error].err{wrote.err}; }
        save_link = wrote.ok || linked || relink;
    }
    if (linked && sel frame.link.stack && chain.link != 0 - word::i64) { ret res[bool, Error].err{Error.record{}}; }
    if (kept) {
        val pushed: err[Error] = push_spot(p, regs.context.view, conv.row, fp);
        if (sel pushed.err) { ret res[bool, Error].err{pushed.err}; }
    }
    if (save_link) {
        val pushed: err[Error] = push_spot(p, regs.context.view, conv.row, link);
        if (sel pushed.err) { ret res[bool, Error].err{pushed.err}; }
    }
    var i: usize = 0;
    for (i < regs.preserved.size) {
        val reg:  rf.Id = regs.preserved.data[i];
        var save: bool  = false;
        if (reg != p.layout.stack && reg != fp) {
            val wrote: res[bool, Error] = written(x, at, reg);
            if (sel wrote.err) { ret res[bool, Error].err{wrote.err}; }
            save = wrote.ok;
        }
        if (save) {
            val pushed: err[Error] = push_spot(p, regs.context.view, conv.row, reg);
            if (sel pushed.err) { ret res[bool, Error].err{pushed.err}; }
        }
        i = i + 1;
    }
    # the emergency slots, each kind's in turn, and the register of each one's kind
    val spare_at: u32                  = p.added.len::u32;
    var likes:    vector.Vector[rf.Id] = vector.init[rf.Id](a);
    fin { vector.dnit[rf.Id](?likes); }
    var b: usize = 0;
    for (b < reserve.size) {
        val bank: Bank                 = reserve.data[b];
        val s:    res[SlotData, Error] = save_slot(regs.context.view, bank.like);
        if (sel s.err)                           { ret res[bool, Error].err{s.err}; }
        if (s.ok.per != 0 && s.ok.align > align) { ret res[bool, Error].err{Error.storage{bank.like}}; }
        var j: u32 = 0;
        for (j < bank.count) {
            val pushed: res[usize, allocator.Error] = vector.push[SlotData](?p.added, s.ok);
            if (sel pushed.err) { ret res[bool, Error].err{alloc_err(pushed.err)}; }
            val liked: res[usize, allocator.Error] = vector.push[rf.Id](?likes, bank.like);
            if (sel liked.err) { ret res[bool, Error].err{alloc_err(liked.err)}; }
            j = j + 1;
        }
        b = b + 1;
    }
    var spares: vector.Vector[u64] = vector.init[u64](a);
    fin { vector.dnit[u64](?spares); }
    val zeroed: err[allocator.Error] = slice.fill[u64](?spares, likes.len, 0);
    if (sel zeroed.err) { ret res[bool, Error].err{alloc_err(zeroed.err)}; }

    # the saved registers' depths
    var cursor: u64   = entry;
    var k:      usize = 0;
    for (k < p.spots.len) {
        val sp:   *Spot    = ?p.spots.data[k];
        val slot: SlotData = p.added.data[sp.slot];
        if (!sp.scaled) {
            var fixed_at: bool = false;
            if (linked) {
                if (sp.register == fp) {
                    sp.depth = (0 - chain.previous)::u64;
                    fixed_at = true;
                }
                or (sp.register == link) {
                    sp.depth = (0 - chain.link)::u64;
                    fixed_at = true;
                }
            }
            if (!fixed_at)         { sp.depth = up(cursor + slot.size, slot.align); }
            if (sp.depth > cursor) { cursor = sp.depth; }
        }
        k = k + 1;
    }
    if (frame.prologue.pair_saves && rising(frame.prologue.unwind)) { rise(p, regs.context.view.file, linked, fp, link); }
    if (linked && sel frame.link.stack && cursor < word)            { cursor = word; }
    if (kept) {
        var j: usize = 0;
        for (j < spares.len) {
            val s: SlotData = p.added.data[spare_at::usize + j];
            if (s.per == 0) {
                cursor         = up(cursor + s.size, s.align);
                spares.data[j] = cursor;
            }
            j = j + 1;
        }
    }

    # the scaled area: saves, then local slots
    var have_scale: bool = false;
    var scale:      u8   = 0;
    var per_cursor: u64  = 0;
    k = 0;
    for (k < p.spots.len) {
        val sp:   *Spot    = ?p.spots.data[k];
        val slot: SlotData = p.added.data[sp.slot];
        if (sp.scaled) {
            if (have_scale && slot.scale != scale) { ret res[bool, Error].err{Error.scales{}}; }
            have_scale = true;
            scale      = slot.scale;
            sp.depth   = up(per_cursor + slot.per, slot.align);
            per_cursor = sp.depth;
        }
        k = k + 1;
    }
    k = 0;
    for (k < spares.len) {
        val s: SlotData = p.added.data[spare_at::usize + k];
        if (s.per != 0) {
            if (have_scale && s.scale != scale) { ret res[bool, Error].err{Error.scales{}}; }
            have_scale     = true;
            scale          = s.scale;
            spares.data[k] = up(per_cursor + s.per, s.align);
            per_cursor     = spares.data[k];
        }
        k = k + 1;
    }
    var order: vector.Vector[Ordered] = vector.init[Ordered](a);
    fin { vector.dnit[Ordered](?order); }
    var outgoing: u64 = 0;
    var out_per:  u64 = 0;
    i = 0;
    for (i < f.slots.len) {
        val s: SlotData = f.slots.data[i];
        if (s.per != 0 && (s.size != 0 || s.align > align)) { ret res[bool, Error].err{Error.slot{Slot{index: i::u32}}}; }
        if (sel s.area.outgoing) {
            if (!x.calls) { ret res[bool, Error].err{Error.outgoing{Slot{index: i::u32}}}; }
            if (s.per != 0 || s.area.outgoing.per != 0) {
                if (have_scale && s.scale != scale) { ret res[bool, Error].err{Error.scales{}}; }
                have_scale = true;
                scale      = s.scale;
                if (s.area.outgoing.per + s.per > out_per) { out_per = s.area.outgoing.per + s.per; }
            }
            if (s.area.outgoing.fixed + s.size > outgoing) { outgoing = s.area.outgoing.fixed + s.size; }
        }
        if (sel s.area.local && x.named.data[i]) {
            val pushed: res[usize, allocator.Error] = vector.push[Ordered](?order, Ordered{align: s.align, index: i::u32});
            if (sel pushed.err) { ret res[bool, Error].err{alloc_err(pushed.err)}; }
        }
        i = i + 1;
    }
    if (x.calls && frame.shadow > outgoing) { outgoing = frame.shadow; }
    if (order.len > 1)                      { sort.sort_by[Ordered](order.data, order.len, by_align); }
    var depths: vector.Vector[u64] = vector.init[u64](a);
    fin { vector.dnit[u64](?depths); }
    val filled: err[allocator.Error] = slice.fill[u64](?depths, f.slots.len, 0);
    if (sel filled.err) { ret res[bool, Error].err{alloc_err(filled.err)}; }
    var local_cursor: u64 = outgoing;
    var widest:       u64 = 1;
    if (!kept) {
        var j: usize = 0;
        for (j < spares.len) {
            val s: SlotData = p.added.data[spare_at::usize + j];
            if (s.per == 0) {
                spares.data[j] = up(local_cursor, s.align);
                local_cursor   = spares.data[j] + s.size;
            }
            j = j + 1;
        }
    }
    k = 0;
    for (k < order.len) {
        val n: u32      = order.data[k].index;
        val s: SlotData = f.slots.data[n];
        if (s.per != 0) {
            if (have_scale && s.scale != scale) { ret res[bool, Error].err{Error.scales{}}; }
            have_scale     = true;
            scale          = s.scale;
            depths.data[n] = up(per_cursor + s.per, s.align);
            per_cursor     = depths.data[n];
        }
        or {
            depths.data[n] = up(local_cursor, s.align);
            local_cursor   = depths.data[n] + s.size;
            if (s.align > widest) { widest = s.align; }
        }
        k = k + 1;
    }
    val per:    u64 = up(per_cursor, align);
    val out:    u64 = up(out_per, align);
    val locals: u64 = up(local_cursor, align);
    if (link != rf.NONE && !save_link && calls_for_locals(frame.prologue, locals)) { ret res[bool, Error].ok{true}; }

    # the whole frame
    val saving: bool = p.spots.len > 0;
    val empty:  bool = !saving && locals == 0 && per == 0 && out == 0 && !kept && !x.dynamic && (!x.calls || entry % align == 0);
    var top:    u64  = entry;
    if (!empty) { top = up(cursor, align); }
    p.empty           = empty;
    p.top             = top;
    p.per             = per;
    p.out             = out;
    p.scale           = scale;
    p.locals          = locals;
    p.layout.outgoing = outgoing;
    if (kept && realign) { p.layout.realign = widest; }
    var pointer_at: i64 = 0;
    if (kept) {
        if (linked) { pointer_at = chain.pointer; }
        or {
            val t: res[i64, Error] = to_i(top);
            if (sel t.err) { ret res[bool, Error].err{t.err}; }
            pointer_at = 0 - t.ok;
        }
    }
    p.layout.at = pointer_at;
    val total_u: u64             = top + locals;
    val tt:      res[i64, Error] = to_i(total_u);
    if (sel tt.err) { ret res[bool, Error].err{tt.err}; }
    val total:  i64        = tt.ok;
    val top_i:  i64        = top::i64;
    val per_i:  i64        = per::i64;
    val out_i:  i64        = out::i64;
    val whole:  i64        = per_i + out_i;
    val red:    bool       = !empty && !x.calls && !kept && !x.dynamic && per == 0 && out == 0 && total_u - entry <= frame.red;
    val shaped: err[Error] = keeps_shape(frame.prologue, p, x, red, kept, total_u - entry, helper);
    if (sel shaped.err) { ret res[bool, Error].err{shaped.err}; }
    var shift: i64 = 0;
    if (red) {
        shift         = total - entry::i64;
        p.layout.red  = total_u - entry;
        p.layout.size = record.bytes(entry::i64);
    }
    or (empty) { p.layout.size = record.bytes(entry::i64); }
    or         { p.layout.size = Offset{fixed: total, per: whole, scale: scale}; }

    # every slot's address
    val room: res[usize, allocator.Error] = vector.reserve[Place](?p.layout.slots, f.slots.len + p.added.len);
    if (sel room.err) { ret res[bool, Error].err{alloc_err(room.err)}; }
    i = 0;
    for (i < f.slots.len) {
        val s:   SlotData = f.slots.data[i];
        var at_: Place    = Place.dropped{};
        if (sel s.area.outgoing) { at_ = place(Base.stack{}, s.area.outgoing.fixed::i64 - shift, s.area.outgoing.per::i64, scale); }
        or (sel s.area.incoming) {
            # an incoming offset that scales is by the slot's scale, which is the frame's when the frame scales
            val in_per:   i64 = s.area.incoming.per::i64;
            var in_scale: u8  = scale;
            if (in_per != 0 && per != 0 && s.scale != scale) { ret res[bool, Error].err{Error.scales{}}; }
            if (per == 0 && in_per != 0)                     { in_scale = s.scale; }
            if (kept)                                        { at_ = place(Base.frame{}, s.area.incoming.fixed::i64 - pointer_at, in_per, in_scale); }
            or                                               { at_ = place(Base.stack{}, total + s.area.incoming.fixed::i64 - shift, whole + in_per, in_scale); }
        }
        or (x.named.data[i]) {
            val d: i64 = depths.data[i]::i64;
            if (s.per != 0) {
                if (kept) { at_ = place(Base.frame{}, 0 - top_i - pointer_at, 0 - d, scale); }
                or        { at_ = place(Base.stack{}, locals::i64, whole - d, scale); }
            }
            or (kept && !realign) { at_ = place(Base.frame{}, d - total - pointer_at, 0 - per_i, scale); }
            or                    { at_ = place(Base.stack{}, d - shift, out_i, scale); }
        }
        vector.push[Place](?p.layout.slots, at_);
        i = i + 1;
    }
    k = 0;
    for (k < p.spots.len) {
        val sp:  Spot = p.spots.data[k];
        val d:   i64  = sp.depth::i64;
        var at_: Place;
        var cfa: Offset;
        if (sp.scaled) {
            cfa = Offset{fixed: 0 - top_i, per: 0 - d, scale: scale};
            if (kept) { at_ = place(Base.frame{}, 0 - top_i - pointer_at, 0 - d, scale); }
            or        { at_ = place(Base.stack{}, locals::i64, whole - d, scale); }
        }
        or {
            cfa = record.bytes(0 - d);
            if (kept) { at_ = place(Base.frame{}, 0 - d - pointer_at, 0, 0); }
            or        { at_ = place(Base.stack{}, total - d - shift, whole, scale); }
        }
        vector.push[Place](?p.layout.slots, at_);
        val pushed: res[usize, allocator.Error] = vector.push[Save](?p.layout.saves, Save{register: sp.register, slot: Slot{index: (f.slots.len + sp.slot::usize)::u32}, offset: cfa, width: sp.width});
        if (sel pushed.err) { ret res[bool, Error].err{alloc_err(pushed.err)}; }
        k = k + 1;
    }
    k = 0;
    for (k < spares.len) {
        val s:   SlotData = p.added.data[spare_at::usize + k];
        val d:   i64      = spares.data[k]::i64;
        var at_: Place;
        if (s.per != 0) {
            if (kept) { at_ = place(Base.frame{}, 0 - top_i - pointer_at, 0 - d, scale); }
            or        { at_ = place(Base.stack{}, locals::i64, whole - d, scale); }
        }
        or (kept) { at_ = place(Base.frame{}, 0 - d - pointer_at, 0, 0); }
        or        { at_ = place(Base.stack{}, d - shift, out_i, scale); }
        vector.push[Place](?p.layout.slots, at_);
        val pushed: res[usize, allocator.Error] = vector.push[Emergency](?p.layout.reserved, Emergency{slot: Slot{index: (f.slots.len + spare_at::usize + k)::u32}, size: record.size_of(s), like: likes.data[k]});
        if (sel pushed.err) { ret res[bool, Error].err{alloc_err(pushed.err)}; }
        k = k + 1;
    }
    ret res[bool, Error].ok{false};
}
