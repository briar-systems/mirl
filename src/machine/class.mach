# register classes and the locations an allocator assigns
#
# a class is a class row of masc's register file, read and never restated, or
# a memory-backed class a target supplies, whose locations in memory a machine
# with few registers names as registers. every api taking a class takes
# either, and an allocator assigns a location of either kind.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;

use rf: masc.core.register;

# a class row of a register file
# ---
# file:  the register file
# index: the class's row in the file
pub rec Hardware {
    file:  *rf.File;
    index: u16;
}

# a class of memory locations a target names as registers
# ---
# width: the bits of each location
# count: how many locations it has, numbered 0 to count - 1
pub rec Memory {
    width: u32;
    count: u32;
}

# a class an operand or a virtual register is of
# ---
# hardware: a class row of masc's register file
# memory:   a memory-backed class, one static row of its target
pub tag Class: u8 {
    hardware: Hardware;
    memory:   *Memory;
}

# one location of a memory-backed class
# ---
# class:  the class
# number: its number within the class
pub rec Cell {
    class:  *Memory;
    number: u32;
}

# a location an allocator assigns
# ---
# register: a register by masc's identity
# cell:     a location of a memory-backed class
pub tag Physical: u8 {
    register: rf.Id;
    cell:     Cell;
}

# the class of row `index` of `file`
pub fun hardware(file: *rf.File, index: u16) Class {
    ret Class.hardware{Hardware{file: file, index: index}};
}

# whether two classes are the same class
pub fun same(a: Class, b: Class) bool {
    if (sel a.hardware) {
        ret sel b.hardware && (b.hardware.file == a.hardware.file && b.hardware.index == a.hardware.index);
    }
    ret sel b.memory && b.memory == a.memory;
}

# whether a class names a row its file has, or a memory-backed class
pub fun valid(c: Class) bool {
    if (sel c.hardware) { ret c.hardware.file != nil && c.hardware.index::u32 < c.hardware.file.class_count; }
    ret c.memory != nil;
}

# the bits of each member, scaled as masc states a class row's width
pub fun width(c: Class) rf.Scaled {
    if (sel c.hardware) { ret c.hardware.file.classes[c.hardware.index].width; }
    ret rf.Scaled{fixed: c.memory.width, per: 0, scale: 0};
}

# how many members a class's numbering spans
pub fun count(c: Class) u32 {
    if (sel c.hardware) { ret c.hardware.file.classes[c.hardware.index].count; }
    ret c.memory.count;
}

# whether a location is a member of a class
pub fun holds(c: Class, p: Physical) bool {
    if (sel c.hardware) {
        if (!(sel p.register))                                                    { ret false; }
        if (p.register == rf.NONE || rf.class_of(p.register) != c.hardware.index) { ret false; }
        val row: opt[*rf.Register] = rf.row_of(c.hardware.file, p.register);
        ret sel row.some;
    }
    ret sel p.cell && (p.cell.class == c.memory && p.cell.number < c.memory.count);
}

# the class a location is a member of, reading a register's class from `file`
pub fun of(file: *rf.File, p: Physical) opt[Class] {
    if (sel p.cell) {
        if (p.cell.class == nil || p.cell.number >= p.cell.class.count) { ret opt[Class].none{}; }
        ret opt[Class].some{Class.memory{p.cell.class}};
    }
    if (file == nil) { ret opt[Class].none{}; }
    val row: opt[*rf.Register] = rf.row_of(file, p.register);
    if (sel row.none) { ret opt[Class].none{}; }
    ret opt[Class].some{hardware(file, row.some.class)};
}

# whether two locations are the same location
pub fun same_physical(a: Physical, b: Physical) bool {
    if (sel a.register) { ret sel b.register && b.register == a.register; }
    ret sel b.cell && (b.cell.class == a.cell.class && b.cell.number == a.cell.number);
}

# the storage a value takes in memory, as bits fixed plus bits per unit of
# the multiplier of one scale that the selection leaves to the implementation,
# the shape of masc's scaled widths
# ---
# fixed: the bits no scale changes
# per:   the bits for each unit of the multiplier, 0 when none scales
# scale: the scale of the register file, read only when per is nonzero
pub rec Storage {
    fixed: u64;
    per:   u64;
    scale: u8;
}

# the multiplier a selection fixes for a scale, 0 when it leaves it open
fun multiplier(regs: *rf.Available, scale: u8) u64 {
    if (regs.multipliers == nil || scale::u32 >= regs.file.scale_count) { ret 0; }
    ret regs.multipliers[scale]::u64;
}

# a scaled quantity through a selection, its fixed part with every fixed
# scale folded in
fun through(regs: *rf.Available, q: rf.Scaled) Storage {
    if (q.per == 0) { ret Storage{fixed: q.fixed::u64, per: 0, scale: 0}; }
    val m: u64 = multiplier(regs, q.scale);
    if (m != 0) { ret Storage{fixed: q.fixed::u64 + q.per::u64 * m, per: 0, scale: 0}; }
    ret Storage{fixed: q.fixed::u64, per: q.per::u64, scale: q.scale};
}

# the storage of a register row through a selection: its class's width times
# its pieces, none when both scale with the implementation, which no fixed
# part plus a part per unit states
pub fun register_storage(regs: *rf.Available, row: *rf.Register) opt[Storage] {
    val w: Storage = through(regs, regs.file.classes[row.class].width);
    val n: Storage = through(regs, row.count);
    if (n.per == 0) { ret opt[Storage].some{Storage{fixed: w.fixed * n.fixed, per: w.per * n.fixed, scale: w.scale}}; }
    if (w.per == 0) { ret opt[Storage].some{Storage{fixed: w.fixed * n.fixed, per: w.fixed * n.per, scale: n.scale}}; }
    ret opt[Storage].none{};
}

# the storage any location of a class may need through a selection: the
# widest of its rows, whose storages are the class's width times their
# pieces, none when a row's storage is none
pub fun storage(regs: *rf.Available, c: Class) opt[Storage] {
    if (sel c.memory) { ret opt[Storage].some{Storage{fixed: c.memory.width::u64, per: 0, scale: 0}}; }
    val file: *rf.File = c.hardware.file;
    var most: Storage  = through(regs, file.classes[c.hardware.index].width);
    var i:    u32      = 0;
    for (i < file.register_count) {
        val row: *rf.Register = ?file.registers[i];
        if (row.class == c.hardware.index) {
            val s: opt[Storage] = register_storage(regs, row);
            if (sel s.none)                                         { ret s; }
            if (s.some.fixed > most.fixed || s.some.per > most.per) { most = s.some; }
        }
        i = i + 1;
    }
    ret opt[Storage].some{most};
}

# the hardware class of a class row of `file` given by the handle masc publishes for it
pub fun handled(file: *rf.File, c: *rf.Class) opt[Class] {
    if (file == nil || c == nil || file.class_count == 0 || c:~u64 < file.classes:~u64) { ret opt[Class].none{}; }
    val bytes: u64 = c:~u64 - file.classes:~u64;
    if (bytes % $size_of(rf.Class)::u64 != 0) { ret opt[Class].none{}; }
    val at: u64 = bytes / $size_of(rf.Class)::u64;
    if (at >= file.class_count::u64) { ret opt[Class].none{}; }
    ret opt[Class].some{hardware(file, at::u16)};
}
