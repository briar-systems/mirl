# machine blocks: a list of instructions in order
#
# before block layout every successor of a block is a block operand of one of
# its instructions, so a conditional branch is followed by a jump and layout
# removes a jump to the block after it.

use std.collections.vector;

use mirl.machine.operand.Instruction;

# one block
# ---
# instructions: the instructions placed in it, in order
pub rec BlockData {
    instructions: vector.Vector[Instruction];
}
