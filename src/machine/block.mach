# machine blocks: a list of instructions in order
#
# before block layout every successor of a block is a block operand of one of
# its instructions, so a conditional branch is followed by a jump, or by the
# rest of its block as a jump table's bounds check is, and layout removes a
# jump to the block after it. a jump table names the targets of the indirect
# jump before it as its block operands.

use std.collections.vector;

use mirl.machine.operand.Instruction;

# one block
# ---
# instructions: the instructions placed in it, in order
pub rec BlockData {
    instructions: vector.Vector[Instruction];
}
