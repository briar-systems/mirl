# tests of compilation, ir text in and mink's object out, on the risc-v rows

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mink.model.object;
use mink.model.reloc;
use mink.store;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.machine.compile;
use mirl.pass.driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine;
use mirl.target.machine.Machine;

# arithmetic, a branch on it and a call to a function another module defines
#[testing]
val MODULE: str = "target \"riscv64-linux\"\nfunction @callee: fun(i64) -> ()\nexport function @f: fun(i64, i64) -> (i64) {\n^entry(%x: i64, %y: i64):\n    %a = add %x, %y\n    %b = mul %a, %x\n    %c = lt.s %b, %y\n    cbr %c, ^small, ^large\n^small:\n    call ptr @callee, %b, signature fun(i64) -> (), named all\n    ret %a\n^large:\n    ret %b\n}\n";

# the index of the object's symbol named, -1 when it has none
#[testing]
fun index_of(o: *object.Object, name: str) i64 {
    var i: usize = 0;
    for (i < o.symbols.count) {
        val n: View = object.name_of(o, o.symbols.items[i].name);
        if (n.len == str_len(name)) {
            var k: usize = 0;
            for (k < n.len && n.data[k] == name[k]) {
                k = k + 1;
            }
            if (k == n.len) { ret i::i64; }
        }
        i = i + 1;
    }
    ret -1;
}

# an ir text function with arithmetic, a branch and a call compiles to an
# object of one text section that defines it at the start and calls the
# function it declares through a relocation
test compile__an_ir_text_function_compiles_to_an_object {
    var a: allocator.Allocator;
    page.make(?a);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: MODULE, len: str_len(MODULE)});
    if (sel read.err) { ret 1; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(module.target(?m));
    if (sel row.none) { ret 2; }
    val t:   *Target    = row.some;
    val ran: err[Error] = driver.run(?m, t, Options{level: 0, checked: true});
    if (sel ran.err) { ret 3; }
    var mach:   Machine;
    val opened: err[machine.Error] = machine.open(?mach, ?a, t);
    if (sel opened.err) { ret 4; }
    fin { machine.close(?mach); }

    val made: res[object.Object, compile.Error] = compile.compile(?a, ?m, ?mach, t);
    if (sel made.err) { ret 5; }
    var o: object.Object = made.ok;
    fin { object.release(?o); }

    if (o.sections.count != 1) { ret 6; }
    val text:  *object.Section = ?o.sections.items[0];
    val bytes: store.Bytes     = object.bytes(?o, ?text.contents);
    if (bytes.len == 0 || bytes.len % 2 != 0) { ret 7; }

    val f: i64 = index_of(?o, "f");
    if (f < 0) { ret 8; }
    val defined: object.Definition = o.symbols.items[f].def;
    if (!(sel defined.placed) || defined.placed.offset != 0) { ret 9; }
    val callee: i64 = index_of(?o, "callee");
    if (callee < 0) { ret 10; }
    val outside: object.Definition = o.symbols.items[callee].def;
    if (sel outside.placed) { ret 11; }

    # the call is the one relocation pair, naming the callee, and the branch resolves within the section
    if (o.relocs.count != 2)                           { ret 12; }
    if (o.relocs.items[0].kind != ?reloc.CALL_PLT_PAIR) { ret 13; }
    if (o.relocs.items[1].kind != ?reloc.RELAX)         { ret 14; }
    val named: object.Target = o.relocs.items[0].target;
    if (!(sel named.symbol) || named.symbol.index::i64 != callee) { ret 15; }
    if (o.relocs.items[0].offset::usize >= bytes.len)                           { ret 16; }
    ret 0;
}
