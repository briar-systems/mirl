# tests of compilation, ir text in and mink's object out, on the risc-v rows

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.model.object;
use mink.model.reloc;
use mink.store;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.machine.compile;
use mirl.machine.corpus;
use ir_corpus: mirl.pass.corpus;
use mirl.pass.driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.basis;
use mirl.target.build.Build;
use register: mirl.target.register.family;
use mirl.target.register.machine;

# arithmetic, a branch on it and a call to a function another module defines,
# with no parameters, results or arguments, so selection places no copy
#[testing]
val MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @callee: fun() -> () linkage global visibility default\nexport function @f: fun() -> () linkage global visibility default {\n^entry:\n    %a = add i64 5, i64 7\n    %b = mul %a, %a\n    %c = lt.s %b, i64 100\n    cbr %c, ^small, ^large\n^small:\n    call ptr @callee, signature fun() -> (), named all\n    ret\n^large:\n    ret\n}\n";

# parameters, a call argument, the call's result and the function's own, each
# a copy selection places and the lowering turns into the set's moves
#[testing]
val COPIES: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @callee: fun(i64) -> (i64) linkage global visibility default\nexport function @f: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %s = add %x, %y\n    %r = call ptr @callee, %s, signature fun(i64) -> (i64), named all\n    %t = add %r, %x\n    ret %t\n}\n";

# the index of the object's symbol named, -1 when it has none
#[testing]
fun index_of(o: *object.Object, name: str) i64 {
    var i: usize = 0;
    for (i < o.symbols.count) {
        val n: View = object.name_of(o, o.symbols.items[i].name);
        if (n.len == str_len(name)) {
            var k: usize = 0;
            for (k < n.len && n.data[k] == name[k]) {
                k = k + 1;
            }
            if (k == n.len) { ret i::i64; }
        }
        i = i + 1;
    }
    ret -1;
}

# compile a module of one function @f calling @callee, 0 or the step that failed
#[testing]
fun compiles(text: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: text, len: str_len(text)});
    if (sel read.err) { ret 1; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.row_of(module.target(?m));
    if (sel row.none) { ret 2; }
    val t:      *Target          = row.some;
    var b:      Build;
    val opened: err[basis.Error] = machine.open(?b, ?a, t, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 4; }
    fin { machine.close(?b); }
    # the schedule and compile read the one build
    val ran: err[Error] = driver.drive_family(?m, t, ?b, register.FAMILY.legal, Options{level: 0, checked: true});
    if (sel ran.err) { ret 3; }

    val made: res[object.Object, compile.Error] = compile.compile(?a, ?m, ?b, t, compile.Options{checked: true, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}});
    if (sel made.err) { ret 5; }
    var o: object.Object = made.ok;
    fin { object.release(?o); }

    if (o.sections.count != 1) { ret 6; }
    val text:  *object.Section = ?o.sections.items[0];
    val bytes: store.Bytes     = object.bytes(?o, ?text.contents);
    if (bytes.len == 0 || bytes.len % 2 != 0) { ret 7; }

    val f: i64 = index_of(?o, "f");
    if (f < 0) { ret 8; }
    val defined: object.Definition = o.symbols.items[f].def;
    if (!(sel defined.placed))      { ret 9; }
    if (defined.placed.offset != 0) { ret 9; }
    val callee: i64 = index_of(?o, "callee");
    if (callee < 0) { ret 10; }
    val outside: object.Definition = o.symbols.items[callee].def;
    if (sel outside.placed) { ret 11; }

    # the call is the one relocation pair, naming the callee, and the branch resolves within the section
    if (o.relocs.count != 2)                            { ret 12; }
    if (o.relocs.items[0].kind != ?reloc.CALL_PLT_PAIR) { ret 13; }
    if (o.relocs.items[1].kind != ?reloc.RELAX)         { ret 14; }
    val named: object.Target = o.relocs.items[0].target;
    if (!(sel named.symbol))                          { ret 15; }
    if (named.symbol.index::i64 != callee)            { ret 15; }
    if (o.relocs.items[0].offset::usize >= bytes.len) { ret 16; }
    ret 0;
}

# an ir text function with arithmetic, a branch and a call compiles to an
# object of one text section that defines it at the start and calls the
# function it declares through a relocation, and so does one whose
# parameters, argument and results are copies
test compile__an_ir_text_function_compiles_to_an_object {
    val plain: i32 = compiles(MODULE);
    if (plain != 0) { ret plain; }
    val copies: i32 = compiles(COPIES);
    if (copies != 0) { ret 100 + copies; }
    ret 0;
}

# a build opened for another target than the one compiled for is refused
# before anything is compiled
test compile__refuses_a_build_opened_for_another_target {
    var a: allocator.Allocator;
    page.make(?a);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: MODULE, len: str_len(MODULE)});
    if (sel read.err) { ret 1; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.row_of(module.target(?m));
    if (sel row.none) { ret 2; }
    var other: opt[*Target] = opt[*Target].none{};
    var i:     usize        = 0;
    for (i < targets.rows() && sel other.none) {
        val r: opt[*Target] = targets.row(i);
        if (sel r.some) {
            if (r.some != row.some && machine.stated(r.some)) { other = r; }
        }
        i = i + 1;
    }
    if (sel other.none) { ret 3; }
    var b:      Build;
    val opened: err[basis.Error] = machine.open(?b, ?a, other.some, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 4; }
    fin { machine.close(?b); }
    val made: res[object.Object, compile.Error] = compile.compile(?a, ?m, ?b, row.some, compile.Options{checked: true, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}});
    if (sel made.ok) {
        var o: object.Object = made.ok;
        object.release(?o);
        ret 5;
    }
    val why: compile.Error = made.err;
    if (!(sel why.foreign)) { ret 6; }
    ret 0;
}

#[testing]
var COUNTED: usize = 0;

# a step that leaves the function as it found it and counts its runs
#[testing]
fun counts(c: *compile.Context, w: *compile.Work) res[compile.Form, compile.Stage] {
    COUNTED = COUNTED + 1;
    ret res[compile.Form, compile.Stage].ok{w.form};
}

# a step added to the sequence runs in the machine corpus walk, once for the
# one function with a body at every level, with no edit to the walk
test compile__a_step_added_to_the_sequence_runs_in_the_corpus_walk {
    var a: allocator.Allocator;
    page.make(?a);
    var steps: vector.Vector[compile.Step] = vector.init[compile.Step](?a);
    fin { vector.dnit[compile.Step](?steps); }
    val stated: Slice[compile.Step] = compile.stages();
    var i:      usize               = 0;
    for (i < stated.size) {
        val pushed: res[usize, allocator.Error] = vector.push[compile.Step](?steps, stated.data[i]);
        if (sel pushed.err) { ret 1; }
        i = i + 1;
    }
    val added: res[usize, allocator.Error] = vector.push[compile.Step](?steps, compile.Step{name: "counted", run: counts});
    if (sel added.err) { ret 1; }
    var lefts: vector.Vector[corpus.Left] = vector.init[corpus.Left](?a);
    fin { vector.dnit[corpus.Left](?lefts); }
    var tally: usize = 0;
    val code:  u32   = corpus.machine_levels(?a, View{data: MODULE, len: str_len(MODULE)}, "a counted step", ?tally, ?lefts, Slice[compile.Step]{data: steps.data, size: steps.len});
    if (code != 0)                             { ret 2; }
    if (tally != (ir_corpus.TOP + 1)::usize)   { ret 3; }
    if (COUNTED != (ir_corpus.TOP + 1)::usize) { ret 4; }
    ret 0;
}
