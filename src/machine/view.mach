# the graph view of a machine function
#
# a node per block, numbered as the blocks are, the first block the entry, and
# an edge for every block operand of every instruction placed in a block. the
# analyses of mirl.ir.cfg read it unchanged.

use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Edge;
use mirl.ir.cfg.graph.Graph;
use mirl.machine.block.BlockData;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;

# the graph of a function's blocks, valid until its blocks next change
# ---
# a:            the allocator the graph takes
# blocks:       the function's blocks
# instructions: the function's instructions
# ret:          its graph, or the allocator's refusal
pub fun of(a: *allocator.Allocator, blocks: Slice[BlockData], instructions: Slice[InstructionData]) res[Graph, allocator.Error] {
    var edges: vector.Vector[Edge] = vector.init[Edge](a);
    fin { vector.dnit[Edge](?edges); }
    var k: usize = 0;
    for (k < blocks.size) {
        val list: *vector.Vector[Instruction] = ?blocks.data[k].instructions;
        var i:    usize                       = 0;
        for (i < list.len) {
            val d: *InstructionData = ?instructions.data[list.data[i].index];
            var o: usize            = 0;
            for (o < d.operands.size) {
                val op: Operand = d.operands.data[o];
                if (sel op.block) {
                    val pushed: res[usize, allocator.Error] = vector.push[Edge](?edges, Edge{from: k::u32, to: op.block.index});
                    if (sel pushed.err) { ret res[Graph, allocator.Error].err{pushed.err}; }
                }
                o = o + 1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    ret graph.init(a, blocks.size::u32, 0, Slice[Edge]{data: edges.data, size: edges.len});
}
