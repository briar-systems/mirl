# how a block's instructions leave it, read from their rows' control
#
# a jump to a block is an instruction whose row jumps directly and whose
# target operand is a block. whether it is conditional is the row's or the
# rule its operands meet, so nothing here names an opcode.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand.Block;
use mirl.machine.operand.Operand;

use masc.core.effect;
use mset: masc.core.set;

# a jump to a block
# ---
# at:          the operand position that names the block
# block:       the block
# conditional: it jumps only when a condition holds, else control falls to
#              the next instruction
pub rec Exit {
    at:          u32;
    block:       Block;
    conditional: bool;
}

# how an instruction jumps to a block, none when it does not
pub fun exit_of(s: *mset.Set, d: *InstructionData) opt[Exit] {
    val c: effect.Control = instruction.transfer(instruction.file_of(s), d);
    if (c.transfer != effect.JUMP || c.target != effect.DIRECT) { ret opt[Exit].none{}; }
    if (c.operand::usize >= d.operands.size)                    { ret opt[Exit].none{}; }
    val target: Operand = d.operands.data[c.operand];
    if (!(sel target.block)) { ret opt[Exit].none{}; }
    ret opt[Exit].some{Exit{at: c.operand::u32, block: target.block, conditional: c.conditional}};
}

# whether an instruction ends in a trap, which control never leaves
pub fun traps(s: *mset.Set, d: *InstructionData) bool {
    ret instruction.transfer(instruction.file_of(s), d).transfer == effect.TRAP;
}
