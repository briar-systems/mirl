# how a block's instructions leave it, read from their rows' control
#
# a jump to a block is an instruction whose row jumps directly and whose
# target operand is a block. whether it is conditional is the row's or the
# rule its operands meet, so nothing here names an opcode. a rule that tests
# an operand naming no register yet leaves it undecided, which is refused.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;

use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Undecided;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;

use masc.core.effect;

# why a layout step reading how blocks leave was refused
# ---
# alloc:     the allocator refused storage
# undecided: an instruction whose control turns on an operand that names no register
pub tag Error: u8 {
    alloc:     allocator.Error;
    undecided: Undecided;
}

# a jump to a block
# ---
# at:          the operand position that names the block
# block:       the block
# conditional: it jumps only when a condition holds, else control falls to
#              the next instruction
pub rec Exit {
    at:          u32;
    block:       Block;
    conditional: bool;
}

# the control of instruction `i` of `f`, or why it is undecided
fun control_of(f: *Function, i: Instruction) res[effect.Control, Undecided] {
    val got: effect.Answer[effect.Control] = instruction.transfer(function.file(f), function.data(f, i));
    if (sel got.undecided) { ret res[effect.Control, Undecided].err{Undecided{instruction: i, pending: got.undecided}}; }
    ret res[effect.Control, Undecided].ok{got.decided};
}

# how instruction `i` of `f` jumps to a block, none when it does not
pub fun exit_of(f: *Function, i: Instruction) res[opt[Exit], Undecided] {
    val got: res[effect.Control, Undecided] = control_of(f, i);
    if (sel got.err) { ret res[opt[Exit], Undecided].err{got.err}; }
    val c: effect.Control   = got.ok;
    val d: *InstructionData = function.data(f, i);
    if (c.transfer != effect.JUMP || c.target != effect.DIRECT) { ret res[opt[Exit], Undecided].ok{opt[Exit].none{}}; }
    if (c.operand::usize >= d.operands.size)                    { ret res[opt[Exit], Undecided].ok{opt[Exit].none{}}; }
    val target: Operand = d.operands.data[c.operand];
    if (!(sel target.block)) { ret res[opt[Exit], Undecided].ok{opt[Exit].none{}}; }
    ret res[opt[Exit], Undecided].ok{opt[Exit].some{Exit{at: c.operand::u32, block: target.block, conditional: c.conditional}}};
}

# whether instruction `i` of `f` ends in a trap, which control never leaves
pub fun traps(f: *Function, i: Instruction) res[bool, Undecided] {
    val got: res[effect.Control, Undecided] = control_of(f, i);
    if (sel got.err) { ret res[bool, Undecided].err{got.err}; }
    ret res[bool, Undecided].ok{got.ok.transfer == effect.TRAP};
}
