# jump threading: a block that only jumps is bypassed
#
# every name of a block that does nothing but jump to another block becomes
# the name of the block the chain of such jumps ends at. the entry stays, and
# so does a jump to itself, a chain that closes on itself, and a jump a
# partner operand names.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.graph.NONE;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.layout.exit;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.slice;

# where each block's name goes
# ---
# land: per block, the block that takes its name, NONE for a block that stays
pub rec Threads {
    land: vector.Vector[u32];
}

# give back a threading's storage
pub fun release(t: *Threads) err[allocator.Error] {
    ret vector.dnit[u32](?t.land);
}

# the block a block that only jumps jumps to, NONE for any other block
fun lone(f: *Function, b: u32) u32 {
    if (b == 0) { ret NONE; }
    val list: Slice[Instruction] = function.instructions(f, Block{index: b});
    if (list.size != 1) { ret NONE; }
    val d: *InstructionData = function.data(f, list.data[0]);
    if (d.label != instruction.NO_LABEL) { ret NONE; }
    val ex: opt[exit.Exit] = exit.exit_of(f.set, d);
    if (sel ex.none)              { ret NONE; }
    if (ex.some.conditional)      { ret NONE; }
    if (ex.some.block.index == b) { ret NONE; }
    ret ex.some.block.index;
}

# the block each block that only jumps lands at
# ---
# a:   the allocator the result takes
# f:   the function, unchanged
# ret: where each block's name goes, or the allocator's refusal
pub fun thread(a: *allocator.Allocator, f: *Function) res[Threads, allocator.Error] {
    val n:     usize                = f.blocks.len;
    var out:   Threads              = Threads{land: vector.init[u32](a)};
    val sized: err[allocator.Error] = slice.fill[u32](?out.land, n, NONE);
    if (sel sized.err) {
        vector.dnit[u32](?out.land);
        ret res[Threads, allocator.Error].err{sized.err};
    }
    var jump:  vector.Vector[u32] = vector.init[u32](a);
    var end:   vector.Vector[u32] = vector.init[u32](a);
    var state: vector.Vector[u32] = vector.init[u32](a);
    var path:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?jump);
        vector.dnit[u32](?end);
        vector.dnit[u32](?state);
        vector.dnit[u32](?path);
    }
    var failed: err[allocator.Error] = slice.fill[u32](?jump, n, NONE);
    keep(?failed, slice.fill[u32](?end, n, NONE));
    keep(?failed, slice.fill[u32](?state, n, 0));
    val room: res[usize, allocator.Error] = vector.reserve[u32](?path, n);
    if (sel room.err) { keep(?failed, err[allocator.Error].err{room.err}); }
    if (sel failed.err) {
        vector.dnit[u32](?out.land);
        ret res[Threads, allocator.Error].err{failed.err};
    }
    var b: u32 = 0;
    for (b::usize < n) {
        jump.data[b] = lone(f, b);
        b            = b + 1;
    }
    b = 0;
    for (b::usize < n) {
        if (state.data[b] == 0) {
            var x:     u32 = b;
            var found: u32 = NONE;
            path.len = 0;
            for {
                if (state.data[x] == 2) {
                    found = end.data[x];
                    brk;
                }
                if (state.data[x] == 1) { brk; }
                if (jump.data[x] == NONE) {
                    state.data[x] = 2;
                    end.data[x]   = x;
                    found         = x;
                    brk;
                }
                state.data[x] = 1;
                vector.push[u32](?path, x);
                x = jump.data[x];
            }
            for (path.len > 0) {
                path.len                        = path.len - 1;
                end.data[path.data[path.len]]   = found;
                state.data[path.data[path.len]] = 2;
            }
        }
        b = b + 1;
    }
    b = 0;
    for (b::usize < n) {
        if (jump.data[b] != NONE) { out.land.data[b] = end.data[b]; }
        b = b + 1;
    }
    ret res[Threads, allocator.Error].ok{out};
}

# the block a name lands at
pub fun resolve(t: *Threads, b: u32) u32 {
    if (t.land.data[b] == NONE) { ret b; }
    ret t.land.data[b];
}

# whether a block is bypassed
pub fun removed(t: *Threads, b: u32) bool {
    ret t.land.data[b] != NONE;
}
