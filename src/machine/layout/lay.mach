# block layout of an allocated and framed register machine function
#
# a block that only jumps is threaded away by retargeting everything that
# names it, and a block the entry does not reach is dropped. blocks are then
# ordered so the successor a loop keeps running through follows it, and a
# block ending in a fault goes last. a jump to the
# block that follows is dropped, and a conditional branch whose taken arm ends
# up next is inverted. the function keeps its instruction ids, so what names
# an instruction, the frame's call frame facts and the labels, still does, and
# a dropped block keeps its instructions, so what is at one is known to be gone.
# the function changes only when layout succeeds.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.machine.function.Function;
use mirl.machine.instruction.Undecided;
use mirl.machine.layout.branch;
use mirl.machine.layout.exit;
use mirl.machine.layout.order;
use mirl.machine.layout.thread;
use mirl.machine.operand.Block;

# a laid out function
# ---
# order: the blocks that stay in the order they are emitted, the entry first.
#        a block thread removed or nothing reaches is in none
pub rec Laid {
    order: vector.Vector[Block];
}

# why a function was not laid out
# ---
# alloc:     the allocator refused storage
# inverse:   the inverse of a branch masc states does not stand against its row
# undecided: an instruction whose control turns on an operand that names no register
pub tag Error: u8 {
    alloc:     allocator.Error;
    inverse:   branch.Invalid;
    undecided: Undecided;
}

fun exit_err(e: exit.Error) Error {
    if (sel e.alloc) { ret Error.alloc{e.alloc}; }
    ret Error.undecided{e.undecided};
}

# give back a laid out function's storage
pub fun dnit(l: *Laid) err[allocator.Error] {
    ret vector.dnit[Block](?l.order);
}

# lay a function out
# ---
# a:   the allocator the result takes
# f:   the function, changed in place only when this succeeds
# ret: the order its blocks are emitted in, or why it was not laid out
pub fun lay(a: *allocator.Allocator, f: *Function) res[Laid, Error] {
    val res_threaded: res[thread.Threads, exit.Error] = thread.thread(a, f);
    if (sel res_threaded.err) { ret res[Laid, Error].err{exit_err(res_threaded.err)}; }
    var t: thread.Threads = res_threaded.ok;
    fin { thread.dnit(?t); }
    val res_ordered: res[vector.Vector[u32], exit.Error] = order.order(a, f, ?t);
    if (sel res_ordered.err) { ret res[Laid, Error].err{exit_err(res_ordered.err)}; }
    var blocks: vector.Vector[u32] = res_ordered.ok;
    fin { vector.dnit[u32](?blocks); }
    val res_planned: res[branch.Plan, branch.Error] = branch.plan(a, f, ?t, Slice[u32]{data: blocks.data, size: blocks.len});
    if (sel res_planned.err) {
        if (sel res_planned.err.alloc)     { ret res[Laid, Error].err{Error.alloc{res_planned.err.alloc}}; }
        or (sel res_planned.err.undecided) { ret res[Laid, Error].err{Error.undecided{res_planned.err.undecided}}; }
        ret res[Laid, Error].err{Error.inverse{res_planned.err.inverse}};
    }
    var p: branch.Plan = res_planned.ok;
    fin { branch.dnit(?p); }
    var out:      Laid                        = Laid{order: vector.init[Block](a)};
    val res_room: res[usize, allocator.Error] = vector.reserve[Block](?out.order, blocks.len);
    if (sel res_room.err) {
        vector.dnit[Block](?out.order);
        ret res[Laid, Error].err{Error.alloc{res_room.err}};
    }
    var i: usize = 0;
    for (i < blocks.len) {
        vector.push[Block](?out.order, (blocks.data[i]));
        i = i + 1;
    }
    branch.apply(f, ?t, ?p);
    ret res[Laid, Error].ok{out};
}
