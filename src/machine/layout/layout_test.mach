# tests of block layout, machine form text in and a description of the layout out, on the risc-v rows

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.layout.lay;
use mirl.machine.layout.lay.Laid;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use reader: mirl.machine.text.parse;

#[testing]
val MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# the entry branches to ^1 or falls to the trap ^2, ^1 jumps to a block that only jumps to ^4, which returns
#[testing]
val BRANCHES: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    beq x10, x0, ^1\n    jal x0, ^2\n^1:\n    addi x10, x0, 1\n    jal x0, ^3\n^2:\n    ebreak\n^3:\n    jal x0, ^4\n^4:\n    jalr x0, x1, 0\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

#[testing]
fun put(out: *vector.Vector[u8], s: str) {
    var i: usize = 0;
    for (s[i] != 0) {
        vector.push[u8](out, s[i]);
        i = i + 1;
    }
}

# the laid out function as text: each block's number and the keys of its instructions, a block operand after its key
#[testing]
fun describe(f: *Function, l: *Laid, out: *vector.Vector[u8]) {
    var i: usize = 0;
    for (i < l.order.len) {
        if (i > 0) { put(out, "|"); }
        val b: Block = l.order.data[i];
        vector.push[u8](out, '0' + b.index::u8);
        put(out, ":");
        val list: Slice[Instruction] = function.instructions(f, b);
        var k:    usize              = 0;
        for (k < list.size) {
            if (k > 0) { put(out, ","); }
            val d:  *InstructionData = function.data(f, list.data[k]);
            val op: Opcode           = d.opcode;
            if (sel op.row) { put(out, op.row.key); }
            or              { put(out, "pseudo"); }
            var o: usize = 0;
            for (o < d.operands.size) {
                val at: Operand = d.operands.data[o];
                if (sel at.block) {
                    put(out, "^");
                    vector.push[u8](out, '0' + at.block.index::u8);
                }
                o = o + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }
    vector.push[u8](out, 0);
}

#[testing]
fun same(got: *vector.Vector[u8], want: str) bool {
    if (got.len != str_len(want) + 1) { ret false; }
    var i: usize = 0;
    for (i < got.len) {
        if (got.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a block that only jumps is bypassed, a jump to the block that follows is dropped, a branch whose taken arm follows
# is inverted, and the block that ends in a trap goes last
test layout__a_fallthrough_branch_is_dropped {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?a, ?m, view_of(BRANCHES));
    if (sel read.err) { ret 2; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    val f:    *Function            = ?u.items.data[0].function;
    val laid: res[Laid, lay.Error] = lay.lay(?a, f);
    if (sel laid.err) { ret 3; }
    var l: Laid = laid.ok;
    fin { lay.release(?l); }
    var out: vector.Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?out); }
    describe(f, ?l, ?out);
    if (!same(?out, "0:bne^2|1:addi|4:jalr|2:ebreak")) { ret 4; }
    ret 0;
}
