# a frame slot
# ---
# size:  its bytes
# align: the alignment it needs, a power of two
pub rec SlotData {
    size:  u64;
    align: u64;
}

# one machine function
# ---
# a:            the allocator its storage takes
# set:          the instruction set it is made for
# blocks:       its blocks, the entry first
# instructions: its instructions, indexed by their ids
# virtuals:     the class of each virtual register
# slots:        its frame slots
pub rec Function {
    a:            *allocator.Allocator;
    set:          *mset.Set;
    blocks:       vector.Vector[BlockData];
    instructions: vector.Vector[InstructionData];
    virtuals:     vector.Vector[Class];
    slots:        vector.Vector[SlotData];
}

# why a function refused a request
# ---
# alloc:   the allocator refused storage
# refused: an instruction does not stand against its opcode's row
# class:   a class the target's register file has no row for
pub tag Error: u8 {
    alloc:   allocator.Error;
    refused: Refusal;
    class:   Class;
}

# an empty function for an instruction set
pub fun init(a: *allocator.Allocator, set: *mset.Set) Function {
    ret Function{
        a:            a,
        set:          set,
        blocks:       vector.init[BlockData](a),
        instructions: vector.init[InstructionData](a),
        virtuals:     vector.init[Class](a),
        slots:        vector.init[SlotData](a),
    };
}

# give back a function's storage
pub fun dnit(f: *Function) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < f.instructions.len) {
        keep(?failed, slice.release[Operand](f.a, f.instructions.data[i].operands));
        i = i + 1;
    }
    i = 0;
    for (i < f.blocks.len) {
        keep(?failed, vector.dnit[Instruction](?f.blocks.data[i].instructions));
        i = i + 1;
    }
    keep(?failed, vector.dnit[BlockData](?f.blocks));
    keep(?failed, vector.dnit[InstructionData](?f.instructions));
    keep(?failed, vector.dnit[Class](?f.virtuals));
    keep(?failed, vector.dnit[SlotData](?f.slots));
    ret failed;
}

# the register file of a function's instruction set, nil when it has none
pub fun file(f: *Function) *rf.File {
    if (f.set.codec == nil) { ret nil; }
    ret f.set.codec.registers;
}

fun catalog(f: *Function) rows.Rows {
    if (f.set.codec == nil) { ret rows.Rows{at: nil, len: 0}; }
    ret f.set.codec.rows;
}

# add a block after the last
pub fun block(f: *Function) res[Block, Error] {
    val b: BlockData                   = BlockData{instructions: vector.init[Instruction](f.a)};
    val p: res[usize, allocator.Error] = vector.push[BlockData](?f.blocks, b);
    if (sel p.err) { ret res[Block, Error].err{Error.alloc{p.err}}; }
    ret res[Block, Error].ok{Block{index: (f.blocks.len - 1)::u32}};
}

# add a virtual register of a class, of the function's register file or memory-backed
pub fun virtual(f: *Function, c: Class) res[Virtual, Error] {
    if (!class.valid(c) || (sel c.hardware && c.hardware.file != file(f))) { ret res[Virtual, Error].err{Error.class{c}}; }
    val p: res[usize, allocator.Error] = vector.push[Class](?f.virtuals, c);
    if (sel p.err) { ret res[Virtual, Error].err{Error.alloc{p.err}}; }
    ret res[Virtual, Error].ok{Virtual{index: (f.virtuals.len - 1)::u32}};
}

# the class of a virtual register
pub fun class_of(f: *Function, v: Virtual) Class {
    ret f.virtuals.data[v.index];
}

# add a frame slot
pub fun slot(f: *Function, size: u64, align: u64) res[Slot, Error] {
    val p: res[usize, allocator.Error] = vector.push[SlotData](?f.slots, SlotData{size: size, align: align});
    if (sel p.err) { ret res[Slot, Error].err{Error.alloc{p.err}}; }
    ret res[Slot, Error].ok{Slot{index: (f.slots.len - 1)::u32}};
}

# append an instruction to a block, checked against its opcode's row
# ---
# f:            the function
# b:            the block
# op:           the opcode
# operands:     the operands, copied
# metadata:     the metadata record of the ir instruction it came from
# declassifies: that instruction's row declassifies
# ret:          the instruction, or why it was refused
pub fun append(f: *Function, b: Block, op: Opcode, operands: Slice[Operand], metadata: Metadata, declassifies: bool) res[Instruction, Error] {
    if (b.index::usize >= f.blocks.len) { ret res[Instruction, Error].err{Error.refused{Refusal{operand: instruction.NO_OPERAND, what: instruction.UNKNOWN_BLOCK}}}; }
    var c: Context = Context{
        file:     file(f),
        rows:     catalog(f),
        virtuals: Slice[Class]{data: f.virtuals.data, size: f.virtuals.len},
        slots:    f.slots.len::u32,
        blocks:   f.blocks.len::u32,
    };
    val checked: err[Refusal] = instruction.check(?c, op, operands);
    if (sel checked.err) { ret res[Instruction, Error].err{Error.refused{checked.err}}; }
    val owned: res[Slice[Operand], allocator.Error] = slice.copy[Operand](f.a, operands);
    if (sel owned.err) { ret res[Instruction, Error].err{Error.alloc{owned.err}}; }
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?f.blocks.data[b.index].instructions, 1);
    if (sel room.err) {
        slice.release[Operand](f.a, owned.ok);
        ret res[Instruction, Error].err{Error.alloc{room.err}};
    }
    val pushed: res[usize, allocator.Error] = vector.push[InstructionData](?f.instructions, InstructionData{opcode: op, operands: owned.ok, metadata: metadata, declassifies: declassifies});
    if (sel pushed.err) {
        slice.release[Operand](f.a, owned.ok);
        ret res[Instruction, Error].err{Error.alloc{pushed.err}};
    }
    val id: Instruction = Instruction{index: (f.instructions.len - 1)::u32};
    vector.push[Instruction](?f.blocks.data[b.index].instructions, id);
    ret res[Instruction, Error].ok{id};
}

# an instruction's record
pub fun data(f: *Function, i: Instruction) *InstructionData {
    ret ?f.instructions.data[i.index];
}

# the instructions of a block, in order
pub fun instructions(f: *Function, b: Block) Slice[Instruction] {
    val list: *vector.Vector[Instruction] = ?f.blocks.data[b.index].instructions;
    ret Slice[Instruction]{data: list.data, size: list.len};
}

# the register an instruction's row fixes operand `at` to, none when it is not fixed
pub fun fixed(f: *Function, i: Instruction, at: u32) opt[rf.Id] {
    ret instruction.fixed(file(f), data(f, i).opcode, at);
}

# the graph of a function's blocks, valid until its blocks next change
pub fun graph_of(f: *Function) res[Graph, allocator.Error] {
    ret view.of(f.a, Slice[BlockData]{data: f.blocks.data, size: f.blocks.len}, Slice[InstructionData]{data: f.instructions.data, size: f.instructions.len});
}

# a register file of one general class of four registers, and rows over it
#[testing]
val T_CLASSES: [1]rf.Class = [1]rf.Class{
    rf.Class{name: "r", kind: rf.GENERAL, width: rf.Scaled{fixed: 32, per: 0, scale: 0}, count: 4},
};

#[testing]
val T_REGISTERS: [4]rf.Register = [4]rf.Register{
    rf.Register{name: "r0", class: 0, number: 0, bank: 0, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.Requirement{at: nil, len: 0}},
    rf.Register{name: "r1", class: 0, number: 1, bank: 1, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.Requirement{at: nil, len: 0}},
    rf.Register{name: "r2", class: 0, number: 2, bank: 2, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.Requirement{at: nil, len: 0}},
    rf.Register{name: "r3", class: 0, number: 3, bank: 3, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: rf.STACK, requires: requirement.Requirement{at: nil, len: 0}},
};

