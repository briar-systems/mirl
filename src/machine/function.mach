# an offset into an argument area, fixed bytes plus per bytes for each unit of
# the multiplier of its slot's scale, as a stack piece past arguments of scaled
# size is placed
# ---
# fixed: its fixed bytes
# per:   its bytes per unit of the multiplier, 0 for a fixed offset
pub rec Argued {
    fixed: u64;
    per:   u64;
}

# an offset into an argument area of fixed bytes
pub fun argued(fixed: u64) Argued {
    ret Argued{fixed: fixed, per: 0};
}

# the area of the stack a slot is in
# ---
# local:    the function's own frame, where the frame places it
# incoming: a stack argument of the function's own, at this offset above the
#           canonical frame address, the stack pointer's value at the call
# outgoing: a stack argument of a call the function makes, at this offset
#           above the stack pointer at the call
pub tag Area: u8 {
    local;
    incoming: Argued;
    outgoing: Argued;
}

# a frame slot, of size bytes plus per bytes for each unit of the multiplier
# of a scale of the register file the selection leaves to the implementation,
# as a scalable vector's spill slot follows the vector length
# ---
# size:   its fixed bytes
# per:    its bytes per unit of the multiplier, 0 for a slot of fixed size
# scale:  the scale, read only when per or its argument area offset's per is
#         nonzero
# align:  the alignment it needs, a power of two
# area:   the area it is in
# secret: it may hold a secret, which the walk of a constant-time function's
#         code seeds it with
pub rec SlotData {
    size:   u64;
    per:    u64;
    scale:  u8;
    align:  u64;
    area:   Area;
    secret: bool;
}

# one machine function
# ---
# a:            the allocator its storage takes
# set:          the instruction set it is made for
# blocks:       its blocks, the entry first
# instructions: its instructions, indexed by their ids
# virtuals:     the class of each virtual register
# slots:        its frame slots
# entry:        where its parameters arrive, as the abi legalisation placed
#               them, none for a function whose entry was never placed
# points:       its value binding records, those before one instruction in
#               their order
pub rec Function {
    a:            *allocator.Allocator;
    set:          *mset.Set;
    blocks:       vector.Vector[BlockData];
    instructions: vector.Vector[InstructionData];
    virtuals:     vector.Vector[Class];
    slots:        vector.Vector[SlotData];
    entry:        opt[Slice[Placed]];
    points:       vector.Vector[Point];
}

# why a function refused a request
# ---
# alloc:   the allocator refused storage
# refused: an instruction does not stand against its opcode's row
# class:   a class the target's register file has no row for
pub tag Error: u8 {
    alloc:   allocator.Error;
    refused: Refusal;
    class:   Class;
}

# an empty function for an instruction set
pub fun init(a: *allocator.Allocator, set: *mset.Set) Function {
    ret Function{
        a:            a,
        set:          set,
        blocks:       vector.init[BlockData](a),
        instructions: vector.init[InstructionData](a),
        virtuals:     vector.init[Class](a),
        slots:        vector.init[SlotData](a),
        entry:        opt[Slice[Placed]].none{},
        points:       vector.init[Point](a),
    };
}

# give back a function's storage
pub fun dnit(f: *Function) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < f.instructions.len) {
        keep(?failed, slice.release[Operand](f.a, f.instructions.data[i].operands));
        keep(?failed, slice.release[Implicit](f.a, f.instructions.data[i].implicit));
        keep(?failed, slice.release[Placed](f.a, f.instructions.data[i].places));
        i = i + 1;
    }
    i = 0;
    for (i < f.blocks.len) {
        keep(?failed, vector.dnit[Instruction](?f.blocks.data[i].instructions));
        i = i + 1;
    }
    keep(?failed, vector.dnit[BlockData](?f.blocks));
    keep(?failed, vector.dnit[InstructionData](?f.instructions));
    keep(?failed, vector.dnit[Class](?f.virtuals));
    keep(?failed, vector.dnit[SlotData](?f.slots));
    keep(?failed, vector.dnit[Point](?f.points));
    if (sel f.entry.some) { keep(?failed, slice.release[Placed](f.a, f.entry.some)); }
    ret failed;
}

# state where a function's parameters arrive, in place of any it had
# ---
# f:    the function
# list: the places, copied
# ret:  ok, or the allocator's refusal
pub fun place_entry(f: *Function, list: Slice[Placed]) err[allocator.Error] {
    val owned: res[Slice[Placed], allocator.Error] = slice.copy[Placed](f.a, list);
    if (sel owned.err)    { ret err[allocator.Error].err{owned.err}; }
    if (sel f.entry.some) { slice.release[Placed](f.a, f.entry.some); }
    f.entry = opt[Slice[Placed]].some{owned.ok};
    ret err[allocator.Error].ok{};
}

# give a function made anew from another the placement of the other's entry,
# so every stage that rebuilds a function keeps it
pub fun inherit(to: *Function, from: *Function) err[allocator.Error] {
    if (sel from.entry.none) { ret err[allocator.Error].ok{}; }
    ret place_entry(to, from.entry.some);
}

# no instruction of the output
pub val UNMADE: u32 = 0xffffffff;

# by instruction of a stage's input, the first instruction of its output made
# for it, UNMADE for one none was made for
# ---
# inputs:  how many instructions the input has
# origins: by instruction of the output, the input instruction it was made
#          for, UNMADE for one the stage made of its own
# out:     where the firsts go
# ret:     ok, or the allocator's refusal
pub fun firsts(inputs: usize, origins: Slice[u32], out: *vector.Vector[u32]) err[allocator.Error] {
    val filled: err[allocator.Error] = slice.fill[u32](out, inputs, UNMADE);
    if (sel filled.err) { ret filled; }
    var j: usize = 0;
    for (j < origins.size) {
        val o: u32 = origins.data[j];
        if (o != UNMADE && o::usize < inputs) {
            if (out.data[o] == UNMADE) { out.data[o] = j::u32; }
        }
        j = j + 1;
    }
    ret err[allocator.Error].ok{};
}

# by instruction of a stage's input, the first instruction of its output, from
# the first and the count a stage that writes in input order states for each
# ---
# first: by input instruction, the first instruction written for it
# made:  by input instruction, how many were written for it
# out:   where the firsts go, UNMADE for one none was written for
# ret:   ok, or the allocator's refusal
pub fun firsts_of(first: Slice[u32], made: Slice[u32], out: *vector.Vector[u32]) err[allocator.Error] {
    val filled: err[allocator.Error] = slice.fill[u32](out, first.size, UNMADE);
    if (sel filled.err) { ret filled; }
    var i: usize = 0;
    for (i < first.size) {
        if (i < made.size && made.data[i] != 0) { out.data[i] = first.data[i]; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the instruction of a stage's output a record before input instruction `at`
# stands before: the first made for it, or for the next of its block that
# kept one, none when the rest of its block made none
fun carried_to(from: *Function, first: Slice[u32], at: Instruction, block: *vector.Vector[u32], position: *vector.Vector[u32]) opt[Instruction] {
    if (at.index::usize >= first.size)  { ret opt[Instruction].none{}; }
    if (first.data[at.index] != UNMADE) { ret opt[Instruction].some{Instruction{index: first.data[at.index]}}; }
    val k: u32 = block.data[at.index];
    if (k == UNMADE) { ret opt[Instruction].none{}; }
    val list: *vector.Vector[Instruction] = ?from.blocks.data[k].instructions;
    var p:    usize                       = position.data[at.index]::usize + 1;
    for (p < list.len) {
        val next: u32 = list.data[p].index;
        if (next::usize < first.size && first.data[next] != UNMADE) { ret opt[Instruction].some{Instruction{index: first.data[next]}}; }
        p = p + 1;
    }
    ret opt[Instruction].none{};
}

# the value binding records of a stage's input carried to its output, each
# before the instruction its own now begins at, or the next one of its block
# that the stage kept, and dropped when the rest of its block was not kept,
# with what each reads kept as it was
# ---
# to:    the output
# from:  the input
# first: by input instruction, the first output instruction made for it, as
#        `firsts` gives it
# ret:   ok, or the allocator's refusal
pub fun carry_points(to: *Function, from: *Function, first: Slice[u32]) err[allocator.Error] {
    if (from.points.len == 0) { ret err[allocator.Error].ok{}; }
    var block:    vector.Vector[u32] = vector.init[u32](to.a);
    var position: vector.Vector[u32] = vector.init[u32](to.a);
    fin {
        vector.dnit[u32](?block);
        vector.dnit[u32](?position);
    }
    var failed: err[allocator.Error] = slice.fill[u32](?block, from.instructions.len, UNMADE);
    keep(?failed, slice.fill[u32](?position, from.instructions.len, 0));
    val room: res[usize, allocator.Error] = vector.reserve[Point](?to.points, from.points.len);
    if (sel room.err)   { keep(?failed, err[allocator.Error].err{room.err}); }
    if (sel failed.err) { ret failed; }
    var k: usize = 0;
    for (k < from.blocks.len) {
        val list: *vector.Vector[Instruction] = ?from.blocks.data[k].instructions;
        var p:    usize                       = 0;
        for (p < list.len) {
            block.data[list.data[p].index]    = k::u32;
            position.data[list.data[p].index] = p::u32;
            p                                 = p + 1;
        }
        k = k + 1;
    }
    var i: usize = 0;
    for (i < from.points.len) {
        var pt: Point            = from.points.data[i];
        val at: opt[Instruction] = carried_to(from, first, pt.at, ?block, ?position);
        if (sel at.some) {
            pt.at = at.some;
            vector.push[Point](?to.points, pt);
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the value binding records of the input of a stage that writes in input
# order carried to its output, as `carry_points` carries them
# ---
# to:    the output
# from:  the input
# first: by input instruction, the first instruction written for it
# made:  by input instruction, how many were written for it
# ret:   ok, or the allocator's refusal
pub fun carry_written(to: *Function, from: *Function, first: Slice[u32], made: Slice[u32]) err[allocator.Error] {
    if (from.points.len == 0) { ret err[allocator.Error].ok{}; }
    var at: vector.Vector[u32] = vector.init[u32](to.a);
    fin { vector.dnit[u32](?at); }
    val got: err[allocator.Error] = firsts_of(first, made, ?at);
    if (sel got.err) { ret got; }
    ret carry_points(to, from, Slice[u32]{data: at.data, size: at.len});
}

# state where the pieces of the call an instruction makes travel, in place of
# any it stated
# ---
# f:    the function
# i:    the instruction
# list: the places, its arguments' and then its results', copied
# ret:  ok, or the allocator's refusal
pub fun place(f: *Function, i: Instruction, list: Slice[Placed]) err[allocator.Error] {
    val owned: res[Slice[Placed], allocator.Error] = slice.copy[Placed](f.a, list);
    if (sel owned.err) { ret err[allocator.Error].err{owned.err}; }
    val d: *InstructionData = ?f.instructions.data[i.index];
    slice.release[Placed](f.a, d.places);
    d.places = owned.ok;
    ret err[allocator.Error].ok{};
}

# the register file of a function's instruction set, nil when it has none
pub fun file(f: *Function) *rf.File {
    ret instruction.file_of(f.set);
}

# add a block after the last
pub fun block(f: *Function) res[Block, Error] {
    val b: BlockData                   = BlockData{instructions: vector.init[Instruction](f.a)};
    val p: res[usize, allocator.Error] = vector.push[BlockData](?f.blocks, b);
    if (sel p.err) { ret res[Block, Error].err{Error.alloc{p.err}}; }
    ret res[Block, Error].ok{Block{index: (f.blocks.len - 1)::u32}};
}

# add a virtual register of a class, of the function's register file or memory-backed
pub fun virtual(f: *Function, c: Class) res[Virtual, Error] {
    if (!class.valid(c) || (sel c.hardware && c.hardware.file != file(f))) { ret res[Virtual, Error].err{Error.class{c}}; }
    val p: res[usize, allocator.Error] = vector.push[Class](?f.virtuals, c);
    if (sel p.err) { ret res[Virtual, Error].err{Error.alloc{p.err}}; }
    ret res[Virtual, Error].ok{Virtual{index: (f.virtuals.len - 1)::u32}};
}

# the class of a virtual register
pub fun class_of(f: *Function, v: Virtual) Class {
    ret f.virtuals.data[v.index];
}

# a slot of fixed size
pub fun fixed_slot(size: u64, align: u64) SlotData {
    ret SlotData{size: size, per: 0, scale: 0, align: align, area: Area.local{}, secret: false};
}

# add a frame slot
pub fun slot(f: *Function, s: SlotData) res[Slot, Error] {
    val p: res[usize, allocator.Error] = vector.push[SlotData](?f.slots, s);
    if (sel p.err) { ret res[Slot, Error].err{Error.alloc{p.err}}; }
    ret res[Slot, Error].ok{Slot{index: (f.slots.len - 1)::u32}};
}

# whether an opcode and operands stand together in a function, as an appended instruction does
# ---
# f:        the function
# op:       the opcode
# operands: the operands
# state:    the vector state it runs under, none when it states none
# ret:      ok, or the first operand that does not stand where it is
pub fun check(f: *Function, op: Opcode, operands: Slice[Operand], state: opt[vstate.State]) err[Refusal] {
    var c: Context = Context{
        set:      f.set,
        virtuals: Slice[Class]{data: f.virtuals.data, size: f.virtuals.len},
        slots:    f.slots.len::u32,
        blocks:   f.blocks.len::u32,
    };
    ret instruction.check(?c, op, operands, state);
}

# put an opcode and operands in an instruction's place, the operands copied into the ones it has
# ---
# f:        the function
# i:        the instruction, which has as many operands as are given
# op:       the opcode
# operands: the operands, which `check` admitted with the opcode
pub fun replace(f: *Function, i: Instruction, op: Opcode, operands: Slice[Operand]) {
    val d: *InstructionData = ?f.instructions.data[i.index];
    d.opcode = op;
    var k: usize = 0;
    for (k < operands.size) {
        d.operands.data[k] = operands.data[k];
        k                  = k + 1;
    }
}

# take the last instruction of a block out of it, its record staying so the ids of the others hold
pub fun detach_last(f: *Function, b: Block) {
    vector.pop[Instruction](?f.blocks.data[b.index].instructions);
}

# append an instruction to a block, checked against its opcode's row
# ---
# f:            the function
# b:            the block
# op:           the opcode
# operands:     the operands, copied
# metadata:     the metadata record of the ir instruction it came from
# declassifies: that instruction's row declassifies
# state:        the vector state it runs under, none when it states none
# ret:          the instruction, or why it was refused
pub fun append(f: *Function, b: Block, op: Opcode, operands: Slice[Operand], metadata: Metadata, declassifies: bool, state: opt[vstate.State]) res[Instruction, Error] {
    if (b.index::usize >= f.blocks.len) { ret res[Instruction, Error].err{Error.refused{Refusal{operand: instruction.NO_OPERAND, what: instruction.UNKNOWN_BLOCK}}}; }
    val checked: err[Refusal] = check(f, op, operands, state);
    if (sel checked.err) { ret res[Instruction, Error].err{Error.refused{checked.err}}; }
    val owned: res[Slice[Operand], allocator.Error] = slice.copy[Operand](f.a, operands);
    if (sel owned.err) { ret res[Instruction, Error].err{Error.alloc{owned.err}}; }
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?f.blocks.data[b.index].instructions, 1);
    if (sel room.err) {
        slice.release[Operand](f.a, owned.ok);
        ret res[Instruction, Error].err{Error.alloc{room.err}};
    }
    val pushed: res[usize, allocator.Error] = vector.push[InstructionData](?f.instructions, InstructionData{opcode: op, operands: owned.ok, metadata: metadata, declassifies: declassifies, implicit: Slice[Implicit]{data: nil, size: 0}, label: instruction.NO_LABEL, state: state, places: Slice[Placed]{data: nil, size: 0}});
    if (sel pushed.err) {
        slice.release[Operand](f.a, owned.ok);
        ret res[Instruction, Error].err{Error.alloc{pushed.err}};
    }
    val id: Instruction = Instruction{index: (f.instructions.len - 1)::u32};
    vector.push[Instruction](?f.blocks.data[b.index].instructions, id);
    ret res[Instruction, Error].ok{id};
}

# append an instruction's record to a block, with these operands in place of
# its own, and state its implicit locations, its label, its vector state and
# its call's places there
# ---
# f:        the function
# b:        the block
# d:        the record, of this function or another of the same set
# operands: the operands, copied
# ret:      the instruction, or why it was refused
pub fun carry(f: *Function, b: Block, d: *InstructionData, operands: Slice[Operand]) res[Instruction, Error] {
    val made: res[Instruction, Error] = append(f, b, d.opcode, operands, d.metadata, d.declassifies, d.state);
    if (sel made.err) { ret made; }
    val implied: err[Error] = imply(f, made.ok, d.implicit);
    if (sel implied.err) { ret res[Instruction, Error].err{implied.err}; }
    label(f, made.ok, d.label);
    val placed: err[allocator.Error] = place(f, made.ok, d.places);
    if (sel placed.err) { ret res[Instruction, Error].err{Error.alloc{placed.err}}; }
    ret made;
}

# state the locations an instruction reads and writes beyond its operands and
# row, reads first, in place of any it had
# ---
# f:    the function
# i:    the instruction
# list: the locations, copied, each a register of the function's file or a
#       cell of a memory class
# ret:  ok, or why it was refused
pub fun imply(f: *Function, i: Instruction, list: Slice[Implicit]) err[Error] {
    if (i.index::usize >= f.instructions.len) { ret err[Error].err{Error.refused{Refusal{operand: instruction.NO_OPERAND, what: instruction.UNKNOWN_VIRTUAL}}}; }
    var k: usize = 0;
    for (k < list.size) {
        val at: Physical = list.data[k].location;
        if (sel at.register) {
            if (file(f) == nil) { ret err[Error].err{Error.refused{Refusal{operand: instruction.NO_OPERAND, what: instruction.UNFILED_REGISTER}}}; }
            val row: opt[*rf.Register] = rf.row_of(file(f), at.register);
            if (sel row.none) { ret err[Error].err{Error.refused{Refusal{operand: instruction.NO_OPERAND, what: instruction.UNKNOWN_REGISTER}}}; }
        }
        k = k + 1;
    }
    val owned: res[Slice[Implicit], allocator.Error] = slice.copy[Implicit](f.a, list);
    if (sel owned.err) { ret err[Error].err{Error.alloc{owned.err}}; }
    val d: *InstructionData = ?f.instructions.data[i.index];
    slice.release[Implicit](f.a, d.implicit);
    d.implicit = owned.ok;
    ret err[Error].ok{};
}

# mark an instruction with the label partner operands name it by, unique in
# the function, or NO_LABEL for none
pub fun label(f: *Function, i: Instruction, n: u32) {
    f.instructions.data[i.index].label = n;
}

# an instruction's record
pub fun data(f: *Function, i: Instruction) *InstructionData {
    ret ?f.instructions.data[i.index];
}

# the instructions of a block, in order
pub fun instructions(f: *Function, b: Block) Slice[Instruction] {
    val list: *vector.Vector[Instruction] = ?f.blocks.data[b.index].instructions;
    ret Slice[Instruction]{data: list.data, size: list.len};
}

# the register an instruction's row fixes operand `at` to, none when it is not fixed
pub fun fixed(f: *Function, i: Instruction, at: u32) opt[rf.Id] {
    ret instruction.fixed(f.set, data(f, i).opcode, at);
}

# the graph of a function's blocks, valid until its blocks next change
pub fun graph_of(f: *Function) res[Graph, allocator.Error] {
    ret view.of(f.a, Slice[BlockData]{data: f.blocks.data, size: f.blocks.len}, Slice[InstructionData]{data: f.instructions.data, size: f.instructions.len});
}

# a register file of one general class of four registers, and rows over it
#[testing]
val T_CLASSES: [1]rf.Class = [1]rf.Class{
    rf.Class{name: "r", kind: rf.GENERAL, width: quantity.Scaled{fixed: 32, per: 0, scale: 0}, count: quantity.Scaled{fixed: 4, per: 0, scale: 0}},
};

#[testing]
val T_REGISTERS: [4]rf.Register = [4]rf.Register{
    rf.Register{name: "r0", class: 0, number: 0, bank: 0, offset: quantity.Scaled{fixed: 0, per: 0, scale: 0}, stride: quantity.Scaled{fixed: 0, per: 0, scale: 0}, count: quantity.Scaled{fixed: 1, per: 0, scale: 0}, places: rf.ONE_PLACE, flags: 0, requires: requirement.Requirement{at: nil, len: 0}, extend: rf.KEEP},
