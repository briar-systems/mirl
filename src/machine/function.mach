# whether a source holds a followed directly by b, the two written apart here
# so the needles never match themselves
#[testing]
fun mentions(src: *u8, size: usize, a: str, b: str) bool {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    var i:  usize = 0;
    for (i + la + lb <= size) {
        var k:    usize = 0;
        var same: bool  = true;
        for (same && k < la + lb) {
            var want: u8 = 0;
            if (k < la)             { want = a[k]; }
            or                      { want = b[k - la]; }
            if (src[i + k] != want) { same = false; }
            k = k + 1;
        }
        if (same) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a source names an architecture, its registers or a target's architecture row
#[testing]
fun names_arch(src: *u8, size: usize) bool {
    ret mentions(src, size, "x8", "6") || mentions(src, size, "aarc", "h") || mentions(src, size, "risc", "v") || mentions(src, size, "rv", "32") || mentions(src, size, "rv", "64") || mentions(src, size, "arm", "64") || mentions(src, size, "i3", "86") || mentions(src, size, "amd", "64") || mentions(src, size, "was", "m") || mentions(src, size, "spi", "rv") || mentions(src, size, "xm", "m") || mentions(src, size, "ra", "x") || mentions(src, size, ".", "arch") || mentions(src, size, "arch", "es.") || mentions(src, size, "mset.", "find");
}

# a tree whose members a machine source never imports
# ---
# dir:     the directory, each directory in it one member
# prefix:  the module path a member's modules start with, the member's name
#          after it
# members: the members, as `members_of` lists them
# seen:    the use and fwd lines that name the prefix at all
#[testing]
rec Barred {
    dir:     str;
    prefix:  str;
    members: vector.Vector[str];
    seen:    u32;
}

# the register family, whose members the machine form serves without naming
#[testing]
val FAMILY_DIR: str = "src/target/register";
#[testing]
val FAMILY:     str = "mirl.target.register.";

# masc's instruction sets, each of one architecture
#[testing]
val SETS_DIR: str = "dep/masc/src/isa";
#[testing]
val SETS:     str = "masc.isa.";

# whether `s` is spelled in `src` at `i`, wholly before `end`
#[testing]
fun spelled_at(src: *u8, end: usize, i: usize, s: str) bool {
    val n: usize = str_len(s);
    if (i + n > end) { ret false; }
    var k: usize = 0;
    for (k < n) {
        if (src[i + k] != s[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether a source has a use or fwd line naming a module of a member of a
# barred tree, counting in each its lines that name its prefix at all
#[testing]
fun imports_member(src: *u8, size: usize, barred: Slice[Barred]) bool {
    var start: usize = 0;
    for (start < size) {
        var end: usize = start;
        for (end < size && src[end] != '\n') { end = end + 1; }
        var i: usize = start;
        for (i < end && src[i] == ' ') { i = i + 1; }
        if (spelled_at(src, end, i, "use ") || spelled_at(src, end, i, "fwd ")) {
            var j: usize = i;
            for (j < end) {
                var t: usize = 0;
                for (t < barred.size) {
                    val b: *Barred = ?barred.data[t];
                    if (spelled_at(src, end, j, b.prefix)) {
                        b.seen = b.seen + 1;
                        val at: usize = j + str_len(b.prefix);
                        var k:  usize = 0;
                        for (k < b.members.len) {
                            val past: usize = at + str_len(b.members.data[k]);
                            if (spelled_at(src, end, at, b.members.data[k]) && past < end && (src[past] == '.' || src[past] == ';')) { ret true; }
                            k = k + 1;
                        }
                    }
                    t = t + 1;
                }
                j = j + 1;
            }
        }
        start = end + 1;
    }
    ret false;
}

# the members of the tree at `dir`, each directory of it, none when it cannot be listed
#[testing]
fun members_of(a: *allocator.Allocator, dir: str) opt[vector.Vector[str]] {
    val names: res[vector.Vector[filesystem.Listed], filesystem.FsError] = filesystem.read_dir(a, dir);
    if (sel names.err) { ret opt[vector.Vector[str]].none{}; }
    var members: vector.Vector[str] = vector.init[str](a);
    var i:       usize              = 0;
    for (i < names.ok.len) {
        val entry: filesystem.Listed = names.ok.data[i];
        if (sel entry.unspellable) { ret opt[vector.Vector[str]].none{}; }
        val full: res[str, allocator.Error] = path.join(a, dir, entry.name);
        if (sel full.err) { ret opt[vector.Vector[str]].none{}; }
        val sub: res[bool, io_error.Error] = filesystem.is_dir(full.ok);
        if (sel sub.err) { ret opt[vector.Vector[str]].none{}; }
        if (sub.ok) {
            val pushed: res[usize, allocator.Error] = vector.push[str](?members, entry.name);
            if (sel pushed.err) { ret opt[vector.Vector[str]].none{}; }
        }
        i = i + 1;
    }
    ret opt[vector.Vector[str]].some{members};
}

# every source under a directory checked for a use or fwd line naming a member
# of a barred tree, 0, or 1 when one names one, or 2 when the tree could not
# be read
#[testing]
fun scan_imports(a: *allocator.Allocator, dir: str, barred: Slice[Barred], files: *u32) u32 {
    val names: res[vector.Vector[filesystem.Listed], filesystem.FsError] = filesystem.read_dir(a, dir);
    if (sel names.err) { ret 2; }
    var i: usize = 0;
    for (i < names.ok.len) {
        val entry: filesystem.Listed = names.ok.data[i];
        if (sel entry.unspellable) { ret 2; }
        val full: res[str, allocator.Error] = path.join(a, dir, entry.name);
        if (sel full.err) { ret 2; }
        val sub: res[bool, io_error.Error] = filesystem.is_dir(full.ok);
        if (sel sub.err) { ret 2; }
        if (sub.ok) {
            val inner: u32 = scan_imports(a, full.ok, barred, files);
            if (inner != 0) { ret inner; }
        }
        or (str_ends_with(full.ok, ".mach")) {
            val got: u32 = scan_file(a, full.ok, barred, files);
            if (got != 0) { ret got; }
        }
        i = i + 1;
    }
    ret 0;
}

# one source checked as `scan_imports` checks each
#[testing]
fun scan_file(a: *allocator.Allocator, source: str, barred: Slice[Barred], files: *u32) u32 {
    val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, source);
    if (sel file.err) { ret 2; }
    @files = @files + 1;
    if (imports_member(file.ok.data, file.ok.len, barred)) {
        print.eprintlnf("{}: imports a member of the register family or an instruction set of masc", source);
        ret 1;
    }
    ret 0;
}

test virtual__a_memory_backed_class_stands_wherever_a_register_class_does {
    var a: allocator.Allocator;
    page.make(?a);
    var f: Function = init(?a, ?T_SET);
    fin { dnit(?f); }
    val general: Class    = class.hardware(?T_FILE, 0);
    val memory:  Class    = Class.memory{?T_PAGE};
    val cell:    Physical = Physical.cell{Cell{class: ?T_PAGE, number: 3}};
    if (!class.same(memory, Class.memory{?T_PAGE}) || class.same(memory, general))             { ret 1; }
    if (class.width(memory).fixed != 8 || class.count(memory) != 16)                           { ret 1; }
    if (!class.holds(memory, cell) || class.holds(memory, Physical.register{rf.make(0, 3)}))   { ret 1; }
    if (!class.holds(general, Physical.register{rf.make(0, 3)}) || class.holds(general, cell)) { ret 1; }
    val held: opt[Class] = class.of(file(?f), cell);
    if (!(sel held.some && class.same(held.some, memory))) { ret 1; }

    val b: res[Block, Error]   = block(?f);
    val m: res[Virtual, Error] = virtual(?f, memory);
    val g: res[Virtual, Error] = virtual(?f, general);
    val s: res[Slot, Error]    = slot(?f, fixed_slot(1, 1));
    if (sel b.err)                               { ret 2; }
    if (sel m.err)                               { ret 2; }
    if (sel g.err)                               { ret 2; }
    if (sel s.err)                               { ret 2; }
    if (!class.same(class_of(?f, m.ok), memory)) { ret 2; }
    var copy: [2]Operand = [2]Operand{Operand.virtual{m.ok}, Operand.virtual{g.ok}};
    if (!t_ok(t_append(?f, b.ok, Opcode.pseudo{pseudo.COPY}, ?copy[0], 2))) { ret 3; }
    var spill: [2]Operand = [2]Operand{Operand.slot{s.ok}, Operand.virtual{m.ok}};
    if (!t_ok(t_append(?f, b.ok, Opcode.pseudo{pseudo.SPILL}, ?spill[0], 2))) { ret 3; }
    val load: Opcode     = Opcode.row{?T_ROWS[2]};
    var from: [2]Operand = [2]Operand{Operand.virtual{g.ok}, Operand.virtual{m.ok}};
    if (!t_ok(t_append(?f, b.ok, load, ?from[0], 2))) { ret 4; }
    var assigned: [2]Operand = [2]Operand{reg(2), Operand.physical{cell}};
    if (!t_ok(t_append(?f, b.ok, load, ?assigned[0], 2))) { ret 4; }
    var into: [2]Operand = [2]Operand{Operand.virtual{m.ok}, Operand.virtual{g.ok}};
    if (!t_refused(t_append(?f, b.ok, load, ?into[0], 2), 0, instruction.CLASS)) { ret 5; }

    if (names_arch(?SURFACE[0], $length_of(SURFACE)))         { ret 6; }
    if (names_arch(?BLOCK[0], $length_of(BLOCK)))             { ret 6; }
    if (names_arch(?CLASS[0], $length_of(CLASS)))             { ret 6; }
    if (names_arch(?FUNCTION[0], $length_of(FUNCTION)))       { ret 6; }
    if (names_arch(?INSTRUCTION[0], $length_of(INSTRUCTION))) { ret 6; }
    if (names_arch(?OPERAND[0], $length_of(OPERAND)))         { ret 6; }
    if (names_arch(?PSEUDO[0], $length_of(PSEUDO)))           { ret 6; }
    if (names_arch(?VIEW[0], $length_of(VIEW)))               { ret 6; }
    if (names_arch(?SELECT[0], $length_of(SELECT)))           { ret 6; }
    if (names_arch(?RULE[0], $length_of(RULE)))               { ret 6; }
    if (names_arch(?ENGINE[0], $length_of(ENGINE)))           { ret 6; }
    if (names_arch(?LOCATION[0], $length_of(LOCATION)))       { ret 6; }
    if (names_arch(?LIVE[0], $length_of(LIVE)))               { ret 6; }
    if (names_arch(?ALLOWED[0], $length_of(ALLOWED)))         { ret 6; }
    if (names_arch(?PLAN[0], $length_of(PLAN)))               { ret 6; }
    if (names_arch(?SPILL[0], $length_of(SPILL)))             { ret 6; }
    if (names_arch(?SCAN[0], $length_of(SCAN)))               { ret 6; }
    if (names_arch(?REWRITE[0], $length_of(REWRITE)))         { ret 6; }
    if (names_arch(?CHECK[0], $length_of(CHECK)))             { ret 6; }
    if (names_arch(?ALLOCATE[0], $length_of(ALLOCATE)))       { ret 6; }
    if (names_arch(?FRAME[0], $length_of(FRAME)))             { ret 6; }
    if (names_arch(?RECORD[0], $length_of(RECORD)))           { ret 6; }
    if (names_arch(?CODE[0], $length_of(CODE)))               { ret 6; }
    if (names_arch(?SCAN_FACTS[0], $length_of(SCAN_FACTS)))   { ret 6; }
    if (names_arch(?LAY[0], $length_of(LAY)))                 { ret 6; }
    if (names_arch(?FINISH[0], $length_of(FINISH)))           { ret 6; }
    # the scan finds what is there
    if (!mentions(?CLASS[0], $length_of(CLASS), "memory-", "backed")) { ret 7; }
    # no source of the machine form imports a member of the register family or
    # an instruction set of masc, the tests included
    var barred: [2]Barred = [2]Barred{
        Barred{dir: FAMILY_DIR, prefix: FAMILY, members: vector.init[str](?a), seen: 0},
        Barred{dir: SETS_DIR, prefix: SETS, members: vector.init[str](?a), seen: 0},
    };
    var t: usize = 0;
    for (t < 2) {
        val members: opt[vector.Vector[str]] = members_of(?a, barred[t].dir);
        if (sel members.none)      { ret 8; }
        if (members.some.len == 0) { ret 8; }
        barred[t].members = members.some;
        t                 = t + 1;
    }
    val all:   Slice[Barred] = Slice[Barred]{data: ?barred[0], size: 2};
    var files: u32           = 0;
    if (scan_file(?a, "src/machine.mach", all, ?files) != 0) { ret 9; }
    if (scan_imports(?a, "src/machine", all, ?files) != 0)   { ret 9; }
    # the scan finds what is there
    if (files == 0 || barred[0].seen == 0 || barred[1].seen == 0) { ret 10; }
    ret 0;
}

#[testing]
val T_LITERAL: [5]u8 = [5]u8{1, 2, 3, 4, 5};

#[testing]
fun no_register() opt[Register] {
    ret opt[Register].none{};
}

#[testing]
fun address_of(base: Register, disp: i64) Operand {
    ret Operand.address{Address{base: opt[Register].some{base}, index: no_register(), segment: no_register(), scale: 0, disp: disp, symbol: opt[Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
}

# an address, a list and a literal stand at the positions of masc's memory,
# list and literal shapes as far as those positions admit them: an address's
# base of its class, no index where none is admitted and a displacement it
# represents, a list of as many members as it admits, and bytes no more than
# it holds. a list is no register and an id no machine operand
test append__an_address_a_list_and_a_literal_stand_where_masc_admits_them {
    var a: allocator.Allocator;
    page.make(?a);
    var f: Function = init(?a, ?T_SET);
    fin { dnit(?f); }
    val general: Class               = class.hardware(?T_FILE, 0);
    val b:       res[Block, Error]   = block(?f);
    val v:       res[Virtual, Error] = virtual(?f, general);
    val w:       res[Virtual, Error] = virtual(?f, general);
    if (sel b.err) { ret 1; }
    if (sel v.err) { ret 1; }
    if (sel w.err) { ret 1; }
    val load:   Opcode     = Opcode.row{?T_ROWS[2]};
    val gather: Opcode     = Opcode.row{?T_ROWS[7]};
    val bytes:  Opcode     = Opcode.row{?T_ROWS[8]};
    var based:  [2]Operand = [2]Operand{Operand.virtual{w.ok}, address_of(Register.virtual{v.ok}, 8)};
    if (!t_ok(t_append(?f, b.ok, load, ?based[0], 2))) { ret 2; }
    var placed: [2]Operand = [2]Operand{reg(1), address_of(Register.physical{Physical.register{rf.make(0, 2)}}, -2048)};
    if (!t_ok(t_append(?f, b.ok, load, ?placed[0], 2))) { ret 2; }
    var far: [2]Operand = [2]Operand{reg(1), address_of(Register.virtual{v.ok}, 2048)};
    if (!t_refused(t_append(?f, b.ok, load, ?far[0], 2), 1, instruction.RANGE)) { ret 3; }
    var with_index: [2]Operand = [2]Operand{reg(1), Operand.address{Address{base: opt[Register].some{Register.virtual{v.ok}}, index: opt[Register].some{Register.virtual{w.ok}}, segment: no_register(), scale: 0, disp: 0, symbol: opt[Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}}};
    if (!t_refused(t_append(?f, b.ok, load, ?with_index[0], 2), 1, instruction.SHAPE)) { ret 4; }
    var listed: [2]Operand = [2]Operand{Operand.virtual{w.ok}, Operand.list{List{first: Register.virtual{v.ok}, count: 2}}};
    if (!t_ok(t_append(?f, b.ok, gather, ?listed[0], 2))) { ret 5; }
    var long: [2]Operand = [2]Operand{reg(0), Operand.list{List{first: Register.physical{Physical.register{rf.make(0, 3)}}, count: 3}}};
    if (!t_refused(t_append(?f, b.ok, gather, ?long[0], 2), 1, instruction.RANGE)) { ret 6; }
    var unlisted: [2]Operand = [2]Operand{reg(0), Operand.virtual{v.ok}};
    if (!t_refused(t_append(?f, b.ok, gather, ?unlisted[0], 2), 1, instruction.SHAPE)) { ret 7; }
    var held: [2]Operand = [2]Operand{reg(0), Operand.literal{mo.Bytes{at: ?T_LITERAL[0], len: 4}}};
    if (!t_ok(t_append(?f, b.ok, bytes, ?held[0], 2))) { ret 8; }
    var over: [2]Operand = [2]Operand{reg(0), Operand.literal{mo.Bytes{at: ?T_LITERAL[0], len: 5}}};
    if (!t_refused(t_append(?f, b.ok, bytes, ?over[0], 2), 1, instruction.RANGE)) { ret 9; }
    # a physical list from the last register wraps to the first, as masc's
    # span of the member range states
    var room:    [instruction.VALUES]mo.Value;
    val wrapped: mo.Value = instruction.list_value(?T_FILE, ?T_GATHERED, List{first: Register.physical{Physical.register{rf.make(0, 3)}}, count: 2}, ?room[0]);
    if (!(sel wrapped.list))   { ret 10; }
    if (wrapped.list.len != 2) { ret 10; }
    val second: mo.Value = wrapped.list.at[1];
    if (!(sel second.register))           { ret 11; }
    if (second.register != rf.make(0, 0)) { ret 11; }
    ret 0;
}

test append__a_tied_operand_is_held_to_its_destination {
    var a: allocator.Allocator;
    page.make(?a);
    var f: Function = init(?a, ?T_SET);
    fin { dnit(?f); }
    val general: Class = class.hardware(?T_FILE, 0);
    var b:       [3]Block;
    var k:       u32   = 0;
    for (k < 3) {
        val made: res[Block, Error] = block(?f);
        if (sel made.err) { ret 1; }
        b[k] = made.ok;
        k    = k + 1;
    }
    var v: [3]Virtual;
    k = 0;
    for (k < 3) {
        val made: res[Virtual, Error] = virtual(?f, general);
        if (sel made.err) { ret 1; }
        v[k] = made.ok;
        k    = k + 1;
    }
    val add:  Opcode  = Opcode.row{?T_ROWS[1]};
    val load: Opcode  = Opcode.row{?T_ROWS[2]};
    val jump: Opcode  = Opcode.row{?T_ROWS[3]};
    val bnz:  Opcode  = Opcode.row{?T_ROWS[4]};
    val tied: Operand = Operand.tied{Tied{dest: Register.virtual{v[1]}, source: Register.virtual{v[0]}}};

    # the entry jumps into a loop whose body is a two-address add
    var enter: [1]Operand = [1]Operand{Operand.block{b[1]}};
    if (!t_ok(t_append(?f, b[0], jump, ?enter[0], 1))) { ret 2; }
    var bump: [2]Operand = [2]Operand{tied, Operand.virtual{v[2]}};
    if (!t_ok(t_append(?f, b[1], add, ?bump[0], 2))) { ret 2; }
    var back: [2]Operand = [2]Operand{Operand.virtual{v[1]}, Operand.block{b[1]}};
    if (!t_ok(t_append(?f, b[1], bnz, ?back[0], 2))) { ret 2; }
    var leave: [1]Operand = [1]Operand{Operand.block{b[2]}};
    if (!t_ok(t_append(?f, b[1], jump, ?leave[0], 1))) { ret 2; }

    # a tie stands only where the row reads and writes one register
    var written: [2]Operand       = [2]Operand{tied, Operand.slot{Slot{index: 0}}};
    val s:       res[Slot, Error] = slot(?f, fixed_slot(4, 4));
    if (sel s.err)                                                                      { ret 3; }
    if (!t_refused(t_append(?f, b[1], load, ?written[0], 2), 0, instruction.TIED_ROLE)) { ret 3; }

    # once assigned, both halves are one location
    var apart: [2]Operand = [2]Operand{Operand.tied{Tied{dest: Register.physical{Physical.register{rf.make(0, 0)}}, source: Register.physical{Physical.register{rf.make(0, 1)}}}}, reg(2)};
    if (!t_refused(t_append(?f, b[1], add, ?apart[0], 2), 0, instruction.UNTIED)) { ret 4; }
    var one: [2]Operand = [2]Operand{Operand.tied{Tied{dest: Register.physical{Physical.register{rf.make(0, 2)}}, source: Register.physical{Physical.register{rf.make(0, 2)}}}}, reg(1)};
    if (!t_ok(t_append(?f, b[1], add, ?one[0], 2))) { ret 4; }

    # dominance and loop nesting run unchanged on the machine blocks
    val got: res[Graph, allocator.Error] = graph_of(?f);
    if (sel got.err) { ret 5; }
    var g: Graph = got.ok;
    fin { graph.dnit(?g); }
    val dom: res[Dominance, allocator.Error] = dominance.compute(?a, ?g);
    if (sel dom.err) { ret 5; }
    var d: Dominance = dom.ok;
    fin { dominance.dnit(?d); }
    val nest: res[Loops, allocator.Error] = loops.compute(?a, ?g, ?d);
    if (sel nest.err) { ret 5; }
    var l: Loops = nest.ok;
    fin { loops.dnit(?l); }
    val exit: opt[u32] = dominance.idom(?d, 2);
    if (!(sel exit.some && exit.some == 1) || !dominance.dominates(?d, 0, 2))          { ret 6; }
    if (loops.count(?l) != 1 || loops.loop(?l, 0).header != 1)                         { ret 7; }
    if (loops.depth(?l, 1) != 1 || loops.depth(?l, 0) != 0 || loops.depth(?l, 2) != 0) { ret 7; }
    ret 0;
}
