    scales:         nil,
    scale_count:    0,
    classes:        ?T_CLASSES[0],
    class_count:    1,
    class_names:    index.Index{at: ?T_CLASS_NAMES[0], len: 1},
    registers:      ?T_REGISTERS[0],
    register_count: 4,
    aliases:        nil,
