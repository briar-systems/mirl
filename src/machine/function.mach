# sixteen bytes of memory a target names as registers
#[testing]
pub val T_PAGE: Memory = Memory{name: "page", width: 8, count: 16};

#[testing]
fun t_append(f: *Function, b: Block, op: Opcode, operands: *Operand, count: usize) res[Instruction, Error] {
    var md: Metadata;
    ret append(f, b, op, Slice[Operand]{data: operands, size: count}, md, false, vstate.NONE);
}

#[testing]
fun t_ok(r: res[Instruction, Error]) bool {
    ret sel r.ok;
}

#[testing]
fun t_refused(r: res[Instruction, Error], at: u32, what: str) bool {
    ret sel r.err && (sel r.err.refused && (r.err.refused.operand == at && r.err.refused.what == what));
}

#[testing]
fun reg(n: u16) Operand {
    ret Operand.physical{Physical.register{rf.make(0, n)}};
}

test append__fixed_operands_come_from_the_row {
    var a: allocator.Allocator;
    page.make(?a);
    var f: Function = init(?a, ?T_SET);
    fin { dnit(?f); }
    val general: Class             = class.hardware(?T_FILE, 0);
    val b:       res[Block, Error] = block(?f);
    if (sel b.err) { ret 1; }
    var v: [3]Operand;
    var k: u32 = 0;
    for (k < 3) {
        val made: res[Virtual, Error] = virtual(?f, general);
        if (sel made.err) { ret 1; }
        v[k] = Operand.virtual{made.ok};
        k    = k + 1;
    }
    val wide: Opcode                  = Opcode.row{?T_ROWS[0]};
    val made: res[Instruction, Error] = t_append(?f, b.ok, wide, ?v[0], 3);
    if (sel made.err) { ret 2; }
    val low:  opt[rf.Id] = fixed(?f, made.ok, 0);
    val high: opt[rf.Id] = fixed(?f, made.ok, 1);
    val src:  opt[rf.Id] = fixed(?f, made.ok, 2);
    if (!(sel low.some && low.some == rf.id_of(?T_REGISTERS[0])))   { ret 3; }
    if (!(sel high.some && high.some == rf.id_of(?T_REGISTERS[1]))) { ret 3; }
    if (!sel src.none)                                              { ret 3; }
    var wrong: [3]Operand = [3]Operand{reg(2), reg(1), reg(3)};
    if (!t_refused(t_append(?f, b.ok, wide, ?wrong[0], 3), 0, instruction.FIXED)) { ret 4; }
    var right: [3]Operand = [3]Operand{reg(0), reg(1), reg(3)};
    if (!t_ok(t_append(?f, b.ok, wide, ?right[0], 3))) { ret 5; }
    var swapped: [3]Operand = [3]Operand{reg(0), reg(2), reg(1)};
    if (!t_refused(t_append(?f, b.ok, wide, ?swapped[0], 3), 1, instruction.FIXED)) { ret 6; }
    ret 0;
}

