# machine functions: blocks, instructions, virtual registers and frame slots
#
# a function is made for one instruction set of masc, the target's, whose
# register file and catalog rows every instruction is checked against when it
# is appended. its first block is its entry.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
