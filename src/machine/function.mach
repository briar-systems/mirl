#[testing]
val T_OFFSET: mo.Immediate = mo.Immediate{bits: 16, signed: true, scale: 0, bias: 0, fixup: 1, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

# a widening multiply whose low half and high half are fixed to r0 and r1
#[testing]
val T_WIDE_OPERANDS: [3]mo.Operand = [3]mo.Operand{
    mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.READ_WRITE, width: 32, quantity: mo.ONE},
    mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.WRITE, width: 32, quantity: mo.ONE},
    mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.READ, width: 32, quantity: mo.ONE},
};

