    columns:        nil,
    column_count:   0,
};

#[testing]
val T_GENERAL: [1]u16 = [1]u16{0};

#[testing]
val T_REG: mo.Register = mo.Register{classes: mo.Classes{at: ?T_GENERAL[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}};

#[testing]
val T_NONE: mo.Register = mo.Register{classes: mo.Classes{at: nil, len: 0}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}};

#[testing]
