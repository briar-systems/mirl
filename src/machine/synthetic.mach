# a synthetic instruction set, for the tests of the machine form
#
# no registry of the tree holds this set, so a test hands the text form this
# registry, architecture row and memory-backed classes as data, and the text
# form resolves its environment from them as it does from a target of the tree.

use std.types.option.opt;

use std.collections.slice.Slice;

use masc;
use mink;
use mirl.machine.class.Memory;
use mirl.machine.function;

use masc.core.spelling;

# the architecture row the set serves, which no catalog names
#[testing]
pub val ARCH: mink.arch.Arch = mink.arch.Arch{name: "mtest", codes: nil, code_count: 0, pointer_bytes: 8, order: mink.reader.LITTLE, page_size: 0x1000, unwind: opt[mink.arch.Unwind].none{}, caps: mink.arch.ADDRESSED};

#[testing]
val ARCHES: [1]*mink.arch.Arch = [1]*mink.arch.Arch{?ARCH};

#[testing]
pub val SET: masc.set.Set = masc.set.Set{arches: masc.set.Arches{at: ?ARCHES[0], len: 1}, codec: ?function.T_CODEC, extensions: nil, bindings: masc.set.Bindings{at: nil, len: 0}, relax: masc.relax.Relaxations{at: nil, len: 0}, fill: nil, syntaxes: spelling.Syntaxes{at: nil, len: 0}};

#[testing]
val SETS: [1]*masc.set.Set = [1]*masc.set.Set{?SET};

#[testing]
pub val REGISTRY: masc.set.Registry = masc.set.Registry{sets: ?SETS[0], count: 1};

# the memory-backed classes the set supplies
#[testing]
pub val MEMORIES: Slice[Memory] = Slice[Memory]{data: ?function.T_PAGE, size: 1};
