# a synthetic instruction set, for the tests of the machine form
#
# no registry of the tree holds this set, so a test hands the text form this
# registry, architecture row and memory-backed classes as data, and the text
# form resolves its environment from them as it does from a target of the tree.

use std.types.option.opt;

use std.collections.slice.Slice;

use arches: mink.catalog.arch;
use mink.reader;
use mirl.machine.class.Memory;
use mirl.machine.function;

use masc.core.relax;
use masc.core.set;
use masc.core.spelling;

# the architecture row the set serves, which no catalog names
#[testing]
pub val ARCH: arches.Arch = arches.Arch{name: "mtest", codes: nil, code_count: 0, pointer_bytes: 8, order: reader.LITTLE, page_size: 0x1000, unwind: opt[arches.Unwind].none{}, caps: arches.ADDRESSED};

#[testing]
val ARCHES: [1]*arches.Arch = [1]*arches.Arch{?ARCH};

#[testing]
pub val SET: set.Set = set.Set{arches: set.Arches{at: ?ARCHES[0], len: 1}, codec: ?function.T_CODEC, extensions: nil, bindings: set.Bindings{at: nil, len: 0}, relax: relax.Relaxations{at: nil, len: 0}, fill: nil, syntaxes: spelling.Syntaxes{at: nil, len: 0}};

#[testing]
val SETS: [1]*set.Set = [1]*set.Set{?SET};

#[testing]
pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 1};

# the memory-backed classes the set supplies
#[testing]
pub val MEMORIES: Slice[Memory] = Slice[Memory]{data: ?function.T_PAGE, size: 1};
