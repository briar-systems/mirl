# a synthetic instruction set, for the tests of the machine form
#
# no registry of the tree holds this set, so a test hands the text form this
# registry, architecture row and memory-backed classes as data, and the text
# form resolves its environment from them as it does from a target of the tree.

use std.types.option.opt;
use std.types.result.res;

use std.allocator;

use std.collections.slice.Slice;

use masc.core.extension;
use rf: masc.core.register;
use masc.core.relax;
use masc.core.requirement;
use masc.core.set;
use core_state: masc.core.state;
use mink.bytes.reader;
use arches:   mink.catalog.arch;
use mink_isa: mink.catalog.isa;
use mink.model.reloc;

use core_fixup: masc.core.fixup;

use mirl.machine.class.Memory;
use mirl.machine.function;

# the family of the architecture row, which states no traits and no abis
#[testing]
pub val FAMILY: arches.Family = arches.Family{name: "mtest", axes: nil, axis_count: 0, grammar: opt[*mink_isa.Grammar].none{}, abis: nil, abi_count: 0};

# the architecture row the set serves, which no catalog names
#[testing]
pub val ARCH: arches.Arch = arches.Arch{
    name:         "mtest",
    family:       ?FAMILY,
    code:         nil,
    code_count:   0,
    pointer:      opt[arches.Pointer].some{arches.Pointer{bytes: 8}},
    address_unit: 1,
    order:        reader.LITTLE,
    pages:        opt[arches.Pages].some{arches.Pages{size: 0x1000, max: 0x1000}},
    spaces:       1,
    unwind:       opt[arches.Unwind].none{},
    caps:         arches.ADDRESSED,
    axes:         nil,
    axis_count:   0,
    fixed:        nil,
    fixed_count:  0,
};

#[testing]
val ARCHES: [1]set.Arch = [1]set.Arch{set.Arch{arch: ?ARCH, enters: requirement.NO_ALTERNATIVES, frame: nil}};

# the relocation kinds the set's fixups become, which its text names
#[testing]
val BINDINGS: [2]core_fixup.Binding = [2]core_fixup.Binding{core_fixup.Binding{fixup: 1, kind: ?reloc.ABS32}, core_fixup.Binding{fixup: 2, kind: ?reloc.PC32}};

#[testing]
pub val SET: set.Set = set.Set{arches: set.Arches{at: ?ARCHES[0], len: 1}, codec: ?function.T_CODEC, extensions: nil, bindings: core_fixup.Bindings{at: ?BINDINGS[0], len: 2}, relax: relax.Relaxations{at: nil, len: 0}, fill: nil};

#[testing]
val SETS: [1]*set.Set = [1]*set.Set{?SET};

#[testing]
pub val REGISTRY: set.Registry = set.Registry{sets: ?SETS[0], count: 1};

# the memory-backed classes the set supplies
#[testing]
pub val MEMORIES: Slice[Memory] = Slice[Memory]{data: ?function.T_PAGE, size: 1};

# a context of set `s` with nothing selected, every axis at its initial value,
# for a set whose rows and registers require nothing. `none` is made the empty
# selection and the view is made into `view`, both kept for as long as the
# context
#[testing]
pub fun context(a: *allocator.Allocator, s: *set.Set, none: *extension.Selection, view: *rf.Available) res[core_state.Context, core_state.Opened] {
    @none = extension.Selection{catalog: nil, stated: extension.Stated{len: 0}};
    var file: *rf.File = nil;
    if (s.codec != nil) { file = s.codec.registers; }
    ret core_state.open(a, file, none, ?s.states, core_state.initial(?s.states), view);
}
