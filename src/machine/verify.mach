# the machine form verifier, which a checked compilation runs after every stage
#
# a function holds when every instruction a block places is one of its own,
# placed once, and stands against its opcode's row in the function as it is
# now: its virtual registers, slots and blocks, and, while its markers state
# where its slots' storage lasts, the storage rule (`mirl.machine.lifetime`). a stage
# that rewrites an instruction in place is checked here against the same rules
# an appended instruction meets. it is linear in the operands, and the storage
# rule in the operands, the blocks and the reaches of its marked slots.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.vector;

use mfunction: mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.NO_OPERAND;
use mirl.machine.lifetime;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;

pub val FOREIGN: str = "instruction the function does not have";
pub val TWICE:   str = "instruction placed in more than one place";

# an instruction that does not hold
# ---
# block:   the block that places it
# at:      the instruction
# refusal: the fact that does not hold, and the operand it is at
pub rec Unheld {
    block:   Block;
    at:      Instruction;
    refusal: instruction.Error;
}

# why a function was not verified
# ---
# alloc: the allocator refused storage
# fault: an instruction does not hold
pub tag Error: u8 {
    alloc: allocator.Error;
    fault: Unheld;
}

# the allocator's refusal `e` stands for, its own or a step's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    ret opt[allocator.Error].none{};
}

fun fault(b: usize, i: Instruction, operand: u32, what: str) err[Error] {
    ret err[Error].err{Error.fault{Unheld{block: (b::u32), at: i, refusal: instruction.Error{operand: operand, what: what}}}};
}

# hold a function of the machine form to the storage rule (`mirl.machine.lifetime`)
# ---
# a:   the allocator the rule takes
# f:   the function, whose markers still state where its slots' storage lasts
# ret: ok, or the first marker or access that does not hold
pub fun storage(a: *allocator.Allocator, f: *Function) err[Error] {
    val res_kept: res[opt[lifetime.Finding], allocator.Error] = lifetime.check(a, f);
    if (sel res_kept.err)     { ret err[Error].err{Error.alloc{res_kept.err}}; }
    if (sel res_kept.ok.none) { ret err[Error].ok{}; }
    val x:       lifetime.Finding = res_kept.ok.some;
    var operand: u32              = NO_OPERAND;
    if (x.operand != lifetime.WHOLE) { operand = x.operand; }
    ret fault(x.block::usize, x.at, operand, x.what);
}

# verify a function of the machine form
# ---
# a:      the allocator the walk takes
# f:      the function
# scoped: its markers still state where its slots' storage lasts, so it is held to the storage rule
# ret:    ok, or the first instruction that does not hold
pub fun function(a: *allocator.Allocator, f: *Function, scoped: bool) err[Error] {
    var placed: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?placed); }
    var k: usize = 0;
    for (k < f.instructions.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[bool](?placed, false);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        k = k + 1;
    }
    var b: usize = 0;
    for (b < f.blocks.len) {
        val list: *vector.Vector[Instruction] = ?f.blocks.data[b].instructions;
        var j:    usize                       = 0;
        for (j < list.len) {
            val i: Instruction = list.data[j];
            if (i::usize >= f.instructions.len) { ret fault(b, i, NO_OPERAND, FOREIGN); }
            if (placed.data[i])                 { ret fault(b, i, NO_OPERAND, TWICE); }
            placed.data[i] = true;
            val d:         *InstructionData       = ?f.instructions.data[i];
            val err_stood: err[instruction.Error] = mfunction.check(f, d.opcode, d.operands, d.state);
            if (sel err_stood.err) { ret fault(b, i, err_stood.err.operand, err_stood.err.what); }
            j = j + 1;
        }
        b = b + 1;
    }
    if (scoped) { ret storage(a, f); }
    ret err[Error].ok{};
}
