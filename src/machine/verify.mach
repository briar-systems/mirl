# the machine form verifier, which a checked compilation runs after every stage
#
# a function holds when every instruction a block places is one of its own,
# placed once, and stands against its opcode's row in the function as it is
# now: its virtual registers, slots and blocks. a stage that rewrites an
# instruction in place is checked here against the same rules an appended
# instruction meets. it is linear in the operands.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.vector;

use mfunction: mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.NO_OPERAND;
use mirl.machine.instruction.Refusal;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;

pub val FOREIGN: str = "instruction the function does not have";
pub val TWICE:   str = "instruction placed in more than one place";

# an instruction that does not hold
# ---
# block:   the block that places it
# at:      the instruction
# refusal: the fact that does not hold, and the operand it is at
pub rec Fault {
    block:   Block;
    at:      Instruction;
    refusal: Refusal;
}

# why a function was not verified
# ---
# alloc: the allocator refused storage
# fault: an instruction does not hold
pub tag Error: u8 {
    alloc: allocator.Error;
    fault: Fault;
}

fun fault(b: usize, i: Instruction, operand: u32, what: str) err[Error] {
    ret err[Error].err{Error.fault{Fault{block: Block{index: b::u32}, at: i, refusal: Refusal{operand: operand, what: what}}}};
}

# verify a function of the machine form
# ---
# a:   the allocator the walk takes
# f:   the function
# ret: ok, or the first instruction that does not hold
pub fun function(a: *allocator.Allocator, f: *Function) err[Error] {
    var placed: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?placed); }
    var k: usize = 0;
    for (k < f.instructions.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?placed, false);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        k = k + 1;
    }
    var b: usize = 0;
    for (b < f.blocks.len) {
        val list: *vector.Vector[Instruction] = ?f.blocks.data[b].instructions;
        var j:    usize                       = 0;
        for (j < list.len) {
            val i: Instruction = list.data[j];
            if (i.index::usize >= f.instructions.len) { ret fault(b, i, NO_OPERAND, FOREIGN); }
            if (placed.data[i.index])                 { ret fault(b, i, NO_OPERAND, TWICE); }
            placed.data[i.index] = true;
            val d:     *InstructionData = ?f.instructions.data[i.index];
            val stood: err[Refusal]     = mfunction.check(f, d.opcode, d.operands, d.state);
            if (sel stood.err) { ret fault(b, i, stood.err.operand, stood.err.what); }
            j = j + 1;
        }
        b = b + 1;
    }
    ret err[Error].ok{};
}
