# the name a section of each kind takes when the module states none
#
# the name a format gives a section of a kind is mink's fact, and these mirror
# it until mink names a section by its kind. one name per kind, so the globals
# that state no section share one section of each kind.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use mink.model.section;

# a kind and the name its section takes
rec Named {
    kind: *section.Kind;
    name: str;
}

def Names: [7]Named;

val NAMES: Names = [7]Named{
    Named{kind: ?section.TEXT, name: ".text"},
    Named{kind: ?section.RODATA, name: ".rodata"},
    Named{kind: ?section.RELRO_DATA, name: ".data.rel.ro"},
    Named{kind: ?section.DATA, name: ".data"},
    Named{kind: ?section.BSS, name: ".bss"},
    Named{kind: ?section.TLS_DATA, name: ".tdata"},
    Named{kind: ?section.TLS_BSS, name: ".tbss"},
};

# the name a section of a kind takes, none for a kind no code or global is placed in by default
pub fun name_of(k: *section.Kind) opt[str] {
    var i: usize = 0;
    for (i < $length_of(Names)) {
        if (NAMES[i].kind == k) { ret opt[str].some{NAMES[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}
