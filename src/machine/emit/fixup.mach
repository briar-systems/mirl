# the set's fixup kind for a relocation kind
#
# a machine operand names the relocation kind it is applied under, a row of
# mink's vocabulary, and masc's operands name the set's own fixup kinds, which
# the set binds to those rows. this is the set's bindings read backwards, an
# index built once and searched by the kind.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.sort;
use std.collections.vector;

use mink.model.reloc;

use mo:   masc.core.operand;
use mset: masc.core.set;

# one binding, by the address of the kind it binds
# ---
# kind:  the relocation kind
# fixup: the fixup kind bound to it
rec Pair {
    kind:  *reloc.Kind;
    fixup: mo.FixupKind;
}

# the bindings of one set, ordered by kind
pub rec Index {
    pairs: vector.Vector[Pair];
}

# what a relocation kind comes to in a set
# ---
# bound:     the fixup kind
# unbound:   the set binds no fixup kind to it
# ambiguous: the set binds several and the operand's own is none of them
pub tag Found: u8 {
    bound: mo.FixupKind;
    unbound;
    ambiguous;
}

fun before(a: *Pair, b: *Pair) i64 {
    val x: u64 = a.kind:~u64;
    val y: u64 = b.kind:~u64;
    if (x < y)             { ret -1; }
    if (x > y)             { ret 1; }
    if (a.fixup < b.fixup) { ret -1; }
    if (a.fixup > b.fixup) { ret 1; }
    ret 0;
}

# index a set's bindings
pub fun make(a: *allocator.Allocator, s: *mset.Set) res[Index, allocator.Error] {
    var out:  Index                       = Index{pairs: vector.init[Pair](a)};
    val room: res[usize, allocator.Error] = vector.reserve[Pair](?out.pairs, s.bindings.len::usize);
    if (sel room.err) {
        vector.dnit[Pair](?out.pairs);
        ret res[Index, allocator.Error].err{room.err};
    }
    var i: u32 = 0;
    for (i < s.bindings.len) {
        vector.push[Pair](?out.pairs, Pair{kind: s.bindings.at[i].kind, fixup: s.bindings.at[i].fixup});
        i = i + 1;
    }
    sort.sort_by[Pair](out.pairs.data, out.pairs.len, before);
    ret res[Index, allocator.Error].ok{out};
}

# give back an index's storage
pub fun release(x: *Index) err[allocator.Error] {
    ret vector.dnit[Pair](?x.pairs);
}

# the fixup kind a relocation kind is applied as
# ---
# x:    the index
# kind: the relocation kind
# own:  the fixup kind the operand takes by default, preferred among several
pub fun find(x: *Index, kind: *reloc.Kind, own: mo.FixupKind) Found {
    val key: u64   = kind:~u64;
    var lo:  usize = 0;
    var hi:  usize = x.pairs.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if ((x.pairs.data[mid].kind:~u64) < key) { lo = mid + 1; }
        or                                       { hi = mid; }
    }
    if (lo >= x.pairs.len || x.pairs.data[lo].kind != kind) { ret Found.unbound{}; }
    var count: usize = 0;
    var first: usize = lo;
    var held:  bool  = false;
    for (first + count < x.pairs.len && x.pairs.data[first + count].kind == kind) {
        if (x.pairs.data[first + count].fixup == own) { held = true; }
        count = count + 1;
    }
    if (held)       { ret Found.bound{own}; }
    if (count == 1) { ret Found.bound{x.pairs.data[first].fixup}; }
    ret Found.ambiguous{};
}
