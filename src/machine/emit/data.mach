# the image of a global's initial value: its bytes and the addresses in it
#
# the bytes are laid out by the target's data layout in the architecture's
# byte order, every bit the constant does not state zero. an address is a
# datum the object relocates, at its offset and of its pointer's width, and
# its bytes stay zero for the relocation to fill.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use std.encoding.binary;

use mirl.ir.constant.Address;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.id;
use mirl.ir.module;
use mirl.ir.module.Module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.slice;
use mirl.target.capability.Extent;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

# an address in an image
# ---
# offset: where it starts
# symbol: the function or global it is the address of
# addend: added to that address
# width:  its width in bytes
pub rec Datum {
    offset: u64;
    symbol: id.Symbol;
    addend: i64;
    width:  u64;
}

# the image of one initial value
# ---
# bytes:  its bytes, zero where an address is
# datums: its addresses, by offset
pub rec Image {
    bytes:  vector.Vector[u8];
    datums: vector.Vector[Datum];
}

# why an image was not made
# ---
# alloc:  the allocator refused storage
# layout: the data layout gives a part of it no extent
# ir:     the module refused a read of a constant or a type
pub tag Error: u8 {
    alloc:  allocator.Error;
    layout: record.Error;
    ir:     module.Error;
}

# what one image is made against
rec Writer {
    a:     *allocator.Allocator;
    m:     *Module;
    l:     *Layout;
    space: u32;
    order: binary.Order;
    out:   *Image;
}

fun extent(w: *Writer, ty: Type) res[Extent, Error] {
    val e: res[Extent, record.Error] = layout.extent(w.l, ty, w.space);
    if (sel e.err) { ret res[Extent, Error].err{Error.layout{e.err}}; }
    ret res[Extent, Error].ok{e.ok};
}

# a number's bits over its extent, low word first, in the image's byte order
fun number(w: *Writer, b: Bits, at: u64) err[Error] {
    val e: res[Extent, Error] = extent(w, b.type);
    if (sel e.err) { ret err[Error].err{e.err}; }
    var k: u64 = 0;
    for (k < e.ok.size) {
        val word: usize = (k / 8)::usize;
        if (word < b.words.size) {
            val byte: u8  = ((b.words.data[word] >> ((k % 8) * 8)) & 0xff)::u8;
            var to:   u64 = at + k;
            if (w.order == binary.BIG) { to = at + e.ok.size - 1 - k; }
            w.out.bytes.data[to::usize] = byte;
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# each element of an aggregate at its offset
fun elements(w: *Writer, ty: Type, list: Slice[id.Constant], at: u64) err[Error] {
    val s: res[types.Shape, types.Error] = types.shape(?w.m.types, ty);
    if (sel s.err) { ret err[Error].err{Error.ir{module.Error.types{s.err}}}; }
    if (sel s.ok.structure) {
        val room: res[*u64, allocator.Error] = allocator.allocate[u64](w.a, list.size + 1);
        if (sel room.err) { ret err[Error].err{Error.alloc{room.err}}; }
        fin { allocator.deallocate[u64](w.a, room.ok, list.size + 1); }
        val laid: err[record.Error] = layout.offsets(w.l, ty, w.space, room.ok);
        if (sel laid.err) { ret err[Error].err{Error.layout{laid.err}}; }
        var i: usize = 0;
        for (i < list.size) {
            val put: err[Error] = constant(w, list.data[i], at + room.ok[i]);
            if (sel put.err) { ret put; }
            i = i + 1;
        }
        ret err[Error].ok{};
    }
    var step: u64 = 0;
    if (sel s.ok.array) {
        val laid: res[u64, record.Error] = layout.stride(w.l, ty, w.space);
        if (sel laid.err) { ret err[Error].err{Error.layout{laid.err}}; }
        step = laid.ok;
    }
    or (sel s.ok.vector) {
        val e: res[Extent, Error] = extent(w, s.ok.vector.element);
        if (sel e.err) { ret err[Error].err{e.err}; }
        step = e.ok.size;
    }
    or {
        ret err[Error].err{Error.ir{module.Error.mismatch{ty}}};
    }
    var i: usize = 0;
    for (i < list.size) {
        val put: err[Error] = constant(w, list.data[i], at + i::u64 * step);
        if (sel put.err) { ret put; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# a constant at its offset
fun constant(w: *Writer, c: id.Constant, at: u64) err[Error] {
    val got: res[ConstantData, module.Error] = module.constant_data(w.m, c);
    if (sel got.err) { ret err[Error].err{Error.ir{got.err}}; }
    val d: ConstantData = got.ok;
    if (sel d.integer)   { ret number(w, d.integer, at); }
    or (sel d.float)     { ret number(w, d.float, at); }
    or (sel d.zero)      { ret err[Error].ok{}; }
    or (sel d.aggregate) { ret elements(w, d.aggregate.type, d.aggregate.elements, at); }
    val a: Address            = d.address;
    val e: res[Extent, Error] = extent(w, a.type);
    if (sel e.err) { ret err[Error].err{e.err}; }
    val pushed: res[usize, allocator.Error] = vector.push[Datum](?w.out.datums, Datum{offset: at, symbol: a.symbol, addend: a.offset, width: e.ok.size});
    if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
    ret err[Error].ok{};
}

# give back an image's storage
pub fun release(i: *Image) {
    vector.dnit[u8](?i.bytes);
    vector.dnit[Datum](?i.datums);
}

# the image of a constant
# ---
# a:     the allocator the image takes, the caller's to release
# m:     the module the constant is of
# l:     the layout of the module's types for the target
# space: the address space the constant is laid out in
# order: the architecture's byte order
# c:     the constant
# size:  its type's size
# ret:   its image, or why it has none, leaving nothing
pub fun image(a: *allocator.Allocator, m: *Module, l: *Layout, space: u32, order: binary.Order, c: id.Constant, size: u64) res[Image, Error] {
    var out:  Image                = Image{bytes: vector.init[u8](a), datums: vector.init[Datum](a)};
    val room: err[allocator.Error] = slice.fill[u8](?out.bytes, size::usize, 0);
    if (sel room.err) {
        release(?out);
        ret res[Image, Error].err{Error.alloc{room.err}};
    }
    var w:   Writer     = Writer{a: a, m: m, l: l, space: space, order: order, out: ?out};
    val put: err[Error] = constant(?w, c, 0);
    if (sel put.err) {
        release(?out);
        ret res[Image, Error].err{put.err};
    }
    ret res[Image, Error].ok{out};
}
