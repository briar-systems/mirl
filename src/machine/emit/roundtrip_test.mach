# the listing of each example program assembles through masc to mirl's own object

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;
use std.collections.vector;
use fs: std.filesystem;
use io: std.io.writer;

use mink.catalog.arch;
use mink.catalog.format.Format;
use mink.model.object;

use masc.asm.asm;
use masc.asm.dialect;
use masc.asm.model;
use masc.core.diagnostic;
use masc.core.mode;
use mset: masc.core.set;

use mirl.cli.cmd.emit;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.parse;
use mirl.ir.text.sink;
use mirl.machine.compile;
use mirl.machine.emit.emit_test;
use mirl.machine.emit.handover;
use mirl.pass.driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.abi.call;
use mirl.target.abi.convention.Convention;
use mirl.target.machine;
use mirl.target.machine.Machine;
use mirl.target.record;

# compile one example with its listing, reassemble the listing under the selection and traits the builder had, and
# compare the two objects, a nameless symbol by its place. 0 or the step that failed
#[testing]
fun round_trips(a: *A.Allocator, path: str) i32 {
    val text: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel text.err) { ret 1; }
    val read: res[Module, parse.Refusal] = parse.parse_body(a, View{data: text.ok, len: str_len(text.ok)});
    if (sel read.err) { ret 2; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(module.target(?m));
    if (sel row.none) { ret 3; }
    val t:      *Target            = row.some;
    var mach:   Machine;
    val opened: err[machine.Error] = machine.open(?mach, a, t);
    if (sel opened.err) { ret 4; }
    fin { machine.close(?mach); }
    val ran: err[Error] = driver.run(?m, t, machine.whole(?mach), Options{level: 0, checked: true});
    if (sel ran.err) { ret 5; }

    var listed: sink.Sink = sink.init(a);
    fin { sink.dnit(?listed); }
    var out:  io.Writer                         = sink.writer(?listed);
    val made: res[object.Object, compile.Error] = compile.compile(a, ?m, ?mach, t, compile.Options{checked: true, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].some{?out}});
    if (sel made.err) { ret 6; }
    var own: object.Object = made.ok;
    fin { object.release(?own); }

    val arch:   res[*arch.Arch, record.Error] = record.arch(t);
    val format: res[*Format, record.Error]    = record.format(t);
    val conv:   res[*Convention, call.Error]  = call.of(t);
    if (sel arch.err)   { ret 7; }
    if (sel format.err) { ret 7; }
    if (sel conv.err)   { ret 7; }
    val traits:  res[mset.Traits, handover.Error] = handover.traits_of(conv.ok);
    val private: opt[str]                         = dialect.private_of(format.ok);
    if (sel traits.err)   { ret 8; }
    if (sel private.none) { ret 8; }
    val options: model.Options = model.Options{
        arch:    arch.ok,
        syntax:  0,
        traits:  traits.ok,
        private: private.some,
        layers:  model.NO_LAYERS,
        modes:   mode.Settings{at: nil, len: 0},
    };
    val source: View                              = sink.view(?listed);
    val again:  res[object.Object, model.Refusal] = asm.assemble(a, mach.basis.set, ?mach.registers, options, source.data, source.len, diagnostic.START);
    if (sel again.err) { ret 9; }
    var back: object.Object = again.ok;
    fin { object.release(?back); }
    if (!emit_test.same_object_by(?own, ?back, true)) { ret 10; }
    ret 0;
}

# what mirl asked the builder for, printed as source, assembles to exactly the bytes the builder encoded
test roundtrip__every_example_listing_assembles_to_its_own_object {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator                        = T.allocator_of(?t);
    val names: res[vector.Vector[str], fs.FsError] = fs.read_dir(a, emit.EXAMPLES);
    if (sel names.err) { ret 2; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirl")) {
            var buf:  [256]u8;
            val path: str = parse.path_in(?buf[0], emit.EXAMPLES, name);
            if (round_trips(a, path) != 0) { ret 3; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 4; }
    ret 0;
}
