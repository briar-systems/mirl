use mirl.target.machine.Machine;

use rf:   masc.core.register;
use rows: masc.core.row;
use masc.isa.riscv.gen_row;

#[testing]
val MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\nfunction @g: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# f calls g, g returns
#[testing]
val CALLS: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    jal x1, @g : jal20\n}\nfunction @g {\n^0:\n    jalr x0, x1, 0\n}\n";

# f takes the address of g with a pc-relative pair, calls it, and branches over nothing
#[testing]
val PAIRS: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    auipc x10, @g : pcrel_hi20 label 7\n    addi x10, x10, partner 7 : pcrel_lo12_i\n    auipc x1, @g : call_plt_pair\n    jalr x1, x1, 0\n    beq x10, x0, ^1\n^1:\n    jalr x0, x1, 0\n}\n";

#[testing]
val FILL: [2]u8 = [2]u8{0xAB, 0xAB};

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a test's allocator, module, target and its machine
#[testing]
rec Fixture {
    a:    allocator.Allocator;
    m:    Module;
    t:    Target;
    mach: Machine;
}

# open a fixture over the module's target, changed by `change` when it is not nil
#[testing]
fun open(x: *Fixture, change: fun(*Target)) bool {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, view_of(MODULE));
    if (sel made.err) { ret false; }
    x.m = made.ok;
    val row: opt[*Target] = targets.by_name(x.m.target);
    if (sel row.none) { ret false; }
    x.t = @row.some;
    if (change != nil) { change(?x.t); }
    val opened: err[machine.Error] = machine.open(?x.mach, ?x.a, ?x.t);
    ret sel opened.ok;
}

#[testing]
fun close(x: *Fixture) {
    machine.close(?x.mach);
    module.dnit(?x.m);
}

# the target changed to align functions to eight bytes and pad code with 0xAB
#[testing]
fun padded(t: *Target) {
    t.caps.code.function = Align.bytes{8};
    t.caps.code.fill     = Fill.pattern{Slice[u8]{data: ?FILL[0], size: 2}};
}

# the register named
#[testing]
fun named(x: *Fixture, name: str) rf.Id {
    val found: res[rf.Id, rf.Absent] = rf.lookup(?x.mach.registers, view_of(name));
    if (sel found.err) { ret rf.NONE; }
    ret found.ok;
}

# lay out each function of a text and emit them
#[testing]
fun object_of(x: *Fixture, u: *reader.Unit, out: *object.Object) i32 {
    var laid:  [2]Laid;
    var units: [2]Unit;
    var n:     usize = 0;
    for (n < u.items.len) {
        val made: res[Laid, lay.Error] = lay.lay(?x.a, ?u.items.data[n].function);
        if (sel made.err) { ret 1; }
        laid[n] = made.ok;
        val s: id.Symbol = u.items.data[n].symbol;
        if (!(sel s.function)) { ret 2; }
        units[n] = Unit{function: s.function, code: ?u.items.data[n].function, laid: ?laid[n]};
        n        = n + 1;
    }
    val done: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: ?units[0], size: u.items.len});
    n = 0;
    for (n < u.items.len) {
        lay.release(?laid[n]);
        n = n + 1;
    }
    if (sel done.err) { ret 3; }
    @out = done.ok;
    ret 0;
}

#[testing]
fun text_of(o: *object.Object) *object.Section {
    ret object.section_at(o, Id[object.Section]{index: 0});
}

# the symbol of an object named
#[testing]
fun symbol_named(o: *object.Object, name: str) opt[*object.Symbol] {
    var i: usize = 0;
    for (i < o.symbols.count) {
        val n: View = object.name_of(o, o.symbols.items[i].name);
        if (n.len == str_len(name)) {
            var k: usize = 0;
            for (k < n.len && n.data[k] == name[k]) {
                k = k + 1;
            }
            if (k == n.len) { ret opt[*object.Symbol].some{?o.symbols.items[i]}; }
        }
        i = i + 1;
    }
    ret opt[*object.Symbol].none{};
}

# where a symbol of an object is placed, -1 for one it lacks or does not place
#[testing]
fun placed_at(o: *object.Object, name: str) i64 {
    val s: opt[*object.Symbol] = symbol_named(o, name);
    if (sel s.none) { ret -1; }
    val d: object.Definition = s.some.def;
    if (sel d.placed) { ret d.placed.offset::i64; }
    ret -1;
}

# function alignment, the section's alignment and the pad between functions are the target's declaration
test emit__function_alignment_and_code_fill_follow_the_target {
    var x: Fixture;
    if (!open(?x, padded)) { ret 1; }
    fin { close(?x); }
    val read: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(CALLS));
    if (sel read.err) { ret 2; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var o:    object.Object;
    val made: i32 = object_of(?x, ?u, ?o);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?o); }
    # f is one four byte jump, g starts at the next eight and the gap is the target's fill
    if (placed_at(?o, "g") != 8) { ret 3; }
    val text: *object.Section = text_of(?o);
    if (text.align != 16) { ret 5; }
    val bytes: store.Bytes = object.bytes(?o, ?text.contents);
    if (bytes.len < 8) { ret 6; }
    var i: usize = 4;
    for (i < 8) {
        if (bytes.data[i] != 0xAB) { ret 7; }
        i = i + 1;
    }
    # the object states the float ABI its convention does
    val abi: opt[*trait.Trait] = trait.find(?o.traits, ?arch.RISCV_FLOAT_ABI);
    if (sel abi.none)                                  { ret 11; }
    if (!(sel abi.some.setting.choice))                { ret 12; }
    if (abi.some.setting.choice != ?arch.RISCV_DOUBLE) { ret 13; }
    # the target's own declaration, unchanged, aligns to two bytes and pads with zeros
    var plain: Fixture;
    if (!open(?plain, nil)) { ret 8; }
    fin { close(?plain); }
    val again: res[reader.Unit, Refusal] = reader.parse_body(?plain.a, ?plain.m, view_of(CALLS));
    if (sel again.err) { ret 9; }
    var v: reader.Unit = again.ok;
    fin { reader.dnit(?v); }
    var p:      object.Object;
    val second: i32 = object_of(?plain, ?v, ?p);
    if (second != 0) { ret 20 + second; }
    fin { object.release(?p); }
    if (placed_at(?p, "g") != 4) { ret 21; }
    ret 0;
}

# an append of a row with its operands, to a block of a function built in memory
#[testing]
fun append(f: *Function, b: Block, row: *rows.Row, operands: Slice[Operand], label: u32) bool {
    var md:   Metadata;
    val made: res[Instruction, function.Error] = function.append(f, b, Opcode.row{row}, operands, md, false);
    if (sel made.err) { ret false; }
    function.label(f, made.ok, label);
    ret true;
}

#[testing]
fun reg(x: *Fixture, name: str) Operand {
    ret Operand.physical{Physical.register{named(x, name)}};
}

# the function of PAIRS built in memory
#[testing]
fun pairs(x: *Fixture, f: *Function) bool {
    val g: id.Symbol                  = id.Symbol.function{id.Function{index: 1}};
    val a: res[Block, function.Error] = function.block(f);
    val z: res[Block, function.Error] = function.block(f);
    if (sel a.err) { ret false; }
    if (sel z.err) { ret false; }
    var hi: [2]Operand = [2]Operand{reg(x, "x10"), Operand.symbol{Symbol{symbol: g, addend: 0, kind: ?reloc.PCREL_HI20}}};
    var lo: [3]Operand = [3]Operand{reg(x, "x10"), reg(x, "x10"), Operand.partner{Partner{label: 7, kind: ?reloc.PCREL_LO12_I}}};
    var up: [2]Operand = [2]Operand{reg(x, "x1"), Operand.symbol{Symbol{symbol: g, addend: 0, kind: ?reloc.CALL_PLT_PAIR}}};
    var jr: [3]Operand = [3]Operand{reg(x, "x1"), reg(x, "x1"), Operand.immediate{0}};
    var br: [3]Operand = [3]Operand{reg(x, "x10"), reg(x, "x0"), Operand.block{z.ok}};
    var rt: [3]Operand = [3]Operand{reg(x, "x0"), reg(x, "x1"), Operand.immediate{0}};
    if (!append(f, a.ok, gen_row.AUIPC, Slice[Operand]{data: ?hi[0], size: 2}, 7))                    { ret false; }
    if (!append(f, a.ok, gen_row.ADDI, Slice[Operand]{data: ?lo[0], size: 3}, instruction.NO_LABEL))  { ret false; }
    if (!append(f, a.ok, gen_row.AUIPC, Slice[Operand]{data: ?up[0], size: 2}, instruction.NO_LABEL)) { ret false; }
    if (!append(f, a.ok, gen_row.JALR, Slice[Operand]{data: ?jr[0], size: 3}, instruction.NO_LABEL))  { ret false; }
    if (!append(f, a.ok, gen_row.BEQ, Slice[Operand]{data: ?br[0], size: 3}, instruction.NO_LABEL))   { ret false; }
    ret append(f, z.ok, gen_row.JALR, Slice[Operand]{data: ?rt[0], size: 3}, instruction.NO_LABEL);
}

#[testing]
fun same_name(a: *object.Object, x: Id[Name], b: *object.Object, y: Id[Name]) bool {
    val m: View = object.name_of(a, x);
    val n: View = object.name_of(b, y);
    if (m.len != n.len) { ret false; }
    var k: usize = 0;
    for (k < m.len) {
        if (m.data[k] != n.data[k]) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether two objects hold the same sections, symbols and relocations
#[testing]
fun same_object(a: *object.Object, b: *object.Object) bool {
    if (a.sections.count != b.sections.count || a.symbols.count != b.symbols.count || a.relocs.count != b.relocs.count) { ret false; }
    var i: usize = 0;
    for (i < a.sections.count) {
        val p: *object.Section = ?a.sections.items[i];
        val q: *object.Section = ?b.sections.items[i];
        if (p.kind != q.kind || p.flags != q.flags || p.align != q.align) { ret false; }
        val x: store.Bytes = object.bytes(a, ?p.contents);
        val y: store.Bytes = object.bytes(b, ?q.contents);
        if (x.len != y.len) { ret false; }
        var k: usize = 0;
        for (k < x.len) {
            if (x.data[k] != y.data[k]) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < a.symbols.count) {
        val p: *object.Symbol = ?a.symbols.items[i];
        val q: *object.Symbol = ?b.symbols.items[i];
        if (p.binding != q.binding || p.visibility != q.visibility || p.kind != q.kind) { ret false; }
        if (!same_name(a, p.name, b, q.name))                                           { ret false; }
        if (placed_in(p) != placed_in(q))                                               { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.relocs.count) {
        val p: *object.Reloc = ?a.relocs.items[i];
        val q: *object.Reloc = ?b.relocs.items[i];
        if (p.kind != q.kind || p.offset != q.offset || p.addend != q.addend) { ret false; }
        if (target_of(p) != target_of(q))                                     { ret false; }
        i = i + 1;
    }
    ret true;
}

# where a symbol is placed, -1 when it is not
#[testing]
fun placed_in(s: *object.Symbol) i64 {
    val d: object.Definition = s.def;
    if (sel d.placed) { ret d.placed.offset::i64; }
    ret -1;
}

# the symbol a relocation names, -1 when it names none
#[testing]
fun target_of(r: *object.Reloc) i64 {
    val t: object.Target = r.target;
    if (sel t.symbol) { ret t.symbol.index::i64; }
    ret -1;
}

# the same function handed over from memory and from its text is the same object
test emit__a_function_in_memory_and_as_text_gives_one_object {
    var x: Fixture;
    if (!open(?x, nil)) { ret 1; }
    fin { close(?x); }
    var f: Function = function.init(?x.a, x.mach.basis.set);
    fin { function.dnit(?f); }
    if (!pairs(?x, ?f)) { ret 2; }
    var laid: res[Laid, lay.Error] = lay.lay(?x.a, ?f);
    if (sel laid.err) { ret 3; }
    var l: Laid = laid.ok;
    fin { lay.release(?l); }
    var one:    [1]Unit                            = [1]Unit{Unit{function: id.Function{index: 0}, code: ?f, laid: ?l}};
    val direct: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: ?one[0], size: 1});
    if (sel direct.err) { ret 4; }
    var a: object.Object = direct.ok;
    fin { object.release(?a); }
    val read: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(PAIRS));
    if (sel read.err) { ret 5; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var b:    object.Object;
    val made: i32 = object_of(?x, ?u, ?b);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?b); }
    if (!same_object(?a, ?b)) { ret 6; }
    # the high part and its low part, the call and the marker its span states
    if (a.relocs.count != 4)                                                                          { ret 7; }
    if (a.relocs.items[0].kind != ?reloc.PCREL_HI20 || a.relocs.items[1].kind != ?reloc.PCREL_LO12_I) { ret 8; }
    if (a.relocs.items[2].kind != ?reloc.CALL_PLT_PAIR || a.relocs.items[3].kind != ?reloc.RELAX)     { ret 9; }
    # the low part names the instruction its partner operand labels, the high part
    val named: object.Target = a.relocs.items[1].target;
    if (!(sel named.symbol)) { ret 11; }
    val lo: *object.Symbol = object.symbol_at(?a, named.symbol);
    if (placed_in(lo) != a.relocs.items[0].offset::i64) { ret 10; }
    ret 0;
}
