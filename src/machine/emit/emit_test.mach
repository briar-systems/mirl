# tests of emission, machine form in and mink's object out, on the risc-v rows

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.catalog.arch;
use mink.catalog.trait;
use mink.intern.Name;
use mink.model.object;
use mink.model.reloc;
use mink.store;
use mink.table.Id;

use mirl.ir.id;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.machine.class.Physical;
use mirl.machine.emit.handover;
use mirl.machine.emit.handover.Unit;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.Opcode;
use mirl.machine.layout.lay;
use mirl.machine.layout.lay.Laid;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Partner;
use mirl.machine.operand.Symbol;
use reader:  mirl.machine.text.parse;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.capability.Align;
use mirl.target.capability.Fill;
