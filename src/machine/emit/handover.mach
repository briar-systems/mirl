# emission of the laid out machine form into masc, which encodes it into a
# mink object
#
# this is the last stage of a register machine. a function's blocks and
# instructions are handed to masc's instruction-level api in memory, one
# instruction at a time by the row it is and the operands it has, into the
# text section of one builder, and the builder hands back the object. mirl
# never encodes a byte and never writes an object file. the machine form text
# is the one text hand-over: a function read from it is the same function and
# emits the same object, and masc's listing of the result is for debugging.
#
# a block is an anonymous label of the builder, and a function is a named one
# exposed as a function symbol of its linkage, sized by its range: an
# anonymous label placed after its last instruction, before any padding that
# follows, which masc measures it to once it has laid the section out. a
# global with an initial value is a named label exposed as a data symbol of
# its linkage and size, in the section it states or, when it states none, the
# one nameless section of the kind its facts pick, which mink names as the
# format names a section of that kind, at its alignment, and its initial
# value is its bytes and a datum for each address in it. an instruction another names as a partner is a label of its own, so a pc-relative low part's relocation names
# its high part. an operand that names a symbol or a partner takes the fixup
# kind the set binds its relocation kind to, and a fixup whose relocation
# covers the instructions after it is written with them as one sequence, as
# the set's spans state. alignment and fill come from the target's code
# declaration.
#
# an inline assembly block is handed to masc whole, each of its operands at
# the location allocation gave it, and masc encodes it at the builder's
# cursor as the assembler encodes the same text.
#
# a function that requires constant time is a constant-time range of masc's
# builder, begun at its label and ended after its last instruction, which
# mink's object keeps in the order emitted for the walk of its bytes and the
# note the linker reads.
#
# a function whose architecture masc states a starting frame for is a frame
# of masc's builder, begun at its label and ended after its last instruction,
# and each call frame fact the frame stage stated is handed to masc in order
# at its instruction: before it, or after it for a fact that follows it. a
# module whose debug table states a source file hands masc its files once and
# each change of source location along the laid out code as a location before
# the instruction it begins at, an instruction with no location stated as
# line 0, never as a neighbour's. the dwarf producer then writes the debug
# sections from the variable ranges of each function, at labels placed before
# the instructions they begin and end at, and from the runs of code inlined at
# each site.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.natural;
use std.collections.slice.Slice;
use std.collections.vector;
use std.encoding.binary;

use masc.build.build;
use masc.core.mode;
use mo: masc.core.operand;
use masc.core.relax;
use masc_set:     masc.core.set;
use masc_cfi:     masc.emit.cfi;
use masc_emit:    masc.emit.emit;
use masc_line:    masc.emit.line;
use masc_listing: masc.emit.listing;
use masc_dialect: masc.format.dialect;
use masc_inline:  masc.inline.inline;
use arches:       mink.catalog.arch;
use mink_format:  mink.catalog.format;
use mink.catalog.format.Format;
use mink_line: mink.model.line;
use mink.model.object;
use mink.model.reloc;
use mink.model.section;
use mink.model.symbol;

use core_fixup: masc.core.fixup;
use core_state: masc.core.state;

use mirl.debug.dwarf;
use ia:       mirl.ir.assembly;
use ir_debug: mirl.ir.debug;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.id;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.module.Contents;
use mirl.ir.module.Module;
use mirl.ir.type.DEFAULT_SPACE;
use mirl.machine.class.Physical;
use mirl.machine.emit.data;
use mirl.machine.emit.fixup;
use mirl.machine.frame.record.Fact;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.inline.Inline;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.layout.lay.Laid;
use mirl.machine.operand;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.range.Range;
use mirl.machine.range.Ranges;
use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Unadmitted;
use mirl.target.address;
use mirl.target.address.Addresses;
use mirl.target.build.Build;
use mirl.target.capability.Align;
use mirl.target.capability.Extent;
use mirl.target.capability.Fill;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.record.Target;

use mirl.base.fail.keep;
use mirl.base.slice;

# one function to hand over
# ---
# function: the symbol of the module it is the code of
# code:     the function, allocated, framed and laid out
# laid:     the order its blocks are emitted in
# facts:    the call frame facts of its frame, at its instructions
# ranges:   where its variables are over its code, nil for nowhere
pub rec Unit {
    function: id.Function;
    code:     *Function;
    laid:     *Laid;
    facts:    Slice[Fact];
    ranges:   *Ranges;
}

# why an instruction was not handed over
# ---
# pseudo:    a pseudo-instruction or loop no stage expanded, which encodes to nothing
# unplaced:  a virtual register or a frame slot, which allocation and the frame replace
# cell:      a location of a memory-backed class, which no register machine holds in an object
# shape:     an operand of a kind its position does not take, an id position
#            given anything but a system register, or lists holding more
#            members than an instruction keeps room for
# unbound:   a relocation kind the set binds no fixup kind to
# ambiguous: a relocation kind the set binds several fixup kinds to, none the operand's own
# label:     a label two instructions hold, or inside a sequence, or a partner naming a label no instruction holds
# span:      a relocation covering more instructions than the block has after it
# fact:      a call frame fact at an instruction layout left in no block
pub tag Reason: u8 {
    pseudo;
    unplaced;
    cell;
    shape;
    unbound;
    ambiguous;
    label;
    span;
    fact;
}

# where and why an instruction was refused
# ---
# function: the function it is in
# at:       the instruction
# operand:  the operand position, NO_OPERAND for the instruction as a whole
# reason:   why
pub rec Refused {
    function: id.Function;
    at:       Instruction;
    operand:  u32;
    reason:   Reason;
}

# why a global was not placed
# ---
# contents: the module refused a read of its initial value
# model:    its initial value holds an address and the target states no address model
# section:  it names a section the code or another global names with another kind
# layout:   the data layout gives its type or a part of its initial value no extent
# width:    an address in its initial value is wider than any datum masc relocates
pub tag Fault: u8 {
    contents: module.Error;
    model;
    section;
    layout: record.Error;
    width;
}

# a global and why it was not placed
pub rec Misplaced {
    global: id.Global;
    fault:  Fault;
}

# a relocation the object's format does not map for the architecture, as masc refuses it
# ---
# symbol:  the function or global it aims at, none for a label the module does not name, as a block or a marker
# refusal: masc's refusal, whose object failure names the relocation kind and the format
pub rec Unmapped {
    symbol:  opt[id.Symbol];
    refusal: build.Refusal;
}

# why the object was not made
# ---
# alloc:      the allocator refused storage
# symbol:     a unit or an operand names a symbol the module does not have
# convention: the target's calling convention is not stated, so the psABI row its objects follow is not
# abi:        the convention leaves its psABI row unstated, or names one mink's catalog has not for the architecture
# fill:       the target's code fill is not one byte repeated, which masc's alignment takes, or is none where code is aligned
# builder:    masc refused
# unmapped:   the object's format maps no relocation of a kind the object needs
# refused:    an instruction cannot be handed over
# global:     a global cannot be placed
# format:     the target's system states no object format, whose default the object is built in
# dialect:    masc states no assembly dialect of the format, which the listing is written in
# listing:    masc refused to list the object it made
# debug:      the dwarf producer refused the module's debug information
pub tag Error: u8 {
    alloc:      allocator.Error;
    symbol:     module.Error;
    convention: call.Error;
    abi;
    fill;
    builder:  build.Refusal;
    unmapped: Unmapped;
    refused:  Refused;
    global:   Misplaced;
    format:   record.Error;
    dialect:  *Format;
    listing:  masc_listing.Refusal;
    debug:    dwarf.Error;
}

# the operand an instruction as a whole is refused at
pub val NO_OPERAND: u32 = instruction.NO_OPERAND;

# a section the builder has opened
# ---
# section: the builder's section
# kind:    the role it plays
rec Opened {
    section: build.Section;
    kind:    *section.Kind;
}

# what one emission reads and changes
# ---
# a:         the allocator
# m:         the module, whose symbols the operands name
# opened:    the target's build
# t:         the target
# l:         the layout of the module's types for the target
# order:     the architecture's byte order
# b:         the builder
# x:         the set's fixup kinds by relocation kind
# functions: the label of each function of the module, none until it is named
# ends:      the label ending each unit's function, by the unit's position
# emitters:  the position of the unit that emits each function of the module, none for one no unit emits
# globals:   the label of each global of the module, none until it is named
# sections:  each section opened with a name the module states, by its name
# kinds:     the one nameless section of each kind opened, by its kind, re-entered by its handle since it has no name
# fill:      the byte code is padded with, none when code is not padded
# function:  the alignment of a function's entry, none when it has none
# framed:    whether masc states a starting frame for the architecture, so each function is a frame
# lines:     the line facts handed to masc, valid while the builder is
# stated:    whether the module states source files, so its code carries line facts
# spans:     where every variable is, over the labels of every unit
# runs:      the code inlined at each site, over the labels of every unit
# programs:  each unit's first span and run and their counts
rec Emitter {
    a:         *allocator.Allocator;
    m:         *Module;
    opened:    *Build;
    t:         *Target;
    l:         Layout;
    order:     binary.Order;
    b:         *build.Builder;
    x:         *fixup.Index;
    functions: vector.Vector[opt[build.Label]];
    ends:      vector.Vector[build.Label];
    emitters:  vector.Vector[opt[u32]];
    globals:   vector.Vector[opt[build.Label]];
    sections:  map.MapBy[View, Opened];
    kinds:     map.MapBy[*section.Kind, build.Section];
    fill:      opt[u8];
    function:  opt[u64];
    framed:    bool;
    lines:     masc_line.Lines;
    stated:    bool;
    spans:     vector.Vector[dwarf.Span];
    runs:      vector.Vector[dwarf.Run];
    programs:  vector.Vector[Program];
}

# where one unit's spans and runs are among the emission's
# ---
# function: the function
# start:    its label
# end:      the label after its last instruction
# spans:    its first span
# span:     how many spans it has
# runs:     its first run
# run:      how many runs it has
rec Program {
    function: id.Function;
    start:    build.Label;
    end:      build.Label;
    spans:    usize;
    span:     usize;
    runs:     usize;
    run:      usize;
}

# a label placed before an instruction a range begins or ends at, or at its
# block's end when layout left the instruction in no block
# ---
# label:   the label
# block:   the block the instruction is in
# defined: whether it is placed yet
rec Mark {
    label:   build.Label;
    block:   u32;
    defined: bool;
}

# what one function emits against
# ---
# e:      the emission
# u:      the function
# blocks: the label of each block
# marks:  the label of each instruction a partner operand names, by the number the function gives it
# facts:  per instruction, its first call frame fact, NONE for none
# next:   per fact, the next fact at its instruction, NONE after the last
# given:  per fact, whether it was handed to masc
# ranged: the label before each instruction a range begins or ends at, by its id
# ends:   the label at the end of each laid out block, made when the unit has ranges
# site:   the site the code being emitted was inlined at, none for none
# run:    the label the current run of inlined code began at
# at:     the source location last stated, none for none
# spoke:  whether a location was stated for the unit yet
rec Body {
    e:      *Emitter;
    u:      Unit;
    blocks: vector.Vector[build.Label];
    marks:  map.Map[u32, build.Label];
    facts:  vector.Vector[u32];
    next:   vector.Vector[u32];
    given:  vector.Vector[bool];
    ranged: map.Map[u32, Mark];
    ends:   vector.Vector[opt[build.Label]];
    site:   opt[ir_debug.Site];
    run:    build.Label;
    at:     opt[ir_debug.Location];
    spoke:  bool;
}

val NONE: u32 = 0xffffffff;

fun refused(b: *Body, at: Instruction, operand: u32, why: Reason) Error {
    ret Error.refused{Refused{function: b.u.function, at: at, operand: operand, reason: why}};
}

fun builder(r: err[build.Refusal]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.builder{r.err}}; }
    ret err[Error].ok{};
}

# why masc refused to finish the object: a relocation the format does not map, named by the symbol it aims at, or
# anything else masc refuses
fun finish_refused(e: *Emitter, r: build.Refusal) Error {
    if (!str_equals(r.message, build.NO_RELOCATION)) { ret Error.builder{r}; }
    ret Error.unmapped{Unmapped{symbol: aimed_at(e, r.label), refusal: r}};
}

# the function or global whose label is `label`, none for a label the module does not name
fun aimed_at(e: *Emitter, label: u32) opt[id.Symbol] {
    var i: usize = 0;
    for (i < e.functions.len) {
        val f: opt[build.Label] = e.functions.data[i];
        if (sel f.some && f.some.id == label) { ret opt[id.Symbol].some{id.Symbol.function{id.Function{index: i::u32}}}; }
        i = i + 1;
    }
    i = 0;
    for (i < e.globals.len) {
        val g: opt[build.Label] = e.globals.data[i];
        if (sel g.some && g.some.id == label) { ret opt[id.Symbol].some{id.Symbol.global{id.Global{index: i::u32}}}; }
        i = i + 1;
    }
    ret opt[id.Symbol].none{};
}

fun alloc(r: res[usize, allocator.Error]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.alloc{r.err}}; }
    ret err[Error].ok{};
}

# bytes that carry no terminator, copied with one, the caller's to give back with `unterminated`
fun terminated(e: *Emitter, v: View) res[*u8, Error] {
    val copy: res[*u8, allocator.Error] = allocator.allocate[u8](e.a, v.len + 1);
    if (sel copy.err) { ret res[*u8, Error].err{Error.alloc{copy.err}}; }
    var i: usize = 0;
    for (i < v.len) {
        copy.ok[i] = v.data[i];
        i          = i + 1;
    }
    copy.ok[v.len] = 0;
    ret res[*u8, Error].ok{copy.ok};
}

fun unterminated(e: *Emitter, p: *u8, v: View) {
    allocator.deallocate[u8](e.a, p, v.len + 1);
}

# a label named by bytes that carry no terminator
fun named(e: *Emitter, v: View) res[build.Label, Error] {
    val copy: res[*u8, Error] = terminated(e, v);
    if (sel copy.err) { ret res[build.Label, Error].err{copy.err}; }
    val made: res[build.Label, build.Refusal] = build.label(e.b, copy.ok);
    unterminated(e, copy.ok, v);
    if (sel made.err) { ret res[build.Label, Error].err{Error.builder{made.err}}; }
    ret res[build.Label, Error].ok{made.ok};
}

# how the object shows a symbol of the module: its linkage's rows, of a kind,
# with its size, a count of bytes or a range masc measures once laid out
fun exposure(l: Linkage, kind: *symbol.Kind, size: build.Size) build.Exposure {
    ret build.Exposure{binding: l.binding, visibility: l.visibility, kind: kind, size: size};
}

fun misplaced(g: id.Global, why: Fault) Error {
    ret Error.global{Misplaced{global: g, fault: why}};
}

# the label of a function of the module, a function symbol of the object made
# when it is first named, sized from its label to its end when a unit emits it
fun function_label(e: *Emitter, f: id.Function) res[build.Label, Error] {
    if (f.index::usize >= e.functions.len) { ret res[build.Label, Error].err{Error.symbol{module.Error.function{f}}}; }
    val held: opt[build.Label] = e.functions.data[f.index];
    if (sel held.some) { ret res[build.Label, Error].ok{held.some}; }
    val data: res[FunctionData, module.Error] = module.function_data(e.m, f);
    if (sel data.err) { ret res[build.Label, Error].err{Error.symbol{data.err}}; }
    val l: res[build.Label, Error] = named(e, data.ok.name);
    if (sel l.err) { ret l; }
    var size: build.Size = build.Size.none{};
    val unit: opt[u32]   = e.emitters.data[f.index];
    if (sel unit.some) { size = build.Size.measured{build.Difference{plus: e.ends.data[unit.some], minus: l.ok, addend: 0}}; }
    val shown: err[build.Refusal] = build.expose(e.b, l.ok, exposure(data.ok.linkage, ?symbol.FUNCTION, size));
    if (sel shown.err) { ret res[build.Label, Error].err{Error.builder{shown.err}}; }
    e.functions.data[f.index] = opt[build.Label].some{l.ok};
    ret res[build.Label, Error].ok{l.ok};
}

# the label of a global of the module, a data symbol of the object made when it
# is first named, sized when the module defines it
fun global_label(e: *Emitter, g: id.Global) res[build.Label, Error] {
    if (g.index::usize >= e.globals.len) { ret res[build.Label, Error].err{Error.symbol{module.Error.global{g}}}; }
    val held: opt[build.Label] = e.globals.data[g.index];
    if (sel held.some) { ret res[build.Label, Error].ok{held.some}; }
    val data: res[GlobalData, module.Error] = module.global_data(e.m, g);
    if (sel data.err) { ret res[build.Label, Error].err{Error.symbol{data.err}}; }
    var size: build.Size = build.Size.none{};
    if (sel data.ok.initial.some) {
        val sized: res[u64, record.Error] = layout.size(?e.l, data.ok.type, DEFAULT_SPACE);
        if (sel sized.err) { ret res[build.Label, Error].err{misplaced(g, Fault.layout{sized.err})}; }
        size = build.Size.fixed{sized.ok};
    }
    var kind: *symbol.Kind = ?symbol.DATA;
    if (sel data.ok.tls.some) { kind = ?symbol.TLS; }
    val l: res[build.Label, Error] = named(e, data.ok.name);
    if (sel l.err) { ret l; }
    val shown: err[build.Refusal] = build.expose(e.b, l.ok, exposure(data.ok.linkage, kind, size));
    if (sel shown.err) { ret res[build.Label, Error].err{Error.builder{shown.err}}; }
    e.globals.data[g.index] = opt[build.Label].some{l.ok};
    ret res[build.Label, Error].ok{l.ok};
}

# the label of a function or global of the module
fun symbol_label(e: *Emitter, s: id.Symbol) res[build.Label, Error] {
    if (sel s.function) { ret function_label(e, s.function); }
    ret global_label(e, s.global);
}

# the fixup kind a symbol or partner operand is applied as, with the instructions its relocation covers
fun fixup_of(b: *Body, at: Instruction, k: u32, own: mo.FixupKind, kind: *reloc.Kind) res[mo.FixupKind, Error] {
    val found: fixup.Found = fixup.find(b.e.x, kind, own);
    if (sel found.bound)   { ret res[mo.FixupKind, Error].ok{found.bound}; }
    if (sel found.unbound) { ret res[mo.FixupKind, Error].err{refused(b, at, k, Reason.unbound{})}; }
    ret res[mo.FixupKind, Error].err{refused(b, at, k, Reason.ambiguous{})};
}

# the fixup kind an operand position takes by default
fun own_fixup(o: *mo.Operand) mo.FixupKind {
    if (sel o.shape.immediate) { ret o.shape.immediate.fixup; }
    if (sel o.shape.relative)  { ret o.shape.relative.offset.fixup; }
    if (sel o.shape.memory)    { ret o.shape.memory.disp.fixup; }
    if (sel o.shape.marker)    { ret o.shape.marker; }
    ret mo.NO_FIXUP;
}

# the register a register operand is, none for anything allocation leaves
fun register_of(o: Operand) opt[Physical] {
    if (sel o.physical) { ret opt[Physical].some{o.physical}; }
    if (sel o.tied) {
        val dest: Register = o.tied.dest;
        if (sel dest.physical) { ret opt[Physical].some{dest.physical}; }
    }
    ret opt[Physical].none{};
}

# the instructions the relocation of a fixup kind covers, its own included
fun covered(e: *Emitter, fixup: mo.FixupKind) u32 {
    val s: opt[*core_fixup.Span] = core_fixup.span_of(e.opened.basis.set.spans, fixup);
    if (sel s.none) { ret 1; }
    ret s.some.count;
}

# why the registers an operand names cannot be given to masc's: a virtual
# one is unplaced and a cell no object holds
fun unplaced(o: Operand) opt[Reason] {
    var names: [operand.MOST_NAMED]Register;
    val n:     u32 = operand.named(o, ?names[0]);
    var i:     u32 = 0;
    for (i < n) {
        val r: Register = names[i];
        if (sel r.virtual) { ret opt[Reason].some{Reason.unplaced{}}; }
        if (sel r.physical) {
            if (sel r.physical.cell) { ret opt[Reason].some{Reason.cell{}}; }
        }
        i = i + 1;
    }
    ret opt[Reason].none{};
}

# an address given to masc's at a memory position, its symbol bound to its
# label and fixup kind, answering how many instructions its relocation covers
fun give_address(b: *Body, at: Instruction, ins: *masc_emit.Instruction, k: u32, ro: *mo.Operand, a: operand.Address) res[u32, Error] {
    if (!(sel ro.shape.memory)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
    val v: mo.Value = instruction.address_value(a);
    if (!(sel v.memory)) { ret res[u32, Error].err{refused(b, at, k, Reason.unplaced{})}; }
    var made: mo.Address          = v.memory;
    var span: u32                 = 1;
    val sym:  opt[operand.Symbol] = a.symbol;
    if (sel sym.some) {
        val l: res[build.Label, Error] = symbol_label(b.e, sym.some.symbol);
        if (sel l.err) { ret res[u32, Error].err{l.err}; }
        val f: res[mo.FixupKind, Error] = fixup_of(b, at, k, own_fixup(ro), sym.some.kind);
        if (sel f.err) { ret res[u32, Error].err{f.err}; }
        made.symbol = mo.Symbol{id: l.ok.id, addend: sym.some.addend, fixup: f.ok};
        span        = covered(b.e, f.ok);
    }
    val done: err[Error] = builder(masc_emit.memory(b.e.b, ins, made));
    if (sel done.err) { ret res[u32, Error].err{done.err}; }
    ret res[u32, Error].ok{span};
}

# operand `k` of an instruction given to masc's, answering how many
# instructions its relocation covers. a list's members are written to
# `room`, which holds instruction.MOST_MEMBERS and outlives the instruction's
# writing, from `used` on
fun give(b: *Body, at: Instruction, ins: *masc_emit.Instruction, k: u32, o: Operand, room: *mo.Value, used: *u32) res[u32, Error] {
    val e:  *Emitter    = b.e;
    val ro: *mo.Operand = ?ins.step.row.operands.at[k];
    if (sel o.address || sel o.list) {
        val why: opt[Reason] = unplaced(o);
        if (sel why.some) { ret res[u32, Error].err{refused(b, at, k, why.some)}; }
    }
    if (sel o.address) { ret give_address(b, at, ins, k, ro, o.address); }
    if (sel o.list) {
        if (!(sel ro.shape.list))                                 { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        if (@used + o.list.count::u32 > instruction.MOST_MEMBERS) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val v: mo.Value = instruction.list_value(function.file(b.u.code), ?ro.shape.list, o.list, ?room[@used]);
        if (!(sel v.list)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        @used = @used + o.list.count::u32;
        val done: err[Error] = builder(masc_emit.list(e.b, ins, v.list));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{1};
    }
    if (sel o.literal) {
        if (!(sel ro.shape.literal)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val done: err[Error] = builder(masc_emit.literal(e.b, ins, o.literal));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{1};
    }
    if (sel o.virtual || sel o.slot)           { ret res[u32, Error].err{refused(b, at, k, Reason.unplaced{})}; }
    if (sel o.tied && sel o.tied.dest.virtual) { ret res[u32, Error].err{refused(b, at, k, Reason.unplaced{})}; }
    if (sel o.physical && sel o.physical.cell) { ret res[u32, Error].err{refused(b, at, k, Reason.cell{})}; }
    if (sel o.physical && sel ro.shape.id) {
        val v: mo.Value = instruction.value_of(ro, o);
        if (!(sel v.id)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val done: err[Error] = builder(masc_emit.id(e.b, ins, v.id));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{1};
    }
    val reg: opt[Physical] = register_of(o);
    if (sel reg.some) {
        val place: Physical = reg.some;
        if (!(sel ro.shape.register)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        if (!(sel place.register))    { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val given: err[Error] = builder(masc_emit.register(e.b, ins, place.register));
        if (sel given.err) { ret res[u32, Error].err{given.err}; }
        ret res[u32, Error].ok{1};
    }
    if (sel o.immediate) {
        val v:     mo.Value = instruction.value_of(ro, o);
        var given: err[build.Refusal];
        if (sel v.immediate) { given = masc_emit.immediate(e.b, ins, v.immediate); }
        or (sel v.enumerant) { given = masc_emit.enumerant(e.b, ins, v.enumerant); }
        or (sel v.condition) { given = masc_emit.condition(e.b, ins, v.condition); }
        or                   { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val done: err[Error] = builder(given);
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{1};
    }
    if (sel o.block) {
        if (!(sel ro.shape.relative)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val done: err[Error] = builder(masc_emit.symbol(e.b, ins, b.blocks.data[o.block.index], 0, mo.NO_FIXUP));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{1};
    }
    if (sel o.symbol) {
        if (!(sel ro.shape.immediate || sel ro.shape.relative || sel ro.shape.marker)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val l: res[build.Label, Error] = symbol_label(e, o.symbol.symbol);
        if (sel l.err) { ret res[u32, Error].err{l.err}; }
        val f: res[mo.FixupKind, Error] = fixup_of(b, at, k, own_fixup(ro), o.symbol.kind);
        if (sel f.err) { ret res[u32, Error].err{f.err}; }
        val done: err[Error] = builder(masc_emit.symbol(e.b, ins, l.ok, o.symbol.addend, f.ok));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{covered(e, f.ok)};
    }
    if (sel o.partner) {
        if (!(sel ro.shape.immediate || sel ro.shape.relative)) { ret res[u32, Error].err{refused(b, at, k, Reason.shape{})}; }
        val mark: opt[*build.Label] = map.get[u32, build.Label](?b.marks, ?o.partner.label);
        if (sel mark.none) { ret res[u32, Error].err{refused(b, at, k, Reason.label{})}; }
        val f: res[mo.FixupKind, Error] = fixup_of(b, at, k, own_fixup(ro), o.partner.kind);
        if (sel f.err) { ret res[u32, Error].err{f.err}; }
        val done: err[Error] = builder(masc_emit.symbol(e.b, ins, @mark.some, 0, f.ok));
        if (sel done.err) { ret res[u32, Error].err{done.err}; }
        ret res[u32, Error].ok{covered(e, f.ok)};
    }
    ret res[u32, Error].err{refused(b, at, k, Reason.shape{})};
}

# an instruction given to masc's, answering how many instructions the
# relocations of its operands cover, the members of its lists written to
# `room`, which holds instruction.MOST_MEMBERS
fun start(b: *Body, at: Instruction, ins: *masc_emit.Instruction, room: *mo.Value) res[u32, Error] {
    val d:  *InstructionData = function.data(b.u.code, at);
    val op: Opcode           = d.opcode;
    if (!(sel op.row)) { ret res[u32, Error].err{refused(b, at, NO_OPERAND, Reason.pseudo{})}; }
    val started: res[masc_emit.Instruction, build.Refusal] = masc_emit.start(b.e.b, op.row);
    if (sel started.err) { ret res[u32, Error].err{Error.builder{started.err}}; }
    @ins = started.ok;
    var span: u32 = 1;
    var used: u32 = 0;
    var k:    u32 = 0;
    for (k::usize < d.operands.size) {
        val given: res[u32, Error] = give(b, at, ins, k, d.operands.data[k], room, ?used);
        if (sel given.err)   { ret given; }
        if (given.ok > span) { span = given.ok; }
        k = k + 1;
    }
    ret res[u32, Error].ok{span};
}

# the location masc reads of operand `k` of an inline block: the register it
# names, the address it holds or the constant it is
fun location_of(b: *Body, at: Instruction, k: u32, o: Operand) res[masc_inline.Location, Error] {
    val why: opt[Reason] = unplaced(o);
    if (sel why.some) { ret res[masc_inline.Location, Error].err{refused(b, at, k, why.some)}; }
    if (sel o.address) {
        val v: mo.Value = instruction.address_value(o.address);
        if (!(sel v.memory)) { ret res[masc_inline.Location, Error].err{refused(b, at, k, Reason.unplaced{})}; }
        ret res[masc_inline.Location, Error].ok{v};
    }
    if (sel o.immediate)                       { ret res[masc_inline.Location, Error].ok{mo.Value.immediate{o.immediate}}; }
    if (sel o.virtual || sel o.slot)           { ret res[masc_inline.Location, Error].err{refused(b, at, k, Reason.unplaced{})}; }
    if (sel o.tied && sel o.tied.dest.virtual) { ret res[masc_inline.Location, Error].err{refused(b, at, k, Reason.unplaced{})}; }
    val reg: opt[Physical] = register_of(o);
    if (sel reg.some) {
        val place: Physical = reg.some;
        if (sel place.register) { ret res[masc_inline.Location, Error].ok{mo.Value.register{place.register}}; }
        ret res[masc_inline.Location, Error].err{refused(b, at, k, Reason.cell{})};
    }
    ret res[masc_inline.Location, Error].err{refused(b, at, k, Reason.shape{})};
}

# an inline block handed to masc with each operand at its location, which masc encodes at the cursor
fun encode_inline(b: *Body, at: Instruction, x: *Inline) err[Error] {
    val d:    *InstructionData = function.data(b.u.code, at);
    var held: [ia.MOST_OPERANDS]masc_inline.Location;
    if (d.operands.size > ia.MOST_OPERANDS::usize) { ret err[Error].err{refused(b, at, NO_OPERAND, Reason.shape{})}; }
    var k: u32 = 0;
    for (k::usize < d.operands.size) {
        val got: res[masc_inline.Location, Error] = location_of(b, at, k, d.operands.data[k]);
        if (sel got.err) { ret err[Error].err{got.err}; }
        held[k] = got.ok;
        k       = k + 1;
    }
    ret builder(masc_inline.encode(?x.block, masc_inline.Locations{at: ?held[0], len: d.operands.size::u32}, b.e.b));
}

# the list members the instructions of one sequence keep room for
val ROOM: u32 = relax.MAX_STEPS * instruction.MOST_MEMBERS;

# the instructions of a block from position `k`, one instruction or the sequence its relocation covers
# ---
# ret: how many instructions were written
fun write(b: *Body, list: Slice[Instruction], k: usize) res[usize, Error] {
    val at: Instruction = list.data[k];
    val op: Opcode      = function.data(b.u.code, at).opcode;
    if (sel op.inline) {
        val done: err[Error] = encode_inline(b, at, op.inline);
        if (sel done.err) { ret res[usize, Error].err{done.err}; }
        ret res[usize, Error].ok{1};
    }
    var steps:  [relax.MAX_STEPS]masc_emit.Instruction;
    var listed: [ROOM]mo.Value;
    val span:   res[u32, Error] = start(b, at, ?steps[0], ?listed[0]);
    if (sel span.err) { ret res[usize, Error].err{span.err}; }
    if (span.ok <= 1) {
        val put: err[Error] = builder(masc_emit.put(b.e.b, ?steps[0]));
        if (sel put.err) { ret res[usize, Error].err{put.err}; }
        ret res[usize, Error].ok{1};
    }
    if (span.ok > relax.MAX_STEPS || k + span.ok::usize > list.size) { ret res[usize, Error].err{refused(b, at, NO_OPERAND, Reason.span{})}; }
    var j: u32 = 1;
    for (j < span.ok) {
        val next: Instruction = list.data[k + j::usize];
        if (function.data(b.u.code, next).label != instruction.NO_LABEL) { ret res[usize, Error].err{refused(b, next, NO_OPERAND, Reason.label{})}; }
        val covers: res[u32, Error] = start(b, next, ?steps[j], ?listed[j * instruction.MOST_MEMBERS]);
        if (sel covers.err) { ret res[usize, Error].err{covers.err}; }
        j = j + 1;
    }
    val put: err[Error] = builder(masc_emit.sequence(b.e.b, ?steps[0], span.ok));
    if (sel put.err) { ret res[usize, Error].err{put.err}; }
    ret res[usize, Error].ok{span.ok::usize};
}

# the labels of a function's blocks and of the instructions its partner operands name
fun label_body(b: *Body) err[Error] {
    val code: *Function = b.u.code;
    var i:    usize     = 0;
    for (i < code.blocks.len) {
        val l: res[build.Label, build.Refusal] = build.anonymous(b.e.b);
        if (sel l.err) { ret err[Error].err{Error.builder{l.err}}; }
        val pushed: err[Error] = alloc(vector.push[build.Label](?b.blocks, l.ok));
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    i = 0;
    for (i < b.u.laid.order.len) {
        val list: Slice[Instruction] = function.instructions(code, b.u.laid.order.data[i]);
        var k:    usize              = 0;
        for (k < list.size) {
            val n: u32 = function.data(code, list.data[k]).label;
            if (n != instruction.NO_LABEL) {
                if (map.contains[u32, build.Label](?b.marks, ?n)) { ret err[Error].err{refused(b, list.data[k], NO_OPERAND, Reason.label{})}; }
                val l: res[build.Label, build.Refusal] = build.anonymous(b.e.b);
                if (sel l.err) { ret err[Error].err{Error.builder{l.err}}; }
                val stored: res[bool, allocator.Error] = map.insert[u32, build.Label](?b.marks, n, l.ok);
                if (sel stored.err) { ret err[Error].err{Error.alloc{stored.err}}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the call frame facts at an instruction handed to masc, those that come
# before it or those that follow it
fun hand_facts(b: *Body, at: Instruction, after: bool) err[Error] {
    if (!b.e.framed)                    { ret err[Error].ok{}; }
    if (at.index::usize >= b.facts.len) { ret err[Error].ok{}; }
    var f: u32 = b.facts.data[at.index];
    for (f != NONE) {
        val fact: *Fact = ?b.u.facts.data[f];
        if (fact.after == after) {
            val handed: err[Error] = builder(build.cfi(b.e.b, fact.rule));
            if (sel handed.err) { ret handed; }
            b.given.data[f] = true;
        }
        f = b.next.data[f];
    }
    ret err[Error].ok{};
}

# the label before an instruction a range begins or ends at placed
fun mark_range(b: *Body, at: Instruction) err[Error] {
    val held: opt[*Mark] = map.get[u32, Mark](?b.ranged, ?at.index);
    if (sel held.none)     { ret err[Error].ok{}; }
    if (held.some.defined) { ret err[Error].ok{}; }
    held.some.defined = true;
    ret builder(build.define(b.e.b, held.some.label));
}

# the source location of an instruction stated when it changes, an
# instruction with none stated as line 0 of the last file
fun state_line(b: *Body, at: Instruction) err[Error] {
    if (!b.e.stated) { ret err[Error].ok{}; }
    val loc: opt[ir_debug.Location] = function.data(b.u.code, at).metadata.location;
    if (b.spoke) {
        if (sel loc.none && sel b.at.none) { ret err[Error].ok{}; }
        if (sel loc.some) {
            val was: opt[ir_debug.Location] = b.at;
            if (sel was.some) {
                if (was.some.index == loc.some.index) { ret err[Error].ok{}; }
            }
        }
    }
    b.spoke = true;
    b.at    = loc;
    var row: masc_line.Location = masc_line.Location{file: 0, line: 0, column: 0, end_column: opt[u32].none{}, flags: 0, isa: 0, discriminator: 0};
    if (sel loc.some) {
        val p: res[ir_debug.Position, ir_debug.Error] = ir_debug.position(?b.e.m.debug, loc.some);
        if (sel p.ok) {
            row.file   = p.ok.file.index;
            row.line   = p.ok.line;
            row.column = p.ok.column;
            row.flags  = mink_line.STATEMENT;
        }
    }
    ret builder(masc_line.location(?b.e.lines, b.e.b, row));
}

# a run of inlined code ended at the cursor and the next begun when the site
# an instruction was inlined at differs from the code's before it
fun state_site(b: *Body, at: Instruction) err[Error] {
    if (!b.e.stated) { ret err[Error].ok{}; }
    val site: opt[ir_debug.Site] = function.data(b.u.code, at).metadata.site;
    val was:  opt[ir_debug.Site] = b.site;
    if (sel site.none && sel was.none) { ret err[Error].ok{}; }
    if (sel site.some) {
        if (sel was.some) {
            if (site.some.index == was.some.index) { ret err[Error].ok{}; }
        }
    }
    val here: res[build.Label, build.Refusal] = build.anonymous(b.e.b);
    if (sel here.err) { ret err[Error].err{Error.builder{here.err}}; }
    val placed: err[Error] = builder(build.define(b.e.b, here.ok));
    if (sel placed.err) { ret placed; }
    val closed: err[Error] = close_site(b, here.ok);
    if (sel closed.err) { ret closed; }
    b.site = site;
    b.run  = here.ok;
    ret err[Error].ok{};
}

# the open run of inlined code ended at `end`
fun close_site(b: *Body, end: build.Label) err[Error] {
    val was: opt[ir_debug.Site] = b.site;
    if (sel was.none) { ret err[Error].ok{}; }
    b.site = opt[ir_debug.Site].none{};
    ret alloc(vector.push[dwarf.Run](?b.e.runs, dwarf.Run{site: was.some, start: b.run, end: end}));
}

# what is stated before an instruction: its range labels, its source
# location, its inlining site and the call frame facts before it
fun before(b: *Body, at: Instruction) err[Error] {
    val marked: err[Error] = mark_range(b, at);
    if (sel marked.err) { ret marked; }
    val sited: err[Error] = state_site(b, at);
    if (sel sited.err) { ret sited; }
    val lined: err[Error] = state_line(b, at);
    if (sel lined.err) { ret lined; }
    ret hand_facts(b, at, false);
}

# the range labels of a block's instructions layout left in no block placed at its end
fun end_block(b: *Body, at: Block) err[Error] {
    if (b.ends.len == 0) { ret err[Error].ok{}; }
    val end: opt[build.Label] = b.ends.data[at.index];
    if (sel end.none) { ret err[Error].ok{}; }
    val placed: err[Error] = builder(build.define(b.e.b, end.some));
    if (sel placed.err) { ret placed; }
    val list: *vector.Vector[Range] = ?b.u.ranges.list;
    var i:    usize                 = 0;
    for (i < list.len) {
        val r: *Range = ?list.data[i];
        if (r.block.index == at.index) {
            val from: err[Error] = mark_range(b, r.from);
            if (sel from.err) { ret from; }
            val to: opt[Instruction] = r.to;
            if (sel to.some) {
                val ended: err[Error] = mark_range(b, to.some);
                if (sel ended.err) { ret ended; }
            }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun emit_body(b: *Body) err[Error] {
    val code: *Function = b.u.code;
    var i:    usize     = 0;
    for (i < b.u.laid.order.len) {
        val at:     Block              = b.u.laid.order.data[i];
        val list:   Slice[Instruction] = function.instructions(code, at);
        val placed: err[Error]         = builder(build.define(b.e.b, b.blocks.data[at.index]));
        if (sel placed.err) { ret placed; }
        var k: usize = 0;
        for (k < list.size) {
            val n: u32 = function.data(code, list.data[k]).label;
            if (n != instruction.NO_LABEL) {
                val mark: opt[*build.Label] = map.get[u32, build.Label](?b.marks, ?n);
                if (sel mark.none) { ret err[Error].err{refused(b, list.data[k], NO_OPERAND, Reason.label{})}; }
                val held: err[Error] = builder(build.define(b.e.b, @mark.some));
                if (sel held.err) { ret held; }
            }
            val stated: err[Error] = before(b, list.data[k]);
            if (sel stated.err) { ret stated; }
            val wrote: res[usize, Error] = write(b, list, k);
            if (sel wrote.err) { ret err[Error].err{wrote.err}; }
            # what a sequence's later instructions state comes after the sequence, which nothing splits
            var j: usize = 0;
            for (j < wrote.ok) {
                if (j > 0) {
                    val later: err[Error] = before(b, list.data[k + j]);
                    if (sel later.err) { ret later; }
                }
                val after: err[Error] = hand_facts(b, list.data[k + j], true);
                if (sel after.err) { ret after; }
                j = j + 1;
            }
            k = k + wrote.ok;
        }
        val ended: err[Error] = end_block(b, at);
        if (sel ended.err) { ret ended; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# each instruction's call frame facts, in their order
fun index_facts(b: *Body) err[Error] {
    val code:   *Function            = b.u.code;
    var failed: err[allocator.Error] = slice.fill[u32](?b.facts, code.instructions.len, NONE);
    keep(?failed, slice.fill[u32](?b.next, b.u.facts.size, NONE));
    keep(?failed, slice.fill[bool](?b.given, b.u.facts.size, false));
    if (sel failed.err) { ret err[Error].err{Error.alloc{failed.err}}; }
    var i: usize = b.u.facts.size;
    for (i > 0) {
        i = i - 1;
        val at: u32 = b.u.facts.data[i].at.index;
        if (at::usize >= code.instructions.len) { ret err[Error].err{refused(b, b.u.facts.data[i].at, NO_OPERAND, Reason.fact{})}; }
        b.next.data[i]   = b.facts.data[at];
        b.facts.data[at] = i::u32;
    }
    ret err[Error].ok{};
}

# a label before each instruction a range begins or ends at, and one at each block's end
fun label_ranges(b: *Body) err[Error] {
    val r: *Ranges = b.u.ranges;
    if (r == nil)        { ret err[Error].ok{}; }
    if (r.list.len == 0) { ret err[Error].ok{}; }
    val none: err[allocator.Error] = slice.fill[opt[build.Label]](?b.ends, b.u.code.blocks.len, opt[build.Label].none{});
    if (sel none.err) { ret err[Error].err{Error.alloc{none.err}}; }
    var k: usize = 0;
    for (k < b.u.laid.order.len) {
        val l: res[build.Label, build.Refusal] = build.anonymous(b.e.b);
        if (sel l.err) { ret err[Error].err{Error.builder{l.err}}; }
        b.ends.data[b.u.laid.order.data[k].index] = opt[build.Label].some{l.ok};
        k                                         = k + 1;
    }
    var i: usize = 0;
    for (i < r.list.len) {
        val one: *Range = ?r.list.data[i];
        if (!laid_out(b, one.block)) {
            i = i + 1;
            cnt;
        }
        val from: err[Error] = range_mark(b, one.from, one.block.index);
        if (sel from.err) { ret from; }
        val to: opt[Instruction] = one.to;
        if (sel to.some) {
            val ended: err[Error] = range_mark(b, to.some, one.block.index);
            if (sel ended.err) { ret ended; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun range_mark(b: *Body, at: Instruction, block: u32) err[Error] {
    if (map.contains[u32, Mark](?b.ranged, ?at.index)) { ret err[Error].ok{}; }
    val l: res[build.Label, build.Refusal] = build.anonymous(b.e.b);
    if (sel l.err) { ret err[Error].err{Error.builder{l.err}}; }
    val stored: res[bool, allocator.Error] = map.insert[u32, Mark](?b.ranged, at.index, Mark{label: l.ok, block: block, defined: false});
    if (sel stored.err) { ret err[Error].err{Error.alloc{stored.err}}; }
    ret err[Error].ok{};
}

# whether layout left a block in the order it emits
fun laid_out(b: *Body, k: Block) bool {
    if (k.index::usize >= b.ends.len) { ret false; }
    val end: opt[build.Label] = b.ends.data[k.index];
    ret sel end.some;
}

# a unit's ranges as the dwarf producer's spans over its labels, those of a
# block layout threaded away left out
fun spans_of(b: *Body, end: build.Label) err[Error] {
    val r: *Ranges = b.u.ranges;
    if (r == nil) { ret err[Error].ok{}; }
    var i: usize = 0;
    for (i < r.list.len) {
        val one: *Range = ?r.list.data[i];
        if (!laid_out(b, one.block)) {
            i = i + 1;
            cnt;
        }
        val from: opt[*Mark] = map.get[u32, Mark](?b.ranged, ?one.from.index);
        if (sel from.none) { ret err[Error].err{refused(b, one.from, NO_OPERAND, Reason.label{})}; }
        var to:   build.Label      = end;
        val ends: opt[build.Label] = b.ends.data[one.block.index];
        if (sel ends.some) { to = ends.some; }
        val until: opt[Instruction] = one.to;
        if (sel until.some) {
            val mark: opt[*Mark] = map.get[u32, Mark](?b.ranged, ?until.some.index);
            if (sel mark.none) { ret err[Error].err{refused(b, until.some, NO_OPERAND, Reason.label{})}; }
            to = mark.some.label;
        }
        val pushed: err[Error] = alloc(vector.push[dwarf.Span](?b.e.spans, dwarf.Span{binding: one.binding, start: from.some.label, end: to, where: one.where, expression: one.expression, type: one.type}));
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the label ending each unit's function, made before any function is named so its symbol is exposed once with its range
fun end_units(e: *Emitter, units: Slice[Unit]) err[Error] {
    var i: usize = 0;
    for (i < units.size) {
        val f: id.Function = units.data[i].function;
        if (f.index::usize >= e.emitters.len) { ret err[Error].err{Error.symbol{module.Error.function{f}}}; }
        val l: res[build.Label, build.Refusal] = build.anonymous(e.b);
        if (sel l.err) { ret err[Error].err{Error.builder{l.err}}; }
        val pushed: err[Error] = alloc(vector.push[build.Label](?e.ends, l.ok));
        if (sel pushed.err) { ret pushed; }
        e.emitters.data[f.index] = opt[u32].some{i::u32};
        i                        = i + 1;
    }
    ret err[Error].ok{};
}

# one function: its symbol at its alignment, then its blocks, then the label ending it
fun emit_unit(e: *Emitter, u: Unit, end: build.Label) err[Error] {
    val l: res[build.Label, Error] = function_label(e, u.function);
    if (sel l.err) { ret err[Error].err{l.err}; }
    if (sel e.function.some) {
        val aligned: err[Error] = builder(build.align(e.b, build.Align{boundary: e.function.some, fill: e.fill, max: opt[u64].none{}}));
        if (sel aligned.err) { ret aligned; }
    }
    val placed: err[Error] = builder(build.define(e.b, l.ok));
    if (sel placed.err) { ret placed; }
    val timed: bool = e.m.functions.data[u.function.index].data.constant_time;
    if (timed) {
        val begun: err[Error] = builder(build.ct_begin(e.b));
        if (sel begun.err) { ret begun; }
    }
    var body: Body = Body{
        e:      e,
        u:      u,
        blocks: vector.init[build.Label](e.a),
        marks:  map.init[u32, build.Label](e.a),
        facts:  vector.init[u32](e.a),
        next:   vector.init[u32](e.a),
        given:  vector.init[bool](e.a),
        ranged: map.init[u32, Mark](e.a),
        ends:   vector.init[opt[build.Label]](e.a),
        site:   opt[ir_debug.Site].none{},
        run:    l.ok,
        at:     opt[ir_debug.Location].none{},
        spoke:  false,
    };
    fin {
        vector.dnit[build.Label](?body.blocks);
        map.dnit[u32, build.Label](?body.marks);
        vector.dnit[u32](?body.facts);
        vector.dnit[u32](?body.next);
        vector.dnit[bool](?body.given);
        map.dnit[u32, Mark](?body.ranged);
        vector.dnit[opt[build.Label]](?body.ends);
    }
    val labelled: err[Error] = label_body(?body);
    if (sel labelled.err) { ret labelled; }
    val indexed: err[Error] = index_facts(?body);
    if (sel indexed.err) { ret indexed; }
    val ranged: err[Error] = label_ranges(?body);
    if (sel ranged.err) { ret ranged; }
    if (e.framed) {
        val begun: err[Error] = builder(masc_cfi.start_proc(e.b, l.ok));
        if (sel begun.err) { ret begun; }
    }
    val spans:   usize      = e.spans.len;
    val runs:    usize      = e.runs.len;
    val emitted: err[Error] = emit_body(?body);
    if (sel emitted.err) { ret emitted; }
    if (e.framed) {
        var i: usize = 0;
        for (i < u.facts.size) {
            if (!body.given.data[i]) { ret err[Error].err{refused(?body, u.facts.data[i].at, NO_OPERAND, Reason.fact{})}; }
            i = i + 1;
        }
        val ended: err[Error] = builder(masc_cfi.end_proc(e.b));
        if (sel ended.err) { ret ended; }
    }
    val closed: err[Error] = close_site(?body, end);
    if (sel closed.err) { ret closed; }
    val spanned: err[Error] = spans_of(?body, end);
    if (sel spanned.err) { ret spanned; }
    val noted: err[Error] = alloc(vector.push[Program](?e.programs, Program{function: u.function, start: l.ok, end: end, spans: spans, span: e.spans.len - spans, runs: runs, run: e.runs.len - runs}));
    if (sel noted.err) { ret noted; }
    if (timed) {
        val ended: err[Error] = builder(build.ct_end(e.b));
        if (sel ended.err) { ret ended; }
    }
    ret builder(build.define(e.b, end));
}

fun hash_name(v: *View) u64 {
    ret slice.hash_view(0xcbf29ce484222325, @v);
}

fun same_name(x: *View, y: *View) bool {
    ret slice.same_view(@x, @y);
}

# a kind is its row of mink's catalog, so two kinds are one when they are one row
fun hash_kind(k: **section.Kind) u64 {
    val at: u64 = (@k)::u64;
    ret natural.hash[u64](?at);
}

fun same_kind(x: **section.Kind, y: **section.Kind) bool {
    ret @x == @y;
}

# a new section of a kind, named or nameless, switched to and aligned to the target's code or data alignment
fun open_section(e: *Emitter, name: opt[str], kind: *section.Kind) res[build.Section, Error] {
    val opened: res[build.Section, build.Refusal] = build.open(e.b, build.Spec{name: name, kind: kind, flags: kind.flags, disposition: ?section.WHOLE, entsize: 0, apart: false});
    if (sel opened.err) { ret res[build.Section, Error].err{Error.builder{opened.err}}; }
    val switched: err[Error] = builder(build.switch(e.b, opened.ok));
    if (sel switched.err) { ret res[build.Section, Error].err{switched.err}; }
    var boundary: opt[u64] = align_of(e.t.caps.code.data);
    if ((kind.flags & section.EXEC) != 0) { boundary = align_of(e.t.caps.code.text); }
    if (sel boundary.some) {
        val aligned: err[Error] = builder(build.align(e.b, build.Align{boundary: boundary.some, fill: opt[u8].none{}, max: opt[u64].none{}}));
        if (sel aligned.err) { ret res[build.Section, Error].err{aligned.err}; }
    }
    ret res[build.Section, Error].ok{opened.ok};
}

# the section of a name the module states and a kind, opened the first time it is named
# ---
# ret: the section, none when the name is of a section opened with another kind
fun section_for(e: *Emitter, name: View, kind: *section.Kind) res[opt[build.Section], Error] {
    val held: opt[*Opened] = map.get_by[View, Opened](?e.sections, ?name);
    if (sel held.some) {
        if (held.some.kind != kind) { ret res[opt[build.Section], Error].ok{opt[build.Section].none{}}; }
        ret res[opt[build.Section], Error].ok{opt[build.Section].some{held.some.section}};
    }
    val text: res[*u8, Error] = terminated(e, name);
    if (sel text.err) { ret res[opt[build.Section], Error].err{text.err}; }
    val opened: res[build.Section, Error] = open_section(e, opt[str].some{text.ok}, kind);
    unterminated(e, text.ok, name);
    if (sel opened.err) { ret res[opt[build.Section], Error].err{opened.err}; }
    val stored: res[bool, allocator.Error] = map.insert_by[View, Opened](?e.sections, name, Opened{section: opened.ok, kind: kind});
    if (sel stored.err) { ret res[opt[build.Section], Error].err{Error.alloc{stored.err}}; }
    ret res[opt[build.Section], Error].ok{opt[build.Section].some{opened.ok}};
}

# the one nameless section of a kind, which mink names as the format names a section of the kind, opened the first
# time the kind is placed with no name the module states
fun kind_section(e: *Emitter, kind: *section.Kind) res[build.Section, Error] {
    val held: opt[*build.Section] = map.get_by[*section.Kind, build.Section](?e.kinds, ?kind);
    if (sel held.some) { ret res[build.Section, Error].ok{@held.some}; }
    val opened: res[build.Section, Error] = open_section(e, opt[str].none{}, kind);
    if (sel opened.err) { ret opened; }
    val stored: res[bool, allocator.Error] = map.insert_by[*section.Kind, build.Section](?e.kinds, kind, opened.ok);
    if (sel stored.err) { ret res[build.Section, Error].err{Error.alloc{stored.err}}; }
    ret opened;
}

# the bytes of an image from `from` to `to`
fun bytes_of(e: *Emitter, i: *data.Image, from: u64, to: u64) err[Error] {
    if (to <= from) { ret err[Error].ok{}; }
    ret builder(build.data(e.b, ?i.bytes.data[from::usize], (to - from)::usize));
}

# an initial value's bytes, with a datum for each address in it
fun write_image(e: *Emitter, g: id.Global, i: *data.Image) err[Error] {
    var at: u64   = 0;
    var k:  usize = 0;
    for (k < i.datums.len) {
        val d: data.Datum = i.datums.data[k];
        if (d.width > core_fixup.MAX_WIDTH::u64) { ret err[Error].err{misplaced(g, Fault.width{})}; }
        val before: err[Error] = bytes_of(e, i, at, d.offset);
        if (sel before.err) { ret before; }
        val l: res[build.Label, Error] = symbol_label(e, d.symbol);
        if (sel l.err) { ret err[Error].err{l.err}; }
        val put: err[Error] = builder(build.datum(e.b, build.Reference{target: l.ok, addend: d.addend, width: d.width::u8, basis: core_fixup.ABSOLUTE}));
        if (sel put.err) { ret put; }
        at = d.offset + d.width;
        k  = k + 1;
    }
    ret bytes_of(e, i, at, i.bytes.len::u64);
}

# one global the module defines: its symbol in its section at its alignment, then its initial value
fun emit_global(e: *Emitter, g: id.Global) err[Error] {
    val d: GlobalData = e.m.globals.data[g.index].data;
    if (sel d.initial.none) { ret err[Error].ok{}; }
    val held: res[Contents, module.Error] = module.contents(e.m, d.initial.some);
    if (sel held.err) { ret err[Error].err{misplaced(g, Fault.contents{held.err})}; }
    var placed: build.Section;
    if (sel d.section.some) {
        val named: res[opt[build.Section], Error] = section_for(e, d.section.some.name, d.section.some.kind);
        if (sel named.err)     { ret err[Error].err{named.err}; }
        if (sel named.ok.none) { ret err[Error].err{misplaced(g, Fault.section{})}; }
        placed = named.ok.some;
    }
    or {
        var relocated: bool = false;
        if (sel held.ok.addresses) {
            val a: Addresses = e.t.addresses;
            if (!(sel a.model)) { ret err[Error].err{misplaced(g, Fault.model{})}; }
            relocated = address.loaded(a.model.relocation, held.ok);
        }
        val kind: res[build.Section, Error] = kind_section(e, address.placement(d.constant, sel d.tls.some, held.ok, relocated));
        if (sel kind.err) { ret err[Error].err{kind.err}; }
        placed = kind.ok;
    }
    val switched: err[Error] = builder(build.switch(e.b, placed));
    if (sel switched.err) { ret switched; }
    val ext: res[Extent, record.Error] = layout.extent(?e.l, d.type, DEFAULT_SPACE);
    if (sel ext.err) { ret err[Error].err{misplaced(g, Fault.layout{ext.err})}; }
    var boundary: u64 = ext.ok.align;
    if (sel d.alignment.some) { boundary = d.alignment.some; }
    val aligned: err[Error] = builder(build.align(e.b, build.Align{boundary: boundary, fill: opt[u8].none{}, max: opt[u64].none{}}));
    if (sel aligned.err) { ret aligned; }
    val l: res[build.Label, Error] = global_label(e, g);
    if (sel l.err) { ret err[Error].err{l.err}; }
    val defined: err[Error] = builder(build.define(e.b, l.ok));
    if (sel defined.err)   { ret defined; }
    if (sel held.ok.zeros) { ret builder(build.zero(e.b, ext.ok.size)); }
    val made: res[data.Image, data.Error] = data.image(e.a, e.m, ?e.l, DEFAULT_SPACE, e.order, d.initial.some, ext.ok.size);
    if (sel made.err) {
        val why: data.Error = made.err;
        if (sel why.alloc)  { ret err[Error].err{Error.alloc{why.alloc}}; }
        or (sel why.layout) { ret err[Error].err{misplaced(g, Fault.layout{why.layout})}; }
        val read: module.Error = why.ir;
        ret err[Error].err{misplaced(g, Fault.contents{read})};
    }
    var image: data.Image = made.ok;
    fin { data.release(?image); }
    ret write_image(e, g, ?image);
}

# the byte code is padded with, from the target's declaration
fun fill_of(f: Fill) res[opt[u8], Error] {
    if (sel f.pattern) {
        if (f.pattern.size == 0) { ret res[opt[u8], Error].err{Error.fill{}}; }
        var i: usize = 1;
        for (i < f.pattern.size) {
            if (f.pattern.data[i] != f.pattern.data[0]) { ret res[opt[u8], Error].err{Error.fill{}}; }
            i = i + 1;
        }
        ret res[opt[u8], Error].ok{opt[u8].some{f.pattern.data[0]}};
    }
    ret res[opt[u8], Error].ok{opt[u8].none{}};
}

# the psABI row of mink's catalog the convention is for architecture `arch`, whose traits masc's builder states for
# the object, nil for a convention of a family that names none
pub fun abi_of(c: *Convention, arch: *arches.Arch) res[*arches.Abi, Error] {
    val row: res[opt[*arches.Abi], Unadmitted] = convention.abi_row(c, arch);
    if (sel row.err)     { ret res[*arches.Abi, Error].err{Error.abi{}}; }
    if (sel row.ok.none) { ret res[*arches.Abi, Error].ok{nil}; }
    ret res[*arches.Abi, Error].ok{row.ok.some};
}

# the alignment a declaration states, none for none
fun align_of(a: Align) opt[u64] {
    if (sel a.bytes) { ret opt[u64].some{a.bytes}; }
    ret opt[u64].none{};
}

# whether masc states the frame the architecture's functions start in, so a function can be a frame of the builder
fun starts_frames(opened: *Build, arch: *arches.Arch) bool {
    val row: opt[*masc_set.Arch] = masc_set.arch_of(opened.basis.set, arch);
    if (sel row.none) { ret false; }
    ret row.some.frame != nil;
}

# every source file of the module stated to masc's line facts in table order, so a file's index is its id's
fun files(e: *Emitter) err[Error] {
    if (!e.stated) { ret err[Error].ok{}; }
    var i: usize = 0;
    for (i < e.m.debug.files.len) {
        val named: res[u32, build.Refusal] = masc_line.file(?e.lines, masc_line.Source{directory: View{data: nil, len: 0}, name: e.m.debug.files.data[i], md5: opt[mink_line.Md5].none{}});
        if (sel named.err) { ret err[Error].err{Error.builder{named.err}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the debug sections of a module that states source files, written by the dwarf producer from every unit's spans and runs
fun describe(e: *Emitter, format: *Format) err[Error] {
    if (!e.stated) { ret err[Error].ok{}; }
    val pointer: opt[arches.Pointer] = e.t.arch.pointer;
    if (sel pointer.none) { ret err[Error].ok{}; }
    var programs: vector.Vector[dwarf.Subprogram] = vector.init[dwarf.Subprogram](e.a);
    fin { vector.dnit[dwarf.Subprogram](?programs); }
    var i: usize = 0;
    for (i < e.programs.len) {
        val p:    Program          = e.programs.data[i];
        val made: dwarf.Subprogram = dwarf.Subprogram{
            function: p.function,
            start:    p.start,
            end:      p.end,
            spans:    Slice[dwarf.Span]{data: ?e.spans.data[p.spans], size: p.span},
            runs:     Slice[dwarf.Run]{data: ?e.runs.data[p.runs], size: p.run},
        };
        val pushed: err[Error] = alloc(vector.push[dwarf.Subprogram](?programs, made));
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    var names: *dwarf.Names = ?dwarf.ELF_NAMES;
    if (format == ?mink_format.MACHO) { names = ?dwarf.MACHO_NAMES; }
    var r: dwarf.Request = dwarf.Request{
        a:         e.a,
        m:         e.m,
        l:         ?e.l,
        b:         e.b,
        context:   ?e.opened.basis.context,
        address:   pointer.some.bytes,
        names:     names,
        lines:     masc_line.mark_count(?e.lines) > 0,
        functions: Slice[dwarf.Subprogram]{data: programs.data, size: programs.len},
    };
    val written: err[dwarf.Error] = dwarf.write(?r);
    if (sel written.err) { ret err[Error].err{Error.debug{written.err}}; }
    ret err[Error].ok{};
}

# hand the functions and globals of a module over to masc and take the object it makes
# ---
# a:       the allocator the object and everything made on the way take, the object's the caller's
# m:       the module, whose globals it defines and whose symbols the functions' operands name
# opened:  the target's build
# t:       the target, whose code declaration the alignment and fill come from, and whose layout and addresses place the globals
# units:   the functions, each allocated, framed and laid out
# modes:   the settings of the set's assembler modes the code is written under,
#          every other mode at its initial value
# listing: where masc's listing of the object is appended in the set's default syntax, none for no listing
# ret:     mink's object in memory, or why it was not made, leaving nothing
pub fun emit(a: *allocator.Allocator, m: *Module, opened: *Build, t: *Target, units: Slice[Unit], modes: Slice[mode.Setting], listing: opt[*vector.Vector[u8]]) res[object.Object, Error] {
    val arch: *arches.Arch                 = t.arch;
    val row:  res[*Convention, call.Error] = call.of(t);
    if (sel row.err) { ret res[object.Object, Error].err{Error.convention{row.err}}; }
    val abi: res[*arches.Abi, Error] = abi_of(row.ok, arch);
    if (sel abi.err) { ret res[object.Object, Error].err{abi.err}; }
    val format: res[*Format, record.Error] = record.format(t);
    if (sel format.err) { ret res[object.Object, Error].err{Error.format{format.err}}; }
    val fill: res[opt[u8], Error] = fill_of(t.caps.code.fill);
    if (sel fill.err) { ret res[object.Object, Error].err{fill.err}; }
    val indexed: res[fixup.Index, allocator.Error] = fixup.make(a, opened.basis.set);
    if (sel indexed.err) { ret res[object.Object, Error].err{Error.alloc{indexed.err}}; }
    var x: fixup.Index = indexed.ok;
    fin { fixup.release(?x); }
    val made: res[build.Builder, build.Refusal] = build.make(a, ?opened.formats, opened.basis.set, ?opened.basis.context, arch, format.ok);
    if (sel made.err) { ret res[object.Object, Error].err{Error.builder{made.err}}; }
    var b: build.Builder = made.ok;
    fin { build.release(?b); }
    val named: err[build.Refusal] = build.traits(?b, abi.ok);
    if (sel named.err) { ret res[object.Object, Error].err{Error.builder{named.err}}; }
    var k: usize = 0;
    for (k < modes.size) {
        val set: err[build.Refusal] = build.set_mode(?b, modes.data[k]);
        if (sel set.err) { ret res[object.Object, Error].err{Error.builder{set.err}}; }
        k = k + 1;
    }
    var e: Emitter = Emitter{
        a:         a,
        m:         m,
        opened:    opened,
        t:         t,
        l:         layout.of(t, ?m.types, opt[*core_state.Context].some{?opened.basis.context}),
        order:     arch.order,
        b:         ?b,
        x:         ?x,
        functions: vector.init[opt[build.Label]](a),
        ends:      vector.init[build.Label](a),
        emitters:  vector.init[opt[u32]](a),
        globals:   vector.init[opt[build.Label]](a),
        sections:  map.init_by[View, Opened](a, hash_name, same_name),
        kinds:     map.init_by[*section.Kind, build.Section](a, hash_kind, same_kind),
        fill:      fill.ok,
        function:  align_of(t.caps.code.function),
        framed:    starts_frames(opened, arch),
        lines:     masc_line.make(a),
        stated:    m.debug.files.len > 0,
        spans:     vector.init[dwarf.Span](a),
        runs:      vector.init[dwarf.Run](a),
        programs:  vector.init[Program](a),
    };
    fin {
        vector.dnit[opt[build.Label]](?e.functions);
        vector.dnit[build.Label](?e.ends);
        vector.dnit[opt[u32]](?e.emitters);
        vector.dnit[opt[build.Label]](?e.globals);
        map.dnit_by[View, Opened](?e.sections);
        map.dnit_by[*section.Kind, build.Section](?e.kinds);
        masc_line.release(?e.lines);
        vector.dnit[dwarf.Span](?e.spans);
        vector.dnit[dwarf.Run](?e.runs);
        vector.dnit[Program](?e.programs);
    }
    val sourced: err[Error] = files(?e);
    if (sel sourced.err) { ret res[object.Object, Error].err{sourced.err}; }
    val unnamed: err[allocator.Error] = slice.fill[opt[build.Label]](?e.functions, m.functions.len, opt[build.Label].none{});
    if (sel unnamed.err) { ret res[object.Object, Error].err{Error.alloc{unnamed.err}}; }
    val unemitted: err[allocator.Error] = slice.fill[opt[u32]](?e.emitters, m.functions.len, opt[u32].none{});
    if (sel unemitted.err) { ret res[object.Object, Error].err{Error.alloc{unemitted.err}}; }
    val ended: err[Error] = end_units(?e, units);
    if (sel ended.err) { ret res[object.Object, Error].err{ended.err}; }
    val unplaced: err[allocator.Error] = slice.fill[opt[build.Label]](?e.globals, m.globals.len, opt[build.Label].none{});
    if (sel unplaced.err) { ret res[object.Object, Error].err{Error.alloc{unplaced.err}}; }
    val text: res[build.Section, Error] = kind_section(?e, ?section.TEXT);
    if (sel text.err) { ret res[object.Object, Error].err{text.err}; }
    var i: usize = 0;
    for (i < units.size) {
        val done: err[Error] = emit_unit(?e, units.data[i], e.ends.data[i]);
        if (sel done.err) { ret res[object.Object, Error].err{done.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        val done: err[Error] = emit_global(?e, id.Global{index: i::u32});
        if (sel done.err) { ret res[object.Object, Error].err{done.err}; }
        i = i + 1;
    }
    val described: err[Error] = describe(?e, format.ok);
    if (sel described.err) { ret res[object.Object, Error].err{described.err}; }
    val finished: res[object.Object, build.Refusal] = build.finish(?b);
    if (sel finished.err) { ret res[object.Object, Error].err{finish_refused(?e, finished.err)}; }
    if (sel listing.some) {
        var o:       object.Object              = finished.ok;
        val dialect: opt[*masc_dialect.Dialect] = masc_dialect.of(format.ok, arch);
        if (sel dialect.none) {
            object.release(?o);
            ret res[object.Object, Error].err{Error.dialect{format.ok}};
        }
        val listed: err[masc_listing.Refusal] = masc_listing.write(?b, masc_listing.Options{syntax: masc_listing.DEFAULT, dialect: dialect.some}, listing.some);
        if (sel listed.err) {
            object.release(?o);
            ret res[object.Object, Error].err{Error.listing{listed.err}};
        }
    }
    ret res[object.Object, Error].ok{finished.ok};
}
