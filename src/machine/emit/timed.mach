# the walk of the encoded code of every function that requires constant time
#
# emission marks the code of each such function as a constant-time range of
# masc's builder, which mink's object keeps in the order the functions were
# emitted and lowers into the note the linker reads. once the object is made,
# each range's bytes are walked by masc's walk (`mirl.ct.check`) under the
# context the build encoded them under, from the secrets the function's entry
# holds and the marks allocation and framing left. the entry is seeded where
# its declaration says its secrets arrive (`mirl.ct.contract`): the register a
# secret piece arrives in, or the bytes of the incoming argument slot it
# arrives at. each frame slot marked
# secret, a secret value's spill slot or a frame local a secret is stored
# into, seeds at the place framing put it. a register seed is secret at entry:
# every register a secret piece arrives in, and every register no piece
# arrives in that the convention does not fix (`unfixed`), since what such a
# register holds at entry is its caller's and may be a secret. the walk
# carries secrecy from there. each secret range of every global of the module seeds
# the walk as the bytes of a global off its symbol (`mirl.ct.global`), secret
# for the whole function, and the walk places an access of one through the
# sites emission gives it: each symbolic operand of the code, its fixup kind,
# symbol and addend, at the instruction it fills, so it follows a global's
# address however the code forms it, pc-relative, in a high and a low part or
# through the got. each memory access whose instruction states what it reads,
# from the type of the pointer the front end reads through, seeds the walk
# with that secrecy at the instruction and the access (`walk.Seed.access`),
# which the walk takes in place of the extents for an access it places off no
# symbol and in no frame slot, as a load through a pointer parameter. each
# register an instruction the ir declares secret writes, as a call's result,
# seeds the walk at the instruction's byte (`walk.Seed.after`), but where the
# instruction reads memory, whose bytes the walk places or whose access states
# them, byte by byte where the ir marks an aggregate secret whole. a
# frame slot seeds the walk as a frame seed at the function's first byte, an
# extent from the stack pointer there, which the walk follows through the
# prologue. the return address the call pushed, and each frame slot of a fixed
# place whose address never leaves the registers but as the plain base of an
# access the walk follows (`mirl.machine.addressed`), are stated private for
# the whole function, so no access the walk does not place in the frame and no
# callee reaches it. an access that states a frame extent, as each access of a
# loop a copy or fill of a slot was made into (`mirl.ir.metadata.Extent`), is
# placed by a within seed in that range of its slot off the stack pointer at
# entry (`walk.Seed.within`), where the walk cannot place it by its address,
# and its slot stays private. every other frame local at a fixed place, whose
# address the code lets out, is stated as one object (`walk.Seed.local`), public
# where its ir stack slot states the type of what it holds holds no secret, and
# every instruction of an inline block is marked (`walk.Seed.inline`), whose
# frame accesses the walk holds below the stack pointer at entry. the walk
# takes the declassify points emission made, a
# branch that reads what it tests as public or an instruction that leaves what
# it writes public, at the byte of the range it stands at. the walk seeds no frame memory and reads
# a slot no store reaches as public, while the stack there may hold a secret
# an earlier frame left, so a function whose own frame reads a slot before any
# store writes it on some path from the entry is refused before it is walked,
# naming the slot's alloca (`mirl.ct.frame`). an access the walk places
# outside the frame and off no symbol that states nothing of what it reads
# reads a secret (`masc.walk`), the obligation every caller's model of a
# constant-time callee rests on.
#
# each call site emission made is walked through a model of its callee made
# from the convention of the callee's signature and the caller's frame, never
# restated per target. a callee reached through a register, whose row the code
# does not say, is modelled under every row a function or call of the module
# is under at once, preserving only what each preserves and writing what any
# writes. the callee preserves the stack pointer, the frame pointer and the
# registers the convention preserves whole, reads its arguments from the
# registers the call reads beyond its operands, the frame locals whose address
# the code lets out, which a pointer argument may reach, and the secret
# globals' ranges, writes its results, the registers the convention clobbers
# and the link, each secret after the call but a declared callee's result
# pieces, which hold what a trusted callee's declaration states and else what
# reaches the call, and those locals. every register the
# convention reserves and no instruction adds to is preserved, as no call
# changes it, and keeps the caller's frame from its lowest
# slot through the return address. memory outside that may be written with
# what the callee computes, globals included. a frame the walk cannot place
# from a fixed offset, as one the prologue realigns or of scaled size, keeps
# nothing.
#
# a call trusts its callee's declaration where `contract.trusted` says so: a
# direct call of a function declared constant time, in this module or another,
# whose definition nothing may replace, hard where the caller is. such a model
# accepts a secret where the declaration says one arrives, in the registers of
# its secret pieces, at the bytes of the outgoing argument area its secret
# stack pieces travel in and at the secret runs of each copy it passes by
# reference, and accepts one in every addressed local and secret global it
# reads. it states its callee's reads (`walk.Call.stated`), so a secret
# anywhere else the callee may reach joins the call, and every byte it may
# write is secret after it, without refusing it: the callee's own walk holds
# it to taking what it reads there as its accesses state. a secret in a piece
# the declaration says is public is refused, and so is a pointer the
# declaration states reaches storage holding no secret (`contract.pointers`)
# pointing into a frame local that may hold one. any other call accepts no
# secret, so a secret in an argument register, any read or any memory it does
# not keep refuses it, naming the callee where the call names one.
#
# a call of a typed stream is modelled from the same decisions
# (`stream_model`). it passes every value it pops, so its model names only those
# a trusted callee accepts a secret in, its declaration's secret parameters',
# and its extents stand off the local the code holds its frame by. the stack
# below what it pops and the caller's locals are out of any callee's reach, so
# nothing states them.
#
# a refusal is masc's one record at the byte of the function's code it stands
# at, and code the walk cannot follow on a set that classifies its rows is not
# met either. the walk reads the code under the timing modes the function's
# mode admits (`mirl.ct.check`): a soft function's code may need a mode the
# function switches on itself, as aarch64's dit=on, and a hard function's code
# holds only under the modes the build guarantees, or is refused naming the
# missing feature.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.base.store.Bytes;
use mink.base.table;
use mink.model.object;
use mink.model.object.CtRange;

use mirl.base.slice;
use mct: mirl.ct;
use mirl.ct.contract;
use secret_globals: mirl.ct.global;
use debug_record:   mirl.ir.debug.record;
use mirl.ir.function.Body;
use mirl.ir.function.Entry;
use mirl.ir.function.in_constant_time;
use mirl.ir.global.Range;
use mirl.ir.id;
use ir_instruction: mirl.ir.instruction;
use mirl.ir.metadata.Extent;
use mirl.ir.metadata.NO_PUBLICS;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_row:   mirl.ir.opcode.row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.place.Place;
use type_table: mirl.ir.type.table;
use mirl.machine.class.Physical;
use frame: mirl.machine.frame.record;
use mf:    mirl.machine.function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand.Instruction;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Registers;
use mirl.target.abi.convention.Resolved;
use mirl.target.build;
use mirl.target.build.Build;
use mirl.target.head;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.record.Target;

use masc.codec;
use masc.core.ct;
use masc.core.effect;
use masc.core.field;
use mo: masc.core.operand;
use masc.core.query;
use rf: masc.core.register;
use masc.core.requirement;
use masc.core.state;
use masc.core.switch.Source;
use masc.core.switch.Step;
use masc.core.switch.Steps;
use masc.walk;

# a framed function the walk reads its seeds through
# ---
# function: the function of the module
# context:  the context its code was encoded under, the build's or the one its
#           extensions past the build's open
# decode:   the context the walk decodes it under, `context` with what its
#           inline blocks' selections add, which `check` writes
# code:     its framed machine function, laid out
# layout:   its frame
pub rec Framed {
    function: id.Function;
    context:  *state.Context;
    decode:   *state.Context;
    code:     *mf.Function;
    layout:   *frame.Layout;
}

# a declassify point emission made in a function's code: a branch marked as declassifying reads a place it tests as
# public, and a declassifying copy leaves the place it writes public
# ---
# function: the function
# at:       where its instruction starts, in the section the code is in
# length:   the bytes of its instruction as the finished object holds it, which the walk holds the instruction at `at` to
# side:     the side of its instruction the point is on
# place:    what it makes public
pub rec Point {
    function: id.Function;
    at:       object.Place;
    length:   u64;
    side:     walk.Side;
    place:    walk.Place;
}

# a call site emission made in a function's code: a call, or a jump to a function, a tail call
# ---
# function:    the function making the call
# at:          where the instruction or the sequence the call is written in starts, in the section the code is in
# instruction: the call, in the function's framed code
# tail:        it is a tail call
# callee:      the function the call names, none for one it reaches through a register
# steps:       how many instructions the sequence from `at` holds, the call among them
pub rec Site {
    function:    id.Function;
    at:          object.Place;
    instruction: Instruction;
    tail:        bool;
    callee:      opt[id.Function];
    steps:       u32;
}

# a line fact emission stated in a function's code: the start of a run of instructions of one source location
# ---
# function: the function
# at:       where the run starts, in the section the code is in
# location: the source location of the run, none for instructions that state none
pub rec Line {
    function: id.Function;
    at:       object.Place;
    location: opt[debug_record.Location];
}

# a memory access emission wrote in a function's code whose instruction states what it reads
# ---
# function: the function
# at:       where the instruction or the sequence it is written in starts, in the section the code is in
# step:     which instruction of that sequence makes it, 0 for its first or one written alone
# access:   the access, as the walk names it
# secrecy:  whether it states what it reads, secret or public
# secret:   whether what it reads may hold a secret
# extent:   the frame extent it states, its slot the frame slot, length 0 for none
pub rec Stated {
    function: id.Function;
    at:       object.Place;
    step:     u32;
    access:   walk.Accessor;
    secrecy:  bool;
    secret:   bool;
    extent:   Extent;
}

# a symbolic operand emission wrote in a function's code, the fixup masc's builder left there, which the walk places a
# symbol's address by
# ---
# function: the function
# at:       where the instruction or the sequence it is written in starts, in the section the code is in
# step:     which instruction of that sequence it fills, 0 for its first or one written alone
# operand:  the operand of that instruction it fills
# fixup:    the set-local fixup kind it is applied as
# symbol:   the function or global it names, none for a low part naming its partner
# addend:   what the operand adds to the symbol
# partner:  where the instruction starts whose high part a low part takes, none for any other
pub rec Fixup {
    function: id.Function;
    at:       object.Place;
    step:     u32;
    operand:  u8;
    fixup:    mo.FixupKind;
    symbol:   opt[id.Symbol];
    addend:   i64;
    partner:  opt[object.Place];
}

# a register an instruction the ir declares secret leaves its result in, which emission marks for the walk to seed
# ---
# function: the function
# at:       where the instruction or the sequence it is written in starts, in the section the code is in
# step:     which instruction of that sequence writes it, 0 for its first or one written alone
# register: the register
pub rec Result {
    function: id.Function;
    at:       object.Place;
    step:     u32;
    register: rf.Id;
}

# what the walk takes of an instruction beyond its row
# ---
# pointer: an inline block's instruction naming an operand whose memory holds a pointer, whose type states its storage
#          holds a secret in every byte (true) or none (false), as the walk's pointer seed states it
# switch:  an instruction of the function's own timing switch, which selection placed, never an inline block's
# inline:  an instruction of an inline block, whose frame accesses the walk holds to the function's own frame
pub tag Fact: u8 {
    pointer: bool;
    switch;
    inline;
}

# an instruction emission wrote in a function's code that the walk takes a fact of
# ---
# function: the function
# at:       where the instruction or the sequence it is written in starts, in the section the code is in
# step:     which instruction of that sequence it is, 0 for its first or one written alone, an inline block's counted one
#           by one
# fact:     what the walk takes of it
pub rec Marked {
    function: id.Function;
    at:       object.Place;
    step:     u32;
    fact:     Fact;
}

# what emission marks in the code for the walk: its declassify points, its call sites, the line facts that map an
# offset of the code back to the source location of its instruction, its symbolic operands, its stated memory accesses,
# the registers declared-secret instructions write and the instructions it takes a fact of beyond their rows
pub rec Marks {
    points:   vector.Vector[Point];
    sites:    vector.Vector[Site];
    lines:    vector.Vector[Line];
    fixups:   vector.Vector[Fixup];
    accesses: vector.Vector[Stated];
    results:  vector.Vector[Result];
    marked:   vector.Vector[Marked];
}

# no marks yet, their storage taken from `a`
pub fun marks(a: *allocator.Allocator) Marks {
    ret Marks{points: vector.init[Point](a), sites: vector.init[Site](a), lines: vector.init[Line](a), fixups: vector.init[Fixup](a), accesses: vector.init[Stated](a), results: vector.init[Result](a), marked: vector.init[Marked](a)};
}

# give back the storage of marks
pub fun release(m: *Marks) {
    vector.dnit[Point](?m.points);
    vector.dnit[Site](?m.sites);
    vector.dnit[Line](?m.lines);
    vector.dnit[Fixup](?m.fixups);
    vector.dnit[Stated](?m.accesses);
    vector.dnit[Result](?m.results);
    vector.dnit[Marked](?m.marked);
}

# whether a function requires constant time and has a body
pub fun requires(m: *Module, f: id.Function) bool {
    ret in_constant_time(m.functions.data[f].data.constant_time) && m.functions.data[f].body.blocks.len > 0;
}

# the seeds of function `f`'s entry, where its declaration says its secrets arrive (`contract.arrivals`): the register
# a secret piece arrives in, or the bytes of the incoming argument slot it arrives at, every register no argument
# piece arrives in that its convention does not fix (`unfixed`), then its frame's. false where a secret arrives where
# no seed can place it, or the entry is not placed
fun seeds(a: *allocator.Allocator, m: *Module, bd: *Build, l: *Layout, f: *Framed, out: *vector.Vector[walk.Seed]) res[bool, allocator.Error] {
    val b: *Body = ?m.functions.data[f.function].body;
    if (b.blocks.len == 0) { ret res[bool, allocator.Error].ok{true}; }
    val entry: Entry = b.entry;
    if (!(sel entry.placed)) { ret res[bool, allocator.Error].ok{false}; }
    var arrived: vector.Vector[contract.Arrival] = vector.init[contract.Arrival](a);
    fin { vector.dnit[contract.Arrival](?arrived); }
    val classified: res[bool, allocator.Error] = contract.arrivals(a, m, bd, l, f.function, ?arrived);
    if (sel classified.err) { ret classified; }
    if (!classified.ok)     { ret classified; }
    var j: usize = 0;
    for (j < arrived.len) {
        val x: contract.Arrival = arrived.data[j];
        j = j + 1;
        if (!x.secret) { cnt; }
        val at:   Place     = x.place;
        var seed: walk.Seed = walk.Seed.register{rf.NONE};
        if (sel at.register) { seed = walk.Seed.register{at.register}; }
        or (sel at.stack) {
            if (!(sel at.stack.scale.fixed)) { ret res[bool, allocator.Error].ok{false}; }
            seed = walk.Seed.memory{walk.Extent{base: f.layout.stack, offset: (f.layout.entry + at.stack.offset)::i64, length: x.length}};
        }
        or { ret res[bool, allocator.Error].ok{false}; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, seed);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    val carried: res[opt[Place], allocator.Error] = contract.address(a, m, bd, l, f.function);
    if (sel carried.err) { ret res[bool, allocator.Error].err{carried.err}; }
    val left: err[allocator.Error] = unfixed(a, m, bd, f, ?arrived, carried.ok, out);
    if (sel left.err) { ret res[bool, allocator.Error].err{left.err}; }
    val marked: res[bool, allocator.Error] = slots(f, out);
    if (sel marked.err) { ret marked; }
    if (!marked.ok)     { ret marked; }
    val kept: res[bool, allocator.Error] = privates(f, out);
    if (sel kept.err) { ret kept; }
    if (!kept.ok)     { ret kept; }
    val objects: res[bool, allocator.Error] = locals(m, f, out);
    if (sel objects.err) { ret objects; }
    if (!objects.ok)     { ret objects; }
    ret saves(f, out);
}

# a register seed for each register of `f`'s convention, preserved or clobbered, sharing storage with no register an
# argument piece arrives in (`arrived`) nor the one its result's address arrives in where it returns by reference
# (`carried`), the call writing both, nor the link the call instruction writes, and a fixed seed for each register the
# convention holds public at every entry: the stack pointer, the timing mode's (`mode_registers`) and each register it
# reserves that no instruction adds to, as the thread pointer, which nothing allocates, so only an instruction of a
# function's own could leave a secret there, which the walk refuses at the write. a reserved register an instruction
# adds to holds flags its caller's arithmetic accrued, and the frame pointer is allocated as any preserved register is
# where the frame keeps none, so each is seeded with what any other holds at entry: its caller's, which may be a secret
fun unfixed(a: *allocator.Allocator, m: *Module, bd: *Build, f: *Framed, arrived: *vector.Vector[contract.Arrival], carried: opt[Place], out: *vector.Vector[walk.Seed]) err[allocator.Error] {
    var rows: vector.Vector[*Registers] = vector.init[*Registers](a);
    fin { vector.dnit[*Registers](?rows); }
    val rowed: err[allocator.Error] = rows_of(m, bd, opt[id.Function].some{f.function}, ?rows);
    if (sel rowed.err) { ret rowed; }
    if (rows.len == 0) { ret err[allocator.Error].ok{}; }
    val regs:  *Registers           = rows.data[0];
    val file:  *rf.File             = bd.basis.set.codec.registers;
    var fixed: vector.Vector[rf.Id] = vector.init[rf.Id](a);
    var held:  vector.Vector[rf.Id] = vector.init[rf.Id](a);
    fin {
        vector.dnit[rf.Id](?fixed);
        vector.dnit[rf.Id](?held);
    }
    var j: usize = 0;
    for (j < arrived.len) {
        val at: Place = arrived.data[j].place;
        j = j + 1;
        if (sel at.register) {
            val kept: err[allocator.Error] = fix(?fixed, at.register);
            if (sel kept.err) { ret kept; }
        }
    }
    if (sel carried.some) {
        val at: Place = carried.some;
        if (sel at.register) {
            val kept: err[allocator.Error] = fix(?fixed, at.register);
            if (sel kept.err) { ret kept; }
        }
    }
    val modes: err[allocator.Error] = mode_registers(bd, f, ?held);
    if (sel modes.err) { ret modes; }
    val stacks: [2]opt[rf.Id] = [2]opt[rf.Id]{regs.stack, opt[rf.Id].some{f.layout.stack}};
    j = 0;
    for (j < 2) {
        val one: opt[rf.Id] = stacks[j];
        j = j + 1;
        if (sel one.some) {
            val kept: err[allocator.Error] = fix(?held, one.some);
            if (sel kept.err) { ret kept; }
        }
    }
    val written: [2]opt[rf.Id] = [2]opt[rf.Id]{regs.link, regs.carrier};
    j = 0;
    for (j < 2) {
        val one: opt[rf.Id] = written[j];
        j = j + 1;
        if (sel one.some) {
            val kept: err[allocator.Error] = fix(?fixed, one.some);
            if (sel kept.err) { ret kept; }
        }
    }
    j = 0;
    for (j < regs.reserved.size) {
        val reg: rf.Id = regs.reserved.data[j];
        j = j + 1;
        if (unaccrued(file, reg)) {
            val kept: err[allocator.Error] = fix(?held, reg);
            if (sel kept.err) { ret kept; }
        }
        or (accrues(file, reg) && !shares_fixed(file, ?fixed, reg)) {
            val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.register{reg});
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        }
    }
    j = 0;
    for (j < held.len) {
        val reg: rf.Id = held.data[j];
        j = j + 1;
        val row: opt[*rf.Register] = rf.row_of(file, reg);
        if (sel row.none) { cnt; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.fixed{reg});
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        val kept: err[allocator.Error] = fix(?fixed, reg);
        if (sel kept.err) { ret kept; }
    }
    val lists: [2]Slice[rf.Id] = [2]Slice[rf.Id]{regs.preserved, regs.clobbered};
    var l:     usize           = 0;
    for (l < 2) {
        val list: Slice[rf.Id] = lists[l];
        l = l + 1;
        var k: usize = 0;
        for (k < list.size) {
            val reg: rf.Id = list.data[k];
            k = k + 1;
            if (shares_fixed(file, ?fixed, reg)) { cnt; }
            val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.register{reg});
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        }
    }
    ret err[allocator.Error].ok{};
}

# the registers holding the timing mode the function switches, each a register the switch's read names as a fixed
# value, as aarch64's dit: what the entry finds there is its caller's mode, which it reads to restore at every exit
fun mode_registers(bd: *Build, f: *Framed, fixed: *vector.Vector[rf.Id]) err[allocator.Error] {
    val got: opt[mct.Switching] = mct.switching(bd.basis.set, f.context);
    if (sel got.none) { ret err[allocator.Error].ok{}; }
    val read: *Steps = ?got.some.switch.read;
    var k:    u32    = 0;
    for (k < read.len) {
        val step: *Step = ?read.at[k];
        var n:    u32   = 0;
        for (n < step.values.len) {
            val from: Source = step.values.at[n];
            if (sel from.value) {
                val v: mo.Value = from.value;
                if (sel v.register) {
                    val kept: err[allocator.Error] = fix(fixed, v.register);
                    if (sel kept.err) { ret kept; }
                }
            }
            n = n + 1;
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

fun fix(fixed: *vector.Vector[rf.Id], reg: rf.Id) err[allocator.Error] {
    if (reg == rf.NONE) { ret err[allocator.Error].ok{}; }
    val pushed: res[usize, allocator.Error] = vector.push[rf.Id](fixed, reg);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

# whether `reg` shares storage with a register of `fixed`, or is one the file holds no row of or reads as zero
fun shares_fixed(file: *rf.File, fixed: *vector.Vector[rf.Id], reg: rf.Id) bool {
    val row: opt[*rf.Register] = rf.row_of(file, reg);
    if (sel row.none)                              { ret true; }
    if ((row.some.flags & (rf.ZERO | rf.PC)) != 0) { ret true; }
    var i: usize = 0;
    for (i < fixed.len) {
        val other: opt[*rf.Register] = rf.row_of(file, fixed.data[i]);
        if (sel other.some) {
            if (rf.overlap(file, row.some, other.some)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# where slot `i` of a framed function lies as an offset from the canonical frame address, none for a slot of no fixed
# place there, as one dropped, of scaled size or off a stack pointer the prologue realigns
fun from_cfa(code: *mf.Function, l: *frame.Layout, i: usize) opt[i64] {
    if (i >= l.slots.len || code.slots.data[i].per != 0) { ret opt[i64].none{}; }
    val p: frame.Place = l.slots.data[i];
    if (!(sel p.at)) { ret opt[i64].none{}; }
    val a: frame.Address = p.at;
    if (a.offset.per != 0)                 { ret opt[i64].none{}; }
    if (sel a.base.frame)                  { ret opt[i64].some{l.at + a.offset.fixed}; }
    if (l.size.per != 0 || l.realign != 0) { ret opt[i64].none{}; }
    ret opt[i64].some{a.offset.fixed - l.size.fixed};
}

# the slot seeds of the allocation's and the selection's marks: each frame slot marked secret, a spill slot of a
# secret value or a frame local a secret is stored into, at the place framing put it, as a frame seed at the
# function's first byte off the stack pointer there, but a private one (`privates`), every access of which the walk
# places exactly, so it holds what the stores the walk follows put there, byte by byte, and a public member of an
# aggregate a secret is stored beside stays public. false when a marked slot has no fixed place from there
fun slots(f: *Framed, out: *vector.Vector[walk.Seed]) res[bool, allocator.Error] {
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    var i:    usize         = 0;
    for (i < code.slots.len) {
        val s: mf.SlotData = code.slots.data[i];
        if (s.secret && sel s.area.local && i < l.slots.len && !private_slot(f, i)) {
            val p: frame.Place = l.slots.data[i];
            if (sel p.at) {
                val cfa: opt[i64] = from_cfa(code, l, i);
                if (sel cfa.none) { ret res[bool, allocator.Error].ok{false}; }
                val slot:   walk.Slot                   = walk.Slot{at: 0, extent: walk.Extent{base: l.stack, offset: l.entry::i64 + cfa.some, length: s.size}};
                val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.frame{slot});
                if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# the private seeds of the function's own frame, each an extent off the stack pointer's value on entry: the return
# address its call pushed, which only the call writes and the return reads, both off the stack pointer, and each frame
# slot at a fixed place there whose address the code never lets out, as the allocation's marks say. none for a set
# of no stack pointer or of a typed stream, whose walk places no frame
fun privates(f: *Framed, out: *vector.Vector[walk.Seed]) res[bool, allocator.Error] {
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    if (l.stack == rf.NONE || code.set.codec.stream != nil) { ret res[bool, allocator.Error].ok{true}; }
    if (l.entry > 0) {
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.private{walk.Private{offset: 0, length: l.entry}});
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    var i: usize = 0;
    for (i < code.slots.len) {
        val cfa: opt[i64] = from_cfa(code, l, i);
        if (sel cfa.some) {
            if (private_slot(f, i)) {
                val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.private{walk.Private{offset: l.entry::i64 + cfa.some, length: code.slots.data[i].size}});
                if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# the local seeds of the function's own frame, each an extent off the stack pointer's value on entry: each frame local
# at a fixed place there whose address the code lets out, and a typed seed for each range of it its ir stack slot's
# alloca states public (`mf.SlotData.publics`), the bytes its front end's type lays out as public. one whose address
# never leaves is private, which says more. none for a set of no stack pointer or of a typed stream
fun locals(m: *Module, f: *Framed, out: *vector.Vector[walk.Seed]) res[bool, allocator.Error] {
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    if (l.stack == rf.NONE || code.set.codec.stream != nil) { ret res[bool, allocator.Error].ok{true}; }
    var i: usize = 0;
    for (i < code.slots.len) {
        val s: mf.SlotData = code.slots.data[i];
        if (s.size != 0 && sel s.area.local && !private_slot(f, i)) {
            val cfa: opt[i64] = from_cfa(code, l, i);
            if (sel cfa.some) {
                val at:     i64                         = l.entry::i64 + cfa.some;
                val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.local{walk.Local{offset: at, length: s.size, stated: s.publics != NO_PUBLICS}});
                if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
                val res_ranges: res[Slice[Range], module.Error] = module.public_ranges(m, s.publics);
                if (sel res_ranges.err) { ret res[bool, allocator.Error].ok{false}; }
                var k: usize = 0;
                for (k < res_ranges.ok.size) {
                    val r:         Range                       = res_ranges.ok.data[k];
                    val res_typed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.typed{walk.Private{offset: at + r.offset::i64, length: r.length}});
                    if (sel res_typed.err) { ret res[bool, allocator.Error].err{res_typed.err}; }
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# the saved seeds of the function's own frame, each an extent off the stack pointer's value on entry: each slot the
# prologue saves a register in, which only the frame code writes and the epilogue restores the register from, so the
# walk refuses an inline block's store there. none for a set of no stack pointer or of a typed stream. false for a save
# of no fixed place there, as one in the scaled area, which no seed can place
fun saves(f: *Framed, out: *vector.Vector[walk.Seed]) res[bool, allocator.Error] {
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    if (l.stack == rf.NONE || code.set.codec.stream != nil) { ret res[bool, allocator.Error].ok{true}; }
    var i: usize = 0;
    for (i < l.saves.len) {
        val save: frame.Save = l.saves.data[i];
        i = i + 1;
        val slot: usize = save.slot::usize;
        if (save.offset.per != 0 || slot >= code.slots.len || code.slots.data[slot].size == 0) { ret res[bool, allocator.Error].ok{false}; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.saved{walk.Private{offset: l.entry::i64 + save.offset.fixed, length: code.slots.data[slot].size}});
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    ret res[bool, allocator.Error].ok{true};
}

# whether slot `i` of framed function `f` is stated private: a frame local, or a stack argument of its own, at a fixed
# place whose address the code never lets out, on a set with a stack pointer and no typed stream. a stack argument is
# its caller's outgoing area, which nothing but the function reaches while it runs unless it lets the address out
fun private_slot(f: *Framed, i: usize) bool {
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    if (l.stack == rf.NONE || code.set.codec.stream != nil) { ret false; }
    val s: mf.SlotData = code.slots.data[i];
    if (s.addressed || s.size == 0)                    { ret false; }
    if (!(sel s.area.local) && !(sel s.area.incoming)) { ret false; }
    val cfa: opt[i64] = from_cfa(code, l, i);
    ret sel cfa.some;
}

# the points of `points` in function `f`'s range `r`, each at its offset from the range's start. false when one stands
# outside the range, which no walk of it can apply
fun public(f: *Framed, r: *CtRange, points: Slice[Point], out: *vector.Vector[walk.Declassify]) res[bool, allocator.Error] {
    var i: usize = 0;
    for (i < points.size) {
        val p: *Point = ?points.data[i];
        if (p.function == f.function) {
            if (p.at.section.index != r.section.index || p.at.offset < r.start || p.at.offset >= r.end) { ret res[bool, allocator.Error].ok{false}; }
            val pushed: res[usize, allocator.Error] = vector.push[walk.Declassify](out, walk.Declassify{at: p.at.offset - r.start, length: p.length, side: p.side, place: p.place});
            if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# a run of a model's registers or extents in the storage every model of a range shares
pub rec Run {
    first: u32;
    len:   u32;
}

# one call model of a range, its runs into the shared storage, which moves until every model is made
# ---
# at:        the offset of the call from the range's start
# stated:    whether the call trusts its callee's declaration (`contract.trusted`), so the callee reads memory it is
#            not named only through accesses that state their secrecy and takes a secret there as secret
# callee:    the function the call names, none for one it reaches through a register
# popped:    the values a call of a typed stream pops it accepts a secret in, its secret parameters', none when not trusted
# preserved: the registers it preserves
# arguments: the registers it reads its arguments from
# accepted:  the argument registers it accepts a secret in, its secret parameters', none when not trusted
# written:   the registers it writes
# results:   the result pieces of `results` its callee's declaration states, none when not trusted
# memory:    the extents off the register its result's address travels in that its callee's declaration states public,
#            none for a result returned by value or a call that does not trust its callee
# reads:     the extents of the caller's frame it may read, and the secret globals' ranges
# taken:     the extents of `reads` it accepts a secret in, none when not trusted
# writes:    the extents of the caller's frame it may write
# kept:      the extents of the caller's frame it keeps
# pointed:   the argument registers holding a pointer its callee's declaration states reaches public storage, none when
#            not trusted
# keeps:     whether its callee writes no memory, as the page probe of a prologue
# owned:     the extents of the caller's outgoing argument area no argument of the call fills, which the callee takes as
#            its own frame
pub rec Model {
    at:        u64;
    stated:    bool;
    callee:    opt[id.Function];
    popped:    mo.Positions;
    preserved: Run;
    arguments: Run;
    accepted:  Run;
    written:   Run;
    results:   Run;
    memory:    Run;
    reads:     Run;
    taken:     Run;
    writes:    Run;
    kept:      Run;
    pointed:   Run;
    keeps:     bool;
    owned:     Run;
}

# the storage of a range's call models
# ---
# models:  each model
# ids:     every register the models name
# extents: every extent the models name
# results: every result piece the models name
# calls:   the walk's model of each, made once the others are complete
pub rec Models {
    models:  vector.Vector[Model];
    ids:     vector.Vector[rf.Id];
    extents: vector.Vector[walk.Extent];
    results: vector.Vector[walk.Result];
    calls:   vector.Vector[walk.Call];
}

pub fun models_of(a: *allocator.Allocator) Models {
    ret Models{models: vector.init[Model](a), ids: vector.init[rf.Id](a), extents: vector.init[walk.Extent](a), results: vector.init[walk.Result](a), calls: vector.init[walk.Call](a)};
}

pub fun release_models(x: *Models) {
    vector.dnit[Model](?x.models);
    vector.dnit[rf.Id](?x.ids);
    vector.dnit[walk.Extent](?x.extents);
    vector.dnit[walk.Result](?x.results);
    vector.dnit[walk.Call](?x.calls);
}

# whether run `r` of `x.ids` holds a register sharing storage with `reg` of `file`, or `reg` itself
fun holds(x: *Models, file: *rf.File, r: Run, reg: rf.Id) bool {
    val row: opt[*rf.Register] = rf.row_of(file, reg);
    var i:   u32               = 0;
    for (i < r.len) {
        val other: rf.Id = x.ids.data[(r.first + i)::usize];
        if (other == reg) { ret true; }
        if (sel row.some) {
            val o: opt[*rf.Register] = rf.row_of(file, other);
            if (sel o.some && rf.overlap(file, row.some, o.some)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# `reg` added to the run that began at `first` of `x.ids`, once: not when it is there already, when it is no row of
# `file` or a zero register, or when it shares storage with a register of `apart`
fun add(x: *Models, file: *rf.File, first: u32, reg: rf.Id, apart: Run) err[allocator.Error] {
    if (reg == rf.NONE) { ret err[allocator.Error].ok{}; }
    val row: opt[*rf.Register] = rf.row_of(file, reg);
    if (sel row.none)                    { ret err[allocator.Error].ok{}; }
    if ((row.some.flags & rf.ZERO) != 0) { ret err[allocator.Error].ok{}; }
    if (holds(x, file, apart, reg))      { ret err[allocator.Error].ok{}; }
    var i: usize = first::usize;
    for (i < x.ids.len) {
        if (x.ids.data[i] == reg) { ret err[allocator.Error].ok{}; }
        i = i + 1;
    }
    val pushed: res[usize, allocator.Error] = vector.push[rf.Id](?x.ids, reg);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

fun add_all(x: *Models, file: *rf.File, first: u32, regs: Slice[rf.Id], apart: Run) err[allocator.Error] {
    var i: usize = 0;
    for (i < regs.size) {
        val added: err[allocator.Error] = add(x, file, first, regs.data[i], apart);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun ended(x: *Models, first: u32) Run {
    ret Run{first: first, len: x.ids.len::u32 - first};
}

val NO_RUN: Run = Run{first: 0, len: 0};

# whether `r` is none of `skip`
fun kept_whole(r: rf.Id, skip: Slice[rf.Id]) bool {
    var i: usize = 0;
    for (i < skip.size) {
        if (skip.data[i] == r) { ret false; }
        i = i + 1;
    }
    ret true;
}

# `reg` added as `add` adds it, where there is one
fun add_some(x: *Models, file: *rf.File, first: u32, reg: opt[rf.Id], apart: Run) err[allocator.Error] {
    if (sel reg.none) { ret err[allocator.Error].ok{}; }
    ret add(x, file, first, reg.some, apart);
}

# the registers the call `d` reads beyond its operands, or with `write` writes, added as `add` adds them
fun add_implied(x: *Models, file: *rf.File, first: u32, d: *InstructionData, write: bool, apart: Run) err[allocator.Error] {
    var i: usize = 0;
    for (i < d.implicit.size) {
        val at: Physical = d.implicit.data[i].location;
        if (d.implicit.data[i].write == write) {
            if (sel at.register) {
                val added: err[allocator.Error] = add(x, file, first, at.register, apart);
                if (sel added.err) { ret added; }
            }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# whether `reg` is in `list`
fun listed(list: Slice[rf.Id], reg: rf.Id) bool {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i] == reg) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether every row of `rows` preserves `reg` whole
fun kept_by_all(rows: Slice[*Registers], reg: rf.Id) bool {
    var k: usize = 0;
    for (k < rows.size) {
        if (!listed(rows.data[k].preserved, reg) || !kept_whole(reg, rows.data[k].partial)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether every row of `rows` homes its stack pointer in `reg`, or with `pointer` keeps its frame pointer in it
fun named_by_all(rows: Slice[*Registers], reg: rf.Id, pointer: bool) bool {
    var k: usize = 0;
    for (k < rows.size) {
        var named: opt[rf.Id] = rows.data[k].stack;
        if (pointer)           { named = rows.data[k].pointer; }
        if (sel named.none)    { ret false; }
        if (named.some != reg) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the register the first of `rows` homes its stack pointer in, or with `pointer` keeps its frame pointer in, added
# as `add` adds it when every row names it
fun add_named(x: *Models, file: *rf.File, first: u32, rows: Slice[*Registers], pointer: bool) err[allocator.Error] {
    var named: opt[rf.Id] = rows.data[0].stack;
    if (pointer)                                  { named = rows.data[0].pointer; }
    if (sel named.none)                           { ret err[allocator.Error].ok{}; }
    if (!named_by_all(rows, named.some, pointer)) { ret err[allocator.Error].ok{}; }
    ret add(x, file, first, named.some, NO_RUN);
}

# the registers a callee under any row of `rows` preserves, beside the caller's frame `l`: the stack pointer, the
# frame pointer, every register each row preserves whole, and every register each reserves, which no call saves or
# clobbers, but one an instruction adds to (`unaccrued`)
fun preserved(x: *Models, file: *rf.File, rows: Slice[*Registers], l: *frame.Layout) res[Run, allocator.Error] {
    val first: u32                  = x.ids.len::u32;
    val sp:    err[allocator.Error] = add(x, file, first, l.stack, NO_RUN);
    if (sel sp.err) { ret res[Run, allocator.Error].err{sp.err}; }
    val fp: err[allocator.Error] = add(x, file, first, l.pointer, NO_RUN);
    if (sel fp.err)     { ret res[Run, allocator.Error].err{fp.err}; }
    if (rows.size == 0) { ret res[Run, allocator.Error].ok{ended(x, first)}; }
    val stack: err[allocator.Error] = add_named(x, file, first, rows, false);
    if (sel stack.err) { ret res[Run, allocator.Error].err{stack.err}; }
    val pointer: err[allocator.Error] = add_named(x, file, first, rows, true);
    if (sel pointer.err) { ret res[Run, allocator.Error].err{pointer.err}; }
    val one: *Registers = rows.data[0];
    var i:   usize      = 0;
    for (i < one.preserved.size) {
        val reg: rf.Id = one.preserved.data[i];
        if (kept_by_all(rows, reg)) {
            val added: err[allocator.Error] = add(x, file, first, reg, NO_RUN);
            if (sel added.err) { ret res[Run, allocator.Error].err{added.err}; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < one.reserved.size) {
        val reg: rf.Id = one.reserved.data[i];
        if (reserved_by_all(rows, reg) && unaccrued(file, reg)) {
            val added: err[allocator.Error] = add(x, file, first, reg, NO_RUN);
            if (sel added.err) { ret res[Run, allocator.Error].err{added.err}; }
        }
        i = i + 1;
    }
    ret res[Run, allocator.Error].ok{ended(x, first)};
}

# whether every row of `rows` reserves `reg`
fun reserved_by_all(rows: Slice[*Registers], reg: rf.Id) bool {
    var k: usize = 0;
    for (k < rows.size) {
        if (!listed(rows.data[k].reserved, reg)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether an instruction adds to `reg` rather than replacing it. a register only holding one, as risc-v fcsr holds
# fflags beside frm, takes its secret from that one's seed, so the rest of it stays as fixed as it is
fun accrues(file: *rf.File, reg: rf.Id) bool {
    val row: opt[*rf.Register] = rf.row_of(file, reg);
    if (sel row.some) { ret (row.some.flags & rf.ACCRUED) != 0; }
    ret false;
}

# whether no instruction adds to `reg` or to a register sharing storage with it rather than replacing it, as one adds
# to risc-v fflags and so to the fcsr holding it, so a callee's arithmetic leaves no flag of its own data there
fun unaccrued(file: *rf.File, reg: rf.Id) bool {
    val row: opt[*rf.Register] = rf.row_of(file, reg);
    if (sel row.none)                       { ret false; }
    if ((row.some.flags & rf.ACCRUED) != 0) { ret false; }
    var k: u32 = 0;
    for (k < file.register_count) {
        val other: *rf.Register = ?file.registers[k];
        if ((other.flags & rf.ACCRUED) != 0 && rf.overlap(file, row.some, other)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the registers the call `d` reads beyond its operands, the locations its arguments travel in
fun arguments(x: *Models, file: *rf.File, d: *InstructionData) res[Run, allocator.Error] {
    val first: u32                  = x.ids.len::u32;
    val added: err[allocator.Error] = add_implied(x, file, first, d, false, NO_RUN);
    if (sel added.err) { ret res[Run, allocator.Error].err{added.err}; }
    ret res[Run, allocator.Error].ok{ended(x, first)};
}

# the registers a callee under any row of `rows` writes: its results, every register a row clobbers, the link and
# what the call `d` writes beyond its operands, none sharing storage with one it preserves
fun written(x: *Models, file: *rf.File, rows: Slice[*Registers], d: *InstructionData, kept: Run) res[Run, allocator.Error] {
    val first: u32   = x.ids.len::u32;
    var k:     usize = 0;
    for (k < rows.size) {
        val regs:    *Registers           = rows.data[k];
        val results: err[allocator.Error] = add_all(x, file, first, regs.returning.registers, kept);
        if (sel results.err) { ret res[Run, allocator.Error].err{results.err}; }
        val clobbered: err[allocator.Error] = add_all(x, file, first, regs.clobbered, kept);
        if (sel clobbered.err) { ret res[Run, allocator.Error].err{clobbered.err}; }
        val link: err[allocator.Error] = add_some(x, file, first, regs.link, kept);
        if (sel link.err) { ret res[Run, allocator.Error].err{link.err}; }
        k = k + 1;
    }
    val implied: err[allocator.Error] = add_implied(x, file, first, d, true, kept);
    if (sel implied.err) { ret res[Run, allocator.Error].err{implied.err}; }
    ret res[Run, allocator.Error].ok{ended(x, first)};
}

# the register the caller's frame `l` is named off at a call and what it holds there as an offset from the canonical
# frame address: the frame pointer where the frame keeps one, which nothing in the body moves, else the stack pointer
# as the prologue left it. none for a frame of no fixed offset from there
rec Based {
    base: rf.Id;
    at:   i64;
}

fun based(l: *frame.Layout) opt[Based] {
    if (l.red != 0)                        { ret opt[Based].none{}; }
    if (l.pointer != rf.NONE)              { ret opt[Based].some{Based{base: l.pointer, at: l.at}}; }
    if (l.size.per != 0 || l.realign != 0) { ret opt[Based].none{}; }
    ret opt[Based].some{Based{base: l.stack, at: -l.size.fixed}};
}

fun extent(x: *Models, e: walk.Extent) err[allocator.Error] {
    val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](?x.extents, e);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the caller's frame a callee keeps and the addressed frame locals it may read and write, a pointer argument reaching
# them: `kept` from its lowest slot through the return address, and every addressed local into `touched`, the first
# `locals` of them. all empty for a frame the walk cannot place from a fixed offset, so every byte may be read and
# written. the outgoing argument area, where the caller stores the arguments a call passes on the stack and the callee
# reads and may write them, is in `touched` past the locals where the walk places it, which `outgoing` says
fun frame_of(x: *Models, f: *Framed, kept: *Run, touched: *Run, locals: *u32, outgoing: *bool) err[allocator.Error] {
    @kept     = Run{first: x.extents.len::u32, len: 0};
    @touched  = @kept;
    @locals   = 0;
    @outgoing = false;
    val code: *mf.Function  = f.code;
    val l:    *frame.Layout = f.layout;
    val got:  opt[Based]    = based(l);
    if (sel got.none) { ret err[allocator.Error].ok{}; }
    val b:   Based = got.some;
    var low: i64   = -(l.entry::i64);
    var i:   usize = 0;
    for (i < code.slots.len) {
        val s: mf.SlotData = code.slots.data[i];
        if (sel s.area.local && i < l.slots.len) {
            val p: frame.Place = l.slots.data[i];
            if (sel p.at) {
                val cfa: opt[i64] = from_cfa(code, l, i);
                if (sel cfa.none)   { ret err[allocator.Error].ok{}; }
                if (cfa.some < low) { low = cfa.some; }
            }
        }
        i = i + 1;
    }
    if (low < 0) {
        val made: err[allocator.Error] = extent(x, walk.Extent{base: b.base, offset: low - b.at, length: (-low)::u64});
        if (sel made.err) { ret made; }
    }
    @kept    = Run{first: kept.first, len: x.extents.len::u32 - kept.first};
    @touched = Run{first: x.extents.len::u32, len: 0};
    i        = 0;
    for (i < code.slots.len) {
        val s: mf.SlotData = code.slots.data[i];
        if (s.addressed && sel s.area.local) {
            val cfa: opt[i64] = from_cfa(code, l, i);
            if (sel cfa.some) {
                val made: err[allocator.Error] = extent(x, walk.Extent{base: b.base, offset: cfa.some - b.at, length: s.size});
                if (sel made.err) { ret made; }
            }
        }
        i = i + 1;
    }
    @locals = x.extents.len::u32 - touched.first;
    if (l.size.per == 0 && l.realign == 0) {
        if (l.outgoing > 0) {
            val made: err[allocator.Error] = extent(x, walk.Extent{base: b.base, offset: -l.size.fixed - b.at, length: l.outgoing});
            if (sel made.err) { ret made; }
        }
        @outgoing = true;
    }
    @touched = Run{first: touched.first, len: x.extents.len::u32 - touched.first};
    ret err[allocator.Error].ok{};
}

# whether function type `ty` names row `k` of the build
fun names_row(m: *Module, b: *Build, ty: type_table.Type, k: usize) bool {
    val sig: res[type_table.Function, type_table.Error] = type_table.signature(?m.types, ty);
    if (sel sig.err) { ret false; }
    val at: opt[usize] = build.index_of(b, sig.ok.convention);
    ret sel at.some && at.some == k;
}

# whether a function or a call of the module is under row `k` of the build
fun in_use(m: *Module, b: *Build, k: usize) bool {
    var i: usize = 0;
    for (i < m.functions.len) {
        if (names_row(m, b, m.functions.data[i].data.signature, k)) { ret true; }
        val body: *Body = ?m.functions.data[i].body;
        var j:    usize = 0;
        for (j < body.instructions.len) {
            val d: *ir_instruction.InstructionData = ?body.instructions.data[j];
            if ((d.opcode == opcode_table.CALL || d.opcode == opcode_table.CALL_PLACED) && d.immediates.len > 0) {
                val sig: opcode_row.Immediate = d.immediates.data[0];
                if (sel sig.ty) {
                    if (names_row(m, b, sig.ty, k)) { ret true; }
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret false;
}

fun push_row(out: *vector.Vector[*Registers], r: *Resolved) err[allocator.Error] {
    val regs: *Registers = convention.held(r);
    if (regs == nil) { ret err[allocator.Error].ok{}; }
    val pushed: res[usize, allocator.Error] = vector.push[*Registers](out, regs);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the registers of the rows a call of `callee` may be made under: the one its signature names, and for one reached
# through a register, whose row the code does not say, every row a function or a call of the module is under
fun rows_of(m: *Module, b: *Build, callee: opt[id.Function], out: *vector.Vector[*Registers]) err[allocator.Error] {
    if (sel callee.some) {
        val sig: res[type_table.Function, type_table.Error] = type_table.signature(?m.types, m.functions.data[callee.some].data.signature);
        if (sel sig.ok) {
            val row: opt[*Resolved] = build.under(b, sig.ok.convention);
            if (sel row.some) { ret push_row(out, row.some); }
        }
        ret push_row(out, build.default_row(b));
    }
    var k: usize = 0;
    for (k < b.conventions.size) {
        if (in_use(m, b, k)) {
            val pushed: err[allocator.Error] = push_row(out, ?b.conventions.data[k]);
            if (sel pushed.err) { ret pushed; }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

# the transfer of instruction `ins` decoded from the code, its row's control under the rules its values meet, none when
# they leave it undecided
fun transfer_of(file: *rf.File, ins: *codec.Decoded) opt[effect.Transfer] {
    val e: *effect.Effect = ins.inst.row.effect;
    if (e == nil)                                { ret opt[effect.Transfer].some{effect.NONE}; }
    if (e.control.rules.len == 0 || file == nil) { ret opt[effect.Transfer].some{e.control.transfer}; }
    val got: query.Answer[effect.Control] = query.control(file, ins.inst.row.operands.at, e, mo.Values{at: ins.inst.values, len: ins.inst.count});
    if (sel got.decided) { ret opt[effect.Transfer].some{got.decided.transfer}; }
    ret opt[effect.Transfer].none{};
}

# the offset in `code` of the call site `s` starts at `from`: the first call, or for a tail call the first jump, among
# the instructions of the sequence it is written in, none when no such instruction decodes there
fun call_offset(a: *allocator.Allocator, code: *walk.Code, ctx: *state.Context, s: *Site, from: usize) res[opt[u64], allocator.Error] {
    var store: vector.Vector[mo.Value] = vector.init[mo.Value](a);
    fin { vector.dnit[mo.Value](?store); }
    var alts: vector.Vector[requirement.Alternative] = vector.init[requirement.Alternative](a);
    fin { vector.dnit[requirement.Alternative](?alts); }
    var want: effect.Transfer = effect.CALL;
    if (s.tail) { want = effect.JUMP; }
    var at: usize = from;
    var n:  u32   = 0;
    for (n < s.steps && at < code.len) {
        val got: res[codec.Decoded, field.Refusal] = codec.decode_grown(code.set.codec, ctx, code.data, code.len, at, ?store, ?alts);
        if (sel got.err) {
            if (sel got.err.cause.memory) { ret res[opt[u64], allocator.Error].err{got.err.cause.memory}; }
            ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
        }
        var ins: codec.Decoded        = got.ok;
        val t:   opt[effect.Transfer] = transfer_of(code.set.codec.registers, ?ins);
        if (sel t.some && t.some == want) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{at::u64}}; }
        at = at + ins.len;
        n  = n + 1;
    }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# the offset in `code` of the instruction `step` instructions past the one at `from`, none when one before it does not
# decode or it lies past the code
fun step_offset(a: *allocator.Allocator, code: *walk.Code, ctx: *state.Context, from: usize, step: u32) res[opt[u64], allocator.Error] {
    if (step == 0) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from::u64}}; }
    var store: vector.Vector[mo.Value] = vector.init[mo.Value](a);
    fin { vector.dnit[mo.Value](?store); }
    var alts: vector.Vector[requirement.Alternative] = vector.init[requirement.Alternative](a);
    fin { vector.dnit[requirement.Alternative](?alts); }
    var at: usize = from;
    var n:  u32   = 0;
    for (n < step) {
        if (at >= code.len) { ret res[opt[u64], allocator.Error].ok{opt[u64].none{}}; }
        val got: res[codec.Decoded, field.Refusal] = codec.decode_grown(code.set.codec, ctx, code.data, code.len, at, ?store, ?alts);
        if (sel got.err) {
            if (sel got.err.cause.memory) { ret res[opt[u64], allocator.Error].err{got.err.cause.memory}; }
            ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
        }
        at = at + got.ok.len;
        n  = n + 1;
    }
    if (at >= code.len) { ret res[opt[u64], allocator.Error].ok{opt[u64].none{}}; }
    ret res[opt[u64], allocator.Error].ok{opt[u64].some{at::u64}};
}

# the walk's site of each symbolic operand of `fixups` in function `f`'s range `r` of `code`, into `out`, in the order
# emission wrote them, which is the order of their offsets. an offset where the instruction one fills does not decode,
# or 0 for one outside the range, when one does
fun sited(a: *allocator.Allocator, m: *Module, b: *Build, f: *Framed, r: *CtRange, code: *walk.Code, fixups: Slice[Fixup], out: *vector.Vector[walk.Site]) res[opt[u64], allocator.Error] {
    var timed: state.Context = mct.stated(f.decode);
    var i:     usize         = 0;
    for (i < fixups.size) {
        val x: *Fixup = ?fixups.data[i];
        i = i + 1;
        if (x.function != f.function)                                                               { cnt; }
        if (x.at.section.index != r.section.index || x.at.offset < r.start || x.at.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{0}}; }
        val from: u64                            = x.at.offset - r.start;
        val at:   res[opt[u64], allocator.Error] = step_offset(a, code, ?timed, from::usize, x.step);
        if (sel at.err)     { ret at; }
        if (sel at.ok.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
        var partner: u64               = 0;
        val p:       opt[object.Place] = x.partner;
        if (sel p.some) {
            if (p.some.section.index != r.section.index || p.some.offset < r.start || p.some.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
            partner = p.some.offset - r.start;
        }
        var symbol:   u32            = mo.NO_SYMBOL;
        var constant: bool           = false;
        val named:    opt[id.Symbol] = x.symbol;
        if (sel named.some) {
            symbol   = secret_globals.handle(named.some);
            constant = unwritten(m, named.some);
        }
        val site:   walk.Site                   = walk.Site{at: at.ok.some, operand: x.operand, fixup: x.fixup, symbol: symbol, addend: x.addend, partner: partner, constant: constant};
        val pushed: res[usize, allocator.Error] = vector.push[walk.Site](out, site);
        if (sel pushed.err) { ret res[opt[u64], allocator.Error].err{pushed.err}; }
    }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# whether the program never writes what symbol `s` names: a function's code, or a global its module states constant
fun unwritten(m: *Module, s: id.Symbol) bool {
    if (sel s.function) { ret true; }
    ret m.globals.data[s.global].data.constant;
}

# the access seed of each memory access of `accesses` in function `f`'s range `r` of `code` that states its secrecy, and
# the within seed of each that states a frame extent, the range off the stack pointer's value on entry where framing
# put its slot, into `out`. an offset where the instruction one is made by does not decode or the slot has no fixed
# place there, or 0 for one outside the range, when one does
fun stated_seeds(a: *allocator.Allocator, f: *Framed, r: *CtRange, code: *walk.Code, accesses: Slice[Stated], out: *vector.Vector[walk.Seed]) res[opt[u64], allocator.Error] {
    var timed: state.Context = mct.stated(f.decode);
    var i:     usize         = 0;
    for (i < accesses.size) {
        val x: *Stated = ?accesses.data[i];
        i = i + 1;
        if (x.function != f.function)                                                               { cnt; }
        if (x.at.section.index != r.section.index || x.at.offset < r.start || x.at.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{0}}; }
        val from: u64                            = x.at.offset - r.start;
        val at:   res[opt[u64], allocator.Error] = step_offset(a, code, ?timed, from::usize, x.step);
        if (sel at.err)     { ret at; }
        if (sel at.ok.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
        if (x.secrecy) {
            val seed:   walk.Seed                   = walk.Seed.access{walk.Access{at: at.ok.some, access: x.access, secret: x.secret}};
            val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, seed);
            if (sel pushed.err) { ret res[opt[u64], allocator.Error].err{pushed.err}; }
        }
        if (x.extent.length != 0) {
            val placed: opt[walk.Within] = within(f, at.ok.some, x.access, x.extent);
            if (sel placed.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
            val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.within{placed.some});
            if (sel pushed.err) { ret res[opt[u64], allocator.Error].err{pushed.err}; }
        }
    }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# the within seed of access `access` of the instruction at `at` of framed function `f` stating frame extent `e`: its range
# off the stack pointer's value on entry, none where the set has no stack pointer or a typed stream, or the slot no
# fixed place there
fun within(f: *Framed, at: u64, access: walk.Accessor, e: Extent) opt[walk.Within] {
    val l: *frame.Layout = f.layout;
    if (l.stack == rf.NONE || f.code.set.codec.stream != nil) { ret opt[walk.Within].none{}; }
    val cfa: opt[i64] = from_cfa(f.code, l, e.slot::usize);
    if (sel cfa.none) { ret opt[walk.Within].none{}; }
    ret opt[walk.Within].some{walk.Within{at: at, access: access, offset: l.entry::i64 + cfa.some + e.offset::i64, length: e.length}};
}

# the seed of each instruction of `marked` in function `f`'s range `r` of `code`, into `out`: a pointer seed of an inline
# block's instruction loading a pointer whose pointee its type states, an inline seed of each instruction of an inline
# block, and a switch seed of the function's own timing switch. an offset where the instruction one is made by does not decode, or 0 for one outside the range, when one does
fun marked_seeds(a: *allocator.Allocator, f: *Framed, r: *CtRange, code: *walk.Code, marked: Slice[Marked], out: *vector.Vector[walk.Seed]) res[opt[u64], allocator.Error] {
    var timed: state.Context = mct.stated(f.decode);
    var i:     usize         = 0;
    for (i < marked.size) {
        val x: *Marked = ?marked.data[i];
        i = i + 1;
        if (x.function != f.function)                                                               { cnt; }
        if (x.at.section.index != r.section.index || x.at.offset < r.start || x.at.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{0}}; }
        val from: u64                            = x.at.offset - r.start;
        val at:   res[opt[u64], allocator.Error] = step_offset(a, code, ?timed, from::usize, x.step);
        if (sel at.err)     { ret at; }
        if (sel at.ok.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
        var seed: walk.Seed = walk.Seed.switch{at.ok.some};
        if (sel x.fact.pointer) { seed = walk.Seed.pointer{walk.Pointer{at: at.ok.some, secret: x.fact.pointer}}; }
        if (sel x.fact.inline)  { seed = walk.Seed.inline{at.ok.some}; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, seed);
        if (sel pushed.err) { ret res[opt[u64], allocator.Error].err{pushed.err}; }
    }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# the written seed of each register of `results` in function `f`'s range `r` of `code`, into `out`, at the instruction
# that writes it. an offset where that instruction does not decode, or 0 for one outside the range, when one does
fun result_seeds(a: *allocator.Allocator, f: *Framed, r: *CtRange, code: *walk.Code, results: Slice[Result], out: *vector.Vector[walk.Seed]) res[opt[u64], allocator.Error] {
    var timed: state.Context = mct.stated(f.decode);
    var i:     usize         = 0;
    for (i < results.size) {
        val x: *Result = ?results.data[i];
        i = i + 1;
        if (x.function != f.function)                                                               { cnt; }
        if (x.at.section.index != r.section.index || x.at.offset < r.start || x.at.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{0}}; }
        val from: u64                            = x.at.offset - r.start;
        val at:   res[opt[u64], allocator.Error] = step_offset(a, code, ?timed, from::usize, x.step);
        if (sel at.err)     { ret at; }
        if (sel at.ok.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
        val seed:   walk.Seed                   = walk.Seed.after{walk.Written{at: at.ok.some, place: walk.Place.register{x.register}}};
        val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, seed);
        if (sel pushed.err) { ret res[opt[u64], allocator.Error].err{pushed.err}; }
    }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# the extents of run `r` of `x.extents` added again, the first `n` of them, and the run they make
fun again(x: *Models, r: Run, n: u32) err[allocator.Error] {
    var i: u32 = 0;
    for (i < n && i < r.len) {
        val made: err[allocator.Error] = extent(x, x.extents.data[(r.first + i)::usize]);
        if (sel made.err) { ret made; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the extent in the caller's frame of an argument a call passes on the stack at `at`, `length` bytes of the outgoing
# area the frame `l` places, none where the walk places no such area or the place scales
fun outgoing_extent(l: *frame.Layout, at: Place, length: u64) opt[walk.Extent] {
    if (l.size.per != 0 || l.realign != 0) { ret opt[walk.Extent].none{}; }
    if (!(sel at.stack))                   { ret opt[walk.Extent].none{}; }
    if (!(sel at.stack.scale.fixed))       { ret opt[walk.Extent].none{}; }
    val got: opt[Based] = based(l);
    if (sel got.none) { ret opt[walk.Extent].none{}; }
    ret opt[walk.Extent].some{walk.Extent{base: got.some.base, offset: -l.size.fixed - got.some.at + at.stack.offset::i64, length: length}};
}

# the reads of a trusted call of `callee` from function `f` and those it accepts, into `x`: every addressed local of the
# caller's frame, the first `locals` of `touched`, a copy passed by reference among them, accepted, as the callee takes
# what it reads there as its accesses state, each piece an argument passes on the stack, accepted where its declaration
# is secret, and the secret globals' ranges, accepted. false where an argument travels on the stack where the model
# cannot name it, which leaves the call untrusted
fun trusted_reads(x: *Models, m: *Module, b: *Build, l: *Layout, f: *Framed, callee: id.Function, args: Run, touched: Run, locals: u32, reads: *Run, taken: *Run, accepted: *Run) res[bool, allocator.Error] {
    var arrived: vector.Vector[contract.Arrival] = vector.init[contract.Arrival](x.models.a);
    fin { vector.dnit[contract.Arrival](?arrived); }
    val classified: res[bool, allocator.Error] = contract.arrivals(x.models.a, m, b, l, callee, ?arrived);
    if (sel classified.err) { ret classified; }
    if (!classified.ok)     { ret classified; }
    var placed: vector.Vector[walk.Extent] = vector.init[walk.Extent](x.models.a);
    fin { vector.dnit[walk.Extent](?placed); }
    var secret: vector.Vector[bool] = vector.init[bool](x.models.a);
    fin { vector.dnit[bool](?secret); }
    var j: usize = 0;
    for (j < arrived.len) {
        val one: contract.Arrival = arrived.data[j];
        val at:  Place            = one.place;
        j = j + 1;
        if (sel at.stack) {
            val e: opt[walk.Extent] = outgoing_extent(f.layout, at, one.length);
            if (sel e.none) { ret res[bool, allocator.Error].ok{false}; }
            val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](?placed, e.some);
            if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        }
        or { cnt; }
        val kept: res[usize, allocator.Error] = vector.push[bool](?secret, one.secret);
        if (sel kept.err) { ret res[bool, allocator.Error].err{kept.err}; }
    }
    val file:  *rf.File = b.basis.set.codec.registers;
    val first: u32      = x.ids.len::u32;
    j = 0;
    for (j < arrived.len) {
        val one: contract.Arrival = arrived.data[j];
        val at:  Place            = one.place;
        if (sel at.register) {
            if (one.secret && holds(x, file, args, at.register)) {
                val added: err[allocator.Error] = add(x, file, first, at.register, NO_RUN);
                if (sel added.err) { ret res[bool, allocator.Error].err{added.err}; }
            }
        }
        j = j + 1;
    }
    @accepted = ended(x, first);
    val start: u32                  = x.extents.len::u32;
    val local: err[allocator.Error] = again(x, touched, locals);
    if (sel local.err) { ret res[bool, allocator.Error].err{local.err}; }
    j = 0;
    for (j < placed.len) {
        val made: err[allocator.Error] = extent(x, placed.data[j]);
        if (sel made.err) { ret res[bool, allocator.Error].err{made.err}; }
        j = j + 1;
    }
    val globals_at: u32                  = x.extents.len::u32;
    val globals:    err[allocator.Error] = secret_globals.extents(m, l, ?x.extents);
    if (sel globals.err) { ret res[bool, allocator.Error].err{globals.err}; }
    val count: u32 = x.extents.len::u32 - globals_at;
    @reads = Run{first: start, len: x.extents.len::u32 - start};
    val accepting:    u32                  = x.extents.len::u32;
    val accept_local: err[allocator.Error] = again(x, touched, locals);
    if (sel accept_local.err) { ret res[bool, allocator.Error].err{accept_local.err}; }
    j = 0;
    for (j < placed.len) {
        if (secret.data[j]) {
            val made: err[allocator.Error] = extent(x, placed.data[j]);
            if (sel made.err) { ret res[bool, allocator.Error].err{made.err}; }
        }
        j = j + 1;
    }
    val accept_globals: err[allocator.Error] = again(x, Run{first: globals_at, len: count}, count);
    if (sel accept_globals.err) { ret res[bool, allocator.Error].err{accept_globals.err}; }
    @taken = Run{first: accepting, len: x.extents.len::u32 - accepting};
    ret res[bool, allocator.Error].ok{true};
}

# the page probe the prologue of function `f` calls, where `callee` is the routine its convention names for it
fun probe_of(m: *Module, b: *Build, f: id.Function, callee: opt[id.Function]) opt[convention.Page] {
    if (sel callee.none) { ret opt[convention.Page].none{}; }
    var row: *Resolved                                  = build.default_row(b);
    val sig: res[type_table.Function, type_table.Error] = type_table.signature(?m.types, m.functions.data[f].data.signature);
    if (sel sig.ok) {
        val under: opt[*Resolved] = build.under(b, sig.ok.convention);
        if (sel under.some) { row = under.some; }
    }
    val st: convention.Stack = row.row.stack;
    if (!(sel st.memory)) { ret opt[convention.Page].none{}; }
    val probe: convention.Probe = st.memory.prologue.probe;
    if (!(sel probe.page)) { ret opt[convention.Page].none{}; }
    val helper: opt[str] = probe.page.helper;
    if (sel helper.none) { ret opt[convention.Page].none{}; }
    val name: View = module.name_of(m, m.functions.data[callee.some].data.name);
    if (!slice.same_view(name, View{data: helper.some, len: str_len(helper.some)})) { ret opt[convention.Page].none{}; }
    ret opt[convention.Page].some{probe.page};
}

# the model of the call of the page probe `page` at call site `s` of function `f`, added to `x`: the routine the frame
# code calls, mirl's own (`mirl.legal.helper.table`), which takes the bytes in a register, branches on nothing else,
# reads each page past the stack pointer with an address formed from the two alone, writes no memory and changes only
# the registers its convention row states. so it is trusted to take a secret in no register, to read any memory, and to
# keep every register but those, the stack pointer and the bytes register as the call found them
fun probe_model(x: *Models, m: *Module, b: *Build, file: *rf.File, f: *Framed, s: *Site, at: u64, page: convention.Page) err[allocator.Error] {
    var rows: vector.Vector[*Registers] = vector.init[*Registers](x.models.a);
    fin { vector.dnit[*Registers](?rows); }
    val listed_rows: err[allocator.Error] = rows_of(m, b, opt[id.Function].some{f.function}, ?rows);
    if (sel listed_rows.err) { ret listed_rows; }
    if (rows.len == 0)       { ret err[allocator.Error].ok{}; }
    val regs:  *Registers           = rows.data[0];
    val d:     *InstructionData     = mf.data(f.code, s.instruction);
    val first: u32                  = x.ids.len::u32;
    val wrote: err[allocator.Error] = add_all(x, file, first, page.changes, NO_RUN);
    if (sel wrote.err) { ret wrote; }
    val linked: err[allocator.Error] = add_some(x, file, first, regs.link, NO_RUN);
    if (sel linked.err) { ret linked; }
    val implied: err[allocator.Error] = add_implied(x, file, first, d, true, NO_RUN);
    if (sel implied.err) { ret implied; }
    val written: Run             = ended(x, first);
    val kept_at: u32             = x.ids.len::u32;
    val lists:   [5]Slice[rf.Id] = [5]Slice[rf.Id]{regs.preserved, regs.clobbered, regs.returning.registers, regs.passing.registers, regs.reserved};
    var k:       usize           = 0;
    for (k < 5) {
        val added: err[allocator.Error] = add_all(x, file, kept_at, lists[k], written);
        if (sel added.err) { ret added; }
        k = k + 1;
    }
    val sp: err[allocator.Error] = add(x, file, kept_at, f.layout.stack, written);
    if (sel sp.err) { ret sp; }
    val fp: err[allocator.Error] = add(x, file, kept_at, f.layout.pointer, written);
    if (sel fp.err) { ret fp; }
    val kept:    Run                  = ended(x, kept_at);
    val args_at: u32                  = x.ids.len::u32;
    val took:    err[allocator.Error] = add(x, file, args_at, page.takes, NO_RUN);
    if (sel took.err) { ret took; }
    val one:    Model                       = Model{at: at, stated: true, callee: s.callee, popped: mo.NO_POSITIONS, preserved: kept, arguments: ended(x, args_at), accepted: NO_RUN, written: written, results: NO_RUN, memory: NO_RUN, reads: NO_RUN, taken: NO_RUN, writes: NO_RUN, kept: NO_RUN, pointed: NO_RUN, keeps: true, owned: NO_RUN};
    val pushed: res[usize, allocator.Error] = vector.push[Model](?x.models, one);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the model of call site `s` of function `f` at offset `at` of its code, added to `x`. a call that trusts its callee's
# declaration (`contract.trusted`) accepts a secret where the declaration says one arrives and in every read it names,
# and states its callee's reads, so a secret anywhere else the callee may reach joins it. any other call accepts no
# secret: it reads the frame locals a pointer argument may reach, the outgoing argument area and the ranges of every
# secret global, and a secret in any of those, in an argument register or anywhere it does not keep refuses it
fun model(x: *Models, m: *Module, b: *Build, l: *Layout, f: *Framed, s: *Site, at: u64) err[allocator.Error] {
    val file:  *rf.File             = b.basis.set.codec.registers;
    val probe: opt[convention.Page] = probe_of(m, b, f.function, s.callee);
    if (sel probe.some) {
        if (file != nil) { ret probe_model(x, m, b, file, f, s, at, probe.some); }
    }
    var rows: vector.Vector[*Registers] = vector.init[*Registers](x.models.a);
    fin { vector.dnit[*Registers](?rows); }
    val listed_rows: err[allocator.Error] = rows_of(m, b, s.callee, ?rows);
    if (sel listed_rows.err)          { ret listed_rows; }
    if (rows.len == 0 || file == nil) { ret err[allocator.Error].ok{}; }
    val under: Slice[*Registers]         = Slice[*Registers]{data: rows.data, size: rows.len};
    val d:     *InstructionData          = mf.data(f.code, s.instruction);
    val kept:  res[Run, allocator.Error] = preserved(x, file, under, f.layout);
    if (sel kept.err) { ret err[allocator.Error].err{kept.err}; }
    val args: res[Run, allocator.Error] = arguments(x, file, d);
    if (sel args.err) { ret err[allocator.Error].err{args.err}; }
    val wrote: res[Run, allocator.Error] = written(x, file, under, d, kept.ok);
    if (sel wrote.err) { ret err[allocator.Error].err{wrote.err}; }
    var frame_kept: Run                  = NO_RUN;
    var touched:    Run                  = NO_RUN;
    var locals:     u32                  = 0;
    var outgoing:   bool                 = false;
    val framed_at:  err[allocator.Error] = frame_of(x, f, ?frame_kept, ?touched, ?locals, ?outgoing);
    if (sel framed_at.err) { ret framed_at; }
    var reads:    Run  = NO_RUN;
    var taken:    Run  = NO_RUN;
    var accepted: Run  = NO_RUN;
    var results:  Run  = NO_RUN;
    var memory:   Run  = NO_RUN;
    var pointed:  Run  = NO_RUN;
    var stated:   bool = false;
    if (sel s.callee.some) {
        if (contract.trusted(m, b.basis.set, ?b.basis.context, f.function, s.callee.some)) {
            val named: res[bool, allocator.Error] = trusted_reads(x, m, b, l, f, s.callee.some, args.ok, touched, locals, ?reads, ?taken, ?accepted);
            if (sel named.err) { ret err[allocator.Error].err{named.err}; }
            stated = named.ok;
        }
        # a declared callee's result pieces, which an untrusted call's walk gives the join and a trusted one's what the
        # declaration states. a result no walk can place takes the join
        val first: u32                        = x.results.len::u32;
        val left:  res[bool, allocator.Error] = result_pieces(x.models.a, m, b, l, s.callee.some, ?x.results);
        if (sel left.err) { ret err[allocator.Error].err{left.err}; }
        if (left.ok)      { results = Run{first: first, len: x.results.len::u32 - first}; }
        or                { vector.truncate[walk.Result](?x.results, first::usize); }
        if (stated && left.ok) {
            val start:  u32                  = x.extents.len::u32;
            val placed: err[allocator.Error] = memory_extents(x.models.a, m, b, l, s.callee.some, ?x.extents);
            if (sel placed.err) { ret placed; }
            memory = Run{first: start, len: x.extents.len::u32 - start};
        }
        if (stated) {
            val passed: res[Run, allocator.Error] = pointed_of(x, m, b, l, file, s.callee.some);
            if (sel passed.err) { ret err[allocator.Error].err{passed.err}; }
            pointed = passed.ok;
        }
    }
    var passed: vector.Vector[walk.Extent] = vector.init[walk.Extent](x.models.a);
    fin { vector.dnit[walk.Extent](?passed); }
    var owned:  Run  = NO_RUN;
    var placed: bool = false;
    if (outgoing && f.layout.outgoing > 0) {
        if (sel s.callee.some) {
            val res_owned: res[bool, allocator.Error] = owned_of(x, m, b, l, f, s.callee.some, ?passed, ?owned);
            if (sel res_owned.err) { ret err[allocator.Error].err{res_owned.err}; }
            placed = res_owned.ok;
        }
        or {
            val res_owned: res[bool, allocator.Error] = owned_below(x, f, d, ?passed, ?owned);
            if (sel res_owned.err) { ret err[allocator.Error].err{res_owned.err}; }
            placed = res_owned.ok;
        }
    }
    if (!stated) {
        val start: u32 = x.extents.len::u32;
        if (placed) {
            val again_l: err[allocator.Error] = again(x, touched, locals);
            if (sel again_l.err) { ret again_l; }
            var j: usize = 0;
            for (j < passed.len) {
                val made: err[allocator.Error] = extent(x, passed.data[j]);
                if (sel made.err) { ret made; }
                j = j + 1;
            }
        }
        or {
            val again_t: err[allocator.Error] = again(x, touched, touched.len);
            if (sel again_t.err) { ret again_t; }
        }
        val globals: err[allocator.Error] = secret_globals.extents(m, l, ?x.extents);
        if (sel globals.err) { ret globals; }
        reads    = Run{first: start, len: x.extents.len::u32 - start};
        taken    = NO_RUN;
        accepted = NO_RUN;
    }
    val one:    Model                       = Model{at: at, stated: stated, callee: s.callee, popped: mo.NO_POSITIONS, preserved: kept.ok, arguments: args.ok, accepted: accepted, written: wrote.ok, results: results, memory: memory, reads: reads, taken: taken, writes: touched, kept: frame_kept, pointed: pointed, keeps: false, owned: owned};
    val pushed: res[usize, allocator.Error] = vector.push[Model](?x.models, one);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the bytes of the outgoing argument area of function `f` that no argument a call of `callee` passes on the stack fills,
# which the callee takes as its own frame, into `x` as `owned`, and the extents of those arguments into `passed`. false
# where an argument's place is not one the walk can name, which leaves the whole area read and none owned
fun owned_of(x: *Models, m: *Module, b: *Build, l: *Layout, f: *Framed, callee: id.Function, passed: *vector.Vector[walk.Extent], owned: *Run) res[bool, allocator.Error] {
    val fl:  *frame.Layout = f.layout;
    val got: opt[Based]    = based(fl);
    if (sel got.none) { ret res[bool, allocator.Error].ok{false}; }
    var arrived: vector.Vector[contract.Arrival] = vector.init[contract.Arrival](x.models.a);
    fin { vector.dnit[contract.Arrival](?arrived); }
    val classified: res[bool, allocator.Error] = contract.arrivals(x.models.a, m, b, l, callee, ?arrived);
    if (sel classified.err) { ret classified; }
    if (!classified.ok)     { ret classified; }
    var j: usize = 0;
    for (j < arrived.len) {
        val one: contract.Arrival = arrived.data[j];
        j = j + 1;
        if (!(sel one.place.stack)) { cnt; }
        val e: opt[walk.Extent] = outgoing_extent(fl, one.place, one.length);
        if (sel e.none) { ret res[bool, allocator.Error].ok{false}; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](passed, e.some);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    val area:  i64 = -fl.size.fixed - got.some.at;
    val end:   i64 = area + fl.outgoing::i64;
    val first: u32 = x.extents.len::u32;
    var from:  i64 = area;
    for (from < end) {
        var next: i64   = end;
        var past: i64   = from;
        var k:    usize = 0;
        for (k < passed.len) {
            val e:     walk.Extent = passed.data[k];
            val e_end: i64         = e.offset + e.length::i64;
            if (e_end > from && e.offset < next) {
                next = e.offset;
                past = e_end;
            }
            k = k + 1;
        }
        if (next > from) {
            val made: err[allocator.Error] = extent(x, walk.Extent{base: got.some.base, offset: from, length: (next - from)::u64});
            if (sel made.err) { ret res[bool, allocator.Error].err{made.err}; }
        }
        if (next == end) { brk; }
        if (past > from) { from = past; }
    }
    @owned = Run{first: first, len: x.extents.len::u32 - first};
    ret res[bool, allocator.Error].ok{true};
}

# `owned_of` for a call `d` of no declared callee, from the places the call states: the bytes of the outgoing argument
# area below its lowest stack place, as the shadow space a convention reserves, which the callee takes as its own
# frame, into `x` as `owned`, and every byte from there up into `passed`, its arguments among them. false where a stack
# place is not at a fixed offset
fun owned_below(x: *Models, f: *Framed, d: *InstructionData, passed: *vector.Vector[walk.Extent], owned: *Run) res[bool, allocator.Error] {
    val fl:  *frame.Layout = f.layout;
    val got: opt[Based]    = based(fl);
    if (sel got.none) { ret res[bool, allocator.Error].ok{false}; }
    val area:   i64   = -fl.size.fixed - got.some.at;
    val end:    i64   = area + fl.outgoing::i64;
    var lowest: i64   = end;
    var i:      usize = 0;
    for (i < d.places.size) {
        val p: Place = d.places.data[i].place;
        i = i + 1;
        if (!(sel p.stack)) { cnt; }
        val e: opt[walk.Extent] = outgoing_extent(fl, p, 1);
        if (sel e.none)             { ret res[bool, allocator.Error].ok{false}; }
        if (e.some.offset < lowest) { lowest = e.some.offset; }
    }
    if (lowest < area) { ret res[bool, allocator.Error].ok{false}; }
    if (lowest < end) {
        val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](passed, walk.Extent{base: got.some.base, offset: lowest, length: (end - lowest)::u64});
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    val first: u32 = x.extents.len::u32;
    if (lowest > area) {
        val made: err[allocator.Error] = extent(x, walk.Extent{base: got.some.base, offset: area, length: (lowest - area)::u64});
        if (sel made.err) { ret res[bool, allocator.Error].err{made.err}; }
    }
    @owned = Run{first: first, len: x.extents.len::u32 - first};
    ret res[bool, allocator.Error].ok{true};
}

# the extents of `e`, each added to `x.extents`, and the run they make
fun extents_added(x: *Models, e: Slice[walk.Extent]) res[Run, allocator.Error] {
    val first: u32   = x.extents.len::u32;
    var i:     usize = 0;
    for (i < e.size) {
        val made: err[allocator.Error] = extent(x, e.data[i]);
        if (sel made.err) { ret res[Run, allocator.Error].err{made.err}; }
        i = i + 1;
    }
    ret res[Run, allocator.Error].ok{Run{first: first, len: x.extents.len::u32 - first}};
}

# the values a trusted call of `callee` of a typed stream pops it accepts a secret in, each by its depth, the last
# operand's 0, its declaration's secret pieces', a depth past the last bit, which stands for every value past it, named
# only where each of those is secret. none where an argument travels other than as an operand, which a stream's model
# cannot name, leaving the call untrusted
fun popped_of(a: *allocator.Allocator, m: *Module, b: *Build, l: *Layout, callee: id.Function) res[opt[mo.Positions], allocator.Error] {
    var arrived: vector.Vector[contract.Arrival] = vector.init[contract.Arrival](a);
    fin { vector.dnit[contract.Arrival](?arrived); }
    val classified: res[bool, allocator.Error] = contract.arrivals(a, m, b, l, callee, ?arrived);
    if (sel classified.err) { ret res[opt[mo.Positions], allocator.Error].err{classified.err}; }
    if (!classified.ok)     { ret res[opt[mo.Positions], allocator.Error].ok{opt[mo.Positions].none{}}; }
    var named: mo.Positions = mo.NO_POSITIONS;
    var past:  bool         = true;
    var j:     usize        = 0;
    for (j < arrived.len) {
        val one: contract.Arrival = arrived.data[j];
        val at:  Place            = one.place;
        if (!(sel at.operand))                { ret res[opt[mo.Positions], allocator.Error].ok{opt[mo.Positions].none{}}; }
        if (at.operand::usize >= arrived.len) { ret res[opt[mo.Positions], allocator.Error].ok{opt[mo.Positions].none{}}; }
        val depth: usize = arrived.len - 1 - at.operand::usize;
        if (depth >= 31) { past = past && one.secret; }
        or (one.secret)  { named = named | (1::u32 << depth::u32); }
        j = j + 1;
    }
    if (arrived.len > 31 && past) { named = named | (1::u32 << 31); }
    ret res[opt[mo.Positions], allocator.Error].ok{opt[mo.Positions].some{named}};
}

# the model of a call of a typed stream at offset `at` of its code by function `caller`, added to `x`. a stream's call
# passes every value it pops, so a model names none but those it accepts. what it decides is what `model` does of
# machine code, from the extents off a local the code holds its frame by
# ---
# x:       the models
# m:       the module
# b:       the build
# l:       the module's layout
# caller:  the function making the call
# at:      the offset of the call
# callee:  the function the call names, none for one it reaches through a table
# kept:    the caller's frame, which the callee keeps
# touched: the frame locals whose address the code lets out, which a pointer argument may reach
pub fun stream_model(x: *Models, m: *Module, b: *Build, l: *Layout, caller: id.Function, at: u64, callee: opt[id.Function], kept: Slice[walk.Extent], touched: Slice[walk.Extent]) err[allocator.Error] {
    val frame_kept: res[Run, allocator.Error] = extents_added(x, kept);
    if (sel frame_kept.err) { ret err[allocator.Error].err{frame_kept.err}; }
    val written: res[Run, allocator.Error] = extents_added(x, touched);
    if (sel written.err) { ret err[allocator.Error].err{written.err}; }
    val globals: err[allocator.Error] = secret_globals.extents(m, l, ?x.extents);
    if (sel globals.err) { ret globals; }
    val reads:  Run          = Run{first: written.ok.first, len: x.extents.len::u32 - written.ok.first};
    var taken:  Run          = NO_RUN;
    var popped: mo.Positions = mo.NO_POSITIONS;
    var stated: bool         = false;
    if (sel callee.some) {
        if (contract.trusted(m, b.basis.set, ?b.basis.context, caller, callee.some)) {
            val got: res[opt[mo.Positions], allocator.Error] = popped_of(x.models.a, m, b, l, callee.some);
            if (sel got.err) { ret err[allocator.Error].err{got.err}; }
            if (sel got.ok.some) {
                popped = got.ok.some;
                stated = true;
                val again_r: err[allocator.Error] = again(x, reads, reads.len);
                if (sel again_r.err) { ret again_r; }
                taken = Run{first: reads.first + reads.len, len: reads.len};
            }
        }
    }
    val one:    Model                       = Model{at: at, stated: stated, callee: callee, popped: popped, preserved: NO_RUN, arguments: NO_RUN, accepted: NO_RUN, written: NO_RUN, results: NO_RUN, memory: NO_RUN, reads: reads, taken: taken, writes: written.ok, kept: frame_kept.ok, pointed: NO_RUN, keeps: false, owned: NO_RUN};
    val pushed: res[usize, allocator.Error] = vector.push[Model](?x.models, one);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

fun registers_of(x: *Models, r: Run) walk.Registers {
    if (r.len == 0) { ret walk.NO_REGISTERS; }
    ret walk.Registers{at: ?x.ids.data[r.first::usize], len: r.len};
}

fun results_of(x: *Models, r: Run, memory: Run) walk.Results {
    if (r.len == 0 && memory.len == 0) { ret walk.NO_RESULTS; }
    var out: walk.Results = walk.Results{at: nil, len: 0, memory: extents_of(x, memory)};
    if (r.len != 0) {
        out.at  = ?x.results.data[r.first::usize];
        out.len = r.len;
    }
    ret out;
}

# the bytes of function `f`'s result returned by reference its declaration states public (`contract.public_memory`),
# each an extent off the register its address arrives in, added to `out`. none where the address arrives elsewhere
fun memory_extents(a: *allocator.Allocator, m: *Module, b: *Build, l: *Layout, f: id.Function, out: *vector.Vector[walk.Extent]) err[allocator.Error] {
    var ranges: vector.Vector[Range] = vector.init[Range](a);
    fin { vector.dnit[Range](?ranges); }
    val carried: res[opt[Place], allocator.Error] = contract.public_memory(a, m, b, l, f, ?ranges);
    if (sel carried.err)     { ret err[allocator.Error].err{carried.err}; }
    if (sel carried.ok.none) { ret err[allocator.Error].ok{}; }
    val at: Place = carried.ok.some;
    if (!(sel at.register)) { ret err[allocator.Error].ok{}; }
    var i: usize = 0;
    for (i < ranges.len) {
        val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](out, walk.Extent{base: at.register, offset: ranges.data[i].offset::i64, length: ranges.data[i].length});
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the result pieces of function `f` its declaration states left in registers (`contract.results`), into `out`. false
# where its signature does not classify, or a piece is left where no register holds it, which no walk can hold
fun result_pieces(a: *allocator.Allocator, m: *Module, b: *Build, l: *Layout, f: id.Function, out: *vector.Vector[walk.Result]) res[bool, allocator.Error] {
    var left: vector.Vector[contract.Arrival] = vector.init[contract.Arrival](a);
    fin { vector.dnit[contract.Arrival](?left); }
    val classified: res[bool, allocator.Error] = contract.results(a, m, b, l, f, ?left);
    if (sel classified.err) { ret classified; }
    if (!classified.ok)     { ret classified; }
    var j: usize = 0;
    for (j < left.len) {
        val at: Place = left.data[j].place;
        if (!(sel at.register)) { ret res[bool, allocator.Error].ok{false}; }
        val pushed: res[usize, allocator.Error] = vector.push[walk.Result](out, walk.Result{register: at.register, secret: left.data[j].secret});
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        j = j + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# the registers a call of `callee` passes its public pointers in (`contract.pointers`), added to `x`. a pointer passed
# on the stack the walk cannot follow, so it names none
fun pointed_of(x: *Models, m: *Module, b: *Build, l: *Layout, file: *rf.File, callee: id.Function) res[Run, allocator.Error] {
    var places: vector.Vector[Place] = vector.init[Place](x.models.a);
    fin { vector.dnit[Place](?places); }
    val classified: res[bool, allocator.Error] = contract.pointers(x.models.a, m, b, l, callee, ?places);
    if (sel classified.err) { ret res[Run, allocator.Error].err{classified.err}; }
    val first: u32   = x.ids.len::u32;
    var j:     usize = 0;
    for (j < places.len) {
        val at: Place = places.data[j];
        if (sel at.register) {
            val added: err[allocator.Error] = add(x, file, first, at.register, NO_RUN);
            if (sel added.err) { ret res[Run, allocator.Error].err{added.err}; }
        }
        j = j + 1;
    }
    ret res[Run, allocator.Error].ok{ended(x, first)};
}

fun extents_of(x: *Models, r: Run) walk.Extents {
    if (r.len == 0) { ret walk.NO_EXTENTS; }
    ret walk.Extents{at: ?x.extents.data[r.first::usize], len: r.len};
}

# the walk's model of each model of `x`, once the storage they name moves no more
pub fun complete(x: *Models) err[allocator.Error] {
    var i: usize = 0;
    for (i < x.models.len) {
        val o:      *Model                      = ?x.models.data[i];
        val c:      walk.Call                   = walk.Call{at: o.at, accepted: registers_of(x, o.accepted), accepted_reads: extents_of(x, o.taken), accepted_popped: o.popped, preserved: registers_of(x, o.preserved), arguments: registers_of(x, o.arguments), reads: extents_of(x, o.reads), stated: o.stated, written: registers_of(x, o.written), results: results_of(x, o.results, o.memory), writes: extents_of(x, o.writes), kept: extents_of(x, o.kept), pointed: registers_of(x, o.pointed), keeps: o.keeps, owned: extents_of(x, o.owned)};
        val pushed: res[usize, allocator.Error] = vector.push[walk.Call](?x.calls, c);
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the models of the call sites of `sites` in function `f`'s range `r` of `code`, into `x`. an offset where no call of
# a site decodes, the first one, when one does not
fun modeled(a: *allocator.Allocator, m: *Module, b: *Build, l: *Layout, f: *Framed, r: *CtRange, code: *walk.Code, sites: Slice[Site], x: *Models) res[opt[u64], allocator.Error] {
    var timed: state.Context = mct.stated(f.decode);
    var i:     usize         = 0;
    for (i < sites.size) {
        val s: *Site = ?sites.data[i];
        if (s.function == f.function) {
            if (s.at.section.index != r.section.index || s.at.offset < r.start || s.at.offset >= r.end) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{0}}; }
            val from: u64                            = s.at.offset - r.start;
            val got:  res[opt[u64], allocator.Error] = call_offset(a, code, ?timed, s, from::usize);
            if (sel got.err)     { ret got; }
            if (sel got.ok.none) { ret res[opt[u64], allocator.Error].ok{opt[u64].some{from}}; }
            val made: err[allocator.Error] = model(x, m, b, l, f, s, got.ok.some);
            if (sel made.err) { ret res[opt[u64], allocator.Error].err{made.err}; }
        }
        i = i + 1;
    }
    val done: err[allocator.Error] = complete(x);
    if (sel done.err) { ret res[opt[u64], allocator.Error].err{done.err}; }
    ret res[opt[u64], allocator.Error].ok{opt[u64].none{}};
}

# the callee of the model at offset `at`, none for none or a call through a register
pub fun callee_at(x: *Models, at: u64) opt[id.Function] {
    var i: usize = 0;
    for (i < x.models.len) {
        if (x.models.data[i].at == at) { ret x.models.data[i].callee; }
        i = i + 1;
    }
    ret opt[id.Function].none{};
}

# the source location of the instruction at offset `at` of function `f`'s range `r`: that of the last line fact
# stated in the range at or before it, none when none is
fun source_at(f: id.Function, r: *CtRange, lines: Slice[Line], at: u64) opt[debug_record.Location] {
    var found: opt[debug_record.Location] = opt[debug_record.Location].none{};
    var best:  u64                        = 0;
    var seen:  bool                       = false;
    var i:     usize                      = 0;
    for (i < lines.size) {
        val l: *Line = ?lines.data[i];
        if (l.function == f && l.at.section.index == r.section.index && l.at.offset >= r.start && l.at.offset <= r.start + at) {
            if (!seen || l.at.offset >= best) {
                found = l.location;
                best  = l.at.offset;
                seen  = true;
            }
        }
        i = i + 1;
    }
    ret found;
}

fun unfollowed(f: id.Function, message: str, at: u64, l: opt[debug_record.Location]) res[opt[mct.Error], allocator.Error] {
    val unread: walk.Unread = walk.Unread{message: message, offset: at};
    ret res[opt[mct.Error], allocator.Error].ok{opt[mct.Error].some{mct.Error.unfollowed{mct.Unfollowed{function: f, unread: unread, location: l}}}};
}

# the walk of one range's bytes for function `f`, public again at its points of `points`, each call walked through
# the model of its site of `sites`, a refusal at an offset placed at its source location through `lines`. a function
# whose own frame reads a slot no store reaches first is refused before it is walked
fun walked(a: *allocator.Allocator, m: *Module, b: *Build, l: *Layout, o: *object.Object, r: *CtRange, f: *Framed, gated: requirement.Ids, points: Slice[Point], sites: Slice[Site], lines: Slice[Line], fixups: Slice[Fixup], accesses: Slice[Stated], results: Slice[Result], marked: Slice[Marked]) res[opt[mct.Error], allocator.Error] {
    val own: res[opt[mct.Error], allocator.Error] = mct.fresh(a, m, l, f.function);
    if (sel own.err)     { ret own; }
    if (sel own.ok.some) { ret own; }
    val none: opt[debug_record.Location] = opt[debug_record.Location].none{};
    var list: vector.Vector[walk.Seed]   = vector.init[walk.Seed](a);
    fin { vector.dnit[walk.Seed](?list); }
    var lifted: vector.Vector[walk.Declassify] = vector.init[walk.Declassify](a);
    fin { vector.dnit[walk.Declassify](?lifted); }
    var x: Models = models_of(a);
    fin { release_models(?x); }
    var places: vector.Vector[walk.Site] = vector.init[walk.Site](a);
    fin { vector.dnit[walk.Site](?places); }
    val placed: res[bool, allocator.Error] = public(f, r, points, ?lifted);
    if (sel placed.err) { ret res[opt[mct.Error], allocator.Error].err{placed.err}; }
    if (!placed.ok)     { ret unfollowed(f.function, walk.MISPLACED, 0, none); }
    val seeded: res[bool, allocator.Error] = seeds(a, m, b, l, f, ?list);
    if (sel seeded.err) { ret res[opt[mct.Error], allocator.Error].err{seeded.err}; }
    if (!seeded.ok)     { ret unfollowed(f.function, walk.UNSEEDABLE, 0, none); }
    val globals: err[allocator.Error] = secret_globals.seeds(m, l, ?list);
    if (sel globals.err) { ret res[opt[mct.Error], allocator.Error].err{globals.err}; }
    val s:     *object.Section = table.at[object.Section](?o.sections, r.section);
    val bytes: Bytes           = object.bytes(o, ?s.contents);
    if (r.end < r.start || r.end::usize > bytes.len) { ret unfollowed(f.function, walk.NOWHERE, 0, none); }
    var code:   walk.Code                      = walk.Code{set: b.basis.set, data: ?bytes.data[r.start::usize], len: (r.end - r.start)::usize, sites: walk.NO_SITES};
    val called: res[opt[u64], allocator.Error] = modeled(a, m, b, l, f, r, ?code, sites, ?x);
    if (sel called.err)     { ret res[opt[mct.Error], allocator.Error].err{called.err}; }
    if (sel called.ok.some) { ret unfollowed(f.function, walk.UNCALLED, called.ok.some, source_at(f.function, r, lines, called.ok.some)); }
    val fixed: res[opt[u64], allocator.Error] = sited(a, m, b, f, r, ?code, fixups, ?places);
    if (sel fixed.err)     { ret res[opt[mct.Error], allocator.Error].err{fixed.err}; }
    if (sel fixed.ok.some) { ret unfollowed(f.function, walk.UNSITED, fixed.ok.some, source_at(f.function, r, lines, fixed.ok.some)); }
    code.sites = walk.Sites{at: places.data, len: places.len::u32};
    val stated: res[opt[u64], allocator.Error] = stated_seeds(a, f, r, ?code, accesses, ?list);
    if (sel stated.err)     { ret res[opt[mct.Error], allocator.Error].err{stated.err}; }
    if (sel stated.ok.some) { ret unfollowed(f.function, walk.UNACCESSED, stated.ok.some, source_at(f.function, r, lines, stated.ok.some)); }
    val declared_at: res[opt[u64], allocator.Error] = result_seeds(a, f, r, ?code, results, ?list);
    if (sel declared_at.err)     { ret res[opt[mct.Error], allocator.Error].err{declared_at.err}; }
    if (sel declared_at.ok.some) { ret unfollowed(f.function, walk.UNSEEDABLE, declared_at.ok.some, source_at(f.function, r, lines, declared_at.ok.some)); }
    val marked_at: res[opt[u64], allocator.Error] = marked_seeds(a, f, r, ?code, marked, ?list);
    if (sel marked_at.err)     { ret res[opt[mct.Error], allocator.Error].err{marked_at.err}; }
    if (sel marked_at.ok.some) { ret unfollowed(f.function, walk.UNSEEDABLE, marked_at.ok.some, source_at(f.function, r, lines, marked_at.ok.some)); }
    var secrets:        walk.Secrets               = walk.Secrets{at: list.data, len: list.len::u32};
    var declared:       walk.Declassified          = walk.Declassified{at: lifted.data, len: lifted.len::u32};
    var calls:          walk.Calls                 = walk.Calls{at: x.calls.data, len: x.calls.len::u32};
    var stated_results: vector.Vector[walk.Result] = vector.init[walk.Result](a);
    fin { vector.dnit[walk.Result](?stated_results); }
    val pieced: res[bool, allocator.Error] = result_pieces(a, m, b, l, f.function, ?stated_results);
    if (sel pieced.err) { ret res[opt[mct.Error], allocator.Error].err{pieced.err}; }
    if (!pieced.ok)     { ret unfollowed(f.function, walk.UNSEEDABLE, 0, none); }
    var stated_bytes: vector.Vector[walk.Extent] = vector.init[walk.Extent](a);
    fin { vector.dnit[walk.Extent](?stated_bytes); }
    val public_bytes: err[allocator.Error] = memory_extents(a, m, b, l, f.function, ?stated_bytes);
    if (sel public_bytes.err) { ret res[opt[mct.Error], allocator.Error].err{public_bytes.err}; }
    var left:   walk.Results                     = walk.Results{at: stated_results.data, len: stated_results.len::u32, memory: walk.Extents{at: stated_bytes.data, len: stated_bytes.len::u32}};
    val answer: res[mct.Answer, allocator.Error] = mct.check(a, ?code, f.context, f.decode, gated, ?b.basis.context, ?secrets, ?declared, ?calls, ?left, m.functions.data[f.function].data.constant_time);
    if (sel answer.err) { ret res[opt[mct.Error], allocator.Error].err{answer.err}; }
    val got: mct.Answer = answer.ok;
    if (sel got.refused) {
        var refused: mct.Refused = mct.refused(f.function, mct.Where.offset{got.refused.offset}, got.refused.refusal, source_at(f.function, r, lines, got.refused.offset));
        if (got.refused.refusal.reason == ct.UNCHECKED || got.refused.refusal.reason == ct.UNDECLARED) { refused.callee = callee_at(?x, got.refused.offset); }
        val res_shared: res[opt[mct.Shared], allocator.Error] = contract.shared(a, m, b, l, f.function);
        if (sel res_shared.err) { ret res[opt[mct.Error], allocator.Error].err{res_shared.err}; }
        refused.shared = res_shared.ok;
        ret res[opt[mct.Error], allocator.Error].ok{opt[mct.Error].some{mct.Error.refused{refused}}};
    }
    if (sel got.unread)       { ret unfollowed(f.function, got.unread.message, got.unread.offset, source_at(f.function, r, lines, got.unread.offset)); }
    if (sel got.unguaranteed) { ret res[opt[mct.Error], allocator.Error].ok{opt[mct.Error].some{mct.Error.unguaranteed{mct.Unguaranteed{function: f.function, needs: got.unguaranteed, set: code.set, location: mct.location(m, f.function)}}}}; }
    ret res[opt[mct.Error], allocator.Error].ok{opt[mct.Error].none{}};
}

# the walk of the constant-time range `r` of function `f` of object `o`, under what the selections of its inline blocks add
fun read_range(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, l: *Layout, o: *object.Object, r: *CtRange, f: *Framed, heads: *head.Heads, points: Slice[Point], sites: Slice[Site], lines: Slice[Line], fixups: Slice[Fixup], stated: Slice[Stated], wrote: Slice[Result], marked: Slice[Marked]) res[opt[mct.Error], allocator.Error] {
    var reading: head.Reading;
    val read:    err[head.Error] = head.read(?reading, heads, t, ?m.functions.data[f.function].body, f.context);
    fin { head.finish(?reading, f.context); }
    if (sel read.err) {
        val why: head.Error = read.err;
        if (sel why.alloc) { ret res[opt[mct.Error], allocator.Error].err{why.alloc}; }
        ret unfollowed(f.function, head.fact(why), 0, opt[debug_record.Location].none{});
    }
    f.decode = reading.context;
    ret walked(a, m, b, l, o, r, f, reading.gated, points, sites, lines, fixups, stated, wrote, marked);
}

# the walk of every constant-time range of object `o`, the ranges in the order of the functions of `framed` that
# require constant time, as emission marked them, each requirement not met added to `out` in that order
# ---
# a:      the allocator the walk takes
# m:      the module
# b:      the target's build, whose set and context the code was encoded under and whose conventions model its calls
# t:      the target, whose layout sizes an incoming argument
# o:      the object
# framed: the frame of each function emitted, in the order emitted
# heads:  the selections of the module's inline blocks, read once each
# marks:  the declassify points, call sites, line facts, symbolic operands, stated memory accesses and declared-secret
#         registers emission made
# out:    where each requirement not met goes, one for each function that meets none
# ret:    ok, or why the walk had no storage
pub fun check(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: *object.Object, framed: Slice[Framed], heads: *head.Heads, marks: *Marks, out: *vector.Vector[mct.Error]) err[allocator.Error] {
    var l:      Layout        = layout.of(t, ?m.types, opt[*state.Context].some{?b.basis.context});
    val points: Slice[Point]  = Slice[Point]{data: marks.points.data, size: marks.points.len};
    val sites:  Slice[Site]   = Slice[Site]{data: marks.sites.data, size: marks.sites.len};
    val lines:  Slice[Line]   = Slice[Line]{data: marks.lines.data, size: marks.lines.len};
    val fixups: Slice[Fixup]  = Slice[Fixup]{data: marks.fixups.data, size: marks.fixups.len};
    val stated: Slice[Stated] = Slice[Stated]{data: marks.accesses.data, size: marks.accesses.len};
    val wrote:  Slice[Result] = Slice[Result]{data: marks.results.data, size: marks.results.len};
    val marked: Slice[Marked] = Slice[Marked]{data: marks.marked.data, size: marks.marked.len};
    val ranges: usize         = o.ct.len;
    var at:     usize         = 0;
    var i:      usize         = 0;
    for (i < framed.size) {
        val f: *Framed = ?framed.data[i];
        if (requires(m, f.function)) {
            var one: res[opt[mct.Error], allocator.Error] = unfollowed(f.function, walk.NOWHERE, 0, opt[debug_record.Location].none{});
            if (at < ranges) { one = read_range(a, m, b, t, ?l, o, ?o.ct.data[at], f, heads, points, sites, lines, fixups, stated, wrote, marked); }
            if (sel one.err) { ret err[allocator.Error].err{one.err}; }
            if (sel one.ok.some) {
                val res_unmet: res[usize, allocator.Error] = vector.push[mct.Error](out, one.ok.some);
                if (sel res_unmet.err) { ret err[allocator.Error].err{res_unmet.err}; }
            }
            at = at + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}
