# the names of one instruction set, indexed once
#
# the text form holds no name table: a register's name, an alias of it and an
# instruction's mnemonic are masc's rows. this index sorts those rows by name
# once and finds a register's row through the index of rows by identity, so
# printing and reading look a name up by binary search and never by scanning
# the catalog. a mnemonic with several encodings is several rows, spelled by
# the mnemonic and the row's place among them.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.sort;
use std.collections.vector;

use mirl.fail.keep;
use mirl.machine.registers;

use rf:   masc.core.register;
use rows: masc.core.row;
use mset: masc.core.set;

# a spelling and the row it names
# ---
# name:  the spelling
# index: the row's position in its file or catalog
pub rec Entry {
    name:  str;
    index: u32;
}

# the indexed names of a set
# ---
# file:      the set's register file, nil for a set with none
# catalog:   the set's rows
# names:     every register name and alias, sorted by spelling
# rows:      every register row, by identity
# mnemonics: every row, sorted by mnemonic and then by position
# ordinals:  each row's place among the rows of its mnemonic
pub rec Index {
    file:      *rf.File;
    catalog:   rows.Rows;
    names:     vector.Vector[Entry];
    rows:      registers.Rows;
    mnemonics: vector.Vector[Entry];
    ordinals:  vector.Vector[u32];
}

# order the bytes of two strings
fun order(a: *u8, la: usize, b: *u8, lb: usize) i64 {
    var i: usize = 0;
    for (i < la && i < lb) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) { ret -1; }
            ret 1;
        }
        i = i + 1;
    }
    if (la == lb) { ret 0; }
    if (la < lb)  { ret -1; }
    ret 1;
}

fun by_name(a: *Entry, b: *Entry) i64 {
    val c: i64 = order(a.name, str_len(a.name), b.name, str_len(b.name));
    if (c != 0)            { ret c; }
    if (a.index < b.index) { ret -1; }
    if (a.index > b.index) { ret 1; }
    ret 0;
}

# the index of a set's names
# ---
# a:   the allocator the index takes
# set: the instruction set
# ret: the index, or the allocator's refusal
pub fun init(a: *allocator.Allocator, set: *mset.Set) res[Index, allocator.Error] {
    var x: Index = Index{
        file:      nil,
        catalog:   rows.Rows{at: nil, len: 0},
        names:     vector.init[Entry](a),
        rows:      registers.Rows{file: nil, spots: vector.init[registers.Spot](a)},
        mnemonics: vector.init[Entry](a),
        ordinals:  vector.init[u32](a),
    };
    if (set.codec != nil) {
        x.file    = set.codec.registers;
        x.catalog = set.codec.rows;
    }
    val filled: err[allocator.Error] = fill(?x);
    if (sel filled.err) {
        dnit(?x);
        ret res[Index, allocator.Error].err{filled.err};
    }
    ret res[Index, allocator.Error].ok{x};
}

fun fill(x: *Index) err[allocator.Error] {
    var i: u32 = 0;
    if (x.file != nil) {
        val room: res[usize, allocator.Error] = vector.reserve[Entry](?x.names, (x.file.register_count + x.file.alias_count)::usize);
        if (sel room.err) { ret err[allocator.Error].err{room.err}; }
        val made: res[registers.Rows, allocator.Error] = registers.init(x.names.a, x.file);
        if (sel made.err) { ret err[allocator.Error].err{made.err}; }
        x.rows = made.ok;
        for (i < x.file.register_count) {
            vector.push[Entry](?x.names, Entry{name: x.file.registers[i].name, index: i});
            i = i + 1;
        }
        i = 0;
        for (i < x.file.alias_count) {
            vector.push[Entry](?x.names, Entry{name: x.file.aliases[i].name, index: x.file.aliases[i].register});
            i = i + 1;
        }
        sort.sort_by[Entry](x.names.data, x.names.len, by_name);
    }
    val listed: res[usize, allocator.Error] = vector.reserve[Entry](?x.mnemonics, x.catalog.len::usize);
    if (sel listed.err) { ret err[allocator.Error].err{listed.err}; }
    val places: res[usize, allocator.Error] = vector.reserve[u32](?x.ordinals, x.catalog.len::usize);
    if (sel places.err) { ret err[allocator.Error].err{places.err}; }
    i = 0;
    for (i < x.catalog.len) {
        vector.push[Entry](?x.mnemonics, Entry{name: x.catalog.at[i].mnemonic, index: i});
        vector.push[u32](?x.ordinals, 0);
        i = i + 1;
    }
    sort.sort_by[Entry](x.mnemonics.data, x.mnemonics.len, by_name);
    i = 0;
    var run: u32 = 0;
    for (i::usize < x.mnemonics.len) {
        if (i > 0 && by_name_only(?x.mnemonics.data[i - 1], ?x.mnemonics.data[i]) == 0) { run = run + 1; }
        or                                                                              { run = 0; }
        x.ordinals.data[x.mnemonics.data[i].index] = run;
        i                                          = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun by_name_only(a: *Entry, b: *Entry) i64 {
    ret order(a.name, str_len(a.name), b.name, str_len(b.name));
}

# give back the index's storage
pub fun dnit(x: *Index) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, vector.dnit[Entry](?x.names));
    keep(?failed, registers.dnit(?x.rows));
    keep(?failed, vector.dnit[Entry](?x.mnemonics));
    keep(?failed, vector.dnit[u32](?x.ordinals));
    ret failed;
}

# the first entry of a sorted list spelled as name, or the list's length
fun first(list: *vector.Vector[Entry], name: View) usize {
    var lo: usize = 0;
    var hi: usize = list.len;
    for (lo < hi) {
        val mid: usize  = lo + (hi - lo) / 2;
        val e:   *Entry = ?list.data[mid];
        if (order(e.name, str_len(e.name), name.data, name.len) < 0) { lo = mid + 1; }
        or                                                           { hi = mid; }
    }
    ret lo;
}

fun spelled(list: *vector.Vector[Entry], at: usize, name: View) bool {
    ret at < list.len && order(list.data[at].name, str_len(list.data[at].name), name.data, name.len) == 0;
}

# the register a name spells, by its name or an alias of it
pub fun register_named(x: *Index, name: View) opt[rf.Id] {
    val at: usize = first(?x.names, name);
    if (!spelled(?x.names, at, name)) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{rf.id_of(?x.file.registers[x.names.data[at].index])};
}

# the name of a register of the file
pub fun register_name(x: *Index, id: rf.Id) opt[str] {
    val at: opt[u32] = registers.row(?x.rows, id);
    if (sel at.none) { ret opt[str].none{}; }
    ret opt[str].some{x.file.registers[at.some].name};
}

# the row a mnemonic spells at a place among its encodings
pub fun row_named(x: *Index, name: View, ordinal: u32) opt[*rows.Row] {
    val at: usize = first(?x.mnemonics, name);
    if (!spelled(?x.mnemonics, at, name))       { ret opt[*rows.Row].none{}; }
    if (at + ordinal::usize >= x.mnemonics.len) { ret opt[*rows.Row].none{}; }
    val e: *Entry = ?x.mnemonics.data[at + ordinal::usize];
    if (order(e.name, str_len(e.name), name.data, name.len) != 0) { ret opt[*rows.Row].none{}; }
    ret opt[*rows.Row].some{?x.catalog.at[e.index]};
}

# the position of a row among the catalog's, none for a row it does not hold
pub fun row_index(x: *Index, r: *rows.Row) opt[u32] {
    if (x.catalog.len == 0 || r:~u64 < x.catalog.at:~u64) { ret opt[u32].none{}; }
    val bytes: u64 = r:~u64 - x.catalog.at:~u64;
    if (bytes % $size_of(rows.Row)::u64 != 0) { ret opt[u32].none{}; }
    val at: u64 = bytes / $size_of(rows.Row)::u64;
    if (at >= x.catalog.len::u64) { ret opt[u32].none{}; }
    ret opt[u32].some{at::u32};
}

# the place of a row among the rows of its mnemonic
pub fun ordinal(x: *Index, row_at: u32) u32 {
    ret x.ordinals.data[row_at];
}
