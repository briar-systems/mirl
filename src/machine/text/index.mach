# the names of one instruction set, indexed once
#
# the text form holds no name table: a register's name, an alias of it, a
# class's name and an instruction's key are masc's rows. a register is found
# by masc's own lookup of a name or an alias, a class and a row by the sorted
# indices masc states beside them, and this index finds a register's row
# through the index of rows by identity, so printing and reading look a name
# up by binary search and never by scanning the catalog. a target's memory
# classes and loops are sorted by name here once.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.fail.keep;
use mirl.machine.class.Memory;
use lrow: mirl.machine.loop.row;
use mirl.machine.text.item.Env;
use mirl.machine.text.resolve.Failure;

use mindex: masc.core.index;
use rf:     masc.core.register;
use rows:   masc.core.row;
use mset:   masc.core.set;

# a spelling and the row it names
# ---
# name:  the spelling
# index: the row's position in its file or catalog
pub rec Entry {
    name:  str;
    index: u32;
}

# why a register's name was not read
# ---
# unfiled: the name, read for a set with no register file
# unknown: the name, which the register file does not spell
pub tag Unspelled: u8 {
    unfiled: View;
    unknown: View;
}

# why a register was not named
# ---
# unfiled: the register, asked of a set with no register file
# unknown: the register, which the register file does not have
pub tag Unnamed: u8 {
    unfiled: rf.Id;
    unknown: rf.Id;
}

# the indexed names of a set
# ---
# file:     the set's register file, nil for a set with none
# catalog:  the set's rows
# keys:     masc's index of the rows by key
# memories: the target's memory-backed classes
# spots:    their names, sorted by spelling, each entry's index a place in
#           `memories`
# loops:    the loops mirl carries for the set
# names:    their names, sorted by spelling, each entry's index a place in `loops`
pub rec Index {
    file:     *rf.File;
    catalog:  rows.Rows;
    keys:     mindex.Index;
    memories: Slice[Memory];
    spots:    vector.Vector[Entry];
    loops:    lrow.Loops;
    names:    vector.Vector[Entry];
}

# order the bytes of two strings
fun order(a: *u8, la: usize, b: *u8, lb: usize) i64 {
    var i: usize = 0;
    for (i < la && i < lb) {
        if (a[i] != b[i]) {
            if (a[i] < b[i]) { ret -1; }
            ret 1;
        }
        i = i + 1;
    }
    if (la == lb) { ret 0; }
    if (la < lb)  { ret -1; }
    ret 1;
}

fun by_name(a: *Entry, b: *Entry) i64 {
    val c: i64 = order(a.name, str_len(a.name), b.name, str_len(b.name));
    if (c != 0)            { ret c; }
    if (a.index < b.index) { ret -1; }
    if (a.index > b.index) { ret 1; }
    ret 0;
}

# the index of an environment's names
# ---
# a:   the allocator the index takes
# env: the instruction set and the memory-backed classes
# ret: the index, or why the environment's names cannot be indexed
pub fun init(a: *allocator.Allocator, env: *Env) res[Index, Failure] {
    val set: *mset.Set = env.set;
    var x:   Index     = Index{
        file:     nil,
        catalog:  rows.Rows{at: nil, len: 0},
        keys:     mindex.EMPTY,
        memories: env.memories,
        spots:    vector.init[Entry](a),
        loops:    env.loops,
        names:    vector.init[Entry](a),
    };
    if (set.codec != nil) {
        x.file    = set.codec.registers;
        x.catalog = set.codec.rows;
        x.keys    = set.codec.keys;
    }
    val named: err[Failure] = name_memories(?x);
    if (sel named.err) {
        dnit(?x);
        ret res[Index, Failure].err{named.err};
    }
    val listed: err[Failure] = name_loops(?x);
    if (sel listed.err) {
        dnit(?x);
        ret res[Index, Failure].err{listed.err};
    }
    ret res[Index, Failure].ok{x};
}

# sort a list of names, none when every name is spelled once, else the first spelled twice
fun sorted(list: *vector.Vector[Entry]) opt[str] {
    sort.sort_by[Entry](list.data, list.len, by_name);
    var i: usize = 1;
    for (i < list.len) {
        if (order(list.data[i - 1].name, str_len(list.data[i - 1].name), list.data[i].name, str_len(list.data[i].name)) == 0) { ret opt[str].some{list.data[i].name}; }
        i = i + 1;
    }
    ret opt[str].none{};
}

fun name_memories(x: *Index) err[Failure] {
    val room: res[usize, allocator.Error] = vector.reserve[Entry](?x.spots, x.memories.size);
    if (sel room.err) { ret err[Failure].err{Failure.alloc{room.err}}; }
    var i: usize = 0;
    for (i < x.memories.size) {
        if (str_len(x.memories.data[i].name) == 0) { ret err[Failure].err{Failure.memory{x.memories.data[i].name}}; }
        vector.push[Entry](?x.spots, Entry{name: x.memories.data[i].name, index: i::u32});
        i = i + 1;
    }
    val twice: opt[str] = sorted(?x.spots);
    if (sel twice.some) { ret err[Failure].err{Failure.memory{twice.some}}; }
    ret err[Failure].ok{};
}

# every loop by its name, each one keeping the schema of a loop
fun name_loops(x: *Index) err[Failure] {
    val room: res[usize, allocator.Error] = vector.reserve[Entry](?x.names, x.loops.len::usize);
    if (sel room.err) { ret err[Failure].err{Failure.alloc{room.err}}; }
    var i: u32 = 0;
    for (i < x.loops.len) {
        val l:   *lrow.Loop = x.loops.at[i];
        val bad: opt[str]   = lrow.check(l);
        if (str_len(l.name) == 0 || sel bad.some) { ret err[Failure].err{Failure.loop{l.name}}; }
        vector.push[Entry](?x.names, Entry{name: l.name, index: i});
        i = i + 1;
    }
    val twice: opt[str] = sorted(?x.names);
    if (sel twice.some) { ret err[Failure].err{Failure.loop{twice.some}}; }
    ret err[Failure].ok{};
}

# give back the index's storage
pub fun dnit(x: *Index) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, vector.dnit[Entry](?x.spots));
    keep(?failed, vector.dnit[Entry](?x.names));
    ret failed;
}

# the first entry of a sorted list spelled as name, or the list's length
fun first(list: *vector.Vector[Entry], name: View) usize {
    var lo: usize = 0;
    var hi: usize = list.len;
    for (lo < hi) {
        val mid: usize  = lo + (hi - lo) / 2;
        val e:   *Entry = ?list.data[mid];
        if (order(e.name, str_len(e.name), name.data, name.len) < 0) { lo = mid + 1; }
        or                                                           { hi = mid; }
    }
    ret lo;
}

fun spelled(list: *vector.Vector[Entry], at: usize, name: View) bool {
    ret at < list.len && order(list.data[at].name, str_len(list.data[at].name), name.data, name.len) == 0;
}

# the register a name spells, by its name or an alias of it
# ---
# ret: the register, or the name refused as one no register file holds or
#      one the file does not spell
pub fun register_named(x: *Index, name: View) res[rf.Id, Unspelled] {
    if (x.file == nil) { ret res[rf.Id, Unspelled].err{Unspelled.unfiled{name}}; }
    val id: opt[rf.Id] = rf.named(x.file, name, false);
    if (sel id.none) { ret res[rf.Id, Unspelled].err{Unspelled.unknown{name}}; }
    ret res[rf.Id, Unspelled].ok{id.some};
}

# the name of a register of the file
# ---
# ret: the name, or the register refused as one no register file holds or
#      one the file does not have
pub fun register_name(x: *Index, id: rf.Id) res[str, Unnamed] {
    if (x.file == nil) { ret res[str, Unnamed].err{Unnamed.unfiled{id}}; }
    val row: opt[*rf.Register] = rf.row_of(x.file, id);
    if (sel row.none) { ret res[str, Unnamed].err{Unnamed.unknown{id}}; }
    ret res[str, Unnamed].ok{row.some.name};
}

# the memory-backed class a name spells, one of the target's
pub fun memory_named(x: *Index, name: View) opt[*Memory] {
    val at: usize = first(?x.spots, name);
    if (!spelled(?x.spots, at, name)) { ret opt[*Memory].none{}; }
    ret opt[*Memory].some{?x.memories.data[x.spots.data[at].index]};
}

# the loop a name spells, one of the set's
pub fun loop_named(x: *Index, name: View) opt[*lrow.Loop] {
    val at: usize = first(?x.names, name);
    if (!spelled(?x.names, at, name)) { ret opt[*lrow.Loop].none{}; }
    ret opt[*lrow.Loop].some{x.loops.at[x.names.data[at].index]};
}

# whether a class is one of the target's, found by the name it states
pub fun supplied(x: *Index, c: *Memory) bool {
    if (c == nil) { ret false; }
    val got: opt[*Memory] = memory_named(x, View{data: c.name, len: str_len(c.name)});
    ret sel got.some && got.some == c;
}

# the row a key spells
pub fun row_keyed(x: *Index, key: View) opt[*rows.Row] {
    val at: opt[u32] = mindex.find_view(?x.keys, key, false);
    if (sel at.none) { ret opt[*rows.Row].none{}; }
    ret opt[*rows.Row].some{?x.catalog.at[at.some]};
}

# the class a name spells, by its position in the register file
pub fun class_named(x: *Index, name: View) opt[u16] {
    if (x.file == nil) { ret opt[u16].none{}; }
    val at: opt[u32] = mindex.find_view(?x.file.class_names, name, false);
    if (sel at.none) { ret opt[u16].none{}; }
    ret opt[u16].some{at.some::u16};
}
