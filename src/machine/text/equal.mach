# structural equality of machine functions
#
# two sets of functions are equal when they say the same thing, as the ir text
# form compares modules: the functions are paired by the symbol they are the
# code of and their order carries no meaning, while a block, an instruction and
# an operand stand where they stand. a symbol operand is compared by the name
# of the symbol, so the two sides may be different modules. a debug entry is
# compared by its position in the table of its module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;

use mirl.ir.debug.Binding;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Symbol;
use mirl.ir.metadata.Metadata;
use mirl.ir.metadata.same_flags;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.printer.Error;
use mirl.machine.class;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.text.item.Item;
use mirl.slice;

fun hash_name(v: *View) u64 {
    ret slice.hash_view(0xcbf29ce484222325, @v);
}

fun same_name(a: *View, b: *View) bool {
    ret slice.same_view(@a, @b);
}

fun name_of(m: *Module, s: Symbol) res[View, Error] {
    if (sel s.function) {
        val d: res[FunctionData, module.Error] = module.function_data(m, s.function);
        if (sel d.err) { ret res[View, Error].err{Error.ir{d.err}}; }
        ret res[View, Error].ok{d.ok.name};
    }
    val d: res[GlobalData, module.Error] = module.global_data(m, s.global);
    if (sel d.err) { ret res[View, Error].err{Error.ir{d.err}}; }
    ret res[View, Error].ok{d.ok.name};
}

fun same_symbol(ma: *Module, a: Symbol, mb: *Module, b: Symbol) res[bool, Error] {
    if (sel a.function != sel b.function) { ret res[bool, Error].ok{false}; }
    val na: res[View, Error] = name_of(ma, a);
    if (sel na.err) { ret res[bool, Error].err{na.err}; }
    val nb: res[View, Error] = name_of(mb, b);
    if (sel nb.err) { ret res[bool, Error].err{nb.err}; }
    ret res[bool, Error].ok{slice.same_view(na.ok, nb.ok)};
}

fun same_register(a: Register, b: Register) bool {
    if (sel a.virtual) { ret sel b.virtual && b.virtual.index == a.virtual.index; }
    ret sel b.physical && class.same_physical(a.physical, b.physical);
}

fun same_operand(ma: *Module, a: Operand, mb: *Module, b: Operand) res[bool, Error] {
    if (sel a.virtual)   { ret res[bool, Error].ok{sel b.virtual && b.virtual.index == a.virtual.index}; }
    if (sel a.physical)  { ret res[bool, Error].ok{sel b.physical && class.same_physical(a.physical, b.physical)}; }
    if (sel a.immediate) { ret res[bool, Error].ok{sel b.immediate && b.immediate == a.immediate}; }
    if (sel a.slot)      { ret res[bool, Error].ok{sel b.slot && b.slot.index == a.slot.index}; }
    if (sel a.block)     { ret res[bool, Error].ok{sel b.block && b.block.index == a.block.index}; }
    if (sel a.tied)      { ret res[bool, Error].ok{sel b.tied && (same_register(a.tied.dest, b.tied.dest) && same_register(a.tied.source, b.tied.source))}; }
    if (sel a.symbol) {
        if (!(sel b.symbol))                    { ret res[bool, Error].ok{false}; }
        if (a.symbol.addend != b.symbol.addend) { ret res[bool, Error].ok{false}; }
        if (a.symbol.kind != b.symbol.kind)     { ret res[bool, Error].ok{false}; }
        ret same_symbol(ma, a.symbol.symbol, mb, b.symbol.symbol);
    }
    ret res[bool, Error].ok{false};
}

fun same_opcode(a: Opcode, b: Opcode) bool {
    if (sel a.row) { ret sel b.row && b.row == a.row; }
    ret sel b.pseudo && b.pseudo == a.pseudo;
}

fun same_bindings(ma: *Module, a: Metadata, mb: *Module, b: Metadata) res[bool, Error] {
    val la: res[Slice[Binding], module.Error] = module.bound(ma, a.bindings);
    if (sel la.err) { ret res[bool, Error].err{Error.ir{la.err}}; }
    val lb: res[Slice[Binding], module.Error] = module.bound(mb, b.bindings);
    if (sel lb.err)               { ret res[bool, Error].err{Error.ir{lb.err}}; }
    if (la.ok.size != lb.ok.size) { ret res[bool, Error].ok{false}; }
    var i: usize = 0;
    for (i < la.ok.size) {
        if (la.ok.data[i].index != lb.ok.data[i].index) { ret res[bool, Error].ok{false}; }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}

fun same_metadata(ma: *Module, a: Metadata, mb: *Module, b: Metadata) res[bool, Error] {
    if (sel a.location.some != sel b.location.some || sel a.site.some != sel b.site.some) { ret res[bool, Error].ok{false}; }
    if (sel a.location.some) {
        if (!(sel b.location.some))                         { ret res[bool, Error].ok{false}; }
        if (b.location.some.index != a.location.some.index) { ret res[bool, Error].ok{false}; }
    }
    if (sel a.site.some) {
        if (!(sel b.site.some))                     { ret res[bool, Error].ok{false}; }
        if (b.site.some.index != a.site.some.index) { ret res[bool, Error].ok{false}; }
    }
    if (!same_flags(a.flags, b.flags) || a.secret != b.secret) { ret res[bool, Error].ok{false}; }
    ret same_bindings(ma, a, mb, b);
}

fun same_instruction(ma: *Module, a: *InstructionData, mb: *Module, b: *InstructionData) res[bool, Error] {
    if (!same_opcode(a.opcode, b.opcode) || a.operands.size != b.operands.size) { ret res[bool, Error].ok{false}; }
    var i: usize = 0;
    for (i < a.operands.size) {
        val s: res[bool, Error] = same_operand(ma, a.operands.data[i], mb, b.operands.data[i]);
        if (sel s.err) { ret s; }
        if (!s.ok)     { ret s; }
        i = i + 1;
    }
    ret same_metadata(ma, a.metadata, mb, b.metadata);
}

# whether two machine functions are the same function
# ---
# ma:  the module whose symbols and debug entries a names
# mb:  the module b names
# ret: whether they are equal, or the module's refusal of a read
pub fun same_function(ma: *Module, a: *Function, mb: *Module, b: *Function) res[bool, Error] {
    if (a.virtuals.len != b.virtuals.len || a.slots.len != b.slots.len || a.blocks.len != b.blocks.len) { ret res[bool, Error].ok{false}; }
    var i: usize = 0;
    for (i < a.virtuals.len) {
        if (!class.same(a.virtuals.data[i], b.virtuals.data[i])) { ret res[bool, Error].ok{false}; }
        i = i + 1;
    }
    i = 0;
    for (i < a.slots.len) {
        if (a.slots.data[i].size != b.slots.data[i].size || a.slots.data[i].align != b.slots.data[i].align) { ret res[bool, Error].ok{false}; }
        i = i + 1;
    }
    i = 0;
    for (i < a.blocks.len) {
        val la: Slice[Instruction] = function.instructions(a, Block{index: i::u32});
        val lb: Slice[Instruction] = function.instructions(b, Block{index: i::u32});
        if (la.size != lb.size) { ret res[bool, Error].ok{false}; }
        var k: usize = 0;
        for (k < la.size) {
            val s: res[bool, Error] = same_instruction(ma, function.data(a, la.data[k]), mb, function.data(b, lb.data[k]));
            if (sel s.err) { ret s; }
            if (!s.ok)     { ret s; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}

# whether two sets of machine functions say the same thing
# ---
# ma:  the module whose symbols and debug entries a names
# mb:  the module b names
# ret: whether they are equal, or the module's refusal of a read
pub fun same(ma: *Module, a: Slice[Item], mb: *Module, b: Slice[Item]) res[bool, Error] {
    if (a.size != b.size) { ret res[bool, Error].ok{false}; }
    var by_name: map.MapBy[View, u32] = map.init_by[View, u32](ma.a, hash_name, same_name);
    fin { map.dnit_by[View, u32](?by_name); }
    var i: usize = 0;
    for (i < b.size) {
        val n: res[View, Error] = name_of(mb, b.data[i].symbol);
        if (sel n.err) { ret res[bool, Error].err{n.err}; }
        val put: res[bool, allocator.Error] = map.insert_by[View, u32](?by_name, n.ok, i::u32);
        if (sel put.err) { ret res[bool, Error].err{Error.alloc{put.err}}; }
        i = i + 1;
    }
    i = 0;
    for (i < a.size) {
        val n: res[View, Error] = name_of(ma, a.data[i].symbol);
        if (sel n.err) { ret res[bool, Error].err{n.err}; }
        val at: opt[*u32] = map.get_by[View, u32](?by_name, ?n.ok);
        if (sel at.none) { ret res[bool, Error].ok{false}; }
        val s: res[bool, Error] = same_function(ma, ?a.data[i].function, mb, ?b.data[@at.some].function);
        if (sel s.err) { ret s; }
        if (!s.ok)     { ret s; }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}
