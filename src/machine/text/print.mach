# the printer of the machine form text
#
# it writes through the printer of the ir text form, so the sink, the quoting
# and the metadata record are the ones that form writes. a register and an
# instruction are spelled by the rows of the set's register file and catalog.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use io: std.io.writer;

use mirl.ir.module.Module;
use ir_item: mirl.ir.text.item;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Error;
use mirl.ir.text.printer.Printer;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Physical;
use mirl.machine.function;
use mirl.machine.function.Area;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.pseudo;
use mirl.machine.text.index;
use mirl.machine.text.index.Index;
use mirl.machine.text.item;
use mirl.machine.text.item.Env;
use mirl.machine.text.item.Item;
use mirl.machine.text.resolve;
use mirl.machine.text.resolve.Failure;
use mirl.target.Target;

use mset:   masc.core.set;
use arches: mink.lib.catalog.arch;

use rf: masc.core.register;

pub val NO_REGISTER: str = "register the register file does not have";
pub val NO_ROW:      str = "instruction not in the target's catalog";
pub val NO_PSEUDO:   str = "pseudo not in the pseudo table";
pub val NO_MEMORY:   str = "memory class the target does not supply";
pub val NO_CLASS:    str = "register class the register file does not have";
pub val NO_KIND:     str = "symbol with no relocation kind";

# what one printing reads names from
# ---
# p: the printer
# x: the indexed names of the environment
rec State {
    p: *Printer;
    x: *Index;
}

fun fail(s: *State, what: str) {
    printer.fail(s.p, Error.machine{what});
}

fun memory(s: *State, c: *class.Memory) {
    if (!index.supplied(s.x, c)) {
        fail(s, NO_MEMORY);
        ret;
    }
    spell(s.p, c.name);
}

fun class_ref(s: *State, c: Class) {
    if (sel c.hardware) {
        if (c.hardware.file != s.x.file || !class.valid(c)) {
            fail(s, NO_CLASS);
            ret;
        }
        keyword(s.p, item.KW_CLASS);
        printer.byte(s.p, ' ');
        spell(s.p, c.hardware.file.classes[c.hardware.index].name);
        ret;
    }
    keyword(s.p, item.KW_MEMORY);
    printer.byte(s.p, ' ');
    memory(s, c.memory);
}

fun spell(p: *Printer, name: str) {
    val v: View = View{data: name, len: str_len(name)};
    if (item.reserved(v)) { printer.string(p, v); }
    or                    { printer.word(p, name); }
}

# write a keyword, one of the item.KW_ handles
fun keyword(p: *Printer, k: str) {
    printer.text(p, k);
}

fun register_name(s: *State, id: rf.Id) {
    val n: opt[str] = index.register_name(s.x, id);
    if (sel n.none) {
        fail(s, NO_REGISTER);
        ret;
    }
    spell(s.p, n.some);
}

fun physical(s: *State, r: Physical) {
    if (sel r.register) {
        register_name(s, r.register);
        ret;
    }
    printer.byte(s.p, '{');
    memory(s, r.cell.class);
    printer.text(s.p, ": ");
    printer.number(s.p, r.cell.number::u64);
    printer.byte(s.p, '}');
}

fun register(s: *State, r: Register) {
    if (sel r.virtual) {
        printer.byte(s.p, '%');
        printer.number(s.p, r.virtual.index::u64);
        ret;
    }
    physical(s, r.physical);
}

fun operand(s: *State, o: Operand) {
    if (sel o.virtual)  { register(s, Register.virtual{o.virtual}); }
    or (sel o.physical) { physical(s, o.physical); }
    or (sel o.immediate) {
        if (o.immediate < 0) {
            printer.byte(s.p, '-');
            printer.number(s.p, ~(o.immediate::u64) + 1);
        }
        or { printer.number(s.p, o.immediate::u64); }
    }
    or (sel o.slot) {
        printer.byte(s.p, '[');
        printer.number(s.p, o.slot.index::u64);
        printer.byte(s.p, ']');
    }
    or (sel o.symbol) {
        printer.symbol(s.p, o.symbol.symbol);
        if (o.symbol.addend > 0) {
            printer.text(s.p, " + ");
            printer.number(s.p, o.symbol.addend::u64);
        }
        or (o.symbol.addend < 0) {
            printer.text(s.p, " - ");
            printer.number(s.p, ~(o.symbol.addend::u64) + 1);
        }
        if (o.symbol.kind == nil) {
            fail(s, NO_KIND);
            ret;
        }
        printer.text(s.p, " : ");
        printer.word(s.p, o.symbol.kind.name);
    }
    or (sel o.block) {
        printer.byte(s.p, '^');
        printer.number(s.p, o.block.index::u64);
    }
    or (sel o.tied) {
        register(s, o.tied.dest);
        printer.text(s.p, " = ");
        register(s, o.tied.source);
    }
}

fun opcode(s: *State, op: Opcode) {
    if (sel op.pseudo) {
        val r: opt[*pseudo.Row] = pseudo.row(op.pseudo);
        if (sel r.none) {
            fail(s, NO_PSEUDO);
            ret;
        }
        keyword(s.p, item.KW_PSEUDO);
        printer.byte(s.p, ' ');
        printer.word(s.p, r.some.name);
        ret;
    }
    val at: opt[u32] = index.row_index(s.x, op.row);
    if (sel at.none) {
        fail(s, NO_ROW);
        ret;
    }
    spell(s.p, op.row.key);
}

fun instruction(s: *State, d: *InstructionData) {
    printer.text(s.p, "    ");
    opcode(s, d.opcode);
    var k: usize = 0;
    for (k < d.operands.size) {
        if (k > 0) { printer.byte(s.p, ','); }
        printer.byte(s.p, ' ');
        operand(s, d.operands.data[k]);
        k = k + 1;
    }
    ir_item.metadata(s.p, d.metadata);
    if (d.declassifies) {
        printer.byte(s.p, ' ');
        keyword(s.p, item.KW_DECLASSIFIES);
    }
    printer.newline(s.p);
}

fun body(s: *State, f: *Function) {
    var k: usize = 0;
    for (k < f.virtuals.len) {
        printer.text(s.p, "    ");
        keyword(s.p, item.KW_VIRTUAL);
        printer.text(s.p, " %");
        printer.number(s.p, k::u64);
        printer.text(s.p, ": ");
        class_ref(s, f.virtuals.data[k]);
        printer.newline(s.p);
        k = k + 1;
    }
    k = 0;
    for (k < f.slots.len) {
        printer.text(s.p, "    ");
        keyword(s.p, item.KW_SLOT);
        printer.text(s.p, " [");
        printer.number(s.p, k::u64);
        printer.text(s.p, "]: ");
        keyword(s.p, item.KW_SIZE);
        printer.byte(s.p, ' ');
        printer.number(s.p, f.slots.data[k].size);
        printer.byte(s.p, ' ');
        if (f.slots.data[k].per != 0) {
            keyword(s.p, item.KW_PER);
            printer.byte(s.p, ' ');
            printer.number(s.p, f.slots.data[k].per);
            printer.byte(s.p, ' ');
            keyword(s.p, item.KW_SCALE);
            printer.byte(s.p, ' ');
            printer.number(s.p, f.slots.data[k].scale::u64);
            printer.byte(s.p, ' ');
        }
        keyword(s.p, item.KW_ALIGN);
        printer.byte(s.p, ' ');
        printer.number(s.p, f.slots.data[k].align);
        val area: Area = f.slots.data[k].area;
        if (sel area.incoming) {
            printer.byte(s.p, ' ');
            keyword(s.p, item.KW_INCOMING);
            printer.byte(s.p, ' ');
            printer.number(s.p, area.incoming);
        }
        if (sel area.outgoing) {
            printer.byte(s.p, ' ');
            keyword(s.p, item.KW_OUTGOING);
            printer.byte(s.p, ' ');
            printer.number(s.p, area.outgoing);
        }
        printer.newline(s.p);
        k = k + 1;
    }
    k = 0;
    for (k < f.blocks.len) {
        printer.byte(s.p, '^');
        printer.number(s.p, k::u64);
        printer.byte(s.p, ':');
        printer.newline(s.p);
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            instruction(s, function.data(f, list.data[i]));
            i = i + 1;
        }
        k = k + 1;
    }
}

fun write(w: *io.Writer, m: *Module, env: *Env, items: Slice[Item]) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    printer.header(?p);
    val made: res[Index, Failure] = index.init(m.a, env);
    if (sel made.err) { ret err[Error].err{Error.target{made.err}}; }
    var x: Index = made.ok;
    fin { index.dnit(?x); }
    var s: State = State{p: ?p, x: ?x};
    var i: usize = 0;
    for (i < items.size) {
        printer.newline(?p);
        keyword(?p, item.KW_FUNCTION);
        printer.byte(?p, ' ');
        printer.symbol(?p, items.data[i].symbol);
        printer.text(?p, " {");
        printer.newline(?p);
        body(?s, ?items.data[i].function);
        printer.text(?p, "}");
        printer.newline(?p);
        i = i + 1;
    }
    val failed: opt[Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{failed.some}; }
    ret err[Error].ok{};
}

# write the text of the machine functions of a module
# ---
# w:     the writer the text goes to
# m:     the module the functions' symbols and metadata name entries of, whose
#        target gives the instruction set and the memory-backed classes
# items: the functions
# ret:   ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module, items: Slice[Item]) err[Error] {
    val env: res[Env, Failure] = resolve.of(m);
    if (sel env.err) { ret err[Error].err{Error.target{env.err}}; }
    var e: Env = env.ok;
    ret write(w, m, ?e, items);
}

# print against a registry and a target given as data, for tests whose
# instruction set no registry of the tree holds
# ---
# registry: the instruction sets
# arch:     the architecture row the target runs
# t:        the target
#[testing]
pub fun print_in(w: *io.Writer, m: *Module, registry: *mset.Registry, arch: *arches.Arch, t: *Target, items: Slice[Item]) err[Error] {
    val env: res[Env, Failure] = resolve.resolve(registry, arch, t);
    if (sel env.err) { ret err[Error].err{Error.target{env.err}}; }
    var e: Env = env.ok;
    ret write(w, m, ?e, items);
}
