# the printer of the machine form text
#
# it writes through the printer of the ir text form, so the sink, the quoting,
# the header and the metadata are the ones that form writes. a register and an
# instruction are spelled by the rows of the set's register file and catalog.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mirl.ir.metadata.Metadata;
use mirl.ir.module.Module;
use mirl.ir.place.Place;
use mirl.ir.place.Placed;
use mirl.ir.text.item.fill;
use mirl.ir.text.item.metadata;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Printer;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Physical;
use mirl.machine.function;
use mirl.machine.function.Area;
use mirl.machine.function.Argued;
use mirl.machine.function.Function;
use mirl.machine.function.SlotData;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.NO_LABEL;
use mirl.machine.instruction.Opcode;
use mirl.machine.isa.Isas;
use mirl.machine.operand.Address;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use Reference: mirl.machine.operand.Symbol;
use mirl.machine.pseudo;
use mirl.machine.text.item;
use mirl.machine.text.item.Env;
use mirl.machine.text.item.Item;
use mirl.machine.text.resolve;
use mirl.machine.text.resolve.Failure;
use mirl.machine.vstate;

use mindex: masc.core.index;
use mo:     masc.core.operand;
use rf:     masc.core.register;
use rows:   masc.core.row;

# why the machine form text could not be written
# ---
# text:   the printer of the ir text form refused, or a fact of the machine
#         form its rows do not have
# target: the module's target gives no environment for a machine form text
pub tag Error: u8 {
    text:   printer.Error;
    target: Failure;
}

pub val NO_REGISTER: str = "register the register file does not have";
pub val NO_FILE:     str = "register of a set with no register file";
pub val NO_ROW:      str = "instruction not in the target's catalog";
pub val NO_PSEUDO:   str = "pseudo not in the pseudo table";
pub val NO_MEMORY:   str = "memory class the target does not supply";
pub val NO_STATE:    str = "configuration state of a set with none";
pub val NO_CLASS:    str = "register class the register file does not have";
pub val NO_KIND:     str = "symbol with no relocation kind";

# what one printing reads names from
# ---
# p:    the printer
# env:  the instruction set and the memory-backed classes
# file: the set's register file, nil for a set with none
rec State {
    p:    *Printer;
    env:  *Env;
    file: *rf.File;
}

fun fail(s: *State, what: str) {
    printer.fail(s.p, printer.Error.form{what});
}

# write a row's name, quoted where it is one of the grammar's words
fun spell(p: *Printer, name: str) {
    val v: View = View{data: name, len: str_len(name)};
    if (item.reserved(v)) { printer.string(p, v); }
    or                    { printer.name(p, v); }
}

fun memory(s: *State, c: *class.Memory) {
    var i: usize = 0;
    for (i < s.env.memories.size && ?s.env.memories.data[i] != c) { i = i + 1; }
    if (c == nil || i == s.env.memories.size) {
        fail(s, NO_MEMORY);
        ret;
    }
    spell(s.p, c.name);
}

fun class_ref(s: *State, c: Class) {
    if (sel c.hardware) {
        if (c.hardware.file != s.file || !class.valid(c)) {
            fail(s, NO_CLASS);
            ret;
        }
        spell(s.p, c.hardware.file.classes[c.hardware.index].name);
        ret;
    }
    printer.text(s.p, "memory(");
    memory(s, c.memory);
    printer.byte(s.p, ')');
}

fun register_name(s: *State, id: rf.Id) {
    if (s.file == nil) {
        fail(s, NO_FILE);
        ret;
    }
    val row: opt[*rf.Register] = rf.row_of(s.file, id);
    if (sel row.none) {
        fail(s, NO_REGISTER);
        ret;
    }
    spell(s.p, row.some.name);
}

fun physical(s: *State, r: Physical) {
    if (sel r.register) {
        register_name(s, r.register);
        ret;
    }
    printer.byte(s.p, '{');
    memory(s, r.cell.class);
    printer.text(s.p, ": ");
    printer.number(s.p, r.cell.number::u64);
    printer.byte(s.p, '}');
}

fun virtual(s: *State, index: u32) {
    printer.byte(s.p, '%');
    printer.number(s.p, index::u64);
}

fun register(s: *State, r: Register) {
    if (sel r.virtual) { virtual(s, r.virtual.index); }
    or                 { physical(s, r.physical); }
}

fun signed(s: *State, n: i64) {
    if (n < 0) {
        printer.byte(s.p, '-');
        printer.number(s.p, ~(n::u64) + 1);
    }
    or { printer.number(s.p, n::u64); }
}

# a symbol's address under its relocation kind, the kind applied to the address
fun reference(s: *State, r: Reference) {
    if (r.kind == nil) {
        fail(s, NO_KIND);
        ret;
    }
    printer.word(s.p, r.kind.name);
    printer.text(s.p, "(?");
    printer.symbol(s.p, r.symbol);
    if (r.addend > 0) {
        printer.text(s.p, " + ");
        printer.number(s.p, r.addend::u64);
    }
    or (r.addend < 0) {
        printer.text(s.p, " - ");
        printer.number(s.p, ~(r.addend::u64) + 1);
    }
    printer.byte(s.p, ')');
}

# the separator before an address's field, none before its first
fun field(s: *State, name: str, first: *bool) {
    if (!@first) { printer.text(s.p, ", "); }
    @first = false;
    printer.text(s.p, name);
    printer.text(s.p, ": ");
}

fun address_register(s: *State, name: str, r: opt[Register], first: *bool) {
    if (sel r.none) { ret; }
    field(s, name, first);
    register(s, r.some);
}

fun number_field(s: *State, name: str, n: u64, first: *bool) {
    if (n == 0) { ret; }
    field(s, name, first);
    printer.number(s.p, n);
}

# an address, each field that is not its zero by name between brackets, the
# displacement where every field is its zero
fun address(s: *State, a: Address) {
    var first: bool = true;
    printer.byte(s.p, '[');
    address_register(s, "base", a.base, ?first);
    address_register(s, "index", a.index, ?first);
    address_register(s, "segment", a.segment, ?first);
    number_field(s, "scale", a.scale::u64, ?first);
    if (a.disp != 0 || first) {
        field(s, "disp", ?first);
        signed(s, a.disp);
    }
    number_field(s, "mode", a.mode::u64, ?first);
    number_field(s, "extend", a.extend::u64, ?first);
    number_field(s, "broadcast", a.broadcast::u64, ?first);
    val sym: opt[Reference] = a.symbol;
    if (sel sym.some) {
        field(s, "symbol", ?first);
        reference(s, sym.some);
    }
    printer.byte(s.p, ']');
}

fun operand(s: *State, o: Operand) {
    if (sel o.virtual)   { virtual(s, o.virtual.index); }
    or (sel o.physical)  { physical(s, o.physical); }
    or (sel o.immediate) { signed(s, o.immediate); }
    or (sel o.slot) {
        printer.text(s.p, "%s");
        printer.number(s.p, o.slot.index::u64);
    }
    or (sel o.symbol) { reference(s, o.symbol); }
    or (sel o.block) {
        printer.text(s.p, "%b");
        printer.number(s.p, o.block.index::u64);
    }
    or (sel o.tied) {
        register(s, o.tied.dest);
        printer.text(s.p, " = ");
        register(s, o.tied.source);
    }
    or (sel o.partner) {
        if (o.partner.kind == nil) {
            fail(s, NO_KIND);
            ret;
        }
        printer.text(s.p, "partner(");
        printer.number(s.p, o.partner.label::u64);
        printer.text(s.p, ", ");
        printer.word(s.p, o.partner.kind.name);
        printer.byte(s.p, ')');
    }
    or (sel o.address) { address(s, o.address); }
    or (sel o.list) {
        printer.text(s.p, "list(");
        register(s, o.list.first);
        printer.text(s.p, ", ");
        printer.number(s.p, o.list.count::u64);
        printer.byte(s.p, ')');
    }
    or (sel o.literal) {
        printer.text(s.p, "bytes(");
        var i: u32 = 0;
        for (i < o.literal.len) {
            if (i != 0) { printer.text(s.p, ", "); }
            printer.number(s.p, o.literal.at[i]::u64);
            i = i + 1;
        }
        printer.byte(s.p, ')');
    }
    or (sel o.member) {
        virtual(s, o.member.virtual.index);
        printer.byte(s.p, '[');
        printer.number(s.p, o.member.index::u64);
        printer.byte(s.p, ']');
    }
}

fun opcode(s: *State, op: Opcode) {
    if (sel op.pseudo) {
        val r: opt[*pseudo.Row] = pseudo.row(op.pseudo);
        if (sel r.none) {
            fail(s, NO_PSEUDO);
            ret;
        }
        printer.text(s.p, "pseudo ");
        printer.word(s.p, r.some.name);
        ret;
    }
    or (sel op.loop) {
        printer.text(s.p, "loop ");
        printer.word(s.p, op.loop.name);
        ret;
    }
    or (sel op.inline) {
        printer.text(s.p, "asm ");
        printer.string(s.p, op.inline.block.text);
        ret;
    }
    var found: opt[u32] = opt[u32].none{};
    if (s.env.set.codec != nil) { found = mindex.find_view(?s.env.set.codec.keys, View{data: op.row.key, len: str_len(op.row.key)}, false); }
    if (!(sel found.some && ?s.env.set.codec.rows.at[found.some] == op.row)) {
        fail(s, NO_ROW);
        ret;
    }
    spell(s.p, op.row.key);
}

# the locations an instruction states it reads, or writes, after its word,
# nothing when it states none
fun implied(s: *State, d: *InstructionData, write: bool, word: str) {
    var first: bool  = true;
    var k:     usize = 0;
    for (k < d.implicit.size) {
        if (d.implicit.data[k].write == write) {
            if (first) {
                printer.byte(s.p, ' ');
                printer.text(s.p, word);
                printer.text(s.p, " [");
            }
            or { printer.text(s.p, ", "); }
            physical(s, d.implicit.data[k].location);
            first = false;
        }
        k = k + 1;
    }
    if (!first) { printer.byte(s.p, ']'); }
}

# the configuration state an instruction states, after the name the set's
# hooks give it, nothing when it states none
fun state(s: *State, d: *InstructionData) {
    if (sel d.state.none) { ret; }
    if (s.env.set.config == nil) {
        fail(s, NO_STATE);
        ret;
    }
    var spelled: vector.Vector[u8] = vector.init[u8](s.p.m.a);
    fin { vector.dnit[u8](?spelled); }
    val wrote: err[allocator.Error] = vstate.spell(s.env.set.config, d.state.some, ?spelled);
    if (sel wrote.err) {
        fail(s, NO_STATE);
        ret;
    }
    printer.byte(s.p, ' ');
    printer.text(s.p, s.env.set.config.name);
    printer.byte(s.p, ' ');
    printer.bytes(s.p, View{data: spelled.data, len: spelled.len});
}

# where a piece travels, its register spelled by the register file, as the
# ir text writes a place
fun placed(s: *State, at: Placed) {
    val place: Place = at.place;
    printer.byte(s.p, '{');
    if (sel place.register) {
        printer.text(s.p, "reg(");
        register_name(s, place.register);
        printer.byte(s.p, ')');
    }
    or (sel place.stack) {
        printer.text(s.p, "stack(");
        printer.number(s.p, place.stack.offset);
        if (sel place.stack.scale.scaled) {
            printer.text(s.p, ", scaled ");
            printer.number(s.p, place.stack.scale.scaled::u64);
        }
        printer.byte(s.p, ')');
    }
    or (sel place.operand) {
        printer.text(s.p, "operand(");
        printer.number(s.p, place.operand::u64);
        printer.byte(s.p, ')');
    }
    if (sel at.scale.scaled) {
        printer.text(s.p, ", scaled(");
        printer.number(s.p, at.scale.scaled::u64);
        printer.byte(s.p, ')');
    }
    or { printer.text(s.p, ", fixed"); }
    printer.text(s.p, ", ");
    fill(s.p, at.fill);
    printer.byte(s.p, '}');
}

# a bracketed list of places
fun places(s: *State, list: Slice[Placed]) {
    printer.byte(s.p, '[');
    var k: usize = 0;
    for (k < list.size) {
        if (k > 0) { printer.text(s.p, ", "); }
        placed(s, list.data[k]);
        k = k + 1;
    }
    printer.byte(s.p, ']');
}

# the decorators of an instruction's flags, each before it
fun flags(s: *State, md: Metadata, declassifies: bool) {
    if (md.flags.volatile) { printer.text(s.p, "#[volatile] "); }
    if (md.flags.kept)     { printer.text(s.p, "#[kept] "); }
    if (md.flags.bounded)  { printer.text(s.p, "#[bounded] "); }
    if (md.flags.checked)  { printer.text(s.p, "#[checked] "); }
    if (md.flags.public)   { printer.text(s.p, "#[public] "); }
    if (md.secret)         { printer.text(s.p, "#[secret] "); }
    if (declassifies)      { printer.text(s.p, "#[declassifies] "); }
}

fun instruction(s: *State, d: *InstructionData) {
    printer.text(s.p, "    ");
    flags(s, d.metadata, d.declassifies);
    opcode(s, d.opcode);
    printer.byte(s.p, '(');
    var k: usize = 0;
    for (k < d.operands.size) {
        if (k > 0) { printer.text(s.p, ", "); }
        operand(s, d.operands.data[k]);
        k = k + 1;
    }
    printer.byte(s.p, ')');
    state(s, d);
    implied(s, d, false, "reads");
    implied(s, d, true, "writes");
    if (d.places.size > 0) {
        printer.text(s.p, " places ");
        places(s, d.places);
    }
    if (d.label != NO_LABEL) {
        printer.text(s.p, " label ");
        printer.number(s.p, d.label::u64);
    }
    metadata(s.p, d.metadata);
    printer.byte(s.p, ';');
    printer.newline(s.p);
}

# an argument area and the offset into it, its scaled bytes after `per`
fun argued(s: *State, word: str, at: Argued) {
    printer.text(s.p, ", ");
    printer.text(s.p, word);
    printer.byte(s.p, ' ');
    printer.number(s.p, at.fixed);
    if (at.per != 0) {
        printer.text(s.p, " per ");
        printer.number(s.p, at.per);
    }
}

# whether a slot's argument area offset scales, so its scale is written
fun scaled_area(a: Area) bool {
    if (sel a.incoming) { ret a.incoming.per != 0; }
    if (sel a.outgoing) { ret a.outgoing.per != 0; }
    ret false;
}

fun slot(s: *State, k: usize, d: *SlotData) {
    printer.text(s.p, "    slot %s");
    printer.number(s.p, k::u64);
    printer.text(s.p, ": size ");
    printer.number(s.p, d.size);
    if (d.per != 0 || scaled_area(d.area)) {
        printer.text(s.p, " per ");
        printer.number(s.p, d.per);
        printer.text(s.p, " scale ");
        printer.number(s.p, d.scale::u64);
    }
    printer.text(s.p, ", align ");
    printer.number(s.p, d.align);
    val area: Area = d.area;
    if (sel area.incoming) { argued(s, "incoming", area.incoming); }
    if (sel area.outgoing) { argued(s, "outgoing", area.outgoing); }
    if (d.addressed)       { printer.text(s.p, ", addressed"); }
    if (d.secret)          { printer.text(s.p, ", secret"); }
    printer.byte(s.p, ';');
    printer.newline(s.p);
}

fun body(s: *State, f: *Function) {
    var k: usize = 0;
    for (k < f.virtuals.len) {
        printer.text(s.p, "    var ");
        virtual(s, k::u32);
        printer.text(s.p, ": ");
        class_ref(s, f.virtuals.data[k]);
        printer.byte(s.p, ';');
        printer.newline(s.p);
        k = k + 1;
    }
    k = 0;
    for (k < f.slots.len) {
        slot(s, k, ?f.slots.data[k]);
        k = k + 1;
    }
    k = 0;
    for (k < f.blocks.len) {
        printer.text(s.p, "%b");
        printer.number(s.p, k::u64);
        printer.byte(s.p, ':');
        printer.newline(s.p);
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            instruction(s, function.data(f, list.data[i]));
            i = i + 1;
        }
        k = k + 1;
    }
}

fun write(w: *io.Writer, m: *Module, env: *Env, items: Slice[Item]) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    printer.header(?p);
    var file: *rf.File = nil;
    if (env.set.codec != nil) { file = env.set.codec.registers; }
    var s: State = State{p: ?p, env: env, file: file};
    var i: usize = 0;
    for (i < items.size) {
        printer.apart(?p);
        val entry: opt[Slice[Placed]] = items.data[i].function.entry;
        if (sel entry.some) {
            printer.text(?p, "#[placed(");
            places(?s, entry.some);
            printer.text(?p, ")] ");
        }
        printer.text(?p, "fun ");
        printer.symbol(?p, items.data[i].symbol);
        printer.text(?p, " {");
        printer.newline(?p);
        body(?s, ?items.data[i].function);
        printer.byte(?p, '}');
        printer.newline(?p);
        i = i + 1;
    }
    val failed: opt[printer.Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{Error.text{failed.some}}; }
    ret err[Error].ok{};
}

# write the text of the machine functions of a module
# ---
# w:     the writer the text goes to
# m:     the module the functions' symbols and metadata name entries of, whose
#        target gives the instruction set
# isas:  the registry whose record of that set gives its memory-backed classes
# items: the functions
# ret:   ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module, isas: *Isas, items: Slice[Item]) err[Error] {
    val env: res[Env, Failure] = resolve.of(m, isas);
    if (sel env.err) { ret err[Error].err{Error.target{env.err}}; }
    var e: Env = env.ok;
    ret write(w, m, ?e, items);
}
