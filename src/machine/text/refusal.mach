# why the reader of the machine form text refused a text, and where
#
# the text is read through the reader of the ir text form, whose refusals
# stand as they are. a refusal of the machine form's own is kept here, so the
# ir text form names nothing of the machine form.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use ir_refusal: mirl.ir.text.parse.refusal;
use mirl.machine.function;
use mirl.machine.text.resolve.Failure;

# why a machine form text was refused
# ---
# text:    the reader of the ir text form refused it
# unfiled: a register named for an instruction set with no register file, as
#          the text spells it: a view of the text
# machine: the machine form refused an instruction, class or storage
# target:  the module's target gives no environment for a machine form text
pub tag Reason: u8 {
    text:    ir_refusal.Reason;
    unfiled: View;
    machine: function.Error;
    target:  Failure;
}

# a refusal
# ---
# line:   the line of the text, from one
# column: the byte on that line, from one
# reason: why
pub rec Refusal {
    line:   u32;
    column: u32;
    reason: Reason;
}

# a refusal of the reader of the ir text form, as the machine form's
pub fun of_text(r: ir_refusal.Refusal) Refusal {
    ret Refusal{line: r.line, column: r.column, reason: Reason.text{r.reason}};
}

fun keep(first: *err[WriteError], r: err[WriteError]) {
    if (sel r.err && sel first.ok) { @first = r; }
}

fun put(first: *err[WriteError], w: *io.Writer, s: str) {
    val r: res[usize, WriteError] = format.write_str(w, s);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_number(first: *err[WriteError], w: *io.Writer, n: u64) {
    val r: res[usize, WriteError] = format.write_u64(w, n);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_name(first: *err[WriteError], w: *io.Writer, v: View) {
    val r: res[usize, WriteError] = format.write_bytes(w, v.data, v.len);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

# write why a text was refused, as the reason alone
pub fun reason(w: *io.Writer, why: Reason) err[WriteError] {
    if (sel why.text) { ret ir_refusal.reason(w, why.text); }
    var first: err[WriteError] = err[WriteError].ok{};
    if (sel why.unfiled) {
        put(?first, w, "register \"");
        put_name(?first, w, why.unfiled);
        put(?first, w, "\" is named for an instruction set with no register file");
    }
    or (sel why.machine) {
        put(?first, w, "the machine function refused the request");
        val e: function.Error = why.machine;
        if (sel e.refused) {
            put(?first, w, ": ");
            put(?first, w, e.refused.what);
        }
    }
    or (sel why.target) {
        val f: Failure = why.target;
        if (sel f.target) {
            put(?first, w, "no target is the module's tuple:");
            val parts: [4]View = [4]View{f.target.arch, f.target.system, f.target.convention, f.target.baseline};
            var i:     usize   = 0;
            for (i < 4) {
                put(?first, w, " \"");
                put_name(?first, w, parts[i]);
                put(?first, w, "\"");
                i = i + 1;
            }
        }
        or (sel f.arch) { put(?first, w, "the target's architecture is no row of the catalog"); }
        or (sel f.unregistered) {
            put(?first, w, "no instruction set is registered for the architecture ");
            put(?first, w, f.unregistered);
        }
        or (sel f.memory) {
            put(?first, w, "a memory class has no name or a name another has: ");
            put(?first, w, f.memory);
        }
        or (sel f.loop) {
            put(?first, w, "a loop has no name, a name another has or breaks the schema of a loop: ");
            put(?first, w, f.loop);
        }
        or { put(?first, w, "out of memory"); }
    }
    ret first;
}

# write a refusal as `line:column: reason`
pub fun describe(w: *io.Writer, r: Refusal) err[WriteError] {
    var first: err[WriteError] = err[WriteError].ok{};
    put_number(?first, w, r.line::u64);
    put(?first, w, ":");
    put_number(?first, w, r.column::u64);
    put(?first, w, ": ");
    keep(?first, reason(w, r.reason));
    ret first;
}
