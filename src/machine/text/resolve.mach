# what the names of a machine form text mean, resolved from a target
#
# a target's instruction set is the one masc's registry serves its
# architecture with, and its memory-backed classes are the ones of that set's
# record in the registry of mirl.machine.isa records the caller hands in, none
# when it carries no record of the set. an architecture no set serves is
# refused, naming it, and no other environment stands in for it.

use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mset:     masc.core.set;
use masc_isa: masc.isa;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.machine.class.Memory;
use mirl.machine.isa;
use mirl.machine.isa.Isa;
use mirl.machine.isa.Isas;
use mirl.machine.text.item.Env;
use mirl.target.assemble;
use mirl.target.record.Target;

# why a text's environment could not be resolved
# ---
# target:       the module's tuple is no row of the target table, as the
#               module spells it
# unregistered: no registered instruction set serves the architecture, named
# alloc:        the allocator refused storage
pub tag Error: u8 {
    target:       module.Tuple;
    unregistered: str;
    alloc:        allocator.Error;
}

# the environment of a module's target, through masc's registry and the
# record of the set in `isas`
pub fun of(m: *Module, isas: *Isas) res[Env, Error] {
    val res_named: res[Target, assemble.Error] = assemble.assemble(m.a, module.target(m));
    if (sel res_named.err) {
        if (sel res_named.err.alloc) { ret res[Env, Error].err{Error.alloc{res_named.err.alloc}}; }
        ret res[Env, Error].err{Error.target{module.target(m)}};
    }
    var own: Target = res_named.ok;
    fin { assemble.dnit(m.a, ?own); }
    val opt_found: opt[*mset.Set] = masc_isa.find(?masc_isa.REGISTRY, own.arch);
    if (sel opt_found.none) { ret res[Env, Error].err{Error.unregistered{own.arch.name}}; }
    val opt_carried: opt[*Isa] = isa.of(isas, opt_found.some);
    if (sel opt_carried.none) { ret res[Env, Error].ok{Env{set: opt_found.some, memories: Slice[Memory]{data: nil, size: 0}}}; }
    ret res[Env, Error].ok{Env{set: opt_found.some, memories: opt_carried.some.memories}};
}
