# what the names of a machine form text mean, resolved from a target
#
# a target's instruction set is the one masc's registry serves its
# architecture with, its memory-backed classes are the ones its record
# supplies, and its loops are the ones mirl carries for that set.
# nothing else builds the environment of a text, so a set masc registers later
# reads and prints with no change here. an architecture no set serves is
# refused, naming it, and no other environment stands in for it.

use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use std.allocator;

use mirl.isa.loops;

use mset: masc.core.set;
use masc.isa.isa;
use arches: mink.catalog.arch;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.machine.text.item.Env;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.record;

# why a text's environment could not be resolved
# ---
# target:       the module's target is in no row of the target table, as the
#               module spells it
# arch:         the target's architecture is no row of mink's catalog
# unregistered: no registered instruction set serves the architecture, named
# memory:       two memory-backed classes of the target share a name, or one
#               has none, the name as the target states it
# loop:         two loops of the set share a name, or one has none or breaks
#               the schema of a loop, the name as the loop states it
# alloc:        the allocator refused storage
pub tag Failure: u8 {
    target:       View;
    arch:         record.Error;
    unregistered: str;
    memory:       str;
    loop:         str;
    alloc:        allocator.Error;
}

# the environment of a text of an architecture and the target that supplies it
# ---
# registry: the instruction sets, searched by architecture
# arch:     the architecture row
# t:        the target, whose memory-backed classes the text names
# ret:      the environment, or why the architecture has none
pub fun resolve(registry: *mset.Registry, arch: *arches.Arch, t: *Target) res[Env, Failure] {
    val found: opt[*mset.Set] = mset.find(registry, arch);
    if (sel found.none) { ret res[Env, Failure].err{Failure.unregistered{arch.name}}; }
    ret res[Env, Failure].ok{Env{set: found.some, memories: t.memories, loops: loops.of(found.some)}};
}

# the environment of a module's target, through masc's registry
pub fun of(m: *Module) res[Env, Failure] {
    val row: opt[*Target] = targets.by_name(module.target(m));
    if (sel row.none) { ret res[Env, Failure].err{Failure.target{module.target(m)}}; }
    val arch: res[*arches.Arch, record.Error] = targets.arch(row.some);
    if (sel arch.err) { ret res[Env, Failure].err{Failure.arch{arch.err}}; }
    ret resolve(?isa.REGISTRY, arch.ok, row.some);
}
