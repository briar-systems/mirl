# what the names of a machine form text mean, resolved from a target
#
# a target's instruction set is the one masc's registry serves its
# architecture with, and its memory-backed classes are the ones of that set's
# record in the registry of mirl.machine.isa records the caller hands in, none
# when it carries no record of the set. an architecture no set serves is
# refused, naming it, and no other environment stands in for it.

use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mset:     masc.core.set;
use masc_isa: masc.isa.isa;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.machine.class.Memory;
use mirl.machine.isa;
use mirl.machine.isa.Isa;
use mirl.machine.isa.Isas;
use mirl.machine.text.item.Env;
use targets: mirl.target;
use mirl.target.Target;

# why a text's environment could not be resolved
# ---
# target:       the module's tuple is no row of the target table, as the
#               module spells it
# unregistered: no registered instruction set serves the architecture, named
# alloc:        the allocator refused storage
pub tag Failure: u8 {
    target:       module.Tuple;
    unregistered: str;
    alloc:        allocator.Error;
}

# the environment of a module's target, through masc's registry and the
# record of the set in `isas`
pub fun of(m: *Module, isas: *Isas) res[Env, Failure] {
    val named: res[Target, targets.Refusal] = targets.assemble(m.a, module.target(m));
    if (sel named.err) {
        if (sel named.err.alloc) { ret res[Env, Failure].err{Failure.alloc{named.err.alloc}}; }
        ret res[Env, Failure].err{Failure.target{module.target(m)}};
    }
    var own: Target = named.ok;
    fin { targets.release(m.a, ?own); }
    val found: opt[*mset.Set] = mset.find(?masc_isa.REGISTRY, own.arch);
    if (sel found.none) { ret res[Env, Failure].err{Failure.unregistered{own.arch.name}}; }
    val carried: opt[*Isa] = isa.of(isas, found.some);
    if (sel carried.none) { ret res[Env, Failure].ok{Env{set: found.some, memories: Slice[Memory]{data: nil, size: 0}}}; }
    ret res[Env, Failure].ok{Env{set: found.some, memories: carried.some.memories}};
}
