# what a machine form text is made of and printed against

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view_eq_str;

use std.collections.slice.Slice;

use mirl.ir.id.Symbol;
use mirl.machine.class.Memory;
use mirl.machine.function.Function;

use mset: masc.core.set;

# what the names of a text mean, made only by `resolve` from a target
# ---
# set:      the instruction set of the text's target, whose register file and
#           catalog spell every register and instruction
# memories: the memory-backed classes the target supplies, each spelled by the
#           name it states
pub rec Env {
    set:      *mset.Set;
    memories: Slice[Memory];
}

# one machine function of a text
# ---
# symbol:   the function of the module it is the code of
# function: its machine form
pub rec Item {
    symbol:   Symbol;
    function: Function;
}

# every word the grammar gives a meaning where a register, class or
# instruction's name could stand, which the printer then writes quoted
pub val WORDS: [21]str = [21]str{"fun", "var", "slot", "memory", "pseudo", "loop", "asm", "reads", "writes", "places", "label", "at", "in", "holds", "partner", "list", "bytes", "size", "align", "incoming", "outgoing"};

# whether a name is one of the grammar's words
pub fun reserved(name: View) bool {
    var k: usize = 0;
    for (k < $length_of(WORDS)) {
        if (view_eq_str(name, WORDS[k])) { ret true; }
        k = k + 1;
    }
    ret false;
}
