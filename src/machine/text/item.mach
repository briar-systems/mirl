# what a machine form text is made of and read against

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;
use std.types.view.view_eq_str;

use std.collections.slice.Slice;

use mirl.ir.id.Symbol;
use mirl.machine.class.Memory;
use mirl.machine.function.Function;

use mset: masc.core.set;

# what the names of a text mean, made only by `resolve` from a target
# ---
# set:      the instruction set of the text's target, whose register file and
#           catalog spell every register and instruction
# memories: the memory-backed classes the target supplies, each spelled by the
#           name it states
pub rec Env {
    set:      *mset.Set;
    memories: Slice[Memory];
}

# one machine function of a text
# ---
# symbol:   the function of the module it is the code of
# function: its machine form
pub rec Item {
    symbol:   Symbol;
    function: Function;
}

# the keywords the grammar reads, each spelled once here
# ---
# every one is a row of KEYWORDS, the one list the parser and the printer both
# read, and the parser names keywords only by these handles
pub val KW_FUNCTION:     str = "function";
pub val KW_VIRTUAL:      str = "virtual";
pub val KW_SLOT:         str = "slot";
pub val KW_CLASS:        str = "class";
pub val KW_MEMORY:       str = "memory";
pub val KW_SIZE:         str = "size";
pub val KW_ALIGN:        str = "align";
pub val KW_PSEUDO:       str = "pseudo";
pub val KW_LOC:          str = "loc";
pub val KW_SITE:         str = "site";
pub val KW_VOLATILE:     str = "volatile";
pub val KW_SECRET:       str = "secret";
pub val KW_BIND:         str = "bind";
pub val KW_KEPT:         str = "kept";
pub val KW_DECLASSIFIES: str = "declassifies";

# every word the grammar reads as a keyword
pub val KEYWORDS: [15]str = [15]str{KW_FUNCTION, KW_VIRTUAL, KW_SLOT, KW_CLASS, KW_MEMORY, KW_SIZE, KW_ALIGN, KW_PSEUDO, KW_LOC, KW_SITE, KW_VOLATILE, KW_SECRET, KW_BIND, KW_KEPT, KW_DECLASSIFIES};

# whether a word is one the grammar reads as a keyword where an instruction
# or operand could stand, which the printer then writes quoted
pub fun reserved(name: View) bool {
    var k: usize = 0;
    for (k < $length_of(KEYWORDS)) {
        if (view_eq_str(name, KEYWORDS[k])) { ret true; }
        k = k + 1;
    }
    ret false;
}

test reserved__every_keyword_row_is_reserved {
    var k: usize = 0;
    for (k < $length_of(KEYWORDS)) {
        val v: View = View{data: KEYWORDS[k], len: str_len(KEYWORDS[k])};
        if (!reserved(v)) { ret 1; }
        k = k + 1;
    }
    if (reserved(View{data: "add", len: 3})) { ret 2; }
    ret 0;
}
