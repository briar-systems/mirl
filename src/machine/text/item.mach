# what a machine form text is made of and read against

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;
use std.types.view.view_eq_str;

use std.collections.slice.Slice;

use mirl.ir.id.Symbol;
use mirl.machine.class.Memory;
use mirl.machine.function.Function;

use mset: masc.core.set;

# what the names of a text mean
# ---
# set:      the instruction set of the text's target, whose register file and
#           catalog spell every register and instruction
# memories: the memory-backed classes the target supplies, a text naming one by
#           its place in this list
pub rec Env {
    set:      *mset.Set;
    memories: Slice[*Memory];
}

# one machine function of a text
# ---
# symbol:   the function of the module it is the code of
# function: its machine form
pub rec Item {
    symbol:   Symbol;
    function: Function;
}

# every word the grammar reads as a keyword, the one list the parser and the
# printer both read
pub val KEYWORDS: [15]str = [15]str{"function", "virtual", "slot", "class", "memory", "size", "align", "pseudo", "loc", "site", "volatile", "secret", "bind", "kept", "declassifies"};

# whether a word is one the grammar reads as a keyword where an instruction
# or operand could stand, which the printer then writes quoted
pub fun reserved(name: View) bool {
    var k: usize = 0;
    for (k < $length_of(KEYWORDS)) {
        if (view_eq_str(name, KEYWORDS[k])) { ret true; }
        k = k + 1;
    }
    ret false;
}

test reserved__declassifies_and_kept_are_keyword_names {
    if (!reserved(View{data: "declassifies", len: 12})) { ret 1; }
    if (!reserved(View{data: "kept", len: 4}))          { ret 2; }
    ret 0;
}
