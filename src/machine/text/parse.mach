fwd refusal.Refusal;

# the functions a text holds
# ---
# a:     the allocator the functions take
# items: the functions, in the order of the text
pub rec Unit {
    a:     *allocator.Allocator;
    items: vector.Vector[Item];
}

# give back a unit's functions
pub fun dnit(u: *Unit) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < u.items.len) {
        val r: err[allocator.Error] = function.dnit(?u.items.data[i].function);
        if (sel r.err && sel failed.ok) { failed = r; }
        i = i + 1;
    }
    val r: err[allocator.Error] = vector.dnit[Item](?u.items);
    if (sel r.err && sel failed.ok) { failed = r; }
    ret failed;
}

# one instruction line of a function
# ---
# at:    the start of the line
# block: the block it stands in
rec Line {
    at:    Mark;
    block: u32;
}

# what one reading is made against
# ---
# p:      the parser
# env:    what the names mean
# x:      the indexed names of the set
# failed: the first refusal of the machine form's own, none while the
#         parser's refusal, if any, is the ir text form's
rec Reading {
    p:      *Parser;
    env:    *Env;
    x:      *Index;
    failed: opt[Refusal];
}

fun hash_name(v: *View) u64 {
    ret slice.hash_view(0xcbf29ce484222325, @v);
}

fun same_name(a: *View, b: *View) bool {
    ret slice.same_view(@a, @b);
}

# refuse in the machine form's own terms, unless a refusal is already kept
fun refuse(r: *Reading, line: u32, column: u32, why: Why) {
    if (state.ok(r.p)) { r.failed = opt[Refusal].some{Refusal{line: line, column: column, reason: why}}; }
    state.fail_at(r.p, line, column, Reason.form{});
}

fun unknown(p: *Parser, what: str, t: Token) {
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: what, name: t.raw}});
}

# the relocation kind a fixup of the environment's set becomes that is spelled
# as `t`, nil and refused when the set binds none of that name
fun kind_named(r: *Reading, t: Token) *reloc.Kind {
    val p: *Parser = r.p;
    var i: u32     = 0;
    for (i < r.env.set.bindings.len) {
        val k: *reloc.Kind = r.env.set.bindings.at[i].kind;
        if (k != nil && slice.same_view(View{data: k.name, len: str_len(k.name)}, t.text)) { ret k; }
        i = i + 1;
    }
    unknown(p, "relocation kind", t);
    ret nil;
}

fun class_of(r: *Reading) Class {
    val p:    *Parser = r.p;
    var none: Class   = Class.memory{nil};
    if (accept_kw(p, item.KW_CLASS)) {
        val t: Token = state.name(p, "a class name");
        if (!state.ok(p)) { ret none; }
        val at: opt[u16] = index.class_named(r.x, t.text);
        if (sel at.none) {
            unknown(p, "register class", t);
            ret none;
        }
        ret class.hardware(r.x.file, at.some);
    }
    if (accept_kw(p, item.KW_MEMORY)) {
        val t: Token = state.name(p, "a memory class name");
        if (!state.ok(p)) { ret none; }
        val at: opt[*class.Memory] = index.memory_named(r.x, t.text);
        if (sel at.none) {
            unknown(p, "memory class", t);
            ret none;
        }
        ret Class.memory{at.some};
    }
    state.expected(p, "class or memory");
    ret none;
}

fun memory_cell(r: *Reading) Physical {
    val p: *Parser = r.p;
    state.expect(p, lexer.LBRACE, "{");
    val c:  Token = state.name(p, "a memory class name");
    var at: opt[*class.Memory];
    if (state.ok(p)) {
        at = index.memory_named(r.x, c.text);
        if (sel at.none) { unknown(p, "memory class", c); }
    }
    state.expect(p, lexer.COLON, ":");
    val n: u32 = state.number32(p);
    state.expect(p, lexer.RBRACE, "}");
    if (!state.ok(p)) { ret Physical.cell{class.Cell{class: nil, number: 0}}; }
    if (sel at.none)  { ret Physical.cell{class.Cell{class: nil, number: 0}}; }
    ret Physical.cell{class.Cell{class: at.some, number: n}};
}

fun register(r: *Reading) Register {
    val p: *Parser = r.p;
    val t: Token   = p.tok;
    if (t.kind == lexer.LOCAL) {
        state.advance(p);
        ret Register.virtual{Virtual{index: state.resolve(p, ?p.values, "virtual register", t)}};
    }
    if (t.kind == lexer.LBRACE) { ret Register.physical{memory_cell(r)}; }
    if (t.kind == lexer.WORD || t.kind == lexer.STRING) {
        state.advance(p);
        val id: res[rf.Id, index.Unspelled] = index.register_named(r.x, t.text);
        if (sel id.err) {
            if (sel id.err.unfiled) { refuse(r, t.line, t.column, Why.unfiled{t.raw}); }
            or                      { unknown(p, "register", t); }
            ret Register.physical{Physical.register{rf.NONE}};
        }
        ret Register.physical{Physical.register{id.ok}};
    }
    state.expected(p, "a register");
    ret Register.physical{Physical.register{rf.NONE}};
}

fun symbol(r: *Reading) Operand {
    val p: *Parser = r.p;
    val t: Token   = state.expect(p, lexer.SYMBOL, "a symbol");
    var a: Reference;
    if (!state.ok(p)) { ret Operand.immediate{0}; }
    val found: opt[Symbol] = module.find(p.m, t.text);
    if (sel found.none) {
        state.fail_at(p, t.line, t.column, Reason.unresolved{Named{what: "symbol", name: t.raw}});
        ret Operand.immediate{0};
    }
    a.symbol = found.some;
    a.addend = 0;
    if (state.is(p, lexer.PLUS) || state.is(p, lexer.MINUS)) {
        val negative: bool = state.is(p, lexer.MINUS);
        state.advance(p);
        val n: u64 = state.number(p);
        if (n > 0x7fffffffffffffff && !(negative && n == 0x8000000000000000)) { state.fail(p, Reason.large{}); }
        if (negative)                                                         { a.addend = (~n + 1)::i64; }
        or                                                                    { a.addend = n::i64; }
    }
    state.expect(p, lexer.COLON, ":");
    val k: Token = state.name(p, "a relocation kind");
    a.kind = kind_named(r, k);
    ret Operand.symbol{a};
}

fun immediate(p: *Parser) Operand {
    var negative: bool = false;
    if (state.accept(p, lexer.MINUS)) { negative = true; }
    val line: u32 = p.tok.line;
    val col:  u32 = p.tok.column;
    val n:    u64 = state.number(p);
    if (negative) {
        if (n > 0x8000000000000000) { state.fail_at(p, line, col, Reason.large{}); }
        ret Operand.immediate{(~n + 1)::i64};
    }
    if (n > 0x7fffffffffffffff) { state.fail_at(p, line, col, Reason.large{}); }
    ret Operand.immediate{n::i64};
}

# a signed number, a minus before it negating it
fun signed(p: *Parser) i64 {
    val o: Operand = immediate(p);
    if (sel o.immediate) { ret o.immediate; }
    ret 0;
}

# one field of an address, by its name
fun address_field(r: *Reading, a: *Address, t: Token) {
    val p: *Parser = r.p;
    if (lexer.spelled(t.text, "base"))      { a.base = opt[Register].some{register(r)}; }
    or (lexer.spelled(t.text, "index"))     { a.index = opt[Register].some{register(r)}; }
    or (lexer.spelled(t.text, "segment"))   { a.segment = opt[Register].some{register(r)}; }
    or (lexer.spelled(t.text, "scale"))     { a.scale = state.number32(p)::u8; }
    or (lexer.spelled(t.text, "disp"))      { a.disp = signed(p); }
    or (lexer.spelled(t.text, "mode"))      { a.mode = state.number32(p)::u8; }
    or (lexer.spelled(t.text, "extend"))    { a.extend = state.number32(p); }
    or (lexer.spelled(t.text, "broadcast")) { a.broadcast = state.number32(p)::u8; }
    or (lexer.spelled(t.text, "symbol")) {
        val o: Operand = symbol(r);
        if (sel o.symbol) { a.symbol = opt[Reference].some{o.symbol}; }
    }
    or { unknown(p, "address field", t); }
}

# an address, its fields by name between brackets, each at most once and any
# left out its zero: `[base: %0, index: %1, scale: 2, disp: -8]`
fun address(r: *Reading) Operand {
    val p: *Parser = r.p;
    var a: Address = Address{base: opt[Register].none{}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: 0, symbol: opt[Reference].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0};
    for {
        val t: Token = state.name(p, "an address field");
        state.expect(p, lexer.COLON, ":");
        if (!state.ok(p)) { brk; }
        address_field(r, ?a, t);
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
    state.expect(p, lexer.RBRACKET, "]");
    ret Operand.address{a};
}

# a list, its first member and how many members, between parentheses:
# `(v8, 3)`
fun list(r: *Reading) Operand {
    val p:     *Parser  = r.p;
    val first: Register = register(r);
    state.expect(p, lexer.COMMA, ",");
    val count: u32 = state.number32(p);
    state.expect(p, lexer.RPAREN, ")");
    if (count > 0xff) { state.fail(p, Reason.large{}); }
    ret Operand.list{List{first: first, count: count::u8}};
}

fun operand(r: *Reading) Operand {
    val p: *Parser    = r.p;
    val k: lexer.Kind = p.tok.kind;
    if (accept_kw(p, item.KW_PARTNER)) {
        val n: u32 = state.number32(p);
        state.expect(p, lexer.COLON, ":");
        val t: Token = state.name(p, "a relocation kind");
        ret Operand.partner{Partner{label: n, kind: kind_named(r, t)}};
    }
    if (k == lexer.LOCAL || k == lexer.WORD || k == lexer.STRING || k == lexer.LBRACE) {
        val dest: Register = register(r);
        if (!state.accept(p, lexer.EQUALS)) {
            if (sel dest.virtual) { ret Operand.virtual{dest.virtual}; }
            ret Operand.physical{dest.physical};
        }
        ret Operand.tied{Tied{dest: dest, source: register(r)}};
    }
    if (k == lexer.UINT || k == lexer.MINUS) { ret immediate(p); }
    if (k == lexer.LPAREN) {
        state.advance(p);
        ret list(r);
    }
    if (k == lexer.LBRACKET) {
        state.advance(p);
        if (!state.is(p, lexer.UINT)) { ret address(r); }
        val n: u32 = state.number32(p);
        state.expect(p, lexer.RBRACKET, "]");
        ret Operand.slot{Slot{index: n}};
    }
    if (k == lexer.LABEL) {
        val t: Token = p.tok;
        state.advance(p);
        ret Operand.block{Block{index: state.resolve(p, ?p.blocks, "block", t)}};
    }
    if (k == lexer.SYMBOL) { ret symbol(r); }
    state.expected(p, "an operand");
    ret Operand.immediate{0};
}

# read a keyword, one of the item.KW_ handles, if it is the next word
fun accept_kw(p: *Parser, k: str) bool {
    ret state.accept_word(p, k);
}

# whether the next word is a keyword, one of the item.KW_ handles
fun is_kw(p: *Parser, k: str) bool {
    ret state.is_word(p, k);
}

# read a keyword, one of the item.KW_ handles, or refuse
fun expect_kw(p: *Parser, k: str) {
    state.expect_word(p, k);
}

# whether the next token is a keyword, which ends an instruction's operands
fun keyword(r: *Reading) bool {
    val p: *Parser = r.p;
    var k: usize   = 0;
    for (k < $length_of(item.KEYWORDS)) {
        if (state.is_word(p, item.KEYWORDS[k])) { ret true; }
        k = k + 1;
    }
    ret r.x.config != nil && state.is_word(p, r.x.config.name);
}

# read the name of a debug entry, which is its kind's letter and its position
fun ref(p: *Parser, letter: u8, count: usize, what: str) u32 {
    val t: Token = state.expect(p, lexer.DREF, what);
    if (!state.ok(p)) { ret 0; }
    var n:    u64   = 0;
    var i:    usize = 1;
    var good: bool  = t.text.len > 1 && t.text.data[0] == letter;
    for (good && i < t.text.len) {
        val c: u8 = t.text.data[i];
        if (c < '0' || c > '9' || n > 0x0fffffff) { good = false; }
        or                                        { n = n * 10 + (c - '0')::u64; }
        i = i + 1;
    }
    if (!good || n >= count::u64) {
        state.fail_at(p, t.line, t.column, Reason.unresolved{Named{what: what, name: t.raw}});
        ret 0;
    }
    ret n::u32;
}

fun metadata(p: *Parser) Metadata {
    var md: Metadata;
    if (accept_kw(p, item.KW_LOC)) {
        md.location = opt[Location].some{Location{index: ref(p, 'l', p.m.debug.positions.len, "location")}};
    }
    if (accept_kw(p, item.KW_SITE)) {
        md.site = opt[Site].some{Site{index: ref(p, 's', p.m.debug.sites.len, item.KW_SITE)}};
    }
    if (accept_kw(p, item.KW_VOLATILE)) { md.flags.volatile = true; }
    if (accept_kw(p, item.KW_KEPT))     { md.flags.kept = true; }
    if (accept_kw(p, item.KW_SECRET))   { md.secret = true; }
    if (is_kw(p, item.KW_BIND)) {
        val t: Token = p.tok;
        state.advance(p);
        state.expect(p, lexer.LBRACKET, "[");
        var list: vector.Vector[Binding] = vector.init[Binding](p.a);
        fin { vector.dnit[Binding](?list); }
        if (!state.is(p, lexer.RBRACKET)) {
            for {
                state.push[Binding](p, ?list, Binding{index: ref(p, 'v', p.m.debug.bindings.len, "variable")});
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
        if (!state.ok(p)) { ret md; }
        val made: res[Bindings, module.Error] = module.bindings(p.m, Slice[Binding]{data: list.data, size: list.len});
        if (sel made.err) {
            state.fail_at(p, t.line, t.column, Reason.ir{made.err});
            ret md;
        }
        md.bindings = made.ok;
    }
    ret md;
}

fun opcode(r: *Reading) Opcode {
    val p:    *Parser = r.p;
    var none: Opcode  = Opcode.pseudo{pseudo.COPY};
    if (accept_kw(p, item.KW_PSEUDO)) {
        val t: Token = state.expect(p, lexer.WORD, "a pseudo-instruction");
        if (!state.ok(p)) { ret none; }
        val found: opt[pseudo.Pseudo] = pseudo.named(t.text);
        if (sel found.none) {
            unknown(p, "pseudo-instruction", t);
            ret none;
        }
        ret Opcode.pseudo{found.some};
    }
    if (accept_kw(p, item.KW_LOOP)) {
        val t: Token = state.expect(p, lexer.WORD, "a loop");
        if (!state.ok(p)) { ret none; }
        val found: opt[*Loop] = index.loop_named(r.x, t.text);
        if (sel found.none) {
            unknown(p, "loop", t);
            ret none;
        }
        ret Opcode.loop{found.some};
    }
    val t: Token = state.name(p, "an instruction");
    if (!state.ok(p)) { ret none; }
    val row: opt[*rows.Row] = index.row_keyed(r.x, t.text);
    if (sel row.none) {
        unknown(p, "instruction", t);
        ret none;
    }
    ret Opcode.row{row.some};
}

# read the locations an instruction states it reads or writes, a keyword and
# a bracketed list of physical registers, when the keyword stands next
fun implied(r: *Reading, kw: str, write: bool, out: *vector.Vector[Implicit]) {
    val p: *Parser = r.p;
    if (!accept_kw(p, kw)) { ret; }
    state.expect(p, lexer.LBRACKET, "[");
    if (!state.is(p, lexer.RBRACKET)) {
        for (state.ok(p)) {
            val t:   Token    = p.tok;
            val reg: Register = register(r);
            if (!(sel reg.physical)) {
                state.fail_at(p, t.line, t.column, Reason.expected{"a physical register"});
                ret;
            }
            state.push[Implicit](p, out, Implicit{location: reg.physical, write: write});
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACKET, "]");
}

# read the configuration state an instruction states, the name the set's
# hooks give it and the text the hooks read from the word after it, when the
# name stands next
fun vector_state(r: *Reading) opt[vstate.State] {
    val p: *Parser = r.p;
    if (r.x.config == nil || !accept_kw(p, r.x.config.name)) { ret vstate.NONE; }
    if (!state.is(p, lexer.WORD)) {
        state.fail_at(p, p.tok.line, p.tok.column, Reason.expected{"a configuration state"});
        ret vstate.NONE;
    }
    val text:  View             = p.lex.text;
    val start: usize            = (p.tok.raw.data:~u64 - text.data:~u64)::usize;
    val got:   opt[vstate.Read] = vstate.read(r.env.set, View{data: ?text.data[start], len: text.len - start});
    if (sel got.none) {
        state.fail_at(p, p.tok.line, p.tok.column, Reason.expected{"a configuration state"});
        ret vstate.NONE;
    }
    val end: usize = start + got.some.len;
    for (state.ok(p) && !state.is(p, lexer.END) && (p.tok.raw.data:~u64 - text.data:~u64)::usize < end) { state.advance(p); }
    ret opt[vstate.State].some{got.some.state};
}

# read one place: where a piece travels, its register by the register file's
# name, how its size scales and how its place is filled
fun placed(r: *Reading) Placed {
    val p:  *Parser        = r.p;
    var at: ir_place.Place = ir_place.Place.operand{0};
    if (state.accept_word(p, "register")) {
        val t:    Token    = p.tok;
        val reg:  Register = register(r);
        var held: bool     = false;
        if (sel reg.physical) {
            val loc: Physical = reg.physical;
            if (sel loc.register) {
                at   = ir_place.Place.register{loc.register};
                held = true;
            }
        }
        if (!held) { state.fail_at(p, t.line, t.column, Reason.expected{"a register of the register file"}); }
    }
    or (state.accept_word(p, "stack"))   { at = ir_place.Place.stack{ir_body.stacked(p)}; }
    or (state.accept_word(p, "operand")) { at = ir_place.Place.operand{state.number32(p)}; }
    or                                   { state.expected(p, "a register, a stack offset or an operand"); }
    var scale: ir_place.Scale = ir_place.Scale.fixed{};
    if (state.accept_word(p, "scaled")) {
        val k: u32 = state.number32(p);
        if (k > 0xff) { state.expected(p, "a scale of the register file"); }
        scale = ir_place.Scale.scaled{k::u8};
    }
    or (!state.accept_word(p, "fixed")) { state.expected(p, "fixed or scaled"); }
    ret Placed{place: at, scale: scale, fill: ir_body.fill(p)};
}

# read a keyword and a bracketed list of places when the keyword stands next,
# none when it does not
fun placements(r: *Reading, kw: str, out: *vector.Vector[Placed]) bool {
    val p: *Parser = r.p;
    if (!accept_kw(p, kw)) { ret false; }
    state.expect(p, lexer.LBRACKET, "[");
    if (!state.is(p, lexer.RBRACKET)) {
        for (state.ok(p)) {
            state.push[Placed](p, out, placed(r));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACKET, "]");
    ret true;
}

fun instruction(r: *Reading, f: *Function, ln: Line) {
    val p: *Parser = r.p;
    state.rewind(p, ln.at);
    val line:     u32                    = p.tok.line;
    val col:      u32                    = p.tok.column;
    val op:       Opcode                 = opcode(r);
    var operands: vector.Vector[Operand] = vector.init[Operand](p.a);
    var columns:  vector.Vector[u32]     = vector.init[u32](p.a);
    fin {
        vector.dnit[Operand](?operands);
        vector.dnit[u32](?columns);
    }
    if (state.ok(p) && !keyword(r) && !state.is(p, lexer.NEWLINE) && !state.is(p, lexer.END)) {
        for {
            state.push[u32](p, ?columns, p.tok.column);
            state.push[Operand](p, ?operands, operand(r));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    val stated:   opt[vstate.State]       = vector_state(r);
    var implicit: vector.Vector[Implicit] = vector.init[Implicit](p.a);
    fin { vector.dnit[Implicit](?implicit); }
    implied(r, item.KW_READS, false, ?implicit);
    implied(r, item.KW_WRITES, true, ?implicit);
    var places: vector.Vector[Placed] = vector.init[Placed](p.a);
    fin { vector.dnit[Placed](?places); }
    placements(r, item.KW_PLACES, ?places);
    var label: u32 = NO_LABEL;
    if (accept_kw(p, item.KW_LABEL)) { label = state.number32(p); }
    val md:           Metadata = metadata(p);
    val declassifies: bool     = accept_kw(p, item.KW_DECLASSIFIES);
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    val made: res[Instruction, function.Error] = function.append(f, Block{index: ln.block}, op, Slice[Operand]{data: operands.data, size: operands.len}, md, declassifies, stated);
    if (sel made.ok) {
        val listed: err[function.Error] = function.imply(f, made.ok, Slice[Implicit]{data: implicit.data, size: implicit.len});
        if (sel listed.err) { refuse(r, line, col, Why.machine{listed.err}); }
        function.label(f, made.ok, label);
        val stated: err[allocator.Error] = function.place(f, made.ok, Slice[Placed]{data: places.data, size: places.len});
        if (sel stated.err) { state.refuse_alloc(p, stated.err); }
    }
    if (sel made.err) {
        var at: u32            = col;
        val e:  function.Error = made.err;
        if (sel e.refused) {
            if (e.refused.operand::usize < columns.len) { at = columns.data[e.refused.operand]; }
        }
        if (sel e.alloc) { state.refuse_alloc(p, e.alloc); }
        or               { refuse(r, line, at, Why.machine{e}); }
    }
}

# read an offset into an argument area, its scaled bytes after `per`
fun argued(p: *Parser) Argued {
    val fixed: u64 = state.number(p);
    var per:   u64 = 0;
    if (accept_kw(p, item.KW_PER)) { per = state.number(p); }
    ret Argued{fixed: fixed, per: per};
}

# whether a slot's argument area offset scales, so its scale is read
fun scaled_area(a: Area) bool {
    if (sel a.incoming) { ret a.incoming.per != 0; }
    if (sel a.outgoing) { ret a.outgoing.per != 0; }
    ret false;
}

# read the lines of a function into its virtual registers, slots and blocks,
# and note where its instructions stand
fun declare(r: *Reading, f: *Function, lines: *vector.Vector[Line]) {
    val p:      *Parser = r.p;
    var blocks: u32     = 0;
    for (state.ok(p) && !state.is(p, lexer.RBRACE)) {
        if (state.is(p, lexer.END))         { state.expected(p, "}"); }
        or (state.accept(p, lexer.NEWLINE)) {}
        or (accept_kw(p, item.KW_VIRTUAL)) {
            val t: Token = state.expect(p, lexer.LOCAL, "a virtual register");
            state.expect(p, lexer.COLON, ":");
            val c: Class = class_of(r);
            state.expect_end(p);
            if (!state.ok(p)) { ret; }
            val made: res[Virtual, function.Error] = function.virtual(f, c);
            if (sel made.err) {
                refuse(r, t.line, t.column, Why.machine{made.err});
                ret;
            }
            state.define(p, ?p.values, "virtual register", t, made.ok.index);
        }
        or (accept_kw(p, item.KW_SLOT)) {
            val at: Token = p.tok;
            state.expect(p, lexer.LBRACKET, "[");
            val n: u32 = state.number32(p);
            state.expect(p, lexer.RBRACKET, "]");
            state.expect(p, lexer.COLON, ":");
            expect_kw(p, item.KW_SIZE);
            val size:  u64 = state.number(p);
            var per:   u64 = 0;
            var scale: u64 = 0;
            if (accept_kw(p, item.KW_PER)) {
                per = state.number(p);
                expect_kw(p, item.KW_SCALE);
                scale = state.number(p);
            }
            expect_kw(p, item.KW_ALIGN);
            val align: u64  = state.number(p);
            var area:  Area = Area.local{};
            if (accept_kw(p, item.KW_INCOMING)) { area = Area.incoming{argued(p)}; }
            or (accept_kw(p, item.KW_OUTGOING)) { area = Area.outgoing{argued(p)}; }
            state.expect_end(p);
            if (!state.ok(p)) { ret; }
            if (n::usize != f.slots.len) {
                state.fail_at(p, at.line, at.column, Reason.expected{"the next slot, in order"});
                ret;
            }
            if (scale > 255 || (per == 0 && !scaled_area(area) && scale != 0)) {
                state.fail_at(p, at.line, at.column, Reason.expected{"a scale of the register file"});
                ret;
            }
            val made: res[Slot, function.Error] = function.slot(f, SlotData{size: size, per: per, scale: scale::u8, align: align, area: area});
            if (sel made.err) { refuse(r, at.line, at.column, Why.machine{made.err}); }
        }
        or (state.is(p, lexer.LABEL)) {
            val t: Token = p.tok;
            state.advance(p);
            state.expect(p, lexer.COLON, ":");
            state.expect_end(p);
            if (!state.ok(p)) { ret; }
            val made: res[Block, function.Error] = function.block(f);
            if (sel made.err) {
                refuse(r, t.line, t.column, Why.machine{made.err});
                ret;
            }
            state.define(p, ?p.blocks, "block", t, made.ok.index);
            blocks = blocks + 1;
        }
        or {
            if (blocks == 0) {
                state.expected(p, "a block label");
                ret;
            }
            state.push[Line](p, lines, Line{at: state.mark(p), block: blocks - 1});
            state.skip_line(p);
            state.expect_end(p);
        }
    }
}

fun function_item(r: *Reading, u: *Unit, seen: *map.MapBy[View, u32]) {
    val p: *Parser = r.p;
    expect_kw(p, item.KW_FUNCTION);
    val t:     Token                 = state.expect(p, lexer.SYMBOL, "a function symbol");
    var entry: vector.Vector[Placed] = vector.init[Placed](p.a);
    fin { vector.dnit[Placed](?entry); }
    val placed_entry: bool = placements(r, item.KW_PLACED, ?entry);
    state.expect(p, lexer.LBRACE, "{");
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    val found: opt[Symbol] = module.find(p.m, t.text);
    if (sel found.none) {
        state.fail_at(p, t.line, t.column, Reason.unresolved{Named{what: item.KW_FUNCTION, name: t.raw}});
        ret;
    }
    if (!(sel found.some.function)) {
        state.fail_at(p, t.line, t.column, Reason.expected{"a function, not a global"});
        ret;
    }
    if (map.contains_by[View, u32](seen, ?t.text)) {
        state.fail_at(p, t.line, t.column, Reason.duplicate{Named{what: item.KW_FUNCTION, name: t.raw}});
        ret;
    }
    val noted: res[bool, allocator.Error] = map.insert_by[View, u32](seen, t.text, u.items.len::u32);
    if (sel noted.err) {
        state.refuse_alloc(p, noted.err);
        ret;
    }
    map.clear_by[View, u32](?p.values);
    map.clear_by[View, u32](?p.blocks);
    var f: Function = function.init(p.a, r.env.set);
    if (placed_entry) {
        val stated: err[allocator.Error] = function.place_entry(?f, Slice[Placed]{data: entry.data, size: entry.len});
        if (sel stated.err) { state.refuse_alloc(p, stated.err); }
    }
    var lines: vector.Vector[Line] = vector.init[Line](p.a);
    fin { vector.dnit[Line](?lines); }
    declare(r, ?f, ?lines);
    var i: usize = 0;
    for (i < lines.len && state.ok(p)) {
        instruction(r, ?f, lines.data[i]);
        i = i + 1;
    }
    state.expect(p, lexer.RBRACE, "}");
    state.expect_end(p);
    if (state.ok(p)) {
        val pushed: res[usize, allocator.Error] = vector.push[Item](?u.items, Item{symbol: found.some, function: f});
        if (sel pushed.err) { state.refuse_alloc(p, pushed.err); }
    }
    if (!state.ok(p) || sel p.failed.some) { function.dnit(?f); }
}

# an environment given as data, for a reading whose instruction set no registry of the tree holds
# ---
# registry: the instruction sets
# arch:     the architecture row the text is for
# memories: the memory-backed classes the set supplies
rec Given {
    registry: *mset.Registry;
    arch:     *arches.Arch;
    memories: Slice[Memory];
}

fun read(a: *allocator.Allocator, m: *Module, isas: *Isas, given: opt[Given], text: View, versioned: bool) res[Unit, Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    val head:   reader.Header           = reader.header(?p, versioned);
    val target: Token                   = head.at;
    val early:  opt[ir_refusal.Refusal] = p.failed;
    if (sel early.some) { ret res[Unit, Refusal].err{refusal.of_text(early.some)}; }
    if (!module.same_target(head.tuple, module.target(m))) {
        ret res[Unit, Refusal].err{Refusal{line: target.line, column: target.column, reason: Why.text{Reason.expected{"the target of the module"}}}};
    }
    state.attach(?p, m);
    var chosen: res[Env, Failure];
    if (sel given.some) { chosen = resolve.resolve(given.some.registry, given.some.arch, given.some.memories); }
    or                  { chosen = resolve.of(m, isas); }
    if (sel chosen.err) {
        ret res[Unit, Refusal].err{Refusal{line: target.line, column: target.column, reason: Why.target{chosen.err}}};
    }
    var env:  Env                 = chosen.ok;
    val made: res[Index, Failure] = index.init(a, ?env);
    if (sel made.err) {
        ret res[Unit, Refusal].err{Refusal{line: target.line, column: target.column, reason: Why.target{made.err}}};
    }
    var x: Index = made.ok;
    fin { index.dnit(?x); }
    var r:    Reading              = Reading{p: ?p, env: ?env, x: ?x, failed: opt[Refusal].none{}};
    var u:    Unit                 = Unit{a: a, items: vector.init[Item](a)};
    var seen: map.MapBy[View, u32] = map.init_by[View, u32](a, hash_name, same_name);
    fin { map.dnit_by[View, u32](?seen); }
    for (state.ok(?p) && !state.is(?p, lexer.END)) {
        if (state.accept(?p, lexer.NEWLINE)) {}
        or (is_kw(?p, item.KW_FUNCTION))     { function_item(?r, ?u, ?seen); }
        or                                   { state.expected(?p, "a function"); }
    }
    val failed: opt[ir_refusal.Refusal] = p.failed;
    if (sel failed.some) {
        dnit(?u);
        val own: opt[Refusal] = r.failed;
        if (sel own.some) { ret res[Unit, Refusal].err{own.some}; }
        ret res[Unit, Refusal].err{refusal.of_text(failed.some)};
    }
    ret res[Unit, Refusal].ok{u};
}

# read a machine form text that begins with its version line
# ---
# a:    the allocator the functions take
# m:    the module whose symbols and debug entries the text names, and whose
#       target the text names, which gives the instruction set
# isas: the registry whose record of that set gives its memory-backed
#       classes and loops
# text: the text, which a refusal's names are views of
# ret:  the functions, which the caller releases, or the first line refused
pub fun parse(a: *allocator.Allocator, m: *Module, isas: *Isas, text: View) res[Unit, Refusal] {
    ret read(a, m, isas, opt[Given].none{}, text, true);
}

# read a machine form text that has no version line, as the machine text files
# of the tree do, so a file stays valid across releases
pub fun parse_body(a: *allocator.Allocator, m: *Module, isas: *Isas, text: View) res[Unit, Refusal] {
    ret read(a, m, isas, opt[Given].none{}, text, false);
}

# read a text with its version line against a registry, an architecture and
# memory-backed classes given as data, for tests whose instruction set no registry of the tree holds
#[testing]
pub fun parse_in(a: *allocator.Allocator, m: *Module, registry: *mset.Registry, arch: *arches.Arch, memories: Slice[Memory], text: View) res[Unit, Refusal] {
    ret read(a, m, ?isa.NO_ISAS, opt[Given].some{Given{registry: registry, arch: arch, memories: memories}}, text, true);
}

# read a text with no version line against a registry, an architecture and
# memory-backed classes given as data, for tests whose instruction set no registry of the tree holds
#[testing]
pub fun parse_body_in(a: *allocator.Allocator, m: *Module, registry: *mset.Registry, arch: *arches.Arch, memories: Slice[Memory], text: View) res[Unit, Refusal] {
    ret read(a, m, ?isa.NO_ISAS, opt[Given].some{Given{registry: registry, arch: arch, memories: memories}}, text, false);
}
