#[testing]
val MEMORIES: [1]*Memory = [1]*Memory{?function.T_PAGE};

#[testing]
val MODULE: str = "target \"mtest\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%a: i32):\n    ret %a\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

#[testing]
fun reg(n: u16) Physical {
    ret Physical.register{rf.make(0, n)};
}

#[testing]
fun cell(n: u32) Physical {
    ret Physical.cell{Cell{class: ?function.T_PAGE, number: n}};
}

#[testing]
fun read(a: *allocator.Allocator, m: *Module, text: str) opt[reader.Unit] {
    val read: res[reader.Unit, Refusal] = reader.parse_body_in(a, m, ?synthetic.REGISTRY, ?synthetic.ARCH, ?synthetic.TARGET, view_of(text));
    if (sel read.err) { ret opt[reader.Unit].none{}; }
    ret opt[reader.Unit].some{read.ok};
}

# print a function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, f: Function) {
    var items: [1]item.Item;
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print_in(?out, m, ?synthetic.REGISTRY, ?synthetic.ARCH, ?synthetic.TARGET, Slice[item.Item]{data: ?items[0], size: 1});
}

# what allocating a function's text came to
# ---
# setup:     the step of the setup that failed
# refused:   the allocation was refused
# allocated: the allocation
#[testing]
tag Outcome: u8 {
    setup:     i32;
    refused:   allocate.Error;
    allocated: Allocation;
}

# allocate a function with some locations allowed, over the registers its
# file has under a selection, every one for nil, and the memory classes given
#[testing]
fun allocated(a: *allocator.Allocator, f: *Function, selection: *extension.Selection, memories: Slice[*Memory], given: Slice[Physical]) Outcome {
    val got: res[Locations, location.Error] = location.init(a, function.file(f), memories);
    if (sel got.err) { ret Outcome.setup{4}; }
    var at: Locations = got.ok;
    fin { location.dnit(?at); }
    val viewed: res[rf.Available, rf.Error] = rf.select(a, function.file(f), selection);
    if (sel viewed.err) { ret Outcome.setup{4}; }
    var regs: rf.Available = viewed.ok;
    fin { rf.release(?regs); }
    val done: res[Allocation, allocate.Error] = allocate.allocate(a, f, Request{at: ?at, registers: ?regs, allowed: given, clobbers: Slice[Clobber]{data: nil, size: 0}});
    if (sel done.err) { ret Outcome.refused{done.err}; }
    ret Outcome.allocated{done.ok};
}

# allocate a function's text with some locations allowed and compare the
# result with the expected text
# ---
# text:  the machine form text of @f
# given: the locations the target allows
# want:  the expected text of the allocated @f
# ret:   0, or the step that failed
#[testing]
fun allocates(text: str, given: Slice[Physical], want: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val input: opt[reader.Unit] = read(?a, ?m, text);
    if (sel input.none) { ret 2; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val expected: opt[reader.Unit] = read(?a, ?m, want);
    if (sel expected.none) { ret 3; }
    var w: reader.Unit = expected.some;
    fin { reader.dnit(?w); }
    # the test file's rows require no extension, so no selection is read
    val done: Outcome = allocated(?a, ?u.items.data[0].function, nil, Slice[*Memory]{data: ?MEMORIES[0], size: 1}, given);
    if (sel done.setup)   { ret done.setup; }
    or (sel done.refused) { ret 5; }
    var out: Allocation = done.allocated;
    fin { allocate.release(?out); }
    val same: res[bool, printer.Error] = equal.same_function(?m, ?out.function, ?m, ?w.items.data[0].function);
    if (sel same.err) { ret 6; }
    if (!same.ok) {
        show(?m, out.function);
        ret 7;
    }
    ret 0;
}

# three values live at once over two registers: the least dense is spilled,
# stored after its write and reloaded once for the run of its two reads
#[testing]
val PRESSED: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    virtual %2: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    load %1, [0]\n    load %2, [0]\n    add %2 = %2, %1\n    add %2 = %2, %0\n    add %2 = %2, %0\n}\n";

#[testing]
val PRESSED_OUT: str = "target \"mtest\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n    slot [1]: size 4 align 4\n^0:\n    load r0, [0]\n    pseudo spill [1], r0\n    load r0, [0]\n    load r1, [0]\n    add r1 = r1, r0\n    pseudo reload r0, [1]\n    add r1 = r1, r0\n    add r1 = r1, r0\n}\n";

test allocate__pressure_beyond_the_class_spills_and_reloads {
    var two: [2]Physical = [2]Physical{reg(0), reg(1)};
    ret allocates(PRESSED, Slice[Physical]{data: ?two[0], size: 2}, PRESSED_OUT);
}

# %0 takes r0 first, and the tie of the multiply, which the row fixes to r0,
# evicts it, so %0 is carried in pieces while the free registers take the rest
#[testing]
val PINNED: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    virtual %2: class r\n    virtual %3: class r\n    virtual %4: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    load %1, [0]\n    load %3, [0]\n    add %3 = %3, %0\n    wide %2 = %1, %4, %3\n}\n";

#[testing]
val PINNED_OUT: str = "target \"mtest\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n    slot [1]: size 4 align 4\n^0:\n    load r0, [0]\n    pseudo spill [1], r0\n    load r0, [0]\n    load r1, [0]\n    pseudo reload r2, [1]\n    add r1 = r1, r2\n    wide r0 = r0, r1, r1\n}\n";

test allocate__a_fixed_operand_evicts_a_conflicting_interval {
    var three: [3]Physical = [3]Physical{reg(0), reg(1), reg(2)};
    ret allocates(PINNED, Slice[Physical]{data: ?three[0], size: 3}, PINNED_OUT);
}

# values of a memory-backed class take its cells as values of a register
# class take registers, a cell freed when its value dies taken again
#[testing]
val CELLS: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: memory page\n    virtual %2: memory page\n    virtual %3: memory page\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    pseudo copy %1, %0\n    pseudo copy %2, %0\n    load %0, %1\n    pseudo copy %3, %0\n    load %0, %2\n    load %0, %3\n}\n";

#[testing]
val CELLS_OUT: str = "target \"mtest\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n^0:\n    load r0, [0]\n    pseudo copy {page: 0}, r0\n    pseudo copy {page: 1}, r0\n    load r0, {page: 0}\n    pseudo copy {page: 0}, r0\n    load r0, {page: 1}\n    load r0, {page: 0}\n}\n";

test allocate__a_memory_backed_class_allocates_like_a_register_class {
    var given: [4]Physical = [4]Physical{reg(0), reg(1), cell(0), cell(1)};
    ret allocates(CELLS, Slice[Physical]{data: ?given[0], size: 4}, CELLS_OUT);
}

# %0 is live across a maybe, which writes r2 under some operand values, so
# the copy's hint toward r2 is passed over and %0 takes r0
#[testing]
val MAYBE: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    maybe 1\n    pseudo copy r2, %0\n}\n";

#[testing]
val MAYBE_OUT: str = "target \"mtest\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n^0:\n    load r0, [0]\n    maybe 1\n    pseudo copy r2, r0\n}\n";

test allocate__a_value_live_across_a_possible_write_never_takes_its_register {
    var given: [2]Physical = [2]Physical{reg(0), reg(2)};
    ret allocates(MAYBE, Slice[Physical]{data: ?given[0], size: 2}, MAYBE_OUT);
}

# %0 and %1 are both live from the second load to the first add
#[testing]
val TWO: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    load %1, [0]\n    add %1 = %1, %0\n}\n";

#[testing]
fun refuses(a: *allocator.Allocator, f: *Function, at: *Locations, x: *Allowed, given: *u32) i32 {
    val locations: Slice[u32]                   = Slice[u32]{data: given, size: 2};
    val written:   res[Function, rewrite.Error] = rewrite.rewrite(a, f, at, locations);
    if (sel written.err) { ret 1; }
    var out: Function = written.ok;
    fin { function.dnit(?out); }
    val c: err[check.Failure] = check.check(a, f, at, Slice[Clobber]{data: nil, size: 0}, x, locations, ?out);
    if (sel c.ok)       { ret 0; }
    if (sel c.err.meet) { ret 2; }
    ret 3;
}

test check__refuses_a_wrong_assignment {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val input: opt[reader.Unit] = read(?a, ?m, TWO);
    if (sel input.none) { ret 2; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val f:   *Function                      = ?u.items.data[0].function;
    val got: res[Locations, location.Error] = location.init(?a, function.file(f), Slice[*Memory]{data: ?MEMORIES[0], size: 1});
    if (sel got.err) { ret 3; }
    var at: Locations = got.ok;
    fin { location.dnit(?at); }
    var two: [2]Physical                 = [2]Physical{reg(0), reg(1)};
    val xs:  res[Allowed, allowed.Error] = allowed.init(?a, ?at, Slice[Physical]{data: ?two[0], size: 2});
    if (sel xs.err) { ret 4; }
    var x: Allowed = xs.ok;
    fin { allowed.dnit(?x); }
    val r0: res[u32, location.Unlocated] = location.locate(?at, reg(0));
    val r1: res[u32, location.Unlocated] = location.locate(?at, reg(1));
    if (sel r0.err) { ret 5; }
    if (sel r1.err) { ret 5; }
    # apart, the two values pass
    var right: [2]u32 = [2]u32{r0.ok, r1.ok};
    if (refuses(?a, f, ?at, ?x, ?right[0]) != 0) { ret 6; }
    # in one register they meet, and the checker refuses
    var wrong: [2]u32 = [2]u32{r0.ok, r0.ok};
    if (refuses(?a, f, ?at, ?x, ?wrong[0]) != 2) { ret 7; }
    ret 0;
}

# %0 takes r0, and the output of the clobber, written before the clobber
# reads %0 and r1, takes neither though neither holds a value there
#[testing]
val CLOBBER: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    clobber %1, %0\n}\n";

#[testing]
val CLOBBER_OUT: str = "target \"mtest\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n^0:\n    load r0, [0]\n    clobber r2, r0\n}\n";

test allocate__an_early_clobber_output_takes_no_register_an_implicit_read_uses {
    var three: [3]Physical = [3]Physical{reg(0), reg(1), reg(2)};
    ret allocates(CLOBBER, Slice[Physical]{data: ?three[0], size: 3}, CLOBBER_OUT);
}

# a straight loop of one step, the clobber, whose operands are the clobber's
#[testing]
val CLOBBERING_ROLES: [2]mo.Role = [2]mo.Role{mo.WRITE, mo.READ};

#[testing]
val CLOBBERING_SOURCES: [2]lrow.Source = [2]lrow.Source{lrow.Source.operand{0}, lrow.Source.operand{1}};

#[testing]
val CLOBBERING_STEPS: [1]lrow.Step = [1]lrow.Step{lrow.Step{row: ?function.T_ROWS[6], operands: lrow.Sources{at: ?CLOBBERING_SOURCES[0], len: 2}}};

#[testing]
val CLOBBERING_PART: [1]lrow.Steps = [1]lrow.Steps{lrow.Steps{at: ?CLOBBERING_STEPS[0], len: 1}};

#[testing]
val CLOBBERING: lrow.Loop = lrow.Loop{name: "clobbering", roles: lrow.Roles{at: ?CLOBBERING_ROLES[0], len: 2}, before: lrow.Parts{at: ?CLOBBERING_PART[0], len: 1}, body: lrow.NO_PARTS, after: lrow.NO_PARTS, jump: CLOBBERING_STEPS[0]};

# allocate the clobber text with its clobber made the loop of that one step
#[testing]
fun looped(a: *allocator.Allocator, m: *Module, given: Slice[Physical]) Outcome {
    val input: opt[reader.Unit] = read(a, m, CLOBBER);
    if (sel input.none) { ret Outcome.setup{2}; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val f: *Function = ?u.items.data[0].function;
    function.data(f, Instruction{index: 1}).opcode = Opcode.loop{?CLOBBERING};
    ret allocated(a, f, nil, Slice[*Memory]{data: ?MEMORIES[0], size: 1}, given);
}

# a loop's operands are asked of its steps' rows' constraints at every
# choice, so the output of the clobber the loop steps through takes neither
# r0 nor r1, which liveness alone leaves free since a loop's implicit reads
# are of what its steps write, and with only r0 and r1 allowed the loop is
# refused by the breach of the clobber's constraint
test allocate__a_loop_stands_against_the_constraints_of_its_steps {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    var three: [3]Physical = [3]Physical{reg(0), reg(1), reg(2)};
    val done:  Outcome     = looped(?a, ?m, Slice[Physical]{data: ?three[0], size: 3});
    if (!(sel done.allocated)) { ret 2; }
    var out: Allocation = done.allocated;
    fin { allocate.release(?out); }
    val list: Slice[Instruction] = function.instructions(?out.function, Block{index: 0});
    if (list.size != 2) { ret 3; }
    val o: Operand = function.data(?out.function, list.data[1]).operands.data[0];
    if (!(sel o.physical)) { ret 4; }
    val p: Physical = o.physical;
    if (!(sel p.register))           { ret 4; }
    if (p.register != rf.make(0, 2)) { ret 5; }
    var two:     [2]Physical = [2]Physical{reg(0), reg(1)};
    val refused: Outcome     = looped(?a, ?m, Slice[Physical]{data: ?two[0], size: 2});
    if (!(sel refused.refused))      { ret 6; }
    if (!(sel refused.refused.scan)) { ret 7; }
    val e: scan.Error = refused.refused.scan;
    if (!(sel e.constrained))                 { ret 8; }
    if (e.constrained.instruction.index != 1) { ret 9; }
    ret 0;
}

# the allocation of a function's text with some locations allowed, refused
# by its scan with a breach of the row constraints of instruction `at`
#[testing]
fun breached(a: *allocator.Allocator, f: *Function, selection: *extension.Selection, memories: Slice[*Memory], given: Slice[Physical], at: u32) opt[constraint.Breach] {
    val done: Outcome = allocated(a, f, selection, memories, given);
    if (sel done.allocated) {
        var out: Allocation = done.allocated;
        allocate.release(?out);
        ret opt[constraint.Breach].none{};
    }
    if (!(sel done.refused))      { ret opt[constraint.Breach].none{}; }
    if (!(sel done.refused.scan)) { ret opt[constraint.Breach].none{}; }
    val e: scan.Error = done.refused.scan;
    if (!(sel e.constrained))                  { ret opt[constraint.Breach].none{}; }
    if (e.constrained.instruction.index != at) { ret opt[constraint.Breach].none{}; }
    ret opt[constraint.Breach].some{e.constrained.breach};
}

# with only r0 and r1 allowed, %0 in r0 and the clobber reading r1, its
# output stands in no allowed register
test allocate__a_constraint_no_allowed_register_meets_is_refused_by_type {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val input: opt[reader.Unit] = read(?a, ?m, CLOBBER);
    if (sel input.none) { ret 2; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    var two: [2]Physical            = [2]Physical{reg(0), reg(1)};
    val got: opt[constraint.Breach] = breached(?a, ?u.items.data[0].function, nil, Slice[*Memory]{data: ?MEMORIES[0], size: 1}, Slice[Physical]{data: ?two[0], size: 2}, 1);
    if (sel got.none) { ret 3; }
    val b: constraint.Breach = got.some;
    if (!(sel b.broken))                    { ret 4; }
    if (b.broken != ?function.T_CLOBBER[0]) { ret 5; }
    ret 0;
}

#[testing]
val VECTOR_NAMES: [1]str = [1]str{"v"};

#[testing]
val VECTOR_MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# a vector instruction of risc-v, whose groups vtype decides, allocated over
# v1 to v7: the machine form carries no vtype, so the instruction is refused
# by type, naming its first vector operand, whatever its rows constrain
#[testing]
fun stateless(text: str, at: u32) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(VECTOR_MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val tg: opt[*Target] = targets.by_name(m.target);
    if (sel tg.none) { ret 1; }
    var base:   Basis;
    val chosen: err[machine.Error] = machine.choose(?base, ?a, tg.some, Slice[str]{data: ?VECTOR_NAMES[0], size: 1});
    if (sel chosen.err) { ret 1; }
    fin { machine.drop(?base); }
    val input: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, view_of(text));
    if (sel input.err) { ret 2; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    var given: [7]Physical = [7]Physical{
        Physical.register{gen_register.V1},
        Physical.register{gen_register.V2},
        Physical.register{gen_register.V3},
        Physical.register{gen_register.V4},
        Physical.register{gen_register.V5},
        Physical.register{gen_register.V6},
        Physical.register{gen_register.V7},
    };
    val got: opt[constraint.Breach] = breached(?a, ?u.items.data[0].function, ?base.selection, Slice[*Memory]{data: nil, size: 0}, Slice[Physical]{data: ?given[0], size: 7}, at);
    if (sel got.none) { ret 3; }
    val b: constraint.Breach = got.some;
    if (!(sel b.unknown)) { ret 4; }
    if (b.unknown != 0)   { ret 5; }
    ret 0;
}

# a widening add, whose destination may overlap its sources only in its
# highest registers under the vtype in force
#[testing]
val WIDENING: str = "target \"riscv64-linux\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n    virtual %2: class v\n^0:\n    pseudo copy %0, v8\n    pseudo copy %1, v9\n    pseudo copy %2, v10\n    vwadd.vv %2, %0, %1, 1\n    pseudo copy v10, %2\n    jalr x0, x1, 0\n}\n";

test allocate__a_widening_vector_add_is_refused_for_want_of_vector_state {
    ret stateless(WIDENING, 3);
}

# a fourfold extension, whose destination group may not overlap its source
#[testing]
val EXTENSION: str = "target \"riscv64-linux\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n^0:\n    pseudo copy %0, v8\n    pseudo copy %1, v9\n    vzext.vf4 %1, %0, 1\n    pseudo copy v10, %1\n    jalr x0, x1, 0\n}\n";

test allocate__a_fourfold_vector_extension_is_refused_for_want_of_vector_state {
    ret stateless(EXTENSION, 2);
}

# a gather reading its index at 16 bits, whose rule against its data source
# masc marks with a gap, answering inexact where they share registers
#[testing]
val GATHER: str = "target \"riscv64-linux\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n    virtual %2: class v\n^0:\n    pseudo copy %0, v8\n    pseudo copy %1, v9\n    pseudo copy %2, v10\n    vrgatherei16.vv %2, %0, %1, 1\n    pseudo copy v10, %2\n    jalr x0, x1, 0\n}\n";

test allocate__a_gather_with_a_gap_constraint_is_refused_for_want_of_vector_state {
    ret stateless(GATHER, 3);
}
