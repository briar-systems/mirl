# the linear scan of one round over the live intervals of its virtual form
#
# virtual registers a tie joins are one bundle, given one location: a bundle
# is the union of its members' segments, its weight their weights summed and
# its density that weight over the positions it covers. a tie whose two
# halves meet, or a bundle whose members meet, cannot be one location, so
# the round gives the source half of each such tie a value of its own, or the
# destination half when the source is already one, and stops there. so do
# members pinned to different locations, whose pins each get a value of
# their own.
#
# the bundles are walked in start order, the bundle number breaking a tie.
# the active set holds the assigned bundles live at the current position and
# the inactive set those in a hole, each kept per location as an intrusive
# list, with a count per location of the active bundles whose location shares
# its storage, and two heaps, keyed by the end of each active bundle's current
# segment and the start of each inactive bundle's next, that move a bundle
# between them as the position passes. a location is free for a bundle when
# no active bundle holds storage it shares, no inactive bundle holding such
# storage meets the bundle, and no value of the location's own or of another
# virtual register's pin holds such storage over the bundle.
#
# a value of a group of registers, as a risc-v vector group under m2, is one
# virtual register of the group's tuple class, whose location is one tuple
# sharing storage with each of its members, so interference and eviction see
# the whole group through the locations' sharing, and it is evicted, split,
# untied and given values of its own as any other, since its class's moves,
# spills and reloads carry it whole. a list's first member is the one value
# of several locations: a bundle's span is the most registers any member's
# list covers, and at a location it holds the registers of its class its span
# covers from there, as a list of two from register 8 holds registers 8 and 9.
# each of them is then busy, free and held as the bundle's own location is. a
# location fits a bundle only when every register of its span exists, is
# allowed and is of its classes. a bundle of a span past one is never
# evicted, split, untied or given a value of its own, since no copy, spill or
# reload carries a list, and a round that would do so is refused by type.
#
# a location also conflicts with a bundle when an instruction of its members
# would not stand against its row's register constraints with the bundle
# there, every other operand at its bundle's location, at its pin while it
# has none, or not chosen yet. a bundle no location of its class stands at is
# refused, naming the instruction and its breach.
#
# a pinned bundle may take only its pin. any other takes the free location
# its copies name, the location whose copies weigh most in all first, then
# the earliest copy, then the lowest location. failing that it takes the location of a bundle of its
# preference group the round has placed, the heaviest such bundle first, then
# the lowest location: bundles a chain of copies joins form one group, which
# is never one bundle, so its members interfere and spill apart, but each
# prefers where the others went, so a copy whose ends are not adjacent in the
# chain still has the same location at both. otherwise it takes the free
# location of its class with the lowest number that costs the frame no save: one sharing storage with no
# register the convention preserves, or only with ones the round has already
# placed a bundle in. a free location that would make the frame save one more
# preserved register is taken only when no free one costs nothing, the lowest
# such first. with none free, the location whose conflicting bundles are
# the least dense at their densest is found among those it stands at, the
# lowest number breaking a tie, and those bundles are evicted when the
# current one is denser, or when
# it is made only of values of a half's own, which are never carried any
# other way. otherwise the current bundle is split: a pinned one's pins get
# values of their own, and any other is spilled, carried in pieces in the
# next round. a bundle that can be neither placed nor split refuses the
# function. an evicted or spilled bundle holds nothing for the rest of the
# round, and the round's assignment stands only when nothing was spilled or
# given a value of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.heap;
use std.collections.heap.Heap;
use std.collections.heap.Min;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.machine.alloc.allowed;
use mirl.machine.alloc.allowed.Allowed;
use mirl.machine.alloc.live;
use mirl.machine.alloc.live.Live;
use mirl.machine.alloc.live.Segment;
use mirl.machine.alloc.live.Site;
use mirl.machine.alloc.live.Use;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.alloc.spill;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Physical;
use mirl.machine.constraint;
use mirl.machine.constraint.Constrained;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Virtual;
use mirl.machine.pseudo;

use mo:         masc.core.operand;
use rows:       masc.core.row;
use core_state: masc.core.state;

# no location, bundle or virtual register
pub val NONE: u32 = 0xffffffff;

# the pin of a bundle whose members are pinned to different locations
val CLASH: u32 = 0xfffffffe;

val WAITING:  u8 = 0;
val ACTIVE:   u8 = 1;
val INACTIVE: u8 = 2;
val HANDLED:  u8 = 3;
val SPILLED:  u8 = 4;

# what place knows of a candidate location
val UNFIT:   u8 = 0;
val UNASKED: u8 = 1;
val STANDS:  u8 = 2;
val BREAKS:  u8 = 3;

# a row of an instruction whose constraints or grouping a bundle's locations are asked against
# ---
# instruction: the instruction
# row:         the row, among those it stands for
pub rec Asked {
    instruction: u32;
    row:         u32;
}

# one half of an operand of an instruction of the form
# ---
# instruction: the instruction
# operand:     the operand position
# write:       the write, or else the read
pub rec Half {
    instruction: Instruction;
    operand:     u32;
    write:       bool;
}

# a bundle no location can hold, which cannot be split
# ---
# virtual:  its first member
# position: its first position
pub rec Stuck {
    virtual:  Virtual;
    position: u32;
}

# why a round was refused
# ---
# alloc:       the allocator refused storage
# pinned:      an operand pinned to a location the target does not let the allocator assign
# stuck:       a bundle no location can hold and no split can help
# unlocated:   a register a copy names that the locations refused, and why
# constrained: a bundle no location of its class stands at, by the instruction
#              its first location breaks and the breach
# grouped:     a value of a list's registers that the round would carry
#              other than whole in one location, which no copy, spill or
#              reload carries
pub tag Error: u8 {
    alloc:       allocator.Error;
    pinned:      Site;
    stuck:       Stuck;
    unlocated:   location.Unlocated;
    constrained: Constrained;
    grouped:     Virtual;
}

# the allocator's refusal `e` stands for, its own or a step's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    ret opt[allocator.Error].none{};
}

# what a round decided
# ---
# locations: each virtual register's location, NONE when it holds none
# spilled:   the virtual registers to carry in pieces, ascending
# own:       the halves to give a value of their own
pub rec Result {
    locations: vector.Vector[u32];
    spilled:   vector.Vector[u32];
    own:       vector.Vector[Half];
}

# the operands and values breach derives for one row, kept for the whole
# scan rather than made afresh for every row it asks
# ---
# stated: a loop's step's operands
# held:   the operands with the bundle and its neighbours at their locations
# values: the values masc reads of them
rec Room {
    stated: [mo.MAX_OPERANDS]Operand;
    held:   [mo.MAX_OPERANDS]Operand;
    values: [instruction.VALUES]mo.Value;
}

# the storage the scans of an allocation's rounds work in, which the caller
# keeps across rounds and functions. it holds nothing from one scan to the
# next: each empties every table it takes
# ---
# parent:    each virtual register's parent among those its ties join
# of:        each virtual register's bundle
# members:   each bundle's members
# segs:      each bundle's segments, sorted with the touching merged
# clashed:   whether any two of a bundle's members meet
# weight:    each bundle's weight
# size:      the positions each bundle covers
# span:      each bundle's span
# marked:    whether a bundle is listed as a conflict
# pin:       each bundle's pin, NONE for none and CLASH for several
# minimal:   whether a bundle is only values of a half's own
# mixed:     whether a bundle holds members of more than one class
# order:     the bundles in start order, each its start over its number
# loc:       each bundle's location
# state:     each bundle's state
# cursor:    each bundle's current segment
# key:       the position each bundle's entry in a heap is keyed by
# next:      the next bundle on a location's list
# prev:      the bundle before on a location's list
# actives:   each location's active bundles, as a list
# inactives: each location's inactive bundles, as a list
# busy:      how many active bundles hold storage each location shares
# opened:    each location, whether it is a preserved register the round has
#            already placed a bundle sharing its storage in, so the frame
#            saves it whatever else the round places there
# prefer:    each bundle's parent in the union of its preference group
# placed:    the next bundle of its group the round placed, as a list from
#            the group's root
# heads:     each group root's list of placed bundles
# listed:    each bundle, whether it is on its group's list
# spots:     the locations placed bundles of a group hold, each with the
#            heaviest weight of one there, as lists from `firsts`
# firsts:    each group root's first spot, NONE for none
# hints:     the locations the copies of a bundle being placed name
# rising:    the active bundles by the end of their current segment
# waking:    the inactive bundles by the start of their next segment
# conflicts: the bundles a placement would meet
# standing:  what place knows of each candidate location
# asked:     the rows a bundle's locations are asked against
# named:     each union's bundle, by its root
# mkeys:     each virtual register's bundle, as keys
# mvals:     the virtual registers
# skeys:     each segment's bundle, as keys
# svals:     the segments
# grouped:   the segments grouped by bundle, unsorted
pub rec Scratch {
    parent:    vector.Vector[u32];
    of:        vector.Vector[u32];
    members:   Lists[u32];
    segs:      Lists[Segment];
    clashed:   vector.Vector[bool];
    weight:    vector.Vector[u64];
    size:      vector.Vector[u64];
    span:      vector.Vector[u32];
    marked:    vector.Vector[bool];
    pin:       vector.Vector[u32];
    minimal:   vector.Vector[bool];
    mixed:     vector.Vector[bool];
    order:     vector.Vector[u64];
    loc:       vector.Vector[u32];
    state:     vector.Vector[u8];
    cursor:    vector.Vector[u32];
    key:       vector.Vector[u32];
    next:      vector.Vector[u32];
    prev:      vector.Vector[u32];
    actives:   vector.Vector[u32];
    inactives: vector.Vector[u32];
    busy:      vector.Vector[u32];
    opened:    vector.Vector[bool];
    prefer:    vector.Vector[u32];
    placed:    vector.Vector[u32];
    heads:     vector.Vector[u32];
    listed:    vector.Vector[bool];
    spots:     vector.Vector[Spot];
    firsts:    vector.Vector[u32];
    hints:     vector.Vector[Hint];
    rising:    Heap[u64, Min];
    waking:    Heap[u64, Min];
    conflicts: vector.Vector[u32];
    standing:  vector.Vector[u8];
    asked:     vector.Vector[Asked];
    named:     vector.Vector[u32];
    mkeys:     vector.Vector[u32];
    mvals:     vector.Vector[u32];
    skeys:     vector.Vector[u32];
    svals:     vector.Vector[Segment];
    grouped:   Lists[Segment];
}

# a location a placed bundle of a preference group holds
# ---
# at:     the location, NONE once no placed bundle of the group holds it
# weight: the heaviest weight of a placed bundle of the group there
# next:   the group's next spot, NONE for none
rec Spot {
    at:     u32;
    weight: u64;
    next:   u32;
}

# a location copies of a bundle's members name
# ---
# at:     the location
# weight: the weight of every such copy naming it, summed
# first:  the earliest position of one
rec Hint {
    at:     u32;
    weight: u64;
    first:  u32;
}

# one scan: what it reads, the result it fills and the tables of the scratch it works in
rec Scan {
    f:         *Function;
    ctx:       *core_state.Context;
    l:         *Live;
    at:        *Locations;
    allowed:   *Allowed;
    kinds:     Slice[u8];
    out:       *Result;
    w:         *Scratch;
    parent:    *vector.Vector[u32];
    of:        *vector.Vector[u32];
    members:   *Lists[u32];
    segs:      *Lists[Segment];
    clashed:   *vector.Vector[bool];
    weight:    *vector.Vector[u64];
    size:      *vector.Vector[u64];
    span:      *vector.Vector[u32];
    widest:    u32;
    marked:    *vector.Vector[bool];
    pin:       *vector.Vector[u32];
    minimal:   *vector.Vector[bool];
    mixed:     *vector.Vector[bool];
    order:     *vector.Vector[u64];
    loc:       *vector.Vector[u32];
    state:     *vector.Vector[u8];
    cursor:    *vector.Vector[u32];
    key:       *vector.Vector[u32];
    next:      *vector.Vector[u32];
    prev:      *vector.Vector[u32];
    actives:   *vector.Vector[u32];
    inactives: *vector.Vector[u32];
    busy:      *vector.Vector[u32];
    opened:    *vector.Vector[bool];
    prefer:    *vector.Vector[u32];
    placed:    *vector.Vector[u32];
    heads:     *vector.Vector[u32];
    listed:    *vector.Vector[bool];
    spots:     *vector.Vector[Spot];
    firsts:    *vector.Vector[u32];
    hints:     *vector.Vector[Hint];
    rising:    *Heap[u64, Min];
    waking:    *Heap[u64, Min];
    conflicts: *vector.Vector[u32];
    standing:  *vector.Vector[u8];
    asked:     *vector.Vector[Asked];
    room:      *Room;
}

fun alloc_err(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun pushed(r: res[usize, allocator.Error]) err[Error] {
    if (sel r.err) { ret alloc_err(r.err); }
    ret err[Error].ok{};
}

# the root of the tie union holding virtual register `v`, halving the path on the way
fun find(s: *Scan, v: u32) u32 {
    var x: u32 = v;
    for (s.parent.data[x] != x) {
        s.parent.data[x] = s.parent.data[s.parent.data[x]];
        x                = s.parent.data[x];
    }
    ret x;
}

# join the tie unions of `x` and `y` under the lower root
fun unite(s: *Scan, x: u32, y: u32) {
    val rx: u32 = find(s, x);
    val ry: u32 = find(s, y);
    if (rx == ry) { ret; }
    if (rx < ry)  { s.parent.data[ry] = rx; }
    or            { s.parent.data[rx] = ry; }
}

# refused when a virtual register's value covers several registers, which no copy carries
fun whole(s: *Scan, v: u32) err[Error] {
    if (live.span(s.l, v) > 1) { ret err[Error].err{Error.grouped{v}}; }
    ret err[Error].ok{};
}

# give half `h` a value of its own
fun own(s: *Scan, h: Half) err[Error] {
    ret pushed(vector.push[Half](?s.out.own, h));
}

# the half of a tie to give its own value: the source, unless it already is one
fun untie(s: *Scan, u: Use) err[Error] {
    val err_carried: err[Error] = whole(s, u.tied);
    if (sel err_carried.err) { ret err_carried; }
    var write: bool = false;
    if (s.kinds.data[u.tied] == spill.OWN) { write = true; }
    ret own(s, Half{instruction: u.instruction, operand: u.operand, write: write});
}

# join the halves of every tie that never meet, and give a half of each that
# does a value of its own
fun ties(s: *Scan) err[Error] {
    val count: u32 = s.f.virtuals.len::u32;
    var v:     u32 = 0;
    for (v < count) {
        val us: Slice[Use] = live.uses(s.l, v);
        var k:  usize      = 0;
        for (k < us.size) {
            val u: Use = us.data[k];
            if (u.write && u.tied != live.NONE && u.tied != v) {
                val opt_met: opt[u32] = live.overlap(s.l, v, u.tied);
                if (sel opt_met.some) {
                    val err_untie: err[Error] = untie(s, u);
                    if (sel err_untie.err) { ret err_untie; }
                }
                or { unite(s, v, u.tied); }
            }
            k = k + 1;
        }
        v = v + 1;
    }
    ret err[Error].ok{};
}

fun by_from(a: *Segment, b: *Segment) i64 {
    if (a.from < b.from) { ret -1; }
    if (a.from > b.from) { ret 1; }
    ret 0;
}

# each bundle's members and its segments, sorted with the touching merged,
# and whether any two of its members meet
fun group(s: *Scan) err[Error] {
    val count:      u32                     = s.f.virtuals.len::u32;
    val named:      *vector.Vector[u32]     = ?s.w.named;
    val mkeys:      *vector.Vector[u32]     = ?s.w.mkeys;
    val mvals:      *vector.Vector[u32]     = ?s.w.mvals;
    val skeys:      *vector.Vector[u32]     = ?s.w.skeys;
    val svals:      *vector.Vector[Segment] = ?s.w.svals;
    var err_failed: err[allocator.Error]    = slice.fill[u32](named, count::usize, NONE);
    keep(?err_failed, slice.fill[u32](s.of, count::usize, NONE));
    keep(?err_failed, slice.fill[u32](mkeys, count::usize, 0));
    keep(?err_failed, slice.fill[u32](mvals, count::usize, 0));
    val total:       usize                       = s.l.segments.items.len;
    val res_reserve: res[usize, allocator.Error] = vector.reserve[u32](skeys, total);
    if (sel res_reserve.err) { keep(?err_failed, err[allocator.Error].err{res_reserve.err}); }
    val res_reserve_svals: res[usize, allocator.Error] = vector.reserve[Segment](svals, total);
    if (sel res_reserve_svals.err) { keep(?err_failed, err[allocator.Error].err{res_reserve_svals.err}); }
    if (sel err_failed.err)        { ret alloc_err(err_failed.err); }
    var bundles: u32   = 0;
    var written: usize = 0;
    var v:       u32   = 0;
    for (v < count) {
        val r: u32 = find(s, v);
        if (named.data[r] == NONE) {
            named.data[r] = bundles;
            bundles       = bundles + 1;
        }
        s.of.data[v]  = named.data[r];
        mkeys.data[v] = named.data[r];
        mvals.data[v] = v;
        val segs: Slice[Segment] = live.segments(s.l, v);
        var k:    usize          = 0;
        for (k < segs.size) {
            skeys.data[written] = named.data[r];
            svals.data[written] = segs.data[k];
            written             = written + 1;
            k                   = k + 1;
        }
        v = v + 1;
    }
    vector.commit[u32](skeys, written);
    vector.commit[Segment](svals, written);
    val err_made: err[allocator.Error] = graph.group[u32](s.members, bundles, Slice[u32]{data: mkeys.data, size: mkeys.len}, Slice[u32]{data: mvals.data, size: mvals.len});
    if (sel err_made.err) { ret alloc_err(err_made.err); }
    val grouped: *Lists[Segment]      = ?s.w.grouped;
    val err_raw: err[allocator.Error] = graph.group[Segment](grouped, bundles, Slice[u32]{data: skeys.data, size: skeys.len}, Slice[Segment]{data: svals.data, size: svals.len});
    if (sel err_raw.err) { ret alloc_err(err_raw.err); }
    var err_room: err[allocator.Error] = slice.fill[bool](s.clashed, bundles::usize, false);
    keep(?err_room, slice.fill[u64](s.size, bundles::usize, 0));
    val res_reserve_first: res[usize, allocator.Error] = vector.reserve[u32](?s.segs.first, bundles::usize + 1);
    if (sel res_reserve_first.err) { keep(?err_room, err[allocator.Error].err{res_reserve_first.err}); }
    val res_reserve_items: res[usize, allocator.Error] = vector.reserve[Segment](?s.segs.items, svals.len);
    if (sel res_reserve_items.err) { keep(?err_room, err[allocator.Error].err{res_reserve_items.err}); }
    if (sel err_room.err)          { ret alloc_err(err_room.err); }
    vector.push[u32](?s.segs.first, 0);
    var b: u32 = 0;
    for (b < bundles) {
        val list: Slice[Segment] = graph.list[Segment](grouped, b);
        if (list.size > 1) { sort.sort_by[Segment](list.data, list.size, by_from); }
        val base: usize = s.segs.items.len;
        var k:    usize = 0;
        for (k < list.size) {
            val seg: Segment = list.data[k];
            val len: usize   = s.segs.items.len;
            if (len > base && s.segs.items.data[len - 1].to > seg.from) { s.clashed.data[b] = true; }
            if (len > base && s.segs.items.data[len - 1].to >= seg.from) {
                if (seg.to > s.segs.items.data[len - 1].to) { s.segs.items.data[len - 1].to = seg.to; }
            }
            or { vector.push[Segment](?s.segs.items, seg); }
            k = k + 1;
        }
        k = base;
        for (k < s.segs.items.len) {
            s.size.data[b] = s.size.data[b] + (s.segs.items.data[k].to - s.segs.items.data[k].from)::u64;
            k              = k + 1;
        }
        vector.push[u32](?s.segs.first, s.segs.items.len::u32);
        b = b + 1;
    }
    ret err[Error].ok{};
}

fun bundles(s: *Scan) u32 {
    ret (s.segs.first.len - 1)::u32;
}

fun members(s: *Scan, b: u32) Slice[u32] {
    ret graph.list[u32](s.members, b);
}

fun segments(s: *Scan, b: u32) Slice[Segment] {
    ret graph.list[Segment](s.segs, b);
}

# the segments of a bundle from its cursor on
fun ahead(s: *Scan, b: u32) Slice[Segment] {
    val all: Slice[Segment] = segments(s, b);
    val c:   usize          = s.cursor.data[b]::usize;
    ret Slice[Segment]{data: ?all.data[c], size: all.size - c};
}

# give a half of every tie inside a bundle whose members meet a value of its own
fun split_clashes(s: *Scan) err[Error] {
    var b: u32 = 0;
    for (b < bundles(s)) {
        if (s.clashed.data[b]) {
            val ms: Slice[u32] = members(s, b);
            var m:  usize      = 0;
            for (m < ms.size) {
                val us: Slice[Use] = live.uses(s.l, (ms.data[m]));
                var k:  usize      = 0;
                for (k < us.size) {
                    val u: Use = us.data[k];
                    if (u.write && u.tied != live.NONE && u.tied != ms.data[m]) {
                        val err_untie: err[Error] = untie(s, u);
                        if (sel err_untie.err) { ret err_untie; }
                    }
                    k = k + 1;
                }
                m = m + 1;
            }
        }
        b = b + 1;
    }
    ret err[Error].ok{};
}

# give every pinned half of a bundle's members not already a half's own value
# a value of its own, false when there is none to give
fun free_pins(s: *Scan, b: u32) res[bool, Error] {
    var any: bool       = false;
    val ms:  Slice[u32] = members(s, b);
    var m:   usize      = 0;
    for (m < ms.size) {
        if (s.kinds.data[ms.data[m]] != spill.OWN) {
            val us: Slice[Use] = live.uses(s.l, (ms.data[m]));
            var k:  usize      = 0;
            for (k < us.size) {
                if (us.data[k].fixed != live.NONE) {
                    val err_carried: err[Error] = whole(s, ms.data[m]);
                    if (sel err_carried.err) { ret res[bool, Error].err{err_carried.err}; }
                    val err_own: err[Error] = own(s, Half{instruction: us.data[k].instruction, operand: us.data[k].operand, write: us.data[k].write});
                    if (sel err_own.err) { ret res[bool, Error].err{err_own.err}; }
                    any = true;
                }
                k = k + 1;
            }
        }
        m = m + 1;
    }
    ret res[bool, Error].ok{any};
}

# each bundle's weight, pin, and whether it is only values of a half's own or
# holds members of more than one class
fun describe(s: *Scan) err[Error] {
    val n:          usize                = bundles(s)::usize;
    var err_failed: err[allocator.Error] = slice.fill[u64](s.weight, n, 0);
    keep(?err_failed, slice.fill[u32](s.pin, n, NONE));
    keep(?err_failed, slice.fill[bool](s.minimal, n, true));
    keep(?err_failed, slice.fill[bool](s.mixed, n, false));
    keep(?err_failed, slice.fill[u32](s.span, n, 1));
    keep(?err_failed, slice.fill[bool](s.marked, n, false));
    if (sel err_failed.err) { ret alloc_err(err_failed.err); }
    s.widest = 1;
    var b: u32 = 0;
    for (b::usize < n) {
        val ms:    Slice[u32] = members(s, b);
        val first: Class      = function.class_of(s.f, (ms.data[0]));
        var m:     usize      = 0;
        for (m < ms.size) {
            val v: u32 = ms.data[m];
            s.weight.data[b] = s.weight.data[b] + live.weight_of(s.l, v);
            val wide: u32 = live.span(s.l, v);
            if (wide > s.span.data[b])                         { s.span.data[b] = wide; }
            if (wide > s.widest)                               { s.widest = wide; }
            if (s.kinds.data[v] != spill.OWN)                  { s.minimal.data[b] = false; }
            if (!class.same(function.class_of(s.f, v), first)) { s.mixed.data[b] = true; }
            val us: Slice[Use] = live.uses(s.l, v);
            var k:  usize      = 0;
            for (k < us.size) {
                val pin: u32 = us.data[k].fixed;
                if (pin != live.NONE) {
                    if (!allowed.admits(s.allowed, pin)) { ret err[Error].err{Error.pinned{Site{instruction: us.data[k].instruction, operand: us.data[k].operand}}}; }
                    if (s.pin.data[b] == NONE)           { s.pin.data[b] = pin; }
                    or (s.pin.data[b] != pin)            { s.pin.data[b] = CLASH; }
                }
                k = k + 1;
            }
            m = m + 1;
        }
        if (s.pin.data[b] == CLASH) {
            val res_freed: res[bool, Error] = free_pins(s, b);
            if (sel res_freed.err) { ret err[Error].err{res_freed.err}; }
            if (!res_freed.ok)     { ret err[Error].err{Error.stuck{Stuck{virtual: (ms.data[0]), position: segments(s, b).data[0].from}}}; }
        }
        b = b + 1;
    }
    ret err[Error].ok{};
}

# whether a bundle is less dense than another, by weight over positions
fun less(wa: u64, sa: u64, wb: u64, sb: u64) bool {
    ret wa::u128 * sb::u128 < wb::u128 * sa::u128;
}

# put bundle `b` at the head of location `at`'s list in `heads`
fun link(s: *Scan, heads: *vector.Vector[u32], b: u32, at: u32) {
    s.prev.data[b] = NONE;
    s.next.data[b] = heads.data[at];
    if (heads.data[at] != NONE) { s.prev.data[heads.data[at]] = b; }
    heads.data[at] = b;
}

# take bundle `b` off location `at`'s list in `heads`
fun unlink(s: *Scan, heads: *vector.Vector[u32], b: u32, at: u32) {
    if (s.prev.data[b] != NONE) { s.next.data[s.prev.data[b]] = s.next.data[b]; }
    or                          { heads.data[at] = s.next.data[b]; }
    if (s.next.data[b] != NONE) { s.prev.data[s.next.data[b]] = s.prev.data[b]; }
}

# count an active bundle in, or out of, every location sharing storage with a register of its group
fun count_busy(s: *Scan, b: u32, up: bool) {
    var g: u32 = 0;
    for (g < s.span.data[b]) {
        val alias: Slice[u32] = location.shares(s.at, location.past(s.at, s.loc.data[b], g));
        var k:     usize      = 0;
        for (k < alias.size) {
            if (up) { s.busy.data[alias.data[k]] = s.busy.data[alias.data[k]] + 1; }
            or      { s.busy.data[alias.data[k]] = s.busy.data[alias.data[k]] - 1; }
            k = k + 1;
        }
        g = g + 1;
    }
}

# a heap or order key: the position in the high 32 bits, bundle `b` in the low
fun entry(position: u32, b: u32) u64 {
    ret (position::u64 << 32) | b::u64;
}

# make bundle `b` active at its location, keyed by the end of its current segment
fun activate(s: *Scan, b: u32) err[Error] {
    s.state.data[b] = ACTIVE;
    link(s, s.actives, b, s.loc.data[b]);
    count_busy(s, b, true);
    s.key.data[b] = segments(s, b).data[s.cursor.data[b]].to;
    ret pushed(heap.push[u64, Min](s.rising, entry(s.key.data[b], b)));
}

fun deactivate(s: *Scan, b: u32) {
    unlink(s, s.actives, b, s.loc.data[b]);
    count_busy(s, b, false);
}

# make bundle `b` inactive at its location, keyed by the start of its current segment
fun sleep(s: *Scan, b: u32) err[Error] {
    s.state.data[b] = INACTIVE;
    link(s, s.inactives, b, s.loc.data[b]);
    s.key.data[b] = segments(s, b).data[s.cursor.data[b]].from;
    ret pushed(heap.push[u64, Min](s.waking, entry(s.key.data[b], b)));
}

# move a bundle's cursor to its first segment ending after a position, and
# say whether it has one
fun step(s: *Scan, b: u32, p: u32) bool {
    val all: Slice[Segment] = segments(s, b);
    var c:   u32            = s.cursor.data[b];
    for (c::usize < all.size && all.data[c].to <= p) { c = c + 1; }
    s.cursor.data[b] = c;
    ret c::usize < all.size;
}

# the sets at a position: an active bundle whose segment ended waits in a hole
# or is done, and an inactive one whose next segment began is active again
fun advance(s: *Scan, p: u32) err[Error] {
    for {
        val opt_top: opt[*u64] = heap.peek[u64, Min](s.rising);
        if (sel opt_top.none) { brk; }
        val first: u64 = @opt_top.some;
        if ((first >> 32) > p::u64) { brk; }
        heap.pop[u64, Min](s.rising);
        val b: u32 = (first & 0xffffffff)::u32;
        if (s.state.data[b] == ACTIVE && s.key.data[b]::u64 == (first >> 32)) {
            deactivate(s, b);
            if (!step(s, b, p)) { s.state.data[b] = HANDLED; }
            or (segments(s, b).data[s.cursor.data[b]].from <= p) {
                val err_again: err[Error] = activate(s, b);
                if (sel err_again.err) { ret err_again; }
            }
            or {
                val err_slept: err[Error] = sleep(s, b);
                if (sel err_slept.err) { ret err_slept; }
            }
        }
    }
    for {
        val opt_top: opt[*u64] = heap.peek[u64, Min](s.waking);
        if (sel opt_top.none) { brk; }
        val first: u64 = @opt_top.some;
        if ((first >> 32) > p::u64) { brk; }
        heap.pop[u64, Min](s.waking);
        val b: u32 = (first & 0xffffffff)::u32;
        if (s.state.data[b] == INACTIVE && s.key.data[b]::u64 == (first >> 32)) {
            unlink(s, s.inactives, b, s.loc.data[b]);
            if (!step(s, b, p)) { s.state.data[b] = HANDLED; }
            or (segments(s, b).data[s.cursor.data[b]].from <= p) {
                val err_woke: err[Error] = activate(s, b);
                if (sel err_woke.err) { ret err_woke; }
            }
            or {
                val err_slept: err[Error] = sleep(s, b);
                if (sel err_slept.err) { ret err_slept; }
            }
        }
    }
    ret err[Error].ok{};
}

# whether one register of a bundle's group is of every class its members are of
fun fits_one(s: *Scan, b: u32, at: u32, key: u32) bool {
    if (location.key_at(s.at, at) != key) { ret false; }
    if (!s.mixed.data[b])                 { ret true; }
    val p:  Physical   = location.physical(s.at, at);
    val ms: Slice[u32] = members(s, b);
    var m:  usize      = 0;
    for (m < ms.size) {
        if (!class.holds(function.class_of(s.f, (ms.data[m])), p)) { ret false; }
        m = m + 1;
    }
    ret true;
}

# whether a bundle's group fits from a location: the location is of every
# class its members are of, and so is every register after it its span
# covers, each one the target lets the allocator assign
fun fits(s: *Scan, b: u32, at: u32, key: u32) bool {
    if (!fits_one(s, b, at, key)) { ret false; }
    var g: u32 = 1;
    for (g < s.span.data[b]) {
        val next: u32 = location.past(s.at, at, g);
        if (next == location.NONE || !allowed.admits(s.allowed, next) || !fits_one(s, b, next, key)) { ret false; }
        g = g + 1;
    }
    ret true;
}

# whether a location's own value, a clobber or another virtual register's pin holds storage a register of bundle `b`'s group from `at` shares over the bundle
fun held(s: *Scan, b: u32, at: u32) bool {
    var g: u32 = 0;
    for (g < s.span.data[b]) {
        if (live.held_any(s.l, s.at, location.past(s.at, at, g), segments(s, b), members(s, b))) { ret true; }
        g = g + 1;
    }
    ret false;
}

# the first bundle linked in `heads` from `w` on whose group covers the
# location `j` registers past the one it is linked at, NONE when none does
fun reaching(s: *Scan, w: u32, j: u32) u32 {
    var at: u32 = w;
    for (at != NONE && s.span.data[at] <= j) { at = s.next.data[at]; }
    ret at;
}

# whether some inactive bundle whose group holds storage location `x` shares meets segments `mine`
fun asleep(s: *Scan, mine: Slice[Segment], x: u32) bool {
    val alias: Slice[u32] = location.shares(s.at, x);
    var k:     usize      = 0;
    for (k < alias.size) {
        var j: u32 = 0;
        for (j < s.widest) {
            val base: u32 = location.before(s.at, alias.data[k], j);
            if (base == location.NONE) { brk; }
            var w: u32 = reaching(s, s.inactives.data[base], j);
            for (w != NONE) {
                val opt_met: opt[u32] = live.meet(mine, ahead(s, w));
                if (sel opt_met.some) { ret true; }
                w = reaching(s, s.next.data[w], j);
            }
            j = j + 1;
        }
        k = k + 1;
    }
    ret false;
}

# whether a location is free for a bundle's group over its whole interval
fun free(s: *Scan, b: u32, at: u32) bool {
    val mine: Slice[Segment] = segments(s, b);
    var g:    u32            = 0;
    for (g < s.span.data[b]) {
        val x: u32 = location.past(s.at, at, g);
        if (s.busy.data[x] != 0 || asleep(s, mine, x)) { ret false; }
        g = g + 1;
    }
    ret !held(s, b, at);
}

# the location a virtual register holds with bundle `b` at location `at`: its
# bundle's location while it holds one, else its pin, else NONE, not chosen yet
fun location_at(s: *Scan, v: Virtual, b: u32, at: u32) u32 {
    val w:  u32 = s.of.data[v];
    val st: u8  = s.state.data[w];
    if (w == b)                                          { ret at; }
    if (st == ACTIVE || st == INACTIVE || st == HANDLED) { ret s.loc.data[w]; }
    if (s.pin.data[w] != CLASH)                          { ret s.pin.data[w]; }
    ret NONE;
}

# operand `o` with each virtual register it names that holds a location with
# bundle `b` at location `at` named by that location, the rest left virtual,
# which masc reads as not chosen yet
fun resolve(s: *Scan, o: Operand, b: u32, at: u32) Operand {
    var names: [operand.MOST_NAMED]Register;
    val n:     u32 = operand.named(o, ?names[0]);
    var i:     u32 = 0;
    for (i < n) {
        val r: Register = names[i];
        if (sel r.virtual) {
            val loc: u32 = location_at(s, r.virtual, b, at);
            if (loc != NONE) { names[i] = Register.physical{location.physical(s.at, loc)}; }
        }
        i = i + 1;
    }
    if (n == 0) { ret o; }
    ret operand.renamed(o, ?names[0]);
}

# the rows of the instructions of a bundle's members that have constraints
# or a grouping to ask, each instruction a member's uses name once
fun ask_of(s: *Scan, b: u32) err[Error] {
    vector.clear[Asked](s.asked);
    val ms: Slice[u32] = members(s, b);
    var m:  usize      = 0;
    for (m < ms.size) {
        val us:   Slice[Use] = live.uses(s.l, (ms.data[m]));
        var last: u32        = NONE;
        var k:    usize      = 0;
        for (k < us.size) {
            val i: Instruction = us.data[k].instruction;
            if (i != last) {
                last = i;
                val d: *InstructionData = function.data(s.f, i);
                var q: u32              = 0;
                for (q < instruction.rows_in(d.opcode)) {
                    if (constraint.asks(s.f, s.ctx, instruction.row_in(d.opcode, q), d.state)) {
                        val err_pushed: err[Error] = pushed(vector.push[Asked](s.asked, Asked{instruction: i, row: q}));
                        if (sel err_pushed.err) { ret err_pushed; }
                    }
                    q = q + 1;
                }
            }
            k = k + 1;
        }
        m = m + 1;
    }
    ret err[Error].ok{};
}

# the first instruction `ask_of` found for a bundle that would not stand
# against its row's constraints with the bundle at a location, and its breach
fun breach(s: *Scan, b: u32, at: u32) opt[Constrained] {
    var k: usize = 0;
    for (k < s.asked.len) {
        val i:     Instruction      = (s.asked.data[k].instruction);
        val q:     u32              = s.asked.data[k].row;
        val d:     *InstructionData = function.data(s.f, i);
        val r:     *rows.Row        = instruction.row_in(d.opcode, q);
        val given: Slice[Operand]   = instruction.operands_in(function.file(s.f), d.opcode, q, d.operands, ?s.room.stated[0]);
        var n:     usize            = given.size;
        if (n > mo.MAX_OPERANDS::usize) { n = mo.MAX_OPERANDS::usize; }
        var j: usize = 0;
        for (j < n) {
            s.room.held[j] = resolve(s, given.data[j], b, at);
            j              = j + 1;
        }
        val read:    mo.Values              = instruction.values_of(function.file(s.f), r, Slice[Operand]{data: ?s.room.held[0], size: n}, ?s.room.values[0]);
        val opt_ask: opt[constraint.Breach] = constraint.ask(s.f, s.ctx, r, d.state, read);
        if (sel opt_ask.some) { ret opt[Constrained].some{Constrained{instruction: i, breach: opt_ask.some}}; }
        k = k + 1;
    }
    ret opt[Constrained].none{};
}

# whether every instruction of a bundle's members stands with the bundle at a location
fun stands(s: *Scan, b: u32, at: u32) bool {
    val opt_breach: opt[Constrained] = breach(s, b, at);
    ret sel opt_breach.none;
}

# the location copies of a member name, free for the bundle and of its
# classes, the location whose copies weigh most in all first, so a location
# both ends of more copies name wins over one only the heaviest names, then
# the earliest copy, then the lowest location
fun hinted(s: *Scan, b: u32, key: u32) res[u32, Error] {
    vector.clear[Hint](s.hints);
    val ms: Slice[u32] = members(s, b);
    var m:  usize      = 0;
    for (m < ms.size) {
        val us: Slice[Use] = live.uses(s.l, (ms.data[m]));
        var k:  usize      = 0;
        for (k < us.size) {
            val u:       Use              = us.data[k];
            val d:       *InstructionData = function.data(s.f, u.instruction);
            val op:      Opcode           = d.opcode;
            var partner: u32              = NONE;
            if (sel op.pseudo && (op.pseudo == pseudo.COPY || op.pseudo == pseudo.PARALLEL_COPY)) {
                val n:    u32 = d.operands.size::u32 / 2;
                var with: u32 = u.operand + n;
                if (u.operand >= n) { with = u.operand - n; }
                val o: Operand = d.operands.data[with];
                if (sel o.virtual) {
                    val other: u32 = s.of.data[o.virtual];
                    val st:    u8  = s.state.data[other];
                    if (st == ACTIVE || st == INACTIVE || st == HANDLED) { partner = s.loc.data[other]; }
                }
                or (sel o.physical) {
                    val res_locate: res[u32, location.Unlocated] = location.locate(s.at, o.physical);
                    if (sel res_locate.err) { ret res[u32, Error].err{Error.unlocated{res_locate.err}}; }
                    partner = res_locate.ok;
                }
            }
            if (partner != NONE && allowed.admits(s.allowed, partner) && fits(s, b, partner, key)) {
                var h: usize = 0;
                for (h < s.hints.len && s.hints.data[h].at != partner) { h = h + 1; }
                if (h == s.hints.len) {
                    val err_pushed: err[Error] = pushed(vector.push[Hint](s.hints, Hint{at: partner, weight: 0, first: u.position}));
                    if (sel err_pushed.err) { ret res[u32, Error].err{err_pushed.err}; }
                }
                s.hints.data[h].weight = s.hints.data[h].weight + u.weight;
                if (u.position < s.hints.data[h].first) { s.hints.data[h].first = u.position; }
            }
            k = k + 1;
        }
        m = m + 1;
    }
    var best: usize = s.hints.len;
    var h:    usize = 0;
    for (h < s.hints.len) {
        val x:      Hint = s.hints.data[h];
        var better: bool = best == s.hints.len;
        if (!better) {
            val y: Hint = s.hints.data[best];
            better = x.weight > y.weight || (x.weight == y.weight && (x.first < y.first || (x.first == y.first && x.at < y.at)));
        }
        if (better && free(s, b, x.at) && stands(s, b, x.at)) { best = h; }
        h = h + 1;
    }
    if (best == s.hints.len) { ret res[u32, Error].ok{NONE}; }
    ret res[u32, Error].ok{s.hints.data[best].at};
}

fun group_of(s: *Scan, b: u32) u32 {
    var x: u32 = b;
    for (s.prefer.data[x] != x) {
        s.prefer.data[x] = s.prefer.data[s.prefer.data[x]];
        x                = s.prefer.data[x];
    }
    ret x;
}

fun prefer_with(s: *Scan, x: u32, y: u32) {
    val rx: u32 = group_of(s, x);
    val ry: u32 = group_of(s, y);
    if (rx == ry) { ret; }
    if (rx < ry)  { s.prefer.data[ry] = rx; }
    or            { s.prefer.data[rx] = ry; }
}

fun copies(op: Opcode) bool {
    if (!(sel op.pseudo)) { ret false; }
    ret op.pseudo == pseudo.COPY || op.pseudo == pseudo.PARALLEL_COPY;
}

# join every two bundles a copy or parallel copy names a value of each of
# in one preference group
fun preferences(s: *Scan) {
    val n: u32 = bundles(s);
    var b: u32 = 0;
    for (b < n) {
        s.prefer.data[b] = b;
        b                = b + 1;
    }
    val count: u32 = s.f.virtuals.len::u32;
    var v:     u32 = 0;
    for (v < count) {
        val us: Slice[Use] = live.uses(s.l, v);
        var k:  usize      = 0;
        for (k < us.size) {
            val u:  Use              = us.data[k];
            val d:  *InstructionData = function.data(s.f, u.instruction);
            val op: Opcode           = d.opcode;
            if (u.write && copies(op)) {
                val o: Operand = d.operands.data[u.operand + d.operands.size::u32 / 2];
                if (sel o.virtual) { prefer_with(s, s.of.data[v], s.of.data[o.virtual]); }
            }
            k = k + 1;
        }
        v = v + 1;
    }
}

# put a placed bundle on its group's list, once, and its location among the group's spots
fun list_placed(s: *Scan, b: u32) err[Error] {
    val g: u32 = group_of(s, b);
    if (!s.listed.data[b]) {
        s.listed.data[b] = true;
        s.placed.data[b] = s.heads.data[g];
        s.heads.data[g]  = b;
    }
    val at: u32 = s.loc.data[b];
    var k:  u32 = s.firsts.data[g];
    for (k != NONE) {
        val spot: *Spot = ?s.spots.data[k];
        if (spot.at == at) {
            if (s.weight.data[b] > spot.weight) { spot.weight = s.weight.data[b]; }
            ret err[Error].ok{};
        }
        k = spot.next;
    }
    k = s.firsts.data[g];
    for (k != NONE) {
        val spot: *Spot = ?s.spots.data[k];
        if (spot.at == NONE) {
            spot.at     = at;
            spot.weight = s.weight.data[b];
            ret err[Error].ok{};
        }
        k = spot.next;
    }
    val err_pushed: err[Error] = pushed(vector.push[Spot](s.spots, Spot{at: at, weight: s.weight.data[b], next: s.firsts.data[g]}));
    if (sel err_pushed.err) { ret err_pushed; }
    s.firsts.data[g] = (s.spots.len - 1)::u32;
    ret err[Error].ok{};
}

# whether a bundle holds the location it was placed at
fun holding(s: *Scan, w: u32) bool {
    val st: u8 = s.state.data[w];
    ret st == ACTIVE || st == INACTIVE || st == HANDLED;
}

# the spot of an evicted bundle's location weighed again over the placed
# bundles of its group still holding it, or given up when none does
fun unlist(s: *Scan, w: u32) {
    val g:  u32 = group_of(s, w);
    val at: u32 = s.loc.data[w];
    var k:  u32 = s.firsts.data[g];
    for (k != NONE && s.spots.data[k].at != at) { k = s.spots.data[k].next; }
    if (k == NONE || s.spots.data[k].weight != s.weight.data[w]) { ret; }
    var found:  bool = false;
    var weight: u64  = 0;
    var x:      u32  = s.heads.data[g];
    for (x != NONE) {
        if (x != w && holding(s, x) && s.loc.data[x] == at && (!found || s.weight.data[x] > weight)) {
            found  = true;
            weight = s.weight.data[x];
        }
        x = s.placed.data[x];
    }
    if (found) { s.spots.data[k].weight = weight; }
    or         { s.spots.data[k].at = NONE; }
}

# the location of a placed bundle of a bundle's preference group, read from
# the group's spots, free for it, of its classes and standing, the heaviest
# such bundle first, then the lowest location, NONE for none
fun grouped(s: *Scan, b: u32, key: u32) u32 {
    var best:   u32 = NONE;
    var weight: u64 = 0;
    var k:      u32 = s.firsts.data[group_of(s, b)];
    for (k != NONE) {
        val spot: Spot = s.spots.data[k];
        if (spot.at != NONE) {
            var better: bool = best == NONE || spot.weight > weight;
            if (!better && spot.weight == weight) { better = spot.at < best; }
            if (better && allowed.admits(s.allowed, spot.at) && fits(s, b, spot.at, key) && free(s, b, spot.at) && stands(s, b, spot.at)) {
                best   = spot.at;
                weight = spot.weight;
            }
        }
        k = spot.next;
    }
    ret best;
}

# a bundle listed as a conflict once
fun conflict(s: *Scan, w: u32) err[Error] {
    if (s.marked.data[w]) { ret err[Error].ok{}; }
    s.marked.data[w] = true;
    ret pushed(vector.push[u32](s.conflicts, w));
}

# the bundles whose groups hold storage a register of a bundle's group from
# a location shares, that the bundle would meet, each listed once
fun gather(s: *Scan, b: u32, at: u32) err[Error] {
    vector.clear[u32](s.conflicts);
    val mine:      Slice[Segment] = segments(s, b);
    var err_found: err[Error]     = err[Error].ok{};
    var g:         u32            = 0;
    for (g < s.span.data[b] && sel err_found.ok) {
        val alias: Slice[u32] = location.shares(s.at, location.past(s.at, at, g));
        var k:     usize      = 0;
        for (k < alias.size && sel err_found.ok) {
            var j: u32 = 0;
            for (j < s.widest && sel err_found.ok) {
                val base: u32 = location.before(s.at, alias.data[k], j);
                if (base == location.NONE) { brk; }
                var w: u32 = reaching(s, s.actives.data[base], j);
                for (w != NONE && sel err_found.ok) {
                    err_found = conflict(s, w);
                    w         = reaching(s, s.next.data[w], j);
                }
                w = reaching(s, s.inactives.data[base], j);
                for (w != NONE && sel err_found.ok) {
                    val opt_met: opt[u32] = live.meet(mine, ahead(s, w));
                    if (sel opt_met.some) { err_found = conflict(s, w); }
                    w = reaching(s, s.next.data[w], j);
                }
                j = j + 1;
            }
            k = k + 1;
        }
        g = g + 1;
    }
    var c: usize = 0;
    for (c < s.conflicts.len) {
        s.marked.data[s.conflicts.data[c]] = false;
        c                                  = c + 1;
    }
    ret err_found;
}

# carry every member of bundle `b` that is not a half's own value in pieces, false when there is none, refused when one covers several registers
fun spill_members(s: *Scan, b: u32) res[bool, Error] {
    var any: bool       = false;
    val ms:  Slice[u32] = members(s, b);
    var m:   usize      = 0;
    for (m < ms.size) {
        if (s.kinds.data[ms.data[m]] != spill.OWN) {
            val err_carried: err[Error] = whole(s, ms.data[m]);
            if (sel err_carried.err) { ret res[bool, Error].err{err_carried.err}; }
            val err_pushed: err[Error] = pushed(vector.push[u32](?s.out.spilled, ms.data[m]));
            if (sel err_pushed.err) { ret res[bool, Error].err{err_pushed.err}; }
            any = true;
        }
        m = m + 1;
    }
    ret res[bool, Error].ok{any};
}

# take assigned bundle `w` out of its location and carry its members that are not a half's own value in pieces, refused when one covers several registers
fun evict(s: *Scan, w: u32) err[Error] {
    if (s.state.data[w] == ACTIVE) { deactivate(s, w); }
    or                             { unlink(s, s.inactives, w, s.loc.data[w]); }
    s.state.data[w] = SPILLED;
    unlist(s, w);
    val res_spilled: res[bool, Error] = spill_members(s, w);
    if (sel res_spilled.err) { ret err[Error].err{res_spilled.err}; }
    ret err[Error].ok{};
}

# whether placing a bundle at a location would make the frame save a
# preserved register no bundle the round placed has made it save yet
fun saves(s: *Scan, b: u32, at: u32) bool {
    var g: u32 = 0;
    for (g < s.span.data[b]) {
        val alias: Slice[u32] = location.shares(s.at, location.past(s.at, at, g));
        var k:     usize      = 0;
        for (k < alias.size) {
            if (allowed.preserved(s.allowed, alias.data[k]) && !s.opened.data[alias.data[k]]) { ret true; }
            k = k + 1;
        }
        g = g + 1;
    }
    ret false;
}

fun open_saves(s: *Scan, b: u32) {
    var g: u32 = 0;
    for (g < s.span.data[b]) {
        val alias: Slice[u32] = location.shares(s.at, location.past(s.at, s.loc.data[b], g));
        var k:     usize      = 0;
        for (k < alias.size) {
            if (allowed.preserved(s.allowed, alias.data[k])) { s.opened.data[alias.data[k]] = true; }
            k = k + 1;
        }
        g = g + 1;
    }
}

fun assign(s: *Scan, b: u32, at: u32) err[Error] {
    s.loc.data[b]    = at;
    s.cursor.data[b] = 0;
    open_saves(s, b);
    val err_listed: err[Error] = list_placed(s, b);
    if (sel err_listed.err) { ret err_listed; }
    ret activate(s, b);
}

# split a bundle no location takes: a pinned one's pins get values of their
# own, any other is carried in pieces
fun split(s: *Scan, b: u32) err[Error] {
    s.state.data[b] = SPILLED;
    if (s.pin.data[b] != NONE) {
        val res_freed: res[bool, Error] = free_pins(s, b);
        if (sel res_freed.err) { ret err[Error].err{res_freed.err}; }
        if (res_freed.ok)      { ret err[Error].ok{}; }
    }
    val res_spilled: res[bool, Error] = spill_members(s, b);
    if (sel res_spilled.err) { ret err[Error].err{res_spilled.err}; }
    if (!res_spilled.ok)     { ret err[Error].err{Error.stuck{Stuck{virtual: (members(s, b).data[0]), position: segments(s, b).data[0].from}}}; }
    ret err[Error].ok{};
}

# the densest conflicting bundle's weight and positions at a location, none
# when a value it cannot evict holds it
rec Cost {
    weight: u64;
    size:   u64;
}

# the weight and positions of the densest bundle that bundle `b` would evict at location `at`, none when a held value, a bundle only of a half's own values or a group of a span past one stands there
fun cost(s: *Scan, b: u32, at: u32) res[opt[Cost], Error] {
    if (held(s, b, at)) { ret res[opt[Cost], Error].ok{opt[Cost].none{}}; }
    val err_gather: err[Error] = gather(s, b, at);
    if (sel err_gather.err) { ret res[opt[Cost], Error].err{err_gather.err}; }
    var c: Cost  = Cost{weight: 0, size: 1};
    var k: usize = 0;
    for (k < s.conflicts.len) {
        val w: u32 = s.conflicts.data[k];
        if (s.minimal.data[w] || s.span.data[w] > 1)                  { ret res[opt[Cost], Error].ok{opt[Cost].none{}}; }
        if (less(c.weight, c.size, s.weight.data[w], s.size.data[w])) { c = Cost{weight: s.weight.data[w], size: s.size.data[w]}; }
        k = k + 1;
    }
    ret res[opt[Cost], Error].ok{opt[Cost].some{c}};
}

# give bundle `b` a location: its pin or a copy's, a free one, one taken by eviction, or else split it
fun place(s: *Scan, b: u32) err[Error] {
    val ms:        Slice[u32] = members(s, b);
    val start:     u32        = segments(s, b).data[0].from;
    val err_moved: err[Error] = advance(s, start);
    if (sel err_moved.err) { ret err_moved; }
    val opt_key: opt[u32]   = location.key(s.at, function.class_of(s.f, (ms.data[0])));
    var cands:   Slice[u32] = Slice[u32]{data: nil, size: 0};
    var one:     [1]u32     = [1]u32{s.pin.data[b]};
    if (s.pin.data[b] != NONE) { cands = Slice[u32]{data: ?one[0], size: 1}; }
    or (sel opt_key.some)      { cands = allowed.candidates(s.allowed, opt_key.some); }
    var key: u32 = NONE;
    if (sel opt_key.some) { key = opt_key.some; }
    val err_asked: err[Error] = ask_of(s, b);
    if (sel err_asked.err) { ret err_asked; }
    if (s.pin.data[b] == NONE && key != NONE) {
        val res_hint: res[u32, Error] = hinted(s, b, key);
        if (sel res_hint.err)    { ret err[Error].err{res_hint.err}; }
        if (res_hint.ok != NONE) { ret assign(s, b, res_hint.ok); }
        val near: u32 = grouped(s, b, key);
        if (near != NONE) { ret assign(s, b, near); }
    }
    vector.clear[u8](s.standing);
    val err_room: err[allocator.Error] = slice.fill[u8](s.standing, cands.size, UNFIT);
    if (sel err_room.err) { ret alloc_err(err_room.err); }
    # a location is asked against the constraints only once it is free, or
    # once none free stands and every fitting one is weighed for eviction
    # a free location that would make the frame save a preserved register
    # nothing placed has made it save yet is taken only when no free one
    # costs nothing
    var opt_first: opt[Constrained] = opt[Constrained].none{};
    var fit:       usize            = cands.size;
    var saving:    u32              = NONE;
    var i:         usize            = 0;
    for (i < cands.size) {
        val at: u32 = cands.data[i];
        if (fits(s, b, at, key)) {
            if (fit == cands.size) { fit = i; }
            s.standing.data[i] = UNASKED;
            if (free(s, b, at)) {
                val opt_breach: opt[Constrained] = breach(s, b, at);
                if (i == fit) { opt_first = opt_breach; }
                s.standing.data[i] = BREAKS;
                if (sel opt_breach.none) {
                    if (!saves(s, b, at)) { ret assign(s, b, at); }
                    if (saving == NONE)   { saving = at; }
                    s.standing.data[i] = STANDS;
                }
            }
        }
        i = i + 1;
    }
    if (saving != NONE) { ret assign(s, b, saving); }
    var stood: bool = false;
    i = 0;
    for (i < cands.size) {
        if (s.standing.data[i] == UNASKED) {
            val opt_breach: opt[Constrained] = breach(s, b, cands.data[i]);
            if (i == fit) { opt_first = opt_breach; }
            s.standing.data[i] = BREAKS;
            if (sel opt_breach.none) {
                s.standing.data[i] = STANDS;
                stood              = true;
            }
        }
        i = i + 1;
    }
    if (!stood) {
        if (sel opt_first.some) { ret err[Error].err{Error.constrained{opt_first.some}}; }
    }
    var best:  u32  = NONE;
    var worst: Cost = Cost{weight: 0, size: 1};
    i = 0;
    for (i < cands.size) {
        val at: u32 = cands.data[i];
        if (s.standing.data[i] == STANDS) {
            val res_cost: res[opt[Cost], Error] = cost(s, b, at);
            if (sel res_cost.err) { ret err[Error].err{res_cost.err}; }
            val opt_cost: opt[Cost] = res_cost.ok;
            if (sel opt_cost.some) {
                if (best == NONE || less(opt_cost.some.weight, opt_cost.some.size, worst.weight, worst.size)) {
                    best  = at;
                    worst = opt_cost.some;
                }
            }
        }
        i = i + 1;
    }
    if (best != NONE && (s.minimal.data[b] || less(worst.weight, worst.size, s.weight.data[b], s.size.data[b]))) {
        val err_gather: err[Error] = gather(s, b, best);
        if (sel err_gather.err) { ret err_gather; }
        var c: usize = 0;
        for (c < s.conflicts.len) {
            val err_out: err[Error] = evict(s, s.conflicts.data[c]);
            if (sel err_out.err) { ret err_out; }
            c = c + 1;
        }
        ret assign(s, b, best);
    }
    ret split(s, b);
}

# the bundles with segments in start order, the bundle number breaking a tie
fun start_order(s: *Scan) err[Error] {
    var b: u32 = 0;
    for (b < bundles(s)) {
        val segs: Slice[Segment] = segments(s, b);
        if (segs.size > 0) {
            val err_pushed: err[Error] = pushed(vector.push[u64](s.order, entry(segs.data[0].from, b)));
            if (sel err_pushed.err) { ret err_pushed; }
        }
        b = b + 1;
    }
    sort.sort[u64](s.order.data, s.order.len);
    ret err[Error].ok{};
}

# place every bundle in start order
fun walk(s: *Scan) err[Error] {
    val n:          usize                = bundles(s)::usize;
    val places:     usize                = location.count(s.at)::usize;
    var err_failed: err[allocator.Error] = slice.fill[u32](s.loc, n, NONE);
    keep(?err_failed, slice.fill[u8](s.state, n, WAITING));
    keep(?err_failed, slice.fill[u32](s.cursor, n, 0));
    keep(?err_failed, slice.fill[u32](s.key, n, 0));
    keep(?err_failed, slice.fill[u32](s.next, n, NONE));
    keep(?err_failed, slice.fill[u32](s.prev, n, NONE));
    keep(?err_failed, slice.fill[u32](s.actives, places, NONE));
    keep(?err_failed, slice.fill[u32](s.inactives, places, NONE));
    keep(?err_failed, slice.fill[u32](s.busy, places, 0));
    keep(?err_failed, slice.fill[bool](s.opened, places, false));
    keep(?err_failed, slice.fill[u32](s.prefer, n, 0));
    keep(?err_failed, slice.fill[u32](s.placed, n, NONE));
    keep(?err_failed, slice.fill[u32](s.heads, n, NONE));
    keep(?err_failed, slice.fill[bool](s.listed, n, false));
    vector.clear[Spot](s.spots);
    keep(?err_failed, slice.fill[u32](s.firsts, n, NONE));
    if (sel err_failed.err) { ret alloc_err(err_failed.err); }
    preferences(s);
    val err_ordered: err[Error] = start_order(s);
    if (sel err_ordered.err) { ret err_ordered; }
    var i: usize = 0;
    for (i < s.order.len) {
        val err_placed: err[Error] = place(s, (s.order.data[i] & 0xffffffff)::u32);
        if (sel err_placed.err) { ret err_placed; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun by_number(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# each virtual register's location from its bundle's, and the spilled registers sorted
fun finish(s: *Scan) err[Error] {
    val count:      usize                = s.f.virtuals.len;
    val err_filled: err[allocator.Error] = slice.fill[u32](?s.out.locations, count, NONE);
    if (sel err_filled.err) { ret alloc_err(err_filled.err); }
    var v: usize = 0;
    for (v < count) {
        val b:  u32 = s.of.data[v];
        val st: u8  = s.state.data[b];
        if (st == ACTIVE || st == INACTIVE || st == HANDLED) { s.out.locations.data[v] = s.loc.data[b]; }
        v = v + 1;
    }
    sort.sort_by[u32](s.out.spilled.data, s.out.spilled.len, by_number);
    ret err[Error].ok{};
}

# join the ties, group the bundles, describe and walk them, stopping once any half is given a value of its own
fun steps(s: *Scan) err[Error] {
    val count:      usize                = s.f.virtuals.len;
    val err_filled: err[allocator.Error] = slice.fill[u32](s.parent, count, 0);
    if (sel err_filled.err) { ret alloc_err(err_filled.err); }
    var v: usize = 0;
    for (v < count) {
        s.parent.data[v] = v::u32;
        v                = v + 1;
    }
    val err_tied: err[Error] = ties(s);
    if (sel err_tied.err)   { ret err_tied; }
    if (s.out.own.len != 0) { ret err[Error].ok{}; }
    val err_grouped: err[Error] = group(s);
    if (sel err_grouped.err) { ret err_grouped; }
    val err_clashes: err[Error] = split_clashes(s);
    if (sel err_clashes.err) { ret err_clashes; }
    if (s.out.own.len != 0)  { ret err[Error].ok{}; }
    val err_described: err[Error] = describe(s);
    if (sel err_described.err) { ret err_described; }
    if (s.out.own.len != 0)    { ret err[Error].ok{}; }
    val err_walked: err[Error] = walk(s);
    if (sel err_walked.err) { ret err_walked; }
    ret finish(s);
}

# storage for scans, holding none yet
pub fun scratch(a: *allocator.Allocator) Scratch {
    ret Scratch{
        parent:    vector.init[u32](a),
        of:        vector.init[u32](a),
        members:   graph.lists_init[u32](a),
        segs:      graph.lists_init[Segment](a),
        clashed:   vector.init[bool](a),
        weight:    vector.init[u64](a),
        size:      vector.init[u64](a),
        span:      vector.init[u32](a),
        marked:    vector.init[bool](a),
        pin:       vector.init[u32](a),
        minimal:   vector.init[bool](a),
        mixed:     vector.init[bool](a),
        order:     vector.init[u64](a),
        loc:       vector.init[u32](a),
        state:     vector.init[u8](a),
        cursor:    vector.init[u32](a),
        key:       vector.init[u32](a),
        next:      vector.init[u32](a),
        prev:      vector.init[u32](a),
        actives:   vector.init[u32](a),
        inactives: vector.init[u32](a),
        busy:      vector.init[u32](a),
        opened:    vector.init[bool](a),
        prefer:    vector.init[u32](a),
        placed:    vector.init[u32](a),
        heads:     vector.init[u32](a),
        listed:    vector.init[bool](a),
        spots:     vector.init[Spot](a),
        firsts:    vector.init[u32](a),
        hints:     vector.init[Hint](a),
        rising:    heap.init[u64, Min](a),
        waking:    heap.init[u64, Min](a),
        conflicts: vector.init[u32](a),
        standing:  vector.init[u8](a),
        asked:     vector.init[Asked](a),
        named:     vector.init[u32](a),
        mkeys:     vector.init[u32](a),
        mvals:     vector.init[u32](a),
        skeys:     vector.init[u32](a),
        svals:     vector.init[Segment](a),
        grouped:   graph.lists_init[Segment](a),
    };
}

# give back the storage of scans
pub fun scratch_dnit(w: *Scratch) err[allocator.Error] {
    var err_failed: err[allocator.Error] = vector.dnit[u32](?w.parent);
    keep(?err_failed, vector.dnit[u32](?w.of));
    keep(?err_failed, graph.lists_dnit[u32](?w.members));
    keep(?err_failed, graph.lists_dnit[Segment](?w.segs));
    keep(?err_failed, vector.dnit[bool](?w.clashed));
    keep(?err_failed, vector.dnit[u64](?w.weight));
    keep(?err_failed, vector.dnit[u64](?w.size));
    keep(?err_failed, vector.dnit[u32](?w.span));
    keep(?err_failed, vector.dnit[bool](?w.marked));
    keep(?err_failed, vector.dnit[u32](?w.pin));
    keep(?err_failed, vector.dnit[bool](?w.minimal));
    keep(?err_failed, vector.dnit[bool](?w.mixed));
    keep(?err_failed, vector.dnit[u64](?w.order));
    keep(?err_failed, vector.dnit[u32](?w.loc));
    keep(?err_failed, vector.dnit[u8](?w.state));
    keep(?err_failed, vector.dnit[u32](?w.cursor));
    keep(?err_failed, vector.dnit[u32](?w.key));
    keep(?err_failed, vector.dnit[u32](?w.next));
    keep(?err_failed, vector.dnit[u32](?w.prev));
    keep(?err_failed, vector.dnit[u32](?w.actives));
    keep(?err_failed, vector.dnit[u32](?w.inactives));
    keep(?err_failed, vector.dnit[u32](?w.busy));
    keep(?err_failed, vector.dnit[bool](?w.opened));
    keep(?err_failed, vector.dnit[u32](?w.prefer));
    keep(?err_failed, vector.dnit[u32](?w.placed));
    keep(?err_failed, vector.dnit[u32](?w.heads));
    keep(?err_failed, vector.dnit[bool](?w.listed));
    keep(?err_failed, vector.dnit[Spot](?w.spots));
    keep(?err_failed, vector.dnit[u32](?w.firsts));
    keep(?err_failed, vector.dnit[Hint](?w.hints));
    keep(?err_failed, heap.dnit[u64, Min](?w.rising));
    keep(?err_failed, heap.dnit[u64, Min](?w.waking));
    keep(?err_failed, vector.dnit[u32](?w.conflicts));
    keep(?err_failed, vector.dnit[u8](?w.standing));
    keep(?err_failed, vector.dnit[Asked](?w.asked));
    keep(?err_failed, vector.dnit[u32](?w.named));
    keep(?err_failed, vector.dnit[u32](?w.mkeys));
    keep(?err_failed, vector.dnit[u32](?w.mvals));
    keep(?err_failed, vector.dnit[u32](?w.skeys));
    keep(?err_failed, vector.dnit[Segment](?w.svals));
    keep(?err_failed, graph.lists_dnit[Segment](?w.grouped));
    ret err_failed;
}

fun lists_clear[T](l: *Lists[T]) {
    vector.clear[u32](?l.first);
    vector.clear[T](?l.items);
}

fun drain(h: *Heap[u64, Min]) {
    for {
        val opt_top: opt[u64] = heap.pop[u64, Min](h);
        if (sel opt_top.none) { ret; }
    }
}

# every table of the scratch emptied, its storage kept
fun begin(w: *Scratch) {
    vector.clear[u32](?w.parent);
    vector.clear[u32](?w.of);
    lists_clear[u32](?w.members);
    lists_clear[Segment](?w.segs);
    vector.clear[bool](?w.clashed);
    vector.clear[u64](?w.weight);
    vector.clear[u64](?w.size);
    vector.clear[u32](?w.span);
    vector.clear[bool](?w.marked);
    vector.clear[u32](?w.pin);
    vector.clear[bool](?w.minimal);
    vector.clear[bool](?w.mixed);
    vector.clear[u64](?w.order);
    vector.clear[u32](?w.loc);
    vector.clear[u8](?w.state);
    vector.clear[u32](?w.cursor);
    vector.clear[u32](?w.key);
    vector.clear[u32](?w.next);
    vector.clear[u32](?w.prev);
    vector.clear[u32](?w.actives);
    vector.clear[u32](?w.inactives);
    vector.clear[u32](?w.busy);
    vector.clear[bool](?w.opened);
    vector.clear[u32](?w.prefer);
    vector.clear[u32](?w.placed);
    vector.clear[u32](?w.heads);
    vector.clear[bool](?w.listed);
    vector.clear[Spot](?w.spots);
    vector.clear[u32](?w.firsts);
    vector.clear[Hint](?w.hints);
    drain(?w.rising);
    drain(?w.waking);
    vector.clear[u32](?w.conflicts);
    vector.clear[u8](?w.standing);
    vector.clear[Asked](?w.asked);
    vector.clear[u32](?w.named);
    vector.clear[u32](?w.mkeys);
    vector.clear[u32](?w.mvals);
    vector.clear[u32](?w.skeys);
    vector.clear[Segment](?w.svals);
    lists_clear[Segment](?w.grouped);
}

# a result of no round, holding no storage, for `run` to fill
pub fun init(a: *allocator.Allocator) Result {
    ret Result{locations: vector.init[u32](a), spilled: vector.init[u32](a), own: vector.init[Half](a)};
}

# one round's scan over a virtual form
# ---
# w:       the storage it works in
# out:     what the round decided, filled in place of what it held, of no
#          use after a refusal
# f:       the virtual form
# ctx:     the context masc's groupings are asked under
# l:       its liveness
# at:      the locations of its target
# allowed: the locations the target lets the allocator assign
# kinds:   each virtual register's kind, as the form states it
# ret:     ok, or why the round was refused
pub fun run(w: *Scratch, out: *Result, f: *Function, ctx: *core_state.Context, l: *Live, at: *Locations, allowed: *Allowed, kinds: Slice[u8]) err[Error] {
    begin(w);
    vector.clear[u32](?out.locations);
    vector.clear[u32](?out.spilled);
    vector.clear[Half](?out.own);
    var room: Room;
    var s:    Scan = Scan{
        f:         f,
        ctx:       ctx,
        l:         l,
        at:        at,
        allowed:   allowed,
        kinds:     kinds,
        out:       out,
        w:         w,
        parent:    ?w.parent,
        of:        ?w.of,
        members:   ?w.members,
        segs:      ?w.segs,
        clashed:   ?w.clashed,
        weight:    ?w.weight,
        size:      ?w.size,
        span:      ?w.span,
        widest:    1,
        marked:    ?w.marked,
        pin:       ?w.pin,
        minimal:   ?w.minimal,
        mixed:     ?w.mixed,
        order:     ?w.order,
        loc:       ?w.loc,
        state:     ?w.state,
        cursor:    ?w.cursor,
        key:       ?w.key,
        next:      ?w.next,
        prev:      ?w.prev,
        actives:   ?w.actives,
        inactives: ?w.inactives,
        busy:      ?w.busy,
        opened:    ?w.opened,
        prefer:    ?w.prefer,
        placed:    ?w.placed,
        heads:     ?w.heads,
        listed:    ?w.listed,
        spots:     ?w.spots,
        firsts:    ?w.firsts,
        hints:     ?w.hints,
        rising:    ?w.rising,
        waking:    ?w.waking,
        conflicts: ?w.conflicts,
        standing:  ?w.standing,
        asked:     ?w.asked,
        room:      ?room,
    };
    ret steps(?s);
}

# give back a result's storage
pub fun dnit(r: *Result) err[allocator.Error] {
    var err_failed: err[allocator.Error] = vector.dnit[u32](?r.locations);
    keep(?err_failed, vector.dnit[u32](?r.spilled));
    keep(?err_failed, vector.dnit[Half](?r.own));
    ret err_failed;
}

# whether a round's assignment stands, with nothing spilled and no half
# given a value of its own
pub fun settled(r: *Result) bool {
    ret r.spilled.len == 0 && r.own.len == 0;
}
