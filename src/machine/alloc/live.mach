# liveness and the live intervals a register allocator reads
#
# instructions are numbered in one linear order: the blocks in reverse
# postorder of the graph view, then every block the entry does not reach in
# its own order. instruction n has two positions, its use slot 2n, where it
# reads, and its def slot 2n + 1, where it writes, so a value one instruction
# reads and a value it writes never overlap and may share a location. a loop
# writes before it has read all it reads, so its writes take its use slot and
# share a location with none of its reads. a register a step reads is read by
# the loop only when no earlier step writes it, and of its steps' flags only
# the writes show, since a step reads only flags an earlier step wrote. a
# segment is the positions from `from` up to, not including, `to`, and a block
# spans from the use slot of its first instruction to the use slot after its
# last.
#
# liveness is the backward dataflow over the graph view, one bit for each
# virtual register and each location the function touches, so its sets are
# sized by the function and not by the register file: a location is numbered
# as an instruction first names it, as a register of its effects, a physical
# operand, a physical half of a tie or an implicit location, and `Known` holds
# that numbering and its way back to the locations for every round. a
# location of a clobber set that no instruction names holds no value any
# instruction reads, so the dataflow leaves it out. the machine form has no
# block parameters: an edge's parallel copy reads every source at its use slot and
# writes every destination at its def slot, so the copies on edges are the
# uses and a destination is defined where its copy stands.
#
# a virtual register's interval is its segments, sorted and disjoint, with a
# hole wherever its value is dead inside its range, and its uses in position
# order, each weighted by the loop depth of its block. a location's holds are
# where it is not free: where it holds a value of its own, read or written by
# the instruction as masc's footprint states it, register or flag, or a
# location the instruction or the caller states, and the slot a virtual
# register is pinned to it at, by its row's fixed register or the physical
# half of a tie. holds of one location never overlap, and a function holding
# two values in one location at one position is refused. the clobbers the
# caller states at a call are one set, a mask over the register rows, held
# as one mark over the call's def slot, not as a hold of each register: a
# location of the set is held there as by a hold of its own, and one a later
# instruction reads holds the value the call left it to that read.
#
# every register and flag a row's instruction touches comes from masc's
# footprint of its operand values under the context and the configuration it
# states, read once per function as its effects (`mirl.machine.effects`), which
# the caller hands the first round: each physical operand's whole group, as both registers of an even
# pair, the implicit registers its values decide and its flags. its reads are
# live in, and every register of its written and every flag it leaves
# unspecified is a kill and a new definition after the reads, since masc
# states a write that may keep any of the old value as a read as well. an
# instruction whose footprint masc leaves undecided refuses the liveness, and
# so does one whose grouping is refused. a pseudo's physical operands are one
# register each. a virtual operand is read and written by its role under the
# state the instruction states (`instruction.stated_role`), so a risc-v vector
# destination a tail agnostic, unmasked vtype leaves only written is not live
# before its instruction.
#
# a value whose group covers several registers, as a vector group under a
# multiplier of two, is one virtual register of the tuple class masc names
# for the group, whose location's storage is every register of it, so it
# covers them all through the locations' sharing, and one of any other class
# there refuses the liveness (`constraint.grouped`). a list's virtual first
# names a value covering the whole list, the one value of several registers
# of its class: its span is the most members a list naming it holds.
#
# a physical write ends the value of the location it names and of every
# location sharing its storage that the write leaves no bit of, by the storage
# model's kills over masc's footprint: a write of a low part that zeroes the
# rest ends the whole's value, and one that keeps the rest keeps it, which
# masc states as a read as well. a write through a view of a virtual register, an operand naming it at
# a position of a class viewed within its own, ends its value only where the
# view's write kills the whole, and is a read of it otherwise. a copy's write
# of a member of a virtual register of a tuple class is a read of it as well,
# since it keeps the other members, unless the one instruction writes every
# member, which together end its value. an instruction naming one virtual
# register through several members reads and writes it once.
#
# the rounds of an allocation compute the liveness of forms of one function,
# and what its first round gathered holds for the rest (`Known`). a form has
# the input's blocks and edges, so its block order and loop depths. a virtual
# operand reaches masc as no value, whatever its number, so an instruction a
# form carries with its operands renamed keeps its registers' and flags'
# events, and one carried unchanged keeps all it has, since a form keeps the
# input's virtual registers at their numbers. only an event's location moves,
# by the virtual registers the form added. an instruction a form inserted is a
# pseudo, with no row, implicit location or clobber, and is gathered anew.
#
# with b blocks, n instructions, e operand and effect events, v virtual
# registers and l locations the function touches, liveness takes O(b) passes
# of O(b (v + l) / 64) each, intervals O(e + b (v + l) / 64), and the holds
# O(h log h) and a pass over every location. a cover query is O(log s) in an
# interval's segments, the next use O(log u) in its uses, overlap O(s + t) in
# two intervals' segments, and blocked the sum over
# the locations sharing storage of O(s + h log o) in their holds and owners.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.cfg.loops;
use mirl.ir.cfg.loops.Loops;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Physical;
use mirl.machine.constraint;
use mirl.machine.constraint.Constrained;
use mirl.machine.effects;
use mirl.machine.effects.Effects;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.instruction.Undecided;
use mirl.machine.operand;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Tied;
use mirl.machine.operand.Virtual;
use mirl.machine.storage;

use mc: masc.core.constraint;
use masc.core.effect;
use mo:         masc.core.operand;
use rf:         masc.core.register;
use rows:       masc.core.row;
use core_state: masc.core.state;

# no position, virtual register, location or operand
pub val NONE: u32 = 0xffffffff;

# how many times one loop level weighs the level outside it, as a shift
pub val LEVEL_SHIFT: u32 = 3;

# the deepest loop level a weight tells apart, which keeps a sum of weights far from overflow
pub val DEPTH_CAP: u32 = 8;

# positions from `from` up to, not including, `to`
pub rec Segment {
    from: u32;
    to:   u32;
}

# positions a location is not free over
# ---
# from:  the first position
# to:    one past the last
# owner: the virtual register pinned to it there, NONE when the location
#        holds a value of its own
pub rec Hold {
    from:  u32;
    to:    u32;
    owner: u32;
}

# one read or write of a virtual register
# ---
# position:    the use slot of a read, the def slot of a write
# weight:      eight to the power of its block's loop depth, capped at DEPTH_CAP levels
# write:       whether it writes the register
# instruction: the instruction
# operand:     the operand position
# fixed:       the location it must be in there, NONE when it may be in any of its class
# tied:        the virtual register tied to it there, NONE when none is
pub rec Use {
    position:    u32;
    weight:      u64;
    write:       bool;
    instruction: Instruction;
    operand:     u32;
    fixed:       u32;
    tied:        u32;
}

# the set of locations an instruction leaves undefined beyond what its row
# states, as a calling convention's clobbers at a call
# ---
# instruction: the instruction
# set:         the set, numbered in its Clobbers
pub rec Clobber {
    instruction: Instruction;
    set:         u32;
}

# the locations a function's instructions leave undefined beyond their rows:
# a few sets, each a mask over the register rows the locations number first,
# and the set each instruction names, so a call's clobbers are one set however
# many registers it holds
# ---
# words: the words of one set's mask, one bit per register row
# masks: each set's mask, `words` words each
# calls: each instruction and the set it leaves undefined
pub rec Clobbers {
    words: u32;
    masks: Slice[u64];
    calls: Slice[Clobber];
}

# a set of clobbers held over one position, the def slot of its instruction
# ---
# position: the position
# set:      the set, numbered as the liveness's masks are
pub rec Mark {
    position: u32;
    set:      u32;
}

# no clobbers at all
pub fun unclobbered() Clobbers {
    ret Clobbers{words: 0, masks: Slice[u64]{data: nil, size: 0}, calls: Slice[Clobber]{data: nil, size: 0}};
}

# an operand, or an instruction as a whole when operand is NONE
pub rec Site {
    instruction: Instruction;
    operand:     u32;
}

# a location of a site the locations refused
# ---
# site: the operand, or the instruction for a location it states
# why:  why the locations refused it
pub rec Unplaced {
    site: Site;
    why:  location.Unlocated;
}

# two values held in one location at one position
pub rec Conflict {
    location: u32;
    position: u32;
}

# why liveness was refused
# ---
# alloc:     the allocator refused storage
# foreign:   the locations are of another register file than the function's
# unlocated: an effect register or a clobber the locations do not number,
#            or a clobber naming a set the clobbers do not have
# refused:   a register or cell of an operand or a stated location that the
#            locations refused, and why
# conflict:  two values held in one location at one position
# ungrouped: an instruction whose grouping is refused, and why
# undecided: an instruction whose footprint masc leaves undecided, and why
# size:      the positions do not fit
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    unlocated: Site;
    refused:   Unplaced;
    conflict:  Conflict;
    ungrouped: Constrained;
    undecided: Undecided;
    size;
}

# the liveness of a function
# ---
# virtuals: how many virtual registers there are
# order:    the blocks in linear order
# starts:   each block's first position
# ends:     each block's position past its last
# numbers:  each instruction's place in linear order, NONE when no block holds it
# segments: each virtual register's segments, sorted and disjoint
# uses:     each virtual register's uses, in position order
# weights:  each virtual register's uses' weights summed
# holds:    each location's holds, sorted and disjoint, but for clobbers
# words:    the words of one clobber set's mask
# masks:    each clobber set's mask over the register rows
# any:      the mask of the rows any clobber set holds
# marks:    each clobber set held, by position, ascending: the holds of
#           every location of its set over the position
# spans:    each virtual register's span, the registers of its class its
#           value covers from its location, past one only for a list's first
pub rec Live {
    virtuals: u32;
    order:    vector.Vector[u32];
    starts:   vector.Vector[u32];
    ends:     vector.Vector[u32];
    numbers:  vector.Vector[u32];
    segments: Lists[Segment];
    uses:     Lists[Use];
    weights:  vector.Vector[u64];
    holds:    Lists[Hold];
    words:    u32;
    masks:    vector.Vector[u64];
    any:      vector.Vector[u64];
    marks:    vector.Vector[Mark];
    spans:    vector.Vector[u32];
}

# one read or write an instruction makes
# ---
# value:   a virtual register's index, or the virtual count plus a touched
#          location's number
# write:   whether it writes, which ends the value held before it
# early:   a write at the use slot, a loop's
# operand: the operand position, NONE for an effect or a clobber
# fixed:   the location a virtual register is pinned to, NONE
# tied:    the virtual register tied to it, NONE
# set:     a clobber set, whose every location the event writes, value
#          NONE, or NONE for an event of one value
pub rec Event {
    value:   u32;
    write:   bool;
    early:   bool;
    operand: u32;
    fixed:   u32;
    tied:    u32;
    set:     u32;
}

# what the first round of a function's allocation knows that holds for each
# form of it, as the file's head says, empty until that round fills it
# ---
# ready:    whether the first round has filled it
# virtuals: the first round's virtual registers, the values below locations
# graph:    the blocks' edges
# order:    the blocks in linear order
# depths:   each block's loop depth
# numbers:  each instruction's place in linear order
# events:   the reads and writes of the instructions, in linear order
# first:    each place's first event, then one past the last
# tails:    each place's first event past its operands' own
# spans:    each virtual register's span
# index:    each location's number among those the function touches, NONE
#           for one it does not
# touched:  each touched location, by its number
pub rec Known {
    ready:    bool;
    virtuals: u32;
    graph:    Graph;
    order:    vector.Vector[u32];
    depths:   vector.Vector[u32];
    numbers:  vector.Vector[u32];
    events:   vector.Vector[Event];
    first:    vector.Vector[u32];
    tails:    vector.Vector[u32];
    spans:    vector.Vector[u32];
    index:    vector.Vector[u32];
    touched:  vector.Vector[u32];
}

# how a form stands to the function a `Known` was filled from
# ---
# sources: each of its instructions' instruction there, spill.NONE for one
#          inserted
# renamed: whether each of its instructions names other values than its source
pub rec Carried {
    sources: Slice[u32];
    renamed: Slice[bool];
}

# what one computation works with
# ---
# ctx:    the context a row's grouping is read under
# file:   the register file, nil for a set with none
# fx:     the effects of the instructions of the first round's function
# fw:     the words a set over its rows spans
# before: a loop's earlier steps' writes, fw words
# ends:   what one row's write ends, fw words
# stated: a loop's step's operands
# values: the virtual registers and the touched locations, the bits a set holds
# sets:   each clobber set's touched locations, as values
rec Build {
    a:         *allocator.Allocator;
    f:         *Function;
    ctx:       *core_state.Context;
    at:        *Locations;
    k:         *Known;
    carried:   Carried;
    file:      *rf.File;
    fx:        *Effects;
    fw:        u32;
    before:    vector.Vector[u64];
    ends:      vector.Vector[u64];
    values:    u32;
    words:     u32;
    linear:    vector.Vector[Instruction];
    depths:    vector.Vector[u32];
    events:    vector.Vector[Event];
    first:     vector.Vector[u32];
    clobbers:  Lists[u32];
    sets:      Lists[u32];
    gen:       vector.Vector[u64];
    kill:      vector.Vector[u64];
    live_in:   vector.Vector[u64];
    live_out:  vector.Vector[u64];
    seg_keys:  vector.Vector[u32];
    seg_items: vector.Vector[Segment];
    use_keys:  vector.Vector[u32];
    use_items: vector.Vector[Use];
    hold_keys: vector.Vector[u32];
    holds:     vector.Vector[Hold];
    stated:    [mo.MAX_OPERANDS]Operand;
}

fun alloc_err(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun unlocated(i: Instruction, operand: u32) err[Error] {
    ret err[Error].err{Error.unlocated{Site{instruction: i, operand: operand}}};
}

fun bit(v: *vector.Vector[u64], base: usize, w: u32) bool {
    ret ((v.data[base + (w / 64)::usize] >> (w % 64)::u64) & 1) != 0;
}

fun set(v: *vector.Vector[u64], base: usize, w: u32) {
    val k: usize = base + (w / 64)::usize;
    v.data[k] = v.data[k] | ((1::u64) << (w % 64)::u64);
}

fun clear(v: *vector.Vector[u64], base: usize, w: u32) {
    val k: usize = base + (w / 64)::usize;
    v.data[k] = v.data[k] & ~((1::u64) << (w % 64)::u64);
}

# the weight of a use at a loop depth
pub fun weight(depth: u32) u64 {
    var d: u32 = depth;
    if (d > DEPTH_CAP) { d = DEPTH_CAP; }
    ret (1::u64) << (d * LEVEL_SHIFT)::u64;
}

fun push_event(b: *Build, e: Event) err[Error] {
    val pushed: res[usize, allocator.Error] = vector.push[Event](?b.events, e);
    if (sel pushed.err) { ret alloc_err(pushed.err); }
    ret err[Error].ok{};
}

fun refused(i: Instruction, operand: u32, why: location.Unlocated) Error {
    ret Error.refused{Unplaced{site: Site{instruction: i, operand: operand}, why: why}};
}

# the value of location `at`, numbered among the touched as it is first named.
# the touched list holds room for every location, so numbering one grows nothing
fun touch(b: *Build, at: u32) u32 {
    var n: u32 = b.k.index.data[at];
    if (n == NONE) {
        n                  = b.k.touched.len::u32;
        b.k.index.data[at] = n;
        vector.push[u32](?b.k.touched, at);
    }
    ret b.f.virtuals.len::u32 + n;
}

# the value a register of operand `k` of `id` names, or why the locations refused it
fun value_of(b: *Build, id: Instruction, k: u32, r: Register) res[u32, Error] {
    if (sel r.virtual) { ret res[u32, Error].ok{r.virtual}; }
    val at: res[u32, location.Unlocated] = location.locate(b.at, r.physical);
    if (sel at.err) { ret res[u32, Error].err{refused(id, k, at.err)}; }
    ret res[u32, Error].ok{touch(b, at.ok)};
}

fun is_virtual(b: *Build, value: u32) bool {
    ret value::usize < b.f.virtuals.len;
}

# the location a value is, NONE for a virtual register
fun location_of(b: *Build, value: u32) u32 {
    if (is_virtual(b, value)) { ret NONE; }
    ret b.k.touched.data[value - b.f.virtuals.len::u32];
}

# every register of a set and not of `minus` as reads or writes of their
# locations, a write at the use slot when `early`
fun effect_set(b: *Build, id: Instruction, s: effect.Set, minus: effect.Set, write: bool, early: bool) err[Error] {
    var w: u32 = 0;
    for (w < s.len) {
        var word: u64 = s.words[w];
        if (w < minus.len) { word = word & ~minus.words[w]; }
        var k: u32 = 0;
        for (word != 0) {
            if ((word & 1) != 0) {
                val row: u32 = w * 64 + k;
                if (b.at.file == nil || row >= b.at.file.register_count) { ret unlocated(id, NONE); }
                val pushed: err[Error] = push_event(b, Event{value: touch(b, row), write: write, early: early, operand: NONE, fixed: NONE, tied: NONE, set: NONE});
                if (sel pushed.err) { ret pushed; }
            }
            word = word >> 1;
            k    = k + 1;
        }
        w = w + 1;
    }
    ret err[Error].ok{};
}

fun tied_operand(b: *Build, id: Instruction, k: u32, t: Tied, pin: u32) err[Error] {
    val dest:   Register        = t.dest;
    val source: Register        = t.source;
    val dv:     res[u32, Error] = value_of(b, id, k, dest);
    if (sel dv.err) { ret err[Error].err{dv.err}; }
    val sv: res[u32, Error] = value_of(b, id, k, source);
    if (sel sv.err) { ret err[Error].err{sv.err}; }
    val d:     u32 = dv.ok;
    val s:     u32 = sv.ok;
    var dpin:  u32 = pin;
    var spin:  u32 = pin;
    var dtied: u32 = NONE;
    var stied: u32 = NONE;
    if (is_virtual(b, d) && is_virtual(b, s)) {
        dtied = s;
        stied = d;
    }
    if (pin == NONE && is_virtual(b, d) && !is_virtual(b, s)) { dpin = location_of(b, s); }
    if (pin == NONE && is_virtual(b, s) && !is_virtual(b, d)) { spin = location_of(b, d); }
    if (is_virtual(b, s)) {
        val read: err[Error] = push_event(b, Event{value: s, write: false, early: false, operand: k, fixed: spin, tied: stied, set: NONE});
        if (sel read.err) { ret read; }
    }
    if (is_virtual(b, d)) { ret push_event(b, Event{value: d, write: true, early: false, operand: k, fixed: dpin, tied: dtied, set: NONE}); }
    ret err[Error].ok{};
}

# the virtual registers of an address an operand names: each read, and its
# base written as well where the address writes it back. its registers
# assigned already are masc's footprint's, as any operand's are
fun address_operand(b: *Build, id: Instruction, k: u32, a: operand.Address, early: bool) err[Error] {
    var names: [operand.MOST_NAMED]Register;
    val n:     u32 = operand.named(Operand.address{a}, ?names[0]);
    var i:     u32 = 0;
    for (i < n) {
        val r: Register = names[i];
        if (sel r.virtual) {
            val read: err[Error] = push_event(b, Event{value: r.virtual, write: false, early: false, operand: k, fixed: NONE, tied: NONE, set: NONE});
            if (sel read.err) { ret read; }
        }
        i = i + 1;
    }
    if (!operand.writes_back(a)) { ret err[Error].ok{}; }
    val base: opt[Register] = a.base;
    if (sel base.some) {
        val r: Register = base.some;
        if (sel r.virtual) { ret push_event(b, Event{value: r.virtual, write: true, early: early, operand: k, fixed: NONE, tied: NONE, set: NONE}); }
    }
    ret err[Error].ok{};
}

# a virtual register's span grown to cover `n` registers
fun widen(l: *Live, value: u32, n: u32) {
    if (n > l.spans.data[value]) { l.spans.data[value] = n; }
}

# each virtual register of `given`, the operands of row `r` of instruction
# `id`, held to the class one value at its position is under grouping `g`,
# constraint.grouped, refused naming the position otherwise
fun grouped(b: *Build, id: Instruction, r: *rows.Row, given: Slice[Operand], g: mc.Grouping) err[Error] {
    var p: u32 = 0;
    for (p < r.operands.len && p::usize < given.size) {
        var names: [2]Register;
        var n:     u32     = 0;
        val o:     Operand = given.data[p];
        if (sel o.virtual) {
            names[0] = Register.virtual{o.virtual};
            n        = 1;
        }
        or (sel o.tied) {
            names[0] = o.tied.dest;
            names[1] = o.tied.source;
            n        = 2;
        }
        var i: u32 = 0;
        for (i < n) {
            val reg: Register = names[i];
            if (sel reg.virtual) {
                if (!constraint.grouped(b.f, r, p, g, function.class_of(b.f, reg.virtual))) { ret err[Error].err{Error.ungrouped{Constrained{instruction: id, breach: constraint.Breach.grouped{p}}}}; }
            }
            i = i + 1;
        }
        p = p + 1;
    }
    ret err[Error].ok{};
}

# what the write of entry `e` of the effects, of row `r`, ends, set in `ends`:
# every register of its written, every flag it leaves unspecified and every
# row sharing storage with a row written that the write leaves no bit of, by
# the storage model's kills, as a zeroing write of a low part ends the value
# held in the whole and a keeping one does not
fun ended(b: *Build, r: *rows.Row, e: u32) {
    val written:  effect.Set            = effects.written(b.fx, e);
    val clobbers: effect.Set            = effects.clobbers(b.fx, e);
    val writes:   Slice[effect.Written] = effects.writes(b.fx, e);
    val into:     *u64                  = b.ends.data;
    var w:        u32                   = 0;
    for (w < b.fw) {
        into[w] = written.words[w] | clobbers.words[w];
        w       = w + 1;
    }
    val count: u32 = b.file.register_count;
    w = 0;
    for (w < b.fw) {
        var word: u64 = written.words[w];
        var k:    u32 = 0;
        for (word != 0) {
            val row: u32 = w * 64 + k;
            if ((word & 1) != 0 && row < count) {
                val alias: Slice[u32] = location.shares(b.at, row);
                var n:     usize      = 0;
                for (n < alias.size) {
                    val other: u32 = alias.data[n];
                    if (other < count && ((into[other / 64] >> (other % 64)::u64) & 1) == 0 && storage.kills(b.file, clobbers.words, r.effect.flags, writes, rf.id_of(?b.file.registers[other]))) { into[other / 64] = into[other / 64] | ((1::u64) << (other % 64)::u64); }
                    n = n + 1;
                }
            }
            word = word >> 1;
            k    = k + 1;
        }
        w = w + 1;
    }
}

# the registers and flags row `r`, the k-th of instruction `id`, reads and
# writes, as its entry of the effects states them: its reads live in, what
# its write ends a kill and a definition after the reads. a loop's step
# writes at the use slot and reads what no earlier step wrote, the earlier
# steps' writes gathered in `before`
fun touches(b: *Build, id: Instruction, r: *rows.Row, k: u32, early: bool) err[Error] {
    val e:     u32        = effects.entry(b.fx, id, k);
    var minus: effect.Set = effect.NO_WORDS;
    if (early) { minus = effect.Set{words: b.before.data, len: b.fw}; }
    ended(b, r, e);
    val reads: err[Error] = effect_set(b, id, effects.reads(b.fx, e), minus, false, false);
    if (sel reads.err) { ret reads; }
    val wrote: err[Error] = effect_set(b, id, effect.Set{words: b.ends.data, len: b.fw}, effect.NO_WORDS, true, early);
    if (sel wrote.err) { ret wrote; }
    if (early) {
        var w: u32 = 0;
        for (w < b.fw) {
            b.before.data[w] = b.before.data[w] | b.ends.data[w];
            w                = w + 1;
        }
    }
    ret err[Error].ok{};
}

# whether a write of virtual register `v` at operand `k` of an instruction of
# opcode `op` in function `f` goes through a view of its class that leaves
# some bit of its value, so the write reads it as well
pub fun partly(f: *Function, op: Opcode, k: u32, v: Virtual) bool {
    val file: *rf.File                 = function.file(f);
    val w:    opt[instruction.Viewing] = instruction.viewing(file, op, k, function.class_of(f, v));
    if (sel w.none)    { ret false; }
    if (!(sel op.row)) { ret false; }
    val r:       *rows.Row           = op.row;
    val through: instruction.Through = w.some.through;
    # a tuple named by its first member is written whole, as the group the position covers
    if (!(sel through.view)) { ret false; }
    ret !storage.view_kills(file, through.view, r.operands.at[k].write.extend);
}

# whether operand `k` of instruction `d` is the first of its operands naming
# a member of virtual register `v` under the same role, which alone stands
# for its reads or its writes
fun first_member(b: *Build, d: *InstructionData, k: u32, v: Virtual, write: bool) bool {
    var n: u32 = 0;
    for (n < k) {
        val o: Operand = d.operands.data[n];
        if (sel o.member) {
            val role: mo.Role = instruction.stated_role(b.f.set, d, n);
            if (o.member.virtual == v && ((role & mo.WRITE) != 0) == write) { ret false; }
        }
        n = n + 1;
    }
    ret true;
}

# whether instruction `d` writes every member of virtual register `v`
# through its member operands, which together end its value
fun every_member(b: *Build, d: *InstructionData, v: Virtual) bool {
    val arity: u32 = instruction.arity_of(b.file, function.class_of(b.f, v));
    if (arity == 0 || arity > 32) { ret false; }
    val count: u32 = d.operands.size::u32;
    var seen:  u64 = 0;
    var n:     u32 = 0;
    for (n < count) {
        val o: Operand = d.operands.data[n];
        if (sel o.member) {
            val role: mo.Role = instruction.stated_role(b.f.set, d, n);
            if (o.member.virtual == v && (role & mo.WRITE) != 0 && o.member.index::u32 < arity) { seen = seen | ((1::u64) << o.member.index::u64); }
        }
        n = n + 1;
    }
    ret seen == ((1::u64) << arity::u64) - 1;
}

# the reads and writes an instruction's operands make: its virtual operands
# by their roles and a pseudo's physical operands by theirs
fun gather_operands(b: *Build, l: *Live, id: Instruction) err[Error] {
    val d:     *InstructionData = function.data(b.f, id);
    val op:    Opcode           = d.opcode;
    val count: u32              = d.operands.size::u32;
    val early: bool             = instruction.early(op);
    val rowed: u32              = instruction.rows_in(op);
    var k:     u32              = 0;
    for (k < count) {
        val o:      Operand    = d.operands.data[k];
        val role:   mo.Role    = instruction.stated_role(b.f.set, d, k);
        var reads:  bool       = (role & mo.READ) != 0;
        val writes: bool       = (role & mo.WRITE) != 0;
        var pin:    u32        = NONE;
        val fixed:  opt[rf.Id] = instruction.fixed(b.f.set, op, k);
        if (sel fixed.some) {
            val at: res[u32, location.Unlocated] = location.locate(b.at, Physical.register{fixed.some});
            if (sel at.err) { ret err[Error].err{refused(id, k, at.err)}; }
            pin = at.ok;
        }
        var value: u32 = NONE;
        if (sel o.virtual) {
            value = o.virtual;
            if (writes && !reads && partly(b.f, op, k, o.virtual)) { reads = true; }
        }
        or (sel o.physical) {
            if (rowed == 0) {
                val got: res[u32, Error] = value_of(b, id, k, Register.physical{o.physical});
                if (sel got.err) { ret err[Error].err{got.err}; }
                value = got.ok;
            }
            pin = NONE;
        }
        or (sel o.member) {
            val v: Virtual = o.member.virtual;
            if (first_member(b, d, k, v, writes)) {
                value = v;
                if (writes && !reads && !every_member(b, d, v)) { reads = true; }
            }
        }
        or (sel o.tied) {
            val tied: err[Error] = tied_operand(b, id, k, o.tied, pin);
            if (sel tied.err) { ret tied; }
        }
        or (sel o.list) {
            val first: Register = o.list.first;
            if (sel first.virtual) {
                value = first.virtual;
                widen(l, value, o.list.count::u32);
            }
        }
        or (sel o.address) {
            val addressed: err[Error] = address_operand(b, id, k, o.address, early);
            if (sel addressed.err) { ret addressed; }
        }
        if (value != NONE && reads) {
            val r: err[Error] = push_event(b, Event{value: value, write: false, early: false, operand: k, fixed: pin, tied: NONE, set: NONE});
            if (sel r.err) { ret r; }
        }
        if (value != NONE && writes) {
            val w: err[Error] = push_event(b, Event{value: value, write: true, early: early, operand: k, fixed: pin, tied: NONE, set: NONE});
            if (sel w.err) { ret w; }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the reads and writes of an instruction beyond its operands' own: the
# registers each row it stands for touches and its flags, the locations it
# states it reads and writes, and the clobbers the caller states
fun gather_effects(b: *Build, id: Instruction) err[Error] {
    val d:     *InstructionData = function.data(b.f, id);
    val op:    Opcode           = d.opcode;
    val early: bool             = instruction.early(op);
    val rowed: u32              = instruction.rows_in(op);
    var w:     u32              = 0;
    for (w < b.fw) {
        b.before.data[w] = 0;
        w                = w + 1;
    }
    var r: u32 = 0;
    for (r < rowed) {
        val row:   *rows.Row                           = instruction.row_in(op, r);
        val given: Slice[Operand]                      = instruction.operands_in(function.file(b.f), op, r, d.operands, ?b.stated[0]);
        val g:     res[mc.Grouping, constraint.Breach] = constraint.grouping_of(b.f, b.ctx, row, d.state);
        if (sel g.err) { ret err[Error].err{Error.ungrouped{Constrained{instruction: id, breach: g.err}}}; }
        val held: err[Error] = grouped(b, id, row, given, g.ok);
        if (sel held.err) { ret held; }
        if (b.file != nil) {
            val touched: err[Error] = touches(b, id, row, r, early);
            if (sel touched.err) { ret touched; }
        }
        r = r + 1;
    }
    var m: usize = 0;
    for (m < d.implicit.size) {
        val loc: res[u32, Error] = value_of(b, id, NONE, Register.physical{d.implicit.data[m].location});
        if (sel loc.err) { ret err[Error].err{loc.err}; }
        val pushed: err[Error] = push_event(b, Event{value: loc.ok, write: d.implicit.data[m].write, early: false, operand: NONE, fixed: NONE, tied: NONE, set: NONE});
        if (sel pushed.err) { ret pushed; }
        m = m + 1;
    }
    val extra: Slice[u32] = graph.list[u32](?b.clobbers, id);
    var c:     usize      = 0;
    for (c < extra.size) {
        val pushed: err[Error] = push_event(b, Event{value: NONE, write: true, early: false, operand: NONE, fixed: NONE, tied: NONE, set: extra.data[c]});
        if (sel pushed.err) { ret pushed; }
        c = c + 1;
    }
    ret err[Error].ok{};
}

fun events_of(b: *Build, n: u32) Slice[Event] {
    val start: u32 = b.first.data[n];
    ret Slice[Event]{data: ?b.events.data[start], size: (b.first.data[n + 1] - start)::usize};
}

fun reserve_room[T](v: *vector.Vector[T], n: usize) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[T](v, n);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    ret err[allocator.Error].ok{};
}

fun place(b: *Build, l: *Live, k: u32) err[Error] {
    vector.push[u32](?l.order, k);
    val list:  Slice[Instruction] = function.instructions(b.f, k);
    val depth: u32                = b.k.depths.data[k];
    l.starts.data[k] = 2 * b.linear.len::u32;
    var i: usize = 0;
    for (i < list.size) {
        if (b.linear.len >= 0x7ffffffe) { ret err[Error].err{Error.size{}}; }
        l.numbers.data[list.data[i]] = b.linear.len::u32;
        val pushed: res[usize, allocator.Error] = vector.push[Instruction](?b.linear, list.data[i]);
        if (sel pushed.err) { ret alloc_err(pushed.err); }
        val deep: res[usize, allocator.Error] = vector.push[u32](?b.depths, depth);
        if (sel deep.err) { ret alloc_err(deep.err); }
        i = i + 1;
    }
    l.ends.data[k] = 2 * b.linear.len::u32;
    ret err[Error].ok{};
}

# the blocks' linear order and loop depths
fun shape(b: *Build) err[Error] {
    val dom: res[Dominance, allocator.Error] = dominance.compute(b.a, ?b.k.graph);
    if (sel dom.err) { ret alloc_err(dom.err); }
    var d: Dominance = dom.ok;
    fin { dominance.dnit(?d); }
    val nest: res[Loops, allocator.Error] = loops.compute(b.a, ?b.k.graph, ?d);
    if (sel nest.err) { ret alloc_err(nest.err); }
    var lp: Loops = nest.ok;
    fin { loops.dnit(?lp); }
    val blocks: u32                  = b.f.blocks.len::u32;
    var failed: err[allocator.Error] = reserve_room[u32](?b.k.order, blocks::usize);
    keep(?failed, slice.fill[u32](?b.k.depths, blocks::usize, 0));
    if (sel failed.err) { ret alloc_err(failed.err); }
    val rpo: Slice[u32] = dominance.order(?d);
    var i:   usize      = 0;
    for (i < rpo.size) {
        vector.push[u32](?b.k.order, rpo.data[i]);
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < blocks) {
        if (!dominance.reachable(?d, k)) { vector.push[u32](?b.k.order, k); }
        b.k.depths.data[k] = loops.depth(?lp, k);
        k                  = k + 1;
    }
    ret err[Error].ok{};
}

# the blocks in linear order and every instruction's number and positions
fun number(b: *Build, l: *Live) err[Error] {
    val blocks: u32                  = b.f.blocks.len::u32;
    var failed: err[allocator.Error] = slice.fill[u32](?l.starts, blocks::usize, 0);
    keep(?failed, slice.fill[u32](?l.ends, blocks::usize, 0));
    keep(?failed, slice.fill[u32](?l.numbers, b.f.instructions.len, NONE));
    keep(?failed, reserve_room[u32](?l.order, blocks::usize));
    if (sel failed.err) { ret alloc_err(failed.err); }
    var i: usize = 0;
    for (i < b.k.order.len) {
        val placed: err[Error] = place(b, l, b.k.order.data[i]);
        if (sel placed.err) { ret placed; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether location `loc`, a register row, is of a clobber set's mask
fun in_mask(mask: Slice[u64], loc: u32) bool {
    val w: usize = (loc / 64)::usize;
    ret w < mask.size && ((mask.data[w] >> (loc % 64)::u64) & 1) != 0;
}

# the mask of clobber set `set`
fun mask_of(l: *Live, set: u32) Slice[u64] {
    ret Slice[u64]{data: ?l.masks.data[(set * l.words)::usize], size: l.words::usize};
}

# whether a mask holds a row past the register rows
fun past_rows(b: *Build, mask: Slice[u64]) bool {
    var rows: u32 = 0;
    if (b.at.file != nil) { rows = b.at.file.register_count; }
    var w: usize = 0;
    for (w < mask.size) {
        var word: u64 = mask.data[w];
        if (w::u32 * 64 + 64 > rows) {
            var keep_bits: u64 = 0;
            if (w::u32 * 64 < rows)       { keep_bits = ((1::u64) << (rows - w::u32 * 64)::u64) - 1; }
            if ((word & ~keep_bits) != 0) { ret true; }
        }
        w = w + 1;
    }
    ret false;
}

fun sets_in(clobbers: Clobbers) u32 {
    if (clobbers.words == 0) { ret 0; }
    ret (clobbers.masks.size / clobbers.words::usize)::u32;
}

# the clobber sets' masks
fun clobber_masks(l: *Live, clobbers: Clobbers) err[Error] {
    val sets: u32 = sets_in(clobbers);
    l.words = clobbers.words;
    var failed: err[allocator.Error] = reserve_room[u64](?l.masks, (sets * clobbers.words)::usize);
    keep(?failed, slice.fill[u64](?l.any, clobbers.words::usize, 0));
    if (sel failed.err) { ret alloc_err(failed.err); }
    var k: usize = 0;
    for (k < (sets * clobbers.words)::usize) {
        vector.push[u64](?l.masks, clobbers.masks.data[k]);
        l.any.data[k % clobbers.words::usize] = l.any.data[k % clobbers.words::usize] | clobbers.masks.data[k];
        k                                     = k + 1;
    }
    ret err[Error].ok{};
}

# the clobbers grouped by instruction, each checked against the function, the
# sets and the locations
fun group_clobbers(b: *Build, l: *Live, clobbers: Clobbers) err[Error] {
    var keys:  vector.Vector[u32] = vector.init[u32](b.a);
    var items: vector.Vector[u32] = vector.init[u32](b.a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[u32](?items);
    }
    val sets:   u32                  = sets_in(clobbers);
    var failed: err[allocator.Error] = reserve_room[u32](?keys, clobbers.calls.size);
    keep(?failed, reserve_room[u32](?items, clobbers.calls.size));
    if (sel failed.err) { ret alloc_err(failed.err); }
    var i: usize = 0;
    for (i < clobbers.calls.size) {
        val c: Clobber = clobbers.calls.data[i];
        if (c.instruction::usize >= b.f.instructions.len || c.set >= sets || past_rows(b, mask_of(l, c.set))) { ret unlocated(c.instruction, NONE); }
        vector.push[u32](?keys, c.instruction);
        vector.push[u32](?items, c.set);
        i = i + 1;
    }
    val made: res[Lists[u32], allocator.Error] = graph.lists[u32](b.a, b.f.instructions.len::u32, Slice[u32]{data: keys.data, size: keys.len}, Slice[u32]{data: items.data, size: items.len});
    if (sel made.err) { ret alloc_err(made.err); }
    b.clobbers = made.ok;
    ret err[Error].ok{};
}

# each clobber set's touched locations, as values, and the bits a set over
# the values holds, once every instruction's reads and writes are gathered
fun settle_values(b: *Build, l: *Live) err[Error] {
    val virtuals: u32 = b.f.virtuals.len::u32;
    val count:    u32 = b.k.touched.len::u32;
    var sets:     u32 = 0;
    if (l.words != 0) { sets = (l.masks.len / l.words::usize)::u32; }
    var failed: err[allocator.Error] = reserve_room[u32](?b.sets.first, sets::usize + 1);
    keep(?failed, reserve_room[u32](?b.sets.items, (sets * count)::usize));
    if (sel failed.err) { ret alloc_err(failed.err); }
    vector.push[u32](?b.sets.first, 0);
    var k: u32 = 0;
    for (k < sets) {
        val mask: Slice[u64] = mask_of(l, k);
        var t:    u32        = 0;
        for (t < count) {
            if (in_mask(mask, b.k.touched.data[t])) { vector.push[u32](?b.sets.items, virtuals + t); }
            t = t + 1;
        }
        vector.push[u32](?b.sets.first, b.sets.items.len::u32);
        k = k + 1;
    }
    b.values = virtuals + count;
    b.words  = (b.values + 63) / 64;
    ret err[Error].ok{};
}

# every instruction's reads and writes, in linear order
fun gather_all(b: *Build, l: *Live) err[Error] {
    var n: usize = 0;
    for (n < b.linear.len) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?b.first, b.events.len::u32);
        if (sel pushed.err) { ret alloc_err(pushed.err); }
        val own: err[Error] = gather_operands(b, l, b.linear.data[n]);
        if (sel own.err) { ret own; }
        val tail: res[usize, allocator.Error] = vector.push[u32](?b.k.tails, b.events.len::u32);
        if (sel tail.err) { ret alloc_err(tail.err); }
        val rest: err[Error] = gather_effects(b, b.linear.data[n]);
        if (sel rest.err)               { ret rest; }
        if (b.events.len >= 0xffffffff) { ret err[Error].err{Error.size{}}; }
        n = n + 1;
    }
    val last: res[usize, allocator.Error] = vector.push[u32](?b.first, b.events.len::u32);
    if (sel last.err) { ret alloc_err(last.err); }
    ret err[Error].ok{};
}

# the known events from `from` up to `to`, each location moved past the
# virtual registers this form added
fun carry_events(b: *Build, from: u32, to: u32) err[Error] {
    val k:     *Known               = b.k;
    val added: u32                  = b.f.virtuals.len::u32 - k.virtuals;
    val room:  err[allocator.Error] = reserve_room[Event](?b.events, (to - from)::usize);
    if (sel room.err) { ret alloc_err(room.err); }
    var i: u32 = from;
    for (i < to) {
        var e: Event = k.events.data[i];
        if (e.value != NONE && e.value >= k.virtuals) { e.value = e.value + added; }
        vector.push[Event](?b.events, e);
        i = i + 1;
    }
    ret err[Error].ok{};
}

# every instruction's reads and writes in a form, in linear order, each kept
# from what the first round gathered where it can be
fun carry_all(b: *Build, l: *Live) err[Error] {
    var v: usize = 0;
    for (v < b.k.spans.len) {
        l.spans.data[v] = b.k.spans.data[v];
        v               = v + 1;
    }
    var n: usize = 0;
    for (n < b.linear.len) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?b.first, b.events.len::u32);
        if (sel pushed.err) { ret alloc_err(pushed.err); }
        val id:     Instruction = b.linear.data[n];
        val source: u32         = b.carried.sources.data[id];
        if (source == NONE) {
            val own: err[Error] = gather_operands(b, l, id);
            if (sel own.err) { ret own; }
        }
        or {
            val at: u32 = b.k.numbers.data[source];
            if (b.carried.renamed.data[id]) {
                val own: err[Error] = gather_operands(b, l, id);
                if (sel own.err) { ret own; }
                val rest: err[Error] = carry_events(b, b.k.tails.data[at], b.k.first.data[at + 1]);
                if (sel rest.err) { ret rest; }
            }
            or {
                val whole: err[Error] = carry_events(b, b.k.first.data[at], b.k.first.data[at + 1]);
                if (sel whole.err) { ret whole; }
            }
        }
        if (b.events.len >= 0xffffffff) { ret err[Error].err{Error.size{}}; }
        n = n + 1;
    }
    val last: res[usize, allocator.Error] = vector.push[u32](?b.first, b.events.len::u32);
    if (sel last.err) { ret alloc_err(last.err); }
    ret err[Error].ok{};
}

# the first linear number of a block's instructions and one past its last
fun numbers_of(l: *Live, k: u32) Segment {
    ret Segment{from: l.starts.data[k] / 2, to: l.ends.data[k] / 2};
}

# every touched location of a clobber set killed in the block whose sets start at `base`
fun kill_set(b: *Build, base: usize, k: u32) {
    val held: Slice[u32] = graph.list[u32](?b.sets, k);
    var i:    usize      = 0;
    for (i < held.size) {
        set(?b.kill, base, held.data[i]);
        i = i + 1;
    }
}

# each block's values read before written in it, and its values written
fun local(b: *Build, l: *Live) err[Error] {
    val size:   usize                = b.f.blocks.len * b.words::usize;
    var failed: err[allocator.Error] = slice.fill[u64](?b.gen, size, 0);
    keep(?failed, slice.fill[u64](?b.kill, size, 0));
    keep(?failed, slice.fill[u64](?b.live_in, size, 0));
    keep(?failed, slice.fill[u64](?b.live_out, size, 0));
    if (sel failed.err) { ret alloc_err(failed.err); }
    var k: u32 = 0;
    for (k::usize < b.f.blocks.len) {
        val base: usize   = k::usize * b.words::usize;
        val s:    Segment = numbers_of(l, k);
        var n:    u32     = s.from;
        for (n < s.to) {
            val ev: Slice[Event] = events_of(b, n);
            var i:  usize        = 0;
            for (i < ev.size) {
                if (!ev.data[i].write && !bit(?b.kill, base, ev.data[i].value)) { set(?b.gen, base, ev.data[i].value); }
                i = i + 1;
            }
            i = 0;
            for (i < ev.size) {
                if (ev.data[i].set != NONE) { kill_set(b, base, ev.data[i].set); }
                or (ev.data[i].write)       { set(?b.kill, base, ev.data[i].value); }
                i = i + 1;
            }
            n = n + 1;
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

fun emit(b: *Build, value: u32, from: u32, to: u32) err[Error] {
    if (from == to) { ret err[Error].ok{}; }
    if (is_virtual(b, value)) {
        val key: res[usize, allocator.Error] = vector.push[u32](?b.seg_keys, value);
        if (sel key.err) { ret alloc_err(key.err); }
        val item: res[usize, allocator.Error] = vector.push[Segment](?b.seg_items, Segment{from: from, to: to});
        if (sel item.err) { ret alloc_err(item.err); }
        ret err[Error].ok{};
    }
    ret hold(b, location_of(b, value), Hold{from: from, to: to, owner: NONE});
}

fun hold(b: *Build, at: u32, h: Hold) err[Error] {
    val key: res[usize, allocator.Error] = vector.push[u32](?b.hold_keys, at);
    if (sel key.err) { ret alloc_err(key.err); }
    val item: res[usize, allocator.Error] = vector.push[Hold](?b.holds, h);
    if (sel item.err) { ret alloc_err(item.err); }
    ret err[Error].ok{};
}

# close every value still open at a block's start
fun close_all(b: *Build, cur: *vector.Vector[u64], open: *vector.Vector[u32], start: u32) err[Error] {
    var w: u32 = 0;
    for (w < b.words) {
        var word: u64 = cur.data[w];
        var k:    u32 = 0;
        for (word != 0) {
            if ((word & 1) != 0) {
                val value: u32        = w * 64 + k;
                val done:  err[Error] = emit(b, value, start, open.data[value]);
                if (sel done.err) { ret done; }
                open.data[value] = NONE;
            }
            word = word >> 1;
            k    = k + 1;
        }
        cur.data[w] = 0;
        w           = w + 1;
    }
    ret err[Error].ok{};
}

# a clobber set written at position `from`: one mark over the position for
# the whole set, and a hold of its own to the read for a location of it a
# later instruction reads, which ends that value
fun mark(b: *Build, l: *Live, cur: *vector.Vector[u64], open: *vector.Vector[u32], k: u32, from: u32) err[Error] {
    val held: Slice[u32] = graph.list[u32](?b.sets, k);
    var i:    usize      = 0;
    for (i < held.size) {
        val value: u32 = held.data[i];
        if (open.data[value] != NONE) {
            val done: err[Error] = emit(b, value, from, open.data[value]);
            if (sel done.err) { ret done; }
            open.data[value] = NONE;
            clear(cur, 0, value);
        }
        i = i + 1;
    }
    val pushed: res[usize, allocator.Error] = vector.push[Mark](?l.marks, Mark{position: from, set: k});
    if (sel pushed.err) { ret alloc_err(pushed.err); }
    ret err[Error].ok{};
}

# every value's segments, walking each block backward from its live out set,
# so they come out last first, the clobber marks, ascending, and the holds,
# turned around so each location's nearly ascend for settle_holds' sort
fun walk(b: *Build, l: *Live) err[Error] {
    var open: vector.Vector[u32] = vector.init[u32](b.a);
    var cur:  vector.Vector[u64] = vector.init[u64](b.a);
    fin {
        vector.dnit[u32](?open);
        vector.dnit[u64](?cur);
    }
    var failed: err[allocator.Error] = slice.fill[u32](?open, b.values::usize, NONE);
    keep(?failed, slice.fill[u64](?cur, b.words::usize, 0));
    if (sel failed.err) { ret alloc_err(failed.err); }
    var i: usize = l.order.len;
    for (i > 0) {
        i = i - 1;
        val k:    u32     = l.order.data[i];
        val base: usize   = k::usize * b.words::usize;
        val s:    Segment = numbers_of(l, k);
        var w:    u32     = 0;
        for (w < b.words) {
            var word: u64 = b.live_out.data[base + w::usize];
            cur.data[w] = word;
            var bitat: u32 = 0;
            for (word != 0) {
                if ((word & 1) != 0) { open.data[w * 64 + bitat] = l.ends.data[k]; }
                word  = word >> 1;
                bitat = bitat + 1;
            }
            w = w + 1;
        }
        var n: u32 = s.to;
        for (n > s.from) {
            n = n - 1;
            val ev: Slice[Event] = events_of(b, n);
            var j:  usize        = 0;
            for (j < ev.size) {
                val e:    Event = ev.data[j];
                var from: u32   = 2 * n + 1;
                if (e.early) { from = 2 * n; }
                if (e.set != NONE) {
                    val marked: err[Error] = mark(b, l, ?cur, ?open, e.set, from);
                    if (sel marked.err) { ret marked; }
                }
                or (e.write) {
                    var to: u32 = 2 * n + 2;
                    if (open.data[e.value] != NONE) {
                        to                 = open.data[e.value];
                        open.data[e.value] = NONE;
                        clear(?cur, 0, e.value);
                    }
                    val done: err[Error] = emit(b, e.value, from, to);
                    if (sel done.err) { ret done; }
                }
                j = j + 1;
            }
            j = 0;
            for (j < ev.size) {
                val e: Event = ev.data[j];
                if (!e.write && open.data[e.value] == NONE) {
                    open.data[e.value] = 2 * n + 1;
                    set(?cur, 0, e.value);
                }
                j = j + 1;
            }
        }
        val closed: err[Error] = close_all(b, ?cur, ?open, l.starts.data[k]);
        if (sel closed.err) { ret closed; }
    }
    reverse[Mark](l.marks.data, l.marks.len);
    reverse[u32](b.hold_keys.data, b.hold_keys.len);
    reverse[Hold](b.holds.data, b.holds.len);
    ret err[Error].ok{};
}

fun reverse[T](data: *T, len: usize) {
    var lo: usize = 0;
    var hi: usize = len;
    for (hi > lo + 1) {
        hi = hi - 1;
        val m: T = data[lo];
        data[lo] = data[hi];
        data[hi] = m;
        lo       = lo + 1;
    }
}

# every virtual register's uses in position order, and the slot each pinned
# one holds its location
fun record_uses(b: *Build, l: *Live) err[Error] {
    val filled: err[allocator.Error] = slice.fill[u64](?l.weights, b.f.virtuals.len, 0);
    if (sel filled.err) { ret alloc_err(filled.err); }
    val keys: res[usize, allocator.Error] = vector.reserve[u32](?b.use_keys, b.events.len);
    if (sel keys.err) { ret alloc_err(keys.err); }
    val items: res[usize, allocator.Error] = vector.reserve[Use](?b.use_items, b.events.len);
    if (sel items.err) { ret alloc_err(items.err); }
    var used: usize = 0;
    var n:    u32   = 0;
    for (n::usize < b.linear.len) {
        val w:  u64          = weight(b.depths.data[n]);
        val ev: Slice[Event] = events_of(b, n);
        var j:  usize        = 0;
        for (j < ev.size) {
            val e: Event = ev.data[j];
            if (is_virtual(b, e.value)) {
                var at: u32 = 2 * n;
                if (e.write && !e.early) { at = 2 * n + 1; }
                b.use_keys.data[used]   = e.value;
                b.use_items.data[used]  = Use{position: at, weight: w, write: e.write, instruction: b.linear.data[n], operand: e.operand, fixed: e.fixed, tied: e.tied};
                used                    = used + 1;
                l.weights.data[e.value] = l.weights.data[e.value] + w;
                var g: u32 = 0;
                for (e.fixed != NONE && g < l.spans.data[e.value]) {
                    val loc: u32 = location.past(b.at, e.fixed, g);
                    if (loc == location.NONE) { ret unlocated(b.linear.data[n], e.operand); }
                    val held: err[Error] = hold(b, loc, Hold{from: at, to: at + 1, owner: e.value});
                    if (sel held.err) { ret held; }
                    g = g + 1;
                }
            }
            j = j + 1;
        }
        n = n + 1;
    }
    vector.commit[u32](?b.use_keys, used);
    vector.commit[Use](?b.use_items, used);
    val made: res[Lists[Use], allocator.Error] = graph.lists[Use](b.a, b.f.virtuals.len::u32, Slice[u32]{data: b.use_keys.data, size: b.use_keys.len}, Slice[Use]{data: b.use_items.data, size: b.use_items.len});
    if (sel made.err) { ret alloc_err(made.err); }
    l.uses = made.ok;
    ret err[Error].ok{};
}

# each virtual register's segments in position order, the touching ones merged
fun settle_segments(b: *Build, l: *Live) err[Error] {
    val made: res[Lists[Segment], allocator.Error] = graph.lists[Segment](b.a, b.f.virtuals.len::u32, Slice[u32]{data: b.seg_keys.data, size: b.seg_keys.len}, Slice[Segment]{data: b.seg_items.data, size: b.seg_items.len});
    if (sel made.err) { ret alloc_err(made.err); }
    var grouped: Lists[Segment] = made.ok;
    fin { graph.release[Segment](?grouped); }
    var failed: err[allocator.Error] = reserve_room[u32](?l.segments.first, b.f.virtuals.len + 1);
    keep(?failed, reserve_room[Segment](?l.segments.items, b.seg_items.len));
    if (sel failed.err) { ret alloc_err(failed.err); }
    vector.push[u32](?l.segments.first, 0);
    var v: u32 = 0;
    for (v::usize < b.f.virtuals.len) {
        val s:    Slice[Segment] = graph.list[Segment](?grouped, v);
        val base: usize          = l.segments.items.len;
        var k:    usize          = s.size;
        for (k > 0) {
            k = k - 1;
            val seg: Segment = s.data[k];
            val len: usize   = l.segments.items.len;
            if (len > base && l.segments.items.data[len - 1].to >= seg.from) {
                if (seg.to > l.segments.items.data[len - 1].to) { l.segments.items.data[len - 1].to = seg.to; }
            }
            or { vector.push[Segment](?l.segments.items, seg); }
        }
        vector.push[u32](?l.segments.first, l.segments.items.len::u32);
        v = v + 1;
    }
    ret err[Error].ok{};
}

fun by_from(a: *Hold, b: *Hold) i64 {
    if (a.from < b.from)   { ret -1; }
    if (a.from > b.from)   { ret 1; }
    if (a.owner < b.owner) { ret -1; }
    if (a.owner > b.owner) { ret 1; }
    ret 0;
}

# each location's holds sorted, those of one owner that touch merged, and a
# refusal where two owners overlap
fun settle_holds(b: *Build, l: *Live) err[Error] {
    val count: u32                               = location.count(b.at);
    val made:  res[Lists[Hold], allocator.Error] = graph.lists[Hold](b.a, count, Slice[u32]{data: b.hold_keys.data, size: b.hold_keys.len}, Slice[Hold]{data: b.holds.data, size: b.holds.len});
    if (sel made.err) { ret alloc_err(made.err); }
    var grouped: Lists[Hold] = made.ok;
    fin { graph.release[Hold](?grouped); }
    var failed: err[allocator.Error] = slice.fill[u32](?l.holds.first, count::usize + 1, 0);
    keep(?failed, reserve_room[Hold](?l.holds.items, b.holds.len));
    if (sel failed.err) { ret alloc_err(failed.err); }
    val starts: *u32 = grouped.first.data;
    val firsts: *u32 = l.holds.first.data;
    var at:     u32  = 0;
    for (at < count) {
        if (starts[at] == starts[at + 1]) {
            firsts[at + 1] = l.holds.items.len::u32;
            at             = at + 1;
            cnt;
        }
        val s: Slice[Hold] = graph.list[Hold](?grouped, at);
        if (s.size > 1) { sort.sort_by[Hold](s.data, s.size, by_from); }
        val base: usize = l.holds.items.len;
        var k:    usize = 0;
        for (k < s.size) {
            val h:   Hold  = s.data[k];
            val len: usize = l.holds.items.len;
            if (len > base && l.holds.items.data[len - 1].to > h.from && l.holds.items.data[len - 1].owner != h.owner) { ret err[Error].err{Error.conflict{Conflict{location: at, position: h.from}}}; }
            if (h.owner != NONE) {
                var over:   [1]Segment = [1]Segment{Segment{from: h.from, to: h.to}};
                val marked: opt[u32]   = marked_over(l, at, Slice[Segment]{data: ?over[0], size: 1});
                if (sel marked.some) { ret err[Error].err{Error.conflict{Conflict{location: at, position: marked.some}}}; }
            }
            if (len > base && l.holds.items.data[len - 1].to >= h.from && l.holds.items.data[len - 1].owner == h.owner) {
                if (h.to > l.holds.items.data[len - 1].to) { l.holds.items.data[len - 1].to = h.to; }
            }
            or { vector.push[Hold](?l.holds.items, h); }
            k = k + 1;
        }
        firsts[at + 1] = l.holds.items.len::u32;
        at             = at + 1;
    }
    ret err[Error].ok{};
}

fun build_dnit(b: *Build) {
    vector.dnit[Instruction](?b.linear);
    vector.dnit[u32](?b.depths);
    vector.dnit[Event](?b.events);
    vector.dnit[u32](?b.first);
    graph.release[u32](?b.clobbers);
    graph.release[u32](?b.sets);
    vector.dnit[u64](?b.gen);
    vector.dnit[u64](?b.kill);
    vector.dnit[u64](?b.live_in);
    vector.dnit[u64](?b.live_out);
    vector.dnit[u32](?b.seg_keys);
    vector.dnit[Segment](?b.seg_items);
    vector.dnit[u32](?b.use_keys);
    vector.dnit[Use](?b.use_items);
    vector.dnit[u32](?b.hold_keys);
    vector.dnit[Hold](?b.holds);
    vector.dnit[u64](?b.before);
    vector.dnit[u64](?b.ends);
}

fun empty(a: *allocator.Allocator) Live {
    ret Live{
        virtuals: 0,
        order:    vector.init[u32](a),
        starts:   vector.init[u32](a),
        ends:     vector.init[u32](a),
        numbers:  vector.init[u32](a),
        segments: Lists[Segment]{first: vector.init[u32](a), items: vector.init[Segment](a)},
        uses:     Lists[Use]{first: vector.init[u32](a), items: vector.init[Use](a)},
        weights:  vector.init[u64](a),
        holds:    Lists[Hold]{first: vector.init[u32](a), items: vector.init[Hold](a)},
        words:    0,
        masks:    vector.init[u64](a),
        any:      vector.init[u64](a),
        marks:    vector.init[Mark](a),
        spans:    vector.init[u32](a),
    };
}

# every instruction's reads and writes as the first round gathers them, with
# all a later round reuses
fun first_round(b: *Build, l: *Live, clobbers: Clobbers) err[Error] {
    val grouped: err[Error] = group_clobbers(b, l, clobbers);
    if (sel grouped.err) { ret grouped; }
    var failed: err[allocator.Error] = slice.fill[u64](?b.before, b.fw::usize, 0);
    keep(?failed, slice.fill[u64](?b.ends, b.fw::usize, 0));
    keep(?failed, reserve_room[u32](?b.k.tails, b.linear.len));
    if (sel failed.err) { ret alloc_err(failed.err); }
    ret gather_all(b, l);
}

# what the first round leaves for the later ones
fun settle_known(b: *Build, l: *Live) err[Error] {
    var failed: err[allocator.Error] = copy_into[u32](?b.k.numbers, ?l.numbers);
    keep(?failed, copy_into[u32](?b.k.spans, ?l.spans));
    if (sel failed.err) { ret alloc_err(failed.err); }
    val events: vector.Vector[Event] = b.k.events;
    b.k.events = b.events;
    b.events   = events;
    val first: vector.Vector[u32] = b.k.first;
    b.k.first = b.first;
    b.first   = first;
    b.k.ready = true;
    ret err[Error].ok{};
}

fun copy_into[T](to: *vector.Vector[T], from: *vector.Vector[T]) err[allocator.Error] {
    val done: res[usize, allocator.Error] = vector.extend[T](to, Slice[T]{data: from.data, size: from.len});
    if (sel done.err) { ret err[allocator.Error].err{done.err}; }
    ret err[allocator.Error].ok{};
}

fun run(b: *Build, l: *Live, clobbers: Clobbers) err[Error] {
    val later: bool = b.k.ready;
    if (!later) {
        val shaped: err[Error] = shape(b);
        if (sel shaped.err) { ret shaped; }
    }
    val numbered: err[Error] = number(b, l);
    if (sel numbered.err) { ret numbered; }
    val masked: err[Error] = clobber_masks(l, clobbers);
    if (sel masked.err) { ret masked; }
    val spanned: err[allocator.Error] = slice.fill[u32](?l.spans, b.f.virtuals.len, 1);
    if (sel spanned.err) { ret alloc_err(spanned.err); }
    var gathered: err[Error] = err[Error].ok{};
    if (later)            { gathered = carry_all(b, l); }
    or                    { gathered = first_round(b, l, clobbers); }
    if (sel gathered.err) { ret gathered; }
    val valued: err[Error] = settle_values(b, l);
    if (sel valued.err) { ret valued; }
    val sets: err[Error] = local(b, l);
    if (sel sets.err) { ret sets; }
    flow.backward(?b.k.graph, Slice[u32]{data: l.order.data, size: l.order.len}, flow.Sets{words: b.words, gen: ?b.gen, kill: ?b.kill, live_in: ?b.live_in, live_out: ?b.live_out});
    val walked: err[Error] = walk(b, l);
    if (sel walked.err) { ret walked; }
    val used: err[Error] = record_uses(b, l);
    if (sel used.err) { ret used; }
    val settled: err[Error] = settle_segments(b, l);
    if (sel settled.err) { ret settled; }
    val held: err[Error] = settle_holds(b, l);
    if (sel held.err) { ret held; }
    if (later)        { ret held; }
    ret settle_known(b, l);
}

# the liveness and live intervals of a function
# ---
# a:        the allocator the result takes
# f:        the function
# ctx:      the context the effects' footprints are asked under
# at:       the locations of its target, of its register file
# clobbers: locations instructions leave undefined beyond their rows, as a
#           calling convention states them at its calls
# ret:      the liveness, or why it was refused
pub fun compute(a: *allocator.Allocator, f: *Function, ctx: *core_state.Context, at: *Locations, clobbers: Clobbers) res[Live, Error] {
    val read: res[Effects, effects.Error] = effects.read(a, f, ctx);
    if (sel read.err) {
        val e: effects.Error = read.err;
        if (sel e.alloc) { ret res[Live, Error].err{Error.alloc{e.alloc}}; }
        ret res[Live, Error].err{Error.undecided{e.undecided}};
    }
    var fx: Effects = read.ok;
    fin { effects.release(?fx); }
    var k: Known = known(a);
    fin { forget(?k); }
    ret round(a, f, ctx, at, ?fx, clobbers, ?k, Carried{sources: Slice[u32]{data: nil, size: 0}, renamed: Slice[bool]{data: nil, size: 0}});
}

# nothing known yet
pub fun known(a: *allocator.Allocator) Known {
    val edges: Lists[u32] = Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)};
    ret Known{
        ready:    false,
        virtuals: 0,
        graph:    Graph{count: 0, entry: 0, successors: edges, predecessors: edges},
        order:    vector.init[u32](a),
        depths:   vector.init[u32](a),
        numbers:  vector.init[u32](a),
        events:   vector.init[Event](a),
        first:    vector.init[u32](a),
        tails:    vector.init[u32](a),
        spans:    vector.init[u32](a),
        index:    vector.init[u32](a),
        touched:  vector.init[u32](a),
    };
}

# give back what is known
pub fun forget(k: *Known) err[allocator.Error] {
    var failed: err[allocator.Error] = graph.dnit(?k.graph);
    keep(?failed, vector.dnit[u32](?k.order));
    keep(?failed, vector.dnit[u32](?k.depths));
    keep(?failed, vector.dnit[u32](?k.numbers));
    keep(?failed, vector.dnit[Event](?k.events));
    keep(?failed, vector.dnit[u32](?k.first));
    keep(?failed, vector.dnit[u32](?k.tails));
    keep(?failed, vector.dnit[u32](?k.spans));
    keep(?failed, vector.dnit[u32](?k.index));
    keep(?failed, vector.dnit[u32](?k.touched));
    ret failed;
}

# the liveness and live intervals of one round's form of a function, which
# fills `k` in the first round, of the function itself, and reads it after
# ---
# a:        the allocator the result takes
# f:        the form
# ctx:      the context a row's grouping is read under
# at:       the locations of its target, of its register file
# fx:       the effects of the first round's function, read only in that round
# clobbers: locations instructions leave undefined beyond their rows, as
#           the first round's, at this form's instructions
# k:        what the first round knows
# carried:  how the form stands to the first round's function, read past it
# ret:      the liveness, or why it was refused
pub fun round(a: *allocator.Allocator, f: *Function, ctx: *core_state.Context, at: *Locations, fx: *Effects, clobbers: Clobbers, k: *Known, carried: Carried) res[Live, Error] {
    if (at.file != function.file(f)) { ret res[Live, Error].err{Error.foreign{}}; }
    val total: u64 = f.virtuals.len::u64 + location.count(at)::u64;
    if (total >= 0xffffffff) { ret res[Live, Error].err{Error.size{}}; }
    if (!k.ready) {
        val got: res[Graph, allocator.Error] = function.graph_of(f);
        if (sel got.err) { ret res[Live, Error].err{Error.alloc{got.err}}; }
        k.graph    = got.ok;
        k.virtuals = f.virtuals.len::u32;
        var failed: err[allocator.Error] = slice.fill[u32](?k.index, location.count(at)::usize, NONE);
        keep(?failed, reserve_room[u32](?k.touched, location.count(at)::usize));
        if (sel failed.err) { ret res[Live, Error].err{Error.alloc{failed.err}}; }
    }
    val file: *rf.File = function.file(f);
    var b:    Build    = Build{
        a:         a,
        f:         f,
        ctx:       ctx,
        at:        at,
        k:         k,
        carried:   carried,
        file:      file,
        fx:        fx,
        fw:        fx.words,
        before:    vector.init[u64](a),
        ends:      vector.init[u64](a),
        values:    0,
        words:     0,
        linear:    vector.init[Instruction](a),
        depths:    vector.init[u32](a),
        events:    vector.init[Event](a),
        first:     vector.init[u32](a),
        clobbers:  Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)},
        sets:      Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)},
        gen:       vector.init[u64](a),
        kill:      vector.init[u64](a),
        live_in:   vector.init[u64](a),
        live_out:  vector.init[u64](a),
        seg_keys:  vector.init[u32](a),
        seg_items: vector.init[Segment](a),
        use_keys:  vector.init[u32](a),
        use_items: vector.init[Use](a),
        hold_keys: vector.init[u32](a),
        holds:     vector.init[Hold](a),
    };
    fin { build_dnit(?b); }
    var l: Live = empty(a);
    l.virtuals = f.virtuals.len::u32;
    val done: err[Error] = run(?b, ?l, clobbers);
    if (sel done.err) {
        dnit(?l);
        ret res[Live, Error].err{done.err};
    }
    ret res[Live, Error].ok{l};
}

# give back the storage of a function's liveness
pub fun dnit(l: *Live) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u32](?l.order);
    keep(?failed, vector.dnit[u32](?l.starts));
    keep(?failed, vector.dnit[u32](?l.ends));
    keep(?failed, vector.dnit[u32](?l.numbers));
    keep(?failed, graph.release[Segment](?l.segments));
    keep(?failed, graph.release[Use](?l.uses));
    keep(?failed, vector.dnit[u64](?l.weights));
    keep(?failed, graph.release[Hold](?l.holds));
    keep(?failed, vector.dnit[u64](?l.masks));
    keep(?failed, vector.dnit[u64](?l.any));
    keep(?failed, vector.dnit[Mark](?l.marks));
    keep(?failed, vector.dnit[u32](?l.spans));
    ret failed;
}

# the blocks in linear order
pub fun order(l: *Live) Slice[u32] {
    ret Slice[u32]{data: l.order.data, size: l.order.len};
}

# a block's first position
pub fun start(l: *Live, b: Block) u32 {
    ret l.starts.data[b];
}

# the position past a block's last
pub fun end(l: *Live, b: Block) u32 {
    ret l.ends.data[b];
}

# an instruction's use slot, none when no block holds it
pub fun use_slot(l: *Live, i: Instruction) opt[u32] {
    val n: u32 = l.numbers.data[i];
    if (n == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{2 * n};
}

# an instruction's def slot, none when no block holds it
pub fun def_slot(l: *Live, i: Instruction) opt[u32] {
    val n: u32 = l.numbers.data[i];
    if (n == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{2 * n + 1};
}

# a virtual register's segments, sorted and disjoint
pub fun segments(l: *Live, v: Virtual) Slice[Segment] {
    ret graph.list[Segment](?l.segments, v);
}

# a virtual register's uses, in position order
pub fun uses(l: *Live, v: Virtual) Slice[Use] {
    ret graph.list[Use](?l.uses, v);
}

# a virtual register's uses' weights summed
pub fun weight_of(l: *Live, v: Virtual) u64 {
    ret l.weights.data[v];
}

# a virtual register's span, the registers of its class its value covers from
# its location, one but for a list's first member, since a tuple's location is
# one register whose storage is its members'
pub fun span(l: *Live, v: Virtual) u32 {
    ret l.spans.data[v];
}

# a location's holds, sorted and disjoint, but for the clobber marks
pub fun holds(l: *Live, at: u32) Slice[Hold] {
    ret graph.list[Hold](?l.holds, at);
}

# the clobber marks, ascending by position, each holding every location of
# its set over its position
pub fun marks(l: *Live) Slice[Mark] {
    ret Slice[Mark]{data: l.marks.data, size: l.marks.len};
}

# whether a clobber mark holds a location
pub fun marks_location(l: *Live, m: Mark, at: u32) bool {
    ret in_mask(mask_of(l, m.set), at);
}

# the first position a list of segments covers that a clobber mark holding
# location `at` holds, none when no mark of it falls in them
fun marked_over(l: *Live, at: u32, segments: Slice[Segment]) opt[u32] {
    if (!in_mask(Slice[u64]{data: l.any.data, size: l.any.len}, at)) { ret opt[u32].none{}; }
    # the segments ascend, so each one's first mark is at or past the last one's
    var lo: usize = 0;
    var i:  usize = 0;
    for (i < segments.size && lo < l.marks.len) {
        val s:  Segment = segments.data[i];
        var hi: usize   = l.marks.len;
        for (lo < hi) {
            val mid: usize = lo + (hi - lo) / 2;
            if (l.marks.data[mid].position < s.from) { lo = mid + 1; }
            or                                       { hi = mid; }
        }
        for (lo < l.marks.len && l.marks.data[lo].position < s.to) {
            if (in_mask(mask_of(l, l.marks.data[lo].set), at)) { ret opt[u32].some{l.marks.data[lo].position}; }
            lo = lo + 1;
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether a virtual register is live at a position
pub fun covers(l: *Live, v: Virtual, p: u32) bool {
    val s:  Slice[Segment] = segments(l, v);
    var lo: usize          = 0;
    var hi: usize          = s.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (s.data[mid].to <= p) { lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret lo < s.size && s.data[lo].from <= p;
}

# a virtual register's first use at or after a position, none when there is none
pub fun next_use(l: *Live, v: Virtual, p: u32) opt[Use] {
    val s:  Slice[Use] = uses(l, v);
    var lo: usize      = 0;
    var hi: usize      = s.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (s.data[mid].position < p) { lo = mid + 1; }
        or                            { hi = mid; }
    }
    if (lo >= s.size) { ret opt[Use].none{}; }
    ret opt[Use].some{s.data[lo]};
}

# the first position two sorted, disjoint lists of segments both cover, none
# when they never meet, in O(s + t)
pub fun meet(a: Slice[Segment], b: Slice[Segment]) opt[u32] {
    var i: usize = 0;
    var j: usize = 0;
    for (i < a.size && j < b.size) {
        if (a.data[i].to <= b.data[j].from) { i = i + 1; }
        or (b.data[j].to <= a.data[i].from) { j = j + 1; }
        or {
            if (a.data[i].from > b.data[j].from) { ret opt[u32].some{a.data[i].from}; }
            ret opt[u32].some{b.data[j].from};
        }
    }
    ret opt[u32].none{};
}

# the first position two virtual registers are both live at, none when their
# intervals are disjoint
pub fun overlap(l: *Live, v: Virtual, w: Virtual) opt[u32] {
    ret meet(segments(l, v), segments(l, w));
}

fun owned(owners: Slice[u32], owner: u32) bool {
    var lo: usize = 0;
    var hi: usize = owners.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (owners.data[mid] < owner) { lo = mid + 1; }
        or                            { hi = mid; }
    }
    ret lo < owners.size && owners.data[lo] == owner;
}

# the first position a list of segments covers while storage of a location is
# held by a value of none of the owners, none when the location is free over
# them all
# ---
# l:        the liveness
# at:       the locations
# loc:      the location
# segments: sorted, disjoint segments
# owners:   the virtual registers whose own pins never block, ascending
# ret:      the first blocked position, or none
pub fun blocked_over(l: *Live, at: *Locations, loc: u32, segments: Slice[Segment], owners: Slice[u32]) opt[u32] {
    val alias: Slice[u32] = location.shares(at, loc);
    var first: u32        = NONE;
    var k:     usize      = 0;
    for (k < alias.size) {
        val p: u32 = held_from(l, alias.data[k], segments, owners);
        if (p < first) { first = p; }
        k = k + 1;
    }
    if (first == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{first};
}

# the first position a list of segments covers while location `at` itself,
# not one sharing its storage, is held by a value of none of the owners or by
# a clobber, none when it is free over them all
# ---
# l:        the liveness
# at:       the location
# segments: sorted, disjoint segments
# owners:   the virtual registers whose own pins never block, ascending
# ret:      the first held position, or none
pub fun held_over(l: *Live, at: u32, segments: Slice[Segment], owners: Slice[u32]) opt[u32] {
    val first: u32 = held_from(l, at, segments, owners);
    if (first == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{first};
}

# whether storage of a location is held over a list of segments by a value of
# none of the owners, as `blocked_over` finds a position, stopping at the first
pub fun held_any(l: *Live, at: *Locations, loc: u32, segments: Slice[Segment], owners: Slice[u32]) bool {
    val alias:   Slice[u32] = location.shares(at, loc);
    val any:     Slice[u64] = Slice[u64]{data: l.any.data, size: l.any.len};
    var clobber: bool       = false;
    var k:       usize      = 0;
    for (k < alias.size) {
        if (hold_from(l, alias.data[k], segments, owners) != NONE) { ret true; }
        if (in_mask(any, alias.data[k]))                           { clobber = true; }
        k = k + 1;
    }
    if (!clobber) { ret false; }
    # the marks the segments cover are found once for every location sharing the storage
    var lo: usize = 0;
    var i:  usize = 0;
    for (i < segments.size && lo < l.marks.len) {
        val s:  Segment = segments.data[i];
        var hi: usize   = l.marks.len;
        for (lo < hi) {
            val mid: usize = lo + (hi - lo) / 2;
            if (l.marks.data[mid].position < s.from) { lo = mid + 1; }
            or                                       { hi = mid; }
        }
        for (lo < l.marks.len && l.marks.data[lo].position < s.to) {
            val mask: Slice[u64] = mask_of(l, l.marks.data[lo].set);
            k = 0;
            for (k < alias.size) {
                if (in_mask(mask, alias.data[k])) { ret true; }
                k = k + 1;
            }
            lo = lo + 1;
        }
        i = i + 1;
    }
    ret false;
}

# held_over's first held position, NONE for none
fun held_from(l: *Live, at: u32, a: Slice[Segment], owners: Slice[u32]) u32 {
    val first: u32 = hold_from(l, at, a, owners);
    if (l.marks.len == 0) { ret first; }
    val marked: opt[u32] = marked_over(l, at, a);
    if (sel marked.some) {
        if (marked.some < first) { ret marked.some; }
    }
    ret first;
}

# the first position a list of segments covers while a hold of location `at`
# of none of the owners holds it, NONE for none
fun hold_from(l: *Live, at: u32, a: Slice[Segment], owners: Slice[u32]) u32 {
    val h:     Slice[Hold] = holds(l, at);
    var first: u32         = NONE;
    var i:     usize       = 0;
    var j:     usize       = 0;
    # the holds are sorted and disjoint, so those over before the first segment are found at once
    if (a.size != 0) {
        var hi: usize = h.size;
        for (j < hi) {
            val mid: usize = j + (hi - j) / 2;
            if (h.data[mid].to <= a.data[0].from) { j = mid + 1; }
            or                                    { hi = mid; }
        }
    }
    for (i < a.size && j < h.size) {
        if ((h.data[j].owner != NONE && owned(owners, h.data[j].owner)) || h.data[j].to <= a.data[i].from) { j = j + 1; }
        or (a.data[i].to <= h.data[j].from)                                                                { i = i + 1; }
        or {
            first = h.data[j].from;
            if (a.data[i].from > first) { first = a.data[i].from; }
            brk;
        }
    }
    ret first;
}

# the first position a virtual register is live at while storage of a
# location is held by any other value, none when the location is free for it
# over its whole interval
pub fun blocked(l: *Live, at: *Locations, loc: u32, v: Virtual) opt[u32] {
    var own: [1]u32 = [1]u32{v};
    ret blocked_over(l, at, loc, segments(l, v), Slice[u32]{data: ?own[0], size: 1});
}
