# the locations an allocator assigns, numbered once per target, and the
# storage they share
#
# a location is a register row of the target's register file or a cell of a
# memory-backed class the target supplies. register rows come first, numbered
# as the file orders them, then the cells of each memory class, the classes in
# the order of their addresses. one register equals no unit of storage here:
# two rows share storage when masc's overlap holds for them, which reads the
# bank, offset, stride, piece count and width of each row at every multiplier
# of its scale, so a sub-register shares with the registers it is part of, a
# pair with each of its halves and a scalable register with the fixed width
# registers it holds. a cell shares with nothing but itself, since a memory
# class states no layout against another. the numbering reads no address, so
# it is the same on every run.
#
# a value whose group covers several registers is at the location of its
# group's first register and covers the registers of its class numbered after
# it, as a group of two from register 8 covers register 9. a cell is never
# part of a group.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.machine.class.Cell;
use mirl.machine.class.Class;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.function;

use rf: masc.core.register;

# no location
pub val NONE: u32 = 0xffffffff;

# why the locations of a target were not numbered
# ---
# alloc:     the allocator refused storage
# size:      the locations do not fit the numbering
# duplicate: the place of a memory class the target supplies again
pub tag Error: u8 {
    alloc: allocator.Error;
    size;
    duplicate: u32;
}

# why a location was not found
# ---
# unfiled:  the register, asked of locations with no register file
# register: the register, which the register file does not have
# cell:     the cell, of a class the target does not supply or past its count
pub tag Unlocated: u8 {
    unfiled:  rf.Id;
    register: rf.Id;
    cell:     Cell;
}

# a memory class and its place in the order the target supplies them
# ---
# class: the class
# place: its place in that order
pub rec Placed {
    class: *Memory;
    place: u32;
}

# the locations of a target
# ---
# file:     the register file, nil for a set with none
# memories: the memory-backed classes, in the order the target supplies them
# bases:    the first location of each memory class's cells, in that order
# placed:   each memory class and its place, sorted by address to find a
#           class's place and never to number anything
# shares:   each location's locations sharing storage with it, itself first
# count:    how many locations there are
pub rec Locations {
    file:     *rf.File;
    memories: vector.Vector[*Memory];
    bases:    vector.Vector[u32];
    placed:   vector.Vector[Placed];
    shares:   Lists[u32];
    count:    u32;
}

# a register row and its bank, sorted by bank to group the rows that may share
rec Banked {
    bank: u16;
    row:  u32;
}

fun by_bank(a: *Banked, b: *Banked) i64 {
    if (a.bank != b.bank) {
        if (a.bank < b.bank) { ret -1; }
        ret 1;
    }
    if (a.row < b.row) { ret -1; }
    if (a.row > b.row) { ret 1; }
    ret 0;
}

fun by_address(a: *Placed, b: *Placed) i64 {
    val x: u64 = a.class:~u64;
    val y: u64 = b.class:~u64;
    if (x < y) { ret -1; }
    if (x > y) { ret 1; }
    ret 0;
}

fun reserve_room[T](v: *vector.Vector[T], n: usize) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[T](v, n);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    ret err[allocator.Error].ok{};
}

fun pair(keys: *vector.Vector[u32], items: *vector.Vector[u32], k: u32, n: u32) err[allocator.Error] {
    val pk: res[usize, allocator.Error] = vector.push[u32](keys, k);
    if (sel pk.err) { ret err[allocator.Error].err{pk.err}; }
    val pi: res[usize, allocator.Error] = vector.push[u32](items, n);
    if (sel pi.err) { ret err[allocator.Error].err{pi.err}; }
    ret err[allocator.Error].ok{};
}

# the pairs of rows sharing storage, each row's own pair first, found by
# comparing only the rows of one bank, which is O(r log r) for the sort and
# the sum over banks of the square of a bank's rows for the comparisons
fun share_rows(a: *allocator.Allocator, file: *rf.File, keys: *vector.Vector[u32], items: *vector.Vector[u32]) err[allocator.Error] {
    var banked: vector.Vector[Banked] = vector.init[Banked](a);
    fin { vector.dnit[Banked](?banked); }
    val room: res[usize, allocator.Error] = vector.reserve[Banked](?banked, file.register_count::usize);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: u32 = 0;
    for (i < file.register_count) {
        vector.push[Banked](?banked, Banked{bank: file.registers[i].bank, row: i});
        val own: err[allocator.Error] = pair(keys, items, i, i);
        if (sel own.err) { ret own; }
        i = i + 1;
    }
    sort.sort_by[Banked](banked.data, banked.len, by_bank);
    var start: usize = 0;
    for (start < banked.len) {
        var end: usize = start + 1;
        for (end < banked.len && banked.data[end].bank == banked.data[start].bank) { end = end + 1; }
        var x: usize = start;
        for (x < end) {
            var y: usize = start;
            for (y < end) {
                val p: u32 = banked.data[x].row;
                val q: u32 = banked.data[y].row;
                if (p != q && rf.overlap(file, ?file.registers[p], ?file.registers[q])) {
                    val both: err[allocator.Error] = pair(keys, items, p, q);
                    if (sel both.err) { ret both; }
                }
                y = y + 1;
            }
            x = x + 1;
        }
        start = end;
    }
    ret err[allocator.Error].ok{};
}

fun fill(a: *allocator.Allocator, l: *Locations, memories: Slice[*Memory]) err[Error] {
    var total: u64 = 0;
    if (l.file != nil) { total = l.file.register_count::u64; }
    var failed: err[allocator.Error] = reserve_room[*Memory](?l.memories, memories.size);
    keep(?failed, reserve_room[u32](?l.bases, memories.size));
    keep(?failed, reserve_room[Placed](?l.placed, memories.size));
    if (sel failed.err) { ret err[Error].err{Error.alloc{failed.err}}; }
    var i: usize = 0;
    for (i < memories.size) {
        val c: *Memory = memories.data[i];
        if (total + c.count::u64 >= 0xffffffff) { ret err[Error].err{Error.size{}}; }
        vector.push[*Memory](?l.memories, c);
        vector.push[u32](?l.bases, total::u32);
        vector.push[Placed](?l.placed, Placed{class: c, place: i::u32});
        total = total + c.count::u64;
        i     = i + 1;
    }
    sort.sort_by[Placed](l.placed.data, l.placed.len, by_address);
    i = 1;
    for (i < l.placed.len) {
        if (l.placed.data[i].class == l.placed.data[i - 1].class) {
            var later: u32 = l.placed.data[i].place;
            if (l.placed.data[i - 1].place > later) { later = l.placed.data[i - 1].place; }
            ret err[Error].err{Error.duplicate{later}};
        }
        i = i + 1;
    }
    l.count = total::u32;

    var keys:  vector.Vector[u32] = vector.init[u32](a);
    var items: vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[u32](?items);
    }
    if (l.file != nil) {
        val shared: err[allocator.Error] = share_rows(a, l.file, ?keys, ?items);
        if (sel shared.err) { ret err[Error].err{Error.alloc{shared.err}}; }
    }
    var at: u32 = 0;
    if (l.file != nil) { at = l.file.register_count; }
    for (at < l.count) {
        val own: err[allocator.Error] = pair(?keys, ?items, at, at);
        if (sel own.err) { ret err[Error].err{Error.alloc{own.err}}; }
        at = at + 1;
    }
    val made: res[Lists[u32], allocator.Error] = graph.lists[u32](a, l.count, Slice[u32]{data: keys.data, size: keys.len}, Slice[u32]{data: items.data, size: items.len});
    if (sel made.err) { ret err[Error].err{Error.alloc{made.err}}; }
    l.shares = made.ok;
    ret err[Error].ok{};
}

# the locations of a target
# ---
# a:        the allocator the locations take
# file:     the target's register file, nil for a set with none
# memories: the memory-backed classes the target supplies
# ret:      the locations, or why they were not numbered
pub fun init(a: *allocator.Allocator, file: *rf.File, memories: Slice[*Memory]) res[Locations, Error] {
    var l: Locations = Locations{
        file:     file,
        memories: vector.init[*Memory](a),
        bases:    vector.init[u32](a),
        placed:   vector.init[Placed](a),
        shares:   Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)},
        count:    0,
    };
    val filled: err[Error] = fill(a, ?l, memories);
    if (sel filled.err) {
        dnit(?l);
        ret res[Locations, Error].err{filled.err};
    }
    ret res[Locations, Error].ok{l};
}

# give back the locations' storage
pub fun dnit(l: *Locations) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[*Memory](?l.memories);
    keep(?failed, vector.dnit[u32](?l.bases));
    keep(?failed, vector.dnit[Placed](?l.placed));
    keep(?failed, graph.release[u32](?l.shares));
    ret failed;
}

# how many locations there are
pub fun count(l: *Locations) u32 {
    ret l.count;
}

# the place of a memory class in the order the target supplies them, none
# when it supplies no such class
pub fun place_of(l: *Locations, c: *Memory) opt[u32] {
    var lo: usize = 0;
    var hi: usize = l.placed.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (l.placed.data[mid].class:~u64 < c:~u64) { lo = mid + 1; }
        or                                          { hi = mid; }
    }
    if (lo >= l.placed.len || l.placed.data[lo].class != c) { ret opt[u32].none{}; }
    ret opt[u32].some{l.placed.data[lo].place};
}

# the number of a location, a memory cell found in O(log n) of the classes
# ---
# ret: the number, or the location refused as a register of locations with no
#      register file, a register the file does not have, or a cell the target
#      does not supply
pub fun locate(l: *Locations, p: Physical) res[u32, Unlocated] {
    if (sel p.register) {
        if (l.file == nil) { ret res[u32, Unlocated].err{Unlocated.unfiled{p.register}}; }
        val row: opt[u32] = rf.index_of(l.file, p.register);
        if (sel row.none) { ret res[u32, Unlocated].err{Unlocated.register{p.register}}; }
        ret res[u32, Unlocated].ok{row.some};
    }
    val k: opt[u32] = place_of(l, p.cell.class);
    if (sel k.none)                          { ret res[u32, Unlocated].err{Unlocated.cell{p.cell}}; }
    if (p.cell.number >= p.cell.class.count) { ret res[u32, Unlocated].err{Unlocated.cell{p.cell}}; }
    ret res[u32, Unlocated].ok{l.bases.data[k.some] + p.cell.number};
}

# the place of the memory class whose cells hold a location past the rows
fun memory_index(l: *Locations, at: u32) usize {
    var lo: usize = 0;
    var hi: usize = l.bases.len;
    for (hi - lo > 1) {
        val mid: usize = lo + (hi - lo) / 2;
        if (l.bases.data[mid] <= at) { lo = mid; }
        or                           { hi = mid; }
    }
    ret lo;
}

fun rows_of(l: *Locations) u32 {
    if (l.file == nil) { ret 0; }
    ret l.file.register_count;
}

# the location a number names, which must be below count
pub fun physical(l: *Locations, at: u32) Physical {
    if (at < rows_of(l)) { ret Physical.register{rf.id_of(?l.file.registers[at])}; }
    val k: usize = memory_index(l, at);
    ret Physical.cell{Cell{class: l.memories.data[k], number: at - l.bases.data[k]}};
}

# how many classes the locations are members of: the register file's class
# rows, then the memory classes in the order the target supplies them, each
# numbered by that place as its key
pub fun keys(l: *Locations) u32 {
    var n: u32 = l.memories.len::u32;
    if (l.file != nil) { n = n + l.file.class_count; }
    ret n;
}

# the key of a class, none when it is not a class of these locations
pub fun key(l: *Locations, c: Class) opt[u32] {
    if (sel c.hardware) {
        if (l.file == nil || c.hardware.file != l.file || c.hardware.index::u32 >= l.file.class_count) { ret opt[u32].none{}; }
        ret opt[u32].some{c.hardware.index::u32};
    }
    val k: opt[u32] = place_of(l, c.memory);
    if (sel k.none) { ret k; }
    ret opt[u32].some{keys(l) - l.memories.len::u32 + k.some};
}

# the key of the class a location, which must be below count, is a member of
pub fun key_at(l: *Locations, at: u32) u32 {
    if (at < rows_of(l)) { ret l.file.registers[at].class::u32; }
    ret keys(l) - l.memories.len::u32 + memory_index(l, at)::u32;
}

# the location `k` registers of its class past location `at`, which must be
# below count: the register numbered k after it, NONE when its class has none
# there or `at` is a cell and k is not 0
pub fun past(l: *Locations, at: u32, k: u32) u32 {
    if (k == 0)           { ret at; }
    if (at >= rows_of(l)) { ret NONE; }
    val id:     rf.Id = rf.id_of(?l.file.registers[at]);
    val number: u32   = rf.number_of(id)::u32 + k;
    if (number > 0xffff) { ret NONE; }
    val row: opt[u32] = rf.index_of(l.file, rf.make(rf.class_of(id), number::u16));
    if (sel row.none) { ret NONE; }
    ret row.some;
}

# the location `k` registers of its class before location `at`, which must be
# below count, NONE when its class has none there or `at` is a cell and k is not 0
pub fun before(l: *Locations, at: u32, k: u32) u32 {
    if (k == 0)           { ret at; }
    if (at >= rows_of(l)) { ret NONE; }
    val id: rf.Id = rf.id_of(?l.file.registers[at]);
    if (rf.number_of(id)::u32 < k) { ret NONE; }
    val row: opt[u32] = rf.index_of(l.file, rf.make(rf.class_of(id), (rf.number_of(id)::u32 - k)::u16));
    if (sel row.none) { ret NONE; }
    ret row.some;
}

# the locations sharing storage with a location, itself first
pub fun shares(l: *Locations, at: u32) Slice[u32] {
    ret graph.list[u32](?l.shares, at);
}

#[testing]
val T_SMALL: Memory = Memory{name: "small", width: 8, count: 2};

#[testing]
val T_LARGE: Memory = Memory{name: "large", width: 16, count: 3};

# the cells of the classes in the order given, each class's first at its base
#[testing]
fun t_numbered(a: *allocator.Allocator, first: *Memory, second: *Memory) i32 {
    var given: [2]*Memory            = [2]*Memory{first, second};
    val made:  res[Locations, Error] = init(a, ?function.T_FILE, Slice[*Memory]{data: ?given[0], size: 2});
    if (sel made.err) { ret 1; }
    var l: Locations = made.ok;
    fin { dnit(?l); }
    val rows: u32 = function.T_FILE.register_count;
    if (count(?l) != rows + first.count + second.count) { ret 2; }
    val one: res[u32, Unlocated] = locate(?l, Physical.cell{Cell{class: first, number: 1}});
    val two: res[u32, Unlocated] = locate(?l, Physical.cell{Cell{class: second, number: 0}});
    if (!(sel one.ok && one.ok == rows + 1))           { ret 3; }
    if (!(sel two.ok && two.ok == rows + first.count)) { ret 4; }
    val back: Physical = physical(?l, rows + first.count);
    if (!(sel back.cell))                                   { ret 5; }
    if (back.cell.class != second || back.cell.number != 0) { ret 5; }
    ret 0;
}

test init__cells_are_numbered_in_the_order_the_target_supplies_their_classes {
    var a: allocator.Allocator;
    page.make(?a);
    # one of the two orders differs from the classes' address order
    if (t_numbered(?a, ?T_SMALL, ?T_LARGE) != 0) { ret 1; }
    if (t_numbered(?a, ?T_LARGE, ?T_SMALL) != 0) { ret 2; }
    var twice: [3]*Memory            = [3]*Memory{?T_SMALL, ?T_LARGE, ?T_SMALL};
    val made:  res[Locations, Error] = init(?a, ?function.T_FILE, Slice[*Memory]{data: ?twice[0], size: 3});
    if (!(sel made.err))           { ret 3; }
    if (!(sel made.err.duplicate)) { ret 3; }
    if (made.err.duplicate != 2)   { ret 3; }
    ret 0;
}

# a register asked of a function whose set has no register file is refused, naming it
test locate__a_register_of_a_set_with_no_register_file_is_refused_by_name {
    var a: allocator.Allocator;
    page.make(?a);
    var f: function.Function = function.init(?a, ?function.T_UNFILED);
    fin { function.dnit(?f); }
    var given: [1]*Memory            = [1]*Memory{?T_SMALL};
    val made:  res[Locations, Error] = init(?a, function.file(?f), Slice[*Memory]{data: ?given[0], size: 1});
    if (sel made.err) { ret 1; }
    var l: Locations = made.ok;
    fin { dnit(?l); }
    val reg: rf.Id               = rf.make(0, 2);
    val got: res[u32, Unlocated] = locate(?l, Physical.register{reg});
    if (!(sel got.err))         { ret 2; }
    if (!(sel got.err.unfiled)) { ret 3; }
    if (got.err.unfiled != reg) { ret 4; }
    ret 0;
}
