# the rewrite of a virtual form under an assignment: every virtual register an
# operand names becomes the location assigned to it, or the register of the
# view its position takes within that location, the first member of a tuple
# at a position admitting its members alone, and a member operand the
# register of that member of the tuple's location
#
# the result has the form's slots, blocks and placed instructions in the same
# order, numbered in that order, and declares no virtual register. every
# instruction is made through the function's own maker, so each rewritten
# operand is checked against its row as it is made.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.machine.alloc.live.Site;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Physical;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.instruction.Viewing;
use operand_kind: mirl.machine.operand;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;
use mirl.machine.operand.Tied;

use rf: masc.core.register;

# no location
pub val NONE: u32 = 0xffffffff;

# why a rewrite was refused
# ---
# alloc:      the allocator refused storage
# refused:    the function's maker refused a rewritten instruction
# unassigned: an operand names a virtual register with no location
# unviewed:   an operand names a virtual register through a view its location
#             holds no register of
pub tag Error: u8 {
    alloc:      allocator.Error;
    refused:    function.Error;
    unassigned: Site;
    unviewed:   Site;
}

fun located(at: *Locations, locations: Slice[u32], v: u32, site: Site) res[Physical, Error] {
    val loc: u32 = locations.data[v];
    if (loc == NONE) { ret res[Physical, Error].err{Error.unassigned{site}}; }
    ret res[Physical, Error].ok{location.physical(at, loc)};
}

fun register(at: *Locations, locations: Slice[u32], r: Register, site: Site) res[Register, Error] {
    if (sel r.physical) { ret res[Register, Error].ok{r}; }
    val p: res[Physical, Error] = located(at, locations, r.virtual, site);
    if (sel p.err) { ret res[Register, Error].err{p.err}; }
    ret res[Register, Error].ok{Register.physical{p.ok}};
}

# the register of a view within the location of virtual register `v`
fun viewed(at: *Locations, locations: Slice[u32], v: u32, w: Viewing, site: Site) res[Operand, Error] {
    val p: res[Physical, Error] = located(at, locations, v, site);
    if (sel p.err)            { ret res[Operand, Error].err{p.err}; }
    if (!(sel p.ok.register)) { ret res[Operand, Error].err{Error.unviewed{site}}; }
    val r: opt[rf.Id] = instruction.viewed_in(at.file, p.ok.register, w);
    if (sel r.none) { ret res[Operand, Error].err{Error.unviewed{site}}; }
    ret res[Operand, Error].ok{Operand.physical{Physical.register{r.some}}};
}

# a half of a tie at its location, through the view its position takes of
# its virtual register's class where it takes one
fun tie_half(f: *Function, at: *Locations, locations: Slice[u32], op: Opcode, n: u32, r: Register, site: Site) res[Register, Error] {
    if (sel r.virtual) {
        val w: opt[Viewing] = instruction.viewing(function.file(f), op, n, function.class_of(f, r.virtual));
        if (sel w.some) {
            val o: res[Operand, Error] = viewed(at, locations, r.virtual, w.some, site);
            if (sel o.err) { ret res[Register, Error].err{o.err}; }
            val got: Operand = o.ok;
            if (sel got.physical) { ret res[Register, Error].ok{Register.physical{got.physical}}; }
            ret res[Register, Error].err{Error.unviewed{site}};
        }
    }
    ret register(at, locations, r, site);
}

# an operand with every register it names at its location
fun operand(at: *Locations, locations: Slice[u32], o: Operand, site: Site) res[Operand, Error] {
    var names: [operand_kind.MOST_NAMED]Register;
    val n:     u32 = operand_kind.named(o, ?names[0]);
    if (n == 0) { ret res[Operand, Error].ok{o}; }
    var i: u32 = 0;
    for (i < n) {
        val r: res[Register, Error] = register(at, locations, names[i], site);
        if (sel r.err) { ret res[Operand, Error].err{r.err}; }
        names[i] = r.ok;
        i        = i + 1;
    }
    ret res[Operand, Error].ok{operand_kind.renamed(o, ?names[0])};
}

fun fill(f: *Function, at: *Locations, locations: Slice[u32], out: *Function, ops: *vector.Vector[Operand]) err[Error] {
    val inherited: err[allocator.Error] = function.inherit(out, f);
    if (sel inherited.err) { ret err[Error].err{Error.refused{function.Error.alloc{inherited.err}}}; }
    var s: usize = 0;
    for (s < f.slots.len) {
        val made: res[Slot, function.Error] = function.slot(out, f.slots.data[s]);
        if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
        s = s + 1;
    }
    var k: usize = 0;
    for (k < f.blocks.len) {
        val made: res[Block, function.Error] = function.block(out);
        if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
        k = k + 1;
    }
    val room: err[allocator.Error] = function.room_of(out, f);
    if (sel room.err) { ret err[Error].err{Error.refused{function.Error.alloc{room.err}}}; }
    val file: *rf.File = function.file(f);
    k = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, (k::u32));
        var i:    usize              = 0;
        for (i < list.size) {
            val d: *InstructionData = function.data(f, list.data[i]);
            vector.clear[Operand](ops);
            val room: res[usize, allocator.Error] = vector.reserve[Operand](ops, d.operands.size);
            if (sel room.err) { ret err[Error].err{Error.alloc{room.err}}; }
            var n: usize = 0;
            for (n < d.operands.size) {
                val given: *Operand = ?d.operands.data[n];
                if (sel given.virtual) {
                    val v: u32          = given.virtual;
                    val w: opt[Viewing] = instruction.viewing(file, d.opcode, n::u32, function.class_of(f, v));
                    if (sel w.some) {
                        val o: res[Operand, Error] = viewed(at, locations, v, w.some, Site{instruction: list.data[i], operand: n::u32});
                        if (sel o.err) { ret err[Error].err{o.err}; }
                        ops.data[n] = o.ok;
                    }
                    or {
                        val loc: u32 = locations.data[v];
                        if (loc == NONE) { ret err[Error].err{Error.unassigned{Site{instruction: list.data[i], operand: n::u32}}}; }
                        ops.data[n] = Operand.physical{location.physical(at, loc)};
                    }
                }
                or (sel given.address || sel given.list) {
                    val o: res[Operand, Error] = operand(at, locations, @given, Site{instruction: list.data[i], operand: n::u32});
                    if (sel o.err) { ret err[Error].err{o.err}; }
                    ops.data[n] = o.ok;
                }
                or (sel given.member) {
                    val site: Site         = Site{instruction: list.data[i], operand: n::u32};
                    val w:    opt[Viewing] = instruction.member_viewing(file, function.class_of(f, given.member.virtual), given.member.index);
                    if (sel w.none) { ret err[Error].err{Error.unviewed{site}}; }
                    val o: res[Operand, Error] = viewed(at, locations, given.member.virtual, w.some, site);
                    if (sel o.err) { ret err[Error].err{o.err}; }
                    ops.data[n] = o.ok;
                }
                or (sel given.tied) {
                    val site: Site                 = Site{instruction: list.data[i], operand: n::u32};
                    val dest: res[Register, Error] = tie_half(f, at, locations, d.opcode, n::u32, given.tied.dest, site);
                    if (sel dest.err) { ret err[Error].err{dest.err}; }
                    val source: res[Register, Error] = tie_half(f, at, locations, d.opcode, n::u32, given.tied.source, site);
                    if (sel source.err) { ret err[Error].err{source.err}; }
                    ops.data[n] = Operand.tied{Tied{dest: dest.ok, source: source.ok}};
                }
                or { ops.data[n] = @given; }
                n = n + 1;
            }
            val made: res[Instruction, function.Error] = function.carry(out, (k::u32), d, Slice[Operand]{data: ops.data, size: d.operands.size});
            if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# a virtual form rewritten under an assignment
# ---
# a:         the allocator the result takes
# f:         the virtual form, every instruction placed in a block
# at:        the locations of its target
# locations: each virtual register's location, NONE for one with none
# ret:       the rewritten function, or why it was refused
pub fun rewrite(a: *allocator.Allocator, f: *Function, at: *Locations, locations: Slice[u32]) res[Function, Error] {
    var out: Function               = function.init(a, f.set, f.checked);
    var ops: vector.Vector[Operand] = vector.init[Operand](a);
    fin { vector.dnit[Operand](?ops); }
    val done: err[Error] = fill(f, at, locations, ?out, ?ops);
    if (sel done.err) {
        function.dnit(?out);
        ret res[Function, Error].err{done.err};
    }
    ret res[Function, Error].ok{out};
}
