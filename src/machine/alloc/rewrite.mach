# the rewrite of a virtual form under an assignment: every virtual register an
# operand names becomes the location assigned to it
#
# the result has the form's slots, blocks and placed instructions in the same
# order, numbered in that order, and declares no virtual register. every
# instruction is made through the function's own maker, so each rewritten
# operand is checked against its row as it is made.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.machine.alloc.live.Site;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Physical;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;
use mirl.machine.operand.Tied;

# no location
pub val NONE: u32 = 0xffffffff;

# why a rewrite was refused
# ---
# alloc:      the allocator refused storage
# refused:    the function's maker refused a rewritten instruction
# unassigned: an operand names a virtual register with no location
pub tag Error: u8 {
    alloc:      allocator.Error;
    refused:    function.Error;
    unassigned: Site;
}

fun located(at: *Locations, locations: Slice[u32], v: u32, site: Site) res[Physical, Error] {
    val loc: u32 = locations.data[v];
    if (loc == NONE) { ret res[Physical, Error].err{Error.unassigned{site}}; }
    ret res[Physical, Error].ok{location.physical(at, loc)};
}

fun register(at: *Locations, locations: Slice[u32], r: Register, site: Site) res[Register, Error] {
    if (sel r.physical) { ret res[Register, Error].ok{r}; }
    val p: res[Physical, Error] = located(at, locations, r.virtual.index, site);
    if (sel p.err) { ret res[Register, Error].err{p.err}; }
    ret res[Register, Error].ok{Register.physical{p.ok}};
}

fun operand(at: *Locations, locations: Slice[u32], o: Operand, site: Site) res[Operand, Error] {
    if (sel o.virtual) {
        val p: res[Physical, Error] = located(at, locations, o.virtual.index, site);
        if (sel p.err) { ret res[Operand, Error].err{p.err}; }
        ret res[Operand, Error].ok{Operand.physical{p.ok}};
    }
    if (sel o.tied) {
        val d: res[Register, Error] = register(at, locations, o.tied.dest, site);
        if (sel d.err) { ret res[Operand, Error].err{d.err}; }
        val s: res[Register, Error] = register(at, locations, o.tied.source, site);
        if (sel s.err) { ret res[Operand, Error].err{s.err}; }
        ret res[Operand, Error].ok{Operand.tied{Tied{dest: d.ok, source: s.ok}}};
    }
    ret res[Operand, Error].ok{o};
}

fun fill(f: *Function, at: *Locations, locations: Slice[u32], out: *Function, ops: *vector.Vector[Operand]) err[Error] {
    var s: usize = 0;
    for (s < f.slots.len) {
        val made: res[Slot, function.Error] = function.slot(out, f.slots.data[s]);
        if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
        s = s + 1;
    }
    var k: usize = 0;
    for (k < f.blocks.len) {
        val made: res[Block, function.Error] = function.block(out);
        if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
        k = k + 1;
    }
    k = 0;
    for (k < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, Block{index: k::u32});
        var i:    usize              = 0;
        for (i < list.size) {
            val d: *InstructionData = function.data(f, list.data[i]);
            vector.clear[Operand](ops);
            var n: usize = 0;
            for (n < d.operands.size) {
                val o: res[Operand, Error] = operand(at, locations, d.operands.data[n], Site{instruction: list.data[i], operand: n::u32});
                if (sel o.err) { ret err[Error].err{o.err}; }
                val p: res[usize, allocator.Error] = vector.push[Operand](ops, o.ok);
                if (sel p.err) { ret err[Error].err{Error.alloc{p.err}}; }
                n = n + 1;
            }
            val made: res[Instruction, function.Error] = function.append(out, Block{index: k::u32}, d.opcode, Slice[Operand]{data: ops.data, size: ops.len}, d.metadata, d.declassifies, d.vtype);
            if (sel made.err) { ret err[Error].err{Error.refused{made.err}}; }
            val implied: err[function.Error] = function.imply(out, made.ok, d.implicit);
            if (sel implied.err) { ret err[Error].err{Error.refused{implied.err}}; }
            function.label(out, made.ok, d.label);
            i = i + 1;
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# a virtual form rewritten under an assignment
# ---
# a:         the allocator the result takes
# f:         the virtual form, every instruction placed in a block
# at:        the locations of its target
# locations: each virtual register's location, NONE for one with none
# ret:       the rewritten function, or why it was refused
pub fun rewrite(a: *allocator.Allocator, f: *Function, at: *Locations, locations: Slice[u32]) res[Function, Error] {
    var out: Function               = function.init(a, f.set);
    var ops: vector.Vector[Operand] = vector.init[Operand](a);
    fin { vector.dnit[Operand](?ops); }
    val done: err[Error] = fill(f, at, locations, ?out, ?ops);
    if (sel done.err) {
        function.dnit(?out);
        ret res[Function, Error].err{done.err};
    }
    ret res[Function, Error].ok{out};
}
