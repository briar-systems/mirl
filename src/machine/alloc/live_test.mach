# tests of liveness and live intervals, machine form text in and intervals out

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.machine.alloc.live;
use mirl.machine.alloc.live.Clobber;
use mirl.machine.alloc.live.Hold;
use mirl.machine.alloc.live.Live;
use mirl.machine.alloc.live.Segment;
use mirl.machine.alloc.live.Use;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.operand.Virtual;
use mirl.machine.synthetic;
use reader: mirl.machine.text.parse;

use rf: masc.core.register;

#[testing]
val MEMORIES: [1]*Memory = [1]*Memory{?function.T_PAGE};

#[testing]
val MODULE: str = "target \"mtest\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%a: i32):\n    ret %a\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a function's text, read and its liveness computed, handed to a check
# ---
# text:  the machine form text of @f
# check: what the liveness must hold, 0 when it does
# ret:   0, or the step that failed
#[testing]
fun with_live(text: str, check: fun(*Live, *Locations, *Function) i32) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val read: res[reader.Unit, Refusal] = reader.parse_body_in(?a, ?m, ?synthetic.REGISTRY, ?synthetic.ARCH, ?synthetic.TARGET, view_of(text));
    if (sel read.err) { ret 2; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    val f:   *Function                      = ?u.items.data[0].function;
    val got: res[Locations, location.Error] = location.init(?a, function.file(f), Slice[*Memory]{data: ?MEMORIES[0], size: 1});
    if (sel got.err) { ret 3; }
    var at: Locations = got.ok;
    fin { location.dnit(?at); }
    val computed: res[Live, live.Error] = live.compute(?a, f, ?at, Slice[Clobber]{data: nil, size: 0});
    if (sel computed.err) { ret 4; }
    var l: Live = computed.ok;
    fin { live.dnit(?l); }
    ret check(?l, ?at, f);
}

#[testing]
fun same_segments(got: Slice[Segment], want: *Segment, count: usize) bool {
    if (got.size != count) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (got.data[i].from != want[i].from || got.data[i].to != want[i].to) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
fun same_holds(got: Slice[Hold], want: *Hold, count: usize) bool {
    if (got.size != count) { ret false; }
    var i: usize = 0;
    for (i < count) {
        if (got.data[i].from != want[i].from || got.data[i].to != want[i].to || got.data[i].owner != want[i].owner) { ret false; }
        i = i + 1;
    }
    ret true;
}

# %0 is read by the first add and written again before the second, so it is
# dead from the first add's use slot to the second load's def slot
#[testing]
val REDEFINED: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    load %1, [0]\n    add %1 = %1, %0\n    load %0, [0]\n    add %1 = %1, %0\n}\n";

#[testing]
fun check_hole(l: *Live, at: *Locations, f: *Function) i32 {
    var zero: [2]Segment = [2]Segment{Segment{from: 1, to: 5}, Segment{from: 7, to: 9}};
    if (!same_segments(live.segments(l, Virtual{index: 0}), ?zero[0], 2)) { ret 10; }
    var one: [1]Segment = [1]Segment{Segment{from: 3, to: 10}};
    if (!same_segments(live.segments(l, Virtual{index: 1}), ?one[0], 1))                { ret 11; }
    if (live.covers(l, Virtual{index: 0}, 5) || live.covers(l, Virtual{index: 0}, 6))   { ret 12; }
    if (!live.covers(l, Virtual{index: 0}, 4) || !live.covers(l, Virtual{index: 0}, 7)) { ret 12; }
    ret 0;
}

test live__an_interval_has_a_hole_where_its_value_is_dead {
    ret with_live(REDEFINED, check_hole);
}

# %0 is read inside the loop ^1 and again after it by a multiply whose
# operands the row fixes to r0 and r1
#[testing]
val LOOPED: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    virtual %1: class r\n    virtual %2: class r\n    virtual %3: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    load %1, [0]\n    jump ^1\n^1:\n    add %1 = %1, %0\n    bnz %1, ^1\n    jump ^2\n^2:\n    wide %2 = %0, %3, %1\n}\n";

#[testing]
fun check_weights(l: *Live, at: *Locations, f: *Function) i32 {
    val zero: Virtual    = Virtual{index: 0};
    val u:    Slice[Use] = live.uses(l, zero);
    if (u.size != 3)                                                           { ret 10; }
    if (!u.data[0].write || u.data[0].position != 1 || u.data[0].weight != 1)  { ret 11; }
    if (u.data[1].write || u.data[1].position != 6 || u.data[1].weight != 8)   { ret 12; }
    if (u.data[2].write || u.data[2].position != 12 || u.data[2].weight != 1)  { ret 13; }
    if (u.data[1].weight <= u.data[2].weight || live.weight_of(l, zero) != 10) { ret 14; }
    var whole: [1]Segment = [1]Segment{Segment{from: 1, to: 13}};
    if (!same_segments(live.segments(l, zero), ?whole[0], 1)) { ret 15; }

    # the fixed operands hold r0 and r1 for the values pinned to them
    val r0: opt[u32] = location.locate(at, Physical.register{rf.make(0, 0)});
    val r1: opt[u32] = location.locate(at, Physical.register{rf.make(0, 1)});
    if (sel r0.none)                                       { ret 16; }
    if (sel r1.none)                                       { ret 16; }
    if (u.data[2].fixed != r0.some || u.data[2].tied != 2) { ret 17; }
    var low: [2]Hold = [2]Hold{Hold{from: 12, to: 13, owner: 0}, Hold{from: 13, to: 14, owner: 2}};
    if (!same_holds(live.holds(l, r0.some), ?low[0], 2)) { ret 18; }
    var high: [1]Hold = [1]Hold{Hold{from: 13, to: 14, owner: 3}};
    if (!same_holds(live.holds(l, r1.some), ?high[0], 1)) { ret 19; }
    val held: opt[u32] = live.blocked(l, at, r0.some, Virtual{index: 1});
    if (!(sel held.some && held.some == 12)) { ret 20; }
    val free: opt[u32] = live.blocked(l, at, r0.some, zero);
    if (sel free.some) { ret 21; }
    ret 0;
}

test live__a_use_inside_a_loop_weighs_more_than_one_outside {
    ret with_live(LOOPED, check_weights);
}

# a copy writes r2 and a later jump states it reads r2, so r2 holds its value
# from the copy to the jump
#[testing]
val IMPLIED: str = "target \"mtest\"\n\nfunction @f {\n    virtual %0: class r\n    slot [0]: size 4 align 4\n^0:\n    load %0, [0]\n    pseudo copy r2, %0\n    load %0, [0]\n    jump ^1 reads [r2]\n^1:\n    jump ^1\n}\n";

#[testing]
fun check_implied(l: *Live, at: *Locations, f: *Function) i32 {
    val r2: opt[u32] = location.locate(at, Physical.register{rf.make(0, 2)});
    if (sel r2.none) { ret 10; }
    var held: [1]Hold = [1]Hold{Hold{from: 3, to: 7, owner: live.NONE}};
    if (!same_holds(live.holds(l, r2.some), ?held[0], 1)) { ret 11; }
    ret 0;
}

test live__a_stated_read_holds_its_register_from_where_it_is_written {
    ret with_live(IMPLIED, check_implied);
}
