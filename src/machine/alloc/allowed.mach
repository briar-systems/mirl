# the locations a target lets the allocator assign
#
# masc models no reserved or allocatable set, since which registers a
# function may take is a calling convention's fact, so the target states the
# set. every location in it must be one the locations number, never a
# register masc gives a fixed architectural role (a stack pointer, a zero
# register or a program counter), and stated once. the set is grouped by the
# class each location is a member of, each group ascending by location
# number, so the candidates of a class are found in O(1) and every choice
# among them can break a tie on the location number.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class;
use mirl.machine.class.Cell;
use mirl.machine.class.Physical;
use mirl.target.abi.convention.Registers;
use mirl.target.build.Build;

use rf:         masc.core.register;
use core_state: masc.core.state;

# why a set of locations was refused, or a machine's allowed locations were
# not listed
# ---
# alloc:     the allocator refused storage
# unlocated: a location the locations refused, and why
# role:      a register masc gives a fixed architectural role, or a tuple
#            holding one
# twice:     a location stated more than once
# foreign:   the locations are of another register file than the context's
pub tag Error: u8 {
    alloc:     allocator.Error;
    unlocated: location.Unlocated;
    role:      Physical;
    twice:     Physical;
    foreign;
}

# the locations a target lets the allocator assign
# ---
# member: one bit per location, set when the location is in the set
# sorted: the set, ascending by location number
# groups: the set grouped by class key, each group ascending
pub rec Allowed {
    member: vector.Vector[u64];
    sorted: vector.Vector[u32];
    groups: Lists[u32];
}

fun by_number(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# whether masc gives row `row` of `file` a fixed architectural role, or a
# tuple a member that has one, as aarch64's x30:xzr
fun roled(file: *rf.File, row: *rf.Register) bool {
    if ((row.flags & (rf.STACK | rf.ZERO | rf.PC)) != 0) { ret true; }
    var k: u32 = 0;
    for (k < row.members.len) {
        if (roled(file, ?file.registers[row.members.at[k]])) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun fill(a: *allocator.Allocator, x: *Allowed, at: *Locations, given: Slice[Physical]) err[Error] {
    var failed: err[allocator.Error]        = slice.fill[u64](?x.member, ((location.count(at) + 63) / 64)::usize, 0);
    val room:   res[usize, allocator.Error] = vector.reserve[u32](?x.sorted, given.size);
    if (sel room.err)   { keep(?failed, err[allocator.Error].err{room.err}); }
    if (sel failed.err) { ret err[Error].err{Error.alloc{failed.err}}; }
    var i: usize = 0;
    for (i < given.size) {
        val p:   Physical                     = given.data[i];
        val got: res[u32, location.Unlocated] = location.locate(at, p);
        if (sel got.err) { ret err[Error].err{Error.unlocated{got.err}}; }
        if (sel p.register) {
            val row: opt[*rf.Register] = rf.row_of(at.file, p.register);
            if (sel row.some && roled(at.file, row.some)) { ret err[Error].err{Error.role{p}}; }
        }
        vector.push[u32](?x.sorted, got.ok);
        i = i + 1;
    }
    sort.sort_by[u32](x.sorted.data, x.sorted.len, by_number);
    i = 0;
    for (i < x.sorted.len) {
        val n: u32 = x.sorted.data[i];
        if (i > 0 && x.sorted.data[i - 1] == n) { ret err[Error].err{Error.twice{location.physical(at, n)}}; }
        x.member.data[(n / 64)::usize] = x.member.data[(n / 64)::usize] | ((1::u64) << (n % 64)::u64);
        i                              = i + 1;
    }
    var keys: vector.Vector[u32] = vector.init[u32](a);
    fin { vector.dnit[u32](?keys); }
    val kroom: res[usize, allocator.Error] = vector.reserve[u32](?keys, x.sorted.len);
    if (sel kroom.err) { ret err[Error].err{Error.alloc{kroom.err}}; }
    i = 0;
    for (i < x.sorted.len) {
        vector.push[u32](?keys, location.key_at(at, x.sorted.data[i]));
        i = i + 1;
    }
    val made: res[Lists[u32], allocator.Error] = graph.lists[u32](a, location.keys(at), Slice[u32]{data: keys.data, size: keys.len}, Slice[u32]{data: x.sorted.data, size: x.sorted.len});
    if (sel made.err) { ret err[Error].err{Error.alloc{made.err}}; }
    x.groups = made.ok;
    ret err[Error].ok{};
}

# the set a target states, checked against the locations
# ---
# a:     the allocator the set takes
# at:    the locations of the target
# given: the locations, in any order
# ret:   the set, or why it was refused
pub fun init(a: *allocator.Allocator, at: *Locations, given: Slice[Physical]) res[Allowed, Error] {
    var x: Allowed = Allowed{
        member: vector.init[u64](a),
        sorted: vector.init[u32](a),
        groups: Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)},
    };
    val filled: err[Error] = fill(a, ?x, at, given);
    if (sel filled.err) {
        dnit(?x);
        ret res[Allowed, Error].err{filled.err};
    }
    ret res[Allowed, Error].ok{x};
}

# give back the set's storage
pub fun dnit(x: *Allowed) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u64](?x.member);
    keep(?failed, vector.dnit[u32](?x.sorted));
    keep(?failed, graph.release[u32](?x.groups));
    ret failed;
}

# the locations one kind of function may be given, built once per build:
# listed as the steps after allocation read them and as the allocator's set
# ---
# listed: the locations, in register then cell order
# set:    the same locations, as the allocator reads them
# pool:   the registers among them of a class holding the stack pointer's
#         values (`class.addresses`), in their order, which the frame code
#         scavenges and a move between memory borrows
pub rec Given {
    listed: vector.Vector[Physical];
    set:    Allowed;
    pool:   vector.Vector[rf.Id];
}

# the locations a build lets the allocator assign, as `of_build` lists them,
# with their set
pub fun given(a: *allocator.Allocator, b: *Build, at: *Locations, keeps: bool, ctx: *core_state.Context, convention: *Registers) res[Given, Error] {
    val listed: res[vector.Vector[Physical], Error] = of_build(a, b, at, keeps, ctx, convention);
    if (sel listed.err) { ret res[Given, Error].err{listed.err}; }
    var out: vector.Vector[Physical] = listed.ok;
    val set: res[Allowed, Error]     = init(a, at, Slice[Physical]{data: out.data, size: out.len});
    if (sel set.err) {
        vector.dnit[Physical](?out);
        ret res[Given, Error].err{set.err};
    }
    var g:      Given                = Given{listed: out, set: set.ok, pool: vector.init[rf.Id](a)};
    val pooled: err[allocator.Error] = pool_of(at, convention, Slice[Physical]{data: out.data, size: out.len}, ?g.pool);
    if (sel pooled.err) {
        release_given(?g);
        ret res[Given, Error].err{Error.alloc{pooled.err}};
    }
    ret res[Given, Error].ok{g};
}

# the registers of a list of a class holding the stack pointer's values, in
# its order, none for a row that homes its stack pointer in no register
fun pool_of(at: *Locations, convention: *Registers, listed: Slice[Physical], out: *vector.Vector[rf.Id]) err[allocator.Error] {
    val stack: opt[rf.Id] = convention.stack;
    if (sel stack.none) { ret err[allocator.Error].ok{}; }
    var i: usize = 0;
    for (i < listed.size) {
        val q: Physical = listed.data[i];
        if (sel q.register) {
            if (class.addresses(at.file, stack.some, rf.class_of(q.register))) {
                val pushed: res[usize, allocator.Error] = vector.push[rf.Id](out, q.register);
                if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# no locations, as a row with no registers gives
pub fun none_given(a: *allocator.Allocator) Given {
    ret Given{listed: vector.init[Physical](a), set: Allowed{member: vector.init[u64](a), sorted: vector.init[u32](a), groups: Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)}}, pool: vector.init[rf.Id](a)};
}

# give back what `given` or `none_given` made
pub fun release_given(x: *Given) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[Physical](?x.listed);
    keep(?failed, dnit(?x.set));
    keep(?failed, vector.dnit[rf.Id](?x.pool));
    ret failed;
}

# whether a location, which must be below the locations' count, is in the set
pub fun admits(x: *Allowed, at: u32) bool {
    ret ((x.member.data[(at / 64)::usize] >> (at % 64)::u64) & 1) != 0;
}

# the locations of the set that are members of the class with a key, ascending
pub fun candidates(x: *Allowed, key: u32) Slice[u32] {
    ret graph.list[u32](?x.groups, key);
}

# the set, ascending
pub fun sorted(x: *Allowed) Slice[u32] {
    ret Slice[u32]{data: x.sorted.data, size: x.sorted.len};
}

fun reserved(convention: *Registers, id: rf.Id) bool {
    val list: Slice[rf.Id] = convention.reserved;
    var lo:   usize        = 0;
    var hi:   usize        = list.size;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (list.data[mid] < id) { lo = mid + 1; }
        or                       { hi = mid; }
    }
    ret lo < list.size && list.data[lo] == id;
}

# whether the build lets the allocator assign register row `row` of `file`:
# the context `ctx` admits it, masc gives it no fixed role, the function's
# convention row does not reserve it and it is not the frame pointer the frame keeps. a tuple is
# assignable when its class is no fixed one, as x86's rdx:rax, and every
# member is, so no pair holds a reserved or zero half
fun assignable(convention: *Registers, ctx: *core_state.Context, file: *rf.File, row: *rf.Register, keeps: bool) bool {
    val id:            rf.Id          = rf.id_of(row);
    val held:          err[rf.Absent] = rf.admitted(ctx.view, id);
    val frame_pointer: opt[rf.Id]     = convention.pointer;
    val pointer:       bool           = sel frame_pointer.some && frame_pointer.some == id && keeps;
    if (!(sel held.ok) || (row.flags & (rf.STACK | rf.ZERO | rf.PC)) != 0 || reserved(convention, id) || pointer) { ret false; }
    if (!rf.tuple(row))                                                                                           { ret true; }
    if (file.classes[row.class].fixed)                                                                            { ret false; }
    var k: u32 = 0;
    for (k < row.members.len) {
        if (!assignable(convention, ctx, file, ?file.registers[row.members.at[k]], keeps)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the locations a build lets the allocator assign: every register row it
# finds assignable, and every cell of the memory classes the locations number
# ---
# a:          the allocator the list takes
# b:          the opened build
# at:         the locations of its target
# keeps:      whether the frame keeps its pointer, as `keeps_pointer` answers
# ctx:        the context the function is made under, the build's or one its
#             extensions past the build's widen it to, whose view admits registers
# convention: the registers of the row the function is under, whose
#             reserved registers and frame pointer it never assigns
# ret:        the locations, in register then cell order, or why they were not listed
pub fun of_build(a: *allocator.Allocator, b: *Build, at: *Locations, keeps: bool, ctx: *core_state.Context, convention: *Registers) res[vector.Vector[Physical], Error] {
    if (at.file != ctx.view.file) { ret res[vector.Vector[Physical], Error].err{Error.foreign{}}; }
    var out:  vector.Vector[Physical] = vector.init[Physical](a);
    val file: *rf.File                = at.file;
    var i:    u32                     = 0;
    for (file != nil && i < file.register_count) {
        val row: *rf.Register = ?file.registers[i];
        if (assignable(convention, ctx, file, row, keeps)) {
            val pushed: res[usize, allocator.Error] = vector.push[Physical](?out, Physical.register{rf.id_of(row)});
            if (sel pushed.err) {
                vector.dnit[Physical](?out);
                ret res[vector.Vector[Physical], Error].err{Error.alloc{pushed.err}};
            }
        }
        i = i + 1;
    }
    var k: usize = 0;
    for (k < at.memories.len) {
        var n: u32 = 0;
        for (n < at.memories.data[k].count) {
            val pushed: res[usize, allocator.Error] = vector.push[Physical](?out, Physical.cell{Cell{class: at.memories.data[k], number: n}});
            if (sel pushed.err) {
                vector.dnit[Physical](?out);
                ret res[vector.Vector[Physical], Error].err{Error.alloc{pushed.err}};
            }
            n = n + 1;
        }
        k = k + 1;
    }
    ret res[vector.Vector[Physical], Error].ok{out};
}
