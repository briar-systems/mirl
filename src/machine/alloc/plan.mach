# what the rounds of allocation have decided about the input function
#
# every round builds its virtual form from the input and this plan, so a
# decision is a fact about the input and never about a form a round made.
# a virtual register of the input lives whole, in one location over its
# interval, or in pieces, with its value in a frame slot, stored after each
# write and reloaded for each run of reads. an operand half, the read or the
# write one operand of one instruction of the input makes, may also be given
# a value of its own: a copy of the value just before the instruction, or a
# copy back just after it, so the half can sit in a location its row fixes or
# its tie needs while the value lives elsewhere. a decision is only ever
# added, so the rounds end.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.fail.keep;
use mirl.machine.function.Function;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Virtual;
use mirl.slice;

# a virtual register held in one location over its interval
pub val WHOLE: u8 = 0;

# a virtual register held in a frame slot and carried in pieces
pub val PIECES: u8 = 1;

# the decisions of the rounds
# ---
# modes: each input virtual register's mode
# base:  each input instruction's first operand among all operands
# own:   one bit per operand half, set when the half has a value of its own
pub rec Plan {
    modes: vector.Vector[u8];
    base:  vector.Vector[u64];
    own:   vector.Vector[u64];
}

fun fill(p: *Plan, f: *Function) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.fill[u8](?p.modes, f.virtuals.len, WHOLE);
    keep(?failed, slice.fill[u64](?p.base, f.instructions.len, 0));
    if (sel failed.err) { ret failed; }
    var total: u64   = 0;
    var i:     usize = 0;
    for (i < f.instructions.len) {
        p.base.data[i] = total;
        total          = total + f.instructions.data[i].operands.size::u64;
        i              = i + 1;
    }
    ret slice.fill[u64](?p.own, ((2 * total + 63) / 64)::usize, 0);
}

# a plan with every virtual register whole and no half on its own
pub fun init(a: *allocator.Allocator, f: *Function) res[Plan, allocator.Error] {
    var p:      Plan                 = Plan{modes: vector.init[u8](a), base: vector.init[u64](a), own: vector.init[u64](a)};
    val filled: err[allocator.Error] = fill(?p, f);
    if (sel filled.err) {
        dnit(?p);
        ret res[Plan, allocator.Error].err{filled.err};
    }
    ret res[Plan, allocator.Error].ok{p};
}

# give back a plan's storage
pub fun dnit(p: *Plan) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u8](?p.modes);
    keep(?failed, vector.dnit[u64](?p.base));
    keep(?failed, vector.dnit[u64](?p.own));
    ret failed;
}

# the mode of an input virtual register
pub fun mode(p: *Plan, v: Virtual) u8 {
    ret p.modes.data[v.index];
}

# carry an input virtual register in pieces from now on
pub fun spill(p: *Plan, v: Virtual) {
    p.modes.data[v.index] = PIECES;
}

fun half(p: *Plan, i: Instruction, operand: u32, write: bool) u64 {
    var h: u64 = 2 * (p.base.data[i.index] + operand::u64);
    if (write) { h = h + 1; }
    ret h;
}

# whether a half of an operand of an input instruction has a value of its own
pub fun owns(p: *Plan, i: Instruction, operand: u32, write: bool) bool {
    val h: u64 = half(p, i, operand, write);
    ret ((p.own.data[(h / 64)::usize] >> (h % 64)) & 1) != 0;
}

# give a half of an operand of an input instruction a value of its own
pub fun give(p: *Plan, i: Instruction, operand: u32, write: bool) {
    val h: u64 = half(p, i, operand, write);
    p.own.data[(h / 64)::usize] = p.own.data[(h / 64)::usize] | ((1::u64) << (h % 64));
}
