# linear scan register allocation of a machine function
#
# allocation runs in rounds. each round builds its virtual form from the
# input and the plan, computes the form's liveness and scans it. a round that
# spills a bundle or gives a half a value of its own adds that to the plan:
# a spilled virtual register of the input is carried in pieces from then on,
# a spilled piece gives every read of its run a reload of its own, and a half
# given its own value keeps it. the plan only grows and every round that does
# not settle adds to it, so the rounds end. the round that settles is
# rewritten under its assignment, and in a checked compilation the checker
# proves the result, so a wrong assignment is a refusal and never a
# miscompile. in an optimised compilation the value map first finds the
# copies, spills and reloads whose destination already holds a value their
# source holds, and the rewrite leaves them out (`mirl.machine.alloc.value`),
# which the checker proves as it proves the rest.
#
# every round builds its form, liveness and scan in the storage of the
# caller's scratch, in place of the last round's, so a round takes no storage
# a round or an allocation before it already held. the input is never
# changed. a refusal at any step leaves it as it was and the scratch of no
# use until the next allocation, and an allocation hands back a new function,
# which the caller puts in the input's place.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Lists;
use mirl.machine.alloc.allowed.Allowed;
use mirl.machine.alloc.check;
use mirl.machine.alloc.live;
use mirl.machine.alloc.live.Clobber;
use mirl.machine.alloc.live.Clobbers;
use mirl.machine.alloc.live.Live;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.alloc.plan;
use mirl.machine.alloc.plan.Plan;
use mirl.machine.alloc.rewrite;
use mirl.machine.alloc.scan;
use mirl.machine.alloc.spill;
use mirl.machine.alloc.spill.Form;
use mirl.machine.alloc.spill.Sizes;
use mirl.machine.alloc.value;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.effects.Effects;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;
use mirl.machine.operand.Virtual;
use mirl.machine.point.Point;
use mirl.machine.point.Reading;

use rf:         masc.core.register;
use core_state: masc.core.state;

# the storage allocations work in, which the caller keeps across the
# functions it allocates so that every round fills storage it already holds.
# the plan, the clobbers and what is known are of the function being
# allocated, made anew when an allocation begins. the form, the liveness and
# the result are of its last round, each good until the next round makes it
# again. the rest holds nothing between uses
# ---
# plan:     what the rounds have decided
# clobbers: the input's clobber sets, grouped by instruction
# known:    what the first round knows for the rest
# form:     the round's virtual form and the storage it is built in
# live:     the storage liveness works in
# liveness: the round's liveness of its form
# scan:     the storage the scan works in
# result:   what the round's scan decided
# pieces:   by virtual register of the form, whether it is a piece spilled
# keys:     each clobber's instruction
# items:    each clobber's set
pub rec Scratch {
    plan:     Plan;
    clobbers: Lists[u32];
    known:    live.Known;
    form:     spill.Scratch;
    live:     live.Scratch;
    liveness: Live;
    scan:     scan.Scratch;
    result:   scan.Result;
    pieces:   vector.Vector[bool];
    keys:     vector.Vector[u32];
    items:    vector.Vector[u32];
}

# storage for allocations, holding none yet
pub fun scratch(a: *allocator.Allocator) Scratch {
    ret Scratch{
        plan:     plan.init(a),
        clobbers: graph.lists_init[u32](a),
        known:    live.known(a),
        form:     spill.scratch(a),
        live:     live.scratch(a),
        liveness: live.init(a),
        scan:     scan.scratch(a),
        result:   scan.init(a),
        pieces:   vector.init[bool](a),
        keys:     vector.init[u32](a),
        items:    vector.init[u32](a),
    };
}

# give back the storage of allocations
pub fun scratch_dnit(s: *Scratch) err[allocator.Error] {
    var err_failed: err[allocator.Error] = plan.dnit(?s.plan);
    keep(?err_failed, graph.lists_dnit[u32](?s.clobbers));
    keep(?err_failed, live.forget(?s.known));
    keep(?err_failed, spill.scratch_dnit(?s.form));
    keep(?err_failed, live.scratch_dnit(?s.live));
    keep(?err_failed, live.dnit(?s.liveness));
    keep(?err_failed, scan.scratch_dnit(?s.scan));
    keep(?err_failed, scan.dnit(?s.result));
    keep(?err_failed, vector.dnit[bool](?s.pieces));
    keep(?err_failed, vector.dnit[u32](?s.keys));
    keep(?err_failed, vector.dnit[u32](?s.items));
    ret err_failed;
}

# what an allocation is given beside the function
# ---
# scratch:   the storage it works in, which no other allocation uses at once
# at:        the locations of the function's target
# context:   the selection's context, under which masc's groupings,
#            constraints and footprints are asked
# allowed:   the locations the target lets the allocator assign, as a set
# effects:   the effects of the function's instructions
# sizes:     the slot a spilled value of each class needs, by class key
# clobbers:  the sets of locations instructions leave undefined beyond
#            their rows, as a calling convention states them at its calls
# unspilled: the classes whose policy never spills a value, as a flags class
# checked:   whether the checker proves the result
# optimized: whether copies whose places hold one value are dropped and a
#            value only read in a loop is split at it (`plan.reset`)
# unset:     the locations that hold no value at the function's entry,
#            ascending (`allowed.unset`)
pub rec Request {
    scratch:   *Scratch;
    at:        *Locations;
    context:   *core_state.Context;
    allowed:   *Allowed;
    effects:   *Effects;
    sizes:     *Sizes;
    clobbers:  Clobbers;
    unspilled: Slice[Class];
    checked:   bool;
    optimized: bool;
    unset:     Slice[u32];
}

# an allocated function
# ---
# function: the function, every operand a location, the input's slots first
# spills:   the slots made for values in pieces, ascending
# used:     the locations assigned, with every register a list's value
#           covers from its location, ascending
# origins:  each instruction's instruction of the input, spill.NONE for one
#           the allocator inserted
# rounds:   how many rounds the allocation took
# shared:   the slots that share another slot's storage, ascending, which
#           nothing names and the frame lays out none of
#           (`mirl.machine.frame.share`), filled by the caller
pub rec Allocation {
    function: Function;
    spills:   vector.Vector[Slot];
    used:     vector.Vector[u32];
    origins:  vector.Vector[u32];
    rounds:   u32;
    shared:   vector.Vector[Slot];
}

# why a function was not allocated
# ---
# alloc:       the allocator refused storage
# foreign:     the locations or the selection's view are of another register file
#              than the function's
# clobber:     a clobber naming an instruction the function or a set the
#              clobbers do not have
# form:        a round's virtual form was not built
# live:        a round's liveness was refused
# scan:        a round's scan was refused
# rewrite:     the rewrite was refused
# check:       the checker refused the result of a checked allocation
# unspillable: a value of a class whose policy never spills it that the
#              round would carry in pieces
# value:       the value map refused the search for copies to drop
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    clobber:     Clobber;
    form:        spill.Error;
    live:        live.Error;
    scan:        scan.Error;
    rewrite:     rewrite.Error;
    check:       check.Error;
    unspillable: Virtual;
    value:       value.Error;
}

# the allocator's refusal `e` stands for, its own or a step's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc)   { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.form)    { ret spill.starved(e.form); }
    if (sel e.live)    { ret live.starved(e.live); }
    if (sel e.scan)    { ret scan.starved(e.scan); }
    if (sel e.rewrite) { ret rewrite.starved(e.rewrite); }
    if (sel e.check)   { ret check.starved(e.check); }
    if (sel e.value)   { ret value.starved(e.value); }
    ret opt[allocator.Error].none{};
}

# what every round shares
rec Context {
    a:         *allocator.Allocator;
    s:         *Scratch;
    f:         *Function;
    ctx:       *core_state.Context;
    at:        *Locations;
    x:         *Allowed;
    fx:        *Effects;
    sizes:     *Sizes;
    sets:      Clobbers;
    clobbers:  *Lists[u32];
    p:         *Plan;
    never:     Slice[Class];
    checked:   bool;
    optimized: bool;
    unset:     Slice[u32];
    dropped:   *vector.Vector[bool];
}

# take the clobbers of an allocation, grouped by instruction, refusing one naming an instruction or a set there is not
fun group(c: *Context, given: Clobbers) err[Error] {
    c.sets = given;
    val clobbers: Slice[Clobber] = given.calls;
    var sets:     u32            = 0;
    if (given.words != 0) { sets = (given.masks.size / given.words::usize)::u32; }
    val keys:  *vector.Vector[u32] = ?c.s.keys;
    val items: *vector.Vector[u32] = ?c.s.items;
    vector.clear[u32](keys);
    vector.clear[u32](items);
    var err_failed:  err[allocator.Error]        = err[allocator.Error].ok{};
    val res_reserve: res[usize, allocator.Error] = vector.reserve[u32](keys, clobbers.size);
    if (sel res_reserve.err) { keep(?err_failed, err[allocator.Error].err{res_reserve.err}); }
    val res_reserve_items: res[usize, allocator.Error] = vector.reserve[u32](items, clobbers.size);
    if (sel res_reserve_items.err) { keep(?err_failed, err[allocator.Error].err{res_reserve_items.err}); }
    if (sel err_failed.err)        { ret err[Error].err{Error.alloc{err_failed.err}}; }
    var i: usize = 0;
    for (i < clobbers.size) {
        val k: Clobber = clobbers.data[i];
        if (k.instruction::usize >= c.f.instructions.len || k.set >= sets) { ret err[Error].err{Error.clobber{k}}; }
        vector.push[u32](keys, k.instruction);
        vector.push[u32](items, k.set);
        i = i + 1;
    }
    val err_made: err[allocator.Error] = graph.group[u32](c.clobbers, c.f.instructions.len::u32, Slice[u32]{data: keys.data, size: keys.len}, Slice[u32]{data: items.data, size: items.len});
    if (sel err_made.err) { ret err[Error].err{Error.alloc{err_made.err}}; }
    ret err[Error].ok{};
}

# the clobbers of a round's form, at its instructions
fun clobbers_of(c: *Context, form: *Form) Clobbers {
    ret Clobbers{words: c.sets.words, masks: c.sets.masks, calls: Slice[Clobber]{data: form.clobbers.data, size: form.clobbers.len}};
}

# whether a class's policy never spills its values
fun unspilled(c: *Context, k: Class) bool {
    var i: usize = 0;
    for (i < c.never.size) {
        if (class.same(c.never.data[i], k)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# add what a round decided to the plan
fun escalate(c: *Context, form: *Form, r: *scan.Result) err[Error] {
    val pieces: *vector.Vector[bool] = ?c.s.pieces;
    vector.clear[bool](pieces);
    val err_filled: err[allocator.Error] = slice.fill[bool](pieces, spill.function_of(form).virtuals.len, false);
    if (sel err_filled.err) { ret err[Error].err{Error.alloc{err_filled.err}}; }
    var i: usize = 0;
    for (i < r.spilled.len) {
        val v: u32 = r.spilled.data[i];
        if (unspilled(c, function.class_of(spill.function_of(form), v))) { ret err[Error].err{Error.unspillable{v}}; }
        if (spill.kind(form, v) == spill.ORIGINAL)                       { plan.spill(c.p, v); }
        or (spill.kind(form, v) == spill.SPLIT)                          { plan.unsplit(c.p, form.origin.data[v]); }
        or                                                               { pieces.data[v] = true; }
        i = i + 1;
    }
    i = 0;
    for (i < form.runs.len) {
        val run: spill.Run = form.runs.data[i];
        if (pieces.data[run.piece]) { plan.give(c.p, run.instruction, run.operand, false); }
        i = i + 1;
    }
    i = 0;
    for (i < r.own.len) {
        val h: scan.Half = r.own.data[i];
        plan.give(c.p, (form.sources.data[h.instruction]), h.operand, h.write);
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun by_number(a: *u32, b: *u32) i64 {
    if (@a < @b) { ret -1; }
    if (@a > @b) { ret 1; }
    ret 0;
}

# where a machine record's register of the input is once allocated: the
# location it holds over its whole life, the slot a value carried in pieces
# lives in, or nothing for a register given no location or a value in pieces
# made again, which has no slot
fun home(c: *Context, form: *Form, r: *scan.Result, given: Register) Reading {
    if (!(sel given.virtual)) { ret Reading.register{given}; }
    val v: u32 = given.virtual;
    if (v::usize >= c.f.virtuals.len) { ret Reading.unavailable{}; }
    if (plan.mode(c.p, v) == plan.PIECES) {
        if (v::usize >= form.slots.len || form.slots.data[v] == spill.NONE) { ret Reading.unavailable{}; }
        ret Reading.slot{form.slots.data[v]};
    }
    if (v::usize >= r.locations.len || r.locations.data[v] == scan.NONE) { ret Reading.unavailable{}; }
    ret Reading.register{Register.physical{location.physical(c.at, r.locations.data[v])}};
}

# the input's value binding records on the allocated function, each before
# the instruction its own now begins at, reading the home of its register
fun carry(c: *Context, form: *Form, r: *scan.Result, out: *Allocation) err[allocator.Error] {
    if (c.f.points.len == 0) { ret err[allocator.Error].ok{}; }
    var first: vector.Vector[u32] = vector.init[u32](c.a);
    fin { vector.dnit[u32](?first); }
    val err_made: err[allocator.Error] = function.firsts(c.f.instructions.len, Slice[u32]{data: out.origins.data, size: out.origins.len}, ?first);
    if (sel err_made.err) { ret err_made; }
    val err_carried: err[allocator.Error] = function.carry_points(?out.function, c.f, Slice[u32]{data: first.data, size: first.len});
    if (sel err_carried.err) { ret err_carried; }
    var i: usize = 0;
    for (i < out.function.points.len) {
        val pt:    *Point  = ?out.function.points.data[i];
        val reads: Reading = pt.reads;
        if (sel reads.register) { pt.reads = home(c, form, r, reads.register); }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the result of the round that settled, rewritten, proved when checked and
# handed back
# the copies of the form the result leaves out, none unless the compilation is optimised
fun drops(c: *Context, form: *Form, l: *Live, locations: Slice[u32]) err[Error] {
    val f:          *Function            = spill.function_of(form);
    val err_filled: err[allocator.Error] = slice.fill[bool](c.dropped, f.instructions.len, false);
    if (sel err_filled.err) { ret err[Error].err{Error.alloc{err_filled.err}}; }
    if (!c.optimized)       { ret err[Error].ok{}; }
    var none: vector.Vector[bool] = vector.init[bool](c.a);
    fin { vector.dnit[bool](?none); }
    val err_none: err[allocator.Error] = slice.fill[bool](?none, f.instructions.len, false);
    if (sel err_none.err) { ret err[Error].err{Error.alloc{err_none.err}}; }
    var g: value.Given = value.Given{
        f:         f,
        input:     c.f,
        origin:    Slice[u32]{data: form.origin.data, size: form.origin.len},
        sources:   Slice[u32]{data: form.sources.data, size: form.sources.len},
        at:        c.at,
        locations: locations,
        l:         l,
        events:    live.events(?c.s.live, ?c.s.known),
        graph:     ?c.s.known.graph,
    };
    val err_found: err[value.Error] = value.removable(c.a, ?g, Slice[bool]{data: none.data, size: none.len}, c.dropped);
    if (sel err_found.err) { ret err[Error].err{Error.value{err_found.err}}; }
    ret err[Error].ok{};
}

fun finish(c: *Context, form: *Form, l: *Live, r: *scan.Result, rounds: u32) res[Allocation, Error] {
    val locations: Slice[u32] = Slice[u32]{data: r.locations.data, size: r.locations.len};
    val err_drops: err[Error] = drops(c, form, l, locations);
    if (sel err_drops.err) { ret res[Allocation, Error].err{err_drops.err}; }
    val dropped:     Slice[bool]                  = Slice[bool]{data: c.dropped.data, size: c.dropped.len};
    val res_written: res[Function, rewrite.Error] = rewrite.rewrite(c.a, spill.function_of(form), c.at, locations, dropped);
    if (sel res_written.err) { ret res[Allocation, Error].err{Error.rewrite{res_written.err}}; }
    var out: Allocation = Allocation{function: res_written.ok, spills: vector.init[Slot](c.a), used: vector.init[u32](c.a), origins: vector.init[u32](c.a), rounds: rounds, shared: vector.init[Slot](c.a)};
    if (c.checked) {
        val of:         check.Of         = check.Of{input: c.f, origin: Slice[u32]{data: form.origin.data, size: form.origin.len}, sources: Slice[u32]{data: form.sources.data, size: form.sources.len}, dropped: dropped, unset: c.unset};
        val err_proved: err[check.Error] = check.check(c.a, spill.function_of(form), c.ctx, c.at, clobbers_of(c, form), c.x, locations, ?out.function, of);
        if (sel err_proved.err) {
            dnit(?out);
            ret res[Allocation, Error].err{Error.check{err_proved.err}};
        }
    }
    var err_failed:  err[allocator.Error]        = err[allocator.Error].ok{};
    val res_reserve: res[usize, allocator.Error] = vector.reserve[Slot](?out.spills, form.spills.len);
    if (sel res_reserve.err) { keep(?err_failed, err[allocator.Error].err{res_reserve.err}); }
    val res_orr: res[usize, allocator.Error] = vector.reserve[u32](?out.origins, form.sources.len);
    if (sel res_orr.err) { keep(?err_failed, err[allocator.Error].err{res_orr.err}); }
    val res_reserve_used: res[usize, allocator.Error] = vector.reserve[u32](?out.used, locations.size);
    if (sel res_reserve_used.err) { keep(?err_failed, err[allocator.Error].err{res_reserve_used.err}); }
    if (sel err_failed.err) {
        dnit(?out);
        ret res[Allocation, Error].err{Error.alloc{err_failed.err}};
    }
    var i: usize = 0;
    for (i < form.spills.len) {
        vector.push[Slot](?out.spills, form.spills.data[i]);
        i = i + 1;
    }
    # the rewrite numbers the form's placed instructions in placement order
    val placed: *Function = spill.function_of(form);
    var k:      usize     = 0;
    for (k < placed.blocks.len) {
        val list: Slice[Instruction] = function.instructions(placed, k::u32);
        i = 0;
        for (i < list.size) {
            if (!dropped.data[list.data[i]]) { vector.push[u32](?out.origins, form.sources.data[list.data[i]]); }
            i = i + 1;
        }
        k = k + 1;
    }
    i = 0;
    for (i < locations.size && sel err_failed.ok) {
        val at: u32 = locations.data[i];
        if (at != scan.NONE) {
            var g: u32 = 0;
            for (g < live.span(l, i::u32) && sel err_failed.ok) {
                val member: u32 = location.past(c.at, at, g);
                if (member != location.NONE) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?out.used, member);
                    if (sel res_pushed.err) { keep(?err_failed, err[allocator.Error].err{res_pushed.err}); }
                }
                g = g + 1;
            }
        }
        i = i + 1;
    }
    if (sel err_failed.err) {
        dnit(?out);
        ret res[Allocation, Error].err{Error.alloc{err_failed.err}};
    }
    sort.sort_by[u32](out.used.data, out.used.len, by_number);
    var kept: usize = 0;
    i = 0;
    for (i < out.used.len) {
        if (kept == 0 || out.used.data[kept - 1] != out.used.data[i]) {
            out.used.data[kept] = out.used.data[i];
            kept                = kept + 1;
        }
        i = i + 1;
    }
    vector.truncate[u32](?out.used, kept);
    val err_carried: err[allocator.Error] = carry(c, form, r, ?out);
    if (sel err_carried.err) {
        dnit(?out);
        ret res[Allocation, Error].err{Error.alloc{err_carried.err}};
    }
    ret res[Allocation, Error].ok{out};
}

# run rounds until one settles, adding each unsettled round's decisions to the plan, and hand back that round's result
fun rounds(c: *Context) res[Allocation, Error] {
    val form:  *Form        = ?c.s.form.form;
    val l:     *Live        = ?c.s.liveness;
    val r:     *scan.Result = ?c.s.result;
    var count: u32          = 0;
    for {
        count = count + 1;
        val err_built: err[spill.Error] = spill.build(?c.s.form, c.f, c.p, c.at, c.sizes, c.clobbers);
        if (sel err_built.err) { ret res[Allocation, Error].err{Error.form{err_built.err}}; }
        val carried:  live.Carried    = live.Carried{sources: Slice[u32]{data: form.sources.data, size: form.sources.len}, renamed: Slice[bool]{data: form.renamed.data, size: form.renamed.len}};
        val err_live: err[live.Error] = live.round(?c.s.live, l, spill.function_of(form), c.ctx, c.at, c.fx, clobbers_of(c, form), ?c.s.known, carried, c.unset);
        if (sel err_live.err) { ret res[Allocation, Error].err{Error.live{err_live.err}}; }
        val err_scanned: err[scan.Error] = scan.run(?c.s.scan, r, spill.function_of(form), c.ctx, l, c.at, c.x, Slice[u8]{data: form.kinds.data, size: form.kinds.len});
        if (sel err_scanned.err) { ret res[Allocation, Error].err{Error.scan{err_scanned.err}}; }
        if (scan.settled(r))     { ret finish(c, form, l, r, count); }
        val err_more: err[Error] = escalate(c, form, r);
        if (sel err_more.err) { ret res[Allocation, Error].err{err_more.err}; }
    }
}

# ready the scratch for a new function: forget what was known, group its clobbers and reset the plan
fun prepare(c: *Context, r: Request) err[Error] {
    val err_forgot: err[allocator.Error] = live.known_clear(?c.s.known);
    if (sel err_forgot.err) { ret err[Error].err{Error.alloc{err_forgot.err}}; }
    val err_grouped: err[Error] = group(c, r.clobbers);
    if (sel err_grouped.err) { ret err_grouped; }
    val err_planned: err[allocator.Error] = plan.reset(c.p, c.f, c.optimized);
    if (sel err_planned.err) { ret err[Error].err{Error.alloc{err_planned.err}}; }
    ret err[Error].ok{};
}

# allocate a function's virtual registers to the locations of its target
# ---
# a:   the allocator the allocation takes
# f:   the function, unchanged whatever the outcome
# r:   the locations, the allowed set and the clobbers
# ret: the allocated function, or why it was not allocated
pub fun allocate(a: *allocator.Allocator, f: *Function, r: Request) res[Allocation, Error] {
    if (r.at.file != function.file(f) || r.context.view.file != r.at.file) { ret res[Allocation, Error].err{Error.foreign{}}; }
    var dropped: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?dropped); }
    var c: Context = Context{
        a:         a,
        s:         r.scratch,
        f:         f,
        ctx:       r.context,
        at:        r.at,
        x:         r.allowed,
        fx:        r.effects,
        sizes:     r.sizes,
        sets:      live.unclobbered(),
        clobbers:  ?r.scratch.clobbers,
        p:         ?r.scratch.plan,
        never:     r.unspilled,
        checked:   r.checked,
        optimized: r.optimized,
        unset:     r.unset,
        dropped:   ?dropped,
    };
    val err_ready: err[Error] = prepare(?c, r);
    if (sel err_ready.err) { ret res[Allocation, Error].err{err_ready.err}; }
    ret rounds(?c);
}

# give back an allocation's storage
pub fun dnit(x: *Allocation) err[allocator.Error] {
    var err_failed: err[allocator.Error] = function.dnit(?x.function);
    keep(?err_failed, vector.dnit[Slot](?x.spills));
    keep(?err_failed, vector.dnit[u32](?x.used));
    keep(?err_failed, vector.dnit[u32](?x.origins));
    keep(?err_failed, vector.dnit[Slot](?x.shared));
    ret err_failed;
}
