# where each source variable is over the code of a framed machine function
#
# the value binding records of the function state where a variable's value is
# from a point on. a location holds from its record until a later record of
# the variable gives the same bits again, or an instruction writes the
# register it is in, or a call clobbers it, or its block ends. at the head of
# a block a variable is where every predecessor leaves it, and nowhere when
# two leave it in different places. a slot and a constant hold until a record
# replaces them. a piece holds its bits alone, and the pieces of a variable at
# a point are composed in bit order, a gap between two an unavailable piece
# of its own.
#
# the state is kept by variable, so a record or a write touches only the
# variables it reaches: a write finds the variables in its register through
# the register's occupants. each block is summed up once, as the entries its
# records leave standing, the bits they give and the rows it writes, and the
# heads come from those summaries by a worklist swept in reverse postorder to
# a fixed point. a sweep takes time linear in the code and the entries at
# the heads, each of which a range opens from.
#
# the walk runs on the framed function before layout, where every successor
# of a block is a block operand, and states each range within one block from
# the instruction it begins before to the one it ends before or the block's
# end, so layout's order does not change what a range covers. a slot is read
# as an offset from the canonical frame address through the frame's layout.
# a register holds a variable by masc's identity, so a register of a wider
# one's storage is its own row.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.debug.location.Piece;
use mirl.debug.location.Where;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.debug.record.Binding;
use mirl.ir.point;
use mirl.ir.point.Bits;
use mirl.ir.point.Expression;
use mirl.ir.type.table.Type;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Physical;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Layout;
use mirl.machine.frame.record.Offset;
use mirl.machine.frame.record.Place;
use mirl.machine.frame.scan;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;
use mirl.machine.point.Point;
use mirl.machine.point.Reading;

use masc.core.effect;
use masc.core.footprint;
use masc.core.query;
use rf:         masc.core.register;
use core_state: masc.core.state;

# no row, no instruction
val NONE: u32 = 0xffffffff;

# where one variable is over part of one block
# ---
# binding:    the variable
# block:      the block
# from:       the instruction it begins before
# to:         the instruction it ends before, none for the block's end
# where:      where the variable is, its pieces valid as long as the ranges
# expression: the salvage steps over what a location that is not pieces holds
# type:       the ir type of what that location holds, which the steps start from
pub rec Range {
    binding:    Binding;
    block:      Block;
    from:       Instruction;
    to:         opt[Instruction];
    where:      Where;
    expression: Expression;
    type:       Type;
}

# the ranges of one function
# ---
# list:   the ranges, those of one block in code order
# pieces: the pieces the ranges in pieces hold
pub rec Ranges {
    list:   vector.Vector[Range];
    pieces: vector.Vector[Piece];
}

# why the ranges were not read
# ---
# alloc:  the allocator refused storage
# writes: the registers an instruction writes were not read
# graph:  the function's blocks have no graph
pub tag Error: u8 {
    alloc:  allocator.Error;
    writes: scan.Error;
    graph;
}

# what the walk reads beside the function
# ---
# at:        the locations of the target's registers
# context:   the context masc's footprints are asked under
# layout:    the frame's layout, which places every slot
# clobbered: the registers a call clobbers
pub rec Request {
    at:        *Locations;
    context:   *core_state.Context;
    layout:    *Layout;
    clobbered: Slice[rf.Id];
}

# no ranges at all
pub fun none(a: *allocator.Allocator) Ranges {
    ret Ranges{list: vector.init[Range](a), pieces: vector.init[Piece](a)};
}

# give back the storage of a function's ranges
pub fun release(r: *Ranges) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[Range](?r.list);
    keep(?failed, vector.dnit[Piece](?r.pieces));
    ret failed;
}

# where one piece of a variable is
# ---
# binding:    the variable
# local:      the variable's number among the function's
# piece:      its bits
# where:      where they are, never pieces
# row:        the register row it is in, NONE for no register
# expression: the salvage steps over what is there
# type:       the ir type of what is there
rec Entry {
    binding:    Binding;
    local:      u32;
    piece:      Bits;
    where:      Where;
    row:        u32;
    expression: Expression;
    type:       Type;
}

# a state: the entries of each variable next to each other, the variables in no order
def Entries: vector.Vector[Entry];

def Rows: vector.Vector[u32];

def Covers: vector.Vector[Bits];

# the bits of a variable one record of a block gives, which an entry of it at
# the block's head that shares a bit loses
# ---
# local: the variable's number
# piece: the bits
rec Cover {
    local: u32;
    piece: Bits;
}

fun same_where(x: Where, y: Where) bool {
    if (sel x.register) { ret sel y.register && x.register == y.register; }
    if (sel x.slot) {
        if (!(sel y.slot)) { ret false; }
        ret x.slot.fixed == y.slot.fixed && x.slot.per == y.slot.per && x.slot.scale == y.slot.scale;
    }
    if (sel x.constant) { ret sel y.constant && x.constant == y.constant; }
    ret false;
}

fun same_entry(x: *Entry, y: *Entry) bool {
    if (x.binding != y.binding)                               { ret false; }
    if (x.piece.offset != y.piece.offset || x.piece.size != y.piece.size) { ret false; }
    if (x.expression != y.expression)                         { ret false; }
    if (x.type != y.type)                                     { ret false; }
    ret same_where(x.where, y.where);
}

fun lost(e: allocator.Error) Error {
    ret Error.alloc{e};
}

fun put[T](v: *vector.Vector[T], x: T) err[Error] {
    val pushed: res[usize, allocator.Error] = vector.push[T](v, x);
    if (sel pushed.err) { ret err[Error].err{lost(pushed.err)}; }
    ret err[Error].ok{};
}

# the entries of a state from `from`, `n` of them
fun group(v: *Entries, from: usize, n: usize) Slice[Entry] {
    if (n == 0) { ret Slice[Entry]{data: nil, size: 0}; }
    ret Slice[Entry]{data: ?v.data[from], size: n};
}

fun among(s: Slice[Entry], e: *Entry) bool {
    var i: usize = 0;
    for (i < s.size) {
        if (same_entry(?s.data[i], e)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether two groups of one variable place it alike, neither holding an entry twice
fun same_group(x: Slice[Entry], y: Slice[Entry]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (!among(y, ?x.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun copy_set(from: *Entries, to: *Entries) err[Error] {
    vector.truncate[Entry](to, 0);
    val room: res[usize, allocator.Error] = vector.reserve[Entry](to, from.len);
    if (sel room.err) { ret err[Error].err{lost(room.err)}; }
    var i: usize = 0;
    for (i < from.len) {
        vector.push[Entry](to, from.data[i]);
        i = i + 1;
    }
    ret err[Error].ok{};
}

# what the walk shares
# ---
# a:       the allocator
# f:       the function
# r:       what it reads beside
# fp:      masc's footprint over the register file
# rows:    the register rows of the file
# direct:  per register row, whether the instruction at hand writes it
# calls:   per register row, whether a call clobbers it
# clob:    the rows a call's clobbers reach, with the rows sharing their storage
# seen:    per register row, a scratch mark, every one clear between uses
# call:    per instruction, whether it makes a call
# dfirst:  per instruction, its first row in dead
# dcount:  per instruction, its rows in dead
# dead:    the rows each instruction's writes reach, with the rows sharing their storage
# at:      per instruction, the first of its records, NONE for none
# next:    per record, the next record before the same instruction, NONE after the last
# local:   per record, its variable's number
# made:    per record, the entry it gives
# gives:   per record, whether it gives one
# count:   the variables
# cur:     per variable, its entries in the state at hand
# on:      per variable, whether it is in active
# active:  the variables the state at hand has held since it was last cleared
# open:    per variable, its open range in the block at hand, NONE for none
# occ:     per register row, the variables that put an entry in it since it was last written
# dirty:   the rows whose occ is not empty
# touched: the variables the step at hand touched
# mark:    per variable, whether it is in touched
# snap:    the entries of each touched variable before the step
# sfirst:  per variable, its first entry in snap
# scount:  per variable, its entries in snap
# track:   whether a step keeps what it touches in snap
# summary: whether a step notes the bits its records cover in cov
# cov:     per variable, the bits the block's records give it
# gen:     per block, the entries its records leave standing at its end
# gfirst:  per block, its first entry in gen, then one past the last block's
# cover:   per block, the bits its records give, those of one variable next to each other
# cfirst:  per block, its first in cover, then one past the last block's
# bdead:   per block, every row an instruction of it writes or a call it makes clobbers
# bfirst:  per block, its first row in bdead, then one past the last block's
# epoch:   the stamp of the table at hand
# stamp:   per variable, the epoch its table entries are of
# ts:      per variable, its first entry in the indexed state
# tn:      per variable, its entries in the indexed state
# tc:      per variable, its first cover in the indexed block
# tcn:     per variable, its covers in the indexed block
# done:    per variable, whether its block entries are given
# mine:    scratch for the entries a range is composed from
# out:     the ranges made
# starts:  per range, its first piece in out's pieces, NONE for one not in pieces
rec Walk {
    a:       *allocator.Allocator;
    f:       *Function;
    r:       Request;
    fp:      *footprint.Footprint;
    rows:    usize;
    direct:  vector.Vector[bool];
    calls:   vector.Vector[bool];
    clob:    Rows;
    seen:    vector.Vector[bool];
    call:    vector.Vector[bool];
    dfirst:  Rows;
    dcount:  Rows;
    dead:    Rows;
    at:      Rows;
    next:    Rows;
    local:   Rows;
    made:    Entries;
    gives:   vector.Vector[bool];
    count:   usize;
    cur:     vector.Vector[Entries];
    on:      vector.Vector[bool];
    active:  Rows;
    open:    Rows;
    occ:     vector.Vector[Rows];
    dirty:   Rows;
    touched: Rows;
    mark:    vector.Vector[bool];
    snap:    Entries;
    sfirst:  Rows;
    scount:  Rows;
    track:   bool;
    summary: bool;
    cov:     vector.Vector[Covers];
    gen:     Entries;
    gfirst:  Rows;
    cover:   vector.Vector[Cover];
    cfirst:  Rows;
    bdead:   Rows;
    bfirst:  Rows;
    epoch:   u32;
    stamp:   Rows;
    ts:      Rows;
    tn:      Rows;
    tc:      Rows;
    tcn:     Rows;
    done:    vector.Vector[bool];
    mine:    Entries;
    out:     *Ranges;
    starts:  Rows;
}

fun walk_of(a: *allocator.Allocator, f: *Function, r: Request, fp: *footprint.Footprint, out: *Ranges) Walk {
    ret Walk{
        a:       a,
        f:       f,
        r:       r,
        fp:      fp,
        rows:    0,
        direct:  vector.init[bool](a),
        calls:   vector.init[bool](a),
        clob:    vector.init[u32](a),
        seen:    vector.init[bool](a),
        call:    vector.init[bool](a),
        dfirst:  vector.init[u32](a),
        dcount:  vector.init[u32](a),
        dead:    vector.init[u32](a),
        at:      vector.init[u32](a),
        next:    vector.init[u32](a),
        local:   vector.init[u32](a),
        made:    vector.init[Entry](a),
        gives:   vector.init[bool](a),
        count:   0,
        cur:     vector.init[Entries](a),
        on:      vector.init[bool](a),
        active:  vector.init[u32](a),
        open:    vector.init[u32](a),
        occ:     vector.init[Rows](a),
        dirty:   vector.init[u32](a),
        touched: vector.init[u32](a),
        mark:    vector.init[bool](a),
        snap:    vector.init[Entry](a),
        sfirst:  vector.init[u32](a),
        scount:  vector.init[u32](a),
        track:   false,
        summary: false,
        cov:     vector.init[Covers](a),
        gen:     vector.init[Entry](a),
        gfirst:  vector.init[u32](a),
        cover:   vector.init[Cover](a),
        cfirst:  vector.init[u32](a),
        bdead:   vector.init[u32](a),
        bfirst:  vector.init[u32](a),
        epoch:   0,
        stamp:   vector.init[u32](a),
        ts:      vector.init[u32](a),
        tn:      vector.init[u32](a),
        tc:      vector.init[u32](a),
        tcn:     vector.init[u32](a),
        done:    vector.init[bool](a),
        mine:    vector.init[Entry](a),
        out:     out,
        starts:  vector.init[u32](a),
    };
}

fun drop_walk(w: *Walk) {
    vector.dnit[bool](?w.direct);
    vector.dnit[bool](?w.calls);
    vector.dnit[u32](?w.clob);
    vector.dnit[bool](?w.seen);
    vector.dnit[bool](?w.call);
    vector.dnit[u32](?w.dfirst);
    vector.dnit[u32](?w.dcount);
    vector.dnit[u32](?w.dead);
    vector.dnit[u32](?w.at);
    vector.dnit[u32](?w.next);
    vector.dnit[u32](?w.local);
    vector.dnit[Entry](?w.made);
    vector.dnit[bool](?w.gives);
    var i: usize = 0;
    for (i < w.cur.len) {
        vector.dnit[Entry](?w.cur.data[i]);
        i = i + 1;
    }
    vector.dnit[Entries](?w.cur);
    vector.dnit[bool](?w.on);
    vector.dnit[u32](?w.active);
    vector.dnit[u32](?w.open);
    i = 0;
    for (i < w.occ.len) {
        vector.dnit[u32](?w.occ.data[i]);
        i = i + 1;
    }
    vector.dnit[Rows](?w.occ);
    vector.dnit[u32](?w.dirty);
    vector.dnit[u32](?w.touched);
    vector.dnit[bool](?w.mark);
    vector.dnit[Entry](?w.snap);
    vector.dnit[u32](?w.sfirst);
    vector.dnit[u32](?w.scount);
    i = 0;
    for (i < w.cov.len) {
        vector.dnit[Bits](?w.cov.data[i]);
        i = i + 1;
    }
    vector.dnit[Covers](?w.cov);
    vector.dnit[Entry](?w.gen);
    vector.dnit[u32](?w.gfirst);
    vector.dnit[Cover](?w.cover);
    vector.dnit[u32](?w.cfirst);
    vector.dnit[u32](?w.bdead);
    vector.dnit[u32](?w.bfirst);
    vector.dnit[u32](?w.stamp);
    vector.dnit[u32](?w.ts);
    vector.dnit[u32](?w.tn);
    vector.dnit[u32](?w.tc);
    vector.dnit[u32](?w.tcn);
    vector.dnit[bool](?w.done);
    vector.dnit[Entry](?w.mine);
    vector.dnit[u32](?w.starts);
}

# the row of a register, NONE for one the locations do not hold
fun row_of(w: *Walk, id: rf.Id) u32 {
    val got: res[u32, location.Unlocated] = location.locate(w.r.at, Physical.register{id});
    if (sel got.err) { ret NONE; }
    ret got.ok;
}

# a slot as an offset from the canonical frame address, none for a slot the
# frame dropped, below a stack pointer realigned at run time or among a
# call's outgoing arguments
fun slot_where(w: *Walk, s: Slot) opt[Offset] {
    val l: *Layout = w.r.layout;
    if (s::usize >= l.slots.len) { ret opt[Offset].none{}; }
    val place: Place = l.slots.data[s];
    if (!(sel place.at)) { ret opt[Offset].none{}; }
    if (s::usize < w.f.slots.len) {
        val area: function.Area = w.f.slots.data[s].area;
        if (sel area.outgoing) { ret opt[Offset].none{}; }
    }
    val off: Offset = place.at.offset;
    if (sel place.at.base.frame) { ret opt[Offset].some{Offset{fixed: off.fixed + l.at, per: off.per, scale: off.scale}}; }
    if (l.realign != 0)          { ret opt[Offset].none{}; }
    var scale: u8 = off.scale;
    if (off.per == 0) { scale = l.size.scale; }
    ret opt[Offset].some{Offset{fixed: off.fixed - l.size.fixed, per: off.per - l.size.per, scale: scale}};
}

# the entry a record gives, none when what it reads has no place
fun entry_of(w: *Walk, pt: *Point, local: u32) opt[Entry] {
    var e:     Entry   = Entry{binding: pt.binding, local: local, piece: pt.piece, where: Where.unavailable{}, row: NONE, expression: pt.expression, type: pt.from};
    val reads: Reading = pt.reads;
    if (sel reads.register) {
        val reg: Register = reads.register;
        if (!(sel reg.physical)) { ret opt[Entry].none{}; }
        val p: Physical = reg.physical;
        if (!(sel p.register)) { ret opt[Entry].none{}; }
        e.where = Where.register{p.register};
        e.row   = row_of(w, p.register);
        ret opt[Entry].some{e};
    }
    if (sel reads.slot) {
        val off: opt[Offset] = slot_where(w, reads.slot);
        if (sel off.none) { ret opt[Entry].none{}; }
        e.where = Where.slot{off.some};
        ret opt[Entry].some{e};
    }
    if (sel reads.constant) {
        e.where = Where.constant{reads.constant};
        ret opt[Entry].some{e};
    }
    ret opt[Entry].none{};
}

# whether a write to the rows marked reaches a register row
fun written(w: *Walk, marks: *vector.Vector[bool], row: u32) bool {
    val shared: Slice[u32] = location.shares(w.r.at, row);
    var s:      usize      = 0;
    for (s < shared.size) {
        val other: u32 = shared.data[s];
        if (other::usize < marks.len && marks.data[other]) { ret true; }
        s = s + 1;
    }
    ret row::usize < marks.len && marks.data[row];
}

# whether an entry is in a register row the marks of seen reach
fun dies(w: *Walk, e: *Entry) bool {
    ret e.row != NONE && e.row::usize < w.seen.len && w.seen.data[e.row];
}

# a fresh stamp for the per-variable table
fun stamp(w: *Walk) u32 {
    w.epoch = w.epoch + 1;
    if (w.epoch == 0) {
        var i: usize = 0;
        for (i < w.stamp.len) {
            w.stamp.data[i] = 0;
            i               = i + 1;
        }
        w.epoch = 1;
    }
    ret w.epoch;
}

# index the groups of a state in the per-variable table under a stamp
fun index_groups(w: *Walk, set: *Entries, e: u32) {
    var i: usize = 0;
    for (i < set.len) {
        val l: u32 = set.data[i].local;
        if (w.stamp.data[l] != e) {
            w.stamp.data[l] = e;
            w.ts.data[l]    = i::u32;
            w.tn.data[l]    = 0;
        }
        w.tn.data[l] = w.tn.data[l] + 1;
        i            = i + 1;
    }
}

# keep only the entries both states hold
fun meet(w: *Walk, into: *Entries, other: *Entries) {
    val e: u32 = stamp(w);
    index_groups(w, other, e);
    var kept: usize = 0;
    var i:    usize = 0;
    for (i < into.len) {
        val x: *Entry = ?into.data[i];
        val l: u32    = x.local;
        if (w.stamp.data[l] == e && among(group(other, w.ts.data[l]::usize, w.tn.data[l]::usize), x)) {
            into.data[kept] = into.data[i];
            kept            = kept + 1;
        }
        i = i + 1;
    }
    vector.truncate[Entry](into, kept);
}

# whether two states hold the same entries
fun same_set(w: *Walk, x: *Entries, y: *Entries) bool {
    if (x.len != y.len) { ret false; }
    val e: u32 = stamp(w);
    index_groups(w, y, e);
    var i: usize = 0;
    for (i < x.len) {
        val l: u32 = x.data[i].local;
        if (w.stamp.data[l] != e)                                                   { ret false; }
        if (!among(group(y, w.ts.data[l]::usize, w.tn.data[l]::usize), ?x.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether one of a block's records gives bits of a variable that a piece shares
fun covered(w: *Walk, l: u32, piece: Bits) bool {
    val from: usize = w.tc.data[l]::usize;
    var i:    usize = 0;
    for (i < w.tcn.data[l]::usize) {
        if (point.overlap(w.cover.data[from + i].piece, piece)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# push the entries a block's records leave standing for a variable
fun give(w: *Walk, l: u32, out: *Entries) err[Error] {
    val from: usize = w.ts.data[l]::usize;
    var i:    usize = 0;
    for (i < w.tn.data[l]::usize) {
        val p: err[Error] = put[Entry](out, w.gen.data[from + i]);
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    w.done.data[l] = true;
    ret err[Error].ok{};
}

# a block's state after its instructions, from the state at its head, by its
# summary: an entry at the head stands unless one of its records gives bits
# of its variable that it shares or an instruction writes or clobbers its
# register, and the entries its records leave standing join it
fun transfer(w: *Walk, b: usize, head: *Entries, out: *Entries) err[Error] {
    vector.truncate[Entry](out, 0);
    val e: u32   = stamp(w);
    var i: usize = w.cfirst.data[b]::usize;
    for (i < w.cfirst.data[b + 1]::usize) {
        val l: u32 = w.cover.data[i].local;
        if (w.stamp.data[l] != e) {
            w.stamp.data[l] = e;
            w.tc.data[l]    = i::u32;
            w.tcn.data[l]   = 0;
            w.tn.data[l]    = 0;
            w.done.data[l]  = false;
        }
        w.tcn.data[l] = w.tcn.data[l] + 1;
        i             = i + 1;
    }
    i = w.gfirst.data[b]::usize;
    for (i < w.gfirst.data[b + 1]::usize) {
        val l: u32 = w.gen.data[i].local;
        if (w.tn.data[l] == 0) { w.ts.data[l] = i::u32; }
        w.tn.data[l] = w.tn.data[l] + 1;
        i            = i + 1;
    }
    i = w.bfirst.data[b]::usize;
    for (i < w.bfirst.data[b + 1]::usize) {
        w.seen.data[w.bdead.data[i]] = true;
        i                            = i + 1;
    }
    i = 0;
    for (i < head.len) {
        val l:       u32   = head.data[i].local;
        val touched: bool  = w.stamp.data[l] == e;
        var j:       usize = i;
        for (j < head.len && head.data[j].local == l) {
            val x: *Entry = ?head.data[j];
            if (!dies(w, x) && !(touched && covered(w, l, x.piece))) {
                val p: err[Error] = put[Entry](out, @x);
                if (sel p.err) { ret p; }
            }
            j = j + 1;
        }
        if (touched) {
            val given: err[Error] = give(w, l, out);
            if (sel given.err) { ret given; }
        }
        i = j;
    }
    i = w.gfirst.data[b]::usize;
    for (i < w.gfirst.data[b + 1]::usize) {
        val l: u32 = w.gen.data[i].local;
        if (!w.done.data[l]) {
            val given: err[Error] = give(w, l, out);
            if (sel given.err) { ret given; }
        }
        i = i + 1;
    }
    i = w.bfirst.data[b]::usize;
    for (i < w.bfirst.data[b + 1]::usize) {
        w.seen.data[w.bdead.data[i]] = false;
        i                            = i + 1;
    }
    ret err[Error].ok{};
}

# note a variable the step at hand touches, keeping its entries before the
# step when the walk tracks them
fun note(w: *Walk, l: u32) err[Error] {
    if (w.mark.data[l]) { ret err[Error].ok{}; }
    w.mark.data[l] = true;
    val p: err[Error] = put[u32](?w.touched, l);
    if (sel p.err) { ret p; }
    if (!w.track)  { ret err[Error].ok{}; }
    val held: *Entries = ?w.cur.data[l];
    w.sfirst.data[l] = w.snap.len::u32;
    w.scount.data[l] = held.len::u32;
    var i: usize = 0;
    for (i < held.len) {
        val q: err[Error] = put[Entry](?w.snap, held.data[i]);
        if (sel q.err) { ret q; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# put an entry in the state at hand
fun hold(w: *Walk, e: Entry) err[Error] {
    val l: u32        = e.local;
    val p: err[Error] = put[Entry](?w.cur.data[l], e);
    if (sel p.err) { ret p; }
    if (!w.on.data[l]) {
        w.on.data[l] = true;
        val q: err[Error] = put[u32](?w.active, l);
        if (sel q.err) { ret q; }
    }
    if (e.row != NONE && e.row::usize < w.occ.len) {
        val o: *Rows = ?w.occ.data[e.row];
        if (o.len == 0) {
            val d: err[Error] = put[u32](?w.dirty, e.row);
            if (sel d.err) { ret d; }
        }
        ret put[u32](o, l);
    }
    ret err[Error].ok{};
}

# the records before an instruction applied to the state at hand, in their
# order: each drops the entries of its variable that share a bit with it and
# puts the one it gives
fun apply(w: *Walk, i: Instruction) err[Error] {
    var r: u32 = w.at.data[i];
    for (r != NONE) {
        val l:     u32        = w.local.data[r];
        val piece: Bits       = w.f.points.data[r].piece;
        val noted: err[Error] = note(w, l);
        if (sel noted.err) { ret noted; }
        if (w.summary) {
            val c: err[Error] = put[Bits](?w.cov.data[l], piece);
            if (sel c.err) { ret c; }
        }
        val held: *Entries = ?w.cur.data[l];
        var kept: usize    = 0;
        var k:    usize    = 0;
        for (k < held.len) {
            if (!point.overlap(held.data[k].piece, piece)) {
                held.data[kept] = held.data[k];
                kept            = kept + 1;
            }
            k = k + 1;
        }
        vector.truncate[Entry](held, kept);
        if (w.gives.data[r]) {
            val h: err[Error] = hold(w, w.made.data[r]);
            if (sel h.err) { ret h; }
        }
        r = w.next.data[r];
    }
    ret err[Error].ok{};
}

# drop the entries in a register row a write reaches
fun kill_row(w: *Walk, row: u32) err[Error] {
    if (row::usize >= w.occ.len) { ret err[Error].ok{}; }
    val o: *Rows = ?w.occ.data[row];
    var s: usize = 0;
    for (s < o.len) {
        val l: u32 = o.data[s];
        if (w.track) {
            val noted: err[Error] = note(w, l);
            if (sel noted.err) { ret noted; }
        }
        val held: *Entries = ?w.cur.data[l];
        var kept: usize    = 0;
        var k:    usize    = 0;
        for (k < held.len) {
            if (held.data[k].row != row) {
                held.data[kept] = held.data[k];
                kept            = kept + 1;
            }
            k = k + 1;
        }
        vector.truncate[Entry](held, kept);
        s = s + 1;
    }
    vector.truncate[u32](o, 0);
    ret err[Error].ok{};
}

# the entries an instruction leaves standing: those in a register it writes,
# or a call it makes clobbers, go
fun kill(w: *Walk, i: Instruction) err[Error] {
    val from: usize = w.dfirst.data[i]::usize;
    var k:    usize = 0;
    for (k < w.dcount.data[i]::usize) {
        val killed: err[Error] = kill_row(w, w.dead.data[from + k]);
        if (sel killed.err) { ret killed; }
        k = k + 1;
    }
    if (!w.call.data[i]) { ret err[Error].ok{}; }
    k = 0;
    for (k < w.clob.len) {
        val killed: err[Error] = kill_row(w, w.clob.data[k]);
        if (sel killed.err) { ret killed; }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# clear the state at hand
fun clear(w: *Walk) {
    var i: usize = 0;
    for (i < w.active.len) {
        val l: u32 = w.active.data[i];
        vector.truncate[Entry](?w.cur.data[l], 0);
        w.on.data[l]   = false;
        w.open.data[l] = NONE;
        i              = i + 1;
    }
    vector.truncate[u32](?w.active, 0);
    i = 0;
    for (i < w.dirty.len) {
        vector.truncate[u32](?w.occ.data[w.dirty.data[i]], 0);
        i = i + 1;
    }
    vector.truncate[u32](?w.dirty, 0);
}

# a block's summary: the entries its records leave standing from a head that
# holds nothing, the bits each of its records gives, and every row it writes
# or clobbers
fun summarize(w: *Walk, b: Block) err[Error] {
    val list: Slice[Instruction] = function.instructions(w.f, b);
    w.summary = true;
    var call: bool  = false;
    var i:    usize = 0;
    for (i < list.size) {
        val at:      Instruction = list.data[i];
        val applied: err[Error]  = apply(w, at);
        if (sel applied.err) { ret applied; }
        val killed: err[Error] = kill(w, at);
        if (sel killed.err) { ret killed; }
        val from: usize = w.dfirst.data[at]::usize;
        var k:    usize = 0;
        for (k < w.dcount.data[at]::usize) {
            val row: u32 = w.dead.data[from + k];
            if (!w.seen.data[row]) {
                w.seen.data[row] = true;
                val p: err[Error] = put[u32](?w.bdead, row);
                if (sel p.err) { ret p; }
            }
            k = k + 1;
        }
        if (w.call.data[at]) { call = true; }
        i = i + 1;
    }
    w.summary = false;
    if (call) {
        i = 0;
        for (i < w.clob.len) {
            val row: u32 = w.clob.data[i];
            if (!w.seen.data[row]) {
                w.seen.data[row] = true;
                val p: err[Error] = put[u32](?w.bdead, row);
                if (sel p.err) { ret p; }
            }
            i = i + 1;
        }
    }
    i = w.bfirst.data[w.bfirst.len - 1]::usize;
    for (i < w.bdead.len) {
        w.seen.data[w.bdead.data[i]] = false;
        i                            = i + 1;
    }
    i = 0;
    for (i < w.touched.len) {
        val l:      u32      = w.touched.data[i];
        val pieces: *Covers  = ?w.cov.data[l];
        val held:   *Entries = ?w.cur.data[l];
        w.mark.data[l] = false;
        var k: usize = 0;
        for (k < pieces.len) {
            val p: err[Error] = put[Cover](?w.cover, Cover{local: l, piece: pieces.data[k]});
            if (sel p.err) { ret p; }
            k = k + 1;
        }
        vector.truncate[Bits](pieces, 0);
        k = 0;
        for (k < held.len) {
            val p: err[Error] = put[Entry](?w.gen, held.data[k]);
            if (sel p.err) { ret p; }
            k = k + 1;
        }
        i = i + 1;
    }
    vector.truncate[u32](?w.touched, 0);
    clear(w);
    var failed: err[allocator.Error] = slice.fill[u32](?w.gfirst, 1, w.gen.len::u32);
    keep(?failed, slice.fill[u32](?w.cfirst, 1, w.cover.len::u32));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    ret put[u32](?w.bfirst, w.bdead.len::u32);
}

# the blocks the entry reaches in reverse postorder, the entry first, then
# the rest in their order
fun order_of(w: *Walk, g: *Graph, order: *Rows) err[Error] {
    val n: usize = w.f.blocks.len;
    if (n == 0) { ret err[Error].ok{}; }
    var seen:  vector.Vector[bool] = vector.init[bool](w.a);
    var next:  Rows                = vector.init[u32](w.a);
    var stack: Rows                = vector.init[u32](w.a);
    var post:  Rows                = vector.init[u32](w.a);
    fin {
        vector.dnit[bool](?seen);
        vector.dnit[u32](?next);
        vector.dnit[u32](?stack);
        vector.dnit[u32](?post);
    }
    var failed: err[allocator.Error] = slice.fill[bool](?seen, n, false);
    keep(?failed, slice.fill[u32](?next, n, 0));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    val entry: u32 = graph.entry(g);
    seen.data[entry] = true;
    val pushed: err[Error] = put[u32](?stack, entry);
    if (sel pushed.err) { ret pushed; }
    for (stack.len > 0) {
        val top:  u32        = stack.data[stack.len - 1];
        val succ: Slice[u32] = graph.successors(g, top);
        if (next.data[top]::usize < succ.size) {
            val s: u32 = succ.data[next.data[top]];
            next.data[top] = next.data[top] + 1;
            if (!seen.data[s]) {
                seen.data[s] = true;
                val p: err[Error] = put[u32](?stack, s);
                if (sel p.err) { ret p; }
            }
        }
        or {
            vector.truncate[u32](?stack, stack.len - 1);
            val p: err[Error] = put[u32](?post, top);
            if (sel p.err) { ret p; }
        }
    }
    var i: usize = post.len;
    for (i > 0) {
        i = i - 1;
        val p: err[Error] = put[u32](order, post.data[i]);
        if (sel p.err) { ret p; }
    }
    i = 0;
    for (i < n) {
        if (!seen.data[i]) {
            val p: err[Error] = put[u32](order, i::u32);
            if (sel p.err) { ret p; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the state at each block's head, every predecessor's leaving met, to a fixed
# point: a block is visited again when a predecessor's leaving changes, the
# blocks swept in reverse postorder, and each visit applies its summary
fun heads(w: *Walk, g: *Graph, ins: *vector.Vector[Entries]) err[Error] {
    val n:      usize                  = w.f.blocks.len;
    var outs:   vector.Vector[Entries] = vector.init[Entries](w.a);
    var known:  vector.Vector[bool]    = vector.init[bool](w.a);
    var queued: vector.Vector[bool]    = vector.init[bool](w.a);
    var order:  Rows                   = vector.init[u32](w.a);
    var work:   Entries                = vector.init[Entry](w.a);
    var left:   Entries                = vector.init[Entry](w.a);
    fin {
        var j: usize = 0;
        for (j < outs.len) {
            vector.dnit[Entry](?outs.data[j]);
            j = j + 1;
        }
        vector.dnit[Entries](?outs);
        vector.dnit[bool](?known);
        vector.dnit[bool](?queued);
        vector.dnit[u32](?order);
        vector.dnit[Entry](?work);
        vector.dnit[Entry](?left);
    }
    val room: res[usize, allocator.Error] = vector.reserve[Entries](?outs, n);
    if (sel room.err) { ret err[Error].err{lost(room.err)}; }
    val inroom: res[usize, allocator.Error] = vector.reserve[Entries](ins, n);
    if (sel inroom.err) { ret err[Error].err{lost(inroom.err)}; }
    var k: usize = 0;
    for (k < n) {
        vector.push[Entries](?outs, vector.init[Entry](w.a));
        vector.push[Entries](ins, vector.init[Entry](w.a));
        k = k + 1;
    }
    var failed: err[allocator.Error] = slice.fill[bool](?known, n, false);
    keep(?failed, slice.fill[bool](?queued, n, true));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    val ordered: err[Error] = order_of(w, g, ?order);
    if (sel ordered.err) { ret ordered; }
    var pending: usize = n;
    for (pending > 0) {
        var o: usize = 0;
        for (o < order.len) {
            val b: u32 = order.data[o];
            o = o + 1;
            if (!queued.data[b]) { cnt; }
            queued.data[b] = false;
            pending        = pending - 1;
            vector.truncate[Entry](?work, 0);
            if (b != graph.entry(g)) {
                val preds: Slice[u32] = graph.predecessors(g, b);
                var first: bool       = true;
                var p:     usize      = 0;
                for (p < preds.size) {
                    val from: usize = preds.data[p]::usize;
                    if (known.data[from]) {
                        if (first) {
                            val c: err[Error] = copy_set(?outs.data[from], ?work);
                            if (sel c.err) { ret c; }
                            first = false;
                        }
                        or { meet(w, ?work, ?outs.data[from]); }
                    }
                    p = p + 1;
                }
            }
            val headed: err[Error] = copy_set(?work, ?ins.data[b]);
            if (sel headed.err) { ret headed; }
            val walked: err[Error] = transfer(w, b::usize, ?work, ?left);
            if (sel walked.err) { ret walked; }
            if (!known.data[b] || !same_set(w, ?left, ?outs.data[b])) {
                val c: err[Error] = copy_set(?left, ?outs.data[b]);
                if (sel c.err) { ret c; }
                known.data[b] = true;
                val succ: Slice[u32] = graph.successors(g, b);
                var s:    usize      = 0;
                for (s < succ.size) {
                    if (!queued.data[succ.data[s]]) {
                        queued.data[succ.data[s]] = true;
                        pending                   = pending + 1;
                    }
                    s = s + 1;
                }
            }
        }
    }
    ret err[Error].ok{};
}

fun before(x: *Entry, y: *Entry) bool {
    ret x.piece.offset < y.piece.offset;
}

# the range of a variable from one instruction of a block, composed from its
# entries in the state at hand: one location when the whole of it is in one
# place, its pieces in bit order otherwise, and nothing when no entry places
# any of it
fun open_range(w: *Walk, l: u32, block: Block, from: Instruction) err[Error] {
    val c: err[Error] = copy_set(?w.cur.data[l], ?w.mine);
    if (sel c.err) { ret c; }
    val mine: *Entries = ?w.mine;
    if (mine.len == 0) { ret err[Error].ok{}; }
    var r:     Range = Range{binding: mine.data[0].binding, block: block, from: from, to: opt[Instruction].none{}, where: Where.unavailable{}, expression: point.PLAIN, type: 0};
    var start: u32   = NONE;
    if (mine.len == 1 && point.whole(mine.data[0].piece)) {
        r.where      = mine.data[0].where;
        r.expression = mine.data[0].expression;
        r.type       = mine.data[0].type;
    }
    or {
        # insertion order by first bit, the pieces never sharing one
        var j: usize = 1;
        for (j < mine.len) {
            var q: usize = j;
            for (q > 0 && before(?mine.data[q], ?mine.data[q - 1])) {
                val t: Entry = mine.data[q];
                mine.data[q]     = mine.data[q - 1];
                mine.data[q - 1] = t;
                q                = q - 1;
            }
            j = j + 1;
        }
        start = w.out.pieces.len::u32;
        var bit: u32 = 0;
        j = 0;
        for (j < mine.len) {
            val e: *Entry = ?mine.data[j];
            if (point.whole(e.piece)) { brk; }
            if (e.piece.offset > bit) {
                val gap: res[usize, allocator.Error] = vector.push[Piece](?w.out.pieces, Piece{location: Where.unavailable{}, bits: (e.piece.offset - bit)::u64, expression: point.PLAIN, from: 0});
                if (sel gap.err) { ret err[Error].err{lost(gap.err)}; }
            }
            val held: res[usize, allocator.Error] = vector.push[Piece](?w.out.pieces, Piece{location: e.where, bits: e.piece.size::u64, expression: e.expression, from: e.type});
            if (sel held.err) { ret err[Error].err{lost(held.err)}; }
            bit = e.piece.offset + e.piece.size;
            j   = j + 1;
        }
        r.where = Where.pieces{Slice[Piece]{data: nil, size: w.out.pieces.len - start::usize}};
    }
    w.open.data[l] = w.out.list.len::u32;
    val pushed: res[usize, allocator.Error] = vector.push[Range](?w.out.list, r);
    if (sel pushed.err) { ret err[Error].err{lost(pushed.err)}; }
    val noted: res[usize, allocator.Error] = vector.push[u32](?w.starts, start);
    if (sel noted.err) { ret err[Error].err{lost(noted.err)}; }
    ret err[Error].ok{};
}

# every variable the step at hand moved: its open range ended before `at`
# and the one it has from there opened
fun settle(w: *Walk, block: Block, at: Instruction) err[Error] {
    var i: usize = 0;
    for (i < w.touched.len) {
        val l: u32 = w.touched.data[i];
        w.mark.data[l] = false;
        val was: Slice[Entry] = group(?w.snap, w.sfirst.data[l]::usize, w.scount.data[l]::usize);
        val now: Slice[Entry] = group(?w.cur.data[l], 0, w.cur.data[l].len);
        if (!same_group(was, now)) {
            val open: u32 = w.open.data[l];
            if (open != NONE) {
                w.out.list.data[open].to = opt[Instruction].some{at};
                w.open.data[l]           = NONE;
            }
            val opened: err[Error] = open_range(w, l, block, at);
            if (sel opened.err) { ret opened; }
        }
        i = i + 1;
    }
    vector.truncate[u32](?w.touched, 0);
    vector.truncate[Entry](?w.snap, 0);
    ret err[Error].ok{};
}

# the ranges of one block, from the state at its head
fun ranges_of(w: *Walk, b: Block, head: *Entries) err[Error] {
    val list: Slice[Instruction] = function.instructions(w.f, b);
    if (list.size == 0) { ret err[Error].ok{}; }
    var i: usize = 0;
    for (i < head.len) {
        val h: err[Error] = hold(w, head.data[i]);
        if (sel h.err) { ret h; }
        i = i + 1;
    }
    i = 0;
    for (i < head.len) {
        if (i == 0 || head.data[i].local != head.data[i - 1].local) {
            val opened: err[Error] = open_range(w, head.data[i].local, b, list.data[0]);
            if (sel opened.err) { ret opened; }
        }
        i = i + 1;
    }
    w.track = true;
    i       = 0;
    for (i < list.size) {
        val at:      Instruction = list.data[i];
        val applied: err[Error]  = apply(w, at);
        if (sel applied.err) { ret applied; }
        val before_it: err[Error] = settle(w, b, at);
        if (sel before_it.err) { ret before_it; }
        if (i + 1 < list.size) {
            val killed: err[Error] = kill(w, at);
            if (sel killed.err) { ret killed; }
            val after_it: err[Error] = settle(w, b, list.data[i + 1]);
            if (sel after_it.err) { ret after_it; }
        }
        i = i + 1;
    }
    w.track = false;
    clear(w);
    ret err[Error].ok{};
}

# index each instruction's records, in their order, and number the variables
# they bind
fun index(w: *Walk) err[Error] {
    var failed: err[allocator.Error] = slice.fill[u32](?w.at, w.f.instructions.len, NONE);
    keep(?failed, slice.fill[u32](?w.next, w.f.points.len, NONE));
    keep(?failed, slice.fill[u32](?w.local, w.f.points.len, NONE));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    var i: usize = w.f.points.len;
    for (i > 0) {
        i = i - 1;
        val at: u32 = w.f.points.data[i].at;
        if (at::usize < w.at.len) {
            w.next.data[i] = w.at.data[at];
            w.at.data[at]  = i::u32;
        }
    }
    var numbers: map.Map[u32, u32] = map.init[u32, u32](w.a);
    fin { map.dnit[u32, u32](?numbers); }
    i = 0;
    for (i < w.f.points.len) {
        val b:     u32       = w.f.points.data[i].binding;
        val known: opt[*u32] = map.get[u32, u32](?numbers, ?b);
        if (sel known.some) { w.local.data[i] = @known.some; }
        or {
            val stored: res[bool, allocator.Error] = map.insert[u32, u32](?numbers, b, w.count::u32);
            if (sel stored.err) { ret err[Error].err{lost(stored.err)}; }
            w.local.data[i] = w.count::u32;
            w.count         = w.count + 1;
        }
        i = i + 1;
    }
    val nothing: Entry = Entry{binding: 0, local: 0, piece: Bits{offset: 0, size: 0}, where: Where.unavailable{}, row: NONE, expression: point.PLAIN, type: 0};
    i = 0;
    for (i < w.f.points.len) {
        val made: opt[Entry] = entry_of(w, ?w.f.points.data[i], w.local.data[i]);
        var p:    err[Error] = err[Error].ok{};
        if (sel made.some) {
            p = put[Entry](?w.made, made.some);
            if (!(sel p.err)) { p = put[bool](?w.gives, true); }
        }
        or {
            p = put[Entry](?w.made, nothing);
            if (!(sel p.err)) { p = put[bool](?w.gives, false); }
        }
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    val n:     usize                = w.count;
    var sized: err[allocator.Error] = slice.fill[bool](?w.on, n, false);
    keep(?sized, slice.fill[u32](?w.open, n, NONE));
    keep(?sized, slice.fill[bool](?w.mark, n, false));
    keep(?sized, slice.fill[u32](?w.sfirst, n, 0));
    keep(?sized, slice.fill[u32](?w.scount, n, 0));
    keep(?sized, slice.fill[u32](?w.stamp, n, 0));
    keep(?sized, slice.fill[u32](?w.ts, n, 0));
    keep(?sized, slice.fill[u32](?w.tn, n, 0));
    keep(?sized, slice.fill[u32](?w.tc, n, 0));
    keep(?sized, slice.fill[u32](?w.tcn, n, 0));
    keep(?sized, slice.fill[bool](?w.done, n, false));
    if (sel sized.err) { ret err[Error].err{lost(sized.err)}; }
    val room: res[usize, allocator.Error] = vector.reserve[Entries](?w.cur, n);
    if (sel room.err) { ret err[Error].err{lost(room.err)}; }
    val covroom: res[usize, allocator.Error] = vector.reserve[Covers](?w.cov, n);
    if (sel covroom.err) { ret err[Error].err{lost(covroom.err)}; }
    i = 0;
    for (i < n) {
        vector.push[Entries](?w.cur, vector.init[Entry](w.a));
        vector.push[Covers](?w.cov, vector.init[Bits](w.a));
        i = i + 1;
    }
    ret err[Error].ok{};
}

# mark the rows a call clobbers, and list every row such a write reaches
fun clobbers(w: *Walk) err[Error] {
    val file: *rf.File = function.file(w.f);
    var rows: usize    = 0;
    if (file != nil) { rows = file.register_count::usize; }
    w.rows = rows;
    var failed: err[allocator.Error] = slice.fill[bool](?w.direct, rows, false);
    keep(?failed, slice.fill[bool](?w.calls, rows, false));
    keep(?failed, slice.fill[bool](?w.seen, rows, false));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    val room: res[usize, allocator.Error] = vector.reserve[Rows](?w.occ, rows);
    if (sel room.err) { ret err[Error].err{lost(room.err)}; }
    var i: usize = 0;
    for (i < rows) {
        vector.push[Rows](?w.occ, vector.init[u32](w.a));
        i = i + 1;
    }
    i = 0;
    for (i < w.r.clobbered.size) {
        val row: u32 = row_of(w, w.r.clobbered.data[i]);
        if (row != NONE && row::usize < rows) { w.calls.data[row] = true; }
        i = i + 1;
    }
    i = 0;
    for (i < rows) {
        if (written(w, ?w.calls, i::u32)) {
            val p: err[Error] = put[u32](?w.clob, i::u32);
            if (sel p.err) { ret p; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# read once what each instruction writes and whether it calls. a write to a
# row reaches every row sharing its storage, a relation masc's overlap makes
# symmetric, so the rows the write reaches are those its rows share with
fun writes(w: *Walk) err[Error] {
    val n:      usize                = w.f.instructions.len;
    var failed: err[allocator.Error] = slice.fill[u32](?w.dfirst, n, 0);
    keep(?failed, slice.fill[u32](?w.dcount, n, 0));
    keep(?failed, slice.fill[bool](?w.call, n, false));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    var b: usize = 0;
    for (b < w.f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(w.f, (b::u32));
        var i:    usize              = 0;
        for (i < list.size) {
            val at:   Instruction     = list.data[i];
            val read: err[scan.Error] = scan.writes(w.f, w.r.context, w.r.at, w.fp, at, ?w.direct);
            if (sel read.err) { ret err[Error].err{Error.writes{read.err}}; }
            val first: usize = w.dead.len;
            var k:     usize = 0;
            for (k < w.rows) {
                if (w.direct.data[k]) {
                    w.direct.data[k] = false;
                    if (!w.seen.data[k]) {
                        w.seen.data[k] = true;
                        val p: err[Error] = put[u32](?w.dead, k::u32);
                        if (sel p.err) { ret p; }
                    }
                    val shared: Slice[u32] = location.shares(w.r.at, k::u32);
                    var s:      usize      = 0;
                    for (s < shared.size) {
                        val other: u32 = shared.data[s];
                        if (other::usize < w.rows && !w.seen.data[other]) {
                            w.seen.data[other] = true;
                            val p: err[Error] = put[u32](?w.dead, other);
                            if (sel p.err) { ret p; }
                        }
                        s = s + 1;
                    }
                }
                k = k + 1;
            }
            k = first;
            for (k < w.dead.len) {
                w.seen.data[w.dead.data[k]] = false;
                k                           = k + 1;
            }
            w.dfirst.data[at] = first::u32;
            w.dcount.data[at] = (w.dead.len - first)::u32;
            val c: query.Answer[effect.Control] = instruction.transfer(function.file(w.f), function.data(w.f, at));
            if (sel c.decided) { w.call.data[at] = c.decided.transfer == effect.CALL; }
            i = i + 1;
        }
        b = b + 1;
    }
    ret err[Error].ok{};
}

# the ranges of every variable of a framed function, before layout
# ---
# a:   the allocator the ranges take
# f:   the function, framed, every operand a location
# r:   the locations, the context, the frame and the clobbers
# ret: the ranges, the caller's to release, or why they were not read
pub fun ranges(a: *allocator.Allocator, f: *Function, r: Request) res[Ranges, Error] {
    var out: Ranges = none(a);
    if (f.points.len == 0) { ret res[Ranges, Error].ok{out}; }
    val file: *rf.File = function.file(f);
    if (file == nil) { ret res[Ranges, Error].ok{out}; }
    val printed: res[footprint.Footprint, allocator.Error] = footprint.make(a, file);
    if (sel printed.err) { ret res[Ranges, Error].err{lost(printed.err)}; }
    var fp: footprint.Footprint = printed.ok;
    var w:  Walk                = walk_of(a, f, r, ?fp, ?out);
    fin {
        footprint.release(?fp);
        drop_walk(?w);
    }
    val done: err[Error] = walk(?w);
    if (sel done.err) {
        release(?out);
        ret res[Ranges, Error].err{done.err};
    }
    # the pieces no longer move, so each range in pieces names its own
    var i: usize = 0;
    for (i < out.list.len) {
        val start: u32 = w.starts.data[i];
        if (start != NONE) {
            val held: Where = out.list.data[i].where;
            if (sel held.pieces) { out.list.data[i].where = Where.pieces{Slice[Piece]{data: ?out.pieces.data[start], size: held.pieces.size}}; }
        }
        i = i + 1;
    }
    ret res[Ranges, Error].ok{out};
}

fun walk(w: *Walk) err[Error] {
    val marked: err[Error] = clobbers(w);
    if (sel marked.err) { ret marked; }
    val indexed: err[Error] = index(w);
    if (sel indexed.err) { ret indexed; }
    val read: err[Error] = writes(w);
    if (sel read.err) { ret read; }
    val g: res[Graph, allocator.Error] = function.graph_of(w.f);
    if (sel g.err) { ret err[Error].err{lost(g.err)}; }
    var shape: Graph = g.ok;
    fin { graph.dnit(?shape); }
    var failed: err[allocator.Error] = slice.fill[u32](?w.gfirst, 1, 0);
    keep(?failed, slice.fill[u32](?w.cfirst, 1, 0));
    keep(?failed, slice.fill[u32](?w.bfirst, 1, 0));
    if (sel failed.err) { ret err[Error].err{lost(failed.err)}; }
    var k: usize = 0;
    for (k < w.f.blocks.len) {
        val summed: err[Error] = summarize(w, (k::u32));
        if (sel summed.err) { ret summed; }
        k = k + 1;
    }
    var ins: vector.Vector[Entries] = vector.init[Entries](w.a);
    fin {
        var j: usize = 0;
        for (j < ins.len) {
            vector.dnit[Entry](?ins.data[j]);
            j = j + 1;
        }
        vector.dnit[Entries](?ins);
    }
    val headed: err[Error] = heads(w, ?shape, ?ins);
    if (sel headed.err) { ret headed; }
    k = 0;
    for (k < w.f.blocks.len) {
        val made: err[Error] = ranges_of(w, (k::u32), ?ins.data[k]);
        if (sel made.err) { ret made; }
        k = k + 1;
    }
    ret err[Error].ok{};
}
