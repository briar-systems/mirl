# the vector row check: every operation a unit packs is served by a rule
#
# a unit's row states an operation packed for every value of its operands
# (`mirl.target.capability.Operation`), so selection must cover it whatever
# the values are. the check runs once per build, when the back end indexes
# its table, over every row of every unit the build meets whose condition it
# meets and whose lane types the unit packs, the rows `mirl.target.vector`
# answers packed. a row is served when one rule of the table is both:
#
# total: its root is the row's opcode, or under widened masks a comparison's
# sign extension over the comparison, no node needs a constant operand, its
# hook is none or one the table states reads only types and the root's
# immediates (`rule.Table.shapes`), so its guard reads no value fact, and
# shape hooks of one row together serve every count the unit holds, as the
# table states and this check does not prove. its type tests admit the
# row's lane types, its operands' lane type for an operand and the lane type
# it gives for a result, and the build admits every row it emits. a computed
# source reads the root's immediates and types alone, never a value.
#
# relatively timed, for integer lanes: under each set of timing modes a
# constant-time function may be read under (the modes the system states,
# those the build guarantees, and those its set can lift, as `mirl.ct` makes
# them), every row the rule emits depends on no value of the match wherever
# every rule of the lane-by-lane form does. that form is made of scalar
# operations on one lane of the row's width, or of the narrowest width the
# target computes above it: the same operation for a lanewise one, from the
# lane's type to the type a conversion gives, a reduction's operation, a
# comparison and a select for an integer minimum or maximum, and a load and
# a store for an operation that moves lanes, which goes through a slot. every
# rule of those operations whose type tests admit those types counts,
# whatever its hook, as the lane's values choose among them. a test of one
# bit admits only a comparison's result or an operand the operation reads as
# a condition, as a select's first. a copy a rule emits is timed as the set's
# moves within its class, the scalar's for the lane-by-lane form and each
# vector class's for a vector rule, as the lowering of copies emits one. a
# row's input holds a value
# when an operand position its timing depends on reads one, directly or
# through a temporary an instruction reading one wrote, or when a flag or a
# register an operand names that it reads was written by such an
# instruction before it. any other implicit write, as vstart's reset or the
# vl a vset sets from immediates, is taken to carry no operand's value, so a
# gate that leaves rvv's vl, vtype, vstart and the mask v0, which no rule
# writes, leaves no input of the rule. where no rule serves the lane-by-lane
# form, the vector rule must depend on no value on its own. float lanes are
# exempt, since sema refuses a secret operand to every float operation.
#
# the check reads static rows and the build's context alone, in the order the
# rows and rules are stated, so it is deterministic, and it costs the units'
# rows times the table's rules times the rows each rule emits.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.core.ct;
use me:         masc.core.effect;
use mo:         masc.core.operand;
use rf:         masc.core.register;
use rows:       masc.core.row;
use mset:       masc.core.set;
use core_state: masc.core.state;

use mct:        mirl.ct;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.rule.Class;
use opcode_table: mirl.ir.opcode.table;
use mirl.machine.copy.move;
use mi: mirl.machine.instruction;
use mirl.machine.pseudo;
use mirl.machine.select.rule;
use mirl.machine.select.rule.Emit;
use mirl.machine.select.rule.Holder;
use mirl.machine.select.rule.Rule;
use mirl.machine.select.rule.Source;
use mirl.machine.select.rule.Table;
use mirl.target.basis;
use mirl.target.capability;
use mirl.target.capability.Bits;
use mirl.target.capability.LaneType;
use mirl.target.capability.Operation;
use mirl.target.capability.Unit;
use mirl.target.capability.Vectors;
use mirl.target.record.Target;
use units: mirl.target.vector;

# which half of the check a row fails
# ---
# total: no rule serves it for every value of its operands
# timed: its total rules each emit a row whose timing depends on an input
#        where the lane-by-lane form's rows depend on none, under the timing
#        modes named
pub tag Half: u8 {
    total;
    timed: mct.Needs;
}

# a row of a unit no rule serves
# ---
# unit:      the unit's place among the target's units
# row:       the row's place among the unit's operations
# operation: the row
# half:      what it fails
pub rec Unserved {
    unit:      u32;
    row:       u32;
    operation: Operation;
    half:      Half;
}

# why the check refused
# ---
# alloc:    the allocator refused storage
# unit:     a unit's condition or rows could not be read
# hold:     the condition of a row of the table's holds could not be read
# unserved: a row no rule serves
pub tag Error: u8 {
    alloc:    allocator.Error;
    unit:     units.Error;
    hold:     basis.Error;
    unserved: Unserved;
}

# the allocator's refusal `e` stands for, its own or one a unit's refusal holds
# ---
# e:   the refusal
# ret: the allocator's refusal, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.unit)  { ret units.starved(e.unit); }
    if (sel e.hold)  { ret basis.starved(e.hold); }
    ret opt[allocator.Error].none{};
}

# a context a constant-time function's rows are read under, and the modes it holds
rec Moded {
    timed: mct.Timed;
    needs: mct.Needs;
}

# what one check reads
# ---
# table:  the selection table
# target: the target
# ctx:    the build's context
# moves:  the set's moves, which a copy lowers to
# met:    per row of the table's holds, whether the build meets its condition
rec Check {
    table:  *Table;
    target: *Target;
    ctx:    *core_state.Context;
    moves:  *move.Table;
    met:    vector.Vector[bool];
}

# the classes a copy a rule emits moves within: a scalar of lane type
# `lane`'s, or with `vector` each vector class the build holds
rec Within {
    vector: bool;
    lane:   LaneType;
}

# whether the lane type `l` is in the class `c`, as a type test reads a lane
fun admits_lane(c: Class, l: LaneType) bool {
    if (sel c.any)    { ret true; }
    if (sel c.scalar) { ret sel l.integer || sel l.float; }
    if (sel l.integer) {
        if (sel c.integer) { ret true; }
        if (sel c.width)   { ret c.width == l.integer; }
        if (sel c.bytes)   { ret l.integer % 8 == 0; }
        ret false;
    }
    if (sel l.float) {
        if (sel c.float)  { ret true; }
        if (sel c.format) { ret l.float != nil && (@l.float) == c.format; }
    }
    ret false;
}

# whether a lane of integer width `bits` passes the width test `w` against
# the target's register
fun wide_enough(t: *Target, w: rule.Width, l: LaneType) bool {
    if (sel w.any)        { ret true; }
    if (!(sel l.integer)) { ret false; }
    val reg: Bits = t.caps.widths.register;
    if (!(sel reg.bits)) { ret false; }
    val bits: u64 = l.integer::u64;
    val held: u64 = reg.bits::u64;
    if (sel w.register) { ret bits == held; }
    if (sel w.part)     { ret w.part != 0 && bits * w.part::u64 == held; }
    if (sel w.whole)    { ret bits == held * w.whole::u64; }
    ret false;
}

# whether every type test of `r` admits an operand of lane type `from` and a
# result of lane type `to`, a test of lanes reading the lanes of a vector and
# any other test the scalar of the lane, as a splat's operand and an
# extract's result are. a test of the vector class holds of a vector
fun tests_admit(t: *Target, r: *Rule, from: LaneType, to: LaneType) bool {
    var k: u32 = 0;
    for (k < r.tests.len) {
        val test: *rule.Test = ?r.tests.at[k];
        var l:    LaneType   = from;
        if (sel test.at.result)   { l = to; }
        if (sel test.at.constant) { ret false; }
        if (test.lanes || !(sel test.class.vector)) {
            if (!admits_lane(test.class, l))    { ret false; }
            if (!wide_enough(t, test.width, l)) { ret false; }
        }
        k = k + 1;
    }
    ret true;
}

# whether every type test of `r` admits it on scalars of `code`: an operand
# of lane type `from`, an address or a condition where `code` reads one, and
# a result of lane type `to` or a condition. a test of lanes or of a vector
# fails
fun scalar_tests(t: *Target, r: *Rule, code: opcode_row.Opcode, from: LaneType, to: LaneType) bool {
    var k: u32 = 0;
    for (k < r.tests.len) {
        val test: *rule.Test = ?r.tests.at[k];
        val c:    Class      = test.class;
        if (test.lanes || sel c.vector || sel test.at.constant) { ret false; }
        val bit:  bool     = sel c.width && c.width == 1;
        var lane: LaneType = from;
        var held: bool     = sel c.pointer;
        if (sel test.at.result) {
            lane = to;
            held = held || bit;
        }
        if (sel test.at.operand) {
            held = held || (bit && conditioned(code, test.at.operand.index));
        }
        if (!held && !(admits_lane(c, lane) && wide_enough(t, test.width, lane))) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether operand `k` of `code` is a condition, as a select's first
fun conditioned(code: opcode_row.Opcode, k: u8) bool {
    val opt_row: opt[*opcode_row.Row] = opcode_table.at(code);
    if (sel opt_row.none)                            { ret false; }
    if (k::usize >= $length_of(opcode_row.Operands)) { ret false; }
    ret sel opt_row.some.operands[k].role.condition;
}

# whether the build admits every row a rule emits
fun rows_admitted(ctx: *core_state.Context, r: *Rule) bool {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val op: mi.Opcode = r.expansion.at[e].opcode;
        var n:  u32       = 0;
        for (n < mi.rows_in(op)) {
            if (!core_state.admits(ctx, mi.row_in(op, n).requires)) { ret false; }
            n = n + 1;
        }
        e = e + 1;
    }
    ret true;
}

# whether a rule's hook is none or one of the table's shapes
fun shaped(t: *Table, r: *Rule) bool {
    if (r.hook == nil) { ret true; }
    var i: u32 = 0;
    for (i < t.shapes.len) {
        if (t.shapes.at[i] == r.hook) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a rule's pattern is the bare operation `code`: one node of it, or,
# where `widened`, a comparison's sign extension over it, no node needing a
# constant, and its hook none or a shape of the table
fun bare(t: *Table, r: *Rule, code: opcode_row.Opcode, widened: bool) bool {
    if (r.orderings != nil || !shaped(t, r)) { ret false; }
    var i: u32 = 0;
    for (i < r.nodes.len) {
        if (r.nodes.at[i].constants != 0) { ret false; }
        i = i + 1;
    }
    if (r.nodes.len == 1)             { ret r.nodes.at[0].opcode == code; }
    if (!widened || r.nodes.len != 2) { ret false; }
    val n: *rule.Node = ?r.nodes.at[1];
    ret r.nodes.at[0].opcode == opcode_table.EXT_S && n.opcode == code && n.parent == 0 && n.operand == 0;
}

# whether `r` serves the row `o` for every value of its operands
fun total(c: *Check, r: *Rule, o: *Operation, widened: bool) bool {
    if (!bare(c.table, r, o.opcode, widened))    { ret false; }
    if (!tests_admit(c.target, r, o.lane, o.to)) { ret false; }
    ret rows_admitted(c.ctx, r);
}

# the temporary a source names, none for any other source
fun temporary(s: Source) opt[u8] {
    if (sel s.fresh)   { ret opt[u8].some{s.fresh.index}; }
    if (sel s.scratch) { ret opt[u8].some{s.scratch.index}; }
    if (sel s.member)  { ret opt[u8].some{s.member.of.index}; }
    ret opt[u8].none{};
}

# whether a source carries a value of the match: an operand's register, a
# tied one, an address built from values, or a temporary whose bit is in
# `tainted`
fun valued(s: Source, tainted: u32) bool {
    if (sel s.value || sel s.tied) { ret true; }
    if (sel s.address) {
        if (sel s.address.base.some || sel s.address.index.some) { ret true; }
    }
    val opt_temp: opt[u8] = temporary(s);
    if (sel opt_temp.some) { ret ((tainted >> opt_temp.some::u32) & 1) != 0; }
    ret false;
}

# the role of position `k` of an instruction of a rule: its row's, and read
# and written for an instruction of no single row, as a pseudo or a loop
fun role_at(e: *Emit, k: u32) mo.Role {
    val op: mi.Opcode = e.opcode;
    if (sel op.row) {
        if (op.row != nil && k < op.row.operands.len) { ret op.row.operands.at[k].role | op.row.operands.at[k].held.role; }
    }
    ret mo.READ | mo.WRITE;
}

# whether an instruction of a rule reads a value of the match at a position it reads
fun reads_value(e: *Emit, tainted: u32) bool {
    var k: u32 = 0;
    for (k < e.operands.len) {
        if ((role_at(e, k) & mo.READ) != 0 && valued(e.operands.at[k], tainted)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the temporaries of `r` that may hold a value of the match: those an
# instruction reading one writes, to a fixed point
fun tainted_of(r: *Rule) u32 {
    var tainted: u32  = 0;
    var grew:    bool = true;
    for (grew) {
        grew = false;
        var e: u32 = 0;
        for (e < r.expansion.len) {
            val emit: *Emit = ?r.expansion.at[e];
            if (reads_value(emit, tainted)) {
                var k: u32 = 0;
                for (k < emit.operands.len) {
                    val opt_temp: opt[u8] = temporary(emit.operands.at[k]);
                    if (sel opt_temp.some) {
                        val bit: u32 = 1::u32 << opt_temp.some::u32;
                        if ((role_at(emit, k) & mo.WRITE) != 0 && (tainted & bit) == 0) {
                            tainted = tainted | bit;
                            grew    = true;
                        }
                    }
                    k = k + 1;
                }
            }
            e = e + 1;
        }
    }
    ret tainted;
}

# the registers no operand names that a row may read, or write, flags among them
fun implicit_of(row: *rows.Row, write: bool) [2]me.Set {
    var out:  [2]me.Set    = [2]me.Set{me.NO_WORDS, me.NO_WORDS};
    val regs: me.Registers = row.effect.implicit;
    var t:    me.Touched   = me.NO_TOUCHED;
    if (sel regs.ruled)  { t = regs.ruled.may; }
    if (sel regs.opaque) { t = regs.opaque.may; }
    if (write) {
        out[0] = t.written;
        out[1] = row.effect.flags.written;
    }
    or {
        out[0] = t.read;
        out[1] = row.effect.flags.read;
    }
    ret out;
}

# whether an instruction of `r` before its instruction `before` that reads a
# value of the match writes a register of `kept` that `row` reads: a flag it
# sets, or a register through an operand naming it. any other implicit
# write, as vstart's reset or the vl a vset sets, carries no operand's value
fun writes_kept(r: *Rule, tainted: u32, before: u32, kept: me.Set, row: *rows.Row, file: *rf.File) bool {
    val reads: [2]me.Set = implicit_of(row, false);
    var e:     u32       = 0;
    for (e < before) {
        val emit: *Emit = ?r.expansion.at[e];
        if (reads_value(emit, tainted)) {
            var n: u32 = 0;
            for (n < mi.rows_in(emit.opcode)) {
                val flags: me.Set = mi.row_in(emit.opcode, n).effect.flags.written;
                var w:     u32    = 0;
                for (w < flags.len && w < kept.len && w < reads[1].len) {
                    if ((flags.words[w] & kept.words[w] & reads[1].words[w]) != 0) { ret true; }
                    w = w + 1;
                }
                n = n + 1;
            }
            var k: u32 = 0;
            for (k < emit.operands.len) {
                val s: Source = emit.operands.at[k];
                if (sel s.fixed) {
                    if ((role_at(emit, k) & mo.WRITE) != 0 && me.has(file, kept, s.fixed) && (me.has(file, reads[0], s.fixed) || me.has(file, reads[1], s.fixed))) { ret true; }
                }
                k = k + 1;
            }
        }
        e = e + 1;
    }
    ret false;
}

# whether the row `row` of the instruction `at` of `r` depends on no value of
# the match under `timed`: no operand position its timing depends on reads
# one, it makes no access whose data its timing depends on, and no register
# no operand names that it reads and its timing depends on was written with
# one by an instruction of `r` before it. an immediate, a fixed register and
# a temporary made from immediates alone hold no value
fun quiet(row: *rows.Row, r: *Rule, at: u32, timed: *core_state.Context, tainted: u32) bool {
    val emit: *Emit     = ?r.expansion.at[at];
    val on:   ct.Inputs = ct.inputs(row.ct, timed);
    if (ct.is_empty(?on)) { ret true; }
    var k: u32 = 0;
    for (k < emit.operands.len && k < 32) {
        val read: bool = k < row.operands.len && ((row.operands.at[k].role | row.operands.at[k].held.role) & mo.READ) != 0;
        if (((on.operands >> k) & 1) != 0 && read && valued(emit.operands.at[k], tainted)) { ret false; }
        k = k + 1;
    }
    if (on.accesses && row.effect.memory.len != 0 && reads_value(emit, tainted)) { ret false; }
    val regs: ct.Registers = on.implicit;
    if (sel regs.only) { ret !writes_kept(r, tainted, at, regs.only, row, timed.view.file); }
    val touched: [2]me.Set = implicit_of(row, false);
    ret !writes_kept(r, tainted, at, touched[0], row, timed.view.file) && !writes_kept(r, tainted, at, touched[1], row, timed.view.file);
}

# whether holder `h` is the class `k`
fun holds_in(h: Holder, k: *rf.Class) bool {
    if (sel h.hardware) { ret h.hardware == k; }
    ret false;
}

# whether every move of the set within the class of holder `k` that the build
# admits depends on no value it moves under `timed`
fun moves_quiet(c: *Check, k: Holder, timed: *core_state.Context) bool {
    if (!(sel k.hardware)) { ret true; }
    var i: u32 = 0;
    for (i < c.moves.moves.len) {
        val m: *move.Move = ?c.moves.moves.at[i];
        if (holds_in(m.to, k.hardware) && holds_in(m.from, k.hardware) && core_state.admits(c.ctx, m.row.requires)) {
            val on: ct.Inputs = ct.inputs(m.row.ct, timed);
            var p:  u32       = 0;
            for (p < m.parts.len && p < 32) {
                if (sel m.parts.at[p].from && ((on.operands >> p) & 1) != 0) { ret false; }
                p = p + 1;
            }
        }
        i = i + 1;
    }
    ret true;
}

# whether a copy `emit` of a rule depends on no value of the match under
# `timed`: a copy lowers to the set's move within its class, so it is timed as
# each move within the classes of `w` the build holds
fun copy_quiet(c: *Check, emit: *Emit, timed: *core_state.Context, tainted: u32, w: Within) bool {
    if (!reads_value(emit, tainted)) { ret true; }
    var h: u32 = 0;
    for (h < c.table.holds.len) {
        val hold: *rule.Hold = ?c.table.holds.at[h];
        var mine: bool       = sel hold.class.vector;
        if (!w.vector)                                                    { mine = !mine && admits_lane(hold.class, w.lane); }
        if (mine && c.met.data[h] && !moves_quiet(c, hold.holder, timed)) { ret false; }
        h = h + 1;
    }
    ret true;
}

# whether every row `r` emits depends on no value of the match under `timed`,
# a copy timed as the moves within the classes of `w`
fun timed_quiet(c: *Check, r: *Rule, timed: *core_state.Context, w: Within) bool {
    val tainted: u32 = tainted_of(r);
    var e:       u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit     = ?r.expansion.at[e];
        val op:   mi.Opcode = emit.opcode;
        if (sel op.pseudo) {
            if (op.pseudo == pseudo.COPY && !copy_quiet(c, emit, timed, tainted, w)) { ret false; }
        }
        var n: u32 = 0;
        for (n < mi.rows_in(emit.opcode)) {
            if (!quiet(mi.row_in(emit.opcode, n), r, e, timed, tainted)) { ret false; }
            n = n + 1;
        }
        e = e + 1;
    }
    ret true;
}

# the scalar operations whose rules the lane-by-lane form of an operation is
# made of, the first `len` of `at`
rec References {
    at:  [2]opcode_row.Opcode;
    len: u32;
}

# the scalar operations of the lane-by-lane form of `code`: the same
# operation for a lanewise one, a reduction's operation, a comparison and a
# select for an integer minimum or maximum, and a load and a store for an
# operation that moves lanes, which goes through a slot
fun references(code: opcode_row.Opcode) References {
    if (code == opcode_table.REDUCE_ADD)                                      { ret References{at: [2]opcode_row.Opcode{opcode_table.ADD, 0}, len: 1}; }
    if (code == opcode_table.REDUCE_MUL)                                      { ret References{at: [2]opcode_row.Opcode{opcode_table.MUL, 0}, len: 1}; }
    if (code == opcode_table.REDUCE_AND)                                      { ret References{at: [2]opcode_row.Opcode{opcode_table.AND, 0}, len: 1}; }
    if (code == opcode_table.REDUCE_OR)                                       { ret References{at: [2]opcode_row.Opcode{opcode_table.OR, 0}, len: 1}; }
    if (code == opcode_table.REDUCE_XOR)                                      { ret References{at: [2]opcode_row.Opcode{opcode_table.XOR, 0}, len: 1}; }
    if (code == opcode_table.REDUCE_SMIN || code == opcode_table.REDUCE_SMAX) { ret References{at: [2]opcode_row.Opcode{opcode_table.LT_S, opcode_table.SELECT}, len: 2}; }
    if (code == opcode_table.REDUCE_UMIN || code == opcode_table.REDUCE_UMAX) { ret References{at: [2]opcode_row.Opcode{opcode_table.LT_U, opcode_table.SELECT}, len: 2}; }
    if (code == opcode_table.VSPLAT || code == opcode_table.VBUILD || code == opcode_table.VSHUFFLE || code == opcode_table.VEXTRACT || code == opcode_table.VINSERT) {
        ret References{at: [2]opcode_row.Opcode{opcode_table.LOAD, opcode_table.STORE}, len: 2};
    }
    ret References{at: [2]opcode_row.Opcode{code, 0}, len: 1};
}

# how the rules of the scalar operation `code` from a lane of `from` to one of
# `to` stand under `timed`: none serves it, or whether every one that does
# depends on no value. any hook counts, as the lane-by-lane form takes
# whichever rule its values choose
fun scalar_quiet(c: *Check, code: opcode_row.Opcode, from: LaneType, to: LaneType, timed: *core_state.Context) opt[bool] {
    var found: bool = false;
    var i:     u32  = 0;
    for (i < c.table.rules.len) {
        val r: *Rule = ?c.table.rules.at[i];
        if (r.nodes.len == 1 && r.nodes.at[0].opcode == code && r.nodes.at[0].constants == 0 && scalar_tests(c.target, r, code, from, to) && rows_admitted(c.ctx, r)) {
            found = true;
            if (!timed_quiet(c, r, timed, Within{vector: false, lane: from})) { ret opt[bool].some{false}; }
        }
        i = i + 1;
    }
    if (!found) { ret opt[bool].none{}; }
    ret opt[bool].some{true};
}

# how the lane-by-lane form of the row `o` on lanes of `bits` stands under
# `timed`: each of its scalar operations, the row's own from its lane to the
# lane it gives and any other on its lane, or at the narrowest width the
# target computes above it where no rule serves that one. none where no rule
# serves one of them at all
fun lanes_quiet(c: *Check, o: *Operation, bits: u32, timed: *core_state.Context) opt[bool] {
    val refs:  References = references(o.opcode);
    var quiet: bool       = true;
    var j:     u32        = 0;
    for (j < refs.len) {
        var to: LaneType = o.lane;
        if (refs.at[j] == o.opcode) { to = o.to; }
        val opt_at: opt[bool] = scalar_quiet_above(c, refs.at[j], bits, to, timed);
        if (sel opt_at.none) { ret opt_at; }
        quiet = quiet && opt_at.some;
        j     = j + 1;
    }
    ret opt[bool].some{quiet};
}

# how the rules of `code` stand from a lane of `bits` to one of `to`, or from
# the narrowest width the target computes above `bits` where none serves it
# at `bits`, to that width too where `to` is the operand's lane
fun scalar_quiet_above(c: *Check, code: opcode_row.Opcode, bits: u32, to: LaneType, timed: *core_state.Context) opt[bool] {
    val opt_at: opt[bool] = scalar_quiet(c, code, LaneType.integer{bits}, to, timed);
    if (sel opt_at.some) { ret opt_at; }
    val above: u32 = computed_above(c, bits);
    if (above == 0) { ret opt_at; }
    var raised: LaneType = to;
    if (sel to.integer && to.integer == bits) { raised = LaneType.integer{above}; }
    ret scalar_quiet(c, code, LaneType.integer{above}, raised, timed);
}

# the narrowest width the target computes above `bits`, zero for none
fun computed_above(c: *Check, bits: u32) u32 {
    val alu: capability.Set = c.target.caps.widths.alu;
    if (!(sel alu.widths)) { ret 0; }
    var above: u32   = 0;
    var i:     usize = 0;
    for (i < alu.widths.size) {
        val w: u32 = alu.widths.data[i];
        if (w > bits && (above == 0 || w < above)) { above = w; }
        i = i + 1;
    }
    ret above;
}

# whether `r` is timed relative to the lane-by-lane form of `o` under each
# of the mode sets: wherever its form depends on no value, nor does `r`
fun relatively_timed(c: *Check, r: *Rule, o: *Operation, modes: *Moded, failed: *mct.Needs) bool {
    if (!(sel o.lane.integer)) { ret true; }
    val bits: u32   = o.lane.integer;
    var m:    usize = 0;
    for (m < 3) {
        val timed: *core_state.Context = ?modes[m].timed.context;
        if (!timed_quiet(c, r, timed, Within{vector: true, lane: o.lane})) {
            val opt_lanes: opt[bool] = lanes_quiet(c, o, bits, timed);
            var lanes:     bool      = true;
            if (sel opt_lanes.some) { lanes = opt_lanes.some; }
            if (lanes) {
                @failed = modes[m].needs;
                ret false;
            }
        }
        m = m + 1;
    }
    ret true;
}

# whether some rule of the table serves the row `o`, and else which half it fails
fun served(c: *Check, o: *Operation, widened: bool, modes: *Moded) opt[Half] {
    var any:    bool      = false;
    var failed: mct.Needs = mct.NO_NEEDS;
    var i:      u32       = 0;
    for (i < c.table.rules.len) {
        val r: *Rule = ?c.table.rules.at[i];
        if (total(c, r, o, widened)) {
            any = true;
            if (relatively_timed(c, r, o, modes, ?failed)) { ret opt[Half].none{}; }
        }
        i = i + 1;
    }
    if (!any) { ret opt[Half].some{Half.total{}}; }
    ret opt[Half].some{Half.timed{failed}};
}

fun modes_dnit(modes: *Moded, made: usize) {
    var m: usize = 0;
    for (m < made) {
        mct.dnit(?modes[m].timed);
        m = m + 1;
    }
}

# check the rows of one unit the build meets
fun unit_check(c: *Check, unit: *Unit, u: u32, ops: Slice[Operation], modes: *Moded) err[Error] {
    val ctx:     opt[*core_state.Context] = opt[*core_state.Context].some{c.ctx};
    val widened: bool                     = sel unit.masks.widened;
    var i:       usize                    = 0;
    for (i < ops.size) {
        val o:          *Operation             = ?ops.data[i];
        val res_packed: res[bool, units.Error] = units.native(ctx, unit, o.opcode, o.lane, o.to);
        if (sel res_packed.err) { ret err[Error].err{Error.unit{res_packed.err}}; }
        if (res_packed.ok) {
            val opt_half: opt[Half] = served(c, o, widened, modes);
            if (sel opt_half.some) { ret err[Error].err{Error.unserved{Unserved{unit: u, row: i::u32, operation: @o, half: opt_half.some}}}; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# check that every row the build packs is served by a total rule, timed
# relative to the lane-by-lane form for integer lanes
# ---
# a:      the allocator the timing contexts take
# table:  the target's selection table
# target: the target, whose units are read
# set:    the build's instruction set, whose switches decide what it guarantees
# moves:  the set's moves, which a copy a rule emits lowers to
# ctx:    the build's context
# ret:    nothing, or the first row no rule serves, or why a row or unit
#         could not be read
pub fun check(a: *allocator.Allocator, table: *Table, target: *Target, set: *mset.Set, moves: *move.Table, ctx: *core_state.Context) err[Error] {
    val v: Vectors = target.caps.vectors;
    if (!(sel v.units)) { ret err[Error].ok{}; }
    val needs: [3]mct.Needs = [3]mct.Needs{mct.NO_NEEDS, mct.guaranteed(set, ctx), mct.liftable_modes(ctx)};
    var modes: [3]Moded;
    var made:  usize        = 0;
    for (made < 3) {
        modes[made].needs = needs[made];
        val err_timed: err[allocator.Error] = mct.under(a, ctx, needs[made], ?modes[made].timed);
        if (sel err_timed.err) {
            modes_dnit(?modes[0], made);
            ret err[Error].err{Error.alloc{err_timed.err}};
        }
        made = made + 1;
    }
    fin { modes_dnit(?modes[0], made); }
    var c: Check = Check{table: table, target: target, ctx: ctx, moves: moves, met: vector.init[bool](a)};
    fin { vector.dnit[bool](?c.met); }
    var h: u32 = 0;
    for (h < table.holds.len) {
        val res_held: res[bool, basis.Error] = basis.admits(opt[*core_state.Context].some{ctx}, table.holds.at[h].requires);
        if (sel res_held.err) { ret err[Error].err{Error.hold{res_held.err}}; }
        val res_pushed: res[usize, allocator.Error] = vector.push[bool](?c.met, res_held.ok);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        h = h + 1;
    }
    var u: usize = 0;
    for (u < v.units.size) {
        val unit:    *Unit                  = ?v.units.data[u];
        val res_met: res[bool, units.Error] = units.meets(opt[*core_state.Context].some{ctx}, unit);
        if (sel res_met.err) { ret err[Error].err{Error.unit{res_met.err}}; }
        val ops: capability.Operations = unit.operations;
        if (!res_met.ok) {
            u = u + 1;
            cnt;
        }
        if (sel ops.rows) {
            val err_unit: err[Error] = unit_check(?c, unit, u::u32, ops.rows, ?modes[0]);
            if (sel err_unit.err) { ret err_unit; }
        }
        u = u + 1;
    }
    ret err[Error].ok{};
}
