#[testing]
val E_SLT:  [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[8]}, operands: Sources{at: ?S_BINARY[0], len: 3}}};
#[testing]
val E_JUMP: [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[6]}, operands: Sources{at: ?S_JUMP[0], len: 1}}};
