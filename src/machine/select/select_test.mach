#[testing]
val T_IMM: mo.Immediate = mo.Immediate{bits: 12, signed: true, scale: 0, bias: 0, fixup: mo.NO_FIXUP, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val T_WIDE: mo.Immediate = mo.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: mo.NO_FIXUP, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val T_OFFSET: mo.Immediate = mo.Immediate{bits: 16, signed: true, scale: 0, bias: 0, fixup: 1, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val W: mo.Operand = mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.WRITE, width: 64, quantity: mo.ONE};
#[testing]
val R: mo.Operand = mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.READ, width: 64, quantity: mo.ONE};
#[testing]
val I: mo.Operand = mo.Operand{shape: mo.Shape.immediate{T_IMM}, role: mo.READ, width: 12, quantity: mo.ONE};
#[testing]
val L: mo.Operand = mo.Operand{shape: mo.Shape.immediate{T_WIDE}, role: mo.READ, width: 32, quantity: mo.ONE};
#[testing]
val B: mo.Operand = mo.Operand{shape: mo.Shape.relative{mo.Relative{offset: T_OFFSET, anchor: mo.END}}, role: mo.READ, width: 0, quantity: mo.ONE};

#[testing]
val T_RRR:    [3]mo.Operand = [3]mo.Operand{W, R, R};
#[testing]
val T_RRI:    [3]mo.Operand = [3]mo.Operand{W, R, I};
#[testing]
