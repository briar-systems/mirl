# one general class of eight registers
#[testing]
val T_CLASSES: [1]rf.Class = [1]rf.Class{
    rf.Class{name: "r", kind: rf.GENERAL, width: rf.Scaled{fixed: 64, per: 0, scale: 0}, count: 8},
};

#[testing]
val T_REGISTERS: [2]rf.Register = [2]rf.Register{
    rf.Register{name: "r0", class: 0, number: 0, bank: 0, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.Requirement{at: nil, len: 0}},
    rf.Register{name: "r1", class: 0, number: 1, bank: 0, offset: rf.Scaled{fixed: 0, per: 0, scale: 0}, stride: rf.Scaled{fixed: 0, per: 0, scale: 0}, count: rf.Scaled{fixed: 1, per: 0, scale: 0}, flags: 0, requires: requirement.Requirement{at: nil, len: 0}},
};

#[testing]
val T_FILE: rf.File = rf.File{
    scales:         nil,
    scale_count:    0,
    classes:        ?T_CLASSES[0],
    class_count:    1,
    class_names:    index.Index{at: ?T_CLASS_NAMES[0], len: 1},
    registers:      ?T_REGISTERS[0],
    register_count: 2,
    aliases:        nil,
    alias_count:    0,
    names:          index.Index{at: ?T_NAMES[0], len: 2},
    columns:        nil,
    column_count:   0,
};

# one extension, which the multiply needs
#[testing]
val T_EXTENSIONS: [1]extension.Extension = [1]extension.Extension{extension.Extension{name: "m", implies: requirement.Ids{at: nil, len: 0}, revision: "1"}};

#[testing]
val T_CATALOG: extension.Catalog = extension.Catalog{extensions: ?T_EXTENSIONS[0], count: 1, levels: nil, level_count: 0, conflicts: nil, conflict_count: 0, combinations: nil, combination_count: 0, syntax: ?extension.LIST};

#[testing]
val T_M: [1]requirement.Id = [1]requirement.Id{0};

#[testing]
val T_M_ALT: [1]requirement.Ids = [1]requirement.Ids{requirement.Ids{at: ?T_M[0], len: 1}};

#[testing]
val T_GENERAL: [1]u16 = [1]u16{0};

#[testing]
val T_REG: mo.Register = mo.Register{classes: mo.Classes{at: ?T_GENERAL[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}};

#[testing]
val T_IMM: mo.Immediate = mo.Immediate{bits: 12, signed: true, scale: 0, bias: 0, fixup: mo.NO_FIXUP, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val T_WIDE: mo.Immediate = mo.Immediate{bits: 32, signed: true, scale: 0, bias: 0, fixup: mo.NO_FIXUP, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val T_OFFSET: mo.Immediate = mo.Immediate{bits: 16, signed: true, scale: 0, bias: 0, fixup: 1, format: mo.INTEGER, excluded: mo.Integers{at: nil, len: 0}};

#[testing]
val W: mo.Operand = mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.WRITE, width: 64, quantity: mo.ONE};
#[testing]
val R: mo.Operand = mo.Operand{shape: mo.Shape.register{T_REG}, role: mo.READ, width: 64, quantity: mo.ONE};
#[testing]
val I: mo.Operand = mo.Operand{shape: mo.Shape.immediate{T_IMM}, role: mo.READ, width: 12, quantity: mo.ONE};
#[testing]
val L: mo.Operand = mo.Operand{shape: mo.Shape.immediate{T_WIDE}, role: mo.READ, width: 32, quantity: mo.ONE};
#[testing]
val B: mo.Operand = mo.Operand{shape: mo.Shape.relative{mo.Relative{offset: T_OFFSET, anchor: mo.END}}, role: mo.READ, width: 0, quantity: mo.ONE};

#[testing]
val T_RRR:    [3]mo.Operand = [3]mo.Operand{W, R, R};
#[testing]
val T_RRI:    [3]mo.Operand = [3]mo.Operand{W, R, I};
#[testing]
val T_RL:     [2]mo.Operand = [2]mo.Operand{W, L};
#[testing]
val T_BRANCH: [3]mo.Operand = [3]mo.Operand{R, R, B};
#[testing]
val T_TEST:   [2]mo.Operand = [2]mo.Operand{R, B};
#[testing]
val T_JUMP:   [1]mo.Operand = [1]mo.Operand{B};
#[testing]
val T_RETURN: [1]mo.Operand = [1]mo.Operand{R};

#[testing]
val T_PLAIN: effect.Effect = effect.Effect{
    implicit: effect.Registers{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}},
    flags:    effect.Flags{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}, undefined: effect.Set{words: nil, len: 0}, kept: effect.Set{words: nil, len: 0}},
    memory:   effect.Accesses{at: nil, len: 0},
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.Fixeds{at: nil, len: 0},
};

#[testing]
val ADD:  u32 = 0;
#[testing]
val ADDI: u32 = 1;
#[testing]
val SUB:  u32 = 2;
#[testing]
val XORI: u32 = 3;
#[testing]
val MULX: u32 = 4;
#[testing]
val BLT:  u32 = 5;
#[testing]
val J:    u32 = 6;
#[testing]
val BNEZ: u32 = 7;
#[testing]
val SLT:  u32 = 8;
#[testing]
val LI:   u32 = 9;
#[testing]
val RETV: u32 = 10;

#[testing]
val T_ROWS: [11]rows.Row = [11]rows.Row{
    rows.Row{key: "add", mnemonic: "add", operands: rows.Operands{at: ?T_RRR[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "addi", mnemonic: "addi", operands: rows.Operands{at: ?T_RRI[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "sub", mnemonic: "sub", operands: rows.Operands{at: ?T_RRR[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "xori", mnemonic: "xori", operands: rows.Operands{at: ?T_RRI[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "mulx", mnemonic: "mulx", operands: rows.Operands{at: ?T_RRR[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: ?T_M_ALT[0], len: 1}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "blt", mnemonic: "blt", operands: rows.Operands{at: ?T_BRANCH[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "j", mnemonic: "j", operands: rows.Operands{at: ?T_JUMP[0], len: 1}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "bnez", mnemonic: "bnez", operands: rows.Operands{at: ?T_TEST[0], len: 2}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "slt", mnemonic: "slt", operands: rows.Operands{at: ?T_RRR[0], len: 3}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "li", mnemonic: "li", operands: rows.Operands{at: ?T_RL[0], len: 2}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
    rows.Row{key: "retv", mnemonic: "retv", operands: rows.Operands{at: ?T_RETURN[0], len: 1}, encoding: field.Fields{at: nil, len: 0}, requires: requirement.Requirement{at: nil, len: 0}, effect: ?T_PLAIN, ct: ?ct.DEPENDENT, flags: 0},
};

#[testing]
val T_KEYS: [11]index.Entry = [11]index.Entry{
    index.Entry{key: "add", row: 0},
    index.Entry{key: "addi", row: 1},
    index.Entry{key: "blt", row: 5},
    index.Entry{key: "bnez", row: 7},
    index.Entry{key: "j", row: 6},
    index.Entry{key: "li", row: 9},
    index.Entry{key: "mulx", row: 4},
    index.Entry{key: "retv", row: 10},
    index.Entry{key: "slt", row: 8},
    index.Entry{key: "sub", row: 2},
    index.Entry{key: "xori", row: 3},
};

#[testing]
val T_NAMES: [2]index.Entry = [2]index.Entry{index.Entry{key: "r0", row: 0}, index.Entry{key: "r1", row: 1}};

#[testing]
val T_CLASS_NAMES: [1]index.Entry = [1]index.Entry{index.Entry{key: "r", row: 0}};

#[testing]
val T_CODEC: walk.Codec = walk.Codec{fields: nil, registers: ?T_FILE, rows: rows.Rows{at: ?T_ROWS[0], len: 11}, keys: index.Index{at: ?T_KEYS[0], len: 11}, dispatch: nil};

#[testing]
val T_SET: mset.Set = mset.Set{arches: mset.Arches{at: nil, len: 0}, codec: ?T_CODEC, extensions: ?T_CATALOG, bindings: mset.Bindings{at: nil, len: 0}, relax: relax.Relaxations{at: nil, len: 0}, fill: nil, syntaxes: spelling.Syntaxes{at: nil, len: 0}};

#[testing]
val RES: Source = Source.result{0};
#[testing]
val V00: Source = Source.value{Slot{node: 0, index: 0}};
#[testing]
val V01: Source = Source.value{Slot{node: 0, index: 1}};
#[testing]
val V10: Source = Source.value{Slot{node: 1, index: 0}};
#[testing]
val V11: Source = Source.value{Slot{node: 1, index: 1}};
#[testing]
val TO0: Source = Source.target{0};
#[testing]
val TO1: Source = Source.target{1};
#[testing]
val TMP: Source = Source.fresh{rule.Fresh{index: 0, like: Ref.operand{Slot{node: 0, index: 0}}}};

# every rule's operand lists
#[testing]
val S_BINARY: [3]Source = [3]Source{RES, V00, V01};
#[testing]
val S_ADDI:   [3]Source = [3]Source{RES, V00, Source.bits{Ref.operand{Slot{node: 0, index: 1}}}};
#[testing]
val S_NOT:    [3]Source = [3]Source{TMP, V00, Source.literal{-1}};
#[testing]
val S_INC:    [3]Source = [3]Source{RES, TMP, Source.literal{1}};
#[testing]
val S_FUSED:  [3]Source = [3]Source{V10, V11, TO0};
#[testing]
val S_TEST:   [2]Source = [2]Source{V00, TO0};
#[testing]
val S_ELSE:   [1]Source = [1]Source{TO1};
#[testing]
val S_JUMP:   [1]Source = [1]Source{TO0};
#[testing]
val S_RET:    [1]Source = [1]Source{V00};
#[testing]
val S_LI:     [2]Source = [2]Source{RES, Source.bits{Ref.constant{}}};
#[testing]
val S_TWICE:  [3]Source = [3]Source{RES, V00, V00};
#[testing]
val S_CHILD:  [3]Source = [3]Source{RES, V10, V01};

#[testing]
val E_MULX:  [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[4]}, operands: Sources{at: ?S_BINARY[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_ADD:   [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[0]}, operands: Sources{at: ?S_BINARY[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_SUB:   [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[2]}, operands: Sources{at: ?S_BINARY[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_TWICE: [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[0]}, operands: Sources{at: ?S_TWICE[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_CHILD: [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[0]}, operands: Sources{at: ?S_CHILD[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_ADDI:  [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[1]}, operands: Sources{at: ?S_ADDI[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_NEG:   [2]Emit = [2]Emit{
    Emit{opcode: Opcode.row{?T_ROWS[3]}, operands: Sources{at: ?S_NOT[0], len: 3}, implied: NO_IMPLIED},
    Emit{opcode: Opcode.row{?T_ROWS[1]}, operands: Sources{at: ?S_INC[0], len: 3}, implied: NO_IMPLIED},
};
#[testing]
val E_FUSED: [2]Emit = [2]Emit{
    Emit{opcode: Opcode.row{?T_ROWS[5]}, operands: Sources{at: ?S_FUSED[0], len: 3}, implied: NO_IMPLIED},
    Emit{opcode: Opcode.row{?T_ROWS[6]}, operands: Sources{at: ?S_ELSE[0], len: 1}, implied: NO_IMPLIED},
};
#[testing]
val E_TEST: [2]Emit = [2]Emit{
    Emit{opcode: Opcode.row{?T_ROWS[7]}, operands: Sources{at: ?S_TEST[0], len: 2}, implied: NO_IMPLIED},
    Emit{opcode: Opcode.row{?T_ROWS[6]}, operands: Sources{at: ?S_ELSE[0], len: 1}, implied: NO_IMPLIED},
};
#[testing]
val E_SLT:  [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[8]}, operands: Sources{at: ?S_BINARY[0], len: 3}, implied: NO_IMPLIED}};
#[testing]
val E_JUMP: [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[6]}, operands: Sources{at: ?S_JUMP[0], len: 1}, implied: NO_IMPLIED}};
#[testing]
val E_RET:  [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[10]}, operands: Sources{at: ?S_RET[0], len: 1}, implied: NO_IMPLIED}};
#[testing]
val E_LI:   [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[9]}, operands: Sources{at: ?S_LI[0], len: 2}, implied: NO_IMPLIED}};

#[testing]
val N_MUL:      [1]Node = [1]Node{Node{opcode: ir.MUL, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_ADD:      [1]Node = [1]Node{Node{opcode: ir.ADD, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_ADDI:     [1]Node = [1]Node{Node{opcode: ir.ADD, parent: 0, operand: 0, result: 0, constants: 2}};
#[testing]
val N_LOAD:     [1]Node = [1]Node{Node{opcode: ir.LOAD, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_ADD_NEG:  [2]Node = [2]Node{Node{opcode: ir.ADD, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.NEG, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_ADD_LOAD: [2]Node = [2]Node{Node{opcode: ir.ADD, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.LOAD, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_NEG:      [1]Node = [1]Node{Node{opcode: ir.NEG, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_FUSED:    [2]Node = [2]Node{Node{opcode: ir.CBR, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.LT_S, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_CBR:      [1]Node = [1]Node{Node{opcode: ir.CBR, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_LT:       [1]Node = [1]Node{Node{opcode: ir.LT_S, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_BR:       [1]Node = [1]Node{Node{opcode: ir.BR, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
val N_RET:      [1]Node = [1]Node{Node{opcode: ir.RET, parent: 0, operand: 0, result: 0, constants: 0}};

# a multiply of 64-bit operands, which no test function has
#[testing]
val WIDE_ONLY: [1]Test = [1]Test{Test{at: Ref.operand{Slot{node: 0, index: 0}}, class: Class.width{64}, lanes: false}};

#[testing]
val T_RULES: [14]Rule = [14]Rule{
    Rule{nodes: Nodes{at: ?N_MUL[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_SUB[0], len: 1}, cost: 3},
    Rule{nodes: Nodes{at: ?N_MUL[0], len: 1}, tests: Tests{at: ?WIDE_ONLY[0], len: 1}, hook: nil, expansion: Emits{at: ?E_ADD[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_MUL[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_MULX[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: ?N_ADDI[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_ADDI[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_ADD[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_ADD[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_NEG[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_NEG[0], len: 2}, cost: 2},
    Rule{nodes: Nodes{at: ?N_FUSED[0], len: 2}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_FUSED[0], len: 2}, cost: 2},
    Rule{nodes: Nodes{at: ?N_CBR[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_TEST[0], len: 2}, cost: 2},
    Rule{nodes: Nodes{at: ?N_LT[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_SLT[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_BR[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_JUMP[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_RET[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_RET[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_LOAD[0], len: 1}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_TWICE[0], len: 1}, cost: 1},
    Rule{nodes: Nodes{at: ?N_ADD_NEG[0], len: 2}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_CHILD[0], len: 1}, cost: 0},
    Rule{nodes: Nodes{at: ?N_ADD_LOAD[0], len: 2}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_CHILD[0], len: 1}, cost: 0},
};

#[testing]
val T_CONSTANTS: [1]Rule = [1]Rule{
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: nil, len: 0}, hook: nil, expansion: Emits{at: ?E_LI[0], len: 1}, cost: 1},
};

#[testing]
val T_HOLDS: [3]rule.Hold = [3]rule.Hold{
    rule.Hold{class: Class.integer{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
    rule.Hold{class: Class.pointer{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
    rule.Hold{class: Class.float{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
};

#[testing]
val T_TABLE: Table = Table{
    rules:     rule.Rules{at: ?T_RULES[0], len: 14},
    constants: rule.Rules{at: ?T_CONSTANTS[0], len: 1},
    holds:     rule.Holds{at: ?T_HOLDS[0], len: 3},
    jump:      Emits{at: ?E_JUMP[0], len: 1},
};

# a module, its function @f, a selection and a selector over the test table
#[testing]
rec Fixture {
    a:         allocator.Allocator;
    m:         Module;
    f:         id.Function;
    selection: extension.Selection;
    s:         Selector;
    at:        Locations;
}

# select the fixture's function, whose calls clobber nothing
#[testing]
fun selected(x: *Fixture) res[mf.Function, Error] {
    var calls: Calls                = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?x.at};
    val got:   res[Selected, Error] = engine.select(?x.s, ?x.m, x.f, ?calls);
    if (sel got.err) { ret res[mf.Function, Error].err{got.err}; }
    var out: Selected = got.ok;
    vector.dnit[Clobber](?out.clobbers);
    ret res[mf.Function, Error].ok{out.function};
}

#[testing]
fun setup(x: *Fixture, text: str, m_selected: bool) bool {
    page.make(?x.a);
    val parsed: res[Module, Refusal] = parse_body(?x.a, View{data: text, len: str_len(text)});
    if (sel parsed.err) { ret false; }
    x.m = parsed.ok;
    val found: opt[id.Symbol] = module.find(?x.m, View{data: "f", len: 1});
    if (sel found.none) { ret false; }
    val symbol: id.Symbol = found.some;
    if (!(sel symbol.function)) { ret false; }
    x.f = symbol.function;
    val req: res[extension.Request, extension.Error] = extension.request(?x.a, ?T_CATALOG, "", diagnostic.Position{offset: 0, line: 1, column: 1});
    if (sel req.err) { ret false; }
    var r: extension.Request = req.ok;
    if (m_selected) { extension.request_add(?r, 0); }
    val closed: res[extension.Selection, extension.Error] = extension.close(r);
    if (sel closed.err) { ret false; }
    x.selection = closed.ok;
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none) { ret false; }
    val made: res[Selector, Error] = engine.init(?x.a, ?T_TABLE, row.some, ?T_SET, ?x.selection);
    if (sel made.err) { ret false; }
    x.s = made.ok;
    val at: res[Locations, location.Error] = location.init(?x.a, ?T_FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel at.err) { ret false; }
    x.at = at.ok;
    ret true;
}

#[testing]
fun teardown(x: *Fixture) {
    location.dnit(?x.at);
    engine.dnit(?x.s);
    extension.release(?x.selection);
    module.dnit(?x.m);
}

# the instructions of machine block `b`
#[testing]
fun listed(f: *mf.Function, b: u32) Slice[Instruction] {
    ret mf.instructions(f, Block{index: b});
}

# whether instruction `at` of block `b` is of row `k`
#[testing]
fun is_row(f: *mf.Function, b: u32, at: usize, k: u32) bool {
    val list: Slice[Instruction] = listed(f, b);
    if (at >= list.size) { ret false; }
    val d: *InstructionData = mf.data(f, list.data[at]);
    ret sel d.opcode.row && d.opcode.row == ?T_ROWS[k];
}

#[testing]
fun virtual_at(f: *mf.Function, b: u32, at: usize, k: usize) u32 {
    val d: *InstructionData = mf.data(f, listed(f, b).data[at]);
    val o: Operand          = d.operands.data[k];
    if (sel o.virtual) { ret o.virtual.index; }
    ret 0xffffffff;
}

#[testing]
fun immediate_at(f: *mf.Function, b: u32, at: usize, k: usize) opt[i64] {
    val d: *InstructionData = mf.data(f, listed(f, b).data[at]);
    val o: Operand          = d.operands.data[k];
    if (sel o.immediate) { ret opt[i64].some{o.immediate}; }
    ret opt[i64].none{};
}

#[testing]
fun block_at(f: *mf.Function, b: u32, at: usize, k: usize) u32 {
    val d: *InstructionData = mf.data(f, listed(f, b).data[at]);
    val o: Operand          = d.operands.data[k];
    if (sel o.block) { ret o.block.index; }
    ret 0xffffffff;
}

#[testing]
val FIRST_RULE: str = "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%x: i32, %y: i32):\n    %p = mul %x, %y\n    %q = add %p, i32 5\n    %r = add i32 7, %q\n    %s = add %r, i32 100000\n    ret %s\n}\n";

test select__the_least_cost_rule_whose_guard_holds_is_chosen_the_first_on_a_tie {
    var x: Fixture;
    if (!setup(?x, FIRST_RULE, false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.err) { ret 2; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # the entry copies its two parameters out of their registers first, and
    # the cheaper multiplies need m, which is not selected, or 64-bit operands
    if (!is_row(?f, 0, 2, SUB)) { ret 3; }
    # addi ties with add and comes first, either way round, and a constant that does not fit is loaded
    if (!is_row(?f, 0, 3, ADDI)) { ret 4; }
    val five: opt[i64] = immediate_at(?f, 0, 3, 2);
    if (!(sel five.some && five.some == 5)) { ret 4; }
    if (!is_row(?f, 0, 4, ADDI))            { ret 5; }
    val seven: opt[i64] = immediate_at(?f, 0, 4, 2);
    if (!(sel seven.some && seven.some == 7))                                       { ret 5; }
    if (!is_row(?f, 0, 5, LI) || !is_row(?f, 0, 6, ADD) || !is_row(?f, 0, 7, RETV)) { ret 6; }
    val wide: opt[i64] = immediate_at(?f, 0, 5, 1);
    if (!(sel wide.some && wide.some == 100000))            { ret 6; }
    if (virtual_at(?f, 0, 5, 0) != virtual_at(?f, 0, 6, 2)) { ret 6; }
    if (listed(?f, 0).size != 8)                            { ret 7; }

    # with m selected the cheaper multiply holds, though it comes later
    var y: Fixture;
    if (!setup(?y, FIRST_RULE, true)) { ret 8; }
    fin { teardown(?y); }
    val again: res[mf.Function, Error] = selected(?y);
    if (sel again.err) { ret 9; }
    var g: mf.Function = again.ok;
    fin { mf.dnit(?g); }
    if (!is_row(?g, 0, 2, MULX)) { ret 10; }
    ret 0;
}

test select__an_expansion_of_several_instructions_is_emitted_in_order {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact] {\n^entry(%x: i32):\n    %n = neg %x\n    ret %n\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.err) { ret 2; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # the entry's copy, then the expansion
    if (listed(?f, 0).size != 4)                            { ret 3; }
    if (!is_row(?f, 0, 1, XORI) || !is_row(?f, 0, 2, ADDI)) { ret 4; }
    val ones: opt[i64] = immediate_at(?f, 0, 1, 2);
    val one:  opt[i64] = immediate_at(?f, 0, 2, 2);
    if (!(sel ones.some && ones.some == -1) || !(sel one.some && one.some == 1)) { ret 5; }
    # the temporary the first writes is the one the second reads, and the result is returned
    val temp: u32 = virtual_at(?f, 0, 1, 0);
    if (temp != virtual_at(?f, 0, 2, 1))                    { ret 6; }
    if (temp == virtual_at(?f, 0, 2, 0))                    { ret 6; }
    if (virtual_at(?f, 0, 2, 0) != virtual_at(?f, 0, 3, 0)) { ret 7; }
    if (virtual_at(?f, 0, 1, 1) == virtual_at(?f, 0, 2, 0)) { ret 7; }
    ret 0;
}

# whether a block's copies, run one after another, leave each of `dests`
# holding the value the other held before
#[testing]
fun swaps(f: *mf.Function, b: u32, p: u32, q: u32) bool {
    var held: [16]u32;
    var k:    u32 = 0;
    for (k < 16) {
        held[k] = k;
        k       = k + 1;
    }
    val list: Slice[Instruction] = listed(f, b);
    var i:    usize              = 0;
    for (i < list.size) {
        val d: *InstructionData = mf.data(f, list.data[i]);
        if (sel d.opcode.pseudo && d.opcode.pseudo == pseudo.COPY) {
            val to:   u32 = virtual_at(f, b, i, 0);
            val from: u32 = virtual_at(f, b, i, 1);
            if (to >= 16 || from >= 16) { ret false; }
            held[to] = held[from];
        }
        i = i + 1;
    }
    ret held[p] == q && held[q] == p;
}

test select__block_arguments_become_parallel_copies_that_respect_a_swap {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%a: i32, %b: i32):\n    br ^loop(%a, %b)\n^loop(%x: i32, %y: i32):\n    br ^loop(%y, %x)\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.err) { ret 2; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # the parameters out of their registers, then the edge's copy, which has
    # no cycle: two copies then the jump
    if (listed(?f, 0).size != 5 || !is_row(?f, 0, 4, J) || block_at(?f, 0, 4, 0) != 1) { ret 3; }
    val p: u32 = virtual_at(?f, 0, 2, 0);
    val q: u32 = virtual_at(?f, 0, 3, 0);
    if (p == q) { ret 3; }
    # the swap needs a temporary: three copies then the jump back
    if (listed(?f, 1).size != 4 || !is_row(?f, 1, 3, J) || block_at(?f, 1, 3, 0) != 1) { ret 4; }
    if (!swaps(?f, 1, p, q))                                                           { ret 5; }
    ret 0;
}

test select__an_operation_with_no_rule_is_refused {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%x: i32, %y: i32):\n    %q = div.s %x, %y\n    ret %q\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.ok) {
        var f: mf.Function = got.ok;
        mf.dnit(?f);
        ret 2;
    }
    val e: Error = got.err;
    if (!(sel e.unmatched)) { ret 3; }
    val u: engine.Unmatched = e.unmatched;
    if (!(sel u.operation.opcode && u.operation.opcode.index == ir.DIV_S.index)) { ret 4; }
    val i32: res[Type, types.Error] = types.intern(?x.m.types, types.Shape.integer{types.Integer{width: 32}});
    if (sel i32.err)                                                                                                      { ret 5; }
    if (u.operand_count != 2 || u.result_count != 1)                                                                      { ret 6; }
    if (u.operands[0].index != i32.ok.index || u.operands[1].index != i32.ok.index || u.results[0].index != i32.ok.index) { ret 6; }
    ret 0;
}

test select__a_comparison_whose_only_use_is_a_branch_is_matched_with_it {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%x: i32, %y: i32):\n    %c = lt.s %x, %y\n    cbr %c, ^then, ^else\n^then:\n    ret %x\n^else:\n    ret %y\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.err) { ret 2; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # the parameters' copies, one compare-and-branch to the first target and a jump to the second
    if (listed(?f, 0).size != 4 || !is_row(?f, 0, 2, BLT) || !is_row(?f, 0, 3, J)) { ret 3; }
    if (block_at(?f, 0, 2, 2) != 1 || block_at(?f, 0, 3, 0) != 2)                  { ret 4; }
    # no register holds the condition: the only virtual registers are the parameters
    if (f.virtuals.len != 2)                                                                                      { ret 5; }
    if (virtual_at(?f, 0, 2, 0) != virtual_at(?f, 1, 0, 0) || virtual_at(?f, 0, 2, 1) != virtual_at(?f, 2, 0, 0)) { ret 6; }
    ret 0;
}

# a pure instruction every use of which is a pattern is read by each and emitted
# by none, and a load read the same way is selected once, never repeated
test select__a_shared_node_is_repeated_in_each_pattern_only_when_it_is_pure {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%x: i32, %y: i32):\n    %n = neg %x\n    %a = add %n, %y\n    %b = add %n, %y\n    %c = add %a, %b\n    ret %c\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.err) { ret 2; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # two copies, the three adds and the return, no negation
    if (listed(?f, 0).size != 6) { ret 3; }

    var y: Fixture;
    if (!setup(?y, "target \"riscv64-linux\"\nfunction @f: fun(ptr, i32) -> (i32) linkage global visibility default placed [register 0 0 fixed exact, register 0 1 fixed exact] {\n^entry(%p: ptr, %y: i32):\n    %v = load %p, type i32, align 4\n    %a = add %v, %y\n    %b = add %v, %y\n    %c = add %a, %b\n    ret %c\n}\n", false)) { ret 4; }
    fin { teardown(?y); }
    val again: res[mf.Function, Error] = selected(?y);
    if (sel again.err) { ret 5; }
    var g: mf.Function = again.ok;
    fin { mf.dnit(?g); }
    # two copies, the one load, the three adds and the return
    if (listed(?g, 0).size != 7) { ret 6; }
    ret 0;
}

# selection over the test table with other holds, which the target refuses
#[testing]
fun refused(a: *allocator.Allocator, holds: *rule.Hold, len: u32) res[Selector, Error] {
    page.make(a);
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none) { ret res[Selector, Error].err{Error.removed{id.Value{index: 0}}}; }
    var t: Table = T_TABLE;
    t.holds = rule.Holds{at: holds, len: len};
    ret engine.init(a, ?t, row.some, ?T_SET, nil);
}

#[testing]
val OVERLAPPING: [4]rule.Hold = [4]rule.Hold{
    rule.Hold{class: Class.integer{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
    rule.Hold{class: Class.pointer{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
    rule.Hold{class: Class.width{64}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
    rule.Hold{class: Class.float{}, holder: rule.Holder.hardware{?T_CLASSES[0]}},
};

test select__a_type_two_holds_admit_is_refused_naming_both {
    var a:    allocator.Allocator;
    val made: res[Selector, Error] = refused(?a, ?OVERLAPPING[0], 4);
    if (!(sel made.err)) { ret 1; }
    val e: Error = made.err;
    if (!(sel e.reach)) { ret 2; }
    val r: reach.Refusal = e.reach;
    if (!(sel r.overlap)) { ret 3; }
    val o: reach.Overlap = r.overlap;
    val t: Reach         = o.reach;
    if (!(sel t.integer))                                 { ret 4; }
    if (t.integer != 64 || o.first != 0 || o.second != 2) { ret 5; }
    ret 0;
}

test select__a_reached_type_no_hold_admits_is_refused {
    var a:    allocator.Allocator;
    val made: res[Selector, Error] = refused(?a, ?T_HOLDS[0], 2);
    if (!(sel made.err)) { ret 1; }
    val e: Error = made.err;
    if (!(sel e.reach)) { ret 2; }
    val r: reach.Refusal = e.reach;
    if (!(sel r.uncovered)) { ret 3; }
    val t: Reach = r.uncovered;
    if (!(sel t.float)) { ret 4; }
    ret 0;
}

# an entry whose parameters nothing placed is refused, naming its function
test select__an_entry_whose_parameters_are_not_placed_is_refused {
    var x: Fixture;
    if (!setup(?x, "target \"riscv64-linux\"\nfunction @f: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    %n = neg %x\n    ret %n\n}\n", false)) { ret 1; }
    fin { teardown(?x); }
    val got: res[mf.Function, Error] = selected(?x);
    if (sel got.ok) {
        var f: mf.Function = got.ok;
        mf.dnit(?f);
        ret 2;
    }
    val e: Error = got.err;
    if (!(sel e.unplaced))             { ret 3; }
    if (e.unplaced.index != x.f.index) { ret 4; }
    ret 0;
}
