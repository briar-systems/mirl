#[testing]
val E_LI:   [1]Emit = [1]Emit{Emit{opcode: Opcode.row{?T_ROWS[9]}, operands: Sources{at: ?S_LI[0], len: 2}}};

#[testing]
var N_MUL:   [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_ADD:   [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_ADDI:  [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 2}};
#[testing]
var N_NEG:   [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_FUSED: [2]Node = [2]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_CBR:   [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_LT:    [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_BR:    [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};
#[testing]
var N_RET:   [1]Node = [1]Node{Node{opcode: ir.Opcode{index: 0}, parent: 0, operand: 0, result: 0, constants: 0}};

# give the pattern nodes their opcodes, set at run time since a record
# constant of another module is no constant expression
#[testing]
fun opcodes() {
    N_MUL[0].opcode   = ir.MUL;
    N_ADD[0].opcode   = ir.ADD;
    N_ADDI[0].opcode  = ir.ADD;
    N_NEG[0].opcode   = ir.NEG;
    N_FUSED[0].opcode = ir.CBR;
    N_FUSED[1].opcode = ir.LT_S;
    N_CBR[0].opcode   = ir.CBR;
    N_LT[0].opcode    = ir.LT_S;
    N_BR[0].opcode    = ir.BR;
    N_RET[0].opcode   = ir.RET;
}

