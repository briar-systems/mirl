#[testing]
val T_BRANCH: [3]mo.Operand = [3]mo.Operand{R, R, B};
#[testing]
val T_TEST:   [2]mo.Operand = [2]mo.Operand{R, B};
#[testing]
val T_JUMP:   [1]mo.Operand = [1]mo.Operand{B};
#[testing]
