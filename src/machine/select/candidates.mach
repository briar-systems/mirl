# the rules an instruction can match, found by what defines its operands and
# by the type of the value its rules' type tests most often read
#
# rules are grouped by the opcode of their root, and each group is split by
# what its rules ask of the root's first two operands: a constant, or the
# result of an instruction of an opcode, which a child node covers. a group
# is split again by the type of its key, the operand or result of the root
# the type tests of most of its rules read, by the classes those tests name.
# an instruction looks up its opcode, the shapes of those two operands and
# the type of its key, and reads one list of rules, those of its group whose
# pattern can match it and whose tests of the key can hold, in the group's
# order: by cost, the least first, and rules of one cost in table order. the
# lists only drop rules `matches` or a type test of `guard` would refuse, so
# the first rule of a list that matches and holds is the first of the group.
#
# a type is read through its atom: the classes the tests name split every
# type into atoms, and each class holds of every type of an atom or of none.
# an integer of a width some test names is an atom of its own, as is a float
# of a format some test names, and every other integer, float, pointer or
# kind of type falls into one atom per kind, a vector into one per atom of
# its lanes. a class a test names holds of an atom as it holds of its types,
# so whether a rule's tests of the key can hold is known for each atom once.
#
# a root whose algebra commutes matches its two operands either way round, so
# each of its lists holds the rules that stand either way, and a key that is
# one of those two operands is read of both, an atom only when both are of
# it. the lists and the atoms are built once per build from the table.
#
# the constant rules are one group of their own, with no shapes, keyed by the
# constant they build.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.fold.algebra;
use mirl.ir.opcode.row;
use mirl.ir.opcode.rule.Class;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.machine.select.rule.Node;
use mirl.machine.select.rule.Ref;
use mirl.machine.select.rule.Rule;
use mirl.machine.select.rule.Rules;
use mirl.machine.select.rule.Slot;
use mirl.machine.select.rule.Test;

# the shape of an operand no rule of a group asks about
pub val ANY: u32 = 0;
# the shape of a constant operand
pub val CONSTANT: u32 = 1;

val FIRST_OPCODE: u32 = 2;

# a group with no key, or a key whose type is of no atom
pub val NONE: u32 = 0xffffffff;
# the key of operand k of the root is k, of result k is RESULTS + k, and the
# constant a constant rule builds is BUILT
pub val RESULTS: u32 = 16;
pub val BUILT:   u32 = 32;

val KEYS: u32 = 33;

# how the rules of one root opcode are split by the shapes they ask of its
# first two operands, class 0 of each being every shape they do not ask, and
# by the atom of its key, class 0 being every rule
# ---
# left:   where the shapes asked of operand 0 start in `keys`
# lefts:  how many there are
# right:  where the shapes asked of operand 1 start in `keys`
# rights: how many there are
# key:    the operand or result whose type the split reads, NONE for none
# paired: the key is operand 0 of a root that commutes, read of operands 0
#         and 1 alike
# types:  where the class of each atom starts in `types`
# kinds:  how many classes of atom there are, 1 for a group with no key
# cells:  where its kinds * (lefts + 1) * (rights + 1) lists start in `starts`
pub rec Split {
    left:   u32;
    lefts:  u32;
    right:  u32;
    rights: u32;
    key:    u32;
    paired: bool;
    types:  u32;
    kinds:  u32;
    cells:  u32;
}

# the rule lists of a table
# ---
# splits:  per ir opcode, how its rules are split, or one split of every
#          constant rule
# keys:    the shapes each split asks
# widths:  the integer widths the table's tests name, each an atom
# formats: the float formats the table's tests name, each an atom
# types:   per keyed split, the class of each atom
# starts:  where each list starts in `rules`, then one past the last list
# rules:   the rule indices of every list, each in its group's order
# swaps:   per rule, one bit per node whose operands commute, which selects the
#          ways round it is tried
pub rec Candidates {
    splits:  vector.Vector[Split];
    keys:    vector.Vector[u32];
    widths:  vector.Vector[u32];
    formats: vector.Vector[u32];
    types:   vector.Vector[u32];
    starts:  vector.Vector[u32];
    rules:   vector.Vector[u32];
    swaps:   vector.Vector[u32];
}

# the shape of an operand a result of an instruction of opcode `op` defines
pub fun defined_by(op: row.Opcode) u32 {
    ret op + FIRST_OPCODE;
}

# how many atoms are not vectors: an integer of each width named, of another
# whole number of bytes and of any other width, a float of each format named
# and of any other, a pointer, a function, a structure, an array, and every
# other type
fun lanes(c: *Candidates) u32 {
    ret c.widths.len::u32 + c.formats.len::u32 + 8;
}

# how many atoms there are: those that are not vectors, then a vector of each
fun atoms(c: *Candidates) u32 {
    ret lanes(c) * 2;
}

fun integer_other(c: *Candidates) u32 {
    ret c.widths.len::u32;
}

fun float_first(c: *Candidates) u32 {
    ret c.widths.len::u32 + 2;
}

fun float_other(c: *Candidates) u32 {
    ret float_first(c) + c.formats.len::u32;
}

fun pointer_atom(c: *Candidates) u32 {
    ret float_other(c) + 1;
}

# the atom of a type that is no vector, NONE for a vector
fun plain(c: *Candidates, s: *type_table.Shape) u32 {
    if (sel s.integer) {
        var i: usize = 0;
        for (i < c.widths.len) {
            if (c.widths.data[i] == s.integer.width) { ret i::u32; }
            i = i + 1;
        }
        if (s.integer.width % 8 == 0) { ret integer_other(c); }
        ret integer_other(c) + 1;
    }
    if (sel s.float) {
        var i: usize = 0;
        for (i < c.formats.len) {
            if (c.formats.data[i] == s.float.format) { ret float_first(c) + i::u32; }
            i = i + 1;
        }
        ret float_other(c);
    }
    if (sel s.pointer)   { ret pointer_atom(c); }
    if (sel s.function)  { ret pointer_atom(c) + 1; }
    if (sel s.structure) { ret pointer_atom(c) + 2; }
    if (sel s.array)     { ret pointer_atom(c) + 3; }
    if (sel s.vector)    { ret NONE; }
    ret pointer_atom(c) + 4;
}

# the atom of a type, NONE for one the table refuses or a vector of vectors
# ---
# c:  the lists
# t:  the type table the type is of
# ty: the type
pub fun atom_of(c: *Candidates, t: *type_table.Table, ty: Type) u32 {
    val got: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel got.err) { ret NONE; }
    val s: *type_table.Shape = got.ok;
    if (!(sel s.vector)) { ret plain(c, s); }
    val lane: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, s.vector.element);
    if (sel lane.err) { ret NONE; }
    val e: u32 = plain(c, lane.ok);
    if (e == NONE) { ret NONE; }
    ret lanes(c) + e;
}

# whether a class holds of the types of an atom, as `check.within` holds of
# each of them
fun within(c: *Candidates, class: Class, atom: u32) bool {
    val integer: bool = atom < float_first(c);
    val float:   bool = atom >= float_first(c) && atom <= float_other(c);
    if (sel class.any)       { ret true; }
    if (sel class.integer)   { ret integer; }
    if (sel class.width)     { ret atom < integer_other(c) && c.widths.data[atom] == class.width; }
    if (sel class.float)     { ret float; }
    if (sel class.format)    { ret atom >= float_first(c) && atom < float_other(c) && c.formats.data[atom - float_first(c)] == class.format; }
    if (sel class.pointer)   { ret atom == pointer_atom(c); }
    if (sel class.function)  { ret atom == pointer_atom(c) + 1; }
    if (sel class.bytes)     { ret (atom < integer_other(c) && c.widths.data[atom] % 8 == 0) || atom == integer_other(c); }
    if (sel class.vector)    { ret atom >= lanes(c); }
    if (sel class.scalar)    { ret atom <= pointer_atom(c); }
    if (sel class.structure) { ret atom == pointer_atom(c) + 2; }
    if (sel class.array)     { ret atom == pointer_atom(c) + 3; }
    if (sel class.aggregate) { ret atom == pointer_atom(c) + 2 || atom == pointer_atom(c) + 3; }
    ret false;
}

# whether a type test can hold of the types of an atom, its width aside
fun passes(c: *Candidates, t: *Test, atom: u32) bool {
    if (!t.lanes)          { ret within(c, t.class, atom); }
    if (atom < lanes(c))   { ret false; }
    ret within(c, t.class, atom - lanes(c));
}

# the key a reference names, NONE for one of a node past the root
fun key_of(r: Ref) u32 {
    if (sel r.operand) {
        val s: Slot = r.operand;
        if (s.node == 0 && s.index::u32 < RESULTS) { ret s.index::u32; }
    }
    if (sel r.result) {
        val s: Slot = r.result;
        if (s.node == 0 && s.index::u32 < BUILT - RESULTS) { ret RESULTS + s.index::u32; }
    }
    if (sel r.constant) { ret BUILT; }
    ret NONE;
}

# the key a test reads under a split's pairing
fun tested(t: *Test, paired: bool) u32 {
    val k: u32 = key_of(t.at);
    if (paired && k == 1) { ret 0; }
    ret k;
}

# whether every type test of a rule that reads the key can hold of an atom
fun typed(c: *Candidates, r: *Rule, key: u32, paired: bool, atom: u32) bool {
    var t: u32 = 0;
    for (t < r.tests.len) {
        val test: *Test = ?r.tests.at[t];
        if (tested(test, paired) == key && !passes(c, test, atom)) { ret false; }
        t = t + 1;
    }
    ret true;
}

fun name(c: *Candidates, class: Class) err[allocator.Error] {
    if (sel class.width) {
        var i: usize = 0;
        for (i < c.widths.len) {
            if (c.widths.data[i] == class.width) { ret err[allocator.Error].ok{}; }
            i = i + 1;
        }
        ret push(?c.widths, class.width);
    }
    if (sel class.format) {
        var i: usize = 0;
        for (i < c.formats.len) {
            if (c.formats.data[i] == class.format) { ret err[allocator.Error].ok{}; }
            i = i + 1;
        }
        ret push(?c.formats, class.format);
    }
    ret err[allocator.Error].ok{};
}

# the widths and formats every test of the rules names
fun named(c: *Candidates, rules: Rules) err[allocator.Error] {
    var i: u32 = 0;
    for (i < rules.len) {
        val r: *Rule = ?rules.at[i];
        var t: u32   = 0;
        for (t < r.tests.len) {
            val done: err[allocator.Error] = name(c, r.tests.at[t].class);
            if (sel done.err) { ret done; }
            t = t + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the key the tests of most rules of a group read, the first of those
# keys, NONE where no rule tests one
fun keyed(rules: Rules, group: *u32, n: u32, paired: bool) u32 {
    var counts: [KEYS]u32;
    var i:      u32 = 0;
    for (i < n) {
        val r:    *Rule = ?rules.at[group[i]];
        var seen: u64   = 0;
        var t:    u32   = 0;
        for (t < r.tests.len) {
            val k: u32 = tested(?r.tests.at[t], paired);
            if (k != NONE && ((seen >> k::u64) & 1) == 0) {
                seen      = seen | (1u64 << k::u64);
                counts[k] = counts[k] + 1;
            }
            t = t + 1;
        }
        i = i + 1;
    }
    var best: u32 = NONE;
    var most: u32 = 0;
    var k:    u32 = 0;
    for (k < KEYS) {
        if (counts[k] > most) {
            most = counts[k];
            best = k;
        }
        k = k + 1;
    }
    ret best;
}

# whether two atoms admit the same rules of a group by their key
fun alike(c: *Candidates, rules: Rules, group: *u32, n: u32, s: *Split, a: u32, b: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        val r: *Rule = ?rules.at[group[i]];
        if (typed(c, r, s.key, s.paired, a) != typed(c, r, s.key, s.paired, b)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether an atom admits every rule of a group by its key
fun admits_all(c: *Candidates, rules: Rules, group: *u32, n: u32, s: *Split, a: u32) bool {
    var i: u32 = 0;
    for (i < n) {
        if (!typed(c, ?rules.at[group[i]], s.key, s.paired, a)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the class of each atom of a keyed split, class 0 for an atom that admits
# every rule, each other class led by the first atom of it in `firsts`
fun classify(c: *Candidates, rules: Rules, group: *u32, n: u32, s: *Split, firsts: *vector.Vector[u32]) err[allocator.Error] {
    vector.clear[u32](firsts);
    val zero: err[allocator.Error] = push(firsts, NONE);
    if (sel zero.err) { ret zero; }
    s.types = c.types.len::u32;
    var a: u32 = 0;
    for (a < atoms(c)) {
        var class: u32 = 0;
        if (!admits_all(c, rules, group, n, s, a)) {
            class = 1;
            for (class::usize < firsts.len && !alike(c, rules, group, n, s, a, firsts.data[class])) {
                class = class + 1;
            }
            if (class::usize == firsts.len) {
                val led: err[allocator.Error] = push(firsts, a);
                if (sel led.err) { ret led; }
            }
        }
        val kept: err[allocator.Error] = push(?c.types, class);
        if (sel kept.err) { ret kept; }
        a = a + 1;
    }
    s.kinds = firsts.len::u32;
    ret err[allocator.Error].ok{};
}

fun class_in(c: *Candidates, from: u32, n: u32, shape: u32) u32 {
    if (shape == ANY) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        if (c.keys.data[from + i] == shape) { ret i + 1; }
        i = i + 1;
    }
    ret 0;
}

# how an instruction of opcode index `op` is keyed, the split itself, which
# names the key and whether it is paired
pub fun split_of(c: *Candidates, op: u32) *Split {
    ret ?c.splits.data[op];
}

# the list for an instruction of opcode index `op`, whose first two operands
# have the shapes `left` and `right` and whose key is of atom `atom`, NONE
# where it has no key or none of an atom, as its position in `starts`
pub fun list(c: *Candidates, op: u32, left: u32, right: u32, atom: u32) u32 {
    val s:    *Split = ?c.splits.data[op];
    var kind: u32    = 0;
    if (atom != NONE && s.key != NONE) { kind = c.types.data[s.types + atom]; }
    ret s.cells + (kind * (s.lefts + 1) + class_in(c, s.left, s.lefts, left)) * (s.rights + 1) + class_in(c, s.right, s.rights, right);
}

# sort rule indices by their rules' cost, keeping indices of one cost in the
# order given, by a merge of ever longer runs
# ---
# rules:   the rules the indices name
# list:    the indices
# n:       how many there are
# scratch: room for n indices
fun by_cost(rules: Rules, list: *u32, n: usize, scratch: *u32) {
    var from: *u32  = list;
    var to:   *u32  = scratch;
    var run:  usize = 1;
    for (run < n) {
        var lo: usize = 0;
        for (lo < n) {
            var mid: usize = lo + run;
            if (mid > n) { mid = n; }
            var hi: usize = mid + run;
            if (hi > n) { hi = n; }
            var l: usize = lo;
            var r: usize = mid;
            var k: usize = lo;
            for (k < hi) {
                if (l < mid && (r >= hi || rules.at[from[l]].cost <= rules.at[from[r]].cost)) {
                    to[k] = from[l];
                    l     = l + 1;
                }
                or {
                    to[k] = from[r];
                    r     = r + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        val swap: *u32 = from;
        from = to;
        to   = swap;
        run  = run * 2;
    }
    if (from != list) {
        var k: usize = 0;
        for (k < n) {
            list[k] = from[k];
            k       = k + 1;
        }
    }
}

# one bit per node of a rule whose operands commute
fun commutative(r: *Rule) u32 {
    var mask: u32 = 0;
    var i:    u32 = 0;
    for (i < r.nodes.len) {
        if (algebra.algebra(r.nodes.at[i].opcode).commutative) { mask = mask | (1u32 << i); }
        i = i + 1;
    }
    ret mask;
}

# the shape a rule asks of operand `slot` of its root, ANY for none
fun asked(r: *Rule, slot: u32) u32 {
    if (r.nodes.len == 0) { ret ANY; }
    var i: u32 = 1;
    for (i < r.nodes.len) {
        val n: *Node = ?r.nodes.at[i];
        if (n.parent == 0 && n.operand::u32 == slot) { ret defined_by(n.opcode); }
        i = i + 1;
    }
    if (((r.nodes.at[0].constants >> slot) & 1) != 0) { ret CONSTANT; }
    ret ANY;
}

fun stands(ask: u32, shape: u32) bool {
    ret ask == ANY || ask == shape;
}

# whether a rule can match operands of the shapes `left` and `right`, either
# way round when `swapped` says its root commutes
fun admits(r: *Rule, swapped: bool, left: u32, right: u32) bool {
    val a: u32 = asked(r, 0);
    val b: u32 = asked(r, 1);
    if (stands(a, left) && stands(b, right)) { ret true; }
    ret swapped && stands(a, right) && stands(b, left);
}

fun push(v: *vector.Vector[u32], x: u32) err[allocator.Error] {
    val p: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel p.err) { ret err[allocator.Error].err{p.err}; }
    ret err[allocator.Error].ok{};
}

# `shape` added to the keys from `from` on, once
fun gather(c: *Candidates, from: u32, shape: u32) err[allocator.Error] {
    if (shape == ANY) { ret err[allocator.Error].ok{}; }
    var i: u32 = from;
    for (i::usize < c.keys.len) {
        if (c.keys.data[i] == shape) { ret err[allocator.Error].ok{}; }
        i = i + 1;
    }
    ret push(?c.keys, shape);
}

# the shapes `group` asks of operand `slot`, and of the other when a rule's
# root commutes, added to the keys from `from` on
fun gather_all(c: *Candidates, rules: Rules, group: *u32, n: u32, from: u32, slot: u32) err[allocator.Error] {
    var i: u32 = 0;
    for (i < n) {
        val r:    *Rule                = ?rules.at[group[i]];
        val here: err[allocator.Error] = gather(c, from, asked(r, slot));
        if (sel here.err) { ret here; }
        if ((c.swaps.data[group[i]] & 1) != 0) {
            val there: err[allocator.Error] = gather(c, from, asked(r, 1 - slot));
            if (sel there.err) { ret there; }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the shape of class `k` of the `n` keys from `from`
fun shape_of(c: *Candidates, from: u32, k: u32) u32 {
    if (k == 0) { ret ANY; }
    ret c.keys.data[from + k - 1];
}

# the split of `group`, the `n` rule indices of one root opcode in their order
fun split(c: *Candidates, rules: Rules, group: *u32, n: u32, firsts: *vector.Vector[u32]) err[allocator.Error] {
    val left:   u32                  = c.keys.len::u32;
    val lefted: err[allocator.Error] = gather_all(c, rules, group, n, left, 0);
    if (sel lefted.err) { ret lefted; }
    val right:   u32                  = c.keys.len::u32;
    val righted: err[allocator.Error] = gather_all(c, rules, group, n, right, 1);
    if (sel righted.err) { ret righted; }
    var paired: bool = false;
    if (n > 0) { paired = (c.swaps.data[group[0]] & 1) != 0; }
    var s: Split = Split{left: left, lefts: right - left, right: right, rights: c.keys.len::u32 - right, key: keyed(rules, group, n, paired), paired: paired, types: 0, kinds: 1, cells: c.starts.len::u32};
    if (s.key != 0) { s.paired = false; }
    vector.clear[u32](firsts);
    if (s.key != NONE) {
        val classed: err[allocator.Error] = classify(c, rules, group, n, ?s, firsts);
        if (sel classed.err) { ret classed; }
    }
    var kind: u32 = 0;
    for (kind < s.kinds) {
        var l: u32 = 0;
        for (l <= s.lefts) {
            var w: u32 = 0;
            for (w <= s.rights) {
                val opened: err[allocator.Error] = push(?c.starts, c.rules.len::u32);
                if (sel opened.err) { ret opened; }
                var i: u32 = 0;
                for (i < n) {
                    val r:       *Rule = ?rules.at[group[i]];
                    val swapped: bool  = (c.swaps.data[group[i]] & 1) != 0;
                    if (admits(r, swapped, shape_of(c, s.left, l), shape_of(c, s.right, w)) && (kind == 0 || typed(c, r, s.key, s.paired, firsts.data[kind]))) {
                        val kept: err[allocator.Error] = push(?c.rules, group[i]);
                        if (sel kept.err) { ret kept; }
                    }
                    i = i + 1;
                }
                w = w + 1;
            }
            l = l + 1;
        }
        kind = kind + 1;
    }
    val p: res[usize, allocator.Error] = vector.push[Split](?c.splits, s);
    if (sel p.err) { ret err[allocator.Error].err{p.err}; }
    ret err[allocator.Error].ok{};
}

fun zeroed(v: *vector.Vector[u32], n: usize) err[allocator.Error] {
    ret slice.fill[u32](v, n, 0);
}

fun fill(c: *Candidates, a: *allocator.Allocator, rules: Rules, count: u32) err[allocator.Error] {
    var first:   vector.Vector[u32] = vector.init[u32](a);
    var cursor:  vector.Vector[u32] = vector.init[u32](a);
    var order:   vector.Vector[u32] = vector.init[u32](a);
    var scratch: vector.Vector[u32] = vector.init[u32](a);
    var firsts:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?first);
        vector.dnit[u32](?cursor);
        vector.dnit[u32](?order);
        vector.dnit[u32](?scratch);
        vector.dnit[u32](?firsts);
    }
    val names: err[allocator.Error] = named(c, rules);
    if (sel names.err) { ret names; }
    val opened: err[allocator.Error] = zeroed(?first, count::usize + 1);
    if (sel opened.err) { ret opened; }
    val moved: err[allocator.Error] = zeroed(?cursor, count::usize);
    if (sel moved.err) { ret moved; }
    val ordered: err[allocator.Error] = zeroed(?order, rules.len::usize);
    if (sel ordered.err) { ret ordered; }
    val roomed: err[allocator.Error] = zeroed(?scratch, rules.len::usize);
    if (sel roomed.err) { ret roomed; }
    var i: u32 = 0;
    for (i < rules.len) {
        val op: u32 = rules.at[i].nodes.at[0].opcode;
        first.data[op + 1] = first.data[op + 1] + 1;
        val swapped: err[allocator.Error] = push(?c.swaps, commutative(?rules.at[i]));
        if (sel swapped.err) { ret swapped; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        first.data[i + 1] = first.data[i + 1] + first.data[i];
        i                 = i + 1;
    }
    i = 0;
    for (i < rules.len) {
        val op: u32 = rules.at[i].nodes.at[0].opcode;
        order.data[first.data[op] + cursor.data[op]] = i;
        cursor.data[op]                              = cursor.data[op] + 1;
        i                                            = i + 1;
    }
    i = 0;
    for (i < count) {
        val n: u32 = first.data[i + 1] - first.data[i];
        by_cost(rules, ?order.data[first.data[i]], n::usize, scratch.data);
        val made: err[allocator.Error] = split(c, rules, ?order.data[first.data[i]], n, ?firsts);
        if (sel made.err) { ret made; }
        i = i + 1;
    }
    ret push(?c.starts, c.rules.len::u32);
}

# the one group of every constant rule, by cost, split by the atom of the
# constant they build
fun fill_constants(c: *Candidates, a: *allocator.Allocator, rules: Rules) err[allocator.Error] {
    var order:   vector.Vector[u32] = vector.init[u32](a);
    var scratch: vector.Vector[u32] = vector.init[u32](a);
    var firsts:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?order);
        vector.dnit[u32](?scratch);
        vector.dnit[u32](?firsts);
    }
    val names: err[allocator.Error] = named(c, rules);
    if (sel names.err) { ret names; }
    val roomed: err[allocator.Error] = zeroed(?scratch, rules.len::usize);
    if (sel roomed.err) { ret roomed; }
    var i: u32 = 0;
    for (i < rules.len) {
        val kept: err[allocator.Error] = push(?order, i);
        if (sel kept.err) { ret kept; }
        val swapped: err[allocator.Error] = push(?c.swaps, commutative(?rules.at[i]));
        if (sel swapped.err) { ret swapped; }
        i = i + 1;
    }
    by_cost(rules, order.data, order.len, scratch.data);
    val made: err[allocator.Error] = split(c, rules, order.data, rules.len, ?firsts);
    if (sel made.err) { ret made; }
    ret push(?c.starts, c.rules.len::u32);
}

fun empty(a: *allocator.Allocator) Candidates {
    ret Candidates{
        splits:  vector.init[Split](a),
        keys:    vector.init[u32](a),
        widths:  vector.init[u32](a),
        formats: vector.init[u32](a),
        types:   vector.init[u32](a),
        starts:  vector.init[u32](a),
        rules:   vector.init[u32](a),
        swaps:   vector.init[u32](a),
    };
}

# give back what `c` holds
pub fun release(c: *Candidates) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, vector.dnit[Split](?c.splits));
    keep(?failed, vector.dnit[u32](?c.keys));
    keep(?failed, vector.dnit[u32](?c.widths));
    keep(?failed, vector.dnit[u32](?c.formats));
    keep(?failed, vector.dnit[u32](?c.types));
    keep(?failed, vector.dnit[u32](?c.starts));
    keep(?failed, vector.dnit[u32](?c.rules));
    keep(?failed, vector.dnit[u32](?c.swaps));
    ret failed;
}

# the lists of a table's rules
# ---
# a:     the allocator they take
# rules: the rules, each root's opcode below `count`
# count: how many ir opcodes there are
pub fun build(a: *allocator.Allocator, rules: Rules, count: u32) res[Candidates, allocator.Error] {
    var c:    Candidates           = empty(a);
    val done: err[allocator.Error] = fill(?c, a, rules, count);
    if (sel done.err) {
        release(?c);
        ret res[Candidates, allocator.Error].err{done.err};
    }
    ret res[Candidates, allocator.Error].ok{c};
}

# the lists of a table's constant rules, one group read as opcode index 0,
# whose shapes are always ANY
# ---
# a:     the allocator they take
# rules: the constant rules
pub fun build_constants(a: *allocator.Allocator, rules: Rules) res[Candidates, allocator.Error] {
    var c:    Candidates           = empty(a);
    val done: err[allocator.Error] = fill_constants(?c, a, rules);
    if (sel done.err) {
        release(?c);
        ret res[Candidates, allocator.Error].err{done.err};
    }
    ret res[Candidates, allocator.Error].ok{c};
}
