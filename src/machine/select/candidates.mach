# the rules an instruction can match, found by what defines its operands
#
# rules are grouped by the opcode of their root, and each group is split by
# what its rules ask of the root's first two operands: a constant, or the
# result of an instruction of an opcode, which a child node covers. an
# instruction looks up its opcode and the shapes of those two operands and
# reads one list of rules, those of its group whose pattern can match it, in
# the group's order: by cost, the least first, and rules of one cost in table
# order. the lists only drop rules `matches` would refuse, so the first rule
# of a list that matches is the first of the group that does.
#
# a root whose algebra commutes matches its two operands either way round, so
# each of its lists holds the rules that stand either way. the lists are built
# once per build, and every rule asks at most two keys of a group's shapes, so
# they stay small beside the table.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.fold.algebra;
use mirl.ir.opcode.row;
use mirl.machine.select.rule.Node;
use mirl.machine.select.rule.Rule;
use mirl.machine.select.rule.Rules;

# the shape of an operand no rule of a group asks about
pub val ANY: u32 = 0;
# the shape of a constant operand
pub val CONSTANT: u32 = 1;

val FIRST_OPCODE: u32 = 2;

# how the rules of one root opcode are split by the shapes they ask of its
# first two operands, class 0 of each being every shape they do not ask
# ---
# left:   where the shapes asked of operand 0 start in `keys`
# lefts:  how many there are
# right:  where the shapes asked of operand 1 start in `keys`
# rights: how many there are
# cells:  where its (lefts + 1) * (rights + 1) lists start in `starts`
pub rec Split {
    left:   u32;
    lefts:  u32;
    right:  u32;
    rights: u32;
    cells:  u32;
}

# the rule lists of a table
# ---
# splits: per ir opcode, how its rules are split
# keys:   the shapes each split asks
# starts: where each list starts in `rules`, then one past the last list
# rules:  the rule indices of every list, each in its group's order
# swaps:  per rule, one bit per node whose operands commute, which selects the
#         ways round it is tried
pub rec Candidates {
    splits: vector.Vector[Split];
    keys:   vector.Vector[u32];
    starts: vector.Vector[u32];
    rules:  vector.Vector[u32];
    swaps:  vector.Vector[u32];
}

# the shape of an operand a result of an instruction of opcode `op` defines
pub fun defined_by(op: row.Opcode) u32 {
    ret op.index + FIRST_OPCODE;
}

fun class_in(c: *Candidates, from: u32, n: u32, shape: u32) u32 {
    if (shape == ANY) { ret 0; }
    var i: u32 = 0;
    for (i < n) {
        if (c.keys.data[from + i] == shape) { ret i + 1; }
        i = i + 1;
    }
    ret 0;
}

# the list for an instruction of opcode index `op`, whose first two operands
# have the shapes `left` and `right`, as its position in `starts`
pub fun list(c: *Candidates, op: u32, left: u32, right: u32) u32 {
    val s: *Split = ?c.splits.data[op];
    ret s.cells + class_in(c, s.left, s.lefts, left) * (s.rights + 1) + class_in(c, s.right, s.rights, right);
}

# sort rule indices by their rules' cost, keeping indices of one cost in the
# order given, by a merge of ever longer runs
# ---
# rules:   the rules the indices name
# list:    the indices
# n:       how many there are
# scratch: room for n indices
pub fun by_cost(rules: Rules, list: *u32, n: usize, scratch: *u32) {
    var from: *u32  = list;
    var to:   *u32  = scratch;
    var run:  usize = 1;
    for (run < n) {
        var lo: usize = 0;
        for (lo < n) {
            var mid: usize = lo + run;
            if (mid > n) { mid = n; }
            var hi: usize = mid + run;
            if (hi > n) { hi = n; }
            var l: usize = lo;
            var r: usize = mid;
            var k: usize = lo;
            for (k < hi) {
                if (l < mid && (r >= hi || rules.at[from[l]].cost <= rules.at[from[r]].cost)) {
                    to[k] = from[l];
                    l     = l + 1;
                }
                or {
                    to[k] = from[r];
                    r     = r + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        val swap: *u32 = from;
        from = to;
        to   = swap;
        run  = run * 2;
    }
    if (from != list) {
        var k: usize = 0;
        for (k < n) {
            list[k] = from[k];
            k       = k + 1;
        }
    }
}

# one bit per node of a rule whose operands commute
fun commutative(r: *Rule) u32 {
    var mask: u32 = 0;
    var i:    u32 = 0;
    for (i < r.nodes.len) {
        if (algebra.algebra(r.nodes.at[i].opcode).commutative) { mask = mask | (1u32 << i); }
        i = i + 1;
    }
    ret mask;
}

# the shape a rule asks of operand `slot` of its root, ANY for none
fun asked(r: *Rule, slot: u32) u32 {
    var i: u32 = 1;
    for (i < r.nodes.len) {
        val n: *Node = ?r.nodes.at[i];
        if (n.parent == 0 && n.operand::u32 == slot) { ret defined_by(n.opcode); }
        i = i + 1;
    }
    if (((r.nodes.at[0].constants >> slot) & 1) != 0) { ret CONSTANT; }
    ret ANY;
}

fun stands(ask: u32, shape: u32) bool {
    ret ask == ANY || ask == shape;
}

# whether a rule can match operands of the shapes `left` and `right`, either
# way round when `swapped` says its root commutes
fun admits(r: *Rule, swapped: bool, left: u32, right: u32) bool {
    val a: u32 = asked(r, 0);
    val b: u32 = asked(r, 1);
    if (stands(a, left) && stands(b, right)) { ret true; }
    ret swapped && stands(a, right) && stands(b, left);
}

fun push(v: *vector.Vector[u32], x: u32) err[allocator.Error] {
    val p: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel p.err) { ret err[allocator.Error].err{p.err}; }
    ret err[allocator.Error].ok{};
}

# `shape` added to the keys from `from` on, once
fun gather(c: *Candidates, from: u32, shape: u32) err[allocator.Error] {
    if (shape == ANY) { ret err[allocator.Error].ok{}; }
    var i: u32 = from;
    for (i::usize < c.keys.len) {
        if (c.keys.data[i] == shape) { ret err[allocator.Error].ok{}; }
        i = i + 1;
    }
    ret push(?c.keys, shape);
}

# the shapes `group` asks of operand `slot`, and of the other when a rule's
# root commutes, added to the keys from `from` on
fun gather_all(c: *Candidates, rules: Rules, group: *u32, n: u32, from: u32, slot: u32) err[allocator.Error] {
    var i: u32 = 0;
    for (i < n) {
        val r:    *Rule                = ?rules.at[group[i]];
        val here: err[allocator.Error] = gather(c, from, asked(r, slot));
        if (sel here.err) { ret here; }
        if ((c.swaps.data[group[i]] & 1) != 0) {
            val there: err[allocator.Error] = gather(c, from, asked(r, 1 - slot));
            if (sel there.err) { ret there; }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the shape of class `k` of the `n` keys from `from`
fun shape_of(c: *Candidates, from: u32, k: u32) u32 {
    if (k == 0) { ret ANY; }
    ret c.keys.data[from + k - 1];
}

# the split of `group`, the `n` rule indices of one root opcode in their order
fun split(c: *Candidates, rules: Rules, group: *u32, n: u32) err[allocator.Error] {
    val left:   u32                  = c.keys.len::u32;
    val lefted: err[allocator.Error] = gather_all(c, rules, group, n, left, 0);
    if (sel lefted.err) { ret lefted; }
    val right:   u32                  = c.keys.len::u32;
    val righted: err[allocator.Error] = gather_all(c, rules, group, n, right, 1);
    if (sel righted.err) { ret righted; }
    val s: Split = Split{left: left, lefts: right - left, right: right, rights: c.keys.len::u32 - right, cells: c.starts.len::u32};
    var l: u32   = 0;
    for (l <= s.lefts) {
        var w: u32 = 0;
        for (w <= s.rights) {
            val opened: err[allocator.Error] = push(?c.starts, c.rules.len::u32);
            if (sel opened.err) { ret opened; }
            var i: u32 = 0;
            for (i < n) {
                val swapped: bool = (c.swaps.data[group[i]] & 1) != 0;
                if (admits(?rules.at[group[i]], swapped, shape_of(c, s.left, l), shape_of(c, s.right, w))) {
                    val kept: err[allocator.Error] = push(?c.rules, group[i]);
                    if (sel kept.err) { ret kept; }
                }
                i = i + 1;
            }
            w = w + 1;
        }
        l = l + 1;
    }
    val p: res[usize, allocator.Error] = vector.push[Split](?c.splits, s);
    if (sel p.err) { ret err[allocator.Error].err{p.err}; }
    ret err[allocator.Error].ok{};
}

fun zeroed(v: *vector.Vector[u32], n: usize) err[allocator.Error] {
    ret slice.fill[u32](v, n, 0);
}

fun fill(c: *Candidates, a: *allocator.Allocator, rules: Rules, count: u32) err[allocator.Error] {
    var first:   vector.Vector[u32] = vector.init[u32](a);
    var cursor:  vector.Vector[u32] = vector.init[u32](a);
    var order:   vector.Vector[u32] = vector.init[u32](a);
    var scratch: vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?first);
        vector.dnit[u32](?cursor);
        vector.dnit[u32](?order);
        vector.dnit[u32](?scratch);
    }
    val opened: err[allocator.Error] = zeroed(?first, count::usize + 1);
    if (sel opened.err) { ret opened; }
    val moved: err[allocator.Error] = zeroed(?cursor, count::usize);
    if (sel moved.err) { ret moved; }
    val ordered: err[allocator.Error] = zeroed(?order, rules.len::usize);
    if (sel ordered.err) { ret ordered; }
    val roomed: err[allocator.Error] = zeroed(?scratch, rules.len::usize);
    if (sel roomed.err) { ret roomed; }
    var i: u32 = 0;
    for (i < rules.len) {
        val op: u32 = rules.at[i].nodes.at[0].opcode.index;
        first.data[op + 1] = first.data[op + 1] + 1;
        val swapped: err[allocator.Error] = push(?c.swaps, commutative(?rules.at[i]));
        if (sel swapped.err) { ret swapped; }
        i = i + 1;
    }
    i = 0;
    for (i < count) {
        first.data[i + 1] = first.data[i + 1] + first.data[i];
        i                 = i + 1;
    }
    i = 0;
    for (i < rules.len) {
        val op: u32 = rules.at[i].nodes.at[0].opcode.index;
        order.data[first.data[op] + cursor.data[op]] = i;
        cursor.data[op]                              = cursor.data[op] + 1;
        i                                            = i + 1;
    }
    i = 0;
    for (i < count) {
        val n: u32 = first.data[i + 1] - first.data[i];
        by_cost(rules, ?order.data[first.data[i]], n::usize, scratch.data);
        val made: err[allocator.Error] = split(c, rules, ?order.data[first.data[i]], n);
        if (sel made.err) { ret made; }
        i = i + 1;
    }
    ret push(?c.starts, c.rules.len::u32);
}

# give back what `c` holds
pub fun release(c: *Candidates) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, vector.dnit[Split](?c.splits));
    keep(?failed, vector.dnit[u32](?c.keys));
    keep(?failed, vector.dnit[u32](?c.starts));
    keep(?failed, vector.dnit[u32](?c.rules));
    keep(?failed, vector.dnit[u32](?c.swaps));
    ret failed;
}

# the lists of a table's rules
# ---
# a:     the allocator they take
# rules: the rules, each root's opcode below `count`
# count: how many ir opcodes there are
pub fun build(a: *allocator.Allocator, rules: Rules, count: u32) res[Candidates, allocator.Error] {
    var c:    Candidates           = Candidates{splits: vector.init[Split](a), keys: vector.init[u32](a), starts: vector.init[u32](a), rules: vector.init[u32](a), swaps: vector.init[u32](a)};
    val done: err[allocator.Error] = fill(?c, a, rules, count);
    if (sel done.err) {
        release(?c);
        ret res[Candidates, allocator.Error].err{done.err};
    }
    ret res[Candidates, allocator.Error].ok{c};
}
