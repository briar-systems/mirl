val NONE: u32 = 0xffffffff;

# a table that breaks the schema
# ---
# rule:     the rule's index in its list
# constant: the rule is a materialisation rule, or the jump when `rule` is NONE
# what:     what it breaks
pub rec Defect {
    rule:     u32;
    constant: bool;
    what:     str;
}

pub val NO_NODES:      str = "rule with no pattern, or a materialisation rule with one";
pub val TOO_MANY:      str = "pattern of more nodes than MAX_NODES";
pub val UNKNOWN_IR:    str = "node of an opcode the ir has no row for";
pub val LATER_PARENT:  str = "node covering an operand of itself or a later node";
pub val NO_OPERAND:    str = "node covering an operand its parent's row does not have";
pub val TWICE:         str = "operand covered by two nodes";
pub val NO_EXPANSION:  str = "rule that emits nothing";
pub val WIDE:          str = "emitted instruction of more operands than a row has";
pub val UNKNOWN_NODE:  str = "reference to a node the pattern does not have";
pub val COVERED_VALUE: str = "register of an operand a node covers";
pub val NO_SUBJECT:    str = "materialisation rule naming a node, or a rule naming the constant";
pub val UNSTATED:      str = "source or reference left unstated";
pub val TEMPORARY:     str = "temporary past MAX_FRESH";
pub val JUMP:          str = "jump that is not one instruction to edge 0";
pub val UNKNOWN_CLASS: str = "class the target's register file does not have";
pub val LATER_PARTNER: str = "partner naming an instruction not before it, or past MAX_FRESH";
pub val UNCARRIED:     str = "loop the set's loops do not hold";
pub val UNORDERED:     str = "ordering read of a node whose row states no ordering immediate";
pub val UNCONVENED:    str = "link, argument or result register the target's convention row does not name";
pub val IMPLIED:       str = "implied register that is neither a fixed one nor one the convention names";
pub val UNROWED:       str = "call under a convention row the target does not state";
pub val UNDESCRIBED:   str = "call to a thread-local descriptor's resolver under a row that states no such call";
pub val POLICY:        str = "class whose holds state two policies";
pub val STATELESS:     str = "instruction stating a configuration state where its groups turn on none, or none where they turn on one";
pub val TWO_BASES:     str = "address naming a value's base and a fixed one";
pub val TABLELESS:     str = "table address in an expansion that emits no table after it, or a table given sources or emitted twice";

# a rule whose loop breaks the constraint its body keeps
# ---
# rule:     the rule's index in its list
# constant: the rule is a materialisation rule
# loop:     the loop
# breach:   how its body breaks the constraint
pub rec Breached {
    rule:     u32;
    constant: bool;
    loop:     *lrow.Loop;
    breach:   lrow.Breach;
}

# what selection was asked to select
# ---
# opcode:   an ir instruction of this opcode
# constant: a constant to materialise into a register
pub tag Operation: u8 {
    opcode: ir.Opcode;
    constant;
}

# an operation no rule matches, a missing rule or a missing legalisation
# ---
# operation:     what it is
# instruction:   the ir instruction, or the one using the constant
# operands:      the types of its first operands, as many as a row fixes
# operand_count: how many operands it has
# results:       the types of its first results, as many as a row states
# result_count:  how many results it has
pub rec Unmatched {
    operation:     Operation;
    instruction:   id.Instruction;
    operands:      [$length_of(ir.Operands)]Type;
    operand_count: u32;
    results:       [$length_of(ir.Results)]Type;
    result_count:  u32;
}

# why selection refused
# ---
# alloc:     the allocator refused storage
# module:    the module refused a read
# types:     the type table refused a read
# table:     the table breaks the schema
# breached:  a loop of the table breaks the constraint its body keeps, so
#            its eventual success is not guaranteed
# unmatched: no rule matches an operation
# unheld:    no class of the table the build meets holds a value of this type
# ambiguous: more than one class of the table the build meets holds a value
#            of this type
# reach:     a type the target reaches has no class or two in the table
# removed:   a value whose definition was removed
# machine:   the machine form refused an instruction the table built
# aggregate: a value of an aggregate type, which no register holds
# unlocated: a register a call clobbers that the locations refused, and why
# placed:    a piece at a place selection does not carry: an entry's
#            parameter at an operand place, which no call form gives it, or a
#            stack piece whose size and offset scale by two scales
# transfer:  a piece form instruction whose expansion neither calls nor returns
# lookup:    the target's thread lookup function, which the module does not
#            have, or the target states no address model to name it
# layout:    the target's layout gives no size for a slot's type
# unplaced:  a function whose entry has parameters the abi legalisation did
#            not place, so nothing says where they arrive
# undecided: a machine instruction whose transfer turns on an operand that
#            names no register yet
# unchecked: a division without the checked mark on a target whose division
#            gives a result for a trap its opcode row states, so no test
#            stands before it
# assembly:  an inline assembly item whose block masc refused, or whose
#            operands the machine form does not bind
pub tag Error: u8 {
    alloc:     allocator.Error;
    module:    module.Error;
    types:     types.Error;
    table:     Defect;
    breached:  Breached;
    unmatched: Unmatched;
    unheld:    Type;
    ambiguous: Type;
    reach:     reach.Refusal;
    removed:   id.Value;
    machine:   mf.Error;
    aggregate: Type;
    unlocated: location.Unlocated;
    placed:    Placed;
    transfer:  id.Instruction;
    lookup;
    layout:    Type;
    unplaced:  id.Function;
    undecided: mi.Undecided;
    unchecked: id.Instruction;
    assembly:  Assembled;
}

# an inline assembly item selection refused
# ---
# instruction: the ir instruction
# refusal:     why its block was refused
pub rec Assembled {
    instruction: id.Instruction;
    refusal:     minline.Refusal;
}

# what call lowering states to the register allocator
# ---
# rows: every convention row of the target resolved for the build, the
#       default first and then the others in the order the target states
#       them, so a call leaves undefined what the row it runs under and its
#       callee name. none for a selection whose calls state no clobbers
# at:   the locations the allocator numbers them by
pub rec Calls {
    rows: Slice[Resolved];
    at:   *Locations;
}

# the calls of a selection that state no clobbers
pub fun unclobbered(at: *Locations) Calls {
    ret Calls{rows: Slice[Resolved]{data: nil, size: 0}, at: at};
}

# a selected function and the clobbers its calls state
# ---
# function: the machine function
# clobbers: one per clobbered register of each call it makes
pub rec Selected {
    function: mf.Function;
    clobbers: vector.Vector[Clobber];
}

# give back a selected function
pub fun release(x: *Selected) err[allocator.Error] {
    var failed: err[allocator.Error] = mf.dnit(?x.function);
    keep(?failed, vector.dnit[Clobber](?x.clobbers));
    ret failed;
}

# a table made ready for one target and instruction set
# ---
# a:          the allocator its index and every selection take
# isa:        the record of the target's instruction set: masc's set, the
#             table and the loops it may emit
# target:     the target, whose capabilities guard hooks read
# context:    the target's selection under its architecture's state, which
#             admits every row
# convention: the registers of the target's default convention row, which
#             a link, argument or result source reads, nil for a selection
#             with no convention row, where a rule naming one of its
#             registers is refused when it emits
# first:      per ir opcode, where its rules start in `order`, one past the last
# order:      the rules' indices grouped by opcode, each group by cost, the
#             least first, and rules of one cost in table order
# constants:  the constant rules' indices in the same order
# inlines:    the inline assembly blocks every selection parsed, which every
#             form of a function after selection names, held until the
#             selector is given back
pub rec Selector {
    a:          *allocator.Allocator;
    isa:        *Isa;
    target:     *Target;
    context:    *core_state.Context;
    convention: *Registers;
    first:      Slice[u32];
    order:      Slice[u32];
    constants:  Slice[u32];
    inlines:    minline.Inlines;
}

# sort rule indices by their rules' cost, keeping indices of one cost in the
# order given, by a merge of ever longer runs
# ---
# rules:   the rules the indices name
# list:    the indices
# n:       how many there are
# scratch: room for n indices
fun by_cost(rules: rule.Rules, list: *u32, n: usize, scratch: *u32) {
    var from: *u32  = list;
    var to:   *u32  = scratch;
    var run:  usize = 1;
    for (run < n) {
        var lo: usize = 0;
        for (lo < n) {
            var mid: usize = lo + run;
            if (mid > n) { mid = n; }
            var hi: usize = mid + run;
            if (hi > n) { hi = n; }
            var l: usize = lo;
            var r: usize = mid;
            var k: usize = lo;
            for (k < hi) {
                if (l < mid && (r >= hi || rules.at[from[l]].cost <= rules.at[from[r]].cost)) {
                    to[k] = from[l];
                    l     = l + 1;
                }
                or {
                    to[k] = from[r];
                    r     = r + 1;
                }
                k = k + 1;
            }
            lo = hi;
        }
        val swap: *u32 = from;
        from = to;
        to   = swap;
        run  = run * 2;
    }
    if (from != list) {
        var k: usize = 0;
        for (k < n) {
            list[k] = from[k];
            k       = k + 1;
        }
    }
}

fun defect(rule: u32, constant: bool, what: str) Error {
    ret Error.table{Defect{rule: rule, constant: constant, what: what}};
}

fun ref_ok(r: Ref, nodes: u32) opt[str] {
    if (sel r.unstated) { ret opt[str].some{UNSTATED}; }
    if (sel r.constant) {
        if (nodes != 0) { ret opt[str].some{NO_SUBJECT}; }
        ret opt[str].none{};
    }
    if (nodes == 0)                                    { ret opt[str].some{NO_SUBJECT}; }
    if (sel r.operand && r.operand.node::u32 >= nodes) { ret opt[str].some{UNKNOWN_NODE}; }
    if (sel r.result && r.result.node::u32 >= nodes)   { ret opt[str].some{UNKNOWN_NODE}; }
    ret opt[str].none{};
}

# whether a node covers operand `at` of node `parent`
fun covered(r: *Rule, parent: u8, at: u8) bool {
    var j: u32 = 1;
    for (j < r.nodes.len) {
        if (r.nodes.at[j].parent == parent && r.nodes.at[j].operand == at) { ret true; }
        j = j + 1;
    }
    ret false;
}

# the register a source names, fixed in masc's file or named by the
# convention's row, none for a source of another kind or one the row does not
# name
fun named(c: *Registers, s: Source) opt[rf.Id] {
    if (sel s.fixed) { ret opt[rf.Id].some{s.fixed}; }
    if (c == nil)    { ret opt[rf.Id].none{}; }
    if (sel s.link)  { ret c.link; }
    var p:    rule.Passed  = rule.Passed{kind: 0, index: 0};
    var bank: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    if (sel s.argument) {
        p    = s.argument;
        bank = convention.bank(?c.passing, p.kind);
    }
    or (sel s.returned) {
        p    = s.returned;
        bank = convention.bank(?c.returning, p.kind);
    }
    or                               { ret opt[rf.Id].none{}; }
    if (p.index::usize >= bank.size) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{bank.data[p.index]};
}

# whether a source names a register of the convention's row
fun convened(s: Source) bool {
    ret sel s.link || sel s.argument || sel s.returned;
}

fun source_ok(file: *rf.File, c: *Registers, r: *Rule, s: Source) opt[str] {
    val n: u32 = r.nodes.len;
    if (sel s.unstated) { ret opt[str].some{UNSTATED}; }
    if (c != nil && convened(s)) {
        val got: opt[rf.Id] = named(c, s);
        if (sel got.none) { ret opt[str].some{UNCONVENED}; }
    }
    if (sel s.value) {
        if (n == 0)                                  { ret opt[str].some{NO_SUBJECT}; }
        if (s.value.node::u32 >= n)                  { ret opt[str].some{UNKNOWN_NODE}; }
        if (covered(r, s.value.node, s.value.index)) { ret opt[str].some{COVERED_VALUE}; }
    }
    if (sel s.tied) {
        if (n == 0)                                            { ret opt[str].some{NO_SUBJECT}; }
        if (s.tied.value.node::u32 >= n)                       { ret opt[str].some{UNKNOWN_NODE}; }
        if (covered(r, s.tied.value.node, s.tied.value.index)) { ret opt[str].some{COVERED_VALUE}; }
    }
    if (sel s.ordered) {
        if (n == 0)                                            { ret opt[str].some{NO_SUBJECT}; }
        if (s.ordered.node::u32 >= n)                          { ret opt[str].some{UNKNOWN_NODE}; }
        if (!match.ordered(r.nodes.at[s.ordered.node].opcode)) { ret opt[str].some{UNORDERED}; }
    }
    if (sel s.address) {
        val a: rule.Addressed = s.address;
        if (n == 0 && (sel a.base.some || sel a.index.some)) { ret opt[str].some{NO_SUBJECT}; }
        if (sel a.base.some && sel a.fixed.some)             { ret opt[str].some{TWO_BASES}; }
        val parts: [2]opt[Slot] = [2]opt[Slot]{a.base, a.index};
        var p:     u32          = 0;
        for (p < 2) {
            val part: opt[Slot] = parts[p];
            if (sel part.some) {
                if (part.some.node::u32 >= n)                    { ret opt[str].some{UNKNOWN_NODE}; }
                if (covered(r, part.some.node, part.some.index)) { ret opt[str].some{COVERED_VALUE}; }
            }
            p = p + 1;
        }
        val f: rule.Factor = a.scale;
        if (sel f.unstated) { ret opt[str].some{UNSTATED}; }
        if (sel f.derived) {
            val bad: opt[str] = ref_ok(f.derived.of, n);
            if (sel bad.some) { ret bad; }
        }
        val d: opt[Ref] = a.disp;
        if (sel d.some) {
            val bad: opt[str] = ref_ok(d.some, n);
            if (sel bad.some) { ret bad; }
        }
        val y: opt[rule.Symbolic] = a.symbol;
        if (sel y.some) { ret ref_ok(y.some.of, n); }
        ret opt[str].none{};
    }
    if (sel s.bits)    { ret ref_ok(s.bits, n); }
    if (sel s.width)   { ret ref_ok(s.width, n); }
    if (sel s.derived) { ret ref_ok(s.derived.of, n); }
    if (sel s.symbol)  { ret ref_ok(s.symbol.of, n); }
    if (sel s.fresh) {
        if (s.fresh.index::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
        ret ref_ok(s.fresh.like, n);
    }
    if (sel s.scratch) {
        if (s.scratch.index::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
        val k: opt[Class] = class.handled(file, s.scratch.class);
        if (sel k.none) { ret opt[str].some{UNKNOWN_CLASS}; }
    }
    if ((sel s.slot || sel s.count || sel s.table) && n == 0) { ret opt[str].some{NO_SUBJECT}; }
    ret opt[str].none{};
}

# whether an emitted instruction is a jump table, whose operands the root's edges give
fun tabled(emit: *Emit) bool {
    val op: mi.Opcode = emit.opcode;
    ret sel op.pseudo && op.pseudo == pseudo.TABLE;
}

# whether a rule's jump tables keep the schema: at most one, given no sources,
# in a rule with a pattern, after every instruction that names its address
fun tables_ok(r: *Rule) opt[str] {
    var table: u32 = NONE;
    var e:     u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (tabled(emit)) {
            if (table != NONE || emit.operands.len != 0) { ret opt[str].some{TABLELESS}; }
            if (r.nodes.len == 0)                        { ret opt[str].some{NO_SUBJECT}; }
            table = e;
        }
        e = e + 1;
    }
    e = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val src: Source = emit.operands.at[k];
            if (sel src.table && (table == NONE || table < e)) { ret opt[str].some{TABLELESS}; }
            k = k + 1;
        }
        e = e + 1;
    }
    ret opt[str].none{};
}

# whether an instruction of an expansion states a configuration state exactly
# where a row it stands for has groups that turn on one
fun stated_where_needed(emit: *Emit) bool {
    var needs: bool = false;
    var k:     u32  = 0;
    for (k < mi.rows_in(emit.opcode)) {
        val n: opt[u32] = vstate.needs(mi.row_in(emit.opcode, k));
        if (sel n.some) { needs = true; }
        k = k + 1;
    }
    val st: opt[vstate.State] = emit.state;
    ret needs == (sel st.some);
}

fun expansion_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.expansion.len == 0) { ret opt[str].some{NO_EXPANSION}; }
    val tables: opt[str] = tables_ok(r);
    if (sel tables.some) { ret tables; }
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (emit.operands.len > rows.MAX_OPERANDS) { ret opt[str].some{WIDE}; }
        val op: mi.Opcode = emit.opcode;
        if (sel op.loop) {
            val bad: opt[str] = lrow.check(op.loop, file);
            if (sel bad.some) { ret bad; }
        }
        if (!stated_where_needed(emit)) { ret opt[str].some{STATELESS}; }
        var k: u32 = 0;
        for (k < emit.operands.len) {
            val s:   Source   = emit.operands.at[k];
            val bad: opt[str] = source_ok(file, c, r, s);
            if (sel bad.some) { ret bad; }
            if (sel s.partner) {
                if (s.partner.emit::u32 >= e || e >= rule.MAX_FRESH) { ret opt[str].some{LATER_PARTNER}; }
            }
            k = k + 1;
        }
        var m: u32 = 0;
        for (m < emit.implied.len) {
            val x: Source = emit.implied.at[m].register;
            if (!(sel x.fixed || convened(x))) { ret opt[str].some{IMPLIED}; }
            if (c != nil && convened(x)) {
                val got: opt[rf.Id] = named(c, x);
                if (sel got.none) { ret opt[str].some{UNCONVENED}; }
            }
            m = m + 1;
        }
        e = e + 1;
    }
    var t: u32 = 0;
    for (t < r.tests.len) {
        val bad: opt[str] = ref_ok(r.tests.at[t].at, r.nodes.len);
        if (sel bad.some) { ret bad; }
        t = t + 1;
    }
    ret opt[str].none{};
}

# whether every loop a rule emits is one of the set's loops and keeps its constraint
fun loops_ok(r: *Rule, carried: *lrow.Loops, index: u32, constant: bool) opt[Error] {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val op: mi.Opcode = r.expansion.at[e].opcode;
        if (sel op.loop) {
            val broken: opt[lrow.Breach] = lrow.constrained(op.loop);
            if (sel broken.some)                 { ret opt[Error].some{Error.breached{Breached{rule: index, constant: constant, loop: op.loop, breach: broken.some}}}; }
            if (!lrow.carries(carried, op.loop)) { ret opt[Error].some{defect(index, constant, UNCARRIED)}; }
        }
        e = e + 1;
    }
    ret opt[Error].none{};
}

# whether a rule keeps the schema
fun rule_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.nodes.len == 0)                                           { ret opt[str].some{NO_NODES}; }
    if (r.nodes.len > rule.MAX_NODES)                               { ret opt[str].some{TOO_MANY}; }
    if (r.orderings != nil && !match.ordered(r.nodes.at[0].opcode)) { ret opt[str].some{UNORDERED}; }
    var i: u32 = 0;
    for (i < r.nodes.len) {
        val n:   *Node       = ?r.nodes.at[i];
        val row: opt[ir.Row] = ir.row(n.opcode);
        if (sel row.none) { ret opt[str].some{UNKNOWN_IR}; }
        if (i > 0) {
            if (n.parent::u32 >= i) { ret opt[str].some{LATER_PARENT}; }
            var parent: opt[ir.Row] = ir.row(r.nodes.at[n.parent].opcode);
            if (sel parent.none)                          { ret opt[str].some{UNKNOWN_IR}; }
            if (n.operand::u32 >= ir.fixed(?parent.some)) { ret opt[str].some{NO_OPERAND}; }
            var j: u32 = 1;
            for (j < i) {
                if (r.nodes.at[j].parent == n.parent && r.nodes.at[j].operand == n.operand) { ret opt[str].some{TWICE}; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret expansion_ok(file, c, r);
}

fun constant_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.nodes.len != 0)   { ret opt[str].some{NO_NODES}; }
    if (r.orderings != nil) { ret opt[str].some{NO_SUBJECT}; }
    ret expansion_ok(file, c, r);
}

fun jump_ok(t: *Table) bool {
    if (t.jump.len != 1) { ret false; }
    val emit: *Emit = ?t.jump.at[0];
    var k:    u32   = 0;
    var aims: u32   = 0;
    for (k < emit.operands.len) {
        val s: Source = emit.operands.at[k];
        if (sel s.target) {
            if (s.target != 0) { ret false; }
            aims = aims + 1;
        }
        or (!(sel s.literal || sel s.fixed)) { ret false; }
        k = k + 1;
    }
    ret aims == 1;
}

# whether every row of the holds naming the class row `i` names states its policy
fun one_policy(holds: rule.Holds, file: *rf.File, i: u32) bool {
    val mine: opt[Class] = rule.holder_class(file, holds.at[i].holder);
    if (sel mine.none) { ret true; }
    val never: bool         = rule.never_spilled(holds, file, mine.some);
    val p:     class.Policy = holds.at[i].policy;
    val spill: class.Spill  = p.spill;
    ret (sel spill.never) == never && (never || (sel p.remat.none));
}

# make a record's table ready for a target, checking it against the schema once
# ---
# a:          the allocator the index and every selection take
# isa:        the record of the target's instruction set
# target:     the target
# context:    the target's selection under its architecture's state
# convention: the registers of the target's default convention row, nil
#             for a selection with no convention row, where a rule naming
#             one of its registers is refused when it emits
# ret:        the selector, or the first defect of the table, or a type the
#             target reaches that the holds do not give exactly one class
pub fun init(a: *allocator.Allocator, isa: *Isa, target: *Target, context: *core_state.Context, convention: *Registers) res[Selector, Error] {
    val table:   *Table             = isa.table;
    val set:     *mset.Set          = isa.set;
    val reached: err[reach.Refusal] = reach.check(a, table, target, context);
    if (sel reached.err) { ret res[Selector, Error].err{Error.reach{reached.err}}; }
    var file: *rf.File = nil;
    if (set.codec != nil) { file = set.codec.registers; }
    var i: u32 = 0;
    for (i < table.holds.len) {
        val h: rule.Holder = table.holds.at[i].holder;
        if (sel h.hardware) {
            val k: opt[Class] = class.handled(file, h.hardware);
            if (sel k.none) { ret res[Selector, Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
        }
        if (!one_policy(table.holds, file, i)) { ret res[Selector, Error].err{defect(NONE, false, POLICY)}; }
        i = i + 1;
    }
    val carried: lrow.Loops = isa.loops;
    i = 0;
    for (i < table.rules.len) {
        val bad: opt[str] = rule_ok(file, convention, ?table.rules.at[i]);
        if (sel bad.some) { ret res[Selector, Error].err{defect(i, false, bad.some)}; }
        val broken: opt[Error] = loops_ok(?table.rules.at[i], ?carried, i, false);
        if (sel broken.some) { ret res[Selector, Error].err{broken.some}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.constants.len) {
        val bad: opt[str] = constant_ok(file, convention, ?table.constants.at[i]);
        if (sel bad.some) { ret res[Selector, Error].err{defect(i, true, bad.some)}; }
        val broken: opt[Error] = loops_ok(?table.constants.at[i], ?carried, i, true);
        if (sel broken.some) { ret res[Selector, Error].err{broken.some}; }
        i = i + 1;
    }
    if (!jump_ok(table)) { ret res[Selector, Error].err{defect(NONE, true, JUMP)}; }
    val count:  u32                        = ir.rows();
    val firsts: res[*u32, allocator.Error] = allocator.zallocate[u32](a, count::usize + 1);
    if (sel firsts.err) { ret res[Selector, Error].err{Error.alloc{firsts.err}}; }
    val first: *u32  = firsts.ok;
    var size:  usize = table.rules.len::usize;
    if (size == 0) { size = 1; }
    val orders: res[*u32, allocator.Error] = allocator.zallocate[u32](a, size);
    if (sel orders.err) {
        allocator.deallocate[u32](a, first, count::usize + 1);
        ret res[Selector, Error].err{Error.alloc{orders.err}};
    }
    val order: *u32 = orders.ok;
    i = 0;
    for (i < table.rules.len) {
        val op: u32 = table.rules.at[i].nodes.at[0].opcode.index;
        first[op + 1] = first[op + 1] + 1;
        i             = i + 1;
    }
    i = 0;
    for (i < count) {
        first[i + 1] = first[i + 1] + first[i];
        i            = i + 1;
    }
    # each group fills in table order, its cursor the count placed so far
    val cursors: res[*u32, allocator.Error] = allocator.zallocate[u32](a, count::usize);
    if (sel cursors.err) {
        allocator.deallocate[u32](a, first, count::usize + 1);
        allocator.deallocate[u32](a, order, size);
        ret res[Selector, Error].err{Error.alloc{cursors.err}};
    }
    val cursor: *u32 = cursors.ok;
    i = 0;
    for (i < table.rules.len) {
        val op: u32 = table.rules.at[i].nodes.at[0].opcode.index;
        order[first[op] + cursor[op]] = i;
        cursor[op]                    = cursor[op] + 1;
        i                             = i + 1;
    }
    allocator.deallocate[u32](a, cursor, count::usize);
    var many: usize = table.constants.len::usize;
    if (many == 0) { many = 1; }
    val fixed: res[*u32, allocator.Error] = allocator.zallocate[u32](a, many);
    if (sel fixed.err) {
        allocator.deallocate[u32](a, first, count::usize + 1);
        allocator.deallocate[u32](a, order, size);
        ret res[Selector, Error].err{Error.alloc{fixed.err}};
    }
    val constants: *u32  = fixed.ok;
    var wide:      usize = size;
    if (many > wide) { wide = many; }
    val scratches: res[*u32, allocator.Error] = allocator.zallocate[u32](a, wide);
    if (sel scratches.err) {
        allocator.deallocate[u32](a, first, count::usize + 1);
        allocator.deallocate[u32](a, order, size);
        allocator.deallocate[u32](a, constants, many);
        ret res[Selector, Error].err{Error.alloc{scratches.err}};
    }
    i = 0;
    for (i < count) {
        by_cost(table.rules, ?order[first[i]], (first[i + 1] - first[i])::usize, scratches.ok);
        i = i + 1;
    }
    i = 0;
    for (i < table.constants.len) {
        constants[i] = i;
        i            = i + 1;
    }
    by_cost(table.constants, constants, table.constants.len::usize, scratches.ok);
    allocator.deallocate[u32](a, scratches.ok, wide);
    ret res[Selector, Error].ok{Selector{
        a:          a,
        isa:        isa,
        target:     target,
        context:    context,
        convention: convention,
        first:      Slice[u32]{data: first, size: count::usize + 1},
        order:      Slice[u32]{data: order, size: size},
        constants:  Slice[u32]{data: constants, size: many},
        inlines:    minline.init(a),
    }};
}

# give back a selector's index
pub fun dnit(s: *Selector) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, slice.release[u32](s.a, s.first));
    keep(?failed, slice.release[u32](s.a, s.order));
    keep(?failed, slice.release[u32](s.a, s.constants));
    minline.release(?s.inlines);
    ret failed;
}

# the rule an instruction chose and what its pattern matched
# ---
# rule:     the rule's index in the table
# found:    what the pattern matched
# consumes: one bit per node that emits nothing of its own
rec Choice {
    rule:     u32;
    found:    Match;
    consumes: u32;
}

# one parallel copy's move into a block parameter
# ---
# dest:   the parameter's register
# source: the argument's register, NONE for a constant
# value:  the argument
rec Move {
    dest:   u32;
    source: u32;
    value:  id.Value;
}

# the state of one function's selection
# ---
# registers: per ir value, its virtual register or NONE
# secret:    per virtual register, whether it holds a secret value
# held:      per type, the index of the hold that holds it, NONE when unknown
# blocks:    per ir block, its machine block or NONE
# consumed:  per ir instruction, whether a pattern covers it and it emits nothing
# shared:    per ir instruction, how many node slots of chosen later patterns cover it and read its
#            operands, so the values it reads are kept in registers
# position:  per ir instruction of the current block, its place in the block
# impure:    per place of the current block, how many instructions before it
#            trap or touch memory
# choices:   the current block's choices, its last instruction's first
# targets:   the machine block of each edge of the current root
# moves:     the current edge's moves
# loc:       per virtual register, where a parallel copy holds its value
# pred:      per virtual register, the register a parallel copy fills it from
# ready:     the parallel copy's destinations free to be written
# todo:      the parallel copy's destinations
# calls:     what the calls state to the allocator
# clobbers:  the clobbers stated so far
# labels:    how many labels partner operands name so far
# layout:    the target's data layout, which sizes slots
# implied:   the implicit locations of the instruction being made
# firsts:    per ir instruction, the first machine instruction made with it as
#            the root of a rule, NONE for one made with none
# stored:    the variables bound to the storage of a slot selection made
rec State {
    s:         *Selector;
    m:         *Module;
    f:         id.Function;
    body:      *Body;
    out:       *mf.Function;
    calls:     *Calls;
    clobbers:  *vector.Vector[Clobber];
    labels:    u32;
    layout:    Layout;
    implied:   vector.Vector[Implicit];
    registers: vector.Vector[u32];
    secret:    vector.Vector[bool];
    held:      vector.Vector[u32];
    blocks:    vector.Vector[u32];
    consumed:  vector.Vector[bool];
    shared:    vector.Vector[u32];
    position:  vector.Vector[u32];
    impure:    vector.Vector[u32];
    choices:   vector.Vector[Choice];
    targets:   vector.Vector[u32];
    moves:     vector.Vector[Move];
    loc:       vector.Vector[u32];
    pred:      vector.Vector[u32];
    ready:     vector.Vector[u32];
    todo:      vector.Vector[u32];
    firsts:    vector.Vector[u32];
    stored:    vector.Vector[Stored];
}

fun drop_state(st: *State) {
    vector.dnit[u32](?st.firsts);
    vector.dnit[Stored](?st.stored);
    vector.dnit[u32](?st.registers);
    vector.dnit[bool](?st.secret);
    vector.dnit[u32](?st.held);
    vector.dnit[u32](?st.blocks);
    vector.dnit[bool](?st.consumed);
    vector.dnit[u32](?st.shared);
    vector.dnit[u32](?st.position);
    vector.dnit[u32](?st.impure);
    vector.dnit[Choice](?st.choices);
    vector.dnit[u32](?st.targets);
    vector.dnit[Move](?st.moves);
    vector.dnit[u32](?st.loc);
    vector.dnit[u32](?st.pred);
    vector.dnit[u32](?st.ready);
    vector.dnit[u32](?st.todo);
    vector.dnit[Implicit](?st.implied);
}

fun alloc_err(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun push_u32(v: *vector.Vector[u32], x: u32) err[Error] {
    val p: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel p.err) { ret alloc_err(p.err); }
    ret err[Error].ok{};
}

# grow a list to at least `n` entries, each new one `x`
fun grow(v: *vector.Vector[u32], n: usize, x: u32) err[Error] {
    val room: res[usize, allocator.Error] = vector.ensure[u32](v, n);
    if (sel room.err) { ret alloc_err(room.err); }
    for (v.len < n) { vector.push[u32](v, x); }
    ret err[Error].ok{};
}

fun grow_bool(v: *vector.Vector[bool], n: usize) err[Error] {
    val room: res[usize, allocator.Error] = vector.ensure[bool](v, n);
    if (sel room.err) { ret alloc_err(room.err); }
    for (v.len < n) { vector.push[bool](v, false); }
    ret err[Error].ok{};
}

fun instruction(st: *State, i: id.Instruction) *InstructionData {
    ret ?st.body.instructions.data[i.index];
}

fun value(st: *State, v: id.Value) *ValueData {
    ret ?st.body.values.data[v.index];
}

# whether an instruction of an opcode neither traps nor touches memory
fun pure(op: ir.Opcode) bool {
    val r: opt[ir.Row] = ir.row(op);
    if (sel r.none) { ret false; }
    ret sel r.some.effects.traps[0].unstated && !r.some.effects.reads && !r.some.effects.writes;
}

# whether an instruction of an opcode declassifies its operand
fun declassifies(op: ir.Opcode) bool {
    val r: opt[ir.Row] = ir.row(op);
    ret sel r.some && sel r.some.secrecy.declassifies;
}

# whether a match's root or a node it covers declassifies, so what it emits does: a copy that secrecy ends at, or a
# branch on a guard's public condition, which emission makes a declassify point of
fun covers_declassify(st: *State, mt: *Match) bool {
    var n: u32 = 0;
    for (n < mt.count) {
        if (declassifies(instruction(st, mt.nodes[n]).opcode)) { ret true; }
        n = n + 1;
    }
    ret false;
}

# operand `s.index` of node `s.node`, as the pattern states it
fun operand_at(mt: *Match, s: Slot) opt[id.Value] {
    ret match.operand(mt, s);
}

fun result_at(mt: *Match, s: Slot) opt[id.Value] {
    ret match.result(mt, s);
}

fun ref_at(st: *State, mt: *Match, r: Ref) opt[id.Value] {
    if (sel r.operand)                   { ret operand_at(mt, r.operand); }
    if (sel r.result)                    { ret result_at(mt, r.result); }
    if (sel r.constant && mt.count == 0) { ret opt[id.Value].some{mt.subject}; }
    ret opt[id.Value].none{};
}

# the error a refused read of a match is
fun refused(r: match.Refusal) Error {
    if (sel r.module) { ret Error.module{r.module}; }
    ret Error.types{r.types};
}

# the constant a value is, none for any other value
fun constant_of(mt: *Match, v: id.Value) res[opt[ConstantData], Error] {
    val c: res[opt[ConstantData], match.Refusal] = match.constant(mt, v);
    if (sel c.err) { ret res[opt[ConstantData], Error].err{refused(c.err)}; }
    ret res[opt[ConstantData], Error].ok{c.ok};
}

# the bits of the constant a reference names
fun ref_bits(st: *State, mt: *Match, r: Ref) res[opt[i64], Error] {
    val v: opt[id.Value] = ref_at(st, mt, r);
    if (sel v.none) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    val b: res[opt[i64], match.Refusal] = match.bits(mt, v.some);
    if (sel b.err) { ret res[opt[i64], Error].err{refused(b.err)}; }
    ret res[opt[i64], Error].ok{b.ok};
}

# the bits of the integer type of the value a reference names, none for a
# value of another type
fun width_at(st: *State, mt: *Match, r: Ref) res[opt[i64], Error] {
    val v: opt[id.Value] = ref_at(st, mt, r);
    if (sel v.none) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    val s: res[types.Shape, types.Error] = types.shape(?st.m.types, value(st, v.some).type);
    if (sel s.err)           { ret res[opt[i64], Error].err{Error.types{s.err}}; }
    if (!(sel s.ok.integer)) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    ret res[opt[i64], Error].ok{opt[i64].some{s.ok.integer.width::i64}};
}

# the bits of the target's general register, none where it states none
fun register_bits(mt: *Match) opt[i64] {
    val b: capability.Bits = mt.target.caps.widths.register;
    if (sel b.bits) { ret opt[i64].some{b.bits::i64}; }
    ret opt[i64].none{};
}

# the bits a reference names, which the guard admitted
fun immediate(st: *State, mt: *Match, r: Ref) res[i64, Error] {
    val got: res[opt[i64], Error] = ref_bits(st, mt, r);
    if (sel got.err)     { ret res[i64, Error].err{got.err}; }
    if (sel got.ok.none) { ret res[i64, Error].err{defect(NONE, false, UNSTATED)}; }
    ret res[i64, Error].ok{got.ok.some};
}

# the link-time address a reference names, which the guard admitted
fun address(st: *State, mt: *Match, r: Ref) res[Address, Error] {
    val v: opt[id.Value] = ref_at(st, mt, r);
    if (sel v.none) { ret res[Address, Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val c: res[opt[Address], match.Refusal] = match.address(mt, v.some);
    if (sel c.err)     { ret res[Address, Error].err{refused(c.err)}; }
    if (sel c.ok.none) { ret res[Address, Error].err{defect(NONE, false, UNSTATED)}; }
    ret res[Address, Error].ok{c.ok.some};
}

# whether every node of a rule matches, its operands swapped as `swapped` says
fun matches(st: *State, r: *Rule, root: id.Instruction, swapped: u32, mt: *Match) res[bool, Error] {
    mt.nodes[0] = root;
    mt.count    = r.nodes.len;
    mt.swapped  = swapped;
    val place: Place = instruction(st, root).place;
    if (!(sel place.placed)) { ret res[bool, Error].ok{false}; }
    val home: id.Block = place.placed;
    var i:    u32      = 1;
    for (i < r.nodes.len) {
        val n:  *Node         = ?r.nodes.at[i];
        val at: opt[id.Value] = operand_at(mt, Slot{node: n.parent, index: n.operand});
        if (sel at.none) { ret res[bool, Error].ok{false}; }
        val d: *ValueData = value(st, at.some);
        if (!(sel d.def.result))                 { ret res[bool, Error].ok{false}; }
        if (d.def.result.index != n.result::u32) { ret res[bool, Error].ok{false}; }
        val x:  id.Instruction   = d.def.result.instruction;
        val xd: *InstructionData = instruction(st, x);
        if (xd.opcode.index != n.opcode.index)                             { ret res[bool, Error].ok{false}; }
        if (!(sel xd.place.placed && xd.place.placed.index == home.index)) { ret res[bool, Error].ok{false}; }
        mt.nodes[i] = x;
        i           = i + 1;
    }
    i = 0;
    for (i < r.nodes.len) {
        val want: u32 = r.nodes.at[i].constants;
        var k:    u32 = 0;
        for (k < 32) {
            if (((want >> k) & 1) != 0) {
                val v: opt[id.Value] = operand_at(mt, Slot{node: i::u8, index: k::u8});
                if (sel v.none) { ret res[bool, Error].ok{false}; }
                val d: *ValueData = value(st, v.some);
                if (!(sel d.def.constant)) { ret res[bool, Error].ok{false}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}

# whether every use of a value is by instruction `by`, which may read it at more than one operand
fun only_use(st: *State, v: id.Value, by: id.Instruction) bool {
    val uses: *vector.Vector[id.Instruction] = ?value(st, v).uses;
    var i:    usize                          = 0;
    for (i < uses.len) {
        if (uses.data[i].index != by.index) { ret false; }
        i = i + 1;
    }
    ret uses.len != 0;
}

# which nodes a match consumes, none when it covers what it may not
#
# a node is consumed when its parent is and the parent is the only use of its
# results, and the root counts as consumed unless a later pattern shares it. one that is not consumed is selected again for its other uses, so
# it must neither trap nor touch memory, and a consumed one that does may
# move to its root only past instructions that do neither.
fun consumes(st: *State, r: *Rule, mt: *Match) opt[u32] {
    var mask: u32 = 1;
    if (st.shared.data[mt.nodes[0].index] != 0) { mask = 0; }
    var i: u32 = 1;
    for (i < r.nodes.len) {
        val n:      *Node            = ?r.nodes.at[i];
        val x:      id.Instruction   = mt.nodes[i];
        val xd:     *InstructionData = instruction(st, x);
        val parent: id.Instruction   = mt.nodes[n.parent];
        var sole:   bool             = ((mask >> n.parent::u32) & 1) != 0;
        var k:      usize            = 0;
        for (sole && k < xd.results.len) {
            val v: id.Value = xd.results.data[k];
            if (k == n.result::usize) { sole = only_use(st, v, parent); }
            or                        { sole = value(st, v).uses.len == 0; }
            k = k + 1;
        }
        val clean: bool = pure(xd.opcode);
        if (sole)   { mask = mask | (1u32 << i); }
        or (!clean) { ret opt[u32].none{}; }
        if (!clean) {
            val from: u32 = st.position.data[x.index] + 1;
            val to:   u32 = st.position.data[mt.nodes[0].index];
            if (st.impure.data[to] != st.impure.data[from]) { ret opt[u32].none{}; }
        }
        i = i + 1;
    }
    ret opt[u32].some{mask};
}

# whether a source can stand at operand `at` of an emitted instruction
# the power of two an address's index is scaled by, none where a derived
# factor's constant is none or its hook gives no scale below 8
fun factor_of(st: *State, mt: *Match, f: rule.Factor) res[opt[u8], Error] {
    if (sel f.literal)    { ret res[opt[u8], Error].ok{opt[u8].some{f.literal}}; }
    if (!(sel f.derived)) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    val got: res[opt[i64], Error] = ref_bits(st, mt, f.derived.of);
    if (sel got.err)     { ret res[opt[u8], Error].err{got.err}; }
    if (sel got.ok.none) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    val k: i64 = f.derived.hook(got.ok.some);
    if (k < 0 || k > 7) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    ret res[opt[u8], Error].ok{opt[u8].some{k::u8}};
}

# the memory operand an expansion builds, its registers the virtual ones its
# values are in and a constant there materialised first
fun built(st: *State, b: u32, mt: *Match, a: rule.Addressed, md: Metadata) res[Operand, Error] {
    var base:  opt[Register] = opt[Register].none{};
    var index: opt[Register] = opt[Register].none{};
    var seg:   opt[Register] = opt[Register].none{};
    val bs:    opt[Slot]     = a.base;
    if (sel bs.some) {
        val got: res[u32, Error] = operand_register(st, b, mt, bs.some, md);
        if (sel got.err) { ret res[Operand, Error].err{got.err}; }
        base = opt[Register].some{Register.virtual{Virtual{index: got.ok}}};
    }
    val ix: opt[Slot] = a.index;
    if (sel ix.some) {
        val got: res[u32, Error] = operand_register(st, b, mt, ix.some, md);
        if (sel got.err) { ret res[Operand, Error].err{got.err}; }
        index = opt[Register].some{Register.virtual{Virtual{index: got.ok}}};
    }
    val fx: opt[rf.Id] = a.fixed;
    if (sel fx.some) { base = opt[Register].some{Register.physical{Physical.register{fx.some}}}; }
    val sg: opt[rf.Id] = a.segment;
    if (sel sg.some) { seg = opt[Register].some{Register.physical{Physical.register{sg.some}}}; }
    val scale: res[opt[u8], Error] = factor_of(st, mt, a.scale);
    if (sel scale.err)     { ret res[Operand, Error].err{scale.err}; }
    if (sel scale.ok.none) { ret res[Operand, Error].err{defect(NONE, false, UNSTATED)}; }
    var disp: i64      = 0;
    val d:    opt[Ref] = a.disp;
    if (sel d.some) {
        val got: res[i64, Error] = immediate(st, mt, d.some);
        if (sel got.err) { ret res[Operand, Error].err{got.err}; }
        disp = got.ok;
    }
    var symbol: opt[Symbol]        = opt[Symbol].none{};
    val y:      opt[rule.Symbolic] = a.symbol;
    if (sel y.some) {
        val c: res[Address, Error] = address(st, mt, y.some.of);
        if (sel c.err) { ret res[Operand, Error].err{c.err}; }
        symbol = opt[Symbol].some{Symbol{symbol: c.ok.symbol, addend: c.ok.offset + disp, kind: y.some.kind}};
        disp   = 0;
    }
    var mode: mo.Mode = mo.OFFSET;
    if (a.relative) { mode = mo.RELATIVE_PC; }
    ret res[Operand, Error].ok{Operand.address{Built{base: base, index: index, segment: seg, scale: scale.ok.some, disp: disp, symbol: symbol, mode: mode, extend: 0, broadcast: 0}}};
}

fun admitted(st: *State, mt: *Match, e: *Emit, at: u32, s: Source) res[bool, Error] {
    if (sel s.bits || sel s.derived) {
        var r: Ref = Ref.unstated{};
        if (sel s.bits)    { r = s.bits; }
        if (sel s.derived) { r = s.derived.of; }
        val got: res[opt[i64], Error] = ref_bits(st, mt, r);
        if (sel got.err)     { ret res[bool, Error].err{got.err}; }
        if (sel got.ok.none) { ret res[bool, Error].ok{false}; }
        var x: i64 = got.ok.some;
        if (sel s.derived) { x = s.derived.hook(x); }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, x)};
    }
    if (sel s.literal) { ret res[bool, Error].ok{mi.fits(e.opcode, at, s.literal)}; }
    if (sel s.address) {
        val a:    rule.Addressed = s.address;
        val base: opt[Slot]      = a.base;
        if (sel base.some) {
            val v: opt[id.Value] = operand_at(mt, base.some);
            if (sel v.none) { ret res[bool, Error].ok{false}; }
        }
        val index: opt[Slot] = a.index;
        if (sel index.some) {
            val v: opt[id.Value] = operand_at(mt, index.some);
            if (sel v.none) { ret res[bool, Error].ok{false}; }
        }
        val scale: res[opt[u8], Error] = factor_of(st, mt, a.scale);
        if (sel scale.err)     { ret res[bool, Error].err{scale.err}; }
        if (sel scale.ok.none) { ret res[bool, Error].ok{false}; }
        var disp: i64      = 0;
        val d:    opt[Ref] = a.disp;
        if (sel d.some) {
            val got: res[opt[i64], Error] = ref_bits(st, mt, d.some);
            if (sel got.err)     { ret res[bool, Error].err{got.err}; }
            if (sel got.ok.none) { ret res[bool, Error].ok{false}; }
            disp = got.ok.some;
        }
        var symbolic: bool               = false;
        val y:        opt[rule.Symbolic] = a.symbol;
        if (sel y.some) {
            val v: opt[id.Value] = ref_at(st, mt, y.some.of);
            if (sel v.none) { ret res[bool, Error].ok{false}; }
            val c: res[opt[Address], match.Refusal] = match.address(mt, v.some);
            if (sel c.err)     { ret res[bool, Error].err{refused(c.err)}; }
            if (sel c.ok.none) { ret res[bool, Error].ok{false}; }
            symbolic = true;
        }
        var mode: mo.Mode = mo.OFFSET;
        if (a.relative) { mode = mo.RELATIVE_PC; }
        ret res[bool, Error].ok{mi.fits_address(e.opcode, at, scale.ok.some, disp, mode, symbolic)};
    }
    if (sel s.width) {
        val got: res[opt[i64], Error] = width_at(st, mt, s.width);
        if (sel got.err)     { ret res[bool, Error].err{got.err}; }
        if (sel got.ok.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, got.ok.some)};
    }
    if (sel s.register) {
        val got: opt[i64] = register_bits(mt);
        if (sel got.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, got.some)};
    }
    if (sel s.symbol) {
        val v: opt[id.Value] = ref_at(st, mt, s.symbol.of);
        if (sel v.none) { ret res[bool, Error].ok{false}; }
        val c: res[opt[Address], match.Refusal] = match.address(mt, v.some);
        if (sel c.err) { ret res[bool, Error].err{refused(c.err)}; }
        ret res[bool, Error].ok{sel c.ok.some};
    }
    if (sel s.value) {
        val v: opt[id.Value] = operand_at(mt, s.value);
        ret res[bool, Error].ok{sel v.some};
    }
    if (sel s.tied) {
        val v: opt[id.Value] = operand_at(mt, s.tied.value);
        if (sel v.none) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.tied.result::usize < d.results.len};
    }
    if (sel s.ordered) {
        val o: opt[ir.Ordering] = match.ordering(mt, s.ordered.node);
        if (sel o.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, rule.form(s.ordered.forms, o.some))};
    }
    if (sel s.fresh) {
        val v: opt[id.Value] = ref_at(st, mt, s.fresh.like);
        ret res[bool, Error].ok{sel v.some};
    }
    if (sel s.scratch || sel s.fixed || convened(s)) { ret res[bool, Error].ok{true}; }
    if (sel s.slot || sel s.partner || sel s.lookup) { ret res[bool, Error].ok{true}; }
    if (sel s.count) {
        if (mt.count == 0) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        if (d.edges.len == 0) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, s.count((d.edges.len - 1)::i64))};
    }
    if (sel s.table) { ret res[bool, Error].ok{mt.count != 0}; }
    if (sel s.result) {
        if (mt.count == 0) { ret res[bool, Error].ok{s.result == 0}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.result::usize < d.results.len};
    }
    if (sel s.target) {
        if (mt.count == 0) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.target::usize < d.edges.len};
    }
    ret res[bool, Error].ok{false};
}

# the bits of a pointer into address space `space` of a target, 0 for a space
# it has no row of or a pointer with no address
fun pointer_bits(t: *Target, space: u32) u64 {
    val rows: Slice[capability.Space] = t.caps.widths.pointers;
    var i:    usize                   = 0;
    for (i < rows.size) {
        if (rows.data[i].space == space) {
            val p: capability.Pointer = target_record.pointer_of(t, ?rows.data[i]);
            if (sel p.physical) { ret p.physical.size * 8; }
            ret 0;
        }
        i = i + 1;
    }
    ret 0;
}

# whether type `ty` has width `w` against the target's general register, an
# integer or a pointer of the register's width, of a part or of several
# registers, any type for a width of any
fun widened(st: *State, w: rule.Width, ty: Type) res[bool, Error] {
    if (sel w.any) { ret res[bool, Error].ok{true}; }
    val s: res[types.Shape, types.Error] = types.shape(?st.m.types, ty);
    if (sel s.err) { ret res[bool, Error].err{Error.types{s.err}}; }
    val reg: Bits = st.s.target.caps.widths.register;
    if (!(sel reg.bits)) { ret res[bool, Error].ok{false}; }
    var bits: u64 = 0;
    if (sel s.ok.integer) { bits = s.ok.integer.width::u64; }
    or (sel s.ok.pointer) { bits = pointer_bits(st.s.target, s.ok.pointer.space); }
    if (bits == 0)        { ret res[bool, Error].ok{false}; }
    val held: u64 = reg.bits::u64;
    if (sel w.register) { ret res[bool, Error].ok{bits == held}; }
    if (sel w.part) {
        val n: u64 = w.part::u64;
        ret res[bool, Error].ok{n != 0 && bits * n == held};
    }
    if (sel w.whole) {
        val n: u64 = w.whole::u64;
        ret res[bool, Error].ok{bits == held * n};
    }
    ret res[bool, Error].ok{false};
}

# whether a rule's guard holds of a match: its type tests, its sources, the
# extensions its rows and its loops' rows require and its hook, in that order
fun guard(st: *State, r: *Rule, mt: *Match) res[bool, Error] {
    var t: u32 = 0;
    for (t < r.tests.len) {
        val test: *rule.Test    = ?r.tests.at[t];
        val v:    opt[id.Value] = ref_at(st, mt, test.at);
        if (sel v.none) { ret res[bool, Error].ok{false}; }
        var ty: Type = value(st, v.some).type;
        if (test.lanes) {
            val s: res[types.Shape, types.Error] = types.shape(?st.m.types, ty);
            if (sel s.err)          { ret res[bool, Error].err{Error.types{s.err}}; }
            if (!(sel s.ok.vector)) { ret res[bool, Error].ok{false}; }
            ty = s.ok.vector.element;
        }
        val held: res[bool, types.Error] = ir.within(?st.m.types, test.class, ty);
        if (sel held.err) { ret res[bool, Error].err{Error.types{held.err}}; }
        if (!held.ok)     { ret res[bool, Error].ok{false}; }
        val wide: res[bool, Error] = widened(st, test.width, ty);
        if (sel wide.err) { ret wide; }
        if (!wide.ok)     { ret wide; }
        t = t + 1;
    }
    if (r.orderings != nil) {
        val o: opt[ir.Ordering] = match.ordering(mt, 0);
        if (sel o.none)                      { ret res[bool, Error].ok{false}; }
        if (!ir.holds(@r.orderings, o.some)) { ret res[bool, Error].ok{false}; }
    }
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var n:    u32   = 0;
        for (n < mi.rows_in(emit.opcode)) {
            if (!core_state.admits(st.s.context, mi.row_in(emit.opcode, n).requires)) { ret res[bool, Error].ok{false}; }
            n = n + 1;
        }
        var k: u32 = 0;
        for (k < emit.operands.len) {
            val ok: res[bool, Error] = admitted(st, mt, emit, k, emit.operands.at[k]);
            if (sel ok.err) { ret ok; }
            if (!ok.ok)     { ret ok; }
            k = k + 1;
        }
        e = e + 1;
    }
    if (r.hook != nil && !r.hook(mt)) { ret res[bool, Error].ok{false}; }
    ret res[bool, Error].ok{true};
}

fun commutative(r: *Rule) u32 {
    var mask: u32 = 0;
    var i:    u32 = 0;
    for (i < r.nodes.len) {
        if (algebra.algebra(r.nodes.at[i].opcode).commutative) { mask = mask | (1u32 << i); }
        i = i + 1;
    }
    ret mask;
}

fun unmatched_of(st: *State, i: id.Instruction, op: Operation) Unmatched {
    val d: *InstructionData = instruction(st, i);
    var u: Unmatched;
    u.operation     = op;
    u.instruction   = i;
    u.operand_count = d.operands.len::u32;
    u.result_count  = d.results.len::u32;
    var k: usize = 0;
    for (k < d.operands.len && k < $length_of(ir.Operands)) {
        u.operands[k] = value(st, d.operands.data[k]).type;
        k             = k + 1;
    }
    k = 0;
    for (k < d.results.len && k < $length_of(ir.Results)) {
        u.results[k] = value(st, d.results.data[k]).type;
        k            = k + 1;
    }
    ret u;
}

# the least cost rule for an instruction whose pattern matches and guard
# holds, the first in table order among rules of one cost
fun choose(st: *State, i: id.Instruction) res[Choice, Error] {
    val op: ir.Opcode = instruction(st, i).opcode;
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.target;
    var k: u32 = st.s.first.data[op.index];
    for (k < st.s.first.data[op.index + 1]) {
        val index: u32   = st.s.order.data[k];
        val r:     *Rule = ?st.s.isa.table.rules.at[index];
        val swaps: u32   = commutative(r);
        var mask:  u32   = 0;
        for {
            val hit: res[bool, Error] = matches(st, r, i, mask, ?mt);
            if (sel hit.err) { ret res[Choice, Error].err{hit.err}; }
            if (hit.ok) {
                val eaten: opt[u32] = consumes(st, r, ?mt);
                if (sel eaten.some) {
                    val held: res[bool, Error] = guard(st, r, ?mt);
                    if (sel held.err) { ret res[Choice, Error].err{held.err}; }
                    if (held.ok)      { ret res[Choice, Error].ok{Choice{rule: index, found: mt, consumes: eaten.some}}; }
                }
            }
            if (mask == swaps) { brk; }
            mask = ((mask | ~swaps) + 1) & swaps;
        }
        k = k + 1;
    }
    ret res[Choice, Error].err{Error.unmatched{unmatched_of(st, i, Operation.opcode{op})}};
}

# the selector's context, none for a selection with none
fun context_of(s: *Selector) opt[*core_state.Context] {
    if (s.context == nil) { ret opt[*core_state.Context].none{}; }
    ret opt[*core_state.Context].some{s.context};
}

# the class the table holds a type in, by its one row the build meets
fun class_for(st: *State, ty: Type) res[Class, Error] {
    val grown: err[Error] = grow(?st.held, ty.index::usize + 1, NONE);
    if (sel grown.err) { ret res[Class, Error].err{grown.err}; }
    var at: u32 = st.held.data[ty.index];
    if (at == NONE) {
        val got: res[reach.Admit, reach.Refusal] = reach.admitting(?st.m.types, st.s.isa.table.holds, ty, context_of(st.s));
        if (sel got.err)       { ret res[Class, Error].err{Error.reach{got.err}}; }
        if (got.ok.count == 0) { ret res[Class, Error].err{Error.unheld{ty}}; }
        if (got.ok.count > 1)  { ret res[Class, Error].err{Error.ambiguous{ty}}; }
        at                     = got.ok.first;
        st.held.data[ty.index] = at;
    }
    val holder: rule.Holder = st.s.isa.table.holds.at[at].holder;
    if (sel holder.hardware) {
        val k: opt[Class] = class.handled(mf.file(st.out), holder.hardware);
        if (sel k.none) { ret res[Class, Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
        ret res[Class, Error].ok{k.some};
    }
    ret res[Class, Error].ok{Class.memory{holder.memory}};
}

# a new virtual register of a class
fun virtual_in(st: *State, k: Class, secret: bool) res[u32, Error] {
    val made: res[Virtual, mf.Error] = mf.virtual(st.out, k);
    if (sel made.err) { ret res[u32, Error].err{Error.machine{made.err}}; }
    val p: res[usize, allocator.Error] = vector.push[bool](?st.secret, secret);
    if (sel p.err) { ret res[u32, Error].err{Error.alloc{p.err}}; }
    ret res[u32, Error].ok{made.ok.index};
}

# a new virtual register for a value of a type
fun virtual(st: *State, ty: Type, secret: bool) res[u32, Error] {
    val s: res[types.Shape, types.Error] = types.shape(?st.m.types, ty);
    if (sel s.err)                                              { ret res[u32, Error].err{Error.types{s.err}}; }
    if (sel s.ok.array || sel s.ok.structure || sel s.ok.union) { ret res[u32, Error].err{Error.aggregate{ty}}; }
    val k: res[Class, Error] = class_for(st, ty);
    if (sel k.err) { ret res[u32, Error].err{k.err}; }
    ret virtual_in(st, k.ok, secret);
}

# the virtual register a value is held in, made when first asked for
fun register(st: *State, v: id.Value) res[u32, Error] {
    if (st.registers.data[v.index] != NONE) { ret res[u32, Error].ok{st.registers.data[v.index]}; }
    val d: *ValueData = value(st, v);
    if (sel d.def.removed) { ret res[u32, Error].err{Error.removed{v}}; }
    val made: res[u32, Error] = virtual(st, d.type, d.secret);
    if (sel made.err) { ret made; }
    st.registers.data[v.index] = made.ok;
    ret made;
}

# how machine instruction `at` transfers control, or why it is undecided
fun transfer_of(st: *State, at: Instruction) res[u8, Error] {
    val got: effect.Answer[effect.Control] = mi.transfer(mf.file(st.out), mf.data(st.out, at));
    if (sel got.undecided) { ret res[u8, Error].err{Error.undecided{mi.Undecided{instruction: at, why: got.undecided}}}; }
    ret res[u8, Error].ok{got.decided.transfer};
}

# append an instruction to block `b` under the configuration state it runs
# under, stating `clobbered` at it when it is a call
fun made(st: *State, b: u32, op: mi.Opcode, operands: *Operand, count: u32, md: Metadata, declassifies: bool, state: opt[vstate.State], clobbered: Slice[rf.Id]) res[Instruction, Error] {
    val made: res[Instruction, mf.Error] = mf.append(st.out, Block{index: b}, op, Slice[Operand]{data: operands, size: count::usize}, md, declassifies, state);
    if (sel made.err) { ret res[Instruction, Error].err{Error.machine{made.err}}; }
    val at:   Instruction    = made.ok;
    val kind: res[u8, Error] = transfer_of(st, at);
    if (sel kind.err)           { ret res[Instruction, Error].err{kind.err}; }
    if (kind.ok != effect.CALL) { ret res[Instruction, Error].ok{at}; }
    var k: usize = 0;
    for (k < clobbered.size) {
        val id:  rf.Id                        = clobbered.data[k];
        val loc: res[u32, location.Unlocated] = location.locate(st.calls.at, Physical.register{id});
        if (sel loc.err) { ret res[Instruction, Error].err{Error.unlocated{loc.err}}; }
        val p: res[usize, allocator.Error] = vector.push[Clobber](st.clobbers, Clobber{instruction: at, location: loc.ok});
        if (sel p.err) { ret res[Instruction, Error].err{Error.alloc{p.err}}; }
        k = k + 1;
    }
    ret res[Instruction, Error].ok{at};
}

fun put(st: *State, b: u32, op: mi.Opcode, operands: *Operand, count: u32, md: Metadata, declassifies: bool) err[Error] {
    val got: res[Instruction, Error] = made(st, b, op, operands, count, md, declassifies, vstate.NONE, Slice[rf.Id]{data: nil, size: 0});
    if (sel got.err) { ret err[Error].err{got.err}; }
    ret err[Error].ok{};
}

# state the implicit locations gathered in `st.implied` on an instruction
fun imply(st: *State, i: Instruction) err[Error] {
    val stated: err[mf.Error] = mf.imply(st.out, i, Slice[Implicit]{data: st.implied.data, size: st.implied.len});
    if (sel stated.err) { ret err[Error].err{Error.machine{stated.err}}; }
    ret err[Error].ok{};
}

fun note(st: *State, at: Physical, write: bool) err[Error] {
    val p: res[usize, allocator.Error] = vector.push[Implicit](?st.implied, Implicit{location: at, write: write});
    if (sel p.err) { ret alloc_err(p.err); }
    ret err[Error].ok{};
}

fun copy(st: *State, b: u32, dest: u32, source: u32, md: Metadata) err[Error] {
    var ops: [2]Operand = [2]Operand{Operand.virtual{Virtual{index: dest}}, Operand.virtual{Virtual{index: source}}};
    var m:   Metadata   = md;
    m.secret = st.secret.data[source];
    ret put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
}

# materialise a constant into register `dest` by the least cost constant rule whose guard holds
fun materialise(st: *State, b: u32, v: id.Value, dest: u32, user: id.Instruction, md: Metadata) err[Error] {
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.target;
    mt.count    = 0;
    mt.subject  = v;
    var k: u32 = 0;
    for (k < st.s.isa.table.constants.len) {
        val r:    *Rule            = ?st.s.isa.table.constants.at[st.s.constants.data[k]];
        val held: res[bool, Error] = guard(st, r, ?mt);
        if (sel held.err) { ret err[Error].err{held.err}; }
        if (held.ok) {
            var m: Metadata = md;
            m.secret = false;
            m.flags  = NO_FLAGS;
            ret expand(st, b, r, ?mt, dest, m, false);
        }
        k = k + 1;
    }
    var u: Unmatched;
    u.operation     = Operation.constant{};
    u.instruction   = user;
    u.operands[0]   = value(st, v).type;
    u.operand_count = 1;
    ret err[Error].err{Error.unmatched{u}};
}

# the virtual register an operand of a node is read in, a constant there
# materialised into one of its own first
fun operand_register(st: *State, b: u32, mt: *Match, at: Slot, md: Metadata) res[u32, Error] {
    val got: opt[id.Value] = operand_at(mt, at);
    if (sel got.none) { ret res[u32, Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val v: id.Value   = got.some;
    val d: *ValueData = value(st, v);
    if (!(sel d.def.constant)) { ret register(st, v); }
    val t: res[u32, Error] = virtual(st, d.type, false);
    if (sel t.err) { ret t; }
    val built: err[Error] = materialise(st, b, v, t.ok, mt.nodes[0], md);
    if (sel built.err) { ret res[u32, Error].err{built.err}; }
    ret t;
}

# the virtual register result `index` of the root is defined in, `dest` for a
# materialisation rule
fun result_register(st: *State, mt: *Match, index: u8, dest: u32) res[u32, Error] {
    if (mt.count == 0) { ret res[u32, Error].ok{dest}; }
    ret register(st, instruction(st, mt.nodes[0]).results.data[index]);
}

# the registers of the convention row a rule's root runs under: the row a
# placed call's signature names, and the default row for any other root or
# for a selection stating no rows
fun row_of(st: *State, mt: *Match) res[*Registers, Error] {
    if (st.calls.rows.size == 0 || mt.count == 0) { ret res[*Registers, Error].ok{st.s.convention}; }
    val d: *InstructionData = instruction(st, mt.nodes[0]);
    if (d.opcode.index != ir.CALL_PLACED.index || d.immediates.len == 0) { ret res[*Registers, Error].ok{st.s.convention}; }
    val sig: Immediate = d.immediates.data[0];
    if (!(sel sig.ty)) { ret res[*Registers, Error].ok{st.s.convention}; }
    val s: res[types.Function, types.Error] = types.signature(?st.m.types, sig.ty);
    if (sel s.err) { ret res[*Registers, Error].err{Error.types{s.err}}; }
    val declared: convention.Declared = st.s.target.convention;
    if (!(sel declared.rows)) { ret res[*Registers, Error].err{defect(NONE, false, UNROWED)}; }
    var rows: convention.Conventions = declared.rows;
    val at:   opt[usize]             = convention.position(?rows, s.ok.convention);
    if (sel at.none)                   { ret res[*Registers, Error].err{defect(NONE, false, UNROWED)}; }
    if (at.some >= st.calls.rows.size) { ret res[*Registers, Error].err{defect(NONE, false, UNROWED)}; }
    val held: *Registers = convention.held(?st.calls.rows.data[at.some]);
    if (held == nil) { ret res[*Registers, Error].err{defect(NONE, false, UNROWED)}; }
    ret res[*Registers, Error].ok{held};
}

# the registers a call of an expansion leaves undefined under the registers
# of its row: the row's clobbered ones for a function, the ones it states for
# a thread-local descriptor's resolver for that. none for a selection stating
# no rows, and read only where the instruction is a call
fun clobbered_by(st: *State, regs: *Registers, callee: Callee) res[Slice[rf.Id], Error] {
    if (st.calls.rows.size == 0 || regs == nil) { ret res[Slice[rf.Id], Error].ok{Slice[rf.Id]{data: nil, size: 0}}; }
    if (sel callee.function)                    { ret res[Slice[rf.Id], Error].ok{regs.clobbered}; }
    val described: opt[Slice[rf.Id]] = regs.descriptor;
    if (sel described.none) { ret res[Slice[rf.Id], Error].err{defect(NONE, false, UNDESCRIBED)}; }
    ret res[Slice[rf.Id], Error].ok{described.some};
}

# emit a rule's expansion into block `b`
# ---
# dest: the register a materialisation rule builds into, NONE for any other
fun expand(st: *State, b: u32, r: *Rule, mt: *Match, dest: u32, md: Metadata, declassifies: bool) err[Error] {
    var fresh:   [rule.MAX_FRESH]u32;
    var emitted: [rule.MAX_FRESH]Instruction;
    var labels:  [rule.MAX_FRESH]u32;
    var f:       u32 = 0;
    for (f < rule.MAX_FRESH) {
        fresh[f]  = NONE;
        labels[f] = NONE;
        f         = f + 1;
    }
    val row: res[*Registers, Error] = row_of(st, mt);
    if (sel row.err) { ret err[Error].err{row.err}; }
    val regs:  *Registers = row.ok;
    var frame: u32        = NONE;
    var table: u32        = NONE;
    var e:     u32        = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (tabled(emit)) {
            if (table == NONE) {
                table     = st.labels;
                st.labels = st.labels + 1;
            }
            val laid: res[Instruction, Error] = lay_table(st, b, md);
            if (sel laid.err) { ret err[Error].err{laid.err}; }
            mf.label(st.out, laid.ok, table);
            if (e < rule.MAX_FRESH) { emitted[e] = laid.ok; }
            e = e + 1;
            cnt;
        }
        var ops: [rows.MAX_OPERANDS]Operand;
        var k:   u32 = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (sel s.value) {
                val got: res[u32, Error] = operand_register(st, b, mt, s.value, md);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = Operand.virtual{Virtual{index: got.ok}};
            }
            or (sel s.result) {
                val got: res[u32, Error] = result_register(st, mt, s.result, dest);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = Operand.virtual{Virtual{index: got.ok}};
            }
            or (sel s.tied) {
                val source: res[u32, Error] = operand_register(st, b, mt, s.tied.value, md);
                if (sel source.err) { ret err[Error].err{source.err}; }
                val written: res[u32, Error] = result_register(st, mt, s.tied.result, dest);
                if (sel written.err) { ret err[Error].err{written.err}; }
                ops[k] = Operand.tied{Tied{dest: Register.virtual{Virtual{index: written.ok}}, source: Register.virtual{Virtual{index: source.ok}}}};
            }
            or (sel s.ordered) {
                val o: opt[ir.Ordering] = match.ordering(mt, s.ordered.node);
                if (sel o.none) { ret err[Error].err{defect(NONE, false, UNORDERED)}; }
                ops[k] = Operand.immediate{rule.form(s.ordered.forms, o.some)};
            }
            or (sel s.bits) {
                val got: res[i64, Error] = immediate(st, mt, s.bits);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = Operand.immediate{got.ok};
            }
            or (sel s.derived) {
                val got: res[i64, Error] = immediate(st, mt, s.derived.of);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = Operand.immediate{s.derived.hook(got.ok)};
            }
            or (sel s.symbol) {
                val c: res[Address, Error] = address(st, mt, s.symbol.of);
                if (sel c.err) { ret err[Error].err{c.err}; }
                ops[k] = Operand.symbol{Symbol{symbol: c.ok.symbol, addend: c.ok.offset, kind: s.symbol.kind}};
            }
            or (sel s.literal) { ops[k] = Operand.immediate{s.literal}; }
            or (sel s.address) {
                val got: res[Operand, Error] = built(st, b, mt, s.address, md);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = got.ok;
            }
            or (sel s.width) {
                val got: res[opt[i64], Error] = width_at(st, mt, s.width);
                if (sel got.err)     { ret err[Error].err{got.err}; }
                if (sel got.ok.none) { ret err[Error].err{defect(NONE, false, UNSTATED)}; }
                ops[k] = Operand.immediate{got.ok.some};
            }
            or (sel s.register) {
                val got: opt[i64] = register_bits(mt);
                if (sel got.none) { ret err[Error].err{defect(NONE, false, UNSTATED)}; }
                ops[k] = Operand.immediate{got.some};
            }
            or (sel s.fresh) {
                if (fresh[s.fresh.index] == NONE) {
                    val like: opt[id.Value] = ref_at(st, mt, s.fresh.like);
                    if (sel like.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
                    val t: res[u32, Error] = virtual(st, value(st, like.some).type, md.secret);
                    if (sel t.err) { ret err[Error].err{t.err}; }
                    fresh[s.fresh.index] = t.ok;
                }
                ops[k] = Operand.virtual{Virtual{index: fresh[s.fresh.index]}};
            }
            or (sel s.scratch) {
                if (fresh[s.scratch.index] == NONE) {
                    val k: opt[Class] = class.handled(mf.file(st.out), s.scratch.class);
                    if (sel k.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
                    val t: res[u32, Error] = virtual_in(st, k.some, md.secret);
                    if (sel t.err) { ret err[Error].err{t.err}; }
                    fresh[s.scratch.index] = t.ok;
                }
                ops[k] = Operand.virtual{Virtual{index: fresh[s.scratch.index]}};
            }
            or (sel s.fixed || convened(s)) {
                val got: opt[rf.Id] = named(regs, s);
                if (sel got.none) { ret err[Error].err{defect(NONE, false, UNCONVENED)}; }
                ops[k] = Operand.physical{Physical.register{got.some}};
            }
            or (sel s.target) { ops[k] = Operand.block{Block{index: st.targets.data[s.target]}}; }
            or (sel s.slot) {
                if (frame == NONE) {
                    val got: res[u32, Error] = slot_for(st, mt.nodes[0]);
                    if (sel got.err) { ret err[Error].err{got.err}; }
                    frame = got.ok;
                }
                ops[k] = Operand.slot{FrameSlot{index: frame}};
            }
            or (sel s.partner) {
                val j: u8 = s.partner.emit;
                if (labels[j] == NONE) {
                    labels[j] = st.labels;
                    st.labels = st.labels + 1;
                    mf.label(st.out, emitted[j], labels[j]);
                }
                ops[k] = Operand.partner{Partner{label: labels[j], kind: s.partner.kind}};
            }
            or (sel s.lookup) {
                val got: res[id.Symbol, Error] = lookup(st);
                if (sel got.err) { ret err[Error].err{got.err}; }
                ops[k] = Operand.symbol{Symbol{symbol: got.ok, addend: 0, kind: s.lookup}};
            }
            or (sel s.count) {
                val d: *InstructionData = instruction(st, mt.nodes[0]);
                ops[k] = Operand.immediate{s.count((d.edges.len - 1)::i64)};
            }
            or (sel s.table) {
                if (table == NONE) {
                    table     = st.labels;
                    st.labels = st.labels + 1;
                }
                ops[k] = Operand.partner{Partner{label: table, kind: s.table}};
            }
            k = k + 1;
        }
        val clobbered: res[Slice[rf.Id], Error] = clobbered_by(st, regs, emit.callee);
        if (sel clobbered.err) { ret err[Error].err{clobbered.err}; }
        val placed: res[Instruction, Error] = made(st, b, emit.opcode, ?ops[0], emit.operands.len, md, declassifies, emit.state, clobbered.ok);
        if (sel placed.err)     { ret err[Error].err{placed.err}; }
        if (e < rule.MAX_FRESH) { emitted[e] = placed.ok; }
        if (emit.implied.len > 0) {
            vector.clear[Implicit](?st.implied);
            var n: u32 = 0;
            for (n < emit.implied.len) {
                val x:   rule.Implied = emit.implied.at[n];
                val got: opt[rf.Id]   = named(regs, x.register);
                if (sel got.none) { ret err[Error].err{defect(NONE, false, UNCONVENED)}; }
                val noted: err[Error] = note(st, Physical.register{got.some}, x.write);
                if (sel noted.err) { ret noted; }
                n = n + 1;
            }
            val stated: err[Error] = imply(st, placed.ok);
            if (sel stated.err) { ret stated; }
        }
        e = e + 1;
    }
    ret err[Error].ok{};
}

# a jump table at the end of block `b`: the machine blocks of the current
# root's edges after the first, in order
fun lay_table(st: *State, b: u32, md: Metadata) res[Instruction, Error] {
    if (st.targets.len < 2) { ret res[Instruction, Error].err{defect(NONE, false, TABLELESS)}; }
    val n:    usize                          = st.targets.len - 1;
    val room: res[*Operand, allocator.Error] = allocator.allocate[Operand](st.s.a, n);
    if (sel room.err) { ret res[Instruction, Error].err{Error.alloc{room.err}}; }
    fin { allocator.deallocate[Operand](st.s.a, room.ok, n); }
    var k: usize = 0;
    for (k < n) {
        room.ok[k] = Operand.block{Block{index: st.targets.data[k + 1]}};
        k          = k + 1;
    }
    var m: Metadata = md;
    m.secret = false;
    val laid: res[Instruction, Error] = made(st, b, mi.Opcode.pseudo{pseudo.TABLE}, room.ok, n::u32, m, false, vstate.NONE, Slice[rf.Id]{data: nil, size: 0});
    ret laid;
}

# the frame slot an alloca asks for: its type's size, in the space its pointer
# points into, at its alignment
fun slot_for(st: *State, root: id.Instruction) res[u32, Error] {
    val d:       *InstructionData = instruction(st, root);
    var ty:      Type             = Type{index: 0};
    var pointer: Type             = Type{index: 0};
    var align:   u64              = 1;
    var typed:   u32              = 0;
    var k:       usize            = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.ty) {
            if (typed == 0) { ty = imm.ty; }
            if (typed == 1) { pointer = imm.ty; }
            typed = typed + 1;
        }
        if (sel imm.alignment) { align = imm.alignment; }
        k = k + 1;
    }
    val space: res[u32, types.Error] = types.space(?st.m.types, pointer);
    if (sel space.err) { ret res[u32, Error].err{Error.layout{pointer}}; }
    val size: res[u64, target_record.Error] = layout.size(?st.layout, ty, space.ok);
    if (sel size.err) { ret res[u32, Error].err{Error.layout{ty}}; }
    val got: res[FrameSlot, mf.Error] = mf.slot(st.out, mf.fixed_slot(size.ok, align));
    if (sel got.err) { ret res[u32, Error].err{Error.machine{got.err}}; }
    val bound: res[Slice[Binding], module.Error] = module.bound(st.m, d.metadata.bindings);
    if (sel bound.err) { ret res[u32, Error].err{Error.module{bound.err}}; }
    var b: usize = 0;
    for (b < bound.ok.size) {
        val kept: res[usize, allocator.Error] = vector.push[Stored](?st.stored, Stored{binding: bound.ok.data[b], slot: got.ok});
        if (sel kept.err) { ret res[u32, Error].err{Error.alloc{kept.err}}; }
        b = b + 1;
    }
    ret res[u32, Error].ok{got.ok.index};
}

# a variable bound to the storage a slot holds
# ---
# binding: the variable
# slot:    the slot its storage is
rec Stored {
    binding: Binding;
    slot:    FrameSlot;
}

# the module's function the target's general dynamic thread-local access calls
fun lookup(st: *State) res[id.Symbol, Error] {
    val a: Addresses = st.s.target.addresses;
    if (!(sel a.model)) { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    val name:  str            = a.model.threads.lookup;
    val found: opt[id.Symbol] = module.find(st.m, View{data: name, len: str_len(name)});
    if (sel found.none)             { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    if (!(sel found.some.function)) { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    ret res[id.Symbol, Error].ok{found.some};
}

# the places of an instruction in piece form, none for any other
fun places_of(d: *InstructionData) opt[Slice[Placed]] {
    var k: usize = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.places) { ret opt[Slice[Placed]].some{imm.places}; }
        k = k + 1;
    }
    ret opt[Slice[Placed]].none{};
}

# the slot a piece of a type takes at its stack place, in the caller's
# outgoing area or the callee's incoming one. a piece whose size scales has
# its type's bytes per unit of the scale's multiplier, and a place whose offset
# scales is its bytes per unit, so either makes the slot's scale that scale
fun stack_slot(st: *State, ty: Type, p: Placed, incoming: bool) res[FrameSlot, Error] {
    val size:  res[u64, target_record.Error] = layout.size(?st.layout, ty, types.DEFAULT_SPACE);
    val align: res[u64, target_record.Error] = layout.align(?st.layout, ty, types.DEFAULT_SPACE);
    if (sel size.err)  { ret res[FrameSlot, Error].err{Error.layout{ty}}; }
    if (sel align.err) { ret res[FrameSlot, Error].err{Error.layout{ty}}; }
    val place: ir_place.Place = p.place;
    if (!(sel place.stack)) { ret res[FrameSlot, Error].err{Error.placed{p}}; }
    var slot: SlotData = SlotData{size: size.ok, per: 0, scale: 0, align: align.ok, area: Area.local{}, secret: false};
    var at:   Argued   = mf.argued(place.stack.offset);
    if (sel p.scale.scaled) {
        slot.size  = 0;
        slot.per   = size.ok;
        slot.scale = p.scale.scaled;
    }
    val offset: ir_place.Scale = place.stack.scale;
    if (sel offset.scaled) {
        if (slot.per != 0 && slot.scale != offset.scaled) { ret res[FrameSlot, Error].err{Error.placed{p}}; }
        slot.scale = offset.scaled;
        at         = Argued{fixed: 0, per: place.stack.offset};
    }
    if (incoming) { slot.area = Area.incoming{at}; }
    or            { slot.area = Area.outgoing{at}; }
    val got: res[FrameSlot, mf.Error] = mf.slot(st.out, slot);
    if (sel got.err) { ret res[FrameSlot, Error].err{Error.machine{got.err}}; }
    ret res[FrameSlot, Error].ok{got.ok};
}

# the register a piece is sent from, a constant materialised into one of its
# own, all of them before any piece is placed, since a materialisation may
# itself call and clobber the registers pieces travel in
fun source_of(st: *State, b: u32, v: id.Value, user: id.Instruction, md: Metadata) res[u32, Error] {
    val d: *ValueData = value(st, v);
    if (!(sel d.def.constant)) { ret register(st, v); }
    val t: res[u32, Error] = virtual(st, d.type, false);
    if (sel t.err) { ret t; }
    val built: err[Error] = materialise(st, b, v, t.ok, user, md);
    if (sel built.err) { ret res[u32, Error].err{built.err}; }
    ret t;
}

# send a piece from its register to its place before a call or a return,
# noting a register it travels in as read by the transfer. a call's piece on
# the stack goes to the caller's outgoing area and a return's to the incoming
# area its caller passed it, and a piece at an operand place stays where it
# is, read as its operand by the rule's call or return form
fun send(st: *State, b: u32, v: id.Value, source: u32, p: Placed, md: Metadata, returning: bool) err[Error] {
    val d: *ValueData = value(st, v);
    if (sel p.place.operand) { ret err[Error].ok{}; }
    var m: Metadata = md;
    m.secret = st.secret.data[source];
    if (sel p.place.register) {
        val at:     Physical   = Physical.register{p.place.register};
        var ops:    [2]Operand = [2]Operand{Operand.physical{at}, Operand.virtual{Virtual{index: source}}};
        val put_ok: err[Error] = put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
        if (sel put_ok.err) { ret put_ok; }
        ret note(st, at, false);
    }
    val s: res[FrameSlot, Error] = stack_slot(st, d.type, p, returning);
    if (sel s.err) { ret err[Error].err{s.err}; }
    var ops: [2]Operand = [2]Operand{Operand.slot{s.ok}, Operand.virtual{Virtual{index: source}}};
    ret put(st, b, mi.Opcode.pseudo{pseudo.SPILL}, ?ops[0], 2, m, false);
}

# take a piece from its register after a call or at an entry, from its
# incoming slot at an entry or from the outgoing area a call's result is left
# in. a call's result at an operand place is the rule's call form's own, so it
# is defined there
fun take(st: *State, b: u32, v: id.Value, p: Placed, md: Metadata, entry: bool) err[Error] {
    if (sel p.place.operand) {
        if (entry) { ret err[Error].err{Error.placed{p}}; }
        ret err[Error].ok{};
    }
    val dest: res[u32, Error] = register(st, v);
    if (sel dest.err) { ret err[Error].err{dest.err}; }
    var m: Metadata = md;
    m.secret = st.secret.data[dest.ok];
    if (sel p.place.register) {
        var ops: [2]Operand = [2]Operand{Operand.virtual{Virtual{index: dest.ok}}, Operand.physical{Physical.register{p.place.register}}};
        ret put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
    }
    val s: res[FrameSlot, Error] = stack_slot(st, value(st, v).type, p, entry);
    if (sel s.err) { ret err[Error].err{s.err}; }
    var ops: [2]Operand = [2]Operand{Operand.virtual{Virtual{index: dest.ok}}, Operand.slot{s.ok}};
    ret put(st, b, mi.Opcode.pseudo{pseudo.RELOAD}, ?ops[0], 2, m, false);
}

# lower a call or a return in piece form: its pieces to their places, the
# rule's form, the registers the transfer reads and writes, and the results
# out of their registers
fun lower_placed(st: *State, b: u32, c: *Choice, r: *Rule, places: Slice[Placed], md: Metadata, declassifies: bool) err[Error] {
    val root:    id.Instruction     = c.found.nodes[0];
    val d:       *InstructionData   = instruction(st, root);
    val results: usize              = d.results.len;
    val pieces:  usize              = places.size - results;
    val first:   usize              = d.operands.len - pieces;
    var sources: vector.Vector[u32] = vector.init[u32](st.s.a);
    fin { vector.dnit[u32](?sources); }
    val calls: bool  = d.opcode.index == ir.CALL_PLACED.index;
    var i:     usize = 0;
    for (i < pieces) {
        var got: res[u32, Error] = res[u32, Error].ok{NONE};
        if (!(sel places.data[i].place.operand)) { got = source_of(st, b, d.operands.data[first + i], root, md); }
        if (sel got.err)                         { ret err[Error].err{got.err}; }
        val pushed: err[Error] = push_u32(?sources, got.ok);
        if (sel pushed.err) { ret pushed; }
        i = i + 1;
    }
    vector.clear[Implicit](?st.implied);
    i = 0;
    for (i < pieces) {
        val sent: err[Error] = send(st, b, d.operands.data[first + i], sources.data[i], places.data[i], md, !calls);
        if (sel sent.err) { ret sent; }
        i = i + 1;
    }
    i = 0;
    for (i < results) {
        val p: Placed = places.data[pieces + i];
        if (sel p.place.register) {
            val noted: err[Error] = note(st, Physical.register{p.place.register}, true);
            if (sel noted.err) { ret noted; }
        }
        i = i + 1;
    }
    val before: usize      = mf.instructions(st.out, Block{index: b}).size;
    val done:   err[Error] = expand(st, b, r, ?c.found, NONE, md, declassifies);
    if (sel done.err) { ret done; }
    val list: Slice[Instruction] = mf.instructions(st.out, Block{index: b});
    var at:   usize              = NONE::usize;
    var k:    usize              = before;
    for (k < list.size) {
        val t: res[u8, Error] = transfer_of(st, list.data[k]);
        if (sel t.err)                                    { ret err[Error].err{t.err}; }
        if (t.ok == effect.CALL || t.ok == effect.RETURN) { at = k; }
        k = k + 1;
    }
    if (at == NONE::usize) { ret err[Error].err{Error.transfer{root}}; }
    val stated: err[Error] = imply(st, list.data[at]);
    if (sel stated.err) { ret stated; }
    if (calls) {
        val placed: err[allocator.Error] = mf.place(st.out, list.data[at], places);
        if (sel placed.err) { ret err[Error].err{Error.alloc{placed.err}}; }
    }
    i = 0;
    for (i < results) {
        val got: err[Error] = take(st, b, d.results.data[i], places.data[pieces + i], md, false);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# take an entry's parameters from their places, at the head of its block
fun enter(st: *State, b: u32) err[Error] {
    val e:      *Entry                   = ?st.body.entry;
    val params: *vector.Vector[id.Value] = ?st.body.blocks.data[0].parameters;
    if (!(sel e.placed)) {
        if (params.len > 0) { ret err[Error].err{Error.unplaced{st.f}}; }
        ret err[Error].ok{};
    }
    val placed: err[allocator.Error] = mf.place_entry(st.out, Slice[Placed]{data: e.placed.data, size: e.placed.len});
    if (sel placed.err) { ret err[Error].err{Error.alloc{placed.err}}; }
    var i: usize = 0;
    for (i < params.len && i < e.placed.len) {
        val md:  Metadata   = Metadata{location: opt[Location].none{}, site: opt[Site].none{}, flags: NO_FLAGS, secret: false, bindings: UNBOUND};
        val got: err[Error] = take(st, b, params.data[i], e.placed.data[i], md, true);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# emit one parallel copy into block `b`, the moves in `st.moves`
#
# a destination is written only once no other move still reads it, and a
# cycle is broken by saving one destination's value in a temporary first.
# a constant reads no register, so constants are materialised last.
fun sequence(st: *State, b: u32, user: id.Instruction, md: Metadata) err[Error] {
    val grown: err[Error] = grow(?st.loc, st.out.virtuals.len, NONE);
    if (sel grown.err) { ret grown; }
    val again: err[Error] = grow(?st.pred, st.out.virtuals.len, NONE);
    if (sel again.err) { ret again; }
    vector.clear[u32](?st.ready);
    vector.clear[u32](?st.todo);
    var i: usize = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE) {
            st.loc.data[mv.dest]    = NONE;
            st.pred.data[mv.source] = NONE;
        }
        i = i + 1;
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE) {
            st.loc.data[mv.source] = mv.source;
            st.pred.data[mv.dest]  = mv.source;
            val p: err[Error] = push_u32(?st.todo, mv.dest);
            if (sel p.err) { ret p; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE && st.loc.data[mv.dest] == NONE) {
            val p: err[Error] = push_u32(?st.ready, mv.dest);
            if (sel p.err) { ret p; }
        }
        i = i + 1;
    }
    for (st.todo.len > 0) {
        for (st.ready.len > 0) {
            val popped: opt[u32] = vector.pop[u32](?st.ready);
            if (sel popped.none) { brk; }
            val dest:   u32        = popped.some;
            val from:   u32        = st.pred.data[dest];
            val holder: u32        = st.loc.data[from];
            val moved:  err[Error] = copy(st, b, dest, holder, md);
            if (sel moved.err) { ret moved; }
            st.loc.data[from] = dest;
            if (from == holder && st.pred.data[from] != NONE) {
                val p: err[Error] = push_u32(?st.ready, from);
                if (sel p.err) { ret p; }
            }
        }
        val popped: opt[u32] = vector.pop[u32](?st.todo);
        if (sel popped.none) { brk; }
        val dest: u32 = popped.some;
        if (st.loc.data[st.pred.data[dest]] != dest) {
            val k:     Class                  = mf.class_of(st.out, Virtual{index: dest});
            val saved: res[Virtual, mf.Error] = mf.virtual(st.out, k);
            if (sel saved.err) { ret err[Error].err{Error.machine{saved.err}}; }
            val p: res[usize, allocator.Error] = vector.push[bool](?st.secret, st.secret.data[dest]);
            if (sel p.err) { ret alloc_err(p.err); }
            val moved: err[Error] = copy(st, b, saved.ok.index, dest, md);
            if (sel moved.err) { ret moved; }
            st.loc.data[dest] = saved.ok.index;
            val q: err[Error] = push_u32(?st.ready, dest);
            if (sel q.err) { ret q; }
        }
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source == NONE) {
            val built: err[Error] = materialise(st, b, mv.value, mv.dest, user, md);
            if (sel built.err) { ret built; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the moves an edge's arguments make into its target's parameters
fun moves_of(st: *State, e: *Edge) err[Error] {
    vector.clear[Move](?st.moves);
    val params: *vector.Vector[id.Value] = ?st.body.blocks.data[e.block.index].parameters;
    var i:      usize                    = 0;
    for (i < e.arguments.len) {
        val arg:   id.Value = e.arguments.data[i];
        val param: id.Value = params.data[i];
        if (arg.index != param.index) {
            val d: res[u32, Error] = register(st, param);
            if (sel d.err) { ret err[Error].err{d.err}; }
            var source: u32        = NONE;
            val ad:     *ValueData = value(st, arg);
            if (!(sel ad.def.constant)) {
                val s: res[u32, Error] = register(st, arg);
                if (sel s.err) { ret err[Error].err{s.err}; }
                source = s.ok;
            }
            val p: res[usize, allocator.Error] = vector.push[Move](?st.moves, Move{dest: d.ok, source: source, value: arg});
            if (sel p.err) { ret alloc_err(p.err); }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether a matched node reads a parameter of block `k`
fun reads_parameter(st: *State, mt: *Match, k: id.Block) bool {
    var n: u32 = 0;
    for (n < mt.count) {
        val d: *InstructionData = instruction(st, mt.nodes[n]);
        var i: usize            = 0;
        for (i < d.operands.len) {
            val def: *ValueData = value(st, d.operands.data[i]);
            if (sel def.def.parameter && def.def.parameter.block.index == k.index) { ret true; }
            i = i + 1;
        }
        n = n + 1;
    }
    ret false;
}

# resolve the root's edges to machine blocks, emitting each edge's parallel
# copy before the root when it has one edge whose target it does not read,
# and in a block of its own ended by the table's jump otherwise
fun edges(st: *State, b: u32, c: *Choice, md: Metadata) err[Error] {
    val root: id.Instruction   = c.found.nodes[0];
    val d:    *InstructionData = instruction(st, root);
    vector.clear[u32](?st.targets);
    var k: usize = 0;
    for (k < d.edges.len) {
        val e:  *Edge      = ?d.edges.data[k];
        val to: u32        = st.blocks.data[e.block.index];
        val p:  err[Error] = push_u32(?st.targets, to);
        if (sel p.err) { ret p; }
        val listed: err[Error] = moves_of(st, e);
        if (sel listed.err) { ret listed; }
        if (st.moves.len > 0) {
            if (d.edges.len == 1 && !reads_parameter(st, ?c.found, e.block)) {
                val done: err[Error] = sequence(st, b, root, md);
                if (sel done.err) { ret done; }
            }
            or {
                val made: res[Block, mf.Error] = mf.block(st.out);
                if (sel made.err) { ret err[Error].err{Error.machine{made.err}}; }
                val own:  u32        = made.ok.index;
                val done: err[Error] = sequence(st, own, root, md);
                if (sel done.err) { ret done; }
                val back: err[Error] = jump(st, own, to, md);
                if (sel back.err) { ret back; }
                st.targets.data[k] = own;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# emit the table's jump to machine block `to` at the end of block `b`
fun jump(st: *State, b: u32, to: u32, md: Metadata) err[Error] {
    val emit: *Emit = ?st.s.isa.table.jump.at[0];
    var ops:  [rows.MAX_OPERANDS]Operand;
    var k:    u32   = 0;
    for (k < emit.operands.len) {
        val s: Source = emit.operands.at[k];
        if (sel s.target)  { ops[k] = Operand.block{Block{index: to}}; }
        or (sel s.literal) { ops[k] = Operand.immediate{s.literal}; }
        or (sel s.fixed)   { ops[k] = Operand.physical{Physical.register{s.fixed}}; }
        k = k + 1;
    }
    var m: Metadata = md;
    m.secret = false;
    m.flags  = NO_FLAGS;
    ret put(st, b, emit.opcode, ?ops[0], emit.operands.len, m, false);
}

# whether every use of an instruction's results is a node slot of a chosen
# match, so each match reads what it reads and none needs it emitted again.
# only a pure instruction may be read by more than one match, as each match
# repeats its computation
fun read_by_matches(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    if (!pure(xd.opcode)) { ret false; }
    var uses: usize = 0;
    var k:    usize = 0;
    for (k < xd.results.len) {
        uses = uses + value(st, xd.results.data[k]).uses.len;
        k    = k + 1;
    }
    ret uses != 0 && st.shared.data[x.index]::usize == uses;
}

# whether an instruction is a division without the checked mark that the
# target's division gives a result for on some trap of its row, read from the
# target's declared faults
fun unchecked(st: *State, i: id.Instruction) bool {
    val d: *InstructionData = instruction(st, i);
    if (d.metadata.flags.checked) { ret false; }
    val got: opt[ir.Row] = ir.row(d.opcode);
    if (sel got.none) { ret false; }
    var row: ir.Row = got.some;
    if (!ir.divides(?row)) { ret false; }
    val division: *capability.Division    = ?st.s.target.caps.arithmetic.division;
    val long:     bool                    = ir.divides_long(?row);
    val words:    capability.LongDivision = division.long;
    var n:        usize                   = 0;
    for (n < $length_of(ir.Traps)) {
        var fault: opt[capability.Fault] = opt[capability.Fault].none{};
        if (!long) { fault = capability.fault_of(division, row.effects.traps[n]); }
        or (sel words.native) {
            var l: capability.Long = words.native;
            fault = capability.long_fault_of(?l, row.effects.traps[n]);
        }
        if (sel fault.some) {
            if (sel fault.some.quiet) { ret true; }
        }
        n = n + 1;
    }
    ret false;
}

# refuse a choice that covers a division no test stands before, on a target
# whose division gives a result where the ir's traps
fun tested(st: *State, c: *Choice) err[Error] {
    var n: u32 = 0;
    for (n < c.found.count) {
        if (unchecked(st, c.found.nodes[n])) { ret err[Error].err{Error.unchecked{c.found.nodes[n]}}; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# choose a rule for every instruction of an ir block, its last first
fun choose_block(st: *State, k: id.Block) err[Error] {
    val list: *vector.Vector[id.Instruction] = ?st.body.blocks.data[k.index].instructions;
    vector.clear[Choice](?st.choices);
    vector.clear[u32](?st.impure);
    val first: err[Error] = push_u32(?st.impure, 0);
    if (sel first.err) { ret first; }
    var i: usize = 0;
    for (i < list.len) {
        val at: id.Instruction = list.data[i];
        st.position.data[at.index] = i::u32;
        var count: u32 = st.impure.data[i];
        if (!pure(instruction(st, at).opcode)) { count = count + 1; }
        val p: err[Error] = push_u32(?st.impure, count);
        if (sel p.err) { ret p; }
        i = i + 1;
    }
    i = list.len;
    for (i > 0) {
        i = i - 1;
        val at: id.Instruction = list.data[i];
        if (st.shared.data[at.index] != 0 && read_by_matches(st, at)) { st.consumed.data[at.index] = true; }
        if (instruction(st, at).opcode.index == ir.ASM.index) {
            var held: Choice = Choice{rule: NONE, found: unmatched_match(st), consumes: 0};
            held.found.nodes[0] = at;
            held.found.count    = 1;
            val p: res[usize, allocator.Error] = vector.push[Choice](?st.choices, held);
            if (sel p.err) { ret alloc_err(p.err); }
        }
        or (!st.consumed.data[at.index]) {
            val got: res[Choice, Error] = choose(st, at);
            if (sel got.err) { ret err[Error].err{got.err}; }
            var c:     Choice     = got.ok;
            val ruled: err[Error] = tested(st, ?c);
            if (sel ruled.err) { ret ruled; }
            var n: u32 = 1;
            for (n < c.found.count) {
                if (((c.consumes >> n) & 1) != 0) { st.consumed.data[c.found.nodes[n].index] = true; }
                or                                { st.shared.data[c.found.nodes[n].index] = st.shared.data[c.found.nodes[n].index] + 1; }
                n = n + 1;
            }
            val p: res[usize, allocator.Error] = vector.push[Choice](?st.choices, c);
            if (sel p.err) { ret alloc_err(p.err); }
        }
    }
    ret err[Error].ok{};
}

# a match of no rule over the function, which an inline assembly item's choice holds
fun unmatched_match(st: *State) Match {
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.target;
    mt.count    = 0;
    mt.swapped  = 0;
    ret mt;
}

fun assembled(at: id.Instruction, why: minline.Refusal) err[Error] {
    ret err[Error].err{Error.assembly{Assembled{instruction: at, refusal: why}}};
}

# the virtual register value `v` is read in at instruction `user`, a constant
# materialised into one of its own first
fun value_register(st: *State, b: u32, v: id.Value, user: id.Instruction, md: Metadata) res[u32, Error] {
    val d: *ValueData = value(st, v);
    if (!(sel d.def.constant)) { ret register(st, v); }
    val t: res[u32, Error] = virtual(st, d.type, false);
    if (sel t.err) { ret t; }
    val built: err[Error] = materialise(st, b, v, t.ok, user, md);
    if (sel built.err) { ret res[u32, Error].err{built.err}; }
    ret t;
}

# whether virtual register `r` is of class `class` of the set's register file
fun of_class(st: *State, r: u32, class: u16) bool {
    val k: Class = mf.class_of(st.out, Virtual{index: r});
    if (!(sel k.hardware)) { ret false; }
    ret k.hardware.file == mf.file(st.out) && k.hardware.index == class;
}

# the immediate constant `v` binds under constraint `c`, its bits extended
# as the constraint reads them
fun bound_immediate(st: *State, v: id.Value, c: inline.Immediate) res[opt[i64], Error] {
    var mt:  Match                        = unmatched_match(st);
    val got: res[opt[i64], match.Refusal] = match.bits(?mt, v);
    if (sel got.err)     { ret res[opt[i64], Error].err{refused(got.err)}; }
    if (sel got.ok.none) { ret res[opt[i64], Error].ok{got.ok}; }
    var x: i64 = got.ok.some;
    if (!c.signed && x < 0) {
        val s: res[types.Shape, types.Error] = types.shape(?st.m.types, value(st, v).type);
        if (sel s.err) { ret res[opt[i64], Error].err{Error.types{s.err}}; }
        if (sel s.ok.integer) {
            val w: u32 = s.ok.integer.width;
            if (w < 64) { x = (x:~u64 & ((1::u64 << w::u64) - 1)):~i64; }
        }
    }
    ret res[opt[i64], Error].ok{opt[i64].some{x}};
}

# an inline assembly item emitted into block `b` as one instruction of the
# block masc parsed: each operand of the block at a virtual register of its
# class, tied where it reads and writes one, an address based in the
# register its pointer is in, or the constant it binds, and what the block
# itself reads and writes as the instruction's implicit locations. a block
# that calls leaves undefined what the default convention row's callee does
fun assemble(st: *State, b: u32, at: id.Instruction, md: Metadata) err[Error] {
    val d: *InstructionData = instruction(st, at);
    if (d.immediates.len == 0) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.assembly)) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val blk: *ia.Assembly = imm.assembly;
    if (st.s.context == nil) { ret assembled(at, minline.Refusal.parsed{inline.UNAVAILABLE}); }
    var fp: rf.Id = rf.NONE;
    if (st.s.convention != nil) {
        val held: opt[rf.Id] = st.s.convention.pointer;
        if (sel held.some) { fp = held.some; }
    }
    val parsed: res[*minline.Inline, minline.Refusal] = minline.parse(?st.s.inlines, blk, st.s.isa.set, st.s.context, fp);
    if (sel parsed.err) { ret assembled(at, parsed.err); }
    val x:   *minline.Inline = parsed.ok;
    val n:   usize           = blk.operands.size;
    var ops: [ia.MOST_OPERANDS]Operand;
    var arg: usize           = 0;
    var out: usize           = 0;
    var k:   usize           = 0;
    for (k < n) {
        val o: *ia.Operand       = ?blk.operands.data[k];
        val c: inline.Constraint = o.constraint;
        if (sel c.class) {
            var source: u32 = NONE;
            var dest:   u32 = NONE;
            if ((o.role & mo.READ) != 0) {
                val r: res[u32, Error] = value_register(st, b, d.operands.data[arg], at, md);
                if (sel r.err) { ret err[Error].err{r.err}; }
                source = r.ok;
                arg    = arg + 1;
                if (!of_class(st, source, c.class)) { ret assembled(at, minline.Refusal.class{k::u32}); }
            }
            if ((o.role & mo.WRITE) != 0) {
                val r: res[u32, Error] = register(st, d.results.data[out]);
                if (sel r.err) { ret err[Error].err{r.err}; }
                dest = r.ok;
                out  = out + 1;
                if (!of_class(st, dest, c.class)) { ret assembled(at, minline.Refusal.class{k::u32}); }
            }
            if (source != NONE && dest != NONE) { ops[k] = Operand.tied{Tied{dest: Register.virtual{Virtual{index: dest}}, source: Register.virtual{Virtual{index: source}}}}; }
            or (source != NONE)                 { ops[k] = Operand.virtual{Virtual{index: source}}; }
            or                                  { ops[k] = Operand.virtual{Virtual{index: dest}}; }
        }
        or (sel c.memory) {
            val r: res[u32, Error] = value_register(st, b, d.operands.data[arg], at, md);
            if (sel r.err) { ret err[Error].err{r.err}; }
            arg    = arg + 1;
            ops[k] = Operand.address{Built{base: opt[Register].some{Register.virtual{Virtual{index: r.ok}}}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: 0, symbol: opt[Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
        }
        or {
            val got: res[opt[i64], Error] = bound_immediate(st, d.operands.data[arg], c.immediate);
            if (sel got.err)     { ret err[Error].err{got.err}; }
            if (sel got.ok.none) { ret assembled(at, minline.Refusal.symbolic{k::u32}); }
            arg    = arg + 1;
            ops[k] = Operand.immediate{got.ok.some};
        }
        k = k + 1;
    }
    vector.clear[Implicit](?st.implied);
    var j: usize = 0;
    for (j < x.reads.size) {
        val noted: err[Error] = note(st, Physical.register{x.reads.data[j]}, false);
        if (sel noted.err) { ret noted; }
        j = j + 1;
    }
    j = 0;
    for (j < x.writes.size) {
        val noted: err[Error] = note(st, Physical.register{x.writes.data[j]}, true);
        if (sel noted.err) { ret noted; }
        j = j + 1;
    }
    var clobbered: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    if (x.transfer == effect.CALL && st.calls.rows.size != 0 && st.s.convention != nil) { clobbered = st.s.convention.clobbered; }
    val made_at: res[Instruction, Error] = made(st, b, mi.Opcode.inline{x}, ?ops[0], n::u32, md, false, vstate.NONE, clobbered);
    if (sel made_at.err)     { ret err[Error].err{made_at.err}; }
    if (st.implied.len == 0) { ret err[Error].ok{}; }
    ret imply(st, made_at.ok);
}

# emit the chosen expansions of an ir block in order
fun emit_block(st: *State, k: id.Block) err[Error] {
    val b: u32 = st.blocks.data[k.index];
    if (k.index == 0) {
        val entered: err[Error] = enter(st, b);
        if (sel entered.err) { ret entered; }
    }
    var i: usize = st.choices.len;
    for (i > 0) {
        i = i - 1;
        val c:    *Choice          = ?st.choices.data[i];
        val d:    *InstructionData = instruction(st, c.found.nodes[0]);
        val decl: bool             = covers_declassify(st, ?c.found);
        # the count-bounded and checked marks are read by the guards and are not carried to the machine form
        var md: Metadata = d.metadata;
        md.flags.bounded = false;
        md.flags.checked = false;
        val before: u32 = st.out.instructions.len::u32;
        val root:   u32 = c.found.nodes[0].index;
        if (c.rule == NONE) {
            val done: err[Error] = assemble(st, b, c.found.nodes[0], md);
            if (sel done.err)                                                          { ret done; }
            if (st.out.instructions.len::u32 > before && st.firsts.data[root] == NONE) { st.firsts.data[root] = before; }
            cnt;
        }
        val r:      *Rule      = ?st.s.isa.table.rules.at[c.rule];
        val routed: err[Error] = edges(st, b, c, md);
        if (sel routed.err) { ret routed; }
        val pieces: opt[Slice[Placed]] = places_of(d);
        if (sel pieces.some) {
            val done: err[Error] = lower_placed(st, b, c, r, pieces.some, md, decl);
            if (sel done.err) { ret done; }
        }
        or {
            val done: err[Error] = expand(st, b, r, ?c.found, NONE, md, decl);
            if (sel done.err) { ret done; }
        }
        if (st.out.instructions.len::u32 > before && st.firsts.data[root] == NONE) { st.firsts.data[root] = before; }
    }
    ret err[Error].ok{};
}

# what a machine record reads for what an ir record reads: a constant itself,
# the virtual register of any other value, or nothing for a value selection
# gave no register, as one a rule folded into its user
fun reading_of(st: *State, r: Reads) Reading {
    if (!(sel r.operand)) { ret Reading.unavailable{}; }
    val v: id.Value = r.operand.value;
    val d: Def      = value(st, v).def;
    if (sel d.constant)                                                           { ret Reading.constant{d.constant}; }
    if (v.index::usize >= st.registers.len || st.registers.data[v.index] == NONE) { ret Reading.unavailable{}; }
    ret Reading.register{Register.virtual{Virtual{index: st.registers.data[v.index]}}};
}

# each ir record a machine record before the first machine instruction made
# for the ir instruction it stood before, or for the next one of its block
# that made any, and none for the records no instruction after them made
# anything for
fun place_points(st: *State) err[Error] {
    # a variable bound to its storage is in its slot at every point, from the first instruction of the entry on
    if (st.blocks.len > 0 && st.blocks.data[0] != NONE) {
        val entry: Slice[Instruction] = mf.instructions(st.out, Block{index: st.blocks.data[0]});
        var s:     usize              = 0;
        for (entry.size > 0 && s < st.stored.len) {
            val held:   Stored                      = st.stored.data[s];
            val made:   Point                       = Point{at: entry.data[0], binding: held.binding, piece: point.WHOLE, reads: Reading.slot{held.slot}, expression: point.PLAIN, from: Type{index: 0}};
            val pushed: res[usize, allocator.Error] = vector.push[Point](?st.out.points, made);
            if (sel pushed.err) { ret alloc_err(pushed.err); }
            s = s + 1;
        }
    }
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        if (!st.body.blocks.data[k].erased) {
            val list:    *vector.Vector[id.Instruction] = ?st.body.blocks.data[k].instructions;
            var pending: usize                          = 0;
            var p:       usize                          = 0;
            for (p < list.len) {
                val at: u32 = list.data[p].index;
                if (st.firsts.data[at] != NONE) {
                    var q: usize = pending;
                    for (q <= p) {
                        var r: u32 = st.body.instructions.data[list.data[q].index].points.first;
                        for (r != 0) {
                            val pt:   IrPoint    = st.body.points.data[r - 1];
                            val read: Reads      = pt.reads;
                            var e:    Expression = point.PLAIN;
                            var from: Type       = Type{index: 0};
                            if (sel read.operand) {
                                e    = read.operand.expression;
                                from = value(st, read.operand.value).type;
                            }
                            val made:   Point                       = Point{at: Instruction{index: st.firsts.data[at]}, binding: pt.binding, piece: pt.piece, reads: reading_of(st, read), expression: e, from: from};
                            val pushed: res[usize, allocator.Error] = vector.push[Point](?st.out.points, made);
                            if (sel pushed.err) { ret alloc_err(pushed.err); }
                            r = pt.next;
                        }
                        q = q + 1;
                    }
                    pending = p + 1;
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

fun run(st: *State) err[Error] {
    val values: err[Error] = grow(?st.registers, st.body.values.len, NONE);
    if (sel values.err) { ret values; }
    val places: err[Error] = grow(?st.position, st.body.instructions.len, 0);
    if (sel places.err) { ret places; }
    val eaten: err[Error] = grow_bool(?st.consumed, st.body.instructions.len);
    if (sel eaten.err) { ret eaten; }
    val read: err[Error] = grow(?st.shared, st.body.instructions.len, 0);
    if (sel read.err) { ret read; }
    val first: err[Error] = grow(?st.firsts, st.body.instructions.len, NONE);
    if (sel first.err) { ret first; }
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        if (st.body.blocks.data[k].erased) {
            val p: err[Error] = push_u32(?st.blocks, NONE);
            if (sel p.err) { ret p; }
        }
        or {
            val made: res[Block, mf.Error] = mf.block(st.out);
            if (sel made.err) { ret err[Error].err{Error.machine{made.err}}; }
            val p: err[Error] = push_u32(?st.blocks, made.ok.index);
            if (sel p.err) { ret p; }
        }
        k = k + 1;
    }
    k = 0;
    for (k < st.body.blocks.len) {
        if (!st.body.blocks.data[k].erased) {
            val chosen: err[Error] = choose_block(st, id.Block{index: k::u32});
            if (sel chosen.err) { ret chosen; }
            val emitted: err[Error] = emit_block(st, id.Block{index: k::u32});
            if (sel emitted.err) { ret emitted; }
        }
        k = k + 1;
    }
    ret place_points(st);
}

# select an ir function into a new machine function
# ---
# s:     the selector
# m:     the module
# f:     the function, which has a body
# calls: what its calls state to the allocator
# ret:   the machine function and the clobbers of its calls, or why
#        selection refused, with nothing left made
pub fun select(s: *Selector, m: *Module, f: id.Function, calls: *Calls) res[Selected, Error] {
    val body: res[*Body, module.Error] = module.body(m, f);
    if (sel body.err) { ret res[Selected, Error].err{Error.module{body.err}}; }
    var out:      mf.Function            = mf.init(s.a, s.isa.set);
    var clobbers: vector.Vector[Clobber] = vector.init[Clobber](s.a);
    var st:       State                  = State{
        s:         s,
        m:         m,
        f:         f,
        body:      body.ok,
        out:       ?out,
        calls:     calls,
        clobbers:  ?clobbers,
        labels:    0,
        layout:    layout.of(s.target, ?m.types, context_of(s)),
        implied:   vector.init[Implicit](s.a),
        registers: vector.init[u32](s.a),
        secret:    vector.init[bool](s.a),
        held:      vector.init[u32](s.a),
        blocks:    vector.init[u32](s.a),
        consumed:  vector.init[bool](s.a),
        shared:    vector.init[u32](s.a),
        position:  vector.init[u32](s.a),
        impure:    vector.init[u32](s.a),
        choices:   vector.init[Choice](s.a),
        targets:   vector.init[u32](s.a),
        moves:     vector.init[Move](s.a),
        loc:       vector.init[u32](s.a),
        pred:      vector.init[u32](s.a),
        ready:     vector.init[u32](s.a),
        todo:      vector.init[u32](s.a),
        firsts:    vector.init[u32](s.a),
        stored:    vector.init[Stored](s.a),
    };
    val ran: err[Error] = run(?st);
    drop_state(?st);
    if (sel ran.err) {
        mf.dnit(?out);
        vector.dnit[Clobber](?clobbers);
        ret res[Selected, Error].err{ran.err};
    }
    ret res[Selected, Error].ok{Selected{function: out, clobbers: clobbers}};
}
