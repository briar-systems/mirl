val NONE: u32 = 0xffffffff;

# a table that breaks the schema
# ---
# rule:     the rule's index in its list, an offset rule counted after the
#           materialisation rules
# constant: the rule is a materialisation or an offset rule, or the jump when
#           `rule` is NONE
# what:     what it breaks
pub rec Offence {
    rule:     u32;
    constant: bool;
    what:     str;
}

pub val NO_NODES:      str = "rule with no pattern, or a materialisation rule with one";
pub val TOO_MANY:      str = "pattern of more nodes than MAX_NODES";
pub val UNKNOWN_IR:    str = "node of an opcode the ir has no row for";
pub val LATER_PARENT:  str = "node covering an operand of itself or a later node";
pub val NO_OPERAND:    str = "node covering an operand its parent's row does not have";
pub val TWICE:         str = "operand covered by two nodes";
pub val NO_EXPANSION:  str = "rule that emits nothing";
pub val WIDE:          str = "emitted instruction of more operands than a row has";
pub val UNKNOWN_NODE:  str = "reference to a node the pattern does not have";
val     SLOT_REGISTER: str = "a stack slot's address read as a register it was never given";
pub val COVERED_VALUE: str = "register of an operand a node covers";
pub val NO_SUBJECT:    str = "materialisation rule naming a node, or a rule naming the constant";
pub val UNSTATED:      str = "source or reference left unstated";
pub val TEMPORARY:     str = "temporary past MAX_FRESH";
pub val JUMP:          str = "jump that is not one instruction to edge 0";
pub val UNKNOWN_CLASS: str = "class the target's register file does not have";
pub val LATER_PARTNER: str = "partner naming an instruction not before it, or past MAX_FRESH";
pub val UNCARRIED:     str = "loop the set's loops do not hold";
pub val UNORDERED:     str = "ordering read of a node whose row states no ordering immediate";
pub val UNCONVENED:    str = "link, argument or result register the target's convention row does not name";
pub val IMPLIED:       str = "implied register that is neither a fixed one nor one the convention names";
pub val UNROWED:       str = "call under a convention row the target does not state";
pub val UNDESCRIBED:   str = "call to a thread-local descriptor's resolver under a row that states no such call";
pub val POLICY:        str = "class whose holds state two policies";
pub val STATELESS:     str = "instruction stating a configuration state where its groups turn on none, or none where they turn on one";
pub val TWO_BASES:     str = "address naming two of a value's base, a fixed one and a temporary";
pub val TWO_INDEXES:   str = "address naming a value's index and a temporary";
pub val TWO_SYMBOLS:   str = "address naming a constant's symbol and the thread-local index cell";
pub val UNMADE:        str = "address naming a temporary no earlier instruction of the expansion makes";
pub val TABLELESS:     str = "table address in an expansion that emits no table after it, or a table given sources or emitted twice";
pub val OFFSET_SYMBOL: str = "offset rule taking a symbol";
pub val LANDING:       str = "landing instruction that is no row, or whose source is neither a literal nor a fixed register";
pub val HOT:           str = "expansion writing what may be a secret into more fixed registers than MAX_FRESH";
pub val UNFRAMED:      str = "a frame extent on an access whose address is formed from no alloca, which the ir verifier refuses";
pub val SPLIT_MARK:    str = "an expansion instruction writes secret memory and a public register, as a store with address writeback does, and one mark cannot state both";

# a rule whose loop breaks the constraint its body keeps
# ---
# rule:     the rule's index in its list
# constant: the rule is a materialisation rule
# loop:     the loop
# breach:   how its body breaks the constraint
pub rec Breached {
    rule:     u32;
    constant: bool;
    loop:     *lrow.Loop;
    breach:   lrow.Breach;
}

# what selection was asked to select
# ---
# opcode:   an ir instruction of this opcode
# constant: a constant to materialise into a register
pub tag Operation: u8 {
    opcode: opcode_row.Opcode;
    constant;
}

# an operation no rule matches, a missing rule or a missing legalisation
# ---
# operation:     what it is
# instruction:   the ir instruction, or the one using the constant
# operands:      the types of its first operands, as many as a row fixes
# operand_count: how many operands it has
# results:       the types of its first results, as many as a row states
# result_count:  how many results it has
pub rec Unmatched {
    operation:     Operation;
    instruction:   id.Instruction;
    operands:      [$length_of(opcode_row.Operands)]Type;
    operand_count: u32;
    results:       [$length_of(opcode_row.Results)]Type;
    result_count:  u32;
}

# why selection refused
# ---
# alloc:      the allocator refused storage
# module:     the module refused a read
# types:      the type table refused a read
# table:      the table breaks the schema
# breached:   a loop of the table breaks the constraint its body keeps, so
#             its eventual success is not guaranteed
# unmatched:  no rule matches an operation
# unheld:     no class of the table the build meets holds a value of this type
# ambiguous:  more than one class of the table the build meets holds a value
#             of this type
# reach:      a type the target reaches has no class or two in the table
# removed:    a value whose definition was removed
# machine:    the machine form refused an instruction the table built
# aggregate:  a value of an aggregate type, which no register holds
# unlocated:  a register a call clobbers that the locations refused, and why
# placed:     a piece at a place selection does not carry: an entry's
#             parameter at an operand place, which no call form gives it, or a
#             stack piece whose size and offset scale by two scales
# transfer:   a piece form instruction whose expansion neither calls nor returns
# lookup:     the target's thread lookup function, which the module does not
#             have, or the target states no address model to name it
# cell:       the cell of the module's thread-local index the target's model
#             names, which the module has as no global, or the target names
#             none
# layout:     the target's layout gives no size for a slot's type
# unplaced:   a function whose entry has parameters the abi legalisation did
#             not place, so nothing says where they arrive
# undecided:  a machine instruction whose transfer turns on an operand that
#             names no register yet, in the function selection was making,
#             with the source location it was made for
# unchecked:  a division without the checked mark on a target whose division
#             gives a result for a trap its opcode row states, so no test
#             stands before it
# assembly:   an inline assembly item whose block masc refused, or whose
#             operands the machine form does not bind
# naked:      an instruction of a naked function other than an inline
#             assembly item that binds nothing or an unreachable
# switched:   a timing switch opcode selection refused to place
# misaligned: a load or store of this type stating an alignment below the
#             type's own, on a target that does not carry such an access out,
#             as a packed structure's member on a freestanding aarch64 or
#             risc-v
pub tag Error: u8 {
    alloc:     allocator.Error;
    module:    module.Error;
    types:     type_table.Error;
    table:     Offence;
    breached:  Breached;
    unmatched: Unmatched;
    unheld:    Type;
    ambiguous: Type;
    reach:     reach.Error;
    removed:   id.Value;
    machine:   mf.Error;
    aggregate: Type;
    unlocated: location.Unlocated;
    placed:    Placed;
    transfer:  id.Instruction;
    lookup;
    cell;
    layout:     Type;
    unplaced:   id.Function;
    undecided:  Undecided;
    unchecked:  id.Instruction;
    assembly:   Assembled;
    naked:      id.Instruction;
    switched:   Switched;
    misaligned: Type;
}

# a timing switch opcode selection refused to place
# ---
# instruction: the ir instruction
# why:         what of the set's switch it could not place
pub rec Switched {
    instruction: id.Instruction;
    why:         str;
}

# a machine instruction selection made whose transfer is undecided
# ---
# undecided: the instruction, in the function selection was making, and why
# location:  the source location it was made for, none for none
pub rec Undecided {
    undecided: mi.Undecided;
    location:  opt[Location];
}

# an inline assembly item selection refused
# ---
# instruction: the ir instruction
# refusal:     why its block was refused
pub rec Assembled {
    instruction: id.Instruction;
    refusal:     minline.Error;
}

# what call lowering states to the register allocator
# ---
# rows: every convention row of the target resolved for the build, the
#       default first and then the others in the order the target states
#       them, so a call leaves undefined what the row it runs under and its
#       callee name. none for a selection whose calls state no clobbers
# at:   the locations the allocator numbers them by
pub rec Calls {
    rows: Slice[Resolved];
    at:   *Locations;
}

# a selected function and the clobbers its calls state
# ---
# function: the machine function
# words:    the words of one clobber set's mask
# masks:    each clobber set's mask over the register rows, one set for each
#           list of clobbered registers its calls state
# clobbers: one per call it makes that clobbers registers, naming its set
pub rec Selected {
    function: mf.Function;
    words:    u32;
    masks:    vector.Vector[u64];
    clobbers: vector.Vector[Clobber];
}

# the clobbers a selected function's calls state
pub fun clobbers_of(x: *Selected) Clobbers {
    ret Clobbers{words: x.words, masks: Slice[u64]{data: x.masks.data, size: x.masks.len}, calls: Slice[Clobber]{data: x.clobbers.data, size: x.clobbers.len}};
}

# give back a selected function
pub fun selected_dnit(x: *Selected) err[allocator.Error] {
    var err_failed: err[allocator.Error] = mf.dnit(?x.function);
    keep(?err_failed, vector.dnit[u64](?x.masks));
    keep(?err_failed, vector.dnit[Clobber](?x.clobbers));
    ret err_failed;
}

# a table made ready for one target and instruction set, checked against
# the schema once per build and read by the selector of every module the
# build compiles
# ---
# a:          the allocator its index came from, which gives it back
# isa:        the record of the target's instruction set: masc's set, the
#             table and the loops it may emit
# target:     the target, whose capabilities guard hooks read
# context:    the target's selection under its architecture's state, which
#             admits every row
# convention: the registers of the target's default convention row, which
#             the table's link, argument and result sources are checked
#             against once, nil for a selection with no convention row
# rules:      the rules each instruction can match, by its opcode, the
#             shapes of its operands and the type its rules' tests read, each
#             list by cost, the least first, and rules of one cost in table
#             order
# constants:  the constant rules a constant can match, by its type, in the
#             same order
pub rec Index {
    a:          *allocator.Allocator;
    isa:        *Isa;
    target:     *Target;
    context:    *core_state.Context;
    convention: *Registers;
    rules:      candidates.Candidates;
    constants:  candidates.Candidates;
}

# the selection of one module over a build's index
# ---
# a:       the allocator every selection takes
# index:   the build's table, lent for the selector's life
# inlines: the inline assembly blocks every selection parsed, which every
#          form of a function after selection names, held until the
#          selector is given back
pub rec Selector {
    a:       *allocator.Allocator;
    index:   *Index;
    inlines: minline.Inlines;
}

fun defect(rule: u32, constant: bool, what: str) Error {
    ret Error.table{Offence{rule: rule, constant: constant, what: what}};
}

# what a reference of a rule of `nodes` nodes breaks of the schema, none when
# it keeps it
fun ref_ok(r: Ref, nodes: u32) opt[str] {
    if (sel r.unstated) { ret opt[str].some{UNSTATED}; }
    if (sel r.constant) {
        if (nodes != 0) { ret opt[str].some{NO_SUBJECT}; }
        ret opt[str].none{};
    }
    if (nodes == 0)                                    { ret opt[str].some{NO_SUBJECT}; }
    if (sel r.operand && r.operand.node::u32 >= nodes) { ret opt[str].some{UNKNOWN_NODE}; }
    if (sel r.result && r.result.node::u32 >= nodes)   { ret opt[str].some{UNKNOWN_NODE}; }
    ret opt[str].none{};
}

# whether a node covers operand `at` of node `parent`
fun covered(r: *Rule, parent: u8, at: u8) bool {
    var j: u32 = 1;
    for (j < r.nodes.len) {
        if (r.nodes.at[j].parent == parent && r.nodes.at[j].operand == at) { ret true; }
        j = j + 1;
    }
    ret false;
}

# the register a source names, fixed in masc's file or named by the
# convention's row, none for a source of another kind or one the row does not
# name
fun named(c: *Registers, s: Source) opt[rf.Id] {
    if (sel s.fixed) { ret opt[rf.Id].some{s.fixed}; }
    if (c == nil)    { ret opt[rf.Id].none{}; }
    if (sel s.link)  { ret c.link; }
    var p:    rule.Passed  = rule.Passed{kind: 0, index: 0};
    var bank: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    if (sel s.argument) {
        p    = s.argument;
        bank = convention.bank(?c.passing, p.kind);
    }
    or (sel s.returned) {
        p    = s.returned;
        bank = convention.bank(?c.returning, p.kind);
    }
    or                               { ret opt[rf.Id].none{}; }
    if (p.index::usize >= bank.size) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{bank.data[p.index]};
}

# whether a source names a register of the convention's row
fun convened(s: Source) bool {
    ret sel s.link || sel s.argument || sel s.returned;
}

# what a source of an expansion of rule `r` breaks of the schema, none when it
# keeps it
fun source_ok(file: *rf.File, c: *Registers, r: *Rule, s: Source) opt[str] {
    val n: u32 = r.nodes.len;
    if (sel s.unstated) { ret opt[str].some{UNSTATED}; }
    if (c != nil && convened(s)) {
        val opt_named: opt[rf.Id] = named(c, s);
        if (sel opt_named.none) { ret opt[str].some{UNCONVENED}; }
    }
    if (sel s.value) {
        if (n == 0)                                  { ret opt[str].some{NO_SUBJECT}; }
        if (s.value.node::u32 >= n)                  { ret opt[str].some{UNKNOWN_NODE}; }
        if (covered(r, s.value.node, s.value.index)) { ret opt[str].some{COVERED_VALUE}; }
    }
    if (sel s.tied) {
        if (n == 0)                                            { ret opt[str].some{NO_SUBJECT}; }
        if (s.tied.value.node::u32 >= n)                       { ret opt[str].some{UNKNOWN_NODE}; }
        if (covered(r, s.tied.value.node, s.tied.value.index)) { ret opt[str].some{COVERED_VALUE}; }
    }
    if (sel s.ordered) {
        if (n == 0)                                            { ret opt[str].some{NO_SUBJECT}; }
        if (s.ordered.node::u32 >= n)                          { ret opt[str].some{UNKNOWN_NODE}; }
        if (!match.ordered(r.nodes.at[s.ordered.node].opcode)) { ret opt[str].some{UNORDERED}; }
    }
    if (sel s.address) {
        val a: rule.Addressed = s.address;
        if (n == 0 && (sel a.base.some || sel a.index.some))          { ret opt[str].some{NO_SUBJECT}; }
        if (sel a.base.some && sel a.fixed.some)                      { ret opt[str].some{TWO_BASES}; }
        if (sel a.held.some && (sel a.base.some || sel a.fixed.some)) { ret opt[str].some{TWO_BASES}; }
        if (sel a.counted.some && sel a.index.some)                   { ret opt[str].some{TWO_INDEXES}; }
        if (sel a.symbol.some && sel a.cell.some)                     { ret opt[str].some{TWO_SYMBOLS}; }
        val temporaries: [2]opt[u8] = [2]opt[u8]{a.held, a.counted};
        var q:           u32        = 0;
        for (q < 2) {
            val opt_temporaries: opt[u8] = temporaries[q];
            if (sel opt_temporaries.some && opt_temporaries.some::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
            q = q + 1;
        }
        val parts: [2]opt[Slot] = [2]opt[Slot]{a.base, a.index};
        var p:     u32          = 0;
        for (p < 2) {
            val opt_part: opt[Slot] = parts[p];
            if (sel opt_part.some) {
                if (opt_part.some.node::u32 >= n)                        { ret opt[str].some{UNKNOWN_NODE}; }
                if (covered(r, opt_part.some.node, opt_part.some.index)) { ret opt[str].some{COVERED_VALUE}; }
            }
            p = p + 1;
        }
        val f: rule.Factor = a.scale;
        if (sel f.unstated) { ret opt[str].some{UNSTATED}; }
        if (sel f.derived) {
            val opt_bad: opt[str] = ref_ok(f.derived.of, n);
            if (sel opt_bad.some) { ret opt_bad; }
        }
        val opt_disp: opt[Ref] = a.disp;
        if (sel opt_disp.some) {
            val opt_bad: opt[str] = ref_ok(opt_disp.some, n);
            if (sel opt_bad.some) { ret opt_bad; }
        }
        val opt_symbol: opt[rule.Symbolic] = a.symbol;
        if (sel opt_symbol.some) { ret ref_ok(opt_symbol.some.of, n); }
        ret opt[str].none{};
    }
    if (sel s.bits)    { ret ref_ok(s.bits, n); }
    if (sel s.width)   { ret ref_ok(s.width, n); }
    if (sel s.derived) { ret ref_ok(s.derived.of, n); }
    if (sel s.symbol)  { ret ref_ok(s.symbol.of, n); }
    if (sel s.fresh) {
        if (s.fresh.index::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
        ret ref_ok(s.fresh.like, n);
    }
    if (sel s.scratch) {
        if (s.scratch.index::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
        val opt_handled: opt[Class] = class.handled(file, s.scratch.class);
        if (sel opt_handled.none) { ret opt[str].some{UNKNOWN_CLASS}; }
    }
    if ((sel s.slot || sel s.count || sel s.table || sel s.computed) && n == 0) { ret opt[str].some{NO_SUBJECT}; }
    if (sel s.offset && n != 0)                                                 { ret opt[str].some{NO_SUBJECT}; }
    if (sel s.member) {
        if (s.member.of.index::u32 >= rule.MAX_FRESH) { ret opt[str].some{TEMPORARY}; }
        val opt_handled: opt[Class] = class.handled(file, s.member.of.class);
        if (sel opt_handled.none) { ret opt[str].some{UNKNOWN_CLASS}; }
    }
    ret opt[str].none{};
}

# whether an emitted instruction is a jump table, whose operands the root's edges give
fun tabled(emit: *Emit) bool {
    val op: mi.Opcode = emit.opcode;
    ret sel op.pseudo && op.pseudo == pseudo.TABLE;
}

# whether a rule's jump tables keep the schema: at most one, given no sources,
# in a rule with a pattern, after every instruction that names its address
fun tables_ok(r: *Rule) opt[str] {
    var table: u32 = NONE;
    var e:     u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (tabled(emit)) {
            if (table != NONE || emit.operands.len != 0) { ret opt[str].some{TABLELESS}; }
            if (r.nodes.len == 0)                        { ret opt[str].some{NO_SUBJECT}; }
            table = e;
        }
        e = e + 1;
    }
    e = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val src: Source = emit.operands.at[k];
            if (sel src.table && (table == NONE || table < e)) { ret opt[str].some{TABLELESS}; }
            k = k + 1;
        }
        e = e + 1;
    }
    ret opt[str].none{};
}

# whether an instruction of an expansion states a configuration state exactly
# where a row it stands for has groups that turn on one
fun stated_where_needed(emit: *Emit) bool {
    var needs: bool = false;
    var k:     u32  = 0;
    for (k < mi.rows_in(emit.opcode)) {
        val opt_needs: opt[u32] = vstate.needs(mi.row_in(emit.opcode, k));
        if (sel opt_needs.some) { needs = true; }
        k = k + 1;
    }
    val opt_state: opt[vstate.State] = emit.state;
    ret needs == (sel opt_state.some);
}

# whether an instruction of an expansion before instruction `e` makes
# temporary `t`, as a fresh, scratch or member source of its index
fun made_before(r: *Rule, e: u32, t: u8) bool {
    var i: u32 = 0;
    for (i < e) {
        val emit: *Emit = ?r.expansion.at[i];
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (sel s.fresh && s.fresh.index == t)      { ret true; }
            if (sel s.scratch && s.scratch.index == t)  { ret true; }
            if (sel s.member && s.member.of.index == t) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# what the expansion and the tests of rule `r` break of the schema, none when
# they keep it
fun expansion_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.expansion.len == 0) { ret opt[str].some{NO_EXPANSION}; }
    val opt_tables: opt[str] = tables_ok(r);
    if (sel opt_tables.some) { ret opt_tables; }
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (emit.operands.len > mo.MAX_OPERANDS) { ret opt[str].some{WIDE}; }
        val op: mi.Opcode = emit.opcode;
        if (sel op.loop) {
            val opt_bad: opt[str] = lrow.check(op.loop, file);
            if (sel opt_bad.some) { ret opt_bad; }
        }
        if (!stated_where_needed(emit)) { ret opt[str].some{STATELESS}; }
        var k: u32 = 0;
        for (k < emit.operands.len) {
            val s:       Source   = emit.operands.at[k];
            val opt_bad: opt[str] = source_ok(file, c, r, s);
            if (sel opt_bad.some) { ret opt_bad; }
            if (sel s.partner) {
                if (s.partner.emit::u32 >= e || e >= rule.MAX_FRESH) { ret opt[str].some{LATER_PARTNER}; }
            }
            if (sel s.address) {
                val opt_held: opt[u8] = s.address.held;
                if (sel opt_held.some && !made_before(r, e, opt_held.some)) { ret opt[str].some{UNMADE}; }
                val opt_counted: opt[u8] = s.address.counted;
                if (sel opt_counted.some && !made_before(r, e, opt_counted.some)) { ret opt[str].some{UNMADE}; }
            }
            k = k + 1;
        }
        var m: u32 = 0;
        for (m < emit.implied.len) {
            val x: Source = emit.implied.at[m].register;
            if (!(sel x.fixed || convened(x))) { ret opt[str].some{IMPLIED}; }
            if (c != nil && convened(x)) {
                val opt_named: opt[rf.Id] = named(c, x);
                if (sel opt_named.none) { ret opt[str].some{UNCONVENED}; }
            }
            m = m + 1;
        }
        e = e + 1;
    }
    var t: u32 = 0;
    for (t < r.tests.len) {
        val opt_bad: opt[str] = ref_ok(r.tests.at[t].at, r.nodes.len);
        if (sel opt_bad.some) { ret opt_bad; }
        t = t + 1;
    }
    ret opt[str].none{};
}

# whether every loop a rule emits is one of the set's loops and keeps its constraint
fun loops_ok(r: *Rule, carried: *lrow.Loops, index: u32, constant: bool) opt[Error] {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val op: mi.Opcode = r.expansion.at[e].opcode;
        if (sel op.loop) {
            val opt_broken: opt[lrow.Breach] = lrow.constrained(op.loop);
            if (sel opt_broken.some)             { ret opt[Error].some{Error.breached{Breached{rule: index, constant: constant, loop: op.loop, breach: opt_broken.some}}}; }
            if (!lrow.carries(carried, op.loop)) { ret opt[Error].some{defect(index, constant, UNCARRIED)}; }
        }
        e = e + 1;
    }
    ret opt[Error].none{};
}

# whether a rule keeps the schema
fun rule_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.nodes.len == 0)                                           { ret opt[str].some{NO_NODES}; }
    if (r.nodes.len > rule.MAX_NODES)                               { ret opt[str].some{TOO_MANY}; }
    if (r.orderings != nil && !match.ordered(r.nodes.at[0].opcode)) { ret opt[str].some{UNORDERED}; }
    var i: u32 = 0;
    for (i < r.nodes.len) {
        val n:       *Node                = ?r.nodes.at[i];
        val opt_row: opt[*opcode_row.Row] = opcode_table.at(n.opcode);
        if (sel opt_row.none) { ret opt[str].some{UNKNOWN_IR}; }
        if (i > 0) {
            if (n.parent::u32 >= i) { ret opt[str].some{LATER_PARENT}; }
            val opt_parent: opt[*opcode_row.Row] = opcode_table.at(r.nodes.at[n.parent].opcode);
            if (sel opt_parent.none)                                 { ret opt[str].some{UNKNOWN_IR}; }
            if (n.operand::u32 >= opcode_row.fixed(opt_parent.some)) { ret opt[str].some{NO_OPERAND}; }
            var j: u32 = 1;
            for (j < i) {
                if (r.nodes.at[j].parent == n.parent && r.nodes.at[j].operand == n.operand) { ret opt[str].some{TWICE}; }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret expansion_ok(file, c, r);
}

# what a materialisation rule breaks of the schema, none when it keeps it
fun constant_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    if (r.nodes.len != 0)   { ret opt[str].some{NO_NODES}; }
    if (r.orderings != nil) { ret opt[str].some{NO_SUBJECT}; }
    ret expansion_ok(file, c, r);
}

# whether an offset rule keeps the schema: a materialisation rule that takes
# no symbol, so the offset it adds is never left to add again
fun offset_ok(file: *rf.File, c: *Registers, r: *Rule) opt[str] {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (sel s.symbol || sel s.lookup || sel s.cell) { ret opt[str].some{OFFSET_SYMBOL}; }
            if (sel s.address) {
                val opt_symbol: opt[rule.Symbolic] = s.address.symbol;
                if (sel opt_symbol.some)     { ret opt[str].some{OFFSET_SYMBOL}; }
                if (sel s.address.cell.some) { ret opt[str].some{OFFSET_SYMBOL}; }
            }
            k = k + 1;
        }
        e = e + 1;
    }
    ret constant_ok(file, c, r);
}

# whether the table's jump is one instruction with one target source, to edge
# 0, and only literals and fixed registers beside it
fun jump_ok(t: *Table) bool {
    if (t.jump.len != 1) { ret false; }
    val emit: *Emit = ?t.jump.at[0];
    var k:    u32   = 0;
    var aims: u32   = 0;
    for (k < emit.operands.len) {
        val s: Source = emit.operands.at[k];
        if (sel s.target) {
            if (s.target != 0) { ret false; }
            aims = aims + 1;
        }
        or (!(sel s.literal || sel s.fixed)) { ret false; }
        k = k + 1;
    }
    ret aims == 1;
}

# whether each landing instruction is a row whose sources are literals and
# fixed registers, which name nothing of a match
fun landing_ok(t: *Table) bool {
    var e: u32 = 0;
    for (e < t.landing.len) {
        val emit: *Emit     = ?t.landing.at[e];
        val op:   mi.Opcode = emit.opcode;
        if (!(sel op.row) || emit.operands.len > mo.MAX_OPERANDS) { ret false; }
        var k: u32 = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (!(sel s.literal || sel s.fixed)) { ret false; }
            k = k + 1;
        }
        e = e + 1;
    }
    ret true;
}

# whether every row of the holds naming the class row `i` names states its policy
fun one_policy(holds: rule.Holds, file: *rf.File, i: u32) bool {
    val opt_mine: opt[Class] = rule.holder_class(file, holds.at[i].holder);
    if (sel opt_mine.none) { ret true; }
    val never: bool         = rule.never_spilled(holds, file, opt_mine.some);
    val p:     class.Policy = holds.at[i].policy;
    val spill: class.Spill  = p.spill;
    ret (sel spill.never) == never && (never || (sel p.remat.none));
}

# make a record's table ready for a target, checking it against the schema,
# once per build
# ---
# a:          the allocator the index takes
# isa:        the record of the target's instruction set
# target:     the target
# context:    the target's selection under its architecture's state
# convention: the registers of the target's default convention row, nil
#             for a selection with no convention row, where a rule naming
#             one of its registers is refused when it emits
# ret:        the index, or the first defect of the table, or a type the
#             target reaches that the holds do not give exactly one class
pub fun index(a: *allocator.Allocator, isa: *Isa, target: *Target, context: *core_state.Context, convention: *Registers) res[Index, Error] {
    val table:       *Table           = isa.table;
    val set:         *mset.Set        = isa.set;
    val err_reached: err[reach.Error] = reach.check(a, table, target, context);
    if (sel err_reached.err) { ret res[Index, Error].err{Error.reach{err_reached.err}}; }
    var file: *rf.File = nil;
    if (set.codec != nil) { file = set.codec.registers; }
    var i: u32 = 0;
    for (i < table.holds.len) {
        val h: rule.Holder = table.holds.at[i].holder;
        if (sel h.hardware) {
            val opt_handled: opt[Class] = class.handled(file, h.hardware);
            if (sel opt_handled.none) { ret res[Index, Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
        }
        if (!one_policy(table.holds, file, i)) { ret res[Index, Error].err{defect(NONE, false, POLICY)}; }
        i = i + 1;
    }
    val carried: lrow.Loops = isa.loops;
    i = 0;
    for (i < table.rules.len) {
        val opt_bad: opt[str] = rule_ok(file, convention, ?table.rules.at[i]);
        if (sel opt_bad.some) { ret res[Index, Error].err{defect(i, false, opt_bad.some)}; }
        val opt_broken: opt[Error] = loops_ok(?table.rules.at[i], ?carried, i, false);
        if (sel opt_broken.some) { ret res[Index, Error].err{opt_broken.some}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.constants.len) {
        val opt_bad: opt[str] = constant_ok(file, convention, ?table.constants.at[i]);
        if (sel opt_bad.some) { ret res[Index, Error].err{defect(i, true, opt_bad.some)}; }
        val opt_broken: opt[Error] = loops_ok(?table.constants.at[i], ?carried, i, true);
        if (sel opt_broken.some) { ret res[Index, Error].err{opt_broken.some}; }
        i = i + 1;
    }
    i = 0;
    for (i < table.offsets.len) {
        val at:      u32      = table.constants.len + i;
        val opt_bad: opt[str] = offset_ok(file, convention, ?table.offsets.at[i]);
        if (sel opt_bad.some) { ret res[Index, Error].err{defect(at, true, opt_bad.some)}; }
        val opt_broken: opt[Error] = loops_ok(?table.offsets.at[i], ?carried, at, true);
        if (sel opt_broken.some) { ret res[Index, Error].err{opt_broken.some}; }
        i = i + 1;
    }
    if (!jump_ok(table))    { ret res[Index, Error].err{defect(NONE, true, JUMP)}; }
    if (!landing_ok(table)) { ret res[Index, Error].err{defect(NONE, true, LANDING)}; }
    val res_indexed: res[candidates.Candidates, allocator.Error] = candidates.build(a, table.rules, opcode_table.rows());
    if (sel res_indexed.err) { ret res[Index, Error].err{Error.alloc{res_indexed.err}}; }
    var rules:      candidates.Candidates                       = res_indexed.ok;
    val res_formed: res[candidates.Candidates, allocator.Error] = candidates.build_constants(a, table.constants);
    if (sel res_formed.err) {
        candidates.dnit(?rules);
        ret res[Index, Error].err{Error.alloc{res_formed.err}};
    }
    ret res[Index, Error].ok{Index{
        a:          a,
        isa:        isa,
        target:     target,
        context:    context,
        convention: convention,
        rules:      rules,
        constants:  res_formed.ok,
    }};
}

# give back an index, once no selector over it is left
pub fun index_dnit(x: *Index) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?err_failed, candidates.dnit(?x.rules));
    keep(?err_failed, candidates.dnit(?x.constants));
    ret err_failed;
}

# open the selection of one module over a build's index
# ---
# a:     the allocator every selection takes
# index: the build's index, which outlives the selector
pub fun init(a: *allocator.Allocator, index: *Index) Selector {
    ret Selector{a: a, index: index, inlines: minline.init(a)};
}

# give back what a selector holds of its own, leaving the index
pub fun dnit(s: *Selector) {
    minline.dnit(?s.inlines);
}

# the rule an instruction chose and what its pattern matched
# ---
# rule:     the rule's index in the table
# found:    what the pattern matched
# consumes: one bit per node that emits nothing of its own
rec Choice {
    rule:     u32;
    found:    Match;
    consumes: u32;
}

# one parallel copy's move into a block parameter
# ---
# dest:   the parameter's register
# source: the argument's register, NONE for a constant
# value:  the argument
rec Move {
    dest:   u32;
    source: u32;
    value:  id.Value;
}

# the state of one function's selection
# ---
# registers: per ir value, its virtual register or NONE
# held:      per type, the index of the hold that holds it, NONE when unknown
# blocks:    per ir block, its machine block or NONE
# consumed:  per ir instruction, whether a pattern covers it and it emits nothing
# shared:    per ir instruction, how many node slots of chosen later patterns cover it and read its
#            operands, so the values it reads are kept in registers
# leaves:    per ir instruction, how many chosen patterns read a result of it in a register through
#            a node they cover, so it is emitted however its own uses are covered
# position:  per ir instruction of the current block, its place in the block
# impure:    per place of the current block, how many instructions before it
#            trap or touch memory
# choices:   the current block's choices, its last instruction's first
# targets:   the machine block of each edge of the current root
# moves:     the current edge's moves
# loc:       per virtual register, where a parallel copy holds its value
# pred:      per virtual register, the register a parallel copy fills it from
# ready:     the parallel copy's destinations free to be written
# todo:      the parallel copy's destinations
# calls:     what the calls state to the allocator
# own:       the registers of the row the function is under, which its
#            entry, its returns and its inline assembly read, nil for a
#            selection with no convention row, where a rule naming one of
#            its registers is refused when it emits
# clobbers:  the clobbers stated so far
# masks:     the mask of each clobber set stated so far
# words:     the words of one set's mask, 0 before the first set
# sets:      the list of registers each set was made of, so a list the
#            function's calls state again is located once
# labels:    how many labels partner operands name so far
# layout:    the target's data layout, which sizes slots
# implied:   the implicit locations of the instruction being made
# firsts:    per ir instruction, the first machine instruction made with it as
#            the root of a rule, NONE for one made with none
# stored:    the variables bound to the storage of a slot selection made
# frames:    per ir instruction, the frame slot made for it as an alloca, NONE
#            for none yet
# direct:    per ir instruction, 1 or 0, NONE when not yet asked: of a load or a
#            store, whether it reads or writes bytes of a stack slot in place,
#            and of an alloca or an address past one, whether no code is made
#            for it
# views:     the slots made within other slots, for those loads and stores
# naked:     the function states `naked`, so its body is only blocks that bind
#            nothing and its parameters stay where the convention places them
# timed:     the function's context with the timing modes constant time
#            assumes, which a rule's leak is asked under, none for a function
#            not in constant time
# code:      the frame code bound to the selection's context, which moves a
#            register to and from a slot where a load or store is a spill or a
#            reload of the slot's bytes
rec State {
    s:         *Selector;
    ctx:       *core_state.Context;
    m:         *Module;
    f:         id.Function;
    body:      *Body;
    out:       *mf.Function;
    calls:     *Calls;
    own:       *Registers;
    clobbers:  *vector.Vector[Clobber];
    masks:     *vector.Vector[u64];
    words:     u32;
    sets:      vector.Vector[Slice[rf.Id]];
    labels:    u32;
    layout:    Layout;
    implied:   vector.Vector[Implicit];
    registers: vector.Vector[u32];
    held:      vector.Vector[u32];
    blocks:    vector.Vector[u32];
    consumed:  vector.Vector[bool];
    shared:    vector.Vector[u32];
    leaves:    vector.Vector[u32];
    position:  vector.Vector[u32];
    impure:    vector.Vector[u32];
    choices:   vector.Vector[Choice];
    targets:   vector.Vector[u32];
    moves:     vector.Vector[Move];
    loc:       vector.Vector[u32];
    pred:      vector.Vector[u32];
    ready:     vector.Vector[u32];
    todo:      vector.Vector[u32];
    firsts:    vector.Vector[u32];
    stored:    vector.Vector[Stored];
    frames:    vector.Vector[u32];
    direct:    vector.Vector[u32];
    views:     vector.Vector[u32];
    naked:     bool;
    timed:     opt[*core_state.Context];
    code:      *frame_code.Admitted;
}

fun state_dnit(st: *State) {
    vector.dnit[u32](?st.firsts);
    vector.dnit[Stored](?st.stored);
    vector.dnit[u32](?st.frames);
    vector.dnit[u32](?st.direct);
    vector.dnit[u32](?st.views);
    vector.dnit[u32](?st.registers);
    vector.dnit[u32](?st.held);
    vector.dnit[u32](?st.blocks);
    vector.dnit[bool](?st.consumed);
    vector.dnit[u32](?st.shared);
    vector.dnit[u32](?st.leaves);
    vector.dnit[u32](?st.position);
    vector.dnit[u32](?st.impure);
    vector.dnit[Choice](?st.choices);
    vector.dnit[u32](?st.targets);
    vector.dnit[Move](?st.moves);
    vector.dnit[u32](?st.loc);
    vector.dnit[u32](?st.pred);
    vector.dnit[u32](?st.ready);
    vector.dnit[u32](?st.todo);
    vector.dnit[Implicit](?st.implied);
    vector.dnit[Slice[rf.Id]](?st.sets);
}

fun alloc_err(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun push_u32(v: *vector.Vector[u32], x: u32) err[Error] {
    val res_vector_pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel res_vector_pushed.err) { ret alloc_err(res_vector_pushed.err); }
    ret err[Error].ok{};
}

# grow a list to at least `n` entries, each new one `x`
fun grow(v: *vector.Vector[u32], n: usize, x: u32) err[Error] {
    if (v.len >= n) { ret err[Error].ok{}; }
    val err_room: err[allocator.Error] = slice.fill[u32](v, n - v.len, x);
    if (sel err_room.err) { ret alloc_err(err_room.err); }
    ret err[Error].ok{};
}

fun grow_bool(v: *vector.Vector[bool], n: usize) err[Error] {
    val res_room: res[usize, allocator.Error] = vector.ensure[bool](v, n);
    if (sel res_room.err) { ret alloc_err(res_room.err); }
    for (v.len < n) { vector.push[bool](v, false); }
    ret err[Error].ok{};
}

fun instruction(st: *State, i: id.Instruction) *InstructionData {
    ret ?st.body.instructions.data[i];
}

fun value(st: *State, v: id.Value) *ValueData {
    ret ?st.body.values.data[v];
}

# whether an instruction of an opcode neither traps nor touches memory
fun pure(op: opcode_row.Opcode) bool {
    val opt_opcode_table_at: opt[*opcode_row.Row] = opcode_table.at(op);
    if (sel opt_opcode_table_at.none) { ret false; }
    ret sel opt_opcode_table_at.some.effects.traps[0].unstated && !opt_opcode_table_at.some.effects.reads && !opt_opcode_table_at.some.effects.writes;
}

# whether an instruction of an opcode declassifies its operand
fun declassifies(op: opcode_row.Opcode) bool {
    val opt_opcode_table_at: opt[*opcode_row.Row] = opcode_table.at(op);
    ret sel opt_opcode_table_at.some && sel opt_opcode_table_at.some.secrecy.declassifies;
}

# whether match `mt` of rule `r` covers a declassify anywhere but at its root or as the condition a conditional branch
# at its root reads, so it would fuse a declassified value with one that is not, which no row of any table may: such a
# rule never matches, so emission's points name only what a declassify leaves
fun fuses_declassify(st: *State, r: *Rule, mt: *Match) bool {
    var n: u32 = 1;
    for (n < mt.count) {
        if (declassifies(instruction(st, mt.nodes[n]).opcode)) {
            if (r.nodes.at[n].parent != 0)                               { ret true; }
            if (instruction(st, mt.nodes[0]).opcode != opcode_table.CBR) { ret true; }
        }
        n = n + 1;
    }
    ret false;
}

# whether emit `e` of rule `r`'s expansion for match `mt`, which covers a declassify, is the instruction its point
# stands on: under a conditional branch at the root, each conditional branch it emits, which reads the condition, and
# for a declassify at the root, the last it emits, which leaves the declassified value. no other emit of the expansion
# holds that value, so none other is marked
fun carries_point(st: *State, r: *Rule, mt: *Match, e: u32) bool {
    if (instruction(st, mt.nodes[0]).opcode == opcode_table.CBR) {
        val op: mi.Opcode = r.expansion.at[e].opcode;
        if (!(sel op.row)) { ret false; }
        ret op.row.effect.control.conditional;
    }
    ret e + 1 == r.expansion.len;
}

# whether a match's root or a node it covers declassifies, so what it emits does: a copy that secrecy ends at, or a
# branch on a public condition, which emission makes a declassify point of
fun covers_declassify(st: *State, mt: *Match) bool {
    var n: u32 = 0;
    for (n < mt.count) {
        if (declassifies(instruction(st, mt.nodes[n]).opcode)) { ret true; }
        n = n + 1;
    }
    ret false;
}

# the node of a match that states the secrecy of the memory its expansion reads or writes: the one node it covers that
# accesses memory, when that node states its access (`opcode_row.states_access`), what it writes
# (`opcode_row.states_write`) or what it copies (`opcode_row.states_copy`), as the load an extending load's root covers. none when no node accesses memory, or more
# than one does, or the one that does states nothing
fun access_node(st: *State, mt: *Match) opt[u32] {
    var found: u32  = 0;
    var any:   bool = false;
    var n:     u32  = 0;
    for (n < mt.count) {
        val opt_instruction_at: opt[*opcode_row.Row] = opcode_table.at(instruction(st, mt.nodes[n]).opcode);
        if (sel opt_instruction_at.none) { ret opt[u32].none{}; }
        if (opt_instruction_at.some.effects.reads || opt_instruction_at.some.effects.writes) {
            if (any)                                                { ret opt[u32].none{}; }
            if (!opcode_row.states_memory(opt_instruction_at.some)) { ret opt[u32].none{}; }
            found = n;
            any   = true;
        }
        n = n + 1;
    }
    if (!any) { ret opt[u32].none{}; }
    ret opt[u32].some{found};
}

# the frame extent the ir instruction `x` states, its slot the frame slot made for the alloca its address is formed
# from, none where it states none
fun framed_slot(st: *State, x: id.Instruction) res[Extent, Error] {
    val d: *InstructionData = instruction(st, x);
    if (!metadata.states_extent(?d.metadata)) { ret res[Extent, Error].ok{NO_EXTENT}; }
    if (d.operands.len == 0)                  { ret res[Extent, Error].err{defect(NONE, false, UNFRAMED)}; }
    val opt_alloca: opt[id.Instruction] = frame.slot_of(st.body, d.operands.data[0]);
    if (sel opt_alloca.none) { ret res[Extent, Error].err{defect(NONE, false, UNFRAMED)}; }
    val res_slot: res[u32, Error] = slot_for(st, opt_alloca.some);
    if (sel res_slot.err) { ret res[Extent, Error].err{res_slot.err}; }
    var e: Extent = d.metadata.extent;
    e.slot = res_slot.ok;
    ret res[Extent, Error].ok{e};
}

fun result_at(mt: *Match, s: Slot) opt[id.Value] {
    ret match.result(mt, s);
}

# the value a reference names in a match, none where the match has none there
fun ref_at(st: *State, mt: *Match, r: Ref) opt[id.Value] {
    if (sel r.operand)                   { ret match.operand(mt, r.operand); }
    if (sel r.result)                    { ret result_at(mt, r.result); }
    if (sel r.constant && mt.count == 0) { ret opt[id.Value].some{mt.subject}; }
    ret opt[id.Value].none{};
}

# the error a refused read of a match is
fun refused(r: match.Error) Error {
    if (sel r.module) { ret Error.module{r.module}; }
    ret Error.types{r.types};
}

# the constant a value is, none for any other value
fun constant_of(mt: *Match, v: id.Value) res[opt[ConstantData], Error] {
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, v);
    if (sel res_constant.err) { ret res[opt[ConstantData], Error].err{refused(res_constant.err)}; }
    ret res[opt[ConstantData], Error].ok{res_constant.ok};
}

# the bits of the constant a reference names
fun ref_bits(st: *State, mt: *Match, r: Ref) res[opt[i64], Error] {
    val opt_ref_at: opt[id.Value] = ref_at(st, mt, r);
    if (sel opt_ref_at.none) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, opt_ref_at.some);
    if (sel res_bits.err) { ret res[opt[i64], Error].err{refused(res_bits.err)}; }
    ret res[opt[i64], Error].ok{res_bits.ok};
}

# the bits of the integer type of the value a reference names, none for a
# value of another type
fun width_at(st: *State, mt: *Match, r: Ref) res[opt[i64], Error] {
    val opt_ref_at: opt[id.Value] = ref_at(st, mt, r);
    if (sel opt_ref_at.none) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?st.m.types, value(st, opt_ref_at.some).type);
    if (sel res_shape.err)           { ret res[opt[i64], Error].err{Error.types{res_shape.err}}; }
    if (!(sel res_shape.ok.integer)) { ret res[opt[i64], Error].ok{opt[i64].none{}}; }
    ret res[opt[i64], Error].ok{opt[i64].some{res_shape.ok.integer.width::i64}};
}

# the bits of the target's general register, none where it states none
fun register_bits(mt: *Match) opt[i64] {
    val b: capability.Bits = mt.target.caps.widths.register;
    if (sel b.bits) { ret opt[i64].some{b.bits::i64}; }
    ret opt[i64].none{};
}

# the bits a reference names, which the guard admitted
fun immediate(st: *State, mt: *Match, r: Ref) res[i64, Error] {
    val res_ref_bits: res[opt[i64], Error] = ref_bits(st, mt, r);
    if (sel res_ref_bits.err)     { ret res[i64, Error].err{res_ref_bits.err}; }
    if (sel res_ref_bits.ok.none) { ret res[i64, Error].err{defect(NONE, false, UNSTATED)}; }
    ret res[i64, Error].ok{res_ref_bits.ok.some};
}

# the link-time address a reference names, which the guard admitted
fun address(st: *State, mt: *Match, r: Ref) res[Address, Error] {
    val opt_ref_at: opt[id.Value] = ref_at(st, mt, r);
    if (sel opt_ref_at.none) { ret res[Address, Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val res_address: res[opt[Address], match.Error] = match.address(mt, opt_ref_at.some);
    if (sel res_address.err)     { ret res[Address, Error].err{refused(res_address.err)}; }
    if (sel res_address.ok.none) { ret res[Address, Error].err{defect(NONE, false, UNSTATED)}; }
    ret res[Address, Error].ok{res_address.ok.some};
}

# the addend a symbol operand of a relocation kind takes for an address: the
# address's offset past its symbol where the kind carries one, and none where
# the offset is added after
fun addend_of(c: Address, kind: *reloc.Kind) i64 {
    if (target_address.offsets(kind)) { ret c.offset; }
    ret 0;
}

# the offset a rule's expansion leaves to add: how far the address of its
# symbol source of a relocation kind that carries no offset lies past the
# symbol, 0 for an expansion with none
fun left(st: *State, mt: *Match, r: *Rule) res[i64, Error] {
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val s:          Source             = emit.operands.at[k];
            var opt_symbol: opt[rule.Symbolic] = opt[rule.Symbolic].none{};
            if (sel s.symbol)  { opt_symbol = opt[rule.Symbolic].some{s.symbol}; }
            or (sel s.address) { opt_symbol = s.address.symbol; }
            if (sel opt_symbol.some) {
                if (!target_address.offsets(opt_symbol.some.kind)) {
                    val res_address: res[Address, Error] = address(st, mt, opt_symbol.some.of);
                    if (sel res_address.err)        { ret res[i64, Error].err{res_address.err}; }
                    if (res_address.ok.offset != 0) { ret res[i64, Error].ok{res_address.ok.offset}; }
                }
            }
            k = k + 1;
        }
        e = e + 1;
    }
    ret res[i64, Error].ok{0};
}

# how far the address a materialisation rule builds lies past its symbol,
# none for any other rule or a value that is no address
fun offset_of(mt: *Match) res[opt[i64], Error] {
    val res_offset: res[opt[i64], match.Error] = match.offset(mt);
    if (sel res_offset.err) { ret res[opt[i64], Error].err{refused(res_offset.err)}; }
    ret res[opt[i64], Error].ok{res_offset.ok};
}

# which of an instruction's first 32 operands are constants, one bit each,
# for every rule tried on it to read
fun constants_of(st: *State, d: *InstructionData) u32 {
    var held: u32   = 0;
    var k:    usize = 0;
    for (k < d.operands.len && k < 32) {
        val v: *ValueData = value(st, d.operands.data[k]);
        if (sel v.def.constant) { held = held | (1u32 << k::u32); }
        k = k + 1;
    }
    ret held;
}

# whether every node of a rule matches, its operands swapped as `swapped` says
# ---
# st:      the selection
# r:       the rule
# root:    the instruction, placed in `home`
# home:    the block it is in
# held:    its `constants_of`
# swapped: the nodes whose first two operands are taken the other way round
# mt:      the match it fills
fun matches(st: *State, r: *Rule, root: id.Instruction, home: id.Block, held: u32, swapped: u32, mt: *Match) bool {
    var asked: u32 = r.nodes.at[0].constants;
    if ((swapped & 1) != 0)   { asked = (asked & 0xffff_fffc) | ((asked & 1) << 1) | ((asked >> 1) & 1); }
    if ((asked & ~held) != 0) { ret false; }
    mt.nodes[0] = root;
    mt.count    = r.nodes.len;
    mt.swapped  = swapped;
    var i: u32 = 1;
    for (i < r.nodes.len) {
        val n: *Node = ?r.nodes.at[i];
        # match.operand of the node's parent, which `mt` holds already, read here for how often a rule fails it
        val up: *InstructionData = ?st.body.instructions.data[mt.nodes[n.parent]];
        var k:  u32              = n.operand::u32;
        if (k < 2 && ((swapped >> n.parent::u32) & 1) != 0) { k = 1 - k; }
        if (k::usize >= up.operands.len)                    { ret false; }
        val d: *ValueData = ?st.body.values.data[up.operands.data[k]];
        if (!(sel d.def.result))                 { ret false; }
        if (d.def.result.index != n.result::u32) { ret false; }
        val x:  id.Instruction   = d.def.result.instruction;
        val xd: *InstructionData = ?st.body.instructions.data[x];
        if (xd.opcode != n.opcode)                             { ret false; }
        if (!(sel xd.place.placed && xd.place.placed == home)) { ret false; }
        # a load that reads a stack slot's bytes in place is a reload of its own, never part of another's pattern
        if (xd.opcode == opcode_table.LOAD && in_place(st, x)) { ret false; }
        mt.nodes[i] = x;
        i           = i + 1;
    }
    i = 1;
    for (i < r.nodes.len) {
        val want: u32 = r.nodes.at[i].constants;
        var k:    u32 = 0;
        for (k < 32 && (want >> k) != 0) {
            if (((want >> k) & 1) != 0) {
                val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: i::u8, index: k::u8});
                if (sel opt_operand.none) { ret false; }
                val d: *ValueData = value(st, opt_operand.some);
                if (!(sel d.def.constant)) { ret false; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether every use of a value is by instruction `by`, which may read it at more than one operand
fun only_use(st: *State, v: id.Value, by: id.Instruction) bool {
    val uses: *Growing[id.Instruction] = ?value(st, v).uses;
    var i:    usize                    = 0;
    for (i < uses.len) {
        if (uses.data[i] != by) { ret false; }
        i = i + 1;
    }
    ret uses.len != 0;
}

# whether every operand at which node `i`'s parent reads value `v` is one a node of the pattern covers
fun reads_covered(st: *State, r: *Rule, mt: *Match, i: u32, v: id.Value) bool {
    val n:     *Node            = ?r.nodes.at[i];
    val up:    *InstructionData = instruction(st, mt.nodes[n.parent]);
    var reads: usize            = 0;
    var k:     usize            = 0;
    for (k < up.operands.len) {
        if (up.operands.data[k] == v) { reads = reads + 1; }
        k = k + 1;
    }
    var covers: usize = 0;
    var j:      u32   = 1;
    for (j < r.nodes.len) {
        val m: *Node = ?r.nodes.at[j];
        if (m.parent == n.parent && m.result == n.result && mt.nodes[j] == mt.nodes[i]) { covers = covers + 1; }
        j = j + 1;
    }
    ret reads == covers;
}

# which nodes a match consumes, none when it covers what it may not
#
# a node is consumed when its parent is and the parent is the only use of its
# results, reading them only at operands the pattern covers, and the root counts as consumed unless a later pattern shares it. one that is not consumed is selected again for its other uses, so
# it must neither trap nor touch memory, and a consumed one that does may
# move to its root only past instructions that do neither.
fun consumes(st: *State, r: *Rule, mt: *Match) opt[u32] {
    var mask: u32 = 1;
    if (st.shared.data[mt.nodes[0]] != 0) { mask = 0; }
    var i: u32 = 1;
    for (i < r.nodes.len) {
        val n:      *Node            = ?r.nodes.at[i];
        val x:      id.Instruction   = mt.nodes[i];
        val xd:     *InstructionData = instruction(st, x);
        val parent: id.Instruction   = mt.nodes[n.parent];
        var sole:   bool             = ((mask >> n.parent::u32) & 1) != 0;
        var k:      usize            = 0;
        for (sole && k < xd.results.len) {
            val v: id.Value = xd.results.data[k];
            if (k == n.result::usize) { sole = only_use(st, v, parent) && reads_covered(st, r, mt, i, v); }
            or                        { sole = value(st, v).uses.len == 0; }
            k = k + 1;
        }
        val clean: bool = pure(xd.opcode);
        if (sole)   { mask = mask | (1u32 << i); }
        or (!clean) { ret opt[u32].none{}; }
        if (!clean) {
            val from: u32 = st.position.data[x] + 1;
            val to:   u32 = st.position.data[mt.nodes[0]];
            if (st.impure.data[to] != st.impure.data[from]) { ret opt[u32].none{}; }
        }
        i = i + 1;
    }
    ret opt[u32].some{mask};
}

# the power of two an address's index is scaled by, none where a derived
# factor's constant is none or its hook gives no scale below 8
fun factor_of(st: *State, mt: *Match, f: rule.Factor) res[opt[u8], Error] {
    if (sel f.literal)    { ret res[opt[u8], Error].ok{opt[u8].some{f.literal}}; }
    if (!(sel f.derived)) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    val res_ref_bits: res[opt[i64], Error] = ref_bits(st, mt, f.derived.of);
    if (sel res_ref_bits.err)     { ret res[opt[u8], Error].err{res_ref_bits.err}; }
    if (sel res_ref_bits.ok.none) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    val k: i64 = f.derived.hook(res_ref_bits.ok.some);
    if (k < 0 || k > 7) { ret res[opt[u8], Error].ok{opt[u8].none{}}; }
    ret res[opt[u8], Error].ok{opt[u8].some{k::u8}};
}

# the memory operand an expansion builds, its registers the virtual ones its
# values are in and a constant there materialised first
fun built(st: *State, b: u32, mt: *Match, a: rule.Addressed, md: Metadata, fresh: *u32) res[Operand, Error] {
    var opt_base:      opt[Register] = opt[Register].none{};
    var opt_index:     opt[Register] = opt[Register].none{};
    var opt_seg:       opt[Register] = opt[Register].none{};
    val opt_base_slot: opt[Slot]     = a.base;
    if (sel opt_base_slot.some) {
        val res_operand_register: res[u32, Error] = operand_register(st, b, mt, opt_base_slot.some, md);
        if (sel res_operand_register.err) { ret res[Operand, Error].err{res_operand_register.err}; }
        opt_base = opt[Register].some{Register.virtual{res_operand_register.ok}};
    }
    val opt_index_slot: opt[Slot] = a.index;
    if (sel opt_index_slot.some) {
        val res_operand_register: res[u32, Error] = operand_register(st, b, mt, opt_index_slot.some, md);
        if (sel res_operand_register.err) { ret res[Operand, Error].err{res_operand_register.err}; }
        opt_index = opt[Register].some{Register.virtual{res_operand_register.ok}};
    }
    val opt_fixed: opt[rf.Id] = a.fixed;
    if (sel opt_fixed.some) { opt_base = opt[Register].some{Register.physical{Physical.register{opt_fixed.some}}}; }
    val opt_held: opt[u8] = a.held;
    if (sel opt_held.some) {
        if (fresh[opt_held.some] == NONE) { ret res[Operand, Error].err{defect(NONE, false, UNMADE)}; }
        opt_base = opt[Register].some{Register.virtual{(fresh[opt_held.some])}};
    }
    val opt_counted: opt[u8] = a.counted;
    if (sel opt_counted.some) {
        if (fresh[opt_counted.some] == NONE) { ret res[Operand, Error].err{defect(NONE, false, UNMADE)}; }
        opt_index = opt[Register].some{Register.virtual{(fresh[opt_counted.some])}};
    }
    val opt_segment: opt[rf.Id] = a.segment;
    if (sel opt_segment.some) { opt_seg = opt[Register].some{Register.physical{Physical.register{opt_segment.some}}}; }
    val res_scale: res[opt[u8], Error] = factor_of(st, mt, a.scale);
    if (sel res_scale.err)     { ret res[Operand, Error].err{res_scale.err}; }
    if (sel res_scale.ok.none) { ret res[Operand, Error].err{defect(NONE, false, UNSTATED)}; }
    var disp:     i64      = a.literal;
    val opt_disp: opt[Ref] = a.disp;
    if (sel opt_disp.some) {
        val res_immediate: res[i64, Error] = immediate(st, mt, opt_disp.some);
        if (sel res_immediate.err) { ret res[Operand, Error].err{res_immediate.err}; }
        disp = disp + res_immediate.ok;
    }
    var opt_symbol: opt[Symbol]      = opt[Symbol].none{};
    val opt_cell:   opt[*reloc.Kind] = a.cell;
    if (sel opt_cell.some) {
        val res_cell: res[id.Symbol, Error] = cell(st);
        if (sel res_cell.err) { ret res[Operand, Error].err{res_cell.err}; }
        opt_symbol = opt[Symbol].some{Symbol{symbol: res_cell.ok, addend: disp, kind: opt_cell.some}};
        disp       = 0;
    }
    val opt_kind: opt[rule.Symbolic] = a.symbol;
    if (sel opt_kind.some) {
        val res_address: res[Address, Error] = address(st, mt, opt_kind.some.of);
        if (sel res_address.err) { ret res[Operand, Error].err{res_address.err}; }
        opt_symbol = opt[Symbol].some{Symbol{symbol: res_address.ok.symbol, addend: addend_of(res_address.ok, opt_kind.some.kind) + disp, kind: opt_kind.some.kind}};
        disp       = 0;
    }
    var mode: mo.Mode = mo.OFFSET;
    if (a.relative) { mode = mo.RELATIVE_PC; }
    ret res[Operand, Error].ok{Operand.address{Built{base: opt_base, index: opt_index, segment: opt_seg, scale: res_scale.ok.some, disp: disp, symbol: opt_symbol, mode: mode, extend: 0, broadcast: 0}}};
}

# whether a source can stand at operand `at` of an emitted instruction
fun admitted(st: *State, mt: *Match, e: *Emit, at: u32, s: Source) res[bool, Error] {
    if (sel s.bits || sel s.derived) {
        var r: Ref = Ref.unstated{};
        if (sel s.bits)    { r = s.bits; }
        if (sel s.derived) { r = s.derived.of; }
        val res_ref_bits: res[opt[i64], Error] = ref_bits(st, mt, r);
        if (sel res_ref_bits.err)     { ret res[bool, Error].err{res_ref_bits.err}; }
        if (sel res_ref_bits.ok.none) { ret res[bool, Error].ok{false}; }
        var x: i64 = res_ref_bits.ok.some;
        if (sel s.derived) { x = s.derived.hook(x); }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, x)};
    }
    if (sel s.literal) { ret res[bool, Error].ok{mi.fits(e.opcode, at, s.literal)}; }
    if (sel s.address) {
        val a:        rule.Addressed = s.address;
        val opt_base: opt[Slot]      = a.base;
        if (sel opt_base.some) {
            val opt_operand: opt[id.Value] = match.operand(mt, opt_base.some);
            if (sel opt_operand.none) { ret res[bool, Error].ok{false}; }
        }
        val opt_index: opt[Slot] = a.index;
        if (sel opt_index.some) {
            val opt_operand: opt[id.Value] = match.operand(mt, opt_index.some);
            if (sel opt_operand.none) { ret res[bool, Error].ok{false}; }
        }
        val res_scale: res[opt[u8], Error] = factor_of(st, mt, a.scale);
        if (sel res_scale.err)     { ret res[bool, Error].err{res_scale.err}; }
        if (sel res_scale.ok.none) { ret res[bool, Error].ok{false}; }
        var disp:     i64      = a.literal;
        val opt_disp: opt[Ref] = a.disp;
        if (sel opt_disp.some) {
            val res_ref_bits: res[opt[i64], Error] = ref_bits(st, mt, opt_disp.some);
            if (sel res_ref_bits.err)     { ret res[bool, Error].err{res_ref_bits.err}; }
            if (sel res_ref_bits.ok.none) { ret res[bool, Error].ok{false}; }
            disp = disp + res_ref_bits.ok.some;
        }
        var symbolic:   bool               = sel a.cell.some;
        val opt_symbol: opt[rule.Symbolic] = a.symbol;
        if (sel opt_symbol.some) {
            val opt_ref_at: opt[id.Value] = ref_at(st, mt, opt_symbol.some.of);
            if (sel opt_ref_at.none) { ret res[bool, Error].ok{false}; }
            val res_address: res[opt[Address], match.Error] = match.address(mt, opt_ref_at.some);
            if (sel res_address.err)     { ret res[bool, Error].err{refused(res_address.err)}; }
            if (sel res_address.ok.none) { ret res[bool, Error].ok{false}; }
            symbolic = true;
        }
        var mode: mo.Mode = mo.OFFSET;
        if (a.relative) { mode = mo.RELATIVE_PC; }
        ret res[bool, Error].ok{mi.fits_address(e.opcode, at, res_scale.ok.some, disp, mode, symbolic)};
    }
    if (sel s.width) {
        val res_width_at: res[opt[i64], Error] = width_at(st, mt, s.width);
        if (sel res_width_at.err)     { ret res[bool, Error].err{res_width_at.err}; }
        if (sel res_width_at.ok.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, res_width_at.ok.some)};
    }
    if (sel s.register) {
        val opt_register_bits: opt[i64] = register_bits(mt);
        if (sel opt_register_bits.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, opt_register_bits.some)};
    }
    if (sel s.symbol) {
        val opt_ref_at: opt[id.Value] = ref_at(st, mt, s.symbol.of);
        if (sel opt_ref_at.none) { ret res[bool, Error].ok{false}; }
        val res_address: res[opt[Address], match.Error] = match.address(mt, opt_ref_at.some);
        if (sel res_address.err) { ret res[bool, Error].err{refused(res_address.err)}; }
        ret res[bool, Error].ok{sel res_address.ok.some};
    }
    if (sel s.value) {
        val opt_operand: opt[id.Value] = match.operand(mt, s.value);
        ret res[bool, Error].ok{sel opt_operand.some};
    }
    if (sel s.tied) {
        val opt_operand: opt[id.Value] = match.operand(mt, s.tied.value);
        if (sel opt_operand.none) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.tied.result::usize < d.results.len};
    }
    if (sel s.ordered) {
        val opt_ordering: opt[opcode_rule.Ordering] = match.ordering(mt, s.ordered.node);
        if (sel opt_ordering.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, rule.form(s.ordered.forms, opt_ordering.some))};
    }
    if (sel s.fresh) {
        val opt_ref_at: opt[id.Value] = ref_at(st, mt, s.fresh.like);
        ret res[bool, Error].ok{sel opt_ref_at.some};
    }
    if (sel s.scratch || sel s.fixed || convened(s))               { ret res[bool, Error].ok{true}; }
    if (sel s.slot || sel s.partner || sel s.lookup || sel s.cell) { ret res[bool, Error].ok{true}; }
    if (sel s.count) {
        if (mt.count == 0) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        if (d.edges.len == 0) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, s.count((d.edges.len - 1)::i64))};
    }
    if (sel s.table) { ret res[bool, Error].ok{mt.count != 0}; }
    if (sel s.offset) {
        val res_offset_of: res[opt[i64], Error] = offset_of(mt);
        if (sel res_offset_of.err)     { ret res[bool, Error].err{res_offset_of.err}; }
        if (sel res_offset_of.ok.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, s.offset(res_offset_of.ok.some))};
    }
    if (sel s.member) { ret res[bool, Error].ok{true}; }
    if (sel s.computed) {
        if (mt.count == 0) { ret res[bool, Error].ok{false}; }
        val opt_computed: opt[i64] = s.computed(mt);
        if (sel opt_computed.none) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{mi.fits(e.opcode, at, opt_computed.some)};
    }
    if (sel s.result) {
        if (mt.count == 0) { ret res[bool, Error].ok{s.result == 0}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.result::usize < d.results.len};
    }
    if (sel s.target) {
        if (mt.count == 0) { ret res[bool, Error].ok{false}; }
        val d: *InstructionData = instruction(st, mt.nodes[0]);
        ret res[bool, Error].ok{s.target::usize < d.edges.len};
    }
    ret res[bool, Error].ok{false};
}

# the bits of a pointer into address space `space` of a target, 0 for a space
# it has no row of or a pointer with no address
fun pointer_bits(t: *Target, space: u32) u64 {
    val rows: Slice[capability.Space] = t.caps.widths.pointers;
    var i:    usize                   = 0;
    for (i < rows.size) {
        if (rows.data[i].space == space) {
            val p: capability.Pointer = target_record.pointer_of(t, ?rows.data[i]);
            if (sel p.physical) { ret p.physical.size * 8; }
            ret 0;
        }
        i = i + 1;
    }
    ret 0;
}

# whether type `ty` has width `w` against the target's general register, an
# integer or a pointer of the register's width, of a part or of several
# registers, any type for a width of any
fun widened(st: *State, w: rule.Width, ty: Type) res[bool, Error] {
    if (sel w.any) { ret res[bool, Error].ok{true}; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?st.m.types, ty);
    if (sel res_shape.err) { ret res[bool, Error].err{Error.types{res_shape.err}}; }
    val reg: Bits = st.s.index.target.caps.widths.register;
    if (!(sel reg.bits)) { ret res[bool, Error].ok{false}; }
    var bits: u64 = 0;
    if (sel res_shape.ok.integer) { bits = res_shape.ok.integer.width::u64; }
    or (sel res_shape.ok.pointer) { bits = pointer_bits(st.s.index.target, res_shape.ok.pointer.space); }
    if (bits == 0)                { ret res[bool, Error].ok{false}; }
    val held: u64 = reg.bits::u64;
    if (sel w.register) { ret res[bool, Error].ok{bits == held}; }
    if (sel w.part) {
        val n: u64 = w.part::u64;
        ret res[bool, Error].ok{n != 0 && bits * n == held};
    }
    if (sel w.whole) {
        val n: u64 = w.whole::u64;
        ret res[bool, Error].ok{bits == held * n};
    }
    ret res[bool, Error].ok{false};
}

# whether a rule's guard holds of a match: its type tests, its orderings, the
# extensions its rows and its loops' rows require with its sources, the offset
# its expansion leaves to add and its hook, in that order
fun guard(st: *State, r: *Rule, mt: *Match) res[bool, Error] {
    var t: u32 = 0;
    for (t < r.tests.len) {
        val test:       *rule.Test    = ?r.tests.at[t];
        val opt_ref_at: opt[id.Value] = ref_at(st, mt, test.at);
        if (sel opt_ref_at.none) { ret res[bool, Error].ok{false}; }
        var ty: Type = value(st, opt_ref_at.some).type;
        if (test.lanes) {
            val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?st.m.types, ty);
            if (sel res_shape_at.err)          { ret res[bool, Error].err{Error.types{res_shape_at.err}}; }
            if (!(sel res_shape_at.ok.vector)) { ret res[bool, Error].ok{false}; }
            ty = res_shape_at.ok.vector.element;
        }
        val res_held: res[bool, type_table.Error] = check.within(?st.m.types, test.class, ty);
        if (sel res_held.err) { ret res[bool, Error].err{Error.types{res_held.err}}; }
        if (!res_held.ok)     { ret res[bool, Error].ok{false}; }
        val res_wide: res[bool, Error] = widened(st, test.width, ty);
        if (sel res_wide.err) { ret res_wide; }
        if (!res_wide.ok)     { ret res_wide; }
        t = t + 1;
    }
    if (r.orderings != nil) {
        val opt_ordering: opt[opcode_rule.Ordering] = match.ordering(mt, 0);
        if (sel opt_ordering.none)                               { ret res[bool, Error].ok{false}; }
        if (!opcode_rule.holds(@r.orderings, opt_ordering.some)) { ret res[bool, Error].ok{false}; }
    }
    var e: u32 = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        var n:    u32   = 0;
        for (n < mi.rows_in(emit.opcode)) {
            if (!core_state.admits(st.ctx, mi.row_in(emit.opcode, n).requires)) { ret res[bool, Error].ok{false}; }
            n = n + 1;
        }
        var k: u32 = 0;
        for (k < emit.operands.len) {
            val res_admitted: res[bool, Error] = admitted(st, mt, emit, k, emit.operands.at[k]);
            if (sel res_admitted.err) { ret res_admitted; }
            if (!res_admitted.ok)     { ret res_admitted; }
            k = k + 1;
        }
        e = e + 1;
    }
    if (mt.count != 0) {
        val res_rest: res[i64, Error] = left(st, mt, r);
        if (sel res_rest.err) { ret res[bool, Error].err{res_rest.err}; }
        if (res_rest.ok != 0) { ret res[bool, Error].ok{false}; }
    }
    if (r.hook != nil && !r.hook(mt)) { ret res[bool, Error].ok{false}; }
    ret res[bool, Error].ok{true};
}

fun unmatched_of(st: *State, i: id.Instruction, op: Operation) Unmatched {
    val d: *InstructionData = instruction(st, i);
    var u: Unmatched;
    u.operation     = op;
    u.instruction   = i;
    u.operand_count = d.operands.len::u32;
    u.result_count  = d.results.len::u32;
    var k: usize = 0;
    for (k < d.operands.len && k < $length_of(opcode_row.Operands)) {
        u.operands[k] = value(st, d.operands.data[k]).type;
        k             = k + 1;
    }
    k = 0;
    for (k < d.results.len && k < $length_of(opcode_row.Results)) {
        u.results[k] = value(st, d.results.data[k]).type;
        k            = k + 1;
    }
    ret u;
}

# what defines operand `k` of an instruction, as the rules' lists split them: a
# constant or an instruction of its block, any other reads as no rule's shape
fun shape(st: *State, d: *InstructionData, k: usize) u32 {
    if (k >= d.operands.len) { ret candidates.ANY; }
    val v: *ValueData = value(st, d.operands.data[k]);
    if (sel v.def.constant)    { ret candidates.CONSTANT; }
    if (!(sel v.def.result))   { ret candidates.ANY; }
    if (!(sel d.place.placed)) { ret candidates.ANY; }
    val home: id.Block         = d.place.placed;
    val x:    *InstructionData = instruction(st, v.def.result.instruction);
    if (sel x.place.placed && x.place.placed == home) { ret candidates.defined_by(x.opcode); }
    ret candidates.ANY;
}

# whether a match reads or makes a secret
fun touches_secret(st: *State, mt: *Match) bool {
    var n: u32 = 0;
    for (n < mt.count) {
        val d: *InstructionData = instruction(st, mt.nodes[n]);
        if (d.metadata.secret) { ret true; }
        var k: usize = 0;
        for (k < d.operands.len) {
            if (value(st, d.operands.data[k]).secret) { ret true; }
            k = k + 1;
        }
        k = 0;
        for (k < d.results.len) {
            if (value(st, d.results.data[k]).secret) { ret true; }
            k = k + 1;
        }
        n = n + 1;
    }
    ret false;
}

# whether a rule that holds of a match would put a secret in a row whose timing
# depends on it, which the timing check would refuse (`mirl.machine.timing`). a
# match that declassifies reads what it covers as public, so it never leaks: a
# rule that gave way there would leave the branch on a guard's condition to one
# that no longer covers its declassify
fun leaks(st: *State, r: *Rule, mt: *Match) bool {
    if (sel st.timed.none)         { ret false; }
    if (covers_declassify(st, mt)) { ret false; }
    ret touches_secret(st, mt) && machine_timing.dependent(r, st.timed.some);
}

# the atom of the type of a value
fun atom(st: *State, v: id.Value) u32 {
    ret candidates.atom_of(?st.s.index.rules, ?st.m.types, value(st, v).type);
}

# the atom of the key of a split an instruction reads, NONE where the split has
# none, the instruction lacks it, or a paired key's two operands differ
fun key_atom(st: *State, d: *InstructionData, s: *candidates.Split) u32 {
    val k: u32 = s.key;
    if (k == candidates.NONE || k == candidates.BUILT) { ret candidates.NONE; }
    if (k >= candidates.RESULTS) {
        val r: usize = (k - candidates.RESULTS)::usize;
        if (r >= d.results.len) { ret candidates.NONE; }
        ret atom(st, d.results.data[r]);
    }
    if (k::usize >= d.operands.len) { ret candidates.NONE; }
    val a: u32 = atom(st, d.operands.data[k]);
    if (!s.paired)                         { ret a; }
    if (d.operands.len < 2)                { ret candidates.NONE; }
    if (atom(st, d.operands.data[1]) != a) { ret candidates.NONE; }
    ret a;
}

# the least cost rule for an instruction whose pattern matches and guard
# holds, the first in table order among rules of one cost. a rule that leaks
# gives way to the next that does not, and is taken where every rule leaks, so
# the timing check refuses it at the instruction
fun choose(st: *State, i: id.Instruction) res[Choice, Error] {
    val d:  *InstructionData       = instruction(st, i);
    val op: opcode_row.Opcode      = d.opcode;
    val cs: *candidates.Candidates = ?st.s.index.rules;
    val at: u32                    = candidates.list(cs, op, shape(st, d, 0), shape(st, d, 1), key_atom(st, d, candidates.split_of(cs, op)));
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.index.target;
    var leaking: Choice;
    var leaked:  bool = false;
    var k:       u32  = cs.starts.data[at];
    var end:     u32  = k;
    var home:    id.Block;
    if (sel d.place.placed) {
        end  = cs.starts.data[at + 1];
        home = d.place.placed;
    }
    val held: u32 = constants_of(st, d);
    for (k < end) {
        val index: u32   = cs.rules.data[k];
        val r:     *Rule = ?st.s.index.isa.table.rules.at[index];
        val swaps: u32   = cs.swaps.data[index];
        var mask:  u32   = 0;
        for {
            if (matches(st, r, i, home, held, mask, ?mt) && !fuses_declassify(st, r, ?mt)) {
                val opt_eaten: opt[u32] = consumes(st, r, ?mt);
                if (sel opt_eaten.some) {
                    val res_kept: res[bool, Error] = guard(st, r, ?mt);
                    if (sel res_kept.err) { ret res[Choice, Error].err{res_kept.err}; }
                    if (res_kept.ok) {
                        val picked: Choice = Choice{rule: index, found: mt, consumes: opt_eaten.some};
                        if (!leaks(st, r, ?mt)) { ret res[Choice, Error].ok{picked}; }
                        if (!leaked) {
                            leaking = picked;
                            leaked  = true;
                        }
                    }
                }
            }
            if (mask == swaps) { brk; }
            mask = ((mask | ~swaps) + 1) & swaps;
        }
        k = k + 1;
    }
    if (leaked) { ret res[Choice, Error].ok{leaking}; }
    ret res[Choice, Error].err{Error.unmatched{unmatched_of(st, i, Operation.opcode{op})}};
}

# the selector's context, none for a selection with none
fun context_of(s: *Selector) opt[*core_state.Context] {
    if (s.index.context == nil) { ret opt[*core_state.Context].none{}; }
    ret opt[*core_state.Context].some{s.index.context};
}

# the context the function being selected is selected under, none for a
# selection with none
fun context_in(st: *State) opt[*core_state.Context] {
    if (st.ctx == nil) { ret opt[*core_state.Context].none{}; }
    ret opt[*core_state.Context].some{st.ctx};
}

# the class the table holds a type in, by its one row the build meets
fun class_for(st: *State, ty: Type) res[Class, Error] {
    val err_grown: err[Error] = grow(?st.held, ty::usize + 1, NONE);
    if (sel err_grown.err) { ret res[Class, Error].err{err_grown.err}; }
    var at: u32 = st.held.data[ty];
    if (at == NONE) {
        val res_admitting: res[reach.Admit, reach.Error] = reach.admitting(?st.m.types, st.s.index.isa.table.holds, ty, context_in(st));
        if (sel res_admitting.err)       { ret res[Class, Error].err{Error.reach{res_admitting.err}}; }
        if (res_admitting.ok.count == 0) { ret res[Class, Error].err{Error.unheld{ty}}; }
        if (res_admitting.ok.count > 1)  { ret res[Class, Error].err{Error.ambiguous{ty}}; }
        at               = res_admitting.ok.first;
        st.held.data[ty] = at;
    }
    val holder: rule.Holder = st.s.index.isa.table.holds.at[at].holder;
    if (sel holder.hardware) {
        val opt_handled: opt[Class] = class.handled(mf.file(st.out), holder.hardware);
        if (sel opt_handled.none) { ret res[Class, Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
        ret res[Class, Error].ok{opt_handled.some};
    }
    ret res[Class, Error].ok{Class.memory{holder.memory}};
}

# a new virtual register of a class
fun virtual_in(st: *State, k: Class, secret: bool) res[u32, Error] {
    val res_made: res[Virtual, mf.Error] = mf.virtual(st.out, k, secret);
    if (sel res_made.err) { ret res[u32, Error].err{Error.machine{res_made.err}}; }
    ret res[u32, Error].ok{res_made.ok};
}

# a new virtual register for a value of a type
fun virtual(st: *State, ty: Type, secret: bool) res[u32, Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?st.m.types, ty);
    if (sel res_shape_at.err)                                                                    { ret res[u32, Error].err{Error.types{res_shape_at.err}}; }
    if (sel res_shape_at.ok.array || sel res_shape_at.ok.structure || sel res_shape_at.ok.union) { ret res[u32, Error].err{Error.aggregate{ty}}; }
    val res_class_for: res[Class, Error] = class_for(st, ty);
    if (sel res_class_for.err) { ret res[u32, Error].err{res_class_for.err}; }
    ret virtual_in(st, res_class_for.ok, secret);
}

# the virtual register a value is held in, made when first asked for
fun register(st: *State, v: id.Value) res[u32, Error] {
    if (st.registers.data[v] != NONE) { ret res[u32, Error].ok{st.registers.data[v]}; }
    val d: *ValueData = value(st, v);
    if (sel d.def.removed) { ret res[u32, Error].err{Error.removed{v}}; }
    val opt_slotted: opt[id.Instruction] = slot_address(st, v);
    if (sel opt_slotted.some) { ret res[u32, Error].err{defect(NONE, false, SLOT_REGISTER)}; }
    val res_made: res[u32, Error] = virtual(st, d.type, d.secret);
    if (sel res_made.err) { ret res_made; }
    st.registers.data[v] = res_made.ok;
    ret res_made;
}

# how machine instruction `at` transfers control, or why it is undecided
fun transfer_of(st: *State, at: Instruction) res[u8, Error] {
    val got: query.Answer[effect.Control] = mi.transfer(mf.file(st.out), mf.data(st.out, at));
    if (sel got.undecided) { ret res[u8, Error].err{Error.undecided{Undecided{undecided: mi.Undecided{instruction: at, why: got.undecided}, location: mf.location(st.out, at)}}}; }
    ret res[u8, Error].ok{got.decided.transfer};
}

# append an instruction to block `b` under the configuration state it runs
# under, stating `clobbered` at it when it is a call
fun made(st: *State, b: u32, op: mi.Opcode, operands: *Operand, count: u32, md: Metadata, declassifies: bool, state: opt[vstate.State], clobbered: Slice[rf.Id]) res[Instruction, Error] {
    val res_made: res[Instruction, mf.Error] = mf.append(st.out, b, op, Slice[Operand]{data: operands, size: count::usize}, md, declassifies, state);
    if (sel res_made.err) { ret res[Instruction, Error].err{Error.machine{res_made.err}}; }
    val at:       Instruction    = res_made.ok;
    val res_kind: res[u8, Error] = transfer_of(st, at);
    if (sel res_kind.err)                                  { ret res[Instruction, Error].err{res_kind.err}; }
    if (res_kind.ok != effect.CALL || clobbered.size == 0) { ret res[Instruction, Error].ok{at}; }
    val res_set: res[u32, Error] = set_of(st, clobbered);
    if (sel res_set.err) { ret res[Instruction, Error].err{res_set.err}; }
    val res_clobbers_pushed: res[usize, allocator.Error] = vector.push[Clobber](st.clobbers, Clobber{instruction: at, set: res_set.ok});
    if (sel res_clobbers_pushed.err) { ret res[Instruction, Error].err{Error.alloc{res_clobbers_pushed.err}}; }
    ret res[Instruction, Error].ok{at};
}

# the clobber set of a list of clobbered registers, made the first time the
# function's calls state the list
fun set_of(st: *State, clobbered: Slice[rf.Id]) res[u32, Error] {
    var k: usize = 0;
    for (k < st.sets.len) {
        if (st.sets.data[k].data == clobbered.data && st.sets.data[k].size == clobbered.size) { ret res[u32, Error].ok{k::u32}; }
        k = k + 1;
    }
    if (st.calls.at.file == nil) { ret res[u32, Error].err{Error.unlocated{location.Unlocated.unfiled{clobbered.data[0]}}}; }
    if (st.words == 0)           { st.words = (st.calls.at.file.register_count + 63) / 64; }
    val base:     usize                = st.masks.len;
    val err_room: err[allocator.Error] = slice.fill[u64](st.masks, st.words::usize, 0);
    if (sel err_room.err) { ret res[u32, Error].err{Error.alloc{err_room.err}}; }
    var i: usize = 0;
    for (i < clobbered.size) {
        val res_loc: res[u32, location.Unlocated] = location.locate(st.calls.at, Physical.register{clobbered.data[i]});
        if (sel res_loc.err) {
            vector.truncate[u64](st.masks, base);
            ret res[u32, Error].err{Error.unlocated{res_loc.err}};
        }
        val w: usize = base + (res_loc.ok / 64)::usize;
        st.masks.data[w] = st.masks.data[w] | ((1::u64) << (res_loc.ok % 64)::u64);
        i                = i + 1;
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[Slice[rf.Id]](?st.sets, clobbered);
    if (sel res_pushed.err) { ret res[u32, Error].err{Error.alloc{res_pushed.err}}; }
    ret res[u32, Error].ok{st.sets.len::u32 - 1};
}

fun put(st: *State, b: u32, op: mi.Opcode, operands: *Operand, count: u32, md: Metadata, declassifies: bool) err[Error] {
    val res_made: res[Instruction, Error] = made(st, b, op, operands, count, md, declassifies, vstate.NONE, Slice[rf.Id]{data: nil, size: 0});
    if (sel res_made.err) { ret err[Error].err{res_made.err}; }
    ret err[Error].ok{};
}

# state the implicit locations gathered in `st.implied` on an instruction
fun imply(st: *State, i: Instruction) err[Error] {
    val err_stated: err[mf.Error] = mf.imply(st.out, i, Slice[Implicit]{data: st.implied.data, size: st.implied.len});
    if (sel err_stated.err) { ret err[Error].err{Error.machine{err_stated.err}}; }
    ret err[Error].ok{};
}

# gather an implicit location of the instruction being made in `st.implied`
fun note(st: *State, at: Physical, write: bool) err[Error] {
    val res_implied_pushed: res[usize, allocator.Error] = vector.push[Implicit](?st.implied, Implicit{location: at, write: write});
    if (sel res_implied_pushed.err) { ret alloc_err(res_implied_pushed.err); }
    ret err[Error].ok{};
}

fun copy(st: *State, b: u32, dest: u32, source: u32, md: Metadata) err[Error] {
    var ops: [2]Operand = [2]Operand{Operand.virtual{dest}, Operand.virtual{source}};
    var m:   Metadata   = md;
    m.secret = mf.secret_of(st.out, source);
    ret put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
}

# the alloca whose result `v` is, where the slot's address is formed again at each use: an
# alloca's result no variable is bound to. no register then holds the address between two
# uses, which across a call would be a register the function saves and restores
fun slot_address(st: *State, v: id.Value) opt[id.Instruction] {
    val d: *ValueData = value(st, v);
    if (d.bound.len != 0) { ret opt[id.Instruction].none{}; }
    if (sel d.def.result) {
        val x: id.Instruction = d.def.result.instruction;
        if (instruction(st, x).opcode == opcode_table.ALLOCA) { ret opt[id.Instruction].some{x}; }
    }
    ret opt[id.Instruction].none{};
}

# whether `v` is formed where it is read instead of held in a register of its own: a
# constant, or a stack slot's address
fun formed(st: *State, v: id.Value) bool {
    val d: *ValueData = value(st, v);
    if (sel d.def.constant) { ret true; }
    val opt_slotted: opt[id.Instruction] = slot_address(st, v);
    ret sel opt_slotted.some;
}

# materialise a constant into register `dest` by the least cost constant rule whose guard holds,
# or form a stack slot's address there
fun materialise(st: *State, b: u32, v: id.Value, dest: u32, user: id.Instruction, md: Metadata) err[Error] {
    val opt_slotted: opt[id.Instruction] = slot_address(st, v);
    if (sel opt_slotted.some) {
        val res_slot: res[u32, Error] = slot_for(st, opt_slotted.some);
        if (sel res_slot.err) { ret err[Error].err{res_slot.err}; }
        var m: Metadata = md;
        m.secret = false;
        m.flags  = NO_FLAGS;
        var ops: [2]Operand = [2]Operand{Operand.virtual{dest}, Operand.slot{res_slot.ok}};
        ret put(st, b, mi.Opcode.pseudo{pseudo.ADDRESS}, ?ops[0], 2, m, false);
    }
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.index.target;
    mt.count    = 0;
    mt.subject  = v;
    val cs:   *candidates.Candidates = ?st.s.index.constants;
    var kind: u32                    = candidates.NONE;
    if (candidates.split_of(cs, 0).key == candidates.BUILT) { kind = candidates.atom_of(cs, ?st.m.types, value(st, v).type); }
    val at: u32 = candidates.list(cs, 0, candidates.ANY, candidates.ANY, kind);
    var k:  u32 = cs.starts.data[at];
    for (k < cs.starts.data[at + 1]) {
        val r:        *Rule            = ?st.s.index.isa.table.constants.at[cs.rules.data[k]];
        val res_held: res[bool, Error] = guard(st, r, ?mt);
        if (sel res_held.err) { ret err[Error].err{res_held.err}; }
        if (res_held.ok) {
            var m: Metadata = md;
            m.secret = false;
            m.flags  = NO_FLAGS;
            val res_rest: res[i64, Error] = left(st, ?mt, r);
            if (sel res_rest.err) { ret err[Error].err{res_rest.err}; }
            val err_formed: err[Error] = expand(st, b, r, ?mt, dest, m, false);
            if (sel err_formed.err || res_rest.ok == 0) { ret err_formed; }
            ret add_offset(st, b, ?mt, dest, m, user);
        }
        k = k + 1;
    }
    ret err[Error].err{unmatched_constant(st, v, user)};
}

# add the offset an address constant lies past its symbol to register `dest`,
# where a constant rule built the symbol's address, by the first offset rule
# whose guard holds
fun add_offset(st: *State, b: u32, mt: *Match, dest: u32, md: Metadata, user: id.Instruction) err[Error] {
    val offsets: rule.Rules = st.s.index.isa.table.offsets;
    var k:       u32        = 0;
    for (k < offsets.len) {
        val r:        *Rule            = ?offsets.at[k];
        val res_held: res[bool, Error] = guard(st, r, mt);
        if (sel res_held.err) { ret err[Error].err{res_held.err}; }
        if (res_held.ok)      { ret expand(st, b, r, mt, dest, md, false); }
        k = k + 1;
    }
    ret err[Error].err{unmatched_constant(st, mt.subject, user)};
}

# no rule materialises constant `v`, which `user` reads
fun unmatched_constant(st: *State, v: id.Value, user: id.Instruction) Error {
    var u: Unmatched;
    u.operation     = Operation.constant{};
    u.instruction   = user;
    u.operands[0]   = value(st, v).type;
    u.operand_count = 1;
    u.result_count  = 0;
    ret Error.unmatched{u};
}

# the virtual register an operand of a node is read in, a constant there
# materialised into one of its own first
fun operand_register(st: *State, b: u32, mt: *Match, at: Slot, md: Metadata) res[u32, Error] {
    val opt_operand: opt[id.Value] = match.operand(mt, at);
    if (sel opt_operand.none) { ret res[u32, Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val v: id.Value   = opt_operand.some;
    val d: *ValueData = value(st, v);
    if (!formed(st, v)) { ret register(st, v); }
    val res_virtual: res[u32, Error] = virtual(st, d.type, false);
    if (sel res_virtual.err) { ret res_virtual; }
    val err_built: err[Error] = materialise(st, b, v, res_virtual.ok, mt.nodes[0], md);
    if (sel err_built.err) { ret res[u32, Error].err{err_built.err}; }
    ret res_virtual;
}

# the virtual register result `index` of the root is defined in, `dest` for a
# materialisation rule
fun result_register(st: *State, mt: *Match, index: u8, dest: u32) res[u32, Error] {
    if (mt.count == 0) { ret res[u32, Error].ok{dest}; }
    ret register(st, instruction(st, mt.nodes[0]).results.data[index]);
}

# the resolved row a placed call's signature names
fun placed_row(st: *State, d: *InstructionData) res[*Resolved, Error] {
    val sig: Immediate = d.immediates.data[0];
    if (!(sel sig.ty)) { ret res[*Resolved, Error].err{defect(NONE, false, UNROWED)}; }
    val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(?st.m.types, sig.ty);
    if (sel res_signature.err) { ret res[*Resolved, Error].err{Error.types{res_signature.err}}; }
    val declared: convention.Declared = st.s.index.target.convention;
    if (!(sel declared.rows)) { ret res[*Resolved, Error].err{defect(NONE, false, UNROWED)}; }
    var rows:         convention.Conventions = declared.rows;
    val opt_position: opt[usize]             = convention.position(?rows, res_signature.ok.convention);
    if (sel opt_position.none)                   { ret res[*Resolved, Error].err{defect(NONE, false, UNROWED)}; }
    if (opt_position.some >= st.calls.rows.size) { ret res[*Resolved, Error].err{defect(NONE, false, UNROWED)}; }
    ret res[*Resolved, Error].ok{?st.calls.rows.data[opt_position.some]};
}

# the registers of the convention row a rule's root runs under: the row a
# placed call's signature names, and the function's own row for any other
# root or for a selection stating no rows
fun row_of(st: *State, mt: *Match) res[*Registers, Error] {
    if (st.calls.rows.size == 0 || mt.count == 0) { ret res[*Registers, Error].ok{st.own}; }
    val d: *InstructionData = instruction(st, mt.nodes[0]);
    if (d.opcode != opcode_table.CALL_PLACED || d.immediates.len == 0) { ret res[*Registers, Error].ok{st.own}; }
    val sig: Immediate = d.immediates.data[0];
    if (!(sel sig.ty)) { ret res[*Registers, Error].ok{st.own}; }
    val res_row: res[*Resolved, Error] = placed_row(st, d);
    if (sel res_row.err) { ret res[*Registers, Error].err{res_row.err}; }
    val held: *Registers = convention.held(res_row.ok);
    if (held == nil) { ret res[*Registers, Error].err{defect(NONE, false, UNROWED)}; }
    ret res[*Registers, Error].ok{held};
}

# a variadic call under a row whose unnamed arguments are x64's words hands
# its callee the address of its first stack word in the row's address
# register, as arm64ec's x4 ("variadic calling convention"). no value of the
# ir names that address, so it is the address of the call's outgoing area at
# its start, taken just before the call
fun words_address(st: *State, b: u32, d: *InstructionData, md: Metadata) err[Error] {
    if (st.calls.rows.size == 0 || d.immediates.len < 3) { ret err[Error].ok{}; }
    val named: Immediate = d.immediates.data[2];
    if (!(sel named.named)) { ret err[Error].ok{}; }
    val count: ir_place.Named = named.named;
    if (!(sel count.first)) { ret err[Error].ok{}; }
    val res_row: res[*Resolved, Error] = placed_row(st, d);
    if (sel res_row.err) { ret err[Error].err{res_row.err}; }
    val unnamed: convention.Unnamed = res_row.ok.row.variadic.unnamed;
    if (!(sel unnamed.words)) { ret err[Error].ok{}; }
    var slot: SlotData = mf.fixed_slot(8, 8);
    slot.area      = Area.outgoing{mf.argued(0)};
    slot.addressed = true;
    val res_slot: res[FrameSlot, mf.Error] = mf.slot(st.out, slot);
    if (sel res_slot.err) { ret err[Error].err{Error.machine{res_slot.err}}; }
    val res_virtual: res[u32, Error] = virtual(st, value(st, d.operands.data[0]).type, false);
    if (sel res_virtual.err) { ret err[Error].err{res_virtual.err}; }
    var m:     Metadata   = md;
    var taken: [2]Operand = [2]Operand{Operand.virtual{res_virtual.ok}, Operand.slot{res_slot.ok}};
    m.secret = false;
    val err_addressed: err[Error] = put(st, b, mi.Opcode.pseudo{pseudo.ADDRESS}, ?taken[0], 2, m, false);
    if (sel err_addressed.err) { ret err_addressed; }
    val at:         Physical   = Physical.register{unnamed.words.address};
    var ops:        [2]Operand = [2]Operand{Operand.physical{at}, Operand.virtual{res_virtual.ok}};
    val err_copied: err[Error] = put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
    if (sel err_copied.err) { ret err_copied; }
    ret note(st, at, false);
}

# the registers a call of an expansion leaves undefined under the registers
# of its row: the row's clobbered ones for a function, the ones it states for
# a thread-local descriptor's resolver for that. none for a selection stating
# no rows, and read only where the instruction is a call
fun clobbered_by(st: *State, regs: *Registers, callee: Callee) res[Slice[rf.Id], Error] {
    if (st.calls.rows.size == 0 || regs == nil) { ret res[Slice[rf.Id], Error].ok{Slice[rf.Id]{data: nil, size: 0}}; }
    if (sel callee.function)                    { ret res[Slice[rf.Id], Error].ok{regs.clobbered}; }
    val opt_described: opt[Slice[rf.Id]] = regs.descriptor;
    if (sel opt_described.none) { ret res[Slice[rf.Id], Error].err{defect(NONE, false, UNDESCRIBED)}; }
    ret res[Slice[rf.Id], Error].ok{opt_described.some};
}

# whether every register a rule's expansion makes of its own may hold a secret: a result of the instruction it is
# rooted at may be, or its secret mark states its results. a materialisation into `dest` makes a constant, public
# whoever uses it. the mark of an instruction that gives no results, as a store, a copy or a fill, states the memory it
# writes and reads, never its addresses or length, so there each holds what the instructions writing it read (`staged`)
fun fresh_secret(st: *State, mt: *Match, dest: u32, md: Metadata) bool {
    if (dest != NONE)  { ret false; }
    if (mt.count == 0) { ret md.secret; }
    val d: *InstructionData = instruction(st, mt.nodes[0]);
    if (md.secret && d.results.len > 0) { ret true; }
    var i: usize = 0;
    for (i < d.results.len) {
        if (value(st, d.results.data[i]).secret) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the memory a rule's expansion reads holds what its root's secret mark states: the root gives no results, so
# the mark states its memory, and its row reads memory, as a copy's source. a word an expansion loads there is then
# the data it moves, never bookkeeping
fun moves_secret(st: *State, mt: *Match, md: Metadata) bool {
    if (!md.secret || mt.count == 0) { ret false; }
    val d: *InstructionData = instruction(st, mt.nodes[0]);
    if (d.results.len > 0) { ret false; }
    val opt_row: opt[*opcode_row.Row] = opcode_table.at(d.opcode);
    if (sel opt_row.none) { ret false; }
    ret opt_row.some.effects.reads;
}

# the fixed registers an instruction of an expansion has written with what may be a secret, which a later one of it
# then reads
rec Hot {
    at:    [rule.MAX_FRESH]rf.Id;
    count: u32;
}

# whether fixed register `r` overlaps one `hot` holds
fun hot_holds(st: *State, hot: *Hot, r: rf.Id) bool {
    val file: *rf.File = mf.file(st.out);
    var k:    u32      = 0;
    for (k < hot.count) {
        if (hot.at[k] == r) { ret true; }
        if (file != nil) {
            val opt_row_of:      opt[*rf.Register] = rf.row_of(file, hot.at[k]);
            val opt_row_of_file: opt[*rf.Register] = rf.row_of(file, r);
            if (sel opt_row_of.some) {
                if (sel opt_row_of_file.some) {
                    if (rf.overlap(file, opt_row_of.some, opt_row_of_file.some)) { ret true; }
                }
            }
        }
        k = k + 1;
    }
    ret false;
}

# whether operand `o` holds a value in a secret register, or a fixed register `hot` holds
fun holds_secret(st: *State, hot: *Hot, o: Operand) bool {
    if (sel o.virtual) { ret mf.secret_of(st.out, o.virtual); }
    if (sel o.member)  { ret mf.secret_of(st.out, o.member.virtual); }
    if (sel o.physical) {
        val p: Physical = o.physical;
        if (sel p.register) { ret hot_holds(st, hot, p.register); }
    }
    if (sel o.tied) {
        val source: Register = o.tied.source;
        if (sel source.virtual) { ret mf.secret_of(st.out, source.virtual); }
        if (sel source.physical) {
            val p: Physical = source.physical;
            if (sel p.register) { ret hot_holds(st, hot, p.register); }
        }
    }
    ret false;
}

# the temporary of `fresh` operand `o` writes, none for any other
fun temporary_of(fresh: *u32, o: Operand) opt[Virtual] {
    var opt_temporary: opt[Virtual] = opt[Virtual].none{};
    if (sel o.virtual)          { opt_temporary = opt[Virtual].some{o.virtual}; }
    if (sel o.member)           { opt_temporary = opt[Virtual].some{o.member.virtual}; }
    if (sel opt_temporary.none) { ret opt_temporary; }
    var f: u32 = 0;
    for (f < rule.MAX_FRESH) {
        if (fresh[f] == opt_temporary.some) { ret opt_temporary; }
        f = f + 1;
    }
    ret opt[Virtual].none{};
}

# the fixed register operand `o` writes, none for any other
fun fixed_of(o: Operand) opt[rf.Id] {
    var opt_fixed: opt[Physical] = opt[Physical].none{};
    if (sel o.physical) { opt_fixed = opt[Physical].some{o.physical}; }
    if (sel o.tied) {
        val dest: Register = o.tied.dest;
        if (sel dest.physical) { opt_fixed = opt[Physical].some{dest.physical}; }
    }
    if (sel opt_fixed.none) { ret opt[rf.Id].none{}; }
    val p: Physical = opt_fixed.some;
    if (sel p.register) { ret opt[rf.Id].some{p.register}; }
    ret opt[rf.Id].none{};
}

# whether an instruction of `count` operands accesses memory in `role`: through a memory operand or a frame slot at a
# position of that role, or by an access its row's effect states
fun accesses(op: mi.Opcode, ops: *Operand, count: u32, role: mo.Role) bool {
    var n: u32 = 0;
    for (n < count) {
        val o: Operand = ops[n];
        if ((sel o.address || sel o.slot) && (mi.role(op, count, n) & role) != 0) { ret true; }
        n = n + 1;
    }
    if (!(sel op.row))        { ret false; }
    if (op.row.effect == nil) { ret false; }
    val e: *effect.Effect = op.row.effect;
    var i: u32            = 0;
    for (i < e.memory.len) {
        if ((e.memory.at[i].role & role) != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether an instruction of an expansion writes what may be a secret, and if so each temporary and fixed register it
# writes marked as holding one: it reads a value that may be one, or memory whose bytes `moved` states secret. an
# address is formed from public registers or refused, so it passes on nothing, and neither does a constant
fun staged(st: *State, op: mi.Opcode, ops: *Operand, count: u32, fresh: *u32, hot: *Hot, moved: bool) res[bool, Error] {
    var reads: bool = moved && accesses(op, ops, count, mo.READ);
    var n:     u32  = 0;
    for (n < count) {
        if ((mi.role(op, count, n) & mo.READ) != 0 && holds_secret(st, hot, ops[n])) { reads = true; }
        n = n + 1;
    }
    if (!reads) { ret res[bool, Error].ok{false}; }
    n = 0;
    for (n < count) {
        if ((mi.role(op, count, n) & mo.WRITE) != 0) {
            val opt_temporary_of: opt[Virtual] = temporary_of(fresh, ops[n]);
            if (sel opt_temporary_of.some) { mf.mark_secret(st.out, opt_temporary_of.some); }
            val opt_fixed_of: opt[rf.Id] = fixed_of(ops[n]);
            if (sel opt_fixed_of.some) {
                if (!hot_holds(st, hot, opt_fixed_of.some)) {
                    if (hot.count >= rule.MAX_FRESH) { ret res[bool, Error].err{defect(NONE, false, HOT)}; }
                    hot.at[hot.count] = opt_fixed_of.some;
                    hot.count         = hot.count + 1;
                }
            }
        }
        n = n + 1;
    }
    ret res[bool, Error].ok{true};
}

# whether an instruction of an expansion writes a register that holds no secret, as the address a constant is
# materialised into for a secret instruction does. it is then not marked secret, so the mark states what it writes
fun writes_public(st: *State, op: mi.Opcode, ops: *Operand, count: u32) bool {
    var n: u32 = 0;
    for (n < count) {
        if ((mi.role(op, count, n) & mo.WRITE) != 0) {
            val o: Operand = ops[n];
            if (sel o.virtual) {
                if (!mf.secret_of(st.out, o.virtual)) { ret true; }
            }
            if (sel o.member) {
                if (!mf.secret_of(st.out, o.member.virtual)) { ret true; }
            }
            if (sel o.tied) {
                val dest: Register = o.tied.dest;
                if (sel dest.virtual) {
                    if (!mf.secret_of(st.out, dest.virtual)) { ret true; }
                }
            }
        }
        n = n + 1;
    }
    ret false;
}

# emit a rule's expansion into block `b`
# ---
# dest: the register a materialisation rule builds into, NONE for any other
fun expand(st: *State, b: u32, r: *Rule, mt: *Match, dest: u32, md: Metadata, declassifies: bool) err[Error] {
    val secret:  bool = fresh_secret(st, mt, dest, md);
    val moved:   bool = moves_secret(st, mt, md);
    var hot:     Hot;
    var fresh:   [rule.MAX_FRESH]u32;
    var emitted: [rule.MAX_FRESH]Instruction;
    var labels:  [rule.MAX_FRESH]u32;
    var f:       u32  = 0;
    for (f < rule.MAX_FRESH) {
        fresh[f]  = NONE;
        labels[f] = NONE;
        f         = f + 1;
    }
    val res_row: res[*Registers, Error] = row_of(st, mt);
    if (sel res_row.err) { ret err[Error].err{res_row.err}; }
    val regs:  *Registers = res_row.ok;
    var frame: u32        = NONE;
    var table: u32        = NONE;
    var e:     u32        = 0;
    for (e < r.expansion.len) {
        val emit: *Emit = ?r.expansion.at[e];
        if (tabled(emit)) {
            if (table == NONE) {
                table     = st.labels;
                st.labels = st.labels + 1;
            }
            val res_laid: res[Instruction, Error] = lay_table(st, b, md);
            if (sel res_laid.err) { ret err[Error].err{res_laid.err}; }
            mf.label(st.out, res_laid.ok, table);
            if (e < rule.MAX_FRESH) { emitted[e] = res_laid.ok; }
            e = e + 1;
            cnt;
        }
        var ops: [mo.MAX_OPERANDS]Operand;
        var k:   u32 = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (sel s.value) {
                val res_operand_register: res[u32, Error] = operand_register(st, b, mt, s.value, md);
                if (sel res_operand_register.err) { ret err[Error].err{res_operand_register.err}; }
                ops[k] = Operand.virtual{res_operand_register.ok};
            }
            or (sel s.result) {
                val res_result_register: res[u32, Error] = result_register(st, mt, s.result, dest);
                if (sel res_result_register.err) { ret err[Error].err{res_result_register.err}; }
                ops[k] = Operand.virtual{res_result_register.ok};
            }
            or (sel s.tied) {
                val res_source: res[u32, Error] = operand_register(st, b, mt, s.tied.value, md);
                if (sel res_source.err) { ret err[Error].err{res_source.err}; }
                val res_written: res[u32, Error] = result_register(st, mt, s.tied.result, dest);
                if (sel res_written.err) { ret err[Error].err{res_written.err}; }
                ops[k] = Operand.tied{Tied{dest: Register.virtual{res_written.ok}, source: Register.virtual{res_source.ok}}};
            }
            or (sel s.ordered) {
                val opt_ordering: opt[opcode_rule.Ordering] = match.ordering(mt, s.ordered.node);
                if (sel opt_ordering.none) { ret err[Error].err{defect(NONE, false, UNORDERED)}; }
                ops[k] = Operand.immediate{rule.form(s.ordered.forms, opt_ordering.some)};
            }
            or (sel s.bits) {
                val res_immediate: res[i64, Error] = immediate(st, mt, s.bits);
                if (sel res_immediate.err) { ret err[Error].err{res_immediate.err}; }
                ops[k] = Operand.immediate{res_immediate.ok};
            }
            or (sel s.derived) {
                val res_immediate: res[i64, Error] = immediate(st, mt, s.derived.of);
                if (sel res_immediate.err) { ret err[Error].err{res_immediate.err}; }
                ops[k] = Operand.immediate{s.derived.hook(res_immediate.ok)};
            }
            or (sel s.symbol) {
                val res_address: res[Address, Error] = address(st, mt, s.symbol.of);
                if (sel res_address.err) { ret err[Error].err{res_address.err}; }
                ops[k] = Operand.symbol{Symbol{symbol: res_address.ok.symbol, addend: addend_of(res_address.ok, s.symbol.kind), kind: s.symbol.kind}};
            }
            or (sel s.literal) { ops[k] = Operand.immediate{s.literal}; }
            or (sel s.address) {
                val res_built: res[Operand, Error] = built(st, b, mt, s.address, md, ?fresh[0]);
                if (sel res_built.err) { ret err[Error].err{res_built.err}; }
                ops[k] = res_built.ok;
            }
            or (sel s.width) {
                val res_width_at: res[opt[i64], Error] = width_at(st, mt, s.width);
                if (sel res_width_at.err)     { ret err[Error].err{res_width_at.err}; }
                if (sel res_width_at.ok.none) { ret err[Error].err{defect(NONE, false, UNSTATED)}; }
                ops[k] = Operand.immediate{res_width_at.ok.some};
            }
            or (sel s.register) {
                val opt_register_bits: opt[i64] = register_bits(mt);
                if (sel opt_register_bits.none) { ret err[Error].err{defect(NONE, false, UNSTATED)}; }
                ops[k] = Operand.immediate{opt_register_bits.some};
            }
            or (sel s.fresh) {
                if (fresh[s.fresh.index] == NONE) {
                    val opt_like: opt[id.Value] = ref_at(st, mt, s.fresh.like);
                    if (sel opt_like.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
                    val res_virtual: res[u32, Error] = virtual(st, value(st, opt_like.some).type, secret);
                    if (sel res_virtual.err) { ret err[Error].err{res_virtual.err}; }
                    fresh[s.fresh.index] = res_virtual.ok;
                }
                ops[k] = Operand.virtual{(fresh[s.fresh.index])};
            }
            or (sel s.scratch) {
                if (fresh[s.scratch.index] == NONE) {
                    val opt_handled: opt[Class] = class.handled(mf.file(st.out), s.scratch.class);
                    if (sel opt_handled.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
                    val res_virtual_in: res[u32, Error] = virtual_in(st, opt_handled.some, secret);
                    if (sel res_virtual_in.err) { ret err[Error].err{res_virtual_in.err}; }
                    fresh[s.scratch.index] = res_virtual_in.ok;
                }
                ops[k] = Operand.virtual{(fresh[s.scratch.index])};
            }
            or (sel s.fixed || convened(s)) {
                val opt_named: opt[rf.Id] = named(regs, s);
                if (sel opt_named.none) { ret err[Error].err{defect(NONE, false, UNCONVENED)}; }
                ops[k] = Operand.physical{Physical.register{opt_named.some}};
            }
            or (sel s.target) { ops[k] = Operand.block{(st.targets.data[s.target])}; }
            or (sel s.slot) {
                if (frame == NONE) {
                    val res_slot_for: res[u32, Error] = slot_for(st, mt.nodes[0]);
                    if (sel res_slot_for.err) { ret err[Error].err{res_slot_for.err}; }
                    frame = res_slot_for.ok;
                }
                ops[k] = Operand.slot{frame};
            }
            or (sel s.partner) {
                val j: u8 = s.partner.emit;
                if (labels[j] == NONE) {
                    labels[j] = st.labels;
                    st.labels = st.labels + 1;
                    mf.label(st.out, emitted[j], labels[j]);
                }
                ops[k] = Operand.partner{Partner{label: labels[j], kind: s.partner.kind}};
            }
            or (sel s.lookup) {
                val res_lookup: res[id.Symbol, Error] = lookup(st);
                if (sel res_lookup.err) { ret err[Error].err{res_lookup.err}; }
                ops[k] = Operand.symbol{Symbol{symbol: res_lookup.ok, addend: 0, kind: s.lookup}};
            }
            or (sel s.cell) {
                val res_cell: res[id.Symbol, Error] = cell(st);
                if (sel res_cell.err) { ret err[Error].err{res_cell.err}; }
                ops[k] = Operand.symbol{Symbol{symbol: res_cell.ok, addend: 0, kind: s.cell}};
            }
            or (sel s.count) {
                val d: *InstructionData = instruction(st, mt.nodes[0]);
                ops[k] = Operand.immediate{s.count((d.edges.len - 1)::i64)};
            }
            or (sel s.offset) {
                val res_offset_of: res[opt[i64], Error] = offset_of(mt);
                if (sel res_offset_of.err)     { ret err[Error].err{res_offset_of.err}; }
                if (sel res_offset_of.ok.none) { ret err[Error].err{defect(NONE, true, NO_SUBJECT)}; }
                ops[k] = Operand.immediate{s.offset(res_offset_of.ok.some)};
            }
            or (sel s.computed) {
                val opt_computed: opt[i64] = s.computed(mt);
                if (sel opt_computed.none) { ret err[Error].err{defect(NONE, true, NO_SUBJECT)}; }
                ops[k] = Operand.immediate{opt_computed.some};
            }
            or (sel s.table) {
                if (table == NONE) {
                    table     = st.labels;
                    st.labels = st.labels + 1;
                }
                ops[k] = Operand.partner{Partner{label: table, kind: s.table}};
            }
            or (sel s.member) {
                val of: rule.Scratch = s.member.of;
                if (fresh[of.index] == NONE) {
                    val opt_handled: opt[Class] = class.handled(mf.file(st.out), of.class);
                    if (sel opt_handled.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_CLASS)}; }
                    val res_virtual_in: res[u32, Error] = virtual_in(st, opt_handled.some, secret);
                    if (sel res_virtual_in.err) { ret err[Error].err{res_virtual_in.err}; }
                    fresh[of.index] = res_virtual_in.ok;
                }
                ops[k] = Operand.member{Member{virtual: (fresh[of.index]), index: s.member.member}};
            }
            k = k + 1;
        }
        val res_carried: res[bool, Error] = staged(st, emit.opcode, ?ops[0], emit.operands.len, ?fresh[0], ?hot, moved);
        if (sel res_carried.err) { ret err[Error].err{res_carried.err}; }
        val res_clobbered: res[Slice[rf.Id], Error] = clobbered_by(st, regs, emit.callee);
        if (sel res_clobbered.err) { ret err[Error].err{res_clobbered.err}; }
        # where the mark states memory alone, an instruction that writes none of it and no secret states nothing. one
        # writing both that memory and a public register would leave one of them misstated
        var marked: Metadata = md;
        if (writes_public(st, emit.opcode, ?ops[0], emit.operands.len)) {
            if (md.secret && accesses(emit.opcode, ?ops[0], emit.operands.len, mo.WRITE)) { ret err[Error].err{defect(NONE, false, SPLIT_MARK)}; }
            marked.secret = false;
        }
        if (!secret && !res_carried.ok && !accesses(emit.opcode, ?ops[0], emit.operands.len, mo.WRITE)) { marked.secret = false; }
        if (emit.system) {
            marked.secret       = false;
            marked.flags.public = true;
            marked.extent       = NO_EXTENT;
        }
        val res_placed: res[Instruction, Error] = made(st, b, emit.opcode, ?ops[0], emit.operands.len, marked, declassifies && carries_point(st, r, mt, e), emit.state, res_clobbered.ok);
        if (sel res_placed.err) { ret err[Error].err{res_placed.err}; }
        if (e < rule.MAX_FRESH) { emitted[e] = res_placed.ok; }
        if (emit.implied.len > 0) {
            vector.clear[Implicit](?st.implied);
            var n: u32 = 0;
            for (n < emit.implied.len) {
                val x:         rule.Implied = emit.implied.at[n];
                val opt_named: opt[rf.Id]   = named(regs, x.register);
                if (sel opt_named.none) { ret err[Error].err{defect(NONE, false, UNCONVENED)}; }
                val err_noted: err[Error] = note(st, Physical.register{opt_named.some}, x.write);
                if (sel err_noted.err) { ret err_noted; }
                n = n + 1;
            }
            val err_stated: err[Error] = imply(st, res_placed.ok);
            if (sel err_stated.err) { ret err_stated; }
        }
        e = e + 1;
    }
    ret err[Error].ok{};
}

# a jump table at the end of block `b`: the machine blocks of the current
# root's edges after the first, in order
fun lay_table(st: *State, b: u32, md: Metadata) res[Instruction, Error] {
    if (st.targets.len < 2) { ret res[Instruction, Error].err{defect(NONE, false, TABLELESS)}; }
    val n:        usize                          = st.targets.len - 1;
    val res_room: res[*Operand, allocator.Error] = allocator.allocate[Operand](st.s.a, n);
    if (sel res_room.err) { ret res[Instruction, Error].err{Error.alloc{res_room.err}}; }
    fin { allocator.deallocate[Operand](st.s.a, res_room.ok, n); }
    var k: usize = 0;
    for (k < n) {
        res_room.ok[k] = Operand.block{(st.targets.data[k + 1])};
        k              = k + 1;
    }
    var m: Metadata = md;
    m.secret = false;
    val res_laid: res[Instruction, Error] = made(st, b, mi.Opcode.pseudo{pseudo.TABLE}, res_room.ok, n::u32, m, false, vstate.NONE, Slice[rf.Id]{data: nil, size: 0});
    ret res_laid;
}

# the frame slot an alloca asks for: its type's size, in the space the target
# states for its frame slots, at its alignment, addressed since the alloca's
# result is its address, and public where the alloca states its local's type
# holds no secret. it is made once, however many operands name it
fun slot_for(st: *State, root: id.Instruction) res[u32, Error] {
    if (st.frames.data[root] != NONE) { ret res[u32, Error].ok{st.frames.data[root]}; }
    val d:     *InstructionData = instruction(st, root);
    var ty:    Type             = 0;
    var align: u64              = 1;
    var typed: bool             = false;
    var k:     usize            = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.ty) {
            if (!typed) { ty = imm.ty; }
            typed = true;
        }
        if (sel imm.alignment) { align = imm.alignment; }
        k = k + 1;
    }
    if (d.opcode == opcode_table.ARG_INCOMING || d.opcode == opcode_table.ARG_OUTGOING) {
        val opt_places: opt[Slice[Placed]] = places_of(d);
        if (sel opt_places.none)       { ret res[u32, Error].err{Error.layout{ty}}; }
        if (opt_places.some.size != 1) { ret res[u32, Error].err{Error.layout{ty}}; }
        val res_laid: res[FrameSlot, Error] = stack_slot(st, ty, opt_places.some.data[0], d.opcode == opcode_table.ARG_INCOMING, true);
        if (sel res_laid.err) { ret res[u32, Error].err{res_laid.err}; }
        st.frames.data[root] = res_laid.ok;
        ret res[u32, Error].ok{res_laid.ok};
    }
    val res_space: res[u32, target_record.Error] = target_record.slot_space(st.s.index.target);
    if (sel res_space.err) { ret res[u32, Error].err{Error.layout{ty}}; }
    val res_size: res[u64, target_record.Error] = layout.size(?st.layout, ty, res_space.ok);
    if (sel res_size.err) { ret res[u32, Error].err{Error.layout{ty}}; }
    var slot: SlotData = mf.fixed_slot(res_size.ok, align);
    slot.addressed = true;
    slot.publics   = d.metadata.publics;
    val res_slot: res[FrameSlot, mf.Error] = mf.slot(st.out, slot);
    if (sel res_slot.err) { ret res[u32, Error].err{Error.machine{res_slot.err}}; }
    val res_bound: res[Slice[Binding], module.Error] = module.bound(st.m, d.metadata.bindings);
    if (sel res_bound.err) { ret res[u32, Error].err{Error.module{res_bound.err}}; }
    var b: usize = 0;
    for (b < res_bound.ok.size) {
        val res_kept: res[usize, allocator.Error] = vector.push[Stored](?st.stored, Stored{binding: res_bound.ok.data[b], slot: res_slot.ok});
        if (sel res_kept.err) { ret res[u32, Error].err{Error.alloc{res_kept.err}}; }
        b = b + 1;
    }
    st.frames.data[root] = res_slot.ok;
    ret res[u32, Error].ok{res_slot.ok};
}

# a variable bound to the storage a slot holds
# ---
# binding: the variable
# slot:    the slot its storage is
rec Stored {
    binding: Binding;
    slot:    FrameSlot;
}

# the module's function the target's general dynamic thread-local access calls
fun lookup(st: *State) res[id.Symbol, Error] {
    val a: Addresses = st.s.index.target.addresses;
    if (!(sel a.model)) { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    val name:      str            = a.model.threads.lookup;
    val opt_found: opt[id.Symbol] = module.find(st.m, View{data: name, len: str_len(name)});
    if (sel opt_found.none)             { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    if (!(sel opt_found.some.function)) { ret res[id.Symbol, Error].err{Error.lookup{}}; }
    ret res[id.Symbol, Error].ok{opt_found.some};
}

# the module's global the target's indexed thread-local access reads the
# module's index from
fun cell(st: *State) res[id.Symbol, Error] {
    val a: Addresses = st.s.index.target.addresses;
    if (!(sel a.model)) { ret res[id.Symbol, Error].err{Error.cell{}}; }
    val name: str = a.model.threads.index;
    if (str_len(name) == 0) { ret res[id.Symbol, Error].err{Error.cell{}}; }
    val opt_found: opt[id.Symbol] = module.find(st.m, View{data: name, len: str_len(name)});
    if (sel opt_found.none)           { ret res[id.Symbol, Error].err{Error.cell{}}; }
    if (!(sel opt_found.some.global)) { ret res[id.Symbol, Error].err{Error.cell{}}; }
    ret res[id.Symbol, Error].ok{opt_found.some};
}

# the places of an instruction in piece form, none for any other
fun places_of(d: *InstructionData) opt[Slice[Placed]] {
    var k: usize = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.places) { ret opt[Slice[Placed]].some{imm.places}; }
        k = k + 1;
    }
    ret opt[Slice[Placed]].none{};
}

# the slot a piece of a type takes at its stack place, in the caller's
# outgoing area or the callee's incoming one, addressed when the code takes
# its address, as a value laid whole there is read and written through it. a piece whose size scales has
# its type's bytes per unit of the scale's multiplier, and a place whose offset
# scales is its bytes per unit, so either makes the slot's scale that scale
fun stack_slot(st: *State, ty: Type, p: Placed, incoming: bool, addressed: bool) res[FrameSlot, Error] {
    val res_size:  res[u64, target_record.Error] = layout.size(?st.layout, ty, type_table.DEFAULT_SPACE);
    val res_align: res[u64, target_record.Error] = layout.align(?st.layout, ty, type_table.DEFAULT_SPACE);
    if (sel res_size.err)  { ret res[FrameSlot, Error].err{Error.layout{ty}}; }
    if (sel res_align.err) { ret res[FrameSlot, Error].err{Error.layout{ty}}; }
    val place: ir_place.Place = p.place;
    if (!(sel place.stack)) { ret res[FrameSlot, Error].err{Error.placed{p}}; }
    var slot: SlotData = SlotData{size: res_size.ok, per: 0, scale: 0, align: res_align.ok, area: Area.local{}, secret: false, addressed: addressed, publics: NO_PUBLICS};
    var at:   Argued   = mf.argued(place.stack.offset);
    if (sel p.scale.scaled) {
        slot.size  = 0;
        slot.per   = res_size.ok;
        slot.scale = p.scale.scaled;
    }
    val offset: ir_place.Scale = place.stack.scale;
    if (sel offset.scaled) {
        if (slot.per != 0 && slot.scale != offset.scaled) { ret res[FrameSlot, Error].err{Error.placed{p}}; }
        slot.scale = offset.scaled;
        at         = Argued{fixed: 0, per: place.stack.offset};
    }
    if (incoming) { slot.area = Area.incoming{at}; }
    or            { slot.area = Area.outgoing{at}; }
    val res_slot: res[FrameSlot, mf.Error] = mf.slot(st.out, slot);
    if (sel res_slot.err) { ret res[FrameSlot, Error].err{Error.machine{res_slot.err}}; }
    ret res[FrameSlot, Error].ok{res_slot.ok};
}

# the register a piece is sent from, a constant materialised into one of its
# own, all of them before any piece is placed, since a materialisation may
# itself call and clobber the registers pieces travel in
fun source_of(st: *State, b: u32, v: id.Value, user: id.Instruction, md: Metadata) res[u32, Error] {
    val d: *ValueData = value(st, v);
    if (!formed(st, v)) { ret register(st, v); }
    val res_virtual: res[u32, Error] = virtual(st, d.type, false);
    if (sel res_virtual.err) { ret res_virtual; }
    val err_built: err[Error] = materialise(st, b, v, res_virtual.ok, user, md);
    if (sel err_built.err) { ret res[u32, Error].err{err_built.err}; }
    ret res_virtual;
}

# send a piece from its register to its place before a call or a return,
# noting a register it travels in as read by the transfer. a call's piece on
# the stack goes to the caller's outgoing area and a return's to the incoming
# area its caller passed it, and a piece at an operand place stays where it
# is, read as its operand by the rule's call or return form
fun send(st: *State, b: u32, v: id.Value, source: u32, p: Placed, md: Metadata, returning: bool) err[Error] {
    val d: *ValueData = value(st, v);
    if (sel p.place.operand) { ret err[Error].ok{}; }
    var m: Metadata = md;
    m.secret = mf.secret_of(st.out, source);
    if (sel p.place.register) {
        val at:         Physical   = Physical.register{p.place.register};
        var ops:        [2]Operand = [2]Operand{Operand.physical{at}, Operand.virtual{source}};
        val err_put_ok: err[Error] = put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
        if (sel err_put_ok.err) { ret err_put_ok; }
        ret note(st, at, false);
    }
    val res_stack_slot: res[FrameSlot, Error] = stack_slot(st, d.type, p, returning, false);
    if (sel res_stack_slot.err) { ret err[Error].err{res_stack_slot.err}; }
    var ops: [2]Operand = [2]Operand{Operand.slot{res_stack_slot.ok}, Operand.virtual{source}};
    ret put(st, b, mi.Opcode.pseudo{pseudo.SPILL}, ?ops[0], 2, m, false);
}

# take a piece from its register after a call or at an entry, from its
# incoming slot at an entry or from the outgoing area a call's result is left
# in. a call's result at an operand place is the rule's call form's own, so it
# is defined there
fun take(st: *State, b: u32, v: id.Value, p: Placed, md: Metadata, entry: bool) err[Error] {
    if (sel p.place.operand) {
        if (entry) { ret err[Error].err{Error.placed{p}}; }
        ret err[Error].ok{};
    }
    val res_dest: res[u32, Error] = register(st, v);
    if (sel res_dest.err) { ret err[Error].err{res_dest.err}; }
    var m: Metadata = md;
    m.secret = mf.secret_of(st.out, res_dest.ok);
    if (sel p.place.register) {
        var ops: [2]Operand = [2]Operand{Operand.virtual{res_dest.ok}, Operand.physical{Physical.register{p.place.register}}};
        ret put(st, b, mi.Opcode.pseudo{pseudo.COPY}, ?ops[0], 2, m, false);
    }
    val res_stack_slot: res[FrameSlot, Error] = stack_slot(st, value(st, v).type, p, entry, false);
    if (sel res_stack_slot.err) { ret err[Error].err{res_stack_slot.err}; }
    var ops: [2]Operand = [2]Operand{Operand.virtual{res_dest.ok}, Operand.slot{res_stack_slot.ok}};
    ret put(st, b, mi.Opcode.pseudo{pseudo.RELOAD}, ?ops[0], 2, m, false);
}

# lower a call or a return in piece form: its pieces to their places, the
# rule's form, the registers the transfer reads and writes, and the results
# out of their registers
fun lower_placed(st: *State, b: u32, c: *Choice, r: *Rule, places: Slice[Placed], md: Metadata, declassifies: bool) err[Error] {
    val root:    id.Instruction     = c.found.nodes[0];
    val d:       *InstructionData   = instruction(st, root);
    val results: usize              = d.results.len;
    val pieces:  usize              = places.size - results;
    val first:   usize              = d.operands.len - pieces;
    var sources: vector.Vector[u32] = vector.init[u32](st.s.a);
    fin { vector.dnit[u32](?sources); }
    val calls: bool  = d.opcode == opcode_table.CALL_PLACED;
    var i:     usize = 0;
    for (i < pieces) {
        var res_source_of: res[u32, Error] = res[u32, Error].ok{NONE};
        if (!(sel places.data[i].place.operand)) { res_source_of = source_of(st, b, d.operands.data[first + i], root, md); }
        if (sel res_source_of.err)               { ret err[Error].err{res_source_of.err}; }
        val err_pushed: err[Error] = push_u32(?sources, res_source_of.ok);
        if (sel err_pushed.err) { ret err_pushed; }
        i = i + 1;
    }
    vector.clear[Implicit](?st.implied);
    i = 0;
    for (i < pieces) {
        val err_sent: err[Error] = send(st, b, d.operands.data[first + i], sources.data[i], places.data[i], md, !calls);
        if (sel err_sent.err) { ret err_sent; }
        i = i + 1;
    }
    if (calls) {
        val err_worded: err[Error] = words_address(st, b, d, md);
        if (sel err_worded.err) { ret err_worded; }
    }
    i = 0;
    for (i < results) {
        val p: Placed = places.data[pieces + i];
        if (sel p.place.register) {
            val err_noted: err[Error] = note(st, Physical.register{p.place.register}, true);
            if (sel err_noted.err) { ret err_noted; }
        }
        i = i + 1;
    }
    # a call's secret mark states its results, so the sequence it is written in marks only the call
    var written: Metadata = md;
    if (calls) { written.secret = false; }
    val before:   usize      = mf.instructions(st.out, b).size;
    val err_done: err[Error] = expand(st, b, r, ?c.found, NONE, written, declassifies);
    if (sel err_done.err) { ret err_done; }
    val list: Slice[Instruction] = mf.instructions(st.out, b);
    var at:   usize              = NONE::usize;
    var k:    usize              = before;
    for (k < list.size) {
        val res_transfer_of: res[u8, Error] = transfer_of(st, list.data[k]);
        if (sel res_transfer_of.err)                                                  { ret err[Error].err{res_transfer_of.err}; }
        if (res_transfer_of.ok == effect.CALL || res_transfer_of.ok == effect.RETURN) { at = k; }
        k = k + 1;
    }
    if (at == NONE::usize) { ret err[Error].err{Error.transfer{root}}; }
    val err_stated: err[Error] = imply(st, list.data[at]);
    if (sel err_stated.err) { ret err_stated; }
    if (calls) {
        mf.data(st.out, list.data[at]).metadata.secret = md.secret;
        val err_placed: err[allocator.Error] = mf.place(st.out, list.data[at], places);
        if (sel err_placed.err) { ret err[Error].err{Error.alloc{err_placed.err}}; }
    }
    i = 0;
    for (i < results) {
        val err_data_taken: err[Error] = take(st, b, d.results.data[i], places.data[pieces + i], md, false);
        if (sel err_data_taken.err) { ret err_data_taken; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# take an entry's parameters from their places, at the head of its block
fun enter(st: *State, b: u32) err[Error] {
    val e:      *Entry                   = ?st.body.entry;
    val params: *vector.Vector[id.Value] = ?st.body.blocks.data[0].parameters;
    if (!(sel e.placed)) {
        if (params.len > 0) { ret err[Error].err{Error.unplaced{st.f}}; }
        ret err[Error].ok{};
    }
    val err_placed: err[allocator.Error] = mf.place_entry(st.out, Slice[Placed]{data: e.placed.data, size: e.placed.len});
    if (sel err_placed.err) { ret err[Error].err{Error.alloc{err_placed.err}}; }
    if (st.naked)           { ret err[Error].ok{}; }
    var i: usize = 0;
    for (i < params.len && i < e.placed.len) {
        val md:             Metadata   = Metadata{location: opt[Location].none{}, site: opt[Site].none{}, flags: NO_FLAGS, secret: false, bindings: UNBOUND};
        val err_data_taken: err[Error] = take(st, b, params.data[i], e.placed.data[i], md, true);
        if (sel err_data_taken.err) { ret err_data_taken; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# emit one parallel copy into block `b`, the moves in `st.moves`
#
# a destination is written only once no other move still reads it, and a
# cycle is broken by saving one destination's value in a temporary first.
# a constant reads no register, so constants are materialised last.
fun sequence(st: *State, b: u32, user: id.Instruction, md: Metadata) err[Error] {
    val err_grown: err[Error] = grow(?st.loc, st.out.virtuals.len, NONE);
    if (sel err_grown.err) { ret err_grown; }
    val err_again: err[Error] = grow(?st.pred, st.out.virtuals.len, NONE);
    if (sel err_again.err) { ret err_again; }
    vector.clear[u32](?st.ready);
    vector.clear[u32](?st.todo);
    var i: usize = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE) {
            st.loc.data[mv.dest]    = NONE;
            st.pred.data[mv.source] = NONE;
        }
        i = i + 1;
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE) {
            st.loc.data[mv.source] = mv.source;
            st.pred.data[mv.dest]  = mv.source;
            val err_push_u32: err[Error] = push_u32(?st.todo, mv.dest);
            if (sel err_push_u32.err) { ret err_push_u32; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source != NONE && st.loc.data[mv.dest] == NONE) {
            val err_push_u32: err[Error] = push_u32(?st.ready, mv.dest);
            if (sel err_push_u32.err) { ret err_push_u32; }
        }
        i = i + 1;
    }
    for (st.todo.len > 0) {
        for (st.ready.len > 0) {
            val opt_popped: opt[u32] = vector.pop[u32](?st.ready);
            if (sel opt_popped.none) { brk; }
            val dest:      u32        = opt_popped.some;
            val from:      u32        = st.pred.data[dest];
            val holder:    u32        = st.loc.data[from];
            val err_moved: err[Error] = copy(st, b, dest, holder, md);
            if (sel err_moved.err) { ret err_moved; }
            st.loc.data[from] = dest;
            if (from == holder && st.pred.data[from] != NONE) {
                val err_push_u32: err[Error] = push_u32(?st.ready, from);
                if (sel err_push_u32.err) { ret err_push_u32; }
            }
        }
        val opt_popped: opt[u32] = vector.pop[u32](?st.todo);
        if (sel opt_popped.none) { brk; }
        val dest: u32 = opt_popped.some;
        if (st.loc.data[st.pred.data[dest]] != dest) {
            val k:         Class                  = mf.class_of(st.out, dest);
            val res_saved: res[Virtual, mf.Error] = mf.virtual(st.out, k, mf.secret_of(st.out, dest));
            if (sel res_saved.err) { ret err[Error].err{Error.machine{res_saved.err}}; }
            val err_moved: err[Error] = copy(st, b, res_saved.ok, dest, md);
            if (sel err_moved.err) { ret err_moved; }
            st.loc.data[dest] = res_saved.ok;
            val err_push_u32: err[Error] = push_u32(?st.ready, dest);
            if (sel err_push_u32.err) { ret err_push_u32; }
        }
    }
    i = 0;
    for (i < st.moves.len) {
        val mv: Move = st.moves.data[i];
        if (mv.source == NONE) {
            val err_built: err[Error] = materialise(st, b, mv.value, mv.dest, user, md);
            if (sel err_built.err) { ret err_built; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the moves an edge's arguments make into its target's parameters
fun moves_of(st: *State, e: *Edge) err[Error] {
    vector.clear[Move](?st.moves);
    val params: *vector.Vector[id.Value] = ?st.body.blocks.data[e.block].parameters;
    var i:      usize                    = 0;
    for (i < e.arguments.len) {
        val arg:   id.Value = e.arguments.data[i];
        val param: id.Value = params.data[i];
        if (arg != param) {
            val res_register: res[u32, Error] = register(st, param);
            if (sel res_register.err) { ret err[Error].err{res_register.err}; }
            var source: u32        = NONE;
            val ad:     *ValueData = value(st, arg);
            if (!formed(st, arg)) {
                val res_register: res[u32, Error] = register(st, arg);
                if (sel res_register.err) { ret err[Error].err{res_register.err}; }
                source = res_register.ok;
            }
            val res_moves_pushed: res[usize, allocator.Error] = vector.push[Move](?st.moves, Move{dest: res_register.ok, source: source, value: arg});
            if (sel res_moves_pushed.err) { ret alloc_err(res_moves_pushed.err); }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether a matched node reads a parameter of block `k`
fun reads_parameter(st: *State, mt: *Match, k: id.Block) bool {
    var n: u32 = 0;
    for (n < mt.count) {
        val d: *InstructionData = instruction(st, mt.nodes[n]);
        var i: usize            = 0;
        for (i < d.operands.len) {
            val def: *ValueData = value(st, d.operands.data[i]);
            if (sel def.def.parameter && def.def.parameter.block == k) { ret true; }
            i = i + 1;
        }
        n = n + 1;
    }
    ret false;
}

# resolve the root's edges to machine blocks, emitting each edge's parallel
# copy before the root when it has one edge whose target it does not read,
# and in a block of its own ended by the table's jump otherwise
fun edges(st: *State, b: u32, c: *Choice, md: Metadata) err[Error] {
    val root: id.Instruction   = c.found.nodes[0];
    val d:    *InstructionData = instruction(st, root);
    vector.clear[u32](?st.targets);
    var k: usize = 0;
    for (k < d.edges.len) {
        val e:            *Edge      = ?d.edges.data[k];
        val to:           u32        = st.blocks.data[e.block];
        val err_push_u32: err[Error] = push_u32(?st.targets, to);
        if (sel err_push_u32.err) { ret err_push_u32; }
        val err_listed: err[Error] = moves_of(st, e);
        if (sel err_listed.err) { ret err_listed; }
        if (st.moves.len > 0) {
            if (d.edges.len == 1 && !reads_parameter(st, ?c.found, e.block)) {
                val err_done: err[Error] = sequence(st, b, root, md);
                if (sel err_done.err) { ret err_done; }
            }
            or {
                val res_made: res[Block, mf.Error] = mf.block(st.out);
                if (sel res_made.err) { ret err[Error].err{Error.machine{res_made.err}}; }
                val own:      u32        = res_made.ok;
                val err_done: err[Error] = sequence(st, own, root, md);
                if (sel err_done.err) { ret err_done; }
                val err_back: err[Error] = jump(st, own, to, md);
                if (sel err_back.err) { ret err_back; }
                st.targets.data[k] = own;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# emit the table's jump to machine block `to` at the end of block `b`
fun jump(st: *State, b: u32, to: u32, md: Metadata) err[Error] {
    val emit: *Emit = ?st.s.index.isa.table.jump.at[0];
    var ops:  [mo.MAX_OPERANDS]Operand;
    var k:    u32   = 0;
    for (k < emit.operands.len) {
        val s: Source = emit.operands.at[k];
        if (sel s.target)  { ops[k] = Operand.block{to}; }
        or (sel s.literal) { ops[k] = Operand.immediate{s.literal}; }
        or (sel s.fixed)   { ops[k] = Operand.physical{Physical.register{s.fixed}}; }
        k = k + 1;
    }
    var m: Metadata = md;
    m.secret = false;
    m.flags  = NO_FLAGS;
    ret put(st, b, emit.opcode, ?ops[0], emit.operands.len, m, false);
}

# whether the table states a landing and the build admits each of its rows
fun landing_held(st: *State) bool {
    val l: rule.Emits = st.s.index.isa.table.landing;
    if (l.len == 0) { ret false; }
    var e: u32 = 0;
    for (e < l.len) {
        val emit: *Emit = ?l.at[e];
        var n:    u32   = 0;
        for (n < mi.rows_in(emit.opcode)) {
            if (!core_state.admits(st.ctx, mi.row_in(emit.opcode, n).requires)) { ret false; }
            n = n + 1;
        }
        e = e + 1;
    }
    ret true;
}

# the table's landing put first in machine block `b`, its first instruction first
fun land_in(st: *State, b: u32) err[Error] {
    val l:  rule.Emits = st.s.index.isa.table.landing;
    val md: Metadata   = Metadata{location: opt[Location].none{}, site: opt[Site].none{}, flags: NO_FLAGS, secret: false, bindings: UNBOUND};
    var e:  u32        = l.len;
    for (e > 0) {
        e = e - 1;
        val emit: *Emit = ?l.at[e];
        var ops:  [mo.MAX_OPERANDS]Operand;
        var k:    u32   = 0;
        for (k < emit.operands.len) {
            val s: Source = emit.operands.at[k];
            if (sel s.literal) { ops[k] = Operand.immediate{s.literal}; }
            or (sel s.fixed)   { ops[k] = Operand.physical{Physical.register{s.fixed}}; }
            k = k + 1;
        }
        val res_made: res[Instruction, mf.Error] = mf.prepend(st.out, b, emit.opcode, Slice[Operand]{data: ?ops[0], size: emit.operands.len::usize}, md, false, vstate.NONE);
        if (sel res_made.err) { ret err[Error].err{Error.machine{res_made.err}}; }
    }
    ret err[Error].ok{};
}

# the landing at the head of every block a jump table names, once each, where
# the build admits it, so an indirect jump through a table lands where branch
# target identification lets it
fun land(st: *State) err[Error] {
    if (!landing_held(st)) { ret err[Error].ok{}; }
    val count: usize = st.out.blocks.len;
    if (count == 0) { ret err[Error].ok{}; }
    val res_marks: res[*bool, allocator.Error] = allocator.zallocate[bool](st.s.a, count);
    if (sel res_marks.err) { ret alloc_err(res_marks.err); }
    fin { allocator.deallocate[bool](st.s.a, res_marks.ok, count); }
    var b: usize = 0;
    for (b < count) {
        val list: Slice[Instruction] = mf.instructions(st.out, (b::u32));
        var k:    usize              = 0;
        for (k < list.size) {
            val d:  *mi.InstructionData = mf.data(st.out, list.data[k]);
            val op: mi.Opcode           = d.opcode;
            if (sel op.pseudo && op.pseudo == pseudo.TABLE) {
                var j: usize = 0;
                for (j < d.operands.size) {
                    val o: Operand = d.operands.data[j];
                    if (sel o.block) {
                        val to: u32 = o.block;
                        if (to::usize < count) { res_marks.ok[to] = true; }
                    }
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    b = 0;
    for (b < count) {
        if (res_marks.ok[b]) {
            val err_landed: err[Error] = land_in(st, b::u32);
            if (sel err_landed.err) { ret err_landed; }
        }
        b = b + 1;
    }
    ret err[Error].ok{};
}

# whether no match needs an instruction emitted: every use of its results that makes code
# is in its block, so chosen already, by a rule, and no chosen match reads it in a register,
# so each reads it as a node it repeats. only a pure instruction may be read by more than
# one match, as each match repeats its computation
fun read_by_matches(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    if (!pure(xd.opcode) || st.leaves.data[x] != 0) { ret false; }
    if (!(sel xd.place.placed))                     { ret false; }
    val home: id.Block = xd.place.placed;
    var uses: usize    = 0;
    var k:    usize    = 0;
    for (k < xd.results.len) {
        val read: *Growing[id.Instruction] = ?value(st, xd.results.data[k]).uses;
        var u:    usize                    = 0;
        for (u < read.len) {
            val user: id.Instruction = read.data[u];
            u = u + 1;
            # an instruction no code is made for reads nothing
            if (unread(st, user)) { cnt; }
            # a match never covers a node of another block, and an instruction no rule selects reads in registers
            val ud: *InstructionData = instruction(st, user);
            if (!(sel ud.place.placed && ud.place.placed == home)) { ret false; }
            if (unruled(ud.opcode) || in_place(st, user))          { ret false; }
            uses = uses + 1;
        }
        k = k + 1;
    }
    ret uses != 0;
}

# whether an instruction is a division without the checked mark that the
# target's division gives a result for on some trap of its row, read from the
# target's declared faults
fun unchecked(st: *State, i: id.Instruction) bool {
    val d: *InstructionData = instruction(st, i);
    if (d.metadata.flags.checked) { ret false; }
    val opt_opcode_at: opt[*opcode_row.Row] = opcode_table.at(d.opcode);
    if (sel opt_opcode_at.none) { ret false; }
    val row: *opcode_row.Row = opt_opcode_at.some;
    if (!opcode_row.divides(row)) { ret false; }
    val division: *capability.Division    = ?st.s.index.target.caps.arithmetic.division;
    val long:     bool                    = opcode_row.divides_long(row);
    val words:    capability.LongDivision = division.long;
    var n:        usize                   = 0;
    for (n < $length_of(opcode_row.Traps)) {
        var opt_fault: opt[capability.Fault] = opt[capability.Fault].none{};
        if (!long) { opt_fault = capability.fault_of(division, row.effects.traps[n]); }
        or (sel words.native) {
            var l: capability.Long = words.native;
            opt_fault = capability.long_fault_of(?l, row.effects.traps[n]);
        }
        if (sel opt_fault.some) {
            if (sel opt_fault.some.quiet) { ret true; }
        }
        n = n + 1;
    }
    ret false;
}

# refuse a choice that covers a division no test stands before, on a target
# whose division gives a result where the ir's traps
fun tested(st: *State, c: *Choice) err[Error] {
    var n: u32 = 0;
    for (n < c.found.count) {
        if (unchecked(st, c.found.nodes[n])) { ret err[Error].err{Error.unchecked{c.found.nodes[n]}}; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# count each instruction whose result node `n` of a choice reads in a register:
# every node the choice emits or repeats, the root, a consumed node and a standing
# one alike, reads an operand no child node of it in the choice defines in a register,
# and each argument of its edges
fun leaf_reads(st: *State, c: *Choice, n: u32) {
    val r:  *Rule            = ?st.s.index.isa.table.rules.at[c.rule];
    val xd: *InstructionData = instruction(st, c.found.nodes[n]);
    var j:  usize            = 0;
    for (j < xd.operands.len) {
        val d: *ValueData = value(st, xd.operands.data[j]);
        if (sel d.def.result) {
            val at:      id.Instruction = d.def.result.instruction;
            var covered: bool           = false;
            var m:       u32            = 1;
            for (m < c.found.count) {
                if (r.nodes.at[m].parent::u32 == n && c.found.nodes[m] == at) { covered = true; }
                m = m + 1;
            }
            if (!covered) { st.leaves.data[at] = st.leaves.data[at] + 1; }
        }
        j = j + 1;
    }
    # an edge's argument is read in a register by the edge's parallel copy
    var k: usize = 0;
    for (k < xd.edges.len) {
        val e: *Edge = ?xd.edges.data[k];
        var a: usize = 0;
        for (a < e.arguments.len) {
            val d: *ValueData = value(st, e.arguments.data[a]);
            if (sel d.def.result) { st.leaves.data[d.def.result.instruction] = st.leaves.data[d.def.result.instruction] + 1; }
            a = a + 1;
        }
        k = k + 1;
    }
}

# choose a rule for every instruction of an ir block, its last first
fun choose_block(st: *State, k: id.Block) err[Error] {
    val list: *vector.Vector[id.Instruction] = ?st.body.blocks.data[k].instructions;
    vector.clear[Choice](?st.choices);
    vector.clear[u32](?st.impure);
    val err_first: err[Error] = push_u32(?st.impure, 0);
    if (sel err_first.err) { ret err_first; }
    var i: usize = 0;
    for (i < list.len) {
        val at: id.Instruction = list.data[i];
        st.position.data[at] = i::u32;
        var count: u32 = st.impure.data[i];
        if (!pure(instruction(st, at).opcode)) { count = count + 1; }
        val err_push_u32: err[Error] = push_u32(?st.impure, count);
        if (sel err_push_u32.err) { ret err_push_u32; }
        i = i + 1;
    }
    i = list.len;
    for (i > 0) {
        i = i - 1;
        val at: id.Instruction = list.data[i];
        if (st.shared.data[at] != 0 && read_by_matches(st, at)) { st.consumed.data[at] = true; }
        if (only_bound(st, at))                                 { st.consumed.data[at] = true; }
        if (unread(st, at))                                     { st.consumed.data[at] = true; }
        if (folds_away(st, at) || remade(st, at))               { st.consumed.data[at] = true; }
        if (unruled(instruction(st, at).opcode) || in_place(st, at)) {
            var held: Choice = Choice{rule: NONE, found: unmatched_match(st), consumes: 0};
            held.found.nodes[0] = at;
            held.found.count    = 1;
            val res_choices_pushed: res[usize, allocator.Error] = vector.push[Choice](?st.choices, held);
            if (sel res_choices_pushed.err) { ret alloc_err(res_choices_pushed.err); }
        }
        or (!st.consumed.data[at]) {
            val res_choose: res[Choice, Error] = choose(st, at);
            if (sel res_choose.err) { ret err[Error].err{res_choose.err}; }
            var c:         Choice     = res_choose.ok;
            val err_ruled: err[Error] = tested(st, ?c);
            if (sel err_ruled.err) { ret err_ruled; }
            var n: u32 = 0;
            for (n < c.found.count) {
                leaf_reads(st, ?c, n);
                if (n != 0 && ((c.consumes >> n) & 1) != 0) { st.consumed.data[c.found.nodes[n]] = true; }
                or (n != 0)                                 { st.shared.data[c.found.nodes[n]] = st.shared.data[c.found.nodes[n]] + 1; }
                n = n + 1;
            }
            val res_choices_pushed: res[usize, allocator.Error] = vector.push[Choice](?st.choices, c);
            if (sel res_choices_pushed.err) { ret alloc_err(res_choices_pushed.err); }
        }
    }
    ret err[Error].ok{};
}

# a match of no rule over the function, which an inline assembly item's choice holds
fun unmatched_match(st: *State) Match {
    var mt: Match;
    mt.module   = st.m;
    mt.body     = st.body;
    mt.function = st.f;
    mt.target   = st.s.index.target;
    mt.count    = 0;
    mt.swapped  = 0;
    ret mt;
}

fun assembled(at: id.Instruction, why: minline.Error) err[Error] {
    ret err[Error].err{Error.assembly{Assembled{instruction: at, refusal: why}}};
}

# the virtual register value `v` is read in at instruction `user`, a constant
# materialised into one of its own first
fun value_register(st: *State, b: u32, v: id.Value, user: id.Instruction, md: Metadata) res[u32, Error] {
    val d: *ValueData = value(st, v);
    if (!formed(st, v)) { ret register(st, v); }
    val res_virtual: res[u32, Error] = virtual(st, d.type, false);
    if (sel res_virtual.err) { ret res_virtual; }
    val err_built: err[Error] = materialise(st, b, v, res_virtual.ok, user, md);
    if (sel err_built.err) { ret res[u32, Error].err{err_built.err}; }
    ret res_virtual;
}

# whether virtual register `r` is of class `class` of the set's register file
fun of_class(st: *State, r: u32, class: u16) bool {
    val k: Class = mf.class_of(st.out, r);
    if (!(sel k.hardware)) { ret false; }
    ret k.hardware.file == mf.file(st.out) && k.hardware.index == class;
}

# the immediate constant `v` binds under constraint `c`, its bits extended
# as the constraint reads them
fun bound_immediate(st: *State, v: id.Value, c: inline.Immediate) res[opt[i64], Error] {
    var mt:       Match                      = unmatched_match(st);
    val res_bits: res[opt[i64], match.Error] = match.bits(?mt, v);
    if (sel res_bits.err)     { ret res[opt[i64], Error].err{refused(res_bits.err)}; }
    if (sel res_bits.ok.none) { ret res[opt[i64], Error].ok{res_bits.ok}; }
    var x: i64 = res_bits.ok.some;
    if (!c.signed && x < 0) {
        val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?st.m.types, value(st, v).type);
        if (sel res_shape.err) { ret res[opt[i64], Error].err{Error.types{res_shape.err}}; }
        if (sel res_shape.ok.integer) {
            val w: u32 = res_shape.ok.integer.width;
            if (w < 64) { x = (x:~u64 & ((1::u64 << w::u64) - 1)):~i64; }
        }
    }
    ret res[opt[i64], Error].ok{opt[i64].some{x}};
}

# bytes of a stack slot: the alloca that makes the slot and where they start in it
rec Inside {
    alloca: id.Instruction;
    offset: u64;
}

# how far a chain of constant offsets from an alloca is followed
val INSIDE_DEPTH: u32 = 16;

# where in a stack slot an address points: an alloca's result is its slot's first byte, and
# an address a constant number of bytes past such an address is that many further in. none
# for any other address
fun inside(st: *State, v: id.Value) opt[Inside] {
    var at:    id.Value = v;
    var off:   u64      = 0;
    var depth: u32      = 0;
    var mt:    Match    = unmatched_match(st);
    for (depth < INSIDE_DEPTH) {
        val def: Def = value(st, at).def;
        if (!(sel def.result)) { ret opt[Inside].none{}; }
        val x:  id.Instruction   = def.result.instruction;
        val xd: *InstructionData = instruction(st, x);
        if (xd.opcode == opcode_table.ALLOCA) {
            if (xd.results.len != 1) { ret opt[Inside].none{}; }
            ret opt[Inside].some{Inside{alloca: x, offset: off}};
        }
        if (xd.opcode != opcode_table.PTR_ADD || xd.operands.len != 2 || xd.results.len != 1) { ret opt[Inside].none{}; }
        val res_bits: res[opt[i64], match.Error] = match.bits(?mt, xd.operands.data[1]);
        if (sel res_bits.err)     { ret opt[Inside].none{}; }
        if (sel res_bits.ok.none) { ret opt[Inside].none{}; }
        if (res_bits.ok.some < 0) { ret opt[Inside].none{}; }
        off   = off + res_bits.ok.some::u64;
        at    = xd.operands.data[0];
        depth = depth + 1;
    }
    ret opt[Inside].none{};
}

# the bytes of the slot an alloca makes, none where the layout gives none
fun slot_bytes(st: *State, x: id.Instruction) opt[u64] {
    val xd:    *InstructionData = instruction(st, x);
    var ty:    Type             = 0;
    var typed: bool             = false;
    var k:     usize            = 0;
    for (k < xd.immediates.len) {
        val imm: Immediate = xd.immediates.data[k];
        if (sel imm.ty) {
            if (!typed) { ty = imm.ty; }
            typed = true;
        }
        k = k + 1;
    }
    if (!typed) { ret opt[u64].none{}; }
    val res_space: res[u32, target_record.Error] = target_record.slot_space(st.s.index.target);
    if (sel res_space.err) { ret opt[u64].none{}; }
    val res_size: res[u64, target_record.Error] = layout.size(?st.layout, ty, res_space.ok);
    if (sel res_size.err) { ret opt[u64].none{}; }
    ret opt[u64].some{res_size.ok};
}

# the type a load reads or a store writes
fun moved_type(st: *State, d: *InstructionData) Type {
    if (d.opcode == opcode_table.LOAD) { ret value(st, d.results.data[0]).type; }
    ret value(st, d.operands.data[1]).type;
}

# whether a load or a store reads or writes bytes of a stack slot in place: one neither
# volatile nor kept, whose address is inside a slot by `inside` and whose value lies whole
# within the slot, held in a class the frame code moves to and from memory at exactly the
# value's bytes. such a load is a reload of those bytes and such a store a spill to them,
# as a spilled register's are, so no register holds the address for it. a value of a class
# the frame code moves only whole, as risc-v's vector registers, which hold a value shorter
# than the vector length, is loaded or stored by its own rule through the slot's address.
# worked out once for each instruction
fun in_place(st: *State, at: id.Instruction) bool {
    val d: *InstructionData = instruction(st, at);
    if (d.opcode != opcode_table.LOAD && d.opcode != opcode_table.STORE) { ret false; }
    if (st.direct.data[at] != NONE)                                      { ret st.direct.data[at] == 1; }
    st.direct.data[at] = 0;
    var shaped: bool = false;
    if (d.opcode == opcode_table.LOAD)                                 { shaped = d.operands.len == 1 && d.results.len == 1; }
    if (d.opcode == opcode_table.STORE)                                { shaped = d.operands.len == 2 && d.operands.data[1] != d.operands.data[0]; }
    if (!shaped || d.metadata.flags.volatile || d.metadata.flags.kept) { ret false; }
    val opt_inside: opt[Inside] = inside(st, d.operands.data[0]);
    if (sel opt_inside.none) { ret false; }
    val res_held: res[u64, target_record.Error] = layout.size(?st.layout, moved_type(st, d), type_table.DEFAULT_SPACE);
    if (sel res_held.err) { ret false; }
    val opt_whole: opt[u64] = slot_bytes(st, opt_inside.some.alloca);
    if (sel opt_whole.none)                                                        { ret false; }
    if (res_held.ok == 0 || opt_inside.some.offset + res_held.ok > opt_whole.some) { ret false; }
    val res_class: res[Class, Error] = class_for(st, moved_type(st, d));
    if (sel res_class.err) { ret false; }
    val k: Class = res_class.ok;
    if (sel k.hardware) {
        val size:      Offset                 = Offset{fixed: res_held.ok::i64, per: 0, scale: 0};
        val opt_width: opt[*frame_code.Width] = frame_code.class_width(st.code, k.hardware, size, d.opcode == opcode_table.STORE);
        if (sel opt_width.none) { ret false; }
    }
    st.direct.data[at] = 1;
    ret true;
}

# the bytes of a stack slot a load or a store reads or writes in place, none for any other
# instruction
fun slot_access(st: *State, at: id.Instruction) opt[Inside] {
    if (!in_place(st, at)) { ret opt[Inside].none{}; }
    ret inside(st, instruction(st, at).operands.data[0]);
}

# whether no code is made for instruction `x`, an alloca or an address a constant number of
# bytes past one: every use of its result is a load or a store that reads or writes a slot's
# bytes in place through it, or an address past it of which the same holds, so no register
# ever holds it. asked once for each instruction
fun folds_away(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    # only these two keep their answer here: a load's or a store's entry is `in_place`'s
    if (xd.opcode != opcode_table.ALLOCA && xd.opcode != opcode_table.PTR_ADD) { ret false; }
    if (st.direct.data[x] != NONE)                                             { ret st.direct.data[x] == 1; }
    st.direct.data[x] = 0;
    if (xd.results.len != 1) { ret false; }
    val v: id.Value   = xd.results.data[0];
    val d: *ValueData = value(st, v);
    if (d.uses.len == 0 || d.bound.len != 0) { ret false; }
    val opt_inside: opt[Inside] = inside(st, v);
    if (sel opt_inside.none) { ret false; }
    var i: usize = 0;
    for (i < d.uses.len) {
        val u:  id.Instruction   = d.uses.data[i];
        val ud: *InstructionData = instruction(st, u);
        if (ud.opcode == opcode_table.PTR_ADD) {
            if (ud.operands.len != 2 || ud.operands.data[0] != v || ud.operands.data[1] == v) { ret false; }
            if (!folds_away(st, u))                                                           { ret false; }
        }
        or {
            if (ud.operands.len == 0 || ud.operands.data[0] != v) { ret false; }
            if (!in_place(st, u))                                 { ret false; }
        }
        i = i + 1;
    }
    st.direct.data[x] = 1;
    ret true;
}

# whether instruction `x` is an alloca that makes no code where it stands, its slot's address
# formed at each use
fun remade(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    if (xd.opcode != opcode_table.ALLOCA || xd.results.len != 1) { ret false; }
    val opt_slotted: opt[id.Instruction] = slot_address(st, xd.results.data[0]);
    ret sel opt_slotted.some;
}

# the slot holding the `size` bytes `offset` into slot `outer`: `outer` itself when they are
# all of it, else a slot within it, made once for each such run of bytes
fun bytes_of(st: *State, outer: u32, offset: u64, size: u64, align: u64) res[u32, Error] {
    val whole: SlotData = st.out.slots.data[outer];
    if (offset == 0 && whole.per == 0 && whole.size == size) { ret res[u32, Error].ok{outer}; }
    var k: usize = st.views.len;
    for (k > 0) {
        k = k - 1;
        val s: SlotData = st.out.slots.data[st.views.data[k]];
        if (sel s.area.within) {
            if (s.area.within.slot == outer && s.area.within.offset == offset && s.size == size) { ret res[u32, Error].ok{st.views.data[k]}; }
        }
    }
    val res_made: res[FrameSlot, mf.Error] = mf.slot(st.out, SlotData{size: size, per: 0, scale: 0, align: align, area: Area.within{mf.Within{slot: outer, offset: offset}}, secret: false, addressed: false, publics: NO_PUBLICS});
    if (sel res_made.err) { ret res[u32, Error].err{Error.machine{res_made.err}}; }
    val err_kept: err[Error] = push_u32(?st.views, res_made.ok);
    if (sel err_kept.err) { ret res[u32, Error].err{err_kept.err}; }
    ret res[u32, Error].ok{res_made.ok};
}

# a load or a store of bytes of a stack slot, as the reload or the spill it is
fun slot_move(st: *State, b: u32, at: id.Instruction, in: Inside, md: Metadata) err[Error] {
    val d:         *InstructionData = instruction(st, at);
    val res_outer: res[u32, Error]  = slot_for(st, in.alloca);
    if (sel res_outer.err) { ret err[Error].err{res_outer.err}; }
    val ty:       Type                          = moved_type(st, d);
    val res_size: res[u64, target_record.Error] = layout.size(?st.layout, ty, type_table.DEFAULT_SPACE);
    if (sel res_size.err) { ret err[Error].err{Error.layout{ty}}; }
    val res_align: res[u64, target_record.Error] = layout.align(?st.layout, ty, type_table.DEFAULT_SPACE);
    if (sel res_align.err) { ret err[Error].err{Error.layout{ty}}; }
    val res_slot: res[u32, Error] = bytes_of(st, res_outer.ok, in.offset, res_size.ok, res_align.ok);
    if (sel res_slot.err) { ret err[Error].err{res_slot.err}; }
    var m: Metadata = md;
    if (d.opcode == opcode_table.LOAD) {
        val res_dest: res[u32, Error] = register(st, d.results.data[0]);
        if (sel res_dest.err) { ret err[Error].err{res_dest.err}; }
        m.secret = mf.secret_of(st.out, res_dest.ok);
        var ops: [2]Operand = [2]Operand{Operand.virtual{res_dest.ok}, Operand.slot{res_slot.ok}};
        ret put(st, b, mi.Opcode.pseudo{pseudo.RELOAD}, ?ops[0], 2, m, false);
    }
    val res_source: res[u32, Error] = source_of(st, b, d.operands.data[1], at, md);
    if (sel res_source.err) { ret err[Error].err{res_source.err}; }
    m.secret = mf.secret_of(st.out, res_source.ok);
    var ops: [2]Operand = [2]Operand{Operand.slot{res_slot.ok}, Operand.virtual{res_source.ok}};
    ret put(st, b, mi.Opcode.pseudo{pseudo.SPILL}, ?ops[0], 2, m, false);
}

# whether instruction `x` computes values nothing reads: one that neither
# traps nor touches memory, whose every result has no use and no variable
# bound to it, so no code is made for it. a stack slot is kept, since its
# instruction states what it holds
fun unread(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    if (xd.results.len == 0 || !pure(xd.opcode))                                                                              { ret false; }
    if (xd.opcode == opcode_table.ALLOCA || xd.opcode == opcode_table.ARG_INCOMING || xd.opcode == opcode_table.ARG_OUTGOING) { ret false; }
    var k: usize = 0;
    for (k < xd.results.len) {
        val d: *ValueData = value(st, xd.results.data[k]);
        if (d.uses.len != 0 || d.bound.len != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether instruction `x` is an alloca whose address only inline assembly
# items bind, each as a memory operand, so its slot is made where they bind it
# and no register ever holds the address
fun only_bound(st: *State, x: id.Instruction) bool {
    val xd: *InstructionData = instruction(st, x);
    if (xd.opcode != opcode_table.ALLOCA || xd.results.len != 1) { ret false; }
    val v:    id.Value   = xd.results.data[0];
    val uses: *ValueData = value(st, v);
    if (uses.uses.len == 0) { ret false; }
    var i: usize = 0;
    for (i < uses.uses.len) {
        if (!memory_only(st, uses.uses.data[i], v)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether every operand of instruction `user` that reads `v` is an inline
# assembly item's memory operand
fun memory_only(st: *State, user: id.Instruction, v: id.Value) bool {
    val d: *InstructionData = instruction(st, user);
    if (d.opcode != opcode_table.ASM || d.immediates.len == 0) { ret false; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.assembly)) { ret false; }
    val blk: *ia.Assembly = imm.assembly;
    var arg: usize        = 0;
    var k:   usize        = 0;
    for (k < blk.operands.size) {
        val o:     *ia.Operand       = ?blk.operands.data[k];
        val c:     inline.Constraint = o.constraint;
        var reads: bool              = true;
        if (sel c.class) { reads = (o.role & mo.READ) != 0; }
        if (reads) {
            if (arg >= d.operands.len)                        { ret false; }
            if (d.operands.data[arg] == v && !(sel c.memory)) { ret false; }
            arg = arg + 1;
        }
        k = k + 1;
    }
    ret true;
}

# the alloca whose address `v` is, none for a value of any other definition
fun allocated(st: *State, v: id.Value) opt[id.Instruction] {
    val d: *ValueData = value(st, v);
    if (!(sel d.def.result)) { ret opt[id.Instruction].none{}; }
    val x: id.Instruction = d.def.result.instruction;
    if (instruction(st, x).opcode != opcode_table.ALLOCA) { ret opt[id.Instruction].none{}; }
    ret opt[id.Instruction].some{x};
}

# whether an opcode is the timing switch's, which selection places from the set's switch
fun timing(op: opcode_row.Opcode) bool {
    val opt_row: opt[*opcode_row.Row] = opcode_table.at(op);
    ret sel opt_row.some && opcode_table.switches(opt_row.some);
}

# whether an instruction of opcode `op` is emitted by no rule of the table: an inline assembly item, which masc reads,
# and a timing switch opcode, which the set's switch states
fun unruled(op: opcode_row.Opcode) bool {
    ret op == opcode_table.ASM || timing(op);
}

fun unswitched(at: id.Instruction, why: str) err[Error] {
    ret err[Error].err{Error.switched{Switched{instruction: at, why: why}}};
}

# the steps of switch `sw` a timing switch opcode places: a read's, a set's or a restore's
fun steps_of(op: opcode_row.Opcode, sw: *mswitch.Switch) mswitch.Steps {
    if (op == opcode_table.TIMING_READ) { ret sw.read; }
    if (op == opcode_table.TIMING_SET)  { ret sw.set; }
    ret sw.restore;
}

# a timing switch opcode emitted into block `b` as the steps the set's switch of the state value it names states for
# it, in order. each operand of a step is the fixed value the step states, the virtual register of the saved word, the
# read's result or the set's or the restore's operand, which must be of the class the switch saves its state in, or a
# fresh virtual register of the class of the scratch register the step names, one for each scratch register of the
# switch. a set that states no switch of the value refuses the opcode
fun switched(st: *State, b: u32, at: id.Instruction, md: Metadata) err[Error] {
    val d:         *InstructionData = instruction(st, at);
    var opt_named: opt[View]        = opt[View].none{};
    var i:         usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.state) { opt_named = opt[View].some{imm.state}; }
        i = i + 1;
    }
    if (sel opt_named.none) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    if (st.ctx == nil)      { ret unswitched(at, "no context is open to read the state value under"); }
    val set:       *mset.Set           = st.s.index.isa.set;
    val opt_state: opt[requirement.Id] = core_state.lookup(st.ctx.selection.catalog, st.ctx.axes, opt_named.some.data, 0, opt_named.some.len);
    if (sel opt_state.none) { ret unswitched(at, "the instruction set has no state value the opcode names"); }
    val opt_found: opt[*mswitch.Switch] = mswitch.switching(set.switches, opt_state.some);
    if (sel opt_found.none) { ret unswitched(at, "the instruction set states no switch of the state value the opcode names"); }
    if (set.codec == nil)   { ret unswitched(at, "the instruction set has no rows"); }
    val sw:    *mswitch.Switch = opt_found.some;
    var saved: u32             = NONE;
    if (d.opcode == opcode_table.TIMING_READ && d.results.len == 1) {
        val res_register: res[u32, Error] = register(st, d.results.data[0]);
        if (sel res_register.err) { ret err[Error].err{res_register.err}; }
        saved = res_register.ok;
    }
    if ((d.opcode == opcode_table.TIMING_SET || d.opcode == opcode_table.TIMING_RESTORE) && d.operands.len == 1) {
        val res_value_register: res[u32, Error] = value_register(st, b, d.operands.data[0], at, md);
        if (sel res_value_register.err) { ret err[Error].err{res_value_register.err}; }
        saved = res_value_register.ok;
    }
    if (saved != NONE && !of_class(st, saved, sw.saved)) { ret unswitched(at, "the saved word is held in another class than the switch saves its state in"); }
    var scratch: [MOST_SCRATCH]u32;
    if (sw.scratch.len > MOST_SCRATCH) { ret unswitched(at, "the switch names more scratch registers than selection places"); }
    var k: u32 = 0;
    for (k < sw.scratch.len) {
        val res_made: res[u32, Error] = virtual_in(st, Class.hardware{class.Hardware{file: mf.file(st.out), index: sw.scratch.at[k]}}, false);
        if (sel res_made.err) { ret err[Error].err{res_made.err}; }
        scratch[k] = res_made.ok;
        k          = k + 1;
    }
    val steps: mswitch.Steps = steps_of(d.opcode, sw);
    var n:     u32           = 0;
    for (n < steps.len) {
        val step: *mswitch.Step = ?steps.at[n];
        val row:  *rows.Row     = rows.at(set.codec.rows, step.row);
        if (row == nil)                          { ret unswitched(at, "a step of the switch names no row of the instruction set"); }
        if (step.values.len != row.operands.len) { ret unswitched(at, "a step of the switch gives other than one value per operand of its row"); }
        if (row.operands.len > mo.MAX_OPERANDS)  { ret unswitched(at, "a step of the switch has more operands than a row may"); }
        var ops: [mo.MAX_OPERANDS]Operand;
        var o:   u32 = 0;
        for (o < step.values.len) {
            val src: mswitch.Source = step.values.at[o];
            if (sel src.saved) {
                if (saved == NONE) { ret unswitched(at, "a step of the switch names the saved register where the opcode holds no saved word"); }
                ops[o] = Operand.virtual{saved};
            }
            or (sel src.scratch) {
                if (src.scratch::u32 >= sw.scratch.len) { ret unswitched(at, "a step of the switch names a scratch register the switch does not"); }
                ops[o] = Operand.virtual{(scratch[src.scratch])};
            }
            or {
                val opt_placed: opt[Operand] = stated_value(src.value);
                if (sel opt_placed.none) { ret unswitched(at, "a step of the switch states a value of a kind selection does not place"); }
                ops[o] = opt_placed.some;
            }
            o = o + 1;
        }
        val res_made: res[Instruction, Error] = made(st, b, mi.Opcode.row{row}, ?ops[0], step.values.len, md, false, vstate.NONE, Slice[rf.Id]{data: nil, size: 0});
        if (sel res_made.err) { ret err[Error].err{res_made.err}; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# the most scratch registers one switch names that selection places
val MOST_SCRATCH: u32 = 4;

# the operand a fixed value of a switch's step is placed as: a register at its own location, and an immediate,
# condition or enumerant without parameters as the immediate the handover reads as the row's operand states it
fun stated_value(v: mo.Value) opt[Operand] {
    if (sel v.register)  { ret opt[Operand].some{Operand.physical{Physical.register{v.register}}}; }
    if (sel v.immediate) { ret opt[Operand].some{Operand.immediate{v.immediate}}; }
    if (sel v.condition) { ret opt[Operand].some{Operand.immediate{v.condition::i64}}; }
    if (sel v.enumerant) {
        if (v.enumerant.params.len != 0) { ret opt[Operand].none{}; }
        ret opt[Operand].some{Operand.immediate{v.enumerant.value::i64}};
    }
    ret opt[Operand].none{};
}

# an inline assembly item emitted into block `b` as one instruction of the
# block masc parsed: each operand of the block at a virtual register of its
# class, tied where it reads and writes one, the frame slot of an alloca it
# reaches memory through, an address based in the register any other pointer
# is in, or the constant it binds, and what the block
# itself reads and writes as the instruction's implicit locations. a block
# that calls leaves undefined what a callee under the function's own row does
fun assemble(st: *State, b: u32, at: id.Instruction, md: Metadata) err[Error] {
    val d: *InstructionData = instruction(st, at);
    if (d.immediates.len == 0) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.assembly)) { ret err[Error].err{defect(NONE, false, UNKNOWN_NODE)}; }
    val blk: *ia.Assembly = imm.assembly;
    if (st.ctx == nil) { ret assembled(at, minline.Error.parsed{inline.UNAVAILABLE}); }
    var fp: rf.Id = rf.NONE;
    if (st.own != nil) {
        val opt_held: opt[rf.Id] = st.own.pointer;
        if (sel opt_held.some) { fp = opt_held.some; }
    }
    val format:     *Format                             = target_record.format(st.s.index.target);
    val res_parsed: res[*minline.Inline, minline.Error] = minline.parse(?st.s.inlines, blk, st.s.index.isa.set, st.s.index.target, st.ctx, format, fp, st.naked);
    if (sel res_parsed.err) { ret assembled(at, res_parsed.err); }
    val x:   *minline.Inline = res_parsed.ok;
    val n:   usize           = blk.operands.size;
    var ops: [ia.MOST_OPERANDS]Operand;
    var arg: usize           = 0;
    var out: usize           = 0;
    var k:   usize           = 0;
    for (k < n) {
        val o: *ia.Operand       = ?blk.operands.data[k];
        val c: inline.Constraint = o.constraint;
        if (sel c.class) {
            var source: u32 = NONE;
            var dest:   u32 = NONE;
            if ((o.role & mo.READ) != 0) {
                val res_value_register: res[u32, Error] = value_register(st, b, d.operands.data[arg], at, md);
                if (sel res_value_register.err) { ret err[Error].err{res_value_register.err}; }
                source = res_value_register.ok;
                arg    = arg + 1;
                if (!of_class(st, source, c.class)) { ret assembled(at, minline.Error.class{k::u32}); }
            }
            if ((o.role & mo.WRITE) != 0) {
                val res_register: res[u32, Error] = register(st, d.results.data[out]);
                if (sel res_register.err) { ret err[Error].err{res_register.err}; }
                dest = res_register.ok;
                out  = out + 1;
                if (!of_class(st, dest, c.class)) { ret assembled(at, minline.Error.class{k::u32}); }
            }
            if (source != NONE && dest != NONE) { ops[k] = Operand.tied{Tied{dest: Register.virtual{dest}, source: Register.virtual{source}}}; }
            or (source != NONE)                 { ops[k] = Operand.virtual{source}; }
            or                                  { ops[k] = Operand.virtual{dest}; }
        }
        or (sel c.memory) {
            val opt_local: opt[id.Instruction] = allocated(st, d.operands.data[arg]);
            if (sel opt_local.some) {
                val res_slot_for: res[u32, Error] = slot_for(st, opt_local.some);
                if (sel res_slot_for.err) { ret err[Error].err{res_slot_for.err}; }
                arg    = arg + 1;
                ops[k] = Operand.slot{res_slot_for.ok};
                k      = k + 1;
                cnt;
            }
            val res_value_register: res[u32, Error] = value_register(st, b, d.operands.data[arg], at, md);
            if (sel res_value_register.err) { ret err[Error].err{res_value_register.err}; }
            arg    = arg + 1;
            ops[k] = Operand.address{Built{base: opt[Register].some{Register.virtual{res_value_register.ok}}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: 0, symbol: opt[Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
        }
        or {
            val res_bound_immediate: res[opt[i64], Error] = bound_immediate(st, d.operands.data[arg], c.immediate);
            if (sel res_bound_immediate.err)     { ret err[Error].err{res_bound_immediate.err}; }
            if (sel res_bound_immediate.ok.none) { ret assembled(at, minline.Error.symbolic{k::u32}); }
            arg    = arg + 1;
            ops[k] = Operand.immediate{res_bound_immediate.ok.some};
        }
        k = k + 1;
    }
    vector.clear[Implicit](?st.implied);
    var j: usize = 0;
    for (j < x.reads.size) {
        val err_noted: err[Error] = note(st, Physical.register{x.reads.data[j]}, false);
        if (sel err_noted.err) { ret err_noted; }
        j = j + 1;
    }
    j = 0;
    for (j < x.writes.size) {
        val err_noted: err[Error] = note(st, Physical.register{x.writes.data[j]}, true);
        if (sel err_noted.err) { ret err_noted; }
        j = j + 1;
    }
    var clobbered: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    if (x.transfer == effect.CALL && st.calls.rows.size != 0 && st.own != nil) { clobbered = st.own.clobbered; }
    val res_made_at: res[Instruction, Error] = made(st, b, mi.Opcode.inline{x}, ?ops[0], n::u32, md, false, vstate.NONE, clobbered);
    if (sel res_made_at.err) { ret err[Error].err{res_made_at.err}; }
    if (st.implied.len == 0) { ret err[Error].ok{}; }
    ret imply(st, res_made_at.ok);
}

# emit the chosen expansions of an ir block in order
fun emit_block(st: *State, k: id.Block) err[Error] {
    val b: u32 = st.blocks.data[k];
    if (k == 0) {
        val err_entered: err[Error] = enter(st, b);
        if (sel err_entered.err) { ret err_entered; }
    }
    var i: usize = st.choices.len;
    for (i > 0) {
        i = i - 1;
        val c:    *Choice          = ?st.choices.data[i];
        val d:    *InstructionData = instruction(st, c.found.nodes[0]);
        val decl: bool             = covers_declassify(st, ?c.found);
        # the count-bounded and checked marks are read by the guards and are not carried to the machine form. the
        # expansion states its access as the node making it does, and states none where no one node does
        var md:         Metadata = d.metadata;
        val opt_access: opt[u32] = access_node(st, ?c.found);
        md.flags.bounded = false;
        md.flags.checked = false;
        md.extent        = NO_EXTENT;
        if (sel opt_access.none) { md.flags.public = false; }
        if (sel opt_access.some) {
            val made: Metadata = instruction(st, c.found.nodes[opt_access.some]).metadata;
            md.flags.public = made.flags.public;
            md.secret       = md.secret || made.secret;
            val res_framed: res[Extent, Error] = framed_slot(st, c.found.nodes[opt_access.some]);
            if (sel res_framed.err) { ret err[Error].err{res_framed.err}; }
            md.extent = res_framed.ok;
        }
        val before: u32 = st.out.instructions.len::u32;
        val root:   u32 = c.found.nodes[0];
        if (c.rule == NONE) {
            var err_done: err[Error]  = err[Error].ok{};
            val opt_slot: opt[Inside] = slot_access(st, c.found.nodes[0]);
            if (sel opt_slot.some)                                                     { err_done = slot_move(st, b, c.found.nodes[0], opt_slot.some, md); }
            or (timing(d.opcode))                                                      { err_done = switched(st, b, c.found.nodes[0], md); }
            or                                                                         { err_done = assemble(st, b, c.found.nodes[0], md); }
            if (sel err_done.err)                                                      { ret err_done; }
            if (st.out.instructions.len::u32 > before && st.firsts.data[root] == NONE) { st.firsts.data[root] = before; }
            cnt;
        }
        # an edge's copies may go in blocks of their own, so the first instruction is the first made in b
        val held:       usize      = st.out.blocks.data[b].instructions.len;
        val r:          *Rule      = ?st.s.index.isa.table.rules.at[c.rule];
        val err_routed: err[Error] = edges(st, b, c, md);
        if (sel err_routed.err) { ret err_routed; }
        var opt_pieces: opt[Slice[Placed]] = places_of(d);
        if (d.opcode == opcode_table.ARG_INCOMING || d.opcode == opcode_table.ARG_OUTGOING) { opt_pieces = opt[Slice[Placed]].none{}; }
        if (sel opt_pieces.some) {
            val err_done: err[Error] = lower_placed(st, b, c, r, opt_pieces.some, md, decl);
            if (sel err_done.err) { ret err_done; }
        }
        or {
            val err_done: err[Error] = expand(st, b, r, ?c.found, NONE, md, decl);
            if (sel err_done.err) { ret err_done; }
        }
        val own: *vector.Vector[Instruction] = ?st.out.blocks.data[b].instructions;
        if (own.len > held && st.firsts.data[root] == NONE) { st.firsts.data[root] = own.data[held]; }
    }
    ret err[Error].ok{};
}

# what a machine record reads for what an ir record reads: a constant itself,
# the virtual register of any other value, or nothing for a value selection
# gave no register, as one a rule folded into its user
fun reading_of(st: *State, r: Reads) Reading {
    if (!(sel r.operand)) { ret Reading.unavailable{}; }
    val v: id.Value = r.operand.value;
    val d: Def      = value(st, v).def;
    if (sel d.constant)                                               { ret Reading.constant{d.constant}; }
    if (v::usize >= st.registers.len || st.registers.data[v] == NONE) { ret Reading.unavailable{}; }
    ret Reading.register{Register.virtual{(st.registers.data[v])}};
}

# each ir record a machine record before the first machine instruction made
# for the ir instruction it stood before, or for the next one of its block
# that made any, and none for the records no instruction after them made
# anything for
fun place_points(st: *State) err[Error] {
    # a variable bound to its storage is in its slot at every point, from the first instruction of the entry on
    if (st.blocks.len > 0 && st.blocks.data[0] != NONE) {
        val entry: Slice[Instruction] = mf.instructions(st.out, (st.blocks.data[0]));
        var s:     usize              = 0;
        for (entry.size > 0 && s < st.stored.len) {
            val held:       Stored                      = st.stored.data[s];
            val made:       Point                       = Point{at: entry.data[0], binding: held.binding, piece: point.WHOLE, reads: Reading.slot{held.slot}, expression: point.PLAIN, from: 0};
            val res_pushed: res[usize, allocator.Error] = vector.push[Point](?st.out.points, made);
            if (sel res_pushed.err) { ret alloc_err(res_pushed.err); }
            s = s + 1;
        }
    }
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        if (!st.body.blocks.data[k].erased) {
            val list:    *vector.Vector[id.Instruction] = ?st.body.blocks.data[k].instructions;
            var pending: usize                          = 0;
            var p:       usize                          = 0;
            for (p < list.len) {
                val at: u32 = list.data[p];
                if (st.firsts.data[at] != NONE) {
                    var q: usize = pending;
                    for (q <= p) {
                        var r: u32 = st.body.instructions.data[list.data[q]].points.first;
                        for (r != 0) {
                            val pt:   IrPoint    = st.body.points.data[r - 1];
                            val read: Reads      = pt.reads;
                            var e:    Expression = point.PLAIN;
                            var from: Type       = 0;
                            if (sel read.operand) {
                                e    = read.operand.expression;
                                from = value(st, read.operand.value).type;
                            }
                            val made:       Point                       = Point{at: (st.firsts.data[at]), binding: pt.binding, piece: pt.piece, reads: reading_of(st, read), expression: e, from: from};
                            val res_pushed: res[usize, allocator.Error] = vector.push[Point](?st.out.points, made);
                            if (sel res_pushed.err) { ret alloc_err(res_pushed.err); }
                            r = pt.next;
                        }
                        q = q + 1;
                    }
                    pending = p + 1;
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# refuse a naked function whose body is more than inline blocks that bind
# nothing and the terminator that ends it, since it has no frame to hold a value in
fun bare(st: *State) err[Error] {
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        if (!st.body.blocks.data[k].erased) {
            val list: *vector.Vector[id.Instruction] = ?st.body.blocks.data[k].instructions;
            var i:    usize                          = 0;
            for (i < list.len) {
                val d:    *InstructionData = instruction(st, list.data[i]);
                val code: u32              = d.opcode;
                val ends: bool             = code == opcode_table.UNREACHABLE;
                val held: bool             = code == opcode_table.ASM && d.operands.len == 0 && d.results.len == 0;
                if (!ends && !held) { ret err[Error].err{Error.naked{list.data[i]}}; }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the type a load reads or a store writes, and the alignment it states, none
# for any other instruction
fun access(st: *State, d: *InstructionData) opt[Accessed] {
    val load:  bool = d.opcode == opcode_table.LOAD;
    val store: bool = d.opcode == opcode_table.STORE;
    if (!load && !store) { ret opt[Accessed].none{}; }
    var ty:    Type  = 0;
    var typed: bool  = false;
    var align: u64   = 0;
    var k:     usize = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.ty) {
            if (!typed) { ty = imm.ty; }
            typed = true;
        }
        if (sel imm.alignment) { align = imm.alignment; }
        k = k + 1;
    }
    if (store && d.operands.len == 2) {
        ty    = st.body.values.data[d.operands.data[1]].type;
        typed = true;
    }
    if (!typed || align == 0) { ret opt[Accessed].none{}; }
    ret opt[Accessed].some{Accessed{ty: ty, align: align}};
}

# a load or store's type and the alignment it states
rec Accessed {
    ty:    Type;
    align: u64;
}

# on a target that does not carry out a scalar access below its type's own
# alignment, refuse a load or store that states one, naming its type, never
# making an access that may trap
fun aligned(st: *State) err[Error] {
    if (st.s.index.target.misaligned) { ret err[Error].ok{}; }
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        val bd: *BlockData = ?st.body.blocks.data[k];
        if (!bd.erased) {
            var i: usize = 0;
            for (i < bd.instructions.len) {
                val opt_access: opt[Accessed] = access(st, instruction(st, bd.instructions.data[i]));
                if (sel opt_access.some) {
                    val res_own: res[u64, target_record.Error] = layout.align(?st.layout, opt_access.some.ty, type_table.DEFAULT_SPACE);
                    if (sel res_own.err)                    { ret err[Error].err{Error.layout{opt_access.some.ty}}; }
                    if (opt_access.some.align < res_own.ok) { ret err[Error].err{Error.misaligned{opt_access.some.ty}}; }
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# select the state's function into its machine function: check a naked body
# and the accesses' alignment, choose and emit every block, land the jump
# tables' targets and place the records
fun run(st: *State) err[Error] {
    if (st.naked) {
        val err_held: err[Error] = bare(st);
        if (sel err_held.err) { ret err_held; }
    }
    val err_placed: err[Error] = aligned(st);
    if (sel err_placed.err) { ret err_placed; }
    val err_values: err[Error] = grow(?st.registers, st.body.values.len, NONE);
    if (sel err_values.err) { ret err_values; }
    val err_places: err[Error] = grow(?st.position, st.body.instructions.len, 0);
    if (sel err_places.err) { ret err_places; }
    val err_eaten: err[Error] = grow_bool(?st.consumed, st.body.instructions.len);
    if (sel err_eaten.err) { ret err_eaten; }
    val err_read: err[Error] = grow(?st.shared, st.body.instructions.len, 0);
    if (sel err_read.err) { ret err_read; }
    val err_leafed: err[Error] = grow(?st.leaves, st.body.instructions.len, 0);
    if (sel err_leafed.err) { ret err_leafed; }
    val err_first: err[Error] = grow(?st.firsts, st.body.instructions.len, NONE);
    if (sel err_first.err) { ret err_first; }
    val err_asked: err[Error] = grow(?st.direct, st.body.instructions.len, NONE);
    if (sel err_asked.err) { ret err_asked; }
    val err_framed: err[Error] = grow(?st.frames, st.body.instructions.len, NONE);
    if (sel err_framed.err) { ret err_framed; }
    var k: usize = 0;
    for (k < st.body.blocks.len) {
        if (st.body.blocks.data[k].erased) {
            val err_push_u32: err[Error] = push_u32(?st.blocks, NONE);
            if (sel err_push_u32.err) { ret err_push_u32; }
        }
        or {
            val res_made: res[Block, mf.Error] = mf.block(st.out);
            if (sel res_made.err) { ret err[Error].err{Error.machine{res_made.err}}; }
            val err_push_u32: err[Error] = push_u32(?st.blocks, res_made.ok);
            if (sel err_push_u32.err) { ret err_push_u32; }
        }
        k = k + 1;
    }
    k = 0;
    for (k < st.body.blocks.len) {
        if (!st.body.blocks.data[k].erased) {
            val err_chosen: err[Error] = choose_block(st, (k::u32));
            if (sel err_chosen.err) { ret err_chosen; }
            val err_emitted: err[Error] = emit_block(st, (k::u32));
            if (sel err_emitted.err) { ret err_emitted; }
        }
        k = k + 1;
    }
    val err_landed: err[Error] = land(st);
    if (sel err_landed.err) { ret err_landed; }
    ret place_points(st);
}

# select an ir function into a new machine function
# ---
# s:       the selector
# m:       the module
# f:       the function, which has a body
# calls:   what its calls state to the allocator
# context: the context it is selected under, which admits its rows and reads
#          its inline assembly: the selector's, or one its extensions past
#          the build's widen it to over the same register file, nil for a
#          selection with none
# own:     the registers of the convention row the function is under, which
#          its entry, returns and inline assembly read, nil for a selection
#          with no convention row
# checked: whether the machine function checks each instruction against its
#          row as it is appended, as a checked compilation does
# framing: the frame code bound to `context`
# ret:     the machine function and the clobbers of its calls, or why
#          selection refused, with nothing left made
pub fun select(s: *Selector, m: *Module, f: id.Function, calls: *Calls, context: *core_state.Context, own: *Registers, checked: bool, framing: *frame_code.Admitted) res[Selected, Error] {
    val res_body: res[*Body, module.Error] = module.body(m, f);
    if (sel res_body.err) { ret res[Selected, Error].err{Error.module{res_body.err}}; }
    var timed:     mct.Timed                = mct.plain(context);
    var opt_asked: opt[*core_state.Context] = opt[*core_state.Context].none{};
    fin { mct.dnit(?timed); }
    if (in_constant_time(m.functions.data[f].data.constant_time)) {
        val err_assumed: err[allocator.Error] = mct.assume(s.a, context, ?timed);
        if (sel err_assumed.err) { ret res[Selected, Error].err{Error.alloc{err_assumed.err}}; }
        opt_asked = opt[*core_state.Context].some{?timed.context};
    }
    var out:      mf.Function            = mf.init(s.a, s.index.isa.set, checked);
    var clobbers: vector.Vector[Clobber] = vector.init[Clobber](s.a);
    var masks:    vector.Vector[u64]     = vector.init[u64](s.a);
    var st:       State                  = State{
        s:         s,
        ctx:       context,
        m:         m,
        f:         f,
        body:      res_body.ok,
        out:       ?out,
        calls:     calls,
        own:       own,
        clobbers:  ?clobbers,
        masks:     ?masks,
        words:     0,
        sets:      vector.init[Slice[rf.Id]](s.a),
        labels:    0,
        layout:    layout.of(s.index.target, ?m.types, context_of(s)),
        implied:   vector.init[Implicit](s.a),
        registers: vector.init[u32](s.a),
        held:      vector.init[u32](s.a),
        blocks:    vector.init[u32](s.a),
        consumed:  vector.init[bool](s.a),
        shared:    vector.init[u32](s.a),
        leaves:    vector.init[u32](s.a),
        position:  vector.init[u32](s.a),
        impure:    vector.init[u32](s.a),
        choices:   vector.init[Choice](s.a),
        targets:   vector.init[u32](s.a),
        moves:     vector.init[Move](s.a),
        loc:       vector.init[u32](s.a),
        pred:      vector.init[u32](s.a),
        ready:     vector.init[u32](s.a),
        todo:      vector.init[u32](s.a),
        firsts:    vector.init[u32](s.a),
        stored:    vector.init[Stored](s.a),
        frames:    vector.init[u32](s.a),
        direct:    vector.init[u32](s.a),
        views:     vector.init[u32](s.a),
        naked:     register_schema.naked(m, f),
        timed:     opt_asked,
        code:      framing,
    };
    val err_ran: err[Error] = run(?st);
    val words:   u32        = st.words;
    state_dnit(?st);
    if (sel err_ran.err) {
        mf.dnit(?out);
        vector.dnit[u64](?masks);
        vector.dnit[Clobber](?clobbers);
        ret res[Selected, Error].err{err_ran.err};
    }
    ret res[Selected, Error].ok{Selected{function: out, words: words, masks: masks, clobbers: clobbers}};
}
