# the types a target reaches and the table check over them
#
# a type has exactly one class, the one row of `holds` that admits it and
# whose condition the build meets. the check names the types a target reaches
# under the build and counts the rows admitting each, so it grows with the
# types and rows and never pairs rows against rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use core_state: masc.core.state;

use ir: mirl.ir.opcode;
use mirl.ir.opcode.rule.Class;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.type.format.Format;
use mirl.machine.select.rule.Holds;
use mirl.machine.select.rule.Rules;
use mirl.machine.select.rule.Table;
use mirl.target.basis;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Counts;
use mirl.target.capability.Formats;
use mirl.target.capability.Held;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.Unit;
use mirl.target.capability.Vectors;
use mirl.target.record;
use mirl.target.record.Target;
use units: mirl.target.vector;

# a vector the target operates on
# ---
# lane:  the lane type
# lanes: the lane count
pub rec Packed {
    lane:  LaneType;
    lanes: u32;
}

# a type described without a type table, so a refusal names it
# ---
# integer: an integer of this width
# float:   a float in this number format
# pointer: a pointer into this address space
# vector:  a vector
pub tag Reach: u8 {
    integer: u32;
    float:   Format;
    pointer: u32;
    vector:  Packed;
}

# a type that two rows admit
# ---
# reach:  the type
# first:  the first row that admits it
# second: the next row that admits it
pub rec Overlap {
    reach:  Reach;
    first:  u32;
    second: u32;
}

# why the check refused
# ---
# alloc:     the allocator refused storage
# types:     the type table refused a type
# target:    the target leaves a declaration unstated
# unit:      a vector unit's condition was not read against the build
# overlap:   a type is admitted by more than one row the build meets
# uncovered: a type is admitted by no row the build meets
# condition: a row's condition was not read against the build
pub tag Refusal: u8 {
    alloc:     allocator.Error;
    types:     types.Error;
    target:    record.Error;
    unit:      units.Error;
    overlap:   Overlap;
    uncovered: Reach;
    condition: basis.Error;
}

# how many rows admit a type, stopping at two
# ---
# count:  0, 1, or 2 for any more than one
# first:  the first row that admits it
# second: the second row that admits it
pub rec Admit {
    count:  u32;
    first:  u32;
    second: u32;
}

# count the rows of `holds` that admit a type and whose condition the build meets
# ---
# t:     the type table
# holds: the rows
# ty:    the type
# ctx:   the build's context, none for a run with no build, under which only
#        a row held always is met
# ret:   how many admit it, or the type table's refusal, or a condition that
#        was not read
pub fun admitting(t: *types.Table, holds: Holds, ty: Type, ctx: opt[*core_state.Context]) res[Admit, Refusal] {
    var a: Admit = Admit{count: 0, first: 0, second: 0};
    var h: u32   = 0;
    for (a.count < 2 && h < holds.len) {
        val got: res[bool, types.Error] = ir.within(t, holds.at[h].class, ty);
        if (sel got.err) { ret res[Admit, Refusal].err{Refusal.types{got.err}}; }
        var met: bool = false;
        if (got.ok) {
            val held: res[bool, basis.Error] = basis.admits(ctx, holds.at[h].requires);
            if (sel held.err) { ret res[Admit, Refusal].err{Refusal.condition{held.err}}; }
            met = held.ok;
        }
        if (met) {
            if (a.count == 0) { a.first = h; }
            or                { a.second = h; }
            a.count = a.count + 1;
        }
        h = h + 1;
    }
    ret res[Admit, Refusal].ok{a};
}

fun add(out: *vector.Vector[Reach], r: Reach) err[Refusal] {
    val pushed: res[usize, allocator.Error] = vector.push[Reach](out, r);
    if (sel pushed.err) { ret err[Refusal].err{Refusal.alloc{pushed.err}}; }
    ret err[Refusal].ok{};
}

# whether the build holds a format: a row of the target's formats states it
# under a condition the build meets
fun holds_format(target: *Target, f: Format, ctx: opt[*core_state.Context]) res[bool, Refusal] {
    val formats: Formats = target.caps.formats;
    if (!(sel formats.held)) { ret res[bool, Refusal].ok{false}; }
    val list: Slice[Held] = formats.held;
    var i:    usize       = 0;
    for (i < list.size) {
        if (list.data[i].format != nil && list.data[i].format.index == f.index) {
            val met: res[bool, basis.Error] = basis.admits(ctx, list.data[i].condition);
            if (sel met.err) { ret res[bool, Refusal].err{Refusal.condition{met.err}}; }
            if (met.ok)      { ret res[bool, Refusal].ok{true}; }
        }
        i = i + 1;
    }
    ret res[bool, Refusal].ok{false};
}

# the widths the type tests of the rules name, and the formats they name that
# the build holds, as a value of a format it does not hold never reaches
# selection
fun tests_of(out: *vector.Vector[Reach], target: *Target, rules: Rules, ctx: opt[*core_state.Context]) err[Refusal] {
    var i: u32 = 0;
    for (i < rules.len) {
        var k: u32 = 0;
        for (k < rules.at[i].tests.len) {
            val class: Class        = rules.at[i].tests.at[k].class;
            var r:     err[Refusal] = err[Refusal].ok{};
            if (sel class.width) { r = add(out, Reach.integer{class.width}); }
            or (sel class.format) {
                val held: res[bool, Refusal] = holds_format(target, class.format, ctx);
                if (sel held.err) { ret err[Refusal].err{held.err}; }
                if (held.ok)      { r = add(out, Reach.float{class.format}); }
            }
            if (sel r.err) { ret r; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the packed vectors of every unit the build meets
fun vectors_of(out: *vector.Vector[Reach], v: Vectors, ctx: opt[*core_state.Context]) err[Refusal] {
    if (!(sel v.units)) { ret err[Refusal].ok{}; }
    var u: usize = 0;
    for (u < v.units.size) {
        val unit: *Unit                  = ?v.units.data[u];
        val met:  res[bool, units.Error] = units.meets(ctx, unit);
        if (sel met.err) { ret err[Refusal].err{Refusal.unit{met.err}}; }
        var i: usize = 0;
        for (met.ok && i < unit.lanes.size) {
            val lane: Lane = unit.lanes.data[i];
            if (sel lane.form.packed) {
                val counts: Counts = unit.counts;
                if (sel counts.listed) {
                    var k: usize = 0;
                    for (k < counts.listed.size) {
                        val r: err[Refusal] = add(out, Reach.vector{Packed{lane: lane.lane, lanes: counts.listed.data[k]}});
                        if (sel r.err) { ret r; }
                        k = k + 1;
                    }
                }
                or {
                    val r: err[Refusal] = add(out, Reach.vector{Packed{lane: lane.lane, lanes: 2}});
                    if (sel r.err) { ret r; }
                }
            }
            i = i + 1;
        }
        u = u + 1;
    }
    ret err[Refusal].ok{};
}

# every type the target reaches: the one-bit condition every compare gives, the
# integers and pointers it declares native, the floats of the format rows the
# build meets, the vectors only of the units the build meets, and the widths
# its rules test with the formats they test that the build holds
fun gather(out: *vector.Vector[Reach], target: *Target, table: *Table, ctx: opt[*core_state.Context]) err[Refusal] {
    val caps: *Capabilities = ?target.caps;
    val bit:  err[Refusal]  = add(out, Reach.integer{1});
    if (sel bit.err) { ret bit; }
    var i: usize = 0;
    if (sel caps.widths.integers.widths) {
        for (i < caps.widths.integers.widths.size) {
            val r: err[Refusal] = add(out, Reach.integer{caps.widths.integers.widths.data[i]});
            if (sel r.err) { ret r; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < caps.widths.pointers.size) {
        val r: err[Refusal] = add(out, Reach.pointer{caps.widths.pointers.data[i].space});
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    i = 0;
    if (sel caps.formats.held) {
        for (i < caps.formats.held.size) {
            val met: res[bool, basis.Error] = basis.admits(ctx, caps.formats.held.data[i].condition);
            if (sel met.err) { ret err[Refusal].err{Refusal.condition{met.err}}; }
            if (met.ok) {
                val r: err[Refusal] = add(out, Reach.float{@caps.formats.held.data[i].format});
                if (sel r.err) { ret r; }
            }
            i = i + 1;
        }
    }
    val vectors: err[Refusal] = vectors_of(out, caps.vectors, ctx);
    if (sel vectors.err) { ret vectors; }
    val rules: err[Refusal] = tests_of(out, target, table.rules, ctx);
    if (sel rules.err) { ret rules; }
    ret tests_of(out, target, table.constants, ctx);
}

fun lane_of(t: *types.Table, l: LaneType) res[Type, types.Error] {
    if (sel l.integer) { ret types.intern(t, types.Shape.integer{types.Integer{width: l.integer}}); }
    if (sel l.float)   { ret types.intern(t, types.Shape.float{types.Float{format: @l.float}}); }
    ret res[Type, types.Error].err{types.Error.unknown{Type{index: 0}}};
}

fun intern(t: *types.Table, r: Reach) res[Type, types.Error] {
    if (sel r.integer) { ret types.intern(t, types.Shape.integer{types.Integer{width: r.integer}}); }
    if (sel r.float)   { ret types.intern(t, types.Shape.float{types.Float{format: r.float}}); }
    if (sel r.pointer) { ret types.intern(t, types.Shape.pointer{types.Pointer{space: r.pointer}}); }
    if (sel r.vector) {
        val packed: Packed                 = r.vector;
        val lane:   res[Type, types.Error] = lane_of(t, packed.lane);
        if (sel lane.err) { ret lane; }
        ret types.intern(t, types.Shape.vector{types.Vector{lanes: packed.lanes, element: lane.ok}});
    }
    ret res[Type, types.Error].err{types.Error.unknown{Type{index: 0}}};
}

fun scan(t: *types.Table, reached: Slice[Reach], holds: Holds, ctx: opt[*core_state.Context]) err[Refusal] {
    var i: usize = 0;
    for (i < reached.size) {
        val made: res[Type, types.Error] = intern(t, reached.data[i]);
        if (sel made.err) { ret err[Refusal].err{Refusal.types{made.err}}; }
        val got: res[Admit, Refusal] = admitting(t, holds, made.ok, ctx);
        if (sel got.err) { ret err[Refusal].err{got.err}; }
        val n: Admit = got.ok;
        if (n.count == 0) { ret err[Refusal].err{Refusal.uncovered{reached.data[i]}}; }
        if (n.count > 1)  { ret err[Refusal].err{Refusal.overlap{Overlap{reach: reached.data[i], first: n.first, second: n.second}}}; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

fun count(a: *allocator.Allocator, reached: Slice[Reach], holds: Holds, ctx: opt[*core_state.Context]) err[Refusal] {
    var t:     types.Table          = types.init(a);
    val out:   err[Refusal]         = scan(?t, reached, holds, ctx);
    val freed: err[allocator.Error] = types.dnit(?t);
    if (sel out.err)   { ret out; }
    if (sel freed.err) { ret err[Refusal].err{Refusal.alloc{freed.err}}; }
    ret out;
}

# check that every type a target reaches has exactly one row in a table the
# build meets
# ---
# a:       the allocator for the scratch storage
# table:   the table
# target:  the target
# context: the build's selection under its architecture's state, nil for a
#          run with no build, under which only an unconditional unit holds
# ret:     ok, or the first type with no row or with more than one
pub fun check(a: *allocator.Allocator, table: *Table, target: *Target, context: *core_state.Context) err[Refusal] {
    var ctx: opt[*core_state.Context] = opt[*core_state.Context].none{};
    if (context != nil) { ctx = opt[*core_state.Context].some{context}; }
    val declared: err[record.Error] = record.declared(target);
    if (sel declared.err) { ret err[Refusal].err{Refusal.target{declared.err}}; }
    var list:     vector.Vector[Reach] = vector.init[Reach](a);
    val gathered: err[Refusal]         = gather(?list, target, table, ctx);
    var out:      err[Refusal]         = gathered;
    if (sel gathered.ok) { out = count(a, Slice[Reach]{data: list.data, size: list.len}, table.holds, ctx); }
    val freed: err[allocator.Error] = vector.dnit[Reach](?list);
    if (sel out.err)   { ret out; }
    if (sel freed.err) { ret err[Refusal].err{Refusal.alloc{freed.err}}; }
    ret out;
}
