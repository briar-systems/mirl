# the types a target reaches and the table check over them
#
# a type has exactly one class, the one row of `holds` that admits it and
# whose condition the build meets. the check names the types a target reaches
# under the build and counts the rows admitting each, so it grows with the
# types and rows and never pairs rows against rows.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use core_state: masc.core.state;

use opcode_check: mirl.ir.opcode.check;
use mirl.ir.opcode.rule.Class;
use mirl.ir.type.format.Format;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.machine.select.rule.Holds;
use mirl.machine.select.rule.Rules;
use mirl.machine.select.rule.Table;
use mirl.target.basis;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Counts;
use mirl.target.capability.Formats;
use mirl.target.capability.Held;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.Unit;
use mirl.target.capability.Vectors;
use mirl.target.record;
use mirl.target.record.Target;
use units: mirl.target.vector;

# a vector the target operates on
# ---
# lane:  the lane type
# lanes: the lane count
pub rec Packed {
    lane:  LaneType;
    lanes: u32;
}

# a type described without a type table, so a refusal names it
# ---
# integer: an integer of this width
# float:   a float in this number format
# pointer: a pointer into this address space
# vector:  a vector
pub tag Reach: u8 {
    integer: u32;
    float:   Format;
    pointer: u32;
    vector:  Packed;
}

# a type that two rows admit
# ---
# reach:  the type
# first:  the first row that admits it
# second: the next row that admits it
pub rec Overlap {
    reach:  Reach;
    first:  u32;
    second: u32;
}

# why the check refused
# ---
# alloc:     the allocator refused storage
# types:     the type table refused a type
# target:    the target leaves a declaration unstated
# unit:      a vector unit's condition was not read against the build
# overlap:   a type is admitted by more than one row the build meets
# uncovered: a type is admitted by no row the build meets
# condition: a row's condition was not read against the build
pub tag Error: u8 {
    alloc:     allocator.Error;
    types:     type_table.Error;
    target:    record.Error;
    unit:      units.Error;
    overlap:   Overlap;
    uncovered: Reach;
    condition: basis.Error;
}

# how many rows admit a type, stopping at two
# ---
# count:  0, 1, or 2 for any more than one
# first:  the first row that admits it
# second: the second row that admits it
pub rec Admit {
    count:  u32;
    first:  u32;
    second: u32;
}

# count the rows of `holds` that admit a type and whose condition the build meets
# ---
# t:     the type table
# holds: the rows
# ty:    the type
# ctx:   the build's context, none for a run with no build, under which only
#        a row held always is met
# ret:   how many admit it, or the type table's refusal, or a condition that
#        was not read
pub fun admitting(t: *type_table.Table, holds: Holds, ty: Type, ctx: opt[*core_state.Context]) res[Admit, Error] {
    var a: Admit = Admit{count: 0, first: 0, second: 0};
    var h: u32   = 0;
    for (a.count < 2 && h < holds.len) {
        val res_within: res[bool, type_table.Error] = opcode_check.within(t, holds.at[h].class, ty);
        if (sel res_within.err) { ret res[Admit, Error].err{Error.types{res_within.err}}; }
        var met: bool = false;
        if (res_within.ok) {
            val res_held: res[bool, basis.Error] = basis.admits(ctx, holds.at[h].requires);
            if (sel res_held.err) { ret res[Admit, Error].err{Error.condition{res_held.err}}; }
            met = res_held.ok;
        }
        if (met) {
            if (a.count == 0) { a.first = h; }
            or                { a.second = h; }
            a.count = a.count + 1;
        }
        h = h + 1;
    }
    ret res[Admit, Error].ok{a};
}

fun add(out: *vector.Vector[Reach], r: Reach) err[Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[Reach](out, r);
    if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
    ret err[Error].ok{};
}

# whether the build holds a format: a row of the target's formats states it
# under a condition the build meets
fun holds_format(target: *Target, f: Format, ctx: opt[*core_state.Context]) res[bool, Error] {
    val formats: Formats = target.caps.formats;
    if (!(sel formats.held)) { ret res[bool, Error].ok{false}; }
    val list: Slice[Held] = formats.held;
    var i:    usize       = 0;
    for (i < list.size) {
        if (list.data[i].format != nil && (@list.data[i].format) == f) {
            val res_met: res[bool, basis.Error] = basis.admits(ctx, list.data[i].condition);
            if (sel res_met.err) { ret res[bool, Error].err{Error.condition{res_met.err}}; }
            if (res_met.ok)      { ret res[bool, Error].ok{true}; }
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{false};
}

# the widths the type tests of the rules name, and the formats they name that
# the build holds, as a value of a format it does not hold never reaches
# selection
fun tests_of(out: *vector.Vector[Reach], target: *Target, rules: Rules, ctx: opt[*core_state.Context]) err[Error] {
    var i: u32 = 0;
    for (i < rules.len) {
        var k: u32 = 0;
        for (k < rules.at[i].tests.len) {
            val class:         Class      = rules.at[i].tests.at[k].class;
            var err_out_added: err[Error] = err[Error].ok{};
            if (sel class.width) { err_out_added = add(out, Reach.integer{class.width}); }
            or (sel class.format) {
                val res_held: res[bool, Error] = holds_format(target, class.format, ctx);
                if (sel res_held.err) { ret err[Error].err{res_held.err}; }
                if (res_held.ok)      { err_out_added = add(out, Reach.float{class.format}); }
            }
            if (sel err_out_added.err) { ret err_out_added; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the packed vectors of every unit the build meets
fun vectors_of(out: *vector.Vector[Reach], v: Vectors, ctx: opt[*core_state.Context]) err[Error] {
    if (!(sel v.units)) { ret err[Error].ok{}; }
    var u: usize = 0;
    for (u < v.units.size) {
        val unit:    *Unit                  = ?v.units.data[u];
        val res_met: res[bool, units.Error] = units.meets(ctx, unit);
        if (sel res_met.err) { ret err[Error].err{Error.unit{res_met.err}}; }
        var i: usize = 0;
        for (res_met.ok && i < unit.lanes.size) {
            val lane: Lane = unit.lanes.data[i];
            if (sel lane.form.packed) {
                val counts: Counts = unit.counts;
                if (sel counts.listed) {
                    var k: usize = 0;
                    for (k < counts.listed.size) {
                        val err_out_added: err[Error] = add(out, Reach.vector{Packed{lane: lane.lane, lanes: counts.listed.data[k]}});
                        if (sel err_out_added.err) { ret err_out_added; }
                        k = k + 1;
                    }
                }
                or {
                    val err_out_added: err[Error] = add(out, Reach.vector{Packed{lane: lane.lane, lanes: 2}});
                    if (sel err_out_added.err) { ret err_out_added; }
                }
            }
            i = i + 1;
        }
        u = u + 1;
    }
    ret err[Error].ok{};
}

# every type the target reaches: the one-bit condition every compare gives, the
# integers and pointers it declares native, the floats of the format rows the
# build meets, the vectors only of the units the build meets, and the widths
# its rules test with the formats they test that the build holds
fun gather(out: *vector.Vector[Reach], target: *Target, table: *Table, ctx: opt[*core_state.Context]) err[Error] {
    val caps:    *Capabilities = ?target.caps;
    val err_bit: err[Error]    = add(out, Reach.integer{1});
    if (sel err_bit.err) { ret err_bit; }
    var i: usize = 0;
    if (sel caps.widths.integers.widths) {
        for (i < caps.widths.integers.widths.size) {
            val err_out_added: err[Error] = add(out, Reach.integer{caps.widths.integers.widths.data[i]});
            if (sel err_out_added.err) { ret err_out_added; }
            i = i + 1;
        }
    }
    i = 0;
    for (i < caps.widths.pointers.size) {
        val err_out_added: err[Error] = add(out, Reach.pointer{caps.widths.pointers.data[i].space});
        if (sel err_out_added.err) { ret err_out_added; }
        i = i + 1;
    }
    i = 0;
    if (sel caps.formats.held) {
        for (i < caps.formats.held.size) {
            val res_met: res[bool, basis.Error] = basis.admits(ctx, caps.formats.held.data[i].condition);
            if (sel res_met.err) { ret err[Error].err{Error.condition{res_met.err}}; }
            if (res_met.ok) {
                val err_out_added: err[Error] = add(out, Reach.float{@caps.formats.held.data[i].format});
                if (sel err_out_added.err) { ret err_out_added; }
            }
            i = i + 1;
        }
    }
    val err_vectors: err[Error] = vectors_of(out, caps.vectors, ctx);
    if (sel err_vectors.err) { ret err_vectors; }
    val err_rules: err[Error] = tests_of(out, target, table.rules, ctx);
    if (sel err_rules.err) { ret err_rules; }
    val err_constants: err[Error] = tests_of(out, target, table.constants, ctx);
    if (sel err_constants.err) { ret err_constants; }
    ret tests_of(out, target, table.offsets, ctx);
}

fun lane_of(t: *type_table.Table, l: LaneType) res[Type, type_table.Error] {
    if (sel l.integer) { ret type_table.intern(t, type_table.Shape.integer{type_table.Integer{width: l.integer}}); }
    if (sel l.float)   { ret type_table.intern(t, type_table.Shape.float{type_table.Float{format: @l.float}}); }
    ret res[Type, type_table.Error].err{type_table.Error.unknown{0}};
}

fun intern(t: *type_table.Table, r: Reach) res[Type, type_table.Error] {
    if (sel r.integer) { ret type_table.intern(t, type_table.Shape.integer{type_table.Integer{width: r.integer}}); }
    if (sel r.float)   { ret type_table.intern(t, type_table.Shape.float{type_table.Float{format: r.float}}); }
    if (sel r.pointer) { ret type_table.intern(t, type_table.Shape.pointer{type_table.Pointer{space: r.pointer}}); }
    if (sel r.vector) {
        val packed:   Packed                      = r.vector;
        val res_lane: res[Type, type_table.Error] = lane_of(t, packed.lane);
        if (sel res_lane.err) { ret res_lane; }
        ret type_table.intern(t, type_table.Shape.vector{type_table.Vector{lanes: packed.lanes, element: res_lane.ok}});
    }
    ret res[Type, type_table.Error].err{type_table.Error.unknown{0}};
}

fun scan(t: *type_table.Table, reached: Slice[Reach], holds: Holds, ctx: opt[*core_state.Context]) err[Error] {
    var i: usize = 0;
    for (i < reached.size) {
        val res_made: res[Type, type_table.Error] = intern(t, reached.data[i]);
        if (sel res_made.err) { ret err[Error].err{Error.types{res_made.err}}; }
        val res_admitting: res[Admit, Error] = admitting(t, holds, res_made.ok, ctx);
        if (sel res_admitting.err) { ret err[Error].err{res_admitting.err}; }
        val n: Admit = res_admitting.ok;
        if (n.count == 0) { ret err[Error].err{Error.uncovered{reached.data[i]}}; }
        if (n.count > 1)  { ret err[Error].err{Error.overlap{Overlap{reach: reached.data[i], first: n.first, second: n.second}}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun count(a: *allocator.Allocator, reached: Slice[Reach], holds: Holds, ctx: opt[*core_state.Context]) err[Error] {
    var t:         type_table.Table     = type_table.init(a);
    val err_out:   err[Error]           = scan(?t, reached, holds, ctx);
    val err_freed: err[allocator.Error] = type_table.dnit(?t);
    if (sel err_out.err)   { ret err_out; }
    if (sel err_freed.err) { ret err[Error].err{Error.alloc{err_freed.err}}; }
    ret err_out;
}

# check that every type a target reaches has exactly one row in a table the
# build meets
# ---
# a:       the allocator for the scratch storage
# table:   the table
# target:  the target
# context: the build's selection under its architecture's state, nil for a
#          run with no build, under which only an unconditional unit holds
# ret:     ok, or the first type with no row or with more than one
pub fun check(a: *allocator.Allocator, table: *Table, target: *Target, context: *core_state.Context) err[Error] {
    var opt_ctx: opt[*core_state.Context] = opt[*core_state.Context].none{};
    if (context != nil) { opt_ctx = opt[*core_state.Context].some{context}; }
    val err_declared: err[record.Error] = record.declared(target);
    if (sel err_declared.err) { ret err[Error].err{Error.target{err_declared.err}}; }
    var list:         vector.Vector[Reach] = vector.init[Reach](a);
    val err_gathered: err[Error]           = gather(?list, target, table, opt_ctx);
    var err_out:      err[Error]           = err_gathered;
    if (sel err_gathered.ok) { err_out = count(a, Slice[Reach]{data: list.data, size: list.len}, table.holds, opt_ctx); }
    val err_freed: err[allocator.Error] = vector.dnit[Reach](?list);
    if (sel err_out.err)   { ret err_out; }
    if (sel err_freed.err) { ret err[Error].err{Error.alloc{err_freed.err}}; }
    ret err_out;
}
