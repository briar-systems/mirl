# what a rule matched, read by the engine and by a rule's hooks
#
# a match names the ir instructions a pattern covered, in the function body
# the engine is selecting. the facts of an operand, its value, its type and
# the constant it is, are read here and nowhere else, so a hook never repeats
# how the engine reads them.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.constant.ConstantData;
use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.ValueData;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;

# why a read of a match was refused
# ---
# module: the module refused a read
# types:  the type table refused a read
pub tag Refusal: u8 {
    module: module.Error;
    types:  types.Error;
}

# the ir instruction a node matched
pub fun instruction(mt: *Match, node: u8) *InstructionData {
    ret ?mt.body.instructions.data[mt.nodes[node].index];
}

# the data of a value
pub fun value(mt: *Match, v: id.Value) *ValueData {
    ret ?mt.body.values.data[v.index];
}

# operand `s.index` of node `s.node`, as the pattern states it: the two
# operands of a node that matched the other way round are swapped back
pub fun operand(mt: *Match, s: Slot) opt[id.Value] {
    if (s.node::u32 >= mt.count) { ret opt[id.Value].none{}; }
    val d: *InstructionData = instruction(mt, s.node);
    var k: u32              = s.index::u32;
    if (k < 2 && ((mt.swapped >> s.node::u32) & 1) != 0) { k = 1 - k; }
    if (k::usize >= d.operands.len)                      { ret opt[id.Value].none{}; }
    ret opt[id.Value].some{d.operands.data[k]};
}

# result `s.index` of node `s.node`
pub fun result(mt: *Match, s: Slot) opt[id.Value] {
    if (s.node::u32 >= mt.count) { ret opt[id.Value].none{}; }
    val d: *InstructionData = instruction(mt, s.node);
    if (s.index::usize >= d.results.len) { ret opt[id.Value].none{}; }
    ret opt[id.Value].some{d.results.data[s.index]};
}

# whether the instruction a node matched carries the count-bounded mark, which
# says its shift count is below the operand's width
pub fun bounded(mt: *Match, node: u8) bool {
    if (node::u32 >= mt.count) { ret false; }
    ret instruction(mt, node).metadata.flags.bounded;
}

# the constant a value is, none for any other value
pub fun constant(mt: *Match, v: id.Value) res[opt[ConstantData], Refusal] {
    val d: *ValueData = value(mt, v);
    if (!(sel d.def.constant)) { ret res[opt[ConstantData], Refusal].ok{opt[ConstantData].none{}}; }
    val c: res[ConstantData, module.Error] = module.constant_data(mt.module, d.def.constant);
    if (sel c.err) { ret res[opt[ConstantData], Refusal].err{Refusal.module{c.err}}; }
    ret res[opt[ConstantData], Refusal].ok{opt[ConstantData].some{c.ok}};
}

# the bits of a number of at most 64 bits, an integer's sign extended from
# its width and a float's as they are, none for any other value
pub fun bits(mt: *Match, v: id.Value) res[opt[i64], Refusal] {
    val got: res[opt[ConstantData], Refusal] = constant(mt, v);
    if (sel got.err)     { ret res[opt[i64], Refusal].err{got.err}; }
    if (sel got.ok.none) { ret res[opt[i64], Refusal].ok{opt[i64].none{}}; }
    val c:     ConstantData = got.ok.some;
    var ty:    Type;
    var words: Slice[u64];
    if (sel c.integer) {
        ty    = c.integer.type;
        words = c.integer.words;
    }
    or (sel c.float) {
        ty    = c.float.type;
        words = c.float.words;
    }
    or (sel c.zero) { ty = c.zero; }
    or              { ret res[opt[i64], Refusal].ok{opt[i64].none{}}; }
    val shape: res[types.Shape, types.Error] = types.shape(?mt.module.types, ty);
    if (sel shape.err) { ret res[opt[i64], Refusal].err{Refusal.types{shape.err}}; }
    val scalar: bool = sel shape.ok.integer || sel shape.ok.float || sel shape.ok.pointer;
    if (sel c.zero && scalar) { ret res[opt[i64], Refusal].ok{opt[i64].some{0}}; }
    var width:  u32  = 0;
    var signed: bool = false;
    if (sel shape.ok.integer) {
        width  = shape.ok.integer.width;
        signed = true;
    }
    or (sel shape.ok.float) {
        val f: opt[types.Row] = types.row(shape.ok.float.format);
        if (sel f.none) { ret res[opt[i64], Refusal].err{Refusal.types{types.Error.format{shape.ok.float.format}}}; }
        width = f.some.width;
    }
    or              { ret res[opt[i64], Refusal].ok{opt[i64].none{}}; }
    if (width > 64) { ret res[opt[i64], Refusal].ok{opt[i64].none{}}; }
    var x: u64 = 0;
    if (words.size > 0) { x = words.data[0]; }
    if (width < 64) {
        val mask: u64 = (1u64 << width::u64) - 1;
        x = x & mask;
        if (signed && ((x >> (width - 1)::u64) & 1) != 0) { x = x | ~mask; }
    }
    ret res[opt[i64], Refusal].ok{opt[i64].some{x:~i64}};
}

# the shape of the type of a value
pub fun shape(mt: *Match, v: id.Value) res[types.Shape, types.Error] {
    ret types.shape(?mt.module.types, value(mt, v).type);
}
