# the rule schema a target's selection table fills in
#
# a target supplies one table and nothing else. a rule is an ir pattern, a
# guard, a machine expansion and a cost. of the rules for one opcode whose
# guard holds, the one of least cost is chosen, and of rules of one cost the
# first in table order. typing and effect facts are read from the ir opcode
# rows and from masc's rows, never restated in a rule: an immediate's range is
# its row position's, and the extensions a rule needs are its rows'
# requirements, which the target's selection admits or not.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mirl.ir.function.Body;
use mirl.ir.id;
use mirl.ir.module.Module;
use ir: mirl.ir.opcode;
use mirl.ir.opcode.rule.Class;
use mclass: mirl.machine.class;
use mirl.machine.class.Memory;
use mirl.machine.class.Policy;
use mirl.machine.class.Spill;
use mi: mirl.machine.instruction;
use mirl.machine.vstate;
use mirl.target.capability.Condition;
use mirl.target.record.Target;

use rf: masc.core.register;
use mink.model.reloc;

# the most nodes a pattern has and temporaries an expansion makes
pub val MAX_NODES: u32 = 8;
pub val MAX_FRESH: u32 = 8;

# an ir instruction a pattern covers
#
# node 0 is the root, the instruction selected. every other node covers the
# value one operand of an earlier node reads, an instruction of the same block
# whose result is that value. a covered instruction whose results the pattern
# alone uses emits nothing of its own. one that is used elsewhere as well is
# selected again for those uses, so only an instruction that neither traps nor
# touches memory may be covered that way.
# ---
# opcode:    the ir opcode it is an instance of
# parent:    the node whose operand it covers, below its own index, ignored
#            for the root
# operand:   the operand of the parent it covers
# result:    which of its results the parent reads
# constants: one bit per operand that must be a constant, operand 0 lowest
pub rec Node {
    opcode:    ir.Opcode;
    parent:    u8;
    operand:   u8;
    result:    u8;
    constants: u32;
}

# nodes as a pointer to static nodes and a count
pub rec Nodes {
    at:  *Node;
    len: u32;
}

# a position of a node
# ---
# node:  the node, 0 for the root
# index: the operand or result
pub rec Slot {
    node:  u8;
    index: u8;
}

# a value a guard or an expansion names
#
# a commutative node, by the shared algebra table, matches its two operands
# either way round, and a reference names an operand as the pattern states it.
# ---
# operand:  an operand of a node
# result:   a result of a node
# constant: the constant a materialisation rule builds
pub tag Ref: u8 {
    unstated;
    operand: Slot;
    result:  Slot;
    constant;
}

# the width a tested integer or pointer has against the target's general register
# ---
# any:      any width its class admits
# register: as wide as the register, so one rule serves every register width
# part:     a part of the register, which is this many times as wide, as a
#           32-bit word of a 64-bit register
# whole:    this many registers wide, as a pair holds a value
pub tag Width: u8 {
    any;
    register;
    part:  u8;
    whole: u8;
}

# a type test of a guard
# ---
# at:    the value whose type is tested
# class: the class its type must be in, in the ir's typing vocabulary
# lanes: the lane type of a vector is tested, and any other type fails
# width: the width an integer or pointer type must have against the register,
#        any for a test of the class alone. any other type fails a test of a
#        width
pub rec Test {
    at:    Ref;
    class: Class;
    lanes: bool;
    width: Width;
}

# tests as a pointer to static tests and a count
pub rec Tests {
    at:  *Test;
    len: u32;
}

# what a guard hook is given: the instructions a rule matched
# ---
# module:   the module
# body:     the body of the function, which the instructions are of
# function: the function selected
# target:   the target, whose declared capabilities a hook reads
# nodes:    the ir instruction each node matched, in node order
# count:    how many nodes matched, 0 for a materialisation rule
# swapped:  one bit per node whose two operands matched the other way round
# subject:  the constant a materialisation rule builds
pub rec Match {
    module:   *Module;
    body:     *Body;
    function: id.Function;
    target:   *Target;
    nodes:    [MAX_NODES]id.Instruction;
    count:    u32;
    swapped:  u32;
    subject:  id.Value;
}

# a guard's computation, for what the tests cannot state
pub def Hook: fun(*Match) bool;

# an immediate computed from a constant, such as the upper bits a pair of
# instructions splits a wide constant into
pub def Derive: fun(i64) i64;

# an immediate computed from a constant
# ---
# of:   the constant
# hook: the computation
pub rec Derived {
    of:   Ref;
    hook: Derive;
}

# a constant address as a symbol operand
# ---
# of:   the address constant
# kind: the relocation kind, a row of mink's relocation vocabulary
pub rec Symbolic {
    of:   Ref;
    kind: *reloc.Kind;
}

# a temporary register an expansion makes
# ---
# index: which temporary, below MAX_FRESH, the same index naming the same one
# like:  the value whose type gives its class
pub rec Fresh {
    index: u8;
    like:  Ref;
}

# a temporary register of a class of the target's register file
# ---
# index: which temporary, below MAX_FRESH, the same index naming the same one
#        as a temporary made by `Fresh`
# class: a class row of masc's register file for the target, by the handle masc publishes for it
pub rec Scratch {
    index: u8;
    class: *rf.Class;
}

# the address of an instruction an expansion emits, as the partner a low
# part's relocation names
# ---
# emit: the instruction, by its place in the expansion, before this one
# kind: the relocation kind, a row of mink's relocation vocabulary
pub rec Partnered {
    emit: u8;
    kind: *reloc.Kind;
}

# the immediate an operand takes for each ir ordering, a target's mapping of
# the ir's orderings onto its own forms, as the aq and rl bits of an amo
pub rec Forms {
    relaxed: i64;
    acquire: i64;
    release: i64;
    acq_rel: i64;
    seq_cst: i64;
}

# the immediate of an ordering under a mapping
pub fun form(f: *Forms, o: ir.Ordering) i64 {
    if (sel o.relaxed) { ret f.relaxed; }
    if (sel o.acquire) { ret f.acquire; }
    if (sel o.release) { ret f.release; }
    if (sel o.acq_rel) { ret f.acq_rel; }
    ret f.seq_cst;
}

# an immediate read through the ordering a node states: the join of every
# ordering immediate its ir row holds, as a compare and exchange's success and
# failure, mapped by the forms
# ---
# node:  the node, whose row holds at least one ordering immediate
# forms: the immediate of each ordering
pub rec Ordered {
    node:  u8;
    forms: *Forms;
}

# a register an instruction reads and writes, one location for both: the
# value of an operand read in it and a result of the root written back, as
# the value amocas compares memory with and gives the old value in
# ---
# result: the result of the root written
# value:  the operand of a node read
pub rec Tie {
    result: u8;
    value:  Slot;
}

# a register of the target's default convention row, by the bank of its
# kind and its place there, as the first argument register of a call
# ---
# kind:  the kind of register the bank holds, as masc's register file names it
# index: its place in the bank, 0 for the first
pub rec Passed {
    kind:  rf.Kind;
    index: u8;
}

# how far the index of a built address is scaled, as a power of two
# ---
# literal: by 1 << this
# derived: by 1 << what a hook computes from a constant, as the shift count
#          or the power of two of a multiplier the pattern covers
pub tag Factor: u8 {
    unstated;
    literal: u8;
    derived: Derived;
}

# a memory operand an expansion builds from the values of the pattern, as
# x86's [b + i*s + d], its parts each optional
# ---
# base:     the value whose register is the base, none for none
# fixed:    a register of masc's file that is the base in place of a value's,
#           as x86's string moves address through rdi and rsi
# index:    the value whose register is the index, none for none
# scale:    how far the index is scaled, a literal 0 for an address with none
# disp:     the constant whose bits are the displacement, none for 0
# symbol:   the address constant the displacement is the address of, none for
#           none, which takes the place of a constant displacement
# segment:  a segment register of masc's file the address is formed in, as
#           the thread pointer's fs, none for none
# relative: whether the address is formed from the instruction's own, as
#           x86-64's rip-relative address of a symbol
pub rec Addressed {
    base:     opt[Slot];
    fixed:    opt[rf.Id];
    index:    opt[Slot];
    scale:    Factor;
    disp:     opt[Ref];
    symbol:   opt[Symbolic];
    segment:  opt[rf.Id];
    relative: bool;
}

# where an emitted operand comes from
#
# a constant bound to an immediate stands only where its row position admits
# it, and a rule whose constant does not fit is passed over for the next. a
# register the calling convention names is read from the convention's row
# through `link`, `argument` and `returned`, never named as a fixed register,
# so the rule holds under any row the target states.
# ---
# value:    the register holding an operand of a node, a constant there
#           materialised by the table's constant rules
# result:   the register a result of the root is defined in
# bits:     a constant's bits, sign extended from its width, as an immediate
# derived:  an immediate computed from a constant
# symbol:   an address constant as a symbol
# literal:  a fixed immediate, enumerant or condition
# fresh:    a temporary register
# scratch:  a temporary register of a named class, for a value no operand of
#           the pattern has the type of
# fixed:    a register masc's file names, such as a hardwired zero or the
#           thread pointer, never one the convention names
# link:     the register a call leaves its return address in, the
#           convention's
# argument: an argument register of the convention
# returned: a result register of the convention
# target:   the machine block an edge of the root leads to
# slot:     the frame slot the root, an alloca, asks for
# partner:  the address of an earlier instruction of the expansion
# lookup:   the runtime function the target's general dynamic thread-local
#           access calls, as a symbol of this relocation kind
# width:    the bits of a value's integer type, as an immediate, such as the
#           width of the field a loop on a narrow value works on
# register: the bits of the target's general register, as an immediate
# ordered:  an immediate the ordering of a node maps to
# tied:     a register read and written, an operand's value in and a result out
# address:  a memory operand built from values of the pattern
# count:    an immediate computed from how many edges of the root follow its
#           first, as the bound a jump table's index is tested against
# table:    the address of the jump table the expansion emits, as the partner
#           of this relocation kind it is laid out at
#
# a jump table is the pseudo `table`, emitted by an expansion with no sources:
# it takes the blocks of the root's edges after the first as its operands, in
# order, so the root's first edge is where a bounds check sends an index
# outside it. only a rule whose guard holds the root's cases to be 0 to their
# count less one emits one, since entry k is the target of case k
pub tag Source: u8 {
    unstated;
    value:   Slot;
    result:  u8;
    bits:    Ref;
    derived: Derived;
    symbol:  Symbolic;
    literal: i64;
    fresh:   Fresh;
    scratch: Scratch;
    fixed:   rf.Id;
    link;
    argument: Passed;
    returned: Passed;
    target:   u8;
    slot;
    partner: Partnered;
    lookup:  *reloc.Kind;
    width:   Ref;
    register;
    ordered: Ordered;
    tied:    Tie;
    address: Addressed;
    count:   Derive;
    table:   *reloc.Kind;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

# a register an emitted instruction reads or writes beyond its operands and
# row, as the call of a runtime function reads its argument register
# ---
# register: the register, a fixed one or one the convention names, as a
#           source of those kinds names it
# write:    it is written, read otherwise
pub rec Implied {
    register: Source;
    write:    bool;
}

# implied registers as a pointer to static ones and a count
pub rec Implieds {
    at:  *Implied;
    len: u32;
}

# the implied registers of an instruction that states none
pub val NO_IMPLIED: Implieds = Implieds{at: nil, len: 0};

# what a call an expansion makes calls, which picks the registers it leaves
# undefined
# ---
# function:   a function under the convention row of the call it lowers, or
#             under the default row for a call no ir call stands for, which
#             leaves that row's clobbered registers undefined
# descriptor: the resolver of a thread-local descriptor, which leaves the
#             registers the row states for it undefined and keeps every other
pub tag Callee: u8 {
    function;
    descriptor;
}

# one machine instruction of an expansion
# ---
# opcode:   a row of masc's catalog for the target, or a pseudo
# operands: one source per operand position, in order
# implied:  the registers it reads and writes beyond them, reads first
# state:    the configuration state its register groups run under, as a
#           vector instruction's element width and grouping, none for an
#           instruction whose groups turn on none. the configure stage establishes it
# callee:   what it calls, read only where it is a call
pub rec Emit {
    opcode:   mi.Opcode;
    operands: Sources;
    implied:  Implieds;
    state:    opt[vstate.State];
    callee:   Callee;
}

# an expansion as a pointer to static instructions and a count
pub rec Emits {
    at:  *Emit;
    len: u32;
}

# one rule
# ---
# nodes:     the pattern, its root first, none for a materialisation rule
# tests:     the type tests of its guard
# orderings: the orderings of its root it is chosen for, read as an ordered
#            source reads them, nil when it takes any or its root states none
# hook:      the computation of its guard, nil when the tests are the guard
# expansion: the machine instructions it emits, in order
# cost:      what the expansion costs in the target's own measure, the same
#            measure across its table, lower chosen first
pub rec Rule {
    nodes:     Nodes;
    tests:     Tests;
    orderings: *ir.Orderings;
    hook:      Hook;
    expansion: Emits;
    cost:      u32;
}

# rules as a pointer to static rules and a count
pub rec Rules {
    at:  *Rule;
    len: u32;
}

# a register class of the target
# ---
# hardware: a class row of masc's register file for the target, by the handle masc publishes for it
# memory:   a memory-backed class
pub tag Holder: u8 {
    hardware: *rf.Class;
    memory:   *Memory;
}

# which class holds a value of a type, under a condition of the build
#
# the class is the type's default. a type class may have several rows, each
# under its own condition, and every build meets exactly one row admitting
# each type it reaches, as a format held in float registers under one
# extension and in the general registers under another that conflicts with
# it. choosing another class is for the rules
# or the register allocator, never for the order of rows.
# ---
# class:    the types it holds, in the ir's typing vocabulary
# holder:   the class
# requires: what the build must meet for the row to hold, always for every build
# policy:   what the allocator may do with a value of the class, as an i1 held
#           in a flags class never spills and is remade by its producer. every
#           row of one class states one policy
pub rec Hold {
    class:    Class;
    holder:   Holder;
    requires: Condition;
    policy:   Policy;
}

# holds as a pointer to static holds and a count
pub rec Holds {
    at:  *Hold;
    len: u32;
}

# a target's selection table
# ---
# rules:     the rules for ir instructions, this order breaking a tie of cost
# constants: the rules that materialise a constant into a register, chosen
#            as `rules` are, whose result 0 is the register
# holds:     which class holds a value of each type, every type the target
#            reaches admitted by exactly one row the build meets, so no
#            order chooses
# jump:      an unconditional jump to edge 0's block, which ends the block an
#            edge's copies are given when they cannot precede its branch
pub rec Table {
    rules:     Rules;
    constants: Rules;
    holds:     Holds;
    jump:      Emits;
}

# the class a holder names in `file`, none for a hardware class of no row of it
pub fun holder_class(file: *rf.File, h: Holder) opt[mclass.Class] {
    if (sel h.hardware) { ret mclass.handled(file, h.hardware); }
    ret opt[mclass.Class].some{mclass.Class.memory{h.memory}};
}

# whether the holds give a class a policy that never spills its values
pub fun never_spilled(holds: Holds, file: *rf.File, c: mclass.Class) bool {
    var i: u32 = 0;
    for (i < holds.len) {
        val h:     *Hold = ?holds.at[i];
        val spill: Spill = h.policy.spill;
        if (sel spill.never) {
            val k: opt[mclass.Class] = holder_class(file, h.holder);
            if (sel k.some) {
                if (mclass.same(k.some, c)) { ret true; }
            }
        }
        i = i + 1;
    }
    ret false;
}
