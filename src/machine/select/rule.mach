# the rule schema a target's selection table fills in
#
# a target supplies one table and nothing else. a rule is an ir pattern, a
# guard, a machine expansion and a cost. of the rules for one opcode whose
# guard holds, the one of least cost is chosen, and of rules of one cost the
# first in table order. typing and effect facts are read from the ir opcode
# rows and from masc's rows, never restated in a rule: an immediate's range is
# its row position's, and the extensions a rule needs are its rows'
# requirements, which the target's selection admits or not.

use std.types.bool.bool;

use mirl.ir.function.Body;
use mirl.ir.id;
use mirl.ir.module.Module;
use ir: mirl.ir.opcode;
use mirl.ir.opcode.rule.Class;
use mirl.machine.class.Memory;
use mi: mirl.machine.instruction;
use mirl.target.record.Target;

use rf: masc.core.register;
use mink.model.reloc;

# the most nodes a pattern has and temporaries an expansion makes
pub val MAX_NODES: u32 = 8;
pub val MAX_FRESH: u32 = 8;

# an ir instruction a pattern covers
#
# node 0 is the root, the instruction selected. every other node covers the
# value one operand of an earlier node reads, an instruction of the same block
# whose result is that value. a covered instruction whose results the pattern
# alone uses emits nothing of its own. one that is used elsewhere as well is
# selected again for those uses, so only an instruction that neither traps nor
# touches memory may be covered that way.
# ---
# opcode:    the ir opcode it is an instance of
# parent:    the node whose operand it covers, below its own index, ignored
#            for the root
# operand:   the operand of the parent it covers
# result:    which of its results the parent reads
# constants: one bit per operand that must be a constant, operand 0 lowest
pub rec Node {
    opcode:    ir.Opcode;
    parent:    u8;
    operand:   u8;
    result:    u8;
    constants: u32;
}

# nodes as a pointer to static nodes and a count
pub rec Nodes {
    at:  *Node;
    len: u32;
}

# a position of a node
# ---
# node:  the node, 0 for the root
# index: the operand or result
pub rec Slot {
    node:  u8;
    index: u8;
}

# a value a guard or an expansion names
#
# a commutative node, by the shared algebra table, matches its two operands
# either way round, and a reference names an operand as the pattern states it.
# ---
# operand:  an operand of a node
# result:   a result of a node
# constant: the constant a materialisation rule builds
pub tag Ref: u8 {
    unstated;
    operand: Slot;
    result:  Slot;
    constant;
}

# a type test of a guard
# ---
# at:    the value whose type is tested
# class: the class its type must be in, in the ir's typing vocabulary
# lanes: the lane type of a vector is tested, and any other type fails
pub rec Test {
    at:    Ref;
    class: Class;
    lanes: bool;
}

# tests as a pointer to static tests and a count
pub rec Tests {
    at:  *Test;
    len: u32;
}

# what a guard hook is given: the instructions a rule matched
# ---
# module:   the module
# body:     the body of the function, which the instructions are of
# function: the function selected
# target:   the target, whose declared capabilities a hook reads
# nodes:    the ir instruction each node matched, in node order
# count:    how many nodes matched, 0 for a materialisation rule
# swapped:  one bit per node whose two operands matched the other way round
# subject:  the constant a materialisation rule builds
pub rec Match {
    module:   *Module;
    body:     *Body;
    function: id.Function;
    target:   *Target;
    nodes:    [MAX_NODES]id.Instruction;
    count:    u32;
    swapped:  u32;
    subject:  id.Value;
}

# a guard's computation, for what the tests cannot state
pub def Hook: fun(*Match) bool;

# an immediate computed from a constant, such as the upper bits a pair of
# instructions splits a wide constant into
pub def Derive: fun(i64) i64;

# an immediate computed from a constant
# ---
# of:   the constant
# hook: the computation
pub rec Derived {
    of:   Ref;
    hook: Derive;
}

# a constant address as a symbol operand
# ---
# of:   the address constant
# kind: the relocation kind, a row of mink's relocation vocabulary
pub rec Symbolic {
    of:   Ref;
    kind: *reloc.Kind;
}

# a temporary register an expansion makes
# ---
# index: which temporary, below MAX_FRESH, the same index naming the same one
# like:  the value whose type gives its class
pub rec Fresh {
    index: u8;
    like:  Ref;
}

# a temporary register of a class of the target's register file
# ---
# index: which temporary, below MAX_FRESH, the same index naming the same one
#        as a temporary made by `Fresh`
# class: a class row of masc's register file for the target, by the handle masc publishes for it
pub rec Scratch {
    index: u8;
    class: *rf.Class;
}

# the address of an instruction an expansion emits, as the partner a low
# part's relocation names
# ---
# emit: the instruction, by its place in the expansion, before this one
# kind: the relocation kind, a row of mink's relocation vocabulary
pub rec Partnered {
    emit: u8;
    kind: *reloc.Kind;
}

# where an emitted operand comes from
#
# a constant bound to an immediate stands only where its row position admits
# it, and a rule whose constant does not fit is passed over for the next.
# ---
# value:   the register holding an operand of a node, a constant there
#          materialised by the table's constant rules
# result:  the register a result of the root is defined in
# bits:    a constant's bits, sign extended from its width, as an immediate
# derived: an immediate computed from a constant
# symbol:  an address constant as a symbol
# literal: a fixed immediate, enumerant or condition
# fresh:   a temporary register
# scratch: a temporary register of a named class, for a value no operand of
#          the pattern has the type of
# fixed:   a register masc's file names, such as a hardwired zero
# target:  the machine block an edge of the root leads to
# slot:    the frame slot the root, an alloca, asks for
# partner: the address of an earlier instruction of the expansion
# lookup:  the runtime function the target's general dynamic thread-local
#          access calls, as a symbol of this relocation kind
pub tag Source: u8 {
    unstated;
    value:   Slot;
    result:  u8;
    bits:    Ref;
    derived: Derived;
    symbol:  Symbolic;
    literal: i64;
    fresh:   Fresh;
    scratch: Scratch;
    fixed:   rf.Id;
    target:  u8;
    slot;
    partner: Partnered;
    lookup:  *reloc.Kind;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

# a register an emitted instruction reads or writes beyond its operands and
# row, as the call of a runtime function reads its argument register
# ---
# register: a register masc's file names
# write:    it is written, read otherwise
pub rec Implied {
    register: rf.Id;
    write:    bool;
}

# implied registers as a pointer to static ones and a count
pub rec Implieds {
    at:  *Implied;
    len: u32;
}

# the implied registers of an instruction that states none
pub val NO_IMPLIED: Implieds = Implieds{at: nil, len: 0};

# one machine instruction of an expansion
# ---
# opcode:   a row of masc's catalog for the target, or a pseudo
# operands: one source per operand position, in order
# implied:  the registers it reads and writes beyond them, reads first
pub rec Emit {
    opcode:   mi.Opcode;
    operands: Sources;
    implied:  Implieds;
}

# an expansion as a pointer to static instructions and a count
pub rec Emits {
    at:  *Emit;
    len: u32;
}

# one rule
# ---
# nodes:     the pattern, its root first, none for a materialisation rule
# tests:     the type tests of its guard
# hook:      the computation of its guard, nil when the tests are the guard
# expansion: the machine instructions it emits, in order
# cost:      what the expansion costs in the target's own measure, the same
#            measure across its table, lower chosen first
pub rec Rule {
    nodes:     Nodes;
    tests:     Tests;
    hook:      Hook;
    expansion: Emits;
    cost:      u32;
}

# rules as a pointer to static rules and a count
pub rec Rules {
    at:  *Rule;
    len: u32;
}

# a register class of the target
# ---
# hardware: a class row of masc's register file for the target, by the handle masc publishes for it
# memory:   a memory-backed class
pub tag Holder: u8 {
    hardware: *rf.Class;
    memory:   *Memory;
}

# which class holds a value of a type
#
# the class is the type's default. choosing another is for the rules or the
# register allocator, never for the order of rows.
# ---
# class:  the types it holds, in the ir's typing vocabulary
# holder: the class
pub rec Hold {
    class:  Class;
    holder: Holder;
}

# holds as a pointer to static holds and a count
pub rec Holds {
    at:  *Hold;
    len: u32;
}

# a target's selection table
# ---
# rules:     the rules for ir instructions, this order breaking a tie of cost
# constants: the rules that materialise a constant into a register, chosen
#            as `rules` are, whose result 0 is the register
# holds:     which class holds a value of each type, every type the target
#            reaches admitted by exactly one row, so no order chooses
# jump:      an unconditional jump to edge 0's block, which ends the block an
#            edge's copies are given when they cannot precede its branch
pub rec Table {
    rules:     Rules;
    constants: Rules;
    holds:     Holds;
    jump:      Emits;
}
