# emission of the laid out machine form into masc, which encodes it into a
# mink object, see doc/machine/emit.md
#
# this is the last stage of a register machine. `emit` takes the module's
# functions, laid out, and the target, and hands back mink's object in memory.
# a consumer of the library calls `mirl.machine.compile`, which ends in it.
# masc's listing of the result is for debugging.

#[testing]
use mirl.machine.emit.emit_test;

fwd mirl.machine.emit.fixup;
fwd mirl.machine.emit.handover;
fwd mirl.machine.emit.handover.Unit;
fwd mirl.machine.emit.handover.Reason;
fwd mirl.machine.emit.handover.Refused;
fwd mirl.machine.emit.handover.Error;
fwd mirl.machine.emit.handover.NO_OPERAND;
fwd mirl.machine.emit.handover.emit;
