# the stack frame of a register machine function, see doc/machine/frame.md
#
# the frame reads every fact from the target's convention row, its stack
# alignment at a call, red zone, shadow space, return address, frame pointer
# and record, its preserved and reserved registers, and from masc's rows, the
# stack pointer, each register's storage and each instruction's transfer and
# writes. it lays out the slots, saves the preserved registers the function
# writes, writes the prologue and epilogues through the target's frame code
# and states the call frame rules as data for masc's cfi calls.

#[testing]
use mirl.machine.frame.frame_test;

use std.allocator;
use std.collections.slice.Slice;
use std.types.result.res;

use mirl.machine.alloc.allocate.Allocation;

fwd mirl.machine.frame.record;
fwd mirl.machine.frame.record.Offset;
fwd mirl.machine.frame.record.Base;
fwd mirl.machine.frame.record.Address;
fwd mirl.machine.frame.record.Place;
fwd mirl.machine.frame.record.Save;
fwd mirl.machine.frame.record.Cfa;
fwd mirl.machine.frame.record.Saved;
fwd mirl.machine.frame.record.Rule;
fwd mirl.machine.frame.record.Fact;
fwd mirl.machine.frame.record.Layout;
fwd mirl.machine.frame.record.Framed;
fwd mirl.machine.frame.record.release;
fwd mirl.machine.frame.code;
fwd mirl.machine.frame.code.Code;
fwd mirl.machine.frame.code.Emit;
fwd mirl.machine.frame.code.Refusal;
fwd mirl.machine.frame.lay;
fwd mirl.machine.frame.lay.Request;
fwd mirl.machine.frame.lay.Plan;
fwd mirl.machine.frame.lay.keeps_pointer;
fwd mirl.machine.frame.finish;
fwd mirl.machine.frame.finish.Error;

# frame an allocated function
# ---
# a:    the allocator the framed function takes
# x:    the allocation, its function unchanged whatever the outcome
# r:    the convention and locations
# code: the target's frame code
# ret:  the framed function, or why it was refused
pub fun frame(a: *allocator.Allocator, x: *Allocation, r: Request, code: *Code) res[Framed, finish.Error] {
    val laid: res[Plan, lay.Error] = lay.lay(a, ?x.function, Slice[u32]{data: x.used.data, size: x.used.len}, r);
    if (sel laid.err) { ret res[Framed, finish.Error].err{finish.Error.lay{laid.err}}; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    ret finish.finish(a, ?x.function, ?p, code);
}
