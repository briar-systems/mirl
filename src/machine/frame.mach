# the stack frame of a register machine function, see doc/machine/frame.md
#
# the frame reads every fact from the target's convention row, its stack
# alignment at a call, red zone, shadow space, return address, frame pointer
# and record, its preserved and reserved registers, and from masc's rows, the
# stack pointer, each register's storage and each instruction's transfer and
# writes. it lays out the slots, saves the preserved registers the function
# writes, writes the prologue and epilogues through the target's frame code
# in the shape the convention row's prologue states, and states the call
# frame rules as mink's frame records, which masc's cfi calls take.

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use mirl.machine.alloc.allocate.Allocation;
use mirl.machine.frame.code.Admitted;
use mirl.machine.frame.finish;
use mirl.machine.frame.lay;
use mirl.machine.frame.lay.Bank;
use mirl.machine.frame.lay.Plan;
use mirl.machine.frame.lay.Request;
use mirl.machine.frame.record.Framed;
use mirl.machine.frame.scan.Facts;
use mirl.machine.frame.scavenge;
use mirl.machine.operand.Slot;

# frame an allocated function, laid out again with the emergency slots its
# moves could need, of each kind, until it holds as many as it needs
# ---
# a:    the allocator the framed function takes
# x:    the allocation, its function unchanged on a refusal, and left no
#       operand storage once framed
# from: the facts of the function it was allocated from, as lay.facts reads
#       them
# r:    the convention and locations
# code: the target's frame code bound to the build's selection
# n:    what counting the emergency slots reads beside the frame
# ret:  the framed function, or why it was refused
pub fun frame(a: *allocator.Allocator, x: *Allocation, from: *Facts, r: Request, code: *Admitted, n: scavenge.Need) res[Framed, finish.Error] {
    val origins: Slice[u32]          = Slice[u32]{data: x.origins.data, size: x.origins.len};
    val spills:  Slice[Slot]         = Slice[Slot]{data: x.spills.data, size: x.spills.len};
    val used:    Slice[u32]          = Slice[u32]{data: x.used.data, size: x.used.len};
    var reserve: vector.Vector[Bank] = vector.init[Bank](a);
    var need:    vector.Vector[Bank] = vector.init[Bank](a);
    var after:   scavenge.After      = scavenge.after();
    fin {
        vector.dnit[Bank](?reserve);
        vector.dnit[Bank](?need);
        scavenge.drop_after(?after);
    }
    val laid: res[Plan, lay.Error] = lay.lay(a, ?x.function, from, origins, spills, used, r, Slice[Bank]{data: reserve.data, size: reserve.len});
    if (sel laid.err) { ret res[Framed, finish.Error].err{finish.Error.lay{laid.err}}; }
    var p:    Plan = laid.ok;
    var more: bool = true;
    for (more) {
        val counted: err[scavenge.Error] = scavenge.needed(a, ?x.function, ?p, code, r, n, ?after, ?need);
        if (sel counted.err) {
            lay.release(?p);
            ret res[Framed, finish.Error].err{finish.Error.scavenge{counted.err}};
        }
        val grew: res[bool, scavenge.Error] = scavenge.merge(?reserve, Slice[Bank]{data: need.data, size: need.len}, r.at.file);
        if (sel grew.err) {
            lay.release(?p);
            ret res[Framed, finish.Error].err{finish.Error.scavenge{grew.err}};
        }
        more = grew.ok;
        if (more) {
            lay.release(?p);
            val again: res[Plan, lay.Error] = lay.lay(a, ?x.function, from, origins, spills, used, r, Slice[Bank]{data: reserve.data, size: reserve.len});
            if (sel again.err) { ret res[Framed, finish.Error].err{finish.Error.lay{again.err}}; }
            p = again.ok;
        }
    }
    fin { lay.release(?p); }
    ret finish.finish(a, ?x.function, ?p, code);
}
