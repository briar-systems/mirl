# a target's loop: a pseudo-instruction stated as data, expanded into the
# rows of masc's catalog once allocation has placed its operands
#
# an operation no instruction does on its own, and no straight-line
# expansion can do, as a read-modify-write made of a load-reserved and
# store-conditional pair, is selected to a loop that names its operands and
# scratch registers. its steps come in three parts: the ones before its body,
# the body, which branches back to its own start, and the ones after it. the
# expansion places the body in a block of its own, so no spill, reload or
# other instruction lands inside it, and its jump ends the block before the
# body and the body. a part is a list of step lists, so loops share the
# steps they have in common, and a loop takes parameters, immediates its
# steps' formulas read, so one loop serves every width of a narrow field.
#
# a loop writes before it has finished reading, since its body runs again
# after it writes, so a location it writes is none it reads. an implicit
# register or flag a step reads is one an earlier step writes, so the loop
# reads nothing implicitly that is live into it, and only its implicit
# writes are seen outside it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use masc.core.effect;
use mo:   masc.core.operand;
use rf:   masc.core.register;
use rows: masc.core.row;

# one parameter of a loop scaled
# ---
# parameter: the loop's operand position the parameter stands at
# scale:     what it is multiplied by
pub rec Term {
    parameter: u8;
    scale:     i64;
}

# an immediate computed from a loop's parameters: its two terms summed and
# the offset added, as the shift that takes a field of the parameter width to
# the top of a register of the parameter register width
# ---
# terms:  the scaled parameters, a scale of 0 leaving one out
# offset: the constant added
pub rec Formula {
    terms:  [2]Term;
    offset: i64;
}

# where an operand of a step comes from
# ---
# operand: the loop's operand at this position, a register
# literal: a fixed immediate, enumerant or condition
# formula: an immediate computed from the loop's parameters
# fixed:   a register masc's file names, such as a hardwired zero
# head:    the body, which a branch back to its start runs again
# exit:    the block after the body, which a branch out of it leaves to
# target:  the block the loop's jump goes to, in the jump alone
pub tag Source: u8 {
    operand: u8;
    literal: i64;
    formula: Formula;
    fixed:   rf.Id;
    head;
    exit;
    target;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

# one instruction of a loop
# ---
# row:      a row of masc's catalog for the target, by the handle masc publishes for it
# operands: one source per operand position of the row, in order
pub rec Step {
    row:      *rows.Row;
    operands: Sources;
}

# steps as a pointer to static steps and a count
pub rec Steps {
    at:  *Step;
    len: u32;
}

# the step lists a part of a loop runs in order, so loops share the lists
# they have in common, such as the steps that find a narrow field in its word
pub rec Parts {
    at:  *Steps;
    len: u32;
}

# the roles of a loop's operand positions as a pointer to static roles and a count
pub rec Roles {
    at:  *mo.Role;
    len: u32;
}

# one loop
#
# a loop with no body is a straight sequence of steps, expanded in place, for
# an operation that one instruction does once its operands are prepared, such
# as one on a narrow field that shares the steps of the loops on it.
# ---
# name:   the spelling the text form prints, unique among the target's loops
# roles:  each operand position's role: a register the loop reads, one it
#         writes, never both, or none for a parameter, an immediate that
#         formulas read, such as the width of a field
# before: the steps before the body, which end the block the loop stands in
# body:   the steps of the body, a block of their own that branches back to
#         its start, none for a straight sequence
# after:  the steps after the body, which open the block after it
# jump:   an unconditional jump, its target the block it goes to, which ends
#         the block before the body and the body, unused with no body
pub rec Loop {
    name:   str;
    roles:  Roles;
    before: Parts;
    body:   Parts;
    after:  Parts;
    jump:   Step;
}

# loops as a pointer to static loop pointers and a count
pub rec Loops {
    at:  **Loop;
    len: u32;
}

# the loops of a set that states none
pub val NONE: Loops = Loops{at: nil, len: 0};

# a part with no step
pub val NO_PARTS: Parts = Parts{at: nil, len: 0};

pub val ROLE:      str = "position that both reads and writes";
pub val PARAMETER: str = "formula naming a position that is no parameter, or an operand source naming a parameter";
pub val OPERAND:   str = "source naming an operand past the loop's positions";
pub val ARITY:     str = "step with another count of sources than its row has positions";
pub val JUMP:      str = "jump that names its target other than once, or names the body or the block after it";
pub val TARGET:    str = "step other than the jump naming the jump's target";
pub val BACK:      str = "body with no step naming its start";
pub val STRAIGHT:  str = "loop with no body naming the body or the block after it";
pub val IMPLICIT:  str = "step reading an implicit register or flag no earlier step writes";

# how many steps a part has
pub fun steps_in(p: Parts) u32 {
    var n: u32 = 0;
    var k: u32 = 0;
    for (k < p.len) {
        n = n + p.at[k].len;
        k = k + 1;
    }
    ret n;
}

# a part's k-th step, below `steps_in`
pub fun step_of(p: Parts, k: u32) *Step {
    var left: u32 = k;
    var at:   u32 = 0;
    for (at + 1 < p.len && left >= p.at[at].len) {
        left = left - p.at[at].len;
        at   = at + 1;
    }
    ret ?p.at[at].at[left];
}

# whether a loop has a body, which a straight sequence has not
pub fun loops(l: *Loop) bool {
    ret steps_in(l.body) > 0;
}

# how many steps a loop has, the jump counted once, and not at all with no body
pub fun count(l: *Loop) u32 {
    var n: u32 = steps_in(l.before) + steps_in(l.body) + steps_in(l.after);
    if (loops(l)) { n = n + 1; }
    ret n;
}

# a loop's step in program order: before, the jump, the body and after, with
# no jump when it has no body
pub fun step(l: *Loop, k: u32) *Step {
    val before: u32 = steps_in(l.before);
    if (k < before) { ret step_of(l.before, k); }
    var inside: u32 = k - before;
    if (loops(l)) {
        if (inside == 0) { ret ?l.jump; }
        inside = inside - 1;
    }
    val body: u32 = steps_in(l.body);
    if (inside < body) { ret step_of(l.body, inside); }
    ret step_of(l.after, inside - body);
}

# the immediate a formula gives of the parameters its two terms name
# ---
# f:      the formula
# first:  the parameter its first term names
# second: the parameter its second term names
pub fun evaluate(f: Formula, first: i64, second: i64) i64 {
    ret f.terms[0].scale * first + f.terms[1].scale * second + f.offset;
}

fun has(s: effect.Set, bit: u32) bool {
    val w: u32 = bit / 64;
    if (w >= s.len) { ret false; }
    ret ((s.words[w] >> (bit % 64)::u64) & 1) != 0;
}

# whether a step before step `k` writes implicit register or flag `bit`
fun written_before(l: *Loop, k: u32, bit: u32, flag: bool) bool {
    var j: u32 = 0;
    for (j < k) {
        val e: *effect.Effect = step(l, j).row.effect;
        if (e != nil) {
            if (flag && (has(e.flags.written, bit) || has(e.flags.undefined, bit))) { ret true; }
            if (!flag && has(effect.must(e).written, bit))                          { ret true; }
        }
        j = j + 1;
    }
    ret false;
}

# whether every implicit register or flag of a set a step reads is written by an earlier one
fun read_after_write(l: *Loop, k: u32, s: effect.Set, flag: bool) bool {
    var w: u32 = 0;
    for (w < s.len) {
        var bits: u64 = s.words[w];
        var b:    u32 = 0;
        for (bits != 0) {
            if ((bits & 1) != 0 && !written_before(l, k, w * 64 + b, flag)) { ret false; }
            bits = bits >> 1;
            b    = b + 1;
        }
        w = w + 1;
    }
    ret true;
}

# whether a position of a loop is a parameter
fun parameter(l: *Loop, at: u8) bool {
    ret at::u32 < l.roles.len && l.roles.at[at] == mo.NONE;
}

# whether a step's sources stand where the loop puts it, an operand source
# naming a register position, a formula parameters, and the jump naming its
# target once
fun sources_ok(l: *Loop, s: *Step, jump: bool) opt[str] {
    if (s.operands.len != s.row.operands.len) { ret opt[str].some{ARITY}; }
    var targets: u32 = 0;
    var k:       u32 = 0;
    for (k < s.operands.len) {
        val src: Source = s.operands.at[k];
        if (sel src.operand && src.operand::u32 >= l.roles.len) { ret opt[str].some{OPERAND}; }
        if (sel src.operand && parameter(l, src.operand))       { ret opt[str].some{PARAMETER}; }
        if (sel src.formula) {
            if (!parameter(l, src.formula.terms[0].parameter) || !parameter(l, src.formula.terms[1].parameter)) { ret opt[str].some{PARAMETER}; }
        }
        if (sel src.target) {
            if (!jump) { ret opt[str].some{TARGET}; }
            targets = targets + 1;
        }
        if (jump && (sel src.head || sel src.exit))      { ret opt[str].some{JUMP}; }
        if (!loops(l) && (sel src.head || sel src.exit)) { ret opt[str].some{STRAIGHT}; }
        k = k + 1;
    }
    if (jump && targets != 1) { ret opt[str].some{JUMP}; }
    ret opt[str].none{};
}

# whether a loop keeps the schema
# ---
# l:   the loop
# ret: none, or what it breaks
pub fun check(l: *Loop) opt[str] {
    var i: u32 = 0;
    for (i < l.roles.len) {
        if (l.roles.at[i] == mo.READ_WRITE) { ret opt[str].some{ROLE}; }
        i = i + 1;
    }
    var back:  bool = false;
    val jump:  u32  = steps_in(l.before);
    val first: u32  = jump + 1;
    val body:  u32  = steps_in(l.body);
    var k:     u32  = 0;
    for (k < count(l)) {
        val s:   *Step    = step(l, k);
        val bad: opt[str] = sources_ok(l, s, loops(l) && k == jump);
        if (sel bad.some) { ret bad; }
        var j: u32 = 0;
        for (j < s.operands.len) {
            val src: Source = s.operands.at[j];
            if (sel src.head && k >= first && k < first + body) { back = true; }
            j = j + 1;
        }
        val e: *effect.Effect = s.row.effect;
        if (e != nil) {
            val clean: bool = read_after_write(l, k, effect.may(e).read, false) && read_after_write(l, k, e.flags.read, true) && read_after_write(l, k, e.flags.kept, true);
            if (!clean) { ret opt[str].some{IMPLICIT}; }
        }
        k = k + 1;
    }
    if (loops(l) && !back) { ret opt[str].some{BACK}; }
    ret opt[str].none{};
}
