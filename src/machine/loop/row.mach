# a target's loop: a pseudo-instruction stated as data, expanded into the
# rows of masc's catalog once allocation has placed its operands
#
# an operation no instruction does on its own, and no straight-line
# expansion can do, as a read-modify-write made of a load-reserved and
# store-conditional pair, is selected to a loop that names its operands and
# scratch registers. its steps come in three parts: the ones before its body,
# the body, which branches back to its own start, and the ones after it. the
# expansion places the body in a block of its own, so no spill, reload or
# other instruction lands inside it, and its jump ends the block before the
# body and the body.
#
# a loop writes before it has finished reading, since its body runs again
# after it writes, so a location it writes is none it reads. an implicit
# register or flag a step reads is one an earlier step writes, so the loop
# reads nothing implicitly that is live into it, and only its implicit
# writes are seen outside it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use masc.core.effect;
use mo:   masc.core.operand;
use rf:   masc.core.register;
use rows: masc.core.row;

# where an operand of a step comes from
# ---
# operand: the loop's operand at this position, a register
# literal: a fixed immediate, enumerant or condition
# fixed:   a register masc's file names, such as a hardwired zero
# head:    the body, which a branch back to its start runs again
# exit:    the block after the body, which a branch out of it leaves to
# target:  the block the loop's jump goes to, in the jump alone
pub tag Source: u8 {
    operand: u8;
    literal: i64;
    fixed:   rf.Id;
    head;
    exit;
    target;
}

# sources as a pointer to static sources and a count
pub rec Sources {
    at:  *Source;
    len: u32;
}

# one instruction of a loop
# ---
# row:      a row of masc's catalog for the target, by the handle masc publishes for it
# operands: one source per operand position of the row, in order
pub rec Step {
    row:      *rows.Row;
    operands: Sources;
}

# steps as a pointer to static steps and a count
pub rec Steps {
    at:  *Step;
    len: u32;
}

# the roles of a loop's operand positions as a pointer to static roles and a count
pub rec Roles {
    at:  *mo.Role;
    len: u32;
}

# one loop
# ---
# name:   the spelling the text form prints, unique among the target's loops
# roles:  each operand position's role, a register the loop reads or one it
#         writes, never both
# before: the steps before the body, which end the block the loop stands in
# body:   the steps of the body, a block of their own that branches back to
#         its start
# after:  the steps after the body, which open the block after it
# jump:   an unconditional jump, its target the block it goes to, which ends
#         the block before the body and the body
pub rec Loop {
    name:   str;
    roles:  Roles;
    before: Steps;
    body:   Steps;
    after:  Steps;
    jump:   Step;
}

# loops as a pointer to static loop pointers and a count
pub rec Loops {
    at:  **Loop;
    len: u32;
}

# the loops of a set that states none
pub val NONE: Loops = Loops{at: nil, len: 0};

pub val ROLE:     str = "position that neither reads nor writes, or does both";
pub val EMPTY:    str = "body with no step";
pub val OPERAND:  str = "source naming an operand past the loop's positions";
pub val ARITY:    str = "step with another count of sources than its row has positions";
pub val JUMP:     str = "jump that names its target other than once, or names the body or the block after it";
pub val TARGET:   str = "step other than the jump naming the jump's target";
pub val BACK:     str = "body with no step naming its start";
pub val IMPLICIT: str = "step reading an implicit register or flag no earlier step writes";

# how many steps a loop has, the jump counted once
pub fun count(l: *Loop) u32 {
    ret l.before.len + l.body.len + l.after.len + 1;
}

# a loop's step in program order: before, the jump, the body and after
pub fun step(l: *Loop, k: u32) *Step {
    if (k < l.before.len)  { ret ?l.before.at[k]; }
    if (k == l.before.len) { ret ?l.jump; }
    val inside: u32 = k - l.before.len - 1;
    if (inside < l.body.len) { ret ?l.body.at[inside]; }
    ret ?l.after.at[inside - l.body.len];
}

fun has(s: effect.Set, bit: u32) bool {
    val w: u32 = bit / 64;
    if (w >= s.len) { ret false; }
    ret ((s.words[w] >> (bit % 64)::u64) & 1) != 0;
}

# whether a step before step `k` writes implicit register or flag `bit`
fun written_before(l: *Loop, k: u32, bit: u32, flag: bool) bool {
    var j: u32 = 0;
    for (j < k) {
        val e: *effect.Effect = step(l, j).row.effect;
        if (e != nil) {
            if (flag && (has(e.flags.written, bit) || has(e.flags.undefined, bit))) { ret true; }
            if (!flag && has(effect.must(e).written, bit))                            { ret true; }
        }
        j = j + 1;
    }
    ret false;
}

# whether every implicit register or flag of a set a step reads is written by an earlier one
fun read_after_write(l: *Loop, k: u32, s: effect.Set, flag: bool) bool {
    var w: u32 = 0;
    for (w < s.len) {
        var bits: u64 = s.words[w];
        var b:    u32 = 0;
        for (bits != 0) {
            if ((bits & 1) != 0 && !written_before(l, k, w * 64 + b, flag)) { ret false; }
            bits = bits >> 1;
            b    = b + 1;
        }
        w = w + 1;
    }
    ret true;
}

# whether a step's sources stand where the loop puts it, the jump naming its target once
fun sources_ok(l: *Loop, s: *Step, jump: bool) opt[str] {
    if (s.operands.len != s.row.operands.len) { ret opt[str].some{ARITY}; }
    var targets: u32 = 0;
    var k:       u32 = 0;
    for (k < s.operands.len) {
        val src: Source = s.operands.at[k];
        if (sel src.operand && src.operand::u32 >= l.roles.len) { ret opt[str].some{OPERAND}; }
        if (sel src.target) {
            if (!jump) { ret opt[str].some{TARGET}; }
            targets = targets + 1;
        }
        if (jump && (sel src.head || sel src.exit)) { ret opt[str].some{JUMP}; }
        k = k + 1;
    }
    if (jump && targets != 1) { ret opt[str].some{JUMP}; }
    ret opt[str].none{};
}

# whether a loop keeps the schema
# ---
# l:   the loop
# ret: none, or what it breaks
pub fun check(l: *Loop) opt[str] {
    var i: u32 = 0;
    for (i < l.roles.len) {
        val r: mo.Role = l.roles.at[i];
        if (r != mo.READ && r != mo.WRITE) { ret opt[str].some{ROLE}; }
        i = i + 1;
    }
    if (l.body.len == 0) { ret opt[str].some{EMPTY}; }
    var back:  bool = false;
    val first: u32  = l.before.len + 1;
    var k:     u32  = 0;
    for (k < count(l)) {
        val s:   *Step    = step(l, k);
        val bad: opt[str] = sources_ok(l, s, k == l.before.len);
        if (sel bad.some) { ret bad; }
        var j: u32 = 0;
        for (j < s.operands.len) {
            val src: Source = s.operands.at[j];
            if (sel src.head && k >= first && k < first + l.body.len) { back = true; }
            j = j + 1;
        }
        val e: *effect.Effect = s.row.effect;
        if (e != nil) {
            val clean: bool = read_after_write(l, k, effect.may(e).read, false) && read_after_write(l, k, e.flags.read, true) && read_after_write(l, k, e.flags.kept, true);
            if (!clean) { ret opt[str].some{IMPLICIT}; }
        }
        k = k + 1;
    }
    if (!back) { ret opt[str].some{BACK}; }
    ret opt[str].none{};
}
