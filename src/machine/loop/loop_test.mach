#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a module, its target's machine and the locations of its registers
#[testing]
rec Fixture {
    a:    allocator.Allocator;
    m:    Module;
    mach: Machine;
    at:   Locations;
}

# open a fixture of ir text
#[testing]
fun open(x: *Fixture, text: View) i32 {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, text);
    if (sel made.err) { ret 1; }
    x.m = made.ok;
    val t: opt[*Target] = targets.by_name(x.m.target);
    if (sel t.none) { ret 2; }
    val opened: err[machine.Error] = machine.open(?x.mach, ?x.a, t.some);
    if (sel opened.err) { ret 3; }
    val got: res[Locations, location.Error] = location.init(?x.a, x.mach.registers.file, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 4; }
    x.at = got.ok;
    ret 0;
}

#[testing]
fun close(x: *Fixture) {
    location.dnit(?x.at);
    machine.close(?x.mach);
    module.dnit(?x.m);
}

# print a function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, f: Function) {
    var items: [1]item.Item;
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print(?out, m, Slice[item.Item]{data: ?items[0], size: 1});
}

#[testing]
val MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# a nand and a compare and exchange of a word and of a doubleword, one after another, every operand placed
#[testing]
val LOOPS: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    loop nand_w x10, x11, x12, x5\n    loop nand_d x10, x11, x12, x5\n    loop cmpxchg_w x10, x11, x12, x13, x5\n    loop cmpxchg_d x10, x11, x12, x13, x5\n    jalr x0, x1, 0\n}\n";

# each body a block of its own between the jump into it and the block after it, which the next loop's jump ends
#[testing]
val LOOPS_OUT: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    jal x0, ^1\n^1:\n    lr.w x10, x11, 3\n    and x5, x10, x12\n    xori x5, x5, -1\n    sc.w x5, x11, x5, 1\n    bne x5, x0, ^1\n    jal x0, ^2\n^2:\n    jal x0, ^3\n^3:\n    lr.d x10, x11, 3\n    and x5, x10, x12\n    xori x5, x5, -1\n    sc.d x5, x11, x5, 1\n    bne x5, x0, ^3\n    jal x0, ^4\n^4:\n    jal x0, ^5\n^5:\n    lr.w x10, x11, 3\n    bne x10, x12, ^6\n    sc.w x5, x11, x13, 1\n    bne x5, x0, ^5\n    jal x0, ^6\n^6:\n    jal x0, ^7\n^7:\n    lr.d x10, x11, 3\n    bne x10, x12, ^8\n    sc.d x5, x11, x13, 1\n    bne x5, x0, ^7\n    jal x0, ^8\n^8:\n    jalr x0, x1, 0\n}\n";

test loop__each_risc_v_loop_expands_to_its_body_in_a_block_of_its_own {
    var x:      Fixture;
    val opened: i32 = open(?x, view_of(MODULE));
    if (opened != 0) { ret opened; }
    fin { close(?x); }
    val input: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(LOOPS));
    if (sel input.err) { ret 10; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val expected: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, view_of(LOOPS_OUT));
    if (sel expected.err) { ret 11; }
    var e: reader.Unit = expected.ok;
    fin { reader.dnit(?e); }
    val r:    lay.Request          = lay.Request{convention: ?x.mach.convention, at: ?x.at};
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, r);
    if (sel laid.err) { ret 12; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val framed: res[Framed, finish.Error] = finish.finish(?x.a, ?u.items.data[0].function, ?p, ?FRAME);
    if (sel framed.err) { ret 13; }
    var out: Framed = framed.ok;
    fin { record.release(?out); }
    val done: err[expand.Error] = expand.expand(?x.a, ?out);
    if (sel done.err) { ret 14; }
    val same: res[bool, printer.Error] = equal.same_function(?x.m, ?out.function, ?x.m, ?e.items.data[0].function);
    if (sel same.err) { ret 15; }
    if (!same.ok) {
        show(?x.m, out.function);
        ret 16;
    }
    ret 0;
}

# thirty values live across a nand and a compare and exchange of a word, more than the registers hold
#[testing]
val PRESSED: str = "function @pressed: fun(ptr, i32) -> (i32) linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact] {\n^entry(%p: ptr, %x: i32):\n    %v1 = add %x, i32 1\n    %v2 = add %x, i32 2\n    %v3 = add %x, i32 3\n    %v4 = add %x, i32 4\n    %v5 = add %x, i32 5\n    %v6 = add %x, i32 6\n    %v7 = add %x, i32 7\n    %v8 = add %x, i32 8\n    %v9 = add %x, i32 9\n    %v10 = add %x, i32 10\n    %v11 = add %x, i32 11\n    %v12 = add %x, i32 12\n    %v13 = add %x, i32 13\n    %v14 = add %x, i32 14\n    %v15 = add %x, i32 15\n    %v16 = add %x, i32 16\n    %v17 = add %x, i32 17\n    %v18 = add %x, i32 18\n    %v19 = add %x, i32 19\n    %v20 = add %x, i32 20\n    %v21 = add %x, i32 21\n    %v22 = add %x, i32 22\n    %v23 = add %x, i32 23\n    %v24 = add %x, i32 24\n    %v25 = add %x, i32 25\n    %v26 = add %x, i32 26\n    %v27 = add %x, i32 27\n    %v28 = add %x, i32 28\n    %v29 = add %x, i32 29\n    %v30 = add %x, i32 30\n    %a = atomic.nand %p, %x, order seq_cst\n    %c, %won = atomic.cmpxchg %p, %a, %v1, success seq_cst, failure seq_cst\n    %s0 = add %c, %a\n    %s1 = add %s0, %v1\n    %s2 = add %s1, %v2\n    %s3 = add %s2, %v3\n    %s4 = add %s3, %v4\n    %s5 = add %s4, %v5\n    %s6 = add %s5, %v6\n    %s7 = add %s6, %v7\n    %s8 = add %s7, %v8\n    %s9 = add %s8, %v9\n    %s10 = add %s9, %v10\n    %s11 = add %s10, %v11\n    %s12 = add %s11, %v12\n    %s13 = add %s12, %v13\n    %s14 = add %s13, %v14\n    %s15 = add %s14, %v15\n    %s16 = add %s15, %v16\n    %s17 = add %s16, %v17\n    %s18 = add %s17, %v18\n    %s19 = add %s18, %v19\n    %s20 = add %s19, %v20\n    %s21 = add %s20, %v21\n    %s22 = add %s21, %v22\n    %s23 = add %s22, %v23\n    %s24 = add %s23, %v24\n    %s25 = add %s24, %v25\n    %s26 = add %s25, %v26\n    %s27 = add %s26, %v27\n    %s28 = add %s27, %v28\n    %s29 = add %s28, %v29\n    %s30 = add %s29, %v30\n    %w = ext.u %won, to i32\n    %r = add %s30, %w\n    ret.placed %r, places [register 0 10 fixed exact]\n}\n";

# the text of the pressed function for a target
#[testing]
fun pressed(a: *allocator.Allocator, name: str) opt[vector.Vector[u8]] {
    var out:   vector.Vector[u8] = vector.init[u8](a);
    val head:  str               = "target \"";
    val parts: [4]str            = [4]str{head, name, "\"\n", PRESSED};
    var k:     usize             = 0;
    for (k < 4) {
        var i: usize = 0;
        for (i < str_len(parts[k])) {
            val pushed: res[usize, allocator.Error] = vector.push[u8](?out, parts[k][i]);
            if (sel pushed.err) {
                vector.dnit[u8](?out);
                ret opt[vector.Vector[u8]].none{};
            }
            i = i + 1;
        }
        k = k + 1;
    }
    ret opt[vector.Vector[u8]].some{out};
}

# the loops a function's placed instructions are, in order
#[testing]
fun loops_of(a: *allocator.Allocator, f: *Function) vector.Vector[*lrow.Loop] {
    var found: vector.Vector[*lrow.Loop] = vector.init[*lrow.Loop](a);
    var b:     usize                     = 0;
    for (b < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, Block{index: b::u32});
        var k:    usize              = 0;
        for (k < list.size) {
            val op: Opcode = function.data(f, list.data[k]).opcode;
            if (sel op.loop) { vector.push[*lrow.Loop](?found, op.loop); }
            k = k + 1;
        }
        b = b + 1;
    }
    ret found;
}

# whether a block is a loop's body and its jump, row for row, with no memory
# access but its reserved pair
#[testing]
fun is_body(f: *Function, b: u32, l: *lrow.Loop) bool {
    val list: Slice[Instruction] = function.instructions(f, Block{index: b});
    val body: u32                = lrow.steps_in(l.body);
    if (list.size != body::usize + 1) { ret false; }
    var touches: u32   = 0;
    var k:       usize = 0;
    for (k < list.size) {
        val op: Opcode = function.data(f, list.data[k]).opcode;
        if (!(sel op.row)) { ret false; }
        var want: *rows_of.Row = l.jump.row;
        if (k < body::usize)                                      { want = lrow.step_of(l.body, k::u32).row; }
        if (op.row != want)                                       { ret false; }
        if (op.row.effect != nil && op.row.effect.memory.len > 0) { touches = touches + 1; }
        k = k + 1;
    }
    ret touches == 2;
}

# select the pressed function for a target given a baseline, 0 when both its
# atomics select to loops and, when the whole pipeline runs on the target's
# machine, the allocator spills and the loops expand after the frame and the
# lowering of copies to blocks of their own with nothing else inside
#[testing]
fun presses(name: str, baseline: str, whole: bool) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val text: opt[vector.Vector[u8]] = pressed(?a, name);
    if (sel text.none) { ret 1; }
    var source: vector.Vector[u8] = text.some;
    fin { vector.dnit[u8](?source); }
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, View{data: source.data, len: source.len});
    if (sel made.err) { ret 2; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(m.target);
    if (sel row.none) { ret 3; }
    var t: Target = @row.some;
    t.baseline = Baseline.extensions{baseline};
    val at_made: res[Locations, location.Error] = location.init(?a, ?riscv_register.FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel at_made.err) { ret 4; }
    var at: Locations = at_made.ok;
    fin { location.dnit(?at); }

    # a selection alone, its calls clobbering nothing, or the target's machine
    var mach:  Machine;
    var basis: machine.Basis;
    if (whole) {
        val opened: err[machine.Error] = machine.open(?mach, ?a, ?t);
        if (sel opened.err) { ret 5; }
    }
    or {
        val chosen: err[machine.Error] = machine.choose(?basis, ?a, ?t, Slice[str]{data: nil, size: 0});
        if (sel chosen.err) { ret 5; }
    }
    fin {
        if (whole) { machine.close(?mach); }
        or         { machine.drop(?basis); }
    }
    var selection: *extension.Selection = ?basis.selection;
    var calls:     Calls                = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?at};
    if (whole) {
        selection       = ?mach.basis.selection;
        calls.clobbered = mach.convention.clobbered;
    }
    val ready: res[Selector, engine.Error] = engine.init(?a, ?TABLE, ?t, ?riscv_set.SET, selection);
    if (sel ready.err) { ret 6; }
    var s: Selector = ready.ok;
    fin { engine.dnit(?s); }
    val picked: res[Selected, engine.Error] = engine.select(?s, ?m, id.Function{index: 0}, ?calls);
    if (sel picked.err) { ret 7; }
    var chosen: Selected = picked.ok;
    fin { engine.release(?chosen); }
    var selected: vector.Vector[*lrow.Loop] = loops_of(?a, ?chosen.function);
    fin { vector.dnit[*lrow.Loop](?selected); }
    if (selected.len != 2) { ret 8; }
    if (!whole)            { ret 0; }

    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_machine(?a, ?mach, ?at, false);
    if (sel listed.err) { ret 9; }
    var given: vector.Vector[Physical] = listed.ok;
    fin { vector.dnit[Physical](?given); }
    val request: allocate.Request                = allocate.Request{at: ?at, registers: ?mach.registers, allowed: Slice[Physical]{data: given.data, size: given.len}, clobbers: Slice[Clobber]{data: chosen.clobbers.data, size: chosen.clobbers.len}};
    val done:    res[Allocation, allocate.Error] = allocate.allocate(?a, ?chosen.function, request);
    if (sel done.err) { ret 10; }
    var allocated: Allocation = done.ok;
    fin { allocate.release(?allocated); }
    if (allocated.spills.len == 0) { ret 11; }
    val framed: res[Framed, finish.Error] = frame.frame(?a, ?allocated, lay.Request{convention: ?mach.convention, at: ?at}, ?FRAME);
    if (sel framed.err) { ret 12; }
    var out: Framed = framed.ok;
    fin { record.release(?out); }
    val indexed: res[move.Index, move.Error] = move.index(?a, ?MOVES, ?at, ?mach.registers);
    if (sel indexed.err) { ret 13; }
    var moves: move.Index = indexed.ok;
    fin { move.dnit(?moves); }
    var copying: lower.Request    = lower.Request{at: ?at, registers: ?mach.registers, clobbered: mach.convention.clobbered, allowed: Slice[Physical]{data: given.data, size: given.len}, code: ?FRAME, moves: ?moves};
    val copied:  err[lower.Error] = lower.lower(?a, ?out, ?copying);
    if (sel copied.err) { ret 14; }
    var placed: vector.Vector[*lrow.Loop] = loops_of(?a, ?out.function);
    fin { vector.dnit[*lrow.Loop](?placed); }
    val expanded: err[expand.Error] = expand.expand(?a, ?out);
    if (sel expanded.err) { ret 15; }
    var bodies: usize = 0;
    var b:      u32   = 0;
    for (b::usize < out.function.blocks.len) {
        var k: usize = 0;
        for (k < placed.len) {
            if (is_body(?out.function, b, placed.data[k])) {
                bodies = bodies + 1;
                brk;
            }
            k = k + 1;
        }
        b = b + 1;
    }
    if (bodies != placed.len || placed.len != 2) {
        show(?m, out.function);
        ret 16;
    }
    ret 0;
}

# a nand and a compare and exchange select to loops on rv64imac and rv32imac,
# and under register pressure on the riscv64 machine, whose lp64d convention
# needs the d of rv64gc, the allocator spills around the loops, whose bodies
# expand to blocks holding their steps alone, with no memory access but the
# reserved pair
test loop__under_register_pressure_no_spill_lands_inside_a_loop {
    val wide: i32 = presses("riscv64-linux", "rv64imac", false);
    if (wide != 0) { ret wide; }
    val narrow: i32 = presses("riscv32-linux", "rv32imac", false);
    if (narrow != 0) { ret 100 + narrow; }
    val whole: i32 = presses("riscv64-linux", "rv64gc", true);
    if (whole != 0) { ret 200 + whole; }
    ret 0;
}

# every RISC-V loop a selection admits at either register width keeps the
# constraint of the set's loops, and each width admits every loop on a field
# and on a word
test loop__every_risc_v_loop_keeps_the_constraint_at_either_register_width {
    val carried: lrow.Loops = loops.of(?riscv_set.SET);
    if (carried.len == 0) { ret 1; }
    val names:     [2]str = [2]str{"riscv64-linux", "riscv32-linux"};
    val baselines: [2]str = [2]str{"rv64imac", "rv32imac"};
    var w:         usize  = 0;
    for (w < 2) {
        var a: allocator.Allocator;
        page.make(?a);
        val row: opt[*Target] = targets.by_name(view_of(names[w]));
        if (sel row.none) { ret 2; }
        var t: Target = @row.some;
        t.baseline = Baseline.extensions{baselines[w]};
        var basis:  machine.Basis;
        val chosen: err[machine.Error] = machine.choose(?basis, ?a, ?t, Slice[str]{data: nil, size: 0});
        if (sel chosen.err) { ret 3; }
        var admitted: u32 = 0;
        var k:        u32 = 0;
        for (k < carried.len) {
            val l:  *lrow.Loop = carried.at[k];
            var ok: bool       = true;
            var j:  u32        = 0;
            for (j < lrow.count(l)) {
                if (!extension.admits(?basis.selection, lrow.step(l, j).row.requires)) { ok = false; }
                j = j + 1;
            }
            if (ok) {
                admitted = admitted + 1;
                val broken: opt[lrow.Breach] = lrow.constrained(l, ?carried.constraint);
                if (sel broken.some) {
                    machine.drop(?basis);
                    ret 10 + k::i32;
                }
            }
            k = k + 1;
        }
        machine.drop(?basis);
        # rv32 leaves out the two doubleword loops
        if (w == 0 && admitted != carried.len)     { ret 4; }
        if (w == 1 && admitted != carried.len - 2) { ret 5; }
        w = w + 1;
    }
    ret 0;
}

# a scratch register, an address and a loaded value of the loops that break the constraint
#[testing]
val BREAK_ROLES: [4]mo.Role = [4]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.WRITE};

#[testing]
val B_LOAD:       [3]lrow.Source = [3]lrow.Source{lrow.Source.operand{0}, lrow.Source.operand{1}, lrow.Source.literal{3}};
#[testing]
val B_PLAIN_LOAD: [3]lrow.Source = [3]lrow.Source{lrow.Source.operand{0}, lrow.Source.operand{1}, lrow.Source.literal{0}};
#[testing]
val B_STEP:       [3]lrow.Source = [3]lrow.Source{lrow.Source.operand{3}, lrow.Source.operand{0}, lrow.Source.literal{1}};
#[testing]
val B_STORE:      [4]lrow.Source = [4]lrow.Source{lrow.Source.operand{3}, lrow.Source.operand{1}, lrow.Source.operand{3}, lrow.Source.literal{1}};
#[testing]
val B_REPEAT:     [3]lrow.Source = [3]lrow.Source{lrow.Source.operand{3}, lrow.Source.fixed{gen_register.X0}, lrow.Source.head{}};
#[testing]
val B_FENCE:      [5]lrow.Source = [5]lrow.Source{lrow.Source.fixed{gen_register.X0}, lrow.Source.fixed{gen_register.X0}, lrow.Source.literal{0}, lrow.Source.literal{3}, lrow.Source.literal{3}};
#[testing]
val B_OUT:        [2]lrow.Source = [2]lrow.Source{lrow.Source.fixed{gen_register.X0}, lrow.Source.exit{}};
#[testing]
val B_TO:         [2]lrow.Source = [2]lrow.Source{lrow.Source.fixed{gen_register.X0}, lrow.Source.target{}};

#[testing]
fun b_step(row: *rows_of.Row, at: *lrow.Source, n: u32) lrow.Step {
    ret lrow.Step{row: row, operands: lrow.Sources{at: at, len: n}};
}

# a loop whose body is a list of steps
#[testing]
fun broken(body: *lrow.Steps) lrow.Loop {
    ret lrow.Loop{name: "broken", roles: lrow.Roles{at: ?BREAK_ROLES[0], len: 4}, before: lrow.NO_PARTS, body: lrow.Parts{at: body, len: 1}, after: lrow.NO_PARTS, jump: b_step(gen_row.JAL, ?B_TO[0], 2)};
}

# a breach as its case, 0 for none, and the step or count it names
#[testing]
fun breach_of(b: opt[lrow.Breach]) [2]u32 {
    if (sel b.none) { ret [2]u32{0, 0}; }
    val x: lrow.Breach = b.some;
    if (sel x.long)   { ret [2]u32{1, x.long}; }
    if (sel x.opened) { ret [2]u32{2, 0}; }
    if (sel x.access) { ret [2]u32{3, x.access}; }
    if (sel x.stored) { ret [2]u32{4, 0}; }
    if (sel x.row)    { ret [2]u32{5, x.row}; }
    if (sel x.branch) { ret [2]u32{6, x.branch}; }
    if (sel x.retry)  { ret [2]u32{7, x.retry}; }
    ret [2]u32{8, 0};
}

#[testing]
fun breaks(l: *lrow.Loop, c: *lrow.Constraint, kind: u32, at: u32) bool {
    val got: [2]u32 = breach_of(lrow.constrained(l, c));
    ret got[0] == kind && got[1] == at;
}

# a body over the limit, with a load or a fence between the pair, a jump
# inside it, a retry before the store or a plain load opening it, is refused
# by how it breaks the constraint, and the engine refuses a table whose
# rule emits the long one
test loop__a_body_breaking_the_constraint_is_refused {
    val c:    *lrow.Constraint = ?riscv_loop.CONSTRAINT;
    var long: [18]lrow.Step;
    long[0] = b_step(gen_row.LR_W, ?B_LOAD[0], 3);
    var k: usize = 1;
    for (k < 16) {
        long[k] = b_step(gen_row.ADDI, ?B_STEP[0], 3);
        k       = k + 1;
    }
    long[16] = b_step(gen_row.SC_W, ?B_STORE[0], 4);
    long[17] = b_step(gen_row.BNE, ?B_REPEAT[0], 3);
    var steps:  lrow.Steps = lrow.Steps{at: ?long[0], len: 18};
    var l:      lrow.Loop  = broken(?steps);
    val shaped: opt[str]   = lrow.check(?l);
    if (sel shaped.some)       { ret 1; }
    if (!breaks(?l, c, 1, 19)) { ret 2; }

    # the same body within the limit keeps it
    long[13]  = long[16];
    long[14]  = long[17];
    steps.len = 15;
    if (!breaks(?l, c, 0, 0)) { ret 3; }

    # a load between the pair
    var mixed: [4]lrow.Step;
    mixed[0] = b_step(gen_row.LR_W, ?B_LOAD[0], 3);
    mixed[1] = b_step(gen_row.LW, ?B_PLAIN_LOAD[0], 3);
    mixed[2] = b_step(gen_row.SC_W, ?B_STORE[0], 4);
    mixed[3] = b_step(gen_row.BNE, ?B_REPEAT[0], 3);
    steps    = lrow.Steps{at: ?mixed[0], len: 4};
    if (!breaks(?l, c, 3, 1)) { ret 4; }

    # a fence between the pair
    mixed[1] = b_step(gen_row.FENCE, ?B_FENCE[0], gen_row.FENCE.operands.len);
    if (!breaks(?l, c, 5, 1)) { ret 5; }

    # a jump out of the body
    mixed[1] = b_step(gen_row.JAL, ?B_OUT[0], 2);
    if (!breaks(?l, c, 6, 1)) { ret 6; }

    # a retry before the store
    mixed[1] = b_step(gen_row.BNE, ?B_REPEAT[0], 3);
    if (!breaks(?l, c, 7, 1)) { ret 7; }

    # a plain load opening the body
    mixed[0] = b_step(gen_row.LW, ?B_PLAIN_LOAD[0], 3);
    mixed[1] = b_step(gen_row.ADDI, ?B_STEP[0], 3);
    if (!breaks(?l, c, 2, 0)) { ret 8; }

    # a table emitting the long loop is refused by the engine as a breach
    long[13] = b_step(gen_row.ADDI, ?B_STEP[0], 3);
    long[14] = b_step(gen_row.ADDI, ?B_STEP[0], 3);
    steps    = lrow.Steps{at: ?long[0], len: 18};
    var emits: [1]rule.Emit = [1]rule.Emit{rule.Emit{opcode: Opcode.loop{?l}, operands: rule.Sources{at: ?BREAK_SOURCES[0], len: 4}, implied: rule.NO_IMPLIED}};
    var rules: [1]rule.Rule = [1]rule.Rule{rule.Rule{nodes: rule.Nodes{at: ?BREAK_NODES[0], len: 1}, tests: rule.Tests{at: nil, len: 0}, hook: nil, expansion: rule.Emits{at: ?emits[0], len: 1}, cost: 2}};
    var table: rule.Table   = TABLE;
    table.rules = rule.Rules{at: ?rules[0], len: 1};
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.by_name(view_of("riscv64-linux"));
    if (sel row.none) { ret 9; }
    var t: Target = @row.some;
    t.baseline = Baseline.extensions{"rv64imac"};
    var basis:  machine.Basis;
    val chosen: err[machine.Error] = machine.choose(?basis, ?a, ?t, Slice[str]{data: nil, size: 0});
    if (sel chosen.err) { ret 10; }
    fin { machine.drop(?basis); }
    val ready: res[Selector, engine.Error] = engine.init(?a, ?table, ?t, ?riscv_set.SET, ?basis.selection);
    if (sel ready.ok) {
        var s: Selector = ready.ok;
        engine.dnit(?s);
        ret 11;
    }
    val e: engine.Error = ready.err;
    if (!(sel e.breached)) { ret 12; }
    val at: [2]u32 = breach_of(opt[lrow.Breach].some{e.breached.breach});
    if (at[0] != 1) { ret 13; }
    ret 0;
}

#[testing]
val BREAK_NODES: [1]rule.Node = [1]rule.Node{rule.Node{opcode: ir_opcode.ATOMIC_NAND, parent: 0, operand: 0, result: 0, constants: 0}};

#[testing]
val BREAK_SOURCES: [4]rule.Source = [4]rule.Source{rule.Source.result{0}, rule.Source.value{rule.Slot{node: 0, index: 0}}, rule.Source.value{rule.Slot{node: 0, index: 1}}, rule.Source.scratch{rule.Scratch{index: 0, class: riscv_register.X}}};
