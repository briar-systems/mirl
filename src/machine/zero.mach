# the writing of a row of a register and zero in the set's row of that register alone once registers are allocated
#
# an instruction of a row a zeroing names (`isa.Zeroing`), its register at
# operand 0 and zero at operand 1, is rewritten as the zeroing's row of that
# register at both operands: x86's `mov eax, 0` as `xor eax, eax`, `cmp rax,
# 0` as `test rax, rax`, and a load of a float or vector zero as `xorps xmm0,
# xmm0`. zero is the immediate zero, or a memory operand that reads bytes the
# program never writes and that are all zero: an address of nothing but a
# symbol and no addend, the symbol a global of the module that is constant,
# defined here with an initial value, not replaceable and not seen by another
# image, so no write and no other definition reaches its bytes, and its value
# zero, or bits that are zero, or an aggregate of such lanes, as every
# constant the pool legalisation loads is. the zeroing states that the two
# rows leave every location both leave defined the same. the rewriting is
# made only where every location the two rows leave unlike each other, one
# touching it and the other not or the zeroing row leaving unspecified what
# the first defines, is dead after it (`mirl.machine.dead`), as the flags
# x86's xor writes and its move does not, or the auxiliary carry flag test
# leaves unspecified where cmp defines it. this runs after the frame, the
# copies and the loops and before layout, where every location is assigned.
#
# nothing here names a set: the rows are the set's zeroings, read as data.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.ir.constant.ConstantData;
use mirl.ir.global.GlobalData;
use mirl.ir.id;
use mirl.ir.linkage;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.machine.class.Physical;
use mirl.machine.dead;
use mirl.machine.dead.Scan;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.isa.Zeroing;
use mirl.machine.isa.Zeroings;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Symbol;

use masc.core.footprint;
use core_state: masc.core.state;

# an instruction of a row and zero a zeroing names
# ---
# zeroing: the zeroing, by its place among the set's
# into:    the register at operand 0
rec Zeroed {
    zeroing: u32;
    into:    Physical;
}

# whether constant `c` of module `m` is zero in every bit
fun zero_constant(m: *Module, c: id.Constant) bool {
    val res_data: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel res_data.err) { ret false; }
    val d: ConstantData = res_data.ok;
    if (sel d.zero) { ret true; }
    var words: Slice[u64] = Slice[u64]{data: nil, size: 0};
    if (sel d.integer) { words = d.integer.words; }
    or (sel d.float)   { words = d.float.words; }
    or (sel d.aggregate) {
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            if (!zero_constant(m, d.aggregate.elements.data[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    or { ret false; }
    var k: usize = 0;
    for (k < words.size) {
        if (words.data[k] != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether operand `o` is zero: the immediate zero, or a memory operand of only a symbol whose bytes are all zero and
# that nothing but its own definition writes
fun zero_operand(m: *Module, o: Operand) bool {
    if (sel o.immediate)                                                                                                 { ret o.immediate == 0; }
    if (!(sel o.address))                                                                                                { ret false; }
    if (sel o.address.base.some || sel o.address.index.some || sel o.address.segment.some || sel o.address.partner.some) { ret false; }
    if (o.address.disp != 0 || o.address.broadcast != 0)                                                                 { ret false; }
    val opt_symbol: opt[Symbol] = o.address.symbol;
    if (sel opt_symbol.none)         { ret false; }
    if (opt_symbol.some.addend != 0) { ret false; }
    val at: id.Symbol = opt_symbol.some.symbol;
    if (!(sel at.global)) { ret false; }
    val res_data: res[GlobalData, module.Error] = module.global_data(m, at.global);
    if (sel res_data.err) { ret false; }
    val g: GlobalData = res_data.ok;
    if (!g.constant || sel g.tls.some)                          { ret false; }
    if (g.linkage.replaceable || linkage.exportable(g.linkage)) { ret false; }
    val initial: opt[id.Constant] = g.initial;
    if (sel initial.none) { ret false; }
    ret zero_constant(m, initial.some);
}

# the instruction of a row and zero instruction `d` is, by a zeroing of `zs`, none for none
fun zeroed_of(m: *Module, zs: Zeroings, d: *InstructionData) opt[Zeroed] {
    val op: Opcode = d.opcode;
    if (!(sel op.row))        { ret opt[Zeroed].none{}; }
    if (d.operands.size != 2) { ret opt[Zeroed].none{}; }
    val into: Operand = d.operands.data[0];
    if (!(sel into.physical))          { ret opt[Zeroed].none{}; }
    if (!(sel into.physical.register)) { ret opt[Zeroed].none{}; }
    var k: u32 = 0;
    for (k < zs.len) {
        if (zs.at[k].long == op.row) {
            if (!zero_operand(m, d.operands.data[1])) { ret opt[Zeroed].none{}; }
            ret opt[Zeroed].some{Zeroed{zeroing: k, into: into.physical}};
        }
        k = k + 1;
    }
    ret opt[Zeroed].none{};
}

# rewrite every instruction of a row and zero of function `f` whose zeroing leaves nothing live unlike it
# ---
# a:   the allocator the rewriting takes and gives back
# f:   the allocated, framed function, its copies lowered and loops expanded, not yet laid out
# ctx: the context masc's footprints are asked under
# zs:  the set's zeroings
# m:   the module, whose globals a memory operand names
# ret: ok, or the allocator's refusal, the function then holding the instructions rewritten so far
pub fun zero(a: *allocator.Allocator, f: *Function, ctx: *core_state.Context, zs: Zeroings, m: *Module) err[allocator.Error] {
    if (zs.len == 0 || function.file(f) == nil) { ret err[allocator.Error].ok{}; }
    var any: bool  = false;
    var i:   usize = 0;
    for (i < f.instructions.len && !any) {
        val opt_zeroed: opt[Zeroed] = zeroed_of(m, zs, ?f.instructions.data[i]);
        any = sel opt_zeroed.some;
        i   = i + 1;
    }
    if (!any) { ret err[allocator.Error].ok{}; }
    val res_scan: res[Scan, allocator.Error] = dead.init(a, f, ctx);
    if (sel res_scan.err) { ret err[allocator.Error].err{res_scan.err}; }
    var x: Scan = res_scan.ok;
    fin { dead.dnit(?x); }
    var b: usize = 0;
    for (b < f.blocks.len) {
        val list: Slice[Instruction] = function.instructions(f, b::Block);
        var k:    usize              = 0;
        for (k < list.size) {
            val at:         Instruction = list.data[k];
            val opt_zeroed: opt[Zeroed] = zeroed_of(m, zs, function.data(f, at));
            if (sel opt_zeroed.some) {
                val z:        *Zeroing                   = ?zs.at[opt_zeroed.some.zeroing];
                val res_dead: res[bool, allocator.Error] = unlike_dead(?x, z, opt_zeroed.some.into, b::Block, k);
                if (sel res_dead.err) { ret err[allocator.Error].err{res_dead.err}; }
                if (res_dead.ok)      { rewrite(f, at, z, opt_zeroed.some.into); }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    ret err[allocator.Error].ok{};
}

# put zeroing row `z` of register `p`, which instruction `at` names at operand 0, at both operands in its place
fun rewrite(f: *Function, at: Instruction, z: *Zeroing, p: Physical) {
    var ops: [2]Operand = [2]Operand{Operand.physical{p}, Operand.physical{p}};
    function.replace(f, at, Opcode.row{z.short}, Slice[Operand]{data: ?ops[0], size: 2});
}

# whether every location zeroing row `z` of register `p` and the instruction at position `k` of block `b` leave unlike
# each other is dead after it, false where masc leaves either footprint undecided
fun unlike_dead(x: *Scan, z: *Zeroing, p: Physical, b: Block, k: usize) res[bool, allocator.Error] {
    val list: Slice[Instruction] = function.instructions(x.f, b);
    val d:    *InstructionData   = function.data(x.f, list.data[k]);
    dead.clear(x);
    val res_long: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, z.long, d.operands, d.state);
    if (sel res_long.err)     { ret res[bool, allocator.Error].err{res_long.err}; }
    if (sel res_long.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.hold(x);
    var ops:       [2]Operand                                      = [2]Operand{Operand.physical{p}, Operand.physical{p}};
    val res_short: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, z.short, Slice[Operand]{data: ?ops[0], size: 2}, d.state);
    if (sel res_short.err)     { ret res[bool, allocator.Error].err{res_short.err}; }
    if (sel res_short.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.changed(x);
    ret dead.dead_after(x, b, k);
}
