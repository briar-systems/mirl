# value binding records of a machine function: where a source variable's
# value is from a point of the code on, as the ir's records state it above
#
# selection gives each ir record a machine record before the first machine
# instruction made for the ir instruction it stood before, reading the virtual
# register of the value it read, or the constant itself. allocation turns the
# register into the location it was given: the register it holds over its
# whole life, or the slot a value in pieces lives in. every stage that writes
# a function anew carries the records to the instruction their own now begins
# at, so a record reaches the laid out code at its point. a record stays a
# record, never a use, and holds nothing alive.

use mirl.ir.debug.Binding;
use mirl.ir.id.Constant;
use mirl.ir.point.Bits;
use mirl.ir.point.Expression;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Register;
use mirl.machine.operand.Slot;

# what a machine record reads
# ---
# unavailable: nothing, the value having no place in the machine form
# register:    a register, virtual until allocation
# slot:        a frame slot, the home of a value carried in pieces
# constant:    a constant of the module, which needs no place
pub tag Reading: u8 {
    unavailable;
    register: Register;
    slot:     Slot;
    constant: Constant;
}

# one machine record
# ---
# at:         the instruction it stands before
# binding:    the variable it binds
# piece:      the bits of the variable it gives, WHOLE for all of them
# reads:      what gives them
# expression: the salvage steps that give them from what it reads
pub rec Point {
    at:         Instruction;
    binding:    Binding;
    piece:      Bits;
    reads:      Reading;
    expression: Expression;
}
