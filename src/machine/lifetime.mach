# the storage rule of the machine form, the ir's (`mirl.verify.storage`) where selection carries its markers
#
# selection carries each `slot.begin` and `slot.end` as the `slot_begin` and `slot_end` pseudo-instructions of the
# alloca's frame slot (`mirl.machine.pseudo`), and the lowering of copies drops them. they state where a slot's
# storage lasts from selection until the sharing of frame slots, the allocate step's last act, merges slots whose
# contents are never live at once and renames their markers with them (`mirl.machine.frame.share`). until then, on
# every path from the entry a slot's markers alternate, a begin where the slot is begun on no path and an end where it
# is begun on every path, and every access of a marked slot stands where the slot is begun on every path. a slot
# within another (`function.Within`) is its bytes and lasts as that slot does. a slot counts only the markers of its
# nearest marked owner, itself first, so a marked slot within a marked slot ignores the outer one's markers.
#
# an access of a slot is an instruction naming it as an operand other than a marker and other than the slot address
# pseudo-instruction, which forms its address and touches nothing (a copy, a spill or a reload naming it), and, once
# the function is allocated, an access through a register holding its address or a value derived from it
# (`mirl.machine.addressed.reaches`) that surely holds it on every path into the access. a register holding it on some
# paths only may hold something else on another, as an ir value that may carry two addresses, and is not checked.
# before allocation an address in a virtual register is not followed, and after allocation it is followed only while a
# register surely holds it: a copy, a spill, a call or anything else that lets it out of the registers ends what the
# walk sees of it, as the ir rule sees an address only up to where it goes out. a slot no marker names lasts the whole
# function, and a block the entry does not reach is not walked.
#
# begun on some path and not begun on some path are two forward problems over the blocks (`mirl.ir.cfg.flow`), each
# block giving the slots whose last marker in it begins or ends them. with s slots marked, b blocks, i instructions
# and r reaches, the gathering is O(s + b + i + r), each problem O(s + b + i) and the edges each fact is into, and the
# walk O(i + r) and the facts into each reached block.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.metadata.Metadata;
use mirl.machine.addressed;
use mirl.machine.addressed.Reach;
use mfunction: mirl.machine.function;
use mirl.machine.function.Area;
use mirl.machine.function.Function;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.pseudo;
use mirl.machine.vstate;

# the finding of a begin where its slot may be begun already
pub val BEGUN: str = "a slot_begin where its slot may be begun already";

# the finding of an end where its slot may not be begun
pub val UNBEGUN: str = "a slot_end where its slot may not be begun";

# the finding of an access of a slot where it may not be begun
pub val OUTSIDE: str = "an access of a slot where the slot may not be begun, on some path not yet begun or already ended";

val NONE: u32 = 0xffffffff;

# the operand of a finding of the instruction as a whole
pub val WHOLE: u32 = NONE;

# a fact that does not hold
# ---
# block:   the block
# at:      the instruction
# operand: the operand it is at, WHOLE for the instruction as a whole
# what:    the fact
pub rec Finding {
    block:   u32;
    at:      Instruction;
    operand: u32;
    what:    str;
}

# what the rule works in
# ---
# number:  each slot's number among the marked, NONE for a slot no marker names
# owner:   each slot's marked slot, its own or the one it is within, NONE for none
# marked:  how many slots a marker names
# reaches: the reaches, once the function is allocated
# heads:   each instruction's first reach, NONE for none
# links:   each reach's next of its instruction, NONE for none
# last:    each marked slot's last marker in the block being gathered, 0 for none, 1 for a begin, 2 for an end
# reached: each block, whether the entry reaches it
# stack:   the blocks the search for the reached ones is still to leave from
# touched: the marked slots `last` or the walk's sets name, to clear
# gen:     each block's slots whose last marker begins them
# kill:    each block's slots whose last marker ends them, and in the entry each slot it begins on no path
# begun:   the slots begun out of some path into each block
# unbegun: the slots not begun on some path into each block
# may:     the walk's slots begun on some path
# not:     the walk's slots not begun on some path
rec Work {
    number:   vector.Vector[u32];
    owner:    vector.Vector[u32];
    marked:   u32;
    reaches:  vector.Vector[Reach];
    heads:    vector.Vector[u32];
    links:    vector.Vector[u32];
    resolved: vector.Vector[u8];
    last:     vector.Vector[u8];
    reached:  vector.Vector[bool];
    stack:    vector.Vector[u32];
    touched:  vector.Vector[u32];
    gen:      Lists[u32];
    kill:     Lists[u32];
    begun:    Lists[u32];
    unbegun:  Lists[u32];
    may:      vector.Vector[bool];
    not:      vector.Vector[bool];
    flow:     flow.Work;
}

fun work_init(a: *allocator.Allocator) Work {
    ret Work{number: vector.init[u32](a), owner: vector.init[u32](a), marked: 0, reaches: vector.init[Reach](a), heads: vector.init[u32](a), links: vector.init[u32](a), resolved: vector.init[u8](a), last: vector.init[u8](a), reached: vector.init[bool](a), stack: vector.init[u32](a), touched: vector.init[u32](a), gen: graph.lists_init[u32](a), kill: graph.lists_init[u32](a), begun: graph.lists_init[u32](a), unbegun: graph.lists_init[u32](a), may: vector.init[bool](a), not: vector.init[bool](a), flow: flow.work(a)};
}

fun work_dnit(w: *Work) {
    vector.dnit[u32](?w.number);
    vector.dnit[u32](?w.owner);
    vector.dnit[Reach](?w.reaches);
    vector.dnit[bool](?w.reached);
    vector.dnit[u32](?w.stack);
    vector.dnit[u32](?w.heads);
    vector.dnit[u32](?w.links);
    vector.dnit[u8](?w.resolved);
    vector.dnit[u8](?w.last);
    vector.dnit[u32](?w.touched);
    graph.lists_dnit[u32](?w.gen);
    graph.lists_dnit[u32](?w.kill);
    graph.lists_dnit[u32](?w.begun);
    graph.lists_dnit[u32](?w.unbegun);
    vector.dnit[bool](?w.may);
    vector.dnit[bool](?w.not);
    flow.work_dnit(?w.flow);
}

# the slot a marker names, NONE for any other instruction
fun marks(d: *InstructionData) u32 {
    val op: Opcode = d.opcode;
    if (!(sel op.pseudo))                                 { ret NONE; }
    if (!pseudo.marks(op.pseudo) || d.operands.size != 1) { ret NONE; }
    val o: Operand = d.operands.data[0];
    if (!(sel o.slot)) { ret NONE; }
    ret o.slot;
}

fun begins(d: *InstructionData) bool {
    val op: Opcode = d.opcode;
    ret sel op.pseudo && op.pseudo == pseudo.SLOT_BEGIN;
}

# whether instruction `d` names its slots only to form their address
fun forms(d: *InstructionData) bool {
    val op: Opcode = d.opcode;
    ret sel op.pseudo && op.pseudo == pseudo.ADDRESS;
}

# whether every register an operand of function `f` names is a location
fun allocated(f: *Function) bool {
    var i: usize = 0;
    for (i < f.instructions.len) {
        val d: *InstructionData = ?f.instructions.data[i];
        var n: usize            = 0;
        for (n < d.operands.size) {
            val o: Operand = d.operands.data[n];
            if (sel o.virtual) { ret false; }
            n = n + 1;
        }
        i = i + 1;
    }
    ret true;
}

# give slot `s` of `f`, and each slot on its way up, its marked owner: itself where a marker names it, else the owner
# of the slot it is within, whichever was made first. `resolved` marks each slot resolved, so every slot is walked once
fun owned(w: *Work, f: *Function, s: u32) err[allocator.Error] {
    vector.clear[u32](?w.stack);
    var at:    u32 = s;
    var found: u32 = NONE;
    for (w.resolved.data[at] == 0) {
        w.resolved.data[at] = 1;
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.stack, at);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        if (w.number.data[at] != NONE) {
            found = at;
            brk;
        }
        val area: Area = f.slots.data[at].area;
        if (!(sel area.within))                     { brk; }
        if (area.within.slot::usize >= f.slots.len) { brk; }
        at = area.within.slot;
    }
    if (found == NONE && w.resolved.data[at] == 2) { found = w.owner.data[at]; }
    var k: usize = 0;
    for (k < w.stack.len) {
        w.owner.data[w.stack.data[k]]    = found;
        w.resolved.data[w.stack.data[k]] = 2;
        k                                = k + 1;
    }
    ret err[allocator.Error].ok{};
}

# number the marked slots of `f` and give each slot its marked owner
fun numbered(w: *Work, f: *Function) err[allocator.Error] {
    w.marked = 0;
    var err_failed: err[allocator.Error] = slice.reset[u32](?w.number, f.slots.len, NONE);
    keep(?err_failed, slice.reset[u32](?w.owner, f.slots.len, NONE));
    if (sel err_failed.err) { ret err_failed; }
    var i: usize = 0;
    for (i < f.instructions.len) {
        val s: u32 = marks(?f.instructions.data[i]);
        if (s::usize < f.slots.len && w.number.data[s] == NONE) {
            w.number.data[s] = w.marked;
            w.marked         = w.marked + 1;
        }
        i = i + 1;
    }
    keep(?err_failed, slice.reset[u8](?w.resolved, f.slots.len, 0));
    var s: usize = 0;
    for (s < f.slots.len && !(sel err_failed.err)) {
        keep(?err_failed, owned(w, f, s::u32));
        s = s + 1;
    }
    ret err_failed;
}

# list the reaches of allocated function `f` by instruction
fun indexed(w: *Work, a: *allocator.Allocator, f: *Function) err[allocator.Error] {
    vector.clear[Reach](?w.reaches);
    var escaped: vector.Vector[bool] = vector.init[bool](a);
    fin { vector.dnit[bool](?escaped); }
    var err_failed: err[allocator.Error] = addressed.reaches(a, f, ?escaped, ?w.reaches);
    keep(?err_failed, slice.reset[u32](?w.heads, f.instructions.len, NONE));
    keep(?err_failed, slice.reset[u32](?w.links, w.reaches.len, NONE));
    if (sel err_failed.err) { ret err_failed; }
    var r: usize = 0;
    for (r < w.reaches.len) {
        val at: Instruction = w.reaches.data[r].at;
        if (at::usize < w.heads.len) {
            w.links.data[r]  = w.heads.data[at];
            w.heads.data[at] = r::u32;
        }
        r = r + 1;
    }
    ret err[allocator.Error].ok{};
}

# mark the blocks the entry of graph `g` reaches
fun reach(w: *Work, g: *Graph) err[allocator.Error] {
    vector.clear[u32](?w.stack);
    val err_filled: err[allocator.Error] = slice.reset[bool](?w.reached, g.count::usize, false);
    if (sel err_filled.err) { ret err_filled; }
    val entry: u32 = graph.entry(g);
    w.reached.data[entry] = true;
    val res_started: res[usize, allocator.Error] = vector.push[u32](?w.stack, entry);
    if (sel res_started.err) { ret err[allocator.Error].err{res_started.err}; }
    for (w.stack.len > 0) {
        val n: u32 = w.stack.data[w.stack.len - 1];
        vector.truncate[u32](?w.stack, w.stack.len - 1);
        val next: Slice[u32] = graph.successors(g, n);
        var k:    usize      = 0;
        for (k < next.size) {
            if (!w.reached.data[next.data[k]]) {
                w.reached.data[next.data[k]] = true;
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.stack, next.data[k]);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
            k = k + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

# each block's gen and kill, none for a block the entry does not reach, from the last marker of each slot in it. the entry kills every slot it begins on no
# path, as nothing is begun into it
fun gathered(w: *Work, f: *Function, entry: u32) err[allocator.Error] {
    var err_failed: err[allocator.Error] = flow.rows(?w.gen);
    keep(?err_failed, flow.rows(?w.kill));
    keep(?err_failed, slice.reset[u8](?w.last, w.marked::usize, 0));
    if (sel err_failed.err) { ret err_failed; }
    var b: usize = 0;
    for (b < f.blocks.len && !(sel err_failed.err)) {
        vector.clear[u32](?w.touched);
        val list: *vector.Vector[Instruction] = ?f.blocks.data[b].instructions;
        var j:    usize                       = 0;
        for (w.reached.data[b] && j < list.len && !(sel err_failed.err)) {
            val d: *InstructionData = ?f.instructions.data[list.data[j]];
            val s: u32              = marks(d);
            if (s::usize < w.number.len && w.number.data[s] != NONE) {
                val n: u32 = w.number.data[s];
                if (w.last.data[n] == 0) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.touched, n);
                    if (sel res_pushed.err) { keep(?err_failed, err[allocator.Error].err{res_pushed.err}); }
                }
                w.last.data[n] = 2;
                if (begins(d)) { w.last.data[n] = 1; }
            }
            j = j + 1;
        }
        var t: usize = 0;
        for (t < w.touched.len && !(sel err_failed.err)) {
            val n: u32 = w.touched.data[t];
            if (w.last.data[n] == 1) { keep(?err_failed, flow.fact(?w.gen, n)); }
            or                       { keep(?err_failed, flow.fact(?w.kill, n)); }
            t = t + 1;
        }
        if (b::u32 == entry) {
            var n: u32 = 0;
            for (n < w.marked && !(sel err_failed.err)) {
                if (w.last.data[n] == 0) { keep(?err_failed, flow.fact(?w.kill, n)); }
                n = n + 1;
            }
        }
        t = 0;
        for (t < w.touched.len) {
            w.last.data[w.touched.data[t]] = 0;
            t                              = t + 1;
        }
        keep(?err_failed, flow.next(?w.gen));
        keep(?err_failed, flow.next(?w.kill));
        b = b + 1;
    }
    ret err_failed;
}

fun set(w: *Work, n: u32, begun: bool) err[allocator.Error] {
    if (!w.may.data[n] && !w.not.data[n]) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.touched, n);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    w.may.data[n] = begun;
    w.not.data[n] = !begun;
    ret err[allocator.Error].ok{};
}

# the marked slot a slot operand stands for, NONE for none
fun slot_of(w: *Work, o: Operand) u32 {
    if (!(sel o.slot))                { ret NONE; }
    if (o.slot::usize >= w.owner.len) { ret NONE; }
    val s: u32 = w.owner.data[o.slot];
    if (s == NONE) { ret NONE; }
    ret w.number.data[s];
}

# block `b` walked from what is begun and not begun into it, each marker and access checked before the instruction
# moves the state
fun across(w: *Work, f: *Function, b: u32, entry: u32) res[opt[Finding], allocator.Error] {
    vector.clear[u32](?w.touched);
    val into: Slice[u32] = flow.row(?w.begun, b);
    var k:    usize      = 0;
    for (k < into.size) {
        w.may.data[into.data[k]] = true;
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.touched, into.data[k]);
        if (sel res_pushed.err) { ret res[opt[Finding], allocator.Error].err{res_pushed.err}; }
        k = k + 1;
    }
    val out: Slice[u32] = flow.row(?w.unbegun, b);
    k = 0;
    for (k < out.size) {
        if (!w.may.data[out.data[k]]) {
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.touched, out.data[k]);
            if (sel res_pushed.err) { ret res[opt[Finding], allocator.Error].err{res_pushed.err}; }
        }
        w.not.data[out.data[k]] = true;
        k                       = k + 1;
    }
    if (b == entry) {
        var n: u32 = 0;
        for (n < w.marked) {
            if (!w.may.data[n] && !w.not.data[n]) {
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?w.touched, n);
                if (sel res_pushed.err) { ret res[opt[Finding], allocator.Error].err{res_pushed.err}; }
            }
            w.not.data[n] = true;
            n             = n + 1;
        }
    }
    var found: opt[Finding]                = opt[Finding].none{};
    val list:  *vector.Vector[Instruction] = ?f.blocks.data[b].instructions;
    var j:     usize                       = 0;
    for (j < list.len && (sel found.none)) {
        val i: Instruction      = list.data[j];
        val d: *InstructionData = ?f.instructions.data[i];
        val s: u32              = marks(d);
        if (s != NONE) {
            val n: u32 = slot_of(w, d.operands.data[0]);
            if (n != NONE) {
                val opens: bool = begins(d);
                if (opens && w.may.data[n])  { found = opt[Finding].some{Finding{block: b, at: i, operand: 0, what: BEGUN}}; }
                or (!opens && w.not.data[n]) { found = opt[Finding].some{Finding{block: b, at: i, operand: 0, what: UNBEGUN}}; }
                or {
                    val err_set: err[allocator.Error] = set(w, n, opens);
                    if (sel err_set.err) { ret res[opt[Finding], allocator.Error].err{err_set.err}; }
                }
            }
        }
        or {
            if (!forms(d)) {
                var o: usize = 0;
                for (o < d.operands.size && (sel found.none)) {
                    val n: u32 = slot_of(w, d.operands.data[o]);
                    if (n != NONE && w.not.data[n]) { found = opt[Finding].some{Finding{block: b, at: i, operand: o::u32, what: OUTSIDE}}; }
                    o = o + 1;
                }
            }
            if (i::usize < w.heads.len) {
                var r: u32 = w.heads.data[i];
                for (r != NONE && (sel found.none)) {
                    val t: u32 = w.reaches.data[r].slot;
                    if (w.reaches.data[r].sure && !w.reaches.data[r].derived && t::usize < w.owner.len) {
                        val s_owner: u32 = w.owner.data[t];
                        if (s_owner != NONE && w.not.data[w.number.data[s_owner]]) { found = opt[Finding].some{Finding{block: b, at: i, operand: WHOLE, what: OUTSIDE}}; }
                    }
                    r = w.links.data[r];
                }
            }
        }
        j = j + 1;
    }
    k = 0;
    for (k < w.touched.len) {
        w.may.data[w.touched.data[k]] = false;
        w.not.data[w.touched.data[k]] = false;
        k                             = k + 1;
    }
    ret res[opt[Finding], allocator.Error].ok{found};
}

# the storage rule over machine function `f`, as the module header states it
# ---
# a:   the allocator the rule works in
# f:   the function
# ret: none where it holds, the first marker or access that does not, or the allocator's refusal
pub fun check(a: *allocator.Allocator, f: *Function) res[opt[Finding], allocator.Error] {
    var w: Work = work_init(a);
    fin { work_dnit(?w); }
    val err_numbered: err[allocator.Error] = numbered(?w, f);
    if (sel err_numbered.err) { ret res[opt[Finding], allocator.Error].err{err_numbered.err}; }
    if (w.marked == 0)        { ret res[opt[Finding], allocator.Error].ok{opt[Finding].none{}}; }
    if (allocated(f)) {
        val err_indexed: err[allocator.Error] = indexed(?w, a, f);
        if (sel err_indexed.err) { ret res[opt[Finding], allocator.Error].err{err_indexed.err}; }
    }
    val res_graph: res[Graph, allocator.Error] = mfunction.graph_of(f);
    if (sel res_graph.err) { ret res[opt[Finding], allocator.Error].err{res_graph.err}; }
    var g: Graph = res_graph.ok;
    fin { graph.dnit(?g); }
    val entry:      u32                  = graph.entry(?g);
    var err_failed: err[allocator.Error] = reach(?w, ?g);
    keep(?err_failed, gathered(?w, f, entry));
    keep(?err_failed, flow.forward(?w.flow, ?g, flow.Problem{facts: w.marked, gen: ?w.gen, kill: ?w.kill}, ?w.begun, nil));
    keep(?err_failed, flow.forward(?w.flow, ?g, flow.Problem{facts: w.marked, gen: ?w.kill, kill: ?w.gen}, ?w.unbegun, nil));
    keep(?err_failed, slice.reset[bool](?w.may, w.marked::usize, false));
    keep(?err_failed, slice.reset[bool](?w.not, w.marked::usize, false));
    if (sel err_failed.err) { ret res[opt[Finding], allocator.Error].err{err_failed.err}; }
    var b: usize = 0;
    for (b < f.blocks.len) {
        if (b < w.reached.len && w.reached.data[b]) {
            val res_walked: res[opt[Finding], allocator.Error] = across(?w, f, b::u32, entry);
            if (sel res_walked.err)     { ret res_walked; }
            if (sel res_walked.ok.some) { ret res_walked; }
        }
        b = b + 1;
    }
    ret res[opt[Finding], allocator.Error].ok{opt[Finding].none{}};
}

# a function of `blocks` blocks and one slot, for the tests, unchecked against any instruction set, its one slot 0
#[testing]
fun shaped(a: *allocator.Allocator, blocks: u32) Function {
    var f: Function = mfunction.init(a, nil, false);
    var k: u32      = 0;
    for (k < blocks) {
        val res_made: res[u32, mfunction.Error] = mfunction.block(?f);
        k = k + 1;
    }
    val res_slot: res[u32, mfunction.Error] = mfunction.slot(?f, mfunction.fixed_slot(8, 8));
    ret f;
}

# append to block `b` of `f` a pseudo-instruction of `p` and its operands
#[testing]
fun put(f: *Function, b: u32, p: pseudo.Pseudo, operands: Slice[Operand]) {
    val res_put: res[Instruction, mfunction.Error] = mfunction.append(f, b, Opcode.pseudo{p}, operands, Metadata{}, false, opt[vstate.State].none{});
}

# append to block `b` of `f` a marker of slot 0, a begin where `opens`
#[testing]
fun mark(f: *Function, b: u32, opens: bool) {
    var ops: [1]Operand    = [1]Operand{Operand.slot{0}};
    var p:   pseudo.Pseudo = pseudo.SLOT_END;
    if (opens) { p = pseudo.SLOT_BEGIN; }
    put(f, b, p, Slice[Operand]{data: ?ops[0], size: 1});
}

# append to block `b` of `f` a copy of slot 0 into a virtual register, an access naming the slot
#[testing]
fun touch(f: *Function, b: u32) {
    var ops: [2]Operand = [2]Operand{Operand.virtual{0}, Operand.slot{0}};
    put(f, b, pseudo.COPY, Slice[Operand]{data: ?ops[0], size: 2});
}

# append to block `b` of `f` a copy of one virtual register into another, which leaves the function unallocated, so
# the rule reads no register file the tests have none of
#[testing]
fun moved(f: *Function, b: u32) {
    var ops: [2]Operand = [2]Operand{Operand.virtual{1}, Operand.virtual{0}};
    put(f, b, pseudo.COPY, Slice[Operand]{data: ?ops[0], size: 2});
}

# append to block `b` of `f` the edges to `to`, as a jump table naming them
#[testing]
fun jump(f: *Function, b: u32, to: Slice[u32]) {
    var ops: [2]Operand = [2]Operand{Operand.block{0}, Operand.block{0}};
    var k:   usize      = 0;
    for (k < to.size) {
        ops[k] = Operand.block{to.data[k]};
        k      = k + 1;
    }
    put(f, b, pseudo.TABLE, Slice[Operand]{data: ?ops[0], size: to.size});
}

# the fact the rule finds in `f`, nil where it holds, or the allocator's refusal as OUTSIDE's opposite
#[testing]
fun found(a: *allocator.Allocator, f: *Function) str {
    val res_kept: res[opt[Finding], allocator.Error] = check(a, f);
    if (sel res_kept.err)     { ret "no storage"; }
    if (sel res_kept.ok.none) { ret nil; }
    ret res_kept.ok.some.what;
}

test lifetime__access_before_begin_in_another_block {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:  Function = shaped(?a, 2);
    var to: [1]u32   = [1]u32{1};
    jump(?f, 0, Slice[u32]{data: ?to[0], size: 1});
    touch(?f, 1);
    mark(?f, 1, true);
    mark(?f, 1, false);
    if (found(?a, ?f) != OUTSIDE) { ret 1; }
}

test lifetime__access_after_end_in_another_block {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:  Function = shaped(?a, 2);
    var to: [1]u32   = [1]u32{1};
    mark(?f, 0, true);
    mark(?f, 0, false);
    jump(?f, 0, Slice[u32]{data: ?to[0], size: 1});
    touch(?f, 1);
    if (found(?a, ?f) != OUTSIDE) { ret 1; }
}

test lifetime__begun_on_one_path_of_two {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:    Function = shaped(?a, 4);
    var both: [2]u32   = [2]u32{1, 2};
    var join: [1]u32   = [1]u32{3};
    jump(?f, 0, Slice[u32]{data: ?both[0], size: 2});
    mark(?f, 1, true);
    jump(?f, 1, Slice[u32]{data: ?join[0], size: 1});
    jump(?f, 2, Slice[u32]{data: ?join[0], size: 1});
    touch(?f, 3);
    if (found(?a, ?f) != OUTSIDE) { ret 1; }
}

test lifetime__ended_across_the_back_edge {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:    Function = shaped(?a, 4);
    var head: [1]u32   = [1]u32{1};
    var out:  [2]u32   = [2]u32{2, 3};
    mark(?f, 0, true);
    jump(?f, 0, Slice[u32]{data: ?head[0], size: 1});
    touch(?f, 1);
    jump(?f, 1, Slice[u32]{data: ?out[0], size: 2});
    mark(?f, 2, false);
    jump(?f, 2, Slice[u32]{data: ?head[0], size: 1});
    if (found(?a, ?f) != OUTSIDE) { ret 1; }
}

test lifetime__begun_twice_across_blocks {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:  Function = shaped(?a, 2);
    var to: [1]u32   = [1]u32{1};
    moved(?f, 0);
    mark(?f, 0, true);
    jump(?f, 0, Slice[u32]{data: ?to[0], size: 1});
    mark(?f, 1, true);
    if (found(?a, ?f) != BEGUN) { ret 1; }
}

test lifetime__access_inside_across_blocks {
    var a:    allocator.Allocator;
    val made: err[allocator.Error] = page.make(?a);
    if (sel made.err) { ret 77; }
    var f:  Function = shaped(?a, 2);
    var to: [1]u32   = [1]u32{1};
    mark(?f, 0, true);
    jump(?f, 0, Slice[u32]{data: ?to[0], size: 1});
    touch(?f, 1);
    mark(?f, 1, false);
    if (found(?a, ?f) != nil) { ret 1; }
}
