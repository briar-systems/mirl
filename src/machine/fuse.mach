# the fusing of two adjacent instructions into one once registers are allocated
#
# three rewritings, each of two instructions next to each other in a block,
# as the set's rows state them (`isa.Testing`, `isa.Joining`, `isa.Clearing`):
#
# a test of a register against itself right after a row a testing names
# whose result is that register, at the width the testing's test reads, is
# dropped. the testing states the flags the row leaves as the test would, and
# the test goes only where every other flag it leaves defined is dead after
# it, and where masc's footprint of the row leaves each of those it states
# defined, so a flag the test would set and the row sets otherwise, as the
# carry x86's add sets and test clears, is read by nothing before it is
# written again.
#
# a copy of one register into another and the row after it that reads and
# writes the copy's destination, a joining naming both rows, become the
# joining's row of the destination and an address of the copy's source plus
# the other operand of the second row, a register or the immediate, negated
# where the joining says, in the class the joining names for addresses. the
# precondition: the second row's destination is the copy's, its other operand
# is not the copy's destination nor a register sharing its number, as the
# copy wrote it, and an immediate negated still fits, and every location the
# two rows and the joined row leave unlike each other is dead after the
# second (`mirl.machine.dead`), as the flags x86's add writes and lea does
# not. the joining states that the joined row leaves the destination as the
# two do.
#
# a whole write of a register and the row after it that merges into the
# register, a clearing naming both rows, become the clearing's row of that
# register at both operands and the merge. the precondition: the merge's
# operand 0 names the register the write wrote, no other operand of it names
# a register sharing storage with that one, so the merge reads the register
# only where it keeps bits, and every location the write and the clearing
# row leave unlike each other is dead after the merge, which the scan from
# the write asks of the merge too. the clearing states that the two leave
# the register itself unlike only in bits the merge writes, so it holds the
# same after the merge either way.
#
# the compilation hands no joinings for a function that requires constant
# time, whose walk refuses an address formed from a secret, as lea's, where
# it takes the add the joining replaces. its walk reads a register xored with
# itself as public zero, as the write a clearing replaces is public where its
# source is, so clearings stand there too.
#
# tests go first, so a test that would keep an add's flags live is gone
# before the add is asked of. dropping either instruction writes less, and a
# write is dropped only where what it wrote is dead, so no rewriting makes a
# location live that an earlier one, of this stage or the zeroing stage,
# found dead. a clearing writes what the write did and drops a read, so it
# changes no verdict. this runs after the zeroing stage and before layout, where
# every location is assigned. a value binding record before a dropped
# instruction stands before the one now in its place.
#
# nothing here names a set: the rows are the set's, read as data.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.machine.class.Physical;
use mirl.machine.dead;
use mirl.machine.dead.Scan;
use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.isa.Clearing;
use mirl.machine.isa.Clearings;
use mirl.machine.isa.Joining;
use mirl.machine.isa.Joinings;
use mirl.machine.isa.Testing;
use mirl.machine.isa.Testings;
use mirl.machine.operand.Address;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Partner;
use mirl.machine.operand.Register;
use mirl.machine.operand.Symbol;

use masc.core.footprint;
use mo:         masc.core.operand;
use rf:         masc.core.register;
use core_state: masc.core.state;

# no register, an id masc's register file never gives
val NO_REGISTER: rf.Id = 0;

# the register operand `o` names whole, a tie of one register to itself included, NO_REGISTER for any other
fun register_of(o: Operand) rf.Id {
    if (sel o.physical) {
        val p: Physical = o.physical;
        if (sel p.register) { ret p.register; }
        ret NO_REGISTER;
    }
    if (!(sel o.tied)) { ret NO_REGISTER; }
    val dest:   Register = o.tied.dest;
    val source: Register = o.tied.source;
    if (!(sel dest.physical))   { ret NO_REGISTER; }
    if (!(sel source.physical)) { ret NO_REGISTER; }
    val written: Physical = dest.physical;
    val read:    Physical = source.physical;
    if (!(sel written.register))           { ret NO_REGISTER; }
    if (!(sel read.register))              { ret NO_REGISTER; }
    if (written.register != read.register) { ret NO_REGISTER; }
    ret written.register;
}

# fuse the adjacent instructions of function `f` the set's testings, joinings and clearings name, where nothing live
# is left unlike them
# ---
# a:   the allocator the rewriting takes and gives back
# f:   the allocated, framed function, its copies lowered and loops expanded, not yet laid out
# ctx: the context masc's footprints are asked under
# ts:  the set's testings
# js:  the set's joinings
# cs:  the set's clearings
# ret: ok, or the allocator's refusal, the function then holding the instructions fused so far
pub fun fuse(a: *allocator.Allocator, f: *Function, ctx: *core_state.Context, ts: Testings, js: Joinings, cs: Clearings) err[allocator.Error] {
    if ((ts.len == 0 && js.len == 0 && cs.len == 0) || function.file(f) == nil) { ret err[allocator.Error].ok{}; }
    val res_scan: res[Scan, allocator.Error] = dead.init(a, f, ctx);
    if (sel res_scan.err) { ret err[allocator.Error].err{res_scan.err}; }
    var x: Scan = res_scan.ok;
    fin { dead.dnit(?x); }
    var b: usize = 0;
    for (b < f.blocks.len) {
        var k: usize = 1;
        for (k < function.instructions(f, b::Block).size) {
            val res_dropped: res[bool, allocator.Error] = tested(?x, ts, b::Block, k);
            if (sel res_dropped.err) { ret err[allocator.Error].err{res_dropped.err}; }
            if (!res_dropped.ok)     { k = k + 1; }
        }
        k = 1;
        for (k < function.instructions(f, b::Block).size) {
            val res_joined: res[bool, allocator.Error] = joined(?x, js, b::Block, k);
            if (sel res_joined.err) { ret err[allocator.Error].err{res_joined.err}; }
            if (!res_joined.ok)     { k = k + 1; }
        }
        k = 1;
        for (k < function.instructions(f, b::Block).size) {
            val err_cleared: err[allocator.Error] = cleared(?x, cs, b::Block, k);
            if (sel err_cleared.err) { ret err_cleared; }
            k = k + 1;
        }
        b = b + 1;
    }
    ret err[allocator.Error].ok{};
}

# the testing of `ts` whose row is `before`'s and whose test is `test`'s, none for none
fun testing_of(ts: Testings, before: *InstructionData, test: *InstructionData) opt[*Testing] {
    val bop: Opcode = before.opcode;
    val top: Opcode = test.opcode;
    if (!(sel bop.row)) { ret opt[*Testing].none{}; }
    if (!(sel top.row)) { ret opt[*Testing].none{}; }
    var i: u32 = 0;
    for (i < ts.len) {
        if (ts.at[i].row == bop.row && ts.at[i].test == top.row) { ret opt[*Testing].some{?ts.at[i]}; }
        i = i + 1;
    }
    ret opt[*Testing].none{};
}

# drop the test at position `k` of block `b` where the instruction before it is a testing's row of the register it
# tests and nothing live is left unlike it, whether it was
fun tested(x: *Scan, ts: Testings, b: Block, k: usize) res[bool, allocator.Error] {
    val list:        Slice[Instruction] = function.instructions(x.f, b);
    val before:      *InstructionData   = function.data(x.f, list.data[k - 1]);
    val test:        *InstructionData   = function.data(x.f, list.data[k]);
    val opt_testing: opt[*Testing]      = testing_of(ts, before, test);
    if (sel opt_testing.none)                                                      { ret res[bool, allocator.Error].ok{false}; }
    if (test.operands.size != 2 || before.operands.size < 1 || k + 1 >= list.size) { ret res[bool, allocator.Error].ok{false}; }
    val result: rf.Id = register_of(before.operands.data[0]);
    if (result == NO_REGISTER)                                                                        { ret res[bool, allocator.Error].ok{false}; }
    if (register_of(test.operands.data[0]) != result || register_of(test.operands.data[1]) != result) { ret res[bool, allocator.Error].ok{false}; }
    val t:   *Testing = opt_testing.some;
    val bop: Opcode   = before.opcode;
    if (!(sel bop.row)) { ret res[bool, allocator.Error].ok{false}; }
    dead.clear(x);
    val res_row: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, bop.row, before.operands, before.state);
    if (sel res_row.err)     { ret res[bool, allocator.Error].err{res_row.err}; }
    if (sel res_row.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    val row_fp: *footprint.Footprint = res_row.ok.some;
    var i:      usize                = 0;
    for (i < t.same.size) {
        if (!leaves_defined(row_fp, t.same.data[i])) { ret res[bool, allocator.Error].ok{false}; }
        i = i + 1;
    }
    val top: Opcode = test.opcode;
    if (!(sel top.row)) { ret res[bool, allocator.Error].ok{false}; }
    val res_test: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, top.row, test.operands, test.state);
    if (sel res_test.err)     { ret res[bool, allocator.Error].err{res_test.err}; }
    if (sel res_test.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.hold(x);
    dead.defined(x);
    i = 0;
    for (i < t.same.size) {
        dead.remove(x, t.same.data[i]);
        i = i + 1;
    }
    val res_dead: res[bool, allocator.Error] = dead.dead_after(x, b, k);
    if (sel res_dead.err) { ret res_dead; }
    if (!res_dead.ok)     { ret res[bool, allocator.Error].ok{false}; }
    function.detach(x.f, b, k, list.data[k + 1]);
    ret res[bool, allocator.Error].ok{true};
}

# whether footprint `fp` leaves register `reg`, a flag, defined
fun leaves_defined(fp: *footprint.Footprint, reg: rf.Id) bool {
    val opt_index_of: opt[u32] = rf.index_of(fp.file, reg);
    if (sel opt_index_of.none) { ret false; }
    val at:  u32 = opt_index_of.some;
    val bit: u64 = 1::u64 << (at % 64)::u64;
    ret (fp.written.data[at / 64] & bit) != 0 && (fp.clobbers.data[at / 64] & bit) == 0;
}

# the joining of `js` whose copy is `copy`'s row and whose second row is `tied`'s, none for none
fun joining_of(js: Joinings, copy: *InstructionData, tied: *InstructionData) opt[*Joining] {
    val cop: Opcode = copy.opcode;
    val top: Opcode = tied.opcode;
    if (!(sel cop.row)) { ret opt[*Joining].none{}; }
    if (!(sel top.row)) { ret opt[*Joining].none{}; }
    var i: u32 = 0;
    for (i < js.len) {
        if (js.at[i].copy == cop.row && js.at[i].tied == top.row) { ret opt[*Joining].some{?js.at[i]}; }
        i = i + 1;
    }
    ret opt[*Joining].none{};
}

# the register of class `class` of the number register `reg` has, as a register in an address
fun addressing(class: u16, reg: rf.Id) Register {
    ret Register.physical{Physical.register{rf.make(class, rf.number_of(reg))}};
}

# the address of base register `base` plus index `index`, unscaled, plus `disp`
fun sum(base: Register, index: opt[Register], disp: i64) Address {
    ret Address{base: opt[Register].some{base}, index: index, segment: opt[Register].none{}, scale: 0, disp: disp, symbol: opt[Symbol].none{}, partner: opt[Partner].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0};
}

# whether the joined row of joining `j` stands with operands `given` where instruction `tied` is, the sum's two
# registers standing at whichever of base and index masc's address admits them
fun stands(f: *Function, j: *Joining, given: Slice[Operand], tied: *InstructionData) bool {
    val err_checked: err[instruction.Error] = function.check(f, Opcode.row{j.joined}, given, tied.state);
    ret sel err_checked.ok;
}

# join the copy at position `k - 1` of block `b` and the row at `k` into the joining's row where nothing live is left
# unlike them, whether they were
fun joined(x: *Scan, js: Joinings, b: Block, k: usize) res[bool, allocator.Error] {
    val list:        Slice[Instruction] = function.instructions(x.f, b);
    val copy:        *InstructionData   = function.data(x.f, list.data[k - 1]);
    val tied:        *InstructionData   = function.data(x.f, list.data[k]);
    val opt_joining: opt[*Joining]      = joining_of(js, copy, tied);
    if (sel opt_joining.none)                               { ret res[bool, allocator.Error].ok{false}; }
    if (copy.operands.size != 2 || tied.operands.size != 2) { ret res[bool, allocator.Error].ok{false}; }
    val j:    *Joining = opt_joining.some;
    val into: rf.Id    = register_of(copy.operands.data[0]);
    val from: rf.Id    = register_of(copy.operands.data[1]);
    val dest: rf.Id    = register_of(tied.operands.data[0]);
    if (into == NO_REGISTER || from == NO_REGISTER || dest == NO_REGISTER) { ret res[bool, allocator.Error].ok{false}; }
    if (rf.number_of(dest) != rf.number_of(into))                          { ret res[bool, allocator.Error].ok{false}; }
    if (rf.number_of(into) == rf.number_of(from))                          { ret res[bool, allocator.Error].ok{false}; }
    val other: Operand       = tied.operands.data[1];
    val base:  Register      = addressing(j.address, from);
    var index: opt[Register] = opt[Register].none{};
    var disp:  i64           = 0;
    if (sel other.immediate) {
        disp = other.immediate;
        if (j.negated) {
            if (disp == -0x80000000) { ret res[bool, allocator.Error].ok{false}; }
            disp = 0 - disp;
        }
    }
    or {
        val added: rf.Id = register_of(other);
        if (added == NO_REGISTER || j.negated)         { ret res[bool, allocator.Error].ok{false}; }
        if (rf.number_of(added) == rf.number_of(into)) { ret res[bool, allocator.Error].ok{false}; }
        index = opt[Register].some{addressing(j.address, added)};
    }
    var ops:   [2]Operand     = [2]Operand{Operand.physical{Physical.register{dest}}, Operand.address{sum(base, index, disp)}};
    val given: Slice[Operand] = Slice[Operand]{data: ?ops[0], size: 2};
    if (!stands(x.f, j, given, tied)) {
        if (!(sel index.some)) { ret res[bool, allocator.Error].ok{false}; }
        ops[1] = Operand.address{sum(index.some, opt[Register].some{base}, disp)};
        if (!stands(x.f, j, given, tied)) { ret res[bool, allocator.Error].ok{false}; }
    }
    dead.clear(x);
    val res_copy: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, j.copy, copy.operands, copy.state);
    if (sel res_copy.err)     { ret res[bool, allocator.Error].err{res_copy.err}; }
    if (sel res_copy.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.hold(x);
    val res_tied: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, j.tied, tied.operands, tied.state);
    if (sel res_tied.err)     { ret res[bool, allocator.Error].err{res_tied.err}; }
    if (sel res_tied.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.hold(x);
    val res_joined: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, j.joined, given, tied.state);
    if (sel res_joined.err)     { ret res[bool, allocator.Error].err{res_joined.err}; }
    if (sel res_joined.ok.none) { ret res[bool, allocator.Error].ok{false}; }
    dead.changed(x);
    val res_dead: res[bool, allocator.Error] = dead.dead_after(x, b, k);
    if (sel res_dead.err) { ret res_dead; }
    if (!res_dead.ok)     { ret res[bool, allocator.Error].ok{false}; }
    val at: Instruction = list.data[k];
    function.replace(x.f, at, Opcode.row{j.joined}, given);
    function.detach(x.f, b, k - 1, at);
    ret res[bool, allocator.Error].ok{true};
}

# the clearing of `cs` whose write is `write`'s row and whose merge is `merge`'s, none for none
fun clearing_of(cs: Clearings, write: *InstructionData, merge: *InstructionData) opt[*Clearing] {
    val wop: Opcode = write.opcode;
    val mop: Opcode = merge.opcode;
    if (!(sel wop.row)) { ret opt[*Clearing].none{}; }
    if (!(sel mop.row)) { ret opt[*Clearing].none{}; }
    var i: u32 = 0;
    for (i < cs.len) {
        if (cs.at[i].write == wop.row && cs.at[i].merge == mop.row) { ret opt[*Clearing].some{?cs.at[i]}; }
        i = i + 1;
    }
    ret opt[*Clearing].none{};
}

# whether an operand of `d` past operand 0 names a register sharing storage with register `reg`
fun reads_beside(x: *Scan, d: *InstructionData, reg: *rf.Register) bool {
    var i: usize = 1;
    for (i < d.operands.size) {
        val o: Operand = d.operands.data[i];
        if (sel o.address) { ret true; }
        val other: rf.Id = register_of(o);
        if (other == NO_REGISTER && !(sel o.immediate)) { ret true; }
        if (other != NO_REGISTER) {
            val opt_row_of: opt[*rf.Register] = rf.row_of(x.file, other);
            if (sel opt_row_of.none)                      { ret true; }
            if (rf.overlap(x.file, reg, opt_row_of.some)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# write the whole write at position `k - 1` of block `b` as its clearing's row where the merge at `k` reads the
# register at operand 0 alone and nothing live is left unlike the two
fun cleared(x: *Scan, cs: Clearings, b: Block, k: usize) err[allocator.Error] {
    val list:         Slice[Instruction] = function.instructions(x.f, b);
    val write:        *InstructionData   = function.data(x.f, list.data[k - 1]);
    val merge:        *InstructionData   = function.data(x.f, list.data[k]);
    val opt_clearing: opt[*Clearing]     = clearing_of(cs, write, merge);
    if (sel opt_clearing.none)                              { ret err[allocator.Error].ok{}; }
    if (write.operands.size < 1 || merge.operands.size < 1) { ret err[allocator.Error].ok{}; }
    val into: rf.Id = register_of(write.operands.data[0]);
    if (into == NO_REGISTER || register_of(merge.operands.data[0]) != into) { ret err[allocator.Error].ok{}; }
    val opt_row_of: opt[*rf.Register] = rf.row_of(x.file, into);
    if (sel opt_row_of.none)                     { ret err[allocator.Error].ok{}; }
    if (reads_beside(x, merge, opt_row_of.some)) { ret err[allocator.Error].ok{}; }
    val c: *Clearing = opt_clearing.some;
    dead.clear(x);
    val res_write: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, c.write, write.operands, write.state);
    if (sel res_write.err)     { ret err[allocator.Error].err{res_write.err}; }
    if (sel res_write.ok.none) { ret err[allocator.Error].ok{}; }
    dead.hold(x);
    var ops:       [2]Operand                                      = [2]Operand{Operand.physical{Physical.register{into}}, Operand.physical{Physical.register{into}}};
    val given:     Slice[Operand]                                  = Slice[Operand]{data: ?ops[0], size: 2};
    val res_clear: res[opt[*footprint.Footprint], allocator.Error] = dead.asked(x, c.clear, given, write.state);
    if (sel res_clear.err)     { ret err[allocator.Error].err{res_clear.err}; }
    if (sel res_clear.ok.none) { ret err[allocator.Error].ok{}; }
    dead.changed(x);
    val res_dead: res[bool, allocator.Error] = dead.dead_after(x, b, k - 1);
    if (sel res_dead.err) { ret err[allocator.Error].err{res_dead.err}; }
    if (!res_dead.ok)     { ret err[allocator.Error].ok{}; }
    function.replace(x.f, list.data[k - 1], Opcode.row{c.clear}, given);
    ret err[allocator.Error].ok{};
}
