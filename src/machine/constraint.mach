# the register constraints of an instruction's row, asked of its operand values
#
# masc states each row's constraints, as an output kept apart from an input
# or a register group kept off a mask register, and answers them through
# constraint.violated. this is the one place mirl asks it, and mirl states no
# constraint of its own. every choice of a location for an operand asks here
# and treats a breach as a conflict for that choice: the allocator's
# assignment and eviction, the free location copy lowering moves through or
# saves into, and the scratch the frame code builds in. the allocation
# checker asks it again of every rewritten instruction.
#
# how many registers an operand's group covers can depend on vector state no
# operand holds, as risc-v's vtype decides it. an instruction with no operand
# of a vector class is one register a group, the unit grouping. any other
# takes masc's grouping of its row, under the vtype it states or under no
# state when it states none, as a whole register load's groups no vtype
# decides, so mirl restates no element width and no group length. a row
# whose groups turn on a state the instruction does not state is refused by
# type, never read as one register a group.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Instruction;

use mc:   masc.core.constraint;
use mo:   masc.core.operand;
use rf:   masc.core.register;
use rows: masc.core.row;

# why an instruction's operand values do not stand against its row's constraints
# ---
# broken:      a constraint the values break
# outside:     an operand one of whose groups runs past the last register of
#              its class or starts off its alignment
# inexact:     a constraint whose answer turns on an element width the
#              grouping does not state, which names the constraint and its
#              sides, where the state no operand holds decides whether the
#              form is reserved
# needs:       an operand whose groups turn on a vtype the instruction does
#              not state, which the checker refuses when it is made
# reserved:    an operand whose groups the instruction's vtype cannot form, as
#              a widening destination under lmul 8
# unencodable: the instruction's vtype has no encoding, so no group is formed
#              under it
pub tag Breach: u8 {
    broken:   *mc.Constraint;
    outside:  u32;
    inexact:  *mc.Constraint;
    needs:    u32;
    reserved: u32;
    unencodable;
}

# an instruction and its breach
# ---
# instruction: the instruction
# breach:      why its operand values do not stand
pub rec Constrained {
    instruction: Instruction;
    breach:      Breach;
}

# how many registers each operand's groups cover in instruction `d`: the unit
# grouping when no operand of its row is of a vector class, else masc's
# grouping of its row under the vtype it states or none, or why there is none
pub fun grouping_of(f: *Function, d: *InstructionData) res[mc.Grouping, Breach] {
    val op: Opcode = d.opcode;
    if (sel op.pseudo) { ret res[mc.Grouping, Breach].ok{mc.UNIT}; }
    val vector: opt[u32] = instruction.first_vector(function.file(f), op);
    if (sel vector.none) { ret res[mc.Grouping, Breach].ok{mc.UNIT}; }
    val g: mc.Grouped = instruction.grouping(op.row, d.vtype);
    if (sel g.grouping) { ret res[mc.Grouping, Breach].ok{g.grouping}; }
    if (sel g.reserved) { ret res[mc.Grouping, Breach].err{Breach.reserved{g.reserved::u32}}; }
    if (sel g.needs)    { ret res[mc.Grouping, Breach].err{Breach.needs{g.needs::u32}}; }
    ret res[mc.Grouping, Breach].err{Breach.unencodable{}};
}

# how many registers of its class one value of operand `at` of an instruction
# of opcode `op` covers under grouping `g`: its fields back to back, each a
# group of the registers `g` states, one for a group within one register
pub fun covers(op: Opcode, g: mc.Grouping, at: u32) u32 {
    if (sel op.pseudo)             { ret 1; }
    if (at >= op.row.operands.len) { ret 1; }
    val sh:     *mo.Shape = ?op.row.operands.at[at].shape;
    var fields: u32       = 1;
    if (sel sh.register)                 { fields = sh.register.fields::u32; }
    or (sel sh.list)                     { fields = sh.list.member.fields::u32; }
    if (at < g.len && g.lengths[at] > 0) { ret fields << g.lengths[at]::u32; }
    ret fields;
}

# whether instruction `d` has anything to ask: a constraint, a group whose
# length its grouping states, or no grouping at all
pub fun asks(f: *Function, d: *InstructionData) bool {
    if (sel d.opcode.pseudo) { ret false; }
    val g: res[mc.Grouping, Breach] = grouping_of(f, d);
    if (sel g.err) { ret true; }
    ret d.opcode.row.constraints.len != 0 || g.ok.len != 0;
}

# what instruction `d` holding `values` finds of its row's constraints and
# its grouping, none when they stand
pub fun ask(f: *Function, d: *InstructionData, values: mo.Values) opt[Breach] {
    if (sel d.opcode.pseudo) { ret opt[Breach].none{}; }
    val g: res[mc.Grouping, Breach] = grouping_of(f, d);
    if (sel g.err) { ret opt[Breach].some{g.err}; }
    val r: *rows.Row = d.opcode.row;
    if (r.constraints.len == 0 && g.ok.len == 0) { ret opt[Breach].none{}; }
    val v: mc.Verdict = mc.violated(function.file(f), r.constraints, r.operands.at, r.effect, values, g.ok);
    if (sel v.broken)  { ret opt[Breach].some{Breach.broken{v.broken}}; }
    if (sel v.outside) { ret opt[Breach].some{Breach.outside{v.outside::u32}}; }
    if (sel v.inexact) { ret opt[Breach].some{Breach.inexact{v.inexact}}; }
    ret opt[Breach].none{};
}

# what instruction `d` finds of its row's constraints and its grouping with
# its own operands, each the value instruction.values_of reads, none when
# they stand
pub fun stands(f: *Function, d: *InstructionData) opt[Breach] {
    if (sel d.opcode.pseudo) { ret opt[Breach].none{}; }
    var values: [rows.MAX_OPERANDS]mo.Value;
    ret ask(f, d, instruction.values_of(d.opcode.row, d.operands, ?values[0]));
}
