# the register constraints of an instruction's row, asked of its operand values
#
# masc states each row's constraints, as an output kept apart from an input
# or a register group kept off a mask register, and answers them through
# constraint.violated. this is the one place mirl asks it, and mirl states no
# constraint of its own. every choice of a location for an operand asks here
# and treats a breach as a conflict for that choice: the allocator's
# assignment and eviction, the free location copy lowering moves through or
# saves into, and the scratch the frame code builds in. the allocation
# checker asks it again of every rewritten instruction. a loop is asked of
# each of its steps' rows, the step's operands read from the loop's, so a
# loop's operands stand against every row they reach.
#
# how many registers an operand's group covers can depend on configuration
# state no operand holds, as risc-v's vtype decides it. masc's grouping of a
# row answers it under the state the instruction states, the set's hooks
# reading it under the build's context, and under no state when it states
# none, as a whole register load's groups no vtype decides, so mirl restates
# no element width and no group length. a row whose groups turn on a state
# the instruction does not state is refused by type, never read as one
# register a group.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use std.collections.slice.Slice;

use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.InstructionData;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.vstate;

use core_config: masc.core.config;
use mc:          masc.core.constraint;
use masc.core.effect;
use mo:         masc.core.operand;
use rows:       masc.core.row;
use core_state: masc.core.state;

# why an instruction's operand values do not stand against its row's constraints
# ---
# broken:   a constraint the values break
# outside:  an operand one of whose groups runs past the last register of
#           its class or starts off its alignment
# inexact:  a constraint whose answer turns on an element width the
#           grouping does not state, which names the constraint and its
#           sides, where the state no operand holds decides whether the
#           form is reserved
# needs:    an operand whose groups turn on a configuration state the
#           instruction does not state, which the checker refuses when it
#           is made
# reserved: an operand whose groups the instruction's state cannot form, as
#           a widening destination under lmul 8, or a state whose bits
#           encode none
pub tag Breach: u8 {
    broken:   *mc.Constraint;
    outside:  u32;
    inexact:  *mc.Constraint;
    needs:    u32;
    reserved: u32;
}

# an instruction and its breach
# ---
# instruction: the instruction
# breach:      why its operand values do not stand
pub rec Constrained {
    instruction: Instruction;
    breach:      Breach;
}

# how many registers each operand's groups cover in an instruction of row
# `r` that states configuration state `state` under the context `ctx`:
# masc's grouping of the row under the state or none, or why there is none
pub fun grouping_of(f: *Function, ctx: *core_state.Context, r: *rows.Row, state: opt[vstate.State]) res[mc.Grouping, Breach] {
    val g: effect.Answer[mc.Grouping] = core_config.grouping(vstate.configured(f.set, state), r, ctx);
    if (sel g.decided) { ret res[mc.Grouping, Breach].ok{g.decided}; }
    val why: effect.Undecided = g.undecided;
    if (sel why.configured) { ret res[mc.Grouping, Breach].err{Breach.needs{why.configured::u32}}; }
    if (sel why.reserved)   { ret res[mc.Grouping, Breach].err{Breach.reserved{why.reserved::u32}}; }
    ret res[mc.Grouping, Breach].err{Breach.reserved{0}};
}

# whether instruction `d` has anything to ask of a row it stands for, a loop
# of each of its steps' rows: a constraint, a group whose length its grouping
# states, or no grouping at all
pub fun asks(f: *Function, ctx: *core_state.Context, d: *InstructionData) bool {
    var k: u32 = 0;
    for (k < instruction.rows_in(d.opcode)) {
        val r: *rows.Row                = instruction.row_in(d.opcode, k);
        val g: res[mc.Grouping, Breach] = grouping_of(f, ctx, r, d.state);
        if (sel g.err)                               { ret true; }
        if (r.constraints.len != 0 || g.ok.len != 0) { ret true; }
        k = k + 1;
    }
    ret false;
}

# what an instruction of row `r` that states configuration state `state`
# under the context `ctx`, holding `values`, one per operand of the row,
# finds of the row's constraints and its grouping, none when they stand
pub fun ask(f: *Function, ctx: *core_state.Context, r: *rows.Row, state: opt[vstate.State], values: mo.Values) opt[Breach] {
    val g: res[mc.Grouping, Breach] = grouping_of(f, ctx, r, state);
    if (sel g.err)                               { ret opt[Breach].some{g.err}; }
    if (r.constraints.len == 0 && g.ok.len == 0) { ret opt[Breach].none{}; }
    val v: mc.Verdict = mc.violated(function.file(f), r.constraints, r.operands.at, r.effect, values, g.ok);
    if (sel v.broken)  { ret opt[Breach].some{Breach.broken{v.broken}}; }
    if (sel v.outside) { ret opt[Breach].some{Breach.outside{v.outside::u32}}; }
    if (sel v.inexact) { ret opt[Breach].some{Breach.inexact{v.inexact}}; }
    ret opt[Breach].none{};
}

# what instruction `d` finds under the context `ctx` of the constraints and
# grouping of each row it stands for with its own operands, each the value
# instruction.values_of reads, a loop's step's operands read from the
# loop's, none when they stand
pub fun stands(f: *Function, ctx: *core_state.Context, d: *InstructionData) opt[Breach] {
    var k: u32 = 0;
    for (k < instruction.rows_in(d.opcode)) {
        val r:      *rows.Row      = instruction.row_in(d.opcode, k);
        var stated: [rows.MAX_OPERANDS]Operand;
        val given:  Slice[Operand] = instruction.operands_in(d.opcode, k, d.operands, ?stated[0]);
        var values: [rows.MAX_OPERANDS]mo.Value;
        val got:    opt[Breach]    = ask(f, ctx, r, d.state, instruction.values_of(r, given, ?values[0]));
        if (sel got.some) { ret got; }
        k = k + 1;
    }
    ret opt[Breach].none{};
}
