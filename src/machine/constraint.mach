# the register constraints of an instruction's row, asked of its operand values
#
# masc states each row's constraints, as an output kept apart from an input
# or a register group kept off a mask register, and answers them through
# constraint.violated. this is the one place mirl asks it, and mirl states no
# constraint of its own. every choice of a location for an operand asks here
# and treats a breach as a conflict for that choice: the allocator's
# assignment and eviction, the free location copy lowering moves through or
# saves into, and the scratch the frame code builds in. the allocation
# checker asks it again of every rewritten instruction. a loop is asked of
# each of its steps' rows, the step's operands read from the loop's, so a
# loop's operands stand against every row they reach.
#
# how many registers an operand's group covers can depend on vector state no
# operand holds, as risc-v's vtype decides it. the machine form carries no
# vector state, and selection produces no operand of a vector class, since a
# target scalarises its vector operations. so an operand of a class of any
# other kind is one register a group, the unit grouping, and one of a vector
# class is refused by type, its vector state unknown, never read as one
# register.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use std.collections.slice.Slice;

use mirl.machine.function;
use mirl.machine.function.Function;
use mirl.machine.instruction;
use mirl.machine.instruction.Opcode;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;

use mc:   masc.core.constraint;
use mo:   masc.core.operand;
use rf:   masc.core.register;
use rows: masc.core.row;

# why an instruction's operand values do not stand against its row's constraints
# ---
# broken:  a constraint the values break
# outside: an operand one of whose groups runs past the last register of its class
# inexact: a constraint with a gap whose registers the values share, which
#          names the gap and its sides, where the state no operand holds
#          decides whether the form is reserved
# unknown: an operand of a vector class, whose groups depend on vector state
#          the machine form does not carry
pub tag Breach: u8 {
    broken:  *mc.Constraint;
    outside: u32;
    inexact: *mc.Constraint;
    unknown: u32;
}

# an instruction and its breach
# ---
# instruction: the instruction
# breach:      why its operand values do not stand
pub rec Constrained {
    instruction: Instruction;
    breach:      Breach;
}

# whether a class of `classes` is a vector class of `file`
fun vector(file: *rf.File, classes: mo.Classes) bool {
    var i: u32 = 0;
    for (i < classes.len) {
        val c: u16 = classes.at[i];
        if (c::u32 < file.class_count && file.classes[c].kind == rf.VECTOR) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a register an operand of `o`'s shape names may be of a vector class
fun grouped(file: *rf.File, o: *mo.Operand) bool {
    val sh: *mo.Shape = ?o.shape;
    if (sel sh.register) { ret vector(file, sh.register.classes); }
    if (sel sh.list)     { ret vector(file, sh.list.member.classes); }
    if (sel sh.memory)   { ret vector(file, sh.memory.base.classes) || vector(file, sh.memory.index.classes); }
    ret false;
}

# how many registers each operand's groups cover in an instruction of row
# `r`: the unit grouping, or the first operand of a vector class, whose
# groups the machine form states no vector state for
pub fun grouping_of(f: *Function, r: *rows.Row) res[mc.Grouping, u32] {
    val file: *rf.File = function.file(f);
    if (file == nil) { ret res[mc.Grouping, u32].ok{mc.UNIT}; }
    var k: u32 = 0;
    for (k < r.operands.len) {
        if (grouped(file, ?r.operands.at[k])) { ret res[mc.Grouping, u32].err{k}; }
        k = k + 1;
    }
    ret res[mc.Grouping, u32].ok{mc.UNIT};
}

# whether an instruction of opcode `op` has anything to ask of a row it
# stands for, a loop of each of its steps' rows: a constraint, or an operand
# whose groups the machine form states no vector state for
pub fun asks(f: *Function, op: Opcode) bool {
    var k: u32 = 0;
    for (k < instruction.rows_in(op)) {
        val r: *rows.Row             = instruction.row_in(op, k);
        val g: res[mc.Grouping, u32] = grouping_of(f, r);
        if (sel g.err || r.constraints.len != 0) { ret true; }
        k = k + 1;
    }
    ret false;
}

# what an instruction of row `r` holding `values`, one per operand of the
# row, finds of the row's constraints, none when they stand
pub fun ask(f: *Function, r: *rows.Row, values: mo.Values) opt[Breach] {
    val g: res[mc.Grouping, u32] = grouping_of(f, r);
    if (sel g.err)              { ret opt[Breach].some{Breach.unknown{g.err}}; }
    if (r.constraints.len == 0) { ret opt[Breach].none{}; }
    val v: mc.Verdict = mc.violated(function.file(f), r.constraints, r.operands.at, r.effect, values, g.ok);
    if (sel v.broken)  { ret opt[Breach].some{Breach.broken{v.broken}}; }
    if (sel v.outside) { ret opt[Breach].some{Breach.outside{v.outside::u32}}; }
    if (sel v.inexact) { ret opt[Breach].some{Breach.inexact{v.inexact}}; }
    ret opt[Breach].none{};
}

# what an instruction of opcode `op` and operands `operands` finds of the
# constraints of each row it stands for, each operand the value
# instruction.values_of reads, a loop's step's operands read from the
# loop's, none when they stand
pub fun stands(f: *Function, op: Opcode, operands: Slice[Operand]) opt[Breach] {
    var k: u32 = 0;
    for (k < instruction.rows_in(op)) {
        val r:      *rows.Row      = instruction.row_in(op, k);
        var stated: [rows.MAX_OPERANDS]Operand;
        val given:  Slice[Operand] = instruction.operands_in(op, k, operands, ?stated[0]);
        var values: [rows.MAX_OPERANDS]mo.Value;
        val got:    opt[Breach]    = ask(f, r, instruction.values_of(r, given, ?values[0]));
        if (sel got.some) { ret got; }
        k = k + 1;
    }
    ret opt[Breach].none{};
}
