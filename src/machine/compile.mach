# why a module or a function of it was not compiled
# ---
# alloc:      the allocator refused storage
# foreign:    the build given was opened for another target than the one
#             given, and nothing was compiled
# uncarried:  the registry carries no record of the build's instruction set
# locations:  the locations of the target's registers and memories were
#             refused
# table:      the selection table was refused for the target
# moves:      the set's moves were refused for the target
# code:       the frame code was not bound to the target's selection
# emit:       emission refused the laid out functions, naming the function
#             of an instruction it refuses
# walked:     the walk of constant-time functions' encoded code found a
#             secret where one may hold none, could not follow the code, or
#             found a hard function's code needs a timing mode the build
#             does not guarantee, one for each function it refused, in the
#             order emitted
# served:     a vector row the build packs that no rule of the table serves
#             for every value of its operands
# machine:    the machine form text was not printed
# write:      the listing was not written
# select:     selection refused a function
# timing:     the constant-time check found a secret where the function,
#             which requires constant time, may hold none
# effects:    the effects of a selected function's instructions
# pointer:    the frame's need of a pointer, which the allowed set reads
# allowed:    the listing of the locations the allocator may assign
# allocate:   register allocation refused a function
# frame:      the frame refused a function
# copies:     the lowering of copies to the set's moves refused a function
# configure:  the insertion of the instructions establishing the states the
#             instructions run under refused a function
# loops:      the expansion of loops into their steps refused a function
# layout:     block layout refused a function
# ranges:     the reading of where each variable is over the framed code,
#             before layout, refused a function
# verify:     the verifier refused a function after the step
# misplaced:  the step reads a form of the function the steps before it did
#             not leave
# unfinished: the steps ended before the function was laid out
# convention: the function's signature names a convention row its target
#             does not state
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    uncarried;
    locations: location.Error;
    table:     engine.Error;
    moves:     move.Error;
    code:      code.Error;
    emit:      handover.Error;
    walked:    Slice[mct.Error];
    served:    served.Error;
    machine:   print.Error;
    write:     io.WriteError;
    select:    engine.Error;
    timing:    timing.Error;
    effects:   effects.Error;
    pointer:   framing.Error;
    allowed:   allowed.Error;
    allocate:  allocate.Error;
    frame:     finish.Error;
    copies:    lower.Error;
    configure: configure.Error;
    loops:     expand.Error;
    layout:    lay.Error;
    ranges:    range.Error;
    verify:    verify.Error;
    misplaced;
    unfinished;
    convention;
}

# where in a module what refused it stands, beside why
# ---
# function: the function it refused, none for the module as a whole
# step:     the name of the step the function was refused at or after, none
#           when the steps ended before it was laid out or it was refused
#           before them
# location: the source location of the instruction what refused it names,
#           none when it names none or the instruction states none
# error:    what refused it
pub rec Failed {
    function: opt[id.Function];
    step:     opt[str];
    location: opt[Location];
    error:    Error;
}

# a module refused as a whole, the allocator's refusal it stands for lifted to the top
pub fun whole(e: Error) Failed {
    ret Failed{function: opt[id.Function].none{}, step: opt[str].none{}, location: opt[Location].none{}, error: lifted(e)};
}

# what one function's code is made under
# ---
# context:    the build's context, or the one its extensions past the build's open
# moves:      the set's moves indexed under that context
# code:       the frame code bound to that context
# sizes:      the slot each class spills to under that context
# given:      the locations the allocator may give under that context, as
#             `given_all` orders them
# convention: the row its signature names, resolved once by the build, none
#             for a function whose signature names a row its target does not
#             state
pub rec Scope {
    context:    *core_state.Context;
    moves:      *move.Index;
    code:       *code.Admitted;
    sizes:      *spill.Sizes;
    given:      *vector.Vector[Given];
    convention: opt[*Resolved];
}

# a set of extensions functions name past the build's, bound once
# ---
# basis: the build's selection widened by the set, and its context, which
#        the module's table owns
# moves: the set's moves indexed under that context
# code:  the frame code bound to that context
# sizes: the slot each class spills to under that context
# given: the locations the allocator may give under that context, as
#        `given_all` orders them
pub rec Under {
    basis: *Basis;
    moves: move.Index;
    code:  code.Admitted;
    sizes: spill.Sizes;
    given: vector.Vector[Given];
}

# no row of the build, a function whose signature names a row its target
# does not state
val UNROWED: u32 = 0xffffffff;

# what a build opens of its target once, before any module, which every
# session over the build reads and none writes: the state of the register
# family's build, held in the build
# ---
# a:     the allocator its storage came from, which gives it back
# build: the target's build, which the register family opened
# isas:  the registry the family handed in, which the machine text reads too
# isa:   the record of the build's instruction set in it
# at:    the locations of the machine's registers and the target's memories
# index: the record's selection table, checked against the schema
# moves: the set's moves over the locations
# code:  the record's frame code bound to the machine's selection
# sizes: the slot each class spills to under the build's context
# given: the locations the allocator may give under the build's context, as
#        `given_all` orders them
# words: the words of a mask over the register rows
# owned: for each of the build's rows in order, the mask of `words` words of
#        the register rows a call under that row clobbers
# spare: for each of the build's rows in order, the registers its prologue
#        and epilogues may overwrite
pub rec State {
    a:     *allocator.Allocator;
    build: *Build;
    isas:  *Isas;
    isa:   *Isa;
    at:    Locations;
    index: Index;
    moves: move.Index;
    code:  code.Admitted;
    sizes: spill.Sizes;
    given: vector.Vector[Given];
    words: u32;
    owned: vector.Vector[u64];
    spare: Lists[rf.Id];
}

# what a compilation opens of one module, before any function
# ---
# p:      what the build opened of its target, which outlives the session
# s:      the selector over the build's index
# w:      the module's table of the selection each function stands on
# unders: per set of the table, in its order, what the set binds
# rows:   per function of the module, the index in the build's conventions
#         of the row its signature names, UNROWED for none
pub rec Session {
    p:      *State;
    s:      Selector;
    w:      *Widenings;
    unders: vector.Vector[*Under];
    rows:   vector.Vector[u32];
}

# what every step reads
# ---
# a:         the allocator every step takes
# m:         the module
# x:         the session of its target
# checked:   whether every function is verified after every step, every
#            allocation proved and every machine instruction checked as it is
#            appended
# stats:     where the steps add their time and counts, none for none
# scratch:   the storage every allocation of the module works in
# optimized: whether the compilation optimises, which drops the copies an
#            allocation finds carry nothing, splits a value only read in a
#            loop at it and shares the frame slots whose lives never meet
pub rec Context {
    a:         *allocator.Allocator;
    m:         *Module;
    x:         *Session;
    checked:   bool;
    stats:     opt[*Stats];
    scratch:   *allocate.Scratch;
    optimized: bool;
}

# a function allocated, with what its allocation read
# ---
# chosen:     the selected function and the clobbers of its calls
# effects:    the effects of the selected function's instructions, which an
#             allocation made again reads
# facts:      what the frame reads of the selected function, which it reads
#             of the allocation too
# given:      the locations the allocator was allowed and their pool, which
#             the frame and the lowering of copies read again, the build's
#             or its set's
# allocation: the allocated function
pub rec Allocated {
    chosen:     Selected;
    effects:    Effects;
    facts:      Facts;
    given:      *Given;
    allocation: Allocation;
}

# a function framed, with the locations its allocation was allowed and their
# pool
pub rec Framing {
    given:  *Given;
    framed: Framed;
}

# a function framed and laid out, waiting for emission
# ---
# function: the function of the module it is the code of
# context:  the context its code was made under, which it is handed over and
#           walked under
# framed:   the framed function, laid out
# laid:     the order its blocks are emitted in
# ranges:   where each of its variables is over its code
pub rec Done {
    function: id.Function;
    context:  *core_state.Context;
    framed:   Framed;
    laid:     Laid;
    ranges:   Ranges;
}

# the form a function is in between steps
# ---
# source:    the ir, nothing made yet
# selected:  selected
# allocated: allocated
# framed:    framed, then with its copies lowered and its loops expanded
# laid:      laid out
pub tag Form: u8 {
    source;
    selected:  Selected;
    allocated: Allocated;
    framed:    Framing;
    laid:      Done;
}

# a function partway through the steps, which owns what its form holds
pub rec Work {
    function: id.Function;
    form:     Form;
}

# a step, which reads the form the steps before it left and gives the one it
# leaves, or refuses and leaves the form as it found it
pub def Run: fun(*Context, *Work) res[Form, Error];

# a step of the sequence
# ---
# name:  what the step is called, which a refusal names
# run:   the step
# stage: the stage of the stats its time adds to
pub rec Step {
    name:  str;
    run:   Run;
    stage: stats.Stage;
}

# give back what a function's form holds and leave it as the ir
pub fun dnit(w: *Work) {
    if (sel w.form.selected) { engine.selected_dnit(?w.form.selected); }
    or (sel w.form.allocated) {
        allocate.dnit(?w.form.allocated.allocation);
        effects.dnit(?w.form.allocated.effects);
        scan.dnit(?w.form.allocated.facts);
        engine.selected_dnit(?w.form.allocated.chosen);
    }
    or (sel w.form.framed) {
        record.dnit(?w.form.framed.framed);
    }
    or (sel w.form.laid) { done_dnit(?w.form.laid); }
    w.form = Form.source{};
}

# give back a laid out function
pub fun done_dnit(d: *Done) {
    record.dnit(?d.framed);
    lay.dnit(?d.laid);
    range.dnit(?d.ranges);
}

# what a function's code is made under: the build's context, moves and frame
# code, or those of the set of extensions it names past the build's, and the
# convention row its signature names
pub fun scope(x: *Session, f: id.Function) Scope {
    var opt_under: opt[*Resolved] = opt[*Resolved].none{};
    if (f::usize < x.rows.len && x.rows.data[f] != UNROWED) { opt_under = opt[*Resolved].some{?x.p.build.conventions.data[x.rows.data[f]]}; }
    val at: u32 = widening.index_of(x.w, f);
    if (at == widening.BUILD_WIDE) { ret Scope{context: build_record.registers(x.p.build).context, moves: ?x.p.moves, code: ?x.p.code, sizes: ?x.p.sizes, given: ?x.p.given, convention: opt_under}; }
    val u: *Under = x.unders.data[at];
    ret Scope{context: ?u.basis.context, moves: ?u.moves, code: ?u.code, sizes: ?u.sizes, given: ?u.given, convention: opt_under};
}

# the index in the build's rows of the row a function is made under, the
# default row's for one whose signature names none
fun row_index(x: *Session, f: id.Function) usize {
    if (f::usize < x.rows.len && x.rows.data[f] != UNROWED) { ret x.rows.data[f]::usize; }
    ret 0;
}

# the locations a function may be given, under the set it is made under and
# the row it is made under, past the frame pointer where `keeps`, and those of
# a constant-time function where `timed`
fun given_of(x: *Session, f: id.Function, keeps: bool, based: bool, timed: bool) *Given {
    var at: usize = row_index(x, f) * 6;
    if (based) { at = at + 2; }
    or (keeps) { at = at + 1; }
    if (timed) { at = at + 3; }
    ret ?scope(x, f).given.data[at];
}

# the preserved registers of the row `row` the frame code `frame_code` cannot save in constant time under the
# context a constant-time function's rows are asked under (`code.saves_untimed`), sorted, as a register machine
# under the context `ctx` saves them
fun unsaved_of(a: *allocator.Allocator, frame_code: *code.Admitted, ctx: *core_state.Context, row: *Resolved, out: *vector.Vector[rf.Id]) err[allocator.Error] {
    val regs: *Registers = convention.held(row);
    if (regs == nil || ctx.view.file == nil) { ret err[allocator.Error].ok{}; }
    var asked: mct.Timed = mct.plain(ctx);
    fin { mct.dnit(?asked); }
    val err_assumed: err[allocator.Error] = mct.assume(a, ctx, ?asked);
    if (sel err_assumed.err) { ret err_assumed; }
    var k: usize = 0;
    for (k < regs.preserved.size) {
        val reg: rf.Id = regs.preserved.data[k];
        k = k + 1;
        val opt_size: opt[record.Offset] = framing.saved_size(ctx.view, row.row, reg);
        if (sel opt_size.none)                                                  { cnt; }
        if (code.saves_untimed(frame_code, ?asked.context, reg, opt_size.some)) { cnt; }
        val res_pushed: res[usize, allocator.Error] = vector.push[rf.Id](out, reg);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    ret err[allocator.Error].ok{};
}

# each register row no operand names whose value the timing of a row of the set `set` still depends on under the
# context a constant-time function's rows are asked under, past the condition that makes the row's timing hold, and
# that the row does not surely read, as zvkt leaves every vector row depending on the mask v0 that an unmasked one
# never reads, into `out` unsorted. a register the row surely reads is one the walk asks of the row itself, as x86's
# rcx of a repeated string row
fun kept_of(a: *allocator.Allocator, set: *mset.Set, ctx: *core_state.Context, out: *vector.Vector[rf.Id]) err[allocator.Error] {
    val file: *rf.File = ctx.view.file;
    if (file == nil) { ret err[allocator.Error].ok{}; }
    var asked: mct.Timed = mct.plain(ctx);
    fin { mct.dnit(?asked); }
    val err_assumed: err[allocator.Error] = mct.assume(a, ctx, ?asked);
    if (sel err_assumed.err) { ret err_assumed; }
    var words: vector.Vector[u64] = vector.init[u64](a);
    fin { vector.dnit[u64](?words); }
    var i: u32 = 0;
    for (i < set.codec.rows.len) {
        val row: *rows.Row = ?set.codec.rows.at[i];
        val c:   *ct.Class = row.ct;
        i = i + 1;
        if (c == nil)                                                    { cnt; }
        if (!(sel c.conditional))                                        { cnt; }
        if (!core_state.admits(?asked.context, c.conditional.condition)) { cnt; }
        val regs: ct.Registers = c.conditional.remaining.implicit;
        if (!(sel regs.only)) { cnt; }
        var surely: effect.Set = effect.NO_WORDS;
        if (row.effect != nil) {
            val touched: effect.Registers = row.effect.implicit;
            if (sel touched.ruled)  { surely = touched.ruled.must.read; }
            if (sel touched.opaque) { surely = touched.opaque.must.read; }
        }
        var w: u32 = 0;
        for (w < regs.only.len) {
            if (words.len <= w::usize) {
                val res_grown: res[usize, allocator.Error] = vector.push[u64](?words, 0);
                if (sel res_grown.err) { ret err[allocator.Error].err{res_grown.err}; }
            }
            var read: u64 = 0;
            if (w < surely.len) { read = surely.words[w]; }
            words.data[w::usize] = words.data[w::usize] | (regs.only.words[w] & ~read);
            w                    = w + 1;
        }
    }
    val all: effect.Set = effect.Set{words: words.data, len: words.len::u32};
    var r:   u32        = 0;
    for (r < file.register_count) {
        val id: rf.Id = rf.id_of(?file.registers[r]);
        r = r + 1;
        if (!effect.has(file, all, id)) { cnt; }
        val res_pushed: res[usize, allocator.Error] = vector.push[rf.Id](out, id);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    ret err[allocator.Error].ok{};
}

# `list` sorted with each register once
fun sort_unique(list: *vector.Vector[rf.Id]) {
    sort.sort[rf.Id](list.data, list.len);
    var kept: usize = 0;
    var i:    usize = 0;
    for (i < list.len) {
        if (kept == 0 || list.data[kept - 1] != list.data[i]) {
            list.data[kept] = list.data[i];
            kept            = kept + 1;
        }
        i = i + 1;
    }
    vector.truncate[rf.Id](list, kept);
}

# the locations the allocator may give under a context, six for each of the
# build's rows in order: without the frame pointer the frame keeps, past it,
# and past it and the base register a realigned frame whose stack pointer
# moves keeps, then those three for a constant-time function, which takes no
# preserved register the frame code `frame_code` cannot save in constant time
# and no register a row's timing keeps depending on in constant-time code
# (`kept_of`), so no secret of it is held there. each is empty for a row with
# no registers
fun given_all(a: *allocator.Allocator, b: *Build, at: *Locations, ctx: *core_state.Context, frame_code: *code.Admitted, out: *vector.Vector[Given]) err[allowed.Error] {
    var unsaved: vector.Vector[rf.Id] = vector.init[rf.Id](a);
    fin { vector.dnit[rf.Id](?unsaved); }
    var kept: vector.Vector[rf.Id] = vector.init[rf.Id](a);
    fin { vector.dnit[rf.Id](?kept); }
    val err_kept: err[allocator.Error] = kept_of(a, b.basis.set, ctx, ?kept);
    if (sel err_kept.err) { ret err[allowed.Error].err{allowed.Error.alloc{err_kept.err}}; }
    val every_save: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    var i:          usize        = 0;
    for (i < b.conventions.size) {
        val regs: *Registers = convention.held(?b.conventions.data[i]);
        vector.clear[rf.Id](?unsaved);
        val err_unsaved: err[allocator.Error] = unsaved_of(a, frame_code, ctx, ?b.conventions.data[i], ?unsaved);
        if (sel err_unsaved.err) { ret err[allowed.Error].err{allowed.Error.alloc{err_unsaved.err}}; }
        val res_joined: res[usize, allocator.Error] = vector.extend[rf.Id](?unsaved, Slice[rf.Id]{data: kept.data, size: kept.len});
        if (sel res_joined.err) { ret err[allowed.Error].err{allowed.Error.alloc{res_joined.err}}; }
        sort_unique(?unsaved);
        val untimed_saves: Slice[rf.Id] = Slice[rf.Id]{data: unsaved.data, size: unsaved.len};
        var k:             u8           = 0;
        for (k < 6) {
            var g: Given = allowed.none_given(a);
            if (regs != nil) {
                var excluded: Slice[rf.Id] = every_save;
                if (k >= 3) { excluded = untimed_saves; }
                val res_given: res[Given, allowed.Error] = allowed.given(a, b, at, k % 3 != 0, k % 3 == 2, ctx, regs, excluded);
                if (sel res_given.err) { ret err[allowed.Error].err{res_given.err}; }
                g = res_given.ok;
            }
            val res_pushed: res[usize, allocator.Error] = vector.push[Given](out, g);
            if (sel res_pushed.err) {
                allowed.given_dnit(?g);
                ret err[allowed.Error].err{allowed.Error.alloc{res_pushed.err}};
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[allowed.Error].ok{};
}

# the masks of the register rows a call under each of the build's rows
# clobbers, `words` words each, in the rows' order, a row with no registers
# clobbering none
fun owned_all(b: *Build, at: *Locations, words: u32, out: *vector.Vector[u64]) err[allocator.Error] {
    val err_filled: err[allocator.Error] = slice.fill[u64](out, b.conventions.size * words::usize, 0);
    if (sel err_filled.err) { ret err_filled; }
    var i: usize = 0;
    for (i < b.conventions.size) {
        val regs: *Registers = convention.held(?b.conventions.data[i]);
        if (regs != nil) {
            var j: usize = 0;
            for (j < regs.clobbered.size) {
                val res_locate: res[u32, location.Unlocated] = location.locate(at, Physical.register{regs.clobbered.data[j]});
                if (sel res_locate.ok) {
                    val at: usize = i * words::usize + (res_locate.ok / 64)::usize;
                    if (res_locate.ok / 64 < words) { out.data[at] = out.data[at] | (1::u64 << (res_locate.ok % 64)::u64); }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the registers each of the build's rows lets its prologue and epilogues
# overwrite, as lists by the row's index, none for a row with no registers or
# no stack pointer
fun spare_all(a: *allocator.Allocator, b: *Build) res[Lists[rf.Id], allocator.Error] {
    var keys:  vector.Vector[u32]   = vector.init[u32](a);
    var items: vector.Vector[rf.Id] = vector.init[rf.Id](a);
    var one:   vector.Vector[rf.Id] = vector.init[rf.Id](a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[rf.Id](?items);
        vector.dnit[rf.Id](?one);
    }
    var i: usize = 0;
    for (i < b.conventions.size) {
        val regs: *Registers = convention.held(?b.conventions.data[i]);
        if (regs != nil) {
            val opt_stack: opt[rf.Id] = regs.stack;
            if (sel opt_stack.some) {
                vector.clear[rf.Id](?one);
                val err_listed: err[allocator.Error] = framing.scratches_of(regs, opt_stack.some, ?one);
                if (sel err_listed.err) { ret res[Lists[rf.Id], allocator.Error].err{err_listed.err}; }
                var j: usize = 0;
                for (j < one.len) {
                    val res_key: res[usize, allocator.Error] = vector.push[u32](?keys, i::u32);
                    if (sel res_key.err) { ret res[Lists[rf.Id], allocator.Error].err{res_key.err}; }
                    val res_item: res[usize, allocator.Error] = vector.push[rf.Id](?items, one.data[j]);
                    if (sel res_item.err) { ret res[Lists[rf.Id], allocator.Error].err{res_item.err}; }
                    j = j + 1;
                }
            }
        }
        i = i + 1;
    }
    ret graph.lists[rf.Id](a, b.conventions.size::u32, Slice[u32]{data: keys.data, size: keys.len}, Slice[rf.Id]{data: items.data, size: items.len});
}

# give back what `given_all` made
fun given_dnit(v: *vector.Vector[Given]) {
    var i: usize = 0;
    for (i < v.len) {
        allowed.given_dnit(?v.data[i]);
        i = i + 1;
    }
    vector.dnit[Given](v);
}

# the row a function is made under, which every step after selection reads
# once selection has refused a function under none
fun row_of(x: *Session, f: id.Function) *Resolved {
    val sc: Scope = scope(x, f);
    if (sel sc.convention.some) { ret sc.convention.some; }
    ret build_record.default_row(x.p.build);
}

fun select_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.source)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val sc: Scope = scope(c.x, w.function);
    if (sel sc.convention.none) { ret res[Form, Error].err{Error.convention{}}; }
    var calls:      Calls                       = Calls{rows: c.x.p.build.conventions, at: ?c.x.p.at};
    val res_picked: res[Selected, engine.Error] = engine.select(?c.x.s, c.m, w.function, ?calls, sc.context, convention.held(sc.convention.some), c.checked, sc.code);
    if (sel res_picked.err) { ret res[Form, Error].err{Error.select{res_picked.err}}; }
    if (sel c.stats.some)   { c.stats.some.selected = c.stats.some.selected + mf.placed(?res_picked.ok.function)::u64; }
    ret res[Form, Error].ok{Form.selected{res_picked.ok}};
}

# the constant-time check of a selected function that requires constant time,
# under the context its code is made under
fun timing_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.selected))                                               { ret res[Form, Error].err{Error.misplaced{}}; }
    if (!in_constant_time(c.m.functions.data[w.function].data.constant_time)) { ret res[Form, Error].ok{w.form}; }
    val res_found: res[opt[timing.Error], allocator.Error] = timing.check(c.a, ?w.form.selected.function, scope(c.x, w.function).context);
    if (sel res_found.err)     { ret res[Form, Error].err{Error.alloc{res_found.err}}; }
    if (sel res_found.ok.some) { ret res[Form, Error].err{Error.timing{res_found.ok.some}}; }
    ret res[Form, Error].ok{w.form};
}

# the frame's request under the row a function is made under, with the
# module's symbols for that row's probe routine and the global its returns
# leave through, which the convention lowering declares
fun request(c: *Context, f: id.Function, clobbers: Clobbers) framing.Request {
    val under:      *Resolved      = row_of(c.x, f);
    var opt_helper: opt[id.Symbol] = opt[id.Symbol].none{};
    val opt_name:   opt[str]       = convention.probe_helper(under.row);
    if (sel opt_name.some) { opt_helper = module.find(c.m, View{data: opt_name.some, len: str_len(opt_name.some)}); }
    var opt_exit:   opt[id.Symbol] = opt[id.Symbol].none{};
    val opt_leaves: opt[str]       = convention.exit_routine(under.row);
    if (sel opt_leaves.some) { opt_exit = module.find(c.m, View{data: opt_leaves.some, len: str_len(opt_leaves.some)}); }
    val words: usize      = c.x.p.words::usize;
    val owned: Slice[u64] = Slice[u64]{data: ?c.x.p.owned.data[row_index(c.x, f) * words], size: words};
    var red:   u64        = 0;
    if (sel under.row.stack.memory) {
        if (c.x.p.index.target.red) { red = under.row.stack.memory.red; }
    }
    ret framing.Request{convention: under, at: ?c.x.p.at, helper: opt_helper, exit: opt_exit, naked: register_schema.naked(c.m, f), clobbers: clobbers, owned: owned, code: scope(c.x, f).code, scratches: graph.list[rf.Id](?c.x.p.spare, row_index(c.x, f)::u32), red: red};
}

# the classes the table's holds give a policy that never spills a value
fun unspilled(c: *Context, out: *vector.Vector[Class]) err[allocator.Error] {
    val holds: rule.Holds = c.x.p.isa.table.holds;
    val file:  *rf.File   = c.x.p.at.file;
    var i:     u32        = 0;
    for (i < holds.len) {
        val spill:            Spill      = holds.at[i].policy.spill;
        val opt_holder_class: opt[Class] = rule.holder_class(file, holds.at[i].holder);
        if (sel spill.never) {
            if (sel opt_holder_class.some) {
                val res_pushed: res[usize, allocator.Error] = vector.push[Class](out, opt_holder_class.some);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun allocate_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.selected)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val chosen:   Selected                    = w.form.selected;
    val res_read: res[Effects, effects.Error] = effects.read(c.a, ?chosen.function, scope(c.x, w.function).context);
    if (sel res_read.err) { ret res[Form, Error].err{Error.effects{res_read.err}}; }
    var fx:       Effects                   = res_read.ok;
    val req:      framing.Request           = request(c, w.function, engine.clobbers_of(?chosen));
    val res_seen: res[Facts, framing.Error] = framing.facts(c.a, ?chosen.function, ?fx, req);
    if (sel res_seen.err) {
        effects.dnit(?fx);
        ret res[Form, Error].err{Error.pointer{res_seen.err}};
    }
    var facts:     Facts                    = res_seen.ok;
    val res_keeps: res[bool, framing.Error] = framing.keeps_pointer(?chosen.function, ?facts, req);
    if (sel res_keeps.err) {
        scan.dnit(?facts);
        effects.dnit(?fx);
        ret res[Form, Error].err{Error.pointer{res_keeps.err}};
    }
    val based:    bool                  = framing.keeps_base(?chosen.function, ?facts, req);
    val res_done: res[Allocated, Error] = allocated(c, w, chosen, fx, facts, res_keeps.ok, based);
    if (sel res_done.err) {
        scan.dnit(?facts);
        effects.dnit(?fx);
        ret res[Form, Error].err{res_done.err};
    }
    ret res[Form, Error].ok{Form.allocated{res_done.ok}};
}

# allocate a selected function of effects `fx` and facts `facts`, the frame
# pointer left out of the allowed set where the frame keeps it and the base
# register where it keeps that, the effects and facts held by the result
fun allocated(c: *Context, w: *Work, chosen: Selected, fx: Effects, facts: Facts, keeps: bool, based: bool) res[Allocated, Error] {
    val given: *Given = given_of(c.x, w.function, keeps, based, in_constant_time(c.m.functions.data[w.function].data.constant_time));

    var never: vector.Vector[Class] = vector.init[Class](c.a);
    fin { vector.dnit[Class](?never); }
    val err_kept: err[allocator.Error] = unspilled(c, ?never);
    if (sel err_kept.err) { ret res[Allocated, Error].err{Error.allocate{allocate.Error.alloc{err_kept.err}}}; }
    var unset: vector.Vector[u32] = vector.init[u32](c.a);
    fin { vector.dnit[u32](?unset); }
    val regs: *Registers = convention.held(row_of(c.x, w.function));
    if (regs != nil) {
        val err_unset: err[allocator.Error] = allowed.unset(?given.set, ?c.x.p.at, regs, chosen.function.entry, ?unset);
        if (sel err_unset.err) { ret res[Allocated, Error].err{Error.allocate{allocate.Error.alloc{err_unset.err}}}; }
    }
    val r: allocate.Request = allocate.Request{
        scratch:   c.scratch,
        at:        ?c.x.p.at,
        context:   scope(c.x, w.function).context,
        allowed:   ?given.set,
        effects:   ?fx,
        sizes:     scope(c.x, w.function).sizes,
        clobbers:  engine.clobbers_of(?chosen),
        unspilled: Slice[Class]{data: never.data, size: never.len},
        checked:   c.checked,
        optimized: c.optimized,
        unset:     Slice[u32]{data: unset.data, size: unset.len},
    };
    val res_done: res[Allocation, allocate.Error] = allocate.allocate(c.a, ?chosen.function, r);
    if (sel res_done.err) { ret res[Allocated, Error].err{Error.allocate{res_done.err}}; }
    var allocation: Allocation = res_done.ok;
    if (sel c.stats.some) { c.stats.some.rounds = c.stats.some.rounds + allocation.rounds::u64; }
    if (in_constant_time(c.m.functions.data[w.function].data.constant_time)) {
        timing.mark_slots(?chosen.function, ?allocation.function);
        val err_marked: err[allocator.Error] = addressed.mark(c.a, ?allocation.function);
        if (sel err_marked.err) {
            allocate.dnit(?allocation);
            ret res[Allocated, Error].err{Error.alloc{err_marked.err}};
        }
    }
    if (c.optimized) {
        val err_shared: err[allocator.Error] = share.share(c.a, ?allocation.function, Slice[Slice[global.Range]]{data: c.m.publics.data, size: c.m.publics.len}, ?allocation.shared);
        if (sel err_shared.err) {
            allocate.dnit(?allocation);
            ret res[Allocated, Error].err{Error.alloc{err_shared.err}};
        }
    }
    ret res[Allocated, Error].ok{Allocated{chosen: chosen, effects: fx, facts: facts, given: given, allocation: allocation}};
}

# the frame of an allocation, none of its storage released
fun framed_of(c: *Context, w: *Work, held: *Allocated) res[Framed, finish.Error] {
    val given: *Given        = held.given;
    val need:  scavenge.Need = scavenge.Need{allowed: Slice[Physical]{data: given.listed.data, size: given.listed.len}, pool: Slice[rf.Id]{data: given.pool.data, size: given.pool.len}, configured: configure.scratches(c.x.p.isa.state)};
    ret frame.frame(c.a, ?held.allocation, ?held.facts, request(c, w.function, engine.clobbers_of(?held.chosen)), scope(c.x, w.function).code, need);
}

# whether a frame was refused only for the frame pointer its allocation took,
# which it needs to reach its emergency slots
fun withheld(e: finish.Error) bool {
    if (!(sel e.lay)) { ret false; }
    val l: framing.Error = e.lay;
    ret sel l.unkept;
}

# frame an allocated function. a frame that reaches its emergency slots only
# off the frame pointer the allocation took is allocated again with the
# pointer withheld, once, as a frame that keeps it then has that base
fun frame_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.allocated)) { ret res[Form, Error].err{Error.misplaced{}}; }
    var held:      Allocated                 = w.form.allocated;
    val res_first: res[Framed, finish.Error] = framed_of(c, w, ?held);
    if (sel res_first.ok)         { ret res[Form, Error].ok{framing_of(c, ?held, res_first.ok)}; }
    if (!withheld(res_first.err)) { ret res[Form, Error].err{Error.frame{res_first.err}}; }
    val based:     bool                  = framing.keeps_base(?held.chosen.function, ?held.facts, request(c, w.function, engine.clobbers_of(?held.chosen)));
    val res_again: res[Allocated, Error] = allocated(c, w, held.chosen, held.effects, held.facts, true, based);
    if (sel res_again.err) { ret res[Form, Error].err{res_again.err}; }
    allocate.dnit(?held.allocation);
    var kept: Allocated = res_again.ok;
    hold(w, kept);
    val res_second: res[Framed, finish.Error] = framed_of(c, w, ?kept);
    if (sel res_second.err) { ret res[Form, Error].err{Error.frame{res_second.err}}; }
    ret res[Form, Error].ok{framing_of(c, ?kept, res_second.ok)};
}

# a work's form made an allocation, its last released by the caller
fun hold(w: *Work, x: Allocated) {
    w.form = Form.allocated{x};
}

# the framed form of an allocation, its allocation and selection released.
# the allocation kept is the one the stats count
fun framing_of(c: *Context, held: *Allocated, framed: Framed) Form {
    if (sel c.stats.some) { c.stats.some.allocated = c.stats.some.allocated + mf.placed(?held.allocation.function)::u64; }
    allocate.dnit(?held.allocation);
    effects.dnit(?held.effects);
    scan.dnit(?held.facts);
    engine.selected_dnit(?held.chosen);
    ret Form.framed{Framing{given: held.given, framed: framed}};
}

fun copies_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val f:  *Framing      = ?w.form.framed;
    val sc: Scope         = scope(c.x, w.function);
    var r:  lower.Request = lower.Request{
        at:        ?c.x.p.at,
        context:   sc.context,
        clobbered: convention.held(row_of(c.x, w.function)).clobbered,
        allowed:   Slice[Physical]{data: f.given.listed.data, size: f.given.listed.len},
        pool:      Slice[rf.Id]{data: f.given.pool.data, size: f.given.pool.len},
        code:      sc.code,
        moves:     sc.moves,
    };
    val err_copied: err[lower.Error] = lower.lower(c.a, ?f.framed, ?r);
    if (sel err_copied.err) { ret res[Form, Error].err{Error.copies{err_copied.err}}; }
    ret res[Form, Error].ok{w.form};
}

fun configure_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val f: *Framing          = ?w.form.framed;
    var r: configure.Request = configure.Request{
        at:        ?c.x.p.at,
        context:   scope(c.x, w.function).context,
        clobbered: convention.held(row_of(c.x, w.function)).clobbered,
        allowed:   Slice[Physical]{data: f.given.listed.data, size: f.given.listed.len},
        rules:     c.x.p.isa.state,
        code:      scope(c.x, w.function).code,
    };
    val err_set: err[configure.Error] = configure.configure(c.a, ?f.framed, ?r);
    if (sel err_set.err) { ret res[Form, Error].err{Error.configure{err_set.err}}; }
    ret res[Form, Error].ok{w.form};
}

fun loops_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val err_expanded: err[expand.Error] = expand.expand(c.a, ?w.form.framed.framed);
    if (sel err_expanded.err) { ret res[Form, Error].err{Error.loops{err_expanded.err}}; }
    ret res[Form, Error].ok{w.form};
}

fun zero_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    val err_zeroed: err[allocator.Error] = zero.zero(c.a, ?w.form.framed.framed.function, scope(c.x, w.function).context, c.x.p.isa.zeroings, c.m);
    if (sel err_zeroed.err) { ret res[Form, Error].err{Error.alloc{err_zeroed.err}}; }
    ret res[Form, Error].ok{w.form};
}

# a joining writes an add as an address, and the walk of a constant-time function refuses an address formed from a
# secret where it takes the add, so such a function is fused by its testings and clearings alone
fun fuse_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    var js: Joinings = c.x.p.isa.joinings;
    if (in_constant_time(c.m.functions.data[w.function].data.constant_time)) { js = NO_JOININGS; }
    val err_fused: err[allocator.Error] = fuse.fuse(c.a, ?w.form.framed.framed.function, scope(c.x, w.function).context, c.x.p.isa.testings, js, c.x.p.isa.clearings);
    if (sel err_fused.err) { ret res[Form, Error].err{Error.alloc{err_fused.err}}; }
    ret res[Form, Error].ok{w.form};
}

fun layout_step(c: *Context, w: *Work) res[Form, Error] {
    if (!(sel w.form.framed)) { ret res[Form, Error].err{Error.misplaced{}}; }
    var held:     Framing                        = w.form.framed;
    val regs:     *Registers                     = convention.held(row_of(c.x, w.function));
    val ctx:      *core_state.Context            = scope(c.x, w.function).context;
    val res_read: res[range.Walked, range.Error] = range.ranges(c.a, ?held.framed.function, range.Request{at: ?c.x.p.at, context: ctx, layout: ?held.framed.layout, clobbered: regs.clobbered});
    if (sel res_read.err) { ret res[Form, Error].err{Error.ranges{res_read.err}}; }
    var walked: range.Walked = res_read.ok;
    fin { range.walked_dnit(?walked); }
    val res_laid: res[Laid, lay.Error] = lay.lay(c.a, ?held.framed.function);
    if (sel res_laid.err) { ret res[Form, Error].err{Error.layout{res_laid.err}}; }
    var order:      Laid                     = res_laid.ok;
    val res_joined: res[Ranges, range.Error] = range.follow(c.a, ?walked, ?held.framed.function, Slice[Block]{data: order.order.data, size: order.order.len});
    if (sel res_joined.err) {
        lay.dnit(?order);
        ret res[Form, Error].err{Error.ranges{res_joined.err}};
    }
    ret res[Form, Error].ok{Form.laid{Done{function: w.function, context: ctx, framed: held.framed, laid: order, ranges: res_joined.ok}}};
}

# the steps every function goes through, in order
pub val STAGES: [10]Step = [10]Step{
    Step{name: "select", run: select_step, stage: stats.Stage.select{}},
    Step{name: "timing", run: timing_step, stage: stats.Stage.select{}},
    Step{name: "allocate", run: allocate_step, stage: stats.Stage.alloc{}},
    Step{name: "frame", run: frame_step, stage: stats.Stage.frame{}},
    Step{name: "copies", run: copies_step, stage: stats.Stage.frame{}},
    Step{name: "configure", run: configure_step, stage: stats.Stage.frame{}},
    Step{name: "loops", run: loops_step, stage: stats.Stage.frame{}},
    Step{name: "zero", run: zero_step, stage: stats.Stage.frame{}},
    Step{name: "fuse", run: fuse_step, stage: stats.Stage.frame{}},
    Step{name: "layout", run: layout_step, stage: stats.Stage.emit{}},
};

# the steps of STAGES as a sequence
pub fun stages() Slice[Step] {
    ret Slice[Step]{data: ?STAGES[0], size: $length_of(STAGES)};
}

# the machine function a form holds, none for the ir
fun code_of(w: *Work) opt[*Function] {
    if (sel w.form.selected)  { ret opt[*Function].some{?w.form.selected.function}; }
    if (sel w.form.allocated) { ret opt[*Function].some{?w.form.allocated.allocation.function}; }
    if (sel w.form.framed)    { ret opt[*Function].some{?w.form.framed.framed.function}; }
    if (sel w.form.laid)      { ret opt[*Function].some{?w.form.laid.framed.function}; }
    ret opt[*Function].none{};
}

# the source location of ir instruction `i` of the function a work is of
fun ir_location(c: *Context, w: *Work, i: id.Instruction) opt[Location] {
    ret ir_function.location(?c.m.functions.data[w.function].body, i);
}

# the source location of machine instruction `i` of the code a work's form
# holds
fun code_location(w: *Work, i: Instruction) opt[Location] {
    val opt_code: opt[*Function] = code_of(w);
    if (sel opt_code.none) { ret opt[Location].none{}; }
    ret mf.location(opt_code.some, i);
}

fun framing_location(w: *Work, e: framing.Error) opt[Location] {
    if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
    ret opt[Location].none{};
}

fun scan_location(w: *Work, e: scan.Error) opt[Location] {
    if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
    ret opt[Location].none{};
}

fun effects_location(w: *Work, e: effects.Error) opt[Location] {
    if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
    ret opt[Location].none{};
}

# the source location of the instruction what refused a function names, read
# through the form the refused step left as it found it, or the verifier read
# after it, which holds the code the instruction is of. an instruction of code
# a step was making and dropped carries its own. register allocation's
# refusals name instructions of the rounds it drops, which carry none yet
fun located(c: *Context, w: *Work, s: Error) opt[Location] {
    val opt_none: opt[Location] = opt[Location].none{};
    if (sel s.select) {
        val e: engine.Error = s.select;
        if (sel e.unmatched) { ret ir_location(c, w, e.unmatched.instruction); }
        if (sel e.transfer)  { ret ir_location(c, w, e.transfer); }
        if (sel e.unchecked) { ret ir_location(c, w, e.unchecked); }
        if (sel e.assembly)  { ret ir_location(c, w, e.assembly.instruction); }
        if (sel e.switched)  { ret ir_location(c, w, e.switched.instruction); }
        if (sel e.undecided) { ret e.undecided.location; }
        ret opt_none;
    }
    if (sel s.timing)  { ret code_location(w, s.timing.instruction); }
    if (sel s.effects) { ret effects_location(w, s.effects); }
    if (sel s.pointer) { ret framing_location(w, s.pointer); }
    if (sel s.frame) {
        val e: finish.Error = s.frame;
        if (sel e.lay)     { ret framing_location(w, e.lay); }
        if (sel e.operand) { ret code_location(w, e.operand); }
        if (sel e.dropped) { ret code_location(w, e.dropped); }
        ret opt_none;
    }
    if (sel s.copies) {
        val e: lower.Error = s.copies;
        if (sel e.operand)     { ret code_location(w, e.operand.at); }
        if (sel e.label)       { ret code_location(w, e.label); }
        if (sel e.implied)     { ret code_location(w, e.implied); }
        if (sel e.twice)       { ret code_location(w, e.twice.at); }
        if (sel e.unmoved)     { ret code_location(w, e.unmoved.at); }
        if (sel e.scratch)     { ret code_location(w, e.scratch.at); }
        if (sel e.sizes)       { ret code_location(w, e.sizes.at); }
        if (sel e.cycle)       { ret code_location(w, e.cycle); }
        if (sel e.dropped)     { ret code_location(w, e.dropped.at); }
        if (sel e.unnumbered)  { ret code_location(w, e.unnumbered.at); }
        if (sel e.constrained) { ret code_location(w, e.constrained.at); }
        ret opt_none;
    }
    if (sel s.configure) {
        val e: configure.Error = s.configure;
        if (sel e.scratch) { ret code_location(w, e.scratch); }
        if (sel e.shape)   { ret code_location(w, e.shape); }
        if (sel e.hooks)   { ret code_location(w, e.hooks); }
        ret opt_none;
    }
    if (sel s.loops) {
        val e: expand.Error = s.loops;
        if (sel e.shape)     { ret code_location(w, e.shape.at); }
        if (sel e.operand)   { ret code_location(w, e.operand.at); }
        if (sel e.label)     { ret code_location(w, e.label); }
        if (sel e.implied)   { ret code_location(w, e.implied); }
        if (sel e.jump)      { ret code_location(w, e.jump); }
        if (sel e.undecided) { ret code_location(w, e.undecided.at); }
        ret opt_none;
    }
    if (sel s.layout) {
        val e: lay.Error = s.layout;
        if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
        ret opt_none;
    }
    if (sel s.ranges) {
        val e: range.Error = s.ranges;
        if (sel e.writes) { ret scan_location(w, e.writes); }
        ret opt_none;
    }
    if (sel s.verify) {
        val e: verify.Error = s.verify;
        if (sel e.fault) { ret code_location(w, e.fault.at); }
        ret opt_none;
    }
    ret opt_none;
}

# a refusal with the allocator's refusal it stands for lifted to the top level, so storage
# refused reads as storage refused whichever step or the emission asked
fun lifted(s: Error) Error {
    val opt_starved: opt[allocator.Error] = starved(s);
    if (sel opt_starved.some) { ret Error.alloc{opt_starved.some}; }
    ret s;
}

# the allocator's refusal a back end refusal stands for, its own or one a step, the served check, the
# emission or the machine form's printing carries
# ---
# s:   the refusal
# ret: the allocator's refusal, none for any other
pub fun starved(s: Error) opt[allocator.Error] {
    if (sel s.alloc)     { ret opt[allocator.Error].some{s.alloc}; }
    if (sel s.locations) { ret location.starved(s.locations); }
    if (sel s.table)     { ret engine.starved(s.table); }
    if (sel s.served)    { ret served.starved(s.served); }
    if (sel s.moves)     { ret move.starved(s.moves); }
    if (sel s.code)      { ret code.starved(s.code); }
    if (sel s.emit)      { ret handover.starved(s.emit); }
    if (sel s.select)    { ret engine.starved(s.select); }
    if (sel s.effects)   { ret effects.starved(s.effects); }
    if (sel s.pointer)   { ret framing.starved(s.pointer); }
    if (sel s.allowed)   { ret allowed.starved(s.allowed); }
    if (sel s.allocate)  { ret allocate.starved(s.allocate); }
    if (sel s.frame)     { ret finish.starved(s.frame); }
    if (sel s.copies)    { ret lower.starved(s.copies); }
    if (sel s.configure) { ret configure.starved(s.configure); }
    if (sel s.loops)     { ret expand.starved(s.loops); }
    if (sel s.layout)    { ret lay.starved(s.layout); }
    if (sel s.ranges)    { ret range.starved(s.ranges); }
    if (sel s.verify)    { ret verify.starved(s.verify); }
    if (sel s.machine)   { ret print.starved(s.machine); }
    ret opt[allocator.Error].none{};
}

# a function refused at a step, its refusal lifted and located before what
# its form holds is given back
fun refuse(c: *Context, w: *Work, step: opt[str], s: Error) res[Done, Failed] {
    val lifted_s:    Error         = lifted(s);
    val opt_located: opt[Location] = located(c, w, lifted_s);
    dnit(w);
    ret res[Done, Failed].err{Failed{function: opt[id.Function].some{w.function}, step: step, location: opt_located, error: lifted_s}};
}

# one function through a sequence of steps, verified after each when the
# compilation is checked
# ---
# c:     what every step reads
# steps: the sequence, STAGES for every compilation
# f:     the function
# ret:   the function laid out, or the step that refused it, leaving nothing
#        to release
pub fun through(c: *Context, steps: Slice[Step], f: id.Function) res[Done, Failed] {
    var w:        Work         = Work{function: f, form: Form.source{}};
    val symbol:   View         = module.name_of(c.m, c.m.functions.data[f].data.name);
    var opt_from: opt[Instant] = stats.start(c.stats);
    # the stage the function is in and the time it has taken in it, each stage's
    # part reported to the progress as the next begins
    var opt_in: opt[stats.Stage] = opt[stats.Stage].none{};
    var took:   u64              = 0;
    var i:      usize            = 0;
    for (i < steps.size) {
        val step:     *Step    = ?steps.data[i];
        val opt_name: opt[str] = opt[str].some{step.name};
        if (!in_stage(opt_in, step.stage)) {
            if (sel opt_in.some) { stats.finished(c.stats, opt_in.some, symbol, took); }
            stats.begun(c.stats, step.stage, symbol);
            opt_in = opt[stats.Stage].some{step.stage};
            took   = 0;
        }
        val res_ran: res[Form, Error] = step.run(c, ?w);
        if (sel res_ran.err) {
            stats.stop(c.stats, step.stage, opt_from);
            ret refuse(c, ?w, opt_name, res_ran.err);
        }
        w.form = res_ran.ok;
        if (c.checked) {
            val opt_code: opt[*Function] = code_of(?w);
            if (sel opt_code.some) {
                val err_function: err[verify.Error] = verify.function(c.a, opt_code.some);
                if (sel err_function.err) {
                    stats.stop(c.stats, step.stage, opt_from);
                    ret refuse(c, ?w, opt_name, Error.verify{err_function.err});
                }
            }
        }
        # a step and its verification are timed by one read of the clock between steps
        opt_from = stats.lap_took(c.stats, step.stage, opt_from, ?took);
        i        = i + 1;
    }
    if (sel opt_in.some) { stats.finished(c.stats, opt_in.some, symbol, took); }
    if (sel w.form.laid) { ret res[Done, Failed].ok{w.form.laid}; }
    ret refuse(c, ?w, opt[str].none{}, Error.unfinished{});
}

# whether a function in the stage `in`, none before its first step, is in `k`
fun in_stage(in: opt[stats.Stage], k: stats.Stage) bool {
    if (sel in.none) { ret false; }
    ret stats.index(in.some) == stats.index(k);
}

# give back a set of extensions past the build's and its storage
fun under_dnit(a: *allocator.Allocator, u: *Under) {
    given_dnit(?u.given);
    spill.sizes_dnit(?u.sizes);
    code.dnit(?u.code);
    move.dnit(?u.moves);
    allocator.deallocate[Under](a, u, 1);
}

# what a set of the module's table binds, in place of `u`: the moves and
# frame code bound to its context
fun under_init(x: *Session, a: *allocator.Allocator, u: *Under, b: *Basis) err[Failed] {
    u.basis = b;
    val res_moves: res[move.Index, move.Error] = move.index(a, x.p.isa.moves, ?x.p.at, ?b.context);
    if (sel res_moves.err) { ret err[Failed].err{whole(Error.moves{res_moves.err})}; }
    u.moves = res_moves.ok;
    val res_bound: res[code.Admitted, code.Error] = code.admit(a, x.p.isa.frame, ?b.context);
    if (sel res_bound.err) {
        move.dnit(?u.moves);
        ret err[Failed].err{whole(Error.code{res_bound.err})};
    }
    u.code = res_bound.ok;
    val res_sized: res[spill.Sizes, allocator.Error] = spill.sizes(a, ?x.p.at, b.context.view, ?u.code);
    if (sel res_sized.err) {
        code.dnit(?u.code);
        move.dnit(?u.moves);
        ret err[Failed].err{whole(Error.alloc{res_sized.err})};
    }
    u.sizes = res_sized.ok;
    u.given = vector.init[Given](a);
    val err_listed: err[allowed.Error] = given_all(a, x.p.build, ?x.p.at, ?b.context, ?u.code, ?u.given);
    if (sel err_listed.err) {
        given_dnit(?u.given);
        spill.sizes_dnit(?u.sizes);
        code.dnit(?u.code);
        move.dnit(?u.moves);
        ret err[Failed].err{whole(Error.allowed{err_listed.err})};
    }
    ret err[Failed].ok{};
}

# what each set of the module's table binds, in the table's order
fun bind_all(x: *Session, a: *allocator.Allocator) err[Failed] {
    var k: usize = 0;
    for (k < x.w.bases.len) {
        val res_made: res[*Under, allocator.Error] = allocator.allocate[Under](a, 1);
        if (sel res_made.err) { ret err[Failed].err{whole(Error.alloc{res_made.err})}; }
        val u:         *Under      = res_made.ok;
        val err_bound: err[Failed] = under_init(x, a, u, x.w.bases.data[k]);
        if (sel err_bound.err) {
            allocator.deallocate[Under](a, u, 1);
            ret err_bound;
        }
        val res_pushed: res[usize, allocator.Error] = vector.push[*Under](?x.unders, u);
        if (sel res_pushed.err) {
            under_dnit(a, u);
            ret err[Failed].err{whole(Error.alloc{res_pushed.err})};
        }
        k = k + 1;
    }
    ret err[Failed].ok{};
}

# the convention row each function's signature names, looked up once among
# the rows the build resolved
fun row_all(x: *Session, m: *Module) err[Failed] {
    val err_unrowed: err[allocator.Error] = slice.fill[u32](?x.rows, m.functions.len, UNROWED);
    if (sel err_unrowed.err) { ret err[Failed].err{whole(Error.alloc{err_unrowed.err})}; }
    var k: usize = 0;
    for (k < m.functions.len) {
        val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(?m.types, m.functions.data[k].data.signature);
        if (sel res_signature.ok) {
            val opt_index_of: opt[usize] = build_record.index_of(x.p.build, res_signature.ok.convention);
            if (sel opt_index_of.some) { x.rows.data[k] = opt_index_of.some::u32; }
        }
        k = k + 1;
    }
    ret err[Failed].ok{};
}

# give back every set of extensions past the build's a session opened, and
# its per function tables
fun unders_dnit(x: *Session, a: *allocator.Allocator) {
    var i: usize = 0;
    for (i < x.unders.len) {
        under_dnit(a, x.unders.data[i]);
        i = i + 1;
    }
    vector.dnit[*Under](?x.unders);
    vector.dnit[u32](?x.rows);
}

# open what a build reads of its target in place, once per build: the
# locations, the selection table checked against the schema and indexed, its
# vector rows judged for the build's basis, the moves and the frame code
# ---
# b:    the target's build, opened for `t`, whose state it is until
#       `unprepare`
# a:    the allocator its storage comes from
# t:    the target
# isas: the registry of the sets the family carries, which outlives it
# ret:  ok, or why it was not made, leaving nothing to give back
pub fun prepare(b: *Build, a: *allocator.Allocator, t: *Target, isas: *Isas) err[Error] {
    if (b.basis.target != t) { ret err[Error].err{Error.foreign{}}; }
    val opt_found: opt[*Isa] = isa.of(isas, b.basis.set);
    if (sel opt_found.none) { ret err[Error].err{Error.uncarried{}}; }
    val res_held: res[*State, allocator.Error] = allocator.allocate[State](a, 1);
    if (sel res_held.err) { ret err[Error].err{Error.alloc{res_held.err}}; }
    val p:        *State     = res_held.ok;
    val err_made: err[Error] = state(p, a, b, t, opt_found.some, isas);
    if (sel err_made.err) {
        allocator.deallocate[State](a, p, 1);
        ret err_made;
    }
    b.state = p::ptr;
    ret err[Error].ok{};
}

# the state of a build, made in place of `p`
fun state(p: *State, a: *allocator.Allocator, b: *Build, t: *Target, found: *Isa, isas: *Isas) err[Error] {
    p.a     = a;
    p.build = b;
    p.isas  = isas;
    p.isa   = found;

    var memories: vector.Vector[*Memory] = vector.init[*Memory](a);
    fin { vector.dnit[*Memory](?memories); }
    var i: usize = 0;
    for (i < p.isa.memories.size) {
        val res_pushed: res[usize, allocator.Error] = vector.push[*Memory](?memories, ?p.isa.memories.data[i]);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        i = i + 1;
    }
    val res_located: res[Locations, location.Error] = location.init(a, build_record.registers(b).context.view.file, Slice[*Memory]{data: memories.data, size: memories.len});
    if (sel res_located.err) { ret err[Error].err{Error.locations{res_located.err}}; }
    p.at = res_located.ok;

    val res_made: res[Index, engine.Error] = engine.index(a, p.isa, t, ?b.basis.context, build_record.registers(b));
    if (sel res_made.err) {
        location.dnit(?p.at);
        ret err[Error].err{Error.table{res_made.err}};
    }
    p.index = res_made.ok;
    val err_judged: err[served.Error] = served.judge(a, isas, ?b.basis);
    if (sel err_judged.err) {
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.served{err_judged.err}};
    }

    val res_moves: res[move.Index, move.Error] = move.index(a, p.isa.moves, ?p.at, build_record.registers(b).context);
    if (sel res_moves.err) {
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.moves{res_moves.err}};
    }
    p.moves = res_moves.ok;

    val res_bound: res[code.Admitted, code.Error] = code.admit(a, p.isa.frame, build_record.registers(b).context);
    if (sel res_bound.err) {
        move.dnit(?p.moves);
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.code{res_bound.err}};
    }
    p.code = res_bound.ok;
    val res_sized: res[spill.Sizes, allocator.Error] = spill.sizes(a, ?p.at, build_record.registers(b).context.view, ?p.code);
    if (sel res_sized.err) {
        code.dnit(?p.code);
        move.dnit(?p.moves);
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.alloc{res_sized.err}};
    }
    p.sizes = res_sized.ok;
    p.given = vector.init[Given](a);
    val err_listed: err[allowed.Error] = given_all(a, b, ?p.at, build_record.registers(b).context, ?p.code, ?p.given);
    if (sel err_listed.err) {
        given_dnit(?p.given);
        spill.sizes_dnit(?p.sizes);
        code.dnit(?p.code);
        move.dnit(?p.moves);
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.allowed{err_listed.err}};
    }
    p.words = 0;
    if (p.at.file != nil) { p.words = effect.words(p.at.file); }
    p.owned = vector.init[u64](a);
    val err_owns: err[allocator.Error] = owned_all(b, ?p.at, p.words, ?p.owned);
    if (sel err_owns.err) {
        vector.dnit[u64](?p.owned);
        given_dnit(?p.given);
        spill.sizes_dnit(?p.sizes);
        code.dnit(?p.code);
        move.dnit(?p.moves);
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.alloc{err_owns.err}};
    }
    val res_spared: res[Lists[rf.Id], allocator.Error] = spare_all(a, b);
    if (sel res_spared.err) {
        vector.dnit[u64](?p.owned);
        given_dnit(?p.given);
        spill.sizes_dnit(?p.sizes);
        code.dnit(?p.code);
        move.dnit(?p.moves);
        engine.index_dnit(?p.index);
        location.dnit(?p.at);
        ret err[Error].err{Error.alloc{res_spared.err}};
    }
    p.spare = res_spared.ok;
    ret err[Error].ok{};
}

# give back what `prepare` made of a build, once no session over it is left
pub fun unprepare(b: *Build) {
    val p: *State               = b.state::*State;
    val a: *allocator.Allocator = p.a;
    graph.lists_dnit[rf.Id](?p.spare);
    vector.dnit[u64](?p.owned);
    given_dnit(?p.given);
    spill.sizes_dnit(?p.sizes);
    code.dnit(?p.code);
    move.dnit(?p.moves);
    engine.index_dnit(?p.index);
    location.dnit(?p.at);
    allocator.deallocate[State](a, p, 1);
    b.state = nil;
}

# open the session of a module in place
# ---
# x:   where it is made, and stays until `session_dnit`
# a:   the allocator its storage comes from
# m:   the module
# p:   what the build opened of its target, which outlives the session
# w:   the module's table, whose sets the session binds
# ret: ok, or why it was not made, leaving nothing to close
fun session_init(x: *Session, a: *allocator.Allocator, m: *Module, p: *State, w: *Widenings) err[Failed] {
    x.p      = p;
    x.s      = engine.init(a, ?p.index);
    x.w      = w;
    x.unders = vector.init[*Under](a);
    x.rows   = vector.init[u32](a);
    val err_tabled: err[Failed] = scoped(x, a, m);
    if (sel err_tabled.err) {
        unders_dnit(x, a);
        engine.dnit(?x.s);
        ret err_tabled;
    }
    ret err[Failed].ok{};
}

# the per set and per function tables of a session: what each set of the
# module's table binds and the convention row each signature names
fun scoped(x: *Session, a: *allocator.Allocator, m: *Module) err[Failed] {
    val err_bound: err[Failed] = bind_all(x, a);
    if (sel err_bound.err) { ret err_bound; }
    ret row_all(x, m);
}

# give back a session's storage
fun session_dnit(x: *Session) {
    unders_dnit(x, x.s.a);
    engine.dnit(?x.s);
}

fun all_dnit(done: *vector.Vector[Done]) {
    var i: usize = 0;
    for (i < done.len) {
        done_dnit(?done.data[i]);
        i = i + 1;
    }
    vector.dnit[Done](done);
}

# every function with a body, compiled and kept for emission. the convention
# lowering delivers a row's probe routine before any frame is laid out, so one
# is compiled only once a frame of the module calls it
fun functions(c: *Context, done: *vector.Vector[Done]) err[Failed] {
    var probes: vector.Vector[id.Function] = vector.init[id.Function](c.a);
    fin { vector.dnit[id.Function](?probes); }
    val err_found: err[allocator.Error] = probe_routines(c, ?probes);
    if (sel err_found.err) { ret err[Failed].err{whole(Error.alloc{err_found.err})}; }
    opened(c, bodies(c, ?probes));
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0 && !listed(?probes, k)) {
            val err_one: err[Failed] = compiled(c, done, k);
            if (sel err_one.err) { ret err_one; }
        }
        k = k + 1;
    }
    var i: usize = 0;
    for (i < probes.len) {
        if (probed(done, probes.data[i])) {
            val err_one: err[Failed] = compiled(c, done, probes.data[i]);
            if (sel err_one.err) { ret err_one; }
        }
        i = i + 1;
    }
    ret err[Failed].ok{};
}

# how many functions are compiled whatever their frames call: every one with a
# body but the probe routines
fun bodies(c: *Context, probes: *vector.Vector[id.Function]) u32 {
    var n: u32 = 0;
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0 && !listed(probes, k)) { n = n + 1; }
        k = k + 1;
    }
    ret n;
}

# the stages every function goes through open, each to finish `n` functions
fun opened(c: *Context, n: u32) {
    stats.opened(c.stats, stats.Stage.select{}, n);
    stats.opened(c.stats, stats.Stage.alloc{}, n);
    stats.opened(c.stats, stats.Stage.frame{}, n);
    stats.opened(c.stats, stats.Stage.emit{}, n);
}

# the function `f` through every step, kept for emission
fun compiled(c: *Context, done: *vector.Vector[Done], f: id.Function) err[Failed] {
    val res_one: res[Done, Failed] = through(c, stages(), f);
    if (sel res_one.err) { ret err[Failed].err{res_one.err}; }
    var kept:       Done                        = res_one.ok;
    val res_pushed: res[usize, allocator.Error] = vector.push[Done](done, kept);
    if (sel res_pushed.err) {
        done_dnit(?kept);
        ret err[Failed].err{whole(Error.alloc{res_pushed.err})};
    }
    ret err[Failed].ok{};
}

# the module's defined probe routines of the rows its functions are made under
fun probe_routines(c: *Context, out: *vector.Vector[id.Function]) err[allocator.Error] {
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0) {
            val opt_name: opt[str] = convention.probe_helper(row_of(c.x, k).row);
            if (sel opt_name.some) {
                val opt_find: opt[id.Symbol] = module.find(c.m, View{data: opt_name.some, len: str_len(opt_name.some)});
                if (sel opt_find.some) {
                    val sym: id.Symbol = opt_find.some;
                    if (sel sym.function) {
                        if (c.m.functions.data[sym.function].body.blocks.len > 0 && !listed(out, sym.function)) {
                            val res_pushed: res[usize, allocator.Error] = vector.push[id.Function](out, sym.function);
                            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

fun listed(v: *vector.Vector[id.Function], f: id.Function) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a compiled frame calls the routine `f` to probe
fun probed(done: *vector.Vector[Done], f: id.Function) bool {
    var i: usize = 0;
    for (i < done.len) {
        val opt_probe: opt[id.Symbol] = done.data[i].framed.layout.probe;
        i = i + 1;
        if (sel opt_probe.some) {
            val sym: id.Symbol = opt_probe.some;
            if (sel sym.function) {
                if (sym.function == f) { ret true; }
            }
        }
    }
    ret false;
}

# the machine form text of the compiled functions
fun printed(c: *Context, w: *io.Writer, done: *vector.Vector[Done]) err[Error] {
    var items: vector.Vector[Item] = vector.init[Item](c.a);
    fin { vector.dnit[Item](?items); }
    var i: usize = 0;
    for (i < done.len) {
        val d:          *Done                       = ?done.data[i];
        val res_pushed: res[usize, allocator.Error] = vector.push[Item](?items, Item{symbol: id.Symbol.function{d.function}, function: d.framed.function});
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        i = i + 1;
    }
    val err_wrote: err[print.Error] = print.print(w, c.m, c.x.p.isas, Slice[Item]{data: items.data, size: items.len});
    if (sel err_wrote.err) { ret err[Error].err{Error.machine{err_wrote.err}}; }
    ret err[Error].ok{};
}

# the texts asked for, written once the object is made, so a refused
# compilation writes nothing
fun written(c: *Context, o: Options, done: *vector.Vector[Done], listed: *vector.Vector[u8]) err[Error] {
    if (sel o.machine.some) {
        val err_shown: err[Error] = printed(c, o.machine.some, done);
        if (sel err_shown.err) { ret err_shown; }
    }
    if (sel o.listing.some) {
        val err_wrote: err[io.WriteError] = io.write_all(o.listing.some, listed.data, listed.len);
        if (sel err_wrote.err) { ret err[Error].err{Error.write{err_wrote.err}}; }
    }
    ret err[Error].ok{};
}

# the walk of the encoded code of every compiled function that requires
# constant time, from the seeds its entry and frame hold, public again at the
# declassify points emission made, each call walked through the model of its
# call site, refused with every function it refuses
fun walked(c: *Context, t: *Target, done: *vector.Vector[Done], obj: *object.Object, marks: *timed.Marks) err[Error] {
    var framed: vector.Vector[timed.Framed] = vector.init[timed.Framed](c.a);
    fin { vector.dnit[timed.Framed](?framed); }
    var i: usize = 0;
    for (i < done.len) {
        val d:          *Done                       = ?done.data[i];
        val res_pushed: res[usize, allocator.Error] = vector.push[timed.Framed](?framed, timed.Framed{function: d.function, context: d.context, decode: d.context, code: ?d.framed.function, layout: ?d.framed.layout});
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        i = i + 1;
    }
    # the refusals outlive the walk in the error, so their storage is the compile's
    var unmet:     vector.Vector[mct.Error] = vector.init[mct.Error](c.a);
    val err_check: err[allocator.Error]     = timed.check(c.a, c.m, c.x.p.build, t, obj, Slice[timed.Framed]{data: framed.data, size: framed.len}, ?c.x.s.inlines.heads, marks, ?unmet);
    if (sel err_check.err) {
        vector.dnit[mct.Error](?unmet);
        ret err[Error].err{Error.alloc{err_check.err}};
    }
    if (unmet.len != 0) { ret err[Error].err{Error.walked{Slice[mct.Error]{data: unmet.data, size: unmet.len}}}; }
    vector.dnit[mct.Error](?unmet);
    ret err[Error].ok{};
}

# hand the compiled functions to masc, then walk the code that requires
# constant time, then write the texts asked for
fun emitted(c: *Context, t: *Target, done: *vector.Vector[Done], o: Options) res[object.Object, Error] {
    var units: vector.Vector[Unit] = vector.init[Unit](c.a);
    fin { vector.dnit[Unit](?units); }
    var i: usize = 0;
    for (i < done.len) {
        val d:          *Done                       = ?done.data[i];
        val res_pushed: res[usize, allocator.Error] = vector.push[Unit](?units, Unit{function: d.function, context: d.context, code: ?d.framed.function, laid: ?d.laid, facts: Slice[Fact]{data: d.framed.facts.data, size: d.framed.facts.len}, ranges: ?d.ranges});
        if (sel res_pushed.err) { ret res[object.Object, Error].err{Error.alloc{res_pushed.err}}; }
        i = i + 1;
    }
    var listed: vector.Vector[u8] = vector.init[u8](c.a);
    fin { vector.dnit[u8](?listed); }
    var opt_into: opt[*vector.Vector[u8]] = opt[*vector.Vector[u8]].none{};
    if (sel o.listing.some) { opt_into = opt[*vector.Vector[u8]].some{?listed}; }
    var marks: timed.Marks = timed.marks(c.a);
    fin { timed.dnit(?marks); }
    var modes: [1]mode.Setting;
    var count: usize     = 0;
    val relax: *Relaxing = c.x.p.isa.relax;
    if (relax != nil) {
        modes[0] = relax.off;
        if (o.relax) { modes[0] = relax.on; }
        count = 1;
    }
    val res_made: res[object.Object, handover.Error] = handover.emit(c.a, c.m, c.x.p.build, t, Slice[Unit]{data: units.data, size: units.len}, Slice[mode.Setting]{data: ?modes[0], size: count}, c.x.p.isa.shorts, opt_into, opt[*timed.Marks].some{?marks}, o.stats, o.name, o.unwind);
    if (sel res_made.err) { ret res[object.Object, Error].err{Error.emit{res_made.err}}; }
    var obj: object.Object = res_made.ok;
    module.lent_to(c.m, ?obj.names);
    val err_cleared: err[Error] = walked(c, t, done, ?obj, ?marks);
    if (sel err_cleared.err) {
        module.take_back(c.m, ?obj);
        object.dnit(?obj);
        ret res[object.Object, Error].err{err_cleared.err};
    }
    val err_wrote: err[Error] = written(c, o, done, ?listed);
    if (sel err_wrote.err) {
        module.take_back(c.m, ?obj);
        object.dnit(?obj);
        ret res[object.Object, Error].err{err_wrote.err};
    }
    module.spent(c.m);
    ret res[object.Object, Error].ok{obj};
}

# compile a module for a register machine
# ---
# a:   the allocator every step and the object take
# m:   the module, after the pass schedule has run on it for the target
# b:   the target's build, which `prepare` made the state of, read and never
#      written
# t:   the target
# o:   whether it is checked, the texts it writes besides the object, whether
#      the linker may relax the code, which symbols are placed apart and
#      where the time and counts are added
# w:   the module's table, naming the selection each function is made under
# ret: mink's object in memory, or why it was not made and where
pub fun compile(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: Options, w: *Widenings) res[object.Object, Failed] {
    var x:          Session;
    val err_opened: err[Failed] = session_init(?x, a, m, b.state::*State, w);
    if (sel err_opened.err) { ret res[object.Object, Failed].err{err_opened.err}; }
    fin { session_dnit(?x); }
    var scratch: allocate.Scratch = allocate.scratch(a);
    fin { allocate.scratch_dnit(?scratch); }
    var c:    Context             = Context{a: a, m: m, x: ?x, checked: o.checked, stats: o.stats, scratch: ?scratch, optimized: o.optimise.on};
    var done: vector.Vector[Done] = vector.init[Done](a);
    fin { all_dnit(?done); }
    val err_compiled: err[Failed] = functions(?c, ?done);
    if (sel err_compiled.err) { ret res[object.Object, Failed].err{err_compiled.err}; }
    stats.closed(o.stats, stats.Stage.select{});
    stats.closed(o.stats, stats.Stage.alloc{});
    stats.closed(o.stats, stats.Stage.frame{});
    val opt_from: opt[Instant]              = stats.start(o.stats);
    val res_made: res[object.Object, Error] = emitted(?c, t, ?done, o);
    stats.stop(o.stats, stats.Stage.emit{}, opt_from);
    if (sel res_made.err) { ret res[object.Object, Failed].err{whole(res_made.err)}; }
    stats.closed(o.stats, stats.Stage.emit{});
    ret res[object.Object, Failed].ok{res_made.ok};
}
