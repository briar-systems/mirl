# the compilation of a module for a register machine, see doc/machine/emit.md
#
# this is the one entry a consumer of the library calls to turn a module the
# pass schedule has run on into mink's object in memory. every function with a
# body is selected with the convention's clobbers, allocated over the
# locations the machine allows, framed, its copies lowered to the set's moves,
# its loops expanded into their steps, laid out and handed to masc in one
# object. the target reaches its selection
# table, frame code and moves through the row of the set that serves it, so
# this names no set.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.object;

use mirl.ir.id;
use mirl.ir.module.Module;
use mirl.isa.rows;
use mirl.isa.rows.Row;
use mirl.machine.alloc.allocate;
use mirl.machine.alloc.allocate.Allocation;
use mirl.machine.alloc.allowed;
use mirl.machine.alloc.live.Clobber;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.copy.lower;
use mirl.machine.copy.move;
use mirl.machine.emit.handover;
use mirl.machine.emit.handover.Unit;
use mirl.machine.frame;
use mirl.machine.frame.finish;
use framing: mirl.machine.frame.lay;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Framed;
use mirl.machine.layout.lay;
use mirl.machine.layout.lay.Laid;
use mirl.machine.loop.expand;
use mirl.machine.select.engine;
use mirl.machine.select.engine.Calls;
use mirl.machine.select.engine.Selected;
use mirl.machine.select.engine.Selector;
use mirl.target.machine.Machine;
use mirl.target.record.Target;

# the stage that refused a function
# ---
# select:   selection
# pointer:  the frame's need of a pointer, which the allowed set reads
# allowed:  the listing of the locations the allocator may assign
# allocate: register allocation
# frame:    the frame
# copies:   the lowering of copies to the set's moves
# loops:    the expansion of loops into their steps
# layout:   block layout
pub tag Stage: u8 {
    select:   engine.Error;
    pointer:  framing.Error;
    allowed:  allowed.Failure;
    allocate: allocate.Error;
    frame:    finish.Error;
    copies:   lower.Error;
    loops:    expand.Error;
    layout:   lay.Error;
}

# a function and the stage that refused it
pub rec Failed {
    function: id.Function;
    stage:    Stage;
}

# why a module was not compiled
# ---
# alloc:     the allocator refused storage
# foreign:   the machine given was opened for another target than the one
#            given, and nothing was compiled
# row:       the target's architecture names no row of mink's catalog
# uncarried: the target states no convention or baseline, or mirl carries no
#            set for its architecture
# locations: the locations of the target's registers and memories were refused
# table:     the selection table was refused for the target
# moves:     the set's moves were refused for the target
# function:  a function was refused at a stage
# emit:      emission refused the laid out functions, naming the function of
#            an instruction it refuses
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    row: rows.Error;
    uncarried;
    locations: location.Error;
    table:     engine.Error;
    moves:     move.Error;
    function:  Failed;
    emit:      handover.Error;
}

# a function framed and laid out, waiting for emission
rec Done {
    function: id.Function;
    framed:   Framed;
    laid:     Laid;
}

# what every function's compilation reads
rec Context {
    a:     *allocator.Allocator;
    m:     *Module;
    mach:  *Machine;
    at:    *Locations;
    row:   *Row;
    s:     *Selector;
    moves: *move.Index;
}

fun release_all(done: *vector.Vector[Done]) {
    var i: usize = 0;
    for (i < done.len) {
        record.release(?done.data[i].framed);
        lay.release(?done.data[i].laid);
        i = i + 1;
    }
    vector.dnit[Done](done);
}

fun refuse(f: id.Function, s: Stage) res[Done, Failed] {
    ret res[Done, Failed].err{Failed{function: f, stage: s}};
}

# one function through selection, allocation, the frame, the lowering of its
# copies, the expansion of its loops and layout
fun through(c: *Context, f: id.Function) res[Done, Failed] {
    var calls:  Calls                       = Calls{clobbered: c.mach.convention.clobbered, at: c.at};
    val picked: res[Selected, engine.Error] = engine.select(c.s, c.m, f, ?calls);
    if (sel picked.err) { ret refuse(f, Stage.select{picked.err}); }
    var chosen: Selected = picked.ok;
    fin { engine.release(?chosen); }

    val r:     framing.Request          = framing.Request{convention: ?c.mach.convention, at: c.at};
    val keeps: res[bool, framing.Error] = framing.keeps_pointer(c.a, ?chosen.function, r);
    if (sel keeps.err) { ret refuse(f, Stage.pointer{keeps.err}); }
    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_machine(c.a, c.mach, c.at, keeps.ok);
    if (sel listed.err) { ret refuse(f, Stage.allowed{listed.err}); }
    var given: vector.Vector[Physical] = listed.ok;
    fin { vector.dnit[Physical](?given); }

    val request: allocate.Request = allocate.Request{
        at:        c.at,
        registers: ?c.mach.registers,
        allowed:   Slice[Physical]{data: given.data, size: given.len},
        clobbers:  Slice[Clobber]{data: chosen.clobbers.data, size: chosen.clobbers.len},
    };
    val done: res[Allocation, allocate.Error] = allocate.allocate(c.a, ?chosen.function, request);
    if (sel done.err) { ret refuse(f, Stage.allocate{done.err}); }
    var allocated: Allocation = done.ok;
    fin { allocate.release(?allocated); }

    val framed: res[Framed, finish.Error] = frame.frame(c.a, ?allocated, r, c.row.frame);
    if (sel framed.err) { ret refuse(f, Stage.frame{framed.err}); }
    var out:     Framed        = framed.ok;
    var copying: lower.Request = lower.Request{
        at:        c.at,
        registers: ?c.mach.registers,
        clobbered: c.mach.convention.clobbered,
        allowed:   Slice[Physical]{data: given.data, size: given.len},
        code:      c.row.frame,
        moves:     c.moves,
    };
    val copied: err[lower.Error] = lower.lower(c.a, ?out, ?copying);
    if (sel copied.err) {
        record.release(?out);
        ret refuse(f, Stage.copies{copied.err});
    }
    val expanded: err[expand.Error] = expand.expand(c.a, ?out);
    if (sel expanded.err) {
        record.release(?out);
        ret refuse(f, Stage.loops{expanded.err});
    }
    val laid: res[Laid, lay.Error] = lay.lay(c.a, ?out.function);
    if (sel laid.err) {
        record.release(?out);
        ret refuse(f, Stage.layout{laid.err});
    }
    ret res[Done, Failed].ok{Done{function: f, framed: out, laid: laid.ok}};
}

# every function with a body, compiled and kept for emission
fun functions(c: *Context, done: *vector.Vector[Done]) err[Error] {
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0) {
            val one: res[Done, Failed] = through(c, id.Function{index: k});
            if (sel one.err) { ret err[Error].err{Error.function{one.err}}; }
            var kept:   Done                        = one.ok;
            val pushed: res[usize, allocator.Error] = vector.push[Done](done, kept);
            if (sel pushed.err) {
                record.release(?kept.framed);
                lay.release(?kept.laid);
                ret err[Error].err{Error.alloc{pushed.err}};
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# hand the compiled functions to masc
fun emitted(c: *Context, t: *Target, done: *vector.Vector[Done]) res[object.Object, Error] {
    var units: vector.Vector[Unit] = vector.init[Unit](c.a);
    fin { vector.dnit[Unit](?units); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Unit](?units, Unit{function: d.function, code: ?d.framed.function, laid: ?d.laid});
        if (sel pushed.err) { ret res[object.Object, Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val made: res[object.Object, handover.Error] = handover.emit(c.a, c.m, c.mach, t, Slice[Unit]{data: units.data, size: units.len});
    if (sel made.err) { ret res[object.Object, Error].err{Error.emit{made.err}}; }
    ret res[object.Object, Error].ok{made.ok};
}

# compile a module for a register machine
# ---
# a:    the allocator every stage and the object take
# m:    the module, after the pass schedule has run on it for the target
# mach: the target's machine, opened for `t`
# t:    the target
# ret:  mink's object in memory, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, mach: *Machine, t: *Target) res[object.Object, Error] {
    if (mach.target != t) { ret res[object.Object, Error].err{Error.foreign{}}; }
    val indexed: res[rows.Index, allocator.Error] = rows.index(a);
    if (sel indexed.err) { ret res[object.Object, Error].err{Error.alloc{indexed.err}}; }
    var index: rows.Index = indexed.ok;
    fin { rows.dnit(?index); }
    val found: res[opt[*Row], rows.Error] = rows.for_target(?index, t);
    if (sel found.err)     { ret res[object.Object, Error].err{Error.row{found.err}}; }
    if (sel found.ok.none) { ret res[object.Object, Error].err{Error.uncarried{}}; }

    var memories: vector.Vector[*Memory] = vector.init[*Memory](a);
    fin { vector.dnit[*Memory](?memories); }
    var i: usize = 0;
    for (i < t.memories.size) {
        val pushed: res[usize, allocator.Error] = vector.push[*Memory](?memories, ?t.memories.data[i]);
        if (sel pushed.err) { ret res[object.Object, Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val located: res[Locations, location.Error] = location.init(a, mach.registers.file, Slice[*Memory]{data: memories.data, size: memories.len});
    if (sel located.err) { ret res[object.Object, Error].err{Error.locations{located.err}}; }
    var at: Locations = located.ok;
    fin { location.dnit(?at); }

    val row:  *Row                        = found.ok.some;
    val made: res[Selector, engine.Error] = engine.init(a, row.table, t, mach.basis.set, ?mach.basis.selection);
    if (sel made.err) { ret res[object.Object, Error].err{Error.table{made.err}}; }
    var s: Selector = made.ok;
    fin { engine.dnit(?s); }

    val indexed_moves: res[move.Index, move.Error] = move.index(a, row.moves, ?at, ?mach.registers);
    if (sel indexed_moves.err) { ret res[object.Object, Error].err{Error.moves{indexed_moves.err}}; }
    var moves: move.Index = indexed_moves.ok;
    fin { move.dnit(?moves); }

    var c:    Context             = Context{a: a, m: m, mach: mach, at: ?at, row: row, s: ?s, moves: ?moves};
    var done: vector.Vector[Done] = vector.init[Done](a);
    fin { release_all(?done); }
    val compiled: err[Error] = functions(?c, ?done);
    if (sel compiled.err) { ret res[object.Object, Error].err{compiled.err}; }
    ret emitted(?c, t, ?done);
}
