# the compilation of a module for a register machine, see doc/machine/emit.md
#
# this is the one entry a consumer of the library calls to turn a module the
# pass schedule has run on into mink's object in memory. every function with a
# body goes through the steps of STAGES in order: selection with the
# convention's clobbers, allocation over the locations the machine allows, the
# frame, the lowering of copies to the set's moves, the expansion of loops into
# their steps and layout. the laid out functions are handed to masc in one
# object. the sequence is stated once, here, and the machine corpus walk runs
# it through the same `through`, so a step is added in one place. the target
# reaches its selection table, frame code and moves through the row of the set
# that serves it, so this names no set. a checked compilation verifies every
# function after every step, and the machine form text and masc's listing are
# written when asked.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.model.object;

use mirl.ir.id;
use mirl.ir.module.Module;
use mirl.machine.alloc.allocate;
use mirl.machine.alloc.allocate.Allocation;
use mirl.machine.alloc.allowed;
use mirl.machine.alloc.live.Clobber;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.copy.lower;
use mirl.machine.copy.move;
use mirl.machine.emit.handover;
use mirl.machine.emit.handover.Unit;
use mirl.machine.frame;
use mirl.machine.frame.code;
use mirl.machine.frame.finish;
use framing: mirl.machine.frame.lay;
use mirl.machine.frame.record;
use mirl.machine.frame.record.Framed;
use mirl.machine.function.Function;
use mirl.machine.layout.lay;
use mirl.machine.layout.lay.Laid;
use mirl.machine.loop.expand;
use mirl.machine.select.engine;
use mirl.machine.select.engine.Calls;
use mirl.machine.select.engine.Selected;
use mirl.machine.select.engine.Selector;
use mtext: mirl.machine.text;
use mirl.machine.text.Item;
use mirl.machine.verify;
use mirl.target.record.Target;
use mirl.target.register.isa;
use mirl.target.register.isa.Row;
use mirl.target.register.machine.Machine;

# what a compilation does besides making the object
# ---
# checked: verify every function after every step, as every build that tests does
# machine: where the machine form text of the laid out functions is written, none for none
# listing: where masc's listing of the object is written, none for none
pub rec Options {
    checked: bool;
    machine: opt[*io.Writer];
    listing: opt[*io.Writer];
}

# what refused a function
# ---
# select:     selection
# pointer:    the frame's need of a pointer, which the allowed set reads
# allowed:    the listing of the locations the allocator may assign
# allocate:   register allocation
# frame:      the frame
# copies:     the lowering of copies to the set's moves
# loops:      the expansion of loops into their steps
# layout:     block layout
# verify:     the verifier, after the step
# watched:    the watch of the compilation, after the step
# misplaced:  the step reads a form of the function the steps before it did
#             not leave
# unfinished: the steps ended before the function was laid out
pub tag Stage: u8 {
    select:   engine.Error;
    pointer:  framing.Error;
    allowed:  allowed.Failure;
    allocate: allocate.Error;
    frame:    finish.Error;
    copies:   lower.Error;
    loops:    expand.Error;
    layout:   lay.Error;
    verify:   verify.Error;
    watched;
    misplaced;
    unfinished;
}

# a function and what refused it
# ---
# function: the function
# step:     the name of the step it was refused at or after, none when the
#           steps ended before it was laid out
# stage:    what refused it
pub rec Failed {
    function: id.Function;
    step:     opt[str];
    stage:    Stage;
}

# why a module was not compiled
# ---
# alloc:     the allocator refused storage
# foreign:   the machine given was opened for another target than the one
#            given, and nothing was compiled
# uncarried: the target states no convention, or mirl carries no selection
#            table for its machine's instruction set
# locations: the locations of the target's registers and memories were refused
# table:     the selection table was refused for the target
# moves:     the set's moves were refused for the target
# code:      the frame code was not bound to the target's selection
# function:  a function was refused at a step
# emit:      emission refused the laid out functions, naming the function of
#            an instruction it refuses
# machine:   the machine form text was not printed
# write:     the listing was not written
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    uncarried;
    locations: location.Error;
    table:     engine.Error;
    moves:     move.Error;
    code:      code.Error;
    function:  Failed;
    emit:      handover.Error;
    machine:   mtext.Error;
    write:     io.WriteError;
}

# what a compilation opens of its target once, before any function
# ---
# mach:  the target's machine
# row:   the target's row of mirl.target.register.isa
# at:    the locations of the machine's registers and the target's memories
# s:     the selector over the row's table
# moves: the set's moves over the locations
# code:  the row's frame code bound to the machine's selection
pub rec Session {
    mach:  *Machine;
    row:   *Row;
    at:    Locations;
    s:     Selector;
    moves: move.Index;
    code:  code.Admitted;
}

# what every step reads
# ---
# a:       the allocator every step takes
# m:       the module
# x:       the session of its target
# checked: whether every function is verified after every step
pub rec Context {
    a:       *allocator.Allocator;
    m:       *Module;
    x:       *Session;
    checked: bool;
}

# a function allocated, with what its allocation read
# ---
# chosen:     the selected function and the clobbers of its calls
# given:      the locations the allocator was allowed, which the lowering of
#             copies reads again
# allocation: the allocated function
pub rec Allocated {
    chosen:     Selected;
    given:      vector.Vector[Physical];
    allocation: Allocation;
}

# a function framed, with the locations its allocation was allowed
pub rec Framing {
    given:  vector.Vector[Physical];
    framed: Framed;
}

# a function framed and laid out, waiting for emission
pub rec Done {
    function: id.Function;
    framed:   Framed;
    laid:     Laid;
}

# the form a function is in between steps
# ---
# source:    the ir, nothing made yet
# selected:  selected
# allocated: allocated
# framed:    framed, then with its copies lowered and its loops expanded
# laid:      laid out
pub tag Form: u8 {
    source;
    selected:  Selected;
    allocated: Allocated;
    framed:    Framing;
    laid:      Done;
}

# a function partway through the steps, which owns what its form holds
pub rec Work {
    function: id.Function;
    form:     Form;
}

# a step, which reads the form the steps before it left and gives the one it
# leaves, or refuses and leaves the form as it found it
pub def Run: fun(*Context, *Work) res[Form, Stage];

# a step of the sequence
# ---
# name: what the step is called, which a refusal names and a watch reads
# run:  the step
pub rec Step {
    name: str;
    run:  Run;
}

# what looks at a function after each step, besides the verifier
# ---
# data: what the look reads, handed back to it
# seen: the look after the step at an index of the sequence, true when the
#       function holds
pub def Seen: fun(ptr, usize, *Step, *Work) bool;

# a look at every function after every step
pub rec Watch {
    data: ptr;
    seen: Seen;
}

# give back what a function's form holds and leave it as the ir
pub fun release(w: *Work) {
    if (sel w.form.selected) { engine.release(?w.form.selected); }
    or (sel w.form.allocated) {
        allocate.release(?w.form.allocated.allocation);
        vector.dnit[Physical](?w.form.allocated.given);
        engine.release(?w.form.allocated.chosen);
    }
    or (sel w.form.framed) {
        record.release(?w.form.framed.framed);
        vector.dnit[Physical](?w.form.framed.given);
    }
    or (sel w.form.laid) { release_done(?w.form.laid); }
    w.form = Form.source{};
}

# give back a laid out function
pub fun release_done(d: *Done) {
    record.release(?d.framed);
    lay.release(?d.laid);
}

fun select_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.source)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    var calls:  Calls                       = Calls{clobbered: c.x.mach.convention.clobbered, at: ?c.x.at};
    val picked: res[Selected, engine.Error] = engine.select(?c.x.s, c.m, w.function, ?calls);
    if (sel picked.err) { ret res[Form, Stage].err{Stage.select{picked.err}}; }
    ret res[Form, Stage].ok{Form.selected{picked.ok}};
}

fun request(c: *Context) framing.Request {
    ret framing.Request{convention: ?c.x.mach.convention, at: ?c.x.at};
}

fun allocate_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.selected)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val chosen: Selected                 = w.form.selected;
    val keeps:  res[bool, framing.Error] = framing.keeps_pointer(c.a, ?chosen.function, request(c));
    if (sel keeps.err) { ret res[Form, Stage].err{Stage.pointer{keeps.err}}; }
    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_machine(c.a, c.x.mach, ?c.x.at, keeps.ok);
    if (sel listed.err) { ret res[Form, Stage].err{Stage.allowed{listed.err}}; }
    var given: vector.Vector[Physical] = listed.ok;

    val r: allocate.Request = allocate.Request{
        at:        ?c.x.at,
        registers: ?c.x.mach.registers,
        allowed:   Slice[Physical]{data: given.data, size: given.len},
        clobbers:  Slice[Clobber]{data: chosen.clobbers.data, size: chosen.clobbers.len},
    };
    val done: res[Allocation, allocate.Error] = allocate.allocate(c.a, ?chosen.function, r);
    if (sel done.err) {
        vector.dnit[Physical](?given);
        ret res[Form, Stage].err{Stage.allocate{done.err}};
    }
    ret res[Form, Stage].ok{Form.allocated{Allocated{chosen: chosen, given: given, allocation: done.ok}}};
}

fun frame_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.allocated)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    var held:   Allocated                 = w.form.allocated;
    val framed: res[Framed, finish.Error] = frame.frame(c.a, ?held.allocation, request(c), ?c.x.code);
    if (sel framed.err) { ret res[Form, Stage].err{Stage.frame{framed.err}}; }
    allocate.release(?held.allocation);
    engine.release(?held.chosen);
    ret res[Form, Stage].ok{Form.framed{Framing{given: held.given, framed: framed.ok}}};
}

fun copies_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val f: *Framing      = ?w.form.framed;
    var r: lower.Request = lower.Request{
        at:        ?c.x.at,
        registers: ?c.x.mach.registers,
        clobbered: c.x.mach.convention.clobbered,
        allowed:   Slice[Physical]{data: f.given.data, size: f.given.len},
        code:      ?c.x.code,
        moves:     ?c.x.moves,
    };
    val copied: err[lower.Error] = lower.lower(c.a, ?f.framed, ?r);
    if (sel copied.err) { ret res[Form, Stage].err{Stage.copies{copied.err}}; }
    ret res[Form, Stage].ok{w.form};
}

fun loops_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val expanded: err[expand.Error] = expand.expand(c.a, ?w.form.framed.framed);
    if (sel expanded.err) { ret res[Form, Stage].err{Stage.loops{expanded.err}}; }
    ret res[Form, Stage].ok{w.form};
}

fun layout_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    var held: Framing              = w.form.framed;
    val laid: res[Laid, lay.Error] = lay.lay(c.a, ?held.framed.function);
    if (sel laid.err) { ret res[Form, Stage].err{Stage.layout{laid.err}}; }
    vector.dnit[Physical](?held.given);
    ret res[Form, Stage].ok{Form.laid{Done{function: w.function, framed: held.framed, laid: laid.ok}}};
}

# the steps every function goes through, in order
pub val STAGES: [6]Step = [6]Step{
    Step{name: "select", run: select_step},
    Step{name: "allocate", run: allocate_step},
    Step{name: "frame", run: frame_step},
    Step{name: "copies", run: copies_step},
    Step{name: "loops", run: loops_step},
    Step{name: "layout", run: layout_step},
};

# the steps of STAGES as a sequence
pub fun stages() Slice[Step] {
    ret Slice[Step]{data: ?STAGES[0], size: $length_of(STAGES)};
}

# the machine function a form holds, none for the ir
fun code_of(w: *Work) opt[*Function] {
    if (sel w.form.selected)  { ret opt[*Function].some{?w.form.selected.function}; }
    if (sel w.form.allocated) { ret opt[*Function].some{?w.form.allocated.allocation.function}; }
    if (sel w.form.framed)    { ret opt[*Function].some{?w.form.framed.framed.function}; }
    if (sel w.form.laid)      { ret opt[*Function].some{?w.form.laid.framed.function}; }
    ret opt[*Function].none{};
}

fun refuse(w: *Work, step: opt[str], s: Stage) res[Done, Failed] {
    release(w);
    ret res[Done, Failed].err{Failed{function: w.function, step: step, stage: s}};
}

# one function through a sequence of steps, verified after each when the
# compilation is checked and looked at by the watch when there is one
# ---
# c:     what every step reads
# steps: the sequence, STAGES for every compilation
# f:     the function
# watch: what looks at the function after every step, none for none
# ret:   the function laid out, or the step that refused it, leaving nothing
#        to release
pub fun through(c: *Context, steps: Slice[Step], f: id.Function, watch: opt[*Watch]) res[Done, Failed] {
    var w: Work  = Work{function: f, form: Form.source{}};
    var i: usize = 0;
    for (i < steps.size) {
        val step: *Step            = ?steps.data[i];
        val name: opt[str]         = opt[str].some{step.name};
        val ran:  res[Form, Stage] = step.run(c, ?w);
        if (sel ran.err) { ret refuse(?w, name, ran.err); }
        w.form = ran.ok;
        if (c.checked) {
            val code: opt[*Function] = code_of(?w);
            if (sel code.some) {
                val v: err[verify.Error] = verify.function(c.a, code.some);
                if (sel v.err) { ret refuse(?w, name, Stage.verify{v.err}); }
            }
        }
        if (sel watch.some) {
            if (!watch.some.seen(watch.some.data, i, step, ?w)) { ret refuse(?w, name, Stage.watched{}); }
        }
        i = i + 1;
    }
    if (sel w.form.laid) { ret res[Done, Failed].ok{w.form.laid}; }
    ret refuse(?w, opt[str].none{}, Stage.unfinished{});
}

# open the session of a target in place
# ---
# x:    where it is made, and stays until `close`
# a:    the allocator its storage comes from
# mach: the target's machine, opened for `t`
# t:    the target
# ret:  ok, or why it was not made, leaving nothing to close
pub fun open(x: *Session, a: *allocator.Allocator, mach: *Machine, t: *Target) err[Error] {
    if (mach.basis.target != t) { ret err[Error].err{Error.foreign{}}; }
    val found: opt[*Row] = isa.of(mach.basis.set);
    if (sel found.none) { ret err[Error].err{Error.uncarried{}}; }
    x.mach = mach;
    x.row  = found.some;

    var memories: vector.Vector[*Memory] = vector.init[*Memory](a);
    fin { vector.dnit[*Memory](?memories); }
    var i: usize = 0;
    for (i < x.row.memories.size) {
        val pushed: res[usize, allocator.Error] = vector.push[*Memory](?memories, ?x.row.memories.data[i]);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val located: res[Locations, location.Error] = location.init(a, mach.registers.file, Slice[*Memory]{data: memories.data, size: memories.len});
    if (sel located.err) { ret err[Error].err{Error.locations{located.err}}; }
    x.at = located.ok;

    val made: res[Selector, engine.Error] = engine.init(a, x.row.table, t, mach.basis.set, ?mach.basis.selection);
    if (sel made.err) {
        location.dnit(?x.at);
        ret err[Error].err{Error.table{made.err}};
    }
    x.s = made.ok;

    val moves: res[move.Index, move.Error] = move.index(a, x.row.moves, ?x.at, ?mach.registers);
    if (sel moves.err) {
        engine.dnit(?x.s);
        location.dnit(?x.at);
        ret err[Error].err{Error.moves{moves.err}};
    }
    x.moves = moves.ok;

    val bound: res[code.Admitted, code.Error] = code.admit(a, x.row.frame, ?mach.registers);
    if (sel bound.err) {
        move.dnit(?x.moves);
        engine.dnit(?x.s);
        location.dnit(?x.at);
        ret err[Error].err{Error.code{bound.err}};
    }
    x.code = bound.ok;
    ret err[Error].ok{};
}

# give back a session's storage
pub fun close(x: *Session) {
    code.dnit(?x.code);
    move.dnit(?x.moves);
    engine.dnit(?x.s);
    location.dnit(?x.at);
}

fun release_all(done: *vector.Vector[Done]) {
    var i: usize = 0;
    for (i < done.len) {
        release_done(?done.data[i]);
        i = i + 1;
    }
    vector.dnit[Done](done);
}

# every function with a body, compiled and kept for emission
fun functions(c: *Context, done: *vector.Vector[Done]) err[Error] {
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0) {
            val one: res[Done, Failed] = through(c, stages(), id.Function{index: k}, opt[*Watch].none{});
            if (sel one.err) { ret err[Error].err{Error.function{one.err}}; }
            var kept:   Done                        = one.ok;
            val pushed: res[usize, allocator.Error] = vector.push[Done](done, kept);
            if (sel pushed.err) {
                release_done(?kept);
                ret err[Error].err{Error.alloc{pushed.err}};
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the machine form text of the compiled functions
fun printed(c: *Context, w: *io.Writer, done: *vector.Vector[Done]) err[Error] {
    var items: vector.Vector[Item] = vector.init[Item](c.a);
    fin { vector.dnit[Item](?items); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Item](?items, Item{symbol: id.Symbol.function{d.function}, function: d.framed.function});
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val wrote: err[mtext.Error] = mtext.print(w, c.m, Slice[Item]{data: items.data, size: items.len});
    if (sel wrote.err) { ret err[Error].err{Error.machine{wrote.err}}; }
    ret err[Error].ok{};
}

# the texts asked for, written once the object is made, so a refused
# compilation writes nothing
fun written(c: *Context, o: Options, done: *vector.Vector[Done], listed: *vector.Vector[u8]) err[Error] {
    if (sel o.machine.some) {
        val shown: err[Error] = printed(c, o.machine.some, done);
        if (sel shown.err) { ret shown; }
    }
    if (sel o.listing.some) {
        val wrote: err[io.WriteError] = io.write_all(o.listing.some, listed.data, listed.len);
        if (sel wrote.err) { ret err[Error].err{Error.write{wrote.err}}; }
    }
    ret err[Error].ok{};
}

# hand the compiled functions to masc, then write the texts asked for
fun emitted(c: *Context, t: *Target, done: *vector.Vector[Done], o: Options) res[object.Object, Error] {
    var units: vector.Vector[Unit] = vector.init[Unit](c.a);
    fin { vector.dnit[Unit](?units); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Unit](?units, Unit{function: d.function, code: ?d.framed.function, laid: ?d.laid});
        if (sel pushed.err) { ret res[object.Object, Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    var listed: vector.Vector[u8] = vector.init[u8](c.a);
    fin { vector.dnit[u8](?listed); }
    var into: opt[*vector.Vector[u8]] = opt[*vector.Vector[u8]].none{};
    if (sel o.listing.some) { into = opt[*vector.Vector[u8]].some{?listed}; }
    val made: res[object.Object, handover.Error] = handover.emit(c.a, c.m, c.x.mach, t, Slice[Unit]{data: units.data, size: units.len}, into);
    if (sel made.err) { ret res[object.Object, Error].err{Error.emit{made.err}}; }
    val wrote: err[Error] = written(c, o, done, ?listed);
    if (sel wrote.err) {
        var obj: object.Object = made.ok;
        object.release(?obj);
        ret res[object.Object, Error].err{wrote.err};
    }
    ret res[object.Object, Error].ok{made.ok};
}

# compile a module for a register machine
# ---
# a:    the allocator every step and the object take
# m:    the module, after the pass schedule has run on it for the target
# mach: the target's machine, opened for `t`
# t:    the target
# o:    whether it is checked, and the texts it writes besides the object
# ret:  mink's object in memory, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, mach: *Machine, t: *Target, o: Options) res[object.Object, Error] {
    var x:      Session;
    val opened: err[Error] = open(?x, a, mach, t);
    if (sel opened.err) { ret res[object.Object, Error].err{opened.err}; }
    fin { close(?x); }
    var c:    Context             = Context{a: a, m: m, x: ?x, checked: o.checked};
    var done: vector.Vector[Done] = vector.init[Done](a);
    fin { release_all(?done); }
    val compiled: err[Error] = functions(?c, ?done);
    if (sel compiled.err) { ret res[object.Object, Error].err{compiled.err}; }
    ret emitted(?c, t, ?done, o);
}
