# what a compilation does besides making the object
# ---
# checked: verify every function after every step
# machine: where the machine form text of the laid out functions is written, none for none
# listing: where masc's listing of the object is written, none for none
# relax:   whether the linker may relax the code, handed to the set's relax
#          mode, which a set with none ignores
pub rec Options {
    checked: bool;
    machine: opt[*io.Writer];
    listing: opt[*io.Writer];
    relax:   bool;
}

# what refused a function
# ---
# select:     selection
# timing:     the constant-time check found a secret where the function,
#             which requires constant time, may hold none
# pointer:    the frame's need of a pointer, which the allowed set reads
# allowed:    the listing of the locations the allocator may assign
# allocate:   register allocation
# frame:      the frame
# copies:     the lowering of copies to the set's moves
# configure:  the insertion of the instructions establishing the states the
#             instructions run under
# loops:      the expansion of loops into their steps
# layout:     block layout
# ranges:     the reading of where each variable is over the framed code,
#             before layout
# verify:     the verifier, after the step
# watched:    the watch of the compilation, after the step
# misplaced:  the step reads a form of the function the steps before it did
#             not leave
# unfinished: the steps ended before the function was laid out
# convention: the function or a call it makes is under a convention row other
#             than the target's default, whose clobbers, preserved registers
#             and frame the machine does not lower per row yet
pub tag Stage: u8 {
    select:    engine.Error;
    timing:    timing.Found;
    alloc:     allocator.Error;
    pointer:   framing.Error;
    allowed:   allowed.Failure;
    allocate:  allocate.Error;
    frame:     finish.Error;
    copies:    lower.Error;
    configure: configure.Error;
    loops:     expand.Error;
    layout:    lay.Error;
    ranges:    range.Error;
    verify:    verify.Error;
    watched;
    misplaced;
    unfinished;
    convention;
}

# a function whose extensions past the build's were not opened, and why
# ---
# function: the function
# error:    why the widened selection or its context was not made
pub rec Widening {
    function: id.Function;
    error:    target_basis.Error;
}

# a function and what refused it
# ---
# function: the function
# step:     the name of the step it was refused at or after, none when the
#           steps ended before it was laid out
# stage:    what refused it
# location: the source location of the instruction what refused it names,
#           none when it names none or the instruction states none
pub rec Failed {
    function: id.Function;
    step:     opt[str];
    stage:    Stage;
    location: opt[Location];
}

# why a module was not compiled
# ---
# alloc:     the allocator refused storage
# foreign:   the build given was opened for another target than the one
#            given, and nothing was compiled
# uncarried: the registry carries no record of the build's instruction set
# locations: the locations of the target's registers and memories were refused
# table:     the selection table was refused for the target
# moves:     the set's moves were refused for the target
# code:      the frame code was not bound to the target's selection
# function:  a function was refused at a step
# widening:  the extensions a function names past the build's were not
#            opened, and nothing was compiled
# emit:      emission refused the laid out functions, naming the function of
#            an instruction it refuses
# timing:    the walk of a constant-time function's encoded code found a
#            secret where it may hold none, or could not follow the code
# mark:      the object refused the mark of a timing mode the code needs
# machine:   the machine form text was not printed
# write:     the listing was not written
pub tag Error: u8 {
    alloc: allocator.Error;
    foreign;
    uncarried;
    locations: location.Error;
    table:     engine.Error;
    moves:     move.Error;
    code:      code.Error;
    function:  Failed;
    widening:  Widening;
    emit:      handover.Error;
    timing:    mct.Unmet;
    mark:      Fail;
    machine:   mtext.Error;
    write:     io.WriteError;
}

# what one function's code is made under
# ---
# context: the build's context, or the one its extensions past the build's open
# moves:   the set's moves indexed under that context
# code:    the frame code bound to that context
pub rec Scope {
    context: *core_state.Context;
    moves:   *move.Index;
    code:    *code.Admitted;
}

# a set of extensions functions name past the build's, opened once
# ---
# widened: the build's selection widened by the set, and its context
# moves:   the set's moves indexed under that context
# code:    the frame code bound to that context
pub rec Under {
    widened: target_basis.Widened;
    moves:   move.Index;
    code:    code.Admitted;
}

# no set past the build's, a function made under the build's context
val BUILD_WIDE: u32 = 0xffffffff;

# what a compilation opens of its target once, before any function
# ---
# build:  the target's build, which the register family opened
# isas:   the registry the family handed in, which the machine text reads too
# isa:    the record of the build's instruction set in it
# at:     the locations of the machine's registers and the target's memories
# s:      the selector over the record's table
# moves:  the set's moves over the locations
# code:   the record's frame code bound to the machine's selection
# unders: each distinct set of extensions a function names past the build's
# scopes: per function of the module, the index of its set in `unders`,
#         BUILD_WIDE for none
pub rec Session {
    build:  *Build;
    isas:   *Isas;
    isa:    *Isa;
    at:     Locations;
    s:      Selector;
    moves:  move.Index;
    code:   code.Admitted;
    unders: vector.Vector[*Under];
    scopes: vector.Vector[u32];
}

# what every step reads
# ---
# a:       the allocator every step takes
# m:       the module
# x:       the session of its target
# checked: whether every function is verified after every step
pub rec Context {
    a:       *allocator.Allocator;
    m:       *Module;
    x:       *Session;
    checked: bool;
}

# a function allocated, with what its allocation read
# ---
# chosen:     the selected function and the clobbers of its calls
# given:      the locations the allocator was allowed, which the lowering of
#             copies reads again
# allocation: the allocated function
pub rec Allocated {
    chosen:     Selected;
    given:      vector.Vector[Physical];
    allocation: Allocation;
}

# a function framed, with the locations its allocation was allowed
pub rec Framing {
    given:  vector.Vector[Physical];
    framed: Framed;
}

# a function framed and laid out, waiting for emission
# ---
# function: the function of the module it is the code of
# context:  the context its code was made under, which it is handed over and
#           walked under
# framed:   the framed function, laid out
# laid:     the order its blocks are emitted in
# ranges:   where each of its variables is over its code
pub rec Done {
    function: id.Function;
    context:  *core_state.Context;
    framed:   Framed;
    laid:     Laid;
    ranges:   Ranges;
}

# the form a function is in between steps
# ---
# source:    the ir, nothing made yet
# selected:  selected
# allocated: allocated
# framed:    framed, then with its copies lowered and its loops expanded
# laid:      laid out
pub tag Form: u8 {
    source;
    selected:  Selected;
    allocated: Allocated;
    framed:    Framing;
    laid:      Done;
}

# a function partway through the steps, which owns what its form holds
pub rec Work {
    function: id.Function;
    form:     Form;
}

# a step, which reads the form the steps before it left and gives the one it
# leaves, or refuses and leaves the form as it found it
pub def Run: fun(*Context, *Work) res[Form, Stage];

# a step of the sequence
# ---
# name: what the step is called, which a refusal names and a watch reads
# run:  the step
pub rec Step {
    name: str;
    run:  Run;
}

# what looks at a function after each step, besides the verifier
# ---
# data: what the look reads, handed back to it
# seen: the look after the step at an index of the sequence, true when the
#       function holds
pub def Seen: fun(ptr, usize, *Step, *Work) bool;

# a look at every function after every step
pub rec Watch {
    data: ptr;
    seen: Seen;
}

# give back what a function's form holds and leave it as the ir
pub fun release(w: *Work) {
    if (sel w.form.selected) { engine.release(?w.form.selected); }
    or (sel w.form.allocated) {
        allocate.release(?w.form.allocated.allocation);
        vector.dnit[Physical](?w.form.allocated.given);
        engine.release(?w.form.allocated.chosen);
    }
    or (sel w.form.framed) {
        record.release(?w.form.framed.framed);
        vector.dnit[Physical](?w.form.framed.given);
    }
    or (sel w.form.laid) { release_done(?w.form.laid); }
    w.form = Form.source{};
}

# give back a laid out function
pub fun release_done(d: *Done) {
    record.release(?d.framed);
    lay.release(?d.laid);
    range.release(?d.ranges);
}

# whether a signature is under the target's default convention row
fun under_default(c: *Context, ty: types.Type) bool {
    val s: res[types.Function, types.Error] = types.signature(?c.m.types, ty);
    if (sel s.err) { ret false; }
    val row: opt[*Resolved] = build_record.under(c.x.build, s.ok.convention);
    ret sel row.some && row.some == build_record.default_row(c.x.build);
}

# whether a function is under the target's default convention row, whose
# frame and saves the frame stages read. a call it makes may run under any
# row the target states, which the selection reads its clobbers from
fun defaulted(c: *Context, f: id.Function) bool {
    ret under_default(c, c.m.functions.data[f.index].data.signature);
}

# what a function's code is made under: the build's context, moves and frame
# code, or those of the set of extensions it names past the build's
pub fun scope(x: *Session, f: id.Function) Scope {
    var at: u32 = BUILD_WIDE;
    if (f.index::usize < x.scopes.len) { at = x.scopes.data[f.index]; }
    if (at == BUILD_WIDE)              { ret Scope{context: build_record.registers(x.build).context, moves: ?x.moves, code: ?x.code}; }
    val u: *Under = x.unders.data[at];
    ret Scope{context: ?u.widened.context, moves: ?u.moves, code: ?u.code};
}

fun select_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.source))      { ret res[Form, Stage].err{Stage.misplaced{}}; }
    if (!defaulted(c, w.function)) { ret res[Form, Stage].err{Stage.convention{}}; }
    var calls:  Calls                       = Calls{rows: c.x.build.conventions, at: ?c.x.at};
    val picked: res[Selected, engine.Error] = engine.select(?c.x.s, c.m, w.function, ?calls, scope(c.x, w.function).context);
    if (sel picked.err) { ret res[Form, Stage].err{Stage.select{picked.err}}; }
    ret res[Form, Stage].ok{Form.selected{picked.ok}};
}

# the constant-time check of a selected function that requires constant time,
# under the context its code is made under
fun timing_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.selected))                                   { ret res[Form, Stage].err{Stage.misplaced{}}; }
    if (!c.m.functions.data[w.function.index].data.constant_time) { ret res[Form, Stage].ok{w.form}; }
    val found: res[opt[timing.Found], allocator.Error] = timing.check(c.a, ?w.form.selected.function, scope(c.x, w.function).context);
    if (sel found.err)     { ret res[Form, Stage].err{Stage.alloc{found.err}}; }
    if (sel found.ok.some) { ret res[Form, Stage].err{Stage.timing{found.ok.some}}; }
    ret res[Form, Stage].ok{w.form};
}

# the frame's request, with the module's symbol for the convention's probe
# routine, which the convention lowering declares
fun request(c: *Context) framing.Request {
    val row:    *Resolved      = build_record.default_row(c.x.build);
    var helper: opt[id.Symbol] = opt[id.Symbol].none{};
    val name:   opt[str]       = convention.probe_helper(row.row);
    if (sel name.some) { helper = module.find(c.m, View{data: name.some, len: str_len(name.some)}); }
    ret framing.Request{convention: row, at: ?c.x.at, helper: helper};
}

# the classes the table's holds give a policy that never spills a value
fun unspilled(c: *Context, out: *vector.Vector[Class]) err[allocator.Error] {
    val holds: rule.Holds = c.x.isa.table.holds;
    val file:  *rf.File   = c.x.at.file;
    var i:     u32        = 0;
    for (i < holds.len) {
        val spill: Spill      = holds.at[i].policy.spill;
        val k:     opt[Class] = rule.holder_class(file, holds.at[i].holder);
        if (sel spill.never) {
            if (sel k.some) {
                val pushed: res[usize, allocator.Error] = vector.push[Class](out, k.some);
                if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun allocate_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.selected)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val chosen: Selected                 = w.form.selected;
    val keeps:  res[bool, framing.Error] = framing.keeps_pointer(c.a, ?chosen.function, request(c));
    if (sel keeps.err) { ret res[Form, Stage].err{Stage.pointer{keeps.err}}; }
    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_build(c.a, c.x.build, ?c.x.at, keeps.ok);
    if (sel listed.err) { ret res[Form, Stage].err{Stage.allowed{listed.err}}; }
    var given: vector.Vector[Physical] = listed.ok;

    var never: vector.Vector[Class] = vector.init[Class](c.a);
    fin { vector.dnit[Class](?never); }
    val kept: err[allocator.Error] = unspilled(c, ?never);
    if (sel kept.err) {
        vector.dnit[Physical](?given);
        ret res[Form, Stage].err{Stage.allocate{allocate.Error.alloc{kept.err}}};
    }
    val r: allocate.Request = allocate.Request{
        at:        ?c.x.at,
        context:   scope(c.x, w.function).context,
        allowed:   Slice[Physical]{data: given.data, size: given.len},
        clobbers:  Slice[Clobber]{data: chosen.clobbers.data, size: chosen.clobbers.len},
        unspilled: Slice[Class]{data: never.data, size: never.len},
    };
    val done: res[Allocation, allocate.Error] = allocate.allocate(c.a, ?chosen.function, r);
    if (sel done.err) {
        vector.dnit[Physical](?given);
        ret res[Form, Stage].err{Stage.allocate{done.err}};
    }
    var allocation: Allocation = done.ok;
    if (c.m.functions.data[w.function.index].data.constant_time) {
        val marked: err[allocator.Error] = timing.mark_slots(c.a, ?w.form.selected.function, ?allocation.function);
        if (sel marked.err) {
            allocate.release(?allocation);
            vector.dnit[Physical](?given);
            ret res[Form, Stage].err{Stage.alloc{marked.err}};
        }
    }
    ret res[Form, Stage].ok{Form.allocated{Allocated{chosen: chosen, given: given, allocation: allocation}}};
}

fun frame_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.allocated)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    var held:   Allocated                 = w.form.allocated;
    val framed: res[Framed, finish.Error] = frame.frame(c.a, ?held.allocation, request(c), scope(c.x, w.function).code);
    if (sel framed.err) { ret res[Form, Stage].err{Stage.frame{framed.err}}; }
    allocate.release(?held.allocation);
    engine.release(?held.chosen);
    ret res[Form, Stage].ok{Form.framed{Framing{given: held.given, framed: framed.ok}}};
}

fun copies_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val f:  *Framing      = ?w.form.framed;
    val sc: Scope         = scope(c.x, w.function);
    var r:  lower.Request = lower.Request{
        at:        ?c.x.at,
        context:   sc.context,
        clobbered: build_record.registers(c.x.build).clobbered,
        allowed:   Slice[Physical]{data: f.given.data, size: f.given.len},
        code:      sc.code,
        moves:     sc.moves,
    };
    val copied: err[lower.Error] = lower.lower(c.a, ?f.framed, ?r);
    if (sel copied.err) { ret res[Form, Stage].err{Stage.copies{copied.err}}; }
    ret res[Form, Stage].ok{w.form};
}

fun configure_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val f: *Framing          = ?w.form.framed;
    var r: configure.Request = configure.Request{
        at:        ?c.x.at,
        context:   scope(c.x, w.function).context,
        clobbered: build_record.registers(c.x.build).clobbered,
        allowed:   Slice[Physical]{data: f.given.data, size: f.given.len},
        rules:     c.x.isa.state,
    };
    val set: err[configure.Error] = configure.configure(c.a, ?f.framed, ?r);
    if (sel set.err) { ret res[Form, Stage].err{Stage.configure{set.err}}; }
    ret res[Form, Stage].ok{w.form};
}

fun loops_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    val expanded: err[expand.Error] = expand.expand(c.a, ?w.form.framed.framed);
    if (sel expanded.err) { ret res[Form, Stage].err{Stage.loops{expanded.err}}; }
    ret res[Form, Stage].ok{w.form};
}

fun layout_step(c: *Context, w: *Work) res[Form, Stage] {
    if (!(sel w.form.framed)) { ret res[Form, Stage].err{Stage.misplaced{}}; }
    var held: Framing                  = w.form.framed;
    val regs: *Registers               = build_record.registers(c.x.build);
    val ctx:  *core_state.Context      = scope(c.x, w.function).context;
    val read: res[Ranges, range.Error] = range.ranges(c.a, ?held.framed.function, range.Request{at: ?c.x.at, context: ctx, layout: ?held.framed.layout, clobbered: regs.clobbered});
    if (sel read.err) { ret res[Form, Stage].err{Stage.ranges{read.err}}; }
    var ranges: Ranges               = read.ok;
    val laid:   res[Laid, lay.Error] = lay.lay(c.a, ?held.framed.function, opt[*core_state.Context].some{ctx});
    if (sel laid.err) {
        range.release(?ranges);
        ret res[Form, Stage].err{Stage.layout{laid.err}};
    }
    vector.dnit[Physical](?held.given);
    ret res[Form, Stage].ok{Form.laid{Done{function: w.function, context: ctx, framed: held.framed, laid: laid.ok, ranges: ranges}}};
}

# the steps every function goes through, in order
pub val STAGES: [8]Step = [8]Step{
    Step{name: "select", run: select_step},
    Step{name: "timing", run: timing_step},
    Step{name: "allocate", run: allocate_step},
    Step{name: "frame", run: frame_step},
    Step{name: "copies", run: copies_step},
    Step{name: "configure", run: configure_step},
    Step{name: "loops", run: loops_step},
    Step{name: "layout", run: layout_step},
};

# the steps of STAGES as a sequence
pub fun stages() Slice[Step] {
    ret Slice[Step]{data: ?STAGES[0], size: $length_of(STAGES)};
}

# the machine function a form holds, none for the ir
fun code_of(w: *Work) opt[*Function] {
    if (sel w.form.selected)  { ret opt[*Function].some{?w.form.selected.function}; }
    if (sel w.form.allocated) { ret opt[*Function].some{?w.form.allocated.allocation.function}; }
    if (sel w.form.framed)    { ret opt[*Function].some{?w.form.framed.framed.function}; }
    if (sel w.form.laid)      { ret opt[*Function].some{?w.form.laid.framed.function}; }
    ret opt[*Function].none{};
}

# the source location of ir instruction `i` of the function a work is of
fun ir_location(c: *Context, w: *Work, i: id.Instruction) opt[Location] {
    ret ir_function.location(?c.m.functions.data[w.function.index].body, i);
}

# the source location of machine instruction `i` of the code a work's form
# holds
fun code_location(w: *Work, i: Instruction) opt[Location] {
    val code: opt[*Function] = code_of(w);
    if (sel code.none) { ret opt[Location].none{}; }
    ret mf.location(code.some, i);
}

fun framing_location(w: *Work, e: framing.Error) opt[Location] {
    if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
    if (sel e.ungrouped) { ret code_location(w, e.ungrouped.instruction); }
    ret opt[Location].none{};
}

fun scan_location(w: *Work, e: scan.Error) opt[Location] {
    if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
    if (sel e.ungrouped) { ret code_location(w, e.ungrouped.instruction); }
    ret opt[Location].none{};
}

# the source location of the instruction what refused a function names, read
# through the form the refused step left as it found it, or the verifier read
# after it, which holds the code the instruction is of. an instruction of code
# a step was making and dropped carries its own. register allocation's
# refusals name instructions of the rounds it drops, which carry none yet
fun located(c: *Context, w: *Work, s: Stage) opt[Location] {
    val none: opt[Location] = opt[Location].none{};
    if (sel s.select) {
        val e: engine.Error = s.select;
        if (sel e.unmatched) { ret ir_location(c, w, e.unmatched.instruction); }
        if (sel e.transfer)  { ret ir_location(c, w, e.transfer); }
        if (sel e.unchecked) { ret ir_location(c, w, e.unchecked); }
        if (sel e.assembly)  { ret ir_location(c, w, e.assembly.instruction); }
        if (sel e.undecided) { ret e.undecided.location; }
        ret none;
    }
    if (sel s.timing)  { ret code_location(w, Instruction{index: s.timing.instruction}); }
    if (sel s.pointer) { ret framing_location(w, s.pointer); }
    if (sel s.frame) {
        val e: finish.Error = s.frame;
        if (sel e.lay)     { ret framing_location(w, e.lay); }
        if (sel e.operand) { ret code_location(w, e.operand); }
        if (sel e.dropped) { ret code_location(w, e.dropped); }
        ret none;
    }
    if (sel s.copies) {
        val e: lower.Error = s.copies;
        if (sel e.copy) { ret code_location(w, e.copy.at); }
        ret none;
    }
    if (sel s.configure) {
        val e: configure.Error = s.configure;
        if (sel e.state) { ret code_location(w, e.state.at); }
        ret none;
    }
    if (sel s.loops) {
        val e: expand.Error = s.loops;
        if (sel e.loop) { ret code_location(w, e.loop.at); }
        ret none;
    }
    if (sel s.layout) {
        val e: lay.Error = s.layout;
        if (sel e.undecided) { ret code_location(w, e.undecided.instruction); }
        ret none;
    }
    if (sel s.ranges) {
        val e: range.Error = s.ranges;
        if (sel e.writes) { ret scan_location(w, e.writes); }
        ret none;
    }
    if (sel s.verify) {
        val e: verify.Error = s.verify;
        if (sel e.fault) { ret code_location(w, e.fault.at); }
        ret none;
    }
    ret none;
}

fun refuse(c: *Context, w: *Work, step: opt[str], s: Stage) res[Done, Failed] {
    val at: opt[Location] = located(c, w, s);
    release(w);
    ret res[Done, Failed].err{Failed{function: w.function, step: step, stage: s, location: at}};
}

# one function through a sequence of steps, verified after each when the
# compilation is checked and looked at by the watch when there is one
# ---
# c:     what every step reads
# steps: the sequence, STAGES for every compilation
# f:     the function
# watch: what looks at the function after every step, none for none
# ret:   the function laid out, or the step that refused it, leaving nothing
#        to release
pub fun through(c: *Context, steps: Slice[Step], f: id.Function, watch: opt[*Watch]) res[Done, Failed] {
    var w: Work  = Work{function: f, form: Form.source{}};
    var i: usize = 0;
    for (i < steps.size) {
        val step: *Step            = ?steps.data[i];
        val name: opt[str]         = opt[str].some{step.name};
        val ran:  res[Form, Stage] = step.run(c, ?w);
        if (sel ran.err) { ret refuse(c, ?w, name, ran.err); }
        w.form = ran.ok;
        if (c.checked) {
            val code: opt[*Function] = code_of(?w);
            if (sel code.some) {
                val v: err[verify.Error] = verify.function(c.a, code.some);
                if (sel v.err) { ret refuse(c, ?w, name, Stage.verify{v.err}); }
            }
        }
        if (sel watch.some) {
            if (!watch.some.seen(watch.some.data, i, step, ?w)) { ret refuse(c, ?w, name, Stage.watched{}); }
        }
        i = i + 1;
    }
    if (sel w.form.laid) { ret res[Done, Failed].ok{w.form.laid}; }
    ret refuse(c, ?w, opt[str].none{}, Stage.unfinished{});
}

# give back a set of extensions past the build's and its storage
fun drop_under(a: *allocator.Allocator, u: *Under) {
    code.dnit(?u.code);
    move.dnit(?u.moves);
    target_basis.narrow(?u.widened);
    allocator.deallocate[Under](a, u, 1);
}

# the set of extensions past the build's a function names, opened, in place
# of `u`: its widened selection and context, and the moves and frame code
# bound to it
fun open_under(x: *Session, a: *allocator.Allocator, u: *Under, f: id.Function, names: Slice[View]) err[Error] {
    val widened: err[target_basis.Error] = target_basis.widen(?u.widened, a, ?x.build.basis, names);
    if (sel widened.err) { ret err[Error].err{Error.widening{Widening{function: f, error: widened.err}}}; }
    val moves: res[move.Index, move.Error] = move.index(a, x.isa.moves, ?x.at, ?u.widened.context);
    if (sel moves.err) {
        target_basis.narrow(?u.widened);
        ret err[Error].err{Error.moves{moves.err}};
    }
    u.moves = moves.ok;
    val bound: res[code.Admitted, code.Error] = code.admit(a, x.isa.frame, ?u.widened.context);
    if (sel bound.err) {
        move.dnit(?u.moves);
        target_basis.narrow(?u.widened);
        ret err[Error].err{Error.code{bound.err}};
    }
    u.code = bound.ok;
    ret err[Error].ok{};
}

# the index in `x.unders` of a set whose selection is `s`, BUILD_WIDE for the
# build's own, none for a set not opened yet
fun found_under(x: *Session, s: *extension.Selection) opt[u32] {
    if (target_record.same_selection(s, ?x.build.basis.selection)) { ret opt[u32].some{BUILD_WIDE}; }
    var i: usize = 0;
    for (i < x.unders.len) {
        if (target_record.same_selection(s, ?x.unders.data[i].widened.selection)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the set of extensions each function with a body names past the build's,
# each distinct set opened once
fun widen_all(x: *Session, a: *allocator.Allocator, m: *Module) err[Error] {
    val unscoped: err[allocator.Error] = slice.fill[u32](?x.scopes, m.functions.len, BUILD_WIDE);
    if (sel unscoped.err) { ret err[Error].err{Error.alloc{unscoped.err}}; }
    var k: usize = 0;
    for (k < m.functions.len) {
        val names: Slice[View] = m.functions.data[k].data.extensions;
        if (m.functions.data[k].body.blocks.len > 0 && names.size > 0) {
            val made: res[*Under, allocator.Error] = allocator.allocate[Under](a, 1);
            if (sel made.err) { ret err[Error].err{Error.alloc{made.err}}; }
            val u:      *Under     = made.ok;
            val opened: err[Error] = open_under(x, a, u, id.Function{index: k::u32}, names);
            if (sel opened.err) {
                allocator.deallocate[Under](a, u, 1);
                ret opened;
            }
            val known: opt[u32] = found_under(x, ?u.widened.selection);
            if (sel known.some) {
                drop_under(a, u);
                x.scopes.data[k] = known.some;
            }
            or {
                val pushed: res[usize, allocator.Error] = vector.push[*Under](?x.unders, u);
                if (sel pushed.err) {
                    drop_under(a, u);
                    ret err[Error].err{Error.alloc{pushed.err}};
                }
                x.scopes.data[k] = (x.unders.len - 1)::u32;
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# give back every set of extensions past the build's a session opened
fun drop_unders(x: *Session, a: *allocator.Allocator) {
    var i: usize = 0;
    for (i < x.unders.len) {
        drop_under(a, x.unders.data[i]);
        i = i + 1;
    }
    vector.dnit[*Under](?x.unders);
    vector.dnit[u32](?x.scopes);
}

# open the session of a target in place
# ---
# x:    where it is made, and stays until `close`
# a:    the allocator its storage comes from
# m:    the module, whose functions' extensions past the build's are opened
# b:    the target's build, opened for `t`
# t:    the target
# isas: the registry of the sets the family carries, which outlives the session
# ret:  ok, or why it was not made, leaving nothing to close
pub fun open(x: *Session, a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, isas: *Isas) err[Error] {
    if (b.basis.target != t) { ret err[Error].err{Error.foreign{}}; }
    val found: opt[*Isa] = isa.of(isas, b.basis.set);
    if (sel found.none) { ret err[Error].err{Error.uncarried{}}; }
    x.build = b;
    x.isas  = isas;
    x.isa   = found.some;

    var memories: vector.Vector[*Memory] = vector.init[*Memory](a);
    fin { vector.dnit[*Memory](?memories); }
    var i: usize = 0;
    for (i < x.isa.memories.size) {
        val pushed: res[usize, allocator.Error] = vector.push[*Memory](?memories, ?x.isa.memories.data[i]);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val located: res[Locations, location.Error] = location.init(a, build_record.registers(b).context.view.file, Slice[*Memory]{data: memories.data, size: memories.len});
    if (sel located.err) { ret err[Error].err{Error.locations{located.err}}; }
    x.at = located.ok;

    val made: res[Selector, engine.Error] = engine.init(a, x.isa, t, ?b.basis.context, build_record.registers(b));
    if (sel made.err) {
        location.dnit(?x.at);
        ret err[Error].err{Error.table{made.err}};
    }
    x.s = made.ok;

    val moves: res[move.Index, move.Error] = move.index(a, x.isa.moves, ?x.at, build_record.registers(b).context);
    if (sel moves.err) {
        engine.dnit(?x.s);
        location.dnit(?x.at);
        ret err[Error].err{Error.moves{moves.err}};
    }
    x.moves = moves.ok;

    val bound: res[code.Admitted, code.Error] = code.admit(a, x.isa.frame, build_record.registers(b).context);
    if (sel bound.err) {
        move.dnit(?x.moves);
        engine.dnit(?x.s);
        location.dnit(?x.at);
        ret err[Error].err{Error.code{bound.err}};
    }
    x.code   = bound.ok;
    x.unders = vector.init[*Under](a);
    x.scopes = vector.init[u32](a);
    val widened: err[Error] = widen_all(x, a, m);
    if (sel widened.err) {
        drop_unders(x, a);
        code.dnit(?x.code);
        move.dnit(?x.moves);
        engine.dnit(?x.s);
        location.dnit(?x.at);
        ret widened;
    }
    ret err[Error].ok{};
}

# give back a session's storage
pub fun close(x: *Session) {
    drop_unders(x, x.s.a);
    code.dnit(?x.code);
    move.dnit(?x.moves);
    engine.dnit(?x.s);
    location.dnit(?x.at);
}

fun release_all(done: *vector.Vector[Done]) {
    var i: usize = 0;
    for (i < done.len) {
        release_done(?done.data[i]);
        i = i + 1;
    }
    vector.dnit[Done](done);
}

# every function with a body, compiled and kept for emission
fun functions(c: *Context, done: *vector.Vector[Done]) err[Error] {
    var k: u32 = 0;
    for (k::usize < c.m.functions.len) {
        if (c.m.functions.data[k].body.blocks.len > 0) {
            val one: res[Done, Failed] = through(c, stages(), id.Function{index: k}, opt[*Watch].none{});
            if (sel one.err) { ret err[Error].err{Error.function{one.err}}; }
            var kept:   Done                        = one.ok;
            val pushed: res[usize, allocator.Error] = vector.push[Done](done, kept);
            if (sel pushed.err) {
                release_done(?kept);
                ret err[Error].err{Error.alloc{pushed.err}};
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the machine form text of the compiled functions
fun printed(c: *Context, w: *io.Writer, done: *vector.Vector[Done]) err[Error] {
    var items: vector.Vector[Item] = vector.init[Item](c.a);
    fin { vector.dnit[Item](?items); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Item](?items, Item{symbol: id.Symbol.function{d.function}, function: d.framed.function});
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val wrote: err[mtext.Error] = mtext.print(w, c.m, c.x.isas, Slice[Item]{data: items.data, size: items.len});
    if (sel wrote.err) { ret err[Error].err{Error.machine{wrote.err}}; }
    ret err[Error].ok{};
}

# the texts asked for, written once the object is made, so a refused
# compilation writes nothing
fun written(c: *Context, o: Options, done: *vector.Vector[Done], listed: *vector.Vector[u8]) err[Error] {
    if (sel o.machine.some) {
        val shown: err[Error] = printed(c, o.machine.some, done);
        if (sel shown.err) { ret shown; }
    }
    if (sel o.listing.some) {
        val wrote: err[io.WriteError] = io.write_all(o.listing.some, listed.data, listed.len);
        if (sel wrote.err) { ret err[Error].err{Error.write{wrote.err}}; }
    }
    ret err[Error].ok{};
}

# the walk of the encoded code of every compiled function that requires
# constant time, from the seeds its entry and frame hold, public again at the
# declassify points emission made, each call walked through the model of its
# call site, and the mark of each timing mode the code needs on the object
fun walked(c: *Context, t: *Target, done: *vector.Vector[Done], obj: *object.Object, marks: *timed.Marks) err[Error] {
    var framed: vector.Vector[timed.Framed] = vector.init[timed.Framed](c.a);
    fin { vector.dnit[timed.Framed](?framed); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[timed.Framed](?framed, timed.Framed{function: d.function, context: d.context, code: ?d.framed.function, layout: ?d.framed.layout});
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    var needs: mct.Needs                            = mct.NO_NEEDS;
    val got:   res[opt[mct.Unmet], allocator.Error] = timed.check(c.a, c.m, c.x.build, t, obj, Slice[timed.Framed]{data: framed.data, size: framed.len}, marks, ?needs);
    if (sel got.err)     { ret err[Error].err{Error.alloc{got.err}}; }
    if (sel got.ok.some) { ret err[Error].err{Error.timing{got.ok.some}}; }
    val marked: err[Fail] = timed.mark(obj, needs);
    if (sel marked.err) { ret err[Error].err{Error.mark{marked.err}}; }
    ret err[Error].ok{};
}

# hand the compiled functions to masc, then walk the code that requires
# constant time, then write the texts asked for
fun emitted(c: *Context, t: *Target, done: *vector.Vector[Done], o: Options) res[object.Object, Error] {
    var units: vector.Vector[Unit] = vector.init[Unit](c.a);
    fin { vector.dnit[Unit](?units); }
    var i: usize = 0;
    for (i < done.len) {
        val d:      *Done                       = ?done.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Unit](?units, Unit{function: d.function, context: d.context, code: ?d.framed.function, laid: ?d.laid, facts: Slice[Fact]{data: d.framed.facts.data, size: d.framed.facts.len}, ranges: ?d.ranges});
        if (sel pushed.err) { ret res[object.Object, Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    var listed: vector.Vector[u8] = vector.init[u8](c.a);
    fin { vector.dnit[u8](?listed); }
    var into: opt[*vector.Vector[u8]] = opt[*vector.Vector[u8]].none{};
    if (sel o.listing.some) { into = opt[*vector.Vector[u8]].some{?listed}; }
    var marks: timed.Marks = timed.marks(c.a);
    fin { timed.release(?marks); }
    var modes: [1]mode.Setting;
    var count: usize     = 0;
    val relax: *Relaxing = c.x.isa.relax;
    if (relax != nil) {
        modes[0] = relax.off;
        if (o.relax) { modes[0] = relax.on; }
        count = 1;
    }
    val made: res[object.Object, handover.Error] = handover.emit(c.a, c.m, c.x.build, t, Slice[Unit]{data: units.data, size: units.len}, Slice[mode.Setting]{data: ?modes[0], size: count}, c.x.isa.shorts, into, opt[*timed.Marks].some{?marks});
    if (sel made.err) { ret res[object.Object, Error].err{Error.emit{made.err}}; }
    var obj:     object.Object = made.ok;
    val cleared: err[Error]    = walked(c, t, done, ?obj, ?marks);
    if (sel cleared.err) {
        object.release(?obj);
        ret res[object.Object, Error].err{cleared.err};
    }
    val wrote: err[Error] = written(c, o, done, ?listed);
    if (sel wrote.err) {
        object.release(?obj);
        ret res[object.Object, Error].err{wrote.err};
    }
    ret res[object.Object, Error].ok{obj};
}

# compile a module for a register machine
# ---
# a:    the allocator every step and the object take
# m:    the module, after the pass schedule has run on it for the target
# b:    the target's build, opened for `t`
# t:    the target
# isas: the registry of the sets the family carries
# o:    whether it is checked, and the texts it writes besides the object
# ret:  mink's object in memory, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, isas: *Isas, o: Options) res[object.Object, Error] {
    var x:      Session;
    val opened: err[Error] = open(?x, a, m, b, t, isas);
    if (sel opened.err) { ret res[object.Object, Error].err{opened.err}; }
    fin { close(?x); }
    var c:    Context             = Context{a: a, m: m, x: ?x, checked: o.checked};
    var done: vector.Vector[Done] = vector.init[Done](a);
    fin { release_all(?done); }
    val compiled: err[Error] = functions(?c, ?done);
    if (sel compiled.err) { ret res[object.Object, Error].err{compiled.err}; }
    ret emitted(?c, t, ?done, o);
}
