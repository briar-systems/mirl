# the operands of a machine instruction
#
# an operand of a row opcode stands at one of the row's operand positions, so
# what a position admits is masc's row and never restated here.

use std.types.bool.bool;
use std.types.bool.false;

use mirl.ir.id;
use mirl.machine.class;
use mirl.machine.class.Physical;

use mink.lib.model.reloc;

# a virtual register, as an id into its function
# ---
# index: its position in its function
pub rec Virtual {
    index: u32;
}

# a frame slot, as an id into its function
# ---
# index: its position in its function
pub rec Slot {
    index: u32;
}

# a machine block, as an id into its function
# ---
# index: its position in its function
pub rec Block {
    index: u32;
}

# a machine instruction, as an id into its function
# ---
# index: its position in its function
pub rec Instruction {
    index: u32;
}

# a reference to a symbol's address
# ---
# symbol: the function or global of the module
# addend: added to the symbol's address
# kind:   the relocation kind, a row of mink's relocation vocabulary
pub rec Symbol {
    symbol: id.Symbol;
    addend: i64;
    kind:   *reloc.Kind;
}

# a register an operand names, before or after allocation
# ---
# virtual:  a virtual register
# physical: an assigned location
pub tag Register: u8 {
    virtual:  Virtual;
    physical: Physical;
}

# a register a two-address form reads and writes, written to dest and read
# from source, which allocation gives one location
# ---
# dest:   the register written
# source: the register read
pub rec Tied {
    dest:   Register;
    source: Register;
}

# one operand
# ---
# virtual:   a virtual register
# physical:  an assigned location
# immediate: a constant
# slot:      a frame slot
# symbol:    a symbol's address
# block:     a machine block
# tied:      a destination and the source held to it
pub tag Operand: u8 {
    virtual:   Virtual;
    physical:  Physical;
    immediate: i64;
    slot:      Slot;
    symbol:    Symbol;
    block:     Block;
    tied:      Tied;
}

# whether two registers are the same register
pub fun same_register(a: Register, b: Register) bool {
    if (sel a.virtual) { ret sel b.virtual && b.virtual.index == a.virtual.index; }
    ret sel b.physical && class.same_physical(a.physical, b.physical);
}

# whether two symbols of one module are the same symbol
fun same_symbol(a: id.Symbol, b: id.Symbol) bool {
    if (sel a.function) { ret sel b.function && b.function.index == a.function.index; }
    ret sel b.global && b.global.index == a.global.index;
}

# whether two operands naming the symbols of one module are the same operand
pub fun same(a: Operand, b: Operand) bool {
    if (sel a.virtual)   { ret sel b.virtual && b.virtual.index == a.virtual.index; }
    if (sel a.physical)  { ret sel b.physical && class.same_physical(a.physical, b.physical); }
    if (sel a.immediate) { ret sel b.immediate && b.immediate == a.immediate; }
    if (sel a.slot)      { ret sel b.slot && b.slot.index == a.slot.index; }
    if (sel a.block)     { ret sel b.block && b.block.index == a.block.index; }
    if (sel a.tied)      { ret sel b.tied && (same_register(a.tied.dest, b.tied.dest) && same_register(a.tied.source, b.tied.source)); }
    if (sel a.symbol)    { ret sel b.symbol && (a.symbol.addend == b.symbol.addend && (a.symbol.kind == b.symbol.kind && same_symbol(a.symbol.symbol, b.symbol.symbol))); }
    ret false;
}
