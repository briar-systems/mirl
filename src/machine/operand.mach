# the operands of a machine instruction
#
# an operand of a row opcode stands at one of the row's operand positions, so
# what a position admits is masc's row and never restated here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mirl.ir.id;
use mirl.machine.class;
use mirl.machine.class.Physical;

use mo: masc.core.operand;
use mink.model.reloc;

# a virtual register, as an id into its function
# ---
# index: its position in its function
pub rec Virtual {
    index: u32;
}

# a frame slot, as an id into its function
# ---
# index: its position in its function
pub rec Slot {
    index: u32;
}

# a machine block, as an id into its function
# ---
# index: its position in its function
pub rec Block {
    index: u32;
}

# a machine instruction, as an id into its function
# ---
# index: its position in its function
pub rec Instruction {
    index: u32;
}

# a reference to a symbol's address
# ---
# symbol: the function or global of the module
# addend: added to the symbol's address
# kind:   the relocation kind, a row of mink's relocation vocabulary
pub rec Symbol {
    symbol: id.Symbol;
    addend: i64;
    kind:   *reloc.Kind;
}

# the address of an instruction a label marks, which a low part's relocation
# names as the partner of the high part there
# ---
# label: the label of the instruction
# kind:  the relocation kind, a row of mink's relocation vocabulary
pub rec Partner {
    label: u32;
    kind:  *reloc.Kind;
}

# a register an operand names, before or after allocation
# ---
# virtual:  a virtual register
# physical: an assigned location
pub tag Register: u8 {
    virtual:  Virtual;
    physical: Physical;
}

# a register a two-address form reads and writes, written to dest and read
# from source, which allocation gives one location
# ---
# dest:   the register written
# source: the register read
pub rec Tied {
    dest:   Register;
    source: Register;
}

# a memory address an operand names at a position of masc's memory shape, as
# x86's `[b + i*s + d]` or aarch64's pre-indexed `[x0, #16]!`, its registers
# virtual before allocation and assigned after it, the rest masc's address
# ---
# base:      the base register, none for an address with no base
# index:     the index register, none for none
# segment:   the segment override, none for none
# scale:     the index is scaled by 1 << scale
# disp:      the displacement, 0 under a symbol, which carries its addend
# symbol:    a symbol the displacement is the address of, none for a constant one
# mode:      how the address is formed, a mode of masc's, which states the
#            ones that write the base back
# extend:    how the index is extended before it is scaled, a member of the
#            position's extends, 0 for an index taken as it is
# broadcast: one element repeated 1 << broadcast times, 0 for none
pub rec Address {
    base:      opt[Register];
    index:     opt[Register];
    segment:   opt[Register];
    scale:     u8;
    disp:      i64;
    symbol:    opt[Symbol];
    mode:      mo.Mode;
    extend:    u32;
    broadcast: u8;
}

# a list of registers an operand names at a position of masc's list shape, as
# aarch64's `{v31.16b, v0.16b}` or a risc-v segment load's group: `count`
# members from `first`, each following the one before as masc's list states,
# wrapping where it wraps. a virtual register as the first names a value
# covering the whole list, which allocation holds as one group
# ---
# first: the first member
# count: how many members
pub rec List {
    first: Register;
    count: u8;
}

# one operand
# ---
# virtual:   a virtual register
# physical:  an assigned location
# immediate: a constant
# slot:      a frame slot
# symbol:    a symbol's address
# block:     a machine block
# tied:      a destination and the source held to it
# partner:   the address of a labelled instruction
# address:   a memory address of registers, a displacement and a symbol
# list:      a list of registers
# literal:   bytes the instruction holds whole, borrowed from storage that
#            outlives the function, as a wasm v128 or a spir-v string
pub tag Operand: u8 {
    virtual:   Virtual;
    physical:  Physical;
    immediate: i64;
    slot:      Slot;
    symbol:    Symbol;
    block:     Block;
    tied:      Tied;
    partner:   Partner;
    address:   Address;
    list:      List;
    literal:   mo.Bytes;
}

# the most registers one operand names, an address's base, index and segment
pub val MOST_NAMED: u32 = 3;

# whether an address writes its base back, as a pre- or post-indexed one does
pub fun writes_back(a: Address) bool {
    ret a.mode == mo.PREINDEX || a.mode == mo.POSTINDEX || a.mode == mo.POSTINDEX_REGISTER;
}

fun name_into(out: *Register, n: u32, r: opt[Register]) u32 {
    if (sel r.none) { ret n; }
    out[n] = r.some;
    ret n + 1;
}

# the registers operand `o` names, written to `out`, which holds MOST_NAMED:
# its own register, a tie's dest then its source, a list's first member, or
# an address's base, index and segment that it has, in that order
pub fun named(o: Operand, out: *Register) u32 {
    if (sel o.virtual)  { out[0] = Register.virtual{o.virtual}; ret 1; }
    if (sel o.physical) { out[0] = Register.physical{o.physical}; ret 1; }
    if (sel o.tied) {
        out[0] = o.tied.dest;
        out[1] = o.tied.source;
        ret 2;
    }
    if (sel o.list) { out[0] = o.list.first; ret 1; }
    if (sel o.address) {
        var n: u32 = name_into(out, 0, o.address.base);
        n = name_into(out, n, o.address.index);
        ret name_into(out, n, o.address.segment);
    }
    ret 0;
}

fun rename_at(r: opt[Register], rs: *Register, n: *u32) opt[Register] {
    if (sel r.none) { ret r; }
    val k: u32 = @n;
    @n = k + 1;
    ret opt[Register].some{rs[k]};
}

# operand `o` with the registers `named` lists replaced, in its order, by
# `rs`: a register operand takes the shape of its replacement
pub fun renamed(o: Operand, rs: *Register) Operand {
    if (sel o.virtual || sel o.physical) {
        val r: Register = rs[0];
        if (sel r.virtual) { ret Operand.virtual{r.virtual}; }
        ret Operand.physical{r.physical};
    }
    if (sel o.tied) { ret Operand.tied{Tied{dest: rs[0], source: rs[1]}}; }
    if (sel o.list) { ret Operand.list{List{first: rs[0], count: o.list.count}}; }
    if (sel o.address) {
        var a: Address = o.address;
        var n: u32     = 0;
        a.base    = rename_at(a.base, rs, ?n);
        a.index   = rename_at(a.index, rs, ?n);
        a.segment = rename_at(a.segment, rs, ?n);
        ret Operand.address{a};
    }
    ret o;
}

# whether two registers are the same register
pub fun same_register(a: Register, b: Register) bool {
    if (sel a.virtual) { ret sel b.virtual && b.virtual.index == a.virtual.index; }
    ret sel b.physical && class.same_physical(a.physical, b.physical);
}

# whether two symbols of one module are the same symbol
fun same_symbol(a: id.Symbol, b: id.Symbol) bool {
    if (sel a.function) { ret sel b.function && b.function.index == a.function.index; }
    ret sel b.global && b.global.index == a.global.index;
}

# whether two operands naming the symbols of one module are the same operand
pub fun same(a: Operand, b: Operand) bool {
    if (sel a.virtual)   { ret sel b.virtual && b.virtual.index == a.virtual.index; }
    if (sel a.physical)  { ret sel b.physical && class.same_physical(a.physical, b.physical); }
    if (sel a.immediate) { ret sel b.immediate && b.immediate == a.immediate; }
    if (sel a.slot)      { ret sel b.slot && b.slot.index == a.slot.index; }
    if (sel a.block)     { ret sel b.block && b.block.index == a.block.index; }
    if (sel a.tied)      { ret sel b.tied && (same_register(a.tied.dest, b.tied.dest) && same_register(a.tied.source, b.tied.source)); }
    if (sel a.symbol)    { ret sel b.symbol && (a.symbol.addend == b.symbol.addend && (a.symbol.kind == b.symbol.kind && same_symbol(a.symbol.symbol, b.symbol.symbol))); }
    if (sel a.partner)   { ret sel b.partner && (a.partner.label == b.partner.label && a.partner.kind == b.partner.kind); }
    if (sel a.list)      { ret sel b.list && (a.list.count == b.list.count && same_register(a.list.first, b.list.first)); }
    if (sel a.address)   { ret sel b.address && same_address(a.address, b.address); }
    if (sel a.literal)   { ret sel b.literal && same_bytes(a.literal, b.literal); }
    ret false;
}

fun same_optional(a: opt[Register], b: opt[Register]) bool {
    if (sel a.none) { ret sel b.none; }
    ret sel b.some && same_register(a.some, b.some);
}

fun same_reference(a: opt[Symbol], b: opt[Symbol]) bool {
    if (sel a.none) { ret sel b.none; }
    ret sel b.some && (a.some.addend == b.some.addend && (a.some.kind == b.some.kind && same_symbol(a.some.symbol, b.some.symbol)));
}

# whether two addresses naming the symbols of one module are the same address
fun same_address(a: Address, b: Address) bool {
    if (a.scale != b.scale || a.disp != b.disp || a.mode != b.mode || a.extend != b.extend || a.broadcast != b.broadcast) { ret false; }
    ret same_optional(a.base, b.base) && same_optional(a.index, b.index) && same_optional(a.segment, b.segment) && same_reference(a.symbol, b.symbol);
}

# whether two literals hold the same bytes
fun same_bytes(a: mo.Bytes, b: mo.Bytes) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (a.at[i] != b.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}
