# machine instructions: an opcode, its operands and the metadata it came with
#
# a row opcode is a row of masc's catalog for the target, and everything an
# operand position admits, its register classes, its fixed register and its
# role, is read from that row. a pseudo opcode is a row of the pseudo table. a
# loop opcode is a target's loop, whose operands are registers its steps'
# rows admit wherever they stand and immediates at its parameters.
# an instruction is checked against its opcode's row when it is made, so a
# tied operand stands only where the row reads and writes one register, and
# its two halves are one location once both are assigned. a virtual register
# stands at a row's register position of its own class or of a class the
# storage model views within its own, as a position of a 32-bit class names a
# value of the 64-bit class it lies in, and names the register of the view within its location once it has
# one, so no move is made between the views of one value. a virtual register
# of a tuple class stands alike at a position admitting the tuple's members,
# as a risc-v vector group of two at vadd.vv under m2, and names the first
# member of its location, and masc reads a tuple there as that member. a copy
# or a parallel copy names any member of a virtual register of a tuple class,
# a member operand, and reads or writes that member of its location, so a pair
# is made from its words and taken apart into them by copies.
#
# an instruction states the vector state it runs under when the groups or
# element widths of a row it stands for turn on one, which decides how many
# registers each of its operands' groups covers, and only then: masc's
# grouping of the row with no state answers whether it needs one. the state
# narrows an operand's role as well, where the row's role rules turn on it, as
# a risc-v vector destination only written under a tail agnostic vtype, and
# `stated_role` is the one read of it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.ir.metadata.Metadata;
use mirl.ir.place.Placed;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Hardware;
use mirl.machine.class.Physical;
use mirl.machine.inline.Inline;
use lrow: mirl.machine.loop.row;
use mirl.machine.operand;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.operand.Virtual;
use mirl.machine.pseudo;
use mirl.machine.pseudo.Pseudo;
use mirl.machine.storage;
use mirl.machine.vstate;

use masc.codec.walk;
use core_config: masc.core.config;
use masc.core.effect;
use masc.core.field;
use mo:          masc.core.operand;
use rf:          masc.core.register;
use rows:        masc.core.row;
use mset:        masc.core.set;
use masc_emit:   masc.emit.emit;
use masc_inline: masc.inline.inline;

# an opcode
# ---
# row:    a row of masc's catalog for the target
# pseudo: a target-neutral pseudo-instruction
# loop:   a target's loop, expanded into its steps after allocation
# inline: an inline assembly block masc parsed, encoded by masc after allocation
pub tag Opcode: u8 {
    row:    *rows.Row;
    pseudo: Pseudo;
    loop:   *lrow.Loop;
    inline: *Inline;
}

# a location an instruction reads or writes beyond its operands and its row,
# as a call reads the registers its arguments travel in and writes the ones
# its results come back in
# ---
# location: the location
# write:    it is written, read otherwise
pub rec Implicit {
    location: Physical;
    write:    bool;
}

# one instruction
# ---
# opcode:       its opcode
# operands:     one per operand position of its opcode's row, in order
# metadata:     the metadata record of the ir instruction it came from
# declassifies: it came from an ir instruction whose row declassifies, or
#               from a pattern that covers one, so it is a barrier that
#               secrecy ends at and is never merged, moved or removed as a
#               plain copy. a conditional branch so marked reads what it
#               tests as public, a declassify point of the walk
#               (`mirl.machine.emit.timed`)
# implicit:     the locations it reads and writes beyond its operands and row,
#               reads first
# label:        the label a partner operand names it by, NO_LABEL for none
# state:        the vector state it runs under, none when it states none
# places:       where the pieces of the call it makes travel, its arguments'
#               and then its results', as the abi legalisation placed them,
#               empty for an instruction that makes no call
pub rec InstructionData {
    opcode:       Opcode;
    operands:     Slice[Operand];
    metadata:     Metadata;
    declassifies: bool;
    implicit:     Slice[Implicit];
    label:        u32;
    state:        opt[vstate.State];
    places:       Slice[Placed];
}

# the label of an instruction no partner operand names
pub val NO_LABEL: u32 = 0xffffffff;

# what an instruction is checked against
# ---
# set:      the target's instruction set, whose register file and catalog rows
#           an instruction stands against
# virtuals: the class of each virtual register
# slots:    how many frame slots there are
# blocks:   how many blocks there are
pub rec Context {
    set:      *mset.Set;
    virtuals: Slice[Class];
    slots:    u32;
    blocks:   u32;
}

# the operand a refusal names when it names none
pub val NO_OPERAND: u32 = 0xffffffff;

# why an instruction was refused
# ---
# operand: the operand position, NO_OPERAND for the instruction as a whole
# what:    the fact that does not hold
pub rec Refusal {
    operand: u32;
    what:    str;
}

pub val FOREIGN_ROW:      str = "row not in the target's catalog";
pub val UNKNOWN_PSEUDO:   str = "pseudo not in the pseudo table";
pub val COUNT:            str = "operand count differs from the row's";
pub val SHAPE:            str = "operand of a kind its position does not admit";
pub val CLASS:            str = "register of a class its position does not admit";
pub val RANGE:            str = "value outside what its position admits";
pub val FIXED:            str = "register other than the one its row fixes";
pub val TIED_ROLE:        str = "tied operand where the row does not read and write one register";
pub val UNTIED:           str = "tied operand whose halves are different locations";
pub val UNKNOWN_VIRTUAL:  str = "virtual register the function does not have";
pub val UNKNOWN_REGISTER: str = "register the register file does not have";
pub val UNFILED_REGISTER: str = "register of a set with no register file";
pub val UNKNOWN_SLOT:     str = "frame slot the function does not have";
pub val UNKNOWN_BLOCK:    str = "block the function does not have";
pub val NO_KIND:          str = "symbol with no relocation kind";
pub val UNREAD_STATE:     str = "vector state on an instruction whose row's groups turn on none";
pub val UNSTATED:         str = "operand whose groups turn on a vector state the instruction does not state";
pub val LOOP_REGISTER:    str = "register a loop writes that it also names at another position";
pub val LISTED:           str = "lists holding more members than one instruction keeps room for";

# whether an opcode writes before it has read all it reads, as a loop does,
# whose body runs again after it writes, so its writes take its use slot
pub fun early(op: Opcode) bool {
    ret sel op.loop;
}

# how many rows of masc's catalog an opcode stands for: a row one, a pseudo
# none and a loop each of its steps
pub fun rows_in(op: Opcode) u32 {
    if (sel op.row)  { ret 1; }
    if (sel op.loop) { ret lrow.count(op.loop); }
    ret 0;
}

# the k-th row an opcode stands for, below `rows_in`
pub fun row_in(op: Opcode, k: u32) *rows.Row {
    if (sel op.loop) { ret lrow.step(op.loop, k).row; }
    if (sel op.row)  { ret op.row; }
    ret nil;
}

# the blocks a loop's steps name: its body, the block after the body, and
# where its jump goes
pub rec Places {
    head:   Block;
    exit:   Block;
    target: Block;
}

# the places of a loop asked before it is expanded, which name no block of
# the function and so give masc no value
pub val UNPLACED: Places = Places{head: Block{index: 0}, exit: Block{index: 0}, target: Block{index: 0}};

# the operands of a step of a loop, one per position of its row, written to
# `out`, which holds rows.MAX_OPERANDS: the loop's operand where the step
# names one, through the view the position takes of it once it is a register
# of `file`, an immediate for a literal or a formula of the loop's
# parameters, a fixed register, and a block of `p` where the step names one
pub fun step_operands(file: *rf.File, s: *lrow.Step, operands: Slice[Operand], p: Places, out: *Operand) Slice[Operand] {
    var k: u32 = 0;
    for (k < s.operands.len) {
        val src: lrow.Source = s.operands.at[k];
        if (sel src.operand) { out[k] = step_viewed(file, s.row, k, operands.data[src.operand]); }
        or (sel src.literal) { out[k] = Operand.immediate{src.literal}; }
        or (sel src.formula) { out[k] = Operand.immediate{formula(src.formula, operands)}; }
        or (sel src.fixed)   { out[k] = Operand.physical{Physical.register{src.fixed}}; }
        or (sel src.address) { out[k] = addressed(operands.data[src.address]); }
        or (sel src.head)    { out[k] = Operand.block{p.head}; }
        or (sel src.exit)    { out[k] = Operand.block{p.exit}; }
        or                   { out[k] = Operand.block{p.target}; }
        k = k + 1;
    }
    ret Slice[Operand]{data: out, size: s.operands.len::usize};
}

# a loop's operand as position `at` of a step's row takes it: a register of
# a class the position does not admit through the view the position takes of
# it, as a step at 32 bits takes eax of the rax a loop holds its value in, and
# any other operand as it is
fun step_viewed(file: *rf.File, r: *rows.Row, at: u32, o: Operand) Operand {
    if (file == nil || at >= r.operands.len) { ret o; }
    if (!(sel o.physical))                   { ret o; }
    val p: Physical = o.physical;
    if (!(sel p.register)) { ret o; }
    val ro: *mo.Operand = ?r.operands.at[at];
    if (!(sel ro.shape.register)) { ret o; }
    val v: opt[Viewing] = viewing_in(file, ?ro.shape.register, Class.hardware{Hardware{file: file, index: rf.class_of(p.register)}});
    if (sel v.none) { ret o; }
    val part: opt[rf.Id] = viewed_in(file, p.register, v.some);
    if (sel part.none) { ret o; }
    ret Operand.physical{Physical.register{part.some}};
}

# the memory at the address a register operand of a loop holds, the operand
# as it is where it is no register
fun addressed(o: Operand) Operand {
    var base: Register = Register.virtual{Virtual{index: 0}};
    if (sel o.virtual)  { base = Register.virtual{o.virtual}; }
    or (sel o.physical) { base = Register.physical{o.physical}; }
    or                  { ret o; }
    ret Operand.address{operand.Address{base: opt[Register].some{base}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: 0, symbol: opt[operand.Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
}

# the operands the k-th row an opcode stands for takes, below `rows_in`: an
# instruction's own for a row, and a loop's step's, its blocks unplaced
pub fun operands_in(file: *rf.File, op: Opcode, k: u32, operands: Slice[Operand], out: *Operand) Slice[Operand] {
    if (sel op.loop) { ret step_operands(file, lrow.step(op.loop, k), operands, UNPLACED, out); }
    ret operands;
}

# whether position `p` of the k-th row an opcode stands for, below `rows_in`,
# takes its operand `at`: the same position of a row, and a loop's step's
# position that names the loop's operand
pub fun names(op: Opcode, k: u32, p: u32, at: u32) bool {
    if (sel op.loop) {
        val st: *lrow.Step = lrow.step(op.loop, k);
        if (p >= st.operands.len) { ret false; }
        val src: lrow.Source = st.operands.at[p];
        ret sel src.operand && src.operand::u32 == at;
    }
    ret p == at;
}

# whether an opcode encodes to bytes, which no pseudo does
pub fun emits(op: Opcode) bool {
    ret sel op.row || sel op.inline;
}

# whether a class of `classes` is a vector class of `file`
fun vector_class(file: *rf.File, classes: mo.Classes) bool {
    var i: u32 = 0;
    for (i < classes.len) {
        val c: u16 = classes.at[i];
        if (c::u32 < file.class_count && file.classes[c].kind == rf.VECTOR) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a register an operand of `o`'s shape names may be of a vector class
fun vector_operand(file: *rf.File, o: *mo.Operand) bool {
    val sh: *mo.Shape = ?o.shape;
    if (sel sh.register) { ret vector_class(file, sh.register.classes); }
    if (sel sh.list)     { ret vector_class(file, sh.list.member.classes); }
    if (sel sh.memory)   { ret vector_class(file, sh.memory.base.classes) || vector_class(file, sh.memory.index.classes); }
    ret false;
}

# the first operand of row `r` whose register may be of a vector class of
# `file`, none for a set with no register file or a row with no such operand
pub fun first_vector(file: *rf.File, r: *rows.Row) opt[u32] {
    if (file == nil) { ret opt[u32].none{}; }
    var k: u32 = 0;
    for (k < r.operands.len) {
        if (vector_operand(file, ?r.operands.at[k])) { ret opt[u32].some{k}; }
        k = k + 1;
    }
    ret opt[u32].none{};
}

# the register file of a set, nil for a set with none
pub fun file_of(s: *mset.Set) *rf.File {
    if (s.codec == nil) { ret nil; }
    ret s.codec.registers;
}

# the catalog rows of a set, none for a set with none
pub fun rows_of(s: *mset.Set) rows.Rows {
    if (s.codec == nil) { ret rows.Rows{at: nil, len: 0}; }
    ret s.codec.rows;
}

# the register a row opcode fixes operand `at` to, which masc states
# ---
# s:   the set whose row it is
# op:  the opcode
# at:  the operand position
# ret: the register, none when the position is not fixed or the opcode is a pseudo
pub fun fixed(s: *mset.Set, op: Opcode, at: u32) opt[rf.Id] {
    if (sel op.loop)               { ret loop_fixed(s, op.loop, at); }
    or (!(sel op.row))             { ret opt[rf.Id].none{}; }
    if (at >= op.row.operands.len) { ret opt[rf.Id].none{}; }
    ret masc_emit.fixed(s, op.row, at::u8);
}

# the register a step of a loop fixes the loop's operand `at` to, the first
# step that fixes it, none when no step does
fun loop_fixed(s: *mset.Set, l: *lrow.Loop, at: u32) opt[rf.Id] {
    var k: u32 = 0;
    for (k < lrow.count(l)) {
        val st: *lrow.Step = lrow.step(l, k);
        var j:  u32        = 0;
        for (j < st.operands.len && j < st.row.operands.len) {
            val src: lrow.Source = st.operands.at[j];
            if (sel src.operand && src.operand::u32 == at) {
                val pinned: opt[rf.Id] = masc_emit.fixed(s, st.row, j::u8);
                if (sel pinned.some) { ret pinned; }
            }
            j = j + 1;
        }
        k = k + 1;
    }
    ret opt[rf.Id].none{};
}

# the value masc reads of a location at a register position, none for a cell
pub fun located(p: Physical) mo.Value {
    if (sel p.register) { ret mo.Value.register{p.register}; }
    ret mo.Value.none{};
}

# which half of a tied operand masc reads as its value
# ---
# DEST:   the register it writes, which its constraints and its encoding read
# SOURCE: the register it reads, which holds the value it reads
pub def Half: u8;

pub val DEST:   Half = 0;
pub val SOURCE: Half = 1;

# the most members the lists of one instruction hold together, which the
# values of its operands keep room for
pub val MOST_MEMBERS: u32 = 32;

# the values masc reads of one instruction's operands, one per operand of its
# row and the members of its lists after them
pub val VALUES: u32 = rows.MAX_OPERANDS + MOST_MEMBERS;

# the value masc reads of operand `o` at row operand `ro`: a register it
# names, a constant as the kind its position states, an immediate, an
# enumerant or a condition, an address all of whose registers are assigned,
# and none for a virtual register, a list or anything else, which masc takes
# as not chosen yet. a tied operand is its dest half
pub fun value_of(ro: *mo.Operand, o: Operand) mo.Value {
    ret value_in(ro, o, DEST);
}

fun address_register(r: opt[Register]) opt[rf.Id] {
    if (sel r.none) { ret opt[rf.Id].some{rf.NONE}; }
    val reg: Register = r.some;
    if (!(sel reg.physical))          { ret opt[rf.Id].none{}; }
    if (!(sel reg.physical.register)) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{reg.physical.register};
}

# the value masc reads of an address, none while one of its registers is
# virtual or a cell. its symbol is the handover's, which binds the label, so
# a symbolic address reads as one with no symbol
pub fun address_value(a: operand.Address) mo.Value {
    val base:    opt[rf.Id] = address_register(a.base);
    val index:   opt[rf.Id] = address_register(a.index);
    val segment: opt[rf.Id] = address_register(a.segment);
    if (sel base.none)    { ret mo.Value.none{}; }
    if (sel index.none)   { ret mo.Value.none{}; }
    if (sel segment.none) { ret mo.Value.none{}; }
    ret mo.Value.memory{mo.Address{
        base:      base.some,
        index:     index.some,
        scale:     a.scale,
        disp:      a.disp,
        segment:   segment.some,
        mode:      a.mode,
        symbol:    mo.Symbol{id: mo.NO_SYMBOL, addend: 0, fixup: mo.NO_FIXUP},
        extend:    a.extend,
        broadcast: a.broadcast,
    }};
}

# the value masc reads of a list at list position `l` of `file`, its members
# written to `room`: each from the first by masc's step, wrapping within the
# member range as masc's span states. none while its first is virtual or a
# cell, or it holds more members than MOST_MEMBERS
pub fun list_value(file: *rf.File, l: *mo.List, given: operand.List, room: *mo.Value) mo.Value {
    val head: opt[rf.Id] = address_register(opt[Register].some{given.first});
    if (file == nil || given.count::u32 > MOST_MEMBERS) { ret mo.Value.none{}; }
    if (sel head.none)                                  { ret mo.Value.none{}; }
    val first:  rf.Id = head.some;
    val within: u16   = rf.class_of(first);
    val span:   u64   = mo.span(?l.member, rf.count_most(file, within)::u32)::u64;
    if (span == 0) { ret mo.Value.none{}; }
    var i: u32 = 0;
    for (i < given.count::u32) {
        val n: u64 = (rf.number_of(first)::u64 + i::u64 * mo.step(l)) % span;
        room[i] = mo.Value.register{rf.make(within, n::u16)};
        i       = i + 1;
    }
    ret mo.Value.list{mo.Values{at: room, len: given.count::u32}};
}

# the value masc reads of operand `o` at row operand `ro`, as value_of, a tied
# operand being its half `half`
pub fun value_in(ro: *mo.Operand, o: Operand, half: Half) mo.Value {
    if (sel o.physical) {
        if (sel ro.shape.id) {
            val p: Physical = o.physical;
            if (sel p.register) { ret mo.Value.id{rf.number_of(p.register)::u32}; }
            ret mo.Value.none{};
        }
        ret located(o.physical);
    }
    if (sel o.address) { ret address_value(o.address); }
    if (sel o.literal) { ret mo.Value.literal{o.literal}; }
    if (sel o.tied) {
        var r: Register = o.tied.dest;
        if (half == SOURCE) { r = o.tied.source; }
        if (sel r.physical) { ret located(r.physical); }
        ret mo.Value.none{};
    }
    if (sel o.immediate) {
        val sh: *mo.Shape = ?ro.shape;
        if (sel sh.immediate)                            { ret mo.Value.immediate{o.immediate}; }
        if (o.immediate < 0 || o.immediate > 0xffffffff) { ret mo.Value.none{}; }
        if (sel sh.enumerant)                            { ret mo.enumerant(o.immediate::u32); }
        if (sel sh.condition)                            { ret mo.Value.condition{o.immediate::u32}; }
    }
    ret mo.Value.none{};
}

# the values masc reads of the operands of an instruction of row `r` of
# `file`, one per operand of the row, written to `out`, which holds VALUES,
# the members of its lists after them
pub fun values_of(file: *rf.File, r: *rows.Row, operands: Slice[Operand], out: *mo.Value) mo.Values {
    ret halves_of(file, r, operands, DEST, out);
}

# the value masc reads of register `reg` of `file` at register position `rr`:
# the register, or the first member of a tuple whose members alone the
# position admits, as a group of two the allocator tries at vadd.vv under m2
fun member_value(file: *rf.File, rr: *mo.Register, reg: rf.Id) mo.Value {
    val k: u16 = rf.class_of(reg);
    if (file != nil && mo.find(rr.classes, k) < 0) {
        val m: opt[u16] = member_class(file, k);
        if (sel m.some && mo.find(rr.classes, m.some) >= 0) {
            val first: opt[rf.Id] = rf.member(file, reg, 0);
            if (sel first.some) { ret mo.Value.register{first.some}; }
        }
    }
    ret mo.Value.register{reg};
}

# the values of values_of, each tied operand its half `half`
pub fun halves_of(file: *rf.File, r: *rows.Row, operands: Slice[Operand], half: Half, out: *mo.Value) mo.Values {
    var n: u32 = r.operands.len;
    if (operands.size < n::usize) { n = operands.size::u32; }
    var used: u32 = 0;
    var k:    u32 = 0;
    for (k < n) {
        val ro: *mo.Operand = ?r.operands.at[k];
        val o:  Operand     = operands.data[k];
        out[k] = value_in(ro, o, half);
        val v: mo.Value = out[k];
        if (sel v.register) {
            if (sel ro.shape.register) { out[k] = member_value(file, ?ro.shape.register, v.register); }
        }
        if (sel o.list) {
            if (sel ro.shape.list) {
                if (used + o.list.count::u32 <= MOST_MEMBERS) {
                    out[k] = list_value(file, ?ro.shape.list, o.list, ?out[rows.MAX_OPERANDS + used]);
                    used   = used + o.list.count::u32;
                }
            }
        }
        k = k + 1;
    }
    ret mo.Values{at: out, len: n};
}

# an instruction whose control or footprint masc cannot answer, as a rule
# of its row testing an operand that names no register yet
# ---
# instruction: the instruction
# why:         why masc leaves it undecided
pub rec Undecided {
    instruction: Instruction;
    why:         effect.Undecided;
}

# how an instruction transfers control, its row's control under the rules its
# operand values meet. a pseudo falls through, and so does a loop, which
# leaves by the block after its body, and an inline block comes back as it
# states, since control that leaves it by a jump or a fault never comes back
# ---
# file: the register file the row's register rows index
# d:    the instruction
# ret:  its control, or the rule an operand with no register leaves open
pub fun transfer(file: *rf.File, d: *InstructionData) effect.Answer[effect.Control] {
    val none: effect.Control = effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND, rules: effect.NO_RULES};
    val op:   Opcode         = d.opcode;
    if (sel op.inline) {
        var called: effect.Control = none;
        called.transfer = op.inline.transfer;
        ret effect.Answer[effect.Control].decided{called};
    }
    if (!(sel op.row))        { ret effect.Answer[effect.Control].decided{none}; }
    if (op.row.effect == nil) { ret effect.Answer[effect.Control].decided{none}; }
    val e: *effect.Effect = op.row.effect;
    if (e.control.rules.len == 0 || file == nil) { ret effect.Answer[effect.Control].decided{e.control}; }
    var values: [VALUES]mo.Value;
    ret effect.control(file, op.row.operands.at, e, values_of(file, op.row, d.operands, ?values[0]));
}

# how an instruction of `count` operands uses operand `at`
pub fun role(op: Opcode, count: u32, at: u32) mo.Role {
    if (sel op.row) {
        if (at >= op.row.operands.len) { ret mo.NONE; }
        ret op.row.operands.at[at].role;
    }
    or (sel op.loop) {
        if (at >= op.loop.roles.len) { ret mo.NONE; }
        ret op.loop.roles.at[at];
    }
    or (sel op.inline) { ret inline_role(op.inline, at); }
    val r: opt[*pseudo.Row] = pseudo.row(op.pseudo);
    if (sel r.none) { ret mo.NONE; }
    val p: opt[*pseudo.Position] = pseudo.position(r.some, count, at);
    if (sel p.none) { ret mo.NONE; }
    ret p.some.role;
}

# how instruction `d` of set `s` uses operand `at` under the configuration
# state it states: the role its row's role rules give it for that state and
# its operand values (`core_config.role`), else its row's, and as `role` reads
# it for any other opcode. a rule only narrows its row's role, so one that
# turns on a state `d` does not state or a value not yet known reads the row's,
# which holds under every state and value
pub fun stated_role(s: *mset.Set, d: *InstructionData, at: u32) mo.Role {
    val op: Opcode = d.opcode;
    if (!(sel op.row)) { ret role(op, d.operands.size::u32, at); }
    val r: *rows.Row = op.row;
    if (at >= r.operands.len) { ret mo.NONE; }
    val own: mo.Role = r.operands.at[at].role;
    if (s == nil || r.effect == nil) { ret own; }
    if (r.effect.roles.len == 0)     { ret own; }
    val file:   *rf.File               = file_of(s);
    var values: [VALUES]mo.Value;
    val got:    effect.Answer[mo.Role] = core_config.role(file, vstate.configured(s, d.state), r, at::u8, values_of(file, r, d.operands, ?values[0]));
    if (sel got.decided) { ret got.decided; }
    ret own;
}

# how an inline block uses its operand `at`: a register by its role, the
# register an address is formed from read, and an immediate not at all
fun inline_role(x: *Inline, at: u32) mo.Role {
    if (at::usize >= x.operands.size) { ret mo.NONE; }
    val o: *masc_inline.Operand = ?x.operands.data[at];
    if (sel o.constraint.class)  { ret o.role; }
    if (sel o.constraint.memory) { ret mo.READ; }
    ret mo.NONE;
}

fun refuse(at: u32, what: str) err[Refusal] {
    ret err[Refusal].err{Refusal{operand: at, what: what}};
}

fun known_virtual(c: *Context, r: Register) opt[str] {
    if (sel r.virtual && r.virtual.index::usize >= c.virtuals.size) { ret opt[str].some{UNKNOWN_VIRTUAL}; }
    ret opt[str].none{};
}

# whether a constant stands at operand `at` of an opcode, read from its row:
# an immediate it represents, or a member of an enumerant or condition. a
# loop takes one at a parameter, whose formulas the check of the loop holds
# to its steps' rows
pub fun fits(op: Opcode, at: u32, v: i64) bool {
    if (sel op.loop)   { ret at < op.loop.roles.len && op.loop.roles.at[at] == mo.NONE; }
    if (!(sel op.row)) { ret false; }
    val r: *rows.Row = op.row;
    if (at >= r.operands.len) { ret false; }
    val ro: *mo.Operand = ?r.operands.at[at];
    if (sel ro.shape.immediate) {
        val bad: opt[str] = immediate(?ro.shape.immediate, v);
        ret sel bad.none;
    }
    if (sel ro.shape.enumerant) {
        val bad: opt[str] = enumerated(?ro.shape.enumerant, Operand.immediate{v});
        ret sel bad.none;
    }
    if (sel ro.shape.condition) {
        val bad: opt[str] = enumerated(?ro.shape.condition, Operand.immediate{v});
        ret sel bad.none;
    }
    ret false;
}

# whether an address of a scale, a displacement and a mode stands at memory
# position `at` of an opcode's row, as far as those parts decide: its scale
# one the position admits, its mode one of its forms, and a symbol where its
# displacement takes a fixup or else a displacement it represents. its
# registers are asked when the instruction is made
pub fun fits_address(op: Opcode, at: u32, scale: u8, disp: i64, mode: mo.Mode, symbolic: bool) bool {
    if (!(sel op.row)) { ret false; }
    val r: *rows.Row = op.row;
    if (at >= r.operands.len) { ret false; }
    val ro: *mo.Operand = ?r.operands.at[at];
    if (!(sel ro.shape.memory)) { ret false; }
    val m: *mo.Memory = ?ro.shape.memory;
    if (scale >= 8 || (scale != 0 && ((m.scales >> scale) & 1) == 0)) { ret false; }
    if (!admits_mode(m, mode))                                        { ret false; }
    if (symbolic)                                                     { ret m.disp.fixup != mo.NO_FIXUP; }
    val bad: opt[str] = immediate(?m.disp, disp);
    ret sel bad.none;
}

# whether an operand names only what the function and the target have
fun known(c: *Context, o: Operand) opt[str] {
    if (sel o.virtual && o.virtual.index::usize >= c.virtuals.size)       { ret opt[str].some{UNKNOWN_VIRTUAL}; }
    if (sel o.member && o.member.virtual.index::usize >= c.virtuals.size) { ret opt[str].some{UNKNOWN_VIRTUAL}; }
    if (sel o.slot && o.slot.index >= c.slots)                            { ret opt[str].some{UNKNOWN_SLOT}; }
    if (sel o.block && o.block.index >= c.blocks)                         { ret opt[str].some{UNKNOWN_BLOCK}; }
    if (sel o.symbol && o.symbol.kind == nil)                             { ret opt[str].some{NO_KIND}; }
    if (sel o.partner && o.partner.kind == nil)                           { ret opt[str].some{NO_KIND}; }
    if (sel o.physical) {
        val p: Physical = o.physical;
        if (file_of(c.set) == nil && sel p.register) { ret opt[str].some{UNFILED_REGISTER}; }
        val held: opt[Class] = class.of(file_of(c.set), p);
        if (sel held.none) { ret opt[str].some{UNKNOWN_REGISTER}; }
    }
    if (sel o.address) {
        val sym: opt[operand.Symbol] = o.address.symbol;
        if (sel sym.some) {
            if (sym.some.kind == nil) { ret opt[str].some{NO_KIND}; }
        }
    }
    if (sel o.literal) {
        if (o.literal.at == nil && o.literal.len != 0) { ret opt[str].some{SHAPE}; }
    }
    if (sel o.tied || sel o.list || sel o.address) {
        var names: [operand.MOST_NAMED]Register;
        val n:     u32 = operand.named(o, ?names[0]);
        var i:     u32 = 0;
        for (i < n) {
            val bad: opt[str] = known_virtual(c, names[i]);
            if (sel bad.some) { ret bad; }
            i = i + 1;
        }
    }
    ret opt[str].none{};
}

# how a position names the location of a virtual register of a class it does
# not admit
# ---
# view:   the register of a view of the class within it, as storage.view
#         states the view
# member: this member of the tuple it is, in the order its class states: the
#         first where a position admits the tuple's members alone, as risc-v's
#         vadd.vv under m2 names a group of two by its first register, which
#         masc's constraint.group_class names the tuple class of, and the one a
#         member operand names at a copy
pub tag Through: u8 {
    view:   storage.View;
    member: u8;
}

# a view an operand position takes of a virtual register's class
# ---
# class:   the class of the position the view is, listed by the position
# through: how the register of that class lies within a register of the
#          virtual's class
pub rec Viewing {
    class:   u16;
    through: Through;
}

# the class of the members of tuple class `k` of `file`, its first member's
# class, none for a class of single registers or of fixed tuples, which no
# operand admits
pub fun member_class(file: *rf.File, k: u16) opt[u16] {
    if (file == nil || k::u32 >= file.class_count)           { ret opt[u16].none{}; }
    if (file.classes[k].arity == 0 || file.classes[k].fixed) { ret opt[u16].none{}; }
    var i: u32 = 0;
    for (i < file.register_count) {
        val row: *rf.Register = ?file.registers[i];
        if (row.class == k && rf.tuple(row)) { ret opt[u16].some{file.registers[row.members.at[0]].class}; }
        i = i + 1;
    }
    ret opt[u16].none{};
}

# the register a viewing names within register `whole` of `file`, none when
# `whole` holds none
pub fun viewed_in(file: *rf.File, whole: rf.Id, w: Viewing) opt[rf.Id] {
    val t: Through = w.through;
    if (sel t.view) { ret storage.viewed(file, whole, w.class, t.view); }
    val part: opt[rf.Id] = rf.member(file, whole, t.member::u32);
    if (sel part.none)                     { ret part; }
    if (rf.class_of(part.some) != w.class) { ret opt[rf.Id].none{}; }
    ret part;
}

# the viewing member `index` of a virtual register of class `k` of `file` is,
# none where `k` is no tuple class an operand admits or has no such member
pub fun member_viewing(file: *rf.File, k: Class, index: u8) opt[Viewing] {
    if (file == nil)       { ret opt[Viewing].none{}; }
    if (!(sel k.hardware)) { ret opt[Viewing].none{}; }
    val h: Hardware = k.hardware;
    if (h.file != file) { ret opt[Viewing].none{}; }
    val m: opt[u16] = member_class(file, h.index);
    if (sel m.none)                                     { ret opt[Viewing].none{}; }
    if (index::u32 >= file.classes[h.index].arity::u32) { ret opt[Viewing].none{}; }
    ret opt[Viewing].some{Viewing{class: m.some, through: Through.member{index}}};
}

# how many members a tuple class `k` of `file` has, 0 for any other class
pub fun arity_of(file: *rf.File, k: Class) u32 {
    if (file == nil)       { ret 0; }
    if (!(sel k.hardware)) { ret 0; }
    val h: Hardware = k.hardware;
    if (h.file != file || h.index::u32 >= file.class_count) { ret 0; }
    ret file.classes[h.index].arity::u32;
}

# the first class a register position admits that is a view of class `k` of
# `file`, or else the class of the members of tuple class `k` where the
# position admits it, none where the position admits `k` itself or neither
fun viewing_in(file: *rf.File, rr: *mo.Register, k: Class) opt[Viewing] {
    if (file == nil)       { ret opt[Viewing].none{}; }
    if (!(sel k.hardware)) { ret opt[Viewing].none{}; }
    val h: Hardware = k.hardware;
    if (h.file != file || mo.find(rr.classes, h.index) >= 0) { ret opt[Viewing].none{}; }
    var i: u32 = 0;
    for (i < rr.classes.len) {
        val v: opt[storage.View] = storage.view(file, rr.classes.at[i], h.index);
        if (sel v.some) { ret opt[Viewing].some{Viewing{class: rr.classes.at[i], through: Through.view{v.some}}}; }
        i = i + 1;
    }
    val m: opt[u16] = member_class(file, h.index);
    if (sel m.none)                      { ret opt[Viewing].none{}; }
    if (mo.find(rr.classes, m.some) < 0) { ret opt[Viewing].none{}; }
    ret opt[Viewing].some{Viewing{class: m.some, through: Through.member{0}}};
}

# the view position `at` of an opcode takes of a virtual register of class
# `k` it names, none where it admits the class itself, admits no view of it,
# or is no register position of a row: a pseudo's and a loop's positions take
# no view, as a loop holds each operand whole and its steps view it once it
# is a register (`step_operands`)
pub fun viewing(file: *rf.File, op: Opcode, at: u32, k: Class) opt[Viewing] {
    if (!(sel op.row)) { ret opt[Viewing].none{}; }
    val r: *rows.Row = op.row;
    if (at >= r.operands.len) { ret opt[Viewing].none{}; }
    val ro: *mo.Operand = ?r.operands.at[at];
    if (!(sel ro.shape.register)) { ret opt[Viewing].none{}; }
    ret viewing_in(file, ?ro.shape.register, k);
}

# whether a register stands at a register position of row `r`, a virtual one
# of a class the position views when `viewed`
fun register(c: *Context, r: *rows.Row, at: u32, rr: *mo.Register, reg: Register, viewed: bool) opt[str] {
    val pinned: opt[rf.Id] = fixed(c.set, Opcode.row{r}, at);
    if (sel reg.virtual) {
        val k: Class = c.virtuals.data[reg.virtual.index];
        if (!(sel k.hardware))                 { ret opt[str].some{CLASS}; }
        if (k.hardware.file != file_of(c.set)) { ret opt[str].some{CLASS}; }
        if (mo.find(rr.classes, k.hardware.index) < 0) {
            val v: opt[Viewing] = viewing_in(file_of(c.set), rr, k);
            if (!viewed || sel v.none) { ret opt[str].some{CLASS}; }
            if (sel pinned.some)       { ret opt[str].some{FIXED}; }
            ret opt[str].none{};
        }
        if (sel pinned.some && !class.holds(k, Physical.register{pinned.some})) { ret opt[str].some{FIXED}; }
        ret opt[str].none{};
    }
    val p: Physical = reg.physical;
    if (!(sel p.register))                            { ret opt[str].some{CLASS}; }
    if (sel pinned.some && p.register != pinned.some) { ret opt[str].some{FIXED}; }
    val number: u32 = rf.number_of(p.register)::u32;
    val within: u16 = rf.class_of(p.register);
    if (mo.find(rr.classes, within) < 0)                                                                      { ret opt[str].some{CLASS}; }
    if (!mo.within(rr, number, rf.count_most(file_of(c.set), within)::u32) || mo.excludes_number(rr, number)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether an immediate stands at an immediate position
fun immediate(imm: *mo.Immediate, v: i64) opt[str] {
    val bad: opt[str] = walk.unrepresentable(imm, v);
    if (sel bad.some || mo.excludes_value(imm, v)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether a system register stands at an id position, which takes the
# register's number in its class, as a csr instruction names its csr
fun identified(t: *mo.Typed, o: Operand) opt[str] {
    if (!(sel o.physical)) { ret opt[str].some{SHAPE}; }
    val p: Physical = o.physical;
    if (!(sel p.register)) { ret opt[str].some{SHAPE}; }
    val n: u64 = rf.number_of(p.register)::u64;
    if (t.bits < 64 && n >> t.bits::u64 != 0) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether an enumerant or condition stands at its position
fun enumerated(e: *mo.Enumeration, o: Operand) opt[str] {
    if (!(sel o.immediate))                                                             { ret opt[str].some{SHAPE}; }
    if (o.immediate < 0 || o.immediate > 0xffffffff || !mo.member(e, o.immediate::u32)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether operand `o` stands at position `at` of row `r`, a virtual register,
# or a virtual half of a tie, named through a view of its class when `viewed`
fun position(c: *Context, r: *rows.Row, at: u32, o: Operand, viewed: bool) opt[str] {
    val ro: *mo.Operand = ?r.operands.at[at];
    if (sel o.tied) {
        if (ro.role != mo.READ_WRITE || !(sel ro.shape.register)) { ret opt[str].some{TIED_ROLE}; }
    }
    if (sel ro.shape.register) {
        if (sel o.virtual)  { ret register(c, r, at, ?ro.shape.register, Register.virtual{o.virtual}, viewed); }
        if (sel o.physical) { ret register(c, r, at, ?ro.shape.register, Register.physical{o.physical}, false); }
        if (sel o.tied) {
            val d: opt[str] = register(c, r, at, ?ro.shape.register, o.tied.dest, viewed);
            if (sel d.some) { ret d; }
            val s: opt[str] = register(c, r, at, ?ro.shape.register, o.tied.source, viewed);
            if (sel s.some) { ret s; }
            val dest:   Register = o.tied.dest;
            val source: Register = o.tied.source;
            if (sel dest.physical) {
                if (sel source.physical && !class.same_physical(dest.physical, source.physical)) { ret opt[str].some{UNTIED}; }
            }
            ret opt[str].none{};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.memory) {
        if (sel o.address)                               { ret address(c, r, at, ?ro.shape.memory, o.address); }
        if (sel o.slot || sel o.symbol || sel o.partner) { ret opt[str].none{}; }
        if (sel o.virtual) {
            val k: Class = c.virtuals.data[o.virtual.index];
            if (sel k.memory) { ret opt[str].none{}; }
            ret opt[str].some{CLASS};
        }
        if (sel o.physical) {
            if (sel o.physical.cell) { ret opt[str].none{}; }
            ret opt[str].some{CLASS};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.immediate) {
        if (sel o.immediate) { ret immediate(?ro.shape.immediate, o.immediate); }
        if (sel o.symbol || sel o.partner) {
            if (ro.shape.immediate.fixup == mo.NO_FIXUP) { ret opt[str].some{SHAPE}; }
            ret opt[str].none{};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.relative) {
        if (sel o.block || sel o.symbol || sel o.partner) { ret opt[str].none{}; }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.marker) {
        if (sel o.symbol) { ret opt[str].none{}; }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.id)        { ret identified(?ro.shape.id, o); }
    if (sel ro.shape.enumerant) { ret enumerated(?ro.shape.enumerant, o); }
    if (sel ro.shape.condition) { ret enumerated(?ro.shape.condition, o); }
    if (sel ro.shape.list) {
        if (sel o.list) { ret list(c, r, at, ?ro.shape.list, o.list); }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.literal) {
        if (sel o.literal) { ret literal(?ro.shape.literal, o.literal); }
        ret opt[str].some{SHAPE};
    }
    ret opt[str].some{SHAPE};
}

# whether a register of an address stands at its part of a memory position,
# none standing where the position admits no register there
fun address_part(c: *Context, r: *rows.Row, at: u32, rr: *mo.Register, reg: opt[Register]) opt[str] {
    if (sel reg.none)        { ret opt[str].none{}; }
    if (rr.classes.len == 0) { ret opt[str].some{SHAPE}; }
    ret register(c, r, at, rr, reg.some, false);
}

# whether a mode is one a memory position admits, by the forms it states
fun admits_mode(m: *mo.Memory, mode: mo.Mode) bool {
    if (mode == mo.OFFSET)             { ret true; }
    if (mode == mo.RELATIVE_PC)        { ret (m.forms & mo.PCREL) != 0; }
    if (mode == mo.PREINDEX)           { ret (m.forms & mo.PRE) != 0; }
    if (mode == mo.POSTINDEX)          { ret (m.forms & mo.POST) != 0; }
    if (mode == mo.POSTINDEX_REGISTER) { ret (m.forms & mo.POST_REGISTER) != 0; }
    ret false;
}

# whether an address stands at a memory position: each register at its
# part, a scale, mode, extend and broadcast it admits, and a displacement it
# represents or a symbol where its displacement takes a fixup
fun address(c: *Context, r: *rows.Row, at: u32, m: *mo.Memory, a: operand.Address) opt[str] {
    val base: opt[str] = address_part(c, r, at, ?m.base, a.base);
    if (sel base.some) { ret base; }
    val index: opt[str] = address_part(c, r, at, ?m.index, a.index);
    if (sel index.some) { ret index; }
    val segment: opt[str] = address_part(c, r, at, ?m.segment, a.segment);
    if (sel segment.some) { ret segment; }
    if (sel a.index.none) {
        if (a.scale != 0 || a.extend != 0) { ret opt[str].some{RANGE}; }
    }
    or {
        if (a.scale >= 8 || ((m.scales >> a.scale) & 1) == 0)  { ret opt[str].some{RANGE}; }
        if (a.extend != 0 && !mo.member(?m.extends, a.extend)) { ret opt[str].some{RANGE}; }
    }
    if (!admits_mode(m, a.mode)) { ret opt[str].some{SHAPE}; }
    if (a.broadcast != 0) {
        if (a.broadcast >= 8 || ((m.broadcasts >> a.broadcast) & 1) == 0) { ret opt[str].some{RANGE}; }
    }
    if (sel a.symbol.some) {
        if (m.disp.fixup == mo.NO_FIXUP || a.disp != 0) { ret opt[str].some{SHAPE}; }
        ret opt[str].none{};
    }
    ret immediate(?m.disp, a.disp);
}

# whether a list stands at a list position: as many members as it admits and
# a first member of its member registers, a virtual one naming the group the
# whole list covers
fun list(c: *Context, r: *rows.Row, at: u32, l: *mo.List, given: operand.List) opt[str] {
    if (given.count < l.min || given.count > l.max) { ret opt[str].some{RANGE}; }
    val first: opt[str] = register(c, r, at, ?l.member, given.first, false);
    if (sel first.some) { ret first; }
    val head: Register = given.first;
    if (sel head.physical) {
        if (!(sel head.physical.register))                                     { ret opt[str].some{CLASS}; }
        if (mo.excludes_leading(l, rf.number_of(head.physical.register)::u32)) { ret opt[str].some{RANGE}; }
    }
    ret opt[str].none{};
}

# whether bytes stand at a literal position: no more than it admits, and some
# for a number
fun literal(l: *mo.Literal, b: mo.Bytes) opt[str] {
    if (b.len > l.max || (l.content == mo.NUMBER && b.len == 0)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether operand `o` stands at a pseudo position of opcode `op`: a member
# only at a copy's or a parallel copy's
fun pseudo_position(c: *Context, op: Pseudo, p: *pseudo.Position, o: Operand) opt[str] {
    if (sel o.member) {
        if (op != pseudo.COPY && op != pseudo.PARALLEL_COPY) { ret opt[str].some{SHAPE}; }
        if (p.kind == pseudo.SLOT || p.kind == pseudo.BLOCK) { ret opt[str].some{SHAPE}; }
        val w: opt[Viewing] = member_viewing(file_of(c.set), c.virtuals.data[o.member.virtual.index], o.member.index);
        if (sel w.none) { ret opt[str].some{CLASS}; }
        ret opt[str].none{};
    }
    if (p.kind == pseudo.BLOCK) {
        if (sel o.block) { ret opt[str].none{}; }
        ret opt[str].some{SHAPE};
    }
    if (sel o.slot && p.kind != pseudo.REGISTER) { ret opt[str].none{}; }
    if (p.kind == pseudo.SLOT)                   { ret opt[str].some{SHAPE}; }
    if (sel o.virtual || sel o.physical)         { ret opt[str].none{}; }
    ret opt[str].some{SHAPE};
}

# whether a row is one of the catalog's, the row its key finds
fun in_catalog(c: *Context, r: *rows.Row) bool {
    if (c.set.codec == nil || r == nil) { ret false; }
    val found: opt[*rows.Row] = masc_emit.row_keyed(c.set, r.key);
    ret sel found.some && found.some == r;
}

# whether a register a loop writes is named at another of its positions
fun named_twice(operands: Slice[Operand], l: *lrow.Loop, at: u32) bool {
    if (l.roles.at[at] != mo.WRITE) { ret false; }
    val o: Operand  = operands.data[at];
    var r: Register = Register.virtual{Virtual{index: 0}};
    if (sel o.virtual)  { r = Register.virtual{o.virtual}; }
    or (sel o.physical) { r = Register.physical{o.physical}; }
    or                  { ret false; }
    var k: u32 = 0;
    for (k::usize < operands.size) {
        val other: Operand = operands.data[k];
        if (k != at) {
            if (sel other.virtual && operand.same_register(r, Register.virtual{other.virtual}))    { ret true; }
            if (sel other.physical && operand.same_register(r, Register.physical{other.physical})) { ret true; }
        }
        k = k + 1;
    }
    ret false;
}

# the immediate a loop's parameter position holds, zero for a position that
# holds none, which the check refuses
fun parameter_of(operands: Slice[Operand], at: u8) i64 {
    if (at::usize >= operands.size) { ret 0; }
    val o: Operand = operands.data[at];
    if (sel o.immediate) { ret o.immediate; }
    ret 0;
}

# the immediate a formula of a loop gives of the loop's parameters
pub fun formula(f: lrow.Formula, operands: Slice[Operand]) i64 {
    ret lrow.evaluate(f, parameter_of(operands, f.terms[0].parameter), parameter_of(operands, f.terms[1].parameter));
}

# check a loop's operands: an immediate at each parameter position and a
# register at each other one that every step's row admits where the step
# names it, a register it writes named at no other position, and each
# literal and formula an immediate its step's row admits
fun check_loop(c: *Context, l: *lrow.Loop, operands: Slice[Operand]) err[Refusal] {
    if (operands.size != l.roles.len::usize) { ret refuse(NO_OPERAND, COUNT); }
    var i: u32 = 0;
    for (i < l.roles.len) {
        val o: Operand = operands.data[i];
        if (l.roles.at[i] == mo.NONE) {
            if (!(sel o.immediate)) { ret refuse(i, SHAPE); }
        }
        or (!(sel o.virtual || sel o.physical)) { ret refuse(i, SHAPE); }
        if (named_twice(operands, l, i))        { ret refuse(i, LOOP_REGISTER); }
        i = i + 1;
    }
    var k: u32 = 0;
    for (k < lrow.count(l)) {
        val s: *lrow.Step = lrow.step(l, k);
        if (!in_catalog(c, s.row))                { ret refuse(NO_OPERAND, FOREIGN_ROW); }
        if (s.operands.len != s.row.operands.len) { ret refuse(NO_OPERAND, COUNT); }
        var j: u32 = 0;
        for (j < s.operands.len) {
            val src: lrow.Source = s.operands.at[j];
            if (sel src.operand) {
                val at: u32 = src.operand::u32;
                if (at >= l.roles.len) { ret refuse(NO_OPERAND, COUNT); }
                val bad: opt[str] = position(c, s.row, j, step_viewed(file_of(c.set), s.row, j, operands.data[at]), true);
                if (sel bad.some) { ret refuse(at, bad.some); }
            }
            or (sel src.address) {
                val at: u32 = src.address::u32;
                if (at >= l.roles.len) { ret refuse(NO_OPERAND, COUNT); }
                val bad: opt[str] = position(c, s.row, j, addressed(operands.data[at]), false);
                if (sel bad.some) { ret refuse(at, bad.some); }
            }
            or (sel src.literal || sel src.formula) {
                var v: i64 = 0;
                if (sel src.literal) { v = src.literal; }
                or (sel src.formula) { v = formula(src.formula, operands); }
                val bad: opt[str] = position(c, s.row, j, Operand.immediate{v}, false);
                if (sel bad.some) { ret refuse(NO_OPERAND, bad.some); }
            }
            j = j + 1;
        }
        k = k + 1;
    }
    ret err[Refusal].ok{};
}

# whether register `r` stands at an inline block's operand of class `class`:
# a virtual register of the class, or a register of it
fun inline_register(c: *Context, r: Register, class: u16) opt[str] {
    if (sel r.virtual) {
        val k: Class = c.virtuals.data[r.virtual.index];
        if (!(sel k.hardware))                                              { ret opt[str].some{CLASS}; }
        if (k.hardware.file != file_of(c.set) || k.hardware.index != class) { ret opt[str].some{CLASS}; }
        ret opt[str].none{};
    }
    val p: Physical = r.physical;
    if (!(sel p.register))                { ret opt[str].some{CLASS}; }
    if (rf.class_of(p.register) != class) { ret opt[str].some{CLASS}; }
    ret opt[str].none{};
}

# check an inline block's operands: one per operand of the block, a register
# of its class where it reads or writes one, tied where it reads and writes
# one, a frame slot or an address with a base and nothing else for memory,
# and an immediate of its constraint's bits
fun check_inline(c: *Context, x: *Inline, operands: Slice[Operand]) err[Refusal] {
    if (operands.size != x.operands.size) { ret refuse(NO_OPERAND, COUNT); }
    var i: u32 = 0;
    for (i::usize < operands.size) {
        val o:  Operand                = operands.data[i];
        val io: *masc_inline.Operand   = ?x.operands.data[i];
        val k:  masc_inline.Constraint = io.constraint;
        if (sel k.class) {
            if (io.role == mo.READ_WRITE) {
                if (!(sel o.tied)) { ret refuse(i, TIED_ROLE); }
                val d: opt[str] = inline_register(c, o.tied.dest, k.class);
                if (sel d.some) { ret refuse(i, d.some); }
                val s: opt[str] = inline_register(c, o.tied.source, k.class);
                if (sel s.some) { ret refuse(i, s.some); }
            }
            or (sel o.virtual) {
                val bad: opt[str] = inline_register(c, Register.virtual{o.virtual}, k.class);
                if (sel bad.some) { ret refuse(i, bad.some); }
            }
            or (sel o.physical) {
                val bad: opt[str] = inline_register(c, Register.physical{o.physical}, k.class);
                if (sel bad.some) { ret refuse(i, bad.some); }
            }
            or { ret refuse(i, SHAPE); }
        }
        or (sel k.memory) {
            if (sel o.slot) {
                i = i + 1;
                cnt;
            }
            if (!(sel o.address))                                         { ret refuse(i, SHAPE); }
            if (sel o.address.base.none || sel o.address.index.some)      { ret refuse(i, SHAPE); }
            if (sel o.address.symbol.some || o.address.mode != mo.OFFSET) { ret refuse(i, SHAPE); }
        }
        or {
            if (!(sel o.immediate)) { ret refuse(i, SHAPE); }
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# check an instruction against its opcode's row
# ---
# c:        what it is checked against
# op:       the opcode
# operands: the operands
# state:    the vector state it runs under, none when it states none
# ret:      ok, or the first operand that does not stand where it is
pub fun check(c: *Context, op: Opcode, operands: Slice[Operand], state: opt[vstate.State]) err[Refusal] {
    var needs: u32  = NO_OPERAND;
    var found: bool = false;
    var k:     u32  = 0;
    for (k < rows_in(op) && !found) {
        val n: opt[u32] = vstate.needs(row_in(op, k));
        if (sel n.some) {
            found = true;
            if (sel op.row) { needs = n.some; }
        }
        k = k + 1;
    }
    if (found && sel state.none)  { ret refuse(needs, UNSTATED); }
    if (!found && sel state.some) { ret refuse(NO_OPERAND, UNREAD_STATE); }
    var i: u32 = 0;
    for (i::usize < operands.size) {
        val bad: opt[str] = known(c, operands.data[i]);
        if (sel bad.some) { ret refuse(i, bad.some); }
        i = i + 1;
    }
    if (sel op.row) {
        val r: *rows.Row = op.row;
        if (!in_catalog(c, r))                      { ret refuse(NO_OPERAND, FOREIGN_ROW); }
        if (operands.size != r.operands.len::usize) { ret refuse(NO_OPERAND, COUNT); }
        var listed: u32 = 0;
        i = 0;
        for (i < r.operands.len) {
            val bad: opt[str] = position(c, r, i, operands.data[i], true);
            if (sel bad.some) { ret refuse(i, bad.some); }
            val o: Operand = operands.data[i];
            if (sel o.list) {
                listed = listed + o.list.count::u32;
                if (listed > MOST_MEMBERS) { ret refuse(i, LISTED); }
            }
            i = i + 1;
        }
        ret err[Refusal].ok{};
    }
    or (sel op.loop)   { ret check_loop(c, op.loop, operands); }
    or (sel op.inline) { ret check_inline(c, op.inline, operands); }
    val pr: opt[*pseudo.Row] = pseudo.row(op.pseudo);
    if (sel pr.none)                              { ret refuse(NO_OPERAND, UNKNOWN_PSEUDO); }
    if (operands.size == 0 && pr.some.count == 0) { ret err[Refusal].ok{}; }
    i = 0;
    for (i::usize < operands.size) {
        val p: opt[*pseudo.Position] = pseudo.position(pr.some, operands.size::u32, i);
        if (sel p.none) { ret refuse(NO_OPERAND, COUNT); }
        val bad: opt[str] = pseudo_position(c, op.pseudo, p.some, operands.data[i]);
        if (sel bad.some) { ret refuse(i, bad.some); }
        i = i + 1;
    }
    if (operands.size == 0) { ret refuse(NO_OPERAND, COUNT); }
    ret err[Refusal].ok{};
}
