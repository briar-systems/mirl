# machine instructions: an opcode, its operands and the metadata it came with
#
# a row opcode is a row of masc's catalog for the target, and everything an
# operand position admits, its register classes, its fixed register and its
# role, is read from that row. a pseudo opcode is a row of the pseudo table.
# an instruction is checked against its opcode's row when it is made, so a
# tied operand stands only where the row reads and writes one register, and
# its two halves are one location once both are assigned.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.ir.metadata.Metadata;
use mirl.machine.class;
use mirl.machine.class.Class;
use mirl.machine.class.Physical;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;
use mirl.machine.pseudo;
use mirl.machine.pseudo.Pseudo;

use masc.core.effect;
use mo:   masc.core.operand;
use rf:   masc.core.register;
use rows: masc.core.row;
use masc.core.walk;

# an opcode
# ---
# row:    a row of masc's catalog for the target
# pseudo: a target-neutral pseudo-instruction
pub tag Opcode: u8 {
    row:    *rows.Row;
    pseudo: Pseudo;
}

# one instruction
# ---
# opcode:       its opcode
# operands:     one per operand position of its opcode's row, in order
# metadata:     the metadata record of the ir instruction it came from
# declassifies: it came from an ir instruction whose row declassifies, so it
#               is a barrier that secrecy ends at and is never merged, moved
#               or removed as a plain copy
pub rec InstructionData {
    opcode:       Opcode;
    operands:     Slice[Operand];
    metadata:     Metadata;
    declassifies: bool;
}

# what an instruction is checked against
# ---
# file:     the target's register file, nil for a set with none
# rows:     the target's catalog rows
# virtuals: the class of each virtual register
# slots:    how many frame slots there are
# blocks:   how many blocks there are
pub rec Context {
    file:     *rf.File;
    rows:     rows.Rows;
    virtuals: Slice[Class];
    slots:    u32;
    blocks:   u32;
}

# the operand a refusal names when it names none
pub val NO_OPERAND: u32 = 0xffffffff;

# why an instruction was refused
# ---
# operand: the operand position, NO_OPERAND for the instruction as a whole
# what:    the fact that does not hold
pub rec Refusal {
    operand: u32;
    what:    str;
}

pub val FOREIGN_ROW:      str = "row not in the target's catalog";
pub val UNKNOWN_PSEUDO:   str = "pseudo not in the pseudo table";
pub val COUNT:            str = "operand count differs from the row's";
pub val SHAPE:            str = "operand of a kind its position does not admit";
pub val CLASS:            str = "register of a class its position does not admit";
pub val RANGE:            str = "value outside what its position admits";
pub val FIXED:            str = "register other than the one its row fixes";
pub val TIED_ROLE:        str = "tied operand where the row does not read and write one register";
pub val UNTIED:           str = "tied operand whose halves are different locations";
pub val UNKNOWN_VIRTUAL:  str = "virtual register the function does not have";
pub val UNKNOWN_REGISTER: str = "register the register file does not have";
pub val UNKNOWN_SLOT:     str = "frame slot the function does not have";
pub val UNKNOWN_BLOCK:    str = "block the function does not have";
pub val NO_KIND:          str = "symbol with no relocation kind";

# whether an opcode encodes to bytes, which no pseudo does
pub fun emits(op: Opcode) bool {
    ret sel op.row;
}

# the register a row opcode fixes operand `at` to, read from its row's effect
# ---
# file: the register file the row's register rows index
# op:   the opcode
# at:   the operand position
# ret:  the register, none when the position is not fixed
pub fun fixed(file: *rf.File, op: Opcode, at: u32) opt[rf.Id] {
    if (!(sel op.row)) { ret opt[rf.Id].none{}; }
    val r: *rows.Row = op.row;
    if (r.effect == nil || file == nil || at >= r.operands.len) { ret opt[rf.Id].none{}; }
    val got: opt[u32] = effect.fixed(r.effect, at::u8);
    if (sel got.none)                    { ret opt[rf.Id].none{}; }
    if (got.some >= file.register_count) { ret opt[rf.Id].none{}; }
    ret opt[rf.Id].some{rf.id_of(?file.registers[got.some])};
}

# how an instruction of `count` operands uses operand `at`
pub fun role(op: Opcode, count: u32, at: u32) mo.Role {
    if (sel op.row) {
        if (at >= op.row.operands.len) { ret mo.NONE; }
        ret op.row.operands.at[at].role;
    }
    val r: opt[*pseudo.Row] = pseudo.row(op.pseudo);
    if (sel r.none) { ret mo.NONE; }
    val p: opt[*pseudo.Position] = pseudo.position(r.some, count, at);
    if (sel p.none) { ret mo.NONE; }
    ret p.some.role;
}

fun refuse(at: u32, what: str) err[Refusal] {
    ret err[Refusal].err{Refusal{operand: at, what: what}};
}

fun known_virtual(c: *Context, r: Register) opt[str] {
    if (sel r.virtual && r.virtual.index::usize >= c.virtuals.size) { ret opt[str].some{UNKNOWN_VIRTUAL}; }
    ret opt[str].none{};
}

# whether a constant stands at operand `at` of an opcode, read from its row:
# an immediate it represents, or a member of an enumerant or condition
pub fun fits(op: Opcode, at: u32, v: i64) bool {
    if (!(sel op.row)) { ret false; }
    val r: *rows.Row = op.row;
    if (at >= r.operands.len) { ret false; }
    val ro: *mo.Operand = ?r.operands.at[at];
    if (sel ro.shape.immediate) {
        val bad: opt[str] = immediate(?ro.shape.immediate, v);
        ret sel bad.none;
    }
    if (sel ro.shape.enumerant) {
        val bad: opt[str] = enumerated(?ro.shape.enumerant, Operand.immediate{v});
        ret sel bad.none;
    }
    if (sel ro.shape.condition) {
        val bad: opt[str] = enumerated(?ro.shape.condition, Operand.immediate{v});
        ret sel bad.none;
    }
    ret false;
}

# whether an operand names only what the function and the target have
fun known(c: *Context, o: Operand) opt[str] {
    if (sel o.virtual && o.virtual.index::usize >= c.virtuals.size) { ret opt[str].some{UNKNOWN_VIRTUAL}; }
    if (sel o.slot && o.slot.index >= c.slots)                      { ret opt[str].some{UNKNOWN_SLOT}; }
    if (sel o.block && o.block.index >= c.blocks)                   { ret opt[str].some{UNKNOWN_BLOCK}; }
    if (sel o.symbol && o.symbol.kind == nil)                       { ret opt[str].some{NO_KIND}; }
    if (sel o.physical) {
        val held: opt[Class] = class.of(c.file, o.physical);
        if (sel held.none) { ret opt[str].some{UNKNOWN_REGISTER}; }
    }
    if (sel o.tied) {
        val d: opt[str] = known_virtual(c, o.tied.dest);
        if (sel d.some) { ret d; }
        ret known_virtual(c, o.tied.source);
    }
    ret opt[str].none{};
}

# whether a register stands at a register position of row `r`
fun register(c: *Context, r: *rows.Row, at: u32, rr: *mo.Register, reg: Register) opt[str] {
    val pinned: opt[rf.Id] = fixed(c.file, Opcode.row{r}, at);
    if (sel reg.virtual) {
        val k: Class = c.virtuals.data[reg.virtual.index];
        if (!(sel k.hardware))                                                      { ret opt[str].some{CLASS}; }
        if (k.hardware.file != c.file || mo.find(rr.classes, k.hardware.index) < 0) { ret opt[str].some{CLASS}; }
        if (sel pinned.some && !class.holds(k, Physical.register{pinned.some}))     { ret opt[str].some{FIXED}; }
        ret opt[str].none{};
    }
    val p: Physical = reg.physical;
    if (!(sel p.register))                            { ret opt[str].some{CLASS}; }
    if (sel pinned.some && p.register != pinned.some) { ret opt[str].some{FIXED}; }
    val number: u32 = rf.number_of(p.register)::u32;
    val within: u16 = rf.class_of(p.register);
    if (mo.find(rr.classes, within) < 0)                                                        { ret opt[str].some{CLASS}; }
    if (!mo.within(rr, number, c.file.classes[within].count) || mo.excludes_number(rr, number)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether an immediate stands at an immediate position
fun immediate(imm: *mo.Immediate, v: i64) opt[str] {
    val bad: opt[str] = walk.unrepresentable(imm, v);
    if (sel bad.some || mo.excludes_value(imm, v)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether an enumerant or condition stands at its position
fun enumerated(e: *mo.Enumeration, o: Operand) opt[str] {
    if (!(sel o.immediate))                                                             { ret opt[str].some{SHAPE}; }
    if (o.immediate < 0 || o.immediate > 0xffffffff || !mo.member(e, o.immediate::u32)) { ret opt[str].some{RANGE}; }
    ret opt[str].none{};
}

# whether operand `o` stands at position `at` of row `r`
fun position(c: *Context, r: *rows.Row, at: u32, o: Operand) opt[str] {
    val ro: *mo.Operand = ?r.operands.at[at];
    if (sel o.tied) {
        if (ro.role != mo.READ_WRITE || !(sel ro.shape.register)) { ret opt[str].some{TIED_ROLE}; }
    }
    if (sel ro.shape.register) {
        if (sel o.virtual)  { ret register(c, r, at, ?ro.shape.register, Register.virtual{o.virtual}); }
        if (sel o.physical) { ret register(c, r, at, ?ro.shape.register, Register.physical{o.physical}); }
        if (sel o.tied) {
            val d: opt[str] = register(c, r, at, ?ro.shape.register, o.tied.dest);
            if (sel d.some) { ret d; }
            val s: opt[str] = register(c, r, at, ?ro.shape.register, o.tied.source);
            if (sel s.some) { ret s; }
            val dest:   Register = o.tied.dest;
            val source: Register = o.tied.source;
            if (sel dest.physical) {
                if (sel source.physical && !class.same_physical(dest.physical, source.physical)) { ret opt[str].some{UNTIED}; }
            }
            ret opt[str].none{};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.memory) {
        if (sel o.slot || sel o.symbol) { ret opt[str].none{}; }
        if (sel o.virtual) {
            val k: Class = c.virtuals.data[o.virtual.index];
            if (sel k.memory) { ret opt[str].none{}; }
            ret opt[str].some{CLASS};
        }
        if (sel o.physical) {
            if (sel o.physical.cell) { ret opt[str].none{}; }
            ret opt[str].some{CLASS};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.immediate) {
        if (sel o.immediate) { ret immediate(?ro.shape.immediate, o.immediate); }
        if (sel o.symbol) {
            if (ro.shape.immediate.fixup == mo.NO_FIXUP) { ret opt[str].some{SHAPE}; }
            ret opt[str].none{};
        }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.relative) {
        if (sel o.block || sel o.symbol) { ret opt[str].none{}; }
        ret opt[str].some{SHAPE};
    }
    if (sel ro.shape.enumerant) { ret enumerated(?ro.shape.enumerant, o); }
    if (sel ro.shape.condition) { ret enumerated(?ro.shape.condition, o); }
    ret opt[str].some{SHAPE};
}

# whether operand `o` stands at a pseudo position
fun pseudo_position(p: *pseudo.Position, o: Operand) opt[str] {
    if (p.kind == pseudo.SLOT) {
        if (sel o.slot) { ret opt[str].none{}; }
        ret opt[str].some{SHAPE};
    }
    if (sel o.virtual || sel o.physical) { ret opt[str].none{}; }
    ret opt[str].some{SHAPE};
}

# whether a row is one of the catalog's, by its position in the catalog's rows
fun in_catalog(c: *Context, r: *rows.Row) bool {
    if (c.rows.len == 0 || r == nil) { ret false; }
    val base: u64 = c.rows.at:~u64;
    val at:   u64 = r:~u64;
    val size: u64 = $size_of(rows.Row)::u64;
    if (at < base || (at - base) % size != 0) { ret false; }
    val k: u64 = (at - base) / size;
    ret k < c.rows.len::u64 && ?c.rows.at[k] == r;
}

# check an instruction against its opcode's row
# ---
# c:        what it is checked against
# op:       the opcode
# operands: the operands
# ret:      ok, or the first operand that does not stand where it is
pub fun check(c: *Context, op: Opcode, operands: Slice[Operand]) err[Refusal] {
    var i: u32 = 0;
    for (i::usize < operands.size) {
        val bad: opt[str] = known(c, operands.data[i]);
        if (sel bad.some) { ret refuse(i, bad.some); }
        i = i + 1;
    }
    if (sel op.row) {
        val r: *rows.Row = op.row;
        if (!in_catalog(c, r))                      { ret refuse(NO_OPERAND, FOREIGN_ROW); }
        if (operands.size != r.operands.len::usize) { ret refuse(NO_OPERAND, COUNT); }
        i = 0;
        for (i < r.operands.len) {
            val bad: opt[str] = position(c, r, i, operands.data[i]);
            if (sel bad.some) { ret refuse(i, bad.some); }
            i = i + 1;
        }
        ret err[Refusal].ok{};
    }
    val pr: opt[*pseudo.Row] = pseudo.row(op.pseudo);
    if (sel pr.none)                              { ret refuse(NO_OPERAND, UNKNOWN_PSEUDO); }
    if (operands.size == 0 && pr.some.count == 0) { ret err[Refusal].ok{}; }
    i = 0;
    for (i::usize < operands.size) {
        val p: opt[*pseudo.Position] = pseudo.position(pr.some, operands.size::u32, i);
        if (sel p.none) { ret refuse(NO_OPERAND, COUNT); }
        val bad: opt[str] = pseudo_position(p.some, operands.data[i]);
        if (sel bad.some) { ret refuse(i, bad.some); }
        i = i + 1;
    }
    if (operands.size == 0) { ret refuse(NO_OPERAND, COUNT); }
    ret err[Refusal].ok{};
}
