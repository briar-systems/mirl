# inline assembly blocks in the machine form
#
# selection hands masc the text and operands of an ir block under the context
# its function is encoded under, widened by the selection the block states
# (`mirl.target.head`), and keeps what masc parsed as one `Inline`, which
# the machine instruction standing for the block names as its opcode, as an
# instruction names its row. the instruction has one operand per operand of
# the block, in order: a virtual register of the constraint's class for a
# register the block reads or writes, tied for one it reads and writes, an
# address whose base holds the bound address for memory, and an immediate for
# a constant. what the block itself reads and writes of the register file,
# each name's operand left out, is masc's footprint of it, answered once here,
# a register it writes never also a read, since the block leaves it holding
# no value of the function's. selection states these as the instruction's
# implicit locations, so liveness
# keeps no value in a register the block writes across it and the frame saves
# a preserved register it writes. a footprint masc leaves undecided, as a data
# directive that declares nothing it writes, is taken as writing every register
# the build's view admits but the stack pointer, the frame pointer and a zero
# register, since a block leaves both pointers as it found them, and a frame
# that keeps its pointer refuses a block whose footprint writes it. after
# allocation, the handover hands masc the block with each operand's location,
# and masc encodes it at the builder's cursor, under the block's own context.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use ia: mirl.ir.assembly;
use mirl.target.head;
use mirl.target.head.Heads;
use mirl.target.record.Target;

use masc.core.diagnostic;
use masc.core.effect;
use masc.core.footprint;
use masc.core.query;
use rf:   masc.core.register;
use mset: masc.core.set;
use masc.core.state;
use masc.inline;
use mink.catalog.format.Format;

# one block masc parsed
# ---
# block:    masc's reading of it, which `encode` writes after allocation
# operands: its operands as masc was given them, one per operand of the
#           instruction, their names left out
# reads:    the registers the block itself reads and does not write
# writes:   the registers the block itself writes or leaves unspecified
# stack:    what the block does to the stack pointer
# transfer: how the block comes back to the instruction after it: by falling
#           through, after a call, or after a trap, as a system call. control
#           that leaves by a jump out of the block or a fault never comes back
# context:  the context it was read under, which it is encoded under
# publics:  the operands whose memory holds a pointer the ir states reaches storage holding no secret, bit n operand n
# secrets:  those whose memory holds a pointer the ir states reaches storage holding a secret in every byte
pub rec Inline {
    block:    inline.Block;
    operands: Slice[inline.Operand];
    reads:    Slice[rf.Id];
    writes:   Slice[rf.Id];
    stack:    effect.Stack;
    transfer: effect.Transfer;
    context:  *state.Context;
    publics:  u32;
    secrets:  u32;
}

# the blocks one selector parsed, each held until the selector is given back,
# since every form of a function after selection names them
# ---
# a:     the allocator each is taken from
# held:  each block, at an address of its own
# heads: the selections they state, read once each
pub rec Inlines {
    a:     *allocator.Allocator;
    held:  vector.Vector[*Inline];
    heads: Heads;
}

# why a block was refused
# ---
# alloc:    the allocator refused storage
# parsed:   masc refused the text, with its first diagnostic's wording
# head:     the selection the block states was not read
# returns:  the block may return from a function that is not naked, which
#           would skip the epilogue that restores the caller's frame
# operands: the block binds more operands than one block may
# class:    the operand at this position binds a value the selection holds in
#           another class than its constraint's
# symbolic: the immediate at this position binds an address, which the machine
#           form carries no relocation kind for yet
pub tag Error: u8 {
    alloc:  allocator.Error;
    parsed: str;
    head:   head.Error;
    returns;
    operands;
    class:    u32;
    symbolic: u32;
}

pub fun init(a: *allocator.Allocator) Inlines {
    ret Inlines{a: a, held: vector.init[*Inline](a), heads: head.init(a)};
}

fun inline_dnit(a: *allocator.Allocator, x: *Inline) {
    inline.dnit(?x.block);
    if (x.operands.size > 0) { allocator.deallocate[inline.Operand](a, x.operands.data, x.operands.size); }
    if (x.reads.size > 0)    { allocator.deallocate[rf.Id](a, x.reads.data, x.reads.size); }
    if (x.writes.size > 0)   { allocator.deallocate[rf.Id](a, x.writes.data, x.writes.size); }
    allocator.deallocate[Inline](a, x, 1);
}

# give back every block held
pub fun dnit(x: *Inlines) {
    var i: usize = 0;
    for (i < x.held.len) {
        inline_dnit(x.a, x.held.data[i]);
        i = i + 1;
    }
    vector.dnit[*Inline](?x.held);
    head.dnit(?x.heads);
}

# the rows of `set` of the file `fp` is over, as register identities
fun listed(a: *allocator.Allocator, file: *rf.File, words: *u64, n: usize) res[Slice[rf.Id], allocator.Error] {
    var count: usize = 0;
    var r:     u32   = 0;
    for (r < file.register_count) {
        if (r::usize / 64 < n && ((words[r / 64] >> (r % 64)::u64) & 1) != 0) { count = count + 1; }
        r = r + 1;
    }
    if (count == 0) { ret res[Slice[rf.Id], allocator.Error].ok{Slice[rf.Id]{data: nil, size: 0}}; }
    val res_allocate: res[*rf.Id, allocator.Error] = allocator.allocate[rf.Id](a, count);
    if (sel res_allocate.err) { ret res[Slice[rf.Id], allocator.Error].err{res_allocate.err}; }
    var at: usize = 0;
    r = 0;
    for (r < file.register_count) {
        if (r::usize / 64 < n && ((words[r / 64] >> (r % 64)::u64) & 1) != 0) {
            res_allocate.ok[at] = rf.id_of(?file.registers[r]);
            at                  = at + 1;
        }
        r = r + 1;
    }
    ret res[Slice[rf.Id], allocator.Error].ok{Slice[rf.Id]{data: res_allocate.ok, size: count}};
}

# every register the view admits but the stack pointer, the frame pointer
# `fp` and a zero register, which a block whose footprint masc leaves
# undecided is taken to write
fun everything(a: *allocator.Allocator, ctx: *state.Context, file: *rf.File, fp: rf.Id) res[Slice[rf.Id], allocator.Error] {
    var count: usize = 0;
    var r:     u32   = 0;
    for (r < file.register_count) {
        if (clobbered(ctx, ?file.registers[r], fp)) { count = count + 1; }
        r = r + 1;
    }
    if (count == 0) { ret res[Slice[rf.Id], allocator.Error].ok{Slice[rf.Id]{data: nil, size: 0}}; }
    val res_allocate: res[*rf.Id, allocator.Error] = allocator.allocate[rf.Id](a, count);
    if (sel res_allocate.err) { ret res[Slice[rf.Id], allocator.Error].err{res_allocate.err}; }
    var at: usize = 0;
    r = 0;
    for (r < file.register_count) {
        if (clobbered(ctx, ?file.registers[r], fp)) {
            res_allocate.ok[at] = rf.id_of(?file.registers[r]);
            at                  = at + 1;
        }
        r = r + 1;
    }
    ret res[Slice[rf.Id], allocator.Error].ok{Slice[rf.Id]{data: res_allocate.ok, size: count}};
}

fun clobbered(ctx: *state.Context, reg: *rf.Register, fp: rf.Id) bool {
    if ((reg.flags & (rf.STACK | rf.ZERO)) != 0) { ret false; }
    if (rf.id_of(reg) == fp)                     { ret false; }
    val err_held: err[rf.Absent] = rf.admitted(ctx.view, rf.id_of(reg));
    ret sel err_held.ok;
}

# the operands masc reads a block with, each name copied with a nul after it
# into `names`, which the caller gives back once masc has copied them
fun operands_of(a: *allocator.Allocator, given: Slice[ia.Operand], names: *Slice[u8]) res[Slice[inline.Operand], allocator.Error] {
    var total: usize = 0;
    var k:     usize = 0;
    for (k < given.size) {
        total = total + given.data[k].name.len + 1;
        k     = k + 1;
    }
    @names = Slice[u8]{data: nil, size: 0};
    if (given.size == 0) { ret res[Slice[inline.Operand], allocator.Error].ok{Slice[inline.Operand]{data: nil, size: 0}}; }
    val res_bytes: res[*u8, allocator.Error] = allocator.allocate[u8](a, total);
    if (sel res_bytes.err) { ret res[Slice[inline.Operand], allocator.Error].err{res_bytes.err}; }
    val res_rows: res[*inline.Operand, allocator.Error] = allocator.allocate[inline.Operand](a, given.size);
    if (sel res_rows.err) {
        allocator.deallocate[u8](a, res_bytes.ok, total);
        ret res[Slice[inline.Operand], allocator.Error].err{res_rows.err};
    }
    var at: usize = 0;
    k = 0;
    for (k < given.size) {
        val name: View  = given.data[k].name;
        var i:    usize = 0;
        for (i < name.len) {
            res_bytes.ok[at + i] = name.data[i];
            i                    = i + 1;
        }
        res_bytes.ok[at + name.len] = 0;
        res_rows.ok[k]              = inline.Operand{name: ?res_bytes.ok[at], constraint: given.data[k].constraint, role: given.data[k].role};
        at                          = at + name.len + 1;
        k                           = k + 1;
    }
    @names = Slice[u8]{data: res_bytes.ok, size: total};
    ret res[Slice[inline.Operand], allocator.Error].ok{Slice[inline.Operand]{data: res_rows.ok, size: given.size}};
}

# what masc answers of a parsed block's footprint, written into `x`, a return
# refused unless the block's function is `naked`, which has no epilogue
fun footprinted(a: *allocator.Allocator, ctx: *state.Context, file: *rf.File, pointer: rf.Id, naked: bool, x: *Inline) err[Error] {
    val res_made: res[footprint.Footprint, allocator.Error] = footprint.init(a, file);
    if (sel res_made.err) { ret err[Error].err{Error.alloc{res_made.err}}; }
    var fp: footprint.Footprint = res_made.ok;
    fin { footprint.dnit(?fp); }
    val res_effects: res[query.Answer[*footprint.Footprint], allocator.Error] = inline.effects(?x.block, ?fp);
    if (sel res_effects.err) { ret err[Error].err{Error.alloc{res_effects.err}}; }
    val answer: query.Answer[*footprint.Footprint] = res_effects.ok;
    if (sel answer.undecided) {
        val res_all: res[Slice[rf.Id], allocator.Error] = everything(a, ctx, file, pointer);
        if (sel res_all.err) { ret err[Error].err{Error.alloc{res_all.err}}; }
        x.writes = res_all.ok;
        ret err[Error].ok{};
    }
    val found: *footprint.Footprint = answer.decided;
    val c:     effect.Control       = found.control;
    # control that leaves by a jump out of the block or a fault never comes back, so it reads nothing the function
    # holds and every pass sees the block come back as its calls and traps do. a return skips the epilogue of a
    # function that has one
    if (!naked && (c.transfer == effect.RETURN || effect.makes(found.transfers, effect.RETURN))) { ret err[Error].err{Error.returns{}}; }
    x.transfer = effect.NONE;
    if (effect.makes(found.transfers, effect.TRAP)) { x.transfer = effect.TRAP; }
    if (effect.makes(found.transfers, effect.CALL)) { x.transfer = effect.CALL; }
    x.stack = found.stack;
    # every register the block writes holds no value of the function's after it, so a read masc states for a write
    # that may keep the old value asks for none the function holds, and only a register the block reads and never
    # writes stays a read
    var w: usize = 0;
    for (w < found.written.len) {
        found.written.data[w] = found.written.data[w] | found.clobbers.data[w];
        if (w < found.reads.len) { found.reads.data[w] = found.reads.data[w] & ~found.written.data[w]; }
        w = w + 1;
    }
    val res_reads: res[Slice[rf.Id], allocator.Error] = listed(a, file, found.reads.data, found.reads.len);
    if (sel res_reads.err) { ret err[Error].err{Error.alloc{res_reads.err}}; }
    x.reads = res_reads.ok;
    val res_writes: res[Slice[rf.Id], allocator.Error] = listed(a, file, found.written.data, found.written.len);
    if (sel res_writes.err) { ret err[Error].err{Error.alloc{res_writes.err}}; }
    x.writes = res_writes.ok;
    ret err[Error].ok{};
}

# the context block `b` of a function of `t` is read under: `ctx` with what the
# selection it states adds, `ctx` itself where it states none
fun context_of(x: *Inlines, b: *ia.Assembly, t: *Target, ctx: *state.Context) res[*state.Context, Error] {
    if (b.selection.len == 0) { ret res[*state.Context, Error].ok{ctx}; }
    val res_read: res[*head.Head, head.Error] = head.of(?x.heads, t, ctx, b.selection);
    if (sel res_read.err) { ret res[*state.Context, Error].err{Error.head{res_read.err}}; }
    ret res[*state.Context, Error].ok{res_read.ok.context};
}

# a block masc reads in `s` under `ctx`, held by `x`
# ---
# x:     where the block is held
# b:     the ir block, its text and operands
# s:     the target's instruction set
# t:     the target, whose set the selection the block states is read in
# ctx:   the context its function is encoded under
# f:     the object format the block is encoded into, whose dialect the text
#        is read in, nil for a system that states none
# fp:    the convention's frame pointer, rf.NONE for a row with none
# naked: its function states `naked`, so the block may return from it
# ret:   the block with what its footprint answers, or why masc refused it
pub fun parse(x: *Inlines, b: *ia.Assembly, s: *mset.Set, t: *Target, ctx: *state.Context, f: *Format, fp: rf.Id, naked: bool) res[*Inline, Error] {
    if (s.codec == nil || s.codec.registers == nil) { ret res[*Inline, Error].err{Error.parsed{inline.UNAVAILABLE}}; }
    if (b.operands.size > ia.MOST_OPERANDS::usize)  { ret res[*Inline, Error].err{Error.operands{}}; }
    val res_under: res[*state.Context, Error] = context_of(x, b, t, ctx);
    if (sel res_under.err) { ret res[*Inline, Error].err{res_under.err}; }
    val a:       *allocator.Allocator                        = x.a;
    var names:   Slice[u8]                                   = Slice[u8]{data: nil, size: 0};
    val res_ops: res[Slice[inline.Operand], allocator.Error] = operands_of(a, b.operands, ?names);
    if (sel res_ops.err) { ret res[*Inline, Error].err{Error.alloc{res_ops.err}}; }
    val res_read: res[inline.Block, inline.Diagnostics] = inline.parse(a, b.text, diagnostic.START, s, res_under.ok, f, inline.Operands{at: res_ops.ok.data, len: res_ops.ok.size::u32});
    var k:        usize                                 = 0;
    for (k < res_ops.ok.size) {
        res_ops.ok.data[k].name = nil;
        k                       = k + 1;
    }
    if (names.size > 0) { allocator.deallocate[u8](a, names.data, names.size); }
    if (sel res_read.err) {
        var why: str = inline.UNAVAILABLE;
        if (res_read.err.len > 0) { why = res_read.err.at[0].message; }
        inline.diagnostics_dnit(a, res_read.err);
        if (res_ops.ok.size > 0) { allocator.deallocate[inline.Operand](a, res_ops.ok.data, res_ops.ok.size); }
        ret res[*Inline, Error].err{Error.parsed{why}};
    }
    val res_held: res[*Inline, allocator.Error] = allocator.allocate[Inline](a, 1);
    if (sel res_held.err) {
        var blk: inline.Block = res_read.ok;
        inline.dnit(?blk);
        if (res_ops.ok.size > 0) { allocator.deallocate[inline.Operand](a, res_ops.ok.data, res_ops.ok.size); }
        ret res[*Inline, Error].err{Error.alloc{res_held.err}};
    }
    val one:     *Inline = res_held.ok;
    var publics: u32     = 0;
    var secrets: u32     = 0;
    k = 0;
    for (k < b.operands.size) {
        if (sel b.operands.data[k].points.public) { publics = publics | (1::u32 << k::u32); }
        if (sel b.operands.data[k].points.secret) { secrets = secrets | (1::u32 << k::u32); }
        k = k + 1;
    }
    @one = Inline{block: res_read.ok, operands: res_ops.ok, reads: Slice[rf.Id]{data: nil, size: 0}, writes: Slice[rf.Id]{data: nil, size: 0}, stack: effect.Stack.none{}, transfer: effect.NONE, context: res_under.ok, publics: publics, secrets: secrets};
    val res_kept: res[usize, allocator.Error] = vector.push[*Inline](?x.held, one);
    if (sel res_kept.err) {
        inline_dnit(a, one);
        ret res[*Inline, Error].err{Error.alloc{res_kept.err}};
    }
    val err_answered: err[Error] = footprinted(a, res_under.ok, s.codec.registers, fp, naked, one);
    if (sel err_answered.err) { ret res[*Inline, Error].err{err_answered.err}; }
    ret res[*Inline, Error].ok{one};
}
