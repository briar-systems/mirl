# the mirl program: the command line over the library

use A: std.allocator;
use std.allocator.page;
use fs: std.filesystem;
use io: std.io.writer;
use std.runtime;
use std.types.error.err;
use std.types.size.usize;

use mirl.cli.cmd;
use mirl.cli.diagnostic;
use mirl.cli.exit;

# the program entry, over the process arguments
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var backing: A.Allocator;
    var out:     io.Writer    = fs.writer(fs.STDOUT);
    var diag:    io.Writer    = fs.writer(fs.STDERR);
    val made:    err[A.Error] = page.make(?backing);
    if (sel made.err) {
        diagnostic.headline(?diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    ret cmd.dispatch(?backing, argc::usize, argv, ?out, ?diag);
}
