# the generator of doc/ir/opcodes.md: the opcode reference, written to stdout

use fs: std.filesystem;
use io: std.io.writer;
use std.runtime;
use std.types.error.err;

use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.failure.text;
use mirl.failure.text.Out;
use mirl.ir.reference;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var out:         io.Writer          = fs.writer(fs.STDOUT);
    var diag:        io.Writer          = fs.writer(fs.STDERR);
    val err_written: err[io.WriteError] = reference.write(?out);
    if (sel err_written.err) {
        var o: Out = text.tool(nil, ?diag, nil);
        text.headline_because(?o, "cannot write the opcode reference to standard output", diagnostic.write_cause(err_written.err));
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}
