# the compilation of a module for a target, the entry mach calls
#
# the pipeline is the one the target's declarations choose, never its name:
# the pass schedule, then the back end that serves those declarations. a
# register machine is a target whose values live in registers to allocate,
# whose control is unstructured, whose addresses are physical and which
# evaluates in registers, and its back end is mirl.machine.compile. the
# build's one machine is opened here, so the schedule and the back end read
# the same selection. `write` lays the object out in the one object format the
# target's system states, through mink.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use io: std.io.writer;

use mink.catalog.format.Format;
use systems: mink.catalog.os;
use mink.fail.Fail;
use mink.format.contract;
use mink.format.registry;
use mink.model.object;
use mink.sink;
use mink.sink.Sink;

use mirl.ir.module.Module;
use mcompile: mirl.machine.compile;
use mirl.pass;
use mirl.target.Target;
use mirl.target.machine;
use mirl.target.machine.Machine;
use mirl.target.record;

# how a module is compiled
# ---
# level:   the optimisation level
# checked: verify the module after every pass and every function after every
#          stage, as every build that tests does
# added:   extension names the build adds to the target's baseline
# machine: where the machine form text of the laid out functions is written, none for none
# listing: where masc's listing of the object is written, none for none
pub rec Options {
    level:   pass.Level;
    checked: bool;
    added:   Slice[str];
    machine: opt[*io.Writer];
    listing: opt[*io.Writer];
}

# why a module was not compiled
# ---
# unserved: no back end serves the target's declarations, and nothing ran
# machine:  the target's machine was not made
# schedule: the pass schedule failed
# compile:  the back end refused the scheduled module
pub tag Error: u8 {
    unserved;
    machine:  machine.Error;
    schedule: pass.Error;
    compile:  mcompile.Error;
}

# whether a target declares a register machine
pub fun register_machine(t: *Target) bool {
    ret sel t.caps.registers.allocated && sel t.caps.control.free && sel t.caps.addressing.physical && sel t.caps.evaluation.register;
}

# compile a module for a target
# ---
# a:   the allocator every stage and the object take
# m:   the module, which the pass schedule rewrites
# t:   the target the module is built for
# o:   the level, whether it is checked, and the texts it writes besides the object
# ret: mink's object in memory, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, t: *Target, o: Options) res[object.Object, Error] {
    if (!register_machine(t)) { ret res[object.Object, Error].err{Error.unserved{}}; }
    var mc:   Machine;
    val held: res[opt[*Machine], machine.Error] = machine.build(?mc, a, t, o.added);
    if (sel held.err) { ret res[object.Object, Error].err{Error.machine{held.err}}; }
    fin { machine.release(held.ok); }
    if (sel held.ok.none) { ret res[object.Object, Error].err{Error.compile{mcompile.Error.uncarried{}}}; }

    val ran: err[pass.Error] = pass.run(m, t, held.ok, pass.Options{level: o.level, checked: o.checked});
    if (sel ran.err) { ret res[object.Object, Error].err{Error.schedule{ran.err}}; }
    val made: res[object.Object, mcompile.Error] = mcompile.compile(a, m, held.ok.some, t, mcompile.Options{checked: o.checked, machine: o.machine, listing: o.listing});
    if (sel made.err) { ret res[object.Object, Error].err{Error.compile{made.err}}; }
    ret res[object.Object, Error].ok{made.ok};
}

# why an object was not written
# ---
# system:  the target's system names no row of mink's catalog
# formats: the system states no object format, or several, and so names none
# format:  mink does not lay out the system's format, or refused the object
# write:   the bytes were not written
pub tag Unwritten: u8 {
    system:  record.Error;
    formats: usize;
    format:  Fail;
    write:   io.WriteError;
}

# write an object in the object format of the target's system
# ---
# a:   the allocator the format's model and its bytes take
# o:   the object, as compile made it
# t:   the target it was made for
# w:   where the bytes are written
# ret: ok, or why nothing or only part was written
pub fun write(a: *allocator.Allocator, o: *object.Object, t: *Target, w: *io.Writer) err[Unwritten] {
    val system: res[*systems.Os, record.Error] = record.system(t);
    if (sel system.err)              { ret err[Unwritten].err{Unwritten.system{system.err}}; }
    if (system.ok.format_count != 1) { ret err[Unwritten].err{Unwritten.formats{system.ok.format_count}}; }
    val format: *Format = system.ok.formats[0];

    val formats: res[registry.Registry, Fail] = registry.builtin();
    if (sel formats.err) { ret err[Unwritten].err{Unwritten.format{formats.err}}; }
    var r:     registry.Registry                 = formats.ok;
    val found: res[*contract.Registration, Fail] = registry.by_format(?r, format);
    if (sel found.err) { ret err[Unwritten].err{Unwritten.format{found.err}}; }
    val built: res[contract.Model, Fail] = contract.from_neutral(found.ok, a, o);
    if (sel built.err) { ret err[Unwritten].err{Unwritten.format{built.err}}; }
    var model: contract.Model = built.ok;
    fin { contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret err[Unwritten].err{Unwritten.format{laid.err}}; }
    var bytes: Sink = laid.ok;
    fin { sink.release(?bytes); }
    val wrote: err[io.WriteError] = io.write_all(w, sink.data(?bytes), sink.len(?bytes));
    if (sel wrote.err) { ret err[Unwritten].err{Unwritten.write{wrote.err}}; }
    ret err[Unwritten].ok{};
}
