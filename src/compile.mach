# the compilation of a module for a target, the entry mach calls
#
# the pipeline is the one the target's family states, chosen by the target's
# declarations, never its name: compile reads the family registry and takes
# the one family that admits the target, refusing a target none or several
# admit before anything runs. the family opens the build, the neutral prefix
# and the family's rows run over it, and the family's back end compiles the
# scheduled module, so the schedule and the back end read the one build.
# `write` lays the object out in the one object format the target's system
# states, through mink.

use std.types.error.err;
use std.types.result.res;

use std.allocator;
use io: std.io.writer;

use mink.catalog.format.Format;
use mink.fail.Fail;
use mink.format.contract;
use mink.format.registry;
use mink.model.object;
use mink.sink;
use mink.sink.Sink;

use mirl.ir.module.Module;
use mirl.pass;
use mirl.target.Target;
use mirl.target.build.Build;
use mirl.target.families;
use mirl.target.family;
use mirl.target.family.Family;
use mirl.target.record;

fwd family.Options;
fwd family.Error;
fwd family.Back;
fwd family.Unserved;

# compile a module for a target
# ---
# a:   the allocator every stage and the object take
# m:   the module, which the pass schedule rewrites
# t:   the target the module is built for
# o:   the level, whether it is checked, and the texts it writes besides the object
# ret: mink's object in memory, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, t: *Target, o: Options) res[object.Object, Error] {
    val served: res[*Family, Unserved] = families.served(t);
    if (sel served.err) { ret res[object.Object, Error].err{Error.unserved{served.err}}; }
    val f:      *Family    = served.ok;
    var b:      Build;
    val opened: err[Error] = f.open(?b, a, t, o.added);
    if (sel opened.err) { ret res[object.Object, Error].err{opened.err}; }
    fin { f.close(?b); }

    val ran: err[pass.Error] = pass.drive_family(m, t, ?b, f.legal, pass.Options{level: o.level, checked: o.checked});
    if (sel ran.err) { ret res[object.Object, Error].err{Error.schedule{ran.err}}; }
    ret f.back(a, m, ?b, t, o);
}

# why an object was not written
# ---
# system: the target's system names no row of mink's catalog, or states no one object format
# format: mink does not lay out the system's format, or refused the object
# write:  the bytes were not written
pub tag Unwritten: u8 {
    system: record.Error;
    format: Fail;
    write:  io.WriteError;
}

# write an object in the object format of the target's system
# ---
# a:   the allocator the format's model and its bytes take
# o:   the object, as compile made it
# t:   the target it was made for
# w:   where the bytes are written
# ret: ok, or why nothing or only part was written
pub fun write(a: *allocator.Allocator, o: *object.Object, t: *Target, w: *io.Writer) err[Unwritten] {
    val format: res[*Format, record.Error] = record.format(t);
    if (sel format.err) { ret err[Unwritten].err{Unwritten.system{format.err}}; }

    val formats: res[registry.Registry, Fail] = registry.builtin();
    if (sel formats.err) { ret err[Unwritten].err{Unwritten.format{formats.err}}; }
    var r:     registry.Registry                 = formats.ok;
    val found: res[*contract.Registration, Fail] = registry.by_format(?r, format.ok);
    if (sel found.err) { ret err[Unwritten].err{Unwritten.format{found.err}}; }
    val built: res[contract.Model, Fail] = contract.from_neutral(found.ok, a, o);
    if (sel built.err) { ret err[Unwritten].err{Unwritten.format{built.err}}; }
    var model: contract.Model = built.ok;
    fin { contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret err[Unwritten].err{Unwritten.format{laid.err}}; }
    var bytes: Sink = laid.ok;
    fin { sink.release(?bytes); }
    val wrote: err[io.WriteError] = io.write_all(w, sink.data(?bytes), sink.len(?bytes));
    if (sel wrote.err) { ret err[Unwritten].err{Unwritten.write{wrote.err}}; }
    ret err[Unwritten].ok{};
}
