# the command line over the library: the command table and its dispatch, the
# exit codes the program returns and its own diagnostics

use mirl.cli.cmd;
use mirl.cli.diagnostic;
use mirl.cli.exit;

fwd cmd.COMMANDS_N;
fwd cmd.COMMANDS;
fwd cmd.commands;
fwd cmd.dispatch;

fwd exit.OK;
fwd exit.REFUSED;
fwd exit.INTERNAL;

fwd diagnostic.headline;
