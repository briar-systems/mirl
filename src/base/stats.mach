# per-stage timings and counts of one compilation
#
# a compilation handed a sink fills it as it runs: the nanoseconds each stage
# took on std's monotonic clock, summed over every run of the stage, and what
# mirl counts on the way. every time and count is a u64, as masc's stats are, so
# masc's layout and encoding times read beside these on the one clock. one
# handed none reads no clock and counts nothing, so every helper here returns
# at once on an absent sink. mirl owns the clock reads, so a caller never
# times mirl's internals itself. a refused clock read is kept, the first one
# alone, and the stage it would have timed adds nothing.
#
# the stages, in the order a compilation runs them
# ---
# lower:  the family's lowering rows of the pass schedule
# verify: every ir verifier run, the one before the schedule among them
# passes: the neutral rows of the pass schedule
# select: instruction selection and the constant-time check of selected code
# alloc:  register allocation
# frame:  the frame, the allocation it redoes when the frame pointer must be
#         withheld, the lowering of copies, the configuration states and the
#         expansion of loops
# emit:   block layout and variable ranges, masc's encoding and layout, the
#         constant-time walk of the encoded code and the texts asked for. a
#         back end that selects and writes in one walk, as wasm's and spir-v's,
#         counts here whole
#
# a checked compilation's machine verifier run counts in the stage of the step
# it follows.

use std.types.bool.bool;
use std.types.option.opt;

use std.chrono.duration.Duration;
use std.chrono.time;
use std.chrono.time.Instant;

use measured: masc.build.stats;
use io_error: std.io.error;

# a stage of a compilation, as the header lists them
pub tag Stage: u8 {
    lower;
    verify;
    passes;
    select;
    alloc;
    frame;
    emit;
}

# the stats of one compilation
# ---
# lower:        nanoseconds in the family's lowering rows
# verify:       nanoseconds in every ir verifier run
# passes:       nanoseconds in the neutral rows of the schedule
# select:       nanoseconds in selection
# alloc:        nanoseconds in register allocation
# frame:        nanoseconds in the frame and the steps that finish framed code
# emit:         nanoseconds in layout and emission
# verified:     how many times the ir verifier ran
# functions:    the functions with a body after the schedule
# instructions: the ir instructions those functions hold after the schedule
# selected:     the machine instructions selection made, over every function
# allocated:    the machine instructions after allocation, over every function
# rounds:       the rounds of register allocation, over every function
# masc:         masc's own measures of the object it builds, as masc.build.stats
#               states them: nanoseconds in layout and in encoding, on the same
#               clock, and the machine instructions the last encoding wrote
# clock:        the first refusal of the clock, none when every read was given
pub rec Stats {
    lower:        u64;
    verify:       u64;
    passes:       u64;
    select:       u64;
    alloc:        u64;
    frame:        u64;
    emit:         u64;
    verified:     u64;
    functions:    u64;
    instructions: u64;
    selected:     u64;
    allocated:    u64;
    rounds:       u64;
    masc:         measured.Stats;
    clock:        opt[io_error.Error];
}

# stats with nothing timed or counted yet
pub fun init() Stats {
    ret Stats{
        lower:        0,
        verify:       0,
        passes:       0,
        select:       0,
        alloc:        0,
        frame:        0,
        emit:         0,
        verified:     0,
        functions:    0,
        instructions: 0,
        selected:     0,
        allocated:    0,
        rounds:       0,
        masc:         measured.Stats{layout: 0, encode: 0, instructions: 0},
        clock:        opt[io_error.Error].none{},
    };
}

# the nanoseconds a stage took so far
pub fun time_of(s: *Stats, k: Stage) u64 {
    if (sel k.lower)  { ret s.lower; }
    or (sel k.verify) { ret s.verify; }
    or (sel k.passes) { ret s.passes; }
    or (sel k.select) { ret s.select; }
    or (sel k.alloc)  { ret s.alloc; }
    or (sel k.frame)  { ret s.frame; }
    or (sel k.emit)   { ret s.emit; }
}

fun add(s: *Stats, k: Stage, d: u64) {
    if (sel k.lower)  { s.lower = s.lower + d; }
    or (sel k.verify) { s.verify = s.verify + d; }
    or (sel k.passes) { s.passes = s.passes + d; }
    or (sel k.select) { s.select = s.select + d; }
    or (sel k.alloc)  { s.alloc = s.alloc + d; }
    or (sel k.frame)  { s.frame = s.frame + d; }
    or (sel k.emit)   { s.emit = s.emit + d; }
}

fun refused(s: *Stats, e: io_error.Error) {
    val first: bool = sel s.clock.none;
    if (first) { s.clock = opt[io_error.Error].some{e}; }
}

# the start of a timed stage
# ---
# s:   the sink, none for none
# ret: the instant it starts, none when there is no sink or the clock refused
pub fun start(s: opt[*Stats]) opt[Instant] {
    if (sel s.none) { ret opt[Instant].none{}; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) {
        refused(s.some, now.err);
        ret opt[Instant].none{};
    }
    ret opt[Instant].some{now.ok};
}

# the end of a timed stage, which adds the time since its start to the stage
# ---
# s:    the sink, none for none
# k:    the stage
# from: what `start` gave
pub fun stop(s: opt[*Stats], k: Stage, from: opt[Instant]) {
    if (sel s.none)    { ret; }
    if (sel from.none) { ret; }
    val now: time.InstantClock = time.instant();
    if (sel now.err) {
        refused(s.some, now.err);
        ret;
    }
    val d: Duration = time.instant_sub(now.ok, from.some);
    if (d > 0) { add(s.some, k, d::u64); }
}
