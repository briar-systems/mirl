# per-stage timings and counts of one compilation
#
# a compilation handed a sink fills it as it runs: the nanoseconds each stage
# took on std's monotonic clock, summed over every run of the stage, and what
# mirl counts on the way. every time and count is a u64, as masc's stats are, so
# masc's layout and encoding times read beside these on the one clock. one
# handed none reads no clock and counts nothing, so every helper here returns
# at once on an absent sink. mirl owns the clock reads, so a caller never
# times mirl's internals itself. a refused clock read is kept, the first one
# alone, and the stage it would have timed adds nothing.
#
# the stages, in the order a compilation runs them
# ---
# lower:  the family's lowering rows of the pass schedule
# verify: every ir verifier run of a checked compilation, the one before the
#         schedule among them
# passes: the neutral rows of the pass schedule
# select: instruction selection and the constant-time check of selected code
# alloc:  register allocation
# frame:  the frame, the allocation it redoes when the frame pointer must be
#         withheld, the lowering of copies, the configuration states, the
#         expansion of loops and the writing of moves of zero in the zeroing row
# emit:   block layout and variable ranges, masc's encoding and layout, the
#         constant-time walk of the encoded code and the texts asked for. a
#         back end that selects and writes in one walk, as wasm's and spir-v's,
#         counts here whole
#
# a checked compilation's machine verifier run counts in the stage of the step
# it follows.
#
# a sink may also carry a progress, whose hooks the compilation calls as it
# runs, so a reader can follow it live, as a command's stage log and live line
# do: when a stage opens, when an item of one starts and finishes, and when it
# closes. a stage that works through items one by one, as the stages of a
# register machine work through the functions, names each item; one that works
# whole names none.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use std.chrono.duration.Duration;
use std.chrono.time;
use std.chrono.time.Instant;

use measured: masc.build.stats;
use io_error: std.io.error;

# a stage of a compilation, as the header lists them
pub tag Stage: u8 {
    lower;
    verify;
    passes;
    select;
    alloc;
    frame;
    emit;
}

# how many stages there are
pub val STAGE_COUNT: usize = 7;

# a stage's place in the header's order, from 0, as a reader indexes a row per stage
pub fun index(k: Stage) usize {
    if (sel k.lower)  { ret 0; }
    or (sel k.verify) { ret 1; }
    or (sel k.passes) { ret 2; }
    or (sel k.select) { ret 3; }
    or (sel k.alloc)  { ret 4; }
    or (sel k.frame)  { ret 5; }
    ret 6;
}

# the hooks a compilation calls as it runs, each on the thread the compilation
# runs on and in the order its events happen. a stage that refuses is never
# closed, and stages that close together close in the header's order
# ---
# ctx:      what each hook is handed back
# opened:   a stage opens, with how many items it is known to finish one by
#           one, 0 for a stage that works whole
# grew:     an open stage learns of more items it will finish, by how many, as
#           a register machine learns which probe routines its frames call
# begun:    an item starts its part of an open stage, named by its symbol
# finished: that item's part is done, with the nanoseconds it took in the stage
# closed:   a stage closed, its time and counts in the stats final
pub rec Progress {
    ctx:      ptr;
    opened:   fun(ptr, Stage, u32);
    grew:     fun(ptr, Stage, u32);
    begun:    fun(ptr, Stage, View);
    finished: fun(ptr, Stage, View, u64);
    closed:   fun(ptr, Stage);
}

# the stats of one compilation
# ---
# lower:        nanoseconds in the family's lowering rows
# verify:       nanoseconds in every ir verifier run
# passes:       nanoseconds in the neutral rows of the schedule
# select:       nanoseconds in selection
# alloc:        nanoseconds in register allocation
# frame:        nanoseconds in the frame and the steps that finish framed code
# emit:         nanoseconds in layout and emission
# verified:     how many times the ir verifier ran
# functions:    the functions with a body after the schedule
# instructions: the ir instructions those functions hold after the schedule
# selected:     the machine instructions selection made, over every function
# allocated:    the machine instructions after allocation, over every function
# rounds:       the rounds of register allocation, over every function
# masc:         masc's own measures of the object it builds, as masc.build.stats
#               states them: nanoseconds in layout and in encoding, on the same
#               clock
# clock:        the first refusal of the clock, none when every read was given
# progress:     the hooks the compilation calls as it runs, none for none
pub rec Stats {
    lower:        u64;
    verify:       u64;
    passes:       u64;
    select:       u64;
    alloc:        u64;
    frame:        u64;
    emit:         u64;
    verified:     u64;
    functions:    u64;
    instructions: u64;
    selected:     u64;
    allocated:    u64;
    rounds:       u64;
    masc:         measured.Stats;
    clock:        opt[io_error.Error];
    progress:     opt[*Progress];
}

# stats with nothing timed or counted yet
pub fun make() Stats {
    ret Stats{
        lower:        0,
        verify:       0,
        passes:       0,
        select:       0,
        alloc:        0,
        frame:        0,
        emit:         0,
        verified:     0,
        functions:    0,
        instructions: 0,
        selected:     0,
        allocated:    0,
        rounds:       0,
        masc:         measured.Stats{layout: 0, encode: 0},
        clock:        opt[io_error.Error].none{},
        progress:     opt[*Progress].none{},
    };
}

fun add(s: *Stats, k: Stage, d: u64) {
    if (sel k.lower)  { s.lower = s.lower + d; }
    or (sel k.verify) { s.verify = s.verify + d; }
    or (sel k.passes) { s.passes = s.passes + d; }
    or (sel k.select) { s.select = s.select + d; }
    or (sel k.alloc)  { s.alloc = s.alloc + d; }
    or (sel k.frame)  { s.frame = s.frame + d; }
    or (sel k.emit)   { s.emit = s.emit + d; }
}

fun refused(s: *Stats, e: io_error.Error) {
    val first: bool = sel s.clock.none;
    if (first) { s.clock = opt[io_error.Error].some{e}; }
}

# the start of a timed stage
# ---
# s:   the sink, none for none
# ret: the instant it starts, none when there is no sink or the clock refused
pub fun start(s: opt[*Stats]) opt[Instant] {
    if (sel s.none) { ret opt[Instant].none{}; }
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) {
        refused(s.some, res_now.err);
        ret opt[Instant].none{};
    }
    ret opt[Instant].some{res_now.ok};
}

# the end of a timed stage, which adds the time since its start to the stage
# ---
# s:    the sink, none for none
# k:    the stage
# from: what `start` gave
pub fun stop(s: opt[*Stats], k: Stage, from: opt[Instant]) {
    if (sel s.none)    { ret; }
    if (sel from.none) { ret; }
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) {
        refused(s.some, res_now.err);
        ret;
    }
    val d: Duration = time.instant_sub(res_now.ok, from.some);
    if (d > 0) { add(s.some, k, d::u64); }
}

# the end of a timed stage that starts the next, as one clock read: adds the
# time since its start to the stage and gives the instant the next starts at
# ---
# s:    the sink, none for none
# k:    the stage
# from: what `start` or the last lap gave
# ret:  the instant the next stage starts, none when there is no sink or the
#       clock refused
pub fun lap(s: opt[*Stats], k: Stage, from: opt[Instant]) opt[Instant] {
    if (sel s.none) { ret opt[Instant].none{}; }
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) {
        refused(s.some, res_now.err);
        ret opt[Instant].none{};
    }
    if (sel from.some) {
        val d: Duration = time.instant_sub(res_now.ok, from.some);
        if (d > 0) { add(s.some, k, d::u64); }
    }
    ret opt[Instant].some{res_now.ok};
}

# the end of a timed stage that starts the next, as `lap`, adding the time it
# added to the stage to `took` too, as an item counts its own part of a stage
pub fun lap_took(s: opt[*Stats], k: Stage, from: opt[Instant], took: *u64) opt[Instant] {
    if (sel s.none) { ret opt[Instant].none{}; }
    val res_now: time.InstantClock = time.instant();
    if (sel res_now.err) {
        refused(s.some, res_now.err);
        ret opt[Instant].none{};
    }
    if (sel from.some) {
        val d: Duration = time.instant_sub(res_now.ok, from.some);
        if (d > 0) {
            add(s.some, k, d::u64);
            @took = @took + d::u64;
        }
    }
    ret opt[Instant].some{res_now.ok};
}

# the progress a sink carries, nil when there is no sink or it carries none
fun progress(s: opt[*Stats]) *Progress {
    if (sel s.none)               { ret nil; }
    if (sel s.some.progress.none) { ret nil; }
    ret s.some.progress.some;
}

# a stage opens, with how many items it is known to finish one by one, 0 for
# a stage that works whole
pub fun opened(s: opt[*Stats], k: Stage, total: u32) {
    val p: *Progress = progress(s);
    if (p == nil) { ret; }
    p.opened(p.ctx, k, total);
}

# an open stage learns of `more` items it will finish
pub fun grew(s: opt[*Stats], k: Stage, more: u32) {
    val p: *Progress = progress(s);
    if (p == nil) { ret; }
    p.grew(p.ctx, k, more);
}

# an item starts its part of an open stage
pub fun begun(s: opt[*Stats], k: Stage, name: View) {
    val p: *Progress = progress(s);
    if (p == nil) { ret; }
    p.begun(p.ctx, k, name);
}

# an item's part of an open stage is done, after `ns` nanoseconds in it
pub fun finished(s: opt[*Stats], k: Stage, name: View, ns: u64) {
    val p: *Progress = progress(s);
    if (p == nil) { ret; }
    p.finished(p.ctx, k, name, ns);
}

# a stage closed, its time and counts final
pub fun closed(s: opt[*Stats], k: Stage) {
    val p: *Progress = progress(s);
    if (p == nil) { ret; }
    p.closed(p.ctx, k);
}
