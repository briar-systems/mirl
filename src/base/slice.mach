# owned copies of slices and byte views, their comparison and hashing, and
# vectors filled with one value

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

# a copy of a slice the caller owns, with nil data when it is empty
pub fun copy[T](a: *allocator.Allocator, s: Slice[T]) res[Slice[T], allocator.Error] {
    var out: Slice[T];
    out.data = nil;
    out.size = s.size;
    if (s.size == 0) { ret res[Slice[T], allocator.Error].ok{out}; }
    val res_allocate: res[*T, allocator.Error] = allocator.allocate[T](a, s.size);
    if (sel res_allocate.err) { ret res[Slice[T], allocator.Error].err{res_allocate.err}; }
    out.data = res_allocate.ok;
    var i: usize = 0;
    for (i < s.size) {
        out.data[i] = s.data[i];
        i           = i + 1;
    }
    ret res[Slice[T], allocator.Error].ok{out};
}

# push n copies of x onto a vector, taking the room for them at once
pub fun fill[T](v: *vector.Vector[T], n: usize, x: T) err[allocator.Error] {
    val res_room: res[usize, allocator.Error] = vector.reserve[T](v, n);
    if (sel res_room.err) { ret err[allocator.Error].err{res_room.err}; }
    val room_for: Slice[T] = vector.spare[T](v);
    var i:        usize    = 0;
    for (i < n) {
        room_for.data[i] = x;
        i                = i + 1;
    }
    vector.commit[T](v, n);
    ret err[allocator.Error].ok{};
}

# make a vector hold exactly n copies of x, whatever it held before: the reset of a vector a walk reuses, where `fill`
# would keep what an earlier walk left in front of the copies
pub fun reset[T](v: *vector.Vector[T], n: usize, x: T) err[allocator.Error] {
    vector.clear[T](v);
    ret fill[T](v, n, x);
}

# give back a slice copied by `copy`
pub fun free[T](a: *allocator.Allocator, s: Slice[T]) err[allocator.Error] {
    if (s.size == 0) { ret err[allocator.Error].ok{}; }
    ret allocator.deallocate[T](a, s.data, s.size);
}

# a copy of a byte view the caller owns
pub fun copy_view(a: *allocator.Allocator, v: View) res[View, allocator.Error] {
    val res_copy: res[Slice[char], allocator.Error] = copy[char](a, Slice[char]{data: v.data, size: v.len});
    if (sel res_copy.err) { ret res[View, allocator.Error].err{res_copy.err}; }
    ret res[View, allocator.Error].ok{View{data: res_copy.ok.data, len: res_copy.ok.size}};
}

# give back a byte view copied by `copy_view`
pub fun view_free(a: *allocator.Allocator, v: View) err[allocator.Error] {
    ret free[char](a, Slice[char]{data: v.data, size: v.len});
}

# a copy of a list of byte views the caller owns, the list and every view
pub fun copy_views(a: *allocator.Allocator, s: Slice[View]) res[Slice[View], allocator.Error] {
    val res_list: res[Slice[View], allocator.Error] = copy[View](a, s);
    if (sel res_list.err) { ret res_list; }
    var i: usize = 0;
    for (i < s.size) {
        val res_one: res[View, allocator.Error] = copy_view(a, s.data[i]);
        if (sel res_one.err) {
            var k: usize = 0;
            for (k < i) {
                view_free(a, res_list.ok.data[k]);
                k = k + 1;
            }
            free[View](a, res_list.ok);
            ret res[Slice[View], allocator.Error].err{res_one.err};
        }
        res_list.ok.data[i] = res_one.ok;
        i                   = i + 1;
    }
    ret res_list;
}

# give back a list of byte views copied by `copy_views`
pub fun views_dnit(a: *allocator.Allocator, s: Slice[View]) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (i < s.size) {
        val err_release_view: err[allocator.Error] = view_free(a, s.data[i]);
        if (sel err_release_view.err) { err_failed = err_release_view; }
        i = i + 1;
    }
    val err_release: err[allocator.Error] = free[View](a, s);
    if (sel err_release.err) { err_failed = err_release; }
    ret err_failed;
}

# whether two byte views have the same bytes
pub fun same_view(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the byte order of two views: below zero when a sorts first, zero when they
# are the same and above zero when b sorts first, a prefix sorting first
pub fun order_view(a: View, b: View) i64 {
    var i: usize = 0;
    for (i < a.len && i < b.len) {
        val x: u8 = a.data[i];
        val y: u8 = b.data[i];
        if (x < y) { ret -1; }
        if (x > y) { ret 1; }
        i = i + 1;
    }
    if (a.len < b.len) { ret -1; }
    if (a.len > b.len) { ret 1; }
    ret 0;
}

# fold one word into the running fnv-1a hash h
pub fun mix(h: u64, w: u64) u64 {
    ret (h ^ w) * 0x100000001b3;
}

# fold the bytes of a view into the running fnv-1a hash h
pub fun hash_view(h: u64, v: View) u64 {
    var acc: u64   = h;
    var i:   usize = 0;
    for (i < v.len) {
        acc = mix(acc, v.data[i]::u64);
        i   = i + 1;
    }
    ret acc;
}
