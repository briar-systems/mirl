# remembering the first failure of a sequence of releases

use std.types.error.err;

use std.allocator;

# keep the first failure of a sequence
# ---
# first: the failure kept so far, ok while none has failed
# r:     the outcome of the next release
pub fun keep(first: *err[allocator.Error], r: err[allocator.Error]) {
    if (sel r.err && sel first.ok) { @first = r; }
}
