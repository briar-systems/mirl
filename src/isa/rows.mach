# the instruction sets mirl carries, one row each
#
# a row joins masc's instruction set to the selection table and the frame code
# written for it. a target reaches its row through the architecture it names,
# by an index of mink's architecture rows built once from the sets' own lists,
# so no consumer spells a set, a table or a frame code of its own and a second
# set is a row beside the first.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.sort;
use std.collections.vector;

use arches: mink.catalog.arch;

use masc.core.set.Set;
use riscv_set: masc.isa.riscv.set;

use mirl.isa.riscv;
use mirl.machine.frame.code.Code;
use mirl.machine.select.rule.Table;
use mirl.target.record;
use mirl.target.record.Target;

# one carried instruction set
# ---
# set:   masc's instruction set
# table: the selection table for it
# frame: the code of its frame moves
pub rec Row {
    set:   *Set;
    table: *Table;
    frame: *Code;
}

def Rows: [1]Row;

val ROWS: Rows = [1]Row{
    Row{set: ?riscv_set.SET, table: ?riscv.TABLE, frame: ?riscv.FRAME},
};

# an architecture row and the row of the set that serves it
rec Entry {
    arch: *arches.Arch;
    row:  *Row;
}

# the rows by the architecture rows their sets serve, sorted by the row's address
pub rec Index {
    entries: vector.Vector[Entry];
}

# why a target's row was not found
# ---
# alloc: the allocator refused the index
# arch:  the target's architecture names no row of mink's catalog
pub tag Error: u8 {
    alloc: allocator.Error;
    arch:  record.Error;
}

fun by_arch(a: *Entry, b: *Entry) i64 {
    if (a.arch:~u64 < b.arch:~u64) { ret -1; }
    if (a.arch:~u64 > b.arch:~u64) { ret 1; }
    ret 0;
}

# the index of the carried sets' architectures
pub fun index(a: *allocator.Allocator) res[Index, allocator.Error] {
    var x: Index = Index{entries: vector.init[Entry](a)};
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        var k: u32 = 0;
        for (k < ROWS[i].set.arches.len) {
            val pushed: res[usize, allocator.Error] = vector.push[Entry](?x.entries, Entry{arch: ROWS[i].set.arches.at[k], row: ?ROWS[i]});
            if (sel pushed.err) {
                vector.dnit[Entry](?x.entries);
                ret res[Index, allocator.Error].err{pushed.err};
            }
            k = k + 1;
        }
        i = i + 1;
    }
    sort.sort_by[Entry](x.entries.data, x.entries.len, by_arch);
    ret res[Index, allocator.Error].ok{x};
}

# give back the index's storage
pub fun dnit(x: *Index) err[allocator.Error] {
    ret vector.dnit[Entry](?x.entries);
}

# the row serving an architecture, none when mirl carries no set for it
pub fun of(x: *Index, arch: *arches.Arch) opt[*Row] {
    var lo: usize = 0;
    var hi: usize = x.entries.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (x.entries.data[mid].arch:~u64 < arch:~u64) { lo = mid + 1; }
        or                                             { hi = mid; }
    }
    if (lo >= x.entries.len || x.entries.data[lo].arch != arch) { ret opt[*Row].none{}; }
    ret opt[*Row].some{x.entries.data[lo].row};
}

# the row a target selects by: the one serving the architecture it names, when
# the target also declares a convention and a baseline, so a machine can be
# opened for it
# ---
# x:   the index
# t:   the target
# ret: the row, none when the target is not carried (it states no convention
#      or baseline, or no carried set serves its architecture), or why its
#      architecture names no row of mink's catalog
pub fun for_target(x: *Index, t: *Target) res[opt[*Row], Error] {
    val arch: res[*arches.Arch, record.Error] = record.arch(t);
    if (sel arch.err)                                            { ret res[opt[*Row], Error].err{Error.arch{arch.err}}; }
    if (!(sel t.baseline.extensions) || !(sel t.convention.row)) { ret res[opt[*Row], Error].ok{opt[*Row].none{}}; }
    ret res[opt[*Row], Error].ok{of(x, arch.ok)};
}

# whether a target carries a convention, a baseline and a selection table
pub fun carried(x: *Index, t: *Target) res[bool, Error] {
    val row: res[opt[*Row], Error] = for_target(x, t);
    if (sel row.err) { ret res[bool, Error].err{row.err}; }
    ret res[bool, Error].ok{sel row.ok.some};
}
