# the instruction sets mirl carries, one row each
#
# a row joins masc's instruction set to the selection table, the frame code
# and the moves written for it. masc finds the set serving a target's
# architecture once, when the target's machine is opened, and the row is the
# one carrying that set, so no consumer spells a set, a table or a frame code
# of its own and a second set is a row beside the first.

use std.types.option.opt;
use std.types.size.usize;

use masc.core.set.Set;
use riscv_set: masc.isa.riscv.set;

use mirl.isa.riscv;
use mirl.machine.copy.move;
use mirl.machine.frame.code.Code;
use mirl.machine.select.rule.Table;

# one carried instruction set
# ---
# set:   masc's instruction set
# table: the selection table for it
# frame: the code of its frame moves
# moves: its moves between locations
pub rec Row {
    set:   *Set;
    table: *Table;
    frame: *Code;
    moves: *move.Table;
}

def Rows: [1]Row;

val ROWS: Rows = [1]Row{
    Row{set: ?riscv_set.SET, table: ?riscv.TABLE, frame: ?riscv.FRAME, moves: ?riscv.MOVES},
};

# the row carrying masc's instruction set, none when mirl carries no table for it
# ---
# s:   the set, as the open machine's basis holds it
# ret: the row, one per carried set
pub fun of(s: *Set) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (ROWS[i].set == s) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}
