# the instruction sets mirl carries, one row each
#
# a row joins masc's instruction set to the selection table and the frame code
# written for it. a target reaches its row through the set its architecture
# names, so no consumer spells a set, a table or a frame code of its own.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use arches: mink.lib.catalog.arch;

use mset: masc.core.set;
use masc.core.set.Set;
use masc.isa.isa;
use riscv_set: masc.isa.riscv.set;

use mirl.isa.riscv;
use mirl.machine.frame.code.Code;
use mirl.machine.select.rule.Table;
use mirl.target.record;
use mirl.target.record.Target;

# one carried instruction set
# ---
# set:   masc's instruction set
# table: the selection table for it
# frame: the code of its frame moves
pub rec Row {
    set:   *Set;
    table: *Table;
    frame: *Code;
}

def Rows: [1]Row;

val ROWS: Rows = [1]Row{
    Row{set: ?riscv_set.SET, table: ?riscv.TABLE, frame: ?riscv.FRAME},
};

# the row of a set, none when mirl carries no selection for it
pub fun of(set: *Set) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (ROWS[i].set == set) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the row a target selects by: the one of the set its architecture names, when
# the target also declares a convention and a baseline, so a machine can be
# opened for it. none when it names no architecture, masc serves it no set,
# mirl carries no row for the set or it states no convention or baseline
pub fun for_target(t: *Target) opt[*Row] {
    if (!(sel t.baseline.extensions) || !(sel t.convention.row)) { ret opt[*Row].none{}; }
    val arch: res[*arches.Arch, record.Error] = record.arch(t);
    if (sel arch.err) { ret opt[*Row].none{}; }
    val found: opt[*Set] = mset.find(?isa.REGISTRY, arch.ok);
    if (sel found.none) { ret opt[*Row].none{}; }
    ret of(found.some);
}

# whether a target carries a convention, a baseline and a selection table
pub fun carried(t: *Target) bool {
    val row: opt[*Row] = for_target(t);
    ret sel row.some;
}
