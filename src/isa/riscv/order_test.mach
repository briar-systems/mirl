# the walk over every atomic opcode at every ordering its row allows,
# selected on RV64 and RV32, at the word, the doubleword and a narrow width,
# with and without Zacas and Zabha, its machine instructions compared with
# the RVWMO mapping of the RISC-V unprivileged spec's memory model appendix,
# Table A.6, which this file restates apart from the selection table
#
# the opcodes walked are the ir's rows that hold an ordering immediate, read
# from the opcode table, and the orderings of each are the ones its row's
# rule on that immediate allows, so an atomic opcode the walk has no mapping
# for fails it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use diag: std.print;

use mirl.ir.id;
use mirl.ir.module;
use mirl.ir.module.Module;
use ir:        mirl.ir.opcode;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.isa.riscv.field_test.number;
use mirl.isa.riscv.field_test.put;
use mirl.isa.riscv.rules.TABLE;
use mirl.machine.alloc.location;
use mirl.machine.alloc.location.Locations;
use mirl.machine.class.Memory;
use mf: mirl.machine.function;
use mi: mirl.machine.instruction;
use mirl.machine.operand.Block;
use mirl.machine.operand.Instruction;
use mirl.machine.operand.Operand;
use mirl.machine.select.engine;
use mirl.machine.select.engine.Calls;
use mirl.machine.select.engine.Selected;
use mirl.machine.select.engine.Selector;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine;

use rf:             masc.core.register;
use riscv_register: masc.isa.riscv.register;
use riscv_set:      masc.isa.riscv.set;

# the ir's orderings by number, weakest first, and their spellings
#[testing]
val ORDERS: [5]ir.Ordering = [5]ir.Ordering{ir.Ordering.relaxed{}, ir.Ordering.acquire{}, ir.Ordering.release{}, ir.Ordering.acq_rel{}, ir.Ordering.seq_cst{}};

#[testing]
val SPELLED: [5]str = [5]str{"relaxed", "acquire", "release", "acq_rel", "seq_cst"};

#[testing]
val RELAXED: usize = 0;

#[testing]
val ACQUIRE: usize = 1;

#[testing]
val RELEASE: usize = 2;

#[testing]
val ACQ_REL: usize = 3;

#[testing]
val SEQ_CST: usize = 4;

# Table A.6 by ordering: the aq (2) and rl (1) bits of an amo, of the load
# reserved of an lr and sc loop, and of its store conditional
#[testing]
val AMO_BITS: [5]u64 = [5]u64{0, 2, 1, 3, 3};

#[testing]
val LR_BITS: [5]u64 = [5]u64{0, 2, 0, 2, 3};

#[testing]
val SC_BITS: [5]u64 = [5]u64{0, 0, 1, 1, 1};

# the weakest ordering at least as strong as each and acquire, for a compare
# and exchange that fails as acquire
#[testing]
val WITH_ACQUIRE: [5]usize = [5]usize{ACQUIRE, ACQUIRE, ACQ_REL, ACQ_REL, SEQ_CST};

#[testing]
val NO_ADDED: Slice[str] = Slice[str]{data: nil, size: 0};

#[testing]
val ZACAS_NAMES: [1]str = [1]str{"zacas"};

#[testing]
val BOTH_NAMES: [2]str = [2]str{"zabha", "zacas"};

# one selection the walk runs every case under
# ---
# target: the target's name, its own baseline selected
# added:  the extensions added to it
# width:  the bits of the integer the atomics take
# xlen:   the bits of the target's register
# suffix: the width's suffix on an amo, a load, a store or a loop
# load:   the plain load of the width
# store:  the plain store of the width
# direct: an amo of the width is admitted
# cas:    an amocas of the width is admitted
#[testing]
rec Config {
    target: str;
    added:  Slice[str];
    width:  u32;
    xlen:   u32;
    suffix: str;
    load:   str;
    store:  str;
    direct: bool;
    cas:    bool;
}

#[testing]
val CONFIGS: [7]Config = [7]Config{
    Config{target: "riscv64-linux", added: NO_ADDED, width: 32, xlen: 64, suffix: "w", load: "lw", store: "sw", direct: true, cas: false},
    Config{target: "riscv64-linux", added: NO_ADDED, width: 64, xlen: 64, suffix: "d", load: "ld", store: "sd", direct: true, cas: false},
    Config{target: "riscv32-linux", added: NO_ADDED, width: 32, xlen: 32, suffix: "w", load: "lw", store: "sw", direct: true, cas: false},
    Config{target: "riscv64-linux", added: NO_ADDED, width: 8, xlen: 64, suffix: "b", load: "lb", store: "sb", direct: false, cas: false},
    Config{target: "riscv32-linux", added: NO_ADDED, width: 16, xlen: 32, suffix: "h", load: "lh", store: "sh", direct: false, cas: false},
    Config{target: "riscv64-linux", added: Slice[str]{data: ?ZACAS_NAMES[0], size: 1}, width: 64, xlen: 64, suffix: "d", load: "ld", store: "sd", direct: true, cas: true},
    Config{target: "riscv32-linux", added: Slice[str]{data: ?BOTH_NAMES[0], size: 2}, width: 8, xlen: 32, suffix: "b", load: "lb", store: "sb", direct: true, cas: true},
};

# an amo's name before its suffix, for the operations one amo does
# ---
# name: the ir opcode's name
# amo:  the amo's
#[testing]
rec Amo {
    name: str;
    amo:  str;
}

#[testing]
val AMOS: [9]Amo = [9]Amo{
    Amo{name: "atomic.add", amo: "amoadd."},
    Amo{name: "atomic.and", amo: "amoand."},
    Amo{name: "atomic.or", amo: "amoor."},
    Amo{name: "atomic.xor", amo: "amoxor."},
    Amo{name: "atomic.xchg", amo: "amoswap."},
    Amo{name: "atomic.smax", amo: "amomax."},
    Amo{name: "atomic.smin", amo: "amomin."},
    Amo{name: "atomic.umax", amo: "amomaxu."},
    Amo{name: "atomic.umin", amo: "amominu."},
};

# the field loop of each read-modify-write on a narrow width, by the ir opcode's name
#[testing]
rec Field {
    name: str;
    loop: str;
}

#[testing]
val FIELDS: [10]Field = [10]Field{
    Field{name: "atomic.add", loop: "field_add"},
    Field{name: "atomic.and", loop: "field_and"},
    Field{name: "atomic.or", loop: "field_or"},
    Field{name: "atomic.xor", loop: "field_xor"},
    Field{name: "atomic.xchg", loop: "field_xchg"},
    Field{name: "atomic.smax", loop: "field_smax"},
    Field{name: "atomic.smin", loop: "field_smin"},
    Field{name: "atomic.umax", loop: "field_umax"},
    Field{name: "atomic.umin", loop: "field_umin"},
    Field{name: "atomic.sub", loop: "field_sub"},
};

# one case: an opcode at an ordering, and a compare and exchange's failure ordering
#[testing]
rec Case {
    op:      ir.Opcode;
    order:   usize;
    failure: usize;
}

# the slots of a row that hold an ordering, none past the first two
#[testing]
rec Ordered {
    first:  opt[usize];
    second: opt[usize];
}

#[testing]
fun ordered_slots(r: *ir.Row) Ordered {
    var o:    Ordered = Ordered{first: opt[usize].none{}, second: opt[usize].none{}};
    var seen: usize   = 0;
    var k:    usize   = 0;
    for (k < $length_of(ir.Slots)) {
        if (sel r.immediates[k].holds.ordering) {
            if (seen == 0) { o.first = opt[usize].some{k}; }
            or             { o.second = opt[usize].some{k}; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    ret o;
}

# whether the row's rule on an ordering slot allows an ordering
#[testing]
fun allows(r: *ir.Row, slot: usize, order: usize) bool {
    var j: usize = 0;
    for (j < $length_of(ir.Rules)) {
        val rl: ir.Rule = r.rules[j];
        if (sel rl.ordering) {
            if (rl.ordering.slot::usize == slot) { ret ir.holds(rl.ordering.orderings, ORDERS[order]); }
        }
        j = j + 1;
    }
    ret false;
}

# the ordering a case's access keeps, its failure ordering joined in
#[testing]
fun kept(c: Case) opt[usize] {
    if (c.failure == RELAXED) { ret opt[usize].some{c.order}; }
    if (c.failure == SEQ_CST) { ret opt[usize].some{SEQ_CST}; }
    if (c.failure == ACQUIRE) { ret opt[usize].some{WITH_ACQUIRE[c.order]}; }
    ret opt[usize].none{};
}

# every case: each atomic opcode at each ordering its row allows
#[testing]
fun cases(a: *allocator.Allocator) opt[vector.Vector[Case]] {
    var v:  vector.Vector[Case] = vector.init[Case](a);
    var op: u32                 = 0;
    for (op < ir.rows()) {
        val code: ir.Opcode   = ir.Opcode{index: op};
        val row:  opt[ir.Row] = ir.row(code);
        if (sel row.some) {
            var r:     ir.Row  = row.some;
            val slots: Ordered = ordered_slots(?r);
            if (sel slots.first.some) {
                var o: usize = 0;
                for (o < 5) {
                    if (allows(?r, slots.first.some, o)) {
                        var f: usize = 0;
                        for (f < 5) {
                            var taken: bool = f == RELAXED;
                            if (sel slots.second.some) { taken = allows(?r, slots.second.some, f); }
                            if (taken) {
                                val pushed: res[usize, allocator.Error] = vector.push[Case](?v, Case{op: code, order: o, failure: f});
                                if (sel pushed.err) {
                                    vector.dnit[Case](?v);
                                    ret opt[vector.Vector[Case]].none{};
                                }
                            }
                            f = f + 1;
                        }
                    }
                    o = o + 1;
                }
            }
        }
        op = op + 1;
    }
    ret opt[vector.Vector[Case]].some{v};
}

# the integer type of a configuration
#[testing]
fun integer(v: *vector.Vector[u8], c: *Config) bool {
    ret put(v, "i") && number(v, c.width::u64);
}

# one function per case, its instance written from its row: the results, the
# operands of the address and two values, and each immediate, a type the
# configuration's integer and an ordering the case's
#[testing]
fun module_text(v: *vector.Vector[u8], c: *Config, list: *vector.Vector[Case]) bool {
    if (!put(v, "target \"") || !put(v, c.target) || !put(v, "\"\n")) { ret false; }
    var k: usize = 0;
    for (k < list.len) {
        val cs:  Case        = list.data[k];
        val row: opt[ir.Row] = ir.row(cs.op);
        if (sel row.none) { ret false; }
        var r: ir.Row = row.some;
        if (!put(v, "\nfunction @c") || !number(v, k::u64) || !put(v, ": fun(ptr, ") || !integer(v, c) || !put(v, ", ") || !integer(v, c))                                         { ret false; }
        if (!put(v, ") -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%p: ptr, %x: ")) { ret false; }
        if (!integer(v, c) || !put(v, ", %y: ") || !integer(v, c) || !put(v, "):\n    "))                                                                                          { ret false; }
        var n: usize = 0;
        for (n < $length_of(ir.Results) && !(sel r.results[n].unstated)) {
            if (n > 0 && !put(v, ", "))              { ret false; }
            if (!put(v, "%r") || !number(v, n::u64)) { ret false; }
            n = n + 1;
        }
        if (n > 0 && !put(v, " = ")) { ret false; }
        if (!put(v, r.name))         { ret false; }
        val names: [3]str = [3]str{"%p", "%x", "%y"};
        var items: usize  = 0;
        var i:     u32    = 0;
        for (i < ir.fixed(?r)) {
            if (items > 0 && !put(v, ","))         { ret false; }
            if (!put(v, " ") || !put(v, names[i])) { ret false; }
            items = items + 1;
            i     = i + 1;
        }
        var seen: usize = 0;
        var s:    usize = 0;
        for (s < $length_of(ir.Slots)) {
            val slot: ir.Slot = r.immediates[s];
            if (!(sel slot.holds.unstated)) {
                if (items > 0 && !put(v, ","))          { ret false; }
                if (!put(v, " ") || !put(v, slot.name)) { ret false; }
                if (sel slot.holds.ty) {
                    if (!put(v, " ") || !integer(v, c)) { ret false; }
                }
                or (sel slot.holds.ordering) {
                    var at: usize = cs.order;
                    if (seen > 0)                             { at = cs.failure; }
                    if (!put(v, " ") || !put(v, SPELLED[at])) { ret false; }
                    seen = seen + 1;
                }
                or { ret false; }
                items = items + 1;
            }
            s = s + 1;
        }
        if (!put(v, "\n    ret.placed places []\n}\n")) { ret false; }
        k = k + 1;
    }
    ret true;
}

# one machine instruction as the walk compares it: its row's mnemonic or its
# loop's name, and its immediates in order
#[testing]
fun spell(v: *vector.Vector[u8], name: str, imms: Slice[u64]) bool {
    if (!put(v, name)) { ret false; }
    var k: usize = 0;
    for (k < imms.size) {
        if (!put(v, " ") || !number(v, imms.data[k])) { ret false; }
        k = k + 1;
    }
    ret put(v, "; ");
}

#[testing]
fun spell0(v: *vector.Vector[u8], name: str) bool {
    ret spell(v, name, Slice[u64]{data: nil, size: 0});
}

#[testing]
fun spell1(v: *vector.Vector[u8], name: str, x: u64) bool {
    var one: [1]u64 = [1]u64{x};
    ret spell(v, name, Slice[u64]{data: ?one[0], size: 1});
}

#[testing]
fun spell2(v: *vector.Vector[u8], name: str, x: u64, y: u64) bool {
    var two: [2]u64 = [2]u64{x, y};
    ret spell(v, name, Slice[u64]{data: ?two[0], size: 2});
}

# a name and a suffix, as an amo's or a loop's
#[testing]
fun joined_name(buf: *u8, a: str, b: str) str {
    var n: usize = 0;
    var i: usize = 0;
    for (i < str_len(a)) {
        buf[n] = a[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(b)) {
        buf[n] = b[i];
        n      = n + 1;
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf;
}

# a field loop's spelling: its width, the register width, and the bits its
# load reserved, or straight sequence's amo, and its store conditional take
#[testing]
fun field_loop(v: *vector.Vector[u8], c: *Config, loop: str, loads: u64, stores: u64) bool {
    var four: [4]u64 = [4]u64{c.width::u64, c.xlen::u64, loads, stores};
    ret spell(v, loop, Slice[u64]{data: ?four[0], size: 4});
}

# the instructions Table A.6 maps a case to, the return closing them, false
# for an opcode the walk has no mapping for
#[testing]
fun expected(v: *vector.Vector[u8], c: *Config, cs: Case) bool {
    val row: opt[ir.Row] = ir.row(cs.op);
    val at:  opt[usize]  = kept(cs);
    if (sel row.none) { ret false; }
    if (sel at.none)  { ret false; }
    val name: str   = row.some.name;
    val o:    usize = at.some;
    var buf:  [24]u8;
    var done: bool  = false;
    if (str_equals(name, "atomic.load")) {
        if (o == SEQ_CST && !spell2(v, "fence", 3, 3))                   { ret false; }
        if (!spell1(v, c.load, 0))                                       { ret false; }
        if ((o == ACQUIRE || o == SEQ_CST) && !spell2(v, "fence", 2, 3)) { ret false; }
        done = true;
    }
    if (str_equals(name, "atomic.store")) {
        if ((o == RELEASE || o == SEQ_CST) && !spell2(v, "fence", 3, 1)) { ret false; }
        if (!spell1(v, c.store, 0))                                      { ret false; }
        done = true;
    }
    if (str_equals(name, "fence")) {
        if (o == ACQUIRE && !spell2(v, "fence", 2, 3)) { ret false; }
        if (o == RELEASE && !spell2(v, "fence", 3, 1)) { ret false; }
        if (o == ACQ_REL && !spell0(v, "fence.tso"))   { ret false; }
        if (o == SEQ_CST && !spell2(v, "fence", 3, 3)) { ret false; }
        done = true;
    }
    var k: usize = 0;
    for (!done && k < $length_of(AMOS)) {
        if (str_equals(name, AMOS[k].name) && c.direct) {
            if (!spell1(v, joined_name(?buf[0], AMOS[k].amo, c.suffix), AMO_BITS[o])) { ret false; }
            done = true;
        }
        k = k + 1;
    }
    if (!done && str_equals(name, "atomic.sub") && c.direct) {
        if (!spell0(v, "sub") || !spell1(v, joined_name(?buf[0], "amoadd.", c.suffix), AMO_BITS[o])) { ret false; }
        done = true;
    }
    k = 0;
    for (!done && k < $length_of(FIELDS)) {
        if (str_equals(name, FIELDS[k].name)) {
            var loads:  u64 = LR_BITS[o];
            var stores: u64 = SC_BITS[o];
            if (str_equals(name, "atomic.and") || str_equals(name, "atomic.or") || str_equals(name, "atomic.xor")) {
                loads  = AMO_BITS[o];
                stores = 0;
            }
            if (!field_loop(v, c, FIELDS[k].loop, loads, stores)) { ret false; }
            done = true;
        }
        k = k + 1;
    }
    if (!done && str_equals(name, "atomic.nand")) {
        if (c.width >= 32) {
            if (!spell2(v, joined_name(?buf[0], "nand_", c.suffix), LR_BITS[o], SC_BITS[o])) { ret false; }
        }
        or {
            if (!field_loop(v, c, "field_nand", LR_BITS[o], SC_BITS[o])) { ret false; }
        }
        done = true;
    }
    if (!done && str_equals(name, "atomic.cmpxchg")) {
        if (c.cas) {
            if (!spell1(v, joined_name(?buf[0], "amocas.", c.suffix), AMO_BITS[o])) { ret false; }
        }
        or (c.width >= 32) {
            if (!spell2(v, joined_name(?buf[0], "cmpxchg_", c.suffix), LR_BITS[o], SC_BITS[o])) { ret false; }
        }
        or {
            if (!field_loop(v, c, "field_cmpxchg", LR_BITS[o], SC_BITS[o])) { ret false; }
        }
        if (!spell0(v, "xor") || !spell1(v, "sltiu", 1)) { ret false; }
        done = true;
    }
    if (!done) { ret false; }
    ret spell1(v, "jalr", 0);
}

# the instructions selection gave a function, its entry's copies left out
#[testing]
fun selected_text(v: *vector.Vector[u8], f: *mf.Function) bool {
    var b: usize = 0;
    for (b < f.blocks.len) {
        val list: Slice[Instruction] = mf.instructions(f, Block{index: b::u32});
        var k:    usize              = 0;
        for (k < list.size) {
            val d:    *mi.InstructionData = mf.data(f, list.data[k]);
            var name: str                 = "";
            var keep: bool                = true;
            if (sel d.opcode.row)  { name = d.opcode.row.mnemonic; }
            or (sel d.opcode.loop) { name = d.opcode.loop.name; }
            or                     { keep = false; }
            if (keep) {
                var imms:  [16]u64;
                var count: usize = 0;
                var j:     usize = 0;
                for (j < d.operands.size && count < 16) {
                    val o: Operand = d.operands.data[j];
                    if (sel o.immediate) {
                        imms[count] = o.immediate::u64;
                        count       = count + 1;
                    }
                    j = j + 1;
                }
                if (!spell(v, name, Slice[u64]{data: ?imms[0], size: count})) { ret false; }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    ret true;
}

#[testing]
fun same_text(x: *vector.Vector[u8], y: *vector.Vector[u8]) bool {
    if (x.len != y.len) { ret false; }
    var i: usize = 0;
    for (i < x.len) {
        if (x.data[i] != y.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# every case of one configuration selected and compared, 0 when each matches
#[testing]
fun walk(c: *Config, at: usize) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val listed: opt[vector.Vector[Case]] = cases(?a);
    if (sel listed.none) { ret 1; }
    var list: vector.Vector[Case] = listed.some;
    fin { vector.dnit[Case](?list); }
    var text: vector.Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?text); }
    if (!module_text(?text, c, ?list)) { ret 2; }
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, View{data: text.data, len: text.len});
    if (sel made.err) {
        diag.eprintlnf("config {}: the walk's ir text is refused at {}:{}", at, made.err.line, made.err.column);
        ret 3;
    }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(m.target);
    if (sel row.none) { ret 4; }
    var t:      Target             = @row.some;
    var basis:  machine.Basis;
    val picked: err[machine.Error] = machine.choose(?basis, ?a, ?t, c.added);
    if (sel picked.err) { ret 5; }
    fin { machine.drop(?basis); }
    val located: res[Locations, location.Error] = location.init(?a, ?riscv_register.FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel located.err) { ret 6; }
    var locations: Locations = located.ok;
    fin { location.dnit(?locations); }
    val ready: res[Selector, engine.Error] = engine.init(?a, ?TABLE, ?t, ?riscv_set.SET, ?basis.selection);
    if (sel ready.err) { ret 7; }
    var s: Selector = ready.ok;
    fin { engine.dnit(?s); }
    var calls: Calls = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?locations};
    var k:     usize = 0;
    for (k < list.len) {
        val got: i32 = compared(?a, ?s, ?m, ?calls, c, list.data[k], k);
        if (got != 0) {
            diag.eprintlnf("config {}: case {} of {} fails", at, k, list.len);
            ret got;
        }
        k = k + 1;
    }
    ret 0;
}

# one case selected and compared with its mapping, 0 when they match
#[testing]
fun compared(a: *allocator.Allocator, s: *Selector, m: *Module, calls: *Calls, c: *Config, cs: Case, k: usize) i32 {
    val got: res[Selected, engine.Error] = engine.select(s, m, id.Function{index: k::u32}, calls);
    if (sel got.err) { ret 8; }
    var out: Selected = got.ok;
    fin { engine.release(?out); }
    var want: vector.Vector[u8] = vector.init[u8](a);
    var have: vector.Vector[u8] = vector.init[u8](a);
    fin {
        vector.dnit[u8](?want);
        vector.dnit[u8](?have);
    }
    if (!expected(?want, c, cs))              { ret 9; }
    if (!selected_text(?have, ?out.function)) { ret 10; }
    if (!same_text(?want, ?have)) {
        val w: res[usize, allocator.Error] = vector.push[u8](?want, 0);
        val h: res[usize, allocator.Error] = vector.push[u8](?have, 0);
        if (sel w.err || sel h.err) { ret 11; }
        diag.eprintlnf("selected {}", have.data::str);
        diag.eprintlnf("Table A.6 {}", want.data::str);
        ret 11;
    }
    ret 0;
}

# each atomic opcode at each ordering its row allows selects the form Table
# A.6 maps it to: loads, stores and fences their fences, every amo, amocas
# and loop its aq and rl bits, a compare and exchange its two orderings joined
test riscv__each_atomic_ordering_selects_its_weakest_form {
    var k: usize = 0;
    for (k < $length_of(CONFIGS)) {
        val got: i32 = walk(?CONFIGS[k], k);
        if (got != 0) { ret got + (k::i32) * 100; }
        k = k + 1;
    }
    ret 0;
}
