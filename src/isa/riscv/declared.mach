# the operations the RISC-V table has no rule for, and why
#
# an operation here is taken out before selection or waits for the job that
# closes it, and the table's test walks every opcode of the ir against this
# list and the table's rules, so an opcode in neither is a failing test. the
# types a native type excludes (integers wider than the register, half
# precision without Zfh, vectors a target holds in no register) are removed by
# their legalisation and are not opcodes, so they have no entry. an operand a
# rule's type test does not admit is refused by the engine, naming it.

use std.types.string.str;

use ir: mirl.ir.opcode;

# why an opcode has no rule
# ---
# opcode: the opcode
# why:    what takes it out of selection
# owner:  the issue of the job that closes it, zero when no job does yet
pub rec Declared {
    opcode: ir.Opcode;
    why:    str;
    owner:  u32;
}

pub val VECTOR:     str = "vector operations are scalarised, since the target holds vectors in no register";
pub val HELPER:     str = "no instruction does it, and a helper function does";
pub val CONVENTION: str = "the abi legalisation puts a call and a return in piece form, which the rules select";
pub val LOOP:       str = "a loop of load reserved and store conditional, which an expansion cannot hold";

pub val DECLARED: [29]Declared = [29]Declared{
    Declared{opcode: ir.VSPLAT, why: VECTOR, owner: 52},
    Declared{opcode: ir.VBUILD, why: VECTOR, owner: 52},
    Declared{opcode: ir.VSHUFFLE, why: VECTOR, owner: 52},
    Declared{opcode: ir.VEXTRACT, why: VECTOR, owner: 52},
    Declared{opcode: ir.VINSERT, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_ADD, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FADD_SEQ, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_MUL, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_AND, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_OR, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_XOR, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_SMIN, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_SMAX, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_UMIN, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_UMAX, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FADD_ANY, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMUL_ANY, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMIN, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMAX, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMINNUM, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMAXNUM, why: VECTOR, owner: 52},
    Declared{opcode: ir.REDUCE_FMUL_SEQ, why: VECTOR, owner: 52},
    Declared{opcode: ir.FREM, why: HELPER, owner: 54},
    Declared{opcode: ir.MEM_COPY, why: HELPER, owner: 54},
    Declared{opcode: ir.MEM_FILL, why: HELPER, owner: 54},
    Declared{opcode: ir.CALL, why: CONVENTION, owner: 29},
    Declared{opcode: ir.RET, why: CONVENTION, owner: 29},
    Declared{opcode: ir.ATOMIC_NAND, why: LOOP, owner: 0},
    Declared{opcode: ir.ATOMIC_CMPXCHG, why: LOOP, owner: 0},
};
