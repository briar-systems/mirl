#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# whether some rule of the table is for an opcode
#[testing]
fun ruled(op: ir.Opcode) bool {
    var i: u32 = 0;
    for (i < rules.TABLE.rules.len) {
        if (rules.TABLE.rules.at[i].nodes.at[0].opcode.index == op.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
fun declared_opcode(op: ir.Opcode) bool {
    var i: u32 = 0;
    for (i < $length_of(declared.DECLARED)) {
        if (declared.DECLARED[i].opcode.index == op.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# every opcode of the ir has a rule or is declared removed, and not both
test riscv__every_opcode_has_a_rule_or_a_declared_legalisation {
    var op: u32 = 0;
    for (op < ir.rows()) {
        val code: ir.Opcode = ir.Opcode{index: op};
        val has:  bool      = ruled(code);
        val said: bool      = declared_opcode(code);
        if (has && said) {
            diag.eprintlnf("opcode {} has a rule and is declared", op);
            ret 1;
        }
        if (!has && !said) {
            diag.eprintlnf("opcode {} has no rule and is not declared", op);
            ret 2;
        }
        op = op + 1;
    }
    # the registers the table fixes are the ones masc's file names
    val zero: opt[*rf.Register] = rf.row_of(?riscv_register.FILE, gen_register.X0);
    val ra:   opt[*rf.Register] = rf.row_of(?riscv_register.FILE, gen_register.X1);
    if (sel zero.none) { ret 6; }
    if (sel ra.none)   { ret 6; }
    val x0: *rf.Register = zero.some;
    val x1: *rf.Register = ra.some;
    if (!str_equals(x0.name, "x0") || (x0.flags & rf.ZERO) == 0) { ret 7; }
    if (!str_equals(x1.name, "x1"))                              { ret 8; }
    ret 0;
}

# an abi alias in machine text is the canonical register
test riscv__an_abi_alias_reads_as_its_canonical_register {
    var a: allocator.Allocator;
    page.make(?a);
    val env:  item.Env                          = item.Env{set: ?riscv_set.SET, memories: Slice[Memory]{data: nil, size: 0}, loops: lrow.NONE};
    val made: res[index.Index, resolve.Failure] = index.init(?a, ?env);
    if (sel made.err) { ret 1; }
    var x: index.Index = made.ok;
    fin { index.dnit(?x); }
    val ra: res[rf.Id, index.Unspelled] = index.register_named(?x, view_of("ra"));
    val x1: res[rf.Id, index.Unspelled] = index.register_named(?x, view_of("x1"));
    if (sel ra.err) { ret 2; }
    if (sel x1.err) { ret 2; }
    val alias: rf.Id = ra.ok;
    val canon: rf.Id = x1.ok;
    if (alias != gen_register.X1 || canon != gen_register.X1) { ret 3; }
    val sp: res[rf.Id, index.Unspelled] = index.register_named(?x, view_of("sp"));
    if (sel sp.err) { ret 4; }
    val stack: rf.Id = sp.ok;
    if (stack != gen_register.X2) { ret 4; }
    ret 0;
}

# the extensions a test adds on top of the baseline of its target
#[testing]
val NONE: Slice[str] = Slice[str]{data: nil, size: 0};

#[testing]
val ZBA_ZBB_NAMES: [2]str = [2]str{"zba", "zbb"};

#[testing]
val ZBA_ZBB: Slice[str] = Slice[str]{data: ?ZBA_ZBB_NAMES[0], size: 2};

#[testing]
val ZBB_NAMES: [1]str = [1]str{"zbb"};

#[testing]
val ZBB: Slice[str] = Slice[str]{data: ?ZBB_NAMES[0], size: 1};

# a module, the selection its target's machine holds and a selector over the table
# ---
# mc:     the target's machine, when its convention is declared
# basis:  the selection alone, for a target that declares no convention
# opened: the machine was made, so the selection is the machine's
# copy:   the target's row as a test changes it, when target points at it
#[testing]
rec Fixture {
    a:      allocator.Allocator;
    m:      Module;
    s:      Selector;
    target: *Target;
    copy:   Target;
    mc:     Machine;
    basis:  Basis;
    opened: bool;
    at:     Locations;
}

# the one selection the fixture holds
#[testing]
fun held(x: *Fixture) *extension.Selection {
    if (x.opened) { ret ?x.mc.basis.selection; }
    ret ?x.basis.selection;
}

# select a function of the fixture, its calls clobbering what the target's
# convention says, with the clobbers they state
#[testing]
fun selected_with(x: *Fixture, f: id.Function) res[Selected, Error] {
    var calls: Calls = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?x.at};
    if (x.opened) { calls.clobbered = x.mc.convention.clobbered; }
    ret engine.select(?x.s, ?x.m, f, ?calls);
}

# select a function of the fixture
#[testing]
fun selected(x: *Fixture, f: id.Function) res[mf.Function, Error] {
    val got: res[Selected, Error] = selected_with(x, f);
    if (sel got.err) { ret res[mf.Function, Error].err{got.err}; }
    var out: Selected = got.ok;
    vector.dnit[Clobber](?out.clobbers);
    ret res[mf.Function, Error].ok{out.function};
}

# make a fixture of ir text, selecting the baseline of the target the text names and the extensions added to it
#[testing]
fun setup(x: *Fixture, text: View, added: Slice[str]) bool {
    if (!read(x, text)) { ret false; }
    ret open(x, added);
}

# read the ir text of a fixture and find the row of the target it names
#[testing]
fun read(x: *Fixture, text: View) bool {
    page.make(?x.a);
    val parsed: res[Module, Refusal] = ir_reader.parse_body(?x.a, text);
    if (sel parsed.err) { ret false; }
    x.m = parsed.ok;
    val row: opt[*Target] = targets.by_name(x.m.target);
    if (sel row.none) { ret false; }
    x.target = row.some;
    ret true;
}

# open the machine and the selector of a fixture's target, with the extensions added to its baseline
#[testing]
fun open(x: *Fixture, added: Slice[str]) bool {
    # a target that declares no convention has a selection and no machine, makes
    # no call and its calls clobber nothing, and any other refusal fails the fixture
    val opened: err[machine.Error] = machine.open_with(?x.mc, ?x.a, x.target, added);
    x.opened = sel opened.ok;
    if (sel opened.err) {
        val why: machine.Error = opened.err;
        if (!(sel why.convention)) { ret false; }
        val chosen: err[machine.Error] = machine.choose(?x.basis, ?x.a, x.target, added);
        if (sel chosen.err) { ret false; }
    }
    val made: res[Selector, Error] = engine.init(?x.a, ?rules.TABLE, x.target, ?riscv_set.SET, held(x));
    if (sel made.err) { ret false; }
    x.s = made.ok;
    val at: res[Locations, location.Error] = location.init(?x.a, ?riscv_register.FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel at.err) { ret false; }
    x.at = at.ok;
    ret true;
}

#[testing]
fun teardown(x: *Fixture) {
    location.dnit(?x.at);
    if (x.opened) { machine.close(?x.mc); }
    or            { machine.drop(?x.basis); }
    engine.dnit(?x.s);
    module.dnit(?x.m);
}

# the bytes of a file of test/machine
#[testing]
fun corpus(a: *allocator.Allocator, name: str, ext: str) opt[vector.Vector[u8]] {
    var buf: [256]u8;
    val dir: str   = "test/machine/";
    var n:   usize = 0;
    var i:   usize = 0;
    for (i < str_len(dir)) {
        buf[n] = dir[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(name)) {
        buf[n] = name[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(ext)) {
        buf[n] = ext[i];
        n      = n + 1;
        i      = i + 1;
    }
    buf[n] = 0;
    val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(a, ?buf[0]);
    if (sel file.err) { ret opt[vector.Vector[u8]].none{}; }
    ret opt[vector.Vector[u8]].some{file.ok};
}

# the function of the module that is the n-th with a body, none past the last
#[testing]
fun nth(x: *Fixture, n: usize) opt[id.Function] {
    var seen: usize = 0;
    var k:    usize = 0;
    for (k < x.m.functions.len) {
        if (x.m.functions.data[k].body.blocks.len > 0) {
            if (seen == n) { ret opt[id.Function].some{id.Function{index: k::u32}}; }
            seen = seen + 1;
        }
        k = k + 1;
    }
    ret opt[id.Function].none{};
}

# select each function of a corpus file, ir text beside its machine text, and compare them
#[testing]
fun matches(name: str, added: Slice[str]) u32 {
    var a: allocator.Allocator;
    page.make(?a);
    val ir: opt[vector.Vector[u8]] = corpus(?a, name, ".mirl");
    val mt: opt[vector.Vector[u8]] = corpus(?a, name, ".mirm");
    if (sel ir.none) { ret 1; }
    if (sel mt.none) { ret 1; }
    var x: Fixture;
    if (!setup(?x, View{data: ir.some.data, len: ir.some.len}, added)) { ret 2; }
    fin { teardown(?x); }
    val want: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, View{data: mt.some.data, len: mt.some.len});
    if (sel want.err) {
        diag.eprintlnf("{}.mirm: refused at {}:{}", name, want.err.line, want.err.column);
        ret 3;
    }
    var unit: reader.Unit = want.ok;
    fin { reader.dnit(?unit); }
    var n: usize = 0;
    for (n < unit.items.len) {
        val at: opt[id.Function] = nth(?x, n);
        if (sel at.none) { ret 4; }
        val got: res[mf.Function, Error] = selected(?x, at.some);
        if (sel got.err) {
            refusal(got.err);
            ret 5;
        }
        var f: mf.Function = got.ok;
        fin { mf.dnit(?f); }
        val same: res[bool, printer.Error] = equal.same_function(?x.m, ?f, ?x.m, ?unit.items.data[n].function);
        if (sel same.err) { ret 6; }
        if (!same.ok) {
            show(?x.m, at.some, f);
            diag.eprintlnf("{}: function {} is not its machine text", name, n);
            ret 7;
        }
        n = n + 1;
    }
    # the machine text holds every function the module defines
    val extra: opt[id.Function] = nth(?x, n);
    if (sel extra.some) { ret 8; }
    ret 0;
}

# say why selection refused, for a failing test's output
#[testing]
fun refusal(e: Error) {
    if (sel e.unmatched) { diag.eprintlnf("unmatched instruction {}", e.unmatched.instruction.index); }
    or (sel e.machine)   { diag.eprintln("the machine form refused an instruction"); }
    or (sel e.placed)    { diag.eprintln("a piece at a place selection does not carry"); }
    or (sel e.transfer)  { diag.eprintln("a piece form expansion that neither calls nor returns"); }
    or (sel e.lookup)    { diag.eprintln("no thread lookup function"); }
    or (sel e.unlocated) { diag.eprintln("a clobber the locations do not number"); }
    or (sel e.aggregate) { diag.eprintln("an aggregate value"); }
    or                   { diag.eprintln("selection refused"); }
}

# print a selected function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, at: id.Function, f: mf.Function) {
    var items: [1]item.Item;
    items[0].symbol   = id.Symbol.function{at};
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print(?out, m, Slice[item.Item]{data: ?items[0], size: 1});
}

# the mnemonic of the row an instruction of a machine block is
#[testing]
fun mnemonic_at(f: *mf.Function, b: u32, k: usize) str {
    val list: Slice[Instruction] = mf.instructions(f, Block{index: b});
    val d:    *InstructionData   = mf.data(f, list.data[k]);
    if (sel d.opcode.row) { ret d.opcode.row.mnemonic; }
    ret "";
}

#[testing]
val CLZ: str = "target \"riscv64-linux\"\nfunction @f: fun(i64, ptr) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact] {\n^entry(%x: i64, %p: ptr):\n    %c = clz %x\n    store %p, %c, align 8\n    ret.placed places []\n}\n";

# the extension forms when zba and zbb are added to the baseline, the base expansions when not
test riscv__a_function_selects_the_extension_forms_when_selected_and_the_base_expansions_when_not {
    if (matches("riscv_ext", ZBA_ZBB) != 0) { ret 1; }
    if (matches("riscv_base", NONE) != 0)   { ret 2; }
    if (matches("riscv32", NONE) != 0)      { ret 3; }
    if (matches("riscv_high", NONE) != 0)   { ret 12; }

    # the base count of leading zeros is one block of base instructions with no branch and no loop
    var x: Fixture;
    if (!setup(?x, view_of(CLZ), NONE)) { ret 4; }
    fin { teardown(?x); }
    val at: opt[id.Function] = nth(?x, 0);
    if (sel at.none) { ret 5; }
    val got: res[mf.Function, Error] = selected(?x, at.some);
    if (sel got.err) { ret 5; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    val count: usize = mf.instructions(?f, Block{index: 0}).size;
    if (f.blocks.len != 1 || count < 20) { ret 6; }
    var k: usize = 0;
    for (k < count) {
        val name: str = mnemonic_at(?f, 0, k);
        if (str_equals(name, "clz") || str_equals(name, "jal") || str_equals(name, "bne") || str_equals(name, "beq")) { ret 7; }
        k = k + 1;
    }

    # once zbb is added on top of the baseline it is the one instruction
    var z: Fixture;
    if (!setup(?z, view_of(CLZ), ZBB)) { ret 8; }
    fin { teardown(?z); }
    val with: opt[id.Function] = nth(?z, 0);
    if (sel with.none) { ret 9; }
    val taken: res[mf.Function, Error] = selected(?z, with.some);
    if (sel taken.err) { ret 10; }
    var g: mf.Function = taken.ok;
    fin { mf.dnit(?g); }
    var found: bool  = false;
    var j:     usize = 0;
    for (j < mf.instructions(?g, Block{index: 0}).size) {
        if (str_equals(mnemonic_at(?g, 0, j), "clz")) { found = true; }
        j = j + 1;
    }
    if (!found) { ret 11; }
    ret 0;
}

# a kept store keeps its mark through selection, and no store is dropped or merged
test riscv__a_kept_store_is_selected_whole_and_keeps_its_mark {
    if (matches("kept", NONE) != 0) { ret 1; }
    var a: allocator.Allocator;
    page.make(?a);
    val ir: opt[vector.Vector[u8]] = corpus(?a, "kept", ".mirl");
    if (sel ir.none) { ret 2; }
    var x: Fixture;
    if (!setup(?x, View{data: ir.some.data, len: ir.some.len}, NONE)) { ret 3; }
    fin { teardown(?x); }
    val at: opt[id.Function] = nth(?x, 0);
    if (sel at.none) { ret 4; }
    val got: res[mf.Function, Error] = selected(?x, at.some);
    if (sel got.err) { ret 4; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    val list:   Slice[Instruction] = mf.instructions(?f, Block{index: 0});
    var stores: usize              = 0;
    var kept:   usize              = 0;
    var k:      usize              = 0;
    for (k < list.size) {
        val d: *InstructionData = mf.data(?f, list.data[k]);
        if (str_equals(mnemonic_at(?f, 0, k), "sd")) {
            stores = stores + 1;
            if (d.metadata.flags.kept) { kept = kept + 1; }
        }
        k = k + 1;
    }
    if (stores != 3 || kept != 2) { ret 5; }
    ret 0;
}

#[testing]
val SHIFT_BOUNDED: str = "target \"riscv64-linux\"\nfunction @f: fun(i64, i64, ptr) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%x: i64, %c: i64, %p: ptr):\n    %s = shl %x, %c bounded\n    store %p, %s, align 8\n    ret.placed places []\n}\n";

#[testing]
val SHIFT_BARE: str = "target \"riscv64-linux\"\nfunction @f: fun(i64, i64, ptr) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%x: i64, %c: i64, %p: ptr):\n    %s = shl %x, %c\n    store %p, %s, align 8\n    ret.placed places []\n}\n";

# a shift by a variable count selects to the plain instruction only when its count is marked bounded
test riscv__a_variable_shift_selects_only_when_its_count_is_bounded {
    var x: Fixture;
    if (!setup(?x, view_of(SHIFT_BOUNDED), NONE)) { ret 1; }
    fin { teardown(?x); }
    val at: opt[id.Function] = nth(?x, 0);
    if (sel at.none) { ret 2; }
    val got: res[mf.Function, Error] = selected(?x, at.some);
    if (sel got.err) { ret 3; }
    var f: mf.Function = got.ok;
    fin { mf.dnit(?f); }
    # after the three parameters are copied out of their registers
    if (!str_equals(mnemonic_at(?f, 0, 3), "sll")) { ret 4; }

    var y: Fixture;
    if (!setup(?y, view_of(SHIFT_BARE), NONE)) { ret 5; }
    fin { teardown(?y); }
    val bare: opt[id.Function] = nth(?y, 0);
    if (sel bare.none) { ret 6; }
    val refused: res[mf.Function, Error] = selected(?y, bare.some);
    if (sel refused.ok) {
        var g: mf.Function = refused.ok;
        mf.dnit(?g);
        ret 7;
    }
    if (!(sel refused.err.unmatched)) { ret 8; }
    ret 0;
}

# the fixture of a corpus file's ir text
#[testing]
fun load(x: *Fixture, name: str, added: Slice[str]) bool {
    var a: allocator.Allocator;
    page.make(?a);
    val ir: opt[vector.Vector[u8]] = corpus(?a, name, ".mirl");
    if (sel ir.none) { ret false; }
    ret setup(x, View{data: ir.some.data, len: ir.some.len}, added);
}

# a call, an entry and a return place each piece where the convention put it:
# into its register, at its outgoing slot or from its incoming one, and each
# call the selection makes states every register the convention clobbers
test riscv__calls_entries_and_returns_place_their_pieces_and_state_their_clobbers {
    if (matches("riscv_calls", NONE) != 0) { ret 1; }
    var x: Fixture;
    if (!load(?x, "riscv_calls", NONE)) { ret 2; }
    fin { teardown(?x); }
    val at: opt[id.Function] = nth(?x, 0);
    if (sel at.none) { ret 3; }
    val got: res[Selected, Error] = selected_with(?x, at.some);
    if (sel got.err) { ret 4; }
    var out: Selected = got.ok;
    fin { engine.release(?out); }
    val clobbered: Slice[rf.Id] = x.mc.convention.clobbered;
    if (clobbered.size == 0) { ret 5; }
    var calls: usize = 0;
    var k:     usize = 0;
    for (k < out.function.instructions.len) {
        val i: Instruction = Instruction{index: k::u32};
        if (mi.transfer(mf.file(?out.function), mf.data(?out.function, i)).transfer == effect.CALL) {
            # every clobbered register of the convention, in its order, at this call
            var seen: usize = 0;
            var c:    usize = 0;
            for (c < out.clobbers.len) {
                val k2: Clobber = out.clobbers.data[c];
                if (k2.instruction.index == i.index) {
                    if (seen >= clobbered.size) { ret 6; }
                    val want: res[u32, location.Unlocated] = location.locate(?x.at, Physical.register{clobbered.data[seen]});
                    if (sel want.err)           { ret 7; }
                    if (want.ok != k2.location) { ret 8; }
                    seen = seen + 1;
                }
                c = c + 1;
            }
            if (seen != clobbered.size) { ret 9; }
            calls = calls + 1;
        }
        k = k + 1;
    }
    if (calls != 2 || out.clobbers.len != 2 * clobbered.size) { ret 10; }
    ret 0;
}

#[testing]
val TLS_LOCAL_EXEC:      str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls local_exec = i64 0\nfunction @__tls_get_addr: fun(ptr) -> (ptr) linkage global visibility default\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret.placed places []\n}\n";
#[testing]
val TLS_INITIAL_EXEC:    str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls initial_exec = i64 0\nfunction @__tls_get_addr: fun(ptr) -> (ptr) linkage global visibility default\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret.placed places []\n}\n";
#[testing]
val TLS_LOCAL_DYNAMIC:   str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls local_dynamic = i64 0\nfunction @__tls_get_addr: fun(ptr) -> (ptr) linkage global visibility default\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret.placed places []\n}\n";
#[testing]
val TLS_GENERAL_DYNAMIC: str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls general_dynamic = i64 0\nfunction @__tls_get_addr: fun(ptr) -> (ptr) linkage global visibility default\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret.placed places []\n}\n";

#[testing]
val TLS_TEXTS:  [4]str = [4]str{TLS_LOCAL_EXEC, TLS_INITIAL_EXEC, TLS_LOCAL_DYNAMIC, TLS_GENERAL_DYNAMIC};
#[testing]
val TLS_MODELS: [4]Tls = [4]Tls{Tls.local_exec{}, Tls.initial_exec{}, Tls.local_dynamic{}, Tls.general_dynamic{}};

# the instructions each access the target may declare selects to, none for one the table has no sequence for
#[testing]
val LOCAL_EXEC_SEQUENCE:      [3]str = [3]str{"lui", "add", "addi"};
#[testing]
val INITIAL_EXEC_SEQUENCE:    [3]str = [3]str{"auipc", "ld", "add"};
#[testing]
val GENERAL_DYNAMIC_SEQUENCE: [5]str = [5]str{"auipc", "addi", "auipc", "jalr", "addi"};

#[testing]
fun sequence(a: Access) Slice[str] {
    if (sel a.local_exec)      { ret Slice[str]{data: ?LOCAL_EXEC_SEQUENCE[0], size: 3}; }
    if (sel a.initial_exec)    { ret Slice[str]{data: ?INITIAL_EXEC_SEQUENCE[0], size: 3}; }
    if (sel a.general_dynamic) { ret Slice[str]{data: ?GENERAL_DYNAMIC_SEQUENCE[0], size: 5}; }
    ret Slice[str]{data: nil, size: 0};
}

# how a function of each binding and visibility of mink's rows is reached under
# each relocation model, defined by the module or declared. a declaration bound
# local breaks the linkage rule and has no row
# ---
# relocation: the model the code is built for
# defined:    the module defines the function
# binding:    its binding
# visibility: its visibility
# reach:      how its address is reached
#[testing]
rec Reached {
    relocation: Relocation;
    defined:    bool;
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
    reach:      Reach;
}

#[testing]
def Reaches: [84]Reached;

