#[testing]
def Models: [3]Relocation;

#[testing]
val MODELS: Models = [3]Relocation{Relocation.static{}, Relocation.pie{}, Relocation.pic{}};

#[testing]
fun same_model(a: Relocation, b: Relocation) bool {
    ret (sel a.static && sel b.static) || (sel a.pie && sel b.pie) || (sel a.pic && sel b.pic);
}

# the rows of the reach table that state one combination
#[testing]
fun rows_of(r: Relocation, defined: bool, b: *symbol.Binding, v: *symbol.Visibility) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < $length_of(Reaches)) {
        val row: Reached = REACHES[i];
        if (same_model(row.relocation, r) && row.defined == defined && row.binding == b && row.visibility == v) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the instructions each reach of an address selects to
#[testing]
val ABSOLUTE_PAIR: [2]str = [2]str{"lui", "addi"};
#[testing]
val RELATIVE_PAIR: [2]str = [2]str{"auipc", "addi"};
#[testing]
val TABLE_PAIR:    [2]str = [2]str{"auipc", "ld"};

#[testing]
fun pair_of(r: Reach) *str {
    if (sel r.absolute) { ret ?ABSOLUTE_PAIR[0]; }
    if (sel r.relative) { ret ?RELATIVE_PAIR[0]; }
    ret ?TABLE_PAIR[0];
}

# the text whose f stores the address of h, h defined or declared, its binding
# and visibility left to fill
#[testing]
val DEFINED_H:  str = "target \"riscv64-linux\"\nfunction @h: fun() -> () linkage {} visibility {} {{\n^entry:\n    ret\n}}\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {{\n^entry(%p: ptr):\n    store %p, ptr @h, align 8\n    ret.placed places []\n}}\n";
#[testing]
val DECLARED_H: str = "target \"riscv64-linux\"\nfunction @h: fun() -> () linkage {} visibility {}\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {{\n^entry(%p: ptr):\n    store %p, ptr @h, align 8\n    ret.placed places []\n}}\n";

# the reach table states each model, binding, visibility and definedness
# once, and the address of each function selects to the pair of its row's reach
test riscv__a_function_address_is_reached_as_its_linkage_and_model_state {
    var i:    usize = 0;
    var m:    usize = 0;
    var want: usize = 0;
    for (m < $length_of(Models)) {
        i = 0;
        for (i < symbol.binding_count()) {
            var k: usize = 0;
            for (k < symbol.visibility_count()) {
                val b: *symbol.Binding    = symbol.binding_at(i);
                val v: *symbol.Visibility = symbol.visibility_at(k);
                if (rows_of(MODELS[m], true, b, v) != 1) { ret 1; }
                want = want + 1;
                if (b != ?symbol.LOCAL) {
                    if (rows_of(MODELS[m], false, b, v) != 1) { ret 1; }
                    want = want + 1;
                }
                k = k + 1;
            }
            i = i + 1;
        }
        m = m + 1;
    }
    if (want != $length_of(Reaches)) { ret 1; }

    var a: allocator.Allocator;
    page.make(?a);
    i = 0;
    for (i < $length_of(Reaches)) {
        val row:  Reached = REACHES[i];
        var text: str     = DECLARED_H;
        if (row.defined) { text = DEFINED_H; }
        val made: res[str, format.FormatError] = format.sprint(?a, text, row.binding.name, row.visibility.name);
        if (sel made.err) { ret 2; }
        var x: Fixture;
        if (!read(?x, view_of(made.ok))) { ret 3; }
        x.copy = @x.target;
        if (!(sel x.copy.addresses.model)) { ret 4; }
        x.copy.addresses.model.relocation = row.relocation;
        x.target                          = ?x.copy;
        if (!open(?x, NONE)) { ret 5; }
        fin { teardown(?x); }
        val at: opt[id.Symbol] = module.find(?x.m, view_of("f"));
        if (sel at.none)        { ret 6; }
        if (sel at.some.global) { ret 6; }
        val got: res[mf.Function, Error] = selected(?x, at.some.function);
        if (sel got.err) {
            refusal(got.err);
            ret 7;
        }
        var f: mf.Function = got.ok;
        fin { mf.dnit(?f); }
        val pair: *str = pair_of(row.reach);
        # the entry's copy, the pair, the store and the return
        if (mf.instructions(?f, Block{index: 0}).size != 5) {
            diag.eprintlnf("row {}: {} instructions", i, mf.instructions(?f, Block{index: 0}).size);
            ret 8;
        }
        if (!str_equals(mnemonic_at(?f, 0, 1), pair[0]) || !str_equals(mnemonic_at(?f, 0, 2), pair[1])) {
            diag.eprintlnf("row {}: linkage {} visibility {}: {} and {}, not {} and {}", i, row.binding.name, row.visibility.name, mnemonic_at(?f, 0, 1), mnemonic_at(?f, 0, 2), pair[0], pair[1]);
            ret 9;
        }
        i = i + 1;
    }
    ret 0;
}

# one walk over the thread-local models of the ir: each selects the access
# sequence of the access the target declares for it, with its relocations
# and the lookup's call as the golden text holds them
test riscv__each_thread_local_model_selects_the_sequence_of_its_declared_access {
    if (matches("riscv_tls", NONE) != 0) { ret 1; }
    var k: usize = 0;
    for (k < 4) {
        var x: Fixture;
        if (!setup(?x, view_of(TLS_TEXTS[k]), NONE)) { ret 2; }
        fin { teardown(?x); }
        val model: Addresses = x.target.addresses;
        if (!(sel model.model)) { ret 3; }
        val want: Slice[str] = sequence(address.access(?model.model, TLS_MODELS[k]));
        if (want.size == 0) { ret 4; }
        val at: opt[id.Function] = nth(?x, 0);
        if (sel at.none) { ret 5; }
        val got: res[mf.Function, Error] = selected(?x, at.some);
        if (sel got.err) {
            refusal(got.err);
            ret 6;
        }
        var f: mf.Function = got.ok;
        fin { mf.dnit(?f); }
        # the entry's copy, the sequence, the store and the return
        if (mf.instructions(?f, Block{index: 0}).size != want.size + 3) { ret 7; }
        var i: usize = 0;
        for (i < want.size) {
            if (!str_equals(mnemonic_at(?f, 0, i + 1), want.data[i])) {
                diag.eprintlnf("model {}: instruction {} is not {}", k, i, want.data[i]);
                ret 8;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    ret 0;
}

#[testing]
val ROUNDED_MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# whether the fadd.s of a machine text, rounding by the mode `rm` names, is
# handed to masc as values whose implicit reads hold frm
#[testing]
fun reads_frm(text: str) res[bool, i32] {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(ROUNDED_MODULE));
    if (sel made.err) { ret res[bool, i32].err{1}; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val input: res[reader.Unit, Refusal] = reader.parse_body(?a, ?m, view_of(text));
    if (sel input.err) { ret res[bool, i32].err{2}; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val d:  *InstructionData = mf.data(?u.items.data[0].function, Instruction{index: 0});
    val op: mi.Opcode        = d.opcode;
    if (!(sel op.row)) { ret res[bool, i32].err{3}; }
    val frm: opt[rf.Id] = riscv_csr.state(?riscv_register.FILE, riscv_register.FRM::u32);
    if (sel frm.none) { ret res[bool, i32].err{4}; }
    var values: [row.MAX_OPERANDS]mo.Value;
    val read:   effect.Touched = effect.implicit(?riscv_register.FILE, op.row.effect, mi.values_of(op.row, d.operands, ?values[0]));
    ret res[bool, i32].ok{effect.has(?riscv_register.FILE, read.read, frm.some)};
}

#[testing]
val DYNAMIC_ROUNDING: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    fadd.s f1, f2, f3, 7\n    jalr x0, x1, 0\n}\n";

#[testing]
val NEAREST_ROUNDING: str = "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    fadd.s f1, f2, f3, 0\n    jalr x0, x1, 0\n}\n";

# the rounding mode is handed over as masc's enumerant, so the dynamic mode
# reads frm and a static one does not
test riscv__an_add_rounding_by_dyn_reads_frm {
    val got: res[bool, i32] = reads_frm(DYNAMIC_ROUNDING);
    if (sel got.err) { ret got.err; }
    if (!got.ok)     { ret 10; }
    ret 0;
}

test riscv__an_add_rounding_to_nearest_reads_no_frm {
    val got: res[bool, i32] = reads_frm(NEAREST_ROUNDING);
    if (sel got.err) { ret got.err; }
    if (got.ok)      { ret 10; }
    ret 0;
}

# every operation the base sets and F and D give no rule for: a multiply and a
# division at each width, and at each format a minimum, a maximum, the four
# integral roundings, a select of floats on a condition and a 64 bit float
# constant
#[testing]
val LACKING_64: str = "target \"riscv64-linux\"\nfunction @f: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %k = load %p, type i64, align 8\n    %q = lt.s %k, i64 0\n    %j = load %p, type i64, align 8\n    %w = load %p, type i32, align 4\n    %m1 = mul %k, %j\n    %m2 = mul %w, %w\n    %m3 = div.u %k, %j\n    store %p, %m1, align 8\n    store %p, %m2, align 4\n    store %p, %m3, align 8\n    %a = load %p, type binary32, align 4\n    %b = load %p, type binary32, align 4\n    %c = load %p, type binary64, align 8\n    %d = load %p, type binary64, align 8\n    %a1 = fmin %a, %b\n    %a2 = fmax %a, %b\n    %a3 = ffloor %a\n    %a4 = fceil %a\n    %a5 = fint %a\n    %a6 = fnearest %a\n    %a7 = select %q, %a, %b\n    store %p, %a1, align 4\n    store %p, %a2, align 4\n    store %p, %a3, align 4\n    store %p, %a4, align 4\n    store %p, %a5, align 4\n    store %p, %a6, align 4\n    store %p, %a7, align 4\n    %c1 = fmin %c, %d\n    %c2 = fmax %c, %d\n    %c3 = ffloor %c\n    %c4 = fceil %c\n    %c5 = fint %c\n    %c6 = fnearest %c\n    %c7 = select %q, %c, %d\n    %c8 = fadd %c, binary64 0x400921fb54442d18\n    store %p, %c1, align 8\n    store %p, %c2, align 8\n    store %p, %c3, align 8\n    store %p, %c4, align 8\n    store %p, %c5, align 8\n    store %p, %c6, align 8\n    store %p, %c7, align 8\n    store %p, %c8, align 8\n    ret\n}\n";

# the float operations on a 32 bit register in piece form, since no convention
# lowers a call there, the condition read from a 32 bit integer
#[testing]
val LACKING_32: str = "target \"riscv32-linux\"\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    %k = load %p, type i32, align 4\n    %q = lt.s %k, i32 0\n    %a = load %p, type binary32, align 4\n    %b = load %p, type binary32, align 4\n    %c = load %p, type binary64, align 8\n    %d = load %p, type binary64, align 8\n    %a1 = fmin %a, %b\n    %a2 = fmax %a, %b\n    %a3 = ffloor %a\n    %a4 = fceil %a\n    %a5 = fint %a\n    %a6 = fnearest %a\n    %a7 = select %q, %a, %b\n    store %p, %a1, align 4\n    store %p, %a2, align 4\n    store %p, %a3, align 4\n    store %p, %a4, align 4\n    store %p, %a5, align 4\n    store %p, %a6, align 4\n    store %p, %a7, align 4\n    %c1 = fmin %c, %d\n    %c2 = fmax %c, %d\n    %c3 = ffloor %c\n    %c4 = fceil %c\n    %c5 = fint %c\n    %c6 = fnearest %c\n    %c7 = select %q, %c, %d\n    %c8 = fadd %c, binary64 0x400921fb54442d18\n    store %p, %c1, align 8\n    store %p, %c2, align 8\n    store %p, %c3, align 8\n    store %p, %c4, align 8\n    store %p, %c5, align 8\n    store %p, %c6, align 8\n    store %p, %c7, align 8\n    store %p, %c8, align 8\n    ret.placed places []\n}\n";

#[testing]
val F_D_NAMES: [2]str = [2]str{"f", "d"};

#[testing]
val F_D: Slice[str] = Slice[str]{data: ?F_D_NAMES[0], size: 2};

# the legalisations that stand in for what the selection lacks, the lowering
# of the helpers' calls and entries, those that legalise the integers the
# stand ins are made of, and the loads of the float constants
#[testing]
val LEGALISE: [6]Row = [6]Row{
    Row{pass: ?HELPERS, verify: Verify.changed{}},
    Row{pass: ?ABI, verify: Verify.changed{}},
    Row{pass: ?FLOATS, verify: Verify.changed{}},
    Row{pass: ?NARROW, verify: Verify.changed{}},
    Row{pass: ?WIDE, verify: Verify.changed{}},
    Row{pass: ?POOL, verify: Verify.changed{}},
};

# legalise and select every function of a text for its target at a baseline
# with extensions added, reaching addresses as the riscv64 linux row does
#[testing]
fun legalised(text: str, baseline: str, added: Slice[str]) u32 {
    var a: allocator.Allocator;
    page.make(?a);
    val parsed: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(text));
    if (sel parsed.err) { ret 1; }
    var m: Module = parsed.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(m.target);
    if (sel row.none) { ret 2; }
    var t: Target = @row.some;
    t.baseline  = Baseline.extensions{baseline};
    t.addresses = targets.RV64_LINUX.addresses;
    # a target that declares no convention has a selection and no machine
    var mc:     Machine;
    var basis:  Basis;
    var held:   opt[*Machine]      = opt[*Machine].none{};
    val opened: err[machine.Error] = machine.open_with(?mc, ?a, ?t, added);
    if (sel opened.err) {
        val why: machine.Error = opened.err;
        if (!(sel why.convention)) { ret 3; }
        val chosen: err[machine.Error] = machine.choose(?basis, ?a, ?t, added);
        if (sel chosen.err) { ret 3; }
    }
    or { held = opt[*Machine].some{?mc}; }
    fin {
        if (sel held.some) { machine.close(?mc); }
        or                 { machine.drop(?basis); }
    }
    # with no machine there is no convention, and the text is in piece form
    var rows: Slice[Row] = Slice[Row]{data: ?LEGALISE[0], size: 6};
    if (sel held.none) { rows = Slice[Row]{data: ?LEGALISE[2], size: 4}; }
    val ran: err[pass_failure.Error] = driver.drive(?m, ?t, held, rows, Options{level: 0, checked: true});
    if (sel ran.err) { ret 4; }
    var selection: *extension.Selection = ?basis.selection;
    if (sel held.some) { selection = ?mc.basis.selection; }
    val made: res[Selector, Error] = engine.init(?a, ?rules.TABLE, ?t, ?riscv_set.SET, selection);
    if (sel made.err) { ret 5; }
    var s: Selector = made.ok;
    fin { engine.dnit(?s); }
    val at: res[Locations, location.Error] = location.init(?a, ?riscv_register.FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel at.err) { ret 6; }
    var places: Locations = at.ok;
    fin { location.dnit(?places); }
    var k: usize = 0;
    for (k < m.functions.len) {
        if (m.functions.data[k].body.blocks.len > 0) {
            var calls: Calls = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?places};
            if (sel held.some) { calls.clobbered = mc.convention.clobbered; }
            val got: res[Selected, Error] = engine.select(?s, ?m, id.Function{index: k::u32}, ?calls);
            if (sel got.err) {
                refusal(got.err);
                ret 7;
            }
            var out: Selected = got.ok;
            engine.release(?out);
        }
        k = k + 1;
    }
    ret 0;
}

# with no m, a multiply and a division select at rv64i through helpers, and
# with no zfa, a minimum, a maximum, the integral roundings and a select of
# floats select from F and D at rv64i and rv32i, and so does a 64 bit float
# constant on rv32
test riscv__what_the_extensions_lack_selects_at_the_base_sets {
    if (legalised(LACKING_64, "rv64i", F_D) != 0) { ret 1; }
    val narrow: u32 = legalised(LACKING_32, "rv32i", F_D);
    if (narrow != 0) { ret (10 + narrow)::i32; }
    ret 0;
}
