# the masc rows the table emits, named once
#
# a name is a row of masc's generated catalog, found by position. the walk in
# the table's test checks every name against the mnemonic and width it stands
# for, so a regenerated catalog that moves a row is a failing test and never a
# silently different instruction.

use std.types.string.str;

use masc.core.row.Row;
use masc.isa.riscv.gen_row;

