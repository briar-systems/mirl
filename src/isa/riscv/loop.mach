# the RISC-V loops: the read-modify-writes no instruction does, each a
# load-reserved and store-conditional pair
#
# a body is the reserved pair and the base integer instructions between
# them, with no load, store or taken backward branch inside the reserved
# region but the body's own branch back, so it keeps the forward progress
# rules of the A extension. each is sequentially consistent: the load
# reserved acquires and releases, and the store conditional releases. a
# store conditional writes 0 to its destination when it stores, so the body
# runs again while that register is nonzero.

use mo: masc.core.operand;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;

use mirl.machine.loop.row.Loop;
use mirl.machine.loop.row.Loops;
use mirl.machine.loop.row.NO_PARTS;
use mirl.machine.loop.row.Parts;
use mirl.machine.loop.row.Roles;
use mirl.machine.loop.row.Source;
use mirl.machine.loop.row.Sources;
use mirl.machine.loop.row.Step;
use mirl.machine.loop.row.Steps;

# the order of a load reserved that acquires and releases, and of a store conditional that releases
val AQRL: i64 = 3;
val RL:   i64 = 1;

val TO:   [2]Source = [2]Source{Source.fixed{gen_register.X0}, Source.target{}};
val JUMP: Step      = Step{row: gen_row.JAL, operands: Sources{at: ?TO[0], len: 2}};

# nand: the value held before, the address, the operand and a scratch register
val NAND_ROLES: [4]mo.Role = [4]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.WRITE};

val NAND_LOAD:   [3]Source = [3]Source{Source.operand{0}, Source.operand{1}, Source.literal{AQRL}};
val NAND_AND:    [3]Source = [3]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}};
val NAND_NOT:    [3]Source = [3]Source{Source.operand{3}, Source.operand{3}, Source.literal{-1}};
val NAND_STORE:  [4]Source = [4]Source{Source.operand{3}, Source.operand{1}, Source.operand{3}, Source.literal{RL}};
val NAND_REPEAT: [3]Source = [3]Source{Source.operand{3}, Source.fixed{gen_register.X0}, Source.head{}};

val NAND_W_STEPS: [5]Step = [5]Step{
    Step{row: gen_row.LR_W, operands: Sources{at: ?NAND_LOAD[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?NAND_AND[0], len: 3}},
    Step{row: gen_row.XORI, operands: Sources{at: ?NAND_NOT[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?NAND_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?NAND_REPEAT[0], len: 3}},
};

val NAND_D_STEPS: [5]Step = [5]Step{
    Step{row: gen_row.LR_D, operands: Sources{at: ?NAND_LOAD[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?NAND_AND[0], len: 3}},
    Step{row: gen_row.XORI, operands: Sources{at: ?NAND_NOT[0], len: 3}},
    Step{row: gen_row.SC_D, operands: Sources{at: ?NAND_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?NAND_REPEAT[0], len: 3}},
};

val NAND_W_BODY: [1]Steps = [1]Steps{Steps{at: ?NAND_W_STEPS[0], len: 5}};
val NAND_D_BODY: [1]Steps = [1]Steps{Steps{at: ?NAND_D_STEPS[0], len: 5}};

# the and of the value held and the operand, inverted and stored, of a word
pub val NAND_W: Loop = Loop{name: "nand_w", roles: Roles{at: ?NAND_ROLES[0], len: 4}, before: NO_PARTS, body: Parts{at: ?NAND_W_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# the and of the value held and the operand, inverted and stored, of a doubleword
pub val NAND_D: Loop = Loop{name: "nand_d", roles: Roles{at: ?NAND_ROLES[0], len: 4}, before: NO_PARTS, body: Parts{at: ?NAND_D_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# compare and exchange: the value held before, the address, the value
# expected, the value stored when it is held, and a scratch register
val CMPXCHG_ROLES: [5]mo.Role = [5]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.READ, mo.WRITE};

val CMPXCHG_LOAD:   [3]Source = [3]Source{Source.operand{0}, Source.operand{1}, Source.literal{AQRL}};
val CMPXCHG_DIFFER: [3]Source = [3]Source{Source.operand{0}, Source.operand{2}, Source.exit{}};
val CMPXCHG_STORE:  [4]Source = [4]Source{Source.operand{4}, Source.operand{1}, Source.operand{3}, Source.literal{RL}};
val CMPXCHG_REPEAT: [3]Source = [3]Source{Source.operand{4}, Source.fixed{gen_register.X0}, Source.head{}};

val CMPXCHG_W_STEPS: [4]Step = [4]Step{
    Step{row: gen_row.LR_W, operands: Sources{at: ?CMPXCHG_LOAD[0], len: 3}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_DIFFER[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?CMPXCHG_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_REPEAT[0], len: 3}},
};

val CMPXCHG_D_STEPS: [4]Step = [4]Step{
    Step{row: gen_row.LR_D, operands: Sources{at: ?CMPXCHG_LOAD[0], len: 3}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_DIFFER[0], len: 3}},
    Step{row: gen_row.SC_D, operands: Sources{at: ?CMPXCHG_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_REPEAT[0], len: 3}},
};

val CMPXCHG_W_BODY: [1]Steps = [1]Steps{Steps{at: ?CMPXCHG_W_STEPS[0], len: 4}};
val CMPXCHG_D_BODY: [1]Steps = [1]Steps{Steps{at: ?CMPXCHG_D_STEPS[0], len: 4}};

# a word stored only where the one held is the one expected, which leaves
# the body for the block after it as soon as they differ
pub val CMPXCHG_W: Loop = Loop{name: "cmpxchg_w", roles: Roles{at: ?CMPXCHG_ROLES[0], len: 5}, before: NO_PARTS, body: Parts{at: ?CMPXCHG_W_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# a doubleword stored only where the one held is the one expected
pub val CMPXCHG_D: Loop = Loop{name: "cmpxchg_d", roles: Roles{at: ?CMPXCHG_ROLES[0], len: 5}, before: NO_PARTS, body: Parts{at: ?CMPXCHG_D_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

val LIST: [4]*Loop = [4]*Loop{?NAND_W, ?NAND_D, ?CMPXCHG_W, ?CMPXCHG_D};

# the RISC-V loops
pub val LOOPS: Loops = Loops{at: ?LIST[0], len: 4};
