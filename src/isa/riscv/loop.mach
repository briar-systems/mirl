# the RISC-V loops: the read-modify-writes no instruction does, each a
# load-reserved and store-conditional pair
#
# a body is the reserved pair and the base integer instructions between
# them, with no load, store or taken backward branch inside the reserved
# region but the body's own branch back, so it keeps the forward progress
# rules of the A extension, which CONSTRAINT states and the loop check holds
# every body to. each is sequentially consistent: the load
# reserved acquires and releases, and the store conditional releases. a
# store conditional writes 0 to its destination when it stores, so the body
# runs again while that register is nonzero.
#
# an operation on a field narrower than a word, an i8 or i16 with no direct
# narrow instruction admitted, works on the aligned word holding it. every
# such loop shares its operand positions, the steps that find the field and
# the steps that give it back:
#
#   0  the word held, then the field it held, sign extended, written
#   1  the address of the field, read
#   2  the operand, or the value a compare and exchange expects, read
#   3  the width of the field in bits, a parameter
#   4  the width of the register in bits, a parameter
#   5  the address of the aligned word, written
#   6  the field's shift within the word, written
#   7  the mask of the field within the word, written
#   8  the operand shifted to the field and masked, written
#   9  a scratch register, written
#  10  a second scratch register of a minimum or maximum, or the value a
#      compare and exchange stores, read
#
# the shifts are by register, so a step's row is one row at either register
# width, and the register width enters only as a parameter. the operand is
# held sign extended, as every narrow integer is, and the field given back is
# sign extended from its width.

use mo: masc.core.operand;
use masc.core.requirement;
use riscv_extension: masc.isa.riscv.extension;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;

use mirl.machine.loop.row.Constraint;
use mirl.machine.loop.row.Formula;
use mirl.machine.loop.row.Loop;
use mirl.machine.loop.row.Loops;
use mirl.machine.loop.row.NO_PARTS;
use mirl.machine.loop.row.Parts;
use mirl.machine.loop.row.Roles;
use mirl.machine.loop.row.Source;
use mirl.machine.loop.row.Sources;
use mirl.machine.loop.row.Step;
use mirl.machine.loop.row.Steps;
use mirl.machine.loop.row.Term;

# the order of a load reserved that acquires and releases, and of a store conditional that releases
val AQRL: i64 = 3;
val RL:   i64 = 1;

val TO:   [2]Source = [2]Source{Source.fixed{gen_register.X0}, Source.target{}};
val JUMP: Step      = Step{row: gen_row.JAL, operands: Sources{at: ?TO[0], len: 2}};

# nand: the value held before, the address, the operand and a scratch register
val NAND_ROLES: [4]mo.Role = [4]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.WRITE};

val NAND_LOAD:   [3]Source = [3]Source{Source.operand{0}, Source.operand{1}, Source.literal{AQRL}};
val NAND_AND:    [3]Source = [3]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}};
val NAND_NOT:    [3]Source = [3]Source{Source.operand{3}, Source.operand{3}, Source.literal{-1}};
val NAND_STORE:  [4]Source = [4]Source{Source.operand{3}, Source.operand{1}, Source.operand{3}, Source.literal{RL}};
val NAND_REPEAT: [3]Source = [3]Source{Source.operand{3}, Source.fixed{gen_register.X0}, Source.head{}};

val NAND_W_STEPS: [5]Step = [5]Step{
    Step{row: gen_row.LR_W, operands: Sources{at: ?NAND_LOAD[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?NAND_AND[0], len: 3}},
    Step{row: gen_row.XORI, operands: Sources{at: ?NAND_NOT[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?NAND_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?NAND_REPEAT[0], len: 3}},
};

val NAND_D_STEPS: [5]Step = [5]Step{
    Step{row: gen_row.LR_D, operands: Sources{at: ?NAND_LOAD[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?NAND_AND[0], len: 3}},
    Step{row: gen_row.XORI, operands: Sources{at: ?NAND_NOT[0], len: 3}},
    Step{row: gen_row.SC_D, operands: Sources{at: ?NAND_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?NAND_REPEAT[0], len: 3}},
};

val NAND_W_BODY: [1]Steps = [1]Steps{Steps{at: ?NAND_W_STEPS[0], len: 5}};
val NAND_D_BODY: [1]Steps = [1]Steps{Steps{at: ?NAND_D_STEPS[0], len: 5}};

# the and of the value held and the operand, inverted and stored, of a word
pub val NAND_W: Loop = Loop{name: "nand_w", roles: Roles{at: ?NAND_ROLES[0], len: 4}, before: NO_PARTS, body: Parts{at: ?NAND_W_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# the and of the value held and the operand, inverted and stored, of a doubleword
pub val NAND_D: Loop = Loop{name: "nand_d", roles: Roles{at: ?NAND_ROLES[0], len: 4}, before: NO_PARTS, body: Parts{at: ?NAND_D_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# compare and exchange: the value held before, the address, the value
# expected, the value stored when it is held, and a scratch register
val CMPXCHG_ROLES: [5]mo.Role = [5]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.READ, mo.WRITE};

val CMPXCHG_LOAD:   [3]Source = [3]Source{Source.operand{0}, Source.operand{1}, Source.literal{AQRL}};
val CMPXCHG_DIFFER: [3]Source = [3]Source{Source.operand{0}, Source.operand{2}, Source.exit{}};
val CMPXCHG_STORE:  [4]Source = [4]Source{Source.operand{4}, Source.operand{1}, Source.operand{3}, Source.literal{RL}};
val CMPXCHG_REPEAT: [3]Source = [3]Source{Source.operand{4}, Source.fixed{gen_register.X0}, Source.head{}};

val CMPXCHG_W_STEPS: [4]Step = [4]Step{
    Step{row: gen_row.LR_W, operands: Sources{at: ?CMPXCHG_LOAD[0], len: 3}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_DIFFER[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?CMPXCHG_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_REPEAT[0], len: 3}},
};

val CMPXCHG_D_STEPS: [4]Step = [4]Step{
    Step{row: gen_row.LR_D, operands: Sources{at: ?CMPXCHG_LOAD[0], len: 3}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_DIFFER[0], len: 3}},
    Step{row: gen_row.SC_D, operands: Sources{at: ?CMPXCHG_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CMPXCHG_REPEAT[0], len: 3}},
};

val CMPXCHG_W_BODY: [1]Steps = [1]Steps{Steps{at: ?CMPXCHG_W_STEPS[0], len: 4}};
val CMPXCHG_D_BODY: [1]Steps = [1]Steps{Steps{at: ?CMPXCHG_D_STEPS[0], len: 4}};

# a word stored only where the one held is the one expected, which leaves
# the body for the block after it as soon as they differ
pub val CMPXCHG_W: Loop = Loop{name: "cmpxchg_w", roles: Roles{at: ?CMPXCHG_ROLES[0], len: 5}, before: NO_PARTS, body: Parts{at: ?CMPXCHG_W_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# a doubleword stored only where the one held is the one expected
pub val CMPXCHG_D: Loop = Loop{name: "cmpxchg_d", roles: Roles{at: ?CMPXCHG_ROLES[0], len: 5}, before: NO_PARTS, body: Parts{at: ?CMPXCHG_D_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

# the operand positions of a loop on a field, as the header lists them
val WORD:    u8 = 0;
val ADDRESS: u8 = 1;
val VALUE:   u8 = 2;
val WIDTH:   u8 = 3;
val XLEN:    u8 = 4;
val ALIGNED: u8 = 5;
val SHIFT:   u8 = 6;
val MASK:    u8 = 7;
val SHIFTED: u8 = 8;
val SCRATCH: u8 = 9;
val OTHER:   u8 = 10;

# the bits above a field in a register: its width less the field's
val ABOVE: Formula = Formula{terms: [2]Term{Term{parameter: XLEN, scale: 1}, Term{parameter: WIDTH, scale: -1}}, offset: 0};

val FIELD_ROLES:   [10]mo.Role = [10]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.NONE, mo.NONE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE};
val CHOICE_ROLES:  [11]mo.Role = [11]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.NONE, mo.NONE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE};
val COMPARE_ROLES: [11]mo.Role = [11]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.NONE, mo.NONE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE, mo.WRITE, mo.READ};

# the aligned word, the shift of the field as its byte offset times eight,
# its mask as the low width bits shifted there, and the operand shifted and masked
val ALIGN:       [3]Source = [3]Source{Source.operand{ALIGNED}, Source.operand{ADDRESS}, Source.literal{-4}};
val OFFSET:      [3]Source = [3]Source{Source.operand{SHIFT}, Source.operand{ADDRESS}, Source.literal{3}};
val THREE:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.fixed{gen_register.X0}, Source.literal{3}};
val BYTES:       [3]Source = [3]Source{Source.operand{SHIFT}, Source.operand{SHIFT}, Source.operand{SCRATCH}};
val ONES:        [3]Source = [3]Source{Source.operand{MASK}, Source.fixed{gen_register.X0}, Source.literal{-1}};
val ABOVE_IN:    [3]Source = [3]Source{Source.operand{SCRATCH}, Source.fixed{gen_register.X0}, Source.formula{ABOVE}};
val LOW:         [3]Source = [3]Source{Source.operand{MASK}, Source.operand{MASK}, Source.operand{SCRATCH}};
val PLACE_MASK:  [3]Source = [3]Source{Source.operand{MASK}, Source.operand{MASK}, Source.operand{SHIFT}};
val PLACE_VALUE: [3]Source = [3]Source{Source.operand{SHIFTED}, Source.operand{VALUE}, Source.operand{SHIFT}};
val KEEP_VALUE:  [3]Source = [3]Source{Source.operand{SHIFTED}, Source.operand{SHIFTED}, Source.operand{MASK}};

val FIND_STEPS: [10]Step = [10]Step{
    Step{row: gen_row.ANDI, operands: Sources{at: ?ALIGN[0], len: 3}},
    Step{row: gen_row.ANDI, operands: Sources{at: ?OFFSET[0], len: 3}},
    Step{row: gen_row.ADDI, operands: Sources{at: ?THREE[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?BYTES[0], len: 3}},
    Step{row: gen_row.ADDI, operands: Sources{at: ?ONES[0], len: 3}},
    Step{row: gen_row.ADDI, operands: Sources{at: ?ABOVE_IN[0], len: 3}},
    Step{row: gen_row.SRL, operands: Sources{at: ?LOW[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?PLACE_MASK[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?PLACE_VALUE[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?KEEP_VALUE[0], len: 3}},
};

# the field the word held, shifted down, then up to the top and back down sign extended
val DOWN:       [3]Source = [3]Source{Source.operand{WORD}, Source.operand{WORD}, Source.operand{SHIFT}};
val TO_TOP:     [3]Source = [3]Source{Source.operand{WORD}, Source.operand{WORD}, Source.operand{SCRATCH}};
val GIVE_STEPS: [4]Step   = [4]Step{
    Step{row: gen_row.SRL, operands: Sources{at: ?DOWN[0], len: 3}},
    Step{row: gen_row.ADDI, operands: Sources{at: ?ABOVE_IN[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?TO_TOP[0], len: 3}},
    Step{row: gen_row.SRA, operands: Sources{at: ?TO_TOP[0], len: 3}},
};

val FIND: Steps = Steps{at: ?FIND_STEPS[0], len: 10};
val GIVE: Steps = Steps{at: ?GIVE_STEPS[0], len: 4};

# the word reserved
val RESERVE:       [3]Source = [3]Source{Source.operand{WORD}, Source.operand{ALIGNED}, Source.literal{AQRL}};
val RESERVE_STEPS: [1]Step   = [1]Step{Step{row: gen_row.LR_W, operands: Sources{at: ?RESERVE[0], len: 3}}};
val LOAD:          Steps     = Steps{at: ?RESERVE_STEPS[0], len: 1};

# the field of the scratch register merged into the word held and stored, again while the store fails
val MERGE_IN:     [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{WORD}, Source.operand{SCRATCH}};
val MERGE_MASK:   [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{MASK}};
val MERGE_STORE:  [4]Source = [4]Source{Source.operand{SCRATCH}, Source.operand{ALIGNED}, Source.operand{SCRATCH}, Source.literal{RL}};
val MERGE_REPEAT: [3]Source = [3]Source{Source.operand{SCRATCH}, Source.fixed{gen_register.X0}, Source.head{}};
val MERGE_STEPS:  [5]Step   = [5]Step{
    Step{row: gen_row.XOR, operands: Sources{at: ?MERGE_IN[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?MERGE_MASK[0], len: 3}},
    Step{row: gen_row.XOR, operands: Sources{at: ?MERGE_IN[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?MERGE_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?MERGE_REPEAT[0], len: 3}},
};
val MERGE: Steps = Steps{at: ?MERGE_STEPS[0], len: 5};

# the new field into the scratch register: the operand, the sum, the
# difference, or the inverted and
val COPY:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SHIFTED}, Source.literal{0}};
val COMBINE:    [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{WORD}, Source.operand{SHIFTED}};
val INVERT:     [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.literal{-1}};
val XCHG_STEPS: [1]Step   = [1]Step{Step{row: gen_row.ADDI, operands: Sources{at: ?COPY[0], len: 3}}};
val ADD_STEPS:  [1]Step   = [1]Step{Step{row: gen_row.ADD, operands: Sources{at: ?COMBINE[0], len: 3}}};
val SUB_STEPS:  [1]Step   = [1]Step{Step{row: gen_row.SUB, operands: Sources{at: ?COMBINE[0], len: 3}}};
val NAND_STEPS: [2]Step   = [2]Step{Step{row: gen_row.AND, operands: Sources{at: ?COMBINE[0], len: 3}}, Step{row: gen_row.XORI, operands: Sources{at: ?INVERT[0], len: 3}}};

# a minimum or maximum: 1 in the scratch register where the operand is
# chosen, made a mask of the field, which picks the operand's field into
# the word held, stored through the second scratch register
val FIELD_OF:      [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{WORD}, Source.operand{MASK}};
val BELOW_U:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{SHIFTED}};
val ABOVE_U:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SHIFTED}, Source.operand{SCRATCH}};
val TOP_IN:        [3]Source = [3]Source{Source.operand{OTHER}, Source.fixed{gen_register.X0}, Source.formula{ABOVE}};
val TOP_LESS:      [3]Source = [3]Source{Source.operand{OTHER}, Source.operand{OTHER}, Source.operand{SHIFT}};
val FIELD_UP:      [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{OTHER}};
val VALUE_UP:      [3]Source = [3]Source{Source.operand{OTHER}, Source.operand{SHIFTED}, Source.operand{OTHER}};
val BELOW_S:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{OTHER}};
val ABOVE_S:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{OTHER}, Source.operand{SCRATCH}};
val SPREAD:        [3]Source = [3]Source{Source.operand{SCRATCH}, Source.fixed{gen_register.X0}, Source.operand{SCRATCH}};
val CHOSEN_MASK:   [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{MASK}};
val DIFFER:        [3]Source = [3]Source{Source.operand{OTHER}, Source.operand{WORD}, Source.operand{SHIFTED}};
val PICK:          [3]Source = [3]Source{Source.operand{OTHER}, Source.operand{OTHER}, Source.operand{SCRATCH}};
val PICKED:        [3]Source = [3]Source{Source.operand{OTHER}, Source.operand{WORD}, Source.operand{OTHER}};
val CHOOSE_STORE:  [4]Source = [4]Source{Source.operand{OTHER}, Source.operand{ALIGNED}, Source.operand{OTHER}, Source.literal{RL}};
val CHOOSE_REPEAT: [3]Source = [3]Source{Source.operand{OTHER}, Source.fixed{gen_register.X0}, Source.head{}};

val UMAX_STEPS: [2]Step = [2]Step{Step{row: gen_row.AND, operands: Sources{at: ?FIELD_OF[0], len: 3}}, Step{row: gen_row.SLTU, operands: Sources{at: ?BELOW_U[0], len: 3}}};
val UMIN_STEPS: [2]Step = [2]Step{Step{row: gen_row.AND, operands: Sources{at: ?FIELD_OF[0], len: 3}}, Step{row: gen_row.SLTU, operands: Sources{at: ?ABOVE_U[0], len: 3}}};

# the field and the operand each shifted to the top of the register, so a
# signed comparison of the two is of the fields
val TOP_STEPS: [5]Step = [5]Step{
    Step{row: gen_row.AND, operands: Sources{at: ?FIELD_OF[0], len: 3}},
    Step{row: gen_row.ADDI, operands: Sources{at: ?TOP_IN[0], len: 3}},
    Step{row: gen_row.SUB, operands: Sources{at: ?TOP_LESS[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?FIELD_UP[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?VALUE_UP[0], len: 3}},
};
val SMAX_STEPS: [1]Step = [1]Step{Step{row: gen_row.SLT, operands: Sources{at: ?BELOW_S[0], len: 3}}};
val SMIN_STEPS: [1]Step = [1]Step{Step{row: gen_row.SLT, operands: Sources{at: ?ABOVE_S[0], len: 3}}};

val CHOOSE_STEPS: [7]Step = [7]Step{
    Step{row: gen_row.SUB, operands: Sources{at: ?SPREAD[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?CHOSEN_MASK[0], len: 3}},
    Step{row: gen_row.XOR, operands: Sources{at: ?DIFFER[0], len: 3}},
    Step{row: gen_row.AND, operands: Sources{at: ?PICK[0], len: 3}},
    Step{row: gen_row.XOR, operands: Sources{at: ?PICKED[0], len: 3}},
    Step{row: gen_row.SC_W, operands: Sources{at: ?CHOOSE_STORE[0], len: 4}},
    Step{row: gen_row.BNE, operands: Sources{at: ?CHOOSE_REPEAT[0], len: 3}},
};
val CHOOSE: Steps = Steps{at: ?CHOOSE_STEPS[0], len: 7};
val TOP:    Steps = Steps{at: ?TOP_STEPS[0], len: 5};

# a compare and exchange: out of the body as soon as the field held is not
# the one expected, the value stored shifted to the field
val FIELD_DIFFERS: [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SHIFTED}, Source.exit{}};
val NEW_IN:        [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{OTHER}, Source.operand{SHIFT}};
val EXPECT_STEPS:  [3]Step   = [3]Step{
    Step{row: gen_row.AND, operands: Sources{at: ?FIELD_OF[0], len: 3}},
    Step{row: gen_row.BNE, operands: Sources{at: ?FIELD_DIFFERS[0], len: 3}},
    Step{row: gen_row.SLL, operands: Sources{at: ?NEW_IN[0], len: 3}},
};

# an and, or or exclusive or of the word, its operand the shifted one, with
# every bit outside the field set for the and, so one instruction does it
val OUTSIDE:    [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{MASK}, Source.literal{-1}};
val WITH:       [3]Source = [3]Source{Source.operand{SCRATCH}, Source.operand{SCRATCH}, Source.operand{SHIFTED}};
val AND_WORD:   [4]Source = [4]Source{Source.operand{WORD}, Source.operand{ALIGNED}, Source.operand{SCRATCH}, Source.literal{AQRL}};
val OTHER_WORD: [4]Source = [4]Source{Source.operand{WORD}, Source.operand{ALIGNED}, Source.operand{SHIFTED}, Source.literal{AQRL}};
val AND_STEPS:  [3]Step   = [3]Step{
    Step{row: gen_row.XORI, operands: Sources{at: ?OUTSIDE[0], len: 3}},
    Step{row: gen_row.OR, operands: Sources{at: ?WITH[0], len: 3}},
    Step{row: gen_row.AMOAND_W, operands: Sources{at: ?AND_WORD[0], len: 4}},
};
val OR_STEPS:  [1]Step = [1]Step{Step{row: gen_row.AMOOR_W, operands: Sources{at: ?OTHER_WORD[0], len: 4}}};
val XOR_STEPS: [1]Step = [1]Step{Step{row: gen_row.AMOXOR_W, operands: Sources{at: ?OTHER_WORD[0], len: 4}}};

val FOUND:        [1]Steps = [1]Steps{FIND};
val GIVEN:        [1]Steps = [1]Steps{GIVE};
val XCHG_BODY:    [3]Steps = [3]Steps{LOAD, Steps{at: ?XCHG_STEPS[0], len: 1}, MERGE};
val ADD_BODY:     [3]Steps = [3]Steps{LOAD, Steps{at: ?ADD_STEPS[0], len: 1}, MERGE};
val SUB_BODY:     [3]Steps = [3]Steps{LOAD, Steps{at: ?SUB_STEPS[0], len: 1}, MERGE};
val NAND_BODY:    [3]Steps = [3]Steps{LOAD, Steps{at: ?NAND_STEPS[0], len: 2}, MERGE};
val UMAX_BODY:    [3]Steps = [3]Steps{LOAD, Steps{at: ?UMAX_STEPS[0], len: 2}, CHOOSE};
val UMIN_BODY:    [3]Steps = [3]Steps{LOAD, Steps{at: ?UMIN_STEPS[0], len: 2}, CHOOSE};
val SMAX_BODY:    [4]Steps = [4]Steps{LOAD, TOP, Steps{at: ?SMAX_STEPS[0], len: 1}, CHOOSE};
val SMIN_BODY:    [4]Steps = [4]Steps{LOAD, TOP, Steps{at: ?SMIN_STEPS[0], len: 1}, CHOOSE};
val CMPXCHG_BODY: [3]Steps = [3]Steps{LOAD, Steps{at: ?EXPECT_STEPS[0], len: 3}, MERGE};
val AND_BEFORE:   [2]Steps = [2]Steps{FIND, Steps{at: ?AND_STEPS[0], len: 3}};
val OR_BEFORE:    [2]Steps = [2]Steps{FIND, Steps{at: ?OR_STEPS[0], len: 1}};
val XOR_BEFORE:   [2]Steps = [2]Steps{FIND, Steps{at: ?XOR_STEPS[0], len: 1}};

val FIELD:   Roles = Roles{at: ?FIELD_ROLES[0], len: 10};
val CHOICE:  Roles = Roles{at: ?CHOICE_ROLES[0], len: 11};
val COMPARE: Roles = Roles{at: ?COMPARE_ROLES[0], len: 11};
val FINDS:   Parts = Parts{at: ?FOUND[0], len: 1};
val GIVES:   Parts = Parts{at: ?GIVEN[0], len: 1};

# the operand stored to a field
pub val FIELD_XCHG: Loop = Loop{name: "field_xchg", roles: FIELD, before: FINDS, body: Parts{at: ?XCHG_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the sum of the field and the operand stored to it
pub val FIELD_ADD: Loop = Loop{name: "field_add", roles: FIELD, before: FINDS, body: Parts{at: ?ADD_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the field less the operand stored to it
pub val FIELD_SUB: Loop = Loop{name: "field_sub", roles: FIELD, before: FINDS, body: Parts{at: ?SUB_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the and of the field and the operand, inverted, stored to it
pub val FIELD_NAND: Loop = Loop{name: "field_nand", roles: FIELD, before: FINDS, body: Parts{at: ?NAND_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the unsigned greater of the field and the operand stored to it
pub val FIELD_UMAX: Loop = Loop{name: "field_umax", roles: CHOICE, before: FINDS, body: Parts{at: ?UMAX_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the unsigned lesser of the field and the operand stored to it
pub val FIELD_UMIN: Loop = Loop{name: "field_umin", roles: CHOICE, before: FINDS, body: Parts{at: ?UMIN_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the signed greater of the field and the operand stored to it
pub val FIELD_SMAX: Loop = Loop{name: "field_smax", roles: CHOICE, before: FINDS, body: Parts{at: ?SMAX_BODY[0], len: 4}, after: GIVES, jump: JUMP};

# the signed lesser of the field and the operand stored to it
pub val FIELD_SMIN: Loop = Loop{name: "field_smin", roles: CHOICE, before: FINDS, body: Parts{at: ?SMIN_BODY[0], len: 4}, after: GIVES, jump: JUMP};

# the value at position 10 stored to the field only where the field holds
# the one expected, leaving the body as soon as it does not
pub val FIELD_CMPXCHG: Loop = Loop{name: "field_cmpxchg", roles: COMPARE, before: FINDS, body: Parts{at: ?CMPXCHG_BODY[0], len: 3}, after: GIVES, jump: JUMP};

# the and of the field and the operand by one and of the word, a straight sequence
pub val FIELD_AND: Loop = Loop{name: "field_and", roles: FIELD, before: Parts{at: ?AND_BEFORE[0], len: 2}, body: NO_PARTS, after: GIVES, jump: JUMP};

# the or of the field and the operand by one or of the word, a straight sequence
pub val FIELD_OR: Loop = Loop{name: "field_or", roles: FIELD, before: Parts{at: ?OR_BEFORE[0], len: 2}, body: NO_PARTS, after: GIVES, jump: JUMP};

# the exclusive or of the field and the operand by one of the word, a straight sequence
pub val FIELD_XOR: Loop = Loop{name: "field_xor", roles: FIELD, before: Parts{at: ?XOR_BEFORE[0], len: 2}, body: NO_PARTS, after: GIVES, jump: JUMP};

val LIST: [16]*Loop = [16]*Loop{?NAND_W, ?NAND_D, ?CMPXCHG_W, ?CMPXCHG_D, ?FIELD_XCHG, ?FIELD_ADD, ?FIELD_SUB, ?FIELD_NAND, ?FIELD_UMAX, ?FIELD_UMIN, ?FIELD_SMAX, ?FIELD_SMIN, ?FIELD_CMPXCHG, ?FIELD_AND, ?FIELD_OR, ?FIELD_XOR};

# the constrained lr and sc loop of the A extension, whose eventual success a
# core guarantees: sixteen instructions at most, the base integer rows of
# either register width between the pair, and the pair the rows of Zalrsc
val PLAIN:    [4]requirement.Id = [4]requirement.Id{riscv_extension.RV32, riscv_extension.RV64, riscv_extension.I, riscv_extension.E};
val RESERVED: [3]requirement.Id = [3]requirement.Id{riscv_extension.RV32, riscv_extension.RV64, riscv_extension.ZALRSC};

pub val CONSTRAINT: Constraint = Constraint{limit: 16, plain: requirement.Ids{at: ?PLAIN[0], len: 4}, reserved: requirement.Ids{at: ?RESERVED[0], len: 3}};

# the RISC-V loops
pub val LOOPS: Loops = Loops{at: ?LIST[0], len: 16, constraint: CONSTRAINT};
