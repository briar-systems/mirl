# the guards and derived immediates the RISC-V table's rules need beyond a type test
#
# a hook reads the values of instructions the verifier accepted, so a read the
# module or its type table refuses means a corrupted module, and the hook then
# says its guard does not hold. the engine names the instruction unmatched.
# the register width is read from the target's declarations and never from its
# name, and every fact about an operand is read through the match.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use types: mirl.ir.type;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.capability.Bits;
use mirl.target.capability.Set;

fun register(mt: *Match) u32 {
    val b: Bits = mt.target.caps.widths.register;
    if (sel b.bits) { ret b.bits; }
    ret 0;
}

# the register is 64 bits wide
pub fun xlen64(mt: *Match) bool {
    ret register(mt) == 64;
}

# the register is 32 bits wide
pub fun xlen32(mt: *Match) bool {
    ret register(mt) == 32;
}

# whether an operand is an integer constant of any width equal to n
fun operand_is(mt: *Match, node: u8, index: u8, n: u64) bool {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret false; }
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, v.some);
    if (sel got.err)                { ret false; }
    if (sel got.ok.none)            { ret false; }
    if (!(sel got.ok.some.integer)) { ret false; }
    val words: Slice[u64] = got.ok.some.integer.words;
    if (words.size == 0 || words.data[0] != n) { ret false; }
    var k: usize = 1;
    for (k < words.size) {
        if (words.data[k] != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the shift of a high multiply takes the product down by the register width
pub fun high_xlen64(mt: *Match) bool {
    ret xlen64(mt) && operand_is(mt, 1, 1, 64);
}

pub fun high_xlen32(mt: *Match) bool {
    ret xlen32(mt) && operand_is(mt, 1, 1, 32);
}

# the shift's count is below its operand's width, which the bounding marks
pub fun bounded_xlen64(mt: *Match) bool {
    ret xlen64(mt) && match.bounded(mt, 0);
}

pub fun bounded_xlen32(mt: *Match) bool {
    ret xlen32(mt) && match.bounded(mt, 0);
}

# the bits of an integer type, zero for any other type
fun width_of(mt: *Match, v: id.Value) u32 {
    val s: res[types.Shape, types.Error] = match.shape(mt, v);
    if (sel s.err)           { ret 0; }
    if (!(sel s.ok.integer)) { ret 0; }
    ret s.ok.integer.width;
}

fun operand_width(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret width_of(mt, v.some);
}

fun result_width(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.result(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret width_of(mt, v.some);
}

fun bits_of(mt: *Match, v: id.Value) opt[i64] {
    val b: res[opt[i64], match.Refusal] = match.bits(mt, v);
    if (sel b.err) { ret opt[i64].none{}; }
    ret b.ok;
}

# the bits of the constant an operand is, none when it is not one
fun operand_bits(mt: *Match, node: u8, index: u8) opt[i64] {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret opt[i64].none{}; }
    ret bits_of(mt, v.some);
}

# the bits of the constant a materialisation rule builds
fun subject_bits(mt: *Match) opt[i64] {
    ret bits_of(mt, mt.subject);
}

fun subject_width(mt: *Match) u32 {
    ret width_of(mt, mt.subject);
}

fun one_bit(x: u64) bool {
    ret x != 0 && (x & (x - 1)) == 0;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# whether an immediate position of twelve signed bits takes a value
fun fits12(c: i64) bool {
    ret c >= -2048 && c <= 2047;
}

# the register holds an integer operand 0 of 1 to 64 bits at most as wide as itself
pub fun narrow0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 1 && w <= register(mt);
}

pub fun narrow1(mt: *Match) bool {
    val w: u32 = operand_width(mt, 1, 0);
    ret w >= 1 && w <= register(mt);
}

# operand 0 is an integer of 2 bits or more that the register holds, which excludes a condition
pub fun narrow_word0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 2 && w <= register(mt);
}

pub fun narrow_word1(mt: *Match) bool {
    val w: u32 = operand_width(mt, 1, 0);
    ret w >= 2 && w <= register(mt);
}

pub fun narrow0_64(mt: *Match) bool {
    ret xlen64(mt) && narrow0(mt);
}

pub fun narrow0_32(mt: *Match) bool {
    ret xlen32(mt) && narrow0(mt);
}

# operand 0 is an integer of 2 to 32 bits
pub fun word0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 2 && w <= 32;
}

# the result is an integer the register holds
pub fun result_narrow(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w <= register(mt);
}

pub fun result_narrow_64(mt: *Match) bool {
    ret xlen64(mt) && result_narrow(mt);
}

pub fun result_narrow_32(mt: *Match) bool {
    ret xlen32(mt) && result_narrow(mt);
}

# the bits of the word the reserved pair lr.w and sc.w holds
val RESERVED: u32 = 32;

# whether the target states an integer width a value holds natively
fun stated(mt: *Match, w: u32) bool {
    val set: Set = mt.target.caps.widths.integers;
    if (!(sel set.widths)) { ret false; }
    var k: usize = 0;
    for (k < set.widths.size) {
        if (set.widths.data[k] == w) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the result is a field of the word the reserved pair holds: an integer of
# a width the target states, narrower than that word
pub fun field(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w < RESERVED && stated(mt, w);
}

# a sign extension of a value that is not a condition
pub fun ext_s_copy(mt: *Match) bool {
    ret operand_width(mt, 0, 0) >= 2 && result_narrow(mt);
}

# the offset of an address is a register or a 32 bit integer sign extended in one
pub fun offset(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 1);
    ret w == register(mt) || w == 32;
}

fun mul_pow2(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret c.some > 0 && one_bit(c.some::u64) && trailing(c.some::u64) < operand_width(mt, 0, 0)::i64;
}

# a constant of a power of two and one, above three
fun mul_pow2_plus(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret c.some > 3 && one_bit((c.some - 1)::u64) && trailing((c.some - 1)::u64) < operand_width(mt, 0, 0)::i64;
}

# a constant of a power of two less one, and not one a power of two and one
fun mul_pow2_minus(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret c.some > 1 && one_bit((c.some + 1)::u64) && !one_bit((c.some - 1)::u64) && trailing((c.some + 1)::u64) < operand_width(mt, 0, 0)::i64;
}

fun mul_by(mt: *Match, k: i64) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret c.some == k;
}

fun shift_by(mt: *Match, k: i64) bool {
    val c: opt[i64] = operand_bits(mt, 1, 1);
    if (sel c.none) { ret false; }
    ret c.some == k;
}

fun single_bit(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret one_bit(c.some::u64) && !fits12(c.some) && trailing(c.some::u64) < register(mt)::i64;
}

fun single_clear(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret one_bit((~c.some)::u64) && !fits12(c.some) && trailing((~c.some)::u64) < register(mt)::i64;
}

fun bit_test(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    ret c.some == 1;
}

# two shifts of one value that together turn it round its width
fun rotate(mt: *Match) bool {
    val a: opt[id.Value] = match.operand(mt, Slot{node: 1, index: 0});
    val b: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 0});
    if (sel a.none) { ret false; }
    if (sel b.none) { ret false; }
    val x: id.Value = a.some;
    val y: id.Value = b.some;
    if (x.index != y.index) { ret false; }
    val l: opt[i64] = operand_bits(mt, 1, 1);
    val r: opt[i64] = operand_bits(mt, 2, 1);
    if (sel l.none) { ret false; }
    if (sel r.none) { ret false; }
    val left:  i64 = l.some;
    val right: i64 = r.some;
    ret left > 0 && right > 0 && left + right == operand_width(mt, 1, 0)::i64;
}

pub fun mul_pow2_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2(mt);
}

pub fun mul_pow2_W32(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2(mt);
}

pub fun mul_pow2_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_pow2(mt);
}

pub fun mul_pow2_plus_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2_plus(mt);
}

pub fun mul_pow2_plus_W32(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2_plus(mt);
}

pub fun mul_pow2_plus_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_pow2_plus(mt);
}

pub fun mul_pow2_minus_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2_minus(mt);
}

pub fun mul_pow2_minus_W32(mt: *Match) bool {
    ret xlen64(mt) && mul_pow2_minus(mt);
}

pub fun mul_pow2_minus_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_pow2_minus(mt);
}

pub fun shadd1_N64(mt: *Match) bool {
    ret xlen64(mt) && shift_by(mt, 1);
}

pub fun mul_3_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_by(mt, 3);
}

pub fun shadd1_N32(mt: *Match) bool {
    ret xlen32(mt) && shift_by(mt, 1);
}

pub fun mul_3_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_by(mt, 3);
}

pub fun shadd2_N64(mt: *Match) bool {
    ret xlen64(mt) && shift_by(mt, 2);
}

pub fun mul_5_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_by(mt, 5);
}

pub fun shadd2_N32(mt: *Match) bool {
    ret xlen32(mt) && shift_by(mt, 2);
}

pub fun mul_5_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_by(mt, 5);
}

pub fun shadd3_N64(mt: *Match) bool {
    ret xlen64(mt) && shift_by(mt, 3);
}

pub fun mul_9_N64(mt: *Match) bool {
    ret xlen64(mt) && mul_by(mt, 9);
}

pub fun shadd3_N32(mt: *Match) bool {
    ret xlen32(mt) && shift_by(mt, 3);
}

pub fun mul_9_N32(mt: *Match) bool {
    ret xlen32(mt) && mul_by(mt, 9);
}

pub fun single_bit_N64(mt: *Match) bool {
    ret xlen64(mt) && single_bit(mt);
}

pub fun single_bit_N32(mt: *Match) bool {
    ret xlen32(mt) && single_bit(mt);
}

pub fun single_clear_N64(mt: *Match) bool {
    ret xlen64(mt) && single_clear(mt);
}

pub fun single_clear_N32(mt: *Match) bool {
    ret xlen32(mt) && single_clear(mt);
}

pub fun bit_test_N64(mt: *Match) bool {
    ret xlen64(mt) && bit_test(mt);
}

pub fun bit_test_N32(mt: *Match) bool {
    ret xlen32(mt) && bit_test(mt);
}

pub fun rotate_N64(mt: *Match) bool {
    ret xlen64(mt) && rotate(mt);
}

pub fun rotate_W32(mt: *Match) bool {
    ret xlen64(mt) && rotate(mt);
}

pub fun rotate_N32(mt: *Match) bool {
    ret xlen32(mt) && rotate(mt);
}

# constants: a number fits the immediate of a twelve bit add when its row says so, so
# these only choose among the longer sequences

fun fits32(c: i64) bool {
    ret c >= -2147483648 && c <= 2147483647;
}

# the constant is an integer wider than a condition
pub fun const_not_bit(mt: *Match) bool {
    ret subject_width(mt) > 1;
}

# a nonzero constant a single upper immediate builds
pub fun const_lui(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret subject_width(mt) > 1 && c.some != 0 && (c.some & 0xfff) == 0 && fits32(c.some);
}

pub fun const_i32_64(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret xlen64(mt) && subject_width(mt) > 1 && fits32(c.some);
}

pub fun const_i32_32(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret xlen32(mt) && subject_width(mt) > 1 && fits32(c.some);
}

pub fun const_wide_64(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret xlen64(mt) && subject_width(mt) != 1;
}

pub fun const_zero(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret c.some == 0;
}

fun fits_u32(c: i64) bool {
    ret c >= 0 && c <= 4294967295;
}

pub fun const_float_lui(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret c.some != 0 && fits_u32(c.some) && (c.some & 0xfff) == 0;
}

pub fun const_float_u32_64(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret xlen64(mt) && fits_u32(c.some);
}

pub fun const_float_u32_32(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    ret xlen32(mt) && fits_u32(c.some);
}

# the immediates a constant splits into
# ---
# lo12: the low twelve bits as a signed immediate
# hi20: the upper twenty bits that, with the signed low twelve, rebuild the low thirty two bits

pub fun negate(c: i64) i64 {
    ret 0 - c;
}

pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

pub fun log2_of(c: i64) i64 {
    ret trailing(c::u64);
}

pub fun log2_below(c: i64) i64 {
    ret trailing((c - 1)::u64);
}

pub fun log2_above(c: i64) i64 {
    ret trailing((c + 1)::u64);
}

pub fun log2_of_not(c: i64) i64 {
    ret trailing((~c)::u64);
}

pub fun lo12(c: i64) i64 {
    val l: i64 = c & 0xfff;
    if (l >= 0x800) { ret l - 0x1000; }
    ret l;
}

pub fun hi20(c: i64) i64 {
    ret ((c - lo12(c)) >> 12) & 0xfffff;
}

# the low thirty two bits of a number, sign extended
fun low_word(c: i64) i64 {
    val l: i64 = c & 0xffffffff;
    if (l >= 0x80000000) { ret l - 0x100000000; }
    ret l;
}

# the number above its low word, as a word
fun high_word(c: i64) i64 {
    ret (c - low_word(c)) >> 32;
}

pub fun lo_lo12(c: i64) i64 {
    ret lo12(low_word(c));
}

pub fun lo_hi20(c: i64) i64 {
    ret hi20(low_word(c));
}

pub fun hi_lo12(c: i64) i64 {
    ret lo12(high_word(c));
}

pub fun hi_hi20(c: i64) i64 {
    ret hi20(high_word(c));
}

# how the target's model reaches the address constant a materialisation
# builds, none for a constant that is no address or a target with no model
fun reached(mt: *Match) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, mt.subject);
    if (sel got.err)                { ret opt[Reach].none{}; }
    if (sel got.ok.none)            { ret opt[Reach].none{}; }
    if (!(sel got.ok.some.address)) { ret opt[Reach].none{}; }
    val at: id.Symbol = got.ok.some.address.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function.index];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global.index].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# the address is reached absolutely
pub fun absolute(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.absolute;
}

# the address is reached by its distance from the code
pub fun relative(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.relative;
}

# the address is loaded from the global offset table, on a 64 or 32 bit register
pub fun table_64(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.table && xlen64(mt);
}

pub fun table_32(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.table && xlen32(mt);
}

fun thread(mt: *Match) opt[Access] {
    val r: opt[Reach] = reached(mt);
    if (sel r.none)           { ret opt[Access].none{}; }
    if (!(sel r.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{r.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.local_exec;
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec_64(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.initial_exec && xlen64(mt);
}

pub fun initial_exec_32(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.initial_exec && xlen32(mt);
}

# a thread-local variable reached through the runtime's lookup
pub fun general_dynamic(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.general_dynamic;
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val v: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel v.none) { ret false; }
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, v.some);
    ret sel got.ok && sel got.ok.none;
}
