# the RISC-V selection table: rules, constants and the classes that hold values
#
# every instruction is a row of masc's catalog, named in rows.mach. a rule is
# an ir pattern, a guard, an expansion and a cost. nothing here names an
# architecture: the width of the register and the extensions a row needs are
# read from the target's declarations and masc's admission of the row.
#
# a cost is two for each instruction an expansion emits, with a multiply
# counting three and a divide twelve. it is less by one for each instruction
# the pattern covers, which a rule of its own would have emitted, and by one
# when the rule takes its constant operand as an immediate, which saves the
# register that would hold it. so a rule that covers more costs less than the
# rules for the pieces, and no choice rests on the order of rows.

use std.types.bool.false;

use rf: masc.core.register;
use ir: mirl.ir.opcode;
use mirl.ir.opcode.rule.Class;
use mirl.ir.type.format;
use mirl.isa.riscv.hook;
use mirl.isa.riscv.rows;
use mirl.machine.instruction.Opcode;
use mirl.machine.select.rule.Derived;
use mirl.machine.select.rule.Emit;
use mirl.machine.select.rule.Emits;
use mirl.machine.select.rule.Fresh;
use mirl.machine.select.rule.Hold;
use mirl.machine.select.rule.Holder;
use mirl.machine.select.rule.Holds;
use mirl.machine.select.rule.Node;
use mirl.machine.select.rule.Nodes;
use mirl.machine.select.rule.Ref;
use mirl.machine.select.rule.Rule;
use mirl.machine.select.rule.Rules;
use mirl.machine.select.rule.Scratch;
use mirl.machine.select.rule.Slot;
use mirl.machine.select.rule.Source;
use mirl.machine.select.rule.Sources;
use mirl.machine.select.rule.Table;
use mirl.machine.select.rule.Test;
use mirl.machine.select.rule.Tests;

# x0, which reads zero and ignores writes, and x1, which holds the return address
pub val ZERO:   rf.Id = 0x10000;
pub val RETURN: rf.Id = 0x10001;

# the classes of masc's register file
pub val GENERAL: u16 = 0;
pub val FLOAT:   u16 = 1;

