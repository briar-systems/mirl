# integers and pointers live in the general registers, floats in the float registers
val HOLDS: [3]Hold = [3]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{GENERAL}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{GENERAL}},
    Hold{class: Class.float{}, holder: Holder.hardware{FLOAT}},
};

val S_JUMP: [2]Source = [2]Source{Source.fixed{ZERO}, Source.target{0}};
val E_JUMP: [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{rows.JAL}, operands: Sources{at: ?S_JUMP[0], len: 2}}};

# the table for RV32 and RV64, one table for both widths
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: 424},
    constants: Rules{at: ?CONSTANTS[0], len: 17},
    holds:     Holds{at: ?HOLDS[0], len: 3},
    jump:      Emits{at: ?E_JUMP[0], len: 1},
};
