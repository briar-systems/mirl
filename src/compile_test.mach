# tests of writing an object, machine form in and the object format's bytes read back, on the risc-v rows

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.vector;
use io: std.io.writer;

use mink.fail.Fail;
use mink.format.contract;
use mink.format.registry;
use mink.model.object;

use mirl.compile;
use mirl.ir.text.parse.refusal.Refusal;
use fixture: mirl.machine.emit.emit_test;
use reader:  mirl.machine.text.parse;

# the bytes of `s` appended to `v`
#[testing]
fun put(v: *vector.Vector[u8], s: str) bool {
    var i: usize = 0;
    for (i < str_len(s)) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, s[i]);
        if (sel pushed.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a function that branches over `adds` four byte adds to its return
#[testing]
fun branching(v: *vector.Vector[u8], name: str, adds: usize) bool {
    if (!put(v, "function @") || !put(v, name) || !put(v, " {\n^0:\n    beq x10, x0, ^2\n    jal x0, ^1\n^1:\n")) { ret false; }
    var i: usize = 0;
    for (i < adds) {
        if (!put(v, "    add x5, x6, x7\n")) { ret false; }
        i = i + 1;
    }
    ret put(v, "    jal x0, ^2\n^2:\n    jalr x0, x1, 0\n}\n");
}

# each function symbol's st_size is the function's length as laid out, a relaxed branch's growth included
test compile__an_elf_function_symbol_is_sized_by_its_laid_out_length {
    var x: fixture.Fixture;
    if (!fixture.open(?x, nil)) { ret 1; }
    fin { fixture.close(?x); }
    var text: vector.Vector[u8] = vector.init[u8](?x.a);
    fin { vector.dnit[u8](?text); }
    if (!put(?text, "target \"riscv64-linux\"\n\n")) { ret 2; }
    # f's four byte branch lands 4100 bytes on, past its 4094, and grows to its inverse over a four byte jump
    if (!branching(?text, "f", 1024)) { ret 3; }
    # g's lands 12 bytes on and stays as it is
    if (!branching(?text, "g", 2)) { ret 4; }
    val read: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, View{data: text.data, len: text.len});
    if (sel read.err) { ret 5; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var o:    object.Object;
    val made: i32 = fixture.object_of(?x, ?u, ?o);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?o); }
    var held: io.Memory;
    var w:    io.Writer = io.memory_growing(?held, ?x.a);
    fin { io.memory_dnit(?held); }
    val wrote: err[compile.Unwritten] = compile.write(?x.a, ?o, ?x.t, ?w);
    if (sel wrote.err) { ret 6; }
    val formats: res[registry.Registry, Fail] = registry.builtin();
    if (sel formats.err) { ret 7; }
    var r:    registry.Registry         = formats.ok;
    var in:   contract.Input            = contract.Input{file: "sized.o", data: held.buf, len: held.len};
    val back: res[contract.Model, Fail] = registry.read(?r, ?x.a, ?in);
    if (sel back.err) { ret 8; }
    var model: contract.Model = back.ok;
    fin { contract.release(?model); }
    var again: object.Object = object.make(?x.a, nil);
    fin { object.release(?again); }
    val neutral: err[Fail] = contract.to_neutral(?model, ?again);
    if (sel neutral.err) { ret 9; }
    # f: an eight byte branch and jump, 1024 four byte adds, a return compressed to two. g: a four byte branch, two adds, the return
    if (fixture.size_of(?again, "f") != 4106) { ret 20; }
    if (fixture.size_of(?again, "g") != 14)   { ret 21; }
    ret 0;
}
