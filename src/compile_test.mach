# arithmetic, a branch on it and a call to a function another module defines
val TEXT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @callee: fun() -> () linkage global visibility default\nexport function @f: fun() -> () linkage global visibility default {\n^entry:\n    %a = add i64 5, i64 7\n    %b = mul %a, %a\n    %c = lt.s %b, i64 100\n    cbr %c, ^small, ^large\n^small:\n    call ptr @callee, signature fun() -> (), named all\n    ret\n^large:\n    ret\n}\n";

# the name of the section or symbol, compared with `want`
fun named(o: *object.Object, id: Id[Name], want: str) bool {
    val n: View = object.name_of(o, id);
    if (n.len != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < n.len) {
        if (n.data[i] != want[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the little endian word of `n` bytes at `at`
fun word(p: *u8, at: usize, n: usize) u64 {
    var v: u64   = 0;
    var i: usize = n;
    for (i > 0) {
        i = i - 1;
        v = (v << 8) | p[at + i]::u64;
    }
    ret v;
}

# whether `o` states the double float ABI
fun states_double(o: *object.Object) bool {
    val s: opt[Setting] = object.stated(o, ?arch.RISCV_FLOAT_ABI);
    if (sel s.none) { ret false; }
    val c: Setting = s.some;
    if (!(sel c.choice)) { ret false; }
    ret c.choice == ?arch.RISCV_DOUBLE;
}

# the shape the ir text above compiles to, whichever way it was held: one text
# section, which mirl leaves nameless for mink to name, @f defined at its start, @callee undefined, a call pair and a relax
# marker at the same offset naming @callee, and the double float ABI
fun shape(o: *object.Object) i32 {
    if (o.sections.count != 1) { ret 1; }
    val text: *object.Section = ?o.sections.items[0];
    if (text.kind != ?section.TEXT) { ret 2; }
    var f:      i64   = -1;
    var callee: i64   = -1;
    var i:      usize = 0;
    for (i < o.symbols.count) {
        if (named(o, o.symbols.items[i].name, "f"))      { f = i::i64; }
        if (named(o, o.symbols.items[i].name, "callee")) { callee = i::i64; }
        i = i + 1;
    }
    if (f < 0 || callee < 0) { ret 3; }
    val df: object.Definition = o.symbols.items[f].def;
    if (!(sel df.placed))                                      { ret 4; }
    if (df.placed.offset != 0 || df.placed.section.index != 0) { ret 4; }
    val dc: object.Definition = o.symbols.items[callee].def;
    if (sel dc.placed || !(sel dc.undefined))                                                              { ret 5; }
    if (o.symbols.items[f].binding != ?symbol.GLOBAL || o.symbols.items[callee].binding != ?symbol.GLOBAL) { ret 6; }
    if (o.relocs.count != 2)                                                                               { ret 7; }
    if (o.relocs.items[0].kind != ?reloc.CALL_PLT_PAIR || o.relocs.items[1].kind != ?reloc.RELAX)          { ret 8; }
    if (o.relocs.items[0].offset != o.relocs.items[1].offset)                                              { ret 9; }
    val named_by: object.Target = o.relocs.items[0].target;
    if (!(sel named_by.symbol))               { ret 10; }
    if (named_by.symbol.index::i64 != callee) { ret 10; }
    if (!states_double(o))                    { ret 11; }
    ret 0;
}

# whether the object `b` holds the text section of `a` byte for byte, with its
# alignment and flags, and the relocations of `a` at the same offsets and addends
fun same_text(a: *object.Object, b: *object.Object) bool {
    val x: *object.Section = ?a.sections.items[0];
    val y: *object.Section = ?b.sections.items[0];
    if (x.align != y.align || x.flags != y.flags || x.entsize != y.entsize) { ret false; }
    val p: Bytes = object.bytes(a, ?x.contents);
    val q: Bytes = object.bytes(b, ?y.contents);
    if (p.len == 0 || p.len != q.len) { ret false; }
    var i: usize = 0;
    for (i < p.len) {
        if (p.data[i] != q.data[i]) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < a.relocs.count) {
        if (a.relocs.items[i].offset != b.relocs.items[i].offset || a.relocs.items[i].addend != b.relocs.items[i].addend) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bytes of an object file read back through mink into the neutral object `got`
# ---
# ret: 0, or the step that refused
fun back(a: *allocator.Allocator, mem: *io.Memory, got: *object.Object) i32 {
    val formats: res[registry.Registry, Fail] = registry.builtin();
    if (sel formats.err) { ret 1; }
    var r:    registry.Registry         = formats.ok;
    var file: Input                     = Input{file: "f.o", data: mem.buf, len: mem.len};
    val read: res[contract.Model, Fail] = registry.read(?r, a, ?file);
    if (sel read.err) { ret 2; }
    var model: contract.Model = read.ok;
    fin { contract.release(?model); }
    val converted: err[Fail] = contract.to_neutral(?model, got);
    if (sel converted.err) { ret 3; }
    ret 0;
}

# an ir text example compiled for riscv64-linux, written as an ELF object and
# read back through mink states the same sections, symbols, relocations and
# float ABI, and the file says so in its own header
test compile__an_rv64_object_reads_back_from_elf {
    var a: allocator.Allocator;
    page.make(?a);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: TEXT, len: str_len(TEXT)});
    if (sel read.err) { ret 1; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.row_of(module.target(?m));
    if (sel row.none) { ret 2; }
    val options: compile.Options                   = compile.Options{level: 0, checked: true, added: Slice[str]{data: nil, size: 0}, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}};
    val made:    res[object.Object, compile.Error] = compile.compile(?a, ?m, row.some, options);
    if (sel made.err) { ret 3; }
    var o: object.Object = made.ok;
    fin { object.release(?o); }
    val before: i32 = shape(?o);
    if (before != 0) { ret 10 + before; }

    var mem: io.Memory;
    var out: io.Writer = io.memory_growing(?mem, ?a);
    fin { io.memory_dnit(?mem); }
    val wrote: err[compile.Unwritten] = compile.write(?a, ?o, row.some, ?out);
    if (sel wrote.err) { ret 4; }

    # the header of an ELF64 little endian relocatable file for RISC-V, whose
    # flags carry the double float ABI (4) and compressed code (1), as the
    # target's rv64gc baseline states
    val p: *u8 = mem.buf;
    if (mem.len < 64)                                              { ret 5; }
    if (p[0] != 0x7f || p[1] != 'E' || p[2] != 'L' || p[3] != 'F') { ret 6; }
    if (p[4] != 2 || p[5] != 1)                                    { ret 7; }
    if (word(p, 16, 2) != 1)                                       { ret 8; }
    if (word(p, 18, 2) != 243)                                     { ret 9; }
    if (word(p, 48, 4) != 0x5)                                     { ret 40; }

    var got: object.Object = object.make(?a, o.arch);
    fin { object.release(?got); }
    val read_back: i32 = back(?a, ?mem, ?got);
    if (read_back != 0) { ret 40 + read_back; }
    val after: i32 = shape(?got);
    if (after != 0)           { ret 50 + after; }
    if (!same_text(?o, ?got)) { ret 44; }
    # mirl names no section, and the file names its text as the elf gabi's special section for it
    val unnamed: opt[Id[Name]] = o.sections.items[0].name;
    val written: opt[Id[Name]] = got.sections.items[0].name;
    if (sel unnamed.some)                    { ret 45; }
    if (sel written.none)                    { ret 46; }
    if (!named(?got, written.some, ".text")) { ret 47; }
    ret 0;
}

# a constant, two data globals, a zero filled one and two thread-local ones, none in a section the module names
val GLOBALS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nexport global @limit: i32 linkage global visibility default constant = i32 9\nexport global @counter: i32 linkage global visibility default = i32 7\nexport global @other: i32 linkage global visibility default = i32 8\nexport global @zeroed: i32 linkage global visibility default = i32 zero\nexport global @slot: i64 linkage global visibility default tls local_exec = i64 -1\nexport global @cleared: i64 linkage global visibility default tls local_exec = i64 zero\nexport function @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# whether the symbol `name` of `o` is placed in a section of the kind `kind`, named `want` when it is not nil and
# nameless when it is
#[testing]
fun placed_in(o: *object.Object, name: str, kind: *section.Kind, want: str) bool {
    val s: opt[*object.Symbol] = fixture.symbol_named(o, name);
    if (sel s.none) { ret false; }
    val d: object.Definition = s.some.def;
    if (!(sel d.placed)) { ret false; }
    val in:    *object.Section = object.section_at(o, d.placed.section);
    val title: opt[Id[Name]]   = in.name;
    if (in.kind != kind) { ret false; }
    if (want == nil)     { ret sel title.none; }
    if (sel title.none)  { ret false; }
    ret named(o, title.some, want);
}

# the section a symbol of `o` is placed in, -1 for none
#[testing]
fun section_index(o: *object.Object, name: str) i64 {
    val s: opt[*object.Symbol] = fixture.symbol_named(o, name);
    if (sel s.none) { ret -1; }
    val d: object.Definition = s.some.def;
    if (sel d.placed) { ret d.placed.section.index::i64; }
    ret -1;
}

# mirl hands mink one nameless section for each kind its globals and code are placed in, and the elf file names each
# as the elf gabi's special section of that kind
test compile__a_nameless_section_of_each_kind_is_named_by_mink {
    var a: allocator.Allocator;
    page.make(?a);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: GLOBALS, len: str_len(GLOBALS)});
    if (sel read.err) { ret 1; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.row_of(module.target(?m));
    if (sel row.none) { ret 2; }
    val options: compile.Options                   = compile.Options{level: 0, checked: true, added: Slice[str]{data: nil, size: 0}, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}};
    val made:    res[object.Object, compile.Error] = compile.compile(?a, ?m, row.some, options);
    if (sel made.err) { ret 3; }
    var o: object.Object = made.ok;
    fin { object.release(?o); }
    # text, rodata, data, bss, tdata and tbss, the two data globals in one section
    if (o.sections.count != 6)                                      { ret 4; }
    if (section_index(?o, "counter") != section_index(?o, "other")) { ret 5; }
    if (!placed_in(?o, "f", ?section.TEXT, nil))                    { ret 6; }
    if (!placed_in(?o, "limit", ?section.RODATA, nil))              { ret 7; }
    if (!placed_in(?o, "counter", ?section.DATA, nil))              { ret 8; }
    if (!placed_in(?o, "zeroed", ?section.BSS, nil))                { ret 9; }
    if (!placed_in(?o, "slot", ?section.TLS_DATA, nil))             { ret 10; }
    if (!placed_in(?o, "cleared", ?section.TLS_BSS, nil))           { ret 11; }

    var mem: io.Memory;
    var out: io.Writer = io.memory_growing(?mem, ?a);
    fin { io.memory_dnit(?mem); }
    val wrote: err[compile.Unwritten] = compile.write(?a, ?o, row.some, ?out);
    if (sel wrote.err) { ret 12; }
    var got: object.Object = object.make(?a, o.arch);
    fin { object.release(?got); }
    val read_back: i32 = back(?a, ?mem, ?got);
    if (read_back != 0) { ret 20 + read_back; }
    # the special sections of the elf gabi (generic abi, "special sections")
    if (section_index(?got, "counter") != section_index(?got, "other")) { ret 13; }
    if (!placed_in(?got, "f", ?section.TEXT, ".text"))                  { ret 14; }
    if (!placed_in(?got, "limit", ?section.RODATA, ".rodata"))          { ret 15; }
    if (!placed_in(?got, "counter", ?section.DATA, ".data"))            { ret 16; }
    if (!placed_in(?got, "zeroed", ?section.BSS, ".bss"))               { ret 17; }
    if (!placed_in(?got, "slot", ?section.TLS_DATA, ".tdata"))          { ret 18; }
    if (!placed_in(?got, "cleared", ?section.TLS_BSS, ".tbss"))         { ret 19; }
    ret 0;
}

# an object that states no float ABI is refused by the writer, and nothing is written
test compile__refuses_to_write_an_object_with_no_float_abi {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.row_of(module.Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}});
    if (sel row.none) { ret 1; }
    var o: object.Object = object.make(?a, ?arch.RISCV64);
    fin { object.release(?o); }
    val unstated: opt[Setting] = object.stated(?o, ?arch.RISCV_FLOAT_ABI);
    if (sel unstated.some) { ret 2; }
    var mem: io.Memory;
    var out: io.Writer = io.memory_growing(?mem, ?a);
    fin { io.memory_dnit(?mem); }
    val wrote: err[compile.Unwritten] = compile.write(?a, ?o, row.some, ?out);
    if (!(sel wrote.err)) { ret 3; }
    val why: compile.Unwritten = wrote.err;
    if (!(sel why.format)) { ret 4; }
    if (mem.len != 0)      { ret 5; }
    ret 0;
}

# the bytes of `s` appended to `v`
fun put(v: *vector.Vector[u8], s: str) bool {
    var i: usize = 0;
    for (i < str_len(s)) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, s[i]);
        if (sel pushed.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a function that branches over `adds` four byte adds to its return
fun branching(v: *vector.Vector[u8], name: str, adds: usize) bool {
    if (!put(v, "function @") || !put(v, name) || !put(v, " {\n^0:\n    beq x10, x0, ^2\n    jal x0, ^1\n^1:\n")) { ret false; }
    var i: usize = 0;
    for (i < adds) {
        if (!put(v, "    add x5, x6, x7\n")) { ret false; }
        i = i + 1;
    }
    ret put(v, "    jal x0, ^2\n^2:\n    jalr x0, x1, 0\n}\n");
}

# each function symbol's st_size is the function's length as laid out, a relaxed branch's growth included
test compile__an_elf_function_symbol_is_sized_by_its_laid_out_length {
    var x: fixture.Fixture;
    if (!fixture.open(?x, nil)) { ret 1; }
    fin { fixture.close(?x); }
    var text: vector.Vector[u8] = vector.init[u8](?x.a);
    fin { vector.dnit[u8](?text); }
    if (!put(?text, "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\n")) { ret 2; }
    # the sizes are derived by hand from the encodings, never from masc's layout. the jumps to the block that
    # follows are dropped, and beq x10, x0 to a block starts compressed under the target's C as c.beqz, which
    # reaches -256 to 254 bytes, and grows to beq, which reaches -4096 to 4094, then to the inverted branch,
    # c.bnez x10 over the jal, 6 bytes, as llvm-mc lays it out
    # f's c.beqz lands 2 + 4096 = 4098 bytes on and a beq 4 + 4096 = 4100, past both, so it is c.bnez and jal
    if (!branching(?text, "f", 1024)) { ret 3; }
    # g's c.beqz lands 2 + 8 = 10 bytes on and stays as it is
    if (!branching(?text, "g", 2)) { ret 4; }
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, View{data: text.data, len: text.len});
    if (sel read.err) { ret 5; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var o:    object.Object;
    val made: i32 = fixture.object_of(?x, ?u, ?o);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?o); }
    var held: io.Memory;
    var w:    io.Writer = io.memory_growing(?held, ?x.a);
    fin { io.memory_dnit(?held); }
    val wrote: err[compile.Unwritten] = compile.write(?x.a, ?o, ?x.t, ?w);
    if (sel wrote.err) { ret 6; }
    var again: object.Object = object.make(?x.a, o.arch);
    fin { object.release(?again); }
    val read_back: i32 = back(?x.a, ?held, ?again);
    if (read_back != 0) { ret 6 + read_back; }
    # f: c.bnez and jal, 6, then 1024 adds of 4 (add x5, x6, x7 has no compressed form), then c.jr, 2: 4104
    # g: c.beqz, 2, then two adds, 8, then c.jr, 2: 12
    if (fixture.size_of(?again, "f") != 4104) { ret 20; }
    if (fixture.size_of(?again, "g") != 12)   { ret 21; }
    ret 0;
}

# a function that returns, for the target a text names, written into 512 bytes
fun returning(t: *Target, out: *u8) View {
    var m: io.Memory;
    var w: io.Writer = io.memory(?m, out, 512);
    printer.target_line(?w, targets.tuple(t));
    io.write_str(?w, "function @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n");
    ret View{data: out, len: m.len};
}

# a target no family admits is refused as unserved before anything runs, the
# module as it was
test compile__refuses_a_target_no_family_admits {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(targets.requires_structure);
    if (sel row.none) { ret 1; }
    var buf:  [512]u8;
    val text: View                           = returning(row.some, ?buf[0]);
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, text);
    if (sel read.err) { ret 2; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val again: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, text);
    if (sel again.err) { ret 2; }
    var want: Module = again.ok;
    fin { module.dnit(?want); }
    val options: compile.Options                   = compile.Options{level: 2, checked: true, added: Slice[str]{data: nil, size: 0}, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}};
    val made:    res[object.Object, compile.Error] = compile.compile(?a, ?m, row.some, options);
    if (sel made.ok) {
        var o: object.Object = made.ok;
        object.release(?o);
        ret 3;
    }
    val why: compile.Error = made.err;
    if (!(sel why.unserved)) { ret 4; }
    val unserved: compile.Unserved = why.unserved;
    if (!(sel unserved.none)) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 7; }
    ret 0;
}

fun admits_every(c: *Capabilities) bool {
    ret true;
}

# two test families that admit every target, and nothing else of them is read
val EITHER: Family = Family{name: "either", admits: admits_every};
val OTHER:  Family = Family{name: "other", admits: admits_every};

# a registry picks the one family that admits a target, and refuses a target
# none of its families admits or several do
test compile__a_target_several_families_admit_is_unserved {
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none) { ret 1; }
    var both: [2]*Family             = [2]*Family{?EITHER, ?OTHER};
    val two:  res[*Family, Unserved] = families.serving(Slice[*Family]{data: ?both[0], size: 2}, ?row.some.caps);
    if (!(sel two.err)) { ret 2; }
    val several: Unserved = two.err;
    if (!(sel several.several)) { ret 3; }
    val one: res[*Family, Unserved] = families.serving(Slice[*Family]{data: ?both[1], size: 1}, ?row.some.caps);
    if (sel one.err)      { ret 4; }
    if (one.ok != ?OTHER) { ret 5; }
    val empty: res[*Family, Unserved] = families.serving(Slice[*Family]{data: nil, size: 0}, ?row.some.caps);
    if (!(sel empty.err)) { ret 6; }
    val none: Unserved = empty.err;
    if (!(sel none.none)) { ret 7; }
    ret 0;
}

fun admits_logical(c: *Capabilities) bool {
    ret sel c.addressing.logical;
}

fun logical(t: *Target) bool {
    ret sel t.caps.addressing.logical;
}

fun riscv64_linux() opt[*Target] {
    ret targets.row_of(Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}});
}

# the family of a registry serving a target, none when no one family does
fun served_in(registry: Slice[*Family], t: *Target) opt[*Family] {
    val f: res[*Family, Unserved] = families.serving(registry, ?t.caps);
    if (sel f.err) { ret opt[*Family].none{}; }
    ret opt[*Family].some{f.ok};
}

# a row a test family owns is refused on riscv64-linux, which the register
# family serves, and admitted on a target the test family serves, and a core
# row stands on both. a row two families list has no one owner and is
# refused, and mirl's own registry gives its owners
test compile__a_family_row_stands_only_where_its_family_serves {
    var a: allocator.Allocator;
    page.make(?a);
    val core: opt[*opcode.Row] = opcode.at(opcode.ADD);
    if (sel core.none) { ret 1; }
    var own: opcode.Row = @core.some;
    own.name = "test.add";
    var listed:   [1]*opcode.Row = [1]*opcode.Row{?own};
    var test:     Family         = Family{name: "test", admits: admits_logical, opcodes: Slice[*opcode.Row]{data: ?listed[0], size: 1}};
    var both:     [2]*Family     = [2]*Family{?register.FAMILY, ?test};
    val registry: Slice[*Family] = Slice[*Family]{data: ?both[0], size: 2};

    val built: res[Owners, Listing] = families.owners(?a, registry);
    if (sel built.err) { ret 2; }
    var owners: Owners = built.ok;
    fin { families.release(?owners); }

    val machine: opt[*Target] = riscv64_linux();
    if (sel machine.none) { ret 3; }
    val there: opt[*Family] = served_in(registry, machine.some);
    if (sel there.none)                              { ret 4; }
    if (there.some != ?register.FAMILY)              { ret 5; }
    if (families.admits(?owners, there, ?own))       { ret 6; }
    if (!families.admits(?owners, there, core.some)) { ret 7; }

    val shader: opt[*Target] = targets.first(logical);
    if (sel shader.none) { ret 8; }
    val here: opt[*Family] = served_in(registry, shader.some);
    if (sel here.none)                              { ret 9; }
    if (here.some != ?test)                         { ret 10; }
    if (!families.admits(?owners, here, ?own))      { ret 11; }
    if (!families.admits(?owners, here, core.some)) { ret 12; }

    var other:  Family               = Family{name: "other", admits: admits_logical, opcodes: Slice[*opcode.Row]{data: ?listed[0], size: 1}};
    var twice:  [2]*Family           = [2]*Family{?test, ?other};
    val shared: res[Owners, Listing] = families.owners(?a, Slice[*Family]{data: ?twice[0], size: 2});
    if (!(sel shared.err))        { ret 13; }
    if (!(sel shared.err.twice))  { ret 14; }
    if (shared.err.twice != ?own) { ret 15; }

    val production: res[Owners, Listing] = families.owners(?a, families.rows());
    if (sel production.err) { ret 16; }
    var held: Owners = production.ok;
    families.release(?held);
    ret 0;
}

# a high product the test family owns, on riscv64-linux, which it does not serve
val HIGH: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nexport function @f: fun(i64) -> (i64) linkage global visibility default {\n^entry(%x: i64):\n    %h = mul.high.u %x, %x\n    ret %h\n}\n";

# a function that returns its argument, on riscv64-linux
val PLAIN: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nexport function @f: fun(i64) -> (i64) linkage global visibility default {\n^entry(%x: i64):\n    ret %x\n}\n";

# the test family that owns the high product, serving the targets whose
# addressing is logical
fun owning(listed: **opcode.Row) Family {
    ret Family{name: "test", admits: admits_logical, opcodes: Slice[*opcode.Row]{data: listed, size: 1}};
}

fun options() compile.Options {
    ret compile.Options{level: 0, checked: true, added: Slice[str]{data: nil, size: 0}, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}};
}

# a module that already holds a row another family owns is refused before the
# schedule runs, and is left as it was
test compile__a_foreign_row_is_refused_before_the_schedule {
    var a: allocator.Allocator;
    page.make(?a);
    val high: opt[*opcode.Row] = opcode.at(opcode.MUL_HIGH_U);
    if (sel high.none) { ret 1; }
    var listed:   [1]*opcode.Row = [1]*opcode.Row{high.some};
    var test:     Family         = owning(?listed[0]);
    var both:     [2]*Family     = [2]*Family{?register.FAMILY, ?test};
    val registry: Slice[*Family] = Slice[*Family]{data: ?both[0], size: 2};

    val text: View                           = View{data: HIGH, len: str_len(HIGH)};
    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, text);
    if (sel read.err) { ret 2; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val again: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, text);
    if (sel again.err) { ret 2; }
    var want: Module = again.ok;
    fin { module.dnit(?want); }
    val row: opt[*Target] = riscv64_linux();
    if (sel row.none) { ret 3; }
    val made: res[object.Object, compile.Error] = compile.compile_in(registry, ?a, ?m, row.some, options());
    if (sel made.ok) {
        var o: object.Object = made.ok;
        object.release(?o);
        ret 4;
    }
    val why: compile.Error = made.err;
    if (!(sel why.foreign))           { ret 5; }
    if (why.foreign.row != high.some) { ret 6; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 7; }
    if (!same.ok)     { ret 8; }
    ret 0;
}

# a test pass that puts a high product of the first function's first
# argument ahead of its entry's terminator
fun put_high(c: *Context) res[bool, Why] {
    val f:  Function      = Function{index: 0};
    val bd: *Body         = ?c.m.functions.data[0].body;
    val at: Instruction   = bd.blocks.data[0].instructions.data[bd.blocks.data[0].instructions.len - 1];
    val x:  Value         = bd.blocks.data[0].parameters.data[0];
    var b:  build.Builder = build.init(c.m);
    build.enter(?b, f);
    build.before(?b, at);
    var ops: [2]Value = [2]Value{x, x};
    build.emit(?b, Request{opcode: opcode.MUL_HIGH_U, operands: Slice[Value]{data: ?ops[0], size: 2}, immediates: Slice[opcode.Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: nil, size: 0}});
    val done: err[build.Failure] = build.done(?b);
    ret res[bool, Why].ok{sel done.ok};
}

val PUT_HIGH:  Pass         = Pass{name: "put high", kind: Kind.legalise{}, scope: Scope.module{put_high}};
val PUT_ROW:   schedule.Row = schedule.Row{pass: ?PUT_HIGH, levels: EVERY, verify: Verify.never{}, after: Slice[schedule.Row]{data: nil, size: 0}};
val PUT_STEPS: [1]Step      = [1]Step{Step.row{?PUT_ROW}};

fun admits_register(c: *Capabilities) bool {
    ret register.FAMILY.admits(c);
}

# a test family over the register family's build and back end whose one row
# puts in a high product, which the other test family owns
val INSERTING: Family = Family{
    name:    "inserting",
    admits:  admits_register,
    legal:   Slice[Step]{data: ?PUT_STEPS[0], size: 1},
    open:    register.FAMILY.open,
    back:    register.FAMILY.back,
    close:   register.FAMILY.close,
    opcodes: Slice[*opcode.Row]{data: nil, size: 0},
};

# a family row that puts in a row another family owns is refused after the
# schedule, before the back end
test compile__a_foreign_row_the_schedule_leaves_is_refused_before_the_back_end {
    var a: allocator.Allocator;
    page.make(?a);
    val high: opt[*opcode.Row] = opcode.at(opcode.MUL_HIGH_U);
    if (sel high.none) { ret 1; }
    var listed:   [1]*opcode.Row = [1]*opcode.Row{high.some};
    var test:     Family         = owning(?listed[0]);
    var both:     [2]*Family     = [2]*Family{?INSERTING, ?test};
    val registry: Slice[*Family] = Slice[*Family]{data: ?both[0], size: 2};

    val read: res[Module, ir_reader.Refusal] = ir_reader.parse_body(?a, View{data: PLAIN, len: str_len(PLAIN)});
    if (sel read.err) { ret 2; }
    var m: Module = read.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = riscv64_linux();
    if (sel row.none) { ret 3; }
    val made: res[object.Object, compile.Error] = compile.compile_in(registry, ?a, ?m, row.some, options());
    if (sel made.ok) {
        var o: object.Object = made.ok;
        object.release(?o);
        ret 4;
    }
    val why: compile.Error = made.err;
    if (!(sel why.introduced))           { ret 5; }
    if (why.introduced.row != high.some) { ret 6; }
    ret 0;
}
