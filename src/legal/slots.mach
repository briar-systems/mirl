# slots of a pointer type taken out of memory where the build carries no
# variable pointer, as spir-v's logical addressing without VariablePointers
# holds no pointer in a Function variable
#
# a pointer under logical addressing has no representation in memory, so a
# slot that holds one is promoted to the values stored to it at every
# optimisation level, as spirv-opt's legalisation does for glslang's and
# dxc's output. promotion here merges no pointer where paths join, since a
# merged pointer is a variable one too, and gives no load a pointer no store
# left, since no pointer stands for none. a slot it cannot take out is
# refused, named, with why it stays: its address escapes, a kept or volatile
# access holds it, its pointers merge, a load reads none, or a load would
# change its secrecy. where the build carries variable pointers, as one
# holding VariablePointers does (mirl.target.basis.variable), the slot may
# stay and the pass does not apply. slots of any other type are left alone.
#
# it changes no branch and no address, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.result.res;

use mirl.opt.promote;
use mirl.opt.promote.Reach;
use mirl.pass.failure.Why;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.target.basis;

# the pass
# ---
# it keeps no analysis, since it may take unreached blocks out of the graph
pub val POINTER_SLOTS: Pass = Pass{name: "pointer slots", kind: Kind.legalise{}, scope: Scope.function{visit}, time: Time.keeps{}, applies: unvaried};

# the build carries no variable pointer. a selection that cannot be read
# applies the pass, which refuses what it cannot take out
fun unvaried(g: *Ground) bool {
    val held: res[bool, basis.Error] = basis.variable(g.basis, ?g.t.caps);
    if (sel held.err) { ret true; }
    ret !held.ok;
}

fun visit(u: *Unit) res[bool, Why] {
    ret promote.walk(u, Reach.pointers{});
}
