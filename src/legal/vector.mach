# vectors legalised to what the target holds: split into the pieces its units
# hold, and taken lane by lane where no unit computes an operation
#
# mach's vectors are explicit, so a vector type and every operation on one is
# legal in the ir on every target, and this pass makes each one what the build
# can hold and compute. it reads the target's vector units and nothing of its
# identity: the widths and lane types each unit packs under its condition, the
# masks it holds and the operations it computes over packed lanes, each at the
# lane types and under the condition its rows state (`capability.Unit`). a
# vector type a unit holds whole stays one value, and any other splits by
# `mirl.target.vector.split` into the pieces a unit holds and scalars of the
# lane type, as `mirl.legal.vector.lanes` lays it out, so a scalable unit
# splits by the least width the build binds its quantity to, a length-agnostic
# one takes no fixed-length vector, an odd count leaves a remainder that splits
# again, and a mask, a vector of conditions, splits where its unit holds masks
# and goes lane by lane where none does.
#
# - a lanewise operation, a comparison giving its mask, a select by one, a
#   conversion that widens or narrows its lanes and an overflow form giving
#   its flags among them, runs over the runs of the type with the widest lane
#   it reads or gives, each run packed where a unit computes the operation at
#   its lane types and holds that many lanes of each, and lane by lane
#   otherwise. what it reads it cuts from its operands' parts, and its results
#   are the runs it made, put together where the result is held whole.
# - a reduction combines the reductions of its packed runs, and the lanes of
#   any other, by its scalar operation, a minimum or maximum of integers by a
#   comparison and a select. a sequential one combines lane after lane from the
#   first, its first run reduced packed where it starts the vector, so its
#   order is kept.
# - a splat, a build, an extract, an insert and a shuffle read and make runs,
#   each packed where a unit computes it at that count and otherwise taken
#   lane by lane, a held vector put together through a stack slot where no
#   unit builds it.
# - a load or a store is one access per run at the run's offset, lanes packed
#   in memory, each carrying the access's flags, the last store in the place
#   of the one it splits so a kept store stays kept.
# - a reinterpretation goes through a stack slot of the operand's type: it is
#   stored by its parts and the result loaded by its runs. one between a held
#   vector and an integer wider than the target computes at goes through the
#   slot too, so the wide integer legalisation splits the integer's access
#   into words and makes no lane operation. a vector of
#   conditions packs one bit per lane, lane 0 lowest, so one is made into or
#   read from the integer of that many bits, which goes through the slot where
#   the other side is no integer.
# - a block parameter is one parameter per run of its type, and every edge
#   into it passes the runs of its argument.
# - a constant is its runs.
#
# the first run, ahead of the helpers and every other legalisation of types,
# keeps a vector at a function's boundary whole: an entry parameter and a
# call's result are read by a shuffle or an extract of it as it stands, and a
# call's argument or a return's value is put together through a slot. the abi
# legalisation places each in its pieces, and the run after it takes apart
# what that leaves, refusing a vector no unit holds that is still at a
# boundary. everything made reads as the instruction it stands in for, its
# location, site and secrecy, a slot is read and written at offsets the type
# fixes, and nothing branches or reads a value to decide anything, so the
# pass keeps constant time.
#
# what it refuses, each by its own reason: a vector no unit holds at an entry,
# a call or a return after the abi legalisation; a vector no unit holds that
# an atomic, an inline block, a target op or an aggregate member reads or
# gives, which no legalisation takes apart; a reinterpretation of a vector on
# a target whose bytes are big endian, where memory would not put lane 0 in
# the low bits; and a reinterpretation of a vector of conditions wider than
# the widest integer.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.bytes.reader;
use folder: mirl.fold;
use mirl.fold.word;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.legal.emit;
use mirl.legal.vector.lanes;
use mirl.legal.vector.lanes.Part;
use mirl.legal.vector.lanes.Run;
use mirl.legal.vector.lanes.Work;
use mirl.opt.number;
use mirl.pass.analysis;
use mirl.pass.failure;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use targets: mirl.target;
use mirl.target.basis;

# the passes: each adds and removes instructions and block parameters and
# never touches an edge's target or a block. the first runs ahead of every
# other legalisation of types and the second after the abi legalisation
pub val VECTORS:        Pass = Pass{name: "vectors", kind: Kind.legalise{}, scope: Scope.function{ahead}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};
pub val PLACED_VECTORS: Pass = Pass{name: "placed vectors", kind: Kind.legalise{}, scope: Scope.function{after}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

val BOUNDARY: str = "a vector no unit holds at an entry, a call or a return, which the abi legalisation places in its pieces first";
val OPAQUE:   str = "a vector no unit holds that an atomic, an inline block, a target op or an aggregate member reads or gives, which no legalisation takes apart";
val ENDIAN:   str = "a reinterpretation of a vector on a target whose bytes are big endian, where memory would not put lane 0 in the low bits";
val MASK:     str = "a reinterpretation of a vector of conditions wider than the widest integer";
val CYCLE:    str = "vectors that define each other in code no path reaches";
val ROWLESS:  str = "an instruction whose opcode has no row";

# whether the pass applies: to a target that states its vector units, or that
# it holds no vector in a register
fun wanted(g: *Ground) bool {
    ret !(sel g.t.caps.vectors.unstated);
}

# how an instruction is legalised
# ---
# none:       it is left as it stands
# refused:    it is refused, for the reason given
# lanewise:   a lanewise operation, run over runs
# reduce:     a reduction
# splat:      a splat
# build:      a build
# extract:    a lane extract
# insert:     a lane insert
# shuffle:    a shuffle
# load:       a load of a vector no unit holds
# store:      a store of one
# recast:     a reinterpretation to or from one
# declassify: a declassification of one, part by part
# boundary:   a call or a return that reads a split vector whole
tag Form: u8 {
    none;
    refused: str;
    lanewise;
    reduce;
    splat;
    build;
    extract;
    insert;
    shuffle;
    load;
    store;
    recast;
    declassify;
    boundary;
}

# one instruction to legalise
# ---
# form:  how
# block: its block
# state: where the walk of definitions is: 0 unseen, 1 open, 2 done
rec Mark {
    form:  Form;
    block: Block;
    state: u8;
}

# a block parameter split into runs
# ---
# block: its block
# old:   the parameter
rec Parameter {
    block: Block;
    old:   Value;
}

# the walk of one function
# ---
# w:      the lanes
# late:   the run after the abi legalisation
# little: the target's bytes are little endian
# marks:  one per instruction the function had when the walk began
# order:  the instructions to legalise, each after those defining what it reads
# gone:   the instructions legalised that nothing takes the place of, removed
#         at the end
# params: the parameters split
# before: for each block, how many parameters it had before its own were
#         split, UNTOUCHED for a block none of whose were
rec Walk {
    w:      Work;
    late:   bool;
    little: bool;
    marks:  vector.Vector[Mark];
    order:  vector.Vector[Instruction];
    gone:   vector.Vector[Instruction];
    params: vector.Vector[Parameter];
    before: vector.Vector[u32];
}

val UNTOUCHED: u32 = 0xffffffff;

# what one instruction is, copied before the body grows under it
# ---
# code:       its opcode
# row:        its row
# operands:   its operands
# results:    its results
# immediates: its immediates
# flags:      its flags
rec Copied {
    code:       Opcode;
    row:        Row;
    operands:   Slice[Value];
    results:    Slice[Value];
    immediates: Slice[Immediate];
    flags:      Flags;
}

fun body_of(wk: *Walk) *Body {
    ret wk.w.site.b;
}

fun lost(e: allocator.Error) Why {
    ret Why.alloc{e};
}

fun position(b: *Body, k: Block, i: Instruction) u32 {
    val list: Slice[Instruction] = Slice[Instruction]{data: b.blocks.data[k.index].instructions.data, size: b.blocks.data[k.index].instructions.len};
    var p:    usize              = 0;
    for (p < list.size && list.data[p].index != i.index) { p = p + 1; }
    ret p::u32;
}

# whether a type is a vector no unit holds whole
fun unheld(wk: *Walk, ty: Type) bool {
    ret !lanes.held(?wk.w, ty);
}

# the lane type of a vector type, the type itself for any other
fun element(wk: *Walk, ty: Type) Type {
    val v: opt[types.Vector] = lanes.vector_of(?wk.w, ty);
    if (sel v.some) { ret v.some.element; }
    ret ty;
}

# the lane count of a vector type, zero for any other
fun count(wk: *Walk, ty: Type) u32 {
    val v: opt[types.Vector] = lanes.vector_of(?wk.w, ty);
    if (sel v.some) { ret v.some.lanes; }
    ret 0;
}

fun is_vector(wk: *Walk, ty: Type) bool {
    ret count(wk, ty) != 0;
}

# whether an operation is a call or a return, which reads and gives its
# vectors whole at a function's boundary
fun crosses(code: Opcode) bool {
    val c: u32 = code.index;
    ret c == opcode.CALL.index || c == opcode.RET.index || c == opcode.CALL_PLACED.index || c == opcode.RET_PLACED.index;
}

# the lane type a conversion gives, from its first immediate, and the lane
# type it reads for any other operation
fun to_lane(wk: *Walk, d: *InstructionData, row: *Row, lane: Type) Type {
    val r: opcode.Result = row.results[0];
    if (!(sel r.same)) { ret lane; }
    val subject: opcode.Subject = r.same;
    if (!(sel subject.immediate)) { ret lane; }
    val at: u32 = subject.immediate;
    if (at::usize >= d.immediates.len) { ret lane; }
    val imm: Immediate = d.immediates.data[at];
    if (sel imm.ty) { ret element(wk, imm.ty); }
    ret lane;
}

# every lane type of the vectors an instruction reads and gives, at most
# lanes.MOST_LANES, and the lane count they share, zero where there are none
fun lane_types(wk: *Walk, d: *InstructionData, out: *Type, n: *usize) u32 {
    var lanes_n: u32 = 0;
    @n = 0;
    var k: usize = 0;
    for (k < d.operands.len + d.results.len) {
        var x: Value = Value{index: 0};
        if (k < d.operands.len) { x = d.operands.data[k]; }
        or                      { x = d.results.data[k - d.operands.len]; }
        val ty: Type = lanes.type_of(?wk.w, x);
        val c:  u32  = count(wk, ty);
        if (c != 0) {
            lanes_n = c;
            if (@n < lanes.MOST_LANES) {
                out[@n] = element(wk, ty);
                @n      = @n + 1;
            }
        }
        k = k + 1;
    }
    ret lanes_n;
}

# whether a unit computes an instruction as it stands, over the whole of each
# vector it reads and gives
fun packed_whole(wk: *Walk, d: *InstructionData, row: *Row, lane: Type) bool {
    var all: [8]Type;
    var n:   usize = 0;
    val c:   u32   = lane_types(wk, d, ?all[0], ?n);
    if (c == 0) { ret true; }
    ret lanes.packed(?wk.w, d.opcode, lane, to_lane(wk, d, row, lane), c, Slice[Type]{data: ?all[0], size: n});
}

# the lane type an operation is stated at: its first vector operand's, a
# select's first selected vector's, or its result's where it reads none
fun subject_lane(wk: *Walk, d: *InstructionData) Type {
    var k: usize = 0;
    if (d.opcode.index == opcode.SELECT.index) { k = 1; }
    for (k < d.operands.len) {
        val ty: Type = lanes.type_of(?wk.w, d.operands.data[k]);
        if (is_vector(wk, ty)) { ret element(wk, ty); }
        k = k + 1;
    }
    if (d.results.len > 0) { ret element(wk, lanes.type_of(?wk.w, d.results.data[0])); }
    ret Type{index: 0};
}

# whether a type is an integer wider than the widest the target computes at,
# which the wide integer legalisation splits into words
fun wide_integer(wk: *Walk, ty: Type) bool {
    val s: res[types.Shape, types.Error] = types.shape(?wk.w.site.m.types, ty);
    if (sel s.err)           { ret false; }
    if (!(sel s.ok.integer)) { ret false; }
    val top: opt[u32] = targets.widest(wk.w.caps);
    if (sel top.none) { ret false; }
    ret s.ok.integer.width > top.some;
}

# whether a reinterpretation is between a vector and a wide integer, which
# goes through a slot here, so the wide integer legalisation splits the
# integer's access into words and makes no lane operation no unit computes
fun wide_recast(wk: *Walk, d: *InstructionData) bool {
    if (d.operands.len != 1 || d.results.len != 1) { ret false; }
    val from: Type = lanes.type_of(?wk.w, d.operands.data[0]);
    val to:   Type = lanes.type_of(?wk.w, d.results.data[0]);
    if (is_vector(wk, from) && wide_integer(wk, to)) { ret true; }
    ret is_vector(wk, to) && wide_integer(wk, from);
}

# how an instruction is legalised
fun form_of(wk: *Walk, d: *InstructionData) Form {
    var touches: bool  = false;
    var split:   bool  = false;
    var k:       usize = 0;
    for (k < d.operands.len + d.results.len) {
        var x: Value = Value{index: 0};
        if (k < d.operands.len) { x = d.operands.data[k]; }
        or                      { x = d.results.data[k - d.operands.len]; }
        val ty: Type = lanes.type_of(?wk.w, x);
        if (is_vector(wk, ty)) {
            touches = true;
            if (unheld(wk, ty)) { split = true; }
        }
        k = k + 1;
    }
    var k2: usize = 0;
    for (k2 < d.immediates.len && !touches) {
        val imm: Immediate = d.immediates.data[k2];
        if (sel imm.ty && is_vector(wk, imm.ty)) { touches = true; }
        k2 = k2 + 1;
    }
    if (!touches) { ret Form.none{}; }
    val code: Opcode = d.opcode;
    if (crosses(code)) {
        if (!split)  { ret Form.none{}; }
        if (wk.late) { ret Form.refused{BOUNDARY}; }
        ret Form.boundary{};
    }
    val got: opt[Row] = opcode.row(code);
    if (sel got.none) { ret Form.refused{ROWLESS}; }
    val row:  Row  = got.some;
    val c:    u32  = code.index;
    val lane: Type = subject_lane(wk, d);
    if (c == opcode.LOAD.index) {
        if (split) { ret Form.load{}; }
        ret Form.none{};
    }
    if (c == opcode.STORE.index) {
        if (split) { ret Form.store{}; }
        ret Form.none{};
    }
    if (c == opcode.BITCAST.index) {
        if (split || wide_recast(wk, d)) { ret Form.recast{}; }
        ret Form.none{};
    }
    if (c == opcode.DECLASSIFY.index) {
        if (split) { ret Form.declassify{}; }
        ret Form.none{};
    }
    var form: Form = Form.refused{OPAQUE};
    if (sel row.vector.lanewise)         { form = Form.lanewise{}; }
    or (sel row.vector.across)           { form = Form.reduce{}; }
    or (c == opcode.VSPLAT.index)        { form = Form.splat{}; }
    or (c == opcode.VBUILD.index)        { form = Form.build{}; }
    or (c == opcode.VEXTRACT.index)      { form = Form.extract{}; }
    or (c == opcode.VINSERT.index)       { form = Form.insert{}; }
    or (c == opcode.VSHUFFLE.index)      { form = Form.shuffle{}; }
    or (!split)                          { ret Form.none{}; }
    if (sel form.refused)                { ret form; }
    if (split)                           { ret form; }
    if (packed_whole(wk, d, ?row, lane)) { ret Form.none{}; }
    ret form;
}

# the mark of each instruction, every non-entry parameter to split counted,
# and whether anything is legalised
fun scan(wk: *Walk) res[bool, Why] {
    val b:    *Body                       = body_of(wk);
    var none: Mark                        = Mark{form: Form.none{}, block: Block{index: 0}, state: 0};
    val room: res[usize, allocator.Error] = vector.reserve[Mark](?wk.marks, b.instructions.len);
    if (sel room.err) { ret res[bool, Why].err{lost(room.err)}; }
    var i: usize = 0;
    for (i < b.instructions.len) {
        vector.push[Mark](?wk.marks, none);
        i = i + 1;
    }
    var any: bool  = false;
    var k:   usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var p: usize = 0;
            for (p < b.blocks.data[k].parameters.len) {
                val ty: Type = lanes.type_of(?wk.w, b.blocks.data[k].parameters.data[p]);
                if (is_vector(wk, ty) && unheld(wk, ty)) {
                    if (k == 0 && wk.late) { ret res[bool, Why].err{Why.reason{BOUNDARY}}; }
                    if (k != 0)            { any = true; }
                }
                p = p + 1;
            }
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val at:   Instruction      = b.blocks.data[k].instructions.data[n];
                val d:    *InstructionData = ?b.instructions.data[at.index];
                val form: Form             = form_of(wk, d);
                if (sel wk.w.failed.some) { ret res[bool, Why].err{wk.w.failed.some}; }
                if (sel form.refused)     { ret res[bool, Why].err{Why.reason{form.refused}}; }
                if (!(sel form.none)) {
                    wk.marks.data[at.index].form  = form;
                    wk.marks.data[at.index].block = Block{index: k::u32};
                    any                           = true;
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret res[bool, Why].ok{any};
}

# whether an instruction is one to legalise, by its mark
fun marked(wk: *Walk, i: Instruction) bool {
    if (i.index::usize >= wk.marks.len) { ret false; }
    val f: Form = wk.marks.data[i.index].form;
    ret !(sel f.none);
}

# the instruction defining an operand, when it is one to legalise
fun feeder(wk: *Walk, x: Value) opt[Instruction] {
    val def: Def = body_of(wk).values.data[x.index].def;
    if (!(sel def.result))                   { ret opt[Instruction].none{}; }
    if (!marked(wk, def.result.instruction)) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{def.result.instruction};
}

# a frame of the walk of definitions
# ---
# at:   the instruction
# next: the next operand to follow
rec Frame {
    at:   Instruction;
    next: usize;
}

# order the instructions to legalise so each follows those defining what it
# reads, whatever block holds it
fun order(wk: *Walk) err[Why] {
    val b:     *Body                = body_of(wk);
    var stack: vector.Vector[Frame] = vector.init[Frame](wk.w.keep);
    var k:     usize                = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val start: Instruction = b.blocks.data[k].instructions.data[n];
                if (marked(wk, start) && wk.marks.data[start.index].state == 0) {
                    val pushed: res[usize, allocator.Error] = vector.push[Frame](?stack, Frame{at: start, next: 0});
                    if (sel pushed.err) { ret err[Why].err{lost(pushed.err)}; }
                    wk.marks.data[start.index].state = 1;
                    for (stack.len > 0) {
                        val top: *Frame           = ?stack.data[stack.len - 1];
                        val d:   *InstructionData = ?b.instructions.data[top.at.index];
                        if (top.next < d.operands.len) {
                            val x: Value = d.operands.data[top.next];
                            top.next = top.next + 1;
                            val f: opt[Instruction] = feeder(wk, x);
                            if (sel f.some) {
                                val s: u8 = wk.marks.data[f.some.index].state;
                                if (s == 1) { ret err[Why].err{Why.reason{CYCLE}}; }
                                if (s == 0) {
                                    wk.marks.data[f.some.index].state = 1;
                                    val more: res[usize, allocator.Error] = vector.push[Frame](?stack, Frame{at: f.some, next: 0});
                                    if (sel more.err) { ret err[Why].err{lost(more.err)}; }
                                }
                            }
                        }
                        or {
                            wk.marks.data[top.at.index].state = 2;
                            val listed: res[usize, allocator.Error] = vector.push[Instruction](?wk.order, top.at);
                            if (sel listed.err) { ret err[Why].err{lost(listed.err)}; }
                            vector.truncate[Frame](?stack, stack.len - 1);
                        }
                    }
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret err[Why].ok{};
}

# split every parameter of a block other than the entry whose type no unit
# holds into one parameter per run of its layout, each edge passing nothing
# until its arguments are cut
fun split_parameters(wk: *Walk) err[Why] {
    val w:    *Work                       = ?wk.w;
    val b:    *Body                       = body_of(wk);
    val room: res[usize, allocator.Error] = vector.reserve[u32](?wk.before, b.blocks.len);
    if (sel room.err) { ret err[Why].err{lost(room.err)}; }
    var k: usize = 0;
    for (k < b.blocks.len) {
        vector.push[u32](?wk.before, UNTOUCHED);
        k = k + 1;
    }
    k = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val total: usize = b.blocks.data[k].parameters.len;
            var p:     usize = 0;
            for (p < total) {
                val old: Value = b.blocks.data[k].parameters.data[p];
                val ty:  Type  = lanes.type_of(w, old);
                if (is_vector(wk, ty) && unheld(wk, ty)) {
                    wk.before.data[k] = total::u32;
                    val runs:   Slice[Run]  = lanes.runs_of(w, ty);
                    val made:   Slice[Part] = lanes.fresh(w, runs.size);
                    val lane:   Type        = element(wk, ty);
                    val secret: bool        = b.values.data[old.index].secret;
                    val preds:  usize       = b.blocks.data[k].predecessors.len;
                    if (sel w.failed.some) { ret err[Why].err{w.failed.some}; }
                    var j: usize = 0;
                    for (j < runs.size) {
                        val pty:  Type            = lanes.run_type(w, lane, runs.data[j].count, runs.data[j].scalar);
                        val zero: res[Value, Why] = zero_of(wk, pty);
                        if (sel zero.err) { ret err[Why].err{zero.err}; }
                        val incoming: res[Slice[Value], allocator.Error] = repeat(w.keep, zero.ok, preds);
                        if (sel incoming.err) { ret err[Why].err{lost(incoming.err)}; }
                        val added: res[Value, module.Error] = body.add_parameter(w.site.m, w.site.f, Block{index: k::u32}, Declaration{type: pty, secret: secret, name: opt[View].none{}}, incoming.ok);
                        if (sel added.err) { ret err[Why].err{Why.ir{added.err}}; }
                        made.data[j] = Part{run: runs.data[j], value: added.ok};
                        j            = j + 1;
                    }
                    lanes.hold(w, old, made);
                    val listed: res[usize, allocator.Error] = vector.push[Parameter](?wk.params, Parameter{block: Block{index: k::u32}, old: old});
                    if (sel listed.err) { ret err[Why].err{lost(listed.err)}; }
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    if (sel w.failed.some) { ret err[Why].err{w.failed.some}; }
    ret err[Why].ok{};
}

# the constant zero of a type, which an edge passes a split parameter until
# its arguments are cut
fun zero_of(wk: *Walk, ty: Type) res[Value, Why] {
    val z: res[folder.Value, Why] = number.zero_of(wk.w.site.m, wk.w.site.scratch, ty);
    if (sel z.err) { ret res[Value, Why].err{z.err}; }
    ret number.place(wk.w.site.m, wk.w.site.f, wk.w.site.scratch, z.ok);
}

# n copies of one value
fun repeat(a: *allocator.Allocator, x: Value, n: usize) res[Slice[Value], allocator.Error] {
    if (n == 0) { ret res[Slice[Value], allocator.Error].ok{Slice[Value]{data: nil, size: 0}}; }
    val got: res[*Value, allocator.Error] = allocator.zallocate[Value](a, n);
    if (sel got.err) { ret res[Slice[Value], allocator.Error].err{got.err}; }
    var k: usize = 0;
    for (k < n) {
        got.ok[k] = x;
        k         = k + 1;
    }
    ret res[Slice[Value], allocator.Error].ok{Slice[Value]{data: got.ok, size: n}};
}

# copy an instruction's lists into the visit's storage
fun copy_of(wk: *Walk, d: *InstructionData) res[Copied, Why] {
    val got: opt[Row] = opcode.row(d.opcode);
    if (sel got.none) { ret res[Copied, Why].err{Why.reason{ROWLESS}}; }
    var c: Copied;
    c.code  = d.opcode;
    c.row   = got.some;
    c.flags = d.metadata.flags;
    val ops: res[Slice[Value], allocator.Error] = copied_values(wk.w.keep, d.operands.data, d.operands.len);
    if (sel ops.err) { ret res[Copied, Why].err{lost(ops.err)}; }
    c.operands = ops.ok;
    val outs: res[Slice[Value], allocator.Error] = copied_values(wk.w.keep, d.results.data, d.results.len);
    if (sel outs.err) { ret res[Copied, Why].err{lost(outs.err)}; }
    c.results    = outs.ok;
    c.immediates = Slice[Immediate]{data: nil, size: 0};
    if (d.immediates.len != 0) {
        val imm: res[*Immediate, allocator.Error] = allocator.zallocate[Immediate](wk.w.keep, d.immediates.len);
        if (sel imm.err) { ret res[Copied, Why].err{lost(imm.err)}; }
        var k: usize = 0;
        for (k < d.immediates.len) {
            imm.ok[k] = d.immediates.data[k];
            k         = k + 1;
        }
        c.immediates = Slice[Immediate]{data: imm.ok, size: d.immediates.len};
    }
    ret res[Copied, Why].ok{c};
}

fun copied_values(a: *allocator.Allocator, from: *Value, n: usize) res[Slice[Value], allocator.Error] {
    if (n == 0) { ret res[Slice[Value], allocator.Error].ok{Slice[Value]{data: nil, size: 0}}; }
    val got: res[*Value, allocator.Error] = allocator.zallocate[Value](a, n);
    if (sel got.err) { ret res[Slice[Value], allocator.Error].err{got.err}; }
    var k: usize = 0;
    for (k < n) {
        got.ok[k] = from[k];
        k         = k + 1;
    }
    ret res[Slice[Value], allocator.Error].ok{Slice[Value]{data: got.ok, size: n}};
}

# what a rewrite leaves for a result: its parts where its type is split, or
# the value standing for it where it is held
# ---
# parts: the parts, empty for a held result
# value: the value standing for it
rec Left {
    parts: Slice[Part];
    value: opt[Value];
}

fun left_parts(parts: Slice[Part]) Left {
    ret Left{parts: parts, value: opt[Value].none{}};
}

fun left_value(x: Value) Left {
    ret Left{parts: Slice[Part]{data: nil, size: 0}, value: opt[Value].some{x}};
}

# what parts leave for a result of a type: the parts where no unit holds the
# type, and the value put together of them where one does
fun leave(wk: *Walk, ty: Type, parts: Slice[Part]) Left {
    if (unheld(wk, ty)) { ret left_parts(parts); }
    ret left_value(lanes.assemble(?wk.w, ty, parts));
}

# the runs an operation is taken over: the layout of the type with the widest
# lane it reads or gives, a held vector's one whole run
fun governing(wk: *Walk, c: *Copied) Slice[Run] {
    var best:  Type  = Type{index: 0};
    var bits:  u32   = 0;
    var found: bool  = false;
    var k:     usize = 0;
    for (k < c.operands.size + c.results.size) {
        var x: Value = Value{index: 0};
        if (k < c.operands.size) { x = c.operands.data[k]; }
        or                       { x = c.results.data[k - c.operands.size]; }
        val ty: Type = lanes.type_of(?wk.w, x);
        if (is_vector(wk, ty)) {
            val b: u32 = lanes.lane_bits(?wk.w, element(wk, ty));
            if (!found || b > bits) {
                best  = ty;
                bits  = b;
                found = true;
            }
        }
        k = k + 1;
    }
    ret lanes.runs_of(?wk.w, best);
}

# a run expanded into its lanes, each a scalar run
fun lanes_of(wk: *Walk, r: Run) Slice[Run] {
    if (r.scalar) {
        val one: res[*Run, allocator.Error] = allocator.zallocate[Run](wk.w.site.scratch, 1);
        if (sel one.err) {
            lanes.fail(?wk.w, lost(one.err));
            ret Slice[Run]{data: nil, size: 0};
        }
        one.ok[0] = r;
        ret Slice[Run]{data: one.ok, size: 1};
    }
    val got: res[*Run, allocator.Error] = allocator.zallocate[Run](wk.w.site.scratch, r.count::usize);
    if (sel got.err) {
        lanes.fail(?wk.w, lost(got.err));
        ret Slice[Run]{data: nil, size: 0};
    }
    var k: u32 = 0;
    for (k < r.count) {
        got.ok[k] = Run{from: r.from + k, count: 1, scalar: true};
        k         = k + 1;
    }
    ret Slice[Run]{data: got.ok, size: r.count::usize};
}

# the parts of each result of an operation, n results of at most two
rec Results {
    each: [2]vector.Vector[Part];
    n:    usize;
}

# one run of a lanewise operation: its operands cut to the run, its vector
# immediates retyped to it, and the operation made on them
fun lanewise_run(wk: *Walk, c: *Copied, r: Run, out: *Results) {
    val w:   *Work                        = ?wk.w;
    val ops: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, c.operands.size + 1);
    if (sel ops.err) {
        lanes.fail(w, lost(ops.err));
        ret;
    }
    var k: usize = 0;
    for (k < c.operands.size) {
        val x:  Value = c.operands.data[k];
        val ty: Type  = lanes.type_of(w, x);
        if (is_vector(wk, ty)) { ops.ok[k] = lanes.run(w, x, r); }
        or                     { ops.ok[k] = x; }
        k = k + 1;
    }
    val imm: res[*Immediate, allocator.Error] = allocator.zallocate[Immediate](w.site.scratch, c.immediates.size + 1);
    if (sel imm.err) {
        lanes.fail(w, lost(imm.err));
        ret;
    }
    k = 0;
    for (k < c.immediates.size) {
        val i:   Immediate = c.immediates.data[k];
        var put: Immediate = i;
        if (sel i.ty) {
            if (is_vector(wk, i.ty)) { put = Immediate.ty{lanes.run_type(w, element(wk, i.ty), r.count, r.scalar)}; }
        }
        imm.ok[k] = put;
        k         = k + 1;
    }
    emit.flags(?w.site, c.flags);
    val made: Instruction = emit.make(?w.site, c.code, Slice[Value]{data: ops.ok, size: c.operands.size}, Slice[Immediate]{data: imm.ok, size: c.immediates.size});
    emit.flags(?w.site, NO_FLAGS);
    var j: usize = 0;
    for (j < out.n) {
        val x:      Value                       = emit.result(?w.site, made, j::u32);
        val pushed: res[usize, allocator.Error] = vector.push[Part](?out.each[j], Part{run: r, value: x});
        if (sel pushed.err) { lanes.fail(w, lost(pushed.err)); }
        j = j + 1;
    }
}

# a lanewise operation over the runs of its widest lane, each packed where a
# unit computes it there and lane by lane otherwise
fun lanewise(wk: *Walk, c: *Copied) Slice[Left] {
    val w:    *Work      = ?wk.w;
    val runs: Slice[Run] = governing(wk, c);
    var out:  Results;
    out.n = c.results.size;
    if (out.n > 2) { out.n = 2; }
    out.each[0] = vector.init[Part](w.keep);
    out.each[1] = vector.init[Part](w.keep);
    var all: [8]Type;
    var n:   usize = 0;
    var k:   usize = 0;
    for (k < c.operands.size + c.results.size) {
        var x: Value = Value{index: 0};
        if (k < c.operands.size) { x = c.operands.data[k]; }
        or                       { x = c.results.data[k - c.operands.size]; }
        val ty: Type = lanes.type_of(w, x);
        if (is_vector(wk, ty) && n < lanes.MOST_LANES) {
            all[n] = element(wk, ty);
            n      = n + 1;
        }
        k = k + 1;
    }
    var lane: Type = Type{index: 0};
    if (n != 0)                                       { lane = all[0]; }
    if (c.code.index == opcode.SELECT.index && n > 1) { lane = all[1]; }
    var to:    Type          = lane;
    val first: opcode.Result = c.row.results[0];
    if (sel first.same) {
        val subject: opcode.Subject = first.same;
        if (sel subject.immediate) {
            if (subject.immediate::usize < c.immediates.size) {
                val i: Immediate = c.immediates.data[subject.immediate];
                if (sel i.ty) { to = element(wk, i.ty); }
            }
        }
    }
    var r: usize = 0;
    for (r < runs.size && sel w.failed.none) {
        val run: Run = runs.data[r];
        if (!run.scalar && lanes.packed(w, c.code, lane, to, run.count, Slice[Type]{data: ?all[0], size: n})) { lanewise_run(wk, c, run, ?out); }
        or {
            val each: Slice[Run] = lanes_of(wk, run);
            var e:    usize      = 0;
            for (e < each.size) {
                lanewise_run(wk, c, each.data[e], ?out);
                e = e + 1;
            }
        }
        r = r + 1;
    }
    val left: res[*Left, allocator.Error] = allocator.zallocate[Left](w.keep, 2);
    if (sel left.err) {
        lanes.fail(w, lost(left.err));
        ret Slice[Left]{data: nil, size: 0};
    }
    var j: usize = 0;
    for (j < out.n && sel w.failed.none) {
        left.ok[j] = leave(wk, lanes.type_of(w, c.results.data[j]), Slice[Part]{data: out.each[j].data, size: out.each[j].len});
        j          = j + 1;
    }
    ret Slice[Left]{data: left.ok, size: out.n};
}

# the scalar operation a reduction combines two lanes by, none for a minimum
# or maximum of integers, which compares and selects
fun combiner(code: Opcode) opt[Opcode] {
    val c: u32 = code.index;
    if (c == opcode.REDUCE_ADD.index)                                           { ret opt[Opcode].some{opcode.ADD}; }
    if (c == opcode.REDUCE_MUL.index)                                           { ret opt[Opcode].some{opcode.MUL}; }
    if (c == opcode.REDUCE_AND.index)                                           { ret opt[Opcode].some{opcode.AND}; }
    if (c == opcode.REDUCE_OR.index)                                            { ret opt[Opcode].some{opcode.OR}; }
    if (c == opcode.REDUCE_XOR.index)                                           { ret opt[Opcode].some{opcode.XOR}; }
    if (c == opcode.REDUCE_FADD_ANY.index || c == opcode.REDUCE_FADD_SEQ.index) { ret opt[Opcode].some{opcode.FADD}; }
    if (c == opcode.REDUCE_FMUL_ANY.index || c == opcode.REDUCE_FMUL_SEQ.index) { ret opt[Opcode].some{opcode.FMUL}; }
    if (c == opcode.REDUCE_FMIN.index)                                          { ret opt[Opcode].some{opcode.FMIN}; }
    if (c == opcode.REDUCE_FMAX.index)                                          { ret opt[Opcode].some{opcode.FMAX}; }
    if (c == opcode.REDUCE_FMINNUM.index)                                       { ret opt[Opcode].some{opcode.FMINNUM}; }
    if (c == opcode.REDUCE_FMAXNUM.index)                                       { ret opt[Opcode].some{opcode.FMAXNUM}; }
    ret opt[Opcode].none{};
}

# the comparison a minimum or maximum of integers keeps its first operand by
fun chooser(code: Opcode) Opcode {
    val c: u32 = code.index;
    if (c == opcode.REDUCE_SMIN.index) { ret opcode.LT_S; }
    if (c == opcode.REDUCE_SMAX.index) { ret opcode.GT_S; }
    if (c == opcode.REDUCE_UMIN.index) { ret opcode.LT_U; }
    ret opcode.GT_U;
}

# two lanes combined as a reduction combines them
fun combine(wk: *Walk, code: Opcode, a: Value, b: Value) Value {
    val by: opt[Opcode] = combiner(code);
    if (sel by.some) { ret emit.binary(?wk.w.site, by.some, a, b); }
    val keep: Value = emit.binary(?wk.w.site, chooser(code), a, b);
    ret emit.ternary(?wk.w.site, opcode.SELECT, keep, a, b);
}

# a reduction of a run, packed where a unit computes it there, and lane by
# lane otherwise, combined into an accumulator where one is given
fun reduce_run(wk: *Walk, c: *Copied, x: Value, r: Run, acc: opt[Value]) opt[Value] {
    val w:    *Work = ?wk.w;
    val lane: Type  = element(wk, lanes.type_of(w, x));
    var have: bool  = false;
    var into: Value = Value{index: 0};
    if (sel acc.some) {
        have = true;
        into = acc.some;
    }
    if (!r.scalar && lanes.packed_at(w, c.code, lane, r.count)) {
        val piece: Value = lanes.run(w, x, r);
        val one:   Value = emit.unary(?w.site, c.code, piece);
        if (have) { ret opt[Value].some{combine(wk, c.code, into, one)}; }
        ret opt[Value].some{one};
    }
    val each: Slice[Run] = lanes_of(wk, r);
    var e:    usize      = 0;
    for (e < each.size && sel w.failed.none) {
        val one: Value = lanes.run(w, x, each.data[e]);
        if (have) { into = combine(wk, c.code, into, one); }
        or        { into = one; }
        have = true;
        e    = e + 1;
    }
    if (!have) { ret opt[Value].none{}; }
    ret opt[Value].some{into};
}

# a reduction over its operand's runs: a sequential one reduces its first run
# packed only where that run starts the vector, and then takes lane after lane
fun reduce(wk: *Walk, c: *Copied) Value {
    val w:    *Work       = ?wk.w;
    val x:    Value       = c.operands.data[0];
    var runs: Slice[Run]  = lanes.runs_of(w, lanes.type_of(w, x));
    val held: Slice[Part] = lanes.parts_of(w, x);
    if (held.size != 0) {
        val got: res[*Run, allocator.Error] = allocator.zallocate[Run](w.site.scratch, held.size);
        if (sel got.err) {
            lanes.fail(w, lost(got.err));
            ret Value{index: 0};
        }
        var k: usize = 0;
        for (k < held.size) {
            got.ok[k] = held.data[k].run;
            k         = k + 1;
        }
        runs = Slice[Run]{data: got.ok, size: held.size};
    }
    val seq: bool       = sel c.row.order.sequential;
    var acc: opt[Value] = opt[Value].none{};
    var r:   usize      = 0;
    for (r < runs.size && sel w.failed.none) {
        if (seq && r > 0) {
            val each: Slice[Run] = lanes_of(wk, runs.data[r]);
            var e:    usize      = 0;
            for (e < each.size) {
                acc = reduce_run(wk, c, x, each.data[e], acc);
                e   = e + 1;
            }
        }
        or { acc = reduce_run(wk, c, x, runs.data[r], acc); }
        r = r + 1;
    }
    if (sel acc.none) { ret Value{index: 0}; }
    ret acc.some;
}

# the parts of a vector each of whose runs is made by a function of the run,
# packed where a unit computes an operation at the run's count
# ---
# ty:      the vector type
# code:    the operation a packed run is made by
# scalars: one scalar per lane, the lanes the vector is made of
fun from_scalars(wk: *Walk, ty: Type, code: Opcode, scalars: Slice[Value]) Left {
    val w:     *Work       = ?wk.w;
    val lane:  Type        = element(wk, ty);
    val runs:  Slice[Run]  = lanes.runs_of(w, ty);
    val parts: Slice[Part] = lanes.fresh(w, runs.size);
    if (sel w.failed.some) { ret left_parts(parts); }
    if (!unheld(wk, ty)) {
        val each: Slice[Part] = lanes.fresh(w, scalars.size);
        var k:    usize       = 0;
        for (k < each.size) {
            each.data[k] = Part{run: Run{from: k::u32, count: 1, scalar: true}, value: scalars.data[k]};
            k            = k + 1;
        }
        ret left_value(lanes.assemble(w, ty, each));
    }
    var r: usize = 0;
    for (r < runs.size && sel w.failed.none) {
        val run: Run = runs.data[r];
        if (run.scalar) { parts.data[r] = Part{run: run, value: scalars.data[run.from]}; }
        or {
            val pty: Type         = lanes.run_type(w, lane, run.count, false);
            val sub: Slice[Value] = Slice[Value]{data: ?scalars.data[run.from], size: run.count::usize};
            if (code.index == opcode.VBUILD.index && lanes.packed_at(w, code, lane, run.count)) { parts.data[r] = Part{run: run, value: lanes.build(w, pty, sub)}; }
            or {
                val each: Slice[Part] = lanes.fresh(w, run.count::usize);
                var k:    usize       = 0;
                for (k < each.size) {
                    each.data[k] = Part{run: Run{from: k::u32, count: 1, scalar: true}, value: sub.data[k]};
                    k            = k + 1;
                }
                parts.data[r] = Part{run: run, value: lanes.assemble(w, pty, each)};
            }
        }
        r = r + 1;
    }
    ret left_parts(parts);
}

# a splat: a packed splat of each run a unit splats, and the scalar in every
# other lane
fun splat(wk: *Walk, c: *Copied) Left {
    val w:    *Work = ?wk.w;
    val ty:   Type  = lanes.type_of(w, c.results.data[0]);
    val s:    Value = c.operands.data[0];
    val lane: Type  = element(wk, ty);
    val n:    u32   = count(wk, ty);
    if (unheld(wk, ty)) {
        val runs:  Slice[Run]  = lanes.runs_of(w, ty);
        val parts: Slice[Part] = lanes.fresh(w, runs.size);
        var r:     usize       = 0;
        for (r < parts.size && sel w.failed.none) {
            val run: Run = runs.data[r];
            if (run.scalar)                                         { parts.data[r] = Part{run: run, value: s}; }
            or (lanes.packed_at(w, opcode.VSPLAT, lane, run.count)) { parts.data[r] = Part{run: run, value: emit.convert(?w.site, opcode.VSPLAT, s, lanes.run_type(w, lane, run.count, false))}; }
            or                                                      { parts.data[r] = Part{run: run, value: repeated(wk, lane, run.count, s)}; }
            r = r + 1;
        }
        ret left_parts(parts);
    }
    ret left_value(repeated(wk, lane, n, s));
}

# a held vector of n lanes of one scalar, put together lane by lane
fun repeated(wk: *Walk, lane: Type, n: u32, s: Value) Value {
    val w:    *Work       = ?wk.w;
    val each: Slice[Part] = lanes.fresh(w, n::usize);
    var k:    usize       = 0;
    for (k < each.size) {
        each.data[k] = Part{run: Run{from: k::u32, count: 1, scalar: true}, value: s};
        k            = k + 1;
    }
    ret lanes.assemble(w, lanes.run_type(w, lane, n, false), each);
}

# an insert: the run holding the lane given the scalar, packed where a unit
# inserts there, every other run as it was
fun insert(wk: *Walk, c: *Copied) Left {
    val w:    *Work = ?wk.w;
    val x:    Value = c.operands.data[0];
    val s:    Value = c.operands.data[1];
    val ty:   Type  = lanes.type_of(w, x);
    val lane: Type  = element(wk, ty);
    var at:   u32   = 0;
    if (c.immediates.size > 0) {
        val i: Immediate = c.immediates.data[0];
        if (sel i.lane) { at = i.lane; }
    }
    if (!unheld(wk, ty)) {
        var two: [2]Part = [2]Part{Part{run: Run{from: 0, count: count(wk, ty), scalar: false}, value: x}, Part{run: Run{from: at, count: 1, scalar: true}, value: s}};
        ret left_value(lanes.assemble(w, ty, Slice[Part]{data: ?two[0], size: 2}));
    }
    val runs:  Slice[Run]  = lanes.runs_of(w, ty);
    val parts: Slice[Part] = lanes.fresh(w, runs.size);
    var r:     usize       = 0;
    for (r < parts.size && sel w.failed.none) {
        val run: Run = runs.data[r];
        if (run.from <= at && at < run.from + run.count) {
            if (run.scalar) { parts.data[r] = Part{run: run, value: s}; }
            or {
                val piece: Value = lanes.run(w, x, run);
                val pty:   Type  = lanes.run_type(w, lane, run.count, false);
                if (lanes.packed_at(w, opcode.VINSERT, lane, run.count)) {
                    var ops: [2]Value     = [2]Value{piece, s};
                    var imm: [1]Immediate = [1]Immediate{Immediate.lane{at - run.from}};
                    val i:   Instruction  = emit.make(?w.site, opcode.VINSERT, Slice[Value]{data: ?ops[0], size: 2}, Slice[Immediate]{data: ?imm[0], size: 1});
                    parts.data[r] = Part{run: run, value: emit.result(?w.site, i, 0)};
                }
                or {
                    var two: [2]Part = [2]Part{Part{run: Run{from: 0, count: run.count, scalar: false}, value: piece}, Part{run: Run{from: at - run.from, count: 1, scalar: true}, value: s}};
                    parts.data[r] = Part{run: run, value: lanes.assemble(w, pty, Slice[Part]{data: ?two[0], size: 2})};
                }
            }
        }
        or { parts.data[r] = Part{run: run, value: lanes.run(w, x, run)}; }
        r = r + 1;
    }
    ret left_parts(parts);
}

# where lane i of a shuffle's result comes from: an operand and its lane
rec Source {
    value: Value;
    lane:  u32;
}

fun source(c: *Copied, lanes_n: u32, list: Slice[u32], i: u32) Source {
    val idx: u32 = list.data[i];
    if (idx < lanes_n) { ret Source{value: c.operands.data[0], lane: idx}; }
    ret Source{value: c.operands.data[1], lane: idx - lanes_n};
}

# one run of a shuffle's result: the run of one operand it repeats in order,
# a packed shuffle of one held part of one operand where a unit shuffles
# there, and otherwise its lanes put together
fun shuffle_run(wk: *Walk, c: *Copied, lanes_n: u32, list: Slice[u32], lane: Type, r: Run) Value {
    val w:     *Work  = ?wk.w;
    val first: Source = source(c, lanes_n, list, r.from);
    if (r.scalar) { ret lanes.run(w, first.value, Run{from: first.lane, count: 1, scalar: true}); }
    var same:  bool = true;
    var order: bool = true;
    var low:   u32  = first.lane;
    var high:  u32  = first.lane;
    var k:     u32  = 1;
    for (k < r.count) {
        val s: Source = source(c, lanes_n, list, r.from + k);
        if (s.value.index != first.value.index) { same = false; }
        if (s.lane != first.lane + k)           { order = false; }
        if (s.lane < low)                       { low = s.lane; }
        if (s.lane > high)                      { high = s.lane; }
        k = k + 1;
    }
    if (same && order) { ret lanes.run(w, first.value, Run{from: first.lane, count: r.count, scalar: false}); }
    val pty: Type = lanes.run_type(w, lane, r.count, false);
    if (same) {
        val span: u32 = high - low + 1;
        if (span >= 2 && lanes.packed_at(w, opcode.VSHUFFLE, lane, span) && lanes.packed_at(w, opcode.VSHUFFLE, lane, r.count)) {
            val piece: Value                      = lanes.run(w, first.value, Run{from: low, count: span, scalar: false});
            val rel:   res[*u32, allocator.Error] = allocator.zallocate[u32](w.site.scratch, r.count::usize);
            if (sel rel.err) {
                lanes.fail(w, lost(rel.err));
                ret Value{index: 0};
            }
            k = 0;
            for (k < r.count) {
                rel.ok[k] = source(c, lanes_n, list, r.from + k).lane - low;
                k         = k + 1;
            }
            ret lanes.shuffle_of(w, piece, piece, pty, Slice[u32]{data: rel.ok, size: r.count::usize});
        }
    }
    val each: Slice[Part] = lanes.fresh(w, r.count::usize);
    k = 0;
    for (k < r.count && sel w.failed.none) {
        val s: Source = source(c, lanes_n, list, r.from + k);
        each.data[k] = Part{run: Run{from: k, count: 1, scalar: true}, value: lanes.run(w, s.value, Run{from: s.lane, count: 1, scalar: true})};
        k            = k + 1;
    }
    ret lanes.assemble(w, pty, each);
}

# a shuffle, run by run of its result
fun shuffle(wk: *Walk, c: *Copied) Left {
    val w:    *Work      = ?wk.w;
    val ty:   Type       = lanes.type_of(w, c.results.data[0]);
    var list: Slice[u32] = Slice[u32]{data: nil, size: 0};
    var k:    usize      = 0;
    for (k < c.immediates.size) {
        val i: Immediate = c.immediates.data[k];
        if (sel i.lanes) { list = i.lanes; }
        k = k + 1;
    }
    val lanes_n: u32         = count(wk, lanes.type_of(w, c.operands.data[0]));
    val lane:    Type        = element(wk, ty);
    val runs:    Slice[Run]  = lanes.runs_of(w, ty);
    val parts:   Slice[Part] = lanes.fresh(w, runs.size);
    var r:       usize       = 0;
    for (r < parts.size && sel w.failed.none) {
        parts.data[r] = Part{run: runs.data[r], value: shuffle_run(wk, c, lanes_n, list, lane, runs.data[r])};
        r             = r + 1;
    }
    if (unheld(wk, ty)) { ret left_parts(parts); }
    ret left_value(parts.data[0].value);
}

# the alignment an access states
fun alignment_of(c: *Copied) u64 {
    var k: usize = 0;
    for (k < c.immediates.size) {
        val i: Immediate = c.immediates.data[k];
        if (sel i.alignment) { ret i.alignment; }
        k = k + 1;
    }
    ret 1;
}

fun access_flags(c: *Copied) Flags {
    ret Flags{volatile: c.flags.volatile, kept: c.flags.kept, bounded: false, checked: false};
}

# a load, one access per run of its type at the run's offset
fun loaded(wk: *Walk, c: *Copied) Left {
    val w:     *Work       = ?wk.w;
    val ty:    Type        = lanes.type_of(w, c.results.data[0]);
    val lane:  Type        = element(wk, ty);
    val runs:  Slice[Run]  = lanes.runs_of(w, ty);
    val parts: Slice[Part] = lanes.fresh(w, runs.size);
    val align: u64         = alignment_of(c);
    val size:  u64         = lane_size(wk, lane);
    var r:     usize       = 0;
    for (r < parts.size && sel w.failed.none) {
        val run: Run = runs.data[r];
        val off: u64 = run.from::u64 * size;
        parts.data[r] = Part{run: run, value: lanes.load(w, lanes.at_offset(w, c.operands.data[0], off), lanes.run_type(w, lane, run.count, run.scalar), lanes.aligned_at(align, off), access_flags(c))};
        r             = r + 1;
    }
    ret left_parts(parts);
}

fun lane_size(wk: *Walk, lane: Type) u64 {
    val size: res[u64, targets.Error] = targets.size(?wk.w.layout, lane, types.DEFAULT_SPACE);
    if (sel size.err) {
        lanes.fail(?wk.w, Why.reason{"the data layout states no size of a vector's lane"});
        ret 1;
    }
    ret size.ok;
}

# the parts a value is read as: those it was split into, or its type's runs
# cut from it
fun parts_for(wk: *Walk, x: Value) Slice[Part] {
    val held: Slice[Part] = lanes.parts_of(?wk.w, x);
    if (held.size != 0) { ret held; }
    ret lanes.cut(?wk.w, x, lanes.runs_of(?wk.w, lanes.type_of(?wk.w, x)));
}

# a store, one access per part at the part's offset, the last in the store's
# place so a kept store is replaced only by a kept one
fun stored(wk: *Walk, c: *Copied, origin: Instruction) {
    val w:     *Work       = ?wk.w;
    val x:     Value       = c.operands.data[1];
    val lane:  Type        = element(wk, lanes.type_of(w, x));
    val parts: Slice[Part] = parts_for(wk, x);
    val align: u64         = alignment_of(c);
    val size:  u64         = lane_size(wk, lane);
    var i:     usize       = 0;
    for (i < parts.size && sel w.failed.none) {
        val off:     u64   = parts.data[i].run.from::u64 * size;
        val address: Value = lanes.at_offset(w, c.operands.data[0], off);
        if (i + 1 == parts.size) { emit.close(?w.site, origin); }
        lanes.store(w, address, parts.data[i].value, lanes.aligned_at(align, off), access_flags(c));
        i = i + 1;
    }
}

# a declassification, part by part
fun declassified(wk: *Walk, c: *Copied) Left {
    val w:     *Work       = ?wk.w;
    val parts: Slice[Part] = parts_for(wk, c.operands.data[0]);
    val out:   Slice[Part] = lanes.fresh(w, parts.size);
    var i:     usize       = 0;
    for (i < out.size && sel w.failed.none) {
        out.data[i] = Part{run: parts.data[i].run, value: emit.unary(?w.site, opcode.DECLASSIFY, parts.data[i].value)};
        i           = i + 1;
    }
    ret leave(wk, lanes.type_of(w, c.results.data[0]), out);
}

# whether a type is a vector of conditions
fun conditions(wk: *Walk, ty: Type) bool {
    if (!is_vector(wk, ty)) { ret false; }
    val s: res[types.Shape, types.Error] = types.shape(?wk.w.site.m.types, element(wk, ty));
    if (sel s.err) { ret false; }
    ret sel s.ok.integer && s.ok.integer.width == 1;
}

# the integer of n bits a vector of conditions packs into, lane 0 lowest
fun pack_conditions(wk: *Walk, x: Value, n: u32, to: Type) Value {
    val w:    *Work = ?wk.w;
    var have: bool  = false;
    var acc:  Value = Value{index: 0};
    var k:    u32   = 0;
    for (k < n && sel w.failed.none) {
        var bit: Value = emit.convert(?w.site, opcode.EXT_U, lanes.run(w, x, Run{from: k, count: 1, scalar: true}), to);
        if (k != 0) {
            val by: res[Value, Why] = emit.constant(?w.site, to, word.small(k::u64));
            if (sel by.err) {
                lanes.fail(w, by.err);
                ret Value{index: 0};
            }
            bit = emit.binary(?w.site, opcode.SHL, bit, by.ok);
        }
        if (have) { acc = emit.binary(?w.site, opcode.OR, acc, bit); }
        or        { acc = bit; }
        have = true;
        k    = k + 1;
    }
    ret acc;
}

# the conditions of an integer of n bits, lane 0 its lowest bit
fun unpack_conditions(wk: *Walk, x: Value, ty: Type) Left {
    val w:    *Work                        = ?wk.w;
    val n:    u32                          = count(wk, ty);
    val bit:  Type                         = element(wk, ty);
    val each: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, n::usize);
    if (sel each.err) {
        lanes.fail(w, lost(each.err));
        ret left_parts(Slice[Part]{data: nil, size: 0});
    }
    val xty: Type = lanes.type_of(w, x);
    var k:   u32  = 0;
    for (k < n && sel w.failed.none) {
        var at: Value = x;
        if (k != 0) {
            val by: res[Value, Why] = emit.constant(?w.site, xty, word.small(k::u64));
            if (sel by.err) {
                lanes.fail(w, by.err);
                ret left_parts(Slice[Part]{data: nil, size: 0});
            }
            at = emit.binary(?w.site, opcode.SHR_U, x, by.ok);
        }
        each.ok[k] = emit.convert(?w.site, opcode.TRUNC, at, bit);
        k          = k + 1;
    }
    ret from_scalars(wk, ty, opcode.VBUILD, Slice[Value]{data: each.ok, size: n::usize});
}

# a value of a type loaded whole from a slot, or by its runs where no unit
# holds it
fun load_from(wk: *Walk, at: Value, align: u64, ty: Type) Left {
    val w: *Work = ?wk.w;
    if (!unheld(wk, ty)) { ret left_value(lanes.load(w, at, ty, align, NO_FLAGS)); }
    val lane:  Type        = element(wk, ty);
    val runs:  Slice[Run]  = lanes.runs_of(w, ty);
    val parts: Slice[Part] = lanes.fresh(w, runs.size);
    val size:  u64         = lane_size(wk, lane);
    var r:     usize       = 0;
    for (r < parts.size && sel w.failed.none) {
        val off: u64 = runs.data[r].from::u64 * size;
        parts.data[r] = Part{run: runs.data[r], value: lanes.load(w, lanes.at_offset(w, at, off), lanes.run_type(w, lane, runs.data[r].count, runs.data[r].scalar), lanes.aligned_at(align, off), NO_FLAGS)};
        r             = r + 1;
    }
    ret left_parts(parts);
}

# a value stored whole to a fresh slot of its type, or by its parts where it
# is split, giving the slot and its alignment
fun store_to(wk: *Walk, x: Value, align: *u64) Value {
    val w:  *Work = ?wk.w;
    val ty: Type  = lanes.type_of(w, x);
    val at: Value = lanes.slot(w, ty, align);
    if (is_vector(wk, ty)) { lanes.store_parts(w, at, @align, element(wk, ty), parts_for(wk, x), NO_FLAGS); }
    or                     { lanes.store(w, at, x, @align, NO_FLAGS); }
    ret at;
}

# a reinterpretation: through a stack slot of the operand's type, and a
# vector of conditions through the integer of its bits
fun recast(wk: *Walk, c: *Copied) Left {
    val w:  *Work = ?wk.w;
    val x:  Value = c.operands.data[0];
    val ty: Type  = lanes.type_of(w, c.results.data[0]);
    if (!wk.little) {
        lanes.fail(w, Why.reason{ENDIAN});
        ret left_parts(Slice[Part]{data: nil, size: 0});
    }
    var from: Value = x;
    val xty:  Type  = lanes.type_of(w, x);
    if (conditions(wk, xty)) {
        val n: u32 = count(wk, xty);
        if (n > types.WIDTHS[$length_of(types.Widths) - 1]) {
            lanes.fail(w, Why.reason{MASK});
            ret left_parts(Slice[Part]{data: nil, size: 0});
        }
        val bits: Type = lanes.integer(w, n);
        from = pack_conditions(wk, x, n, bits);
        if (types.same(bits, ty)) { ret left_value(from); }
    }
    if (conditions(wk, ty)) {
        val n: u32 = count(wk, ty);
        if (n > types.WIDTHS[$length_of(types.Widths) - 1]) {
            lanes.fail(w, Why.reason{MASK});
            ret left_parts(Slice[Part]{data: nil, size: 0});
        }
        val bits: Type = lanes.integer(w, n);
        if (!types.same(lanes.type_of(w, from), bits)) {
            var align: u64   = 1;
            val at:    Value = store_to(wk, from, ?align);
            from = lanes.load(w, at, bits, align, NO_FLAGS);
        }
        ret unpack_conditions(wk, from, ty);
    }
    var align: u64   = 1;
    val at:    Value = store_to(wk, from, ?align);
    ret load_from(wk, at, align, ty);
}

# legalise one instruction in its place
fun rewrite(wk: *Walk, i: Instruction) err[Why] {
    val w:    *Work            = ?wk.w;
    val b:    *Body            = body_of(wk);
    val d:    *InstructionData = ?b.instructions.data[i.index];
    val form: Form             = wk.marks.data[i.index].form;
    val k:    Block            = wk.marks.data[i.index].block;
    val got:  res[Copied, Why] = copy_of(wk, d);
    if (sel got.err) { ret err[Why].err{got.err}; }
    var c: Copied = got.ok;
    lanes.open(w, i, k, position(b, k, i));
    var left: Slice[Left] = Slice[Left]{data: nil, size: 0};
    var one:  [1]Left;
    var gone: bool        = true;
    if (sel form.lanewise) { left = lanewise(wk, ?c); }
    or (sel form.reduce) {
        one[0] = left_value(reduce(wk, ?c));
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.splat) {
        one[0] = splat(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.build) {
        one[0] = from_scalars(wk, lanes.type_of(w, c.results.data[0]), opcode.VBUILD, c.operands);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.extract) {
        var at: u32 = 0;
        if (c.immediates.size > 0) {
            val imm: Immediate = c.immediates.data[0];
            if (sel imm.lane) { at = imm.lane; }
        }
        one[0] = left_value(lanes.run(w, c.operands.data[0], Run{from: at, count: 1, scalar: true}));
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.insert) {
        one[0] = insert(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.shuffle) {
        one[0] = shuffle(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.load) {
        one[0] = loaded(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.store) {
        stored(wk, ?c, i);
        gone = false;
    }
    or (sel form.recast) {
        one[0] = recast(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    or (sel form.declassify) {
        one[0] = declassified(wk, ?c);
        left   = Slice[Left]{data: ?one[0], size: 1};
    }
    val done: err[Why] = lanes.finished(w);
    if (sel done.err) { ret done; }
    var j: usize = 0;
    for (j < left.size && j < c.results.size) {
        val l: Left = left.data[j];
        if (l.parts.size != 0) { lanes.hold(w, c.results.data[j], l.parts); }
        if (sel l.value.some) {
            val moved: err[Why] = failure.edit(body.replace(w.site.m, w.site.f, c.results.data[j], l.value.some, Records.follow{}));
            if (sel moved.err) { ret moved; }
        }
        j = j + 1;
    }
    if (sel w.failed.some) { ret err[Why].err{w.failed.some}; }
    if (gone) {
        val listed: res[usize, allocator.Error] = vector.push[Instruction](?wk.gone, i);
        if (sel listed.err) { ret err[Why].err{lost(listed.err)}; }
    }
    ret err[Why].ok{};
}

# give a call or a return that reads a split vector the vector whole, put
# together through a slot ahead of it
fun cross(wk: *Walk, i: Instruction) err[Why] {
    val w:   *Work                              = ?wk.w;
    val b:   *Body                              = body_of(wk);
    val k:   Block                              = wk.marks.data[i.index].block;
    val d:   *InstructionData                   = ?b.instructions.data[i.index];
    val got: res[Slice[Value], allocator.Error] = copied_values(w.keep, d.operands.data, d.operands.len);
    if (sel got.err) { ret err[Why].err{lost(got.err)}; }
    val ops: Slice[Value] = got.ok;
    var n:   usize        = 0;
    for (n < ops.size) {
        val x:     Value       = ops.data[n];
        val parts: Slice[Part] = lanes.parts_of(w, x);
        if (parts.size != 0) {
            lanes.open(w, i, k, position(b, k, i));
            val whole: Value    = lanes.assemble(w, lanes.type_of(w, x), parts);
            val done:  err[Why] = lanes.finished(w);
            if (sel done.err) { ret done; }
            val moved: err[Why] = failure.edit(body.substitute(w.site.m, w.site.f, i, x, whole));
            if (sel moved.err) { ret moved; }
        }
        n = n + 1;
    }
    ret err[Why].ok{};
}

# pass every edge into a block whose parameters were split the runs of its
# arguments, after the arguments it passed before
fun split_edges(wk: *Walk) err[Why] {
    val w: *Work = ?wk.w;
    val b: *Body = body_of(wk);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && b.blocks.data[k].instructions.len != 0) {
            val last:  Instruction = b.blocks.data[k].instructions.data[b.blocks.data[k].instructions.len - 1];
            val edges: usize       = b.instructions.data[last.index].edges.len;
            var e:     usize       = 0;
            for (e < edges) {
                val to:     Block = b.instructions.data[last.index].edges.data[e].block;
                val before: u32   = wk.before.data[to.index];
                if (before != UNTOUCHED) {
                    val wanted: usize                       = b.blocks.data[to.index].parameters.len;
                    var list:   vector.Vector[Value]        = vector.init[Value](w.keep);
                    val room:   res[usize, allocator.Error] = vector.reserve[Value](?list, wanted);
                    if (sel room.err) { ret err[Why].err{lost(room.err)}; }
                    var a: usize = 0;
                    for (a < before::usize) {
                        vector.push[Value](?list, b.instructions.data[last.index].edges.data[e].arguments.data[a]);
                        a = a + 1;
                    }
                    lanes.open(w, last, Block{index: k::u32}, position(b, Block{index: k::u32}, last));
                    a = 0;
                    for (a < before::usize) {
                        val x:  Value = b.instructions.data[last.index].edges.data[e].arguments.data[a];
                        val ty: Type  = lanes.type_of(w, b.blocks.data[to.index].parameters.data[a]);
                        if (is_vector(wk, ty) && unheld(wk, ty)) {
                            val parts: Slice[Part] = lanes.cut(w, x, lanes.runs_of(w, ty));
                            var j:     usize       = 0;
                            for (j < parts.size) {
                                vector.push[Value](?list, parts.data[j].value);
                                j = j + 1;
                            }
                        }
                        a = a + 1;
                    }
                    val done: err[Why] = lanes.finished(w);
                    if (sel done.err) { ret done; }
                    val moved: err[Why] = failure.edit(body.retarget(w.site.m, w.site.f, last, e::u32, to, Slice[Value]{data: list.data, size: list.len}));
                    if (sel moved.err) { ret moved; }
                }
                e = e + 1;
            }
        }
        k = k + 1;
    }
    ret err[Why].ok{};
}

# take out the instructions legalised and the parameters split, which only
# each other and the edges into the split blocks still read
fun remove(wk: *Walk) err[Why] {
    var dead: vector.Vector[Value]        = vector.init[Value](wk.w.keep);
    val room: res[usize, allocator.Error] = vector.reserve[Value](?dead, wk.params.len);
    if (sel room.err) { ret err[Why].err{lost(room.err)}; }
    var p: usize = 0;
    for (p < wk.params.len) {
        vector.push[Value](?dead, wk.params.data[p].old);
        p = p + 1;
    }
    ret failure.edit(body.remove_dead(wk.w.site.m, wk.w.site.f, Slice[Instruction]{data: wk.gone.data, size: wk.gone.len}, Slice[Value]{data: dead.data, size: dead.len}));
}

fun ahead(u: *Unit) res[bool, Why] {
    ret visit(u, false);
}

fun after(u: *Unit) res[bool, Why] {
    ret visit(u, true);
}

# legalise every vector of one function
fun visit(u: *Unit, late: bool) res[bool, Why] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }

    var held: arena.Arena;
    val kept: err[allocator.Error] = arena.init(?held, c.m.a, 0);
    if (sel kept.err) { ret res[bool, Why].err{Why.alloc{kept.err}}; }
    fin { arena.dnit(?held); }
    var keep: allocator.Allocator;
    arena.make(?keep, ?held);
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, Why].err{Why.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    var wk: Walk;
    wk.w.site    = emit.init(c.m, u.f, got.ok, ?scratch);
    wk.w.ctx     = basis.context_of(c.basis);
    wk.w.caps    = ?c.t.caps;
    wk.w.t       = c.t;
    wk.w.layout  = targets.of(c.t, ?c.m.types, wk.w.ctx);
    wk.w.keep    = ?keep;
    wk.w.parts   = vector.init[Slice[Part]](?keep);
    wk.w.layouts = vector.init[lanes.Laid](?keep);
    wk.w.spills  = vector.init[lanes.Spill](?keep);
    wk.w.failed  = opt[Why].none{};
    wk.late      = late;
    wk.little    = c.t.arch.order == reader.LITTLE;
    wk.marks     = vector.init[Mark](?keep);
    wk.order     = vector.init[Instruction](?keep);
    wk.gone      = vector.init[Instruction](?keep);
    wk.params    = vector.init[Parameter](?keep);
    wk.before    = vector.init[u32](?keep);

    val any: res[bool, Why] = scan(?wk);
    if (sel any.err) { ret any; }
    if (!any.ok)     { ret res[bool, Why].ok{false}; }
    val ordered: err[Why] = order(?wk);
    if (sel ordered.err) { ret res[bool, Why].err{ordered.err}; }
    val params: err[Why] = split_parameters(?wk);
    if (sel params.err) { ret res[bool, Why].err{params.err}; }

    var crossing: vector.Vector[Instruction] = vector.init[Instruction](?keep);
    var n:        usize                      = 0;
    for (n < wk.order.len) {
        arena.reset(?ar);
        val i:    Instruction = wk.order.data[n];
        val form: Form        = wk.marks.data[i.index].form;
        if (sel form.boundary) {
            val listed: res[usize, allocator.Error] = vector.push[Instruction](?crossing, i);
            if (sel listed.err) { ret res[bool, Why].err{lost(listed.err)}; }
        }
        or {
            val r: err[Why] = rewrite(?wk, i);
            if (sel r.err) { ret res[bool, Why].err{r.err}; }
        }
        n = n + 1;
    }
    n = 0;
    for (n < crossing.len) {
        arena.reset(?ar);
        val r: err[Why] = cross(?wk, crossing.data[n]);
        if (sel r.err) { ret res[bool, Why].err{r.err}; }
        n = n + 1;
    }
    arena.reset(?ar);
    val edges: err[Why] = split_edges(?wk);
    if (sel edges.err) { ret res[bool, Why].err{edges.err}; }
    val removed: err[Why] = remove(?wk);
    if (sel removed.err) { ret res[bool, Why].err{removed.err}; }
    ret res[bool, Why].ok{true};
}
