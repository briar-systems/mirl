# wide integers split into words of the widest width the target computes at
#
# every integer width is legal in the ir on every target. one wider than the
# widest width the target's arithmetic runs at is held as words of that width,
# low word first, and every operation on it is rewritten over the words by one
# algorithm for every width and every word width: a 512 bit integer over 32 bit
# words takes the path a 128 bit integer over 64 bit words takes. the width is
# read from the target's declarations alone.
#
# - a sum carries and a difference borrows from word to word, and a negation
#   is a difference from zero.
# - and, or, xor and not apply to each word.
# - a shift by a constant moves whole words and then bits across them, and one
#   by a value does the same through selects on the bits of its count. a count
#   of the width or more gives zero or the sign fill, as the ir states.
# - a comparison decides on the top word, read as its opcode reads it, and
#   falls to the words below, read as unsigned, only where those are equal.
#   equality and inequality read whether every word is equal.
# - a product sums the low and high words of the product of every pair of
#   words, the high word written as the ir's high multiply of two words, which
#   the target's multiply forms select or the multiply forms legalisation
#   builds. a high multiply of wide operands is the upper words of the whole
#   product, less each operand read as signed where the other is negative. the
#   pattern of a high multiply a front end writes over words is the multiply
#   forms' and is left as it stands.
# - the counts count word by word, and a byte swap swaps the words and the
#   bytes of each. the overflow forms read the carry, the borrow, the signs or
#   the high half of the whole product.
# - an extension adds zero words or words of the sign fill, a truncation keeps
#   the low words, and a select chooses each word.
# - a load or store is one access per word, at the word's offset by the
#   target's byte order, each carrying the access's flags, so a kept store
#   stays kept in every word. where memory cannot be reinterpreted, a wide
#   integer is held in memory as an array of its words, low word first, and
#   each access reaches its word as that array's element. a block's parameter is one parameter per word,
#   and every edge into it passes the words of its argument.
# - a reinterpretation as a vector whose lanes fill words whole takes each
#   lane from its bits, lane 0 from the low bits, and one back puts each lane
#   in its place. one of a held float wider than a word, which no register holds
#   beside its words, goes through a stack slot of the float: the float is
#   stored and its words loaded, or the words stored and the float loaded,
#   each word at its offset by the target's byte order.
# - a constant is its words.
# - a compare and exchange of two words, on a target that states the compare
#   and swap of two words (`capability.Paired`) and a build meeting its
#   condition, is one `atomic.cmpxchg.words` of the address, the expected words
#   and the desired words, giving the words found and whether they were the
#   expected ones, with the orderings it stated. it stays one atomic access.
#
# an i1 a store writes or a load reads is held in memory as the integer of its
# size in the data layout, 0 or 1, through an address that can be reinterpreted.
#
# the words are made by the builder in front of the instruction they split, so
# they read as it does: its location, its site and its secrecy, and every word
# of a secret value is secret. nothing made branches or reads a value to decide
# anything, so the pass keeps constant time. a variable bound to no more than
# the low word of a split value reads it from the low word, one bound through an
# extension reads what was extended, and one bound to more than a word, which no
# one record can read from two words, is unavailable.
#
# a copy or fill whose length is wider than a pointer takes the low word of
# its length where a range fact bounds the length within the pointer's reach.
#
# what it refuses, each by its own reason: a wide value at a function's entry,
# a call or a return, which the abi legalisation places in register pieces
# before this pass runs; a wide division, remainder or conversion to or from a
# float, which the helpers legalisation calls a helper for first; a vector of
# wide lanes; a wide copy, fill or float reinterpretation through a logical address; a wide atomic, which is
# never split, since its words would not be atomic together, but for a compare
# and exchange of two words on a target that swaps them, refused by the
# target's own reason where the build lacks what that needs; a copy or fill
# whose wide length no range fact bounds; a reinterpretation between a wide
# integer and a float the build holds no unit for; a multi-way branch on a wide
# selector and an aggregate member of a wide integer, which the passes ahead of
# this one take apart.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.bytes.reader;
use mirl.fold.algebra;
use mirl.fold.algebra.Op;
use fold_record: mirl.fold.record;
use fold_table:  mirl.fold.table;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.contents;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.point;
use mirl.ir.point.Bits;
use mirl.ir.point.Expression;
use mirl.ir.point.Operand;
use mirl.ir.point.Part;
use mirl.ir.point.Reads;
use mirl.ir.point.Step;
use mirl.ir.pool.Growing;
use mirl.ir.type.format;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.legal.emit;
use mirl.legal.helper;
use mirl.legal.multiply;
use mirl.legal.wide.arith;
use mirl.legal.wide.arith.Compare;
use mirl.legal.wide.arith.Logic;
use mirl.legal.wide.shift;
use mirl.legal.wide.shift.Way;
use mirl.legal.wide.words;
use mirl.legal.wide.words.Work;
use mirl.opt.number;
use mirl.pass.analysis;
use mirl.pass.analysis.range;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use target_layout: mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.record.Target;

# the pass: it adds and removes instructions and block parameters and never
# touches an edge's target or a block
pub val WIDE: Pass = Pass{name: "wide", kind: Kind.legalise{}, scope: Scope.function{visit}, needs: analysis.OF_RANGES, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

val HELPED:   str = "a wide division, remainder or conversion to or from a float, which the helpers legalisation calls a helper for first";
val BOUNDARY: str = "a wide value at a function's entry, a call or a return, which the abi legalisation places in register pieces first";
val VECTOR:   str = "a vector of integers wider than the target computes at, which the vector legalisation takes lane by lane first";
val LOGICAL:  str = "a wide access through a pointer that cannot be reinterpreted";
val POINTER:  str = "a wide integer meets a pointer wider than a word";
val ATOMIC:   str = "a wide atomic, which words cannot make atomic together, other than a compare and exchange of two words on a target that swaps two words";
val UNBOUND:  str = "a copy or fill whose length is wider than a pointer and that no range fact bounds to one";
val UNHELD:   str = "a reinterpretation between a wide integer and a float the build holds no unit for, which no legalisation computes";
val SHAPE:    str = "a reinterpretation between a wide integer and a type that is no integer, held float or vector of whole words";
val CHAINED:  str = "a multi-way branch on a wide selector, which the compare chain takes apart first";
val MEMBER:   str = "an aggregate member of a wide integer, which the aggregates legalisation takes apart first";
val RELATION: str = "a comparison of wide integers the folder states no relation of, or whose unsigned form the opcode table has none of";
val ROWLESS:  str = "an instruction whose opcode has no row";
val CYCLE:    str = "wide values that define each other in code no path reaches";
val NARROW:   str = "a target whose widest arithmetic is narrower than a byte";

# the condition type's width
val CONDITION: u32 = 1;

# whether the pass rewrites something on a target: an integer width wider
# than its arithmetic, or memory a condition can be stored to
fun wanted(g: *Ground) bool {
    if (sel g.t.caps.addressing.physical) { ret true; }
    val opt_top: opt[u32] = capability.widest(?g.t.caps);
    if (sel opt_top.none) { ret false; }
    ret opt_top.some < type_table.WIDTHS[$length_of(type_table.Widths) - 1];
}

# the width of the words the pass splits an integer wider than it into: the
# widest the target's arithmetic runs at, the widest integer where it states none
pub fun word_of(c: *Capabilities) u32 {
    val opt_top: opt[u32] = capability.widest(c);
    if (sel opt_top.some) { ret opt_top.some; }
    ret type_table.WIDTHS[$length_of(type_table.Widths) - 1];
}

# a reinterpretation between a wide integer and a vector whose lanes fill
# words whole
# ---
# into:   the vector is the result, not the operand
# vector: the vector's lanes
# bits:   the bits of one lane
pub rec Lanes {
    into:   bool;
    vector: type_table.Vector;
    bits:   u32;
}

# how an instruction is split
pub tag Form: u8 {
    none;
    refused: str;
    sum;
    difference;
    product;
    negate;
    complement;
    logic:   Logic;
    shift:   Way;
    compare: Compare;
    select;
    extend: bool;
    truncate;
    population;
    leading;
    trailing;
    swap;
    checked_sum:        bool;
    checked_difference: bool;
    checked_product:    bool;
    high:               algebra.Reading;
    declassify;
    load;
    store;
    offset;
    address;
    pointer;
    recast;
    paired;
    lanes:   Lanes;
    spilled: bool;
    bit_load;
    bit_store;
    length;
}

# one visit
# ---
# w:        the words and where they are made
# t:        the target
# layout:   its data layout
# little:   its byte order puts the low byte first
# physical: memory can be reinterpreted
# floats:   per row of the number format table, whether the build computes in it
# ranges:   the ranges of the function's values, as they stand before the split,
#           nil where the function holds no copy or fill a range could bound
# unpaired: why a compare and exchange of two words is refused, none where the
#           target swaps two words and the build meets its condition
rec Visit {
    w:        Work;
    t:        *Target;
    layout:   Layout;
    little:   bool;
    physical: bool;
    floats:   *bool;
    ranges:   *range.Ranges;
    unpaired: opt[str];
}

# a relation as three bits, less 4, equal 2 and greater 1, so two relations are the same when their numbers are
fun relation_bits(r: fold_table.Relation) usize {
    var n: usize = 0;
    if (r.less)    { n = n + 4; }
    if (r.equal)   { n = n + 2; }
    if (r.greater) { n = n + 1; }
    ret n;
}

# the unsigned comparison of a relation, the last row that states it, none
# where no row does
fun unsigned_of(r: fold_table.Relation) opt[Opcode] {
    val want: usize = relation_bits(r);
    var i:    u32   = opcode_table.rows();
    for (i > 0) {
        i = i - 1;
        val opt_comparison: opt[fold_table.Comparison] = fold_table.comparison(i);
        if (sel opt_comparison.some) {
            if (!opt_comparison.some.signed && relation_bits(opt_comparison.some.relation) == want) { ret opt[Opcode].some{i}; }
        }
    }
    ret opt[Opcode].none{};
}

fun body_of(v: *Visit) *Body {
    ret v.w.site.b;
}

fun type_of(v: *Visit, x: Value) Type {
    ret body_of(v).values.data[x].type;
}

# the width of an integer type, zero for any other type
fun width_of(v: *Visit, ty: Type) u32 {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?v.w.site.m.types, ty);
    if (sel res_shape_at.err)        { ret 0; }
    if (sel res_shape_at.ok.integer) { ret res_shape_at.ok.integer.width; }
    ret 0;
}

# the width of a wide integer type, zero for any other type
fun wide_of(v: *Visit, ty: Type) u32 {
    val bits: u32 = width_of(v, ty);
    if (bits > v.w.word) { ret bits; }
    ret 0;
}

# whether a type is a vector whose lanes are wide
fun wide_lanes(v: *Visit, ty: Type) bool {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?v.w.site.m.types, ty);
    if (sel res_shape_at.err)       { ret false; }
    if (sel res_shape_at.ok.vector) { ret wide_of(v, res_shape_at.ok.vector.element) != 0; }
    ret false;
}

# the words a wide type is split into
fun count_of(v: *Visit, ty: Type) usize {
    ret (wide_of(v, ty) / v.w.word)::usize;
}

# the bits of a pointer type
fun pointer_bits(v: *Visit, ty: Type) u32 {
    val res_size: res[u64, record.Error] = target_layout.size(?v.layout, ty, type_table.DEFAULT_SPACE);
    if (sel res_size.err) { ret 0; }
    ret (res_size.ok * 8)::u32;
}

# the bits of an integer or float type, zero for any other type
fun scalar_bits(v: *Visit, ty: Type) u32 {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?v.w.site.m.types, ty);
    if (sel res_shape.err)        { ret 0; }
    if (sel res_shape.ok.integer) { ret res_shape.ok.integer.width; }
    if (sel res_shape.ok.float) {
        val opt_row: opt[format.Row] = format.row(res_shape.ok.float.format);
        if (sel opt_row.some) { ret opt_row.some.width; }
    }
    ret 0;
}

# a vector's lanes when they fill words whole, none for any other type
fun word_lanes(v: *Visit, ty: Type, into: bool) opt[Lanes] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?v.w.site.m.types, ty);
    if (sel res_shape.err)          { ret opt[Lanes].none{}; }
    if (!(sel res_shape.ok.vector)) { ret opt[Lanes].none{}; }
    val bits: u32 = scalar_bits(v, res_shape.ok.vector.element);
    if (bits == 0 || bits > v.w.word || v.w.word % bits != 0) { ret opt[Lanes].none{}; }
    ret opt[Lanes].some{Lanes{into: into, vector: res_shape.ok.vector, bits: bits}};
}

# whether a type is a scalar float of a format the build computes in
fun float_type(v: *Visit, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?v.w.site.m.types, ty);
    if (sel res_shape.err)         { ret false; }
    if (!(sel res_shape.ok.float)) { ret false; }
    ret v.floats[res_shape.ok.float.format];
}

# how a reinterpretation that reads or gives a wide integer is split: words
# kept as they are between two wide integers, lanes taken from or put into
# the words for a vector whose lanes fill words whole, and a float the target
# computes in through a stack slot where memory can be reinterpreted
fun recast_form(v: *Visit, from: Type, to: Type) Form {
    val wide_from: bool = wide_of(v, from) != 0;
    val wide_to:   bool = wide_of(v, to) != 0;
    if (wide_from && wide_to) { ret Form.recast{}; }
    if ((wide_from && float_type(v, to)) || (wide_to && float_type(v, from))) {
        if (!v.physical) { ret Form.refused{LOGICAL}; }
        ret Form.spilled{wide_from};
    }
    if (wide_from) {
        val opt_lanes: opt[Lanes] = word_lanes(v, to, true);
        if (sel opt_lanes.some) { ret Form.lanes{opt_lanes.some}; }
    }
    if (wide_to) {
        val opt_lanes: opt[Lanes] = word_lanes(v, from, false);
        if (sel opt_lanes.some) { ret Form.lanes{opt_lanes.some}; }
    }
    if ((wide_from && scalar_float(v, to)) || (wide_to && scalar_float(v, from))) { ret Form.refused{UNHELD}; }
    ret Form.refused{SHAPE};
}

# whether a type is a scalar float of any format
fun scalar_float(v: *Visit, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?v.w.site.m.types, ty);
    if (sel res_shape.err) { ret false; }
    ret sel res_shape.ok.float;
}

# whether a row states an ordering among its immediates, as an atomic does
fun ordered(row: *Row) bool {
    var i: usize = 0;
    for (i < $length_of(opcode_row.Slots)) {
        val h: opcode_row.Holds = row.immediates[i].holds;
        if (sel h.ordering) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a row states an immediate that holds a kind of fact
fun states(row: *Row, cases: bool) bool {
    var i: usize = 0;
    for (i < $length_of(opcode_row.Slots)) {
        val h: opcode_row.Holds = row.immediates[i].holds;
        if (cases && sel h.cases)   { ret true; }
        if (!cases && sel h.member) { ret true; }
        i = i + 1;
    }
    ret false;
}

# how a compare and exchange of a wide integer is split: into the words form
# when it is two words and the build swaps two words, refused otherwise
fun paired_form(v: *Visit, d: *InstructionData) Form {
    if (count_of(v, type_of(v, d.operands.data[1])) != 2) { ret Form.refused{ATOMIC}; }
    if (sel v.unpaired.some)                              { ret Form.refused{v.unpaired.some}; }
    ret Form.paired{};
}

# why a build refuses a compare and exchange of two words, none where it swaps
# them: the target states no such swap, or the build does not meet its condition
fun unpaired(c: *Context) res[opt[str], refusal.Error] {
    val p: capability.Paired = c.t.caps.atomics.paired;
    if (!(sel p.native)) { ret res[opt[str], refusal.Error].ok{opt[str].some{ATOMIC}}; }
    val res_met: res[bool, basis.Error] = basis.meets(c.basis, p.native.condition);
    if (sel res_met.err) { ret res[opt[str], refusal.Error].err{refusal.Error.condition{res_met.err}}; }
    if (!res_met.ok)     { ret res[opt[str], refusal.Error].ok{opt[str].some{p.native.refusal}}; }
    ret res[opt[str], refusal.Error].ok{opt[str].none{}};
}

# a compare and exchange of two words as one atomic access of its words: the
# address, the expected words and the desired words, low word first, giving the
# words found and the condition, with the orderings it stated
fun swapped(v: *Visit, c: *Copied) Split {
    val w:   *Work        = ?v.w;
    val a:   Slice[Value] = operand_words(v, c, 1);
    val b:   Slice[Value] = operand_words(v, c, 2);
    var ops: [5]Value     = [5]Value{c.operands[0], a.data[0], a.data[1], b.data[0], b.data[1]};
    var imm: [2]Immediate;
    var n:   usize        = 0;
    if (sel c.immediate.some) {
        imm[n] = c.immediate.some;
        n      = n + 1;
    }
    if (sel c.second.some) {
        imm[n] = c.second.some;
        n      = n + 1;
    }
    emit.flags(?w.site, read_flags(c));
    val made: Instruction = emit.emit(?w.site, opcode_table.ATOMIC_CMPXCHG_WORDS, Slice[Value]{data: ?ops[0], size: 5}, Slice[Immediate]{data: ?imm[0], size: n});
    emit.flags(?w.site, NO_FLAGS);
    val out: Slice[Value] = words.fresh(w, 2);
    out.data[0] = emit.result(?w.site, made, 0);
    out.data[1] = emit.result(?w.site, made, 1);
    ret Split{words: out, value: opt[Value].some{emit.result(?w.site, made, 2)}};
}

# how a copy or fill whose length is wide is split: its length the low word
# where a range fact bounds it below the pointer's reach, refused otherwise
fun length_form(v: *Visit, d: *InstructionData, k: Block) Form {
    if (d.operands.len != 3) { ret Form.refused{UNBOUND}; }
    val bits: u32 = pointer_bits(v, type_of(v, d.operands.data[0]));
    if (bits == 0 || bits > v.w.word) { ret Form.refused{POINTER}; }
    val res_range_at: res[range.Range, refusal.Error] = range.range_at(v.ranges, d.operands.data[2], k);
    if (sel res_range_at.err)                                  { ret Form.refused{UNBOUND}; }
    if (word.compare(res_range_at.ok.hi, word.ones(bits)) > 0) { ret Form.refused{UNBOUND}; }
    ret Form.length{};
}

# how an instruction that reads or gives a wide integer is split
fun wide_form(v: *Visit, d: *InstructionData, row: *Row, k: Block) Form {
    if (sel row.tail.argument || sel row.tail.returned) { ret Form.refused{BOUNDARY}; }
    val a: Op = algebra.op(d.opcode);
    if (sel a.sum)                { ret Form.sum{}; }
    if (sel a.difference)         { ret Form.difference{}; }
    if (sel a.product)            { ret Form.product{}; }
    if (sel a.negate)             { ret Form.negate{}; }
    if (sel a.complement)         { ret Form.complement{}; }
    if (sel a.both)               { ret Form.logic{Logic.both{}}; }
    if (sel a.either)             { ret Form.logic{Logic.either{}}; }
    if (sel a.differ)             { ret Form.logic{Logic.differ{}}; }
    if (sel a.shift_left)         { ret Form.shift{Way.left{}}; }
    if (sel a.shift_right_u)      { ret Form.shift{Way.zero{}}; }
    if (sel a.shift_right_s)      { ret Form.shift{Way.sign{}}; }
    if (sel a.select)             { ret Form.select{}; }
    if (sel a.extend_u)           { ret Form.extend{false}; }
    if (sel a.extend_s)           { ret Form.extend{true}; }
    if (sel a.truncate)           { ret Form.truncate{}; }
    if (sel a.population)         { ret Form.population{}; }
    if (sel a.leading_zeros)      { ret Form.leading{}; }
    if (sel a.trailing_zeros)     { ret Form.trailing{}; }
    if (sel a.swap)               { ret Form.swap{}; }
    if (sel a.checked_sum)        { ret Form.checked_sum{a.checked_sum}; }
    if (sel a.checked_difference) { ret Form.checked_difference{a.checked_difference}; }
    if (sel a.checked_product)    { ret Form.checked_product{a.checked_product}; }
    if (sel a.high)               { ret Form.high{a.high}; }
    if (helper.takes(d.opcode))   { ret Form.refused{HELPED}; }
    if (sel a.compare) {
        val opt_comparison: opt[fold_table.Comparison] = fold_table.comparison(d.opcode);
        if (sel opt_comparison.none) { ret Form.refused{RELATION}; }
        val r:       fold_table.Relation = opt_comparison.some.relation;
        val opt_low: opt[Opcode]         = unsigned_of(r);
        if (sel opt_low.none) { ret Form.refused{RELATION}; }
        ret Form.compare{Compare{code: d.opcode, low: opt_low.some, symmetric: r.less == r.greater}};
    }
    if (sel row.secrecy.declassifies && d.operands.len == 1 && d.results.len == 1) { ret Form.declassify{}; }
    if (d.opcode == opcode_table.LOAD || d.opcode == opcode_table.STORE) {
        if (d.opcode == opcode_table.LOAD) { ret Form.load{}; }
        ret Form.store{};
    }
    if (d.opcode == opcode_table.BITCAST)        { ret recast_form(v, type_of(v, d.operands.data[0]), type_of(v, d.results.data[0])); }
    if (d.opcode == opcode_table.ATOMIC_CMPXCHG) { ret paired_form(v, d); }
    if (ordered(row))                            { ret Form.refused{ATOMIC}; }
    if (d.opcode == opcode_table.MEM_COPY || d.opcode == opcode_table.MEM_FILL) {
        if (!v.physical) { ret Form.refused{LOGICAL}; }
        ret length_form(v, d, k);
    }
    if (states(row, true))                                                         { ret Form.refused{CHAINED}; }
    if (d.opcode == opcode_table.PTR_MEMBER || d.opcode == opcode_table.PTR_INDEX) { ret Form.refused{LOGICAL}; }
    if (states(row, false))                                                        { ret Form.refused{MEMBER}; }
    var form:    Form = Form.refused{ROWLESS};
    var pointer: Type = type_of(v, d.operands.data[0]);
    if (d.opcode == opcode_table.PTR_ADD)  { form = Form.offset{}; }
    if (d.opcode == opcode_table.PTRTOINT) { form = Form.address{}; }
    if (d.opcode == opcode_table.INTTOPTR) {
        form    = Form.pointer{};
        pointer = type_of(v, d.results.data[0]);
    }
    if (sel form.refused)                    { ret form; }
    if (pointer_bits(v, pointer) > v.w.word) { ret Form.refused{POINTER}; }
    ret form;
}

# how an instruction is split, none when it reads and gives no wide integer
# and holds no condition in memory
fun form_of(v: *Visit, d: *InstructionData, at: Block) Form {
    var wide:  bool  = false;
    var lanes: bool  = false;
    var k:     usize = 0;
    for (k < d.operands.len) {
        val ty: Type = type_of(v, d.operands.data[k]);
        if (wide_of(v, ty) != 0) { wide = true; }
        if (wide_lanes(v, ty))   { lanes = true; }
        k = k + 1;
    }
    k = 0;
    for (k < d.results.len) {
        val ty: Type = type_of(v, d.results.data[k]);
        if (wide_of(v, ty) != 0) { wide = true; }
        if (wide_lanes(v, ty))   { lanes = true; }
        k = k + 1;
    }
    if (lanes) { ret Form.refused{VECTOR}; }
    val opt_opcode_at: opt[*Row] = opcode_table.at(d.opcode);
    if (sel opt_opcode_at.none) { ret Form.refused{ROWLESS}; }
    val row: *Row = opt_opcode_at.some;
    if (wide)                                                                                       { ret wide_form(v, d, row, at); }
    if (!v.physical)                                                                                { ret Form.none{}; }
    if (d.opcode == opcode_table.LOAD && width_of(v, type_of(v, d.results.data[0])) == CONDITION)   { ret Form.bit_load{}; }
    if (d.opcode == opcode_table.STORE && width_of(v, type_of(v, d.operands.data[1])) == CONDITION) { ret Form.bit_store{}; }
    ret Form.none{};
}

# what one instruction is, copied before the body grows under it
# ---
# code:      its opcode
# operands:  its fixed operands
# count:     how many
# results:   its results
# results_n: how many
# flags:     its flags
# immediate: its first immediate, which a load's type or an access's alignment is
# second:    its second
pub rec Copied {
    code:      Opcode;
    operands:  [4]Value;
    count:     usize;
    results:   [2]Value;
    results_n: usize;
    flags:     Flags;
    immediate: opt[Immediate];
    second:    opt[Immediate];
}

fun copy_of(d: *InstructionData) Copied {
    var c: Copied;
    c.code  = d.opcode;
    c.count = d.operands.len;
    if (c.count > 4) { c.count = 4; }
    var k: usize = 0;
    for (k < c.count) {
        c.operands[k] = d.operands.data[k];
        k             = k + 1;
    }
    c.results_n = d.results.len;
    if (c.results_n > 2) { c.results_n = 2; }
    k = 0;
    for (k < c.results_n) {
        c.results[k] = d.results.data[k];
        k            = k + 1;
    }
    c.flags     = d.metadata.flags;
    c.immediate = opt[Immediate].none{};
    c.second    = opt[Immediate].none{};
    if (d.immediates.len > 0) { c.immediate = opt[Immediate].some{d.immediates.data[0]}; }
    if (d.immediates.len > 1) { c.second = opt[Immediate].some{d.immediates.data[1]}; }
    ret c;
}

# the alignment an access states
fun alignment_of(c: *Copied) u64 {
    if (sel c.immediate.some) {
        val i: Immediate = c.immediate.some;
        if (sel i.alignment) { ret i.alignment; }
    }
    if (sel c.second.some) {
        val i: Immediate = c.second.some;
        if (sel i.alignment) { ret i.alignment; }
    }
    ret 1;
}

# the alignment an access at a byte offset from an aligned address may assume
fun aligned_at(align: u64, offset: u64) u64 {
    if (offset == 0) { ret align; }
    val low: u64 = offset & (0 - offset);
    if (low < align) { ret low; }
    ret align;
}

# the address of the word at a byte offset from an address
fun at_offset(v: *Visit, address: Value, offset: u64) Value {
    if (offset == 0) { ret address; }
    val bits: u32   = pointer_bits(v, type_of(v, address));
    val by:   Value = words.constant(?v.w, words.integer(?v.w, bits), word.small(offset));
    ret emit.binary(?v.w.site, opcode_table.PTR_ADD, address, by);
}

# the address of word i of n of the wide integer at an address: at the word's byte offset where memory can be
# reinterpreted, and else element i of the array of n words the integer is held in memory as, low word first
fun word_at(v: *Visit, address: Value, i: usize, n: usize) Value {
    if (v.physical) { ret at_offset(v, address, word_offset(v, i, n)); }
    val res_words: res[Type, type_table.Error] = type_table.intern(?v.w.site.m.types, type_table.Shape.array{type_table.Array{count: n::u64, element: v.w.wty, stride: opt[u64].none{}}});
    if (sel res_words.err) {
        words.fail(?v.w, refusal.Error.ir{module.Error.types{res_words.err}});
        ret address;
    }
    var ops:  [2]Value     = [2]Value{address, words.constant(?v.w, words.integer(?v.w, 32), word.small(i::u64))};
    var imm:  [1]Immediate = [1]Immediate{Immediate.ty{res_words.ok}};
    val made: Instruction  = emit.emit(?v.w.site, opcode_table.PTR_INDEX, Slice[Value]{data: ?ops[0], size: 2}, Slice[Immediate]{data: ?imm[0], size: 1});
    ret emit.result(?v.w.site, made, 0);
}

# the byte offset of word i of n by the target's byte order
fun word_offset(v: *Visit, i: usize, n: usize) u64 {
    val bytes: u64 = (v.w.word / 8)::u64;
    if (v.little) { ret i::u64 * bytes; }
    ret (n - 1 - i)::u64 * bytes;
}

# the flags of a piece of an access: the access's volatility and keeping, never bounded
fun access_flags(c: *Copied) Flags {
    ret Flags{volatile: c.flags.volatile, kept: c.flags.kept, bounded: false};
}

# the flags of a piece of a read, which reads what the read it stands for does
fun read_flags(c: *Copied) Flags {
    var r: Flags = access_flags(c);
    r.public = c.flags.public;
    ret r;
}

fun load_of(v: *Visit, c: *Copied, address: Value, ty: Type, align: u64) Value {
    var ops: [1]Value     = [1]Value{address};
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{ty}, Immediate.alignment{align}};
    emit.flags(?v.w.site, read_flags(c));
    val i: Instruction = emit.emit(?v.w.site, opcode_table.LOAD, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 2});
    emit.flags(?v.w.site, NO_FLAGS);
    ret emit.result(?v.w.site, i, 0);
}

fun store_of(v: *Visit, c: *Copied, address: Value, value: Value, align: u64) {
    var ops: [2]Value     = [2]Value{address, value};
    var imm: [1]Immediate = [1]Immediate{Immediate.alignment{align}};
    emit.flags(?v.w.site, access_flags(c));
    emit.emit(?v.w.site, opcode_table.STORE, Slice[Value]{data: ?ops[0], size: 2}, Slice[Immediate]{data: ?imm[0], size: 1});
    emit.flags(?v.w.site, NO_FLAGS);
}

# the condition 0
fun no(v: *Visit) Value {
    ret words.constant(?v.w, v.w.bit, word.zero());
}

# what a split leaves: the words of its wide result, and what stands for the
# result that is not wide
# ---
# words: the words of the first result, empty when it is not wide
# value: the value that takes the place of the result that is not wide, if any
rec Split {
    words: Slice[Value];
    value: opt[Value];
}

# a split that leaves the words of a wide result alone
fun only(words: Slice[Value]) Split {
    ret Split{words: words, value: opt[Value].none{}};
}

# a split that leaves a value standing for a result that is not wide
fun standing(x: Value) Split {
    ret Split{words: Slice[Value]{data: nil, size: 0}, value: opt[Value].some{x}};
}

# a split that leaves neither words nor a value, as a store's does
fun nothing() Split {
    ret Split{words: Slice[Value]{data: nil, size: 0}, value: opt[Value].none{}};
}

# the words of an operand of a wide type
fun operand_words(v: *Visit, c: *Copied, k: usize) Slice[Value] {
    val x: Value = c.operands[k];
    ret words.words_of(?v.w, x, count_of(v, type_of(v, x)));
}

# a shift of a value's words by its count
fun shifted(v: *Visit, way: Way, c: *Copied) Split {
    val a:        Slice[Value]                               = operand_words(v, c, 0);
    val width:    u32                                        = (a.size * v.w.word::usize)::u32;
    val res_read: res[opt[fold_record.Value], refusal.Error] = number.read(v.w.site.m, body_of(v), v.w.site.scratch, c.operands[1]);
    if (sel res_read.err) {
        words.fail(?v.w, res_read.err);
        ret only(a);
    }
    var constant: bool = false;
    var k:        Wide = word.zero();
    if (sel res_read.ok.some) {
        if (res_read.ok.some.lanes.size == 1) {
            constant = true;
            k        = word.of(res_read.ok.some.lanes.data[0].words);
        }
    }
    if (constant) {
        if (word.compare(k, word.small(width::u64)) >= 0) {
            var fill: Value = words.zero(?v.w);
            if (sel way.sign) { fill = words.fill(?v.w, a.data[a.size - 1]); }
            val out: Slice[Value] = words.fresh(?v.w, a.size);
            var i:   usize        = 0;
            for (i < out.size) {
                out.data[i] = fill;
                i           = i + 1;
            }
            ret only(out);
        }
        ret only(shift.by_constant(?v.w, way, a, k[0]::u32));
    }
    ret only(shift.by_value(?v.w, way, a, operand_words(v, c, 1)));
}

# the words of a load, one access per word at its offset
fun loaded(v: *Visit, c: *Copied) Split {
    val n:     usize        = count_of(v, type_of(v, c.results[0]));
    val align: u64          = alignment_of(c);
    val out:   Slice[Value] = words.fresh(?v.w, n);
    var i:     usize        = 0;
    for (i < out.size) {
        val off: u64 = word_offset(v, i, n);
        out.data[i] = load_of(v, c, word_at(v, c.operands[0], i, n), v.w.wty, aligned_at(align, off));
        i           = i + 1;
    }
    ret only(out);
}

# the words of a store, one access per word at its offset, the last in the
# store's place so a kept store is replaced only by a kept one
fun stored(v: *Visit, c: *Copied, origin: Instruction) {
    val a:     Slice[Value] = operand_words(v, c, 1);
    val align: u64          = alignment_of(c);
    var i:     usize        = 0;
    for (i < a.size) {
        val off:     u64   = word_offset(v, i, a.size);
        val address: Value = word_at(v, c.operands[0], i, a.size);
        if (i + 1 == a.size) { emit.end(?v.w.site, origin); }
        store_of(v, c, address, a.data[i], aligned_at(align, off));
        i = i + 1;
    }
}

# the integer type a condition is held in memory as, by its size in the layout
# of the space an address points into
fun bit_memory(v: *Visit, address: Value) Type {
    val res_space: res[u32, type_table.Error] = type_table.space(?v.w.site.m.types, type_of(v, address));
    if (sel res_space.err) {
        words.fail(?v.w, refusal.Error.ir{module.Error.types{res_space.err}});
        ret v.w.wty;
    }
    val res_size: res[u64, record.Error] = target_layout.size(?v.layout, v.w.bit, res_space.ok);
    if (sel res_size.err) {
        words.fail(?v.w, refusal.Error.reason{"the data layout states no size of a condition"});
        ret v.w.wty;
    }
    ret words.integer(?v.w, (res_size.ok * 8)::u32);
}

# a vector whose lanes fill words whole from the words of a wide integer,
# lane 0 from the low bits
fun to_lanes(v: *Visit, c: *Copied, l: Lanes) Value {
    val w:     *Work        = ?v.w;
    val to:    Type         = type_of(v, c.results[0]);
    val lane:  Type         = l.vector.element;
    val bits:  u32          = l.bits;
    val held:  Type         = words.integer(w, bits);
    val float: bool         = width_of(v, lane) == 0;
    val parts: Slice[Value] = operand_words(v, c, 0);
    val n:     usize        = l.vector.lanes::usize;
    val out:   Slice[Value] = words.fresh(w, n);
    var i:     usize        = 0;
    for (i < n && sel w.failed.none) {
        val at: u32   = i::u32 * bits;
        var x:  Value = words.shift_by(w, opcode_table.SHR_U, parts.data[(at / w.word)::usize], at % w.word);
        if (bits < w.word) { x = emit.convert(?w.site, opcode_table.TRUNC, x, held); }
        if (float)         { x = emit.convert(?w.site, opcode_table.BITCAST, x, lane); }
        out.data[i] = x;
        i           = i + 1;
    }
    var imm:  [1]Immediate = [1]Immediate{Immediate.ty{to}};
    val made: Instruction  = emit.emit(?w.site, opcode_table.VBUILD, out, Slice[Immediate]{data: ?imm[0], size: 1});
    ret emit.result(?w.site, made, 0);
}

# the words of a vector whose lanes fill words whole, lane 0 in the low bits
fun from_lanes(v: *Visit, c: *Copied, l: Lanes) Slice[Value] {
    val w:     *Work        = ?v.w;
    val out:   Slice[Value] = words.zeros(w, count_of(v, type_of(v, c.results[0])));
    val lane:  Type         = l.vector.element;
    val bits:  u32          = l.bits;
    val held:  Type         = words.integer(w, bits);
    val float: bool         = width_of(v, lane) == 0;
    var i:     u32          = 0;
    for (i < l.vector.lanes && sel w.failed.none) {
        var ops:  [1]Value     = [1]Value{c.operands[0]};
        var imm:  [1]Immediate = [1]Immediate{Immediate.lane{i}};
        val made: Instruction  = emit.emit(?w.site, opcode_table.VEXTRACT, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 1});
        var x:    Value        = emit.result(?w.site, made, 0);
        if (float)         { x = emit.convert(?w.site, opcode_table.BITCAST, x, held); }
        if (bits < w.word) { x = emit.convert(?w.site, opcode_table.EXT_U, x, w.wty); }
        val at: u32   = i * bits;
        val j:  usize = (at / w.word)::usize;
        out.data[j] = words.or_(w, out.data[j], words.shift_by(w, opcode_table.SHL, x, at % w.word));
        i           = i + 1;
    }
    ret out;
}

# a stack slot of a float, ahead of the instruction being split, and its
# alignment
fun float_slot(v: *Visit, ty: Type, align: *u64) Value {
    val w:         *Work                  = ?v.w;
    val res_align: res[u64, record.Error] = target_layout.align(?v.layout, ty, type_table.DEFAULT_SPACE);
    val res_slot:  res[u32, record.Error] = record.slot_space(v.t);
    if (sel res_align.err) {
        words.fail(w, refusal.Error.reason{"the data layout states no alignment of a float"});
        ret w.stand[0];
    }
    if (sel res_slot.err) {
        words.fail(w, refusal.Error.reason{"the target states no address space for its stack slots"});
        ret w.stand[0];
    }
    val res_space: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.pointer{type_table.Pointer{space: res_slot.ok}});
    if (sel res_space.err) {
        words.fail(w, refusal.Error.ir{module.Error.types{res_space.err}});
        ret w.stand[0];
    }
    @align = res_align.ok;
    var imm:  [3]Immediate = [3]Immediate{Immediate.ty{ty}, Immediate.ty{res_space.ok}, Immediate.alignment{res_align.ok}};
    val made: Instruction  = emit.emit(?w.site, opcode_table.ALLOCA, Slice[Value]{data: nil, size: 0}, Slice[Immediate]{data: ?imm[0], size: 3});
    ret emit.result(?w.site, made, 0);
}

# the words of a float wider than a word, loaded from a slot it is stored to
fun float_words(v: *Visit, c: *Copied) Slice[Value] {
    var align: u64   = 1;
    val slot:  Value = float_slot(v, type_of(v, c.operands[0]), ?align);
    store_of(v, c, slot, c.operands[0], align);
    val n:   usize        = count_of(v, type_of(v, c.results[0]));
    val out: Slice[Value] = words.fresh(?v.w, n);
    var i:   usize        = 0;
    for (i < out.size) {
        val off: u64 = word_offset(v, i, n);
        out.data[i] = load_of(v, c, at_offset(v, slot, off), v.w.wty, aligned_at(align, off));
        i           = i + 1;
    }
    ret out;
}

# a float wider than a word, loaded from a slot its words are stored to
fun float_of_words(v: *Visit, c: *Copied) Value {
    val ty:    Type         = type_of(v, c.results[0]);
    var align: u64          = 1;
    val slot:  Value        = float_slot(v, ty, ?align);
    val a:     Slice[Value] = operand_words(v, c, 0);
    var i:     usize        = 0;
    for (i < a.size) {
        val off: u64 = word_offset(v, i, a.size);
        store_of(v, c, at_offset(v, slot, off), a.data[i], aligned_at(align, off));
        i = i + 1;
    }
    ret load_of(v, c, slot, ty, align);
}

# split an instruction by its form
fun split(v: *Visit, form: Form, c: *Copied, origin: Instruction) Split {
    val w: *Work = ?v.w;
    if (sel form.sum)        { ret only(arith.sum(w, operand_words(v, c, 0), operand_words(v, c, 1), nil)); }
    if (sel form.difference) { ret only(arith.difference(w, operand_words(v, c, 0), operand_words(v, c, 1), nil)); }
    if (sel form.product) {
        val a: Slice[Value] = operand_words(v, c, 0);
        ret only(arith.product(w, a, operand_words(v, c, 1), a.size));
    }
    if (sel form.negate)     { ret only(arith.negate(w, operand_words(v, c, 0))); }
    if (sel form.complement) { ret only(arith.each(w, opcode_table.NOT, operand_words(v, c, 0))); }
    if (sel form.declassify) { ret only(arith.each(w, c.code, operand_words(v, c, 0))); }
    if (sel form.logic)      { ret only(arith.bitwise(w, form.logic, operand_words(v, c, 0), operand_words(v, c, 1))); }
    if (sel form.shift)      { ret shifted(v, form.shift, c); }
    if (sel form.compare)    { ret standing(arith.compare(w, form.compare, operand_words(v, c, 0), operand_words(v, c, 1))); }
    if (sel form.select)     { ret only(arith.select(w, c.operands[0], operand_words(v, c, 1), operand_words(v, c, 2))); }
    if (sel form.extend) {
        val n:    usize = count_of(v, type_of(v, c.results[0]));
        val from: Type  = type_of(v, c.operands[0]);
        if (wide_of(v, from) != 0) { ret only(arith.extend(w, operand_words(v, c, 0), n, form.extend)); }
        ret only(arith.extend_narrow(w, c.operands[0], width_of(v, from), n, form.extend));
    }
    if (sel form.truncate) {
        val to: Type         = type_of(v, c.results[0]);
        val a:  Slice[Value] = operand_words(v, c, 0);
        if (wide_of(v, to) != 0) { ret only(arith.low(w, a, count_of(v, to))); }
        ret standing(arith.truncate(w, a, to, width_of(v, to)));
    }
    if (sel form.population) { ret only(arith.population(w, operand_words(v, c, 0))); }
    if (sel form.leading)    { ret only(arith.leading(w, operand_words(v, c, 0))); }
    if (sel form.trailing)   { ret only(arith.trailing(w, operand_words(v, c, 0))); }
    if (sel form.swap)       { ret only(arith.swap(w, operand_words(v, c, 0))); }
    if (sel form.checked_sum || sel form.checked_difference) {
        val a:    Slice[Value] = operand_words(v, c, 0);
        val b:    Slice[Value] = operand_words(v, c, 1);
        val diff: bool         = sel form.checked_difference;
        var sign: bool         = false;
        if (sel form.checked_sum)        { sign = form.checked_sum; }
        if (sel form.checked_difference) { sign = form.checked_difference; }
        var opt_flag: opt[Value]   = opt[Value].none{};
        var out:      Slice[Value] = Slice[Value]{data: nil, size: 0};
        if (sign) {
            if (diff) { out = arith.difference(w, a, b, nil); }
            or        { out = arith.sum(w, a, b, nil); }
            val top: usize = a.size - 1;
            opt_flag = opt[Value].some{arith.signed_overflow(w, a.data[top], b.data[top], out.data[top], diff)};
        }
        or {
            if (diff) { out = arith.difference(w, a, b, ?opt_flag); }
            or        { out = arith.sum(w, a, b, ?opt_flag); }
        }
        var set: Value = no(v);
        if (sel opt_flag.some) { set = opt_flag.some; }
        ret Split{words: out, value: opt[Value].some{set}};
    }
    if (sel form.checked_product) {
        var set: Value        = no(v);
        val out: Slice[Value] = arith.checked_product(w, operand_words(v, c, 0), operand_words(v, c, 1), form.checked_product, ?set);
        ret Split{words: out, value: opt[Value].some{set}};
    }
    if (sel form.high) { ret only(arith.high(w, operand_words(v, c, 0), operand_words(v, c, 1), form.high)); }
    if (sel form.load) { ret loaded(v, c); }
    if (sel form.store) {
        stored(v, c, origin);
        ret nothing();
    }
    if (sel form.offset) { ret standing(emit.binary(?w.site, opcode_table.PTR_ADD, c.operands[0], operand_words(v, c, 1).data[0])); }
    if (sel form.address) {
        val low: Value    = emit.convert(?w.site, opcode_table.PTRTOINT, c.operands[0], w.wty);
        var one: [1]Value = [1]Value{low};
        ret only(arith.extend(w, Slice[Value]{data: ?one[0], size: 1}, count_of(v, type_of(v, c.results[0])), false));
    }
    if (sel form.pointer) { ret standing(emit.convert(?w.site, opcode_table.INTTOPTR, operand_words(v, c, 0).data[0], type_of(v, c.results[0]))); }
    if (sel form.recast)  { ret only(operand_words(v, c, 0)); }
    if (sel form.paired)  { ret swapped(v, c); }
    if (sel form.lanes) {
        if (form.lanes.into) { ret standing(to_lanes(v, c, form.lanes)); }
        ret only(from_lanes(v, c, form.lanes));
    }
    if (sel form.spilled) {
        if (form.spilled) { ret standing(float_of_words(v, c)); }
        ret only(float_words(v, c));
    }
    if (sel form.bit_load) {
        val held: Type  = bit_memory(v, c.operands[0]);
        val x:    Value = load_of(v, c, c.operands[0], held, alignment_of(c));
        ret standing(emit.convert(?w.site, opcode_table.TRUNC, x, w.bit));
    }
    if (sel form.bit_store) {
        val held: Type  = bit_memory(v, c.operands[0]);
        val x:    Value = emit.convert(?w.site, opcode_table.EXT_U, c.operands[1], held);
        emit.end(?w.site, origin);
        store_of(v, c, c.operands[0], x, alignment_of(c));
        ret nothing();
    }
    if (sel form.length) {
        var ops: [3]Value = [3]Value{c.operands[0], c.operands[1], operand_words(v, c, 2).data[0]};
        var imm: [2]Immediate;
        var n:   usize    = 0;
        if (sel c.immediate.some) {
            imm[n] = c.immediate.some;
            n      = n + 1;
        }
        if (sel c.second.some) {
            imm[n] = c.second.some;
            n      = n + 1;
        }
        emit.end(?w.site, origin);
        emit.flags(?w.site, read_flags(c));
        emit.emit(?w.site, c.code, Slice[Value]{data: ?ops[0], size: 3}, Slice[Immediate]{data: ?imm[0], size: n});
        emit.flags(?w.site, NO_FLAGS);
        ret nothing();
    }
    words.fail(w, refusal.Error.reason{ROWLESS});
    ret nothing();
}

# what the visit knows of each instruction of the function, by its index
# ---
# form:  how it is split, none for one that is not
# kept:  part of a high multiply written over words, left as it stands
# root:  the truncation such a pattern ends in
# split: split in the walk
# state: where the walk of definitions is: 0 unseen, 1 open, 2 done
rec Mark {
    form:  Form;
    kept:  bool;
    root:  bool;
    split: bool;
    state: u8;
}

# a block parameter split into words
# ---
# block: its block
# old:   the parameter
rec Parameter {
    block: Block;
    old:   Value;
}

# the walk of one function
# ---
# v:      the visit
# marks:  one per instruction the function had when the walk began
# order:  the instructions to split, each after those defining what it reads
# gone:   the instructions split whose place nothing takes, removed at the end
# params: the parameters split
# before: for each block, how many parameters it had before its own were
#         split, UNTOUCHED for a block none of whose were
rec Walk {
    v:      *Visit;
    marks:  vector.Vector[Mark];
    order:  vector.Vector[Instruction];
    gone:   vector.Vector[Instruction];
    params: vector.Vector[Parameter];
    before: vector.Vector[u32];
}

val UNTOUCHED: u32 = 0xffffffff;

fun lost(e: allocator.Error) refusal.Error {
    ret refusal.Error.alloc{e};
}

# the mark of each instruction and whether any is split or refused
fun scan(wk: *Walk) res[bool, refusal.Error] {
    val b:        *Body                       = body_of(wk.v);
    var none:     Mark                        = Mark{form: Form.none{}, kept: false, root: false, split: false, state: 0};
    val res_room: res[usize, allocator.Error] = vector.reserve[Mark](?wk.marks, b.instructions.len);
    if (sel res_room.err) { ret res[bool, refusal.Error].err{lost(res_room.err)}; }
    var i: usize = 0;
    for (i < b.instructions.len) {
        vector.push[Mark](?wk.marks, none);
        i = i + 1;
    }
    var any: bool  = false;
    var k:   usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var p: usize = 0;
            for (p < b.blocks.data[k].parameters.len) {
                val ty: Type = type_of(wk.v, b.blocks.data[k].parameters.data[p]);
                if (wide_lanes(wk.v, ty)) { ret res[bool, refusal.Error].err{refusal.Error.reason{VECTOR}}; }
                if (wide_of(wk.v, ty) != 0) {
                    if (k == 0) { ret res[bool, refusal.Error].err{refusal.Error.reason{BOUNDARY}}; }
                    any = true;
                }
                p = p + 1;
            }
            var n: Instruction = b.blocks.data[k].first;
            for (n != NO_INSTRUCTION) {
                val at:   Instruction      = n;
                val d:    *InstructionData = ?b.instructions.data[at];
                val form: Form             = form_of(wk.v, d, (k::u32));
                if (sel form.refused) { ret res[bool, refusal.Error].err{refusal.Error.reason{form.refused}}; }
                if (!(sel form.none)) {
                    wk.marks.data[at].form = form;
                    any                    = true;
                }
                n = b.instructions.data[n].next;
            }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{any};
}

# mark every high multiply written over words, which the multiply forms own
fun mark_patterns(wk: *Walk) err[refusal.Error] {
    val b: *Body = body_of(wk.v);
    var i: usize = 0;
    for (i < wk.marks.len) {
        val f: Form = wk.marks.data[i].form;
        if (sel f.truncate) {
            val res_high: res[opt[multiply.Found], refusal.Error] = multiply.high(?wk.v.w.site, ?b.instructions.data[i]);
            if (sel res_high.err) { ret err[refusal.Error].err{res_high.err}; }
            if (sel res_high.ok.some) {
                if (res_high.ok.some.high.lane.bits == wk.v.w.word) {
                    val parts: multiply.Parts = res_high.ok.some.parts;
                    wk.marks.data[i].kept             = true;
                    wk.marks.data[i].root             = true;
                    wk.marks.data[parts.shift].kept   = true;
                    wk.marks.data[parts.product].kept = true;
                    wk.marks.data[parts.left].kept    = true;
                    wk.marks.data[parts.right].kept   = true;
                }
            }
        }
        i = i + 1;
    }
    ret err[refusal.Error].ok{};
}

# whether an instruction is one to split, by its mark
fun marked(wk: *Walk, i: Instruction) bool {
    if (i::usize >= wk.marks.len) { ret false; }
    val f: Form = wk.marks.data[i].form;
    ret !(sel f.none);
}

# the instruction defining an operand, when it is one to split
fun feeder(wk: *Walk, x: Value) opt[Instruction] {
    val def: Def = body_of(wk.v).values.data[x].def;
    if (!(sel def.result))                   { ret opt[Instruction].none{}; }
    if (!marked(wk, def.result.instruction)) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{def.result.instruction};
}

# a frame of the walk of definitions
# ---
# at:   the instruction
# next: the next operand to follow
rec Frame {
    at:   Instruction;
    next: usize;
}

# order the instructions to split so each follows those defining what it
# reads, whatever block holds it
fun order(wk: *Walk) err[refusal.Error] {
    val b:     *Body                = body_of(wk.v);
    var stack: vector.Vector[Frame] = vector.init[Frame](wk.v.w.keep);
    var k:     usize                = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: Instruction = b.blocks.data[k].first;
            for (n != NO_INSTRUCTION) {
                val start: Instruction = n;
                if (marked(wk, start) && wk.marks.data[start].state == 0) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[Frame](?stack, Frame{at: start, next: 0});
                    if (sel res_pushed.err) { ret err[refusal.Error].err{lost(res_pushed.err)}; }
                    wk.marks.data[start].state = 1;
                    for (stack.len > 0) {
                        val top: *Frame           = ?stack.data[stack.len - 1];
                        val d:   *InstructionData = ?b.instructions.data[top.at];
                        if (top.next < d.operands.len) {
                            val x: Value = d.operands.data[top.next];
                            top.next = top.next + 1;
                            val opt_feeder: opt[Instruction] = feeder(wk, x);
                            if (sel opt_feeder.some) {
                                val s: u8 = wk.marks.data[opt_feeder.some].state;
                                if (s == 1) { ret err[refusal.Error].err{refusal.Error.reason{CYCLE}}; }
                                if (s == 0) {
                                    wk.marks.data[opt_feeder.some].state = 1;
                                    val res_more: res[usize, allocator.Error] = vector.push[Frame](?stack, Frame{at: opt_feeder.some, next: 0});
                                    if (sel res_more.err) { ret err[refusal.Error].err{lost(res_more.err)}; }
                                }
                            }
                        }
                        or {
                            wk.marks.data[top.at].state = 2;
                            val res_listed: res[usize, allocator.Error] = vector.push[Instruction](?wk.order, top.at);
                            if (sel res_listed.err) { ret err[refusal.Error].err{lost(res_listed.err)}; }
                            vector.truncate[Frame](?stack, stack.len - 1);
                        }
                    }
                }
                n = b.instructions.data[n].next;
            }
        }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# which instructions are split: all but the parts of a high multiply over
# words, and of those the ones whose result something split reads
fun choose(wk: *Walk) {
    val b: *Body = body_of(wk.v);
    var n: usize = wk.order.len;
    for (n > 0) {
        n = n - 1;
        val i: Instruction = wk.order.data[n];
        val m: *Mark       = ?wk.marks.data[i];
        if (!m.kept) { m.split = true; }
        or (!m.root) {
            val d: *InstructionData = ?b.instructions.data[i];
            var r: usize            = 0;
            for (r < d.results.len && !m.split) {
                val uses: *Growing[Instruction] = ?b.values.data[d.results.data[r]].uses;
                var u:    usize                 = 0;
                for (u < uses.len && !m.split) {
                    val user: Instruction = uses.data[u];
                    if (user::usize >= wk.marks.len || !wk.marks.data[user].kept || wk.marks.data[user].split) { m.split = true; }
                    u = u + 1;
                }
                r = r + 1;
            }
        }
    }
}

# split every wide parameter of a block other than the entry into one
# parameter per word, each edge passing zero words until its arguments are split
fun split_parameters(wk: *Walk) err[refusal.Error] {
    val v:        *Visit                      = wk.v;
    val b:        *Body                       = body_of(v);
    val res_room: res[usize, allocator.Error] = vector.reserve[u32](?wk.before, b.blocks.len);
    if (sel res_room.err) { ret err[refusal.Error].err{lost(res_room.err)}; }
    var k: usize = 0;
    for (k < b.blocks.len) {
        vector.push[u32](?wk.before, UNTOUCHED);
        k = k + 1;
    }
    k = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val count: usize = b.blocks.data[k].parameters.len;
            var p:     usize = 0;
            for (p < count) {
                val old: Value = b.blocks.data[k].parameters.data[p];
                val n:   usize = count_of(v, type_of(v, old));
                if (n != 0) {
                    wk.before.data[k] = count::u32;
                    val preds:    usize        = b.blocks.data[k].predecessors.len;
                    val incoming: Slice[Value] = words.zeros(?v.w, preds);
                    val made:     Slice[Value] = words.fresh(?v.w, n);
                    if (sel v.w.failed.some) { ret err[refusal.Error].err{v.w.failed.some}; }
                    val secret: bool  = b.values.data[old].secret;
                    var j:      usize = 0;
                    for (j < n) {
                        val res_added: res[Value, module.Error] = body.add_parameter(v.w.site.m, v.w.site.f, (k::u32), Declaration{type: v.w.wty, secret: secret, name: opt[View].none{}}, incoming);
                        if (sel res_added.err) { ret err[refusal.Error].err{refusal.Error.ir{res_added.err}}; }
                        made.data[j] = res_added.ok;
                        j            = j + 1;
                    }
                    words.hold(?v.w, old, made);
                    val res_listed: res[usize, allocator.Error] = vector.push[Parameter](?wk.params, Parameter{block: (k::u32), old: old});
                    if (sel res_listed.err) { ret err[refusal.Error].err{lost(res_listed.err)}; }
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    if (sel v.w.failed.some) { ret err[refusal.Error].err{v.w.failed.some}; }
    ret err[refusal.Error].ok{};
}

# split one instruction in its place
fun rewrite(wk: *Walk, i: Instruction) err[refusal.Error] {
    val v:    *Visit           = wk.v;
    val b:    *Body            = body_of(v);
    val d:    *InstructionData = ?b.instructions.data[i];
    var c:    Copied           = copy_of(d);
    val form: Form             = wk.marks.data[i].form;
    val kept: bool             = wk.marks.data[i].kept;
    emit.begin(?v.w.site, i);
    val made:     Split              = split(v, form, ?c, i);
    val err_done: err[refusal.Error] = words.finished(?v.w);
    if (sel err_done.err)     { ret err_done; }
    if (made.words.size != 0) { words.hold(?v.w, c.results[0], made.words); }
    if (sel made.value.some) {
        var at: usize = 0;
        if (made.words.size != 0) { at = 1; }
        val err_moved: err[refusal.Error] = refusal.edit(body.replace(v.w.site.m, v.w.site.f, c.results[at], made.value.some, Records.follow{}));
        if (sel err_moved.err) { ret err_moved; }
    }
    if (sel v.w.failed.some) { ret err[refusal.Error].err{v.w.failed.some}; }
    if (!kept && !(sel form.store) && !(sel form.bit_store) && !(sel form.length)) {
        val res_listed: res[usize, allocator.Error] = vector.push[Instruction](?wk.gone, i);
        if (sel res_listed.err) { ret err[refusal.Error].err{lost(res_listed.err)}; }
    }
    ret err[refusal.Error].ok{};
}

# pass every edge into a block whose parameters were split the words of its
# arguments, after the arguments it passed before
fun split_edges(wk: *Walk) err[refusal.Error] {
    val v: *Visit = wk.v;
    val b: *Body  = body_of(v);
    var k: usize  = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && b.blocks.data[k].last != NO_INSTRUCTION) {
            val last:  Instruction = b.blocks.data[k].last;
            val edges: usize       = b.instructions.data[last].edges.len;
            var e:     usize       = 0;
            for (e < edges) {
                val to:     Block = b.instructions.data[last].edges.data[e].block;
                val before: u32   = wk.before.data[to];
                if (before != UNTOUCHED) {
                    val wanted:   usize                       = b.blocks.data[to].parameters.len;
                    var list:     vector.Vector[Value]        = vector.init[Value](v.w.keep);
                    val res_room: res[usize, allocator.Error] = vector.reserve[Value](?list, wanted);
                    if (sel res_room.err) { ret err[refusal.Error].err{lost(res_room.err)}; }
                    var a: usize = 0;
                    for (a < before::usize) {
                        vector.push[Value](?list, b.instructions.data[last].edges.data[e].arguments.data[a]);
                        a = a + 1;
                    }
                    a = 0;
                    for (a < before::usize) {
                        val x: Value = b.instructions.data[last].edges.data[e].arguments.data[a];
                        val n: usize = count_of(v, type_of(v, b.blocks.data[to].parameters.data[a]));
                        if (n != 0) {
                            val parts: Slice[Value] = words.words_of(?v.w, x, n);
                            var j:     usize        = 0;
                            for (j < parts.size) {
                                vector.push[Value](?list, parts.data[j]);
                                j = j + 1;
                            }
                        }
                        a = a + 1;
                    }
                    if (sel v.w.failed.some) { ret err[refusal.Error].err{v.w.failed.some}; }
                    val err_moved: err[refusal.Error] = refusal.edit(body.retarget(v.w.site.m, v.w.site.f, last, e::u32, to, Slice[Value]{data: list.data, size: list.len}));
                    if (sel err_moved.err) { ret err_moved; }
                }
                e = e + 1;
            }
        }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# a record that reads a split value as it is, split into a piece per word,
# each read from its word, so no bit of the variable is lost to the split
fun pieced(wk: *Walk, x: Value, r: u32, parts: Slice[Value]) err[refusal.Error] {
    val v:     *Visit = wk.v;
    val b:     *Body  = body_of(v);
    val piece: Bits   = b.points.data[r].piece;
    val width: u32    = width_of(v, b.values.data[x].type);
    if (width == 0)                                 { ret err[refusal.Error].ok{}; }
    if (!point.whole(piece) && piece.size != width) { ret err[refusal.Error].ok{}; }
    var each:     vector.Vector[Part]         = vector.init[Part](v.w.keep);
    val res_room: res[usize, allocator.Error] = vector.reserve[Part](?each, parts.size);
    if (sel res_room.err) { ret err[refusal.Error].err{lost(res_room.err)}; }
    fin { vector.dnit[Part](?each); }
    var k: usize = 0;
    for (k < parts.size) {
        val from: u32 = k::u32 * v.w.word;
        if (from < width) {
            var size: u32 = v.w.word;
            if (width - from < size) { size = width - from; }
            vector.push[Part](?each, Part{piece: Bits{offset: piece.offset + from, size: size}, reads: Reads.operand{Operand{value: parts.data[k], expression: point.PLAIN}}});
        }
        k = k + 1;
    }
    ret refusal.edit(body.split(v.w.site.m, v.w.site.f, r, Slice[Part]{data: each.data, size: each.len}));
}

# give each record that reads a split value as it is a piece per word, and
# each that reads only the low bits of one those bits from its low word
fun salvage(wk: *Walk, x: Value) err[refusal.Error] {
    val v:     *Visit       = wk.v;
    val b:     *Body        = body_of(v);
    val parts: Slice[Value] = words.held(?v.w, x);
    if (parts.size == 0) { ret err[refusal.Error].ok{}; }
    val bound:    *vector.Vector[u32]         = ?b.values.data[x].bound;
    var ids:      vector.Vector[u32]          = vector.init[u32](v.w.keep);
    val res_room: res[usize, allocator.Error] = vector.reserve[u32](?ids, bound.len);
    if (sel res_room.err) { ret err[refusal.Error].err{lost(res_room.err)}; }
    var n: usize = 0;
    for (n < bound.len) {
        vector.push[u32](?ids, bound.data[n]);
        n = n + 1;
    }
    n = 0;
    for (n < ids.len) {
        val reads: Reads = b.points.data[ids.data[n]].reads;
        if (sel reads.operand) {
            val res_had: res[Slice[Step], module.Error] = module.steps(v.w.site.m, reads.operand.expression);
            if (sel res_had.err) { ret err[refusal.Error].err{refusal.Error.ir{res_had.err}}; }
            val steps: Slice[Step] = res_had.ok;
            if (steps.size == 0) {
                val err_split: err[refusal.Error] = pieced(wk, x, ids.data[n], parts);
                if (sel err_split.err) { ret err_split; }
            }
            or (steps.data[0].kind == point.TRUNC) {
                val first: point.Argument = steps.data[0].argument;
                if (sel first.to) {
                    val to: u32 = width_of(v, first.to);
                    if (to != 0 && to <= v.w.word) {
                        var start: usize = 1;
                        if (to < v.w.word) { start = 0; }
                        val res_expression: res[Expression, module.Error] = module.expression(v.w.site.m, Slice[Step]{data: ?steps.data[start], size: steps.size - start});
                        if (sel res_expression.err) { ret err[refusal.Error].err{refusal.Error.ir{res_expression.err}}; }
                        val err_set: err[refusal.Error] = refusal.edit(body.rebind(v.w.site.m, v.w.site.f, ids.data[n], Reads.operand{Operand{value: parts.data[0], expression: res_expression.ok}}));
                        if (sel err_set.err) { ret err_set; }
                    }
                }
            }
        }
        n = n + 1;
    }
    ret err[refusal.Error].ok{};
}

# salvage the records of every split value whose definition goes
fun salvage_split(wk: *Walk) err[refusal.Error] {
    val b: *Body = body_of(wk.v);
    var n: usize = 0;
    for (n < wk.gone.len) {
        val results: *List[Value] = ?b.instructions.data[wk.gone.data[n]].results;
        if (results.len != 0) {
            val err_salvage: err[refusal.Error] = salvage(wk, results.data[0]);
            if (sel err_salvage.err) { ret err_salvage; }
        }
        n = n + 1;
    }
    n = 0;
    for (n < wk.params.len) {
        val err_salvage: err[refusal.Error] = salvage(wk, wk.params.data[n].old);
        if (sel err_salvage.err) { ret err_salvage; }
        n = n + 1;
    }
    ret err[refusal.Error].ok{};
}

# take out the instructions split and the parameters split, which only each
# other and the edges into the split blocks still read
fun remove(wk: *Walk) err[refusal.Error] {
    var dead:     vector.Vector[Value]        = vector.init[Value](wk.v.w.keep);
    val res_room: res[usize, allocator.Error] = vector.reserve[Value](?dead, wk.params.len);
    if (sel res_room.err) { ret err[refusal.Error].err{lost(res_room.err)}; }
    var p: usize = 0;
    for (p < wk.params.len) {
        vector.push[Value](?dead, wk.params.data[p].old);
        p = p + 1;
    }
    ret refusal.edit(body.remove_dead(wk.v.w.site.m, wk.v.w.site.f, Slice[Instruction]{data: wk.gone.data, size: wk.gone.len}, Slice[Value]{data: dead.data, size: dead.len}));
}

# whether a body holds a wide integer type or a vector of wide lanes
fun holds_wide(v: *Visit, b: *Body) bool {
    var ty: u32 = 0;
    for (contents.seek(?b.contents.types, ?ty)) {
        if (wide_of(v, ty) != 0 || wide_lanes(v, ty)) { ret true; }
        ty = ty + 1;
    }
    ret false;
}

# whether a body may load or store a condition, where memory is physical
fun holds_bits(v: *Visit, b: *Body) bool {
    if (!v.physical)                                                                                                   { ret false; }
    if (!contents.has_opcode(?b.contents, opcode_table.LOAD) && !contents.has_opcode(?b.contents, opcode_table.STORE)) { ret false; }
    var ty: u32 = 0;
    for (contents.seek(?b.contents.types, ?ty)) {
        if (width_of(v, ty) == CONDITION) { ret true; }
        ty = ty + 1;
    }
    ret false;
}

# whether a body holds an opcode that names no row, which the scan refuses
fun rowless(b: *Body) bool {
    var code: u32 = 0;
    for (contents.seek(?b.contents.opcodes, ?code)) {
        val opt_row: opt[*Row] = opcode_table.at(code);
        if (sel opt_row.none) { ret true; }
        code = code + 1;
    }
    ret false;
}

# split every wide integer of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }

    var held:     arena.Arena;
    val err_kept: err[allocator.Error] = arena.init(?held, c.m.a, 0);
    if (sel err_kept.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_kept.err}}; }
    fin { arena.dnit(?held); }
    var keep: allocator.Allocator;
    arena.allocator(?keep, ?held);
    var ar:       arena.Arena;
    val err_made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.allocator(?scratch, ?ar);

    val unit: u32 = word_of(?c.t.caps);
    if (unit < 8) { ret res[bool, refusal.Error].err{refusal.Error.reason{NARROW}}; }

    var v: Visit;
    v.w.site   = emit.init(c.m, u.f, res_body.ok, ?scratch);
    v.w.word   = unit;
    v.w.keep   = ?keep;
    v.w.words  = vector.init[Slice[Value]](?keep);
    v.w.zero   = opt[Value].none{};
    v.w.failed = opt[refusal.Error].none{};
    v.t        = c.t;
    v.layout   = target_layout.of(c.t, ?c.m.types, basis.context_of(c.basis));
    v.physical = sel c.t.caps.addressing.physical;
    val rows:       usize                       = format.rows()::usize;
    val res_floats: res[*bool, allocator.Error] = allocator.zallocate[bool](?keep, rows);
    if (sel res_floats.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_floats.err}}; }
    v.floats = res_floats.ok;
    var r: usize = 0;
    for (r < rows) {
        val res_held: res[opt[*capability.Held], basis.Error] = basis.held(c.basis, ?c.t.caps, (r::u32));
        if (sel res_held.err) { ret res[bool, refusal.Error].err{refusal.Error.condition{res_held.err}}; }
        v.floats[r] = sel res_held.ok.some;
        r           = r + 1;
    }
    val wide: bool = holds_wide(?v, res_body.ok);
    v.ranges = nil;
    if (wide && (contents.has_opcode(?res_body.ok.contents, opcode_table.MEM_COPY) || contents.has_opcode(?res_body.ok.contents, opcode_table.MEM_FILL))) {
        val res_ranges: res[*range.Ranges, refusal.Error] = analysis.ranges_of(c.cache, u.f);
        if (sel res_ranges.err) { ret res[bool, refusal.Error].err{res_ranges.err}; }
        v.ranges = res_ranges.ok;
    }
    v.little = c.t.arch.order == reader.LITTLE;
    val res_pairs: res[opt[str], refusal.Error] = unpaired(c);
    if (sel res_pairs.err) { ret res[bool, refusal.Error].err{res_pairs.err}; }
    v.unpaired = res_pairs.ok;
    if (!wide && !holds_bits(?v, res_body.ok) && !rowless(res_body.ok)) { ret res[bool, refusal.Error].ok{false}; }
    v.w.wty = words.integer(?v.w, unit);
    v.w.bit = words.integer(?v.w, CONDITION);
    if (sel v.w.failed.some) { ret res[bool, refusal.Error].err{v.w.failed.some}; }

    var wk:      Walk                     = Walk{v: ?v, marks: vector.init[Mark](?keep), order: vector.init[Instruction](?keep), gone: vector.init[Instruction](?keep), params: vector.init[Parameter](?keep), before: vector.init[u32](?keep)};
    val res_any: res[bool, refusal.Error] = scan(?wk);
    if (sel res_any.err) { ret res_any; }
    if (!res_any.ok)     { ret res[bool, refusal.Error].ok{false}; }
    val err_marking: err[refusal.Error] = mark_patterns(?wk);
    if (sel err_marking.err) { ret res[bool, refusal.Error].err{err_marking.err}; }
    val err_ordered: err[refusal.Error] = order(?wk);
    if (sel err_ordered.err) { ret res[bool, refusal.Error].err{err_ordered.err}; }
    choose(?wk);

    var changed: bool  = false;
    var n:       usize = 0;
    for (n < wk.order.len) {
        if (wk.marks.data[wk.order.data[n]].split) { changed = true; }
        n = n + 1;
    }
    var p: usize = 1;
    for (p < res_body.ok.blocks.len) {
        if (!res_body.ok.blocks.data[p].erased) {
            var q: usize = 0;
            for (q < res_body.ok.blocks.data[p].parameters.len) {
                if (count_of(?v, type_of(?v, res_body.ok.blocks.data[p].parameters.data[q])) != 0) { changed = true; }
                q = q + 1;
            }
        }
        p = p + 1;
    }
    if (!changed) { ret res[bool, refusal.Error].ok{false}; }

    val err_params: err[refusal.Error] = split_parameters(?wk);
    if (sel err_params.err) { ret res[bool, refusal.Error].err{err_params.err}; }
    n = 0;
    for (n < wk.order.len) {
        arena.reset(?ar);
        val i: Instruction = wk.order.data[n];
        if (wk.marks.data[i].split) {
            val err_rewrite: err[refusal.Error] = rewrite(?wk, i);
            if (sel err_rewrite.err) { ret res[bool, refusal.Error].err{err_rewrite.err}; }
        }
        n = n + 1;
    }
    arena.reset(?ar);
    val err_edges: err[refusal.Error] = split_edges(?wk);
    if (sel err_edges.err) { ret res[bool, refusal.Error].err{err_edges.err}; }
    val err_salvaged: err[refusal.Error] = salvage_split(?wk);
    if (sel err_salvaged.err) { ret res[bool, refusal.Error].err{err_salvaged.err}; }
    val err_removed: err[refusal.Error] = remove(?wk);
    if (sel err_removed.err) { ret res[bool, refusal.Error].err{err_removed.err}; }
    ret res[bool, refusal.Error].ok{true};
}
