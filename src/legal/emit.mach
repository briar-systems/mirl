# the ground legalisations share: making the instructions that stand in for one
#
# a rewrite opens at the instruction it rewrites, makes the instructions that
# stand in for it ahead of it, and closes by making the last in its slot, which
# takes its uses. every instruction made reads as the one it rewrites, with its
# location, site and secrecy, so a secret value is never made public. a rewrite
# of one operand instead makes a value that stands in for that operand alone,
# which the instruction then reads in its place: what it makes has the
# instruction's location and site and the operand's secrecy, since it holds
# the operand and nothing of the instruction's results. the builder is the
# only maker, and the first call it refuses is the rewrite's failure. every
# value answered after that is the body's first value, which the body of any
# rewrite holds, so a rewrite reads what it made without asking whether each
# call was refused. constants are made in the scratch storage and held by the module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;

use mirl.build.builder;
use mirl.build.failure;
use mirl.fold.record;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use opcode_table: mirl.ir.opcode.table;
use type_format:  mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.opt.number;
use mirl.pass.refusal;

# one function being rewritten
# ---
# m:       the module
# f:       the function
# b:       its body
# scratch: storage for the constants one rewrite makes
# bld:     the builder
# words:   the value of each word constant made through `word_constant`
pub rec Site {
    m:       *Module;
    f:       Function;
    b:       *Body;
    scratch: *allocator.Allocator;
    bld:     builder.Builder;
    words:   map.MapBy[Word, Value];
}

# a scalar integer constant: its type and the word it holds
rec Word {
    ty: Type;
    x:  u64;
}

fun hash_word(w: *Word) u64 {
    ret (w.x * 0x9e3779b97f4a7c15) ^ w.ty::u64;
}

fun same_word(a: *Word, b: *Word) bool {
    ret a.x == b.x && a.ty == b.ty;
}

# the integer a type is, or the lane of a vector of integers
# ---
# lane:  the type of one lane, the type itself for a scalar
# bits:  the width of a lane
# lanes: how many lanes, zero for a scalar
pub rec Lane {
    lane:  Type;
    bits:  u32;
    lanes: u32;
}

# the flags of a shift whose count is below its operand's width
pub val BOUNDED: Flags = Flags{volatile: false, kept: false, bounded: true};

# the flags of a division whose traps are tested before it
pub val CHECKED: Flags = Flags{volatile: false, kept: false, bounded: false, checked: true};

# a site over a function
pub fun init(m: *Module, f: Function, b: *Body, scratch: *allocator.Allocator) Site {
    var s: Site;
    s.m       = m;
    s.f       = f;
    s.b       = b;
    s.scratch = scratch;
    s.bld     = builder.make(m);
    s.words   = map.init_by[Word, Value](m.a, hash_word, same_word);
    builder.enter(?s.bld, f);
    ret s;
}

# give back the storage of a site's word constants
pub fun dnit(s: *Site) err[allocator.Error] {
    ret map.dnit_by[Word, Value](?s.words);
}

# the integer lane of a type, none for any type that is neither an integer nor
# a vector of integers
pub fun lane_of(m: *Module, ty: Type) res[opt[Lane], refusal.Error] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel res_shape.err)        { ret res[opt[Lane], refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    if (sel res_shape.ok.integer) { ret res[opt[Lane], refusal.Error].ok{opt[Lane].some{Lane{lane: ty, bits: res_shape.ok.integer.width, lanes: 0}}}; }
    if (sel res_shape.ok.vector) {
        val res_one: res[table.Shape, table.Error] = table.shape(?m.types, res_shape.ok.vector.element);
        if (sel res_one.err)        { ret res[opt[Lane], refusal.Error].err{refusal.Error.ir{module.Error.types{res_one.err}}}; }
        if (sel res_one.ok.integer) { ret res[opt[Lane], refusal.Error].ok{opt[Lane].some{Lane{lane: res_shape.ok.vector.element, bits: res_one.ok.integer.width, lanes: res_shape.ok.vector.lanes}}}; }
    }
    ret res[opt[Lane], refusal.Error].ok{opt[Lane].none{}};
}

# an address and the bytes another address lies past it
# ---
# base:  the address
# bytes: how many bytes past it, as an unsigned word
pub rec Past {
    base:  Value;
    bytes: u64;
}

# the address `address` is a `ptr.add` of a constant word past, and how far, none where it is no such sum. a rewrite
# that adds to `address` adds to the base in its place, so no chain of adds is made
pub fun past(s: *Site, address: Value) opt[Past] {
    val def: Def = s.b.values.data[address].def;
    if (sel def.result) {
        val d: *InstructionData = ?s.b.instructions.data[def.result.instruction];
        if (d.opcode == opcode_table.PTR_ADD && d.operands.len == 2 && !d.metadata.secret) {
            val opt_bytes: opt[u64] = known(s, d.operands.data[1]);
            if (sel opt_bytes.some) { ret opt[Past].some{Past{base: d.operands.data[0], bytes: opt_bytes.some}}; }
        }
    }
    ret opt[Past].none{};
}

# the value of a constant integer that fits a word, none for any other value
pub fun known(s: *Site, x: Value) opt[u64] {
    ret known_in(s.m, s.b, x);
}

# the value of a constant integer of a body that fits a word, none for any
# other value
pub fun known_in(m: *Module, b: *Body, x: Value) opt[u64] {
    val opt_data: opt[ConstantData] = constant_of(m, b, x);
    if (sel opt_data.none)            { ret opt[u64].none{}; }
    if (sel opt_data.some.zero)       { ret opt[u64].some{0}; }
    if (!(sel opt_data.some.integer)) { ret opt[u64].none{}; }
    ret one_word(opt_data.some.integer);
}

# the bits of a constant integer or float of a body that fit a word, a float's
# its encoding in its format, none for any other value
pub fun encoding_in(m: *Module, b: *Body, x: Value) opt[u64] {
    val opt_data: opt[ConstantData] = constant_of(m, b, x);
    if (sel opt_data.none)         { ret opt[u64].none{}; }
    if (sel opt_data.some.zero)    { ret opt[u64].some{0}; }
    if (sel opt_data.some.integer) { ret one_word(opt_data.some.integer); }
    if (sel opt_data.some.float)   { ret one_word(opt_data.some.float); }
    ret opt[u64].none{};
}

fun constant_of(m: *Module, b: *Body, x: Value) opt[ConstantData] {
    val def: Def = b.values.data[x].def;
    if (!(sel def.constant)) { ret opt[ConstantData].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_constant_data.err) { ret opt[ConstantData].none{}; }
    ret opt[ConstantData].some{res_constant_data.ok};
}

# the low word of bits, none where a word above it is not zero
fun one_word(bits: Bits) opt[u64] {
    if (bits.words.size == 0) { ret opt[u64].some{0}; }
    var k: usize = 1;
    for (k < bits.words.size) {
        if (bits.words.data[k] != 0) { ret opt[u64].none{}; }
        k = k + 1;
    }
    ret opt[u64].some{bits.words.data[0]};
}

# the constant of an integer type, or a vector of one, holding x in every lane
pub fun constant(s: *Site, ty: Type, x: Wide) res[Value, refusal.Error] {
    val res_lane_of: res[opt[Lane], refusal.Error] = lane_of(s.m, ty);
    if (sel res_lane_of.err)     { ret res[Value, refusal.Error].err{res_lane_of.err}; }
    if (sel res_lane_of.ok.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a constant asked of a type that holds no integer"}}; }
    val lane:  Lane  = res_lane_of.ok.some;
    val n:     usize = word.words_for(lane.bits)::usize;
    var count: usize = 1;
    if (lane.lanes != 0) { count = lane.lanes::usize; }
    val res_words: res[*u64, allocator.Error] = allocator.zallocate[u64](s.scratch, n);
    if (sel res_words.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_words.err}}; }
    var k: usize = 0;
    for (k < n) {
        res_words.ok[k] = x[k];
        k               = k + 1;
    }
    val res_lanes: res[*Bits, allocator.Error] = allocator.zallocate[Bits](s.scratch, count);
    if (sel res_lanes.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_lanes.err}}; }
    k = 0;
    for (k < count) {
        res_lanes.ok[k] = Bits{type: lane.lane, words: Slice[u64]{data: res_words.ok, size: n}};
        k               = k + 1;
    }
    ret number.place(s.m, s.f, s.scratch, record.Value{type: ty, lanes: Slice[Bits]{data: res_lanes.ok, size: count}});
}

# the constant of a scalar integer type holding x, one value for the site
# however often it is asked, as an address offset is
pub fun word_constant(s: *Site, ty: Type, x: u64) res[Value, refusal.Error] {
    var key:       Word        = Word{ty: ty, x: x};
    val opt_found: opt[*Value] = map.get_by[Word, Value](?s.words, ?key);
    if (sel opt_found.some) { ret res[Value, refusal.Error].ok{@opt_found.some}; }
    val res_made: res[Value, refusal.Error] = constant(s, ty, word.small(x));
    if (sel res_made.err) { ret res_made; }
    val res_kept: res[bool, allocator.Error] = map.insert_by[Word, Value](?s.words, key, res_made.ok);
    if (sel res_kept.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_kept.err}}; }
    ret res_made;
}

# the constant of a float type whose encoding is x, in every lane of a vector
pub fun float_constant(s: *Site, ty: Type, x: Wide) res[Value, refusal.Error] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?s.m.types, ty);
    if (sel res_shape.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    var lane:  Type        = ty;
    var count: usize       = 1;
    var shape: table.Shape = res_shape.ok;
    if (sel res_shape.ok.vector) {
        lane  = res_shape.ok.vector.element;
        count = res_shape.ok.vector.lanes::usize;
        val res_lane_shape: res[table.Shape, table.Error] = table.shape(?s.m.types, lane);
        if (sel res_lane_shape.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{res_lane_shape.err}}}; }
        shape = res_lane_shape.ok;
    }
    if (!(sel shape.float)) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a float constant asked of a type that is not a float"}}; }
    val opt_row: opt[type_format.Row] = type_format.row(shape.float.format);
    if (sel opt_row.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a float constant of a format with no row"}}; }
    val n:         usize                      = word.words_for(opt_row.some.width)::usize;
    val res_words: res[*u64, allocator.Error] = allocator.zallocate[u64](s.scratch, n);
    if (sel res_words.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_words.err}}; }
    var k: usize = 0;
    for (k < n) {
        res_words.ok[k] = x[k];
        k               = k + 1;
    }
    val res_lanes: res[*Bits, allocator.Error] = allocator.zallocate[Bits](s.scratch, count);
    if (sel res_lanes.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{res_lanes.err}}; }
    k = 0;
    for (k < count) {
        res_lanes.ok[k] = Bits{type: lane, words: Slice[u64]{data: res_words.ok, size: n}};
        k               = k + 1;
    }
    ret number.place(s.m, s.f, s.scratch, record.Value{type: ty, lanes: Slice[Bits]{data: res_lanes.ok, size: count}});
}

# start a rewrite of origin, a placed instruction: what is made goes ahead of
# it, in order
pub fun begin(s: *Site, origin: Instruction) {
    builder.derive(?s.bld, origin);
    builder.before(?s.bld, origin);
}

# start a rewrite of operand x of origin, a placed instruction: what is made
# goes ahead of it, in order, and is as secret as x
pub fun operand(s: *Site, origin: Instruction, x: Value) {
    begin(s, origin);
    builder.secret(?s.bld, s.b.values.data[x].secret);
}

# the flags of what is made next
pub fun flags(s: *Site, f: Flags) {
    builder.flags(?s.bld, f);
}

# whether what is made next is marked secret
pub fun secret(s: *Site, x: bool) {
    builder.secret(?s.bld, x);
}

# make the next instruction, and every one after it, in the slot of origin, in
# place of it
pub fun end(s: *Site, origin: Instruction) {
    builder.flags(?s.bld, NO_FLAGS);
    builder.replacing(?s.bld, origin);
}

fun request(code: Opcode, operands: *Value, count: usize, immediates: *Immediate, slots: usize) Request {
    ret Request{opcode: code, operands: Slice[Value]{data: operands, size: count}, immediates: Slice[Immediate]{data: immediates, size: slots}, targets: Slice[Branch]{data: nil, size: 0}};
}

# the builder's answer `v`, or the body's first value once a call was refused
fun answered(s: *Site, v: Value) Value {
    if (builder.failed(?s.bld)) { ret 0; }
    ret v;
}

# make an operation of two operands
pub fun binary(s: *Site, code: Opcode, a: Value, b: Value) Value {
    var ops: [2]Value = [2]Value{a, b};
    ret answered(s, builder.value(?s.bld, request(code, ?ops[0], 2, nil, 0)));
}

# make an operation of three operands
pub fun ternary(s: *Site, code: Opcode, a: Value, b: Value, c: Value) Value {
    var ops: [3]Value = [3]Value{a, b, c};
    ret answered(s, builder.value(?s.bld, request(code, ?ops[0], 3, nil, 0)));
}

# make an instruction of any operands and immediates, whose results are read
# with `result`
pub fun emit(s: *Site, code: Opcode, operands: Slice[Value], immediates: Slice[Immediate]) Instruction {
    ret builder.emit(?s.bld, request(code, operands.data, operands.size, immediates.data, immediates.size));
}

# the result at a position of an instruction made
pub fun result(s: *Site, i: Instruction, index: u32) Value {
    ret answered(s, builder.result(?s.bld, i, index));
}

# make an operation of one operand
pub fun unary(s: *Site, code: Opcode, a: Value) Value {
    var ops: [1]Value = [1]Value{a};
    ret answered(s, builder.value(?s.bld, request(code, ?ops[0], 1, nil, 0)));
}

# make a conversion of one operand to a type
pub fun convert(s: *Site, code: Opcode, a: Value, to: Type) Value {
    var ops: [1]Value     = [1]Value{a};
    var imm: [1]Immediate = [1]Immediate{Immediate.ty{to}};
    ret answered(s, builder.value(?s.bld, request(code, ?ops[0], 1, ?imm[0], 1)));
}

# the end of a rewrite: ok, or the first call the builder refused
pub fun done(s: *Site) err[refusal.Error] {
    val err_built: err[failure.Error] = builder.done(?s.bld);
    if (sel err_built.err) { ret err[refusal.Error].err{refusal.Error.build{err_built.err}}; }
    ret err[refusal.Error].ok{};
}
