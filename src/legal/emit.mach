# the ground legalisations share: making the instructions that stand in for one
#
# a rewrite opens at the instruction it rewrites, makes the instructions that
# stand in for it ahead of it, and closes by making the last in its slot, which
# takes its uses. every instruction made reads as the one it rewrites, with its
# location, site and secrecy, so a secret value is never made public. a rewrite
# of one operand instead makes a value that stands in for that operand alone,
# which the instruction then reads in its place: what it makes has the
# instruction's location and site and the operand's secrecy, since it holds
# the operand and nothing of the instruction's results. the builder is the
# only maker, and the first call it refuses is the rewrite's failure.
# constants are made in the scratch storage and held by the module.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;

use mirl.build.builder;
use mirl.build.failure;
use mirl.fold.record;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use type_format: mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.opt.number;
use mirl.pass.refusal;

# one function being rewritten
# ---
# m:         the module
# f:         the function
# b:         its body
# scratch:   storage for the constants one rewrite makes
# bld:       the builder
# made:      how many instructions the open rewrite made ahead of its last
# replacing: the open rewrite is making its last instruction
# words:     the value of each word constant made through `word_constant`
pub rec Site {
    m:         *Module;
    f:         Function;
    b:         *Body;
    scratch:   *allocator.Allocator;
    bld:       builder.Builder;
    made:      u32;
    replacing: bool;
    words:     map.MapBy[Word, Value];
}

# a scalar integer constant: its type and the word it holds
rec Word {
    ty: Type;
    x:  u64;
}

fun hash_word(w: *Word) u64 {
    ret (w.x * 0x9e3779b97f4a7c15) ^ w.ty::u64;
}

fun same_word(a: *Word, b: *Word) bool {
    ret a.x == b.x && a.ty == b.ty;
}

# the integer a type is, or the lane of a vector of integers
# ---
# lane:  the type of one lane, the type itself for a scalar
# bits:  the width of a lane
# lanes: how many lanes, zero for a scalar
pub rec Lane {
    lane:  Type;
    bits:  u32;
    lanes: u32;
}

# the flags of a shift whose count is below its operand's width
pub val BOUNDED: Flags = Flags{volatile: false, kept: false, bounded: true};

# the flags of a division whose traps are tested before it
pub val CHECKED: Flags = Flags{volatile: false, kept: false, bounded: false, checked: true};

# the flags of the declassify of a division's trap test
pub val TRAP: Flags = Flags{volatile: false, kept: false, bounded: false, checked: false, public: false, trap: true};

# a site over a function
pub fun init(m: *Module, f: Function, b: *Body, scratch: *allocator.Allocator) Site {
    var s: Site;
    s.m       = m;
    s.f       = f;
    s.b       = b;
    s.scratch = scratch;
    s.bld     = builder.init(m);
    s.words   = map.init_by[Word, Value](m.a, hash_word, same_word);
    builder.enter(?s.bld, f);
    ret s;
}

# give back the storage of a site's word constants
pub fun release(s: *Site) err[allocator.Error] {
    ret map.dnit_by[Word, Value](?s.words);
}

# the integer lane of a type, none for any type that is neither an integer nor
# a vector of integers
pub fun lane_of(m: *Module, ty: Type) res[opt[Lane], refusal.Error] {
    val shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel shape.err)        { ret res[opt[Lane], refusal.Error].err{refusal.Error.ir{module.Error.types{shape.err}}}; }
    if (sel shape.ok.integer) { ret res[opt[Lane], refusal.Error].ok{opt[Lane].some{Lane{lane: ty, bits: shape.ok.integer.width, lanes: 0}}}; }
    if (sel shape.ok.vector) {
        val one: res[table.Shape, table.Error] = table.shape(?m.types, shape.ok.vector.element);
        if (sel one.err)        { ret res[opt[Lane], refusal.Error].err{refusal.Error.ir{module.Error.types{one.err}}}; }
        if (sel one.ok.integer) { ret res[opt[Lane], refusal.Error].ok{opt[Lane].some{Lane{lane: shape.ok.vector.element, bits: one.ok.integer.width, lanes: shape.ok.vector.lanes}}}; }
    }
    ret res[opt[Lane], refusal.Error].ok{opt[Lane].none{}};
}

# the value of a constant integer that fits a word, none for any other value
pub fun known(s: *Site, x: Value) opt[u64] {
    val def: Def = s.b.values.data[x].def;
    if (!(sel def.constant)) { ret opt[u64].none{}; }
    val got: res[ConstantData, module.Error] = module.constant_data(s.m, def.constant);
    if (sel got.err) { ret opt[u64].none{}; }
    val data: ConstantData = got.ok;
    if (sel data.zero)                { ret opt[u64].some{0}; }
    if (!(sel data.integer))          { ret opt[u64].none{}; }
    if (data.integer.words.size == 0) { ret opt[u64].some{0}; }
    var k: usize = 1;
    for (k < data.integer.words.size) {
        if (data.integer.words.data[k] != 0) { ret opt[u64].none{}; }
        k = k + 1;
    }
    ret opt[u64].some{data.integer.words.data[0]};
}

# the constant of an integer type, or a vector of one, holding x in every lane
pub fun constant(s: *Site, ty: Type, x: Wide) res[Value, refusal.Error] {
    val got: res[opt[Lane], refusal.Error] = lane_of(s.m, ty);
    if (sel got.err)     { ret res[Value, refusal.Error].err{got.err}; }
    if (sel got.ok.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a constant asked of a type that holds no integer"}}; }
    val lane:  Lane  = got.ok.some;
    val n:     usize = word.words_for(lane.bits)::usize;
    var count: usize = 1;
    if (lane.lanes != 0) { count = lane.lanes::usize; }
    val words: res[*u64, allocator.Error] = allocator.zallocate[u64](s.scratch, n);
    if (sel words.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{words.err}}; }
    var k: usize = 0;
    for (k < n) {
        words.ok[k] = x[k];
        k           = k + 1;
    }
    val lanes: res[*Bits, allocator.Error] = allocator.zallocate[Bits](s.scratch, count);
    if (sel lanes.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{lanes.err}}; }
    k = 0;
    for (k < count) {
        lanes.ok[k] = Bits{type: lane.lane, words: Slice[u64]{data: words.ok, size: n}};
        k           = k + 1;
    }
    ret number.place(s.m, s.f, s.scratch, record.Value{type: ty, lanes: Slice[Bits]{data: lanes.ok, size: count}});
}

# the constant of a scalar integer type holding x, one value for the site
# however often it is asked, as an address offset is
pub fun word_constant(s: *Site, ty: Type, x: u64) res[Value, refusal.Error] {
    var key:   Word        = Word{ty: ty, x: x};
    val found: opt[*Value] = map.get_by[Word, Value](?s.words, ?key);
    if (sel found.some) { ret res[Value, refusal.Error].ok{@found.some}; }
    val made: res[Value, refusal.Error] = constant(s, ty, word.small(x));
    if (sel made.err) { ret made; }
    val kept: res[bool, allocator.Error] = map.insert_by[Word, Value](?s.words, key, made.ok);
    if (sel kept.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{kept.err}}; }
    ret made;
}

# the constant of a scalar float type whose encoding is x
pub fun float_constant(s: *Site, ty: Type, x: Wide) res[Value, refusal.Error] {
    val shape: res[table.Shape, table.Error] = table.shape(?s.m.types, ty);
    if (sel shape.err)         { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{shape.err}}}; }
    if (!(sel shape.ok.float)) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a float constant asked of a type that is not a float"}}; }
    val row: opt[type_format.Row] = type_format.row(shape.ok.float.format);
    if (sel row.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a float constant of a format with no row"}}; }
    val n:     usize                      = word.words_for(row.some.width)::usize;
    val words: res[*u64, allocator.Error] = allocator.zallocate[u64](s.scratch, n);
    if (sel words.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{words.err}}; }
    var k: usize = 0;
    for (k < n) {
        words.ok[k] = x[k];
        k           = k + 1;
    }
    val lane: res[*Bits, allocator.Error] = allocator.zallocate[Bits](s.scratch, 1);
    if (sel lane.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{lane.err}}; }
    lane.ok[0] = Bits{type: ty, words: Slice[u64]{data: words.ok, size: n}};
    ret number.place(s.m, s.f, s.scratch, record.Value{type: ty, lanes: Slice[Bits]{data: lane.ok, size: 1}});
}

# start a rewrite of origin, which stands at an index of a block: what is made
# goes ahead of it, in order
pub fun open(s: *Site, origin: Instruction, k: Block, index: u32) {
    builder.derive(?s.bld, origin);
    builder.at(?s.bld, k, index);
    s.made      = 0;
    s.replacing = false;
}

# start a rewrite of operand x of origin, which stands at an index of a block:
# what is made goes ahead of it, in order, and is as secret as x
pub fun operand(s: *Site, origin: Instruction, k: Block, index: u32, x: Value) {
    open(s, origin, k, index);
    builder.secret(?s.bld, s.b.values.data[x].secret);
}

# the flags of what is made next
pub fun flags(s: *Site, f: Flags) {
    builder.flags(?s.bld, f);
}

# make the next instruction, and every one after it, in the slot of origin, in
# place of it
pub fun close(s: *Site, origin: Instruction) {
    builder.flags(?s.bld, NO_FLAGS);
    builder.replacing(?s.bld, origin);
    s.replacing = true;
}

fun request(code: Opcode, operands: *Value, count: usize, immediates: *Immediate, slots: usize) Request {
    ret Request{opcode: code, operands: Slice[Value]{data: operands, size: count}, immediates: Slice[Immediate]{data: immediates, size: slots}, targets: Slice[Branch]{data: nil, size: 0}};
}

fun counted(s: *Site) {
    if (!s.replacing) { s.made = s.made + 1; }
}

# make an operation of two operands
pub fun binary(s: *Site, code: Opcode, a: Value, b: Value) Value {
    var ops: [2]Value = [2]Value{a, b};
    counted(s);
    ret builder.value(?s.bld, request(code, ?ops[0], 2, nil, 0));
}

# make an operation of three operands
pub fun ternary(s: *Site, code: Opcode, a: Value, b: Value, c: Value) Value {
    var ops: [3]Value = [3]Value{a, b, c};
    counted(s);
    ret builder.value(?s.bld, request(code, ?ops[0], 3, nil, 0));
}

# make an instruction of any operands and immediates, whose results are read
# with `result`
pub fun make(s: *Site, code: Opcode, operands: Slice[Value], immediates: Slice[Immediate]) Instruction {
    counted(s);
    ret builder.emit(?s.bld, request(code, operands.data, operands.size, immediates.data, immediates.size));
}

# the result at a position of an instruction made
pub fun result(s: *Site, i: Instruction, index: u32) Value {
    ret builder.result(?s.bld, i, index);
}

# make an operation of one operand
pub fun unary(s: *Site, code: Opcode, a: Value) Value {
    var ops: [1]Value = [1]Value{a};
    counted(s);
    ret builder.value(?s.bld, request(code, ?ops[0], 1, nil, 0));
}

# make a conversion of one operand to a type
pub fun convert(s: *Site, code: Opcode, a: Value, to: Type) Value {
    var ops: [1]Value     = [1]Value{a};
    var imm: [1]Immediate = [1]Immediate{Immediate.ty{to}};
    counted(s);
    ret builder.value(?s.bld, request(code, ?ops[0], 1, ?imm[0], 1));
}

# the end of a rewrite: ok, or the first call the builder refused
pub fun done(s: *Site) err[refusal.Error] {
    val built: err[failure.Error] = builder.done(?s.bld);
    if (sel built.err) { ret err[refusal.Error].err{refusal.Error.build{built.err}}; }
    ret err[refusal.Error].ok{};
}
