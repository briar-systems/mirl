# the end of available bodies: each function whose body is a copy of another module's definition
# (`FunctionData.available`) becomes the declaration it stands for
#
# an available body is there for the inliner alone, which runs before this pass. the module defines nothing by it, so
# it must never reach a pass after the inliner or a back end, which would read it as this module's definition. the
# pass runs whatever the build's setting, right after the inliner's row, so a build that does not inline drops the
# bodies all the same. a call of the function stays a call of the definition the link finds elsewhere.
#
# it changes no body that runs here, so it keeps constant time. cost: one look at every function, and the release of
# each available body.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.module;
use mirl.pass.record.Changed;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.changed;
use mirl.pass.refusal;

# the pass: a dropped body's analyses go with the function's mark
pub val AVAILABLE: Pass = Pass{name: "available", kind: Kind.legalise{}, scope: Scope.module{run}, needs: 0, time: Time.keeps{}};

fun run(c: *Context, marks: *Changed) res[bool, refusal.Error] {
    var any: bool  = false;
    var f:   usize = 0;
    for (f < c.m.functions.len) {
        if (c.m.functions.data[f].data.available) {
            val err_dropped: err[module.Error] = module.drop_body(c.m, f::u32);
            if (sel err_dropped.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{err_dropped.err}}; }
            c.m.functions.data[f].data.available = false;
            changed(marks, f::u32);
            any = true;
        }
        f = f + 1;
    }
    ret res[bool, refusal.Error].ok{any};
}
