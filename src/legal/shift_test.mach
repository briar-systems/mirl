# text tests of shift bounding, run through the driver

use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use mirl.legal.check_test.check;
use mirl.legal.shift.SHIFT_BOUND;
use mirl.pass.record.Scope;
use mirl.pass.record.applies;
use targets: mirl.target;
use mirl.target.Shifts;
use mirl.target.Target;

# an unbounded count of each kind of shift, and a count the mask already bounds
#[testing]
val BEFORE: str = "target \"riscv64-linux\"\nfunction @left: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %r = shl %x, %c\n    ret %r\n}\nfunction @sign: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %r = shr.s %x, %c\n    ret %r\n}\nfunction @masked: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %k = and %c, i32 15\n    %r = shr.u %x, %k\n    ret %r\n}\n";

# a zero filling shift is taken by the masked count and a mask of the counts in range, an arithmetic
# shift by a count that is the width less one wherever it is out of range, and a bounded one is marked
#[testing]
val AFTER: str = "target \"riscv64-linux\"\nfunction @left: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %in = lt.u %c, i32 32\n    %e = ext.u %in, to i32\n    %m = neg %e\n    %k = and %c, i32 31\n    %s = shl %x, %k bounded\n    %r = and %s, %m\n    ret %r\n}\nfunction @sign: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %out = ge.u %c, i32 32\n    %e = ext.u %out, to i32\n    %m = neg %e\n    %o = or %c, %m\n    %k = and %o, i32 31\n    %r = shr.s %x, %k bounded\n    ret %r\n}\nfunction @masked: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %c: i32):\n    %k = and %c, i32 15\n    %r = shr.u %x, %k bounded\n    ret %r\n}\n";

test shift__is_bounded_where_the_count_wraps_and_left_alone_where_it_saturates {
    val row: opt[*Target] = targets.first(targets.wraps_shifts);
    if (!(sel row.some))                                         { ret 1; }
    if (check(row.some, ?SHIFT_BOUND, BEFORE, AFTER, true) != 0) { ret 2; }
    var exact: Target = @row.some;
    exact.caps.arithmetic.shifts = Shifts.saturates{};
    if (!applies[Scope](?SHIFT_BOUND, row.some)) { ret 3; }
    if (applies[Scope](?SHIFT_BOUND, ?exact))    { ret 4; }
    ret 0;
}
