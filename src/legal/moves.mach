# how a copy or fill of a length the compiler knows is made: in word
# accesses, the widest each alignment allows, up to the target's bound, and as
# one bulk operation past it
#
# the bound is the target's `bulk.moves`, read from its capability row, never
# its name. the passes that move aggregates through memory, the aggregate
# legalisation and the abi legalisation, ask this one owner, so a copy is made
# one way whichever of them makes it. the aggregate legalisation asks it of a
# `mem.copy` or `mem.fill` of a constant length the front end made too. a bulk
# operation is a `mem.copy` or `mem.fill`: a native instruction, or where the
# target has none a loop the bulk legalisation makes in its place
# (mirl.legal.bulk). a function that requires constant time takes the same
# bound: the loop's count and addresses are formed of the length and the
# addresses alone, each access of it states what the operation states, so
# the constant-time walk judges a step it cannot place by its statement, and
# each access of it in a frame slot states the range of the slot the
# operation moved (`mirl.ir.metadata.Extent`), which the stale stack check and
# the walk take in place of the offset they do not know. word moves past the
# bound grow the walk's cost and the allocator's far faster than the bytes
# moved.

use std.types.bool.bool;

use mirl.target.capability.Capabilities;

# the width of the next access of a run: the widest power of two at most the
# word that the alignment of the run's address admits and the bytes left hold
# ---
# left:  the bytes left to move, at least one
# align: the alignment of the address the access starts at
# word:  the widest access, in bytes, a power of two
pub fun step(left: u64, align: u64, word: u64) u64 {
    var w: u64 = word;
    for (w > 1 && (w > align || w > left)) { w = w / 2; }
    ret w;
}

# the alignment an access at an offset from an aligned address may assume
pub fun aligned_at(align: u64, offset: u64) u64 {
    if (offset == 0) { ret align; }
    val low: u64 = offset & (0 - offset);
    if (low < align) { ret low; }
    ret align;
}

# how many accesses a run of bytes takes in word moves
# ---
# size:  the bytes
# align: the alignment of its start
# word:  the widest access, in bytes
pub fun count(size: u64, align: u64, word: u64) u64 {
    var done: u64 = 0;
    var n:    u64 = 0;
    for (done < size) {
        done = done + step(size - done, aligned_at(align, done), word);
        n    = n + 1;
    }
    ret n;
}

# whether a copy or fill of a run is made in word moves rather than as one
# bulk operation
# ---
# caps:  the target's capabilities
# size:  the bytes
# align: the alignment of its start
# word:  the widest access, in bytes
pub fun in_words(caps: *Capabilities, size: u64, align: u64, word: u64) bool {
    ret count(size, align, word) <= caps.bulk.moves::u64;
}
