# text tests of typed address folding, run through the driver

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;

use mirl.legal.address.ADDRESS;
use mirl.legal.check_test.Text;
use mirl.legal.check_test.check_text;
use mirl.legal.check_test.put;
use mirl.legal.check_test.view;
use mirl.pass.record.Scope;
use mirl.pass.record.applies;
use targets: mirl.target;
use mirl.target.Target;

use std.collections.slice.Slice;
use std.types.string.str;

# a target whose addresses are numbers of eight bytes
#[testing]
fun wide_physical(t: *Target) bool {
    ret targets.eight_byte_pointer(t) && sel t.caps.addressing.physical;
}

#[testing]
fun logical(t: *Target) bool {
    ret sel t.caps.addressing.logical;
}

# the address of the second member of a structure whose offsets it states,
# and of an element of an array of i32 by an i32 index
#[testing]
fun before(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @f: fun(ptr, i32) -> (ptr, ptr) linkage global visibility default {\n^entry(%p: ptr, %i: i32):\n    %m = ptr.member %p, type struct at {0: i32, 12: i32}, member 1\n    %e = ptr.index %p, %i, type array<4, i32>\n    ret %m, %e\n}\n");
}

# the member at its stated offset 12, and the element at the index extended
# to the eight bytes of a pointer times the four bytes of an i32
#[testing]
fun after(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @f: fun(ptr, i32) -> (ptr, ptr) linkage global visibility default {\n^entry(%p: ptr, %i: i32):\n    %m = ptr.add %p, i64 12\n    %w = ext.s %i, to i64\n    %o = mul %w, i64 4\n    %e = ptr.add %p, %o\n    ret %m, %e\n}\n");
}

test address__a_typed_address_folds_to_its_offset_where_addressing_is_physical {
    val row: opt[*Target] = targets.first(wide_physical);
    if (!(sel row.some)) { ret 1; }
    var b: Text;
    var a: Text;
    b.len = 0;
    a.len = 0;
    before(?b, row.some);
    after(?a, row.some);
    if (check_text(row.some, ?ADDRESS, view(?b), view(?a), true, Slice[str]{data: nil, size: 0}) != 0) { ret 2; }
    val kept: opt[*Target] = targets.first(logical);
    if (!(sel kept.some))             { ret 3; }
    if (applies[Scope](?ADDRESS, kept.some)) { ret 4; }
    if (!applies[Scope](?ADDRESS, row.some)) { ret 5; }
    ret 0;
}
