# a format the stand ins are checked in, and the operands they are checked at
# ---
# name:   its name in the text
# bits:   its width
# values: the encodings of a nan, both zeros, both infinities, a signalling
#         nan, the least subnormals, halves either side of zero and of an even
#         and an odd integer, the largest number below the threshold whose
#         sum with it ties, an integer above the threshold and a large number
# pairs:  the operands the operations of two take every pair of: a nan, both
#         zeros, both infinities and two numbers
#[testing]
def Values: [18]u64;

#[testing]
def Pairs: [7]u64;

#[testing]
rec Case {
    name:   str;
    bits:   u32;
    values: Values;
    pairs:  Pairs;
}

#[testing]
val CASES: [2]Case = [2]Case{
    Case{
        name:   "binary32",
        bits:   32,
        values: [18]u64{0x7fc00000, 0x0, 0x80000000, 0x7f800000, 0xff800000, 0x7f800001, 0x1, 0x80000001, 0x3fc00000, 0xbfc00000, 0x40200000, 0xc0200000, 0x3f000000, 0xbe99999a, 0x4affffff, 0xcaffffff, 0x4b800001, 0x7149f2ca},
        pairs:  [7]u64{0x7fc00000, 0x0, 0x80000000, 0x7f800000, 0xff800000, 0x3fc00000, 0xc0200000},
    },
    Case{
        name:   "binary64",
        bits:   64,
        values: [18]u64{0x7ff8000000000000, 0x0, 0x8000000000000000, 0x7ff0000000000000, 0xfff0000000000000, 0x7ff0000000000001, 0x1, 0x8000000000000001, 0x3ff8000000000000, 0xbff8000000000000, 0x4004000000000000, 0xc004000000000000, 0x3fe0000000000000, 0xbfd3333333333333, 0x432fffffffffffff, 0xc32fffffffffffff, 0x4340000000000001, 0x7e37e43c8800759c},
        pairs:  [7]u64{0x7ff8000000000000, 0x0, 0x8000000000000000, 0x7ff0000000000000, 0xfff0000000000000, 0x3ff8000000000000, 0xc004000000000000},
    },
};

# a target that computes binary32 and binary64 under its baseline, with
# fminnum and fmaxnum native there and none of the operations stood in for
#[testing]
fun lacks_float_forms(t: *Target) bool {
    var a: allocator.Allocator;
    page.make(?a);
    var mc:   Machine;
    val bare: res[Build, machine.Error] = machine.build(?mc, ?a, t, NONE);
    if (sel bare.err) { ret false; }
    fin { machine.release(bare.ok); }
    var f: usize = 0;
    for (f < $length_of(Formats)) {
        val h: res[opt[*targets.Held], machine.Error] = machine.held(bare.ok.basis, ?t.caps, FORMATS[f]);
        if (sel h.err)                                                                          { ret false; }
        if (sel h.ok.none)                                                                      { ret false; }
        if (!native(bare.ok, h.ok.some, ir.FMINNUM) || !native(bare.ok, h.ok.some, ir.FMAXNUM)) { ret false; }
        var k: usize = 0;
        for (k < $length_of(Stood)) {
            if (native(bare.ok, h.ok.some, STOOD[k])) { ret false; }
            k = k + 1;
        }
        f = f + 1;
    }
    ret true;
}

#[testing]
def Formats: [2]Format;

#[testing]
val FORMATS: Formats = [2]Format{BINARY32, BINARY64};

#[testing]
val NONE: Slice[str] = Slice[str]{data: nil, size: 0};

# whether a held format computes an operation natively on a build
#[testing]
fun native(b: Build, h: *targets.Held, op: ir.Opcode) bool {
    val c: opt[targets.Condition] = targets.native(h, op);
    if (sel c.none) { ret false; }
    val met: res[bool, machine.Error] = machine.meets(b.basis, c.some);
    ret sel met.ok && met.ok;
}

#[testing]
def Stood: [7]ir.Opcode;

#[testing]
val STOOD: Stood = [7]ir.Opcode{ir.FMIN, ir.FMAX, ir.FFLOOR, ir.FCEIL, ir.FINT, ir.FNEAREST, ir.SELECT};

#[testing]
val UNARY: [4]str = [4]str{"ffloor", "fceil", "fint", "fnearest"};

#[testing]
val BINARY: [2]str = [2]str{"fmin", "fmax"};

#[testing]
fun hex(t: *Text, n: u64) {
    put(t, "0x");
    var digits: [16]u8;
    var count:  usize = 0;
    var rest:   u64   = n;
    for {
        val d: u64 = rest & 0xf;
        if (d < 10) { digits[count] = ('0'::u64 + d)::u8; }
        or          { digits[count] = ('a'::u64 + d - 10)::u8; }
        count = count + 1;
        rest  = rest >> 4;
        if (rest == 0) { brk; }
    }
    var one: [2]u8;
    one[1] = 0;
    for (count > 0) {
        count  = count - 1;
        one[0] = digits[count];
        put(t, ?one[0]);
    }
}

#[testing]
fun operand(t: *Text, c: *Case, x: u64) {
    put(t, c.name);
    put(t, " ");
    hex(t, x);
}

# one function returning one operation of constants, named by the count of
# those before it
#[testing]
fun function(t: *Text, n: *u64, c: *Case, op: str, condition: str, a: u64, b: opt[u64]) {
    put(t, "function @f");
    decimal(t, @n);
    @n = @n + 1;
    put(t, ": fun() -> (");
    put(t, c.name);
    put(t, ") linkage local visibility default {\n^entry:\n    %r = ");
    put(t, op);
    put(t, " ");
    if (condition != nil) {
        put(t, condition);
        put(t, ", ");
    }
    operand(t, c, a);
    if (sel b.some) {
        put(t, ", ");
        operand(t, c, b.some);
    }
    put(t, "\n    ret %r\n}\n");
}

# the module of every operation at every operand of every case, each function
# its own, in a fixed order
#[testing]
fun module_text(t: *Text, target: str) {
    put(t, "target \"");
    put(t, target);
    put(t, "\"\n");
    var n: u64   = 0;
    var c: usize = 0;
    for (c < $length_of(CASES)) {
        val k: *Case = ?CASES[c];
        var o: usize = 0;
        for (o < $length_of(UNARY)) {
            var i: usize = 0;
            for (i < $length_of(Values)) {
                function(t, ?n, k, UNARY[o], nil, k.values[i], opt[u64].none{});
                i = i + 1;
            }
            o = o + 1;
        }
        o = 0;
        for (o < $length_of(BINARY)) {
            var i: usize = 0;
            for (i < $length_of(Pairs)) {
                var j: usize = 0;
                for (j < $length_of(Pairs)) {
                    function(t, ?n, k, BINARY[o], nil, k.pairs[i], opt[u64].some{k.pairs[j]});
                    j = j + 1;
                }
                i = i + 1;
            }
            o = o + 1;
        }
        var i: usize = 0;
        for (i < $length_of(Pairs)) {
            var j: usize = 0;
            for (j < $length_of(Pairs)) {
                function(t, ?n, k, "select", "i1 1", k.pairs[i], opt[u64].some{k.pairs[j]});
                function(t, ?n, k, "select", "i1 0", k.pairs[i], opt[u64].some{k.pairs[j]});
                j = j + 1;
            }
            i = i + 1;
        }
        c = c + 1;
    }
}

# the module's text read and run through the passes given, in order, for the
# target with no machine, so no extension holds
#[testing]
fun ran(a: *allocator.Allocator, t: *Target, held: Build, text: *Text, stand: bool, out: *Module) i32 {
    var read: res[Module, Refusal] = parse_body(a, view(text));
    if (sel read.err) { ret 1; }
    @out = read.ok;
    val started: res[Driver, Error] = driver.init(out, t, held, Options{level: 1, checked: true});
    if (sel started.err) { ret 2; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    if (stand) {
        val floated: res[bool, Error] = driver.apply(?d, ?FLOATS);
        if (sel floated.err) { ret 3; }
        if (!floated.ok)     { ret 3; }
    }
    val folded: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel folded.err) { ret 4; }
    ret 0;
}

# the bits the function at an index returns, once folded to a constant
#[testing]
fun returned(m: *Module, f: usize, scratch: *allocator.Allocator) opt[u64] {
    val got: res[*Body, module.Error] = module.body(m, Function{index: f::u32});
    if (sel got.err) { ret opt[u64].none{}; }
    val list: *Body = got.ok;
    if (list.blocks.len == 0) { ret opt[u64].none{}; }
    val placed: usize = list.blocks.data[0].instructions.len;
    if (placed == 0) { ret opt[u64].none{}; }
    val last: Instruction = list.blocks.data[0].instructions.data[placed - 1];
    val d:    usize       = last.index::usize;
    if (list.instructions.data[d].operands.len != 1) { ret opt[u64].none{}; }
    val v: res[opt[folder.Value], Why] = number.read(m, list, scratch, list.instructions.data[d].operands.data[0]);
    if (sel v.err)     { ret opt[u64].none{}; }
    if (sel v.ok.none) { ret opt[u64].none{}; }
    ret opt[u64].some{v.ok.some.lanes.data[0].words.data[0]};
}

# whether an encoding of a width is a nan: every exponent bit set and a
# significand that is not zero
#[testing]
fun nan(bits: u32, x: u64) bool {
    var exponent: u64 = 0x7ff;
    var shift:    u64 = 52;
    if (bits == 32) {
        exponent = 0xff;
        shift    = 23;
    }
    val significand: u64 = (1u64 << shift) - 1;
    ret ((x >> shift) & exponent) == exponent && (x & significand) != 0;
}

# where the target has no native form, fmin, fmax, ffloor, fceil, fint,
# fnearest and a select of floats, stood in for and folded, give what the
# folder gives the operation itself at every operand, a nan for a nan and the
# same bits for every other result, of both zeros and both infinities included,
# and a select gives the same bits for a nan too
test floats__stand_ins_agree_with_the_folder {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(lacks_float_forms);
    if (sel row.none) { ret 1; }
    var text: Text;
    text.len = 0;
    module_text(?text, row.some.name);
    var mc:    Machine;
    val built: res[Build, machine.Error] = machine.build(?mc, ?a, row.some, NONE);
    if (sel built.err) { ret 7; }
    fin { machine.release(built.ok); }
    var plain: Module;
    val p:     i32 = ran(?a, row.some, built.ok, ?text, false, ?plain);
    if (p != 0) { ret 10 + p; }
    fin { module.dnit(?plain); }
    var stood: Module;
    val s:     i32 = ran(?a, row.some, built.ok, ?text, true, ?stood);
    if (s != 0) { ret 20 + s; }
    fin { module.dnit(?stood); }

    var ar:     arena.Arena;
    val opened: err[allocator.Error] = arena.init(?ar, ?a, 0);
    if (sel opened.err) { ret 2; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    if (plain.functions.len != stood.functions.len) { ret 3; }
    var at: usize = 0;
    var c:  usize = 0;
    for (c < $length_of(CASES)) {
        val bits:  u32   = CASES[c].bits;
        val count: usize = $length_of(UNARY) * $length_of(Values) + $length_of(BINARY) * $length_of(Pairs) * $length_of(Pairs);
        val total: usize = count + 2 * $length_of(Pairs) * $length_of(Pairs);
        var i:     usize = 0;
        for (i < total) {
            arena.reset(?ar);
            val want: opt[u64] = returned(?plain, at, ?scratch);
            val got:  opt[u64] = returned(?stood, at, ?scratch);
            if (sel want.none) {
                diag.eprintlnf("function {} did not fold", at);
                ret 4;
            }
            if (sel got.none) {
                diag.eprintlnf("function {} did not fold once stood in for", at);
                ret 5;
            }
            val arithmetic: bool = i < count;
            val both_nan:   bool = nan(bits, want.some) && nan(bits, got.some);
            if (!(arithmetic && both_nan) && want.some != got.some) {
                diag.eprintlnf("function {}: the folder gives {:x}, the stand in {:x}", at, want.some, got.some);
                ret 6;
            }
            at = at + 1;
            i  = i + 1;
        }
        c = c + 1;
    }
    ret 0;
}
