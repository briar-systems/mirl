# thread-local globals made ordinary where one thread runs, and refused where
# the target reaches them by an access no selection forms yet
#
# a target whose address model reaches a thread-local model as `single`
# states that one thread runs where its build does not meet the access's
# condition, as webassembly with no threads states for every model. there a
# thread-local global is the one instance its one thread sees, so the pass
# makes it an ordinary global, placed and reached as any other. where the
# build meets the condition threads run, and the target reaches no
# thread-local variable yet, so the global is refused, named. a global the
# model reaches as `indexed`, through the runtime's index of the module's
# block, is refused named as well where the model names no cell holding that
# index, as uefi's, before selection meets it. selection reaches one through
# the cell where the model names it, as windows' _tls_index. the decision
# reads the target's statement and the build's selection alone. the pass
# changes no code, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;

use mirl.ir.global.Tls;
use mirl.ir.id.Global;
use mirl.pass.analysis;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Model;
use mirl.target.basis;

pub val THREADLESS: Pass = Pass{name: "threadless", kind: Kind.legalise{}, scope: Scope.module{run}, preserves: analysis.FLOW, time: Time.keeps{}, applies: single};

val MODELS: [4]Tls = [4]Tls{Tls.general_dynamic{}, Tls.local_dynamic{}, Tls.initial_exec{}, Tls.local_exec{}};

# whether a model reaches a variable through the runtime's index with no
# cell naming that index
fun unindexed(m: *Model, reached: Access) bool {
    ret sel reached.indexed && str_len(m.threads.index) == 0;
}

# whether the target reaches some thread-local model as a single thread's or
# through a runtime's index it names no cell for
fun single(g: *Ground) bool {
    val a: Addresses = g.t.addresses;
    if (!(sel a.model)) { ret false; }
    var k: usize = 0;
    for (k < $length_of([4]Tls)) {
        val reached: Access = address.access(?a.model, MODELS[k]);
        if (sel reached.single || unindexed(?a.model, reached)) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun run(c: *Context) res[bool, Why] {
    val a: Addresses = c.t.addresses;
    if (!(sel a.model)) { ret res[bool, Why].ok{false}; }
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < c.m.globals.len) {
        val tls: opt[Tls] = c.m.globals.data[i].data.tls;
        if (sel tls.some) {
            val reached: Access = address.access(?a.model, tls.some);
            if (unindexed(?a.model, reached)) { ret res[bool, Why].err{Why.indexed{Global{index: i::u32}}}; }
            if (sel reached.single) {
                val threads: res[bool, basis.Error] = basis.meets(c.basis, reached.single);
                if (sel threads.err) { ret res[bool, Why].err{Why.condition{threads.err}}; }
                if (threads.ok)      { ret res[bool, Why].err{Why.threaded{Global{index: i::u32}}}; }
                c.m.globals.data[i].data.tls = opt[Tls].none{};
                changed                      = true;
            }
        }
        i = i + 1;
    }
    ret res[bool, Why].ok{changed};
}
