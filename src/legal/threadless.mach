# thread-local globals made ordinary where one thread runs, and refused where
# the target reaches them by an access no selection forms yet
#
# a target whose address model reaches a thread-local model as `single`
# states that one thread runs where its build does not meet the access's
# condition, as webassembly with no threads states for every model. there a
# thread-local global is the one instance its one thread sees, so the pass
# makes it an ordinary global, placed and reached as any other. where the
# build meets the condition threads run, and the target reaches no
# thread-local variable yet, so the global is refused, named. a global the
# model reaches as `indexed`, through the runtime's index of the module's
# block, is refused named as well where the model names no cell holding that
# index, as uefi's, before selection meets it. selection reaches one through
# the cell where the model names it, as windows' _tls_index. a thread-local
# global made ordinary where one thread runs is refused, named with the
# target, when it is exported, as no image exports a thread-local variable. a
# global the model reaches through a call of the runtime's resolver, as
# darwin's thunk, a tls descriptor's resolver or the general dynamic lookup,
# is refused named with the function when a function that requires constant
# time reaches it, as the constant-time check never reads the resolver's
# code. the decision reads the target's statement, the build's selection and
# each function's mode alone. the pass changes no code, so it keeps constant
# time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str_len;

use std.collections.vector;

use mirl.ir.constant.ConstantData;
use mirl.ir.function.ConstantTime;
use mirl.ir.global.Tls;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.module.Module;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;
use mirl.pass.analysis;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.refusal;
use mirl.pass.refusal.Exported;
use mirl.pass.refusal.Resolved;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Model;
use mirl.target.basis;

pub val THREADLESS: Pass = Pass{name: "threadless", kind: Kind.legalise{}, scope: Scope.module{run}, preserves: analysis.FLOW, time: Time.keeps{}, applies: single};

val MODELS: [4]Tls = [4]Tls{Tls.general_dynamic{}, Tls.local_dynamic{}, Tls.initial_exec{}, Tls.local_exec{}};

# whether a model reaches a variable through the runtime's index with no
# cell naming that index
fun unindexed(m: *Model, reached: Access) bool {
    ret sel reached.indexed && str_len(m.threads.index) == 0;
}

# whether a model reaches a variable through a call of the runtime's resolver
fun resolved(reached: Access) bool {
    ret sel reached.variable || sel reached.descriptor || sel reached.general_dynamic;
}

# whether the target reaches some thread-local model as a single thread's,
# through a runtime's index it names no cell for or through a call of the
# runtime's resolver
fun single(g: *Ground) bool {
    val a: Addresses = g.t.addresses;
    if (!(sel a.model)) { ret false; }
    var k: usize = 0;
    for (k < $length_of([4]Tls)) {
        val reached: Access = address.access(?a.model, MODELS[k]);
        if (sel reached.single || unindexed(?a.model, reached) || resolved(reached)) { ret true; }
        k = k + 1;
    }
    ret false;
}

fun run(c: *Context) res[bool, refusal.Error] {
    val a: Addresses = c.t.addresses;
    if (!(sel a.model)) { ret res[bool, refusal.Error].ok{false}; }
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < c.m.globals.len) {
        val tls: opt[Tls] = c.m.globals.data[i].data.tls;
        if (sel tls.some) {
            val reached: Access = address.access(?a.model, tls.some);
            if (unindexed(?a.model, reached)) { ret res[bool, refusal.Error].err{refusal.Error.indexed{(i::u32)}}; }
            if (resolved(reached)) {
                val timed: opt[Function] = timed_user(c.m, i::Global);
                if (sel timed.some) { ret res[bool, refusal.Error].err{refusal.Error.resolved{Resolved{function: timed.some, global: (i::u32)}}}; }
            }
            if (sel reached.single) {
                val threads: res[bool, basis.Error] = basis.meets(c.basis, reached.single);
                if (sel threads.err)                         { ret res[bool, refusal.Error].err{refusal.Error.condition{threads.err}}; }
                if (threads.ok)                              { ret res[bool, refusal.Error].err{refusal.Error.threaded{(i::u32)}}; }
                if (c.m.globals.data[i].data.linkage.export) { ret res[bool, refusal.Error].err{refusal.Error.exported{Exported{global: (i::u32), arch: c.t.arch.name, sys: c.t.sys.name}}}; }
                c.m.globals.data[i].data.tls = opt[Tls].none{};
                changed                      = true;
            }
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}

# the first function that requires constant time and holds the address of global `g` as a constant, none for none
fun timed_user(m: *Module, g: Global) opt[Function] {
    var f: usize = 0;
    for (f < m.functions.len) {
        val mode: ConstantTime = m.functions.data[f].data.constant_time;
        if (!(sel mode.none)) {
            val values: *vector.Vector[ValueData] = ?m.functions.data[f].body.values;
            var v:      usize                     = 0;
            for (v < values.len) {
                val d: Def = values.data[v].def;
                if (sel d.constant) {
                    val k: ConstantData = m.constants.data[d.constant];
                    if (sel k.address) {
                        val s: Symbol = k.address.symbol;
                        if (sel s.global) {
                            if (s.global == g) { ret opt[Function].some{f::Function}; }
                        }
                    }
                }
                v = v + 1;
            }
        }
        f = f + 1;
    }
    ret opt[Function].none{};
}
