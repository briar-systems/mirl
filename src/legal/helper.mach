# helpers for division, multiplication, float remainders, conversion and bulk
# memory: what no instruction of the target does is a call of a helper mirl
# delivers, and what one does with an operand the ir's operation traps on is
# given the test of that trap
#
# - a division or remainder the target runs, on a target whose division gives
#   a result for a zero divisor or a signed overflow, is given the test the
#   opcode's row states for each such trap, a branch to an `unreachable` that
#   is the trap, and the checked mark, so it is never tested twice.
# - a division at a width the target has no division for, an integer wider
#   than its arithmetic among them, is given the tests of every trap its row
#   states, since a helper traps on none, and calls the helper of its width.
#   where the divisor's magnitude fits half a word, a chain of the target's
#   divisions runs instead, two a word of the dividend from the top, each
#   dividing the remainder so far and the next half word, so the common case
#   never calls. where the target divides a two-word dividend by a word
#   divisor at the word, the chain runs one such division a word, each of the
#   remainder so far and the next word, for any divisor that fits a word.
# - a division of a two-word dividend by a word divisor at a width the target
#   has no instruction for is given the tests of both traps its row states,
#   and runs as the division of the dividend joined at twice the width, which
#   the target divides, or the chain or the helper of that width runs. the
#   remainder is the low word less the quotient times the divisor.
# - a conversion between a float and an integer wider than the target's
#   arithmetic calls the helper of its width and format. where the integer's
#   value fits a word, or the float's does, the target's own conversion at
#   the word runs instead.
# - a product at a width the target has no multiply for calls the helper of
#   its width, constants and a high half's double width product included,
#   so no product reaches the integer legalisations there. where the target
#   multiplies at the word, an integer wider than it is left to the wide
#   legalisation, which splits it into products of words.
# - a float operation a held format computes no native form of under the
#   build's selection, where a helper row stands in for it, calls the helper of
#   its format.
# - a float, or a vector of floats, of a format the target holds no unit for
#   is refused by its type, since no legalisation computes such a format yet.
# - a copy or fill the target has no instruction for calls the helper of the
#   length's width. a kept fill never calls anything another module could
#   define: it is a loop of kept stores of a byte at a time, in place.
#
# the helpers are the rows of mirl.legal.helper.table, delivered into the
# module before the function is rewritten. the tests and the native paths read
# as the instruction they stand for, its location, site and secrecy, and the
# call's results are as secret as the instruction's. whether a division traps
# is public, since the trap shows it, so a test of a secret value is
# declassified before its branch. the native path branches on the value, so
# it is left out of a function that requires constant time, which calls the
# helper whatever the value, and every helper runs in a time that depends on
# no value but a length. a copy or fill whose length is secret is refused in
# such a function. so the pass keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build;
use folder: mirl.fold;
use mirl.fold.algebra;
use mirl.fold.algebra.Op;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.constant.Address;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.Metadata;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Trap;
use mirl.ir.place.Named;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.legal.emit;
use mirl.legal.emit.Lane;
use mirl.legal.emit.Site;
use mirl.legal.helper.deliver;
use mirl.legal.helper.deliver.Number;
use mirl.legal.helper.deliver.Want;
use mirl.legal.helper.table;
use mirl.legal.helper.table.Operation;
use mirl.opt.number;
use mirl.pass.cache;
use mirl.pass.failure;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use targets: mirl.target;
use mirl.target.Condition;
use mirl.target.Division;
use mirl.target.Held;
use mirl.target.Long;
use mirl.target.LongDivision;
use mirl.target.Target;
use mirl.target.machine;

# the pass: it splits blocks and adds edges, so it keeps no analysis
pub val HELPERS: Pass = Pass{name: "helpers", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}, applies: wanted};

val VECTOR:  str = "a vector division, multiply or conversion of integers, or a vector float remainder, the target has no instruction for, which is scalarised first";
val LOGICAL: str = "a copy or fill through memory that cannot be reinterpreted";
val SPACES:  str = "a copy between two address spaces";
val SHAPE:   str = "a division, multiply, float remainder, conversion, copy or fill whose operands are not as its row states";
val LONGEST: str = "a division of a two-word dividend whose word is the widest integer, so no integer holds the dividend";

# whether a target's division gives a result for an operand the ir's traps on
fun quiet(d: *Division) bool {
    if (sel d.zero.quiet || sel d.overflow.quiet) { ret true; }
    val l: LongDivision = d.long;
    ret sel l.native && (sel l.native.zero.quiet || sel l.native.exceeds.quiet);
}

# whether a target divides a two-word dividend by a word divisor at a width
# with an instruction, where the condition of its division is met
fun long_at(t: *Target, met: bool, bits: u32) bool {
    ret met && targets.runs_long(?t.caps.arithmetic.division, bits);
}

# whether some held format of a target may lack a native form of an
# operation a helper row stands in for, under the build's selection
fun lacking(t: *Target) bool {
    if (!(sel t.caps.formats.held)) { ret false; }
    val rows: Slice[table.Row] = table.rows();
    var i:    usize            = 0;
    for (i < t.caps.formats.held.size) {
        var k: usize = 0;
        for (k < rows.size) {
            val stands: opt[Opcode] = rows.data[k].stands;
            if (sel stands.some) {
                val c: opt[Condition] = targets.native(?t.caps.formats.held.data[i], stands.some);
                if (sel c.none)           { ret true; }
                if (!(sel c.some.always)) { ret true; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# whether the pass takes every instance of an opcode out of a function on a
# target, whatever the build selects: a float operation a helper row stands
# in for, which no format the target holds computes natively under any
# condition, or a copy or fill the target has no instruction for
#[testing]
pub fun removes(t: *Target, code: Opcode) bool {
    val row: opt[*table.Row] = table.standing(code);
    if (sel row.some) { ret floats_gone(t, code); }
    val got: opt[Row] = opcode.row(code);
    if (sel got.none) { ret false; }
    var shape: Row = got.some;
    if (opcode.divides_long(?shape)) { ret sel t.caps.arithmetic.division.long.none; }
    val bulk: Operation = bulk_of(?shape);
    if (sel bulk.copy) { ret sel t.caps.bulk.copy.none; }
    if (sel bulk.fill) { ret sel t.caps.bulk.fill.none; }
    ret false;
}

# whether no format a target holds computes an opcode natively under any
# condition
fun floats_gone(t: *Target, code: Opcode) bool {
    if (!(sel t.caps.formats.held)) { ret false; }
    var i: usize = 0;
    for (i < t.caps.formats.held.size) {
        val c: opt[Condition] = targets.native(?t.caps.formats.held.data[i], code);
        if (sel c.some) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the target holds no unit for some float format
fun unheld_formats(t: *Target) bool {
    var i: u32 = 0;
    for (i < types.rows()) {
        val h: opt[*Held] = targets.held(?t.caps, types.Format{index: i});
        if (sel h.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the type of the first value of a body that is a float, or a vector of
# floats, of a format the target holds no unit for. no legalisation computes
# such a format yet, so the pass refuses it by its type, and selection never
# meets it
fun unheld(v: *Visit, b: *Body) res[opt[Type], Why] {
    var i: usize = 0;
    for (i < b.values.len) {
        if (!(sel b.values.data[i].def.removed)) {
            val ty:    Type                          = b.values.data[i].type;
            val shape: res[types.Shape, types.Error] = types.shape(?v.c.m.types, ty);
            if (sel shape.err) { ret res[opt[Type], Why].err{typed(shape.err)}; }
            var scalar: Type = ty;
            if (sel shape.ok.vector) {
                val lane: res[Type, types.Error] = types.element(?v.c.m.types, ty);
                if (sel lane.err) { ret res[opt[Type], Why].err{typed(lane.err)}; }
                scalar = lane.ok;
            }
            val inner: res[types.Shape, types.Error] = types.shape(?v.c.m.types, scalar);
            if (sel inner.err) { ret res[opt[Type], Why].err{typed(inner.err)}; }
            if (sel inner.ok.float) {
                val h: opt[*Held] = targets.held(?v.t.caps, inner.ok.float.format);
                if (sel h.none) { ret res[opt[Type], Why].ok{opt[Type].some{ty}}; }
            }
        }
        i = i + 1;
    }
    ret res[opt[Type], Why].ok{opt[Type].none{}};
}

# whether the pass rewrites something on a target: a division that does not
# trap, an integer wider than its arithmetic, a width with no division, no
# division of a two-word dividend or no multiply, a division or multiply under
# a condition the build's selection may not meet, a float operation a held
# format may lack, a copy or fill with no instruction, or a float format the
# target holds no unit for
fun wanted(t: *Target) bool {
    if (unheld_formats(t))                                      { ret true; }
    if (quiet(?t.caps.arithmetic.division))                     { ret true; }
    if (lacking(t))                                             { ret true; }
    if (!(sel t.caps.arithmetic.division.condition.always))     { ret true; }
    if (!(sel t.caps.arithmetic.multiplied.always))             { ret true; }
    if (sel t.caps.bulk.copy.none || sel t.caps.bulk.fill.none) { ret true; }
    val top: opt[u32] = targets.widest(?t.caps);
    if (sel top.none)                                          { ret false; }
    if (top.some < types.WIDTHS[$length_of(types.Widths) - 1]) { ret true; }
    var i: usize = 0;
    for (i < $length_of(types.Widths)) {
        if (types.WIDTHS[i] > 1 && !natively(t, true, types.WIDTHS[i]))   { ret true; }
        if (types.WIDTHS[i] > 1 && !multiplies(t, true, types.WIDTHS[i])) { ret true; }
        if (!long_at(t, true, types.WIDTHS[i]))                           { ret true; }
        i = i + 1;
    }
    ret false;
}

# the width a division at a width runs at once the narrow integers are
# widened, zero when it is wider than the target's arithmetic
fun effective(t: *Target, bits: u32) u32 {
    if (targets.computes(?t.caps, bits)) { ret bits; }
    val up: opt[u32] = targets.wider(?t.caps, bits);
    if (sel up.some) { ret up.some; }
    ret 0;
}

# whether the target divides at a width with an instruction, where the
# condition of its division is met
fun natively(t: *Target, met: bool, bits: u32) bool {
    val at: u32 = effective(t, bits);
    ret met && at != 0 && targets.holds(t.caps.arithmetic.division.widths, at);
}

# whether the target multiplies at a width with an instruction, or splits a
# width wider than its arithmetic into products of words it multiplies, where
# the condition of its multiply is met
fun multiplies(t: *Target, met: bool, bits: u32) bool {
    if (!met) { ret false; }
    var at: u32 = effective(t, bits);
    if (at == 0) {
        val top: opt[u32] = targets.widest(?t.caps);
        if (sel top.none) { ret false; }
        at = top.some;
    }
    ret targets.holds(t.caps.arithmetic.multiply, at);
}

# how an instruction is rewritten
# ---
# none:      it is left as it is
# tested:    a division the target runs, given the tests of the traps it
#            does not take
# divided:   a division the target has no division for, given the tests of
#            its traps and a call of its helper
# converted: a conversion of a wide integer, a call of its helper
# called:    a copy or fill the target has no instruction for, a call of
#            its helper
# kept:      a kept fill the target has no instruction for, a loop of kept
#            stores
# product:   a product the target has no multiply for, a call of its helper
# remainder: a float operation its format has no native form of, a call of
#            its helper
# long:      a division of a two-word dividend the target has no instruction
#            for, given the tests of its traps and divided at twice the width
tag Form: u8 {
    none;
    tested;
    divided;
    converted;
    called;
    kept;
    product;
    remainder;
    long;
}

# an instruction to rewrite
# ---
# at:        the instruction
# form:      how
# operation: the helper's operation, unstated for a form that calls none
# lane:      the integer lane of a division or conversion, the float type of a
#            remainder, the word of a division of a two-word dividend
# row:       the opcode's row
# traps:     for each trap of the row, whether it is tested
# guarded:   some trap is tested
# helper:    the helper it calls, once delivered
# signature: the helper's function type, once delivered
rec Item {
    at:        Instruction;
    form:      Form;
    operation: Operation;
    lane:      Lane;
    row:       Row;
    traps:     [2]bool;
    guarded:   bool;
    helper:    Function;
    signature: Type;
}

# one visit
# ---
# c:       the run
# f:       the function
# t:       the target
# word:    the widest width the target's arithmetic runs at
# fast:    the native paths may branch on a value, as they may outside a
#          function that requires constant time
# divides: the build's selection meets the condition of the division
# long:    the target divides a two-word dividend by a word divisor at the
#          word, under the condition of the division the build meets
# product: the build's selection meets the condition of the multiply
# scratch: storage for what one step reads or makes, given back after it
# s:       where the rewrite builds, once every helper is delivered
rec Visit {
    c:       *Context;
    f:       Function;
    t:       *Target;
    word:    u32;
    fast:    bool;
    divides: bool;
    long:    bool;
    product: bool;
    scratch: *allocator.Allocator;
    s:       Site;
}

fun type_of(b: *Body, x: Value) Type {
    ret b.values.data[x.index].type;
}

fun secret(b: *Body, x: Value) bool {
    ret b.values.data[x.index].secret;
}

# the integer lane of a type, refused for any other type
fun lane(v: *Visit, ty: Type) res[Lane, Why] {
    val got: res[opt[Lane], Why] = emit.lane_of(v.c.m, ty);
    if (sel got.err)     { ret res[Lane, Why].err{got.err}; }
    if (sel got.ok.none) { ret res[Lane, Why].err{Why.reason{SHAPE}}; }
    ret res[Lane, Why].ok{got.ok.some};
}

# the helper of a division, by the algebra of its opcode
fun division_of(code: Opcode) Operation {
    val a: Op = algebra.algebra(code).op;
    if (sel a.quotient_u)  { ret Operation.quotient_u{}; }
    if (sel a.quotient_s)  { ret Operation.quotient_s{}; }
    if (sel a.remainder_u) { ret Operation.remainder_u{}; }
    if (sel a.remainder_s) { ret Operation.remainder_s{}; }
    ret Operation.unstated{};
}

# the instruction a division runs as, whose faults decide the traps tested
# ---
# none:     no instruction of the target, so every trap is tested
# division: the target's division
# long:     the target's division of a two-word dividend
tag Runs: u8 {
    none;
    division: *Division;
    long:     Long;
}

# whether a trap of a division's row is one the instruction it runs as does
# not take, every trap where it runs as none and any trap the instruction
# states no fault for. a narrow division the target runs widened traps as the
# narrow one, since the narrow widening keeps its overflow
fun untaken(r: Runs, trap: Trap) bool {
    if (sel r.division) {
        if (sel trap.zero)     { ret sel r.division.zero.quiet; }
        if (sel trap.overflow) { ret sel r.division.overflow.quiet; }
    }
    if (sel r.long) {
        if (sel trap.zero)    { ret sel r.long.zero.quiet; }
        if (sel trap.exceeds) { ret sel r.long.exceeds.quiet; }
    }
    ret true;
}

# whether every lane of a constant operand holds a value other than one
fun avoids(v: *Visit, b: *Body, x: Value, bits: u32, one: Wide) res[bool, Why] {
    val got: res[opt[folder.Value], Why] = number.read(v.c.m, b, v.scratch, x);
    if (sel got.err)     { ret res[bool, Why].err{got.err}; }
    if (sel got.ok.none) { ret res[bool, Why].ok{false}; }
    val lanes: Slice[Bits] = got.ok.some.lanes;
    var n:     usize       = 0;
    for (n < lanes.size) {
        if (word.compare(word.mask(word.of(lanes.data[n].words), bits), one) == 0) { ret res[bool, Why].ok{false}; }
        n = n + 1;
    }
    ret res[bool, Why].ok{true};
}

# whether a constant operand rules a trap out: a divisor zero in no lane, or
# for an overflow a dividend least in no lane or a divisor minus one in none
fun excluded(v: *Visit, b: *Body, d: *InstructionData, trap: Trap, bits: u32) res[bool, Why] {
    if (sel trap.zero) { ret avoids(v, b, d.operands.data[trap.zero], bits, word.zero()); }
    if (sel trap.overflow) {
        val low: res[bool, Why] = avoids(v, b, d.operands.data[trap.overflow.dividend], bits, word.least(bits));
        if (sel low.err) { ret low; }
        if (low.ok)      { ret low; }
        ret avoids(v, b, d.operands.data[trap.overflow.divisor], bits, word.ones(bits));
    }
    if (sel trap.exceeds) { ret res[bool, Why].ok{false}; }
    ret res[bool, Why].ok{true};
}

# the traps of a division's row to test, each one the instruction it runs as
# does not take, less those a constant operand rules out
fun wanted_traps(v: *Visit, b: *Body, d: *InstructionData, row: *Row, bits: u32, runs: Runs, out: *[2]bool) res[bool, Why] {
    var any: bool  = false;
    var n:   usize = 0;
    for (n < $length_of(opcode.Traps)) {
        val t: Trap = row.effects.traps[n];
        (@out)[n] = false;
        if (sel t.zero || sel t.overflow || sel t.exceeds) {
            if (untaken(runs, t)) {
                val ruled: res[bool, Why] = excluded(v, b, d, t, bits);
                if (sel ruled.err) { ret ruled; }
                (@out)[n] = !ruled.ok;
                any       = any || !ruled.ok;
            }
        }
        n = n + 1;
    }
    ret res[bool, Why].ok{any};
}

fun item(i: Instruction, form: Form, operation: Operation, ln: Lane, row: Row) Item {
    ret Item{at: i, form: form, operation: operation, lane: ln, row: row, traps: [2]bool{false, false}, guarded: false, helper: Function{index: 0}, signature: Type{index: 0}};
}

fun nothing() res[opt[Item], Why] {
    ret res[opt[Item], Why].ok{opt[Item].none{}};
}

fun planned(it: Item) res[opt[Item], Why] {
    ret res[opt[Item], Why].ok{opt[Item].some{it}};
}

fun refused(why: str) res[opt[Item], Why] {
    ret res[opt[Item], Why].err{Why.reason{why}};
}

fun classify_division(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row) res[opt[Item], Why] {
    var r: Row = row;
    if (opcode.divides_long(?r))                   { ret classify_long(v, b, i, d, row); }
    if (d.operands.len != 2 || d.results.len != 1) { ret refused(SHAPE); }
    val got: res[Lane, Why] = lane(v, type_of(b, d.results.data[0]));
    if (sel got.err) { ret res[opt[Item], Why].err{got.err}; }
    val ln:     Lane           = got.ok;
    var traps:  [2]bool        = [2]bool{false, false};
    val native: bool           = natively(v.t, v.divides, ln.bits);
    var runs:   Runs           = Runs.none{};
    var guard:  res[bool, Why] = res[bool, Why].ok{false};
    if (native)                    { runs = Runs.division{?v.t.caps.arithmetic.division}; }
    if (!d.metadata.flags.checked) { guard = wanted_traps(v, b, d, ?r, ln.bits, runs, ?traps); }
    if (sel guard.err)             { ret res[opt[Item], Why].err{guard.err}; }
    var it: Item = item(i, Form.tested{}, Operation.unstated{}, ln, row);
    it.traps   = traps;
    it.guarded = guard.ok;
    if (native) {
        if (!guard.ok) { ret nothing(); }
        ret planned(it);
    }
    if (ln.lanes != 0) { ret refused(VECTOR); }
    it.form      = Form.divided{};
    it.operation = division_of(d.opcode);
    if (sel it.operation.unstated) { ret refused(SHAPE); }
    ret planned(it);
}

# a division of a two-word dividend: the tests of the traps its instruction
# does not take where the target has one at the width, and otherwise the
# tests of both and the division at twice the width, which calls the helper
# of that width where the target does not divide at it
fun classify_long(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row) res[opt[Item], Why] {
    if (d.operands.len != 3 || d.results.len != 2) { ret refused(SHAPE); }
    val got: res[Lane, Why] = lane(v, type_of(b, d.results.data[0]));
    if (sel got.err) { ret res[opt[Item], Why].err{got.err}; }
    val ln:     Lane           = got.ok;
    var r:      Row            = row;
    var traps:  [2]bool        = [2]bool{false, false};
    val native: bool           = long_at(v.t, v.divides, ln.bits);
    var runs:   Runs           = Runs.none{};
    var guard:  res[bool, Why] = res[bool, Why].ok{false};
    val l:      LongDivision   = v.t.caps.arithmetic.division.long;
    if (sel l.native) {
        if (native) { runs = Runs.long{l.native}; }
    }
    if (!d.metadata.flags.checked) { guard = wanted_traps(v, b, d, ?r, ln.bits, runs, ?traps); }
    if (sel guard.err)             { ret res[opt[Item], Why].err{guard.err}; }
    var it: Item = item(i, Form.tested{}, Operation.unstated{}, ln, row);
    it.traps   = traps;
    it.guarded = guard.ok;
    if (native) {
        if (!guard.ok) { ret nothing(); }
        ret planned(it);
    }
    if (ln.lanes != 0)                                            { ret refused(VECTOR); }
    if (2 * ln.bits > types.WIDTHS[$length_of(types.Widths) - 1]) { ret refused(LONGEST); }
    it.form = Form.long{};
    if (!natively(v.t, v.divides, 2 * ln.bits)) { it.operation = Operation.quotient_u{}; }
    ret planned(it);
}

fun classify_conversion(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row, e: folder.Entry) res[opt[Item], Why] {
    if (d.operands.len != 1 || d.results.len != 1) { ret refused(SHAPE); }
    var integer: Type      = type_of(b, d.results.data[0]);
    var op:      Operation = Operation.to_integer_u{};
    if (sel e.to_float) {
        integer = type_of(b, d.operands.data[0]);
        op      = Operation.to_float_u{};
        if (e.to_float) { op = Operation.to_float_s{}; }
    }
    if (sel e.to_integer) {
        if (e.to_integer) { op = Operation.to_integer_s{}; }
    }
    val got: res[Lane, Why] = lane(v, integer);
    if (sel got.err)           { ret res[opt[Item], Why].err{got.err}; }
    if (got.ok.bits <= v.word) { ret nothing(); }
    if (got.ok.lanes != 0)     { ret refused(VECTOR); }
    ret planned(item(i, Form.converted{}, op, got.ok, row));
}

# whether an opcode's algebra is the product
fun multiplication(code: Opcode) bool {
    val a: Op = algebra.algebra(code).op;
    ret sel a.product;
}

# a product of integers the target has no multiply for, a call of its helper,
# and a product of floats left to the target
fun classify_product(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row) res[opt[Item], Why] {
    if (d.operands.len != 2 || d.results.len != 1) { ret refused(SHAPE); }
    val got: res[opt[Lane], Why] = emit.lane_of(v.c.m, type_of(b, d.results.data[0]));
    if (sel got.err)     { ret res[opt[Item], Why].err{got.err}; }
    if (sel got.ok.none) { ret nothing(); }
    val ln: Lane = got.ok.some;
    if (multiplies(v.t, v.product, ln.bits)) { ret nothing(); }
    if (ln.lanes != 0)                       { ret refused(VECTOR); }
    ret planned(item(i, Form.product{}, Operation.product{}, ln, row));
}

# a float operation a helper row stands in for, a call of its helper where
# the format is held and has no native form of it under the build's selection
fun classify_float(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row, r: *table.Row) res[opt[Item], Why] {
    if (d.operands.len != 2 || d.results.len != 1) { ret refused(SHAPE); }
    val ty:    Type                          = type_of(b, d.results.data[0]);
    val shape: res[types.Shape, types.Error] = types.shape(?v.c.m.types, ty);
    if (sel shape.err)         { ret res[opt[Item], Why].err{typed(shape.err)}; }
    if (sel shape.ok.vector)   { ret refused(VECTOR); }
    if (!(sel shape.ok.float)) { ret refused(SHAPE); }
    val h: opt[*Held] = targets.held(?v.t.caps, shape.ok.float.format);
    if (sel h.none) { ret nothing(); }
    val c: opt[Condition] = targets.native(h.some, d.opcode);
    if (sel c.some) {
        val met: res[bool, machine.Error] = machine.meets(v.c.basis, c.some);
        if (sel met.err) { ret res[opt[Item], Why].err{Why.condition{met.err}}; }
        if (met.ok)      { ret nothing(); }
    }
    val fmt: opt[types.Row] = types.row(shape.ok.float.format);
    if (sel fmt.none) { ret refused(SHAPE); }
    ret planned(item(i, Form.remainder{}, r.operation, Lane{lane: ty, bits: fmt.some.width, lanes: 0}, row));
}

fun classify_bulk(v: *Visit, b: *Body, i: Instruction, d: *InstructionData, row: Row, fill: bool) res[opt[Item], Why] {
    if (d.operands.len != 3) { ret refused(SHAPE); }
    var native: bool = sel v.t.caps.bulk.copy.native;
    if (fill)                                     { native = sel v.t.caps.bulk.fill.native; }
    if (native)                                   { ret nothing(); }
    if (!(sel v.t.caps.addressing.physical))      { ret refused(LOGICAL); }
    if (!v.fast && secret(b, d.operands.data[2])) { ret res[opt[Item], Why].err{Why.timing{}}; }
    val none: Lane = Lane{bits: 0, lanes: 0};
    if (fill && d.metadata.flags.kept) { ret planned(item(i, Form.kept{}, Operation.unstated{}, none, row)); }
    if (fill)                          { ret planned(item(i, Form.called{}, Operation.fill{}, none, row)); }
    ret planned(item(i, Form.called{}, Operation.copy{}, none, row));
}

# the bulk operation a row is by the roles of its operands: a length and two
# addresses copy, a length, an address and a stored value fill
fun bulk_of(row: *Row) Operation {
    var lengths:   u32 = 0;
    var addresses: u32 = 0;
    var stored:    u32 = 0;
    val n:         u32 = opcode.fixed(row);
    var k:         u32 = 0;
    for (k < n) {
        val role: opcode.Role = row.operands[k].role;
        if (sel role.length)  { lengths = lengths + 1; }
        if (sel role.address) { addresses = addresses + 1; }
        if (sel role.stored)  { stored = stored + 1; }
        k = k + 1;
    }
    if (lengths != 1)                  { ret Operation.unstated{}; }
    if (addresses == 2 && stored == 0) { ret Operation.copy{}; }
    if (addresses == 1 && stored == 1) { ret Operation.fill{}; }
    ret Operation.unstated{};
}

# whether an opcode is one the pass rewrites where the target has no
# instruction for it at every width wider than its arithmetic: a division, a
# conversion between a float and an integer, a copy or a fill. a product is
# not, since the wide legalisation splits it where the target multiplies at
# the word
pub fun takes(code: Opcode) bool {
    val got: opt[Row] = opcode.row(code);
    if (sel got.none) { ret false; }
    var row: Row = got.some;
    if (opcode.divides(?row)) { ret true; }
    val e: folder.Entry = folder.entry(code);
    if (sel e.to_float || sel e.to_integer) { ret true; }
    val bulk: Operation = bulk_of(?row);
    ret !(sel bulk.unstated);
}

# how an instruction is rewritten, none when it is left as it is
fun classify(v: *Visit, b: *Body, i: Instruction) res[opt[Item], Why] {
    val d:   *InstructionData = ?b.instructions.data[i.index];
    val got: opt[Row]         = opcode.row(d.opcode);
    if (sel got.none) { ret nothing(); }
    val row: Row = got.some;
    if (opcode.divides(?row))     { ret classify_division(v, b, i, d, row); }
    if (multiplication(d.opcode)) { ret classify_product(v, b, i, d, row); }
    val stands: opt[*table.Row] = table.standing(d.opcode);
    if (sel stands.some) { ret classify_float(v, b, i, d, row, stands.some); }
    val e: folder.Entry = folder.entry(d.opcode);
    if (sel e.to_float || sel e.to_integer) { ret classify_conversion(v, b, i, d, row, e); }
    val op: Operation = bulk_of(?row);
    if (sel op.fill) { ret classify_bulk(v, b, i, d, row, true); }
    if (sel op.copy) { ret classify_bulk(v, b, i, d, row, false); }
    ret nothing();
}

# every instruction of the function to rewrite, in block order
fun scan(v: *Visit, b: *Body, items: *vector.Vector[Item]) err[Why] {
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val got: res[opt[Item], Why] = classify(v, b, b.blocks.data[k].instructions.data[n]);
                if (sel got.err) { ret err[Why].err{got.err}; }
                if (sel got.ok.some) {
                    val pushed: res[usize, allocator.Error] = vector.push[Item](items, got.ok.some);
                    if (sel pushed.err) { ret failure.lost(pushed.err); }
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret err[Why].ok{};
}

fun typed(e: types.Error) Why {
    ret Why.ir{module.Error.types{e}};
}

# what an item asks of the delivery
fun want_of(v: *Visit, b: *Body, it: *Item) res[Want, Why] {
    val d: *InstructionData = ?b.instructions.data[it.at.index];
    if (sel it.form.divided || sel it.form.product) { ret res[Want, Why].ok{Want{operation: it.operation, bits: it.lane.bits, format: opt[types.Format].none{}, space: 0}}; }
    if (sel it.form.long)                           { ret res[Want, Why].ok{Want{operation: it.operation, bits: 2 * it.lane.bits, format: opt[types.Format].none{}, space: 0}}; }
    if (sel it.form.remainder) {
        val fmt: res[types.Format, types.Error] = types.format(?v.c.m.types, it.lane.lane);
        if (sel fmt.err) { ret res[Want, Why].err{typed(fmt.err)}; }
        ret res[Want, Why].ok{Want{operation: it.operation, bits: it.lane.bits, format: opt[types.Format].some{fmt.ok}, space: 0}};
    }
    if (sel it.form.converted) {
        var float: Type = type_of(b, d.operands.data[0]);
        if (sel it.operation.to_float_u || sel it.operation.to_float_s) { float = type_of(b, d.results.data[0]); }
        val fmt: res[types.Format, types.Error] = types.format(?v.c.m.types, float);
        if (sel fmt.err) { ret res[Want, Why].err{typed(fmt.err)}; }
        ret res[Want, Why].ok{Want{operation: it.operation, bits: it.lane.bits, format: opt[types.Format].some{fmt.ok}, space: 0}};
    }
    val space: res[u32, types.Error] = types.space(?v.c.m.types, type_of(b, d.operands.data[0]));
    if (sel space.err) { ret res[Want, Why].err{typed(space.err)}; }
    if (sel it.operation.copy) {
        val other: res[u32, types.Error] = types.space(?v.c.m.types, type_of(b, d.operands.data[1]));
        if (sel other.err)        { ret res[Want, Why].err{typed(other.err)}; }
        if (other.ok != space.ok) { ret res[Want, Why].err{Why.reason{SPACES}}; }
    }
    val w: res[u32, types.Error] = types.width(?v.c.m.types, type_of(b, d.operands.data[2]));
    if (sel w.err) { ret res[Want, Why].err{typed(w.err)}; }
    ret res[Want, Why].ok{Want{operation: it.operation, bits: w.ok, format: opt[types.Format].none{}, space: space.ok}};
}

# deliver the helper of every item that calls one
fun deliver_all(v: *Visit, items: *vector.Vector[Item], scratch: *allocator.Allocator) err[Why] {
    var n: usize = 0;
    for (n < items.len) {
        val it:    *Item = ?items.data[n];
        val calls: bool  = sel it.form.long && !(sel it.operation.unstated);
        if (calls || sel it.form.divided || sel it.form.converted || sel it.form.called || sel it.form.product || sel it.form.remainder) {
            val got: res[*Body, module.Error] = module.body(v.c.m, v.f);
            if (sel got.err) { ret err[Why].err{Why.ir{got.err}}; }
            val want: res[Want, Why] = want_of(v, got.ok, it);
            if (sel want.err) { ret err[Why].err{want.err}; }
            val sig: res[Type, Why] = deliver.signature(v.c.m, want.ok);
            if (sel sig.err) { ret err[Why].err{sig.err}; }
            val helper: res[Function, Why] = deliver.deliver(v.c.m, v.t, scratch, want.ok);
            if (sel helper.err) { ret err[Why].err{helper.err}; }
            it.helper    = helper.ok;
            it.signature = sig.ok;
        }
        n = n + 1;
    }
    ret err[Why].ok{};
}

fun body_of(v: *Visit) *Body {
    ret v.s.b;
}

fun data(v: *Visit, i: Instruction) *InstructionData {
    ret ?v.s.b.instructions.data[i.index];
}

# a new block of the function, of no parameter or of one
fun block(v: *Visit, param: opt[Declaration]) Block {
    if (sel param.some) {
        var one: [1]Declaration = [1]Declaration{param.some};
        ret build.block(?v.s.bld, Slice[Declaration]{data: ?one[0], size: 1});
    }
    ret build.block(?v.s.bld, Slice[Declaration]{data: nil, size: 0});
}

fun joined(ty: Type, hidden: bool) opt[Declaration] {
    ret opt[Declaration].some{Declaration{type: ty, secret: hidden, name: opt[View].none{}}};
}

fun bare() opt[Declaration] {
    ret opt[Declaration].none{};
}

fun no_values() Slice[Value] {
    ret Slice[Value]{data: nil, size: 0};
}

fun no_immediates() Slice[Immediate] {
    ret Slice[Immediate]{data: nil, size: 0};
}

fun no_targets() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

# end the block the builder is at in a branch to a block, passing arguments
fun jump(v: *Visit, to: Block, arguments: Slice[Value]) {
    var targets: [1]Branch = [1]Branch{Branch{block: to, arguments: arguments}};
    build.emit(?v.s.bld, Request{opcode: opcode.BR, operands: no_values(), immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 1}});
}

# end the block the builder is at in a branch on a condition
fun fork(v: *Visit, condition: Value, yes: Block, no: Block) {
    var ops:     [1]Value  = [1]Value{condition};
    var targets: [2]Branch = [2]Branch{Branch{block: yes, arguments: no_values()}, Branch{block: no, arguments: no_values()}};
    build.emit(?v.s.bld, Request{opcode: opcode.CBR, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 2}});
}

# the trap: a block of one `unreachable`
fun trap(v: *Visit, k: Block) {
    build.at_end(?v.s.bld, k);
    build.emit(?v.s.bld, Request{opcode: opcode.UNREACHABLE, operands: no_values(), immediates: no_immediates(), targets: no_targets()});
}

# move an instruction and those after it to a block
fun move(v: *Visit, from: Block, at: u32, to: Block) err[Why] {
    val built: err[Why] = emit.done(?v.s);
    if (sel built.err) { ret built; }
    ret failure.edit(body.move(v.c.m, v.f, from, at, to));
}

fun note(failed: *opt[Why], why: Why) {
    val before: opt[Why] = @failed;
    if (sel before.none) { @failed = opt[Why].some{why}; }
}

# an integer constant, or a vector of one
fun integer(v: *Visit, ty: Type, x: Wide, failed: *opt[Why]) Value {
    val made: res[Value, Why] = emit.constant(?v.s, ty, x);
    if (sel made.err) {
        note(failed, made.err);
        ret Value{index: 0};
    }
    ret made.ok;
}

# a float constant of its encoding's bits
fun float(v: *Visit, ty: Type, bits: u64, failed: *opt[Why]) Value {
    var held:  [1]u64          = [1]u64{bits};
    var lanes: [1]Bits         = [1]Bits{Bits{type: ty, words: Slice[u64]{data: ?held[0], size: 1}}};
    val made:  res[Value, Why] = number.place(v.c.m, v.f, v.s.scratch, folder.Value{type: ty, lanes: Slice[Bits]{data: ?lanes[0], size: 1}});
    if (sel made.err) {
        note(failed, made.err);
        ret Value{index: 0};
    }
    ret made.ok;
}

fun integer_type(v: *Visit, bits: u32, failed: *opt[Why]) Type {
    val made: res[Type, types.Error] = types.intern(?v.c.m.types, types.Shape.integer{types.Integer{width: bits}});
    if (sel made.err) {
        note(failed, typed(made.err));
        ret Type{index: 0};
    }
    ret made.ok;
}

# a condition true in any lane of a vector of conditions
fun any(v: *Visit, x: Value, ln: Lane) Value {
    if (ln.lanes == 0) { ret x; }
    ret emit.unary(?v.s, opcode.REDUCE_OR, x);
}

# a condition made public: whether a division traps is shown by the trap
fun public(v: *Visit, x: Value) Value {
    if (build.failed(?v.s.bld)) { ret x; }
    if (!secret(body_of(v), x)) { ret x; }
    val was: bool = v.s.bld.secret;
    build.secret(?v.s.bld, false);
    val out: Value = emit.unary(?v.s, opcode.DECLASSIFY, x);
    build.secret(?v.s.bld, was);
    ret out;
}

# the condition under which a division of two operands traps, made public:
# each trap of its row, or only those the target's division does not take
fun condition(v: *Visit, it: *Item, ops: Slice[Value], ty: Type, failed: *opt[Why]) Value {
    var cond: Value = Value{index: 0};
    var have: bool  = false;
    var n:    usize = 0;
    for (n < $length_of(opcode.Traps)) {
        val t:    Trap  = it.row.effects.traps[n];
        val want: bool  = it.traps[n];
        var made: Value = Value{index: 0};
        var got:  bool  = false;
        if (sel t.zero) {
            if (want) {
                made = any(v, emit.binary(?v.s, opcode.EQ, ops.data[t.zero], integer(v, ty, word.zero(), failed)), it.lane);
                got  = true;
            }
        }
        if (sel t.exceeds) {
            if (want) {
                made = any(v, emit.binary(?v.s, opcode.GE_U, ops.data[t.exceeds.dividend], ops.data[t.exceeds.divisor]), it.lane);
                got  = true;
            }
        }
        if (sel t.overflow) {
            if (want) {
                val low:   Value = emit.binary(?v.s, opcode.EQ, ops.data[t.overflow.dividend], integer(v, ty, word.least(it.lane.bits), failed));
                val minus: Value = emit.binary(?v.s, opcode.EQ, ops.data[t.overflow.divisor], integer(v, ty, word.ones(it.lane.bits), failed));
                made = any(v, emit.binary(?v.s, opcode.AND, low, minus), it.lane);
                got  = true;
            }
        }
        if (got && have) { cond = emit.binary(?v.s, opcode.OR, cond, made); }
        if (got && !have) {
            cond = made;
            have = true;
        }
        n = n + 1;
    }
    if (!have) { note(failed, Why.reason{"a division tested for no trap"}); }
    ret public(v, cond);
}

fun finish(v: *Visit, failed: opt[Why]) err[Why] {
    if (sel failed.some) { ret err[Why].err{failed.some}; }
    ret emit.done(?v.s);
}

# the operands of a division, two or three
fun operands(v: *Visit, i: Instruction) [3]Value {
    val d:   *InstructionData = data(v, i);
    var ops: [3]Value         = [3]Value{d.operands.data[0], d.operands.data[0], d.operands.data[0]};
    var n:   usize            = 0;
    for (n < d.operands.len && n < 3) {
        ops[n] = d.operands.data[n];
        n      = n + 1;
    }
    ret ops;
}

# end a block in the test of a division's traps, going on to a block where
# it does not trap
fun guard(v: *Visit, it: *Item, k: Block, ops: Slice[Value], ty: Type, then: Block, failed: *opt[Why]) {
    val stop: Block = block(v, bare());
    build.at_end(?v.s.bld, k);
    fork(v, condition(v, it, ops, ty, failed), stop, then);
    trap(v, stop);
}

# a division the target runs: the block is split before it and branches to a
# trap where it would trap, and it is marked checked
fun test(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    val i:      Instruction = it.at;
    var ops:    [3]Value    = operands(v, i);
    val count:  usize       = data(v, i).operands.len;
    val ty:     Type        = type_of(body_of(v), data(v, i).results.data[0]);
    var failed: opt[Why]    = opt[Why].none{};
    build.derive(?v.s.bld, i);
    val rest:  Block    = block(v, bare());
    val moved: err[Why] = move(v, k, p, rest);
    if (sel moved.err) { ret moved; }
    guard(v, it, k, Slice[Value]{data: ?ops[0], size: count}, ty, rest, ?failed);
    val done: err[Why] = finish(v, failed);
    if (sel done.err) { ret done; }
    var md: Metadata = data(v, i).metadata;
    md.flags.checked = true;
    ret failure.edit(body.set_metadata(v.c.m, v.f, i, md));
}

# a call of a helper with arguments, as secret as the instruction it stands for
fun call(v: *Visit, it: *Item, arguments: Slice[Value], hidden: bool, failed: *opt[Why]) Instruction {
    val ptr: res[Type, types.Error] = types.intern(?v.c.m.types, types.Shape.pointer{types.Pointer{space: 0}});
    if (sel ptr.err) {
        note(failed, typed(ptr.err));
        ret Instruction{index: 0};
    }
    val c:      Constant = build.constant(?v.s.bld, ConstantData.address{Address{type: ptr.ok, symbol: Symbol.function{it.helper}, offset: 0}});
    val callee: Value    = build.use_constant(?v.s.bld, c);
    var ops:    [4]Value = [4]Value{callee, callee, callee, callee};
    var n:      usize    = 0;
    for (n < arguments.size) {
        ops[n + 1] = arguments.data[n];
        n          = n + 1;
    }
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{it.signature}, Immediate.named{Named.all{}}};
    build.secret(?v.s.bld, hidden);
    ret build.emit(?v.s.bld, Request{opcode: opcode.CALL, operands: Slice[Value]{data: ?ops[0], size: n + 1}, immediates: Slice[Immediate]{data: ?imm[0], size: 2}, targets: no_targets()});
}

# the magnitude of a signed value, and the fill of its sign
fun magnitude(v: *Visit, x: Value, ty: Type, bits: u32, fill: *Value, failed: *opt[Why]) Value {
    @fill = emit.binary(?v.s, opcode.SHR_S, x, integer(v, ty, word.small((bits - 1)::u64), failed));
    ret signed(v, x, @fill);
}

# a value negated where a fill is all ones
fun signed(v: *Visit, x: Value, fill: Value) Value {
    ret emit.binary(?v.s, opcode.SUB, emit.binary(?v.s, opcode.XOR, x, fill), fill);
}

# the quotient or remainder of an unsigned wide dividend by a divisor that
# fits what one step divides by, by the target's divisions at the word
fun chain(v: *Visit, n: Value, divisor: Value, ty: Type, bits: u32, remainder: bool, failed: *opt[Why]) Value {
    if (v.long) { ret words(v, n, divisor, ty, bits, remainder, failed); }
    ret halves(v, n, divisor, ty, bits, remainder, failed);
}

# the quotient or remainder of an unsigned wide dividend by a divisor that
# fits a word, by the target's division of a two-word dividend at the word:
# one division a word from the top, each of the remainder so far and the next
# word
fun words(v: *Visit, n: Value, divisor: Value, ty: Type, bits: u32, remainder: bool, failed: *opt[Why]) Value {
    val w:   u32   = v.word;
    val top: u32   = bits / w;
    val wty: Type  = integer_type(v, w, failed);
    val dl:  Value = emit.convert(?v.s, opcode.TRUNC, divisor, wty);
    var r:   Value = integer(v, wty, word.zero(), failed);
    var q:   Value = dl;
    var j:   u32   = top;
    for (j > 0) {
        j = j - 1;
        var part: Value = n;
        if (j != 0) { part = emit.binary(?v.s, opcode.SHR_U, n, integer(v, ty, word.small((j * w)::u64), failed)); }
        var ops: [3]Value = [3]Value{r, emit.convert(?v.s, opcode.TRUNC, part, wty), dl};
        emit.flags(?v.s, CHECKED);
        val step: Instruction = emit.make(?v.s, opcode.DIV_WIDE_U, Slice[Value]{data: ?ops[0], size: 3}, no_immediates());
        emit.flags(?v.s, NO_FLAGS);
        r = emit.result(?v.s, step, 1);
        if (!remainder) {
            var placed: Value = emit.convert(?v.s, opcode.EXT_U, emit.result(?v.s, step, 0), ty);
            if (j != 0)       { placed = emit.binary(?v.s, opcode.SHL, placed, integer(v, ty, word.small((j * w)::u64), failed)); }
            if (j + 1 == top) { q = placed; }
            or                { q = emit.binary(?v.s, opcode.OR, q, placed); }
        }
    }
    if (remainder) { ret emit.convert(?v.s, opcode.EXT_U, r, ty); }
    ret q;
}

# the quotient or remainder of an unsigned wide dividend by a divisor below
# half a word, by the target's division at the word: two divisions a word from
# the top, each of the remainder so far joined with the next half word
fun halves(v: *Visit, n: Value, divisor: Value, ty: Type, bits: u32, remainder: bool, failed: *opt[Why]) Value {
    val w:     u32   = v.word;
    val wty:   Type  = integer_type(v, w, failed);
    val shift: Value = integer(v, wty, word.small((w / 2)::u64), failed);
    val low:   Value = integer(v, wty, word.ones(w / 2), failed);
    val dl:    Value = emit.convert(?v.s, opcode.TRUNC, divisor, wty);
    var r:     Value = dl;
    var q:     Value = dl;
    var first: bool  = true;
    var j:     u32   = bits / w;
    for (j > 0) {
        j = j - 1;
        var part: Value = n;
        if (j != 0) { part = emit.binary(?v.s, opcode.SHR_U, n, integer(v, ty, word.small((j * w)::u64), failed)); }
        val wj:     Value    = emit.convert(?v.s, opcode.TRUNC, part, wty);
        var digits: [2]Value = [2]Value{emit.binary(?v.s, opcode.SHR_U, wj, shift), emit.binary(?v.s, opcode.AND, wj, low)};
        var qs:     [2]Value = [2]Value{wj, wj};
        var h:      usize    = 0;
        for (h < 2) {
            var t: Value = digits[h];
            if (!first || h != 0) { t = emit.binary(?v.s, opcode.OR, emit.binary(?v.s, opcode.SHL, r, shift), digits[h]); }
            emit.flags(?v.s, CHECKED);
            qs[h] = emit.binary(?v.s, opcode.DIV_U, t, dl);
            emit.flags(?v.s, NO_FLAGS);
            r = emit.binary(?v.s, opcode.SUB, t, emit.binary(?v.s, opcode.MUL, qs[h], dl));
            h = h + 1;
        }
        if (!remainder) {
            var placed: Value = emit.convert(?v.s, opcode.EXT_U, emit.binary(?v.s, opcode.OR, emit.binary(?v.s, opcode.SHL, qs[0], shift), qs[1]), ty);
            if (j != 0) { placed = emit.binary(?v.s, opcode.SHL, placed, integer(v, ty, word.small((j * w)::u64), failed)); }
            if (first)  { q = placed; }
            or          { q = emit.binary(?v.s, opcode.OR, q, placed); }
        }
        first = false;
    }
    if (remainder) { ret emit.convert(?v.s, opcode.EXT_U, r, ty); }
    ret q;
}

# the flags of a division whose traps are tested before it
val CHECKED: Flags = Flags{volatile: false, kept: false, bounded: false, checked: true};

# put the parameter of the block that joins two paths in place of the
# instruction's result, and take the instruction out
fun join(v: *Visit, i: Instruction, rest: Block, failed: opt[Why]) err[Why] {
    val done: err[Why] = finish(v, failed);
    if (sel done.err) { ret done; }
    val old:      Value    = data(v, i).results.data[0];
    val new:      Value    = body_of(v).blocks.data[rest.index].parameters.data[0];
    val replaced: err[Why] = failure.edit(body.replace(v.c.m, v.f, old, new, Records.follow{}));
    if (sel replaced.err) { ret replaced; }
    ret failure.edit(body.erase(v.c.m, v.f, i));
}

# whether a division at a width the target has no division for may run the
# chain of the target's divisions at the word: the native paths may branch,
# the width is wider than the word, and the target divides a two-word dividend
# at the word or divides at a word it can halve
fun inline(v: *Visit, bits: u32) bool {
    if (!v.fast || bits <= v.word) { ret false; }
    ret v.long || (v.word % 2 == 0 && natively(v.t, v.divides, v.word));
}

# the width of the widest divisor one step of the chain divides by
fun reach(v: *Visit) u32 {
    if (v.long) { ret v.word; }
    ret v.word / 2;
}

# a division the target has no division for: the tests of its traps, then a
# call of its helper, or the chain of the target's divisions where the
# divisor's magnitude fits what one step divides by
fun divide(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    val i:      Instruction  = it.at;
    var ops:    [3]Value     = operands(v, i);
    val ty:     Type         = type_of(body_of(v), data(v, i).results.data[0]);
    val hidden: bool         = secret(body_of(v), data(v, i).results.data[0]);
    val tested: bool         = it.guarded;
    val signs:  bool         = sel it.operation.quotient_s || sel it.operation.remainder_s;
    val keeps:  bool         = sel it.operation.remainder_u || sel it.operation.remainder_s;
    val fast:   bool         = inline(v, it.lane.bits);
    var failed: opt[Why]     = opt[Why].none{};
    val args:   Slice[Value] = Slice[Value]{data: ?ops[0], size: 2};
    build.derive(?v.s.bld, i);

    if (!fast) {
        if (tested) {
            val rest:  Block    = block(v, bare());
            val moved: err[Why] = move(v, k, p, rest);
            if (sel moved.err) { ret moved; }
            guard(v, it, k, args, ty, rest, ?failed);
            build.derive(?v.s.bld, i);
        }
        build.replacing(?v.s.bld, i);
        call(v, it, args, hidden, ?failed);
        ret finish(v, failed);
    }

    val rest:  Block    = block(v, joined(ty, hidden));
    val split: Block    = block(v, bare());
    val near:  Block    = block(v, bare());
    val far:   Block    = block(v, bare());
    val moved: err[Why] = move(v, k, p, rest);
    if (sel moved.err) { ret moved; }
    if (tested)        { guard(v, it, k, args, ty, split, ?failed); }
    or {
        build.at_end(?v.s.bld, k);
        jump(v, split, no_values());
    }
    build.at_end(?v.s.bld, split);
    paths(v, it, Paths{x: ops[0], y: ops[1], ty: ty, bits: it.lane.bits, signs: signs, keeps: keeps, hidden: hidden, args: args, near: near, far: far, rest: rest}, ?failed);
    ret join(v, i, rest, failed);
}

# the two paths of a division the chain may run
# ---
# x:      the dividend
# y:      the divisor
# ty:     their type
# bits:   its width
# signs:  the division reads its operands as signed
# keeps:  it gives the remainder
# hidden: its result is secret
# args:   the arguments of its helper
# near:   the block of the chain
# far:    the block of the call
# rest:   the block both go to, with what they give
rec Paths {
    x:      Value;
    y:      Value;
    ty:     Type;
    bits:   u32;
    signs:  bool;
    keeps:  bool;
    hidden: bool;
    args:   Slice[Value];
    near:   Block;
    far:    Block;
    rest:   Block;
}

# end the block the builder is at in a branch on whether the divisor's
# magnitude fits what one step of the chain divides by: the chain where it
# does and a call of the helper where it does not, each going on to rest with
# what it gives. a signed division divides the magnitudes and puts the sign
# back
fun paths(v: *Visit, it: *Item, d: Paths, failed: *opt[Why]) {
    var n:     Value = d.x;
    var m:     Value = d.y;
    var nfill: Value = d.x;
    var mfill: Value = d.y;
    if (d.signs) {
        n = magnitude(v, d.x, d.ty, d.bits, ?nfill, failed);
        m = magnitude(v, d.y, d.ty, d.bits, ?mfill, failed);
    }
    val above: Value = emit.binary(?v.s, opcode.SHR_U, m, integer(v, d.ty, word.small(reach(v)::u64), failed));
    fork(v, emit.binary(?v.s, opcode.EQ, above, integer(v, d.ty, word.zero(), failed)), d.near, d.far);

    build.at_end(?v.s.bld, d.near);
    var out: Value = chain(v, n, m, d.ty, d.bits, d.keeps, failed);
    if (d.signs && d.keeps)  { out = signed(v, out, nfill); }
    if (d.signs && !d.keeps) { out = signed(v, out, emit.binary(?v.s, opcode.XOR, nfill, mfill)); }
    var passed: [1]Value = [1]Value{out};
    jump(v, d.rest, Slice[Value]{data: ?passed[0], size: 1});

    build.at_end(?v.s.bld, d.far);
    passed[0] = build.result(?v.s.bld, call(v, it, d.args, d.hidden, failed), 0);
    build.secret(?v.s.bld, data(v, it.at).metadata.secret);
    jump(v, d.rest, Slice[Value]{data: ?passed[0], size: 1});
}

# a division of a two-word dividend the target has no instruction for: the
# tests of its traps, then the division of the dividend joined at twice the
# width, by the target's division there, the chain or the helper of that
# width. the quotient fits the word once the traps are tested, so it is the
# low word of that quotient, and the remainder is the low word of the dividend
# less the quotient times the divisor
fun lower(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    val i:      Instruction = it.at;
    var ops:    [3]Value    = operands(v, i);
    val ty:     Type        = type_of(body_of(v), data(v, i).results.data[0]);
    val hidden: bool        = secret(body_of(v), data(v, i).results.data[0]);
    val bits:   u32         = 2 * it.lane.bits;
    var failed: opt[Why]    = opt[Why].none{};
    build.derive(?v.s.bld, i);
    val wide:  Type     = integer_type(v, bits, ?failed);
    val rest:  Block    = block(v, joined(wide, hidden));
    val split: Block    = block(v, bare());
    val moved: err[Why] = move(v, k, p, rest);
    if (sel moved.err) { ret moved; }
    if (it.guarded)    { guard(v, it, k, Slice[Value]{data: ?ops[0], size: 3}, ty, split, ?failed); }
    or {
        build.at_end(?v.s.bld, k);
        jump(v, split, no_values());
    }

    build.at_end(?v.s.bld, split);
    val high:   Value    = emit.binary(?v.s, opcode.SHL, emit.convert(?v.s, opcode.EXT_U, ops[0], wide), integer(v, wide, word.small(it.lane.bits::u64), ?failed));
    val n:      Value    = emit.binary(?v.s, opcode.OR, high, emit.convert(?v.s, opcode.EXT_U, ops[1], wide));
    val m:      Value    = emit.convert(?v.s, opcode.EXT_U, ops[2], wide);
    var args:   [2]Value = [2]Value{n, m};
    var passed: [1]Value = [1]Value{n};
    if (natively(v.t, v.divides, bits)) {
        emit.flags(?v.s, CHECKED);
        passed[0] = emit.binary(?v.s, opcode.DIV_U, n, m);
        emit.flags(?v.s, NO_FLAGS);
        jump(v, rest, Slice[Value]{data: ?passed[0], size: 1});
    }
    or (inline(v, bits)) {
        val near: Block = block(v, bare());
        val far:  Block = block(v, bare());
        paths(v, it, Paths{x: n, y: m, ty: wide, bits: bits, signs: false, keeps: false, hidden: hidden, args: Slice[Value]{data: ?args[0], size: 2}, near: near, far: far, rest: rest}, ?failed);
    }
    or {
        passed[0] = build.result(?v.s.bld, call(v, it, Slice[Value]{data: ?args[0], size: 2}, hidden, ?failed), 0);
        build.secret(?v.s.bld, data(v, i).metadata.secret);
        jump(v, rest, Slice[Value]{data: ?passed[0], size: 1});
    }

    build.at(?v.s.bld, rest, 0);
    val q:    Value    = emit.convert(?v.s, opcode.TRUNC, build.parameter(?v.s.bld, rest, 0), ty);
    val r:    Value    = emit.binary(?v.s, opcode.SUB, ops[1], emit.binary(?v.s, opcode.MUL, q, ops[2]));
    val done: err[Why] = finish(v, failed);
    if (sel done.err) { ret done; }
    val results:  *InstructionData = data(v, i);
    val first:    Value            = results.results.data[0];
    val second:   Value            = results.results.data[1];
    val quotient: err[Why]         = failure.edit(body.replace(v.c.m, v.f, first, q, Records.follow{}));
    if (sel quotient.err) { ret quotient; }
    val remainder: err[Why] = failure.edit(body.replace(v.c.m, v.f, second, r, Records.follow{}));
    if (sel remainder.err) { ret remainder; }
    ret failure.edit(body.erase(v.c.m, v.f, i));
}

# the condition that a float converts exactly at the word: it is no nan and
# lies inside the range of the word, which for an unsigned word starts at 0
fun inside(v: *Visit, x: Value, ty: Type, signs: bool, failed: *opt[Why]) Value {
    val fmt: res[types.Format, types.Error] = types.format(?v.c.m.types, ty);
    if (sel fmt.err) {
        note(failed, typed(fmt.err));
        ret x;
    }
    val got: res[Number, Why] = deliver.number_of(fmt.ok);
    if (sel got.err) {
        note(failed, got.err);
        ret x;
    }
    var num: Number = got.ok;
    var top: i64    = v.word::i64;
    if (signs) { top = top - 1; }
    val bound: u64   = deliver.limit(?num, top);
    val below: Value = emit.binary(?v.s, opcode.FLT_O, x, float(v, ty, bound, failed));
    if (signs) { ret emit.binary(?v.s, opcode.AND, emit.binary(?v.s, opcode.FGT_O, x, float(v, ty, bound | (1u64 << (num.width - 1)::u64), failed)), below); }
    ret emit.binary(?v.s, opcode.AND, emit.binary(?v.s, opcode.FGE_O, x, float(v, ty, 0, failed)), below);
}

# a conversion of a wide integer: a call of its helper, or the target's own
# conversion at the word where the value fits one
fun convert(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    val i:      Instruction  = it.at;
    val code:   Opcode       = data(v, i).opcode;
    var args:   [1]Value     = [1]Value{data(v, i).operands.data[0]};
    val x:      Value        = args[0];
    val from:   Type         = type_of(body_of(v), x);
    val to:     Type         = type_of(body_of(v), data(v, i).results.data[0]);
    val hidden: bool         = secret(body_of(v), data(v, i).results.data[0]);
    val floats: bool         = sel it.operation.to_float_u || sel it.operation.to_float_s;
    val signs:  bool         = sel it.operation.to_float_s || sel it.operation.to_integer_s;
    val arg:    Slice[Value] = Slice[Value]{data: ?args[0], size: 1};
    var failed: opt[Why]     = opt[Why].none{};
    build.derive(?v.s.bld, i);
    if (!v.fast) {
        build.replacing(?v.s.bld, i);
        call(v, it, arg, hidden, ?failed);
        ret finish(v, failed);
    }

    val rest:  Block    = block(v, joined(to, hidden));
    val near:  Block    = block(v, bare());
    val far:   Block    = block(v, bare());
    val moved: err[Why] = move(v, k, p, rest);
    if (sel moved.err) { ret moved; }
    val wty: Type = integer_type(v, v.word, ?failed);
    build.at_end(?v.s.bld, k);
    var fits: Value = x;
    if (floats && signs) { fits = emit.binary(?v.s, opcode.EQ, emit.convert(?v.s, opcode.EXT_S, emit.convert(?v.s, opcode.TRUNC, x, wty), from), x); }
    if (floats && !signs) {
        val above: Value = emit.binary(?v.s, opcode.SHR_U, x, integer(v, from, word.small(v.word::u64), ?failed));
        fits = emit.binary(?v.s, opcode.EQ, above, integer(v, from, word.zero(), ?failed));
    }
    if (!floats) { fits = inside(v, x, from, signs, ?failed); }
    fork(v, fits, near, far);

    build.at_end(?v.s.bld, near);
    var out: Value = x;
    if (floats) { out = emit.convert(?v.s, code, emit.convert(?v.s, opcode.TRUNC, x, wty), to); }
    or {
        var extend: Opcode = opcode.EXT_U;
        if (signs) { extend = opcode.EXT_S; }
        out = emit.convert(?v.s, extend, emit.convert(?v.s, code, x, wty), to);
    }
    var passed: [1]Value = [1]Value{out};
    jump(v, rest, Slice[Value]{data: ?passed[0], size: 1});

    build.at_end(?v.s.bld, far);
    passed[0] = build.result(?v.s.bld, call(v, it, arg, hidden, ?failed), 0);
    build.secret(?v.s.bld, data(v, i).metadata.secret);
    jump(v, rest, Slice[Value]{data: ?passed[0], size: 1});
    ret join(v, i, rest, failed);
}

# a copy or fill the target has no instruction for, a call of its helper in its place
fun bulk(v: *Visit, it: *Item) err[Why] {
    val d:      *InstructionData = data(v, it.at);
    var args:   [3]Value         = [3]Value{d.operands.data[0], d.operands.data[1], d.operands.data[2]};
    var failed: opt[Why]         = opt[Why].none{};
    build.derive(?v.s.bld, it.at);
    build.replacing(?v.s.bld, it.at);
    call(v, it, Slice[Value]{data: ?args[0], size: 3}, false, ?failed);
    ret finish(v, failed);
}

# a product the target has no multiply for, or a float operation its format
# has no native form of, a call of its helper in its place, its result as
# secret as the instruction's
fun replace(v: *Visit, it: *Item) err[Why] {
    val d:      *InstructionData = data(v, it.at);
    var args:   [2]Value         = [2]Value{d.operands.data[0], d.operands.data[1]};
    val hidden: bool             = secret(body_of(v), d.results.data[0]);
    var failed: opt[Why]         = opt[Why].none{};
    build.derive(?v.s.bld, it.at);
    build.replacing(?v.s.bld, it.at);
    call(v, it, Slice[Value]{data: ?args[0], size: 2}, hidden, ?failed);
    ret finish(v, failed);
}

# a kept fill as a loop of kept stores of its byte, one address a step, the
# store in the fill's place
fun keep(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    val i:      Instruction = it.at;
    val to:     Value       = data(v, i).operands.data[0];
    val byte:   Value       = data(v, i).operands.data[1];
    val count:  Value       = data(v, i).operands.data[2];
    val lt:     Type        = type_of(body_of(v), count);
    var failed: opt[Why]    = opt[Why].none{};
    build.derive(?v.s.bld, i);
    val head:  Block    = block(v, joined(lt, secret(body_of(v), count)));
    val step:  Block    = block(v, bare());
    val rest:  Block    = block(v, bare());
    val moved: err[Why] = move(v, k, p, step);
    if (sel moved.err) { ret moved; }
    val after: err[Why] = move(v, step, 1, rest);
    if (sel after.err) { ret after; }

    build.at_end(?v.s.bld, k);
    var start: [1]Value = [1]Value{integer(v, lt, word.zero(), ?failed)};
    jump(v, head, Slice[Value]{data: ?start[0], size: 1});

    build.at_end(?v.s.bld, head);
    val at: Value = build.parameter(?v.s.bld, head, 0);
    fork(v, emit.binary(?v.s, opcode.LT_U, at, count), step, rest);

    build.at(?v.s.bld, step, 0);
    var ops: [2]Value     = [2]Value{emit.binary(?v.s, opcode.PTR_ADD, to, at), byte};
    var imm: [1]Immediate = [1]Immediate{Immediate.alignment{1}};
    build.replacing(?v.s.bld, i);
    build.flags(?v.s.bld, KEPT);
    build.emit(?v.s.bld, Request{opcode: opcode.STORE, operands: Slice[Value]{data: ?ops[0], size: 2}, immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
    build.flags(?v.s.bld, NO_FLAGS);
    build.at_end(?v.s.bld, step);
    var next: [1]Value = [1]Value{emit.binary(?v.s, opcode.ADD, at, integer(v, lt, word.small(1), ?failed))};
    jump(v, head, Slice[Value]{data: ?next[0], size: 1});
    ret finish(v, failed);
}

# the flags of a store no pass may drop
val KEPT: Flags = Flags{volatile: false, kept: true, bounded: false, checked: false};

fun rewrite(v: *Visit, it: *Item, k: Block, p: u32) err[Why] {
    if (sel it.form.tested)    { ret test(v, it, k, p); }
    if (sel it.form.divided)   { ret divide(v, it, k, p); }
    if (sel it.form.converted) { ret convert(v, it, k, p); }
    if (sel it.form.called)    { ret bulk(v, it); }
    if (sel it.form.product)   { ret replace(v, it); }
    if (sel it.form.remainder) { ret replace(v, it); }
    if (sel it.form.long)      { ret lower(v, it, k, p); }
    ret keep(v, it, k, p);
}

# no item stands at an instruction
val UNPLANNED: u32 = 0xffffffff;

# rewrite the divisions, products, float remainders, conversions, copies and
# fills of one function
#
# every refusal comes before the first edit: the function is read and each
# helper it needs delivered, and only then rewritten. a rewrite moves the rest
# of its block to a block added after the others, so the walk reaches it
# there, and what a rewrite makes is never an item.
fun visit(u: *Unit) res[bool, Why] {
    val c:     *Context                 = u.context;
    val first: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel first.err) { ret res[bool, Why].err{Why.ir{first.err}}; }
    val top: opt[u32] = targets.widest(?c.t.caps);
    if (sel top.none) { ret res[bool, Why].err{Why.reason{"a target whose arithmetic runs at no width"}}; }

    var held: arena.Arena;
    val kept: err[allocator.Error] = arena.init(?held, c.m.a, 0);
    if (sel kept.err) { ret res[bool, Why].err{Why.alloc{kept.err}}; }
    fin { arena.dnit(?held); }
    var lasting: allocator.Allocator;
    arena.make(?lasting, ?held);
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, Why].err{Why.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    var v: Visit;
    v.c       = c;
    v.f       = u.f;
    v.t       = c.t;
    v.word    = top.some;
    v.fast    = !c.m.functions.data[u.f.index].data.constant_time;
    v.scratch = ?scratch;
    val divides: res[bool, machine.Error] = machine.meets(c.basis, c.t.caps.arithmetic.division.condition);
    if (sel divides.err) { ret res[bool, Why].err{Why.condition{divides.err}}; }
    val product: res[bool, machine.Error] = machine.meets(c.basis, c.t.caps.arithmetic.multiplied);
    if (sel product.err) { ret res[bool, Why].err{Why.condition{product.err}}; }
    v.divides = divides.ok;
    v.long    = long_at(c.t, divides.ok, top.some);
    v.product = product.ok;

    val float: res[opt[Type], Why] = unheld(?v, first.ok);
    if (sel float.err)     { ret res[bool, Why].err{float.err}; }
    if (sel float.ok.some) { ret res[bool, Why].err{Why.unheld{float.ok.some}}; }

    var items:   vector.Vector[Item] = vector.init[Item](?lasting);
    val scanned: err[Why]            = scan(?v, first.ok, ?items);
    if (sel scanned.err) { ret res[bool, Why].err{scanned.err}; }
    if (items.len == 0)  { ret res[bool, Why].ok{false}; }
    val delivered: err[Why] = deliver_all(?v, ?items, ?scratch);
    if (sel delivered.err) { ret res[bool, Why].err{delivered.err}; }

    # the delivery may have moved the module's functions, so the body is read again
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }
    val b:     *Body                       = got.ok;
    var index: vector.Vector[u32]          = vector.init[u32](?lasting);
    val room:  res[usize, allocator.Error] = vector.reserve[u32](?index, b.instructions.len);
    if (sel room.err) { ret res[bool, Why].err{Why.alloc{room.err}}; }
    var n: usize = 0;
    for (n < b.instructions.len) {
        vector.push[u32](?index, UNPLANNED);
        n = n + 1;
    }
    n = 0;
    for (n < items.len) {
        index.data[items.data[n].at.index] = n::u32;
        n                                  = n + 1;
    }

    v.s = emit.init(c.m, u.f, b, ?scratch);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var p: usize = 0;
            for (p < b.blocks.data[k].instructions.len) {
                val i: Instruction = b.blocks.data[k].instructions.data[p];
                if (i.index::usize < index.len && index.data[i.index] != UNPLANNED) {
                    val at: u32 = index.data[i.index];
                    index.data[i.index] = UNPLANNED;
                    arena.reset(?ar);
                    val r: err[Why] = rewrite(?v, ?items.data[at], Block{index: k::u32}, p::u32);
                    if (sel r.err) { ret res[bool, Why].err{r.err}; }
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    ret res[bool, Why].ok{true};
}
