# text tests of the helpers legalisation, run through the driver

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use types: mirl.ir.type;
use mirl.ir.type.Type;

use mirl.legal.check_test.Text;
use mirl.legal.check_test.check;
use mirl.legal.check_test.check_text;
use mirl.legal.check_test.put;
use mirl.legal.check_test.view;
use mirl.legal.helper.HELPERS;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.failure.Why;
use targets: mirl.target;
use mirl.target.Fault;
use mirl.target.Target;
use mirl.target.capability.Condition;
use mirl.target.machine;
use mirl.target.machine.Build;
use mirl.target.machine.Machine;

# a wide division of a value that may fit half a word
#[testing]
val NATIVE_BEFORE: str = "target \"riscv64-linux\"\nfunction @quotient: fun(i128, i128) -> (i128) linkage global visibility default {\n^entry(%x: i128, %y: i128):\n    %q = div.u %x, %y\n    ret %q\n}\n";

# the divisor is tested for zero, and where it fits half a word the target's
# divisions run two to a word of the dividend from the top, each marked
# checked, and otherwise the helper of the width is called
#[testing]
val NATIVE_AFTER: str = "target \"riscv64-linux\"\nfunction @quotient: fun(i128, i128) -> (i128) linkage global visibility default {\n^entry(%x: i128, %y: i128):\n    %zero = eq %y, i128 0\n    cbr %zero, ^trap, ^split\n^join(%q: i128):\n    ret %q\n^split:\n    %above = shr.u %y, i128 32\n    %fits = eq %above, i128 0\n    cbr %fits, ^near, ^far\n^near:\n    %d = trunc %y, to i64\n    %x1w = shr.u %x, i128 64\n    %w1 = trunc %x1w, to i64\n    %h1 = shr.u %w1, i64 32\n    %l1 = and %w1, i64 4294967295\n    %q1h = div.u %h1, %d checked\n    %p1h = mul %q1h, %d\n    %r1h = sub %h1, %p1h\n    %s1 = shl %r1h, i64 32\n    %t1 = or %s1, %l1\n    %q1l = div.u %t1, %d checked\n    %p1l = mul %q1l, %d\n    %r1l = sub %t1, %p1l\n    %u1 = shl %q1h, i64 32\n    %q1 = or %u1, %q1l\n    %e1 = ext.u %q1, to i128\n    %top = shl %e1, i128 64\n    %w0 = trunc %x, to i64\n    %h0 = shr.u %w0, i64 32\n    %l0 = and %w0, i64 4294967295\n    %s0 = shl %r1l, i64 32\n    %t0 = or %s0, %h0\n    %q0h = div.u %t0, %d checked\n    %p0h = mul %q0h, %d\n    %r0h = sub %t0, %p0h\n    %s0l = shl %r0h, i64 32\n    %t0l = or %s0l, %l0\n    %q0l = div.u %t0l, %d checked\n    %p0l = mul %q0l, %d\n    %r0l = sub %t0l, %p0l\n    %u0 = shl %q0h, i64 32\n    %q0 = or %u0, %q0l\n    %e0 = ext.u %q0, to i128\n    %chained = or %top, %e0\n    br ^join(%chained)\n^far:\n    %called = call ptr @__mirl_udiv128, %x, %y, signature fun(i128, i128) -> (i128), named all\n    br ^join(%called)\n^trap:\n    unreachable\n}\nfunction @__mirl_udiv128: fun(i128, i128) -> (i128) linkage weak visibility hidden constant_time {\n^entry(%n: i128, %d: i128):\n    br ^step(i32 128, %n, i128 0, i128 0)\n^step(%k: i32, %a: i128, %q: i128, %r: i128):\n    %carry = shr.u %r, i128 127\n    %high = shr.u %a, i128 127\n    %r1 = shl %r, i128 1\n    %r2 = or %r1, %high\n    %a1 = shl %a, i128 1\n    %q1 = shl %q, i128 1\n    %over = ne %carry, i128 0\n    %fits = ge.u %r2, %d\n    %take = or %over, %fits\n    %r3 = sub %r2, %d\n    %r4 = select %take, %r3, %r2\n    %bit = ext.u %take, to i128\n    %q2 = or %q1, %bit\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %q2, %r4), ^done\n^done:\n    ret %q2\n}\n";

# a wide remainder where the function requires constant time
#[testing]
val GENERAL_BEFORE: str = "target \"riscv64-linux\"\nfunction @remainder: fun(i256, i256) -> (i256) linkage global visibility default constant_time {\n^entry(%x: i256, %y: i256):\n    %r = rem.u %x, %y\n    ret %r\n}\n";

# the divisor is tested for zero and the helper of the width is called
# whatever the values, delivered weak and hidden
#[testing]
val GENERAL_AFTER: str = "target \"riscv64-linux\"\nfunction @remainder: fun(i256, i256) -> (i256) linkage global visibility default constant_time {\n^entry(%x: i256, %y: i256):\n    %zero = eq %y, i256 0\n    cbr %zero, ^trap, ^divide\n^divide:\n    %r = call ptr @__mirl_urem256, %x, %y, signature fun(i256, i256) -> (i256), named all\n    ret %r\n^trap:\n    unreachable\n}\nfunction @__mirl_urem256: fun(i256, i256) -> (i256) linkage weak visibility hidden constant_time {\n^entry(%n: i256, %d: i256):\n    br ^step(i32 256, %n, i256 0, i256 0)\n^step(%k: i32, %a: i256, %q: i256, %r: i256):\n    %carry = shr.u %r, i256 255\n    %high = shr.u %a, i256 255\n    %r1 = shl %r, i256 1\n    %r2 = or %r1, %high\n    %a1 = shl %a, i256 1\n    %q1 = shl %q, i256 1\n    %over = ne %carry, i256 0\n    %fits = ge.u %r2, %d\n    %take = or %over, %fits\n    %r3 = sub %r2, %d\n    %r4 = select %take, %r3, %r2\n    %bit = ext.u %take, to i256\n    %q2 = or %q1, %bit\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %q2, %r4), ^done\n^done:\n    ret %r4\n}\n";

# three wide divisions in two functions
#[testing]
val ONCE_BEFORE: str = "target \"riscv64-linux\"\nfunction @first: fun(i128, i128) -> (i128) linkage global visibility default constant_time {\n^entry(%x: i128, %y: i128):\n    %q = div.u %x, %y\n    %r = div.u %q, %y\n    ret %r\n}\nfunction @second: fun(i128, i128) -> (i128) linkage global visibility default constant_time {\n^entry(%x: i128, %y: i128):\n    %q = div.u %y, %x\n    ret %q\n}\n";

# each calls the one helper
#[testing]
val ONCE_AFTER: str = "target \"riscv64-linux\"\nfunction @first: fun(i128, i128) -> (i128) linkage global visibility default constant_time {\n^entry(%x: i128, %y: i128):\n    %zero = eq %y, i128 0\n    cbr %zero, ^trap, ^divide\n^divide:\n    %q = call ptr @__mirl_udiv128, %x, %y, signature fun(i128, i128) -> (i128), named all\n    %again = eq %y, i128 0\n    cbr %again, ^stop, ^more\n^trap:\n    unreachable\n^more:\n    %r = call ptr @__mirl_udiv128, %q, %y, signature fun(i128, i128) -> (i128), named all\n    ret %r\n^stop:\n    unreachable\n}\nfunction @second: fun(i128, i128) -> (i128) linkage global visibility default constant_time {\n^entry(%x: i128, %y: i128):\n    %zero = eq %x, i128 0\n    cbr %zero, ^trap, ^divide\n^divide:\n    %q = call ptr @__mirl_udiv128, %y, %x, signature fun(i128, i128) -> (i128), named all\n    ret %q\n^trap:\n    unreachable\n}\nfunction @__mirl_udiv128: fun(i128, i128) -> (i128) linkage weak visibility hidden constant_time {\n^entry(%n: i128, %d: i128):\n    br ^step(i32 128, %n, i128 0, i128 0)\n^step(%k: i32, %a: i128, %q: i128, %r: i128):\n    %carry = shr.u %r, i128 127\n    %high = shr.u %a, i128 127\n    %r1 = shl %r, i128 1\n    %r2 = or %r1, %high\n    %a1 = shl %a, i128 1\n    %q1 = shl %q, i128 1\n    %over = ne %carry, i128 0\n    %fits = ge.u %r2, %d\n    %take = or %over, %fits\n    %r3 = sub %r2, %d\n    %r4 = select %take, %r3, %r2\n    %bit = ext.u %take, to i128\n    %q2 = or %q1, %bit\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %q2, %r4), ^done\n^done:\n    ret %q2\n}\n";

# a signed division at a width the target divides at
#[testing]
val QUIET_BEFORE: str = "target \"riscv64-linux\"\nfunction @quotient: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %q = div.s %x, %y\n    ret %q\n}\n";

# the zero divisor and the least value over minus one branch to a trap, and
# the division is marked checked
#[testing]
val QUIET_AFTER: str = "target \"riscv64-linux\"\nfunction @quotient: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %zero = eq %y, i32 0\n    %least = eq %x, i32 -2147483648\n    %minus = eq %y, i32 -1\n    %over = and %least, %minus\n    %traps = or %zero, %over\n    cbr %traps, ^trap, ^divide\n^divide:\n    %q = div.s %x, %y checked\n    ret %q\n^trap:\n    unreachable\n}\n";

# a kept fill of a length known only at run time
#[testing]
val KEPT_BEFORE: str = "target \"riscv64-linux\"\nfunction @wipe: fun(ptr, i64) -> () linkage global visibility default constant_time {\n^entry(%buf: ptr, %n: i64):\n    mem.fill %buf, i8 0, %n, align 1 kept\n    ret\n}\n";

# a loop of kept stores of the byte in the fill's place, which calls nothing
#[testing]
val KEPT_AFTER: str = "target \"riscv64-linux\"\nfunction @wipe: fun(ptr, i64) -> () linkage global visibility default constant_time {\n^entry(%buf: ptr, %n: i64):\n    br ^next(i64 0)\n^next(%i: i64):\n    %more = lt.u %i, %n\n    cbr %more, ^put, ^done\n^put:\n    %at = ptr.add %buf, %i\n    store %at, i8 0, align 1 kept\n    %i1 = add %i, i64 1\n    br ^next(%i1)\n^done:\n    ret\n}\n";

# a target that divides at the word with no trap and has no bulk memory
#[testing]
fun quiet() opt[*Target] {
    ret targets.first(targets.divides_quietly);
}

test helper__a_wide_division_whose_divisor_fits_runs_the_target_divisions_inline {
    val row: opt[*Target] = quiet();
    if (!(sel row.some)) { ret 1; }
    ret check(row.some, ?HELPERS, NATIVE_BEFORE, NATIVE_AFTER, true);
}

test helper__a_wide_division_in_the_general_case_calls_the_helper_of_its_width {
    val row: opt[*Target] = quiet();
    if (!(sel row.some)) { ret 1; }
    ret check(row.some, ?HELPERS, GENERAL_BEFORE, GENERAL_AFTER, true);
}

test helper__a_helper_is_delivered_weak_once_however_many_functions_call_it {
    val row: opt[*Target] = quiet();
    if (!(sel row.some)) { ret 1; }
    ret check(row.some, ?HELPERS, ONCE_BEFORE, ONCE_AFTER, true);
}

test helper__a_division_where_hardware_does_not_trap_is_tested_before_it {
    val row: opt[*Target] = quiet();
    if (!(sel row.some))                                                 { ret 1; }
    if (check(row.some, ?HELPERS, QUIET_BEFORE, QUIET_AFTER, true) != 0) { ret 2; }
    var trapping: Target = @row.some;
    trapping.caps.arithmetic.division.zero     = Fault.traps{};
    trapping.caps.arithmetic.division.overflow = Fault.traps{};
    if (check(?trapping, ?HELPERS, QUIET_BEFORE, QUIET_BEFORE, false) != 0) { ret 3; }
    ret 0;
}

test helper__a_kept_fill_of_a_run_time_length_is_kept_stores_and_never_a_call {
    val row: opt[*Target] = quiet();
    if (!(sel row.some)) { ret 1; }
    ret check(row.some, ?HELPERS, KEPT_BEFORE, KEPT_AFTER, true);
}

# a product at the word, for the target a text names
#[testing]
pub fun product(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @product: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %p = mul %x, %y\n    ret %p\n}\n");
}

# a target with no convention still holds the build's basis, so a multiply
# under the extension the build adds is the target's own and never a call
test helper__a_multiply_under_an_added_extension_is_kept_with_no_convention {
    val row: opt[*Target] = targets.first(targets.multiplies_when_added);
    if (!(sel row.some)) { ret 1; }
    var bare: Target    = targets.unconventional(row.some);
    val t:    *Target   = ?bare;
    val cond: Condition = t.caps.arithmetic.multiplied;
    if (!(sel cond.extension)) { ret 1; }
    var one:   [1]str     = [1]str{cond.extension};
    val added: Slice[str] = Slice[str]{data: ?one[0], size: 1};
    var text:  Text;
    text.len = 0;
    product(?text, t);
    ret check_text(t, ?HELPERS, view(?text), view(?text), false, added);
}

# a sum of two binary32, for the target a text names
#[testing]
fun sum(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @sum: fun(binary32, binary32) -> (binary32) linkage global visibility default {\n^entry(%x: binary32, %y: binary32):\n    %s = fadd %x, %y\n    ret %s\n}\n");
}

# on a target that holds no float format, a float operation is refused by its
# type, the module as it was, and never left for selection to miss
test helper__a_float_of_a_format_the_target_does_not_hold_is_refused_by_its_type {
    val row: opt[*Target] = targets.first(targets.holds_no_float);
    if (!(sel row.some)) { ret 1; }
    var a: allocator.Allocator;
    page.make(?a);
    var text: Text;
    text.len = 0;
    sum(?text, row.some);
    val parsed: res[Module, Refusal] = parse_body(?a, view(?text));
    if (sel parsed.err) { ret 2; }
    var m: Module = parsed.ok;
    fin { module.dnit(?m); }
    val wanted: res[Module, Refusal] = parse_body(?a, view(?text));
    if (sel wanted.err) { ret 2; }
    var want: Module = wanted.ok;
    fin { module.dnit(?want); }
    var mc:   Machine;
    val held: res[Build, machine.Error] = machine.build(?mc, ?a, row.some, Slice[str]{data: nil, size: 0});
    if (sel held.err) { ret 3; }
    fin { machine.release(held.ok); }
    val started: res[Driver, Error] = driver.init(?m, row.some, held.ok, Options{level: 0, checked: true});
    if (sel started.err) { ret 4; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?HELPERS);
    if (!(sel ran.err))         { ret 5; }
    if (!(sel ran.err.refused)) { ret 6; }
    val why: Why = ran.err.refused.why;
    if (!(sel why.unheld)) { ret 7; }
    val single: res[Type, types.Error] = types.intern(?m.types, types.Shape.float{types.Float{format: types.BINARY32}});
    if (sel single.err)                      { ret 8; }
    if (why.unheld.index != single.ok.index) { ret 9; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 10; }
    if (!same.ok)     { ret 11; }
    ret 0;
}
