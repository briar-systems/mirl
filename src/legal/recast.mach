# reinterpretations through a float of a format the build holds no unit for
#
# such a float is held as the integer of its encoding everywhere but at a
# function's boundary (mirl.legal.half), and the passes after that one that
# move a value in integer pieces or words meet the encoding with a
# reinterpretation into the float and one back out: the abi legalisation where
# a piece in an integer register or in memory carries the float, the second
# aggregates run where it moves a leaf as its encoding and the second vectors
# run where it moves a lane so. no register class holds the float, so no
# reinterpretation into it may reach selection. the pass runs after all three:
# a pair of an integer made into the float and read back as the integer is the
# integer, and a reinterpretation into the float nothing reads is taken out.
# what it leaves is a float the convention keeps at a boundary in a register
# that holds it, as x86-64's binary16 in an xmm register. nothing it does
# branches or reads a value, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.contents;
use mirl.ir.function.Body;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.opcode.table;
use mirl.ir.type.format;
use mirl.ir.type.format.Format;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.pass.analysis;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Held;

# the pass: it takes instructions out and never touches an edge or a block
pub val RECASTS: Pass = Pass{name: "unheld recasts", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

# whether the build holds no unit for some float format, or a row's condition
# cannot be read
fun wanted(g: *Ground) bool {
    var i: u32 = 0;
    for (i < format.rows()) {
        val res_held: res[opt[*Held], basis.Error] = basis.held(g.basis, ?g.t.caps, i);
        if (sel res_held.err)     { ret true; }
        if (sel res_held.ok.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a type is a float of a format the build holds no unit for
pub fun unheld(m: *module.Module, b: opt[*Basis], c: *Capabilities, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?m.types, ty);
    if (sel res_shape.err)         { ret false; }
    if (!(sel res_shape.ok.float)) { ret false; }
    ret unheld_format(b, c, res_shape.ok.float.format);
}

# whether the build holds no unit for a number format
pub fun unheld_format(b: opt[*Basis], c: *Capabilities, f: Format) bool {
    val res_held: res[opt[*Held], basis.Error] = basis.held(b, c, f);
    if (sel res_held.err) { ret false; }
    ret sel res_held.ok.none;
}

# whether an instruction of a body is a reinterpretation of one value, from a
# float of a format the build holds no unit for when from is set and to one
# otherwise
fun recast_of(c: *Context, b: *Body, i: usize, from: bool) bool {
    if (b.instructions.data[i].opcode != table.BITCAST || !(sel b.instructions.data[i].place.placed)) { ret false; }
    var at: Value = b.instructions.data[i].results.data[0];
    if (from) { at = b.instructions.data[i].operands.data[0]; }
    ret unheld(c.m, c.basis, ?c.t.caps, b.values.data[at].type);
}

# take out every pair of reinterpretations through a float of a format the
# build holds no unit for in one function, an integer made into it and read
# back as the integer, and then each reinterpretation into such a float nothing
# reads
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val b: *Body = res_body.ok;
    if (!contents.has_opcode(?b.contents, table.BITCAST)) { ret res[bool, refusal.Error].ok{false}; }
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < b.instructions.len) {
        if (recast_of(c, b, i, true)) {
            val x:   Value = b.instructions.data[i].operands.data[0];
            val def: Def   = b.values.data[x].def;
            if (sel def.result) {
                val j: usize = def.result.instruction::usize;
                if (recast_of(c, b, j, false)) {
                    val inner: Value = b.instructions.data[j].operands.data[0];
                    val r:     Value = b.instructions.data[i].results.data[0];
                    if (type_table.same(b.values.data[inner].type, b.values.data[r].type)) {
                        val err_moved: err[refusal.Error] = refusal.edit(body.replace(c.m, u.f, r, inner, Records.follow{}));
                        if (sel err_moved.err) { ret res[bool, refusal.Error].err{err_moved.err}; }
                        val err_gone: err[refusal.Error] = refusal.edit(body.erase(c.m, u.f, (i::u32)));
                        if (sel err_gone.err) { ret res[bool, refusal.Error].err{err_gone.err}; }
                        changed = true;
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        if (recast_of(c, b, i, false) && b.values.data[b.instructions.data[i].results.data[0]].uses.len == 0) {
            val err_gone: err[refusal.Error] = refusal.edit(body.erase(c.m, u.f, (i::u32)));
            if (sel err_gone.err) { ret res[bool, refusal.Error].err{err_gone.err}; }
            changed = true;
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
