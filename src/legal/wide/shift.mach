# the shifts of wide integers over their words
#
# a value is read as its words with zeros below them and, above them, zeros
# or the fill of its sign, and a shift by k moves it k / W words and then
# k % W bits, each word taking the bits that cross into it from its neighbour.
# a constant count is applied as it stands. a count in a value moves the words
# by each bit of k / W in turn, choosing each word with a select, then shifts
# the bits by k % W, the bits crossing in by the width less it, which the ir
# gives as zero where k % W is zero. a count of the width or more gives every
# word zero or the fill, by the ir's rule, chosen with a select. nothing
# branches, so the time a shift takes does not depend on its count.

use std.types.bool.false;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.fold.word;
use mirl.ir.id.Value;
use mirl.ir.opcode;
use mirl.legal.wide.arith;
use mirl.legal.wide.arith.Compare;
use mirl.legal.wide.words;
use mirl.legal.wide.words.Work;

# which way a shift moves the bits and what it fills with
# ---
# left: toward the top, filling with zeros
# zero: toward the bottom, filling with zeros
# sign: toward the bottom, filling with the sign bit
pub tag Way: u8 {
    left;
    zero;
    sign;
}

fun log2(n: u32) u32 {
    var bits: u32 = 0;
    var v:    u32 = n;
    for (v > 1) {
        bits = bits + 1;
        v    = v / 2;
    }
    ret bits;
}

# the word a shift of a fills with past the top
fun filler(w: *Work, way: Way, a: Slice[Value]) Value {
    if (sel way.sign) { ret words.fill(w, a.data[a.size - 1]); }
    ret words.zero(w);
}

# the word at index j of a read with zeros below and the fill above, j offset
# by the word count so that it is never negative
fun at(w: *Work, a: Slice[Value], j: usize, fill: Value) Value {
    if (j < a.size)      { ret words.zero(w); }
    if (j >= a.size * 2) { ret fill; }
    ret a.data[j - a.size];
}

# a shifted by a constant count below its width
pub fun by_constant(w: *Work, way: Way, a: Slice[Value], k: u32) Slice[Value] {
    val n:   usize        = a.size;
    val q:   usize        = (k / w.word)::usize;
    val s:   u32          = k % w.word;
    val f:   Value        = filler(w, way, a);
    val out: Slice[Value] = words.fresh(w, n);
    var i:   usize        = 0;
    for (i < out.size) {
        if (sel way.left) {
            val here:  Value = at(w, a, n + i - q, f);
            var value: Value = words.shift_by(w, opcode.SHL, here, s);
            if (s != 0) { value = words.or_(w, value, words.shift_by(w, opcode.SHR_U, at(w, a, n + i - q - 1, f), w.word - s)); }
            out.data[i] = value;
        }
        or {
            val j:    usize = n + i + q;
            val here: Value = at(w, a, j, f);
            if (s == 0 || j >= n * 2)           { out.data[i] = here; }
            or (sel way.sign && j + 1 == n * 2) { out.data[i] = words.shift_by(w, opcode.SHR_S, here, s); }
            or {
                val down: Value = words.shift_by(w, opcode.SHR_U, here, s);
                out.data[i] = words.or_(w, down, words.shift_by(w, opcode.SHL, at(w, a, j + 1, f), w.word - s));
            }
        }
        i = i + 1;
    }
    ret out;
}

# a shifted by a count of as many words, by the ir's rule for a count of the
# width or more
pub fun by_value(w: *Work, way: Way, a: Slice[Value], c: Slice[Value]) Slice[Value] {
    val n:     usize        = a.size;
    val width: u32          = (n * w.word::usize)::u32;
    val f:     Value        = filler(w, way, a);
    val limit: Slice[Value] = words.split(w, word.small(width::u64), n);
    val big:   Value        = arith.compare(w, Compare{code: opcode.GE_U, low: opcode.GE_U, symmetric: false}, c, limit);

    var x:     Slice[Value] = arith.low(w, a, n);
    val shift: u32          = log2(w.word);
    var b:     u32          = 0;
    for ((1::usize << b::usize) < n) {
        val m:    usize        = 1::usize << b::usize;
        val p:    u32          = shift + b;
        val held: Value        = words.and_(w, c.data[(p / w.word)::usize], words.small(w, 1::u64 << (p % w.word)::u64));
        val on:   Value        = words.test(w, opcode.NE, held, words.zero(w));
        val next: Slice[Value] = words.fresh(w, n);
        var i:    usize        = 0;
        for (i < next.size) {
            var moved: Value = f;
            if (sel way.left) {
                if (i >= m) { moved = x.data[i - m]; }
                or          { moved = words.zero(w); }
            }
            or (i + m < n) { moved = x.data[i + m]; }
            next.data[i] = words.pick(w, on, moved, x.data[i]);
            i            = i + 1;
        }
        x = next;
        b = b + 1;
    }

    val s:   Value        = words.and_(w, c.data[0], words.small(w, (w.word - 1)::u64));
    val inv: Value        = words.sub(w, words.small(w, w.word::u64), s);
    val out: Slice[Value] = words.fresh(w, n);
    var i:   usize        = 0;
    for (i < out.size) {
        var value: Value = words.zero(w);
        if (sel way.left) {
            value = words.shift(w, opcode.SHL, x.data[i], s);
            if (i > 0) { value = words.or_(w, value, words.shift(w, opcode.SHR_U, x.data[i - 1], inv)); }
        }
        or {
            value = words.shift(w, opcode.SHR_U, x.data[i], s);
            var above: Value = f;
            if (i + 1 < n) { above = x.data[i + 1]; }
            value = words.or_(w, value, words.shift(w, opcode.SHL, above, inv));
        }
        out.data[i] = words.pick(w, big, f, value);
        i           = i + 1;
    }
    ret out;
}
