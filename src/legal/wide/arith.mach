# the arithmetic of wide integers over their words, one algorithm for every
# width and every word width
#
# a sum carries from each word into the next and a difference borrows, the top
# word's carry or borrow made only where an overflow flag asks for it. a
# product is the sum of the products of every pair of words, each the low and
# the high word of a word product, added in one row of words per word of the
# first operand. a comparison decides on the most significant word and falls
# to the words below it only where those are equal, reading the top word as
# its opcode reads it and every other word as unsigned. the counts count word
# by word and carry the count of the words they pass over, held in as many
# words as the count of the whole width needs.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.fold.word;
use mirl.ir.id.Value;
use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;
use mirl.ir.type.Type;
use mirl.legal.emit;
use mirl.legal.wide.words;
use mirl.legal.wide.words.Flagged;
use mirl.legal.wide.words.Work;

# the sum of two values of as many words, and the carry out of the top word
# where carry is not nil
pub fun sum(w: *Work, a: Slice[Value], b: Slice[Value], carry: *opt[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, a.size);
    var c:   opt[Value]   = opt[Value].none{};
    var i:   usize        = 0;
    for (i < out.size) {
        if (i + 1 == out.size && carry == nil) { out.data[i] = words.plus_carry(w, words.add(w, a.data[i], b.data[i]), c); }
        or {
            val x: Flagged = words.carried(w, a.data[i], b.data[i], c);
            out.data[i] = x.value;
            c           = x.flag;
        }
        i = i + 1;
    }
    if (carry != nil) { @carry = c; }
    ret out;
}

# the difference of two values of as many words, and the borrow out of the top
# word where borrow is not nil
pub fun difference(w: *Work, a: Slice[Value], b: Slice[Value], borrow: *opt[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, a.size);
    var c:   opt[Value]   = opt[Value].none{};
    var i:   usize        = 0;
    for (i < out.size) {
        if (i + 1 == out.size && borrow == nil) {
            var top: Value = words.sub(w, a.data[i], b.data[i]);
            if (sel c.some) { top = words.sub(w, top, words.widen(w, c.some)); }
            out.data[i] = top;
        }
        or {
            val x: Flagged = words.borrowed(w, a.data[i], b.data[i], c);
            out.data[i] = x.value;
            c           = x.flag;
        }
        i = i + 1;
    }
    if (borrow != nil) { @borrow = c; }
    ret out;
}

# the two's complement negation
pub fun negate(w: *Work, a: Slice[Value]) Slice[Value] {
    ret difference(w, words.zeros(w, a.size), a, nil);
}

# a bitwise operation of two operands
# ---
# both:   the and
# either: the or
# differ: the exclusive or
pub tag Logic: u8 {
    both;
    either;
    differ;
}

# a bitwise operation, word by word
pub fun bitwise(w: *Work, how: Logic, a: Slice[Value], b: Slice[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, a.size);
    var i:   usize        = 0;
    for (i < out.size) {
        if (sel how.both)   { out.data[i] = words.and_(w, a.data[i], b.data[i]); }
        or (sel how.either) { out.data[i] = words.or_(w, a.data[i], b.data[i]); }
        or                  { out.data[i] = words.xor_(w, a.data[i], b.data[i]); }
        i = i + 1;
    }
    ret out;
}

# an operation of one operand applied to each word
pub fun each(w: *Work, code: Opcode, a: Slice[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, a.size);
    var i:   usize        = 0;
    for (i < out.size) {
        out.data[i] = emit.unary(?w.site, code, a.data[i]);
        i           = i + 1;
    }
    ret out;
}

# the low columns words of the product of two values of as many words: every
# column for the low half, twice as many for the whole product
pub fun product(w: *Work, a: Slice[Value], b: Slice[Value], columns: usize) Slice[Value] {
    val out: Slice[Value] = words.zeros(w, columns);
    val n:   usize        = a.size;
    var i:   usize        = 0;
    for (i < n && i < out.size) {
        if (!words.is_zero(w, a.data[i])) {
            var carry: Value = words.zero(w);
            var j:     usize = 0;
            var open:  bool  = true;
            for (j < n && open) {
                val k:  usize = i + j;
                val lo: Value = words.mul(w, a.data[i], b.data[j]);
                if (k + 1 == out.size) {
                    out.data[k] = words.add(w, words.add(w, out.data[k], lo), carry);
                    open        = false;
                }
                or {
                    val hi: Value   = words.high(w, a.data[i], b.data[j]);
                    val x:  Flagged = words.plus(w, out.data[k], lo);
                    val y:  Flagged = words.plus(w, x.value, carry);
                    out.data[k] = y.value;
                    carry       = words.plus_carry(w, words.plus_carry(w, hi, x.flag), y.flag);
                }
                j = j + 1;
            }
            if (open && i + n < out.size) { out.data[i + n] = carry; }
        }
        i = i + 1;
    }
    ret out;
}

# how a comparison is made of word comparisons
# ---
# code:      the comparison's own opcode, which decides on the top word
# low:       the unsigned comparison of the same relation, for every word below
# symmetric: the relation holds of equal words alone or of unequal words
#            alone, so it reads whether every word is equal
pub rec Compare {
    code:      Opcode;
    low:       Opcode;
    symmetric: bool;
}

# a comparison of two values of as many words, a condition
pub fun compare(w: *Work, how: Compare, a: Slice[Value], b: Slice[Value]) Value {
    val n: usize = a.size;
    if (how.symmetric) {
        var differ: Value = words.xor_(w, a.data[0], b.data[0]);
        var i:      usize = 1;
        for (i < n) {
            differ = words.or_(w, differ, words.xor_(w, a.data[i], b.data[i]));
            i      = i + 1;
        }
        ret words.test(w, how.code, differ, words.zero(w));
    }
    var at: Value = words.test(w, how.low, a.data[0], b.data[0]);
    var i:  usize = 1;
    for (i < n) {
        var code: Opcode = how.low;
        if (i + 1 == n) { code = how.code; }
        val same: Value = words.test(w, opcode.EQ, a.data[i], b.data[i]);
        at = words.pick(w, same, at, words.test(w, code, a.data[i], b.data[i]));
        i  = i + 1;
    }
    ret at;
}

# then where a condition holds, else otherwise, word by word
pub fun select(w: *Work, c: Value, then: Slice[Value], otherwise: Slice[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, then.size);
    var i:   usize        = 0;
    for (i < out.size) {
        out.data[i] = words.pick(w, c, then.data[i], otherwise.data[i]);
        i           = i + 1;
    }
    ret out;
}

# the words of a value extended to n words, its own words first and every
# word above them zero or the fill of its sign
pub fun extend(w: *Work, a: Slice[Value], n: usize, signed: bool) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, n);
    var pad: Value        = words.zero(w);
    if (signed) { pad = words.fill(w, a.data[a.size - 1]); }
    var i: usize = 0;
    for (i < out.size) {
        if (i < a.size) { out.data[i] = a.data[i]; }
        or              { out.data[i] = pad; }
        i = i + 1;
    }
    ret out;
}

# the words of a value narrower than a word, extended to n words
pub fun extend_narrow(w: *Work, x: Value, width: u32, n: usize, signed: bool) Slice[Value] {
    var low: Value = x;
    if (width != w.word) {
        if (signed) { low = emit.convert(?w.site, opcode.EXT_S, x, w.wty); }
        or          { low = emit.convert(?w.site, opcode.EXT_U, x, w.wty); }
    }
    var one: [1]Value = [1]Value{low};
    ret extend(w, Slice[Value]{data: ?one[0], size: 1}, n, signed);
}

# the low n words of a value
pub fun low(w: *Work, a: Slice[Value], n: usize) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, n);
    var i:   usize        = 0;
    for (i < out.size) {
        out.data[i] = a.data[i];
        i           = i + 1;
    }
    ret out;
}

# a value narrower than a word or a word, from the low word of a wide one
pub fun truncate(w: *Work, a: Slice[Value], to: Type, width: u32) Value {
    if (width == w.word) { ret a.data[0]; }
    ret emit.convert(?w.site, opcode.TRUNC, a.data[0], to);
}

# how many words hold a count of the bits of a width
fun count_words(w: *Work, width: u32) usize {
    var bits: u32 = 1;
    var v:    u32 = width;
    for (v > 1) {
        bits = bits + 1;
        v    = v / 2;
    }
    ret ((bits + w.word - 1) / w.word)::usize;
}

# a count in one word, as a value of k words
fun counted(w: *Work, v: Value, k: usize) Slice[Value] {
    var one: [1]Value = [1]Value{v};
    ret extend(w, Slice[Value]{data: ?one[0], size: 1}, k, false);
}

# a count plus the bits of one word
fun past(w: *Work, acc: Slice[Value]) Slice[Value] {
    ret sum(w, acc, counted(w, words.small(w, w.word::u64), acc.size), nil);
}

# the number of one bits of a value of n words, as n words
pub fun population(w: *Work, a: Slice[Value]) Slice[Value] {
    val k:   usize        = count_words(w, (a.size * w.word::usize)::u32);
    var acc: Slice[Value] = words.zeros(w, k);
    var i:   usize        = 0;
    for (i < a.size) {
        acc = sum(w, acc, counted(w, emit.unary(?w.site, opcode.POPCNT, a.data[i]), k), nil);
        i   = i + 1;
    }
    ret extend(w, acc, a.size, false);
}

# the number of zero bits above the highest one bit of a value of n words, its
# width when it is zero, as n words: the count of each word, past every zero
# word above the lowest
pub fun leading(w: *Work, a: Slice[Value]) Slice[Value] {
    val k:   usize        = count_words(w, (a.size * w.word::usize)::u32);
    var acc: Slice[Value] = counted(w, emit.unary(?w.site, opcode.CLZ, a.data[0]), k);
    var i:   usize        = 1;
    for (i < a.size) {
        val empty: Value = words.none_set(w, a.data[i]);
        acc = select(w, empty, past(w, acc), counted(w, emit.unary(?w.site, opcode.CLZ, a.data[i]), k));
        i   = i + 1;
    }
    ret extend(w, acc, a.size, false);
}

# the number of zero bits below the lowest one bit of a value of n words, its
# width when it is zero, as n words
pub fun trailing(w: *Work, a: Slice[Value]) Slice[Value] {
    val k:   usize        = count_words(w, (a.size * w.word::usize)::u32);
    var acc: Slice[Value] = counted(w, emit.unary(?w.site, opcode.CTZ, a.data[a.size - 1]), k);
    var i:   usize        = a.size - 1;
    for (i > 0) {
        i = i - 1;
        val empty: Value = words.none_set(w, a.data[i]);
        acc = select(w, empty, past(w, acc), counted(w, emit.unary(?w.site, opcode.CTZ, a.data[i]), k));
    }
    ret extend(w, acc, a.size, false);
}

# the bytes of a value of n words in reverse order: its words in reverse
# order, each with its bytes reversed
pub fun swap(w: *Work, a: Slice[Value]) Slice[Value] {
    val out: Slice[Value] = words.fresh(w, a.size);
    var i:   usize        = 0;
    for (i < out.size) {
        out.data[i] = emit.unary(?w.site, opcode.BSWAP, a.data[a.size - 1 - i]);
        i           = i + 1;
    }
    ret out;
}

# whether any word of a value is not zero
pub fun any(w: *Work, a: Slice[Value]) Value {
    var acc: Value = a.data[0];
    var i:   usize = 1;
    for (i < a.size) {
        acc = words.or_(w, acc, a.data[i]);
        i   = i + 1;
    }
    ret words.test(w, opcode.NE, acc, words.zero(w));
}

# whether a sum or difference of values read as signed overflows: its top word
# has the sign the operands' top words do not give it. for a sum the operands
# agree in sign and the result does not, and for a difference they disagree
# and the result has the second's sign
pub fun signed_overflow(w: *Work, a: Value, b: Value, r: Value, difference: bool) Value {
    var mixed: Value = words.and_(w, words.xor_(w, a, r), words.xor_(w, b, r));
    if (difference) { mixed = words.and_(w, words.xor_(w, a, b), words.xor_(w, a, r)); }
    ret words.test(w, opcode.LT_S, mixed, words.zero(w));
}

# the other operand where one read as signed is negative, word by word: the
# amount a product of the two read as unsigned counts in its high half too many
# times
fun taken(w: *Work, negative: Slice[Value], other: Slice[Value]) Slice[Value] {
    val sign: Value        = words.fill(w, negative.data[negative.size - 1]);
    val out:  Slice[Value] = words.fresh(w, other.size);
    var i:    usize        = 0;
    for (i < out.size) {
        out.data[i] = words.and_(w, other.data[i], sign);
        i           = i + 1;
    }
    ret out;
}

# the product of two values of n words, its low n words, and whether the
# whole product does not fit in n words read as signed or unsigned
pub fun checked_product(w: *Work, a: Slice[Value], b: Slice[Value], signed: bool, overflow: *Value) Slice[Value] {
    val n:     usize        = a.size;
    val whole: Slice[Value] = product(w, a, b, n * 2);
    val lo:    Slice[Value] = low(w, whole, n);
    var hi:    Slice[Value] = Slice[Value]{data: ?whole.data[n], size: n};
    if (!signed) {
        @overflow = any(w, hi);
        ret lo;
    }
    hi = difference(w, hi, taken(w, a, b), nil);
    hi = difference(w, hi, taken(w, b, a), nil);
    val sign: Value        = words.fill(w, lo.data[n - 1]);
    val off:  Slice[Value] = words.fresh(w, n);
    var i:    usize        = 0;
    for (i < off.size) {
        off.data[i] = words.xor_(w, hi.data[i], sign);
        i           = i + 1;
    }
    @overflow = any(w, off);
    ret lo;
}
