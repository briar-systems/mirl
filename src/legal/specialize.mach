# specialization constants made their defaults where no consumer sets them
#
# a target that declares its specialization `fold` runs code no consumer
# specializes, so each specialization constant of the module is the default
# it states. the pass makes every one the integer or float constant of its
# default in its own place in the module's table, so every use of it, an
# operand, an edge's argument, an aggregate's element or an initial value,
# reads the default, and it runs ahead of every other pass so each of them
# reads a number. a target that declares `none` holds no specialization
# constant, so the first one is refused, named, before anything changes. the
# decision reads the target's statement alone, never a name. the pass changes
# no code, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.id.Constant;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.pass.analysis;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.target.capability.Specialization;

pub val SPECIALIZE: Pass = Pass{name: "specialize", kind: Kind.legalise{}, scope: Scope.module{run}, preserves: analysis.FLOW, time: Time.keeps{}, applies: unspecialized};

# whether the target states its specialization constants to no consumer
fun unspecialized(g: *Ground) bool {
    val s: Specialization = g.t.caps.specialization;
    ret !(sel s.native);
}

# whether a specialization constant's default is a float
fun floating(c: *Context, s: Spec) res[bool, Why] {
    val shape: res[types.Shape, types.Error] = types.shape(?c.m.types, s.default.type);
    if (sel shape.err) { ret res[bool, Why].err{Why.ir{module.Error.types{shape.err}}}; }
    ret res[bool, Why].ok{sel shape.ok.float};
}

fun run(c: *Context) res[bool, Why] {
    val s: Specialization = c.t.caps.specialization;
    if (sel s.native) { ret res[bool, Why].ok{false}; }
    var found: bool  = false;
    var i:     usize = 0;
    for (i < c.m.constants.len) {
        val d: ConstantData = c.m.constants.data[i];
        if (sel d.spec) {
            if (!(sel s.fold)) { ret res[bool, Why].err{Why.specialized{Constant{index: i::u32}}}; }
            val f: res[bool, Why] = floating(c, d.spec);
            if (sel f.err) { ret res[bool, Why].err{f.err}; }
            found = true;
        }
        i = i + 1;
    }
    if (!found) { ret res[bool, Why].ok{false}; }
    i = 0;
    for (i < c.m.constants.len) {
        val d: ConstantData = c.m.constants.data[i];
        if (sel d.spec) {
            val f:     res[bool, Why] = floating(c, d.spec);
            var real:  bool           = false;
            if (sel f.ok) { real = f.ok; }
            if (real) { c.m.constants.data[i] = ConstantData.float{d.spec.default}; }
            or        { c.m.constants.data[i] = ConstantData.integer{d.spec.default}; }
        }
        i = i + 1;
    }
    ret res[bool, Why].ok{true};
}
