# specialization constants made their defaults where no consumer sets them
#
# a target that declares its specialization `fold` runs code no consumer
# specializes, so each specialization constant of the module is the default
# it states. the pass makes every one the integer or float constant of its
# default in its own place in the module's table, so every use of it, an
# operand, an edge's argument, an aggregate's element or an initial value,
# reads the default, and it runs ahead of every other pass so each of them
# reads a number. a target that declares `none` holds no specialization
# constant, so the first one is refused, named, before anything changes. the
# decision reads the target's statement alone, never a name. the pass changes
# no code, so it keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;

use std.collections.vector;

use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.ir.type.table;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;
use mirl.pass.analysis;
use mirl.pass.record.Changed;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.changed;
use mirl.pass.refusal;
use mirl.target.capability.Specialization;

pub val SPECIALIZE: Pass = Pass{name: "specialize", kind: Kind.legalise{}, scope: Scope.module{run}, preserves: analysis.FLOW, time: Time.keeps{}, applies: unspecialized};

# whether the target states its specialization constants to no consumer
fun unspecialized(g: *Ground) bool {
    val s: Specialization = g.t.caps.specialization;
    ret !(sel s.native);
}

# whether a specialization constant's default is a float
fun floating(c: *Context, s: Spec) res[bool, refusal.Error] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?c.m.types, s.default.type);
    if (sel res_shape.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    ret res[bool, refusal.Error].ok{sel res_shape.ok.float};
}

# make every specialization constant of the module its default, refusing the
# first one where the target holds none, marking in `marks` every function that
# read one, and answer whether any was
fun run(c: *Context, marks: *Changed) res[bool, refusal.Error] {
    val s: Specialization = c.t.caps.specialization;
    if (sel s.native) { ret res[bool, refusal.Error].ok{false}; }
    var found: bool  = false;
    var i:     usize = 0;
    for (i < c.m.constants.len) {
        val d: ConstantData = c.m.constants.data[i];
        if (sel d.spec) {
            if (!(sel s.fold)) { ret res[bool, refusal.Error].err{refusal.Error.specialized{(i::u32)}}; }
            val res_floating: res[bool, refusal.Error] = floating(c, d.spec);
            if (sel res_floating.err) { ret res[bool, refusal.Error].err{res_floating.err}; }
            found = true;
        }
        i = i + 1;
    }
    if (!found) { ret res[bool, refusal.Error].ok{false}; }
    readers(c.m, marks);
    i = 0;
    for (i < c.m.constants.len) {
        val d: ConstantData = c.m.constants.data[i];
        if (sel d.spec) {
            val res_floating: res[bool, refusal.Error] = floating(c, d.spec);
            var real:         bool                     = false;
            if (sel res_floating.ok) { real = res_floating.ok; }
            if (real)                { c.m.constants.data[i] = ConstantData.float{d.spec.default}; }
            or                       { c.m.constants.data[i] = ConstantData.integer{d.spec.default}; }
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{true};
}

# mark every function whose body reads a specialization constant, each of which reads a default from now on
fun readers(m: *module.Module, marks: *Changed) {
    var f: usize = 0;
    for (f < m.functions.len) {
        val values: *vector.Vector[ValueData] = ?m.functions.data[f].body.values;
        var v:      usize                     = 0;
        for (v < values.len) {
            val d: Def = values.data[v].def;
            if (sel d.constant) {
                val k: ConstantData = m.constants.data[d.constant];
                if (sel k.spec) {
                    changed(marks, f::Function);
                    brk;
                }
            }
            v = v + 1;
        }
        f = f + 1;
    }
}
