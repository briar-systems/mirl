# tests of widening narrow arithmetic: every integer opcode against the folder
# at the boundary values, the traps at the narrow width, and the operations on
# single bits

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use diag: std.print;

use folder: mirl.fold;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Trap;
use mirl.ir.opcode.Traps;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.legal.check_test.CAPACITY;
use mirl.legal.check_test.Text;
use mirl.legal.check_test.number;
use mirl.legal.check_test.put;
use mirl.legal.narrow;
use mirl.legal.narrow.NARROW;
use mirl.opt.fold.FOLD;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.record;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine.Machine;

# an operand: a constant of the width
#[testing]
fun constant(t: *Text, width: u32, v: u64) {
    put(t, "i");
    number(t, width::u64);
    put(t, " ");
    number(t, v);
}

#[testing]
fun header(t: *Text, target: str) {
    put(t, "target \"");
    put(t, target);
    put(t, "\"\nfunction @f: fun(ptr) -> () {\n^entry(%p: ptr):\n");
}

# the target the pass applies to, by what it declares
#[testing]
fun narrow_target(t: *Target) bool {
    ret record.applies(?NARROW, t);
}

# a target the pass applies to that selects no operation on single bits as it
# stands, so it widens every one
#[testing]
fun bits_target(t: *Target) bool {
    ret record.applies(?NARROW, t) && sel t.caps.arithmetic.single.none;
}

# the boundary values of a width: the ends, the neighbours of the sign bit, and
# the counts around the width, each kept to the width
#[testing]
fun boundary(width: u32, at: usize) u64 {
    val top: u64 = 1::u64 << (width - 1)::u64;
    val all: u64 = (top << 1) - 1;
    var v:   u64 = all;
    if (at == 0) { v = 0; }
    if (at == 1) { v = 1; }
    if (at == 2) { v = 2; }
    if (at == 3) { v = (width - 1)::u64; }
    if (at == 4) { v = width::u64; }
    if (at == 5) { v = (width + 1)::u64; }
    if (at == 6) { v = top - 1; }
    if (at == 7) { v = top; }
    if (at == 8) { v = all - 1; }
    ret v & all;
}

#[testing]
val BOUNDARIES: usize = 10;

# whether the row traps for these operands at the width
#[testing]
fun traps(row: *Row, width: u32, a: u64, b: u64) bool {
    val top: u64   = 1::u64 << (width - 1)::u64;
    val all: u64   = (top << 1) - 1;
    var n:   usize = 0;
    for (n < $length_of(Traps)) {
        val t: Trap = row.effects.traps[n];
        if (sel t.zero) {
            var x: u64 = b;
            if (t.zero == 0) { x = a; }
            if (x == 0)      { ret true; }
        }
        if (sel t.overflow) {
            if (a == top && b == all) { ret true; }
        }
        n = n + 1;
    }
    ret false;
}

# one operation at one width on every boundary value, each result stored, and
# a result narrower than a byte stored extended to one
#[testing]
fun write(t: *Text, target: str, code: Opcode, row: *Row, width: u32) {
    header(t, target);
    val binary: bool  = opcode.fixed(row) == 2;
    val masked: bool  = sel row.results[0].mask || width < 8;
    var j:      u64   = 0;
    var x:      usize = 0;
    for (x < BOUNDARIES) {
        var y: usize = 0;
        for (y < BOUNDARIES) {
            if (binary || y == 0) {
                val a: u64 = boundary(width, x);
                val b: u64 = boundary(width, y);
                if (!(binary && traps(row, width, a, b))) {
                    put(t, "    %r");
                    number(t, j);
                    put(t, " = ");
                    put(t, row.name);
                    put(t, " ");
                    constant(t, width, a);
                    if (binary) {
                        put(t, ", ");
                        constant(t, width, b);
                    }
                    put(t, "\n");
                    var stored: u32 = width;
                    if (masked) {
                        put(t, "    %e");
                        number(t, j);
                        put(t, " = ext.u %r");
                        number(t, j);
                        put(t, ", to i8\n");
                        stored = 8;
                    }
                    put(t, "    store %p, %");
                    if (masked) { put(t, "e"); }
                    or          { put(t, "r"); }
                    number(t, j);
                    put(t, ", align ");
                    number(t, (stored / 8)::u64);
                    put(t, "\n");
                    j = j + 1;
                }
            }
            y = y + 1;
        }
        x = x + 1;
    }
    put(t, "    ret\n}\n");
}

# parse a text, none when it does not parse
#[testing]
fun read(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    ret parse_body(a, text);
}

# the folder's answer for the text beside the answer after widening and folding
#[testing]
fun agree(a: *allocator.Allocator, row: *Target, text: View) u32 {
    var first: res[Module, Refusal] = read(a, text);
    if (sel first.err) { ret 1; }
    var want: Module = first.ok;
    fin { module.dnit(?want); }
    var second: res[Module, Refusal] = read(a, text);
    if (sel second.err) { ret 2; }
    var got: Module = second.ok;
    fin { module.dnit(?got); }

    val started: res[Driver, Error] = driver.init(?want, row, opt[*Machine].none{}, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val folded: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel folded.err) { ret 3; }
    if (!folded.ok)     { ret 3; }

    val started_e: res[Driver, Error] = driver.init(?got, row, opt[*Machine].none{}, Options{level: 1, checked: true});
    if (sel started_e.err) { ret 90; }
    var e: Driver = started_e.ok;
    fin { driver.dnit(?e); }
    val widened: res[bool, Error] = driver.apply(?e, ?NARROW);
    if (sel widened.err) { ret 4; }
    if (!widened.ok)     { ret 4; }
    val again: res[bool, Error] = driver.apply(?e, ?FOLD);
    if (sel again.err) { ret 5; }

    val same: res[bool, printer.Error] = equal.same(?want, ?got);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    ret 0;
}

# whether the opcode is one the pass leaves
#[testing]
fun left(code: Opcode) bool {
    var i: usize = 0;
    for (i < $length_of(narrow.LEFT)) {
        if (narrow.LEFT[i].opcode.index == code.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the folder evaluates the opcode as integer arithmetic
#[testing]
fun integer(code: Opcode) bool {
    val e: folder.Entry = folder.entry(code);
    ret sel e.unary || sel e.binary || sel e.shift || sel e.overflow || sel e.compare;
}

# one opcode at one width on a target, widened and folded, against the folder
#[testing]
fun sweep(a: *allocator.Allocator, row: *Target, code: Opcode, r: *Row, width: u32) bool {
    var text: Text;
    write(?text, row.name, code, r, width);
    if (text.len >= CAPACITY) { ret false; }
    val c: u32 = agree(a, row, View{data: ?text.data[0], len: text.len});
    if (c != 0) {
        diag.eprintlnf("{} at {}: step {}", r.name, width, c);
        ret false;
    }
    ret true;
}

# every integer opcode, at 8 and 16 bits and at one bit on a target that
# selects no operation on single bits, widens to what the folder gives at every
# boundary value, or is one the pass declares it leaves
test narrow__every_integer_opcode_gives_what_the_folder_gives {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(narrow_target);
    if (sel row.none) { ret 1; }
    val bits: opt[*Target] = targets.first(bits_target);
    if (sel bits.none) { ret 1; }
    var op: u32 = 0;
    for (op < opcode.rows()) {
        val code: Opcode = Opcode{index: op};
        if (integer(code)) {
            val got: opt[Row] = opcode.row(code);
            if (sel got.none) { ret 2; }
            var r: Row = got.some;
            if (narrow.widens(code) == left(code)) {
                diag.eprintlnf("{} is both widened and left, or neither", r.name);
                ret 3;
            }
            if (narrow.widens(code)) {
                var width: u32 = 8;
                for (width <= 16) {
                    if (!sweep(?a, row.some, code, ?r, width)) { ret 4; }
                    width = width * 2;
                }
                if (!sweep(?a, bits.some, code, ?r, 1)) { ret 5; }
            }
        }
        op = op + 1;
    }
    ret 0;
}

# the traps at the narrow width: the least value divided by minus one and a
# division by zero are the wide division's traps, so neither folds away
test narrow__a_narrow_division_traps_where_the_narrow_one_does {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(narrow_target);
    if (sel row.none) { ret 1; }
    val before: str                  = "target \"riscv64-linux\"\nfunction @f: fun(ptr) -> () {\n^entry(%p: ptr):\n    %q = div.s i8 128, i8 255\n    store %p, %q, align 1\n    %r = rem.s i8 128, i8 255\n    store %p, %r, align 1\n    %z = div.u i8 5, i8 0\n    store %p, %z, align 1\n    ret\n}\n";
    val after:  str                  = "target \"riscv64-linux\"\nfunction @f: fun(ptr) -> () {\n^entry(%p: ptr):\n    %w = div.s i32 2147483648, i32 4294967295\n    %q = trunc %w, to i8\n    store %p, %q, align 1\n    %v = rem.s i32 2147483648, i32 4294967295\n    %r = trunc %v, to i8\n    store %p, %r, align 1\n    %y = div.u i32 5, i32 0\n    %z = trunc %y, to i8\n    store %p, %z, align 1\n    ret\n}\n";
    var first:  res[Module, Refusal] = read(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 2; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = read(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 3; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, row.some, opt[*Machine].none{}, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val widened: res[bool, Error] = driver.apply(?d, ?NARROW);
    if (sel widened.err) { ret 4; }
    if (!widened.ok)     { ret 4; }
    val folded: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel folded.err) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 6; }
    ret 0;
}

# on single bits: a shift right fills from bit 0 and a sum carries out of it,
# both widened and truncated back to the bit their readers take, while the
# condition the select reads stays as it is beside its extended copies and the
# and the target selects on single bits is left
test narrow__an_operation_on_single_bits_is_widened_unless_the_target_selects_it {
    var a: allocator.Allocator;
    page.make(?a);
    val before: str                  = "target \"riscv64-linux\"\nfunction @f: fun(i1, i1) -> (i1) {\n^entry(%x: i1, %y: i1):\n    %s = shr.s %x, %y\n    %a = add %x, %y\n    %k = and %x, %y\n    %c = select %x, %s, %k\n    cbr %a, ^t, ^e\n^t:\n    ret %c\n^e:\n    ret %k\n}\n";
    val after:  str                  = "target \"riscv64-linux\"\nfunction @f: fun(i1, i1) -> (i1) {\n^entry(%x: i1, %y: i1):\n    %xs = ext.s %x, to i32\n    %yu = ext.u %y, to i32\n    %ws = shr.s %xs, %yu\n    %s = trunc %ws, to i1\n    %xa = ext.s %x, to i32\n    %ya = ext.s %y, to i32\n    %wa = add %xa, %ya\n    %a = trunc %wa, to i1\n    %k = and %x, %y\n    %c = select %x, %s, %k\n    cbr %a, ^t, ^e\n^t:\n    ret %c\n^e:\n    ret %k\n}\n";
    var first:  res[Module, Refusal] = read(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 1; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = read(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 2; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?m, ?targets.RV64_LINUX, opt[*Machine].none{}, Options{level: 0, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val widened: res[bool, Error] = driver.apply(?d, ?NARROW);
    if (sel widened.err) { ret 3; }
    if (!widened.ok)     { ret 3; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 4; }
    if (!same.ok)     { ret 4; }
    ret 0;
}
