# aggregate values taken apart into the scalars they hold, so selection never
# meets one
#
# a structure, an array or a union held as a value is its leaves: each scalar
# member at its byte offset, through every structure and array it is nested
# in, and a union's bytes as integers of the widest word its alignment allows,
# since its members overlap. a leaf is an integer, a float, a pointer or a
# vector, each a value of its own from then on.
#
# - a load is a load of each leaf at its offset, and a store a store of each,
#   with the access's flags on every one.
# - `extract` is the member's leaves, the one value of a scalar member, and
#   `insert` the aggregate's leaves with the member's replaced. a select is a
#   select of each leaf on its condition, and a block parameter one parameter
#   per leaf, every edge passing the leaves of its argument.
# - a constant's leaves are its members' constants, a run of bytes' each byte,
#   and zero a zero of each.
# - a store of a load whose only use it is, with nothing that writes memory
#   between them in their block, moves the bytes from memory to memory, and a
#   store of zero fills them. either is made of the widest words each address's
#   alignment allows up to the target's bound of moves, and past it is one
#   `mem.copy` or `mem.fill` (mirl.legal.moves). volatile and kept accesses
#   keep their leaves.
# - a `mem.copy` or `mem.fill` the front end made, of a constant length and,
#   for a fill, a constant byte, is made of the same word moves where the
#   bound admits them, and stays whole past it. a volatile or kept one stays
#   whole. so a small aggregate copied through memory is never a block move.
#
# the pass runs twice in a register family's schedule. first ahead of the
# helpers, so the bulk operations it makes are classified as any other: native,
# or a call of a helper. a value the abi legalisation places, at the entry, a
# call or a return, is left whole for it: a store of one stays whole, any other
# read of a parameter or a call's result reads its leaves from a stack slot it
# is stored to, and an argument or a returned value built of leaves is stored
# leaf by leaf to a slot and loaded whole for the call or return to read. it runs again after the abi
# legalisation, which reads and writes the aggregates it places through memory
# with loads and stores the second run takes apart. there a bulk operation is
# made only where the target's is native, since the helpers have run, and a
# leaf of a format the build holds no unit for moves as its encoding,
# reinterpreted, since the half precision legalisation has run too.
#
# a record that reads an aggregate value the pass takes out reads each leaf as
# a piece of the variable at the leaf's bits, so a variable bound to an
# aggregate stays available through the split.
#
# nothing made branches or reads a value to decide, so the pass keeps constant
# time, and every leaf of a secret value is secret.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;
use std.collections.vector.Vector;

use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.contents;
use ir_constant: mirl.ir.constant;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use Spot: mirl.ir.instruction.Place;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.point;
use mirl.ir.point.Bits;
use mirl.ir.point.Operand;
use mirl.ir.point.Part;
use mirl.ir.point.Reads;
use mirl.ir.point.Step;
use mirl.ir.pool.Growing;
use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.legal.moves;
use mirl.pass.analysis;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Held;
use mirl.target.layout;
use mirl.target.layout.Layout;
use target_record: mirl.target.record;

# the passes: each adds instructions and block parameters, removes what it
# takes apart and never touches an edge's target or a block. the first runs
# ahead of the helpers and the second after the abi legalisation
pub val AGGREGATES:        Pass = Pass{name: "aggregates", kind: Kind.legalise{}, scope: Scope.function{ahead}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};
pub val PLACED_AGGREGATES: Pass = Pass{name: "placed aggregates", kind: Kind.legalise{}, scope: Scope.function{after}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

# the most leaves one aggregate value is taken apart into
val MOST: usize = 1024;

val LARGE:     str = "an aggregate value of more scalars than the pass takes apart, which belongs in memory";
val UNSIZED:   str = "an aggregate value whose type has no layout on the target";
val WHOLE:     str = "an instruction that reads or gives an aggregate value whole, which no rule takes apart";
val UNION:     str = "a union constant other than zero, whose members overlap";
val UNMATCHED: str = "an aggregate constant whose elements do not match its type";

val UNTOUCHED: u32 = 0xffffffff;

# leaves are addressed through memory that can be reinterpreted
fun wanted(g: *Ground) bool {
    ret sel g.t.caps.addressing.physical;
}

# one scalar an aggregate holds
# ---
# offset: its byte offset in the aggregate
# ty:     its type
# bits:   the bits a record's piece of it covers
rec Leaf {
    offset: u64;
    ty:     Type;
    bits:   u32;
}

# the leaves of a type, a run of the work's leaves
# ---
# ty:    the type
# start: where its run starts
# count: how many leaves it has
rec Shaped {
    ty:    Type;
    start: usize;
    count: usize;
}

# the run of a member's leaves within its aggregate's
# ---
# start: the first, counted from the aggregate's first
# count: how many
rec Run {
    start: usize;
    count: usize;
}

# one function being taken apart
# ---
# site:   where instructions are made
# layout: the target's data layout
# caps:   the target's capabilities
# word:   the widest access in bytes, the target's widest arithmetic
# late:   the run after the abi legalisation, so after the helpers
# basis:  the build's selection
# keep:   storage that lives until the visit ends
# leaves: the leaves of every type shaped so far
# shapes: the types shaped so far
# held:   the leaves of each value taken apart, by its index
# state:  by value index, 1 once its leaves are held
# gone:   instructions to take out once nothing else reads them
# params: block parameters taken apart, taken out at the end
# before: each block's parameter count before its own were taken apart,
#         UNTOUCHED for one whose were not
# head:   instructions made at the head of the entry block so far
# ptr:    the pointer type of a stack slot
# failed: the first failure
rec Work {
    site:   Site;
    layout: Layout;
    caps:   *Capabilities;
    word:   u64;
    late:   bool;
    basis:  opt[*Basis];
    keep:   *allocator.Allocator;
    leaves: Vector[Leaf];
    shapes: Vector[Shaped];
    held:   Vector[Slice[Value]];
    state:  Vector[u8];
    gone:   Vector[Instruction];
    params: Vector[Value];
    before: Vector[u32];
    head:   u32;
    ptr:    Type;
    failed: opt[refusal.Error];
}

fun lost(e: allocator.Error) refusal.Error {
    ret refusal.Error.alloc{e};
}

fun fail(w: *Work, why: refusal.Error) {
    val first: bool = sel w.failed.none;
    if (first) { w.failed = opt[refusal.Error].some{why}; }
}

fun failure_of(w: *Work) err[refusal.Error] {
    if (sel w.failed.some) { ret err[refusal.Error].err{w.failed.some}; }
    ret err[refusal.Error].ok{};
}

fun body_of(w: *Work) *Body {
    ret w.site.b;
}

fun type_of(w: *Work, x: Value) Type {
    ret w.site.b.values.data[x].type;
}

fun shape_of(w: *Work, ty: Type) res[table.Shape, refusal.Error] {
    val s: res[table.Shape, table.Error] = table.shape(?w.site.m.types, ty);
    if (sel s.err) { ret res[table.Shape, refusal.Error].err{refusal.Error.ir{module.Error.types{s.err}}}; }
    ret res[table.Shape, refusal.Error].ok{s.ok};
}

# whether a type is held in memory rather than as one scalar
fun aggregate(w: *Work, ty: Type) bool {
    val s: res[*table.Shape, table.Error] = table.shape_at(?w.site.m.types, ty);
    if (sel s.err) { ret false; }
    ret sel s.ok.structure || sel s.ok.array || sel s.ok.union;
}

fun size_of(w: *Work, ty: Type) res[u64, refusal.Error] {
    val s: res[u64, target_record.Error] = layout.size(?w.layout, ty, table.DEFAULT_SPACE);
    if (sel s.err) { ret res[u64, refusal.Error].err{refusal.Error.reason{UNSIZED}}; }
    ret res[u64, refusal.Error].ok{s.ok};
}

fun align_of(w: *Work, ty: Type) res[u64, refusal.Error] {
    val s: res[u64, target_record.Error] = layout.align(?w.layout, ty, table.DEFAULT_SPACE);
    if (sel s.err) { ret res[u64, refusal.Error].err{refusal.Error.reason{UNSIZED}}; }
    ret res[u64, refusal.Error].ok{s.ok};
}

fun integer(w: *Work, bits: u32) res[Type, refusal.Error] {
    val t: res[Type, table.Error] = table.intern(?w.site.m.types, table.Shape.integer{table.Integer{width: bits}});
    if (sel t.err) { ret res[Type, refusal.Error].err{refusal.Error.ir{module.Error.types{t.err}}}; }
    ret res[Type, refusal.Error].ok{t.ok};
}

fun push_leaf(w: *Work, start: usize, l: Leaf) err[refusal.Error] {
    if (w.leaves.len - start >= MOST) { ret err[refusal.Error].err{refusal.Error.reason{LARGE}}; }
    val pushed: res[usize, allocator.Error] = vector.push[Leaf](?w.leaves, l);
    if (sel pushed.err) { ret err[refusal.Error].err{lost(pushed.err)}; }
    ret err[refusal.Error].ok{};
}

# the leaves of a type at a byte offset, pushed in member order
fun collect(w: *Work, start: usize, ty: Type, base: u64) err[refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    val shape: table.Shape = s.ok;
    if (sel shape.structure) {
        var i: usize = 0;
        for (i < shape.structure.members.size) {
            val at: res[u64, target_record.Error] = layout.offset(?w.layout, ty, table.DEFAULT_SPACE, i::u32);
            if (sel at.err) { ret err[refusal.Error].err{refusal.Error.reason{UNSIZED}}; }
            val inner: err[refusal.Error] = collect(w, start, shape.structure.members.data[i], base + at.ok);
            if (sel inner.err) { ret inner; }
            i = i + 1;
        }
        ret err[refusal.Error].ok{};
    }
    if (sel shape.array) {
        val step: res[u64, target_record.Error] = layout.stride(?w.layout, ty, table.DEFAULT_SPACE);
        if (sel step.err) { ret err[refusal.Error].err{refusal.Error.reason{UNSIZED}}; }
        var e: u64 = 0;
        for (e < shape.array.count) {
            val inner: err[refusal.Error] = collect(w, start, shape.array.element, base + e * step.ok);
            if (sel inner.err) { ret inner; }
            e = e + 1;
        }
        ret err[refusal.Error].ok{};
    }
    val size: res[u64, refusal.Error] = size_of(w, ty);
    if (sel size.err) { ret err[refusal.Error].err{size.err}; }
    if (sel shape.union) {
        val align: res[u64, refusal.Error] = align_of(w, ty);
        if (sel align.err) { ret err[refusal.Error].err{align.err}; }
        var done: u64 = 0;
        for (done < size.ok) {
            val n:     u64                      = moves.step(size.ok - done, moves.aligned_at(align.ok, done), w.word);
            val chunk: res[Type, refusal.Error] = integer(w, (n * 8)::u32);
            if (sel chunk.err) { ret err[refusal.Error].err{chunk.err}; }
            val pushed: err[refusal.Error] = push_leaf(w, start, Leaf{offset: base + done, ty: chunk.ok, bits: (n * 8)::u32});
            if (sel pushed.err) { ret pushed; }
            done = done + n;
        }
        ret err[refusal.Error].ok{};
    }
    var bits: u32 = (size.ok * 8)::u32;
    if (sel shape.integer) { bits = shape.integer.width; }
    if (sel shape.float) {
        val row: opt[format.Row] = format.row(shape.float.format);
        if (sel row.some) { bits = row.some.width; }
    }
    if (sel shape.function) { ret err[refusal.Error].err{refusal.Error.reason{WHOLE}}; }
    ret push_leaf(w, start, Leaf{offset: base, ty: ty, bits: bits});
}

# the leaves of a type, shaped once
fun shaped(w: *Work, ty: Type) res[Shaped, refusal.Error] {
    var i: usize = 0;
    for (i < w.shapes.len) {
        if (table.same(w.shapes.data[i].ty, ty)) { ret res[Shaped, refusal.Error].ok{w.shapes.data[i]}; }
        i = i + 1;
    }
    val start: usize              = w.leaves.len;
    val made:  err[refusal.Error] = collect(w, start, ty, 0);
    if (sel made.err) { ret res[Shaped, refusal.Error].err{made.err}; }
    val s:      Shaped                      = Shaped{ty: ty, start: start, count: w.leaves.len - start};
    val pushed: res[usize, allocator.Error] = vector.push[Shaped](?w.shapes, s);
    if (sel pushed.err) { ret res[Shaped, refusal.Error].err{lost(pushed.err)}; }
    ret res[Shaped, refusal.Error].ok{s};
}

fun leaf(w: *Work, s: Shaped, k: usize) Leaf {
    ret w.leaves.data[s.start + k];
}

# the run of member i's leaves within an aggregate's, and the member's type
fun member_run(w: *Work, ty: Type, i: u32, member: *Type) res[Run, refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[Run, refusal.Error].err{s.err}; }
    val shape: table.Shape = s.ok;
    if (sel shape.structure) {
        if (i::usize >= shape.structure.members.size) { ret res[Run, refusal.Error].err{refusal.Error.reason{WHOLE}}; }
        var start: usize = 0;
        var j:     usize = 0;
        for (j < i::usize) {
            val m: res[Shaped, refusal.Error] = shaped(w, shape.structure.members.data[j]);
            if (sel m.err) { ret res[Run, refusal.Error].err{m.err}; }
            start = start + m.ok.count;
            j     = j + 1;
        }
        member[0] = shape.structure.members.data[i];
        val own: res[Shaped, refusal.Error] = shaped(w, member[0]);
        if (sel own.err) { ret res[Run, refusal.Error].err{own.err}; }
        ret res[Run, refusal.Error].ok{Run{start: start, count: own.ok.count}};
    }
    if (sel shape.array) {
        if (i::u64 >= shape.array.count) { ret res[Run, refusal.Error].err{refusal.Error.reason{WHOLE}}; }
        member[0] = shape.array.element;
        val own: res[Shaped, refusal.Error] = shaped(w, member[0]);
        if (sel own.err) { ret res[Run, refusal.Error].err{own.err}; }
        ret res[Run, refusal.Error].ok{Run{start: i::usize * own.ok.count, count: own.ok.count}};
    }
    ret res[Run, refusal.Error].err{refusal.Error.reason{WHOLE}};
}

# room for n values that live until the visit ends
fun fresh(w: *Work, n: usize) Slice[Value] {
    if (n == 0) { ret Slice[Value]{data: nil, size: 0}; }
    val got: res[*Value, allocator.Error] = allocator.zallocate[Value](w.keep, n);
    if (sel got.err) {
        fail(w, lost(got.err));
        ret Slice[Value]{data: nil, size: 0};
    }
    ret Slice[Value]{data: got.ok, size: n};
}

fun hold(w: *Work, x: Value, leaves: Slice[Value]) {
    for (w.held.len <= x::usize) {
        val a: res[usize, allocator.Error] = vector.push[Slice[Value]](?w.held, Slice[Value]{data: nil, size: 0});
        val b: res[usize, allocator.Error] = vector.push[u8](?w.state, 0);
        if (sel a.err) {
            fail(w, lost(a.err));
            ret;
        }
        if (sel b.err) {
            fail(w, lost(b.err));
            ret;
        }
    }
    w.held.data[x]  = leaves;
    w.state.data[x] = 1;
}

fun holding(w: *Work, x: Value) bool {
    ret x::usize < w.state.len && w.state.data[x] == 1;
}

fun block_of(b: *Body, i: Instruction) Block {
    val at: Spot = b.instructions.data[i].place;
    if (sel at.placed) { ret at.placed; }
    ret 0;
}

fun position(b: *Body, k: Block, i: Instruction) u32 {
    val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    var p:    usize                       = 0;
    for (p < list.len && list.data[p] != i) { p = p + 1; }
    ret p::u32;
}

# the alignment an access states
fun alignment_of(d: *InstructionData) u64 {
    var i: usize = 0;
    for (i < d.immediates.len) {
        val m: Immediate = d.immediates.data[i];
        if (sel m.alignment) { ret m.alignment; }
        i = i + 1;
    }
    ret 1;
}

fun access_flags(f: Flags) Flags {
    ret Flags{volatile: f.volatile, kept: f.kept, bounded: false};
}

# the flags of a piece of a read, which reads what the read it stands for does
fun read_flags(f: Flags) Flags {
    var r: Flags = access_flags(f);
    r.public = f.public;
    ret r;
}

# the address a byte offset past another
fun at_offset(w: *Work, address: Value, offset: u64) Value {
    if (offset == 0) { ret address; }
    val bytes: res[u64, refusal.Error] = size_of(w, type_of(w, address));
    if (sel bytes.err) {
        fail(w, bytes.err);
        ret address;
    }
    val ty: res[Type, refusal.Error] = integer(w, (bytes.ok * 8)::u32);
    if (sel ty.err) {
        fail(w, ty.err);
        ret address;
    }
    val by: res[Value, refusal.Error] = emit.constant(?w.site, ty.ok, word.small(offset));
    if (sel by.err) {
        fail(w, by.err);
        ret address;
    }
    ret emit.binary(?w.site, opcode_table.PTR_ADD, address, by.ok);
}

fun load_at(w: *Work, address: Value, ty: Type, align: u64, f: Flags) Value {
    var ops: [1]Value     = [1]Value{address};
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{ty}, Immediate.alignment{align}};
    emit.flags(?w.site, read_flags(f));
    val i: Instruction = emit.make(?w.site, opcode_table.LOAD, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 2});
    emit.flags(?w.site, NO_FLAGS);
    ret emit.result(?w.site, i, 0);
}

fun store_at(w: *Work, address: Value, x: Value, align: u64, f: Flags) {
    var ops: [2]Value     = [2]Value{address, x};
    var imm: [1]Immediate = [1]Immediate{Immediate.alignment{align}};
    emit.flags(?w.site, access_flags(f));
    emit.make(?w.site, opcode_table.STORE, Slice[Value]{data: ?ops[0], size: 2}, Slice[Immediate]{data: ?imm[0], size: 1});
    emit.flags(?w.site, NO_FLAGS);
}

# the integer a leaf moves in memory as, where this is the run after the half
# precision legalisation and the leaf a float of a format the build holds no
# unit for, whose encoding that pass made every other access of the format
fun encoding_of(w: *Work, ty: Type) opt[Type] {
    if (!w.late) { ret opt[Type].none{}; }
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) {
        fail(w, s.err);
        ret opt[Type].none{};
    }
    if (!(sel s.ok.float)) { ret opt[Type].none{}; }
    val h: res[opt[*Held], basis.Error] = basis.held(w.basis, w.caps, s.ok.float.format);
    if (sel h.err) {
        fail(w, refusal.Error.condition{h.err});
        ret opt[Type].none{};
    }
    if (sel h.ok.some) { ret opt[Type].none{}; }
    val size: res[u64, refusal.Error] = size_of(w, ty);
    if (sel size.err) {
        fail(w, size.err);
        ret opt[Type].none{};
    }
    val bits: res[Type, refusal.Error] = integer(w, (size.ok * 8)::u32);
    if (sel bits.err) {
        fail(w, bits.err);
        ret opt[Type].none{};
    }
    ret opt[Type].some{bits.ok};
}

fun load_leaf(w: *Work, address: Value, ty: Type, align: u64, f: Flags) Value {
    val bits: opt[Type] = encoding_of(w, ty);
    if (sel bits.none) { ret load_at(w, address, ty, align, f); }
    ret emit.convert(?w.site, opcode_table.BITCAST, load_at(w, address, bits.some, align, f), ty);
}

# a leaf as the value a store of it writes
fun as_stored(w: *Work, x: Value) Value {
    val bits: opt[Type] = encoding_of(w, type_of(w, x));
    if (sel bits.none) { ret x; }
    ret emit.convert(?w.site, opcode_table.BITCAST, x, bits.some);
}

# the length of a bulk operation, an integer as wide as the address's pointer
fun length_of(w: *Work, address: Value, n: u64) Value {
    val bytes: res[u64, refusal.Error] = size_of(w, type_of(w, address));
    if (sel bytes.err) {
        fail(w, bytes.err);
        ret address;
    }
    val ty: res[Type, refusal.Error] = integer(w, (bytes.ok * 8)::u32);
    if (sel ty.err) {
        fail(w, ty.err);
        ret address;
    }
    val got: res[Value, refusal.Error] = emit.constant(?w.site, ty.ok, word.small(n));
    if (sel got.err) {
        fail(w, got.err);
        ret address;
    }
    ret got.ok;
}

# a value of a constant
fun constant_value(w: *Work, c: ConstantData) Value {
    val made: res[Constant, module.Error] = module.add_constant(w.site.m, c);
    if (sel made.err) {
        fail(w, refusal.Error.ir{made.err});
        ret 0;
    }
    val at: res[Value, module.Error] = body.constant(w.site.m, w.site.f, made.ok);
    if (sel at.err) {
        fail(w, refusal.Error.ir{at.err});
        ret 0;
    }
    ret at.ok;
}

# a stack slot of a type at the head of the entry block
fun slot(w: *Work, ty: Type) Value {
    val align: res[u64, refusal.Error] = align_of(w, ty);
    if (sel align.err) {
        fail(w, align.err);
        ret 0;
    }
    val b:     *Body       = body_of(w);
    val entry: Block       = 0;
    val first: Instruction = b.blocks.data[0].instructions.data[0];
    emit.open(?w.site, first, entry, 0);
    var imm: [3]Immediate       = [3]Immediate{Immediate.ty{ty}, Immediate.ty{w.ptr}, Immediate.alignment{align.ok}};
    val i:   Instruction        = emit.make(?w.site, opcode_table.ALLOCA, Slice[Value]{data: nil, size: 0}, Slice[Immediate]{data: ?imm[0], size: 3});
    val v:   Value              = emit.result(?w.site, i, 0);
    val ok:  err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { fail(w, ok.err); }
    w.head = w.head + 1;
    ret v;
}

# the leaves of a constant of a type, pushed into out from at
fun constant_leaves(w: *Work, c: Constant, ty: Type, out: Slice[Value], at: usize) {
    val got: res[ConstantData, module.Error] = module.constant_data(w.site.m, c);
    if (sel got.err) {
        fail(w, refusal.Error.ir{got.err});
        ret;
    }
    val data: ConstantData = got.ok;
    if (!aggregate(w, ty)) {
        val v: res[Value, module.Error] = body.constant(w.site.m, w.site.f, c);
        if (sel v.err) {
            fail(w, refusal.Error.ir{v.err});
            ret;
        }
        out.data[at] = v.ok;
        ret;
    }
    val s: res[Shaped, refusal.Error] = shaped(w, ty);
    if (sel s.err) {
        fail(w, s.err);
        ret;
    }
    if (sel data.zero) {
        var k: usize = 0;
        for (k < s.ok.count) {
            out.data[at + k] = constant_value(w, ConstantData.zero{leaf(w, s.ok, k).ty});
            k                = k + 1;
        }
        ret;
    }
    if (sel data.bytes) {
        if (data.bytes.data.size != s.ok.count) {
            fail(w, refusal.Error.reason{UNMATCHED});
            ret;
        }
        var k: usize = 0;
        for (k < s.ok.count) {
            var word: [1]u64 = [1]u64{data.bytes.data.data[k]::u64};
            out.data[at + k] = constant_value(w, ConstantData.integer{ir_constant.Bits{type: leaf(w, s.ok, k).ty, words: Slice[u64]{data: ?word[0], size: 1}}});
            k                = k + 1;
        }
        ret;
    }
    if (!(sel data.aggregate)) {
        fail(w, refusal.Error.reason{UNMATCHED});
        ret;
    }
    val sh: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel sh.err) {
        fail(w, sh.err);
        ret;
    }
    val shape: table.Shape = sh.ok;
    if (sel shape.union) {
        fail(w, refusal.Error.reason{UNION});
        ret;
    }
    var next: usize = at;
    var i:    usize = 0;
    for (i < data.aggregate.elements.size) {
        var mt: Type = ty;
        if (sel shape.structure) {
            if (i >= shape.structure.members.size) {
                fail(w, refusal.Error.reason{UNMATCHED});
                ret;
            }
            mt = shape.structure.members.data[i];
        }
        if (sel shape.array) { mt = shape.array.element; }
        val m: res[Shaped, refusal.Error] = shaped(w, mt);
        if (sel m.err) {
            fail(w, m.err);
            ret;
        }
        if (next + m.ok.count > at + s.ok.count) {
            fail(w, refusal.Error.reason{UNMATCHED});
            ret;
        }
        constant_leaves(w, data.aggregate.elements.data[i], mt, out, next);
        next = next + m.ok.count;
        i    = i + 1;
    }
}

# whether a value is a constant every bit of which is zero
fun zero_constant(w: *Work, c: Constant) bool {
    val got: res[ConstantData, module.Error] = module.constant_data(w.site.m, c);
    if (sel got.err) { ret false; }
    val data: ConstantData = got.ok;
    if (sel data.zero) { ret true; }
    if (sel data.integer) {
        var i: usize = 0;
        for (i < data.integer.words.size) {
            if (data.integer.words.data[i] != 0) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel data.aggregate) {
        var i: usize = 0;
        for (i < data.aggregate.elements.size) {
            if (!zero_constant(w, data.aggregate.elements.data[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel data.bytes) {
        var i: usize = 0;
        for (i < data.bytes.data.size) {
            if (data.bytes.data.data[i] != 0) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    ret false;
}

# the leaves of an aggregate loaded at an instruction, loaded ahead of it
fun loaded(w: *Work, i: Instruction, ty: Type) Slice[Value] {
    val s: res[Shaped, refusal.Error] = shaped(w, ty);
    if (sel s.err) {
        fail(w, s.err);
        ret Slice[Value]{data: nil, size: 0};
    }
    val b:     *Body            = body_of(w);
    val d:     *InstructionData = ?b.instructions.data[i];
    val base:  Value            = d.operands.data[0];
    val align: u64              = alignment_of(d);
    val f:     Flags            = d.metadata.flags;
    val out:   Slice[Value]     = fresh(w, s.ok.count);
    val k:     Block            = block_of(b, i);
    emit.open(?w.site, i, k, position(b, k, i));
    var n: usize = 0;
    for (n < out.size) {
        val l: Leaf = leaf(w, s.ok, n);
        out.data[n] = load_leaf(w, at_offset(w, base, l.offset), l.ty, moves.aligned_at(align, l.offset), f);
        n           = n + 1;
    }
    val ok: err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { fail(w, ok.err); }
    ret out;
}

# the leaves of a select of aggregates, a select of each leaf ahead of it
fun selected(w: *Work, i: Instruction) Slice[Value] {
    val b:    *Body            = body_of(w);
    val d:    *InstructionData = ?b.instructions.data[i];
    val cond: Value            = d.operands.data[0];
    val a:    Slice[Value]     = leaves_of(w, d.operands.data[1]);
    val e:    Slice[Value]     = leaves_of(w, b.instructions.data[i].operands.data[2]);
    if (sel w.failed.some) { ret a; }
    val out: Slice[Value] = fresh(w, a.size);
    val k:   Block        = block_of(b, i);
    emit.open(?w.site, i, k, position(b, k, i));
    var n: usize = 0;
    for (n < out.size) {
        out.data[n] = emit.ternary(?w.site, opcode_table.SELECT, cond, a.data[n], e.data[n]);
        n           = n + 1;
    }
    val ok: err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { fail(w, ok.err); }
    ret out;
}

fun member_of(d: *InstructionData) u32 {
    var i: usize = 0;
    for (i < d.immediates.len) {
        val m: Immediate = d.immediates.data[i];
        if (sel m.member) { ret m.member; }
        i = i + 1;
    }
    ret 0;
}

# the leaves of an insert: the aggregate's with the member's run replaced
fun inserted(w: *Work, i: Instruction) Slice[Value] {
    val b:      *Body                   = body_of(w);
    val d:      *InstructionData        = ?b.instructions.data[i];
    val whole:  Value                   = d.operands.data[0];
    val part:   Value                   = d.operands.data[1];
    val index:  u32                     = member_of(d);
    var member: Type                    = type_of(w, whole);
    val run:    res[Run, refusal.Error] = member_run(w, type_of(w, whole), index, ?member);
    if (sel run.err) {
        fail(w, run.err);
        ret Slice[Value]{data: nil, size: 0};
    }
    val from: Slice[Value] = leaves_of(w, whole);
    var by:   Slice[Value] = Slice[Value]{data: nil, size: 0};
    var one:  [1]Value     = [1]Value{part};
    if (aggregate(w, member)) { by = leaves_of(w, part); }
    or                        { by = Slice[Value]{data: ?one[0], size: 1}; }
    if (sel w.failed.some)    { ret from; }
    val out: Slice[Value] = fresh(w, from.size);
    var n:   usize        = 0;
    for (n < out.size) {
        if (n >= run.ok.start && n < run.ok.start + run.ok.count) { out.data[n] = by.data[n - run.ok.start]; }
        or                                                        { out.data[n] = from.data[n]; }
        n = n + 1;
    }
    ret out;
}

# the leaves of an extract of an aggregate member: the run of the member's
fun extracted(w: *Work, i: Instruction) Slice[Value] {
    val b:      *Body                   = body_of(w);
    val d:      *InstructionData        = ?b.instructions.data[i];
    val whole:  Value                   = d.operands.data[0];
    var member: Type                    = type_of(w, whole);
    val run:    res[Run, refusal.Error] = member_run(w, type_of(w, whole), member_of(d), ?member);
    if (sel run.err) {
        fail(w, run.err);
        ret Slice[Value]{data: nil, size: 0};
    }
    val from: Slice[Value] = leaves_of(w, whole);
    if (sel w.failed.some) { ret from; }
    val out: Slice[Value] = fresh(w, run.ok.count);
    var n:   usize        = 0;
    for (n < out.size) {
        out.data[n] = from.data[run.ok.start + n];
        n           = n + 1;
    }
    ret out;
}

# the leaves of a value the abi legalisation places, a parameter of the entry
# or a call's result: stored to a slot just after it is made and loaded back
fun spilled(w: *Work, x: Value) Slice[Value] {
    val ty: Type                       = type_of(w, x);
    val s:  res[Shaped, refusal.Error] = shaped(w, ty);
    if (sel s.err) {
        fail(w, s.err);
        ret Slice[Value]{data: nil, size: 0};
    }
    val align: res[u64, refusal.Error] = align_of(w, ty);
    if (sel align.err) {
        fail(w, align.err);
        ret Slice[Value]{data: nil, size: 0};
    }
    val home: Value = slot(w, ty);
    if (sel w.failed.some) { ret Slice[Value]{data: nil, size: 0}; }
    val b:     *Body = body_of(w);
    val def:   Def   = b.values.data[x].def;
    var k:     Block = 0;
    var index: u32   = w.head;
    var entry: bool  = true;
    if (sel def.result) {
        val at: Instruction = def.result.instruction;
        k     = block_of(b, at);
        index = position(b, k, at) + 1;
        entry = false;
    }
    val origin: Instruction = b.blocks.data[k].instructions.data[index];
    emit.open(?w.site, origin, k, index);
    store_at(w, home, x, align.ok, NO_FLAGS);
    val out: Slice[Value] = fresh(w, s.ok.count);
    var n:   usize        = 0;
    for (n < out.size) {
        val l: Leaf = leaf(w, s.ok, n);
        out.data[n] = load_at(w, at_offset(w, home, l.offset), l.ty, moves.aligned_at(align.ok, l.offset), NO_FLAGS);
        n           = n + 1;
    }
    if (entry) { w.head = w.head + w.site.made; }
    val ok: err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { fail(w, ok.err); }
    ret out;
}

# whether a value is one the abi legalisation places, which the first run
# leaves whole and reads through a slot
fun placed(w: *Work, x: Value) bool {
    if (w.late) { ret false; }
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[x].def;
    if (sel def.parameter) { ret def.parameter.block == 0; }
    if (sel def.result)    { ret b.instructions.data[def.result.instruction].opcode == opcode_table.CALL; }
    ret false;
}

# the leaves of an aggregate value, taken apart once
fun leaves_of(w: *Work, x: Value) Slice[Value] {
    if (holding(w, x)) { ret w.held.data[x]; }
    var out: Slice[Value] = Slice[Value]{data: nil, size: 0};
    val ty:  Type         = type_of(w, x);
    val b:   *Body        = body_of(w);
    val def: Def          = b.values.data[x].def;
    if (sel def.constant) {
        val s: res[Shaped, refusal.Error] = shaped(w, ty);
        if (sel s.err) {
            fail(w, s.err);
            ret out;
        }
        out = fresh(w, s.ok.count);
        if (sel w.failed.some) { ret out; }
        constant_leaves(w, def.constant, ty, out, 0);
    }
    or (placed(w, x)) { out = spilled(w, x); }
    or (sel def.result) {
        val i:    Instruction = def.result.instruction;
        val code: Opcode      = b.instructions.data[i].opcode;
        if (code == opcode_table.LOAD)    { out = loaded(w, i, ty); }
        or (code == opcode_table.SELECT)  { out = selected(w, i); }
        or (code == opcode_table.INSERT)  { out = inserted(w, i); }
        or (code == opcode_table.EXTRACT) { out = extracted(w, i); }
        or                                            { fail(w, refusal.Error.reason{WHOLE}); }
    }
    or                     { fail(w, refusal.Error.reason{WHOLE}); }
    if (sel w.failed.some) { ret out; }
    hold(w, x, out);
    ret out;
}

# take every aggregate parameter of a block other than the entry apart into one
# parameter per leaf, each edge passing zero leaves until its arguments are
fun split_parameters(w: *Work) err[refusal.Error] {
    val b:    *Body                       = body_of(w);
    val room: res[usize, allocator.Error] = vector.reserve[u32](?w.before, b.blocks.len);
    if (sel room.err) { ret err[refusal.Error].err{lost(room.err)}; }
    var k: usize = 0;
    for (k < b.blocks.len) {
        vector.push[u32](?w.before, UNTOUCHED);
        k = k + 1;
    }
    k = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val count: usize = b.blocks.data[k].parameters.len;
            var p:     usize = 0;
            for (p < count) {
                val old: Value = b.blocks.data[k].parameters.data[p];
                val ty:  Type  = type_of(w, old);
                if (aggregate(w, ty)) {
                    val s: res[Shaped, refusal.Error] = shaped(w, ty);
                    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
                    w.before.data[k] = count::u32;
                    val preds:  usize        = b.blocks.data[k].predecessors.len;
                    val made:   Slice[Value] = fresh(w, s.ok.count);
                    val secret: bool         = b.values.data[old].secret;
                    var j:      usize        = 0;
                    for (j < made.size) {
                        val ty_j:     Type         = leaf(w, s.ok, j).ty;
                        val zero:     Value        = constant_value(w, ConstantData.zero{ty_j});
                        val incoming: Slice[Value] = fresh(w, preds);
                        var e:        usize        = 0;
                        for (e < incoming.size) {
                            incoming.data[e] = zero;
                            e                = e + 1;
                        }
                        val unmade: err[refusal.Error] = failure_of(w);
                        if (sel unmade.err) { ret unmade; }
                        val added: res[Value, module.Error] = body.add_parameter(w.site.m, w.site.f, (k::u32), Declaration{type: ty_j, secret: secret, name: opt[View].none{}}, incoming);
                        if (sel added.err) { ret err[refusal.Error].err{refusal.Error.ir{added.err}}; }
                        made.data[j] = added.ok;
                        j            = j + 1;
                    }
                    hold(w, old, made);
                    val listed: res[usize, allocator.Error] = vector.push[Value](?w.params, old);
                    if (sel listed.err) { ret err[refusal.Error].err{lost(listed.err)}; }
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    ret failure_of(w);
}

# pass every edge into a block whose parameters were taken apart the leaves
# of its arguments, after the arguments it passed before
fun split_edges(w: *Work) err[refusal.Error] {
    val b: *Body = body_of(w);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && b.blocks.data[k].instructions.len != 0) {
            val last:  Instruction = b.blocks.data[k].instructions.data[b.blocks.data[k].instructions.len - 1];
            val edges: usize       = b.instructions.data[last].edges.len;
            var e:     usize       = 0;
            for (e < edges) {
                val to:     Block = b.instructions.data[last].edges.data[e].block;
                val before: u32   = w.before.data[to];
                if (before != UNTOUCHED) {
                    val args: Slice[Value] = fresh(w, before::usize);
                    var a:    usize        = 0;
                    for (a < args.size) {
                        args.data[a] = b.instructions.data[last].edges.data[e].arguments.data[a];
                        a            = a + 1;
                    }
                    var list: Vector[Value] = vector.init[Value](w.keep);
                    a = 0;
                    for (a < args.size) {
                        vector.push[Value](?list, args.data[a]);
                        a = a + 1;
                    }
                    a = 0;
                    for (a < args.size) {
                        if (aggregate(w, type_of(w, b.blocks.data[to].parameters.data[a]))) {
                            val parts: Slice[Value] = leaves_of(w, args.data[a]);
                            var j:     usize        = 0;
                            for (j < parts.size) {
                                vector.push[Value](?list, parts.data[j]);
                                j = j + 1;
                            }
                        }
                        a = a + 1;
                    }
                    val unmade: err[refusal.Error] = failure_of(w);
                    if (sel unmade.err) { ret unmade; }
                    val moved: err[refusal.Error] = refusal.edit(body.retarget(w.site.m, w.site.f, last, e::u32, to, Slice[Value]{data: list.data, size: list.len}));
                    if (sel moved.err) { ret moved; }
                }
                e = e + 1;
            }
        }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# whether an instruction may write memory, by its row
fun writes(b: *Body, i: Instruction) bool {
    val got: opt[*Row] = opcode_table.at(b.instructions.data[i].opcode);
    if (sel got.none) { ret true; }
    ret got.some.effects.writes;
}

# the load a store moves from memory to memory: one neither volatile nor kept
# whose only use is the store, in its block ahead of it with nothing that
# writes memory between
fun copied(w: *Work, store: Instruction, x: Value) opt[Instruction] {
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[x].def;
    if (!(sel def.result))                    { ret opt[Instruction].none{}; }
    if (b.values.data[x].uses.len != 1) { ret opt[Instruction].none{}; }
    val l: Instruction      = def.result.instruction;
    val d: *InstructionData = ?b.instructions.data[l];
    if (d.opcode != opcode_table.LOAD)          { ret opt[Instruction].none{}; }
    if (d.metadata.flags.volatile || d.metadata.flags.kept) { ret opt[Instruction].none{}; }
    val k: Block = block_of(b, store);
    if (block_of(b, l) != k) { ret opt[Instruction].none{}; }
    val from: u32 = position(b, k, l);
    val to:   u32 = position(b, k, store);
    if (from >= to) { ret opt[Instruction].none{}; }
    var p: u32 = from + 1;
    for (p < to) {
        if (writes(b, b.blocks.data[k].instructions.data[p])) { ret opt[Instruction].none{}; }
        p = p + 1;
    }
    ret opt[Instruction].some{l};
}

# a run of bytes moved, or filled with one byte, in the widest words each
# alignment allows, the last store in the store's place. every word is loaded
# before the first store, so a move between overlapping runs reads the bytes
# as they were
fun in_words(w: *Work, origin: Instruction, to: Value, from: opt[Value], size: u64, align: u64, byte: u8, f: Flags) {
    var loads: Vector[Value] = vector.init[Value](w.keep);
    var done:  u64           = 0;
    if (sel from.some) {
        for (done < size) {
            val at: u64                      = moves.aligned_at(align, done);
            val n:  u64                      = moves.step(size - done, at, w.word);
            val ty: res[Type, refusal.Error] = integer(w, (n * 8)::u32);
            if (sel ty.err) {
                fail(w, ty.err);
                ret;
            }
            vector.push[Value](?loads, load_at(w, at_offset(w, from.some, done), ty.ok, at, NO_FLAGS));
            done = done + n;
        }
    }
    done = 0;
    var k: usize = 0;
    for (done < size) {
        val at: u64                      = moves.aligned_at(align, done);
        val n:  u64                      = moves.step(size - done, at, w.word);
        val ty: res[Type, refusal.Error] = integer(w, (n * 8)::u32);
        if (sel ty.err) {
            fail(w, ty.err);
            ret;
        }
        var x: Value = 0;
        if (sel from.some) { x = loads.data[k]; }
        or {
            val z: res[Value, refusal.Error] = emit.constant(?w.site, ty.ok, filled(byte, n));
            if (sel z.err) {
                fail(w, z.err);
                ret;
            }
            x = z.ok;
        }
        val address: Value = at_offset(w, to, done);
        if (done + n >= size) { emit.close(?w.site, origin); }
        store_at(w, address, x, at, f);
        done = done + n;
        k    = k + 1;
    }
}

# a word of n bytes each one byte
fun filled(byte: u8, n: u64) Wide {
    var x: Wide = word.zero();
    var k: u64  = 0;
    for (k < n && byte != 0) {
        x[k / 8] = x[k / 8] | (byte::u64 << ((k % 8) * 8));
        k        = k + 1;
    }
    ret x;
}

# a run of bytes moved or zeroed as one bulk operation in the store's place
fun in_bulk(w: *Work, origin: Instruction, to: Value, from: opt[Value], size: u64, align: u64, f: Flags) {
    val length: Value        = length_of(w, to, size);
    var ops:    [3]Value     = [3]Value{to, 0, length};
    var imm:    [1]Immediate = [1]Immediate{Immediate.alignment{align}};
    var code:   Opcode       = opcode_table.MEM_FILL;
    if (sel from.some) {
        ops[1] = from.some;
        code   = opcode_table.MEM_COPY;
    }
    or {
        val byte: res[Type, refusal.Error] = integer(w, 8);
        if (sel byte.err) {
            fail(w, byte.err);
            ret;
        }
        val z: res[Value, refusal.Error] = emit.constant(?w.site, byte.ok, word.zero());
        if (sel z.err) {
            fail(w, z.err);
            ret;
        }
        ops[1] = z.ok;
    }
    emit.close(?w.site, origin);
    emit.flags(?w.site, Flags{volatile: false, kept: f.kept, bounded: false});
    emit.make(?w.site, code, Slice[Value]{data: ?ops[0], size: 3}, Slice[Immediate]{data: ?imm[0], size: 1});
    emit.flags(?w.site, NO_FLAGS);
}

fun gone(w: *Work, i: Instruction) err[refusal.Error] {
    var n: usize = 0;
    for (n < w.gone.len) {
        if (w.gone.data[n] == i) { ret err[refusal.Error].ok{}; }
        n = n + 1;
    }
    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?w.gone, i);
    if (sel pushed.err) { ret err[refusal.Error].err{lost(pushed.err)}; }
    ret err[refusal.Error].ok{};
}

# a store of an aggregate: a move or a fill of its bytes, or a store of each
# leaf
fun store(w: *Work, i: Instruction) err[refusal.Error] {
    val b:     *Body                   = body_of(w);
    val d:     *InstructionData        = ?b.instructions.data[i];
    val to:    Value                   = d.operands.data[0];
    val x:     Value                   = d.operands.data[1];
    val align: u64                     = alignment_of(d);
    val f:     Flags                   = d.metadata.flags;
    val ty:    Type                    = type_of(w, x);
    val size:  res[u64, refusal.Error] = size_of(w, ty);
    if (sel size.err) { ret err[refusal.Error].err{size.err}; }
    if (size.ok == 0) { ret gone(w, i); }
    if (placed(w, x)) { ret err[refusal.Error].ok{}; }
    val k:   Block = block_of(b, i);
    val def: Def   = b.values.data[x].def;
    if (!f.volatile && !f.kept) {
        var zero: bool = false;
        if (sel def.constant) { zero = zero_constant(w, def.constant); }
        val from: opt[Instruction] = copied(w, i, x);
        if (zero || sel from.some) {
            var source: opt[Value] = opt[Value].none{};
            var both:   u64        = align;
            if (sel from.some) {
                source = opt[Value].some{b.instructions.data[from.some].operands.data[0]};
                val other: u64 = alignment_of(?b.instructions.data[from.some]);
                if (other < both) { both = other; }
            }
            emit.open(?w.site, i, k, position(b, k, i));
            if (moves.in_words(w.caps, size.ok, both, w.word, zero, !w.late)) { in_words(w, i, to, source, size.ok, both, 0, f); }
            or                                                                { in_bulk(w, i, to, source, size.ok, both, f); }
            val ok: err[refusal.Error] = emit.done(?w.site);
            if (sel ok.err)    { ret ok; }
            if (sel from.some) { ret gone(w, from.some); }
            ret failure_of(w);
        }
    }
    val parts:  Slice[Value]       = leaves_of(w, x);
    val unmade: err[refusal.Error] = failure_of(w);
    if (sel unmade.err)  { ret unmade; }
    if (parts.size == 0) { ret gone(w, i); }
    val s: res[Shaped, refusal.Error] = shaped(w, ty);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    emit.open(?w.site, i, k, position(b, k, i));
    var n: usize = 0;
    for (n < parts.size) {
        val l:       Leaf  = leaf(w, s.ok, n);
        val address: Value = at_offset(w, to, l.offset);
        val stored:  Value = as_stored(w, parts.data[n]);
        if (n + 1 == parts.size) { emit.close(?w.site, i); }
        store_at(w, address, stored, moves.aligned_at(align, l.offset), f);
        n = n + 1;
    }
    val ok: err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { ret ok; }
    ret failure_of(w);
}

# an aggregate a call or a return reads, which the abi legalisation places:
# left as it is where it is memory or a placed value, and otherwise built in
# a slot from its leaves and loaded whole just ahead of it
fun handed(w: *Work, i: Instruction, x: Value) err[refusal.Error] {
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[x].def;
    if (sel def.constant || placed(w, x)) { ret err[refusal.Error].ok{}; }
    if (sel def.result) {
        if (b.instructions.data[def.result.instruction].opcode == opcode_table.LOAD) { ret err[refusal.Error].ok{}; }
    }
    val ty:    Type                    = type_of(w, x);
    val align: res[u64, refusal.Error] = align_of(w, ty);
    if (sel align.err) { ret err[refusal.Error].err{align.err}; }
    val parts: Slice[Value]               = leaves_of(w, x);
    val s:     res[Shaped, refusal.Error] = shaped(w, ty);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    val home:   Value              = slot(w, ty);
    val unmade: err[refusal.Error] = failure_of(w);
    if (sel unmade.err) { ret unmade; }
    val k: Block = block_of(b, i);
    emit.open(?w.site, i, k, position(b, k, i));
    var n: usize = 0;
    for (n < parts.size) {
        val l: Leaf = leaf(w, s.ok, n);
        store_at(w, at_offset(w, home, l.offset), parts.data[n], moves.aligned_at(align.ok, l.offset), NO_FLAGS);
        n = n + 1;
    }
    val whole: Value              = load_at(w, home, ty, align.ok, NO_FLAGS);
    val ok:    err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { ret ok; }
    val failed: err[refusal.Error] = failure_of(w);
    if (sel failed.err) { ret failed; }
    ret refusal.edit(body.substitute(w.site.m, w.site.f, i, x, whole));
}

# the bytes a `mem.copy` or `mem.fill` moves, when the length is a constant,
# the fill's byte is one and the access is neither volatile nor kept, none
# for any other
fun small_bulk(w: *Work, d: *InstructionData) opt[u64] {
    val code: Opcode = d.opcode;
    if (code != opcode_table.MEM_COPY && code != opcode_table.MEM_FILL) { ret opt[u64].none{}; }
    if (d.metadata.flags.volatile || d.metadata.flags.kept || d.operands.len != 3)              { ret opt[u64].none{}; }
    if (code == opcode_table.MEM_FILL) {
        val byte: opt[u64] = emit.known(?w.site, d.operands.data[1]);
        if (sel byte.none) { ret opt[u64].none{}; }
    }
    ret emit.known(?w.site, d.operands.data[2]);
}

# a `mem.copy` or `mem.fill` of a length the compiler knows, made of word moves
# where the bound of moves admits it (mirl.legal.moves), and left whole past
# it, as it already stands legal
fun bulk(w: *Work, i: Instruction) err[refusal.Error] {
    val b:    *Body            = body_of(w);
    val d:    *InstructionData = ?b.instructions.data[i];
    val size: opt[u64]         = small_bulk(w, d);
    if (sel size.none) { ret err[refusal.Error].ok{}; }
    val fill:  bool       = d.opcode == opcode_table.MEM_FILL;
    val align: u64        = alignment_of(d);
    val to:    Value      = d.operands.data[0];
    var from:  opt[Value] = opt[Value].none{};
    var byte:  u8         = 0;
    if (!fill) { from = opt[Value].some{d.operands.data[1]}; }
    val second: opt[u64] = emit.known(?w.site, d.operands.data[1]);
    if (sel second.some) {
        if (fill) { byte = (second.some & 0xff)::u8; }
    }
    if (size.some == 0)                                                { ret gone(w, i); }
    if (!moves.in_words(w.caps, size.some, align, w.word, fill, true)) { ret err[refusal.Error].ok{}; }
    val f: Flags = d.metadata.flags;
    val k: Block = block_of(b, i);
    emit.open(?w.site, i, k, position(b, k, i));
    in_words(w, i, to, from, size.some, align, byte, f);
    val ok: err[refusal.Error] = emit.done(?w.site);
    if (sel ok.err) { ret ok; }
    ret failure_of(w);
}

# take apart what one instruction reads or gives as an aggregate, or makes a
# known small bulk operation of word moves
fun visit_one(w: *Work, i: Instruction) err[refusal.Error] {
    val b:    *Body            = body_of(w);
    val d:    *InstructionData = ?b.instructions.data[i];
    val code: Opcode           = d.opcode;
    if (code == opcode_table.MEM_COPY || code == opcode_table.MEM_FILL) { ret bulk(w, i); }
    var reads: bool  = false;
    var k:     usize = 0;
    for (k < d.operands.len) {
        if (aggregate(w, type_of(w, d.operands.data[k]))) { reads = true; }
        k = k + 1;
    }
    var gives: bool = false;
    k = 0;
    for (k < d.results.len) {
        if (aggregate(w, type_of(w, d.results.data[k]))) { gives = true; }
        k = k + 1;
    }
    if (!reads && !gives)                       { ret err[refusal.Error].ok{}; }
    if (code == opcode_table.STORE) { ret store(w, i); }
    if (code == opcode_table.EXTRACT) {
        if (!gives) {
            val whole:  Value                   = d.operands.data[0];
            var member: Type                    = type_of(w, whole);
            val run:    res[Run, refusal.Error] = member_run(w, type_of(w, whole), member_of(d), ?member);
            if (sel run.err) { ret err[refusal.Error].err{run.err}; }
            val result: Value              = b.instructions.data[i].results.data[0];
            val parts:  Slice[Value]       = leaves_of(w, whole);
            val unmade: err[refusal.Error] = failure_of(w);
            if (sel unmade.err) { ret unmade; }
            val moved: err[refusal.Error] = refusal.edit(body.replace(w.site.m, w.site.f, result, parts.data[run.ok.start], Records.follow{}));
            if (sel moved.err) { ret moved; }
        }
        ret gone(w, i);
    }
    if (code == opcode_table.LOAD || code == opcode_table.SELECT || code == opcode_table.INSERT) { ret gone(w, i); }
    if (!w.late && (code == opcode_table.CALL || code == opcode_table.RET)) {
        var n: usize = 0;
        for (n < b.instructions.data[i].operands.len) {
            val x: Value = b.instructions.data[i].operands.data[n];
            if (aggregate(w, type_of(w, x))) {
                val ok: err[refusal.Error] = handed(w, i, x);
                if (sel ok.err) { ret ok; }
            }
            n = n + 1;
        }
        ret err[refusal.Error].ok{};
    }
    ret err[refusal.Error].err{refusal.Error.reason{WHOLE}};
}

# a record that reads a value taken apart, split into a piece per leaf, each
# read from its leaf
fun pieced(w: *Work, x: Value, r: u32) err[refusal.Error] {
    val b:     *Body                      = body_of(w);
    val piece: Bits                       = b.points.data[r].piece;
    val s:     res[Shaped, refusal.Error] = shaped(w, type_of(w, x));
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    val parts: Slice[Value] = w.held.data[x];
    if (parts.size == 0) { ret err[refusal.Error].ok{}; }
    var each: Vector[Part]                = vector.init[Part](w.keep);
    val room: res[usize, allocator.Error] = vector.reserve[Part](?each, parts.size);
    if (sel room.err) { ret err[refusal.Error].err{lost(room.err)}; }
    var n: usize = 0;
    for (n < parts.size) {
        val l: Leaf = leaf(w, s.ok, n);
        vector.push[Part](?each, Part{piece: Bits{offset: piece.offset + (l.offset * 8)::u32, size: l.bits}, reads: Reads.operand{Operand{value: parts.data[n], expression: point.PLAIN}}});
        n = n + 1;
    }
    ret refusal.edit(body.split(w.site.m, w.site.f, r, Slice[Part]{data: each.data, size: each.len}));
}

# give each record that reads a value taken apart as it is a piece per leaf
fun salvage(w: *Work, x: Value) err[refusal.Error] {
    if (!holding(w, x)) { ret err[refusal.Error].ok{}; }
    val b:     *Body               = body_of(w);
    val bound: *vector.Vector[u32] = ?b.values.data[x].bound;
    var ids:   Vector[u32]         = vector.init[u32](w.keep);
    var n:     usize               = 0;
    for (n < bound.len) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?ids, bound.data[n]);
        if (sel pushed.err) { ret err[refusal.Error].err{lost(pushed.err)}; }
        n = n + 1;
    }
    n = 0;
    for (n < ids.len) {
        val reads: Reads = b.points.data[ids.data[n]].reads;
        if (sel reads.operand) {
            val had: res[Slice[Step], module.Error] = module.steps(w.site.m, reads.operand.expression);
            if (sel had.err) { ret err[refusal.Error].err{refusal.Error.ir{had.err}}; }
            if (had.ok.size == 0 && point.whole(b.points.data[ids.data[n]].piece)) {
                val split: err[refusal.Error] = pieced(w, x, ids.data[n]);
                if (sel split.err) { ret split; }
            }
        }
        n = n + 1;
    }
    ret err[refusal.Error].ok{};
}

# whether an instruction reads a value as an operand, not only as an edge's
# argument, which goes with the parameter taken apart
fun reads(b: *Body, i: Instruction, x: Value) bool {
    val d: *InstructionData = ?b.instructions.data[i];
    var k: usize            = 0;
    for (k < d.operands.len) {
        if (d.operands.data[k] == x) { ret true; }
        k = k + 1;
    }
    ret false;
}

# take out what was taken apart: the instructions whose results nothing else
# reads, and the parameters split, with the edges' arguments for them
fun remove(w: *Work) err[refusal.Error] {
    val b:    *Body               = body_of(w);
    var keep: Vector[Instruction] = vector.init[Instruction](w.keep);
    var n:    usize               = 0;
    for (n < w.gone.len) {
        val i:    Instruction      = w.gone.data[n];
        val d:    *InstructionData = ?b.instructions.data[i];
        var used: bool             = false;
        var r:    usize            = 0;
        for (r < d.results.len) {
            val uses: *Growing[Instruction] = ?b.values.data[d.results.data[r]].uses;
            var u:    usize                       = 0;
            for (u < uses.len) {
                val user:   Instruction = uses.data[u];
                var listed: bool        = false;
                var g:      usize       = 0;
                for (g < w.gone.len) {
                    if (w.gone.data[g] == user) { listed = true; }
                    g = g + 1;
                }
                if (!listed && reads(b, user, d.results.data[r])) { used = true; }
                u = u + 1;
            }
            r = r + 1;
        }
        if (!used || d.opcode != opcode_table.LOAD) {
            val pushed: res[usize, allocator.Error] = vector.push[Instruction](?keep, i);
            if (sel pushed.err) { ret err[refusal.Error].err{lost(pushed.err)}; }
        }
        n = n + 1;
    }
    n = 0;
    for (n < keep.len) {
        val results: *List[Value]          = ?b.instructions.data[keep.data[n]].results;
        if (results.len != 0) {
            val r: err[refusal.Error] = salvage(w, results.data[0]);
            if (sel r.err) { ret r; }
        }
        n = n + 1;
    }
    n = 0;
    for (n < w.params.len) {
        val r: err[refusal.Error] = salvage(w, w.params.data[n]);
        if (sel r.err) { ret r; }
        n = n + 1;
    }
    ret refusal.edit(body.remove_dead(w.site.m, w.site.f, Slice[Instruction]{data: keep.data, size: keep.len}, Slice[Value]{data: w.params.data, size: w.params.len}));
}

fun ahead(u: *Unit) res[bool, refusal.Error] {
    ret visit(u, false);
}

fun after(u: *Unit) res[bool, refusal.Error] {
    ret visit(u, true);
}

# whether a body holds a bulk copy or fill, or an aggregate type
fun concerned(m: *module.Module, b: *Body) bool {
    if (contents.has_opcode(?b.contents, opcode_table.MEM_COPY) || contents.has_opcode(?b.contents, opcode_table.MEM_FILL)) { ret true; }
    var ty: u32 = 0;
    for (contents.seek(?b.contents.types, ?ty)) {
        val s: res[*table.Shape, table.Error] = table.shape_at(?m.types, ty);
        if (sel s.ok) {
            if (sel s.ok.structure || sel s.ok.array || sel s.ok.union) { ret true; }
        }
        ty = ty + 1;
    }
    ret false;
}

# take apart every aggregate value of one function
fun visit(u: *Unit, late: bool) res[bool, refusal.Error] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{got.err}}; }
    val b: *Body = got.ok;

    var held: arena.Arena;
    val kept: err[allocator.Error] = arena.init(?held, c.m.a, 0);
    if (sel kept.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{kept.err}}; }
    fin { arena.dnit(?held); }
    var keep: allocator.Allocator;
    arena.make(?keep, ?held);

    var w: Work;
    w.site   = emit.init(c.m, u.f, b, ?keep);
    w.layout = layout.of(c.t, ?c.m.types, basis.context_of(c.basis));
    w.caps   = ?c.t.caps;
    w.late   = late;
    w.basis  = c.basis;
    w.keep   = ?keep;
    w.leaves = vector.init[Leaf](?keep);
    w.shapes = vector.init[Shaped](?keep);
    w.held   = vector.init[Slice[Value]](?keep);
    w.state  = vector.init[u8](?keep);
    w.gone   = vector.init[Instruction](?keep);
    w.params = vector.init[Value](?keep);
    w.before = vector.init[u32](?keep);
    w.head   = 0;
    w.failed = opt[refusal.Error].none{};
    w.word   = 8;
    val top: opt[u32] = capability.widest(?c.t.caps);
    if (sel top.some) { w.word = (top.some / 8)::u64; }
    if (w.word == 0)  { w.word = 1; }
    val slot: res[u32, target_record.Error] = target_record.slot_space(c.t);
    if (sel slot.err) { ret res[bool, refusal.Error].err{refusal.Error.reason{"a target that states no address space for its stack slots"}}; }
    val ptr: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.pointer{table.Pointer{space: slot.ok}});
    if (sel ptr.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{ptr.err}}}; }
    w.ptr = ptr.ok;
    if (!concerned(c.m, b)) { ret res[bool, refusal.Error].ok{false}; }

    var any: bool  = false;
    var k:   usize = 0;
    for (k < b.blocks.len && !any) {
        if (!b.blocks.data[k].erased) {
            var p: usize = 0;
            for (p < b.blocks.data[k].parameters.len) {
                if (k != 0 && aggregate(?w, type_of(?w, b.blocks.data[k].parameters.data[p]))) { any = true; }
                p = p + 1;
            }
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val d:     *InstructionData = ?b.instructions.data[b.blocks.data[k].instructions.data[n]];
                val small: opt[u64]         = small_bulk(?w, d);
                if (sel small.some) { any = true; }
                var r: usize = 0;
                for (r < d.results.len) {
                    if (aggregate(?w, type_of(?w, d.results.data[r]))) { any = true; }
                    r = r + 1;
                }
                r = 0;
                for (r < d.operands.len) {
                    if (aggregate(?w, type_of(?w, d.operands.data[r]))) { any = true; }
                    r = r + 1;
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    if (!any) { ret res[bool, refusal.Error].ok{false}; }

    var order: Vector[Instruction] = vector.init[Instruction](?keep);
    k = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val pushed: res[usize, allocator.Error] = vector.push[Instruction](?order, b.blocks.data[k].instructions.data[n]);
                if (sel pushed.err) { ret res[bool, refusal.Error].err{lost(pushed.err)}; }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    val params: err[refusal.Error] = split_parameters(?w);
    if (sel params.err) { ret res[bool, refusal.Error].err{params.err}; }
    var n: usize = 0;
    for (n < order.len) {
        val ok: err[refusal.Error] = visit_one(?w, order.data[n]);
        if (sel ok.err) { ret res[bool, refusal.Error].err{ok.err}; }
        n = n + 1;
    }
    val edges: err[refusal.Error] = split_edges(?w);
    if (sel edges.err) { ret res[bool, refusal.Error].err{edges.err}; }
    val removed: err[refusal.Error] = remove(?w);
    if (sel removed.err) { ret res[bool, refusal.Error].err{removed.err}; }
    ret res[bool, refusal.Error].ok{true};
}
