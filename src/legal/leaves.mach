# the scalar leaves of an aggregate, which a value of it is built from with
# `insert` and taken apart into with `extract`, so it crosses a call boundary
# with no memory between
#
# a structure's leaves are its members', in member order, and an array's its
# elements', each at its byte offset in the aggregate, as the aggregates
# legalisation orders them. a union's leaf is its cover, the member that holds
# every byte of it as one integer or pointer, so every member reads what the
# cover holds. a leaf is an integer, a pointer or a float of a format the build
# holds, of whole bytes. a type that holds a union with no cover, a vector, a
# function, a handle or a float the build holds no unit for is not made of
# such leaves, since its bytes are read as other types than its own: a vector's
# lanes are the vector legalisation's and an unheld float is the half
# precision legalisation's encoding everywhere but at a boundary.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability.Held;
use mirl.target.layout;
use mirl.target.layout.Layout;
use target_record: mirl.target.record;

# one scalar leaf
# ---
# offset: its byte offset in the aggregate
# ty:     its type
# size:   its bytes
pub rec Leaf {
    offset: u64;
    ty:     Type;
    size:   u64;
}

# the bytes of a type that is one leaf, none for any other type
# ---
# l:  the layout
# b:  the build's selection, which says which float formats it holds
# ty: the type
pub fun scalar(l: *Layout, b: opt[*Basis], ty: Type) opt[u64] {
    val res_shape: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel res_shape.err) { ret opt[u64].none{}; }
    val shape: table.Shape = res_shape.ok;
    if (!(sel shape.integer) && !(sel shape.pointer) && !(sel shape.float)) { ret opt[u64].none{}; }
    val res_size: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    if (sel res_size.err) { ret opt[u64].none{}; }
    if (sel shape.integer) {
        if (shape.integer.width::u64 != res_size.ok * 8) { ret opt[u64].none{}; }
    }
    if (sel shape.float) {
        val opt_row: opt[format.Row] = format.row(shape.float.format);
        if (sel opt_row.none)                           { ret opt[u64].none{}; }
        if (opt_row.some.width::u64 != res_size.ok * 8) { ret opt[u64].none{}; }
        val res_held: res[opt[*Held], basis.Error] = basis.held(b, ?l.target.caps, shape.float.format);
        if (sel res_held.err)     { ret opt[u64].none{}; }
        if (sel res_held.ok.none) { ret opt[u64].none{}; }
    }
    ret opt[u64].some{res_size.ok};
}

# the cover of a union aligned to its size and of at most a word, the first
# of its members that is an integer or a pointer of every byte of it, by its
# index, none for a union with none or any other type. such a union's bytes
# are one word, which the cover reads whole
pub fun cover(l: *Layout, b: opt[*Basis], ty: Type, word: u64) opt[u32] {
    val res_shape: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel res_shape.err) { ret opt[u32].none{}; }
    val shape: table.Shape = res_shape.ok;
    if (!(sel shape.union)) { ret opt[u32].none{}; }
    val res_size:  res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    val res_align: res[u64, target_record.Error] = layout.align(l, ty, table.DEFAULT_SPACE);
    if (sel res_size.err)                                  { ret opt[u32].none{}; }
    if (sel res_align.err)                                 { ret opt[u32].none{}; }
    if (res_size.ok != res_align.ok || res_size.ok > word) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < shape.union.members.size) {
        val mt:        Type                          = shape.union.members.data[i];
        val res_shape: res[table.Shape, table.Error] = table.shape(l.types, mt);
        val opt_one:   opt[u64]                      = scalar(l, b, mt);
        if (sel res_shape.ok) {
            val whole: bool = !(sel res_shape.ok.float);
            if (sel opt_one.some) {
                if (whole && opt_one.some == res_size.ok) { ret opt[u32].some{i::u32}; }
            }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether a type is a structure, an array or a union made of leaves alone, pushing
# them at the end of out from a byte offset when out is given. a member of no
# bytes has no leaves
# ---
# l:    the layout
# b:    the build's selection
# ty:   the type
# base: the offset of its first byte
# word: the widest word in bytes, which a union's cover is at most
# out:  where its leaves go, nil to ask alone
pub fun scalars(l: *Layout, b: opt[*Basis], ty: Type, base: u64, word: u64, out: *Vector[Leaf]) res[bool, allocator.Error] {
    val res_shape: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel res_shape.err) { ret res[bool, allocator.Error].ok{false}; }
    val shape: table.Shape = res_shape.ok;
    if (sel shape.structure) {
        var i: usize = 0;
        for (i < shape.structure.members.size) {
            val res_offset: res[u64, target_record.Error] = layout.offset(l, ty, table.DEFAULT_SPACE, i::u32);
            if (sel res_offset.err) { ret res[bool, allocator.Error].ok{false}; }
            val res_inner: res[bool, allocator.Error] = member(l, b, shape.structure.members.data[i], base + res_offset.ok, word, out);
            if (sel res_inner.err) { ret res_inner; }
            if (!res_inner.ok)     { ret res_inner; }
            i = i + 1;
        }
        ret res[bool, allocator.Error].ok{true};
    }
    if (sel shape.union) {
        val opt_cover: opt[u32] = cover(l, b, ty, word);
        if (sel opt_cover.none) { ret res[bool, allocator.Error].ok{false}; }
        ret member(l, b, shape.union.members.data[opt_cover.some], base, word, out);
    }
    if (sel shape.array) {
        val res_step: res[u64, target_record.Error] = layout.stride(l, ty, table.DEFAULT_SPACE);
        if (sel res_step.err) { ret res[bool, allocator.Error].ok{false}; }
        var e: u64 = 0;
        for (e < shape.array.count) {
            val res_inner: res[bool, allocator.Error] = member(l, b, shape.array.element, base + e * res_step.ok, word, out);
            if (sel res_inner.err) { ret res_inner; }
            if (!res_inner.ok)     { ret res_inner; }
            e = e + 1;
        }
        ret res[bool, allocator.Error].ok{true};
    }
    ret res[bool, allocator.Error].ok{false};
}

# one member's leaves: none for a member of no bytes, itself for a leaf, and a
# structure's or an array's own
fun member(l: *Layout, b: opt[*Basis], ty: Type, at: u64, word: u64, out: *Vector[Leaf]) res[bool, allocator.Error] {
    val res_size: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    if (sel res_size.err) { ret res[bool, allocator.Error].ok{false}; }
    if (res_size.ok == 0) { ret res[bool, allocator.Error].ok{true}; }
    val opt_one: opt[u64] = scalar(l, b, ty);
    if (sel opt_one.none) { ret scalars(l, b, ty, at, word, out); }
    if (out != nil) {
        val res_pushed: res[usize, allocator.Error] = vector.push[Leaf](out, Leaf{offset: at, ty: ty, size: opt_one.some});
        if (sel res_pushed.err) { ret res[bool, allocator.Error].err{res_pushed.err}; }
    }
    ret res[bool, allocator.Error].ok{true};
}
