# the scalar leaves of an aggregate, which a value of it is built from with
# `insert` and taken apart into with `extract`, so it crosses a call boundary
# with no memory between
#
# a structure's leaves are its members', in member order, and an array's its
# elements', each at its byte offset in the aggregate, as the aggregates
# legalisation orders them. a union's leaf is its cover, the member that holds
# every byte of it as one integer or pointer, so every member reads what the
# cover holds. a leaf is an integer, a pointer or a float of a format the build
# holds, of whole bytes. a type that holds a union with no cover, a vector, a
# function, a handle or a float the build holds no unit for is not made of
# such leaves, since its bytes are read as other types than its own: a vector's
# lanes are the vector legalisation's and an unheld float is the half
# precision legalisation's encoding everywhere but at a boundary.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability.Held;
use mirl.target.layout;
use mirl.target.layout.Layout;
use target_record: mirl.target.record;

# one scalar leaf
# ---
# offset: its byte offset in the aggregate
# ty:     its type
# size:   its bytes
pub rec Leaf {
    offset: u64;
    ty:     Type;
    size:   u64;
}

# the bytes of a type that is one leaf, none for any other type
# ---
# l:  the layout
# b:  the build's selection, which says which float formats it holds
# ty: the type
pub fun scalar(l: *Layout, b: opt[*Basis], ty: Type) opt[u64] {
    val s: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret opt[u64].none{}; }
    val shape: table.Shape = s.ok;
    if (!(sel shape.integer) && !(sel shape.pointer) && !(sel shape.float)) { ret opt[u64].none{}; }
    val size: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    if (sel size.err) { ret opt[u64].none{}; }
    if (sel shape.integer) {
        if (shape.integer.width::u64 != size.ok * 8) { ret opt[u64].none{}; }
    }
    if (sel shape.float) {
        val row: opt[format.Row] = format.row(shape.float.format);
        if (sel row.none)                       { ret opt[u64].none{}; }
        if (row.some.width::u64 != size.ok * 8) { ret opt[u64].none{}; }
        val h: res[opt[*Held], basis.Error] = basis.held(b, ?l.target.caps, shape.float.format);
        if (sel h.err)     { ret opt[u64].none{}; }
        if (sel h.ok.none) { ret opt[u64].none{}; }
    }
    ret opt[u64].some{size.ok};
}

# the cover of a union aligned to its size and of at most a word, the first
# of its members that is an integer or a pointer of every byte of it, by its
# index, none for a union with none or any other type. such a union's bytes
# are one word, which the cover reads whole
pub fun cover(l: *Layout, b: opt[*Basis], ty: Type, word: u64) opt[u32] {
    val s: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret opt[u32].none{}; }
    val shape: table.Shape = s.ok;
    if (!(sel shape.union)) { ret opt[u32].none{}; }
    val size:  res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    val align: res[u64, target_record.Error] = layout.align(l, ty, table.DEFAULT_SPACE);
    if (sel size.err)                          { ret opt[u32].none{}; }
    if (sel align.err)                         { ret opt[u32].none{}; }
    if (size.ok != align.ok || size.ok > word) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < shape.union.members.size) {
        val mt:  Type                          = shape.union.members.data[i];
        val ms:  res[table.Shape, table.Error] = table.shape(l.types, mt);
        val one: opt[u64]                      = scalar(l, b, mt);
        if (sel ms.ok) {
            val whole: bool = !(sel ms.ok.float);
            if (sel one.some) {
                if (whole && one.some == size.ok) { ret opt[u32].some{i::u32}; }
            }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether a type is a structure, an array or a union made of leaves alone, pushing
# them at the end of out from a byte offset when out is given. a member of no
# bytes has no leaves
# ---
# l:    the layout
# b:    the build's selection
# ty:   the type
# base: the offset of its first byte
# word: the widest word in bytes, which a union's cover is at most
# out:  where its leaves go, nil to ask alone
pub fun scalars(l: *Layout, b: opt[*Basis], ty: Type, base: u64, word: u64, out: *Vector[Leaf]) res[bool, allocator.Error] {
    val s: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret res[bool, allocator.Error].ok{false}; }
    val shape: table.Shape = s.ok;
    if (sel shape.structure) {
        var i: usize = 0;
        for (i < shape.structure.members.size) {
            val at: res[u64, target_record.Error] = layout.offset(l, ty, table.DEFAULT_SPACE, i::u32);
            if (sel at.err) { ret res[bool, allocator.Error].ok{false}; }
            val inner: res[bool, allocator.Error] = member(l, b, shape.structure.members.data[i], base + at.ok, word, out);
            if (sel inner.err) { ret inner; }
            if (!inner.ok)     { ret inner; }
            i = i + 1;
        }
        ret res[bool, allocator.Error].ok{true};
    }
    if (sel shape.union) {
        val k: opt[u32] = cover(l, b, ty, word);
        if (sel k.none) { ret res[bool, allocator.Error].ok{false}; }
        ret member(l, b, shape.union.members.data[k.some], base, word, out);
    }
    if (sel shape.array) {
        val step: res[u64, target_record.Error] = layout.stride(l, ty, table.DEFAULT_SPACE);
        if (sel step.err) { ret res[bool, allocator.Error].ok{false}; }
        var e: u64 = 0;
        for (e < shape.array.count) {
            val inner: res[bool, allocator.Error] = member(l, b, shape.array.element, base + e * step.ok, word, out);
            if (sel inner.err) { ret inner; }
            if (!inner.ok)     { ret inner; }
            e = e + 1;
        }
        ret res[bool, allocator.Error].ok{true};
    }
    ret res[bool, allocator.Error].ok{false};
}

# one member's leaves: none for a member of no bytes, itself for a leaf, and a
# structure's or an array's own
fun member(l: *Layout, b: opt[*Basis], ty: Type, at: u64, word: u64, out: *Vector[Leaf]) res[bool, allocator.Error] {
    val size: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    if (sel size.err) { ret res[bool, allocator.Error].ok{false}; }
    if (size.ok == 0) { ret res[bool, allocator.Error].ok{true}; }
    val one: opt[u64] = scalar(l, b, ty);
    if (sel one.none) { ret scalars(l, b, ty, at, word, out); }
    if (out != nil) {
        val pushed: res[usize, allocator.Error] = vector.push[Leaf](out, Leaf{offset: at, ty: ty, size: one.some});
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    ret res[bool, allocator.Error].ok{true};
}
