# text tests of the multiply forms, run through the driver

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use mirl.legal.check_test.check;
use mirl.legal.multiply.MULTIPLY_FORMS;
use targets: mirl.target;
use mirl.target.Products;
use mirl.target.Target;

# the high half of a product of unsigned operands and of signed ones, each written as the product
# of the extended operands shifted down by the width, and the high multiply of signed ones
#[testing]
val BEFORE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @unsigned: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %a = ext.u %x, to i128\n    %b = ext.u %y, to i128\n    %p = mul %a, %b\n    %s = shr.u %p, i128 64\n    %h = trunc %s, to i64\n    ret %h\n}\nfunction @signed: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %a = ext.s %x, to i128\n    %b = ext.s %y, to i128\n    %p = mul %a, %b\n    %s = shr.s %p, i128 64\n    %h = trunc %s, to i64\n    ret %h\n}\nfunction @stated: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %h = mul.high.s %x, %y\n    ret %h\n}\n";

# with no form for it, each is built from multiplies of the halves of the operands, a signed one
# taking away the other operand where one is negative, and a pattern it was written as is left
#[testing]
val AFTER: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @unsigned: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %a = ext.u %x, to i128\n    %b = ext.u %y, to i128\n    %p = mul %a, %b\n    %s = shr.u %p, i128 64\n    %a0 = and %x, i64 4294967295\n    %a1 = shr.u %x, i64 32\n    %b0 = and %y, i64 4294967295\n    %b1 = shr.u %y, i64 32\n    %p00 = mul %a0, %b0\n    %p01 = mul %a0, %b1\n    %p10 = mul %a1, %b0\n    %p11 = mul %a1, %b1\n    %t0 = shr.u %p00, i64 32\n    %mid = add %p10, %t0\n    %t1 = and %mid, i64 4294967295\n    %cross = add %p01, %t1\n    %t2 = shr.u %mid, i64 32\n    %high = add %p11, %t2\n    %carry = shr.u %cross, i64 32\n    %h = add %high, %carry\n    ret %h\n}\nfunction @signed: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %a = ext.s %x, to i128\n    %b = ext.s %y, to i128\n    %p = mul %a, %b\n    %s = shr.s %p, i128 64\n    %a0 = and %x, i64 4294967295\n    %a1 = shr.u %x, i64 32\n    %b0 = and %y, i64 4294967295\n    %b1 = shr.u %y, i64 32\n    %p00 = mul %a0, %b0\n    %p01 = mul %a0, %b1\n    %p10 = mul %a1, %b0\n    %p11 = mul %a1, %b1\n    %t0 = shr.u %p00, i64 32\n    %mid = add %p10, %t0\n    %t1 = and %mid, i64 4294967295\n    %cross = add %p01, %t1\n    %t2 = shr.u %mid, i64 32\n    %high = add %p11, %t2\n    %carry = shr.u %cross, i64 32\n    %sum = add %high, %carry\n    %sx = shr.s %x, i64 63\n    %cx = and %sx, %y\n    %first = sub %sum, %cx\n    %sy = shr.s %y, i64 63\n    %cy = and %sy, %x\n    %h = sub %first, %cy\n    ret %h\n}\nfunction @stated: fun(i64, i64) -> (i64) linkage global visibility default {\n^entry(%x: i64, %y: i64):\n    %a0 = and %x, i64 4294967295\n    %a1 = shr.u %x, i64 32\n    %b0 = and %y, i64 4294967295\n    %b1 = shr.u %y, i64 32\n    %p00 = mul %a0, %b0\n    %p01 = mul %a0, %b1\n    %p10 = mul %a1, %b0\n    %p11 = mul %a1, %b1\n    %t0 = shr.u %p00, i64 32\n    %mid = add %p10, %t0\n    %t1 = and %mid, i64 4294967295\n    %cross = add %p01, %t1\n    %t2 = shr.u %mid, i64 32\n    %high = add %p11, %t2\n    %carry = shr.u %cross, i64 32\n    %sum = add %high, %carry\n    %sx = shr.s %x, i64 63\n    %cx = and %sx, %y\n    %first = sub %sum, %cx\n    %sy = shr.s %y, i64 63\n    %cy = and %sy, %x\n    %h = sub %first, %cy\n    ret %h\n}\n";

test multiply__high_half_is_built_from_the_declared_forms_when_none_is_native {
    val row: opt[*Target] = targets.first(targets.multiplies_wide);
    if (!(sel row.some))                                              { ret 1; }
    if (check(row.some, ?MULTIPLY_FORMS, BEFORE, BEFORE, false) != 0) { ret 2; }
    var bare: Target = @row.some;
    bare.caps.arithmetic.products = Products.none{};
    if (check(?bare, ?MULTIPLY_FORMS, BEFORE, AFTER, true) != 0) { ret 3; }
    ret 0;
}
