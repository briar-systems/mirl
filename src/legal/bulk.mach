# a copy or fill the target cannot do as it stands, made of what it can
#
# the passes that move bytes through memory make a run of word moves up to the
# target's bound and one `mem.copy` or `mem.fill` past it (mirl.legal.moves).
# this pass runs after the last of them. a copy gives its destination the
# bytes its source held before it whether or not the two overlap, so first
# each copy that states neither order is marked with the orders it may run in
# that its addresses show (mirl.legal.overlap). then:
#
# - where the target states an instruction for the operation over known
#   lengths past a floor (`Copy.ascending`, `Bulk.known`), a copy or fill of a
#   known length past that floor, not kept, is left to that instruction
#   (`instructed`), a copy only where it may ascend, as the copy instruction
#   runs from the lowest byte up. at or below the floor the line below is no
#   larger than the instruction. a copy that may only descend or states
#   neither order is moved by units as below.
# - any other copy or fill of a constant length no instruction does whatever
#   the length, not volatile, is moved by units (`rewrite`). the unit
#   is the vector of bytes the build's selection serves for the function, the
#   one a packed loop moves (`packed_lanes`), where the length holds one, and
#   otherwise the widest word at most the length, at most the alignment the
#   operation states where the target carries out no misaligned access. the
#   bytes past the last whole unit are one more unit ending at the length where
#   the target carries out a misaligned access, and aligned words otherwise.
#   where those accesses are at most the target's in-place bound
#   (`BulkMemory.moves`) they stand in a line, every read before every write.
#   otherwise they are a counted loop: one offset, stepping by up to PER_TRIP
#   units a trip between constant bounds, each trip reading its units then
#   writing them, the accesses past the loop read before it and written after
#   it. a fill stores the byte repeated across a unit. a copy runs up from the
#   bottom where it may ascend, down from the top where it may only descend,
#   and otherwise down where the destination lies above the source and up
#   where it does not, chosen by the addresses with no branch. each access of
#   the loop to a frame slot at a constant offset from it states the range of
#   the slot the loop moves (`mirl.ir.metadata.Extent`), the bytes of its
#   trips, so what checks the frame takes the access as reaching that range
#   and a store as writing all of it. a pass that rewrites such a loop keeps
#   each statement true: every byte its access reaches lies in the range, the
#   address is still formed from the slot's alloca through `ptr.add`,
#   `ptr.member` and `ptr.index`, and a stated store's loop still writes every
#   byte of the range before it leaves, else it drops the statement.
# - in a function that requires constant time, a copy or fill of a constant
#   length to or from a frame slot, not volatile, is moved by
#   units as above on every target, whatever instructions the target has, so
#   its loop's accesses state the range of the slot they move. a copy moving a secret
#   from one frame slot to another is first one copy per run of bytes the two
#   slots' public statements agree on, each stated public or secret as its run
#   is, so no loop moves a public byte in the same access as a secret one.
# - where the target carries out a misaligned access and a unit holds a
#   vector of bytes, a copy or fill of a length not known that no instruction
#   does whatever the length (`served`), not volatile, is packed loops: a
#   step moves a vector of the most bytes one piece of that unit holds, up to
#   the length with the bits below that count cleared, made once ahead of the
#   loops, and a step of a byte moves each byte past it. each loop carries its offset alone and is entered past a test that
#   it runs once. a fill, which needs the unit to pack the byte's splat, and a
#   copy that may ascend run up from the bottom, one that may only descend runs
#   down from the top, and one that states neither branches on its addresses to
#   the loop down where the distance from the source up to the destination,
#   taken unsigned, is below the length, and to the loop up otherwise.
#
# a kept fill is moved the same way, and its expansion holds only kept
# stores: each store the pass makes of it carries the kept flag, they write
# exactly the fill's bytes, each at least once and none outside them (the
# overlapping last unit writes some twice, with the same byte, which a kept
# fill allows: it fixes what memory holds after it, not how many writes make
# it), and one of them takes the fill's place, as the ir lets no pass erase a
# kept write. they all stand between the instructions the fill stood
# between, so their order against every other kept write is the fill's. so no
# later pass removes, narrows, merges or forwards them
# (dce, dse, forwarding, promotion and store merging hold a kept store fixed).
# loads are never kept, and a copy is never kept (only stores and fills are
# keepable). a kept fill of no bytes has no store to stand in its place, so it
# stays the helpers legalisation's loop, which runs no trip.
#
# any other of a length not constant, a volatile one and a kept fill no
# unit serves are the helpers legalisation's, whose helpers are safe for any
# overlap. every branch, count and address is made of the
# length and the operands' addresses alone and none of the bytes moved, so the
# pass keeps constant time where the addresses are public. a value it moves is as secret
# as the operation, its addresses, counts and conditions as secret as the
# addresses it is given.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;
use std.collections.vector.Vector;

use core_state: masc.core.state;

use mirl.build.builder;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.contents;
use mirl.ir.function.Body;
use mirl.ir.function.ConstantTime;
use mirl.ir.function.in_constant_time;
use mirl.ir.global.Range;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use Spot: mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Extent;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_EXTENT;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.metadata.NO_PUBLICS;
use mirl.ir.metadata.NO_SLOT;
use mirl.ir.metadata.Publics;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.legal.emit;
use mirl.legal.emit.Lane;
use mirl.legal.moves;
use mirl.legal.overlap;
use mirl.pass.analysis.slots;
use mirl.pass.cache;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.capability;
use mirl.target.capability.Bulk;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Copy;
use mirl.target.capability.LaneType;
use mirl.target.layout;
use mirl.target.layout.Layout;
use units: mirl.target.vector;

# the pass: it splits blocks and adds edges, so it keeps no analysis
pub val BULK: Pass = Pass{name: "bulk", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}, applies: wanted};

# where memory is addressed physically: a copy no one instruction does whatever its ranges are, a fill no one
# instruction does whatever its length, or a copy or fill of a frame slot in a function that requires constant time,
# which is a loop on every target
fun wanted(g: *Ground) bool {
    ret sel g.t.caps.addressing.physical;
}

# one function being rewritten
# ---
# s:          where instructions are made
# caps:       the target's capabilities
# layout:     the target's data layout
# word:       the widest access in bytes, the target's widest arithmetic
# timed:      the function requires constant time
# failed:     the first failure
# misaligned: the target carries out an access below its type's alignment
# moves:      the most accesses the target makes a known copy or fill of in place
# fill_lanes: the bytes of the vector unit of a fill (`packed_lanes`), 0 where none
# copy_lanes: the bytes of the vector unit of a copy, 0 where none
rec Work {
    s:          emit.Site;
    caps:       *Capabilities;
    layout:     Layout;
    word:       u64;
    timed:      bool;
    failed:     opt[refusal.Error];
    misaligned: bool;
    moves:      u64;
    fill_lanes: u32;
    copy_lanes: u32;
}

fun note(w: *Work, why: refusal.Error) {
    val first: bool = sel w.failed.none;
    if (first) { w.failed = opt[refusal.Error].some{why}; }
}

fun body_of(w: *Work) *Body {
    ret w.s.b;
}

fun type_of(w: *Work, x: Value) Type {
    ret w.s.b.values.data[x].type;
}

fun secret(w: *Work, x: Value) bool {
    ret w.s.b.values.data[x].secret;
}

fun block_of(b: *Body, i: Instruction) Block {
    val at: Spot = b.instructions.data[i].place;
    if (sel at.placed) { ret at.placed; }
    ret 0;
}

# the alignment an access states
fun alignment_of(d: *InstructionData) u64 {
    var i: usize = 0;
    for (i < d.immediates.len) {
        val m: Immediate = d.immediates.data[i];
        if (sel m.alignment) { ret m.alignment; }
        i = i + 1;
    }
    ret 1;
}

# the integer of a number of bytes
fun integer(w: *Work, bytes: u64) Type {
    val res_type: res[Type, table.Error] = table.intern(?w.s.m.types, table.Shape.integer{table.Integer{width: (bytes * 8)::u32}});
    if (sel res_type.err) {
        note(w, refusal.Error.ir{module.Error.types{res_type.err}});
        ret 0;
    }
    ret res_type.ok;
}

# a constant of an integer type
fun constant(w: *Work, ty: Type, x: Wide) Value {
    val res_constant: res[Value, refusal.Error] = emit.constant(?w.s, ty, x);
    if (sel res_constant.err) {
        note(w, res_constant.err);
        ret 0;
    }
    ret res_constant.ok;
}

# a constant of a scalar integer type of a width, x taken modulo the width
fun count_of(w: *Work, ty: Type, bits: u32, x: u64) Value {
    var v: u64 = x;
    if (bits < 64) { v = x & ((1u64 << bits::u64) - 1); }
    val res_constant: res[Value, refusal.Error] = emit.word_constant(?w.s, ty, v);
    if (sel res_constant.err) {
        note(w, res_constant.err);
        ret 0;
    }
    ret res_constant.ok;
}

# a word of n bytes each one byte
fun filled(byte: u8, n: u64) Wide {
    var x: Wide = word.zero();
    var k: u64  = 0;
    for (k < n && byte != 0) {
        x[k / 8] = x[k / 8] | (byte::u64 << ((k % 8) * 8));
        k        = k + 1;
    }
    ret x;
}

# what a copy or fill states of the bytes it moves, which each load and store made of it states in turn
# ---
# secret: its secret mark
# public: its public flag
# kept:   its kept flag, which each store states and no load can
rec Stated {
    secret: bool;
    public: bool;
    kept:   bool;
}

fun stated_of(d: *InstructionData) Stated {
    ret Stated{secret: d.metadata.secret, public: d.metadata.flags.public, kept: d.metadata.flags.kept};
}

fun load(w: *Work, address: Value, ty: Type, align: u64, st: Stated, within: Extent) Value {
    var ops: [1]Value     = [1]Value{address};
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{ty}, Immediate.alignment{align}};
    var f:   Flags        = NO_FLAGS;
    f.public = st.public;
    builder.secret(?w.s.bld, st.secret);
    builder.flags(?w.s.bld, f);
    val i: Instruction = emit.emit(?w.s, opcode_table.LOAD, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 2});
    builder.flags(?w.s.bld, NO_FLAGS);
    state(w, i, within);
    ret emit.result(?w.s, i, 0);
}

# a store, in the place of the copy or fill `at` where it is one, which a kept fill leaves only to a kept store
fun store(w: *Work, address: Value, x: Value, align: u64, st: Stated, within: Extent, at: Instruction) {
    var ops: [2]Value     = [2]Value{address, x};
    var imm: [1]Immediate = [1]Immediate{Immediate.alignment{align}};
    var f:   Flags        = NO_FLAGS;
    f.public = st.public;
    f.kept   = st.kept;
    builder.secret(?w.s.bld, st.secret);
    builder.flags(?w.s.bld, f);
    if (at != NO_INSTRUCTION) { builder.replacing(?w.s.bld, at); }
    val i: Instruction = emit.emit(?w.s, opcode_table.STORE, Slice[Value]{data: ?ops[0], size: 2}, Slice[Immediate]{data: ?imm[0], size: 1});
    builder.flags(?w.s.bld, NO_FLAGS);
    state(w, i, within);
}

# the frame extent instruction `i` states, where it was made
fun state(w: *Work, i: Instruction, within: Extent) {
    if (sel w.failed.some || i::usize >= w.s.b.instructions.len) { ret; }
    w.s.b.instructions.data[i].metadata.extent = within;
}

# the range of its frame slot `n` bytes from address `v` cover, none where `v` is formed from no slot at a constant
# offset or the bytes run past it, which a loop moving them through `v` states on each access
fun framed(w: *Work, v: Value, n: u64) Extent {
    val b:        *Body            = body_of(w);
    val opt_slot: opt[Instruction] = slots.slot_of(b, v);
    if (sel opt_slot.none) { ret NO_EXTENT; }
    val opt_offset_in: opt[u64] = slots.offset_in(w.s.m, ?w.layout, b, v);
    val opt_size:      opt[u64] = slots.slot_size(?w.layout, b, opt_slot.some);
    if (sel opt_offset_in.none) { ret NO_EXTENT; }
    if (sel opt_size.none)      { ret NO_EXTENT; }
    val start: u64 = opt_offset_in.some;
    if (n == 0 || n > opt_size.some || start > opt_size.some - n) { ret NO_EXTENT; }
    ret Extent{slot: NO_SLOT, offset: start, length: n};
}

fun no_values() Slice[Value] {
    ret Slice[Value]{data: nil, size: 0};
}

fun no_immediates() Slice[Immediate] {
    ret Slice[Immediate]{data: nil, size: 0};
}

# end the block the builder is at in a branch to a block, passing arguments
fun jump(w: *Work, to: Block, arguments: Slice[Value]) {
    var targets: [1]Branch = [1]Branch{Branch{block: to, arguments: arguments}};
    builder.emit(?w.s.bld, Request{opcode: opcode_table.BR, operands: no_values(), immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 1}});
}

# end the block the builder is at in a branch on a condition, passing
# arguments to the block it takes where the condition holds
fun fork(w: *Work, condition: Value, yes: Block, arguments: Slice[Value], no: Block) {
    var ops:     [1]Value  = [1]Value{condition};
    var targets: [2]Branch = [2]Branch{Branch{block: yes, arguments: arguments}, Branch{block: no, arguments: no_values()}};
    builder.emit(?w.s.bld, Request{opcode: opcode_table.CBR, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 2}});
}

# the value a fill stores in an access of n bytes: the byte repeated, a
# constant where the byte is one
fun repeated(w: *Work, byte: Value, n: u64) Value {
    val ty:       Type     = integer(w, n);
    val opt_byte: opt[u64] = emit.known(?w.s, byte);
    if (sel opt_byte.some) { ret constant(w, ty, filled((opt_byte.some & 0xff)::u8, n)); }
    if (n == 1)            { ret byte; }
    var x:    Value = emit.convert(?w.s, opcode_table.EXT_U, byte, ty);
    var bits: u64   = 8;
    for (bits < n * 8) {
        x    = emit.binary(?w.s, opcode_table.OR, x, emit.binary(?w.s, opcode_table.SHL, x, count_of(w, ty, (n * 8)::u32, bits)));
        bits = bits * 2;
    }
    ret x;
}

# the bytes a copy or fill of a constant length moves where no instruction of
# the target does it whatever the length, not volatile, which this pass moves
# by units or leaves to an instruction stated for it (`instructed`). none for
# any other, which the helpers legalisation takes, and for a kept fill of no
# bytes, which no kept store can stand in place of, so it stays the helpers'
# loop, which runs no trip
pub fun length_of(m: *Module, b: *Body, caps: *Capabilities, d: *InstructionData) opt[u64] {
    if (d.opcode != opcode_table.MEM_COPY && d.opcode != opcode_table.MEM_FILL) { ret opt[u64].none{}; }
    if (served(caps, d))                                                        { ret opt[u64].none{}; }
    if (d.metadata.flags.volatile || d.operands.len != 3)                       { ret opt[u64].none{}; }
    val opt_known: opt[u64] = emit.known_in(m, b, d.operands.data[2]);
    if (sel opt_known.some && opt_known.some == 0 && d.metadata.flags.kept) { ret opt[u64].none{}; }
    ret opt_known;
}

# whether an instruction of the target does a copy or fill as it stands, whatever the length
pub fun served(caps: *Capabilities, d: *InstructionData) bool {
    if (d.opcode == opcode_table.MEM_COPY && sel caps.bulk.copy.whole)  { ret true; }
    if (d.opcode == opcode_table.MEM_FILL && sel caps.bulk.fill.native) { ret true; }
    ret false;
}

# the units one trip of the loop of a known length moves: the trip's add and branch are shared by four accesses, and a
# copy holds four units between its loads and its stores, which every target with a unit has registers for
val PER_TRIP: u64 = 4;

# how a copy or fill of a known length is moved
# ---
# unit:    the bytes of one access of the loop
# vector:  the unit is a vector of bytes, an integer otherwise
# units:   the whole units the length holds
# per:     the units one trip of the loop moves, 0 where no loop is made
# trips:   the trips of the loop
# overlap: the bytes past the last whole unit are one unit that ends at the length
rec Plan {
    unit:    u64;
    vector:  bool;
    units:   u64;
    per:     u64;
    trips:   u64;
    overlap: bool;
}

# one access a copy or fill of a known length makes outside its loop
# ---
# at:    its offset from both addresses
# bytes: the bytes it moves
# unit:  it moves a unit, and a word of `bytes` otherwise
rec Piece {
    at:    u64;
    bytes: u64;
    unit:  bool;
}

# the alignment an access of `n` bytes at offset `at` past an address aligned to `align` states, at most `n`
fun fit(align: u64, at: u64, n: u64) u64 {
    val a: u64 = moves.aligned_at(align, at);
    if (a < n) { ret a; }
    ret n;
}

# the plan of a copy or fill of `length` bytes, at least one, from addresses aligned to `align`. the unit is the byte
# vector the build's selection serves for the function (`packed_lanes`) where the length holds one, otherwise the widest
# word, at most the length, and at most the alignment where the target carries out no misaligned access. the bytes past
# the last whole unit are one unit ending at the length where the target carries out a misaligned access, else the
# aligned words as before. a length whose accesses are at most the target's stated in-place bound (`BulkMemory.moves`)
# is those accesses in a line, the same bound below which the target already makes a known copy or fill in place.
# any longer one is a loop of PER_TRIP units a trip, or of all its units where it holds fewer
fun plan_of(w: *Work, length: u64, align: u64, fill: bool) Plan {
    var p:     Plan;
    var lanes: u32 = w.copy_lanes;
    if (fill) { lanes = w.fill_lanes; }
    if (lanes != 0 && length >= lanes::u64) {
        p.unit   = lanes::u64;
        p.vector = true;
    }
    or (w.misaligned) { p.unit = moves.step(length, w.word, w.word); }
    or                { p.unit = moves.step(length, align, w.word); }
    p.units = length / p.unit;
    val past: u64 = length - p.units * p.unit;
    p.overlap = past != 0 && w.misaligned;
    var accesses: u64 = p.units;
    if (p.overlap) { accesses = accesses + 1; }
    or (past != 0) { accesses = accesses + moves.count(past, moves.aligned_at(align, p.units * p.unit), w.word); }
    if (accesses > w.moves) {
        p.per = PER_TRIP;
        if (p.units < p.per) { p.per = p.units; }
        p.trips = p.units / p.per;
    }
    ret p;
}

# the accesses outside the loop, in order: the whole units past the bytes the loop moves, then the bytes past the
# last whole unit as one overlapping unit or as aligned words
fun pieces_of(w: *Work, p: *Plan, length: u64, align: u64, looped: u64) res[Vector[Piece], refusal.Error] {
    var out:  Vector[Piece] = vector.init[Piece](w.s.scratch);
    var done: u64           = looped;
    for (done + p.unit <= length) {
        val res_unit: res[usize, allocator.Error] = vector.push[Piece](?out, Piece{at: done, bytes: p.unit, unit: true});
        if (sel res_unit.err) { ret res[Vector[Piece], refusal.Error].err{refusal.Error.alloc{res_unit.err}}; }
        done = done + p.unit;
    }
    if (done < length && p.overlap) {
        val res_last: res[usize, allocator.Error] = vector.push[Piece](?out, Piece{at: length - p.unit, bytes: p.unit, unit: true});
        if (sel res_last.err) { ret res[Vector[Piece], refusal.Error].err{refusal.Error.alloc{res_last.err}}; }
        done = length;
    }
    for (done < length) {
        val n:        u64                         = moves.step(length - done, moves.aligned_at(align, done), w.word);
        val res_word: res[usize, allocator.Error] = vector.push[Piece](?out, Piece{at: done, bytes: n, unit: false});
        if (sel res_word.err) { ret res[Vector[Piece], refusal.Error].err{refusal.Error.alloc{res_word.err}}; }
        done = done + n;
    }
    ret res[Vector[Piece], refusal.Error].ok{out};
}

# what one copy or fill of a known length moves, the same for each access of it
# ---
# fill:    it fills, and copies otherwise
# to:      the destination address
# from:    the source address of a copy, the byte of a fill
# lt:      the length's type
# bits:    its width
# align:   the alignment of both addresses
# unit:    the type of a unit
# value:   the unit a fill stores
# moving:  what the operation states of the bytes it moves
# exposed: the offsets and addresses are secret
rec Known {
    fill:    bool;
    to:      Value;
    from:    Value;
    lt:      Type;
    bits:    u32;
    align:   u64;
    unit:    Type;
    value:   Value;
    moving:  Stated;
    exposed: bool;
}

# the value piece `pc` writes: a fill's unit or byte repeated, a copy's load of its source
fun read_piece(w: *Work, kn: *Known, pc: Piece) Value {
    if (kn.fill) {
        if (pc.unit) { ret kn.value; }
        builder.secret(?w.s.bld, secret(w, kn.from));
        ret repeated(w, kn.from, pc.bytes);
    }
    var ty: Type = integer(w, pc.bytes);
    if (pc.unit) { ty = kn.unit; }
    builder.secret(?w.s.bld, kn.exposed);
    val address: Value = emit.binary(?w.s, opcode_table.PTR_ADD, kn.from, count_of(w, kn.lt, kn.bits, pc.at));
    val x:       Value = load(w, address, ty, fit(kn.align, pc.at, pc.bytes), kn.moving, NO_EXTENT);
    builder.secret(?w.s.bld, kn.exposed);
    ret x;
}

fun write_piece(w: *Work, kn: *Known, pc: Piece, x: Value, at: Instruction) {
    builder.secret(?w.s.bld, kn.exposed);
    val address: Value = emit.binary(?w.s, opcode_table.PTR_ADD, kn.to, count_of(w, kn.lt, kn.bits, pc.at));
    store(w, address, x, fit(kn.align, pc.at, pc.bytes), kn.moving, NO_EXTENT, at);
    builder.secret(?w.s.bld, kn.exposed);
}

# read every piece, then write them, so no piece is written before each is read, the last write in the place of `at`
# where it is the copy or fill
fun move_pieces(w: *Work, kn: *Known, pieces: *Vector[Piece], read: bool, write: bool, values: *Vector[Value], at: Instruction) err[refusal.Error] {
    var k: usize = 0;
    for (read && k < pieces.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[Value](values, read_piece(w, kn, pieces.data[k]));
        if (sel res_pushed.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
        k = k + 1;
    }
    k = 0;
    for (write && k < pieces.len) {
        var place: Instruction = NO_INSTRUCTION;
        if (k + 1 == pieces.len) { place = at; }
        write_piece(w, kn, pieces.data[k], values.data[k], place);
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# the address `bytes` past `base`, `base` itself at none, each unit of a trip addressed off the trip's one address
fun unit_at(w: *Work, kn: *Known, base: Value, bytes: u64) Value {
    if (bytes == 0) { ret base; }
    builder.secret(?w.s.bld, kn.exposed);
    ret emit.binary(?w.s, opcode_table.PTR_ADD, base, count_of(w, kn.lt, kn.bits, bytes));
}

# the unit a fill stores where the builder is: the byte's splat in a vector unit, the byte repeated in a word
fun filling(w: *Work, kn: *Known, p: *Plan) {
    if (!kn.fill) { ret; }
    builder.secret(?w.s.bld, secret(w, kn.from));
    if (p.vector) { kn.value = splat(w, kn.from, kn.unit); }
    or            { kn.value = repeated(w, kn.from, p.unit); }
}

# the vector of type `ty` of a fill's byte in every lane. a known byte is splat from a constant of its own, which is
# public as the constant `repeated` makes of it is, the bits being known before the function runs
fun splat(w: *Work, byte: Value, ty: Type) Value {
    val opt_byte: opt[u64] = emit.known(?w.s, byte);
    if (sel opt_byte.none) {
        builder.secret(?w.s.bld, secret(w, byte));
        ret emit.convert(?w.s, opcode_table.VSPLAT, byte, ty);
    }
    val own: Value = constant(w, integer(w, 1), filled((opt_byte.some & 0xff)::u8, 1));
    builder.secret(?w.s.bld, false);
    ret emit.convert(?w.s, opcode_table.VSPLAT, own, ty);
}

# one copy or fill of a known length in its place, by its plan (`plan_of`). in a line: every piece read, then every
# piece written. as a loop: one offset, the only value the loop carries, starts at the first trip's and steps by a
# trip's bytes until it equals the end, both constants the plan decides or chosen by the addresses with no branch for
# a copy that states neither order. a trip reads its units, then writes them, and the pieces past the loop are read
# before it and written after it.
#
# why a copy is right whatever its ranges: each byte of the destination is written last by an access that read its
# source byte before any write of the copy reached it. in a line every read precedes every write. a trip of a copy
# that may ascend runs up, so its writes reach no source byte a later trip reads, as the destination lies at or
# below the source. one that may descend runs down, its mirror. the pieces past the loop, the overlapping unit among
# them, are read before the loop's first write and written after its last, so a byte the loop and that unit both
# write is given its source byte by each
fun rewrite(w: *Work, i: Instruction, length: u64) err[refusal.Error] {
    val b:     *Body            = body_of(w);
    val d:     *InstructionData = ?b.instructions.data[i];
    val align: u64              = alignment_of(d);
    val up:    bool             = d.metadata.flags.ascending;
    val down:  bool             = d.metadata.flags.descending;
    var kn:    Known;
    kn.fill   = d.opcode == opcode_table.MEM_FILL;
    kn.to     = d.operands.data[0];
    kn.from   = d.operands.data[1];
    kn.lt     = type_of(w, d.operands.data[2]);
    kn.align  = align;
    kn.moving = stated_of(d);
    if (length == 0) { ret refusal.edit(body.erase(w.s.m, w.s.f, i)); }
    val res_lane: res[opt[Lane], refusal.Error] = emit.lane_of(w.s.m, kn.lt);
    if (sel res_lane.err)     { ret err[refusal.Error].err{res_lane.err}; }
    if (sel res_lane.ok.none) { ret err[refusal.Error].err{refusal.Error.reason{"a copy or fill whose length is no integer"}}; }
    kn.bits = res_lane.ok.some.bits;
    var p: Plan = plan_of(w, length, align, kn.fill);
    kn.unit = integer(w, p.unit);
    if (p.vector) {
        val res_vector: res[Type, table.Error] = table.intern(?w.s.m.types, table.Shape.vector{table.Vector{lanes: p.unit::u32, element: integer(w, 1)}});
        if (sel res_vector.err) { ret err[refusal.Error].err{refusal.Error.ir{module.Error.types{res_vector.err}}}; }
        kn.unit = res_vector.ok;
    }
    kn.exposed = secret(w, kn.to) || (!kn.fill && secret(w, kn.from));
    val looped:     u64                               = p.trips * p.per * p.unit;
    val res_pieces: res[Vector[Piece], refusal.Error] = pieces_of(w, ?p, length, align, looped);
    if (sel res_pieces.err) { ret err[refusal.Error].err{res_pieces.err}; }
    var pieces: Vector[Piece] = res_pieces.ok;
    var values: Vector[Value] = vector.init[Value](w.s.scratch);

    builder.derive(?w.s.bld, i);
    if (p.per == 0) {
        builder.before(?w.s.bld, i);
        filling(w, ?kn, ?p);
        val err_line: err[refusal.Error] = move_pieces(w, ?kn, ?pieces, true, true, ?values, i);
        if (sel err_line.err)  { ret err_line; }
        if (sel w.failed.some) { ret err[refusal.Error].err{w.failed.some}; }
        ret emit.done(?w.s);
    }

    var decl:      [1]Declaration     = [1]Declaration{Declaration{type: kn.lt, secret: kn.exposed, name: opt[View].none{}}};
    val k:         Block              = block_of(b, i);
    val step:      Block              = builder.block(?w.s.bld, Slice[Declaration]{data: ?decl[0], size: 1});
    val rest:      Block              = builder.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
    val err_split: err[refusal.Error] = emit.done(?w.s);
    if (sel err_split.err) { ret err_split; }
    val err_moved: err[refusal.Error] = refusal.edit(body.move(w.s.m, w.s.f, k, i, step));
    if (sel err_moved.err) { ret err_moved; }
    val err_after: err[refusal.Error] = refusal.edit(body.move(w.s.m, w.s.f, step, b.instructions.data[i].next, rest));
    if (sel err_after.err) { ret err_after; }

    builder.at_end(?w.s.bld, k);
    filling(w, ?kn, ?p);
    # a copy whose ranges may overlap reads the pieces past the loop before it. a fill, and a copy stating both orders,
    # whose ranges do not overlap, reads them after it, so no value lives across the loop
    val early:    bool               = !kn.fill && !(up && down);
    val err_read: err[refusal.Error] = move_pieces(w, ?kn, ?pieces, early, false, ?values, NO_INSTRUCTION);
    if (sel err_read.err) { ret err_read; }
    builder.secret(?w.s.bld, kn.exposed);
    val trip:  u64   = p.per * p.unit;
    var first: Value = count_of(w, kn.lt, kn.bits, 0);
    var delta: Value = count_of(w, kn.lt, kn.bits, trip);
    var end:   Value = count_of(w, kn.lt, kn.bits, looped);
    if (!kn.fill && !up && down) {
        first = count_of(w, kn.lt, kn.bits, looped - trip);
        delta = count_of(w, kn.lt, kn.bits, 0 - trip);
        end   = count_of(w, kn.lt, kn.bits, 0 - trip);
    }
    or (!kn.fill && !up) {
        # all ones where the destination lies above the source, which starts at the last trip and steps down
        val above: Value = emit.binary(?w.s, opcode_table.GT_U, emit.convert(?w.s, opcode_table.PTRTOINT, kn.to, kn.lt), emit.convert(?w.s, opcode_table.PTRTOINT, kn.from, kn.lt));
        val mask:  Value = emit.convert(?w.s, opcode_table.EXT_S, above, kn.lt);
        first = emit.binary(?w.s, opcode_table.AND, count_of(w, kn.lt, kn.bits, looped - trip), mask);
        delta = emit.binary(?w.s, opcode_table.SUB, emit.binary(?w.s, opcode_table.XOR, delta, mask), mask);
        end   = emit.binary(?w.s, opcode_table.ADD, first, emit.binary(?w.s, opcode_table.SUB, emit.binary(?w.s, opcode_table.XOR, end, mask), mask));
    }
    var start: [1]Value = [1]Value{first};
    jump(w, step, one(?start[0]));

    builder.at_start(?w.s.bld, step);
    builder.secret(?w.s.bld, kn.exposed);
    val offset: Value    = builder.parameter(?w.s.bld, step, 0);
    var units:  [4]Value = [4]Value{0, 0, 0, 0};
    val inner:  u64      = fit(align, 0, p.unit);
    var source: Value    = 0;
    if (!kn.fill) { source = emit.binary(?w.s, opcode_table.PTR_ADD, kn.from, offset); }
    val target: Value = emit.binary(?w.s, opcode_table.PTR_ADD, kn.to, offset);
    var j:      u64   = 0;
    for (j < p.per) {
        units[j] = kn.value;
        if (!kn.fill) {
            builder.secret(?w.s.bld, kn.exposed);
            units[j] = load(w, unit_at(w, ?kn, source, j * p.unit), kn.unit, inner, kn.moving, framed(w, kn.from, looped));
        }
        j = j + 1;
    }
    j = 0;
    for (j < p.per) {
        builder.secret(?w.s.bld, kn.exposed);
        var place: Instruction = NO_INSTRUCTION;
        if (j == 0) { place = i; }
        store(w, unit_at(w, ?kn, target, j * p.unit), units[j], inner, kn.moving, framed(w, kn.to, looped), place);
        j = j + 1;
    }
    builder.secret(?w.s.bld, kn.exposed);
    builder.at_end(?w.s.bld, step);
    var next: [1]Value = [1]Value{emit.binary(?w.s, opcode_table.ADD, offset, delta)};
    fork(w, emit.binary(?w.s, opcode_table.NE, next[0], end), step, one(?next[0]), rest);

    builder.at_start(?w.s.bld, rest);
    val err_write: err[refusal.Error] = move_pieces(w, ?kn, ?pieces, !early, true, ?values, NO_INSTRUCTION);
    if (sel err_write.err) { ret err_write; }
    if (sel w.failed.some) { ret err[refusal.Error].err{w.failed.some}; }
    ret emit.done(?w.s);
}

# whether byte `at` of the slot of alloca `slot` is one its statement states public
fun stated_public(w: *Work, slot: Instruction, at: u64) bool {
    val p: Publics = w.s.b.instructions.data[slot].metadata.publics;
    if (p == NO_PUBLICS) { ret false; }
    val res_ranges: res[Slice[Range], module.Error] = module.public_ranges(w.s.m, p);
    if (sel res_ranges.err) { ret false; }
    var k: usize = 0;
    for (k < res_ranges.ok.size) {
        val r: Range = res_ranges.ok.data[k];
        if (at >= r.offset && at - r.offset < r.length) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether byte `k` of a copy from byte `from` of slot `source` to byte `to` of slot `target` is public in both
fun public_byte(w: *Work, target: Instruction, to: u64, source: Instruction, from: u64, k: u64) bool {
    ret stated_public(w, target, to + k) && stated_public(w, source, from + k);
}

# copy `i` of `length` bytes moving a secret between two frame slots of a function that requires constant time made one
# copy per run of the bytes both slots' statements agree are public or not, each stated as its run is, so the loop each
# is made of reads and writes bytes of one secrecy and a public member stays public past it. any other is one loop
fun runs(w: *Work, i: Instruction, length: u64) err[refusal.Error] {
    val b: *Body            = body_of(w);
    val d: *InstructionData = ?b.instructions.data[i];
    if (!w.timed || d.opcode != opcode_table.MEM_COPY || !d.metadata.secret) { ret rewrite(w, i, length); }
    val to:            Value            = d.operands.data[0];
    val from:          Value            = d.operands.data[1];
    val opt_target:    opt[Instruction] = slots.slot_of(b, to);
    val opt_source:    opt[Instruction] = slots.slot_of(b, from);
    val opt_target_at: opt[u64]         = slots.offset_in(w.s.m, ?w.layout, b, to);
    val opt_source_at: opt[u64]         = slots.offset_in(w.s.m, ?w.layout, b, from);
    if (sel opt_target.none)    { ret rewrite(w, i, length); }
    if (sel opt_source.none)    { ret rewrite(w, i, length); }
    if (sel opt_target_at.none) { ret rewrite(w, i, length); }
    if (sel opt_source_at.none) { ret rewrite(w, i, length); }
    val target: Instruction = opt_target.some;
    val source: Instruction = opt_source.some;
    if (target == source) { ret rewrite(w, i, length); }
    var cuts: Vector[u64] = vector.init[u64](w.s.scratch);
    var k:    u64         = 1;
    for (k < length) {
        if (public_byte(w, target, opt_target_at.some, source, opt_source_at.some, k) != public_byte(w, target, opt_target_at.some, source, opt_source_at.some, k - 1)) {
            val res_cut: res[usize, allocator.Error] = vector.push[u64](?cuts, k);
            if (sel res_cut.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_cut.err}}; }
        }
        k = k + 1;
    }
    if (cuts.len == 0) { ret rewrite(w, i, length); }
    val res_cut: res[usize, allocator.Error] = vector.push[u64](?cuts, length);
    if (sel res_cut.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_cut.err}}; }
    val lt:       Type                          = type_of(w, d.operands.data[2]);
    val align:    u64                           = alignment_of(d);
    val marks:    Flags                         = d.metadata.flags;
    val exposed:  bool                          = secret(w, to) || secret(w, from);
    val res_lane: res[opt[Lane], refusal.Error] = emit.lane_of(w.s.m, lt);
    if (sel res_lane.err)     { ret err[refusal.Error].err{res_lane.err}; }
    if (sel res_lane.ok.none) { ret err[refusal.Error].err{refusal.Error.reason{"a copy whose length is no integer"}}; }
    val bits: u32 = res_lane.ok.some.bits;

    builder.derive(?w.s.bld, i);
    builder.before(?w.s.bld, i);
    var pieces: Vector[Instruction] = vector.init[Instruction](w.s.scratch);
    var start:  u64                 = 0;
    var c:      usize               = 0;
    for (c < cuts.len) {
        val end:    u64  = cuts.data[c];
        val public: bool = public_byte(w, target, opt_target_at.some, source, opt_source_at.some, start);
        builder.flags(?w.s.bld, NO_FLAGS);
        builder.secret(?w.s.bld, exposed);
        var ops: [3]Value = [3]Value{emit.binary(?w.s, opcode_table.PTR_ADD, to, count_of(w, lt, bits, start)), emit.binary(?w.s, opcode_table.PTR_ADD, from, count_of(w, lt, bits, start)), count_of(w, lt, bits, end - start)};
        var run: Flags    = marks;
        run.public = public;
        builder.flags(?w.s.bld, run);
        builder.secret(?w.s.bld, !public);
        var imm:        [1]Immediate                = [1]Immediate{Immediate.alignment{moves.aligned_at(align, start)}};
        val piece:      Instruction                 = emit.emit(?w.s, opcode_table.MEM_COPY, Slice[Value]{data: ?ops[0], size: 3}, Slice[Immediate]{data: ?imm[0], size: 1});
        val res_pushed: res[usize, allocator.Error] = vector.push[Instruction](?pieces, piece);
        if (sel res_pushed.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
        start = end;
        c     = c + 1;
    }
    builder.flags(?w.s.bld, NO_FLAGS);
    if (sel w.failed.some) { ret err[refusal.Error].err{w.failed.some}; }
    val err_erased: err[refusal.Error] = refusal.edit(body.erase(w.s.m, w.s.f, i));
    if (sel err_erased.err) { ret err_erased; }
    val err_done: err[refusal.Error] = emit.done(?w.s);
    if (sel err_done.err) { ret err_done; }
    start = 0;
    c     = 0;
    for (c < pieces.len) {
        val err_run: err[refusal.Error] = rewrite(w, pieces.data[c], cuts.data[c] - start);
        if (sel err_run.err) { ret err_run; }
        start = cuts.data[c];
        c     = c + 1;
    }
    ret err[refusal.Error].ok{};
}

# end the block the builder is at in a branch on a condition, passing each
# block it may take its arguments
fun branch(w: *Work, condition: Value, yes: Block, taken: Slice[Value], no: Block, left: Slice[Value]) {
    var ops:     [1]Value  = [1]Value{condition};
    var targets: [2]Branch = [2]Branch{Branch{block: yes, arguments: taken}, Branch{block: no, arguments: left}};
    builder.emit(?w.s.bld, Request{opcode: opcode_table.CBR, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 2}});
}

# the one value at `x`, as a slice
fun one(x: *Value) Slice[Value] {
    ret Slice[Value]{data: x, size: 1};
}

# one packed loop's operation: what it moves and how each access states it
# ---
# fill:    it fills, from `value`, and copies from `from` otherwise
# to:      the destination address
# from:    the source address of a copy
# value:   the byte a fill stores
# splat:   the vector of that byte a fill stores a vector of
# lt:      the length's type
# bits:    its width
# vector:  the type of a vector of bytes
# lanes:   the bytes the vector holds
# moving:  what the operation states of the bytes it moves
# exposed: the counts and addresses are secret
rec Packed {
    fill:    bool;
    to:      Value;
    from:    Value;
    value:   Value;
    splat:   Value;
    lt:      Type;
    bits:    u32;
    vector:  Type;
    lanes:   u32;
    moving:  Stated;
    exposed: bool;
}

# move the vector or the byte at offset `at` past each address, reading it
# before it writes it
fun move_at(w: *Work, pk: *Packed, at: Value, whole: bool, place: Instruction) {
    var ty: Type = integer(w, 1);
    if (whole) { ty = pk.vector; }
    var x: Value = pk.value;
    if (whole) { x = pk.splat; }
    builder.secret(?w.s.bld, pk.exposed);
    if (!pk.fill) {
        val source: Value = emit.binary(?w.s, opcode_table.PTR_ADD, pk.from, at);
        x = load(w, source, ty, 1, pk.moving, NO_EXTENT);
        builder.secret(?w.s.bld, pk.exposed);
    }
    val target: Value = emit.binary(?w.s, opcode_table.PTR_ADD, pk.to, at);
    store(w, target, x, 1, pk.moving, NO_EXTENT, place);
    builder.secret(?w.s.bld, pk.exposed);
}

# the loop up from the bottom: a vector a step from offset 0 up to `whole`, the length less the bytes past its last
# whole vector, then a byte a step up to the length, then on to `rest`. each loop carries its offset alone and ends
# where it equals its bound, a value made once ahead of it
fun upward(w: *Work, pk: *Packed, length: Value, whole: Value, entry: Block, step: Block, check: Block, byte: Block, rest: Block, place: Instruction) {
    builder.at_end(?w.s.bld, entry);
    builder.secret(?w.s.bld, pk.exposed);
    var zero: Value = count_of(w, pk.lt, pk.bits, 0);
    branch(w, emit.binary(?w.s, opcode_table.NE, whole, zero), step, one(?zero), check, no_values());

    builder.at_start(?w.s.bld, step);
    val at: Value = builder.parameter(?w.s.bld, step, 0);
    move_at(w, pk, at, true, place);
    var next: Value = emit.binary(?w.s, opcode_table.ADD, at, count_of(w, pk.lt, pk.bits, pk.lanes::u64));
    branch(w, emit.binary(?w.s, opcode_table.NE, next, whole), step, one(?next), check, no_values());

    builder.at_end(?w.s.bld, check);
    builder.secret(?w.s.bld, pk.exposed);
    var from: Value = whole;
    branch(w, emit.binary(?w.s, opcode_table.NE, whole, length), byte, one(?from), rest, no_values());

    builder.at_end(?w.s.bld, byte);
    val b: Value = builder.parameter(?w.s.bld, byte, 0);
    move_at(w, pk, b, false, NO_INSTRUCTION);
    var after: Value = emit.binary(?w.s, opcode_table.ADD, b, count_of(w, pk.lt, pk.bits, 1));
    branch(w, emit.binary(?w.s, opcode_table.NE, after, length), byte, one(?after), rest, no_values());
}

# the loop down from the top: a byte a step from the length down to `whole`, then a vector a step down to 0, then on
# to `rest`, each loop carrying its offset alone
fun downward(w: *Work, pk: *Packed, length: Value, whole: Value, entry: Block, byte: Block, check: Block, step: Block, rest: Block, place: Instruction) {
    builder.at_end(?w.s.bld, entry);
    builder.secret(?w.s.bld, pk.exposed);
    var top: Value = length;
    branch(w, emit.binary(?w.s, opcode_table.NE, length, whole), byte, one(?top), check, no_values());

    builder.at_end(?w.s.bld, byte);
    builder.secret(?w.s.bld, pk.exposed);
    var b: Value = emit.binary(?w.s, opcode_table.SUB, builder.parameter(?w.s.bld, byte, 0), count_of(w, pk.lt, pk.bits, 1));
    move_at(w, pk, b, false, NO_INSTRUCTION);
    branch(w, emit.binary(?w.s, opcode_table.NE, b, whole), byte, one(?b), check, no_values());

    builder.at_end(?w.s.bld, check);
    builder.secret(?w.s.bld, pk.exposed);
    var end: Value = whole;
    branch(w, emit.binary(?w.s, opcode_table.NE, whole, count_of(w, pk.lt, pk.bits, 0)), step, one(?end), rest, no_values());

    builder.at_start(?w.s.bld, step);
    builder.secret(?w.s.bld, pk.exposed);
    var v: Value = emit.binary(?w.s, opcode_table.SUB, builder.parameter(?w.s.bld, step, 0), count_of(w, pk.lt, pk.bits, pk.lanes::u64));
    move_at(w, pk, v, true, place);
    branch(w, emit.binary(?w.s, opcode_table.NE, v, count_of(w, pk.lt, pk.bits, 0)), step, one(?v), rest, no_values());
}

# a copy or fill of a length not known as packed loops in its place: a step moves `lanes` bytes as one vector up to
# `whole`, the length with the bits below `lanes` cleared, made once ahead of the loops, and a step of a byte moves each
# byte past it. a fill and a copy that may ascend run up from the bottom, one that may only descend runs down from the
# top, the bytes past the last whole vector first, and one that states neither branches on its addresses to the loop
# down where the distance from the source up to the destination, taken unsigned, is below the length, and to the loop
# up otherwise. each step reads what it moves before it writes it, so the order taken gives the destination the bytes
# the source held. each loop is entered past a test that it runs at least once, so its step ends in the test of its
# offset against its bound alone
fun packed(w: *Work, i: Instruction, lanes: u32) err[refusal.Error] {
    val b:        *Body                         = body_of(w);
    val d:        *InstructionData              = ?b.instructions.data[i];
    val length:   Value                         = d.operands.data[2];
    val lt:       Type                          = type_of(w, length);
    val res_lane: res[opt[Lane], refusal.Error] = emit.lane_of(w.s.m, lt);
    if (sel res_lane.err)     { ret err[refusal.Error].err{res_lane.err}; }
    if (sel res_lane.ok.none) { ret err[refusal.Error].err{refusal.Error.reason{"a copy or fill whose length is no integer"}}; }
    var pk: Packed;
    pk.fill    = d.opcode == opcode_table.MEM_FILL;
    pk.to      = d.operands.data[0];
    pk.from    = d.operands.data[1];
    pk.value   = d.operands.data[1];
    pk.lt      = lt;
    pk.bits    = res_lane.ok.some.bits;
    pk.lanes   = lanes;
    pk.moving  = stated_of(d);
    pk.exposed = secret(w, pk.to) || secret(w, length) || (!pk.fill && secret(w, pk.from));
    val res_vector: res[Type, table.Error] = table.intern(?w.s.m.types, table.Shape.vector{table.Vector{lanes: lanes, element: integer(w, 1)}});
    if (sel res_vector.err) { ret err[refusal.Error].err{refusal.Error.ir{module.Error.types{res_vector.err}}}; }
    pk.vector = res_vector.ok;
    val up:   bool = pk.fill || d.metadata.flags.ascending;
    val down: bool = !up && d.metadata.flags.descending;

    builder.derive(?w.s.bld, i);
    var decl:     [1]Declaration     = [1]Declaration{Declaration{type: lt, secret: pk.exposed, name: opt[View].none{}}};
    val one_decl: Slice[Declaration] = Slice[Declaration]{data: ?decl[0], size: 1};
    val no_decl:  Slice[Declaration] = Slice[Declaration]{data: nil, size: 0};
    val k:        Block              = block_of(b, i);
    val rest:     Block              = builder.block(?w.s.bld, no_decl);
    var ups:      [4]Block           = [4]Block{0, 0, 0, 0};
    var downs:    [4]Block           = [4]Block{0, 0, 0, 0};
    if (!down) {
        ups[0] = builder.block(?w.s.bld, no_decl);
        ups[1] = builder.block(?w.s.bld, one_decl);
        ups[2] = builder.block(?w.s.bld, no_decl);
        ups[3] = builder.block(?w.s.bld, one_decl);
    }
    if (!up) {
        downs[0] = builder.block(?w.s.bld, no_decl);
        downs[1] = builder.block(?w.s.bld, one_decl);
        downs[2] = builder.block(?w.s.bld, no_decl);
        downs[3] = builder.block(?w.s.bld, one_decl);
    }
    # the copy or fill goes to the step of whole units of the loop it may run first, whose first store takes its place
    var held: Block = downs[3];
    if (!down) { held = ups[1]; }
    val err_split: err[refusal.Error] = emit.done(?w.s);
    if (sel err_split.err) { ret err_split; }
    val err_moved: err[refusal.Error] = refusal.edit(body.move(w.s.m, w.s.f, k, i, held));
    if (sel err_moved.err) { ret err_moved; }
    val err_after: err[refusal.Error] = refusal.edit(body.move(w.s.m, w.s.f, held, b.instructions.data[i].next, rest));
    if (sel err_after.err) { ret err_after; }

    builder.at_end(?w.s.bld, k);
    if (pk.fill) { pk.splat = splat(w, pk.value, pk.vector); }
    builder.secret(?w.s.bld, pk.exposed);
    val whole: Value = emit.binary(?w.s, opcode_table.AND, length, count_of(w, lt, pk.bits, 0 - lanes::u64));
    if (up)   { jump(w, ups[0], no_values()); }
    or (down) { jump(w, downs[0], no_values()); }
    or {
        val distance: Value = emit.binary(?w.s, opcode_table.SUB, emit.convert(?w.s, opcode_table.PTRTOINT, pk.to, lt), emit.convert(?w.s, opcode_table.PTRTOINT, pk.from, lt));
        fork(w, emit.binary(?w.s, opcode_table.LT_U, distance, length), downs[0], no_values(), ups[0]);
    }
    var up_place:   Instruction = NO_INSTRUCTION;
    var down_place: Instruction = NO_INSTRUCTION;
    if (!down)             { up_place = i; }
    or                     { down_place = i; }
    if (!down)             { upward(w, ?pk, length, whole, ups[0], ups[1], ups[2], ups[3], rest, up_place); }
    if (!up)               { downward(w, ?pk, length, whole, downs[0], downs[1], downs[2], downs[3], rest, down_place); }
    if (sel w.failed.some) { ret err[refusal.Error].err{w.failed.some}; }
    ret emit.done(?w.s);
}

# more bytes than any unit holds in one piece, so a split of them gives the
# widest piece
val BYTE_LANES: u32 = 256;

# the lanes of the byte vector a copy or fill of a length not known moves a
# step at a time: the most bytes one piece of the unit the build splits a
# vector of bytes to holds, where the target carries out a misaligned access
# and the count is a power of two, and for a fill where function `f` packs
# the byte's splat. 0 where no unit holds one, and the helpers legalisation
# calls the helper
pub fun packed_lanes(c: *Context, f: Function, fill: bool) u32 {
    if (!c.t.misaligned || !(sel c.t.caps.addressing.physical)) { ret 0; }
    val time:      ConstantTime                  = c.m.functions.data[f].data.constant_time;
    val res_split: res[units.Split, units.Error] = units.split_for(c.basis, time, ?c.t.caps, LaneType.integer{8}, BYTE_LANES);
    if (!(sel res_split.ok))        { ret 0; }
    if (!(sel res_split.ok.pieces)) { ret 0; }
    val n: u32 = res_split.ok.pieces.lanes;
    if (n < 2 || (n & (n - 1)) != 0) { ret 0; }
    if (fill) {
        val res_splat: res[bool, units.Error] = units.packed(c.basis, time, res_split.ok.pieces.unit, opcode_table.VSPLAT, LaneType.integer{8}, LaneType.integer{8});
        if (!(sel res_splat.ok)) { ret 0; }
        if (!res_splat.ok)       { ret 0; }
    }
    ret n;
}

# whether a copy or fill is one a packed loop moves: of a length not known,
# not volatile, on a build with a byte vector
pub fun packs(c: *Context, f: Function, b: *Body, d: *InstructionData) bool {
    if (d.opcode != opcode_table.MEM_COPY && d.opcode != opcode_table.MEM_FILL) { ret false; }
    if (d.metadata.flags.volatile || d.operands.len != 3)                       { ret false; }
    if (d.opcode == opcode_table.MEM_COPY && sel c.t.caps.bulk.copy.whole)      { ret false; }
    if (d.opcode == opcode_table.MEM_FILL && sel c.t.caps.bulk.fill.native)     { ret false; }
    val opt_known: opt[u64] = emit.known_in(c.m, b, d.operands.data[2]);
    if (sel opt_known.some) { ret false; }
    ret packed_lanes(c, f, d.opcode == opcode_table.MEM_FILL) != 0;
}

# mark a copy with the orders its addresses show it may run in, which a copy
# that states both already has
fun mark(w: *Work, i: Instruction) {
    val b: *Body            = body_of(w);
    val d: *InstructionData = ?b.instructions.data[i];
    if (d.metadata.flags.ascending && d.metadata.flags.descending) { ret; }
    val orders: Flags = overlap.order(w.s.m, b, ?w.layout, d.operands.data[0], d.operands.data[1], emit.known_in(w.s.m, b, d.operands.data[2]));
    if (orders.ascending)  { d.metadata.flags.ascending = true; }
    if (orders.descending) { d.metadata.flags.descending = true; }
}

# what the pass does with one instruction
# ---
# loop:   a copy or fill of this many bytes moved by units
# packed: a copy or fill of a length not known made packed loops of vectors
#         of this many bytes
tag Item: u8 {
    loop:   u64;
    packed: u32;
}

# the bytes a copy or fill of a function that requires constant time moves to or from a frame slot, of a constant
# length, not volatile, which is a loop on every target so each access of it states the range of the slot
# it moves (`framed`) and the slot keeps its address in. none for any other
fun framed_length(w: *Work, b: *Body, d: *InstructionData) opt[u64] {
    if (!w.timed)                                                               { ret opt[u64].none{}; }
    if (d.opcode != opcode_table.MEM_COPY && d.opcode != opcode_table.MEM_FILL) { ret opt[u64].none{}; }
    if (d.metadata.flags.volatile || d.operands.len != 3)                       { ret opt[u64].none{}; }
    val opt_length: opt[u64] = emit.known_in(w.s.m, b, d.operands.data[2]);
    if (sel opt_length.none) { ret opt_length; }
    val n: u64 = opt_length.some;
    if (framed(w, d.operands.data[0], n).length != 0) { ret opt_length; }
    if (d.opcode == opcode_table.MEM_COPY) {
        if (framed(w, d.operands.data[1], n).length != 0) { ret opt_length; }
    }
    ret opt[u64].none{};
}

# the floor past which the target states its instruction for a copy or fill of a known length, a copy's only where it
# may ascend. none where it states none
fun floor_of(caps: *Capabilities, d: *InstructionData) opt[u64] {
    if (d.opcode == opcode_table.MEM_COPY && d.metadata.flags.ascending) {
        val copy: Copy = caps.bulk.copy;
        if (sel copy.ascending) { ret opt[u64].some{copy.ascending}; }
    }
    if (d.opcode == opcode_table.MEM_FILL) {
        val fill: Bulk = caps.bulk.fill;
        if (sel fill.known) { ret opt[u64].some{fill.known}; }
    }
    ret opt[u64].none{};
}

# whether a copy or fill of `length` bytes, not kept, is the instruction the target states for it: past its floor, a
# copy only where it may ascend
fun instructed(caps: *Capabilities, d: *InstructionData, length: u64) bool {
    if (d.metadata.flags.kept) { ret false; }
    val opt_floor: opt[u64] = floor_of(caps, d);
    ret sel opt_floor.some && length > opt_floor.some;
}

# what the pass does with one instruction, none for nothing, a copy marked
# with its orders first
fun item_of(w: *Work, c: *Context, b: *Body, i: Instruction) opt[Item] {
    val opt_framed: opt[u64] = framed_length(w, b, ?b.instructions.data[i]);
    if (sel opt_framed.some) {
        if (b.instructions.data[i].opcode == opcode_table.MEM_COPY) { mark(w, i); }
        ret opt[Item].some{Item.loop{opt_framed.some}};
    }
    val d: *InstructionData = ?b.instructions.data[i];
    if (d.opcode == opcode_table.MEM_COPY && d.operands.len == 3 && !(sel w.caps.bulk.copy.whole)) { mark(w, i); }
    if (packs(c, w.s.f, b, ?b.instructions.data[i]))                                               { ret opt[Item].some{Item.packed{packed_lanes(c, w.s.f, d.opcode == opcode_table.MEM_FILL)}}; }
    val opt_length: opt[u64] = length_of(c.m, b, ?c.t.caps, ?b.instructions.data[i]);
    if (sel opt_length.none)                                          { ret opt[Item].none{}; }
    if (instructed(w.caps, ?b.instructions.data[i], opt_length.some)) { ret opt[Item].none{}; }
    ret opt[Item].some{Item.loop{opt_length.some}};
}

# mark every copy no one instruction does whatever its ranges are, or that a
# frame loop moves, with its orders, then move by units every copy and fill of
# a known length no instruction is stated for, and make packed loops of every
# one of a length not known that a byte vector serves. each is found
# before the first is rewritten, as a rewrite moves what follows it to a block
# of its own
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val b: *Body = res_body.ok;
    if (!contents.has_opcode(?b.contents, opcode_table.MEM_COPY) && !contents.has_opcode(?b.contents, opcode_table.MEM_FILL)) { ret res[bool, refusal.Error].ok{false}; }

    var ar:        arena.Arena;
    val err_arena: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_arena.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_arena.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.allocator(?scratch, ?ar);

    var w: Work;
    w.s = emit.init(c.m, u.f, b, ?scratch);
    fin { emit.dnit(?w.s); }
    w.caps   = ?c.t.caps;
    w.layout = layout.of(c.t, ?c.m.types, basis.context_of(c.basis));
    w.failed = opt[refusal.Error].none{};
    w.timed  = in_constant_time(c.m.functions.data[u.f].data.constant_time);
    w.word   = 8;
    val opt_widest: opt[u32] = capability.widest(?c.t.caps);
    if (sel opt_widest.some) { w.word = (opt_widest.some / 8)::u64; }
    if (w.word == 0)         { w.word = 1; }
    w.misaligned = c.t.misaligned;
    w.moves      = c.t.caps.bulk.moves::u64;
    w.fill_lanes = packed_lanes(c, u.f, true);
    w.copy_lanes = packed_lanes(c, u.f, false);

    var items: Vector[Instruction] = vector.init[Instruction](?scratch);
    var kinds: Vector[Item]        = vector.init[Item](?scratch);
    var k:     usize               = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: Instruction = b.blocks.data[k].first;
            for (n != NO_INSTRUCTION) {
                val i:        Instruction = n;
                val opt_kind: opt[Item]   = item_of(?w, c, b, i);
                if (sel opt_kind.some) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[Instruction](?items, i);
                    if (sel res_pushed.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_pushed.err}}; }
                    val res_held: res[usize, allocator.Error] = vector.push[Item](?kinds, opt_kind.some);
                    if (sel res_held.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_held.err}}; }
                }
                n = b.instructions.data[n].next;
            }
        }
        k = k + 1;
    }
    var n: usize = 0;
    for (n < items.len) {
        val kind:       Item               = kinds.data[n];
        var err_change: err[refusal.Error] = err[refusal.Error].ok{};
        if (sel kind.loop)      { err_change = runs(?w, items.data[n], kind.loop); }
        or                      { err_change = packed(?w, items.data[n], kind.packed); }
        if (sel err_change.err) { ret res[bool, refusal.Error].err{err_change.err}; }
        n = n + 1;
    }
    ret res[bool, refusal.Error].ok{items.len > 0};
}
