# the delivery of a helper into the module that calls it
#
# a helper is asked for by its operation, its width and, for a conversion or
# a float remainder, its number format. the module's symbol of the helper's
# name is the helper when it is there, and otherwise the helper's row is filled
# in for what was asked and read into the module, with the helper its text
# calls delivered first. every number the text needs is worked out here from the target's
# declarations and the format's row, so the text holds no fact of a target.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fold.float;
use mirl.fold.word.Wide;
use mirl.ir.function.Node;
use mirl.ir.id.Function;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.legal.helper.table;
use mirl.legal.helper.table.Operation;
use mirl.legal.helper.table.Row;
use mirl.pass.failure.Unread;
use mirl.pass.failure.Why;
use targets: mirl.target;
use mirl.target.Layout;
use mirl.target.Target;

# what a caller asks for
# ---
# operation: what the helper does
# bits:      the width of its integer, of the length of a copy or fill, or of
#            the float of a remainder
# format:    the number format of a conversion's float or a remainder's
# space:     the address space of a copy's or a fill's addresses
pub rec Want {
    operation: Operation;
    bits:      u32;
    format:    opt[types.Format];
    space:     u32;
}

val TAKEN:     str = "a symbol of the module has the name of a helper and is not that helper";
val UNHELD:    str = "a conversion of a wide integer with a number format the target does not compute in";
val UNSHAPED:  str = "a conversion of a wide integer with a number format whose rounding a word or two cannot hold";
val UNSPACED:  str = "a copy or fill through an address space with no pointer size";
val UNWORDED:  str = "a helper on a target whose arithmetic runs at no width";
val UNENCODED: str = "a number format that is not a signed binary encoding";
val UNSCALED:  str = "a float remainder of a format with no implicit leading bit, or whose precision its exponent range cannot scale by";

# text under construction in scratch storage
rec Text {
    bytes:  vector.Vector[u8];
    failed: opt[allocator.Error];
}

fun text(a: *allocator.Allocator) Text {
    ret Text{bytes: vector.init[u8](a), failed: opt[allocator.Error].none{}};
}

fun byte(t: *Text, b: u8) {
    val before: opt[allocator.Error] = t.failed;
    if (sel before.some) { ret; }
    val pushed: res[usize, allocator.Error] = vector.push[u8](?t.bytes, b);
    if (sel pushed.err) { t.failed = opt[allocator.Error].some{pushed.err}; }
}

fun string(t: *Text, s: str) {
    var i: usize = 0;
    for (i < str_len(s)) {
        byte(t, s[i]);
        i = i + 1;
    }
}

fun bytes(t: *Text, v: View) {
    var i: usize = 0;
    for (i < v.len) {
        byte(t, v.data[i]);
        i = i + 1;
    }
}

fun decimal(t: *Text, n: u64) {
    if (n >= 10) { decimal(t, n / 10); }
    byte(t, ('0'::u64 + n % 10)::u8);
}

fun signed_decimal(t: *Text, n: i64) {
    if (n < 0) {
        byte(t, '-');
        decimal(t, (0 - n)::u64);
        ret;
    }
    decimal(t, n::u64);
}

fun digit(n: u64) u8 {
    if (n < 10) { ret ('0'::u64 + n)::u8; }
    ret ('a'::u64 + n - 10)::u8;
}

fun hex(t: *Text, n: u64) {
    string(t, "0x");
    var shown: bool = false;
    var at:    u32  = 64;
    for (at > 0) {
        at = at - 4;
        val d: u64 = (n >> at::u64) & 0xf;
        if (d != 0 || shown || at == 0) {
            byte(t, digit(d));
            shown = true;
        }
    }
}

# the hex digits of an integer of a width whose top digit is lead and every
# other digit rest
fun spread(t: *Text, bits: u32, lead: u8, rest: u8) {
    string(t, "0x");
    byte(t, lead);
    var i: u32 = 4;
    for (i < bits) {
        byte(t, rest);
        i = i + 4;
    }
}

fun view(t: *Text) View {
    ret View{data: t.bytes.data, len: t.bytes.len};
}

fun finished(t: *Text) res[View, Why] {
    if (sel t.failed.some) { ret res[View, Why].err{Why.alloc{t.failed.some}}; }
    ret res[View, Why].ok{view(t)};
}

# the most names a text fills in
val MOST: usize = 24;

# the value of each name a text fills in
# ---
# keys:   the names, without the `$`
# values: what each stands for
# count:  how many
# over:   more were given than it holds
rec Params {
    keys:   [24]str;
    values: [24]View;
    count:  usize;
    over:   bool;
}

# give a name its value
fun param(p: *Params, key: str, value: View) {
    if (p.count >= MOST) {
        p.over = true;
        ret;
    }
    p.keys[p.count]   = key;
    p.values[p.count] = value;
    p.count           = p.count + 1;
}

fun number(p: *Params, a: *allocator.Allocator, failed: *opt[allocator.Error], key: str, n: i64) {
    var t: Text = text(a);
    signed_decimal(?t, n);
    keep(failed, ?t);
    param(p, key, view(?t));
}

fun encoded(p: *Params, a: *allocator.Allocator, failed: *opt[allocator.Error], key: str, n: u64) {
    var t: Text = text(a);
    hex(?t, n);
    keep(failed, ?t);
    param(p, key, view(?t));
}

fun word(p: *Params, key: str, s: str) {
    param(p, key, View{data: s, len: str_len(s)});
}

fun keep(failed: *opt[allocator.Error], t: *Text) {
    if (sel t.failed.some && sel failed.none) { @failed = t.failed; }
}

fun same_key(key: str, v: View) bool {
    if (str_len(key) != v.len) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (key[i] != v.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun name_byte(b: u8) bool {
    ret (b >= 'a' && b <= 'z') || (b >= '0' && b <= '9') || b == '_';
}

# a text with every `$` name replaced by its value, refused when a name has none
fun fill(out: *Text, template: str, p: *Params) err[Why] {
    val n: usize = str_len(template);
    var i: usize = 0;
    for (i < n) {
        if (template[i] == '$') {
            var end: usize = i + 1;
            for (end < n && name_byte(template[end])) { end = end + 1; }
            val key:   View  = View{data: ?template[i + 1], len: end - i - 1};
            var found: bool  = false;
            var k:     usize = 0;
            for (k < p.count && !found) {
                if (same_key(p.keys[k], key)) {
                    bytes(out, p.values[k]);
                    found = true;
                }
                k = k + 1;
            }
            if (!found) { ret err[Why].err{Why.reason{"a helper's text names a value its delivery does not give"}}; }
            i = end;
        }
        or {
            byte(out, template[i]);
            i = i + 1;
        }
    }
    ret err[Why].ok{};
}

# the facts of a number format the texts read
# ---
# name:        its name in the text form
# width:       its bits
# exponent:    the bits of its exponent field
# significand: the stored bits of its significand
# precision:   the bits of its significand, the implicit one included
# bias:        its exponent bias
# most:        its largest exponent of a finite value
pub rec Number {
    name:        str;
    width:       u32;
    exponent:    u32;
    significand: u32;
    precision:   u32;
    bias:        i64;
    most:        i64;
}

# the facts of a number format, refused for one that is not a signed binary encoding
pub fun number_of(f: types.Format) res[Number, Why] {
    val r: opt[types.Row] = types.row(f);
    if (sel r.none) { ret res[Number, Why].err{Why.reason{UNENCODED}}; }
    val e: types.Encoding = r.some.encoding;
    if (!(sel e.binary)) { ret res[Number, Why].err{Why.reason{UNENCODED}}; }
    val b: types.Binary = e.binary;
    if (b.sign != 1 || b.exponent == 0 || b.exponent > 16) { ret res[Number, Why].err{Why.reason{UNENCODED}}; }
    var p: u32 = b.significand;
    if (b.implicit) { p = p + 1; }
    val top: i64 = (1i64 << b.exponent::i64) - 2;
    ret res[Number, Why].ok{Number{name: r.some.name, width: r.some.width, exponent: b.exponent, significand: b.significand, precision: p, bias: b.bias::i64, most: top - b.bias::i64}};
}

# the bits of the power of two of an exponent a finite value of the format has
pub fun power(n: *Number, k: i64) u64 {
    ret ((k + n.bias)::u64) << n.significand::u64;
}

# the bits of positive infinity
pub fun infinity(n: *Number) u64 {
    ret ((1u64 << n.exponent::u64) - 1) << n.significand::u64;
}

# the bits of 2^k, or of positive infinity when every finite value is below it
pub fun limit(n: *Number, k: i64) u64 {
    if (k > n.most) { ret infinity(n); }
    ret power(n, k);
}

# whether the target computes in a number format
fun held(t: *Target, f: types.Format) bool {
    val formats: targets.Formats = t.caps.formats;
    if (!(sel formats.held)) { ret false; }
    var i: usize = 0;
    for (i < formats.held.size) {
        if (formats.held.data[i].format.index == f.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the name of the helper a want asks for
fun name_of(t: *Text, r: *Row, want: Want, n: *Number) {
    string(t, table.PREFIX);
    string(t, r.stem);
    if (!(sel r.naming.float)) { decimal(t, want.bits::u64); }
    if (!(sel r.naming.width)) {
        byte(t, '_');
        string(t, n.name);
    }
    if (want.space != 0) {
        string(t, "_space");
        decimal(t, want.space::u64);
    }
}

# what the delivery reads beside the want
# ---
# m:       the module
# t:       the target
# scratch: storage for the texts, given back by the caller
rec Delivery {
    m:       *Module;
    t:       *Target;
    scratch: *allocator.Allocator;
}

# fill in the values a division's text reads
fun division(d: *Delivery, p: *Params, failed: *opt[allocator.Error], want: Want) {
    number(p, d.scratch, failed, "n", want.bits::i64);
    number(p, d.scratch, failed, "top", want.bits::i64 - 1);
    if (sel want.operation.quotient_u)  { word(p, "result", "%q2"); }
    if (sel want.operation.remainder_u) { word(p, "result", "%r4"); }
}

# fill in the values a conversion's text reads, and choose between a row's
# texts: the one word text where a word holds the bits of the float's
# precision, a round bit and a sticky bit, and the paired one where two words
# hold them and each converts exactly
fun conversion(d: *Delivery, p: *Params, failed: *opt[allocator.Error], want: Want, r: *Row, n: *Number, w: u32, text_of: *str) err[Why] {
    val bits: i64 = want.bits::i64;
    val word: i64 = w::i64;
    number(p, d.scratch, failed, "n", bits);
    number(p, d.scratch, failed, "top", bits - 1);
    number(p, d.scratch, failed, "w", word);
    number(p, d.scratch, failed, "fi", n.width::i64);
    # the count of leading zeros at the format's width, which is the integer's
    # own width, or narrower, or wider
    var fit: Text = text(d.scratch);
    if (want.bits > n.width)  { string(?fit, "trunc %lz, to i"); }
    or (want.bits < n.width)  { string(?fit, "ext.u %lz, to i"); }
    if (want.bits != n.width) { decimal(?fit, n.width::u64); }
    or {
        string(?fit, "or %lz, i");
        decimal(?fit, n.width::u64);
        string(?fit, " 0");
    }
    keep(failed, ?fit);
    param(p, "fit", view(?fit));
    number(p, d.scratch, failed, "bias", n.bias);
    number(p, d.scratch, failed, "sig", n.significand::i64);
    number(p, d.scratch, failed, "emax", n.most);
    param(p, "f", View{data: n.name, len: str_len(n.name)});
    encoded(p, d.scratch, failed, "inf", infinity(n));
    encoded(p, d.scratch, failed, "sign", 1u64 << (n.width - 1)::u64);
    encoded(p, d.scratch, failed, "limit", limit(n, bits));
    encoded(p, d.scratch, failed, "half", limit(n, bits - 1));
    var least: Text = text(d.scratch);
    spread(?least, want.bits, '8', '0');
    keep(failed, ?least);
    param(p, "least", view(?least));
    var most: Text = text(d.scratch);
    spread(?most, want.bits, '7', 'f');
    keep(failed, ?most);
    param(p, "most", view(?most));
    # the count of leading zeros and the exponent it gives are held at the format's width
    if (n.width < 64 && (1u64 << (n.width - 1)::u64) <= 2 * bits::u64) { ret err[Why].err{Why.reason{UNSHAPED}}; }
    @text_of = r.text;
    if (sel want.operation.to_float_u) {
        val k: i64 = n.precision::i64 + 2;
        if (k <= word) {
            if (n.bias - k < 1) { ret err[Why].err{Why.reason{UNSHAPED}}; }
            number(p, d.scratch, failed, "k", k);
            number(p, d.scratch, failed, "nk", bits - k);
            ret err[Why].ok{};
        }
        if (word > n.precision::i64 || 2 * word < k || 2 * word > n.most || n.bias - 2 * word < 1 || 2 * word > bits) { ret err[Why].err{Why.reason{UNSHAPED}}; }
        @text_of = r.paired;
        number(p, d.scratch, failed, "nw", bits - word);
        number(p, d.scratch, failed, "n2w", bits - 2 * word);
        number(p, d.scratch, failed, "w2", 2 * word);
        encoded(p, d.scratch, failed, "word", power(n, word));
        ret err[Why].ok{};
    }
    if (sel want.operation.to_integer_u) {
        # the word of the top digit is the highest whose scale a finite value
        # reaches, and its scale and its inverse are normal powers of two
        var digits: i64 = bits / word - 1;
        if (digits * word > n.most)                                { digits = n.most / word; }
        if (digits * word >= n.most || n.bias - digits * word < 1) { ret err[Why].err{Why.reason{UNSHAPED}}; }
        number(p, d.scratch, failed, "digits", digits);
    }
    ret err[Why].ok{};
}

# fill in the values a float remainder's text reads: the powers of two its
# scaling reads, the masks of the significand and of the largest exponent, and
# a step for every exponent from the largest down to the smallest subnormal's
fun remainder(d: *Delivery, p: *Params, failed: *opt[allocator.Error], n: *Number, want: Want) err[Why] {
    if (sel want.format.none)                                          { ret err[Why].err{Why.reason{UNHELD}}; }
    if (n.precision != n.significand + 1 || n.precision::i64 > n.most) { ret err[Why].err{Why.reason{UNSCALED}}; }
    val r: opt[types.Row] = types.row(want.format.some);
    if (sel r.none) { ret err[Why].err{Why.reason{UNENCODED}}; }
    val s: opt[float.Spec] = float.spec(r.some);
    if (sel s.none) { ret err[Why].err{Why.reason{UNENCODED}}; }
    var spec: float.Spec = s.some;
    val nan:  Wide       = float.canonical(?spec);
    param(p, "f", View{data: n.name, len: str_len(n.name)});
    number(p, d.scratch, failed, "fi", n.width::i64);
    encoded(p, d.scratch, failed, "normal", power(n, 1 - n.bias));
    encoded(p, d.scratch, failed, "scale", power(n, n.precision::i64));
    encoded(p, d.scratch, failed, "half", power(n, -1));
    encoded(p, d.scratch, failed, "high", power(n, n.most));
    encoded(p, d.scratch, failed, "fraction", (1u64 << n.significand::u64) - 1);
    encoded(p, d.scratch, failed, "inf", infinity(n));
    encoded(p, d.scratch, failed, "nan", nan[0]);
    number(p, d.scratch, failed, "steps", n.most + n.bias + n.precision::i64 - 1);
    ret err[Why].ok{};
}

# fill in the values a product's text reads
fun product(d: *Delivery, p: *Params, failed: *opt[allocator.Error], want: Want) {
    number(p, d.scratch, failed, "n", want.bits::i64);
}

# fill in the values a copy's or a fill's text reads
fun bulk(d: *Delivery, p: *Params, failed: *opt[allocator.Error], want: Want) err[Why] {
    number(p, d.scratch, failed, "l", want.bits::i64);
    val pointer: res[Type, types.Error] = types.intern(?d.m.types, types.Shape.pointer{types.Pointer{space: want.space}});
    if (sel pointer.err) { ret err[Why].err{Why.ir{module.Error.types{pointer.err}}}; }
    var layout: Layout                  = targets.of(d.t, ?d.m.types);
    val size:   res[u64, targets.Error] = targets.size(?layout, pointer.ok);
    if (sel size.err) { ret err[Why].err{Why.reason{UNSPACED}}; }
    number(p, d.scratch, failed, "p", (size.ok * 8)::i64);
    var spelled: Text = text(d.scratch);
    string(?spelled, "ptr");
    if (want.space != 0) {
        byte(?spelled, '<');
        decimal(?spelled, want.space::u64);
        byte(?spelled, '>');
    }
    keep(failed, ?spelled);
    param(p, "pt", view(?spelled));
    ret err[Why].ok{};
}

# the function of a name when the module's symbol of it is a defined function
# of the signature, none when no symbol has the name
fun existing(m: *Module, name: View, signature: Type) res[opt[Function], Why] {
    val found: opt[Symbol] = module.find(m, name);
    if (sel found.none) { ret res[opt[Function], Why].ok{opt[Function].none{}}; }
    val s: Symbol = found.some;
    if (!(sel s.function)) { ret res[opt[Function], Why].err{Why.reason{TAKEN}}; }
    val n: *Node = ?m.functions.data[s.function.index];
    if (n.body.blocks.len == 0 || !types.same(n.data.signature, signature)) { ret res[opt[Function], Why].err{Why.reason{TAKEN}}; }
    ret res[opt[Function], Why].ok{opt[Function].some{s.function}};
}

fun interned(m: *Module, shape: types.Shape) res[Type, Why] {
    val made: res[Type, types.Error] = types.intern(?m.types, shape);
    if (sel made.err) { ret res[Type, Why].err{Why.ir{module.Error.types{made.err}}}; }
    ret res[Type, Why].ok{made.ok};
}

# the function type of the helper a want asks for: a division or a product
# takes two integers of its width and gives one, a float remainder two floats
# of its format and gives one, a conversion takes its integer or its float and
# gives the other, and a copy or fill takes its addresses or its
# address and byte, and its length. the byte and the length are unsigned, so
# a convention that extends a narrow integer extends them with zeros
pub fun signature(m: *Module, want: Want) res[Type, Why] {
    val integer: res[Type, Why] = interned(m, types.Shape.integer{types.Integer{width: want.bits}});
    if (sel integer.err) { ret integer; }
    var params:  [3]Type            = [3]Type{integer.ok, integer.ok, integer.ok};
    var ext:     [3]types.Extension = [3]types.Extension{types.Extension.none{}, types.Extension.none{}, types.Extension.none{}};
    var results: [1]Type            = [1]Type{integer.ok};
    var taken:   usize              = 2;
    var given:   usize              = 1;
    if (sel want.operation.copy || sel want.operation.fill) {
        val pointer: res[Type, Why] = interned(m, types.Shape.pointer{types.Pointer{space: want.space}});
        if (sel pointer.err) { ret pointer; }
        params[0] = pointer.ok;
        params[1] = pointer.ok;
        ext[2]    = types.Extension.zext{};
        if (sel want.operation.fill) {
            val byte: res[Type, Why] = interned(m, types.Shape.integer{types.Integer{width: 8}});
            if (sel byte.err) { ret byte; }
            params[1] = byte.ok;
            ext[1]    = types.Extension.zext{};
        }
        taken = 3;
        given = 0;
    }
    if (sel want.operation.remainder_f) {
        if (sel want.format.none) { ret res[Type, Why].err{Why.reason{UNHELD}}; }
        val float: res[Type, Why] = interned(m, types.Shape.float{types.Float{format: want.format.some}});
        if (sel float.err) { ret float; }
        params[0]  = float.ok;
        params[1]  = float.ok;
        results[0] = float.ok;
    }
    if (sel want.operation.to_float_u || sel want.operation.to_float_s || sel want.operation.to_integer_u || sel want.operation.to_integer_s) {
        if (sel want.format.none) { ret res[Type, Why].err{Why.reason{UNHELD}}; }
        val float: res[Type, Why] = interned(m, types.Shape.float{types.Float{format: want.format.some}});
        if (sel float.err) { ret float; }
        taken = 1;
        if (sel want.operation.to_float_u || sel want.operation.to_float_s) { results[0] = float.ok; }
        or                                                                  { params[0] = float.ok; }
    }
    ret interned(m, types.Shape.function{types.Function{params: Slice[Type]{data: ?params[0], size: taken}, results: Slice[Type]{data: ?results[0], size: given}, param_ext: Slice[types.Extension]{data: ?ext[0], size: taken}, result_ext: Slice[types.Extension]{data: nil, size: 0}}});
}

# the helper a want asks for, read into the module unless it holds it already
# ---
# m:       the module
# t:       the target
# scratch: storage for the texts, which the caller gives back
# want:    what is asked for
# ret:     the helper, or why it cannot be delivered, with the module holding
#          what was read before the refusal
pub fun deliver(m: *Module, t: *Target, scratch: *allocator.Allocator, want: Want) res[Function, Why] {
    val typed: res[Type, Why] = signature(m, want);
    if (sel typed.err) { ret res[Function, Why].err{typed.err}; }
    val sig: Type      = typed.ok;
    val got: opt[*Row] = table.row(want.operation);
    if (sel got.none) { ret res[Function, Why].err{Why.reason{"a helper asked for an operation no row does"}}; }
    val r:   *Row     = got.some;
    val top: opt[u32] = targets.widest(?t.caps);
    if (sel top.none) { ret res[Function, Why].err{Why.reason{UNWORDED}}; }
    var n: Number = Number{name: "", width: 0, exponent: 0, significand: 0, precision: 0, bias: 0, most: 0};
    if (!(sel r.naming.width)) {
        if (sel want.format.none)       { ret res[Function, Why].err{Why.reason{UNHELD}}; }
        if (!held(t, want.format.some)) { ret res[Function, Why].err{Why.reason{UNHELD}}; }
        val read: res[Number, Why] = number_of(want.format.some);
        if (sel read.err) { ret res[Function, Why].err{read.err}; }
        n = read.ok;
    }

    var name: Text = text(scratch);
    name_of(?name, r, want, ?n);
    val spelled: res[View, Why] = finished(?name);
    if (sel spelled.err) { ret res[Function, Why].err{spelled.err}; }
    val there: res[opt[Function], Why] = existing(m, spelled.ok, sig);
    if (sel there.err)     { ret res[Function, Why].err{there.err}; }
    if (sel there.ok.some) { ret res[Function, Why].ok{there.ok.some}; }

    var p: Params = Params{count: 0, over: false};
    param(?p, "name", spelled.ok);
    if (!(sel r.calls.unstated)) {
        val inner:  Want               = Want{operation: r.calls, bits: want.bits, format: want.format, space: want.space};
        val called: res[Function, Why] = deliver(m, t, scratch, inner);
        if (sel called.err) { ret called; }
        val inner_row: opt[*Row] = table.row(r.calls);
        if (sel inner_row.none) { ret res[Function, Why].err{Why.reason{"a helper calls an operation no row does"}}; }
        var callee: Text = text(scratch);
        name_of(?callee, inner_row.some, inner, ?n);
        val named: res[View, Why] = finished(?callee);
        if (sel named.err) { ret res[Function, Why].err{named.err}; }
        param(?p, "calls", named.ok);
    }
    var d:        Delivery             = Delivery{m: m, t: t, scratch: scratch};
    var failed:   opt[allocator.Error] = opt[allocator.Error].none{};
    var template: str                  = r.text;
    var shaped:   err[Why]             = err[Why].ok{};
    if (sel want.operation.remainder_f)                     { shaped = remainder(?d, ?p, ?failed, ?n, want); }
    or (sel r.naming.format)                                { shaped = conversion(?d, ?p, ?failed, want, r, ?n, top.some, ?template); }
    or (sel want.operation.copy || sel want.operation.fill) { shaped = bulk(?d, ?p, ?failed, want); }
    or (sel want.operation.product)                         { product(?d, ?p, ?failed, want); }
    or                                                      { division(?d, ?p, ?failed, want); }
    if (sel shaped.err)                                     { ret res[Function, Why].err{shaped.err}; }
    if (sel failed.some)                                    { ret res[Function, Why].err{Why.alloc{failed.some}}; }
    if (p.over)                                             { ret res[Function, Why].err{Why.reason{"a helper's text names more values than its delivery holds"}}; }

    var body:   Text     = text(scratch);
    val filled: err[Why] = fill(?body, template, ?p);
    if (sel filled.err) { ret res[Function, Why].err{filled.err}; }
    val whole: res[View, Why] = finished(?body);
    if (sel whole.err) { ret res[Function, Why].err{whole.err}; }
    val read: err[Refusal] = parse.parse_into(m, scratch, whole.ok);
    if (sel read.err) { ret res[Function, Why].err{Why.text{Unread{line: read.err.line, column: read.err.column}}}; }
    val made: res[opt[Function], Why] = existing(m, spelled.ok, sig);
    if (sel made.err)     { ret res[Function, Why].err{made.err}; }
    if (sel made.ok.none) { ret res[Function, Why].err{Why.reason{"a helper's text defines no function of its name"}}; }
    ret res[Function, Why].ok{made.ok.some};
}
