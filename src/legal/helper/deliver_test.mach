# every helper text delivers and verifies, for every target row
#
# the walk is bounded by the helper table, the target rows and the format
# rows: each row of the table at every width above a target's word for a
# division or conversion, with every format the target computes in for a
# conversion, once at every format it computes in for a float remainder, and
# at every width of its arithmetic as the length of a copy or fill through
# every address space it reaches by a physical pointer

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.arena;
use std.allocator.page;
use std.collections.slice.Slice;
use std.filesystem;
use io:   std.io.writer;
use diag: std.print;

use folder: mirl.fold;
use mirl.ir.constant.Bits;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use ir: mirl.ir.opcode;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use types: mirl.ir.type;
use mirl.ir.type.BINARY32;
use mirl.ir.type.BINARY64;
use mirl.ir.type.Type;
use mirl.legal.check_test.Text;
use mirl.legal.check_test.target_line;
use mirl.legal.check_test.view;
use mirl.legal.helper;
use mirl.legal.helper.deliver;
use mirl.legal.helper.deliver.Want;
use mirl.legal.helper.table;
use mirl.legal.helper.table.Operation;
use mirl.legal.helper.table.Row;
use mirl.opt.number;
use mirl.pass.failure.Why;
use targets: mirl.target;
use mirl.target.Target;
use mirl.verify;

# deliver one want into a module, saying what failed
#[testing]
fun one(m: *Module, t: *Target, scratch: *allocator.Allocator, r: *Row, want: Want) bool {
    val got: res[Function, Why] = deliver.deliver(m, t, scratch, want);
    if (sel got.ok) { ret true; }
    var e: io.Writer = filesystem.writer(filesystem.STDERR);
    targets.name(?e, t);
    diag.eprintlnf(": {} at {} in space {} was not delivered", r.stem, want.bits, want.space);
    val why: Why = got.err;
    if (sel why.reason) { diag.eprintlnf("    {}", why.reason); }
    if (sel why.text)   { diag.eprintlnf("    its text at line {} column {}", why.text.line, why.text.column); }
    ret false;
}

# every want a row asks of a target, delivered into a module
#[testing]
fun row_of(m: *Module, t: *Target, scratch: *allocator.Allocator, r: *Row, word: u32) bool {
    if (sel r.naming.float) {
        val formats: targets.Formats = t.caps.formats;
        if (!(sel formats.held)) { ret true; }
        var f: usize = 0;
        for (f < formats.held.size) {
            val held: *types.Format  = formats.held.data[f].format;
            val fr:   opt[types.Row] = types.row(@held);
            if (sel fr.none)                                                                                                                { ret false; }
            if (!one(m, t, scratch, r, Want{operation: r.operation, bits: fr.some.width, format: opt[types.Format].some{@held}, space: 0})) { ret false; }
            f = f + 1;
        }
        ret true;
    }
    val bulk: bool = sel r.operation.copy || sel r.operation.fill;
    if (bulk) {
        val alu:    targets.Set          = t.caps.widths.alu;
        val spaces: Slice[targets.Space] = t.caps.widths.pointers;
        if (!(sel alu.widths)) { ret true; }
        var s: usize = 0;
        for (s < spaces.size) {
            if (sel spaces.data[s].pointer.physical) {
                var w: usize = 0;
                for (w < alu.widths.size) {
                    if (!one(m, t, scratch, r, Want{operation: r.operation, bits: alu.widths.data[w], format: opt[types.Format].none{}, space: spaces.data[s].space})) { ret false; }
                    w = w + 1;
                }
            }
            s = s + 1;
        }
        ret true;
    }
    var i: usize = 0;
    for (i < $length_of(types.Widths)) {
        val bits: u32 = types.WIDTHS[i];
        if (bits > word) {
            if (sel r.naming.format) {
                val formats: targets.Formats = t.caps.formats;
                if (sel formats.held) {
                    var f: usize = 0;
                    for (f < formats.held.size) {
                        val held: types.Format = @formats.held.data[f].format;
                        if (!one(m, t, scratch, r, Want{operation: r.operation, bits: bits, format: opt[types.Format].some{held}, space: 0})) { ret false; }
                        f = f + 1;
                    }
                }
            }
            or {
                if (!one(m, t, scratch, r, Want{operation: r.operation, bits: bits, format: opt[types.Format].none{}, space: 0})) { ret false; }
            }
        }
        i = i + 1;
    }
    ret true;
}

# every helper of a target, delivered into one module the verifier accepts
#[testing]
fun target_of(a: *allocator.Allocator, t: *Target) i32 {
    val top: opt[u32] = targets.widest(?t.caps);
    if (!(sel top.some)) { ret 0; }
    var header: Text;
    header.len = 0;
    target_line(?header, t);
    var parsed: res[Module, Refusal] = parse_body(a, view(?header));
    if (sel parsed.err) { ret 1; }
    var m: Module = parsed.ok;
    fin { module.dnit(?m); }
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, a, 0);
    if (sel made.err) { ret 2; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    val rows: Slice[Row] = table.rows();
    var i:    usize      = 0;
    for (i < rows.size) {
        if (!row_of(?m, t, ?scratch, ?rows.data[i], top.some)) { ret 3; }
        i = i + 1;
    }
    val checked: err[verify.Error] = verify.against(?m, t, verify.Stage.open{});
    if (sel checked.err) {
        var e: io.Writer = filesystem.writer(filesystem.STDERR);
        targets.name(?e, t);
        diag.eprintln(": the verifier refuses the delivered helpers");
        ret 4;
    }
    ret 0;
}

test helper__every_helper_of_every_target_delivers_and_verifies {
    var a: allocator.Allocator;
    page.make(?a);
    var i: usize = 0;
    for (i < targets.rows()) {
        val t: opt[*Target] = targets.row(i);
        if (!(sel t.some)) { ret 1; }
        val r: i32 = target_of(?a, t.some);
        if (r != 0) { ret 10 * (i::i32 + 1) + r; }
        i = i + 1;
    }
    ret 0;
}

# one float remainder, its operands and result as bits of its format, each
# result worked out by hand from the operands' values. a nan result is any nan
# ---
# format: the format
# x:      the dividend
# y:      the divisor
# want:   the remainder, unread where it is a nan
# nan:    the remainder is a nan
#[testing]
rec Remainder {
    format: types.Format;
    x:      u64;
    y:      u64;
    want:   u64;
    nan:    bool;
}

#[testing]
def Remainders: [24]Remainder;

# 5.5 and 2 give 1.5 whatever the divisor's sign, with the dividend's. a nan
# operand, a zero divisor of either sign and an infinite dividend of either
# sign give a nan, and a zero dividend or an infinite divisor give the
# dividend. 3 and 2 of the least subnormal give it once, 2^-1022 by 3 of it
# gives 2^52 mod 3 of it, which is 1. the largest exponent differences are the
# largest finite value by the least subnormal, of which it is a multiple, and
# by 3 of it at binary64: (2^53 - 1) 2^2045 mod 3 is 1 times 2. at binary32
# the largest finite value by 11 of the least subnormal is (2^24 - 1) 2^253
# mod 11, 4 times 8, which is 10
#[testing]
val REMAINDERS: Remainders = [24]Remainder{
    Remainder{format: BINARY64, x: 0x4016000000000000, y: 0x4000000000000000, want: 0x3ff8000000000000, nan: false},
    Remainder{format: BINARY64, x: 0xc016000000000000, y: 0x4000000000000000, want: 0xbff8000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x4016000000000000, y: 0xc000000000000000, want: 0x3ff8000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x3ff0000000000000, y: 0x4008000000000000, want: 0x3ff0000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x7ff8000000000000, y: 0x3ff0000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x3ff0000000000000, y: 0xfff4000000000001, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x0000000000000000, y: 0x3ff0000000000000, want: 0x0000000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x8000000000000000, y: 0x3ff0000000000000, want: 0x8000000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x3ff0000000000000, y: 0x0000000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x3ff0000000000000, y: 0x8000000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x0000000000000000, y: 0x0000000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x7ff0000000000000, y: 0x3ff0000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0xfff0000000000000, y: 0x3ff0000000000000, want: 0, nan: true},
    Remainder{format: BINARY64, x: 0x3ff8000000000000, y: 0x7ff0000000000000, want: 0x3ff8000000000000, nan: false},
    Remainder{format: BINARY64, x: 0xbff8000000000000, y: 0xfff0000000000000, want: 0xbff8000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x0000000000000003, y: 0x0000000000000002, want: 0x0000000000000001, nan: false},
    Remainder{format: BINARY64, x: 0x0010000000000000, y: 0x0000000000000003, want: 0x0000000000000001, nan: false},
    Remainder{format: BINARY64, x: 0x7fefffffffffffff, y: 0x0000000000000001, want: 0x0000000000000000, nan: false},
    Remainder{format: BINARY64, x: 0x7fefffffffffffff, y: 0x0000000000000003, want: 0x0000000000000002, nan: false},
    Remainder{format: BINARY32, x: 0x40b00000, y: 0x40000000, want: 0x3fc00000, nan: false},
    Remainder{format: BINARY32, x: 0x80000000, y: 0x7f800000, want: 0x80000000, nan: false},
    Remainder{format: BINARY32, x: 0x00000003, y: 0x00000002, want: 0x00000001, nan: false},
    Remainder{format: BINARY32, x: 0x7f7fffff, y: 0x00000001, want: 0x00000000, nan: false},
    Remainder{format: BINARY32, x: 0x7f7fffff, y: 0x0000000b, want: 0x0000000a, nan: false},
};

# whether an encoding of a format is a nan: every exponent bit set and a
# significand that is not zero
#[testing]
fun is_nan(n: *deliver.Number, x: u64) bool {
    val inf: u64 = deliver.infinity(n);
    ret (x & inf) == inf && (x & ((1u64 << n.significand::u64) - 1)) != 0;
}

# the bits one instruction of a body folds to, its operands' bits read from
# what ran before it
#[testing]
fun step(m: *Module, b: *Body, scratch: *allocator.Allocator, d: *InstructionData, bits: *u64) opt[u64] {
    var words: [3]u64;
    var held:  [3]Bits;
    var ops:   [3]folder.Operand;
    var n:     usize = 0;
    for (n < d.operands.len) {
        if (n >= 3) { ret opt[u64].none{}; }
        val v:  Value = d.operands.data[n];
        val ty: Type  = b.values.data[v.index].type;
        words[n] = bits[v.index];
        held[n]  = Bits{type: ty, words: Slice[u64]{data: ?words[n], size: 1}};
        ops[n]   = folder.Operand{value: folder.Value{type: ty, lanes: Slice[Bits]{data: ?held[n], size: 1}}, secret: false};
        n        = n + 1;
    }
    val out: folder.Outcome = folder.fold(scratch, ?m.types, folder.Request{opcode: d.opcode, operands: Slice[folder.Operand]{data: ?ops[0], size: n}, immediates: Slice[ir.Immediate]{data: d.immediates.data, size: d.immediates.len}});
    if (!(sel out.folded)) { ret opt[u64].none{}; }
    ret opt[u64].some{out.folded.results.data[0].lanes.data[0].words.data[0]};
}

# what a delivered helper of two operands returns, each instruction of it
# folded in the order it runs
#[testing]
fun run(a: *allocator.Allocator, m: *Module, f: Function, x: u64, y: u64) opt[u64] {
    val got: res[*Body, module.Error] = module.body(m, f);
    if (sel got.err) { ret opt[u64].none{}; }
    val b:    *Body                = got.ok;
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, a, 0);
    if (sel made.err) { ret opt[u64].none{}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    val room: res[*u64, allocator.Error] = allocator.zallocate[u64](a, b.values.len);
    if (sel room.err) { ret opt[u64].none{}; }
    val bits: *u64 = room.ok;
    fin { allocator.deallocate[u64](a, bits, b.values.len); }
    var v: usize = 0;
    for (v < b.values.len) {
        val c: res[opt[folder.Value], Why] = number.read(m, b, ?scratch, Value{index: v::u32});
        if (sel c.err)     { ret opt[u64].none{}; }
        if (sel c.ok.some) { bits[v] = c.ok.some.lanes.data[0].words.data[0]; }
        v = v + 1;
    }
    var k: Block = Block{index: 0};
    if (b.blocks.data[0].parameters.len != 2) { ret opt[u64].none{}; }
    bits[b.blocks.data[0].parameters.data[0].index] = x;
    bits[b.blocks.data[0].parameters.data[1].index] = y;
    # each block entered runs its instructions to its end, a branch naming the next
    for {
        var next: opt[Block] = opt[Block].none{};
        var p:    usize      = 0;
        for (p < b.blocks.data[k.index].instructions.len && sel next.none) {
            arena.reset(?ar);
            val d: *InstructionData = ?b.instructions.data[b.blocks.data[k.index].instructions.data[p].index];
            if (d.opcode.index == ir.RET.index) { ret opt[u64].some{bits[d.operands.data[0].index]}; }
            if (d.edges.len > 0) {
                var e: usize = 0;
                if (d.edges.len == 2 && (bits[d.operands.data[0].index] & 1) == 0) { e = 1; }
                val to:   Block = d.edges.data[e].block;
                var args: [4]u64;
                var i:    usize = 0;
                if (d.edges.data[e].arguments.len > 4) { ret opt[u64].none{}; }
                for (i < d.edges.data[e].arguments.len) {
                    args[i] = bits[d.edges.data[e].arguments.data[i].index];
                    i       = i + 1;
                }
                i = 0;
                for (i < d.edges.data[e].arguments.len) {
                    bits[b.blocks.data[to.index].parameters.data[i].index] = args[i];
                    i                                                      = i + 1;
                }
                next = opt[Block].some{to};
            }
            or {
                val r: opt[u64] = step(m, b, ?scratch, d, bits);
                if (sel r.none) { ret opt[u64].none{}; }
                bits[d.results.data[0].index] = r.some;
            }
            p = p + 1;
        }
        if (sel next.none) { ret opt[u64].none{}; }
        k = next.some;
    }
    ret opt[u64].none{};
}

# what the folder gives the remainder itself
#[testing]
fun folded(scratch: *allocator.Allocator, m: *Module, ty: Type, x: u64, y: u64) opt[u64] {
    var words: [2]u64            = [2]u64{x, y};
    var held:  [2]Bits           = [2]Bits{Bits{type: ty, words: Slice[u64]{data: ?words[0], size: 1}}, Bits{type: ty, words: Slice[u64]{data: ?words[1], size: 1}}};
    var ops:   [2]folder.Operand = [2]folder.Operand{folder.Operand{value: folder.Value{type: ty, lanes: Slice[Bits]{data: ?held[0], size: 1}}, secret: false}, folder.Operand{value: folder.Value{type: ty, lanes: Slice[Bits]{data: ?held[1], size: 1}}, secret: false}};
    val out:   folder.Outcome    = folder.fold(scratch, ?m.types, folder.Request{opcode: ir.FREM, operands: Slice[folder.Operand]{data: ?ops[0], size: 2}, immediates: Slice[ir.Immediate]{data: nil, size: 0}});
    if (!(sel out.folded)) { ret opt[u64].none{}; }
    ret opt[u64].some{out.folded.results.data[0].lanes.data[0].words.data[0]};
}

# whether a target takes every frem out to the helper
#[testing]
fun remainders(t: *Target) bool {
    val single: opt[*targets.Held] = targets.format_row(?t.caps, BINARY32);
    val double: opt[*targets.Held] = targets.format_row(?t.caps, BINARY64);
    ret helper.removes(t, ir.FREM) && sel single.some && sel double.some;
}

# the frem helper of each format, run instruction by instruction through the
# folder, and the folder's own frem give the remainder worked out by hand at a
# nan of either operand, both zeros, both infinities, subnormals and the
# largest exponent differences
test helper__the_float_remainder_agrees_with_the_folder {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(remainders);
    if (sel row.none) { ret 1; }
    var header: Text;
    header.len = 0;
    target_line(?header, row.some);
    var parsed: res[Module, Refusal] = parse_body(?a, view(?header));
    if (sel parsed.err) { ret 2; }
    var m: Module = parsed.ok;
    fin { module.dnit(?m); }
    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, ?a, 0);
    if (sel made.err) { ret 3; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    var i: usize = 0;
    for (i < $length_of(Remainders)) {
        arena.reset(?ar);
        val c:  *Remainder     = ?REMAINDERS[i];
        val fr: opt[types.Row] = types.row(c.format);
        if (sel fr.none) { ret 4; }
        val num: res[deliver.Number, Why] = deliver.number_of(c.format);
        if (sel num.err) { ret 4; }
        var n:    deliver.Number     = num.ok;
        val want: Want               = Want{operation: Operation.remainder_f{}, bits: fr.some.width, format: opt[types.Format].some{c.format}, space: 0};
        val f:    res[Function, Why] = deliver.deliver(?m, row.some, ?scratch, want);
        if (sel f.err) { ret 5; }
        val ty: res[Type, types.Error] = types.intern(?m.types, types.Shape.float{types.Float{format: c.format}});
        if (sel ty.err) { ret 6; }
        val ran:  opt[u64] = run(?a, ?m, f.ok, c.x, c.y);
        val fold: opt[u64] = folded(?scratch, ?m, ty.ok, c.x, c.y);
        if (sel ran.none) {
            diag.eprintlnf("case {}: the helper did not run", i);
            ret 7;
        }
        if (sel fold.none) {
            diag.eprintlnf("case {}: the folder did not fold", i);
            ret 7;
        }
        val got:  u64 = ran.some;
        val them: u64 = fold.some;
        if (c.nan && (!is_nan(?n, got) || !is_nan(?n, them))) {
            diag.eprintlnf("case {}: the helper gives {} and the folder {}, where a nan is wanted", i, got, them);
            ret 8;
        }
        if (!c.nan && (got != c.want || them != c.want)) {
            diag.eprintlnf("case {}: the helper gives {} and the folder {}, where {} is wanted", i, got, them, c.want);
            ret 9;
        }
        i = i + 1;
    }
    ret 0;
}
