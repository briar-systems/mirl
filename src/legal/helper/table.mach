# the helpers mirl delivers: the one table of their names and texts
#
# a helper is an ordinary function of the module that calls it, written once
# here in the ir text form with its widths and constants left as `$` names,
# which the delivery fills in for the width, the number format and the target
# it is asked for. a module holds each at most once, weak and hidden, so every
# module's copy of a helper with one name is the same function and the linker
# keeps one. its name is mirl's own: the prefix, the row's stem, the width and,
# for a conversion, the number format, so no name a front end makes collides
# with it.
#
# each helper is written so its time depends on no value it is given but a
# length: a division runs one step per bit, choosing with selects, and a
# conversion is straight line code. a copy or fill runs one step per byte of
# its length. every one is declared constant time.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

# what a helper does
# ---
# quotient_u:   the unsigned quotient of two integers
# quotient_s:   the signed quotient, from the unsigned one of the magnitudes
# remainder_u:  the unsigned remainder
# remainder_s:  the signed remainder, from the unsigned one of the magnitudes
# to_float_u:   an unsigned integer to a float, rounded once
# to_float_s:   a signed integer to a float, from the unsigned conversion
# to_integer_u: a float to an unsigned integer, saturating, zero for a nan
# to_integer_s: a float to a signed integer, from the unsigned conversion
# copy:         a copy of a run of bytes whose ranges may overlap
# fill:         a fill of a run of bytes with one byte
pub tag Operation: u8 {
    unstated;
    quotient_u;
    quotient_s;
    remainder_u;
    remainder_s;
    to_float_u;
    to_float_s;
    to_integer_u;
    to_integer_s;
    copy;
    fill;
}

# how a helper's name is made after its stem
# ---
# width:  the width of its integer, or of its length
# format: the width of its integer, then the name of its number format
pub tag Naming: u8 {
    width;
    format;
}

# one helper
# ---
# operation: what it does
# stem:      its name between the prefix and the width
# naming:    what its name is made of after the stem
# text:      its text, to be filled in
# paired:    the text of a conversion to a float whose rounding needs the
#            bits of two words, nil for every other row
# calls:     the helper its text calls, unstated for none
pub rec Row {
    operation: Operation;
    stem:      str;
    naming:    Naming;
    text:      str;
    paired:    str;
    calls:     Operation;
}

# the prefix of every helper's name
pub val PREFIX: str = "__mirl_";

# restoring division, one bit of the dividend a step from the top, the
# remainder carrying the bit it shifts out, keeping the quotient or remainder
val UNSIGNED_DIVISION: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    br ^step(i32 $n, %n, i$n 0, i$n 0)\n^step(%k: i32, %a: i$n, %q: i$n, %r: i$n):\n    %carry = shr.u %r, i$n $top\n    %high = shr.u %a, i$n $top\n    %r1 = shl %r, i$n 1\n    %r2 = or %r1, %high\n    %a1 = shl %a, i$n 1\n    %q1 = shl %q, i$n 1\n    %over = ne %carry, i$n 0\n    %fits = ge.u %r2, %d\n    %take = or %over, %fits\n    %r3 = sub %r2, %d\n    %r4 = select %take, %r3, %r2\n    %bit = ext.u %take, to i$n\n    %q2 = or %q1, %bit\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %q2, %r4), ^done\n^done:\n    ret $result\n}\n";

# the unsigned quotient of the magnitudes, negated where the signs differ
val SIGNED_QUOTIENT: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    %nf = shr.s %n, i$n $top\n    %df = shr.s %d, i$n $top\n    %nx = xor %n, %nf\n    %na = sub %nx, %nf\n    %dx = xor %d, %df\n    %da = sub %dx, %df\n    %u = call ptr @$calls, %na, %da, signature fun(i$n, i$n) -> (i$n), named all\n    %s = xor %nf, %df\n    %ux = xor %u, %s\n    %v = sub %ux, %s\n    ret %v\n}\n";

# the unsigned remainder of the magnitudes, with the sign of the dividend
val SIGNED_REMAINDER: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    %nf = shr.s %n, i$n $top\n    %df = shr.s %d, i$n $top\n    %nx = xor %n, %nf\n    %na = sub %nx, %nf\n    %dx = xor %d, %df\n    %da = sub %dx, %df\n    %u = call ptr @$calls, %na, %da, signature fun(i$n, i$n) -> (i$n), named all\n    %ux = xor %u, %nf\n    %v = sub %ux, %nf\n    ret %v\n}\n";

# the integer shifted up past its leading zeros, its top bits and a sticky bit
# for the rest converted in one word, then scaled by the exact power of two
val UNSIGNED_TO_FLOAT: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %lz = clz %x\n    %cur = shl %x, %lz\n    %topn = shr.u %cur, i$n $nk\n    %top = trunc %topn, to i$w\n    %below = shl %cur, i$n $k\n    %any = ne %below, i$n 0\n    %sticky = ext.u %any, to i$w\n    %t = or %top, %sticky\n    %f = itof.u %t, to $f\n    %lzt = trunc %lz, to i$fi\n    %e = sub i$fi $nk, %lzt\n    %over = gt.s %e, i$fi $emax\n    %biased = add %e, i$fi $bias\n    %sbits = shl %biased, i$fi $sig\n    %scale = bitcast %sbits, to $f\n    %v = fmul %f, %scale\n    %vb = bitcast %v, to i$fi\n    %rb = select %over, i$fi $inf, %vb\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# as the one word conversion, for a format whose rounding needs more bits than a
# word: the top two words converted exactly and added, which rounds once
val UNSIGNED_TO_FLOAT_PAIR: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %lz = clz %x\n    %cur = shl %x, %lz\n    %hin = shr.u %cur, i$n $nw\n    %hi = trunc %hin, to i$w\n    %lon = shr.u %cur, i$n $n2w\n    %lo0 = trunc %lon, to i$w\n    %below = shl %cur, i$n $w2\n    %any = ne %below, i$n 0\n    %sticky = ext.u %any, to i$w\n    %lo = or %lo0, %sticky\n    %fh = itof.u %hi, to $f\n    %fl = itof.u %lo, to $f\n    %fw = fmul %fh, $f $word\n    %f = fadd %fw, %fl\n    %lzt = trunc %lz, to i$fi\n    %e = sub i$fi $n2w, %lzt\n    %over = gt.s %e, i$fi $emax\n    %biased = add %e, i$fi $bias\n    %sbits = shl %biased, i$fi $sig\n    %scale = bitcast %sbits, to $f\n    %v = fmul %f, %scale\n    %vb = bitcast %v, to i$fi\n    %rb = select %over, i$fi $inf, %vb\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# the magnitude converted unsigned, the sign put back in the sign bit
val SIGNED_TO_FLOAT: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %fill = shr.s %x, i$n $top\n    %flip = xor %x, %fill\n    %mag = sub %flip, %fill\n    %f = call ptr @$calls, %mag, signature fun(i$n) -> ($f), named all\n    %fb = bitcast %f, to i$fi\n    %neg = lt.s %x, i$n 0\n    %sign = select %neg, i$fi $sign, i$fi 0\n    %rb = xor %fb, %sign\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# a value in range taken apart a word at a time from the top by exact float
# arithmetic, and one out of range saturated, a nan giving zero
val FLOAT_TO_UNSIGNED: str = "function @$name: fun($f) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: $f):\n    %ge = fge.o %x, $f 0\n    %lt = flt.o %x, $f $limit\n    %ok = and %ge, %lt\n    %bits = bitcast %x, to i$fi\n    %kept = select %ok, %bits, i$fi 0\n    %m = bitcast %kept, to $f\n    br ^digit(i$fi $digits, %m, i$n 0)\n^digit(%i: i$fi, %r: $f, %acc: i$n):\n    %wi = mul %i, i$fi $w\n    %down = sub i$fi $bias, %wi\n    %dbits = shl %down, i$fi $sig\n    %dscale = bitcast %dbits, to $f\n    %v = fmul %r, %dscale\n    %hi = ftoi.u %v, to i$w\n    %up = add %wi, i$fi $bias\n    %ubits = shl %up, i$fi $sig\n    %uscale = bitcast %ubits, to $f\n    %hf = itof.u %hi, to $f\n    %back = fmul %hf, %uscale\n    %rest = fsub %r, %back\n    %shifted = shl %acc, i$n $w\n    %word = ext.u %hi, to i$n\n    %acc1 = or %shifted, %word\n    %last = eq %i, i$fi 0\n    %i1 = sub %i, i$fi 1\n    cbr %last, ^out, ^digit(%i1, %rest, %acc1)\n^out:\n    %high = fge.o %x, $f $limit\n    %sat = select %high, i$n -1, i$n 0\n    %res = select %ok, %acc1, %sat\n    ret %res\n}\n";

# the magnitude converted unsigned, negated for a negative value and
# saturated past the signed range
val FLOAT_TO_SIGNED: str = "function @$name: fun($f) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: $f):\n    %a = fabs %x\n    %u = call ptr @$calls, %a, signature fun($f) -> (i$n), named all\n    %neg = flt.o %x, $f 0\n    %big = fge.o %a, $f $half\n    %minus = sub i$n 0, %u\n    %v = select %neg, %minus, %u\n    %sat = select %neg, i$n $least, i$n $most\n    %res = select %big, %sat, %v\n    ret %res\n}\n";

# a byte stored to each address of the run in turn
val FILL: str = "function @$name: fun($pt, i8 zext, i$l zext) -> () linkage weak visibility hidden constant_time {\n^entry(%to: $pt, %byte: i8, %n: i$l):\n    br ^next(i$l 0)\n^next(%i: i$l):\n    %more = lt.u %i, %n\n    cbr %more, ^put, ^done\n^put:\n    %at = ptr.add %to, %i\n    store %at, %byte, align 1\n    %i1 = add %i, i$l 1\n    br ^next(%i1)\n^done:\n    ret\n}\n";

# a byte moved at a time, from the end when the destination is above the
# source, so overlapping ranges copy as a whole
val COPY: str = "function @$name: fun($pt, $pt, i$l zext) -> () linkage weak visibility hidden constant_time {\n^entry(%to: $pt, %from: $pt, %n: i$l):\n    %t = ptrtoint %to, to i$p\n    %s = ptrtoint %from, to i$p\n    %down = gt.u %t, %s\n    cbr %down, ^back(%n), ^ahead(i$l 0)\n^ahead(%i: i$l):\n    %more = lt.u %i, %n\n    cbr %more, ^forward, ^done\n^forward:\n    %src = ptr.add %from, %i\n    %b = load %src, type i8, align 1\n    %dst = ptr.add %to, %i\n    store %dst, %b, align 1\n    %i1 = add %i, i$l 1\n    br ^ahead(%i1)\n^back(%j: i$l):\n    %left = ne %j, i$l 0\n    cbr %left, ^backward, ^done\n^backward:\n    %j1 = sub %j, i$l 1\n    %bsrc = ptr.add %from, %j1\n    %bb = load %bsrc, type i8, align 1\n    %bdst = ptr.add %to, %j1\n    store %bdst, %bb, align 1\n    br ^back(%j1)\n^done:\n    ret\n}\n";

def Rows: [10]Row;

val ROWS: Rows = [10]Row{
    Row{operation: Operation.quotient_u{}, stem: "udiv", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}},
    Row{operation: Operation.quotient_s{}, stem: "sdiv", naming: Naming.width{}, text: SIGNED_QUOTIENT, paired: nil, calls: Operation.quotient_u{}},
    Row{operation: Operation.remainder_u{}, stem: "urem", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}},
    Row{operation: Operation.remainder_s{}, stem: "srem", naming: Naming.width{}, text: SIGNED_REMAINDER, paired: nil, calls: Operation.remainder_u{}},
    Row{operation: Operation.to_float_u{}, stem: "utof", naming: Naming.format{}, text: UNSIGNED_TO_FLOAT, paired: UNSIGNED_TO_FLOAT_PAIR, calls: Operation.unstated{}},
    Row{operation: Operation.to_float_s{}, stem: "stof", naming: Naming.format{}, text: SIGNED_TO_FLOAT, paired: nil, calls: Operation.to_float_u{}},
    Row{operation: Operation.to_integer_u{}, stem: "ftou", naming: Naming.format{}, text: FLOAT_TO_UNSIGNED, paired: nil, calls: Operation.unstated{}},
    Row{operation: Operation.to_integer_s{}, stem: "ftos", naming: Naming.format{}, text: FLOAT_TO_SIGNED, paired: nil, calls: Operation.to_integer_u{}},
    Row{operation: Operation.copy{}, stem: "copy", naming: Naming.width{}, text: COPY, paired: nil, calls: Operation.unstated{}},
    Row{operation: Operation.fill{}, stem: "fill", naming: Naming.width{}, text: FILL, paired: nil, calls: Operation.unstated{}},
};

# whether two operations are the same
pub fun same(a: Operation, b: Operation) bool {
    if (sel a.quotient_u)   { ret sel b.quotient_u; }
    if (sel a.quotient_s)   { ret sel b.quotient_s; }
    if (sel a.remainder_u)  { ret sel b.remainder_u; }
    if (sel a.remainder_s)  { ret sel b.remainder_s; }
    if (sel a.to_float_u)   { ret sel b.to_float_u; }
    if (sel a.to_float_s)   { ret sel b.to_float_s; }
    if (sel a.to_integer_u) { ret sel b.to_integer_u; }
    if (sel a.to_integer_s) { ret sel b.to_integer_s; }
    if (sel a.copy)         { ret sel b.copy; }
    if (sel a.fill)         { ret sel b.fill; }
    ret sel b.unstated;
}

# the row of an operation, none for one no helper does
pub fun row(op: Operation) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (same(ROWS[i].operation, op)) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}
