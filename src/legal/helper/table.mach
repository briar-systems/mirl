# the helpers mirl delivers: the one table of their names and texts
#
# a helper is an ordinary function of the module that calls it, written once
# here in the ir text form with its widths and constants left as `$` names,
# which the delivery fills in for the width, the number format and the target
# it is asked for. a module holds each at most once, weak and hidden, so every
# module's copy of a helper with one name is the same function and the linker
# keeps one. its name is mirl's own: the prefix, the row's stem, the width and,
# for a conversion, the number format, so no name a front end makes collides
# with it.
#
# each helper is written so its time depends on no value it is given but a
# length: a division and a product run one step per bit, choosing with
# selects or masks, a float remainder one step per exponent of its format, and
# a conversion is straight line code. a copy or fill runs one step per byte of
# its length. every one is declared constant time.
#
# the soft rows compute a float of a format the build holds no unit for on the
# integer that is its encoding, with integer instructions alone, so they serve
# a target with no float unit. each unpacks its operands into a sign, an
# exponent and a significand with selects, computes the exact result or its
# leading bits and a sticky bit, and calls the one rounding, the pack, which
# rounds to nearest with ties to even. a division, a square root and a
# remainder run a fixed count of steps for their format, so none branches on a
# value. every nan an operation gives, conversions included, is the one `$nan`
# the delivery fills in by the rule the target's row of the format states for
# its helpers, see `mirl.target.capability.Lowered`. the key of an encoding, its
# bits with every bit flipped where its sign is set and the sign bit set where
# it is not, orders the numbers it encodes as unsigned integers, negative zero
# below positive zero, which the bounds and the comparison read.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;

# what a helper does
# ---
# quotient_u:   the unsigned quotient of two integers
# quotient_s:   the signed quotient, from the unsigned one of the magnitudes
# remainder_u:  the unsigned remainder
# remainder_s:  the signed remainder, from the unsigned one of the magnitudes
# to_float_u:   an unsigned integer to a float, rounded once
# to_float_s:   a signed integer to a float, from the unsigned conversion
# to_integer_u: a float to an unsigned integer, saturating, zero for a nan
# to_integer_s: a float to a signed integer, from the unsigned conversion
# copy:         a copy of a run of bytes whose ranges may overlap
# fill:         a fill of a run of bytes with one byte
# product:      the low half of the product of two integers
# remainder_f:  the remainder of two floats, of the quotient truncated toward
#               zero
# soft_pack:    a sign, exponent and significand of an encoding rounded and
#               packed into it
# soft_add .. soft_remainder: the float operation of the same name on encodings
# soft_compare: how two encodings order, as a mask of less, equal, greater and
#               unordered
# soft_from_u:  an unsigned integer to an encoding
# soft_from_s:  a signed integer to an encoding, from the unsigned conversion
# soft_to_u:    an encoding to an unsigned integer, saturating, zero for a nan
# soft_to_s:    an encoding to a signed integer, from the unsigned conversion
# soft_convert: an encoding of one format to one of another
pub tag Operation: u8 {
    unstated;
    quotient_u;
    quotient_s;
    remainder_u;
    remainder_s;
    to_float_u;
    to_float_s;
    to_integer_u;
    to_integer_s;
    copy;
    fill;
    product;
    remainder_f;
    soft_pack;
    soft_add;
    soft_sub;
    soft_mul;
    soft_div;
    soft_sqrt;
    soft_fma;
    soft_min;
    soft_max;
    soft_minnum;
    soft_maxnum;
    soft_floor;
    soft_ceil;
    soft_trunc;
    soft_nearest;
    soft_remainder;
    soft_compare;
    soft_from_u;
    soft_from_s;
    soft_to_u;
    soft_to_s;
    soft_convert;
}

# how a helper's name is made after its stem
# ---
# width:   the width of its integer, or of its length
# format:  the width of its integer, then the name of its number format
# float:   the name of its number format alone
# formats: the name of the format it converts from, then the one it converts to
pub tag Naming: u8 {
    width;
    format;
    float;
    formats;
}

# one helper
# ---
# operation: what it does
# stem:      its name between the prefix and the width
# naming:    what its name is made of after the stem
# text:      its text, to be filled in
# paired:    the text the delivery chooses in place of text for a want the
#            first does not hold: a conversion to a float whose rounding needs
#            the bits of two words, or a soft conversion from an integer wider
#            than two words, nil for every other row
# calls:     the helper its text calls, unstated for none
# stands:    the operation of `mirl.target.OPTIONAL` it stands in for where a
#            held format has no native form of it, none for a row the pass
#            finds by its opcode's algebra, fold entry or operand roles
# computes:  the float operation a soft row computes on encodings, none for a
#            row the soft legalisation finds by its fold entry or for any
#            other row
pub rec Row {
    operation: Operation;
    stem:      str;
    naming:    Naming;
    text:      str;
    paired:    str;
    calls:     Operation;
    stands:    opt[Opcode];
    computes:  opt[Opcode];
}

# the prefix of every helper's name
pub val PREFIX: str = "__mirl_";

# restoring division, one bit of the dividend a step from the top, the
# remainder carrying the bit it shifts out, keeping the quotient or remainder
val UNSIGNED_DIVISION: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(n: ^i$n, d: ^i$n) i$n {\n    br step($n, n, 0, 0);\nstep(k: i32, a: ^i$n, q: ^i$n, r: ^i$n):\n    val carry: ^i$n = shr.u(r, $top);\n    val high: ^i$n = shr.u(a, $top);\n    val r1: ^i$n = shl(r, 1);\n    val r2: ^i$n = or(r1, high);\n    val a1: ^i$n = shl(a, 1);\n    val q1: ^i$n = shl(q, 1);\n    val over: ^i1 = ne(carry, 0);\n    val fits: ^i1 = ge.u(r2, d);\n    val take: ^i1 = or(over, fits);\n    val r3: ^i$n = sub(r2, d);\n    val r4: ^i$n = select(take, r3, r2);\n    val bit: ^i$n = ext.u[i$n](take);\n    val q2: ^i$n = or(q1, bit);\n    val k1: i32 = sub(k, 1);\n    val more: i1 = ne(k1, 0);\n    cbr(more) step(k1, a1, q2, r4), done;\ndone:\n    ret($result);\n}\n";

# the unsigned quotient of the magnitudes, negated where the signs differ
val SIGNED_QUOTIENT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(n: ^i$n, d: ^i$n) i$n {\n    val nf: ^i$n = shr.s(n, $top);\n    val df: ^i$n = shr.s(d, $top);\n    val nx: ^i$n = xor(n, nf);\n    val na: ^i$n = sub(nx, nf);\n    val dx: ^i$n = xor(d, df);\n    val da: ^i$n = sub(dx, df);\n    val u: ^i$n = call $calls(na, da);\n    val s: ^i$n = xor(nf, df);\n    val ux: ^i$n = xor(u, s);\n    val v: ^i$n = sub(ux, s);\n    ret(v);\n}\n";

# the unsigned remainder of the magnitudes, with the sign of the dividend
val SIGNED_REMAINDER: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(n: ^i$n, d: ^i$n) i$n {\n    val nf: ^i$n = shr.s(n, $top);\n    val df: ^i$n = shr.s(d, $top);\n    val nx: ^i$n = xor(n, nf);\n    val na: ^i$n = sub(nx, nf);\n    val dx: ^i$n = xor(d, df);\n    val da: ^i$n = sub(dx, df);\n    val u: ^i$n = call $calls(na, da);\n    val ux: ^i$n = xor(u, nf);\n    val v: ^i$n = sub(ux, nf);\n    ret(v);\n}\n";

# the integer shifted up past its leading zeros, its top bits and a sticky bit
# for the rest converted in one word, then scaled by the exact power of two
val UNSIGNED_TO_FLOAT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n) $f {\n    val lz: i$n = clz(x);\n    val cur: i$n = shl(x, lz);\n    val topn: i$n = shr.u(cur, $nk);\n    val top: i$w = trunc[i$w](topn);\n    val below: i$n = shl(cur, $k);\n    val any: i1 = ne(below, 0);\n    val sticky: i$w = ext.u[i$w](any);\n    val t: i$w = or(top, sticky);\n    val f: $f = itof.u[$f](t);\n    val lzt: i$fi = $fit;\n    val e: i$fi = sub($nk, lzt);\n    val over: i1 = gt.s(e, $emax);\n    val biased: i$fi = add(e, $bias);\n    val sbits: i$fi = shl(biased, $sig);\n    val scale: $f = bitcast[$f](sbits);\n    val v: $f = fmul(f, scale);\n    val vb: i$fi = bitcast[i$fi](v);\n    val rb: i$fi = select(over, $inf, vb);\n    val r: $f = bitcast[$f](rb);\n    ret(r);\n}\n";

# as the one word conversion, for a format whose rounding needs more bits than a
# word: the top two words converted exactly and added, which rounds once
val UNSIGNED_TO_FLOAT_PAIR: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n) $f {\n    val lz: i$n = clz(x);\n    val cur: i$n = shl(x, lz);\n    val hin: i$n = shr.u(cur, $nw);\n    val hi: i$w = trunc[i$w](hin);\n    val lon: i$n = shr.u(cur, $n2w);\n    val lo0: i$w = trunc[i$w](lon);\n    val below: i$n = shl(cur, $w2);\n    val any: i1 = ne(below, 0);\n    val sticky: i$w = ext.u[i$w](any);\n    val lo: i$w = or(lo0, sticky);\n    val fh: $f = itof.u[$f](hi);\n    val fl: $f = itof.u[$f](lo);\n    val fw: $f = fmul(fh, $word);\n    val f: $f = fadd(fw, fl);\n    val lzt: i$fi = $fit;\n    val e: i$fi = sub($n2w, lzt);\n    val over: i1 = gt.s(e, $emax);\n    val biased: i$fi = add(e, $bias);\n    val sbits: i$fi = shl(biased, $sig);\n    val scale: $f = bitcast[$f](sbits);\n    val v: $f = fmul(f, scale);\n    val vb: i$fi = bitcast[i$fi](v);\n    val rb: i$fi = select(over, $inf, vb);\n    val r: $f = bitcast[$f](rb);\n    ret(r);\n}\n";

# the magnitude converted unsigned, the sign put back in the sign bit
val SIGNED_TO_FLOAT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n) $f {\n    val fill: i$n = shr.s(x, $top);\n    val flip: i$n = xor(x, fill);\n    val mag: i$n = sub(flip, fill);\n    val f: $f = call $calls(mag);\n    val fb: i$fi = bitcast[i$fi](f);\n    val neg: i1 = lt.s(x, 0);\n    val sign: i$fi = select(neg, $sign, 0);\n    val rb: i$fi = xor(fb, sign);\n    val r: $f = bitcast[$f](rb);\n    ret(r);\n}\n";

# a value in range taken apart a word at a time from the top by exact float
# arithmetic, and one out of range saturated, a nan giving zero
val FLOAT_TO_UNSIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: $f) i$n {\n    val ge: i1 = fge.o(x, 0x0);\n    val lt: i1 = flt.o(x, $limit);\n    val ok: i1 = and(ge, lt);\n    val bits: i$fi = bitcast[i$fi](x);\n    val kept: i$fi = select(ok, bits, 0);\n    val m: $f = bitcast[$f](kept);\n    br digit($digits, m, 0);\ndigit(i: i$fi, r: $f, acc: i$n):\n    val wi: i$fi = mul(i, $w);\n    val down: i$fi = sub($bias, wi);\n    val dbits: i$fi = shl(down, $sig);\n    val dscale: $f = bitcast[$f](dbits);\n    val v: $f = fmul(r, dscale);\n    val hi: i$w = ftoi.u[i$w](v);\n    val up: i$fi = add(wi, $bias);\n    val ubits: i$fi = shl(up, $sig);\n    val uscale: $f = bitcast[$f](ubits);\n    val hf: $f = itof.u[$f](hi);\n    val back: $f = fmul(hf, uscale);\n    val rest: $f = fsub(r, back);\n    val shifted: i$n = shl(acc, $w);\n    val word: i$n = ext.u[i$n](hi);\n    val acc1: i$n = or(shifted, word);\n    val last: i1 = eq(i, 0);\n    val i1: i$fi = sub(i, 1);\n    cbr(last) out, digit(i1, rest, acc1);\nout:\n    val high: i1 = fge.o(x, $limit);\n    val sat: i$n = select(high, -1, 0);\n    val res: i$n = select(ok, acc1, sat);\n    ret(res);\n}\n";

# the magnitude converted unsigned, negated for a negative value and
# saturated past the signed range
val FLOAT_TO_SIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: $f) i$n {\n    val a: $f = fabs(x);\n    val u: i$n = call $calls(a);\n    val neg: i1 = flt.o(x, 0x0);\n    val big: i1 = fge.o(a, $half);\n    val minus: i$n = sub(0, u);\n    val v: i$n = select(neg, minus, u);\n    val sat: i$n = select(neg, $least, $most);\n    val res: i$n = select(big, sat, v);\n    ret(res);\n}\n";

# a byte stored to each address of the run in turn
val FILL: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(to: $pt, byte: i8 zext, n: i$l zext) {\n    br next(0);\nnext(i: i$l):\n    val more: i1 = lt.u(i, n);\n    cbr(more) put, done;\nput:\n    val at: $pt = ptr.add(to, i);\n    store(at, byte);\n    val i1: i$l = add(i, 1);\n    br next(i1);\ndone:\n    ret();\n}\n";

# a byte moved at a time, from the end when the destination is above the
# source, so overlapping ranges copy as a whole
val COPY: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(to: $pt, from: $pt, n: i$l zext) {\n    val t: i$p = ptrtoint[i$p](to);\n    val s: i$p = ptrtoint[i$p](from);\n    val down: i1 = gt.u(t, s);\n    cbr(down) back(n), ahead(0);\nahead(i: i$l):\n    val more: i1 = lt.u(i, n);\n    cbr(more) forward, done;\nforward:\n    val src: $pt = ptr.add(from, i);\n    val b: i8 = load[i8](src);\n    val dst: $pt = ptr.add(to, i);\n    store(dst, b);\n    val i1: i$l = add(i, 1);\n    br ahead(i1);\nback(j: i$l):\n    val left: i1 = ne(j, 0);\n    cbr(left) backward, done;\nbackward:\n    val j1: i$l = sub(j, 1);\n    val bsrc: $pt = ptr.add(from, j1);\n    val bb: i8 = load[i8](bsrc);\n    val bdst: $pt = ptr.add(to, j1);\n    store(bdst, bb);\n    br back(j1);\ndone:\n    ret();\n}\n";

# shift and add, one bit of the second operand a step from the bottom, the
# first operand shifted up and added where the bit is set through a mask, so
# no step depends on a value
val PRODUCT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n, b: i$n) i$n {\n    br step($n, a, b, 0);\nstep(k: i32, x: i$n, y: i$n, p: i$n):\n    val low: i$n = and(y, 1);\n    val mask: i$n = sub(0, low);\n    val add: i$n = and(x, mask);\n    val p1: i$n = add(p, add);\n    val x1: i$n = shl(x, 1);\n    val y1: i$n = shr.u(y, 1);\n    val k1: i32 = sub(k, 1);\n    val more: i1 = ne(k1, 0);\n    cbr(more) step(k1, x1, y1, p1), done;\ndone:\n    ret(p1);\n}\n";

# the magnitude of the dividend less the divisor's magnitude scaled by each
# power of two from the one that brings it to the largest exponent down, where
# it is no greater: each difference is exact, since the scaled divisor is at
# least half the rest. the divisor is scaled into the normal range first where
# it is subnormal, so its scale has the largest exponent and its significand.
# the sign of the dividend goes back on, and a nan operand gives a nan, an
# infinite dividend or a zero divisor the canonical nan, as the folder does
val FLOAT_REMAINDER: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: $f, y: $f) $f {\n    val ax: $f = fabs(x);\n    val ay: $f = fabs(y);\n    val small: i1 = flt.o(ay, $normal);\n    val up: $f = fmul(ay, $scale);\n    val b: $f = select(small, up, ay);\n    val bb: i$fi = bitcast[i$fi](b);\n    val frac: i$fi = and(bb, $fraction);\n    val cb: i$fi = or(frac, $high);\n    val c: $f = bitcast[$f](cb);\n    br step($steps, ax, c);\nstep(k: i32, a: $f, s: $f):\n    val ge: i1 = fge.o(a, s);\n    val above: i1 = fge.o(s, ay);\n    val take: i1 = and(ge, above);\n    val d: $f = fsub(a, s);\n    val a1: $f = select(take, d, a);\n    val s1: $f = fmul(s, $half);\n    val k1: i32 = sub(k, 1);\n    val more: i1 = ne(k1, 0);\n    cbr(more) step(k1, a1, s1), done;\ndone:\n    val r: $f = fcopysign(a1, x);\n    val inf: i1 = feq.o(ax, $inf);\n    val zero_1: i1 = feq.o(ay, 0x0);\n    val bad: i1 = or(inf, zero_1);\n    val v: $f = select(bad, $nan, r);\n    val uno: i1 = funo(x, y);\n    val sum: $f = fadd(x, y);\n    val w: $f = select(uno, sum, v);\n    ret(w);\n}\n";

# the value of a sign, an exponent and a significand of two words, rounded
# once to nearest with ties to even: normalised past its leading zeros,
# shifted down to the precision or, below the normal range, to the least
# subnormal, the shifted out bits the round and sticky bits, and the encoding
# made by adding the rounded significand to the exponent field, so a carry
# moves into it
val SOFT_PACK: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(s: i$n$nx, e: i$n$nx, m: i$d) i$n$nx {\n    val zero_1: i1 = eq(m, 0);\n    val hi: i$d = shr.u(m, $dtop);\n    val wide: i1 = ne(hi, 0);\n    val m0: i$d = shr.u(m, 1);\n    val lowb: i$d = and(m, 1);\n    val m0s: i$d = or(m0, lowb);\n    val m1: i$d = select(wide, m0s, m);\n    val eb: i$n = ext.u[i$n](wide);\n    val e1: i$n = add(e, eb);\n    val lz: i$d = clz(m1);\n    val lzs: i$d = select(zero_1, 1, lz);\n    val by: i$d = sub(lzs, 1);\n    val mn: i$d = shl(m1, by);\n    val lzn: i$n = trunc[i$n](lzs);\n    val t0: i$n = sub($dtop, lzn);\n    val t: i$n = add(e1, t0);\n    val be: i$n = add(t, $bias);\n    val under: i1 = lt.s(be, 1);\n    val ex0: i$n = sub(1, be);\n    val ex: i$n = select(under, ex0, 0);\n    val sh0: i$n = add(ex, $base);\n    val far: i1 = gt.s(sh0, $dtop);\n    val shc: i$n = select(far, $dtop, sh0);\n    val mnz: i1 = ne(mn, 0);\n    val tiny: i$d = ext.u[i$d](mnz);\n    val mf: i$d = select(far, tiny, mn);\n    val sh: i$d = ext.u[i$d](shc);\n    val r: i$d = shr.u(mf, sh);\n    val one: i$d = shl(1, sh);\n    val low: i$d = sub(one, 1);\n    val rem: i$d = and(mf, low);\n    val half: i$d = shr.u(one, 1);\n    val above: i1 = gt.u(rem, half);\n    val tie: i1 = eq(rem, half);\n    val odd: i$d = and(r, 1);\n    val isodd: i1 = ne(odd, 0);\n    val tieup: i1 = and(tie, isodd);\n    val up: i1 = or(above, tieup);\n    val upb: i$d = ext.u[i$d](up);\n    val r2: i$d = add(r, upb);\n    val bm: i$n = sub(be, 1);\n    val neg: i1 = lt.s(bm, 0);\n    val fm: i$n = select(neg, 0, bm);\n    val fmd: i$d = ext.u[i$d](fm);\n    val fs: i$d = shl(fmd, $sig);\n    val enc: i$d = add(fs, r2);\n    val over: i1 = ge.u(enc, $inf);\n    val encn: i$n = trunc[i$n](enc);\n    val fin: i$n = select(over, $inf, encn);\n    val res0: i$n = select(zero_1, 0, fin);\n    val res: i$n = or(res0, s);\n    ret(res);\n}\n";

# the larger magnitude and the smaller aligned below it with three guard bits
# and a sticky bit, added or subtracted, and packed
val SOFT_ADD: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val ba: i$n = and(b, $abs);\n    val bs: i$n = and(b, $sign);\n    val bnan: i1 = gt.u(ba, $inf);\n    val binf: i1 = eq(ba, $inf);\n    val bz: i1 = eq(ba, 0);\n    val bf: i$n = shr.u(ba, $sig);\n    val bsub: i1 = eq(bf, 0);\n    val bfr: i$n = and(b, $frac);\n    val bm1: i$n = or(bfr, $one);\n    val bm: i$n = select(bsub, bfr, bm1);\n    val bf1: i$n = select(bsub, 1, bf);\n    val be: i$n = sub(bf1, $unit);\n    val differ: i1 = ne(as, bs);\n    val both: i1 = and(ainf, binf);\n    val clash: i1 = and(both, differ);\n    val nan0: i1 = or(anan, bnan);\n    val nan: i1 = or(nan0, clash);\n    val inf: i1 = or(ainf, binf);\n    val infv: i$n = select(ainf, a, b);\n    val swap: i1 = lt.u(aa, ba);\n    val xs: i$n = select(swap, bs, as);\n    val ys: i$n = select(swap, as, bs);\n    val xm: i$n = select(swap, bm, am);\n    val ym: i$n = select(swap, am, bm);\n    val xe: i$n = select(swap, bf1, af1);\n    val ye: i$n = select(swap, af1, bf1);\n    val dist: i$n = sub(xe, ye);\n    val far: i1 = gt.u(dist, $top);\n    val dc: i$n = select(far, $top, dist);\n    val xm3: i$n = shl(xm, 3);\n    val ym3: i$n = shl(ym, 3);\n    val yal: i$n = shr.u(ym3, dc);\n    val bit: i$n = shl(1, dc);\n    val lowm: i$n = sub(bit, 1);\n    val lost: i$n = and(ym3, lowm);\n    val st: i1 = ne(lost, 0);\n    val stb: i$n = ext.u[i$n](st);\n    val yj: i$n = or(yal, stb);\n    val same: i1 = eq(xs, ys);\n    val sum: i$n = add(xm3, yj);\n    val dif: i$n = sub(xm3, yj);\n    val m: i$n = select(same, sum, dif);\n    val mz: i1 = eq(m, 0);\n    val zs: i$n = and(as, bs);\n    val s: i$n = select(mz, zs, xs);\n    val e: i$n = sub(xe, $unit3);\n    val md: i$d = ext.u[i$d](m);\n    val pk: i$n = call $calls(s, e, md);\n    val v: i$n = select(inf, infv, pk);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# the sum with the second operand's sign flipped
val SOFT_SUB: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val nb: i$n = xor(b, $sign);\n    val r: i$n = call $calls(a, nb);\n    ret(r);\n}\n";

# the exact product of the significands at two words, packed
val SOFT_MUL: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val ba: i$n = and(b, $abs);\n    val bs: i$n = and(b, $sign);\n    val bnan: i1 = gt.u(ba, $inf);\n    val binf: i1 = eq(ba, $inf);\n    val bz: i1 = eq(ba, 0);\n    val bf: i$n = shr.u(ba, $sig);\n    val bsub: i1 = eq(bf, 0);\n    val bfr: i$n = and(b, $frac);\n    val bm1: i$n = or(bfr, $one);\n    val bm: i$n = select(bsub, bfr, bm1);\n    val bf1: i$n = select(bsub, 1, bf);\n    val be: i$n = sub(bf1, $unit);\n    val s: i$n = xor(as, bs);\n    val n0: i1 = or(anan, bnan);\n    val n1: i1 = and(ainf, bz);\n    val n2: i1 = and(binf, az);\n    val n3: i1 = or(n0, n1);\n    val nan: i1 = or(n3, n2);\n    val inf: i1 = or(ainf, binf);\n    val amd: i$d = ext.u[i$d](am);\n    val bmd: i$d = ext.u[i$d](bm);\n    val p: i$d = mul(amd, bmd);\n    val e: i$n = add(ae, be);\n    val pk: i$n = call $calls(s, e, p);\n    val infv: i$n = or(s, $inf);\n    val v: i$n = select(inf, infv, pk);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# restoring division of the normalised significands, one quotient bit a step
# past the precision and two more, the remainder the sticky bit, packed
val SOFT_DIV: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val ba: i$n = and(b, $abs);\n    val bs: i$n = and(b, $sign);\n    val bnan: i1 = gt.u(ba, $inf);\n    val binf: i1 = eq(ba, $inf);\n    val bz: i1 = eq(ba, 0);\n    val bf: i$n = shr.u(ba, $sig);\n    val bsub: i1 = eq(bf, 0);\n    val bfr: i$n = and(b, $frac);\n    val bm1: i$n = or(bfr, $one);\n    val bm: i$n = select(bsub, bfr, bm1);\n    val bf1: i$n = select(bsub, 1, bf);\n    val be: i$n = sub(bf1, $unit);\n    val alz0: i$n = clz(am);\n    val alz: i$n = sub(alz0, $gap);\n    val amn: i$n = shl(am, alz);\n    val aen: i$n = sub(ae, alz);\n    val blz0: i$n = clz(bm);\n    val blz: i$n = sub(blz0, $gap);\n    val bmn: i$n = shl(bm, blz);\n    val ben: i$n = sub(be, blz);\n    val s: i$n = xor(as, bs);\n    val n0: i1 = or(anan, bnan);\n    val n1: i1 = and(ainf, binf);\n    val n2: i1 = and(az, bz);\n    val n3: i1 = or(n0, n1);\n    val nan: i1 = or(n3, n2);\n    val inf: i1 = or(ainf, bz);\n    val zero_1: i1 = or(az, binf);\n    br step($steps, amn, 0);\nstep(k: i$n, r: i$n, q: i$n):\n    val ge: i1 = ge.u(r, bmn);\n    val r1: i$n = sub(r, bmn);\n    val r2: i$n = select(ge, r1, r);\n    val q1: i$n = shl(q, 1);\n    val gb: i$n = ext.u[i$n](ge);\n    val q2: i$n = or(q1, gb);\n    val r3: i$n = shl(r2, 1);\n    val k1: i$n = sub(k, 1);\n    val more: i1 = ne(k1, 0);\n    cbr(more) step(k1, r3, q2), done;\ndone:\n    val st: i1 = ne(r3, 0);\n    val stb: i$n = ext.u[i$n](st);\n    val m: i$n = or(q2, stb);\n    val e0: i$n = sub(aen, ben);\n    val e: i$n = sub(e0, $steps1);\n    val md: i$d = ext.u[i$d](m);\n    val pk: i$n = call $calls(s, e, md);\n    val infv: i$n = or(s, $inf);\n    val v0: i$n = select(zero_1, s, pk);\n    val v: i$n = select(inf, infv, v0);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# the exponent made even, the significand scaled past the precision and two
# more bits of root, the integer root one bit a step over two words, the
# remainder the sticky bit, packed
val SOFT_SQRT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val alz0: i$n = clz(am);\n    val alz: i$n = sub(alz0, $gap);\n    val amn: i$n = shl(am, alz);\n    val aen: i$n = sub(ae, alz);\n    val neg: i1 = ne(as, 0);\n    val below: i1 = xor(az, 1);\n    val bad: i1 = and(neg, below);\n    val nan: i1 = or(anan, bad);\n    val keep: i1 = or(az, ainf);\n    val odd: i$n = and(aen, 1);\n    val m2: i$n = shl(amn, odd);\n    val e2: i$n = sub(aen, odd);\n    val md: i$d = ext.u[i$d](m2);\n    val x: i$d = shl(md, $twok);\n    br step($rounds, x, 0, $bit);\nstep(k: i$n, num: i$d, res: i$d, bit: i$d):\n    val rb: i$d = add(res, bit);\n    val ge: i1 = ge.u(num, rb);\n    val n1: i$d = sub(num, rb);\n    val num2: i$d = select(ge, n1, num);\n    val rs: i$d = shr.u(res, 1);\n    val rsb: i$d = add(rs, bit);\n    val res2: i$d = select(ge, rsb, rs);\n    val bit2: i$d = shr.u(bit, 2);\n    val k1: i$n = sub(k, 1);\n    val more: i1 = ne(k1, 0);\n    cbr(more) step(k1, num2, res2, bit2), done;\ndone:\n    val st: i1 = ne(num2, 0);\n    val stb: i$d = ext.u[i$d](st);\n    val m: i$d = or(res2, stb);\n    val e3: i$n = sub(e2, $twok);\n    val e: i$n = shr.s(e3, 1);\n    val pk: i$n = call $calls(0, e, m);\n    val v: i$n = select(keep, a, pk);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# the exact product and the addend placed in a frame of four words by the
# larger of their top exponents, the other shifted below with a sticky bit,
# added or subtracted, cut to two words with a sticky bit and packed once
val SOFT_FMA: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx, c: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val ba: i$n = and(b, $abs);\n    val bs: i$n = and(b, $sign);\n    val bnan: i1 = gt.u(ba, $inf);\n    val binf: i1 = eq(ba, $inf);\n    val bz: i1 = eq(ba, 0);\n    val bf: i$n = shr.u(ba, $sig);\n    val bsub: i1 = eq(bf, 0);\n    val bfr: i$n = and(b, $frac);\n    val bm1: i$n = or(bfr, $one);\n    val bm: i$n = select(bsub, bfr, bm1);\n    val bf1: i$n = select(bsub, 1, bf);\n    val be: i$n = sub(bf1, $unit);\n    val ca: i$n = and(c, $abs);\n    val cs: i$n = and(c, $sign);\n    val cnan: i1 = gt.u(ca, $inf);\n    val cinf: i1 = eq(ca, $inf);\n    val cz: i1 = eq(ca, 0);\n    val cf: i$n = shr.u(ca, $sig);\n    val csub: i1 = eq(cf, 0);\n    val cfr: i$n = and(c, $frac);\n    val cm1: i$n = or(cfr, $one);\n    val cm: i$n = select(csub, cfr, cm1);\n    val cf1: i$n = select(csub, 1, cf);\n    val ce: i$n = sub(cf1, $unit);\n    val alz0: i$n = clz(am);\n    val alz: i$n = sub(alz0, $gap);\n    val amn: i$n = shl(am, alz);\n    val aen: i$n = sub(ae, alz);\n    val blz0: i$n = clz(bm);\n    val blz: i$n = sub(blz0, $gap);\n    val bmn: i$n = shl(bm, blz);\n    val ben: i$n = sub(be, blz);\n    val clz0: i$n = clz(cm);\n    val clz: i$n = sub(clz0, $gap);\n    val cmn: i$n = shl(cm, clz);\n    val cen: i$n = sub(ce, clz);\n    val sp: i$n = xor(as, bs);\n    val pz: i1 = or(az, bz);\n    val pinf: i1 = or(ainf, binf);\n    val n0: i1 = or(anan, bnan);\n    val n1: i1 = or(n0, cnan);\n    val n2: i1 = and(ainf, bz);\n    val n3: i1 = and(binf, az);\n    val n4: i1 = or(n2, n3);\n    val n5: i1 = or(n1, n4);\n    val sdiff: i1 = ne(sp, cs);\n    val n6: i1 = and(pinf, cinf);\n    val n7: i1 = and(n6, sdiff);\n    val nan: i1 = or(n5, n7);\n    val amd: i$d = ext.u[i$d](amn);\n    val bmd: i$d = ext.u[i$d](bmn);\n    val mp: i$d = mul(amd, bmd);\n    val ep: i$n = add(aen, ben);\n    val tp0: i$n = add(ep, $p2);\n    val tc0: i$n = add(cen, $p);\n    val tp: i$n = select(pz, tc0, tp0);\n    val tc: i$n = select(cz, tp, tc0);\n    val pbig: i1 = ge.s(tp, tc);\n    val tbig: i$n = select(pbig, tp, tc);\n    val u: i$n = sub(tbig, $qtop1);\n    val pd: i$n = sub(ep, u);\n    val ppos: i1 = ge.s(pd, 0);\n    val pnd: i$n = sub(0, pd);\n    val pl1: i$n = select(ppos, pd, 0);\n    val plf: i1 = gt.s(pl1, $qtop);\n    val pl0: i$n = select(plf, $qtop, pl1);\n    val pr0: i$n = select(ppos, 0, pnd);\n    val prf: i1 = gt.s(pr0, $qtop);\n    val prc: i$n = select(prf, $qtop, pr0);\n    val plq: i$q = ext.u[i$q](pl0);\n    val prq: i$q = ext.u[i$q](prc);\n    val pmq: i$q = ext.u[i$q](mp);\n    val pleft: i$q = shl(pmq, plq);\n    val pright: i$q = shr.u(pmq, prq);\n    val pbit: i$q = shl(1, prq);\n    val plowm: i$q = sub(pbit, 1);\n    val plost: i$q = and(pmq, plowm);\n    val pst: i1 = ne(plost, 0);\n    val pstb: i$q = ext.u[i$q](pst);\n    val prj: i$q = or(pright, pstb);\n    val pF: i$q = select(ppos, pleft, prj);\n    val cd: i$n = sub(cen, u);\n    val cpos: i1 = ge.s(cd, 0);\n    val cnd: i$n = sub(0, cd);\n    val cl1: i$n = select(cpos, cd, 0);\n    val clf: i1 = gt.s(cl1, $qtop);\n    val cl0: i$n = select(clf, $qtop, cl1);\n    val cr0: i$n = select(cpos, 0, cnd);\n    val crf: i1 = gt.s(cr0, $qtop);\n    val crc: i$n = select(crf, $qtop, cr0);\n    val clq: i$q = ext.u[i$q](cl0);\n    val crq: i$q = ext.u[i$q](crc);\n    val cmq: i$q = ext.u[i$q](cmn);\n    val cleft: i$q = shl(cmq, clq);\n    val cright: i$q = shr.u(cmq, crq);\n    val cbit: i$q = shl(1, crq);\n    val clowm: i$q = sub(cbit, 1);\n    val clost: i$q = and(cmq, clowm);\n    val cst: i1 = ne(clost, 0);\n    val cstb: i$q = ext.u[i$q](cst);\n    val crj: i$q = or(cright, cstb);\n    val cF: i$q = select(cpos, cleft, crj);\n    val same: i1 = eq(sp, cs);\n    val sum: i$q = add(pF, cF);\n    val pge: i1 = ge.u(pF, cF);\n    val d1: i$q = sub(pF, cF);\n    val d2: i$q = sub(cF, pF);\n    val dif: i$q = select(pge, d1, d2);\n    val ds: i$n = select(pge, sp, cs);\n    val S: i$q = select(same, sum, dif);\n    val s0: i$n = select(same, sp, ds);\n    val Sz: i1 = eq(S, 0);\n    val zs: i$n = and(sp, cs);\n    val s: i$n = select(Sz, zs, s0);\n    val lz0: i$q = clz(S);\n    val lz: i$q = select(Sz, 0, lz0);\n    val Sn: i$q = shl(S, lz);\n    val hi: i$q = shr.u(Sn, $d);\n    val m0: i$d = trunc[i$d](hi);\n    val lo: i$q = shl(Sn, $d);\n    val lost: i1 = ne(lo, 0);\n    val lb: i$d = ext.u[i$d](lost);\n    val m: i$d = or(m0, lb);\n    val lzn: i$n = trunc[i$n](lz);\n    val e0: i$n = sub(u, lzn);\n    val e: i$n = add(e0, $d);\n    val pk: i$n = call $calls(s, e, m);\n    val pinfv: i$n = or(sp, $inf);\n    val v0: i$n = select(cinf, c, pk);\n    val v: i$n = select(pinf, pinfv, v0);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# the operand an order of the keys chooses, a nan where either operand is one,
# or for the number forms the other operand where one is
val SOFT_BOUND: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val ba: i$n = and(b, $abs);\n    val an: i1 = gt.u(aa, $inf);\n    val bn: i1 = gt.u(ba, $inf);\n    val afill: i$n = shr.s(a, $top);\n    val aflip: i$n = or(afill, $sign);\n    val ak: i$n = xor(a, aflip);\n    val bfill: i$n = shr.s(b, $top);\n    val bflip: i$n = or(bfill, $sign);\n    val bk: i$n = xor(b, bflip);\n    val c: i1 = $order(ak, bk);\n    val v: i$n = select(c, a, b);\n    val both: i1 = and(an, bn);\n    val either: i1 = or(an, bn);\n    val other: i$n = select(an, b, a);\n    val keep: i1 = ne($num::i$n, 0::i$n);\n    val fallback: i$n = select(keep, other, $nan);\n    val r1: i$n = select(either, fallback, v);\n    val r2: i$n = select(both, $nan, r1);\n    ret(r2);\n}\n";

# the fraction bits of the encoding cleared, a unit added where the rounding's
# rule rounds away, a carry moving into the exponent, and a magnitude below
# one made a signed zero or a signed one
val SOFT_ROUND: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n$nx) i$n$nx {\n    val s: i$n = and(x, $sign);\n    val a: i$n = and(x, $abs);\n    val nan: i1 = gt.u(a, $inf);\n    val ef: i$n = shr.u(a, $sig);\n    val u: i$n = sub(ef, $bias);\n    val big: i1 = ge.s(u, $sig);\n    val small: i1 = lt.s(u, 0);\n    val neg: i1 = ne(s, 0);\n    val pos: i1 = xor(neg, 1);\n    val nz: i1 = ne(a, 0);\n    val fl: i1 = ne($floor::i$n, 0::i$n);\n    val ce: i1 = ne($ceil::i$n, 0::i$n);\n    val ne: i1 = ne($even::i$n, 0::i$n);\n    val out: i1 = or(big, small);\n    val fb0: i$n = sub($sig, u);\n    val fb: i$n = select(out, 1, fb0);\n    val unit: i$n = shl(1, fb);\n    val mask: i$n = sub(unit, 1);\n    val frac: i$n = and(a, mask);\n    val int: i$n = xor(a, frac);\n    val fb1: i$n = sub(fb, 1);\n    val halfv: i$n = shl(1, fb1);\n    val gt: i1 = gt.u(frac, halfv);\n    val eq: i1 = eq(frac, halfv);\n    val iu: i$n = shr.u(int, fb);\n    val io: i$n = and(iu, 1);\n    val odd: i1 = ne(io, 0);\n    val fnz: i1 = ne(frac, 0);\n    val d0: i1 = and(neg, fnz);\n    val d1: i1 = and(fl, d0);\n    val c0: i1 = and(pos, fnz);\n    val c1: i1 = and(ce, c0);\n    val t0: i1 = and(eq, odd);\n    val t1: i1 = or(gt, t0);\n    val t2: i1 = and(ne, t1);\n    val u0: i1 = or(d1, c1);\n    val up: i1 = or(u0, t2);\n    val step: i$n = select(up, unit, 0);\n    val mid: i$n = add(int, step);\n    val sd0: i1 = and(neg, nz);\n    val sd1: i1 = and(fl, sd0);\n    val sc0: i1 = and(pos, nz);\n    val sc1: i1 = and(ce, sc0);\n    val above: i1 = gt.u(a, $halfenc);\n    val sn: i1 = and(ne, above);\n    val so0: i1 = or(sd1, sc1);\n    val so: i1 = or(so0, sn);\n    val sr: i$n = select(so, $oneenc, 0);\n    val r0: i$n = select(small, sr, mid);\n    val r1: i$n = select(big, a, r0);\n    val r2: i$n = or(r1, s);\n    val r: i$n = select(nan, $nan, r2);\n    ret(r);\n}\n";

# 1 for less, 2 for equal and 4 for greater by the keys, the two zeros equal,
# and 8 where either is a nan
val SOFT_COMPARE: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i32 {\n    val aa: i$n = and(a, $abs);\n    val ba: i$n = and(b, $abs);\n    val an: i1 = gt.u(aa, $inf);\n    val bn: i1 = gt.u(ba, $inf);\n    val un: i1 = or(an, bn);\n    val afill: i$n = shr.s(a, $top);\n    val aflip: i$n = or(afill, $sign);\n    val ak: i$n = xor(a, aflip);\n    val bfill: i$n = shr.s(b, $top);\n    val bflip: i$n = or(bfill, $sign);\n    val bk: i$n = xor(b, bflip);\n    val ab: i$n = or(aa, ba);\n    val z: i1 = eq(ab, 0);\n    val nz: i1 = xor(z, 1);\n    val lt0: i1 = lt.u(ak, bk);\n    val gt0: i1 = gt.u(ak, bk);\n    val eq0: i1 = eq(ak, bk);\n    val lt: i1 = and(lt0, nz);\n    val gt: i1 = and(gt0, nz);\n    val eq: i1 = or(eq0, z);\n    val l: i32 = ext.u[i32](lt);\n    val e1: i32 = ext.u[i32](eq);\n    val g1: i32 = ext.u[i32](gt);\n    val e: i32 = shl(e1, 1);\n    val g: i32 = shl(g1, 2);\n    val le: i32 = or(l, e);\n    val m: i32 = or(le, g);\n    val r: i32 = select(un, 8, m);\n    ret(r);\n}\n";

# the divisor's significand taken from the dividend's at each exponent of the
# difference from the top, one step for every exponent of the format whether
# it is reached or not, packed exactly at the divisor's exponent
val SOFT_REMAINDER: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(a: i$n$nx, b: i$n$nx) i$n$nx {\n    val aa: i$n = and(a, $abs);\n    val as: i$n = and(a, $sign);\n    val anan: i1 = gt.u(aa, $inf);\n    val ainf: i1 = eq(aa, $inf);\n    val az: i1 = eq(aa, 0);\n    val af: i$n = shr.u(aa, $sig);\n    val asub: i1 = eq(af, 0);\n    val afr: i$n = and(a, $frac);\n    val am1: i$n = or(afr, $one);\n    val am: i$n = select(asub, afr, am1);\n    val af1: i$n = select(asub, 1, af);\n    val ae: i$n = sub(af1, $unit);\n    val ba: i$n = and(b, $abs);\n    val bs: i$n = and(b, $sign);\n    val bnan: i1 = gt.u(ba, $inf);\n    val binf: i1 = eq(ba, $inf);\n    val bz: i1 = eq(ba, 0);\n    val bf: i$n = shr.u(ba, $sig);\n    val bsub: i1 = eq(bf, 0);\n    val bfr: i$n = and(b, $frac);\n    val bm1: i$n = or(bfr, $one);\n    val bm: i$n = select(bsub, bfr, bm1);\n    val bf1: i$n = select(bsub, 1, bf);\n    val be: i$n = sub(bf1, $unit);\n    val alz0: i$n = clz(am);\n    val alz: i$n = sub(alz0, $gap);\n    val amn: i$n = shl(am, alz);\n    val aen: i$n = sub(ae, alz);\n    val blz0: i$n = clz(bm);\n    val blz: i$n = sub(blz0, $gap);\n    val bmn: i$n = shl(bm, blz);\n    val ben: i$n = sub(be, blz);\n    val n0: i1 = or(anan, bnan);\n    val n1: i1 = or(ainf, bz);\n    val nan: i1 = or(n0, n1);\n    val k0: i1 = or(az, binf);\n    val diff: i$n = sub(aen, ben);\n    val early: i1 = lt.s(diff, 0);\n    val keep: i1 = or(k0, early);\n    br step($last, amn);\nstep(k: i$n, r: i$n):\n    val act: i1 = le.s(k, diff);\n    val ge: i1 = ge.u(r, bmn);\n    val r1: i$n = sub(r, bmn);\n    val r2: i$n = select(ge, r1, r);\n    val end: i1 = eq(k, 0);\n    val r3: i$n = shl(r2, 1);\n    val r4: i$n = select(end, r2, r3);\n    val r5: i$n = select(act, r4, r);\n    val k1: i$n = sub(k, 1);\n    val more: i1 = ge.s(k1, 0);\n    cbr(more) step(k1, r5), done;\ndone:\n    val md: i$d = ext.u[i$d](r5);\n    val pk: i$n = call $calls(as, ben, md);\n    val v: i$n = select(keep, a, pk);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# an integer no wider than two words packed as it stands
val SOFT_FROM_UNSIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$k$kx) i$n$nx {\n    val m: i$d = $fit;\n    val pk: i$n = call $calls(0, 0, m);\n    ret(pk);\n}\n";

# a wider integer shifted past its leading zeros and cut to two words with a
# sticky bit, packed
val SOFT_FROM_UNSIGNED_WIDE: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$k$kx) i$n$nx {\n    val z: i1 = eq(x, 0);\n    val lz0: i$k = clz(x);\n    val lz: i$k = select(z, 0, lz0);\n    val xn: i$k = shl(x, lz);\n    val hi: i$k = shr.u(xn, $kd);\n    val m0: i$d = trunc[i$d](hi);\n    val lo: i$k = shl(xn, $d);\n    val lost: i1 = ne(lo, 0);\n    val st: i$d = ext.u[i$d](lost);\n    val m: i$d = or(m0, st);\n    val lzn: i$n = trunc[i$n](lz);\n    val e: i$n = sub($kd, lzn);\n    val pk: i$n = call $calls(0, e, m);\n    ret(pk);\n}\n";

# the magnitude converted unsigned, the sign put back
val SOFT_FROM_SIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$k$kx) i$n$nx {\n    val fill: i$k = shr.s(x, $ktop);\n    val flip: i$k = xor(x, fill);\n    val mag: i$k = sub(flip, fill);\n    val f: i$n = call $calls(mag);\n    val neg: i1 = lt.s(x, 0);\n    val sg: i$n = select(neg, $sign, 0);\n    val r: i$n = or(f, sg);\n    ret(r);\n}\n";

# the significand shifted by its exponent, saturated past the range, zero for
# a nan or a negative value
val SOFT_TO_UNSIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n$nx) i$k$kx {\n    val xa: i$n = and(x, $abs);\n    val xs: i$n = and(x, $sign);\n    val xnan: i1 = gt.u(xa, $inf);\n    val xinf: i1 = eq(xa, $inf);\n    val xz: i1 = eq(xa, 0);\n    val xf: i$n = shr.u(xa, $sig);\n    val xsub: i1 = eq(xf, 0);\n    val xfr: i$n = and(x, $frac);\n    val xm1: i$n = or(xfr, $one);\n    val xm: i$n = select(xsub, xfr, xm1);\n    val xf1: i$n = select(xsub, 1, xf);\n    val xe: i$n = sub(xf1, $unit);\n    val neg: i1 = ne(xs, 0);\n    val low: i1 = or(xnan, neg);\n    val over: i1 = ge.u(xa, $limit);\n    val mK: i$kw = $widen;\n    val eK: i$kw = $widene;\n    val pos: i1 = ge.s(eK, 0);\n    val l0: i$kw = select(pos, eK, 0);\n    val lf: i1 = gt.u(l0, $kwtop);\n    val sl: i$kw = select(lf, $kwtop, l0);\n    val ne: i$kw = sub(0, eK);\n    val r0: i$kw = select(pos, 0, ne);\n    val rf: i1 = gt.u(r0, $kwtop);\n    val sr: i$kw = select(rf, $kwtop, r0);\n    val vl: i$kw = shl(mK, sl);\n    val vr: i$kw = shr.u(mK, sr);\n    val v: i$kw = select(pos, vl, vr);\n    val vk: i$k = $narrow;\n    val r1: i$k = select(over, $ones, vk);\n    val r: i$k = select(low, 0, r1);\n    ret(r);\n}\n";

# the magnitude converted unsigned, negated for a negative value and saturated
# past the signed range, zero for a nan
val SOFT_TO_SIGNED: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$n$nx) i$k$kx {\n    val a: i$n = and(x, $abs);\n    val ok: i1 = le.u(a, $inf);\n    val u: i$k = call $calls(a);\n    val s: i$n = and(x, $sign);\n    val neg: i1 = ne(s, 0);\n    val big0: i1 = ge.u(a, $half);\n    val big: i1 = and(big0, ok);\n    val minus: i$k = sub(0, u);\n    val v: i$k = select(neg, minus, u);\n    val sat: i$k = select(neg, $least, $most);\n    val r: i$k = select(big, sat, v);\n    ret(r);\n}\n";

# the significand and exponent of the source cut to the destination's two
# words with a sticky bit and packed in the destination, a nan the canonical
# one
val SOFT_CONVERT: str = "#[oblivious] #[weak] #[visibility(hidden)] pub fun $name(x: i$ns$nsx) i$n$nx {\n    val a: i$ns = and(x, $sabs);\n    val nan: i1 = gt.u(a, $sinf);\n    val inf: i1 = eq(a, $sinf);\n    val sb: i$ns = shr.u(x, $stop);\n    val sbn: i$n = $fits;\n    val s: i$n = shl(sbn, $top);\n    val ef: i$ns = shr.u(a, $ssig);\n    val sub: i1 = eq(ef, 0);\n    val fr: i$ns = and(x, $sfrac);\n    val m1: i$ns = or(fr, $sone);\n    val m: i$ns = select(sub, fr, m1);\n    val ef1: i$ns = select(sub, 1, ef);\n    val e0: i$ns = sub(ef1, $sunit);\n    val mc0: i$ns = shr.u(m, $cut);\n    val lowm: i$ns = and(m, $cutmask);\n    val lost: i1 = ne(lowm, 0);\n    val lb: i$ns = ext.u[i$ns](lost);\n    val mc: i$ns = or(mc0, lb);\n    val e1: i$ns = add(e0, $cut);\n    val md: i$d = $fitm;\n    val en: i$n = $fite;\n    val pk: i$n = call $calls(s, en, md);\n    val infv: i$n = or(s, $inf);\n    val v: i$n = select(inf, infv, pk);\n    val w: i$n = select(nan, $nan, v);\n    ret(w);\n}\n";

# no opcode
val NONE: opt[Opcode] = opt[Opcode].none{};

def Rows: [34]Row;

val ROWS: Rows = [34]Row{
    Row{operation: Operation.quotient_u{}, stem: "udiv", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.quotient_s{}, stem: "sdiv", naming: Naming.width{}, text: SIGNED_QUOTIENT, paired: nil, calls: Operation.quotient_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_u{}, stem: "urem", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_s{}, stem: "srem", naming: Naming.width{}, text: SIGNED_REMAINDER, paired: nil, calls: Operation.remainder_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_float_u{}, stem: "utof", naming: Naming.format{}, text: UNSIGNED_TO_FLOAT, paired: UNSIGNED_TO_FLOAT_PAIR, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_float_s{}, stem: "stof", naming: Naming.format{}, text: SIGNED_TO_FLOAT, paired: nil, calls: Operation.to_float_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_integer_u{}, stem: "ftou", naming: Naming.format{}, text: FLOAT_TO_UNSIGNED, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_integer_s{}, stem: "ftos", naming: Naming.format{}, text: FLOAT_TO_SIGNED, paired: nil, calls: Operation.to_integer_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.copy{}, stem: "copy", naming: Naming.width{}, text: COPY, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.fill{}, stem: "fill", naming: Naming.width{}, text: FILL, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.product{}, stem: "mul", naming: Naming.width{}, text: PRODUCT, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_f{}, stem: "frem", naming: Naming.float{}, text: FLOAT_REMAINDER, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].some{opcode.FREM}, computes: NONE},
    Row{operation: Operation.soft_pack{}, stem: "soft_fpack", naming: Naming.float{}, text: SOFT_PACK, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_add{}, stem: "soft_fadd", naming: Naming.float{}, text: SOFT_ADD, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FADD}},
    Row{operation: Operation.soft_sub{}, stem: "soft_fsub", naming: Naming.float{}, text: SOFT_SUB, paired: nil, calls: Operation.soft_add{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FSUB}},
    Row{operation: Operation.soft_mul{}, stem: "soft_fmul", naming: Naming.float{}, text: SOFT_MUL, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMUL}},
    Row{operation: Operation.soft_div{}, stem: "soft_fdiv", naming: Naming.float{}, text: SOFT_DIV, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FDIV}},
    Row{operation: Operation.soft_sqrt{}, stem: "soft_fsqrt", naming: Naming.float{}, text: SOFT_SQRT, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FSQRT}},
    Row{operation: Operation.soft_fma{}, stem: "soft_fma", naming: Naming.float{}, text: SOFT_FMA, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMA}},
    Row{operation: Operation.soft_min{}, stem: "soft_fmin", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMIN}},
    Row{operation: Operation.soft_max{}, stem: "soft_fmax", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMAX}},
    Row{operation: Operation.soft_minnum{}, stem: "soft_fminnum", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMINNUM}},
    Row{operation: Operation.soft_maxnum{}, stem: "soft_fmaxnum", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMAXNUM}},
    Row{operation: Operation.soft_floor{}, stem: "soft_ffloor", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FFLOOR}},
    Row{operation: Operation.soft_ceil{}, stem: "soft_fceil", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FCEIL}},
    Row{operation: Operation.soft_trunc{}, stem: "soft_fint", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FINT}},
    Row{operation: Operation.soft_nearest{}, stem: "soft_fnearest", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FNEAREST}},
    Row{operation: Operation.soft_remainder{}, stem: "soft_frem", naming: Naming.float{}, text: SOFT_REMAINDER, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FREM}},
    Row{operation: Operation.soft_compare{}, stem: "soft_fcmp", naming: Naming.float{}, text: SOFT_COMPARE, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_from_u{}, stem: "soft_utof", naming: Naming.format{}, text: SOFT_FROM_UNSIGNED, paired: SOFT_FROM_UNSIGNED_WIDE, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_from_s{}, stem: "soft_stof", naming: Naming.format{}, text: SOFT_FROM_SIGNED, paired: nil, calls: Operation.soft_from_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_to_u{}, stem: "soft_ftou", naming: Naming.format{}, text: SOFT_TO_UNSIGNED, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_to_s{}, stem: "soft_ftos", naming: Naming.format{}, text: SOFT_TO_SIGNED, paired: nil, calls: Operation.soft_to_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_convert{}, stem: "soft_fcvt", naming: Naming.formats{}, text: SOFT_CONVERT, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: NONE},
};

# whether two operations are the same
pub fun same(a: Operation, b: Operation) bool {
    if (sel a.quotient_u)     { ret sel b.quotient_u; }
    if (sel a.quotient_s)     { ret sel b.quotient_s; }
    if (sel a.remainder_u)    { ret sel b.remainder_u; }
    if (sel a.remainder_s)    { ret sel b.remainder_s; }
    if (sel a.to_float_u)     { ret sel b.to_float_u; }
    if (sel a.to_float_s)     { ret sel b.to_float_s; }
    if (sel a.to_integer_u)   { ret sel b.to_integer_u; }
    if (sel a.to_integer_s)   { ret sel b.to_integer_s; }
    if (sel a.copy)           { ret sel b.copy; }
    if (sel a.fill)           { ret sel b.fill; }
    if (sel a.product)        { ret sel b.product; }
    if (sel a.remainder_f)    { ret sel b.remainder_f; }
    if (sel a.soft_pack)      { ret sel b.soft_pack; }
    if (sel a.soft_add)       { ret sel b.soft_add; }
    if (sel a.soft_sub)       { ret sel b.soft_sub; }
    if (sel a.soft_mul)       { ret sel b.soft_mul; }
    if (sel a.soft_div)       { ret sel b.soft_div; }
    if (sel a.soft_sqrt)      { ret sel b.soft_sqrt; }
    if (sel a.soft_fma)       { ret sel b.soft_fma; }
    if (sel a.soft_min)       { ret sel b.soft_min; }
    if (sel a.soft_max)       { ret sel b.soft_max; }
    if (sel a.soft_minnum)    { ret sel b.soft_minnum; }
    if (sel a.soft_maxnum)    { ret sel b.soft_maxnum; }
    if (sel a.soft_floor)     { ret sel b.soft_floor; }
    if (sel a.soft_ceil)      { ret sel b.soft_ceil; }
    if (sel a.soft_trunc)     { ret sel b.soft_trunc; }
    if (sel a.soft_nearest)   { ret sel b.soft_nearest; }
    if (sel a.soft_remainder) { ret sel b.soft_remainder; }
    if (sel a.soft_compare)   { ret sel b.soft_compare; }
    if (sel a.soft_from_u)    { ret sel b.soft_from_u; }
    if (sel a.soft_from_s)    { ret sel b.soft_from_s; }
    if (sel a.soft_to_u)      { ret sel b.soft_to_u; }
    if (sel a.soft_to_s)      { ret sel b.soft_to_s; }
    if (sel a.soft_convert)   { ret sel b.soft_convert; }
    ret sel b.unstated;
}

# every row, in order
pub fun rows() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: $length_of(Rows)};
}

# the row of an operation, none for one no helper does
pub fun row(op: Operation) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (same(ROWS[i].operation, op)) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the row that stands in for an operation of `mirl.target.OPTIONAL`, none for
# an operation no row stands in for
pub fun standing(code: Opcode) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        val stands: opt[Opcode] = ROWS[i].stands;
        if (sel stands.some) {
            if (stands.some.index == code.index) { ret opt[*Row].some{?ROWS[i]}; }
        }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the soft row that computes a float operation on encodings, none for an
# operation no soft row computes
pub fun computing(code: Opcode) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        val computes: opt[Opcode] = ROWS[i].computes;
        if (sel computes.some) {
            if (computes.some.index == code.index) { ret opt[*Row].some{?ROWS[i]}; }
        }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# whether a row computes on encodings
pub fun soft(op: Operation) bool {
    ret sel op.soft_pack || sel op.soft_add || sel op.soft_sub || sel op.soft_mul || sel op.soft_div || sel op.soft_sqrt || sel op.soft_fma || sel op.soft_min || sel op.soft_max || sel op.soft_minnum || sel op.soft_maxnum || sel op.soft_floor || sel op.soft_ceil || sel op.soft_trunc || sel op.soft_nearest || sel op.soft_remainder || sel op.soft_compare || sel op.soft_from_u || sel op.soft_from_s || sel op.soft_to_u || sel op.soft_to_s || sel op.soft_convert;
}
