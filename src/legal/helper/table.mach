# the helpers mirl delivers: the one table of their names and texts
#
# a helper is an ordinary function of the module that calls it, written once
# here in the ir text form with its widths and constants left as `$` names,
# which the delivery fills in for the width, the number format and the target
# it is asked for. a module holds each at most once, weak and hidden, so every
# module's copy of a helper with one name is the same function and the linker
# keeps one. its name is mirl's own: the prefix, the row's stem, the width and,
# for a conversion, the number format, so no name a front end makes collides
# with it.
#
# each helper is written so its time depends on no value it is given but a
# length: a division and a product run one step per bit, choosing with
# selects or masks, a float remainder one step per exponent of its format, and
# a conversion is straight line code. a copy or fill runs one step per byte of
# its length. every one is declared constant time.
#
# the soft rows compute a float of a format the build holds no unit for on the
# integer that is its encoding, with integer instructions alone, so they serve
# a target with no float unit. each unpacks its operands into a sign, an
# exponent and a significand with selects, computes the exact result or its
# leading bits and a sticky bit, and calls the one rounding, the pack, which
# rounds to nearest with ties to even. a division, a square root and a
# remainder run a fixed count of steps for their format, so none branches on a
# value. a nan an operation gives is the format's canonical one, which the ir
# admits of float arithmetic and conversions alike. the key of an encoding, its
# bits with every bit flipped where its sign is set and the sign bit set where
# it is not, orders the numbers it encodes as unsigned integers, negative zero
# below positive zero, which the bounds and the comparison read.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;

# what a helper does
# ---
# quotient_u:   the unsigned quotient of two integers
# quotient_s:   the signed quotient, from the unsigned one of the magnitudes
# remainder_u:  the unsigned remainder
# remainder_s:  the signed remainder, from the unsigned one of the magnitudes
# to_float_u:   an unsigned integer to a float, rounded once
# to_float_s:   a signed integer to a float, from the unsigned conversion
# to_integer_u: a float to an unsigned integer, saturating, zero for a nan
# to_integer_s: a float to a signed integer, from the unsigned conversion
# copy:         a copy of a run of bytes whose ranges may overlap
# fill:         a fill of a run of bytes with one byte
# product:      the low half of the product of two integers
# remainder_f:  the remainder of two floats, of the quotient truncated toward
#               zero
# soft_pack:    a sign, exponent and significand of an encoding rounded and
#               packed into it
# soft_add .. soft_remainder: the float operation of the same name on encodings
# soft_compare: how two encodings order, as a mask of less, equal, greater and
#               unordered
# soft_from_u:  an unsigned integer to an encoding
# soft_from_s:  a signed integer to an encoding, from the unsigned conversion
# soft_to_u:    an encoding to an unsigned integer, saturating, zero for a nan
# soft_to_s:    an encoding to a signed integer, from the unsigned conversion
# soft_convert: an encoding of one format to one of another
pub tag Operation: u8 {
    unstated;
    quotient_u;
    quotient_s;
    remainder_u;
    remainder_s;
    to_float_u;
    to_float_s;
    to_integer_u;
    to_integer_s;
    copy;
    fill;
    product;
    remainder_f;
    soft_pack;
    soft_add;
    soft_sub;
    soft_mul;
    soft_div;
    soft_sqrt;
    soft_fma;
    soft_min;
    soft_max;
    soft_minnum;
    soft_maxnum;
    soft_floor;
    soft_ceil;
    soft_trunc;
    soft_nearest;
    soft_remainder;
    soft_compare;
    soft_from_u;
    soft_from_s;
    soft_to_u;
    soft_to_s;
    soft_convert;
}

# how a helper's name is made after its stem
# ---
# width:   the width of its integer, or of its length
# format:  the width of its integer, then the name of its number format
# float:   the name of its number format alone
# formats: the name of the format it converts from, then the one it converts to
pub tag Naming: u8 {
    width;
    format;
    float;
    formats;
}

# one helper
# ---
# operation: what it does
# stem:      its name between the prefix and the width
# naming:    what its name is made of after the stem
# text:      its text, to be filled in
# paired:    the text the delivery chooses in place of text for a want the
#            first does not hold: a conversion to a float whose rounding needs
#            the bits of two words, or a soft conversion from an integer wider
#            than two words, nil for every other row
# calls:     the helper its text calls, unstated for none
# stands:    the operation of `mirl.target.OPTIONAL` it stands in for where a
#            held format has no native form of it, none for a row the pass
#            finds by its opcode's algebra, fold entry or operand roles
# computes:  the float operation a soft row computes on encodings, none for a
#            row the soft legalisation finds by its fold entry or for any
#            other row
pub rec Row {
    operation: Operation;
    stem:      str;
    naming:    Naming;
    text:      str;
    paired:    str;
    calls:     Operation;
    stands:    opt[Opcode];
    computes:  opt[Opcode];
}

# the prefix of every helper's name
pub val PREFIX: str = "__mirl_";

# restoring division, one bit of the dividend a step from the top, the
# remainder carrying the bit it shifts out, keeping the quotient or remainder
val UNSIGNED_DIVISION: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    br ^step(i32 $n, %n, i$n 0, i$n 0)\n^step(%k: i32, %a: i$n, %q: i$n, %r: i$n):\n    %carry = shr.u %r, i$n $top\n    %high = shr.u %a, i$n $top\n    %r1 = shl %r, i$n 1\n    %r2 = or %r1, %high\n    %a1 = shl %a, i$n 1\n    %q1 = shl %q, i$n 1\n    %over = ne %carry, i$n 0\n    %fits = ge.u %r2, %d\n    %take = or %over, %fits\n    %r3 = sub %r2, %d\n    %r4 = select %take, %r3, %r2\n    %bit = ext.u %take, to i$n\n    %q2 = or %q1, %bit\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %q2, %r4), ^done\n^done:\n    ret $result\n}\n";

# the unsigned quotient of the magnitudes, negated where the signs differ
val SIGNED_QUOTIENT: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    %nf = shr.s %n, i$n $top\n    %df = shr.s %d, i$n $top\n    %nx = xor %n, %nf\n    %na = sub %nx, %nf\n    %dx = xor %d, %df\n    %da = sub %dx, %df\n    %u = call ptr @$calls, %na, %da, signature fun(i$n, i$n) -> (i$n), named all\n    %s = xor %nf, %df\n    %ux = xor %u, %s\n    %v = sub %ux, %s\n    ret %v\n}\n";

# the unsigned remainder of the magnitudes, with the sign of the dividend
val SIGNED_REMAINDER: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%n: i$n, %d: i$n):\n    %nf = shr.s %n, i$n $top\n    %df = shr.s %d, i$n $top\n    %nx = xor %n, %nf\n    %na = sub %nx, %nf\n    %dx = xor %d, %df\n    %da = sub %dx, %df\n    %u = call ptr @$calls, %na, %da, signature fun(i$n, i$n) -> (i$n), named all\n    %ux = xor %u, %nf\n    %v = sub %ux, %nf\n    ret %v\n}\n";

# the integer shifted up past its leading zeros, its top bits and a sticky bit
# for the rest converted in one word, then scaled by the exact power of two
val UNSIGNED_TO_FLOAT: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %lz = clz %x\n    %cur = shl %x, %lz\n    %topn = shr.u %cur, i$n $nk\n    %top = trunc %topn, to i$w\n    %below = shl %cur, i$n $k\n    %any = ne %below, i$n 0\n    %sticky = ext.u %any, to i$w\n    %t = or %top, %sticky\n    %f = itof.u %t, to $f\n    %lzt = $fit\n    %e = sub i$fi $nk, %lzt\n    %over = gt.s %e, i$fi $emax\n    %biased = add %e, i$fi $bias\n    %sbits = shl %biased, i$fi $sig\n    %scale = bitcast %sbits, to $f\n    %v = fmul %f, %scale\n    %vb = bitcast %v, to i$fi\n    %rb = select %over, i$fi $inf, %vb\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# as the one word conversion, for a format whose rounding needs more bits than a
# word: the top two words converted exactly and added, which rounds once
val UNSIGNED_TO_FLOAT_PAIR: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %lz = clz %x\n    %cur = shl %x, %lz\n    %hin = shr.u %cur, i$n $nw\n    %hi = trunc %hin, to i$w\n    %lon = shr.u %cur, i$n $n2w\n    %lo0 = trunc %lon, to i$w\n    %below = shl %cur, i$n $w2\n    %any = ne %below, i$n 0\n    %sticky = ext.u %any, to i$w\n    %lo = or %lo0, %sticky\n    %fh = itof.u %hi, to $f\n    %fl = itof.u %lo, to $f\n    %fw = fmul %fh, $f $word\n    %f = fadd %fw, %fl\n    %lzt = $fit\n    %e = sub i$fi $n2w, %lzt\n    %over = gt.s %e, i$fi $emax\n    %biased = add %e, i$fi $bias\n    %sbits = shl %biased, i$fi $sig\n    %scale = bitcast %sbits, to $f\n    %v = fmul %f, %scale\n    %vb = bitcast %v, to i$fi\n    %rb = select %over, i$fi $inf, %vb\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# the magnitude converted unsigned, the sign put back in the sign bit
val SIGNED_TO_FLOAT: str = "function @$name: fun(i$n) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %fill = shr.s %x, i$n $top\n    %flip = xor %x, %fill\n    %mag = sub %flip, %fill\n    %f = call ptr @$calls, %mag, signature fun(i$n) -> ($f), named all\n    %fb = bitcast %f, to i$fi\n    %neg = lt.s %x, i$n 0\n    %sign = select %neg, i$fi $sign, i$fi 0\n    %rb = xor %fb, %sign\n    %r = bitcast %rb, to $f\n    ret %r\n}\n";

# a value in range taken apart a word at a time from the top by exact float
# arithmetic, and one out of range saturated, a nan giving zero
val FLOAT_TO_UNSIGNED: str = "function @$name: fun($f) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: $f):\n    %ge = fge.o %x, $f 0\n    %lt = flt.o %x, $f $limit\n    %ok = and %ge, %lt\n    %bits = bitcast %x, to i$fi\n    %kept = select %ok, %bits, i$fi 0\n    %m = bitcast %kept, to $f\n    br ^digit(i$fi $digits, %m, i$n 0)\n^digit(%i: i$fi, %r: $f, %acc: i$n):\n    %wi = mul %i, i$fi $w\n    %down = sub i$fi $bias, %wi\n    %dbits = shl %down, i$fi $sig\n    %dscale = bitcast %dbits, to $f\n    %v = fmul %r, %dscale\n    %hi = ftoi.u %v, to i$w\n    %up = add %wi, i$fi $bias\n    %ubits = shl %up, i$fi $sig\n    %uscale = bitcast %ubits, to $f\n    %hf = itof.u %hi, to $f\n    %back = fmul %hf, %uscale\n    %rest = fsub %r, %back\n    %shifted = shl %acc, i$n $w\n    %word = ext.u %hi, to i$n\n    %acc1 = or %shifted, %word\n    %last = eq %i, i$fi 0\n    %i1 = sub %i, i$fi 1\n    cbr %last, ^out, ^digit(%i1, %rest, %acc1)\n^out:\n    %high = fge.o %x, $f $limit\n    %sat = select %high, i$n -1, i$n 0\n    %res = select %ok, %acc1, %sat\n    ret %res\n}\n";

# the magnitude converted unsigned, negated for a negative value and
# saturated past the signed range
val FLOAT_TO_SIGNED: str = "function @$name: fun($f) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: $f):\n    %a = fabs %x\n    %u = call ptr @$calls, %a, signature fun($f) -> (i$n), named all\n    %neg = flt.o %x, $f 0\n    %big = fge.o %a, $f $half\n    %minus = sub i$n 0, %u\n    %v = select %neg, %minus, %u\n    %sat = select %neg, i$n $least, i$n $most\n    %res = select %big, %sat, %v\n    ret %res\n}\n";

# a byte stored to each address of the run in turn
val FILL: str = "function @$name: fun($pt, i8 zext, i$l zext) -> () linkage weak visibility hidden constant_time {\n^entry(%to: $pt, %byte: i8, %n: i$l):\n    br ^next(i$l 0)\n^next(%i: i$l):\n    %more = lt.u %i, %n\n    cbr %more, ^put, ^done\n^put:\n    %at = ptr.add %to, %i\n    store %at, %byte, align 1\n    %i1 = add %i, i$l 1\n    br ^next(%i1)\n^done:\n    ret\n}\n";

# a byte moved at a time, from the end when the destination is above the
# source, so overlapping ranges copy as a whole
val COPY: str = "function @$name: fun($pt, $pt, i$l zext) -> () linkage weak visibility hidden constant_time {\n^entry(%to: $pt, %from: $pt, %n: i$l):\n    %t = ptrtoint %to, to i$p\n    %s = ptrtoint %from, to i$p\n    %down = gt.u %t, %s\n    cbr %down, ^back(%n), ^ahead(i$l 0)\n^ahead(%i: i$l):\n    %more = lt.u %i, %n\n    cbr %more, ^forward, ^done\n^forward:\n    %src = ptr.add %from, %i\n    %b = load %src, type i8, align 1\n    %dst = ptr.add %to, %i\n    store %dst, %b, align 1\n    %i1 = add %i, i$l 1\n    br ^ahead(%i1)\n^back(%j: i$l):\n    %left = ne %j, i$l 0\n    cbr %left, ^backward, ^done\n^backward:\n    %j1 = sub %j, i$l 1\n    %bsrc = ptr.add %from, %j1\n    %bb = load %bsrc, type i8, align 1\n    %bdst = ptr.add %to, %j1\n    store %bdst, %bb, align 1\n    br ^back(%j1)\n^done:\n    ret\n}\n";

# shift and add, one bit of the second operand a step from the bottom, the
# first operand shifted up and added where the bit is set through a mask, so
# no step depends on a value
val PRODUCT: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    br ^step(i32 $n, %a, %b, i$n 0)\n^step(%k: i32, %x: i$n, %y: i$n, %p: i$n):\n    %low = and %y, i$n 1\n    %mask = sub i$n 0, %low\n    %add = and %x, %mask\n    %p1 = add %p, %add\n    %x1 = shl %x, i$n 1\n    %y1 = shr.u %y, i$n 1\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %x1, %y1, %p1), ^done\n^done:\n    ret %p1\n}\n";

# the magnitude of the dividend less the divisor's magnitude scaled by each
# power of two from the one that brings it to the largest exponent down, where
# it is no greater: each difference is exact, since the scaled divisor is at
# least half the rest. the divisor is scaled into the normal range first where
# it is subnormal, so its scale has the largest exponent and its significand.
# the sign of the dividend goes back on, and a nan operand gives a nan, an
# infinite dividend or a zero divisor the canonical nan, as the folder does
val FLOAT_REMAINDER: str = "function @$name: fun($f, $f) -> ($f) linkage weak visibility hidden constant_time {\n^entry(%x: $f, %y: $f):\n    %ax = fabs %x\n    %ay = fabs %y\n    %small = flt.o %ay, $f $normal\n    %up = fmul %ay, $f $scale\n    %b = select %small, %up, %ay\n    %bb = bitcast %b, to i$fi\n    %frac = and %bb, i$fi $fraction\n    %cb = or %frac, i$fi $high\n    %c = bitcast %cb, to $f\n    br ^step(i32 $steps, %ax, %c)\n^step(%k: i32, %a: $f, %s: $f):\n    %ge = fge.o %a, %s\n    %above = fge.o %s, %ay\n    %take = and %ge, %above\n    %d = fsub %a, %s\n    %a1 = select %take, %d, %a\n    %s1 = fmul %s, $f $half\n    %k1 = sub %k, i32 1\n    %more = ne %k1, i32 0\n    cbr %more, ^step(%k1, %a1, %s1), ^done\n^done:\n    %r = fcopysign %a1, %x\n    %inf = feq.o %ax, $f $inf\n    %zero = feq.o %ay, $f 0\n    %bad = or %inf, %zero\n    %v = select %bad, $f $nan, %r\n    %uno = funo %x, %y\n    %sum = fadd %x, %y\n    %w = select %uno, %sum, %v\n    ret %w\n}\n";

# the value of a sign, an exponent and a significand of two words, rounded
# once to nearest with ties to even: normalised past its leading zeros,
# shifted down to the precision or, below the normal range, to the least
# subnormal, the shifted out bits the round and sticky bits, and the encoding
# made by adding the rounded significand to the exponent field, so a carry
# moves into it
val SOFT_PACK: str = "function @$name: fun(i$n, i$n, i$d) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%s: i$n, %e: i$n, %m: i$d):\n    %zero = eq %m, i$d 0\n    %hi = shr.u %m, i$d $dtop\n    %wide = ne %hi, i$d 0\n    %m0 = shr.u %m, i$d 1\n    %lowb = and %m, i$d 1\n    %m0s = or %m0, %lowb\n    %m1 = select %wide, %m0s, %m\n    %eb = ext.u %wide, to i$n\n    %e1 = add %e, %eb\n    %lz = clz %m1\n    %lzs = select %zero, i$d 1, %lz\n    %by = sub %lzs, i$d 1\n    %mn = shl %m1, %by\n    %lzn = trunc %lzs, to i$n\n    %t0 = sub i$n $dtop, %lzn\n    %t = add %e1, %t0\n    %be = add %t, i$n $bias\n    %under = lt.s %be, i$n 1\n    %ex0 = sub i$n 1, %be\n    %ex = select %under, %ex0, i$n 0\n    %sh0 = add %ex, i$n $base\n    %far = gt.s %sh0, i$n $dtop\n    %shc = select %far, i$n $dtop, %sh0\n    %mnz = ne %mn, i$d 0\n    %tiny = ext.u %mnz, to i$d\n    %mf = select %far, %tiny, %mn\n    %sh = ext.u %shc, to i$d\n    %r = shr.u %mf, %sh\n    %one = shl i$d 1, %sh\n    %low = sub %one, i$d 1\n    %rem = and %mf, %low\n    %half = shr.u %one, i$d 1\n    %above = gt.u %rem, %half\n    %tie = eq %rem, %half\n    %odd = and %r, i$d 1\n    %isodd = ne %odd, i$d 0\n    %tieup = and %tie, %isodd\n    %up = or %above, %tieup\n    %upb = ext.u %up, to i$d\n    %r2 = add %r, %upb\n    %bm = sub %be, i$n 1\n    %neg = lt.s %bm, i$n 0\n    %fm = select %neg, i$n 0, %bm\n    %fmd = ext.u %fm, to i$d\n    %fs = shl %fmd, i$d $sig\n    %enc = add %fs, %r2\n    %over = ge.u %enc, i$d $inf\n    %encn = trunc %enc, to i$n\n    %fin = select %over, i$n $inf, %encn\n    %res0 = select %zero, i$n 0, %fin\n    %res = or %res0, %s\n    ret %res\n}\n";

# the larger magnitude and the smaller aligned below it with three guard bits
# and a sticky bit, added or subtracted, and packed
val SOFT_ADD: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %ba = and %b, i$n $abs\n    %bs = and %b, i$n $sign\n    %bnan = gt.u %ba, i$n $inf\n    %binf = eq %ba, i$n $inf\n    %bz = eq %ba, i$n 0\n    %bf = shr.u %ba, i$n $sig\n    %bsub = eq %bf, i$n 0\n    %bfr = and %b, i$n $frac\n    %bm1 = or %bfr, i$n $one\n    %bm = select %bsub, %bfr, %bm1\n    %bf1 = select %bsub, i$n 1, %bf\n    %be = sub %bf1, i$n $unit\n    %differ = ne %as, %bs\n    %both = and %ainf, %binf\n    %clash = and %both, %differ\n    %nan0 = or %anan, %bnan\n    %nan = or %nan0, %clash\n    %inf = or %ainf, %binf\n    %infv = select %ainf, %a, %b\n    %swap = lt.u %aa, %ba\n    %xs = select %swap, %bs, %as\n    %ys = select %swap, %as, %bs\n    %xm = select %swap, %bm, %am\n    %ym = select %swap, %am, %bm\n    %xe = select %swap, %bf1, %af1\n    %ye = select %swap, %af1, %bf1\n    %dist = sub %xe, %ye\n    %far = gt.u %dist, i$n $top\n    %dc = select %far, i$n $top, %dist\n    %xm3 = shl %xm, i$n 3\n    %ym3 = shl %ym, i$n 3\n    %yal = shr.u %ym3, %dc\n    %bit = shl i$n 1, %dc\n    %lowm = sub %bit, i$n 1\n    %lost = and %ym3, %lowm\n    %st = ne %lost, i$n 0\n    %stb = ext.u %st, to i$n\n    %yj = or %yal, %stb\n    %same = eq %xs, %ys\n    %sum = add %xm3, %yj\n    %dif = sub %xm3, %yj\n    %m = select %same, %sum, %dif\n    %mz = eq %m, i$n 0\n    %zs = and %as, %bs\n    %s = select %mz, %zs, %xs\n    %e = sub %xe, i$n $unit3\n    %md = ext.u %m, to i$d\n    %pk = call ptr @$calls, %s, %e, %md, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %v = select %inf, %infv, %pk\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# the sum with the second operand's sign flipped
val SOFT_SUB: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %nb = xor %b, i$n $sign\n    %r = call ptr @$calls, %a, %nb, signature fun(i$n, i$n) -> (i$n), named all\n    ret %r\n}\n";

# the exact product of the significands at two words, packed
val SOFT_MUL: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %ba = and %b, i$n $abs\n    %bs = and %b, i$n $sign\n    %bnan = gt.u %ba, i$n $inf\n    %binf = eq %ba, i$n $inf\n    %bz = eq %ba, i$n 0\n    %bf = shr.u %ba, i$n $sig\n    %bsub = eq %bf, i$n 0\n    %bfr = and %b, i$n $frac\n    %bm1 = or %bfr, i$n $one\n    %bm = select %bsub, %bfr, %bm1\n    %bf1 = select %bsub, i$n 1, %bf\n    %be = sub %bf1, i$n $unit\n    %s = xor %as, %bs\n    %n0 = or %anan, %bnan\n    %n1 = and %ainf, %bz\n    %n2 = and %binf, %az\n    %n3 = or %n0, %n1\n    %nan = or %n3, %n2\n    %inf = or %ainf, %binf\n    %amd = ext.u %am, to i$d\n    %bmd = ext.u %bm, to i$d\n    %p = mul %amd, %bmd\n    %e = add %ae, %be\n    %pk = call ptr @$calls, %s, %e, %p, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %infv = or %s, i$n $inf\n    %v = select %inf, %infv, %pk\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# restoring division of the normalised significands, one quotient bit a step
# past the precision and two more, the remainder the sticky bit, packed
val SOFT_DIV: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %ba = and %b, i$n $abs\n    %bs = and %b, i$n $sign\n    %bnan = gt.u %ba, i$n $inf\n    %binf = eq %ba, i$n $inf\n    %bz = eq %ba, i$n 0\n    %bf = shr.u %ba, i$n $sig\n    %bsub = eq %bf, i$n 0\n    %bfr = and %b, i$n $frac\n    %bm1 = or %bfr, i$n $one\n    %bm = select %bsub, %bfr, %bm1\n    %bf1 = select %bsub, i$n 1, %bf\n    %be = sub %bf1, i$n $unit\n    %alz0 = clz %am\n    %alz = sub %alz0, i$n $gap\n    %amn = shl %am, %alz\n    %aen = sub %ae, %alz\n    %blz0 = clz %bm\n    %blz = sub %blz0, i$n $gap\n    %bmn = shl %bm, %blz\n    %ben = sub %be, %blz\n    %s = xor %as, %bs\n    %n0 = or %anan, %bnan\n    %n1 = and %ainf, %binf\n    %n2 = and %az, %bz\n    %n3 = or %n0, %n1\n    %nan = or %n3, %n2\n    %inf = or %ainf, %bz\n    %zero = or %az, %binf\n    br ^step(i$n $steps, %amn, i$n 0)\n^step(%k: i$n, %r: i$n, %q: i$n):\n    %ge = ge.u %r, %bmn\n    %r1 = sub %r, %bmn\n    %r2 = select %ge, %r1, %r\n    %q1 = shl %q, i$n 1\n    %gb = ext.u %ge, to i$n\n    %q2 = or %q1, %gb\n    %r3 = shl %r2, i$n 1\n    %k1 = sub %k, i$n 1\n    %more = ne %k1, i$n 0\n    cbr %more, ^step(%k1, %r3, %q2), ^done\n^done:\n    %st = ne %r3, i$n 0\n    %stb = ext.u %st, to i$n\n    %m = or %q2, %stb\n    %e0 = sub %aen, %ben\n    %e = sub %e0, i$n $steps1\n    %md = ext.u %m, to i$d\n    %pk = call ptr @$calls, %s, %e, %md, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %infv = or %s, i$n $inf\n    %v0 = select %zero, %s, %pk\n    %v = select %inf, %infv, %v0\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# the exponent made even, the significand scaled past the precision and two
# more bits of root, the integer root one bit a step over two words, the
# remainder the sticky bit, packed
val SOFT_SQRT: str = "function @$name: fun(i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %alz0 = clz %am\n    %alz = sub %alz0, i$n $gap\n    %amn = shl %am, %alz\n    %aen = sub %ae, %alz\n    %neg = ne %as, i$n 0\n    %below = xor %az, i1 1\n    %bad = and %neg, %below\n    %nan = or %anan, %bad\n    %keep = or %az, %ainf\n    %odd = and %aen, i$n 1\n    %m2 = shl %amn, %odd\n    %e2 = sub %aen, %odd\n    %md = ext.u %m2, to i$d\n    %x = shl %md, i$d $twok\n    br ^step(i$n $rounds, %x, i$d 0, i$d $bit)\n^step(%k: i$n, %num: i$d, %res: i$d, %bit: i$d):\n    %rb = add %res, %bit\n    %ge = ge.u %num, %rb\n    %n1 = sub %num, %rb\n    %num2 = select %ge, %n1, %num\n    %rs = shr.u %res, i$d 1\n    %rsb = add %rs, %bit\n    %res2 = select %ge, %rsb, %rs\n    %bit2 = shr.u %bit, i$d 2\n    %k1 = sub %k, i$n 1\n    %more = ne %k1, i$n 0\n    cbr %more, ^step(%k1, %num2, %res2, %bit2), ^done\n^done:\n    %st = ne %num2, i$d 0\n    %stb = ext.u %st, to i$d\n    %m = or %res2, %stb\n    %e3 = sub %e2, i$n $twok\n    %e = shr.s %e3, i$n 1\n    %pk = call ptr @$calls, i$n 0, %e, %m, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %v = select %keep, %a, %pk\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# the exact product and the addend placed in a frame of four words by the
# larger of their top exponents, the other shifted below with a sticky bit,
# added or subtracted, cut to two words with a sticky bit and packed once
val SOFT_FMA: str = "function @$name: fun(i$n, i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n, %c: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %ba = and %b, i$n $abs\n    %bs = and %b, i$n $sign\n    %bnan = gt.u %ba, i$n $inf\n    %binf = eq %ba, i$n $inf\n    %bz = eq %ba, i$n 0\n    %bf = shr.u %ba, i$n $sig\n    %bsub = eq %bf, i$n 0\n    %bfr = and %b, i$n $frac\n    %bm1 = or %bfr, i$n $one\n    %bm = select %bsub, %bfr, %bm1\n    %bf1 = select %bsub, i$n 1, %bf\n    %be = sub %bf1, i$n $unit\n    %ca = and %c, i$n $abs\n    %cs = and %c, i$n $sign\n    %cnan = gt.u %ca, i$n $inf\n    %cinf = eq %ca, i$n $inf\n    %cz = eq %ca, i$n 0\n    %cf = shr.u %ca, i$n $sig\n    %csub = eq %cf, i$n 0\n    %cfr = and %c, i$n $frac\n    %cm1 = or %cfr, i$n $one\n    %cm = select %csub, %cfr, %cm1\n    %cf1 = select %csub, i$n 1, %cf\n    %ce = sub %cf1, i$n $unit\n    %alz0 = clz %am\n    %alz = sub %alz0, i$n $gap\n    %amn = shl %am, %alz\n    %aen = sub %ae, %alz\n    %blz0 = clz %bm\n    %blz = sub %blz0, i$n $gap\n    %bmn = shl %bm, %blz\n    %ben = sub %be, %blz\n    %clz0 = clz %cm\n    %clz = sub %clz0, i$n $gap\n    %cmn = shl %cm, %clz\n    %cen = sub %ce, %clz\n    %sp = xor %as, %bs\n    %pz = or %az, %bz\n    %pinf = or %ainf, %binf\n    %n0 = or %anan, %bnan\n    %n1 = or %n0, %cnan\n    %n2 = and %ainf, %bz\n    %n3 = and %binf, %az\n    %n4 = or %n2, %n3\n    %n5 = or %n1, %n4\n    %sdiff = ne %sp, %cs\n    %n6 = and %pinf, %cinf\n    %n7 = and %n6, %sdiff\n    %nan = or %n5, %n7\n    %amd = ext.u %amn, to i$d\n    %bmd = ext.u %bmn, to i$d\n    %mp = mul %amd, %bmd\n    %ep = add %aen, %ben\n    %tp0 = add %ep, i$n $p2\n    %tc0 = add %cen, i$n $p\n    %tp = select %pz, %tc0, %tp0\n    %tc = select %cz, %tp, %tc0\n    %pbig = ge.s %tp, %tc\n    %tbig = select %pbig, %tp, %tc\n    %u = sub %tbig, i$n $qtop1\n    %pd = sub %ep, %u\n    %ppos = ge.s %pd, i$n 0\n    %pnd = sub i$n 0, %pd\n    %pl1 = select %ppos, %pd, i$n 0\n    %plf = gt.s %pl1, i$n $qtop\n    %pl0 = select %plf, i$n $qtop, %pl1\n    %pr0 = select %ppos, i$n 0, %pnd\n    %prf = gt.s %pr0, i$n $qtop\n    %prc = select %prf, i$n $qtop, %pr0\n    %plq = ext.u %pl0, to i$q\n    %prq = ext.u %prc, to i$q\n    %pmq = ext.u %mp, to i$q\n    %pleft = shl %pmq, %plq\n    %pright = shr.u %pmq, %prq\n    %pbit = shl i$q 1, %prq\n    %plowm = sub %pbit, i$q 1\n    %plost = and %pmq, %plowm\n    %pst = ne %plost, i$q 0\n    %pstb = ext.u %pst, to i$q\n    %prj = or %pright, %pstb\n    %pF = select %ppos, %pleft, %prj\n    %cd = sub %cen, %u\n    %cpos = ge.s %cd, i$n 0\n    %cnd = sub i$n 0, %cd\n    %cl1 = select %cpos, %cd, i$n 0\n    %clf = gt.s %cl1, i$n $qtop\n    %cl0 = select %clf, i$n $qtop, %cl1\n    %cr0 = select %cpos, i$n 0, %cnd\n    %crf = gt.s %cr0, i$n $qtop\n    %crc = select %crf, i$n $qtop, %cr0\n    %clq = ext.u %cl0, to i$q\n    %crq = ext.u %crc, to i$q\n    %cmq = ext.u %cmn, to i$q\n    %cleft = shl %cmq, %clq\n    %cright = shr.u %cmq, %crq\n    %cbit = shl i$q 1, %crq\n    %clowm = sub %cbit, i$q 1\n    %clost = and %cmq, %clowm\n    %cst = ne %clost, i$q 0\n    %cstb = ext.u %cst, to i$q\n    %crj = or %cright, %cstb\n    %cF = select %cpos, %cleft, %crj\n    %same = eq %sp, %cs\n    %sum = add %pF, %cF\n    %pge = ge.u %pF, %cF\n    %d1 = sub %pF, %cF\n    %d2 = sub %cF, %pF\n    %dif = select %pge, %d1, %d2\n    %ds = select %pge, %sp, %cs\n    %S = select %same, %sum, %dif\n    %s0 = select %same, %sp, %ds\n    %Sz = eq %S, i$q 0\n    %zs = and %sp, %cs\n    %s = select %Sz, %zs, %s0\n    %lz0 = clz %S\n    %lz = select %Sz, i$q 0, %lz0\n    %Sn = shl %S, %lz\n    %hi = shr.u %Sn, i$q $d\n    %m0 = trunc %hi, to i$d\n    %lo = shl %Sn, i$q $d\n    %lost = ne %lo, i$q 0\n    %lb = ext.u %lost, to i$d\n    %m = or %m0, %lb\n    %lzn = trunc %lz, to i$n\n    %e0 = sub %u, %lzn\n    %e = add %e0, i$n $d\n    %pk = call ptr @$calls, %s, %e, %m, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %pinfv = or %sp, i$n $inf\n    %v0 = select %cinf, %c, %pk\n    %v = select %pinf, %pinfv, %v0\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# the operand an order of the keys chooses, a nan where either operand is one,
# or for the number forms the other operand where one is
val SOFT_BOUND: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %ba = and %b, i$n $abs\n    %an = gt.u %aa, i$n $inf\n    %bn = gt.u %ba, i$n $inf\n    %afill = shr.s %a, i$n $top\n    %aflip = or %afill, i$n $sign\n    %ak = xor %a, %aflip\n    %bfill = shr.s %b, i$n $top\n    %bflip = or %bfill, i$n $sign\n    %bk = xor %b, %bflip\n    %c = $order %ak, %bk\n    %v = select %c, %a, %b\n    %both = and %an, %bn\n    %either = or %an, %bn\n    %other = select %an, %b, %a\n    %keep = ne i$n $num, i$n 0\n    %fallback = select %keep, %other, i$n $nan\n    %r1 = select %either, %fallback, %v\n    %r2 = select %both, i$n $nan, %r1\n    ret %r2\n}\n";

# the fraction bits of the encoding cleared, a unit added where the rounding's
# rule rounds away, a carry moving into the exponent, and a magnitude below
# one made a signed zero or a signed one
val SOFT_ROUND: str = "function @$name: fun(i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %s = and %x, i$n $sign\n    %a = and %x, i$n $abs\n    %nan = gt.u %a, i$n $inf\n    %ef = shr.u %a, i$n $sig\n    %u = sub %ef, i$n $bias\n    %big = ge.s %u, i$n $sig\n    %small = lt.s %u, i$n 0\n    %neg = ne %s, i$n 0\n    %pos = xor %neg, i1 1\n    %nz = ne %a, i$n 0\n    %fl = ne i$n $floor, i$n 0\n    %ce = ne i$n $ceil, i$n 0\n    %ne = ne i$n $even, i$n 0\n    %out = or %big, %small\n    %fb0 = sub i$n $sig, %u\n    %fb = select %out, i$n 1, %fb0\n    %unit = shl i$n 1, %fb\n    %mask = sub %unit, i$n 1\n    %frac = and %a, %mask\n    %int = xor %a, %frac\n    %fb1 = sub %fb, i$n 1\n    %halfv = shl i$n 1, %fb1\n    %gt = gt.u %frac, %halfv\n    %eq = eq %frac, %halfv\n    %iu = shr.u %int, %fb\n    %io = and %iu, i$n 1\n    %odd = ne %io, i$n 0\n    %fnz = ne %frac, i$n 0\n    %d0 = and %neg, %fnz\n    %d1 = and %fl, %d0\n    %c0 = and %pos, %fnz\n    %c1 = and %ce, %c0\n    %t0 = and %eq, %odd\n    %t1 = or %gt, %t0\n    %t2 = and %ne, %t1\n    %u0 = or %d1, %c1\n    %up = or %u0, %t2\n    %step = select %up, %unit, i$n 0\n    %mid = add %int, %step\n    %sd0 = and %neg, %nz\n    %sd1 = and %fl, %sd0\n    %sc0 = and %pos, %nz\n    %sc1 = and %ce, %sc0\n    %above = gt.u %a, i$n $halfenc\n    %sn = and %ne, %above\n    %so0 = or %sd1, %sc1\n    %so = or %so0, %sn\n    %sr = select %so, i$n $oneenc, i$n 0\n    %r0 = select %small, %sr, %mid\n    %r1 = select %big, %a, %r0\n    %r2 = or %r1, %s\n    %r = select %nan, i$n $nan, %r2\n    ret %r\n}\n";

# 1 for less, 2 for equal and 4 for greater by the keys, the two zeros equal,
# and 8 where either is a nan
val SOFT_COMPARE: str = "function @$name: fun(i$n, i$n) -> (i32) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %ba = and %b, i$n $abs\n    %an = gt.u %aa, i$n $inf\n    %bn = gt.u %ba, i$n $inf\n    %un = or %an, %bn\n    %afill = shr.s %a, i$n $top\n    %aflip = or %afill, i$n $sign\n    %ak = xor %a, %aflip\n    %bfill = shr.s %b, i$n $top\n    %bflip = or %bfill, i$n $sign\n    %bk = xor %b, %bflip\n    %ab = or %aa, %ba\n    %z = eq %ab, i$n 0\n    %nz = xor %z, i1 1\n    %lt0 = lt.u %ak, %bk\n    %gt0 = gt.u %ak, %bk\n    %eq0 = eq %ak, %bk\n    %lt = and %lt0, %nz\n    %gt = and %gt0, %nz\n    %eq = or %eq0, %z\n    %l = ext.u %lt, to i32\n    %e1 = ext.u %eq, to i32\n    %g1 = ext.u %gt, to i32\n    %e = shl %e1, i32 1\n    %g = shl %g1, i32 2\n    %le = or %l, %e\n    %m = or %le, %g\n    %r = select %un, i32 8, %m\n    ret %r\n}\n";

# the divisor's significand taken from the dividend's at each exponent of the
# difference from the top, one step for every exponent of the format whether
# it is reached or not, packed exactly at the divisor's exponent
val SOFT_REMAINDER: str = "function @$name: fun(i$n, i$n) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%a: i$n, %b: i$n):\n    %aa = and %a, i$n $abs\n    %as = and %a, i$n $sign\n    %anan = gt.u %aa, i$n $inf\n    %ainf = eq %aa, i$n $inf\n    %az = eq %aa, i$n 0\n    %af = shr.u %aa, i$n $sig\n    %asub = eq %af, i$n 0\n    %afr = and %a, i$n $frac\n    %am1 = or %afr, i$n $one\n    %am = select %asub, %afr, %am1\n    %af1 = select %asub, i$n 1, %af\n    %ae = sub %af1, i$n $unit\n    %ba = and %b, i$n $abs\n    %bs = and %b, i$n $sign\n    %bnan = gt.u %ba, i$n $inf\n    %binf = eq %ba, i$n $inf\n    %bz = eq %ba, i$n 0\n    %bf = shr.u %ba, i$n $sig\n    %bsub = eq %bf, i$n 0\n    %bfr = and %b, i$n $frac\n    %bm1 = or %bfr, i$n $one\n    %bm = select %bsub, %bfr, %bm1\n    %bf1 = select %bsub, i$n 1, %bf\n    %be = sub %bf1, i$n $unit\n    %alz0 = clz %am\n    %alz = sub %alz0, i$n $gap\n    %amn = shl %am, %alz\n    %aen = sub %ae, %alz\n    %blz0 = clz %bm\n    %blz = sub %blz0, i$n $gap\n    %bmn = shl %bm, %blz\n    %ben = sub %be, %blz\n    %n0 = or %anan, %bnan\n    %n1 = or %ainf, %bz\n    %nan = or %n0, %n1\n    %k0 = or %az, %binf\n    %diff = sub %aen, %ben\n    %early = lt.s %diff, i$n 0\n    %keep = or %k0, %early\n    br ^step(i$n $last, %amn)\n^step(%k: i$n, %r: i$n):\n    %act = le.s %k, %diff\n    %ge = ge.u %r, %bmn\n    %r1 = sub %r, %bmn\n    %r2 = select %ge, %r1, %r\n    %end = eq %k, i$n 0\n    %r3 = shl %r2, i$n 1\n    %r4 = select %end, %r2, %r3\n    %r5 = select %act, %r4, %r\n    %k1 = sub %k, i$n 1\n    %more = ge.s %k1, i$n 0\n    cbr %more, ^step(%k1, %r5), ^done\n^done:\n    %md = ext.u %r5, to i$d\n    %pk = call ptr @$calls, %as, %ben, %md, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %v = select %keep, %a, %pk\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# an integer no wider than two words packed as it stands
val SOFT_FROM_UNSIGNED: str = "function @$name: fun(i$k) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: i$k):\n    %m = $fit\n    %pk = call ptr @$calls, i$n 0, i$n 0, %m, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    ret %pk\n}\n";

# a wider integer shifted past its leading zeros and cut to two words with a
# sticky bit, packed
val SOFT_FROM_UNSIGNED_WIDE: str = "function @$name: fun(i$k) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: i$k):\n    %z = eq %x, i$k 0\n    %lz0 = clz %x\n    %lz = select %z, i$k 0, %lz0\n    %xn = shl %x, %lz\n    %hi = shr.u %xn, i$k $kd\n    %m0 = trunc %hi, to i$d\n    %lo = shl %xn, i$k $d\n    %lost = ne %lo, i$k 0\n    %st = ext.u %lost, to i$d\n    %m = or %m0, %st\n    %lzn = trunc %lz, to i$n\n    %e = sub i$n $kd, %lzn\n    %pk = call ptr @$calls, i$n 0, %e, %m, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    ret %pk\n}\n";

# the magnitude converted unsigned, the sign put back
val SOFT_FROM_SIGNED: str = "function @$name: fun(i$k) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: i$k):\n    %fill = shr.s %x, i$k $ktop\n    %flip = xor %x, %fill\n    %mag = sub %flip, %fill\n    %f = call ptr @$calls, %mag, signature fun(i$k) -> (i$n), named all\n    %neg = lt.s %x, i$k 0\n    %sg = select %neg, i$n $sign, i$n 0\n    %r = or %f, %sg\n    ret %r\n}\n";

# the significand shifted by its exponent, saturated past the range, zero for
# a nan or a negative value
val SOFT_TO_UNSIGNED: str = "function @$name: fun(i$n) -> (i$k) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %xa = and %x, i$n $abs\n    %xs = and %x, i$n $sign\n    %xnan = gt.u %xa, i$n $inf\n    %xinf = eq %xa, i$n $inf\n    %xz = eq %xa, i$n 0\n    %xf = shr.u %xa, i$n $sig\n    %xsub = eq %xf, i$n 0\n    %xfr = and %x, i$n $frac\n    %xm1 = or %xfr, i$n $one\n    %xm = select %xsub, %xfr, %xm1\n    %xf1 = select %xsub, i$n 1, %xf\n    %xe = sub %xf1, i$n $unit\n    %neg = ne %xs, i$n 0\n    %low = or %xnan, %neg\n    %over = ge.u %xa, i$n $limit\n    %mK = $widen\n    %eK = $widene\n    %pos = ge.s %eK, i$K 0\n    %l0 = select %pos, %eK, i$K 0\n    %lf = gt.u %l0, i$K $Ktop\n    %sl = select %lf, i$K $Ktop, %l0\n    %ne = sub i$K 0, %eK\n    %r0 = select %pos, i$K 0, %ne\n    %rf = gt.u %r0, i$K $Ktop\n    %sr = select %rf, i$K $Ktop, %r0\n    %vl = shl %mK, %sl\n    %vr = shr.u %mK, %sr\n    %v = select %pos, %vl, %vr\n    %vk = $narrow\n    %r1 = select %over, i$k $ones, %vk\n    %r = select %low, i$k 0, %r1\n    ret %r\n}\n";

# the magnitude converted unsigned, negated for a negative value and saturated
# past the signed range, zero for a nan
val SOFT_TO_SIGNED: str = "function @$name: fun(i$n) -> (i$k) linkage weak visibility hidden constant_time {\n^entry(%x: i$n):\n    %a = and %x, i$n $abs\n    %ok = le.u %a, i$n $inf\n    %u = call ptr @$calls, %a, signature fun(i$n) -> (i$k), named all\n    %s = and %x, i$n $sign\n    %neg = ne %s, i$n 0\n    %big0 = ge.u %a, i$n $half\n    %big = and %big0, %ok\n    %minus = sub i$k 0, %u\n    %v = select %neg, %minus, %u\n    %sat = select %neg, i$k $least, i$k $most\n    %r = select %big, %sat, %v\n    ret %r\n}\n";

# the significand and exponent of the source cut to the destination's two
# words with a sticky bit and packed in the destination, a nan the canonical
# one
val SOFT_CONVERT: str = "function @$name: fun(i$ns) -> (i$n) linkage weak visibility hidden constant_time {\n^entry(%x: i$ns):\n    %a = and %x, i$ns $sabs\n    %nan = gt.u %a, i$ns $sinf\n    %inf = eq %a, i$ns $sinf\n    %sb = shr.u %x, i$ns $stop\n    %sbn = $fits\n    %s = shl %sbn, i$n $top\n    %ef = shr.u %a, i$ns $ssig\n    %sub = eq %ef, i$ns 0\n    %fr = and %x, i$ns $sfrac\n    %m1 = or %fr, i$ns $sone\n    %m = select %sub, %fr, %m1\n    %ef1 = select %sub, i$ns 1, %ef\n    %e0 = sub %ef1, i$ns $sunit\n    %mc0 = shr.u %m, i$ns $cut\n    %lowm = and %m, i$ns $cutmask\n    %lost = ne %lowm, i$ns 0\n    %lb = ext.u %lost, to i$ns\n    %mc = or %mc0, %lb\n    %e1 = add %e0, i$ns $cut\n    %md = $fitm\n    %en = $fite\n    %pk = call ptr @$calls, %s, %en, %md, signature fun(i$n, i$n, i$d) -> (i$n), named all\n    %infv = or %s, i$n $inf\n    %v = select %inf, %infv, %pk\n    %w = select %nan, i$n $nan, %v\n    ret %w\n}\n";

# no opcode
val NONE: opt[Opcode] = opt[Opcode].none{};

def Rows: [34]Row;

val ROWS: Rows = [34]Row{
    Row{operation: Operation.quotient_u{}, stem: "udiv", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.quotient_s{}, stem: "sdiv", naming: Naming.width{}, text: SIGNED_QUOTIENT, paired: nil, calls: Operation.quotient_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_u{}, stem: "urem", naming: Naming.width{}, text: UNSIGNED_DIVISION, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_s{}, stem: "srem", naming: Naming.width{}, text: SIGNED_REMAINDER, paired: nil, calls: Operation.remainder_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_float_u{}, stem: "utof", naming: Naming.format{}, text: UNSIGNED_TO_FLOAT, paired: UNSIGNED_TO_FLOAT_PAIR, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_float_s{}, stem: "stof", naming: Naming.format{}, text: SIGNED_TO_FLOAT, paired: nil, calls: Operation.to_float_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_integer_u{}, stem: "ftou", naming: Naming.format{}, text: FLOAT_TO_UNSIGNED, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.to_integer_s{}, stem: "ftos", naming: Naming.format{}, text: FLOAT_TO_SIGNED, paired: nil, calls: Operation.to_integer_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.copy{}, stem: "copy", naming: Naming.width{}, text: COPY, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.fill{}, stem: "fill", naming: Naming.width{}, text: FILL, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.product{}, stem: "mul", naming: Naming.width{}, text: PRODUCT, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.remainder_f{}, stem: "frem", naming: Naming.float{}, text: FLOAT_REMAINDER, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].some{opcode.FREM}, computes: NONE},
    Row{operation: Operation.soft_pack{}, stem: "soft_fpack", naming: Naming.float{}, text: SOFT_PACK, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_add{}, stem: "soft_fadd", naming: Naming.float{}, text: SOFT_ADD, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FADD}},
    Row{operation: Operation.soft_sub{}, stem: "soft_fsub", naming: Naming.float{}, text: SOFT_SUB, paired: nil, calls: Operation.soft_add{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FSUB}},
    Row{operation: Operation.soft_mul{}, stem: "soft_fmul", naming: Naming.float{}, text: SOFT_MUL, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMUL}},
    Row{operation: Operation.soft_div{}, stem: "soft_fdiv", naming: Naming.float{}, text: SOFT_DIV, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FDIV}},
    Row{operation: Operation.soft_sqrt{}, stem: "soft_fsqrt", naming: Naming.float{}, text: SOFT_SQRT, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FSQRT}},
    Row{operation: Operation.soft_fma{}, stem: "soft_fma", naming: Naming.float{}, text: SOFT_FMA, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMA}},
    Row{operation: Operation.soft_min{}, stem: "soft_fmin", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMIN}},
    Row{operation: Operation.soft_max{}, stem: "soft_fmax", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMAX}},
    Row{operation: Operation.soft_minnum{}, stem: "soft_fminnum", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMINNUM}},
    Row{operation: Operation.soft_maxnum{}, stem: "soft_fmaxnum", naming: Naming.float{}, text: SOFT_BOUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FMAXNUM}},
    Row{operation: Operation.soft_floor{}, stem: "soft_ffloor", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FFLOOR}},
    Row{operation: Operation.soft_ceil{}, stem: "soft_fceil", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FCEIL}},
    Row{operation: Operation.soft_trunc{}, stem: "soft_fint", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FINT}},
    Row{operation: Operation.soft_nearest{}, stem: "soft_fnearest", naming: Naming.float{}, text: SOFT_ROUND, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FNEAREST}},
    Row{operation: Operation.soft_remainder{}, stem: "soft_frem", naming: Naming.float{}, text: SOFT_REMAINDER, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: opt[Opcode].some{opcode.FREM}},
    Row{operation: Operation.soft_compare{}, stem: "soft_fcmp", naming: Naming.float{}, text: SOFT_COMPARE, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_from_u{}, stem: "soft_utof", naming: Naming.format{}, text: SOFT_FROM_UNSIGNED, paired: SOFT_FROM_UNSIGNED_WIDE, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_from_s{}, stem: "soft_stof", naming: Naming.format{}, text: SOFT_FROM_SIGNED, paired: nil, calls: Operation.soft_from_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_to_u{}, stem: "soft_ftou", naming: Naming.format{}, text: SOFT_TO_UNSIGNED, paired: nil, calls: Operation.unstated{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_to_s{}, stem: "soft_ftos", naming: Naming.format{}, text: SOFT_TO_SIGNED, paired: nil, calls: Operation.soft_to_u{}, stands: opt[Opcode].none{}, computes: NONE},
    Row{operation: Operation.soft_convert{}, stem: "soft_fcvt", naming: Naming.formats{}, text: SOFT_CONVERT, paired: nil, calls: Operation.soft_pack{}, stands: opt[Opcode].none{}, computes: NONE},
};

# whether two operations are the same
pub fun same(a: Operation, b: Operation) bool {
    if (sel a.quotient_u)   { ret sel b.quotient_u; }
    if (sel a.quotient_s)   { ret sel b.quotient_s; }
    if (sel a.remainder_u)  { ret sel b.remainder_u; }
    if (sel a.remainder_s)  { ret sel b.remainder_s; }
    if (sel a.to_float_u)   { ret sel b.to_float_u; }
    if (sel a.to_float_s)   { ret sel b.to_float_s; }
    if (sel a.to_integer_u) { ret sel b.to_integer_u; }
    if (sel a.to_integer_s) { ret sel b.to_integer_s; }
    if (sel a.copy)         { ret sel b.copy; }
    if (sel a.fill)         { ret sel b.fill; }
    if (sel a.product)      { ret sel b.product; }
    if (sel a.remainder_f)  { ret sel b.remainder_f; }
    if (sel a.soft_pack) { ret sel b.soft_pack; }
    if (sel a.soft_add) { ret sel b.soft_add; }
    if (sel a.soft_sub) { ret sel b.soft_sub; }
    if (sel a.soft_mul) { ret sel b.soft_mul; }
    if (sel a.soft_div) { ret sel b.soft_div; }
    if (sel a.soft_sqrt) { ret sel b.soft_sqrt; }
    if (sel a.soft_fma) { ret sel b.soft_fma; }
    if (sel a.soft_min) { ret sel b.soft_min; }
    if (sel a.soft_max) { ret sel b.soft_max; }
    if (sel a.soft_minnum) { ret sel b.soft_minnum; }
    if (sel a.soft_maxnum) { ret sel b.soft_maxnum; }
    if (sel a.soft_floor) { ret sel b.soft_floor; }
    if (sel a.soft_ceil) { ret sel b.soft_ceil; }
    if (sel a.soft_trunc) { ret sel b.soft_trunc; }
    if (sel a.soft_nearest) { ret sel b.soft_nearest; }
    if (sel a.soft_remainder) { ret sel b.soft_remainder; }
    if (sel a.soft_compare) { ret sel b.soft_compare; }
    if (sel a.soft_from_u) { ret sel b.soft_from_u; }
    if (sel a.soft_from_s) { ret sel b.soft_from_s; }
    if (sel a.soft_to_u) { ret sel b.soft_to_u; }
    if (sel a.soft_to_s) { ret sel b.soft_to_s; }
    if (sel a.soft_convert) { ret sel b.soft_convert; }
    ret sel b.unstated;
}

# every row, in order
pub fun rows() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: $length_of(Rows)};
}

# the row of an operation, none for one no helper does
pub fun row(op: Operation) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (same(ROWS[i].operation, op)) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the row that stands in for an operation of `mirl.target.OPTIONAL`, none for
# an operation no row stands in for
pub fun standing(code: Opcode) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        val stands: opt[Opcode] = ROWS[i].stands;
        if (sel stands.some) {
            if (stands.some.index == code.index) { ret opt[*Row].some{?ROWS[i]}; }
        }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# the soft row that computes a float operation on encodings, none for an
# operation no soft row computes
pub fun computing(code: Opcode) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        val computes: opt[Opcode] = ROWS[i].computes;
        if (sel computes.some) {
            if (computes.some.index == code.index) { ret opt[*Row].some{?ROWS[i]}; }
        }
        i = i + 1;
    }
    ret opt[*Row].none{};
}

# whether a row computes on encodings
pub fun soft(op: Operation) bool {
    ret sel op.soft_pack || sel op.soft_add || sel op.soft_sub || sel op.soft_mul || sel op.soft_div || sel op.soft_sqrt || sel op.soft_fma || sel op.soft_min || sel op.soft_max || sel op.soft_minnum || sel op.soft_maxnum || sel op.soft_floor || sel op.soft_ceil || sel op.soft_trunc || sel op.soft_nearest || sel op.soft_remainder || sel op.soft_compare || sel op.soft_from_u || sel op.soft_from_s || sel op.soft_to_u || sel op.soft_to_s || sel op.soft_convert;
}
