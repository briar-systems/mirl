# tests of wide integer splitting: text in and text out through the driver,
# and every integer opcode at every wide width over every word width against
# the folder

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use diag: std.print;
use std.types.view.View;

use folder: mirl.fold;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.legal.check_test.CAPACITY;
use mirl.legal.check_test.Text;
use mirl.legal.check_test.check_text;
use mirl.legal.check_test.number;
use mirl.legal.check_test.put;
use mirl.legal.check_test.view;
use mirl.legal.helper;
use mirl.legal.wide.WIDE;
