use mirl.pass.failure.Error;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine;

# a register machine whose widest arithmetic is a width, memory reinterpretable
#[testing]
fun words_of(t: *Target, width: u32) bool {
    val top: opt[u32] = targets.widest(?t.caps);
    if (!targets.register_machine(t) || !(sel t.caps.addressing.physical)) { ret false; }
    if (sel top.some)                                                      { ret top.some == width; }
    ret false;
}

#[testing]
fun words_of_32(t: *Target) bool {
    ret words_of(t, 32);
}

#[testing]
fun words_of_64(t: *Target) bool {
    ret words_of(t, 64);
}

# the target line of a text
#[testing]
fun header(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\n");
}

# run the pass over a body for a target, comparing with the expected body
#[testing]
fun split_as(row: *Target, before: str, after: str) i32 {
    var a: Text;
    header(?a, row);
    put(?a, before);
    var b: Text;
    header(?b, row);
    put(?b, after);
    ret check_text(row, ?WIDE, view(?a), view(?b), true, Slice[str]{data: nil, size: 0});
}

# a sum of two 256 bit values over 64 bit words
#[testing]
val CARRY_BEFORE: str = "function @carry: fun(ptr, ptr) -> () linkage global visibility default {\n^entry(%p: ptr, %q: ptr):\n    %x = load %p, type i256, align 8\n    %y = load %q, type i256, align 8\n    %s = add %x, %y\n    store %p, %s, align 8\n    ret\n}\n";

# each word is loaded at its offset, the carry out of each word is the flag of
# its sum and goes into the next, the top word's carry is not made, and each
# word is stored at its offset
#[testing]
val CARRY_AFTER: str = "function @carry: fun(ptr, ptr) -> () linkage global visibility default {\n^entry(%p: ptr, %q: ptr):\n    %x0 = load %p, type i64, align 8\n    %px1 = ptr.add %p, i64 8\n    %x1 = load %px1, type i64, align 8\n    %px2 = ptr.add %p, i64 16\n    %x2 = load %px2, type i64, align 8\n    %px3 = ptr.add %p, i64 24\n    %x3 = load %px3, type i64, align 8\n    %y0 = load %q, type i64, align 8\n    %qy1 = ptr.add %q, i64 8\n    %y1 = load %qy1, type i64, align 8\n    %qy2 = ptr.add %q, i64 16\n    %y2 = load %qy2, type i64, align 8\n    %qy3 = ptr.add %q, i64 24\n    %y3 = load %qy3, type i64, align 8\n    %s0, %c0 = add.ov.u %x0, %y0\n    %t1, %d1 = add.ov.u %x1, %y1\n    %e0 = ext.u %c0, to i64\n    %s1, %f1 = add.ov.u %t1, %e0\n    %c1 = or %d1, %f1\n    %t2, %d2 = add.ov.u %x2, %y2\n    %e1 = ext.u %c1, to i64\n    %s2, %f2 = add.ov.u %t2, %e1\n    %c2 = or %d2, %f2\n    %t3 = add %x3, %y3\n    %e2 = ext.u %c2, to i64\n    %s3 = add %t3, %e2\n    store %p, %s0, align 8\n    %ps1 = ptr.add %p, i64 8\n    store %ps1, %s1, align 8\n    %ps2 = ptr.add %p, i64 16\n    store %ps2, %s2, align 8\n    %ps3 = ptr.add %p, i64 24\n    store %ps3, %s3, align 8\n    ret\n}\n";

test wide__a_carry_crosses_every_word {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, CARRY_BEFORE, CARRY_AFTER);
}

# a 128 bit value shifted left by 68 and right by 60, over 64 bit words
#[testing]
val SHIFT_BEFORE: str = "function @shift: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x = load %p, type i128, align 16\n    %l = shl %x, i128 68\n    store %p, %l, align 16\n    %r = shr.u %x, i128 60\n    store %p, %r, align 16\n    ret\n}\n";

# a shift by 68 moves the low word up one word and its bits up 4, leaving the
# low word zero, and a shift by 60 brings the high word's low 4 bits down into
# the top of the low word
#[testing]
val SHIFT_AFTER: str = "function @shift: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x0 = load %p, type i64, align 16\n    %px1 = ptr.add %p, i64 8\n    %x1 = load %px1, type i64, align 8\n    %l1 = shl %x0, i64 4\n    store %p, i64 0, align 16\n    %pl1 = ptr.add %p, i64 8\n    store %pl1, %l1, align 8\n    %down = shr.u %x0, i64 60\n    %up = shl %x1, i64 4\n    %r0 = or %down, %up\n    %r1 = shr.u %x1, i64 60\n    store %p, %r0, align 16\n    %pr1 = ptr.add %p, i64 8\n    store %pr1, %r1, align 8\n    ret\n}\n";

test wide__a_shift_whose_count_crosses_a_word_moves_the_bits_across {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, SHIFT_BEFORE, SHIFT_AFTER);
}

# a signed comparison of two 256 bit values over 64 bit words
#[testing]
val COMPARE_BEFORE: str = "function @compare: fun(ptr, ptr) -> (i1) linkage global visibility default {\n^entry(%p: ptr, %q: ptr):\n    %x = load %p, type i256, align 8\n    %y = load %q, type i256, align 8\n    %c = lt.s %x, %y\n    ret %c\n}\n";

# the low word decides alone, each word above decides where it is not equal
# and passes the decision below it on where it is, and only the top word reads
# its sign
#[testing]
val COMPARE_AFTER: str = "function @compare: fun(ptr, ptr) -> (i1) linkage global visibility default {\n^entry(%p: ptr, %q: ptr):\n    %x0 = load %p, type i64, align 8\n    %px1 = ptr.add %p, i64 8\n    %x1 = load %px1, type i64, align 8\n    %px2 = ptr.add %p, i64 16\n    %x2 = load %px2, type i64, align 8\n    %px3 = ptr.add %p, i64 24\n    %x3 = load %px3, type i64, align 8\n    %y0 = load %q, type i64, align 8\n    %qy1 = ptr.add %q, i64 8\n    %y1 = load %qy1, type i64, align 8\n    %qy2 = ptr.add %q, i64 16\n    %y2 = load %qy2, type i64, align 8\n    %qy3 = ptr.add %q, i64 24\n    %y3 = load %qy3, type i64, align 8\n    %l0 = lt.u %x0, %y0\n    %e1 = eq %x1, %y1\n    %l1 = lt.u %x1, %y1\n    %c1 = select %e1, %l0, %l1\n    %e2 = eq %x2, %y2\n    %l2 = lt.u %x2, %y2\n    %c2 = select %e2, %c1, %l2\n    %e3 = eq %x3, %y3\n    %l3 = lt.s %x3, %y3\n    %c3 = select %e3, %c2, %l3\n    ret %c3\n}\n";

test wide__a_comparison_decides_on_the_high_word_then_the_lower_words {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, COMPARE_BEFORE, COMPARE_AFTER);
}

# a condition stored and loaded back
#[testing]
val BIT_BEFORE: str = "function @bit: fun(ptr, i1) -> (i1) linkage global visibility default {\n^entry(%p: ptr, %c: i1):\n    store %p, %c, align 1\n    %b = load %p, type i1, align 1\n    ret %b\n}\n";

# the condition is held in memory as one byte that is 0 or 1, and read back as
# its low bit
#[testing]
val BIT_AFTER: str = "function @bit: fun(ptr, i1) -> (i1) linkage global visibility default {\n^entry(%p: ptr, %c: i1):\n    %e = ext.u %c, to i8\n    store %p, %e, align 1\n    %h = load %p, type i8, align 1\n    %b = trunc %h, to i1\n    ret %b\n}\n";

test wide__a_condition_stored_and_loaded_back_keeps_0_or_1_in_one_byte {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, BIT_BEFORE, BIT_AFTER);
}

# a 128 bit value reinterpreted as four 32 bit lanes and back
#[testing]
val LANES_BEFORE: str = "function @lanes: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x = load %p, type i128, align 16\n    %v = bitcast %x, to vec<4, i32>\n    %y = bitcast %v, to i128\n    store %p, %y, align 16\n    ret\n}\n";

# lane 0 holds the low bits of the low word, and each word is the lanes it
# holds shifted to their places
#[testing]
val LANES_AFTER: str = "function @lanes: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x0 = load %p, type i64, align 16\n    %a = ptr.add %p, i64 8\n    %x1 = load %a, type i64, align 8\n    %l0 = trunc %x0, to i32\n    %s0 = shr.u %x0, i64 32\n    %l1 = trunc %s0, to i32\n    %l2 = trunc %x1, to i32\n    %s1 = shr.u %x1, i64 32\n    %l3 = trunc %s1, to i32\n    %v = vbuild %l0, %l1, %l2, %l3, vector vec<4, i32>\n    %e0 = vextract %v, lane 0\n    %w0 = ext.u %e0, to i64\n    %e1 = vextract %v, lane 1\n    %w1 = ext.u %e1, to i64\n    %h1 = shl %w1, i64 32\n    %y0 = or %w0, %h1\n    %e2 = vextract %v, lane 2\n    %w2 = ext.u %e2, to i64\n    %e3 = vextract %v, lane 3\n    %w3 = ext.u %e3, to i64\n    %h3 = shl %w3, i64 32\n    %y1 = or %w2, %h3\n    store %p, %y0, align 16\n    %b = ptr.add %p, i64 8\n    store %b, %y1, align 8\n    ret\n}\n";

test wide__a_reinterpretation_as_lanes_reads_lane_0_from_the_low_bits {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, LANES_BEFORE, LANES_AFTER);
}

# variables bound to the low bits of a 128 bit sum and to all of it
#[testing]
val BOUND_BEFORE: str = "!f0 = file \"a.mach\"\n!l0 = location !f0 3:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"i32\" \"i32\" base signed 32\n!t2 = type \"i128\" \"i128\" base signed 128\n!v0 = variable \"low\" !t0 declared !l0\n!v1 = variable \"half\" !t1 declared !l0\n!v2 = variable \"all\" !t2 declared !l0\nfunction @bound: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x = load %p, type i128, align 16\n    %y = add %x, i128 1\n    bind !v0 = %y, trunc i64\n    bind !v1 = %y, trunc i32\n    bind !v2 = %y\n    store %p, %y, align 16\n    ret\n}\n";

# the low bits are read from the low word, and the whole sum, which no one
# record can read from two words, is unavailable
#[testing]
val BOUND_AFTER: str = "!f0 = file \"a.mach\"\n!l0 = location !f0 3:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"i32\" \"i32\" base signed 32\n!t2 = type \"i128\" \"i128\" base signed 128\n!v0 = variable \"low\" !t0 declared !l0\n!v1 = variable \"half\" !t1 declared !l0\n!v2 = variable \"all\" !t2 declared !l0\nfunction @bound: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %x0 = load %p, type i64, align 16\n    %a = ptr.add %p, i64 8\n    %x1 = load %a, type i64, align 8\n    %y0, %c = add.ov.u %x0, i64 1\n    %e = ext.u %c, to i64\n    %y1 = add %x1, %e\n    bind !v0 = %y0\n    bind !v1 = %y0, trunc i32\n    bind !v2 unavailable\n    store %p, %y0, align 16\n    %b = ptr.add %p, i64 8\n    store %b, %y1, align 8\n    ret\n}\n";

test wide__a_variable_bound_to_the_low_bits_of_a_split_value_reads_its_low_word {
    val row: opt[*Target] = targets.first(words_of_64);
    if (sel row.none) { ret 1; }
    ret split_as(row.some, BOUND_BEFORE, BOUND_AFTER);
}

# the values every operation is evaluated on at a width: zero, one, the counts
# about the width, a full low word, which carries, and the values about the sign
#[testing]
val BOUNDARIES: usize = 8;

#[testing]
fun boundary(width: u32, word_bits: u32, at: usize) Wide {
    val top: Wide = word.shl(word.small(1), width - 1);
    if (at == 0) { ret word.zero(); }
    if (at == 1) { ret word.small(1); }
    if (at == 2) { ret word.small((width - 1)::u64); }
    if (at == 3) { ret word.small(width::u64); }
    if (at == 4) { ret word.ones(word_bits); }
    if (at == 5) { ret word.sub(top, word.small(1)); }
    if (at == 6) { ret top; }
    ret word.ones(width);
}

#[testing]
fun hex(t: *Text, x: Wide) {
    put(t, "0x");
    var started: bool = false;
    var i:       u32  = word.capacity();
    for (i > 0) {
        i = i - 4;
        val nibble: u64 = word.mask(word.shr(x, i), 4)[0];
        if (nibble != 0 || started || i == 0) {
            started = true;
            var one: [2]u8 = [2]u8{0, 0};
            if (nibble < 10) { one[0] = ('0'::u64 + nibble)::u8; }
            or               { one[0] = ('a'::u64 + nibble - 10)::u8; }
            put(t, ?one[0]);
        }
    }
}

#[testing]
fun constant(t: *Text, width: u32, x: Wide) {
    put(t, "i");
    number(t, width::u64);
    put(t, " ");
    hex(t, x);
}

# a result stored: a condition as a byte, an integer as it is
#[testing]
fun store(t: *Text, name: str, j: u64, condition: bool) {
    if (condition) {
        put(t, "    %e");
        put(t, name);
        number(t, j);
        put(t, " = ext.u %");
        put(t, name);
        number(t, j);
        put(t, ", to i8\n    store %p, %e");
        put(t, name);
        number(t, j);
        put(t, ", align 1\n");
        ret;
    }
    put(t, "    store %p, %");
    put(t, name);
    number(t, j);
    put(t, ", align 8\n");
}

# whether the folder evaluates the opcode as integer arithmetic
#[testing]
fun integer(code: Opcode) bool {
    val e: folder.Entry = folder.entry(code);
    ret sel e.unary || sel e.binary || sel e.shift || sel e.overflow || sel e.compare;
}

# one operation at one width on every boundary value, a shift's count both as
# a constant and as a value the pass cannot read as one, each result stored
#[testing]
fun write(t: *Text, row: *Target, code: Opcode, r: *Row, width: u32, word_bits: u32) {
    header(t, row);
    put(t, "function @f: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n");
    val binary:  bool  = opcode.fixed(r) == 2;
    val masked:  bool  = sel r.results[0].mask;
    val flagged: bool  = !(sel r.results[1].unstated);
    val shifts:  bool  = !(sel r.overshift.none);
    var j:       u64   = 0;
    var x:       usize = 0;
    for (x < BOUNDARIES) {
        var y: usize = 0;
        for (y < BOUNDARIES) {
            if (binary || y == 0) {
                var way:  usize = 0;
                var ways: usize = 1;
                if (shifts) { ways = 2; }
                for (way < ways) {
                    if (way == 1) {
                        put(t, "    %k");
                        number(t, j);
                        put(t, " = xor ");
                        constant(t, width, boundary(width, word_bits, y));
                        put(t, ", ");
                        constant(t, width, word.zero());
                        put(t, "\n");
                    }
                    put(t, "    %r");
                    number(t, j);
                    if (flagged) {
                        put(t, ", %o");
                        number(t, j);
                    }
                    put(t, " = ");
                    put(t, r.name);
                    put(t, " ");
                    constant(t, width, boundary(width, word_bits, x));
                    if (binary) {
                        put(t, ", ");
                        if (way == 1) {
                            put(t, "%k");
                            number(t, j);
                        }
                        or { constant(t, width, boundary(width, word_bits, y)); }
                    }
                    put(t, "\n");
                    store(t, "r", j, masked);
                    if (flagged) { store(t, "o", j, true); }
                    j   = j + 1;
                    way = way + 1;
                }
            }
            y = y + 1;
        }
        x = x + 1;
    }
    put(t, "    ret\n}\n");
}

# the folder's answer, split, beside the split folded
#[testing]
fun agree(a: *allocator.Allocator, row: *Target, text: View) u32 {
    var first: res[Module, Refusal] = parse_body(a, text);
    if (sel first.err) { ret 1; }
    var want: Module = first.ok;
    fin { module.dnit(?want); }
    var second: res[Module, Refusal] = parse_body(a, text);
    if (sel second.err) { ret 2; }
    var got: Module = second.ok;
    fin { module.dnit(?got); }

    val started: res[Driver, Error] = driver.init(?want, row, machine.BARE, Options{level: 1, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val folded: res[bool, Error] = driver.apply(?d, ?FOLD);
    if (sel folded.err) { ret 3; }
    if (!folded.ok)     { ret 3; }
    val parted: res[bool, Error] = driver.apply(?d, ?WIDE);
    if (sel parted.err) { ret 4; }

    val started_e: res[Driver, Error] = driver.init(?got, row, machine.BARE, Options{level: 1, checked: true});
    if (sel started_e.err) { ret 90; }
    var e: Driver = started_e.ok;
    fin { driver.dnit(?e); }
    val split: res[bool, Error] = driver.apply(?e, ?WIDE);
    if (sel split.err) { ret 5; }
    if (!split.ok)     { ret 5; }
    val again: res[bool, Error] = driver.apply(?e, ?FOLD);
    if (sel again.err) { ret 6; }

    val same: res[bool, printer.Error] = equal.same(?want, ?got);
    if (sel same.err) { ret 7; }
    if (!same.ok)     { ret 7; }
    ret 0;
}

# the walk at one word width: every integer opcode at every width above it
#[testing]
fun walk(a: *allocator.Allocator, row: *Target, word_bits: u32) i32 {
    var width: u32 = word_bits * 2;
    for (width <= 512) {
        var op: u32 = 0;
        for (op < opcode.rows()) {
            val code: Opcode = Opcode{index: op};
            if (integer(code)) {
                val got: opt[Row] = opcode.row(code);
                if (sel got.none) { ret 2; }
                var r: Row = got.some;
                if (!helper.takes(code)) {
                    var text: Text;
                    write(?text, row, code, ?r, width, word_bits);
                    if (text.len >= CAPACITY) { ret 3; }
                    val c: u32 = agree(a, row, view(?text));
                    if (c != 0) {
                        diag.eprintlnf("{} at {} over {}: step {}", r.name, width, word_bits, c);
                        ret 4;
                    }
                }
            }
            op = op + 1;
        }
        width = width * 2;
    }
    ret 0;
}

# every integer opcode the folder evaluates, at every width above the word over
# words of 32 and of 64 bits, gives what the folder gives, or is one the pass
# leaves to the helpers legalisation
test wide__every_width_over_every_word_splits_through_the_one_algorithm {
    var a: allocator.Allocator;
    page.make(?a);
    val narrow: opt[*Target] = targets.first(words_of_32);
    if (sel narrow.none) { ret 1; }
    val broad: opt[*Target] = targets.first(words_of_64);
    if (sel broad.none) { ret 1; }
    val small: i32 = walk(?a, narrow.some, 32);
    if (small != 0) { ret small; }
    val large: i32 = walk(?a, broad.some, 64);
    if (large != 0) { ret 10 + large; }
    ret 0;
}
