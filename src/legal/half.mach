# formats the build holds no unit for, computed in a wider one it holds, or on
# their encodings by helpers where none it holds admits them
#
# a value of a format the target computes in under no condition the build
# meets, binary16 on every register target among them, is held as the integer
# of its width that is its encoding, and every operation on it widens each
# operand exactly to a wider format the build holds, computes there once and
# narrows the result once, rounding to nearest with ties to even. the wide
# format is read from the number format table and the target's held rows,
# never a format's name, as the narrowest held one the rule of the operation
# admits:
#
# - add, subtract, multiply, divide, square root, remainder, the minimum and
#   maximum and the integral roundings compute in a format whose precision is
#   at least twice the narrow one's plus two, and whose exponent range holds
#   every narrow value as a normal number. the one rounding of the wide result
#   then gives the correctly rounded narrow result (figueroa, "when is double
#   rounding innocuous", 1995), and a remainder, a minimum, a maximum and an
#   integral rounding are exact there. binary32 has 24 bits against binary16's
#   11, twice 11 plus 2.
# - a fused multiply-add computes in a format whose precision is at least four
#   times the narrow one's plus two, and whose exponent range holds the exact
#   product: the product of two narrow values is exact at twice the narrow
#   precision, and its sum with the addend then rounds innocuously before the
#   narrowing, as the sum of two values of that doubled precision does. for
#   binary16 that is binary64.
# - a comparison compares the widened values, which is exact, as are the sign
#   operations, which keep every bit through the widening and the narrowing.
# - a conversion to an integer converts the widened value, which is the same
#   value. a conversion from an integer converts to the wide format and narrows:
#   an integer the wide precision does not hold is past the narrow format's
#   overflow threshold, so it narrows to the same infinity either way.
# - a conversion to another format widens, then converts from the wide format
#   natively, which is exact. a conversion from another format narrows from its
#   own encoding, one rounding.
#
# widening and narrowing are integer code on the encodings, with no
# conversion instruction, since no target the pass serves holds one: sign,
# exponent and significand are taken apart and put together, a narrow
# subnormal widened as the exact product of its significand and the least
# subnormal's power of two, the wide format's subnormals narrowed by adding the
# power of two whose unit is the narrow least subnormal and taking it away
# again, which the wide addition rounds to nearest even, and the normal range
# rounded to nearest even on the integer, its carry moving into the exponent.
# a value at or past the narrow overflow threshold narrows to the infinity of
# its sign. a nan operand widens keeping its sign, payload and signalling bit,
# so the wide unit chooses and quiets it as the target would, and a nan
# narrows keeping its sign and the top of its payload, quieted. a nan a
# conversion gives follows the nan rule of the other format's held row: the
# canonical nan where the row states it, and the nan quieted otherwise.
#
# the value is kept as the format at the function's boundaries, its entry, a
# call's arguments and results and a return, where the convention's half
# precision rule places it, each read and made by a reinterpretation of its
# encoding. every other value of the format becomes its encoding: a load or
# store accesses the integer, a select chooses it and a block parameter holds
# it. a vector of the format is left, and refused where it is computed.
#
# an operation no held format admits, on a soft float build every operation of
# binary32 and binary64, is a call of a soft helper of mirl.legal.helper.table
# on the encodings of its operands, delivered into the module before the
# function is rewritten: an arithmetic operation, a minimum or maximum, an
# integral rounding and a remainder of its format, a comparison as the mask
# the helper gives tested against the relation and order of the opcode's row,
# a conversion to or from an integer of its width, and a conversion between
# two formats where either is computed by helpers alone or both are computed
# elsewhere. a sign operation is integer code on the encoding.
#
# nothing made branches or reads memory, a select is a mask, and every helper
# runs in a time that depends on no value it is given, so the pass keeps
# constant time, and every value made reads as the instruction it stands in
# for, its secrecy included.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build;
use folder: mirl.fold;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.ir.place.Named;
use types: mirl.ir.type;
use mirl.ir.type.Format;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.legal.helper.deliver;
use mirl.legal.helper.deliver.Want;
use mirl.legal.helper.table;
use mirl.legal.helper.table.Operation;
use mirl.opt.number;
use mirl.pass.analysis;
use mirl.pass.failure;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.target.Capabilities;
use mirl.target.Held;
use mirl.target.Nans;
use mirl.target.Target;
use target_basis: mirl.target.basis;
use mirl.target.basis.Basis;

# the pass: it adds instructions and block parameters and never touches an
# edge's target or a block
pub val HALF: Pass = Pass{name: "half precision", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

# how a format the build holds no unit for is computed
# ---
# basic: the format it computes in, none where no held format admits it
# fused: the format its fused multiply-add computes in, none where none admits it
# soft:  an operation no held format computes is a helper call on its encoding
rec Plan {
    basic: opt[Format];
    fused: opt[Format];
    soft:  bool;
}

# the precision of a binary format, its significand bits and the implicit one
fun precision(b: types.Binary) u32 {
    if (b.implicit) { ret b.significand + 1; }
    ret b.significand;
}

# the largest exponent of a finite value
fun emax(b: types.Binary) i64 {
    ret ((1::i64 << b.exponent::i64) - 2) - b.bias::i64;
}

# the exponent of the least normal value
fun emin(b: types.Binary) i64 {
    ret 1 - b.bias::i64;
}

fun binary(f: Format) opt[types.Binary] {
    val r: opt[types.Row] = types.row(f);
    if (sel r.none) { ret opt[types.Binary].none{}; }
    val row: types.Row      = r.some;
    val e:   types.Encoding = row.encoding;
    if (!(sel row.rounding.nearest_even)) { ret opt[types.Binary].none{}; }
    if (sel e.binary)                     { ret opt[types.Binary].some{e.binary}; }
    ret opt[types.Binary].none{};
}

# whether a wide format computes an operation of a narrow one by the rule:
# its precision at least `times` the narrow one's plus two, and its exponent
# range holding every narrow value, and for a fused multiply-add the exact
# product, as a normal number
fun admits(n: types.Binary, w: types.Binary, times: u32, fused: bool) bool {
    if (precision(w) < times * precision(n) + 2) { ret false; }
    var top:    i64 = emax(n) + 1;
    var bottom: i64 = emin(n) - (precision(n)::i64 - 1);
    if (fused) {
        top    = 2 * top;
        bottom = 2 * bottom;
    }
    ret emax(w) >= top && emin(w) <= bottom;
}

# the narrowest format the build holds that computes a narrow one's operations
# by the rule, none for none
fun widest_admitting(b: opt[*Basis], c: *Capabilities, n: types.Binary, times: u32, fused: bool) res[opt[Format], Why] {
    var best:  opt[Format] = opt[Format].none{};
    var width: u32         = 0;
    var i:     u32         = 0;
    for (i < types.rows()) {
        val f: Format                              = Format{index: i};
        val h: res[opt[*Held], target_basis.Error] = target_basis.held(b, c, f);
        if (sel h.err) { ret res[opt[Format], Why].err{Why.condition{h.err}}; }
        val w: opt[types.Binary] = binary(f);
        if (sel h.ok.some) {
            if (sel w.some) {
                if (admits(n, w.some, times, fused)) {
                    val bits: u32 = row_of(f).width;
                    if (width == 0 || bits < width) {
                        best  = opt[Format].some{f};
                        width = bits;
                    }
                }
            }
        }
        i = i + 1;
    }
    ret res[opt[Format], Why].ok{best};
}

# the plan of a format: none of either for one the build holds or that is no
# binary encoding rounding to nearest even
fun plan_of(b: opt[*Basis], c: *Capabilities, f: Format) res[Plan, Why] {
    val none: Plan                                = Plan{basic: opt[Format].none{}, fused: opt[Format].none{}, soft: false};
    val h:    res[opt[*Held], target_basis.Error] = target_basis.held(b, c, f);
    if (sel h.err)     { ret res[Plan, Why].err{Why.condition{h.err}}; }
    if (sel h.ok.some) { ret res[Plan, Why].ok{none}; }
    val n: opt[types.Binary] = binary(f);
    if (sel n.none) { ret res[Plan, Why].ok{none}; }
    val basic: res[opt[Format], Why] = widest_admitting(b, c, n.some, 2, false);
    if (sel basic.err) { ret res[Plan, Why].err{basic.err}; }
    val fused: res[opt[Format], Why] = widest_admitting(b, c, n.some, 4, true);
    if (sel fused.err) { ret res[Plan, Why].err{fused.err}; }
    ret res[Plan, Why].ok{Plan{basic: basic.ok, fused: fused.ok, soft: true}};
}

# whether some format the build holds no unit for is computed in one it holds
fun wanted(g: *Ground) bool {
    var i: u32 = 0;
    for (i < types.rows()) {
        val p: res[Plan, Why] = plan_of(g.basis, ?g.t.caps, Format{index: i});
        if (sel p.err)           { ret true; }
        if (sel p.ok.basic.some || p.ok.soft) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one visit
# ---
# site:   the function being rewritten
# basis:  the build's selection
# caps:   the target's declarations
# t:      the target, whose helpers the soft rewrites deliver
# plans:  the plan of each format, by its index
# start:  how many instructions the function had when the visit began, so
#         the ones it makes are never rewritten
# failed: the first failure
rec Work {
    site:   Site;
    basis:  opt[*Basis];
    caps:   *Capabilities;
    t:      *Target;
    plans:  *Plan;
    start:  usize;
    failed: opt[Why];
}

fun fail(w: *Work, why: Why) {
    val first: bool = sel w.failed.none;
    if (first) { w.failed = opt[Why].some{why}; }
}

fun type_of(w: *Work, x: Value) Type {
    ret w.site.b.values.data[x.index].type;
}

# the format a scalar type is of, none for any other type
fun format_of(w: *Work, ty: Type) opt[Format] {
    val s: res[types.Shape, types.Error] = types.shape(?w.site.m.types, ty);
    if (sel s.err)      { ret opt[Format].none{}; }
    if (sel s.ok.float) { ret opt[Format].some{s.ok.float.format}; }
    ret opt[Format].none{};
}

# the format a scalar type is of when the pass computes it elsewhere
fun expanded(w: *Work, ty: Type) opt[Format] {
    val f: opt[Format] = format_of(w, ty);
    if (sel f.none) { ret f; }
    val at: Format = f.some;
    val p:  Plan   = w.plans[at.index];
    if (sel p.basic.none && !p.soft) { ret opt[Format].none{}; }
    ret f;
}

# the row of a format the pass read from the table, which has one
fun row_of(f: Format) types.Row {
    val r: opt[types.Row] = types.row(f);
    if (sel r.some) { ret r.some; }
    var none: types.Row;
    ret none;
}

# the binary encoding of a format the pass read as one
fun bits_of(f: Format) types.Binary {
    val e: types.Encoding = row_of(f).encoding;
    if (sel e.binary) { ret e.binary; }
    var none: types.Binary;
    ret none;
}

fun integer(w: *Work, width: u32) Type {
    val ty: res[Type, types.Error] = types.intern(?w.site.m.types, types.Shape.integer{types.Integer{width: width}});
    if (sel ty.err) {
        fail(w, Why.ir{module.Error.types{ty.err}});
        ret Type{index: 0};
    }
    ret ty.ok;
}

fun float(w: *Work, f: Format) Type {
    val ty: res[Type, types.Error] = types.intern(?w.site.m.types, types.Shape.float{types.Float{format: f}});
    if (sel ty.err) {
        fail(w, Why.ir{module.Error.types{ty.err}});
        ret Type{index: 0};
    }
    ret ty.ok;
}

# the integer type of a format's encoding
fun encoding(w: *Work, f: Format) Type {
    ret integer(w, row_of(f).width);
}

fun constant(w: *Work, ty: Type, x: Wide) Value {
    val made: res[Value, Why] = emit.constant(?w.site, ty, x);
    if (sel made.err) {
        fail(w, made.err);
        ret Value{index: 0};
    }
    ret made.ok;
}

fun float_constant(w: *Work, ty: Type, x: Wide) Value {
    val made: res[Value, Why] = emit.float_constant(?w.site, ty, x);
    if (sel made.err) {
        fail(w, made.err);
        ret Value{index: 0};
    }
    ret made.ok;
}

fun small(n: u64) Wide {
    ret word.small(n);
}

fun pow2(n: u32) Wide {
    ret word.shl(word.small(1), n);
}

# the low n bits set
fun low(n: u32) Wide {
    ret word.sub(pow2(n), word.small(1));
}

# the encoding field of a biased exponent, which is never negative
fun exponent_field(b: types.Binary, e: i64) Wide {
    ret word.shl(word.small((e + b.bias::i64)::u64), b.significand);
}

# the encoding of the infinity of a format, every exponent bit set
fun infinity_of(b: types.Binary) Wide {
    ret word.shl(low(b.exponent), b.significand);
}

# the encoding of the canonical nan of a format: positive, quiet, no payload
fun canonical_of(b: types.Binary) Wide {
    ret word.bit_or(infinity_of(b), pow2(b.significand - 1));
}

fun op2(w: *Work, code: Opcode, a: Value, b: Value) Value {
    ret emit.binary(?w.site, code, a, b);
}

fun pick(w: *Work, c: Value, a: Value, b: Value) Value {
    ret emit.ternary(?w.site, opcode.SELECT, c, a, b);
}

fun cast(w: *Work, code: Opcode, x: Value, to: Type) Value {
    ret emit.convert(?w.site, code, x, to);
}

# how a nan a widening or a narrowing gives is made
# ---
# kept:      every bit kept, for a sign operation
# quiet:     quieted, its sign and payload kept
# canonical: the canonical nan
tag Nan: u8 {
    kept;
    quiet;
    canonical;
}

# the nan rule of a conversion, read from the held row of the other format
fun converted(w: *Work, other: Format) Nan {
    val h: res[opt[*Held], target_basis.Error] = target_basis.held(w.basis, w.caps, other);
    if (sel h.err) {
        fail(w, Why.condition{h.err});
        ret Nan.quiet{};
    }
    if (sel h.ok.some) {
        val rule: Nans = h.ok.some.nans;
        if (sel rule.canonical) { ret Nan.canonical{}; }
    }
    ret Nan.quiet{};
}

# the encoding of a narrow value widened exactly to a wide format, as a value
# of the wide format
fun widen(w: *Work, e: Value, from: Format, to: Format, nan: Nan) Value {
    val n:       types.Binary = bits_of(from);
    val x:       types.Binary = bits_of(to);
    val nw:      u32          = row_of(from).width;
    val xw:      u32          = row_of(to).width;
    val it:      Type         = encoding(w, to);
    val ft:      Type         = float(w, to);
    val gap:     u32          = x.significand - n.significand;
    val hz:      Value        = cast(w, opcode.EXT_U, e, it);
    val sign:    Value        = op2(w, opcode.SHL, op2(w, opcode.AND, hz, constant(w, it, pow2(nw - 1))), constant(w, it, small((xw - nw)::u64)));
    val mag:     Value        = op2(w, opcode.AND, hz, constant(w, it, low(nw - 1)));
    val ex:      Value        = op2(w, opcode.SHR_U, mag, constant(w, it, small(n.significand::u64)));
    val m:       Value        = op2(w, opcode.AND, hz, constant(w, it, low(n.significand)));
    val rebias:  Wide         = word.shl(word.small((x.bias - n.bias)::u64), x.significand);
    val normal:  Value        = op2(w, opcode.ADD, op2(w, opcode.SHL, mag, constant(w, it, small(gap::u64))), constant(w, it, rebias));
    val shifted: Value        = op2(w, opcode.SHL, m, constant(w, it, small(gap::u64)));
    val special: Value        = op2(w, opcode.OR, shifted, constant(w, it, infinity_of(x)));
    # a subnormal is its significand times the least subnormal, both exact
    val least:  Value = float_constant(w, ft, exponent_field(x, emin(n) - n.significand::i64));
    val scaled: Value = op2(w, opcode.FMUL, cast(w, opcode.ITOF_U, m, ft), least);
    val sub:    Value = cast(w, opcode.BITCAST, scaled, it);
    val zero:   Value = op2(w, opcode.EQ, ex, constant(w, it, word.zero()));
    val top:    Value = op2(w, opcode.EQ, ex, constant(w, it, low(n.exponent)));
    var r:      Value = op2(w, opcode.OR, pick(w, zero, sub, pick(w, top, special, normal)), sign);
    if (!(sel nan.kept)) {
        val isnan: Value = op2(w, opcode.AND, top, op2(w, opcode.NE, m, constant(w, it, word.zero())));
        if (sel nan.canonical) { r = pick(w, isnan, constant(w, it, canonical_of(x)), r); }
        or                     { r = pick(w, isnan, op2(w, opcode.OR, r, constant(w, it, pow2(x.significand - 1))), r); }
    }
    ret cast(w, opcode.BITCAST, r, ft);
}

# a value of a wide format narrowed to a narrow one, rounded once to nearest
# with ties to even, as the narrow encoding
fun narrow(w: *Work, v: Value, from: Format, to: Format, nan: Nan) Value {
    val x:    types.Binary = bits_of(from);
    val n:    types.Binary = bits_of(to);
    val xw:   u32          = row_of(from).width;
    val nw:   u32          = row_of(to).width;
    val it:   Type         = encoding(w, from);
    val nt:   Type         = encoding(w, to);
    val ft:   Type         = float(w, from);
    val k:    u32          = x.significand - n.significand;
    val xb:   Value        = cast(w, opcode.BITCAST, v, it);
    val a:    Value        = op2(w, opcode.AND, xb, constant(w, it, low(xw - 1)));
    val sign: Value        = op2(w, opcode.AND, cast(w, opcode.TRUNC, op2(w, opcode.SHR_U, xb, constant(w, it, small((xw - nw)::u64))), nt), constant(w, nt, pow2(nw - 1)));
    # the overflow threshold: the largest finite value and half its unit
    val over_at: Wide  = word.add(exponent_field(x, emax(n)), word.sub(pow2(x.significand), pow2(k - 1)));
    val isnan:   Value = op2(w, opcode.GT_U, a, constant(w, it, infinity_of(x)));
    val over:    Value = op2(w, opcode.GE_U, a, constant(w, it, over_at));
    val tiny:    Value = op2(w, opcode.LT_U, a, constant(w, it, exponent_field(x, emin(n))));
    # the normal range: rebiased, then rounded to nearest even at the narrow unit
    val r1:     Value = op2(w, opcode.SUB, a, constant(w, it, word.shl(word.small((x.bias - n.bias)::u64), x.significand)));
    val odd:    Value = op2(w, opcode.AND, op2(w, opcode.SHR_U, r1, constant(w, it, small(k::u64))), constant(w, it, small(1)));
    val r2:     Value = op2(w, opcode.ADD, op2(w, opcode.ADD, r1, constant(w, it, low(k - 1))), odd);
    val normal: Value = cast(w, opcode.TRUNC, op2(w, opcode.SHR_U, r2, constant(w, it, small(k::u64))), nt);
    # the subnormal range: added to the power of two whose unit is the narrow
    # least subnormal, which the wide addition rounds, and taken away again
    val magic:  Wide  = exponent_field(x, emin(n) - n.significand::i64 + x.significand::i64);
    val sum:    Value = op2(w, opcode.FADD, cast(w, opcode.BITCAST, a, ft), float_constant(w, ft, magic));
    val sub:    Value = cast(w, opcode.TRUNC, op2(w, opcode.SUB, cast(w, opcode.BITCAST, sum, it), constant(w, it, magic)), nt);
    val rest:   Value = pick(w, over, constant(w, nt, infinity_of(n)), pick(w, tiny, sub, normal));
    val signed: Value = op2(w, opcode.OR, rest, sign);
    var lost:   Value = constant(w, nt, canonical_of(n));
    if (!(sel nan.canonical)) {
        val payload: Value = op2(w, opcode.AND, cast(w, opcode.TRUNC, op2(w, opcode.SHR_U, a, constant(w, it, small(k::u64))), nt), constant(w, nt, low(n.significand)));
        var set:     Wide  = infinity_of(n);
        if (sel nan.quiet) { set = canonical_of(n); }
        lost = op2(w, opcode.OR, op2(w, opcode.OR, payload, constant(w, nt, set)), sign);
    }
    ret pick(w, isnan, lost, signed);
}

# the encoding of an operand of an expanded format: a constant's bits, or the
# reinterpretation of the value made ahead of the instruction reading it
fun encoded(w: *Work, x: Value, f: Format) Value {
    val nt:  Type                        = encoding(w, f);
    val got: res[opt[folder.Value], Why] = number.read(w.site.m, w.site.b, w.site.scratch, x);
    if (sel got.err) {
        fail(w, got.err);
        ret x;
    }
    if (sel got.ok.some) {
        if (got.ok.some.lanes.size == 1) { ret constant(w, nt, word.of(got.ok.some.lanes.data[0].words)); }
    }
    ret cast(w, opcode.BITCAST, x, nt);
}

# an operand of an expanded format widened to the format its operation
# computes in
fun widened(w: *Work, x: Value, f: Format, to: Format, nan: Nan) Value {
    ret widen(w, encoded(w, x, f), f, to, nan);
}

# what one instruction to rewrite is, copied before the body grows under it
# ---
# origin:   the instruction
# code:     its opcode
# operands: its operands
# count:    how many
# result:   its first result, valid where results is not zero
# results:  how many results it has
# flags:    its flags
# imm:      its immediates
# imms:     how many
rec Copied {
    origin:   Instruction;
    code:     Opcode;
    operands: [3]Value;
    count:    usize;
    result:   Value;
    results:  usize;
    flags:    Flags;
    imm:      [3]Immediate;
    imms:     usize;
}

fun copy_of(d: *InstructionData, i: Instruction) Copied {
    var c: Copied;
    c.origin = i;
    c.code   = d.opcode;
    c.count  = d.operands.len;
    if (c.count > 3) { c.count = 3; }
    var k: usize = 0;
    for (k < c.count) {
        c.operands[k] = d.operands.data[k];
        k             = k + 1;
    }
    c.result  = Value{index: 0};
    c.results = d.results.len;
    if (d.results.len > 0) { c.result = d.results.data[0]; }
    c.flags = d.metadata.flags;
    c.imms  = d.immediates.len;
    if (c.imms > 3) { c.imms = 3; }
    k = 0;
    for (k < c.imms) {
        c.imm[k] = d.immediates.data[k];
        k        = k + 1;
    }
    ret c;
}

# make an instruction of any operands and immediates, giving its first result
# where it has one
fun made(w: *Work, code: Opcode, ops: *Value, n: usize, imm: *Immediate, slots: usize) Value {
    val i: Instruction      = emit.make(?w.site, code, Slice[Value]{data: ops, size: n}, Slice[Immediate]{data: imm, size: slots});
    val d: *InstructionData = ?w.site.b.instructions.data[i.index];
    if (d.results.len == 0) { ret Value{index: 0}; }
    ret emit.result(?w.site, i, 0);
}

# the first failure, or ok
fun failure_of(w: *Work) err[Why] {
    val f: opt[Why] = w.failed;
    if (sel f.some) { ret err[Why].err{f.some}; }
    ret err[Why].ok{};
}

# what an instruction reading or giving an expanded format is rewritten as
# ---
# none:       it is left, at a boundary or where nothing computes it
# compute:    an arithmetic operation, in the format of the plan, its nan made so
# compare:    a comparison of the widened operands
# to_float:   a conversion from an integer, made in the basic format and narrowed
# to_integer: a conversion to an integer of the widened operand
# promote:    a conversion to another format, from the widened operand
# demote:     a conversion from another format, narrowed from its encoding
# recast:     a reinterpretation, of the encoding
# held:       a load, store, select or declassification, of the encoding
tag How: u8 {
    none;
    compute: Nan;
    compare;
    to_float;
    to_integer;
    promote;
    demote;
    recast;
    held;
}

# the format an instruction's operation reads or gives that is expanded, and
# how it is rewritten
rec Rewrite {
    how:    How;
    format: Format;
    fused:  bool;
}

fun leave() Rewrite {
    ret Rewrite{how: How.none{}, format: Format{index: 0}, fused: false};
}

fun classify(w: *Work, d: *InstructionData) Rewrite {
    var f:    Format = Format{index: 0};
    var have: bool   = false;
    var out:  bool   = false;
    var k:    usize  = 0;
    for (k < d.operands.len) {
        val g: opt[Format] = expanded(w, type_of(w, d.operands.data[k]));
        if (sel g.some) {
            if (!have) { f = g.some; }
            have = true;
        }
        k = k + 1;
    }
    k = 0;
    for (k < d.results.len) {
        val g: opt[Format] = expanded(w, type_of(w, d.results.data[k]));
        if (sel g.some) {
            if (!have) { f = g.some; }
            have = true;
            out  = true;
        }
        k = k + 1;
    }
    if (!have) { ret leave(); }
    val e:  folder.Entry = folder.entry(d.opcode);
    var rw: Rewrite      = Rewrite{how: How.none{}, format: f, fused: false};
    if (sel e.float_unary || sel e.float_binary) { rw.how = How.compute{Nan.quiet{}}; }
    if (sel e.float_ternary) {
        rw.how   = How.compute{Nan.quiet{}};
        rw.fused = true;
    }
    if (sel e.sign_unary || sel e.sign_binary) { rw.how = How.compute{Nan.kept{}}; }
    if (sel e.float_compare)                   { rw.how = How.compare{}; }
    if (sel e.to_float && out)                 { rw.how = How.to_float{}; }
    if (sel e.to_integer && !out)              { rw.how = How.to_integer{}; }
    if (sel e.reformat) {
        if (out) { rw.how = How.demote{}; }
        or       { rw.how = How.promote{}; }
    }
    if (sel e.bitcast)                                                               { rw.how = How.recast{}; }
    if (sel e.select || sel e.identity)                                              { rw.how = How.held{}; }
    if (d.opcode.index == opcode.LOAD.index || d.opcode.index == opcode.STORE.index) { rw.how = How.held{}; }
    ret rw;
}

# the format a plan computes an operation in
fun computes_in(w: *Work, rw: Rewrite) opt[Format] {
    val p: Plan = w.plans[rw.format.index];
    if (rw.fused) { ret p.fused; }
    ret p.basic;
}

# an operand of the copy read as its encoding where its type is expanded, and
# as it stands otherwise
fun held_operand(w: *Work, c: *Copied, k: usize) Value {
    val x: Value       = c.operands[k];
    val f: opt[Format] = expanded(w, type_of(w, x));
    if (sel f.none) { ret x; }
    ret encoded(w, x, f.some);
}

# an immediate type of the copy, its expanded format's encoding in its place
fun held_immediate(w: *Work, i: Immediate) Immediate {
    if (!(sel i.ty)) { ret i; }
    val f: opt[Format] = expanded(w, i.ty);
    if (sel f.none) { ret i; }
    ret Immediate.ty{encoding(w, f.some)};
}

# the end of a rewrite whose result is a value already made, which takes the
# instruction's uses before it goes
fun settle(w: *Work, i: Instruction, result: Value, by: Value) err[Why] {
    val done: err[Why] = emit.done(?w.site);
    if (sel done.err) { ret done; }
    val failed: err[Why] = failure_of(w);
    if (sel failed.err) { ret failed; }
    val moved: err[Why] = failure.edit(body.replace(w.site.m, w.site.f, result, by, Records.follow{}));
    if (sel moved.err) { ret moved; }
    ret failure.edit(body.erase(w.site.m, w.site.f, i));
}

# rewrite one instruction, which stands at an index of a block
fun rewrite(w: *Work, k: Block, n: u32, i: Instruction) err[Why] {
    val d:  *InstructionData = ?w.site.b.instructions.data[i.index];
    val rw: Rewrite          = classify(w, d);
    if (sel rw.how.none) { ret err[Why].ok{}; }
    var c: Copied = copy_of(d, i);
    if (soft_rewrites(w, d, rw)) { ret soft_rewrite(w, k, n, i, ?c, rw); }
    val f:  Format      = rw.format;
    val in: opt[Format] = computes_in(w, rw);
    if (sel in.none) { ret err[Why].ok{}; }
    val wide: Format = in.some;
    val ty:   Type   = float(w, f);
    # the other format of a conversion, which must be held
    var other: Format = Format{index: 0};
    if (sel rw.how.promote || sel rw.how.demote) {
        var at: Type = type_of(w, c.operands[0]);
        if (sel rw.how.promote) { at = type_of(w, c.result); }
        val g: opt[Format] = format_of(w, at);
        if (sel g.none) { ret err[Why].ok{}; }
        other = g.some;
        val twice: opt[Format] = expanded(w, at);
        if (sel twice.some) { ret err[Why].ok{}; }
    }
    emit.open(?w.site, i, k, n);
    if (sel rw.how.compute) {
        var ops: [3]Value;
        var j:   usize = 0;
        for (j < c.count) {
            ops[j] = widened(w, c.operands[j], f, wide, Nan.kept{});
            j      = j + 1;
        }
        val r: Value = made(w, c.code, ?ops[0], c.count, nil, 0);
        val e: Value = narrow(w, r, wide, f, rw.how.compute);
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, e, ty);
    }
    or (sel rw.how.compare) {
        val a: Value = widened(w, c.operands[0], f, wide, Nan.kept{});
        val b: Value = widened(w, c.operands[1], f, wide, Nan.kept{});
        emit.close(?w.site, i);
        op2(w, c.code, a, b);
    }
    or (sel rw.how.to_float) {
        val r: Value = cast(w, c.code, c.operands[0], float(w, wide));
        val e: Value = narrow(w, r, wide, f, Nan.quiet{});
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, e, ty);
    }
    or (sel rw.how.to_integer) {
        val a: Value = widened(w, c.operands[0], f, wide, Nan.kept{});
        emit.close(?w.site, i);
        cast(w, c.code, a, type_of(w, c.result));
    }
    or (sel rw.how.promote) {
        val to: Type  = type_of(w, c.result);
        val a:  Value = widened(w, c.operands[0], f, wide, converted(w, other));
        if (other.index == wide.index) { ret settle(w, i, c.result, a); }
        var code: Opcode = opcode.FPROMOTE;
        if (row_of(other).width < row_of(wide).width) { code = opcode.FDEMOTE; }
        emit.close(?w.site, i);
        cast(w, code, a, to);
    }
    or (sel rw.how.demote) {
        val e: Value = narrow(w, c.operands[0], other, f, converted(w, other));
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, e, ty);
    }
    or (sel rw.how.recast) {
        val nt:   Type        = encoding(w, f);
        val to:   Type        = type_of(w, c.result);
        val from: Type        = type_of(w, c.operands[0]);
        val src:  opt[Format] = expanded(w, from);
        if (sel src.some) {
            val e: Value = encoded(w, c.operands[0], f);
            if (types.same(to, nt)) { ret settle(w, i, c.result, e); }
            emit.close(?w.site, i);
            cast(w, opcode.BITCAST, e, to);
        }
        or {
            var e: Value = c.operands[0];
            if (!types.same(from, nt)) { e = cast(w, opcode.BITCAST, e, nt); }
            emit.close(?w.site, i);
            cast(w, opcode.BITCAST, e, ty);
        }
    }
    or {
        var ops: [3]Value;
        var j:   usize = 0;
        for (j < c.count) {
            ops[j] = held_operand(w, ?c, j);
            j      = j + 1;
        }
        var imm: [3]Immediate;
        j = 0;
        for (j < c.imms) {
            imm[j] = held_immediate(w, c.imm[j]);
            j      = j + 1;
        }
        var gives: bool = false;
        if (c.results > 0) {
            val g: opt[Format] = expanded(w, type_of(w, c.result));
            gives = sel g.some;
        }
        if (gives) {
            emit.flags(?w.site, c.flags);
            val r: Value = made(w, c.code, ?ops[0], c.count, ?imm[0], c.imms);
            emit.flags(?w.site, NO_FLAGS);
            emit.close(?w.site, i);
            cast(w, opcode.BITCAST, r, ty);
        }
        or {
            emit.close(?w.site, i);
            emit.flags(?w.site, c.flags);
            made(w, c.code, ?ops[0], c.count, ?imm[0], c.imms);
        }
    }
    val built: err[Why] = emit.done(?w.site);
    if (sel built.err) { ret built; }
    ret failure_of(w);
}

# hold every parameter of an expanded format of a block other than the entry
# as its encoding: a parameter of the encoding is added, every edge into the
# block passing its argument's encoding, made ahead of the edge's branch, and
# the old parameter's readers read the encoding reinterpreted, made at the
# block's start, before the old parameter goes
fun parameters(w: *Work, k: Block) err[Why] {
    val b: *Body = w.site.b;
    var p: usize = 0;
    for (p < b.blocks.data[k.index].parameters.len) {
        val old: Value       = b.blocks.data[k.index].parameters.data[p];
        val f:   opt[Format] = expanded(w, type_of(w, old));
        if (sel f.none) { p = p + 1; }
        or {
            val nt:    Type                         = encoding(w, f.some);
            val zero:  Value                        = constant(w, nt, word.zero());
            val preds: usize                        = b.blocks.data[k.index].predecessors.len;
            val room:  res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, preds + 1);
            if (sel room.err) { ret err[Why].err{Why.alloc{room.err}}; }
            var e: usize = 0;
            for (e < preds) {
                room.ok[e] = zero;
                e          = e + 1;
            }
            val unmade: err[Why] = failure_of(w);
            if (sel unmade.err) { ret unmade; }
            val secret: bool                     = b.values.data[old.index].secret;
            val added:  res[Value, module.Error] = body.add_parameter(w.site.m, w.site.f, k, Declaration{type: nt, secret: secret, name: opt[View].none{}}, Slice[Value]{data: room.ok, size: preds});
            if (sel added.err) { ret err[Why].err{Why.ir{added.err}}; }
            val at:     usize    = b.blocks.data[k.index].parameters.len - 1;
            val passed: err[Why] = pass_encodings(w, k, p, at, f.some);
            if (sel passed.err) { ret passed; }
            val first: Instruction = b.blocks.data[k.index].instructions.data[0];
            emit.open(?w.site, first, k, 0);
            val back: Value    = cast(w, opcode.BITCAST, added.ok, type_of(w, old));
            val made: err[Why] = emit.done(?w.site);
            if (sel made.err) { ret made; }
            val failed: err[Why] = failure_of(w);
            if (sel failed.err) { ret failed; }
            val moved: err[Why] = failure.edit(body.replace(w.site.m, w.site.f, old, back, Records.follow{}));
            if (sel moved.err) { ret moved; }
            val gone: err[Why] = failure.edit(body.remove_parameter(w.site.m, w.site.f, k, p::u32));
            if (sel gone.err) { ret gone; }
        }
    }
    ret err[Why].ok{};
}

# make every edge into a block pass, for its parameter at `to`, the encoding
# of the argument it passes for the one at `from`, made ahead of its branch
fun pass_encodings(w: *Work, k: Block, from: usize, to: usize, f: Format) err[Why] {
    val b: *Body = w.site.b;
    var j: usize = 0;
    for (j < b.blocks.len) {
        if (!b.blocks.data[j].erased && b.blocks.data[j].instructions.len != 0) {
            val end:  u32         = (b.blocks.data[j].instructions.len - 1)::u32;
            val last: Instruction = b.blocks.data[j].instructions.data[end];
            var e:    usize       = 0;
            for (e < b.instructions.data[last.index].edges.len) {
                if (b.instructions.data[last.index].edges.data[e].block.index == k.index) {
                    val count: usize                        = b.instructions.data[last.index].edges.data[e].arguments.len;
                    val args:  res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, count);
                    if (sel args.err) { ret err[Why].err{Why.alloc{args.err}}; }
                    var a: usize = 0;
                    for (a < count) {
                        args.ok[a] = b.instructions.data[last.index].edges.data[e].arguments.data[a];
                        a          = a + 1;
                    }
                    emit.open(?w.site, last, Block{index: j::u32}, end);
                    args.ok[to] = encoded(w, args.ok[from], f);
                    val done: err[Why] = emit.done(?w.site);
                    if (sel done.err) { ret done; }
                    val failed: err[Why] = failure_of(w);
                    if (sel failed.err) { ret failed; }
                    val now:   Instruction = b.blocks.data[j].instructions.data[b.blocks.data[j].instructions.len - 1];
                    val moved: err[Why]    = failure.edit(body.retarget(w.site.m, w.site.f, now, e::u32, k, Slice[Value]{data: args.ok, size: count}));
                    if (sel moved.err) { ret moved; }
                }
                e = e + 1;
            }
        }
        j = j + 1;
    }
    ret err[Why].ok{};
}

# whether an instruction is a reinterpretation between an expanded format and
# its encoding, from the format when `from` is set and to it otherwise
fun recasts(w: *Work, i: Instruction, from: bool) bool {
    val d: *InstructionData = ?w.site.b.instructions.data[i.index];
    if (d.opcode.index != opcode.BITCAST.index || !(sel d.place.placed)) { ret false; }
    val a: Type        = type_of(w, d.operands.data[0]);
    val r: Type        = type_of(w, d.results.data[0]);
    var f: opt[Format] = expanded(w, r);
    var e: Type        = a;
    if (from) {
        f = expanded(w, a);
        e = r;
    }
    if (sel f.none) { ret false; }
    ret types.same(e, encoding(w, f.some));
}

# take out each pair of reinterpretations the rewrite left, an encoding read
# back from the format it was made into, and then every reinterpretation into
# the format nothing reads
fun tidy(w: *Work) err[Why] {
    val b: *Body = w.site.b;
    var i: usize = 0;
    for (i < b.instructions.len) {
        val at: Instruction = Instruction{index: i::u32};
        if (recasts(w, at, true)) {
            val x:   Value = b.instructions.data[i].operands.data[0];
            val def: Def   = b.values.data[x.index].def;
            if (sel def.result) {
                if (recasts(w, def.result.instruction, false)) {
                    val inner: Value    = b.instructions.data[def.result.instruction.index].operands.data[0];
                    val r:     Value    = b.instructions.data[i].results.data[0];
                    val moved: err[Why] = failure.edit(body.replace(w.site.m, w.site.f, r, inner, Records.follow{}));
                    if (sel moved.err) { ret moved; }
                    val gone: err[Why] = failure.edit(body.erase(w.site.m, w.site.f, at));
                    if (sel gone.err) { ret gone; }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        val at: Instruction = Instruction{index: i::u32};
        if (recasts(w, at, false) && b.values.data[b.instructions.data[i].results.data[0].index].uses.len == 0) {
            val gone: err[Why] = failure.edit(body.erase(w.site.m, w.site.f, at));
            if (sel gone.err) { ret gone; }
        }
        i = i + 1;
    }
    ret err[Why].ok{};
}

# compute every value of an expanded format of one function in its plan
fun visit(u: *Unit) res[bool, Why] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }

    val rows:  usize                       = types.rows()::usize;
    val plans: res[*Plan, allocator.Error] = allocator.zallocate[Plan](c.m.a, rows);
    if (sel plans.err) { ret res[bool, Why].err{Why.alloc{plans.err}}; }
    fin { allocator.deallocate[Plan](c.m.a, plans.ok, rows); }
    var any: bool  = false;
    var r:   usize = 0;
    for (r < rows) {
        val p: res[Plan, Why] = plan_of(c.basis, ?c.t.caps, Format{index: r::u32});
        if (sel p.err) { ret res[bool, Why].err{p.err}; }
        plans.ok[r] = p.ok;
        if (sel p.ok.basic.some || p.ok.soft) { any = true; }
        r = r + 1;
    }
    if (!any) { ret res[bool, Why].ok{false}; }

    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, Why].err{Why.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    var w: Work  = Work{site: emit.init(c.m, u.f, got.ok, ?scratch), basis: c.basis, caps: ?c.t.caps, t: c.t, plans: plans.ok, start: got.ok.instructions.len, failed: opt[Why].none{}};
    var b: *Body = got.ok;

    # whether anything is of an expanded format
    var found: bool  = false;
    var v:     usize = 0;
    for (v < b.values.len && !found) {
        val f: opt[Format] = expanded(?w, b.values.data[v].type);
        if (!(sel b.values.data[v].def.removed) && sel f.some) { found = true; }
        v = v + 1;
    }
    if (!found) { ret res[bool, Why].ok{false}; }

    # the helpers go into the module before the body is read again, since
    # reading one in may move every body
    val delivered: err[Why] = deliver_all(?w, ?ar);
    if (sel delivered.err) { ret res[bool, Why].err{delivered.err}; }
    val again: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel again.err) { ret res[bool, Why].err{Why.ir{again.err}}; }
    b      = again.ok;
    w.site = emit.init(c.m, u.f, b, ?scratch);

    var k: usize = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && b.blocks.data[k].instructions.len != 0) {
            arena.reset(?ar);
            val held: err[Why] = parameters(?w, Block{index: k::u32});
            if (sel held.err) { ret res[bool, Why].err{held.err}; }
        }
        k = k + 1;
    }
    k = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                arena.reset(?ar);
                val i: Instruction = b.blocks.data[k].instructions.data[n];
                if (i.index::usize < w.start) {
                    val before: usize    = b.blocks.data[k].instructions.len;
                    val done:   err[Why] = rewrite(?w, Block{index: k::u32}, n::u32, i);
                    if (sel done.err) { ret res[bool, Why].err{done.err}; }
                    n = n + 1 + b.blocks.data[k].instructions.len - before;
                }
                or { n = n + 1; }
            }
        }
        k = k + 1;
    }
    val tidied: err[Why] = tidy(?w);
    if (sel tidied.err) { ret res[bool, Why].err{tidied.err}; }
    ret res[bool, Why].ok{true};
}

# whether a format is computed by helpers alone: the build holds none that
# computes it wider
fun soft_only(w: *Work, f: Format) bool {
    val p: Plan = w.plans[f.index];
    ret p.soft && sel p.basic.none;
}

# the formats a reinterpreting conversion reads and gives
fun reformats(w: *Work, d: *InstructionData, from: *Format, to: *Format) bool {
    val a: opt[Format] = format_of(w, type_of(w, d.operands.data[0]));
    val r: opt[Format] = format_of(w, type_of(w, d.results.data[0]));
    if (sel a.none) { ret false; }
    if (sel r.none) { ret false; }
    @from = a.some;
    @to   = r.some;
    ret true;
}

# whether an instruction is rewritten as a helper call on encodings: an
# operation whose format no held one computes, or a conversion between formats
# one of which only the helpers compute, or both of which the pass computes
fun soft_rewrites(w: *Work, d: *InstructionData, rw: Rewrite) bool {
    if (sel rw.how.none || sel rw.how.recast || sel rw.how.held) { ret false; }
    if (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = Format{index: 0};
        var to:   Format = Format{index: 0};
        if (!reformats(w, d, ?from, ?to)) { ret false; }
        if (soft_only(w, from) || soft_only(w, to)) { ret true; }
        val a: opt[Format] = expanded(w, float(w, from));
        val b: opt[Format] = expanded(w, float(w, to));
        ret sel a.some && sel b.some;
    }
    val p: Plan = w.plans[rw.format.index];
    if (!p.soft) { ret false; }
    val in: opt[Format] = computes_in(w, rw);
    ret sel in.none;
}

# the helper a soft rewrite calls, none for a sign operation, which is integer
# code on the encoding, or an operation no soft row computes
fun soft_want(w: *Work, d: *InstructionData, rw: Rewrite) opt[Want] {
    val none: opt[Want]   = opt[Want].none{};
    val f:    Format      = rw.format;
    val bits: u32         = row_of(f).width;
    val e:    folder.Entry = folder.entry(d.opcode);
    var want: Want         = Want{operation: Operation.unstated{}, bits: bits, format: opt[Format].some{f}, space: 0, source: opt[Format].none{}};
    if (sel e.sign_unary || sel e.sign_binary) { ret none; }
    if (sel rw.how.compute) {
        val r: opt[*table.Row] = table.computing(d.opcode);
        if (sel r.none) { ret none; }
        want.operation = r.some.operation;
        ret opt[Want].some{want};
    }
    if (sel rw.how.compare) {
        want.operation = Operation.soft_compare{};
        ret opt[Want].some{want};
    }
    if (sel rw.how.to_float) {
        val k: res[u32, types.Error] = types.width(?w.site.m.types, type_of(w, d.operands.data[0]));
        if (sel k.err) { ret none; }
        want.bits      = k.ok;
        want.operation = Operation.soft_from_u{};
        if (sel e.to_float) {
            if (e.to_float) { want.operation = Operation.soft_from_s{}; }
        }
        ret opt[Want].some{want};
    }
    if (sel rw.how.to_integer) {
        val k: res[u32, types.Error] = types.width(?w.site.m.types, type_of(w, d.results.data[0]));
        if (sel k.err) { ret none; }
        want.bits      = k.ok;
        want.operation = Operation.soft_to_u{};
        if (sel e.to_integer) {
            if (e.to_integer) { want.operation = Operation.soft_to_s{}; }
        }
        ret opt[Want].some{want};
    }
    if (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = Format{index: 0};
        var to:   Format = Format{index: 0};
        if (!reformats(w, d, ?from, ?to)) { ret none; }
        want.operation = Operation.soft_convert{};
        want.bits      = row_of(to).width;
        want.format    = opt[Format].some{to};
        want.source    = opt[Format].some{from};
        ret opt[Want].some{want};
    }
    ret none;
}

# deliver every helper the function's soft rewrites call, before any is made,
# so reading a helper in moves no body the rewrite holds
fun deliver_all(w: *Work, ar: *arena.Arena) err[Why] {
    val b: *Body = w.site.b;
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                arena.reset(ar);
                val d:  *InstructionData = ?b.instructions.data[b.blocks.data[k].instructions.data[n].index];
                val rw: Rewrite          = classify(w, d);
                if (soft_rewrites(w, d, rw)) {
                    val want: opt[Want] = soft_want(w, d, rw);
                    if (sel want.some) {
                        val got: res[Function, Why] = deliver.deliver(w.site.m, w.t, w.site.scratch, want.some);
                        if (sel got.err) { ret err[Why].err{got.err}; }
                    }
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret failure_of(w);
}

# a call of the helper a want asks for, delivered already, giving its result
fun helper_call(w: *Work, want: Want, args: *Value, count: usize) Value {
    val sig: res[Type, Why] = deliver.signature(w.site.m, want);
    if (sel sig.err) {
        fail(w, sig.err);
        ret Value{index: 0};
    }
    val got: res[Function, Why] = deliver.deliver(w.site.m, w.t, w.site.scratch, want);
    if (sel got.err) {
        fail(w, got.err);
        ret Value{index: 0};
    }
    val ptr: res[Type, types.Error] = types.intern(?w.site.m.types, types.Shape.pointer{types.Pointer{space: 0}});
    if (sel ptr.err) {
        fail(w, Why.ir{module.Error.types{ptr.err}});
        ret Value{index: 0};
    }
    val callee: Constant = build.constant(?w.site.bld, ConstantData.address{Address{type: ptr.ok, symbol: Symbol.function{got.ok}, offset: 0}});
    var ops:    [4]Value = [4]Value{build.use_constant(?w.site.bld, callee), Value{index: 0}, Value{index: 0}, Value{index: 0}};
    var j:      usize    = 0;
    for (j < count && j < 3) {
        ops[j + 1] = args[j];
        j          = j + 1;
    }
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{sig.ok}, Immediate.named{Named.all{}}};
    ret made(w, opcode.CALL, ?ops[0], j + 1, ?imm[0], 2);
}

# rewrite an instruction as a helper call on the encodings of its operands, or
# a sign operation as integer code on them, its result reinterpreted as its
# format where it is a float
fun soft_rewrite(w: *Work, k: Block, n: u32, i: Instruction, c: *Copied, rw: Rewrite) err[Why] {
    val d:    *InstructionData = ?w.site.b.instructions.data[i.index];
    val e:    folder.Entry     = folder.entry(c.code);
    val want: opt[Want]        = soft_want(w, d, rw);
    val f:    Format           = rw.format;
    val nt:   Type             = encoding(w, f);
    val sign: Wide             = pow2(row_of(f).width - 1);
    if (sel e.sign_unary || sel e.sign_binary) {
        emit.open(?w.site, i, k, n);
        val a: Value = encoded(w, c.operands[0], f);
        var r: Value = a;
        if (c.code.index == opcode.FNEG.index) { r = op2(w, opcode.XOR, a, constant(w, nt, sign)); }
        or (c.code.index == opcode.FABS.index) { r = op2(w, opcode.AND, a, constant(w, nt, word.sub(sign, small(1)))); }
        or {
            val m: Value = op2(w, opcode.AND, a, constant(w, nt, word.sub(sign, small(1))));
            val s: Value = op2(w, opcode.AND, encoded(w, c.operands[1], f), constant(w, nt, sign));
            r = op2(w, opcode.OR, m, s);
        }
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, r, float(w, f));
        val built: err[Why] = emit.done(?w.site);
        if (sel built.err) { ret built; }
        ret failure_of(w);
    }
    if (sel want.none) { ret err[Why].ok{}; }
    val wanted: Want = want.some;
    var args:   [3]Value;
    emit.open(?w.site, i, k, n);
    if (sel rw.how.to_float) {
        args[0] = c.operands[0];
        val r: Value = helper_call(w, wanted, ?args[0], 1);
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, r, float(w, f));
    }
    or (sel rw.how.to_integer) {
        args[0] = encoded(w, c.operands[0], f);
        emit.close(?w.site, i);
        helper_call(w, wanted, ?args[0], 1);
    }
    or (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = Format{index: 0};
        var to:   Format = Format{index: 0};
        if (!reformats(w, d, ?from, ?to)) { ret err[Why].ok{}; }
        args[0] = encoded(w, c.operands[0], from);
        val r: Value = helper_call(w, wanted, ?args[0], 1);
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, r, type_of(w, c.result));
    }
    or (sel rw.how.compare) {
        args[0] = encoded(w, c.operands[0], f);
        args[1] = encoded(w, c.operands[1], f);
        val mask: Value = helper_call(w, wanted, ?args[0], 2);
        var bits: u64   = 0;
        if (sel e.float_compare) {
            if (e.float_compare.less)    { bits = bits | 1; }
            if (e.float_compare.equal)   { bits = bits | 2; }
            if (e.float_compare.greater) { bits = bits | 4; }
        }
        val shape: opt[opcode.Row] = opcode.row(c.code);
        if (sel shape.some) {
            if (sel shape.some.order.unordered) { bits = bits | 8; }
        }
        val i32t: Type  = integer(w, 32);
        val held: Value = op2(w, opcode.AND, mask, constant(w, i32t, small(bits)));
        emit.close(?w.site, i);
        op2(w, opcode.NE, held, constant(w, i32t, word.zero()));
    }
    or {
        var j: usize = 0;
        for (j < c.count) {
            args[j] = encoded(w, c.operands[j], f);
            j       = j + 1;
        }
        val r: Value = helper_call(w, wanted, ?args[0], c.count);
        emit.close(?w.site, i);
        cast(w, opcode.BITCAST, r, float(w, f));
    }
    val built: err[Why] = emit.done(?w.site);
    if (sel built.err) { ret built; }
    ret failure_of(w);
}
