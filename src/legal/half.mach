# formats the build holds no unit for, computed in a wider one it holds, or on
# their encodings by helpers where none it holds admits them
#
# a value of a format the target computes in under no condition the build
# meets, binary16 on every register target among them, is held as the integer
# of its width that is its encoding, and every operation on it widens each
# operand exactly to a wider format the build holds, computes there once and
# narrows the result once, rounding to nearest with ties to even. the wide
# format is read from the number format table and the target's held rows,
# never a format's name, as the narrowest held one the rule of the operation
# admits:
#
# - add, subtract, multiply, divide, square root, remainder, the minimum and
#   maximum and the integral roundings compute in a format whose precision is
#   at least twice the narrow one's plus two, and whose exponent range holds
#   every narrow value as a normal number. the one rounding of the wide result
#   then gives the correctly rounded narrow result (figueroa, "when is double
#   rounding innocuous", 1995), and a remainder, a minimum, a maximum and an
#   integral rounding are exact there. binary32 has 24 bits against binary16's
#   11, twice 11 plus 2.
# - a fused multiply-add computes in a format whose precision is at least four
#   times the narrow one's plus two, and whose exponent range holds the exact
#   product: the product of two narrow values is exact at twice the narrow
#   precision, and its sum with the addend then rounds innocuously before the
#   narrowing, as the sum of two values of that doubled precision does. for
#   binary16 that is binary64.
# - a comparison compares the widened values, which is exact, as are the sign
#   operations, which keep every bit through the widening and the narrowing.
# - a conversion to an integer converts the widened value, which is the same
#   value. a conversion from an integer converts to the wide format and narrows:
#   an integer the wide precision does not hold is past the narrow format's
#   overflow threshold, so it narrows to the same infinity either way.
# - a conversion to another format widens, then converts from the wide format
#   natively, which is exact. a conversion from another format narrows from its
#   own encoding, one rounding.
#
# widening and narrowing are integer code on the encodings, with no
# conversion instruction, since no target the pass serves holds one: sign,
# exponent and significand are taken apart and put together, a narrow
# subnormal widened as the exact product of its significand and the least
# subnormal's power of two, the wide format's subnormals narrowed by adding the
# power of two whose unit is the narrow least subnormal and taking it away
# again, which the wide addition rounds to nearest even, and the normal range
# rounded to nearest even on the integer, its carry moving into the exponent.
# a value at or past the narrow overflow threshold narrows to the infinity of
# its sign. a nan operand widens keeping its sign, payload and signalling bit,
# so the wide unit chooses and quiets it as the target would, and a nan
# narrows as the target's row of the lowered format states, see
# `mirl.target.capability.Lowered`: kept, its sign and the top of its payload
# quieted, so the wide format's rule carries through, or the canonical nan. a
# nan a conversion gives follows the nan rule of the other format's held row:
# the canonical nan where the row states it, and the nan quieted otherwise,
# and a narrowing that makes every nan the canonical one makes that one too.
#
# the value is kept as the format at the function's boundaries, its entry, a
# call's arguments and results and a return, where the convention's half
# precision rule places it, each read and made by a reinterpretation of its
# encoding, a constant there too. every other value of the format becomes its encoding: a load or
# store accesses the integer, a select chooses it and a block parameter holds
# it. where the target's row of the format keeps it as its encoding, as
# spir-v's binary16 without Float16, whose OpTypeFloat 16 is no value there,
# the boundaries and the stack slots hold the encoding too: the function's
# signature, its parameters, a call's arguments, results and signature, a
# returned value, a slot and a constant left there are retyped as the
# encoding, so the format is left only in memory. a vector of the format a
# unit holds whole is computed the same way at its width, lane for lane: its
# widening, operation and narrowing are vector operations, each of which the
# unit must compute over packed lanes, its constants are the vectors of their
# lanes' encodings, and its splats, builds, shuffles, extracts and inserts
# move encodings. a vector no unit holds is left, and none reaches a register
# target, whose vector legalisation takes it lane by lane first.
#
# an operation no held format admits, on a soft float build every operation of
# binary32 and binary64, is a call of a soft helper of mirl.legal.helper.table
# on the encodings of its operands, delivered into the module before the
# function is rewritten: an arithmetic operation, a minimum or maximum, an
# integral rounding and a remainder of its format, a comparison as the mask
# the helper gives tested against the relation and order of the opcode's row,
# a conversion to or from an integer of its width, and a conversion between
# two formats where either is computed by helpers alone or both are computed
# elsewhere. a sign operation is integer code on the encoding. every nan a
# helper gives follows the rule the target's row of the format states for its
# helpers, which the delivery fills in.
#
# nothing made branches or reads memory, a select is a mask, and every helper
# runs in a time that depends on no value it is given, so the pass keeps
# constant time, and every value made reads as the instruction it stands in
# for, its secrecy included.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use core_state: masc.core.state;
use mirl.build.builder;
use mirl.fold.record;
use fold_table: mirl.fold.table;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.contents;
use mirl.ir.function;
use mirl.ir.function.Body;
use mirl.ir.function.in_constant_time;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.place.Named;
use type_format: mirl.ir.type.format;
use mirl.ir.type.format.Format;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.legal.helper.deliver;
use mirl.legal.helper.deliver.Want;
use mirl.legal.helper.table;
use mirl.legal.helper.table.Operation;
use mirl.opt.number;
use mirl.pass.analysis;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use target_basis: mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Held;
use mirl.target.capability.Kept;
use mirl.target.capability.LaneType;
use mirl.target.capability.Lowered;
use mirl.target.capability.Nans;
use mirl.target.capability.Narrowing;
use mirl.target.record.Target;
use units: mirl.target.vector;

# the pass: it adds instructions and block parameters and never touches an
# edge's target or a block
pub val HALF: Pass = Pass{name: "half precision", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

# how a format the build holds no unit for is computed
# ---
# basic:     the format it computes in, none where no held format admits it
# fused:     the format its fused multiply-add computes in, none where none admits it
# soft:      an operation no held format computes is a helper call on its encoding
# narrowing: what the narrowing back to it does to a nan, as the target's
#            row of the lowered format states it, unstated where it states none
# kept:      where a value of it no operation computes is kept, as the row
#            states it, the format where it states none
rec Plan {
    basic:     opt[Format];
    fused:     opt[Format];
    soft:      bool;
    narrowing: Narrowing;
    kept:      Kept;
}

# the plan of a format: none of either for one the build holds or that is no
# binary encoding rounding to nearest even
fun plan_of(b: opt[*Basis], c: *Capabilities, f: Format) res[Plan, refusal.Error] {
    val none:     Plan                                = Plan{basic: opt[Format].none{}, fused: opt[Format].none{}, soft: false, narrowing: Narrowing.unstated{}, kept: Kept.format{}};
    val res_held: res[opt[*Held], target_basis.Error] = target_basis.held(b, c, f);
    if (sel res_held.err)     { ret res[Plan, refusal.Error].err{refusal.Error.condition{res_held.err}}; }
    if (sel res_held.ok.some) { ret res[Plan, refusal.Error].ok{none}; }
    val opt_binary: opt[type_format.Binary] = target_basis.binary(f);
    if (sel opt_binary.none) { ret res[Plan, refusal.Error].ok{none}; }
    val res_basic: res[opt[Format], target_basis.Error] = target_basis.through(b, c, f, false);
    if (sel res_basic.err) { ret res[Plan, refusal.Error].err{refusal.Error.condition{res_basic.err}}; }
    val res_fused: res[opt[Format], target_basis.Error] = target_basis.through(b, c, f, true);
    if (sel res_fused.err) { ret res[Plan, refusal.Error].err{refusal.Error.condition{res_fused.err}}; }
    var narrowing:   Narrowing     = Narrowing.unstated{};
    var kept:        Kept          = Kept.format{};
    val opt_lowered: opt[*Lowered] = capability.lowered(c, f);
    if (sel opt_lowered.some) {
        narrowing = opt_lowered.some.widened;
        kept      = opt_lowered.some.kept;
    }
    ret res[Plan, refusal.Error].ok{Plan{basic: res_basic.ok, fused: res_fused.ok, soft: true, narrowing: narrowing, kept: kept}};
}

# whether some format the build holds no unit for is computed in one it holds
fun wanted(g: *Ground) bool {
    var i: u32 = 0;
    for (i < type_format.rows()) {
        val res_plan_of: res[Plan, refusal.Error] = plan_of(g.basis, ?g.t.caps, i);
        if (sel res_plan_of.err)                                  { ret true; }
        if (sel res_plan_of.ok.basic.some || res_plan_of.ok.soft) { ret true; }
        i = i + 1;
    }
    ret false;
}

# one visit
# ---
# site:   the function being rewritten
# basis:  the selection the function stands on
# build:  the build's selection, which the helpers it delivers stand on
# ctx:    the context the selection opened, which the vector units are read under
# caps:   the target's declarations
# t:      the target, whose helpers the soft rewrites deliver
# plans:  the plan of each format, by its index
# start:  how many instructions the function had when the visit began, so
#         the ones it makes are never rewritten
# failed: the first failure
rec Work {
    site:   Site;
    basis:  opt[*Basis];
    build:  opt[*Basis];
    ctx:    opt[*core_state.Context];
    caps:   *Capabilities;
    t:      *Target;
    plans:  *Plan;
    start:  usize;
    failed: opt[refusal.Error];
}

# whether the function being rewritten requires constant time, so the helpers it calls are local
fun timed(w: *Work) bool {
    ret in_constant_time(w.site.m.functions.data[w.site.f].data.constant_time);
}

fun fail(w: *Work, why: refusal.Error) {
    val first: bool = sel w.failed.none;
    if (first) { w.failed = opt[refusal.Error].some{why}; }
}

fun type_of(w: *Work, x: Value) Type {
    ret w.site.b.values.data[x].type;
}

# the format a scalar type is of, or a vector's lanes, none for any other type
fun format_of(w: *Work, ty: Type) opt[Format] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?w.site.m.types, ty);
    if (sel res_shape_at.err)       { ret opt[Format].none{}; }
    if (sel res_shape_at.ok.float)  { ret opt[Format].some{res_shape_at.ok.float.format}; }
    if (sel res_shape_at.ok.vector) { ret format_of(w, res_shape_at.ok.vector.element); }
    ret opt[Format].none{};
}

# the lanes of a vector type, zero for any other type
fun lanes_of(w: *Work, ty: Type) u32 {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?w.site.m.types, ty);
    if (sel res_shape_at.err)       { ret 0; }
    if (sel res_shape_at.ok.vector) { ret res_shape_at.ok.vector.lanes; }
    ret 0;
}

# the format a scalar or vector type is of when the pass computes it
# elsewhere. a vector is computed in a wider format's lanes alone, never by
# helpers, and only where a unit holds it whole, any other being left as no
# vector the target has
fun expanded(w: *Work, ty: Type) opt[Format] {
    val opt_format_of: opt[Format] = format_of(w, ty);
    if (sel opt_format_of.none) { ret opt_format_of; }
    val at:    Format = opt_format_of.some;
    val p:     Plan   = w.plans[at];
    val lanes: u32    = lanes_of(w, ty);
    if (lanes == 0) {
        if (sel p.basic.none && !p.soft) { ret opt[Format].none{}; }
        ret opt_format_of;
    }
    if (sel p.basic.none || !held_whole(w, ty, lanes)) { ret opt[Format].none{}; }
    ret opt_format_of;
}

# whether a unit of the build holds a vector type whole
fun held_whole(w: *Work, ty: Type, lanes: u32) bool {
    var f:        Format        = 0;
    val opt_lane: opt[LaneType] = lane_type(w, ty, ?f);
    if (sel opt_lane.none) { ret false; }
    val res_split: res[units.Split, units.Error] = units.split_for(w.basis, w.site.m.functions.data[w.site.f].data.constant_time, w.caps, opt_lane.some, lanes);
    if (sel res_split.err) { ret false; }
    val split: units.Split = res_split.ok;
    if (!(sel split.pieces)) { ret false; }
    ret split.pieces.lanes == lanes;
}

# the row of a format the pass read from the table, which has one
fun row_of(f: Format) type_format.Row {
    val opt_row: opt[type_format.Row] = type_format.row(f);
    if (sel opt_row.some) { ret opt_row.some; }
    var none: type_format.Row;
    ret none;
}

# the binary encoding of a format the pass read as one
fun bits_of(f: Format) type_format.Binary {
    val e: type_format.Encoding = row_of(f).encoding;
    if (sel e.binary) { ret e.binary; }
    var none: type_format.Binary;
    ret none;
}

fun integer(w: *Work, width: u32) Type {
    val res_intern: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.integer{type_table.Integer{width: width}});
    if (sel res_intern.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_intern.err}});
        ret 0;
    }
    ret res_intern.ok;
}

fun float(w: *Work, f: Format) Type {
    val res_intern: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.float{type_table.Float{format: f}});
    if (sel res_intern.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_intern.err}});
        ret 0;
    }
    ret res_intern.ok;
}

# the integer type of a format's encoding
fun encoding(w: *Work, f: Format) Type {
    ret integer(w, row_of(f).width);
}

# a scalar type, or the vector of as many lanes of it where lanes is not zero
fun shaped(w: *Work, scalar: Type, lanes: u32) Type {
    if (lanes == 0) { ret scalar; }
    val res_intern: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.vector{type_table.Vector{lanes: lanes, element: scalar}});
    if (sel res_intern.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_intern.err}});
        ret 0;
    }
    ret res_intern.ok;
}

# the type of the encoding of a scalar or vector type of a format
fun encoding_of(w: *Work, ty: Type, f: Format) Type {
    ret shaped(w, encoding(w, f), lanes_of(w, ty));
}

val UNPACKED: str = "an operation on a vector of a format the build computes in a wider one that no vector unit of the build computes over packed lanes";

# the lane type of the target's declarations a scalar or vector type's lanes
# are, a float's format written to `format`, which must outlive the answer
fun lane_type(w: *Work, ty: Type, format: *Format) opt[LaneType] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(?w.site.m.types, ty);
    if (sel res_shape_at.err)        { ret opt[LaneType].none{}; }
    if (sel res_shape_at.ok.vector)  { ret lane_type(w, res_shape_at.ok.vector.element, format); }
    if (sel res_shape_at.ok.integer) { ret opt[LaneType].some{LaneType.integer{res_shape_at.ok.integer.width}}; }
    if (sel res_shape_at.ok.float) {
        @format = res_shape_at.ok.float.format;
        ret opt[LaneType].some{LaneType.float{format}};
    }
    ret opt[LaneType].none{};
}

# hold an operation made over a vector to the unit that holds the vector: it
# must compute the operation over packed lanes, reading lanes of `of` and,
# for a conversion, giving lanes of `to`. a reinterpretation needs no row
fun packed(w: *Work, code: Opcode, of: Type, to: Type) {
    val lanes: u32 = lanes_of(w, of);
    if (lanes == 0 || code == opcode_table.BITCAST) { ret; }
    if (!computes(w, code, of, to, lanes))          { fail(w, refusal.Error.reason{UNPACKED}); }
}

# whether the unit holding a vector of `lanes` lanes of `of` computes an
# operation over them packed
fun computes(w: *Work, code: Opcode, of: Type, to: Type, lanes: u32) bool {
    var fa:     Format        = 0;
    var fb:     Format        = 0;
    val opt_of: opt[LaneType] = lane_type(w, of, ?fa);
    val opt_to: opt[LaneType] = lane_type(w, to, ?fb);
    if (sel opt_of.none) { ret false; }
    if (sel opt_to.none) { ret false; }
    val res_split: res[units.Split, units.Error] = units.split_for(w.basis, w.site.m.functions.data[w.site.f].data.constant_time, w.caps, opt_of.some, lanes);
    if (sel res_split.err) { ret false; }
    val split: units.Split = res_split.ok;
    if (!(sel split.pieces))         { ret false; }
    if (split.pieces.lanes != lanes) { ret false; }
    val res_native: res[bool, units.Error] = units.packed(w.basis, w.site.m.functions.data[w.site.f].data.constant_time, split.pieces.unit, code, opt_of.some, opt_to.some);
    if (sel res_native.err) { ret false; }
    ret res_native.ok;
}

fun constant(w: *Work, ty: Type, x: Wide) Value {
    val res_made: res[Value, refusal.Error] = emit.constant(?w.site, ty, x);
    if (sel res_made.err) {
        fail(w, res_made.err);
        ret 0;
    }
    ret res_made.ok;
}

fun float_constant(w: *Work, ty: Type, x: Wide) Value {
    val res_made: res[Value, refusal.Error] = emit.float_constant(?w.site, ty, x);
    if (sel res_made.err) {
        fail(w, res_made.err);
        ret 0;
    }
    ret res_made.ok;
}

fun small(n: u64) Wide {
    ret word.small(n);
}

fun pow2(n: u32) Wide {
    ret word.shl(word.small(1), n);
}

# the low n bits set
fun low(n: u32) Wide {
    ret word.sub(pow2(n), word.small(1));
}

# the encoding field of a biased exponent, which is never negative
fun exponent_field(b: type_format.Binary, e: i64) Wide {
    ret word.shl(word.small((e + b.bias::i64)::u64), b.significand);
}

# the encoding of the infinity of a format, every exponent bit set
fun infinity_of(b: type_format.Binary) Wide {
    ret word.shl(low(b.exponent), b.significand);
}

# the encoding of the canonical nan of a format: positive, quiet, no payload
fun canonical_of(b: type_format.Binary) Wide {
    ret word.bit_or(infinity_of(b), pow2(b.significand - 1));
}

fun op2(w: *Work, code: Opcode, a: Value, b: Value) Value {
    packed(w, code, type_of(w, a), type_of(w, a));
    ret emit.binary(?w.site, code, a, b);
}

fun pick(w: *Work, c: Value, a: Value, b: Value) Value {
    packed(w, opcode_table.SELECT, type_of(w, a), type_of(w, a));
    ret emit.ternary(?w.site, opcode_table.SELECT, c, a, b);
}

fun cast(w: *Work, code: Opcode, x: Value, to: Type) Value {
    packed(w, code, type_of(w, x), to);
    ret emit.convert(?w.site, code, x, to);
}

# how a nan a widening or a narrowing gives is made
# ---
# kept:      every bit kept, for a sign operation
# quiet:     quieted, its sign and payload kept
# canonical: the canonical nan
tag Nan: u8 {
    kept;
    quiet;
    canonical;
}

val UNRULED: str = "a format the target computes by widening with no row stating what the narrowing does to a nan";

# how the narrowing back to a lowered format makes a nan its operation gave,
# as the target's row of the format states it: quieted where it keeps the
# wide nan, the canonical nan where it makes every nan that
fun narrowed(w: *Work, f: Format, kept: Nan) Nan {
    val n: Narrowing = w.plans[f].narrowing;
    if (sel n.canonical) { ret Nan.canonical{}; }
    if (!(sel n.kept))   { fail(w, refusal.Error.reason{UNRULED}); }
    ret kept;
}

# the nan rule of a conversion, read from the held row of the other format
fun converted(w: *Work, other: Format) Nan {
    val res_held: res[opt[*Held], target_basis.Error] = target_basis.held(w.basis, w.caps, other);
    if (sel res_held.err) {
        fail(w, refusal.Error.condition{res_held.err});
        ret Nan.quiet{};
    }
    if (sel res_held.ok.some) {
        val rule: Nans = res_held.ok.some.nans;
        if (sel rule.canonical) { ret Nan.canonical{}; }
    }
    ret Nan.quiet{};
}

# the encoding of a narrow value widened exactly to a wide format, as a value
# of the wide format, lane by lane over a vector of `lanes`
fun widen(w: *Work, e: Value, from: Format, to: Format, nan: Nan, lanes: u32) Value {
    val n:       type_format.Binary = bits_of(from);
    val x:       type_format.Binary = bits_of(to);
    val nw:      u32                = row_of(from).width;
    val xw:      u32                = row_of(to).width;
    val it:      Type               = shaped(w, encoding(w, to), lanes);
    val ft:      Type               = shaped(w, float(w, to), lanes);
    val gap:     u32                = x.significand - n.significand;
    val hz:      Value              = cast(w, opcode_table.EXT_U, e, it);
    val sign:    Value              = op2(w, opcode_table.SHL, op2(w, opcode_table.AND, hz, constant(w, it, pow2(nw - 1))), constant(w, it, small((xw - nw)::u64)));
    val mag:     Value              = op2(w, opcode_table.AND, hz, constant(w, it, low(nw - 1)));
    val ex:      Value              = op2(w, opcode_table.SHR_U, mag, constant(w, it, small(n.significand::u64)));
    val m:       Value              = op2(w, opcode_table.AND, hz, constant(w, it, low(n.significand)));
    val rebias:  Wide               = word.shl(word.small((x.bias - n.bias)::u64), x.significand);
    val normal:  Value              = op2(w, opcode_table.ADD, op2(w, opcode_table.SHL, mag, constant(w, it, small(gap::u64))), constant(w, it, rebias));
    val shifted: Value              = op2(w, opcode_table.SHL, m, constant(w, it, small(gap::u64)));
    val special: Value              = op2(w, opcode_table.OR, shifted, constant(w, it, infinity_of(x)));
    # a subnormal is its significand times the least subnormal, both exact
    val least:  Value = float_constant(w, ft, exponent_field(x, target_basis.emin(n) - n.significand::i64));
    val scaled: Value = op2(w, opcode_table.FMUL, cast(w, opcode_table.ITOF_U, m, ft), least);
    val sub:    Value = cast(w, opcode_table.BITCAST, scaled, it);
    val zero:   Value = op2(w, opcode_table.EQ, ex, constant(w, it, word.zero()));
    val top:    Value = op2(w, opcode_table.EQ, ex, constant(w, it, low(n.exponent)));
    var r:      Value = op2(w, opcode_table.OR, pick(w, zero, sub, pick(w, top, special, normal)), sign);
    if (!(sel nan.kept)) {
        val isnan: Value = op2(w, opcode_table.AND, top, op2(w, opcode_table.NE, m, constant(w, it, word.zero())));
        if (sel nan.canonical) { r = pick(w, isnan, constant(w, it, canonical_of(x)), r); }
        or                     { r = pick(w, isnan, op2(w, opcode_table.OR, r, constant(w, it, pow2(x.significand - 1))), r); }
    }
    ret cast(w, opcode_table.BITCAST, r, ft);
}

# a value of a wide format narrowed to a narrow one, rounded once to nearest
# with ties to even, as the narrow encoding, lane by lane over a vector of
# `lanes`
fun narrow(w: *Work, v: Value, from: Format, to: Format, nan: Nan, lanes: u32) Value {
    val x:    type_format.Binary = bits_of(from);
    val n:    type_format.Binary = bits_of(to);
    val xw:   u32                = row_of(from).width;
    val nw:   u32                = row_of(to).width;
    val it:   Type               = shaped(w, encoding(w, from), lanes);
    val nt:   Type               = shaped(w, encoding(w, to), lanes);
    val ft:   Type               = shaped(w, float(w, from), lanes);
    val k:    u32                = x.significand - n.significand;
    val xb:   Value              = cast(w, opcode_table.BITCAST, v, it);
    val a:    Value              = op2(w, opcode_table.AND, xb, constant(w, it, low(xw - 1)));
    val sign: Value              = op2(w, opcode_table.AND, cast(w, opcode_table.TRUNC, op2(w, opcode_table.SHR_U, xb, constant(w, it, small((xw - nw)::u64))), nt), constant(w, nt, pow2(nw - 1)));
    # the overflow threshold: the largest finite value and half its unit
    val over_at: Wide  = word.add(exponent_field(x, target_basis.emax(n)), word.sub(pow2(x.significand), pow2(k - 1)));
    val isnan:   Value = op2(w, opcode_table.GT_U, a, constant(w, it, infinity_of(x)));
    val over:    Value = op2(w, opcode_table.GE_U, a, constant(w, it, over_at));
    val tiny:    Value = op2(w, opcode_table.LT_U, a, constant(w, it, exponent_field(x, target_basis.emin(n))));
    # the normal range: rebiased, then rounded to nearest even at the narrow unit
    val r1:     Value = op2(w, opcode_table.SUB, a, constant(w, it, word.shl(word.small((x.bias - n.bias)::u64), x.significand)));
    val odd:    Value = op2(w, opcode_table.AND, op2(w, opcode_table.SHR_U, r1, constant(w, it, small(k::u64))), constant(w, it, small(1)));
    val r2:     Value = op2(w, opcode_table.ADD, op2(w, opcode_table.ADD, r1, constant(w, it, low(k - 1))), odd);
    val normal: Value = cast(w, opcode_table.TRUNC, op2(w, opcode_table.SHR_U, r2, constant(w, it, small(k::u64))), nt);
    # the subnormal range: added to the power of two whose unit is the narrow
    # least subnormal, which the wide addition rounds, and taken away again
    val magic:  Wide  = exponent_field(x, target_basis.emin(n) - n.significand::i64 + x.significand::i64);
    val sum:    Value = op2(w, opcode_table.FADD, cast(w, opcode_table.BITCAST, a, ft), float_constant(w, ft, magic));
    val sub:    Value = cast(w, opcode_table.TRUNC, op2(w, opcode_table.SUB, cast(w, opcode_table.BITCAST, sum, it), constant(w, it, magic)), nt);
    val rest:   Value = pick(w, over, constant(w, nt, infinity_of(n)), pick(w, tiny, sub, normal));
    val signed: Value = op2(w, opcode_table.OR, rest, sign);
    var lost:   Value = constant(w, nt, canonical_of(n));
    if (!(sel nan.canonical)) {
        val payload: Value = op2(w, opcode_table.AND, cast(w, opcode_table.TRUNC, op2(w, opcode_table.SHR_U, a, constant(w, it, small(k::u64))), nt), constant(w, nt, low(n.significand)));
        var set:     Wide  = infinity_of(n);
        if (sel nan.quiet) { set = canonical_of(n); }
        lost = op2(w, opcode_table.OR, op2(w, opcode_table.OR, payload, constant(w, nt, set)), sign);
    }
    ret pick(w, isnan, lost, signed);
}

# the encoding of an operand of an expanded format: a constant's bits, lane
# by lane for a vector, or the reinterpretation of the value made ahead of the
# instruction reading it
fun encoded(w: *Work, x: Value, f: Format) Value {
    val nt:       Type                                  = encoding_of(w, type_of(w, x), f);
    val res_read: res[opt[record.Value], refusal.Error] = number.read(w.site.m, w.site.b, w.site.scratch, x);
    if (sel res_read.err) {
        fail(w, res_read.err);
        ret x;
    }
    if (sel res_read.ok.some) {
        val read: record.Value = res_read.ok.some;
        if (read.lanes.size == 1 && lanes_of(w, nt) == 0) { ret constant(w, nt, word.of(read.lanes.data[0].words)); }
        if (read.lanes.size::u32 == lanes_of(w, nt))      { ret recoded(w, read, nt, encoding(w, f)); }
    }
    ret cast(w, opcode_table.BITCAST, x, nt);
}

# a vector constant's lanes read as the lanes of its encoding, a vector of
# `lane`
fun recoded(w: *Work, v: record.Value, nt: Type, lane: Type) Value {
    val res_lanes: res[*Bits, allocator.Error] = allocator.zallocate[Bits](w.site.scratch, v.lanes.size);
    if (sel res_lanes.err) {
        fail(w, refusal.Error.alloc{res_lanes.err});
        ret 0;
    }
    var k: usize = 0;
    for (k < v.lanes.size) {
        res_lanes.ok[k] = Bits{type: lane, words: v.lanes.data[k].words};
        k               = k + 1;
    }
    val res_made: res[Value, refusal.Error] = number.place(w.site.m, w.site.f, w.site.scratch, record.Value{type: nt, lanes: Slice[Bits]{data: res_lanes.ok, size: v.lanes.size}});
    if (sel res_made.err) {
        fail(w, res_made.err);
        ret 0;
    }
    ret res_made.ok;
}

# an operand of an expanded format widened to the format its operation
# computes in
fun widened(w: *Work, x: Value, f: Format, to: Format, nan: Nan) Value {
    ret widen(w, encoded(w, x, f), f, to, nan, lanes_of(w, type_of(w, x)));
}

# what one instruction to rewrite is, copied before the body grows under it
# ---
# origin:   the instruction
# code:     its opcode
# operands: its operands
# count:    how many
# result:   its first result, valid where results is not zero
# results:  how many results it has
# flags:    its flags
# imm:      its immediates
# imms:     how many
rec Copied {
    origin:   Instruction;
    code:     Opcode;
    operands: *Value;
    count:    usize;
    result:   Value;
    results:  usize;
    flags:    Flags;
    imm:      *Immediate;
    imms:     usize;
}

# the copy, its operands and immediates in the visit's scratch
fun copy_of(w: *Work, d: *InstructionData, i: Instruction) Copied {
    var c: Copied;
    c.origin = i;
    c.code   = d.opcode;
    val res_operands: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, d.operands.len + 1);
    if (sel res_operands.err) {
        fail(w, refusal.Error.alloc{res_operands.err});
        ret c;
    }
    val res_imm: res[*Immediate, allocator.Error] = allocator.zallocate[Immediate](w.site.scratch, d.immediates.len + 1);
    if (sel res_imm.err) {
        fail(w, refusal.Error.alloc{res_imm.err});
        ret c;
    }
    c.operands = res_operands.ok;
    c.imm      = res_imm.ok;
    c.count    = d.operands.len;
    var k: usize = 0;
    for (k < c.count) {
        c.operands[k] = d.operands.data[k];
        k             = k + 1;
    }
    c.result  = 0;
    c.results = d.results.len;
    if (d.results.len > 0) { c.result = d.results.data[0]; }
    c.flags = d.metadata.flags;
    c.imms  = d.immediates.len;
    k       = 0;
    for (k < c.imms) {
        c.imm[k] = d.immediates.data[k];
        k        = k + 1;
    }
    ret c;
}

# make an instruction of any operands and immediates, giving its first result
# where it has one
fun made(w: *Work, code: Opcode, ops: *Value, n: usize, imm: *Immediate, slots: usize) Value {
    val i: Instruction = emit.emit(?w.site, code, Slice[Value]{data: ops, size: n}, Slice[Immediate]{data: imm, size: slots});
    # a refused one is no instruction, and the refusal is the rewrite's
    if (i::usize >= w.site.b.instructions.len) { ret 0; }
    val d: *InstructionData = ?w.site.b.instructions.data[i];
    if (d.results.len == 0) { ret 0; }
    ret emit.result(?w.site, i, 0);
}

# the first failure, or ok
fun failure_of(w: *Work) err[refusal.Error] {
    val opt_failed: opt[refusal.Error] = w.failed;
    if (sel opt_failed.some) { ret err[refusal.Error].err{opt_failed.some}; }
    ret err[refusal.Error].ok{};
}

# what an instruction reading or giving an expanded format is rewritten as
# ---
# none:       it is left, at a boundary or where nothing computes it
# compute:    an arithmetic operation, in the format of the plan, its nan made so
# compare:    a comparison of the widened operands
# to_float:   a conversion from an integer, made in the basic format and narrowed
# to_integer: a conversion to an integer of the widened operand
# promote:    a conversion to another format, from the widened operand
# demote:     a conversion from another format, narrowed from its encoding
# recast:     a reinterpretation, of the encoding
# held:       a load, store, select, declassification or lane move, of the encoding
tag How: u8 {
    none;
    compute: Nan;
    compare;
    to_float;
    to_integer;
    promote;
    demote;
    recast;
    held;
}

# the format an instruction's operation reads or gives that is expanded, and
# how it is rewritten
rec Rewrite {
    how:    How;
    format: Format;
    fused:  bool;
}

fun leave() Rewrite {
    ret Rewrite{how: How.none{}, format: 0, fused: false};
}

fun classify(w: *Work, d: *InstructionData) Rewrite {
    var f:    Format = 0;
    var have: bool   = false;
    var out:  bool   = false;
    var k:    usize  = 0;
    for (k < d.operands.len) {
        val opt_expanded: opt[Format] = expanded(w, type_of(w, d.operands.data[k]));
        if (sel opt_expanded.some) {
            if (!have) { f = opt_expanded.some; }
            have = true;
        }
        k = k + 1;
    }
    k = 0;
    for (k < d.results.len) {
        val opt_expanded: opt[Format] = expanded(w, type_of(w, d.results.data[k]));
        if (sel opt_expanded.some) {
            if (!have) { f = opt_expanded.some; }
            have = true;
            out  = true;
        }
        k = k + 1;
    }
    if (!have) { ret leave(); }
    val e:  fold_table.Entry = fold_table.entry(d.opcode);
    var rw: Rewrite          = Rewrite{how: How.none{}, format: f, fused: false};
    if (sel e.float_unary || sel e.float_binary) { rw.how = How.compute{Nan.quiet{}}; }
    if (sel e.float_ternary) {
        rw.how   = How.compute{Nan.quiet{}};
        rw.fused = true;
    }
    if (sel e.sign_unary || sel e.sign_binary) { rw.how = How.compute{Nan.kept{}}; }
    if (sel e.float_compare)                   { rw.how = How.compare{}; }
    if (sel e.to_float && out)                 { rw.how = How.to_float{}; }
    if (sel e.to_integer && !out)              { rw.how = How.to_integer{}; }
    if (sel e.reformat) {
        if (out) { rw.how = How.demote{}; }
        or       { rw.how = How.promote{}; }
    }
    if (sel e.bitcast)                  { rw.how = How.recast{}; }
    if (sel e.select || sel e.identity) { rw.how = How.held{}; }
    if (sel e.splat || sel e.build || sel e.shuffle || sel e.extract || sel e.insert) {
        if (lanes_expanded(w, d)) { rw.how = How.held{}; }
    }
    if (d.opcode == opcode_table.LOAD || d.opcode == opcode_table.STORE) { rw.how = How.held{}; }
    ret rw;
}

# whether every vector of a format a lane operation reads or gives is one the
# pass computes elsewhere, so its lanes move as encodings
fun lanes_expanded(w: *Work, d: *InstructionData) bool {
    var k: usize = 0;
    for (k < d.operands.len + d.results.len) {
        var x: Value = 0;
        if (k < d.operands.len) { x = d.operands.data[k]; }
        or                      { x = d.results.data[k - d.operands.len]; }
        val ty:         Type        = type_of(w, x);
        val opt_format: opt[Format] = format_of(w, ty);
        if (lanes_of(w, ty) != 0 && sel opt_format.some) {
            val opt_expanded: opt[Format] = expanded(w, ty);
            if (sel opt_expanded.none) { ret false; }
        }
        k = k + 1;
    }
    ret true;
}

# the format a plan computes an operation in
fun computes_in(w: *Work, rw: Rewrite) opt[Format] {
    val p: Plan = w.plans[rw.format];
    if (rw.fused) { ret p.fused; }
    ret p.basic;
}

# an operand of the copy read as its encoding where its type is expanded, and
# as it stands otherwise
fun held_operand(w: *Work, c: *Copied, k: usize) Value {
    val x:            Value       = c.operands[k];
    val opt_expanded: opt[Format] = expanded(w, type_of(w, x));
    if (sel opt_expanded.none) { ret x; }
    ret encoded(w, x, opt_expanded.some);
}

# an immediate type of the copy, its expanded format's encoding in its place
fun held_immediate(w: *Work, i: Immediate) Immediate {
    if (!(sel i.ty)) { ret i; }
    val opt_expanded: opt[Format] = expanded(w, i.ty);
    if (sel opt_expanded.none) { ret i; }
    ret Immediate.ty{encoding_of(w, i.ty, opt_expanded.some)};
}

# the end of a rewrite whose result is a value already made, which takes the
# instruction's uses before it goes
fun settle(w: *Work, i: Instruction, result: Value, by: Value) err[refusal.Error] {
    val err_done: err[refusal.Error] = emit.done(?w.site);
    if (sel err_done.err) { ret err_done; }
    val err_failed: err[refusal.Error] = failure_of(w);
    if (sel err_failed.err) { ret err_failed; }
    val err_moved: err[refusal.Error] = refusal.edit(body.replace(w.site.m, w.site.f, result, by, Records.follow{}));
    if (sel err_moved.err) { ret err_moved; }
    ret refusal.edit(body.erase(w.site.m, w.site.f, i));
}

# make each constant of an expanded format that an instruction left at a
# boundary reads, a call's argument or a returned value, from its encoding by a
# reinterpretation ahead of it, as every other value there is made
fun bounding(w: *Work, i: Instruction) err[refusal.Error] {
    var j: usize = 0;
    for (j < w.site.b.instructions.data[i].operands.len) {
        val x:            Value       = w.site.b.instructions.data[i].operands.data[j];
        val ty:           Type        = type_of(w, x);
        val opt_expanded: opt[Format] = expanded(w, ty);
        var f:            Format      = 0;
        var fixed:        bool        = false;
        if (sel opt_expanded.some) {
            f     = opt_expanded.some;
            fixed = sel w.site.b.values.data[x].def.constant;
        }
        if (fixed) {
            emit.operand(?w.site, i, x);
            val r:        Value              = cast(w, opcode_table.BITCAST, encoded(w, x, f), ty);
            val err_done: err[refusal.Error] = emit.done(?w.site);
            if (sel err_done.err) { ret err_done; }
            val err_failed: err[refusal.Error] = failure_of(w);
            if (sel err_failed.err) { ret err_failed; }
            val err_moved: err[refusal.Error] = refusal.edit(body.substitute(w.site.m, w.site.f, i, x, r));
            if (sel err_moved.err) { ret err_moved; }
        }
        j = j + 1;
    }
    ret err[refusal.Error].ok{};
}

# rewrite one instruction
fun rewrite(w: *Work, i: Instruction) err[refusal.Error] {
    val d:  *InstructionData = ?w.site.b.instructions.data[i];
    val rw: Rewrite          = classify(w, d);
    if (sel rw.how.none) { ret bounding(w, i); }
    var c:          Copied             = copy_of(w, d, i);
    val err_copied: err[refusal.Error] = failure_of(w);
    if (sel err_copied.err) { ret err_copied; }
    var lanes: u32 = 0;
    if (c.count > 0) { lanes = lanes_of(w, type_of(w, c.operands[0])); }
    if (soft_rewrites(w, d, rw)) {
        if (lanes != 0) { ret err[refusal.Error].err{refusal.Error.reason{UNPACKED}}; }
        ret soft_rewrite(w, i, ?c, rw);
    }
    val f: Format = rw.format;
    # a reinterpretation or a held operation reads the encoding alone, so it
    # needs no format to compute in
    var wide:            Format      = f;
    val opt_computes_in: opt[Format] = computes_in(w, rw);
    if (sel opt_computes_in.some)                   { wide = opt_computes_in.some; }
    or (!(sel rw.how.recast) && !(sel rw.how.held)) { ret err[refusal.Error].ok{}; }
    var ty: Type = 0;
    if (c.results > 0) { ty = type_of(w, c.result); }
    # the other format of a conversion, which must be held
    var other: Format = 0;
    if (sel rw.how.promote || sel rw.how.demote) {
        var at: Type = type_of(w, c.operands[0]);
        if (sel rw.how.promote) { at = type_of(w, c.result); }
        val opt_format_of: opt[Format] = format_of(w, at);
        if (sel opt_format_of.none) { ret err[refusal.Error].ok{}; }
        other = opt_format_of.some;
        val opt_twice: opt[Format] = expanded(w, at);
        if (sel opt_twice.some) { ret err[refusal.Error].ok{}; }
    }
    emit.begin(?w.site, i);
    if (sel rw.how.compute) {
        var ops: [3]Value;
        var j:   usize = 0;
        for (j < c.count) {
            ops[j] = widened(w, c.operands[j], f, wide, Nan.kept{});
            j      = j + 1;
        }
        var nan: Nan = rw.how.compute;
        if (!(sel nan.kept)) { nan = narrowed(w, f, nan); }
        packed(w, c.code, type_of(w, ops[0]), type_of(w, ops[0]));
        val r: Value = made(w, c.code, ?ops[0], c.count, nil, 0);
        val e: Value = narrow(w, r, wide, f, nan, lanes);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, e, ty);
    }
    or (sel rw.how.compare) {
        val a: Value = widened(w, c.operands[0], f, wide, Nan.kept{});
        val b: Value = widened(w, c.operands[1], f, wide, Nan.kept{});
        emit.end(?w.site, i);
        op2(w, c.code, a, b);
    }
    or (sel rw.how.to_float) {
        val r: Value = cast(w, c.code, c.operands[0], shaped(w, float(w, wide), lanes));
        val e: Value = narrow(w, r, wide, f, Nan.quiet{}, lanes);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, e, ty);
    }
    or (sel rw.how.to_integer) {
        val a: Value = widened(w, c.operands[0], f, wide, Nan.kept{});
        emit.end(?w.site, i);
        cast(w, c.code, a, type_of(w, c.result));
    }
    or (sel rw.how.promote) {
        val to: Type  = type_of(w, c.result);
        val a:  Value = widened(w, c.operands[0], f, wide, converted(w, other));
        if (other == wide) { ret settle(w, i, c.result, a); }
        var code: Opcode = opcode_table.FPROMOTE;
        if (row_of(other).width < row_of(wide).width) { code = opcode_table.FDEMOTE; }
        emit.end(?w.site, i);
        cast(w, code, a, to);
    }
    or (sel rw.how.demote) {
        val e: Value = narrow(w, c.operands[0], other, f, narrowed(w, f, converted(w, other)), lanes);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, e, ty);
    }
    or (sel rw.how.recast) {
        val to:      Type        = type_of(w, c.result);
        val from:    Type        = type_of(w, c.operands[0]);
        val opt_src: opt[Format] = expanded(w, from);
        var nt:      Type        = encoding_of(w, to, f);
        if (sel opt_src.some) { nt = encoding_of(w, from, f); }
        if (sel opt_src.some) {
            val e: Value = encoded(w, c.operands[0], f);
            if (type_table.same(to, nt)) { ret settle(w, i, c.result, e); }
            emit.end(?w.site, i);
            cast(w, opcode_table.BITCAST, e, to);
        }
        or {
            var e: Value = c.operands[0];
            if (!type_table.same(from, nt)) { e = cast(w, opcode_table.BITCAST, e, nt); }
            emit.end(?w.site, i);
            cast(w, opcode_table.BITCAST, e, ty);
        }
    }
    or {
        val res_ops: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, c.count + 1);
        if (sel res_ops.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_ops.err}}; }
        val res_imm: res[*Immediate, allocator.Error] = allocator.zallocate[Immediate](w.site.scratch, c.imms + 1);
        if (sel res_imm.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_imm.err}}; }
        val ops: *Value     = res_ops.ok;
        val imm: *Immediate = res_imm.ok;
        var j:   usize      = 0;
        for (j < c.count) {
            ops[j] = held_operand(w, ?c, j);
            j      = j + 1;
        }
        j = 0;
        for (j < c.imms) {
            imm[j] = held_immediate(w, c.imm[j]);
            j      = j + 1;
        }
        var gives: bool = false;
        var of:    Type = 0;
        if (c.results > 0) {
            val opt_expanded: opt[Format] = expanded(w, type_of(w, c.result));
            gives = sel opt_expanded.some;
            of    = type_of(w, c.result);
            if (sel opt_expanded.some) { of = encoding_of(w, of, opt_expanded.some); }
        }
        # a select or a lane operation over a vector is held to the unit that
        # holds its encoding, a load or a store needing no row
        j = 0;
        for (j < c.count && lanes_of(w, of) == 0) {
            of = type_of(w, ops[j]);
            j  = j + 1;
        }
        val entry: fold_table.Entry = fold_table.entry(c.code);
        if (c.code != opcode_table.LOAD && c.code != opcode_table.STORE && !(sel entry.identity)) { packed(w, c.code, of, of); }
        if (gives) {
            emit.flags(?w.site, c.flags);
            val r: Value = made(w, c.code, ops, c.count, imm, c.imms);
            emit.flags(?w.site, NO_FLAGS);
            emit.end(?w.site, i);
            cast(w, opcode_table.BITCAST, r, ty);
        }
        or {
            emit.end(?w.site, i);
            emit.flags(?w.site, c.flags);
            made(w, c.code, ops, c.count, imm, c.imms);
        }
    }
    val err_built: err[refusal.Error] = emit.done(?w.site);
    if (sel err_built.err) { ret err_built; }
    ret failure_of(w);
}

# hold every parameter of an expanded format of a block other than the entry
# as its encoding: a parameter of the encoding is added, every edge into the
# block passing its argument's encoding, made ahead of the edge's branch, and
# the old parameter's readers read the encoding reinterpreted, made at the
# block's start, before the old parameter goes
fun parameters(w: *Work, k: Block) err[refusal.Error] {
    val b: *Body = w.site.b;
    var p: usize = 0;
    for (p < b.blocks.data[k].parameters.len) {
        val old:          Value       = b.blocks.data[k].parameters.data[p];
        val opt_expanded: opt[Format] = expanded(w, type_of(w, old));
        if (sel opt_expanded.none) { p = p + 1; }
        or {
            val nt:       Type                         = encoding_of(w, type_of(w, old), opt_expanded.some);
            val zero:     Value                        = constant(w, nt, word.zero());
            val preds:    usize                        = b.blocks.data[k].predecessors.len;
            val res_room: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, preds + 1);
            if (sel res_room.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_room.err}}; }
            var e: usize = 0;
            for (e < preds) {
                res_room.ok[e] = zero;
                e              = e + 1;
            }
            val err_unmade: err[refusal.Error] = failure_of(w);
            if (sel err_unmade.err) { ret err_unmade; }
            val secret:    bool                     = b.values.data[old].secret;
            val res_added: res[Value, module.Error] = body.add_parameter(w.site.m, w.site.f, k, Declaration{type: nt, secret: secret, name: opt[View].none{}}, Slice[Value]{data: res_room.ok, size: preds});
            if (sel res_added.err) { ret err[refusal.Error].err{refusal.Error.ir{res_added.err}}; }
            val at:         usize              = b.blocks.data[k].parameters.len - 1;
            val err_passed: err[refusal.Error] = pass_encodings(w, k, p, at, opt_expanded.some);
            if (sel err_passed.err) { ret err_passed; }
            val first: Instruction = b.blocks.data[k].first;
            emit.begin(?w.site, first);
            val back:     Value              = cast(w, opcode_table.BITCAST, res_added.ok, type_of(w, old));
            val err_made: err[refusal.Error] = emit.done(?w.site);
            if (sel err_made.err) { ret err_made; }
            val err_failed: err[refusal.Error] = failure_of(w);
            if (sel err_failed.err) { ret err_failed; }
            val err_moved: err[refusal.Error] = refusal.edit(body.replace(w.site.m, w.site.f, old, back, Records.follow{}));
            if (sel err_moved.err) { ret err_moved; }
            val err_gone: err[refusal.Error] = refusal.edit(body.remove_parameter(w.site.m, w.site.f, k, p::u32));
            if (sel err_gone.err) { ret err_gone; }
        }
    }
    ret err[refusal.Error].ok{};
}

# make every edge into a block pass, for its parameter at `to`, the encoding
# of the argument it passes for the one at `from`, made ahead of its branch
fun pass_encodings(w: *Work, k: Block, from: usize, to: usize, f: Format) err[refusal.Error] {
    val b: *Body = w.site.b;
    var j: usize = 0;
    for (j < b.blocks.len) {
        if (!b.blocks.data[j].erased && b.blocks.data[j].last != NO_INSTRUCTION) {
            val last: Instruction = b.blocks.data[j].last;
            var e:    usize       = 0;
            for (e < b.instructions.data[last].edges.len) {
                if (b.instructions.data[last].edges.data[e].block == k) {
                    val count:    usize                        = b.instructions.data[last].edges.data[e].arguments.len;
                    val res_args: res[*Value, allocator.Error] = allocator.zallocate[Value](w.site.scratch, count);
                    if (sel res_args.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_args.err}}; }
                    var a: usize = 0;
                    for (a < count) {
                        res_args.ok[a] = b.instructions.data[last].edges.data[e].arguments.data[a];
                        a              = a + 1;
                    }
                    emit.begin(?w.site, last);
                    res_args.ok[to] = encoded(w, res_args.ok[from], f);
                    val err_done: err[refusal.Error] = emit.done(?w.site);
                    if (sel err_done.err) { ret err_done; }
                    val err_failed: err[refusal.Error] = failure_of(w);
                    if (sel err_failed.err) { ret err_failed; }
                    val now:       Instruction        = b.blocks.data[j].last;
                    val err_moved: err[refusal.Error] = refusal.edit(body.retarget(w.site.m, w.site.f, now, e::u32, k, Slice[Value]{data: res_args.ok, size: count}));
                    if (sel err_moved.err) { ret err_moved; }
                }
                e = e + 1;
            }
        }
        j = j + 1;
    }
    ret err[refusal.Error].ok{};
}

# whether an instruction is a reinterpretation between an expanded format and
# its encoding, from the format when `from` is set and to it otherwise
fun recasts(w: *Work, i: Instruction, from: bool) bool {
    val d: *InstructionData = ?w.site.b.instructions.data[i];
    if (d.opcode != opcode_table.BITCAST || !(sel d.place.placed)) { ret false; }
    val a:            Type        = type_of(w, d.operands.data[0]);
    val r:            Type        = type_of(w, d.results.data[0]);
    var opt_expanded: opt[Format] = expanded(w, r);
    var e:            Type        = a;
    if (from) {
        opt_expanded = expanded(w, a);
        e            = r;
    }
    if (sel opt_expanded.none) { ret false; }
    if (from)                  { ret type_table.same(e, encoding_of(w, a, opt_expanded.some)); }
    ret type_table.same(e, encoding_of(w, r, opt_expanded.some));
}

# take out each pair of reinterpretations the rewrite left, an encoding read
# back from the format it was made into, and then every reinterpretation into
# the format nothing reads
fun tidy(w: *Work) err[refusal.Error] {
    val b: *Body = w.site.b;
    var i: usize = 0;
    for (i < b.instructions.len) {
        val at: Instruction = (i::u32);
        if (recasts(w, at, true)) {
            val x:   Value = b.instructions.data[i].operands.data[0];
            val def: Def   = b.values.data[x].def;
            if (sel def.result) {
                if (recasts(w, def.result.instruction, false)) {
                    val inner:     Value              = b.instructions.data[def.result.instruction].operands.data[0];
                    val r:         Value              = b.instructions.data[i].results.data[0];
                    val err_moved: err[refusal.Error] = refusal.edit(body.replace(w.site.m, w.site.f, r, inner, Records.follow{}));
                    if (sel err_moved.err) { ret err_moved; }
                    val err_gone: err[refusal.Error] = refusal.edit(body.erase(w.site.m, w.site.f, at));
                    if (sel err_gone.err) { ret err_gone; }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        val at: Instruction = (i::u32);
        if (recasts(w, at, false) && b.values.data[b.instructions.data[i].results.data[0]].uses.len == 0) {
            val err_gone: err[refusal.Error] = refusal.edit(body.erase(w.site.m, w.site.f, at));
            if (sel err_gone.err) { ret err_gone; }
        }
        i = i + 1;
    }
    ret err[refusal.Error].ok{};
}

# compute every value of an expanded format of one function in its plan
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:        *Context                 = u.context;
    val res_body: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }

    val rows:      usize                       = type_format.rows()::usize;
    val res_plans: res[*Plan, allocator.Error] = allocator.zallocate[Plan](c.m.a, rows);
    if (sel res_plans.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_plans.err}}; }
    fin { allocator.deallocate[Plan](c.m.a, res_plans.ok, rows); }
    var any: bool  = false;
    var r:   usize = 0;
    for (r < rows) {
        val res_plan_of: res[Plan, refusal.Error] = plan_of(c.basis, ?c.t.caps, (r::u32));
        if (sel res_plan_of.err) { ret res[bool, refusal.Error].err{res_plan_of.err}; }
        res_plans.ok[r] = res_plan_of.ok;
        if (sel res_plan_of.ok.basic.some || res_plan_of.ok.soft) { any = true; }
        r = r + 1;
    }
    if (!any) { ret res[bool, refusal.Error].ok{false}; }

    var ar:       arena.Arena;
    val err_made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.allocator(?scratch, ?ar);

    var w: Work  = Work{site: emit.init(c.m, u.f, res_body.ok, ?scratch), basis: c.basis, build: c.build, ctx: target_basis.context_of(c.basis), caps: ?c.t.caps, t: c.t, plans: res_plans.ok, start: res_body.ok.instructions.len, failed: opt[refusal.Error].none{}};
    var b: *Body = res_body.ok;

    # whether anything is of an expanded format, the body's types asked first
    var held: bool = false;
    var ty:   u32  = 0;
    for (!held && contents.seek(?b.contents.types, ?ty)) {
        val opt_expanded: opt[Format] = expanded(?w, ty);
        held = sel opt_expanded.some;
        ty   = ty + 1;
    }
    if (!held) { ret res[bool, refusal.Error].ok{false}; }
    var found: bool  = false;
    var v:     usize = 0;
    for (v < b.values.len && !found) {
        val opt_expanded: opt[Format] = expanded(?w, b.values.data[v].type);
        if (!(sel b.values.data[v].def.removed) && sel opt_expanded.some) { found = true; }
        v = v + 1;
    }
    if (!found) { ret res[bool, refusal.Error].ok{false}; }

    # the helpers go into the module before the body is read again, since
    # reading one in may move every body
    val err_delivered: err[refusal.Error] = deliver_all(?w, ?ar);
    if (sel err_delivered.err) { ret res[bool, refusal.Error].err{err_delivered.err}; }
    val res_again: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel res_again.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_again.err}}; }
    b      = res_again.ok;
    w.site = emit.init(c.m, u.f, b, ?scratch);

    var k: usize = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && b.blocks.data[k].first != NO_INSTRUCTION) {
            arena.reset(?ar);
            val err_held: err[refusal.Error] = parameters(?w, (k::u32));
            if (sel err_held.err) { ret res[bool, refusal.Error].err{err_held.err}; }
        }
        k = k + 1;
    }
    k = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: Instruction = b.blocks.data[k].first;
            for (n != NO_INSTRUCTION) {
                arena.reset(?ar);
                val i: Instruction = n;
                n = b.instructions.data[i].next;
                if (i::usize < w.start) {
                    val err_done: err[refusal.Error] = rewrite(?w, i);
                    if (sel err_done.err) { ret res[bool, refusal.Error].err{err_done.err}; }
                }
            }
        }
        k = k + 1;
    }
    val err_tidied: err[refusal.Error] = tidy(?w);
    if (sel err_tidied.err) { ret res[bool, refusal.Error].err{err_tidied.err}; }
    val err_kept: err[refusal.Error] = keep_encodings(?w);
    if (sel err_kept.err) { ret res[bool, refusal.Error].err{err_kept.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# the format a type is of where it is expanded and kept as its encoding
fun encoded_format(w: *Work, ty: Type) opt[Format] {
    val opt_expanded: opt[Format] = expanded(w, ty);
    if (sel opt_expanded.none) { ret opt_expanded; }
    val p: Plan = w.plans[opt_expanded.some];
    if (sel p.kept.encoding) { ret opt_expanded; }
    ret opt[Format].none{};
}

# the type a type is kept as where its format is kept as its encoding: the
# encoding of a scalar, and a function type in its parameters and results,
# none where it stays
fun kept_type(w: *Work, ty: Type) opt[Type] {
    val opt_format: opt[Format] = encoded_format(w, ty);
    if (sel opt_format.some) { ret opt[Type].some{encoding_of(w, ty, opt_format.some)}; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?w.site.m.types, ty);
    if (sel res_shape.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_shape.err}});
        ret opt[Type].none{};
    }
    if (!(sel res_shape.ok.function)) { ret opt[Type].none{}; }
    val fs:         type_table.Function         = res_shape.ok.function;
    val res_params: res[*Type, allocator.Error] = allocator.zallocate[Type](w.site.scratch, fs.params.size + 1);
    if (sel res_params.err) {
        fail(w, refusal.Error.alloc{res_params.err});
        ret opt[Type].none{};
    }
    val res_results: res[*Type, allocator.Error] = allocator.zallocate[Type](w.site.scratch, fs.results.size + 1);
    if (sel res_results.err) {
        fail(w, refusal.Error.alloc{res_results.err});
        ret opt[Type].none{};
    }
    var any: bool  = false;
    var i:   usize = 0;
    for (i < fs.params.size) {
        res_params.ok[i] = fs.params.data[i];
        val opt_param: opt[Format] = encoded_format(w, fs.params.data[i]);
        if (sel opt_param.some) {
            res_params.ok[i] = encoding_of(w, fs.params.data[i], opt_param.some);
            any              = true;
        }
        i = i + 1;
    }
    i = 0;
    for (i < fs.results.size) {
        res_results.ok[i] = fs.results.data[i];
        val opt_result: opt[Format] = encoded_format(w, fs.results.data[i]);
        if (sel opt_result.some) {
            res_results.ok[i] = encoding_of(w, fs.results.data[i], opt_result.some);
            any               = true;
        }
        i = i + 1;
    }
    if (!any) { ret opt[Type].none{}; }
    var shape: type_table.Function = fs;
    shape.params  = Slice[Type]{data: res_params.ok, size: fs.params.size};
    shape.results = Slice[Type]{data: res_results.ok, size: fs.results.size};
    val res_made: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.function{shape});
    if (sel res_made.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_made.err}});
        ret opt[Type].none{};
    }
    ret opt[Type].some{res_made.ok};
}

# where a format is kept as its encoding, hold it so where the rewrite left
# it: the function's signature, its entry's parameters, a call's arguments,
# results and signature, a returned value and a stack slot. every value of
# the format left is retyped as its encoding, a constant as the constant of
# its bits, each immediate type in its place, and a reinterpretation left
# between the encoding and itself takes its uses and goes
fun keep_encodings(w: *Work) err[refusal.Error] {
    var any: bool   = false;
    var r:   Format = 0;
    for (r < type_format.rows()) {
        if (sel w.plans[r].kept.encoding && (sel w.plans[r].basic.some || w.plans[r].soft)) { any = true; }
        r = r + 1;
    }
    if (!any) { ret err[refusal.Error].ok{}; }
    val b:             *Body          = w.site.b;
    val node:          *function.Node = ?w.site.m.functions.data[w.site.f];
    val opt_signature: opt[Type]      = kept_type(w, node.data.signature);
    if (sel opt_signature.some) { node.data.signature = opt_signature.some; }
    var v: usize = 0;
    for (v < b.values.len) {
        if (!(sel b.values.data[v].def.removed)) {
            val ty:         Type        = b.values.data[v].type;
            val opt_format: opt[Format] = encoded_format(w, ty);
            if (sel opt_format.some) {
                val nt:          Type               = encoding_of(w, ty, opt_format.some);
                val err_retyped: err[refusal.Error] = refusal.edit(body.retype(w.site.m, w.site.f, (v::u32), nt, body.Retyped.bits{}));
                if (sel err_retyped.err) { ret err_retyped; }
                val def: Def = b.values.data[v].def;
                if (sel def.constant) {
                    val err_moved: err[refusal.Error] = kept_constant(w, (v::u32), def.constant, nt);
                    if (sel err_moved.err) { ret err_moved; }
                }
            }
        }
        v = v + 1;
    }
    var i: usize = 0;
    for (i < b.instructions.len) {
        if (sel b.instructions.data[i].place.placed) {
            var j: usize = 0;
            for (j < b.instructions.data[i].immediates.len) {
                val imm: Immediate = b.instructions.data[i].immediates.data[j];
                if (sel imm.ty) {
                    val opt_kept: opt[Type] = kept_type(w, imm.ty);
                    if (sel opt_kept.some) { b.instructions.data[i].immediates.data[j] = Immediate.ty{opt_kept.some}; }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    val err_failed: err[refusal.Error] = failure_of(w);
    if (sel err_failed.err) { ret err_failed; }
    i = 0;
    for (i < b.instructions.len) {
        val d: *InstructionData = ?b.instructions.data[i];
        if (d.opcode == opcode_table.BITCAST && sel d.place.placed && d.results.len == 1) {
            val x: Value = d.operands.data[0];
            val y: Value = d.results.data[0];
            if (type_table.same(b.values.data[x].type, b.values.data[y].type)) {
                val err_moved: err[refusal.Error] = refusal.edit(body.replace(w.site.m, w.site.f, y, x, Records.follow{}));
                if (sel err_moved.err) { ret err_moved; }
                val err_gone: err[refusal.Error] = refusal.edit(body.erase(w.site.m, w.site.f, (i::u32)));
                if (sel err_gone.err) { ret err_gone; }
            }
        }
        i = i + 1;
    }
    ret err[refusal.Error].ok{};
}

# a constant value of a format kept as its encoding made the constant of its
# bits, or the value of that constant the body already holds
fun kept_constant(w: *Work, v: Value, c: Constant, nt: Type) err[refusal.Error] {
    val b:        *Body                           = w.site.b;
    val res_data: res[ConstantData, module.Error] = module.constant_data(w.site.m, c);
    if (sel res_data.err) { ret err[refusal.Error].err{refusal.Error.ir{res_data.err}}; }
    val data: ConstantData = res_data.ok;
    var made: ConstantData = ConstantData.zero{nt};
    if (sel data.float) { made = ConstantData.integer{Bits{type: nt, words: data.float.words}}; }
    or (sel data.spec)  { made = ConstantData.spec{Spec{id: data.spec.id, default: Bits{type: nt, words: data.spec.default.words}}}; }
    or (sel data.aggregate) {
        val res_kept: res[ConstantData, refusal.Error] = kept_lanes(w, data.aggregate, nt);
        if (sel res_kept.err) { ret err[refusal.Error].err{res_kept.err}; }
        made = res_kept.ok;
    }
    or (!(sel data.zero)) { ret err[refusal.Error].err{refusal.Error.reason{"a constant of a format kept as its encoding that is no number"}}; }
    val res_made: res[Constant, module.Error] = module.add_constant(w.site.m, made);
    if (sel res_made.err) { ret err[refusal.Error].err{refusal.Error.ir{res_made.err}}; }
    var old:       u32         = c;
    var now:       u32         = res_made.ok;
    val opt_there: opt[*Value] = map.get[u32, Value](?b.constants, ?now);
    map.remove[u32, Value](?b.constants, ?old);
    if (sel opt_there.some) {
        val there: Value = @opt_there.some;
        ret refusal.edit(body.replace(w.site.m, w.site.f, v, there, Records.follow{}));
    }
    b.values.data[v].def = Def.constant{res_made.ok};
    val res_kept: res[bool, allocator.Error] = map.insert[u32, Value](?b.constants, now, v);
    if (sel res_kept.err) { ret err[refusal.Error].err{refusal.Error.alloc{res_kept.err}}; }
    ret err[refusal.Error].ok{};
}

# a vector constant of a format kept as its encoding made the vector of its
# lanes' bits, a vector of type nt
fun kept_lanes(w: *Work, v: Aggregate, nt: Type) res[ConstantData, refusal.Error] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?w.site.m.types, nt);
    if (sel res_shape.err)          { ret res[ConstantData, refusal.Error].err{refusal.Error.ir{module.Error.types{res_shape.err}}}; }
    if (!(sel res_shape.ok.vector)) { ret res[ConstantData, refusal.Error].err{refusal.Error.reason{"a constant of a format kept as its encoding that is no number"}}; }
    val lane:      Type                            = res_shape.ok.vector.element;
    val res_lanes: res[*Constant, allocator.Error] = allocator.zallocate[Constant](w.site.scratch, v.elements.size);
    if (sel res_lanes.err) { ret res[ConstantData, refusal.Error].err{refusal.Error.alloc{res_lanes.err}}; }
    var k: usize = 0;
    for (k < v.elements.size) {
        val res_data: res[ConstantData, module.Error] = module.constant_data(w.site.m, v.elements.data[k]);
        if (sel res_data.err) { ret res[ConstantData, refusal.Error].err{refusal.Error.ir{res_data.err}}; }
        val data: ConstantData = res_data.ok;
        var made: ConstantData = ConstantData.zero{lane};
        if (sel data.float)   { made = ConstantData.integer{Bits{type: lane, words: data.float.words}}; }
        or (!(sel data.zero)) { ret res[ConstantData, refusal.Error].err{refusal.Error.reason{"a constant of a format kept as its encoding that is no number"}}; }
        val res_made: res[Constant, module.Error] = module.add_constant(w.site.m, made);
        if (sel res_made.err) { ret res[ConstantData, refusal.Error].err{refusal.Error.ir{res_made.err}}; }
        res_lanes.ok[k] = res_made.ok;
        k               = k + 1;
    }
    ret res[ConstantData, refusal.Error].ok{ConstantData.aggregate{Aggregate{type: nt, elements: Slice[Constant]{data: res_lanes.ok, size: v.elements.size}}}};
}

# whether a format is computed by helpers alone: the build holds none that
# computes it wider
fun soft_only(w: *Work, f: Format) bool {
    val p: Plan = w.plans[f];
    ret p.soft && sel p.basic.none;
}

# the formats a reinterpreting conversion reads and gives
fun reformats(w: *Work, d: *InstructionData, from: *Format, to: *Format) bool {
    val opt_format_of:         opt[Format] = format_of(w, type_of(w, d.operands.data[0]));
    val opt_format_of_type_of: opt[Format] = format_of(w, type_of(w, d.results.data[0]));
    if (sel opt_format_of.none)         { ret false; }
    if (sel opt_format_of_type_of.none) { ret false; }
    @from = opt_format_of.some;
    @to   = opt_format_of_type_of.some;
    ret true;
}

# whether an instruction is rewritten as a helper call on encodings: an
# operation whose format no held one computes, or a conversion between formats
# one of which only the helpers compute, or both of which the pass computes
fun soft_rewrites(w: *Work, d: *InstructionData, rw: Rewrite) bool {
    if (sel rw.how.none || sel rw.how.recast || sel rw.how.held) { ret false; }
    if (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = 0;
        var to:   Format = 0;
        if (!reformats(w, d, ?from, ?to))           { ret false; }
        if (soft_only(w, from) || soft_only(w, to)) { ret true; }
        val opt_expanded:       opt[Format] = expanded(w, float(w, from));
        val opt_expanded_float: opt[Format] = expanded(w, float(w, to));
        ret sel opt_expanded.some && sel opt_expanded_float.some;
    }
    val p: Plan = w.plans[rw.format];
    if (!p.soft) { ret false; }
    val opt_computes_in: opt[Format] = computes_in(w, rw);
    ret sel opt_computes_in.none;
}

# the helper a soft rewrite calls, none for a sign operation, which is integer
# code on the encoding, or an operation no soft row computes
fun soft_want(w: *Work, d: *InstructionData, rw: Rewrite) opt[Want] {
    val opt_none: opt[Want]        = opt[Want].none{};
    val f:        Format           = rw.format;
    val bits:     u32              = row_of(f).width;
    val e:        fold_table.Entry = fold_table.entry(d.opcode);
    var want:     Want             = Want{operation: Operation.unstated{}, bits: bits, format: opt[Format].some{f}, space: 0, source: opt[Format].none{}};
    if (sel e.sign_unary || sel e.sign_binary) { ret opt_none; }
    if (sel rw.how.compute) {
        val opt_computing: opt[*table.Row] = table.computing(d.opcode);
        if (sel opt_computing.none) { ret opt_none; }
        want.operation = opt_computing.some.operation;
        ret opt[Want].some{want};
    }
    if (sel rw.how.compare) {
        want.operation = Operation.soft_compare{};
        ret opt[Want].some{want};
    }
    if (sel rw.how.to_float) {
        val res_width: res[u32, type_table.Error] = type_table.width(?w.site.m.types, type_of(w, d.operands.data[0]));
        if (sel res_width.err) { ret opt_none; }
        want.bits      = res_width.ok;
        want.operation = Operation.soft_from_u{};
        if (sel e.to_float) {
            if (e.to_float) { want.operation = Operation.soft_from_s{}; }
        }
        ret opt[Want].some{want};
    }
    if (sel rw.how.to_integer) {
        val res_width: res[u32, type_table.Error] = type_table.width(?w.site.m.types, type_of(w, d.results.data[0]));
        if (sel res_width.err) { ret opt_none; }
        want.bits      = res_width.ok;
        want.operation = Operation.soft_to_u{};
        if (sel e.to_integer) {
            if (e.to_integer) { want.operation = Operation.soft_to_s{}; }
        }
        ret opt[Want].some{want};
    }
    if (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = 0;
        var to:   Format = 0;
        if (!reformats(w, d, ?from, ?to)) { ret opt_none; }
        want.operation = Operation.soft_convert{};
        want.bits      = row_of(to).width;
        want.format    = opt[Format].some{to};
        want.source    = opt[Format].some{from};
        ret opt[Want].some{want};
    }
    ret opt_none;
}

# deliver every helper the function's soft rewrites call, before any is made,
# so reading a helper in moves no body the rewrite holds. a delivery may move
# the body being read, so it is read again after each
fun deliver_all(w: *Work, ar: *arena.Arena) err[refusal.Error] {
    var k: usize = 0;
    for (k < w.site.b.blocks.len) {
        if (!w.site.b.blocks.data[k].erased) {
            var n: Instruction = w.site.b.blocks.data[k].first;
            for (n != NO_INSTRUCTION) {
                arena.reset(ar);
                val d:  *InstructionData = ?w.site.b.instructions.data[n];
                val rw: Rewrite          = classify(w, d);
                if (soft_rewrites(w, d, rw)) {
                    val opt_want: opt[Want] = soft_want(w, d, rw);
                    if (sel opt_want.some) {
                        val res_deliver: res[Function, refusal.Error] = deliver.deliver(w.site.m, w.t, w.build, w.site.scratch, opt_want.some, timed(w));
                        if (sel res_deliver.err) { ret err[refusal.Error].err{res_deliver.err}; }
                        val res_body: res[*Body, module.Error] = module.body(w.site.m, w.site.f);
                        if (sel res_body.err) { ret err[refusal.Error].err{refusal.Error.ir{res_body.err}}; }
                        w.site.b = res_body.ok;
                    }
                }
                n = w.site.b.instructions.data[n].next;
            }
        }
        k = k + 1;
    }
    ret failure_of(w);
}

# a call of the helper a want asks for, delivered already, giving its result
fun helper_call(w: *Work, want: Want, args: *Value, count: usize) Value {
    val res_sig: res[Type, refusal.Error] = deliver.signature(w.site.m, want);
    if (sel res_sig.err) {
        fail(w, res_sig.err);
        ret 0;
    }
    val res_deliver: res[Function, refusal.Error] = deliver.deliver(w.site.m, w.t, w.build, w.site.scratch, want, timed(w));
    if (sel res_deliver.err) {
        fail(w, res_deliver.err);
        ret 0;
    }
    val res_ptr: res[Type, type_table.Error] = type_table.intern(?w.site.m.types, type_table.Shape.pointer{type_table.Pointer{space: 0}});
    if (sel res_ptr.err) {
        fail(w, refusal.Error.ir{module.Error.types{res_ptr.err}});
        ret 0;
    }
    val callee: Constant = builder.constant(?w.site.bld, ConstantData.address{Address{type: res_ptr.ok, symbol: Symbol.function{res_deliver.ok}, offset: 0, minus: opt[Symbol].none{}}});
    var ops:    [4]Value = [4]Value{builder.use_constant(?w.site.bld, callee), 0, 0, 0};
    var j:      usize    = 0;
    for (j < count && j < 3) {
        ops[j + 1] = args[j];
        j          = j + 1;
    }
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{res_sig.ok}, Immediate.named{Named.all{}}};
    ret made(w, opcode_table.CALL, ?ops[0], j + 1, ?imm[0], 2);
}

# rewrite an instruction as a helper call on the encodings of its operands, or
# a sign operation as integer code on them, its result reinterpreted as its
# format where it is a float
fun soft_rewrite(w: *Work, i: Instruction, c: *Copied, rw: Rewrite) err[refusal.Error] {
    val d:        *InstructionData = ?w.site.b.instructions.data[i];
    val e:        fold_table.Entry = fold_table.entry(c.code);
    val opt_want: opt[Want]        = soft_want(w, d, rw);
    val f:        Format           = rw.format;
    val nt:       Type             = encoding(w, f);
    val sign:     Wide             = pow2(row_of(f).width - 1);
    if (sel e.sign_unary || sel e.sign_binary) {
        emit.begin(?w.site, i);
        val a: Value = encoded(w, c.operands[0], f);
        var r: Value = a;
        if (c.code == opcode_table.FNEG) { r = op2(w, opcode_table.XOR, a, constant(w, nt, sign)); }
        or (c.code == opcode_table.FABS) { r = op2(w, opcode_table.AND, a, constant(w, nt, word.sub(sign, small(1)))); }
        or {
            val m: Value = op2(w, opcode_table.AND, a, constant(w, nt, word.sub(sign, small(1))));
            val s: Value = op2(w, opcode_table.AND, encoded(w, c.operands[1], f), constant(w, nt, sign));
            r = op2(w, opcode_table.OR, m, s);
        }
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, r, float(w, f));
        val err_built: err[refusal.Error] = emit.done(?w.site);
        if (sel err_built.err) { ret err_built; }
        ret failure_of(w);
    }
    if (sel opt_want.none) { ret err[refusal.Error].ok{}; }
    val wanted: Want = opt_want.some;
    var args:   [3]Value;
    emit.begin(?w.site, i);
    if (sel rw.how.to_float) {
        args[0] = c.operands[0];
        val r: Value = helper_call(w, wanted, ?args[0], 1);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, r, float(w, f));
    }
    or (sel rw.how.to_integer) {
        args[0] = encoded(w, c.operands[0], f);
        emit.end(?w.site, i);
        helper_call(w, wanted, ?args[0], 1);
    }
    or (sel rw.how.promote || sel rw.how.demote) {
        var from: Format = 0;
        var to:   Format = 0;
        if (!reformats(w, d, ?from, ?to)) { ret err[refusal.Error].ok{}; }
        args[0] = encoded(w, c.operands[0], from);
        val r: Value = helper_call(w, wanted, ?args[0], 1);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, r, type_of(w, c.result));
    }
    or (sel rw.how.compare) {
        args[0] = encoded(w, c.operands[0], f);
        args[1] = encoded(w, c.operands[1], f);
        val mask: Value = helper_call(w, wanted, ?args[0], 2);
        var bits: u64   = 0;
        if (sel e.float_compare) {
            if (e.float_compare.less)    { bits = bits | 1; }
            if (e.float_compare.equal)   { bits = bits | 2; }
            if (e.float_compare.greater) { bits = bits | 4; }
        }
        val opt_shape: opt[*opcode_row.Row] = opcode_table.at(c.code);
        if (sel opt_shape.some) {
            if (sel opt_shape.some.order.unordered) { bits = bits | 8; }
        }
        val i32t: Type  = integer(w, 32);
        val held: Value = op2(w, opcode_table.AND, mask, constant(w, i32t, small(bits)));
        emit.end(?w.site, i);
        op2(w, opcode_table.NE, held, constant(w, i32t, word.zero()));
    }
    or {
        var j: usize = 0;
        for (j < c.count) {
            args[j] = encoded(w, c.operands[j], f);
            j       = j + 1;
        }
        val r: Value = helper_call(w, wanted, ?args[0], c.count);
        emit.end(?w.site, i);
        cast(w, opcode_table.BITCAST, r, float(w, f));
    }
    val err_built: err[refusal.Error] = emit.done(?w.site);
    if (sel err_built.err) { ret err_built; }
    ret failure_of(w);
}
