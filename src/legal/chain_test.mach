# text tests of the compare chain, run through the driver

use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.legal.chain.CHAIN;
use mirl.legal.check_test.Text;
use mirl.legal.check_test.check_text;
use mirl.legal.check_test.put;
use mirl.legal.check_test.view;
use mirl.pass.record.Scope;
use mirl.pass.record.applies;
use targets: mirl.target;
use mirl.target.Target;

# a branch on three cases, two passing arguments, and a branch on none
#[testing]
fun before(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    switch %x, cases [1, 5, 9], ^other, ^one(%y), ^five, ^nine(%x)\n^other:\n    ret %x\n^one(%a: i32):\n    ret %a\n^five:\n    ret %y\n^nine(%b: i32):\n    ret %b\n}\nfunction @g: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    switch %x, cases [], ^out\n^out:\n    ret %x\n}\n");
}

# each case tested in its order, the first in the branch's block and each
# after it in a block of its own, the last going on to the first target, and
# the branch on no case a branch to its one target
#[testing]
fun after(t: *Text, row: *Target) {
    put(t, "target \"");
    put(t, row.name);
    put(t, "\"\nfunction @f: fun(i32, i32) -> (i32) linkage global visibility default {\n^entry(%x: i32, %y: i32):\n    %e1 = eq %x, i32 1\n    cbr %e1, ^one(%y), ^t5\n^other:\n    ret %x\n^one(%a: i32):\n    ret %a\n^five:\n    ret %y\n^nine(%b: i32):\n    ret %b\n^t5:\n    %e5 = eq %x, i32 5\n    cbr %e5, ^five, ^t9\n^t9:\n    %e9 = eq %x, i32 9\n    cbr %e9, ^nine(%x), ^other\n}\nfunction @g: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    br ^out\n^out:\n    ret %x\n}\n");
}

test chain__a_multi_way_branch_is_a_compare_chain_where_control_is_free {
    val row: opt[*Target] = targets.first(targets.leaves_control_free);
    if (!(sel row.some)) { ret 1; }
    var b: Text;
    var a: Text;
    b.len = 0;
    a.len = 0;
    before(?b, row.some);
    after(?a, row.some);
    if (check_text(row.some, ?CHAIN, view(?b), view(?a), true, Slice[str]{data: nil, size: 0}) != 0) { ret 2; }
    val kept: opt[*Target] = targets.first(targets.requires_structure);
    if (!(sel kept.some))                  { ret 3; }
    if (applies[Scope](?CHAIN, kept.some)) { ret 4; }
    if (!applies[Scope](?CHAIN, row.some)) { ret 5; }
    ret 0;
}
