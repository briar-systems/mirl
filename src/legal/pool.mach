# constants a target loads from read-only data in place of making them
#
# a held format whose row states its constants `loaded` has no rule that
# builds one in a register, as binary64 has none on a 32 bit RISC-V, and no
# register target builds a vector constant in a register, so every vector
# constant left after the vector legalisation is loaded on every target. a
# vector's lanes are integers of a byte or more, or floats, each a constant
# of bits or zero: a vector of conditions has no layout in memory its
# register form keeps, and an address in a lane has no bits to name it by.
# every use of such a constant, as an operand or an edge's argument, reads it
# instead from a global of the module: local, constant and initialised with
# the constant, one per type and bit pattern, named by mirl's prefix, the
# type and the bits, so every function of the module reads the same one. the
# load goes just ahead of the instruction that uses it, which an edge's
# argument is too, and is reached through the global's address constant, so
# the target's addressing selects it and the target's placement puts the
# global in read-only data.
#
# the load reads no value of the program and the constant is public, so the
# pass keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;

use mirl.build;
use mirl.ir.body;
use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.debug.Binding;
use mirl.ir.function.Body;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.linkage;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use types: mirl.ir.type;
use mirl.ir.type.Format;
use mirl.ir.type.Type;
use mirl.ir.value.ValueData;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.legal.helper.table.PREFIX;
use mirl.pass.analysis;
use mirl.pass.failure;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use targets: mirl.target;
use mirl.target.Held;
use mirl.target.Layout;
use mirl.target.basis;

use mink.model.symbol;

# the pass: it adds loads in front of the instructions that use the constants
# and never touches an edge or a block
pub val POOL: Pass = Pass{name: "constant pool", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: analysis.FLOW, time: Time.keeps{}, applies: wanted};

# a pooled constant is seen by its module alone
val POOLED: Linkage = Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.DEFAULT};

val TAKEN: str = "a symbol of the module has the name of a pooled constant and is not it";

# whether the build may meet a constant it loads: the target holds vectors in
# its units, or loads the constants of some format it holds, or a row's
# condition cannot be read, which the visit refuses
fun wanted(g: *Ground) bool {
    if (sel g.t.caps.vectors.units) { ret true; }
    var f: u32 = 0;
    for (f < types.rows()) {
        val h: res[opt[*Held], basis.Error] = basis.held(g.basis, ?g.t.caps, Format{index: f});
        if (sel h.err) { ret true; }
        if (sel h.ok.some) {
            if (sel h.ok.some.constants.loaded) { ret true; }
        }
        f = f + 1;
    }
    ret false;
}

# one visit
# ---
# c:       the run
# site:    where the loads are built
# layout:  the target's data layout
# pointer: the type of an address in the space of globals
# loaded:  for each format row, whether its constants are loaded
# changed: some use was rewritten
rec Visit {
    c:       *Context;
    site:    Site;
    layout:  Layout;
    pointer: Type;
    loaded:  *bool;
    changed: bool;
}

fun typed(e: types.Error) Why {
    ret Why.ir{module.Error.types{e}};
}

# a lane of a pooled vector, or a pooled float: its name and its width
# ---
# word:  the type's name, a float format's or `i` and an integer's width
# width: its bits
rec Lane {
    word:  View;
    width: u32;
}

# how a pooled constant is laid out for its name: its lanes, one for a float
# ---
# lane:   each lane's type
# lanes:  how many
# vector: it is a vector, named by its lanes
rec Form {
    lane:   Lane;
    lanes:  u32;
    vector: bool;
}

# the lane a scalar type is, where a pooled vector may hold it: an integer of
# a byte or more, or a float
fun lane_of(v: *Visit, ty: Type) res[opt[Lane], Why] {
    val shape: res[*types.Shape, types.Error] = types.shape_at(?v.c.m.types, ty);
    if (sel shape.err) { ret res[opt[Lane], Why].err{typed(shape.err)}; }
    if (sel shape.ok.float) {
        val row: opt[types.Row] = types.row(shape.ok.float.format);
        if (sel row.none) { ret res[opt[Lane], Why].err{typed(types.Error.format{shape.ok.float.format})}; }
        ret res[opt[Lane], Why].ok{opt[Lane].some{Lane{word: View{data: row.some.name, len: str_len(row.some.name)}, width: row.some.width}}};
    }
    if (sel shape.ok.integer) {
        if (shape.ok.integer.width < 8) { ret res[opt[Lane], Why].ok{opt[Lane].none{}}; }
        ret res[opt[Lane], Why].ok{opt[Lane].some{Lane{word: View{data: nil, len: 0}, width: shape.ok.integer.width}}};
    }
    ret res[opt[Lane], Why].ok{opt[Lane].none{}};
}

# how a constant of a value's type is pooled, none where it is not: a float of
# a loaded format, or a vector of lanes a pooled vector may hold
fun pooled(v: *Visit, ty: Type) res[opt[Form], Why] {
    val shape: res[*types.Shape, types.Error] = types.shape_at(?v.c.m.types, ty);
    if (sel shape.err) { ret res[opt[Form], Why].err{typed(shape.err)}; }
    if (sel shape.ok.float) {
        if (!v.loaded[shape.ok.float.format.index]) { ret res[opt[Form], Why].ok{opt[Form].none{}}; }
        val l: res[opt[Lane], Why] = lane_of(v, ty);
        if (sel l.err)     { ret res[opt[Form], Why].err{l.err}; }
        if (sel l.ok.none) { ret res[opt[Form], Why].ok{opt[Form].none{}}; }
        ret res[opt[Form], Why].ok{opt[Form].some{Form{lane: l.ok.some, lanes: 1, vector: false}}};
    }
    if (sel shape.ok.vector) {
        val lanes: u32                 = shape.ok.vector.lanes;
        val l:     res[opt[Lane], Why] = lane_of(v, shape.ok.vector.element);
        if (sel l.err)     { ret res[opt[Form], Why].err{l.err}; }
        if (sel l.ok.none) { ret res[opt[Form], Why].ok{opt[Form].none{}}; }
        ret res[opt[Form], Why].ok{opt[Form].some{Form{lane: l.ok.some, lanes: lanes, vector: true}}};
    }
    ret res[opt[Form], Why].ok{opt[Form].none{}};
}

# a pooled constant an instruction reads
# ---
# value:    the value that stands for it
# constant: the constant
# form:     how it is laid out for its name
# type:     its type
rec Pooled {
    value:    Value;
    constant: Constant;
    form:     Form;
    type:     Type;
}

# the constant a value stands for, where it is one the target loads and every
# lane of it has bits
fun constant_of(v: *Visit, x: Value) res[opt[Pooled], Why] {
    val d: *ValueData = ?v.site.b.values.data[x.index];
    if (!(sel d.def.constant))                     { ret res[opt[Pooled], Why].ok{opt[Pooled].none{}}; }
    if (module.specialized(v.c.m, d.def.constant)) { ret res[opt[Pooled], Why].ok{opt[Pooled].none{}}; }
    val f: res[opt[Form], Why] = pooled(v, d.type);
    if (sel f.err)                        { ret res[opt[Pooled], Why].err{f.err}; }
    if (sel f.ok.none)                    { ret res[opt[Pooled], Why].ok{opt[Pooled].none{}}; }
    if (!all_bits(v.c.m, d.def.constant)) { ret res[opt[Pooled], Why].ok{opt[Pooled].none{}}; }
    ret res[opt[Pooled], Why].ok{opt[Pooled].some{Pooled{value: x, constant: d.def.constant, form: f.ok.some, type: d.type}}};
}

# whether a constant is bits or zero, or an aggregate of lanes each bits or zero
fun all_bits(m: *Module, c: Constant) bool {
    val got: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel got.err) { ret false; }
    val d: ConstantData = got.ok;
    if (sel d.integer || sel d.float || sel d.zero) { ret true; }
    if (!(sel d.aggregate))                         { ret false; }
    var i: usize = 0;
    for (i < d.aggregate.elements.size) {
        val lane: res[ConstantData, module.Error] = module.constant_data(m, d.aggregate.elements.data[i]);
        if (sel lane.err)                                                    { ret false; }
        if (!(sel lane.ok.integer || sel lane.ok.float || sel lane.ok.zero)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun digit(n: u64) u8 {
    if (n < 10) { ret ('0'::u64 + n)::u8; }
    ret ('a'::u64 + n - 10)::u8;
}

# the bits of a scalar constant, its words from the lowest
fun bits_of(m: *Module, c: Constant) res[Slice[u64], Why] {
    val got: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel got.err)        { ret res[Slice[u64], Why].err{Why.ir{got.err}}; }
    if (sel got.ok.float)   { ret res[Slice[u64], Why].ok{got.ok.float.words}; }
    if (sel got.ok.integer) { ret res[Slice[u64], Why].ok{got.ok.integer.words}; }
    if (sel got.ok.zero)    { ret res[Slice[u64], Why].ok{Slice[u64]{data: nil, size: 0}}; }
    ret res[Slice[u64], Why].err{Why.reason{"a pooled lane that is neither bits nor zero"}};
}

# the constant of lane `i` of a pooled constant of `lanes` lanes, which a zero
# vector has none of
fun lane_at(m: *Module, c: Constant, lanes: u32, i: u32) res[opt[Constant], Why] {
    if (lanes == 1) { ret res[opt[Constant], Why].ok{opt[Constant].some{c}}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel got.err)     { ret res[opt[Constant], Why].err{Why.ir{got.err}}; }
    if (sel got.ok.zero) { ret res[opt[Constant], Why].ok{opt[Constant].none{}}; }
    if (sel got.ok.aggregate) {
        if (i::usize < got.ok.aggregate.elements.size) { ret res[opt[Constant], Why].ok{opt[Constant].some{got.ok.aggregate.elements.data[i]}}; }
    }
    ret res[opt[Constant], Why].err{Why.reason{"a pooled vector whose lanes are not one constant each"}};
}

# the bits of lane `i` of a pooled constant, its words from the lowest
fun lane_bits(m: *Module, c: Constant, lanes: u32, i: u32) res[Slice[u64], Why] {
    val at: res[opt[Constant], Why] = lane_at(m, c, lanes, i);
    if (sel at.err)     { ret res[Slice[u64], Why].err{at.err}; }
    if (sel at.ok.none) { ret res[Slice[u64], Why].ok{Slice[u64]{data: nil, size: 0}}; }
    ret bits_of(m, at.ok.some);
}

# whether two pooled constants of one form have the same bits in every lane,
# which two constants of the module may have
fun same_lanes(m: *Module, l: Form, a: Constant, b: Constant) res[bool, Why] {
    if (a.index == b.index) { ret res[bool, Why].ok{true}; }
    var i: u32 = 0;
    for (i < l.lanes) {
        val x: res[Slice[u64], Why] = lane_bits(m, a, l.lanes, i);
        if (sel x.err) { ret res[bool, Why].err{x.err}; }
        val y: res[Slice[u64], Why] = lane_bits(m, b, l.lanes, i);
        if (sel y.err)               { ret res[bool, Why].err{y.err}; }
        if (!same_words(x.ok, y.ok)) { ret res[bool, Why].ok{false}; }
        i = i + 1;
    }
    ret res[bool, Why].ok{true};
}

# whether two lists of words hold the same bits, the shorter zero above
fun same_words(x: Slice[u64], y: Slice[u64]) bool {
    var n: usize = x.size;
    if (y.size > n) { n = y.size; }
    var i: usize = 0;
    for (i < n) {
        var p: u64 = 0;
        var q: u64 = 0;
        if (i < x.size) { p = x.data[i]; }
        if (i < y.size) { q = y.data[i]; }
        if (p != q)     { ret false; }
        i = i + 1;
    }
    ret true;
}

# the count of decimal digits of `n`
fun decimals(n: u64) usize {
    var k: usize = 1;
    var x: u64   = n;
    for (x >= 10) {
        x = x / 10;
        k = k + 1;
    }
    ret k;
}

# write `n` in decimal at `out`, `k` digits
fun decimal(out: *u8, n: u64, k: usize) {
    var x: u64   = n;
    var i: usize = k;
    for (i > 0) {
        i      = i - 1;
        out[i] = digit(x % 10);
        x      = x / 10;
    }
}

# the name of the global a constant is read from: the prefix, then for a
# vector `v` and its lane count and `_`, then the lane type's name, a float
# format's or `i` and an integer's width, then `_` and every lane's bits in
# hex, the last lane first and each from its top
fun name_of(v: *Visit, l: Form, c: Constant) res[View, Why] {
    val digits: usize = ((l.lane.width + 3) / 4)::usize;
    val head:   usize = str_len(PREFIX);
    var count:  usize = 0;
    if (l.vector) { count = 1 + decimals(l.lanes::u64) + 1; }
    var word: usize = l.lane.word.len;
    if (word == 0) { word = 1 + decimals(l.lane.width::u64); }
    val n:   usize                     = head + count + word + 1 + digits * l.lanes::usize;
    val got: res[*u8, allocator.Error] = allocator.zallocate[u8](v.site.scratch, n);
    if (sel got.err) { ret res[View, Why].err{Why.alloc{got.err}}; }
    val out: *u8   = got.ok;
    var at:  usize = 0;
    var i:   usize = 0;
    for (i < head) {
        out[at] = PREFIX[i];
        at      = at + 1;
        i       = i + 1;
    }
    if (l.vector) {
        out[at] = 'v';
        decimal(?out[at + 1], l.lanes::u64, count - 2);
        at          = at + count;
        out[at - 1] = '_';
    }
    if (l.lane.word.len == 0) {
        out[at] = 'i';
        decimal(?out[at + 1], l.lane.width::u64, word - 1);
    }
    or {
        i = 0;
        for (i < word) {
            out[at + i] = l.lane.word.data[i];
            i           = i + 1;
        }
    }
    at      = at + word;
    out[at] = '_';
    at      = at + 1;
    var lane: u32 = l.lanes;
    for (lane > 0) {
        lane = lane - 1;
        val words: res[Slice[u64], Why] = lane_bits(v.c.m, c, l.lanes, lane);
        if (sel words.err) { ret res[View, Why].err{words.err}; }
        var k: usize = 0;
        for (k < digits) {
            val top:  usize = digits - 1 - k;
            var bits: u64   = 0;
            if (top / 16 < words.ok.size) { bits = words.ok.data[top / 16]; }
            out[at] = digit((bits >> ((top % 16) * 4)::u64) & 0xf);
            at      = at + 1;
            k       = k + 1;
        }
    }
    ret res[View, Why].ok{View{data: out, len: n}};
}

# the global a constant is read from, added to the module the first time
fun global_of(v: *Visit, l: Form, c: Constant, ty: Type) res[Global, Why] {
    val name: res[View, Why] = name_of(v, l, c);
    if (sel name.err) { ret res[Global, Why].err{name.err}; }
    val found: opt[Symbol] = module.find(v.c.m, name.ok);
    if (sel found.some) {
        if (!(sel found.some.global)) { ret res[Global, Why].err{Why.reason{TAKEN}}; }
        val g:    Global                        = found.some.global;
        val data: res[GlobalData, module.Error] = module.global_data(v.c.m, g);
        if (sel data.err) { ret res[Global, Why].err{Why.ir{data.err}}; }
        val held: GlobalData = data.ok;
        val same: bool       = held.constant && types.same(held.type, ty) && linkage.same(held.linkage, POOLED);
        if (sel held.initial.some) {
            val equal: res[bool, Why] = same_lanes(v.c.m, l, held.initial.some, c);
            if (sel equal.err)    { ret res[Global, Why].err{equal.err}; }
            if (same && equal.ok) { ret res[Global, Why].ok{g}; }
        }
        ret res[Global, Why].err{Why.reason{TAKEN}};
    }
    val data: GlobalData                = GlobalData{name: name.ok, type: ty, initial: opt[Constant].some{c}, linkage: POOLED, constant: true, debug: opt[Binding].none{}};
    val made: res[Global, module.Error] = module.add_global(v.c.m, data);
    if (sel made.err) { ret res[Global, Why].err{Why.ir{made.err}}; }
    ret res[Global, Why].ok{made.ok};
}

# a load of a constant from its global, ahead of the instruction at an index of
# a block, which then reads the load in place of the constant
fun read(v: *Visit, k: Block, n: u32, i: Instruction, p: Pooled) res[u32, Why] {
    val ty: Type             = p.type;
    val g:  res[Global, Why] = global_of(v, p.form, p.constant, ty);
    if (sel g.err) { ret res[u32, Why].err{g.err}; }
    val align: res[u64, targets.Error] = targets.align(?v.layout, ty, types.DEFAULT_SPACE);
    if (sel align.err) { ret res[u32, Why].err{Why.reason{"the data layout states no alignment of a pooled constant's type"}}; }

    val s: *Site = ?v.site;
    emit.open(s, i, k, n);
    val address: Constant     = build.constant(?s.bld, ConstantData.address{Address{type: v.pointer, symbol: Symbol.global{g.ok}, offset: 0}});
    var ops:     [1]Value     = [1]Value{build.use_constant(?s.bld, address)};
    var imm:     [2]Immediate = [2]Immediate{Immediate.ty{ty}, Immediate.alignment{align.ok}};
    val load:    Instruction  = emit.make(s, opcode.LOAD, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 2});
    val got:     Value        = emit.result(s, load, 0);
    val built:   err[Why]     = emit.done(s);
    if (sel built.err) { ret res[u32, Why].err{built.err}; }
    val swapped: err[Why] = failure.edit(body.substitute(v.c.m, s.f, i, p.value, got));
    if (sel swapped.err) { ret res[u32, Why].err{swapped.err}; }
    v.changed = true;
    ret res[u32, Why].ok{s.made};
}

# the next pooled constant an instruction reads, as an operand or an edge
# argument, from a slot on: a rewrite takes every use of it in the
# instruction, so the walk never meets one twice
# ---
# slot: the operands then every edge's arguments, counted in order
fun next(v: *Visit, i: Instruction, slot: *usize) res[opt[Pooled], Why] {
    val d:     *InstructionData = ?v.site.b.instructions.data[i.index];
    var count: usize            = d.operands.len;
    var e:     usize            = 0;
    for (e < d.edges.len) {
        count = count + d.edges.data[e].arguments.len;
        e     = e + 1;
    }
    for (@slot < count) {
        var x:  Value = Value{index: 0};
        val at: usize = @slot;
        if (at < d.operands.len) { x = d.operands.data[at]; }
        or {
            var rest: usize = at - d.operands.len;
            e = 0;
            for (rest >= d.edges.data[e].arguments.len) {
                rest = rest - d.edges.data[e].arguments.len;
                e    = e + 1;
            }
            x = d.edges.data[e].arguments.data[rest];
        }
        @slot = at + 1;
        val c: res[opt[Pooled], Why] = constant_of(v, x);
        if (sel c.err)     { ret c; }
        if (sel c.ok.some) { ret c; }
    }
    ret res[opt[Pooled], Why].ok{opt[Pooled].none{}};
}

# read every pooled constant one function uses from its global
fun visit(u: *Unit) res[bool, Why] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }
    val pointer: res[Type, types.Error] = types.intern(?c.m.types, types.Shape.pointer{types.Pointer{space: 0}});
    if (sel pointer.err) { ret res[bool, Why].err{typed(pointer.err)}; }

    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, Why].err{Why.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    val rows:   usize                       = types.rows()::usize;
    val loaded: res[*bool, allocator.Error] = allocator.zallocate[bool](c.m.a, rows);
    if (sel loaded.err) { ret res[bool, Why].err{Why.alloc{loaded.err}}; }
    fin { allocator.deallocate[bool](c.m.a, loaded.ok, rows); }
    var r: usize = 0;
    for (r < rows) {
        val h: res[opt[*Held], basis.Error] = basis.held(c.basis, ?c.t.caps, Format{index: r::u32});
        if (sel h.err) { ret res[bool, Why].err{Why.condition{h.err}}; }
        loaded.ok[r] = sel h.ok.some && sel h.ok.some.constants.loaded;
        r            = r + 1;
    }

    var v: Visit = Visit{c: c, site: emit.init(c.m, u.f, got.ok, ?scratch), layout: targets.of(c.t, ?c.m.types, basis.context_of(c.basis)), pointer: pointer.ok, loaded: loaded.ok, changed: false};
    val b: *Body = got.ok;
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var n: usize = 0;
            for (n < b.blocks.data[k].instructions.len) {
                val i:    Instruction = b.blocks.data[k].instructions.data[n];
                var slot: usize       = 0;
                for {
                    arena.reset(?ar);
                    val x: res[opt[Pooled], Why] = next(?v, i, ?slot);
                    if (sel x.err)     { ret res[bool, Why].err{x.err}; }
                    if (sel x.ok.none) { brk; }
                    val at: res[u32, Why] = read(?v, Block{index: k::u32}, n::u32, i, x.ok.some);
                    if (sel at.err) { ret res[bool, Why].err{at.err}; }
                    n = n + at.ok::usize;
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret res[bool, Why].ok{v.changed};
}
