# tests of the abi legalisation: entries, calls and returns in, piece form out,
# as ir text

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use io_writer: std.io.writer;
use diag:      std.print;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.legal.abi.ABI;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.failure.Why;
use targets: mirl.target;
use mirl.target.Target;
use verify_failure: mirl.verify.failure;

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# say why a run refused, for a failing test's output
#[testing]
fun report(e: Error) {
    if (sel e.unverified) {
        val v: verify_failure.Error = e.unverified.error;
        if (sel v.refused) { diag.eprintlnf("unverified: {}", v.refused.what); }
        ret;
    }
    if (sel e.input) {
        diag.eprintlnf("input unverified: {}", e.input.what);
        ret;
    }
    if (!(sel e.refused)) {
        diag.eprintln("the run failed");
        ret;
    }
    val why: Why = e.refused.why;
    if (sel why.reason)     { diag.eprintlnf("refused: {}", why.reason); }
    or (sel why.machine)    { diag.eprintln("refused: no machine"); }
    or (sel why.convention) { diag.eprintln("refused: not classified"); }
    or (sel why.pieces)     { diag.eprintln("refused: not carried in pieces"); }
    or (sel why.build)      { diag.eprintln("refused: the builder stopped"); }
    or (sel why.ir) {
        val x: module.Error = why.ir;
        if (sel x.mismatch)    { diag.eprintln("refused: ir mismatch"); }
        or (sel x.secret)      { diag.eprintln("refused: ir secret"); }
        or (sel x.used)        { diag.eprintln("refused: ir used"); }
        or (sel x.value)       { diag.eprintln("refused: ir value"); }
        or (sel x.typing)      { diag.eprintln("refused: ir typing"); }
        or (sel x.parameter)   { diag.eprintln("refused: ir parameter"); }
        or (sel x.terminator)  { diag.eprintln("refused: ir terminator"); }
        or (sel x.instruction) { diag.eprintln("refused: ir instruction"); }
        or (sel x.lowered)     { diag.eprintln("refused: ir lowered"); }
        or (sel x.types)       { diag.eprintln("refused: ir types"); }
        or (sel x.alloc)       { diag.eprintln("refused: ir alloc"); }
        or (sel x.position)    { diag.eprintln("refused: ir position"); }
        or (sel x.placed)      { diag.eprintln("refused: ir placed"); }
        or (sel x.detached)    { diag.eprintln("refused: ir detached"); }
        or (sel x.erased)      { diag.eprintln("refused: ir erased"); }
        or (sel x.incoming)    { diag.eprintln("refused: ir incoming"); }
        or (sel x.name)        { diag.eprintln("refused: ir name"); }
        or (sel x.constant)    { diag.eprintln("refused: ir constant"); }
        or (sel x.words)       { diag.eprintln("refused: ir words"); }
        or (sel x.block)       { diag.eprintln("refused: ir block"); }
        or                     { diag.eprintln("refused: ir"); }
    }
    or { diag.eprintln("refused"); }
}

# print a module's text, for a failing test's output
#[testing]
fun show(a: *allocator.Allocator, m: *Module) {
    var s: sink.Sink = sink.init(a);
    fin { sink.dnit(?s); }
    var w: io_writer.Writer = sink.writer(?s);
    text.print(?w, m);
    val v:   View  = sink.view(?s);
    var buf: [16384]u8;
    var i:   usize = 0;
    for (i < v.len && i + 1 < 16384) {
        buf[i] = v.data[i];
        i      = i + 1;
    }
    buf[i] = 0;
    diag.eprint(?buf[0]);
}

# run the pass over a module's text, and compare what it leaves with the text
# expected, by structure
#[testing]
fun lowered(before: str, after: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val parsed: res[Module, Refusal] = parse_body(?a, view_of(before));
    if (sel parsed.err) { ret 1; }
    var got: Module = parsed.ok;
    fin { module.dnit(?got); }
    val row: opt[*Target] = targets.by_name(module.target(?got));
    if (sel row.none) { ret 2; }
    var d: Driver = driver.init(?got, row.some, Options{level: 0, checked: true});
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?ABI);
    if (sel ran.err) {
        report(ran.err);
        ret 3;
    }
    val wanted: res[Module, Refusal] = parse_body(?a, view_of(after));
    if (sel wanted.err) {
        show(?a, ?got);
        ret 4;
    }
    var want: Module = wanted.ok;
    fin { module.dnit(?want); }
    val same: res[bool, printer.Error] = equal.same(?got, ?want);
    if (sel same.err) { ret 5; }
    if (!same.ok) {
        show(?a, ?got);
        ret 6;
    }
    ret 0;
}

# a call, an entry and a return of scalars, an aggregate split across an integer
# and a float register, and an aggregate passed by reference
#[testing]
val CALLS:        str = "target \"riscv64-linux\"\nfunction @callee: fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64})\nfunction @caller: fun(ptr, ptr) -> (i64) {\n^entry(%p: ptr, %q: ptr):\n    %s = load %p, type struct{i64, binary64}, align 8\n    %b = load %q, type struct{i64, i64, i64}, align 8\n    %r = call ptr @callee, i64 7, %s, %b, signature fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64}), named all\n    store %q, %r, align 8\n    ret i64 0\n}\nfunction @pair: fun(struct{i64, binary64}, binary32) -> (struct{i64, i64}) {\n^entry(%s: struct{i64, binary64}, %f: binary32):\n    %h = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %h, %s, align 8\n    %v = load %h, type struct{i64, i64}, align 8\n    ret %v\n}\n";
#[testing]
val CALLS_PIECES: str = "target \"riscv64-linux\"\n\nfunction @callee: fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64})\n\nfunction @caller: fun(ptr, ptr) -> (i64) placed [register 0 10 fixed exact, register 0 11 fixed exact] {\n^entry(%p: ptr, %q: ptr):\n    %0 = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    %1 = alloca type struct{i64, i64}, pointer ptr, align 8\n    %2 = load %p, type i64, align 8\n    %3 = ptr.add %p, i64 8\n    %4 = load %3, type binary64, align 8\n    %5 = load %q, type i64, align 8\n    store %0, %5, align 8\n    %6 = ptr.add %q, i64 8\n    %7 = ptr.add %0, i64 8\n    %8 = load %6, type i64, align 8\n    store %7, %8, align 8\n    %9 = ptr.add %q, i64 16\n    %10 = ptr.add %0, i64 16\n    %11 = load %9, type i64, align 8\n    store %10, %11, align 8\n    %12, %13 = call.placed ptr @callee, i64 7, %2, %4, %0, signature fun(i64, i64, binary64, ptr) -> (i64, i64), places [register 0 10 fixed exact, register 0 11 fixed undefined, register 1 10 fixed exact, register 0 12 fixed exact, register 0 10 fixed exact, register 0 11 fixed exact]\n    store %1, %12, align 8\n    %14 = ptr.add %1, i64 8\n    store %14, %13, align 8\n    %15 = load %1, type struct{i64, i64}, align 8\n    store %q, %15, align 8\n    ret.placed i64 0, places [register 0 10 fixed exact]\n}\n\nfunction @pair: fun(struct{i64, binary64}, binary32) -> (struct{i64, i64}) placed [register 0 10 fixed undefined, register 1 10 fixed exact, register 1 11 fixed boxed] {\n^entry(%0: i64, %1: binary64, %f: binary32):\n    %2 = alloca type struct{i64, binary64}, pointer ptr, align 8\n    store %2, %0, align 8\n    %3 = ptr.add %2, i64 8\n    store %3, %1, align 8\n    %4 = load %2, type struct{i64, binary64}, align 8\n    %h = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %h, %4, align 8\n    %5 = load %h, type i64, align 8\n    %6 = ptr.add %h, i64 8\n    %7 = load %6, type i64, align 8\n    ret.placed %5, %7, places [register 0 10 fixed exact, register 0 11 fixed exact]\n}\n";

# a result wider than two words, returned through the slot whose address the
# call passes in the carrier register
#[testing]
val INDIRECT:        str = "target \"riscv64-linux\"\nfunction @big: fun(i64) -> (struct{i64, i64, i64})\nfunction @user: fun(ptr) -> () {\n^entry(%q: ptr):\n    %r = call ptr @big, i64 1, signature fun(i64) -> (struct{i64, i64, i64}), named all\n    store %q, %r, align 8\n    ret\n}\n";
#[testing]
val INDIRECT_PIECES: str = "target \"riscv64-linux\"\n\nfunction @big: fun(i64) -> (struct{i64, i64, i64})\n\nfunction @user: fun(ptr) -> () placed [register 0 10 fixed exact] {\n^entry(%q: ptr):\n    %0 = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    call.placed ptr @big, %0, i64 1, signature fun(ptr, i64) -> (), places [register 0 10 fixed exact, register 0 11 fixed exact]\n    %1 = load %0, type struct{i64, i64, i64}, align 8\n    store %q, %1, align 8\n    ret.placed places []\n}\n";

# a call with one named argument, its unnamed float and integer placed as the
# convention places unnamed values
#[testing]
val VARIADIC:        str = "target \"riscv64-linux\"\nfunction @print: fun(ptr, binary64, i32) -> (i32)\nfunction @user: fun(ptr) -> (i32) {\n^entry(%fmt: ptr):\n    %n = call ptr @print, %fmt, binary64 0x4000000000000000, i32 3, signature fun(ptr, binary64, i32) -> (i32), named 1\n    ret %n\n}\n";
#[testing]
val VARIADIC_PIECES: str = "target \"riscv64-linux\"\n\nfunction @print: fun(ptr, binary64, i32) -> (i32)\n\nfunction @user: fun(ptr) -> (i32) placed [register 0 10 fixed exact] {\n^entry(%fmt: ptr):\n    %0 = bitcast binary64 0x4000000000000000, to i64\n    %1 = ext.s i32 3, to i64\n    %2 = call.placed ptr @print, %fmt, %0, %1, signature fun(ptr, i64, i64) -> (i64), places [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact, register 0 10 fixed exact]\n    %3 = trunc %2, to i32\n    %4 = ext.s %3, to i64\n    ret.placed %4, places [register 0 10 fixed exact]\n}\n";

# a bound parameter split across registers and a bound result returned by
# reference
#[testing]
val BOUND:        str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"Pair\" \"Pair\" structure struct{i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1}\n!t2 = type \"Big\" \"Big\" structure struct{i64, i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1, \"c\": !t0 field 2}\n!v0 = variable \"p\" !t1 declared !l0 parameter 0\n!v1 = variable \"r\" !t2 declared !l0\nfunction @f: fun(struct{i64, i64}) -> (struct{i64, i64, i64}) {\n^entry(%p: struct{i64, i64}):\n    bind !v0 = %p\n    %slot = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    store %slot, %p, align 8\n    %r = load %slot, type struct{i64, i64, i64}, align 8\n    bind !v1 = %r\n    ret %r\n}\n";
#[testing]
val BOUND_PIECES: str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"Pair\" \"Pair\" structure struct{i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1}\n!t2 = type \"Big\" \"Big\" structure struct{i64, i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1, \"c\": !t0 field 2}\n!v0 = variable \"p\" !t1 declared !l0 parameter 0\n!v1 = variable \"r\" !t2 declared !l0\n\nfunction @f: fun(struct{i64, i64}) -> (struct{i64, i64, i64}) placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%0: ptr, %1: i64, %2: i64):\n    %3 = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %3, %1, align 8\n    %4 = ptr.add %3, i64 8\n    store %4, %2, align 8\n    %5 = load %3, type struct{i64, i64}, align 8\n    bind !v0 = %5\n    %slot = alloca type struct{i64, i64, i64}, pointer ptr, align 8 bind [!v1]\n    store %slot, %5, align 8\n    %6 = load %slot, type i64, align 8\n    store %0, %6, align 8\n    %7 = ptr.add %slot, i64 8\n    %8 = ptr.add %0, i64 8\n    %9 = load %7, type i64, align 8\n    store %8, %9, align 8\n    %10 = ptr.add %slot, i64 16\n    %11 = ptr.add %0, i64 16\n    %12 = load %10, type i64, align 8\n    store %11, %12, align 8\n    ret.placed places []\n}\n";

test abi__entry_call_and_return_travel_in_their_pieces {
    ret lowered(CALLS, CALLS_PIECES);
}

test abi__an_indirect_result_lands_in_the_slot_the_carrier_names {
    ret lowered(INDIRECT, INDIRECT_PIECES);
}

test abi__unnamed_arguments_travel_where_the_convention_places_them {
    ret lowered(VARIADIC, VARIADIC_PIECES);
}

test abi__every_binding_survives_the_pieces {
    ret lowered(BOUND, BOUND_PIECES);
}
