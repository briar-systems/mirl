# tests of the abi legalisation: entries, calls and returns in, piece form out,
# as ir text

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use io_writer: std.io.writer;
use diag:      std.print;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.legal.abi.ABI;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.failure.Why;
use targets: mirl.target;
use mirl.target.Target;
use mirl.target.machine;
use mirl.target.machine.Build;
use mirl.target.machine.Machine;
use mirl.target.record.Baseline;
use verify_failure: mirl.verify.failure;

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# say why a run refused, for a failing test's output
#[testing]
fun report(e: Error) {
    if (sel e.unverified) {
        val v: verify_failure.Error = e.unverified.error;
        if (sel v.refused) { diag.eprintlnf("unverified: {}", v.refused.what); }
        ret;
    }
    if (sel e.input) {
        diag.eprintlnf("input unverified: {}", e.input.what);
        ret;
    }
    if (!(sel e.refused)) {
        diag.eprintln("the run failed");
        ret;
    }
    val why: Why = e.refused.why;
    if (sel why.reason)     { diag.eprintlnf("refused: {}", why.reason); }
    or (sel why.unmachined) { diag.eprintln("refused: the run carries no machine"); }
    or (sel why.convention) { diag.eprintln("refused: not classified"); }
    or (sel why.pieces)     { diag.eprintln("refused: not carried in pieces"); }
    or (sel why.build)      { diag.eprintln("refused: the builder stopped"); }
    or (sel why.ir) {
        val x: module.Error = why.ir;
        if (sel x.mismatch)    { diag.eprintln("refused: ir mismatch"); }
        or (sel x.secret)      { diag.eprintln("refused: ir secret"); }
        or (sel x.used)        { diag.eprintln("refused: ir used"); }
        or (sel x.value)       { diag.eprintln("refused: ir value"); }
        or (sel x.typing)      { diag.eprintln("refused: ir typing"); }
        or (sel x.parameter)   { diag.eprintln("refused: ir parameter"); }
        or (sel x.terminator)  { diag.eprintln("refused: ir terminator"); }
        or (sel x.instruction) { diag.eprintln("refused: ir instruction"); }
        or (sel x.lowered)     { diag.eprintln("refused: ir lowered"); }
        or (sel x.types)       { diag.eprintln("refused: ir types"); }
        or (sel x.alloc)       { diag.eprintln("refused: ir alloc"); }
        or (sel x.position)    { diag.eprintln("refused: ir position"); }
        or (sel x.placed)      { diag.eprintln("refused: ir placed"); }
        or (sel x.detached)    { diag.eprintln("refused: ir detached"); }
        or (sel x.erased)      { diag.eprintln("refused: ir erased"); }
        or (sel x.incoming)    { diag.eprintln("refused: ir incoming"); }
        or (sel x.name)        { diag.eprintln("refused: ir name"); }
        or (sel x.constant)    { diag.eprintln("refused: ir constant"); }
        or (sel x.words)       { diag.eprintln("refused: ir words"); }
        or (sel x.block)       { diag.eprintln("refused: ir block"); }
        or                     { diag.eprintln("refused: ir"); }
    }
    or { diag.eprintln("refused"); }
}

# print a module's text, for a failing test's output
#[testing]
fun show(a: *allocator.Allocator, m: *Module) {
    var s: sink.Sink = sink.init(a);
    fin { sink.dnit(?s); }
    var w: io_writer.Writer = sink.writer(?s);
    text.print(?w, m);
    val v:   View  = sink.view(?s);
    var buf: [16384]u8;
    var i:   usize = 0;
    for (i < v.len && i + 1 < 16384) {
        buf[i] = v.data[i];
        i      = i + 1;
    }
    buf[i] = 0;
    diag.eprint(?buf[0]);
}

# run the pass over a module's text, and compare what it leaves with the text
# expected, by structure
#[testing]
fun lowered(before: str, after: str) i32 {
    ret lowered_by(before, after, opt[str].none{}, Slice[str]{data: nil, size: 0});
}

# run the pass over a module's text for the machine a build opens, and compare
# what it leaves with the text expected, by structure
# ---
# baseline: the baseline the build's target states in place of its row's, none for the row's own
# added:    the extensions the build adds to it
# ret:      0, or 7 when the build's machine was not made
#[testing]
fun lowered_by(before: str, after: str, baseline: opt[str], added: Slice[str]) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val parsed: res[Module, Refusal] = parse_body(?a, view_of(before));
    if (sel parsed.err) { ret 1; }
    var got: Module = parsed.ok;
    fin { module.dnit(?got); }
    val row: opt[*Target] = targets.by_name(module.target(?got));
    if (sel row.none) { ret 2; }
    var t: Target = @row.some;
    if (sel baseline.some) { t.baseline = Baseline.extensions{baseline.some}; }
    var mc:   Machine;
    val held: res[Build, machine.Error] = machine.build(?mc, ?a, ?t, added);
    if (sel held.err) { ret 7; }
    fin { machine.release(held.ok); }
    if (sel held.ok.machine.none) { ret 8; }
    val started: res[Driver, Error] = driver.init(?got, ?t, held.ok, Options{level: 0, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?ABI);
    if (sel ran.err) {
        report(ran.err);
        ret 3;
    }
    val wanted: res[Module, Refusal] = parse_body(?a, view_of(after));
    if (sel wanted.err) {
        show(?a, ?got);
        ret 4;
    }
    var want: Module = wanted.ok;
    fin { module.dnit(?want); }
    val same: res[bool, printer.Error] = equal.same(?got, ?want);
    if (sel same.err) { ret 5; }
    if (!same.ok) {
        show(?a, ?got);
        ret 6;
    }
    ret 0;
}

# a call, an entry and a return of scalars, an aggregate split across an integer
# and a float register, and an aggregate passed by reference
#[testing]
val CALLS:        str = "target \"riscv64-linux\"\nfunction @callee: fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64}) linkage global visibility default\nfunction @caller: fun(ptr, ptr) -> (i64) linkage global visibility default {\n^entry(%p: ptr, %q: ptr):\n    %s = load %p, type struct{i64, binary64}, align 8\n    %b = load %q, type struct{i64, i64, i64}, align 8\n    %r = call ptr @callee, i64 7, %s, %b, signature fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64}), named all\n    store %q, %r, align 8\n    ret i64 0\n}\nfunction @pair: fun(struct{i64, binary64}, binary32) -> (struct{i64, i64}) linkage global visibility default {\n^entry(%s: struct{i64, binary64}, %f: binary32):\n    %h = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %h, %s, align 8\n    %v = load %h, type struct{i64, i64}, align 8\n    ret %v\n}\n";
#[testing]
val CALLS_PIECES: str = "target \"riscv64-linux\"\n\nfunction @callee: fun(i64, struct{i64, binary64}, struct{i64, i64, i64}) -> (struct{i64, i64}) linkage global visibility default\n\nfunction @caller: fun(ptr, ptr) -> (i64) linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact] {\n^entry(%p: ptr, %q: ptr):\n    %0 = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    %1 = alloca type struct{i64, i64}, pointer ptr, align 8\n    %2 = load %p, type i64, align 8\n    %3 = ptr.add %p, i64 8\n    %4 = load %3, type binary64, align 8\n    %5 = load %q, type i64, align 8\n    store %0, %5, align 8\n    %6 = ptr.add %q, i64 8\n    %7 = ptr.add %0, i64 8\n    %8 = load %6, type i64, align 8\n    store %7, %8, align 8\n    %9 = ptr.add %q, i64 16\n    %10 = ptr.add %0, i64 16\n    %11 = load %9, type i64, align 8\n    store %10, %11, align 8\n    %12, %13 = call.placed ptr @callee, i64 7, %2, %4, %0, signature fun(i64, i64, binary64, ptr) -> (i64, i64), places [register 0 10 fixed exact, register 0 11 fixed exact, register 1 10 fixed exact, register 0 12 fixed exact, register 0 10 fixed exact, register 0 11 fixed exact]\n    store %1, %12, align 8\n    %14 = ptr.add %1, i64 8\n    store %14, %13, align 8\n    %15 = load %1, type struct{i64, i64}, align 8\n    store %q, %15, align 8\n    ret.placed i64 0, places [register 0 10 fixed exact]\n}\n\nfunction @pair: fun(struct{i64, binary64}, binary32) -> (struct{i64, i64}) linkage global visibility default placed [register 0 10 fixed exact, register 1 10 fixed exact, register 1 11 fixed boxed] {\n^entry(%0: i64, %1: binary64, %f: binary32):\n    %2 = alloca type struct{i64, binary64}, pointer ptr, align 8\n    store %2, %0, align 8\n    %3 = ptr.add %2, i64 8\n    store %3, %1, align 8\n    %4 = load %2, type struct{i64, binary64}, align 8\n    %h = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %h, %4, align 8\n    %5 = load %h, type i64, align 8\n    %6 = ptr.add %h, i64 8\n    %7 = load %6, type i64, align 8\n    ret.placed %5, %7, places [register 0 10 fixed exact, register 0 11 fixed exact]\n}\n";

# a result wider than two words, returned through the slot whose address the
# call passes in the carrier register
#[testing]
val INDIRECT:        str = "target \"riscv64-linux\"\nfunction @big: fun(i64) -> (struct{i64, i64, i64}) linkage global visibility default\nfunction @user: fun(ptr) -> () linkage global visibility default {\n^entry(%q: ptr):\n    %r = call ptr @big, i64 1, signature fun(i64) -> (struct{i64, i64, i64}), named all\n    store %q, %r, align 8\n    ret\n}\n";
#[testing]
val INDIRECT_PIECES: str = "target \"riscv64-linux\"\n\nfunction @big: fun(i64) -> (struct{i64, i64, i64}) linkage global visibility default\n\nfunction @user: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%q: ptr):\n    %0 = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    call.placed ptr @big, %0, i64 1, signature fun(ptr, i64) -> (), places [register 0 10 fixed exact, register 0 11 fixed exact]\n    %1 = load %0, type struct{i64, i64, i64}, align 8\n    store %q, %1, align 8\n    ret.placed places []\n}\n";

# a call with one named argument, its unnamed float and integer placed as the
# convention places unnamed values
#[testing]
val VARIADIC:        str = "target \"riscv64-linux\"\nfunction @print: fun(ptr, binary64, i32) -> (i32) linkage global visibility default\nfunction @user: fun(ptr) -> (i32) linkage global visibility default {\n^entry(%fmt: ptr):\n    %n = call ptr @print, %fmt, binary64 0x4000000000000000, i32 3, signature fun(ptr, binary64, i32) -> (i32), named 1\n    ret %n\n}\n";
#[testing]
val VARIADIC_PIECES: str = "target \"riscv64-linux\"\n\nfunction @print: fun(ptr, binary64, i32) -> (i32) linkage global visibility default\n\nfunction @user: fun(ptr) -> (i32) linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%fmt: ptr):\n    %0 = bitcast binary64 0x4000000000000000, to i64\n    %1 = ext.s i32 3, to i64\n    %2 = call.placed ptr @print, %fmt, %0, %1, signature fun(ptr, i64, i64) -> (i64), places [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact, register 0 10 fixed exact]\n    %3 = trunc %2, to i32\n    %4 = ext.s %3, to i64\n    ret.placed %4, places [register 0 10 fixed exact]\n}\n";

# a bound parameter split across registers and a bound result returned by
# reference
#[testing]
val BOUND:        str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"Pair\" \"Pair\" structure struct{i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1}\n!t2 = type \"Big\" \"Big\" structure struct{i64, i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1, \"c\": !t0 field 2}\n!v0 = variable \"p\" !t1 declared !l0 parameter 0\n!v1 = variable \"r\" !t2 declared !l0\nfunction @f: fun(struct{i64, i64}) -> (struct{i64, i64, i64}) linkage global visibility default {\n^entry(%p: struct{i64, i64}):\n    bind !v0 = %p\n    %slot = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    store %slot, %p, align 8\n    %r = load %slot, type struct{i64, i64, i64}, align 8\n    bind !v1 = %r\n    ret %r\n}\n";
#[testing]
val BOUND_PIECES: str = "target \"riscv64-linux\"\n!f0 = file \"a.mach\"\n!l0 = location !f0 1:1\n!t0 = type \"i64\" \"i64\" base signed 64\n!t1 = type \"Pair\" \"Pair\" structure struct{i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1}\n!t2 = type \"Big\" \"Big\" structure struct{i64, i64, i64} {\"a\": !t0 field 0, \"b\": !t0 field 1, \"c\": !t0 field 2}\n!v0 = variable \"p\" !t1 declared !l0 parameter 0\n!v1 = variable \"r\" !t2 declared !l0\n\nfunction @f: fun(struct{i64, i64}) -> (struct{i64, i64, i64}) linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%0: ptr, %1: i64, %2: i64):\n    %3 = alloca type struct{i64, i64}, pointer ptr, align 8\n    store %3, %1, align 8\n    %4 = ptr.add %3, i64 8\n    store %4, %2, align 8\n    %5 = load %3, type struct{i64, i64}, align 8\n    bind !v0 = %5\n    %slot = alloca type struct{i64, i64, i64}, pointer ptr, align 8 bind [!v1]\n    store %slot, %5, align 8\n    %6 = load %slot, type i64, align 8\n    store %0, %6, align 8\n    %7 = ptr.add %slot, i64 8\n    %8 = ptr.add %0, i64 8\n    %9 = load %7, type i64, align 8\n    store %8, %9, align 8\n    %10 = ptr.add %slot, i64 16\n    %11 = ptr.add %0, i64 16\n    %12 = load %10, type i64, align 8\n    store %11, %12, align 8\n    ret.placed places []\n}\n";

test abi__entry_call_and_return_travel_in_their_pieces {
    ret lowered(CALLS, CALLS_PIECES);
}

test abi__an_indirect_result_lands_in_the_slot_the_carrier_names {
    ret lowered(INDIRECT, INDIRECT_PIECES);
}

test abi__unnamed_arguments_travel_where_the_convention_places_them {
    ret lowered(VARIADIC, VARIADIC_PIECES);
}

test abi__every_binding_survives_the_pieces {
    ret lowered(BOUND, BOUND_PIECES);
}

# a variable the target reaches through the runtime's lookup, which the
# module does not declare
#[testing]
val LOOKUP:        str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls local_dynamic = i64 0\nfunction @f: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret\n}\n";
#[testing]
val LOOKUP_PIECES: str = "target \"riscv64-linux\"\nglobal @v: i64 linkage global visibility default tls local_dynamic = i64 0\nfunction @f: fun(ptr) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%p: ptr):\n    store %p, ptr @v, align 8\n    ret.placed places []\n}\nfunction @__tls_get_addr: fun(ptr) -> (ptr) linkage global visibility default\n";

test abi__a_variable_reached_through_the_lookup_declares_it {
    ret lowered(LOOKUP, LOOKUP_PIECES);
}

# an argument the signature sign extends from 8 bits, which the convention
# fills its register with as sign 8, so the pass extends it and the place
# holds it exact
#[testing]
val EXTENDED:        str = "target \"riscv64-linux\"\nfunction @g: fun(i8 sext) -> () linkage global visibility default\nfunction @f: fun(i64) -> () linkage global visibility default {\n^entry(%x: i64):\n    %b = trunc %x, to i8\n    call ptr @g, %b, signature fun(i8 sext) -> (), named all\n    ret\n}\n";
#[testing]
val EXTENDED_PIECES: str = "target \"riscv64-linux\"\nfunction @g: fun(i8 sext) -> () linkage global visibility default\nfunction @f: fun(i64) -> () linkage global visibility default placed [register 0 10 fixed exact] {\n^entry(%x: i64):\n    %b = trunc %x, to i8\n    %0 = ext.s %b, to i64\n    call.placed ptr @g, %0, signature fun(i64) -> (), places [register 0 10 fixed exact]\n    ret.placed places []\n}\n";

test abi__a_sign_extended_argument_crosses_a_call_sign_extended_from_its_width {
    ret lowered(EXTENDED, EXTENDED_PIECES);
}

# a float argument and result, which the convention carries in float registers
#[testing]
val FLOATED:        str = "target \"riscv64-linux\"\nfunction @f: fun(binary64) -> (binary64) linkage global visibility default {\n^entry(%x: binary64):\n    ret %x\n}\n";
#[testing]
val FLOATED_PIECES: str = "target \"riscv64-linux\"\nfunction @f: fun(binary64) -> (binary64) linkage global visibility default placed [register 1 10 fixed exact] {\n^entry(%x: binary64):\n    ret.placed %x, places [register 1 10 fixed exact]\n}\n";

# a baseline with no float registers gives the convention nothing to resolve
# through until the build adds the double extension, which then carries the
# float in its register
test abi__an_extension_the_build_adds_reaches_the_convention {
    var one: [1]str = [1]str{"d"};
    if (lowered_by(FLOATED, FLOATED_PIECES, opt[str].some{"rv64i"}, Slice[str]{data: nil, size: 0}) != 7) { ret 1; }
    ret lowered_by(FLOATED, FLOATED_PIECES, opt[str].some{"rv64i"}, Slice[str]{data: ?one[0], size: 1});
}

# a run that holds no machine is refused by the pass, the module as it was:
# one that holds nothing, and one that holds the basis of a target with no
# convention
test abi__a_run_with_no_machine_is_refused {
    val row: opt[*Target] = targets.first(machine.stated);
    if (sel row.none) { ret 1; }
    var t: Target = targets.unconventional(row.some);
    var a: allocator.Allocator;
    page.make(?a);
    var mc:   Machine;
    val held: res[Build, machine.Error] = machine.build(?mc, ?a, ?t, Slice[str]{data: nil, size: 0});
    if (sel held.err) { ret 1; }
    fin { machine.release(held.ok); }
    if (sel held.ok.basis.none) { ret 1; }
    val bare: i32 = unmachined(?a, ?t, machine.BARE);
    if (bare != 0) { ret bare; }
    ret unmachined(?a, ?t, held.ok);
}

# run the abi pass over a module for a target with what a build holds of it,
# which must refuse as unmachined and leave the module as it was
#[testing]
fun unmachined(a: *allocator.Allocator, t: *Target, held: Build) i32 {
    val parsed: res[Module, Refusal] = parse_body(a, view_of(FLOATED));
    if (sel parsed.err) { ret 1; }
    var got: Module = parsed.ok;
    fin { module.dnit(?got); }
    val wanted: res[Module, Refusal] = parse_body(a, view_of(FLOATED));
    if (sel wanted.err) { ret 1; }
    var want: Module = wanted.ok;
    fin { module.dnit(?want); }
    val started: res[Driver, Error] = driver.init(?got, t, held, Options{level: 0, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, ?ABI);
    if (!(sel ran.err))         { ret 3; }
    if (!(sel ran.err.refused)) { ret 4; }
    val why: Why = ran.err.refused.why;
    if (!(sel why.unmachined)) { ret 5; }
    val same: res[bool, printer.Error] = equal.same(?got, ?want);
    if (sel same.err) { ret 6; }
    if (!same.ok)     { ret 7; }
    ret 0;
}

# arguments by reference in a loop that is not the entry: a wide integer
# stored to its slot just ahead of the call, and an aggregate loaded in the
# entry, stored whole there too since the load runs once and the call many
# times
#[testing]
val LOOPED:        str = "target \"riscv64-linux\"\nfunction @g: fun(i256, struct{i64, i64, i64}) -> (i64) linkage global visibility default\nfunction @f: fun(i256, ptr, i64) -> (i64) linkage global visibility default {\n^entry(%y: i256, %p: ptr, %n: i64):\n    %s = load %p, type struct{i64, i64, i64}, align 8\n    br ^loop(i64 0)\n^loop(%i: i64):\n    %b = call ptr @g, %y, %s, signature fun(i256, struct{i64, i64, i64}) -> (i64), named all\n    %j = add %i, %b\n    %more = lt.u %j, %n\n    cbr %more, ^loop(%j), ^out\n^out:\n    ret %j\n}\n";
#[testing]
val LOOPED_PIECES: str = "target \"riscv64-linux\"\nfunction @g: fun(i256, struct{i64, i64, i64}) -> (i64) linkage global visibility default\nfunction @f: fun(i256, ptr, i64) -> (i64) linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%0: ptr, %p: ptr, %n: i64):\n    %1 = alloca type struct{i64, i64, i64}, pointer ptr, align 8\n    %2 = alloca type i256, pointer ptr, align 8\n    %3 = load %0, type i256, align 8\n    %s = load %p, type struct{i64, i64, i64}, align 8\n    br ^loop(i64 0)\n^loop(%i: i64):\n    store %2, %3, align 8\n    store %1, %s, align 8\n    %4 = call.placed ptr @g, %2, %1, signature fun(ptr, ptr) -> (i64), places [register 0 10 fixed exact, register 0 11 fixed exact, register 0 10 fixed exact]\n    %j = add %i, %4\n    %more = lt.u %j, %n\n    cbr %more, ^loop(%j), ^out\n^out:\n    ret.placed %j, places [register 0 10 fixed exact]\n}\n";

test abi__an_argument_by_reference_is_copied_ahead_of_its_call_each_time_it_runs {
    ret lowered(LOOPED, LOOPED_PIECES);
}
