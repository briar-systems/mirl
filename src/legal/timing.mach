# the timing mode a constant-time function switches on around its own code
#
# a soft or hard function of a build whose set has a mode a function switches
# (`mirl.ct.switching`), as aarch64's PSTATE.DIT, runs its code with the mode
# on and leaves it as it found it on every exit. the entry reads the mode's
# state and, where it is off, switches it on and remembers that it did, and
# each return switches it off again where the entry switched it on. a
# function entered with the mode on, as a constant-time caller leaves it,
# switches nothing, so a call between constant-time functions makes no
# toggle. where the build does not guarantee the processor has the mode
# (`mirl.ct.Switching`), the entry first reads std's availability byte
# (`mirl.ct.AVAILABLE`) and reads and switches nothing where it is 0, so the
# function runs anyway, without the mode. the byte is an external hidden
# global of one byte, which the module declares where it names none.
#
# the switch's instructions need the mode's guarantee in the selection they
# are read under, so a function whose build does not select it names it among
# its extensions (`FunctionData.extensions`), which widens what selection
# admits for it alone. a hard function's guarantee is read off the build's
# selection, never the function's (`mirl.ct.check`).
#
# the entry block's instructions move to a block of their own, which takes
# whether the entry switched the mode as its one parameter, and the entry
# keeps only the reads that decide it. each `ret` moves to a block of its own,
# which the block it stood in reaches through the switch back off where the
# parameter is set. the reads, the switches and the branches are on public
# values, so the pass keeps constant time. it runs before every other
# legalisation of the register family, so the helpers delivered after it,
# which a constant-time caller calls with the mode already on, switch nothing.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.symbol;

use mirl.base.slice;
use mirl.build;
use mct: mirl.ct;
use mirl.fold.word;
use ia: mirl.ir.assembly;
use mirl.ir.body;
use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.function.in_constant_time;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.linkage.Linkage;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.pass.cache;
use mirl.pass.failure;
use mirl.pass.failure.Why;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;

use mo: masc.core.operand;
use rf: masc.core.register;
use masc.inline.inline;

pub val TIMING: Pass = Pass{name: "timing", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}, applies: switches};

# how the availability byte is seen: by every object of the image, by no other image
val HIDDEN: Linkage = Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, export: false};

# the flags of the load of the availability byte, which states it reads public memory
val PUBLIC: Flags = Flags{volatile: false, kept: false, bounded: false, checked: false, public: true};

# the name the availability byte's declaration takes where another symbol holds it
val TAKEN: str = "the availability byte's name names another symbol than a global of one byte";

# the name of the operand the switch's read gives the state in
val STATE: str = "state";

# whether the build's set has a mode a constant-time function switches
fun switches(g: *Ground) bool {
    if (sel g.basis.none) { ret false; }
    val got: opt[mct.Switching] = mct.switching(?g.basis.some.context);
    ret sel got.some;
}

# what one function's switch is built from
# ---
# s:      the site the switch is built through
# switch: the switch and whether the build guarantees its mode
# class:  the register class the state is read into
# word:   the type of the state
# flag:   the type of a condition
rec Work {
    s:      Site;
    switch: mct.Switching;
    class:  u16;
    word:   Type;
    flag:   Type;
}

fun view(text: str) View {
    ret View{data: text, len: str_len(text)};
}

fun no_values() Slice[Value] {
    ret Slice[Value]{data: nil, size: 0};
}

fun no_immediates() Slice[Immediate] {
    ret Slice[Immediate]{data: nil, size: 0};
}

fun no_targets() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

fun integer(m: *module.Module, bits: u32) res[Type, Why] {
    val made: res[Type, types.Error] = types.intern(?m.types, types.Shape.integer{types.Integer{width: bits}});
    if (sel made.err) { ret res[Type, Why].err{Why.ir{module.Error.types{made.err}}}; }
    ret res[Type, Why].ok{made.ok};
}

# the request of the block `text` binding the operands `ops`. it is held to touch memory, so no pass moves an access
# across it or takes it away
fun assembled(text: str, ops: Slice[ia.Operand], held: *ia.Assembly, imm: *Immediate) Request {
    @held = ia.Assembly{text: view(text), operands: ops, reads: true, writes: true};
    @imm  = Immediate.assembly{held};
    ret Request{opcode: opcode.ASM, operands: no_values(), immediates: Slice[Immediate]{data: imm, size: 1}, targets: no_targets()};
}

# the switch's read of the mode's state at the builder's cursor, giving the state
fun state(w: *Work) Value {
    var ops:  [1]ia.Operand = [1]ia.Operand{ia.Operand{name: view(STATE), role: mo.WRITE, constraint: inline.Constraint.class{w.class}, ty: w.word}};
    var held: ia.Assembly;
    var imm:  Immediate;
    ret build.value(?w.s.bld, assembled(w.switch.switch.read, Slice[ia.Operand]{data: ?ops[0], size: 1}, ?held, ?imm));
}

# the block `text`, which binds nothing, at the builder's cursor
fun step(w: *Work, text: str) {
    var held: ia.Assembly;
    var imm:  Immediate;
    val made: Instruction = build.emit(?w.s.bld, assembled(text, Slice[ia.Operand]{data: nil, size: 0}, ?held, ?imm));
}

# end the block at the builder's cursor in a branch to `to`, passing `arguments`
fun jump(w: *Work, to: Block, arguments: Slice[Value]) {
    var targets: [1]Branch   = [1]Branch{Branch{block: to, arguments: arguments}};
    val made:    Instruction = build.emit(?w.s.bld, Request{opcode: opcode.BR, operands: no_values(), immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 1}});
}

# end the block at the builder's cursor in a branch on `condition` to `yes` or to `no`, passing `arguments` to `no`
fun fork(w: *Work, condition: Value, yes: Block, no: Block, arguments: Slice[Value]) {
    var ops:     [1]Value    = [1]Value{condition};
    var targets: [2]Branch   = [2]Branch{Branch{block: yes, arguments: no_values()}, Branch{block: no, arguments: arguments}};
    val made:    Instruction = build.emit(?w.s.bld, Request{opcode: opcode.CBR, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 2}});
}

# the availability byte, the module's own where it names it, declared external and hidden where it names none
fun available(c: *Context, byte: Type) res[Global, Why] {
    val name:  View        = view(mct.AVAILABLE);
    val found: opt[Symbol] = module.find(c.m, name);
    if (sel found.some) {
        if (!(sel found.some.global)) { ret res[Global, Why].err{Why.reason{TAKEN}}; }
        val held: res[GlobalData, module.Error] = module.global_data(c.m, found.some.global);
        if (sel held.err)                    { ret res[Global, Why].err{Why.ir{held.err}}; }
        if (!types.same(held.ok.type, byte)) { ret res[Global, Why].err{Why.reason{TAKEN}}; }
        ret res[Global, Why].ok{found.some.global};
    }
    val made: res[Global, module.Error] = module.add_global(c.m, GlobalData{name: name, type: byte, initial: opt[Constant].none{}, alignment: opt[u64].none{}, linkage: HIDDEN, constant: false});
    if (sel made.err) { ret res[Global, Why].err{Why.ir{made.err}}; }
    ret res[Global, Why].ok{made.ok};
}

# the condition, at the builder's cursor, that the mode is off, read through the switch's read
fun off(w: *Work) res[Value, Why] {
    val read: Value           = state(w);
    val bit:  res[Value, Why] = emit.constant(?w.s, w.word, word.small(w.switch.switch.bit));
    if (sel bit.err) { ret bit; }
    val zero: res[Value, Why] = emit.constant(?w.s, w.word, word.zero());
    if (sel zero.err) { ret zero; }
    val held: Value = emit.binary(?w.s, opcode.AND, read, bit.ok);
    ret res[Value, Why].ok{emit.binary(?w.s, opcode.EQ, held, zero.ok)};
}

# each `ret` of body `b`, by its block and position, gathered before the body changes
fun returns(b: *Body, out: *vector.Vector[Instruction]) err[Why] {
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            if (list.len > 0) {
                val last: Instruction = list.data[list.len - 1];
                if (b.instructions.data[last.index].opcode.index == opcode.RET.index) {
                    val pushed: res[usize, allocator.Error] = vector.push[Instruction](out, last);
                    if (sel pushed.err) { ret failure.lost(pushed.err); }
                }
            }
        }
        k = k + 1;
    }
    ret err[Why].ok{};
}

# function `f` of `c` with the extension `name` among its extensions, the list copied into the module's storage
fun widened(c: *Context, f: Function, name: str) err[Why] {
    val held: Slice[View] = c.m.functions.data[f.index].data.extensions;
    var k:    usize       = 0;
    for (k < held.size) {
        if (slice.same_view(held.data[k], view(name))) { ret err[Why].ok{}; }
        k = k + 1;
    }
    val room: res[*View, allocator.Error] = allocator.zallocate[View](c.m.a, held.size + 1);
    if (sel room.err) { ret failure.lost(room.err); }
    var out: Slice[View] = Slice[View]{data: room.ok, size: held.size + 1};
    k = 0;
    for (k < out.size) {
        var from: View = view(name);
        if (k < held.size) { from = held.data[k]; }
        val copied: res[View, allocator.Error] = slice.copy_view(c.m.a, from);
        if (sel copied.err) {
            out.size = k;
            val gone: err[allocator.Error] = slice.release_views(c.m.a, out);
            ret failure.lost(copied.err);
        }
        out.data[k] = copied.ok;
        k           = k + 1;
    }
    val old: err[allocator.Error] = slice.release_views(c.m.a, held);
    c.m.functions.data[f.index].data.extensions = out;
    if (sel old.err) { ret failure.lost(old.err); }
    ret err[Why].ok{};
}

# the block a placed instruction of body `b` stands in
fun place_of(b: *Body, i: Instruction) opt[Block] {
    val p: Place = b.instructions.data[i.index].place;
    if (sel p.placed) { ret opt[Block].some{p.placed}; }
    ret opt[Block].none{};
}

# switch the mode around function `u.f`
fun visit(u: *Unit) res[bool, Why] {
    val c: *Context = u.context;
    if (!in_constant_time(c.m.functions.data[u.f.index].data.constant_time)) { ret res[bool, Why].ok{false}; }
    if (sel c.basis.none)                                                    { ret res[bool, Why].ok{false}; }
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err)            { ret res[bool, Why].err{Why.ir{got.err}}; }
    if (got.ok.blocks.len == 0) { ret res[bool, Why].ok{false}; }
    val switched: opt[mct.Switching] = mct.switching(?c.basis.some.context);
    if (sel switched.none) { ret res[bool, Why].ok{false}; }
    val file: *rf.File = c.basis.some.set.codec.registers;
    if (file == nil) { ret res[bool, Why].err{Why.reason{"the instruction set states no register file to read the timing mode's state into"}}; }
    val class: opt[u16] = rf.class_named(file, switched.some.switch.class);
    if (sel class.none) { ret res[bool, Why].err{Why.reason{"the register file has no class of the timing mode's state"}}; }
    val wide: res[Type, Why] = integer(c.m, 64);
    if (sel wide.err) { ret res[bool, Why].err{wide.err}; }
    val flag: res[Type, Why] = integer(c.m, 1);
    if (sel flag.err) { ret res[bool, Why].err{flag.err}; }
    val byte: res[Type, Why] = integer(c.m, 8);
    if (sel byte.err) { ret res[bool, Why].err{byte.err}; }

    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, Why].err{Why.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    if (!switched.some.guaranteed) {
        val wide_enough: err[Why] = widened(c, u.f, switched.some.switch.guarantee);
        if (sel wide_enough.err) { ret res[bool, Why].err{wide_enough.err}; }
    }
    var exits: vector.Vector[Instruction] = vector.init[Instruction](?scratch);
    val found: err[Why]                   = returns(got.ok, ?exits);
    if (sel found.err) { ret res[bool, Why].err{found.err}; }

    var w:      Work           = Work{s: emit.init(c.m, u.f, got.ok, ?scratch), switch: switched.some, class: class.some, word: wide.ok, flag: flag.ok};
    val entry:  Block          = Block{index: 0};
    var param:  [1]Declaration = [1]Declaration{Declaration{type: flag.ok, secret: false, name: opt[View].none{}}};
    val body_k: Block          = build.block(?w.s.bld, Slice[Declaration]{data: ?param[0], size: 1});
    val on_k:   Block          = build.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
    val built:  err[Why]       = emit.done(?w.s);
    if (sel built.err) { ret res[bool, Why].err{built.err}; }
    val moved: err[Why] = failure.edit(body.move(c.m, u.f, entry, 0, body_k));
    if (sel moved.err) { ret res[bool, Why].err{moved.err}; }

    val no: res[Value, Why] = emit.constant(?w.s, flag.ok, word.zero());
    if (sel no.err) { ret res[bool, Why].err{no.err}; }
    val yes: res[Value, Why] = emit.constant(?w.s, flag.ok, word.small(1));
    if (sel yes.err) { ret res[bool, Why].err{yes.err}; }
    var unset: [1]Value = [1]Value{no.ok};
    var set:   [1]Value = [1]Value{yes.ok};

    build.at_end(?w.s.bld, entry);
    if (!w.switch.guaranteed) {
        val g: res[Global, Why] = available(c, byte.ok);
        if (sel g.err) { ret res[bool, Why].err{g.err}; }
        val pointer: res[Type, types.Error] = types.intern(?c.m.types, types.Shape.pointer{types.Pointer{space: 0}});
        if (sel pointer.err) { ret res[bool, Why].err{Why.ir{module.Error.types{pointer.err}}}; }
        val address: Constant     = build.constant(?w.s.bld, ConstantData.address{Address{type: pointer.ok, symbol: Symbol.global{g.ok}, offset: 0}});
        var ops:     [1]Value     = [1]Value{build.use_constant(?w.s.bld, address)};
        var imm:     [2]Immediate = [2]Immediate{Immediate.ty{byte.ok}, Immediate.alignment{1}};
        build.flags(?w.s.bld, PUBLIC);
        val loaded: Value = build.value(?w.s.bld, Request{opcode: opcode.LOAD, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: Slice[Immediate]{data: ?imm[0], size: 2}, targets: no_targets()});
        build.flags(?w.s.bld, NO_FLAGS);
        val none: res[Value, Why] = emit.constant(?w.s, byte.ok, word.zero());
        if (sel none.err) { ret res[bool, Why].err{none.err}; }
        val has:   Value = emit.binary(?w.s, opcode.NE, loaded, none.ok);
        val probe: Block = build.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
        fork(?w, has, probe, body_k, Slice[Value]{data: ?unset[0], size: 1});
        build.at_end(?w.s.bld, probe);
    }
    val cleared: res[Value, Why] = off(?w);
    if (sel cleared.err) { ret res[bool, Why].err{cleared.err}; }
    fork(?w, cleared.ok, on_k, body_k, Slice[Value]{data: ?unset[0], size: 1});
    build.at_end(?w.s.bld, on_k);
    step(?w, w.switch.switch.on);
    jump(?w, body_k, Slice[Value]{data: ?set[0], size: 1});
    val opened: err[Why] = emit.done(?w.s);
    if (sel opened.err) { ret res[bool, Why].err{opened.err}; }

    val was: Value = build.parameter(?w.s.bld, body_k, 0);
    var e:   usize = 0;
    for (e < exits.len) {
        val at: opt[Block] = place_of(got.ok, exits.data[e]);
        if (sel at.some) {
            val k:    Block    = at.some;
            val n:    u32      = (got.ok.blocks.data[k.index].instructions.len - 1)::u32;
            val back: Block    = build.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
            val out:  Block    = build.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
            val done: err[Why] = emit.done(?w.s);
            if (sel done.err) { ret res[bool, Why].err{done.err}; }
            val left: err[Why] = failure.edit(body.move(c.m, u.f, k, n, out));
            if (sel left.err) { ret res[bool, Why].err{left.err}; }
            build.at_end(?w.s.bld, k);
            fork(?w, was, back, out, no_values());
            build.at_end(?w.s.bld, back);
            step(?w, w.switch.switch.off);
            jump(?w, out, no_values());
        }
        e = e + 1;
    }
    val closed: err[Why] = emit.done(?w.s);
    if (sel closed.err) { ret res[bool, Why].err{closed.err}; }
    ret res[bool, Why].ok{true};
}
