# the timing mode a constant-time function switches on around its own code
#
# a soft or hard function of a build whose set states a switch of a mode a
# function switches (`mirl.ct.switching`, `masc.core.switch`), as aarch64's
# dit=on, runs its code with the mode on and leaves it as it found it on
# every exit. the entry reads the mode's state into a saved word
# (`timing.read`) and, where the bits the switch's mask names are not the
# ones it holds while the mode is on, switches it on (`timing.set`) and
# remembers that it did, and each return restores the state from the saved
# word (`timing.restore`) where the entry switched it on. a function entered
# with the mode on, as a constant-time caller leaves it, switches nothing, so
# a call between constant-time functions makes no toggle. where the build
# does not admit the rows of the switch's set steps (`mirl.ct.Switching`),
# the entry first reads std's availability byte (`mirl.ct.AVAILABLE`) and
# reads and switches nothing where it is 0, so the function runs anyway,
# without the mode. the byte is an external hidden global of one byte, which
# the module declares where it names none. the three switch opcodes name the
# mode's state value, and selection places each from the rows the set's
# switch states, so mirl states none of the switch's instructions.
#
# the switch's rows need what their set steps require in the selection they
# are read under, so a function whose build does not admit it names the
# extensions of its first way of meeting it among its extensions
# (`FunctionData.extensions`), which widens what selection admits for it
# alone. a hard function's guarantee is read off the build's selection, never
# the function's (`mirl.ct.check`).
#
# the entry block's instructions move to a block of their own, which takes
# whether the entry switched the mode and the saved word as its parameters,
# and the entry keeps only the reads that decide it. each `ret` moves to a
# block of its own, which the block it stood in reaches through the restore
# where the parameter is set. the reads, the switches and the branches are on
# public values, so the pass keeps constant time. it runs before every other
# legalisation of the register family, so the helpers delivered after it,
# which a constant-time caller calls with the mode already on, switch
# nothing. it runs before the session that compiles the module opens, so the
# widened extensions and the declared byte are there when it does.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.symbol;

use mink.base.intern.Name;
use mink.base.table.Id;

use mirl.base.slice;
use mirl.build.builder;
use mct: mirl.ct;
use mirl.fold.word;
use mirl.ir.body;
use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.function.in_constant_time;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.linkage.Linkage;
use mirl.ir.metadata.Flags;
use mirl.ir.metadata.NO_FLAGS;
use mirl.ir.module;
use mirl.ir.opcode.row.Immediate;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.pass.cache;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;

use masc.core.extension;
use rf: masc.core.register;
use masc.core.requirement;
use rows:       masc.core.row;
use mset:       masc.core.set;
use core_state: masc.core.state;
use masc.core.unmet;

pub val TIMING: Pass = Pass{name: "timing", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}, applies: switches};

# how the availability byte is seen: by every object of the image, by no other image
val HIDDEN: Linkage = Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.HIDDEN, export: false};

# the flags of the load of the availability byte, which states it reads public memory
val PUBLIC: Flags = Flags{volatile: false, kept: false, bounded: false, checked: false, public: true};

# the name the availability byte's declaration takes where another symbol holds it
val TAKEN: str = "the availability byte's name names another symbol than a global of one byte";

# whether the build's set states a switch of a mode a constant-time function switches
fun switches(g: *Ground) bool {
    if (sel g.basis.none) { ret false; }
    val got: opt[mct.Switching] = mct.switching(g.basis.some.set, ?g.basis.some.context);
    ret sel got.some;
}

# what one function's switch is built from
# ---
# s:      the site the switch is built through
# switch: the switch and whether the build guarantees its mode
# state:  the spelling of the mode's state value, which the switch opcodes name
# word:   the type of the saved word, as wide as the switch's saved register
# flag:   the type of a condition
rec Work {
    s:      Site;
    switch: mct.Switching;
    state:  View;
    word:   Type;
    flag:   Type;
}

fun view(text: str) View {
    ret View{data: text, len: str_len(text)};
}

fun no_values() Slice[Value] {
    ret Slice[Value]{data: nil, size: 0};
}

fun no_immediates() Slice[Immediate] {
    ret Slice[Immediate]{data: nil, size: 0};
}

fun no_targets() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

fun integer(m: *module.Module, bits: u32) res[Type, refusal.Error] {
    val made: res[Type, table.Error] = table.intern(?m.types, table.Shape.integer{table.Integer{width: bits}});
    if (sel made.err) { ret res[Type, refusal.Error].err{refusal.Error.ir{module.Error.types{made.err}}}; }
    ret res[Type, refusal.Error].ok{made.ok};
}

# the switch's read of the mode's state at the builder's cursor, giving the saved word
fun read(w: *Work) Value {
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{w.word}, Immediate.state{w.state}};
    ret builder.value(?w.s.bld, Request{opcode: opcode_table.TIMING_READ, operands: no_values(), immediates: Slice[Immediate]{data: ?imm[0], size: 2}, targets: no_targets()});
}

# the switch's set of the mode at the builder's cursor
fun set_on(w: *Work) {
    var imm:  [1]Immediate = [1]Immediate{Immediate.state{w.state}};
    val made: Instruction  = builder.emit(?w.s.bld, Request{opcode: opcode_table.TIMING_SET, operands: no_values(), immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
}

# the switch's restore of the mode's state from the saved word `saved` at the builder's cursor
fun restore(w: *Work, saved: Value) {
    var ops:  [1]Value     = [1]Value{saved};
    var imm:  [1]Immediate = [1]Immediate{Immediate.state{w.state}};
    val made: Instruction  = builder.emit(?w.s.bld, Request{opcode: opcode_table.TIMING_RESTORE, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
}

# end the block at the builder's cursor in a branch to `to`, passing `arguments`
fun jump(w: *Work, to: Block, arguments: Slice[Value]) {
    var targets: [1]Branch   = [1]Branch{Branch{block: to, arguments: arguments}};
    val made:    Instruction = builder.emit(?w.s.bld, Request{opcode: opcode_table.BR, operands: no_values(), immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 1}});
}

# end the block at the builder's cursor in a branch on `condition` to `yes` or to `no`, passing `arguments` to `no`
fun fork(w: *Work, condition: Value, yes: Block, no: Block, arguments: Slice[Value]) {
    var ops:     [1]Value    = [1]Value{condition};
    var targets: [2]Branch   = [2]Branch{Branch{block: yes, arguments: no_values()}, Branch{block: no, arguments: arguments}};
    val made:    Instruction = builder.emit(?w.s.bld, Request{opcode: opcode_table.CBR, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: no_immediates(), targets: Slice[Branch]{data: ?targets[0], size: 2}});
}

# the availability byte, the module's own where it names it, declared external and hidden where it names none
fun available(c: *Context, byte: Type) res[Global, refusal.Error] {
    val name:  View        = view(mct.AVAILABLE);
    val found: opt[Symbol] = module.find(c.m, name);
    if (sel found.some) {
        if (!(sel found.some.global)) { ret res[Global, refusal.Error].err{refusal.Error.reason{TAKEN}}; }
        val held: res[GlobalData, module.Error] = module.global_data(c.m, found.some.global);
        if (sel held.err)                    { ret res[Global, refusal.Error].err{refusal.Error.ir{held.err}}; }
        if (!table.same(held.ok.type, byte)) { ret res[Global, refusal.Error].err{refusal.Error.reason{TAKEN}}; }
        ret res[Global, refusal.Error].ok{found.some.global};
    }
    val symbol_as: res[Id[Name], module.Error] = module.intern_name(c.m, name);
    if (sel symbol_as.err) { ret res[Global, refusal.Error].err{refusal.Error.ir{symbol_as.err}}; }
    val made: res[Global, module.Error] = module.add_global(c.m, GlobalData{name: symbol_as.ok, type: byte, initial: opt[Constant].none{}, alignment: opt[u64].none{}, linkage: HIDDEN, constant: false});
    if (sel made.err) { ret res[Global, refusal.Error].err{refusal.Error.ir{made.err}}; }
    ret res[Global, refusal.Error].ok{made.ok};
}

# the condition, at the builder's cursor, that the mode is off: the bits of the saved word `saved` the switch's mask
# names are not the ones it holds while the mode is on
fun off(w: *Work, saved: Value) res[Value, refusal.Error] {
    val mask: res[Value, refusal.Error] = emit.constant(?w.s, w.word, word.small(w.switch.switch.mask));
    if (sel mask.err) { ret mask; }
    val on: res[Value, refusal.Error] = emit.constant(?w.s, w.word, word.small(w.switch.switch.held));
    if (sel on.err) { ret on; }
    val bits: Value = emit.binary(?w.s, opcode_table.AND, saved, mask.ok);
    ret res[Value, refusal.Error].ok{emit.binary(?w.s, opcode_table.NE, bits, on.ok)};
}

# the extensions of the first way of meeting what each set step row of the switch requires that the build of `ctx`
# does not admit, each named among function `f`'s extensions
fun guarantee(c: *Context, f: Function, set: *mset.Set, ctx: *core_state.Context, sw: *mct.Switching) err[refusal.Error] {
    val catalog: *extension.Catalog = set.extensions;
    var k:       u32                = 0;
    for (k < sw.switch.set.len) {
        val r: *rows.Row = rows.at(set.codec.rows, sw.switch.set.at[k].row);
        if (r == nil) { ret err[refusal.Error].err{refusal.Error.reason{"the timing switch's set step names no row of the instruction set"}}; }
        if (!core_state.admits(ctx, r.requires) && r.requires.len != 0) {
            val all: requirement.Ids = r.requires.at[0].all;
            var n:   u32             = 0;
            for (n < all.len) {
                val id: requirement.Id = all.at[n];
                if (id < catalog.count && !extension.has(ctx.selection, id)) {
                    val named: err[refusal.Error] = widened(c, f, catalog.extensions[id].name);
                    if (sel named.err) { ret named; }
                }
                n = n + 1;
            }
        }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# each `ret` of body `b`, by its block and position, gathered before the body changes
fun returns(b: *Body, out: *vector.Vector[Instruction]) err[refusal.Error] {
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            if (list.len > 0) {
                val last: Instruction = list.data[list.len - 1];
                if (b.instructions.data[last].opcode == opcode_table.RET) {
                    val pushed: res[usize, allocator.Error] = vector.push[Instruction](out, last);
                    if (sel pushed.err) { ret refusal.lost(pushed.err); }
                }
            }
        }
        k = k + 1;
    }
    ret err[refusal.Error].ok{};
}

# function `f` of `c` with the extension `name` among its extensions, the list copied into the module's storage
fun widened(c: *Context, f: Function, name: str) err[refusal.Error] {
    val held: Slice[View] = c.m.functions.data[f].data.extensions;
    var k:    usize       = 0;
    for (k < held.size) {
        if (slice.same_view(held.data[k], view(name))) { ret err[refusal.Error].ok{}; }
        k = k + 1;
    }
    val room: res[*View, allocator.Error] = allocator.zallocate[View](c.m.a, held.size + 1);
    if (sel room.err) { ret refusal.lost(room.err); }
    var out: Slice[View] = Slice[View]{data: room.ok, size: held.size + 1};
    k = 0;
    for (k < out.size) {
        var from: View = view(name);
        if (k < held.size) { from = held.data[k]; }
        val copied: res[View, allocator.Error] = slice.copy_view(c.m.a, from);
        if (sel copied.err) {
            out.size = k;
            val gone: err[allocator.Error] = slice.release_views(c.m.a, out);
            ret refusal.lost(copied.err);
        }
        out.data[k] = copied.ok;
        k           = k + 1;
    }
    val old: err[allocator.Error] = slice.release_views(c.m.a, held);
    c.m.functions.data[f].data.extensions = out;
    if (sel old.err) { ret refusal.lost(old.err); }
    ret err[refusal.Error].ok{};
}

# the block a placed instruction of body `b` stands in
fun place_of(b: *Body, i: Instruction) opt[Block] {
    val p: Place = b.instructions.data[i].place;
    if (sel p.placed) { ret opt[Block].some{p.placed}; }
    ret opt[Block].none{};
}

# switch the mode around function `u.f`
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c: *Context = u.context;
    if (!in_constant_time(c.m.functions.data[u.f].data.constant_time)) { ret res[bool, refusal.Error].ok{false}; }
    if (sel c.basis.none)                                              { ret res[bool, refusal.Error].ok{false}; }
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err)            { ret res[bool, refusal.Error].err{refusal.Error.ir{got.err}}; }
    if (got.ok.blocks.len == 0) { ret res[bool, refusal.Error].ok{false}; }
    val set:      *mset.Set           = c.basis.some.set;
    val ctx:      *core_state.Context = ?c.basis.some.context;
    val switched: opt[mct.Switching]  = mct.switching(set, ctx);
    if (sel switched.none) { ret res[bool, refusal.Error].ok{false}; }
    val file: *rf.File = set.codec.registers;
    if (file == nil) { ret res[bool, refusal.Error].err{refusal.Error.reason{"the instruction set states no register file to read the timing mode's state into"}}; }
    val bits: u64 = rf.width_most(file, switched.some.switch.saved);
    if (bits == 0 || bits > 64) { ret res[bool, refusal.Error].err{refusal.Error.reason{"the timing switch saves its state into a register no integer type holds"}}; }
    val wide: res[Type, refusal.Error] = integer(c.m, bits::u32);
    if (sel wide.err) { ret res[bool, refusal.Error].err{wide.err}; }
    val flag: res[Type, refusal.Error] = integer(c.m, 1);
    if (sel flag.err) { ret res[bool, refusal.Error].err{flag.err}; }
    val byte: res[Type, refusal.Error] = integer(c.m, 8);
    if (sel byte.err) { ret res[bool, refusal.Error].err{byte.err}; }

    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    var spelled: vector.Vector[u8]    = vector.init[u8](?scratch);
    val atom:    err[allocator.Error] = unmet.spell_atom(set.extensions, ?set.states, switched.some.state, ?spelled);
    if (sel atom.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{atom.err}}; }
    if (!switched.some.guaranteed) {
        val wide_enough: err[refusal.Error] = guarantee(c, u.f, set, ctx, ?switched.some);
        if (sel wide_enough.err) { ret res[bool, refusal.Error].err{wide_enough.err}; }
    }
    var exits: vector.Vector[Instruction] = vector.init[Instruction](?scratch);
    val found: err[refusal.Error]         = returns(got.ok, ?exits);
    if (sel found.err) { ret res[bool, refusal.Error].err{found.err}; }

    var w:      Work               = Work{s: emit.init(c.m, u.f, got.ok, ?scratch), switch: switched.some, state: View{data: spelled.data, len: spelled.len}, word: wide.ok, flag: flag.ok};
    val entry:  Block              = 0;
    var param:  [2]Declaration     = [2]Declaration{Declaration{type: flag.ok, secret: false, name: opt[View].none{}}, Declaration{type: wide.ok, secret: false, name: opt[View].none{}}};
    val body_k: Block              = builder.block(?w.s.bld, Slice[Declaration]{data: ?param[0], size: 2});
    val on_k:   Block              = builder.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
    val built:  err[refusal.Error] = emit.done(?w.s);
    if (sel built.err) { ret res[bool, refusal.Error].err{built.err}; }
    val moved: err[refusal.Error] = refusal.edit(body.move(c.m, u.f, entry, 0, body_k));
    if (sel moved.err) { ret res[bool, refusal.Error].err{moved.err}; }

    val no: res[Value, refusal.Error] = emit.constant(?w.s, flag.ok, word.zero());
    if (sel no.err) { ret res[bool, refusal.Error].err{no.err}; }
    val yes: res[Value, refusal.Error] = emit.constant(?w.s, flag.ok, word.small(1));
    if (sel yes.err) { ret res[bool, refusal.Error].err{yes.err}; }
    val nothing: res[Value, refusal.Error] = emit.constant(?w.s, wide.ok, word.zero());
    if (sel nothing.err) { ret res[bool, refusal.Error].err{nothing.err}; }
    var unread: [2]Value = [2]Value{no.ok, nothing.ok};

    builder.at_end(?w.s.bld, entry);
    if (!w.switch.guaranteed) {
        val g: res[Global, refusal.Error] = available(c, byte.ok);
        if (sel g.err) { ret res[bool, refusal.Error].err{g.err}; }
        val pointer: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.pointer{table.Pointer{space: 0}});
        if (sel pointer.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{pointer.err}}}; }
        val address: Constant     = builder.constant(?w.s.bld, ConstantData.address{Address{type: pointer.ok, symbol: Symbol.global{g.ok}, offset: 0}});
        var ops:     [1]Value     = [1]Value{builder.use_constant(?w.s.bld, address)};
        var imm:     [2]Immediate = [2]Immediate{Immediate.ty{byte.ok}, Immediate.alignment{1}};
        builder.flags(?w.s.bld, PUBLIC);
        val loaded: Value = builder.value(?w.s.bld, Request{opcode: opcode_table.LOAD, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: Slice[Immediate]{data: ?imm[0], size: 2}, targets: no_targets()});
        builder.flags(?w.s.bld, NO_FLAGS);
        val none: res[Value, refusal.Error] = emit.constant(?w.s, byte.ok, word.zero());
        if (sel none.err) { ret res[bool, refusal.Error].err{none.err}; }
        val has:   Value = emit.binary(?w.s, opcode_table.NE, loaded, none.ok);
        val probe: Block = builder.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
        fork(?w, has, probe, body_k, Slice[Value]{data: ?unread[0], size: 2});
        builder.at_end(?w.s.bld, probe);
    }
    val saved:   Value                     = read(?w);
    val cleared: res[Value, refusal.Error] = off(?w, saved);
    if (sel cleared.err) { ret res[bool, refusal.Error].err{cleared.err}; }
    var kept:   [2]Value = [2]Value{no.ok, saved};
    var turned: [2]Value = [2]Value{yes.ok, saved};
    fork(?w, cleared.ok, on_k, body_k, Slice[Value]{data: ?kept[0], size: 2});
    builder.at_end(?w.s.bld, on_k);
    set_on(?w);
    jump(?w, body_k, Slice[Value]{data: ?turned[0], size: 2});
    val opened: err[refusal.Error] = emit.done(?w.s);
    if (sel opened.err) { ret res[bool, refusal.Error].err{opened.err}; }

    val was:  Value = builder.parameter(?w.s.bld, body_k, 0);
    val held: Value = builder.parameter(?w.s.bld, body_k, 1);
    var e:    usize = 0;
    for (e < exits.len) {
        val at: opt[Block] = place_of(got.ok, exits.data[e]);
        if (sel at.some) {
            val k:    Block              = at.some;
            val n:    u32                = (got.ok.blocks.data[k].instructions.len - 1)::u32;
            val back: Block              = builder.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
            val out:  Block              = builder.block(?w.s.bld, Slice[Declaration]{data: nil, size: 0});
            val done: err[refusal.Error] = emit.done(?w.s);
            if (sel done.err) { ret res[bool, refusal.Error].err{done.err}; }
            val left: err[refusal.Error] = refusal.edit(body.move(c.m, u.f, k, n, out));
            if (sel left.err) { ret res[bool, refusal.Error].err{left.err}; }
            builder.at_end(?w.s.bld, k);
            fork(?w, was, back, out, no_values());
            builder.at_end(?w.s.bld, back);
            restore(?w, held);
            jump(?w, out, no_values());
        }
        e = e + 1;
    }
    val closed: err[refusal.Error] = emit.done(?w.s);
    if (sel closed.err) { ret res[bool, refusal.Error].err{closed.err}; }
    ret res[bool, refusal.Error].ok{true};
}
