# the pass: it adds and removes instructions and entry parameters and never
# touches the graph. it classifies through the build's convention, so it is
# a lowering, which only a family's rows run
pub val ABI: Lowering = Lowering{name: "abi", kind: Kind.legalise{}, scope: Lowered.module{run}, preserves: analysis.FLOW, time: Time.keeps{}, applies: convened};

# a target's calls are lowered where its convention is a row
fun convened(g: *Ground) bool {
    ret sel g.t.convention.rows;
}

# one function's lowering
# ---
# m:          the module
# t:          the target, whose capabilities bound the words a copy moves
# basis:      the build's selection, which says which float formats it holds
# build:      the build
# passages:   the module's signatures placed under the build's rows
# convention: the row the entry, return or call being lowered is under, the
#             one its signature names, set as it is classified
# l:          the module's data layout
# f:          the function
# entry:      its entry block
# slots:      the stack slots made at the entry's head so far
# ptr:        the pointer type an address has
# slot:       the pointer type a stack slot's address has, into the target's
#             slot space
# offset:     the integer type an address offset has
# unused:     aggregate loads the pass read pieces from, which go once unused
# carrier:    the parameter the caller's result address arrives in, when a
#             result travels by reference
# storage:    the instruction that addresses the result's memory through the
#             carrier, made once a variable is bound to that memory
rec Work {
    m:          *Module;
    t:          *Target;
    basis:      opt[*Basis];
    build:      *Build;
    passages:   *Passages;
    convention: *Resolved;
    l:          *Layout;
    f:          Function;
    entry:      Block;
    slots:      u32;
    ptr:        Type;
    slot:       Type;
    offset:     Type;
    unused:     Vector[Instruction];
    carrier:    opt[Value];
    storage:    opt[Instruction];
}

fun body_of(w: *Work) *Body {
    ret ?w.m.functions.data[w.f].body;
}

fun ir(r: err[module.Error]) err[refusal.Error] {
    ret refusal.edit(r);
}

fun shape_of(w: *Work, ty: Type) res[table.Shape, refusal.Error] {
    val s: res[table.Shape, table.Error] = table.shape(?w.m.types, ty);
    if (sel s.err) { ret res[table.Shape, refusal.Error].err{refusal.Error.ir{module.Error.types{s.err}}}; }
    ret res[table.Shape, refusal.Error].ok{s.ok};
}

fun intern(w: *Work, s: table.Shape) res[Type, refusal.Error] {
    val t: res[Type, table.Error] = table.intern(?w.m.types, s);
    if (sel t.err) { ret res[Type, refusal.Error].err{refusal.Error.ir{module.Error.types{t.err}}}; }
    ret res[Type, refusal.Error].ok{t.ok};
}

fun integer_type(w: *Work, width: u32) res[Type, refusal.Error] {
    ret intern(w, table.Shape.integer{table.Integer{width: width}});
}

# whether a type is held in memory rather than as one scalar
fun aggregate(s: table.Shape) bool {
    ret sel s.array || sel s.structure || sel s.union;
}

# whether a value travels through memory: an aggregate, a vector in more than
# one piece, or a vector no unit of the build holds whole on a target that
# states its units
fun through_memory(w: *Work, s: *table.Shape, pieces: u32) res[bool, refusal.Error] {
    if (sel s.array || sel s.structure || sel s.union) { ret res[bool, refusal.Error].ok{true}; }
    if (!(sel s.vector))                               { ret res[bool, refusal.Error].ok{false}; }
    if (pieces > 1)                                    { ret res[bool, refusal.Error].ok{true}; }
    if (sel w.t.caps.vectors.unstated)                 { ret res[bool, refusal.Error].ok{false}; }
    val whole: res[bool, refusal.Error] = lanes.whole(?w.m.types, basis.context_of(w.basis), ?w.t.caps, s.vector);
    if (sel whole.err) { ret res[bool, refusal.Error].err{whole.err}; }
    ret res[bool, refusal.Error].ok{!whole.ok};
}

# the bits of a float of a type read or written as its encoding, for a piece
# of a size: none where the format has that size and the build holds it, so
# it moves as it is
fun encoded(w: *Work, ty: Type, size: u64) res[opt[Type], refusal.Error] {
    val own: res[u64, refusal.Error] = size_of(w, ty);
    if (sel own.err)                      { ret res[opt[Type], refusal.Error].err{own.err}; }
    if (own.ok == size && !unheld(w, ty)) { ret res[opt[Type], refusal.Error].ok{opt[Type].none{}}; }
    val bits: res[Type, refusal.Error] = integer_type(w, (own.ok * 8)::u32);
    if (sel bits.err) { ret res[opt[Type], refusal.Error].err{bits.err}; }
    ret res[opt[Type], refusal.Error].ok{opt[Type].some{bits.ok}};
}

fun size_of(w: *Work, ty: Type) res[u64, refusal.Error] {
    val s: res[u64, target_record.Error] = layout.size(w.l, ty, table.DEFAULT_SPACE);
    if (sel s.err) { ret res[u64, refusal.Error].err{refusal.Error.reason{"a value of a call with no size in memory"}}; }
    ret res[u64, refusal.Error].ok{s.ok};
}

fun align_of(w: *Work, ty: Type) res[u64, refusal.Error] {
    val s: res[u64, target_record.Error] = layout.align(w.l, ty, table.DEFAULT_SPACE);
    if (sel s.err) { ret res[u64, refusal.Error].err{refusal.Error.reason{"a value of a call with no alignment in memory"}}; }
    ret res[u64, refusal.Error].ok{s.ok};
}

# the widest access a copy makes, in bytes
val WORD: u64 = 8;

# the alignment an access at an offset from storage aligned to align has
fun aligned_at(align: u64, offset: u64) u64 {
    ret moves.aligned_at(align, offset);
}

# the least legal integer width that holds this many bytes
fun width_for(bytes: u64) u32 {
    var i: usize = 0;
    for (i < $length_of(table.Widths)) {
        if (table.WIDTHS[i]::u64 >= bytes * 8) { ret table.WIDTHS[i]; }
        i = i + 1;
    }
    ret 0;
}

# a constant integer of a type in the function
fun integer(w: *Work, ty: Type, x: u64) res[Value, refusal.Error] {
    val width: res[u32, table.Error] = table.width(?w.m.types, ty);
    if (sel width.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{module.Error.types{width.err}}}; }
    val n:    usize                      = word.words_for(width.ok)::usize;
    val room: res[*u64, allocator.Error] = allocator.zallocate[u64](w.m.a, n);
    if (sel room.err) { ret res[Value, refusal.Error].err{refusal.Error.alloc{room.err}}; }
    room.ok[0] = x;
    val made: res[Constant, module.Error] = module.add_constant(w.m, ConstantData.integer{Bits{type: ty, words: Slice[u64]{data: room.ok, size: n}}});
    allocator.deallocate[u64](w.m.a, room.ok, n);
    if (sel made.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{made.err}}; }
    val at: res[Value, module.Error] = body.constant(w.m, w.f, made.ok);
    if (sel at.err) { ret res[Value, refusal.Error].err{refusal.Error.ir{at.err}}; }
    ret res[Value, refusal.Error].ok{at.ok};
}

fun no_immediates() Slice[Immediate] {
    ret Slice[Immediate]{data: nil, size: 0};
}

fun no_targets() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

fun make(bld: *Builder, code: Opcode, operands: Slice[Value], immediates: Slice[Immediate]) Value {
    ret builder.value(bld, Request{opcode: code, operands: operands, immediates: immediates, targets: no_targets()});
}

fun unary(bld: *Builder, code: Opcode, v: Value, to: Type) Value {
    var ops: [1]Value     = [1]Value{v};
    var imm: [1]Immediate = [1]Immediate{Immediate.ty{to}};
    ret make(bld, code, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 1});
}

fun binary(bld: *Builder, code: Opcode, a: Value, b: Value) Value {
    var ops: [2]Value = [2]Value{a, b};
    ret make(bld, code, Slice[Value]{data: ?ops[0], size: 2}, no_immediates());
}

fun load(bld: *Builder, address: Value, ty: Type, align: u64) Value {
    var ops: [1]Value     = [1]Value{address};
    var imm: [2]Immediate = [2]Immediate{Immediate.ty{ty}, Immediate.alignment{align}};
    ret make(bld, opcode_table.LOAD, Slice[Value]{data: ?ops[0], size: 1}, Slice[Immediate]{data: ?imm[0], size: 2});
}

fun store(bld: *Builder, address: Value, v: Value, align: u64) {
    var ops: [2]Value     = [2]Value{address, v};
    var imm: [1]Immediate = [1]Immediate{Immediate.alignment{align}};
    builder.emit(bld, Request{opcode: opcode_table.STORE, operands: Slice[Value]{data: ?ops[0], size: 2}, immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
}

# the address an offset past another, as secret as the base alone: the
# offset follows from types, so a piece of a secret value has a public address
fun address(w: *Work, bld: *Builder, base: Value, offset: u64) res[Value, refusal.Error] {
    if (offset == 0) { ret res[Value, refusal.Error].ok{base}; }
    val k: res[Value, refusal.Error] = integer(w, w.offset, offset);
    if (sel k.err) { ret k; }
    val kept: bool = bld.secret;
    builder.secret(bld, body_of(w).values.data[base].secret);
    val v: Value = binary(bld, opcode_table.PTR_ADD, base, k.ok);
    builder.secret(bld, kept);
    ret res[Value, refusal.Error].ok{v};
}

fun built(bld: *Builder) err[refusal.Error] {
    val done: err[failure.Error] = builder.done(bld);
    if (sel done.err) { ret err[refusal.Error].err{refusal.Error.build{done.err}}; }
    ret err[refusal.Error].ok{};
}

# a stack slot of a type at the entry's head, where every slot the pass makes
# stands, so it dominates every use
fun slot(w: *Work, ty: Type, align: u64) res[Value, refusal.Error] {
    var bld: Builder = builder.init(w.m);
    builder.enter(?bld, w.f);
    builder.at(?bld, w.entry, 0);
    var imm: [3]Immediate       = [3]Immediate{Immediate.ty{ty}, Immediate.ty{w.slot}, Immediate.alignment{align}};
    val v:   Value              = make(?bld, opcode_table.ALLOCA, Slice[Value]{data: nil, size: 0}, Slice[Immediate]{data: ?imm[0], size: 3});
    val ok:  err[refusal.Error] = built(?bld);
    if (sel ok.err) { ret res[Value, refusal.Error].err{ok.err}; }
    w.slots = w.slots + 1;
    ret res[Value, refusal.Error].ok{v};
}

# the position of a placed instruction in its block
fun position(b: *Body, k: Block, i: Instruction) u32 {
    val list_of: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    var p:       usize                       = 0;
    for (p < list_of.len && list_of.data[p] != i) { p = p + 1; }
    ret p::u32;
}

fun block_of(b: *Body, i: Instruction) Block {
    val at: Spot = b.instructions.data[i].place;
    if (sel at.placed) { ret at.placed; }
    ret 0;
}

# the kind of register a place is in, none for a place that is no register
fun kind_of(w: *Work, p: Place) opt[rf.Kind] {
    if (!(sel p.register)) { ret opt[rf.Kind].none{}; }
    val regs: *Registers = held(w.convention);
    if (regs == nil) { ret opt[rf.Kind].none{}; }
    val file: *rf.File = regs.context.view.file;
    val c:    u16      = rf.class_of(p.register);
    if (file == nil || c::u32 >= file.class_count) { ret opt[rf.Kind].none{}; }
    ret opt[rf.Kind].some{file.classes[c].kind};
}

# whether a scalar of a shape travels in a place as it is: a float in a float
# or vector register, a vector in a vector register, as aarch64's v registers
# take both, and an integer or a pointer in a general one
fun fits(w: *Work, s: table.Shape, p: Place) bool {
    val k: opt[rf.Kind] = kind_of(w, p);
    if (sel k.none)           { ret true; }
    if (k.some == rf.FLOAT)   { ret sel s.float; }
    if (k.some == rf.VECTOR)  { ret sel s.float || sel s.vector; }
    if (k.some == rf.GENERAL) { ret sel s.integer || sel s.pointer; }
    ret false;
}

# the type of a piece: the value's own when it carries the scalar whole in a
# place that holds it as it is, the narrowest float that holds its bytes in a
# float or vector register, the place's other bytes undefined, or two 64 bit
# lanes for 16 bytes in a vector register, and otherwise the integer that
# holds its bytes
fun piece_type(w: *Work, side: Side, p: Piece, of: Type, whole: bool) res[Type, refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, of);
    if (sel s.err)                       { ret res[Type, refusal.Error].err{s.err}; }
    if (whole && fits(w, s.ok, p.place)) { ret res[Type, refusal.Error].ok{of}; }
    val k: opt[rf.Kind] = kind_of(w, p.place);
    if (sel k.some) {
        if (k.some == rf.FLOAT || k.some == rf.VECTOR) {
            if (p.size <= 2) { ret intern(w, table.Shape.float{table.Float{format: type_format.BINARY16}}); }
            if (p.size <= 4) { ret intern(w, table.Shape.float{table.Float{format: type_format.BINARY32}}); }
            if (p.size <= 8) { ret intern(w, table.Shape.float{table.Float{format: type_format.BINARY64}}); }
            if (k.some == rf.VECTOR && p.size == 16) {
                val lane: res[Type, refusal.Error] = integer_type(w, 64);
                if (sel lane.err) { ret lane; }
                ret intern(w, table.Shape.vector{table.Vector{lanes: 2, element: lane.ok}});
            }
            ret res[Type, refusal.Error].err{refusal.Error.pieces{Uncarried.size{side}}};
        }
        if (k.some != rf.GENERAL) { ret res[Type, refusal.Error].err{refusal.Error.pieces{Uncarried.kind{side}}}; }
    }
    if (sel p.place.operand) {
        val member: opt[Type] = carried(w.l, of, p.offset, p.size);
        if (sel member.some) { ret res[Type, refusal.Error].ok{member.some}; }
    }
    val width: u32 = width_for(p.size);
    if (width == 0) { ret res[Type, refusal.Error].err{refusal.Error.pieces{Uncarried.size{side}}}; }
    ret integer_type(w, width);
}

# the scalar member of a value that lies at an offset with a size, found
# through its structures, unions and arrays, none when no one scalar does:
# under stack evaluation an operand is one of the machine's own values, so a
# piece carrying a scalar member whole travels as that member's type, as
# wasm's basic c abi passes a struct of one float as an f32
# ---
# l:      the layout
# ty:     the value's type
# offset: the bytes into the value the piece starts at
# size:   the bytes it carries
pub fun carried(l: *Layout, ty: Type, offset: u64, size: u64) opt[Type] {
    val s: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret opt[Type].none{}; }
    val shape: table.Shape = s.ok;
    if (sel shape.integer || sel shape.float || sel shape.pointer) {
        val own: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
        if (sel own.err)                   { ret opt[Type].none{}; }
        if (offset == 0 && own.ok == size) { ret opt[Type].some{ty}; }
        ret opt[Type].none{};
    }
    if (sel shape.structure) {
        var i: usize = 0;
        for (i < shape.structure.members.size) {
            val at:   res[u64, target_record.Error] = layout.offset(l, ty, table.DEFAULT_SPACE, i::u32);
            val room: res[u64, target_record.Error] = layout.size(l, shape.structure.members.data[i], table.DEFAULT_SPACE);
            if (sel at.err)                                          { ret opt[Type].none{}; }
            if (sel room.err)                                        { ret opt[Type].none{}; }
            if (offset >= at.ok && offset + size <= at.ok + room.ok) { ret carried(l, shape.structure.members.data[i], offset - at.ok, size); }
            i = i + 1;
        }
        ret opt[Type].none{};
    }
    if (sel shape.union) {
        var j: usize = 0;
        for (j < shape.union.members.size) {
            val member: opt[Type] = carried(l, shape.union.members.data[j], offset, size);
            if (sel member.some) { ret member; }
            j = j + 1;
        }
        ret opt[Type].none{};
    }
    if (sel shape.array) {
        val step: res[u64, target_record.Error] = layout.stride(l, ty, table.DEFAULT_SPACE);
        if (sel step.err) { ret opt[Type].none{}; }
        if (step.ok == 0) { ret opt[Type].none{}; }
        ret carried(l, shape.array.element, offset % step.ok, size);
    }
    ret opt[Type].none{};
}

# an instruction forming a piece from bytes the pass moves, which carries no secrecy mark: a mark would declare the
# register it writes secret whatever the bytes hold (`machine/emit/handover.seed_results`), where the walk takes the
# secrecy of what it computes from the loads, each marked as the value is
fun derived_unary(bld: *Builder, code: Opcode, v: Value, to: Type) Value {
    val marked: bool = bld.secret;
    builder.secret(bld, false);
    val x: Value = unary(bld, code, v, to);
    builder.secret(bld, marked);
    ret x;
}

fun derived_binary(bld: *Builder, code: Opcode, a: Value, b: Value) Value {
    val marked: bool = bld.secret;
    builder.secret(bld, false);
    val x: Value = binary(bld, code, a, b);
    builder.secret(bld, marked);
    ret x;
}

# a load stated public where `public`, as the access the bytes it reads were loaded by states them
fun stated_load(bld: *Builder, address: Value, ty: Type, align: u64, public: bool) Value {
    var f: Flags = NO_FLAGS;
    f.public = public;
    builder.flags(bld, f);
    val x: Value = load(bld, address, ty, align);
    builder.flags(bld, NO_FLAGS);
    ret x;
}

# read a piece of a size from memory into a type, in the widest words that
# fit it when no integer has its size, a float it moves as its encoding
# reinterpreted, each load stated public where `public`
fun read(w: *Work, bld: *Builder, base: Value, offset: u64, size: u64, align: u64, ty: Type, public: bool) res[Value, refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[Value, refusal.Error].err{s.err}; }
    if (sel s.ok.float) {
        val bits: res[opt[Type], refusal.Error] = encoded(w, ty, size);
        if (sel bits.err) { ret res[Value, refusal.Error].err{bits.err}; }
        if (sel bits.ok.some) {
            val raw: res[Value, refusal.Error] = read(w, bld, base, offset, size, align, bits.ok.some, public);
            if (sel raw.err) { ret raw; }
            ret res[Value, refusal.Error].ok{derived_unary(bld, opcode_table.BITCAST, raw.ok, ty)};
        }
    }
    var exact: bool = true;
    if (sel s.ok.integer) { exact = s.ok.integer.width::u64 == size * 8; }
    if (exact) {
        val at: res[Value, refusal.Error] = address(w, bld, base, offset);
        if (sel at.err) { ret at; }
        ret res[Value, refusal.Error].ok{stated_load(bld, at.ok, ty, aligned_at(align, offset), public)};
    }
    var acc:  Value = 0;
    var any:  bool  = false;
    var done: u64   = 0;
    var word: u64   = 8;
    for (word > 0) {
        for (size - done >= word) {
            val narrow: res[Type, refusal.Error] = integer_type(w, (word * 8)::u32);
            if (sel narrow.err) { ret res[Value, refusal.Error].err{narrow.err}; }
            val at: res[Value, refusal.Error] = address(w, bld, base, offset + done);
            if (sel at.err) { ret at; }
            var part: Value = derived_unary(bld, opcode_table.EXT_U, stated_load(bld, at.ok, narrow.ok, aligned_at(align, offset + done), public), ty);
            if (done > 0) {
                val by: res[Value, refusal.Error] = integer(w, ty, done * 8);
                if (sel by.err) { ret by; }
                part = derived_binary(bld, opcode_table.SHL, part, by.ok);
            }
            if (any) { acc = derived_binary(bld, opcode_table.OR, acc, part); }
            or       { acc = part; }
            any  = true;
            done = done + word;
        }
        word = word / 2;
    }
    if (!any) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a piece of no bytes"}}; }
    ret res[Value, refusal.Error].ok{acc};
}

# the bytes of `[lo, lo + n)` of a value's memory image that a member of type `ty` laid at `at` holds, one bit for each
# from bit 0, none where the layout states no size or place. a byte no member holds is padding, which nothing need
# ever write
fun held_bytes(l: *Layout, ty: Type, at: u64, lo: u64, n: u64) opt[u64] {
    val res_shape: res[table.Shape, table.Error] = table.shape(l.types, ty);
    if (sel res_shape.err) { ret opt[u64].none{}; }
    val shape: table.Shape = res_shape.ok;
    if (sel shape.structure) {
        var mask: u64   = 0;
        var i:    usize = 0;
        for (i < shape.structure.members.size) {
            val res_at: res[u64, target_record.Error] = layout.offset(l, ty, table.DEFAULT_SPACE, i::u32);
            if (sel res_at.err) { ret opt[u64].none{}; }
            val opt_member: opt[u64] = held_bytes(l, shape.structure.members.data[i], at + res_at.ok, lo, n);
            if (sel opt_member.none) { ret opt_member; }
            mask = mask | opt_member.some;
            i    = i + 1;
        }
        ret opt[u64].some{mask};
    }
    if (sel shape.union) {
        var mask: u64   = 0;
        var j:    usize = 0;
        for (j < shape.union.members.size) {
            val opt_member: opt[u64] = held_bytes(l, shape.union.members.data[j], at, lo, n);
            if (sel opt_member.none) { ret opt_member; }
            mask = mask | opt_member.some;
            j    = j + 1;
        }
        ret opt[u64].some{mask};
    }
    if (sel shape.array) {
        val res_step: res[u64, target_record.Error] = layout.stride(l, ty, table.DEFAULT_SPACE);
        if (sel res_step.err) { ret opt[u64].none{}; }
        var mask: u64 = 0;
        var k:    u64 = 0;
        for (k < shape.array.count) {
            val start: u64 = at + k * res_step.ok;
            if (start >= lo + n) { brk; }
            val opt_element: opt[u64] = held_bytes(l, shape.array.element, start, lo, n);
            if (sel opt_element.none) { ret opt_element; }
            mask = mask | opt_element.some;
            k    = k + 1;
        }
        ret opt[u64].some{mask};
    }
    val res_size: res[u64, target_record.Error] = layout.size(l, ty, table.DEFAULT_SPACE);
    if (sel res_size.err) { ret opt[u64].none{}; }
    var mask: u64 = 0;
    var b:    u64 = at;
    for (b < at + res_size.ok) {
        if (b >= lo && b < lo + n) { mask = mask | (1::u64 << (b - lo)); }
        b = b + 1;
    }
    ret opt[u64].some{mask};
}

# read a piece of a value of type `of` from memory into a type: an integer piece reads only the bytes the value's
# members hold, its bits over padding zero, so no piece reads memory a store of the value need not have written and
# no register carries stale padding out. any other piece, or one with no padding, is `read`. each load is stated public
# where `public`, as the access the value was loaded by states its bytes
fun read_piece(w: *Work, bld: *Builder, base: Value, of: Type, p: Piece, align: u64, ty: Type, public: bool) res[Value, refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[Value, refusal.Error].err{s.err}; }
    val plain: bool = !(sel s.ok.integer) || p.size > 8 || p.size == 0;
    if (plain) { ret read(w, bld, base, p.offset, p.size, align, ty, public); }
    val opt_held: opt[u64] = held_bytes(w.l, of, 0, p.offset, p.size);
    if (sel opt_held.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"a piece of a value whose layout states no place for a member"}}; }
    val held: u64 = opt_held.some;
    val full: u64 = (1::u64 << p.size) - 1;
    if (held == full) { ret read(w, bld, base, p.offset, p.size, align, ty, public); }
    var acc:   Value = 0;
    var any:   bool  = false;
    var start: u64   = 0;
    for (start < p.size) {
        if (((held >> start) & 1) == 0) {
            start = start + 1;
            cnt;
        }
        var end: u64 = start;
        for (end < p.size && ((held >> end) & 1) != 0) { end = end + 1; }
        val res_run: res[Value, refusal.Error] = read(w, bld, base, p.offset + start, end - start, align, ty, public);
        if (sel res_run.err) { ret res_run; }
        var part: Value = res_run.ok;
        if (start > 0) {
            val by: res[Value, refusal.Error] = integer(w, ty, start * 8);
            if (sel by.err) { ret by; }
            part = derived_binary(bld, opcode_table.SHL, part, by.ok);
        }
        if (any) { acc = derived_binary(bld, opcode_table.OR, acc, part); }
        or       { acc = part; }
        any   = true;
        start = end;
    }
    if (!any) { ret integer(w, ty, 0); }
    ret res[Value, refusal.Error].ok{acc};
}

# write a piece of a size to memory, in the widest words that fit it when no
# integer has its size, a float it moves as its encoding reinterpreted
fun write(w: *Work, bld: *Builder, base: Value, offset: u64, size: u64, align: u64, v: Value, ty: Type) err[refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    if (sel s.ok.float) {
        val bits: res[opt[Type], refusal.Error] = encoded(w, ty, size);
        if (sel bits.err)     { ret err[refusal.Error].err{bits.err}; }
        if (sel bits.ok.some) { ret write(w, bld, base, offset, size, align, derived_unary(bld, opcode_table.BITCAST, v, bits.ok.some), bits.ok.some); }
    }
    var exact: bool = true;
    if (sel s.ok.integer) { exact = s.ok.integer.width::u64 == size * 8; }
    if (exact) {
        val at: res[Value, refusal.Error] = address(w, bld, base, offset);
        if (sel at.err) { ret err[refusal.Error].err{at.err}; }
        store(bld, at.ok, v, aligned_at(align, offset));
        ret err[refusal.Error].ok{};
    }
    var done: u64 = 0;
    var word: u64 = 8;
    for (word > 0) {
        for (size - done >= word) {
            val narrow: res[Type, refusal.Error] = integer_type(w, (word * 8)::u32);
            if (sel narrow.err) { ret err[refusal.Error].err{narrow.err}; }
            var part: Value = v;
            if (done > 0) {
                val by: res[Value, refusal.Error] = integer(w, ty, done * 8);
                if (sel by.err) { ret err[refusal.Error].err{by.err}; }
                part = derived_binary(bld, opcode_table.SHR_U, part, by.ok);
            }
            part = derived_unary(bld, opcode_table.TRUNC, part, narrow.ok);
            val at: res[Value, refusal.Error] = address(w, bld, base, offset + done);
            if (sel at.err) { ret err[refusal.Error].err{at.err}; }
            store(bld, at.ok, part, aligned_at(align, offset + done));
            done = done + word;
        }
        word = word / 2;
    }
    ret err[refusal.Error].ok{};
}

# copy bytes from one storage to another, nothing when they are one storage,
# as a result built in place is. the copy is in words or one `mem.copy`, as
# mirl.legal.moves decides. the storage copied to is a slot the pass makes, the
# outgoing area or the result's memory the caller passes, none of which the
# memory copied from can be, so the copy runs in either order
fun copy(w: *Work, bld: *Builder, from: Value, to: Value, size: u64, align: u64) err[refusal.Error] {
    if (from == to) { ret err[refusal.Error].ok{}; }
    if (!moves.in_words(?w.t.caps, size, align, WORD)) {
        val length: res[Value, refusal.Error] = integer(w, w.offset, size);
        if (sel length.err) { ret err[refusal.Error].err{length.err}; }
        var ops:   [3]Value     = [3]Value{to, from, length.ok};
        var imm:   [1]Immediate = [1]Immediate{Immediate.alignment{align}};
        var apart: Flags        = NO_FLAGS;
        apart.ascending  = true;
        apart.descending = true;
        builder.flags(bld, apart);
        builder.emit(bld, Request{opcode: opcode_table.MEM_COPY, operands: Slice[Value]{data: ?ops[0], size: 3}, immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
        builder.flags(bld, NO_FLAGS);
        ret err[refusal.Error].ok{};
    }
    var done: u64 = 0;
    for (done < size) {
        val at:   u64                      = aligned_at(align, done);
        val step: u64                      = moves.step(size - done, at, WORD);
        val ty:   res[Type, refusal.Error] = integer_type(w, (step * 8)::u32);
        if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
        val src: res[Value, refusal.Error] = address(w, bld, from, done);
        if (sel src.err) { ret err[refusal.Error].err{src.err}; }
        val dst: res[Value, refusal.Error] = address(w, bld, to, done);
        if (sel dst.err) { ret err[refusal.Error].err{dst.err}; }
        store(bld, dst.ok, load(bld, src.ok, ty.ok, at), at);
        done = done + step;
    }
    ret err[refusal.Error].ok{};
}

# the load a value is, when the pass may read its memory in its place: one
# neither volatile nor kept, so its memory is the value's at its point
fun loaded(w: *Work, v: Value) opt[Instruction] {
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[v].def;
    if (!(sel def.result)) { ret opt[Instruction].none{}; }
    val i: Instruction      = def.result.instruction;
    val d: *InstructionData = ?b.instructions.data[i];
    if (d.opcode != opcode_table.LOAD)                      { ret opt[Instruction].none{}; }
    if (d.metadata.flags.volatile || d.metadata.flags.kept) { ret opt[Instruction].none{}; }
    if (!(sel d.place.placed))                              { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{i};
}

# the load a value that travels by reference is copied from, at the load: an
# aggregate's, when it is in the block of the instruction the value travels
# at and so runs once for each time that instruction does. none when the value
# is stored whole just ahead of that instruction
fun copied_from(w: *Work, x: Sent, at: Instruction) opt[Instruction] {
    if (!aggregate(x.shape)) { ret opt[Instruction].none{}; }
    val from: opt[Instruction] = loaded(w, x.value);
    if (sel from.none) { ret from; }
    val b: *Body = body_of(w);
    if (block_of(b, from.some) != block_of(b, at)) { ret opt[Instruction].none{}; }
    ret from;
}

fun note_unused(w: *Work, i: Instruction) err[refusal.Error] {
    var k: usize = 0;
    for (k < w.unused.len) {
        if (w.unused.data[k] == i) { ret err[refusal.Error].ok{}; }
        k = k + 1;
    }
    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?w.unused, i);
    if (sel pushed.err) { ret refusal.lost(pushed.err); }
    ret err[refusal.Error].ok{};
}

# where a value by value lies whole in the argument area: an aggregate every
# piece of which is a fixed stack place, one after the other from its first
# byte to its last, so its bytes there are its memory image. such a value
# travels as one block, copied to the area once by the caller and read in
# place by the callee, with no piece in the signature. it does so only where
# the target has a bulk copy instruction, so a copy to the area past the bound
# is one instruction just ahead of the call it serves
# ---
# ret: the offset of its first byte in the area, or none when it travels in
#      pieces
fun laid(w: *Work, ty: Type, passed: Passed, asg: *Assignment) res[opt[u64], refusal.Error] {
    val none: res[opt[u64], refusal.Error] = res[opt[u64], refusal.Error].ok{opt[u64].none{}};
    if (!(sel passed.passing.value) || passed.count < 2) { ret none; }
    if (sel w.t.caps.bulk.copy.none)                     { ret none; }
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err)        { ret res[opt[u64], refusal.Error].err{s.err}; }
    if (!aggregate(s.ok)) { ret none; }
    val size: res[u64, refusal.Error] = size_of(w, ty);
    if (sel size.err) { ret res[opt[u64], refusal.Error].err{size.err}; }
    val head: Place = piece.piece(asg, passed.first).place;
    if (!(sel head.stack)) { ret none; }
    val base: u64 = head.stack.offset;
    var done: u64 = 0;
    var n:    u32 = 0;
    for (n < passed.count) {
        val p:     Piece = piece.piece(asg, passed.first + n);
        val place: Place = p.place;
        if (!(sel place.stack))                                     { ret none; }
        if (!(sel p.scale.fixed) || !(sel place.stack.scale.fixed)) { ret none; }
        if (p.offset != done || place.stack.offset != base + done)  { ret none; }
        done = done + p.size;
        n    = n + 1;
    }
    if (done != size.ok) { ret none; }
    ret res[opt[u64], refusal.Error].ok{opt[u64].some{base}};
}

# the address of a value laid whole in the argument area at an offset, the
# function's own incoming one or the outgoing one of the call the builder
# stands ahead of
fun area(w: *Work, bld: *Builder, ty: Type, offset: u64, incoming: bool) Value {
    var places: [1]Placed    = [1]Placed{Placed{place: stacked(offset), scale: Scale.fixed{}, fill: Fill.exact{}}};
    var imm:    [3]Immediate = [3]Immediate{Immediate.ty{ty}, Immediate.ty{w.slot}, Immediate.places{Slice[Placed]{data: ?places[0], size: 1}}};
    var code:   Opcode       = opcode_table.ARG_OUTGOING;
    if (incoming) { code = opcode_table.ARG_INCOMING; }
    ret make(bld, code, Slice[Value]{data: nil, size: 0}, Slice[Immediate]{data: ?imm[0], size: 3});
}

# whether an instruction writes the outgoing argument area alone: a copy or a
# store whose address is the area's
fun fills_area(w: *Work, i: Instruction) bool {
    val b: *Body            = body_of(w);
    val d: *InstructionData = ?b.instructions.data[i];
    if (d.opcode != opcode_table.MEM_COPY && d.opcode != opcode_table.STORE) { ret false; }
    if (d.operands.len == 0)                                                 { ret false; }
    val made: opt[Instruction] = made_by(w, overlap.root_of(body_of(w), d.operands.data[0]), opcode_table.ARG_OUTGOING);
    ret sel made.some;
}

# whether the memory a load read still holds what it read at a later
# instruction of its block: nothing between the two writes memory but into
# the outgoing argument area, which no load the pass reads in place addresses
fun stands_until(w: *Work, l: Instruction, at: Instruction) bool {
    val b: *Body = body_of(w);
    val k: Block = block_of(b, l);
    if (block_of(b, at) != k) { ret false; }
    val from: u32 = position(b, k, l);
    val to:   u32 = position(b, k, at);
    if (to <= from) { ret false; }
    var p: u32 = from + 1;
    for (p < to) {
        val i:   Instruction          = b.blocks.data[k].instructions.data[p];
        val row: opt[*opcode_row.Row] = opcode_table.at(b.instructions.data[i].opcode);
        if (sel row.none)                                 { ret false; }
        if (row.some.effects.writes && !fills_area(w, i)) { ret false; }
        p = p + 1;
    }
    ret true;
}

# a value about to travel and what it travels from
# ---
# value:  the value
# ty:     its type
# shape:  its shape
# secret: whether it is secret
rec Sent {
    value:  Value;
    ty:     Type;
    shape:  table.Shape;
    secret: bool;
}

fun sent(w: *Work, v: Value) res[Sent, refusal.Error] {
    val b:  *Body                           = body_of(w);
    val ty: Type                            = b.values.data[v].type;
    val s:  res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[Sent, refusal.Error].err{s.err}; }
    ret res[Sent, refusal.Error].ok{Sent{value: v, ty: ty, shape: s.ok, secret: b.values.data[v].secret}};
}

# the pieces of one value that travels out, at the end of out, with their
# places
# ---
# w:      the lowering
# bld:    the builder, ahead of the instruction the value travels at
# at:     that instruction
# side:   which value it is, for a refusal
# x:      the value
# passed: how it travels
# asg:    the assignment
# out:    the piece values
# places: where each travels
fun send(w: *Work, bld: *Builder, at: Instruction, side: Side, x: Sent, passed: Passed, asg: *Assignment, out: *Vector[Value], places: *Vector[Placed]) err[refusal.Error] {
    if (sel passed.passing.reference) {
        if (passed.count != 1) { ret err[refusal.Error].err{refusal.Error.reason{"a value by reference that travels in other than one piece"}}; }
        val c:    piece.Copy                = passed.passing.reference;
        val made: res[Value, refusal.Error] = slot(w, x.ty, c.align);
        if (sel made.err) { ret err[refusal.Error].err{made.err}; }
        val from: opt[Instruction] = copied_from(w, x, at);
        if (sel from.some) {
            val b:    *Body   = body_of(w);
            val k:    Block   = block_of(b, from.some);
            var near: Builder = builder.init(w.m);
            builder.enter(?near, w.f);
            builder.derive(?near, from.some);
            builder.secret(?near, x.secret);
            builder.at(?near, k, position(b, k, from.some) + 1);
            val copied: err[refusal.Error] = copy(w, ?near, b.instructions.data[from.some].operands.data[0], made.ok, c.size, c.align);
            if (sel copied.err) { ret copied; }
            val done: err[refusal.Error] = built(?near);
            if (sel done.err) { ret done; }
            val noted: err[refusal.Error] = note_unused(w, from.some);
            if (sel noted.err) { ret noted; }
        }
        or {
            val al: res[u64, refusal.Error] = align_of(w, x.ty);
            if (sel al.err) { ret err[refusal.Error].err{al.err}; }
            store(bld, made.ok, x.value, al.ok);
        }
        ret push(w, bld, out, places, made.ok, piece.piece(asg, passed.first));
    }
    if (passed.count == 0) { ret err[refusal.Error].ok{}; }
    if (sel side.argument) {
        val block: res[opt[u64], refusal.Error] = laid(w, x.ty, passed, asg);
        if (sel block.err) { ret err[refusal.Error].err{block.err}; }
        if (sel block.ok.some) {
            val size: res[u64, refusal.Error] = size_of(w, x.ty);
            if (sel size.err) { ret err[refusal.Error].err{size.err}; }
            val al: res[u64, refusal.Error] = align_of(w, x.ty);
            if (sel al.err) { ret err[refusal.Error].err{al.err}; }
            var source: Value            = x.value;
            var placed: bool             = false;
            val from:   opt[Instruction] = loaded(w, x.value);
            if (sel from.some) {
                if (stands_until(w, from.some, at)) {
                    source = body_of(w).instructions.data[from.some].operands.data[0];
                    placed = true;
                    val noted: err[refusal.Error] = note_unused(w, from.some);
                    if (sel noted.err) { ret noted; }
                }
            }
            if (!placed) {
                val home: res[Value, refusal.Error] = slot(w, x.ty, al.ok);
                if (sel home.err) { ret err[refusal.Error].err{home.err}; }
                val read: opt[Instruction] = copied_from(w, x, at);
                if (sel read.some) {
                    val b:    *Body   = body_of(w);
                    val k:    Block   = block_of(b, read.some);
                    var near: Builder = builder.init(w.m);
                    builder.enter(?near, w.f);
                    builder.derive(?near, read.some);
                    builder.secret(?near, x.secret);
                    builder.at(?near, k, position(b, k, read.some) + 1);
                    val copied: err[refusal.Error] = copy(w, ?near, b.instructions.data[read.some].operands.data[0], home.ok, size.ok, al.ok);
                    if (sel copied.err) { ret copied; }
                    val done: err[refusal.Error] = built(?near);
                    if (sel done.err) { ret done; }
                    val noted: err[refusal.Error] = note_unused(w, read.some);
                    if (sel noted.err) { ret noted; }
                }
                or { store(bld, home.ok, x.value, al.ok); }
                source = home.ok;
            }
            ret copy(w, bld, source, area(w, bld, x.ty, block.ok.some, false), size.ok, al.ok);
        }
    }
    val memory: res[bool, refusal.Error] = through_memory(w, ?x.shape, passed.count);
    if (sel memory.err) { ret err[refusal.Error].err{memory.err}; }
    if (!memory.ok) {
        val size: res[u64, refusal.Error] = size_of(w, x.ty);
        if (sel size.err) { ret err[refusal.Error].err{size.err}; }
        val p: Piece = piece.piece(asg, passed.first);
        if (passed.count == 1 && p.offset == 0 && p.size == size.ok) {
            val ty: res[Type, refusal.Error] = piece_type(w, side, p, x.ty, true);
            if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
            val v: res[Value, refusal.Error] = convert(w, bld, x.value, x.ty, ty.ok);
            if (sel v.err) { ret err[refusal.Error].err{v.err}; }
            ret push(w, bld, out, places, v.ok, p);
        }
        val bits: res[Type, refusal.Error] = integer_type(w, (size.ok * 8)::u32);
        if (sel bits.err) { ret err[refusal.Error].err{bits.err}; }
        val whole: res[Value, refusal.Error] = convert(w, bld, x.value, x.ty, bits.ok);
        if (sel whole.err) { ret err[refusal.Error].err{whole.err}; }
        var n: u32 = 0;
        for (n < passed.count) {
            val q: Piece = piece.piece(asg, passed.first + n);
            if (q.offset + q.size > size.ok) { ret err[refusal.Error].err{refusal.Error.pieces{Uncarried.partial{side}}}; }
            var part: Value = whole.ok;
            if (q.offset > 0) {
                val by: res[Value, refusal.Error] = integer(w, bits.ok, q.offset * 8);
                if (sel by.err) { ret err[refusal.Error].err{by.err}; }
                part = binary(bld, opcode_table.SHR_U, part, by.ok);
            }
            val narrow: res[Type, refusal.Error] = integer_type(w, width_for(q.size));
            if (sel narrow.err)                  { ret err[refusal.Error].err{narrow.err}; }
            if (!table.same(narrow.ok, bits.ok)) { part = unary(bld, opcode_table.TRUNC, part, narrow.ok); }
            val ty: res[Type, refusal.Error] = piece_type(w, side, q, x.ty, false);
            if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
            val v: res[Value, refusal.Error] = convert(w, bld, part, narrow.ok, ty.ok);
            if (sel v.err) { ret err[refusal.Error].err{v.err}; }
            val pushed: err[refusal.Error] = push(w, bld, out, places, v.ok, q);
            if (sel pushed.err) { ret pushed; }
            n = n + 1;
        }
        ret err[refusal.Error].ok{};
    }
    val al: res[u64, refusal.Error] = align_of(w, x.ty);
    if (sel al.err) { ret err[refusal.Error].err{al.err}; }
    val from: opt[Instruction] = loaded(w, x.value);
    if (sel from.some) {
        val b:    *Body   = body_of(w);
        val k:    Block   = block_of(b, from.some);
        var near: Builder = builder.init(w.m);
        builder.enter(?near, w.f);
        builder.derive(?near, from.some);
        builder.secret(?near, x.secret);
        builder.at(?near, k, position(b, k, from.some) + 1);
        val base:   Value         = b.instructions.data[from.some].operands.data[0];
        val stated: bool          = b.instructions.data[from.some].metadata.flags.public && !x.secret;
        var reads:  Vector[Value] = vector.init[Value](w.m.a);
        fin { vector.dnit[Value](?reads); }
        var n: u32 = 0;
        for (n < passed.count) {
            val p:  Piece                    = piece.piece(asg, passed.first + n);
            val ty: res[Type, refusal.Error] = piece_type(w, side, p, x.ty, false);
            if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
            val v: res[Value, refusal.Error] = read_piece(w, ?near, base, x.ty, p, al.ok, ty.ok, stated);
            if (sel v.err) { ret err[refusal.Error].err{v.err}; }
            val kept: res[usize, allocator.Error] = vector.push[Value](?reads, v.ok);
            if (sel kept.err) { ret refusal.lost(kept.err); }
            n = n + 1;
        }
        val done: err[refusal.Error] = built(?near);
        if (sel done.err) { ret done; }
        n = 0;
        for (n < passed.count) {
            val pushed: err[refusal.Error] = push(w, bld, out, places, reads.data[n], piece.piece(asg, passed.first + n));
            if (sel pushed.err) { ret pushed; }
            n = n + 1;
        }
        ret note_unused(w, from.some);
    }
    val home: res[Value, refusal.Error] = slot(w, x.ty, al.ok);
    if (sel home.err) { ret err[refusal.Error].err{home.err}; }
    store(bld, home.ok, x.value, al.ok);
    var n: u32 = 0;
    for (n < passed.count) {
        val p:  Piece                    = piece.piece(asg, passed.first + n);
        val ty: res[Type, refusal.Error] = piece_type(w, side, p, x.ty, false);
        if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
        val v: res[Value, refusal.Error] = read_piece(w, bld, home.ok, x.ty, p, al.ok, ty.ok, false);
        if (sel v.err) { ret err[refusal.Error].err{v.err}; }
        val pushed: err[refusal.Error] = push(w, bld, out, places, v.ok, p);
        if (sel pushed.err) { ret pushed; }
        n = n + 1;
    }
    ret err[refusal.Error].ok{};
}

# a scalar as another scalar of the same size: an integer and a pointer by
# their conversion, any other pair by its bits
fun convert(w: *Work, bld: *Builder, v: Value, from: Type, to: Type) res[Value, refusal.Error] {
    if (table.same(from, to)) { ret res[Value, refusal.Error].ok{v}; }
    val a: res[table.Shape, refusal.Error] = shape_of(w, from);
    if (sel a.err) { ret res[Value, refusal.Error].err{a.err}; }
    val b: res[table.Shape, refusal.Error] = shape_of(w, to);
    if (sel b.err) { ret res[Value, refusal.Error].err{b.err}; }
    if (sel a.ok.integer) {
        if (sel b.ok.integer) {
            if (a.ok.integer.width > b.ok.integer.width) { ret res[Value, refusal.Error].ok{unary(bld, opcode_table.TRUNC, v, to)}; }
            ret res[Value, refusal.Error].ok{unary(bld, opcode_table.EXT_U, v, to)};
        }
    }
    if (sel a.ok.pointer && sel b.ok.integer) { ret res[Value, refusal.Error].ok{unary(bld, opcode_table.PTRTOINT, v, to)}; }
    if (sel a.ok.integer && sel b.ok.pointer) { ret res[Value, refusal.Error].ok{unary(bld, opcode_table.INTTOPTR, v, to)}; }
    ret res[Value, refusal.Error].ok{unary(bld, opcode_table.BITCAST, v, to)};
}

# the bits of a place, the width a piece extended to fill it is made, 0 for
# a place no extension fills
fun place_bits(w: *Work, p: Place) u32 {
    if (sel p.register) {
        val regs: *Registers = held(w.convention);
        if (regs == nil) { ret 0; }
        val bits: res[opt[u64], rf.Absent] = rf.width(regs.context.view, p.register);
        if (sel bits.ok) {
            if (sel bits.ok.some) { ret bits.ok.some::u32; }
        }
        ret 0;
    }
    if (sel p.stack) {
        val bits: res[u32, table.Error] = table.width(?w.m.types, w.offset);
        if (sel bits.ok) { ret bits.ok; }
    }
    if (sel p.operand) {
        if (sel w.convention.row.word.bits) { ret w.convention.row.word.bits; }
    }
    ret 0;
}

# the width an integer piece of a width is extended to, which its fill says
# how to fill, none when it travels as it is
fun widened(w: *Work, p: Piece, width: u32) opt[u32] {
    if (!(sel p.fill.sign) && !(sel p.fill.zero)) { ret opt[u32].none{}; }
    val bits: u32 = place_bits(w, p.place);
    if (bits <= width) { ret opt[u32].none{}; }
    ret opt[u32].some{bits};
}

# a piece's place, its fill exact once the pass made the extension it states
fun placed_as(p: Piece, extended: bool) Placed {
    if (extended) { ret Placed{place: p.place, scale: p.scale, fill: Fill.exact{}}; }
    ret Placed{place: p.place, scale: p.scale, fill: p.fill};
}

# a piece and its place at the end of the lists, an integer the fill extends
# made the place's width by the extension, so its place holds it exact
fun push(w: *Work, bld: *Builder, out: *Vector[Value], places: *Vector[Placed], v: Value, p: Piece) err[refusal.Error] {
    var given:    Value                           = v;
    var extended: bool                            = false;
    val s:        res[table.Shape, refusal.Error] = shape_of(w, body_of(w).values.data[v].type);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    if (sel s.ok.integer) {
        val to: opt[u32] = widened(w, p, s.ok.integer.width);
        if (sel to.some) {
            val ty: res[Type, refusal.Error] = integer_type(w, to.some);
            if (sel ty.err)      { ret err[refusal.Error].err{ty.err}; }
            if (sel p.fill.sign) { given = unary(bld, opcode_table.EXT_S, v, ty.ok); }
            or                   { given = unary(bld, opcode_table.EXT_U, v, ty.ok); }
            extended = true;
        }
    }
    val a: res[usize, allocator.Error] = vector.push[Value](out, given);
    if (sel a.err) { ret refusal.lost(a.err); }
    val b: res[usize, allocator.Error] = vector.push[Placed](places, placed_as(p, extended));
    if (sel b.err) { ret refusal.lost(b.err); }
    ret err[refusal.Error].ok{};
}

fun place_of(places: *Vector[Placed], p: Piece) err[refusal.Error] {
    val b: res[usize, allocator.Error] = vector.push[Placed](places, Placed{place: p.place, scale: p.scale, fill: p.fill});
    if (sel b.err) { ret refusal.lost(b.err); }
    ret err[refusal.Error].ok{};
}

# the types of the pieces of one value that travels in, at the end of out,
# with their places
fun receive_types(w: *Work, side: Side, ty: Type, passed: Passed, asg: *Assignment, out: *Vector[Type], places: *Vector[Placed]) err[refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret err[refusal.Error].err{s.err}; }
    val memory: res[bool, refusal.Error] = through_memory(w, ?s.ok, passed.count);
    if (sel memory.err) { ret err[refusal.Error].err{memory.err}; }
    var whole: bool = false;
    if (!(sel passed.passing.reference) && !memory.ok && passed.count == 1) {
        val size: res[u64, refusal.Error] = size_of(w, ty);
        if (sel size.err) { ret err[refusal.Error].err{size.err}; }
        val p: Piece = piece.piece(asg, passed.first);
        whole = p.offset == 0 && p.size == size.ok;
    }
    if (sel passed.passing.reference && passed.count > 1) { ret err[refusal.Error].err{refusal.Error.reason{"a value by reference that travels in more than one piece"}}; }
    var n: u32 = 0;
    for (n < passed.count) {
        val p:        Piece = piece.piece(asg, passed.first + n);
        var t:        Type  = w.ptr;
        var extended: bool  = false;
        if (!(sel passed.passing.reference)) {
            val got: res[Type, refusal.Error] = piece_type(w, side, p, ty, whole);
            if (sel got.err) { ret err[refusal.Error].err{got.err}; }
            t = got.ok;
            val ps: res[table.Shape, refusal.Error] = shape_of(w, t);
            if (sel ps.err) { ret err[refusal.Error].err{ps.err}; }
            if (sel ps.ok.integer) {
                val to: opt[u32] = widened(w, p, ps.ok.integer.width);
                if (sel to.some) {
                    val wide: res[Type, refusal.Error] = integer_type(w, to.some);
                    if (sel wide.err) { ret err[refusal.Error].err{wide.err}; }
                    t        = wide.ok;
                    extended = true;
                }
            }
        }
        val pushed: res[usize, allocator.Error] = vector.push[Type](out, t);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        val placed: res[usize, allocator.Error] = vector.push[Placed](places, placed_as(p, extended));
        if (sel placed.err) { ret refusal.lost(placed.err); }
        n = n + 1;
    }
    ret err[refusal.Error].ok{};
}

# rebuild one value that traveled in from its pieces, at the builder
# ---
# home:   the slot an aggregate by value is rebuilt in
# pieces: its piece values, one per piece of passed
# public: whether the read of a copy by reference is stated public, as the declaration states the parameter it
#         carries, whose copy the caller made of a value of its type
fun rebuild(w: *Work, bld: *Builder, ty: Type, passed: Passed, asg: *Assignment, home: opt[Value], pieces: Slice[Value], public: bool) res[Value, refusal.Error] {
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[Value, refusal.Error].err{s.err}; }
    val al: res[u64, refusal.Error] = align_of(w, ty);
    if (sel al.err)                   { ret res[Value, refusal.Error].err{al.err}; }
    if (sel passed.passing.reference) { ret res[Value, refusal.Error].ok{stated_load(bld, pieces.data[0], ty, al.ok, public)}; }
    val memory: res[bool, refusal.Error] = through_memory(w, ?s.ok, passed.count);
    if (sel memory.err) { ret res[Value, refusal.Error].err{memory.err}; }
    if (!memory.ok) {
        val size: res[u64, refusal.Error] = size_of(w, ty);
        if (sel size.err) { ret res[Value, refusal.Error].err{size.err}; }
        val first: Piece = piece.piece(asg, passed.first);
        if (pieces.size == 1 && first.offset == 0 && first.size == size.ok) {
            val v: Value = pieces.data[0];
            ret convert(w, bld, v, body_of(w).values.data[v].type, ty);
        }
        val bits: res[Type, refusal.Error] = integer_type(w, (size.ok * 8)::u32);
        if (sel bits.err) { ret res[Value, refusal.Error].err{bits.err}; }
        var acc: Value = 0;
        var k:   u32   = 0;
        for (k::usize < pieces.size) {
            val q:      Piece                    = piece.piece(asg, passed.first + k);
            val v:      Value                    = pieces.data[k];
            val narrow: res[Type, refusal.Error] = integer_type(w, width_for(q.size));
            if (sel narrow.err) { ret res[Value, refusal.Error].err{narrow.err}; }
            val raw: res[Value, refusal.Error] = convert(w, bld, v, body_of(w).values.data[v].type, narrow.ok);
            if (sel raw.err) { ret raw; }
            var part: Value = raw.ok;
            if (!table.same(narrow.ok, bits.ok)) { part = unary(bld, opcode_table.EXT_U, part, bits.ok); }
            if (q.offset > 0) {
                val by: res[Value, refusal.Error] = integer(w, bits.ok, q.offset * 8);
                if (sel by.err) { ret by; }
                part = binary(bld, opcode_table.SHL, part, by.ok);
            }
            if (k > 0) { acc = binary(bld, opcode_table.OR, acc, part); }
            or         { acc = part; }
            k = k + 1;
        }
        ret convert(w, bld, acc, bits.ok, ty);
    }
    if (sel home.none) { ret res[Value, refusal.Error].err{refusal.Error.reason{"an aggregate rebuilt with no slot"}}; }
    var n: u32 = 0;
    for (n::usize < pieces.size) {
        val p:  Piece              = piece.piece(asg, passed.first + n);
        val v:  Value              = pieces.data[n];
        val pt: Type               = body_of(w).values.data[v].type;
        val ok: err[refusal.Error] = write(w, bld, home.some, p.offset, p.size, al.ok, v, pt);
        if (sel ok.err) { ret res[Value, refusal.Error].err{ok.err}; }
        n = n + 1;
    }
    ret res[Value, refusal.Error].ok{load(bld, home.some, ty, al.ok)};
}

# the slot a value that travels in is rebuilt in, or none when it needs none
fun home_for(w: *Work, ty: Type, passed: Passed) res[opt[Value], refusal.Error] {
    if (sel passed.passing.reference) { ret res[opt[Value], refusal.Error].ok{opt[Value].none{}}; }
    val s: res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err) { ret res[opt[Value], refusal.Error].err{s.err}; }
    val memory: res[bool, refusal.Error] = through_memory(w, ?s.ok, passed.count);
    if (sel memory.err) { ret res[opt[Value], refusal.Error].err{memory.err}; }
    if (!memory.ok)     { ret res[opt[Value], refusal.Error].ok{opt[Value].none{}}; }
    val al: res[u64, refusal.Error] = align_of(w, ty);
    if (sel al.err) { ret res[opt[Value], refusal.Error].err{al.err}; }
    val made: res[Value, refusal.Error] = slot(w, ty, al.ok);
    if (sel made.err) { ret res[opt[Value], refusal.Error].err{made.err}; }
    ret res[opt[Value], refusal.Error].ok{opt[Value].some{made.ok}};
}

# where a signature's values travel, as the row it names places them. the
# abi legalisation lowers every call, entry and return through this query, so
# a front end that asks it reads the placement the pass makes
# ---
# row:        the resolved row the signature names
# assignment: each argument's and result's passing and pieces, the piece the
#             address of a result by reference travels in, and the bytes of
#             the outgoing argument area the arguments take
# named:      how many of the arguments are named, the rest placed as the
#             row places unnamed values
# align:      the stack's alignment at a call, 0 for a row with no stack in
#             memory
pub rec Passage {
    row:        *Resolved;
    assignment: Assignment;
    named:      Named;
    align:      u64;
}

# why a signature was not placed
# ---
# signature: the type is no function type of the layout's table
# row:       the signature names a convention row the target does not state,
#            none for the default
# classify:  the row refused to classify it, or the target carries no row
pub tag Error: u8 {
    signature: table.Error;
    row:       opt[Calling];
    classify:  call.Error;
}

# place a signature's arguments and results under the row it names, the one
# classification of a call, an entry or a return
# ---
# a:         the allocator the passage's storage comes from
# b:         the build, whose resolved rows classify
# l:         the layout of the module the signature is in
# signature: the function type
# named:     how many of its arguments a call names, `all` for an entry
# ret:       the passage, given back with `release`, or why it was not placed
pub fun placement(a: *allocator.Allocator, b: *Build, l: *Layout, signature: Type, named: Named) res[Passage, Error] {
    var d: call.Described = call.described(a);
    fin { call.forget(?d); }
    ret placed_through(a, b, l, ?d, signature, named);
}

# place a signature as `placement` does, reading its types from the views
# described over the layout so far
fun placed_through(a: *allocator.Allocator, b: *Build, l: *Layout, d: *call.Described, signature: Type, named: Named) res[Passage, Error] {
    val s: res[table.Function, table.Error] = table.signature(l.types, signature);
    if (sel s.err) { ret res[Passage, Error].err{Error.signature{s.err}}; }
    val stated: Declared = b.basis.target.convention;
    if (sel stated.uncarried) { ret res[Passage, Error].err{Error.classify{call.Error.uncarried{}}}; }
    if (!(sel stated.rows))   { ret res[Passage, Error].err{Error.classify{call.Error.unstated{}}}; }
    val row: opt[*Resolved] = build_record.under(b, s.ok.convention);
    if (sel row.none) { ret res[Passage, Error].err{Error.row{s.ok.convention}}; }
    val r: res[Assignment, call.Error] = call.classify_in(a, l, d, row.some, signature, Statement{aggregates: Aggregates.platform{}, named: named});
    if (sel r.err) { ret res[Passage, Error].err{Error.classify{r.err}}; }
    var align: u64   = 0;
    val stack: Stack = row.some.row.stack;
    if (sel stack.memory) { align = stack.memory.align; }
    ret res[Passage, Error].ok{Passage{row: row.some, assignment: r.ok, named: named, align: align}};
}

# give back a passage's storage
pub fun release(p: *Passage) err[allocator.Error] {
    ret piece.dnit(?p.assignment);
}

# the passages of one layout's signatures under a build, each placed once. a
# passage is a function of its signature, its named count, the build's rows
# and the layout alone, and an interned type never changes, so each stands as
# long as the layout it was placed through
# ---
# a:         the allocator the passages' storage comes from
# b:         the build, whose resolved rows classify
# l:         the layout of the module the signatures are in
# described: the type view of every type the signatures name
# index:     each placed signature and named count, by its key, to its passage
# placed:    the passages, owned until `forget`
pub rec Passages {
    a:         *allocator.Allocator;
    b:         *Build;
    l:         *Layout;
    described: call.Described;
    index:     map.Map[u64, u32];
    placed:    Vector[Passage];
}

# no passages yet of a layout's signatures under a build
pub fun passages(a: *allocator.Allocator, b: *Build, l: *Layout) Passages {
    ret Passages{a: a, b: b, l: l, described: call.described(a), index: map.init[u64, u32](a), placed: vector.init[Passage](a)};
}

# give back every passage's storage
pub fun forget(p: *Passages) err[allocator.Error] {
    var kept: err[allocator.Error] = err[allocator.Error].ok{};
    var i:    usize                = 0;
    for (i < p.placed.len) {
        val r: err[allocator.Error] = release(?p.placed.data[i]);
        if (sel r.err) { kept = r; }
        i = i + 1;
    }
    vector.dnit[Passage](?p.placed);
    map.dnit[u64, u32](?p.index);
    val views: err[allocator.Error] = call.forget(?p.described);
    if (sel views.err) { ret views; }
    ret kept;
}

# where a signature's values travel when a call names a count of them, placed
# the first time it is asked and read from then on. the passage stays owned by
# the store, so it is never released by the caller
pub fun passage(p: *Passages, signature: Type, named: Named) res[Passage, Error] {
    var count: u64 = 0xffffffff;
    if (sel named.first)    { count = named.first::u64; }
    or (sel named.unstated) { ret placed_through(p.a, p.b, p.l, ?p.described, signature, named); }
    val key:   u64       = (signature::u64 << 32) | count;
    val found: opt[*u32] = map.get[u64, u32](?p.index, ?key);
    if (sel found.some) { ret res[Passage, Error].ok{p.placed.data[@found.some]}; }
    val got: res[Passage, Error] = placed_through(p.a, p.b, p.l, ?p.described, signature, named);
    if (sel got.err) { ret got; }
    val at:     u32                         = p.placed.len::u32;
    val pushed: res[usize, allocator.Error] = vector.push[Passage](?p.placed, got.ok);
    if (sel pushed.err) {
        var lost: Passage = got.ok;
        release(?lost);
        ret res[Passage, Error].err{Error.classify{call.Error.alloc{pushed.err}}};
    }
    val linked: res[bool, allocator.Error] = map.insert[u64, u32](?p.index, key, at);
    if (sel linked.err) { ret res[Passage, Error].err{Error.classify{call.Error.alloc{linked.err}}}; }
    ret got;
}

# classify a call or a function through the row its signature names, which
# the work is under from then on. the assignment is the store's
fun classify(w: *Work, signature: Type, named: Named) res[Assignment, refusal.Error] {
    val got: res[Passage, Error] = passage(w.passages, signature, named);
    if (sel got.err) {
        val e: Error = got.err;
        if (sel e.signature) { ret res[Assignment, refusal.Error].err{refusal.Error.ir{module.Error.types{e.signature}}}; }
        if (sel e.classify)  { ret res[Assignment, refusal.Error].err{refusal.Error.convention{e.classify}}; }
        ret res[Assignment, refusal.Error].err{refusal.Error.reason{"a signature names a convention row the target does not state"}};
    }
    w.convention = got.ok.row;
    ret res[Assignment, refusal.Error].ok{got.ok.assignment};
}

fun signature_of(w: *Work, ty: Type) res[table.Function, refusal.Error] {
    val s: res[table.Function, table.Error] = table.signature(?w.m.types, ty);
    if (sel s.err) { ret res[table.Function, refusal.Error].err{refusal.Error.ir{module.Error.types{s.err}}}; }
    ret res[table.Function, refusal.Error].ok{s.ok};
}

# the function type of a piece form
fun piece_signature(w: *Work, params: Slice[Type], results: Slice[Type], convention: opt[Calling]) res[Type, refusal.Error] {
    var f: table.Function = table.plain(params, results);
    f.convention = convention;
    ret intern(w, table.Shape.function{f});
}

# the piece the convention returns a result's address in, when it does
fun returned_place(w: *Work) opt[Placed] {
    val regs: *Registers = held(w.convention);
    if (regs == nil) { ret opt[Placed].none{}; }
    val r: opt[rf.Id] = regs.returned;
    if (sel r.none) { ret opt[Placed].none{}; }
    ret opt[Placed].some{Placed{place: Place.register{r.some}, scale: Scale.fixed{}, fill: Fill.exact{}}};
}

fun by_reference(asg: *Assignment) bool {
    var i: usize = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the entry, rewritten so its parameters are its pieces
# ---
# ret: the parameter the caller's result address arrives in, when a result
#      travels by reference
fun lower_entry(w: *Work, asg: *Assignment) res[opt[Value], refusal.Error] {
    val b:      *Body              = body_of(w);
    val old:    usize              = b.blocks.data[w.entry].parameters.len;
    var olds:   Vector[Value]      = vector.init[Value](w.m.a);
    var homes:  Vector[opt[Value]] = vector.init[opt[Value]](w.m.a);
    var tys:    Vector[Type]       = vector.init[Type](w.m.a);
    var places: Vector[Placed]     = vector.init[Placed](w.m.a);
    var params: Vector[Value]      = vector.init[Value](w.m.a);
    var lays:   Vector[opt[u64]]   = vector.init[opt[u64]](w.m.a);
    var counts: Vector[u32]        = vector.init[u32](w.m.a);
    fin {
        vector.dnit[opt[u64]](?lays);
        vector.dnit[u32](?counts);
        vector.dnit[Value](?olds);
        vector.dnit[opt[Value]](?homes);
        vector.dnit[Type](?tys);
        vector.dnit[Placed](?places);
        vector.dnit[Value](?params);
    }
    if (old != asg.arguments.len) { ret res[opt[Value], refusal.Error].err{refusal.Error.reason{"an entry whose parameters are not its signature's"}}; }
    var i: usize = 0;
    for (i < old) {
        val v:      Value                       = b.blocks.data[w.entry].parameters.data[i];
        val pushed: res[usize, allocator.Error] = vector.push[Value](?olds, v);
        if (sel pushed.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{pushed.err}}; }
        val lay: res[opt[u64], refusal.Error] = laid(w, body_of(w).values.data[v].type, asg.arguments.data[i], asg);
        if (sel lay.err) { ret res[opt[Value], refusal.Error].err{lay.err}; }
        val lain: res[usize, allocator.Error] = vector.push[opt[u64]](?lays, lay.ok);
        if (sel lain.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{lain.err}}; }
        var count: u32 = asg.arguments.data[i].count;
        if (sel lay.ok.some) { count = 0; }
        val counted: res[usize, allocator.Error] = vector.push[u32](?counts, count);
        if (sel counted.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{counted.err}}; }
        var h: res[opt[Value], refusal.Error] = res[opt[Value], refusal.Error].ok{opt[Value].none{}};
        if (sel lay.ok.none) { h = home_for(w, body_of(w).values.data[v].type, asg.arguments.data[i]); }
        if (sel h.err)       { ret res[opt[Value], refusal.Error].err{h.err}; }
        val kept: res[usize, allocator.Error] = vector.push[opt[Value]](?homes, h.ok);
        if (sel kept.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{kept.err}}; }
        i = i + 1;
    }
    var carrier: opt[Value] = opt[Value].none{};
    if (sel asg.address.some) {
        val pushed: res[usize, allocator.Error] = vector.push[Type](?tys, w.ptr);
        if (sel pushed.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{pushed.err}}; }
        val placed: err[refusal.Error] = place_of(?places, asg.address.some);
        if (sel placed.err) { ret res[opt[Value], refusal.Error].err{placed.err}; }
    }
    i = 0;
    for (i < old) {
        val ty: Type               = body_of(w).values.data[olds.data[i]].type;
        var ok: err[refusal.Error] = err[refusal.Error].ok{};
        if (sel lays.data[i].none) { ok = receive_types(w, Side.argument{i::u32}, ty, asg.arguments.data[i], asg, ?tys, ?places); }
        if (sel ok.err)            { ret res[opt[Value], refusal.Error].err{ok.err}; }
        i = i + 1;
    }
    var first: u32 = 0;
    i = 0;
    for (i < tys.len) {
        var secret: bool      = false;
        var name:   opt[View] = opt[View].none{};
        if (!(sel asg.address.some) || i != 0) {
            val owner: opt[usize] = owner_of(?counts, sel asg.address.some, i);
            if (sel owner.some) {
                val old_value: Value  = olds.data[owner.some];
                val passed:    Passed = asg.arguments.data[owner.some];
                if (sel passed.passing.value) {
                    val one: Piece = asg.pieces.data[passed.first::usize + piece_within(?counts, sel asg.address.some, i, owner.some)];
                    secret = contract.piece_secret(parameter_secrecy(?w.m.functions.data[w.f].data, owner.some), one);
                }
                if (passed.count == 1 && sel passed.passing.value) { name = body_of(w).values.data[old_value].name; }
            }
        }
        val added: res[Value, module.Error] = body.add_parameter(w.m, w.f, w.entry, Declaration{type: tys.data[i], secret: secret, name: name}, Slice[Value]{data: nil, size: 0});
        if (sel added.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.ir{added.err}}; }
        val pushed: res[usize, allocator.Error] = vector.push[Value](?params, added.ok);
        if (sel pushed.err) { ret res[opt[Value], refusal.Error].err{refusal.Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    if (sel asg.address.some) {
        carrier = opt[Value].some{params.data[0]};
        first   = 1;
    }
    var bld: Builder = builder.init(w.m);
    builder.enter(?bld, w.f);
    builder.at(?bld, w.entry, w.slots);
    var at: u32 = first;
    i = 0;
    for (i < old) {
        val v:      Value  = olds.data[i];
        val passed: Passed = asg.arguments.data[i];
        builder.secret(?bld, body_of(w).values.data[v].secret);
        var got: res[Value, refusal.Error] = res[Value, refusal.Error].ok{v};
        if (sel lays.data[i].some) {
            val ty: Type                    = body_of(w).values.data[v].type;
            val al: res[u64, refusal.Error] = align_of(w, ty);
            if (sel al.err) { ret res[opt[Value], refusal.Error].err{al.err}; }
            got = res[Value, refusal.Error].ok{load(?bld, area(w, ?bld, ty, lays.data[i].some, true), ty, al.ok)};
        }
        or               { got = rebuild(w, ?bld, body_of(w).values.data[v].type, passed, asg, homes.data[i], Slice[Value]{data: ?params.data[at], size: passed.count::usize}, !body_of(w).values.data[v].secret); }
        if (sel got.err) { ret res[opt[Value], refusal.Error].err{got.err}; }
        val done: err[refusal.Error] = built(?bld);
        if (sel done.err) { ret res[opt[Value], refusal.Error].err{done.err}; }
        val moved: err[refusal.Error] = ir(body.replace(w.m, w.f, v, got.ok, Records.follow{}));
        if (sel moved.err) { ret res[opt[Value], refusal.Error].err{moved.err}; }
        val spread: err[refusal.Error] = at_uses(w, got.ok);
        if (sel spread.err) { ret res[opt[Value], refusal.Error].err{spread.err}; }
        at = at + counts.data[i];
        i  = i + 1;
    }
    val after: err[refusal.Error] = handed(w, ?bld);
    if (sel after.err) { ret res[opt[Value], refusal.Error].err{after.err}; }
    i = 0;
    for (i < old) {
        val gone: err[refusal.Error] = ir(body.remove_parameter(w.m, w.f, w.entry, 0));
        if (sel gone.err) { ret res[opt[Value], refusal.Error].err{gone.err}; }
        i = i + 1;
    }
    val placed: err[refusal.Error] = ir(body.place_entry(w.m, w.f, Slice[Placed]{data: places.data, size: places.len}));
    if (sel placed.err) { ret res[opt[Value], refusal.Error].err{placed.err}; }
    ret res[opt[Value], refusal.Error].ok{carrier};
}

# an aggregate that traveled in read where it is used: a load of the memory it
# was rebuilt from, the caller's copy for one by reference and the entry's own
# slot for one by value, just before each instruction that uses it, stated as
# the load at the entry is. nothing in the callee writes that memory after the
# entry, so each load reads what the entry's would have, and a store of the
# value is a copy between memories with no aggregate held across the body. the
# load at the entry goes once unused, unless a variable is bound to it
fun at_uses(w: *Work, v: Value) err[refusal.Error] {
    val ty: Type                            = body_of(w).values.data[v].type;
    val s:  res[table.Shape, refusal.Error] = shape_of(w, ty);
    if (sel s.err)        { ret err[refusal.Error].err{s.err}; }
    if (!aggregate(s.ok)) { ret err[refusal.Error].ok{}; }
    val def: Def = body_of(w).values.data[v].def;
    if (!(sel def.result)) { ret err[refusal.Error].ok{}; }
    val l: Instruction = def.result.instruction;
    if (body_of(w).instructions.data[l].opcode != opcode_table.LOAD) { ret err[refusal.Error].ok{}; }
    val address: Value                   = body_of(w).instructions.data[l].operands.data[0];
    val public:  bool                    = body_of(w).instructions.data[l].metadata.flags.public;
    val al:      res[u64, refusal.Error] = align_of(w, ty);
    if (sel al.err) { ret err[refusal.Error].err{al.err}; }
    for (body_of(w).values.data[v].uses.len > 0) {
        val u:   Instruction = body_of(w).values.data[v].uses.data[0];
        var bld: Builder     = builder.init(w.m);
        builder.enter(?bld, w.f);
        builder.derive(?bld, u);
        builder.secret(?bld, body_of(w).values.data[v].secret);
        builder.before(?bld, u);
        val here: Value              = stated_load(?bld, address, ty, al.ok, public);
        val done: err[refusal.Error] = built(?bld);
        if (sel done.err) { ret done; }
        val put: err[refusal.Error] = ir(body.substitute(w.m, w.f, u, v, here));
        if (sel put.err) { ret put; }
    }
    if (body_of(w).values.data[v].bound.len != 0) { ret err[refusal.Error].ok{}; }
    ret note_unused(w, l);
}

# move the records at the entry's head to where the parameters are rebuilt,
# the builder's cursor, so a variable of a parameter reads its rebuilt value
# from its first point
fun handed(w: *Work, bld: *Builder) err[refusal.Error] {
    val c: builder.Cursor = builder.cursor(bld);
    if (!(sel c.at)) { ret err[refusal.Error].ok{}; }
    val list: *vector.Vector[Instruction] = ?body_of(w).blocks.data[w.entry].instructions;
    if (c.at.index::usize >= list.len || c.at.index == 0) { ret err[refusal.Error].ok{}; }
    ret ir(body.hand(w.m, w.f, list.data[0], list.data[c.at.index]));
}

# the argument a piece type of the entry's list belongs to, by how many pieces
# of each argument the list carries, none for one laid whole in the argument area
fun owner_of(carried: *Vector[u32], addressed: bool, at: usize) opt[usize] {
    var k: usize = at;
    if (addressed) { k = k - 1; }
    var i: usize = 0;
    var n: usize = 0;
    for (i < carried.len) {
        n = n + carried.data[i]::usize;
        if (k < n) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# which piece of its argument `owner` the entry parameter `at` is, as `owner_of` counts them
fun piece_within(carried: *Vector[u32], addressed: bool, at: usize, owner: usize) usize {
    var k: usize = at;
    if (addressed) { k = k - 1; }
    var i: usize = 0;
    for (i < owner) {
        k = k - carried.data[i]::usize;
        i = i + 1;
    }
    ret k;
}

# whether an instruction reads or writes memory, as its opcode row states,
# an opcode with no row taken to do both
fun touches(w: *Work, i: Instruction) bool {
    val row: opt[*opcode_row.Row] = opcode_table.at(body_of(w).instructions.data[i].opcode);
    if (sel row.none) { ret true; }
    ret row.some.effects.reads || row.some.effects.writes;
}

# the instruction a value is the result of, of this opcode, none for another
fun made_by(w: *Work, v: Value, code: Opcode) opt[Instruction] {
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[v].def;
    if (!(sel def.result))                                          { ret opt[Instruction].none{}; }
    if (b.instructions.data[def.result.instruction].opcode != code) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{def.result.instruction};
}

# whether nothing between two instructions of one block, the first before the
# second, reads or writes memory
fun untouched_between(w: *Work, first: Instruction, last: Instruction) bool {
    val b: *Body = body_of(w);
    val k: Block = block_of(b, first);
    if (block_of(b, last) != k) { ret false; }
    val from: u32 = position(b, k, first);
    val to:   u32 = position(b, k, last);
    if (to <= from) { ret false; }
    var p: u32 = from + 1;
    for (p < to) {
        if (touches(w, b.blocks.data[k].instructions.data[p])) { ret false; }
        p = p + 1;
    }
    ret true;
}

# the one result by reference, none when no result or more than one travels
# by reference
fun referenced(asg: *Assignment) opt[usize] {
    var count: usize = 0;
    var at:    usize = 0;
    var i:     usize = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) {
            count = count + 1;
            at    = i;
        }
        i = i + 1;
    }
    if (count != 1) { ret opt[usize].none{}; }
    ret opt[usize].some{at};
}

# build a result returned by reference in place: a stack slot every return
# hands back whole, read just before it with nothing touching memory in
# between, and whose address goes nowhere else, is the memory the carrier
# addresses, so no return copies it there
fun in_place(w: *Work, asg: *Assignment, carrier: opt[Value], rets: *Vector[Instruction]) err[refusal.Error] {
    if (sel carrier.none) { ret err[refusal.Error].ok{}; }
    if (rets.len == 0)    { ret err[refusal.Error].ok{}; }
    val k: opt[usize] = referenced(asg);
    if (sel k.none) { ret err[refusal.Error].ok{}; }
    var home: opt[Value] = opt[Value].none{};
    var ty:   Type       = w.ptr;
    var i:    usize      = 0;
    for (i < rets.len) {
        val r:  Instruction      = rets.data[i];
        val rd: *InstructionData = ?body_of(w).instructions.data[r];
        if (k.some >= rd.operands.len) { ret err[refusal.Error].ok{}; }
        val l: opt[Instruction] = loaded(w, rd.operands.data[k.some]);
        if (sel l.none)                       { ret err[refusal.Error].ok{}; }
        if (!untouched_between(w, l.some, r)) { ret err[refusal.Error].ok{}; }
        val at: Value = body_of(w).instructions.data[l.some].operands.data[0];
        if (sel home.some) {
            if (home.some != at) { ret err[refusal.Error].ok{}; }
        }
        home = opt[Value].some{at};
        ty   = body_of(w).values.data[rd.operands.data[k.some]].type;
        i    = i + 1;
    }
    if (sel home.none) { ret err[refusal.Error].ok{}; }
    val slot: opt[Instruction] = made_by(w, home.some, opcode_table.ALLOCA);
    if (sel slot.none) { ret err[refusal.Error].ok{}; }
    val sd: *InstructionData = ?body_of(w).instructions.data[slot.some];
    if (sd.immediates.len == 0 || sd.metadata.flags.kept) { ret err[refusal.Error].ok{}; }
    val held: Immediate = sd.immediates.data[0];
    if (!(sel held.ty))                            { ret err[refusal.Error].ok{}; }
    if (!table.same(held.ty, ty))                  { ret err[refusal.Error].ok{}; }
    if (!overlap.contained(body_of(w), home.some)) { ret err[refusal.Error].ok{}; }
    val bindings: Bindings                          = sd.metadata.bindings;
    val bound:    res[Slice[Binding], module.Error] = module.bound(w.m, bindings);
    if (sel bound.err) { ret ir(err[module.Error].err{bound.err}); }
    if (bound.ok.size > 0) {
        val at: res[Instruction, refusal.Error] = storage_of(w);
        if (sel at.err) { ret err[refusal.Error].err{at.err}; }
        body_of(w).instructions.data[at.ok].metadata.bindings = bindings;
    }
    val replaced: err[refusal.Error] = ir(body.replace(w.m, w.f, home.some, carrier.some, Records.follow{}));
    if (sel replaced.err) { ret replaced; }
    ret ir(body.erase(w.m, w.f, slot.some));
}

# the instruction that addresses the result's memory through the carrier, at
# the entry after the stack slots, which a variable bound to that memory is
# bound on, made the first time one is
fun storage_of(w: *Work) res[Instruction, refusal.Error] {
    val had: opt[Instruction] = w.storage;
    if (sel had.some) { ret res[Instruction, refusal.Error].ok{had.some}; }
    val carrier: opt[Value] = w.carrier;
    if (sel carrier.none) { ret res[Instruction, refusal.Error].err{refusal.Error.reason{"storage of a result by reference with no carrier"}}; }
    val zero: res[Value, refusal.Error] = integer(w, w.offset, 0);
    if (sel zero.err) { ret res[Instruction, refusal.Error].err{zero.err}; }
    var bld: Builder = builder.init(w.m);
    builder.enter(?bld, w.f);
    builder.at(?bld, w.entry, w.slots);
    val v:    Value              = binary(?bld, opcode_table.PTR_ADD, carrier.some, zero.ok);
    val done: err[refusal.Error] = built(?bld);
    if (sel done.err) { ret res[Instruction, refusal.Error].err{done.err}; }
    val made: Def = body_of(w).values.data[v].def;
    if (!(sel made.result)) { ret res[Instruction, refusal.Error].err{refusal.Error.reason{"storage of a result by reference no instruction makes"}}; }
    w.storage = opt[Instruction].some{made.result.instruction};
    ret res[Instruction, refusal.Error].ok{made.result.instruction};
}

# one return, rewritten into the pieces of its values
fun lower_return(w: *Work, asg: *Assignment, r: Instruction, carrier: opt[Value]) err[refusal.Error] {
    val b:     *Body = body_of(w);
    val count: usize = b.instructions.data[r].operands.len;
    if (count != asg.results.len) { ret err[refusal.Error].err{refusal.Error.reason{"a return whose values are not its function's results"}}; }
    var given:  Vector[Value]  = vector.init[Value](w.m.a);
    var out:    Vector[Value]  = vector.init[Value](w.m.a);
    var places: Vector[Placed] = vector.init[Placed](w.m.a);
    fin {
        vector.dnit[Value](?given);
        vector.dnit[Value](?out);
        vector.dnit[Placed](?places);
    }
    var i: usize = 0;
    for (i < count) {
        val pushed: res[usize, allocator.Error] = vector.push[Value](?given, b.instructions.data[r].operands.data[i]);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    var bld: Builder = builder.init(w.m);
    builder.enter(?bld, w.f);
    builder.derive(?bld, r);
    builder.before(?bld, r);
    i = 0;
    for (i < count) {
        val x: res[Sent, refusal.Error] = sent(w, given.data[i]);
        if (sel x.err) { ret err[refusal.Error].err{x.err}; }
        val passed: Passed = asg.results.data[i];
        builder.secret(?bld, x.ok.secret);
        if (sel passed.passing.reference) {
            if (sel carrier.none) { ret err[refusal.Error].err{refusal.Error.reason{"a result by reference with no address to return it at"}}; }
            val c:    piece.Copy       = passed.passing.reference;
            val from: opt[Instruction] = copied_from(w, x.ok, r);
            if (sel from.some) {
                val bb:   *Body   = body_of(w);
                val kk:   Block   = block_of(bb, from.some);
                var near: Builder = builder.init(w.m);
                builder.enter(?near, w.f);
                builder.derive(?near, from.some);
                builder.secret(?near, x.ok.secret);
                builder.at(?near, kk, position(bb, kk, from.some) + 1);
                val copied: err[refusal.Error] = copy(w, ?near, bb.instructions.data[from.some].operands.data[0], carrier.some, c.size, c.align);
                if (sel copied.err) { ret copied; }
                val done: err[refusal.Error] = built(?near);
                if (sel done.err) { ret done; }
                val noted: err[refusal.Error] = note_unused(w, from.some);
                if (sel noted.err) { ret noted; }
            }
            or {
                val al: res[u64, refusal.Error] = align_of(w, x.ok.ty);
                if (sel al.err) { ret err[refusal.Error].err{al.err}; }
                store(?bld, carrier.some, x.ok.value, al.ok);
            }
        }
        or {
            val ok: err[refusal.Error] = send(w, ?bld, r, Side.result{i::u32}, x.ok, passed, asg, ?out, ?places);
            if (sel ok.err) { ret ok; }
        }
        i = i + 1;
    }
    val returned: opt[Placed] = returned_place(w);
    if (sel carrier.some) {
        if (sel returned.some) {
            val pushed: res[usize, allocator.Error] = vector.push[Value](?out, carrier.some);
            if (sel pushed.err) { ret refusal.lost(pushed.err); }
            val placed: res[usize, allocator.Error] = vector.push[Placed](?places, returned.some);
            if (sel placed.err) { ret refusal.lost(placed.err); }
        }
    }
    builder.secret(?bld, false);
    builder.replacing(?bld, r);
    var imm: [1]Immediate = [1]Immediate{Immediate.places{Slice[Placed]{data: places.data, size: places.len}}};
    builder.emit(?bld, Request{opcode: opcode_table.RET_PLACED, operands: Slice[Value]{data: out.data, size: out.len}, immediates: Slice[Immediate]{data: ?imm[0], size: 1}, targets: no_targets()});
    ret built(?bld);
}

# whether a value stands before an instruction it is used at in that
# instruction's block: a parameter or constant, a result of another block,
# which dominates every use there, or one earlier in the block
fun stands_before(w: *Work, v: Value, at: Instruction) bool {
    val b:   *Body = body_of(w);
    val def: Def   = b.values.data[v].def;
    if (!(sel def.result)) { ret true; }
    val i: Instruction = def.result.instruction;
    val k: Block       = block_of(b, at);
    if (block_of(b, i) != k) { ret true; }
    ret position(b, k, i) < position(b, k, at);
}

# the store a call's result by reference is passed the destination of: its
# one use, a store of it whole into memory aligned as its copy is, with
# nothing touching memory between the call and the store, an address that
# stands before the call, and a destination in a stack slot of the function's
# whose address goes nowhere but its own loads and stores, so the callee
# reaches it neither through an argument, nor a global, nor a pointer it
# holds. none keeps the copy
fun destination(w: *Work, c: Instruction, asg: *Assignment, olds: *Vector[Value]) opt[Instruction] {
    val k: opt[usize] = referenced(asg);
    if (sel k.none) { ret opt[Instruction].none{}; }
    val b:   *Body = body_of(w);
    val old: Value = olds.data[k.some];
    if (b.values.data[old].uses.len != 1 || b.values.data[old].bound.len != 0) { ret opt[Instruction].none{}; }
    val s:  Instruction      = b.values.data[old].uses.data[0];
    val sd: *InstructionData = ?b.instructions.data[s];
    if (sd.opcode != opcode_table.STORE || sd.operands.len != 2)  { ret opt[Instruction].none{}; }
    if (sd.operands.data[1] != old || sd.operands.data[0] == old) { ret opt[Instruction].none{}; }
    if (sd.metadata.flags.volatile || sd.metadata.flags.kept)     { ret opt[Instruction].none{}; }
    var align: u64   = 0;
    var i:     usize = 0;
    for (i < sd.immediates.len) {
        val imm: Immediate = sd.immediates.data[i];
        if (sel imm.alignment) { align = imm.alignment; }
        i = i + 1;
    }
    val passing: piece.Passing = asg.results.data[k.some].passing;
    if (!(sel passing.reference))        { ret opt[Instruction].none{}; }
    if (align < passing.reference.align) { ret opt[Instruction].none{}; }
    if (!untouched_between(w, c, s))     { ret opt[Instruction].none{}; }
    val dest: Value = sd.operands.data[0];
    if (!stands_before(w, dest, c)) { ret opt[Instruction].none{}; }
    val root:  Value            = overlap.root_of(body_of(w), dest);
    val local: opt[Instruction] = made_by(w, root, opcode_table.ALLOCA);
    if (sel local.none)                       { ret opt[Instruction].none{}; }
    if (!overlap.contained(body_of(w), root)) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{s};
}

# one call, rewritten into the pieces of its arguments and results
fun lower_call(w: *Work, c: Instruction) err[refusal.Error] {
    val b: *Body            = body_of(w);
    val d: *InstructionData = ?b.instructions.data[c];
    if (d.immediates.len < 2) { ret err[refusal.Error].err{refusal.Error.reason{"a call with no signature or named count"}}; }
    val stated_signature: Immediate = d.immediates.data[0];
    val stated_named:     Immediate = d.immediates.data[1];
    if (!(sel stated_signature.ty)) { ret err[refusal.Error].err{refusal.Error.reason{"a call with no signature"}}; }
    if (!(sel stated_named.named))  { ret err[refusal.Error].err{refusal.Error.reason{"a call with no named count"}}; }
    val signature: Type                           = stated_signature.ty;
    val named:     Named                          = stated_named.named;
    val got:       res[Assignment, refusal.Error] = classify(w, signature, named);
    if (sel got.err) { ret err[refusal.Error].err{got.err}; }
    var asg: Assignment = got.ok;

    var given:   Vector[Value]      = vector.init[Value](w.m.a);
    var olds:    Vector[Value]      = vector.init[Value](w.m.a);
    var homes:   Vector[opt[Value]] = vector.init[opt[Value]](w.m.a);
    var out:     Vector[Value]      = vector.init[Value](w.m.a);
    var places:  Vector[Placed]     = vector.init[Placed](w.m.a);
    var params:  Vector[Type]       = vector.init[Type](w.m.a);
    var results: Vector[Type]       = vector.init[Type](w.m.a);
    var after:   Vector[Placed]     = vector.init[Placed](w.m.a);
    fin {
        vector.dnit[Value](?given);
        vector.dnit[Value](?olds);
        vector.dnit[opt[Value]](?homes);
        vector.dnit[Value](?out);
        vector.dnit[Placed](?places);
        vector.dnit[Type](?params);
        vector.dnit[Type](?results);
        vector.dnit[Placed](?after);
    }
    val callee: Value = d.operands.data[0];
    var i:      usize = 1;
    for (i < d.operands.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Value](?given, d.operands.data[i]);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    i = 0;
    for (i < d.results.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Value](?olds, d.results.data[i]);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    if (given.len != asg.arguments.len || olds.len != asg.results.len) { ret err[refusal.Error].err{refusal.Error.reason{"a call whose operands are not its signature's"}}; }
    var address: opt[Value]       = opt[Value].none{};
    val into:    opt[Instruction] = destination(w, c, ?asg, ?olds);
    if (sel into.some) { address = opt[Value].some{body_of(w).instructions.data[into.some].operands.data[0]}; }
    or (sel asg.address.some) {
        var ty:    Type = w.ptr;
        var align: u64  = 1;
        i = 0;
        for (i < olds.len) {
            if (sel asg.results.data[i].passing.reference) {
                ty    = body_of(w).values.data[olds.data[i]].type;
                align = asg.results.data[i].passing.reference.align;
            }
            i = i + 1;
        }
        val made: res[Value, refusal.Error] = slot(w, ty, align);
        if (sel made.err) { ret err[refusal.Error].err{made.err}; }
        address = opt[Value].some{made.ok};
    }
    i = 0;
    for (i < olds.len) {
        val h: res[opt[Value], refusal.Error] = home_for(w, body_of(w).values.data[olds.data[i]].type, asg.results.data[i]);
        if (sel h.err) { ret err[refusal.Error].err{h.err}; }
        val kept: res[usize, allocator.Error] = vector.push[opt[Value]](?homes, h.ok);
        if (sel kept.err) { ret refusal.lost(kept.err); }
        i = i + 1;
    }

    var bld: Builder = builder.init(w.m);
    builder.enter(?bld, w.f);
    builder.derive(?bld, c);
    builder.before(?bld, c);
    val secret:  bool       = body_of(w).instructions.data[c].metadata.secret;
    val carried: opt[Piece] = asg.address;
    if (sel address.some) {
        if (sel carried.some) {
            val pushed: res[usize, allocator.Error] = vector.push[Value](?out, address.some);
            if (sel pushed.err) { ret refusal.lost(pushed.err); }
            val placed: err[refusal.Error] = place_of(?places, carried.some);
            if (sel placed.err) { ret placed; }
        }
    }
    i = 0;
    for (i < given.len) {
        val x: res[Sent, refusal.Error] = sent(w, given.data[i]);
        if (sel x.err) { ret err[refusal.Error].err{x.err}; }
        builder.secret(?bld, x.ok.secret);
        val ok: err[refusal.Error] = send(w, ?bld, c, Side.argument{i::u32}, x.ok, asg.arguments.data[i], ?asg, ?out, ?places);
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    val count: res[opt[Value], refusal.Error] = counted(w, named, ?asg);
    if (sel count.err) { ret err[refusal.Error].err{count.err}; }
    val counter: opt[rf.Id] = count_register(w);
    if (sel count.ok.some) {
        if (sel counter.some) {
            val pushed: res[usize, allocator.Error] = vector.push[Value](?out, count.ok.some);
            if (sel pushed.err) { ret refusal.lost(pushed.err); }
            val placed: res[usize, allocator.Error] = vector.push[Placed](?places, Placed{place: Place.register{counter.some}, scale: Scale.fixed{}, fill: Fill.exact{}});
            if (sel placed.err) { ret refusal.lost(placed.err); }
        }
    }
    val worded: err[refusal.Error] = words_size(w, named, ?asg, ?out, ?places);
    if (sel worded.err) { ret worded; }
    i = 0;
    for (i < out.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Type](?params, body_of(w).values.data[out.data[i]].type);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    i = 0;
    for (i < olds.len) {
        val ty: Type               = body_of(w).values.data[olds.data[i]].type;
        val ok: err[refusal.Error] = receive_types(w, Side.result{i::u32}, ty, asg.results.data[i], ?asg, ?results, ?after);
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    val returned: opt[Placed] = returned_place(w);
    if (sel address.some) {
        if (sel returned.some) {
            val pushed: res[usize, allocator.Error] = vector.push[Type](?results, w.ptr);
            if (sel pushed.err) { ret refusal.lost(pushed.err); }
            val placed: res[usize, allocator.Error] = vector.push[Placed](?after, returned.some);
            if (sel placed.err) { ret refusal.lost(placed.err); }
        }
    }
    i = 0;
    for (i < after.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Placed](?places, after.data[i]);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    val stated: res[table.Function, refusal.Error] = signature_of(w, signature);
    if (sel stated.err) { ret err[refusal.Error].err{stated.err}; }
    val sig: res[Type, refusal.Error] = piece_signature(w, Slice[Type]{data: params.data, size: params.len}, Slice[Type]{data: results.data, size: results.len}, stated.ok.convention);
    if (sel sig.err) { ret err[refusal.Error].err{sig.err}; }

    builder.secret(?bld, secret);
    var operands: Vector[Value] = vector.init[Value](w.m.a);
    fin { vector.dnit[Value](?operands); }
    val first: res[usize, allocator.Error] = vector.push[Value](?operands, callee);
    if (sel first.err) { ret refusal.lost(first.err); }
    i = 0;
    for (i < out.len) {
        val pushed: res[usize, allocator.Error] = vector.push[Value](?operands, out.data[i]);
        if (sel pushed.err) { ret refusal.lost(pushed.err); }
        i = i + 1;
    }
    var imm:    [3]Immediate       = [3]Immediate{Immediate.ty{sig.ok}, Immediate.places{Slice[Placed]{data: places.data, size: places.len}}, Immediate.named{named}};
    val placed: Instruction        = builder.emit(?bld, Request{opcode: opcode_table.CALL_PLACED, operands: Slice[Value]{data: operands.data, size: operands.len}, immediates: Slice[Immediate]{data: ?imm[0], size: 3}, targets: no_targets()});
    val made:   err[refusal.Error] = built(?bld);
    if (sel made.err) { ret made; }

    if (sel into.some) {
        val stored: err[refusal.Error] = ir(body.erase(w.m, w.f, into.some));
        if (sel stored.err) { ret stored; }
    }
    var at: u32 = 0;
    i = 0;
    for (i < olds.len) {
        val passed:       Passed = asg.results.data[i];
        val old:          Value  = olds.data[i];
        var placed_whole: bool   = false;
        if (sel into.some && sel passed.passing.reference) { placed_whole = true; }
        # a result built in its destination is never loaded
        if (!placed_whole) {
            val ty:     Type          = body_of(w).values.data[old].type;
            var pieces: Vector[Value] = vector.init[Value](w.m.a);
            fin { vector.dnit[Value](?pieces); }
            if (sel passed.passing.reference) {
                if (sel address.none) { ret err[refusal.Error].err{refusal.Error.reason{"a result by reference with no address"}}; }
                val pushed: res[usize, allocator.Error] = vector.push[Value](?pieces, address.some);
                if (sel pushed.err) { ret refusal.lost(pushed.err); }
            }
            or {
                var n: u32 = 0;
                for (n < passed.count) {
                    val pushed: res[usize, allocator.Error] = vector.push[Value](?pieces, builder.result(?bld, placed, at + n));
                    if (sel pushed.err) { ret refusal.lost(pushed.err); }
                    n = n + 1;
                }
                at = at + passed.count;
            }
            val got: res[Value, refusal.Error] = rebuild(w, ?bld, ty, passed, ?asg, homes.data[i], Slice[Value]{data: pieces.data, size: pieces.len}, false);
            if (sel got.err) { ret err[refusal.Error].err{got.err}; }
            val done: err[refusal.Error] = built(?bld);
            if (sel done.err) { ret done; }
            val moved: err[refusal.Error] = ir(body.replace(w.m, w.f, old, got.ok, Records.follow{}));
            if (sel moved.err) { ret moved; }
        }
        i = i + 1;
    }
    ret ir(body.erase(w.m, w.f, c));
}

# the register a variadic caller sets its count in under the work's row
fun count_register(w: *Work) opt[rf.Id] {
    val regs: *Registers = held(w.convention);
    if (regs == nil) { ret opt[rf.Id].none{}; }
    ret regs.count;
}

# the count a variadic call states in the convention's count register: how
# many of its pieces travel in vector or float registers, none when the
# convention has no count or the call is not variadic
fun counted(w: *Work, named: Named, asg: *Assignment) res[opt[Value], refusal.Error] {
    val r: opt[rf.Id] = count_register(w);
    if (sel r.none || !(sel named.first)) { ret res[opt[Value], refusal.Error].ok{opt[Value].none{}}; }
    var n: u64   = 0;
    var i: usize = 0;
    for (i < asg.pieces.len) {
        val k: opt[rf.Kind] = kind_of(w, asg.pieces.data[i].place);
        if (sel k.some) {
            if (k.some == rf.FLOAT || k.some == rf.VECTOR) { n = n + 1; }
        }
        i = i + 1;
    }
    val ty: res[Type, refusal.Error] = integer_type(w, 8);
    if (sel ty.err) { ret res[opt[Value], refusal.Error].err{ty.err}; }
    val v: res[Value, refusal.Error] = integer(w, ty.ok, n);
    if (sel v.err) { ret res[opt[Value], refusal.Error].err{v.err}; }
    ret res[opt[Value], refusal.Error].ok{opt[Value].some{v.ok}};
}

# the bytes of a variadic call's stack words as the piece a row whose unnamed
# arguments are x64's words hands its callee them in, as arm64ec's x5. the
# address of the first word, x4, is no value of the ir, so the selection
# sets it from the call's named count and the row
fun words_size(w: *Work, named: Named, asg: *Assignment, out: *Vector[Value], places: *Vector[Placed]) err[refusal.Error] {
    val unnamed: Unnamed = w.convention.row.variadic.unnamed;
    if (!(sel named.first))   { ret err[refusal.Error].ok{}; }
    if (!(sel unnamed.words)) { ret err[refusal.Error].ok{}; }
    val ty: res[Type, refusal.Error] = integer_type(w, 64);
    if (sel ty.err) { ret err[refusal.Error].err{ty.err}; }
    val v: res[Value, refusal.Error] = integer(w, ty.ok, asg.stack);
    if (sel v.err) { ret err[refusal.Error].err{v.err}; }
    val pushed: res[usize, allocator.Error] = vector.push[Value](out, v.ok);
    if (sel pushed.err) { ret refusal.lost(pushed.err); }
    val placed: res[usize, allocator.Error] = vector.push[Placed](places, Placed{place: Place.register{unnamed.words.size}, scale: Scale.fixed{}, fill: Fill.exact{}});
    if (sel placed.err) { ret refusal.lost(placed.err); }
    ret err[refusal.Error].ok{};
}

# take out an aggregate load the pass left unused, each variable bound to its
# value bound from then on to the storage it read, on the instruction that
# addresses that storage, so the variable keeps a description
fun retire(w: *Work, l: Instruction) err[refusal.Error] {
    val b: *Body            = body_of(w);
    val d: *InstructionData = ?b.instructions.data[l];
    if (!(sel d.place.placed)) { ret err[refusal.Error].ok{}; }
    val v: Value = d.results.data[0];
    if (b.values.data[v].uses.len != 0) { ret err[refusal.Error].ok{}; }
    val address: Value            = d.operands.data[0];
    val base:    Def              = b.values.data[address].def;
    var owner:   opt[Instruction] = opt[Instruction].none{};
    if (sel base.result) { owner = opt[Instruction].some{base.result.instruction}; }
    if (b.values.data[v].bound.len != 0 && sel owner.none) {
        var carried: bool = false;
        if (sel w.carrier.some) { carried = w.carrier.some == address; }
        if (!carried)           { ret err[refusal.Error].err{refusal.Error.reason{"a bound aggregate loaded through an address no instruction makes"}}; }
        val at: res[Instruction, refusal.Error] = storage_of(w);
        if (sel at.err) { ret err[refusal.Error].err{at.err}; }
        owner = opt[Instruction].some{at.ok};
    }
    if (sel owner.some) {
        for (body_of(w).values.data[v].bound.len > 0) {
            val r:  u32                = body_of(w).values.data[v].bound.data[0];
            val ok: err[refusal.Error] = ir(body.store_binding(w.m, w.f, r, owner.some));
            if (sel ok.err) { ret ok; }
        }
    }
    ret ir(body.erase(w.m, w.f, l));
}

# lower one function's entry, returns and calls
fun lower(w: *Work) err[refusal.Error] {
    val b:     *Body               = body_of(w);
    var calls: Vector[Instruction] = vector.init[Instruction](w.m.a);
    var rets:  Vector[Instruction] = vector.init[Instruction](w.m.a);
    fin {
        vector.dnit[Instruction](?calls);
        vector.dnit[Instruction](?rets);
    }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var p: usize = 0;
            for (p < b.blocks.data[k].instructions.len) {
                val i:    Instruction = b.blocks.data[k].instructions.data[p];
                val code: Opcode      = b.instructions.data[i].opcode;
                if (code == opcode_table.CALL) {
                    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?calls, i);
                    if (sel pushed.err) { ret refusal.lost(pushed.err); }
                }
                if (code == opcode_table.RET) {
                    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?rets, i);
                    if (sel pushed.err) { ret refusal.lost(pushed.err); }
                }
                p = p + 1;
            }
        }
        k = k + 1;
    }
    val signature: Type                           = w.m.functions.data[w.f].data.signature;
    val got:       res[Assignment, refusal.Error] = classify(w, signature, Named.all{});
    if (sel got.err) { ret err[refusal.Error].err{got.err}; }
    var asg:     Assignment                     = got.ok;
    val entered: res[opt[Value], refusal.Error] = lower_entry(w, ?asg);
    if (sel entered.err) { ret err[refusal.Error].err{entered.err}; }
    w.carrier = entered.ok;
    val built_in: err[refusal.Error] = in_place(w, ?asg, entered.ok, ?rets);
    if (sel built_in.err) { ret built_in; }
    var i: usize = 0;
    for (i < rets.len) {
        val ok: err[refusal.Error] = lower_return(w, ?asg, rets.data[i], entered.ok);
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < calls.len) {
        val ok: err[refusal.Error] = lower_call(w, calls.data[i]);
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    i = 0;
    for (i < w.unused.len) {
        val ok: err[refusal.Error] = retire(w, w.unused.data[i]);
        if (sel ok.err) { ret ok; }
        i = i + 1;
    }
    ret through_unheld(w);
}

# whether a type is a float of a format the build holds no unit for
fun unheld(w: *Work, ty: Type) bool {
    val s: res[table.Shape, table.Error] = table.shape(?w.m.types, ty);
    if (sel s.err)         { ret false; }
    if (!(sel s.ok.float)) { ret false; }
    val h: res[opt[*Held], basis.Error] = basis.held(w.basis, ?w.t.caps, s.ok.float.format);
    if (sel h.err) { ret false; }
    ret sel h.ok.none;
}

# whether an instruction is a reinterpretation of one value, from a float of
# a format the build holds no unit for when from is set and to one otherwise
fun recast_of(w: *Work, i: usize, from: bool) bool {
    val b: *Body = body_of(w);
    if (b.instructions.data[i].opcode != opcode_table.BITCAST || !(sel b.instructions.data[i].place.placed)) { ret false; }
    var at: Value = b.instructions.data[i].results.data[0];
    if (from) { at = b.instructions.data[i].operands.data[0]; }
    ret unheld(w, b.values.data[at].type);
}

# take out every pair of reinterpretations through a float of a format the
# build holds no unit for, an integer made into it and read back as the
# integer, as the pieces of a value that travels in integer registers meet
# the encoding the half precision legalisation computes it as, and then each
# reinterpretation into such a float nothing reads, so no register class
# need hold one
fun through_unheld(w: *Work) err[refusal.Error] {
    val b: *Body = body_of(w);
    var i: usize = 0;
    for (i < b.instructions.len) {
        if (recast_of(w, i, true)) {
            val x:   Value = b.instructions.data[i].operands.data[0];
            val def: Def   = b.values.data[x].def;
            if (sel def.result) {
                val j: usize = def.result.instruction::usize;
                if (recast_of(w, j, false)) {
                    val inner: Value = b.instructions.data[j].operands.data[0];
                    val r:     Value = b.instructions.data[i].results.data[0];
                    if (table.same(b.values.data[inner].type, b.values.data[r].type)) {
                        val moved: err[refusal.Error] = ir(body.replace(w.m, w.f, r, inner, Records.follow{}));
                        if (sel moved.err) { ret moved; }
                        val gone: err[refusal.Error] = ir(body.erase(w.m, w.f, (i::u32)));
                        if (sel gone.err) { ret gone; }
                    }
                }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        if (recast_of(w, i, false) && b.values.data[b.instructions.data[i].results.data[0]].uses.len == 0) {
            val gone: err[refusal.Error] = ir(body.erase(w.m, w.f, (i::u32)));
            if (sel gone.err) { ret gone; }
        }
        i = i + 1;
    }
    ret err[refusal.Error].ok{};
}

# declare the runtime function general dynamic thread-local access calls,
# when the module has a variable the target reaches that way and does not
# declare it, so selection names it as a call does
fun declare_lookup(c: *Context, ptr: Type) res[bool, refusal.Error] {
    val model: Addresses = c.t.addresses;
    if (!(sel model.model)) { ret res[bool, refusal.Error].ok{false}; }
    var wanted: bool  = false;
    var i:      usize = 0;
    for (i < c.m.globals.len) {
        val tls: opt[Tls] = c.m.globals.data[i].data.tls;
        if (sel tls.some) {
            val reached: addressing.Access = addressing.access(?model.model, tls.some);
            if (sel reached.general_dynamic) { wanted = true; }
        }
        i = i + 1;
    }
    if (!wanted) { ret res[bool, refusal.Error].ok{false}; }
    val name:  str         = model.model.threads.lookup;
    val as:    View        = View{data: name, len: str_len(name)};
    val found: opt[Symbol] = module.find(c.m, as);
    if (sel found.some) { ret res[bool, refusal.Error].ok{false}; }
    var one: [1]Type                = [1]Type{ptr};
    val sig: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.function{table.plain(Slice[Type]{data: ?one[0], size: 1}, Slice[Type]{data: ?one[0], size: 1})});
    if (sel sig.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{sig.err}}}; }
    val symbol_as: res[Id[Name], module.Error] = module.intern_name(c.m, as);
    if (sel symbol_as.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{symbol_as.err}}; }
    val made: res[Function, module.Error] = module.add_function(c.m, FunctionData{name: symbol_as.ok, signature: sig.ok, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}, constant_time: ConstantTime.none{}, extensions: NO_EXTENSIONS, alignment: opt[u64].none{}, section: opt[Section].none{}});
    if (sel made.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{made.err}}; }
    ret res[bool, refusal.Error].ok{true};
}

# declare the 32-bit cell indexed thread-local access reads the module's
# index from, as windows' _tls_index, as an external global when the module
# has a variable the target reaches that way and does not declare it, so
# selection names it as an address does. the image's link defines it beside
# its tls directory
fun declare_cell(c: *Context) res[bool, refusal.Error] {
    val model: Addresses = c.t.addresses;
    if (!(sel model.model)) { ret res[bool, refusal.Error].ok{false}; }
    val name: str = model.model.threads.index;
    if (str_len(name) == 0) { ret res[bool, refusal.Error].ok{false}; }
    var wanted: bool  = false;
    var i:      usize = 0;
    for (i < c.m.globals.len) {
        val tls: opt[Tls] = c.m.globals.data[i].data.tls;
        if (sel tls.some) {
            val reached: addressing.Access = addressing.access(?model.model, tls.some);
            if (sel reached.indexed) { wanted = true; }
        }
        i = i + 1;
    }
    if (!wanted) { ret res[bool, refusal.Error].ok{false}; }
    val as:    View        = View{data: name, len: str_len(name)};
    val found: opt[Symbol] = module.find(c.m, as);
    if (sel found.some) { ret res[bool, refusal.Error].ok{false}; }
    val cell: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.integer{table.Integer{width: 32}});
    if (sel cell.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{cell.err}}}; }
    val symbol_as: res[Id[Name], module.Error] = module.intern_name(c.m, as);
    if (sel symbol_as.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{symbol_as.err}}; }
    val made: res[Global, module.Error] = module.add_global(c.m, GlobalData{name: symbol_as.ok, type: cell.ok, initial: opt[Constant].none{}, alignment: opt[u64].none{}, section: opt[Section].none{}, tls: opt[Tls].none{}, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}, constant: false, secret: Secrecy.public{}, debug: opt[Binding].none{}});
    if (sel made.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{made.err}}; }
    ret res[bool, refusal.Error].ok{true};
}

# deliver the routine the convention's prologues call to probe a frame's
# pages, as windows x64's __chkstk, for each row a function the module
# defines is under, when the module does not define it, so the frame names
# it as a call does. it takes and returns nothing a convention places, its
# own contract keeping every register but those the frame code's probe
# states, and mirl writes it, as the toolchain links no C run time that would
fun declare_probe(c: *Context, b: *Build) res[bool, refusal.Error] {
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < c.m.functions.len) {
        if (record.touches(c, (i::u32))) {
            val s: res[table.Function, table.Error] = table.signature(?c.m.types, c.m.functions.data[i].data.signature);
            if (sel s.ok) {
                val row: opt[*Resolved] = build_record.under(b, s.ok.convention);
                if (sel row.some) {
                    val res_delivered: res[bool, refusal.Error] = delivered_probe(c, convention.probe_helper(row.some.row), in_constant_time(c.m.functions.data[i].data.constant_time));
                    if (sel res_delivered.err) { ret res_delivered; }
                    if (res_delivered.ok)      { changed = true; }
                }
            }
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}

# deliver a probe routine by its name, none for a row with none, when the
# module does not define it already, local to the module where `local` says a
# constant-time function's frame calls it
fun delivered_probe(c: *Context, name: opt[str], local: bool) res[bool, refusal.Error] {
    if (sel name.none) { ret res[bool, refusal.Error].ok{false}; }
    val as:        View        = View{data: name.some, len: str_len(name.some)};
    val opt_found: opt[Symbol] = module.find(c.m, as);
    val held:      bool        = sel opt_found.some;
    if (held && !local) { ret res[bool, refusal.Error].ok{false}; }
    var ar:        arena.Arena;
    val err_arena: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel err_arena.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{err_arena.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);
    val res_probe: res[Function, refusal.Error] = deliver.probe(c.m, c.t, c.basis, ?scratch, name.some, local);
    if (sel res_probe.err) { ret res[bool, refusal.Error].err{res_probe.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# declare the global holding the routine a row's returns leave through, as
# arm64ec's __os_arm64x_dispatch_ret, for each row a function the module
# defines is under, when the module does not declare it, so the frame names
# it as a load does
fun declare_exit(c: *Context, b: *Build, ptr: Type) res[bool, refusal.Error] {
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < c.m.functions.len) {
        if (record.touches(c, (i::u32))) {
            val s: res[table.Function, table.Error] = table.signature(?c.m.types, c.m.functions.data[i].data.signature);
            if (sel s.ok) {
                val row: opt[*Resolved] = build_record.under(b, s.ok.convention);
                if (sel row.some) {
                    val name: opt[str] = convention.exit_routine(row.some.row);
                    if (sel name.some) {
                        val as:    View        = View{data: name.some, len: str_len(name.some)};
                        val found: opt[Symbol] = module.find(c.m, as);
                        if (sel found.none) {
                            val symbol_as: res[Id[Name], module.Error] = module.intern_name(c.m, as);
                            if (sel symbol_as.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{symbol_as.err}}; }
                            val made: res[Global, module.Error] = module.add_global(c.m, GlobalData{name: symbol_as.ok, type: ptr, initial: opt[Constant].none{}, alignment: opt[u64].none{}, section: opt[Section].none{}, tls: opt[Tls].none{}, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}, constant: false, secret: Secrecy.public{}, debug: opt[Binding].none{}});
                            if (sel made.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{made.err}}; }
                            changed = true;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}

# the convention classifies through the build's, never one of the pass's own
fun run(c: *Context, b: *Build) res[bool, refusal.Error] {
    var l:   Layout                 = layout.of(c.t, ?c.m.types, basis.context_of(c.basis));
    val ptr: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.pointer{table.Pointer{space: 0}});
    if (sel ptr.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{ptr.err}}}; }
    val space: res[u32, target_record.Error] = target_record.slot_space(c.t);
    if (sel space.err) { ret res[bool, refusal.Error].err{refusal.Error.reason{"a target that states no address space for its stack slots"}}; }
    val slot: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.pointer{table.Pointer{space: space.ok}});
    if (sel slot.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{slot.err}}}; }
    val bytes: res[u64, target_record.Error] = layout.size(?l, ptr.ok, table.DEFAULT_SPACE);
    if (sel bytes.err) { ret res[bool, refusal.Error].err{refusal.Error.reason{"a pointer with no size in memory"}}; }
    val word: res[Type, table.Error] = table.intern(?c.m.types, table.Shape.integer{table.Integer{width: (bytes.ok * 8)::u32}});
    if (sel word.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{module.Error.types{word.err}}}; }
    val declared: res[bool, refusal.Error] = declare_lookup(c, ptr.ok);
    if (sel declared.err) { ret declared; }
    val celled: res[bool, refusal.Error] = declare_cell(c);
    if (sel celled.err) { ret celled; }
    val probed: res[bool, refusal.Error] = declare_probe(c, b);
    if (sel probed.err) { ret probed; }
    val exits: res[bool, refusal.Error] = declare_exit(c, b, ptr.ok);
    if (sel exits.err) { ret exits; }
    var placed: Passages = passages(c.m.a, b, ?l);
    fin { forget(?placed); }
    var changed: bool  = declared.ok || celled.ok || probed.ok || exits.ok;
    var i:       usize = 0;
    for (i < c.m.functions.len) {
        val f: Function = (i::u32);
        if (record.touches(c, f)) {
            var w:  Work               = Work{m: c.m, t: c.t, basis: c.basis, build: b, passages: ?placed, convention: build_record.default_row(b), l: ?l, f: f, entry: 0, slots: 0, ptr: ptr.ok, slot: slot.ok, offset: word.ok, unused: vector.init[Instruction](c.m.a), carrier: opt[Value].none{}, storage: opt[Instruction].none{}};
            val ok: err[refusal.Error] = lower(?w);
            vector.dnit[Instruction](?w.unused);
            if (sel ok.err) { ret res[bool, refusal.Error].err{ok.err}; }
            changed = true;
        }
        i = i + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
