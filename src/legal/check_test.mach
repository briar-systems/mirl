# the check the text tests of the legalisations share: text in, a pass run
# through the driver, and the text a pass is expected to leave

use std.types.bool.bool;
use std.types.bool.true;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.record.Pass;
use mirl.target.Target;

# run a pass over the text for a target, which must change it as stated, compare
# the result with the expected text by structure, and run it again, which must
# change nothing
#[testing]
pub fun check(t: *Target, pass: *Pass, before: str, after: str, changes: bool) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    var first: res[Module, Refusal] = parse_body(?a, View{data: before, len: str_len(before)});
    if (sel first.err) { ret 1; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, View{data: after, len: str_len(after)});
    if (sel second.err) { ret 2; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    var d: Driver = driver.init(?m, t, Options{level: 1, checked: true});
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, pass);
    if (sel ran.err)       { ret 3; }
    if (ran.ok != changes) { ret 4; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 5; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, pass);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 8; }
    ret 0;
}
