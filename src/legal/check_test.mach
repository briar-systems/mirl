# the check the text tests of the legalisations share: text in, a pass run
# through the driver, and the text a pass is expected to leave

use std.types.bool.bool;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.pass.driver;
use mirl.pass.driver.Driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.record.Pass;
use mirl.target.Target;

# the bytes a text under construction holds at most
#[testing]
pub val CAPACITY: usize = 131072;

# text under construction
#[testing]
pub rec Text {
    data: [131072]u8;
    len:  usize;
}

# append a string, as much of it as fits
#[testing]
pub fun put(t: *Text, s: str) {
    var i: usize = 0;
    for (i < str_len(s)) {
        if (t.len < CAPACITY) {
            t.data[t.len] = s[i];
            t.len         = t.len + 1;
        }
        i = i + 1;
    }
}

# append a number in decimal
#[testing]
pub fun number(t: *Text, n: u64) {
    var digits: [20]u8;
    var count:  usize = 0;
    var rest:   u64   = n;
    for {
        digits[count] = ('0'::u64 + rest % 10)::u8;
        count         = count + 1;
        rest          = rest / 10;
        if (rest == 0) { brk; }
    }
    for (count > 0) {
        count = count - 1;
        if (t.len < CAPACITY) {
            t.data[t.len] = digits[count];
            t.len         = t.len + 1;
        }
    }
}

# what a text holds
#[testing]
pub fun view(t: *Text) View {
    ret View{data: ?t.data[0], len: t.len};
}

# run a pass over the text for a target, which must change it as stated, compare
# the result with the expected text by structure, and run it again, which must
# change nothing
#[testing]
pub fun check(t: *Target, pass: *Pass, before: str, after: str, changes: bool) i32 {
    ret check_text(t, pass, View{data: before, len: str_len(before)}, View{data: after, len: str_len(after)}, changes);
}

# check over texts given as views
#[testing]
pub fun check_text(t: *Target, pass: *Pass, before: View, after: View, changes: bool) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    var first: res[Module, Refusal] = parse_body(?a, before);
    if (sel first.err) { ret 1; }
    var m: Module = first.ok;
    fin { module.dnit(?m); }
    var second: res[Module, Refusal] = parse_body(?a, after);
    if (sel second.err) { ret 2; }
    var want: Module = second.ok;
    fin { module.dnit(?want); }
    var d: Driver = driver.init(?m, t, Options{level: 1, checked: true});
    fin { driver.dnit(?d); }
    val ran: res[bool, Error] = driver.apply(?d, pass);
    if (sel ran.err)       { ret 3; }
    if (ran.ok != changes) { ret 4; }
    val same: res[bool, printer.Error] = equal.same(?m, ?want);
    if (sel same.err) { ret 5; }
    if (!same.ok)     { ret 6; }
    val again: res[bool, Error] = driver.apply(?d, pass);
    if (sel again.err) { ret 7; }
    if (again.ok)      { ret 8; }
    ret 0;
}
