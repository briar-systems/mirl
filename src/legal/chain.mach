# multi-way branches as compare chains or indexed tables: a branch on a
# selector's cases becomes a test of each case in turn, or a branch on the
# selector's distance from its least case where the target's tables admit it
#
# a row whose rules state a case list over a selector branches to the target
# after the first whose case the selector's value is, or to the first when
# none is. the chain tests the cases in their order, each with `eq` and a
# `cbr` to the case's target or on to the next test, a new block that takes
# no parameters, and the last test goes on to the first target. a branch with
# no case is a `br` to the first target. every target keeps the arguments
# its edge passed, which the block the branch ended dominates, so every new
# block reads them as they stand.
#
# a branch the target's density admits, on a target whose address model can
# place its table, stays a multi-way branch, indexed: its selector is the
# distance from the least case, read unsigned at the width of the target's
# register, and its cases are every value from 0 to its span,
# each to the target of the case it stands for or to the first target where
# no case does. a selector wider than the register is tested against the
# span at its own width first, and one outside it is the span, which is no
# case, so the indexed branch never reads a selector it truncated wrong. a
# branch already indexed is left as it is. the selection branches through a
# table of the indexed branch's targets after its first, testing the
# selector against their count.
#
# the pass applies where the target's control is free: a structured target
# keeps the branch whole for its structured multi-way form, as SPIR-V's
# `OpSwitch` and WebAssembly's `br_table` are. the chain branches on the
# value the branch already branched on, and on no other, so it keeps
# constant time as the branch did.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.allocator.arena;
use std.collections.slice.Slice;

use mirl.build.builder;
use mirl.fold.word;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.rule;
use mirl.ir.opcode.rule.Cases;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.table;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.legal.emit;
use mirl.legal.emit.Site;
use mirl.pass.cache;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.address.Addresses;
use mirl.target.capability.Bits;
use mirl.target.capability.Density;
use mirl.target.capability.Tables;
use mirl.target.record.Target;

# the pass: it adds blocks and edges, so it keeps no analysis
pub val CHAIN: Pass = Pass{name: "compare chain", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.NONE, time: Time.keeps{}, applies: free};

# whether a target's control is free, so a multi-way branch has no form it keeps
fun free(g: *Ground) bool {
    ret sel g.t.caps.control.free;
}

# the case list rule of a row, none when it states none
fun cases_of(r: *Row) opt[Cases] {
    var i: usize = 0;
    for (i < $length_of(Rules)) {
        val rl: Rule = r.rules[i];
        if (sel rl.cases) { ret opt[Cases].some{rl.cases}; }
        i = i + 1;
    }
    ret opt[Cases].none{};
}

fun failed[T](what: str) res[T, refusal.Error] {
    ret res[T, refusal.Error].err{refusal.Error.reason{what}};
}

# one edge of the branch, its arguments copied out of the instruction it
# replaces
fun copied(s: *Site, d: *InstructionData, e: usize) res[Branch, refusal.Error] {
    val from: Slice[Value]                 = Slice[Value]{data: d.edges.data[e].arguments.data, size: d.edges.data[e].arguments.len};
    val room: res[*Value, allocator.Error] = allocator.zallocate[Value](s.scratch, from.size + 1);
    if (sel room.err) { ret res[Branch, refusal.Error].err{refusal.Error.alloc{room.err}}; }
    var j: usize = 0;
    for (j < from.size) {
        room.ok[j] = from.data[j];
        j          = j + 1;
    }
    ret res[Branch, refusal.Error].ok{Branch{block: d.edges.data[e].block, arguments: Slice[Value]{data: room.ok, size: from.size}}};
}

fun jump(s: *Site, to: Branch) {
    var edge: [1]Branch = [1]Branch{to};
    builder.emit(?s.bld, Request{opcode: table.BR, operands: Slice[Value]{data: nil, size: 0}, immediates: Slice[Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: ?edge[0], size: 1}});
}

# one test of the chain: the selector against a case, on to the case's
# target when it is equal and to the next otherwise
fun test_case(s: *Site, selector: Value, value: Value, taken: Branch, next: Branch) {
    val equal: Value     = emit.binary(s, table.EQ, selector, value);
    var cond:  [1]Value  = [1]Value{equal};
    var sides: [2]Branch = [2]Branch{taken, next};
    builder.emit(?s.bld, Request{opcode: table.CBR, operands: Slice[Value]{data: ?cond[0], size: 1}, immediates: Slice[Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: ?sides[0], size: 2}});
}

# the width of the target's register, 0 where it states none
fun register_width(t: *Target) u32 {
    val b: Bits = t.caps.widths.register;
    if (sel b.bits) { ret b.bits; }
    ret 0;
}

# whether the target's tables admit a branch on `cases`, a list in increasing
# order, whose entries from the least case to the greatest fit the register.
# a table is placed by the target's address model, so a target that carries
# none branches through a chain
fun admitted(t: *Target, cases: Slice[u64]) bool {
    val tables: Tables = t.caps.tables;
    if (!(sel tables.dense)) { ret false; }
    val model: Addresses = t.addresses;
    if (!(sel model.model)) { ret false; }
    val d:     Density = tables.dense;
    val count: u64     = cases.size::u64;
    if (count == 0 || count < d.least::u64) { ret false; }
    val span: u64 = cases.data[cases.size - 1] - cases.data[0];
    # the entries, span + 1, are at most 100 / fill per case
    if (span >= count * 100 / d.fill::u64) { ret false; }
    val reg: u32 = register_width(t);
    if (reg == 0)                                     { ret false; }
    if (reg < 64 && span >= (1::u64 << reg::u64) - 1) { ret false; }
    ret true;
}

# whether a branch on `cases` over a selector of `width` bits is indexed: its
# cases are 0 to its count less one, over a selector as wide as the register
fun indexed(t: *Target, width: u32, cases: Slice[u64]) bool {
    if (width != register_width(t)) { ret false; }
    var j: usize = 0;
    for (j < cases.size) {
        if (cases.data[j] != j::u64) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the integer type of a width
fun integer(s: *Site, width: u32) res[Type, refusal.Error] {
    val made: res[Type, type_table.Error] = type_table.intern(?s.m.types, type_table.Shape.integer{type_table.Integer{width: width}});
    if (sel made.err) { ret res[Type, refusal.Error].err{refusal.Error.ir{module.Error.types{made.err}}}; }
    ret res[Type, refusal.Error].ok{made.ok};
}

# the bits of an integer type, 0 for any other
fun width_of(s: *Site, ty: Type) res[u32, refusal.Error] {
    val shape: res[type_table.Shape, type_table.Error] = type_table.shape(?s.m.types, ty);
    if (sel shape.err)           { ret res[u32, refusal.Error].err{refusal.Error.ir{module.Error.types{shape.err}}}; }
    if (!(sel shape.ok.integer)) { ret res[u32, refusal.Error].ok{0}; }
    ret res[u32, refusal.Error].ok{shape.ok.integer.width};
}

# rewrite a branch the tables admit as the indexed branch on the selector's
# distance from its least case, given its edges copied out, first the one
# taken where no case is
fun index(s: *Site, t: *Target, k: Block, n: u32, i: Instruction, selector: Value, ty: Type, width: u32, cases: Slice[u64], edges: *Branch) res[bool, refusal.Error] {
    val reg:  u32                      = register_width(t);
    val wide: res[Type, refusal.Error] = integer(s, reg);
    if (sel wide.err) { ret res[bool, refusal.Error].err{wide.err}; }
    val least:   u64                        = cases.data[0];
    val entries: u64                        = cases.data[cases.size - 1] - least + 1;
    val values:  res[*u64, allocator.Error] = allocator.zallocate[u64](s.scratch, entries::usize);
    if (sel values.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{values.err}}; }
    val targets: res[*Branch, allocator.Error] = allocator.zallocate[Branch](s.scratch, entries::usize + 1);
    if (sel targets.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{targets.err}}; }
    targets.ok[0] = edges[0];
    var v: u64   = 0;
    var c: usize = 0;
    for (v < entries) {
        values.ok[v::usize] = v;
        var to: Branch = edges[0];
        if (c < cases.size && cases.data[c] - least == v) {
            to = edges[c + 1];
            c  = c + 1;
        }
        targets.ok[v::usize + 1] = to;
        v                        = v + 1;
    }
    var low: Value = selector;
    if (least != 0) {
        val made: res[Value, refusal.Error] = emit.constant(s, ty, word.small(least));
        if (sel made.err) { ret res[bool, refusal.Error].err{made.err}; }
        low = made.ok;
    }
    var bound: Value = selector;
    var span:  Value = selector;
    if (width > reg) {
        val top: res[Value, refusal.Error] = emit.constant(s, ty, word.small(entries));
        if (sel top.err) { ret res[bool, refusal.Error].err{top.err}; }
        bound = top.ok;
        val out: res[Value, refusal.Error] = emit.constant(s, wide.ok, word.small(entries));
        if (sel out.err) { ret res[bool, refusal.Error].err{out.err}; }
        span = out.ok;
    }
    emit.open(s, i, k, n);
    var at: Value = selector;
    if (least != 0)  { at = emit.binary(s, table.SUB, selector, low); }
    if (width < reg) { at = emit.convert(s, table.EXT_U, at, wide.ok); }
    or (width > reg) {
        val within: Value = emit.binary(s, table.LT_U, at, bound);
        val cut:    Value = emit.convert(s, table.TRUNC, at, wide.ok);
        at = emit.ternary(s, table.SELECT, within, cut, span);
    }
    emit.close(s, i);
    var ops:  [1]Value     = [1]Value{at};
    var list: [1]Immediate = [1]Immediate{Immediate.cases{Slice[u64]{data: values.ok, size: entries::usize}}};
    builder.emit(?s.bld, Request{opcode: table.SWITCH, operands: Slice[Value]{data: ?ops[0], size: 1}, immediates: Slice[Immediate]{data: ?list[0], size: 1}, targets: Slice[Branch]{data: targets.ok, size: entries::usize + 1}});
    val built: err[refusal.Error] = emit.done(s);
    if (sel built.err) { ret res[bool, refusal.Error].err{built.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# lower the instruction at an index of a block if its row states a case list,
# to the indexed branch where the target's tables admit it and to a compare
# chain otherwise, answering whether it changed it
fun lower(s: *Site, t: *Target, k: Block, n: u32, i: Instruction) res[bool, refusal.Error] {
    val d:   *InstructionData = ?s.b.instructions.data[i.index];
    val row: opt[*Row]        = table.at(d.opcode);
    if (sel row.none) { ret res[bool, refusal.Error].ok{false}; }
    val r:  *Row       = row.some;
    val cs: opt[Cases] = cases_of(r);
    if (sel cs.none) { ret res[bool, refusal.Error].ok{false}; }
    val of: rule.Subject = cs.some.of;
    if (!(sel of.operand)) { ret failed[bool]("a multi-way branch whose selector is no operand"); }
    val at: u32 = of.operand;
    if (at::usize >= d.operands.len)             { ret failed[bool]("a multi-way branch whose selector is no operand"); }
    if (cs.some.slot::usize >= d.immediates.len) { ret failed[bool]("a multi-way branch with no case list"); }
    val list: Immediate = d.immediates.data[cs.some.slot];
    if (!(sel list.cases))                  { ret failed[bool]("a multi-way branch whose case list holds none"); }
    if (d.edges.len != list.cases.size + 1) { ret failed[bool]("a multi-way branch with not one target per case after the first"); }
    val count:    usize = list.cases.size;
    val selector: Value = d.operands.data[at];
    val ty:       Type  = s.b.values.data[selector.index].type;

    # the edges and the case values are read before the branch is replaced
    val edges: res[*Branch, allocator.Error] = allocator.zallocate[Branch](s.scratch, count + 1);
    if (sel edges.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{edges.err}}; }
    val values: res[*Value, allocator.Error] = allocator.zallocate[Value](s.scratch, count + 1);
    if (sel values.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{values.err}}; }
    var e: usize = 0;
    for (e <= count) {
        val got: res[Branch, refusal.Error] = copied(s, d, e);
        if (sel got.err) { ret res[bool, refusal.Error].err{got.err}; }
        edges.ok[e] = got.ok;
        e           = e + 1;
    }
    if (admitted(t, list.cases)) {
        val width: res[u32, refusal.Error] = width_of(s, ty);
        if (sel width.err)                    { ret res[bool, refusal.Error].err{width.err}; }
        if (indexed(t, width.ok, list.cases)) { ret res[bool, refusal.Error].ok{false}; }
        ret index(s, t, k, n, i, selector, ty, width.ok, list.cases, edges.ok);
    }
    e = 0;
    for (e < count) {
        val made: res[Value, refusal.Error] = emit.constant(s, ty, word.small(list.cases.data[e]));
        if (sel made.err) { ret res[bool, refusal.Error].err{made.err}; }
        values.ok[e] = made.ok;
        e            = e + 1;
    }

    emit.open(s, i, k, n);
    if (count == 0) {
        emit.close(s, i);
        jump(s, edges.ok[0]);
        val ended: err[refusal.Error] = emit.done(s);
        if (sel ended.err) { ret res[bool, refusal.Error].err{ended.err}; }
        ret res[bool, refusal.Error].ok{true};
    }
    # the tests after the first, each in a block of its own, in case order
    val tests: res[*Branch, allocator.Error] = allocator.zallocate[Branch](s.scratch, count + 1);
    if (sel tests.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{tests.err}}; }
    e = 1;
    for (e < count) {
        tests.ok[e] = Branch{block: builder.block(?s.bld, Slice[Declaration]{data: nil, size: 0}), arguments: Slice[Value]{data: nil, size: 0}};
        e           = e + 1;
    }
    tests.ok[count] = edges.ok[0];
    e               = 1;
    for (e < count) {
        builder.at_end(?s.bld, tests.ok[e].block);
        test_case(s, selector, values.ok[e], edges.ok[e + 1], tests.ok[e + 1]);
        e = e + 1;
    }
    builder.at(?s.bld, k, n);
    s.made = 0;
    val equal: Value     = emit.binary(s, table.EQ, selector, values.ok[0]);
    var cond:  [1]Value  = [1]Value{equal};
    var sides: [2]Branch = [2]Branch{edges.ok[1], tests.ok[1]};
    emit.close(s, i);
    builder.emit(?s.bld, Request{opcode: table.CBR, operands: Slice[Value]{data: ?cond[0], size: 1}, immediates: Slice[Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: ?sides[0], size: 2}});
    val built: err[refusal.Error] = emit.done(s);
    if (sel built.err) { ret res[bool, refusal.Error].err{built.err}; }
    ret res[bool, refusal.Error].ok{true};
}

# lower the multi-way branches of one function
fun visit(u: *Unit) res[bool, refusal.Error] {
    val c:   *Context                 = u.context;
    val got: res[*Body, module.Error] = module.body(c.m, u.f);
    if (sel got.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{got.err}}; }

    var ar:   arena.Arena;
    val made: err[allocator.Error] = arena.init(?ar, c.m.a, 0);
    if (sel made.err) { ret res[bool, refusal.Error].err{refusal.Error.alloc{made.err}}; }
    fin { arena.dnit(?ar); }
    var scratch: allocator.Allocator;
    arena.make(?scratch, ?ar);

    var s:       Site  = emit.init(c.m, u.f, got.ok, ?scratch);
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < got.ok.blocks.len) {
        if (!got.ok.blocks.data[k].erased && got.ok.blocks.data[k].instructions.len != 0) {
            arena.reset(?ar);
            val last: usize                    = got.ok.blocks.data[k].instructions.len - 1;
            val i:    Instruction              = got.ok.blocks.data[k].instructions.data[last];
            val done: res[bool, refusal.Error] = lower(?s, c.t, Block{index: k::u32}, last::u32, i);
            if (sel done.err) { ret res[bool, refusal.Error].err{done.err}; }
            if (done.ok)      { changed = true; }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
