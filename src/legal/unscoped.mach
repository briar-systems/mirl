# the markers of where a slot's storage begins and ends erased, for a family
# whose frames give every slot storage of its own
#
# `slot.begin` and `slot.end` state where a local's storage lasts, which the
# sharing of frame slots reads (`mirl.machine.frame.share`). a family that
# never lays two slots in one storage has no reader of them, and erases them
# after the last of its rows that may make one (a legalisation may, as the
# aggregates one does for the slot of a large value), so the rows after it
# and its emitter meet none, and every row before it carries them as a
# register family's does.
# erasing a marker changes no access, so the pass keeps constant time.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.body;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.table;
use mirl.pass.analysis;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;

pub val UNSCOPED: Pass = Pass{name: "unscoped", kind: Kind.legalise{}, scope: Scope.function{visit}, needs: 0, preserves: analysis.FLOW, time: Time.keeps{}};

fun visit(u: *Unit) res[bool, refusal.Error] {
    val m:        *Module                  = u.context.m;
    val res_body: res[*Body, module.Error] = module.body(m, u.f);
    if (sel res_body.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{res_body.err}}; }
    val b:       *Body = res_body.ok;
    var changed: bool  = false;
    var k:       usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var x: Instruction = b.blocks.data[k].first;
            for (x != NO_INSTRUCTION) {
                val next: Instruction = b.instructions.data[x].next;
                val op:   u32         = b.instructions.data[x].opcode;
                if (table.marks(op)) {
                    val err_erased: err[module.Error] = body.erase(m, u.f, x);
                    if (sel err_erased.err) { ret res[bool, refusal.Error].err{refusal.Error.ir{err_erased.err}}; }
                    changed = true;
                }
                x = next;
            }
        }
        k = k + 1;
    }
    ret res[bool, refusal.Error].ok{changed};
}
