# mirl's failures worded for a reader, from the outer case to the leaf, each with the class a tool's exit code
# follows
#
# one rule decides the class: an allocator refusal anywhere in the chain is the environment's, whatever the
# outer case says, and otherwise the case that refused decides whether the source can clear it. a front end
# and mirl's own commands word every failure through here, so a case is worded where it is added

use std.allocator;
use std.collections.slice.Slice;
use std.types.option.opt;
use std.types.string.str;

use mirl.failure.starved;
use mirl.failure.word;
use mirl.ir.module.Module;
use mirl.opt.offer;
use pass_failure: mirl.pass.failure;
use mirl.target.family;
use mirl.target.record.Target;
use verify_failure: mirl.verify.failure;

fwd mirl.failure.text;
fwd mirl.failure.text.Class;
fwd mirl.failure.text.Out;

# word a compilation's failure and class it
# ---
# o:     where the words go
# m:     the module the compilation was given
# t:     the target it was compiled for
# added: the extensions the build added past the target's
# e:     why it failed
# ret:   the class of what refused
pub fun compiled(o: *Out, m: *Module, t: *Target, added: Slice[str], e: family.Error) Class {
    val said:        Class                = word.failed(o, m, t, added, e);
    val opt_starved: opt[allocator.Error] = starved.compiled(e);
    if (sel opt_starved.some) { ret Class.environment{}; }
    ret said;
}

# word a failed run of the pass schedule and class it
# ---
# o:   where the words go
# m:   the module the run was given
# e:   why it failed
# ret: the class of what refused
pub fun scheduled(o: *Out, m: *Module, e: pass_failure.Error) Class {
    val said:        Class                = word.pass_failed(o, m, e);
    val opt_starved: opt[allocator.Error] = starved.scheduled(e);
    if (sel opt_starved.some) { ret Class.environment{}; }
    ret said;
}

# the allocator's refusal a compilation's failure ends at, wherever in its chain it stands, so a front end
# reports storage refused with no words of its own, as nothing need be allocated to say it
# ---
# e:   the compilation's failure
# ret: the allocator's refusal, none for a failure that does not end at one
pub fun starved_of(e: family.Error) opt[allocator.Error] {
    ret starved.compiled(e);
}

# word a verifier refusal of a module read from text, which the source clears
pub fun verified(o: *Out, m: *Module, f: verify_failure.Failure) Class {
    ret word.refused_verify(o, m, f);
}

# word an offer of a module's bodies that was not made or not read, and class it
# ---
# o:   where the words go
# m:   the module the offer was made from or read into
# e:   why it was not made or not read
# ret: the class of what refused
pub fun offered(o: *Out, m: *Module, e: offer.Error) Class {
    val said:        Class                = word.offer_failed(o, m, e);
    val opt_starved: opt[allocator.Error] = starved.offered(e);
    if (sel opt_starved.some) { ret Class.environment{}; }
    ret said;
}
