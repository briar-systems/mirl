# constant time: the question a constant-time function's code asks of masc
#
# masc's rows are the one source of every constant-time fact, and mirl states
# none. a row's class (`masc.core.ct.Class`) says which of its inputs its
# timing depends on, under a condition over the selection and the state axes,
# and a set's timing (`masc.core.ct.Timing`) says whether its rows are
# classified at all. the machine form asks of an instruction the latency
# refusal of a secret in one of its inputs, read from its row's class under
# the context the function runs under, and masc's walk decides the encoded
# bytes under that context. constant-time code is compiled with every timing
# mode the guarantee may assume taken as on (`assume`, mach#3872): dit=on on
# aarch64, doitm=on on x86-64 and the zkt extension on riscv, whatever the
# build's extension set and the target's system declare, as std turns the mode on wherever it exists and the
# mode is best effort (mach#4861). the walk decides which the code needs: it
# reads the code under the build's context with the modes the system sets for
# every process (`stated`), doitm=on, and where a row is refused there it reads
# it again with the modes the runtime sets only for a module that needs one,
# dit=on. code that holds only under such a mode needs it, and its module
# carries the mode's mark (`mark`). the answer keys on the set's timing through
# `ct.required`: a set that classifies its rows holds the requirement for the
# code its walk clears, one whose timing is not guaranteed, as wasm, compiles
# the code with the warning masc words once (`ct.UNGUARANTEED`), and one that
# classifies none, as spir-v, refuses the requirement with the record masc
# words once. code of a typed stream, as wasm's, is walked under a context
# whose stream the caller has entered into the function it is the body of.
# code the walk cannot follow on a set whose timing is not guaranteed
# compiles with the warning as not verified, its discipline kept by mirl's own
# passes. the walk's seeds, its declassify points, the model of each call its
# code makes and the secrecy the machine form asks about are the caller's. a
# secret reaching a callee whose model states it is not checked constant time
# is refused, naming the callee where the call names one.
#
# every site that refuses constant-time code reports the one record here,
# `Refused`, which carries masc's refusal and where in a function it stands:
# the ir's oblivious check (`mirl.ct.oblivious`), the machine form's latency
# check, the walk of the encoded bytes and a pass that cannot keep the
# requirement. code the walk cannot follow on a set that classifies its rows
# is reported as `Unfollowed`, and a function whose own frame reads a slot no
# store reaches first as `Stale`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use mirl.ct.frame;
use mirl.ir.debug.Location;
use mirl.ir.id.Function;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;

use masc.core.ct;
use masc.core.extension;
use masc.core.requirement;
use rows: masc.core.row;
use masc.core.state;
use masc.walk.walk;

# how a constant-time requirement on a function's code is answered
# ---
# held:    the set classifies its rows and the walk cleared the code, which compiles, needing the timing modes these
#          name (`Needs`), none when the code holds under the modes the system sets for every process
# warned:  the set cannot guarantee any instruction's timing, so the code compiles with the warning worded
#          `ct.UNGUARANTEED`, stating no guarantee. none when the walk followed the code and found no secret where
#          it may hold none, and why not when the walk could not follow it
# refused: the requirement is refused with masc's one record: a secret the walk found where the code may hold none
#          under every timing mode, or a set that classifies no instruction's timing, at offset 0
# unread:  the set classifies its rows and the walk could not follow the code, so nothing is decided and the
#          requirement is not met
pub tag Answer: u8 {
    held:    Needs;
    warned:  opt[walk.Unread];
    refused: walk.Finding;
    unread:  walk.Unread;
}

# the latency refusal of a secret at input `at` of an instruction of row `row`, read from the row's class under the
# context `timed` the function's timing is asked under (`Timed`, from `assume`), none when its timing does not depend
# on that input there
pub fun latency(row: *rows.Row, timed: *state.Context, at: ct.Input) opt[ct.Refusal] {
    ret ct.latency(row.ct, timed, timed.view.file, at);
}

# how a timing mode the constant-time guarantee assumes comes to hold where the code runs
# ---
# stated:   the system sets it for every process, so every constant-time function is checked under it. a state axis
#           value only, as an extension the system states is the build's own set
# needed:   the runtime sets it only for a program a module of which needs it
# promised: the hardware promises it, nothing sets it and std only reports it, for a program a module of which needs it
pub tag Held: u8 {
    stated;
    needed:   Needed;
    promised: Needed;
}

# what a timing mode a module may need takes
# ---
# mark: the local absolute symbol, of value 1, an object of a module that needs it carries, which the link reads
pub rec Needed {
    mark: str;
}

# where a timing mode stands in masc's sets
# ---
# axis:      a value of a state axis, by the axis's name and the value's
# extension: an extension of the set's catalog, by name, whose requirement a row's timing is gated on
pub tag Kind: u8 {
    axis:      Setting;
    extension: str;
}

# a value of a state axis
# ---
# name:  the axis's name in masc's rows
# value: the value's name
pub rec Setting {
    name:  str;
    value: str;
}

# a timing mode the constant-time guarantee assumes: what it is in masc's rows and how it comes to hold
# ---
# kind: what it is
# held: how it comes to hold
rec Mode {
    kind: Kind;
    held: Held;
}

# the timing modes a constant-time function may run under, whatever the build's context says (mach#3872, "The
# guarantee"). on x86-64 the system sets the data operand independent timing mode, which the documentation states as
# the assumption. on aarch64 std sets PSTATE.DIT at start, where the system lets it, for a program whose link holds a
# module that needs it (mach doc/language/secrecy.md, "PSTATE.DIT at run time"). on riscv Zkt is an ISA promise of
# data-independent latency that adds no instruction and that nothing sets, so a row's timing is gated on the
# extension and std only reports whether the hardware has it
val MODES: [3]Mode = [3]Mode{
    Mode{kind: Kind.axis{Setting{name: "dit", value: "on"}}, held: Held.needed{Needed{mark: "__mach_needs_dit"}}},
    Mode{kind: Kind.axis{Setting{name: "doitm", value: "on"}}, held: Held.stated{}},
    Mode{kind: Kind.extension{"zkt"}, held: Held.promised{Needed{mark: "__mach_needs_zkt"}}},
};

# the timing modes of MODES code needs, one bit per mode at its index
pub def Needs: u32;

# no mode
pub val NO_NEEDS: Needs = 0;

# how many modes MODES holds, the bits of `Needs`
pub val MODE_COUNT: usize = $length_of(MODES);

# the mark an object of a module that needs mode `i` of `n` carries, none when `n` does not need it or it has none
pub fun mark(n: Needs, i: usize) opt[str] {
    if (i >= MODE_COUNT || (n & (1::u32 << i::u32)) == 0) { ret opt[str].none{}; }
    val h: Held = MODES[i].held;
    if (sel h.needed)   { ret opt[str].some{h.needed.mark}; }
    if (sel h.promised) { ret opt[str].some{h.promised.mark}; }
    ret opt[str].none{};
}

# `ctx` with the axis value `s` set, when its set has an axis of it holding the value. false when it has none
fun with_axis(ctx: *state.Context, s: Setting) bool {
    var k: u32 = 0;
    for (k < ctx.axes.len) {
        val axis: *state.Axis = ?ctx.axes.at[k];
        if (str_equals(axis.name, s.name)) {
            var v: u32 = 0;
            for (v < axis.values.len) {
                if (str_equals(axis.values.at[v].name, s.value)) { ret state.set(ctx, k, v::u8); }
                v = v + 1;
            }
        }
        k = k + 1;
    }
    ret false;
}

# the extension `name` of the set of `ctx`, none when its catalog has none
fun extension_of(ctx: *state.Context, name: str) opt[requirement.Id] {
    ret extension.lookup(ctx.selection.catalog, name, 0, str_len(name));
}

# whether the set of `ctx` has what mode `i` is, an axis holding its value or the extension
fun has_mode(ctx: *state.Context, i: usize) bool {
    val k: Kind = MODES[i].kind;
    if (sel k.axis) {
        var probe: state.Context = @ctx;
        ret with_axis(?probe, k.axis);
    }
    val id: opt[requirement.Id] = extension_of(ctx, k.extension);
    ret sel id.some;
}

# the context a constant-time function's timing is asked under, and the storage of the selection it holds when a mode
# is an extension
# ---
# context:   the context, whose selection is `selection` when `owned`
# selection: the build's selection with the extensions of the modes taken as on
# owned:     whether `selection` holds storage `release` gives back
pub rec Timed {
    context:   state.Context;
    selection: extension.Selection;
    owned:     bool;
}

# `ctx` unchanged, as a `Timed` that owns nothing
pub fun plain(ctx: *state.Context) Timed {
    ret Timed{context: @ctx, selection: @ctx.selection, owned: false};
}

# give back what `t` owns
pub fun release(t: *Timed) {
    if (!t.owned) { ret; }
    val gone: err[A.Error] = extension.release(?t.selection);
    t.owned = false;
}

# `t` made the context `ctx` with the modes of `n` set, and the modes of `n` its set has into `had`. an extension
# joins a selection of its own, so the build's selection, which decides what is selected, is never changed. the
# extension is left out, and so not had, when the set cannot take it
# ---
# t: from `plain`, which `release` gives back
fun open(a: *A.Allocator, ctx: *state.Context, n: Needs, had: *Needs, t: *Timed) err[A.Error] {
    @t   = plain(ctx);
    @had = NO_NEEDS;
    var ids: vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?ids); }
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0) {
            val k: Kind = MODES[m].kind;
            if (sel k.axis) {
                if (with_axis(?t.context, k.axis)) { @had = @had | bit; }
            }
            if (sel k.extension) {
                val id: opt[requirement.Id] = extension_of(ctx, k.extension);
                if (sel id.some) {
                    val pushed: res[usize, A.Error] = vector.push[requirement.Id](?ids, id.some);
                    if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
                    @had = @had | bit;
                }
            }
        }
        m = m + 1;
    }
    if (ids.len == 0) { ret err[A.Error].ok{}; }
    val chosen: res[extension.Selection, extension.Error] = extension.added(a, ctx.selection, requirement.Ids{at: ids.data, len: ids.len::u32});
    if (sel chosen.err) {
        if (sel chosen.err.memory) { ret err[A.Error].err{chosen.err.memory}; }
        @had = stated_axes(@had);
        ret err[A.Error].ok{};
    }
    t.selection         = chosen.ok;
    t.owned             = true;
    t.context.selection = ?t.selection;
    ret err[A.Error].ok{};
}

# the modes of `n` that are state axis values
fun stated_axes(n: Needs) Needs {
    var out: Needs = NO_NEEDS;
    var m:   usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0 && (sel MODES[m].kind.axis)) { out = out | bit; }
        m = m + 1;
    }
    ret out;
}

# the modes of MODES the system sets for every process
fun stated_modes() Needs {
    var n: Needs = NO_NEEDS;
    var m: usize = 0;
    for (m < MODE_COUNT) {
        if (sel MODES[m].held.stated) { n = n | (1::u32 << m::u32); }
        m = m + 1;
    }
    ret n;
}

# the modes of MODES a program gets only when a module of it needs them: the runtime sets them, or the hardware
# promises them
fun lifting_modes() Needs {
    var n: Needs = NO_NEEDS;
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val h: Held = MODES[m].held;
        if ((sel h.needed) || (sel h.promised)) { n = n | (1::u32 << m::u32); }
        m = m + 1;
    }
    ret n;
}

# the context a constant-time function is checked under before any mode it may need: `ctx` with every mode the
# system sets for every process, each a state axis value
pub fun stated(ctx: *state.Context) state.Context {
    var timed: state.Context = @ctx;
    val n:     Needs         = stated_modes();
    var m:     usize         = 0;
    for (m < MODE_COUNT) {
        val k: Kind = MODES[m].kind;
        if ((n & (1::u32 << m::u32)) != 0) {
            if (sel k.axis) { val set: bool = with_axis(?timed, k.axis); }
        }
        m = m + 1;
    }
    ret timed;
}

# `t` made the context the machine form asks a constant-time function's rows under: `ctx` with every timing mode of
# MODES its set has set, the one place that context is made. it changes what a row's timing is gated on and nothing
# an instruction is selected or encoded by
# ---
# t: from `plain`, which `release` gives back
pub fun assume(a: *A.Allocator, ctx: *state.Context, t: *Timed) err[A.Error] {
    var had: Needs = NO_NEEDS;
    ret open(a, ctx, stated_modes() | lifting_modes(), ?had, t);
}

# how a constant-time requirement on the encoded code `code` is answered, walked under the context `ctx` the
# function runs under with the modes the system sets for every process (`stated`), from the secrets `secrets`, public
# again only at the declassify points `public` states (`walk.NO_DECLASSIFIED` for none), each call walked through the
# model `calls` states of its callee (`walk.NO_CALLS` for none, every call then walked as one with no model). code a
# row of which is refused there for its latency is walked again with the modes the runtime sets on need, assumed on
# whatever the target's system declares, and holds needing them where it holds then
# ---
# ret: the answer, or why the walk had no storage
pub fun check(a: *A.Allocator, code: *walk.Code, ctx: *state.Context, secrets: *walk.Secrets, public: *walk.Declassified, calls: *walk.Calls) res[Answer, A.Error] {
    val base:  Needs                = stated_modes();
    val first: res[Answer, A.Error] = walk_once(a, code, ctx, base, secrets, public, calls);
    if (sel first.err)       { ret first; }
    if (!liftable(first.ok)) { ret first; }
    val needed: Needs = had_of(ctx, lifting_modes());
    if (needed == NO_NEEDS) { ret first; }
    val again: res[Answer, A.Error] = walk_once(a, code, ctx, base | needed, secrets, public, calls);
    if (sel again.err) { ret again; }
    val last: Answer = again.ok;
    if (sel last.held) { ret res[Answer, A.Error].ok{Answer.held{needed}}; }
    ret again;
}

# whether `got` is a refusal of a row for its latency, which a timing mode may lift
fun liftable(got: Answer) bool {
    if (sel got.refused) { ret got.refused.refusal.reason == ct.LATENCY; }
    ret false;
}

# the modes of `n` the set of `ctx` has
fun had_of(ctx: *state.Context, n: Needs) Needs {
    var had: Needs = NO_NEEDS;
    var m:   usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0 && has_mode(ctx, m)) { had = had | bit; }
        m = m + 1;
    }
    ret had;
}

# the answer of one walk of `code` under `ctx` with the modes of `n` set
fun walk_once(a: *A.Allocator, code: *walk.Code, ctx: *state.Context, n: Needs, secrets: *walk.Secrets, public: *walk.Declassified, calls: *walk.Calls) res[Answer, A.Error] {
    val asked: ct.Required = ct.required(code.set.ct);
    var had:   Needs       = NO_NEEDS;
    var timed: Timed       = plain(ctx);
    fin { release(?timed); }
    val opened: err[A.Error] = open(a, ctx, n, ?had, ?timed);
    if (sel opened.err) { ret res[Answer, A.Error].err{opened.err}; }
    val walked: res[walk.Verdict, A.Error] = walk.check(a, code, ?timed.context, secrets, public, calls);
    if (sel walked.err) { ret res[Answer, A.Error].err{walked.err}; }
    val v: walk.Verdict = walked.ok;
    if (sel v.refused) { ret res[Answer, A.Error].ok{Answer.refused{v.refused}}; }
    if (sel v.unread) {
        if (sel asked.unguaranteed) { ret res[Answer, A.Error].ok{Answer.warned{opt[walk.Unread].some{v.unread}}}; }
        ret res[Answer, A.Error].ok{Answer.unread{v.unread}};
    }
    if (sel v.unguaranteed) { ret res[Answer, A.Error].ok{Answer.warned{opt[walk.Unread].none{}}}; }
    ret res[Answer, A.Error].ok{Answer.held{NO_NEEDS}};
}

# where in a function's code a constant-time refusal stands
# ---
# instruction: an instruction of the ir or of the machine form, by its index
# offset:      a byte of the encoded code, from the function's start
# whole:       the function as a whole, as a set that classifies no timing refuses it
pub tag Where: u8 {
    instruction: u32;
    offset:      u64;
    whole;
}

# a function refused as constant time, the one record every site reports
# ---
# function: the function
# at:       where in its code
# refusal:  masc's record, worded once
# callee:   the callee a secret reached that is not checked constant time, for a refusal worded `ct.UNCHECKED` of a
#           call that names one, none otherwise
# location: the source location of the instruction it stands at, an encoded offset's mapped through the line facts
#           emission stated, none for the function as a whole or an instruction that states none
pub rec Refused {
    function: Function;
    at:       Where;
    refusal:  ct.Refusal;
    callee:   opt[Function];
    location: opt[Location];
}

# a constant-time function whose encoded code the walk could not follow, on a set that classifies its rows, so the
# requirement is not met
# ---
# function: the function
# unread:   why and where, in the walk's words
# location: the source location of the instruction at the offset it stopped
#           at, none for none
pub rec Unfollowed {
    function: Function;
    unread:   walk.Unread;
    location: opt[Location];
}

# a constant-time function whose own frame reads a slot no store of the function reaches first on some path from its
# entry (`mirl.ct.frame`), so the read takes stale stack an earlier frame may have left a secret in, which the walk
# seeds nothing of and reads as public
# ---
# function: the function
# at:       the alloca of the slot, or the function as a whole where its slots could not be found
# location: the alloca's source location, none for none
pub rec Stale {
    function: Function;
    at:       Where;
    location: opt[Location];
}

# why a constant-time requirement was not met
# ---
# refused:    a secret where the code may hold none, or a set that classifies no timing
# unfollowed: the walk could not follow the code
# stale:      the function's own frame reads a slot no store reaches first
pub tag Unmet: u8 {
    refused:    Refused;
    unfollowed: Unfollowed;
    stale:      Stale;
}

# the refusal of function `f` of `m` when its own frame reads a slot no store of it reaches first, which its walk would
# take as public, naming the slot's alloca, none when it reads none. the one rule of every target's constant-time path
pub fun fresh(a: *A.Allocator, m: *Module, f: Function) res[opt[Unmet], A.Error] {
    val found: res[frame.Slots, module.Error] = frame.of(a, m, f);
    if (sel found.err) {
        if (sel found.err.alloc) { ret res[opt[Unmet], A.Error].err{found.err.alloc}; }
        ret res[opt[Unmet], A.Error].ok{opt[Unmet].some{Unmet.stale{Stale{function: f, at: Where.whole{}, location: opt[Location].none{}}}}};
    }
    var slots: frame.Slots = found.ok;
    fin { frame.release(?slots); }
    val slot: opt[u32] = frame.stale(?slots);
    if (sel slot.none) { ret res[opt[Unmet], A.Error].ok{opt[Unmet].none{}}; }
    val d: *InstructionData = ?m.functions.data[f.index].body.instructions.data[slot.some::usize];
    ret res[opt[Unmet], A.Error].ok{opt[Unmet].some{Unmet.stale{Stale{function: f, at: Where.instruction{slot.some}, location: d.metadata.location}}}};
}

# the refusal of a function at `at` with masc's record `r`, at the source location `l`
pub fun refused(f: Function, at: Where, r: ct.Refusal, l: opt[Location]) Refused {
    ret Refused{function: f, at: at, refusal: r, callee: opt[Function].none{}, location: l};
}

# the one wording of `r` spelled onto `out`, with what of a condition its context lacked
pub fun spell(r: *ct.Refusal, out: *vector.Vector[u8]) err[A.Error] {
    ret ct.spell(r, out);
}
