# constant time: the question a constant-time function's code asks of masc
#
# masc's rows are the one source of every constant-time fact, and mirl states
# none. a row's class (`masc.core.ct.Class`) says which of its inputs its
# timing depends on, under a condition over the selection and the state axes,
# and a set's timing (`masc.core.ct.Timing`) says whether its rows are
# classified at all. the machine form asks of an instruction the latency
# refusal of a secret in one of its inputs, read from its row's class under
# the context the function runs under, and masc's walk decides the encoded
# bytes under that context. a selection an inline block states adds rows to
# what the walk decodes and never to what a row's timing is asked under, as
# `check` says. constant-time code is compiled with every timing
# mode the guarantee may assume taken as on (`assume`, mach#3872): dit=on on
# aarch64, doitm=on on x86-64 and the zkt extension on riscv. how each comes to
# hold is one table, `MODES`: the system sets doitm for every process, a
# constant-time function switches dit on around its own code with the rows
# its set's switch of the value states (`masc.core.switch`, placed through
# `mirl.legal.timing` and selection), and zkt is the hardware's promise,
# which nothing sets. a function's mode (`mirl.ir.function.ConstantTime`) decides
# how the walk reads the code. a soft function holds under every mode the
# processor offers, best effort (mach briar-systems/mach#4881): the walk reads
# the code under the build's context with the modes the system sets for every
# process (`stated`), and where a row is refused there it reads it again with
# the modes switched on or promised. a hard function holds only under the
# modes the build guarantees (`guaranteed`): the system's, a switched mode
# whose guarantee the build selects, and a promised extension the build
# selects, a switched mode's guarantee being what the rows of its switch's
# set steps require. code that holds only under a mode the build does not
# guarantee is refused, naming the mode's feature (`Answer.unguaranteed`,
# `missing`). the answer keys on the set's timing through
# `ct.required`: a set that classifies its rows holds the requirement for the
# code its walk clears, one whose timing is not guaranteed, as wasm, compiles
# the code with the warning masc words once (`ct.UNGUARANTEED`), and one that
# classifies none, as spir-v, refuses the requirement with the record masc
# words once. code of a typed stream, as wasm's, is walked under a context
# whose stream the caller has entered into the function it is the body of.
# code the walk cannot follow on a set whose timing is not guaranteed
# compiles with the warning as not verified, its discipline kept by mirl's own
# passes. the walk's seeds, its declassify points, the model of each call its
# code makes and the secrecy the machine form asks about are the caller's. a
# secret reaching a callee whose model states it is not checked constant time
# is refused, naming the callee where the call names one.
#
# every site that refuses constant-time code reports the one record here,
# `Refused`, which carries masc's refusal and where in a function it stands:
# the ir's oblivious check (`mirl.ct.oblivious`), the machine form's latency
# check, the walk of the encoded bytes and a pass that cannot keep the
# requirement. code the walk cannot follow on a set that classifies its rows
# is reported as `Unfollowed`, a function whose own frame reads a slot no
# store reaches first as `Stale`, and a hard function whose code needs a mode
# the build does not guarantee as `Unguaranteed`. a soft function compiled
# with the warning is reported as `Unheld`, which the compilation returns as
# data and never writes. a record of a function as a whole points at the
# function's source through `location`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use A: std.allocator;
use std.collections.vector;

use mirl.ct.frame;
use mirl.ir.block.BlockData;
use mirl.ir.debug.record.Location;
use mirl.ir.function.Body;
use mirl.ir.function.ConstantTime;
use mirl.ir.id.Function;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.target.layout.Layout;

use masc.core.ct;
use masc.core.extension;
use masc.core.requirement;
use rows: masc.core.row;
use mset: masc.core.set;
use masc.core.state;
use mswitch: masc.core.switch;
use masc.walk;

# how a constant-time requirement on a function's code is answered
# ---
# held:         the set classifies its rows and the walk cleared the code, which compiles
# warned:       the set cannot guarantee any instruction's timing, so the code of a soft function compiles with the
#               warning worded `ct.UNGUARANTEED`, stating no guarantee. none when the walk followed the code and found
#               no secret where it may hold none, and why not when the walk could not follow it
# refused:      the requirement is refused with masc's one record: a secret the walk found where the code may hold
#               none under every timing mode the function's mode admits, or a set that classifies no instruction's
#               timing, at offset 0
# unread:       the set classifies its rows and the walk could not follow the code, so nothing is decided and the
#               requirement is not met
# unguaranteed: the code of a hard function holds only under the timing modes these name, which the build does not
#               guarantee, or none of them when the set guarantees no instruction's timing at all
pub tag Answer: u8 {
    held;
    warned:       opt[walk.Unread];
    refused:      walk.Finding;
    unread:       walk.Unread;
    unguaranteed: Needs;
}

# the latency refusal of a secret at input `at` of an instruction of row `row`, read from the row's class under the
# context `timed` the function's timing is asked under (`Timed`, from `assume`), none when its timing does not depend
# on that input there
pub fun latency(row: *rows.Row, timed: *state.Context, at: ct.Input) opt[ct.Refusal] {
    ret ct.latency(row.ct, timed, timed.view.file, at);
}

# how a timing mode the constant-time guarantee assumes comes to hold where the code runs
# ---
# stated:   the system sets it for every process, so every constant-time function is checked under it. a state axis
#           value only, as an extension the system states is the build's own set
# switched: a constant-time function switches it on around its own code with the rows its set's switch of the value
#           states, where the processor has it, which a build guarantees by admitting the rows of the switch's set
#           steps. a state axis value only
# promised: the hardware promises it and nothing sets it, where the processor has the mode's extension, which a build
#           guarantees by selecting it. an extension only
pub tag Held: u8 {
    stated;
    switched;
    promised;
}

# the byte std defines and sets before main and before any thread starts, 1 when the processor provides the timing
# mode a constant-time function switches on and the process may switch it, 0 otherwise. a soft function whose build
# does not guarantee the mode reads it as an external hidden global and switches the mode only where it is 1 (mirl#643)
pub val AVAILABLE: str = "__mach_timing_available";

# where a timing mode stands in masc's sets
# ---
# axis:      a value of a state axis, by the axis's name and the value's
# extension: an extension of the set's catalog, by name, whose requirement a row's timing is gated on
pub tag Kind: u8 {
    axis:      Setting;
    extension: str;
}

# a value of a state axis
# ---
# name:  the axis's name in masc's rows
# value: the value's name
pub rec Setting {
    name:  str;
    value: str;
}

# a timing mode the constant-time guarantee assumes: what it is in masc's rows and how it comes to hold
# ---
# kind: what it is
# held: how it comes to hold
rec Mode {
    kind: Kind;
    held: Held;
}

# the timing modes a constant-time function may run under, whatever the build's context says (mach#3872, "The
# guarantee"). on x86-64 the system sets the data operand independent timing mode, which the documentation states as
# the assumption. on aarch64 a constant-time function switches dit on around its own code (briar-systems/mach#4881), as
# masc's switch of the value states.
# on riscv Zkt is an ISA promise of data-independent latency that adds no instruction and that nothing sets, so a
# row's timing is gated on the extension
val MODES: [3]Mode = [3]Mode{
    Mode{kind: Kind.axis{Setting{name: "dit", value: "on"}}, held: Held.switched{}},
    Mode{kind: Kind.axis{Setting{name: "doitm", value: "on"}}, held: Held.stated{}},
    Mode{kind: Kind.extension{"zkt"}, held: Held.promised{}},
};

# the timing modes of MODES code needs, one bit per mode at its index
pub def Needs: u32;

# no mode
pub val NO_NEEDS: Needs = 0;

# how many modes MODES holds, the bits of `Needs`
pub val MODE_COUNT: usize = $length_of(MODES);

# the feature a build selects to guarantee mode `i` of `set`, spelled onto `out` as the set's catalog names it: the
# extensions the first way of meeting each set step of a switched mode's switch names, a promised mode's extension,
# and the axis of a mode the system sets or a switched one the set states no switch of
fun feature(set: *mset.Set, i: usize, out: *vector.Vector[u8]) err[A.Error] {
    val m: Mode = MODES[i];
    if (sel m.kind.extension) { ret extension.append(out, m.kind.extension); }
    if (sel m.held.switched) {
        val sw: opt[*mswitch.Switch] = switch_of(set, m.kind.axis);
        if (sel sw.some) {
            if (set.codec != nil) {
                var wrote: bool = false;
                var k:     u32  = 0;
                for (k < sw.some.set.len) {
                    val r: *rows.Row = rows.at(set.codec.rows, sw.some.set.at[k].row);
                    if (r != nil && r.requires.len != 0) {
                        val all: requirement.Ids = r.requires.at[0].all;
                        var n:   u32             = 0;
                        for (n < all.len) {
                            if (all.at[n] < set.extensions.count) {
                                if (wrote) {
                                    val sep: err[A.Error] = extension.append(out, "+");
                                    if (sel sep.err) { ret sep; }
                                }
                                val named: err[A.Error] = extension.append(out, set.extensions.extensions[all.at[n]].name);
                                if (sel named.err) { ret named; }
                                wrote = true;
                            }
                            n = n + 1;
                        }
                    }
                    k = k + 1;
                }
                if (wrote) { ret err[A.Error].ok{}; }
            }
        }
    }
    ret extension.append(out, m.kind.axis.name);
}

# the atom of the axis value `s` in a set of `catalog` and `axes`, none where it has no such axis or value
fun atom_of(catalog: *extension.Catalog, axes: *state.Axes, s: Setting) opt[requirement.Id] {
    var k: u32 = 0;
    for (k < axes.len) {
        val axis: *state.Axis = ?axes.at[k];
        if (str_equals(axis.name, s.name)) {
            var v: u32 = 0;
            for (v < axis.values.len) {
                if (str_equals(axis.values.at[v].name, s.value)) { ret opt[requirement.Id].some{state.atom(catalog, axes, k, v::u8)}; }
                v = v + 1;
            }
        }
        k = k + 1;
    }
    ret opt[requirement.Id].none{};
}

# the switch `set` states of the axis value `s`, none where it states none
fun switch_of(set: *mset.Set, s: Setting) opt[*mswitch.Switch] {
    val atom: opt[requirement.Id] = atom_of(set.extensions, ?set.states, s);
    if (sel atom.none) { ret opt[*mswitch.Switch].none{}; }
    ret mswitch.switching(set.switches, atom.some);
}

# whether the selection of `ctx` admits every row of the set steps of switch `sw` of `set`, so the processor has what
# the switch switches and the switch reads no availability
fun admits_switch(set: *mset.Set, ctx: *state.Context, sw: *mswitch.Switch) bool {
    if (set.codec == nil) { ret false; }
    var k: u32 = 0;
    for (k < sw.set.len) {
        val r: *rows.Row = rows.at(set.codec.rows, sw.set.at[k].row);
        if (r == nil)                       { ret false; }
        if (!state.admits(ctx, r.requires)) { ret false; }
        k = k + 1;
    }
    ret true;
}

# `ctx` with the axis value `s` set, when its set has an axis of it holding the value. false when it has none
fun with_axis(ctx: *state.Context, s: Setting) bool {
    var k: u32 = 0;
    for (k < ctx.axes.len) {
        val axis: *state.Axis = ?ctx.axes.at[k];
        if (str_equals(axis.name, s.name)) {
            var v: u32 = 0;
            for (v < axis.values.len) {
                if (str_equals(axis.values.at[v].name, s.value)) { ret state.set(ctx, k, v::u8); }
                v = v + 1;
            }
        }
        k = k + 1;
    }
    ret false;
}

# the extension `name` of the set of `ctx`, none when its catalog has none
fun extension_of(ctx: *state.Context, name: str) opt[requirement.Id] {
    ret extension.lookup(ctx.selection.catalog, name, 0, str_len(name));
}

# whether the set of `ctx` has what mode `i` is, an axis holding its value or the extension
fun has_mode(ctx: *state.Context, i: usize) bool {
    val k: Kind = MODES[i].kind;
    if (sel k.axis) {
        var probe: state.Context = @ctx;
        ret with_axis(?probe, k.axis);
    }
    val id: opt[requirement.Id] = extension_of(ctx, k.extension);
    ret sel id.some;
}

# the context a constant-time function's timing is asked under, and the storage of the selection it holds when a mode
# is an extension
# ---
# context:   the context, whose selection is `selection` when `owned`
# selection: the build's selection with the extensions of the modes taken as on
# owned:     whether `selection` holds storage `release` gives back
pub rec Timed {
    context:   state.Context;
    selection: extension.Selection;
    owned:     bool;
}

# `ctx` unchanged, as a `Timed` that owns nothing
pub fun plain(ctx: *state.Context) Timed {
    ret Timed{context: @ctx, selection: @ctx.selection, owned: false};
}

# give back what `t` owns
pub fun release(t: *Timed) {
    if (!t.owned) { ret; }
    val gone: err[A.Error] = extension.release(?t.selection);
    t.owned = false;
}

# `t` made the context `ctx` with the modes of `n` set, and the modes of `n` its set has into `had`. an extension
# joins a selection of its own, so the build's selection, which decides what is selected, is never changed. the
# extension is left out, and so not had, when the set cannot take it
# ---
# t: from `plain`, which `release` gives back
fun open(a: *A.Allocator, ctx: *state.Context, n: Needs, had: *Needs, t: *Timed) err[A.Error] {
    ret open_with(a, ctx, n, requirement.NO_IDS, had, t);
}

# `open`, the atoms `also` joining the selection with the modes' extensions
fun open_with(a: *A.Allocator, ctx: *state.Context, n: Needs, also: requirement.Ids, had: *Needs, t: *Timed) err[A.Error] {
    @t   = plain(ctx);
    @had = NO_NEEDS;
    var ids: vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?ids); }
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0) {
            val k: Kind = MODES[m].kind;
            if (sel k.axis) {
                if (with_axis(?t.context, k.axis)) { @had = @had | bit; }
            }
            if (sel k.extension) {
                val id: opt[requirement.Id] = extension_of(ctx, k.extension);
                if (sel id.some) {
                    val pushed: res[usize, A.Error] = vector.push[requirement.Id](?ids, id.some);
                    if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
                    @had = @had | bit;
                }
            }
        }
        m = m + 1;
    }
    var k: u32 = 0;
    for (k < also.len) {
        val pushed: res[usize, A.Error] = vector.push[requirement.Id](?ids, also.at[k]);
        if (sel pushed.err) { ret err[A.Error].err{pushed.err}; }
        k = k + 1;
    }
    if (ids.len == 0) { ret err[A.Error].ok{}; }
    val chosen: res[extension.Selection, extension.Error] = extension.added(a, ctx.selection, requirement.Ids{at: ids.data, len: ids.len::u32});
    if (sel chosen.err) {
        if (sel chosen.err.memory) { ret err[A.Error].err{chosen.err.memory}; }
        @had = stated_axes(@had);
        ret err[A.Error].ok{};
    }
    t.selection         = chosen.ok;
    t.owned             = true;
    t.context.selection = ?t.selection;
    ret err[A.Error].ok{};
}

# the modes of `n` that are state axis values
fun stated_axes(n: Needs) Needs {
    var out: Needs = NO_NEEDS;
    var m:   usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0 && (sel MODES[m].kind.axis)) { out = out | bit; }
        m = m + 1;
    }
    ret out;
}

# the modes of MODES the system sets for every process
fun stated_modes() Needs {
    var n: Needs = NO_NEEDS;
    var m: usize = 0;
    for (m < MODE_COUNT) {
        if (sel MODES[m].held.stated) { n = n | (1::u32 << m::u32); }
        m = m + 1;
    }
    ret n;
}

# the modes of MODES the system does not set: those a function switches on and those the hardware promises
fun lifting_modes() Needs {
    var n: Needs = NO_NEEDS;
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val h: Held = MODES[m].held;
        if ((sel h.switched) || (sel h.promised)) { n = n | (1::u32 << m::u32); }
        m = m + 1;
    }
    ret n;
}

# whether the selection of `ctx` selects the extension `name`, false where its catalog has none
fun selects(ctx: *state.Context, name: str) bool {
    val id: opt[requirement.Id] = extension_of(ctx, name);
    if (sel id.none) { ret false; }
    ret extension.has(ctx.selection, id.some);
}

# the modes of MODES the build of `ctx` over `set` guarantees: every mode the system sets, a switched mode `set` states
# a switch of whose set steps the build admits, which the function then switches on unguarded, and a promised mode
# whose extension it selects
pub fun guaranteed(set: *mset.Set, ctx: *state.Context) Needs {
    var n: Needs = NO_NEEDS;
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val h:    Held = MODES[m].held;
        var held: bool = sel h.stated;
        if (sel h.switched) {
            val k: Kind = MODES[m].kind;
            if (sel k.axis) {
                if (has_mode(ctx, m)) {
                    val sw: opt[*mswitch.Switch] = switch_of(set, k.axis);
                    if (sel sw.some) { held = admits_switch(set, ctx, sw.some); }
                }
            }
        }
        if (sel h.promised) {
            val k: Kind = MODES[m].kind;
            if (sel k.extension) { held = selects(ctx, k.extension); }
        }
        if (held) { n = n | (1::u32 << m::u32); }
        m = m + 1;
    }
    ret n;
}

# how a constant-time function of a build switches a timing mode on around its code
# ---
# switch:     the set's switch of the mode's state value
# state:      that value's atom
# guaranteed: the build admits every row of the switch's set steps, so the processor has the mode and the switch
#             reads no availability
pub rec Switching {
    switch:     *mswitch.Switch;
    state:      requirement.Id;
    guaranteed: bool;
}

# the switch a constant-time function of the build of `ctx` over `set` makes, none where `set` states no switch of a
# mode a function switches
pub fun switching(set: *mset.Set, ctx: *state.Context) opt[Switching] {
    var m: usize = 0;
    for (m < MODE_COUNT) {
        val k: Kind = MODES[m].kind;
        if (sel k.axis) {
            if ((sel MODES[m].held.switched) && has_mode(ctx, m)) {
                val atom: opt[requirement.Id] = atom_of(set.extensions, ?set.states, k.axis);
                if (sel atom.some) {
                    val sw: opt[*mswitch.Switch] = mswitch.switching(set.switches, atom.some);
                    if (sel sw.some) { ret opt[Switching].some{Switching{switch: sw.some, state: atom.some, guaranteed: admits_switch(set, ctx, sw.some)}}; }
                }
            }
        }
        m = m + 1;
    }
    ret opt[Switching].none{};
}

# the modes of MODES the set of `ctx` has that the system does not set: those a function switches on and those the
# hardware promises
pub fun liftable_modes(ctx: *state.Context) Needs {
    ret had_of(ctx, lifting_modes());
}

# `t` made the context `ctx` with every mode the system sets and the modes of `n` set, as the walk reads timing under
# them
# ---
# t: from `plain`, which `release` gives back
pub fun under(a: *A.Allocator, ctx: *state.Context, n: Needs, t: *Timed) err[A.Error] {
    var had: Needs = NO_NEEDS;
    ret open(a, ctx, stated_modes() | n, ?had, t);
}

# the context a constant-time function is checked under before any mode it may need: `ctx` with every mode the
# system sets for every process, each a state axis value
pub fun stated(ctx: *state.Context) state.Context {
    var timed: state.Context = @ctx;
    val n:     Needs         = stated_modes();
    var m:     usize         = 0;
    for (m < MODE_COUNT) {
        val k: Kind = MODES[m].kind;
        if ((n & (1::u32 << m::u32)) != 0) {
            if (sel k.axis) { val set: bool = with_axis(?timed, k.axis); }
        }
        m = m + 1;
    }
    ret timed;
}

# `t` made the context the machine form asks a constant-time function's rows under: `ctx` with every timing mode of
# MODES its set has set, the one place that context is made. it changes what a row's timing is gated on and nothing
# an instruction is selected or encoded by
# ---
# t: from `plain`, which `release` gives back
pub fun assume(a: *A.Allocator, ctx: *state.Context, t: *Timed) err[A.Error] {
    var had: Needs = NO_NEEDS;
    ret open(a, ctx, stated_modes() | lifting_modes(), ?had, t);
}

# how the constant-time requirement of mode `mode` on the encoded code `code` is answered, from the secrets
# `secrets`, public again only at the declassify points `public` states (`walk.NO_DECLASSIFIED` for none), each call
# walked through the model `calls` states of its callee (`walk.NO_CALLS` for none, every call then walked as one with
# no model). the code is walked under the context `ctx` the function runs under with the modes the system sets for
# every process (`stated`) for a soft function and with the modes the build of context `build` guarantees
# (`guaranteed`) for a hard one, read off the build's selection and never off the extensions a function names past
# it, which the switch's own instructions widen it by (`mirl.legal.timing`). code a row of which is refused there for its latency is walked again with the other modes the set has. a soft
# function holds where it holds then, and a hard one is refused as unguaranteed, naming those modes. a hard function
# on a set that guarantees no instruction's timing is refused as unguaranteed, naming none. `decode` is the context the
# code is decoded under, `ctx` with what the selections its inline blocks state add (`mirl.target.head`), and a row's
# timing is never asked under it, so nothing a block adds lifts a row. `gated` names the atoms of those that gate
# timing, as a row's gate may need an atom or exclude it: code that holds is held again with them in the selection, so
# a block's atom can refuse code and never clear it
# ---
# ret: the answer, or why the walk had no storage
pub fun check(a: *A.Allocator, code: *walk.Code, ctx: *state.Context, decode: *state.Context, gated: requirement.Ids, build: *state.Context, secrets: *walk.Secrets, public: *walk.Declassified, calls: *walk.Calls, mode: ConstantTime) res[Answer, A.Error] {
    val got: res[Answer, A.Error] = answered(a, code, ctx, decode, requirement.NO_IDS, build, secrets, public, calls, mode);
    if (sel got.err)                          { ret got; }
    if (gated.len == 0 || !(sel got.ok.held)) { ret got; }
    ret answered(a, code, ctx, decode, gated, build, secrets, public, calls, mode);
}

# the answer of `check` with the atoms `also` in the selection a row's timing is asked under
fun answered(a: *A.Allocator, code: *walk.Code, ctx: *state.Context, decode: *state.Context, also: requirement.Ids, build: *state.Context, secrets: *walk.Secrets, public: *walk.Declassified, calls: *walk.Calls, mode: ConstantTime) res[Answer, A.Error] {
    val hard: bool  = sel mode.hard;
    var base: Needs = stated_modes();
    if (hard) { base = guaranteed(code.set, build); }
    val first: res[Answer, A.Error] = walk_once(a, code, ctx, decode, also, base, secrets, public, calls);
    if (sel first.err)                 { ret first; }
    if (hard && (sel first.ok.warned)) { ret res[Answer, A.Error].ok{Answer.unguaranteed{NO_NEEDS}}; }
    if (!liftable(first.ok))           { ret first; }
    val lifted: Needs = had_of(ctx, lifting_modes()) & ~base;
    if (lifted == NO_NEEDS) { ret first; }
    val again: res[Answer, A.Error] = walk_once(a, code, ctx, decode, also, base | lifted, secrets, public, calls);
    if (sel again.err) { ret again; }
    val last: Answer = again.ok;
    if (hard && (sel last.held)) { ret res[Answer, A.Error].ok{Answer.unguaranteed{lifted}}; }
    ret again;
}

# whether `got` is a refusal of a row for its latency, which a timing mode may lift
fun liftable(got: Answer) bool {
    if (sel got.refused) { ret got.refused.refusal.reason == ct.LATENCY; }
    ret false;
}

# the modes of `n` the set of `ctx` has
fun had_of(ctx: *state.Context, n: Needs) Needs {
    var had: Needs = NO_NEEDS;
    var m:   usize = 0;
    for (m < MODE_COUNT) {
        val bit: Needs = 1::u32 << m::u32;
        if ((n & bit) != 0 && has_mode(ctx, m)) { had = had | bit; }
        m = m + 1;
    }
    ret had;
}

# the answer of one walk of `code`, decoded under `decode` with each row's timing asked under `ctx` with the modes of
# `n` set and the atoms `also` held
fun walk_once(a: *A.Allocator, code: *walk.Code, ctx: *state.Context, decode: *state.Context, also: requirement.Ids, n: Needs, secrets: *walk.Secrets, public: *walk.Declassified, calls: *walk.Calls) res[Answer, A.Error] {
    val asked: ct.Required = ct.required(code.set.ct);
    var had:   Needs       = NO_NEEDS;
    var timed: Timed       = plain(ctx);
    fin { release(?timed); }
    val opened: err[A.Error] = open_with(a, ctx, n, also, ?had, ?timed);
    if (sel opened.err) { ret res[Answer, A.Error].err{opened.err}; }
    val walked: res[walk.Verdict, A.Error] = walk.check_timed(a, code, decode, ?timed.context, secrets, public, calls);
    if (sel walked.err) { ret res[Answer, A.Error].err{walked.err}; }
    val v: walk.Verdict = walked.ok;
    if (sel v.refused) { ret res[Answer, A.Error].ok{Answer.refused{v.refused}}; }
    if (sel v.unread) {
        if (sel asked.unguaranteed) { ret res[Answer, A.Error].ok{Answer.warned{opt[walk.Unread].some{v.unread}}}; }
        ret res[Answer, A.Error].ok{Answer.unread{v.unread}};
    }
    if (sel v.unguaranteed) { ret res[Answer, A.Error].ok{Answer.warned{opt[walk.Unread].none{}}}; }
    ret res[Answer, A.Error].ok{Answer.held{}};
}

# where in a function's code a constant-time refusal stands
# ---
# instruction: an instruction of the ir or of the machine form, by its index
# offset:      a byte of the encoded code, from the function's start
# whole:       the function as a whole, as a set that classifies no timing refuses it
pub tag Where: u8 {
    instruction: u32;
    offset:      u64;
    whole;
}

# a function refused as constant time, the one record every site reports
# ---
# function: the function
# at:       where in its code
# refusal:  masc's record, worded once
# callee:   the callee a secret reached that is not checked constant time, for a refusal worded `ct.UNCHECKED` of a
#           call that names one, none otherwise
# location: the source location of the instruction it stands at, an encoded offset's mapped through the line facts
#           emission stated, the function's (`location`) for the function as a whole, none for none
pub rec Refused {
    function: Function;
    at:       Where;
    refusal:  ct.Refusal;
    callee:   opt[Function];
    location: opt[Location];
}

# a constant-time function whose encoded code the walk could not follow, on a set that classifies its rows, so the
# requirement is not met
# ---
# function: the function
# unread:   why and where, in the walk's words
# location: the source location of the instruction at the offset it stopped
#           at, none for none
pub rec Unfollowed {
    function: Function;
    unread:   walk.Unread;
    location: opt[Location];
}

# a constant-time function whose own frame reads a slot no store of the function reaches first on some path from its
# entry (`mirl.ct.frame`), so the read takes stale stack an earlier frame may have left a secret in, which the walk
# seeds nothing of and reads as public
# ---
# function: the function
# at:       the alloca of the slot, or the function as a whole where its slots could not be found
# location: the alloca's source location, none for none
pub rec Stale {
    function: Function;
    at:       Where;
    location: opt[Location];
}

# a hard constant-time function whose code holds only under timing modes the build does not guarantee
# ---
# function: the function
# needs:    the modes, each named by the feature that guarantees it (`missing`), none when the set guarantees no
#           instruction's timing under any mode
# set:      the instruction set the function's code is of
# location: the function's source location (`location`), none for none
pub rec Unguaranteed {
    function: Function;
    needs:    Needs;
    set:      *mset.Set;
    location: opt[Location];
}

# a soft constant-time function on a set that guarantees no instruction's timing, compiled with the warning worded
# `ct.UNGUARANTEED`, so its timing is not held
# ---
# function: the function
# location: the function's source location (`location`), none for none
# unread:   what the walk could not follow, when it could not, which leaves its code not verified
pub rec Unheld {
    function: Function;
    location: opt[Location];
    unread:   opt[walk.Unread];
}

# why a constant-time requirement was not met
# ---
# refused:      a secret where the code may hold none, or a set that classifies no timing
# unfollowed:   the walk could not follow the code
# stale:        the function's own frame reads a slot no store reaches first
# unguaranteed: a hard function's code needs a timing mode the build does not guarantee
pub tag Error: u8 {
    refused:      Refused;
    unfollowed:   Unfollowed;
    stale:        Stale;
    unguaranteed: Unguaranteed;
}

# the features that guarantee the modes of `n` of `set`, spelled onto `out` apart by a comma, nothing for none
pub fun missing(set: *mset.Set, n: Needs, out: *vector.Vector[u8]) err[A.Error] {
    var first: bool  = true;
    var m:     usize = 0;
    for (m < MODE_COUNT) {
        if ((n & (1::u32 << m::u32)) != 0) {
            if (!first) {
                val sep: err[A.Error] = extension.append(out, ", ");
                if (sel sep.err) { ret sep; }
            }
            val wrote: err[A.Error] = feature(set, m, out);
            if (sel wrote.err) { ret wrote; }
            first = false;
        }
        m = m + 1;
    }
    ret err[A.Error].ok{};
}

# the refusal of function `f` of `m`, laid out by `l`, when its own frame reads a slot no store of it reaches first,
# which its walk would take as public, naming the slot's alloca, none when it reads none. the one rule of every
# target's constant-time path
pub fun fresh(a: *A.Allocator, m: *Module, l: *Layout, f: Function) res[opt[Error], A.Error] {
    val found: res[frame.Slots, module.Error] = frame.of(a, m, l, f);
    if (sel found.err) {
        if (sel found.err.alloc) { ret res[opt[Error], A.Error].err{found.err.alloc}; }
        ret res[opt[Error], A.Error].ok{opt[Error].some{Error.stale{Stale{function: f, at: Where.whole{}, location: opt[Location].none{}}}}};
    }
    var slots: frame.Slots = found.ok;
    fin { frame.release(?slots); }
    val slot: opt[u32] = frame.stale(?slots);
    if (sel slot.none) { ret res[opt[Error], A.Error].ok{opt[Error].none{}}; }
    val d: *InstructionData = ?m.functions.data[f.index].body.instructions.data[slot.some::usize];
    ret res[opt[Error], A.Error].ok{opt[Error].some{Error.stale{Stale{function: f, at: Where.instruction{slot.some}, location: d.metadata.location}}}};
}

# the source location a record of function `f` of `m` as a whole points at: the first location its body states, its
# blocks and their instructions taken in order, none when it states none, as the module's debug records state no
# location of a function itself
pub fun location(m: *Module, f: Function) opt[Location] {
    if (f.index::usize >= m.functions.len) { ret opt[Location].none{}; }
    val b: *Body = ?m.functions.data[f.index].body;
    var k: usize = 0;
    for (k < b.blocks.len) {
        val block: *BlockData = ?b.blocks.data[k];
        if (!block.erased) {
            var i: usize = 0;
            for (i < block.instructions.len) {
                val l: opt[Location] = b.instructions.data[block.instructions.data[i].index].metadata.location;
                if (sel l.some) { ret l; }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret opt[Location].none{};
}

# the refusal of a function at `at` with masc's record `r`, at the source location `l`
pub fun refused(f: Function, at: Where, r: ct.Refusal, l: opt[Location]) Refused {
    ret Refused{function: f, at: at, refusal: r, callee: opt[Function].none{}, location: l};
}

# the one wording of `r` spelled onto `out`, with what of a condition its context lacked
pub fun spell(r: *ct.Refusal, out: *vector.Vector[u8]) err[A.Error] {
    ret ct.spell(r, out);
}
