# the structurizer as a legalisation: it runs where the target declares that
# control flow must be structured, and rewrites any graph until its shape is
#
# each round mends the first flaw the shape finds, threads every value the
# rewrite left short of a use, and asks again, until the graph is structured.
# the tree of regions is then the structure analysis of the function, cached
# for the emitter, so it is always read from the graph as it is and no side
# table can drift from it.
#
# it keeps constant time. a function that requires it branches on no secret,
# so every branch a dispatch replaces is public, every selector is public and
# every test of one is a branch on public data, of fixed latency and taken
# along public paths only. splitting copies blocks without changing what runs
# along any path. a selector replacing a secret branch is itself secret, so a
# function that breaks the requirement still shows that it does.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;

use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.loops.Loops;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.record.Ground;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.structure.region;
use mirl.structure.region.Structure;
use mirl.structure.repair;
use mirl.structure.rewrite;
use mirl.structure.shape;
use mirl.structure.shape.Flaw;
use mirl.structure.shape.Work;

# the pass: it reshapes the graph, recomputes every analysis after its last
# edit and leaves them all, the structure among them, valid
pub val STRUCTURIZE: Pass = Pass{name: "structure", kind: Kind.legalise{}, scope: Scope.function{visit}, preserves: cache.ALL, time: Time.keeps{}, applies: structured};

# whether a target needs structured control flow
fun structured(g: *Ground) bool {
    ret sel g.t.caps.control.structured;
}

# drop every analysis of a function a round changed
fun forgotten(c: *cache.Cache, f: Function) err[refusal.Error] {
    val err_forget: err[allocator.Error] = cache.forget(c, f);
    if (sel err_forget.err) { ret err[refusal.Error].err{refusal.Error.alloc{err_forget.err}}; }
    ret err[refusal.Error].ok{};
}

# one round: thread values the last rewrite left short, or mend the first
# flaw, or find the graph structured
# ---
# ret: whether it changed the function, none once the graph is structured
fun step(u: *Unit, w: *Work) res[opt[bool], refusal.Error] {
    val c:            *cache.Cache               = u.context.cache;
    val m:            *Module                    = u.context.m;
    val res_graph_of: res[*Graph, refusal.Error] = analysis.graph_of(c, u.f);
    if (sel res_graph_of.err) { ret res[opt[bool], refusal.Error].err{res_graph_of.err}; }
    val res_dominance_of: res[*Dominance, refusal.Error] = analysis.dominance_of(c, u.f);
    if (sel res_dominance_of.err) { ret res[opt[bool], refusal.Error].err{res_dominance_of.err}; }
    val res_loops_of: res[*Loops, refusal.Error] = analysis.loops_of(c, u.f);
    if (sel res_loops_of.err) { ret res[opt[bool], refusal.Error].err{res_loops_of.err}; }
    val res_threaded: res[bool, refusal.Error] = repair.repair(m, u.f, res_dominance_of.ok);
    if (sel res_threaded.err) { ret res[opt[bool], refusal.Error].err{res_threaded.err}; }
    if (res_threaded.ok)      { ret res[opt[bool], refusal.Error].ok{opt[bool].some{true}}; }
    var s: Structure = region.init(m.a);
    fin { region.dnit(?s); }
    val res_found: res[opt[Flaw], allocator.Error] = shape.find(m.a, res_graph_of.ok, res_dominance_of.ok, res_loops_of.ok, w, ?s);
    if (sel res_found.err)     { ret res[opt[bool], refusal.Error].err{refusal.Error.alloc{res_found.err}}; }
    if (sel res_found.ok.none) { ret res[opt[bool], refusal.Error].ok{opt[bool].none{}}; }
    val err_mended: err[refusal.Error] = rewrite.mend(m, u.f, res_graph_of.ok, res_dominance_of.ok, res_found.ok.some, w);
    if (sel err_mended.err) { ret res[opt[bool], refusal.Error].err{err_mended.err}; }
    ret res[opt[bool], refusal.Error].ok{opt[bool].some{true}};
}

# the most rounds a function of b blocks and e edges takes
#
# no rewrite but a tangle's makes or keeps a cycle entered at two blocks, and
# each tangle's takes its entries out of every cycle left, so there are at
# most b of those. a latch is mended once per header, and only a tangle makes
# a header. an exit or a merge is mended at the outermost construct a walk
# from the entry finds unsettled, its edges then leaving through one block,
# and a later rewrite unsettles it again only by mending a construct nested
# in it, which it does at most once for each of the b constructs around an
# edge's source. so every edge is moved at most b + 1 times, every move is a
# round, and a round that threads values follows each one.
fun rounds(b: usize, e: usize) usize {
    ret 2 * (b + e + 1) * (b + 2) + 64;
}

# the number of edges of a graph, counted over every block's successors
fun edges(g: *Graph) usize {
    var n: usize = 0;
    var i: u32   = 0;
    for (i < g.count) {
        n = n + graph.successors(g, i).size;
        i = i + 1;
    }
    ret n;
}

# structure one function, refusing one that has not settled within the
# rounds its graph as given can take
fun visit(u: *Unit) res[bool, refusal.Error] {
    val m:            *Module                    = u.context.m;
    val res_graph_of: res[*Graph, refusal.Error] = analysis.graph_of(u.context.cache, u.f);
    if (sel res_graph_of.err) { ret res[bool, refusal.Error].err{res_graph_of.err}; }
    val limit:   usize = rounds(res_graph_of.ok.count::usize, edges(res_graph_of.ok));
    var rounds:  usize = 0;
    var changed: bool  = false;
    var w:       Work  = shape.init(m.a);
    fin { shape.dnit(?w); }
    for {
        val res_stepped: res[opt[bool], refusal.Error] = step(u, ?w);
        if (sel res_stepped.err)     { ret res[bool, refusal.Error].err{res_stepped.err}; }
        if (sel res_stepped.ok.none) { brk; }
        changed = true;
        val err_dropped: err[refusal.Error] = forgotten(u.context.cache, u.f);
        if (sel err_dropped.err) { ret res[bool, refusal.Error].err{err_dropped.err}; }
        rounds = rounds + 1;
        if (rounds > limit) { ret res[bool, refusal.Error].err{refusal.Error.reason{"the graph did not settle into a structured shape"}}; }
    }
    val res_structure_of: res[*Structure, refusal.Error] = analysis.structure_of(u.context.cache, u.f);
    if (sel res_structure_of.err) { ret res[bool, refusal.Error].err{res_structure_of.err}; }
    ret res[bool, refusal.Error].ok{changed};
}
