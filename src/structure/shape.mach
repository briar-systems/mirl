# the shape of a structured graph: its tree of regions, or the first flaw that
# keeps it from having one
#
# it reads only the graph view, its dominance and its loops, so any form of
# code with numbered blocks is structured by it. a region is a set of blocks
# whose entry dominates them all and that edges from outside enter only at its
# entry. the function is one, a loop's body and its continue sequence are
# each one, a selection's arm is every block of the region its head
# dominates, and what is left of a region after a selection or a loop is the
# rest of its sequence, entered only at that construct's merge.
#
# a graph is structured when it is reducible, every loop has one latch and
# leaves only to one block of the region around it, and every selection's
# arms leave only to one block of its region, which is its merge, besides a
# break, a continue or a return. a flaw names where this first fails, and the
# edges a rewrite moves to mend it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Edge;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.NONE;
use mirl.ir.cfg.loops;
use mirl.ir.cfg.loops.Loops;
use mirl.structure.region;
use mirl.structure.region.Kind;
use mirl.structure.region.Structure;

# an edge, as its source and its position among the source's successors
# ---
# from: the source
# edge: the position
pub rec Site {
    from: u32;
    edge: u32;
}

# what keeps a graph from being structured
# ---
# twin:    a block that branches to one block by two edges, the second named
# tangle:  a cycle entered at more than one block, an irreducible region
# latches: a loop, by its header, entered back by more than one edge
# exits:   a loop, by its header, left to more than one block or to a block
#          outside the region around it
# merge:   a selection, by its header, whose arms reconverge on more than one
#          block or on the merge of a construct around it
# stray:   an edge from this block to a block of no region it may reach, a
#          defect of the shape
pub tag Flaw: u8 {
    twin: Site;
    tangle;
    latches: u32;
    exits:   u32;
    merge:   u32;
    stray:   u32;
}

# the edges a flaw is mended by moving
# ---
# edges:   the edges to move
# targets: the blocks they enter, each once, in the order a dispatch tests
#          them: by first edge, and a tangle's entries in reverse postorder
# blocks:  a tangle's blocks, and otherwise the blocks whose branches choose
#          among the edges
pub rec Work {
    edges:   vector.Vector[Site];
    targets: vector.Vector[u32];
    blocks:  vector.Vector[u32];
}

# empty work
pub fun init(a: *allocator.Allocator) Work {
    ret Work{edges: vector.init[Site](a), targets: vector.init[u32](a), blocks: vector.init[u32](a)};
}

# give back the storage of work
pub fun dnit(w: *Work) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[Site](?w.edges);
    keep(?failed, vector.dnit[u32](?w.targets));
    keep(?failed, vector.dnit[u32](?w.blocks));
    ret failed;
}

fun reset(w: *Work) {
    w.edges.len   = 0;
    w.targets.len = 0;
    w.blocks.len  = 0;
}

# what a flaw is, in a few words
pub fun why(f: Flaw) str {
    if (sel f.twin)    { ret "a block branches to one block twice"; }
    if (sel f.tangle)  { ret "a cycle is entered at more than one block"; }
    if (sel f.latches) { ret "a loop is entered back by more than one edge"; }
    if (sel f.exits)   { ret "a loop leaves other than through one block"; }
    if (sel f.merge)   { ret "a selection reconverges other than on one block"; }
    ret "an edge reaches a block outside every region it may reach";
}

# where a region goes on to: a merge, a break or a continue
# ---
# merge: the merge of the construct around it, NONE at the top of a loop body
#        or of the function
# brk:   the merge of the innermost loop around it
# cont:  the latch of the innermost loop around it, and the header within
#        that loop's continue sequence
rec Context {
    merge: u32;
    brk:   u32;
    cont:  u32;
}

# one region of a sequence, and the block the sequence goes on at
rec Step {
    item: u32;
    next: u32;
}

rec Walk {
    a:     *allocator.Allocator;
    g:     *Graph;
    d:     *Dominance;
    l:     *Loops;
    s:     *Structure;
    w:     *Work;
    owner: vector.Vector[u32];
    stack: vector.Vector[u32];
    ids:   u32;
    flaw:  opt[Flaw];
}

fun push(v: *vector.Vector[u32], x: u32) err[allocator.Error] {
    val pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

fun holds(v: *vector.Vector[u32], x: u32) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == x) { ret true; }
        i = i + 1;
    }
    ret false;
}

# an edge to move, and its target once among the targets
fun moves(w: *Work, from: u32, edge: u32, to: u32) err[allocator.Error] {
    val pushed: res[usize, allocator.Error] = vector.push[Site](?w.edges, Site{from: from, edge: edge});
    if (sel pushed.err)        { ret err[allocator.Error].err{pushed.err}; }
    if (holds(?w.targets, to)) { ret err[allocator.Error].ok{}; }
    ret push(?w.targets, to);
}

# the position of an edge from one node to another, NONE when there is none
fun position(g: *Graph, from: u32, to: u32) u32 {
    val succs: Slice[u32] = graph.successors(g, from);
    var i:     usize      = 0;
    for (i < succs.size) {
        if (succs.data[i] == to) { ret i::u32; }
        i = i + 1;
    }
    ret NONE;
}

fun found(k: *Walk, f: Flaw) err[allocator.Error] {
    k.flaw = opt[Flaw].some{f};
    ret err[allocator.Error].ok{};
}

fun stopped(k: *Walk) bool {
    ret sel k.flaw.some;
}

# a block that names one successor twice
fun twins(k: *Walk) {
    val order: Slice[u32] = dominance.order(k.d);
    var i:     usize      = 0;
    for (i < order.size) {
        val succs: Slice[u32] = graph.successors(k.g, order.data[i]);
        var e:     usize      = 1;
        for (e < succs.size) {
            var j: usize = 0;
            for (j < e) {
                if (succs.data[j] == succs.data[e]) {
                    k.flaw = opt[Flaw].some{Flaw.twin{Site{from: order.data[i], edge: e::u32}}};
                    ret;
                }
                j = j + 1;
            }
            e = e + 1;
        }
        i = i + 1;
    }
}

# an edge that is no back edge, its target not dominating its source
fun forward(d: *Dominance, from: u32, to: u32) bool {
    ret !dominance.dominates(d, to, from);
}

fun fill(v: *vector.Vector[u32], n: u32, x: u32) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[u32](v, n::usize);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: u32 = 0;
    for (i < n) {
        vector.push[u32](v, x);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the blocks of a tangle, its entries in reverse postorder, and every edge
# into an entry from a reachable block
fun entered(k: *Walk, inside: *vector.Vector[u32]) err[allocator.Error] {
    val order: Slice[u32] = dominance.order(k.d);
    var i:     usize      = 0;
    for (i < order.size) {
        val n: u32 = order.data[i];
        if (inside.data[n] != 0) {
            val kept: err[allocator.Error] = push(?k.w.blocks, n);
            if (sel kept.err) { ret kept; }
            val preds: Slice[u32] = graph.predecessors(k.g, n);
            var entry: bool       = false;
            var j:     usize      = 0;
            for (j < preds.size) {
                val p: u32 = preds.data[j];
                if (dominance.reachable(k.d, p) && inside.data[p] == 0 && forward(k.d, p, n)) { entry = true; }
                j = j + 1;
            }
            if (entry) {
                val target: err[allocator.Error] = push(?k.w.targets, n);
                if (sel target.err) { ret target; }
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < k.w.targets.len) {
        val n:     u32        = k.w.targets.data[i];
        val preds: Slice[u32] = graph.predecessors(k.g, n);
        var j:     usize      = 0;
        for (j < preds.size) {
            val p: u32 = preds.data[j];
            if (dominance.reachable(k.d, p)) {
                val pushed: res[usize, allocator.Error] = vector.push[Site](?k.w.edges, Site{from: p, edge: position(k.g, p, n)});
                if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the first strongly connected set of more than one block over the forward
# edges, which tarjan's walk finds, and which only an irreducible graph has
fun tangles(k: *Walk) err[allocator.Error] {
    val n:     u32                = k.g.count;
    var index: vector.Vector[u32] = vector.init[u32](k.a);
    var low:   vector.Vector[u32] = vector.init[u32](k.a);
    var next:  vector.Vector[u32] = vector.init[u32](k.a);
    var on:    vector.Vector[u32] = vector.init[u32](k.a);
    var stack: vector.Vector[u32] = vector.init[u32](k.a);
    var calls: vector.Vector[u32] = vector.init[u32](k.a);
    fin {
        vector.dnit[u32](?index);
        vector.dnit[u32](?low);
        vector.dnit[u32](?next);
        vector.dnit[u32](?on);
        vector.dnit[u32](?stack);
        vector.dnit[u32](?calls);
    }
    var failed: err[allocator.Error] = fill(?index, n, NONE);
    keep(?failed, fill(?low, n, 0));
    keep(?failed, fill(?next, n, 0));
    keep(?failed, fill(?on, n, 0));
    if (sel failed.err) { ret failed; }
    if (n == 0)         { ret failed; }

    var counter: u32 = 0;
    val root:    u32 = k.g.entry;
    index.data[root] = counter;
    low.data[root]   = counter;
    counter          = counter + 1;
    on.data[root]    = 1;
    keep(?failed, push(?stack, root));
    keep(?failed, push(?calls, root));
    if (sel failed.err) { ret failed; }
    for (calls.len > 0) {
        val x:     u32        = calls.data[calls.len - 1];
        val succs: Slice[u32] = graph.successors(k.g, x);
        if (next.data[x]::usize < succs.size) {
            val y: u32 = succs.data[next.data[x]];
            next.data[x] = next.data[x] + 1;
            if (!forward(k.d, x, y)) { cnt; }
            if (index.data[y] == NONE) {
                index.data[y] = counter;
                low.data[y]   = counter;
                counter       = counter + 1;
                on.data[y]    = 1;
                keep(?failed, push(?stack, y));
                keep(?failed, push(?calls, y));
                if (sel failed.err) { ret failed; }
            }
            or (on.data[y] != 0 && index.data[y] < low.data[x]) { low.data[x] = index.data[y]; }
            cnt;
        }
        calls.len = calls.len - 1;
        if (calls.len > 0) {
            val p: u32 = calls.data[calls.len - 1];
            if (low.data[x] < low.data[p]) { low.data[p] = low.data[x]; }
        }
        if (low.data[x] == index.data[x]) {
            var size: usize = 0;
            for (stack.data[stack.len - 1 - size] != x) { size = size + 1; }
            size = size + 1;
            if (size >= 2) {
                # the set's blocks stay marked on for the walk of its entries
                var j: usize = 0;
                for (j < stack.len) {
                    on.data[stack.data[j]] = 0;
                    j                      = j + 1;
                }
                j = stack.len - size;
                for (j < stack.len) {
                    on.data[stack.data[j]] = 1;
                    j                      = j + 1;
                }
                reset(k.w);
                val walked: err[allocator.Error] = entered(k, ?on);
                if (sel walked.err) { ret walked; }
                ret found(k, Flaw.tangle{});
            }
            stack.len  = stack.len - 1;
            on.data[x] = 0;
        }
    }
    ret failed;
}

# whether s heads an arm of the selection at x: a block of its region that
# x alone enters, besides the back edges of a loop s heads
fun heads(k: *Walk, x: u32, s: u32, rid: u32) bool {
    if (s == x || k.owner.data[s] != rid) { ret false; }
    val up: opt[u32] = dominance.idom(k.d, s);
    if (sel up.none)  { ret false; }
    if (up.some != x) { ret false; }
    val preds: Slice[u32] = graph.predecessors(k.g, s);
    var i:     usize      = 0;
    for (i < preds.size) {
        val p: u32 = preds.data[i];
        if (p != x && dominance.reachable(k.d, p) && !dominance.dominates(k.d, s, p)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# give every block of region from that root dominates the region to, and
# list it in members
fun claim(k: *Walk, root: u32, from: u32, to: u32, members: *vector.Vector[u32]) err[allocator.Error] {
    k.stack.len = 0;
    val first: err[allocator.Error] = push(?k.stack, root);
    if (sel first.err) { ret first; }
    for (k.stack.len > 0) {
        val n: u32 = k.stack.data[k.stack.len - 1];
        k.stack.len = k.stack.len - 1;
        if (k.owner.data[n] != from) { cnt; }
        k.owner.data[n] = to;
        val listed: err[allocator.Error] = push(members, n);
        if (sel listed.err) { ret listed; }
        val below: Slice[u32] = dominance.children(k.d, n);
        var i:     usize      = 0;
        for (i < below.size) {
            val pushed: err[allocator.Error] = push(?k.stack, below.data[i]);
            if (sel pushed.err) { ret pushed; }
            i = i + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

fun block(k: *Walk, x: u32, rid: u32, c: Context) res[Step, allocator.Error] {
    val item: res[u32, allocator.Error] = region.add(k.s, Kind.block{}, x);
    if (sel item.err) { ret res[Step, allocator.Error].err{item.err}; }
    val succs: Slice[u32] = graph.successors(k.g, x);
    if (succs.size == 0) { ret res[Step, allocator.Error].ok{Step{item: item.ok, next: NONE}}; }
    val y: u32 = succs.data[0];
    if (y == c.merge || y == c.brk || y == c.cont) { ret res[Step, allocator.Error].ok{Step{item: item.ok, next: NONE}}; }
    if (k.owner.data[y] == rid)                    { ret res[Step, allocator.Error].ok{Step{item: item.ok, next: y}}; }
    found(k, Flaw.stray{x});
    ret res[Step, allocator.Error].ok{Step{item: item.ok, next: NONE}};
}

# sort one edge out of a selection's header or arm: kept inside an arm, a
# break or a continue, or an edge to a block the arms reconverge on
fun sort(k: *Walk, u: u32, e: u32, y: u32, x: u32, rid: u32, base: u32, arms: u32, c: Context) err[allocator.Error] {
    val at: u32 = k.owner.data[u];
    val to: u32 = k.owner.data[y];
    if (to >= base && to < base + arms) {
        if (u == x || to == at) { ret err[allocator.Error].ok{}; }
        ret found(k, Flaw.stray{u});
    }
    if (y == c.brk || y == c.cont) { ret err[allocator.Error].ok{}; }
    if (to == rid || y == c.merge) { ret moves(k.w, u, e, y); }
    ret found(k, Flaw.stray{u});
}

fun selection(k: *Walk, x: u32, rid: u32, c: Context) res[Step, allocator.Error] {
    val succs: Slice[u32] = graph.successors(k.g, x);
    val arms:  u32        = succs.size::u32;
    val base:  u32        = k.ids;
    k.ids = k.ids + arms;
    var members: vector.Vector[u32] = vector.init[u32](k.a);
    var head:    vector.Vector[u32] = vector.init[u32](k.a);
    fin {
        vector.dnit[u32](?members);
        vector.dnit[u32](?head);
    }
    var failed: err[allocator.Error] = push(?members, x);
    var i:      u32                  = 0;
    for (i < arms) {
        val s: u32 = succs.data[i];
        if (heads(k, x, s, rid)) {
            keep(?failed, push(?head, 1));
            keep(?failed, claim(k, s, rid, base + i, ?members));
        }
        or { keep(?failed, push(?head, 0)); }
        i = i + 1;
    }
    if (sel failed.err) { ret res[Step, allocator.Error].err{failed.err}; }

    reset(k.w);
    var m: usize = 0;
    for (m < members.len) {
        val u:  u32        = members.data[m];
        val us: Slice[u32] = graph.successors(k.g, u);
        var e:  usize      = 0;
        for (e < us.size) {
            keep(?failed, sort(k, u, e::u32, us.data[e], x, rid, base, arms, c));
            if (sel failed.err) { ret res[Step, allocator.Error].err{failed.err}; }
            if (stopped(k))     { ret res[Step, allocator.Error].ok{Step{item: NONE, next: NONE}}; }
            e = e + 1;
        }
        keep(?failed, push(?k.w.blocks, u));
        m = m + 1;
    }
    if (sel failed.err) { ret res[Step, allocator.Error].err{failed.err}; }
    val joins: usize = k.w.targets.len;
    if (joins >= 2 || (joins == 1 && k.w.targets.data[0] == c.merge)) {
        found(k, Flaw.merge{x});
        ret res[Step, allocator.Error].ok{Step{item: NONE, next: NONE}};
    }
    var merge: u32 = NONE;
    if (joins == 1) { merge = k.w.targets.data[0]; }

    val made: res[u32, allocator.Error] = region.add(k.s, Kind.selection{}, x);
    if (sel made.err) { ret res[Step, allocator.Error].err{made.err}; }
    val item: u32 = made.ok;
    k.s.regions.data[item].merge = merge;
    var last: u32 = NONE;
    i = 0;
    for (i < arms) {
        var arm: res[u32, allocator.Error];
        if (head.data[i] != 0) { arm = sequence(k, succs.data[i], base + i, Context{merge: merge, brk: c.brk, cont: c.cont}, NONE); }
        or                     { arm = region.add(k.s, Kind.sequence{}, NONE); }
        if (sel arm.err)       { ret res[Step, allocator.Error].err{arm.err}; }
        if (stopped(k))        { ret res[Step, allocator.Error].ok{Step{item: item, next: NONE}}; }
        region.append(k.s, item, last, arm.ok);
        last = arm.ok;
        i    = i + 1;
    }
    ret res[Step, allocator.Error].ok{Step{item: item, next: merge}};
}

fun round(k: *Walk, x: u32, i: u32, rid: u32, c: Context) res[Step, allocator.Error] {
    val none:    Step        = Step{item: NONE, next: NONE};
    val latches: Slice[u32]  = loops.latches(k.l, i);
    val nodes:   Slice[u32]  = loops.body(k.l, i);
    val exits:   Slice[Edge] = loops.exits(k.l, i);
    reset(k.w);
    if (latches.size != 1) {
        var j: usize = 0;
        for (j < latches.size) {
            val p:     u32                  = latches.data[j];
            val moved: err[allocator.Error] = moves(k.w, p, position(k.g, p, x), x);
            if (sel moved.err) { ret res[Step, allocator.Error].err{moved.err}; }
            j = j + 1;
        }
        found(k, Flaw.latches{x});
        ret res[Step, allocator.Error].ok{none};
    }
    var j: usize = 0;
    for (j < exits.size) {
        val e:     Edge                 = exits.data[j];
        val moved: err[allocator.Error] = moves(k.w, e.from, position(k.g, e.from, e.to), e.to);
        if (sel moved.err) { ret res[Step, allocator.Error].err{moved.err}; }
        j = j + 1;
    }
    val leaves: usize = k.w.targets.len;
    if (leaves >= 2 || (leaves == 1 && k.owner.data[k.w.targets.data[0]] != rid)) {
        j = 0;
        for (j < nodes.size) {
            val kept: err[allocator.Error] = push(?k.w.blocks, nodes.data[j]);
            if (sel kept.err) { ret res[Step, allocator.Error].err{kept.err}; }
            j = j + 1;
        }
        found(k, Flaw.exits{x});
        ret res[Step, allocator.Error].ok{none};
    }
    var merge: u32 = NONE;
    if (leaves == 1) { merge = k.w.targets.data[0]; }
    val latch: u32 = latches.data[0];

    val body: u32 = k.ids;
    val cont: u32 = k.ids + 1;
    k.ids = k.ids + 2;
    j     = 0;
    for (j < nodes.size) {
        val n: u32 = nodes.data[j];
        if (k.owner.data[n] != rid) {
            found(k, Flaw.stray{x});
            ret res[Step, allocator.Error].ok{none};
        }
        if (latch != x && dominance.dominates(k.d, latch, n)) { k.owner.data[n] = cont; }
        or                                                    { k.owner.data[n] = body; }
        j = j + 1;
    }

    val made: res[u32, allocator.Error] = region.add(k.s, Kind.loop{}, x);
    if (sel made.err) { ret res[Step, allocator.Error].err{made.err}; }
    val item: u32 = made.ok;
    k.s.regions.data[item].merge = merge;
    k.s.regions.data[item].latch = latch;
    val inner: res[u32, allocator.Error] = sequence(k, x, body, Context{merge: NONE, brk: merge, cont: latch}, x);
    if (sel inner.err) { ret res[Step, allocator.Error].err{inner.err}; }
    if (stopped(k))    { ret res[Step, allocator.Error].ok{none}; }
    region.append(k.s, item, NONE, inner.ok);
    if (latch != x) {
        val back: res[u32, allocator.Error] = sequence(k, latch, cont, Context{merge: NONE, brk: merge, cont: x}, NONE);
        if (sel back.err) { ret res[Step, allocator.Error].err{back.err}; }
        if (stopped(k))   { ret res[Step, allocator.Error].ok{none}; }
        region.append(k.s, item, inner.ok, back.ok);
    }
    ret res[Step, allocator.Error].ok{Step{item: item, next: merge}};
}

# the loop a block heads, NONE when it heads none
fun header(k: *Walk, x: u32) u32 {
    val i: opt[u32] = loops.innermost(k.l, x);
    if (sel i.none)                          { ret NONE; }
    if (loops.loop(k.l, i.some).header != x) { ret NONE; }
    ret i.some;
}

# the sequence of a region from its entry, the loop whose body it is not
# taken for that loop again
fun sequence(k: *Walk, first: u32, rid: u32, c: Context, body: u32) res[u32, allocator.Error] {
    val made: res[u32, allocator.Error] = region.add(k.s, Kind.sequence{}, NONE);
    if (sel made.err) { ret made; }
    val seq:  u32 = made.ok;
    var last: u32 = NONE;
    var x:    u32 = first;
    var skip: u32 = body;
    for (x != NONE) {
        var step: res[Step, allocator.Error];
        val i:    u32 = header(k, x);
        if (i != NONE && x != skip)             { step = round(k, x, i, rid, c); }
        or (graph.successors(k.g, x).size >= 2) { step = selection(k, x, rid, c); }
        or                                      { step = block(k, x, rid, c); }
        skip = NONE;
        if (sel step.err) { ret res[u32, allocator.Error].err{step.err}; }
        if (stopped(k))   { ret made; }
        region.append(k.s, seq, last, step.ok.item);
        last = step.ok.item;
        x    = step.ok.next;
    }
    ret made;
}

# the structure of a graph, or the first flaw that keeps it from having one
# ---
# a:   the allocator the walk's storage takes
# g:   the graph
# d:   its dominance
# l:   its loops
# w:   the work a flaw is mended by, filled when one is found
# s:   an empty structure, filled with the regions when none is
# ret: none when the graph is structured, the flaw, or the allocator's refusal
pub fun find(a: *allocator.Allocator, g: *Graph, d: *Dominance, l: *Loops, w: *Work, s: *Structure) res[opt[Flaw], allocator.Error] {
    reset(w);
    var k: Walk = Walk{a: a, g: g, d: d, l: l, s: s, w: w, owner: vector.init[u32](a), stack: vector.init[u32](a), ids: 1, flaw: opt[Flaw].none{}};
    fin {
        vector.dnit[u32](?k.owner);
        vector.dnit[u32](?k.stack);
    }
    val owned: err[allocator.Error] = fill(?k.owner, g.count, NONE);
    if (sel owned.err) { ret res[opt[Flaw], allocator.Error].err{owned.err}; }
    val order: Slice[u32] = dominance.order(d);
    var i:     usize      = 0;
    for (i < order.size) {
        k.owner.data[order.data[i]] = 0;
        i                           = i + 1;
    }
    if (g.count == 0) {
        val root: res[u32, allocator.Error] = region.add(s, Kind.sequence{}, NONE);
        if (sel root.err) { ret res[opt[Flaw], allocator.Error].err{root.err}; }
        ret res[opt[Flaw], allocator.Error].ok{opt[Flaw].none{}};
    }
    twins(?k);
    if (stopped(?k)) { ret res[opt[Flaw], allocator.Error].ok{k.flaw}; }
    val tangled: err[allocator.Error] = tangles(?k);
    if (sel tangled.err) { ret res[opt[Flaw], allocator.Error].err{tangled.err}; }
    if (stopped(?k))     { ret res[opt[Flaw], allocator.Error].ok{k.flaw}; }
    val top: Context                   = Context{merge: NONE, brk: NONE, cont: NONE};
    val r:   res[u32, allocator.Error] = sequence(?k, g.entry, 0, top, NONE);
    if (sel r.err) { ret res[opt[Flaw], allocator.Error].err{r.err}; }
    ret res[opt[Flaw], allocator.Error].ok{k.flaw};
}
