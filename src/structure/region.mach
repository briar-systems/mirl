# the structure of a function: a tree of regions over its blocks
#
# a region is a block, a sequence of regions run one after another, a
# selection or a loop. a selection is its header block, whose terminator picks
# one arm per target in edge order, so a branch of any number of targets has
# its arms, and then its merge. a loop is its header, a body that starts at
# the header, a continue sequence that starts at its latch, and then its
# merge. an arm or a body ends by reaching its construct's merge, by a break
# to the innermost loop's merge, by a continue to its latch, or by leaving the
# function, and never by reaching a block of any other construct. every block
# is the merge of at most one construct, and no merge is a latch.
#
# the tree is first child, next sibling: region 0 is the function's sequence.
# blocks the entry does not reach are in no region.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.cfg.graph.NONE;

# what a region is
# ---
# block:     one block that is no construct's header
# sequence:  its children, run in order
# selection: its header, then one arm per target of the header's terminator,
#            in edge order, each a sequence that is empty when the edge goes
#            straight to the merge, a break or a continue
# loop:      its header, then its body, a sequence that starts with the
#            header, and its continue sequence, which starts at its latch and
#            is absent when the header is its own latch
pub tag Kind: u8 {
    block;
    sequence;
    selection;
    loop;
}

# one region
# ---
# kind:  what it is
# block: a block's block, a selection's or a loop's header, NONE for a
#        sequence
# merge: where a selection or a loop goes on, NONE when control never does
# latch: a loop's continue target, the one block that branches back to its
#        header, NONE for any other region
# child: its first child, NONE when it has none
# next:  the region after it among its parent's children, NONE for the last
pub rec Region {
    kind:  Kind;
    block: u32;
    merge: u32;
    latch: u32;
    child: u32;
    next:  u32;
}

# the regions of one function
# ---
# regions: every region, the function's sequence first
pub rec Structure {
    regions: vector.Vector[Region];
}

# an empty structure
pub fun init(a: *allocator.Allocator) Structure {
    ret Structure{regions: vector.init[Region](a)};
}

# give back a structure's storage
pub fun dnit(s: *Structure) err[allocator.Error] {
    ret vector.dnit[Region](?s.regions);
}

# add a region of a kind with no children, giving its index
pub fun add(s: *Structure, kind: Kind, block: u32) res[u32, allocator.Error] {
    val at:     u32                         = s.regions.len::u32;
    val pushed: res[usize, allocator.Error] = vector.push[Region](?s.regions, Region{kind: kind, block: block, merge: NONE, latch: NONE, child: NONE, next: NONE});
    if (sel pushed.err) { ret res[u32, allocator.Error].err{pushed.err}; }
    ret res[u32, allocator.Error].ok{at};
}

# put a region after the last child of a parent, given that last child
pub fun append(s: *Structure, parent: u32, last: u32, r: u32) {
    if (last == NONE) { s.regions.data[parent].child = r; }
    or                { s.regions.data[last].next = r; }
}

# the number of regions
pub fun count(s: *Structure) u32 {
    ret s.regions.len::u32;
}

# a region
pub fun region(s: *Structure, r: u32) Region {
    ret s.regions.data[r];
}

# the function's sequence
pub fun root(s: *Structure) u32 {
    ret 0;
}
