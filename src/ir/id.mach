# the ids that name the entities of a module and the bodies of its functions
#
# a function, global or constant id indexes its module, and a block, value or
# instruction id indexes the body of the function that made it.

# a function, as an id into its module
# ---
# index: the function's position in its module
pub rec Function {
    index: u32;
}

# a global, as an id into its module
# ---
# index: the global's position in its module
pub rec Global {
    index: u32;
}

# a constant, as an id into its module
# ---
# index: the constant's position in its module
pub rec Constant {
    index: u32;
}

# a block, as an id into its function's body
# ---
# index: the block's position in its body
pub rec Block {
    index: u32;
}

# a value, as an id into its function's body
# ---
# index: the value's position in its body
pub rec Value {
    index: u32;
}

# an instruction, as an id into its function's body
# ---
# index: the instruction's position in its body
pub rec Instruction {
    index: u32;
}

# a function or global, what has an address, a name and attributes
pub tag Symbol: u8 {
    function: Function;
    global:   Global;
}
