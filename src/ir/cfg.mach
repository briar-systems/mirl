# control flow surgery, body copies, and the dominance and loop analyses
#
# the analyses read only the graph view, so any form of code that gives its
# blocks as a graph reuses them. the body's graph comes from `graph_of`.

use mirl.ir.cfg.block;
use mirl.ir.cfg.copy;
use mirl.ir.cfg.edge;
use mirl.ir.cfg.failure;
use mirl.ir.cfg.view;

fwd failure.Error;

fwd split_edge:   edge.split;
fwd redirect:     edge.redirect;
fwd gather_edges: edge.gather;
fwd EdgeSource:   edge.Source;
fwd split_block:  block.split;
fwd merge_block:  block.merge;
fwd copy_region:  copy.region;
fwd copy_body:    copy.whole;
fwd graph_of:     view.of;

fwd mirl.ir.cfg.graph;
fwd mirl.ir.cfg.dominance;
fwd mirl.ir.cfg.loops;
fwd mirl.ir.cfg.flow;
