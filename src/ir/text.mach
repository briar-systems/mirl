# the text form of the ir: the printer, the parser and structural equality
#
# doc/ir/text.md specifies the text form and is the one statement of its
# grammar.

use mirl.ir.text.equal;
use mirl.ir.text.item;
use mirl.ir.text.notes;
use reader: mirl.ir.text.parse;
use mirl.ir.text.printer;
use mirl.ir.text.sink;

fwd printer.VERSION;
fwd printer.Error;
fwd printer.target_line;

fwd item.print;
fwd item.print_noted;

fwd notes.Notes;

fwd equal.same;

fwd reader.parse;
fwd reader.parse_noted;
fwd reader.Named;
fwd reader.Reason;
fwd reader.Refusal;
fwd reader.describe;

fwd sink.Sink;
fwd sink.init;
fwd sink.dnit;
fwd sink.writer;
fwd sink.view;
