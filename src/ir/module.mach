# modules: the functions, globals, constants and types one unit of code holds
#
# a module names the target it was built for by the parts of its tuple, each
# as its owner spells it, and holds no layout of its own. the target's data
# layout answers every size, alignment and offset.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;

use mirl.fail.keep;
use std.allocator.page;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.symbol;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.block.BlockData;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.debug;
use mirl.ir.debug.Binding;
use mirl.ir.function;
use mirl.ir.function.FunctionData;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction;
use mirl.ir.instruction.InstructionData;
use mirl.ir.linkage;
use mirl.ir.linkage.Linkage;
use mirl.ir.metadata.Bindings;
use mirl.ir.metadata.UNBOUND;
use mirl.ir.opcode;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Expression;
use mirl.ir.point.Point;
use mirl.ir.point.Step;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.ValueData;
use mirl.slice;

# why a module refused a request
# ---
# alloc:       the allocator refused storage
# types:       the type table refused a read
# typing:      the instruction's opcode row refused it
# name:        an empty name
# taken:       a symbol name this function or global already has
# function:    a function this module did not give out
# global:      a global this module did not give out
# constant:    a constant this module did not give out
# bindings:    a binding list this module did not give out
# expression:  a salvage expression this module did not give out
# step:        a salvage step of a kind with no row, or an argument that is not
#              what its row takes
# binding:     a binding the debug table did not give out
# point:       a record position the block does not have
# bound:       a value a record outside what is taken back reads
# block:       a block the function's body did not give out
# value:       a value the function's body did not give out
# instruction: an instruction the function's body did not give out
# linkage:     a linkage that is not a row of mink's symbol bindings
# visibility:  a visibility that is not a row of mink's symbol visibilities
# section:     a section kind that is not a row of mink's section kinds
# mismatch:    a type that is not the type or kind the request needs
# alignment:   an alignment that is not a power of two
# words:       a number whose words do not fit its type's width
# elements:    an aggregate of this many elements, not what its type holds
# element:     the aggregate element at this position is not of its member's type
# incoming:    this many incoming arguments, not one per edge into the block
# parameter:   a parameter position the block does not have
# used:        a value that still has uses
# secret:      a secret value asked to stand where only a public one may
# placed:      an instruction already placed in a block
# detached:    an instruction placed in no block
# erased:      an instruction taken out of its body
# results:     an instruction of this many results, not as many as the one it
#              replaces
# circular:    a replacement that uses this result of the instruction it replaces
# edge:        an edge position the instruction does not have
# position:    an instruction position the block does not have
# arguments:   this many arguments, not one per parameter of the target
# removed:     a block taken out of its body
# entry:       the entry block, which stays in its body
# reached:     a block that an edge still enters
# occupied:    a block that still holds instructions
# lowered:     an edit that would lower an instruction's secrecy mark
# unkept:      an edit that would take an instruction's kept mark off it
# same:        a block asked to take instructions from itself
# terminator:  an edit that would move an instruction that ends its block
pub tag Error: u8 {
    alloc:  allocator.Error;
    types:  types.Error;
    typing: opcode.Error;
    name;
    taken:       Symbol;
    function:    Function;
    global:      Global;
    constant:    Constant;
    bindings:    Bindings;
    expression:  Expression;
    step:        u32;
    binding:     Binding;
    point:       u32;
    bound:       Value;
    block:       Block;
    value:       Value;
    instruction: Instruction;
    linkage;
    visibility;
    section;
    mismatch:  Type;
    alignment: u64;
    words;
    elements:  u32;
    element:   u32;
    incoming:  u32;
    parameter: u32;
    used:      Value;
    secret:    Value;
    placed:    Instruction;
    detached:  Instruction;
    erased:    Instruction;
    results:   u32;
    circular:  Value;
    edge:      u32;
    position:  u32;
    arguments: u32;
    removed:   Block;
    entry;
    reached:    Block;
    occupied:   Block;
    lowered:    Instruction;
    unkept:     Instruction;
    same:       Block;
    terminator: Instruction;
}

# the target a module is built for, each part of its tuple as its owner
# spells it, an empty part one the target does not carry
# ---
# arch:       its architecture, by the name of its row in mink's catalog
# system:     its system, by the name of its row in mink's catalog
# convention: its calling convention, by the name of mirl's convention row
# baseline:   its baseline extensions, as masc spells the selection
pub rec Tuple {
    arch:       View;
    system:     View;
    convention: View;
    baseline:   View;
}

# the tuple the ir's own tests build their modules for, which they never resolve
#[testing]
pub val TESTING: Tuple = Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}};

# whether two tuples spell the same parts
pub fun same_target(a: Tuple, b: Tuple) bool {
    ret slice.same_view(a.arch, b.arch) && slice.same_view(a.system, b.system) && slice.same_view(a.convention, b.convention) && slice.same_view(a.baseline, b.baseline);
}

fun copy_tuple(a: *allocator.Allocator, t: Tuple) res[Tuple, allocator.Error] {
    var out:  Tuple                      = Tuple{arch: View{data: nil, len: 0}, system: View{data: nil, len: 0}, convention: View{data: nil, len: 0}, baseline: View{data: nil, len: 0}};
    val arch: res[View, allocator.Error] = slice.copy_view(a, t.arch);
    if (sel arch.err) { ret res[Tuple, allocator.Error].err{arch.err}; }
    out.arch = arch.ok;
    val system: res[View, allocator.Error] = slice.copy_view(a, t.system);
    if (sel system.err) {
        release_tuple(a, out);
        ret res[Tuple, allocator.Error].err{system.err};
    }
    out.system = system.ok;
    val convention: res[View, allocator.Error] = slice.copy_view(a, t.convention);
    if (sel convention.err) {
        release_tuple(a, out);
        ret res[Tuple, allocator.Error].err{convention.err};
    }
    out.convention = convention.ok;
    val baseline: res[View, allocator.Error] = slice.copy_view(a, t.baseline);
    if (sel baseline.err) {
        release_tuple(a, out);
        ret res[Tuple, allocator.Error].err{baseline.err};
    }
    out.baseline = baseline.ok;
    ret res[Tuple, allocator.Error].ok{out};
}

fun release_tuple(a: *allocator.Allocator, t: Tuple) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.release_view(a, t.arch);
    keep(?failed, slice.release_view(a, t.system));
    keep(?failed, slice.release_view(a, t.convention));
    keep(?failed, slice.release_view(a, t.baseline));
    ret failed;
}

# one module
# ---
# a:           the allocator everything the module holds is taken from
# target:      the tuple of the target it was built for, resolved by mirl.target
# types:       its type table
# debug:       its debug table
# functions:   its functions, indexed by id
# globals:     its globals, indexed by id
# constants:   its constants, indexed by id
# bindings:    its lists of debug bindings, the empty list first
# expressions: its salvage expressions, the empty one first
# exports:     the symbols it exports, in the order they were exported
# symbols:     each function and global by its name
pub rec Module {
    a:           *allocator.Allocator;
    target:      Tuple;
    types:       types.Table;
    debug:       debug.Table;
    functions:   vector.Vector[function.Node];
    globals:     vector.Vector[global.Node];
    constants:   vector.Vector[ConstantData];
    bindings:    vector.Vector[Slice[Binding]];
    expressions: vector.Vector[Slice[Step]];
    exports:     vector.Vector[Symbol];
    symbols:     map.MapBy[View, Symbol];
}

# create an empty module
# ---
# a:      the allocator the module takes its storage from
# target: the tuple of the target it is built for, which is copied
# ret:    the module, or why it was refused
pub fun init(a: *allocator.Allocator, target: Tuple) res[Module, Error] {
    if (target.arch.len == 0 || target.system.len == 0) { ret res[Module, Error].err{Error.name{}}; }
    var m: Module;
    m.a = a;
    val name: res[Tuple, allocator.Error] = copy_tuple(a, target);
    if (sel name.err) { ret res[Module, Error].err{Error.alloc{name.err}}; }
    m.target      = name.ok;
    m.types       = types.init(a);
    m.debug       = debug.init(a);
    m.functions   = vector.init[function.Node](a);
    m.globals     = vector.init[global.Node](a);
    m.constants   = vector.init[ConstantData](a);
    m.bindings    = vector.init[Slice[Binding]](a);
    m.expressions = vector.init[Slice[Step]](a);
    m.exports     = vector.init[Symbol](a);
    m.symbols     = map.init_by[View, Symbol](a, hash_name, same_name);
    val empty: res[usize, allocator.Error] = vector.push[Slice[Binding]](?m.bindings, Slice[Binding]{data: nil, size: 0});
    if (sel empty.err) {
        release_tuple(a, m.target);
        debug.dnit(?m.debug);
        ret res[Module, Error].err{Error.alloc{empty.err}};
    }
    val plain: res[usize, allocator.Error] = vector.push[Slice[Step]](?m.expressions, Slice[Step]{data: nil, size: 0});
    if (sel plain.err) {
        vector.dnit[Slice[Binding]](?m.bindings);
        release_tuple(a, m.target);
        debug.dnit(?m.debug);
        ret res[Module, Error].err{Error.alloc{plain.err}};
    }
    ret res[Module, Error].ok{m};
}

# give back the attributes of a list past its first count, keeping the rest
# ---
# a:     the allocator of the list's module
# list:  the attributes of a function or global
# count: how many to keep
# ret:   ok, or the allocator's refusal of the first release that failed
pub fun trim_attributes(a: *allocator.Allocator, list: *vector.Vector[Attribute], count: usize) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    for (list.len > count) {
        val at: Attribute = list.data[list.len - 1];
        keep(?failed, slice.release_view(a, at.family));
        keep(?failed, slice.release_view(a, at.name));
        if (sel at.datum.integers) { keep(?failed, slice.release[u64](a, at.datum.integers)); }
        if (sel at.datum.text)     { keep(?failed, slice.release_view(a, at.datum.text)); }
        list.len = list.len - 1;
    }
    ret failed;
}

# give back a function or global's attributes and their list
pub fun release_attributes(a: *allocator.Allocator, list: *vector.Vector[Attribute]) err[allocator.Error] {
    var failed: err[allocator.Error] = trim_attributes(a, list, 0);
    keep(?failed, vector.dnit[Attribute](list));
    ret failed;
}

# give back what a constant owns
pub fun release_constant(a: *allocator.Allocator, c: ConstantData) err[allocator.Error] {
    if (sel c.integer)   { ret slice.release[u64](a, c.integer.words); }
    if (sel c.float)     { ret slice.release[u64](a, c.float.words); }
    if (sel c.aggregate) { ret slice.release[Constant](a, c.aggregate.elements); }
    ret err[allocator.Error].ok{};
}

# give back everything a function body owns
# ---
# a:   the allocator of the body's module
# b:   the body
# ret: ok, or the allocator's refusal of the first release that failed
pub fun release_body(a: *allocator.Allocator, b: *function.Body) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < b.blocks.len) {
        val k: *BlockData = ?b.blocks.data[i];
        keep(?failed, vector.dnit[Value](?k.parameters));
        keep(?failed, vector.dnit[Instruction](?k.instructions));
        keep(?failed, vector.dnit[Instruction](?k.predecessors));
        if (sel k.name.some) { keep(?failed, slice.release_view(a, k.name.some)); }
        i = i + 1;
    }
    i = 0;
    for (i < b.values.len) {
        keep(?failed, vector.dnit[Instruction](?b.values.data[i].uses));
        keep(?failed, vector.dnit[u32](?b.values.data[i].bound));
        val name: opt[View] = b.values.data[i].name;
        if (sel name.some) { keep(?failed, slice.release_view(a, name.some)); }
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        keep(?failed, instruction.release(?b.instructions.data[i]));
        i = i + 1;
    }
    keep(?failed, vector.dnit[BlockData](?b.blocks));
    keep(?failed, vector.dnit[ValueData](?b.values));
    keep(?failed, vector.dnit[InstructionData](?b.instructions));
    keep(?failed, map.dnit[u32, Value](?b.constants));
    keep(?failed, vector.dnit[Point](?b.points));
    if (sel b.entry.placed) { keep(?failed, vector.dnit[Placed](?b.entry.placed)); }
    b.entry = function.Entry.unplaced{};
    ret failed;
}

# give back what a function owns: its name, attributes and body
pub fun release_function(a: *allocator.Allocator, n: *function.Node) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.release_view(a, n.data.name);
    keep(?failed, release_attributes(a, ?n.attributes));
    keep(?failed, release_body(a, ?n.body));
    ret failed;
}

# give back what a global owns: its name, section and attributes
pub fun release_global(a: *allocator.Allocator, g: *global.Node) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.release_view(a, g.data.name);
    if (sel g.data.section.some) { keep(?failed, slice.release_view(a, g.data.section.some.name)); }
    keep(?failed, release_attributes(a, ?g.attributes));
    ret failed;
}

# release everything the module holds
# ---
# m:   the module
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(m: *Module) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < m.functions.len) {
        keep(?failed, release_function(m.a, ?m.functions.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        keep(?failed, release_global(m.a, ?m.globals.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.constants.len) {
        keep(?failed, release_constant(m.a, m.constants.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.bindings.len) {
        keep(?failed, slice.release[Binding](m.a, m.bindings.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.expressions.len) {
        keep(?failed, slice.release[Step](m.a, m.expressions.data[i]));
        i = i + 1;
    }
    keep(?failed, vector.dnit[function.Node](?m.functions));
    keep(?failed, vector.dnit[global.Node](?m.globals));
    keep(?failed, vector.dnit[ConstantData](?m.constants));
    keep(?failed, vector.dnit[Slice[Binding]](?m.bindings));
    keep(?failed, vector.dnit[Slice[Step]](?m.expressions));
    keep(?failed, vector.dnit[Symbol](?m.exports));
    keep(?failed, map.dnit_by[View, Symbol](?m.symbols));
    keep(?failed, debug.dnit(?m.debug));
    keep(?failed, types.dnit(?m.types));
    keep(?failed, release_tuple(m.a, m.target));
    ret failed;
}

# the tuple of the target the module was built for, valid for its life
pub fun target(m: *Module) Tuple {
    ret m.target;
}

fun hash_name(v: *View) u64 {
    ret slice.hash_view(0xcbf29ce484222325, @v);
}

fun same_name(a: *View, b: *View) bool {
    ret slice.same_view(@a, @b);
}

# the function or global a symbol name names, or none
pub fun find(m: *Module, name: View) opt[Symbol] {
    val found: opt[*Symbol] = map.get_by[View, Symbol](?m.symbols, ?name);
    if (sel found.none) { ret opt[Symbol].none{}; }
    ret opt[Symbol].some{@found.some};
}

# refuse a name some function or global already has
fun free(m: *Module, name: View) err[Error] {
    val found: opt[Symbol] = find(m, name);
    if (sel found.some) { ret err[Error].err{Error.taken{found.some}}; }
    ret err[Error].ok{};
}

# index a symbol by its name, which the module owns
fun index(m: *Module, name: View, s: Symbol) err[allocator.Error] {
    val r: res[bool, allocator.Error] = map.insert_by[View, Symbol](?m.symbols, name, s);
    if (sel r.err) { ret err[allocator.Error].err{r.err}; }
    ret err[allocator.Error].ok{};
}

fun shape(m: *Module, ty: Type) res[types.Shape, Error] {
    val s: res[types.Shape, types.Error] = types.shape(?m.types, ty);
    if (sel s.err) { ret res[types.Shape, Error].err{Error.types{s.err}}; }
    ret res[types.Shape, Error].ok{s.ok};
}

fun power_of_two(a: u64) bool {
    ret a != 0 && (a & (a - 1)) == 0;
}

# declare a function, with an empty body
# ---
# m:    the module
# data: what it is declared as, whose name is copied
# ret:  its id, or why it was refused
pub fun add_function(m: *Module, data: FunctionData) res[Function, Error] {
    if (data.name.len == 0) { ret res[Function, Error].err{Error.name{}}; }
    val unused: err[Error] = free(m, data.name);
    if (sel unused.err) { ret res[Function, Error].err{unused.err}; }
    val rows: err[Error] = stated(data.linkage);
    if (sel rows.err) { ret res[Function, Error].err{rows.err}; }
    val s: res[types.Shape, Error] = shape(m, data.signature);
    if (sel s.err)            { ret res[Function, Error].err{s.err}; }
    if (!(sel s.ok.function)) { ret res[Function, Error].err{Error.mismatch{data.signature}}; }
    val name: res[View, allocator.Error] = slice.copy_view(m.a, data.name);
    if (sel name.err) { ret res[Function, Error].err{Error.alloc{name.err}}; }

    var n: function.Node;
    n.data              = data;
    n.data.name         = name.ok;
    n.attributes        = vector.init[Attribute](m.a);
    n.body.blocks       = vector.init[BlockData](m.a);
    n.body.values       = vector.init[ValueData](m.a);
    n.body.instructions = vector.init[InstructionData](m.a);
    n.body.constants    = map.init[u32, Value](m.a);
    n.body.points       = vector.init[Point](m.a);
    val id:     Function                    = Function{index: m.functions.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[function.Node](?m.functions, n);
    if (sel pushed.err) {
        slice.release_view(m.a, name.ok);
        ret res[Function, Error].err{Error.alloc{pushed.err}};
    }
    val indexed: err[allocator.Error] = index(m, name.ok, Symbol.function{id});
    if (sel indexed.err) {
        vector.pop[function.Node](?m.functions);
        slice.release_view(m.a, name.ok);
        ret res[Function, Error].err{Error.alloc{indexed.err}};
    }
    ret res[Function, Error].ok{id};
}

# what a function is declared as, its name valid for the life of the module
pub fun function_data(m: *Module, f: Function) res[FunctionData, Error] {
    if (f.index::usize >= m.functions.len) { ret res[FunctionData, Error].err{Error.function{f}}; }
    ret res[FunctionData, Error].ok{m.functions.data[f.index].data};
}

# the body of a function, for the body's edits
pub fun body(m: *Module, f: Function) res[*function.Body, Error] {
    if (f.index::usize >= m.functions.len) { ret res[*function.Body, Error].err{Error.function{f}}; }
    ret res[*function.Body, Error].ok{?m.functions.data[f.index].body};
}

# the type of a constant
pub fun constant_type(m: *Module, c: Constant) res[Type, Error] {
    if (c.index::usize >= m.constants.len) { ret res[Type, Error].err{Error.constant{c}}; }
    val d: ConstantData = m.constants.data[c.index];
    if (sel d.integer)   { ret res[Type, Error].ok{d.integer.type}; }
    or (sel d.float)     { ret res[Type, Error].ok{d.float.type}; }
    or (sel d.zero)      { ret res[Type, Error].ok{d.zero}; }
    or (sel d.aggregate) { ret res[Type, Error].ok{d.aggregate.type}; }
    ret res[Type, Error].ok{d.address.type};
}

# what a constant holds in memory, as its placement reads it
# ---
# zeros:     every bit zero
# bytes:     bits not all zero, and no address
# addresses: an address of a symbol, which a relocation fills
pub tag Contents: u8 {
    zeros;
    bytes;
    addresses;
}

fun any_word(b: Bits) bool {
    var i: usize = 0;
    for (i < b.words.size) {
        if (b.words.data[i] != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what a constant holds in memory, its elements' at any depth
pub fun contents(m: *Module, c: Constant) res[Contents, Error] {
    if (c.index::usize >= m.constants.len) { ret res[Contents, Error].err{Error.constant{c}}; }
    val d: ConstantData = m.constants.data[c.index];
    if (sel d.address) { ret res[Contents, Error].ok{Contents.addresses{}}; }
    if (sel d.zero)    { ret res[Contents, Error].ok{Contents.zeros{}}; }
    if (sel d.integer) {
        if (any_word(d.integer)) { ret res[Contents, Error].ok{Contents.bytes{}}; }
        ret res[Contents, Error].ok{Contents.zeros{}};
    }
    if (sel d.float) {
        if (any_word(d.float)) { ret res[Contents, Error].ok{Contents.bytes{}}; }
        ret res[Contents, Error].ok{Contents.zeros{}};
    }
    var held: Contents = Contents.zeros{};
    if (sel d.aggregate) {
        val list: Slice[Constant] = d.aggregate.elements;
        var i:    usize           = 0;
        for (i < list.size) {
            val e: res[Contents, Error] = contents(m, list.data[i]);
            if (sel e.err)          { ret e; }
            if (sel e.ok.addresses) { ret e; }
            if (sel e.ok.bytes)     { held = e.ok; }
            i = i + 1;
        }
    }
    ret res[Contents, Error].ok{held};
}

# what a constant is, its lists valid for the life of the module
pub fun constant_data(m: *Module, c: Constant) res[ConstantData, Error] {
    if (c.index::usize >= m.constants.len) { ret res[ConstantData, Error].err{Error.constant{c}}; }
    ret res[ConstantData, Error].ok{m.constants.data[c.index]};
}

fun known(m: *Module, s: Symbol) err[Error] {
    if (sel s.function) {
        if (s.function.index::usize >= m.functions.len) { ret err[Error].err{Error.function{s.function}}; }
        ret err[Error].ok{};
    }
    if (s.global.index::usize >= m.globals.len) { ret err[Error].err{Error.global{s.global}}; }
    ret err[Error].ok{};
}

fun fits(b: Bits, width: u32) err[Error] {
    val words: usize = ((width + 63) / 64)::usize;
    if (b.words.size != words) { ret err[Error].err{Error.words{}}; }
    val spare: u32 = width % 64;
    if (spare != 0 && (b.words.data[words - 1] >> spare::u64) != 0) { ret err[Error].err{Error.words{}}; }
    ret err[Error].ok{};
}

fun element_type(s: types.Shape, i: usize) Type {
    if (sel s.structure) { ret s.structure.members.data[i]; }
    or (sel s.array)     { ret s.array.element; }
    or (sel s.vector)    { ret s.vector.element; }
    ret Type{index: 0xffffffff};
}

# whether a constant is well formed in a module: its words fit its type, an
# aggregate's elements are constants of its members' types, and an address
# names a function or global of the module
# ---
# m:   the module
# d:   the constant
# ret: ok, or why it is refused
pub fun check_constant(m: *Module, d: *ConstantData) err[Error] {
    if (sel d.integer) {
        val s: res[types.Shape, Error] = shape(m, d.integer.type);
        if (sel s.err)           { ret err[Error].err{s.err}; }
        if (!(sel s.ok.integer)) { ret err[Error].err{Error.mismatch{d.integer.type}}; }
        ret fits(d.integer, s.ok.integer.width);
    }
    or (sel d.float) {
        val w: res[u32, Error] = float_width(m, d.float.type);
        if (sel w.err) { ret err[Error].err{w.err}; }
        ret fits(d.float, w.ok);
    }
    or (sel d.zero) {
        val s: res[types.Shape, Error] = shape(m, d.zero);
        if (sel s.err) { ret err[Error].err{s.err}; }
        ret err[Error].ok{};
    }
    or (sel d.aggregate) {
        val a: Aggregate               = d.aggregate;
        val s: res[types.Shape, Error] = shape(m, a.type);
        if (sel s.err) { ret err[Error].err{s.err}; }
        var count: u64 = 0;
        if (sel s.ok.structure)            { count = s.ok.structure.members.size::u64; }
        or (sel s.ok.array)                { count = s.ok.array.count; }
        or (sel s.ok.vector)               { count = s.ok.vector.lanes::u64; }
        or                                 { ret err[Error].err{Error.mismatch{a.type}}; }
        if (a.elements.size::u64 != count) { ret err[Error].err{Error.elements{a.elements.size::u32}}; }
        var i: usize = 0;
        for (i < a.elements.size) {
            val et: res[Type, Error] = constant_type(m, a.elements.data[i]);
            if (sel et.err)                                { ret err[Error].err{et.err}; }
            if (!types.same(et.ok, element_type(s.ok, i))) { ret err[Error].err{Error.element{i::u32}}; }
            i = i + 1;
        }
        ret err[Error].ok{};
    }
    val s: res[types.Shape, Error] = shape(m, d.address.type);
    if (sel s.err)           { ret err[Error].err{s.err}; }
    if (!(sel s.ok.pointer)) { ret err[Error].err{Error.mismatch{d.address.type}}; }
    ret known(m, d.address.symbol);
}

fun float_width(m: *Module, ty: Type) res[u32, Error] {
    val f: res[types.Format, types.Error] = types.format(?m.types, ty);
    if (sel f.err) { ret res[u32, Error].err{Error.types{f.err}}; }
    val r: opt[types.Row] = types.row(f.ok);
    if (sel r.none) { ret res[u32, Error].err{Error.mismatch{ty}}; }
    ret res[u32, Error].ok{r.some.width};
}

# add a constant
# ---
# m:    the module
# data: the constant, whose lists are copied
# ret:  its id, or why it was refused
pub fun add_constant(m: *Module, data: ConstantData) res[Constant, Error] {
    val checked: err[Error] = check_constant(m, ?data);
    if (sel checked.err) { ret res[Constant, Error].err{checked.err}; }

    var owned: ConstantData = data;
    if (sel data.integer) {
        val w: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, data.integer.words);
        if (sel w.err) { ret res[Constant, Error].err{Error.alloc{w.err}}; }
        owned = ConstantData.integer{Bits{type: data.integer.type, words: w.ok}};
    }
    or (sel data.float) {
        val w: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, data.float.words);
        if (sel w.err) { ret res[Constant, Error].err{Error.alloc{w.err}}; }
        owned = ConstantData.float{Bits{type: data.float.type, words: w.ok}};
    }
    or (sel data.aggregate) {
        val e: res[Slice[Constant], allocator.Error] = slice.copy[Constant](m.a, data.aggregate.elements);
        if (sel e.err) { ret res[Constant, Error].err{Error.alloc{e.err}}; }
        owned = ConstantData.aggregate{Aggregate{type: data.aggregate.type, elements: e.ok}};
    }

    val id:     Constant                    = Constant{index: m.constants.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[ConstantData](?m.constants, owned);
    if (sel pushed.err) {
        if (sel owned.integer)   { slice.release[u64](m.a, owned.integer.words); }
        if (sel owned.float)     { slice.release[u64](m.a, owned.float.words); }
        if (sel owned.aggregate) { slice.release[Constant](m.a, owned.aggregate.elements); }
        ret res[Constant, Error].err{Error.alloc{pushed.err}};
    }
    ret res[Constant, Error].ok{id};
}

# refuse a linkage that is not made of mink's symbol rows
fun stated(l: Linkage) err[Error] {
    if (!linkage.binding_row(l.binding))       { ret err[Error].err{Error.linkage{}}; }
    if (!linkage.visibility_row(l.visibility)) { ret err[Error].err{Error.visibility{}}; }
    ret err[Error].ok{};
}

# add a global
# ---
# m:    the module
# data: the global, whose name and section are copied
# ret:  its id, or why it was refused
pub fun add_global(m: *Module, data: GlobalData) res[Global, Error] {
    if (data.name.len == 0) { ret res[Global, Error].err{Error.name{}}; }
    val unused: err[Error] = free(m, data.name);
    if (sel unused.err) { ret res[Global, Error].err{unused.err}; }
    val rows: err[Error] = stated(data.linkage);
    if (sel rows.err) { ret res[Global, Error].err{rows.err}; }
    val s: res[types.Shape, Error] = shape(m, data.type);
    if (sel s.err) { ret res[Global, Error].err{s.err}; }
    if (sel data.initial.some) {
        val ct: res[Type, Error] = constant_type(m, data.initial.some);
        if (sel ct.err)                    { ret res[Global, Error].err{ct.err}; }
        if (!types.same(ct.ok, data.type)) { ret res[Global, Error].err{Error.mismatch{ct.ok}}; }
    }
    if (sel data.alignment.some) {
        val align: u64 = data.alignment.some;
        if (!power_of_two(align)) { ret res[Global, Error].err{Error.alignment{align}}; }
    }
    if (sel data.section.some) {
        if (data.section.some.name.len == 0)          { ret res[Global, Error].err{Error.name{}}; }
        if (!global.kind_row(data.section.some.kind)) { ret res[Global, Error].err{Error.section{}}; }
    }

    var n: global.Node;
    n.data       = data;
    n.attributes = vector.init[Attribute](m.a);
    val name: res[View, allocator.Error] = slice.copy_view(m.a, data.name);
    if (sel name.err) { ret res[Global, Error].err{Error.alloc{name.err}}; }
    n.data.name = name.ok;
    if (sel data.section.some) {
        val section: res[View, allocator.Error] = slice.copy_view(m.a, data.section.some.name);
        if (sel section.err) {
            slice.release_view(m.a, name.ok);
            ret res[Global, Error].err{Error.alloc{section.err}};
        }
        n.data.section = opt[global.Section].some{global.Section{name: section.ok, kind: data.section.some.kind}};
    }
    val id:     Global                      = Global{index: m.globals.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[global.Node](?m.globals, n);
    if (sel pushed.err) {
        slice.release_view(m.a, n.data.name);
        if (sel n.data.section.some) { slice.release_view(m.a, n.data.section.some.name); }
        ret res[Global, Error].err{Error.alloc{pushed.err}};
    }
    val indexed: err[allocator.Error] = index(m, n.data.name, Symbol.global{id});
    if (sel indexed.err) {
        vector.pop[global.Node](?m.globals);
        slice.release_view(m.a, n.data.name);
        if (sel n.data.section.some) { slice.release_view(m.a, n.data.section.some.name); }
        ret res[Global, Error].err{Error.alloc{indexed.err}};
    }
    ret res[Global, Error].ok{id};
}

# what a global is, its names valid for the life of the module
pub fun global_data(m: *Module, g: Global) res[GlobalData, Error] {
    if (g.index::usize >= m.globals.len) { ret res[GlobalData, Error].err{Error.global{g}}; }
    ret res[GlobalData, Error].ok{m.globals.data[g.index].data};
}

# give a global its initial value, in place of any it had
# ---
# m:   the module
# g:   the global
# c:   a constant of the global's type
# ret: ok, or why it was refused
pub fun initialize(m: *Module, g: Global, c: Constant) err[Error] {
    if (g.index::usize >= m.globals.len) { ret err[Error].err{Error.global{g}}; }
    val ct: res[Type, Error] = constant_type(m, c);
    if (sel ct.err)                                            { ret err[Error].err{ct.err}; }
    if (!types.same(ct.ok, m.globals.data[g.index].data.type)) { ret err[Error].err{Error.mismatch{ct.ok}}; }
    m.globals.data[g.index].data.initial = opt[Constant].some{c};
    ret err[Error].ok{};
}

# export a symbol from the module
pub fun export(m: *Module, s: Symbol) err[Error] {
    val k: err[Error] = known(m, s);
    if (sel k.err) { ret k; }
    val pushed: res[usize, allocator.Error] = vector.push[Symbol](?m.exports, s);
    if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
    ret err[Error].ok{};
}

# the symbols the module exports, valid until the next export
pub fun exports(m: *Module) Slice[Symbol] {
    ret Slice[Symbol]{data: m.exports.data, size: m.exports.len};
}

fun attributes_of(m: *Module, s: Symbol) res[*vector.Vector[Attribute], Error] {
    val k: err[Error] = known(m, s);
    if (sel k.err)      { ret res[*vector.Vector[Attribute], Error].err{k.err}; }
    if (sel s.function) { ret res[*vector.Vector[Attribute], Error].ok{?m.functions.data[s.function.index].attributes}; }
    ret res[*vector.Vector[Attribute], Error].ok{?m.globals.data[s.global.index].attributes};
}

# attach an attribute to a function or global
# ---
# m:   the module
# s:   the function or global
# at:  the attribute, whose names and lists are copied
# ret: ok, or why it was refused
pub fun attach(m: *Module, s: Symbol, at: Attribute) err[Error] {
    val list: res[*vector.Vector[Attribute], Error] = attributes_of(m, s);
    if (sel list.err)                           { ret err[Error].err{list.err}; }
    if (at.family.len == 0 || at.name.len == 0) { ret err[Error].err{Error.name{}}; }

    var owned:  Attribute                  = at;
    val family: res[View, allocator.Error] = slice.copy_view(m.a, at.family);
    if (sel family.err) { ret err[Error].err{Error.alloc{family.err}}; }
    owned.family = family.ok;
    val name: res[View, allocator.Error] = slice.copy_view(m.a, at.name);
    if (sel name.err) {
        slice.release_view(m.a, owned.family);
        ret err[Error].err{Error.alloc{name.err}};
    }
    owned.name = name.ok;
    if (sel at.datum.integers) {
        val l: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, at.datum.integers);
        if (sel l.err) {
            slice.release_view(m.a, owned.family);
            slice.release_view(m.a, owned.name);
            ret err[Error].err{Error.alloc{l.err}};
        }
        owned.datum = Datum.integers{l.ok};
    }
    or (sel at.datum.text) {
        val t: res[View, allocator.Error] = slice.copy_view(m.a, at.datum.text);
        if (sel t.err) {
            slice.release_view(m.a, owned.family);
            slice.release_view(m.a, owned.name);
            ret err[Error].err{Error.alloc{t.err}};
        }
        owned.datum = Datum.text{t.ok};
    }
    val pushed: res[usize, allocator.Error] = vector.push[Attribute](list.ok, owned);
    if (sel pushed.ok)            { ret err[Error].ok{}; }
    if (sel owned.datum.integers) { slice.release[u64](m.a, owned.datum.integers); }
    or (sel owned.datum.text)     { slice.release_view(m.a, owned.datum.text); }
    slice.release_view(m.a, owned.family);
    slice.release_view(m.a, owned.name);
    ret err[Error].err{Error.alloc{pushed.err}};
}

# the attributes attached to a function or global, valid until the next attach
pub fun attributes(m: *Module, s: Symbol) res[Slice[Attribute], Error] {
    val list: res[*vector.Vector[Attribute], Error] = attributes_of(m, s);
    if (sel list.err) { ret res[Slice[Attribute], Error].err{list.err}; }
    ret res[Slice[Attribute], Error].ok{Slice[Attribute]{data: list.ok.data, size: list.ok.len}};
}

# make a list of debug bindings that instructions can share
# ---
# m:    the module
# list: the bindings, which are copied
# ret:  the list's id, the empty list's when list is empty
pub fun bindings(m: *Module, list: Slice[Binding]) res[Bindings, Error] {
    if (list.size == 0) { ret res[Bindings, Error].ok{UNBOUND}; }
    val owned: res[Slice[Binding], allocator.Error] = slice.copy[Binding](m.a, list);
    if (sel owned.err) { ret res[Bindings, Error].err{Error.alloc{owned.err}}; }
    val id:     Bindings                    = Bindings{index: m.bindings.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Slice[Binding]](?m.bindings, owned.ok);
    if (sel pushed.err) {
        slice.release[Binding](m.a, owned.ok);
        ret res[Bindings, Error].err{Error.alloc{pushed.err}};
    }
    ret res[Bindings, Error].ok{id};
}

# the bindings a list holds, valid for the life of the module
pub fun bound(m: *Module, b: Bindings) res[Slice[Binding], Error] {
    if (b.index::usize >= m.bindings.len) { ret res[Slice[Binding], Error].err{Error.bindings{b}}; }
    ret res[Slice[Binding], Error].ok{m.bindings.data[b.index]};
}

# whether a step is of a kind with a row and given the argument its row takes
fun step_formed(m: *Module, s: Step) bool {
    val r: opt[point.Row] = point.row(s.kind);
    if (sel r.none) { ret false; }
    val a: point.Argument = s.argument;
    if (sel r.some.takes.constant) {
        if (!(sel a.constant)) { ret false; }
        ret a.constant.index::usize < m.constants.len;
    }
    if (!(sel a.to)) { ret false; }
    val k: res[types.Shape, Error] = shape(m, a.to);
    ret sel k.ok && sel k.ok.integer;
}

# make a salvage expression that records can share
# ---
# m:     the module
# steps: its steps in order, each of a kind with a row and given what its row
#        takes, which are copied
# ret:   the expression's id, PLAIN when steps is empty, or why it was refused
pub fun expression(m: *Module, steps: Slice[Step]) res[Expression, Error] {
    if (steps.size == 0) { ret res[Expression, Error].ok{point.PLAIN}; }
    var i: usize = 0;
    for (i < steps.size) {
        if (!step_formed(m, steps.data[i])) { ret res[Expression, Error].err{Error.step{i::u32}}; }
        i = i + 1;
    }
    val owned: res[Slice[Step], allocator.Error] = slice.copy[Step](m.a, steps);
    if (sel owned.err) { ret res[Expression, Error].err{Error.alloc{owned.err}}; }
    val id:     Expression                  = Expression{index: m.expressions.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Slice[Step]](?m.expressions, owned.ok);
    if (sel pushed.err) {
        slice.release[Step](m.a, owned.ok);
        ret res[Expression, Error].err{Error.alloc{pushed.err}};
    }
    ret res[Expression, Error].ok{id};
}

# the steps an expression holds, valid for the life of the module
pub fun steps(m: *Module, e: Expression) res[Slice[Step], Error] {
    if (e.index::usize >= m.expressions.len) { ret res[Slice[Step], Error].err{Error.expression{e}}; }
    ret res[Slice[Step], Error].ok{m.expressions.data[e.index]};
}

fun integer_width(m: *Module, ty: Type) res[u32, Error] {
    val s: res[types.Shape, Error] = shape(m, ty);
    if (sel s.err)           { ret res[u32, Error].err{s.err}; }
    if (!(sel s.ok.integer)) { ret res[u32, Error].err{Error.mismatch{ty}}; }
    ret res[u32, Error].ok{s.ok.integer.width};
}

# the type an expression gives from a value of a type, each step reading what
# the one before it gives
# ---
# m:   the module
# ty:  the type of the value it reads
# e:   the expression
# ret: the type the variable is given, or why the expression does not apply
pub fun salvaged(m: *Module, ty: Type, e: Expression) res[Type, Error] {
    val list: res[Slice[Step], Error] = steps(m, e);
    if (sel list.err) { ret res[Type, Error].err{list.err}; }
    var now: Type  = ty;
    var i:   usize = 0;
    for (i < list.ok.size) {
        val s: Step           = list.ok.data[i];
        val r: opt[point.Row] = point.row(s.kind);
        if (sel r.none) { ret res[Type, Error].err{Error.step{i::u32}}; }
        val width: res[u32, Error] = integer_width(m, now);
        if (sel width.err) { ret res[Type, Error].err{width.err}; }
        val a: point.Argument = s.argument;
        if (sel a.constant) {
            val ct: res[Type, Error] = constant_type(m, a.constant);
            if (sel ct.err)              { ret res[Type, Error].err{ct.err}; }
            if (!types.same(ct.ok, now)) { ret res[Type, Error].err{Error.mismatch{ct.ok}}; }
        }
        or (sel a.to) {
            val to: res[u32, Error] = integer_width(m, a.to);
            if (sel to.err) { ret res[Type, Error].err{to.err}; }
            val w: point.Width = r.some.width;
            if (sel w.same && to.ok != width.ok)     { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            if (sel w.wider && to.ok <= width.ok)    { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            if (sel w.narrower && to.ok >= width.ok) { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            now = a.to;
        }
        i = i + 1;
    }
    ret res[Type, Error].ok{now};
}

fun must[T](r: res[T, Error], out: *T) bool {
    if (sel r.err) { ret false; }
    @out = r.ok;
    ret true;
}

test global__initial_holds_an_address {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Error] = init(?a, TESTING);
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { dnit(?m); }

    val i32: res[Type, types.Error] = types.intern(?m.types, types.Shape.integer{types.Integer{width: 32}});
    val ptr: res[Type, types.Error] = types.intern(?m.types, types.Shape.pointer{types.Pointer{space: 0}});
    if (sel i32.err) { ret 1; }
    if (sel ptr.err) { ret 1; }
    var members: [2]Type                = [2]Type{ptr.ok, i32.ok};
    val pair:    res[Type, types.Error] = types.intern(?m.types, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?members[0], size: 2}, offsets: opt[Slice[u64]].none{}}});
    if (sel pair.err) { ret 1; }

    var target: Global;
    if (!must[Global](add_global(?m, GlobalData{name: View{data: "counter", len: 7}, type: i32.ok, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}}), ?target)) { ret 2; }

    var seven: [1]u64 = [1]u64{7};
    var addr:  Constant;
    var count: Constant;
    if (!must[Constant](add_constant(?m, ConstantData.address{Address{type: ptr.ok, symbol: Symbol.global{target}, offset: 0}}), ?addr))  { ret 3; }
    if (!must[Constant](add_constant(?m, ConstantData.integer{Bits{type: i32.ok, words: Slice[u64]{data: ?seven[0], size: 1}}}), ?count)) { ret 3; }
    var elements: [2]Constant = [2]Constant{addr, count};
    var table:    Constant;
    if (!must[Constant](add_constant(?m, ConstantData.aggregate{Aggregate{type: pair.ok, elements: Slice[Constant]{data: ?elements[0], size: 2}}}), ?table)) { ret 4; }

    var flipped: [2]Constant          = [2]Constant{count, addr};
    val wrong:   res[Constant, Error] = add_constant(?m, ConstantData.aggregate{Aggregate{type: pair.ok, elements: Slice[Constant]{data: ?flipped[0], size: 2}}});
    if (sel wrong.ok)             { ret 5; }
    if (!(sel wrong.err.element)) { ret 5; }

    var holder: Global;
    if (!must[Global](add_global(?m, GlobalData{name: View{data: "table", len: 5}, type: pair.ok, initial: opt[Constant].some{table}, linkage: Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.HIDDEN}}), ?holder)) { ret 6; }

    val got: res[GlobalData, Error] = global_data(?m, holder);
    if (sel got.err) { ret 7; }
    val initial: opt[Constant] = got.ok.initial;
    if (sel initial.none) { ret 7; }
    val outer: res[ConstantData, Error] = constant_data(?m, initial.some);
    if (sel outer.err)             { ret 8; }
    if (!(sel outer.ok.aggregate)) { ret 8; }
    val first: res[ConstantData, Error] = constant_data(?m, outer.ok.aggregate.elements.data[0]);
    if (sel first.err)           { ret 9; }
    if (!(sel first.ok.address)) { ret 9; }
    val at: Symbol = first.ok.address.symbol;
    if (!(sel at.global && at.global.index == target.index)) { ret 9; }

    val mismatched: res[Global, Error] = add_global(?m, GlobalData{name: View{data: "bad", len: 3}, type: i32.ok, initial: opt[Constant].some{table}, linkage: Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.HIDDEN}});
    if (sel mismatched.ok) { ret 10; }

    val again: res[Global, Error] = add_global(?m, GlobalData{name: View{data: "counter", len: 7}, type: i32.ok, linkage: Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.HIDDEN}});
    if (sel again.ok)                                         { ret 11; }
    if (!(sel again.err.taken && sel again.err.taken.global)) { ret 11; }
    val sig: res[Type, types.Error] = types.intern(?m.types, types.Shape.function{types.plain(Slice[Type]{data: nil, size: 0}, Slice[Type]{data: nil, size: 0})});
    if (sel sig.err) { ret 12; }
    val clash: res[Function, Error] = add_function(?m, FunctionData{name: View{data: "table", len: 5}, signature: sig.ok, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    if (sel clash.ok)           { ret 12; }
    if (!(sel clash.err.taken)) { ret 12; }
    val owner: Symbol = clash.err.taken;
    if (!(sel owner.global && owner.global.index == holder.index)) { ret 12; }
    val named: opt[Symbol] = find(?m, View{data: "table", len: 5});
    if (sel named.none) { ret 13; }
    val found: Symbol = named.some;
    if (!(sel found.global && found.global.index == holder.index)) { ret 13; }
    ret 0;
}
