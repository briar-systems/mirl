use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

# why a module refused a request
# ---
# alloc:       the allocator refused storage
# types:       the type table refused a read
# typing:      the instruction's opcode row refused it
# name:        an empty name or tuple part, or a name handle the module's names hold
#              none of
# taken:       a symbol name this function or global already has
# function:    a function this module did not give out
# global:      a global this module did not give out
# constant:    a constant this module did not give out
# specialized: a specialization constant, whose bits are its consumer's to set,
#              where a request reads a constant's bits
# bindings:    a binding list this module did not give out
# publics:     a public range list this module did not give out
# expression:  a salvage expression this module did not give out
# step:        a salvage step of a kind with no row, or an argument that is not
#              what its row takes
# binding:     a binding the debug table did not give out
# point:       a record position the block does not have
# bound:       a value a record outside what is taken back reads
# block:       a block the function's body did not give out
# value:       a value the function's body did not give out
# instruction: an instruction the function's body did not give out
# linkage:     a linkage that is not a row of mink's symbol bindings
# visibility:  a visibility that is not a row of mink's symbol visibilities
# section:     a section kind that is not a row of mink's section kinds
# mismatch:    a type that is not the type or kind the request needs
# alignment:   an alignment that is not a power of two
# words:       a number whose words do not fit its type's width
# elements:    an aggregate of this many elements, not what its type holds
# element:     the aggregate element at this position is not of its member's type
# incoming:    this many incoming arguments, not one per edge into the block
# parameter:   a parameter position the block does not have
# used:        a value that still has uses
# secret:      a secret value asked to stand where only a public one may
# placed:      an instruction already placed in a block
# detached:    an instruction placed in no block
# erased:      an instruction taken out of its body
# results:     an instruction of this many results, not as many as the one it
#              replaces
# circular:    a replacement that uses this result of the instruction it replaces
# edge:        an edge position the instruction does not have
# position:    this instruction does not stand where the edit needs it: in the
#              block named, or after the instruction named
# arguments:   this many arguments, not one per parameter of the target
# removed:     a block taken out of its body
# entry:       the entry block, which stays in its body
# reached:     a block that an edge still enters
# occupied:    a block that still holds instructions
# lowered:     an edit that would lower an instruction's secrecy mark
# unkept:      an edit that would take an instruction's kept mark off it
# same:        a block asked to take instructions from itself
# terminator:  an edit that would move an instruction that ends its block
# piece:       a record split into no part, or into parts that share a bit
# secrecy:     a global's secret ranges, a function's secret parameters or result,
#              or an alloca's public ranges not stated as they may be
# convention:  a signature's convention row, which a target's architecture
#              has no row of that name for
pub tag Error: u8 {
    alloc:  allocator.Error;
    types:  type_table.Error;
    typing: check.Error;
    name;
    taken:       Symbol;
    function:    Function;
    global:      Global;
    constant:    Constant;
    specialized: Constant;
    bindings:    Bindings;
    publics:     Publics;
    expression:  Expression;
    step:        u32;
    binding:     Binding;
    point:       u32;
    bound:       Value;
    block:       Block;
    value:       Value;
    instruction: Instruction;
    linkage;
    visibility;
    section;
    mismatch:  Type;
    alignment: u64;
    words;
    elements:  u32;
    element:   u32;
    incoming:  u32;
    parameter: u32;
    used:      Value;
    secret:    Value;
    placed:    Instruction;
    detached:  Instruction;
    erased:    Instruction;
    results:   u32;
    circular:  Value;
    edge:      u32;
    position:  u32;
    arguments: u32;
    removed:   Block;
    entry;
    reached:    Block;
    occupied:   Block;
    lowered:    Instruction;
    unkept:     Instruction;
    same:       Block;
    terminator: Instruction;
    piece:      u32;
    secrecy;
    convention: calling.Calling;
}

# the allocator's refusal `e` stands for, its own or a step's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc)  { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.types)  { ret type_table.starved(e.types); }
    if (sel e.typing) { ret check.starved(e.typing); }
    ret opt[allocator.Error].none{};
}

# the target a module is built for, each part of its tuple as its owner
# spells it. every part is stated, and none is empty
# ---
# arch: its architecture, by the name of its row in mink's catalog
# sys:  its system, by the name of its row in mink's catalog
# env:  its environment, by the name of the system's environment row in
#       mink's catalog, or `none` for a system run under none
# abi:  its abi, by the name of a member of the architecture's convention axis
# isa:  the instruction set every machine of it has, as masc spells the
#       selection
pub rec Tuple {
    arch: View;
    sys:  View;
    env:  View;
    abi:  View;
    isa:  View;
}

# whether two tuples spell the same parts
pub fun same_target(a: Tuple, b: Tuple) bool {
    ret slice.same_view(a.arch, b.arch) && slice.same_view(a.sys, b.sys) && slice.same_view(a.env, b.env) && slice.same_view(a.abi, b.abi) && slice.same_view(a.isa, b.isa);
}

# whether a tuple states every part, none of them empty
pub fun tuple_stated(t: Tuple) bool {
    ret t.arch.len != 0 && t.sys.len != 0 && t.env.len != 0 && t.abi.len != 0 && t.isa.len != 0;
}

fun copy_tuple(a: *allocator.Allocator, t: Tuple) res[Tuple, allocator.Error] {
    var out:      Tuple                      = Tuple{arch: View{data: nil, len: 0}, sys: View{data: nil, len: 0}, env: View{data: nil, len: 0}, abi: View{data: nil, len: 0}, isa: View{data: nil, len: 0}};
    val res_arch: res[View, allocator.Error] = slice.copy_view(a, t.arch);
    if (sel res_arch.err) { ret res[Tuple, allocator.Error].err{res_arch.err}; }
    out.arch = res_arch.ok;
    val res_sys: res[View, allocator.Error] = slice.copy_view(a, t.sys);
    if (sel res_sys.err) {
        tuple_dnit(a, out);
        ret res[Tuple, allocator.Error].err{res_sys.err};
    }
    out.sys = res_sys.ok;
    val res_env: res[View, allocator.Error] = slice.copy_view(a, t.env);
    if (sel res_env.err) {
        tuple_dnit(a, out);
        ret res[Tuple, allocator.Error].err{res_env.err};
    }
    out.env = res_env.ok;
    val res_abi: res[View, allocator.Error] = slice.copy_view(a, t.abi);
    if (sel res_abi.err) {
        tuple_dnit(a, out);
        ret res[Tuple, allocator.Error].err{res_abi.err};
    }
    out.abi = res_abi.ok;
    val res_isa: res[View, allocator.Error] = slice.copy_view(a, t.isa);
    if (sel res_isa.err) {
        tuple_dnit(a, out);
        ret res[Tuple, allocator.Error].err{res_isa.err};
    }
    out.isa = res_isa.ok;
    ret res[Tuple, allocator.Error].ok{out};
}

fun tuple_dnit(a: *allocator.Allocator, t: Tuple) err[allocator.Error] {
    var err_failed: err[allocator.Error] = slice.view_free(a, t.arch);
    keep(?err_failed, slice.view_free(a, t.sys));
    keep(?err_failed, slice.view_free(a, t.env));
    keep(?err_failed, slice.view_free(a, t.abi));
    keep(?err_failed, slice.view_free(a, t.isa));
    ret err_failed;
}

# one module
# ---
# a:           the allocator everything the module holds is taken from
# target:      the tuple of the target it was built for, resolved by mirl.target
# language:    the source language its front end stated, or none
# adopted:     the language it holds a row of its own for, as a reader of
#              the text form makes one, or none
# types:       its type table
# debug:       its debug table
# functions:   its functions, indexed by id
# stated:      the declarations calls through a value state their callees keep, indexed by id, each a function's
#              declaration that no function of the module has and no symbol names (`add_stated`)
# globals:     its globals, indexed by id
# constants:   its constants, indexed by id
# bindings:    its lists of debug bindings, the empty list first
# publics:     its lists of an alloca's public ranges, the first standing for no statement
# expressions: its salvage expressions, the empty one first
# names:       the names its functions and globals are declared by, interned once, which a compilation hands to the
#              object it makes (see `lend`)
# lent:        where its names are while a compilation holds them, none while the module holds them
# symbols:     per name, by its handle's index, the function or global it names
# scratch:     the lists typing an instruction fills, kept across instructions so making one allocates none
pub rec Module {
    a:           *allocator.Allocator;
    target:      Tuple;
    language:    opt[*Language];
    adopted:     opt[*Language];
    types:       type_table.Table;
    debug:       debug_table.Table;
    functions:   vector.Vector[function.Node];
    stated:      vector.Vector[FunctionData];
    globals:     vector.Vector[global.Node];
    constants:   vector.Vector[ConstantData];
    bindings:    vector.Vector[Slice[Binding]];
    publics:     vector.Vector[Slice[global.Range]];
    expressions: vector.Vector[Slice[Step]];
    names:       Interner;
    lent:        opt[*Interner];
    symbols:     vector.Vector[opt[Symbol]];
    scratch:     Scratch;
}

# the lists typing one instruction fills, emptied by each use and only valid
# within it
# ---
# types:   operand types, then each edge's argument and parameter types
# secret:  whether each operand is secret
# edges:   each edge's argument and parameter types, as views of types
# results: the result types the check gives
pub rec Scratch {
    types:   vector.Vector[Type];
    secret:  vector.Vector[bool];
    edges:   vector.Vector[check.Edge];
    results: vector.Vector[Type];
}

# create an empty module
# ---
# a:      the allocator the module takes its storage from
# target: the tuple of the target it is built for, which is copied
# ret:    the module, or why it was refused
pub fun init(a: *allocator.Allocator, target: Tuple) res[Module, Error] {
    if (!tuple_stated(target)) { ret res[Module, Error].err{Error.name{}}; }
    var m: Module;
    m.a = a;
    val res_name: res[Tuple, allocator.Error] = copy_tuple(a, target);
    if (sel res_name.err) { ret res[Module, Error].err{Error.alloc{res_name.err}}; }
    m.target      = res_name.ok;
    m.language    = opt[*Language].none{};
    m.adopted     = opt[*Language].none{};
    m.types       = type_table.init(a);
    m.debug       = debug_table.init(a);
    m.functions   = vector.init[function.Node](a);
    m.stated      = vector.init[FunctionData](a);
    m.globals     = vector.init[global.Node](a);
    m.constants   = vector.init[ConstantData](a);
    m.bindings    = vector.init[Slice[Binding]](a);
    m.publics     = vector.init[Slice[global.Range]](a);
    m.expressions = vector.init[Slice[Step]](a);
    m.names       = intern.init(a);
    m.lent        = opt[*Interner].none{};
    m.symbols     = vector.init[opt[Symbol]](a);
    m.scratch     = Scratch{types: vector.init[Type](a), secret: vector.init[bool](a), edges: vector.init[check.Edge](a), results: vector.init[Type](a)};
    val res_empty: res[usize, allocator.Error] = vector.push[Slice[Binding]](?m.bindings, Slice[Binding]{data: nil, size: 0});
    if (sel res_empty.err) {
        tuple_dnit(a, m.target);
        debug_table.dnit(?m.debug);
        ret res[Module, Error].err{Error.alloc{res_empty.err}};
    }
    val res_plain: res[usize, allocator.Error] = vector.push[Slice[Step]](?m.expressions, Slice[Step]{data: nil, size: 0});
    if (sel res_plain.err) {
        vector.dnit[Slice[Binding]](?m.bindings);
        tuple_dnit(a, m.target);
        debug_table.dnit(?m.debug);
        ret res[Module, Error].err{Error.alloc{res_plain.err}};
    }
    val res_none: res[usize, allocator.Error] = vector.push[Slice[global.Range]](?m.publics, Slice[global.Range]{data: nil, size: 0});
    if (sel res_none.err) {
        vector.dnit[Slice[Step]](?m.expressions);
        vector.dnit[Slice[Binding]](?m.bindings);
        tuple_dnit(a, m.target);
        debug_table.dnit(?m.debug);
        ret res[Module, Error].err{Error.alloc{res_none.err}};
    }
    ret res[Module, Error].ok{m};
}

# give back the attributes of a list past its first count, keeping the rest
# ---
# a:     the allocator of the list's module
# list:  the attributes of a function or global
# count: how many to keep
# ret:   ok, or the allocator's refusal of the first release that failed
pub fun trim_attributes(a: *allocator.Allocator, list: *vector.Vector[Attribute], count: usize) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    for (list.len > count) {
        val at: Attribute = list.data[list.len - 1];
        keep(?err_failed, slice.view_free(a, at.family));
        keep(?err_failed, slice.view_free(a, at.name));
        if (sel at.datum.integers) { keep(?err_failed, slice.free[u64](a, at.datum.integers)); }
        if (sel at.datum.text)     { keep(?err_failed, slice.view_free(a, at.datum.text)); }
        vector.truncate[Attribute](list, list.len - 1);
    }
    ret err_failed;
}

# give back a function or global's attributes and their list
pub fun attributes_dnit(a: *allocator.Allocator, list: *vector.Vector[Attribute]) err[allocator.Error] {
    var err_failed: err[allocator.Error] = trim_attributes(a, list, 0);
    keep(?err_failed, vector.dnit[Attribute](list));
    ret err_failed;
}

# give back what a constant owns
pub fun constant_dnit(a: *allocator.Allocator, c: ConstantData) err[allocator.Error] {
    if (sel c.integer)   { ret slice.free[u64](a, c.integer.words); }
    if (sel c.float)     { ret slice.free[u64](a, c.float.words); }
    if (sel c.aggregate) { ret slice.free[Constant](a, c.aggregate.elements); }
    if (sel c.spec)      { ret slice.free[u64](a, c.spec.default.words); }
    if (sel c.bytes)     { ret slice.free[u8](a, c.bytes.data); }
    ret err[allocator.Error].ok{};
}

# give back everything a block of a function body owns
# ---
# a:   the allocator of the body's module
# k:   the block
# ret: ok, or the allocator's refusal of the first release that failed
pub fun block_dnit(a: *allocator.Allocator, k: *BlockData) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?err_failed, vector.dnit[Value](?k.parameters));
    keep(?err_failed, vector.dnit[Instruction](?k.predecessors));
    if (sel k.name.some) { keep(?err_failed, slice.view_free(a, k.name.some)); }
    ret err_failed;
}

# give back everything a value of a function body owns
# ---
# a:   the allocator of the body's module
# v:   the value
# ret: ok, or the allocator's refusal of the first release that failed
pub fun value_dnit(a: *allocator.Allocator, v: *ValueData) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?err_failed, vector.dnit[u32](?v.bound));
    if (sel v.name.some) { keep(?err_failed, slice.view_free(a, v.name.some)); }
    ret err_failed;
}

# give back everything a function body owns
# ---
# a:   the allocator of the body's module
# b:   the body
# ret: ok, or the allocator's refusal of the first release that failed
pub fun body_dnit(a: *allocator.Allocator, b: *function.Body) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (i < b.blocks.len) {
        keep(?err_failed, block_dnit(a, ?b.blocks.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < b.values.len) {
        keep(?err_failed, value_dnit(a, ?b.values.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < b.instructions.len) {
        keep(?err_failed, instruction.dnit(a, ?b.instructions.data[i]));
        i = i + 1;
    }
    keep(?err_failed, vector.dnit[BlockData](?b.blocks));
    keep(?err_failed, vector.dnit[ValueData](?b.values));
    keep(?err_failed, vector.dnit[InstructionData](?b.instructions));
    keep(?err_failed, map.dnit[u32, Value](?b.constants));
    keep(?err_failed, vector.dnit[Point](?b.points));
    keep(?err_failed, pool.dnit[Value](?b.lists));
    keep(?err_failed, pool.dnit[Immediate](?b.immediates));
    keep(?err_failed, pool.dnit[Edge](?b.edges));
    keep(?err_failed, given.dnit(?b.contents));
    keep(?err_failed, vector.dnit[u32](?b.marks.instructions));
    keep(?err_failed, vector.dnit[u32](?b.marks.values));
    if (sel b.entry.placed) { keep(?err_failed, vector.dnit[Placed](?b.entry.placed)); }
    b.entry = function.Entry.unplaced{};
    ret err_failed;
}

# give back a function's body and leave it with none, a declaration of what another module defines
# ---
# m:   the module
# f:   the function
# ret: ok, or why it was refused: a function the module did not give out, or the allocator's refusal of the first
#      release that failed, the body left empty either way
pub fun drop_body(m: *Module, f: Function) err[Error] {
    if (f::usize >= m.functions.len) { ret err[Error].err{Error.function{f}}; }
    val b:          *function.Body       = ?m.functions.data[f].body;
    val err_failed: err[allocator.Error] = body_dnit(m.a, b);
    b.blocks       = vector.init[BlockData](m.a);
    b.values       = vector.init[ValueData](m.a);
    b.instructions = vector.init[InstructionData](m.a);
    b.constants    = map.init[u32, Value](m.a);
    b.points       = vector.init[Point](m.a);
    b.lists        = pool.init[Value](m.a);
    b.immediates   = pool.init[Immediate](m.a);
    b.edges        = pool.init[Edge](m.a);
    b.contents     = given.init(m.a);
    b.marks        = function.Marks{epoch: 0, instructions: vector.init[u32](m.a), values: vector.init[u32](m.a)};
    if (sel err_failed.err) { ret err[Error].err{Error.alloc{err_failed.err}}; }
    ret err[Error].ok{};
}

# give back what a function owns: its extensions, section, secret parameters, result and public pointers, attributes
# and body
pub fun function_dnit(a: *allocator.Allocator, n: *function.Node) err[allocator.Error] {
    var err_failed: err[allocator.Error] = slice.views_dnit(a, n.data.extensions);
    keep(?err_failed, secrets_dnit(a, n.data.secrets));
    keep(?err_failed, secrecy_dnit(a, n.data.result));
    keep(?err_failed, slice.free[u32](a, n.data.pointers));
    if (sel n.data.section.some) { keep(?err_failed, slice.view_free(a, n.data.section.some.name)); }
    keep(?err_failed, attributes_dnit(a, ?n.attributes));
    keep(?err_failed, body_dnit(a, ?n.body));
    ret err_failed;
}

# give back what a declaration a call states owns: its secret parameters, secret result and public pointers
fun declaration_dnit(a: *allocator.Allocator, data: FunctionData) err[allocator.Error] {
    var err_failed: err[allocator.Error] = secrets_dnit(a, data.secrets);
    keep(?err_failed, secrecy_dnit(a, data.result));
    keep(?err_failed, slice.free[u32](a, data.pointers));
    ret err_failed;
}

# give back what a global owns: its section, secret ranges and attributes
pub fun global_dnit(a: *allocator.Allocator, g: *global.Node) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    if (sel g.data.section.some)  { keep(?err_failed, slice.view_free(a, g.data.section.some.name)); }
    if (sel g.data.secret.ranges) { keep(?err_failed, slice.free[global.Range](a, g.data.secret.ranges)); }
    keep(?err_failed, attributes_dnit(a, ?g.attributes));
    ret err_failed;
}

# release everything the module holds
# ---
# m:   the module
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(m: *Module) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (i < m.functions.len) {
        keep(?err_failed, function_dnit(m.a, ?m.functions.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.stated.len) {
        keep(?err_failed, declaration_dnit(m.a, m.stated.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        keep(?err_failed, global_dnit(m.a, ?m.globals.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.constants.len) {
        keep(?err_failed, constant_dnit(m.a, m.constants.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.bindings.len) {
        keep(?err_failed, slice.free[Binding](m.a, m.bindings.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.expressions.len) {
        keep(?err_failed, slice.free[Step](m.a, m.expressions.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < m.publics.len) {
        keep(?err_failed, slice.free[global.Range](m.a, m.publics.data[i]));
        i = i + 1;
    }
    keep(?err_failed, vector.dnit[function.Node](?m.functions));
    keep(?err_failed, vector.dnit[FunctionData](?m.stated));
    keep(?err_failed, vector.dnit[global.Node](?m.globals));
    keep(?err_failed, vector.dnit[ConstantData](?m.constants));
    keep(?err_failed, vector.dnit[Slice[Binding]](?m.bindings));
    keep(?err_failed, vector.dnit[Slice[Step]](?m.expressions));
    keep(?err_failed, vector.dnit[Slice[global.Range]](?m.publics));
    keep(?err_failed, vector.dnit[opt[Symbol]](?m.symbols));
    keep(?err_failed, vector.dnit[Type](?m.scratch.types));
    keep(?err_failed, vector.dnit[bool](?m.scratch.secret));
    keep(?err_failed, vector.dnit[check.Edge](?m.scratch.edges));
    keep(?err_failed, vector.dnit[Type](?m.scratch.results));
    val err_names: err[Fail] = intern.dnit(?m.names);
    if (sel err_names.err) { keep(?err_failed, err[allocator.Error].err{refusal(err_names.err)}); }
    keep(?err_failed, debug_table.dnit(?m.debug));
    keep(?err_failed, type_table.dnit(?m.types));
    keep(?err_failed, tuple_dnit(m.a, m.target));
    keep(?err_failed, adopted_dnit(m));
    ret err_failed;
}

# the tuple of the target the module was built for, valid for its life
pub fun target(m: *Module) Tuple {
    ret m.target;
}

# state another target for the module in place of the one it names, as a
# command line that names one does, copying the tuple. every signature's
# convention is restated by its row's name on the tuple's architecture
# ---
# m:   the module
# t:   the tuple, every part stated
# ret: ok, or name for a tuple with a part empty, convention for a row the
#      tuple's architecture has none of by that name, or alloc, leaving the
#      module's own tuple
pub fun retarget(m: *Module, t: Tuple) err[Error] {
    if (!tuple_stated(t)) { ret err[Error].err{Error.name{}}; }
    val res_copied: res[Tuple, allocator.Error] = copy_tuple(m.a, t);
    if (sel res_copied.err) { ret err[Error].err{Error.alloc{res_copied.err}}; }
    val opt_left: opt[calling.Calling] = type_table.restate(?m.types, calling.arch_named(t.arch));
    if (sel opt_left.some) {
        val err_dropped: err[allocator.Error] = tuple_dnit(m.a, res_copied.ok);
        if (sel err_dropped.err) { ret err[Error].err{Error.alloc{err_dropped.err}}; }
        ret err[Error].err{Error.convention{opt_left.some}};
    }
    val old: Tuple = m.target;
    m.target = res_copied.ok;
    val err_released: err[allocator.Error] = tuple_dnit(m.a, old);
    if (sel err_released.err) { ret err[Error].err{Error.alloc{err_released.err}}; }
    ret err[Error].ok{};
}

# state the source language of the module's code, as its front end does
pub fun state_language(m: *Module, l: *Language) {
    m.language = opt[*Language].some{l};
}

# state a source language the module holds a row of its own for, a copy of
# a name and code its caller keeps nothing of, as a reader of the text form
# states a language mirl has no row of
# ---
# m:     the module
# name:  the language's name, which is copied
# dwarf: its DW_LANG code
# ret:   ok, or the allocator's refusal
pub fun adopt_language(m: *Module, name: View, dwarf: u16) err[Error] {
    val res_row: res[*Language, allocator.Error] = allocator.allocate[Language](m.a, 1);
    if (sel res_row.err) { ret err[Error].err{Error.alloc{res_row.err}}; }
    val res_copy: res[View, allocator.Error] = slice.copy_view(m.a, name);
    if (sel res_copy.err) {
        allocator.deallocate[Language](m.a, res_row.ok, 1);
        ret err[Error].err{Error.alloc{res_copy.err}};
    }
    val err_gone: err[allocator.Error] = adopted_dnit(m);
    if (sel err_gone.err) { ret err[Error].err{Error.alloc{err_gone.err}}; }
    @res_row.ok = Language{name: res_copy.ok, dwarf: dwarf};
    m.adopted   = opt[*Language].some{res_row.ok};
    m.language  = m.adopted;
    ret err[Error].ok{};
}

fun adopted_dnit(m: *Module) err[allocator.Error] {
    val opt_held: opt[*Language] = m.adopted;
    if (sel opt_held.none) { ret err[allocator.Error].ok{}; }
    m.adopted = opt[*Language].none{};
    var err_failed: err[allocator.Error] = slice.view_free(m.a, opt_held.some.name);
    keep(?err_failed, allocator.deallocate[Language](m.a, opt_held.some, 1));
    ret err_failed;
}

# the source language the module states, or none
pub fun language(m: *Module) opt[*Language] {
    ret m.language;
}

# the interner the module's names are in: its own, or the one a compilation holds them in while it does
pub fun names(m: *Module) *Interner {
    if (sel m.lent.some) { ret m.lent.some; }
    ret ?m.names;
}

# the handle of the name `name` in the module's names, interned once, by which a function or global is declared. an
# empty name is refused
pub fun intern_name(m: *Module, name: View) res[Id[Name], Error] {
    if (name.len == 0) { ret res[Id[Name], Error].err{Error.name{}}; }
    val res_intern: res[Id[Name], Fail] = intern.intern(names(m), name.data, name.len);
    if (sel res_intern.err) { ret res[Id[Name], Error].err{Error.alloc{refusal(res_intern.err)}}; }
    ret res[Id[Name], Error].ok{res_intern.ok};
}

# the bytes of the name `n`, valid until the module's names grow or a compilation takes them, empty for a handle the
# module's names hold none of
pub fun name_of(m: *Module, n: Id[Name]) View {
    val held: *Interner = names(m);
    if (n.index::usize >= intern.count(held)) { ret View{data: nil, len: 0}; }
    ret intern.bytes_of(held, n);
}

# the module's names handed over, as a compilation hands them to the object it makes, the module holding an empty set
# in their place. the compilation states where it keeps them with `lent_to` while it runs, and ends the lend with
# `returned` when it is refused or `spent` when its object keeps them, after which the module names nothing
pub fun lend(m: *Module) Interner {
    val out: Interner = m.names;
    m.names = intern.init(m.a);
    ret out;
}

# the module's names are read from `at`, where a compilation holds them
pub fun lent_to(m: *Module, at: *Interner) {
    m.lent = opt[*Interner].some{at};
}

# the module's names given back by a refused compilation, which may hold more names than it was lent
pub fun returned(m: *Module, names: Interner) {
    val err_dropped: err[Fail] = intern.dnit(?m.names);
    m.names = names;
    m.lent  = opt[*Interner].none{};
}

# the module's names taken back from the object `o` they were lent to, which keeps an empty set in their place, as a
# refused compilation leaves the module naming what it declared
pub fun take_back(m: *Module, o: *object.Object) {
    val kept: Interner = o.names;
    o.names = intern.init(o.a);
    returned(m, kept);
}

# the lend ended with the module's names kept by the object a compilation made, so the module names nothing
pub fun spent(m: *Module) {
    m.lent = opt[*Interner].none{};
}

# the function or global the handle `n` names, or none
pub fun symbol_of(m: *Module, n: Id[Name]) opt[Symbol] {
    if (n.index::usize >= m.symbols.len) { ret opt[Symbol].none{}; }
    ret m.symbols.data[n.index];
}

# the function or global a symbol name names, or none
pub fun find(m: *Module, name: View) opt[Symbol] {
    val opt_find: opt[Id[Name]] = intern.find(names(m), name.data, name.len);
    if (sel opt_find.none) { ret opt[Symbol].none{}; }
    ret symbol_of(m, opt_find.some);
}

# refuse a handle the module's names hold none of, and a name some function or global already has
fun free(m: *Module, n: Id[Name]) err[Error] {
    if (n.index::usize >= intern.count(names(m))) { ret err[Error].err{Error.name{}}; }
    val opt_found: opt[Symbol] = symbol_of(m, n);
    if (sel opt_found.some) { ret err[Error].err{Error.taken{opt_found.some}}; }
    ret err[Error].ok{};
}

# forget the symbol of a name, as a rollback of its declaration does
pub fun unindex(m: *Module, n: Id[Name]) {
    if (n.index::usize < m.symbols.len) { m.symbols.data[n.index] = opt[Symbol].none{}; }
}

# index a symbol by its name
fun index(m: *Module, n: Id[Name], s: Symbol) err[allocator.Error] {
    for (m.symbols.len <= n.index::usize) {
        val res_grown: res[usize, allocator.Error] = vector.push[opt[Symbol]](?m.symbols, opt[Symbol].none{});
        if (sel res_grown.err) { ret err[allocator.Error].err{res_grown.err}; }
    }
    m.symbols.data[n.index] = opt[Symbol].some{s};
    ret err[allocator.Error].ok{};
}

# the allocator's refusal a refusal of the module's names carries, which can be no other
fun refusal(f: Fail) allocator.Error {
    val c: mink_fail.Cause = f.cause;
    if (sel c.refused) { ret c.refused; }
    ret allocator.Error.exhausted{};
}

fun shape(m: *Module, ty: Type) res[type_table.Shape, Error] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?m.types, ty);
    if (sel res_shape.err) { ret res[type_table.Shape, Error].err{Error.types{res_shape.err}}; }
    ret res[type_table.Shape, Error].ok{res_shape.ok};
}

fun power_of_two(a: u64) bool {
    ret a != 0 && (a & (a - 1)) == 0;
}

# whether `secrets` is a statement of the secret parameters a signature of `params` parameters may take: none, or one
# per parameter, each of whose range lists is one a global may state
pub fun stated_secrets(secrets: Slice[global.Secrecy], params: usize) bool {
    if (secrets.size == 0)      { ret true; }
    if (secrets.size != params) { ret false; }
    var i: usize = 0;
    for (i < secrets.size) {
        val s: global.Secrecy = secrets.data[i];
        if (sel s.ranges) {
            if (!global.canonical(s.ranges)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# whether `s` is a statement of the secret result a signature of `results` results may take: public for none, and a
# range list a global may state
pub fun stated_result(s: global.Secrecy, results: usize) bool {
    if (results == 0) { ret sel s.public; }
    if (sel s.ranges) { ret global.canonical(s.ranges); }
    ret true;
}

# whether `list` is a statement of the public pointers a signature of `params` parameters may take: positions below
# `params`, ascending
pub fun stated_pointers(list: Slice[u32], params: usize) bool {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i]::usize >= params)             { ret false; }
        if (i > 0 && list.data[i] <= list.data[i - 1]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a copy of a statement of secret parameters the caller owns, the list and each range list
pub fun copy_secrets(a: *allocator.Allocator, secrets: Slice[global.Secrecy]) res[Slice[global.Secrecy], allocator.Error] {
    val res_list: res[Slice[global.Secrecy], allocator.Error] = slice.copy[global.Secrecy](a, secrets);
    if (sel res_list.err) { ret res_list; }
    var i: usize = 0;
    for (i < secrets.size) {
        val s: global.Secrecy = secrets.data[i];
        if (sel s.ranges) {
            val res_ranges: res[Slice[global.Range], allocator.Error] = slice.copy[global.Range](a, s.ranges);
            if (sel res_ranges.err) {
                var k: usize = 0;
                for (k < i) {
                    val held: global.Secrecy = res_list.ok.data[k];
                    if (sel held.ranges) { slice.free[global.Range](a, held.ranges); }
                    k = k + 1;
                }
                slice.free[global.Secrecy](a, res_list.ok);
                ret res[Slice[global.Secrecy], allocator.Error].err{res_ranges.err};
            }
            res_list.ok.data[i] = global.Secrecy.ranges{res_ranges.ok};
        }
        i = i + 1;
    }
    ret res_list;
}

# a copy of one statement of secrecy the caller owns, its range list included
pub fun copy_secrecy(a: *allocator.Allocator, s: global.Secrecy) res[global.Secrecy, allocator.Error] {
    if (!(sel s.ranges)) { ret res[global.Secrecy, allocator.Error].ok{s}; }
    val res_ranges: res[Slice[global.Range], allocator.Error] = slice.copy[global.Range](a, s.ranges);
    if (sel res_ranges.err) { ret res[global.Secrecy, allocator.Error].err{res_ranges.err}; }
    ret res[global.Secrecy, allocator.Error].ok{global.Secrecy.ranges{res_ranges.ok}};
}

# give back a statement of secrecy copied by `copy_secrecy`
pub fun secrecy_dnit(a: *allocator.Allocator, s: global.Secrecy) err[allocator.Error] {
    if (sel s.ranges) { ret slice.free[global.Range](a, s.ranges); }
    ret err[allocator.Error].ok{};
}

# give back a statement of secret parameters copied by `copy_secrets`
pub fun secrets_dnit(a: *allocator.Allocator, secrets: Slice[global.Secrecy]) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (i < secrets.size) {
        val s: global.Secrecy = secrets.data[i];
        if (sel s.ranges) { keep(?err_failed, slice.free[global.Range](a, s.ranges)); }
        i = i + 1;
    }
    keep(?err_failed, slice.free[global.Secrecy](a, secrets));
    ret err_failed;
}

# declare a function, with an empty body
# ---
# m:    the module
# data: what it is declared as, by a name of the module's names, whose extensions, section, secret parameters, secret
#       result and public pointers are copied
# ret:  its id, or why it was refused
pub fun add_function(m: *Module, data: FunctionData) res[Function, Error] {
    val err_unused: err[Error] = free(m, data.name);
    if (sel err_unused.err) { ret res[Function, Error].err{err_unused.err}; }
    val err_rows: err[Error] = stated(data.linkage);
    if (sel err_rows.err) { ret res[Function, Error].err{err_rows.err}; }
    val res_shape: res[type_table.Shape, Error] = shape(m, data.signature);
    if (sel res_shape.err)            { ret res[Function, Error].err{res_shape.err}; }
    if (!(sel res_shape.ok.function)) { ret res[Function, Error].err{Error.mismatch{data.signature}}; }
    if (sel data.alignment.some) {
        val align: u64 = data.alignment.some;
        if (!power_of_two(align)) { ret res[Function, Error].err{Error.alignment{align}}; }
    }
    if (sel data.section.some) {
        if (data.section.some.name.len == 0)          { ret res[Function, Error].err{Error.name{}}; }
        if (!global.kind_row(data.section.some.kind)) { ret res[Function, Error].err{Error.section{}}; }
    }
    if (!stated_secrets(data.secrets, res_shape.ok.function.params.size))   { ret res[Function, Error].err{Error.secrecy{}}; }
    if (!stated_result(data.result, res_shape.ok.function.results.size))    { ret res[Function, Error].err{Error.secrecy{}}; }
    if (!stated_pointers(data.pointers, res_shape.ok.function.params.size)) { ret res[Function, Error].err{Error.secrecy{}}; }
    val res_secrets: res[Slice[global.Secrecy], allocator.Error] = copy_secrets(m.a, data.secrets);
    if (sel res_secrets.err) { ret res[Function, Error].err{Error.alloc{res_secrets.err}}; }
    val res_copy_secrecy: res[global.Secrecy, allocator.Error] = copy_secrecy(m.a, data.result);
    if (sel res_copy_secrecy.err) {
        secrets_dnit(m.a, res_secrets.ok);
        ret res[Function, Error].err{Error.alloc{res_copy_secrecy.err}};
    }
    val res_pointers: res[Slice[u32], allocator.Error] = slice.copy[u32](m.a, data.pointers);
    if (sel res_pointers.err) {
        secrets_dnit(m.a, res_secrets.ok);
        secrecy_dnit(m.a, res_copy_secrecy.ok);
        ret res[Function, Error].err{Error.alloc{res_pointers.err}};
    }
    val res_extensions: res[Slice[View], allocator.Error] = slice.copy_views(m.a, data.extensions);
    if (sel res_extensions.err) {
        secrets_dnit(m.a, res_secrets.ok);
        secrecy_dnit(m.a, res_copy_secrecy.ok);
        slice.free[u32](m.a, res_pointers.ok);
        ret res[Function, Error].err{Error.alloc{res_extensions.err}};
    }
    var opt_placed: opt[global.Section] = opt[global.Section].none{};
    if (sel data.section.some) {
        val res_section: res[View, allocator.Error] = slice.copy_view(m.a, data.section.some.name);
        if (sel res_section.err) {
            slice.views_dnit(m.a, res_extensions.ok);
            secrets_dnit(m.a, res_secrets.ok);
            secrecy_dnit(m.a, res_copy_secrecy.ok);
            slice.free[u32](m.a, res_pointers.ok);
            ret res[Function, Error].err{Error.alloc{res_section.err}};
        }
        opt_placed = opt[global.Section].some{global.Section{name: res_section.ok, kind: data.section.some.kind}};
    }

    var n: function.Node;
    n.data              = data;
    n.data.extensions   = res_extensions.ok;
    n.data.section      = opt_placed;
    n.data.secrets      = res_secrets.ok;
    n.data.result       = res_copy_secrecy.ok;
    n.data.pointers     = res_pointers.ok;
    n.attributes        = vector.init[Attribute](m.a);
    n.body.blocks       = vector.init[BlockData](m.a);
    n.body.values       = vector.init[ValueData](m.a);
    n.body.instructions = vector.init[InstructionData](m.a);
    n.body.constants    = map.init[u32, Value](m.a);
    n.body.points       = vector.init[Point](m.a);
    n.body.lists        = pool.init[Value](m.a);
    n.body.immediates   = pool.init[Immediate](m.a);
    n.body.edges        = pool.init[Edge](m.a);
    n.body.contents     = given.init(m.a);
    n.body.marks        = function.Marks{epoch: 0, instructions: vector.init[u32](m.a), values: vector.init[u32](m.a)};
    val id:         Function                    = (m.functions.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[function.Node](?m.functions, n);
    if (sel res_pushed.err) {
        slice.views_dnit(m.a, res_extensions.ok);
        secrets_dnit(m.a, res_secrets.ok);
        secrecy_dnit(m.a, res_copy_secrecy.ok);
        slice.free[u32](m.a, res_pointers.ok);
        if (sel opt_placed.some) { slice.view_free(m.a, opt_placed.some.name); }
        ret res[Function, Error].err{Error.alloc{res_pushed.err}};
    }
    val err_indexed: err[allocator.Error] = index(m, data.name, Symbol.function{id});
    if (sel err_indexed.err) {
        vector.pop[function.Node](?m.functions);
        slice.views_dnit(m.a, res_extensions.ok);
        secrets_dnit(m.a, res_secrets.ok);
        secrecy_dnit(m.a, res_copy_secrecy.ok);
        slice.free[u32](m.a, res_pointers.ok);
        if (sel opt_placed.some) { slice.view_free(m.a, opt_placed.some.name); }
        ret res[Function, Error].err{Error.alloc{err_indexed.err}};
    }
    ret res[Function, Error].ok{id};
}

# state a declaration a call through a value trusts its callee to keep, as a function's declaration is: its name, a
# handle of the module's names, only spells it in a refusal and names no symbol, so nothing is emitted for it, and
# its linkage, extensions, alignment, section and loader priority state nothing
# ---
# m:    the module
# data: the declaration, whose signature, constant-time mode, secret parameters, secret result, public pointers and
#       `follows` are copied
# ret:  its id, or why it was refused
pub fun add_stated(m: *Module, data: FunctionData) res[Stated, Error] {
    val res_shape: res[type_table.Shape, Error] = shape(m, data.signature);
    if (sel res_shape.err)                                                  { ret res[Stated, Error].err{res_shape.err}; }
    if (!(sel res_shape.ok.function))                                       { ret res[Stated, Error].err{Error.mismatch{data.signature}}; }
    if (!stated_secrets(data.secrets, res_shape.ok.function.params.size))   { ret res[Stated, Error].err{Error.secrecy{}}; }
    if (!stated_result(data.result, res_shape.ok.function.results.size))    { ret res[Stated, Error].err{Error.secrecy{}}; }
    if (!stated_pointers(data.pointers, res_shape.ok.function.params.size)) { ret res[Stated, Error].err{Error.secrecy{}}; }
    val res_secrets: res[Slice[global.Secrecy], allocator.Error] = copy_secrets(m.a, data.secrets);
    if (sel res_secrets.err) { ret res[Stated, Error].err{Error.alloc{res_secrets.err}}; }
    val res_copy_secrecy: res[global.Secrecy, allocator.Error] = copy_secrecy(m.a, data.result);
    if (sel res_copy_secrecy.err) {
        secrets_dnit(m.a, res_secrets.ok);
        ret res[Stated, Error].err{Error.alloc{res_copy_secrecy.err}};
    }
    val res_pointers: res[Slice[u32], allocator.Error] = slice.copy[u32](m.a, data.pointers);
    if (sel res_pointers.err) {
        secrets_dnit(m.a, res_secrets.ok);
        secrecy_dnit(m.a, res_copy_secrecy.ok);
        ret res[Stated, Error].err{Error.alloc{res_pointers.err}};
    }
    var kept: FunctionData = FunctionData{name: data.name, signature: data.signature, linkage: linkage.local(), constant_time: data.constant_time,
        extensions: Slice[View]{data: nil, size: 0}, alignment: opt[u64].none{}, section: opt[global.Section].none{}, init: opt[u32].none{},
        secrets:    res_secrets.ok, result: res_copy_secrecy.ok, pointers: res_pointers.ok, follows: data.follows};
    val id:         Stated                      = m.stated.len::u32;
    val res_pushed: res[usize, allocator.Error] = vector.push[FunctionData](?m.stated, kept);
    if (sel res_pushed.err) {
        declaration_dnit(m.a, kept);
        ret res[Stated, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Stated, Error].ok{id};
}

# the declaration `d` names, of a function of the module or stated by a call, valid until the module changes
pub fun declaration(m: *Module, d: Declared) *FunctionData {
    if (sel d.function) { ret ?m.functions.data[d.function].data; }
    ret ?m.stated.data[d.stated];
}

# what a function is declared as
pub fun function_data(m: *Module, f: Function) res[FunctionData, Error] {
    if (f::usize >= m.functions.len) { ret res[FunctionData, Error].err{Error.function{f}}; }
    ret res[FunctionData, Error].ok{m.functions.data[f].data};
}

# the body of a function, for the body's edits
pub fun body(m: *Module, f: Function) res[*function.Body, Error] {
    if (f::usize >= m.functions.len) { ret res[*function.Body, Error].err{Error.function{f}}; }
    ret res[*function.Body, Error].ok{?m.functions.data[f].body};
}

# the size of a module's code
# ---
# functions:    the functions with a body
# instructions: the instructions placed in the blocks of those bodies that
#               were not erased
pub rec Size {
    functions:    usize;
    instructions: usize;
}

# the size of a module's code as it stands
pub fun size(m: *Module) Size {
    var out: Size  = Size{functions: 0, instructions: 0};
    var k:   usize = 0;
    for (k < m.functions.len) {
        val b: *function.Body = ?m.functions.data[k].body;
        if (b.blocks.len > 0) { out.functions = out.functions + 1; }
        var i: usize = 0;
        for (i < b.instructions.len) {
            if (sel b.instructions.data[i].place.placed) { out.instructions = out.instructions + 1; }
            i = i + 1;
        }
        k = k + 1;
    }
    ret out;
}

# the type of a constant
pub fun constant_type(m: *Module, c: Constant) res[Type, Error] {
    if (c::usize >= m.constants.len) { ret res[Type, Error].err{Error.constant{c}}; }
    val d: ConstantData = m.constants.data[c];
    if (sel d.integer)   { ret res[Type, Error].ok{d.integer.type}; }
    or (sel d.float)     { ret res[Type, Error].ok{d.float.type}; }
    or (sel d.zero)      { ret res[Type, Error].ok{d.zero}; }
    or (sel d.aggregate) { ret res[Type, Error].ok{d.aggregate.type}; }
    or (sel d.spec)      { ret res[Type, Error].ok{d.spec.default.type}; }
    or (sel d.bytes)     { ret res[Type, Error].ok{d.bytes.type}; }
    ret res[Type, Error].ok{d.address.type};
}

# what a constant holds in memory, as its placement reads it
# ---
# zeros:     every bit zero
# bytes:     bits not all zero, or bits its consumer sets, and no address
# addresses: an address of a symbol, which a relocation fills
pub tag Contents: u8 {
    zeros;
    bytes;
    addresses;
}

fun any_word(b: Bits) bool {
    var i: usize = 0;
    for (i < b.words.size) {
        if (b.words.data[i] != 0) { ret true; }
        i = i + 1;
    }
    ret false;
}

# what a constant holds in memory, its elements' at any depth
pub fun contents(m: *Module, c: Constant) res[Contents, Error] {
    if (c::usize >= m.constants.len) { ret res[Contents, Error].err{Error.constant{c}}; }
    val d: ConstantData = m.constants.data[c];
    # a distance between two symbols of one image is fixed by the link, so no loader relocates it
    if (sel d.address && sel d.address.minus.some) { ret res[Contents, Error].ok{Contents.bytes{}}; }
    if (sel d.address)                             { ret res[Contents, Error].ok{Contents.addresses{}}; }
    if (sel d.zero)                                { ret res[Contents, Error].ok{Contents.zeros{}}; }
    if (sel d.spec)                                { ret res[Contents, Error].ok{Contents.bytes{}}; }
    if (sel d.integer) {
        if (any_word(d.integer)) { ret res[Contents, Error].ok{Contents.bytes{}}; }
        ret res[Contents, Error].ok{Contents.zeros{}};
    }
    if (sel d.float) {
        if (any_word(d.float)) { ret res[Contents, Error].ok{Contents.bytes{}}; }
        ret res[Contents, Error].ok{Contents.zeros{}};
    }
    if (sel d.bytes) {
        var k: usize = 0;
        for (k < d.bytes.data.size) {
            if (d.bytes.data.data[k] != 0) { ret res[Contents, Error].ok{Contents.bytes{}}; }
            k = k + 1;
        }
        ret res[Contents, Error].ok{Contents.zeros{}};
    }
    var held: Contents = Contents.zeros{};
    if (sel d.aggregate) {
        val list: Slice[Constant] = d.aggregate.elements;
        var i:    usize           = 0;
        for (i < list.size) {
            val res_contents: res[Contents, Error] = contents(m, list.data[i]);
            if (sel res_contents.err)          { ret res_contents; }
            if (sel res_contents.ok.addresses) { ret res_contents; }
            if (sel res_contents.ok.bytes)     { held = res_contents.ok; }
            i = i + 1;
        }
    }
    ret res[Contents, Error].ok{held};
}

# what a constant is, its lists valid for the life of the module
pub fun constant_data(m: *Module, c: Constant) res[ConstantData, Error] {
    if (c::usize >= m.constants.len) { ret res[ConstantData, Error].err{Error.constant{c}}; }
    ret res[ConstantData, Error].ok{m.constants.data[c]};
}

# whether a constant's value is its consumer's to set: a specialization
# constant, or an aggregate that holds one at any depth
pub fun specialized(m: *Module, c: Constant) bool {
    if (c::usize >= m.constants.len) { ret false; }
    val d: ConstantData = m.constants.data[c];
    if (sel d.spec) { ret true; }
    if (sel d.aggregate) {
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            if (specialized(m, d.aggregate.elements.data[i])) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

# the first specialization constant of an id, none when the module has none
pub fun specialization(m: *Module, id: u32) opt[Constant] {
    var i: usize = 0;
    for (i < m.constants.len) {
        val d: ConstantData = m.constants.data[i];
        if (sel d.spec) {
            if (d.spec.id == id) { ret opt[Constant].some{(i::u32)}; }
        }
        i = i + 1;
    }
    ret opt[Constant].none{};
}

fun known(m: *Module, s: Symbol) err[Error] {
    if (sel s.function) {
        if (s.function::usize >= m.functions.len) { ret err[Error].err{Error.function{s.function}}; }
        ret err[Error].ok{};
    }
    if (s.global::usize >= m.globals.len) { ret err[Error].err{Error.global{s.global}}; }
    ret err[Error].ok{};
}

# refuse bits that have not exactly the words a width needs, or that set a bit above it
fun fits(b: Bits, width: u32) err[Error] {
    val words: usize = ((width + 63) / 64)::usize;
    if (b.words.size != words) { ret err[Error].err{Error.words{}}; }
    val spare: u32 = width % 64;
    if (spare != 0 && (b.words.data[words - 1] >> spare::u64) != 0) { ret err[Error].err{Error.words{}}; }
    ret err[Error].ok{};
}

fun element_type(s: type_table.Shape, i: usize) Type {
    if (sel s.structure) { ret s.structure.members.data[i]; }
    or (sel s.array)     { ret s.array.element; }
    or (sel s.vector)    { ret s.vector.element; }
    ret 0xffffffff;
}

# whether a constant is well formed in a module: its words fit its type, an
# aggregate's elements are constants of its members' types, a run of bytes is
# an array of 8-bit integers as long as the run, an address names functions
# or globals of the module and is a pointer, or an integer of 32 or 64 bits,
# only an integer taking a symbol's address away, and a specialization constant's default is an
# integer or float of its type
# ---
# m:   the module
# d:   the constant
# ret: ok, or why it is refused
fun check_constant(m: *Module, d: *ConstantData) err[Error] {
    if (sel d.integer) {
        val res_shape: res[type_table.Shape, Error] = shape(m, d.integer.type);
        if (sel res_shape.err)           { ret err[Error].err{res_shape.err}; }
        if (!(sel res_shape.ok.integer)) { ret err[Error].err{Error.mismatch{d.integer.type}}; }
        ret fits(d.integer, res_shape.ok.integer.width);
    }
    or (sel d.float) {
        val res_float_width: res[u32, Error] = float_width(m, d.float.type);
        if (sel res_float_width.err) { ret err[Error].err{res_float_width.err}; }
        ret fits(d.float, res_float_width.ok);
    }
    or (sel d.zero) {
        val res_shape: res[type_table.Shape, Error] = shape(m, d.zero);
        if (sel res_shape.err) { ret err[Error].err{res_shape.err}; }
        ret err[Error].ok{};
    }
    or (sel d.spec) {
        val b:         Bits                         = d.spec.default;
        val res_shape: res[type_table.Shape, Error] = shape(m, b.type);
        if (sel res_shape.err)         { ret err[Error].err{res_shape.err}; }
        if (sel res_shape.ok.integer)  { ret fits(b, res_shape.ok.integer.width); }
        if (!(sel res_shape.ok.float)) { ret err[Error].err{Error.mismatch{b.type}}; }
        val res_float_width: res[u32, Error] = float_width(m, b.type);
        if (sel res_float_width.err) { ret err[Error].err{res_float_width.err}; }
        ret fits(b, res_float_width.ok);
    }
    or (sel d.aggregate) {
        val a:         Aggregate                    = d.aggregate;
        val res_shape: res[type_table.Shape, Error] = shape(m, a.type);
        if (sel res_shape.err) { ret err[Error].err{res_shape.err}; }
        var count: u64 = 0;
        if (sel res_shape.ok.structure)    { count = res_shape.ok.structure.members.size::u64; }
        or (sel res_shape.ok.array)        { count = res_shape.ok.array.count; }
        or (sel res_shape.ok.vector)       { count = res_shape.ok.vector.lanes::u64; }
        or                                 { ret err[Error].err{Error.mismatch{a.type}}; }
        if (a.elements.size::u64 != count) { ret err[Error].err{Error.elements{a.elements.size::u32}}; }
        var i: usize = 0;
        for (i < a.elements.size) {
            val res_constant_type: res[Type, Error] = constant_type(m, a.elements.data[i]);
            if (sel res_constant_type.err)                                             { ret err[Error].err{res_constant_type.err}; }
            if (!type_table.same(res_constant_type.ok, element_type(res_shape.ok, i))) { ret err[Error].err{Error.element{i::u32}}; }
            i = i + 1;
        }
        ret err[Error].ok{};
    }
    or (sel d.bytes) {
        val res_shape: res[type_table.Shape, Error] = shape(m, d.bytes.type);
        if (sel res_shape.err)         { ret err[Error].err{res_shape.err}; }
        if (!(sel res_shape.ok.array)) { ret err[Error].err{Error.mismatch{d.bytes.type}}; }
        val res_shape_element: res[type_table.Shape, Error] = shape(m, res_shape.ok.array.element);
        if (sel res_shape_element.err)                          { ret err[Error].err{res_shape_element.err}; }
        if (!(sel res_shape_element.ok.integer))                { ret err[Error].err{Error.mismatch{d.bytes.type}}; }
        if (res_shape_element.ok.integer.width != 8)            { ret err[Error].err{Error.mismatch{d.bytes.type}}; }
        if (d.bytes.data.size::u64 != res_shape.ok.array.count) { ret err[Error].err{Error.elements{d.bytes.data.size::u32}}; }
        ret err[Error].ok{};
    }
    val res_shape: res[type_table.Shape, Error] = shape(m, d.address.type);
    if (sel res_shape.err) { ret err[Error].err{res_shape.err}; }
    if (sel res_shape.ok.integer) {
        if (res_shape.ok.integer.width != 32 && res_shape.ok.integer.width != 64) { ret err[Error].err{Error.mismatch{d.address.type}}; }
        if (sel d.address.minus.some) {
            val err_less: err[Error] = known(m, d.address.minus.some);
            if (sel err_less.err) { ret err_less; }
        }
        ret known(m, d.address.symbol);
    }
    if (!(sel res_shape.ok.pointer) || sel d.address.minus.some) { ret err[Error].err{Error.mismatch{d.address.type}}; }
    ret known(m, d.address.symbol);
}

fun float_width(m: *Module, ty: Type) res[u32, Error] {
    val res_format: res[format.Format, type_table.Error] = type_table.format(?m.types, ty);
    if (sel res_format.err) { ret res[u32, Error].err{Error.types{res_format.err}}; }
    val opt_row: opt[format.Row] = format.row(res_format.ok);
    if (sel opt_row.none) { ret res[u32, Error].err{Error.mismatch{ty}}; }
    ret res[u32, Error].ok{opt_row.some.width};
}

# add a constant
# ---
# m:    the module
# data: the constant, whose lists are copied
# ret:  its id, or why it was refused
pub fun add_constant(m: *Module, data: ConstantData) res[Constant, Error] {
    val err_checked: err[Error] = check_constant(m, ?data);
    if (sel err_checked.err) { ret res[Constant, Error].err{err_checked.err}; }

    var owned: ConstantData = data;
    if (sel data.integer) {
        val res_copy: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, data.integer.words);
        if (sel res_copy.err) { ret res[Constant, Error].err{Error.alloc{res_copy.err}}; }
        owned = ConstantData.integer{Bits{type: data.integer.type, words: res_copy.ok}};
    }
    or (sel data.float) {
        val res_copy: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, data.float.words);
        if (sel res_copy.err) { ret res[Constant, Error].err{Error.alloc{res_copy.err}}; }
        owned = ConstantData.float{Bits{type: data.float.type, words: res_copy.ok}};
    }
    or (sel data.aggregate) {
        val res_copy: res[Slice[Constant], allocator.Error] = slice.copy[Constant](m.a, data.aggregate.elements);
        if (sel res_copy.err) { ret res[Constant, Error].err{Error.alloc{res_copy.err}}; }
        owned = ConstantData.aggregate{Aggregate{type: data.aggregate.type, elements: res_copy.ok}};
    }
    or (sel data.spec) {
        val res_copy: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, data.spec.default.words);
        if (sel res_copy.err) { ret res[Constant, Error].err{Error.alloc{res_copy.err}}; }
        owned = ConstantData.spec{Spec{id: data.spec.id, default: Bits{type: data.spec.default.type, words: res_copy.ok}}};
    }
    or (sel data.bytes) {
        val res_copy: res[Slice[u8], allocator.Error] = slice.copy[u8](m.a, data.bytes.data);
        if (sel res_copy.err) { ret res[Constant, Error].err{Error.alloc{res_copy.err}}; }
        owned = ConstantData.bytes{Bytes{type: data.bytes.type, data: res_copy.ok}};
    }

    val id:         Constant                    = (m.constants.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[ConstantData](?m.constants, owned);
    if (sel res_pushed.err) {
        if (sel owned.integer)   { slice.free[u64](m.a, owned.integer.words); }
        if (sel owned.float)     { slice.free[u64](m.a, owned.float.words); }
        if (sel owned.aggregate) { slice.free[Constant](m.a, owned.aggregate.elements); }
        if (sel owned.spec)      { slice.free[u64](m.a, owned.spec.default.words); }
        if (sel owned.bytes)     { slice.free[u8](m.a, owned.bytes.data); }
        ret res[Constant, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Constant, Error].ok{id};
}

# refuse a linkage that is not made of mink's symbol rows
fun stated(l: Linkage) err[Error] {
    if (!linkage.binding_row(l.binding))       { ret err[Error].err{Error.linkage{}}; }
    if (!linkage.visibility_row(l.visibility)) { ret err[Error].err{Error.visibility{}}; }
    ret err[Error].ok{};
}

# add a global
# ---
# m:    the module
# data: the global, by a name of the module's names, whose section and secret ranges are copied, and whose debug binding the verifier holds to an
#       entry of the debug table
# ret:  its id, or why it was refused
pub fun add_global(m: *Module, data: GlobalData) res[Global, Error] {
    val err_unused: err[Error] = free(m, data.name);
    if (sel err_unused.err) { ret res[Global, Error].err{err_unused.err}; }
    val err_rows: err[Error] = stated(data.linkage);
    if (sel err_rows.err) { ret res[Global, Error].err{err_rows.err}; }
    val res_shape: res[type_table.Shape, Error] = shape(m, data.type);
    if (sel res_shape.err) { ret res[Global, Error].err{res_shape.err}; }
    if (sel data.initial.some) {
        val res_constant_type: res[Type, Error] = constant_type(m, data.initial.some);
        if (sel res_constant_type.err)                         { ret res[Global, Error].err{res_constant_type.err}; }
        if (!type_table.same(res_constant_type.ok, data.type)) { ret res[Global, Error].err{Error.mismatch{res_constant_type.ok}}; }
    }
    if (sel data.alignment.some) {
        val align: u64 = data.alignment.some;
        if (!power_of_two(align)) { ret res[Global, Error].err{Error.alignment{align}}; }
    }
    if (sel data.section.some) {
        if (data.section.some.name.len == 0)          { ret res[Global, Error].err{Error.name{}}; }
        if (!global.kind_row(data.section.some.kind)) { ret res[Global, Error].err{Error.section{}}; }
    }
    if (sel data.secret.ranges) {
        if (!global.canonical(data.secret.ranges)) { ret res[Global, Error].err{Error.secrecy{}}; }
    }

    var n: global.Node;
    n.data       = data;
    n.attributes = vector.init[Attribute](m.a);
    if (sel data.section.some) {
        val res_section: res[View, allocator.Error] = slice.copy_view(m.a, data.section.some.name);
        if (sel res_section.err) {
            ret res[Global, Error].err{Error.alloc{res_section.err}};
        }
        n.data.section = opt[global.Section].some{global.Section{name: res_section.ok, kind: data.section.some.kind}};
    }
    if (sel data.secret.ranges) {
        val res_ranges: res[Slice[global.Range], allocator.Error] = slice.copy[global.Range](m.a, data.secret.ranges);
        if (sel res_ranges.err) {
            if (sel n.data.section.some) { slice.view_free(m.a, n.data.section.some.name); }
            ret res[Global, Error].err{Error.alloc{res_ranges.err}};
        }
        n.data.secret = global.Secrecy.ranges{res_ranges.ok};
    }
    val id:         Global                      = (m.globals.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[global.Node](?m.globals, n);
    if (sel res_pushed.err) {
        unowned(m.a, ?n.data);
        ret res[Global, Error].err{Error.alloc{res_pushed.err}};
    }
    val err_indexed: err[allocator.Error] = index(m, n.data.name, Symbol.global{id});
    if (sel err_indexed.err) {
        vector.pop[global.Node](?m.globals);
        unowned(m.a, ?n.data);
        ret res[Global, Error].err{Error.alloc{err_indexed.err}};
    }
    ret res[Global, Error].ok{id};
}

# give back the section and secret ranges a global refused after they were copied owns
fun unowned(a: *allocator.Allocator, d: *GlobalData) {
    if (sel d.section.some)  { slice.view_free(a, d.section.some.name); }
    if (sel d.secret.ranges) { slice.free[global.Range](a, d.secret.ranges); }
}

# state the source variable a global is, or that none describes it
# ---
# m:   the module
# g:   the global
# b:   a binding of the module's debug table, which the verifier holds to one, or none
# ret: ok, or why it was refused
pub fun describe_global(m: *Module, g: Global, b: opt[Binding]) err[Error] {
    if (g::usize >= m.globals.len) { ret err[Error].err{Error.global{g}}; }
    m.globals.data[g].data.debug = b;
    ret err[Error].ok{};
}

# what a global is, its names valid for the life of the module
pub fun global_data(m: *Module, g: Global) res[GlobalData, Error] {
    if (g::usize >= m.globals.len) { ret res[GlobalData, Error].err{Error.global{g}}; }
    ret res[GlobalData, Error].ok{m.globals.data[g].data};
}

# give a global its initial value, in place of any it had
# ---
# m:   the module
# g:   the global
# c:   a constant of the global's type
# ret: ok, or why it was refused
pub fun initialize(m: *Module, g: Global, c: Constant) err[Error] {
    if (g::usize >= m.globals.len) { ret err[Error].err{Error.global{g}}; }
    val res_constant_type: res[Type, Error] = constant_type(m, c);
    if (sel res_constant_type.err)                                           { ret err[Error].err{res_constant_type.err}; }
    if (!type_table.same(res_constant_type.ok, m.globals.data[g].data.type)) { ret err[Error].err{Error.mismatch{res_constant_type.ok}}; }
    m.globals.data[g].data.initial = opt[Constant].some{c};
    ret err[Error].ok{};
}

fun attributes_of(m: *Module, s: Symbol) res[*vector.Vector[Attribute], Error] {
    val err_known: err[Error] = known(m, s);
    if (sel err_known.err) { ret res[*vector.Vector[Attribute], Error].err{err_known.err}; }
    if (sel s.function)    { ret res[*vector.Vector[Attribute], Error].ok{?m.functions.data[s.function].attributes}; }
    ret res[*vector.Vector[Attribute], Error].ok{?m.globals.data[s.global].attributes};
}

# attach an attribute to a function or global
# ---
# m:   the module
# s:   the function or global
# at:  the attribute, whose names and lists are copied
# ret: ok, or why it was refused
pub fun attach(m: *Module, s: Symbol, at: Attribute) err[Error] {
    val res_list: res[*vector.Vector[Attribute], Error] = attributes_of(m, s);
    if (sel res_list.err)                       { ret err[Error].err{res_list.err}; }
    if (at.family.len == 0 || at.name.len == 0) { ret err[Error].err{Error.name{}}; }

    var owned:      Attribute                  = at;
    val res_family: res[View, allocator.Error] = slice.copy_view(m.a, at.family);
    if (sel res_family.err) { ret err[Error].err{Error.alloc{res_family.err}}; }
    owned.family = res_family.ok;
    val res_name: res[View, allocator.Error] = slice.copy_view(m.a, at.name);
    if (sel res_name.err) {
        slice.view_free(m.a, owned.family);
        ret err[Error].err{Error.alloc{res_name.err}};
    }
    owned.name = res_name.ok;
    if (sel at.datum.integers) {
        val res_copy: res[Slice[u64], allocator.Error] = slice.copy[u64](m.a, at.datum.integers);
        if (sel res_copy.err) {
            slice.view_free(m.a, owned.family);
            slice.view_free(m.a, owned.name);
            ret err[Error].err{Error.alloc{res_copy.err}};
        }
        owned.datum = Datum.integers{res_copy.ok};
    }
    or (sel at.datum.text) {
        val res_copy_view: res[View, allocator.Error] = slice.copy_view(m.a, at.datum.text);
        if (sel res_copy_view.err) {
            slice.view_free(m.a, owned.family);
            slice.view_free(m.a, owned.name);
            ret err[Error].err{Error.alloc{res_copy_view.err}};
        }
        owned.datum = Datum.text{res_copy_view.ok};
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[Attribute](res_list.ok, owned);
    if (sel res_pushed.ok)        { ret err[Error].ok{}; }
    if (sel owned.datum.integers) { slice.free[u64](m.a, owned.datum.integers); }
    or (sel owned.datum.text)     { slice.view_free(m.a, owned.datum.text); }
    slice.view_free(m.a, owned.family);
    slice.view_free(m.a, owned.name);
    ret err[Error].err{Error.alloc{res_pushed.err}};
}

# the attributes attached to a function or global, valid until the next attach
pub fun attributes(m: *Module, s: Symbol) res[Slice[Attribute], Error] {
    val res_list: res[*vector.Vector[Attribute], Error] = attributes_of(m, s);
    if (sel res_list.err) { ret res[Slice[Attribute], Error].err{res_list.err}; }
    ret res[Slice[Attribute], Error].ok{Slice[Attribute]{data: res_list.ok.data, size: res_list.ok.len}};
}

# make a list of debug bindings that instructions can share
# ---
# m:    the module
# list: the bindings, which are copied
# ret:  the list's id, the empty list's when list is empty, or the allocator's
#       refusal
pub fun bindings(m: *Module, list: Slice[Binding]) res[Bindings, Error] {
    if (list.size == 0) { ret res[Bindings, Error].ok{UNBOUND}; }
    val res_owned: res[Slice[Binding], allocator.Error] = slice.copy[Binding](m.a, list);
    if (sel res_owned.err) { ret res[Bindings, Error].err{Error.alloc{res_owned.err}}; }
    val id:         Bindings                    = (m.bindings.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Slice[Binding]](?m.bindings, res_owned.ok);
    if (sel res_pushed.err) {
        slice.free[Binding](m.a, res_owned.ok);
        ret res[Bindings, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Bindings, Error].ok{id};
}

# the bindings a list holds, valid for the life of the module
pub fun bound(m: *Module, b: Bindings) res[Slice[Binding], Error] {
    if (b::usize >= m.bindings.len) { ret res[Slice[Binding], Error].err{Error.bindings{b}}; }
    ret res[Slice[Binding], Error].ok{m.bindings.data[b]};
}

# make a list of an alloca's public ranges that allocas can share
# ---
# m:    the module
# list: the ranges, which are copied: ascending, none empty, overlapping or touching another, or none for a slot of a
#       type secret in every byte
# ret:  the list's id, or why it was refused
pub fun publics(m: *Module, list: Slice[global.Range]) res[Publics, Error] {
    if (list.size != 0 && !global.canonical(list)) { ret res[Publics, Error].err{Error.secrecy{}}; }
    var res_owned: res[Slice[global.Range], allocator.Error] = res[Slice[global.Range], allocator.Error].ok{list};
    if (list.size != 0)    { res_owned = slice.copy[global.Range](m.a, list); }
    if (sel res_owned.err) { ret res[Publics, Error].err{Error.alloc{res_owned.err}}; }
    val id:         Publics                     = (m.publics.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Slice[global.Range]](?m.publics, res_owned.ok);
    if (sel res_pushed.err) {
        slice.free[global.Range](m.a, res_owned.ok);
        ret res[Publics, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Publics, Error].ok{id};
}

# the ranges a list of public ranges holds, valid for the life of the module
pub fun public_ranges(m: *Module, p: Publics) res[Slice[global.Range], Error] {
    if (p::usize >= m.publics.len) { ret res[Slice[global.Range], Error].err{Error.publics{p}}; }
    ret res[Slice[global.Range], Error].ok{m.publics.data[p]};
}

# whether a step is of a kind with a row and given the argument its row takes
fun step_formed(m: *Module, s: Step) bool {
    val opt_row: opt[point.Row] = point.row(s.kind);
    if (sel opt_row.none) { ret false; }
    val a: point.Argument = s.argument;
    if (sel opt_row.some.takes.constant) {
        if (!(sel a.constant)) { ret false; }
        ret a.constant::usize < m.constants.len;
    }
    if (!(sel a.to)) { ret false; }
    val res_shape: res[type_table.Shape, Error] = shape(m, a.to);
    ret sel res_shape.ok && sel res_shape.ok.integer;
}

# make a salvage expression that records can share
# ---
# m:     the module
# steps: its steps in order, each of a kind with a row and given what its row
#        takes, which are copied
# ret:   the expression's id, PLAIN when steps is empty, or why it was refused
pub fun expression(m: *Module, steps: Slice[Step]) res[Expression, Error] {
    if (steps.size == 0) { ret res[Expression, Error].ok{point.PLAIN}; }
    var i: usize = 0;
    for (i < steps.size) {
        if (!step_formed(m, steps.data[i])) { ret res[Expression, Error].err{Error.step{i::u32}}; }
        i = i + 1;
    }
    val res_owned: res[Slice[Step], allocator.Error] = slice.copy[Step](m.a, steps);
    if (sel res_owned.err) { ret res[Expression, Error].err{Error.alloc{res_owned.err}}; }
    val id:         Expression                  = (m.expressions.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Slice[Step]](?m.expressions, res_owned.ok);
    if (sel res_pushed.err) {
        slice.free[Step](m.a, res_owned.ok);
        ret res[Expression, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Expression, Error].ok{id};
}

# the steps an expression holds, valid for the life of the module
pub fun steps(m: *Module, e: Expression) res[Slice[Step], Error] {
    if (e::usize >= m.expressions.len) { ret res[Slice[Step], Error].err{Error.expression{e}}; }
    ret res[Slice[Step], Error].ok{m.expressions.data[e]};
}

fun integer_width(m: *Module, ty: Type) res[u32, Error] {
    val res_shape: res[type_table.Shape, Error] = shape(m, ty);
    if (sel res_shape.err)           { ret res[u32, Error].err{res_shape.err}; }
    if (!(sel res_shape.ok.integer)) { ret res[u32, Error].err{Error.mismatch{ty}}; }
    ret res[u32, Error].ok{res_shape.ok.integer.width};
}

# the type an expression gives from a value of a type, each step reading what
# the one before it gives
# ---
# m:   the module
# ty:  the type of the value it reads
# e:   the expression
# ret: the type the variable is given, or why the expression does not apply
pub fun salvaged(m: *Module, ty: Type, e: Expression) res[Type, Error] {
    val res_list: res[Slice[Step], Error] = steps(m, e);
    if (sel res_list.err) { ret res[Type, Error].err{res_list.err}; }
    var now: Type  = ty;
    var i:   usize = 0;
    for (i < res_list.ok.size) {
        val s:       Step           = res_list.ok.data[i];
        val opt_row: opt[point.Row] = point.row(s.kind);
        if (sel opt_row.none) { ret res[Type, Error].err{Error.step{i::u32}}; }
        val res_width: res[u32, Error] = integer_width(m, now);
        if (sel res_width.err) { ret res[Type, Error].err{res_width.err}; }
        val a: point.Argument = s.argument;
        if (sel a.constant) {
            val res_constant_type: res[Type, Error] = constant_type(m, a.constant);
            if (sel res_constant_type.err)                   { ret res[Type, Error].err{res_constant_type.err}; }
            if (!type_table.same(res_constant_type.ok, now)) { ret res[Type, Error].err{Error.mismatch{res_constant_type.ok}}; }
        }
        or (sel a.to) {
            val res_integer_width: res[u32, Error] = integer_width(m, a.to);
            if (sel res_integer_width.err) { ret res[Type, Error].err{res_integer_width.err}; }
            val w: point.Width = opt_row.some.width;
            if (sel w.same && res_integer_width.ok != res_width.ok)     { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            if (sel w.wider && res_integer_width.ok <= res_width.ok)    { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            if (sel w.narrower && res_integer_width.ok >= res_width.ok) { ret res[Type, Error].err{Error.mismatch{a.to}}; }
            now = a.to;
        }
        i = i + 1;
    }
    ret res[Type, Error].ok{now};
}
