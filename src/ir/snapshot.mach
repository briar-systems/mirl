# snapshots of a module, so a refused rewrite can be taken back whole
#
# a module grows by appending: functions, globals, constants, binding lists,
# salvage expressions, attributes, interned types and debug entries. a mark keeps how
# far each list reached, and a rewind takes back everything appended since,
# with the symbol name of every function and global it takes back.
#
# what changes in place is kept whole: the body of each function the mark
# reaches, each global's initial value when it reaches the module, and the
# open debug entries a definition fills. nothing else of a module changes in
# place through its edits.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.body;
use mirl.ir.constant.ConstantData;
use mirl.ir.debug;
use mirl.ir.function.Body;
use mirl.ir.function.Node;
use GlobalNode: mirl.ir.global.Node;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.module.Module;
use mirl.ir.point.Step;
use mirl.ir.type;

# what a mark keeps in place
# ---
# function: the body and attributes of one function, for a rewrite of it alone
# module:   every function's body and attributes, and every global's attributes
#           and initial value
pub tag Reach: u8 {
    function: Function;
    module;
}

# how far a module reached, and what it held in place then
# ---
# reach:       what it keeps in place
# functions:   its number of functions
# globals:     its number of globals
# constants:   its number of constants
# bindings:    its number of binding lists
# expressions: its number of salvage expressions
# types:       its type table's mark
# debug:       its debug table's mark
# bodies:      the bodies it reaches, in order
# attributes:  the attribute counts of the functions it reaches, then of every
#              global when it reaches the module
# initials:    every global's initial value when it reaches the module
pub rec Mark {
    reach:       Reach;
    functions:   usize;
    globals:     usize;
    constants:   usize;
    bindings:    usize;
    expressions: usize;
    types:       type.Mark;
    debug:       debug.Mark;
    bodies:      vector.Vector[Body];
    attributes:  vector.Vector[usize];
    initials:    vector.Vector[opt[Constant]];
}

fun alloc(e: allocator.Error) Error {
    ret Error.alloc{e};
}

fun keep_body(m: *Module, s: *Mark, f: Function) err[Error] {
    val copy: res[Body, Error] = body.copy(m, f);
    if (sel copy.err) { ret err[Error].err{copy.err}; }
    var kept:   Body                        = copy.ok;
    val pushed: res[usize, allocator.Error] = vector.push[Body](?s.bodies, kept);
    if (sel pushed.err) {
        module.release_body(m.a, ?kept);
        ret err[Error].err{alloc(pushed.err)};
    }
    val counted: res[usize, allocator.Error] = vector.push[usize](?s.attributes, m.functions.data[f.index].attributes.len);
    if (sel counted.err) { ret err[Error].err{alloc(counted.err)}; }
    ret err[Error].ok{};
}

fun keep_globals(m: *Module, s: *Mark) err[Error] {
    var i: usize = 0;
    for (i < m.globals.len) {
        val counted: res[usize, allocator.Error] = vector.push[usize](?s.attributes, m.globals.data[i].attributes.len);
        if (sel counted.err) { ret err[Error].err{alloc(counted.err)}; }
        val initial: res[usize, allocator.Error] = vector.push[opt[Constant]](?s.initials, m.globals.data[i].data.initial);
        if (sel initial.err) { ret err[Error].err{alloc(initial.err)}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun keep_module(m: *Module, s: *Mark) err[Error] {
    var i: usize = 0;
    for (i < m.functions.len) {
        val r: err[Error] = keep_body(m, s, Function{index: i::u32});
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret keep_globals(m, s);
}

# where a module reaches now, keeping in place what the mark reaches
# ---
# m:     the module
# reach: what to keep in place
# ret:   the mark, which `rewind` or `forget` gives back, or why it was
#        refused
pub fun mark(m: *Module, reach: Reach) res[Mark, Error] {
    if (sel reach.function) {
        if (reach.function.index::usize >= m.functions.len) { ret res[Mark, Error].err{Error.function{reach.function}}; }
    }
    val types: res[type.Mark, type.Error] = type.mark(?m.types);
    if (sel types.err) { ret res[Mark, Error].err{Error.types{types.err}}; }
    val marked: res[debug.Mark, debug.Error] = debug.mark(?m.debug);
    if (sel marked.err) { ret res[Mark, Error].err{Error.debug{marked.err}}; }
    var s: Mark = Mark{
        reach:       reach,
        functions:   m.functions.len,
        globals:     m.globals.len,
        constants:   m.constants.len,
        bindings:    m.bindings.len,
        expressions: m.expressions.len,
        types:       types.ok,
        debug:       marked.ok,
        bodies:      vector.init[Body](m.a),
        attributes:  vector.init[usize](m.a),
        initials:    vector.init[opt[Constant]](m.a),
    };
    var kept: err[Error];
    if (sel reach.function) { kept = keep_body(m, ?s, reach.function); }
    or                      { kept = keep_module(m, ?s); }
    if (sel kept.err) {
        forget(m, ?s);
        ret res[Mark, Error].err{kept.err};
    }
    ret res[Mark, Error].ok{s};
}

# the first refusal of a rewind or a forget, which goes on past each
fun given_back(failed: err[allocator.Error], entries: err[debug.Error], types: err[type.Error]) err[Error] {
    if (sel failed.err)  { ret err[Error].err{alloc(failed.err)}; }
    if (sel entries.err) { ret err[Error].err{Error.debug{entries.err}}; }
    if (sel types.err)   { ret err[Error].err{Error.types{types.err}}; }
    ret err[Error].ok{};
}

fun reached(s: *Mark, i: usize) Function {
    if (sel s.reach.function) { ret s.reach.function; }
    ret Function{index: i::u32};
}

# take a module back to a mark, and give the mark back
#
# every id made since names nothing afterwards. each body the mark kept is put
# back as its function's own. it never allocates.
# ---
# m:   the module the mark was taken of
# s:   the mark
# ret: ok, or the first release the allocator refused once everything was
#      taken back
pub fun rewind(m: *Module, s: *Mark) err[Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < s.bodies.len) {
        val f:   Function = reached(s, i);
        var old: Body     = m.functions.data[f.index].body;
        m.functions.data[f.index].body = s.bodies.data[i];
        keep(?failed, module.release_body(m.a, ?old));
        keep(?failed, module.trim_attributes(m.a, ?m.functions.data[f.index].attributes, s.attributes.data[i]));
        i = i + 1;
    }
    vector.truncate[Body](?s.bodies, 0);
    i = 0;
    for (i < s.initials.len) {
        keep(?failed, module.trim_attributes(m.a, ?m.globals.data[i].attributes, s.attributes.data[s.functions + i]));
        m.globals.data[i].data.initial = s.initials.data[i];
        i                              = i + 1;
    }
    for (m.functions.len > s.functions) {
        val n: *Node = ?m.functions.data[m.functions.len - 1];
        module.unindex(m, n.data.name);
        keep(?failed, module.release_function(m.a, n));
        vector.truncate[Node](?m.functions, m.functions.len - 1);
    }
    for (m.globals.len > s.globals) {
        val g: *GlobalNode = ?m.globals.data[m.globals.len - 1];
        module.unindex(m, g.data.name);
        keep(?failed, module.release_global(m.a, g));
        vector.truncate[GlobalNode](?m.globals, m.globals.len - 1);
    }
    for (m.constants.len > s.constants) {
        keep(?failed, module.release_constant(m.a, m.constants.data[m.constants.len - 1]));
        vector.truncate[ConstantData](?m.constants, m.constants.len - 1);
    }
    for (m.bindings.len > s.bindings) {
        keep(?failed, slice.release[debug.Binding](m.a, m.bindings.data[m.bindings.len - 1]));
        vector.truncate[Slice[debug.Binding]](?m.bindings, m.bindings.len - 1);
    }
    for (m.expressions.len > s.expressions) {
        keep(?failed, slice.release[Step](m.a, m.expressions.data[m.expressions.len - 1]));
        vector.truncate[Slice[Step]](?m.expressions, m.expressions.len - 1);
    }
    val entries: err[debug.Error] = debug.rewind(?m.debug, ?s.debug);
    val types:   err[type.Error]  = type.rewind(?m.types, ?s.types);
    keep(?failed, vector.dnit[Body](?s.bodies));
    keep(?failed, vector.dnit[usize](?s.attributes));
    keep(?failed, vector.dnit[opt[Constant]](?s.initials));
    ret given_back(failed, entries, types);
}

# give back a mark that is not rewound to, leaving the module as it is
pub fun forget(m: *Module, s: *Mark) err[Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < s.bodies.len) {
        keep(?failed, module.release_body(m.a, ?s.bodies.data[i]));
        i = i + 1;
    }
    keep(?failed, vector.dnit[Body](?s.bodies));
    keep(?failed, vector.dnit[usize](?s.attributes));
    keep(?failed, vector.dnit[opt[Constant]](?s.initials));
    val entries: err[debug.Error] = debug.forget(?m.debug, ?s.debug);
    val types:   err[type.Error]  = type.forget(?m.types, ?s.types);
    ret given_back(failed, entries, types);
}
