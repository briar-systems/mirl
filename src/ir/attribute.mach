# attribute records: facts one target family needs about a function or global
#
# a fact only one family reads, such as a spir-v entry point's stage or a
# shader variable's binding, is an attribute the family defines and never a
# field of a core record.

use std.types.bool.bool;

use std.collections.slice.Slice;
use std.types.view.View;

# what an attribute states
# ---
# integer:  one number
# integers: an ordered list of numbers, such as a workgroup size
# text:     a name
pub tag Datum: u8 {
    integer:  u64;
    integers: Slice[u64];
    text:     View;
}

# one attribute
#
# a name or list given to a module is copied, and one read back stays valid
# for the life of the module.
# ---
# family: the target family that defines it, such as `spirv`
# name:   its name within that family, such as `stage`
# datum:  what it states
pub rec Attribute {
    family: View;
    name:   View;
    datum:  Datum;
}

# the kind of datum an attribute states, one per case of Datum
pub tag Kind: u8 {
    integer;
    integers;
    text;
}

# whether a datum is of a kind
pub fun of_kind(d: Datum, k: Kind) bool {
    if (sel d.integer)  { ret sel k.integer; }
    if (sel d.integers) { ret sel k.integers; }
    ret sel k.text;
}
