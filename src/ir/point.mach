# value bindings at program points: records that give a source variable a
# value from a point of a block on
#
# a record is not an instruction, and no instruction walk sees it. the records
# standing at one point are a run: a list, in order, linked through the
# records of the function's body. each instruction holds the run standing just
# before it and each block the run at its end, so an edit that moves or erases
# an instruction moves its run whole, touching only the records of the points
# it changes. reading a value is never a use of it, so a
# record holds nothing alive. when what it reads dies and cannot be salvaged it
# becomes unavailable at its point, and is never dropped, since dropping it
# would leave the variable's earlier value standing.
#
# a salvage expression is a list of steps over what the record reads, each a
# row of the step table below, so a producer encodes each kind once, as a
# column of its row.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use mirl.debug.location;
use mirl.debug.location.Location;
use mirl.ir.debug.Binding;
use mirl.ir.id.Constant;
use mirl.ir.id.Value;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.table;
use mirl.ir.type.Type;

# a salvage expression, as an id into its module's expression lists
#
# a list never changes once made, so records that share an id share its steps.
# ---
# index: the list's position in its module
pub rec Expression {
    index: u32;
}

# the empty expression: the variable is what the record reads, as it is
pub val PLAIN: Expression = Expression{index: 0};

# what a step's argument is
# ---
# constant: an integer constant of the type the step reads
# to:       the integer type the step gives
pub tag Takes: u8 {
    constant;
    to;
}

# how a step's result type follows from what it reads
# ---
# same:     the type it reads
# wider:    its argument, an integer type wider than the one it reads
# narrower: its argument, an integer type narrower than the one it reads
pub tag Width: u8 {
    same;
    wider;
    narrower;
}

# one kind of step
#
# a step undoes nothing: it states the value a variable had in terms of a value
# that outlives it. its opcode is the operation whose result it recovers from
# that operation's value operand, so a pass that removes such a result
# rewrites the records reading it as a step over the operand.
# ---
# name:   its name in the text form
# takes:  what its argument is
# width:  how its result type follows from what it reads
# opcode: the operation whose result it gives from that operation's first
#         operand: a constant step's argument is the operation's second
#         operand, and a type step's argument its result type
# swaps:  the operation's constant may stand first as well
pub rec Row {
    name:   str;
    takes:  Takes;
    width:  Width;
    opcode: Opcode;
    swaps:  bool;
}

# a kind of step, as an id into the step table
# ---
# index: the kind's row in the table
pub rec Kind {
    index: u32;
}

# the argument a step is given, of the kind its row takes
pub tag Argument: u8 {
    constant: Constant;
    to:       Type;
}

# one step of a salvage expression
# ---
# kind:     its row
# argument: what it is applied with
pub rec Step {
    kind:     Kind;
    argument: Argument;
}

# what a record gives its variable from its point on
#
# the ir holds a location of two kinds, a value of the function or
# unavailable, and a body edit refuses any other.
# ---
# location:   where the variable is: the ssa value of an instruction result, a
#             block parameter or a constant, or unavailable since what it read
#             is gone
# expression: the steps that give the variable from what its location holds,
#             in order, PLAIN when unavailable
pub rec Reads {
    location:   Location;
    expression: Expression;
}

# what a record reads once what it read is gone
pub val GONE: Reads = Reads{location: Location.unavailable{}, expression: PLAIN};

# what a record reads from a value of its function through an expression
pub fun reading(v: Value, e: Expression) Reads {
    ret Reads{location: Location.ssa{v}, expression: e};
}

# the value a location of the ir reads
# ---
# l:   the location
# ret: the value, none when unavailable, or the kind of a location the ir
#      does not hold
pub fun read(l: Location) res[opt[Value], location.Kind] {
    if (sel l.unavailable) { ret res[opt[Value], location.Kind].ok{opt[Value].none{}}; }
    if (sel l.ssa)         { ret res[opt[Value], location.Kind].ok{opt[Value].some{l.ssa}}; }
    ret res[opt[Value], location.Kind].err{location.kind(l)};
}

# one record of a function's body
# ---
# binding: the variable it binds
# reads:   what it gives the variable
# next:    the position plus one of the record after it in its run, 0 for the
#          last
pub rec Point {
    binding: Binding;
    reads:   Reads;
    next:    u32;
}

# the records standing at one point, in order
#
# a zeroed run is empty.
# ---
# first: the position plus one of its first record in the body, 0 when empty
# last:  the position plus one of its last record, 0 when empty
pub rec Run {
    first: u32;
    last:  u32;
}

# a wrapping add of the constant
pub val ADD: Kind = Kind{index: 0};

# a wrapping subtract of the constant
pub val SUB: Kind = Kind{index: 1};

# a zero extension to the type
pub val EXT_U: Kind = Kind{index: 2};

# a sign extension to the type
pub val EXT_S: Kind = Kind{index: 3};

# a truncation to the type, keeping the low bits
pub val TRUNC: Kind = Kind{index: 4};

def Rows: [5]Row;

# the step table
val TABLE: Rows = [5]Row{
    Row{name: "add", takes: Takes.constant{}, width: Width.same{}, opcode: table.ADD, swaps: true},
    Row{name: "sub", takes: Takes.constant{}, width: Width.same{}, opcode: table.SUB, swaps: false},
    Row{name: "ext.u", takes: Takes.to{}, width: Width.wider{}, opcode: table.EXT_U, swaps: false},
    Row{name: "ext.s", takes: Takes.to{}, width: Width.wider{}, opcode: table.EXT_S, swaps: false},
    Row{name: "trunc", takes: Takes.to{}, width: Width.narrower{}, opcode: table.TRUNC, swaps: false},
};

# the number of kinds of step
pub fun rows() usize {
    ret $length_of(Rows);
}

# the row of a kind, none for an id past the last
pub fun row(k: Kind) opt[Row] {
    if (k.index::usize >= rows()) { ret opt[Row].none{}; }
    ret opt[Row].some{TABLE[k.index]};
}
