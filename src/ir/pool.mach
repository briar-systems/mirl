# storage a function body hands out in runs that stay where they are until
# the body goes
#
# an instruction's lists are runs of its body's pools, so making one
# allocates only when a pool's last chunk runs out, and a list that grows
# takes a new run and leaves the old one to the pool.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;

# a pool of entries of one type
# ---
# a:      the allocator its chunks are taken from
# chunks: its chunks, the last one the runs are taken from
# left:   how many entries the last chunk has left
pub rec Pool[T] {
    a:      *allocator.Allocator;
    chunks: vector.Vector[Slice[T]];
    left:   usize;
}

# how many entries a pool's first chunk holds, and the most a chunk grown from
# the one before it holds
val FIRST: usize = 32;
val LAST:  usize = 4096;

# an empty pool
pub fun init[T](a: *allocator.Allocator) Pool[T] {
    ret Pool[T]{a: a, chunks: vector.init[Slice[T]](a), left: 0};
}

# give back a pool's chunks, and with them every run it gave out
pub fun dnit[T](p: *Pool[T]) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < p.chunks.len) {
        keep(?failed, slice.release[T](p.a, p.chunks.data[i]));
        i = i + 1;
    }
    keep(?failed, vector.dnit[Slice[T]](?p.chunks));
    p.left = 0;
    ret failed;
}

# room for n entries in the last chunk, so the runs taken next, up to n
# entries in all, allocate nothing
pub fun ensure[T](p: *Pool[T], n: usize) err[allocator.Error] {
    if (n <= p.left) { ret err[allocator.Error].ok{}; }
    var next: usize = FIRST;
    if (p.chunks.len != 0) { next = p.chunks.data[p.chunks.len - 1].size * 2; }
    if (next > LAST)       { next = LAST; }
    if (next < n)          { next = n; }
    val listed: res[usize, allocator.Error] = vector.reserve[Slice[T]](?p.chunks, 1);
    if (sel listed.err) { ret err[allocator.Error].err{listed.err}; }
    val got: res[*T, allocator.Error] = allocator.allocate[T](p.a, next);
    if (sel got.err) { ret err[allocator.Error].err{got.err}; }
    vector.push[Slice[T]](?p.chunks, Slice[T]{data: got.ok, size: next});
    p.left = next;
    ret err[allocator.Error].ok{};
}

# a run of n entries of the room `ensure` made, nil for none, its entries unset
pub fun claim[T](p: *Pool[T], n: usize) *T {
    if (n == 0) { ret nil::*T; }
    val last: *Slice[T] = ?p.chunks.data[p.chunks.len - 1];
    val run:  *T        = ?last.data[last.size - p.left];
    p.left = p.left - n;
    ret run;
}

# a run of n entries, nil for none, its entries unset
pub fun take[T](p: *Pool[T], n: usize) res[*T, allocator.Error] {
    val room: err[allocator.Error] = ensure[T](p, n);
    if (sel room.err) { ret res[*T, allocator.Error].err{room.err}; }
    ret res[*T, allocator.Error].ok{claim[T](p, n)};
}

# a list that grows in runs of a pool, each run it outgrows staying with the
# pool
# ---
# data: its first entry
# len:  how many entries it has
# cap:  how many entries its run holds
pub rec Growing[T] {
    data: *T;
    len:  usize;
    cap:  usize;
}

# a list with no entries and no run
pub fun nothing[T]() Growing[T] {
    ret Growing[T]{data: nil::*T, len: 0, cap: 0};
}

# room in a list for n entries more, its entries moved to a longer run of the
# pool when its own is too short
pub fun reserve[T](p: *Pool[T], l: *Growing[T], n: usize) err[allocator.Error] {
    if (l.len + n <= l.cap) { ret err[allocator.Error].ok{}; }
    var cap: usize = l.cap * 2;
    if (cap < 4)         { cap = 4; }
    if (cap < l.len + n) { cap = l.len + n; }
    val run: res[*T, allocator.Error] = take[T](p, cap);
    if (sel run.err) { ret err[allocator.Error].err{run.err}; }
    var i: usize = 0;
    for (i < l.len) {
        run.ok[i] = l.data[i];
        i         = i + 1;
    }
    l.data = run.ok;
    l.cap  = cap;
    ret err[allocator.Error].ok{};
}

# an entry put at the end of a list
pub fun push[T](p: *Pool[T], l: *Growing[T], x: T) err[allocator.Error] {
    val room: err[allocator.Error] = reserve[T](p, l, 1);
    if (sel room.err) { ret room; }
    l.data[l.len] = x;
    l.len         = l.len + 1;
    ret err[allocator.Error].ok{};
}
