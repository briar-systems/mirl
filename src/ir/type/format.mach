# the number format table: one row per float format a type can name
#
# a float type names a row and nothing else, so a new format is a new row
# here and never a new case in the type table or a pass that reads it.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str;
use std.types.string.str_len;

# a row of the number format table, named by its index
# ---
# index: the row's position in the table
pub rec Format {
    index: u32;
}

# a binary encoding of sign, biased exponent and significand fields
# ---
# sign:        bits of the sign field, zero for an unsigned format
# exponent:    bits of the exponent field
# significand: stored bits of the significand field
# implicit:    the leading significand bit is implicit rather than stored
# bias:        the exponent bias
pub rec Binary {
    sign:        u32;
    exponent:    u32;
    significand: u32;
    implicit:    bool;
    bias:        i32;
}

# how a format lays out its bits
#
# the zero case is unstated, so a row left zeroed reads as incomplete.
pub tag Encoding: u8 {
    unstated;
    binary: Binary;
}

# the rounding rule a format's arithmetic applies by default
pub tag Rounding: u8 {
    unstated;
    nearest_even;
}

# which encodings are not a number and how they behave
# ---
# ieee: an all-ones exponent with a nonzero significand is a nan, quiet when
#       the top stored significand bit is set and signalling otherwise
pub tag Nan: u8 {
    unstated;
    ieee;
}

# one number format
# ---
# name:     the format's name in the text form
# width:    the format's width in bits
# encoding: the layout of those bits
# rounding: the default rounding rule
# nan:      the not-a-number rule
pub rec Row {
    name:     str;
    width:    u32;
    encoding: Encoding;
    rounding: Rounding;
    nan:      Nan;
}

def Rows: [3]Row;

val ROWS: Rows = [3]Row{
    Row{
        name:     "binary16",
        width:    16,
        encoding: Encoding.binary{Binary{sign: 1, exponent: 5, significand: 10, implicit: true, bias: 15}},
        rounding: Rounding.nearest_even{},
        nan:      Nan.ieee{},
    },
    Row{
        name:     "binary32",
        width:    32,
        encoding: Encoding.binary{Binary{sign: 1, exponent: 8, significand: 23, implicit: true, bias: 127}},
        rounding: Rounding.nearest_even{},
        nan:      Nan.ieee{},
    },
    Row{
        name:     "binary64",
        width:    64,
        encoding: Encoding.binary{Binary{sign: 1, exponent: 11, significand: 52, implicit: true, bias: 1023}},
        rounding: Rounding.nearest_even{},
        nan:      Nan.ieee{},
    },
};

# ieee 754 binary16
pub val BINARY16: Format = Format{index: 0};

# ieee 754 binary32
pub val BINARY32: Format = Format{index: 1};

# ieee 754 binary64
pub val BINARY64: Format = Format{index: 2};

# the number of rows in the table
pub fun rows() u32 {
    ret $length_of(Rows);
}

# the row a format names
# ---
# f:   the format
# ret: its row, or none when f names no row
pub fun row(f: Format) opt[Row] {
    if (f.index >= rows()) { ret opt[Row].none{}; }
    ret opt[Row].some{ROWS[f.index]};
}

test format__rows_complete {
    var i: u32 = 0;
    for (i < rows()) {
        val r: opt[Row] = row(Format{index: i});
        if (sel r.none) { ret 1; }
        val f: Row = r.some;
        if (f.name == nil || str_len(f.name) == 0) { ret 2; }
        if (f.width == 0)                          { ret 3; }
        if (sel f.encoding.unstated)               { ret 4; }
        if (sel f.encoding.binary) {
            val b: Binary = f.encoding.binary;
            if (b.exponent == 0 || b.significand == 0)          { ret 5; }
            if (b.sign + b.exponent + b.significand != f.width) { ret 6; }
        }
        if (sel f.rounding.unstated) { ret 7; }
        if (sel f.nan.unstated)      { ret 8; }
        i = i + 1;
    }
    val past: opt[Row] = row(Format{index: rows()});
    if (sel past.some) { ret 9; }
    ret 0;
}
