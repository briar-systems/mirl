# the per-module type table: interning and the accessors every reader uses
#
# each structurally distinct type has exactly one id, so two types are the
# same type exactly when their ids are equal. no size, alignment or offset is
# computed here: layout belongs to the target's data layout.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.Format;
use mirl.ir.type.format.Row;
use mirl.ir.type.format.row;

# a type, as an id into the table that interned it
# ---
# index: the type's position in its table
pub rec Type {
    index: u32;
}

# the kinds of type
pub tag Kind: u8 {
    integer;
    float;
    pointer;
    vector;
    array;
    structure;
    union;
    function;
    handle;
}

# a signless integer
# ---
# width: bits, one of the widths in `WIDTHS`
pub rec Integer {
    width: u32;
}

# a float in a number format
# ---
# format: the row of the number format table
pub rec Float {
    format: Format;
}

# an opaque pointer
# ---
# space: the numbered address space it points into
pub rec Pointer {
    space: u32;
}

# a vector of lanes
# ---
# lanes:   the lane count, at least one
# element: the lane type
pub rec Vector {
    lanes:   u32;
    element: Type;
}

# an array of elements
# ---
# count:   the element count
# element: the element type
pub rec Array {
    count:   u64;
    element: Type;
}

# an ordered list of members, optionally at stated offsets
# ---
# members: the member types in order
# offsets: the byte offset of each member, one to one with members, or none
#          when the target's data layout places them
pub rec Structure {
    members: Slice[Type];
    offsets: opt[Slice[u64]];
}

# storage whose members overlap
# ---
# members: the member types in order
pub rec Union {
    members: Slice[Type];
}

# a function signature
# ---
# params:  the parameter types in order
# results: the result types in order
pub rec Function {
    params:  Slice[Type];
    results: Slice[Type];
}

# an opaque value a target declares
# ---
# kind: the target's own number for this kind of handle, opaque to the table
pub rec Handle {
    kind: u64;
}

# the full description of a type, what `intern` takes and `shape` gives back
#
# a slice given to `intern` is copied, and a slice read back stays valid
# for the life of the table.
pub tag Shape: u8 {
    integer:   Integer;
    float:     Float;
    pointer:   Pointer;
    vector:    Vector;
    array:     Array;
    structure: Structure;
    union:     Union;
    function:  Function;
    handle:    Handle;
}

# why the table refused a request
# ---
# alloc:   the allocator refused storage
# width:   an integer width not in `WIDTHS`
# format:  a format that names no row of the number format table
# lanes:   a vector of zero lanes
# offsets: stated offsets that do not match the members one to one
# unknown: an id this table did not give out
# kind:    the type is of this kind, not the one the read asked for
pub tag Error: u8 {
    alloc:  allocator.Error;
    width:  u32;
    format: Format;
    lanes;
    offsets;
    unknown: Type;
    kind:    Kind;
}

def Widths: [8]u32;

# the legal integer widths, the same on every target
pub val WIDTHS: Widths = [8]u32{1, 8, 16, 32, 64, 128, 256, 512};

# one interned type and the next type whose structure hashes the same
rec Node {
    shape: Shape;
    next:  opt[Type];
}

# the type table of one module
# ---
# a:     the allocator every node and list is taken from
# nodes: the interned types, indexed by id
# heads: the first id in each chain of types whose structure hashes the same
pub rec Table {
    a:     *allocator.Allocator;
    nodes: vector.Vector[Node];
    heads: map.Map[u64, Type];
}

# create an empty table
# ---
# a:   the allocator the table takes its storage from
# ret: the table, owning nothing until the first intern
pub fun init(a: *allocator.Allocator) Table {
    var t: Table;
    t.a     = a;
    t.nodes = vector.init[Node](a);
    t.heads = map.init[u64, Type](a);
    ret t;
}

# release every list, node and chain head the table holds
# ---
# t:   the table
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(t: *Table) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < t.nodes.len) {
        val r: err[allocator.Error] = release_shape(t.a, ?t.nodes.data[i].shape);
        if (sel r.err && sel failed.ok) { failed = r; }
        i = i + 1;
    }
    val nodes: err[allocator.Error] = vector.dnit[Node](?t.nodes);
    if (sel nodes.err && sel failed.ok) { failed = nodes; }
    val heads: err[allocator.Error] = map.dnit[u64, Type](?t.heads);
    if (sel heads.err && sel failed.ok) { failed = heads; }
    ret failed;
}

# whether two ids are the same type
pub fun same(a: Type, b: Type) bool {
    ret a.index == b.index;
}

# whether a width is a legal integer width
pub fun legal_width(width: u32) bool {
    var i: usize = 0;
    for (i < $length_of(Widths)) {
        if (WIDTHS[i] == width) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the id of a type, interning it when the table has not seen its structure
# ---
# t:     the table
# shape: the type's description, whose slices are copied
# ret:   the one id for that structure, or why it was refused
pub fun intern(t: *Table, shape: Shape) res[Type, Error] {
    val checked: err[Error] = check(t, ?shape);
    if (sel checked.err) { ret res[Type, Error].err{checked.err}; }

    val h:     u64        = hash(?shape);
    var head:  opt[Type]  = opt[Type].none{};
    val found: opt[*Type] = map.get[u64, Type](?t.heads, ?h);
    if (sel found.some) {
        head = opt[Type].some{@found.some};
        var at: opt[Type] = head;
        for {
            val cur: opt[Type] = at;
            if (sel cur.none) { brk; }
            val id: Type  = cur.some;
            val n:  *Node = ?t.nodes.data[id.index];
            if (equal(?n.shape, ?shape)) { ret res[Type, Error].ok{id}; }
            at = n.next;
        }
    }

    val owned: res[Shape, allocator.Error] = own(t.a, shape);
    if (sel owned.err) { ret res[Type, Error].err{Error.alloc{owned.err}}; }

    val id:     Type                        = Type{index: t.nodes.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Node](?t.nodes, Node{shape: owned.ok, next: head});
    if (sel pushed.err) {
        var dropped: Shape = owned.ok;
        release_shape(t.a, ?dropped);
        ret res[Type, Error].err{Error.alloc{pushed.err}};
    }
    val linked: res[bool, allocator.Error] = map.insert[u64, Type](?t.heads, h, id);
    if (sel linked.err) {
        vector.pop[Node](?t.nodes);
        var dropped: Shape = owned.ok;
        release_shape(t.a, ?dropped);
        ret res[Type, Error].err{Error.alloc{linked.err}};
    }
    ret res[Type, Error].ok{id};
}

# the full description of a type
pub fun shape(t: *Table, ty: Type) res[Shape, Error] {
    val n: res[*Node, Error] = node(t, ty);
    if (sel n.err) { ret res[Shape, Error].err{n.err}; }
    ret res[Shape, Error].ok{n.ok.shape};
}

# the kind of a type
pub fun kind(t: *Table, ty: Type) res[Kind, Error] {
    val n: res[*Node, Error] = node(t, ty);
    if (sel n.err) { ret res[Kind, Error].err{n.err}; }
    ret res[Kind, Error].ok{kind_of(?n.ok.shape)};
}

# the width in bits of an integer type
pub fun width(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)        { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.integer) { ret res[u32, Error].ok{s.ok.integer.width}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the number format row of a float type
pub fun format(t: *Table, ty: Type) res[Format, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)      { ret res[Format, Error].err{s.err}; }
    if (sel s.ok.float) { ret res[Format, Error].ok{s.ok.float.format}; }
    ret res[Format, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the address space of a pointer type
pub fun space(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)        { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.pointer) { ret res[u32, Error].ok{s.ok.pointer.space}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the element type of a vector or array type
pub fun element(t: *Table, ty: Type) res[Type, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[Type, Error].err{s.err}; }
    if (sel s.ok.vector) { ret res[Type, Error].ok{s.ok.vector.element}; }
    if (sel s.ok.array)  { ret res[Type, Error].ok{s.ok.array.element}; }
    ret res[Type, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the lane count of a vector type
pub fun lanes(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.vector) { ret res[u32, Error].ok{s.ok.vector.lanes}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the element count of an array type
pub fun count(t: *Table, ty: Type) res[u64, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)      { ret res[u64, Error].err{s.err}; }
    if (sel s.ok.array) { ret res[u64, Error].ok{s.ok.array.count}; }
    ret res[u64, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the members of a structure or union type, in order
pub fun members(t: *Table, ty: Type) res[Slice[Type], Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)          { ret res[Slice[Type], Error].err{s.err}; }
    if (sel s.ok.structure) { ret res[Slice[Type], Error].ok{s.ok.structure.members}; }
    if (sel s.ok.union)     { ret res[Slice[Type], Error].ok{s.ok.union.members}; }
    ret res[Slice[Type], Error].err{Error.kind{kind_of(?s.ok)}};
}

# the stated member offsets of a structure type, or none when it states none
pub fun offsets(t: *Table, ty: Type) res[opt[Slice[u64]], Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)          { ret res[opt[Slice[u64]], Error].err{s.err}; }
    if (sel s.ok.structure) { ret res[opt[Slice[u64]], Error].ok{s.ok.structure.offsets}; }
    ret res[opt[Slice[u64]], Error].err{Error.kind{kind_of(?s.ok)}};
}

# the signature of a function type
pub fun signature(t: *Table, ty: Type) res[Function, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)         { ret res[Function, Error].err{s.err}; }
    if (sel s.ok.function) { ret res[Function, Error].ok{s.ok.function}; }
    ret res[Function, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the target's kind of a handle type
pub fun handle_kind(t: *Table, ty: Type) res[u64, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[u64, Error].err{s.err}; }
    if (sel s.ok.handle) { ret res[u64, Error].ok{s.ok.handle.kind}; }
    ret res[u64, Error].err{Error.kind{kind_of(?s.ok)}};
}

fun node(t: *Table, ty: Type) res[*Node, Error] {
    if (ty.index::usize >= t.nodes.len) { ret res[*Node, Error].err{Error.unknown{ty}}; }
    ret res[*Node, Error].ok{?t.nodes.data[ty.index]};
}

fun kind_of(s: *Shape) Kind {
    if (sel s.integer)   { ret Kind.integer{}; }
    if (sel s.float)     { ret Kind.float{}; }
    if (sel s.pointer)   { ret Kind.pointer{}; }
    if (sel s.vector)    { ret Kind.vector{}; }
    if (sel s.array)     { ret Kind.array{}; }
    if (sel s.structure) { ret Kind.structure{}; }
    if (sel s.union)     { ret Kind.union{}; }
    if (sel s.function)  { ret Kind.function{}; }
    ret Kind.handle{};
}

fun known(t: *Table, list: Slice[Type]) err[Error] {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i].index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{list.data[i]}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun check(t: *Table, s: *Shape) err[Error] {
    if (sel s.integer) {
        if (!legal_width(s.integer.width)) { ret err[Error].err{Error.width{s.integer.width}}; }
    }
    or (sel s.float) {
        val r: opt[Row] = row(s.float.format);
        if (sel r.none) { ret err[Error].err{Error.format{s.float.format}}; }
    }
    or (sel s.vector) {
        if (s.vector.lanes == 0)                          { ret err[Error].err{Error.lanes{}}; }
        if (s.vector.element.index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{s.vector.element}}; }
    }
    or (sel s.array) {
        if (s.array.element.index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{s.array.element}}; }
    }
    or (sel s.structure) {
        if (sel s.structure.offsets.some && s.structure.offsets.some.size != s.structure.members.size) {
            ret err[Error].err{Error.offsets{}};
        }
        ret known(t, s.structure.members);
    }
    or (sel s.union) {
        ret known(t, s.union.members);
    }
    or (sel s.function) {
        val params: err[Error] = known(t, s.function.params);
        if (sel params.err) { ret params; }
        ret known(t, s.function.results);
    }
    ret err[Error].ok{};
}

fun mix(h: u64, w: u64) u64 {
    ret (h ^ w) * 0x100000001b3;
}

fun mix_types(h: u64, list: Slice[Type]) u64 {
    var acc: u64   = mix(h, list.size::u64);
    var i:   usize = 0;
    for (i < list.size) {
        acc = mix(acc, list.data[i].index::u64);
        i   = i + 1;
    }
    ret acc;
}

fun hash(s: *Shape) u64 {
    var h: u64 = 0xcbf29ce484222325;
    if (sel s.integer) { h = mix(mix(h, 1), s.integer.width::u64); }
    or (sel s.float)   { h = mix(mix(h, 2), s.float.format.index::u64); }
    or (sel s.pointer) { h = mix(mix(h, 3), s.pointer.space::u64); }
    or (sel s.vector)  { h = mix(mix(mix(h, 4), s.vector.lanes::u64), s.vector.element.index::u64); }
    or (sel s.array)   { h = mix(mix(mix(h, 5), s.array.count), s.array.element.index::u64); }
    or (sel s.structure) {
        h = mix_types(mix(h, 6), s.structure.members);
        if (sel s.structure.offsets.some) {
            val offs: Slice[u64] = s.structure.offsets.some;
            h = mix(h, 1);
            var i: usize = 0;
            for (i < offs.size) {
                h = mix(h, offs.data[i]);
                i = i + 1;
            }
        }
    }
    or (sel s.union)    { h = mix_types(mix(h, 7), s.union.members); }
    or (sel s.function) { h = mix_types(mix_types(mix(h, 8), s.function.params), s.function.results); }
    or (sel s.handle)   { h = mix(mix(h, 9), s.handle.kind); }
    ret h;
}

fun same_types(a: Slice[Type], b: Slice[Type]) bool {
    if (a.size != b.size) { ret false; }
    var i: usize = 0;
    for (i < a.size) {
        if (a.data[i].index != b.data[i].index) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_offsets(a: opt[Slice[u64]], b: opt[Slice[u64]]) bool {
    if (sel a.none)                 { ret sel b.none; }
    if (sel b.none)                 { ret false; }
    if (a.some.size != b.some.size) { ret false; }
    var i: usize = 0;
    for (i < a.some.size) {
        if (a.some.data[i] != b.some.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun equal(a: *Shape, b: *Shape) bool {
    if (sel a.integer) {
        if (!(sel b.integer)) { ret false; }
        ret b.integer.width == a.integer.width;
    }
    if (sel a.float) {
        if (!(sel b.float)) { ret false; }
        ret b.float.format.index == a.float.format.index;
    }
    if (sel a.pointer) {
        if (!(sel b.pointer)) { ret false; }
        ret b.pointer.space == a.pointer.space;
    }
    if (sel a.vector) {
        if (!(sel b.vector)) { ret false; }
        ret b.vector.lanes == a.vector.lanes && b.vector.element.index == a.vector.element.index;
    }
    if (sel a.array) {
        if (!(sel b.array)) { ret false; }
        ret b.array.count == a.array.count && b.array.element.index == a.array.element.index;
    }
    if (sel a.structure) {
        if (!(sel b.structure)) { ret false; }
        ret same_types(a.structure.members, b.structure.members) && same_offsets(a.structure.offsets, b.structure.offsets);
    }
    if (sel a.union) {
        if (!(sel b.union)) { ret false; }
        ret same_types(a.union.members, b.union.members);
    }
    if (sel a.function) {
        if (!(sel b.function)) { ret false; }
        ret same_types(a.function.params, b.function.params) && same_types(a.function.results, b.function.results);
    }
    if (sel a.handle) {
        if (!(sel b.handle)) { ret false; }
        ret b.handle.kind == a.handle.kind;
    }
    ret false;
}

fun copy[T](a: *allocator.Allocator, s: Slice[T]) res[Slice[T], allocator.Error] {
    var out: Slice[T];
    out.data = nil;
    out.size = s.size;
    if (s.size == 0) { ret res[Slice[T], allocator.Error].ok{out}; }
    val got: res[*T, allocator.Error] = allocator.allocate[T](a, s.size);
    if (sel got.err) { ret res[Slice[T], allocator.Error].err{got.err}; }
    out.data = got.ok;
    var i: usize = 0;
    for (i < s.size) {
        out.data[i] = s.data[i];
        i           = i + 1;
    }
    ret res[Slice[T], allocator.Error].ok{out};
}

fun release[T](a: *allocator.Allocator, s: Slice[T]) err[allocator.Error] {
    if (s.size == 0) { ret err[allocator.Error].ok{}; }
    ret allocator.deallocate[T](a, s.data, s.size);
}

# a copy of the shape whose lists the table owns
fun own(a: *allocator.Allocator, s: Shape) res[Shape, allocator.Error] {
    if (sel s.structure) {
        val m: res[Slice[Type], allocator.Error] = copy[Type](a, s.structure.members);
        if (sel m.err) { ret res[Shape, allocator.Error].err{m.err}; }
        var offs: opt[Slice[u64]] = opt[Slice[u64]].none{};
        if (sel s.structure.offsets.some) {
            val o: res[Slice[u64], allocator.Error] = copy[u64](a, s.structure.offsets.some);
            if (sel o.err) {
                release[Type](a, m.ok);
                ret res[Shape, allocator.Error].err{o.err};
            }
            offs = opt[Slice[u64]].some{o.ok};
        }
        ret res[Shape, allocator.Error].ok{Shape.structure{Structure{members: m.ok, offsets: offs}}};
    }
    if (sel s.union) {
        val m: res[Slice[Type], allocator.Error] = copy[Type](a, s.union.members);
        if (sel m.err) { ret res[Shape, allocator.Error].err{m.err}; }
        ret res[Shape, allocator.Error].ok{Shape.union{Union{members: m.ok}}};
    }
    if (sel s.function) {
        val p: res[Slice[Type], allocator.Error] = copy[Type](a, s.function.params);
        if (sel p.err) { ret res[Shape, allocator.Error].err{p.err}; }
        val r: res[Slice[Type], allocator.Error] = copy[Type](a, s.function.results);
        if (sel r.err) {
            release[Type](a, p.ok);
            ret res[Shape, allocator.Error].err{r.err};
        }
        ret res[Shape, allocator.Error].ok{Shape.function{Function{params: p.ok, results: r.ok}}};
    }
    ret res[Shape, allocator.Error].ok{s};
}

# give back the lists a shape owns
fun release_shape(a: *allocator.Allocator, s: *Shape) err[allocator.Error] {
    if (sel s.structure) {
        val m: err[allocator.Error] = release[Type](a, s.structure.members);
        if (sel m.err)                    { ret m; }
        if (sel s.structure.offsets.none) { ret m; }
        ret release[u64](a, s.structure.offsets.some);
    }
    if (sel s.union) {
        ret release[Type](a, s.union.members);
    }
    if (sel s.function) {
        val p: err[allocator.Error] = release[Type](a, s.function.params);
        if (sel p.err) { ret p; }
        ret release[Type](a, s.function.results);
    }
    ret err[allocator.Error].ok{};
}

fun must(r: res[Type, Error], out: *Type) bool {
    if (sel r.err) { ret false; }
    @out = r.ok;
    ret true;
}

fun list(data: *Type, size: usize) Slice[Type] {
    ret Slice[Type]{data: data, size: size};
}

fun record(t: *Table, members: Slice[Type], offsets: opt[Slice[u64]], out: *Type) bool {
    ret must(intern(t, Shape.structure{Structure{members: members, offsets: offsets}}), out);
}

test intern__one_id_per_structure {
    var a: allocator.Allocator;
    page.make(?a);
    var t: Table = init(?a);
    fin { dnit(?t); }

    var i32a: Type;
    var i32b: Type;
    var i64a: Type;
    var f32a: Type;
    var f32b: Type;
    if (!must(intern(?t, Shape.integer{Integer{width: 32}}), ?i32a))    { ret 1; }
    if (!must(intern(?t, Shape.integer{Integer{width: 32}}), ?i32b))    { ret 1; }
    if (!must(intern(?t, Shape.integer{Integer{width: 64}}), ?i64a))    { ret 1; }
    if (!must(intern(?t, Shape.float{Float{format: BINARY32}}), ?f32a)) { ret 1; }
    if (!must(intern(?t, Shape.float{Float{format: BINARY32}}), ?f32b)) { ret 1; }
    if (!same(i32a, i32b) || same(i32a, i64a))                          { ret 2; }
    if (!same(f32a, f32b) || same(f32a, i32a))                          { ret 3; }

    var one:  [2]Type = [2]Type{i32a, i64a};
    var two:  [2]Type = [2]Type{i32b, i64a};
    var flip: [2]Type = [2]Type{i64a, i32a};
    var s1:   Type;
    var s2:   Type;
    var s3:   Type;
    if (!record(?t, list(?one[0], 2), opt[Slice[u64]].none{}, ?s1))  { ret 4; }
    if (!record(?t, list(?two[0], 2), opt[Slice[u64]].none{}, ?s2))  { ret 4; }
    if (!record(?t, list(?flip[0], 2), opt[Slice[u64]].none{}, ?s3)) { ret 4; }
    if (!same(s1, s2) || same(s1, s3))                               { ret 5; }

    var fn1: Type;
    var fn2: Type;
    if (!must(intern(?t, Shape.function{Function{params: list(?one[0], 2), results: list(?one[0], 1)}}), ?fn1)) { ret 6; }
    if (!must(intern(?t, Shape.function{Function{params: list(?two[0], 2), results: list(?two[0], 1)}}), ?fn2)) { ret 6; }
    if (!same(fn1, fn2) || same(fn1, s1))                                                                       { ret 7; }
    ret 0;
}

test intern__refuses_width {
    var a: allocator.Allocator;
    page.make(?a);
    var t: Table = init(?a);
    fin { dnit(?t); }

    var w: u32 = 0;
    for (w <= 1024) {
        val r: res[Type, Error] = intern(?t, Shape.integer{Integer{width: w}});
        if (legal_width(w)) {
            if (sel r.err) { ret 1; }
            val got: res[u32, Error] = width(?t, r.ok);
            if (sel got.err) { ret 2; }
            if (got.ok != w) { ret 2; }
        }
        or {
            if (sel r.ok)           { ret 3; }
            if (!(sel r.err.width)) { ret 4; }
            if (r.err.width != w)   { ret 4; }
        }
        w = w + 1;
    }
    ret 0;
}

test intern__stated_offsets_distinct {
    var a: allocator.Allocator;
    page.make(?a);
    var t: Table = init(?a);
    fin { dnit(?t); }

    var members: [2]Type;
    if (!must(intern(?t, Shape.integer{Integer{width: 8}}), ?members[0]))  { ret 1; }
    if (!must(intern(?t, Shape.integer{Integer{width: 32}}), ?members[1])) { ret 1; }
    var at:    [2]u64      = [2]u64{0, 4};
    val m:     Slice[Type] = list(?members[0], 2);
    var bare:  Type;
    var fixed: Type;
    if (!record(?t, m, opt[Slice[u64]].none{}, ?bare))                                   { ret 1; }
    if (!record(?t, m, opt[Slice[u64]].some{Slice[u64]{data: ?at[0], size: 2}}, ?fixed)) { ret 1; }
    if (same(bare, fixed))                                                               { ret 2; }

    val stated: res[opt[Slice[u64]], Error] = offsets(?t, fixed);
    if (sel stated.err) { ret 3; }
    val offs: opt[Slice[u64]] = stated.ok;
    if (sel offs.none)                                 { ret 3; }
    if (offs.some.size != 2 || offs.some.data[1] != 4) { ret 4; }

    var short: Type;
    if (record(?t, m, opt[Slice[u64]].some{Slice[u64]{data: ?at[0], size: 1}}, ?short)) { ret 5; }
    ret 0;
}

test union__keeps_member_order {
    var a: allocator.Allocator;
    page.make(?a);
    var t: Table = init(?a);
    fin { dnit(?t); }

    var order: [3]Type;
    if (!must(intern(?t, Shape.integer{Integer{width: 64}}), ?order[0])) { ret 1; }
    if (!must(intern(?t, Shape.integer{Integer{width: 8}}), ?order[1]))  { ret 1; }
    if (!must(intern(?t, Shape.integer{Integer{width: 16}}), ?order[2])) { ret 1; }
    var other: [3]Type = [3]Type{order[1], order[0], order[2]};
    var u:     Type;
    var v:     Type;
    if (!must(intern(?t, Shape.union{Union{members: list(?order[0], 3)}}), ?u)) { ret 1; }
    if (!must(intern(?t, Shape.union{Union{members: list(?other[0], 3)}}), ?v)) { ret 1; }
    if (same(u, v))                                                             { ret 2; }

    val got: res[Slice[Type], Error] = members(?t, u);
    if (sel got.err)      { ret 3; }
    if (got.ok.size != 3) { ret 3; }
    var i: usize = 0;
    for (i < 3) {
        if (!same(got.ok.data[i], order[i])) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

test handle__keeps_kind {
    var a: allocator.Allocator;
    page.make(?a);
    var t: Table = init(?a);
    fin { dnit(?t); }

    var image:   Type;
    var again:   Type;
    var sampler: Type;
    if (!must(intern(?t, Shape.handle{Handle{kind: 7}}), ?image))   { ret 1; }
    if (!must(intern(?t, Shape.handle{Handle{kind: 7}}), ?again))   { ret 1; }
    if (!must(intern(?t, Shape.handle{Handle{kind: 9}}), ?sampler)) { ret 1; }
    if (!same(image, again) || same(image, sampler))                { ret 2; }

    val k: res[u64, Error] = handle_kind(?t, sampler);
    if (sel k.err) { ret 3; }
    if (k.ok != 9) { ret 3; }
    ret 0;
}
