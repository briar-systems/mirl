# the per-module type table: interning and the accessors every reader uses
#
# each structurally distinct type has exactly one id, so two types are the
# same type exactly when their ids are equal. no size, alignment or offset is
# computed here: layout belongs to the target's data layout.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.base.slice.mix;
use mirl.ir.type.format.Format;
use mirl.ir.type.format.Row;
use mirl.ir.type.format.row;

# a type, as an id into the table that interned it
# ---
# index: the type's position in its table
pub rec Type {
    index: u32;
}

# the kinds of type
pub tag Kind: u8 {
    integer;
    float;
    pointer;
    vector;
    array;
    structure;
    union;
    function;
    handle;
}

# a signless integer
# ---
# width: bits, one of the widths in `WIDTHS`
pub rec Integer {
    width: u32;
}

# a float in a number format
# ---
# format: the row of the number format table
pub rec Float {
    format: Format;
}

# an opaque pointer
# ---
# space: the numbered address space it points into
pub rec Pointer {
    space: u32;
}

# the default address space, the one a bare `ptr` points into, which a call's
# values, a frame and a global are laid out in
pub val DEFAULT_SPACE: u32 = 0;

# a vector of lanes
# ---
# lanes:   the lane count, at least one
# element: the lane type
pub rec Vector {
    lanes:   u32;
    element: Type;
}

# an array of elements, optionally at a stated stride
# ---
# count:   the element count
# element: the element type
# stride:  the bytes from one element to the next, or none when the rules of
#          the space it is laid out in place them
pub rec Array {
    count:   u64;
    element: Type;
    stride:  opt[u64];
}

# an ordered list of members, optionally at stated offsets
# ---
# members: the member types in order
# offsets: the byte offset of each member, one to one with members, or none
#          when the target's data layout places them
pub rec Structure {
    members: Slice[Type];
    offsets: opt[Slice[u64]];
}

# storage whose members overlap
# ---
# members: the member types in order
pub rec Union {
    members: Slice[Type];
}

# how a narrow integer parameter or result is extended to the width a
# convention passes it at, which the signless integer type does not say
# ---
# none: the signature states no extension
# sext: sign extended
# zext: zero extended
pub tag Extension: u8 {
    none;
    sext;
    zext;
}

# a function signature
#
# the extension lists are part of the type: signatures that differ in one
# extension are different types. a list given to `intern` is empty, for no
# extension anywhere, or one to one with its types, and one read back is
# always one to one. the convention a signature names is part of it too:
# a call through it and a function of it are made under that row of the
# target's conventions, and an empty name is the target's default row.
# ---
# params:     the parameter types in order
# results:    the result types in order
# param_ext:  the extension of each parameter, one to one with params, or empty
# result_ext: the extension of each result, one to one with results, or empty
# convention: the name of the convention row it is called under, empty for
#             the target's default, compared by its bytes and never read by
#             the table
pub rec Function {
    params:     Slice[Type];
    results:    Slice[Type];
    param_ext:  Slice[Extension];
    result_ext: Slice[Extension];
    convention: View;
}

# an opaque value a target declares
# ---
# kind: the target's family-qualified name for it, such as `spirv.image`,
#       compared by its bytes and never read by the table
pub rec Handle {
    kind: View;
}

# the full description of a type, what `intern` takes and `shape` gives back
#
# a slice or name given to `intern` is copied, and one read back stays valid
# for the life of the table.
pub tag Shape: u8 {
    integer:   Integer;
    float:     Float;
    pointer:   Pointer;
    vector:    Vector;
    array:     Array;
    structure: Structure;
    union:     Union;
    function:  Function;
    handle:    Handle;
}

# why the table refused a request
# ---
# alloc:    the allocator refused storage
# width:    an integer width not in `WIDTHS`
# format:   a format that names no row of the number format table
# lanes:    a vector of zero lanes
# offsets:  stated offsets that do not match the members one to one
# unknown:  an id this table did not give out
# kind:     the type is of this kind, not the one the read asked for
# name:     a handle whose kind is an empty name
# extends:  an extension list that is not one to one with its types
# extended: an extension stated for a type that is not an integer
pub tag Error: u8 {
    alloc:  allocator.Error;
    width:  u32;
    format: Format;
    lanes;
    offsets;
    unknown: Type;
    kind:    Kind;
    name;
    extends;
    extended: Type;
}

# the list of legal integer widths
pub def Widths: [8]u32;

# the legal integer widths, the same on every target
pub val WIDTHS: Widths = [8]u32{1, 8, 16, 32, 64, 128, 256, 512};

# one interned type and the next type whose structure hashes the same
rec Node {
    shape: Shape;
    next:  opt[Type];
}

# the type table of one module
# ---
# a:     the allocator every node and list is taken from
# nodes: the interned types, indexed by id
# heads: the first id in each chain of types whose structure hashes the same
pub rec Table {
    a:     *allocator.Allocator;
    nodes: vector.Vector[Node];
    heads: map.Map[u64, Type];
}

# create an empty table
# ---
# a:   the allocator the table takes its storage from
# ret: the table, owning nothing until the first intern
pub fun init(a: *allocator.Allocator) Table {
    var t: Table;
    t.a     = a;
    t.nodes = vector.init[Node](a);
    t.heads = map.init[u64, Type](a);
    ret t;
}

# release every list, node and chain head the table holds
# ---
# t:   the table
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(t: *Table) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < t.nodes.len) {
        val r: err[allocator.Error] = release_shape(t.a, ?t.nodes.data[i].shape);
        if (sel r.err && sel failed.ok) { failed = r; }
        i = i + 1;
    }
    val nodes: err[allocator.Error] = vector.dnit[Node](?t.nodes);
    if (sel nodes.err && sel failed.ok) { failed = nodes; }
    val heads: err[allocator.Error] = map.dnit[u64, Type](?t.heads);
    if (sel heads.err && sel failed.ok) { failed = heads; }
    ret failed;
}

# whether two ids are the same type
pub fun same(a: Type, b: Type) bool {
    ret a.index == b.index;
}

# a signature that states no extension
pub fun plain(params: Slice[Type], results: Slice[Type]) Function {
    ret Function{params: params, results: results, param_ext: Slice[Extension]{data: nil, size: 0}, result_ext: Slice[Extension]{data: nil, size: 0}, convention: View{data: nil, len: 0}};
}

# the extension at a position of a list, none past a list that states none
pub fun extension(list: Slice[Extension], at: usize) Extension {
    if (at >= list.size) { ret Extension.none{}; }
    ret list.data[at];
}

fun code(e: Extension) u64 {
    if (sel e.sext) { ret 1; }
    if (sel e.zext) { ret 2; }
    ret 0;
}

# whether a width is a legal integer width
pub fun legal_width(width: u32) bool {
    var i: usize = 0;
    for (i < $length_of(Widths)) {
        if (WIDTHS[i] == width) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the id of a type, interning it when the table has not seen its structure
# ---
# t:     the table
# shape: the type's description, whose slices are copied
# ret:   the one id for that structure, or why it was refused
pub fun intern(t: *Table, shape: Shape) res[Type, Error] {
    val checked: err[Error] = check(t, ?shape);
    if (sel checked.err) { ret res[Type, Error].err{checked.err}; }

    val h:     u64        = hash(?shape);
    var head:  opt[Type]  = opt[Type].none{};
    val found: opt[*Type] = map.get[u64, Type](?t.heads, ?h);
    if (sel found.some) {
        head = opt[Type].some{@found.some};
        var at: opt[Type] = head;
        for {
            val cur: opt[Type] = at;
            if (sel cur.none) { brk; }
            val id: Type  = cur.some;
            val n:  *Node = ?t.nodes.data[id.index];
            if (equal(?n.shape, ?shape)) { ret res[Type, Error].ok{id}; }
            at = n.next;
        }
    }

    val owned: res[Shape, allocator.Error] = own(t.a, shape);
    if (sel owned.err) { ret res[Type, Error].err{Error.alloc{owned.err}}; }

    val id:     Type                        = Type{index: t.nodes.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Node](?t.nodes, Node{shape: owned.ok, next: head});
    if (sel pushed.err) {
        var dropped: Shape = owned.ok;
        release_shape(t.a, ?dropped);
        ret res[Type, Error].err{Error.alloc{pushed.err}};
    }
    val linked: res[bool, allocator.Error] = map.insert[u64, Type](?t.heads, h, id);
    if (sel linked.err) {
        vector.pop[Node](?t.nodes);
        var dropped: Shape = owned.ok;
        release_shape(t.a, ?dropped);
        ret res[Type, Error].err{Error.alloc{linked.err}};
    }
    ret res[Type, Error].ok{id};
}

# how many types a table has interned, for `rewind` to take back the ones after
pub fun mark(t: *Table) u32 {
    ret t.nodes.len::u32;
}

# take back every type interned since a mark, newest first, so each chain of
# types that hash the same starts where it did. an id at or past the mark
# names no type afterwards. it never allocates
# ---
# t:   the table
# at:  a mark of the table
# ret: ok, or the first release the allocator refused once everything was
#      taken back
pub fun rewind(t: *Table, at: u32) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    for (t.nodes.len > at::usize) {
        val i:    usize      = t.nodes.len - 1;
        val n:    *Node      = ?t.nodes.data[i];
        val h:    u64        = hash(?n.shape);
        val next: opt[Type]  = n.next;
        val head: opt[*Type] = map.get[u64, Type](?t.heads, ?h);
        if (sel next.none) { map.remove[u64, Type](?t.heads, ?h); }
        if (sel next.some) {
            if (sel head.some) { @head.some = next.some; }
        }
        val r: err[allocator.Error] = release_shape(t.a, ?n.shape);
        if (sel r.err && sel failed.ok) { failed = r; }
        vector.truncate[Node](?t.nodes, i);
    }
    ret failed;
}

# the full description of a type
pub fun shape(t: *Table, ty: Type) res[Shape, Error] {
    val n: res[*Node, Error] = node(t, ty);
    if (sel n.err) { ret res[Shape, Error].err{n.err}; }
    ret res[Shape, Error].ok{n.ok.shape};
}

# the kind of a type
pub fun kind(t: *Table, ty: Type) res[Kind, Error] {
    val n: res[*Node, Error] = node(t, ty);
    if (sel n.err) { ret res[Kind, Error].err{n.err}; }
    ret res[Kind, Error].ok{kind_of(?n.ok.shape)};
}

# the width in bits of an integer type
pub fun width(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)        { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.integer) { ret res[u32, Error].ok{s.ok.integer.width}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the number format row of a float type
pub fun format(t: *Table, ty: Type) res[Format, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)      { ret res[Format, Error].err{s.err}; }
    if (sel s.ok.float) { ret res[Format, Error].ok{s.ok.float.format}; }
    ret res[Format, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the address space of a pointer type
pub fun space(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)        { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.pointer) { ret res[u32, Error].ok{s.ok.pointer.space}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the element type of a vector or array type
pub fun element(t: *Table, ty: Type) res[Type, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[Type, Error].err{s.err}; }
    if (sel s.ok.vector) { ret res[Type, Error].ok{s.ok.vector.element}; }
    if (sel s.ok.array)  { ret res[Type, Error].ok{s.ok.array.element}; }
    ret res[Type, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the lane count of a vector type
pub fun lanes(t: *Table, ty: Type) res[u32, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[u32, Error].err{s.err}; }
    if (sel s.ok.vector) { ret res[u32, Error].ok{s.ok.vector.lanes}; }
    ret res[u32, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the element count of an array type
pub fun count(t: *Table, ty: Type) res[u64, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)      { ret res[u64, Error].err{s.err}; }
    if (sel s.ok.array) { ret res[u64, Error].ok{s.ok.array.count}; }
    ret res[u64, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the members of a structure or union type, in order
pub fun members(t: *Table, ty: Type) res[Slice[Type], Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)          { ret res[Slice[Type], Error].err{s.err}; }
    if (sel s.ok.structure) { ret res[Slice[Type], Error].ok{s.ok.structure.members}; }
    if (sel s.ok.union)     { ret res[Slice[Type], Error].ok{s.ok.union.members}; }
    ret res[Slice[Type], Error].err{Error.kind{kind_of(?s.ok)}};
}

# the stated member offsets of a structure type, or none when it states none
pub fun offsets(t: *Table, ty: Type) res[opt[Slice[u64]], Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)          { ret res[opt[Slice[u64]], Error].err{s.err}; }
    if (sel s.ok.structure) { ret res[opt[Slice[u64]], Error].ok{s.ok.structure.offsets}; }
    ret res[opt[Slice[u64]], Error].err{Error.kind{kind_of(?s.ok)}};
}

# the signature of a function type
pub fun signature(t: *Table, ty: Type) res[Function, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)         { ret res[Function, Error].err{s.err}; }
    if (sel s.ok.function) { ret res[Function, Error].ok{s.ok.function}; }
    ret res[Function, Error].err{Error.kind{kind_of(?s.ok)}};
}

# the name of a handle type's kind, valid for the life of the table
pub fun handle_kind(t: *Table, ty: Type) res[View, Error] {
    val s: res[Shape, Error] = shape(t, ty);
    if (sel s.err)       { ret res[View, Error].err{s.err}; }
    if (sel s.ok.handle) { ret res[View, Error].ok{s.ok.handle.kind}; }
    ret res[View, Error].err{Error.kind{kind_of(?s.ok)}};
}

fun node(t: *Table, ty: Type) res[*Node, Error] {
    if (ty.index::usize >= t.nodes.len) { ret res[*Node, Error].err{Error.unknown{ty}}; }
    ret res[*Node, Error].ok{?t.nodes.data[ty.index]};
}

fun kind_of(s: *Shape) Kind {
    if (sel s.integer)   { ret Kind.integer{}; }
    if (sel s.float)     { ret Kind.float{}; }
    if (sel s.pointer)   { ret Kind.pointer{}; }
    if (sel s.vector)    { ret Kind.vector{}; }
    if (sel s.array)     { ret Kind.array{}; }
    if (sel s.structure) { ret Kind.structure{}; }
    if (sel s.union)     { ret Kind.union{}; }
    if (sel s.function)  { ret Kind.function{}; }
    ret Kind.handle{};
}

fun known(t: *Table, list: Slice[Type]) err[Error] {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i].index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{list.data[i]}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether an extension list is empty or one to one with its types, which are integers
fun extensions(t: *Table, list: Slice[Type], ext: Slice[Extension]) err[Error] {
    if (ext.size == 0)         { ret err[Error].ok{}; }
    if (ext.size != list.size) { ret err[Error].err{Error.extends{}}; }
    var i: usize = 0;
    for (i < list.size) {
        val n: *Node = ?t.nodes.data[list.data[i].index];
        if (code(ext.data[i]) != 0 && !(sel n.shape.integer)) { ret err[Error].err{Error.extended{list.data[i]}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun check(t: *Table, s: *Shape) err[Error] {
    if (sel s.integer) {
        if (!legal_width(s.integer.width)) { ret err[Error].err{Error.width{s.integer.width}}; }
    }
    or (sel s.float) {
        val r: opt[Row] = row(s.float.format);
        if (sel r.none) { ret err[Error].err{Error.format{s.float.format}}; }
    }
    or (sel s.vector) {
        if (s.vector.lanes == 0)                          { ret err[Error].err{Error.lanes{}}; }
        if (s.vector.element.index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{s.vector.element}}; }
    }
    or (sel s.array) {
        if (s.array.element.index::usize >= t.nodes.len) { ret err[Error].err{Error.unknown{s.array.element}}; }
    }
    or (sel s.structure) {
        if (sel s.structure.offsets.some && s.structure.offsets.some.size != s.structure.members.size) {
            ret err[Error].err{Error.offsets{}};
        }
        ret known(t, s.structure.members);
    }
    or (sel s.union) {
        ret known(t, s.union.members);
    }
    or (sel s.function) {
        val params: err[Error] = known(t, s.function.params);
        if (sel params.err) { ret params; }
        val results: err[Error] = known(t, s.function.results);
        if (sel results.err) { ret results; }
        val pe: err[Error] = extensions(t, s.function.params, s.function.param_ext);
        if (sel pe.err) { ret pe; }
        ret extensions(t, s.function.results, s.function.result_ext);
    }
    or (sel s.handle) {
        if (s.handle.kind.len == 0) { ret err[Error].err{Error.name{}}; }
    }
    ret err[Error].ok{};
}

fun mix_types(h: u64, list: Slice[Type]) u64 {
    var acc: u64   = mix(h, list.size::u64);
    var i:   usize = 0;
    for (i < list.size) {
        acc = mix(acc, list.data[i].index::u64);
        i   = i + 1;
    }
    ret acc;
}

fun mix_extensions(h: u64, types: Slice[Type], ext: Slice[Extension]) u64 {
    var acc: u64   = h;
    var i:   usize = 0;
    for (i < types.size) {
        val c: u64 = code(extension(ext, i));
        if (c != 0) { acc = mix(mix(acc, i::u64 + 1), c); }
        i = i + 1;
    }
    ret acc;
}

fun hash(s: *Shape) u64 {
    var h: u64 = 0xcbf29ce484222325;
    if (sel s.integer) { h = mix(mix(h, 1), s.integer.width::u64); }
    or (sel s.float)   { h = mix(mix(h, 2), s.float.format.index::u64); }
    or (sel s.pointer) { h = mix(mix(h, 3), s.pointer.space::u64); }
    or (sel s.vector)  { h = mix(mix(mix(h, 4), s.vector.lanes::u64), s.vector.element.index::u64); }
    or (sel s.array) {
        h = mix(mix(mix(h, 5), s.array.count), s.array.element.index::u64);
        if (sel s.array.stride.some) { h = mix(mix(h, 1), s.array.stride.some); }
    }
    or (sel s.structure) {
        h = mix_types(mix(h, 6), s.structure.members);
        if (sel s.structure.offsets.some) {
            val offs: Slice[u64] = s.structure.offsets.some;
            h = mix(h, 1);
            var i: usize = 0;
            for (i < offs.size) {
                h = mix(h, offs.data[i]);
                i = i + 1;
            }
        }
    }
    or (sel s.union) { h = mix_types(mix(h, 7), s.union.members); }
    or (sel s.function) {
        h = mix_types(mix_types(mix(h, 8), s.function.params), s.function.results);
        h = mix_extensions(mix(h, 1), s.function.params, s.function.param_ext);
        h = mix_extensions(mix(h, 2), s.function.results, s.function.result_ext);
        h = slice.hash_view(mix(mix(h, 3), s.function.convention.len::u64), s.function.convention);
    }
    or (sel s.handle) {
        h = slice.hash_view(mix(mix(h, 9), s.handle.kind.len::u64), s.handle.kind);
    }
    ret h;
}

# whether two lists hold the same types in the same order
pub fun same_list(a: Slice[Type], b: Slice[Type]) bool {
    if (a.size != b.size) { ret false; }
    var i: usize = 0;
    for (i < a.size) {
        if (a.data[i].index != b.data[i].index) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether two arrays state the same stride, or both state none
pub fun same_stride(a: opt[u64], b: opt[u64]) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel b.none) { ret false; }
    ret a.some == b.some;
}

fun same_offsets(a: opt[Slice[u64]], b: opt[Slice[u64]]) bool {
    if (sel a.none)                 { ret sel b.none; }
    if (sel b.none)                 { ret false; }
    if (a.some.size != b.some.size) { ret false; }
    var i: usize = 0;
    for (i < a.some.size) {
        if (a.some.data[i] != b.some.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether two extension lists state the same extension at every position of the types they are for
pub fun same_extensions(types: Slice[Type], a: Slice[Extension], b: Slice[Extension]) bool {
    var i: usize = 0;
    for (i < types.size) {
        if (code(extension(a, i)) != code(extension(b, i))) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun equal(a: *Shape, b: *Shape) bool {
    if (sel a.integer) {
        if (!(sel b.integer)) { ret false; }
        ret b.integer.width == a.integer.width;
    }
    if (sel a.float) {
        if (!(sel b.float)) { ret false; }
        ret b.float.format.index == a.float.format.index;
    }
    if (sel a.pointer) {
        if (!(sel b.pointer)) { ret false; }
        ret b.pointer.space == a.pointer.space;
    }
    if (sel a.vector) {
        if (!(sel b.vector)) { ret false; }
        ret b.vector.lanes == a.vector.lanes && b.vector.element.index == a.vector.element.index;
    }
    if (sel a.array) {
        if (!(sel b.array)) { ret false; }
        ret b.array.count == a.array.count && b.array.element.index == a.array.element.index && same_stride(a.array.stride, b.array.stride);
    }
    if (sel a.structure) {
        if (!(sel b.structure)) { ret false; }
        ret same_list(a.structure.members, b.structure.members) && same_offsets(a.structure.offsets, b.structure.offsets);
    }
    if (sel a.union) {
        if (!(sel b.union)) { ret false; }
        ret same_list(a.union.members, b.union.members);
    }
    if (sel a.function) {
        if (!(sel b.function))                                                                                      { ret false; }
        if (!same_list(a.function.params, b.function.params) || !same_list(a.function.results, b.function.results)) { ret false; }
        ret same_extensions(a.function.params, a.function.param_ext, b.function.param_ext)
            && same_extensions(a.function.results, a.function.result_ext, b.function.result_ext)
            && slice.same_view(a.function.convention, b.function.convention);
    }
    if (sel a.handle) {
        if (!(sel b.handle)) { ret false; }
        ret slice.same_view(a.handle.kind, b.handle.kind);
    }
    ret false;
}

# a one to one extension list of count entries, from a list that is one to one or empty
fun owned_extensions(a: *allocator.Allocator, count: usize, given: Slice[Extension]) res[Slice[Extension], allocator.Error] {
    var out: Slice[Extension];
    out.data = nil;
    out.size = count;
    if (count == 0) { ret res[Slice[Extension], allocator.Error].ok{out}; }
    val got: res[*Extension, allocator.Error] = allocator.allocate[Extension](a, count);
    if (sel got.err) { ret res[Slice[Extension], allocator.Error].err{got.err}; }
    out.data = got.ok;
    var i: usize = 0;
    for (i < count) {
        out.data[i] = extension(given, i);
        i           = i + 1;
    }
    ret res[Slice[Extension], allocator.Error].ok{out};
}

# a copy of the shape whose lists the table owns
fun own(a: *allocator.Allocator, s: Shape) res[Shape, allocator.Error] {
    if (sel s.structure) {
        val m: res[Slice[Type], allocator.Error] = slice.copy[Type](a, s.structure.members);
        if (sel m.err) { ret res[Shape, allocator.Error].err{m.err}; }
        var offs: opt[Slice[u64]] = opt[Slice[u64]].none{};
        if (sel s.structure.offsets.some) {
            val o: res[Slice[u64], allocator.Error] = slice.copy[u64](a, s.structure.offsets.some);
            if (sel o.err) {
                slice.release[Type](a, m.ok);
                ret res[Shape, allocator.Error].err{o.err};
            }
            offs = opt[Slice[u64]].some{o.ok};
        }
        ret res[Shape, allocator.Error].ok{Shape.structure{Structure{members: m.ok, offsets: offs}}};
    }
    if (sel s.union) {
        val m: res[Slice[Type], allocator.Error] = slice.copy[Type](a, s.union.members);
        if (sel m.err) { ret res[Shape, allocator.Error].err{m.err}; }
        ret res[Shape, allocator.Error].ok{Shape.union{Union{members: m.ok}}};
    }
    if (sel s.function) {
        val p: res[Slice[Type], allocator.Error] = slice.copy[Type](a, s.function.params);
        if (sel p.err) { ret res[Shape, allocator.Error].err{p.err}; }
        val r: res[Slice[Type], allocator.Error] = slice.copy[Type](a, s.function.results);
        if (sel r.err) {
            slice.release[Type](a, p.ok);
            ret res[Shape, allocator.Error].err{r.err};
        }
        val pe: res[Slice[Extension], allocator.Error] = owned_extensions(a, s.function.params.size, s.function.param_ext);
        if (sel pe.err) {
            slice.release[Type](a, p.ok);
            slice.release[Type](a, r.ok);
            ret res[Shape, allocator.Error].err{pe.err};
        }
        val re: res[Slice[Extension], allocator.Error] = owned_extensions(a, s.function.results.size, s.function.result_ext);
        if (sel re.err) {
            slice.release[Type](a, p.ok);
            slice.release[Type](a, r.ok);
            slice.release[Extension](a, pe.ok);
            ret res[Shape, allocator.Error].err{re.err};
        }
        val c: res[View, allocator.Error] = slice.copy_view(a, s.function.convention);
        if (sel c.err) {
            slice.release[Type](a, p.ok);
            slice.release[Type](a, r.ok);
            slice.release[Extension](a, pe.ok);
            slice.release[Extension](a, re.ok);
            ret res[Shape, allocator.Error].err{c.err};
        }
        ret res[Shape, allocator.Error].ok{Shape.function{Function{params: p.ok, results: r.ok, param_ext: pe.ok, result_ext: re.ok, convention: c.ok}}};
    }
    if (sel s.handle) {
        val n: res[View, allocator.Error] = slice.copy_view(a, s.handle.kind);
        if (sel n.err) { ret res[Shape, allocator.Error].err{n.err}; }
        ret res[Shape, allocator.Error].ok{Shape.handle{Handle{kind: n.ok}}};
    }
    ret res[Shape, allocator.Error].ok{s};
}

# give back the lists a shape owns
fun release_shape(a: *allocator.Allocator, s: *Shape) err[allocator.Error] {
    if (sel s.structure) {
        val m: err[allocator.Error] = slice.release[Type](a, s.structure.members);
        if (sel m.err)                    { ret m; }
        if (sel s.structure.offsets.none) { ret m; }
        ret slice.release[u64](a, s.structure.offsets.some);
    }
    if (sel s.union) {
        ret slice.release[Type](a, s.union.members);
    }
    if (sel s.function) {
        val p: err[allocator.Error] = slice.release[Type](a, s.function.params);
        if (sel p.err) { ret p; }
        val r: err[allocator.Error] = slice.release[Type](a, s.function.results);
        if (sel r.err) { ret r; }
        val pe: err[allocator.Error] = slice.release[Extension](a, s.function.param_ext);
        if (sel pe.err) { ret pe; }
        val re: err[allocator.Error] = slice.release[Extension](a, s.function.result_ext);
        if (sel re.err) { ret re; }
        ret slice.release_view(a, s.function.convention);
    }
    if (sel s.handle) {
        ret slice.release_view(a, s.handle.kind);
    }
    ret err[allocator.Error].ok{};
}

fun list(data: *Type, size: usize) Slice[Type] {
    ret Slice[Type]{data: data, size: size};
}
