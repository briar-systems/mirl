# the convention a function type is called under, as mink's psabi row
#
# a signature names the row of mink's catalog it is called under, never a
# spelling of mirl's, so a row is keyed by mink's `Abi` from the text to the
# back end. a bridge row, a row that shares an image with code of another
# convention, as arm64ec's thunks do, is no row a target can be built for, so
# mink's catalog has none: it is its abi's row in a bridge role of mirl's own,
# spelled by the row's name and the role's word, `arm64ec.x64`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use arches:    mink.catalog.arch;
use arch_list: mink.catalog.arch.list;

use mirl.base.slice;
use mirl.base.slice.mix;

# the role a row plays beside its abi's own row, arm64ec's bridge being the
# only bridge mirl carries
# ---
# own:    the abi's own row, spelled by the abi's name alone
# x64:    the row emulated x64 code is reached under, `.x64`
# native: the abi's row with the callee's address leading, `.native`
# check:  the row of the call that checks an indirect callee, `.check`
pub tag Role: u8 {
    own;
    x64;
    native;
    check;
}

# the convention a signature is called under
# ---
# abi:  mink's psabi row
# role: the role the row plays beside the abi's own
pub rec Calling {
    abi:  *arches.Abi;
    role: Role;
}

# the target's default row, which a signature that names none is called under
pub val DEFAULT: opt[Calling] = opt[Calling].none{};

# the abi's own row
pub fun own(abi: *arches.Abi) Calling {
    ret Calling{abi: abi, role: Role.own{}};
}

# whether two roles are one
pub fun same_role(a: Role, b: Role) bool {
    if (sel a.own)    { ret sel b.own; }
    if (sel a.x64)    { ret sel b.x64; }
    if (sel a.native) { ret sel b.native; }
    ret sel b.check;
}

# whether two signatures are called under one row, or both under the default
pub fun same(a: opt[Calling], b: opt[Calling]) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel b.none) { ret false; }
    ret a.some.abi == b.some.abi && same_role(a.some.role, b.some.role);
}

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun role_word(r: Role) str {
    if (sel r.x64)    { ret "x64"; }
    if (sel r.native) { ret "native"; }
    if (sel r.check)  { ret "check"; }
    ret "";
}

fun role_code(r: Role) u64 {
    if (sel r.x64)    { ret 1; }
    if (sel r.native) { ret 2; }
    if (sel r.check)  { ret 3; }
    ret 0;
}

# a hash of the row a signature is called under, by the abi's name and the
# role, so it is the same on every run and stays when the row is restated on
# another architecture
pub fun hash(h: u64, c: opt[Calling]) u64 {
    if (sel c.none) { ret mix(h, 0); }
    val name: View = view_of(c.some.abi.name);
    ret mix(slice.hash_view(mix(h, 1), name), role_code(c.some.role));
}

# the row of another architecture a row is restated as, of the same name and
# role, none when the architecture has no row of the name
pub fun restate(c: Calling, arch: *arches.Arch) opt[Calling] {
    val abi: opt[*arches.Abi] = abi_named(arch, view_of(c.abi.name));
    if (sel abi.none) { ret opt[Calling].none{}; }
    ret opt[Calling].some{Calling{abi: abi.some, role: c.role}};
}

# the most bytes a spelling takes
pub val SPELLED: usize = 64;

# a row's spelling, held in place
# ---
# bytes: its bytes
# len:   how many
pub rec Spelling {
    bytes: [SPELLED]u8;
    len:   usize;
}

fun put(s: *Spelling, v: View) {
    var i: usize = 0;
    for (i < v.len && s.len < SPELLED) {
        s.bytes[s.len] = v.data[i];
        s.len          = s.len + 1;
        i              = i + 1;
    }
}

# a row's spelling: the abi's name, then a dot and the role's word for a
# bridge role. the view is of `s`
pub fun spell(c: Calling, s: *Spelling) View {
    s.len = 0;
    put(s, view_of(c.abi.name));
    if (!(sel c.role.own)) {
        put(s, View{data: ".", len: 1});
        put(s, view_of(role_word(c.role)));
    }
    ret View{data: ?s.bytes[0], len: s.len};
}

# the row of mink's architecture catalog a text spells
pub fun arch_named(v: View) opt[*arches.Arch] {
    var i: usize = 0;
    for (i < arch_list.count()) {
        val row: *arches.Arch = arch_list.at(i);
        if (slice.same_view(view_of(row.name), v)) { ret opt[*arches.Arch].some{row}; }
        i = i + 1;
    }
    ret opt[*arches.Arch].none{};
}

# the psabi row of an architecture a text spells, none when its family has
# none of that name for it
pub fun abi_named(arch: *arches.Arch, v: View) opt[*arches.Abi] {
    val f: *arches.Family = arch.family;
    var i: usize          = 0;
    for (i < f.abi_count) {
        val b: *arches.Abi = f.abis[i];
        if (b.arch == arch && slice.same_view(view_of(b.name), v)) { ret opt[*arches.Abi].some{b}; }
        i = i + 1;
    }
    ret opt[*arches.Abi].none{};
}

fun role_named(v: View) opt[Role] {
    if (slice.same_view(v, view_of("x64")))    { ret opt[Role].some{Role.x64{}}; }
    if (slice.same_view(v, view_of("native"))) { ret opt[Role].some{Role.native{}}; }
    if (slice.same_view(v, view_of("check")))  { ret opt[Role].some{Role.check{}}; }
    ret opt[Role].none{};
}

# the row a spelling names on an architecture: a psabi row of it by its name,
# or by its name, a dot and a bridge role's word. none when it names none
pub fun resolve(arch: *arches.Arch, v: View) opt[Calling] {
    val whole: opt[*arches.Abi] = abi_named(arch, v);
    if (sel whole.some) { ret opt[Calling].some{own(whole.some)}; }
    var dot: usize = v.len;
    var i:   usize = 0;
    for (i < v.len) {
        if (v.data[i] == '.') { dot = i; }
        i = i + 1;
    }
    if (dot == v.len) { ret opt[Calling].none{}; }
    val role: opt[Role] = role_named(View{data: ?v.data[dot + 1], len: v.len - dot - 1});
    if (sel role.none) { ret opt[Calling].none{}; }
    val abi: opt[*arches.Abi] = abi_named(arch, View{data: v.data, len: dot});
    if (sel abi.none) { ret opt[Calling].none{}; }
    ret opt[Calling].some{Calling{abi: abi.some, role: role.some}};
}
