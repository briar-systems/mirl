# blocks: parameters in place of phi, and a list of instructions
#
# a block declares parameters, and every edge into it passes one argument per
# parameter. its predecessor list names the instruction of every such edge,
# once per edge, so a change to its parameters reaches every argument list.
# each instruction holds the run of value binding records standing just
# before it, and the block the run at its end, so no instruction walk meets
# them. an erased block keeps its record, so the ids given out stay valid.

use std.collections.vector;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.view.View;

use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.point.Run;

# one block
# ---
# parameters:   its parameters, in order
# instructions: the instructions placed in it, in order
# predecessors: the instruction of every edge into it, once per edge, in the
#               order the edges were made
# ending:       the value binding records at its end, after its last
#               instruction
# erased:       taken out of the body, with no edge into it, no instruction
#               and no parameter in use
# name:         the name the text form prints it by, owned by its module, or
#               none. it carries no meaning
pub rec BlockData {
    parameters:   vector.Vector[Value];
    instructions: vector.Vector[Instruction];
    predecessors: vector.Vector[Instruction];
    ending:       Run;
    erased:       bool;
    name:         opt[View];
}
