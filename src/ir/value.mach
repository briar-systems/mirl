# values: what an instruction operand or a branch argument names
#
# the ir is in ssa form. a value is defined once, by a block parameter, an
# instruction result or a constant, and its use list names every instruction
# that uses it, once per use, so replacing it reaches every use.

use std.collections.vector;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.view.View;

use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Instruction;
use mirl.ir.type.Type;

# a block parameter's place
# ---
# block: the block
# index: its position among the block's parameters
pub rec Parameter {
    block: Block;
    index: u32;
}

# an instruction result's place
# ---
# instruction: the instruction
# index:       its position among the instruction's results
pub rec Output {
    instruction: Instruction;
    index:       u32;
}

# what defines a value
# ---
# parameter: a block parameter
# result:    an instruction result
# constant:  a constant of the module
# removed:   nothing, since the parameter or instruction that defined it was
#            removed
pub tag Def: u8 {
    parameter: Parameter;
    result:    Output;
    constant:  Constant;
    removed;
}

# what a block parameter is declared as
# ---
# type:   its type
# secret: it is secret
# name:   the name the text form prints it by, or none, which is copied
pub rec Declaration {
    type:   Type;
    secret: bool;
    name:   opt[View];
}

# one value
#
# its secrecy is stated once, here: a parameter as declared, a result by its
# opcode row's secrecy rule when it is made, and a constant public.
# ---
# type:   its type
# secret: it is secret
# def:    what defines it
# uses:   the instructions that use it, once per operand or argument
# bound:  the position in the body of every value binding record that reads
#         it. a record is no use
# name:   the name the text form prints it by, owned by its module, or none.
#         it carries no meaning, and a constant's value prints as the constant
pub rec ValueData {
    type:   Type;
    secret: bool;
    def:    Def;
    uses:   vector.Vector[Instruction];
    bound:  vector.Vector[u32];
    name:   opt[View];
}
