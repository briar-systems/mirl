# the one metadata record every instruction carries
#
# every field is a value or an id, so copying an instruction copies the record
# whole and no side table can be left behind. a zeroed record is an
# instruction with no location, no site, no flags, no secrecy and no bindings.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;

use mirl.ir.debug.record.Location;
use mirl.ir.debug.record.Site;

# the flags an instruction carries
# ---
# volatile:   the memory access is observable and is never merged, moved or removed
# kept:       the write is a fixed fact, never removed, narrowed, merged or
#             forwarded away, and kept writes keep their order. only a row whose
#             effects are keepable takes it
# bounded:    the shift's count is below its operand's width, so a machine shift
#             that takes the count modulo the width gives the result the ir
#             states. only a row with an overshift rule takes it, and the
#             shift bounding pass recomputes it on every run
# checked:    the division's zero divisor and signed overflow are tested before
#             it, so it never meets them and a machine division that gives a
#             result for them may run it as it stands. only a row with a zero
#             or overflow trap takes it, and the helpers legalisation sets it
# public:     the access reads or writes no secret, as the front end's types
#             state the pointee of the pointer it goes through. only a row
#             that states its access (`opcode.states_access`), the memory it
#             writes (`opcode.states_write`) or the bytes it copies, read and
#             written (`opcode.states_copy`), takes it, never with its secret
#             mark, and an access that states neither is unstated
# ascending:  copying from the lowest byte up gives the destination the
#             bytes the source held before, as it does where the ranges do
#             not overlap or the destination starts at or below the source.
#             only a row whose effects are orientable takes it
# descending: copying from the highest byte down gives the destination the
#             bytes the source held before, as it does where the ranges do
#             not overlap or the destination starts at or above the source.
#             only a row whose effects are orientable takes it
pub rec Flags {
    volatile:   bool;
    kept:       bool;
    bounded:    bool;
    checked:    bool;
    public:     bool;
    ascending:  bool;
    descending: bool;
}

# no flags at all
pub val NO_FLAGS: Flags = Flags{volatile: false, kept: false, bounded: false, checked: false, public: false, ascending: false, descending: false};

# whether two instructions carry the same flags
pub fun same_flags(x: Flags, y: Flags) bool {
    ret x.volatile == y.volatile && x.kept == y.kept && x.bounded == y.bounded && x.checked == y.checked && x.public == y.public && x.ascending == y.ascending && x.descending == y.descending;
}

# a list of debug bindings, as an id into its module's binding lists
#
# an instruction's list binds the variables whose storage its result
# addresses. a variable's value is bound by records at program points.
#
# a list never changes once made, so instructions that share an id share the
# same bindings. index 0 is the empty list.
pub def Bindings: u32;

# the empty list of debug bindings
pub val UNBOUND: Bindings = 0;

# a load's or store's statement that the bytes it reaches lie within a range of one frame slot, as each access of a
# loop the bulk legalisation makes of a copy or fill states the range the copy or fill moved (`mirl.legal.bulk`). in
# the ir the slot is the alloca the access's address is formed from through `ptr.add`, `ptr.member` and `ptr.index`,
# and `slot` is NO_SLOT. in the machine form it is the frame slot selection made for that alloca. for a store it also
# states that the loop it stands in writes every byte of the range before it leaves, the bytes the copy or fill wrote
# ---
# slot:   the frame slot in the machine form, NO_SLOT in the ir
# offset: the range's first byte, from the slot's first
# length: the bytes of the range, 0 for no statement
pub rec Extent {
    slot:   u32;
    offset: u64;
    length: u64;
}

# the slot of an extent in the ir, which names it by the access's address
pub val NO_SLOT: u32 = 0xffffffff;

# no extent stated, as a zeroed record states none
pub val NO_EXTENT: Extent = Extent{slot: 0, offset: 0, length: 0};

# whether an instruction states an extent
pub fun states_extent(m: *Metadata) bool {
    ret m.extent.length != 0;
}

# what an instruction carries beside its operands
# ---
# location: the source location it was built for
# site:     the inlining site it was inlined through
# flags:    its flags
# secret:   its results are secret
# bindings: the debug bindings whose variable's storage its result addresses
# extent:   the frame range its access reaches, length 0 for none
pub rec Metadata {
    location: opt[Location];
    site:     opt[Site];
    flags:    Flags;
    secret:   bool;
    bindings: Bindings;
    extent:   Extent;
}

# whether two records of one module are the same, entry by entry
pub fun same(x: Metadata, y: Metadata) bool {
    if (sel x.location.some != sel y.location.some) { ret false; }
    if (sel x.location.some) {
        if (sel y.location.some && x.location.some != y.location.some) { ret false; }
    }
    if (sel x.site.some != sel y.site.some) { ret false; }
    if (sel x.site.some) {
        if (sel y.site.some && x.site.some != y.site.some) { ret false; }
    }
    if (x.extent.slot != y.extent.slot || x.extent.offset != y.extent.offset || x.extent.length != y.extent.length) { ret false; }
    ret same_flags(x.flags, y.flags) && x.secret == y.secret && x.bindings == y.bindings;
}
