# functions: a signature, attributes and a body of blocks
#
# a function with no blocks is declared here and defined by another module.
# its first block is its entry, whose parameters are its parameters.

use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;
use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use mink.base.intern.Name;
use mink.base.table.Id;

use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.debug.record.Location;
use mirl.ir.global.Section;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.linkage.Linkage;
use mirl.ir.place.Placed;
use mirl.ir.point.Point;
use mirl.ir.type.table.Type;
use mirl.ir.value.ValueData;

# what a function is declared as
#
# its symbol name is a handle of the module's names (`module.intern_name`),
# and extensions and a section given to a module are copied.
# ---
# name:          its symbol name, a handle of the module's names
# signature:     its function type
# linkage:       how far it is seen
# constant_time: whether and how it must run in time independent of its
#                secret values (`ConstantTime`). no pass that can break that
#                requirement rewrites a function that has one
# extensions:    the extensions its code may use past the build's, by the
#                names the target's instruction set gives them, none for the
#                build's alone. selection admits the rows of the build's
#                selection widened by them, for this function only
# alignment:     the alignment of its entry in bytes, a power of two, or none
#                for the target's function alignment alone
# section:       the section its code is placed in, of a kind that executes,
#                or none for the one the build picks
pub rec FunctionData {
    name:          Id[Name];
    signature:     Type;
    linkage:       Linkage;
    constant_time: ConstantTime;
    extensions:    Slice[View];
    alignment:     opt[u64];
    section:       opt[Section];
}

# how a function's running time is held independent of its secrets
# ---
# none: it is not, and its code may take any time
# soft: it is held by the code-level rules, and its code runs under every timing mode the processor offers, switched on
#       around it where the build does not guarantee the processor has the mode and std's availability byte says it
#       has, so without the mode it runs anyway
# hard: it is held by the code-level rules, and the build's target must guarantee every timing mode its code needs,
#       or the build is refused naming the missing feature
pub tag ConstantTime: u8 {
    none;
    soft;
    hard;
}

# whether a function of mode `c` requires constant time at all
pub fun in_constant_time(c: ConstantTime) bool {
    ret !(sel c.none);
}

# whether two modes are the same
pub fun same_time(a: ConstantTime, b: ConstantTime) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel a.soft) { ret sel b.soft; }
    ret sel b.hard;
}

# no extensions past the build's
pub val NO_EXTENSIONS: Slice[View] = Slice[View]{data: nil, size: 0};

# how a function's entry parameters arrive
# ---
# unplaced: as its signature's parameters, before the abi legalisation
# placed:   one piece per entry parameter, in order, each at its place
pub tag Entry: u8 {
    unplaced;
    placed: vector.Vector[Placed];
}

# the blocks, values and instructions of a function, indexed by their ids
# ---
# blocks:       its blocks, the entry first
# values:       its values
# instructions: its instructions, placed or detached
# constants:    the one value that stands for each constant it uses, keyed by
#               the constant's index
# points:       its value binding records, each in the run of the point it
#               stands at
# entry:        how its entry parameters arrive
pub rec Body {
    blocks:       vector.Vector[BlockData];
    values:       vector.Vector[ValueData];
    instructions: vector.Vector[InstructionData];
    constants:    map.Map[u32, Value];
    points:       vector.Vector[Point];
    entry:        Entry;
}

# a function as its module holds it
# ---
# data:       what it is declared as
# attributes: the attributes attached to it
# body:       its body
pub rec Node {
    data:       FunctionData;
    attributes: vector.Vector[Attribute];
    body:       Body;
}

# the source location instruction `i` of body `b` was built for, none for none
# or for an id the body did not give out
pub fun location(b: *Body, i: Instruction) opt[Location] {
    if (i.index::usize >= b.instructions.len) { ret opt[Location].none{}; }
    ret b.instructions.data[i.index].metadata.location;
}
