# functions: a signature, attributes and a body of blocks
#
# a function with no blocks is declared here and defined by another module.
# its first block is its entry, whose parameters are its parameters.

use std.collections.map;
use std.collections.vector;
use std.types.bool.bool;
use std.types.view.View;

use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.point.Point;
use mirl.ir.type.Type;
use mirl.ir.value.ValueData;

# what a function is declared as
#
# a name given to a module is copied, and one read back stays valid for the
# life of the module.
# ---
# name:          its symbol name
# signature:     its function type
# constant_time: it must run in time independent of its secret values, so no
#                pass that can break that requirement rewrites it
pub rec FunctionData {
    name:          View;
    signature:     Type;
    constant_time: bool;
}

# the blocks, values and instructions of a function, indexed by their ids
# ---
# blocks:       its blocks, the entry first
# values:       its values
# instructions: its instructions, placed or detached
# constants:    the one value that stands for each constant it uses, keyed by
#               the constant's index
# points:       its value binding records, each in the run of the point it
#               stands at
pub rec Body {
    blocks:       vector.Vector[BlockData];
    values:       vector.Vector[ValueData];
    instructions: vector.Vector[InstructionData];
    constants:    map.Map[u32, Value];
    points:       vector.Vector[Point];
}

# a function as its module holds it
# ---
# data:       what it is declared as
# attributes: the attributes attached to it
# body:       its body
pub rec Node {
    data:       FunctionData;
    attributes: vector.Vector[Attribute];
    body:       Body;
}
