# constants: the values a module states without running it
#
# a constant is typed and owned by its module. an aggregate holds other
# constants, so an initial value can hold the addresses of globals and
# functions at any depth. a specialization constant states its default, and
# its value is the one its consumer sets.

use std.collections.slice.Slice;

use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.type.table.Type;

# the bits of a number, low word first
# ---
# type:  an integer or float type
# words: as many words as the type's width needs, with the bits above the
#        width zero
pub rec Bits {
    type:  Type;
    words: Slice[u64];
}

# a structure, array or vector of constants
# ---
# type:     the aggregate type
# elements: one constant per member, element or lane, in order
pub rec Aggregate {
    type:     Type;
    elements: Slice[Constant];
}

# a run of bytes, an array of 8-bit integers stated whole
# ---
# type: an array of 8-bit integers, one element per byte
# data: the bytes, the first element's first
pub rec Bytes {
    type: Type;
    data: Slice[u8];
}

# the address of a function or global, plus a byte offset
# ---
# type:   a pointer type
# symbol: what it is the address of
# offset: bytes added to that address
pub rec Address {
    type:   Type;
    symbol: Symbol;
    offset: i64;
}

# a specialization constant: a value the consumer of the module may set
# before it runs, which holds its default until it does
# ---
# id:      its id among the module's specialization constants, which names it
#          to the consumer
# default: the value it holds until the consumer sets another, an integer or
#          float of the constant's type
pub rec Spec {
    id:      u32;
    default: Bits;
}

# one constant
#
# a list given to a module is copied, and one read back stays valid for the
# life of the module.
# ---
# integer:   an integer's bits
# float:     a float's encoding in its number format
# zero:      every bit of this type zero
# aggregate: an aggregate of constants
# address:   an address
# spec:      a specialization constant, whose value is known only once the
#            consumer of the module sets it
# bytes:     an array of bytes, each its own element
pub tag ConstantData: u8 {
    integer:   Bits;
    float:     Bits;
    zero:      Type;
    aggregate: Aggregate;
    address:   Address;
    spec:      Spec;
    bytes:     Bytes;
}
