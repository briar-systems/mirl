# target op items: one instruction of an instruction set the target's catalog names
#
# an item names an instruction set of its target's catalog and one op in it, as
# masc's rows of that set state them, and the types of the results the op
# gives. the operands are the instruction's own, in the order the op's row
# states its operands after the ones the target supplies, so the item states
# no type of theirs. the item states whether it reads and writes memory, which
# must be what the op's row states, so a pass reads the item by its declared
# effects alone and never needs the target's catalog. which sets a target
# holds is its declaration (`mirl.target.capability.Ops`), never the item's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.type.Type;

# one target op
# ---
# set:     the instruction set, as the target's catalog names it
# name:    the op within the set, as the set names it
# results: the types of its results, in order
# reads:   it reads memory
# writes:  it writes memory
pub rec Op {
    set:     View;
    name:    View;
    results: Slice[Type];
    reads:   bool;
    writes:  bool;
}

# whether an op touches memory, the one fact its opcode is chosen by
pub fun touches(o: *Op) bool {
    ret o.reads || o.writes;
}

# an op copied into storage of its own, itself, its names and its result types
pub fun copy(a: *allocator.Allocator, o: *Op) res[*Op, allocator.Error] {
    val held: res[*Op, allocator.Error] = allocator.allocate[Op](a, 1);
    if (sel held.err) { ret held; }
    val out: *Op = held.ok;
    out.set     = View{data: nil, len: 0};
    out.name    = View{data: nil, len: 0};
    out.results = Slice[Type]{data: nil, size: 0};
    out.reads   = o.reads;
    out.writes  = o.writes;
    val set: res[View, allocator.Error] = slice.copy_view(a, o.set);
    if (sel set.err) {
        allocator.deallocate[Op](a, out, 1);
        ret res[*Op, allocator.Error].err{set.err};
    }
    out.set = set.ok;
    val name: res[View, allocator.Error] = slice.copy_view(a, o.name);
    if (sel name.err) {
        release(a, out);
        ret res[*Op, allocator.Error].err{name.err};
    }
    out.name = name.ok;
    val results: res[Slice[Type], allocator.Error] = slice.copy[Type](a, o.results);
    if (sel results.err) {
        release(a, out);
        ret res[*Op, allocator.Error].err{results.err};
    }
    out.results = results.ok;
    ret res[*Op, allocator.Error].ok{out};
}

# give back what `copy` made, the op itself with it
pub fun release(a: *allocator.Allocator, o: *Op) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.release_view(a, o.set);
    keep(?failed, slice.release_view(a, o.name));
    keep(?failed, slice.release[Type](a, o.results));
    keep(?failed, allocator.deallocate[Op](a, o, 1));
    ret failed;
}
