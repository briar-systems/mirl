# source languages: what a module's code was written in, as its front end
# states it, by rows a debug producer reads its own code for the language from

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mirl.base.slice;

# a source language
# ---
# name:  how the text form spells it
# dwarf: its DW_LANG code, from the user range when DWARF has none for it
pub rec Language {
    name:  str;
    dwarf: u16;
}

# mach has no standard code, so it takes DW_LANG_lo_user | 'M'
pub val MACH: Language = Language{name: "mach", dwarf: 0x804d};
pub val C:    Language = Language{name: "c", dwarf: 0x1d};

val COUNT: usize            = 2;
val ROWS:  [COUNT]*Language = [COUNT]*Language{?MACH, ?C};

# how many languages there are
pub fun count() usize {
    ret COUNT;
}

# the language at a position of the rows
pub fun at(index: usize) *Language {
    ret ROWS[index];
}

# the name of a language as a view
pub fun name(l: *Language) View {
    ret View{data: l.name, len: str_len(l.name)};
}

# the language a name spells, or none
pub fun named(v: View) opt[*Language] {
    var i: usize = 0;
    for (i < COUNT) {
        if (slice.same_view(name(ROWS[i]), v)) { ret opt[*Language].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Language].none{};
}
