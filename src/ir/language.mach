# source languages: what a module's code was written in, as its front end
# states it, each a name and the code a debug producer writes for it
#
# mirl states rows for the languages it knows. a front end may state a
# language of its own as a record it makes, and a reader of the text form
# resolves a name and code to mirl's row when they match one.

use std.types.bool.bool;
use std.types.size.usize;
use std.types.view.View;

use mirl.base.slice;

# a source language
# ---
# name:  how the text form spells it
# dwarf: its DW_LANG code, from the user range when DWARF has none for it
pub rec Language {
    name:  View;
    dwarf: u16;
}

# mach has no standard code, so it takes DW_LANG_lo_user | 'M'
pub val MACH: Language = Language{name: View{data: "mach", len: 4}, dwarf: 0x804d};
pub val C:    Language = Language{name: View{data: "c", len: 1}, dwarf: 0x1d};

val COUNT: usize            = 2;
val ROWS:  [COUNT]*Language = [COUNT]*Language{?MACH, ?C};

# how many rows mirl states
pub fun count() usize {
    ret COUNT;
}

# mirl's row at a position
pub fun at(index: usize) *Language {
    ret ROWS[index];
}

# whether two languages state the same name and code
pub fun same(a: *Language, b: *Language) bool {
    ret a.dwarf == b.dwarf && slice.same_view(a.name, b.name);
}

# what a name and code are among mirl's rows
# ---
# row:      the row that states both
# conflict: the row of the name, which states another code
# foreign:  no row has the name
pub tag Resolved: u8 {
    row:      *Language;
    conflict: *Language;
    foreign;
}

# resolve a name and code among mirl's rows
pub fun resolve(name: View, dwarf: u16) Resolved {
    var i: usize = 0;
    for (i < COUNT) {
        val r: *Language = ROWS[i];
        if (slice.same_view(r.name, name)) {
            if (r.dwarf == dwarf) { ret Resolved.row{r}; }
            ret Resolved.conflict{r};
        }
        i = i + 1;
    }
    ret Resolved.foreign{};
}
