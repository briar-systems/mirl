# whether a vector holds one value in every lane, read off how it is made
#
# a target's selection asks it of a shift's count, to choose the shorter form
# that shifts every lane by one count, as sse2's psll by a register: a splat,
# a build of one value or of constants of one bits, a constant whose lanes
# are one bits, or a load at offset zero of a constant global initialised
# with such a constant, as the pool makes one. nothing else is taken for one,
# whatever its lanes hold when it runs. what it answers picks instructions
# alone: whether a shift is packed is the vector legalisation's, by the
# operation and its lane types.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Constant;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.value.Def;

# whether two constants have the same bits, the shorter zero above
fun same_bits(m: *Module, a: Constant, b: Constant) bool {
    if (a == b) { ret true; }
    val res_a: res[ConstantData, module.Error] = module.constant_data(m, a);
    val res_b: res[ConstantData, module.Error] = module.constant_data(m, b);
    if (sel res_a.err)           { ret false; }
    if (sel res_b.err)           { ret false; }
    if (!(sel res_a.ok.integer)) { ret false; }
    if (!(sel res_b.ok.integer)) { ret false; }
    val x: Slice[u64] = res_a.ok.integer.words;
    val y: Slice[u64] = res_b.ok.integer.words;
    var n: usize      = x.size;
    if (y.size > n) { n = y.size; }
    var i: usize = 0;
    for (i < n) {
        var p: u64 = 0;
        var q: u64 = 0;
        if (i < x.size) { p = x.data[i]; }
        if (i < y.size) { q = y.data[i]; }
        if (p != q)     { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a constant is a vector whose lanes are one bits, or zero
fun constant(m: *Module, c: Constant) bool {
    val res_data: res[ConstantData, module.Error] = module.constant_data(m, c);
    if (sel res_data.err)             { ret false; }
    if (sel res_data.ok.zero)         { ret true; }
    if (!(sel res_data.ok.aggregate)) { ret false; }
    val each: Slice[Constant] = res_data.ok.aggregate.elements;
    var i:    usize           = 1;
    for (i < each.size) {
        if (!same_bits(m, each.data[0], each.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether an address is the start of a constant global initialised with a
# vector whose lanes are one bits
fun pooled(m: *Module, b: *Body, address: Value) bool {
    val def: Def = b.values.data[address].def;
    if (!(sel def.constant)) { ret false; }
    val res_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_data.err)                         { ret false; }
    if (!(sel res_data.ok.address))               { ret false; }
    if (res_data.ok.address.offset != 0)          { ret false; }
    if (!(sel res_data.ok.address.symbol.global)) { ret false; }
    val g: u32 = res_data.ok.address.symbol.global;
    if (g::usize >= m.globals.len)        { ret false; }
    if (!m.globals.data[g].data.constant) { ret false; }
    val initial: opt[Constant] = m.globals.data[g].data.initial;
    if (sel initial.none) { ret false; }
    ret constant(m, initial.some);
}

# whether a vector value of a body holds one value in every lane
# ---
# m:   the module
# b:   the body the value is of
# x:   the value
# ret: whether how it is made gives one value in every lane
pub fun uniform(m: *Module, b: *Body, x: Value) bool {
    val def: Def = b.values.data[x].def;
    if (sel def.constant)  { ret constant(m, def.constant); }
    if (!(sel def.result)) { ret false; }
    val d: *InstructionData = ?b.instructions.data[def.result.instruction];
    val c: u32              = d.opcode;
    if (c == opcode_table.VSPLAT)                      { ret true; }
    if (c == opcode_table.LOAD && d.operands.len == 1) { ret pooled(m, b, d.operands.data[0]); }
    if (c != opcode_table.VBUILD)                      { ret false; }
    var k: usize = 1;
    for (k < d.operands.len) {
        val first: Value = d.operands.data[0];
        val next:  Value = d.operands.data[k];
        if (first != next) {
            val df: Def = b.values.data[first].def;
            val dn: Def = b.values.data[next].def;
            if (!(sel df.constant))                      { ret false; }
            if (!(sel dn.constant))                      { ret false; }
            if (!same_bits(m, df.constant, dn.constant)) { ret false; }
        }
        k = k + 1;
    }
    ret true;
}
