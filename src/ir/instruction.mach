# instructions: an opcode applied to values, immediates and edges
#
# an instruction's typing, effects and secrecy are its opcode's row. the
# instruction holds only what differs between instances.

use std.allocator;

use mirl.fail.keep;
use std.collections.slice.Slice;
use std.collections.vector;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.id.Block;
use mirl.ir.id.Value;
use mirl.ir.metadata.Metadata;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.ir.point.Run;
use mirl.slice;

# an edge an instruction holds
# ---
# block:     the target
# arguments: one value per parameter of the target, in order
pub rec Edge {
    block:     Block;
    arguments: vector.Vector[Value];
}

# an edge an instruction is asked for
# ---
# block:     the target
# arguments: one value per parameter of the target, in order
pub rec Branch {
    block:     Block;
    arguments: Slice[Value];
}

# what an instruction is made from, one request record
# ---
# opcode:     its opcode
# operands:   the fixed operands then the tail, in order
# immediates: one per slot of the opcode's row
# targets:    one per target, in order
pub rec Request {
    opcode:     Opcode;
    operands:   Slice[Value];
    immediates: Slice[Immediate];
    targets:    Slice[Branch];
}

# where an instruction stands in its body
# ---
# detached: listed in no block, for its maker to place
# placed:   listed in this block
# erased:   taken out of the body, using nothing and used by nothing
pub tag Place: u8 {
    detached;
    placed: Block;
    erased;
}

# one instruction
# ---
# opcode:     its opcode
# place:      where it stands
# operands:   the fixed operands then the tail, in order
# immediates: one per slot of the opcode's row
# edges:      one per target, in order
# results:    its results, in order
# metadata:   its metadata record
# points:     the value binding records standing just before it, empty unless
#             it is placed
pub rec InstructionData {
    opcode:     Opcode;
    place:      Place;
    operands:   vector.Vector[Value];
    immediates: vector.Vector[Immediate];
    edges:      vector.Vector[Edge];
    results:    vector.Vector[Value];
    metadata:   Metadata;
    points:     Run;
}

# an immediate the instruction owns, whose lane list is its own copy
# ---
# a:   the allocator the instruction's lists use
# imm: the immediate asked for
# ret: the immediate to keep, or the allocator's refusal
pub fun own(a: *allocator.Allocator, imm: Immediate) res[Immediate, allocator.Error] {
    if (!(sel imm.lanes)) { ret res[Immediate, allocator.Error].ok{imm}; }
    val copied: res[Slice[u32], allocator.Error] = slice.copy[u32](a, imm.lanes);
    if (sel copied.err) { ret res[Immediate, allocator.Error].err{copied.err}; }
    ret res[Immediate, allocator.Error].ok{Immediate.lanes{copied.ok}};
}

# give back the lists an instruction owns
# ---
# d:   the instruction
# ret: ok, or the allocator's refusal of the first release that failed
pub fun release(d: *InstructionData) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < d.edges.len) {
        keep(?failed, vector.dnit[Value](?d.edges.data[i].arguments));
        i = i + 1;
    }
    i = 0;
    for (i < d.immediates.len) {
        if (sel d.immediates.data[i].lanes) { keep(?failed, slice.release[u32](d.immediates.a, d.immediates.data[i].lanes)); }
        i = i + 1;
    }
    keep(?failed, vector.dnit[Value](?d.operands));
    keep(?failed, vector.dnit[Immediate](?d.immediates));
    keep(?failed, vector.dnit[Edge](?d.edges));
    keep(?failed, vector.dnit[Value](?d.results));
    ret failed;
}
