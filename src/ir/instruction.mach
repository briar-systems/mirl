# instructions: an opcode applied to values, immediates and edges
#
# an instruction's typing, effects and secrecy are its opcode's row. the
# instruction holds only what differs between instances.

use std.allocator;

use mirl.base.fail.keep;
use std.collections.slice.Slice;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use mirl.base.slice;
use mirl.ir.assembly;
use mirl.ir.assembly.Assembly;
use mirl.ir.id.Block;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.metadata.Metadata;
use mirl.ir.native;
use mirl.ir.native.Op;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.place.Placed;
use mirl.ir.point.Run;

# a list an instruction holds, a run of its body's pools
# ---
# data: its first entry
# len:  how many entries it has
pub rec List[T] {
    data: *T;
    len:  usize;
}

# an edge an instruction holds
# ---
# block:     the target
# arguments: one value per parameter of the target, in order
# entries:   the position of each argument's entry in the use list of the
#            value it names, one per argument
# rank:      the position of the edge's entry in its target's predecessor
#            list
pub rec Edge {
    block:     Block;
    arguments: List[Value];
    entries:   List[u32];
    rank:      u32;
}

# an edge an instruction is asked for
# ---
# block:     the target
# arguments: one value per parameter of the target, in order
pub rec Branch {
    block:     Block;
    arguments: Slice[Value];
}

# what an instruction is made from, one request record
# ---
# opcode:     its opcode
# operands:   the fixed operands then the tail, in order
# immediates: one per slot of the opcode's row
# targets:    one per target, in order
pub rec Request {
    opcode:     Opcode;
    operands:   Slice[Value];
    immediates: Slice[Immediate];
    targets:    Slice[Branch];
}

# where an instruction stands in its body
# ---
# detached: listed in no block, for its maker to place
# placed:   listed in this block
# erased:   taken out of the body, using nothing and used by nothing
pub tag Place: u8 {
    detached;
    placed: Block;
    erased;
}

# one instruction
# ---
# opcode:     its opcode
# place:      where it stands
# operands:   the fixed operands then the tail, in order
# entries:    the position of each operand's entry in the use list of the
#             value it names, one per operand
# immediates: one per slot of the opcode's row
# edges:      one per target, in order
# results:    its results, in order
# metadata:   its metadata record
# points:     the value binding records standing just before it, empty unless
#             it is placed
# prev:       the instruction before it in its block, `NO_INSTRUCTION` for none.
#             read only while it is placed
# next:       the instruction after it in its block, `NO_INSTRUCTION` for none.
#             read only while it is placed
pub rec InstructionData {
    opcode:     Opcode;
    place:      Place;
    operands:   List[Value];
    entries:    List[u32];
    immediates: List[Immediate];
    edges:      List[Edge];
    results:    List[Value];
    metadata:   Metadata;
    points:     Run;
    prev:       Instruction;
    next:       Instruction;
}

# an immediate the instruction owns, whose lane, place or case list, block, target op or state spelling is its own
# copy
# ---
# a:   the allocator the instruction's lists use
# imm: the immediate asked for
# ret: the immediate to keep, or the allocator's refusal
pub fun own(a: *allocator.Allocator, imm: Immediate) res[Immediate, allocator.Error] {
    if (sel imm.places) {
        val res_placed: res[Slice[Placed], allocator.Error] = slice.copy[Placed](a, imm.places);
        if (sel res_placed.err) { ret res[Immediate, allocator.Error].err{res_placed.err}; }
        ret res[Immediate, allocator.Error].ok{Immediate.places{res_placed.ok}};
    }
    if (sel imm.assembly) {
        val res_block: res[*Assembly, allocator.Error] = assembly.copy(a, imm.assembly);
        if (sel res_block.err) { ret res[Immediate, allocator.Error].err{res_block.err}; }
        ret res[Immediate, allocator.Error].ok{Immediate.assembly{res_block.ok}};
    }
    if (sel imm.op) {
        val res_copy: res[*Op, allocator.Error] = native.copy(a, imm.op);
        if (sel res_copy.err) { ret res[Immediate, allocator.Error].err{res_copy.err}; }
        ret res[Immediate, allocator.Error].ok{Immediate.op{res_copy.ok}};
    }
    if (sel imm.state) {
        val res_named: res[View, allocator.Error] = slice.copy_view(a, imm.state);
        if (sel res_named.err) { ret res[Immediate, allocator.Error].err{res_named.err}; }
        ret res[Immediate, allocator.Error].ok{Immediate.state{res_named.ok}};
    }
    if (sel imm.cases) {
        val res_listed: res[Slice[u64], allocator.Error] = slice.copy[u64](a, imm.cases);
        if (sel res_listed.err) { ret res[Immediate, allocator.Error].err{res_listed.err}; }
        ret res[Immediate, allocator.Error].ok{Immediate.cases{res_listed.ok}};
    }
    if (!(sel imm.lanes)) { ret res[Immediate, allocator.Error].ok{imm}; }
    val res_copied: res[Slice[u32], allocator.Error] = slice.copy[u32](a, imm.lanes);
    if (sel res_copied.err) { ret res[Immediate, allocator.Error].err{res_copied.err}; }
    ret res[Immediate, allocator.Error].ok{Immediate.lanes{res_copied.ok}};
}

# give back what an instruction's immediates own, its lists going with its
# body's pools
# ---
# a:   the allocator of the instruction's module
# d:   the instruction
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(a: *allocator.Allocator, d: *InstructionData) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = 0;
    for (i < d.immediates.len) {
        if (sel d.immediates.data[i].lanes)    { keep(?err_failed, slice.free[u32](a, d.immediates.data[i].lanes)); }
        if (sel d.immediates.data[i].places)   { keep(?err_failed, slice.free[Placed](a, d.immediates.data[i].places)); }
        if (sel d.immediates.data[i].cases)    { keep(?err_failed, slice.free[u64](a, d.immediates.data[i].cases)); }
        if (sel d.immediates.data[i].assembly) { keep(?err_failed, assembly.dnit(a, d.immediates.data[i].assembly)); }
        if (sel d.immediates.data[i].op)       { keep(?err_failed, native.dnit(a, d.immediates.data[i].op)); }
        if (sel d.immediates.data[i].state)    { keep(?err_failed, slice.view_free(a, d.immediates.data[i].state)); }
        i = i + 1;
    }
    d.immediates.len = 0;
    ret err_failed;
}
