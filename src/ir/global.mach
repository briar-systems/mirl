# globals: storage a module names, with its initial value and placement

use std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use mink.model.section;

use mirl.ir.attribute.Attribute;
use mirl.ir.id.Constant;
use mirl.ir.linkage.Linkage;
use mirl.ir.type.Type;

# how a thread-local global is reached
# ---
# general_dynamic: from any module, through the runtime's lookup
# local_dynamic:   from its own module, through the runtime's lookup
# initial_exec:    from a module loaded at start, at an offset fixed at load
# local_exec:      from the executable itself, at an offset fixed at link
pub tag Tls: u8 {
    general_dynamic;
    local_dynamic;
    initial_exec;
    local_exec;
}

# a section a global names
# ---
# name: its name
# kind: the role it plays, a row of mink's section kinds
pub rec Section {
    name: View;
    kind: *section.Kind;
}

# one global
#
# a name given to a module is copied, and one read back stays valid for the
# life of the module.
# ---
# name:      its symbol name
# type:      the type of what it stores
# initial:   its initial value, a constant of its type, or none when another
#            module defines it
# alignment: its alignment in bytes, a power of two, or none for the data
#            layout's alignment of its type
# section:   the section it is placed in, or none for the one its other
#            facts pick
# tls:       how it is reached when thread-local, or none when it is not
# linkage:   how far it is seen
# constant:  the program never writes it
pub rec GlobalData {
    name:      View;
    type:      Type;
    initial:   opt[Constant];
    alignment: opt[u64];
    section:   opt[Section];
    tls:       opt[Tls];
    linkage:   Linkage;
    constant:  bool;
}

# a global as its module holds it
# ---
# data:       what it is
# attributes: the attributes attached to it
pub rec Node {
    data:       GlobalData;
    attributes: vector.Vector[Attribute];
}

# whether a section kind is one of mink's rows
pub fun kind_row(k: *section.Kind) bool {
    var i: usize = 0;
    for (i < section.count()) {
        if (section.at(i) == k) { ret true; }
        i = i + 1;
    }
    ret false;
}
