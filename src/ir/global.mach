# globals: storage a module names, with its initial value and placement

use std.collections.vector;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;

use mink.model.section;

use mirl.ir.attribute.Attribute;
use mirl.ir.debug.record.Binding;
use mirl.ir.id.Constant;
use mirl.ir.linkage.Linkage;
use mirl.ir.type.Type;

# how a thread-local global is reached
# ---
# general_dynamic: from any module, through the runtime's lookup
# local_dynamic:   from its own module, through the runtime's lookup
# initial_exec:    from a module loaded at start, at an offset fixed at load
# local_exec:      from the executable itself, at an offset fixed at link
pub tag Tls: u8 {
    general_dynamic;
    local_dynamic;
    initial_exec;
    local_exec;
}

# a section a global or function names
# ---
# name: its name
# kind: the role it plays, a row of mink's section kinds
pub rec Section {
    name: View;
    kind: *section.Kind;
}

# a byte range of a global's storage
# ---
# offset: its first byte, from the global's start
# length: how many bytes it covers, never 0
pub rec Range {
    offset: u64;
    length: u64;
}

# how much of a global is secret, at the granularity of a value's type: the
# whole global, or the byte ranges of an aggregate's secret fields and
# elements. a secret global's initial value is public, as a module's constant
# is, and its bytes are secret once the program runs
# ---
# public: none of it
# whole:  every byte
# ranges: the bytes of these ranges, at least one, ascending and none
#         overlapping or touching another
pub tag Secrecy: u8 {
    public;
    whole;
    ranges: Slice[Range];
}

# one global
#
# a name, section or range list given to a module is copied, and one read back
# stays valid for the life of the module.
# ---
# name:      its symbol name
# type:      the type of what it stores
# initial:   its initial value, a constant of its type, or none when another
#            module defines it
# alignment: its alignment in bytes, a power of two, or none for the data
#            layout's alignment of its type
# section:   the section it is placed in, or none for the one its other
#            facts pick
# tls:       how it is reached when thread-local, or none when it is not
# linkage:   how far it is seen
# constant:  the program never writes it
# secret:    how much of it is secret
# debug:     the source variable it is, a binding of the module's debug table
#            with no parameter position, or none when no source describes it
pub rec GlobalData {
    name:      View;
    type:      Type;
    initial:   opt[Constant];
    alignment: opt[u64];
    section:   opt[Section];
    tls:       opt[Tls];
    linkage:   Linkage;
    constant:  bool;
    secret:    Secrecy;
    debug:     opt[Binding];
}

# a global as its module holds it
# ---
# data:       what it is
# attributes: the attributes attached to it
pub rec Node {
    data:       GlobalData;
    attributes: vector.Vector[Attribute];
}

# whether a global states any secret byte
pub fun secret(d: *GlobalData) bool {
    ret !(sel d.secret.public);
}

# whether the bytes `offset` to `offset + length` of a global of `size` bytes may share one with a secret range of
# `d`, none for an offset that is not known, which may reach any
pub fun overlaps(d: *GlobalData, size: u64, offset: opt[i64], length: u64) bool {
    val s: Secrecy = d.secret;
    if (sel s.public)    { ret false; }
    if (sel offset.none) { ret true; }
    val lo: i64 = offset.some;
    val hi: i64 = lo + length::i64;
    if (sel s.ranges) {
        var i: usize = 0;
        for (i < s.ranges.size) {
            val r: Range = s.ranges.data[i];
            if (lo < (r.offset + r.length)::i64 && r.offset::i64 < hi) { ret true; }
            i = i + 1;
        }
        ret false;
    }
    ret hi > 0 && lo < size::i64;
}

# whether a range list is one a global may state: at least one range, each of some bytes, ascending, none overlapping
# or touching the one before it, so a set of bytes has one spelling
pub fun canonical(ranges: Slice[Range]) bool {
    if (ranges.size == 0) { ret false; }
    var i: usize = 0;
    for (i < ranges.size) {
        val r: Range = ranges.data[i];
        if (r.length == 0)                  { ret false; }
        if (r.offset + r.length < r.offset) { ret false; }
        if (i > 0) {
            val before: Range = ranges.data[i - 1];
            if (r.offset <= before.offset + before.length) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

# whether a section kind is one of mink's rows
pub fun kind_row(k: *section.Kind) bool {
    var i: usize = 0;
    for (i < section.count()) {
        if (section.at(i) == k) { ret true; }
        i = i + 1;
    }
    ret false;
}
