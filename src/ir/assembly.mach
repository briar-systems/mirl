# inline assembly items: an opaque block of target assembly and what it binds
#
# a block is text masc reads in the target's set, never mirl. each of its
# operands is named in the text as `{name}`, states what it may be placed in
# as masc's constraint states it and how the block uses it, and binds one
# value of the type it states. an operand the block reads binds an operand of
# the instruction, the fixed and tail operands in the order the block states
# them, and so does every memory and immediate operand: a memory operand's
# value is the address the block reaches memory through and an immediate's a
# constant. an operand of a register class the block writes binds a result,
# the results in the order the block states them, so a register the block
# reads and writes binds both, of one type. an operand placed by its value
# binds as a register does, and selection places it: as an immediate where
# the value is a constant the instruction takes there, in a register of the
# class it holds the type in where the instruction takes one at every name,
# and otherwise in memory it puts the value in for the block and reads it
# back from. the block states what it reads
# and writes of memory beyond its memory operands, which masc's footprint of
# it must not exceed, so a pass reads the item by its declared effects alone.
# a block may state a selection, a spelling of the set's own that mirl hands
# masc unchanged, whose extensions it may use past its function's
# (`mirl.target.head`).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.type.table.Type;

use mo: masc.core.operand;
use masc.inline;

# the most operands one block binds, which bounds the places one item's
# memory effect holds and so the pairs `memory.conflicts` compares
pub val MOST_OPERANDS: u32 = 30;

# an operand of a block
# ---
# name:      how the text names it, without its braces
# role:      how the block uses it, as masc's operand roles state: a register
#            read, written or both, the memory an address reaches read,
#            written or both, and an immediate read
# placement: what it may be placed in
# ty:        the type of the value it binds
# points:    of memory holding a pointer, what the pointer's type states of the storage it reaches, which a load of
#            the pointer from it leaves the address the block reaches that storage by
pub rec Operand {
    name:      View;
    role:      mo.Role;
    placement: Placement;
    ty:        Type;
    points:    Points;
}

# what an operand of a block may be placed in
# ---
# stated: what masc's constraint states, never a chosen one
# value:  what selection chooses by the value it binds: an immediate, a register of its class or memory
pub tag Placement: u8 {
    stated: inline.Constraint;
    value;
}

# whether an operand is placed in a register for the value it binds or one it gives: a register class's, and one
# placed by its value
fun registered(o: *Operand) bool {
    if (sel o.placement.value) { ret true; }
    ret sel o.placement.stated.class;
}

# whether an operand is stated to be memory
pub fun memory(o: *Operand) bool {
    ret sel o.placement.stated && sel o.placement.stated.memory;
}

# what the type of a pointer an operand's memory holds states of the storage the pointer reaches
# ---
# unstated: nothing, as of memory holding no pointer, or a pointer to storage holding a secret in some bytes and not
#           in others
# public:   it holds no secret
# secret:   every byte of it holds a secret
pub tag Points: u8 {
    unstated;
    public;
    secret;
}

# whether two statements of what a pointer reaches are the same
pub fun same_points(a: Points, b: Points) bool {
    if (sel a.public) { ret sel b.public; }
    if (sel a.secret) { ret sel b.secret; }
    ret sel b.unstated;
}

# one block
# ---
# text:      its text in the set's source dialect
# operands:  its operands, in the order the text's names and the
#            instruction's values follow
# reads:     it reads memory beyond its memory operands
# writes:    it writes memory beyond its memory operands
# selection: the selection it states in masc's spelling of the set's, as
#            `x86-64,avx2`, empty for none, which reads it under its function's
#            context alone
pub rec Assembly {
    text:      View;
    operands:  Slice[Operand];
    reads:     bool;
    writes:    bool;
    selection: View;
}

# whether operand `o` binds an operand of the instruction: one the block
# reads, and every memory and immediate operand
pub fun takes(o: *Operand) bool {
    if (registered(o)) { ret (o.role & mo.READ) != 0; }
    ret true;
}

# whether operand `o` binds a result of the instruction: a register the block writes, or one placed by its value
pub fun gives(o: *Operand) bool {
    ret registered(o) && (o.role & mo.WRITE) != 0;
}

# how many operands of the instruction a block binds
pub fun taken(b: *Assembly) u32 {
    var n: u32   = 0;
    var k: usize = 0;
    for (k < b.operands.size) {
        if (takes(?b.operands.data[k])) { n = n + 1; }
        k = k + 1;
    }
    ret n;
}

# whether two placements are the same
pub fun same_placement(a: Placement, b: Placement) bool {
    if (sel a.value)  { ret sel b.value; }
    if (sel b.stated) { ret same_constraint(a.stated, b.stated); }
    ret false;
}

# whether two constraints are the same
pub fun same_constraint(a: inline.Constraint, b: inline.Constraint) bool {
    if (sel a.class) {
        if (sel b.class) { ret a.class == b.class; }
        ret false;
    }
    if (sel a.memory) { ret sel b.memory; }
    if (sel a.immediate) {
        if (sel b.immediate) { ret a.immediate.bits == b.immediate.bits && a.immediate.signed == b.immediate.signed && a.immediate.symbolic == b.immediate.symbolic; }
    }
    ret false;
}

# a block copied into storage of its own, itself, its text, operand list and names
pub fun copy(a: *allocator.Allocator, b: *Assembly) res[*Assembly, allocator.Error] {
    val res_held: res[*Assembly, allocator.Error] = allocator.allocate[Assembly](a, 1);
    if (sel res_held.err) { ret res_held; }
    val out: *Assembly = res_held.ok;
    out.text      = View{data: nil, len: 0};
    out.operands  = Slice[Operand]{data: nil, size: 0};
    out.reads     = b.reads;
    out.writes    = b.writes;
    out.selection = View{data: nil, len: 0};
    val res_text: res[View, allocator.Error] = slice.copy_view(a, b.text);
    if (sel res_text.err) {
        allocator.deallocate[Assembly](a, out, 1);
        ret res[*Assembly, allocator.Error].err{res_text.err};
    }
    out.text = res_text.ok;
    val res_selection: res[View, allocator.Error] = slice.copy_view(a, b.selection);
    if (sel res_selection.err) {
        dnit(a, out);
        ret res[*Assembly, allocator.Error].err{res_selection.err};
    }
    out.selection = res_selection.ok;
    val res_listed: res[Slice[Operand], allocator.Error] = slice.copy[Operand](a, b.operands);
    if (sel res_listed.err) {
        dnit(a, out);
        ret res[*Assembly, allocator.Error].err{res_listed.err};
    }
    var k: usize = 0;
    for (k < res_listed.ok.size) {
        res_listed.ok.data[k].name = View{data: nil, len: 0};
        k                          = k + 1;
    }
    out.operands = res_listed.ok;
    k            = 0;
    for (k < res_listed.ok.size) {
        val res_name: res[View, allocator.Error] = slice.copy_view(a, b.operands.data[k].name);
        if (sel res_name.err) {
            dnit(a, out);
            ret res[*Assembly, allocator.Error].err{res_name.err};
        }
        res_listed.ok.data[k].name = res_name.ok;
        k                          = k + 1;
    }
    ret res[*Assembly, allocator.Error].ok{out};
}

# give back what `copy` made, the block itself with it
pub fun dnit(a: *allocator.Allocator, b: *Assembly) err[allocator.Error] {
    var err_failed: err[allocator.Error] = slice.view_free(a, b.text);
    keep(?err_failed, slice.view_free(a, b.selection));
    var k: usize = 0;
    for (k < b.operands.size) {
        keep(?err_failed, slice.view_free(a, b.operands.data[k].name));
        k = k + 1;
    }
    keep(?err_failed, slice.free[Operand](a, b.operands));
    keep(?err_failed, allocator.deallocate[Assembly](a, b, 1));
    ret err_failed;
}
