# inline assembly items: an opaque block of target assembly and what it binds
#
# a block is text masc reads in the target's set, never mirl. each of its
# operands is named in the text as `{name}`, states what it may be placed in
# as masc's constraint states it and how the block uses it, and binds one
# value of the type it states. an operand the block reads binds an operand of
# the instruction, the fixed and tail operands in the order the block states
# them, and so does every memory and immediate operand: a memory operand's
# value is the address the block reaches memory through and an immediate's a
# constant. an operand of a register class the block writes binds a result,
# the results in the order the block states them, so a register the block
# reads and writes binds both, of one type. the block states what it reads
# and writes of memory beyond its memory operands, which masc's footprint of
# it must not exceed, so a pass reads the item by its declared effects alone.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.type.Type;

use mo: masc.core.operand;
use masc.inline.inline;

# the most operands one block binds, which bounds the places one item's
# memory effect holds and so the pairs `memory.conflicts` compares
pub val MOST_OPERANDS: u32 = 30;

# an operand of a block
# ---
# name:       how the text names it, without its braces
# role:       how the block uses it, as masc's operand roles state: a register
#             read, written or both, the memory an address reaches read,
#             written or both, and an immediate read
# constraint: what it may be placed in, as masc's constraint states it
# ty:         the type of the value it binds
pub rec Operand {
    name:       View;
    role:       mo.Role;
    constraint: inline.Constraint;
    ty:         Type;
}

# one block
# ---
# text:     its text in the set's source dialect
# operands: its operands, in the order the text's names and the
#           instruction's values follow
# reads:    it reads memory beyond its memory operands
# writes:   it writes memory beyond its memory operands
pub rec Assembly {
    text:     View;
    operands: Slice[Operand];
    reads:    bool;
    writes:   bool;
}

# whether operand `o` binds an operand of the instruction: one the block
# reads, and every memory and immediate operand
pub fun takes(o: *Operand) bool {
    if (sel o.constraint.class) { ret (o.role & mo.READ) != 0; }
    ret true;
}

# whether operand `o` binds a result of the instruction: a register the block writes
pub fun gives(o: *Operand) bool {
    ret sel o.constraint.class && (o.role & mo.WRITE) != 0;
}

# how many operands of the instruction a block binds
pub fun taken(b: *Assembly) u32 {
    var n: u32   = 0;
    var k: usize = 0;
    for (k < b.operands.size) {
        if (takes(?b.operands.data[k])) { n = n + 1; }
        k = k + 1;
    }
    ret n;
}

# whether two constraints are the same
pub fun same_constraint(a: inline.Constraint, b: inline.Constraint) bool {
    if (sel a.class) {
        if (sel b.class) { ret a.class == b.class; }
        ret false;
    }
    if (sel a.memory) { ret sel b.memory; }
    if (sel a.immediate) {
        if (sel b.immediate) { ret a.immediate.bits == b.immediate.bits && a.immediate.signed == b.immediate.signed && a.immediate.symbolic == b.immediate.symbolic; }
    }
    ret false;
}

# a block copied into storage of its own, itself, its text, operand list and names
pub fun copy(a: *allocator.Allocator, b: *Assembly) res[*Assembly, allocator.Error] {
    val held: res[*Assembly, allocator.Error] = allocator.allocate[Assembly](a, 1);
    if (sel held.err) { ret held; }
    val out: *Assembly = held.ok;
    out.text     = View{data: nil, len: 0};
    out.operands = Slice[Operand]{data: nil, size: 0};
    out.reads    = b.reads;
    out.writes   = b.writes;
    val text: res[View, allocator.Error] = slice.copy_view(a, b.text);
    if (sel text.err) {
        allocator.deallocate[Assembly](a, out, 1);
        ret res[*Assembly, allocator.Error].err{text.err};
    }
    out.text = text.ok;
    val listed: res[Slice[Operand], allocator.Error] = slice.copy[Operand](a, b.operands);
    if (sel listed.err) {
        release(a, out);
        ret res[*Assembly, allocator.Error].err{listed.err};
    }
    var k: usize = 0;
    for (k < listed.ok.size) {
        listed.ok.data[k].name = View{data: nil, len: 0};
        k                      = k + 1;
    }
    out.operands = listed.ok;
    k            = 0;
    for (k < listed.ok.size) {
        val name: res[View, allocator.Error] = slice.copy_view(a, b.operands.data[k].name);
        if (sel name.err) {
            release(a, out);
            ret res[*Assembly, allocator.Error].err{name.err};
        }
        listed.ok.data[k].name = name.ok;
        k                      = k + 1;
    }
    ret res[*Assembly, allocator.Error].ok{out};
}

# give back what `copy` made, the block itself with it
pub fun release(a: *allocator.Allocator, b: *Assembly) err[allocator.Error] {
    var failed: err[allocator.Error] = slice.release_view(a, b.text);
    var k:      usize                = 0;
    for (k < b.operands.size) {
        keep(?failed, slice.release_view(a, b.operands.data[k].name));
        k = k + 1;
    }
    keep(?failed, slice.release[Operand](a, b.operands));
    keep(?failed, allocator.deallocate[Assembly](a, b, 1));
    ret failed;
}
