# copies of blocks: a region of a function's blocks, or its whole body, made in
# the same function or another through the builder
#
# each copied block takes its source's parameters, and each copied instruction
# its source's whole metadata record, with every value and block of the region
# read through the map. a value from outside the region stands for itself in
# the same function, and must be bound in the map in another, except a
# constant, whose value in the copy's function stands for it. the copies keep
# the source's inlining site, and an inliner sets its own on them. each copied
# block takes its source's value binding records at the same positions among
# its instructions, each reading through the map as an operand does.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build.builder;
use mirl.build.builder.Builder;
use mirl.build.failure;
use mirl.build.remap;
use mirl.build.remap.Remap;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.cfg.failure.Error;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.instruction.Place;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.point.Point;
use mirl.ir.point.Run;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;

fun alloc(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.ir{module.Error.alloc{e}}};
}

# the copies of the region's blocks, in the region's order
rec Work {
    blocks: vector.Vector[Block];
}

# a value used before its copy can be made: defined by an instruction of the
# region and not yet bound
fun waiting(fb: *Body, inside: *vector.Vector[bool], r: *Remap, v: Value) bool {
    val opt_bound: opt[Value] = remap.value(r, v);
    if (sel opt_bound.some) { ret false; }
    val def: Def = fb.values.data[v].def;
    if (!(sel def.result)) { ret false; }
    val at: Place = fb.instructions.data[def.result.instruction].place;
    if (!(sel at.placed)) { ret false; }
    ret at.placed::usize < inside.len && inside.data[at.placed];
}

# the first value an instruction uses before its copy can be made
fun unready(fb: *Body, inside: *vector.Vector[bool], r: *Remap, i: Instruction) opt[Value] {
    val d: *InstructionData = ?fb.instructions.data[i];
    var k: usize            = 0;
    for (k < d.operands.len) {
        if (waiting(fb, inside, r, d.operands.data[k])) { ret opt[Value].some{d.operands.data[k]}; }
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val args: *List[Value] = ?d.edges.data[e].arguments;
        k = 0;
        for (k < args.len) {
            if (waiting(fb, inside, r, args.data[k])) { ret opt[Value].some{args.data[k]}; }
            k = k + 1;
        }
        e = e + 1;
    }
    ret opt[Value].none{};
}

# copy each region block as an empty block with its source's parameters, bound
# in r, where w has room for every copy
fun blocks_make(m: *Module, b: *Builder, from: Function, region: *vector.Vector[Block], r: *Remap, w: *Work) err[Error] {
    var decls: vector.Vector[Declaration] = vector.init[Declaration](m.a);
    fin { vector.dnit[Declaration](?decls); }
    var i: usize = 0;
    for (i < region.len) {
        val k:              Block                        = region.data[i];
        val res_block_data: res[BlockData, module.Error] = body.block_data(m, from, k);
        if (sel res_block_data.err) { ret err[Error].err{Error.ir{res_block_data.err}}; }
        vector.truncate[Declaration](?decls, 0);
        var j: usize = 0;
        for (j < res_block_data.ok.parameters.len) {
            val res_value_data: res[ValueData, module.Error] = body.value_data(m, from, res_block_data.ok.parameters.data[j]);
            if (sel res_value_data.err) { ret err[Error].err{Error.ir{res_value_data.err}}; }
            val res_pushed: res[usize, allocator.Error] = vector.push[Declaration](?decls, Declaration{type: res_value_data.ok.type, secret: res_value_data.ok.secret});
            if (sel res_pushed.err) { ret alloc(res_pushed.err); }
            j = j + 1;
        }
        val copy:      Block              = builder.block(b, Slice[Declaration]{data: decls.data, size: decls.len});
        val err_built: err[failure.Error] = builder.done(b);
        if (sel err_built.err) { ret err[Error].err{Error.build{err_built.err}}; }
        vector.push[Block](?w.blocks, copy);
        val err_bound: err[allocator.Error] = remap.bind_block(r, k, copy);
        if (sel err_bound.err) { ret alloc(err_bound.err); }
        j = 0;
        for (j < decls.len) {
            val p:              Value                = builder.parameter(b, copy, j::u32);
            val err_bind_value: err[allocator.Error] = remap.bind_value(r, res_block_data.ok.parameters.data[j], p);
            if (sel err_bind_value.err) { ret alloc(err_bind_value.err); }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# copy every instruction of the region, each once the values it uses have copies
fun fill(m: *Module, b: *Builder, from: Function, region: *vector.Vector[Block], inside: *vector.Vector[bool], r: *Remap, w: *Work) err[Error] {
    var done: vector.Vector[usize] = vector.init[usize](m.a);
    fin { vector.dnit[usize](?done); }
    val res_room: res[usize, allocator.Error] = vector.reserve[usize](?done, region.len);
    if (sel res_room.err) { ret alloc(res_room.err); }
    var i: usize = 0;
    for (i < region.len) {
        vector.push[usize](?done, 0);
        i = i + 1;
    }
    var left: bool = true;
    for (left) {
        left = false;
        var moved: bool  = false;
        var stuck: Value = 0;
        var seen:  bool  = false;
        i = 0;
        for (i < region.len) {
            val res_body: res[*Body, module.Error] = module.body(m, from);
            if (sel res_body.err) { ret err[Error].err{Error.ir{res_body.err}}; }
            val fb: *Body = res_body.ok;
            builder.at_end(b, w.blocks.data[i]);
            for (done.data[i] < fb.blocks.data[region.data[i]].instructions.len) {
                val src:      Instruction = fb.blocks.data[region.data[i]].instructions.data[done.data[i]];
                val opt_wait: opt[Value]  = unready(fb, inside, r, src);
                if (sel opt_wait.some) {
                    if (!seen) {
                        stuck = opt_wait.some;
                        seen  = true;
                    }
                    left = true;
                    brk;
                }
                builder.copy(b, from, src, r);
                val err_built: err[failure.Error] = builder.done(b);
                if (sel err_built.err) { ret err[Error].err{Error.build{err_built.err}}; }
                done.data[i] = done.data[i] + 1;
                moved        = true;
            }
            i = i + 1;
        }
        if (left && !moved) { ret err[Error].err{Error.undefined{stuck}}; }
    }
    ret err[Error].ok{};
}

# copy every value binding record of the region, each at its source's position
# among its block's instructions, once every instruction is copied
fun bind(m: *Module, b: *Builder, from: Function, region: *vector.Vector[Block], r: *Remap, w: *Work) err[Error] {
    var i: usize = 0;
    for (i < region.len) {
        val res_body: res[*Body, module.Error] = module.body(m, from);
        if (sel res_body.err) { ret err[Error].err{Error.ir{res_body.err}}; }
        val count: usize = res_body.ok.blocks.data[region.data[i]].instructions.len;
        var at:    usize = 0;
        for (at <= count) {
            val res_held: res[*Body, module.Error] = module.body(m, from);
            if (sel res_held.err) { ret err[Error].err{Error.ir{res_held.err}}; }
            val src: *BlockData = ?res_held.ok.blocks.data[region.data[i]];
            var run: Run        = src.ending;
            if (at < count) { run = res_held.ok.instructions.data[src.instructions.data[at]].points; }
            var next: u32 = run.first;
            for (next != 0) {
                # the copy may grow the body's records, so each is read anew
                val res_now: res[*Body, module.Error] = module.body(m, from);
                if (sel res_now.err) { ret err[Error].err{Error.ir{res_now.err}}; }
                val pt: Point = res_now.ok.points.data[next - 1];
                builder.at(b, w.blocks.data[i], at::u32);
                builder.copy_binding(b, from, pt, r);
                val err_built: err[failure.Error] = builder.done(b);
                if (sel err_built.err) { ret err[Error].err{Error.build{err_built.err}}; }
                next = pt.next;
            }
            at = at + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# copy a region of a function's blocks into a function, the same one or another
#
# a refusal leaves the body of to exactly as it was, and r with bindings to
# copies that no longer exist.
# ---
# m:      the module
# from:   the function the region is in
# to:     the function the copies are made in
# blocks: the region, each block once
# r:      the map, read for values from outside the region and given every
#         source block, parameter and result of the region bound to its copy
# ret:    ok, or why it was refused
pub fun region(m: *Module, from: Function, to: Function, blocks: Slice[Block], r: *Remap) err[Error] {
    val res_body: res[*Body, module.Error] = module.body(m, from);
    if (sel res_body.err) { ret err[Error].err{Error.ir{res_body.err}}; }
    var inside: vector.Vector[bool]  = vector.init[bool](m.a);
    var list:   vector.Vector[Block] = vector.init[Block](m.a);
    var w:      Work                 = Work{blocks: vector.init[Block](m.a)};
    fin {
        vector.dnit[bool](?inside);
        vector.dnit[Block](?list);
        vector.dnit[Block](?w.blocks);
    }
    val count:       usize                       = res_body.ok.blocks.len;
    val res_reserve: res[usize, allocator.Error] = vector.reserve[bool](?inside, count);
    if (sel res_reserve.err) { ret alloc(res_reserve.err); }
    val res_reserve_list: res[usize, allocator.Error] = vector.reserve[Block](?list, blocks.size);
    if (sel res_reserve_list.err) { ret alloc(res_reserve_list.err); }
    val res_reserve_blocks: res[usize, allocator.Error] = vector.reserve[Block](?w.blocks, blocks.size);
    if (sel res_reserve_blocks.err) { ret alloc(res_reserve_blocks.err); }
    var i: usize = 0;
    for (i < count) {
        vector.push[bool](?inside, false);
        i = i + 1;
    }
    i = 0;
    for (i < blocks.size) {
        val k: Block = blocks.data[i];
        if (k::usize >= count)                 { ret err[Error].err{Error.ir{module.Error.block{k}}}; }
        if (res_body.ok.blocks.data[k].erased) { ret err[Error].err{Error.ir{module.Error.removed{k}}}; }
        if (!inside.data[k]) {
            inside.data[k] = true;
            vector.push[Block](?list, k);
        }
        i = i + 1;
    }

    val res_start: res[body.Mark, module.Error] = body.mark(m, to);
    if (sel res_start.err) { ret err[Error].err{Error.ir{res_start.err}}; }
    var b: Builder = builder.make(m);
    builder.enter(?b, to);
    val err_opened: err[Error] = blocks_make(m, ?b, from, ?list, r, ?w);
    if (sel err_opened.err) {
        body.rewind(m, to, res_start.ok);
        ret err_opened;
    }
    val err_filled: err[Error] = fill(m, ?b, from, ?list, ?inside, r, ?w);
    if (sel err_filled.err) {
        body.rewind(m, to, res_start.ok);
        ret err_filled;
    }
    val err_bound: err[Error] = bind(m, ?b, from, ?list, r, ?w);
    if (sel err_bound.err) { body.rewind(m, to, res_start.ok); }
    ret err_bound;
}

# copy every block of a function's body into another function, as `region`
pub fun whole(m: *Module, from: Function, to: Function, r: *Remap) err[Error] {
    val res_body: res[*Body, module.Error] = module.body(m, from);
    if (sel res_body.err) { ret err[Error].err{Error.ir{res_body.err}}; }
    var list: vector.Vector[Block] = vector.init[Block](m.a);
    fin { vector.dnit[Block](?list); }
    var i: usize = 0;
    for (i < res_body.ok.blocks.len) {
        if (!res_body.ok.blocks.data[i].erased) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Block](?list, (i::u32));
            if (sel res_pushed.err) { ret alloc(res_pushed.err); }
        }
        i = i + 1;
    }
    ret region(m, from, to, Slice[Block]{data: list.data, size: list.len}, r);
}
