# edges: giving an edge a block of its own, and a set of edges one block to enter through
#
# a branch passes one argument per parameter of its target, and both edits keep
# them in step: a split edge's block takes the arguments the edge carried as
# its parameters, each as secret as the value it receives, and forwards them.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build.builder;
use mirl.build.builder.Builder;
use mirl.build.failure;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.cfg.failure.Error;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.instruction.Request;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row;
use mirl.ir.opcode.table;
use mirl.ir.value.Declaration;
use mirl.ir.value.ValueData;

fun refused[T](e: module.Error) res[T, Error] {
    ret res[T, Error].err{Error.ir{e}};
}

fun alloc[T](e: allocator.Error) res[T, Error] {
    ret refused[T](module.Error.alloc{e});
}

fun request(code: row.Opcode, operands: Slice[Value], targets: Slice[Branch]) Request {
    ret Request{opcode: code, operands: operands, immediates: Slice[row.Immediate]{data: nil, size: 0}, targets: targets};
}

# give an edge a block of its own, which takes the arguments the edge carried
# and forwards them to the edge's old target
# ---
# m:    the module
# f:    the function
# i:    the instruction holding the edge
# edge: the edge's position among its edges
# ret:  the new block, or why it was refused, the body left as it was
pub fun split(m: *Module, f: Function, i: Instruction, edge: u32) res[Block, Error] {
    val res_src: res[InstructionData, module.Error] = body.instruction_data(m, f, i);
    if (sel res_src.err)                     { ret refused[Block](res_src.err); }
    if (edge::usize >= res_src.ok.edges.len) { ret refused[Block](module.Error.edge{edge}); }
    val target: Block       = res_src.ok.edges.data[edge].block;
    val passed: List[Value] = res_src.ok.edges.data[edge].arguments;

    var carried: vector.Vector[Value]       = vector.init[Value](m.a);
    var decls:   vector.Vector[Declaration] = vector.init[Declaration](m.a);
    var params:  vector.Vector[Value]       = vector.init[Value](m.a);
    fin {
        vector.dnit[Value](?carried);
        vector.dnit[Declaration](?decls);
        vector.dnit[Value](?params);
    }
    val res_reserve: res[usize, allocator.Error] = vector.reserve[Value](?carried, passed.len);
    if (sel res_reserve.err) { ret alloc[Block](res_reserve.err); }
    val res_reserve_decls: res[usize, allocator.Error] = vector.reserve[Declaration](?decls, passed.len);
    if (sel res_reserve_decls.err) { ret alloc[Block](res_reserve_decls.err); }
    val res_reserve_params: res[usize, allocator.Error] = vector.reserve[Value](?params, passed.len);
    if (sel res_reserve_params.err) { ret alloc[Block](res_reserve_params.err); }
    var j: usize = 0;
    for (j < passed.len) {
        val res_value_data: res[ValueData, module.Error] = body.value_data(m, f, passed.data[j]);
        if (sel res_value_data.err) { ret refused[Block](res_value_data.err); }
        vector.push[Value](?carried, passed.data[j]);
        vector.push[Declaration](?decls, Declaration{type: res_value_data.ok.type, secret: res_value_data.ok.secret});
        j = j + 1;
    }

    val res_start: res[body.Mark, module.Error] = body.mark(m, f);
    if (sel res_start.err) { ret refused[Block](res_start.err); }
    var b: Builder = builder.make(m);
    builder.enter(?b, f);
    builder.derive(?b, i);
    val s: Block = builder.block(?b, Slice[Declaration]{data: decls.data, size: decls.len});
    builder.at_end(?b, s);
    j = 0;
    for (j < decls.len) {
        vector.push[Value](?params, builder.parameter(?b, s, j::u32));
        j = j + 1;
    }
    var to: [1]Branch = [1]Branch{Branch{block: target, arguments: Slice[Value]{data: params.data, size: params.len}}};
    builder.emit(?b, request(table.BR, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: ?to[0], size: 1}));
    val err_built: err[failure.Error] = builder.done(?b);
    if (sel err_built.err) {
        body.rewind(m, f, res_start.ok);
        ret res[Block, Error].err{Error.build{err_built.err}};
    }

    val err_moved: err[module.Error] = body.retarget(m, f, i, edge, s, Slice[Value]{data: carried.data, size: carried.len});
    if (sel err_moved.err) {
        body.rewind(m, f, res_start.ok);
        ret refused[Block](err_moved.err);
    }
    ret res[Block, Error].ok{s};
}

# give a set of edges into one block a block of their own to enter through,
# which takes the arguments the edges carry as its parameters, declared as the
# target's are, and forwards them to the target
# ---
# m:       the module
# f:       the function
# target:  the block every edge enters
# sources: the edges, at least one, each into the target
# ret:     the new block, or why it was refused, the body left as it was
pub fun gather(m: *Module, f: Function, target: Block, sources: Slice[body.Source]) res[Block, Error] {
    if (sources.size == 0) { ret refused[Block](module.Error.edge{0}); }
    val res_block_data: res[BlockData, module.Error] = body.block_data(m, f, target);
    if (sel res_block_data.err) { ret refused[Block](res_block_data.err); }
    var j: usize = 0;
    for (j < sources.size) {
        val res_src: res[InstructionData, module.Error] = body.instruction_data(m, f, sources.data[j].branch);
        if (sel res_src.err)                                             { ret refused[Block](res_src.err); }
        if (sources.data[j].edge::usize >= res_src.ok.edges.len)         { ret refused[Block](module.Error.edge{sources.data[j].edge}); }
        if (res_src.ok.edges.data[sources.data[j].edge].block != target) { ret refused[Block](module.Error.reached{target}); }
        j = j + 1;
    }

    var decls:  vector.Vector[Declaration] = vector.init[Declaration](m.a);
    var params: vector.Vector[Value]       = vector.init[Value](m.a);
    fin {
        vector.dnit[Declaration](?decls);
        vector.dnit[Value](?params);
    }
    val res_reserve: res[usize, allocator.Error] = vector.reserve[Declaration](?decls, res_block_data.ok.parameters.len);
    if (sel res_reserve.err) { ret alloc[Block](res_reserve.err); }
    val res_reserve_params: res[usize, allocator.Error] = vector.reserve[Value](?params, res_block_data.ok.parameters.len);
    if (sel res_reserve_params.err) { ret alloc[Block](res_reserve_params.err); }
    j = 0;
    for (j < res_block_data.ok.parameters.len) {
        val res_value_data: res[ValueData, module.Error] = body.value_data(m, f, res_block_data.ok.parameters.data[j]);
        if (sel res_value_data.err) { ret refused[Block](res_value_data.err); }
        vector.push[Declaration](?decls, Declaration{type: res_value_data.ok.type, secret: res_value_data.ok.secret});
        j = j + 1;
    }

    val res_start: res[body.Mark, module.Error] = body.mark(m, f);
    if (sel res_start.err) { ret refused[Block](res_start.err); }
    var b: Builder = builder.make(m);
    builder.enter(?b, f);
    builder.derive(?b, sources.data[0].branch);
    val s: Block = builder.block(?b, Slice[Declaration]{data: decls.data, size: decls.len});
    builder.at_end(?b, s);
    j = 0;
    for (j < decls.len) {
        vector.push[Value](?params, builder.parameter(?b, s, j::u32));
        j = j + 1;
    }
    var to: [1]Branch = [1]Branch{Branch{block: target, arguments: Slice[Value]{data: params.data, size: params.len}}};
    builder.emit(?b, request(table.BR, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: ?to[0], size: 1}));
    val err_built: err[failure.Error] = builder.done(?b);
    if (sel err_built.err) {
        body.rewind(m, f, res_start.ok);
        ret res[Block, Error].err{Error.build{err_built.err}};
    }

    val err_moved: err[module.Error] = body.reroute(m, f, sources, s);
    if (sel err_moved.err) {
        body.rewind(m, f, res_start.ok);
        ret refused[Block](err_moved.err);
    }
    ret res[Block, Error].ok{s};
}
