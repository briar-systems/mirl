# edges: giving an edge a block of its own, and moving an edge to another block
#
# a branch passes one argument per parameter of its target, and both edits keep
# them in step: a split edge's block takes the arguments the edge carried as
# its parameters, each as secret as the value it receives, and forwards them.

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.symbol;
use mirl.build;
use mirl.build.Builder;
use mirl.build.Failure;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.cfg.failure.Error;
use mirl.ir.function.FunctionData;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.ValueData;

fun refused[T](e: module.Error) res[T, Error] {
    ret res[T, Error].err{Error.ir{e}};
}

fun alloc[T](e: allocator.Error) res[T, Error] {
    ret refused[T](module.Error.alloc{e});
}

fun request(code: opcode.Opcode, operands: Slice[Value], targets: Slice[Branch]) Request {
    ret Request{opcode: code, operands: operands, immediates: Slice[opcode.Immediate]{data: nil, size: 0}, targets: targets};
}

# give an edge a block of its own, which takes the arguments the edge carried
# and forwards them to the edge's old target
# ---
# m:    the module
# f:    the function
# i:    the instruction holding the edge
# edge: the edge's position among its edges
# ret:  the new block, or why it was refused, the body left as it was
pub fun split(m: *Module, f: Function, i: Instruction, edge: u32) res[Block, Error] {
    val src: res[InstructionData, module.Error] = body.instruction_data(m, f, i);
    if (sel src.err)                     { ret refused[Block](src.err); }
    if (edge::usize >= src.ok.edges.len) { ret refused[Block](module.Error.edge{edge}); }
    val target: Block                = src.ok.edges.data[edge].block;
    val passed: vector.Vector[Value] = src.ok.edges.data[edge].arguments;

    var carried: vector.Vector[Value]       = vector.init[Value](m.a);
    var decls:   vector.Vector[Declaration] = vector.init[Declaration](m.a);
    var params:  vector.Vector[Value]       = vector.init[Value](m.a);
    fin {
        vector.dnit[Value](?carried);
        vector.dnit[Declaration](?decls);
        vector.dnit[Value](?params);
    }
    val rc: res[usize, allocator.Error] = vector.reserve[Value](?carried, passed.len);
    if (sel rc.err) { ret alloc[Block](rc.err); }
    val rd: res[usize, allocator.Error] = vector.reserve[Declaration](?decls, passed.len);
    if (sel rd.err) { ret alloc[Block](rd.err); }
    val rp: res[usize, allocator.Error] = vector.reserve[Value](?params, passed.len);
    if (sel rp.err) { ret alloc[Block](rp.err); }
    var j: usize = 0;
    for (j < passed.len) {
        val v: res[ValueData, module.Error] = body.value_data(m, f, passed.data[j]);
        if (sel v.err) { ret refused[Block](v.err); }
        vector.push[Value](?carried, passed.data[j]);
        vector.push[Declaration](?decls, Declaration{type: v.ok.type, secret: v.ok.secret});
        j = j + 1;
    }

    val start: res[body.Mark, module.Error] = body.mark(m, f);
    if (sel start.err) { ret refused[Block](start.err); }
    var b: Builder = build.init(m);
    build.enter(?b, f);
    build.derive(?b, i);
    val s: Block = build.block(?b, Slice[Declaration]{data: decls.data, size: decls.len});
    build.at_end(?b, s);
    j = 0;
    for (j < decls.len) {
        vector.push[Value](?params, build.parameter(?b, s, j::u32));
        j = j + 1;
    }
    var to: [1]Branch = [1]Branch{Branch{block: target, arguments: Slice[Value]{data: params.data, size: params.len}}};
    build.emit(?b, request(opcode.BR, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: ?to[0], size: 1}));
    val built: err[Failure] = build.done(?b);
    if (sel built.err) {
        body.rewind(m, f, start.ok);
        ret res[Block, Error].err{Error.build{built.err}};
    }

    val moved: err[module.Error] = body.retarget(m, f, i, edge, s, Slice[Value]{data: carried.data, size: carried.len});
    if (sel moved.err) {
        body.rewind(m, f, start.ok);
        ret refused[Block](moved.err);
    }
    ret res[Block, Error].ok{s};
}

# an edge of a branch, by the branch and its position among its edges
# ---
# branch: the instruction holding the edge
# edge:   the edge's position among its edges
pub rec Source {
    branch: Instruction;
    edge:   u32;
}

# give a set of edges into one block a block of their own to enter through,
# which takes the arguments the edges carry as its parameters, declared as the
# target's are, and forwards them to the target
# ---
# m:       the module
# f:       the function
# target:  the block every edge enters
# sources: the edges, at least one, each into the target
# ret:     the new block, or why it was refused, the body left as it was
pub fun gather(m: *Module, f: Function, target: Block, sources: Slice[Source]) res[Block, Error] {
    if (sources.size == 0) { ret refused[Block](module.Error.edge{0}); }
    val td: res[BlockData, module.Error] = body.block_data(m, f, target);
    if (sel td.err) { ret refused[Block](td.err); }
    var j: usize = 0;
    for (j < sources.size) {
        val src: res[InstructionData, module.Error] = body.instruction_data(m, f, sources.data[j].branch);
        if (sel src.err)                                                         { ret refused[Block](src.err); }
        if (sources.data[j].edge::usize >= src.ok.edges.len)                     { ret refused[Block](module.Error.edge{sources.data[j].edge}); }
        if (src.ok.edges.data[sources.data[j].edge].block.index != target.index) { ret refused[Block](module.Error.reached{target}); }
        j = j + 1;
    }

    var decls:  vector.Vector[Declaration] = vector.init[Declaration](m.a);
    var params: vector.Vector[Value]       = vector.init[Value](m.a);
    var passed: vector.Vector[Value]       = vector.init[Value](m.a);
    fin {
        vector.dnit[Declaration](?decls);
        vector.dnit[Value](?params);
        vector.dnit[Value](?passed);
    }
    val rd: res[usize, allocator.Error] = vector.reserve[Declaration](?decls, td.ok.parameters.len);
    if (sel rd.err) { ret alloc[Block](rd.err); }
    val rp: res[usize, allocator.Error] = vector.reserve[Value](?params, td.ok.parameters.len);
    if (sel rp.err) { ret alloc[Block](rp.err); }
    val ra: res[usize, allocator.Error] = vector.reserve[Value](?passed, td.ok.parameters.len);
    if (sel ra.err) { ret alloc[Block](ra.err); }
    j = 0;
    for (j < td.ok.parameters.len) {
        val v: res[ValueData, module.Error] = body.value_data(m, f, td.ok.parameters.data[j]);
        if (sel v.err) { ret refused[Block](v.err); }
        vector.push[Declaration](?decls, Declaration{type: v.ok.type, secret: v.ok.secret});
        j = j + 1;
    }

    val start: res[body.Mark, module.Error] = body.mark(m, f);
    if (sel start.err) { ret refused[Block](start.err); }
    var b: Builder = build.init(m);
    build.enter(?b, f);
    build.derive(?b, sources.data[0].branch);
    val s: Block = build.block(?b, Slice[Declaration]{data: decls.data, size: decls.len});
    build.at_end(?b, s);
    j = 0;
    for (j < decls.len) {
        vector.push[Value](?params, build.parameter(?b, s, j::u32));
        j = j + 1;
    }
    var to: [1]Branch = [1]Branch{Branch{block: target, arguments: Slice[Value]{data: params.data, size: params.len}}};
    build.emit(?b, request(opcode.BR, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: ?to[0], size: 1}));
    val built: err[Failure] = build.done(?b);
    if (sel built.err) {
        body.rewind(m, f, start.ok);
        ret res[Block, Error].err{Error.build{built.err}};
    }

    j = 0;
    for (j < sources.size) {
        val src: res[InstructionData, module.Error] = body.instruction_data(m, f, sources.data[j].branch);
        if (sel src.err) {
            body.rewind(m, f, start.ok);
            ret refused[Block](src.err);
        }
        val args: vector.Vector[Value] = src.ok.edges.data[sources.data[j].edge].arguments;
        passed.len = 0;
        var a: usize = 0;
        for (a < args.len) {
            vector.push[Value](?passed, args.data[a]);
            a = a + 1;
        }
        val moved: err[module.Error] = body.retarget(m, f, sources.data[j].branch, sources.data[j].edge, s, Slice[Value]{data: passed.data, size: passed.len});
        if (sel moved.err) {
            body.rewind(m, f, start.ok);
            ret refused[Block](moved.err);
        }
        j = j + 1;
    }
    ret res[Block, Error].ok{s};
}

# move an edge to another block, passing arguments for that block's parameters
# ---
# m:         the module
# f:         the function
# i:         the instruction holding the edge
# edge:      the edge's position among its edges
# to:        the block it enters from now on
# arguments: one value per parameter of to, in order, none more secret than
#            the parameter it is passed to
# ret:       ok, or why it was refused, the body left as it was
pub fun redirect(m: *Module, f: Function, i: Instruction, edge: u32, to: Block, arguments: Slice[Value]) err[Error] {
    val moved: err[module.Error] = body.retarget(m, f, i, edge, to, arguments);
    if (sel moved.err) { ret err[Error].err{Error.ir{moved.err}}; }
    ret err[Error].ok{};
}

fun int(m: *Module, width: u32) Type {
    val r: res[Type, types.Error] = types.intern(?m.types, types.Shape.integer{types.Integer{width: width}});
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun record(m: *Module, f: Function, i: Instruction) InstructionData {
    var none: InstructionData;
    val d:    res[InstructionData, module.Error] = body.instruction_data(m, f, i);
    if (sel d.err) { ret none; }
    ret d.ok;
}

fun block_of(m: *Module, f: Function, k: Block) BlockData {
    var none: BlockData;
    val d:    res[BlockData, module.Error] = body.block_data(m, f, k);
    if (sel d.err) { ret none; }
    ret d.ok;
}

test edge__split_keeps_its_arguments {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, module.Error] = module.init(?a, module.TESTING);
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    var params: [3]Type                = [3]Type{int(?m, 1), int(?m, 32), int(?m, 32)};
    val sig:    res[Type, types.Error] = types.intern(?m.types, types.Shape.function{types.plain(Slice[Type]{data: ?params[0], size: 3}, Slice[Type]{data: nil, size: 0})});
    if (sel sig.err) { ret 1; }

    var b: Builder  = build.init(?m);
    val f: Function = build.function(?b, FunctionData{name: View{data: "f", len: 1}, signature: sig.ok, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    build.enter(?b, f);
    var decls: [3]Declaration = [3]Declaration{
        Declaration{type: params[0], secret: false},
        Declaration{type: params[1], secret: false},
        Declaration{type: params[2], secret: true},
    };
    val entry: Block     = build.block(?b, Slice[Declaration]{data: ?decls[0], size: 3});
    val join:  Block     = build.block(?b, Slice[Declaration]{data: ?decls[2], size: 1});
    var cond:  [1]Value  = [1]Value{build.parameter(?b, entry, 0)};
    var xs:    [1]Value  = [1]Value{build.parameter(?b, entry, 1)};
    var ys:    [1]Value  = [1]Value{build.parameter(?b, entry, 2)};
    var both:  [2]Branch = [2]Branch{Branch{block: join, arguments: Slice[Value]{data: ?xs[0], size: 1}}, Branch{block: join, arguments: Slice[Value]{data: ?ys[0], size: 1}}};
    build.at_end(?b, entry);
    val fork: Instruction = build.emit(?b, request(opcode.CBR, Slice[Value]{data: ?cond[0], size: 1}, Slice[Branch]{data: ?both[0], size: 2}));
    build.at_end(?b, join);
    build.emit(?b, request(opcode.RET, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: nil, size: 0}));
    if (build.failed(?b)) { ret 2; }

    val got: res[Block, Error] = split(?m, f, fork, 1);
    if (sel got.err) { ret 3; }
    val s: Block = got.ok;

    val fd: InstructionData = record(?m, f, fork);
    if (fd.edges.data[0].block.index != join.index || fd.edges.data[0].arguments.data[0].index != xs[0].index) { ret 4; }
    if (fd.edges.data[1].block.index != s.index || fd.edges.data[1].arguments.len != 1)                        { ret 4; }
    if (fd.edges.data[1].arguments.data[0].index != ys[0].index)                                               { ret 4; }

    val sd: BlockData = block_of(?m, f, s);
    if (sd.parameters.len != 1 || sd.instructions.len != 1 || sd.predecessors.len != 1) { ret 5; }
    val p: res[ValueData, module.Error] = body.value_data(?m, f, sd.parameters.data[0]);
    if (sel p.err)                                         { ret 5; }
    if (!types.same(p.ok.type, params[2]) || !p.ok.secret) { ret 5; }

    val forward: InstructionData = record(?m, f, sd.instructions.data[0]);
    if (forward.opcode.index != opcode.BR.index || forward.edges.len != 1)            { ret 6; }
    if (forward.edges.data[0].block.index != join.index)                              { ret 6; }
    if (forward.edges.data[0].arguments.data[0].index != sd.parameters.data[0].index) { ret 6; }

    val jd: BlockData = block_of(?m, f, join);
    if (jd.predecessors.len != 2)                                                                                      { ret 7; }
    if (jd.predecessors.data[0].index != fork.index || jd.predecessors.data[1].index != sd.instructions.data[0].index) { ret 7; }
    ret 0;
}
