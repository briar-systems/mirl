# why a graph edit or a copy was refused

use mirl.build.Failure;
use mirl.ir.id.Block;
use mirl.ir.id.Value;
use mirl.ir.module;

# why a graph edit or a copy was refused
# ---
# ir:        the body refused an edit or a read
# build:     the builder refused a block or an instruction
# position:  a position the block holds no instruction at
# merge:     a block not entered by exactly one unconditional branch from
#            another block
# undefined: a value defined in the region that is used where no copy of it
#            can have been made first
pub tag Error: u8 {
    ir:        module.Error;
    build:     Failure;
    position:  u32;
    merge:     Block;
    undefined: Value;
}
