# the graph view the analyses read: nodes, an entry, and the edges between them
#
# nodes are numbered 0 to count - 1. every edge is listed once among its
# source's successors and once among its target's predecessors, so two edges
# between the same nodes are listed twice. any form of code with numbered
# blocks gives its graph by listing its edges, and the analyses read nothing
# else of it.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;

# no node
pub val NONE: u32 = 0xffffffff;

# an edge between two nodes
# ---
# from: its source
# to:   its target
pub rec Edge {
    from: u32;
    to:   u32;
}

# items grouped by node, each node's items in the order they were given
# ---
# first: where each node's items start, then one past the last node's
# items: every node's items, node by node
pub rec Lists[T] {
    first: vector.Vector[u32];
    items: vector.Vector[T];
}

# give back the storage of grouped lists
pub fun release[T](l: *Lists[T]) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u32](?l.first);
    keep(?failed, vector.dnit[T](?l.items));
    ret failed;
}

# empty lists of count nodes with room for their items, each node's start at
# 0, or the allocator's refusal
fun room[T](a: *allocator.Allocator, count: u32, items: usize) res[Lists[T], allocator.Error] {
    var l: Lists[T];
    l.first = vector.init[u32](a);
    l.items = vector.init[T](a);
    val held: res[usize, allocator.Error] = vector.reserve[T](?l.items, items);
    if (sel held.err) { ret res[Lists[T], allocator.Error].err{held.err}; }
    val first: err[allocator.Error] = slice.fill[u32](?l.first, count::usize + 1, 0);
    if (sel first.err) {
        release[T](?l);
        ret res[Lists[T], allocator.Error].err{first.err};
    }
    ret res[Lists[T], allocator.Error].ok{l};
}

# each node's start, from how many items each has counted at the entry after
# its own
fun starts[T](l: *Lists[T], count: u32) {
    var n: usize = 1;
    for (n <= count::usize) {
        l.first.data[n] = l.first.data[n] + l.first.data[n - 1];
        n               = n + 1;
    }
}

# the next place of a node's items, each node's start moving past what it was
# given until `settle` puts it back
fun place[T](l: *Lists[T], k: u32, item: T) {
    l.items.data[l.first.data[k]] = item;
    l.first.data[k]               = l.first.data[k] + 1;
}

# every node's start put back once its items are placed, each having moved to
# the next node's start
fun settle[T](l: *Lists[T], count: u32, items: usize) {
    var n: usize = count::usize;
    for (n > 0) {
        l.first.data[n] = l.first.data[n - 1];
        n               = n - 1;
    }
    l.first.data[0] = 0;
    vector.commit[T](?l.items, items);
}

# group items by node
# ---
# a:     the allocator the lists take
# count: the number of nodes
# keys:  the node of each item, each below count
# items: the items, as many as keys
# ret:   the lists, or the allocator's refusal
pub fun lists[T](a: *allocator.Allocator, count: u32, keys: Slice[u32], items: Slice[T]) res[Lists[T], allocator.Error] {
    val made: res[Lists[T], allocator.Error] = room[T](a, count, items.size);
    if (sel made.err) { ret made; }
    var l: Lists[T] = made.ok;
    var i: usize    = 0;
    for (i < keys.size) {
        l.first.data[keys.data[i] + 1] = l.first.data[keys.data[i] + 1] + 1;
        i                              = i + 1;
    }
    starts[T](?l, count);
    i = 0;
    for (i < keys.size) {
        place[T](?l, keys.data[i], items.data[i]);
        i = i + 1;
    }
    settle[T](?l, count, items.size);
    ret res[Lists[T], allocator.Error].ok{l};
}

# the items of one node
pub fun list[T](l: *Lists[T], n: u32) Slice[T] {
    val start: u32 = l.first.data[n];
    ret Slice[T]{data: ?l.items.data[start], size: (l.first.data[n + 1] - start)::usize};
}

# a graph
# ---
# count:        the number of nodes
# entry:        the node control enters by, below count unless count is 0
# successors:   each node's successors, an entry per edge
# predecessors: each node's predecessors, an entry per edge
pub rec Graph {
    count:        u32;
    entry:        u32;
    successors:   Lists[u32];
    predecessors: Lists[u32];
}

# a graph of its edges
# ---
# a:     the allocator the graph takes
# count: the number of nodes
# entry: the entry node
# edges: every edge, each naming nodes below count, in the order each
#        node's successors and predecessors are listed
# ret:   the graph, or the allocator's refusal
pub fun init(a: *allocator.Allocator, count: u32, entry: u32, edges: Slice[Edge]) res[Graph, allocator.Error] {
    val succ: res[Lists[u32], allocator.Error] = room[u32](a, count, edges.size);
    if (sel succ.err) { ret res[Graph, allocator.Error].err{succ.err}; }
    var s: Lists[u32] = succ.ok;
    val pred: res[Lists[u32], allocator.Error] = room[u32](a, count, edges.size);
    if (sel pred.err) {
        release[u32](?s);
        ret res[Graph, allocator.Error].err{pred.err};
    }
    var p: Lists[u32] = pred.ok;
    var i: usize      = 0;
    for (i < edges.size) {
        s.first.data[edges.data[i].from + 1] = s.first.data[edges.data[i].from + 1] + 1;
        p.first.data[edges.data[i].to + 1]   = p.first.data[edges.data[i].to + 1] + 1;
        i                                    = i + 1;
    }
    starts[u32](?s, count);
    starts[u32](?p, count);
    i = 0;
    for (i < edges.size) {
        place[u32](?s, edges.data[i].from, edges.data[i].to);
        place[u32](?p, edges.data[i].to, edges.data[i].from);
        i = i + 1;
    }
    settle[u32](?s, count, edges.size);
    settle[u32](?p, count, edges.size);
    ret res[Graph, allocator.Error].ok{Graph{count: count, entry: entry, successors: s, predecessors: p}};
}

# give back a graph's storage
pub fun dnit(g: *Graph) err[allocator.Error] {
    var failed: err[allocator.Error] = release[u32](?g.successors);
    keep(?failed, release[u32](?g.predecessors));
    ret failed;
}

# the number of nodes
pub fun count(g: *Graph) u32 {
    ret g.count;
}

# the entry node
pub fun entry(g: *Graph) u32 {
    ret g.entry;
}

# the successors of a node, an entry per edge
pub fun successors(g: *Graph, n: u32) Slice[u32] {
    ret list[u32](?g.successors, n);
}

# the predecessors of a node, an entry per edge
pub fun predecessors(g: *Graph, n: u32) Slice[u32] {
    ret list[u32](?g.predecessors, n);
}
