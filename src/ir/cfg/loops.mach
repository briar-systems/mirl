# natural loops and their nesting over the graph view
#
# a back edge enters a node that dominates its source. the back edges into one
# header make one loop, however many latches it has, and its body is every
# node that reaches a latch without passing the header. a cycle no node
# dominates, as in an irreducible graph, is not a natural loop and is not
# listed. loops are discovered innermost first, so an inner loop is folded
# into the walk of the loop around it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Edge;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.cfg.graph.NONE;

# one loop
# ---
# header: the node every back edge of the loop enters
# parent: the loop immediately around it, NONE when it is outermost
# depth:  how many loops hold it, itself included
pub rec Loop {
    header: u32;
    parent: u32;
    depth:  u32;
}

# the loops of a graph, outer loops before the loops they hold
# ---
# loops:     each loop
# bodies:    each loop's nodes, the header first and then in reverse postorder
# latches:   each loop's sources of back edges into its header
# exits:     each loop's edges from a node in it to a node outside it
# innermost: each node's innermost loop, NONE when it is in none
pub rec Loops {
    loops:     vector.Vector[Loop];
    bodies:    Lists[u32];
    latches:   Lists[u32];
    exits:     Lists[Edge];
    innermost: vector.Vector[u32];
}

fun slice[T](v: *vector.Vector[T]) Slice[T] {
    ret Slice[T]{data: v.data, size: v.len};
}

fun pair(keys: *vector.Vector[u32], items: *vector.Vector[u32], k: u32, n: u32) err[allocator.Error] {
    val pk: res[usize, allocator.Error] = vector.push[u32](keys, k);
    if (sel pk.err) { ret err[allocator.Error].err{pk.err}; }
    val pi: res[usize, allocator.Error] = vector.push[u32](items, n);
    if (sel pi.err) { ret err[allocator.Error].err{pi.err}; }
    ret err[allocator.Error].ok{};
}

fun outermost(l: *Loops, i: u32) u32 {
    var at: u32 = i;
    for (l.loops.data[at].parent != NONE) { at = l.loops.data[at].parent; }
    ret at;
}

# the headers in reverse postorder, and each one's latches
fun headers(g: *Graph, d: *Dominance, l: *Loops, keys: *vector.Vector[u32], items: *vector.Vector[u32]) err[allocator.Error] {
    val order: Slice[u32] = dominance.order(d);
    var i:     usize      = 0;
    for (i < order.size) {
        val h:     u32        = order.data[i];
        val preds: Slice[u32] = graph.predecessors(g, h);
        var found: bool       = false;
        var j:     usize      = 0;
        for (j < preds.size) {
            val p: u32 = preds.data[j];
            if (dominance.dominates(d, h, p)) {
                if (!found) {
                    found = true;
                    val pushed: res[usize, allocator.Error] = vector.push[Loop](?l.loops, Loop{header: h, parent: NONE, depth: 0});
                    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
                }
                val kept: err[allocator.Error] = pair(keys, items, (l.loops.len - 1)::u32, p);
                if (sel kept.err) { ret kept; }
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# claim the nodes of loop i, walking back from its latches
fun discover(a: *allocator.Allocator, g: *Graph, d: *Dominance, l: *Loops, i: u32) err[allocator.Error] {
    var stack: vector.Vector[u32] = vector.init[u32](a);
    fin { vector.dnit[u32](?stack); }
    val h: u32 = l.loops.data[i].header;
    l.innermost.data[h] = i;
    val latches: Slice[u32] = graph.list[u32](?l.latches, i);
    var j:       usize      = 0;
    for (j < latches.size) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?stack, latches.data[j]);
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        j = j + 1;
    }
    for (stack.len > 0) {
        val n: u32 = stack.data[stack.len - 1];
        stack.len = stack.len - 1;
        var from: u32 = n;
        if (l.innermost.data[n] == NONE) { l.innermost.data[n] = i; }
        or {
            val root: u32 = outermost(l, l.innermost.data[n]);
            if (root == i) { cnt; }
            l.loops.data[root].parent = i;
            from                      = l.loops.data[root].header;
        }
        val preds: Slice[u32] = graph.predecessors(g, from);
        j = 0;
        for (j < preds.size) {
            if (dominance.reachable(d, preds.data[j])) {
                val pushed: res[usize, allocator.Error] = vector.push[u32](?stack, preds.data[j]);
                if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            }
            j = j + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

fun within(l: *Loops, i: u32, n: u32) bool {
    var at: u32 = l.innermost.data[n];
    for (at != NONE) {
        if (at == i) { ret true; }
        at = l.loops.data[at].parent;
    }
    ret false;
}

fun shape(a: *allocator.Allocator, g: *Graph, d: *Dominance, l: *Loops) err[allocator.Error] {
    var keys:  vector.Vector[u32] = vector.init[u32](a);
    var items: vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[u32](?items);
    }
    val found: err[allocator.Error] = headers(g, d, l, ?keys, ?items);
    if (sel found.err) { ret found; }
    val latched: res[Lists[u32], allocator.Error] = graph.lists[u32](a, l.loops.len::u32, slice[u32](?keys), slice[u32](?items));
    if (sel latched.err) { ret err[allocator.Error].err{latched.err}; }
    l.latches = latched.ok;

    var i: usize = l.loops.len;
    for (i > 0) {
        i = i - 1;
        val walked: err[allocator.Error] = discover(a, g, d, l, i::u32);
        if (sel walked.err) { ret walked; }
    }
    i = 0;
    for (i < l.loops.len) {
        val up: u32 = l.loops.data[i].parent;
        if (up == NONE) { l.loops.data[i].depth = 1; }
        or              { l.loops.data[i].depth = l.loops.data[up].depth + 1; }
        i = i + 1;
    }

    keys.len  = 0;
    items.len = 0;
    val order: Slice[u32] = dominance.order(d);
    var k:     usize      = 0;
    for (k < order.size) {
        val n:  u32 = order.data[k];
        var at: u32 = l.innermost.data[n];
        for (at != NONE) {
            val kept: err[allocator.Error] = pair(?keys, ?items, at, n);
            if (sel kept.err) { ret kept; }
            at = l.loops.data[at].parent;
        }
        k = k + 1;
    }
    val bodies: res[Lists[u32], allocator.Error] = graph.lists[u32](a, l.loops.len::u32, slice[u32](?keys), slice[u32](?items));
    if (sel bodies.err) { ret err[allocator.Error].err{bodies.err}; }
    l.bodies = bodies.ok;

    keys.len = 0;
    var edges: vector.Vector[Edge] = vector.init[Edge](a);
    fin { vector.dnit[Edge](?edges); }
    i = 0;
    for (i < l.loops.len) {
        val nodes: Slice[u32] = graph.list[u32](?l.bodies, i::u32);
        var j:     usize      = 0;
        for (j < nodes.size) {
            val succs: Slice[u32] = graph.successors(g, nodes.data[j]);
            var s:     usize      = 0;
            for (s < succs.size) {
                if (!within(l, i::u32, succs.data[s])) {
                    val pk: res[usize, allocator.Error] = vector.push[u32](?keys, i::u32);
                    if (sel pk.err) { ret err[allocator.Error].err{pk.err}; }
                    val pe: res[usize, allocator.Error] = vector.push[Edge](?edges, Edge{from: nodes.data[j], to: succs.data[s]});
                    if (sel pe.err) { ret err[allocator.Error].err{pe.err}; }
                }
                s = s + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    val exits: res[Lists[Edge], allocator.Error] = graph.lists[Edge](a, l.loops.len::u32, slice[u32](?keys), slice[Edge](?edges));
    if (sel exits.err) { ret err[allocator.Error].err{exits.err}; }
    l.exits = exits.ok;
    ret err[allocator.Error].ok{};
}

# the loops of a graph
# ---
# a:   the allocator the result takes
# g:   the graph
# d:   its dominance
# ret: its loops, or the allocator's refusal
pub fun compute(a: *allocator.Allocator, g: *Graph, d: *Dominance) res[Loops, allocator.Error] {
    var l: Loops;
    l.loops     = vector.init[Loop](a);
    l.bodies    = Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)};
    l.latches   = Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)};
    l.exits     = Lists[Edge]{first: vector.init[u32](a), items: vector.init[Edge](a)};
    l.innermost = vector.init[u32](a);
    var failed: err[allocator.Error]        = err[allocator.Error].ok{};
    val room:   res[usize, allocator.Error] = vector.reserve[u32](?l.innermost, g.count::usize);
    if (sel room.err) { failed = err[allocator.Error].err{room.err}; }
    or {
        var n: u32 = 0;
        for (n < g.count) {
            vector.push[u32](?l.innermost, NONE);
            n = n + 1;
        }
        keep(?failed, shape(a, g, d, ?l));
    }
    if (sel failed.err) {
        dnit(?l);
        ret res[Loops, allocator.Error].err{failed.err};
    }
    ret res[Loops, allocator.Error].ok{l};
}

# give back the storage of loops
pub fun dnit(l: *Loops) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[Loop](?l.loops);
    keep(?failed, graph.release[u32](?l.bodies));
    keep(?failed, graph.release[u32](?l.latches));
    keep(?failed, graph.release[Edge](?l.exits));
    keep(?failed, vector.dnit[u32](?l.innermost));
    ret failed;
}

# the number of loops
pub fun count(l: *Loops) u32 {
    ret l.loops.len::u32;
}

# a loop
pub fun loop(l: *Loops, i: u32) Loop {
    ret l.loops.data[i];
}

# a loop's nodes, the header first
pub fun body(l: *Loops, i: u32) Slice[u32] {
    ret graph.list[u32](?l.bodies, i);
}

# a loop's latches, the sources of its back edges
pub fun latches(l: *Loops, i: u32) Slice[u32] {
    ret graph.list[u32](?l.latches, i);
}

# a loop's edges from a node in it to a node outside it
pub fun exits(l: *Loops, i: u32) Slice[Edge] {
    ret graph.list[Edge](?l.exits, i);
}

# the innermost loop holding a node, none when no loop holds it
pub fun innermost(l: *Loops, n: u32) opt[u32] {
    val at: u32 = l.innermost.data[n];
    if (at == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{at};
}

# how many loops hold a node
pub fun depth(l: *Loops, n: u32) u32 {
    val at: u32 = l.innermost.data[n];
    if (at == NONE) { ret 0; }
    ret l.loops.data[at].depth;
}

# whether a loop holds a node
pub fun contains(l: *Loops, i: u32, n: u32) bool {
    ret within(l, i, n);
}

fun holds(s: Slice[u32], n: u32) bool {
    var i: usize = 0;
    for (i < s.size) {
        if (s.data[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun is_set(s: Slice[u32], want: Slice[u32]) bool {
    if (s.size != want.size) { ret false; }
    var i: usize = 0;
    for (i < want.size) {
        if (!holds(s, want.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun nodes(data: *u32, size: usize) Slice[u32] {
    ret Slice[u32]{data: data, size: size};
}

fun one_exit(l: *Loops, i: u32, from: u32, to: u32) bool {
    val e: Slice[Edge] = exits(l, i);
    ret e.size == 1 && e.data[0].from == from && e.data[0].to == to;
}

test loops__nested_and_two_latches {
    var a: allocator.Allocator;
    page.make(?a);
    # 1 heads a loop around the loop 2 heads, and 6 heads one loop latched by 7 and 8
    var edges: [13]Edge = [13]Edge{
        Edge{from: 0, to: 1},
        Edge{from: 1, to: 2},
        Edge{from: 2, to: 3},
        Edge{from: 3, to: 2},
        Edge{from: 3, to: 4},
        Edge{from: 4, to: 1},
        Edge{from: 1, to: 5},
        Edge{from: 5, to: 6},
        Edge{from: 6, to: 7},
        Edge{from: 6, to: 8},
        Edge{from: 7, to: 6},
        Edge{from: 8, to: 6},
        Edge{from: 6, to: 9},
    };
    val made: res[Graph, allocator.Error] = graph.init(?a, 10, 0, Slice[Edge]{data: ?edges[0], size: 13});
    if (sel made.err) { ret 1; }
    var g: Graph = made.ok;
    fin { graph.dnit(?g); }
    val dom: res[Dominance, allocator.Error] = dominance.compute(?a, ?g);
    if (sel dom.err) { ret 1; }
    var d: Dominance = dom.ok;
    fin { dominance.dnit(?d); }
    val got: res[Loops, allocator.Error] = compute(?a, ?g, ?d);
    if (sel got.err) { ret 1; }
    var l: Loops = got.ok;
    fin { dnit(?l); }

    if (count(?l) != 3) { ret 2; }
    val outer: opt[u32] = innermost(?l, 1);
    val inner: opt[u32] = innermost(?l, 2);
    val twin:  opt[u32] = innermost(?l, 6);
    if (sel outer.none) { ret 3; }
    if (sel inner.none) { ret 3; }
    if (sel twin.none)  { ret 3; }
    val o: u32 = outer.some;
    val n: u32 = inner.some;
    val t: u32 = twin.some;
    if (loop(?l, o).header != 1 || loop(?l, o).parent != NONE || loop(?l, o).depth != 1) { ret 4; }
    if (loop(?l, n).header != 2 || loop(?l, n).parent != o || loop(?l, n).depth != 2)    { ret 4; }
    if (loop(?l, t).header != 6 || loop(?l, t).parent != NONE || loop(?l, t).depth != 1) { ret 4; }

    var ob: [4]u32 = [4]u32{1, 2, 3, 4};
    var nb: [2]u32 = [2]u32{2, 3};
    var tb: [3]u32 = [3]u32{6, 7, 8};
    var tl: [2]u32 = [2]u32{7, 8};
    var ol: [1]u32 = [1]u32{4};
    var nl: [1]u32 = [1]u32{3};
    if (!is_set(body(?l, o), nodes(?ob[0], 4)) || body(?l, o).data[0] != 1)         { ret 5; }
    if (!is_set(body(?l, n), nodes(?nb[0], 2)) || body(?l, n).data[0] != 2)         { ret 5; }
    if (!is_set(body(?l, t), nodes(?tb[0], 3)) || body(?l, t).data[0] != 6)         { ret 5; }
    if (!is_set(latches(?l, o), nodes(?ol[0], 1)))                                  { ret 6; }
    if (!is_set(latches(?l, n), nodes(?nl[0], 1)))                                  { ret 6; }
    if (!is_set(latches(?l, t), nodes(?tl[0], 2)))                                  { ret 6; }
    if (!one_exit(?l, o, 1, 5) || !one_exit(?l, n, 3, 4) || !one_exit(?l, t, 6, 9)) { ret 7; }

    var depths: [10]u32 = [10]u32{0, 1, 2, 2, 1, 0, 1, 1, 1, 0};
    var k:      u32     = 0;
    for (k < 10) {
        if (depth(?l, k) != depths[k]) { ret 8; }
        k = k + 1;
    }

    # the cycle between 1 and 2 is entered at both, so neither dominates the
    # other and it is no natural loop
    var tangled: [5]Edge = [5]Edge{
        Edge{from: 0, to: 1},
        Edge{from: 0, to: 2},
        Edge{from: 1, to: 2},
        Edge{from: 2, to: 1},
        Edge{from: 2, to: 3},
    };
    val other: res[Graph, allocator.Error] = graph.init(?a, 4, 0, Slice[Edge]{data: ?tangled[0], size: 5});
    if (sel other.err) { ret 9; }
    var ig: Graph = other.ok;
    fin { graph.dnit(?ig); }
    val idom: res[Dominance, allocator.Error] = dominance.compute(?a, ?ig);
    if (sel idom.err) { ret 9; }
    var id: Dominance = idom.ok;
    fin { dominance.dnit(?id); }
    val none: res[Loops, allocator.Error] = compute(?a, ?ig, ?id);
    if (sel none.err) { ret 9; }
    var il: Loops = none.ok;
    fin { dnit(?il); }
    if (count(?il) != 0 || depth(?il, 1) != 0 || depth(?il, 2) != 0) { ret 10; }
    ret 0;
}
