# the graph view of a function body
#
# a node per block, numbered as the blocks are, the entry block the entry
# node, and an edge for every edge of every instruction placed in a block. an
# erased block is a node with no edges.

use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Edge;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.module.Module;

# the graph of a function's blocks, valid until the body next changes
# ---
# m:   the module, whose allocator the graph takes
# f:   the function
# ret: its graph, or why it was refused
pub fun of(m: *Module, f: Function) res[Graph, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Graph, Error].err{got.err}; }
    val b:     *Body               = got.ok;
    var edges: vector.Vector[Edge] = vector.init[Edge](m.a);
    fin { vector.dnit[Edge](?edges); }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                val d: *InstructionData = ?b.instructions.data[list.data[i].index];
                var e: usize            = 0;
                for (e < d.edges.len) {
                    val pushed: res[usize, allocator.Error] = vector.push[Edge](?edges, Edge{from: k::u32, to: d.edges.data[e].block.index});
                    if (sel pushed.err) { ret res[Graph, Error].err{Error.alloc{pushed.err}}; }
                    e = e + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    val made: res[Graph, allocator.Error] = graph.init(m.a, b.blocks.len::u32, 0, Slice[Edge]{data: edges.data, size: edges.len});
    if (sel made.err) { ret res[Graph, Error].err{Error.alloc{made.err}}; }
    ret res[Graph, Error].ok{made.ok};
}
