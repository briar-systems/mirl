# removal of the blocks no path from the entry reaches
#
# an unreached block may use its own values in any order, so every value one
# defines is first replaced by a zero of its type, which only unreached code
# can still name. the blocks then go with every instruction they hold, a kept
# one too, since none of them can run.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.body.Records;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.failure.Error;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.value.ValueData;

fun lift(r: err[module.Error]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.ir{r.err}}; }
    ret err[Error].ok{};
}

# replace a value that has uses by a zero of its type
fun zeroed(m: *Module, f: Function, v: Value) err[Error] {
    val res_value_data: res[ValueData, module.Error] = body.value_data(m, f, v);
    if (sel res_value_data.err)          { ret err[Error].err{Error.ir{res_value_data.err}}; }
    if (res_value_data.ok.uses.len == 0) { ret err[Error].ok{}; }
    val res_add_constant: res[Constant, module.Error] = module.add_constant(m, ConstantData.zero{res_value_data.ok.type});
    if (sel res_add_constant.err) { ret err[Error].err{Error.ir{res_add_constant.err}}; }
    val res_constant: res[Value, module.Error] = body.constant(m, f, res_add_constant.ok);
    if (sel res_constant.err) { ret err[Error].err{Error.ir{res_constant.err}}; }
    ret lift(body.replace(m, f, v, res_constant.ok, Records.unavailable{}));
}

# take every block the entry does not reach out of a function
# ---
# m:   the module
# f:   the function
# d:   the dominance of the function as it is now
# ret: ok, or why an edit was refused, the body then part way through
pub fun unreached(m: *Module, f: Function, d: *Dominance) err[Error] {
    val res_body: res[*Body, module.Error] = module.body(m, f);
    if (sel res_body.err) { ret err[Error].err{Error.ir{res_body.err}}; }
    val b:    *Body                = res_body.ok;
    var gone: vector.Vector[Block] = vector.init[Block](m.a);
    fin { vector.dnit[Block](?gone); }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && !dominance.reachable(d, k::u32)) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Block](?gone, (k::u32));
            if (sel res_pushed.err) { ret err[Error].err{Error.ir{module.Error.alloc{res_pushed.err}}}; }
        }
        k = k + 1;
    }

    var n: usize = 0;
    for (n < gone.len) {
        val data: *BlockData = ?b.blocks.data[gone.data[n]];
        var i:    usize      = 0;
        for (i < data.parameters.len) {
            val err_zeroed: err[Error] = zeroed(m, f, data.parameters.data[i]);
            if (sel err_zeroed.err) { ret err_zeroed; }
            i = i + 1;
        }
        var x: Instruction = data.first;
        for (x != NO_INSTRUCTION) {
            val inst: *InstructionData = ?b.instructions.data[x];
            var r:    usize            = 0;
            for (r < inst.results.len) {
                val err_zeroed: err[Error] = zeroed(m, f, inst.results.data[r]);
                if (sel err_zeroed.err) { ret err_zeroed; }
                r = r + 1;
            }
            x = b.instructions.data[x].next;
        }
        n = n + 1;
    }

    ret lift(body.erase_unreached(m, f, Slice[Block]{data: gone.data, size: gone.len}));
}
