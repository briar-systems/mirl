# removal of the blocks no path from the entry reaches
#
# an unreached block may use its own values in any order, so every value one
# defines is first replaced by a zero of its type, which only unreached code
# can still name. its instructions and then the blocks are taken out.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.failure.Error;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.value.ValueData;

fun lift(r: err[module.Error]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.ir{r.err}}; }
    ret err[Error].ok{};
}

# replace a value that has uses by a zero of its type
fun zeroed(m: *Module, f: Function, v: Value) err[Error] {
    val d: res[ValueData, module.Error] = body.value_data(m, f, v);
    if (sel d.err)          { ret err[Error].err{Error.ir{d.err}}; }
    if (d.ok.uses.len == 0) { ret err[Error].ok{}; }
    val c: res[Constant, module.Error] = module.add_constant(m, ConstantData.zero{d.ok.type});
    if (sel c.err) { ret err[Error].err{Error.ir{c.err}}; }
    val z: res[Value, module.Error] = body.constant(m, f, c.ok);
    if (sel z.err) { ret err[Error].err{Error.ir{z.err}}; }
    ret lift(body.replace(m, f, v, z.ok));
}

# take every block the entry does not reach out of a function
# ---
# m:   the module
# f:   the function
# d:   the dominance of the function as it is now
# ret: ok, or why an edit was refused, the body then part way through
pub fun unreached(m: *Module, f: Function, d: *Dominance) err[Error] {
    val got: res[*Body, module.Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{Error.ir{got.err}}; }
    val b:    *Body                = got.ok;
    var gone: vector.Vector[Block] = vector.init[Block](m.a);
    fin { vector.dnit[Block](?gone); }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased && !dominance.reachable(d, k::u32)) {
            val pushed: res[usize, allocator.Error] = vector.push[Block](?gone, Block{index: k::u32});
            if (sel pushed.err) { ret err[Error].err{Error.ir{module.Error.alloc{pushed.err}}}; }
        }
        k = k + 1;
    }

    var n: usize = 0;
    for (n < gone.len) {
        val data: *BlockData = ?b.blocks.data[gone.data[n].index];
        var i:    usize      = 0;
        for (i < data.parameters.len) {
            val z: err[Error] = zeroed(m, f, data.parameters.data[i]);
            if (sel z.err) { ret z; }
            i = i + 1;
        }
        i = 0;
        for (i < data.instructions.len) {
            val inst: *InstructionData = ?b.instructions.data[data.instructions.data[i].index];
            var r:    usize            = 0;
            for (r < inst.results.len) {
                val z: err[Error] = zeroed(m, f, inst.results.data[r]);
                if (sel z.err) { ret z; }
                r = r + 1;
            }
            i = i + 1;
        }
        n = n + 1;
    }

    n = 0;
    for (n < gone.len) {
        val data: *BlockData = ?b.blocks.data[gone.data[n].index];
        for (data.instructions.len > 0) {
            val last: Instruction = data.instructions.data[data.instructions.len - 1];
            val e:    err[Error]  = lift(body.erase(m, f, last));
            if (sel e.err) { ret e; }
        }
        n = n + 1;
    }
    n = 0;
    for (n < gone.len) {
        val e: err[Error] = lift(body.erase_block(m, f, gone.data[n]));
        if (sel e.err) { ret e; }
        n = n + 1;
    }
    ret err[Error].ok{};
}
