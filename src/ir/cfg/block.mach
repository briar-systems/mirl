# blocks: splitting one at an instruction and merging one into its single
# predecessor
#
# a split moves the tail to a new block the head branches to, and a merge
# puts each of the merged block's parameters' uses on the argument its one
# edge passed, so a split followed by a merge restores the function.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.build.builder;
use mirl.build.builder.Builder;
use mirl.build.failure;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.cfg.failure.Error;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row;
use mirl.ir.opcode.table;
use mirl.ir.value.Declaration;

fun refused[T](e: module.Error) res[T, Error] {
    ret res[T, Error].err{Error.ir{e}};
}

fun request(code: row.Opcode, operands: Slice[Value], targets: Slice[Branch]) Request {
    ret Request{opcode: code, operands: operands, immediates: Slice[row.Immediate]{data: nil, size: 0}, targets: targets};
}

# split a block before an instruction: the instruction and those after it move
# to a new block without parameters, and the block ends in a branch to it
# ---
# m:   the module
# f:   the function
# k:   the block
# at:  the position of the first instruction moved
# ret: the new block, or why it was refused, the body left as it was
pub fun split(m: *Module, f: Function, k: Block, at: u32) res[Block, Error] {
    val res_block_data: res[BlockData, module.Error] = body.block_data(m, f, k);
    if (sel res_block_data.err)                          { ret refused[Block](res_block_data.err); }
    if (res_block_data.ok.erased)                        { ret refused[Block](module.Error.removed{k}); }
    if (at::usize >= res_block_data.ok.instructions.len) { ret res[Block, Error].err{Error.position{at}}; }
    val first: Instruction = res_block_data.ok.instructions.data[at];

    val res_start: res[body.Mark, module.Error] = body.mark(m, f);
    if (sel res_start.err) { ret refused[Block](res_start.err); }

    var b: Builder = builder.init(m);
    builder.enter(?b, f);
    builder.derive(?b, first);
    val tail:       Block              = builder.block(?b, Slice[Declaration]{data: nil, size: 0});
    val err_opened: err[failure.Error] = builder.done(?b);
    if (sel err_opened.err) {
        body.rewind(m, f, res_start.ok);
        ret res[Block, Error].err{Error.build{err_opened.err}};
    }
    val err_moved: err[module.Error] = body.move(m, f, k, at, tail);
    if (sel err_moved.err) {
        body.rewind(m, f, res_start.ok);
        ret refused[Block](err_moved.err);
    }
    var to: [1]Branch = [1]Branch{Branch{block: tail, arguments: Slice[Value]{data: nil, size: 0}}};
    builder.at_end(?b, k);
    builder.emit(?b, request(table.BR, Slice[Value]{data: nil, size: 0}, Slice[Branch]{data: ?to[0], size: 1}));
    val err_built: err[failure.Error] = builder.done(?b);
    if (sel err_built.err) {
        # the instructions go back into room they left, so this allocates nothing
        body.move(m, f, tail, 0, k);
        body.rewind(m, f, res_start.ok);
        ret res[Block, Error].err{Error.build{err_built.err}};
    }
    ret res[Block, Error].ok{tail};
}

# merge a block into its single predecessor, which must reach it by an
# unconditional branch: each parameter's uses take the argument the branch
# passed, the branch goes, and the block's instructions take its place
# ---
# m:   the module
# f:   the function
# k:   the block, not the entry
# ret: the block it merged into, or why it was refused, the body left as it was
pub fun merge(m: *Module, f: Function, k: Block) res[Block, Error] {
    val res_block_data: res[BlockData, module.Error] = body.block_data(m, f, k);
    if (sel res_block_data.err)                                  { ret refused[Block](res_block_data.err); }
    if (res_block_data.ok.erased)                                { ret refused[Block](module.Error.removed{k}); }
    if (k.index == 0 || res_block_data.ok.predecessors.len != 1) { ret res[Block, Error].err{Error.merge{k}}; }
    val jump:                 Instruction                        = res_block_data.ok.predecessors.data[0];
    val res_instruction_data: res[InstructionData, module.Error] = body.instruction_data(m, f, jump);
    if (sel res_instruction_data.err) { ret refused[Block](res_instruction_data.err); }
    val at: Place = res_instruction_data.ok.place;
    if (res_instruction_data.ok.opcode.index != table.BR.index) { ret res[Block, Error].err{Error.merge{k}}; }
    if (!(sel at.placed))                                       { ret res[Block, Error].err{Error.merge{k}}; }
    val into: Block = at.placed;
    if (into.index == k.index) { ret res[Block, Error].err{Error.merge{k}}; }
    val err_spliced: err[module.Error] = body.splice(m, f, jump);
    if (sel err_spliced.err) { ret refused[Block](err_spliced.err); }
    ret res[Block, Error].ok{into};
}
