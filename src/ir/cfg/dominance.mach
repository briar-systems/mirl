# dominators, the dominator tree and dominance frontiers over the graph view
#
# immediate dominators come from the iterative algorithm of cooper, harvey and
# kennedy over reverse postorder, which assumes nothing of the graph's shape
# and so is right on irreducible graphs. a node the entry does not reach has
# no dominator and dominates nothing.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Edge;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.cfg.graph.NONE;

# the dominance of a graph
# ---
# order:    the reachable nodes in reverse postorder, the entry first
# rank:     each node's position in order, NONE when unreachable
# idom:     each node's immediate dominator, the entry its own, NONE when
#           unreachable
# children: each node's children in the dominator tree
# frontier: each node's dominance frontier
# enter:    each node's position in a preorder walk of the tree
# leave:    the last preorder position within each node's subtree
pub rec Dominance {
    order:    vector.Vector[u32];
    rank:     vector.Vector[u32];
    idom:     vector.Vector[u32];
    children: Lists[u32];
    frontier: Lists[u32];
    enter:    vector.Vector[u32];
    leave:    vector.Vector[u32];
}

fun nodes(a: *allocator.Allocator, n: u32, fill: u32, out: *vector.Vector[u32]) err[allocator.Error] {
    @out = vector.init[u32](a);
    val room: res[usize, allocator.Error] = vector.reserve[u32](out, n::usize);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: u32 = 0;
    for (i < n) {
        vector.push[u32](out, fill);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun slice(v: *vector.Vector[u32]) Slice[u32] {
    ret Slice[u32]{data: v.data, size: v.len};
}

# the reachable nodes in reverse postorder, and each one's rank in it
fun postorder(a: *allocator.Allocator, g: *Graph, d: *Dominance) err[allocator.Error] {
    if (g.count == 0) { ret err[allocator.Error].ok{}; }
    var stack: vector.Vector[u32] = vector.init[u32](a);
    var next:  vector.Vector[u32] = vector.init[u32](a);
    var post:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?stack);
        vector.dnit[u32](?next);
        vector.dnit[u32](?post);
    }
    val made: err[allocator.Error] = nodes(a, g.count, 0, ?next);
    if (sel made.err) { ret made; }
    val room: res[usize, allocator.Error] = vector.reserve[u32](?stack, g.count::usize);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    val out: res[usize, allocator.Error] = vector.reserve[u32](?post, g.count::usize);
    if (sel out.err) { ret err[allocator.Error].err{out.err}; }

    d.rank.data[g.entry] = 0;
    vector.push[u32](?stack, g.entry);
    for (stack.len > 0) {
        val n:     u32        = stack.data[stack.len - 1];
        val succs: Slice[u32] = graph.successors(g, n);
        if (next.data[n]::usize < succs.size) {
            val s: u32 = succs.data[next.data[n]];
            next.data[n] = next.data[n] + 1;
            if (d.rank.data[s] == NONE) {
                d.rank.data[s] = 0;
                vector.push[u32](?stack, s);
            }
            cnt;
        }
        stack.len = stack.len - 1;
        vector.push[u32](?post, n);
    }
    val held: res[usize, allocator.Error] = vector.reserve[u32](?d.order, post.len);
    if (sel held.err) { ret err[allocator.Error].err{held.err}; }
    var i: usize = post.len;
    for (i > 0) {
        i                         = i - 1;
        d.rank.data[post.data[i]] = d.order.len::u32;
        vector.push[u32](?d.order, post.data[i]);
    }
    ret err[allocator.Error].ok{};
}

fun intersect(d: *Dominance, left: u32, right: u32) u32 {
    var x: u32 = left;
    var y: u32 = right;
    for (x != y) {
        for (d.rank.data[x] > d.rank.data[y]) { x = d.idom.data[x]; }
        for (d.rank.data[y] > d.rank.data[x]) { y = d.idom.data[y]; }
    }
    ret x;
}

fun dominators(g: *Graph, d: *Dominance) {
    if (d.order.len == 0) { ret; }
    d.idom.data[g.entry] = g.entry;
    var changed: bool = true;
    for (changed) {
        changed = false;
        var i: usize = 1;
        for (i < d.order.len) {
            val n:     u32        = d.order.data[i];
            val preds: Slice[u32] = graph.predecessors(g, n);
            var found: u32        = NONE;
            var j:     usize      = 0;
            for (j < preds.size) {
                val p: u32 = preds.data[j];
                if (d.idom.data[p] != NONE) {
                    if (found == NONE) { found = p; }
                    or                 { found = intersect(d, p, found); }
                }
                j = j + 1;
            }
            if (d.idom.data[n] != found) {
                d.idom.data[n] = found;
                changed        = true;
            }
            i = i + 1;
        }
    }
}

# the dominator tree's children, and each node's preorder interval in it
fun tree(a: *allocator.Allocator, g: *Graph, d: *Dominance) err[allocator.Error] {
    var keys:  vector.Vector[u32] = vector.init[u32](a);
    var items: vector.Vector[u32] = vector.init[u32](a);
    var stack: vector.Vector[u32] = vector.init[u32](a);
    var next:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[u32](?items);
        vector.dnit[u32](?stack);
        vector.dnit[u32](?next);
    }
    val rk: res[usize, allocator.Error] = vector.reserve[u32](?keys, d.order.len);
    if (sel rk.err) { ret err[allocator.Error].err{rk.err}; }
    val ri: res[usize, allocator.Error] = vector.reserve[u32](?items, d.order.len);
    if (sel ri.err) { ret err[allocator.Error].err{ri.err}; }
    var i: usize = 1;
    for (i < d.order.len) {
        val n: u32 = d.order.data[i];
        vector.push[u32](?keys, d.idom.data[n]);
        vector.push[u32](?items, n);
        i = i + 1;
    }
    val built: res[Lists[u32], allocator.Error] = graph.lists[u32](a, g.count, slice(?keys), slice(?items));
    if (sel built.err) { ret err[allocator.Error].err{built.err}; }
    d.children = built.ok;
    if (d.order.len == 0) { ret err[allocator.Error].ok{}; }

    val made: err[allocator.Error] = nodes(a, g.count, 0, ?next);
    if (sel made.err) { ret made; }
    val rs: res[usize, allocator.Error] = vector.reserve[u32](?stack, d.order.len);
    if (sel rs.err) { ret err[allocator.Error].err{rs.err}; }
    var clock: u32 = 0;
    d.enter.data[g.entry] = clock;
    vector.push[u32](?stack, g.entry);
    for (stack.len > 0) {
        val n:    u32        = stack.data[stack.len - 1];
        val kids: Slice[u32] = graph.list[u32](?d.children, n);
        if (next.data[n]::usize < kids.size) {
            val c: u32 = kids.data[next.data[n]];
            next.data[n]    = next.data[n] + 1;
            clock           = clock + 1;
            d.enter.data[c] = clock;
            vector.push[u32](?stack, c);
            cnt;
        }
        d.leave.data[n] = clock;
        stack.len       = stack.len - 1;
    }
    ret err[allocator.Error].ok{};
}

# each join's frontier entries, walked up from its predecessors to its dominator
fun frontiers(a: *allocator.Allocator, g: *Graph, d: *Dominance) err[allocator.Error] {
    var keys:  vector.Vector[u32] = vector.init[u32](a);
    var items: vector.Vector[u32] = vector.init[u32](a);
    var last:  vector.Vector[u32] = vector.init[u32](a);
    fin {
        vector.dnit[u32](?keys);
        vector.dnit[u32](?items);
        vector.dnit[u32](?last);
    }
    val made: err[allocator.Error] = nodes(a, g.count, NONE, ?last);
    if (sel made.err) { ret made; }
    var i: usize = 0;
    for (i < d.order.len) {
        val n:     u32        = d.order.data[i];
        val preds: Slice[u32] = graph.predecessors(g, n);
        if (preds.size >= 2) {
            var j: usize = 0;
            for (j < preds.size) {
                var runner: u32 = preds.data[j];
                if (d.idom.data[runner] != NONE) {
                    for (runner != d.idom.data[n]) {
                        if (last.data[runner] != n) {
                            last.data[runner] = n;
                            val pk: res[usize, allocator.Error] = vector.push[u32](?keys, runner);
                            if (sel pk.err) { ret err[allocator.Error].err{pk.err}; }
                            val pi: res[usize, allocator.Error] = vector.push[u32](?items, n);
                            if (sel pi.err) { ret err[allocator.Error].err{pi.err}; }
                        }
                        runner = d.idom.data[runner];
                    }
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    val built: res[Lists[u32], allocator.Error] = graph.lists[u32](a, g.count, slice(?keys), slice(?items));
    if (sel built.err) { ret err[allocator.Error].err{built.err}; }
    d.frontier = built.ok;
    ret err[allocator.Error].ok{};
}

fun empty(a: *allocator.Allocator) Lists[u32] {
    ret Lists[u32]{first: vector.init[u32](a), items: vector.init[u32](a)};
}

# the dominance of a graph
# ---
# a:   the allocator the result takes
# g:   the graph
# ret: its dominance, or the allocator's refusal
pub fun compute(a: *allocator.Allocator, g: *Graph) res[Dominance, allocator.Error] {
    var d: Dominance;
    d.order    = vector.init[u32](a);
    d.children = empty(a);
    d.frontier = empty(a);
    var failed: err[allocator.Error] = nodes(a, g.count, NONE, ?d.rank);
    keep(?failed, nodes(a, g.count, NONE, ?d.idom));
    keep(?failed, nodes(a, g.count, NONE, ?d.enter));
    keep(?failed, nodes(a, g.count, NONE, ?d.leave));
    if (sel failed.ok) { keep(?failed, postorder(a, g, ?d)); }
    if (sel failed.ok) {
        dominators(g, ?d);
        keep(?failed, tree(a, g, ?d));
    }
    if (sel failed.ok) { keep(?failed, frontiers(a, g, ?d)); }
    if (sel failed.err) {
        dnit(?d);
        ret res[Dominance, allocator.Error].err{failed.err};
    }
    ret res[Dominance, allocator.Error].ok{d};
}

# give back a dominance's storage
pub fun dnit(d: *Dominance) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u32](?d.order);
    keep(?failed, vector.dnit[u32](?d.rank));
    keep(?failed, vector.dnit[u32](?d.idom));
    keep(?failed, graph.release[u32](?d.children));
    keep(?failed, graph.release[u32](?d.frontier));
    keep(?failed, vector.dnit[u32](?d.enter));
    keep(?failed, vector.dnit[u32](?d.leave));
    ret failed;
}

# the reachable nodes in reverse postorder, the entry first
pub fun order(d: *Dominance) Slice[u32] {
    ret slice(?d.order);
}

# whether the entry reaches a node
pub fun reachable(d: *Dominance, n: u32) bool {
    ret d.rank.data[n] != NONE;
}

# a node's immediate dominator, none for the entry and an unreachable node
pub fun idom(d: *Dominance, n: u32) opt[u32] {
    val up: u32 = d.idom.data[n];
    if (up == NONE || up == n) { ret opt[u32].none{}; }
    ret opt[u32].some{up};
}

# whether every path from the entry to b passes through a, a node dominating itself
pub fun dominates(d: *Dominance, a: u32, b: u32) bool {
    if (!reachable(d, a) || !reachable(d, b)) { ret false; }
    ret d.enter.data[a] <= d.enter.data[b] && d.enter.data[b] <= d.leave.data[a];
}

# the nodes a node immediately dominates
pub fun children(d: *Dominance, n: u32) Slice[u32] {
    ret graph.list[u32](?d.children, n);
}

# a node's dominance frontier, each node once
pub fun frontier(d: *Dominance, n: u32) Slice[u32] {
    ret graph.list[u32](?d.frontier, n);
}

fun holds(s: Slice[u32], n: u32) bool {
    var i: usize = 0;
    for (i < s.size) {
        if (s.data[i] == n) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun same_set(s: Slice[u32], want: Slice[u32]) bool {
    if (s.size != want.size) { ret false; }
    var i: usize = 0;
    for (i < want.size) {
        if (!holds(s, want.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

test dominance__irreducible_graph {
    var a: allocator.Allocator;
    page.make(?a);
    # 0 enters the cycle 1 <-> 2 at both nodes, so neither dominates the other
    var edges: [7]Edge = [7]Edge{
        Edge{from: 0, to: 1},
        Edge{from: 0, to: 2},
        Edge{from: 1, to: 2},
        Edge{from: 2, to: 1},
        Edge{from: 1, to: 3},
        Edge{from: 2, to: 3},
        Edge{from: 3, to: 4},
    };
    val made: res[Graph, allocator.Error] = graph.init(?a, 6, 0, Slice[Edge]{data: ?edges[0], size: 7});
    if (sel made.err) { ret 1; }
    var g: Graph = made.ok;
    fin { graph.dnit(?g); }
    val got: res[Dominance, allocator.Error] = compute(?a, ?g);
    if (sel got.err) { ret 1; }
    var d: Dominance = got.ok;
    fin { dnit(?d); }

    var want: [6]u32 = [6]u32{NONE, 0, 0, 0, 3, NONE};
    var n:    u32    = 0;
    for (n < 6) {
        val up: opt[u32] = idom(?d, n);
        if (want[n] == NONE && sel up.some)                          { ret 2; }
        if (want[n] != NONE && !(sel up.some && up.some == want[n])) { ret 2; }
        n = n + 1;
    }
    if (dominates(?d, 1, 2) || dominates(?d, 2, 1))                           { ret 3; }
    if (!dominates(?d, 0, 4) || !dominates(?d, 3, 4) || !dominates(?d, 4, 4)) { ret 3; }
    if (reachable(?d, 5) || dominates(?d, 0, 5))                              { ret 3; }

    var one:  [2]u32 = [2]u32{2, 3};
    var two:  [2]u32 = [2]u32{1, 3};
    var none: [1]u32 = [1]u32{0};
    if (!same_set(frontier(?d, 1), Slice[u32]{data: ?one[0], size: 2}))  { ret 4; }
    if (!same_set(frontier(?d, 2), Slice[u32]{data: ?two[0], size: 2}))  { ret 4; }
    if (!same_set(frontier(?d, 0), Slice[u32]{data: ?none[0], size: 0})) { ret 4; }
    if (!same_set(frontier(?d, 3), Slice[u32]{data: ?none[0], size: 0})) { ret 4; }
    ret 0;
}
