# where the storage of each slot a marker names is begun, the one forward dataflow every reader of `slot.begin` and
# `slot.end` takes: the storage rule of the verifier and the inliner's copy of a body
#
# at each point a slot is begun on some path from the entry (may) and on every path (must). a begin makes it begun
# on both, an end on neither, and where paths join may is the union of what reaches and must the intersection, over
# the blocks the entry reaches in reverse postorder to a fixed point. nothing is begun at the entry. each alloca a
# marker names takes a number, a bit of every set, and a slot no marker names takes none: it lasts the whole function
# and is not tracked. a block the entry does not reach is not walked.
#
# cost: one scan of the body, and passes over the reached blocks until nothing changes, each of the instructions of
# those blocks and the words of a set per edge, a word per 64 slots marked.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.opcode.table;
use mirl.ir.value.Def;

# no slot: an instruction that is no alloca a marker names
pub val NONE: u32 = 0xffffffff;

# the state of every marked slot of one body
# ---
# number: each instruction's slot number where it is an alloca a marker names, NONE for any other
# slots:  how many slots a marker names
# words:  the words of one set, a bit per slot
# may:    each block's slots begun out of it on some path
# must:   each block's slots begun out of it on every path
# seen:   each block, whether its sets out were computed
# cur:    the slots begun on some path at the walk's point
# all:    the slots begun on every path at the walk's point
pub rec Storage {
    number: vector.Vector[u32];
    slots:  u32;
    words:  usize;
    may:    vector.Vector[u64];
    must:   vector.Vector[u64];
    seen:   vector.Vector[bool];
    cur:    vector.Vector[u64];
    all:    vector.Vector[u64];
}

# a marker whose operand is no alloca's result
# ---
# block: the block it stands in
# at:    the marker
pub rec Stray {
    block: Block;
    at:    Instruction;
}

# no state, taking storage from `a`
pub fun init(a: *allocator.Allocator) Storage {
    ret Storage{number: vector.init[u32](a), slots: 0, words: 0, may: vector.init[u64](a), must: vector.init[u64](a), seen: vector.init[bool](a), cur: vector.init[u64](a), all: vector.init[u64](a)};
}

# give back the storage of a state
pub fun dnit(s: *Storage) {
    vector.dnit[u32](?s.number);
    vector.dnit[u64](?s.may);
    vector.dnit[u64](?s.must);
    vector.dnit[bool](?s.seen);
    vector.dnit[u64](?s.cur);
    vector.dnit[u64](?s.all);
}

fun bit(v: *vector.Vector[u64], n: u32) bool {
    ret ((v.data[(n / 64)::usize] >> (n % 64)::u64) & 1) != 0;
}

fun put(v: *vector.Vector[u64], n: u32, on: bool) {
    val k: usize = (n / 64)::usize;
    if (on) { v.data[k] = v.data[k] | (1u64 << (n % 64)::u64); }
    or      { v.data[k] = v.data[k] & ~(1u64 << (n % 64)::u64); }
}

# the alloca a marker's operand is the result of
# ---
# b:   the body
# d:   the marker
# ret: the alloca, NONE where the operand is no alloca's result
pub fun alloca_of(b: *Body, d: *InstructionData) u32 {
    if (d.operands.len != 1) { ret NONE; }
    val v:   Value = d.operands.data[0];
    val def: Def   = b.values.data[v].def;
    if (!(sel def.result)) { ret NONE; }
    val x: Instruction = def.result.instruction;
    if (b.instructions.data[x].opcode != table.ALLOCA) { ret NONE; }
    ret x;
}

# number the slots the markers of body `b` name, every block's, reached or not
# ---
# s:   the state, which forgets any body it held
# b:   the body
# ret: none, or the first marker whose operand is no alloca's result, after which the numbering is partial, or the
#      allocator's refusal
pub fun numbered(s: *Storage, b: *Body) res[opt[Stray], allocator.Error] {
    vector.clear[u32](?s.number);
    s.slots = 0;
    s.words = 0;
    val err_filled: err[allocator.Error] = slice.fill[u32](?s.number, b.instructions.len, NONE);
    if (sel err_filled.err) { ret res[opt[Stray], allocator.Error].err{err_filled.err}; }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                val d: *InstructionData = ?b.instructions.data[i];
                if (table.marks(d.opcode)) {
                    val x: u32 = alloca_of(b, d);
                    if (x == NONE) { ret res[opt[Stray], allocator.Error].ok{opt[Stray].some{Stray{block: k::u32, at: i}}}; }
                    if (s.number.data[x] == NONE) {
                        s.number.data[x] = s.slots;
                        s.slots          = s.slots + 1;
                    }
                }
                i = d.next;
            }
        }
        k = k + 1;
    }
    s.words = ((s.slots + 63) / 64)::usize;
    ret res[opt[Stray], allocator.Error].ok{opt[Stray].none{}};
}

# set the walk's point to the start of block `k`: what is begun out of each predecessor the entry reaches and the
# solution has seen, nothing at the entry. a body with no slot marked has no state to set
# ---
# s: the state
# g: the body's graph view
# d: its dominance
# k: the block
pub fun enter(s: *Storage, g: *Graph, d: *Dominance, k: u32) {
    if (s.words == 0) { ret; }
    var i: usize = 0;
    for (i < s.words) {
        s.cur.data[i] = 0;
        s.all.data[i] = ~(0::u64);
        i             = i + 1;
    }
    val preds: Slice[u32] = graph.predecessors(g, k);
    var any:   bool       = false;
    var p:     usize      = 0;
    for (k != g.entry && p < preds.size) {
        val q: u32 = preds.data[p];
        if (dominance.reachable(d, q) && s.seen.data[q]) {
            any = true;
            i   = 0;
            for (i < s.words) {
                s.cur.data[i] = s.cur.data[i] | s.may.data[q::usize * s.words + i];
                s.all.data[i] = s.all.data[i] & s.must.data[q::usize * s.words + i];
                i             = i + 1;
            }
        }
        p = p + 1;
    }
    if (!any) {
        i = 0;
        for (i < s.words) {
            s.all.data[i] = 0;
            i             = i + 1;
        }
    }
}

# move the walk's point past instruction `d` of body `b`: a begin of a numbered slot begins it on every path, an end
# ends it on every path, and any other instruction changes nothing
pub fun step(s: *Storage, b: *Body, d: *InstructionData) {
    if (!table.marks(d.opcode)) { ret; }
    val x: u32 = alloca_of(b, d);
    if (x == NONE) { ret; }
    val n: u32 = s.number.data[x];
    if (n == NONE) { ret; }
    val begins: bool = d.opcode == table.SLOT_BEGIN;
    put(?s.cur, n, begins);
    put(?s.all, n, begins);
}

# solve what is begun out of every block the entry reaches, the slots numbered first
# ---
# s:   the state, numbered over `b`
# b:   the body
# g:   its graph view
# d:   its dominance
# ret: nothing, or the allocator's refusal
pub fun solve(s: *Storage, b: *Body, g: *Graph, d: *Dominance) err[allocator.Error] {
    vector.clear[u64](?s.may);
    vector.clear[u64](?s.must);
    vector.clear[bool](?s.seen);
    vector.clear[u64](?s.cur);
    vector.clear[u64](?s.all);
    var err_failed: err[allocator.Error] = slice.fill[u64](?s.may, b.blocks.len * s.words, 0);
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?s.must, b.blocks.len * s.words, 0); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[bool](?s.seen, b.blocks.len, false); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?s.cur, s.words, 0); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?s.all, s.words, 0); }
    if (sel err_failed.err)    { ret err_failed; }
    if (s.slots == 0)          { ret err[allocator.Error].ok{}; }
    val order:   Slice[u32] = dominance.order(d);
    var changed: bool       = true;
    for (changed) {
        changed = false;
        var n: usize = 0;
        for (n < order.size) {
            val k: u32 = order.data[n];
            enter(s, g, d, k);
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                step(s, b, ?b.instructions.data[i]);
                i = b.instructions.data[i].next;
            }
            val base: usize = k::usize * s.words;
            var w:    usize = 0;
            for (w < s.words) {
                if (!s.seen.data[k] || s.may.data[base + w] != s.cur.data[w] || s.must.data[base + w] != s.all.data[w]) { changed = true; }
                s.may.data[base + w]  = s.cur.data[w];
                s.must.data[base + w] = s.all.data[w];
                w                     = w + 1;
            }
            s.seen.data[k] = true;
            n              = n + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

# whether the slot of alloca `x` is begun on some path to the walk's point, false for a slot no marker names
pub fun may(s: *Storage, x: Instruction) bool {
    if (x::usize >= s.number.len) { ret false; }
    val n: u32 = s.number.data[x];
    ret n != NONE && bit(?s.cur, n);
}

# whether the slot of alloca `x` is begun on every path to the walk's point, false for a slot no marker names
pub fun must(s: *Storage, x: Instruction) bool {
    if (x::usize >= s.number.len) { ret false; }
    val n: u32 = s.number.data[x];
    ret n != NONE && bit(?s.all, n);
}

# whether the slot of alloca `x` is named by a marker of the body
pub fun marked(s: *Storage, x: Instruction) bool {
    ret x::usize < s.number.len && s.number.data[x] != NONE;
}
