# the nodes a dataflow visits again, in the order rounds over all of them would reach them
#
# a dataflow that sweeps its nodes in a fixed order, round after round until a
# round changes nothing, visits again every node whose input did not change,
# and when its meet is a semilattice's such a visit only gives the node's
# successors what they already hold. this visits only the nodes whose input
# changed since their last visit, in the order the rounds would: a node marked
# while the sweep stands at an earlier position is visited later in this round,
# one marked at or before it in the next round. so each node runs from the
# input the rounds would give it, and the dataflow reaches the fixed point the
# rounds reach, at the cost of a visit per change of a node's input and
# O(log n) per mark, not the whole order per round. positions are the places
# of the sweep's order, 0 to count - 1, which the dataflow maps to its nodes.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.heap;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;

# the positions whose input changed since their last visit
# ---
# dirty: whether each position's input changed since its last visit
# round: the changed positions after the one the sweep stands at, the least first
# next:  the changed positions at or before it, for the round after
# at:    the position the sweep stands at
pub rec Rounds {
    dirty: vector.Vector[bool];
    round: heap.Heap[u32, heap.Min];
    next:  vector.Vector[u32];
    at:    u32;
}

# no positions, holding no storage
pub fun init(a: *allocator.Allocator) Rounds {
    ret Rounds{dirty: vector.init[bool](a), round: heap.init[u32, heap.Min](a), next: vector.init[u32](a), at: 0};
}

# give back the storage
pub fun dnit(r: *Rounds) err[allocator.Error] {
    var err_failed: err[allocator.Error] = vector.dnit[bool](?r.dirty);
    keep(?err_failed, heap.dnit[u32, heap.Min](?r.round));
    keep(?err_failed, vector.dnit[u32](?r.next));
    ret err_failed;
}

# `count` positions, none of them changed, the sweep before the first
pub fun reset(r: *Rounds, count: u32) err[allocator.Error] {
    vector.clear[bool](?r.dirty);
    vector.clear[u32](?r.next);
    for {
        val opt_left: opt[u32] = heap.pop[u32, heap.Min](?r.round);
        if (sel opt_left.none) { brk; }
    }
    r.at = 0;
    ret slice.fill[bool](?r.dirty, count::usize, false);
}

# position `n`'s input changed
pub fun mark(r: *Rounds, n: u32) err[allocator.Error] {
    if (r.dirty.data[n::usize]) { ret err[allocator.Error].ok{}; }
    r.dirty.data[n::usize] = true;
    var res_pushed: res[usize, allocator.Error] = res[usize, allocator.Error].ok{0};
    if (n > r.at)           { res_pushed = heap.push[u32, heap.Min](?r.round, n); }
    or                      { res_pushed = vector.push[u32](?r.next, n); }
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the next position to visit, the sweep then standing at it, or none once no input changed
pub fun take(r: *Rounds) res[opt[u32], allocator.Error] {
    if (r.round.len == 0) {
        var i: usize = 0;
        for (i < r.next.len) {
            val res_pushed: res[usize, allocator.Error] = heap.push[u32, heap.Min](?r.round, r.next.data[i]);
            if (sel res_pushed.err) { ret res[opt[u32], allocator.Error].err{res_pushed.err}; }
            i = i + 1;
        }
        vector.clear[u32](?r.next);
    }
    val opt_n: opt[u32] = heap.pop[u32, heap.Min](?r.round);
    if (sel opt_n.none) { ret res[opt[u32], allocator.Error].ok{opt[u32].none{}}; }
    val n: u32 = opt_n.some;
    r.dirty.data[n::usize] = false;
    r.at                   = n;
    ret res[opt[u32], allocator.Error].ok{opt[u32].some{n}};
}
