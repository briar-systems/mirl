# dataflow over the graph view: the backward solver every liveness reads, and its forward mirror, held sparsely
#
# a problem numbers its facts below a count and gives each node two lists of
# them: what the node makes hold (gen) and what it ends (kill). backward, the
# facts live out of a node are the union of those live into its successors,
# and the facts live into it are its gen and what is live out of it that it
# does not kill. forward, the facts into a node are the union of those out of
# its predecessors, and the facts out of it are its gen and what is into it
# that it does not kill. the solution is the least that meets those
# equations, so each node's sets are lists of the facts that hold there, and
# their size is what holds across the nodes, not the nodes times the facts.
#
# the least solution has a fact live into a node exactly where a path from
# the node along successors reaches a node that gens the fact and no node the
# path leaves before that one kills it, and live out of a node exactly where
# it is live into a successor. those facts meet the equations, and the least
# solution holds no other: a fact the equations put into a node comes from
# its gen or from what is live out of it, so from a successor's, and
# following that back reaches a gen through nodes that do not kill it. the
# solver finds those paths backward, fact by fact: the fact is live into every
# node that gens it, and from each node it is live into, it is live out of
# each predecessor and live into that predecessor too unless it kills the
# fact. a node is taken into once per fact, so the walk ends. a forward
# problem walks the same way over the successors. a round-robin solve over
# bit sets from empty sets, in any order of the nodes, reaches the same least
# solution.
#
# a node's lists come out in ascending order of fact, with no fact twice. a
# problem's lists may name a fact twice. with f facts, n nodes, g and k
# entries in the gen and kill lists and e the edges of every node a fact is
# into, summed over the facts, a solve takes O(f + n + g + k + e), the size of
# its input and its solution.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;

# a problem
# ---
# facts: how many facts there are, each numbered below it
# gen:   what each node makes hold: backward, what it reads before it writes. a list for every node of the graph
# kill:  what each node ends: backward, what it writes. a list for every node of the graph
pub rec Problem {
    facts: u32;
    gen:   *Lists[u32];
    kill:  *Lists[u32];
}

# a fact found to hold at a node
# ---
# node: the node
# fact: the fact
rec Found {
    node: u32;
    fact: u32;
}

# what a solve keeps of one node, each mark one more than the fact the solve is at
# ---
# killed:   the mark where the node kills the fact
# held:     the mark where the fact holds where the node's gen feeds
# past:     the mark where the fact holds where the node's edges carry it to
# at_count: how many facts are found to hold where the node's gen feeds
# by_count: how many facts are found to hold where its edges carry them to
# stack:    the walk's stack of nodes whose neighbours it has yet to visit, held in the first nodes in order
rec Node {
    killed:   u32;
    held:     u32;
    past:     u32;
    at_count: u32;
    by_count: u32;
    stack:    u32;
}

# where a fact's nodes start among the nodes that gen and that kill the facts, the next fact's where they end
# ---
# gens:  its first among the nodes that gen a fact
# kills: its first among the nodes that kill a fact
rec Fact {
    gens:  u32;
    kills: u32;
}

# the storage a solve works in, kept between solves
# ---
# facts: where each fact's nodes start, then one past the last fact's
# gens:  each fact's nodes that gen it, ascending, fact by fact
# kills: each fact's nodes that kill it, ascending, fact by fact
# nodes: what the solve keeps of each node
# at:    each fact found where gen feeds, as the facts ascend
# by:    each fact found where the edges carry it to, as the facts ascend
pub rec Work {
    facts: vector.Vector[Fact];
    gens:  vector.Vector[u32];
    kills: vector.Vector[u32];
    nodes: vector.Vector[Node];
    at:    vector.Vector[Found];
    by:    vector.Vector[Found];
}

# storage for solves, holding none yet
pub fun work(a: *allocator.Allocator) Work {
    ret Work{facts: vector.init[Fact](a), gens: vector.init[u32](a), kills: vector.init[u32](a), nodes: vector.init[Node](a), at: vector.init[Found](a), by: vector.init[Found](a)};
}

# give back the storage of solves
pub fun work_dnit(w: *Work) err[allocator.Error] {
    var err_failed: err[allocator.Error] = vector.dnit[Fact](?w.facts);
    keep(?err_failed, vector.dnit[u32](?w.gens));
    keep(?err_failed, vector.dnit[u32](?w.kills));
    keep(?err_failed, vector.dnit[Node](?w.nodes));
    keep(?err_failed, vector.dnit[Found](?w.at));
    keep(?err_failed, vector.dnit[Found](?w.by));
    ret err_failed;
}

# lists emptied, their storage kept, with the first node's list open for `fact`
pub fun rows(l: *Lists[u32]) err[allocator.Error] {
    vector.clear[u32](?l.first);
    vector.clear[u32](?l.items);
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?l.first, 0);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# fact `f` added to the open node's list
pub fun fact(l: *Lists[u32], f: u32) err[allocator.Error] {
    if (l.items.len < l.items.cap) {
        l.items.data[l.items.len] = f;
        l.items.len               = l.items.len + 1;
        ret err[allocator.Error].ok{};
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?l.items, f);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# the open node's list closed and the next node's opened
pub fun next(l: *Lists[u32]) err[allocator.Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?l.first, l.items.len::u32);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# a node's list
pub fun row(l: *Lists[u32], n: u32) Slice[u32] {
    ret graph.list[u32](l, n);
}

# the gen and kill lists of a problem turned over: each fact's nodes, ascending, in the work's gens and kills. a fact
# no node gens holds nowhere and the solve passes it over, so its kills are left out
fun turned(w: *Work, nodes: u32, p: Problem) err[allocator.Error] {
    vector.clear[Fact](?w.facts);
    vector.clear[u32](?w.gens);
    vector.clear[u32](?w.kills);
    val gen_total:  usize                = p.gen.items.len;
    var err_failed: err[allocator.Error] = slice.fill[Fact](?w.facts, p.facts::usize + 1, Fact{});
    if (!(sel err_failed.err)) {
        val res_gens: res[usize, allocator.Error] = vector.reserve[u32](?w.gens, gen_total);
        if (sel res_gens.err) { err_failed = err[allocator.Error].err{res_gens.err}; }
    }
    if (sel err_failed.err) { ret err_failed; }
    var first: *Fact = w.facts.data;
    var k:     usize = 0;
    for (k < gen_total) {
        first[p.gen.items.data[k] + 1].gens = first[p.gen.items.data[k] + 1].gens + 1;
        k                                   = k + 1;
    }
    var kill_total: usize = 0;
    k = 0;
    for (k < p.kill.items.len) {
        val fact: u32 = p.kill.items.data[k];
        if (first[fact + 1].gens != 0) {
            first[fact + 1].kills = first[fact + 1].kills + 1;
            kill_total            = kill_total + 1;
        }
        k = k + 1;
    }
    val res_kills: res[usize, allocator.Error] = vector.reserve[u32](?w.kills, kill_total);
    if (sel res_kills.err) { ret err[allocator.Error].err{res_kills.err}; }
    first = w.facts.data;
    var f: usize = 1;
    for (f <= p.facts::usize) {
        first[f].gens  = first[f].gens + first[f - 1].gens;
        first[f].kills = first[f].kills + first[f - 1].kills;
        f              = f + 1;
    }
    var n: u32 = 0;
    for (n < nodes) {
        var e: u32 = p.kill.first.data[n];
        for (e < p.kill.first.data[n + 1]) {
            val fact: u32 = p.kill.items.data[e];
            if (first[fact].gens != first[fact + 1].gens) {
                w.kills.data[first[fact].kills] = n;
                first[fact].kills               = first[fact].kills + 1;
            }
            e = e + 1;
        }
        n = n + 1;
    }
    n = 0;
    for (n < nodes) {
        var e: u32 = p.gen.first.data[n];
        for (e < p.gen.first.data[n + 1]) {
            val fact: u32 = p.gen.items.data[e];
            w.gens.data[first[fact].gens] = n;
            first[fact].gens              = first[fact].gens + 1;
            e                             = e + 1;
        }
        n = n + 1;
    }
    f = p.facts::usize;
    for (f > 0) {
        first[f] = first[f - 1];
        f        = f - 1;
    }
    first[0]    = Fact{};
    w.gens.len  = gen_total;
    w.kills.len = kill_total;
    ret err[allocator.Error].ok{};
}

# room for `n` more of what a solve finds
fun room(v: *vector.Vector[Found], n: usize) err[allocator.Error] {
    val res_room: res[usize, allocator.Error] = vector.reserve[Found](v, n);
    if (sel res_room.err) { ret err[allocator.Error].err{res_room.err}; }
    ret err[allocator.Error].ok{};
}

# what a solve found, each node's facts in the order found, into `out`, `at` choosing the count of what gen feeds
fun settled(found_at: *vector.Vector[Found], nodes: *vector.Vector[Node], at: bool, out: *Lists[u32]) err[allocator.Error] {
    vector.clear[u32](?out.first);
    vector.clear[u32](?out.items);
    val count:      usize                = nodes.len;
    var err_failed: err[allocator.Error] = slice.fill[u32](?out.first, count + 1, 0);
    if (!(sel err_failed.err)) {
        val res_room: res[usize, allocator.Error] = vector.reserve[u32](?out.items, found_at.len);
        if (sel res_room.err) { err_failed = err[allocator.Error].err{res_room.err}; }
    }
    if (sel err_failed.err) { ret err_failed; }
    val first: *u32  = out.first.data;
    var n:     usize = 0;
    for (n < count) {
        var c: u32 = nodes.data[n].by_count;
        if (at) { c = nodes.data[n].at_count; }
        first[n + 1] = first[n] + c;
        n            = n + 1;
    }
    var k: usize = 0;
    for (k < found_at.len) {
        val x: Found = found_at.data[k];
        out.items.data[first[x.node]] = x.fact;
        first[x.node]                 = first[x.node] + 1;
        k                             = k + 1;
    }
    n = count;
    for (n > 0) {
        first[n] = first[n - 1];
        n        = n - 1;
    }
    first[0]      = 0;
    out.items.len = found_at.len;
    ret err[allocator.Error].ok{};
}

# the least solution of a problem whose facts flow against `edges`: `at` where a node's gen feeds, `by` where the facts
# its neighbours along `edges` hold arrive. backward, `edges` are the predecessors, `at` what is live into a node and
# `by` what is live out of it. forward, `edges` are the successors, `at` what is out of a node and `by` what is into it.
# a fact no node gens holds nowhere, so it is passed over. `at` or `by` may be nil where the caller reads neither
fun solve(w: *Work, nodes: u32, edges: *Lists[u32], p: Problem, at: *Lists[u32], by: *Lists[u32]) err[allocator.Error] {
    vector.clear[Node](?w.nodes);
    vector.clear[Found](?w.at);
    vector.clear[Found](?w.by);
    var err_failed: err[allocator.Error] = turned(w, nodes, p);
    keep(?err_failed, slice.fill[Node](?w.nodes, nodes::usize, Node{}));
    if (sel err_failed.err) { ret err_failed; }
    val facts:  *Fact = w.facts.data;
    val gens:   *u32  = w.gens.data;
    val kills:  *u32  = w.kills.data;
    val node:   *Node = w.nodes.data;
    val starts: *u32  = edges.first.data;
    val near:   *u32  = edges.items.data;
    var f:      u32   = 0;
    for (f < p.facts) {
        val g_from: u32 = facts[f].gens;
        val g_to:   u32 = facts[f + 1].gens;
        if (g_from == g_to) {
            f = f + 1;
            cnt;
        }
        if (at != nil && w.at.cap - w.at.len < nodes::usize) { keep(?err_failed, room(?w.at, nodes::usize)); }
        if (by != nil && w.by.cap - w.by.len < nodes::usize) { keep(?err_failed, room(?w.by, nodes::usize)); }
        if (sel err_failed.err)                              { ret err_failed; }
        val mark: u32 = f + 1;
        var k:    u32 = facts[f].kills;
        for (k < facts[f + 1].kills) {
            node[kills[k]].killed = mark;
            k                     = k + 1;
        }
        var top: u32 = 0;
        k = g_from;
        for (k < g_to) {
            val n: u32 = gens[k];
            if (node[n].held != mark) {
                node[n].held = mark;
                if (at != nil) {
                    node[n].at_count    = node[n].at_count + 1;
                    w.at.data[w.at.len] = Found{node: n, fact: f};
                    w.at.len            = w.at.len + 1;
                }
                node[top].stack = n;
                top             = top + 1;
            }
            k = k + 1;
        }
        for (top > 0) {
            top = top - 1;
            val n: u32 = node[top].stack;
            var j: u32 = starts[n];
            for (j < starts[n + 1]) {
                val q: u32 = near[j];
                if (by != nil && node[q].past != mark) {
                    node[q].past        = mark;
                    node[q].by_count    = node[q].by_count + 1;
                    w.by.data[w.by.len] = Found{node: q, fact: f};
                    w.by.len            = w.by.len + 1;
                }
                if (node[q].killed != mark && node[q].held != mark) {
                    node[q].held = mark;
                    if (at != nil) {
                        node[q].at_count    = node[q].at_count + 1;
                        w.at.data[w.at.len] = Found{node: q, fact: f};
                        w.at.len            = w.at.len + 1;
                    }
                    node[top].stack = q;
                    top             = top + 1;
                }
                j = j + 1;
            }
        }
        f = f + 1;
    }
    if (at != nil) { keep(?err_failed, settled(?w.at, ?w.nodes, true, at)); }
    if (by != nil) { keep(?err_failed, settled(?w.by, ?w.nodes, false, by)); }
    ret err_failed;
}

# solve a backward problem
# ---
# w:        the storage the solve works in
# g:        the graph
# p:        the problem, a gen and a kill list for every node of `g`
# live_in:  filled with what is live into each node, nil where the caller reads none of it
# live_out: filled with what is live out of each node, nil where the caller reads none of it
# ret:      ok, or the allocator's refusal
pub fun backward(w: *Work, g: *Graph, p: Problem, live_in: *Lists[u32], live_out: *Lists[u32]) err[allocator.Error] {
    ret solve(w, g.count, ?g.predecessors, p, live_in, live_out);
}

# solve a forward problem
# ---
# w:        the storage the solve works in
# g:        the graph
# p:        the problem, a gen and a kill list for every node of `g`
# live_in:  filled with what holds into each node, nil where the caller reads none of it
# live_out: filled with what holds out of each node, nil where the caller reads none of it
# ret:      ok, or the allocator's refusal
pub fun forward(w: *Work, g: *Graph, p: Problem, live_in: *Lists[u32], live_out: *Lists[u32]) err[allocator.Error] {
    ret solve(w, g.count, ?g.successors, p, live_out, live_in);
}
