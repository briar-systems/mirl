# backward dataflow over the graph view, the solver every liveness reads
#
# each node has four sets of the same number of words: what it reads before
# it writes (gen), what it writes (kill), and what is live into and out of it.
# the bits live out of a node are the union of the bits live into its
# successors, and the bits live into it are its gen and what is live out of
# it that it does not kill. the nodes of `order` are visited from its end to
# its start until nothing changes, so an order that lists a node before its
# successors, as reverse postorder does, settles in the fewest passes. any
# order reaches the same fixed point, and a node it leaves out keeps the sets
# it was given. with b nodes, e edges and w words a pass takes O((b + e) w).

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;

# the sets of a backward problem, words per node, node n's starting at n * words
# ---
# words:    the words of one node's set
# gen:      what each node reads before it writes
# kill:     what each node writes
# live_in:  what is live into each node, solved
# live_out: what is live out of each node, solved
pub rec Sets {
    words:    u32;
    gen:      *vector.Vector[u64];
    kill:     *vector.Vector[u64];
    live_in:  *vector.Vector[u64];
    live_out: *vector.Vector[u64];
}

# solve a backward problem to its fixed point
# ---
# g:     the graph
# order: the nodes to solve, visited from its end
# s:     the sets, gen and kill given and live_in and live_out solved in place
pub fun backward(g: *Graph, order: Slice[u32], s: Sets) {
    val words:   usize = s.words::usize;
    var changed: bool  = true;
    for (changed) {
        changed = false;
        var i: usize = order.size;
        for (i > 0) {
            i = i - 1;
            val k:    u32        = order.data[i];
            val base: usize      = k::usize * words;
            val succ: Slice[u32] = graph.successors(g, k);
            var w:    usize      = 0;
            for (w < words) {
                var out: u64   = 0;
                var j:   usize = 0;
                for (j < succ.size) {
                    out = out | s.live_in.data[succ.data[j]::usize * words + w];
                    j   = j + 1;
                }
                s.live_out.data[base + w] = out;
                val into: u64 = s.gen.data[base + w] | (out & ~s.kill.data[base + w]);
                if (into != s.live_in.data[base + w]) {
                    s.live_in.data[base + w] = into;
                    changed                  = true;
                }
                w = w + 1;
            }
        }
    }
}
