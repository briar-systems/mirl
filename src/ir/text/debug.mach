# printing the debug table: files, locations, sites, debug types and variables
#
# the table prints one entry a line, `!` and the entry's name, ` = `, then its
# record, every file first and then every location, site, type and variable.

use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;

use ir_debug: mirl.ir.debug;
use mirl.ir.debug.Array;
use mirl.ir.debug.Base;
use mirl.ir.debug.Binding;
use mirl.ir.debug.Enumeration;
use mirl.ir.debug.File;
use mirl.ir.debug.Function;
use mirl.ir.debug.Kind;
use mirl.ir.debug.Location;
use mirl.ir.debug.Member;
use mirl.ir.debug.Pointer;
use mirl.ir.debug.Position;
use mirl.ir.debug.Shape;
use mirl.ir.debug.Site;
use mirl.ir.debug.Tagged;
use mirl.ir.debug.Type;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Printer;
use ir_type: mirl.ir.type;

# write every entry of the module's debug table
pub fun table(p: *Printer) {
    val t: *ir_debug.Table = ?p.m.debug;
    var i: usize           = 0;
    for (i < t.files.len) {
        printer.file_ref(p, File{index: i::u32});
        printer.text(p, " = ");
        file(p, File{index: i::u32});
        printer.newline(p);
        i = i + 1;
    }
    i = 0;
    for (i < t.positions.len) {
        printer.location_ref(p, Location{index: i::u32});
        printer.text(p, " = ");
        location(p, Location{index: i::u32});
        printer.newline(p);
        i = i + 1;
    }
    i = 0;
    for (i < t.sites.len) {
        printer.site_ref(p, Site{index: i::u32});
        printer.text(p, " = ");
        site(p, Site{index: i::u32});
        printer.newline(p);
        i = i + 1;
    }
    i = 0;
    for (i < t.nodes.len) {
        printer.dtype_ref(p, Type{index: i::u32});
        printer.text(p, " = ");
        dtype(p, Type{index: i::u32});
        printer.newline(p);
        i = i + 1;
    }
    i = 0;
    for (i < t.bindings.len) {
        printer.variable_ref(p, Binding{index: i::u32});
        printer.text(p, " = ");
        variable(p, Binding{index: i::u32});
        printer.newline(p);
        i = i + 1;
    }
}

# write a debug type's record: its key, source name and shape
fun dtype(p: *Printer, ty: Type) {
    val t:   *ir_debug.Table = ?p.m.debug;
    val key: opt[View]       = printer.from_debug[View](p, ir_debug.key(t, ty));
    val nm:  opt[View]       = printer.from_debug[View](p, ir_debug.name(t, ty));
    if (sel key.none) { ret; }
    if (sel nm.none)  { ret; }
    printer.text(p, "type ");
    printer.string(p, key.some);
    printer.byte(p, ' ');
    printer.string(p, nm.some);
    printer.byte(p, ' ');
    if (!t.nodes.data[ty.index].defined) {
        open(p, ty);
        ret;
    }
    val got: opt[Shape] = printer.from_debug[Shape](p, ir_debug.shape(t, ty));
    if (sel got.none) { ret; }
    val s: Shape = got.some;
    if (sel s.base)        { base(p, s.base); }
    or (sel s.structure)   { structure(p, layout(p, ty), s.structure); }
    or (sel s.union)       { union(p, layout(p, ty), s.union); }
    or (sel s.tagged)      { tagged(p, layout(p, ty), s.tagged); }
    or (sel s.enumeration) { enumeration(p, s.enumeration); }
    or (sel s.array)       { array(p, s.array); }
    or (sel s.pointer)     { pointer(p, s.pointer); }
    or (sel s.function)    { function(p, s.function); }
}

# the ir type an aggregate entry is laid out as
fun layout(p: *Printer, ty: Type) ir_type.Type {
    val got: opt[ir_type.Type] = printer.from_debug[ir_type.Type](p, ir_debug.layout(?p.m.debug, ty));
    if (sel got.none) { ret ir_type.Type{index: 0}; }
    ret got.some;
}

# write an entry declared and not yet defined: its kind, its layout when it
# has one, then `open`
fun open(p: *Printer, ty: Type) {
    val got: opt[Kind] = printer.from_debug[Kind](p, ir_debug.kind(?p.m.debug, ty));
    if (sel got.none) { ret; }
    val k: Kind = got.some;
    if (sel k.structure) { printer.text(p, "structure "); }
    or (sel k.union)     { printer.text(p, "union "); }
    or (sel k.tagged)    { printer.text(p, "tagged "); }
    if (sel k.structure || sel k.union || sel k.tagged) {
        printer.ty(p, layout(p, ty));
        printer.text(p, " open");
        ret;
    }
    if (sel k.enumeration) { printer.text(p, "enumeration open"); }
    or (sel k.array)       { printer.text(p, "array open"); }
    or (sel k.function)    { printer.text(p, "function open"); }
}

# file record, read by ir_debug.path
fun file(p: *Printer, f: File) {
    val got: opt[View] = printer.from_debug[View](p, ir_debug.path(?p.m.debug, f));
    if (sel got.none) { ret; }
    printer.text(p, "file ");
    printer.string(p, got.some);
}

# location record, read by ir_debug.position and written by `position`
fun location(p: *Printer, l: Location) {
    val got: opt[Position] = printer.from_debug[Position](p, ir_debug.position(?p.m.debug, l));
    if (sel got.none) { ret; }
    printer.text(p, "location ");
    position(p, got.some);
}

# a position: its file, line and column
fun position(p: *Printer, pos: Position) {
    printer.file_ref(p, pos.file);
    printer.byte(p, ' ');
    printer.number(p, pos.line::u64);
    printer.byte(p, ':');
    printer.number(p, pos.column::u64);
}

# site record, read by ir_debug.inlining
fun site(p: *Printer, s: Site) {
    val got: opt[ir_debug.Inlining] = printer.from_debug[ir_debug.Inlining](p, ir_debug.inlining(?p.m.debug, s));
    if (sel got.none) { ret; }
    val i: ir_debug.Inlining = got.some;
    printer.text(p, "site ");
    printer.location_ref(p, i.call);
    printer.byte(p, ' ');
    printer.string(p, i.callee);
    if (sel i.parent.some) {
        printer.text(p, " parent ");
        printer.site_ref(p, i.parent.some);
    }
}

# variable record, read by ir_debug.variable
fun variable(p: *Printer, b: Binding) {
    val got: opt[ir_debug.Variable] = printer.from_debug[ir_debug.Variable](p, ir_debug.variable(?p.m.debug, b));
    if (sel got.none) { ret; }
    val v: ir_debug.Variable = got.some;
    printer.text(p, "variable ");
    printer.string(p, v.name);
    printer.byte(p, ' ');
    printer.dtype_ref(p, v.type);
    printer.text(p, " declared ");
    printer.location_ref(p, v.declared);
    if (sel v.parameter.some) {
        printer.text(p, " parameter ");
        printer.number(p, v.parameter.some::u64);
    }
    if (sel v.holds.value)   { printer.text(p, " value"); }
    or (sel v.holds.storage) { printer.text(p, " storage"); }
}

# a member of a structure, union or tagged union
fun member(p: *Printer, m: Member) {
    printer.string(p, m.name);
    printer.text(p, ": ");
    printer.dtype_ref(p, m.type);
    printer.text(p, " field ");
    printer.number(p, m.field::u64);
}

# the members of an aggregate, joined by `, `
fun members(p: *Printer, list: Slice[Member]) {
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        member(p, list.data[i]);
        i = i + 1;
    }
}

# the debug types of a function signature, joined by `, `
fun dtype_list(p: *Printer, list: Slice[Type]) {
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.dtype_ref(p, list.data[i]);
        i = i + 1;
    }
}

# base shape
fun base(p: *Printer, b: Base) {
    printer.text(p, "base ");
    if (sel b.encoding.signed)    { printer.text(p, "signed"); }
    or (sel b.encoding.unsigned)  { printer.text(p, "unsigned"); }
    or (sel b.encoding.float)     { printer.text(p, "float"); }
    or (sel b.encoding.boolean)   { printer.text(p, "boolean"); }
    or (sel b.encoding.character) { printer.text(p, "character"); }
    or (sel b.encoding.address)   { printer.text(p, "address"); }
    printer.byte(p, ' ');
    printer.number(p, b.width::u64);
}

# structure shape, laid out as the ir type `at`
fun structure(p: *Printer, at: ir_type.Type, list: Slice[Member]) {
    printer.text(p, "structure ");
    printer.ty(p, at);
    printer.text(p, " {");
    members(p, list);
    printer.byte(p, '}');
}

# union shape, laid out as the ir type `at`
fun union(p: *Printer, at: ir_type.Type, list: Slice[Member]) {
    printer.text(p, "union ");
    printer.ty(p, at);
    printer.text(p, " {");
    members(p, list);
    printer.byte(p, '}');
}

# tagged union shape, laid out as the ir type `at`
fun tagged(p: *Printer, at: ir_type.Type, t: Tagged) {
    printer.text(p, "tagged ");
    printer.ty(p, at);
    printer.text(p, " discriminant ");
    member(p, t.discriminant);
    printer.text(p, " payload ");
    printer.number(p, t.payload::u64);
    printer.text(p, " {");
    var i: usize = 0;
    for (i < t.cases.size) {
        if (i > 0) { printer.text(p, ", "); }
        val c: ir_debug.Case = t.cases.data[i];
        printer.string(p, c.name);
        printer.byte(p, ' ');
        printer.number(p, c.value);
        if (sel c.payload.some) {
            printer.text(p, " payload ");
            member(p, c.payload.some);
        }
        i = i + 1;
    }
    printer.byte(p, '}');
}

# enumeration shape
fun enumeration(p: *Printer, e: Enumeration) {
    printer.text(p, "enumeration ");
    printer.dtype_ref(p, e.base);
    printer.text(p, " {");
    var i: usize = 0;
    for (i < e.enumerators.size) {
        if (i > 0) { printer.text(p, ", "); }
        val r: ir_debug.Enumerator = e.enumerators.data[i];
        printer.string(p, r.name);
        printer.byte(p, ' ');
        printer.number(p, r.value);
        i = i + 1;
    }
    printer.byte(p, '}');
}

# array shape
fun array(p: *Printer, a: Array) {
    printer.text(p, "array ");
    printer.dtype_ref(p, a.element);
    printer.byte(p, ' ');
    printer.number(p, a.count);
}

# pointer shape
fun pointer(p: *Printer, pt: Pointer) {
    printer.text(p, "pointer ");
    printer.string(p, pt.pointee);
}

# function shape
fun function(p: *Printer, f: Function) {
    printer.text(p, "function (");
    dtype_list(p, f.params);
    printer.text(p, ") -> (");
    dtype_list(p, f.results);
    printer.byte(p, ')');
}
