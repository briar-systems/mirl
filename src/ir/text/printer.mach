# the printer's state and the pieces every statement of the text is written from
#
# a printer keeps the first failure, after which every write is skipped, so a
# caller reads one outcome at the end. it names the module's structure and
# union types and their members once, before anything is written, and keeps
# the symbol names, which no value prints by.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.base.slice;
use mirl.ir.constant.ConstantData;
use ir_debug: mirl.ir.debug;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.language.Language;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.text.names;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Anchor;
use mirl.ir.text.notes.Note;
use mirl.ir.text.notes.Notes;
use types: mirl.ir.type;
use mirl.ir.type.Type;

# the version of mirl the text is written by and read by
pub val VERSION: str = $mach.project.version;

# why the text could not be written or compared
# ---
# write:  the writer refused the text
# alloc:  the allocator refused storage
# ir:     the module refused a read
# types:  the type table refused a read
# debug:  the debug table refused a read
# opcode: an instruction names an opcode with no row
# form:   a fact of a form written through this printer that the form's rows
#         do not have, such as a register
pub tag Error: u8 {
    write:  WriteError;
    alloc:  allocator.Error;
    ir:     module.Error;
    types:  types.Error;
    debug:  ir_debug.Error;
    opcode: opcode.Opcode;
    form:   str;
}

# one printing of a module
# ---
# w:       the writer the text goes to
# m:       the module printed
# failed:  the first failure, none while every write has succeeded
# values:  the names of the values of the function being printed
# blocks:  the names of its blocks
# types:   the name of each structure or union type, by type id
# members: the names of each one's members, by type id, empty for another type
# owned:   the member names made here, released with the printer
# symbols: the symbol names of the module and the literal words, which no
#          value takes
# words:   the type words no type name takes
# labels:  the words that follow a terminator's targets, which no block takes
# blank:   the last line written was blank, so a function needs none before it
# body:    the text is a body, which writes no version statement
# notes:   the comments to write beside what they were written beside, nil
#          for none
# trail:   the anchor whose trailing comments end the line being written
pub rec Printer {
    w:       *io.Writer;
    m:       *Module;
    failed:  opt[Error];
    values:  names.Names;
    blocks:  names.Names;
    types:   names.Names;
    members: vector.Vector[Slice[View]];
    owned:   vector.Vector[View];
    symbols: names.Blocked;
    words:   names.Blocked;
    labels:  names.Blocked;
    blank:   bool;
    body:    bool;
    notes:   *Notes;
    trail:   opt[Anchor];
}

# a printer of m to w, its names not yet given
pub fun init(w: *io.Writer, m: *Module) Printer {
    var p: Printer = Printer{
        w:       w,
        m:       m,
        failed:  opt[Error].none{},
        values:  names.init(m.a),
        blocks:  names.init(m.a),
        types:   names.init(m.a),
        members: vector.init[Slice[View]](m.a),
        owned:   vector.init[View](m.a),
        symbols: names.blocked(m.a),
        words:   names.blocked(m.a),
        labels:  names.blocked(m.a),
        blank:   false,
        body:    false,
        notes:   nil,
        trail:   opt[Anchor].none{},
    };
    ret p;
}

# give back the printer's storage
pub fun dnit(p: *Printer) {
    names.dnit(?p.values);
    names.dnit(?p.blocks);
    names.dnit(?p.types);
    var i: usize = 0;
    for (i < p.members.len) {
        slice.release[View](p.m.a, p.members.data[i]);
        i = i + 1;
    }
    vector.dnit[Slice[View]](?p.members);
    i = 0;
    for (i < p.owned.len) {
        slice.release_view(p.m.a, p.owned.data[i]);
        i = i + 1;
    }
    vector.dnit[View](?p.owned);
    names.unblock(?p.symbols);
    names.unblock(?p.words);
    names.unblock(?p.labels);
}

fun spelled(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun pushed[T](p: *Printer, r: res[usize, allocator.Error]) {
    if (sel r.err) { fail(p, Error.alloc{r.err}); }
}

fun kept_alloc(p: *Printer, r: err[allocator.Error]) bool {
    if (sel r.err) {
        fail(p, Error.alloc{r.err});
        ret false;
    }
    ret true;
}

# the words a type name never takes: every type keyword, every float word and
# every word an integer width spells
fun block_words(p: *Printer) {
    val words: [6]str = [6]str{"ptr", "vec", "handle", "fun", "rec", "uni"};
    var i:     usize  = 0;
    for (i < 6 && ok(p)) {
        kept_alloc(p, names.block(?p.words, spelled(words[i])));
        i = i + 1;
    }
    var f: u32 = 0;
    for (f < types.rows() && ok(p)) {
        val r: opt[types.Row] = types.row(types.Format{index: f});
        if (sel r.some) { kept_alloc(p, names.block(?p.words, spelled(r.some.word))); }
        f = f + 1;
    }
    var digits: [24]u8;
    i = 0;
    for (i < $length_of(types.Widths) && ok(p)) {
        digits[0] = 'i';
        val count:  usize                      = format.put_u64(?digits[1], types.WIDTHS[i]::u64);
        val copied: res[View, allocator.Error] = slice.copy_view(p.m.a, View{data: ?digits[0], len: count + 1});
        if (sel copied.err) { fail(p, Error.alloc{copied.err}); }
        or {
            pushed[View](p, vector.push[View](?p.owned, copied.ok));
            kept_alloc(p, names.block(?p.words, copied.ok));
        }
        i = i + 1;
    }
}

# the names a value never takes: the symbol names, so a callee written bare is
# never a value, and the words a literal or a binding record starts with
fun block_symbols(p: *Printer) {
    val words: [3]str = [3]str{"zero", "spec", "unavailable"};
    var i:     usize  = 0;
    for (i < 3 && ok(p)) {
        kept_alloc(p, names.block(?p.symbols, spelled(words[i])));
        i = i + 1;
    }
    i = 0;
    for (i < p.m.functions.len && ok(p)) {
        kept_alloc(p, names.block(?p.symbols, p.m.functions.data[i].data.name));
        i = i + 1;
    }
    i = 0;
    for (i < p.m.globals.len && ok(p)) {
        kept_alloc(p, names.block(?p.symbols, p.m.globals.data[i].data.name));
        i = i + 1;
    }
}

# the words a block never takes, which an instruction's metadata starts with
fun block_labels(p: *Printer) {
    val words: [3]str = [3]str{"at", "in", "holds"};
    var i:     usize  = 0;
    for (i < 3 && ok(p)) {
        kept_alloc(p, names.block(?p.labels, spelled(words[i])));
        i = i + 1;
    }
}

# the names of one aggregate's members, kept by the printer
fun name_members(p: *Printer, t: Type, count: usize, given: opt[types.Naming]) Slice[View] {
    var out: Slice[View] = Slice[View]{data: nil, size: 0};
    if (count == 0) { ret out; }
    val room: res[*View, allocator.Error] = allocator.allocate[View](p.m.a, count);
    if (sel room.err) {
        fail(p, Error.alloc{room.err});
        ret out;
    }
    out = Slice[View]{data: room.ok, size: count};
    var namer: names.Names = names.init(p.m.a);
    fin { names.dnit(?namer); }
    if (!kept_alloc(p, names.reset(?namer, count))) { ret Slice[View]{data: nil, size: 0}; }
    var i: usize = 0;
    for (i < count) {
        var own: opt[View] = opt[View].none{};
        if (sel given.some) {
            if (i < given.some.members.size) { own = opt[View].some{given.some.members.data[i]}; }
        }
        out.data[i] = View{data: nil, len: 0};
        var naming: err[allocator.Error] = err[allocator.Error].ok{};
        if (sel own.some && own.some.len > 0) { naming = names.give(?namer, i::u32, own); }
        or                                    { naming = names.give_at(?namer, i::u32, i::u64); }
        if (ok(p) && kept_alloc(p, naming)) {
            val copied: res[View, allocator.Error] = slice.copy_view(p.m.a, names.printed(?namer, i::u32));
            if (sel copied.err) { fail(p, Error.alloc{copied.err}); }
            or {
                out.data[i] = copied.ok;
                pushed[View](p, vector.push[View](?p.owned, copied.ok));
            }
        }
        i = i + 1;
    }
    ret out;
}

# name every structure and union type of the module and its members, in id order
fun name_types(p: *Printer) {
    val count: usize = p.m.types.nodes.len;
    if (!kept_alloc(p, names.reset(?p.types, count))) { ret; }
    p.types.blocked = opt[*names.Blocked].some{?p.words};
    p.types.prefix  = "T";
    var i: usize = 0;
    for (i < count && ok(p)) {
        val t:    Type             = Type{index: i::u32};
        val got:  opt[types.Shape] = from_types[types.Shape](p, types.shape(?p.m.types, t));
        var list: Slice[View]      = Slice[View]{data: nil, size: 0};
        if (sel got.some) {
            val s:         types.Shape = got.some;
            var n:         usize       = 0;
            var aggregate: bool        = false;
            if (sel s.structure) {
                n         = s.structure.members.size;
                aggregate = true;
            }
            or (sel s.union) {
                n         = s.union.members.size;
                aggregate = true;
            }
            if (aggregate) {
                val given: opt[types.Naming] = types.naming(?p.m.types, t);
                var own:   opt[View]         = opt[View].none{};
                if (sel given.some) { own = opt[View].some{given.some.name}; }
                kept_alloc(p, names.give(?p.types, i::u32, own));
                list = name_members(p, t, n, given);
            }
        }
        pushed[Slice[View]](p, vector.push[Slice[View]](?p.members, list));
        i = i + 1;
    }
}

# give the module's types and members their names and keep its symbol names,
# before anything is written
pub fun prepare(p: *Printer) {
    block_words(p);
    block_symbols(p);
    block_labels(p);
    name_types(p);
    p.values.blocked = opt[*names.Blocked].some{?p.symbols};
    p.blocks.blocked = opt[*names.Blocked].some{?p.labels};
}

# whether a type is a structure or union, which prints by its name
pub fun named(p: *Printer, t: Type) bool {
    ret t.index::usize < p.types.printed.len && names.given(?p.types, t.index);
}

# the name a member of a structure or union prints by
pub fun member_name(p: *Printer, t: Type, member: u32) opt[View] {
    if (t.index::usize >= p.members.len) { ret opt[View].none{}; }
    val list: Slice[View] = p.members.data[t.index];
    if (member::usize >= list.size || list.data[member].len == 0) { ret opt[View].none{}; }
    ret opt[View].some{list.data[member]};
}

# write the version, the target and the language statements, which every text
# begins with, the language when the module states one
pub fun header(p: *Printer) {
    if (!p.body) {
        anchor(p, notes.at(notes.VERSION, 0, 0), "");
        text(p, "mirl ");
        string(p, spelled(VERSION));
        text(p, ";");
        newline(p);
    }
    anchor(p, notes.at(notes.TARGET, 0, 0), "");
    target(p, module.target(p.m));
    val stated: opt[*Language] = module.language(p.m);
    if (sel stated.some) {
        anchor(p, notes.at(notes.LANGUAGE, 0, 0), "");
        text(p, "language { name: ");
        string(p, stated.some.name);
        text(p, ", code: ");
        number(p, stated.some.dwarf::u64);
        text(p, " };");
        newline(p);
    }
    newline(p);
    p.blank = true;
}

fun part(p: *Printer, key: str, v: View, last: bool) {
    text(p, key);
    text(p, ": ");
    string(p, v);
    if (!last) { text(p, ", "); }
}

# write a target statement, each part of its tuple by its key
fun target(p: *Printer, t: module.Tuple) {
    text(p, "target { ");
    part(p, "arch", t.arch, false);
    part(p, "sys", t.sys, false);
    part(p, "env", t.env, false);
    part(p, "abi", t.abi, false);
    part(p, "isa", t.isa, true);
    text(p, " };");
    newline(p);
}

# write a target statement alone, for a text written before its module is made
# ---
# w:   the writer the statement goes to
# t:   the tuple it names
# ret: ok, or the writer's refusal
pub fun target_line(w: *io.Writer, t: module.Tuple) err[Error] {
    var p: Printer;
    p.w      = w;
    p.failed = opt[Error].none{};
    p.notes  = nil;
    p.trail  = opt[Anchor].none{};
    target(?p, t);
    val failed: opt[Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{failed.some}; }
    ret err[Error].ok{};
}

# whether every write so far has succeeded
pub fun ok(p: *Printer) bool {
    ret sel p.failed.none;
}

# keep the first failure
pub fun fail(p: *Printer, e: Error) {
    if (ok(p)) { p.failed = opt[Error].some{e}; }
}

# a read of the module, or none after keeping its refusal
pub fun from_ir[T](p: *Printer, r: res[T, module.Error]) opt[T] {
    if (sel r.err) {
        fail(p, Error.ir{r.err});
        ret opt[T].none{};
    }
    ret opt[T].some{r.ok};
}

# a read of the type table, or none after keeping its refusal
pub fun from_types[T](p: *Printer, r: res[T, types.Error]) opt[T] {
    if (sel r.err) {
        fail(p, Error.types{r.err});
        ret opt[T].none{};
    }
    ret opt[T].some{r.ok};
}

# a read of the debug table, or none after keeping its refusal
pub fun from_debug[T](p: *Printer, r: res[T, ir_debug.Error]) opt[T] {
    if (sel r.err) {
        fail(p, Error.debug{r.err});
        ret opt[T].none{};
    }
    ret opt[T].some{r.ok};
}

fun wrote(p: *Printer, r: res[usize, WriteError]) {
    if (sel r.err) { fail(p, Error.write{r.err}); }
}

# write bytes as they are
pub fun bytes(p: *Printer, v: View) {
    if (!ok(p)) { ret; }
    wrote(p, format.write_bytes(p.w, v.data, v.len));
}

# write a string of the source as it is
pub fun text(p: *Printer, s: str) {
    if (!ok(p)) { ret; }
    wrote(p, format.write_str(p.w, s));
}

# write one byte
pub fun byte(p: *Printer, c: u8) {
    if (!ok(p)) { ret; }
    wrote(p, format.write_byte(p.w, c));
}

# end the line, after the trailing comments of the anchor it belongs to
pub fun newline(p: *Printer) {
    val trail: opt[Anchor] = p.trail;
    if (sel trail.some) {
        p.trail = opt[Anchor].none{};
        val list: Slice[Note] = notes.of(p.notes, trail.some);
        var i:    usize       = 0;
        for (i < list.size) {
            if (list.data[i].trailing) {
                byte(p, ' ');
                bytes(p, list.data[i].text);
            }
            i = i + 1;
        }
    }
    byte(p, '\n');
}

# write the comments of an anchor that stand on lines of their own, each at
# the indent, and take the anchor as the one whose trailing comments end the
# next line, nothing when the printing has no notes
pub fun anchor(p: *Printer, a: Anchor, indent: str) {
    if (p.notes == nil) { ret; }
    val list: Slice[Note] = notes.of(p.notes, a);
    var i:    usize       = 0;
    for (i < list.size) {
        if (!list.data[i].trailing) {
            text(p, indent);
            bytes(p, list.data[i].text);
            byte(p, '\n');
            p.blank = false;
        }
        i = i + 1;
    }
    p.trail = opt[Anchor].some{a};
}

# whether an anchor has comments of its own, which a statement written on one
# line then spreads over its lines to stand beside
pub fun noted(p: *Printer, a: Anchor) bool {
    ret p.notes != nil && notes.of(p.notes, a).size > 0;
}

# write a number in decimal
pub fun number(p: *Printer, n: u64) {
    if (!ok(p)) { ret; }
    wrote(p, format.write_u64(p.w, n));
}

# write a number of any width, its words low first, in hex
pub fun wide(p: *Printer, words: Slice[u64]) {
    var top: usize = words.size;
    for (top > 0 && words.data[top - 1] == 0) { top = top - 1; }
    text(p, "0x");
    if (top == 0) {
        byte(p, '0');
        ret;
    }
    if (!ok(p)) { ret; }
    wrote(p, format.write_hex_u64(p.w, words.data[top - 1], false));
    var i: usize = top - 1;
    for (i > 0 && ok(p)) {
        i = i - 1;
        val r: res[usize, format.FormatError] = format.format(p.w, "{:016x}", words.data[i]);
        if (sel r.err) {
            val e: format.FormatError = r.err;
            if (sel e.write) { fail(p, Error.write{e.write}); }
        }
    }
}

# whether a name is a path: idents joined by single dots
pub fun path(v: View) bool {
    if (v.len == 0) { ret false; }
    var start: usize = 0;
    var i:     usize = 0;
    for (i <= v.len) {
        if (i == v.len || v.data[i] == '.') {
            if (!names.ident(View{data: ?v.data[start], len: i - start})) { ret false; }
            start = i + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun hex_digit(d: u8) u8 {
    if (d < 10) { ret '0' + d; }
    ret 'a' + (d - 10);
}

# write a quoted string, escaping what the grammar escapes
pub fun string(p: *Printer, v: View) {
    byte(p, '"');
    var i: usize = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        if (c == '"' || c == '\\') {
            byte(p, '\\');
            byte(p, c);
        }
        or (c < 0x20 || c > 0x7e) {
            text(p, "\\x");
            byte(p, hex_digit(c >> 4));
            byte(p, hex_digit(c & 0x0f));
        }
        or { byte(p, c); }
        i = i + 1;
    }
    byte(p, '"');
}

# write a name, bare when it is a path and quoted otherwise
pub fun name(p: *Printer, v: View) {
    if (path(v)) { bytes(p, v); }
    or           { string(p, v); }
}

# write a name held as a string of the source, such as a row's
pub fun word(p: *Printer, s: str) {
    name(p, spelled(s));
}

# write a debug entry's name, its kind's letter and its position
pub fun entry(p: *Printer, kind: u8, index: u32) {
    byte(p, kind);
    number(p, index::u64);
}

# write the name of a source file
pub fun file_ref(p: *Printer, f: ir_debug.File) {
    entry(p, 'f', f.index);
}

# write the name of a source location
pub fun location_ref(p: *Printer, l: ir_debug.Location) {
    entry(p, 'l', l.index);
}

# write the name of an inlining site
pub fun site_ref(p: *Printer, s: ir_debug.Site) {
    entry(p, 's', s.index);
}

# write the name of a debug type
pub fun dtype_ref(p: *Printer, t: ir_debug.Type) {
    entry(p, 't', t.index);
}

# write the name of a variable binding
pub fun variable_ref(p: *Printer, b: ir_debug.Binding) {
    entry(p, 'v', b.index);
}

# write the name of a function or global
pub fun symbol(p: *Printer, s: Symbol) {
    if (sel s.function) {
        val d: opt[FunctionData] = from_ir[FunctionData](p, module.function_data(p.m, s.function));
        if (sel d.some) { name(p, d.some.name); }
        ret;
    }
    val g: opt[GlobalData] = from_ir[GlobalData](p, module.global_data(p.m, s.global));
    if (sel g.some) { name(p, g.some.name); }
}

fun extended(p: *Printer, t: Type, e: types.Extension) {
    ty(p, t);
    if (sel e.sext) { text(p, " sext"); }
    if (sel e.zext) { text(p, " zext"); }
}

# write a signature's results: nothing for none, one bare, several in parentheses
pub fun results(p: *Printer, f: types.Function) {
    if (f.results.size == 0) { ret; }
    byte(p, ' ');
    if (f.results.size > 1) { byte(p, '('); }
    var i: usize = 0;
    for (i < f.results.size) {
        if (i > 0) { text(p, ", "); }
        extended(p, f.results.data[i], types.extension(f.result_ext, i));
        i = i + 1;
    }
    if (f.results.size > 1) { byte(p, ')'); }
}

# write a parameter of a signature: its type and its extension
pub fun parameter(p: *Printer, f: types.Function, i: usize) {
    extended(p, f.params.data[i], types.extension(f.param_ext, i));
}

# write the name of a type
pub fun ty(p: *Printer, t: Type) {
    if (named(p, t)) {
        bytes(p, names.printed(?p.types, t.index));
        ret;
    }
    val got: opt[types.Shape] = from_types[types.Shape](p, types.shape(?p.m.types, t));
    if (sel got.none) { ret; }
    val s: types.Shape = got.some;
    if (sel s.integer) {
        byte(p, 'i');
        number(p, s.integer.width::u64);
    }
    or (sel s.float) {
        val r: opt[types.Row] = types.row(s.float.format);
        if (sel r.some) { text(p, r.some.word); }
        or              { fail(p, Error.types{types.Error.format{s.float.format}}); }
    }
    or (sel s.pointer) {
        text(p, "ptr");
        if (s.pointer.space != 0) {
            byte(p, '[');
            number(p, s.pointer.space::u64);
            byte(p, ']');
        }
    }
    or (sel s.vector) {
        text(p, "vec[");
        number(p, s.vector.lanes::u64);
        text(p, ", ");
        ty(p, s.vector.element);
        byte(p, ']');
    }
    or (sel s.array) {
        byte(p, '[');
        number(p, s.array.count);
        if (sel s.array.stride.some) {
            text(p, ", stride ");
            number(p, s.array.stride.some);
        }
        byte(p, ']');
        ty(p, s.array.element);
    }
    or (sel s.function) {
        text(p, "fun");
        if (s.function.convention.len != 0) {
            byte(p, '[');
            name(p, s.function.convention);
            byte(p, ']');
        }
        byte(p, '(');
        var i: usize = 0;
        for (i < s.function.params.size) {
            if (i > 0) { text(p, ", "); }
            parameter(p, s.function, i);
            i = i + 1;
        }
        byte(p, ')');
        results(p, s.function);
    }
    or (sel s.handle) {
        text(p, "handle[");
        name(p, s.handle.kind);
        var i: usize = 0;
        for (i < s.handle.operands.size) {
            val o: types.HandleOperand = s.handle.operands.data[i];
            text(p, ", ");
            if (sel o.word)  { number(p, o.word::u64); }
            if (sel o.typed) { ty(p, o.typed); }
            i = i + 1;
        }
        byte(p, ']');
    }
    or (sel s.structure) { anonymous(p, "rec", s.structure.members, s.structure.offsets); }
    or (sel s.union)     { anonymous(p, "uni", s.union.members, opt[Slice[u64]].none{}); }
    or                   { fail(p, Error.types{types.Error.unknown{t}}); }
}

# write a structure or union no typedef names, as a printer that named none
# writes one in a diagnostic
fun anonymous(p: *Printer, word: str, list: Slice[Type], offsets: opt[Slice[u64]]) {
    text(p, word);
    text(p, " {");
    var i: usize = 0;
    for (i < list.size) {
        text(p, " _");
        number(p, i::u64);
        text(p, ": ");
        ty(p, list.data[i]);
        if (sel offsets.some) {
            text(p, " at ");
            number(p, offsets.some.data[i]);
        }
        byte(p, ';');
        i = i + 1;
    }
    text(p, " }");
}

# whether a type is `ptr`, the pointer of address space 0, which an address
# literal has when nothing states another
pub fun plain_pointer(p: *Printer, t: Type) bool {
    val got: res[types.Shape, types.Error] = types.shape(?p.m.types, t);
    if (sel got.err) { ret false; }
    val s: types.Shape = got.ok;
    ret sel s.pointer && s.pointer.space == 0;
}

# write the bits of an integer of a width: in decimal when its value fits in
# 64 bits, negative when the top bit of a width above one is set, and in hex
# otherwise
fun integer(p: *Printer, words: Slice[u64], width: u32) {
    var low:  u64   = 0;
    var high: bool  = false;
    var i:    usize = 1;
    if (words.size > 0) { low = words.data[0]; }
    for (i < words.size) {
        if (words.data[i] != 0) { high = true; }
        i = i + 1;
    }
    if (width > 1 && words.size > 0) {
        val top: usize = ((width - 1) / 64)::usize;
        val bit: u64   = 1::u64 << ((width - 1) % 64)::u64;
        if (top < words.size && (words.data[top] & bit) != 0) {
            # the magnitude is the two's complement over the width, written
            # when it fits in 64 bits
            var fits: bool  = true;
            var k:    usize = 1;
            for (k < words.size) {
                var full: u64 = 0xffff_ffff_ffff_ffff;
                if (k == words.size - 1 && width % 64 != 0) { full = (1::u64 << (width % 64)::u64) - 1; }
                if (words.data[k] != full)                  { fits = false; }
                k = k + 1;
            }
            var mask: u64 = 0xffff_ffff_ffff_ffff;
            if (width < 64)                         { mask = (1::u64 << width::u64) - 1; }
            if (fits && words.size > 1 && low == 0) { fits = false; }
            if (fits) {
                byte(p, '-');
                number(p, ((~low) & mask) + 1);
                ret;
            }
            wide(p, words);
            ret;
        }
    }
    if (high) {
        wide(p, words);
        ret;
    }
    number(p, low);
}

fun width_of(p: *Printer, t: Type) u32 {
    val w: opt[u32] = from_types[u32](p, types.width(?p.m.types, t));
    if (sel w.none) { ret 0; }
    ret w.some;
}

# the element type of an aggregate's member at a position
fun element_type(p: *Printer, agg: Type, i: usize) opt[Type] {
    val got: opt[types.Shape] = from_types[types.Shape](p, types.shape(?p.m.types, agg));
    if (sel got.none) { ret opt[Type].none{}; }
    val s: types.Shape = got.some;
    if (sel s.structure) {
        if (i < s.structure.members.size) { ret opt[Type].some{s.structure.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.union) {
        if (i < s.union.members.size) { ret opt[Type].some{s.union.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.array)  { ret opt[Type].some{s.array.element}; }
    if (sel s.vector) { ret opt[Type].some{s.vector.element}; }
    ret opt[Type].none{};
}

fun given(implied: opt[Type], t: Type) bool {
    ret sel implied.some && types.same(implied.some, t);
}

fun ascribe(p: *Printer, t: Type) {
    text(p, "::");
    ty(p, t);
}

# the type a constant has
pub fun constant_type(p: *Printer, c: Constant) opt[Type] {
    val got: opt[ConstantData] = from_ir[ConstantData](p, module.constant_data(p.m, c));
    if (sel got.none) { ret opt[Type].none{}; }
    val d: ConstantData = got.some;
    if (sel d.integer)   { ret opt[Type].some{d.integer.type}; }
    if (sel d.float)     { ret opt[Type].some{d.float.type}; }
    if (sel d.zero)      { ret opt[Type].some{d.zero}; }
    if (sel d.aggregate) { ret opt[Type].some{d.aggregate.type}; }
    if (sel d.address)   { ret opt[Type].some{d.address.type}; }
    if (sel d.spec)      { ret opt[Type].some{d.spec.default.type}; }
    ret opt[Type].none{};
}

# write a constant as a literal, stating its type with `::`, or before its
# braces for an aggregate, unless its place gives it that type
# ---
# p:       the printer
# c:       the constant
# implied: the type the place it stands in gives it, none where it gives none
pub fun literal(p: *Printer, c: Constant, implied: opt[Type]) {
    val got: opt[ConstantData] = from_ir[ConstantData](p, module.constant_data(p.m, c));
    if (sel got.none) { ret; }
    val d: ConstantData = got.some;
    if (sel d.integer) {
        integer(p, d.integer.words, width_of(p, d.integer.type));
        if (!given(implied, d.integer.type)) { ascribe(p, d.integer.type); }
    }
    or (sel d.float) {
        wide(p, d.float.words);
        if (!given(implied, d.float.type)) { ascribe(p, d.float.type); }
    }
    or (sel d.zero) {
        text(p, "zero");
        if (!given(implied, d.zero)) { ascribe(p, d.zero); }
    }
    or (sel d.aggregate) {
        if (!given(implied, d.aggregate.type)) { ty(p, d.aggregate.type); }
        byte(p, '{');
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            if (i > 0) { text(p, ", "); }
            literal(p, d.aggregate.elements.data[i], element_type(p, d.aggregate.type, i));
            i = i + 1;
        }
        byte(p, '}');
    }
    or (sel d.spec) {
        text(p, "spec(");
        number(p, d.spec.id::u64);
        text(p, ", ");
        val shape: opt[types.Shape] = from_types[types.Shape](p, types.shape(?p.m.types, d.spec.default.type));
        if (sel shape.none) { ret; }
        val sh: types.Shape = shape.some;
        if (sel sh.integer) { integer(p, d.spec.default.words, sh.integer.width); }
        or                  { wide(p, d.spec.default.words); }
        byte(p, ')');
        if (!given(implied, d.spec.default.type)) { ascribe(p, d.spec.default.type); }
    }
    or (sel d.address) {
        byte(p, '?');
        symbol(p, d.address.symbol);
        val off: i64 = d.address.offset;
        if (off > 0) {
            text(p, " + ");
            number(p, off::u64);
        }
        or (off < 0) {
            text(p, " - ");
            number(p, ~(off::u64) + 1);
        }
        var stated: bool = true;
        if (sel implied.some) { stated = !types.same(implied.some, d.address.type); }
        or                    { stated = !plain_pointer(p, d.address.type); }
        if (stated)           { ascribe(p, d.address.type); }
    }
}

# write every typedef: each structure or union, its members and their offsets
pub fun typedefs(p: *Printer) {
    var i:     usize = 0;
    var wrote: bool  = false;
    for (i < p.members.len && ok(p)) {
        val t: Type = Type{index: i::u32};
        if (named(p, t)) {
            val got: opt[types.Shape] = from_types[types.Shape](p, types.shape(?p.m.types, t));
            if (sel got.none) { ret; }
            val s:       types.Shape     = got.some;
            var list:    Slice[Type]     = Slice[Type]{data: nil, size: 0};
            var offsets: opt[Slice[u64]] = opt[Slice[u64]].none{};
            anchor(p, notes.at(notes.TYPEDEF, t.index, 0), "");
            if (sel s.structure) {
                text(p, "rec ");
                list    = s.structure.members;
                offsets = s.structure.offsets;
            }
            or (sel s.union) {
                text(p, "uni ");
                list = s.union.members;
            }
            bytes(p, names.printed(?p.types, t.index));
            text(p, " {");
            var spread: bool  = noted(p, notes.at(notes.TYPEDEF_END, t.index, 0));
            var k:      usize = 0;
            for (k < list.size) {
                spread = spread || noted(p, notes.at(notes.MEMBER, t.index, k::u32));
                k      = k + 1;
            }
            if (spread) { newline(p); }
            k = 0;
            for (k < list.size) {
                if (spread) {
                    anchor(p, notes.at(notes.MEMBER, t.index, k::u32), "    ");
                    text(p, "    ");
                }
                or { byte(p, ' '); }
                val n: opt[View] = member_name(p, t, k::u32);
                if (sel n.some) { bytes(p, n.some); }
                text(p, ": ");
                ty(p, list.data[k]);
                if (sel offsets.some) {
                    text(p, " at ");
                    number(p, offsets.some.data[k]);
                }
                byte(p, ';');
                if (spread) { newline(p); }
                k = k + 1;
            }
            if (spread) {
                anchor(p, notes.at(notes.TYPEDEF_END, t.index, 0), "    ");
                byte(p, '}');
            }
            or { text(p, " }"); }
            newline(p);
            wrote = true;
        }
        i = i + 1;
    }
    if (wrote) {
        newline(p);
        p.blank = true;
    }
}

# start a block of lines that stands apart, a blank line before it unless one
# was just written
pub fun apart(p: *Printer) {
    if (!p.blank) { newline(p); }
    p.blank = false;
}

# note a line written that is not blank
pub fun written(p: *Printer) {
    p.blank = false;
}
