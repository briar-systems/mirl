# structural equality of two modules, up to the naming and ordering that
# carry no meaning
#
# order-insensitive, so two modules built in different orders compare equal:
#   - the order of functions and of globals, each paired with the one of the
#     same symbol name in the other module, which names one symbol at most
#   - the order of a symbol's attributes, compared as a multiset
#   - type ids: a type is compared by its structure, and an interned type
#     nothing names is not compared
#   - constant ids, their order and repetition: a constant is compared by what
#     it is, an address by the symbol it is paired with
#   - the names of values and blocks, which carry no meaning
#   - value, instruction and block ids, the order blocks were made in and the
#     order of a block's predecessors and of a value's uses, which follow from
#     the edges and operands
#   - debug table ids and order: a file, location, site or variable is
#     compared by what it holds wherever it is named, one nothing names is not
#     compared, and the debug types are compared as a set keyed by their keys
#   - which binding list ids instructions share, each list compared by its
#     bindings in order
#
# order-sensitive:
#   - the instructions of a block, in order, and its value binding records in
#     order, each at the same position among the instructions
#   - the entry block, which pairs with the entry block. every other block
#     pairs with the block the same edge reaches, the edges of paired
#     instructions taken in order from the entry, and blocks no edge reaches
#     pair in the order they stand in their bodies
#   - a block's parameters, an instruction's operands, immediates, edges, edge
#     arguments and results, and aggregate elements, structure members and
#     signature lists, each in order
#
# only instructions placed in a block are compared, since a detached or
# erased one is in no block and is not part of what the function does. an
# erased block is not compared either: it has no edge into it and no
# instruction, and its parameters are removed.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.assembly;
use mirl.ir.assembly.Assembly;
use AsmOperand: mirl.ir.assembly.Operand;
use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.constant.ConstantData;
use ir_debug: mirl.ir.debug;
use dtable:   mirl.ir.debug.table;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Secrecy;
use mirl.ir.global.Section;
use mirl.ir.global.Tls;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.language;
use mirl.ir.language.Language;
use mirl.ir.linkage;
use mirl.ir.metadata.Metadata;
use mirl.ir.metadata.same_flags;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.native.Op;
use mirl.ir.opcode;
use mirl.ir.place;
use mirl.ir.place.Named;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.point.Run;
use mirl.ir.point.Step;
use mirl.ir.text.printer.Error;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.ValueData;

val UNPAIRED: u32 = 0xffffffff;

# a one to one pairing of the ids of a and the ids of b
# ---
# ab: the id of b each id of a is paired with, UNPAIRED until it is
# ba: the id of a each id of b is paired with
rec Pairing {
    ab: vector.Vector[u32];
    ba: vector.Vector[u32];
}

# one comparison
# ---
# a, b:      the modules
# failed: the first read or allocation refused, none while all succeeded
# values: the values of the functions being compared
# blocks: the blocks of the functions being compared
# queue:  blocks of a paired and not yet compared
# head:   the first of `queue` not yet compared
rec Compare {
    a:      *Module;
    b:      *Module;
    failed: opt[Error];
    values: Pairing;
    blocks: Pairing;
    queue:  vector.Vector[u32];
    head:   usize;
}

# whether two modules are the same module
# ---
# a, b: the modules
# ret: whether they are equal, or the first read or allocation refused
pub fun same(a: *Module, b: *Module) res[bool, Error] {
    var c: Compare;
    c.a      = a;
    c.b      = b;
    c.failed = opt[Error].none{};
    c.values = pairing(a.a);
    c.blocks = pairing(a.a);
    c.queue  = vector.init[u32](a.a);
    c.head   = 0;
    fin {
        release(?c.values);
        release(?c.blocks);
        vector.dnit[u32](?c.queue);
    }
    val equal:  bool       = modules(?c);
    val failed: opt[Error] = c.failed;
    if (sel failed.some) { ret res[bool, Error].err{failed.some}; }
    ret res[bool, Error].ok{equal};
}

fun pairing(a: *allocator.Allocator) Pairing {
    ret Pairing{ab: vector.init[u32](a), ba: vector.init[u32](a)};
}

fun release(p: *Pairing) {
    vector.dnit[u32](?p.ab);
    vector.dnit[u32](?p.ba);
}

fun fail(c: *Compare, e: Error) bool {
    val first: bool = sel c.failed.none;
    if (first) { c.failed = opt[Error].some{e}; }
    ret false;
}

fun fill(c: *Compare, v: *vector.Vector[u32], n: usize) bool {
    vector.clear[u32](v);
    val room: res[usize, allocator.Error] = vector.reserve[u32](v, n);
    if (sel room.err) { ret fail(c, Error.alloc{room.err}); }
    var i: usize = 0;
    for (i < n) {
        vector.push[u32](v, UNPAIRED);
        i = i + 1;
    }
    ret true;
}

# start a pairing of na ids of a with nb ids of b
fun reset(c: *Compare, p: *Pairing, na: usize, nb: usize) bool {
    ret fill(c, ?p.ab, na) && fill(c, ?p.ba, nb);
}

# pair x with y when neither is paired, or confirm they are paired together
fun pair(p: *Pairing, x: u32, y: u32) bool {
    if (x::usize >= p.ab.len || y::usize >= p.ba.len) { ret false; }
    if (p.ab.data[x] == UNPAIRED && p.ba.data[y] == UNPAIRED) {
        p.ab.data[x] = y;
        p.ba.data[y] = x;
        ret true;
    }
    ret p.ab.data[x] == y;
}

fun paired(p: *Pairing, x: u32, y: u32) bool {
    ret x::usize < p.ab.len && p.ab.data[x] == y;
}

fun same_language(a: opt[*Language], b: opt[*Language]) bool {
    if (sel a.none) { ret sel b.none; }
    if (sel b.none) { ret false; }
    ret language.same(a.some, b.some);
}

fun modules(c: *Compare) bool {
    if (!module.same_target(module.target(c.a), module.target(c.b))) { ret false; }
    if (!same_language(module.language(c.a), module.language(c.b)))  { ret false; }
    if (c.a.functions.len != c.b.functions.len)                      { ret false; }
    if (c.a.globals.len != c.b.globals.len)                          { ret false; }

    var i: usize = 0;
    for (i < c.a.globals.len) {
        val found: opt[Symbol] = module.find(c.b, c.a.globals.data[i].data.name);
        if (sel found.none) { ret false; }
        val y: Symbol = found.some;
        if (!(sel y.global))                             { ret false; }
        if (!global(c, Global{index: i::u32}, y.global)) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < c.a.functions.len) {
        val found: opt[Symbol] = module.find(c.b, c.a.functions.data[i].data.name);
        if (sel found.none) { ret false; }
        val y: Symbol = found.some;
        if (!(sel y.function))                                 { ret false; }
        if (!function(c, Function{index: i::u32}, y.function)) { ret false; }
        i = i + 1;
    }
    ret debug_types(c);
}

fun symbol_name(m: *Module, s: Symbol) View {
    if (sel s.function) { ret m.functions.data[s.function.index].data.name; }
    ret m.globals.data[s.global.index].data.name;
}

# whether symbol x of a and symbol y of b are of one kind and one name
fun same_symbol(c: *Compare, x: Symbol, y: Symbol) bool {
    if (sel x.function != sel y.function) { ret false; }
    ret slice.same_view(symbol_name(c.a, x), symbol_name(c.b, y));
}

fun same_words(x: Slice[u64], y: Slice[u64]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (x.data[i] != y.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_cases(x: Slice[u64], y: Slice[u64]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (x.data[i] != y.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_lanes(x: Slice[u32], y: Slice[u32]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (x.data[i] != y.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun shape_of(c: *Compare, m: *Module, t: Type, out: *types.Shape) bool {
    val s: res[types.Shape, types.Error] = types.shape(?m.types, t);
    if (sel s.err) { ret fail(c, Error.types{s.err}); }
    @out = s.ok;
    ret true;
}

fun same_types(c: *Compare, x: Slice[Type], y: Slice[Type]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (!same_type(c, x.data[i], y.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether type x of a is type y of b, by structure
fun same_type(c: *Compare, x: Type, y: Type) bool {
    var sx: types.Shape;
    var sy: types.Shape;
    if (!shape_of(c, c.a, x, ?sx) || !shape_of(c, c.b, y, ?sy)) { ret false; }
    if (sel sx.integer)                                         { ret sel sy.integer && sy.integer.width == sx.integer.width; }
    if (sel sx.float)                                           { ret sel sy.float && sy.float.format.index == sx.float.format.index; }
    if (sel sx.pointer)                                         { ret sel sy.pointer && sy.pointer.space == sx.pointer.space; }
    if (sel sx.vector) {
        if (!(sel sy.vector)) { ret false; }
        ret sx.vector.lanes == sy.vector.lanes && same_type(c, sx.vector.element, sy.vector.element);
    }
    if (sel sx.array) {
        if (!(sel sy.array)) { ret false; }
        ret sx.array.count == sy.array.count && types.same_stride(sx.array.stride, sy.array.stride) && same_type(c, sx.array.element, sy.array.element);
    }
    if (sel sx.structure) {
        if (!(sel sy.structure)) { ret false; }
        val ox: opt[Slice[u64]] = sx.structure.offsets;
        val oy: opt[Slice[u64]] = sy.structure.offsets;
        if (sel ox.some != sel oy.some) { ret false; }
        if (sel ox.some) {
            if (sel oy.some) {
                if (!same_words(ox.some, oy.some)) { ret false; }
            }
        }
        ret same_types(c, sx.structure.members, sy.structure.members);
    }
    if (sel sx.union) {
        if (!(sel sy.union)) { ret false; }
        ret same_types(c, sx.union.members, sy.union.members);
    }
    if (sel sx.function) {
        if (!(sel sy.function)) { ret false; }
        ret same_types(c, sx.function.params, sy.function.params) && same_types(c, sx.function.results, sy.function.results)
            && types.same_extensions(sx.function.params, sx.function.param_ext, sy.function.param_ext)
            && types.same_extensions(sx.function.results, sx.function.result_ext, sy.function.result_ext);
    }
    if (sel sx.handle) {
        if (!(sel sy.handle))                                 { ret false; }
        if (!slice.same_view(sx.handle.kind, sy.handle.kind)) { ret false; }
        ret same_operands(c, sx.handle.operands, sy.handle.operands);
    }
    ret false;
}

# whether two handles' operands are the same words and the same types, in order
fun same_operands(c: *Compare, x: Slice[types.HandleOperand], y: Slice[types.HandleOperand]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        val a: types.HandleOperand = x.data[i];
        val b: types.HandleOperand = y.data[i];
        if (sel a.word) {
            if (!(sel b.word))    { ret false; }
            if (a.word != b.word) { ret false; }
        }
        if (sel a.typed) {
            if (!(sel b.typed))                  { ret false; }
            if (!same_type(c, a.typed, b.typed)) { ret false; }
        }
        i = i + 1;
    }
    ret true;
}

fun constant_of(c: *Compare, m: *Module, k: Constant, out: *ConstantData) bool {
    val d: res[ConstantData, module.Error] = module.constant_data(m, k);
    if (sel d.err) { ret fail(c, Error.ir{d.err}); }
    @out = d.ok;
    ret true;
}

# whether constant x of a is constant y of b, by what each is
fun same_constant(c: *Compare, x: Constant, y: Constant) bool {
    var dx: ConstantData;
    var dy: ConstantData;
    if (!constant_of(c, c.a, x, ?dx) || !constant_of(c, c.b, y, ?dy)) { ret false; }
    if (sel dx.integer) {
        if (!(sel dy.integer)) { ret false; }
        ret same_type(c, dx.integer.type, dy.integer.type) && same_words(dx.integer.words, dy.integer.words);
    }
    if (sel dx.float) {
        if (!(sel dy.float)) { ret false; }
        ret same_type(c, dx.float.type, dy.float.type) && same_words(dx.float.words, dy.float.words);
    }
    if (sel dx.zero) {
        if (!(sel dy.zero)) { ret false; }
        ret same_type(c, dx.zero, dy.zero);
    }
    if (sel dx.aggregate) {
        if (!(sel dy.aggregate)) { ret false; }
        val ex: Slice[Constant] = dx.aggregate.elements;
        val ey: Slice[Constant] = dy.aggregate.elements;
        if (ex.size != ey.size || !same_type(c, dx.aggregate.type, dy.aggregate.type)) { ret false; }
        var i: usize = 0;
        for (i < ex.size) {
            if (!same_constant(c, ex.data[i], ey.data[i])) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel dx.spec) {
        if (!(sel dy.spec))           { ret false; }
        if (dx.spec.id != dy.spec.id) { ret false; }
        ret same_type(c, dx.spec.default.type, dy.spec.default.type) && same_words(dx.spec.default.words, dy.spec.default.words);
    }
    if (sel dx.address) {
        if (!(sel dy.address))                      { ret false; }
        if (dx.address.offset != dy.address.offset) { ret false; }
        ret same_type(c, dx.address.type, dy.address.type) && same_symbol(c, dx.address.symbol, dy.address.symbol);
    }
    ret false;
}

fun same_attribute(x: Attribute, y: Attribute) bool {
    if (!slice.same_view(x.family, y.family) || !slice.same_view(x.name, y.name)) { ret false; }
    if (sel x.datum.integer)                                                      { ret sel y.datum.integer && y.datum.integer == x.datum.integer; }
    if (sel x.datum.integers)                                                     { ret sel y.datum.integers && same_words(x.datum.integers, y.datum.integers); }
    if (sel x.datum.text)                                                         { ret sel y.datum.text && slice.same_view(x.datum.text, y.datum.text); }
    ret false;
}

fun count(list: Slice[Attribute], at: Attribute) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < list.size) {
        if (same_attribute(list.data[i], at)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# whether two symbols carry the same attributes, in any order
fun attributes(c: *Compare, x: Symbol, y: Symbol) bool {
    val la: res[Slice[Attribute], module.Error] = module.attributes(c.a, x);
    if (sel la.err) { ret fail(c, Error.ir{la.err}); }
    val lb: res[Slice[Attribute], module.Error] = module.attributes(c.b, y);
    if (sel lb.err)               { ret fail(c, Error.ir{lb.err}); }
    if (la.ok.size != lb.ok.size) { ret false; }
    var i: usize = 0;
    for (i < la.ok.size) {
        if (count(la.ok, la.ok.data[i]) != count(lb.ok, la.ok.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun tls_rank(t: Tls) u8 {
    if (sel t.general_dynamic) { ret 0; }
    if (sel t.local_dynamic)   { ret 1; }
    if (sel t.initial_exec)    { ret 2; }
    ret 3;
}

# whether two globals state the same secret bytes, a range list compared in order as the module holds one canonical
fun same_secrecy(x: Secrecy, y: Secrecy) bool {
    if (sel x.public) { ret sel y.public; }
    if (sel x.whole)  { ret sel y.whole; }
    if (sel x.ranges) {
        if (sel y.ranges) {
            if (x.ranges.size != y.ranges.size) { ret false; }
            var i: usize = 0;
            for (i < x.ranges.size) {
                if (x.ranges.data[i].offset != y.ranges.data[i].offset) { ret false; }
                if (x.ranges.data[i].length != y.ranges.data[i].length) { ret false; }
                i = i + 1;
            }
            ret true;
        }
    }
    ret false;
}

# whether two symbols state the same alignment and the same section, or neither
fun same_placement(ax: opt[u64], sx: opt[Section], ay: opt[u64], sy: opt[Section]) bool {
    if (sel ax.some != sel ay.some) { ret false; }
    if (sel ax.some) {
        if (sel ay.some) {
            if (ax.some != ay.some) { ret false; }
        }
    }
    if (sel sx.some != sel sy.some) { ret false; }
    if (sel sx.some) {
        if (sel sy.some) {
            if (!slice.same_view(sx.some.name, sy.some.name)) { ret false; }
            if (sx.some.kind != sy.some.kind)                 { ret false; }
        }
    }
    ret true;
}

fun global(c: *Compare, x: Global, y: Global) bool {
    val dx: GlobalData = c.a.globals.data[x.index].data;
    val dy: GlobalData = c.b.globals.data[y.index].data;
    if (!linkage.same(dx.linkage, dy.linkage))      { ret false; }
    if (dx.constant != dy.constant)                 { ret false; }
    if (!same_type(c, dx.type, dy.type))            { ret false; }
    if (sel dx.initial.some != sel dy.initial.some) { ret false; }
    if (sel dx.initial.some) {
        if (sel dy.initial.some) {
            if (!same_constant(c, dx.initial.some, dy.initial.some)) { ret false; }
        }
    }
    if (!same_placement(dx.alignment, dx.section, dy.alignment, dy.section)) { ret false; }
    if (sel dx.tls.some != sel dy.tls.some)                                  { ret false; }
    if (sel dx.tls.some) {
        if (sel dy.tls.some) {
            if (tls_rank(dx.tls.some) != tls_rank(dy.tls.some)) { ret false; }
        }
    }
    if (!same_secrecy(dx.secret, dy.secret))    { ret false; }
    if (sel dx.debug.some != sel dy.debug.some) { ret false; }
    if (sel dx.debug.some) {
        if (sel dy.debug.some) {
            if (!same_variable(c, dx.debug.some, dy.debug.some)) { ret false; }
        }
    }
    ret attributes(c, Symbol.global{x}, Symbol.global{y});
}

# whether two lists of names hold the same names in the same order
fun same_views(a: Slice[View], b: Slice[View]) bool {
    if (a.size != b.size) { ret false; }
    var i: usize = 0;
    for (i < a.size) {
        if (!slice.same_view(a.data[i], b.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun function(c: *Compare, x: Function, y: Function) bool {
    if (!same_type(c, c.a.functions.data[x.index].data.signature, c.b.functions.data[y.index].data.signature)) { ret false; }
    if (!linkage.same(c.a.functions.data[x.index].data.linkage, c.b.functions.data[y.index].data.linkage))     { ret false; }
    if (c.a.functions.data[x.index].data.constant_time != c.b.functions.data[y.index].data.constant_time)      { ret false; }
    if (!same_views(c.a.functions.data[x.index].data.extensions, c.b.functions.data[y.index].data.extensions)) { ret false; }
    val dx: FunctionData = c.a.functions.data[x.index].data;
    val dy: FunctionData = c.b.functions.data[y.index].data;
    if (!same_placement(dx.alignment, dx.section, dy.alignment, dy.section))               { ret false; }
    if (!attributes(c, Symbol.function{x}, Symbol.function{y}))                            { ret false; }
    if (!same_entry(?c.a.functions.data[x.index].body, ?c.b.functions.data[y.index].body)) { ret false; }
    ret bodies(c, x, y);
}

# pair block x of a with block y of b, queueing x the first time
fun pair_block(c: *Compare, x: Block, y: Block) bool {
    if (x.index::usize >= c.blocks.ab.len || y.index::usize >= c.blocks.ba.len) { ret false; }
    val fresh: bool = c.blocks.ab.data[x.index] == UNPAIRED;
    if (!pair(?c.blocks, x.index, y.index)) { ret false; }
    if (fresh) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?c.queue, x.index);
        if (sel pushed.err) { ret fail(c, Error.alloc{pushed.err}); }
    }
    ret true;
}

# pair value x of function fa with value y of function fb, a constant's value
# by the constant and any other by its id
fun pair_value(c: *Compare, fa: Function, fb: Function, x: Value, y: Value) bool {
    val dx: res[ValueData, module.Error] = body.value_data(c.a, fa, x);
    if (sel dx.err) { ret fail(c, Error.ir{dx.err}); }
    val dy: res[ValueData, module.Error] = body.value_data(c.b, fb, y);
    if (sel dy.err) { ret fail(c, Error.ir{dy.err}); }
    if (sel dx.ok.def.constant) {
        if (!(sel dy.ok.def.constant)) { ret false; }
        ret same_constant(c, dx.ok.def.constant, dy.ok.def.constant);
    }
    if (sel dy.ok.def.constant)              { ret false; }
    if (paired(?c.values, x.index, y.index)) { ret true; }
    if (!pair(?c.values, x.index, y.index))  { ret false; }
    ret dx.ok.secret == dy.ok.secret && same_type(c, dx.ok.type, dy.ok.type);
}

fun pair_values(c: *Compare, fa: Function, fb: Function, x: *vector.Vector[Value], y: *vector.Vector[Value]) bool {
    if (x.len != y.len) { ret false; }
    var i: usize = 0;
    for (i < x.len) {
        if (!pair_value(c, fa, fb, x.data[i], y.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the number of blocks of a body not erased
fun live(b: *Body) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < b.blocks.len) {
        if (!b.blocks.data[i].erased) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun bodies(c: *Compare, fa: Function, fb: Function) bool {
    val ba: res[*Body, module.Error] = module.body(c.a, fa);
    if (sel ba.err) { ret fail(c, Error.ir{ba.err}); }
    val bb: res[*Body, module.Error] = module.body(c.b, fb);
    if (sel bb.err)                                               { ret fail(c, Error.ir{bb.err}); }
    if (live(ba.ok) != live(bb.ok))                               { ret false; }
    if (ba.ok.blocks.len == 0)                                    { ret true; }
    if (!reset(c, ?c.values, ba.ok.values.len, bb.ok.values.len)) { ret false; }
    if (!reset(c, ?c.blocks, ba.ok.blocks.len, bb.ok.blocks.len)) { ret false; }
    vector.clear[u32](?c.queue);
    c.head = 0;
    if (!pair_block(c, Block{index: 0}, Block{index: 0})) { ret false; }

    var ua: usize = 0;
    var ub: usize = 0;
    for {
        for (c.head < c.queue.len) {
            val x: u32 = c.queue.data[c.head];
            c.head = c.head + 1;
            if (!block(c, fa, fb, Block{index: x}, Block{index: c.blocks.ab.data[x]})) { ret false; }
        }
        # blocks no edge reaches pair in the order they stand
        for (ua < c.blocks.ab.len && (c.blocks.ab.data[ua] != UNPAIRED || ba.ok.blocks.data[ua].erased)) { ua = ua + 1; }
        for (ub < c.blocks.ba.len && (c.blocks.ba.data[ub] != UNPAIRED || bb.ok.blocks.data[ub].erased)) { ub = ub + 1; }
        if (ua == c.blocks.ab.len)                                        { ret true; }
        if (ub == c.blocks.ba.len)                                        { ret false; }
        if (!pair_block(c, Block{index: ua::u32}, Block{index: ub::u32})) { ret false; }
    }
    ret true;
}

fun block(c: *Compare, fa: Function, fb: Function, x: Block, y: Block) bool {
    val dx: res[BlockData, module.Error] = body.block_data(c.a, fa, x);
    if (sel dx.err) { ret fail(c, Error.ir{dx.err}); }
    val dy: res[BlockData, module.Error] = body.block_data(c.b, fb, y);
    if (sel dy.err) { ret fail(c, Error.ir{dy.err}); }
    var px: BlockData = dx.ok;
    var py: BlockData = dy.ok;
    if (!pair_values(c, fa, fb, ?px.parameters, ?py.parameters)) { ret false; }
    if (px.instructions.len != py.instructions.len)              { ret false; }
    var i: usize = 0;
    for (i < px.instructions.len) {
        if (!instruction(c, fa, fb, px.instructions.data[i], py.instructions.data[i])) { ret false; }
        i = i + 1;
    }
    ret points(c, fa, fb, ?px, ?py);
}

fun same_run(c: *Compare, fa: Function, fb: Function, ba: *Body, bb: *Body, x: Run, y: Run) bool {
    var rx: u32 = x.first;
    var ry: u32 = y.first;
    for (rx != 0 && ry != 0) {
        val px: Point = ba.points.data[rx - 1];
        val py: Point = bb.points.data[ry - 1];
        if (!same_variable(c, px.binding, py.binding))                            { ret false; }
        if (px.piece.offset != py.piece.offset || px.piece.size != py.piece.size) { ret false; }
        if (!same_reads(c, fa, fb, px.reads, py.reads))                           { ret false; }
        rx = px.next;
        ry = py.next;
    }
    ret rx == 0 && ry == 0;
}

fun same_step(c: *Compare, x: Step, y: Step) bool {
    if (x.kind.index != y.kind.index) { ret false; }
    val ax: point.Argument = x.argument;
    val ay: point.Argument = y.argument;
    if (sel ax.constant) { ret sel ay.constant && same_constant(c, ax.constant, ay.constant); }
    if (sel ax.to)       { ret sel ay.to && same_type(c, ax.to, ay.to); }
    ret false;
}

fun same_reads(c: *Compare, fa: Function, fb: Function, x: Reads, y: Reads) bool {
    if (sel x.unavailable) { ret sel y.unavailable; }
    if (!(sel y.operand))  { ret false; }
    if (sel x.operand) {
        if (!pair_value(c, fa, fb, x.operand.value, y.operand.value)) { ret false; }
        val sx: res[Slice[Step], module.Error] = module.steps(c.a, x.operand.expression);
        if (sel sx.err) { ret fail(c, Error.ir{sx.err}); }
        val sy: res[Slice[Step], module.Error] = module.steps(c.b, y.operand.expression);
        if (sel sy.err)               { ret fail(c, Error.ir{sy.err}); }
        if (sx.ok.size != sy.ok.size) { ret false; }
        var i: usize = 0;
        for (i < sx.ok.size) {
            if (!same_step(c, sx.ok.data[i], sy.ok.data[i])) { ret false; }
            i = i + 1;
        }
    }
    ret true;
}

# whether two blocks' records stand at the same points and bind the same
# variables to the same reads, in order
fun points(c: *Compare, fa: Function, fb: Function, px: *BlockData, py: *BlockData) bool {
    val ga: res[*Body, module.Error] = module.body(c.a, fa);
    if (sel ga.err) { ret fail(c, Error.ir{ga.err}); }
    val gb: res[*Body, module.Error] = module.body(c.b, fb);
    if (sel gb.err) { ret fail(c, Error.ir{gb.err}); }
    var i: usize = 0;
    for (i < px.instructions.len) {
        val x: Run = ga.ok.instructions.data[px.instructions.data[i].index].points;
        val y: Run = gb.ok.instructions.data[py.instructions.data[i].index].points;
        if (!same_run(c, fa, fb, ga.ok, gb.ok, x, y)) { ret false; }
        i = i + 1;
    }
    ret same_run(c, fa, fb, ga.ok, gb.ok, px.ending, py.ending);
}

fun same_immediate(c: *Compare, x: opcode.Immediate, y: opcode.Immediate) bool {
    if (sel x.ty)        { ret sel y.ty && same_type(c, x.ty, y.ty); }
    if (sel x.alignment) { ret sel y.alignment && y.alignment == x.alignment; }
    if (sel x.ordering)  { ret sel y.ordering && opcode.index(y.ordering) == opcode.index(x.ordering); }
    if (sel x.lane)      { ret sel y.lane && y.lane == x.lane; }
    if (sel x.lanes)     { ret sel y.lanes && same_lanes(x.lanes, y.lanes); }
    if (sel x.named)     { ret sel y.named && same_named(x.named, y.named); }
    if (sel x.places)    { ret sel y.places && same_places(x.places, y.places); }
    if (sel x.member)    { ret sel y.member && y.member == x.member; }
    if (sel x.cases)     { ret sel y.cases && same_cases(x.cases, y.cases); }
    if (sel x.function)  { ret sel y.function && same_symbol(c, Symbol.function{x.function}, Symbol.function{y.function}); }
    if (sel x.assembly)  { ret sel y.assembly && same_block(c, x.assembly, y.assembly); }
    if (sel x.op)        { ret sel y.op && same_op(c, x.op, y.op); }
    ret false;
}

# whether two target ops say the same: their set, their op, their result types in order and what they declare
fun same_op(c: *Compare, x: *Op, y: *Op) bool {
    if (!slice.same_view(x.set, y.set) || !slice.same_view(x.name, y.name)) { ret false; }
    if (x.reads != y.reads || x.writes != y.writes)                         { ret false; }
    ret same_types(c, x.results, y.results);
}

# whether two inline assembly blocks say the same: their text, their operands in order and what they declare
fun same_block(c: *Compare, x: *Assembly, y: *Assembly) bool {
    if (!slice.same_view(x.text, y.text) || x.reads != y.reads || x.writes != y.writes) { ret false; }
    if (x.operands.size != y.operands.size)                                             { ret false; }
    var i: usize = 0;
    for (i < x.operands.size) {
        val a: *AsmOperand = ?x.operands.data[i];
        val b: *AsmOperand = ?y.operands.data[i];
        if (!slice.same_view(a.name, b.name) || a.role != b.role)  { ret false; }
        if (!assembly.same_constraint(a.constraint, b.constraint)) { ret false; }
        if (!same_type(c, a.ty, b.ty))                             { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_named(x: Named, y: Named) bool {
    if (sel x.first) { ret sel y.first && y.first == x.first; }
    if (sel x.all)   { ret sel y.all; }
    ret sel y.unstated;
}

fun same_places(x: Slice[Placed], y: Slice[Placed]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (!place.same(x.data[i], y.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_entry(x: *Body, y: *Body) bool {
    if (sel x.entry.placed) {
        if (!(sel y.entry.placed)) { ret false; }
        ret same_places(Slice[Placed]{data: x.entry.placed.data, size: x.entry.placed.len}, Slice[Placed]{data: y.entry.placed.data, size: y.entry.placed.len});
    }
    ret sel y.entry.unplaced;
}

fun instruction(c: *Compare, fa: Function, fb: Function, x: Instruction, y: Instruction) bool {
    val gx: res[InstructionData, module.Error] = body.instruction_data(c.a, fa, x);
    if (sel gx.err) { ret fail(c, Error.ir{gx.err}); }
    val gy: res[InstructionData, module.Error] = body.instruction_data(c.b, fb, y);
    if (sel gy.err) { ret fail(c, Error.ir{gy.err}); }
    var dx: InstructionData = gx.ok;
    var dy: InstructionData = gy.ok;
    if (dx.opcode.index != dy.opcode.index)                  { ret false; }
    if (!pair_values(c, fa, fb, ?dx.operands, ?dy.operands)) { ret false; }
    if (dx.immediates.len != dy.immediates.len)              { ret false; }
    var i: usize = 0;
    for (i < dx.immediates.len) {
        if (!same_immediate(c, dx.immediates.data[i], dy.immediates.data[i])) { ret false; }
        i = i + 1;
    }
    if (dx.edges.len != dy.edges.len) { ret false; }
    i = 0;
    for (i < dx.edges.len) {
        val ex: *Edge = ?dx.edges.data[i];
        val ey: *Edge = ?dy.edges.data[i];
        if (!pair_block(c, ex.block, ey.block))                    { ret false; }
        if (!pair_values(c, fa, fb, ?ex.arguments, ?ey.arguments)) { ret false; }
        i = i + 1;
    }
    if (!pair_values(c, fa, fb, ?dx.results, ?dy.results)) { ret false; }
    ret same_metadata(c, dx.metadata, dy.metadata);
}

fun debug_of[T](c: *Compare, r: res[T, ir_debug.Error], out: *T) bool {
    if (sel r.err) { ret fail(c, Error.debug{r.err}); }
    @out = r.ok;
    ret true;
}

fun same_location(c: *Compare, x: ir_debug.Location, y: ir_debug.Location) bool {
    var px: ir_debug.Position;
    var py: ir_debug.Position;
    if (!debug_of[ir_debug.Position](c, ir_debug.position(?c.a.debug, x), ?px)) { ret false; }
    if (!debug_of[ir_debug.Position](c, ir_debug.position(?c.b.debug, y), ?py)) { ret false; }
    if (px.line != py.line || px.column != py.column)                           { ret false; }
    var fx: View;
    var fy: View;
    if (!debug_of[View](c, ir_debug.path(?c.a.debug, px.file), ?fx)) { ret false; }
    if (!debug_of[View](c, ir_debug.path(?c.b.debug, py.file), ?fy)) { ret false; }
    ret slice.same_view(fx, fy);
}

fun same_site(c: *Compare, x: ir_debug.Site, y: ir_debug.Site) bool {
    var ix: ir_debug.Inlining;
    var iy: ir_debug.Inlining;
    if (!debug_of[ir_debug.Inlining](c, ir_debug.inlining(?c.a.debug, x), ?ix))        { ret false; }
    if (!debug_of[ir_debug.Inlining](c, ir_debug.inlining(?c.b.debug, y), ?iy))        { ret false; }
    if (!slice.same_view(ix.callee, iy.callee) || !same_location(c, ix.call, iy.call)) { ret false; }
    val qx: opt[ir_debug.Site] = ix.parent;
    val qy: opt[ir_debug.Site] = iy.parent;
    if (sel qx.some != sel qy.some) { ret false; }
    if (sel qx.some) {
        if (sel qy.some) { ret same_site(c, qx.some, qy.some); }
    }
    ret true;
}

# whether debug type x of a is debug type y of b, by key
fun same_dtype(c: *Compare, x: ir_debug.Type, y: ir_debug.Type) bool {
    var kx: View;
    var ky: View;
    if (!debug_of[View](c, ir_debug.key(?c.a.debug, x), ?kx)) { ret false; }
    if (!debug_of[View](c, ir_debug.key(?c.b.debug, y), ?ky)) { ret false; }
    ret slice.same_view(kx, ky);
}

fun same_variable(c: *Compare, x: ir_debug.Binding, y: ir_debug.Binding) bool {
    var vx: ir_debug.Variable;
    var vy: ir_debug.Variable;
    if (!debug_of[ir_debug.Variable](c, ir_debug.variable(?c.a.debug, x), ?vx)) { ret false; }
    if (!debug_of[ir_debug.Variable](c, ir_debug.variable(?c.b.debug, y), ?vy)) { ret false; }
    if (!slice.same_view(vx.name, vy.name))                                     { ret false; }
    val nx: opt[u32] = vx.parameter;
    val ny: opt[u32] = vy.parameter;
    if (sel nx.some != sel ny.some) { ret false; }
    if (sel nx.some) {
        if (sel ny.some) {
            if (nx.some != ny.some) { ret false; }
        }
    }
    ret same_dtype(c, vx.type, vy.type) && same_location(c, vx.declared, vy.declared);
}

fun same_metadata(c: *Compare, x: Metadata, y: Metadata) bool {
    if (!same_flags(x.flags, y.flags) || x.secret != y.secret) { ret false; }
    if (sel x.location.some != sel y.location.some)            { ret false; }
    if (sel x.location.some) {
        if (sel y.location.some) {
            if (!same_location(c, x.location.some, y.location.some)) { ret false; }
        }
    }
    if (sel x.site.some != sel y.site.some) { ret false; }
    if (sel x.site.some) {
        if (sel y.site.some) {
            if (!same_site(c, x.site.some, y.site.some)) { ret false; }
        }
    }
    val bx: res[Slice[ir_debug.Binding], module.Error] = module.bound(c.a, x.bindings);
    if (sel bx.err) { ret fail(c, Error.ir{bx.err}); }
    val by: res[Slice[ir_debug.Binding], module.Error] = module.bound(c.b, y.bindings);
    if (sel by.err)               { ret fail(c, Error.ir{by.err}); }
    if (bx.ok.size != by.ok.size) { ret false; }
    var i: usize = 0;
    for (i < bx.ok.size) {
        if (!same_variable(c, bx.ok.data[i], by.ok.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_member(c: *Compare, x: ir_debug.Member, y: ir_debug.Member) bool {
    ret x.field == y.field && slice.same_view(x.name, y.name) && same_dtype(c, x.type, y.type);
}

fun same_members(c: *Compare, x: Slice[ir_debug.Member], y: Slice[ir_debug.Member]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (!same_member(c, x.data[i], y.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun same_dtypes(c: *Compare, x: Slice[ir_debug.Type], y: Slice[ir_debug.Type]) bool {
    if (x.size != y.size) { ret false; }
    var i: usize = 0;
    for (i < x.size) {
        if (!same_dtype(c, x.data[i], y.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun encoding_rank(e: ir_debug.Encoding) u8 {
    if (sel e.signed)    { ret 0; }
    if (sel e.unsigned)  { ret 1; }
    if (sel e.float)     { ret 2; }
    if (sel e.boolean)   { ret 3; }
    if (sel e.character) { ret 4; }
    ret 5;
}

fun kind_rank(k: ir_debug.Kind) u8 {
    if (sel k.base)        { ret 0; }
    if (sel k.structure)   { ret 1; }
    if (sel k.union)       { ret 2; }
    if (sel k.tagged)      { ret 3; }
    if (sel k.enumeration) { ret 4; }
    if (sel k.array)       { ret 5; }
    if (sel k.pointer)     { ret 6; }
    ret 7;
}

fun same_shape(c: *Compare, x: ir_debug.Shape, y: ir_debug.Shape) bool {
    if (sel x.base) {
        if (!(sel y.base)) { ret false; }
        ret x.base.width == y.base.width && encoding_rank(x.base.encoding) == encoding_rank(y.base.encoding);
    }
    if (sel x.structure) { ret sel y.structure && same_members(c, x.structure, y.structure); }
    if (sel x.union)     { ret sel y.union && same_members(c, x.union, y.union); }
    if (sel x.tagged) {
        if (!(sel y.tagged)) { ret false; }
        val tx: ir_debug.Tagged = x.tagged;
        val ty: ir_debug.Tagged = y.tagged;
        val px: opt[u32]        = tx.payload;
        val py: opt[u32]        = ty.payload;
        if (sel px.some != sel py.some) { ret false; }
        if (sel px.some) {
            if (sel py.some) {
                if (px.some != py.some) { ret false; }
            }
        }
        if (tx.cases.size != ty.cases.size)                    { ret false; }
        if (!same_member(c, tx.discriminant, ty.discriminant)) { ret false; }
        var i: usize = 0;
        for (i < tx.cases.size) {
            val cx: ir_debug.Case = tx.cases.data[i];
            val cy: ir_debug.Case = ty.cases.data[i];
            if (cx.value != cy.value || !slice.same_view(cx.name, cy.name)) { ret false; }
            val mx: opt[ir_debug.Member] = cx.payload;
            val my: opt[ir_debug.Member] = cy.payload;
            if (sel mx.some != sel my.some) { ret false; }
            if (sel mx.some) {
                if (sel my.some) {
                    if (!same_member(c, mx.some, my.some)) { ret false; }
                }
            }
            i = i + 1;
        }
        ret true;
    }
    if (sel x.enumeration) {
        if (!(sel y.enumeration)) { ret false; }
        val ex: ir_debug.Enumeration = x.enumeration;
        val ey: ir_debug.Enumeration = y.enumeration;
        if (ex.enumerators.size != ey.enumerators.size || !same_dtype(c, ex.base, ey.base)) { ret false; }
        var i: usize = 0;
        for (i < ex.enumerators.size) {
            if (ex.enumerators.data[i].value != ey.enumerators.data[i].value)               { ret false; }
            if (!slice.same_view(ex.enumerators.data[i].name, ey.enumerators.data[i].name)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel x.array) {
        if (!(sel y.array)) { ret false; }
        ret x.array.count == y.array.count && same_dtype(c, x.array.element, y.array.element);
    }
    if (sel x.pointer) { ret sel y.pointer && slice.same_view(x.pointer.pointee, y.pointer.pointee); }
    if (sel x.function) {
        if (!(sel y.function)) { ret false; }
        ret same_dtypes(c, x.function.params, y.function.params) && same_dtypes(c, x.function.results, y.function.results);
    }
    ret false;
}

# whether the debug types of a are those of b, each found by its key
fun debug_types(c: *Compare) bool {
    val ta: *ir_debug.Table = ?c.a.debug;
    val tb: *ir_debug.Table = ?c.b.debug;
    if (ta.nodes.len != tb.nodes.len) { ret false; }
    var i: usize = 0;
    for (i < ta.nodes.len) {
        val nx:    *dtable.Node       = ?ta.nodes.data[i];
        val found: opt[ir_debug.Type] = ir_debug.find(tb, nx.key);
        if (sel found.none) { ret false; }
        val ny: *dtable.Node = ?tb.nodes.data[found.some.index];
        if (nx.defined != ny.defined || !slice.same_view(nx.name, ny.name)) { ret false; }
        val lx: opt[Type] = nx.layout;
        val ly: opt[Type] = ny.layout;
        if (sel lx.some != sel ly.some) { ret false; }
        if (sel lx.some) {
            if (sel ly.some) {
                if (!same_type(c, lx.some, ly.some)) { ret false; }
            }
        }
        var kx: ir_debug.Kind;
        var ky: ir_debug.Kind;
        if (!debug_of[ir_debug.Kind](c, ir_debug.kind(ta, ir_debug.Type{index: i::u32}), ?kx)) { ret false; }
        if (!debug_of[ir_debug.Kind](c, ir_debug.kind(tb, found.some), ?ky))                   { ret false; }
        if (kind_rank(kx) != kind_rank(ky))                                                    { ret false; }
        if (nx.defined && !same_shape(c, nx.shape, ny.shape))                                  { ret false; }
        i = i + 1;
    }
    ret true;
}
