# the type a literal takes from where it stands, so the text leaves it unwritten
#
# a literal operand needs no type of its own where its instruction's row ties
# it to the type of a subject already known: an operand an `agree` rule pairs
# it with, an immediate holding a type, the parameters of the signature a call
# states, the results of the function a return is in, the lanes of a vector,
# the member a `fits` rule names and the other words of a `words` rule. the
# printer and the parser both type an instruction's literals by `settle`, so a
# literal the printer leaves untyped is one the parser types the same way.
#
# the immediates the text leaves out are decided here too: an alignment equal
# to the size of the scalar accessed, every argument named, the signature a
# direct callee states, and the case list its targets write.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Results;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Rule;
use mirl.ir.opcode.Rules;
use mirl.ir.opcode.Subject;
use types: mirl.ir.type;
use mirl.ir.type.Type;

# what is known of an instruction while its literals are typed
# ---
# m:          the module
# row:        its opcode's row
# operands:   the type of each operand in order, fixed then tail, none for a
#             literal not yet typed
# immediates: its immediates, one per slot
# returns:    the results of the function it is in
# results:    the type of each of its results, which the text states
pub rec Known {
    m:          *Module;
    row:        *Row;
    operands:   Slice[opt[Type]];
    immediates: Slice[Immediate];
    returns:    Slice[Type];
    results:    Slice[Type];
}

fun subject(k: *Known, s: Subject) opt[Type] {
    if (sel s.operand) {
        if (s.operand::usize < k.operands.size) { ret k.operands.data[s.operand]; }
        ret opt[Type].none{};
    }
    if (sel s.immediate) {
        if (s.immediate::usize >= k.immediates.size) { ret opt[Type].none{}; }
        val imm: Immediate = k.immediates.data[s.immediate];
        if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    }
    ret opt[Type].none{};
}

fun names(s: Subject, at: u32) bool {
    ret sel s.operand && s.operand == at;
}

fun shape(k: *Known, t: opt[Type]) opt[types.Shape] {
    if (sel t.none) { ret opt[types.Shape].none{}; }
    val got: res[types.Shape, types.Error] = types.shape(?k.m.types, t.some);
    if (sel got.err) { ret opt[types.Shape].none{}; }
    ret opt[types.Shape].some{got.ok};
}

fun nth(list: Slice[Type], i: u32) opt[Type] {
    if (i::usize >= list.size) { ret opt[Type].none{}; }
    ret opt[Type].some{list.data[i]};
}

# the type of the member a member immediate names of an aggregate
fun member_of(k: *Known, m: opcode.Member) opt[Type] {
    val agg: opt[types.Shape] = shape(k, subject(k, m.of));
    if (sel agg.none)                       { ret opt[Type].none{}; }
    if (m.slot::usize >= k.immediates.size) { ret opt[Type].none{}; }
    val imm: Immediate = k.immediates.data[m.slot];
    if (!(sel imm.member)) { ret opt[Type].none{}; }
    val s: types.Shape = agg.some;
    if (sel s.structure) { ret nth(s.structure.members, imm.member); }
    if (sel s.array)     { ret opt[Type].some{s.array.element}; }
    ret opt[Type].none{};
}

# the type a result the row derives the same as the operand at a position has
fun result_of(k: *Known, at: u32) opt[Type] {
    var j: usize = 0;
    for (j < $length_of(Results) && j < k.results.size) {
        val r: opcode.Result = k.row.results[j];
        if (sel r.unstated) { ret opt[Type].none{}; }
        if (sel r.same) {
            if (names(r.same, at)) { ret opt[Type].some{k.results.data[j]}; }
        }
        j = j + 1;
    }
    ret opt[Type].none{};
}

# the type the operand at a position takes from its instruction, none where
# nothing known gives it one
pub fun operand(k: *Known, at: u32) opt[Type] {
    val derived: opt[Type] = result_of(k, at);
    if (sel derived.some) { ret derived; }
    val fixed: u32   = opcode.fixed(k.row);
    var i:     usize = 0;
    for (i < $length_of(Rules) && !(sel k.row.rules[i].unstated)) {
        val r:     Rule      = k.row.rules[i];
        var found: opt[Type] = opt[Type].none{};
        if (sel r.agree) {
            if (names(r.agree.left, at))  { found = subject(k, r.agree.right); }
            or (names(r.agree.right, at)) { found = subject(k, r.agree.left); }
        }
        or (sel r.is) {
            if (names(r.is.subject, at)) {
                val c: opcode.Class = r.is.class;
                if (sel c.width) {
                    val t: res[Type, types.Error] = types.intern(?k.m.types, types.Shape.integer{types.Integer{width: c.width}});
                    if (sel t.ok) { found = opt[Type].some{t.ok}; }
                }
            }
        }
        or (sel r.parameters) {
            if (at >= fixed) {
                val sig: opt[types.Shape] = shape(k, subject(k, r.parameters));
                if (sel sig.some) {
                    val f: types.Shape = sig.some;
                    if (sel f.function) { found = nth(f.function.params, at - fixed); }
                }
            }
        }
        or (sel r.returns) {
            if (at >= fixed) { found = nth(k.returns, at - fixed); }
        }
        or (sel r.lanes_of) {
            if (at >= fixed) {
                val v: opt[types.Shape] = shape(k, subject(k, r.lanes_of));
                if (sel v.some) {
                    val s: types.Shape = v.some;
                    if (sel s.vector) { found = opt[Type].some{s.vector.element}; }
                }
            }
        }
        or (sel r.fits) {
            if (names(r.fits.subject, at)) { found = member_of(k, r.fits.member); }
        }
        or (sel r.words) {
            if (at >= fixed) {
                var j: usize = fixed::usize;
                for (j < k.operands.size && sel found.none) {
                    if (j != at::usize) { found = k.operands.data[j]; }
                    j = j + 1;
                }
            }
        }
        if (sel found.some) { ret found; }
        i = i + 1;
    }
    ret opt[Type].none{};
}

# type every literal the instruction's rows give a type to, over and over until
# no more can be typed, as the printer and the parser both do
# ---
# k:       what is known, its untyped literals typed in place as they settle
# actual:  the type each literal has, which a literal must be given to settle,
#          or none to take whatever type is given, as the parser does
# settled: set true for each literal typed here
pub fun settle(k: *Known, actual: Slice[opt[Type]], settled: *bool) {
    var moved: bool = true;
    for (moved) {
        moved = false;
        var i: usize = 0;
        for (i < k.operands.size) {
            val have: opt[Type] = k.operands.data[i];
            if (sel have.none) {
                val given: opt[Type] = operand(k, i::u32);
                if (sel given.some) {
                    var fits: bool = true;
                    if (i < actual.size) {
                        val want: opt[Type] = actual.data[i];
                        if (sel want.some) { fits = types.same(want.some, given.some); }
                    }
                    if (fits) {
                        k.operands.data[i] = given;
                        settled[i]         = true;
                        moved              = true;
                    }
                }
            }
            i = i + 1;
        }
    }
}

# the aggregate a member immediate at a slot indexes, by the row's member rule
pub fun member_aggregate(k: *Known, slot: u32) opt[Type] {
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel k.row.rules[i].unstated)) {
        val r: opcode.Rule = k.row.rules[i];
        if (sel r.member) {
            if (r.member.slot == slot) {
                val s: opcode.Subject = r.member.of;
                if (sel s.immediate) {
                    if (s.immediate::usize < k.immediates.size) {
                        val imm: Immediate = k.immediates.data[s.immediate];
                        if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
                    }
                }
                if (sel s.operand) {
                    if (s.operand::usize < k.operands.size) { ret k.operands.data[s.operand]; }
                }
            }
        }
        i = i + 1;
    }
    ret opt[Type].none{};
}

# whether a slot prints bare: the first, when it holds a type, a function, an
# assembly block or a target op
pub fun bare(h: opcode.Holds, slot: u32) bool {
    ret slot == 0 && (sel h.ty || sel h.function || sel h.assembly || sel h.op);
}

# the byte size of a type the text leaves an alignment out for: an integer, a
# float or a vector of either whose size is a power of two
pub fun natural(m: *Module, t: Type) opt[u64] {
    val got: opt[u64] = bits_of(m, t);
    if (sel got.none) { ret opt[u64].none{}; }
    var bytes: u64 = (got.some + 7) / 8;
    if (bytes == 0 || (bytes & (bytes - 1)) != 0) { ret opt[u64].none{}; }
    ret opt[u64].some{bytes};
}

fun bits_of(m: *Module, t: Type) opt[u64] {
    val got: res[types.Shape, types.Error] = types.shape(?m.types, t);
    if (sel got.err) { ret opt[u64].none{}; }
    val s: types.Shape = got.ok;
    if (sel s.integer) { ret opt[u64].some{s.integer.width::u64}; }
    if (sel s.float) {
        val r: opt[types.Row] = types.row(s.float.format);
        if (sel r.none) { ret opt[u64].none{}; }
        ret opt[u64].some{r.some.width::u64};
    }
    if (sel s.vector) {
        val e: opt[u64]                      = bits_of(m, s.vector.element);
        val l: res[types.Shape, types.Error] = types.shape(?m.types, s.vector.element);
        if (sel e.none) { ret opt[u64].none{}; }
        if (sel l.err)  { ret opt[u64].none{}; }
        val ls: types.Shape = l.ok;
        if (sel ls.vector) { ret opt[u64].none{}; }
        ret opt[u64].some{e.some * s.vector.lanes::u64};
    }
    ret opt[u64].none{};
}

# the type an instruction accesses, whose size an alignment leaves out: the
# type of its first type slot, or of its stored operand when it has none
pub fun accessed(row: *opcode.Row, immediates: Slice[Immediate], operands: Slice[opt[Type]]) opt[Type] {
    var k: u32 = 0;
    for (k < opcode.slots(row) && k::usize < immediates.size) {
        val imm: Immediate = immediates.data[k];
        if (sel row.immediates[k].holds.ty) {
            if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
        }
        k = k + 1;
    }
    var i: u32 = 0;
    for (i < opcode.fixed(row) && i::usize < operands.size) {
        if (sel row.operands[i].role.stored) { ret operands.data[i]; }
        i = i + 1;
    }
    ret opt[Type].none{};
}

# the fixed operand that is a callee, none for a row with none
pub fun callee_of(row: *opcode.Row) opt[u32] {
    var i: u32 = 0;
    for (i < opcode.fixed(row)) {
        if (sel row.operands[i].role.callee) { ret opt[u32].some{i}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether a slot holds the signature a `parameters` rule reads the arguments by
pub fun signature_slot(row: *opcode.Row, slot: u32) bool {
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel row.rules[i].unstated)) {
        val r: opcode.Rule = row.rules[i];
        if (sel r.parameters) {
            val s: opcode.Subject = r.parameters;
            if (sel s.immediate) {
                if (s.immediate == slot) { ret true; }
            }
        }
        i = i + 1;
    }
    ret false;
}
