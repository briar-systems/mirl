# printing a module: its header, globals, functions, blocks and instructions
#
# an instruction is spelled from its opcode's row alone, so a new row prints
# with no change here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.format;
use io: std.io.writer;

use mink.model.symbol;
use mirl.build;
use mirl.build.Builder;
use mirl.debug.location;
use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use ir_debug: mirl.ir.debug;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.place.Fill;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.point.Run;
use mirl.ir.point.Step;
use mirl.ir.text.debug;
use mirl.ir.text.names;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Error;
use mirl.ir.text.printer.Printer;
use mirl.ir.text.sink;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;
use mirl.slice;

use rf: masc.core.register;
use mirl.ir.linkage.Linkage;

# write the text of a module
# ---
# w:   the writer the text goes to
# m:   the module
# ret: ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    printer.header(?p);
    debug.table(?p);
    var i: usize = 0;
    for (i < m.globals.len) {
        global(?p, Global{index: i::u32});
        i = i + 1;
    }
    i = 0;
    for (i < m.functions.len) {
        function(?p, Function{index: i::u32});
        i = i + 1;
    }
    val failed: opt[Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{failed.some}; }
    ret err[Error].ok{};
}

fun same_symbol(a: Symbol, b: Symbol) bool {
    if (sel a.function) { ret sel b.function && b.function.index == a.function.index; }
    ret sel b.global && b.global.index == a.global.index;
}

fun exported(m: *Module, s: Symbol) bool {
    val list: Slice[Symbol] = module.exports(m);
    var i:    usize         = 0;
    for (i < list.size) {
        if (same_symbol(list.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun lead(p: *Printer, s: Symbol, keyword: str) {
    if (exported(p.m, s)) { printer.text(p, "export "); }
    printer.text(p, keyword);
    printer.symbol(p, s);
    printer.text(p, ": ");
}

fun attributes(p: *Printer, s: Symbol) {
    val got: opt[Slice[Attribute]] = printer.from_ir[Slice[Attribute]](p, module.attributes(p.m, s));
    if (sel got.none) { ret; }
    var i: usize = 0;
    for (i < got.some.size) {
        val at: Attribute = got.some.data[i];
        printer.text(p, "attribute ");
        printer.symbol(p, s);
        printer.byte(p, ' ');
        printer.name(p, at.family);
        printer.byte(p, ' ');
        printer.name(p, at.name);
        printer.text(p, " = ");
        if (sel at.datum.integer) { printer.number(p, at.datum.integer); }
        or (sel at.datum.integers) {
            printer.byte(p, '[');
            var k: usize = 0;
            for (k < at.datum.integers.size) {
                if (k > 0) { printer.text(p, ", "); }
                printer.number(p, at.datum.integers.data[k]);
                k = k + 1;
            }
            printer.byte(p, ']');
        }
        or (sel at.datum.text) { printer.string(p, at.datum.text); }
        printer.newline(p);
        i = i + 1;
    }
}

fun tls(p: *Printer, t: Tls) {
    if (sel t.general_dynamic) { printer.text(p, "general_dynamic"); }
    or (sel t.local_dynamic)   { printer.text(p, "local_dynamic"); }
    or (sel t.initial_exec)    { printer.text(p, "initial_exec"); }
    or (sel t.local_exec)      { printer.text(p, "local_exec"); }
}

fun linkage(p: *Printer, l: Linkage) {
    printer.text(p, " linkage ");
    printer.word(p, l.binding.name);
    printer.text(p, " visibility ");
    printer.word(p, l.visibility.name);
}

fun global(p: *Printer, g: Global) {
    val got: opt[GlobalData] = printer.from_ir[GlobalData](p, module.global_data(p.m, g));
    if (sel got.none) { ret; }
    val d: GlobalData = got.some;
    val s: Symbol     = Symbol.global{g};
    lead(p, s, "global ");
    printer.ty(p, d.type);
    linkage(p, d.linkage);
    if (d.constant) { printer.text(p, " constant"); }
    if (sel d.alignment.some) {
        printer.text(p, " align ");
        printer.number(p, d.alignment.some);
    }
    if (sel d.section.some) {
        printer.text(p, " section ");
        printer.string(p, d.section.some.name);
        printer.text(p, " ");
        printer.word(p, d.section.some.kind.name);
    }
    if (sel d.tls.some) {
        printer.text(p, " tls ");
        tls(p, d.tls.some);
    }
    if (sel d.initial.some) {
        printer.text(p, " = ");
        printer.constant(p, d.initial.some);
    }
    printer.newline(p);
    attributes(p, s);
}

fun function(p: *Printer, f: Function) {
    val got: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, f));
    if (sel got.none) { ret; }
    val s: Symbol = Symbol.function{f};
    printer.newline(p);
    lead(p, s, "function ");
    printer.ty(p, got.some.signature);
    linkage(p, got.some.linkage);
    if (got.some.constant_time) { printer.text(p, " constant_time"); }
    val held: opt[*Body] = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel held.none) { ret; }
    val b: *Body = held.some;
    if (sel b.entry.placed) {
        if (b.blocks.len > 0) {
            printer.text(p, " placed ");
            places(p, Slice[Placed]{data: b.entry.placed.data, size: b.entry.placed.len});
        }
    }
    if (b.blocks.len > 0) {
        printer.text(p, " {");
        printer.newline(p);
        start(p, f, b);
        var k: usize = 0;
        for (k < b.blocks.len) {
            if (!b.blocks.data[k].erased) { block(p, f, Block{index: k::u32}); }
            k = k + 1;
        }
        printer.byte(p, '}');
    }
    printer.newline(p);
    attributes(p, s);
}

# start naming a function's values and name its blocks, in order
fun start(p: *Printer, f: Function, b: *Body) {
    val values: err[allocator.Error] = names.reset(?p.values, b.values.len);
    if (sel values.err) {
        printer.fail(p, Error.alloc{values.err});
        ret;
    }
    val blocks: err[allocator.Error] = names.reset(?p.blocks, b.blocks.len);
    if (sel blocks.err) {
        printer.fail(p, Error.alloc{blocks.err});
        ret;
    }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val given: err[allocator.Error] = names.give(?p.blocks, k::u32, b.blocks.data[k].name);
            if (sel given.err) {
                printer.fail(p, Error.alloc{given.err});
                ret;
            }
        }
        k = k + 1;
    }
}

fun local(p: *Printer, f: Function, v: Value) {
    val got: opt[ValueData] = printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
    if (sel got.none) { ret; }
    if (!names.given(?p.values, v.index)) {
        val given: err[allocator.Error] = names.give(?p.values, v.index, got.some.name);
        if (sel given.err) {
            printer.fail(p, Error.alloc{given.err});
            ret;
        }
    }
    printer.byte(p, '%');
    printer.name(p, names.printed(?p.values, v.index));
}

fun operand(p: *Printer, f: Function, v: Value) {
    val got: opt[ValueData] = printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
    if (sel got.none) { ret; }
    val def: Def = got.some.def;
    if (sel def.constant) { printer.constant(p, def.constant); }
    or                    { local(p, f, v); }
}

fun label(p: *Printer, k: Block) {
    if (k.index::usize >= p.blocks.printed.len) {
        printer.fail(p, Error.ir{module.Error.block{k}});
        ret;
    }
    printer.byte(p, '^');
    printer.name(p, names.printed(?p.blocks, k.index));
}

fun block(p: *Printer, f: Function, k: Block) {
    val got: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, k));
    if (sel got.none) { ret; }
    val d: BlockData = got.some;
    label(p, k);
    if (d.parameters.len > 0) {
        printer.byte(p, '(');
        var i: usize = 0;
        for (i < d.parameters.len) {
            if (i > 0) { printer.text(p, ", "); }
            val v: Value = d.parameters.data[i];
            local(p, f, v);
            printer.text(p, ": ");
            val vd: opt[ValueData] = printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
            if (sel vd.some) {
                if (vd.some.secret) { printer.text(p, "secret "); }
                printer.ty(p, vd.some.type);
            }
            i = i + 1;
        }
        printer.byte(p, ')');
    }
    printer.byte(p, ':');
    printer.newline(p);
    val held: opt[*Body] = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel held.none) { ret; }
    var i: usize = 0;
    for (i < d.instructions.len) {
        val at: Instruction = d.instructions.data[i];
        records(p, f, held.some, held.some.instructions.data[at.index].points);
        instruction(p, f, at);
        i = i + 1;
    }
    records(p, f, held.some, d.ending);
}

# the records of a run, in order
fun records(p: *Printer, f: Function, b: *Body, run: Run) {
    var r: u32 = run.first;
    for (r != 0 && printer.ok(p)) {
        val pt: Point = b.points.data[r - 1];
        record(p, f, pt);
        r = pt.next;
    }
}

fun step(p: *Printer, s: Step) {
    val row: opt[point.Row] = point.row(s.kind);
    if (sel row.none) {
        printer.fail(p, Error.ir{module.Error.step{s.kind.index}});
        ret;
    }
    printer.text(p, ", ");
    printer.word(p, row.some.name);
    printer.byte(p, ' ');
    val a: point.Argument = s.argument;
    if (sel a.constant) { printer.constant(p, a.constant); }
    or (sel a.to)       { printer.ty(p, a.to); }
}

# a value binding record line
fun record(p: *Printer, f: Function, pt: Point) {
    printer.text(p, "    bind ");
    printer.variable_ref(p, pt.binding);
    val reads: Reads                          = pt.reads;
    val held:  res[opt[Value], location.Kind] = point.read(reads.location);
    if (sel held.err) {
        printer.fail(p, Error.ir{module.Error.located{held.err}});
        ret;
    }
    if (sel held.ok.some) {
        printer.text(p, " = ");
        operand(p, f, held.ok.some);
        val steps: opt[Slice[Step]] = printer.from_ir[Slice[Step]](p, module.steps(p.m, reads.expression));
        if (sel steps.some) {
            var k: usize = 0;
            for (k < steps.some.size) {
                step(p, steps.some.data[k]);
                k = k + 1;
            }
        }
    }
    or { printer.text(p, " unavailable"); }
    printer.newline(p);
}

# write the separator before the next entry of an operation
fun next_entry(p: *Printer, first: *bool) {
    if (@first) { printer.byte(p, ' '); }
    or          { printer.text(p, ", "); }
    @first = false;
}

fun ordering(p: *Printer, o: opcode.Ordering) {
    if (sel o.relaxed) { printer.text(p, "relaxed"); }
    or (sel o.acquire) { printer.text(p, "acquire"); }
    or (sel o.release) { printer.text(p, "release"); }
    or (sel o.acq_rel) { printer.text(p, "acq_rel"); }
    or (sel o.seq_cst) { printer.text(p, "seq_cst"); }
}

# write how a place is filled past its piece
fun fill(p: *Printer, f: Fill) {
    if (sel f.exact)     { printer.text(p, "exact"); }
    or (sel f.undefined) { printer.text(p, "undefined"); }
    or (sel f.sign) {
        printer.text(p, "sign ");
        printer.number(p, f.sign::u64);
    }
    or (sel f.zero) {
        printer.text(p, "zero ");
        printer.number(p, f.zero::u64);
    }
    or (sel f.boxed) { printer.text(p, "boxed"); }
    or (sel f.declared) {
        printer.text(p, "declared ");
        printer.number(p, f.declared::u64);
    }
}

# write a bracketed list of places
fun places(p: *Printer, list: Slice[Placed]) {
    printer.byte(p, '[');
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        val at: Placed = list.data[i];
        if (sel at.place.register) {
            printer.text(p, "register ");
            printer.number(p, rf.class_of(at.place.register)::u64);
            printer.byte(p, ' ');
            printer.number(p, rf.number_of(at.place.register)::u64);
        }
        or (sel at.place.stack) {
            printer.text(p, "stack ");
            printer.number(p, at.place.stack);
        }
        or (sel at.place.operand) {
            printer.text(p, "operand ");
            printer.number(p, at.place.operand::u64);
        }
        if (sel at.scale.scaled) {
            printer.text(p, " scaled ");
            printer.number(p, at.scale.scaled::u64);
        }
        or { printer.text(p, " fixed"); }
        printer.byte(p, ' ');
        fill(p, at.fill);
        i = i + 1;
    }
    printer.byte(p, ']');
}

# write what slot k holds, refusing a named count the checker refuses too
fun immediate(p: *Printer, imm: opcode.Immediate, k: u32) {
    if (sel imm.ty)        { printer.ty(p, imm.ty); }
    or (sel imm.alignment) { printer.number(p, imm.alignment); }
    or (sel imm.ordering)  { ordering(p, imm.ordering); }
    or (sel imm.lane)      { printer.number(p, imm.lane::u64); }
    or (sel imm.lanes) {
        printer.byte(p, '[');
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.number(p, imm.lanes.data[i]::u64);
            i = i + 1;
        }
        printer.byte(p, ']');
    }
    or (sel imm.named) {
        if (sel imm.named.first) { printer.number(p, imm.named.first::u64); }
        or (sel imm.named.all)   { printer.text(p, "all"); }
        or                       { printer.fail(p, Error.ir{module.Error.typing{opcode.Error.named{k}}}); }
    }
    or (sel imm.places) { places(p, imm.places); }
}

fun instruction(p: *Printer, f: Function, i: Instruction) {
    val got: opt[InstructionData] = printer.from_ir[InstructionData](p, body.instruction_data(p.m, f, i));
    if (sel got.none) { ret; }
    val d:   InstructionData = got.some;
    val row: opt[opcode.Row] = opcode.row(d.opcode);
    if (sel row.none) {
        printer.fail(p, Error.opcode{d.opcode});
        ret;
    }
    val r: opcode.Row = row.some;
    printer.text(p, "    ");
    var k: usize = 0;
    for (k < d.results.len) {
        if (k > 0) { printer.text(p, ", "); }
        local(p, f, d.results.data[k]);
        k = k + 1;
    }
    if (d.results.len > 0) { printer.text(p, " = "); }
    printer.word(p, r.name);

    var first: bool = true;
    k = 0;
    for (k < d.operands.len) {
        next_entry(p, ?first);
        operand(p, f, d.operands.data[k]);
        k = k + 1;
    }
    k = 0;
    for (k < d.immediates.len) {
        next_entry(p, ?first);
        if (k < opcode.slots(?r)::usize) { printer.word(p, r.immediates[k].name); }
        printer.byte(p, ' ');
        immediate(p, d.immediates.data[k], k::u32);
        k = k + 1;
    }
    k = 0;
    for (k < d.edges.len) {
        next_entry(p, ?first);
        val e: Edge = d.edges.data[k];
        label(p, e.block);
        if (e.arguments.len > 0) {
            printer.byte(p, '(');
            var j: usize = 0;
            for (j < e.arguments.len) {
                if (j > 0) { printer.text(p, ", "); }
                operand(p, f, e.arguments.data[j]);
                j = j + 1;
            }
            printer.byte(p, ')');
        }
        k = k + 1;
    }
    metadata(p, d.metadata);
    printer.newline(p);
}

# write the metadata record of an instruction, each part left out when empty
pub fun metadata(p: *Printer, md: Metadata) {
    if (sel md.location.some) {
        printer.text(p, " loc ");
        printer.location_ref(p, md.location.some);
    }
    if (sel md.site.some) {
        printer.text(p, " site ");
        printer.site_ref(p, md.site.some);
    }
    if (md.flags.volatile)      { printer.text(p, " volatile"); }
    if (md.flags.kept)          { printer.text(p, " kept"); }
    if (md.flags.bounded)       { printer.text(p, " bounded"); }
    if (md.flags.checked)       { printer.text(p, " checked"); }
    if (md.secret)              { printer.text(p, " secret"); }
    if (md.bindings.index == 0) { ret; }
    val got: opt[Slice[ir_debug.Binding]] = printer.from_ir[Slice[ir_debug.Binding]](p, module.bound(p.m, md.bindings));
    if (sel got.none) { ret; }
    printer.text(p, " bind [");
    var i: usize = 0;
    for (i < got.some.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.variable_ref(p, got.some.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
}

fun intern(m: *Module, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(?m.types, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun named(s: str) View {
    ret View{data: s, len: str_len(s)};
}

fun defined(r: err[ir_debug.Error]) bool {
    ret sel r.ok;
}

fun declare_fresh(m: *Module, e: ir_debug.Entry, out: *ir_debug.Type) bool {
    val r: res[ir_debug.Declared, ir_debug.Error] = ir_debug.declare(?m.debug, ?m.types, e);
    if (sel r.err)      { ret false; }
    if (sel r.ok.known) { ret false; }
    @out = r.ok.fresh;
    ret true;
}

# a debug table with a file, two locations, two sites, an entry of every kind and two variables
fun debug_table(m: *Module) bool {
    val file: res[ir_debug.File, ir_debug.Error] = ir_debug.file(?m.debug, named("a.mach"));
    if (sel file.err) { ret false; }
    val l0: res[ir_debug.Location, ir_debug.Error] = ir_debug.location(?m.debug, ir_debug.Position{file: file.ok, line: 3, column: 1});
    val l1: res[ir_debug.Location, ir_debug.Error] = ir_debug.location(?m.debug, ir_debug.Position{file: file.ok, line: 4, column: 2});
    if (sel l0.err) { ret false; }
    if (sel l1.err) { ret false; }
    val s0: res[ir_debug.Site, ir_debug.Error] = ir_debug.site(?m.debug, ir_debug.Inlining{call: l1.ok, callee: named("inner"), parent: opt[ir_debug.Site].none{}});
    if (sel s0.err) { ret false; }
    val s1: res[ir_debug.Site, ir_debug.Error] = ir_debug.site(?m.debug, ir_debug.Inlining{call: l0.ok, callee: named("outer"), parent: opt[ir_debug.Site].some{s0.ok}});
    if (sel s1.err) { ret false; }

    val i32t:  Type    = intern(m, types.Shape.integer{types.Integer{width: 32}});
    val i8t:   Type    = intern(m, types.Shape.integer{types.Integer{width: 8}});
    var pair:  [2]Type = [2]Type{i32t, i32t};
    val pairt: Type    = intern(m, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?pair[0], size: 2}, offsets: opt[Slice[u64]].none{}}});
    var uni:   [2]Type = [2]Type{i32t, i8t};
    val unit:  Type    = intern(m, types.Shape.union{types.Union{members: Slice[Type]{data: ?uni[0], size: 2}}});
    var tagm:  [2]Type = [2]Type{i8t, unit};
    val tagt:  Type    = intern(m, types.Shape.structure{types.Structure{members: Slice[Type]{data: ?tagm[0], size: 2}, offsets: opt[Slice[u64]].none{}}});

    var i32d:   ir_debug.Type;
    var u8d:    ir_debug.Type;
    var pointd: ir_debug.Type;
    var numd:   ir_debug.Type;
    var tagd:   ir_debug.Type;
    var colord: ir_debug.Type;
    var quadd:  ir_debug.Type;
    var ptrd:   ir_debug.Type;
    var sigd:   ir_debug.Type;
    if (!declare_fresh(m, ir_debug.Entry{key: named("i32"), name: named("i32"), head: ir_debug.Head.base{ir_debug.Base{encoding: ir_debug.Encoding.signed{}, width: 32}}}, ?i32d)) { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("u8"), name: named("u8"), head: ir_debug.Head.base{ir_debug.Base{encoding: ir_debug.Encoding.unsigned{}, width: 8}}}, ?u8d))   { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("point.Point"), name: named("point.Point"), head: ir_debug.Head.structure{pairt}}, ?pointd))                                   { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("point.Number"), name: named("point.Number"), head: ir_debug.Head.union{unit}}, ?numd))                                        { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("point.Tag"), name: named("point.Tag"), head: ir_debug.Head.tagged{tagt}}, ?tagd))                                             { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("point.Color"), name: named("point.Color"), head: ir_debug.Head.enumeration{}}, ?colord))                                      { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("point.Quad"), name: named("point.Quad"), head: ir_debug.Head.array{}}, ?quadd))                                               { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("*point.Point"), name: named("*point.Point"), head: ir_debug.Head.pointer{named("point.Point")}}, ?ptrd))                      { ret false; }
    if (!declare_fresh(m, ir_debug.Entry{key: named("main.sig"), name: named("main.sig"), head: ir_debug.Head.function{}}, ?sigd))                                                 { ret false; }

    var px: [2]ir_debug.Member = [2]ir_debug.Member{ir_debug.Member{name: named("x"), type: i32d, field: 0}, ir_debug.Member{name: named("y"), type: i32d, field: 1}};
    if (!defined(ir_debug.define(?m.debug, ?m.types, pointd, ir_debug.Shape.structure{Slice[ir_debug.Member]{data: ?px[0], size: 2}}))) { ret false; }
    var un: [2]ir_debug.Member = [2]ir_debug.Member{ir_debug.Member{name: named("i"), type: i32d, field: 0}, ir_debug.Member{name: named("b"), type: u8d, field: 1}};
    if (!defined(ir_debug.define(?m.debug, ?m.types, numd, ir_debug.Shape.union{Slice[ir_debug.Member]{data: ?un[0], size: 2}}))) { ret false; }
    var cases: [2]ir_debug.Case = [2]ir_debug.Case{
        ir_debug.Case{name: named("none"), value: 0, payload: opt[ir_debug.Member].none{}},
        ir_debug.Case{name: named("some"), value: 1, payload: opt[ir_debug.Member].some{ir_debug.Member{name: named("i"), type: i32d, field: 0}}}
    };
    val tg: ir_debug.Tagged = ir_debug.Tagged{discriminant: ir_debug.Member{name: named("tag"), type: u8d, field: 0}, payload: 1, cases: Slice[ir_debug.Case]{data: ?cases[0], size: 2}};
    if (!defined(ir_debug.define(?m.debug, ?m.types, tagd, ir_debug.Shape.tagged{tg}))) { ret false; }
    var en: [2]ir_debug.Enumerator = [2]ir_debug.Enumerator{ir_debug.Enumerator{name: named("red"), value: 0}, ir_debug.Enumerator{name: named("green"), value: 1}};
    if (!defined(ir_debug.define(?m.debug, ?m.types, colord, ir_debug.Shape.enumeration{ir_debug.Enumeration{base: u8d, enumerators: Slice[ir_debug.Enumerator]{data: ?en[0], size: 2}}}))) { ret false; }
    if (!defined(ir_debug.define(?m.debug, ?m.types, quadd, ir_debug.Shape.array{ir_debug.Array{element: i32d, count: 4}})))                                                                { ret false; }
    var sp: [2]ir_debug.Type = [2]ir_debug.Type{i32d, i32d};
    var sr: [1]ir_debug.Type = [1]ir_debug.Type{i32d};
    if (!defined(ir_debug.define(?m.debug, ?m.types, sigd, ir_debug.Shape.function{ir_debug.Function{params: Slice[ir_debug.Type]{data: ?sp[0], size: 2}, results: Slice[ir_debug.Type]{data: ?sr[0], size: 1}}}))) { ret false; }
    if (!defined(ir_debug.finish(?m.debug)))                                                                                                                                                                        { ret false; }

    val x: res[ir_debug.Binding, ir_debug.Error] = ir_debug.bind(?m.debug, ir_debug.Variable{name: named("x"), type: i32d, declared: l0.ok, parameter: opt[u32].some{0}});
    if (sel x.err) { ret false; }
    val p: res[ir_debug.Binding, ir_debug.Error] = ir_debug.bind(?m.debug, ir_debug.Variable{name: named("p"), type: pointd, declared: l1.ok, parameter: opt[u32].none{}});
    if (sel p.err) { ret false; }
    ret true;
}

test print__quotes_only_names_that_need_it {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, module.Error] = module.init(?a, View{data: "riscv64", len: 7});
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }

    var i32:   [1]Type  = [1]Type{intern(?m, types.Shape.integer{types.Integer{width: 32}})};
    val sig:   Type     = intern(?m, types.Shape.function{types.plain(Slice[Type]{data: ?i32[0], size: 1}, Slice[Type]{data: ?i32[0], size: 1})});
    var b:     Builder  = build.init(?m);
    var seven: [1]u64   = [1]u64{7};
    var one:   [1]u64   = [1]u64{1};
    val init:  Constant = build.constant(?b, ConstantData.integer{Bits{type: i32[0], words: Slice[u64]{data: ?seven[0], size: 1}}});
    val inc:   Constant = build.constant(?b, ConstantData.integer{Bits{type: i32[0], words: Slice[u64]{data: ?one[0], size: 1}}});
    build.global(?b, GlobalData{name: View{data: "counter", len: 7}, type: i32[0], initial: opt[Constant].some{init}, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    build.global(?b, GlobalData{name: View{data: "has space\"", len: 10}, type: i32[0], linkage: Linkage{binding: ?symbol.LOCAL, visibility: ?symbol.HIDDEN}});
    val f: Function = build.function(?b, FunctionData{name: View{data: "f.main_1", len: 8}, signature: sig, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    build.enter(?b, f);
    var decl:  [1]Declaration = [1]Declaration{Declaration{type: i32[0], secret: false, name: opt[View].some{View{data: "x", len: 1}}}};
    val entry: Block          = build.label(?b, build.block(?b, Slice[Declaration]{data: ?decl[0], size: 1}), View{data: "entry", len: 5});
    build.at_end(?b, entry);
    var sum: [2]Value = [2]Value{build.parameter(?b, entry, 0), build.use_constant(?b, inc)};
    sum[0] = build.name(?b, build.value(?b, Request{opcode: opcode.ADD, operands: Slice[Value]{data: ?sum[0], size: 2}}), View{data: "x", len: 1});
    sum[0] = build.name(?b, build.value(?b, Request{opcode: opcode.ADD, operands: Slice[Value]{data: ?sum[0], size: 2}}), View{data: "a b", len: 3});
    var out: [1]Value = [1]Value{build.value(?b, Request{opcode: opcode.ADD, operands: Slice[Value]{data: ?sum[0], size: 2}})};
    build.emit(?b, Request{opcode: opcode.RET, operands: Slice[Value]{data: ?out[0], size: 1}});
    val done: err[build.Failure] = build.done(?b);
    if (sel done.err)     { ret 2; }
    if (!debug_table(?m)) { ret 5; }

    var got: sink.Sink = sink.init(?a);
    fin { sink.dnit(?got); }
    var w:       io.Writer  = sink.writer(?got);
    val printed: err[Error] = print(?w, ?m);
    if (sel printed.err) { ret 3; }

    var want: sink.Sink = sink.init(?a);
    fin { sink.dnit(?want); }
    var ww: io.Writer = sink.writer(?want);
    format.write_str(?ww, "mirl \"");
    format.write_str(?ww, printer.VERSION);
    format.write_str(?ww, "\"\ntarget \"riscv64\"\n");
    format.write_str(?ww, "!f0 = file \"a.mach\"\n!l0 = location !f0 3:1\n!l1 = location !f0 4:2\n!s0 = site !l1 \"inner\"\n!s1 = site !l0 \"outer\" parent !s0\n");
    format.write_str(?ww, "!t0 = type \"i32\" \"i32\" base signed 32\n!t1 = type \"u8\" \"u8\" base unsigned 8\n");
    format.write_str(?ww, "!t2 = type \"point.Point\" \"point.Point\" structure struct{i32, i32} {\"x\": !t0 field 0, \"y\": !t0 field 1}\n");
    format.write_str(?ww, "!t3 = type \"point.Number\" \"point.Number\" union union{i32, i8} {\"i\": !t0 field 0, \"b\": !t1 field 1}\n");
    format.write_str(?ww, "!t4 = type \"point.Tag\" \"point.Tag\" tagged struct{i8, union{i32, i8}} discriminant \"tag\": !t1 field 0 payload 1 {\"none\" 0, \"some\" 1 payload \"i\": !t0 field 0}\n");
    format.write_str(?ww, "!t5 = type \"point.Color\" \"point.Color\" enumeration !t1 {\"red\" 0, \"green\" 1}\n!t6 = type \"point.Quad\" \"point.Quad\" array !t0 4\n");
    format.write_str(?ww, "!t7 = type \"*point.Point\" \"*point.Point\" pointer \"point.Point\"\n!t8 = type \"main.sig\" \"main.sig\" function (!t0, !t0) -> (!t0)\n");
    format.write_str(?ww, "!v0 = variable \"x\" !t0 declared !l0 parameter 0\n!v1 = variable \"p\" !t2 declared !l1\n");
    format.write_str(?ww, "global @counter: i32 linkage global visibility default = i32 7\nglobal @\"has space\\\"\": i32 linkage local visibility hidden\n\nfunction @f.main_1: fun(i32) -> (i32) linkage global visibility default {\n^entry(%x: i32):\n    %x.1 = add %x, i32 1\n    %\"a b\" = add %x.1, i32 1\n    %0 = add %\"a b\", i32 1\n    ret %0\n}\n");
    if (!slice.same_view(sink.view(?got), sink.view(?want))) { ret 4; }
    ret 0;
}
