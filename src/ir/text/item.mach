# printing a module: its header, typedefs, debug table, globals and functions
#
# an instruction is spelled from its opcode's row alone, and a literal's type
# from the rules of that row, so a new row prints with no change here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use mirl.base.slice;
use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;
use std.io.writer.WriteError;

use mo: masc.core.operand;
use rf: masc.core.register;
use masc.inline;
use mirl.ir.assembly.Assembly;
use AsmOperand: mirl.ir.assembly.Operand;
use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.constant.ConstantData;
use debug_record: mirl.ir.debug.record;
use mirl.ir.function.Body;
use mirl.ir.function.Effects;
use mirl.ir.function.FunctionData;
use mirl.ir.function.NO_EXTENSIONS;
use mirl.ir.function.Summary;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Range;
use mirl.ir.global.Secrecy;
use mirl.ir.global.Section;
use mirl.ir.global.Tls;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.linkage.Linkage;
use mirl.ir.metadata.Metadata;
use mirl.ir.metadata.NO_PUBLICS;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.native.Op;
use mirl.ir.opcode.check;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.rule;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.place.Fill;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.point.Run;
use mirl.ir.point.Step;
use mirl.ir.text.debug;
use mirl.ir.text.implied;
use mirl.ir.text.names;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Anchor;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Error;
use mirl.ir.text.printer.Gathered;
use mirl.ir.text.printer.Printer;
use mirl.ir.type.calling;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;

# the most operands of one instruction whose literals are typed at once
val MAX_TYPED: usize = 64;

# write the text of a module
# ---
# w:   the writer the text goes to
# m:   the module
# ret: ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module) err[Error] {
    ret write(w, m, false, nil);
}

# write the text of a module with the comments read beside it, as `fmt`
# writes a file back
# ---
# w:    the writer the text goes to
# m:    the module
# body: write it as a body, with no version statement
# kept: the comments its text was read with, nil for none
# ret:  ok, or the first failure, after which nothing more was written
pub fun print_noted(w: *io.Writer, m: *Module, body: bool, kept: *Notes) err[Error] {
    ret write(w, m, body, kept);
}

fun write(w: *io.Writer, m: *Module, body: bool, kept: *Notes) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    p.body  = body;
    p.notes = kept;
    printer.prepare(?p);
    printer.header(?p);
    printer.typedefs(?p);
    debug.table(?p);
    var i: usize = 0;
    for (i < m.globals.len) {
        global(?p, (i::u32));
        i = i + 1;
    }
    i = 0;
    for (i < m.functions.len) {
        function(?p, (i::u32));
        i = i + 1;
    }
    if (printer.noted(?p, notes.at(notes.END, 0, 0))) {
        printer.apart(?p);
        printer.anchor(?p, notes.at(notes.END, 0, 0), "");
        p.trail = opt[Anchor].none{};
    }
    val opt_failed: opt[Error] = p.failed;
    if (sel opt_failed.some) { ret err[Error].err{opt_failed.some}; }
    ret err[Error].ok{};
}

# write the decorators every symbol may carry: export, binding, the replaceable
# mark, a merged definition's identity, visibility and the attribute records of
# a target family
fun decorators(p: *Printer, s: Symbol, l: Linkage, extensions: Slice[View]) {
    if (l.export)                             { printer.text(p, "#[export] "); }
    if (str_equals(l.binding.name, "weak"))   { printer.text(p, "#[weak] "); }
    if (str_equals(l.binding.name, "unique")) { printer.text(p, "#[unique] "); }
    if (l.replaceable)                        { printer.text(p, "#[replaceable] "); }
    val opt_merged: opt[u64] = l.merged;
    if (sel opt_merged.some) {
        printer.text(p, "#[merged(");
        printer.number(p, opt_merged.some);
        printer.text(p, ")] ");
    }
    if (!str_equals(l.visibility.name, "default")) {
        printer.text(p, "#[visibility(");
        printer.word(p, l.visibility.name);
        printer.text(p, ")] ");
    }
    if (extensions.size > 0) {
        printer.text(p, "#[extensions(");
        var k: usize = 0;
        for (k < extensions.size) {
            if (k > 0) { printer.text(p, ", "); }
            printer.string(p, extensions.data[k]);
            k = k + 1;
        }
        printer.text(p, ")] ");
    }
    val opt_from_ir: opt[Slice[Attribute]] = printer.from_ir[Slice[Attribute]](p, module.attributes(p.m, s));
    if (sel opt_from_ir.none) { ret; }
    var i: usize = 0;
    for (i < opt_from_ir.some.size) {
        val at: Attribute = opt_from_ir.some.data[i];
        printer.text(p, "#[");
        printer.name(p, at.family);
        printer.byte(p, '.');
        printer.name(p, at.name);
        printer.byte(p, '(');
        if (sel at.datum.integer) { printer.number(p, at.datum.integer); }
        or (sel at.datum.integers) {
            printer.byte(p, '[');
            var k: usize = 0;
            for (k < at.datum.integers.size) {
                if (k > 0) { printer.text(p, ", "); }
                printer.number(p, at.datum.integers.data[k]);
                k = k + 1;
            }
            printer.byte(p, ']');
        }
        or (sel at.datum.text) { printer.string(p, at.datum.text); }
        printer.text(p, ")] ");
        i = i + 1;
    }
}

# write the word that opens a symbol's declaration: `ext` for one another
# module defines, `pub` for one other objects may refer to, nothing for a local
fun visible(p: *Printer, l: Linkage, defined: bool) {
    if (!defined)                             { printer.text(p, "ext "); }
    or (!str_equals(l.binding.name, "local")) { printer.text(p, "pub "); }
}

fun tls(p: *Printer, t: Tls) {
    if (sel t.general_dynamic) { printer.text(p, "general_dynamic"); }
    or (sel t.local_dynamic)   { printer.text(p, "local_dynamic"); }
    or (sel t.initial_exec)    { printer.text(p, "initial_exec"); }
    or (sel t.local_exec)      { printer.text(p, "local_exec"); }
}

# secret ranges under the decorator `named`, a global's or a function's result's, each as its offset and length
fun ranges(p: *Printer, named: str, list: Slice[Range]) {
    printer.text(p, named);
    printer.text(p, "(");
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.byte(p, '[');
        printer.number(p, list.data[i].offset);
        printer.text(p, ", ");
        printer.number(p, list.data[i].length);
        printer.byte(p, ']');
        i = i + 1;
    }
    printer.text(p, ")] ");
}

# a function's public pointers, each by its position, none when it states none
fun public_pointers(p: *Printer, list: Slice[u32]) {
    if (list.size == 0) { ret; }
    printer.text(p, "#[public_pointers(");
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.number(p, list.data[i]::u64);
        i = i + 1;
    }
    printer.text(p, ")] ");
}

# what a function's declaration states a call of it may do, nothing when it states nothing
fun effects(p: *Printer, e: Effects) {
    if (sel e.unstated) { ret; }
    val x: Summary = e.stated;
    printer.text(p, "#[effects(");
    var first: bool = true;
    if (sel x.reads.anywhere) {
        printer.text(p, "reads");
        first = false;
    }
    if (sel x.writes.anywhere) {
        if (!first) { printer.text(p, ", "); }
        printer.text(p, "writes");
        first = false;
    }
    if (x.traps) {
        if (!first) { printer.text(p, ", "); }
        printer.text(p, "traps");
        first = false;
    }
    if (x.ends) {
        if (!first) { printer.text(p, ", "); }
        printer.text(p, "ends");
        first = false;
    }
    if (first) { printer.text(p, "none"); }
    printer.text(p, ")] ");
}

# a function's secret parameters, each by its position, alone when all of it is secret and with its secret ranges when
# part of it is, none when no parameter is secret
fun secret_parameters(p: *Printer, list: Slice[Secrecy]) {
    var first: bool  = true;
    var i:     usize = 0;
    for (i < list.size) {
        val s: Secrecy = list.data[i];
        if (!(sel s.public)) {
            if (first) { printer.text(p, "#[secret_parameters("); }
            or         { printer.text(p, ", "); }
            first = false;
            printer.number(p, i::u64);
            if (sel s.ranges) {
                var k: usize = 0;
                for (k < s.ranges.size) {
                    printer.text(p, " [");
                    printer.number(p, s.ranges.data[k].offset);
                    printer.text(p, ", ");
                    printer.number(p, s.ranges.data[k].length);
                    printer.byte(p, ']');
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    if (!first) { printer.text(p, ")] "); }
}

# a symbol's alignment and section, each when it states one
fun placement(p: *Printer, alignment: opt[u64], section: opt[Section]) {
    if (sel alignment.some) {
        printer.text(p, "#[align(");
        printer.number(p, alignment.some);
        printer.text(p, ")] ");
    }
    if (sel section.some) {
        printer.text(p, "#[section(");
        printer.string(p, section.some.name);
        printer.text(p, ", ");
        printer.word(p, section.some.kind.name);
        printer.text(p, ")] ");
    }
}

fun global(p: *Printer, g: Global) {
    val opt_from_ir: opt[GlobalData] = printer.from_ir[GlobalData](p, module.global_data(p.m, g));
    if (sel opt_from_ir.none) { ret; }
    val d: GlobalData = opt_from_ir.some;
    printer.anchor(p, notes.at(notes.GLOBAL, g, 0), "");
    placement(p, d.alignment, d.section);
    if (sel d.tls.some) {
        printer.text(p, "#[tls(");
        tls(p, d.tls.some);
        printer.text(p, ")] ");
    }
    if (sel d.debug.some) {
        printer.text(p, "#[debug(");
        printer.variable_ref(p, d.debug.some);
        printer.text(p, ")] ");
    }
    if (sel d.secret.ranges) { ranges(p, "#[secret", d.secret.ranges); }
    decorators(p, Symbol.global{g}, d.linkage, NO_EXTENSIONS);
    visible(p, d.linkage, sel d.initial.some);
    if (d.constant) { printer.text(p, "val "); }
    or              { printer.text(p, "var "); }
    printer.name(p, module.name_of(p.m, d.name));
    printer.text(p, ": ");
    if (sel d.secret.whole) { printer.byte(p, '^'); }
    printer.ty(p, d.type);
    if (sel d.initial.some) {
        printer.text(p, " = ");
        printer.literal(p, d.initial.some, opt[Type].some{d.type});
    }
    printer.byte(p, ';');
    printer.newline(p);
    printer.written(p);
}

fun signature_of(p: *Printer, t: Type) opt[table.Function] {
    val opt_from_types: opt[table.Function] = printer.from_types[table.Function](p, table.signature(?p.m.types, t));
    ret opt_from_types;
}

fun function(p: *Printer, f: Function) {
    val opt_from_ir: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, f));
    if (sel opt_from_ir.none) { ret; }
    val d:        FunctionData        = opt_from_ir.some;
    val opt_sig:  opt[table.Function] = signature_of(p, d.signature);
    val opt_held: opt[*Body]          = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel opt_sig.none)  { ret; }
    if (sel opt_held.none) { ret; }
    val b:       *Body = opt_held.some;
    val defined: bool  = b.blocks.len > 0;
    printer.apart(p);
    printer.anchor(p, notes.at(notes.FUNCTION, f, 0), "");
    placement(p, d.alignment, d.section);
    if (sel d.constant_time.soft) { printer.text(p, "#[constant_time(soft)] "); }
    if (sel d.constant_time.hard) { printer.text(p, "#[constant_time(hard)] "); }
    val opt_run_at: opt[u32] = d.init;
    if (sel opt_run_at.some) {
        printer.text(p, "#[init(");
        printer.number(p, opt_run_at.some::u64);
        printer.text(p, ")] ");
    }
    secret_parameters(p, d.secrets);
    if (sel d.result.whole)  { printer.text(p, "#[secret_result] "); }
    if (sel d.result.ranges) { ranges(p, "#[secret_result", d.result.ranges); }
    if (d.follows)           { printer.text(p, "#[result_follows] "); }
    public_pointers(p, d.pointers);
    effects(p, d.effects);
    if (sel d.inlining.always) { printer.text(p, "#[inline(always)] "); }
    if (sel d.inlining.never)  { printer.text(p, "#[inline(never)] "); }
    if (d.scalar)              { printer.text(p, "#[scalar] "); }
    if (d.available)           { printer.text(p, "#[available] "); }
    val opt_named_row: opt[calling.Calling] = opt_sig.some.convention;
    if (sel opt_named_row.some) {
        printer.text(p, "#[convention(");
        printer.convention(p, opt_named_row.some);
        printer.text(p, ")] ");
    }
    var placed: bool = false;
    if (sel b.entry.placed) {
        if (defined) {
            placed = true;
            printer.text(p, "#[placed(");
            printer.ty(p, d.signature);
            printer.text(p, ", ");
            places(p, Slice[Placed]{data: b.entry.placed.data, size: b.entry.placed.len});
            printer.text(p, ")] ");
        }
    }
    decorators(p, Symbol.function{f}, d.linkage, d.extensions);
    visible(p, d.linkage, defined);
    printer.text(p, "fun ");
    printer.name(p, module.name_of(p.m, d.name));
    printer.byte(p, '(');
    if (defined) {
        start(p, f, b);
        val entry: BlockData = b.blocks.data[0];
        var i:     usize     = 0;
        for (i < entry.parameters.len) {
            if (i > 0) { printer.text(p, ", "); }
            val v: Value = entry.parameters.data[i];
            local(p, f, v);
            printer.text(p, ": ");
            typed(p, f, v);
            if (!placed && i < opt_sig.some.params.size) {
                val e: table.Extension = table.extension(opt_sig.some.param_ext, i);
                if (sel e.sext) { printer.text(p, " sext"); }
                if (sel e.zext) { printer.text(p, " zext"); }
            }
            i = i + 1;
        }
    }
    or {
        var i: usize = 0;
        for (i < opt_sig.some.params.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.parameter(p, opt_sig.some, i);
            i = i + 1;
        }
    }
    if (!placed) { printer.variadic(p, opt_sig.some); }
    printer.byte(p, ')');
    printer.results(p, opt_sig.some);
    if (!defined) {
        printer.byte(p, ';');
        printer.newline(p);
        ret;
    }
    printer.text(p, " {");
    printer.newline(p);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) { block(p, f, (k::u32), opt_sig.some.results); }
        k = k + 1;
    }
    printer.anchor(p, notes.at(notes.FUNCTION_END, f, 0), "    ");
    printer.byte(p, '}');
    printer.newline(p);
}

# start naming a function's values and name its blocks, in order, all but the
# entry, which no edge leads to and so prints no label
fun start(p: *Printer, f: Function, b: *Body) {
    val err_values: err[allocator.Error] = names.reset(?p.values, b.values.len);
    if (sel err_values.err) {
        printer.fail(p, Error.alloc{err_values.err});
        ret;
    }
    val err_blocks: err[allocator.Error] = names.reset(?p.blocks, b.blocks.len);
    if (sel err_blocks.err) {
        printer.fail(p, Error.alloc{err_blocks.err});
        ret;
    }
    var k: usize = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val err_given: err[allocator.Error] = names.give(?p.blocks, k::u32, b.blocks.data[k].name);
            if (sel err_given.err) {
                printer.fail(p, Error.alloc{err_given.err});
                ret;
            }
        }
        k = k + 1;
    }
}

fun value_data(p: *Printer, f: Function, v: Value) opt[ValueData] {
    ret printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
}

# write a value by its name, giving it one first when it has none yet
fun local(p: *Printer, f: Function, v: Value) {
    val opt_value_data: opt[ValueData] = value_data(p, f, v);
    if (sel opt_value_data.none) { ret; }
    if (!names.given(?p.values, v)) {
        val err_given: err[allocator.Error] = names.give(?p.values, v, opt_value_data.some.name);
        if (sel err_given.err) {
            printer.fail(p, Error.alloc{err_given.err});
            ret;
        }
    }
    printer.bytes(p, names.printed(?p.values, v));
}

# write a value's type, `^` before it when the value is secret
fun typed(p: *Printer, f: Function, v: Value) {
    val opt_value_data: opt[ValueData] = value_data(p, f, v);
    if (sel opt_value_data.none)    { ret; }
    if (opt_value_data.some.secret) { printer.byte(p, '^'); }
    printer.ty(p, opt_value_data.some.type);
}

# the constant a value is, none for a parameter or a result
fun constant_of(p: *Printer, f: Function, v: Value) opt[Constant] {
    val opt_value_data: opt[ValueData] = value_data(p, f, v);
    if (sel opt_value_data.none) { ret opt[Constant].none{}; }
    val def: Def = opt_value_data.some.def;
    if (sel def.constant) { ret opt[Constant].some{def.constant}; }
    ret opt[Constant].none{};
}

# write an operand: a value by its name, a constant as a literal of the type
# its place gives it
fun operand(p: *Printer, f: Function, v: Value, implied: opt[Type]) {
    val opt_constant_of: opt[Constant] = constant_of(p, f, v);
    if (sel opt_constant_of.some) { printer.literal(p, opt_constant_of.some, implied); }
    or                            { local(p, f, v); }
}

# write the name of a block an edge reaches, refusing the entry block
fun label(p: *Printer, k: Block) {
    if (k == 0 || k::usize >= p.blocks.printed.len) {
        printer.fail(p, Error.ir{module.Error.block{k}});
        ret;
    }
    printer.bytes(p, names.printed(?p.blocks, k));
}

fun block(p: *Printer, f: Function, k: Block, returns: Slice[Type]) {
    val opt_from_ir: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, k));
    if (sel opt_from_ir.none) { ret; }
    val d: BlockData = opt_from_ir.some;
    if (k != 0) {
        printer.anchor(p, notes.at(notes.BLOCK, f, k), "");
        label(p, k);
        if (d.parameters.len > 0) {
            printer.byte(p, '(');
            var i: usize = 0;
            for (i < d.parameters.len) {
                if (i > 0) { printer.text(p, ", "); }
                val v: Value = d.parameters.data[i];
                local(p, f, v);
                printer.text(p, ": ");
                typed(p, f, v);
                i = i + 1;
            }
            printer.byte(p, ')');
        }
        printer.byte(p, ':');
        printer.newline(p);
    }
    val opt_held: opt[*Body] = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel opt_held.none) { ret; }
    var at: Instruction = d.first;
    for (at != NO_INSTRUCTION) {
        records(p, f, opt_held.some, opt_held.some.instructions.data[at].points);
        instruction(p, f, at, returns);
        at = opt_held.some.instructions.data[at].next;
    }
    records(p, f, opt_held.some, d.ending);
}

# the records of a run, in order
fun records(p: *Printer, f: Function, b: *Body, run: Run) {
    var r: u32 = run.first;
    for (r != 0 && printer.ok(p)) {
        val pt: Point = b.points.data[r - 1];
        printer.anchor(p, notes.at(notes.RECORD, f, r), "    ");
        record(p, f, pt);
        r = pt.next;
    }
}

# the type of a value, none after keeping the module's refusal
fun type_of(p: *Printer, f: Function, v: Value) opt[Type] {
    val opt_value_data: opt[ValueData] = value_data(p, f, v);
    if (sel opt_value_data.none) { ret opt[Type].none{}; }
    ret opt[Type].some{opt_value_data.some.type};
}

# a value binding record: its variable, its piece, and the operand it reads
# through each step, the innermost step first
fun record(p: *Printer, f: Function, pt: Point) {
    printer.text(p, "    bind ");
    printer.variable_ref(p, pt.binding);
    if (!point.whole(pt.piece)) {
        printer.byte(p, '[');
        printer.number(p, pt.piece.offset::u64);
        printer.text(p, ", ");
        printer.number(p, pt.piece.size::u64);
        printer.byte(p, ']');
    }
    printer.text(p, " = ");
    val reads: Reads = pt.reads;
    if (sel reads.unavailable) {
        printer.text(p, "unavailable;");
        printer.newline(p);
        ret;
    }
    val opt_from_ir: opt[Slice[Step]] = printer.from_ir[Slice[Step]](p, module.steps(p.m, reads.operand.expression));
    if (sel opt_from_ir.none) { ret; }
    val steps: Slice[Step] = opt_from_ir.some;
    var k:     usize       = steps.size;
    for (k > 0) {
        k = k - 1;
        val opt_row: opt[point.Row] = point.row(steps.data[k].kind);
        if (sel opt_row.none) {
            printer.fail(p, Error.ir{module.Error.step{steps.data[k].kind}});
            ret;
        }
        printer.word(p, opt_row.some.name);
        val a: point.Argument = steps.data[k].argument;
        if (sel a.to) {
            printer.byte(p, '[');
            printer.ty(p, a.to);
            printer.byte(p, ']');
        }
        printer.byte(p, '(');
    }
    operand(p, f, reads.operand.value, opt[Type].none{});
    var opt_current: opt[Type] = type_of(p, f, reads.operand.value);
    k = 0;
    for (k < steps.size) {
        val a: point.Argument = steps.data[k].argument;
        if (sel a.constant) {
            printer.text(p, ", ");
            printer.literal(p, a.constant, opt_current);
        }
        if (sel a.to) { opt_current = opt[Type].some{a.to}; }
        printer.byte(p, ')');
        k = k + 1;
    }
    printer.byte(p, ';');
    printer.newline(p);
}

fun ordering(p: *Printer, o: rule.Ordering) {
    if (sel o.relaxed) { printer.text(p, "relaxed"); }
    or (sel o.acquire) { printer.text(p, "acquire"); }
    or (sel o.release) { printer.text(p, "release"); }
    or (sel o.acq_rel) { printer.text(p, "acq_rel"); }
    or (sel o.seq_cst) { printer.text(p, "seq_cst"); }
}

# write how a place is filled past its piece
pub fun fill(p: *Printer, f: Fill) {
    if (sel f.exact)     { printer.text(p, "exact"); }
    or (sel f.undefined) { printer.text(p, "undefined"); }
    or (sel f.sign) {
        printer.text(p, "sign(");
        printer.number(p, f.sign::u64);
        printer.byte(p, ')');
    }
    or (sel f.zero) {
        printer.text(p, "zero(");
        printer.number(p, f.zero::u64);
        printer.byte(p, ')');
    }
    or (sel f.boxed) { printer.text(p, "boxed"); }
    or (sel f.declared) {
        printer.text(p, "declared(");
        printer.number(p, f.declared::u64);
        printer.byte(p, ')');
    }
}

# write a bracketed list of places
fun places(p: *Printer, list: Slice[Placed]) {
    printer.byte(p, '[');
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        val at: Placed = list.data[i];
        printer.byte(p, '{');
        if (sel at.place.register) {
            printer.text(p, "reg(");
            printer.number(p, rf.class_of(at.place.register)::u64);
            printer.text(p, ", ");
            printer.number(p, rf.number_of(at.place.register)::u64);
            printer.byte(p, ')');
        }
        or (sel at.place.stack) {
            printer.text(p, "stack(");
            printer.number(p, at.place.stack.offset);
            if (sel at.place.stack.scale.scaled) {
                printer.text(p, ", scaled ");
                printer.number(p, at.place.stack.scale.scaled::u64);
            }
            printer.byte(p, ')');
        }
        or (sel at.place.operand) {
            printer.text(p, "operand(");
            printer.number(p, at.place.operand::u64);
            printer.byte(p, ')');
        }
        if (sel at.scale.scaled) {
            printer.text(p, ", scaled(");
            printer.number(p, at.scale.scaled::u64);
            printer.byte(p, ')');
        }
        or { printer.text(p, ", fixed"); }
        printer.text(p, ", ");
        fill(p, at.fill);
        printer.byte(p, '}');
        i = i + 1;
    }
    printer.byte(p, ']');
}

fun numbers(p: *Printer, list: Slice[u64]) {
    printer.byte(p, '[');
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.number(p, list.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
}

# write a target op: its set, its op, its result types, and what it declares
# it reads and writes of memory
fun target_op(p: *Printer, o: *Op) {
    printer.text(p, "op(");
    printer.string(p, o.set);
    printer.text(p, ", ");
    printer.string(p, o.name);
    printer.text(p, ", [");
    var i: usize = 0;
    for (i < o.results.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.ty(p, o.results.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
    if (o.reads)  { printer.text(p, ", reads"); }
    if (o.writes) { printer.text(p, ", writes"); }
    printer.byte(p, ')');
}

fun role_word(p: *Printer, r: mo.Role) {
    if (r == mo.READ)       { printer.text(p, "in"); }
    or (r == mo.WRITE)      { printer.text(p, "out"); }
    or (r == mo.READ_WRITE) { printer.text(p, "inout"); }
    or                      { printer.text(p, "none"); }
}

# write an inline assembly block: its text, its operands each with its role,
# constraint and type, what it declares it reads and writes of memory, and the
# selection it states
fun assembled(p: *Printer, b: *Assembly) {
    printer.string(p, b.text);
    printer.text(p, " {");
    var i: usize = 0;
    for (i < b.operands.size) {
        if (i > 0) { printer.text(p, ", "); }
        val o: *AsmOperand = ?b.operands.data[i];
        printer.name(p, o.name);
        printer.text(p, ": ");
        role_word(p, o.role);
        if (sel o.placement.value)  { printer.text(p, " value"); }
        or (sel o.placement.stated) { constrained(p, o.placement.stated); }
        printer.byte(p, ' ');
        printer.ty(p, o.ty);
        if (sel o.points.public) { printer.text(p, " points(public)"); }
        if (sel o.points.secret) { printer.text(p, " points(secret)"); }
        i = i + 1;
    }
    printer.byte(p, '}');
    if (b.reads)  { printer.text(p, " reads"); }
    if (b.writes) { printer.text(p, " writes"); }
    if (b.selection.len > 0) {
        printer.text(p, " under ");
        printer.string(p, b.selection);
    }
}

# write what masc's constraint of an operand states
fun constrained(p: *Printer, c: inline.Constraint) {
    if (sel c.class) {
        printer.text(p, " reg(");
        printer.number(p, c.class::u64);
        printer.byte(p, ')');
    }
    or (sel c.memory) { printer.text(p, " mem"); }
    or (sel c.immediate) {
        printer.text(p, " imm(");
        printer.number(p, c.immediate.bits::u64);
        if (c.immediate.signed)   { printer.text(p, ", signed"); }
        or                        { printer.text(p, ", unsigned"); }
        if (c.immediate.symbolic) { printer.text(p, ", symbolic"); }
        printer.byte(p, ')');
    }
}

# write what a slot holds
fun immediate(p: *Printer, k: *implied.Known, imm: Immediate, slot: u32) {
    if (sel imm.ty)        { printer.ty(p, imm.ty); }
    or (sel imm.alignment) { printer.number(p, imm.alignment); }
    or (sel imm.ordering)  { ordering(p, imm.ordering); }
    or (sel imm.lane)      { printer.number(p, imm.lane::u64); }
    or (sel imm.lanes) {
        printer.byte(p, '[');
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.number(p, imm.lanes.data[i]::u64);
            i = i + 1;
        }
        printer.byte(p, ']');
    }
    or (sel imm.named) {
        if (sel imm.named.first) { printer.number(p, imm.named.first::u64); }
        or (sel imm.named.all)   { printer.text(p, "all"); }
        or                       { printer.fail(p, Error.ir{module.Error.typing{check.Error.named{slot}}}); }
    }
    or (sel imm.places) { places(p, imm.places); }
    or (sel imm.member) {
        val opt_agg:   opt[Type] = implied.member_aggregate(k, slot);
        var opt_named: opt[View] = opt[View].none{};
        if (sel opt_agg.some)   { opt_named = printer.member_name(p, opt_agg.some, imm.member); }
        if (sel opt_named.some) { printer.bytes(p, opt_named.some); }
        or                      { printer.number(p, imm.member::u64); }
    }
    or (sel imm.cases)    { numbers(p, imm.cases); }
    or (sel imm.function) { printer.symbol(p, Symbol.function{imm.function}); }
    or (sel imm.assembly) { assembled(p, imm.assembly); }
    or (sel imm.op)       { target_op(p, imm.op); }
    or (sel imm.state)    { printer.string(p, imm.state); }
}

# the function a callee operand names directly, its address with no offset
fun direct(p: *Printer, f: Function, v: Value) opt[Function] {
    val opt_constant_of: opt[Constant] = constant_of(p, f, v);
    if (sel opt_constant_of.none) { ret opt[Function].none{}; }
    val opt_from_ir: opt[ConstantData] = printer.from_ir[ConstantData](p, module.constant_data(p.m, opt_constant_of.some));
    if (sel opt_from_ir.none) { ret opt[Function].none{}; }
    val d: ConstantData = opt_from_ir.some;
    if (!(sel d.address))                          { ret opt[Function].none{}; }
    if (d.address.offset != 0)                     { ret opt[Function].none{}; }
    if (!printer.plain_pointer(p, d.address.type)) { ret opt[Function].none{}; }
    val s: Symbol = d.address.symbol;
    if (sel s.function) { ret opt[Function].some{s.function}; }
    ret opt[Function].none{};
}

# whether the text leaves the immediate at a slot out
fun left_out(p: *Printer, f: Function, d: *InstructionData, k: *implied.Known, slot: u32, callee: opt[Function]) bool {
    val holds: opcode_row.Holds = k.row.immediates[slot].holds;
    val imm:   Immediate        = d.immediates.data[slot];
    if (sel holds.cases) { ret true; }
    if (sel imm.named)   { ret sel imm.named.all; }
    if (sel imm.alignment) {
        val opt_accessed: opt[Type] = implied.accessed(k.row, k.immediates, k.operands);
        if (sel opt_accessed.none) { ret false; }
        val opt_natural: opt[u64] = implied.natural(p.m, opt_accessed.some);
        ret sel opt_natural.some && opt_natural.some == imm.alignment;
    }
    if (sel imm.ty) {
        if (sel callee.some) {
            if (implied.signature_slot(k.row, slot)) {
                val opt_from_ir: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, callee.some));
                if (sel opt_from_ir.some) { ret table.same(opt_from_ir.some.signature, imm.ty); }
            }
        }
    }
    ret false;
}

# write the decorators of an instruction: its flags, and its secrecy where its
# row and its results do not state it
fun flags(p: *Printer, f: Function, d: *InstructionData, r: *opcode_row.Row) {
    val md: Metadata = d.metadata;
    if (md.flags.volatile)   { printer.text(p, "#[volatile] "); }
    if (md.flags.kept)       { printer.text(p, "#[kept] "); }
    if (md.flags.bounded)    { printer.text(p, "#[bounded] "); }
    if (md.flags.checked)    { printer.text(p, "#[checked] "); }
    if (md.flags.public)     { printer.text(p, "#[public] "); }
    if (md.flags.ascending)  { printer.text(p, "#[ascending] "); }
    if (md.flags.descending) { printer.text(p, "#[descending] "); }
    if (md.publics != NO_PUBLICS) {
        val opt_from_ir: opt[Slice[Range]] = printer.from_ir[Slice[Range]](p, module.public_ranges(p.m, md.publics));
        if (sel opt_from_ir.some) {
            printer.text(p, "#[public(");
            var k: usize = 0;
            for (k < opt_from_ir.some.size) {
                if (k > 0) { printer.text(p, ", "); }
                printer.byte(p, '[');
                printer.number(p, opt_from_ir.some.data[k].offset);
                printer.text(p, ", ");
                printer.number(p, opt_from_ir.some.data[k].length);
                printer.byte(p, ']');
                k = k + 1;
            }
            printer.text(p, ")] ");
        }
    }
    if (md.extent.length != 0) {
        printer.text(p, "#[within(");
        printer.number(p, md.extent.offset);
        printer.text(p, ", ");
        printer.number(p, md.extent.length);
        printer.text(p, ")] ");
    }
    if (!md.secret) { ret; }
    var shown: bool = false;
    if (sel r.secrecy.declared) {
        var i: usize = 0;
        for (i < d.results.len) {
            val opt_value_data: opt[ValueData] = value_data(p, f, d.results.data[i]);
            if (sel opt_value_data.some) {
                if (opt_value_data.some.secret) { shown = true; }
            }
            i = i + 1;
        }
    }
    if (!shown) { printer.text(p, "#[secret] "); }
}

fun instruction(p: *Printer, f: Function, i: Instruction, returns: Slice[Type]) {
    val opt_from_ir: opt[InstructionData] = printer.from_ir[InstructionData](p, body.instruction_data(p.m, f, i));
    if (sel opt_from_ir.none) { ret; }
    var d:       InstructionData      = opt_from_ir.some;
    val opt_row: opt[*opcode_row.Row] = opcode_table.at(d.opcode);
    if (sel opt_row.none) {
        printer.fail(p, Error.opcode{d.opcode});
        ret;
    }
    val r: *opcode_row.Row = opt_row.some;
    if (d.operands.len > MAX_TYPED) {
        printer.fail(p, Error.form{"an instruction of more operands than the printer types at once"});
        ret;
    }

    # type the operands: values by their own type, literals by the rows
    var known:   [64]opt[Type];
    var actual:  [64]opt[Type];
    var settled: [64]bool;
    var n:       usize = 0;
    for (n < d.operands.len) {
        val v:               Value         = d.operands.data[n];
        val opt_constant_of: opt[Constant] = constant_of(p, f, v);
        settled[n] = false;
        if (sel opt_constant_of.some) {
            known[n]  = opt[Type].none{};
            actual[n] = printer.constant_type(p, opt_constant_of.some);
        }
        or {
            known[n]  = type_of(p, f, v);
            actual[n] = opt[Type].none{};
        }
        n = n + 1;
    }
    var outs: [2]Type;
    var o:    usize = 0;
    for (o < d.results.len && o < 2) {
        val opt_type_of: opt[Type] = type_of(p, f, d.results.data[o]);
        if (sel opt_type_of.some) { outs[o] = opt_type_of.some; }
        o = o + 1;
    }
    var k: implied.Known = implied.Known{
        m:          p.m,
        row:        r,
        operands:   Slice[opt[Type]]{data: ?known[0], size: n},
        immediates: Slice[Immediate]{data: d.immediates.data, size: d.immediates.len},
        returns:    returns,
        results:    Slice[Type]{data: ?outs[0], size: o},
    };
    implied.settle(?k, Slice[opt[Type]]{data: ?actual[0], size: n}, ?settled[0]);

    printer.anchor(p, notes.at(notes.INSTRUCTION, f, i), "    ");
    printer.text(p, "    ");
    flags(p, f, ?d, r);
    if (d.results.len > 0) {
        printer.text(p, "val ");
        if (d.results.len > 1) { printer.byte(p, '('); }
        var j: usize = 0;
        for (j < d.results.len) {
            if (j > 0) { printer.text(p, ", "); }
            local(p, f, d.results.data[j]);
            printer.text(p, ": ");
            typed(p, f, d.results.data[j]);
            j = j + 1;
        }
        if (d.results.len > 1) { printer.byte(p, ')'); }
        printer.text(p, " = ");
    }
    printer.word(p, r.name);

    val opt_at_callee: opt[u32]      = implied.callee_of(r);
    var opt_callee:    opt[Function] = opt[Function].none{};
    if (sel opt_at_callee.some) {
        if (opt_at_callee.some::usize < d.operands.len) { opt_callee = direct(p, f, d.operands.data[opt_at_callee.some]); }
    }

    # the immediates, the first bare and the others by their slot's name
    var open: bool = false;
    var s:    u32  = 0;
    for (s::usize < d.immediates.len) {
        if (!left_out(p, f, ?d, ?k, s, opt_callee)) {
            if (open) { printer.text(p, ", "); }
            or        { printer.byte(p, '['); }
            open = true;
            if (!implied.bare(r.immediates[s].holds, s) && s < opcode_row.slots(r)) {
                printer.word(p, r.immediates[s].name);
                printer.text(p, ": ");
            }
            immediate(p, ?k, d.immediates.data[s], s);
        }
        s = s + 1;
    }
    if (open) { printer.byte(p, ']'); }

    # the callee, bare when it is a function of the module
    if (sel opt_at_callee.some) {
        printer.byte(p, ' ');
        if (sel opt_callee.some) { printer.symbol(p, Symbol.function{opt_callee.some}); }
        or                       { operand(p, f, d.operands.data[opt_at_callee.some], known[opt_at_callee.some]); }
    }

    # the other operands, left out when there are none and there are targets
    var shown: usize = d.operands.len;
    if (sel opt_at_callee.some) { shown = shown - 1; }
    if (shown > 0 || d.edges.len == 0) {
        printer.byte(p, '(');
        var first: bool  = true;
        var j:     usize = 0;
        for (j < d.operands.len) {
            var skip: bool = false;
            if (sel opt_at_callee.some) { skip = j == opt_at_callee.some::usize; }
            if (!skip) {
                if (!first) { printer.text(p, ", "); }
                first = false;
                var opt_implied_type: opt[Type] = opt[Type].none{};
                if (settled[j]) { opt_implied_type = known[j]; }
                operand(p, f, d.operands.data[j], opt_implied_type);
            }
            j = j + 1;
        }
        printer.byte(p, ')');
    }

    # the targets, each after the first leading with its case value when the
    # row states a case list
    var opt_cases: opt[Slice[u64]] = opt[Slice[u64]].none{};
    var c:         usize           = 0;
    for (c < d.immediates.len) {
        val imm: Immediate = d.immediates.data[c];
        if (sel imm.cases) { opt_cases = opt[Slice[u64]].some{imm.cases}; }
        c = c + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        if (e == 0) { printer.byte(p, ' '); }
        or          { printer.text(p, ", "); }
        if (sel opt_cases.some) {
            if (e > 0 && e - 1 < opt_cases.some.size) {
                printer.number(p, opt_cases.some.data[e - 1]);
                printer.text(p, ": ");
            }
        }
        edge(p, f, d.edges.data[e]);
        e = e + 1;
    }
    metadata(p, d.metadata);
    printer.byte(p, ';');
    printer.newline(p);
}

fun edge(p: *Printer, f: Function, e: Edge) {
    label(p, e.block);
    if (e.arguments.len == 0) { ret; }
    val opt_target: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, e.block));
    if (sel opt_target.none) { ret; }
    printer.byte(p, '(');
    var j: usize = 0;
    for (j < e.arguments.len) {
        if (j > 0) { printer.text(p, ", "); }
        var opt_implied_type: opt[Type] = opt[Type].none{};
        if (j < opt_target.some.parameters.len) { opt_implied_type = type_of(p, f, opt_target.some.parameters.data[j]); }
        operand(p, f, e.arguments.data[j], opt_implied_type);
        j = j + 1;
    }
    printer.byte(p, ')');
}

# write the location, inlining site and debug bindings of an instruction, each
# left out when empty
pub fun metadata(p: *Printer, md: Metadata) {
    if (sel md.location.some) {
        printer.text(p, " at ");
        printer.location_ref(p, md.location.some);
    }
    if (sel md.site.some) {
        printer.text(p, " in ");
        printer.site_ref(p, md.site.some);
    }
    if (md.bindings == 0) { ret; }
    val opt_from_ir: opt[Slice[debug_record.Binding]] = printer.from_ir[Slice[debug_record.Binding]](p, module.bound(p.m, md.bindings));
    if (sel opt_from_ir.none) { ret; }
    printer.text(p, " holds [");
    var i: usize = 0;
    for (i < opt_from_ir.some.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.variable_ref(p, opt_from_ir.some.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
    if (!point.whole(md.piece)) {
        printer.byte(p, '[');
        printer.number(p, md.piece.offset::u64);
        printer.text(p, ", ");
        printer.number(p, md.piece.size::u64);
        printer.byte(p, ']');
    }
}

# a part of a module written as a text another module binds (`mirl.ir.text.parse.Into.bind`): the functions chosen into
# it with their bodies, every typedef and debug entry their text names, and each symbol they name and the part does not
# hold as the declaration of one another module defines. a function is tried before it is chosen: writing it gathers
# what it names, which the chooser reads, then keeps or gives back. a part is made in place, since its printer points
# into it
# ---
# p:       the printer, writing nowhere while the part is gathered
# g:       what the chosen functions and the one on trial name
# taken:   whether each function is chosen
# chosen:  the functions chosen, in the order they were
# kept:    per kind, how many names the chosen functions gathered, past which the trial's are
# nowhere: the writer that drops what it is given
pub rec Part {
    p:       Printer;
    g:       Gathered;
    taken:   vector.Vector[bool];
    chosen:  vector.Vector[Function];
    kept:    [printer.KINDS]usize;
    nowhere: io.Writer;
}

fun dropped(ctx: ptr, data: *u8, n: usize) res[usize, WriteError] {
    ret res[usize, WriteError].ok{n};
}

# begin a part of module m in `pt`, nothing chosen
pub fun part_begin(pt: *Part, m: *Module) err[Error] {
    pt.nowhere  = io.Writer{ctx: nil, fn_write: dropped};
    pt.g        = printer.gathered_init(m.a);
    pt.taken    = vector.init[bool](m.a);
    pt.chosen   = vector.init[Function](m.a);
    pt.p        = printer.init(?pt.nowhere, m);
    pt.p.body   = true;
    pt.p.gather = ?pt.g;
    var k: usize = 0;
    for (k < printer.KINDS) {
        pt.kept[k] = 0;
        k          = k + 1;
    }
    val err_filled: err[allocator.Error] = slice.fill[bool](?pt.taken, m.functions.len, false);
    if (sel err_filled.err) { ret err[Error].err{Error.alloc{err_filled.err}}; }
    printer.prepare(?pt.p);
    val opt_failed: opt[Error] = pt.p.failed;
    if (sel opt_failed.some) { ret err[Error].err{opt_failed.some}; }
    ret err[Error].ok{};
}

# give back a part's storage
pub fun part_end(pt: *Part) {
    printer.dnit(?pt.p);
    printer.gathered_dnit(?pt.g);
    vector.dnit[bool](?pt.taken);
    vector.dnit[Function](?pt.chosen);
}

# try function f: its text written nowhere, gathering what it names. the functions and globals it names that no chosen
# function named are then `part_tried`'s
pub fun part_try(pt: *Part, f: Function) err[Error] {
    pt.p.w = ?pt.nowhere;
    function(?pt.p, f);
    val opt_failed: opt[Error] = pt.p.failed;
    if (sel opt_failed.some) { ret err[Error].err{opt_failed.some}; }
    ret err[Error].ok{};
}

# the ids of `kind` (FUNCTIONS or GLOBALS) the function on trial named that no chosen function named
pub fun part_tried(pt: *Part, kind: usize) Slice[u32] {
    val list: *vector.Vector[u32] = ?pt.g.lists[kind];
    ret Slice[u32]{data: ?list.data[pt.kept[kind]], size: list.len - pt.kept[kind]};
}

# choose the function on trial, f
pub fun part_keep(pt: *Part, f: Function) err[Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[Function](?pt.chosen, f);
    if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
    pt.taken.data[f] = true;
    var k: usize = 0;
    for (k < printer.KINDS) {
        pt.kept[k] = pt.g.lists[k].len;
        k          = k + 1;
    }
    ret err[Error].ok{};
}

# give back every function the part chose and everything gathered, so the part is begun again on the same module
pub fun part_reset(pt: *Part) {
    var i: usize = 0;
    for (i < pt.chosen.len) {
        pt.taken.data[pt.chosen.data[i]] = false;
        i                                = i + 1;
    }
    vector.truncate[Function](?pt.chosen, 0);
    var k: usize = 0;
    for (k < printer.KINDS) {
        printer.gathered_back(?pt.g, k, 0);
        pt.kept[k] = 0;
        k          = k + 1;
    }
}

# give back what the function on trial gathered
pub fun part_drop(pt: *Part) {
    var k: usize = 0;
    for (k < printer.KINDS) {
        printer.gathered_back(?pt.g, k, pt.kept[k]);
        k = k + 1;
    }
}

# how many functions the part holds
pub fun part_count(pt: *Part) usize {
    ret pt.chosen.len;
}

# the ids of `kind` (FUNCTIONS or GLOBALS) the part's text names, complete once it is written
pub fun part_named(pt: *Part, kind: usize) Slice[u32] {
    ret Slice[u32]{data: pt.g.lists[kind].data, size: pt.g.lists[kind].len};
}

# whether the part holds function f with its body
pub fun part_holds(pt: *Part, f: Function) bool {
    ret pt.taken.data[f];
}

# the declarations of the symbols the part names and does not hold
fun part_declarations(pt: *Part) {
    val globals: *vector.Vector[u32] = ?pt.g.lists[printer.GLOBALS];
    var i:       usize               = 0;
    for (i < globals.len) {
        declared_global(?pt.p, globals.data[i]);
        i = i + 1;
    }
    val functions: *vector.Vector[u32] = ?pt.g.lists[printer.FUNCTIONS];
    i = 0;
    for (i < functions.len) {
        if (!pt.taken.data[functions.data[i]]) { declared_function(?pt.p, functions.data[i]); }
        i = i + 1;
    }
}

# write the part to w: first written nowhere until the typedefs, debug entries and declarations name nothing more, then
# the typedefs, the debug entries, the declarations and the chosen functions
pub fun part_write(pt: *Part, w: *io.Writer) err[Error] {
    pt.p.w     = ?pt.nowhere;
    pt.g.fresh = true;
    for (pt.g.fresh && printer.ok(?pt.p)) {
        pt.g.fresh = false;
        debug.table(?pt.p);
        part_declarations(pt);
        printer.typedefs(?pt.p);
    }
    pt.p.w     = w;
    pt.p.blank = true;
    printer.typedefs(?pt.p);
    debug.table(?pt.p);
    part_declarations(pt);
    var i: usize = 0;
    for (i < pt.chosen.len) {
        function(?pt.p, pt.chosen.data[i]);
        i = i + 1;
    }
    val opt_failed: opt[Error] = pt.p.failed;
    if (sel opt_failed.some) { ret err[Error].err{opt_failed.some}; }
    ret err[Error].ok{};
}

# a function a part names and does not hold, declared as one another module defines: its secrecy, constant time,
# convention and visibility, which a call of it reads, and its signature
fun declared_function(p: *Printer, f: Function) {
    val opt_from_ir: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, f));
    if (sel opt_from_ir.none) { ret; }
    val d:       FunctionData        = opt_from_ir.some;
    val opt_sig: opt[table.Function] = signature_of(p, d.signature);
    if (sel opt_sig.none)         { ret; }
    if (sel d.constant_time.soft) { printer.text(p, "#[constant_time(soft)] "); }
    if (sel d.constant_time.hard) { printer.text(p, "#[constant_time(hard)] "); }
    secret_parameters(p, d.secrets);
    if (sel d.result.whole)  { printer.text(p, "#[secret_result] "); }
    if (sel d.result.ranges) { ranges(p, "#[secret_result", d.result.ranges); }
    if (d.follows)           { printer.text(p, "#[result_follows] "); }
    public_pointers(p, d.pointers);
    val opt_named_row: opt[calling.Calling] = opt_sig.some.convention;
    if (sel opt_named_row.some) {
        printer.text(p, "#[convention(");
        printer.convention(p, opt_named_row.some);
        printer.text(p, ")] ");
    }
    seen(p, d.linkage);
    printer.text(p, "ext fun ");
    printer.name(p, module.name_of(p.m, d.name));
    printer.byte(p, '(');
    var i: usize = 0;
    for (i < opt_sig.some.params.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.parameter(p, opt_sig.some, i);
        i = i + 1;
    }
    printer.variadic(p, opt_sig.some);
    printer.byte(p, ')');
    printer.results(p, opt_sig.some);
    printer.byte(p, ';');
    printer.newline(p);
    printer.written(p);
}

# a global a part names, declared as one another module defines: its thread-local model, secrecy and visibility, and
# its type
fun declared_global(p: *Printer, g: Global) {
    val opt_from_ir: opt[GlobalData] = printer.from_ir[GlobalData](p, module.global_data(p.m, g));
    if (sel opt_from_ir.none) { ret; }
    val d: GlobalData = opt_from_ir.some;
    if (sel d.tls.some) {
        printer.text(p, "#[tls(");
        tls(p, d.tls.some);
        printer.text(p, ")] ");
    }
    if (sel d.secret.ranges) { ranges(p, "#[secret", d.secret.ranges); }
    seen(p, d.linkage);
    printer.text(p, "ext ");
    if (d.constant) { printer.text(p, "val "); }
    or              { printer.text(p, "var "); }
    printer.name(p, module.name_of(p.m, d.name));
    printer.text(p, ": ");
    if (sel d.secret.whole) { printer.byte(p, '^'); }
    printer.ty(p, d.type);
    printer.byte(p, ';');
    printer.newline(p);
    printer.written(p);
}

# a symbol's visibility, when it is not the default
fun seen(p: *Printer, l: Linkage) {
    if (str_equals(l.visibility.name, "default")) { ret; }
    printer.text(p, "#[visibility(");
    printer.word(p, l.visibility.name);
    printer.text(p, ")] ");
}
