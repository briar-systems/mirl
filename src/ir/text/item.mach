# printing a module: its header, globals, functions, blocks and instructions
#
# an instruction is spelled from its opcode's row alone, so a new row prints
# with no change here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.format;
use io: std.io.writer;

use mink.lib.model.symbol;
use mirl.build;
use mirl.build.Builder;
use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use ir_debug: mirl.ir.debug;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.text.debug;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Error;
use mirl.ir.text.printer.Printer;
use mirl.ir.text.printer.UNNAMED;
use mirl.ir.text.sink;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;
use mirl.slice;

# write the text of a module
# ---
# w:   the writer the text goes to
# m:   the module
# ret: ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    printer.text(?p, "mirl ");
    printer.string(?p, View{data: printer.VERSION, len: str_len(printer.VERSION)});
    printer.newline(?p);
    printer.text(?p, "target ");
    printer.string(?p, module.target(m));
    printer.newline(?p);
    debug.table(?p);
    var i: usize = 0;
    for (i < m.globals.len) {
        global(?p, Global{index: i::u32});
        i = i + 1;
    }
    i = 0;
    for (i < m.functions.len) {
        function(?p, Function{index: i::u32});
        i = i + 1;
    }
    val failed: opt[Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{failed.some}; }
    ret err[Error].ok{};
}

fun same_symbol(a: Symbol, b: Symbol) bool {
    if (sel a.function) { ret sel b.function && b.function.index == a.function.index; }
    ret sel b.global && b.global.index == a.global.index;
}

fun exported(m: *Module, s: Symbol) bool {
    val list: Slice[Symbol] = module.exports(m);
    var i:    usize         = 0;
    for (i < list.size) {
        if (same_symbol(list.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun lead(p: *Printer, s: Symbol, keyword: str) {
    if (exported(p.m, s)) { printer.text(p, "export "); }
    printer.text(p, keyword);
    printer.symbol(p, s);
    printer.text(p, ": ");
}

fun attributes(p: *Printer, s: Symbol) {
    val got: opt[Slice[Attribute]] = printer.from_ir[Slice[Attribute]](p, module.attributes(p.m, s));
    if (sel got.none) { ret; }
    var i: usize = 0;
    for (i < got.some.size) {
        val at: Attribute = got.some.data[i];
        printer.text(p, "attribute ");
        printer.symbol(p, s);
        printer.byte(p, ' ');
        printer.name(p, at.family);
        printer.byte(p, ' ');
        printer.name(p, at.name);
        printer.text(p, " = ");
        if (sel at.datum.integer) { printer.number(p, at.datum.integer); }
        or (sel at.datum.integers) {
            printer.byte(p, '[');
            var k: usize = 0;
            for (k < at.datum.integers.size) {
                if (k > 0) { printer.text(p, ", "); }
                printer.number(p, at.datum.integers.data[k]);
                k = k + 1;
            }
            printer.byte(p, ']');
        }
        or (sel at.datum.text) { printer.string(p, at.datum.text); }
        printer.newline(p);
        i = i + 1;
    }
}

fun tls(p: *Printer, t: Tls) {
    if (sel t.general_dynamic) { printer.text(p, "general_dynamic"); }
    or (sel t.local_dynamic)   { printer.text(p, "local_dynamic"); }
    or (sel t.initial_exec)    { printer.text(p, "initial_exec"); }
    or (sel t.local_exec)      { printer.text(p, "local_exec"); }
}

fun global(p: *Printer, g: Global) {
    val got: opt[GlobalData] = printer.from_ir[GlobalData](p, module.global_data(p.m, g));
    if (sel got.none) { ret; }
    val d: GlobalData = got.some;
    val s: Symbol     = Symbol.global{g};
    lead(p, s, "global ");
    printer.ty(p, d.type);
    printer.text(p, " linkage ");
    printer.word(p, d.linkage.name);
    printer.text(p, " visibility ");
    printer.word(p, d.visibility.name);
    if (sel d.alignment.some) {
        printer.text(p, " align ");
        printer.number(p, d.alignment.some);
    }
    if (sel d.section.some) {
        printer.text(p, " section ");
        printer.string(p, d.section.some);
    }
    if (sel d.tls.some) {
        printer.text(p, " tls ");
        tls(p, d.tls.some);
    }
    if (sel d.initial.some) {
        printer.text(p, " = ");
        printer.constant(p, d.initial.some);
    }
    printer.newline(p);
    attributes(p, s);
}

fun function(p: *Printer, f: Function) {
    val got: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, f));
    if (sel got.none) { ret; }
    val s: Symbol = Symbol.function{f};
    printer.newline(p);
    lead(p, s, "function ");
    printer.ty(p, got.some.signature);
    val held: opt[*Body] = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel held.none) { ret; }
    val b: *Body = held.some;
    if (b.blocks.len > 0) {
        printer.text(p, " {");
        printer.newline(p);
        name_values(p, b.values.len);
        var k: usize = 0;
        for (k < b.blocks.len) {
            block(p, f, Block{index: k::u32});
            k = k + 1;
        }
        printer.byte(p, '}');
    }
    printer.newline(p);
    attributes(p, s);
}

# start naming the values of a function of n values from %0
fun name_values(p: *Printer, n: usize) {
    vector.clear[u32](?p.names);
    p.next = 0;
    val room: res[usize, allocator.Error] = vector.reserve[u32](?p.names, n);
    if (sel room.err) {
        printer.fail(p, Error.alloc{room.err});
        ret;
    }
    var i: usize = 0;
    for (i < n) {
        vector.push[u32](?p.names, UNNAMED);
        i = i + 1;
    }
}

fun local(p: *Printer, v: Value) {
    if (v.index::usize >= p.names.len) {
        printer.fail(p, Error.ir{module.Error.value{v}});
        ret;
    }
    if (p.names.data[v.index] == UNNAMED) {
        p.names.data[v.index] = p.next;
        p.next                = p.next + 1;
    }
    printer.byte(p, '%');
    printer.number(p, p.names.data[v.index]::u64);
}

fun operand(p: *Printer, f: Function, v: Value) {
    val got: opt[ValueData] = printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
    if (sel got.none) { ret; }
    val def: Def = got.some.def;
    if (sel def.constant) { printer.constant(p, def.constant); }
    or                    { local(p, v); }
}

fun label(p: *Printer, k: Block) {
    printer.byte(p, '^');
    printer.number(p, k.index::u64);
}

fun block(p: *Printer, f: Function, k: Block) {
    val got: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, k));
    if (sel got.none) { ret; }
    val d: BlockData = got.some;
    label(p, k);
    if (d.parameters.len > 0) {
        printer.byte(p, '(');
        var i: usize = 0;
        for (i < d.parameters.len) {
            if (i > 0) { printer.text(p, ", "); }
            val v: Value = d.parameters.data[i];
            local(p, v);
            printer.text(p, ": ");
            val vd: opt[ValueData] = printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
            if (sel vd.some) {
                if (vd.some.secret) { printer.text(p, "secret "); }
                printer.ty(p, vd.some.type);
            }
            i = i + 1;
        }
        printer.byte(p, ')');
    }
    printer.byte(p, ':');
    printer.newline(p);
    var i: usize = 0;
    for (i < d.instructions.len) {
        instruction(p, f, d.instructions.data[i]);
        i = i + 1;
    }
}

# write the separator before the next entry of an operation
fun next_entry(p: *Printer, first: *bool) {
    if (@first) { printer.byte(p, ' '); }
    or          { printer.text(p, ", "); }
    @first = false;
}

fun ordering(p: *Printer, o: opcode.Ordering) {
    if (sel o.relaxed) { printer.text(p, "relaxed"); }
    or (sel o.acquire) { printer.text(p, "acquire"); }
    or (sel o.release) { printer.text(p, "release"); }
    or (sel o.acq_rel) { printer.text(p, "acq_rel"); }
    or (sel o.seq_cst) { printer.text(p, "seq_cst"); }
}

fun immediate(p: *Printer, imm: opcode.Immediate) {
    if (sel imm.ty)        { printer.ty(p, imm.ty); }
    or (sel imm.alignment) { printer.number(p, imm.alignment); }
    or (sel imm.ordering)  { ordering(p, imm.ordering); }
    or (sel imm.lane)      { printer.number(p, imm.lane::u64); }
    or (sel imm.lanes) {
        printer.byte(p, '[');
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.number(p, imm.lanes.data[i]::u64);
            i = i + 1;
        }
        printer.byte(p, ']');
    }
}

fun instruction(p: *Printer, f: Function, i: Instruction) {
    val got: opt[InstructionData] = printer.from_ir[InstructionData](p, body.instruction_data(p.m, f, i));
    if (sel got.none) { ret; }
    val d:   InstructionData = got.some;
    val row: opt[opcode.Row] = opcode.row(d.opcode);
    if (sel row.none) {
        printer.fail(p, Error.opcode{d.opcode});
        ret;
    }
    val r: opcode.Row = row.some;
    printer.text(p, "    ");
    var k: usize = 0;
    for (k < d.results.len) {
        if (k > 0) { printer.text(p, ", "); }
        local(p, d.results.data[k]);
        k = k + 1;
    }
    if (d.results.len > 0) { printer.text(p, " = "); }
    printer.word(p, r.name);

    var first: bool = true;
    k = 0;
    for (k < d.operands.len) {
        next_entry(p, ?first);
        operand(p, f, d.operands.data[k]);
        k = k + 1;
    }
    k = 0;
    for (k < d.immediates.len) {
        next_entry(p, ?first);
        if (k < opcode.slots(?r)::usize) { printer.word(p, r.immediates[k].name); }
        printer.byte(p, ' ');
        immediate(p, d.immediates.data[k]);
        k = k + 1;
    }
    k = 0;
    for (k < d.edges.len) {
        next_entry(p, ?first);
        val e: Edge = d.edges.data[k];
        label(p, e.block);
        if (e.arguments.len > 0) {
            printer.byte(p, '(');
            var j: usize = 0;
            for (j < e.arguments.len) {
                if (j > 0) { printer.text(p, ", "); }
                operand(p, f, e.arguments.data[j]);
                j = j + 1;
            }
            printer.byte(p, ')');
        }
        k = k + 1;
    }
    metadata(p, d.metadata);
    printer.newline(p);
}

fun metadata(p: *Printer, md: Metadata) {
    if (sel md.location.some) {
        printer.text(p, " loc ");
        printer.location_ref(p, md.location.some);
    }
    if (sel md.site.some) {
        printer.text(p, " site ");
        printer.site_ref(p, md.site.some);
    }
    if (md.flags.volatile)      { printer.text(p, " volatile"); }
    if (md.secret)              { printer.text(p, " secret"); }
    if (md.bindings.index == 0) { ret; }
    val got: opt[Slice[ir_debug.Binding]] = printer.from_ir[Slice[ir_debug.Binding]](p, module.bound(p.m, md.bindings));
    if (sel got.none) { ret; }
    printer.text(p, " bind [");
    var i: usize = 0;
    for (i < got.some.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.variable_ref(p, got.some.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
}

fun intern(m: *Module, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(?m.types, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

test print__quotes_only_names_that_need_it {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, module.Error] = module.init(?a, View{data: "riscv64", len: 7});
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }

    var i32:   [1]Type  = [1]Type{intern(?m, types.Shape.integer{types.Integer{width: 32}})};
    val sig:   Type     = intern(?m, types.Shape.function{types.Function{params: Slice[Type]{data: ?i32[0], size: 1}, results: Slice[Type]{data: ?i32[0], size: 1}}});
    var b:     Builder  = build.init(?m);
    var seven: [1]u64   = [1]u64{7};
    var one:   [1]u64   = [1]u64{1};
    val init:  Constant = build.constant(?b, ConstantData.integer{Bits{type: i32[0], words: Slice[u64]{data: ?seven[0], size: 1}}});
    val inc:   Constant = build.constant(?b, ConstantData.integer{Bits{type: i32[0], words: Slice[u64]{data: ?one[0], size: 1}}});
    build.global(?b, GlobalData{name: View{data: "counter", len: 7}, type: i32[0], initial: opt[Constant].some{init}, linkage: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT});
    build.global(?b, GlobalData{name: View{data: "has space\"", len: 10}, type: i32[0], linkage: ?symbol.LOCAL, visibility: ?symbol.HIDDEN});
    val f: Function = build.function(?b, FunctionData{name: View{data: "f.main_1", len: 8}, signature: sig});
    build.enter(?b, f);
    var decl:  [1]Declaration = [1]Declaration{Declaration{type: i32[0], secret: false}};
    val entry: Block          = build.block(?b, Slice[Declaration]{data: ?decl[0], size: 1});
    build.at_end(?b, entry);
    var sum: [2]Value = [2]Value{build.parameter(?b, entry, 0), build.use_constant(?b, inc)};
    var out: [1]Value = [1]Value{build.value(?b, Request{opcode: opcode.ADD, operands: Slice[Value]{data: ?sum[0], size: 2}})};
    build.emit(?b, Request{opcode: opcode.RET, operands: Slice[Value]{data: ?out[0], size: 1}});
    val done: err[build.Failure] = build.done(?b);
    if (sel done.err) { ret 2; }

    var got: sink.Sink = sink.init(?a);
    fin { sink.dnit(?got); }
    var w:       io.Writer  = sink.writer(?got);
    val printed: err[Error] = print(?w, ?m);
    if (sel printed.err) { ret 3; }

    var want: sink.Sink = sink.init(?a);
    fin { sink.dnit(?want); }
    var ww: io.Writer = sink.writer(?want);
    format.write_str(?ww, "mirl \"");
    format.write_str(?ww, printer.VERSION);
    format.write_str(?ww, "\"\ntarget \"riscv64\"\nglobal @counter: i32 linkage global visibility default = i32 7\nglobal @\"has space\\\"\": i32 linkage local visibility hidden\n\nfunction @f.main_1: fun(i32) -> (i32) {\n^0(%0: i32):\n    %1 = add %0, i32 1\n    ret %1\n}\n");
    if (!slice.same_view(sink.view(?got), sink.view(?want))) { ret 4; }
    ret 0;
}
