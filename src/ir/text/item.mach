# printing a module: its header, typedefs, debug table, globals and functions
#
# an instruction is spelled from its opcode's row alone, and a literal's type
# from the rules of that row, so a new row prints with no change here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str_equals;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mo: masc.core.operand;
use rf: masc.core.register;
use masc.inline.inline;
use mirl.ir.assembly.Assembly;
use AsmOperand: mirl.ir.assembly.Operand;
use mirl.ir.attribute.Attribute;
use mirl.ir.block.BlockData;
use mirl.ir.body;
use mirl.ir.constant.ConstantData;
use ir_debug: mirl.ir.debug;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.function.NO_EXTENSIONS;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.linkage.Linkage;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.native.Op;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.place.Fill;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.point.Run;
use mirl.ir.point.Step;
use mirl.ir.text.debug;
use mirl.ir.text.implied;
use mirl.ir.text.names;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Anchor;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.printer;
use mirl.ir.text.printer.Error;
use mirl.ir.text.printer.Printer;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.ir.value.ValueData;

# the most operands of one instruction whose literals are typed at once
val MAX_TYPED: usize = 64;

# write the text of a module
# ---
# w:   the writer the text goes to
# m:   the module
# ret: ok, or the first failure, after which nothing more was written
pub fun print(w: *io.Writer, m: *Module) err[Error] {
    ret write(w, m, false, nil);
}

# write the text of a module with the comments read beside it, as `fmt`
# writes a file back
# ---
# w:    the writer the text goes to
# m:    the module
# body: write it as a body, with no version statement
# kept: the comments its text was read with, nil for none
# ret:  ok, or the first failure, after which nothing more was written
pub fun print_noted(w: *io.Writer, m: *Module, body: bool, kept: *Notes) err[Error] {
    ret write(w, m, body, kept);
}

fun write(w: *io.Writer, m: *Module, body: bool, kept: *Notes) err[Error] {
    var p: Printer = printer.init(w, m);
    fin { printer.dnit(?p); }
    p.body  = body;
    p.notes = kept;
    printer.prepare(?p);
    printer.header(?p);
    printer.typedefs(?p);
    debug.table(?p);
    var i: usize = 0;
    for (i < m.globals.len) {
        global(?p, Global{index: i::u32});
        i = i + 1;
    }
    i = 0;
    for (i < m.functions.len) {
        function(?p, Function{index: i::u32});
        i = i + 1;
    }
    if (printer.noted(?p, notes.at(notes.END, 0, 0))) {
        printer.apart(?p);
        printer.anchor(?p, notes.at(notes.END, 0, 0), "");
        p.trail = opt[Anchor].none{};
    }
    val failed: opt[Error] = p.failed;
    if (sel failed.some) { ret err[Error].err{failed.some}; }
    ret err[Error].ok{};
}

fun same_symbol(a: Symbol, b: Symbol) bool {
    if (sel a.function) { ret sel b.function && b.function.index == a.function.index; }
    ret sel b.global && b.global.index == a.global.index;
}

fun exported(m: *Module, s: Symbol) bool {
    val list: Slice[Symbol] = module.exports(m);
    var i:    usize         = 0;
    for (i < list.size) {
        if (same_symbol(list.data[i], s)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# write the decorators every symbol may carry: export, binding, visibility and
# the attribute records of a target family
fun decorators(p: *Printer, s: Symbol, l: Linkage, extensions: Slice[View]) {
    if (exported(p.m, s))                     { printer.text(p, "#[export] "); }
    if (str_equals(l.binding.name, "weak"))   { printer.text(p, "#[weak] "); }
    if (str_equals(l.binding.name, "unique")) { printer.text(p, "#[unique] "); }
    if (!str_equals(l.visibility.name, "default")) {
        printer.text(p, "#[visibility(");
        printer.word(p, l.visibility.name);
        printer.text(p, ")] ");
    }
    if (extensions.size > 0) {
        printer.text(p, "#[extensions(");
        var k: usize = 0;
        for (k < extensions.size) {
            if (k > 0) { printer.text(p, ", "); }
            printer.string(p, extensions.data[k]);
            k = k + 1;
        }
        printer.text(p, ")] ");
    }
    val got: opt[Slice[Attribute]] = printer.from_ir[Slice[Attribute]](p, module.attributes(p.m, s));
    if (sel got.none) { ret; }
    var i: usize = 0;
    for (i < got.some.size) {
        val at: Attribute = got.some.data[i];
        printer.text(p, "#[");
        printer.name(p, at.family);
        printer.byte(p, '.');
        printer.name(p, at.name);
        printer.byte(p, '(');
        if (sel at.datum.integer) { printer.number(p, at.datum.integer); }
        or (sel at.datum.integers) {
            printer.byte(p, '[');
            var k: usize = 0;
            for (k < at.datum.integers.size) {
                if (k > 0) { printer.text(p, ", "); }
                printer.number(p, at.datum.integers.data[k]);
                k = k + 1;
            }
            printer.byte(p, ']');
        }
        or (sel at.datum.text) { printer.string(p, at.datum.text); }
        printer.text(p, ")] ");
        i = i + 1;
    }
}

# write the word that opens a symbol's declaration: `ext` for one another
# module defines, `pub` for one other objects may refer to, nothing for a local
fun visible(p: *Printer, l: Linkage, defined: bool) {
    if (!defined)                             { printer.text(p, "ext "); }
    or (!str_equals(l.binding.name, "local")) { printer.text(p, "pub "); }
}

fun tls(p: *Printer, t: Tls) {
    if (sel t.general_dynamic) { printer.text(p, "general_dynamic"); }
    or (sel t.local_dynamic)   { printer.text(p, "local_dynamic"); }
    or (sel t.initial_exec)    { printer.text(p, "initial_exec"); }
    or (sel t.local_exec)      { printer.text(p, "local_exec"); }
}

fun global(p: *Printer, g: Global) {
    val got: opt[GlobalData] = printer.from_ir[GlobalData](p, module.global_data(p.m, g));
    if (sel got.none) { ret; }
    val d: GlobalData = got.some;
    printer.anchor(p, notes.at(notes.GLOBAL, g.index, 0), "");
    if (sel d.alignment.some) {
        printer.text(p, "#[align(");
        printer.number(p, d.alignment.some);
        printer.text(p, ")] ");
    }
    if (sel d.section.some) {
        printer.text(p, "#[section(");
        printer.string(p, d.section.some.name);
        printer.text(p, ", ");
        printer.word(p, d.section.some.kind.name);
        printer.text(p, ")] ");
    }
    if (sel d.tls.some) {
        printer.text(p, "#[tls(");
        tls(p, d.tls.some);
        printer.text(p, ")] ");
    }
    decorators(p, Symbol.global{g}, d.linkage, NO_EXTENSIONS);
    visible(p, d.linkage, sel d.initial.some);
    if (d.constant) { printer.text(p, "val "); }
    or              { printer.text(p, "var "); }
    printer.name(p, d.name);
    printer.text(p, ": ");
    printer.ty(p, d.type);
    if (sel d.initial.some) {
        printer.text(p, " = ");
        printer.literal(p, d.initial.some, opt[Type].some{d.type});
    }
    printer.byte(p, ';');
    printer.newline(p);
    printer.written(p);
}

fun signature_of(p: *Printer, t: Type) opt[types.Function] {
    val got: opt[types.Function] = printer.from_types[types.Function](p, types.signature(?p.m.types, t));
    ret got;
}

fun function(p: *Printer, f: Function) {
    val got: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, f));
    if (sel got.none) { ret; }
    val d:    FunctionData        = got.some;
    val sig:  opt[types.Function] = signature_of(p, d.signature);
    val held: opt[*Body]          = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel sig.none)  { ret; }
    if (sel held.none) { ret; }
    val b:       *Body = held.some;
    val defined: bool  = b.blocks.len > 0;
    printer.apart(p);
    printer.anchor(p, notes.at(notes.FUNCTION, f.index, 0), "");
    if (d.constant_time) { printer.text(p, "#[oblivious] "); }
    if (sig.some.convention.len != 0) {
        printer.text(p, "#[convention(");
        printer.name(p, sig.some.convention);
        printer.text(p, ")] ");
    }
    var placed: bool = false;
    if (sel b.entry.placed) {
        if (defined) {
            placed = true;
            printer.text(p, "#[placed(");
            printer.ty(p, d.signature);
            printer.text(p, ", ");
            places(p, Slice[Placed]{data: b.entry.placed.data, size: b.entry.placed.len});
            printer.text(p, ")] ");
        }
    }
    decorators(p, Symbol.function{f}, d.linkage, d.extensions);
    visible(p, d.linkage, defined);
    printer.text(p, "fun ");
    printer.name(p, d.name);
    printer.byte(p, '(');
    if (defined) {
        start(p, f, b);
        val entry: BlockData = b.blocks.data[0];
        var i:     usize     = 0;
        for (i < entry.parameters.len) {
            if (i > 0) { printer.text(p, ", "); }
            val v: Value = entry.parameters.data[i];
            local(p, f, v);
            printer.text(p, ": ");
            typed(p, f, v);
            if (!placed && i < sig.some.params.size) {
                val e: types.Extension = types.extension(sig.some.param_ext, i);
                if (sel e.sext) { printer.text(p, " sext"); }
                if (sel e.zext) { printer.text(p, " zext"); }
            }
            i = i + 1;
        }
    }
    or {
        var i: usize = 0;
        for (i < sig.some.params.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.parameter(p, sig.some, i);
            i = i + 1;
        }
    }
    printer.byte(p, ')');
    printer.results(p, sig.some);
    if (!defined) {
        printer.byte(p, ';');
        printer.newline(p);
        ret;
    }
    printer.text(p, " {");
    printer.newline(p);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) { block(p, f, Block{index: k::u32}, sig.some.results); }
        k = k + 1;
    }
    printer.anchor(p, notes.at(notes.FUNCTION_END, f.index, 0), "    ");
    printer.byte(p, '}');
    printer.newline(p);
}

# start naming a function's values and name its blocks, in order, all but the
# entry, which no edge leads to and so prints no label
fun start(p: *Printer, f: Function, b: *Body) {
    val values: err[allocator.Error] = names.reset(?p.values, b.values.len);
    if (sel values.err) {
        printer.fail(p, Error.alloc{values.err});
        ret;
    }
    val blocks: err[allocator.Error] = names.reset(?p.blocks, b.blocks.len);
    if (sel blocks.err) {
        printer.fail(p, Error.alloc{blocks.err});
        ret;
    }
    var k: usize = 1;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val given: err[allocator.Error] = names.give(?p.blocks, k::u32, b.blocks.data[k].name);
            if (sel given.err) {
                printer.fail(p, Error.alloc{given.err});
                ret;
            }
        }
        k = k + 1;
    }
}

fun value_data(p: *Printer, f: Function, v: Value) opt[ValueData] {
    ret printer.from_ir[ValueData](p, body.value_data(p.m, f, v));
}

fun local(p: *Printer, f: Function, v: Value) {
    val got: opt[ValueData] = value_data(p, f, v);
    if (sel got.none) { ret; }
    if (!names.given(?p.values, v.index)) {
        val given: err[allocator.Error] = names.give(?p.values, v.index, got.some.name);
        if (sel given.err) {
            printer.fail(p, Error.alloc{given.err});
            ret;
        }
    }
    printer.bytes(p, names.printed(?p.values, v.index));
}

# write a value's type, `^` before it when the value is secret
fun typed(p: *Printer, f: Function, v: Value) {
    val got: opt[ValueData] = value_data(p, f, v);
    if (sel got.none)    { ret; }
    if (got.some.secret) { printer.byte(p, '^'); }
    printer.ty(p, got.some.type);
}

# the constant a value is, none for a parameter or a result
fun constant_of(p: *Printer, f: Function, v: Value) opt[Constant] {
    val got: opt[ValueData] = value_data(p, f, v);
    if (sel got.none) { ret opt[Constant].none{}; }
    val def: Def = got.some.def;
    if (sel def.constant) { ret opt[Constant].some{def.constant}; }
    ret opt[Constant].none{};
}

# write an operand: a value by its name, a constant as a literal of the type
# its place gives it
fun operand(p: *Printer, f: Function, v: Value, implied: opt[Type]) {
    val c: opt[Constant] = constant_of(p, f, v);
    if (sel c.some) { printer.literal(p, c.some, implied); }
    or              { local(p, f, v); }
}

fun label(p: *Printer, k: Block) {
    if (k.index == 0 || k.index::usize >= p.blocks.printed.len) {
        printer.fail(p, Error.ir{module.Error.block{k}});
        ret;
    }
    printer.bytes(p, names.printed(?p.blocks, k.index));
}

fun block(p: *Printer, f: Function, k: Block, returns: Slice[Type]) {
    val got: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, k));
    if (sel got.none) { ret; }
    val d: BlockData = got.some;
    if (k.index != 0) {
        printer.anchor(p, notes.at(notes.BLOCK, f.index, k.index), "");
        label(p, k);
        if (d.parameters.len > 0) {
            printer.byte(p, '(');
            var i: usize = 0;
            for (i < d.parameters.len) {
                if (i > 0) { printer.text(p, ", "); }
                val v: Value = d.parameters.data[i];
                local(p, f, v);
                printer.text(p, ": ");
                typed(p, f, v);
                i = i + 1;
            }
            printer.byte(p, ')');
        }
        printer.byte(p, ':');
        printer.newline(p);
    }
    val held: opt[*Body] = printer.from_ir[*Body](p, module.body(p.m, f));
    if (sel held.none) { ret; }
    var i: usize = 0;
    for (i < d.instructions.len) {
        val at: Instruction = d.instructions.data[i];
        records(p, f, held.some, held.some.instructions.data[at.index].points);
        instruction(p, f, at, returns);
        i = i + 1;
    }
    records(p, f, held.some, d.ending);
}

# the records of a run, in order
fun records(p: *Printer, f: Function, b: *Body, run: Run) {
    var r: u32 = run.first;
    for (r != 0 && printer.ok(p)) {
        val pt: Point = b.points.data[r - 1];
        printer.anchor(p, notes.at(notes.RECORD, f.index, r), "    ");
        record(p, f, pt);
        r = pt.next;
    }
}

# the type of a value, none after keeping the module's refusal
fun type_of(p: *Printer, f: Function, v: Value) opt[Type] {
    val got: opt[ValueData] = value_data(p, f, v);
    if (sel got.none) { ret opt[Type].none{}; }
    ret opt[Type].some{got.some.type};
}

# a value binding record: its variable, its piece, and the operand it reads
# through each step, the innermost step first
fun record(p: *Printer, f: Function, pt: Point) {
    printer.text(p, "    bind ");
    printer.variable_ref(p, pt.binding);
    if (!point.whole(pt.piece)) {
        printer.byte(p, '[');
        printer.number(p, pt.piece.offset::u64);
        printer.text(p, ", ");
        printer.number(p, pt.piece.size::u64);
        printer.byte(p, ']');
    }
    printer.text(p, " = ");
    val reads: Reads = pt.reads;
    if (sel reads.unavailable) {
        printer.text(p, "unavailable;");
        printer.newline(p);
        ret;
    }
    val got: opt[Slice[Step]] = printer.from_ir[Slice[Step]](p, module.steps(p.m, reads.operand.expression));
    if (sel got.none) { ret; }
    val steps: Slice[Step] = got.some;
    var k:     usize       = steps.size;
    for (k > 0) {
        k = k - 1;
        val row: opt[point.Row] = point.row(steps.data[k].kind);
        if (sel row.none) {
            printer.fail(p, Error.ir{module.Error.step{steps.data[k].kind.index}});
            ret;
        }
        printer.word(p, row.some.name);
        val a: point.Argument = steps.data[k].argument;
        if (sel a.to) {
            printer.byte(p, '[');
            printer.ty(p, a.to);
            printer.byte(p, ']');
        }
        printer.byte(p, '(');
    }
    operand(p, f, reads.operand.value, opt[Type].none{});
    var current: opt[Type] = type_of(p, f, reads.operand.value);
    k = 0;
    for (k < steps.size) {
        val a: point.Argument = steps.data[k].argument;
        if (sel a.constant) {
            printer.text(p, ", ");
            printer.literal(p, a.constant, current);
        }
        if (sel a.to) { current = opt[Type].some{a.to}; }
        printer.byte(p, ')');
        k = k + 1;
    }
    printer.byte(p, ';');
    printer.newline(p);
}

fun ordering(p: *Printer, o: opcode.Ordering) {
    if (sel o.relaxed) { printer.text(p, "relaxed"); }
    or (sel o.acquire) { printer.text(p, "acquire"); }
    or (sel o.release) { printer.text(p, "release"); }
    or (sel o.acq_rel) { printer.text(p, "acq_rel"); }
    or (sel o.seq_cst) { printer.text(p, "seq_cst"); }
}

# write how a place is filled past its piece
pub fun fill(p: *Printer, f: Fill) {
    if (sel f.exact)     { printer.text(p, "exact"); }
    or (sel f.undefined) { printer.text(p, "undefined"); }
    or (sel f.sign) {
        printer.text(p, "sign(");
        printer.number(p, f.sign::u64);
        printer.byte(p, ')');
    }
    or (sel f.zero) {
        printer.text(p, "zero(");
        printer.number(p, f.zero::u64);
        printer.byte(p, ')');
    }
    or (sel f.boxed) { printer.text(p, "boxed"); }
    or (sel f.declared) {
        printer.text(p, "declared(");
        printer.number(p, f.declared::u64);
        printer.byte(p, ')');
    }
}

# write a bracketed list of places
fun places(p: *Printer, list: Slice[Placed]) {
    printer.byte(p, '[');
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        val at: Placed = list.data[i];
        printer.byte(p, '{');
        if (sel at.place.register) {
            printer.text(p, "reg(");
            printer.number(p, rf.class_of(at.place.register)::u64);
            printer.text(p, ", ");
            printer.number(p, rf.number_of(at.place.register)::u64);
            printer.byte(p, ')');
        }
        or (sel at.place.stack) {
            printer.text(p, "stack(");
            printer.number(p, at.place.stack.offset);
            if (sel at.place.stack.scale.scaled) {
                printer.text(p, ", scaled ");
                printer.number(p, at.place.stack.scale.scaled::u64);
            }
            printer.byte(p, ')');
        }
        or (sel at.place.operand) {
            printer.text(p, "operand(");
            printer.number(p, at.place.operand::u64);
            printer.byte(p, ')');
        }
        if (sel at.scale.scaled) {
            printer.text(p, ", scaled(");
            printer.number(p, at.scale.scaled::u64);
            printer.byte(p, ')');
        }
        or { printer.text(p, ", fixed"); }
        printer.text(p, ", ");
        fill(p, at.fill);
        printer.byte(p, '}');
        i = i + 1;
    }
    printer.byte(p, ']');
}

fun numbers(p: *Printer, list: Slice[u64]) {
    printer.byte(p, '[');
    var i: usize = 0;
    for (i < list.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.number(p, list.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
}

# write a target op: its set, its op, its result types, and what it declares
# it reads and writes of memory
fun target_op(p: *Printer, o: *Op) {
    printer.text(p, "op(");
    printer.string(p, o.set);
    printer.text(p, ", ");
    printer.string(p, o.name);
    printer.text(p, ", [");
    var i: usize = 0;
    for (i < o.results.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.ty(p, o.results.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
    if (o.reads)  { printer.text(p, ", reads"); }
    if (o.writes) { printer.text(p, ", writes"); }
    printer.byte(p, ')');
}

fun role_word(p: *Printer, r: mo.Role) {
    if (r == mo.READ)       { printer.text(p, "in"); }
    or (r == mo.WRITE)      { printer.text(p, "out"); }
    or (r == mo.READ_WRITE) { printer.text(p, "inout"); }
    or                      { printer.text(p, "none"); }
}

# write an inline assembly block: its text, its operands each with its role,
# constraint and type, and what it declares it reads and writes of memory
fun assembled(p: *Printer, b: *Assembly) {
    printer.string(p, b.text);
    printer.text(p, " {");
    var i: usize = 0;
    for (i < b.operands.size) {
        if (i > 0) { printer.text(p, ", "); }
        val o: *AsmOperand = ?b.operands.data[i];
        printer.name(p, o.name);
        printer.text(p, ": ");
        role_word(p, o.role);
        val c: inline.Constraint = o.constraint;
        if (sel c.class) {
            printer.text(p, " reg(");
            printer.number(p, c.class::u64);
            printer.byte(p, ')');
        }
        or (sel c.memory) { printer.text(p, " mem"); }
        or (sel c.immediate) {
            printer.text(p, " imm(");
            printer.number(p, c.immediate.bits::u64);
            if (c.immediate.signed)   { printer.text(p, ", signed"); }
            or                        { printer.text(p, ", unsigned"); }
            if (c.immediate.symbolic) { printer.text(p, ", symbolic"); }
            printer.byte(p, ')');
        }
        printer.byte(p, ' ');
        printer.ty(p, o.ty);
        i = i + 1;
    }
    printer.byte(p, '}');
    if (b.reads)  { printer.text(p, " reads"); }
    if (b.writes) { printer.text(p, " writes"); }
}

# write what a slot holds
fun immediate(p: *Printer, k: *implied.Known, imm: Immediate, slot: u32) {
    if (sel imm.ty)        { printer.ty(p, imm.ty); }
    or (sel imm.alignment) { printer.number(p, imm.alignment); }
    or (sel imm.ordering)  { ordering(p, imm.ordering); }
    or (sel imm.lane)      { printer.number(p, imm.lane::u64); }
    or (sel imm.lanes) {
        printer.byte(p, '[');
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (i > 0) { printer.text(p, ", "); }
            printer.number(p, imm.lanes.data[i]::u64);
            i = i + 1;
        }
        printer.byte(p, ']');
    }
    or (sel imm.named) {
        if (sel imm.named.first) { printer.number(p, imm.named.first::u64); }
        or (sel imm.named.all)   { printer.text(p, "all"); }
        or                       { printer.fail(p, Error.ir{module.Error.typing{opcode.Error.named{slot}}}); }
    }
    or (sel imm.places) { places(p, imm.places); }
    or (sel imm.member) {
        val agg:   opt[Type] = implied.member_aggregate(k, slot);
        var named: opt[View] = opt[View].none{};
        if (sel agg.some)   { named = printer.member_name(p, agg.some, imm.member); }
        if (sel named.some) { printer.bytes(p, named.some); }
        or                  { printer.number(p, imm.member::u64); }
    }
    or (sel imm.cases)    { numbers(p, imm.cases); }
    or (sel imm.function) { printer.symbol(p, Symbol.function{imm.function}); }
    or (sel imm.assembly) { assembled(p, imm.assembly); }
    or (sel imm.op)       { target_op(p, imm.op); }
}

# the function a callee operand names directly, its address with no offset
fun direct(p: *Printer, f: Function, v: Value) opt[Function] {
    val c: opt[Constant] = constant_of(p, f, v);
    if (sel c.none) { ret opt[Function].none{}; }
    val got: opt[ConstantData] = printer.from_ir[ConstantData](p, module.constant_data(p.m, c.some));
    if (sel got.none) { ret opt[Function].none{}; }
    val d: ConstantData = got.some;
    if (!(sel d.address))                          { ret opt[Function].none{}; }
    if (d.address.offset != 0)                     { ret opt[Function].none{}; }
    if (!printer.plain_pointer(p, d.address.type)) { ret opt[Function].none{}; }
    val s: Symbol = d.address.symbol;
    if (sel s.function) { ret opt[Function].some{s.function}; }
    ret opt[Function].none{};
}

# whether the text leaves the immediate at a slot out
fun left_out(p: *Printer, f: Function, d: *InstructionData, k: *implied.Known, slot: u32, callee: opt[Function]) bool {
    val holds: opcode.Holds = k.row.immediates[slot].holds;
    val imm:   Immediate    = d.immediates.data[slot];
    if (sel holds.cases) { ret true; }
    if (sel imm.named)   { ret sel imm.named.all; }
    if (sel imm.alignment) {
        val t: opt[Type] = implied.accessed(k.row, k.immediates, k.operands);
        if (sel t.none) { ret false; }
        val n: opt[u64] = implied.natural(p.m, t.some);
        ret sel n.some && n.some == imm.alignment;
    }
    if (sel imm.ty) {
        if (sel callee.some) {
            if (implied.signature_slot(k.row, slot)) {
                val fd: opt[FunctionData] = printer.from_ir[FunctionData](p, module.function_data(p.m, callee.some));
                if (sel fd.some) { ret types.same(fd.some.signature, imm.ty); }
            }
        }
    }
    ret false;
}

# write the decorators of an instruction: its flags, and its secrecy where its
# row and its results do not state it
fun flags(p: *Printer, f: Function, d: *InstructionData, r: *opcode.Row) {
    val md: Metadata = d.metadata;
    if (md.flags.volatile) { printer.text(p, "#[volatile] "); }
    if (md.flags.kept)     { printer.text(p, "#[kept] "); }
    if (md.flags.bounded)  { printer.text(p, "#[bounded] "); }
    if (md.flags.checked)  { printer.text(p, "#[checked] "); }
    if (!md.secret)        { ret; }
    var shown: bool = false;
    if (sel r.secrecy.declared) {
        var i: usize = 0;
        for (i < d.results.len) {
            val v: opt[ValueData] = value_data(p, f, d.results.data[i]);
            if (sel v.some) {
                if (v.some.secret) { shown = true; }
            }
            i = i + 1;
        }
    }
    if (!shown) { printer.text(p, "#[secret] "); }
}

fun instruction(p: *Printer, f: Function, i: Instruction, returns: Slice[Type]) {
    val got: opt[InstructionData] = printer.from_ir[InstructionData](p, body.instruction_data(p.m, f, i));
    if (sel got.none) { ret; }
    var d:   InstructionData = got.some;
    val row: opt[opcode.Row] = opcode.row(d.opcode);
    if (sel row.none) {
        printer.fail(p, Error.opcode{d.opcode});
        ret;
    }
    var r: opcode.Row = row.some;
    if (d.operands.len > MAX_TYPED) {
        printer.fail(p, Error.form{"an instruction of more operands than the printer types at once"});
        ret;
    }

    # type the operands: values by their own type, literals by the rows
    var known:   [64]opt[Type];
    var actual:  [64]opt[Type];
    var settled: [64]bool;
    var n:       usize = 0;
    for (n < d.operands.len) {
        val v: Value         = d.operands.data[n];
        val c: opt[Constant] = constant_of(p, f, v);
        settled[n] = false;
        if (sel c.some) {
            known[n]  = opt[Type].none{};
            actual[n] = printer.constant_type(p, c.some);
        }
        or {
            known[n]  = type_of(p, f, v);
            actual[n] = opt[Type].none{};
        }
        n = n + 1;
    }
    var outs: [2]Type;
    var o:    usize = 0;
    for (o < d.results.len && o < 2) {
        val t: opt[Type] = type_of(p, f, d.results.data[o]);
        if (sel t.some) { outs[o] = t.some; }
        o = o + 1;
    }
    var k: implied.Known = implied.Known{
        m:          p.m,
        row:        ?r,
        operands:   Slice[opt[Type]]{data: ?known[0], size: n},
        immediates: Slice[Immediate]{data: d.immediates.data, size: d.immediates.len},
        returns:    returns,
        results:    Slice[Type]{data: ?outs[0], size: o},
    };
    implied.settle(?k, Slice[opt[Type]]{data: ?actual[0], size: n}, ?settled[0]);

    printer.anchor(p, notes.at(notes.INSTRUCTION, f.index, i.index), "    ");
    printer.text(p, "    ");
    flags(p, f, ?d, ?r);
    if (d.results.len > 0) {
        printer.text(p, "val ");
        if (d.results.len > 1) { printer.byte(p, '('); }
        var j: usize = 0;
        for (j < d.results.len) {
            if (j > 0) { printer.text(p, ", "); }
            local(p, f, d.results.data[j]);
            printer.text(p, ": ");
            typed(p, f, d.results.data[j]);
            j = j + 1;
        }
        if (d.results.len > 1) { printer.byte(p, ')'); }
        printer.text(p, " = ");
    }
    printer.word(p, r.name);

    val at_callee: opt[u32]      = implied.callee_of(?r);
    var callee:    opt[Function] = opt[Function].none{};
    if (sel at_callee.some) {
        if (at_callee.some::usize < d.operands.len) { callee = direct(p, f, d.operands.data[at_callee.some]); }
    }

    # the immediates, the first bare and the others by their slot's name
    var open: bool = false;
    var s:    u32  = 0;
    for (s::usize < d.immediates.len) {
        if (!left_out(p, f, ?d, ?k, s, callee)) {
            if (open) { printer.text(p, ", "); }
            or        { printer.byte(p, '['); }
            open = true;
            if (!implied.bare(r.immediates[s].holds, s) && s < opcode.slots(?r)) {
                printer.word(p, r.immediates[s].name);
                printer.text(p, ": ");
            }
            immediate(p, ?k, d.immediates.data[s], s);
        }
        s = s + 1;
    }
    if (open) { printer.byte(p, ']'); }

    # the callee, bare when it is a function of the module
    if (sel at_callee.some) {
        printer.byte(p, ' ');
        if (sel callee.some) { printer.symbol(p, Symbol.function{callee.some}); }
        or                   { operand(p, f, d.operands.data[at_callee.some], known[at_callee.some]); }
    }

    # the other operands, left out when there are none and there are targets
    var shown: usize = d.operands.len;
    if (sel at_callee.some) { shown = shown - 1; }
    if (shown > 0 || d.edges.len == 0) {
        printer.byte(p, '(');
        var first: bool  = true;
        var j:     usize = 0;
        for (j < d.operands.len) {
            var skip: bool = false;
            if (sel at_callee.some) { skip = j == at_callee.some::usize; }
            if (!skip) {
                if (!first) { printer.text(p, ", "); }
                first = false;
                var implied_type: opt[Type] = opt[Type].none{};
                if (settled[j]) { implied_type = known[j]; }
                operand(p, f, d.operands.data[j], implied_type);
            }
            j = j + 1;
        }
        printer.byte(p, ')');
    }

    # the targets, each after the first leading with its case value when the
    # row states a case list
    var cases: opt[Slice[u64]] = opt[Slice[u64]].none{};
    var c:     usize           = 0;
    for (c < d.immediates.len) {
        val imm: Immediate = d.immediates.data[c];
        if (sel imm.cases) { cases = opt[Slice[u64]].some{imm.cases}; }
        c = c + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        if (e == 0) { printer.byte(p, ' '); }
        or          { printer.text(p, ", "); }
        if (sel cases.some) {
            if (e > 0 && e - 1 < cases.some.size) {
                printer.number(p, cases.some.data[e - 1]);
                printer.text(p, ": ");
            }
        }
        edge(p, f, d.edges.data[e]);
        e = e + 1;
    }
    metadata(p, d.metadata);
    printer.byte(p, ';');
    printer.newline(p);
}

fun edge(p: *Printer, f: Function, e: Edge) {
    label(p, e.block);
    if (e.arguments.len == 0) { ret; }
    val target: opt[BlockData] = printer.from_ir[BlockData](p, body.block_data(p.m, f, e.block));
    if (sel target.none) { ret; }
    printer.byte(p, '(');
    var j: usize = 0;
    for (j < e.arguments.len) {
        if (j > 0) { printer.text(p, ", "); }
        var implied_type: opt[Type] = opt[Type].none{};
        if (j < target.some.parameters.len) { implied_type = type_of(p, f, target.some.parameters.data[j]); }
        operand(p, f, e.arguments.data[j], implied_type);
        j = j + 1;
    }
    printer.byte(p, ')');
}

# write the location, inlining site and debug bindings of an instruction, each
# left out when empty
pub fun metadata(p: *Printer, md: Metadata) {
    if (sel md.location.some) {
        printer.text(p, " at ");
        printer.location_ref(p, md.location.some);
    }
    if (sel md.site.some) {
        printer.text(p, " in ");
        printer.site_ref(p, md.site.some);
    }
    if (md.bindings.index == 0) { ret; }
    val got: opt[Slice[ir_debug.Binding]] = printer.from_ir[Slice[ir_debug.Binding]](p, module.bound(p.m, md.bindings));
    if (sel got.none) { ret; }
    printer.text(p, " holds [");
    var i: usize = 0;
    for (i < got.some.size) {
        if (i > 0) { printer.text(p, ", "); }
        printer.variable_ref(p, got.some.data[i]);
        i = i + 1;
    }
    printer.byte(p, ']');
}
