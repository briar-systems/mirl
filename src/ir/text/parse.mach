# reading the text form of a module
#
# a text is read in passes over saved positions. the first reads each
# statement and declares what it names: typedefs, the debug table, then
# globals and functions without their initial values or bodies, so every
# symbol exists before one is named. the next reads the initial values, and
# the last builds the function bodies.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use mirl.ir.language;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.parse.body;
use mirl.ir.text.parse.debug;
use mirl.ir.text.parse.item;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.printer;

fwd refusal.Named;
fwd refusal.Reason;
fwd refusal.Refusal;
fwd refusal.describe;
fwd refusal.reason;

# the target and language statements of a text
# ---
# at:       its target's first part, where a refusal of the target points
# tuple:    the parts, each a view of the text as its owner spells it
# language: the source language the text states, or none
pub rec Header {
    at:       Token;
    tuple:    module.Tuple;
    language: opt[Stated];
}

# a language statement: its name, a view of the text, and its code
pub rec Stated {
    name:  View;
    dwarf: u16;
}

# read the header: the version statement, which must be this library's when
# the text has one, the target statement, and the language statement when the
# text states one
pub fun header(p: *Parser, versioned: bool) Header {
    if (versioned) {
        state.note(p, p.tok.line, notes.at(notes.VERSION, 0, 0));
        state.expect_word(p, "mirl");
        val v: Token = state.expect(p, lexer.STRING, "a version");
        if (state.ok(p) && !lexer.spelled(v.text, printer.VERSION)) {
            state.fail_at(p, v.line, v.column, Reason.version{v.raw});
        }
        state.expect_end(p);
    }
    or (state.is_word(p, "mirl")) { state.fail(p, Reason.unexpected{"a version statement, which this text must leave out"}); }
    state.note(p, p.tok.line, notes.at(notes.TARGET, 0, 0));
    state.expect_word(p, "target");
    val at:   Token   = p.tok;
    var keys: [5]str  = [5]str{"arch", "sys", "env", "abi", "isa"};
    var got:  [5]Token;
    var seen: [5]bool = [5]bool{false, false, false, false, false};
    state.expect(p, lexer.LBRACE, "{");
    for (state.ok(p) && !state.is(p, lexer.RBRACE)) {
        val k: Token = state.expect(p, lexer.WORD, "a part of the target");
        state.expect(p, lexer.COLON, ":");
        val v:     Token = part(p, "the part's value");
        var found: bool  = false;
        var i:     usize = 0;
        for (i < 5) {
            if (lexer.spelled(k.text, keys[i])) {
                if (seen[i]) { state.fail_at(p, k.line, k.column, Reason.duplicate{Named{what: "part of the target", name: k.raw}}); }
                got[i]  = v;
                seen[i] = true;
                found   = true;
            }
            i = i + 1;
        }
        if (!found)                        { state.fail_at(p, k.line, k.column, Reason.unknown{Named{what: "part of the target", name: k.raw}}); }
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
    state.expect(p, lexer.RBRACE, "}");
    state.expect_end(p);
    var i: usize = 0;
    for (i < 5 && state.ok(p)) {
        if (!seen[i]) { state.fail_at(p, at.line, at.column, Reason.expected{"every part of the target: arch, sys, env, abi and isa"}); }
        i = i + 1;
    }
    if (!state.ok(p)) { ret Header{at: at, tuple: module.Tuple{arch: at.text, sys: at.text, env: at.text, abi: at.text, isa: at.text}, language: opt[Stated].none{}}; }
    ret Header{at: got[0], tuple: module.Tuple{arch: got[0].text, sys: got[1].text, env: got[2].text, abi: got[3].text, isa: got[4].text}, language: stated(p)};
}

# read the language statement when the text has one: a name and its DW_LANG
# code. a name of one of mirl's rows must state its code.
fun stated(p: *Parser) opt[Stated] {
    if (!state.ok(p) || !state.is_word(p, "language")) { ret opt[Stated].none{}; }
    state.note(p, p.tok.line, notes.at(notes.LANGUAGE, 0, 0));
    state.advance(p);
    state.expect(p, lexer.LBRACE, "{");
    state.expect_word(p, "name");
    state.expect(p, lexer.COLON, ":");
    val t: Token = state.expect(p, lexer.STRING, "the source language");
    state.expect(p, lexer.COMMA, ",");
    state.expect_word(p, "code");
    state.expect(p, lexer.COLON, ":");
    val at:   Token = p.tok;
    val code: u64   = state.number(p);
    state.expect(p, lexer.RBRACE, "}");
    state.expect_end(p);
    if (!state.ok(p)) { ret opt[Stated].none{}; }
    if (code > 0xffff) {
        state.fail_at(p, at.line, at.column, Reason.large{});
        ret opt[Stated].none{};
    }
    val found: language.Resolved = language.resolve(t.text, code::u16);
    if (sel found.conflict) {
        state.fail_at(p, at.line, at.column, Reason.unexpected{"a code other than the one mirl's row of the language states"});
        ret opt[Stated].none{};
    }
    ret opt[Stated].some{Stated{name: t.text, dwarf: code::u16}};
}

# read one part of the target, a string that is never empty, since a target
# states every part and none is filled in
fun part(p: *Parser, what: str) Token {
    val t: Token = state.expect(p, lexer.STRING, what);
    if (state.ok(p) && t.text.len == 0) { state.fail_at(p, t.line, t.column, Reason.expected{what}); }
    ret t;
}

# read the statements of the module, declaring what they name
fun statements(p: *Parser, initials: *vector.Vector[item.Initial], described: *vector.Vector[item.Described], bodies: *vector.Vector[item.Body]) {
    for (state.ok(p) && !state.is(p, lexer.END)) {
        if (state.is_word(p, "rec") || state.is_word(p, "uni")) { item.typedef(p); }
        or (state.is_word(p, "debug"))                          { debug.table(p); }
        or                                                      { item.declaration(p, initials, described, bodies); }
    }
}

# read every item of a text into the module the parser is attached to: the
# statements that declare, then the initial values and bodies they left to read
fun items(p: *Parser, a: *allocator.Allocator) {
    var initials:  vector.Vector[item.Initial]   = vector.init[item.Initial](a);
    var bodies:    vector.Vector[item.Body]      = vector.init[item.Body](a);
    var described: vector.Vector[item.Described] = vector.init[item.Described](a);
    fin {
        vector.dnit[item.Initial](?initials);
        vector.dnit[item.Body](?bodies);
        vector.dnit[item.Described](?described);
    }
    statements(p, ?initials, ?described, ?bodies);
    var i: usize = 0;
    for (i < described.len && state.ok(p)) {
        item.describe(p, described.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < initials.len && state.ok(p)) {
        item.initial(p, initials.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < bodies.len && state.ok(p)) {
        body.function(p, bodies.data[i]);
        i = i + 1;
    }
}

# state the language the header read on its module: mirl's row when the name
# and code are one's, or a row the module holds of its own
fun state_header(m: *Module, h: Header) err[module.Error] {
    val stated: opt[Stated] = h.language;
    if (sel stated.none) { ret err[module.Error].ok{}; }
    val found: language.Resolved = language.resolve(stated.some.name, stated.some.dwarf);
    if (sel found.row) {
        module.state_language(m, found.row);
        ret err[module.Error].ok{};
    }
    ret module.adopt_language(m, stated.some.name, stated.some.dwarf);
}

fun read(a: *allocator.Allocator, text: View, versioned: bool, kept: *Notes) res[Module, Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    p.notes = kept;
    val target: Header       = header(?p, versioned);
    val early:  opt[Refusal] = p.failed;
    if (sel early.some) { ret res[Module, Refusal].err{early.some}; }
    val made: res[Module, module.Error] = module.init(a, target.tuple);
    if (sel made.err) {
        ret res[Module, Refusal].err{Refusal{line: target.at.line, column: target.at.column, reason: Reason.ir{made.err}}};
    }
    var m:     Module            = made.ok;
    val given: err[module.Error] = state_header(?m, target);
    if (sel given.err) {
        module.dnit(?m);
        ret res[Module, Refusal].err{Refusal{line: target.at.line, column: target.at.column, reason: Reason.ir{given.err}}};
    }
    state.attach(?p, ?m);
    items(?p, a);
    if (kept != nil && state.ok(?p)) {
        val gathered: err[allocator.Error] = notes.gather(kept, text);
        if (sel gathered.err) { state.refuse_alloc(?p, gathered.err); }
    }
    val failed: opt[Refusal] = p.failed;
    if (sel failed.some) {
        module.dnit(?m);
        ret res[Module, Refusal].err{failed.some};
    }
    ret res[Module, Refusal].ok{m};
}

# read the items of a text into a module that already holds others, as a
# legalisation delivers a function written in the text form
#
# the text has no version or target statement. its names are resolved among the
# module's symbols and its own, and a name the module already holds is
# refused. a refusal leaves what was read before it in the module, so the
# caller takes the module back to a snapshot.
# ---
# m:    the module
# a:    the allocator the reading takes its scratch storage from
# text: the items
# ret:  ok, or the first line refused
pub fun parse_into(m: *Module, a: *allocator.Allocator, text: View) err[Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    state.attach(?p, m);
    items(?p, a);
    val failed: opt[Refusal] = p.failed;
    if (sel failed.some) { ret err[Refusal].err{failed.some}; }
    ret err[Refusal].ok{};
}

# read the text of a module
# ---
# a:    the allocator the module takes its storage from
# text: the text, which a refusal's names are views of
# ret:  the module, which the caller releases, or the first line refused
pub fun parse(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    ret read(a, text, true, nil);
}

# read the text of a module that has no version statement, the entry point of
# the IR text files under test/ir
#
# the text starts with its target statement, and one that starts with a
# version statement is refused. the text is read as it is, so a file stays valid across releases.
# ---
# a:    the allocator the module takes its storage from
# text: the text, which a refusal's names are views of
# ret:  the module, which the caller releases, or the first line refused
pub fun parse_body(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    ret read(a, text, false, nil);
}

# read the text of a module and keep its comments, which `print_noted` writes
# back beside what they were written beside
# ---
# a:         the allocator the module takes its storage from
# text:      the text, which a refusal's names and the notes' comments are
#            views of
# versioned: the text starts with its version statement, else with its target
#            statement as a body does
# kept:      the notes the comments are given to, which the caller made and
#            releases
# ret:       the module, which the caller releases, or the first line refused
pub fun parse_noted(a: *allocator.Allocator, text: View, versioned: bool, kept: *Notes) res[Module, Refusal] {
    ret read(a, text, versioned, kept);
}
