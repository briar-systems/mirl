# reading the text form of a module
#
# a text is read in passes over saved positions. the first reads each line and
# declares what it names: debug entries, then globals and functions without
# their initial values or bodies, so every symbol exists before one is named.
# the next reads the debug types' members, the initial values and attributes,
# and the last builds the function bodies.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use mirl.ir.language;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.parse.body;
use mirl.ir.text.parse.debug;
use mirl.ir.text.parse.item;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.printer;

fwd refusal.Named;
fwd refusal.Reason;
fwd refusal.Refusal;
fwd refusal.describe;
fwd refusal.reason;

# the target and language lines of a text
# ---
# at:       its target's first part, where a refusal of the target points
# tuple:    the parts, each a view of the text as its owner spells it
# language: the source language the text states, or none
pub rec Header {
    at:       Token;
    tuple:    module.Tuple;
    language: opt[Stated];
}

# a language line: its name, a view of the text, and its code
pub rec Stated {
    name:  View;
    dwarf: u16;
}

# read the header: the version line, which must be this library's when the text
# has one, the target line, the parts of its tuple in order, and the language
# line when the text states one
pub fun header(p: *Parser, versioned: bool) Header {
    if (versioned) {
        state.expect_word(p, "mirl");
        val v: Token = state.expect(p, lexer.STRING, "a version");
        if (state.ok(p) && !lexer.spelled(v.text, printer.VERSION)) {
            state.fail_at(p, v.line, v.column, Reason.version{v.raw});
        }
        state.expect_end(p);
    }
    or (state.is_word(p, "mirl")) { state.fail(p, Reason.unexpected{"a version line, which this text must leave out"}); }
    state.expect_word(p, "target");
    val arch:       Token = part(p, "the target's architecture");
    val system:     Token = part(p, "the target's system");
    val env:        Token = part(p, "the target's environment");
    val convention: Token = part(p, "the target's convention");
    val baseline:   Token = part(p, "the target's baseline");
    state.expect_end(p);
    ret Header{at: arch, tuple: module.Tuple{arch: arch.text, system: system.text, env: env.text, convention: convention.text, baseline: baseline.text}, language: stated(p)};
}

# read the language line when the text has one, after any blank lines: a name
# and its DW_LANG code. a name of one of mirl's rows must state its code.
fun stated(p: *Parser) opt[Stated] {
    for (state.ok(p) && state.accept(p, lexer.NEWLINE)) {}
    if (!state.ok(p) || !state.accept_word(p, "language")) { ret opt[Stated].none{}; }
    val t:    Token = state.expect(p, lexer.STRING, "the source language");
    val at:   Token = p.tok;
    val code: u64   = state.number(p);
    if (!state.ok(p)) { ret opt[Stated].none{}; }
    if (code > 0xffff) {
        state.fail_at(p, at.line, at.column, Reason.large{});
        ret opt[Stated].none{};
    }
    val found: language.Resolved = language.resolve(t.text, code::u16);
    if (sel found.conflict) {
        state.fail_at(p, at.line, at.column, Reason.unexpected{"a code other than the one mirl's row of the language states"});
        ret opt[Stated].none{};
    }
    state.expect_end(p);
    ret opt[Stated].some{Stated{name: t.text, dwarf: code::u16}};
}

# read one part of the target line, a string that is never empty, since a
# target states every part and none is filled in
fun part(p: *Parser, what: str) Token {
    val t: Token = state.expect(p, lexer.STRING, what);
    if (state.ok(p) && t.text.len == 0) { state.fail_at(p, t.line, t.column, Reason.expected{what}); }
    ret t;
}

# read the lines of the module, declaring what they name
fun lines(p: *Parser, pending: *vector.Vector[debug.Pending], initials: *vector.Vector[item.Initial], bodies: *vector.Vector[item.Body], attributes: *vector.Vector[Mark]) {
    for (state.ok(p) && !state.is(p, lexer.END)) {
        if (state.accept(p, lexer.NEWLINE)) {}
        or (state.is(p, lexer.DREF))        { debug.line(p, pending); }
        or (state.is_word(p, "attribute")) {
            state.push[Mark](p, attributes, state.mark(p));
            state.skip_line(p);
            state.expect_end(p);
        }
        or {
            val exported: bool = state.accept_word(p, "export");
            if (state.is_word(p, "global"))   { item.global(p, exported, initials); }
            or (state.is_word(p, "function")) { item.function(p, exported, bodies); }
            or                                { state.expected(p, "an item"); }
        }
    }
}

# read every item of a text into the module the parser is attached to: the
# lines that declare, then the debug entries, initial values, attributes and
# bodies they left to read
fun items(p: *Parser, a: *allocator.Allocator) {
    var pending:    vector.Vector[debug.Pending] = vector.init[debug.Pending](a);
    var initials:   vector.Vector[item.Initial]  = vector.init[item.Initial](a);
    var bodies:     vector.Vector[item.Body]     = vector.init[item.Body](a);
    var attributes: vector.Vector[Mark]          = vector.init[Mark](a);
    fin {
        vector.dnit[debug.Pending](?pending);
        vector.dnit[item.Initial](?initials);
        vector.dnit[item.Body](?bodies);
        vector.dnit[Mark](?attributes);
    }
    lines(p, ?pending, ?initials, ?bodies, ?attributes);
    if (state.ok(p)) { debug.define_all(p, ?pending); }
    var i: usize = 0;
    for (i < initials.len && state.ok(p)) {
        item.initial(p, initials.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < attributes.len && state.ok(p)) {
        item.attribute(p, attributes.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < bodies.len && state.ok(p)) {
        body.function(p, bodies.data[i].function, bodies.data[i].at, bodies.data[i].placed);
        i = i + 1;
    }
}

# state the language the header read on its module: mirl's row when the name
# and code are one's, or a row the module holds of its own
fun state_header(m: *Module, h: Header) err[module.Error] {
    val stated: opt[Stated] = h.language;
    if (sel stated.none) { ret err[module.Error].ok{}; }
    val found: language.Resolved = language.resolve(stated.some.name, stated.some.dwarf);
    if (sel found.row) {
        module.state_language(m, found.row);
        ret err[module.Error].ok{};
    }
    ret module.adopt_language(m, stated.some.name, stated.some.dwarf);
}

fun read(a: *allocator.Allocator, text: View, versioned: bool) res[Module, Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    val target: Header       = header(?p, versioned);
    val early:  opt[Refusal] = p.failed;
    if (sel early.some) { ret res[Module, Refusal].err{early.some}; }
    val made: res[Module, module.Error] = module.init(a, target.tuple);
    if (sel made.err) {
        ret res[Module, Refusal].err{Refusal{line: target.at.line, column: target.at.column, reason: Reason.ir{made.err}}};
    }
    var m:     Module            = made.ok;
    val given: err[module.Error] = state_header(?m, target);
    if (sel given.err) {
        module.dnit(?m);
        ret res[Module, Refusal].err{Refusal{line: target.at.line, column: target.at.column, reason: Reason.ir{given.err}}};
    }
    state.attach(?p, ?m);
    items(?p, a);
    val failed: opt[Refusal] = p.failed;
    if (sel failed.some) {
        module.dnit(?m);
        ret res[Module, Refusal].err{failed.some};
    }
    ret res[Module, Refusal].ok{m};
}

# read the items of a text into a module that already holds others, as a
# legalisation delivers a function written in the text form
#
# the text has no version or target line. its names are resolved among the
# module's symbols and its own, and a name the module already holds is
# refused. a refusal leaves what was read before it in the module, so the
# caller takes the module back to a snapshot.
# ---
# m:    the module
# a:    the allocator the reading takes its scratch storage from
# text: the items
# ret:  ok, or the first line refused
pub fun parse_into(m: *Module, a: *allocator.Allocator, text: View) err[Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    state.attach(?p, m);
    items(?p, a);
    val failed: opt[Refusal] = p.failed;
    if (sel failed.some) { ret err[Refusal].err{failed.some}; }
    ret err[Refusal].ok{};
}

# read the text of a module
# ---
# a:    the allocator the module takes its storage from
# text: the text, which a refusal's names are views of
# ret:  the module, which the caller releases, or the first line refused
pub fun parse(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    ret read(a, text, true);
}

# read the text of a module that has no version line, the entry point of the
# IR text files under test/ir
#
# the text starts with its target line, and one that starts with a version line
# is refused. the text is read as it is, so a file stays valid across releases.
# ---
# a:    the allocator the module takes its storage from
# text: the text, which a refusal's names are views of
# ret:  the module, which the caller releases, or the first line refused
pub fun parse_body(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    ret read(a, text, false);
}
