# reading the text form of a module
#
# a text is read in passes over saved positions. the first reads each line and
# declares what it names: debug entries, then globals and functions without
# their initial values or bodies, so every symbol exists before one is named.
# the next reads the debug types' members, the initial values and attributes,
# and the last builds the function bodies.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.filesystem;
use std.format;
use io: std.io.writer;
use std.print;

use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use printing: mirl.ir.text.item;
use mirl.ir.text.parse.body;
use mirl.ir.text.parse.debug;
use mirl.ir.text.parse.item;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.slice;

fwd refusal.Named;
fwd refusal.Reason;
fwd refusal.Refusal;
fwd refusal.describe;

# read the header: the version line, which must be this library's, and the target
fun header(p: *Parser) Token {
    state.expect_word(p, "mirl");
    val v: Token = state.expect(p, lexer.STRING, "a version");
    if (state.ok(p) && !lexer.spelled(v.text, printer.VERSION)) {
        state.fail_at(p, v.line, v.column, Reason.version{v.raw});
    }
    state.expect_end(p);
    state.expect_word(p, "target");
    val t: Token = state.expect(p, lexer.STRING, "a target");
    state.expect_end(p);
    ret t;
}

# read the lines of the module, declaring what they name
fun lines(p: *Parser, pending: *vector.Vector[debug.Pending], initials: *vector.Vector[item.Initial], bodies: *vector.Vector[item.Body], attributes: *vector.Vector[Mark]) {
    for (state.ok(p) && !state.is(p, lexer.END)) {
        if (state.accept(p, lexer.NEWLINE)) {}
        or (state.is(p, lexer.DREF))        { debug.line(p, pending); }
        or (state.is_word(p, "attribute")) {
            state.push[Mark](p, attributes, state.mark(p));
            state.skip_line(p);
            state.expect_end(p);
        }
        or {
            val exported: bool = state.accept_word(p, "export");
            if (state.is_word(p, "global"))   { item.global(p, exported, initials); }
            or (state.is_word(p, "function")) { item.function(p, exported, bodies); }
            or                                { state.expected(p, "an item"); }
        }
    }
}

# read the text of a module
# ---
# a:    the allocator the module takes its storage from
# text: the text, whose bytes need only live as long as the call
# ret:  the module, which the caller releases, or the first line refused
pub fun parse(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    var p: Parser;
    state.init(?p, a, text);
    fin { state.dnit(?p); }
    val target: Token        = header(?p);
    val early:  opt[Refusal] = p.failed;
    if (sel early.some) { ret res[Module, Refusal].err{early.some}; }
    val made: res[Module, module.Error] = module.init(a, target.text);
    if (sel made.err) {
        ret res[Module, Refusal].err{Refusal{line: target.line, column: target.column, reason: Reason.ir{made.err}}};
    }
    var m: Module = made.ok;
    state.attach(?p, ?m);

    var pending:    vector.Vector[debug.Pending] = vector.init[debug.Pending](a);
    var initials:   vector.Vector[item.Initial]  = vector.init[item.Initial](a);
    var bodies:     vector.Vector[item.Body]     = vector.init[item.Body](a);
    var attributes: vector.Vector[Mark]          = vector.init[Mark](a);
    fin {
        vector.dnit[debug.Pending](?pending);
        vector.dnit[item.Initial](?initials);
        vector.dnit[item.Body](?bodies);
        vector.dnit[Mark](?attributes);
    }
    lines(?p, ?pending, ?initials, ?bodies, ?attributes);
    if (state.ok(?p)) { debug.define_all(?p, ?pending); }
    var i: usize = 0;
    for (i < initials.len && state.ok(?p)) {
        item.initial(?p, initials.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < attributes.len && state.ok(?p)) {
        item.attribute(?p, attributes.data[i]);
        i = i + 1;
    }
    i = 0;
    for (i < bodies.len && state.ok(?p)) {
        body.function(?p, bodies.data[i].function, bodies.data[i].at);
        i = i + 1;
    }
    val failed: opt[Refusal] = p.failed;
    if (sel failed.some) {
        module.dnit(?m);
        ret res[Module, Refusal].err{failed.some};
    }
    ret res[Module, Refusal].ok{m};
}

# read the text of a module whose version line is left out, the entry point of
# the IR text files under test/ir
#
# the library's own version line is put before the text, so a file stays valid
# across releases, and a line of a refusal counts the file's lines. a text that
# starts with a version line of its own is refused.
# ---
# a:    the allocator the module takes its storage from
# text: the text without its version line
# ret:  the module, which the caller releases, or the first line refused
pub fun parse_body(a: *allocator.Allocator, text: View) res[Module, Refusal] {
    var owned: vector.Vector[View] = vector.init[View](a);
    fin { vector.dnit[View](?owned); }
    var lx:    lexer.Lexer = lexer.init(text, a, ?owned);
    val first: Token       = lexer.next(?lx);
    if (first.kind == lexer.WORD && lexer.spelled(first.text, "mirl")) {
        ret res[Module, Refusal].err{Refusal{line: first.line, column: first.column, reason: Reason.unexpected{"a version line, which this text must leave out"}}};
    }
    var joined: sink.Sink = sink.init(a);
    fin { sink.dnit(?joined); }
    var w: io.Writer = sink.writer(?joined);
    format.write_str(?w, "mirl \"");
    format.write_str(?w, printer.VERSION);
    format.write_str(?w, "\"\n");
    format.write_bytes(?w, text.data, text.len);
    var r: res[Module, Refusal] = parse(a, sink.view(?joined));
    if (sel r.err) {
        var e: Refusal = r.err;
        if (e.line > 1) { e.line = e.line - 1; }
        ret res[Module, Refusal].err{e};
    }
    ret res[Module, Refusal].ok{r.ok};
}

# the header every test text starts with
fun open(s: *sink.Sink, version: str) {
    var w: io.Writer = sink.writer(s);
    format.write_str(?w, "mirl \"");
    format.write_str(?w, version);
    format.write_str(?w, "\"\ntarget \"riscv64\"\n");
}

fun add(s: *sink.Sink, body: str) {
    var w: io.Writer = sink.writer(s);
    format.write_str(?w, body);
}

# the refusal of a text, or none when it is read
fun refusal_of(a: *allocator.Allocator, text: View) opt[Refusal] {
    var r: res[Module, Refusal] = parse(a, text);
    if (sel r.ok) {
        var m: Module = r.ok;
        module.dnit(?m);
        ret opt[Refusal].none{};
    }
    ret opt[Refusal].some{r.err};
}

test parse__refuses_a_malformed_line_with_its_location {
    var a: allocator.Allocator;
    page.make(?a);
    var text: sink.Sink = sink.init(?a);
    fin { sink.dnit(?text); }
    open(?text, printer.VERSION);
    add(?text, "\nglobal @g: i32 linkage global visibility default = i32 1\nglobal @h: i32 linkage global visibility default = i32 $\n");
    val got: opt[Refusal] = refusal_of(?a, sink.view(?text));
    if (sel got.none)                                { ret 1; }
    if (got.some.line != 5 || got.some.column != 56) { ret 2; }
    if (!(sel got.some.reason.unexpected))           { ret 3; }

    var cut: sink.Sink = sink.init(?a);
    fin { sink.dnit(?cut); }
    open(?cut, printer.VERSION);
    add(?cut, "global @g: i32 linkage\n");
    val short: opt[Refusal] = refusal_of(?a, sink.view(?cut));
    if (sel short.none)                                  { ret 4; }
    if (short.some.line != 3 || short.some.column != 23) { ret 5; }
    if (!(sel short.some.reason.expected))               { ret 6; }
    ret 0;
}

test parse__refuses_a_version_that_is_not_the_librarys {
    var a: allocator.Allocator;
    page.make(?a);
    var text: sink.Sink = sink.init(?a);
    fin { sink.dnit(?text); }
    open(?text, "0.0.0-other");
    val got: opt[Refusal] = refusal_of(?a, sink.view(?text));
    if (sel got.none)                                                                      { ret 1; }
    if (got.some.line != 1 || got.some.column != 6)                                        { ret 2; }
    if (!(sel got.some.reason.version))                                                    { ret 3; }
    if (!slice.same_view(got.some.reason.version, View{data: "\"0.0.0-other\"", len: 13})) { ret 4; }

    var other: sink.Sink = sink.init(?a);
    fin { sink.dnit(?other); }
    add(?other, "target \"riscv64\"\n");
    val bare: opt[Refusal] = refusal_of(?a, sink.view(?other));
    if (sel bare.none) { ret 5; }
    ret 0;
}

val FORWARD: str = "function @f: fun(i32) -> (ptr) {\n^entry(%a: i32):\n    %r = add %c, %a\n    %c = add %a, %a\n    br ^out(ptr @g)\n^out(%p: ptr):\n    ret %p\n}\nglobal @g: ptr linkage global visibility default = ptr @h + 8\nglobal @h: i32 linkage global visibility default\n";

test parse__resolves_a_forward_reference_and_refuses_an_unresolved_one {
    var a: allocator.Allocator;
    page.make(?a);
    var text: sink.Sink = sink.init(?a);
    fin { sink.dnit(?text); }
    open(?text, printer.VERSION);
    add(?text, FORWARD);
    var r: res[Module, Refusal] = parse(?a, sink.view(?text));
    if (sel r.err) { ret 1; }
    var m: Module = r.ok;
    fin { module.dnit(?m); }
    val held: res[*Body, module.Error] = module.body(?m, Function{index: 0});
    if (sel held.err)                                 { ret 2; }
    if (held.ok.blocks.data[0].instructions.len != 3) { ret 3; }
    val first:  InstructionData = held.ok.instructions.data[held.ok.blocks.data[0].instructions.data[0].index];
    val second: InstructionData = held.ok.instructions.data[held.ok.blocks.data[0].instructions.data[1].index];
    if (first.operands.data[0].index != second.results.data[0].index) { ret 4; }

    var lost: sink.Sink = sink.init(?a);
    fin { sink.dnit(?lost); }
    open(?lost, printer.VERSION);
    add(?lost, "function @f: fun(i32) -> (i32) {\n^entry(%a: i32):\n    %r = add %c, %a\n    ret %r\n}\n");
    val got: opt[Refusal] = refusal_of(?a, sink.view(?lost));
    if (sel got.none)                                                                { ret 5; }
    if (got.some.line != 5 || got.some.column != 14)                                 { ret 6; }
    if (!(sel got.some.reason.unresolved))                                           { ret 7; }
    if (!slice.same_view(got.some.reason.unresolved.name, View{data: "%c", len: 2})) { ret 8; }
    ret 0;
}

# print a text's module, read that text, and compare the two modules
fun round_trip(a: *allocator.Allocator, text: View, path: str) u32 {
    var r: res[Module, Refusal] = parse_body(a, text);
    if (sel r.err) {
        var out: io.Writer = filesystem.writer(filesystem.STDERR);
        print.eprintf("{}:", path);
        describe(?out, r.err);
        print.eprintln("");
        ret 1;
    }
    var first: Module = r.ok;
    fin { module.dnit(?first); }
    var out: sink.Sink = sink.init(a);
    fin { sink.dnit(?out); }
    var w:     io.Writer          = sink.writer(?out);
    val wrote: err[printer.Error] = printing.print(?w, ?first);
    if (sel wrote.err) { ret 2; }
    var again: res[Module, Refusal] = parse(a, sink.view(?out));
    if (sel again.err) {
        print.eprintlnf("{}: printed text refused at {}:{}", path, again.err.line, again.err.column);
        ret 3;
    }
    var second: Module = again.ok;
    fin { module.dnit(?second); }
    val same: res[bool, printer.Error] = equal.same(?first, ?second);
    if (sel same.err) { ret 4; }
    if (!same.ok) {
        print.eprintlnf("{}: the module is not the module read back", path);
        ret 5;
    }
    ret 0;
}

fun path_of(buf: *u8, name: str) str {
    val dir: str   = "test/ir/";
    var n:   usize = 0;
    var i:   usize = 0;
    for (i < str_len(dir)) {
        buf[n] = dir[i];
        n      = n + 1;
        i      = i + 1;
    }
    i = 0;
    for (i < str_len(name)) {
        buf[n] = name[i];
        n      = n + 1;
        i      = i + 1;
    }
    buf[n] = 0;
    ret buf;
}

# every file of test/ir, which `mach test` reaches from the project root
test parse__every_ir_text_file_prints_and_reads_back_equal {
    var a: allocator.Allocator;
    page.make(?a);
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(?a, "test/ir");
    if (sel names.err) { ret 1; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirl")) {
            var buf:  [256]u8;
            val path: str                                        = path_of(?buf[0], name);
            val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, path);
            if (sel file.err) { ret 2; }
            val code: u32 = round_trip(?a, View{data: file.ok.data, len: file.ok.len}, path);
            if (code != 0) { ret 10 + code::i32; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 3; }
    ret 0;
}
