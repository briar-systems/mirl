# reading types and literals
#
# a literal is typed by where it stands, so it is read twice: once by `scan`,
# which steps over it and keeps the type it states, if any, and once by
# `literal` with the type it has, which builds the constant.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal.Named;
use mirl.ir.text.parse.refusal.Reason;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use types: mirl.ir.type;
use mirl.ir.type.Type;

pub val NO_TYPE:     Type     = Type{index: 0xffffffff};
pub val NO_CONSTANT: Constant = Constant{index: 0xffffffff};

fun intern(p: *Parser, line: u32, column: u32, s: types.Shape) Type {
    if (!state.ok(p)) { ret NO_TYPE; }
    val r: res[Type, types.Error] = types.intern(?p.m.types, s);
    if (sel r.err) {
        state.fail_at(p, line, column, Reason.types{r.err});
        ret NO_TYPE;
    }
    ret r.ok;
}

fun slice_of(v: *vector.Vector[Type]) Slice[Type] {
    ret Slice[Type]{data: v.data, size: v.len};
}

# whether a word spells an integer type of a width the type table holds, and
# its width if it does
fun integer_width(v: View, out: *u32) bool {
    if (v.len < 2 || v.len > 8 || v.data[0] != 'i') { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < v.len) {
        if (v.data[i] < '0' || v.data[i] > '9') { ret false; }
        n = n * 10 + (v.data[i] - '0')::u32;
        i = i + 1;
    }
    i = 0;
    for (i < $length_of(types.Widths)) {
        if (types.WIDTHS[i] == n) {
            @out = n;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

fun format_named(v: View) opt[types.Format] {
    var i: u32 = 0;
    for (i < types.rows()) {
        val r: opt[types.Row] = types.row(types.Format{index: i});
        if (sel r.some && lexer.spelled(v, r.some.word)) { ret opt[types.Format].some{types.Format{index: i}}; }
        i = i + 1;
    }
    ret opt[types.Format].none{};
}

# whether a word is a type word: a type keyword, an integer type or a float's
pub fun keyword(v: View) bool {
    var width: u32;
    if (lexer.spelled(v, "ptr") || lexer.spelled(v, "vec") || lexer.spelled(v, "fun") || lexer.spelled(v, "handle")) { ret true; }
    if (lexer.spelled(v, "rec") || lexer.spelled(v, "uni"))                                                          { ret true; }
    if (integer_width(v, ?width))                                                                                    { ret true; }
    val f: opt[types.Format] = format_named(v);
    ret sel f.some;
}

# whether a word is one a type starts with: a type word or a typedef's name
pub fun starts_type(p: *Parser, v: View) bool {
    val named: opt[u32] = state.lookup(?p.types, v);
    ret keyword(v) || sel named.some;
}

# read an extension a signature states after a type, none when it states none
pub fun extension(p: *Parser) types.Extension {
    if (state.accept_word(p, "sext")) { ret types.Extension.sext{}; }
    if (state.accept_word(p, "zext")) { ret types.Extension.zext{}; }
    ret types.Extension.none{};
}

# read types each with the extension it states, separated by commas, up to a
# token of a kind that is left unread
pub fun extended_list(p: *Parser, out: *vector.Vector[Type], ext: *vector.Vector[types.Extension], close: lexer.Kind) {
    if (state.is(p, close)) { ret; }
    for {
        state.push[Type](p, out, ty(p));
        state.push[types.Extension](p, ext, extension(p));
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# whether a signature's results follow: a type or a parenthesised list of them
pub fun results_follow(p: *Parser) bool {
    if (state.is(p, lexer.LPAREN) || state.is(p, lexer.LBRACKET)) { ret true; }
    ret state.is(p, lexer.WORD) && starts_type(p, p.tok.text);
}

# read a signature's results, one bare or several in parentheses, each with
# its extension, nothing when none follow
pub fun results(p: *Parser, out: *vector.Vector[Type], ext: *vector.Vector[types.Extension]) {
    if (!results_follow(p)) { ret; }
    if (state.accept(p, lexer.LPAREN)) {
        extended_list(p, out, ext, lexer.RPAREN);
        state.expect(p, lexer.RPAREN, ")");
        ret;
    }
    state.push[Type](p, out, ty(p));
    state.push[types.Extension](p, ext, extension(p));
}

# intern a function type
pub fun signature(p: *Parser, line: u32, column: u32, params: *vector.Vector[Type], param_ext: *vector.Vector[types.Extension], results: *vector.Vector[Type], result_ext: *vector.Vector[types.Extension], convention: View) Type {
    ret intern(p, line, column, types.Shape.function{types.Function{
        params:     slice_of(params),
        results:    slice_of(results),
        param_ext:  Slice[types.Extension]{data: param_ext.data, size: param_ext.len},
        result_ext: Slice[types.Extension]{data: result_ext.data, size: result_ext.len},
        convention: convention,
    }});
}

fun function(p: *Parser, line: u32, column: u32) Type {
    var params:     vector.Vector[Type]            = vector.init[Type](p.a);
    var results_:   vector.Vector[Type]            = vector.init[Type](p.a);
    var param_ext:  vector.Vector[types.Extension] = vector.init[types.Extension](p.a);
    var result_ext: vector.Vector[types.Extension] = vector.init[types.Extension](p.a);
    fin {
        vector.dnit[Type](?params);
        vector.dnit[Type](?results_);
        vector.dnit[types.Extension](?param_ext);
        vector.dnit[types.Extension](?result_ext);
    }
    var convention: View = View{data: nil, len: 0};
    if (state.accept(p, lexer.LBRACKET)) {
        convention = state.name(p, "a convention row's name").text;
        state.expect(p, lexer.RBRACKET, "]");
    }
    state.expect(p, lexer.LPAREN, "(");
    extended_list(p, ?params, ?param_ext, lexer.RPAREN);
    state.expect(p, lexer.RPAREN, ")");
    results(p, ?results_, ?result_ext);
    ret signature(p, line, column, ?params, ?param_ext, ?results_, ?result_ext, convention);
}

# the members of a structure or union a typedef or an unnamed aggregate
# states: each a name, a type and, in a structure, an offset
# ---
# p:        the parser, at the `{`
# names:    each member's name token, appended
# members_: each member's type, appended
# offsets:  each member's offset, appended when it states one
# ret:      how many members state an offset
pub fun members(p: *Parser, names: *vector.Vector[Token], members_: *vector.Vector[Type], offsets: *vector.Vector[u64]) usize {
    var placed: usize = 0;
    state.expect(p, lexer.LBRACE, "{");
    for (state.ok(p) && !state.is(p, lexer.RBRACE)) {
        val n: Token = state.expect(p, lexer.WORD, "a member's name");
        state.expect(p, lexer.COLON, ":");
        state.push[Token](p, names, n);
        state.push[Type](p, members_, ty(p));
        if (state.accept_word(p, "at")) {
            state.push[u64](p, offsets, state.number(p));
            placed = placed + 1;
        }
        state.expect_end(p);
    }
    state.expect(p, lexer.RBRACE, "}");
    ret placed;
}

# intern the aggregate a list of members makes
pub fun aggregate(p: *Parser, line: u32, column: u32, structure: bool, members_: *vector.Vector[Type], offsets: *vector.Vector[u64], placed: usize) Type {
    if (!structure) {
        if (placed > 0) {
            state.fail_at(p, line, column, Reason.unexpected{"an offset of a union's member"});
            ret NO_TYPE;
        }
        ret intern(p, line, column, types.Shape.union{types.Union{members: slice_of(members_)}});
    }
    var at: opt[Slice[u64]] = opt[Slice[u64]].none{};
    if (placed > 0) {
        if (placed != members_.len) {
            state.fail_at(p, line, column, Reason.expected{"an offset on every member, or on none"});
            ret NO_TYPE;
        }
        at = opt[Slice[u64]].some{Slice[u64]{data: offsets.data, size: offsets.len}};
    }
    ret intern(p, line, column, types.Shape.structure{types.Structure{members: slice_of(members_), offsets: at}});
}

fun unnamed_aggregate(p: *Parser, line: u32, column: u32, structure: bool) Type {
    var names:    vector.Vector[Token] = vector.init[Token](p.a);
    var members_: vector.Vector[Type]  = vector.init[Type](p.a);
    var offsets:  vector.Vector[u64]   = vector.init[u64](p.a);
    fin {
        vector.dnit[Token](?names);
        vector.dnit[Type](?members_);
        vector.dnit[u64](?offsets);
    }
    val placed: usize = members(p, ?names, ?members_, ?offsets);
    ret aggregate(p, line, column, structure, ?members_, ?offsets, placed);
}

# read a type
pub fun ty(p: *Parser) Type {
    val t: Token = p.tok;
    if (!state.ok(p)) { ret NO_TYPE; }
    if (t.kind == lexer.LBRACKET) {
        state.advance(p);
        val count:  u64      = state.number(p);
        var stride: opt[u64] = opt[u64].none{};
        if (state.accept(p, lexer.COMMA)) {
            state.expect_word(p, "stride");
            stride = opt[u64].some{state.number(p)};
        }
        state.expect(p, lexer.RBRACKET, "]");
        val element: Type = ty(p);
        ret intern(p, t.line, t.column, types.Shape.array{types.Array{count: count, element: element, stride: stride}});
    }
    if (t.kind != lexer.WORD) {
        state.expected(p, "a type");
        ret NO_TYPE;
    }
    state.advance(p);
    val v:     View = t.text;
    var width: u32;
    if (lexer.spelled(v, "ptr")) {
        var space: u32 = 0;
        if (state.accept(p, lexer.LBRACKET)) {
            space = state.number32(p);
            state.expect(p, lexer.RBRACKET, "]");
        }
        ret intern(p, t.line, t.column, types.Shape.pointer{types.Pointer{space: space}});
    }
    if (lexer.spelled(v, "vec")) {
        state.expect(p, lexer.LBRACKET, "[");
        val lanes: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        val element: Type = ty(p);
        state.expect(p, lexer.RBRACKET, "]");
        ret intern(p, t.line, t.column, types.Shape.vector{types.Vector{lanes: lanes, element: element}});
    }
    if (lexer.spelled(v, "fun")) { ret function(p, t.line, t.column); }
    if (lexer.spelled(v, "rec")) { ret unnamed_aggregate(p, t.line, t.column, true); }
    if (lexer.spelled(v, "uni")) { ret unnamed_aggregate(p, t.line, t.column, false); }
    if (lexer.spelled(v, "handle")) {
        var operands: vector.Vector[types.HandleOperand] = vector.init[types.HandleOperand](p.a);
        fin { vector.dnit[types.HandleOperand](?operands); }
        state.expect(p, lexer.LBRACKET, "[");
        val kind: View = state.name(p, "a kind name").text;
        for (state.ok(p) && state.accept(p, lexer.COMMA)) {
            var o: types.HandleOperand = types.HandleOperand.word{0};
            if (state.is(p, lexer.UINT)) { o = types.HandleOperand.word{state.number32(p)}; }
            or                           { o = types.HandleOperand.typed{ty(p)}; }
            state.push[types.HandleOperand](p, ?operands, o);
        }
        state.expect(p, lexer.RBRACKET, "]");
        ret intern(p, t.line, t.column, types.Shape.handle{types.Handle{kind: kind, operands: Slice[types.HandleOperand]{data: operands.data, size: operands.len}}});
    }
    if (integer_width(v, ?width)) { ret intern(p, t.line, t.column, types.Shape.integer{types.Integer{width: width}}); }
    val f: opt[types.Format] = format_named(v);
    if (sel f.some) { ret intern(p, t.line, t.column, types.Shape.float{types.Float{format: f.some}}); }
    val named: opt[u32] = state.lookup(?p.types, v);
    if (sel named.some) { ret Type{index: named.some}; }
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "type", name: t.raw}});
    ret NO_TYPE;
}

# the plain pointer, which an address literal has when nothing states another
pub fun pointer(p: *Parser, line: u32, column: u32) Type {
    ret intern(p, line, column, types.Shape.pointer{types.Pointer{space: 0}});
}

# a literal not yet typed
# ---
# at:      where it starts
# stated:  the type it states, before its braces or after `::`, none when it
#          states none
# address: it is the address of a symbol, which is a plain pointer when
#          nothing gives it a type
# line:    where it starts
# column:  where it starts
pub rec Pending {
    at:      Mark;
    stated:  opt[Type];
    address: bool;
    line:    u32;
    column:  u32;
}

# whether the token being looked at starts a literal rather than a value's
# name: a number, `-`, `?`, a brace or bracket, `zero`, `spec`, or a word a
# bracket or brace follows, which only a type is
pub fun starts_literal(p: *Parser) bool {
    if (!state.ok(p)) { ret false; }
    val k: lexer.Kind = p.tok.kind;
    if (k == lexer.UINT || k == lexer.MINUS || k == lexer.ADDRESS || k == lexer.LBRACE || k == lexer.LBRACKET) { ret true; }
    if (k != lexer.WORD)                                                                                       { ret false; }
    if (lexer.spelled(p.tok.text, "zero") || lexer.spelled(p.tok.text, "spec"))                                { ret true; }
    ret state.next_is(p, lexer.LBRACE) || state.next_is(p, lexer.LBRACKET);
}

# step over a literal, keeping where it starts and the type it states
pub fun scan(p: *Parser) Pending {
    var out: Pending = Pending{at: state.mark(p), stated: opt[Type].none{}, address: false, line: p.tok.line, column: p.tok.column};
    if (!state.ok(p))                 { ret out; }
    if (state.accept(p, lexer.MINUS)) { state.number(p); }
    or (state.is(p, lexer.UINT))      { state.advance(p); }
    or (state.accept_word(p, "zero")) {}
    or (state.is_word(p, "spec")) {
        state.advance(p);
        state.skip_group(p);
    }
    or (state.accept(p, lexer.ADDRESS)) {
        out.address = true;
        state.name(p, "a symbol");
        if (state.accept(p, lexer.PLUS) || state.accept(p, lexer.MINUS)) { state.number(p); }
    }
    or (state.is(p, lexer.LBRACE)) { state.skip_group(p); }
    or {
        out.stated = opt[Type].some{ty(p)};
        if (!state.is(p, lexer.LBRACE)) {
            state.expected(p, "the braces of an aggregate literal");
            ret out;
        }
        state.skip_group(p);
    }
    if (state.accept(p, lexer.ASCRIBE)) { out.stated = opt[Type].some{ty(p)}; }
    ret out;
}

# the width of the integer or float type a number is of
fun number_width(p: *Parser, t: Type, line: u32, column: u32) u32 {
    if (!state.ok(p)) { ret 0; }
    val s: res[types.Shape, types.Error] = types.shape(?p.m.types, t);
    if (sel s.err) {
        state.fail_at(p, line, column, Reason.types{s.err});
        ret 0;
    }
    if (sel s.ok.integer) { ret s.ok.integer.width; }
    if (sel s.ok.float) {
        val r: opt[types.Row] = types.row(s.ok.float.format);
        if (sel r.some) { ret r.some.width; }
    }
    state.fail_at(p, line, column, Reason.expected{"a number of an integer or float type"});
    ret 0;
}

fun nibble(c: u8) u64 {
    if (c <= '9') { ret (c - '0')::u64; }
    if (c <= 'F') { ret (c - 'A')::u64 + 10; }
    ret (c - 'a')::u64 + 10;
}

# the words of a number of a width, low word first, negated when it is written with a `-`
fun words(p: *Parser, tk: Token, width: u32, negate: bool, out: *vector.Vector[u64]) {
    val count: usize = ((width + 63) / 64)::usize;
    var i:     usize = 0;
    for (i < count) {
        state.push[u64](p, out, 0);
        i = i + 1;
    }
    if (!state.ok(p)) { ret; }
    val v: View = tk.text;
    if (v.len > 2 && v.data[1] == 'x') {
        var k:     usize = 0;
        var digit: usize = 0;
        for (k < v.len - 2) {
            val c: u8 = v.data[v.len - 1 - k];
            k = k + 1;
            if (c == '_') { cnt; }
            val d: u64   = nibble(c);
            val w: usize = digit / 16;
            if (w < count) { out.data[w] = out.data[w] | (d << ((digit % 16)::u64 * 4)); }
            or (d != 0) {
                state.fail_at(p, tk.line, tk.column, Reason.large{});
                ret;
            }
            digit = digit + 1;
        }
    }
    or {
        if (tk.wide) {
            state.fail_at(p, tk.line, tk.column, Reason.large{});
            ret;
        }
        out.data[0] = tk.value;
    }
    val spare: u32 = width % 64;
    if (spare != 0 && !negate && (out.data[count - 1] >> spare::u64) != 0) {
        state.fail_at(p, tk.line, tk.column, Reason.large{});
        ret;
    }
    if (!negate) { ret; }
    var carry: u64 = 1;
    i = 0;
    for (i < count) {
        val flipped: u64 = ~out.data[i];
        var over:    u64 = 0;
        if (carry == 1 && flipped == 0xffffffffffffffff) { over = 1; }
        out.data[i] = flipped + carry;
        carry       = over;
        i           = i + 1;
    }
    if (spare != 0) { out.data[count - 1] = out.data[count - 1] & ((1::u64 << spare::u64) - 1); }
}

# read a number of a type as its bits
fun bits(p: *Parser, t: Type, line: u32, column: u32, held: *vector.Vector[u64]) Bits {
    val negate: bool  = state.accept(p, lexer.MINUS);
    val tk:     Token = p.tok;
    state.expect(p, lexer.UINT, "a number");
    val width: u32 = number_width(p, t, line, column);
    if (state.ok(p)) { words(p, tk, width, negate, held); }
    ret Bits{type: t, words: Slice[u64]{data: held.data, size: held.len}};
}

fun made(p: *Parser, line: u32, column: u32, data: ConstantData) Constant {
    if (!state.ok(p)) { ret NO_CONSTANT; }
    val c: Constant = build.constant(?p.b, data);
    state.built(p, line, column);
    ret c;
}

# the type of an aggregate's member at a position
fun element(p: *Parser, agg: Type, i: usize) opt[Type] {
    val got: res[types.Shape, types.Error] = types.shape(?p.m.types, agg);
    if (sel got.err) { ret opt[Type].none{}; }
    val s: types.Shape = got.ok;
    if (sel s.structure) {
        if (i < s.structure.members.size) { ret opt[Type].some{s.structure.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.union) {
        if (i < s.union.members.size) { ret opt[Type].some{s.union.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.array)  { ret opt[Type].some{s.array.element}; }
    if (sel s.vector) { ret opt[Type].some{s.vector.element}; }
    ret opt[Type].none{};
}

# read a literal, of the type it states, or else of the type its place gives
# it, refusing one that neither gives a type
# ---
# p:       the parser, at the literal
# implied: the type its place gives it, none where it gives none
pub fun typed(p: *Parser, implied: opt[Type]) Constant {
    val k: Pending   = scan(p);
    val t: opt[Type] = type_of(p, k, implied);
    if (sel t.none) { ret NO_CONSTANT; }
    val after: Mark = state.mark(p);
    state.rewind(p, k.at);
    val c: Constant = literal(p, t.some);
    state.rewind(p, after);
    ret c;
}

# the type a scanned literal has, refusing one nothing gives a type
pub fun type_of(p: *Parser, k: Pending, implied: opt[Type]) opt[Type] {
    if (!state.ok(p))      { ret opt[Type].none{}; }
    if (sel k.stated.some) { ret k.stated; }
    if (sel implied.some)  { ret implied; }
    if (k.address)         { ret opt[Type].some{pointer(p, k.line, k.column)}; }
    state.fail_at(p, k.line, k.column, Reason.expected{"a type for the literal, after `::`"});
    ret opt[Type].none{};
}

# read a literal of a type, and its stated type, which is the type given
pub fun literal(p: *Parser, t: Type) Constant {
    val line: u32 = p.tok.line;
    val col:  u32 = p.tok.column;
    if (!state.ok(p)) { ret NO_CONSTANT; }
    var c: Constant = NO_CONSTANT;
    if (state.is(p, lexer.UINT) || state.is(p, lexer.MINUS)) {
        var held: vector.Vector[u64] = vector.init[u64](p.a);
        fin { vector.dnit[u64](?held); }
        val b: Bits                          = bits(p, t, line, col, ?held);
        val s: res[types.Shape, types.Error] = types.shape(?p.m.types, t);
        if (sel s.err) { ret NO_CONSTANT; }
        var data: ConstantData = ConstantData.integer{b};
        if (sel s.ok.float) { data = ConstantData.float{b}; }
        c = made(p, line, col, data);
    }
    or (state.accept_word(p, "zero")) { c = made(p, line, col, ConstantData.zero{t}); }
    or (state.accept_word(p, "spec")) {
        state.expect(p, lexer.LPAREN, "(");
        val id: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        var held: vector.Vector[u64] = vector.init[u64](p.a);
        fin { vector.dnit[u64](?held); }
        val b: Bits = bits(p, t, line, col, ?held);
        state.expect(p, lexer.RPAREN, ")");
        c = made(p, line, col, ConstantData.spec{Spec{id: id, default: b}});
    }
    or (state.accept(p, lexer.ADDRESS)) {
        val named: Token = state.name(p, "a symbol");
        if (!state.ok(p)) { ret NO_CONSTANT; }
        val s: opt[Symbol] = module.find(p.m, named.text);
        if (sel s.none) {
            state.fail_at(p, named.line, named.column, Reason.unresolved{Named{what: "symbol", name: named.raw}});
            ret NO_CONSTANT;
        }
        var off: i64 = 0;
        if (state.accept(p, lexer.PLUS))  { off = state.number(p)::i64; }
        or (state.accept(p, lexer.MINUS)) { off = 0 - state.number(p)::i64; }
        c = made(p, line, col, ConstantData.address{Address{type: t, symbol: s.some, offset: off}});
    }
    or {
        if (!state.is(p, lexer.LBRACE)) { ty(p); }
        var elements: vector.Vector[Constant] = vector.init[Constant](p.a);
        fin { vector.dnit[Constant](?elements); }
        state.expect(p, lexer.LBRACE, "{");
        if (!state.is(p, lexer.RBRACE)) {
            for (state.ok(p)) {
                val e: Constant = typed(p, element(p, t, elements.len));
                state.push[Constant](p, ?elements, e);
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACE, "}");
        c = made(p, line, col, ConstantData.aggregate{Aggregate{type: t, elements: Slice[Constant]{data: elements.data, size: elements.len}}});
    }
    if (state.accept(p, lexer.ASCRIBE)) { ty(p); }
    ret c;
}
