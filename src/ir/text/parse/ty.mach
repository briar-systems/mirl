# reading types and literals
#
# a literal is typed by where it stands, so it is read twice: once by `scan`,
# which steps over it and keeps the type it states, if any, and once by
# `literal` with the type it has, which builds the constant.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use arches: mink.catalog.arch;

use mirl.build.builder;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.Bytes;
use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.reason;
use mirl.ir.text.parse.reason.Named;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.type.calling;
use type_format: mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;

pub val NO_TYPE:     Type     = 0xffffffff;
pub val NO_CONSTANT: Constant = 0xffffffff;

# intern a shape, refusing at a position what the type table refuses
fun intern(p: *Parser, line: u32, column: u32, s: table.Shape) Type {
    if (!state.ok(p)) { ret NO_TYPE; }
    val res_intern: res[Type, table.Error] = table.intern(?p.m.types, s);
    if (sel res_intern.err) {
        state.fail_at(p, line, column, reason.Error.types{res_intern.err});
        ret NO_TYPE;
    }
    ret res_intern.ok;
}

fun slice_of(v: *vector.Vector[Type]) Slice[Type] {
    ret Slice[Type]{data: v.data, size: v.len};
}

# whether a word spells an integer type of a width the type table holds, and
# its width if it does
fun integer_width(v: View, out: *u32) bool {
    if (v.len < 2 || v.len > 8 || v.data[0] != 'i') { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < v.len) {
        if (v.data[i] < '0' || v.data[i] > '9') { ret false; }
        n = n * 10 + (v.data[i] - '0')::u32;
        i = i + 1;
    }
    i = 0;
    for (i < $length_of(table.Widths)) {
        if (table.WIDTHS[i] == n) {
            @out = n;
            ret true;
        }
        i = i + 1;
    }
    ret false;
}

# the float format whose type word a word spells, none when it spells none
fun format_named(v: View) opt[type_format.Format] {
    var i: u32 = 0;
    for (i < type_format.rows()) {
        val opt_row: opt[type_format.Row] = type_format.row(i);
        if (sel opt_row.some && lexer.spelled(v, opt_row.some.word)) { ret opt[type_format.Format].some{i}; }
        i = i + 1;
    }
    ret opt[type_format.Format].none{};
}

# whether a word is a type word: a type keyword, an integer type or a float's
pub fun keyword(v: View) bool {
    var width: u32;
    if (lexer.spelled(v, "ptr") || lexer.spelled(v, "vec") || lexer.spelled(v, "fun") || lexer.spelled(v, "handle")) { ret true; }
    if (lexer.spelled(v, "rec") || lexer.spelled(v, "uni"))                                                          { ret true; }
    if (integer_width(v, ?width))                                                                                    { ret true; }
    val opt_format_named: opt[type_format.Format] = format_named(v);
    ret sel opt_format_named.some;
}

# whether a word is one a type starts with: a type word or a typedef's name
pub fun starts_type(p: *Parser, v: View) bool {
    val opt_named: opt[u32] = state.lookup(?p.types, v);
    ret keyword(v) || sel opt_named.some;
}

# read an extension a signature states after a type, none when it states none
pub fun extension(p: *Parser) table.Extension {
    if (state.accept_word(p, "sext")) { ret table.Extension.sext{}; }
    if (state.accept_word(p, "zext")) { ret table.Extension.zext{}; }
    ret table.Extension.none{};
}

# read types each with the extension it states, separated by commas, up to a
# token of a kind that is left unread, and a last `...` where `variadic` is
# not nil, which it marks
pub fun extended_list(p: *Parser, out: *vector.Vector[Type], ext: *vector.Vector[table.Extension], close: lexer.Kind, variadic: *bool) {
    if (state.is(p, close)) { ret; }
    for {
        if (variadic != nil && state.accept_word(p, VARIADIC)) {
            @variadic = true;
            brk;
        }
        state.push[Type](p, out, ty(p));
        state.push[table.Extension](p, ext, extension(p));
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# whether a signature's results follow: a type or a parenthesised list of them
pub fun results_follow(p: *Parser) bool {
    if (state.is(p, lexer.LPAREN) || state.is(p, lexer.LBRACKET)) { ret true; }
    ret state.is(p, lexer.WORD) && starts_type(p, p.tok.text);
}

# read a signature's results, one bare or several in parentheses, each with
# its extension, nothing when none follow
pub fun results(p: *Parser, out: *vector.Vector[Type], ext: *vector.Vector[table.Extension]) {
    if (!results_follow(p)) { ret; }
    if (state.accept(p, lexer.LPAREN)) {
        extended_list(p, out, ext, lexer.RPAREN, nil);
        state.expect(p, lexer.RPAREN, ")");
        ret;
    }
    state.push[Type](p, out, ty(p));
    state.push[table.Extension](p, ext, extension(p));
}

# the word that ends a variadic signature's parameters
pub val VARIADIC: str = "...";

# intern a function type
pub fun signature(p: *Parser, line: u32, column: u32, params: *vector.Vector[Type], param_ext: *vector.Vector[table.Extension], results: *vector.Vector[Type], result_ext: *vector.Vector[table.Extension], convention: opt[calling.Calling], variadic: bool) Type {
    ret intern(p, line, column, table.Shape.function{table.Function{
        params:     slice_of(params),
        results:    slice_of(results),
        param_ext:  Slice[table.Extension]{data: param_ext.data, size: param_ext.len},
        result_ext: Slice[table.Extension]{data: result_ext.data, size: result_ext.len},
        convention: convention,
        variadic:   variadic,
    }});
}

# the convention a text names, mink's psabi row of the module's architecture
# by its name, or that and a bridge role's word. a name that is no such row
# is refused
pub fun named_convention(p: *Parser, t: Token) opt[calling.Calling] {
    if (!state.ok(p)) { ret calling.DEFAULT; }
    val opt_arch: opt[*arches.Arch] = calling.arch_named(module.target(p.m).arch);
    if (sel opt_arch.some) {
        val opt_resolve: opt[calling.Calling] = calling.resolve(opt_arch.some, t.text);
        if (sel opt_resolve.some) { ret opt_resolve; }
    }
    state.fail_at(p, t.line, t.column, reason.Error.unknown{Named{what: "convention row of the target's architecture", name: t.raw}});
    ret calling.DEFAULT;
}

# read a function type after `fun`: its convention, parameters and results
fun function(p: *Parser, line: u32, column: u32) Type {
    var params:     vector.Vector[Type]            = vector.init[Type](p.a);
    var results_:   vector.Vector[Type]            = vector.init[Type](p.a);
    var param_ext:  vector.Vector[table.Extension] = vector.init[table.Extension](p.a);
    var result_ext: vector.Vector[table.Extension] = vector.init[table.Extension](p.a);
    fin {
        vector.dnit[Type](?params);
        vector.dnit[Type](?results_);
        vector.dnit[table.Extension](?param_ext);
        vector.dnit[table.Extension](?result_ext);
    }
    var opt_convention: opt[calling.Calling] = calling.DEFAULT;
    if (state.accept(p, lexer.LBRACKET)) {
        opt_convention = named_convention(p, state.name(p, "a convention row's name"));
        state.expect(p, lexer.RBRACKET, "]");
    }
    state.expect(p, lexer.LPAREN, "(");
    var variadic: bool = false;
    extended_list(p, ?params, ?param_ext, lexer.RPAREN, ?variadic);
    state.expect(p, lexer.RPAREN, ")");
    results(p, ?results_, ?result_ext);
    ret signature(p, line, column, ?params, ?param_ext, ?results_, ?result_ext, opt_convention, variadic);
}

# what a structure or union states of its own layout before its members:
# `packed`, then `align` and a power of two, each optional
# ---
# align:  the alignment it states, none for none
# packed: whether it is packed
pub rec Traits {
    align:  opt[u64];
    packed: bool;
}

# read the traits an aggregate states, at the word after `rec`, `uni` or a
# typedef's name
pub fun traits(p: *Parser) Traits {
    var t: Traits = Traits{align: opt[u64].none{}, packed: false};
    if (state.accept_word(p, "packed")) { t.packed = true; }
    if (state.accept_word(p, "align"))  { t.align = opt[u64].some{state.number(p)}; }
    ret t;
}

# the members of a structure or union a typedef or an unnamed aggregate
# states: each a name, a type and, in a structure, an offset
# ---
# p:        the parser, at the `{`
# names:    each member's name token, appended
# members_: each member's type, appended
# offsets:  each member's offset, appended when it states one
# ret:      how many members state an offset
pub fun members(p: *Parser, names: *vector.Vector[Token], members_: *vector.Vector[Type], offsets: *vector.Vector[u64]) usize {
    var placed: usize = 0;
    state.expect(p, lexer.LBRACE, "{");
    for (state.ok(p) && !state.is(p, lexer.RBRACE)) {
        val n: Token = state.expect(p, lexer.WORD, "a member's name");
        state.expect(p, lexer.COLON, ":");
        state.push[Token](p, names, n);
        state.push[Type](p, members_, ty(p));
        if (state.accept_word(p, "at")) {
            state.push[u64](p, offsets, state.number(p));
            placed = placed + 1;
        }
        state.expect_end(p);
    }
    state.expect(p, lexer.RBRACE, "}");
    ret placed;
}

# intern the aggregate a list of members makes
pub fun aggregate(p: *Parser, line: u32, column: u32, structure: bool, t: Traits, members_: *vector.Vector[Type], offsets: *vector.Vector[u64], placed: usize) Type {
    if (!structure) {
        if (placed > 0) {
            state.fail_at(p, line, column, reason.Error.unexpected{"an offset of a union's member"});
            ret NO_TYPE;
        }
        ret intern(p, line, column, table.Shape.union{table.Union{members: slice_of(members_), align: t.align, packed: t.packed}});
    }
    var opt_offsets: opt[Slice[u64]] = opt[Slice[u64]].none{};
    if (placed > 0) {
        if (placed != members_.len) {
            state.fail_at(p, line, column, reason.Error.expected{"an offset on every member, or on none"});
            ret NO_TYPE;
        }
        opt_offsets = opt[Slice[u64]].some{Slice[u64]{data: offsets.data, size: offsets.len}};
    }
    ret intern(p, line, column, table.Shape.structure{table.Structure{members: slice_of(members_), offsets: opt_offsets, align: t.align, packed: t.packed}});
}

# read a structure or union written in place after `rec` or `uni`
fun unnamed_aggregate(p: *Parser, line: u32, column: u32, structure: bool) Type {
    var names:    vector.Vector[Token] = vector.init[Token](p.a);
    var members_: vector.Vector[Type]  = vector.init[Type](p.a);
    var offsets:  vector.Vector[u64]   = vector.init[u64](p.a);
    fin {
        vector.dnit[Token](?names);
        vector.dnit[Type](?members_);
        vector.dnit[u64](?offsets);
    }
    val stated: Traits = traits(p);
    val placed: usize  = members(p, ?names, ?members_, ?offsets);
    ret aggregate(p, line, column, structure, stated, ?members_, ?offsets, placed);
}

# read a type
pub fun ty(p: *Parser) Type {
    val t: Token = p.tok;
    if (!state.ok(p)) { ret NO_TYPE; }
    if (t.kind == lexer.LBRACKET) {
        state.advance(p);
        val count:      u64      = state.number(p);
        var opt_stride: opt[u64] = opt[u64].none{};
        if (state.accept(p, lexer.COMMA)) {
            state.expect_word(p, "stride");
            opt_stride = opt[u64].some{state.number(p)};
        }
        state.expect(p, lexer.RBRACKET, "]");
        val element: Type = ty(p);
        ret intern(p, t.line, t.column, table.Shape.array{table.Array{count: count, element: element, stride: opt_stride}});
    }
    if (t.kind != lexer.WORD) {
        state.expected(p, "a type");
        ret NO_TYPE;
    }
    state.advance(p);
    val v:     View = t.text;
    var width: u32;
    if (lexer.spelled(v, "ptr")) {
        var space: u32 = 0;
        if (state.accept(p, lexer.LBRACKET)) {
            space = state.number32(p);
            state.expect(p, lexer.RBRACKET, "]");
        }
        ret intern(p, t.line, t.column, table.Shape.pointer{table.Pointer{space: space}});
    }
    if (lexer.spelled(v, "vec")) {
        state.expect(p, lexer.LBRACKET, "[");
        val lanes: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        val element: Type = ty(p);
        state.expect(p, lexer.RBRACKET, "]");
        ret intern(p, t.line, t.column, table.Shape.vector{table.Vector{lanes: lanes, element: element}});
    }
    if (lexer.spelled(v, "fun")) { ret function(p, t.line, t.column); }
    if (lexer.spelled(v, "rec")) { ret unnamed_aggregate(p, t.line, t.column, true); }
    if (lexer.spelled(v, "uni")) { ret unnamed_aggregate(p, t.line, t.column, false); }
    if (lexer.spelled(v, "handle")) {
        var operands: vector.Vector[table.HandleOperand] = vector.init[table.HandleOperand](p.a);
        fin { vector.dnit[table.HandleOperand](?operands); }
        state.expect(p, lexer.LBRACKET, "[");
        val kind: View = state.name(p, "a kind name").text;
        for (state.ok(p) && state.accept(p, lexer.COMMA)) {
            var o: table.HandleOperand = table.HandleOperand.word{0};
            if (state.is(p, lexer.UINT))        { o = table.HandleOperand.word{state.number32(p)}; }
            or (state.accept_word(p, "signed")) { o = table.HandleOperand.signed{ty(p)}; }
            or                                  { o = table.HandleOperand.typed{ty(p)}; }
            state.push[table.HandleOperand](p, ?operands, o);
        }
        state.expect(p, lexer.RBRACKET, "]");
        ret intern(p, t.line, t.column, table.Shape.handle{table.Handle{kind: kind, operands: Slice[table.HandleOperand]{data: operands.data, size: operands.len}}});
    }
    if (integer_width(v, ?width)) { ret intern(p, t.line, t.column, table.Shape.integer{table.Integer{width: width}}); }
    val opt_format_named: opt[type_format.Format] = format_named(v);
    if (sel opt_format_named.some) { ret intern(p, t.line, t.column, table.Shape.float{table.Float{format: opt_format_named.some}}); }
    val opt_named: opt[u32] = state.lookup(?p.types, v);
    if (sel opt_named.some) { ret opt_named.some; }
    state.fail_at(p, t.line, t.column, reason.Error.unknown{Named{what: "type", name: t.raw}});
    ret NO_TYPE;
}

# the plain pointer, which an address literal has when nothing states another
pub fun pointer(p: *Parser, line: u32, column: u32) Type {
    ret intern(p, line, column, table.Shape.pointer{table.Pointer{space: 0}});
}

# a literal not yet typed
# ---
# at:      where it starts
# stated:  the type it states, before its braces or after `::`, none when it
#          states none
# address: it is the address of a symbol, which is a plain pointer when
#          nothing gives it a type
# line:    where it starts
# column:  where it starts
pub rec Pending {
    at:      Mark;
    stated:  opt[Type];
    address: bool;
    line:    u32;
    column:  u32;
}

# whether the token being looked at starts a literal rather than a value's
# name: a number, `-`, `?`, a brace or bracket, `zero`, `spec`, or a word a
# bracket or brace follows, which only a type is
pub fun starts_literal(p: *Parser) bool {
    if (!state.ok(p)) { ret false; }
    val k: lexer.Kind = p.tok.kind;
    if (k == lexer.UINT || k == lexer.MINUS || k == lexer.ADDRESS || k == lexer.LBRACE || k == lexer.LBRACKET) { ret true; }
    if (k != lexer.WORD)                                                                                       { ret false; }
    if (lexer.spelled(p.tok.text, "zero") || lexer.spelled(p.tok.text, "spec"))                                { ret true; }
    ret state.next_is(p, lexer.LBRACE) || state.next_is(p, lexer.LBRACKET);
}

# step over a literal, keeping where it starts and the type it states
pub fun scan(p: *Parser) Pending {
    var out: Pending = Pending{at: state.mark(p), stated: opt[Type].none{}, address: false, line: p.tok.line, column: p.tok.column};
    if (!state.ok(p))                 { ret out; }
    if (state.accept(p, lexer.MINUS)) { state.number(p); }
    or (state.is(p, lexer.UINT))      { state.advance(p); }
    or (state.accept_word(p, "zero")) {}
    or (state.is_word(p, "spec")) {
        state.advance(p);
        state.skip_group(p);
    }
    or (state.accept(p, lexer.ADDRESS)) {
        out.address = true;
        state.name(p, "a symbol");
        if (state.accept(p, lexer.PLUS) || state.accept(p, lexer.MINUS)) { state.number(p); }
    }
    or (state.is(p, lexer.LBRACE)) { state.skip_group(p); }
    or (state.is(p, lexer.STRING)) { state.advance(p); }
    or {
        out.stated = opt[Type].some{ty(p)};
        if (state.is(p, lexer.STRING)) { state.advance(p); }
        or (!state.is(p, lexer.LBRACE)) {
            state.expected(p, "the braces of an aggregate literal or the string of a run of bytes");
            ret out;
        }
        or { state.skip_group(p); }
    }
    if (state.accept(p, lexer.ASCRIBE)) { out.stated = opt[Type].some{ty(p)}; }
    ret out;
}

# the width of the integer or float type a number is of
fun number_width(p: *Parser, t: Type, line: u32, column: u32) u32 {
    if (!state.ok(p)) { ret 0; }
    val res_shape: res[table.Shape, table.Error] = table.shape(?p.m.types, t);
    if (sel res_shape.err) {
        state.fail_at(p, line, column, reason.Error.types{res_shape.err});
        ret 0;
    }
    if (sel res_shape.ok.integer) { ret res_shape.ok.integer.width; }
    if (sel res_shape.ok.float) {
        val opt_row: opt[type_format.Row] = type_format.row(res_shape.ok.float.format);
        if (sel opt_row.some) { ret opt_row.some.width; }
    }
    state.fail_at(p, line, column, reason.Error.expected{"a number of an integer or float type"});
    ret 0;
}

fun nibble(c: u8) u64 {
    if (c <= '9') { ret (c - '0')::u64; }
    if (c <= 'F') { ret (c - 'A')::u64 + 10; }
    ret (c - 'a')::u64 + 10;
}

# the words of a number of a width, low word first, negated when it is written with a `-`
fun words(p: *Parser, tk: Token, width: u32, negate: bool, out: *vector.Vector[u64]) {
    val count: usize = ((width + 63) / 64)::usize;
    var i:     usize = 0;
    for (i < count) {
        state.push[u64](p, out, 0);
        i = i + 1;
    }
    if (!state.ok(p)) { ret; }
    val v: View = tk.text;
    if (v.len > 2 && v.data[1] == 'x') {
        var k:     usize = 0;
        var digit: usize = 0;
        for (k < v.len - 2) {
            val c: u8 = v.data[v.len - 1 - k];
            k = k + 1;
            if (c == '_') { cnt; }
            val d: u64   = nibble(c);
            val w: usize = digit / 16;
            if (w < count) { out.data[w] = out.data[w] | (d << ((digit % 16)::u64 * 4)); }
            or (d != 0) {
                state.fail_at(p, tk.line, tk.column, reason.Error.large{});
                ret;
            }
            digit = digit + 1;
        }
    }
    or {
        if (tk.wide) {
            state.fail_at(p, tk.line, tk.column, reason.Error.large{});
            ret;
        }
        out.data[0] = tk.value;
    }
    val spare: u32 = width % 64;
    if (spare != 0 && !negate && (out.data[count - 1] >> spare::u64) != 0) {
        state.fail_at(p, tk.line, tk.column, reason.Error.large{});
        ret;
    }
    if (!negate) { ret; }
    # a negated magnitude reaches at most the sign bit alone
    val sign:  u64  = ((width - 1) % 64)::u64;
    val high:  u64  = out.data[count - 1] >> sign;
    var below: bool = (out.data[count - 1] & ((1::u64 << sign) - 1)) != 0;
    i = 0;
    for (i + 1 < count) {
        if (out.data[i] != 0) { below = true; }
        i = i + 1;
    }
    if (high > 1 || (high == 1 && below)) {
        state.fail_at(p, tk.line, tk.column, reason.Error.large{});
        ret;
    }
    var carry: u64 = 1;
    i = 0;
    for (i < count) {
        val flipped: u64 = ~out.data[i];
        var over:    u64 = 0;
        if (carry == 1 && flipped == 0xffffffffffffffff) { over = 1; }
        out.data[i] = flipped + carry;
        carry       = over;
        i           = i + 1;
    }
    if (spare != 0) { out.data[count - 1] = out.data[count - 1] & ((1::u64 << spare::u64) - 1); }
}

# read a number of a type as its bits
fun bits(p: *Parser, t: Type, line: u32, column: u32, held: *vector.Vector[u64]) Bits {
    val negate: bool  = state.accept(p, lexer.MINUS);
    val tk:     Token = p.tok;
    state.expect(p, lexer.UINT, "a number");
    val width: u32 = number_width(p, t, line, column);
    if (state.ok(p)) { words(p, tk, width, negate, held); }
    ret Bits{type: t, words: Slice[u64]{data: held.data, size: held.len}};
}

# build a constant, refusing at a position what the builder refuses
fun made(p: *Parser, line: u32, column: u32, data: ConstantData) Constant {
    if (!state.ok(p)) { ret NO_CONSTANT; }
    val c: Constant = builder.constant(?p.b, data);
    state.built(p, line, column);
    ret c;
}

# the type of an aggregate's member at a position
fun element(p: *Parser, agg: Type, i: usize) opt[Type] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?p.m.types, agg);
    if (sel res_shape.err) { ret opt[Type].none{}; }
    val s: table.Shape = res_shape.ok;
    if (sel s.structure) {
        if (i < s.structure.members.size) { ret opt[Type].some{s.structure.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.union) {
        if (i < s.union.members.size) { ret opt[Type].some{s.union.members.data[i]}; }
        ret opt[Type].none{};
    }
    if (sel s.array)  { ret opt[Type].some{s.array.element}; }
    if (sel s.vector) { ret opt[Type].some{s.vector.element}; }
    ret opt[Type].none{};
}

# read a literal, of the type it states, or else of the type its place gives
# it, refusing one that neither gives a type
# ---
# p:       the parser, at the literal
# implied: the type its place gives it, none where it gives none
pub fun typed(p: *Parser, implied: opt[Type]) Constant {
    val k:           Pending   = scan(p);
    val opt_type_of: opt[Type] = type_of(p, k, implied);
    if (sel opt_type_of.none) { ret NO_CONSTANT; }
    val after: Mark = state.mark(p);
    state.rewind(p, k.at);
    val c: Constant = literal(p, opt_type_of.some);
    state.rewind(p, after);
    ret c;
}

# the type a scanned literal has, refusing one nothing gives a type
pub fun type_of(p: *Parser, k: Pending, implied: opt[Type]) opt[Type] {
    if (!state.ok(p))      { ret opt[Type].none{}; }
    if (sel k.stated.some) { ret k.stated; }
    if (sel implied.some)  { ret implied; }
    if (k.address)         { ret opt[Type].some{pointer(p, k.line, k.column)}; }
    state.fail_at(p, k.line, k.column, reason.Error.expected{"a type for the literal, after `::`"});
    ret opt[Type].none{};
}

# read a literal of a type, and its stated type, which is the type given
pub fun literal(p: *Parser, t: Type) Constant {
    val line: u32 = p.tok.line;
    val col:  u32 = p.tok.column;
    if (!state.ok(p)) { ret NO_CONSTANT; }
    var c: Constant = NO_CONSTANT;
    if (state.is(p, lexer.UINT) || state.is(p, lexer.MINUS)) {
        var held: vector.Vector[u64] = vector.init[u64](p.a);
        fin { vector.dnit[u64](?held); }
        val b:         Bits                          = bits(p, t, line, col, ?held);
        val res_shape: res[table.Shape, table.Error] = table.shape(?p.m.types, t);
        if (sel res_shape.err) { ret NO_CONSTANT; }
        var data: ConstantData = ConstantData.integer{b};
        if (sel res_shape.ok.float) { data = ConstantData.float{b}; }
        c = made(p, line, col, data);
    }
    or (state.accept_word(p, "zero")) { c = made(p, line, col, ConstantData.zero{t}); }
    or (state.accept_word(p, "spec")) {
        state.expect(p, lexer.LPAREN, "(");
        val id: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        var held: vector.Vector[u64] = vector.init[u64](p.a);
        fin { vector.dnit[u64](?held); }
        val b: Bits = bits(p, t, line, col, ?held);
        state.expect(p, lexer.RPAREN, ")");
        c = made(p, line, col, ConstantData.spec{Spec{id: id, default: b}});
    }
    or (state.accept(p, lexer.ADDRESS)) {
        val named: Token = state.name(p, "a symbol");
        if (!state.ok(p)) { ret NO_CONSTANT; }
        val opt_find: opt[Symbol] = module.find(p.m, named.text);
        if (sel opt_find.none) {
            state.fail_at(p, named.line, named.column, reason.Error.unresolved{Named{what: "symbol", name: named.raw}});
            ret NO_CONSTANT;
        }
        var off: i64 = 0;
        if (state.accept(p, lexer.PLUS) || state.is(p, lexer.MINUS)) {
            val negate: bool  = state.accept(p, lexer.MINUS);
            val at:     Token = p.tok;
            val n:      u64   = state.number(p);
            if (n > 0x7fffffffffffffff + negate::u64) {
                state.fail_at(p, at.line, at.column, reason.Error.large{});
                ret NO_CONSTANT;
            }
            if (negate) { off = (0::u64 - n):~i64; }
            or          { off = n::i64; }
        }
        c = made(p, line, col, ConstantData.address{Address{type: t, symbol: opt_find.some, offset: off}});
    }
    or {
        if (!state.is(p, lexer.LBRACE) && !state.is(p, lexer.STRING)) { ty(p); }
        if (state.is(p, lexer.STRING)) {
            val run: Token = state.expect(p, lexer.STRING, "the string of a run of bytes");
            c = made(p, line, col, ConstantData.bytes{Bytes{type: t, data: Slice[u8]{data: run.text.data, size: run.text.len}}});
        }
        or {
            var elements: vector.Vector[Constant] = vector.init[Constant](p.a);
            fin { vector.dnit[Constant](?elements); }
            state.expect(p, lexer.LBRACE, "{");
            if (!state.is(p, lexer.RBRACE)) {
                for (state.ok(p)) {
                    val e: Constant = typed(p, element(p, t, elements.len));
                    state.push[Constant](p, ?elements, e);
                    if (!state.accept(p, lexer.COMMA)) { brk; }
                }
            }
            state.expect(p, lexer.RBRACE, "}");
            c = made(p, line, col, ConstantData.aggregate{Aggregate{type: t, elements: Slice[Constant]{data: elements.data, size: elements.len}}});
        }
    }
    if (state.accept(p, lexer.ASCRIBE)) { ty(p); }
    ret c;
}
