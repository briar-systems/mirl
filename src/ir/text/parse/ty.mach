# reading types and constants

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.build;
use mirl.ir.constant.Address;
use mirl.ir.constant.Aggregate;
use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.id.Constant;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal.Named;
use mirl.ir.text.parse.refusal.Reason;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Parser;
use types: mirl.ir.type;
use mirl.ir.type.Type;

val NO_TYPE:     Type     = Type{index: 0xffffffff};
val NO_CONSTANT: Constant = Constant{index: 0xffffffff};

fun intern(p: *Parser, line: u32, column: u32, s: types.Shape) Type {
    if (!state.ok(p)) { ret NO_TYPE; }
    val r: res[Type, types.Error] = types.intern(?p.m.types, s);
    if (sel r.err) {
        state.fail_at(p, line, column, Reason.types{r.err});
        ret NO_TYPE;
    }
    ret r.ok;
}

# read types separated by commas, up to a token of a kind that is left unread
fun list(p: *Parser, out: *vector.Vector[Type], close: lexer.Kind) {
    if (state.is(p, close)) { ret; }
    for {
        val t: Type = ty(p);
        state.push[Type](p, out, t);
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

fun slice_of(v: *vector.Vector[Type]) Slice[Type] {
    ret Slice[Type]{data: v.data, size: v.len};
}

# whether a word spells an integer type, and its width if it does
fun integer_width(v: View, out: *u32) bool {
    if (v.len < 2 || v.len > 8 || v.data[0] != 'i') { ret false; }
    var n: u32   = 0;
    var i: usize = 1;
    for (i < v.len) {
        if (v.data[i] < '0' || v.data[i] > '9') { ret false; }
        n = n * 10 + (v.data[i] - '0')::u32;
        i = i + 1;
    }
    @out = n;
    ret true;
}

fun format_named(v: View) opt[types.Format] {
    var i: u32 = 0;
    for (i < types.rows()) {
        val r: opt[types.Row] = types.row(types.Format{index: i});
        if (sel r.some && lexer.spelled(v, r.some.name)) { ret opt[types.Format].some{types.Format{index: i}}; }
        i = i + 1;
    }
    ret opt[types.Format].none{};
}

fun structure(p: *Parser, line: u32, column: u32) Type {
    var members: vector.Vector[Type] = vector.init[Type](p.a);
    var offsets: vector.Vector[u64]  = vector.init[u64](p.a);
    fin {
        vector.dnit[Type](?members);
        vector.dnit[u64](?offsets);
    }
    if (state.accept_word(p, "at")) {
        state.expect(p, lexer.LBRACE, "{");
        if (!state.is(p, lexer.RBRACE)) {
            for {
                val at: u64 = state.number(p);
                state.expect(p, lexer.COLON, ":");
                val t: Type = ty(p);
                state.push[u64](p, ?offsets, at);
                state.push[Type](p, ?members, t);
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACE, "}");
        ret intern(p, line, column, types.Shape.structure{types.Structure{
            members: slice_of(?members),
            offsets: opt[Slice[u64]].some{Slice[u64]{data: offsets.data, size: offsets.len}},
        }});
    }
    state.expect(p, lexer.LBRACE, "{");
    list(p, ?members, lexer.RBRACE);
    state.expect(p, lexer.RBRACE, "}");
    ret intern(p, line, column, types.Shape.structure{types.Structure{members: slice_of(?members), offsets: opt[Slice[u64]].none{}}});
}

# read a type
pub fun ty(p: *Parser) Type {
    val t: Token = p.tok;
    if (!state.ok(p)) { ret NO_TYPE; }
    if (t.kind != lexer.WORD) {
        state.expected(p, "a type");
        ret NO_TYPE;
    }
    state.advance(p);
    val v:     View = t.text;
    var width: u32;
    if (lexer.spelled(v, "ptr")) {
        var space: u32 = 0;
        if (state.accept(p, lexer.LESS)) {
            space = state.number32(p);
            state.expect(p, lexer.GREATER, ">");
        }
        ret intern(p, t.line, t.column, types.Shape.pointer{types.Pointer{space: space}});
    }
    if (lexer.spelled(v, "vec")) {
        state.expect(p, lexer.LESS, "<");
        val lanes: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        val element: Type = ty(p);
        state.expect(p, lexer.GREATER, ">");
        ret intern(p, t.line, t.column, types.Shape.vector{types.Vector{lanes: lanes, element: element}});
    }
    if (lexer.spelled(v, "array")) {
        state.expect(p, lexer.LESS, "<");
        val count: u64 = state.number(p);
        state.expect(p, lexer.COMMA, ",");
        val element: Type = ty(p);
        state.expect(p, lexer.GREATER, ">");
        ret intern(p, t.line, t.column, types.Shape.array{types.Array{count: count, element: element}});
    }
    if (lexer.spelled(v, "struct")) { ret structure(p, t.line, t.column); }
    if (lexer.spelled(v, "union")) {
        var members: vector.Vector[Type] = vector.init[Type](p.a);
        fin { vector.dnit[Type](?members); }
        state.expect(p, lexer.LBRACE, "{");
        list(p, ?members, lexer.RBRACE);
        state.expect(p, lexer.RBRACE, "}");
        ret intern(p, t.line, t.column, types.Shape.union{types.Union{members: slice_of(?members)}});
    }
    if (lexer.spelled(v, "fun")) {
        var params:  vector.Vector[Type] = vector.init[Type](p.a);
        var results: vector.Vector[Type] = vector.init[Type](p.a);
        fin {
            vector.dnit[Type](?params);
            vector.dnit[Type](?results);
        }
        state.expect(p, lexer.LPAREN, "(");
        list(p, ?params, lexer.RPAREN);
        state.expect(p, lexer.RPAREN, ")");
        state.expect(p, lexer.ARROW, "->");
        state.expect(p, lexer.LPAREN, "(");
        list(p, ?results, lexer.RPAREN);
        state.expect(p, lexer.RPAREN, ")");
        ret intern(p, t.line, t.column, types.Shape.function{types.Function{params: slice_of(?params), results: slice_of(?results)}});
    }
    if (lexer.spelled(v, "handle")) {
        state.expect(p, lexer.LESS, "<");
        val kind: View = state.name(p, "a kind name").text;
        state.expect(p, lexer.GREATER, ">");
        ret intern(p, t.line, t.column, types.Shape.handle{types.Handle{kind: kind}});
    }
    if (integer_width(v, ?width)) { ret intern(p, t.line, t.column, types.Shape.integer{types.Integer{width: width}}); }
    val f: opt[types.Format] = format_named(v);
    if (sel f.some) { ret intern(p, t.line, t.column, types.Shape.float{types.Float{format: f.some}}); }
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "type", name: t.raw}});
    ret NO_TYPE;
}

# the width of the integer or float type a number is of
fun number_width(p: *Parser, t: Type, line: u32, column: u32) u32 {
    if (!state.ok(p)) { ret 0; }
    val s: res[types.Shape, types.Error] = types.shape(?p.m.types, t);
    if (sel s.err) {
        state.fail_at(p, line, column, Reason.types{s.err});
        ret 0;
    }
    if (sel s.ok.integer) { ret s.ok.integer.width; }
    if (sel s.ok.float) {
        val r: opt[types.Row] = types.row(s.ok.float.format);
        if (sel r.some) { ret r.some.width; }
    }
    state.fail_at(p, line, column, Reason.expected{"a number of an integer or float type"});
    ret 0;
}

fun nibble(c: u8) u64 {
    if (c <= '9') { ret (c - '0')::u64; }
    ret (c - 'a')::u64 + 10;
}

# the words of a number of a width, low word first, negated when it is written with a `-`
fun words(p: *Parser, tk: Token, width: u32, negate: bool, out: *vector.Vector[u64]) {
    val count: usize = ((width + 63) / 64)::usize;
    var i:     usize = 0;
    for (i < count) {
        state.push[u64](p, out, 0);
        i = i + 1;
    }
    if (!state.ok(p)) { ret; }
    val v: View = tk.text;
    if (v.len > 2 && v.data[1] == 'x') {
        var k: usize = 0;
        for (k < v.len - 2) {
            val d: u64   = nibble(v.data[v.len - 1 - k]);
            val w: usize = k / 16;
            if (w < count) { out.data[w] = out.data[w] | (d << ((k % 16)::u64 * 4)); }
            or (d != 0) {
                state.fail_at(p, tk.line, tk.column, Reason.large{});
                ret;
            }
            k = k + 1;
        }
    }
    or {
        if (tk.wide) {
            state.fail_at(p, tk.line, tk.column, Reason.large{});
            ret;
        }
        out.data[0] = tk.value;
    }
    if (!negate) { ret; }
    var carry: u64 = 1;
    i = 0;
    for (i < count) {
        val flipped: u64 = ~out.data[i];
        var over:    u64 = 0;
        if (carry == 1 && flipped == 0xffffffffffffffff) { over = 1; }
        out.data[i] = flipped + carry;
        carry       = over;
        i           = i + 1;
    }
    val spare: u32 = width % 64;
    if (spare != 0) { out.data[count - 1] = out.data[count - 1] & ((1::u64 << spare::u64) - 1); }
}

fun number_constant(p: *Parser, t: Type, line: u32, column: u32, negate: bool) Constant {
    val tk: Token = p.tok;
    state.expect(p, lexer.UINT, "a number");
    val width: u32                = number_width(p, t, line, column);
    var held:  vector.Vector[u64] = vector.init[u64](p.a);
    fin { vector.dnit[u64](?held); }
    if (state.ok(p)) { words(p, tk, width, negate, ?held); }
    val bits: Bits                          = Bits{type: t, words: Slice[u64]{data: held.data, size: held.len}};
    val s:    res[types.Shape, types.Error] = types.shape(?p.m.types, t);
    if (!state.ok(p)) { ret NO_CONSTANT; }
    if (sel s.err)    { ret NO_CONSTANT; }
    var data: ConstantData = ConstantData.integer{bits};
    if (sel s.ok.float) { data = ConstantData.float{bits}; }
    val c: Constant = build.constant(?p.b, data);
    state.built(p, line, column);
    ret c;
}

# read a constant: its type, then its literal
pub fun constant(p: *Parser) Constant {
    val line: u32  = p.tok.line;
    val col:  u32  = p.tok.column;
    val t:    Type = ty(p);
    if (!state.ok(p)) { ret NO_CONSTANT; }
    var data:     ConstantData            = ConstantData.zero{t};
    var elements: vector.Vector[Constant] = vector.init[Constant](p.a);
    fin { vector.dnit[Constant](?elements); }
    val lit: Token = p.tok;
    if (lit.kind == lexer.UINT) { ret number_constant(p, t, line, col, false); }
    if (lit.kind == lexer.MINUS) {
        state.advance(p);
        ret number_constant(p, t, line, col, true);
    }
    if (state.is_word(p, "zero")) { state.advance(p); }
    or (lit.kind == lexer.LBRACE) {
        state.advance(p);
        if (!state.is(p, lexer.RBRACE)) {
            for {
                val e: Constant = constant(p);
                state.push[Constant](p, ?elements, e);
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACE, "}");
        data = ConstantData.aggregate{Aggregate{type: t, elements: Slice[Constant]{data: elements.data, size: elements.len}}};
    }
    or (lit.kind == lexer.SYMBOL) {
        state.advance(p);
        val s: opt[Symbol] = module.find(p.m, lit.text);
        if (sel s.none) {
            state.fail_at(p, lit.line, lit.column, Reason.unresolved{Named{what: "symbol", name: lit.raw}});
            ret NO_CONSTANT;
        }
        var off: i64 = 0;
        if (state.accept(p, lexer.PLUS))  { off = state.number(p)::i64; }
        or (state.accept(p, lexer.MINUS)) { off = 0 - state.number(p)::i64; }
        data = ConstantData.address{Address{type: t, symbol: s.some, offset: off}};
    }
    or                { state.expected(p, "a constant"); }
    if (!state.ok(p)) { ret NO_CONSTANT; }
    val c: Constant = build.constant(?p.b, data);
    state.built(p, line, col);
    ret c;
}
