# why the parser refused a text, the level below the refusal that says where

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.build.failure;
use mirl.build.failure.Work;
use debug_record: mirl.ir.debug.record;
use debug_table:  mirl.ir.debug.table;
use mirl.ir.module;
use mirl.ir.text.printer;
use type_table: mirl.ir.type.table;

# a name and what kind of thing it names
# ---
# what: the kind of thing, such as `value` or `block`
# name: the name as the text spells it, a view of the text
pub rec Named {
    what: str;
    name: View;
}

# why a text was refused
# ---
# expected:    the text has something else where this should be
# unexpected:  a byte or token the grammar has no place for, and why
# large:       a number too large for where it stands
# unversioned: the text does not start with the version statement it must
#              start with
# version:     the text was written by this version of mirl, not ours, as
#              the text spells it with its quotes: a view of the text
# unknown:     a name no row or table knows
# unresolved:  a name nothing defines, or that is only defined by what needs it
# duplicate:   a name defined twice in the scope it is defined in
# unsupported: a construct the text form reserves and this reader does not read
# results:     an instruction that gives this many results, not as many as
#              the statement names
# build:       the builder refused an instruction, block or global
# ir:          the module refused an item
# types:       the type table refused a type
# debug:       the debug table refused an entry
# alloc:       the allocator refused storage
# form:        a form read through this parser refused in its own terms, which
#              that form's reading keeps
pub tag Error: u8 {
    expected:   str;
    unexpected: str;
    large;
    unversioned;
    version:     View;
    unknown:     Named;
    unresolved:  Named;
    duplicate:   Named;
    unsupported: str;
    results:     u32;
    build:       failure.Error;
    ir:          module.Error;
    types:       type_table.Error;
    debug:       debug_table.Error;
    alloc:       allocator.Error;
    form;
}

fun keep(first: *err[WriteError], r: err[WriteError]) {
    if (sel r.err && sel first.ok) { @first = r; }
}

fun put(first: *err[WriteError], w: *io.Writer, s: str) {
    val r: res[usize, WriteError] = format.write_str(w, s);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_number(first: *err[WriteError], w: *io.Writer, n: u64) {
    val r: res[usize, WriteError] = format.write_u64(w, n);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_name(first: *err[WriteError], w: *io.Writer, v: View) {
    val r: res[usize, WriteError] = format.write_bytes(w, v.data, v.len);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

# write an entry of the debug table by its printed name, its kind letter and id
fun put_entry(first: *err[WriteError], w: *io.Writer, letter: str, index: u32) {
    put(first, w, letter);
    put_number(first, w, index::u64);
}

fun debug_kind(k: debug_record.Kind) str {
    if (sel k.base)        { ret "a base type"; }
    if (sel k.structure)   { ret "a structure"; }
    if (sel k.union)       { ret "a union"; }
    if (sel k.tagged)      { ret "a tagged union"; }
    if (sel k.enumeration) { ret "an enumeration"; }
    if (sel k.array)       { ret "an array"; }
    if (sel k.pointer)     { ret "a pointer"; }
    ret "a function";
}

fun type_kind(k: type_table.Kind) str {
    if (sel k.integer)   { ret "an integer"; }
    if (sel k.float)     { ret "a float"; }
    if (sel k.pointer)   { ret "a pointer"; }
    if (sel k.vector)    { ret "a vector"; }
    if (sel k.array)     { ret "an array"; }
    if (sel k.structure) { ret "a structure"; }
    if (sel k.union)     { ret "a union"; }
    if (sel k.function)  { ret "a function"; }
    ret "a handle";
}

# write which rule of the debug table an entry broke
fun debug_reason(first: *err[WriteError], w: *io.Writer, e: debug_table.Error) {
    if (sel e.alloc) { put(first, w, "out of memory"); }
    or (sel e.types) {
        put(first, w, "the type table refused a read of its layout");
        val te: type_table.Error = e.types;
        if (sel te.kind) {
            put(first, w, ", which is ");
            put(first, w, type_kind(te.kind));
        }
    }
    or (sel e.empty) { put(first, w, "a key, path or callee is empty"); }
    or (sel e.width) { put(first, w, "a base type is of width zero"); }
    or (sel e.unknown) {
        put(first, w, "debug type ");
        put_entry(first, w, "t", e.unknown);
        put(first, w, " is not in the table");
    }
    or (sel e.file) {
        put(first, w, "file ");
        put_entry(first, w, "f", e.file);
        put(first, w, " is not in the table");
    }
    or (sel e.location) {
        put(first, w, "location ");
        put_entry(first, w, "l", e.location);
        put(first, w, " is not in the table");
    }
    or (sel e.site) {
        put(first, w, "site ");
        put_entry(first, w, "s", e.site);
        put(first, w, " is not in the table");
    }
    or (sel e.binding) {
        put(first, w, "variable ");
        put_entry(first, w, "v", e.binding);
        put(first, w, " is not in the table");
    }
    or (sel e.kind) {
        put(first, w, "the entry it reads is ");
        put(first, w, debug_kind(e.kind));
        put(first, w, ", not the kind it needs");
    }
    or (sel e.conflict) {
        put(first, w, "its key already names ");
        put_entry(first, w, "t", e.conflict);
        put(first, w, ", described otherwise");
    }
    or (sel e.defined) {
        put_entry(first, w, "t", e.defined);
        put(first, w, " is already defined");
    }
    or (sel e.open) {
        put_entry(first, w, "t", e.open);
        put(first, w, " is declared and not yet defined");
    }
    or (sel e.layout) {
        put(first, w, "it is laid out as ");
        put(first, w, type_kind(e.layout));
        put(first, w, ", not the kind it needs");
    }
    or (sel e.field) {
        put(first, w, "field ");
        put_number(first, w, e.field::u64);
        put(first, w, " is not a field of its layout");
    }
    or (sel e.agree) {
        put(first, w, "the member of ");
        put_entry(first, w, "t", e.agree.owner);
        put(first, w, " at field ");
        put_number(first, w, e.agree.field::u64);
        put(first, w, " is not laid out as that field of its layout");
    }
    or (sel e.carried) {
        put(first, w, "case ");
        put_number(first, w, e.carried::u64);
        put(first, w, " has its payload in a field of the layout that is no union");
    }
    or (sel e.pointee) {
        put(first, w, "no entry is described under the pointee key \"");
        put_name(first, w, e.pointee);
        put(first, w, "\"");
    }
    or (sel e.pending) {
        put(first, w, "the pointee of pointer ");
        put_entry(first, w, "t", e.pending);
        put(first, w, " is not linked yet");
    }
    or {
        put(first, w, "an entry described outside the module is ");
        put(first, w, debug_kind(e.outside));
        put(first, w, ", not a structure, union or tagged union");
    }
}

# write why a text was refused, as the reason alone
pub fun describe(w: *io.Writer, why: Error) err[WriteError] {
    var first: err[WriteError] = err[WriteError].ok{};
    if (sel why.expected) {
        put(?first, w, "expected ");
        put(?first, w, why.expected);
    }
    or (sel why.unexpected) { put(?first, w, why.unexpected); }
    or (sel why.large)      { put(?first, w, "number too large"); }
    or (sel why.version) {
        put(?first, w, "version ");
        put_name(?first, w, why.version);
        put(?first, w, " is not the version this library reads, \"");
        put(?first, w, printer.VERSION);
        put(?first, w, "\"");
    }
    or (sel why.unversioned) {
        put(?first, w, "expected the version statement `mirl \"");
        put(?first, w, printer.VERSION);
        put(?first, w, "\";` first");
    }
    or (sel why.unknown) {
        put(?first, w, "unknown ");
        put(?first, w, why.unknown.what);
        put(?first, w, " \"");
        put_name(?first, w, why.unknown.name);
        put(?first, w, "\"");
    }
    or (sel why.unresolved) {
        put(?first, w, "unresolved ");
        put(?first, w, why.unresolved.what);
        put(?first, w, " \"");
        put_name(?first, w, why.unresolved.name);
        put(?first, w, "\"");
    }
    or (sel why.duplicate) {
        put(?first, w, why.duplicate.what);
        put(?first, w, " \"");
        put_name(?first, w, why.duplicate.name);
        put(?first, w, "\" is defined twice");
    }
    or (sel why.unsupported) {
        put(?first, w, why.unsupported);
        put(?first, w, " is not supported yet");
    }
    or (sel why.results) {
        put(?first, w, "the instruction gives ");
        put_number(?first, w, why.results::u64);
        put(?first, w, " results");
    }
    or (sel why.build) {
        val work: Work = why.build.work;
        if (sel work.bind) { put(?first, w, "the builder refused the value binding record"); }
        or                 { put(?first, w, "the builder refused the instruction"); }
    }
    or (sel why.ir)    { put(?first, w, "the module refused the item"); }
    or (sel why.types) { put(?first, w, "the type table refused the type"); }
    or (sel why.debug) {
        put(?first, w, "the debug table refused the entry: ");
        debug_reason(?first, w, why.debug);
    }
    or (sel why.form) { put(?first, w, "the form read through the text refused it"); }
    or                { put(?first, w, "out of memory"); }
    ret first;
}
