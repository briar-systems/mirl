# reading the items of a module: globals, functions and attributes
#
# a global or function is declared when its line is read, so every symbol
# exists before a constant names one. a global's initial value, a body and an
# attribute are read later from the position saved here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mink.lib.model.symbol;
use mirl.build;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.function.FunctionData;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal.Named;
use mirl.ir.text.parse.refusal.Reason;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.parse.ty;
use mirl.ir.type.Type;

# a global whose initial value is still to be read
# ---
# global: the global
# at:     the start of the value
pub rec Initial {
    global: Global;
    at:     Mark;
}

# a function whose body is still to be read
# ---
# function: the function
# at:       its `{`
# placed:   the list of its entry's places, when its line states one
pub rec Body {
    function: Function;
    at:       Mark;
    placed:   opt[Mark];
}

fun linkage(p: *Parser, t: Token) *symbol.Binding {
    val v: View  = t.text;
    var i: usize = 0;
    for (i < symbol.binding_count()) {
        val b: *symbol.Binding = symbol.binding_at(i);
        if (lexer.spelled(v, b.name)) { ret b; }
        i = i + 1;
    }
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "linkage", name: t.raw}});
    ret symbol.binding_at(0);
}

fun visibility(p: *Parser, t: Token) *symbol.Visibility {
    val v: View  = t.text;
    var i: usize = 0;
    for (i < symbol.visibility_count()) {
        val s: *symbol.Visibility = symbol.visibility_at(i);
        if (lexer.spelled(v, s.name)) { ret s; }
        i = i + 1;
    }
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "visibility", name: t.raw}});
    ret symbol.visibility_at(0);
}

fun tls(p: *Parser) Tls {
    if (state.accept_word(p, "general_dynamic")) { ret Tls.general_dynamic{}; }
    if (state.accept_word(p, "local_dynamic"))   { ret Tls.local_dynamic{}; }
    if (state.accept_word(p, "initial_exec"))    { ret Tls.initial_exec{}; }
    if (state.accept_word(p, "local_exec"))      { ret Tls.local_exec{}; }
    state.expected(p, "a tls model");
    ret Tls.local_exec{};
}

fun export(p: *Parser, t: Token, s: Symbol) {
    if (!state.ok(p)) { ret; }
    val r: err[module.Error] = module.export(p.m, s);
    if (sel r.err) { state.fail_at(p, t.line, t.column, Reason.ir{r.err}); }
}

# read a global's line, declaring it without its initial value
pub fun global(p: *Parser, exported: bool, initials: *vector.Vector[Initial]) {
    state.advance(p);
    val sym: Token = state.expect(p, lexer.SYMBOL, "a symbol");
    state.expect(p, lexer.COLON, ":");
    val type: Type = ty.ty(p);
    state.expect_word(p, "linkage");
    val lname: Token = state.name(p, "a linkage");
    state.expect_word(p, "visibility");
    val vname:     Token     = state.name(p, "a visibility");
    var alignment: opt[u64]  = opt[u64].none{};
    var section:   opt[View] = opt[View].none{};
    var model:     opt[Tls]  = opt[Tls].none{};
    if (state.accept_word(p, "align"))   { alignment = opt[u64].some{state.number(p)}; }
    if (state.accept_word(p, "section")) { section = opt[View].some{state.expect(p, lexer.STRING, "a string").text}; }
    if (state.accept_word(p, "tls"))     { model = opt[Tls].some{tls(p)}; }
    var at:  Mark = state.mark(p);
    var has: bool = false;
    if (state.accept(p, lexer.EQUALS)) {
        at  = state.mark(p);
        has = true;
        state.skip_line(p);
    }
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    val link: *symbol.Binding    = linkage(p, lname);
    val vis:  *symbol.Visibility = visibility(p, vname);
    if (!state.ok(p)) { ret; }
    val g: Global = build.global(?p.b, GlobalData{name: sym.text, type: type, initial: opt[Constant].none{}, alignment: alignment, section: section, tls: model, linkage: link, visibility: vis});
    state.built(p, sym.line, sym.column);
    if (!state.ok(p)) { ret; }
    if (exported)     { export(p, sym, Symbol.global{g}); }
    if (has)          { state.push[Initial](p, initials, Initial{global: g, at: at}); }
}

# read a function's line, declaring it and saving where its body starts
pub fun function(p: *Parser, exported: bool, bodies: *vector.Vector[Body]) {
    state.advance(p);
    val sym: Token = state.expect(p, lexer.SYMBOL, "a symbol");
    state.expect(p, lexer.COLON, ":");
    val sig:    Type      = ty.ty(p);
    val held:   bool      = state.accept_word(p, "constant_time");
    var placed: opt[Mark] = opt[Mark].none{};
    if (state.accept_word(p, "placed")) {
        placed = opt[Mark].some{state.mark(p)};
        state.expect(p, lexer.LBRACKET, "[");
        for (state.ok(p) && !state.is(p, lexer.RBRACKET) && !state.is(p, lexer.NEWLINE) && !state.is(p, lexer.END)) { state.advance(p); }
        state.expect(p, lexer.RBRACKET, "]");
    }
    if (!state.ok(p)) { ret; }
    val f: Function = build.function(?p.b, FunctionData{name: sym.text, signature: sig, constant_time: held});
    state.built(p, sym.line, sym.column);
    if (!state.ok(p)) { ret; }
    if (state.is(p, lexer.LBRACE)) {
        state.push[Body](p, bodies, Body{function: f, at: state.mark(p), placed: placed});
        state.skip_braces(p);
    }
    or (sel placed.some) { state.expected(p, "the body whose entry the places are of"); }
    state.expect_end(p);
    if (exported) { export(p, sym, Symbol.function{f}); }
}

# read a global's initial value and give it to the global
pub fun initial(p: *Parser, i: Initial) {
    state.rewind(p, i.at);
    val line: u32      = p.tok.line;
    val col:  u32      = p.tok.column;
    val c:    Constant = ty.constant(p);
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    build.initial(?p.b, i.global, c);
    state.built(p, line, col);
}

# read an attribute line and attach it to its symbol
pub fun attribute(p: *Parser, at: Mark) {
    state.rewind(p, at);
    state.advance(p);
    val sym:    Token = state.expect(p, lexer.SYMBOL, "a symbol");
    val family: View  = state.name(p, "a family").text;
    val name:   View  = state.name(p, "a name").text;
    state.expect(p, lexer.EQUALS, "=");
    var integers: vector.Vector[u64] = vector.init[u64](p.a);
    fin { vector.dnit[u64](?integers); }
    var datum: Datum = Datum.integer{0};
    if (state.is(p, lexer.UINT)) { datum = Datum.integer{state.number(p)}; }
    or (state.accept(p, lexer.LBRACKET)) {
        if (!state.is(p, lexer.RBRACKET)) {
            for {
                state.push[u64](p, ?integers, state.number(p));
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
        datum = Datum.integers{Slice[u64]{data: integers.data, size: integers.len}};
    }
    or (state.is(p, lexer.STRING)) { datum = Datum.text{state.expect(p, lexer.STRING, "a string").text}; }
    or                             { state.expected(p, "a number, a list or a string"); }
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    val found: opt[Symbol] = module.find(p.m, sym.text);
    if (sel found.none) {
        state.fail_at(p, sym.line, sym.column, Reason.unresolved{Named{what: "symbol", name: sym.raw}});
        ret;
    }
    val r: err[module.Error] = module.attach(p.m, found.some, Attribute{family: family, name: name, datum: datum});
    if (sel r.err) { state.fail_at(p, sym.line, sym.column, Reason.ir{r.err}); }
}
