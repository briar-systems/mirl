# reading the items of a module: typedefs, globals and functions
#
# a global or function is declared when its statement is read, so every
# symbol exists before a literal names one. a global's initial value and a
# body are read later from the position saved here, and a symbol's attribute
# decorators once the symbol is declared.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.section;
use mink.model.symbol;
use mirl.build.builder;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.debug.record;
use mirl.ir.function.ConstantTime;
use mirl.ir.function.Effects;
use mirl.ir.function.FunctionData;
use mirl.ir.function.Inlining;
use mirl.ir.function.Reach;
use mirl.ir.function.Summary;
use globals: mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.text.notes;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.reason;
use mirl.ir.text.parse.reason.Named;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.parse.ty;
use mirl.ir.type.calling;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;

# a global whose initial value is still to be read
# ---
# global: the global
# at:     the start of the value
pub rec Initial {
    global: Global;
    at:     Mark;
}

# a global whose debug variable is still to be resolved, since the debug
# table may come after it
# ---
# global: the global
# name:   the variable's name
pub rec Described {
    global: Global;
    name:   Token;
}

# a function whose body is still to be read
# ---
# function:   the function
# parameters: its parameter list, which names the entry block's parameters
# at:         its `{`
# placed:     the list of its entry's places, when it is placed
pub rec Body {
    function:   Function;
    parameters: Mark;
    at:         Mark;
    placed:     opt[Mark];
}

# a secret parameter a function's decorator states: its position, and the run of its ranges, none for one secret whole
# ---
# position: the parameter, by its position in the signature
# first:    where its ranges start in the decorators' list of them
# count:    how many ranges it has, 0 for a parameter secret whole
rec Stated {
    position: u64;
    first:    usize;
    count:    usize;
}

# the decorators of a symbol
# ---
# export:            a shared image exports it
# replaceable:       a definition elsewhere may stand for it
# merged:            the identity of the merged definition it is
# binding:           the binding a decorator states, none for the one its words give
# visibility:        the visibility a decorator names
# alignment:         its alignment, a global's or a function's entry's
# section:           the section it is placed in, a global's or a function's
# tls:               its thread-local model, a global's
# debug:             the name of the debug variable it is, a global's
# secret:            the token of its secret ranges, a global's, none when it states none
# ranges:            its secret ranges, a global's
# timed:             how it holds its time independent of its secrets, a function's
# init:              the priority the image's loader runs it at, a function's
# secret_parameters: the token of its secret parameters, a function's, none
#                    when it states none
# parameters:        each secret parameter it states, a function's
# parameter_ranges:  the secret ranges of those parameters, each one's a run
# secret_result:     the token of its secret result, a function's, none when it states none
# result_ranges:     the secret ranges of its result, a function's, none for one secret whole
# result_follows:    whether its result holds a secret only where an argument does, a function's
# pointers:          the positions of its public pointers, a function's
# effects:           what a call of it may do, a function's, unstated when it states none
# inlining:          whether a call of it is expanded in place, a function's, unstated when it states nothing
# scalar:            its loops are never vectorised, a function's
# available:         its body is a copy of another module's definition, a function's
# convention:        the convention row its signature names, a function's
# signature:         the signature a placed function's entry is placed by
# placed:            the list of its entry's places
# extensions:        the extensions it may use past the build's, a function's, as
#                    its text spells them
# attributes:        where each attribute of a target family starts
rec Decorators {
    export:            bool;
    replaceable:       bool;
    merged:            opt[u64];
    binding:           opt[Token];
    visibility:        opt[Token];
    alignment:         opt[u64];
    section:           opt[globals.Section];
    tls:               opt[Tls];
    debug:             opt[Token];
    secret:            opt[Token];
    ranges:            vector.Vector[globals.Range];
    timed:             ConstantTime;
    init:              opt[u32];
    secret_parameters: opt[Token];
    parameters:        vector.Vector[Stated];
    parameter_ranges:  vector.Vector[globals.Range];
    secret_result:     opt[Token];
    result_ranges:     vector.Vector[globals.Range];
    result_follows:    bool;
    pointers:          vector.Vector[u32];
    effects:           Effects;
    inlining:          Inlining;
    scalar:            bool;
    available:         bool;
    convention:        opt[calling.Calling];
    signature:         opt[Type];
    placed:            opt[Mark];
    extensions:        vector.Vector[View];
    attributes:        vector.Vector[Mark];
}

# decorators that state nothing, their lists taking storage from the parser's allocator
fun none(p: *Parser) Decorators {
    ret Decorators{
        export:            false,
        replaceable:       false,
        merged:            opt[u64].none{},
        binding:           opt[Token].none{},
        visibility:        opt[Token].none{},
        alignment:         opt[u64].none{},
        section:           opt[globals.Section].none{},
        tls:               opt[Tls].none{},
        debug:             opt[Token].none{},
        secret:            opt[Token].none{},
        ranges:            vector.init[globals.Range](p.a),
        timed:             ConstantTime.none{},
        init:              opt[u32].none{},
        secret_parameters: opt[Token].none{},
        parameters:        vector.init[Stated](p.a),
        parameter_ranges:  vector.init[globals.Range](p.a),
        secret_result:     opt[Token].none{},
        result_ranges:     vector.init[globals.Range](p.a),
        result_follows:    false,
        pointers:          vector.init[u32](p.a),
        effects:           Effects.unstated{},
        inlining:          Inlining.unstated{},
        scalar:            false,
        available:         false,
        convention:        opt[calling.Calling].none{},
        signature:         opt[Type].none{},
        placed:            opt[Mark].none{},
        extensions:        vector.init[View](p.a),
        attributes:        vector.init[Mark](p.a),
    };
}

# a section's name and the row of mink's section kinds its kind's name names, refusing a name of none
fun placed_in(p: *Parser) globals.Section {
    val name: View = state.expect(p, lexer.STRING, "a section's name").text;
    state.expect(p, lexer.COMMA, ",");
    val kind: Token           = state.name(p, "a section kind");
    var out:  globals.Section = globals.Section{name: name, kind: nil};
    if (!state.ok(p)) { ret out; }
    var i: usize = 0;
    for (i < section.count()) {
        if (lexer.spelled(kind.text, section.at(i).name)) { out.kind = section.at(i); }
        i = i + 1;
    }
    if (out.kind == nil) { state.fail_at(p, kind.line, kind.column, reason.Error.unknown{Named{what: "section kind", name: kind.raw}}); }
    ret out;
}

fun tls(p: *Parser) Tls {
    if (state.accept_word(p, "general_dynamic")) { ret Tls.general_dynamic{}; }
    if (state.accept_word(p, "local_dynamic"))   { ret Tls.local_dynamic{}; }
    if (state.accept_word(p, "initial_exec"))    { ret Tls.initial_exec{}; }
    if (state.accept_word(p, "local_exec"))      { ret Tls.local_exec{}; }
    state.expected(p, "a tls model");
    ret Tls.local_exec{};
}

# a global's secret ranges, each `[offset, length]`, at least one
fun ranges(p: *Parser, out: *vector.Vector[globals.Range]) {
    for (state.ok(p)) {
        state.expect(p, lexer.LBRACKET, "[");
        val offset: u64 = state.number(p);
        state.expect(p, lexer.COMMA, ",");
        val length: u64 = state.number(p);
        state.expect(p, lexer.RBRACKET, "]");
        state.push[globals.Range](p, out, globals.Range{offset: offset, length: length});
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# a function's secret parameters, each a position alone for one secret whole or followed by its secret ranges, each
# `[offset, length]`, at least one
fun secret_parameters(p: *Parser, out: *vector.Vector[Stated], ranges: *vector.Vector[globals.Range]) {
    for (state.ok(p)) {
        val position: u64   = state.number(p);
        val first:    usize = ranges.len;
        for (state.ok(p) && state.accept(p, lexer.LBRACKET)) {
            val offset: u64 = state.number(p);
            state.expect(p, lexer.COMMA, ",");
            val length: u64 = state.number(p);
            state.expect(p, lexer.RBRACKET, "]");
            state.push[globals.Range](p, ranges, globals.Range{offset: offset, length: length});
        }
        state.push[Stated](p, out, Stated{position: position, first: first, count: ranges.len - first});
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# the secrecy of each of `count` parameters `d` states, each public that it does not name, into `out`, whose ranges are
# the decorators' own. refused where it names a parameter past `count` or one twice
fun secrecy_of(p: *Parser, d: *Decorators, at: Token, count: usize, out: *vector.Vector[globals.Secrecy]) {
    if (sel d.secret_parameters.none) { ret; }
    var i: usize = 0;
    for (i < count) {
        state.push[globals.Secrecy](p, out, globals.Secrecy.public{});
        i = i + 1;
    }
    i = 0;
    for (i < d.parameters.len && state.ok(p)) {
        val x: Stated = d.parameters.data[i];
        if (x.position >= count::u64) {
            state.fail_at(p, at.line, at.column, reason.Error.unexpected{"a secret parameter past the signature's parameters"});
            ret;
        }
        val was: globals.Secrecy = out.data[x.position::usize];
        if (!(sel was.public)) {
            state.fail_at(p, at.line, at.column, reason.Error.unexpected{"a secret parameter stated twice"});
            ret;
        }
        if (x.count == 0) { out.data[x.position::usize] = globals.Secrecy.whole{}; }
        or                { out.data[x.position::usize] = globals.Secrecy.ranges{Slice[globals.Range]{data: ?d.parameter_ranges.data[x.first], size: x.count}}; }
        i = i + 1;
    }
}

# whether a word names an attribute of a target family: a family, a dot and
# the attribute's name
fun dotted(v: View) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == '.') { ret true; }
        i = i + 1;
    }
    ret false;
}

# read the decorators that stand before a symbol
fun decorators(p: *Parser) Decorators {
    var d: Decorators = none(p);
    for (state.ok(p) && state.accept(p, lexer.DECORATE)) {
        state.expect(p, lexer.LBRACKET, "[");
        val start: Mark  = state.mark(p);
        val w:     Token = state.expect(p, lexer.WORD, "a decorator");
        if (!state.ok(p)) { ret d; }
        if (dotted(w.text)) {
            state.push[Mark](p, ?d.attributes, start);
            if (state.is(p, lexer.LPAREN)) { state.skip_group(p); }
            or                             { state.expected(p, "("); }
        }
        or (lexer.spelled(w.text, "export"))                                  { d.export = true; }
        or (lexer.spelled(w.text, "replaceable"))                             { d.replaceable = true; }
        or (lexer.spelled(w.text, "weak") || lexer.spelled(w.text, "unique")) { d.binding = opt[Token].some{w}; }
        or (lexer.spelled(w.text, "result_follows"))                          { d.result_follows = true; }
        or (lexer.spelled(w.text, "scalar"))                                  { d.scalar = true; }
        or (lexer.spelled(w.text, "available"))                               { d.available = true; }
        or (lexer.spelled(w.text, "secret_result")) {
            # bare for a result secret whole, else its secret ranges
            d.secret_result = opt[Token].some{w};
            if (state.accept(p, lexer.LPAREN)) {
                ranges(p, ?d.result_ranges);
                state.expect(p, lexer.RPAREN, ")");
            }
        }
        or {
            state.expect(p, lexer.LPAREN, "(");
            if (lexer.spelled(w.text, "visibility"))    { d.visibility = opt[Token].some{state.name(p, "a visibility")}; }
            or (lexer.spelled(w.text, "merged"))        { d.merged = opt[u64].some{state.number(p)}; }
            or (lexer.spelled(w.text, "align"))         { d.alignment = opt[u64].some{state.number(p)}; }
            or (lexer.spelled(w.text, "section"))       { d.section = opt[globals.Section].some{placed_in(p)}; }
            or (lexer.spelled(w.text, "tls"))           { d.tls = opt[Tls].some{tls(p)}; }
            or (lexer.spelled(w.text, "debug"))         { d.debug = opt[Token].some{state.expect(p, lexer.WORD, "a debug variable")}; }
            or (lexer.spelled(w.text, "constant_time")) { d.timed = timed(p); }
            or (lexer.spelled(w.text, "init"))          { d.init = opt[u32].some{state.number32(p)}; }
            or (lexer.spelled(w.text, "secret_parameters")) {
                d.secret_parameters = opt[Token].some{w};
                secret_parameters(p, ?d.parameters, ?d.parameter_ranges);
            }
            or (lexer.spelled(w.text, "secret")) {
                d.secret = opt[Token].some{w};
                ranges(p, ?d.ranges);
            }
            or (lexer.spelled(w.text, "public_pointers")) { positions(p, ?d.pointers); }
            or (lexer.spelled(w.text, "effects"))         { d.effects = Effects.stated{effects(p)}; }
            or (lexer.spelled(w.text, "inline"))          { d.inlining = inlining(p); }
            or (lexer.spelled(w.text, "convention"))      { d.convention = ty.named_convention(p, state.name(p, "a convention row's name")); }
            or (lexer.spelled(w.text, "extensions"))      { extensions(p, ?d.extensions); }
            or (lexer.spelled(w.text, "placed")) {
                d.signature = opt[Type].some{ty.ty(p)};
                state.expect(p, lexer.COMMA, ",");
                d.placed = opt[Mark].some{state.mark(p)};
                if (state.is(p, lexer.LBRACKET)) { state.skip_group(p); }
                or                               { state.expected(p, "a list of places"); }
            }
            or { state.fail_at(p, w.line, w.column, reason.Error.unknown{Named{what: "decorator", name: w.raw}}); }
            state.expect(p, lexer.RPAREN, ")");
        }
        state.expect(p, lexer.RBRACKET, "]");
    }
    ret d;
}

# read the positions of a public_pointers decorator, one at least
fun positions(p: *Parser, out: *vector.Vector[u32]) {
    for (state.ok(p)) {
        state.push[u32](p, out, state.number32(p));
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# read the words of an effects decorator: `none`, or one at least of `reads`, `writes`, `traps` and `ends`, each once
fun effects(p: *Parser) Summary {
    var out: Summary = Summary{reads: Reach.none{}, writes: Reach.none{}, traps: false, ends: false};
    if (state.accept_word(p, "none")) { ret out; }
    var seen: u8 = 0;
    for (state.ok(p)) {
        var bit: u8 = 0;
        if (state.accept_word(p, "reads")) {
            bit       = 1;
            out.reads = Reach.anywhere{};
        }
        or (state.accept_word(p, "writes")) {
            bit        = 2;
            out.writes = Reach.anywhere{};
        }
        or (state.accept_word(p, "traps")) {
            bit       = 4;
            out.traps = true;
        }
        or (state.accept_word(p, "ends")) {
            bit      = 8;
            out.ends = true;
        }
        or {
            state.expected(p, "none, reads, writes, traps or ends");
            ret out;
        }
        if ((seen & bit) != 0) {
            state.fail(p, reason.Error.unexpected{"an effect stated twice"});
            ret out;
        }
        seen = seen | bit;
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
    ret out;
}

# read the mode of an inline decorator: always or never
fun inlining(p: *Parser) Inlining {
    if (state.accept_word(p, "always")) { ret Inlining.always{}; }
    if (state.accept_word(p, "never"))  { ret Inlining.never{}; }
    state.expected(p, "always or never");
    ret Inlining.unstated{};
}

# read the mode of a constant_time decorator: soft or hard
fun timed(p: *Parser) ConstantTime {
    if (state.accept_word(p, "soft")) { ret ConstantTime.soft{}; }
    if (state.accept_word(p, "hard")) { ret ConstantTime.hard{}; }
    state.expected(p, "soft or hard");
    ret ConstantTime.none{};
}

# read the names of an extensions decorator, each a string, one at least
fun extensions(p: *Parser, out: *vector.Vector[View]) {
    for (state.ok(p)) {
        state.push[View](p, out, state.expect(p, lexer.STRING, "an extension's name").text);
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# the row of mink's symbol bindings a name spells, nil when it spells none
fun binding_named(v: View) *symbol.Binding {
    var i: usize = 0;
    for (i < symbol.binding_count()) {
        if (lexer.spelled(v, symbol.binding_at(i).name)) { ret symbol.binding_at(i); }
        i = i + 1;
    }
    ret nil;
}

# the linkage a symbol's words and decorators give it: `pub` or `ext` bind it
# globally, no word binds it locally, `weak` or `unique` say otherwise,
# `export` and `replaceable` mark it so and `merged` states its identity
fun linkage(p: *Parser, d: *Decorators, visible: bool) Linkage {
    var l: Linkage;
    l.export      = d.export;
    l.replaceable = d.replaceable;
    l.merged      = d.merged;
    if (visible) { l.binding = binding_named(View{data: "global", len: 6}); }
    or           { l.binding = binding_named(View{data: "local", len: 5}); }
    val opt_stated: opt[Token] = d.binding;
    if (sel opt_stated.some) { l.binding = binding_named(opt_stated.some.text); }
    l.visibility = symbol.visibility_at(0);
    val opt_seen: opt[Token] = d.visibility;
    if (sel opt_seen.none) { ret l; }
    l.visibility = nil;
    var i: usize = 0;
    for (i < symbol.visibility_count()) {
        if (lexer.spelled(opt_seen.some.text, symbol.visibility_at(i).name)) { l.visibility = symbol.visibility_at(i); }
        i = i + 1;
    }
    if (l.visibility == nil) { state.fail_at(p, opt_seen.some.line, opt_seen.some.column, reason.Error.unknown{Named{what: "visibility", name: opt_seen.some.raw}}); }
    ret l;
}

# read one attribute of a target family and attach it to a symbol
fun attribute(p: *Parser, s: Symbol, at: Mark) {
    state.rewind(p, at);
    val w:   Token = state.expect(p, lexer.WORD, "an attribute");
    var dot: usize = 0;
    for (w.text.data[dot] != '.') { dot = dot + 1; }
    val family: View = View{data: w.text.data, len: dot};
    val name:   View = View{data: ?w.text.data[dot + 1], len: w.text.len - dot - 1};
    state.expect(p, lexer.LPAREN, "(");
    var integers: vector.Vector[u64] = vector.init[u64](p.a);
    fin { vector.dnit[u64](?integers); }
    var datum: Datum = Datum.integer{0};
    if (state.is(p, lexer.UINT)) { datum = Datum.integer{state.number(p)}; }
    or (state.accept(p, lexer.LBRACKET)) {
        if (!state.is(p, lexer.RBRACKET)) {
            for (state.ok(p)) {
                state.push[u64](p, ?integers, state.number(p));
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
        datum = Datum.integers{Slice[u64]{data: integers.data, size: integers.len}};
    }
    or (state.is(p, lexer.STRING)) { datum = Datum.text{state.expect(p, lexer.STRING, "a string").text}; }
    or                             { state.expected(p, "a number, a list or a string"); }
    state.expect(p, lexer.RPAREN, ")");
    if (!state.ok(p)) { ret; }
    if (family.len == 0 || name.len == 0) {
        state.fail_at(p, w.line, w.column, reason.Error.expected{"a family and an attribute's name"});
        ret;
    }
    val err_attach: err[module.Error] = module.attach(p.m, s, Attribute{family: family, name: name, datum: datum});
    if (sel err_attach.err) { state.fail_at(p, w.line, w.column, reason.Error.ir{err_attach.err}); }
}

# attach a declared symbol's attributes, as its decorators say
fun decorate(p: *Parser, d: *Decorators, s: Symbol) {
    if (d.attributes.len == 0) { ret; }
    val after: Mark  = state.mark(p);
    var i:     usize = 0;
    for (i < d.attributes.len && state.ok(p)) {
        attribute(p, s, d.attributes.data[i]);
        i = i + 1;
    }
    state.rewind(p, after);
}

# refuse a decorator of a global on a function, or of a function on a global
fun only(p: *Parser, d: *Decorators, at: Token, global: bool) {
    var wrong: bool = false;
    if (global) { wrong = !(sel d.timed.none) || sel d.init.some || sel d.secret_parameters.some || sel d.secret_result.some || d.result_follows || d.pointers.len != 0 || sel d.effects.stated || !(sel d.inlining.unstated) || d.scalar || d.available || sel d.convention.some || sel d.placed.some || d.extensions.len != 0; }
    or          { wrong = sel d.tls.some || sel d.secret.some || sel d.debug.some; }
    if (wrong)  { state.fail_at(p, at.line, at.column, reason.Error.unexpected{"a decorator this kind of symbol does not take"}); }
}

# read a typedef: `rec` or `uni`, a name and its members, interning the type
# and naming it and its members unless the text spells them as unnamed
pub fun typedef(p: *Parser) {
    val structure: bool  = state.is_word(p, "rec");
    val w:         Token = p.tok;
    state.advance(p);
    val n: Token = state.expect(p, lexer.WORD, "a type's name");
    if (state.ok(p) && ty.keyword(n.text)) { state.fail_at(p, n.line, n.column, reason.Error.unexpected{"a type word as a typedef's name"}); }
    var names:   vector.Vector[Token] = vector.init[Token](p.a);
    var members: vector.Vector[Type]  = vector.init[Type](p.a);
    var offsets: vector.Vector[u64]   = vector.init[u64](p.a);
    var spelled: vector.Vector[View]  = vector.init[View](p.a);
    fin {
        vector.dnit[Token](?names);
        vector.dnit[Type](?members);
        vector.dnit[u64](?offsets);
        vector.dnit[View](?spelled);
    }
    val stated: ty.Traits = ty.traits(p);
    val placed: usize     = ty.members(p, ?names, ?members, ?offsets);
    val closed: u32       = p.last;
    val t:      Type      = ty.aggregate(p, w.line, w.column, structure, stated, ?members, ?offsets, placed);
    if (!state.ok(p)) { ret; }
    state.note(p, w.line, notes.at(notes.TYPEDEF, t, 0));
    var m: usize = 0;
    for (m < names.len) {
        state.note(p, names.data[m].line, notes.at(notes.MEMBER, t, m::u32));
        m = m + 1;
    }
    state.note(p, closed, notes.at(notes.TYPEDEF_END, t, 0));
    val opt_before: opt[table.Naming] = table.naming(?p.m.types, t);
    val held:       bool              = sel opt_before.some;
    if (held && !p.bind) {
        state.fail_at(p, n.line, n.column, reason.Error.duplicate{Named{what: "typedef of a type", name: n.raw}});
        ret;
    }
    var named: bool  = !state.unnamed(n.text, 'T');
    var i:     usize = 0;
    for (i < names.len) {
        var v: View = names.data[i].text;
        if (state.unnamed(v, '_')) { v = View{data: nil, len: 0}; }
        or                         { named = true; }
        state.push[View](p, ?spelled, v);
        i = i + 1;
    }
    state.define(p, ?p.types, "type", n, t);
    state.push[state.Typedef](p, ?p.named, state.Typedef{type: t, first: p.members.len, count: names.len});
    i = 0;
    for (i < names.len) {
        state.push[View](p, ?p.members, names.data[i].text);
        i = i + 1;
    }
    # a bound text's typedef of a type the module names already reads as that type, which keeps the module's names
    if (!named || held || !state.ok(p)) { ret; }
    val err_name: err[table.Error] = table.name(?p.m.types, t, n.text, Slice[View]{data: spelled.data, size: spelled.len});
    if (sel err_name.err) { state.fail_at(p, n.line, n.column, reason.Error.types{err_name.err}); }
}

# read a global's statement after its decorators and words, declaring it
# without its initial value
fun global(p: *Parser, d: *Decorators, start: u32, at: Token, external: bool, visible: bool, initials: *vector.Vector[Initial], described: *vector.Vector[Described]) {
    only(p, d, at, true);
    val constant: bool = state.is_word(p, "val");
    state.advance(p);
    val sym: Token = state.name(p, "a symbol");
    state.expect(p, lexer.COLON, ":");
    val whole: Token = p.tok;
    val all:   bool  = state.accept(p, lexer.SECRET);
    val type:  Type  = ty.ty(p);
    var value: Mark  = state.mark(p);
    val has:   bool  = state.accept(p, lexer.EQUALS);
    if (has) {
        value = state.mark(p);
        state.skip_statement(p);
    }
    state.expect_end(p);
    if (!state.ok(p))             { ret; }
    if (external && has)          { state.fail_at(p, at.line, at.column, reason.Error.unexpected{"an initial value of a global another module defines"}); }
    if (!external && !has)        { state.fail_at(p, at.line, at.column, reason.Error.expected{"an initial value, or `ext` for a global another module defines"}); }
    if (all && sel d.secret.some) { state.fail_at(p, whole.line, whole.column, reason.Error.unexpected{"a global secret whole that states secret ranges"}); }
    val link: Linkage = linkage(p, d, visible || external);
    if (!state.ok(p)) { ret; }
    var secret: globals.Secrecy = globals.Secrecy.public{};
    if (all)               { secret = globals.Secrecy.whole{}; }
    or (sel d.secret.some) { secret = globals.Secrecy.ranges{Slice[globals.Range]{data: d.ranges.data, size: d.ranges.len}}; }
    val opt_bound: opt[Global] = bound_global(p, sym, external);
    if (!state.ok(p)) { ret; }
    var g: Global = 0;
    if (sel opt_bound.some) { g = opt_bound.some; }
    or {
        g = builder.global(?p.b, GlobalData{name: builder.symbol_name(?p.b, sym.text), type: type, initial: opt[Constant].none{}, alignment: d.alignment, section: d.section, tls: d.tls, linkage: link, constant: constant, secret: secret, debug: opt[record.Binding].none{}});
        state.built(p, sym.line, sym.column);
        if (!state.ok(p)) { ret; }
        decorate(p, d, Symbol.global{g});
    }
    state.note(p, start, notes.at(notes.GLOBAL, g, 0));
    if (has)              { state.push[Initial](p, initials, Initial{global: g, at: value}); }
    if (sel d.debug.some) { state.push[Described](p, described, Described{global: g, name: d.debug.some}); }
}

# read a parameter list: each a name and a type, or a type alone when the
# function is another module's, with the extension it states, into the
# signature's lists, and a last `...` for a variadic one, only ever another
# module's
# ---
# ret: whether it ends in `...`
fun parameters(p: *Parser, external: bool, params: *vector.Vector[Type], ext: *vector.Vector[table.Extension]) bool {
    var variadic: bool = false;
    state.expect(p, lexer.LPAREN, "(");
    if (!state.is(p, lexer.RPAREN)) {
        for (state.ok(p)) {
            if (external && state.accept_word(p, ty.VARIADIC)) {
                variadic = true;
                brk;
            }
            if (!external) {
                state.expect(p, lexer.WORD, "a parameter's name");
                state.expect(p, lexer.COLON, ":");
                state.accept(p, lexer.SECRET);
            }
            state.push[Type](p, params, ty.ty(p));
            state.push[table.Extension](p, ext, ty.extension(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RPAREN, ")");
    ret variadic;
}

# read a function's statement after its decorators and words, declaring it
# and saving where its body starts
fun function(p: *Parser, d: *Decorators, start: u32, at: Token, external: bool, visible: bool, bodies: *vector.Vector[Body]) {
    only(p, d, at, false);
    state.advance(p);
    val sym:        Token                          = state.name(p, "a symbol");
    val list:       Mark                           = state.mark(p);
    var params:     vector.Vector[Type]            = vector.init[Type](p.a);
    var results:    vector.Vector[Type]            = vector.init[Type](p.a);
    var param_ext:  vector.Vector[table.Extension] = vector.init[table.Extension](p.a);
    var result_ext: vector.Vector[table.Extension] = vector.init[table.Extension](p.a);
    fin {
        vector.dnit[Type](?params);
        vector.dnit[Type](?results);
        vector.dnit[table.Extension](?param_ext);
        vector.dnit[table.Extension](?result_ext);
    }
    val variadic: bool = parameters(p, external, ?params, ?param_ext);
    ty.results(p, ?results, ?result_ext);
    var sig: Type = ty.NO_TYPE;
    if (sel d.signature.some)          { sig = d.signature.some; }
    or                                 { sig = ty.signature(p, sym.line, sym.column, ?params, ?param_ext, ?results, ?result_ext, d.convention, variadic); }
    if (!state.ok(p))                  { ret; }
    if (external && sel d.placed.some) { state.fail_at(p, at.line, at.column, reason.Error.unexpected{"places of a function another module defines"}); }
    if (external && d.available)       { state.fail_at(p, at.line, at.column, reason.Error.unexpected{"an available body on a function stated with no body"}); }
    val link: Linkage = linkage(p, d, visible || external);
    if (!state.ok(p)) { ret; }
    var secrets: vector.Vector[globals.Secrecy] = vector.init[globals.Secrecy](p.a);
    fin { vector.dnit[globals.Secrecy](?secrets); }
    val res_shape: res[table.Function, table.Error] = table.signature(?p.m.types, sig);
    if (sel res_shape.ok) { secrecy_of(p, d, at, res_shape.ok.params.size, ?secrets); }
    if (!state.ok(p))     { ret; }
    var result: globals.Secrecy = globals.Secrecy.public{};
    if (sel d.secret_result.some) {
        if (d.result_ranges.len == 0) { result = globals.Secrecy.whole{}; }
        or                            { result = globals.Secrecy.ranges{Slice[globals.Range]{data: d.result_ranges.data, size: d.result_ranges.len}}; }
    }
    val opt_bound: opt[Function] = bound_function(p, sym, sig, external);
    if (!state.ok(p)) { ret; }
    var f: Function = 0;
    if (sel opt_bound.some) {
        f = opt_bound.some;
        # how a body may be expanded is the body's, so a declaration that states nothing takes the bound body's
        if (!external && sel p.m.functions.data[f].data.inlining.unstated) { p.m.functions.data[f].data.inlining = d.inlining; }
        if (!external && d.scalar)                                         { p.m.functions.data[f].data.scalar = true; }
    }
    or {
        f = builder.function(?p.b, FunctionData{name: builder.symbol_name(?p.b, sym.text), signature: sig, linkage: link, constant_time: d.timed, extensions: Slice[View]{data: d.extensions.data, size: d.extensions.len}, alignment: d.alignment, section: d.section, secrets: Slice[globals.Secrecy]{data: secrets.data, size: secrets.len}, result: result, pointers: Slice[u32]{data: d.pointers.data, size: d.pointers.len}, follows: d.result_follows, init: d.init, effects: d.effects, inlining: d.inlining, scalar: d.scalar, available: d.available || (p.bind && !external)});
        state.built(p, sym.line, sym.column);
        if (!state.ok(p)) { ret; }
    }
    state.note(p, start, notes.at(notes.FUNCTION, f, 0));
    if (external) { state.expect_end(p); }
    or {
        if (state.is(p, lexer.LBRACE)) {
            state.push[Body](p, bodies, Body{function: f, parameters: list, at: state.mark(p), placed: d.placed});
            state.skip_group(p);
        }
        or { state.expected(p, "the function's body, or `ext` for a function another module defines"); }
    }
    if (sel opt_bound.none) { decorate(p, d, Symbol.function{f}); }
}

# the module's function a function statement binds to when the text is bound (`parse.Into.bind`), none for a name
# the module does not hold or a text read to define: an `ext` statement binds to the function of the same signature,
# and a statement with a body to its declaration of the same signature, whose body the text then gives as an
# available copy of another module's definition
fun bound_function(p: *Parser, sym: Token, sig: Type, external: bool) opt[Function] {
    if (!p.bind) { ret opt[Function].none{}; }
    val opt_held: opt[Symbol] = module.find(p.m, sym.text);
    if (sel opt_held.none) { ret opt[Function].none{}; }
    val held: Symbol = opt_held.some;
    if (sel held.function) {
        val f: Function = held.function;
        if (!table.same(sig, p.m.functions.data[f].data.signature)) {
            state.fail_at(p, sym.line, sym.column, reason.Error.rebound{Named{what: "function", name: sym.raw}});
            ret opt[Function].none{};
        }
        if (!external) {
            if (p.m.functions.data[f].body.blocks.len != 0) {
                state.fail_at(p, sym.line, sym.column, reason.Error.unexpected{"a body bound to a function the module defines"});
                ret opt[Function].none{};
            }
            p.m.functions.data[f].data.available = true;
        }
        ret opt[Function].some{f};
    }
    state.fail_at(p, sym.line, sym.column, reason.Error.unexpected{"a function bound to a name the module holds as a global"});
    ret opt[Function].none{};
}

# the module's global an `ext` global statement binds to when the text is bound (`parse.Into.bind`), none for a name
# the module does not hold or a text read to define. a bound text defines no global. the global keeps the module's
# type whatever type the text states, since a body reaches a global only through its address with the types its own
# instructions state, and a definition may state its initial value's layout where its declarations state the type
# the program reads it as
fun bound_global(p: *Parser, sym: Token, external: bool) opt[Global] {
    if (!p.bind) { ret opt[Global].none{}; }
    if (!external) {
        state.fail_at(p, sym.line, sym.column, reason.Error.unexpected{"a global defined by a bound text, which defines none"});
        ret opt[Global].none{};
    }
    val opt_held: opt[Symbol] = module.find(p.m, sym.text);
    if (sel opt_held.none) { ret opt[Global].none{}; }
    val held: Symbol = opt_held.some;
    if (sel held.global) { ret opt[Global].some{held.global}; }
    state.fail_at(p, sym.line, sym.column, reason.Error.unexpected{"a global bound to a name the module holds as a function"});
    ret opt[Global].none{};
}

# read a symbol's statement: its decorators, `pub` or `ext`, and a global or
# a function
pub fun declaration(p: *Parser, initials: *vector.Vector[Initial], described: *vector.Vector[Described], bodies: *vector.Vector[Body]) {
    val start: u32        = p.tok.line;
    var d:     Decorators = decorators(p);
    fin {
        vector.dnit[Mark](?d.attributes);
        vector.dnit[globals.Range](?d.ranges);
        vector.dnit[Stated](?d.parameters);
        vector.dnit[globals.Range](?d.parameter_ranges);
        vector.dnit[globals.Range](?d.result_ranges);
        vector.dnit[u32](?d.pointers);
        vector.dnit[View](?d.extensions);
    }
    val at:       Token = p.tok;
    val external: bool  = state.accept_word(p, "ext");
    var visible:  bool  = false;
    if (!external)                                          { visible = state.accept_word(p, "pub"); }
    if (state.is_word(p, "val") || state.is_word(p, "var")) { global(p, ?d, start, at, external, visible, initials, described); }
    or (state.is_word(p, "fun"))                            { function(p, ?d, start, at, external, visible, bodies); }
    or                                                      { state.expected(p, "an item"); }
}

# give a global the debug variable its decorator names
pub fun describe(p: *Parser, d: Described) {
    val v: u32 = state.resolve(p, ?p.vars, "variable", d.name);
    if (!state.ok(p)) { ret; }
    val err_describe_global: err[module.Error] = module.describe_global(p.m, d.global, opt[record.Binding].some{v});
    if (sel err_describe_global.err) { state.fail_at(p, d.name.line, d.name.column, reason.Error.ir{err_describe_global.err}); }
}

# read a global's initial value, of the global's type, and give it to the global
pub fun initial(p: *Parser, i: Initial) {
    state.rewind(p, i.at);
    val line:            u32                           = p.tok.line;
    val col:             u32                           = p.tok.column;
    val res_global_data: res[GlobalData, module.Error] = module.global_data(p.m, i.global);
    if (sel res_global_data.err) {
        state.fail_at(p, line, col, reason.Error.ir{res_global_data.err});
        ret;
    }
    val c: Constant = ty.typed(p, opt[Type].some{res_global_data.ok.type});
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    builder.initial(?p.b, i.global, c);
    state.built(p, line, col);
}
