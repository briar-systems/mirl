# reading the items of a module: typedefs, globals and functions
#
# a global or function is declared when its statement is read, so every
# symbol exists before a literal names one. a global's initial value and a
# body are read later from the position saved here, and a symbol's attribute
# decorators once the symbol is declared.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use mink.model.section;
use mink.model.symbol;
use mirl.build;
use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.function.FunctionData;
use globals: mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.linkage.Linkage;
use mirl.ir.module;
use mirl.ir.text.notes;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal.Named;
use mirl.ir.text.parse.refusal.Reason;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.parse.ty;
use types: mirl.ir.type;
use mirl.ir.type.Type;

# a global whose initial value is still to be read
# ---
# global: the global
# at:     the start of the value
pub rec Initial {
    global: Global;
    at:     Mark;
}

# a function whose body is still to be read
# ---
# function:   the function
# parameters: its parameter list, which names the entry block's parameters
# at:         its `{`
# placed:     the list of its entry's places, when it is placed
pub rec Body {
    function:   Function;
    parameters: Mark;
    at:         Mark;
    placed:     opt[Mark];
}

# the decorators of a symbol
# ---
# export:     it is exported, and where that is written
# binding:    the binding a decorator states, none for the one its words give
# visibility: the visibility a decorator names
# alignment:  its alignment, a global's
# section:    the section it is placed in, a global's
# tls:        its thread-local model, a global's
# secret:     the token of its secret ranges, a global's, none when it states none
# ranges:     its secret ranges, a global's
# oblivious:  it holds no secret-dependent timing, a function's
# convention: the convention row its signature names, a function's
# signature:  the signature a placed function's entry is placed by
# placed:     the list of its entry's places
# extensions: the extensions it may use past the build's, a function's, as
#             its text spells them
# attributes: where each attribute of a target family starts
rec Decorators {
    export:     opt[Token];
    binding:    opt[Token];
    visibility: opt[Token];
    alignment:  opt[u64];
    section:    opt[globals.Section];
    tls:        opt[Tls];
    secret:     opt[Token];
    ranges:     vector.Vector[globals.Range];
    oblivious:  bool;
    convention: View;
    signature:  opt[Type];
    placed:     opt[Mark];
    extensions: vector.Vector[View];
    attributes: vector.Vector[Mark];
}

fun none(p: *Parser) Decorators {
    ret Decorators{
        export:     opt[Token].none{},
        binding:    opt[Token].none{},
        visibility: opt[Token].none{},
        alignment:  opt[u64].none{},
        section:    opt[globals.Section].none{},
        tls:        opt[Tls].none{},
        secret:     opt[Token].none{},
        ranges:     vector.init[globals.Range](p.a),
        oblivious:  false,
        convention: View{data: nil, len: 0},
        signature:  opt[Type].none{},
        placed:     opt[Mark].none{},
        extensions: vector.init[View](p.a),
        attributes: vector.init[Mark](p.a),
    };
}

# a section's name and the row of mink's section kinds its kind's name names, refusing a name of none
fun placed_in(p: *Parser) globals.Section {
    val name: View = state.expect(p, lexer.STRING, "a section's name").text;
    state.expect(p, lexer.COMMA, ",");
    val kind: Token           = state.name(p, "a section kind");
    var out:  globals.Section = globals.Section{name: name, kind: nil};
    if (!state.ok(p)) { ret out; }
    var i: usize = 0;
    for (i < section.count()) {
        if (lexer.spelled(kind.text, section.at(i).name)) { out.kind = section.at(i); }
        i = i + 1;
    }
    if (out.kind == nil) { state.fail_at(p, kind.line, kind.column, Reason.unknown{Named{what: "section kind", name: kind.raw}}); }
    ret out;
}

fun tls(p: *Parser) Tls {
    if (state.accept_word(p, "general_dynamic")) { ret Tls.general_dynamic{}; }
    if (state.accept_word(p, "local_dynamic"))   { ret Tls.local_dynamic{}; }
    if (state.accept_word(p, "initial_exec"))    { ret Tls.initial_exec{}; }
    if (state.accept_word(p, "local_exec"))      { ret Tls.local_exec{}; }
    state.expected(p, "a tls model");
    ret Tls.local_exec{};
}

# a global's secret ranges, each `[offset, length]`, at least one
fun ranges(p: *Parser, out: *vector.Vector[globals.Range]) {
    for (state.ok(p)) {
        state.expect(p, lexer.LBRACKET, "[");
        val offset: u64 = state.number(p);
        state.expect(p, lexer.COMMA, ",");
        val length: u64 = state.number(p);
        state.expect(p, lexer.RBRACKET, "]");
        state.push[globals.Range](p, out, globals.Range{offset: offset, length: length});
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# whether a word names an attribute of a target family: a family, a dot and
# the attribute's name
fun dotted(v: View) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == '.') { ret true; }
        i = i + 1;
    }
    ret false;
}

# read the decorators that stand before a symbol
fun decorators(p: *Parser) Decorators {
    var d: Decorators = none(p);
    for (state.ok(p) && state.accept(p, lexer.DECORATE)) {
        state.expect(p, lexer.LBRACKET, "[");
        val start: Mark  = state.mark(p);
        val w:     Token = state.expect(p, lexer.WORD, "a decorator");
        if (!state.ok(p)) { ret d; }
        if (dotted(w.text)) {
            state.push[Mark](p, ?d.attributes, start);
            if (state.is(p, lexer.LPAREN)) { state.skip_group(p); }
            or                             { state.expected(p, "("); }
        }
        or (lexer.spelled(w.text, "export"))                                  { d.export = opt[Token].some{w}; }
        or (lexer.spelled(w.text, "weak") || lexer.spelled(w.text, "unique")) { d.binding = opt[Token].some{w}; }
        or (lexer.spelled(w.text, "oblivious"))                               { d.oblivious = true; }
        or {
            state.expect(p, lexer.LPAREN, "(");
            if (lexer.spelled(w.text, "visibility")) { d.visibility = opt[Token].some{state.name(p, "a visibility")}; }
            or (lexer.spelled(w.text, "align"))      { d.alignment = opt[u64].some{state.number(p)}; }
            or (lexer.spelled(w.text, "section"))    { d.section = opt[globals.Section].some{placed_in(p)}; }
            or (lexer.spelled(w.text, "tls"))        { d.tls = opt[Tls].some{tls(p)}; }
            or (lexer.spelled(w.text, "secret")) {
                d.secret = opt[Token].some{w};
                ranges(p, ?d.ranges);
            }
            or (lexer.spelled(w.text, "convention")) { d.convention = state.name(p, "a convention row's name").text; }
            or (lexer.spelled(w.text, "extensions")) { extensions(p, ?d.extensions); }
            or (lexer.spelled(w.text, "placed")) {
                d.signature = opt[Type].some{ty.ty(p)};
                state.expect(p, lexer.COMMA, ",");
                d.placed = opt[Mark].some{state.mark(p)};
                if (state.is(p, lexer.LBRACKET)) { state.skip_group(p); }
                or                               { state.expected(p, "a list of places"); }
            }
            or { state.fail_at(p, w.line, w.column, Reason.unknown{Named{what: "decorator", name: w.raw}}); }
            state.expect(p, lexer.RPAREN, ")");
        }
        state.expect(p, lexer.RBRACKET, "]");
    }
    ret d;
}

# read the names of an extensions decorator, each a string, one at least
fun extensions(p: *Parser, out: *vector.Vector[View]) {
    for (state.ok(p)) {
        state.push[View](p, out, state.expect(p, lexer.STRING, "an extension's name").text);
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

fun binding_named(v: View) *symbol.Binding {
    var i: usize = 0;
    for (i < symbol.binding_count()) {
        if (lexer.spelled(v, symbol.binding_at(i).name)) { ret symbol.binding_at(i); }
        i = i + 1;
    }
    ret nil;
}

# the linkage a symbol's words and decorators give it: `pub` or `ext` bind it
# globally, no word binds it locally, and `weak` or `unique` say otherwise
fun linkage(p: *Parser, d: *Decorators, visible: bool) Linkage {
    var l: Linkage;
    if (visible) { l.binding = binding_named(View{data: "global", len: 6}); }
    or           { l.binding = binding_named(View{data: "local", len: 5}); }
    val stated: opt[Token] = d.binding;
    if (sel stated.some) { l.binding = binding_named(stated.some.text); }
    l.visibility = symbol.visibility_at(0);
    val seen: opt[Token] = d.visibility;
    if (sel seen.none) { ret l; }
    l.visibility = nil;
    var i: usize = 0;
    for (i < symbol.visibility_count()) {
        if (lexer.spelled(seen.some.text, symbol.visibility_at(i).name)) { l.visibility = symbol.visibility_at(i); }
        i = i + 1;
    }
    if (l.visibility == nil) { state.fail_at(p, seen.some.line, seen.some.column, Reason.unknown{Named{what: "visibility", name: seen.some.raw}}); }
    ret l;
}

fun export(p: *Parser, t: Token, s: Symbol) {
    if (!state.ok(p)) { ret; }
    val r: err[module.Error] = module.export(p.m, s);
    if (sel r.err) { state.fail_at(p, t.line, t.column, Reason.ir{r.err}); }
}

# read one attribute of a target family and attach it to a symbol
fun attribute(p: *Parser, s: Symbol, at: Mark) {
    state.rewind(p, at);
    val w:   Token = state.expect(p, lexer.WORD, "an attribute");
    var dot: usize = 0;
    for (w.text.data[dot] != '.') { dot = dot + 1; }
    val family: View = View{data: w.text.data, len: dot};
    val name:   View = View{data: ?w.text.data[dot + 1], len: w.text.len - dot - 1};
    state.expect(p, lexer.LPAREN, "(");
    var integers: vector.Vector[u64] = vector.init[u64](p.a);
    fin { vector.dnit[u64](?integers); }
    var datum: Datum = Datum.integer{0};
    if (state.is(p, lexer.UINT)) { datum = Datum.integer{state.number(p)}; }
    or (state.accept(p, lexer.LBRACKET)) {
        if (!state.is(p, lexer.RBRACKET)) {
            for (state.ok(p)) {
                state.push[u64](p, ?integers, state.number(p));
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
        datum = Datum.integers{Slice[u64]{data: integers.data, size: integers.len}};
    }
    or (state.is(p, lexer.STRING)) { datum = Datum.text{state.expect(p, lexer.STRING, "a string").text}; }
    or                             { state.expected(p, "a number, a list or a string"); }
    state.expect(p, lexer.RPAREN, ")");
    if (!state.ok(p)) { ret; }
    if (family.len == 0 || name.len == 0) {
        state.fail_at(p, w.line, w.column, Reason.expected{"a family and an attribute's name"});
        ret;
    }
    val r: err[module.Error] = module.attach(p.m, s, Attribute{family: family, name: name, datum: datum});
    if (sel r.err) { state.fail_at(p, w.line, w.column, Reason.ir{r.err}); }
}

# export a declared symbol and attach its attributes, as its decorators say
fun decorate(p: *Parser, d: *Decorators, s: Symbol) {
    val exported: opt[Token] = d.export;
    if (sel exported.some)     { export(p, exported.some, s); }
    if (d.attributes.len == 0) { ret; }
    val after: Mark  = state.mark(p);
    var i:     usize = 0;
    for (i < d.attributes.len && state.ok(p)) {
        attribute(p, s, d.attributes.data[i]);
        i = i + 1;
    }
    state.rewind(p, after);
}

# refuse a decorator of a global on a function, or of a function on a global
fun only(p: *Parser, d: *Decorators, at: Token, global: bool) {
    var wrong: bool = false;
    if (global) { wrong = d.oblivious || d.convention.len != 0 || sel d.placed.some || d.extensions.len != 0; }
    or          { wrong = sel d.alignment.some || sel d.section.some || sel d.tls.some || sel d.secret.some; }
    if (wrong)  { state.fail_at(p, at.line, at.column, Reason.unexpected{"a decorator this kind of symbol does not take"}); }
}

# read a typedef: `rec` or `uni`, a name and its members, interning the type
# and naming it and its members unless the text spells them as unnamed
pub fun typedef(p: *Parser) {
    val structure: bool  = state.is_word(p, "rec");
    val w:         Token = p.tok;
    state.advance(p);
    val n: Token = state.expect(p, lexer.WORD, "a type's name");
    if (state.ok(p) && ty.keyword(n.text)) { state.fail_at(p, n.line, n.column, Reason.unexpected{"a type word as a typedef's name"}); }
    var names:   vector.Vector[Token] = vector.init[Token](p.a);
    var members: vector.Vector[Type]  = vector.init[Type](p.a);
    var offsets: vector.Vector[u64]   = vector.init[u64](p.a);
    var spelled: vector.Vector[View]  = vector.init[View](p.a);
    fin {
        vector.dnit[Token](?names);
        vector.dnit[Type](?members);
        vector.dnit[u64](?offsets);
        vector.dnit[View](?spelled);
    }
    val placed: usize = ty.members(p, ?names, ?members, ?offsets);
    val closed: u32   = p.last;
    val t:      Type  = ty.aggregate(p, w.line, w.column, structure, ?members, ?offsets, placed);
    if (!state.ok(p)) { ret; }
    state.note(p, w.line, notes.at(notes.TYPEDEF, t.index, 0));
    var m: usize = 0;
    for (m < names.len) {
        state.note(p, names.data[m].line, notes.at(notes.MEMBER, t.index, m::u32));
        m = m + 1;
    }
    state.note(p, closed, notes.at(notes.TYPEDEF_END, t.index, 0));
    val before: opt[types.Naming] = types.naming(?p.m.types, t);
    if (sel before.some) {
        state.fail_at(p, n.line, n.column, Reason.duplicate{Named{what: "typedef of a type", name: n.raw}});
        ret;
    }
    var named: bool  = !state.unnamed(n.text, 'T');
    var i:     usize = 0;
    for (i < names.len) {
        var v: View = names.data[i].text;
        if (state.unnamed(v, '_')) { v = View{data: nil, len: 0}; }
        or                         { named = true; }
        state.push[View](p, ?spelled, v);
        i = i + 1;
    }
    state.define(p, ?p.types, "type", n, t.index);
    state.push[state.Typedef](p, ?p.named, state.Typedef{type: t.index, first: p.members.len, count: names.len});
    i = 0;
    for (i < names.len) {
        state.push[View](p, ?p.members, names.data[i].text);
        i = i + 1;
    }
    if (!named || !state.ok(p)) { ret; }
    val r: err[types.Error] = types.name(?p.m.types, t, n.text, Slice[View]{data: spelled.data, size: spelled.len});
    if (sel r.err) { state.fail_at(p, n.line, n.column, Reason.types{r.err}); }
}

# read a global's statement after its decorators and words, declaring it
# without its initial value
fun global(p: *Parser, d: *Decorators, start: u32, at: Token, external: bool, visible: bool, initials: *vector.Vector[Initial]) {
    only(p, d, at, true);
    val constant: bool = state.is_word(p, "val");
    state.advance(p);
    val sym: Token = state.name(p, "a symbol");
    state.expect(p, lexer.COLON, ":");
    val whole: Token = p.tok;
    val all:   bool  = state.accept(p, lexer.SECRET);
    val type:  Type  = ty.ty(p);
    var value: Mark  = state.mark(p);
    val has:   bool  = state.accept(p, lexer.EQUALS);
    if (has) {
        value = state.mark(p);
        state.skip_statement(p);
    }
    state.expect_end(p);
    if (!state.ok(p))             { ret; }
    if (external && has)          { state.fail_at(p, at.line, at.column, Reason.unexpected{"an initial value of a global another module defines"}); }
    if (!external && !has)        { state.fail_at(p, at.line, at.column, Reason.expected{"an initial value, or `ext` for a global another module defines"}); }
    if (all && sel d.secret.some) { state.fail_at(p, whole.line, whole.column, Reason.unexpected{"a global secret whole that states secret ranges"}); }
    val link: Linkage = linkage(p, d, visible || external);
    if (!state.ok(p)) { ret; }
    var secret: globals.Secrecy = globals.Secrecy.public{};
    if (all)               { secret = globals.Secrecy.whole{}; }
    or (sel d.secret.some) { secret = globals.Secrecy.ranges{Slice[globals.Range]{data: d.ranges.data, size: d.ranges.len}}; }
    val g: Global = build.global(?p.b, GlobalData{name: sym.text, type: type, initial: opt[Constant].none{}, alignment: d.alignment, section: d.section, tls: d.tls, linkage: link, constant: constant, secret: secret});
    state.built(p, sym.line, sym.column);
    if (!state.ok(p)) { ret; }
    state.note(p, start, notes.at(notes.GLOBAL, g.index, 0));
    decorate(p, d, Symbol.global{g});
    if (has) { state.push[Initial](p, initials, Initial{global: g, at: value}); }
}

# read a parameter list: each a name and a type, or a type alone when the
# function is another module's, with the extension it states, into the
# signature's lists
fun parameters(p: *Parser, external: bool, params: *vector.Vector[Type], ext: *vector.Vector[types.Extension]) {
    state.expect(p, lexer.LPAREN, "(");
    if (!state.is(p, lexer.RPAREN)) {
        for (state.ok(p)) {
            if (!external) {
                state.expect(p, lexer.WORD, "a parameter's name");
                state.expect(p, lexer.COLON, ":");
                state.accept(p, lexer.SECRET);
            }
            state.push[Type](p, params, ty.ty(p));
            state.push[types.Extension](p, ext, ty.extension(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RPAREN, ")");
}

# read a function's statement after its decorators and words, declaring it
# and saving where its body starts
fun function(p: *Parser, d: *Decorators, start: u32, at: Token, external: bool, visible: bool, bodies: *vector.Vector[Body]) {
    only(p, d, at, false);
    state.advance(p);
    val sym:        Token                          = state.name(p, "a symbol");
    val list:       Mark                           = state.mark(p);
    var params:     vector.Vector[Type]            = vector.init[Type](p.a);
    var results:    vector.Vector[Type]            = vector.init[Type](p.a);
    var param_ext:  vector.Vector[types.Extension] = vector.init[types.Extension](p.a);
    var result_ext: vector.Vector[types.Extension] = vector.init[types.Extension](p.a);
    fin {
        vector.dnit[Type](?params);
        vector.dnit[Type](?results);
        vector.dnit[types.Extension](?param_ext);
        vector.dnit[types.Extension](?result_ext);
    }
    parameters(p, external, ?params, ?param_ext);
    ty.results(p, ?results, ?result_ext);
    var sig: Type = ty.NO_TYPE;
    if (sel d.signature.some)          { sig = d.signature.some; }
    or                                 { sig = ty.signature(p, sym.line, sym.column, ?params, ?param_ext, ?results, ?result_ext, d.convention); }
    if (!state.ok(p))                  { ret; }
    if (external && sel d.placed.some) { state.fail_at(p, at.line, at.column, Reason.unexpected{"places of a function another module defines"}); }
    val link: Linkage = linkage(p, d, visible || external);
    if (!state.ok(p)) { ret; }
    val f: Function = build.function(?p.b, FunctionData{name: sym.text, signature: sig, linkage: link, constant_time: d.oblivious, extensions: Slice[View]{data: d.extensions.data, size: d.extensions.len}});
    state.built(p, sym.line, sym.column);
    if (!state.ok(p)) { ret; }
    state.note(p, start, notes.at(notes.FUNCTION, f.index, 0));
    if (external) { state.expect_end(p); }
    or {
        if (state.is(p, lexer.LBRACE)) {
            state.push[Body](p, bodies, Body{function: f, parameters: list, at: state.mark(p), placed: d.placed});
            state.skip_group(p);
        }
        or { state.expected(p, "the function's body, or `ext` for a function another module defines"); }
    }
    decorate(p, d, Symbol.function{f});
}

# read a symbol's statement: its decorators, `pub` or `ext`, and a global or
# a function
pub fun declaration(p: *Parser, initials: *vector.Vector[Initial], bodies: *vector.Vector[Body]) {
    val start: u32        = p.tok.line;
    var d:     Decorators = decorators(p);
    fin {
        vector.dnit[Mark](?d.attributes);
        vector.dnit[globals.Range](?d.ranges);
        vector.dnit[View](?d.extensions);
    }
    val at:       Token = p.tok;
    val external: bool  = state.accept_word(p, "ext");
    var visible:  bool  = false;
    if (!external)                                          { visible = state.accept_word(p, "pub"); }
    if (state.is_word(p, "val") || state.is_word(p, "var")) { global(p, ?d, start, at, external, visible, initials); }
    or (state.is_word(p, "fun"))                            { function(p, ?d, start, at, external, visible, bodies); }
    or                                                      { state.expected(p, "an item"); }
}

# read a global's initial value, of the global's type, and give it to the global
pub fun initial(p: *Parser, i: Initial) {
    state.rewind(p, i.at);
    val line: u32                           = p.tok.line;
    val col:  u32                           = p.tok.column;
    val got:  res[GlobalData, module.Error] = module.global_data(p.m, i.global);
    if (sel got.err) {
        state.fail_at(p, line, col, Reason.ir{got.err});
        ret;
    }
    val c: Constant = ty.typed(p, opt[Type].some{got.ok.type});
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    build.initial(?p.b, i.global, c);
    state.built(p, line, col);
}
