# the tokens of the text form
#
# a lexer reads one token at a time from the text and keeps the line and
# column it stands at. a name written in quotes is decoded into storage the
# caller owns, so a token's text outlives the lexer's position.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

pub def Kind: u8;

pub val END:      Kind = 0;
pub val NEWLINE:  Kind = 1;
pub val WORD:     Kind = 2;
pub val UINT:     Kind = 3;
pub val STRING:   Kind = 4;
pub val SYMBOL:   Kind = 5;
pub val LOCAL:    Kind = 6;
pub val LABEL:    Kind = 7;
pub val DREF:     Kind = 8;
pub val EQUALS:   Kind = 9;
pub val COMMA:    Kind = 10;
pub val COLON:    Kind = 11;
pub val LPAREN:   Kind = 12;
pub val RPAREN:   Kind = 13;
pub val LBRACE:   Kind = 14;
pub val RBRACE:   Kind = 15;
pub val LBRACKET: Kind = 16;
pub val RBRACKET: Kind = 17;
pub val LESS:     Kind = 18;
pub val GREATER:  Kind = 19;
pub val ARROW:    Kind = 20;
pub val PLUS:     Kind = 21;
pub val MINUS:    Kind = 22;
pub val BAD:      Kind = 23;

# one token
# ---
# kind:   what it is
# raw:    its bytes as the text spells them
# text:   a word's spelling, a number's digits and a string's or a sigil name's
#         decoded bytes
# value:  a number's value when it fits
# wide:   a number does not fit in 64 bits
# note:   why a bad token is bad
# fault:  the allocator's refusal while decoding, set on a bad token
# line:   where it starts, from one
# column: the byte of its line it starts at, from one
pub rec Token {
    kind:   Kind;
    raw:    View;
    text:   View;
    value:  u64;
    wide:   bool;
    note:   str;
    fault:  opt[allocator.Error];
    line:   u32;
    column: u32;
}

# a position in the text
# ---
# text:   the whole text
# pos:    the next byte
# line:   its line
# column: its column
# a:      the allocator decoded names are taken from
# owned:  every decoded name, for the caller to release
pub rec Lexer {
    text:   View;
    pos:    usize;
    line:   u32;
    column: u32;
    a:      *allocator.Allocator;
    owned:  *vector.Vector[View];
}

# a lexer at the start of text
pub fun init(text: View, a: *allocator.Allocator, owned: *vector.Vector[View]) Lexer {
    ret Lexer{text: text, pos: 0, line: 1, column: 1, a: a, owned: owned};
}

# whether a view spells a string of the source
pub fun spelled(v: View, s: str) bool {
    if (v.len != str_len(s)) { ret false; }
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun is_digit(c: u8) bool {
    ret c >= '0' && c <= '9';
}

fun is_hex(c: u8) bool {
    ret is_digit(c) || (c >= 'a' && c <= 'f');
}

fun is_letter(c: u8) bool {
    ret (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

fun is_plain(c: u8) bool {
    ret is_letter(c) || is_digit(c) || c == '_' || c == '.';
}

fun hex_value(c: u8) u64 {
    if (is_digit(c)) { ret (c - '0')::u64; }
    ret (c - 'a')::u64 + 10;
}

fun at(l: *Lexer, k: usize) u8 {
    if (l.pos + k >= l.text.len) { ret 0; }
    ret l.text.data[l.pos + k];
}

fun bump(l: *Lexer) {
    if (l.pos >= l.text.len) { ret; }
    if (l.text.data[l.pos] == '\n') {
        l.line   = l.line + 1;
        l.column = 1;
    }
    or { l.column = l.column + 1; }
    l.pos = l.pos + 1;
}

fun skip(l: *Lexer) {
    for {
        val c: u8 = at(l, 0);
        if (c == ' ' || c == '\t' || c == '\r') { bump(l); }
        or (c == ';') {
            for (l.pos < l.text.len && at(l, 0) != '\n') { bump(l); }
        }
        or { brk; }
    }
}

fun bad(t: *Token, note: str) {
    t.kind = BAD;
    t.note = note;
}

fun single(l: *Lexer, t: *Token, kind: Kind) {
    bump(l);
    t.kind = kind;
}

# how many bytes a quoted string decodes to, or none when it is not well formed
fun measure(l: *Lexer, t: *Token) opt[usize] {
    var k: usize = 1;
    var n: usize = 0;
    for {
        val c: u8 = at(l, k);
        if (l.pos + k >= l.text.len || c == '\n') {
            bad(t, "unterminated string");
            ret opt[usize].none{};
        }
        if (c == '"') { ret opt[usize].some{n}; }
        if (c == '\\') {
            val e: u8 = at(l, k + 1);
            if (e == '\\' || e == '"')                                    { k = k + 2; }
            or (e == 'x' && is_hex(at(l, k + 2)) && is_hex(at(l, k + 3))) { k = k + 4; }
            or {
                bad(t, "bad escape");
                ret opt[usize].none{};
            }
        }
        or (c < 0x20 || c > 0x7e) {
            bad(t, "byte not allowed in a string");
            ret opt[usize].none{};
        }
        or { k = k + 1; }
        n = n + 1;
    }
    ret opt[usize].none{};
}

# read a quoted string into storage the lexer's owner releases
fun quoted(l: *Lexer, t: *Token) {
    val n: opt[usize] = measure(l, t);
    if (sel n.none) { ret; }
    var out: *u8 = nil;
    if (n.some > 0) {
        val got: res[*u8, allocator.Error] = allocator.allocate[u8](l.a, n.some);
        if (sel got.err) {
            bad(t, "out of memory");
            t.fault = opt[allocator.Error].some{got.err};
            ret;
        }
        out = got.ok;
    }
    val v: View = View{data: out, len: n.some};
    if (n.some > 0) {
        val kept: res[usize, allocator.Error] = vector.push[View](l.owned, v);
        if (sel kept.err) {
            allocator.deallocate[u8](l.a, out, n.some);
            bad(t, "out of memory");
            t.fault = opt[allocator.Error].some{kept.err};
            ret;
        }
    }
    bump(l);
    var i: usize = 0;
    for (i < n.some) {
        val c: u8 = at(l, 0);
        if (c == '\\') {
            val e: u8 = at(l, 1);
            if (e == 'x') {
                out[i] = (hex_value(at(l, 2)) * 16 + hex_value(at(l, 3)))::u8;
                bump(l);
                bump(l);
                bump(l);
                bump(l);
            }
            or {
                out[i] = e;
                bump(l);
                bump(l);
            }
        }
        or {
            out[i] = c;
            bump(l);
        }
        i = i + 1;
    }
    bump(l);
    t.kind = STRING;
    t.text = v;
}

# read the name after a sigil: a plain run or a quoted string
fun sigil(l: *Lexer, t: *Token, kind: Kind) {
    bump(l);
    if (at(l, 0) == '"') {
        quoted(l, t);
        if (t.kind == STRING) { t.kind = kind; }
        ret;
    }
    val start: usize = l.pos;
    for (is_plain(at(l, 0))) { bump(l); }
    if (l.pos == start) {
        bad(t, "expected a name after the sigil");
        ret;
    }
    t.kind = kind;
    t.text = View{data: ?l.text.data[start], len: l.pos - start};
}

# read a run of plain bytes: a number when it is digits or `0x` and lowercase
# hex digits, and a word otherwise
fun run(l: *Lexer, t: *Token) {
    val start: usize = l.pos;
    for (is_plain(at(l, 0))) { bump(l); }
    val v: View = View{data: ?l.text.data[start], len: l.pos - start};
    t.text = v;
    t.kind = WORD;
    if (!is_digit(v.data[0])) { ret; }

    val hex: bool  = v.len > 2 && v.data[1] == 'x' && v.data[0] == '0';
    var i:   usize = 0;
    if (hex) { i = 2; }
    var all: bool = true;
    var acc: u64  = 0;
    for (i < v.len) {
        val c: u8 = v.data[i];
        if (hex && !is_hex(c))    { all = false; }
        or (!hex && !is_digit(c)) { all = false; }
        if (all) {
            if (hex) {
                if ((acc >> 60) != 0) { t.wide = true; }
                acc = acc * 16 + hex_value(c);
            }
            or {
                val d: u64 = (c - '0')::u64;
                if (acc > (0xffffffffffffffff - d) / 10) { t.wide = true; }
                acc = acc * 10 + d;
            }
        }
        i = i + 1;
    }
    if (!all) {
        t.wide = false;
        ret;
    }
    t.kind  = UINT;
    t.value = acc;
}

# the next token, an END token once the text is read
pub fun next(l: *Lexer) Token {
    skip(l);
    var t: Token;
    t.line   = l.line;
    t.column = l.column;
    if (l.pos >= l.text.len) { ret t; }
    val start: usize = l.pos;
    val c:     u8    = at(l, 0);
    if (c == '\n') { single(l, ?t, NEWLINE); }
    or (c == '=')  { single(l, ?t, EQUALS); }
    or (c == ',')  { single(l, ?t, COMMA); }
    or (c == ':')  { single(l, ?t, COLON); }
    or (c == '(')  { single(l, ?t, LPAREN); }
    or (c == ')')  { single(l, ?t, RPAREN); }
    or (c == '{')  { single(l, ?t, LBRACE); }
    or (c == '}')  { single(l, ?t, RBRACE); }
    or (c == '[')  { single(l, ?t, LBRACKET); }
    or (c == ']')  { single(l, ?t, RBRACKET); }
    or (c == '<')  { single(l, ?t, LESS); }
    or (c == '>')  { single(l, ?t, GREATER); }
    or (c == '+')  { single(l, ?t, PLUS); }
    or (c == '-') {
        if (at(l, 1) == '>') {
            bump(l);
            single(l, ?t, ARROW);
        }
        or { single(l, ?t, MINUS); }
    }
    or (c == '"') {
        quoted(l, ?t);
    }
    or (c == '@')    { sigil(l, ?t, SYMBOL); }
    or (c == '%')    { sigil(l, ?t, LOCAL); }
    or (c == '^')    { sigil(l, ?t, LABEL); }
    or (c == '!')    { sigil(l, ?t, DREF); }
    or (is_plain(c)) { run(l, ?t); }
    or {
        bad(?t, "unexpected byte");
        bump(l);
    }
    t.raw = View{data: ?l.text.data[start], len: l.pos - start};
    ret t;
}
