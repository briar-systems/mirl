# where the parser refused a text, and why

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.ir.text.parse.reason;

# a refusal
# ---
# line:   the line of the text, from one
# column: the byte on that line, from one
# reason: why
pub rec Error {
    line:   u32;
    column: u32;
    reason: reason.Error;
}

fun keep(first: *err[WriteError], r: err[WriteError]) {
    if (sel r.err && sel first.ok) { @first = r; }
}

# write a refusal as `line:column: reason`
pub fun describe(w: *io.Writer, r: Error) err[WriteError] {
    var err_first: err[WriteError]        = err[WriteError].ok{};
    val res_line:  res[usize, WriteError] = format.write_u64(w, r.line::u64);
    if (sel res_line.err) { keep(?err_first, err[WriteError].err{res_line.err}); }
    val res_colon: res[usize, WriteError] = format.write_str(w, ":");
    if (sel res_colon.err) { keep(?err_first, err[WriteError].err{res_colon.err}); }
    val res_column: res[usize, WriteError] = format.write_u64(w, r.column::u64);
    if (sel res_column.err) { keep(?err_first, err[WriteError].err{res_column.err}); }
    val res_gap: res[usize, WriteError] = format.write_str(w, ": ");
    if (sel res_gap.err) { keep(?err_first, err[WriteError].err{res_gap.err}); }
    keep(?err_first, reason.describe(w, r.reason));
    ret err_first;
}
