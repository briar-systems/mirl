# why the parser refused a text, and where

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.build.failure.Failure;
use mirl.build.failure.Work;
use ir_debug: mirl.ir.debug;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.machine.function;
use mirl.machine.text.resolve;

# a name and what kind of thing it names
# ---
# what: the kind of thing, such as `value` or `block`
# name: the name as the text spells it, a view of the text
pub rec Named {
    what: str;
    name: View;
}

# why a text was refused
# ---
# expected:    the text has something else where this should be
# unexpected:  a byte or token the grammar has no place for, and why
# large:       a number too large for where it stands
# version:     the text was written by this version of mirl, not ours, as
#              the text spells it: a view of the text
# unknown:     a name no row or table knows
# unresolved:  a name nothing defines, or that is only defined by what needs it
# duplicate:   a name defined twice in the scope it is defined in
# unsupported: a construct the text form reserves and this reader does not read
# results:     an instruction that gives this many results, not as many as
#              the line names
# build:       the builder refused an instruction, block or global
# ir:          the module refused an item
# types:       the type table refused a type
# debug:       the debug table refused an entry
# machine:     the machine form refused an instruction, class or storage
# alloc:       the allocator refused storage
# target:      the module's target gives no environment for a machine form text
pub tag Reason: u8 {
    expected:   str;
    unexpected: str;
    large;
    version:     View;
    unknown:     Named;
    unresolved:  Named;
    duplicate:   Named;
    unsupported: str;
    results:     u32;
    build:       Failure;
    ir:          module.Error;
    types:       types.Error;
    debug:       ir_debug.Error;
    machine:     function.Error;
    alloc:       allocator.Error;
    target:      resolve.Failure;
}

# a refusal
# ---
# line:   the line of the text, from one
# column: the byte on that line, from one
# reason: why
pub rec Refusal {
    line:   u32;
    column: u32;
    reason: Reason;
}

fun keep(first: *err[WriteError], r: err[WriteError]) {
    if (sel r.err && sel first.ok) { @first = r; }
}

fun put(first: *err[WriteError], w: *io.Writer, s: str) {
    val r: res[usize, WriteError] = format.write_str(w, s);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_number(first: *err[WriteError], w: *io.Writer, n: u64) {
    val r: res[usize, WriteError] = format.write_u64(w, n);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

fun put_name(first: *err[WriteError], w: *io.Writer, v: View) {
    val r: res[usize, WriteError] = format.write_bytes(w, v.data, v.len);
    if (sel r.err) { keep(first, err[WriteError].err{r.err}); }
}

# write why a text was refused, as the reason alone
pub fun reason(w: *io.Writer, why: Reason) err[WriteError] {
    var first: err[WriteError] = err[WriteError].ok{};
    if (sel why.expected) {
        put(?first, w, "expected ");
        put(?first, w, why.expected);
    }
    or (sel why.unexpected) { put(?first, w, why.unexpected); }
    or (sel why.large)      { put(?first, w, "number too large"); }
    or (sel why.version) {
        put(?first, w, "version \"");
        put_name(?first, w, why.version);
        put(?first, w, "\" is not the version this library reads");
    }
    or (sel why.unknown) {
        put(?first, w, "unknown ");
        put(?first, w, why.unknown.what);
        put(?first, w, " \"");
        put_name(?first, w, why.unknown.name);
        put(?first, w, "\"");
    }
    or (sel why.unresolved) {
        put(?first, w, "unresolved ");
        put(?first, w, why.unresolved.what);
        put(?first, w, " \"");
        put_name(?first, w, why.unresolved.name);
        put(?first, w, "\"");
    }
    or (sel why.duplicate) {
        put(?first, w, why.duplicate.what);
        put(?first, w, " \"");
        put_name(?first, w, why.duplicate.name);
        put(?first, w, "\" is defined twice");
    }
    or (sel why.unsupported) {
        put(?first, w, why.unsupported);
        put(?first, w, " is not supported yet");
    }
    or (sel why.results) {
        put(?first, w, "the instruction gives ");
        put_number(?first, w, why.results::u64);
        put(?first, w, " results");
    }
    or (sel why.build) {
        val work: Work = why.build.work;
        if (sel work.bind) { put(?first, w, "the builder refused the value binding record"); }
        or                 { put(?first, w, "the builder refused the instruction"); }
    }
    or (sel why.ir)    { put(?first, w, "the module refused the item"); }
    or (sel why.types) { put(?first, w, "the type table refused the type"); }
    or (sel why.debug) { put(?first, w, "the debug table refused the entry"); }
    or (sel why.machine) {
        put(?first, w, "the machine function refused the request");
        val e: function.Error = why.machine;
        if (sel e.refused) {
            put(?first, w, ": ");
            put(?first, w, e.refused.what);
        }
    }
    or (sel why.target) {
        val f: resolve.Failure = why.target;
        if (sel f.target) {
            put(?first, w, "no target has the name of the module's: ");
            put_name(?first, w, f.target);
        }
        or (sel f.arch) { put(?first, w, "the target's architecture is no row of the catalog"); }
        or (sel f.unregistered) {
            put(?first, w, "no instruction set is registered for the architecture ");
            put(?first, w, f.unregistered);
        }
        or (sel f.memory) {
            put(?first, w, "a memory class has no name or a name another has: ");
            put(?first, w, f.memory);
        }
        or { put(?first, w, "out of memory"); }
    }
    or { put(?first, w, "out of memory"); }
    ret first;
}

# write a refusal as `line:column: reason`
pub fun describe(w: *io.Writer, r: Refusal) err[WriteError] {
    var first: err[WriteError] = err[WriteError].ok{};
    put_number(?first, w, r.line::u64);
    put(?first, w, ":");
    put_number(?first, w, r.column::u64);
    put(?first, w, ": ");
    keep(?first, reason(w, r.reason));
    ret first;
}
