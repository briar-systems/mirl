# where the parser refused a text, and why

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.ir.text.parse.reason;

# a refusal
# ---
# line:   the line of the text, from one
# column: the byte on that line, from one
# reason: why
pub rec Error {
    line:   u32;
    column: u32;
    reason: reason.Error;
}

fun keep(first: *err[WriteError], r: err[WriteError]) {
    if (sel r.err && sel first.ok) { @first = r; }
}

# write a refusal as `line:column: reason`
pub fun describe(w: *io.Writer, r: Error) err[WriteError] {
    var first: err[WriteError]        = err[WriteError].ok{};
    val line:  res[usize, WriteError] = format.write_u64(w, r.line::u64);
    if (sel line.err) { keep(?first, err[WriteError].err{line.err}); }
    val colon: res[usize, WriteError] = format.write_str(w, ":");
    if (sel colon.err) { keep(?first, err[WriteError].err{colon.err}); }
    val column: res[usize, WriteError] = format.write_u64(w, r.column::u64);
    if (sel column.err) { keep(?first, err[WriteError].err{column.err}); }
    val gap: res[usize, WriteError] = format.write_str(w, ": ");
    if (sel gap.err) { keep(?first, err[WriteError].err{gap.err}); }
    keep(?first, reason.describe(w, r.reason));
    ret first;
}
