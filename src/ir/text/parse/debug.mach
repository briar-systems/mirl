# reading the debug table
#
# a line declares what it names. a debug type may name a type declared after
# it, so the first pass declares every type and saves where its members are,
# and the second pass reads them once every type is declared.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.collections.slice.Slice;
use std.collections.vector;

use ir_debug: mirl.ir.debug;
use mirl.ir.text.parse.lexer;
use mirl.ir.text.parse.lexer.Token;
use mirl.ir.text.parse.refusal.Named;
use mirl.ir.text.parse.refusal.Reason;
use mirl.ir.text.parse.state;
use mirl.ir.text.parse.state.Mark;
use mirl.ir.text.parse.state.Parser;
use mirl.ir.text.parse.state.Scope;
use mirl.ir.text.parse.ty;

val STRUCTURE:   u8 = 1;
val UNION:       u8 = 2;
val TAGGED:      u8 = 3;
val ENUMERATION: u8 = 4;
val ARRAY:       u8 = 5;
val FUNCTION:    u8 = 6;

# a declared debug type whose members are still to be read
# ---
# at:     where they start
# type:   the type
# kind:   which shape they are
# line:   where the entry starts
# column: where the entry starts
pub rec Pending {
    at:     Mark;
    type:   ir_debug.Type;
    kind:   u8;
    line:   u32;
    column: u32;
}

fun got[T](p: *Parser, line: u32, column: u32, r: res[T, ir_debug.Error], out: *T) bool {
    if (sel r.err) {
        state.fail_at(p, line, column, Reason.debug{r.err});
        ret false;
    }
    @out = r.ok;
    ret true;
}

# read the name of an entry of a scope
pub fun ref(p: *Parser, s: *Scope, what: str) u32 {
    val t: Token = state.expect(p, lexer.DREF, what);
    ret state.resolve(p, s, what, t);
}

fun string(p: *Parser) View {
    ret state.expect(p, lexer.STRING, "a string").text;
}

fun location(p: *Parser, t: Token) {
    val file: u32 = ref(p, ?p.files, "file");
    val line: u32 = state.number32(p);
    state.expect(p, lexer.COLON, ":");
    val col: u32 = state.number32(p);
    if (!state.ok(p)) { ret; }
    var l: ir_debug.Location;
    if (got[ir_debug.Location](p, t.line, t.column, ir_debug.location(?p.m.debug, ir_debug.Position{file: ir_debug.File{index: file}, line: line, column: col}), ?l)) {
        state.define(p, ?p.places, "location", t, l.index);
    }
}

fun site(p: *Parser, t: Token) {
    val call:   u32                = ref(p, ?p.places, "location");
    val callee: View               = string(p);
    var parent: opt[ir_debug.Site] = opt[ir_debug.Site].none{};
    if (state.accept_word(p, "parent")) { parent = opt[ir_debug.Site].some{ir_debug.Site{index: ref(p, ?p.sites, "site")}}; }
    if (!state.ok(p))                   { ret; }
    var s: ir_debug.Site;
    if (got[ir_debug.Site](p, t.line, t.column, ir_debug.site(?p.m.debug, ir_debug.Inlining{call: ir_debug.Location{index: call}, callee: callee, parent: parent}), ?s)) {
        state.define(p, ?p.sites, "site", t, s.index);
    }
}

fun variable(p: *Parser, t: Token) {
    val name: View = string(p);
    val type: u32  = ref(p, ?p.dtypes, "debug type");
    state.expect_word(p, "declared");
    val declared:  u32      = ref(p, ?p.places, "location");
    var parameter: opt[u32] = opt[u32].none{};
    if (state.accept_word(p, "parameter")) { parameter = opt[u32].some{state.number32(p)}; }
    if (!state.ok(p))                      { ret; }
    var b: ir_debug.Binding;
    val v: ir_debug.Variable = ir_debug.Variable{name: name, type: ir_debug.Type{index: type}, declared: ir_debug.Location{index: declared}, parameter: parameter};
    if (got[ir_debug.Binding](p, t.line, t.column, ir_debug.bind(?p.m.debug, v), ?b)) {
        state.define(p, ?p.vars, "variable", t, b.index);
    }
}

fun encoding(p: *Parser) ir_debug.Encoding {
    if (state.accept_word(p, "signed"))    { ret ir_debug.Encoding.signed{}; }
    if (state.accept_word(p, "unsigned"))  { ret ir_debug.Encoding.unsigned{}; }
    if (state.accept_word(p, "float"))     { ret ir_debug.Encoding.float{}; }
    if (state.accept_word(p, "boolean"))   { ret ir_debug.Encoding.boolean{}; }
    if (state.accept_word(p, "character")) { ret ir_debug.Encoding.character{}; }
    if (state.accept_word(p, "address"))   { ret ir_debug.Encoding.address{}; }
    state.expected(p, "an encoding");
    ret ir_debug.Encoding.signed{};
}

fun dtype(p: *Parser, t: Token, pending: *vector.Vector[Pending]) {
    val keyed: Token = state.expect(p, lexer.STRING, "a string");
    val key:   View  = keyed.text;
    val name:  View  = string(p);
    val kind:  Token = p.tok;
    if (!state.ok(p)) { ret; }
    if (kind.kind != lexer.WORD) {
        state.expected(p, "a shape");
        ret;
    }
    state.advance(p);
    var head: ir_debug.Head = ir_debug.Head.enumeration{};
    var code: u8            = 0;
    if (lexer.spelled(kind.text, "base")) {
        val e: ir_debug.Encoding = encoding(p);
        head = ir_debug.Head.base{ir_debug.Base{encoding: e, width: state.number32(p)}};
    }
    or (lexer.spelled(kind.text, "structure")) {
        head = ir_debug.Head.structure{ty.ty(p)};
        code = STRUCTURE;
    }
    or (lexer.spelled(kind.text, "union")) {
        head = ir_debug.Head.union{ty.ty(p)};
        code = UNION;
    }
    or (lexer.spelled(kind.text, "tagged")) {
        head = ir_debug.Head.tagged{ty.ty(p)};
        code = TAGGED;
    }
    or (lexer.spelled(kind.text, "enumeration")) { code = ENUMERATION; }
    or (lexer.spelled(kind.text, "array")) {
        code = ARRAY;
        head = ir_debug.Head.array{};
    }
    or (lexer.spelled(kind.text, "pointer")) { head = ir_debug.Head.pointer{string(p)}; }
    or (lexer.spelled(kind.text, "function")) {
        code = FUNCTION;
        head = ir_debug.Head.function{};
    }
    or {
        state.fail_at(p, kind.line, kind.column, Reason.unknown{Named{what: "shape", name: kind.raw}});
        ret;
    }
    if (!state.ok(p)) { ret; }
    val at: Mark                                   = state.mark(p);
    val d:  res[ir_debug.Declared, ir_debug.Error] = ir_debug.declare(?p.m.debug, ?p.m.types, ir_debug.Entry{key: key, name: name, head: head});
    if (sel d.err) {
        state.fail_at(p, t.line, t.column, Reason.debug{d.err});
        ret;
    }
    if (sel d.ok.known) {
        state.fail_at(p, t.line, t.column, Reason.duplicate{Named{what: "debug type key", name: keyed.raw}});
        ret;
    }
    state.define(p, ?p.dtypes, "debug type", t, d.ok.fresh.index);
    if (code == 0) { ret; }
    state.push[Pending](p, pending, Pending{at: at, type: d.ok.fresh, kind: code, line: t.line, column: t.column});
    state.skip_line(p);
}

# read a debug entry line, declaring what it names
pub fun line(p: *Parser, pending: *vector.Vector[Pending]) {
    val t: Token = state.expect(p, lexer.DREF, "a debug entry");
    state.expect(p, lexer.EQUALS, "=");
    val kind: Token = p.tok;
    if (!state.ok(p)) { ret; }
    if (kind.kind != lexer.WORD) {
        state.expected(p, "an entry kind");
        ret;
    }
    state.advance(p);
    if (lexer.spelled(kind.text, "file")) {
        val path: View = string(p);
        var f:    ir_debug.File;
        if (state.ok(p) && got[ir_debug.File](p, t.line, t.column, ir_debug.file(?p.m.debug, path), ?f)) {
            state.define(p, ?p.files, "file", t, f.index);
        }
    }
    or (lexer.spelled(kind.text, "location")) { location(p, t); }
    or (lexer.spelled(kind.text, "site"))     { site(p, t); }
    or (lexer.spelled(kind.text, "type"))     { dtype(p, t, pending); }
    or (lexer.spelled(kind.text, "variable")) { variable(p, t); }
    or                                        { state.fail_at(p, kind.line, kind.column, Reason.unknown{Named{what: "debug entry", name: kind.raw}}); }
    state.expect_end(p);
}

fun member(p: *Parser) ir_debug.Member {
    val name: View = string(p);
    state.expect(p, lexer.COLON, ":");
    val type: u32 = ref(p, ?p.dtypes, "debug type");
    state.expect_word(p, "field");
    ret ir_debug.Member{name: name, type: ir_debug.Type{index: type}, field: state.number32(p)};
}

fun members(p: *Parser, out: *vector.Vector[ir_debug.Member]) {
    state.expect(p, lexer.LBRACE, "{");
    if (!state.is(p, lexer.RBRACE)) {
        for {
            val m: ir_debug.Member = member(p);
            state.push[ir_debug.Member](p, out, m);
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACE, "}");
}

fun dtype_list(p: *Parser, out: *vector.Vector[ir_debug.Type]) {
    state.expect(p, lexer.LPAREN, "(");
    if (!state.is(p, lexer.RPAREN)) {
        for {
            val i: u32 = ref(p, ?p.dtypes, "debug type");
            state.push[ir_debug.Type](p, out, ir_debug.Type{index: i});
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RPAREN, ")");
}

fun tagged(p: *Parser, d: Pending) {
    var cases: vector.Vector[ir_debug.Case] = vector.init[ir_debug.Case](p.a);
    fin { vector.dnit[ir_debug.Case](?cases); }
    state.expect_word(p, "discriminant");
    val disc: ir_debug.Member = member(p);
    state.expect_word(p, "payload");
    val payload: u32 = state.number32(p);
    state.expect(p, lexer.LBRACE, "{");
    if (!state.is(p, lexer.RBRACE)) {
        for {
            val name:  View                 = string(p);
            val value: u64                  = state.number(p);
            var m:     opt[ir_debug.Member] = opt[ir_debug.Member].none{};
            if (state.accept_word(p, "payload")) { m = opt[ir_debug.Member].some{member(p)}; }
            state.push[ir_debug.Case](p, ?cases, ir_debug.Case{name: name, value: value, payload: m});
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACE, "}");
    complete(p, d, ir_debug.Shape.tagged{ir_debug.Tagged{discriminant: disc, payload: payload, cases: Slice[ir_debug.Case]{data: cases.data, size: cases.len}}});
}

fun enumeration(p: *Parser, d: Pending) {
    var list: vector.Vector[ir_debug.Enumerator] = vector.init[ir_debug.Enumerator](p.a);
    fin { vector.dnit[ir_debug.Enumerator](?list); }
    val base: u32 = ref(p, ?p.dtypes, "debug type");
    state.expect(p, lexer.LBRACE, "{");
    if (!state.is(p, lexer.RBRACE)) {
        for {
            val name:  View = string(p);
            val value: u64  = state.number(p);
            state.push[ir_debug.Enumerator](p, ?list, ir_debug.Enumerator{name: name, value: value});
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACE, "}");
    complete(p, d, ir_debug.Shape.enumeration{ir_debug.Enumeration{base: ir_debug.Type{index: base}, enumerators: Slice[ir_debug.Enumerator]{data: list.data, size: list.len}}});
}

# give a declared type the shape just read, if it was read whole
fun complete(p: *Parser, d: Pending, s: ir_debug.Shape) {
    if (!state.ok(p)) { ret; }
    val r: err[ir_debug.Error] = ir_debug.define(?p.m.debug, ?p.m.types, d.type, s);
    if (sel r.err) { state.fail_at(p, d.line, d.column, Reason.debug{r.err}); }
}

# read what follows a declared type's head and define the type
fun shape(p: *Parser, d: Pending) {
    if (d.kind == STRUCTURE || d.kind == UNION) {
        var list: vector.Vector[ir_debug.Member] = vector.init[ir_debug.Member](p.a);
        fin { vector.dnit[ir_debug.Member](?list); }
        members(p, ?list);
        val s: Slice[ir_debug.Member] = Slice[ir_debug.Member]{data: list.data, size: list.len};
        if (d.kind == STRUCTURE) { complete(p, d, ir_debug.Shape.structure{s}); }
        or                       { complete(p, d, ir_debug.Shape.union{s}); }
        ret;
    }
    if (d.kind == TAGGED) {
        tagged(p, d);
        ret;
    }
    if (d.kind == ENUMERATION) {
        enumeration(p, d);
        ret;
    }
    if (d.kind == ARRAY) {
        val element: u32 = ref(p, ?p.dtypes, "debug type");
        complete(p, d, ir_debug.Shape.array{ir_debug.Array{element: ir_debug.Type{index: element}, count: state.number(p)}});
        ret;
    }
    var params:  vector.Vector[ir_debug.Type] = vector.init[ir_debug.Type](p.a);
    var results: vector.Vector[ir_debug.Type] = vector.init[ir_debug.Type](p.a);
    fin {
        vector.dnit[ir_debug.Type](?params);
        vector.dnit[ir_debug.Type](?results);
    }
    dtype_list(p, ?params);
    state.expect(p, lexer.ARROW, "->");
    dtype_list(p, ?results);
    complete(p, d, ir_debug.Shape.function{ir_debug.Function{params: Slice[ir_debug.Type]{data: params.data, size: params.len}, results: Slice[ir_debug.Type]{data: results.data, size: results.len}}});
}

# read the members of every declared type, now that all are declared
pub fun define_all(p: *Parser, pending: *vector.Vector[Pending]) {
    var i: usize = 0;
    for (i < pending.len && state.ok(p)) {
        val d: Pending = pending.data[i];
        state.rewind(p, d.at);
        if (!state.accept_word(p, "open")) { shape(p, d); }
        state.expect_end(p);
        i = i + 1;
    }
    if (state.ok(p)) { ir_debug.pending(?p.m.debug); }
}
