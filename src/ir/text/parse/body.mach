use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.ValueData;

use mo: masc.core.operand;
use rf: masc.core.register;
use masc.inline.inline;

# the most operands of one instruction whose literals are typed at once
val MAX_TYPED: usize = 64;

# an instruction statement
# ---
# at:     its start
# block:  the block it stands in, by position in the body
# built:  the instruction has been built
# line:   where it starts
# column: where it starts
rec Line {
    at:     Mark;
    block:  usize;
    built:  bool;
    line:   u32;
    column: u32;
}

# a value binding record
# ---
# at:     its start
# block:  the block it stands in, by position in the body
# before: how many instructions of its block stand before it
# line:   where it starts
# column: where it starts
rec Record {
    at:     Mark;
    block:  usize;
    before: u32;
    line:   u32;
    column: u32;
}

# an operand as the text writes it
# ---
# value:    a value, by its name
# literal:  a literal not yet typed
# function: a function of the module a callee names directly
tag Arg: u8 {
    value:    Token;
    literal:  ty.Pending;
    function: Token;
}

# what one slot of an instruction holds
# ---
# given:  the text writes it
# imm:    what it holds, its list's data not yet pointed at
# start:  where its list starts in the list it was read into
# member: the member it names, written by name, to resolve once the aggregate
#         it indexes is known
rec Slot {
    given:  bool;
    imm:    opcode.Immediate;
    start:  usize;
    member: opt[Token];
}

# a target as the text writes it
# ---
# block: its block's name
# case:  the case value written before it
# first: where its arguments start among the targets' arguments
# count: how many it has
rec Target {
    block: Token;
    case:  opt[u64];
    first: usize;
    count: usize;
}

# a result as the text declares it
rec Result {
    name:   Token;
    type:   Type;
    secret: bool;
}

# one instruction statement, read whole before anything of it is built
rec Parts {
    results:  vector.Vector[Result];
    flags:    Flags;
    secret:   bool;
    code:     opcode.Opcode;
    row:      opcode.Row;
    slots:    vector.Vector[Slot];
    lanes:    vector.Vector[u32];
    places:   vector.Vector[Placed];
    cases:    vector.Vector[u64];
    callee:   opt[Arg];
    operands: vector.Vector[Arg];
    targets:  vector.Vector[Target];
    args:     vector.Vector[Arg];
    location: opt[u32];
    site:     opt[u32];
    bindings: vector.Vector[Binding];
    block:    Assembly;
    bound:    vector.Vector[AsmOperand];
    op:       Op;
    gives:    vector.Vector[Type];
}

fun parts(p: *Parser) Parts {
    var x: Parts;
    x.results  = vector.init[Result](p.a);
    x.flags    = NO_FLAGS;
    x.secret   = false;
    x.code     = opcode.Opcode{index: 0};
    x.slots    = vector.init[Slot](p.a);
    x.lanes    = vector.init[u32](p.a);
    x.places   = vector.init[Placed](p.a);
    x.cases    = vector.init[u64](p.a);
    x.callee   = opt[Arg].none{};
    x.operands = vector.init[Arg](p.a);
    x.targets  = vector.init[Target](p.a);
    x.args     = vector.init[Arg](p.a);
    x.location = opt[u32].none{};
    x.site     = opt[u32].none{};
    x.bindings = vector.init[Binding](p.a);
    x.block    = Assembly{text: View{data: nil, len: 0}, operands: Slice[AsmOperand]{data: nil, size: 0}, reads: false, writes: false};
    x.bound    = vector.init[AsmOperand](p.a);
    x.op       = Op{set: View{data: nil, len: 0}, name: View{data: nil, len: 0}, results: Slice[Type]{data: nil, size: 0}, reads: false, writes: false};
    x.gives    = vector.init[Type](p.a);
    ret x;
}

fun release(x: *Parts) {
    vector.dnit[Result](?x.results);
    vector.dnit[Slot](?x.slots);
    vector.dnit[u32](?x.lanes);
    vector.dnit[Placed](?x.places);
    vector.dnit[u64](?x.cases);
    vector.dnit[Arg](?x.operands);
    vector.dnit[Target](?x.targets);
    vector.dnit[Arg](?x.args);
    vector.dnit[Binding](?x.bindings);
    vector.dnit[AsmOperand](?x.bound);
    vector.dnit[Type](?x.gives);
}

# the name a value or block is given, none when the text spells it as unnamed
fun own(t: Token) opt[View] {
    if (state.unnamed(t.text, '_')) { ret opt[View].none{}; }
    ret opt[View].some{t.text};
}

# read a parameter: a name, `^` when it is secret, and a type, with the
# extension a function's parameter may state, which its signature holds
fun parameter(p: *Parser, decls: *vector.Vector[Declaration], names: *vector.Vector[Token]) {
    val n: Token = state.expect(p, lexer.WORD, "a parameter's name");
    state.expect(p, lexer.COLON, ":");
    val secret: bool = state.accept(p, lexer.SECRET);
    val type:   Type = ty.ty(p);
    ty.extension(p);
    state.push[Declaration](p, decls, Declaration{type: type, secret: secret, name: own(n)});
    state.push[Token](p, names, n);
}

# make a block of declared parameters, labelled unless the label is none, and
# bind its parameters' names
fun make(p: *Parser, blocks: *vector.Vector[Block], label: opt[Token], at: Token, decls: *vector.Vector[Declaration], names: *vector.Vector[Token]) {
    if (!state.ok(p)) { ret; }
    val k: Block = build.block(?p.b, Slice[Declaration]{data: decls.data, size: decls.len});
    if (sel label.some) {
        val given: opt[View] = own(label.some);
        if (sel given.some) { build.label(?p.b, k, given.some); }
        state.define(p, ?p.blocks, "block", label.some, blocks.len::u32);
    }
    state.built(p, at.line, at.column);
    if (sel label.some) { state.note(p, at.line, notes.at(notes.BLOCK, p.fn, k.index)); }
    state.push[Block](p, blocks, k);
    var i: usize = 0;
    for (i < names.len && state.ok(p)) {
        val v: Value = build.parameter(?p.b, k, i::u32);
        state.define(p, ?p.values, "value", names.data[i], v.index);
        i = i + 1;
    }
    state.built(p, at.line, at.column);
}

# make the entry block from a function's parameter list
fun entry(p: *Parser, list: Mark, blocks: *vector.Vector[Block]) {
    state.rewind(p, list);
    val at:    Token                      = p.tok;
    var decls: vector.Vector[Declaration] = vector.init[Declaration](p.a);
    var names: vector.Vector[Token]       = vector.init[Token](p.a);
    fin {
        vector.dnit[Declaration](?decls);
        vector.dnit[Token](?names);
    }
    state.expect(p, lexer.LPAREN, "(");
    if (!state.is(p, lexer.RPAREN)) {
        for (state.ok(p)) {
            parameter(p, ?decls, ?names);
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RPAREN, ")");
    make(p, blocks, opt[Token].none{}, at, ?decls, ?names);
}

# whether a block's label starts here: a name, and its parameters, before a `:`
fun at_label(p: *Parser) bool {
    if (!state.is(p, lexer.WORD)) { ret false; }
    val back: Mark = state.mark(p);
    state.advance(p);
    if (state.is(p, lexer.LPAREN)) { state.skip_group(p); }
    val found: bool = state.ok(p) && state.is(p, lexer.COLON);
    state.rewind(p, back);
    ret found;
}

# read a block's label, parameters and colon, and make the block
fun header(p: *Parser, blocks: *vector.Vector[Block]) {
    val t:     Token                      = state.expect(p, lexer.WORD, "a block label");
    var decls: vector.Vector[Declaration] = vector.init[Declaration](p.a);
    var names: vector.Vector[Token]       = vector.init[Token](p.a);
    fin {
        vector.dnit[Declaration](?decls);
        vector.dnit[Token](?names);
    }
    if (state.accept(p, lexer.LPAREN)) {
        if (!state.is(p, lexer.RPAREN)) {
            for (state.ok(p)) {
                parameter(p, ?decls, ?names);
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RPAREN, ")");
    }
    state.expect(p, lexer.COLON, ":");
    make(p, blocks, opt[Token].some{t}, t, ?decls, ?names);
}

# read an instruction's decorators into its flags
fun flags(p: *Parser, x: *Parts) {
    for (state.ok(p) && state.accept(p, lexer.DECORATE)) {
        state.expect(p, lexer.LBRACKET, "[");
        val w: Token = state.expect(p, lexer.WORD, "a decorator");
        if (!state.ok(p))                      { ret; }
        if (lexer.spelled(w.text, "volatile")) { x.flags.volatile = true; }
        or (lexer.spelled(w.text, "kept"))     { x.flags.kept = true; }
        or (lexer.spelled(w.text, "bounded"))  { x.flags.bounded = true; }
        or (lexer.spelled(w.text, "checked"))  { x.flags.checked = true; }
        or (lexer.spelled(w.text, "public"))   { x.flags.public = true; }
        or (lexer.spelled(w.text, "secret"))   { x.secret = true; }
        or                                     { state.fail_at(p, w.line, w.column, Reason.unknown{Named{what: "instruction decorator", name: w.raw}}); }
        state.expect(p, lexer.RBRACKET, "]");
    }
}

# read one result: its name, `^` when it is secret, and its type
fun result(p: *Parser, x: *Parts) {
    val n: Token = state.expect(p, lexer.WORD, "a result's name");
    state.expect(p, lexer.COLON, ":");
    val secret: bool = state.accept(p, lexer.SECRET);
    state.push[Result](p, ?x.results, Result{name: n, type: ty.ty(p), secret: secret});
}

# read the results an instruction declares: `val`, one or several in
# parentheses, then `=`
fun results(p: *Parser, x: *Parts) {
    if (!state.accept_word(p, "val")) { ret; }
    if (state.accept(p, lexer.LPAREN)) {
        for (state.ok(p)) {
            result(p, x);
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
        state.expect(p, lexer.RPAREN, ")");
    }
    or { result(p, x); }
    state.expect(p, lexer.EQUALS, "=");
}

# read an instruction statement's decorators and results, binding each result
# unbuilt, and step over the rest
fun register(p: *Parser, blocks: *vector.Vector[Block], lines: *vector.Vector[Line]) {
    val at:  Mark  = state.mark(p);
    val ln:  u32   = p.tok.line;
    val col: u32   = p.tok.column;
    var x:   Parts = parts(p);
    fin { release(?x); }
    flags(p, ?x);
    results(p, ?x);
    var i: usize = 0;
    for (i < x.results.len) {
        state.define(p, ?p.values, "value", x.results.data[i].name, state.UNBUILT);
        i = i + 1;
    }
    state.skip_statement(p);
    state.expect_end(p);
    state.push[Line](p, lines, Line{at: at, block: blocks.len - 1, built: false, line: ln, column: col});
}

fun find_opcode(p: *Parser, t: Token) opt[opcode.Opcode] {
    var i: u32 = 0;
    for (i < opcode.rows()) {
        val r: opt[opcode.Row] = opcode.row(opcode.Opcode{index: i});
        if (sel r.some && lexer.spelled(t.text, r.some.name)) { ret opt[opcode.Opcode].some{opcode.Opcode{index: i}}; }
        i = i + 1;
    }
    state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "opcode", name: t.raw}});
    ret opt[opcode.Opcode].none{};
}

fun slot_of(r: *opcode.Row, name: View) opt[u32] {
    var k: u32 = 0;
    for (k < opcode.slots(r)) {
        if (lexer.spelled(name, r.immediates[k].name)) { ret opt[u32].some{k}; }
        k = k + 1;
    }
    ret opt[u32].none{};
}

# read an operand: a literal, or a value by its name
fun arg(p: *Parser) Arg {
    if (ty.starts_literal(p)) { ret Arg.literal{ty.scan(p)}; }
    ret Arg.value{state.expect(p, lexer.WORD, "a value or a literal")};
}

# read a callee: a literal, a value by its name, or a function of the module
# by its name, which no value takes
fun callee(p: *Parser) Arg {
    if (ty.starts_literal(p)) { ret Arg.literal{ty.scan(p)}; }
    val t: Token = state.name(p, "a callee");
    if (t.kind == lexer.WORD) {
        val v: opt[u32] = state.lookup(?p.values, t.text);
        if (sel v.some) { ret Arg.value{t}; }
    }
    ret Arg.function{t};
}

fun ordering(p: *Parser) opcode.Ordering {
    if (state.accept_word(p, "relaxed")) { ret opcode.Ordering.relaxed{}; }
    if (state.accept_word(p, "acquire")) { ret opcode.Ordering.acquire{}; }
    if (state.accept_word(p, "release")) { ret opcode.Ordering.release{}; }
    if (state.accept_word(p, "acq_rel")) { ret opcode.Ordering.acq_rel{}; }
    if (state.accept_word(p, "seq_cst")) { ret opcode.Ordering.seq_cst{}; }
    state.expected(p, "a memory ordering");
    ret opcode.Ordering.relaxed{};
}

fun wrapped(p: *Parser) u32 {
    state.expect(p, lexer.LPAREN, "(");
    val n: u32 = state.number32(p);
    state.expect(p, lexer.RPAREN, ")");
    ret n;
}

fun scale(p: *Parser) u8 {
    val k: u32 = state.number32(p);
    if (k > 0xff) { state.expected(p, "a scale of the register file"); }
    ret k::u8;
}

# read how a place is filled past its piece
fun fill(p: *Parser) Fill {
    if (state.accept_word(p, "exact"))     { ret Fill.exact{}; }
    if (state.accept_word(p, "undefined")) { ret Fill.undefined{}; }
    if (state.accept_word(p, "boxed"))     { ret Fill.boxed{}; }
    if (state.accept_word(p, "sign"))      { ret Fill.sign{wrapped(p)}; }
    if (state.accept_word(p, "zero"))      { ret Fill.zero{wrapped(p)}; }
    if (state.accept_word(p, "declared"))  { ret Fill.declared{wrapped(p)}; }
    state.expected(p, "how a place is filled");
    ret Fill.exact{};
}

# read one place: where a piece travels, how its size scales and how its
# place is filled
fun place(p: *Parser) Placed {
    var at: Place = Place.operand{0};
    state.expect(p, lexer.LBRACE, "{");
    if (state.accept_word(p, "reg")) {
        state.expect(p, lexer.LPAREN, "(");
        val class: u32 = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        val number: u32 = state.number32(p);
        state.expect(p, lexer.RPAREN, ")");
        if (class > 0xfffe || number > 0xffff) { state.expected(p, "a register's class and number"); }
        at = Place.register{rf.make(class::u16, number::u16)};
    }
    or (state.accept_word(p, "stack")) {
        state.expect(p, lexer.LPAREN, "(");
        val offset: u64   = state.number(p);
        var by:     Scale = Scale.fixed{};
        if (state.accept(p, lexer.COMMA)) {
            state.expect_word(p, "scaled");
            by = Scale.scaled{scale(p)};
        }
        state.expect(p, lexer.RPAREN, ")");
        at = Place.stack{ir_place.Stacked{offset: offset, scale: by}};
    }
    or (state.accept_word(p, "operand")) { at = Place.operand{wrapped(p)}; }
    or                                   { state.expected(p, "a register, a stack offset or an operand"); }
    state.expect(p, lexer.COMMA, ",");
    var by: Scale = Scale.fixed{};
    if (state.accept_word(p, "scaled")) {
        state.expect(p, lexer.LPAREN, "(");
        by = Scale.scaled{scale(p)};
        state.expect(p, lexer.RPAREN, ")");
    }
    or (!state.accept_word(p, "fixed")) { state.expected(p, "fixed or scaled"); }
    state.expect(p, lexer.COMMA, ",");
    val how: Fill = fill(p);
    state.expect(p, lexer.RBRACE, "}");
    ret Placed{place: at, scale: by, fill: how};
}

# read a bracketed list of places into `out`
pub fun places(p: *Parser, out: *vector.Vector[Placed]) {
    state.expect(p, lexer.LBRACKET, "[");
    if (!state.is(p, lexer.RBRACKET)) {
        for (state.ok(p)) {
            state.push[Placed](p, out, place(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACKET, "]");
}

fun numbers(p: *Parser, out: *vector.Vector[u64]) {
    state.expect(p, lexer.LBRACKET, "[");
    if (!state.is(p, lexer.RBRACKET)) {
        for (state.ok(p)) {
            state.push[u64](p, out, state.number(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACKET, "]");
}

# read an operand's role in an assembly block
fun role_word(p: *Parser) mo.Role {
    if (state.accept_word(p, "in"))    { ret mo.READ; }
    if (state.accept_word(p, "out"))   { ret mo.WRITE; }
    if (state.accept_word(p, "inout")) { ret mo.READ_WRITE; }
    if (state.accept_word(p, "none"))  { ret mo.NONE; }
    state.expected(p, "in, out, inout or none");
    ret mo.NONE;
}

# read what an assembly block's operand may be placed in
fun constraint(p: *Parser) inline.Constraint {
    if (state.accept_word(p, "reg")) {
        val k: u32 = wrapped(p);
        if (k > 0xfffe) { state.expected(p, "a class of the register file"); }
        ret inline.Constraint.class{k::u16};
    }
    if (state.accept_word(p, "mem")) { ret inline.Constraint.memory{}; }
    if (state.accept_word(p, "imm")) {
        state.expect(p, lexer.LPAREN, "(");
        val bits: u32 = state.number32(p);
        if (bits > 0xff) { state.expected(p, "a bit count of at most 255"); }
        state.expect(p, lexer.COMMA, ",");
        var signed: bool = false;
        if (state.accept_word(p, "signed"))    { signed = true; }
        or (!state.accept_word(p, "unsigned")) { state.expected(p, "signed or unsigned"); }
        var symbolic: bool = false;
        if (state.accept(p, lexer.COMMA)) {
            state.expect_word(p, "symbolic");
            symbolic = true;
        }
        state.expect(p, lexer.RPAREN, ")");
        ret inline.Constraint.immediate{inline.Immediate{bits: bits::u8, signed: signed, symbolic: symbolic}};
    }
    state.expected(p, "reg, mem or imm");
    ret inline.Constraint.memory{};
}

# read an inline assembly block: its text, its operands in braces each with
# its role, constraint and type, and what it declares it reads and writes of
# memory
fun assembled(p: *Parser, x: *Parts) {
    val t: Token = state.expect(p, lexer.STRING, "a block's text");
    if (!state.ok(p)) { ret; }
    x.block.text = t.text;
    state.expect(p, lexer.LBRACE, "{");
    if (!state.is(p, lexer.RBRACE)) {
        for (state.ok(p)) {
            val named: Token = state.name(p, "an operand's name");
            state.expect(p, lexer.COLON, ":");
            val role: mo.Role           = role_word(p);
            val c:    inline.Constraint = constraint(p);
            val held: Type              = ty.ty(p);
            state.push[AsmOperand](p, ?x.bound, AsmOperand{name: named.text, role: role, constraint: c, ty: held});
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACE, "}");
    x.block.reads  = state.accept_word(p, "reads");
    x.block.writes = state.accept_word(p, "writes");
}

# read a target op: `op`, then its set, its op, its result types and what it
# declares it reads and writes of memory
fun target_op(p: *Parser, x: *Parts) {
    state.expect_word(p, "op");
    state.expect(p, lexer.LPAREN, "(");
    x.op.set = state.expect(p, lexer.STRING, "an instruction set").text;
    state.expect(p, lexer.COMMA, ",");
    x.op.name = state.expect(p, lexer.STRING, "an op of the set").text;
    state.expect(p, lexer.COMMA, ",");
    state.expect(p, lexer.LBRACKET, "[");
    if (!state.is(p, lexer.RBRACKET)) {
        for (state.ok(p)) {
            state.push[Type](p, ?x.gives, ty.ty(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RBRACKET, "]");
    for (state.ok(p) && state.accept(p, lexer.COMMA)) {
        if (state.accept_word(p, "reads"))  { x.op.reads = true; }
        or (state.accept_word(p, "writes")) { x.op.writes = true; }
        or                                  { state.expected(p, "reads or writes"); }
    }
    state.expect(p, lexer.RPAREN, ")");
}

# a function of the module, by its name
fun function_named(p: *Parser, t: Token) opt[Function] {
    if (!state.ok(p)) { ret opt[Function].none{}; }
    val s: opt[Symbol] = module.find(p.m, t.text);
    if (sel s.some) {
        val at: Symbol = s.some;
        if (sel at.function) { ret opt[Function].some{at.function}; }
    }
    state.fail_at(p, t.line, t.column, Reason.unresolved{Named{what: "function", name: t.raw}});
    ret opt[Function].none{};
}

# read what a slot holds
fun immediate(p: *Parser, h: opcode.Holds, x: *Parts, slot: *Slot) {
    slot.given = true;
    if (sel h.ty)        { slot.imm = opcode.Immediate.ty{ty.ty(p)}; }
    or (sel h.alignment) { slot.imm = opcode.Immediate.alignment{state.number(p)}; }
    or (sel h.ordering)  { slot.imm = opcode.Immediate.ordering{ordering(p)}; }
    or (sel h.lane)      { slot.imm = opcode.Immediate.lane{state.number32(p)}; }
    or (sel h.lanes) {
        slot.start = x.lanes.len;
        state.expect(p, lexer.LBRACKET, "[");
        if (!state.is(p, lexer.RBRACKET)) {
            for (state.ok(p)) {
                state.push[u32](p, ?x.lanes, state.number32(p));
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
        slot.imm = opcode.Immediate.lanes{Slice[u32]{data: nil, size: x.lanes.len - slot.start}};
    }
    or (sel h.named) {
        if (state.accept_word(p, "all")) { slot.imm = opcode.Immediate.named{ir_place.Named.all{}}; }
        or                               { slot.imm = opcode.Immediate.named{ir_place.Named.first{state.number32(p)}}; }
    }
    or (sel h.places) {
        slot.start = x.places.len;
        places(p, ?x.places);
        slot.imm = opcode.Immediate.places{Slice[Placed]{data: nil, size: x.places.len - slot.start}};
    }
    or (sel h.member) {
        if (state.is(p, lexer.UINT)) { slot.imm = opcode.Immediate.member{state.number32(p)}; }
        or {
            slot.member = opt[Token].some{state.expect(p, lexer.WORD, "a member")};
            slot.imm    = opcode.Immediate.member{0};
        }
    }
    or (sel h.cases) {
        slot.start = x.cases.len;
        numbers(p, ?x.cases);
        slot.imm = opcode.Immediate.cases{Slice[u64]{data: nil, size: x.cases.len - slot.start}};
    }
    or (sel h.function) {
        val t: Token         = state.name(p, "a function");
        val f: opt[Function] = function_named(p, t);
        if (sel f.some) { slot.imm = opcode.Immediate.function{f.some}; }
    }
    or (sel h.assembly) {
        assembled(p, x);
        slot.imm = opcode.Immediate.assembly{?x.block};
    }
    or (sel h.op) {
        target_op(p, x);
        slot.imm = opcode.Immediate.op{?x.op};
    }
}

# read the bracketed immediates: the first bare when its slot prints bare, and
# every other by its slot's name
fun immediates(p: *Parser, x: *Parts) {
    if (!state.accept(p, lexer.LBRACKET)) { ret; }
    var first: bool = true;
    for (state.ok(p)) {
        var slot: u32   = 0;
        val t:    Token = p.tok;
        if (state.is(p, lexer.WORD) && state.next_is(p, lexer.COLON)) {
            val found: opt[u32] = slot_of(?x.row, t.text);
            if (sel found.none) {
                state.fail_at(p, t.line, t.column, Reason.unknown{Named{what: "slot", name: t.raw}});
                ret;
            }
            slot = found.some;
            state.advance(p);
            state.advance(p);
        }
        or (!first || opcode.slots(?x.row) == 0 || !implied.bare(x.row.immediates[0].holds, 0)) {
            state.expected(p, "a slot's name");
            ret;
        }
        if (x.slots.data[slot].given) {
            state.fail_at(p, t.line, t.column, Reason.duplicate{Named{what: "slot", name: t.raw}});
            ret;
        }
        immediate(p, x.row.immediates[slot].holds, x, ?x.slots.data[slot]);
        first = false;
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
    state.expect(p, lexer.RBRACKET, "]");
}

fun args(p: *Parser, out: *vector.Vector[Arg]) {
    state.expect(p, lexer.LPAREN, "(");
    if (!state.is(p, lexer.RPAREN)) {
        for (state.ok(p)) {
            state.push[Arg](p, out, arg(p));
            if (!state.accept(p, lexer.COMMA)) { brk; }
        }
    }
    state.expect(p, lexer.RPAREN, ")");
}

fun metadata_word(p: *Parser) bool {
    ret state.is_word(p, "at") || state.is_word(p, "in") || state.is_word(p, "holds");
}

# read the targets, each after the first led by its case value when the row
# states a case list
fun targets(p: *Parser, x: *Parts) {
    if (!(state.is(p, lexer.WORD) && !metadata_word(p)) && !state.is(p, lexer.UINT)) { ret; }
    for (state.ok(p)) {
        var case: opt[u64] = opt[u64].none{};
        if (state.is(p, lexer.UINT)) {
            case = opt[u64].some{state.number(p)};
            state.expect(p, lexer.COLON, ":");
        }
        val k:     Token = state.expect(p, lexer.WORD, "a block");
        val first: usize = x.args.len;
        if (state.is(p, lexer.LPAREN)) { args(p, ?x.args); }
        state.push[Target](p, ?x.targets, Target{block: k, case: case, first: first, count: x.args.len - first});
        if (!state.accept(p, lexer.COMMA)) { brk; }
    }
}

# read the location, inlining site and debug bindings of an instruction
fun metadata(p: *Parser, x: *Parts) {
    if (state.accept_word(p, "at")) { x.location = opt[u32].some{debug.ref(p, ?p.places, "location")}; }
    if (state.accept_word(p, "in")) { x.site = opt[u32].some{debug.ref(p, ?p.sites, "site")}; }
    if (state.accept_word(p, "holds")) {
        state.expect(p, lexer.LBRACKET, "[");
        if (!state.is(p, lexer.RBRACKET)) {
            for (state.ok(p)) {
                state.push[Binding](p, ?x.bindings, Binding{index: debug.ref(p, ?p.vars, "variable")});
                if (!state.accept(p, lexer.COMMA)) { brk; }
            }
        }
        state.expect(p, lexer.RBRACKET, "]");
    }
}

# read an instruction statement whole, building nothing of it but its types
fun read(p: *Parser, at: Mark, x: *Parts) {
    state.rewind(p, at);
    flags(p, x);
    results(p, x);
    val w: Token = state.expect(p, lexer.WORD, "an opcode");
    if (!state.ok(p)) { ret; }
    val code: opt[opcode.Opcode] = find_opcode(p, w);
    if (sel code.none) { ret; }
    val row: opt[opcode.Row] = opcode.row(code.some);
    if (sel row.none) { ret; }
    x.code = code.some;
    x.row  = row.some;
    var s: u32 = 0;
    for (s < opcode.slots(?x.row)) {
        state.push[Slot](p, ?x.slots, Slot{given: false, imm: opcode.Immediate.lane{0}, start: 0, member: opt[Token].none{}});
        s = s + 1;
    }
    immediates(p, x);
    val at_callee: opt[u32] = implied.callee_of(?x.row);
    if (sel at_callee.some)        { x.callee = opt[Arg].some{callee(p)}; }
    if (state.is(p, lexer.LPAREN)) { args(p, ?x.operands); }
    targets(p, x);
    metadata(p, x);
    state.expect_end(p);
}

# whether every value an argument names is built, keeping the first that is not
fun built(p: *Parser, a: Arg, blame: *Token, all: *bool) {
    if (!(sel a.value)) { ret; }
    val index: u32 = state.resolve(p, ?p.values, "value", a.value);
    if (state.ok(p) && index == state.UNBUILT) {
        if (@all) { @blame = a.value; }
        @all = false;
    }
}

# whether every value an instruction statement reads is built, and the first
# that is not
fun ready(p: *Parser, ln: Line, blame: *Token) bool {
    var x: Parts = parts(p);
    fin { release(?x); }
    read(p, ln.at, ?x);
    var all: bool     = true;
    val c:   opt[Arg] = x.callee;
    if (sel c.some) { built(p, c.some, blame, ?all); }
    var i: usize = 0;
    for (i < x.operands.len) {
        built(p, x.operands.data[i], blame, ?all);
        i = i + 1;
    }
    i = 0;
    for (i < x.args.len) {
        built(p, x.args.data[i], blame, ?all);
        i = i + 1;
    }
    ret all;
}

fun value_data(p: *Parser, f: Function, v: Value, line: u32, column: u32) opt[ValueData] {
    val got: res[ValueData, module.Error] = body.value_data(p.m, f, v);
    if (sel got.err) {
        state.fail_at(p, line, column, Reason.ir{got.err});
        ret opt[ValueData].none{};
    }
    ret opt[ValueData].some{got.ok};
}

# a constant as a value of the function
fun used(p: *Parser, c: Constant, line: u32, column: u32) Value {
    if (!state.ok(p)) { ret Value{index: state.UNBUILT}; }
    val v: Value = build.use_constant(?p.b, c);
    state.built(p, line, column);
    ret v;
}

# build a literal of a type, from where its scan started
fun literal(p: *Parser, k: ty.Pending, t: Type) Value {
    val after: Mark = state.mark(p);
    state.rewind(p, k.at);
    val c: Constant = ty.literal(p, t);
    state.rewind(p, after);
    ret used(p, c, k.line, k.column);
}

# the value an argument is, building a literal of the type it has, or of the
# type its place gives it
fun value(p: *Parser, f: Function, a: Arg, implied_type: opt[Type]) Value {
    if (sel a.value) { ret Value{index: state.resolve(p, ?p.values, "value", a.value)}; }
    if (sel a.literal) {
        val t: opt[Type] = ty.type_of(p, a.literal, implied_type);
        if (sel t.none) { ret Value{index: state.UNBUILT}; }
        ret literal(p, a.literal, t.some);
    }
    if (!(sel a.function)) { ret Value{index: state.UNBUILT}; }
    val t:  Token         = a.function;
    val fn: opt[Function] = function_named(p, t);
    if (sel fn.none) { ret Value{index: state.UNBUILT}; }
    val ptr: Type = ty.pointer(p, t.line, t.column);
    if (!state.ok(p)) { ret Value{index: state.UNBUILT}; }
    val c: Constant = build.constant(?p.b, mirl_constant.ConstantData.address{mirl_constant.Address{type: ptr, symbol: Symbol.function{fn.some}, offset: 0}});
    state.built(p, t.line, t.column);
    ret used(p, c, t.line, t.column);
}

# the type an argument is known to have before its instruction's literals are
# typed: a value's own, a literal's stated one, a callee's pointer
fun known(p: *Parser, f: Function, a: Arg) opt[Type] {
    if (sel a.value) {
        val index: u32 = state.resolve(p, ?p.values, "value", a.value);
        if (!state.ok(p)) { ret opt[Type].none{}; }
        val d: opt[ValueData] = value_data(p, f, Value{index: index}, a.value.line, a.value.column);
        if (sel d.none) { ret opt[Type].none{}; }
        ret opt[Type].some{d.some.type};
    }
    if (sel a.literal)  { ret a.literal.stated; }
    if (sel a.function) { ret opt[Type].some{ty.pointer(p, a.function.line, a.function.column)}; }
    ret opt[Type].none{};
}

# the member a slot's name names of the aggregate it indexes: the one its
# typedef writes so, or, for a type no typedef of this text writes, the one
# at the position an unnamed member's name spells
fun member(p: *Parser, k: *implied.Known, slot: u32, t: Token) u32 {
    val agg: opt[Type] = implied.member_aggregate(k, slot);
    if (sel agg.some) {
        val found: opt[u32] = state.member(p, agg.some.index, t.text);
        if (sel found.some) { ret found.some; }
    }
    if (state.unnamed(t.text, '_')) {
        var n: u64   = 0;
        var i: usize = 1;
        for (i < t.text.len && n <= 0xffffffff) {
            n = n * 10 + (t.text.data[i] - '0')::u64;
            i = i + 1;
        }
        if (n <= 0xffffffff) { ret n::u32; }
    }
    state.fail_at(p, t.line, t.column, Reason.unresolved{Named{what: "member", name: t.raw}});
    ret 0;
}

# point the lists of the immediates into the lists they were read into
fun point_lists(x: *Parts, imms: *opcode.Immediate) {
    var k: usize = 0;
    for (k < x.slots.len) {
        val old: opcode.Immediate = imms[k];
        val at:  usize            = x.slots.data[k].start;
        if (sel old.lanes) {
            var data: *u32 = nil;
            if (old.lanes.size > 0) { data = ?x.lanes.data[at]; }
            imms[k] = opcode.Immediate.lanes{Slice[u32]{data: data, size: old.lanes.size}};
        }
        if (sel old.places) {
            var data: *Placed = nil;
            if (old.places.size > 0) { data = ?x.places.data[at]; }
            imms[k] = opcode.Immediate.places{Slice[Placed]{data: data, size: old.places.size}};
        }
        if (sel old.cases) {
            var data: *u64 = nil;
            if (old.cases.size > 0) { data = ?x.cases.data[at]; }
            imms[k] = opcode.Immediate.cases{Slice[u64]{data: data, size: old.cases.size}};
        }
        if (sel old.assembly) {
            x.block.operands = Slice[AsmOperand]{data: x.bound.data, size: x.bound.len};
        }
        if (sel old.op) {
            x.op.results = Slice[Type]{data: x.gives.data, size: x.gives.len};
        }
        k = k + 1;
    }
}

# how many instructions of a statement's block stand before it and are built
fun position(lines: *vector.Vector[Line], i: usize) u32 {
    var n: u32   = 0;
    var j: usize = 0;
    for (j < i) {
        if (lines.data[j].block == lines.data[i].block && lines.data[j].built) { n = n + 1; }
        j = j + 1;
    }
    ret n;
}

# the block a target names
fun block_named(p: *Parser, blocks: *vector.Vector[Block], t: Token) opt[Block] {
    val k: u32 = state.resolve(p, ?p.blocks, "block", t);
    if (!state.ok(p)) { ret opt[Block].none{}; }
    ret opt[Block].some{blocks.data[k]};
}

# the type of a block's parameter at a position
fun parameter_type(p: *Parser, f: Function, k: Block, i: usize, at: Token) opt[Type] {
    val got: res[BlockData, module.Error] = body.block_data(p.m, f, k);
    if (sel got.err) {
        state.fail_at(p, at.line, at.column, Reason.ir{got.err});
        ret opt[Type].none{};
    }
    if (i >= got.ok.parameters.len) { ret opt[Type].none{}; }
    val d: opt[ValueData] = value_data(p, f, got.ok.parameters.data[i], at.line, at.column);
    if (sel d.none) { ret opt[Type].none{}; }
    ret opt[Type].some{d.some.type};
}

# the signature a function holds
fun signature_of(p: *Parser, fn: Function, at: Token) opt[Type] {
    val got: res[FunctionData, module.Error] = module.function_data(p.m, fn);
    if (sel got.err) {
        state.fail_at(p, at.line, at.column, Reason.ir{got.err});
        ret opt[Type].none{};
    }
    ret opt[Type].some{got.ok.signature};
}

# give the slots the text leaves out what they hold: the signature a direct
# callee states and every argument named, before the literals are typed
fun implied_before(p: *Parser, x: *Parts, imms: *opcode.Immediate, direct: opt[Function], at: Token) {
    var s: u32 = 0;
    for (s::usize < x.slots.len && state.ok(p)) {
        if (!x.slots.data[s].given) {
            val h: opcode.Holds = x.row.immediates[s].holds;
            if (sel h.named) {
                imms[s]               = opcode.Immediate.named{ir_place.Named.all{}};
                x.slots.data[s].given = true;
            }
            or (sel h.ty && implied.signature_slot(?x.row, s)) {
                if (sel direct.some) {
                    val sig: opt[Type] = signature_of(p, direct.some, at);
                    if (sel sig.some) {
                        imms[s]               = opcode.Immediate.ty{sig.some};
                        x.slots.data[s].given = true;
                    }
                }
            }
            or (sel h.cases) {
                x.slots.data[s].start = x.cases.len;
                var e: usize = 1;
                for (e < x.targets.len) {
                    val c: opt[u64] = x.targets.data[e].case;
                    if (sel c.some) { state.push[u64](p, ?x.cases, c.some); }
                    or {
                        val t: Token = x.targets.data[e].block;
                        state.fail_at(p, t.line, t.column, Reason.expected{"the case value the target is taken for"});
                    }
                    e = e + 1;
                }
                imms[s]               = opcode.Immediate.cases{Slice[u64]{data: nil, size: x.cases.len - x.slots.data[s].start}};
                x.slots.data[s].given = true;
            }
        }
        s = s + 1;
    }
}

# give an alignment the text leaves out the size of the scalar it accesses,
# once the literals are typed, and refuse any other slot still missing
fun implied_after(p: *Parser, k: *implied.Known, x: *Parts, imms: *opcode.Immediate, at: Token) {
    var s: u32 = 0;
    for (s::usize < x.slots.len && state.ok(p)) {
        if (!x.slots.data[s].given) {
            var filled: bool = false;
            if (sel x.row.immediates[s].holds.alignment) {
                val t: opt[Type] = implied.accessed(k.row, k.immediates, k.operands);
                if (sel t.some) {
                    val n: opt[u64] = implied.natural(p.m, t.some);
                    if (sel n.some) {
                        imms[s] = opcode.Immediate.alignment{n.some};
                        filled  = true;
                    }
                }
            }
            if (!filled) { state.fail_at(p, at.line, at.column, Reason.expected{x.row.immediates[s].name}); }
        }
        s = s + 1;
    }
}

# build one instruction statement
fun instruction(p: *Parser, f: Function, returns: Slice[Type], blocks: *vector.Vector[Block], lines: *vector.Vector[Line], i: usize) {
    val ln: Line  = lines.data[i];
    var x:  Parts = parts(p);
    fin { release(?x); }
    read(p, ln.at, ?x);
    if (!state.ok(p)) { ret; }
    var at: Token = p.tok;
    at.line   = ln.line;
    at.column = ln.column;

    # every operand in order, the callee at its place among the fixed ones
    var all:      vector.Vector[Arg]              = vector.init[Arg](p.a);
    var known_:   vector.Vector[opt[Type]]        = vector.init[opt[Type]](p.a);
    var values:   vector.Vector[Value]            = vector.init[Value](p.a);
    var outs:     vector.Vector[Type]             = vector.init[Type](p.a);
    var settled:  vector.Vector[bool]             = vector.init[bool](p.a);
    var actual:   vector.Vector[opt[Type]]        = vector.init[opt[Type]](p.a);
    var imms:     vector.Vector[opcode.Immediate] = vector.init[opcode.Immediate](p.a);
    var branches: vector.Vector[Branch]           = vector.init[Branch](p.a);
    var targeted: vector.Vector[Value]            = vector.init[Value](p.a);
    fin {
        vector.dnit[Arg](?all);
        vector.dnit[opt[Type]](?known_);
        vector.dnit[Value](?values);
        vector.dnit[Type](?outs);
        vector.dnit[bool](?settled);
        vector.dnit[opt[Type]](?actual);
        vector.dnit[opcode.Immediate](?imms);
        vector.dnit[Branch](?branches);
        vector.dnit[Value](?targeted);
    }
    val at_callee: opt[u32]      = implied.callee_of(?x.row);
    var direct:    opt[Function] = opt[Function].none{};
    var j:         usize         = 0;
    for (j <= x.operands.len) {
        if (sel at_callee.some) {
            if (at_callee.some::usize == j) {
                val c: opt[Arg] = x.callee;
                if (sel c.some) {
                    state.push[Arg](p, ?all, c.some);
                    val a: Arg = c.some;
                    if (sel a.function) { direct = function_named(p, a.function); }
                }
            }
        }
        if (j < x.operands.len) { state.push[Arg](p, ?all, x.operands.data[j]); }
        j = j + 1;
    }
    j = 0;
    for (j < all.len && state.ok(p)) {
        state.push[opt[Type]](p, ?known_, known(p, f, all.data[j]));
        state.push[bool](p, ?settled, false);
        state.push[opt[Type]](p, ?actual, opt[Type].none{});
        j = j + 1;
    }
    j = 0;
    for (j < x.results.len) {
        state.push[Type](p, ?outs, x.results.data[j].type);
        j = j + 1;
    }
    var s: usize = 0;
    for (s < x.slots.len) {
        state.push[opcode.Immediate](p, ?imms, x.slots.data[s].imm);
        s = s + 1;
    }
    if (!state.ok(p)) { ret; }
    var k: implied.Known = implied.Known{
        m:          p.m,
        row:        ?x.row,
        operands:   Slice[opt[Type]]{data: known_.data, size: known_.len},
        immediates: Slice[opcode.Immediate]{data: imms.data, size: imms.len},
        returns:    returns,
        results:    Slice[Type]{data: outs.data, size: outs.len},
    };

    # the members slots name, the slots the text leaves out, then the literals
    s = 0;
    for (s < x.slots.len && state.ok(p)) {
        val named: opt[Token] = x.slots.data[s].member;
        if (sel named.some) { imms.data[s] = opcode.Immediate.member{member(p, ?k, s::u32, named.some)}; }
        s = s + 1;
    }
    implied_before(p, ?x, imms.data, direct, at);
    if (!state.ok(p)) { ret; }
    implied.settle(?k, Slice[opt[Type]]{data: actual.data, size: actual.len}, settled.data);
    implied_after(p, ?k, ?x, imms.data, at);
    point_lists(?x, imms.data);
    j = 0;
    for (j < all.len && state.ok(p)) {
        state.push[Value](p, ?values, value(p, f, all.data[j], known_.data[j]));
        j = j + 1;
    }

    # the targets, each argument typed by the parameter it is given to
    j = 0;
    for (j < x.args.len && state.ok(p)) {
        state.push[Value](p, ?targeted, Value{index: 0});
        j = j + 1;
    }
    var e: usize = 0;
    for (e < x.targets.len && state.ok(p)) {
        val t:  Target     = x.targets.data[e];
        val to: opt[Block] = block_named(p, blocks, t.block);
        if (sel to.none) { ret; }
        var a: usize = 0;
        for (a < t.count && state.ok(p)) {
            targeted.data[t.first + a] = value(p, f, x.args.data[t.first + a], parameter_type(p, f, to.some, a, t.block));
            a                          = a + 1;
        }
        e = e + 1;
    }
    e = 0;
    for (e < x.targets.len && state.ok(p)) {
        val t:    Target     = x.targets.data[e];
        val to:   opt[Block] = block_named(p, blocks, t.block);
        var data: *Value     = nil;
        if (t.count > 0) { data = ?targeted.data[t.first]; }
        if (sel to.some) { state.push[Branch](p, ?branches, Branch{block: to.some, arguments: Slice[Value]{data: data, size: t.count}}); }
        e = e + 1;
    }
    if (!state.ok(p)) { ret; }

    # the instruction's metadata, then the instruction
    var secret: bool = x.secret;
    if (sel x.row.secrecy.declared) {
        j = 0;
        for (j < x.results.len) {
            if (x.results.data[j].secret) { secret = true; }
            j = j + 1;
        }
    }
    var storage: Bindings = UNBOUND;
    if (x.bindings.len > 0) {
        val list: res[Bindings, module.Error] = module.bindings(p.m, Slice[Binding]{data: x.bindings.data, size: x.bindings.len});
        if (sel list.err) {
            state.fail_at(p, ln.line, ln.column, Reason.ir{list.err});
            ret;
        }
        storage = list.ok;
    }
    build.at(?p.b, blocks.data[ln.block], position(lines, i));
    val location: opt[u32] = x.location;
    if (sel location.some) { build.locate(?p.b, opt[Location].some{Location{index: location.some}}); }
    val site: opt[u32] = x.site;
    if (sel site.some) { build.site(?p.b, opt[Site].some{Site{index: site.some}}); }
    build.flags(?p.b, x.flags);
    if (secret) { build.secret(?p.b, true); }
    val made: Instruction = build.emit(?p.b, Request{
        opcode:     x.code,
        operands:   Slice[Value]{data: values.data, size: values.len},
        immediates: Slice[opcode.Immediate]{data: imms.data, size: imms.len},
        targets:    Slice[Branch]{data: branches.data, size: branches.len},
    });
    build.plain(?p.b);
    state.built(p, ln.line, ln.column);
    if (!state.ok(p)) { ret; }
    state.note(p, ln.line, notes.at(notes.INSTRUCTION, f.index, made.index));
    val d: res[InstructionData, module.Error] = body.instruction_data(p.m, f, made);
    if (sel d.err) {
        state.fail_at(p, ln.line, ln.column, Reason.ir{d.err});
        ret;
    }
    if (d.ok.results.len != x.results.len) {
        state.fail_at(p, ln.line, ln.column, Reason.results{d.ok.results.len::u32});
        ret;
    }
    if (storage.index != UNBOUND.index) {
        var md: Metadata = d.ok.metadata;
        md.bindings = storage;
        val set: err[module.Error] = body.set_metadata(p.m, f, made, md);
        if (sel set.err) {
            state.fail_at(p, ln.line, ln.column, Reason.ir{set.err});
            ret;
        }
    }

    # the results, each the type and secrecy the statement declares it with
    var r: usize = 0;
    for (r < x.results.len && state.ok(p)) {
        val declared: Result         = x.results.data[r];
        val v:        Value          = build.result(?p.b, made, r::u32);
        val got:      opt[ValueData] = value_data(p, f, v, declared.name.line, declared.name.column);
        if (sel got.none) { ret; }
        if (!types.same(got.some.type, declared.type) || got.some.secret != declared.secret) {
            state.fail_at(p, declared.name.line, declared.name.column, Reason.unexpected{"a result type other than the one the instruction gives"});
            ret;
        }
        val given: opt[View] = own(declared.name);
        if (sel given.some) { build.name(?p.b, v, given.some); }
        state.rebind(p, ?p.values, declared.name.text, v.index);
        r = r + 1;
    }
    state.built(p, ln.line, ln.column);
}

# save a record, to bind once every instruction is built
fun note(p: *Parser, blocks: *vector.Vector[Block], before: u32, records: *vector.Vector[Record]) {
    val at:  Mark = state.mark(p);
    val ln:  u32  = p.tok.line;
    val col: u32  = p.tok.column;
    state.skip_statement(p);
    state.expect_end(p);
    state.push[Record](p, records, Record{at: at, block: blocks.len - 1, before: before, line: ln, column: col});
}

# the kind of step a word names, none when it names none
fun step_kind(t: Token) opt[point.Kind] {
    var i: u32 = 0;
    for (i::usize < point.rows()) {
        val r: opt[point.Row] = point.row(point.Kind{index: i});
        if (sel r.some && lexer.spelled(t.text, r.some.name)) { ret opt[point.Kind].some{point.Kind{index: i}}; }
        i = i + 1;
    }
    ret opt[point.Kind].none{};
}

# read an expression a record reads its variable through: a step around an
# expression, or the operand it starts from, appending its steps innermost
# first and keeping its operand
# ---
# ret: the type the expression has
fun expression(p: *Parser, f: Function, steps: *vector.Vector[Step], operand: *Value) opt[Type] {
    val t:    Token           = p.tok;
    var kind: opt[point.Kind] = opt[point.Kind].none{};
    if (state.is(p, lexer.WORD) && (state.next_is(p, lexer.LPAREN) || state.next_is(p, lexer.LBRACKET))) { kind = step_kind(t); }
    if (sel kind.none) {
        val a: Arg = arg(p);
        @operand = value(p, f, a, opt[Type].none{});
        if (!state.ok(p)) { ret opt[Type].none{}; }
        val d: opt[ValueData] = value_data(p, f, @operand, t.line, t.column);
        if (sel d.none) { ret opt[Type].none{}; }
        ret opt[Type].some{d.some.type};
    }
    state.advance(p);
    val row: opt[point.Row] = point.row(kind.some);
    if (sel row.none) { ret opt[Type].none{}; }
    var to: opt[Type] = opt[Type].none{};
    if (state.accept(p, lexer.LBRACKET)) {
        to = opt[Type].some{ty.ty(p)};
        state.expect(p, lexer.RBRACKET, "]");
    }
    state.expect(p, lexer.LPAREN, "(");
    val inner: opt[Type] = expression(p, f, steps, operand);
    if (!state.ok(p)) { ret opt[Type].none{}; }
    if (sel row.some.takes.constant) {
        state.expect(p, lexer.COMMA, ",");
        val c: Constant = ty.typed(p, inner);
        state.expect(p, lexer.RPAREN, ")");
        state.push[Step](p, steps, Step{kind: kind.some, argument: point.Argument.constant{c}});
        ret inner;
    }
    state.expect(p, lexer.RPAREN, ")");
    if (sel to.none) {
        state.fail_at(p, t.line, t.column, Reason.expected{"the type the step converts to, in brackets"});
        ret opt[Type].none{};
    }
    state.push[Step](p, steps, Step{kind: kind.some, argument: point.Argument.to{to.some}});
    ret to;
}

# read what a record gives its variable
fun reads(p: *Parser, f: Function, at: Record) Reads {
    if (state.accept_word(p, "unavailable")) { ret Reads.unavailable{}; }
    var steps: vector.Vector[Step] = vector.init[Step](p.a);
    fin { vector.dnit[Step](?steps); }
    var v: Value = Value{index: state.UNBUILT};
    expression(p, f, ?steps, ?v);
    if (!state.ok(p)) { ret Reads.unavailable{}; }
    val e: res[Expression, module.Error] = module.expression(p.m, Slice[Step]{data: steps.data, size: steps.len});
    if (sel e.err) {
        state.fail_at(p, at.line, at.column, Reason.ir{e.err});
        ret Reads.unavailable{};
    }
    ret Reads.operand{Operand{value: v, expression: e.ok}};
}

# bind one record at its point
fun record(p: *Parser, f: Function, blocks: *vector.Vector[Block], r: Record) {
    state.rewind(p, r.at);
    state.expect_word(p, "bind");
    val v:     u32  = debug.ref(p, ?p.vars, "variable");
    var piece: Bits = point.WHOLE;
    if (state.accept(p, lexer.LBRACKET)) {
        piece.offset = state.number32(p);
        state.expect(p, lexer.COMMA, ",");
        piece.size = state.number32(p);
        state.expect(p, lexer.RBRACKET, "]");
        if (state.ok(p) && piece.size == 0) { state.expected(p, "a piece of at least one bit"); }
    }
    state.expect(p, lexer.EQUALS, "=");
    val gave: Reads = reads(p, f, r);
    state.expect_end(p);
    if (!state.ok(p)) { ret; }
    build.at(?p.b, blocks.data[r.block], r.before);
    build.bind_piece_at(?p.b, Binding{index: v}, piece, gave);
    state.built(p, r.line, r.column);
    if (!state.ok(p)) { ret; }
    val held: res[*FunctionBody, module.Error] = module.body(p.m, f);
    if (sel held.ok) { state.note(p, r.line, notes.at(notes.RECORD, f.index, held.ok.points.len::u32)); }
}

# the results of the function a body is of
fun returns_of(p: *Parser, fn: Function, at: Token) Slice[Type] {
    val sig: opt[Type] = signature_of(p, fn, at);
    if (sel sig.none) { ret Slice[Type]{data: nil, size: 0}; }
    val got: res[types.Function, types.Error] = types.signature(?p.m.types, sig.some);
    if (sel got.err) {
        state.fail_at(p, at.line, at.column, Reason.types{got.err});
        ret Slice[Type]{data: nil, size: 0};
    }
    ret got.ok.results;
}

# read the body of a function, from its `{`, its entry's parameters from the
# function's parameter list, and the places of its entry's parameters from
# their list when the function is placed
pub fun function(p: *Parser, at: item.Body) {
    val f: Function = at.function;
    p.fn = f.index;
    map.clear_by[View, u32](?p.values);
    map.clear_by[View, u32](?p.blocks);
    build.enter(?p.b, f);
    var blocks:  vector.Vector[Block]  = vector.init[Block](p.a);
    var lines:   vector.Vector[Line]   = vector.init[Line](p.a);
    var records: vector.Vector[Record] = vector.init[Record](p.a);
    fin {
        vector.dnit[Block](?blocks);
        vector.dnit[Line](?lines);
        vector.dnit[Record](?records);
    }
    entry(p, at.parameters, ?blocks);
    state.rewind(p, at.at);
    val opened: Token = p.tok;
    state.expect(p, lexer.LBRACE, "{");
    var count: u32 = 0;
    for (state.ok(p) && !state.is(p, lexer.RBRACE)) {
        if (state.is(p, lexer.END)) { state.expected(p, "}"); }
        or (at_label(p)) {
            header(p, ?blocks);
            count = 0;
        }
        or (state.is_word(p, "bind") && state.next_is(p, lexer.WORD)) { note(p, ?blocks, count, ?records); }
        or {
            register(p, ?blocks, ?lines);
            count = count + 1;
        }
    }

    state.note(p, p.tok.line, notes.at(notes.FUNCTION_END, f.index, 0));
    val returns:  Slice[Type] = returns_of(p, f, opened);
    var left:     usize       = lines.len;
    var progress: bool        = true;
    var blame:    Token;
    for (state.ok(p) && left > 0 && progress) {
        progress = false;
        var i: usize = 0;
        for (i < lines.len && state.ok(p)) {
            if (!lines.data[i].built && ready(p, lines.data[i], ?blame)) {
                instruction(p, f, returns, ?blocks, ?lines, i);
                if (state.ok(p)) {
                    lines.data[i].built = true;
                    left                = left - 1;
                    progress            = true;
                }
            }
            i = i + 1;
        }
    }
    if (state.ok(p) && left > 0) {
        var i: usize = 0;
        for (lines.data[i].built) { i = i + 1; }
        ready(p, lines.data[i], ?blame);
        state.fail_at(p, blame.line, blame.column, Reason.unresolved{Named{what: "value", name: blame.raw}});
    }
    var r: usize = 0;
    for (r < records.len && state.ok(p)) {
        record(p, f, ?blocks, records.data[r]);
        r = r + 1;
    }
    if (!state.ok(p)) { ret; }
    val placed: opt[Mark] = at.placed;
    if (sel placed.some) {
        state.rewind(p, placed.some);
        val line:   u32                   = p.tok.line;
        val column: u32                   = p.tok.column;
        var list:   vector.Vector[Placed] = vector.init[Placed](p.a);
        fin { vector.dnit[Placed](?list); }
        places(p, ?list);
        if (!state.ok(p)) { ret; }
        val done: err[module.Error] = body.place_entry(p.m, f, Slice[Placed]{data: list.data, size: list.len});
        if (sel done.err) { state.fail_at(p, line, column, Reason.ir{done.err}); }
    }
}
