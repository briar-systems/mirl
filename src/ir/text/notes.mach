# the comments of a text, kept beside the module it reads into
#
# a comment is no part of the module. a reader that is asked to keep them
# marks where each statement it reads starts and what the statement made, an
# anchor, and the comments are then given to the anchors: a comment on a line
# of its own to the first statement after it, and one after code on its line
# to the statement that line belongs to. the printer writes each before or
# after its anchor, so a comment moves with what it was written beside, and a
# printing without notes writes none.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.ir.text.parse.lexer;

pub def Kind: u8;

pub val VERSION:      Kind = 0;
pub val TARGET:       Kind = 1;
pub val LANGUAGE:     Kind = 2;
pub val TYPEDEF:      Kind = 3;
pub val MEMBER:       Kind = 4;
pub val TYPEDEF_END:  Kind = 5;
pub val DEBUG:        Kind = 6;
pub val ENTRY:        Kind = 7;
pub val DEBUG_END:    Kind = 8;
pub val GLOBAL:       Kind = 9;
pub val FUNCTION:     Kind = 10;
pub val BLOCK:        Kind = 11;
pub val INSTRUCTION:  Kind = 12;
pub val RECORD:       Kind = 13;
pub val FUNCTION_END: Kind = 14;
pub val END:          Kind = 15;

# the debug entry kinds an ENTRY anchor's first part names
pub val FILE:     u32 = 0;
pub val LOCATION: u32 = 1;
pub val SITE:     u32 = 2;
pub val TYPE:     u32 = 3;
pub val VARIABLE: u32 = 4;

# what a comment stands beside: a kind and the ids that name the item, such as
# a function and an instruction of it
pub rec Anchor {
    kind: Kind;
    a:    u32;
    b:    u32;
}

# an anchor of a kind and its ids
pub fun at(kind: Kind, a: u32, b: u32) Anchor {
    ret Anchor{kind: kind, a: a, b: b};
}

# where a statement that made an anchor starts
# ---
# line:   its first line
# seq:    its place among the marks, which orders marks of one line
# anchor: what it made
pub rec Mark {
    line:   u32;
    seq:    u32;
    anchor: Anchor;
}

# one comment given to an anchor
# ---
# anchor:   what it stands beside
# trailing: it follows code on its line, so it is written after its anchor
# text:     its bytes from `#`, a view of the text it was read from
# seq:      its place in the text, which orders comments of one anchor
pub rec Note {
    anchor:   Anchor;
    trailing: bool;
    text:     View;
    seq:      u32;
}

# the comments of one text
# ---
# a:     the allocator the lists take
# marks: where each statement starts, which the reader adds
# list:  the comments, sorted by anchor once given
pub rec Notes {
    a:     *allocator.Allocator;
    marks: vector.Vector[Mark];
    list:  vector.Vector[Note];
}

# no notes yet
pub fun init(a: *allocator.Allocator) Notes {
    ret Notes{a: a, marks: vector.init[Mark](a), list: vector.init[Note](a)};
}

# give back the lists
pub fun dnit(n: *Notes) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    keep(?failed, vector.dnit[Mark](?n.marks));
    keep(?failed, vector.dnit[Note](?n.list));
    ret failed;
}

# note that a statement starting on a line made an anchor
pub fun mark(n: *Notes, line: u32, anchor: Anchor) err[allocator.Error] {
    val pushed: res[usize, allocator.Error] = vector.push[Mark](?n.marks, Mark{line: line, seq: n.marks.len::u32, anchor: anchor});
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

fun order(a: Anchor, b: Anchor) i64 {
    if (a.kind != b.kind) {
        if (a.kind < b.kind) { ret -1; }
        ret 1;
    }
    if (a.a != b.a) {
        if (a.a < b.a) { ret -1; }
        ret 1;
    }
    if (a.b != b.b) {
        if (a.b < b.b) { ret -1; }
        ret 1;
    }
    ret 0;
}

fun by_line(x: *Mark, y: *Mark) i64 {
    if (x.line != y.line) {
        if (x.line < y.line) { ret -1; }
        ret 1;
    }
    if (x.seq < y.seq) { ret -1; }
    if (x.seq > y.seq) { ret 1; }
    ret 0;
}

fun by_anchor(x: *Note, y: *Note) i64 {
    val c: i64 = order(x.anchor, y.anchor);
    if (c != 0)        { ret c; }
    if (x.seq < y.seq) { ret -1; }
    if (x.seq > y.seq) { ret 1; }
    ret 0;
}

# the anchor a comment on a line goes to: for a trailing one the first
# statement started on the last line one started on at or before its own,
# the statement the line belongs to, else the first started after it, and the
# text's end when none is
fun anchor_of(n: *Notes, line: u32, trailing: bool) Anchor {
    var lo: usize = 0;
    var hi: usize = n.marks.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (n.marks.data[mid].line <= line) { lo = mid + 1; }
        or                                  { hi = mid; }
    }
    if (trailing && lo > 0) {
        var k: usize = lo - 1;
        for (k > 0 && n.marks.data[k - 1].line == n.marks.data[k].line) { k = k - 1; }
        ret n.marks.data[k].anchor;
    }
    if (lo < n.marks.len) { ret n.marks.data[lo].anchor; }
    ret at(END, 0, 0);
}

# read the comments of a text and give each to its anchor, once the reader
# has marked every statement of it
# ---
# n:    the notes
# text: the text the reader read, which the notes' views are of
# ret:  ok, or the allocator's refusal
pub fun gather(n: *Notes, text: View) err[allocator.Error] {
    sort.sort_by[Mark](n.marks.data, n.marks.len, by_line);
    var owned:    vector.Vector[View]          = vector.init[View](n.a);
    var comments: vector.Vector[lexer.Comment] = vector.init[lexer.Comment](n.a);
    fin {
        var i: usize = 0;
        for (i < owned.len) {
            allocator.deallocate[u8](n.a, owned.data[i].data, owned.data[i].len);
            i = i + 1;
        }
        vector.dnit[View](?owned);
        vector.dnit[lexer.Comment](?comments);
    }
    var l: lexer.Lexer = lexer.init(text, n.a, ?owned);
    l.comments = ?comments;
    var last: u32   = 0;
    var seen: usize = 0;
    for {
        val t: lexer.Token = lexer.next(?l);
        for (seen < comments.len) {
            val c:        lexer.Comment               = comments.data[seen];
            val trailing: bool                        = last != 0 && c.line == last;
            val note:     Note                        = Note{anchor: anchor_of(n, c.line, trailing), trailing: trailing, text: c.text, seq: seen::u32};
            val pushed:   res[usize, allocator.Error] = vector.push[Note](?n.list, note);
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            seen = seen + 1;
        }
        val fault: opt[allocator.Error] = t.fault;
        if (sel fault.some)                             { ret err[allocator.Error].err{fault.some}; }
        if (t.kind == lexer.END || t.kind == lexer.BAD) { brk; }
        last = t.line;
    }
    val lost: opt[allocator.Error] = l.lost;
    if (sel lost.some) { ret err[allocator.Error].err{lost.some}; }
    sort.sort_by[Note](n.list.data, n.list.len, by_anchor);
    ret err[allocator.Error].ok{};
}

# the comments given to an anchor, in the order the text wrote them
pub fun of(n: *Notes, anchor: Anchor) Slice[Note] {
    var lo: usize = 0;
    var hi: usize = n.list.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (order(n.list.data[mid].anchor, anchor) < 0) { lo = mid + 1; }
        or                                              { hi = mid; }
    }
    var end: usize = lo;
    for (end < n.list.len && order(n.list.data[end].anchor, anchor) == 0) { end = end + 1; }
    ret Slice[Note]{data: ?n.list.data[lo], size: end - lo};
}
