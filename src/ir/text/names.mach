# the names the text gives the values or blocks of one function, unique
# within it
#
# an entity takes its own name when no entity named before it took that
# name, and otherwise its name, `.` and the least number from 1 that makes it
# unique. an unnamed entity takes the least number not taken, counting on
# from the last number an unnamed entity took.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.vector;
use std.format;

use mirl.fail.keep;
use mirl.slice;

# the names given so far
# ---
# a:       the allocator the names made here are taken from
# printed: the name each entity is printed by, empty until it is given one
# taken:   every name given
# owned:   the names made here, released with the namer
# scratch: where a candidate is spelled
# next:    the least number an unnamed entity may take
pub rec Names {
    a:       *allocator.Allocator;
    printed: vector.Vector[View];
    taken:   map.MapBy[View, bool];
    owned:   vector.Vector[View];
    scratch: vector.Vector[char];
    next:    u64;
}

fun hash_name(v: *View) u64 {
    ret slice.hash_view(0xcbf29ce484222325, @v);
}

fun same_name(a: *View, b: *View) bool {
    ret slice.same_view(@a, @b);
}

# a namer that has given no names
pub fun init(a: *allocator.Allocator) Names {
    var n: Names;
    n.a       = a;
    n.printed = vector.init[View](a);
    n.taken   = map.init_by[View, bool](a, hash_name, same_name);
    n.owned   = vector.init[View](a);
    n.scratch = vector.init[char](a);
    n.next    = 0;
    ret n;
}

fun forget(n: *Names) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < n.owned.len) {
        keep(?failed, slice.release_view(n.a, n.owned.data[i]));
        i = i + 1;
    }
    vector.clear[View](?n.owned);
    map.clear_by[View, bool](?n.taken);
    vector.clear[View](?n.printed);
    n.next = 0;
    ret failed;
}

# give back everything the namer holds
pub fun dnit(n: *Names) err[allocator.Error] {
    var failed: err[allocator.Error] = forget(n);
    keep(?failed, vector.dnit[View](?n.printed));
    keep(?failed, map.dnit_by[View, bool](?n.taken));
    keep(?failed, vector.dnit[View](?n.owned));
    keep(?failed, vector.dnit[char](?n.scratch));
    ret failed;
}

# forget every name and start over for count entities
pub fun reset(n: *Names, count: usize) err[allocator.Error] {
    val forgot: err[allocator.Error] = forget(n);
    if (sel forgot.err) { ret forgot; }
    val room: res[usize, allocator.Error] = vector.reserve[View](?n.printed, count);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < count) {
        vector.push[View](?n.printed, View{data: nil, len: 0});
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# whether entity id has been given a name
pub fun given(n: *Names, id: u32) bool {
    ret n.printed.data[id].len != 0;
}

# the name entity id is printed by, empty until it is given one
pub fun printed(n: *Names, id: u32) View {
    ret n.printed.data[id];
}

fun free(n: *Names, v: View) bool {
    ret !map.contains_by[View, bool](?n.taken, ?v);
}

fun take(n: *Names, id: u32, v: View) err[allocator.Error] {
    val r: res[bool, allocator.Error] = map.insert_by[View, bool](?n.taken, v, true);
    if (sel r.err) { ret err[allocator.Error].err{r.err}; }
    n.printed.data[id] = v;
    ret err[allocator.Error].ok{};
}

# take the candidate spelled in scratch, as a copy the namer owns
fun take_scratch(n: *Names, id: u32) err[allocator.Error] {
    val c: res[View, allocator.Error] = slice.copy_view(n.a, View{data: n.scratch.data, len: n.scratch.len});
    if (sel c.err) { ret err[allocator.Error].err{c.err}; }
    val kept: res[usize, allocator.Error] = vector.push[View](?n.owned, c.ok);
    if (sel kept.err) {
        slice.release_view(n.a, c.ok);
        ret err[allocator.Error].err{kept.err};
    }
    ret take(n, id, c.ok);
}

# spell a base name, a dot when dotted, then k in decimal, in scratch
fun spell(n: *Names, base: View, dotted: bool, k: u64) err[allocator.Error] {
    vector.clear[char](?n.scratch);
    var digits: [20]u8;
    val count:  usize                       = format.put_u64(?digits[0], k);
    val room:   res[usize, allocator.Error] = vector.reserve[char](?n.scratch, base.len + 1 + count);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < base.len) {
        vector.push[char](?n.scratch, base.data[i]);
        i = i + 1;
    }
    if (dotted) { vector.push[char](?n.scratch, '.'); }
    i = 0;
    for (i < count) {
        vector.push[char](?n.scratch, digits[i]);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# give entity id its name, by the rule above
# ---
# n:    the namer
# id:   the entity, not yet given a name
# name: its own name, which outlives the namer, or none
# ret:  ok, or the allocator's refusal
pub fun give(n: *Names, id: u32, name: opt[View]) err[allocator.Error] {
    if (sel name.some) {
        if (free(n, name.some)) { ret take(n, id, name.some); }
        var k: u64 = 1;
        for {
            val s: err[allocator.Error] = spell(n, name.some, true, k);
            if (sel s.err)                                               { ret s; }
            if (free(n, View{data: n.scratch.data, len: n.scratch.len})) { ret take_scratch(n, id); }
            k = k + 1;
        }
    }
    for {
        val s: err[allocator.Error] = spell(n, View{data: nil, len: 0}, false, n.next);
        if (sel s.err) { ret s; }
        n.next = n.next + 1;
        if (free(n, View{data: n.scratch.data, len: n.scratch.len})) { ret take_scratch(n, id); }
    }
    ret err[allocator.Error].ok{};
}
