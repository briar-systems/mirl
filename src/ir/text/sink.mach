# a writer that keeps every byte written to it, for text read back in memory

use std.types.char.char;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.vector;
use io_error: std.io.error;
use io:       std.io.writer;
use std.io.writer.WriteError;

# the bytes written so far
# ---
# bytes: every byte written, in order
pub rec Sink {
    bytes: vector.Vector[char];
}

# an empty sink taking its storage from a
pub fun init(a: *allocator.Allocator) Sink {
    ret Sink{bytes: vector.init[char](a)};
}

# give back the sink's storage
pub fun dnit(s: *Sink) err[allocator.Error] {
    ret vector.dnit[char](?s.bytes);
}

fun put(ctx: ptr, p: *u8, n: usize) res[usize, WriteError] {
    val s:    *Sink                       = ctx::*Sink;
    val room: res[usize, allocator.Error] = vector.reserve[char](?s.bytes, n);
    if (sel room.err) { ret res[usize, WriteError].err{io.native_failure(0, io_error.make(io_error.RESOURCE_EXHAUSTED, io_error.OP_WRITE))}; }
    var i: usize = 0;
    for (i < n) {
        vector.push[char](?s.bytes, p[i]);
        i = i + 1;
    }
    ret res[usize, WriteError].ok{n};
}

# a writer appending to s, which must outlive it
pub fun writer(s: *Sink) io.Writer {
    ret io.Writer{ctx: s::ptr, f_write: put};
}

# the bytes written so far, valid until the next write
pub fun view(s: *Sink) View {
    ret View{data: s.bytes.data, len: s.bytes.len};
}
