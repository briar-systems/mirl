# the debug table of one module: its storage, its refusals and the copies it owns

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.debug.record.Binding;
use mirl.ir.debug.record.Case;
use mirl.ir.debug.record.Enumerator;
use mirl.ir.debug.record.File;
use mirl.ir.debug.record.Inlining;
use mirl.ir.debug.record.Kind;
use mirl.ir.debug.record.Location;
use mirl.ir.debug.record.Member;
use mirl.ir.debug.record.Position;
use mirl.ir.debug.record.Shape;
use mirl.ir.debug.record.Site;
use mirl.ir.debug.record.Type;
use mirl.ir.debug.record.Variable;
use ir_type: mirl.ir.type;

# why the table refused a request
# ---
# alloc:    the allocator refused storage
# types:    the ir type table refused a read of a layout
# empty:    a key, path or callee that is an empty name
# width:    a base type of width zero
# unknown:  a debug type this table did not give out
# file:     a file this table did not give out
# location: a location this table did not give out
# site:     a site this table did not give out
# binding:  a binding this table did not give out
# kind:     the entry is of this kind, not the one the request needs
# conflict: the key already names this entry, described otherwise
# defined:  this entry is already defined
# open:     this entry was declared and never defined
# layout:   the ir type it is laid out as is of this kind, not the one it needs
# field:    a member names this field, which its layout does not have
# agree:    the member at this field is laid out other than the owner's field
# pointee:  no entry is described under this pointee key
# pending:  this pointer's pointee is not linked yet
pub tag Error: u8 {
    alloc: allocator.Error;
    types: ir_type.Error;
    empty;
    width;
    unknown:  Type;
    file:     File;
    location: Location;
    site:     Site;
    binding:  Binding;
    kind:     Kind;
    conflict: Type;
    defined:  Type;
    open:     Type;
    layout:   ir_type.Kind;
    field:    u32;
    agree:    u32;
    pointee:  View;
    pending:  Type;
}

# one debug type
# ---
# key:     its identity across modules
# name:    its source name
# layout:  the ir type an aggregate is laid out as, or none
# shape:   its description, empty until defined
# defined: whether its members are given
pub rec Node {
    key:     View;
    name:    View;
    layout:  opt[ir_type.Type];
    shape:   Shape;
    defined: bool;
}

# the debug table of one module
# ---
# a:         the allocator every copy and list is taken from
# nodes:     the debug types, indexed by id
# keys:      each debug type by its key
# pointers:  the pointer entries in the order they were declared
# linked:    how many of `pointers` have their pointee linked
# files:     the file paths, indexed by id
# paths:     each file by its path
# positions: the locations, indexed by id
# sites:     the inlining sites, indexed by id
# bindings:  the variable bindings, indexed by id
pub rec Table {
    a:         *allocator.Allocator;
    nodes:     vector.Vector[Node];
    keys:      map.MapBy[View, Type];
    pointers:  vector.Vector[Type];
    linked:    usize;
    files:     vector.Vector[View];
    paths:     map.MapBy[View, File];
    positions: vector.Vector[Position];
    sites:     vector.Vector[Inlining];
    bindings:  vector.Vector[Variable];
}

# create an empty table
# ---
# a:   the allocator the table takes its storage from
# ret: the table, owning nothing until the first entry
pub fun init(a: *allocator.Allocator) Table {
    var t: Table;
    t.a         = a;
    t.nodes     = vector.init[Node](a);
    t.keys      = map.init_by[View, Type](a, hash_name, same_name);
    t.pointers  = vector.init[Type](a);
    t.linked    = 0;
    t.files     = vector.init[View](a);
    t.paths     = map.init_by[View, File](a, hash_name, same_name);
    t.positions = vector.init[Position](a);
    t.sites     = vector.init[Inlining](a);
    t.bindings  = vector.init[Variable](a);
    ret t;
}

# release every copy, list and index the table holds
# ---
# t:   the table
# ret: ok, or the allocator's refusal of the first release that failed
pub fun dnit(t: *Table) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < t.nodes.len) {
        val n: *Node = ?t.nodes.data[i];
        keep(?failed, release_name(t.a, n.key));
        keep(?failed, release_name(t.a, n.name));
        keep(?failed, release_shape(t.a, ?n.shape));
        i = i + 1;
    }
    i = 0;
    for (i < t.files.len) {
        keep(?failed, release_name(t.a, t.files.data[i]));
        i = i + 1;
    }
    i = 0;
    for (i < t.sites.len) {
        keep(?failed, release_name(t.a, t.sites.data[i].callee));
        i = i + 1;
    }
    i = 0;
    for (i < t.bindings.len) {
        keep(?failed, release_name(t.a, t.bindings.data[i].name));
        i = i + 1;
    }
    keep(?failed, vector.dnit[Node](?t.nodes));
    keep(?failed, map.dnit_by[View, Type](?t.keys));
    keep(?failed, vector.dnit[Type](?t.pointers));
    keep(?failed, vector.dnit[View](?t.files));
    keep(?failed, map.dnit_by[View, File](?t.paths));
    keep(?failed, vector.dnit[Position](?t.positions));
    keep(?failed, vector.dnit[Inlining](?t.sites));
    keep(?failed, vector.dnit[Variable](?t.bindings));
    ret failed;
}

fun keep(failed: *err[allocator.Error], r: err[allocator.Error]) {
    if (sel r.err && sel failed.ok) { @failed = r; }
}

fun hash_name(v: *View) u64 {
    var h: u64   = 0xcbf29ce484222325;
    var i: usize = 0;
    for (i < v.len) {
        h = (h ^ v.data[i]::u64) * 0x100000001b3;
        i = i + 1;
    }
    ret h;
}

fun same_name(a: *View, b: *View) bool {
    ret equal(@a, @b);
}

# whether two names have the same bytes
pub fun equal(a: View, b: View) bool {
    if (a.len != b.len) { ret false; }
    var i: usize = 0;
    for (i < a.len) {
        if (a.data[i] != b.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a copy of a slice the table owns
pub fun copy[T](a: *allocator.Allocator, s: Slice[T]) res[Slice[T], allocator.Error] {
    var out: Slice[T];
    out.data = nil;
    out.size = s.size;
    if (s.size == 0) { ret res[Slice[T], allocator.Error].ok{out}; }
    val got: res[*T, allocator.Error] = allocator.allocate[T](a, s.size);
    if (sel got.err) { ret res[Slice[T], allocator.Error].err{got.err}; }
    out.data = got.ok;
    var i: usize = 0;
    for (i < s.size) {
        out.data[i] = s.data[i];
        i           = i + 1;
    }
    ret res[Slice[T], allocator.Error].ok{out};
}

# give back a slice the table owns
pub fun release[T](a: *allocator.Allocator, s: Slice[T]) err[allocator.Error] {
    if (s.size == 0) { ret err[allocator.Error].ok{}; }
    ret allocator.deallocate[T](a, s.data, s.size);
}

# a copy of a name the table owns
pub fun copy_name(a: *allocator.Allocator, v: View) res[View, allocator.Error] {
    val c: res[Slice[char], allocator.Error] = copy[char](a, Slice[char]{data: v.data, size: v.len});
    if (sel c.err) { ret res[View, allocator.Error].err{c.err}; }
    ret res[View, allocator.Error].ok{View{data: c.ok.data, len: c.ok.size}};
}

# give back a name the table owns
pub fun release_name(a: *allocator.Allocator, v: View) err[allocator.Error] {
    ret release[char](a, Slice[char]{data: v.data, size: v.len});
}

# a copy of the members whose list and names the table owns
pub fun copy_members(a: *allocator.Allocator, s: Slice[Member]) res[Slice[Member], allocator.Error] {
    val c: res[Slice[Member], allocator.Error] = copy[Member](a, s);
    if (sel c.err) { ret c; }
    var i: usize = 0;
    for (i < s.size) {
        c.ok.data[i].name = View{data: nil, len: 0};
        i                 = i + 1;
    }
    i = 0;
    for (i < s.size) {
        val n: res[View, allocator.Error] = copy_name(a, s.data[i].name);
        if (sel n.err) {
            release_members(a, c.ok);
            ret res[Slice[Member], allocator.Error].err{n.err};
        }
        c.ok.data[i].name = n.ok;
        i                 = i + 1;
    }
    ret c;
}

# give back the names of members, then their list
pub fun release_members(a: *allocator.Allocator, s: Slice[Member]) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < s.size) {
        keep(?failed, release_name(a, s.data[i].name));
        i = i + 1;
    }
    keep(?failed, release[Member](a, s));
    ret failed;
}

# a copy of the cases whose list and names the table owns
pub fun copy_cases(a: *allocator.Allocator, s: Slice[Case]) res[Slice[Case], allocator.Error] {
    val c: res[Slice[Case], allocator.Error] = copy[Case](a, s);
    if (sel c.err) { ret c; }
    var i: usize = 0;
    for (i < s.size) {
        c.ok.data[i].name    = View{data: nil, len: 0};
        c.ok.data[i].payload = opt[Member].none{};
        i                    = i + 1;
    }
    i = 0;
    for (i < s.size) {
        val n: res[View, allocator.Error] = copy_name(a, s.data[i].name);
        if (sel n.err) {
            release_cases(a, c.ok);
            ret res[Slice[Case], allocator.Error].err{n.err};
        }
        c.ok.data[i].name = n.ok;
        val p: opt[Member] = s.data[i].payload;
        if (sel p.some) {
            val pn: res[View, allocator.Error] = copy_name(a, p.some.name);
            if (sel pn.err) {
                release_cases(a, c.ok);
                ret res[Slice[Case], allocator.Error].err{pn.err};
            }
            c.ok.data[i].payload = opt[Member].some{Member{name: pn.ok, type: p.some.type, field: p.some.field}};
        }
        i = i + 1;
    }
    ret c;
}

# give back the names of cases, then their list
pub fun release_cases(a: *allocator.Allocator, s: Slice[Case]) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < s.size) {
        keep(?failed, release_name(a, s.data[i].name));
        val p: opt[Member] = s.data[i].payload;
        if (sel p.some) { keep(?failed, release_name(a, p.some.name)); }
        i = i + 1;
    }
    keep(?failed, release[Case](a, s));
    ret failed;
}

# a copy of the enumerators whose list and names the table owns
pub fun copy_enumerators(a: *allocator.Allocator, s: Slice[Enumerator]) res[Slice[Enumerator], allocator.Error] {
    val c: res[Slice[Enumerator], allocator.Error] = copy[Enumerator](a, s);
    if (sel c.err) { ret c; }
    var i: usize = 0;
    for (i < s.size) {
        c.ok.data[i].name = View{data: nil, len: 0};
        i                 = i + 1;
    }
    i = 0;
    for (i < s.size) {
        val n: res[View, allocator.Error] = copy_name(a, s.data[i].name);
        if (sel n.err) {
            release_enumerators(a, c.ok);
            ret res[Slice[Enumerator], allocator.Error].err{n.err};
        }
        c.ok.data[i].name = n.ok;
        i                 = i + 1;
    }
    ret c;
}

# give back the names of enumerators, then their list
pub fun release_enumerators(a: *allocator.Allocator, s: Slice[Enumerator]) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < s.size) {
        keep(?failed, release_name(a, s.data[i].name));
        i = i + 1;
    }
    keep(?failed, release[Enumerator](a, s));
    ret failed;
}

# give back what a shape owns
pub fun release_shape(a: *allocator.Allocator, s: *Shape) err[allocator.Error] {
    if (sel s.structure) { ret release_members(a, s.structure); }
    if (sel s.union)     { ret release_members(a, s.union); }
    if (sel s.tagged) {
        var failed: err[allocator.Error] = release_name(a, s.tagged.discriminant.name);
        keep(?failed, release_cases(a, s.tagged.cases));
        ret failed;
    }
    if (sel s.enumeration) { ret release_enumerators(a, s.enumeration.enumerators); }
    if (sel s.pointer)     { ret release_name(a, s.pointer.pointee); }
    if (sel s.function) {
        var failed: err[allocator.Error] = release[Type](a, s.function.params);
        keep(?failed, release[Type](a, s.function.results));
        ret failed;
    }
    ret err[allocator.Error].ok{};
}
