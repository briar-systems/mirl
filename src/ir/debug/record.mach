# the records of the debug table: ids, debug type descriptions and source places
#
# no record holds a size or an offset. a producer asks the target's data layout
# for those, through the ir type an aggregate names.

use std.collections.slice.Slice;
use std.types.option.opt;
use std.types.view.View;

use ir_type: mirl.ir.type;

# a source location, as an id into its module's debug table
# ---
# index: the location's position in its table
pub rec Location {
    index: u32;
}

# an inlining site, as an id into its module's debug table
# ---
# index: the site's position in its table
pub rec Site {
    index: u32;
}

# a variable binding, as an id into its module's debug table
# ---
# index: the binding's position in its table
pub rec Binding {
    index: u32;
}

# a debug type, as an id into its module's debug table
# ---
# index: the entry's position in its table
pub rec Type {
    index: u32;
}

# a source file, as an id into its module's debug table
# ---
# index: the file's position in its table
pub rec File {
    index: u32;
}

# where in the source something is
# ---
# file:   the file
# line:   the line, from one
# column: the column, from one
pub rec Position {
    file:   File;
    line:   u32;
    column: u32;
}

# code inlined at a call
# ---
# call:   where the call was
# callee: the inlined function's symbol, which names it in every module
# parent: the site the call itself was inlined at, or none
pub rec Inlining {
    call:   Location;
    callee: View;
    parent: opt[Site];
}

# what the instruction carrying a binding gives the variable
# ---
# value:   its result is the variable's value
# storage: its result addresses the variable's storage
pub tag Holds: u8 {
    value;
    storage;
}

# a source variable
# ---
# name:      its source name
# type:      its debug type
# declared:  where it is declared
# parameter: its position among the function's parameters, or none for a local
# holds:     what the instruction carrying the binding gives it
pub rec Variable {
    name:      View;
    type:      Type;
    declared:  Location;
    parameter: opt[u32];
    holds:     Holds;
}

# the kinds of debug type
pub tag Kind: u8 {
    base;
    structure;
    union;
    tagged;
    enumeration;
    array;
    pointer;
    function;
}

# how a base type's bits are read
pub tag Encoding: u8 {
    signed;
    unsigned;
    float;
    boolean;
    character;
    address;
}

# a scalar source type
# ---
# encoding: how its bits are read
# width:    its width in bits, at least one
pub rec Base {
    encoding: Encoding;
    width:    u32;
}

# a named part of an aggregate
# ---
# name:  its source name
# type:  its debug type
# field: the member of the owner's ir type it is laid out as
pub rec Member {
    name:  View;
    type:  Type;
    field: u32;
}

# one case of a tagged union
# ---
# name:    its source name
# value:   the discriminant value that selects it
# payload: its payload, whose field is a member of the payload union, or none
pub rec Case {
    name:    View;
    value:   u64;
    payload: opt[Member];
}

# a tagged union, laid out as a structure of a discriminant and a union of cases
# ---
# discriminant: the member holding the discriminant
# payload:      the field of the layout that is the union of the cases
# cases:        the cases in source order
pub rec Tagged {
    discriminant: Member;
    payload:      u32;
    cases:        Slice[Case];
}

# a named value of an enumeration
# ---
# name:  its source name
# value: its bits, read by the enumeration's base encoding
pub rec Enumerator {
    name:  View;
    value: u64;
}

# an enumeration
# ---
# base:        the base type its values are held in
# enumerators: its values in source order
pub rec Enumeration {
    base:        Type;
    enumerators: Slice[Enumerator];
}

# an array
# ---
# element: the element's debug type
# count:   the element count
pub rec Array {
    element: Type;
    count:   u64;
}

# a pointer, whose pointee is linked by key at the end of the module
# ---
# pointee: the key of the pointee's entry
# target:  the pointee's entry once linked, or none
pub rec Pointer {
    pointee: View;
    target:  opt[Type];
}

# a function signature
# ---
# params:  the parameter types in order
# results: the result types in order
pub rec Function {
    params:  Slice[Type];
    results: Slice[Type];
}

# the full description of a debug type, what `define` takes and `shape` gives back
#
# a structure or union is its members, each laid out as a field of the ir type
# the entry was declared with. a slice or name given is copied, and one read
# back stays valid for the life of the table.
pub tag Shape: u8 {
    base:        Base;
    structure:   Slice[Member];
    union:       Slice[Member];
    tagged:      Tagged;
    enumeration: Enumeration;
    array:       Array;
    pointer:     Pointer;
    function:    Function;
}

# what an entry is before its members are walked
# ---
# base:      a complete scalar
# structure: an ir structure it is laid out as
# union:     an ir union it is laid out as
# tagged:    an ir structure of a discriminant and a union it is laid out as
# pointer:   the key of its pointee, complete once linked
pub tag Head: u8 {
    base:      Base;
    structure: ir_type.Type;
    union:     ir_type.Type;
    tagged:    ir_type.Type;
    enumeration;
    array;
    pointer: View;
    function;
}

# a debug type to declare
# ---
# key:  its identity across modules, supplied by the front end and never derived
# name: its source name, empty for an anonymous type
# head: what it is before its members are walked
pub rec Entry {
    key:  View;
    name: View;
    head: Head;
}

# what `declare` found
# ---
# fresh: a new open entry, whose members the caller walks and then defines
# known: the entry already described under that key
pub tag Declared: u8 {
    fresh: Type;
    known: Type;
}
