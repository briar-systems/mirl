# marks of a debug table, so the entries made since one can be taken back
#
# the table changes in place only where an open entry is defined and where a
# pointer's pointee is linked. a mark keeps what each open entry was, and a
# rewind puts it back, unlinks what was linked since and takes back every
# entry, file, location, site and binding made since.

use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.map;
use std.collections.vector;

use mirl.fail.keep;
use std.types.view.View;

use mirl.ir.debug.record.File;
use mirl.ir.debug.record.Shape;
use mirl.ir.debug.record.Type;
use mirl.ir.debug.table;
use mirl.ir.debug.table.Table;
use mirl.slice;

# an entry that was open at a mark, and its open description
# ---
# type:  the entry
# shape: its description then, which owns nothing
pub rec Open {
    type:  Type;
    shape: Shape;
}

# how far a debug table reached at a mark
# ---
# nodes:     its number of entries
# pointers:  its number of pointer entries
# linked:    how many pointer entries had their pointee linked
# files:     its number of files
# positions: its number of locations
# sites:     its number of inlining sites
# bindings:  its number of bindings
# open:      the entries open then
pub rec Mark {
    nodes:     usize;
    pointers:  usize;
    linked:    usize;
    files:     usize;
    positions: usize;
    sites:     usize;
    bindings:  usize;
    open:      vector.Vector[Open];
}

# where a debug table reaches now
# ---
# t:   the table
# ret: the mark, which `rewind` or `forget` gives back, or the allocator's
#      refusal
pub fun mark(t: *Table) res[Mark, allocator.Error] {
    var at: Mark  = Mark{nodes: t.nodes.len, pointers: t.pointers.len, linked: t.linked, files: t.files.len, positions: t.positions.len, sites: t.sites.len, bindings: t.bindings.len, open: vector.init[Open](t.a)};
    var i:  usize = 0;
    for (i < t.nodes.len) {
        if (!t.nodes.data[i].defined) {
            val pushed: res[usize, allocator.Error] = vector.push[Open](?at.open, Open{type: Type{index: i::u32}, shape: t.nodes.data[i].shape});
            if (sel pushed.err) {
                vector.dnit[Open](?at.open);
                ret res[Mark, allocator.Error].err{pushed.err};
            }
        }
        i = i + 1;
    }
    ret res[Mark, allocator.Error].ok{at};
}

# give back a mark that is not rewound to
pub fun forget(at: *Mark) err[allocator.Error] {
    ret vector.dnit[Open](?at.open);
}

# take a debug table back to a mark, and give the mark back
#
# an id made since names nothing afterwards. it never allocates.
# ---
# t:   the table
# at:  a mark of the table
# ret: ok, or the first release the allocator refused once everything was
#      taken back
pub fun rewind(t: *Table, at: *Mark) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < at.open.len) {
        val o: Open        = at.open.data[i];
        val n: *table.Node = ?t.nodes.data[o.type.index];
        if (n.defined) {
            keep(?failed, table.release_shape(t.a, ?n.shape));
            n.shape   = o.shape;
            n.defined = false;
        }
        i = i + 1;
    }
    i = at.linked;
    for (i < t.linked && i < at.pointers) {
        val n: *table.Node = ?t.nodes.data[t.pointers.data[i].index];
        if (sel n.shape.pointer) { n.shape.pointer.target = opt[Type].none{}; }
        i = i + 1;
    }
    t.linked       = at.linked;
    t.pointers.len = at.pointers;
    for (t.nodes.len > at.nodes) {
        val n: *table.Node = ?t.nodes.data[t.nodes.len - 1];
        map.remove_by[View, Type](?t.keys, ?n.key);
        keep(?failed, table.release_shape(t.a, ?n.shape));
        keep(?failed, slice.release_view(t.a, n.key));
        keep(?failed, slice.release_view(t.a, n.name));
        t.nodes.len = t.nodes.len - 1;
    }
    for (t.files.len > at.files) {
        val f: *View = ?t.files.data[t.files.len - 1];
        map.remove_by[View, File](?t.paths, f);
        keep(?failed, slice.release_view(t.a, @f));
        t.files.len = t.files.len - 1;
    }
    t.positions.len = at.positions;
    for (t.sites.len > at.sites) {
        keep(?failed, slice.release_view(t.a, t.sites.data[t.sites.len - 1].callee));
        t.sites.len = t.sites.len - 1;
    }
    for (t.bindings.len > at.bindings) {
        keep(?failed, slice.release_view(t.a, t.bindings.data[t.bindings.len - 1].name));
        t.bindings.len = t.bindings.len - 1;
    }
    keep(?failed, forget(at));
    ret failed;
}
