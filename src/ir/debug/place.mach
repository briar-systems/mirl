# the source places of a module: files, locations, inlining sites and variable bindings

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.vector;

use mirl.ir.debug.record.Binding;
use mirl.ir.debug.record.File;
use mirl.ir.debug.record.Inlining;
use mirl.ir.debug.record.Location;
use mirl.ir.debug.record.Position;
use mirl.ir.debug.record.Site;
use mirl.ir.debug.record.Variable;
use mirl.ir.debug.table.Error;
use mirl.ir.debug.table.Table;
use mirl.slice;

# the id of a source file, adding it when the table has not seen its path
# ---
# t:    the table
# path: the file's path, which is copied
# ret:  the one id for that path, or why it was refused
pub fun file(t: *Table, path: View) res[File, Error] {
    if (path.len == 0) { ret res[File, Error].err{Error.empty{}}; }
    val found: opt[*File] = map.get_by[View, File](?t.paths, ?path);
    if (sel found.some) { ret res[File, Error].ok{@found.some}; }

    val owned: res[View, allocator.Error] = slice.copy_view(t.a, path);
    if (sel owned.err) { ret res[File, Error].err{Error.alloc{owned.err}}; }
    val id:     File                        = File{index: t.files.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[View](?t.files, owned.ok);
    if (sel pushed.err) {
        slice.release_view(t.a, owned.ok);
        ret res[File, Error].err{Error.alloc{pushed.err}};
    }
    val keyed: res[bool, allocator.Error] = map.insert_by[View, File](?t.paths, owned.ok, id);
    if (sel keyed.err) {
        vector.pop[View](?t.files);
        slice.release_view(t.a, owned.ok);
        ret res[File, Error].err{Error.alloc{keyed.err}};
    }
    ret res[File, Error].ok{id};
}

# the path of a source file, valid for the life of the table
pub fun path(t: *Table, f: File) res[View, Error] {
    if (f.index::usize >= t.files.len) { ret res[View, Error].err{Error.file{f}}; }
    ret res[View, Error].ok{t.files.data[f.index]};
}

# add a source location
# ---
# t:   the table
# p:   where it is, in a file this table gave out
# ret: its id, or why it was refused
pub fun location(t: *Table, p: Position) res[Location, Error] {
    if (p.file.index::usize >= t.files.len) { ret res[Location, Error].err{Error.file{p.file}}; }
    val id:     Location                    = Location{index: t.positions.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Position](?t.positions, p);
    if (sel pushed.err) { ret res[Location, Error].err{Error.alloc{pushed.err}}; }
    ret res[Location, Error].ok{id};
}

# where a source location is
pub fun position(t: *Table, l: Location) res[Position, Error] {
    if (l.index::usize >= t.positions.len) { ret res[Position, Error].err{Error.location{l}}; }
    ret res[Position, Error].ok{t.positions.data[l.index]};
}

# add an inlining site
# ---
# t:   the table
# i:   the call, the inlined function and the site the call was itself inlined
#      at, whose callee is copied
# ret: its id, or why it was refused
pub fun site(t: *Table, i: Inlining) res[Site, Error] {
    if (i.call.index::usize >= t.positions.len) { ret res[Site, Error].err{Error.location{i.call}}; }
    if (i.callee.len == 0)                      { ret res[Site, Error].err{Error.empty{}}; }
    val parent: opt[Site] = i.parent;
    if (sel parent.some) {
        if (parent.some.index::usize >= t.sites.len) { ret res[Site, Error].err{Error.site{parent.some}}; }
    }

    val callee: res[View, allocator.Error] = slice.copy_view(t.a, i.callee);
    if (sel callee.err) { ret res[Site, Error].err{Error.alloc{callee.err}}; }
    var owned: Inlining = i;
    owned.callee = callee.ok;
    val id:     Site                        = Site{index: t.sites.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Inlining](?t.sites, owned);
    if (sel pushed.err) {
        slice.release_view(t.a, callee.ok);
        ret res[Site, Error].err{Error.alloc{pushed.err}};
    }
    ret res[Site, Error].ok{id};
}

# the call, inlined function and parent of an inlining site
pub fun inlining(t: *Table, s: Site) res[Inlining, Error] {
    if (s.index::usize >= t.sites.len) { ret res[Inlining, Error].err{Error.site{s}}; }
    ret res[Inlining, Error].ok{t.sites.data[s.index]};
}

# bind a source variable
# ---
# t:   the table
# v:   the variable, whose name is copied
# ret: its binding, or why it was refused
pub fun bind(t: *Table, v: Variable) res[Binding, Error] {
    if (v.type.index::usize >= t.nodes.len)         { ret res[Binding, Error].err{Error.unknown{v.type}}; }
    if (v.declared.index::usize >= t.positions.len) { ret res[Binding, Error].err{Error.location{v.declared}}; }

    val name: res[View, allocator.Error] = slice.copy_view(t.a, v.name);
    if (sel name.err) { ret res[Binding, Error].err{Error.alloc{name.err}}; }
    var owned: Variable = v;
    owned.name = name.ok;
    val id:     Binding                     = Binding{index: t.bindings.len::u32};
    val pushed: res[usize, allocator.Error] = vector.push[Variable](?t.bindings, owned);
    if (sel pushed.err) {
        slice.release_view(t.a, name.ok);
        ret res[Binding, Error].err{Error.alloc{pushed.err}};
    }
    ret res[Binding, Error].ok{id};
}

# the variable a binding ties
pub fun variable(t: *Table, b: Binding) res[Variable, Error] {
    if (b.index::usize >= t.bindings.len) { ret res[Variable, Error].err{Error.binding{b}}; }
    ret res[Variable, Error].ok{t.bindings.data[b.index]};
}
