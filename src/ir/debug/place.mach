# the source places of a module: the directory its files resolve against, files, locations, inlining sites and
# variable bindings

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.debug.record.Binding;
use mirl.ir.debug.record.File;
use mirl.ir.debug.record.Inlining;
use mirl.ir.debug.record.Location;
use mirl.ir.debug.record.Position;
use mirl.ir.debug.record.Site;
use mirl.ir.debug.record.Variable;
use mirl.ir.debug.table.Error;
use mirl.ir.debug.table.Table;

# state the directory a relative file path of the table resolves against, the producer's compilation directory, in
# place of one stated before
# ---
# t:    the table
# path: the directory, which is copied
# ret:  ok, or why it was refused, the table left as it was unless only the release of the one before was refused
pub fun state_directory(t: *Table, path: View) err[Error] {
    if (path.len == 0) { ret err[Error].err{Error.empty{}}; }
    val res_owned: res[View, allocator.Error] = slice.copy_view(t.a, path);
    if (sel res_owned.err) { ret err[Error].err{Error.alloc{res_owned.err}}; }
    val opt_was: opt[View] = t.directory;
    t.directory = opt[View].some{res_owned.ok};
    if (sel opt_was.some) {
        val err_freed: err[allocator.Error] = slice.view_free(t.a, opt_was.some);
        if (sel err_freed.err) { ret err[Error].err{Error.alloc{err_freed.err}}; }
    }
    ret err[Error].ok{};
}

# the directory a relative file path of the table resolves against, valid for the life of the table, none where its
# producer stated none
pub fun directory(t: *Table) opt[View] {
    ret t.directory;
}

# the id of a source file, adding it when the table has not seen its path
# ---
# t:    the table
# path: the file's path, which is copied
# ret:  the one id for that path, or why it was refused
pub fun file(t: *Table, path: View) res[File, Error] {
    if (path.len == 0) { ret res[File, Error].err{Error.empty{}}; }
    val opt_found: opt[*File] = map.get_by[View, File](?t.paths, ?path);
    if (sel opt_found.some) { ret res[File, Error].ok{@opt_found.some}; }

    val res_owned: res[View, allocator.Error] = slice.copy_view(t.a, path);
    if (sel res_owned.err) { ret res[File, Error].err{Error.alloc{res_owned.err}}; }
    val id:         File                        = (t.files.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[View](?t.files, res_owned.ok);
    if (sel res_pushed.err) {
        slice.view_free(t.a, res_owned.ok);
        ret res[File, Error].err{Error.alloc{res_pushed.err}};
    }
    val res_keyed: res[bool, allocator.Error] = map.insert_by[View, File](?t.paths, res_owned.ok, id);
    if (sel res_keyed.err) {
        vector.pop[View](?t.files);
        slice.view_free(t.a, res_owned.ok);
        ret res[File, Error].err{Error.alloc{res_keyed.err}};
    }
    ret res[File, Error].ok{id};
}

# the path of a source file, valid for the life of the table
pub fun path(t: *Table, f: File) res[View, Error] {
    if (f::usize >= t.files.len) { ret res[View, Error].err{Error.file{f}}; }
    ret res[View, Error].ok{t.files.data[f]};
}

# add a source location
# ---
# t:   the table
# p:   where it is, in a file this table gave out
# ret: its id, or why it was refused
pub fun location(t: *Table, p: Position) res[Location, Error] {
    if (p.file::usize >= t.files.len) { ret res[Location, Error].err{Error.file{p.file}}; }
    val id:         Location                    = (t.positions.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Position](?t.positions, p);
    if (sel res_pushed.err) { ret res[Location, Error].err{Error.alloc{res_pushed.err}}; }
    ret res[Location, Error].ok{id};
}

# where a source location is
pub fun position(t: *Table, l: Location) res[Position, Error] {
    if (l::usize >= t.positions.len) { ret res[Position, Error].err{Error.location{l}}; }
    ret res[Position, Error].ok{t.positions.data[l]};
}

# add an inlining site
# ---
# t:   the table
# i:   the call, the inlined function and the site the call was itself inlined
#      at, whose callee is copied
# ret: its id, or why it was refused
pub fun site(t: *Table, i: Inlining) res[Site, Error] {
    if (i.call::usize >= t.positions.len) { ret res[Site, Error].err{Error.location{i.call}}; }
    if (i.callee.len == 0)                { ret res[Site, Error].err{Error.empty{}}; }
    val opt_parent: opt[Site] = i.parent;
    if (sel opt_parent.some) {
        if (opt_parent.some::usize >= t.sites.len) { ret res[Site, Error].err{Error.site{opt_parent.some}}; }
    }

    val res_callee: res[View, allocator.Error] = slice.copy_view(t.a, i.callee);
    if (sel res_callee.err) { ret res[Site, Error].err{Error.alloc{res_callee.err}}; }
    var owned: Inlining = i;
    owned.callee = res_callee.ok;
    val id:         Site                        = (t.sites.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Inlining](?t.sites, owned);
    if (sel res_pushed.err) {
        slice.view_free(t.a, res_callee.ok);
        ret res[Site, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Site, Error].ok{id};
}

# the call, inlined function and parent of an inlining site
pub fun inlining(t: *Table, s: Site) res[Inlining, Error] {
    if (s::usize >= t.sites.len) { ret res[Inlining, Error].err{Error.site{s}}; }
    ret res[Inlining, Error].ok{t.sites.data[s]};
}

# bind a source variable
# ---
# t:   the table
# v:   the variable, whose name is copied
# ret: its binding, or why it was refused
pub fun bind(t: *Table, v: Variable) res[Binding, Error] {
    if (v.type::usize >= t.nodes.len)         { ret res[Binding, Error].err{Error.unknown{v.type}}; }
    if (v.declared::usize >= t.positions.len) { ret res[Binding, Error].err{Error.location{v.declared}}; }

    val res_name: res[View, allocator.Error] = slice.copy_view(t.a, v.name);
    if (sel res_name.err) { ret res[Binding, Error].err{Error.alloc{res_name.err}}; }
    var owned: Variable = v;
    owned.name = res_name.ok;
    val id:         Binding                     = (t.bindings.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[Variable](?t.bindings, owned);
    if (sel res_pushed.err) {
        slice.view_free(t.a, res_name.ok);
        ret res[Binding, Error].err{Error.alloc{res_pushed.err}};
    }
    ret res[Binding, Error].ok{id};
}

# the variable a binding ties
pub fun variable(t: *Table, b: Binding) res[Variable, Error] {
    if (b::usize >= t.bindings.len) { ret res[Variable, Error].err{Error.binding{b}}; }
    ret res[Variable, Error].ok{t.bindings.data[b]};
}
