# the opcode reference: every row of the opcode table written as markdown
#
# the text is a function of the rows alone, so the committed reference cannot
# drift from the table. it goes through any io.Writer, the same one the text
# printer writes to.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.filesystem;
use std.print;

use std.format;
use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.ir.opcode.row.Arity;
use mirl.ir.opcode.row.Effects;
use mirl.ir.opcode.row.Holds;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Order;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Role;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.Traps;
use mirl.ir.opcode.row.VectorClass;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Orderings;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Secrecy;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.rule.Trap;
use mirl.ir.opcode.table;
use mirl.ir.text.sink;
use mirl.slice;
use mirl.verify.failure;
use rules: mirl.verify.table;

# the file the reference is committed as, relative to the project root
pub val PATH: str = "doc/ir/opcodes.md";

# one writing: the writer and the first failure, after which writes are skipped
rec Out {
    w:      *io.Writer;
    failed: opt[WriteError];
}

fun ok(o: *Out) bool {
    ret sel o.failed.none;
}

fun wrote(o: *Out, r: res[usize, WriteError]) {
    if (!(sel r.err)) { ret; }
    if (ok(o))        { o.failed = opt[WriteError].some{r.err}; }
}

fun put(o: *Out, s: str) {
    if (!ok(o)) { ret; }
    wrote(o, format.write_str(o.w, s));
}

fun num(o: *Out, n: u64) {
    if (!ok(o)) { ret; }
    wrote(o, format.write_u64(o.w, n));
}

fun line(o: *Out) {
    put(o, "\n");
}

fun code(o: *Out, s: str) {
    put(o, "`");
    put(o, s);
    put(o, "`");
}

fun role_name(r: Role) str {
    if (sel r.value)     { ret "value"; }
    if (sel r.address)   { ret "address"; }
    if (sel r.stored)    { ret "stored value"; }
    if (sel r.offset)    { ret "byte offset"; }
    if (sel r.length)    { ret "byte count"; }
    if (sel r.condition) { ret "condition"; }
    if (sel r.callee)    { ret "callee address"; }
    if (sel r.argument)  { ret "argument"; }
    if (sel r.returned)  { ret "returned value"; }
    ret "unstated";
}

fun holds_name(h: Holds) str {
    if (sel h.ty)        { ret "a type"; }
    if (sel h.alignment) { ret "an alignment"; }
    if (sel h.ordering)  { ret "a memory ordering"; }
    if (sel h.lane)      { ret "a lane index"; }
    if (sel h.lanes)     { ret "a lane list"; }
    ret "unstated";
}

# a subject: an operand by its name, or the type an immediate holds
fun subject(o: *Out, r: *Row, s: Subject) {
    if (sel s.operand) {
        code(o, r.operands[s.operand].name);
        ret;
    }
    if (sel s.immediate) {
        put(o, "the type in ");
        code(o, r.immediates[s.immediate].name);
        ret;
    }
    put(o, "nothing");
}

# the type a subject names
fun type_of(o: *Out, r: *Row, s: Subject) {
    if (sel s.operand) { put(o, "the type of "); }
    subject(o, r, s);
}

fun class_phrase(o: *Out, c: Class) {
    if (sel c.any)     { put(o, "of any type"); }
    or (sel c.integer) { put(o, "an integer"); }
    or (sel c.width) {
        put(o, "an integer of width ");
        num(o, c.width::u64);
    }
    or (sel c.float)    { put(o, "a float"); }
    or (sel c.pointer)  { put(o, "a pointer"); }
    or (sel c.function) { put(o, "a function type"); }
    or (sel c.bytes)    { put(o, "an integer of a whole number of bytes"); }
    or (sel c.vector)   { put(o, "a vector"); }
    or (sel c.scalar)   { put(o, "an integer, a float or a pointer"); }
}

fun ordering_list(o: *Out, a: Orderings) {
    var first: bool = true;
    if (a.relaxed) {
        put(o, "relaxed");
        first = false;
    }
    if (a.acquire) {
        if (!first) { put(o, ", "); }
        put(o, "acquire");
        first = false;
    }
    if (a.release) {
        if (!first) { put(o, ", "); }
        put(o, "release");
        first = false;
    }
    if (a.acq_rel) {
        if (!first) { put(o, ", "); }
        put(o, "acq_rel");
        first = false;
    }
    if (a.seq_cst) {
        if (!first) { put(o, ", "); }
        put(o, "seq_cst");
    }
}

fun pair(o: *Out, r: *Row, left: Subject, right: Subject, middle: str) {
    subject(o, r, left);
    put(o, middle);
    subject(o, r, right);
}

fun rule(o: *Out, r: *Row, x: Rule) {
    put(o, "  - ");
    if (sel x.is) {
        subject(o, r, x.is.subject);
        put(o, " is ");
        class_phrase(o, x.is.class);
    }
    or (sel x.agree) {
        pair(o, r, x.agree.left, x.agree.right, " and ");
        put(o, " are the same type");
    }
    or (sel x.parameters) {
        put(o, "the tail operands are the parameters of ");
        subject(o, r, x.parameters);
    }
    or (sel x.returns) {
        put(o, "the tail operands are the results of the function the instruction is in");
    }
    or (sel x.conform) {
        pair(o, r, x.conform.left, x.conform.right, " and ");
        put(o, " are both scalars, or both vectors of the same lane count");
    }
    or (sel x.element) {
        pair(o, r, x.element.left, x.element.right, " and ");
        put(o, " have the same lane type, a scalar being its own lane");
    }
    or (sel x.wider) {
        pair(o, r, x.wider.left, x.wider.right, " has more bits than ");
    }
    or (sel x.bits) {
        pair(o, r, x.bits.left, x.bits.right, " and ");
        put(o, " have the same number of bits");
    }
    or (sel x.lane) {
        put(o, "each lane index in ");
        code(o, r.immediates[x.lane.slot].name);
        put(o, " is below the lane count of ");
        subject(o, r, x.lane.over.left);
        if (!(sel x.lane.over.right.unstated)) {
            put(o, " plus that of ");
            subject(o, r, x.lane.over.right);
        }
    }
    or (sel x.count) {
        code(o, r.immediates[x.count.slot].name);
        put(o, " holds one index per lane of ");
        subject(o, r, x.count.of);
    }
    or (sel x.lanes_of) {
        put(o, "the tail operands are the lanes of ");
        subject(o, r, x.lanes_of);
        put(o, ", one per lane and of its lane type");
    }
    or (sel x.ordering) {
        code(o, r.immediates[x.ordering.slot].name);
        put(o, " is one of ");
        ordering_list(o, x.ordering.orderings);
    }
    line(o);
}

fun result(o: *Out, r: *Row, x: Result) {
    put(o, "  - ");
    if (sel x.same) {
        put(o, "one result of ");
        type_of(o, r, x.same);
    }
    or (sel x.mask) {
        put(o, "one result of i1, or of a vector of i1 with the lanes of ");
        subject(o, r, x.mask);
        put(o, " when it is a vector");
    }
    or (sel x.results) {
        put(o, "the results of ");
        subject(o, r, x.results);
    }
    or (sel x.element) {
        put(o, "one result of the lane type of ");
        subject(o, r, x.element);
    }
    line(o);
}

fun trap(o: *Out, r: *Row, t: Trap) {
    put(o, "  - traps ");
    if (sel t.zero) {
        put(o, "when ");
        code(o, r.operands[t.zero].name);
        put(o, " is zero in any lane");
    }
    or (sel t.overflow) {
        put(o, "when ");
        code(o, r.operands[t.overflow.dividend].name);
        put(o, " is the least signed value and ");
        code(o, r.operands[t.overflow.divisor].name);
        put(o, " is all ones in any lane");
    }
    or (sel t.fault) {
        put(o, "when the address in ");
        code(o, r.operands[t.fault].name);
        put(o, " cannot be accessed");
    }
    or (sel t.callee) {
        put(o, "when the function called traps");
    }
    or (sel t.always) {
        put(o, "on every execution");
    }
    line(o);
}

fun effects(o: *Out, r: *Row) {
    val e: *Effects = ?r.effects;
    put(o, "- effects: ");
    var stated: bool = false;
    if (e.reads) {
        put(o, "reads memory");
        stated = true;
    }
    if (e.writes) {
        if (stated) { put(o, ", "); }
        put(o, "writes memory");
        stated = true;
    }
    if (e.speculatable) {
        if (stated) { put(o, ", "); }
        put(o, "speculatable");
        stated = true;
    }
    if (e.mergeable) {
        if (stated) { put(o, ", "); }
        put(o, "mergeable");
        stated = true;
    }
    if (!stated) { put(o, "none"); }
    line(o);
    var i: usize = 0;
    for (i < $length_of(Traps) && !(sel e.traps[i].unstated)) {
        trap(o, r, e.traps[i]);
        i = i + 1;
    }
}

fun targets(o: *Out, a: Arity) {
    if (sel a.exact) {
        num(o, a.exact::u64);
        ret;
    }
    put(o, "at least ");
    num(o, a.at_least::u64);
}

fun vector_name(v: VectorClass) str {
    if (sel v.none)     { ret "none"; }
    if (sel v.lanewise) { ret "lanewise"; }
    if (sel v.across)   { ret "across"; }
    ret "unstated";
}

fun secrecy_name(s: Secrecy) str {
    if (sel s.none)         { ret "no results"; }
    if (sel s.propagates)   { ret "propagates"; }
    if (sel s.declassifies) { ret "declassifies"; }
    if (sel s.declared)     { ret "declared"; }
    ret "unstated";
}

fun order_name(x: Order) str {
    if (sel x.ordered)      { ret "ordered"; }
    if (sel x.unordered)    { ret "unordered"; }
    if (sel x.sequential)   { ret "sequential"; }
    if (sel x.reassociable) { ret "reassociable"; }
    ret "none";
}

fun operand_list(o: *Out, r: *Row) {
    val n: u32 = fixed(r);
    var i: u32 = 0;
    for (i < n) {
        if (i > 0) { put(o, ", "); }
        code(o, r.operands[i].name);
        i = i + 1;
    }
    if (!(sel r.tail.unstated)) {
        if (n > 0) { put(o, ", then "); }
        put(o, "any number of ");
        put(o, role_name(r.tail));
        put(o, " operands");
    }
    if (n == 0 && sel r.tail.unstated) { put(o, "none"); }
}

fun immediate_list(o: *Out, r: *Row) {
    val n: u32 = slots(r);
    var i: u32 = 0;
    for (i < n) {
        if (i > 0) { put(o, ", "); }
        code(o, r.immediates[i].name);
        put(o, " ");
        put(o, holds_name(r.immediates[i].holds));
        i = i + 1;
    }
    if (n == 0) { put(o, "none"); }
}

fun summary(o: *Out, r: *Row) {
    put(o, "| ");
    code(o, r.name);
    put(o, " | ");
    operand_list(o, r);
    put(o, " | ");
    immediate_list(o, r);
    put(o, " | ");
    put(o, vector_name(r.vector));
    put(o, " | ");
    put(o, secrecy_name(r.secrecy));
    put(o, " |\n");
}

fun detail(o: *Out, r: *Row) {
    put(o, "### ");
    code(o, r.name);
    put(o, "\n\n- operands: ");
    operand_list(o, r);
    put(o, "\n- immediates: ");
    immediate_list(o, r);
    put(o, "\n- targets: ");
    targets(o, r.targets);
    if (r.terminator) { put(o, ", ends its block"); }
    put(o, "\n- typing:");
    var i: usize = 0;
    if (sel r.rules[0].unstated) { put(o, " none"); }
    line(o);
    for (i < $length_of(Rules) && !(sel r.rules[i].unstated)) {
        rule(o, r, r.rules[i]);
        i = i + 1;
    }
    put(o, "- results:");
    if (sel r.results[0].unstated) { put(o, " none"); }
    line(o);
    i = 0;
    for (i < $length_of(Results) && !(sel r.results[i].unstated)) {
        result(o, r, r.results[i]);
        i = i + 1;
    }
    effects(o, r);
    put(o, "- secrecy: ");
    put(o, secrecy_name(r.secrecy));
    put(o, "\n- vector: ");
    put(o, vector_name(r.vector));
    if (!(sel r.order.none)) {
        put(o, "\n- order: ");
        put(o, order_name(r.order));
    }
    if (!(sel r.overshift.none)) {
        put(o, "\n- shift by the width or more: ");
        if (sel r.overshift.zero) { put(o, "zero"); }
        or                        { put(o, "every bit is the sign bit of the shifted operand"); }
    }
    put(o, "\n\n");
}

# write the opcode reference
# ---
# w:   the writer the text goes to
# ret: ok, or the writer's refusal, after which nothing more was written
pub fun write(w: *io.Writer) err[WriteError] {
    var o: Out = Out{w: w, failed: opt[WriteError].none{}};
    put(?o, "# Opcode reference\n\n");
    put(?o, "This file is generated from the rows of the opcode table and is not edited by hand. ");
    put(?o, "Each opcode's semantics are stated in [the specification](../ir.md).\n\n");
    put(?o, "Operand names are the names the text form gives them. A subject such as ");
    put(?o, "`lhs` is the type of that operand, and a subject written as the type in an immediate is ");
    put(?o, "the type that immediate holds. In a lanewise opcode a class applies to the lanes of a vector operand. ");
    put(?o, "In an across opcode the operand must be a vector and a class applies to its lanes.\n\n");
    put(?o, "| opcode | operands | immediates | vector | secrecy |\n|---|---|---|---|---|\n");
    var i: u32 = 0;
    for (i < table.rows()) {
        val got: opt[Row] = table.row(Opcode{index: i});
        if (sel got.some) {
            var r: Row = got.some;
            summary(?o, ?r);
        }
        i = i + 1;
    }
    put(?o, "\n");
    i = 0;
    for (i < table.rows()) {
        val got: opt[Row] = table.row(Opcode{index: i});
        if (sel got.some) {
            var r: Row = got.some;
            detail(?o, ?r);
        }
        i = i + 1;
    }
    if (sel o.failed.some) { ret err[WriteError].err{o.failed.some}; }
    ret err[WriteError].ok{};
}

fun contains(hay: View, needle: View) bool {
    if (needle.len > hay.len) { ret false; }
    var at: usize = 0;
    for (at + needle.len <= hay.len) {
        var i: usize = 0;
        for (i < needle.len && hay.data[at + i] == needle.data[i]) { i = i + 1; }
        if (i == needle.len) { ret true; }
        at = at + 1;
    }
    ret false;
}

fun rule_row(w: *io.Writer, index: u32, name: str) {
    format.write_str(w, "| ");
    format.write_u64(w, index::u64);
    format.write_str(w, " | `");
    format.write_str(w, name);
    format.write_str(w, "` |");
}

# the committed reference is the one the rows give now, and the specification
# states every rule of the verifier's table under its id
#
# the working directory is the project root, where `mach test` runs the tests.
test reference__committed_is_current {
    var a: allocator.Allocator;
    page.make(?a);
    var got: sink.Sink = sink.init(?a);
    fin { sink.dnit(?got); }
    var w:       io.Writer       = sink.writer(?got);
    val written: err[WriteError] = write(?w);
    if (sel written.err) { ret 1; }

    val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, PATH);
    if (sel file.err) {
        print.eprintln("doc/ir/opcodes.md cannot be read from the project root");
        ret 2;
    }
    var committed: vector.Vector[u8] = file.ok;
    fin { vector.dnit[u8](?committed); }
    val now: View = sink.view(?got);
    if (!slice.same_view(View{data: committed.data, len: committed.len}, now)) {
        filesystem.create_dir_all(?a, "out", 0o755);
        filesystem.write_bytes("out/opcodes.md", now.data, now.len, 0o644);
        print.eprintln("doc/ir/opcodes.md is out of date with the opcode table");
        print.eprintln("regenerate it: cp out/opcodes.md doc/ir/opcodes.md");
        print.eprintln("out/opcodes.md is written only on this mismatch");
        ret 3;
    }

    val spec: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, "doc/ir.md");
    if (sel spec.err) { ret 4; }
    var text: vector.Vector[u8] = spec.ok;
    fin { vector.dnit[u8](?text); }
    var i: usize = 0;
    for (i < rules.rows()) {
        val r: opt[rules.Row] = rules.row(failure.Rule{index: i::u32});
        if (sel r.none) { ret 5; }
        var needle: sink.Sink = sink.init(?a);
        var nw:     io.Writer = sink.writer(?needle);
        rule_row(?nw, i::u32, r.some.name);
        val found: bool = contains(View{data: text.data, len: text.len}, sink.view(?needle));
        sink.dnit(?needle);
        if (!found) {
            print.eprintln("doc/ir.md does not state a rule of the verifier's table by its id");
            print.eprintln(r.some.name);
            ret 6;
        }
        i = i + 1;
    }
    ret 0;
}
