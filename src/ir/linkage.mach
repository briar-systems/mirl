# linkage: how far a function or global is seen, stated by rows of mink's
# symbol model, which owns them

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;

use mink.model.symbol;

# how far a function or global is seen
# ---
# binding:     how far other objects see it, a row of mink's symbol bindings
# visibility:  how far other images see it, a row of mink's symbol visibilities
# export:      a shared image built from it exports it by its symbol name
# replaceable: a definition elsewhere with a body or value of its own may stand
#              for this one at link time, so nothing may be assumed of this
#              one. a weak symbol without it is an instance, every definition
#              of its name equivalent
# merged:      the identity of a merged definition (mink.model.merged), every
#              object needing it holding a copy and the link keeping one: what
#              the definition was made from, so every copy of its name and
#              identity is the same function. none for any other symbol
pub rec Linkage {
    binding:     *symbol.Binding;
    visibility:  *symbol.Visibility;
    export:      bool;
    replaceable: bool;
    merged:      opt[u64];
}

# whether a binding is one of mink's rows
pub fun binding_row(b: *symbol.Binding) bool {
    var i: usize = 0;
    for (i < symbol.binding_count()) {
        if (symbol.binding_at(i) == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a visibility is one of mink's rows
pub fun visibility_row(v: *symbol.Visibility) bool {
    var i: usize = 0;
    for (i < symbol.visibility_count()) {
        if (symbol.visibility_at(i) == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether two linkages state the same rows and the same marks
pub fun same(a: Linkage, b: Linkage) bool {
    ret a.binding == b.binding && a.visibility == b.visibility && a.export == b.export && a.replaceable == b.replaceable && same_identity(a.merged, b.merged);
}

fun same_identity(a: opt[u64], b: opt[u64]) bool {
    if (sel a.some) {
        if (sel b.some) { ret a.some == b.some; }
        ret false;
    }
    ret sel b.none;
}

# other objects may refer to the symbol, so another module may define it
pub fun external(l: Linkage) bool {
    ret symbol.binds(l.binding, symbol.EXTERNAL);
}

# a definition elsewhere may override the symbol's at link time, as only a
# replaceable mark can make use of
pub fun overridable(l: Linkage) bool {
    ret symbol.binds(l.binding, symbol.WEAK);
}

# other images may see the symbol, so a shared image may export it
pub fun exportable(l: Linkage) bool {
    ret external(l) && symbol.shows(l.visibility, symbol.EXPORTED);
}
