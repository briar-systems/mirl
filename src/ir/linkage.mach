# linkage: how far a function or global is seen, stated by rows of mink's
# symbol model, which owns them

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use mink.model.symbol;

# how far a function or global is seen
# ---
# binding:    how far other objects see it, a row of mink's symbol bindings
# visibility: how far other images see it, a row of mink's symbol visibilities
pub rec Linkage {
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
}

# whether a binding is one of mink's rows
pub fun binding_row(b: *symbol.Binding) bool {
    var i: usize = 0;
    for (i < symbol.binding_count()) {
        if (symbol.binding_at(i) == b) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a visibility is one of mink's rows
pub fun visibility_row(v: *symbol.Visibility) bool {
    var i: usize = 0;
    for (i < symbol.visibility_count()) {
        if (symbol.visibility_at(i) == v) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether two linkages state the same rows
pub fun same(a: Linkage, b: Linkage) bool {
    ret a.binding == b.binding && a.visibility == b.visibility;
}

# other objects may refer to the symbol, so another module may define it
pub fun external(l: Linkage) bool {
    ret symbol.binds(l.binding, symbol.EXTERNAL);
}

# whether the symbol may resolve to a definition in another image at load
#
# a local symbol resolves in its object, and a hidden or internal one in its
# image. one of default visibility may be preempted. a protected one the
# module defines stays its own, and one another module defines may be
# defined in another image.
# ---
# l:       the symbol's linkage
# defined: the module defines the symbol
pub fun preemptible(l: Linkage, defined: bool) bool {
    if (!external(l))                                   { ret false; }
    if (symbol.shows(l.visibility, symbol.PREEMPTIBLE)) { ret true; }
    ret !defined && symbol.shows(l.visibility, symbol.EXPORTED);
}
