# the edits of a function body that keep its use lists and edges in step
#
# every edit takes what it may fail on first, so a refusal leaves the body as
# it was. a use list holds an instruction once per operand or argument that
# names the value, and a block's predecessor list holds an instruction once
# per edge into the block.
#
# `builder_make` is the builder's own: every other module makes instructions
# through mirl.build, and places, replaces and erases them here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.function.FunctionData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.ir.value.Output;
use mirl.ir.value.Parameter;
use mirl.ir.value.ValueData;
use mirl.slice;

fun fail[T](e: allocator.Error) res[T, Error] {
    ret res[T, Error].err{Error.alloc{e}};
}

fun refuse(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun has_value(b: *Body, v: Value) bool {
    ret v.index::usize < b.values.len;
}

fun has_block(b: *Body, k: Block) bool {
    ret k.index::usize < b.blocks.len;
}

fun has_instruction(b: *Body, i: Instruction) bool {
    ret i.index::usize < b.instructions.len;
}

# a block of the body that has not been erased
fun live(b: *Body, k: Block) err[Error] {
    if (!has_block(b, k))              { ret err[Error].err{Error.block{k}}; }
    if (b.blocks.data[k.index].erased) { ret err[Error].err{Error.removed{k}}; }
    ret err[Error].ok{};
}

fun known_type(m: *Module, ty: Type) err[Error] {
    val s: res[types.Shape, types.Error] = types.shape(?m.types, ty);
    if (sel s.err) { ret err[Error].err{Error.types{s.err}}; }
    ret err[Error].ok{};
}

fun list[T](v: *vector.Vector[T]) Slice[T] {
    ret Slice[T]{data: v.data, size: v.len};
}

fun remove_at[T](v: *vector.Vector[T], at: usize) {
    var i: usize = at;
    for (i + 1 < v.len) {
        v.data[i] = v.data[i + 1];
        i         = i + 1;
    }
    v.len = v.len - 1;
}

# drop one entry naming an instruction from a list
fun drop_one(v: *vector.Vector[Instruction], i: Instruction) {
    var k: usize = 0;
    for (k < v.len) {
        if (v.data[k].index == i.index) {
            remove_at[Instruction](v, k);
            ret;
        }
        k = k + 1;
    }
}

# the edge of the predecessor entry at position k of a block's list
fun edge_of(b: *Body, target: Block, k: usize) *Edge {
    val preds: *vector.Vector[Instruction] = ?b.blocks.data[target.index].predecessors;
    val inst:  Instruction                 = preds.data[k];
    var seen:  usize                       = 0;
    var j:     usize                       = 0;
    for (j < k) {
        if (preds.data[j].index == inst.index) { seen = seen + 1; }
        j = j + 1;
    }
    val d: *InstructionData = ?b.instructions.data[inst.index];
    var e: usize            = 0;
    for (e < d.edges.len) {
        if (d.edges.data[e].block.index == target.index) {
            if (seen == 0) { ret ?d.edges.data[e]; }
            seen = seen - 1;
        }
        e = e + 1;
    }
    ret nil;
}

# whether a name asked for is none or not empty
fun named(name: opt[View]) bool {
    if (sel name.some) { ret name.some.len > 0; }
    ret true;
}

# a copy of a name the module owns
fun own_name(a: *allocator.Allocator, name: opt[View]) res[opt[View], allocator.Error] {
    if (sel name.none) { ret res[opt[View], allocator.Error].ok{name}; }
    val c: res[View, allocator.Error] = slice.copy_view(a, name.some);
    if (sel c.err) { ret res[opt[View], allocator.Error].err{c.err}; }
    ret res[opt[View], allocator.Error].ok{opt[View].some{c.ok}};
}

# give back a name the module owns
pub fun release_name(a: *allocator.Allocator, name: opt[View]) err[allocator.Error] {
    if (sel name.some) { ret slice.release_view(a, name.some); }
    ret err[allocator.Error].ok{};
}

# give a value the name the text form prints it by, in place of any it had
# ---
# m:    the module
# f:    the function
# v:    the value
# name: the name, which is copied, or none to print it by number
# ret:  ok, or why it was refused
pub fun name_value(m: *Module, f: Function, v: Value, name: opt[View]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret err[Error].err{got.err}; }
    if (!has_value(got.ok, v)) { ret err[Error].err{Error.value{v}}; }
    if (!named(name))          { ret err[Error].err{Error.name{}}; }
    val owned: res[opt[View], allocator.Error] = own_name(m.a, name);
    if (sel owned.err) { ret refuse(owned.err); }
    val d: *ValueData = ?got.ok.values.data[v.index];
    release_name(m.a, d.name);
    d.name = owned.ok;
    ret err[Error].ok{};
}

# give a block the name the text form prints it by, in place of any it had
# ---
# m:    the module
# f:    the function
# k:    the block
# name: the name, which is copied, or none to print it by number
# ret:  ok, or why it was refused
pub fun name_block(m: *Module, f: Function, k: Block, name: opt[View]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val open: err[Error] = live(got.ok, k);
    if (sel open.err) { ret open; }
    if (!named(name)) { ret err[Error].err{Error.name{}}; }
    val owned: res[opt[View], allocator.Error] = own_name(m.a, name);
    if (sel owned.err) { ret refuse(owned.err); }
    val d: *BlockData = ?got.ok.blocks.data[k.index];
    release_name(m.a, d.name);
    d.name = owned.ok;
    ret err[Error].ok{};
}

# make a block
# ---
# m:          the module
# f:          the function whose body takes the block
# parameters: its parameters, in order
# ret:        the block, the entry when it is the body's first, or why it was refused
pub fun block(m: *Module, f: Function, parameters: Slice[Declaration]) res[Block, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Block, Error].err{got.err}; }
    val b: *Body = got.ok;
    var i: usize = 0;
    for (i < parameters.size) {
        val k: err[Error] = known_type(m, parameters.data[i].type);
        if (sel k.err)                       { ret res[Block, Error].err{k.err}; }
        if (!named(parameters.data[i].name)) { ret res[Block, Error].err{Error.name{}}; }
        i = i + 1;
    }

    var d: BlockData;
    d.parameters   = vector.init[Value](m.a);
    d.instructions = vector.init[Instruction](m.a);
    d.predecessors = vector.init[Instruction](m.a);
    val room: res[usize, allocator.Error] = vector.reserve[Value](?d.parameters, parameters.size);
    if (sel room.err) { ret fail[Block](room.err); }
    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, parameters.size);
    if (sel values.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](values.err);
    }
    val blocks: res[usize, allocator.Error] = vector.reserve[BlockData](?b.blocks, 1);
    if (sel blocks.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](blocks.err);
    }
    var names: vector.Vector[opt[View]] = vector.init[opt[View]](m.a);
    fin { vector.dnit[opt[View]](?names); }
    val name_room: res[usize, allocator.Error] = vector.reserve[opt[View]](?names, parameters.size);
    if (sel name_room.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](name_room.err);
    }
    i = 0;
    for (i < parameters.size) {
        val owned: res[opt[View], allocator.Error] = own_name(m.a, parameters.data[i].name);
        if (sel owned.err) {
            var k: usize = 0;
            for (k < names.len) {
                release_name(m.a, names.data[k]);
                k = k + 1;
            }
            vector.dnit[Value](?d.parameters);
            ret fail[Block](owned.err);
        }
        vector.push[opt[View]](?names, owned.ok);
        i = i + 1;
    }

    val id: Block = Block{index: b.blocks.len::u32};
    i = 0;
    for (i < parameters.size) {
        val v: Value = Value{index: b.values.len::u32};
        vector.push[ValueData](?b.values, ValueData{type: parameters.data[i].type, secret: parameters.data[i].secret, def: Def.parameter{Parameter{block: id, index: i::u32}}, uses: vector.init[Instruction](m.a), name: names.data[i]});
        vector.push[Value](?d.parameters, v);
        i = i + 1;
    }
    vector.push[BlockData](?b.blocks, d);
    ret res[Block, Error].ok{id};
}

# what a block is, its lists valid until the body next changes
pub fun block_data(m: *Module, f: Function, k: Block) res[BlockData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret res[BlockData, Error].err{got.err}; }
    if (!has_block(got.ok, k)) { ret res[BlockData, Error].err{Error.block{k}}; }
    ret res[BlockData, Error].ok{got.ok.blocks.data[k.index]};
}

# add a parameter to a block, and its argument to every edge into it
# ---
# m:        the module
# f:        the function
# k:        the block
# declared: the parameter
# incoming: the argument each edge into the block passes, one per entry of
#           its predecessor list and in that order
# ret:      the parameter, or why it was refused
pub fun add_parameter(m: *Module, f: Function, k: Block, declared: Declaration, incoming: Slice[Value]) res[Value, Error] {
    val ty:  Type              = declared.type;
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Value, Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret res[Value, Error].err{open.err}; }
    val known: err[Error] = known_type(m, ty);
    if (sel known.err)         { ret res[Value, Error].err{known.err}; }
    if (!named(declared.name)) { ret res[Value, Error].err{Error.name{}}; }
    val preds: usize = b.blocks.data[k.index].predecessors.len;
    if (incoming.size != preds) { ret res[Value, Error].err{Error.incoming{incoming.size::u32}}; }

    var i: usize = 0;
    for (i < preds) {
        val v: Value = incoming.data[i];
        if (!has_value(b, v))                                  { ret res[Value, Error].err{Error.value{v}}; }
        if (!types.same(b.values.data[v.index].type, ty))      { ret res[Value, Error].err{Error.mismatch{b.values.data[v.index].type}}; }
        if (b.values.data[v.index].secret && !declared.secret) { ret res[Value, Error].err{Error.secret{v}}; }
        i = i + 1;
    }

    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, 1);
    if (sel values.err) { ret fail[Value](values.err); }
    val params: res[usize, allocator.Error] = vector.reserve[Value](?b.blocks.data[k.index].parameters, 1);
    if (sel params.err) { ret fail[Value](params.err); }
    i = 0;
    for (i < preds) {
        val e:    *Edge                       = edge_of(b, k, i);
        val args: res[usize, allocator.Error] = vector.reserve[Value](?e.arguments, 1);
        if (sel args.err) { ret fail[Value](args.err); }
        var same: usize = 0;
        var j:    usize = 0;
        for (j < preds) {
            if (incoming.data[j].index == incoming.data[i].index) { same = same + 1; }
            j = j + 1;
        }
        val uses: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[incoming.data[i].index].uses, same);
        if (sel uses.err) { ret fail[Value](uses.err); }
        i = i + 1;
    }

    val owned: res[opt[View], allocator.Error] = own_name(m.a, declared.name);
    if (sel owned.err) { ret fail[Value](owned.err); }

    val index: u32   = b.blocks.data[k.index].parameters.len::u32;
    val p:     Value = Value{index: b.values.len::u32};
    vector.push[ValueData](?b.values, ValueData{type: ty, secret: declared.secret, def: Def.parameter{Parameter{block: k, index: index}}, uses: vector.init[Instruction](m.a), name: owned.ok});
    vector.push[Value](?b.blocks.data[k.index].parameters, p);
    i = 0;
    for (i < preds) {
        val e: *Edge = edge_of(b, k, i);
        vector.push[Value](?e.arguments, incoming.data[i]);
        vector.push[Instruction](?b.values.data[incoming.data[i].index].uses, b.blocks.data[k.index].predecessors.data[i]);
        i = i + 1;
    }
    ret res[Value, Error].ok{p};
}

# remove an unused parameter from a block, and its argument from every edge into it
# ---
# m:     the module
# f:     the function
# k:     the block
# index: the parameter's position
# ret:   ok, or why it was refused
pub fun remove_parameter(m: *Module, f: Function, k: Block, index: u32) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    val d: *BlockData = ?b.blocks.data[k.index];
    if (index::usize >= d.parameters.len) { ret err[Error].err{Error.parameter{index}}; }
    val p: Value = d.parameters.data[index];
    if (b.values.data[p.index].uses.len != 0) { ret err[Error].err{Error.used{p}}; }

    var i: usize = 0;
    for (i < d.predecessors.len) {
        val e:   *Edge = edge_of(b, k, i);
        val arg: Value = e.arguments.data[index];
        remove_at[Value](?e.arguments, index::usize);
        drop_one(?b.values.data[arg.index].uses, d.predecessors.data[i]);
        i = i + 1;
    }
    remove_at[Value](?d.parameters, index::usize);
    i = index::usize;
    for (i < d.parameters.len) {
        b.values.data[d.parameters.data[i].index].def = Def.parameter{Parameter{block: k, index: i::u32}};
        i                                             = i + 1;
    }
    b.values.data[p.index].def = Def.removed{};
    ret err[Error].ok{};
}

# the value that stands for a constant in a function, the same one each time
# ---
# m:   the module
# f:   the function
# c:   the constant
# ret: its value, or why it was refused
pub fun constant(m: *Module, f: Function, c: Constant) res[Value, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Value, Error].err{got.err}; }
    val b:     *Body       = got.ok;
    val key:   u32         = c.index;
    val found: opt[*Value] = map.get[u32, Value](?b.constants, ?key);
    if (sel found.some) { ret res[Value, Error].ok{@found.some}; }
    val ty: res[Type, Error] = module.constant_type(m, c);
    if (sel ty.err) { ret res[Value, Error].err{ty.err}; }

    val room: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, 1);
    if (sel room.err) { ret fail[Value](room.err); }
    val v:      Value                      = Value{index: b.values.len::u32};
    val linked: res[bool, allocator.Error] = map.insert[u32, Value](?b.constants, key, v);
    if (sel linked.err) { ret fail[Value](linked.err); }
    vector.push[ValueData](?b.values, ValueData{type: ty.ok, secret: false, def: Def.constant{c}, uses: vector.init[Instruction](m.a)});
    ret res[Value, Error].ok{v};
}

# what a value is, its use list valid until the body next changes
pub fun value_data(m: *Module, f: Function, v: Value) res[ValueData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret res[ValueData, Error].err{got.err}; }
    if (!has_value(got.ok, v)) { ret res[ValueData, Error].err{Error.value{v}}; }
    ret res[ValueData, Error].ok{got.ok.values.data[v.index]};
}

# the instructions that use a value, once per use, valid until the body next changes
pub fun uses(m: *Module, f: Function, v: Value) res[Slice[Instruction], Error] {
    val got: res[ValueData, Error] = value_data(m, f, v);
    if (sel got.err) { ret res[Slice[Instruction], Error].err{got.err}; }
    ret res[Slice[Instruction], Error].ok{Slice[Instruction]{data: got.ok.uses.data, size: got.ok.uses.len}};
}

fun occurrences(req: *Request, v: Value) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < req.operands.size) {
        if (req.operands.data[i].index == v.index) { n = n + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val args: Slice[Value] = req.targets.data[i].arguments;
        var j:    usize        = 0;
        for (j < args.size) {
            if (args.data[j].index == v.index) { n = n + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun targeting(req: *Request, k: Block) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < req.targets.size) {
        if (req.targets.data[i].block.index == k.index) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

fun validate(b: *Body, req: *Request) err[Error] {
    var i: usize = 0;
    for (i < req.operands.size) {
        if (!has_value(b, req.operands.data[i])) { ret err[Error].err{Error.value{req.operands.data[i]}}; }
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t:    Branch     = req.targets.data[i];
        val open: err[Error] = live(b, t.block);
        if (sel open.err) { ret open; }
        val params: *vector.Vector[Value] = ?b.blocks.data[t.block.index].parameters;
        var j:      usize                 = 0;
        for (j < t.arguments.size) {
            val v: Value = t.arguments.data[j];
            if (!has_value(b, v)) { ret err[Error].err{Error.value{v}}; }
            if (j < params.len && b.values.data[v.index].secret && !b.values.data[params.data[j].index].secret) {
                ret err[Error].err{Error.secret{v}};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# type a request against its opcode's row, pushing its result types to out
# and giving whether its results are secret
fun typed(m: *Module, f: Function, b: *Body, req: *Request, declared: bool, out: *vector.Vector[Type]) res[bool, Error] {
    val fd: res[FunctionData, Error] = module.function_data(m, f);
    if (sel fd.err) { ret res[bool, Error].err{fd.err}; }
    val sig: res[types.Function, types.Error] = types.signature(?m.types, fd.ok.signature);
    if (sel sig.err) { ret res[bool, Error].err{Error.types{sig.err}}; }

    var total: usize = req.operands.size;
    var i:     usize = 0;
    for (i < req.targets.size) {
        val t: Branch = req.targets.data[i];
        total = total + t.arguments.size + b.blocks.data[t.block.index].parameters.len;
        i     = i + 1;
    }
    var tys:     vector.Vector[Type]        = vector.init[Type](m.a);
    var secrets: vector.Vector[bool]        = vector.init[bool](m.a);
    var edges:   vector.Vector[opcode.Edge] = vector.init[opcode.Edge](m.a);
    fin {
        vector.dnit[Type](?tys);
        vector.dnit[bool](?secrets);
        vector.dnit[opcode.Edge](?edges);
    }
    val room: res[usize, allocator.Error] = vector.reserve[Type](?tys, total);
    if (sel room.err) { ret fail[bool](room.err); }
    val secret_room: res[usize, allocator.Error] = vector.reserve[bool](?secrets, req.operands.size);
    if (sel secret_room.err) { ret fail[bool](secret_room.err); }
    val edge_room: res[usize, allocator.Error] = vector.reserve[opcode.Edge](?edges, req.targets.size);
    if (sel edge_room.err) { ret fail[bool](edge_room.err); }

    i = 0;
    for (i < req.operands.size) {
        val v: *ValueData = ?b.values.data[req.operands.data[i].index];
        vector.push[Type](?tys, v.type);
        vector.push[bool](?secrets, v.secret);
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t:      Branch                = req.targets.data[i];
        val params: *vector.Vector[Value] = ?b.blocks.data[t.block.index].parameters;
        val first:  usize                 = tys.len;
        var j:      usize                 = 0;
        for (j < t.arguments.size) {
            vector.push[Type](?tys, b.values.data[t.arguments.data[j].index].type);
            j = j + 1;
        }
        val second: usize = tys.len;
        j = 0;
        for (j < params.len) {
            vector.push[Type](?tys, b.values.data[params.data[j].index].type);
            j = j + 1;
        }
        vector.push[opcode.Edge](?edges, opcode.Edge{
            arguments:  Slice[Type]{data: ?tys.data[first], size: second - first},
            parameters: Slice[Type]{data: ?tys.data[second], size: tys.len - second},
        });
        i = i + 1;
    }

    var inst: opcode.Instance;
    inst.operands   = Slice[Type]{data: tys.data, size: req.operands.size};
    inst.secret     = list[bool](?secrets);
    inst.declared   = declared;
    inst.immediates = req.immediates;
    inst.edges      = list[opcode.Edge](?edges);
    inst.returns    = sig.ok.results;
    val checked: res[bool, opcode.Error] = opcode.check(?m.types, req.opcode, inst, out);
    if (sel checked.err) { ret res[bool, Error].err{Error.typing{checked.err}}; }
    ret res[bool, Error].ok{checked.ok};
}

fun copy_into[T](v: *vector.Vector[T], s: Slice[T]) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[T](v, s.size);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < s.size) {
        vector.push[T](v, s.data[i]);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun own_immediates(a: *allocator.Allocator, v: *vector.Vector[opcode.Immediate], s: Slice[opcode.Immediate]) err[allocator.Error] {
    val room: res[usize, allocator.Error] = vector.reserve[opcode.Immediate](v, s.size);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < s.size) {
        val kept: res[opcode.Immediate, allocator.Error] = instruction.own(a, s.data[i]);
        if (sel kept.err) { ret err[allocator.Error].err{kept.err}; }
        vector.push[opcode.Immediate](v, kept.ok);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the instruction's own lists, before anything in the body changes
fun prepare(m: *Module, req: *Request, md: Metadata, results: usize, d: *InstructionData) err[allocator.Error] {
    d.opcode     = req.opcode;
    d.place      = Place.detached{};
    d.operands   = vector.init[Value](m.a);
    d.immediates = vector.init[opcode.Immediate](m.a);
    d.edges      = vector.init[Edge](m.a);
    d.results    = vector.init[Value](m.a);
    d.metadata   = md;
    val ops: err[allocator.Error] = copy_into[Value](?d.operands, req.operands);
    if (sel ops.err) { ret ops; }
    val imms: err[allocator.Error] = own_immediates(m.a, ?d.immediates, req.immediates);
    if (sel imms.err) { ret imms; }
    val outs: res[usize, allocator.Error] = vector.reserve[Value](?d.results, results);
    if (sel outs.err) { ret err[allocator.Error].err{outs.err}; }
    val edges: res[usize, allocator.Error] = vector.reserve[Edge](?d.edges, req.targets.size);
    if (sel edges.err) { ret err[allocator.Error].err{edges.err}; }
    var i: usize = 0;
    for (i < req.targets.size) {
        var e: Edge;
        e.block     = req.targets.data[i].block;
        e.arguments = vector.init[Value](m.a);
        val args: err[allocator.Error] = copy_into[Value](?e.arguments, req.targets.data[i].arguments);
        if (sel args.err) {
            vector.dnit[Value](?e.arguments);
            ret args;
        }
        vector.push[Edge](?d.edges, e);
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# room in every list the instruction joins
fun make_room(b: *Body, req: *Request, results: usize) err[allocator.Error] {
    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, results);
    if (sel values.err) { ret err[allocator.Error].err{values.err}; }
    val insts: res[usize, allocator.Error] = vector.reserve[InstructionData](?b.instructions, 1);
    if (sel insts.err) { ret err[allocator.Error].err{insts.err}; }
    var i: usize = 0;
    for (i < req.operands.size) {
        val v:    Value                       = req.operands.data[i];
        val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[v.index].uses, occurrences(req, v));
        if (sel room.err) { ret err[allocator.Error].err{room.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t:     Branch                      = req.targets.data[i];
        val preds: res[usize, allocator.Error] = vector.reserve[Instruction](?b.blocks.data[t.block.index].predecessors, targeting(req, t.block));
        if (sel preds.err) { ret err[allocator.Error].err{preds.err}; }
        var j: usize = 0;
        for (j < t.arguments.size) {
            val v:    Value                       = t.arguments.data[j];
            val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[v.index].uses, occurrences(req, v));
            if (sel room.err) { ret err[allocator.Error].err{room.err}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# make an instruction, typed by its opcode's row and placed in no block, for
# mirl.build alone
#
# its operands and arguments are used from now on, and each of its edges is
# an entry in its target's predecessor list.
# ---
# m:   the module
# f:   the function whose body takes it
# req: what it is made from, whose lists are copied
# md:  its metadata record
# ret: the instruction, or why it was refused
pub fun builder_make(m: *Module, f: Function, req: Request, md: Metadata) res[Instruction, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Instruction, Error].err{got.err}; }
    val b:     *Body      = got.ok;
    val valid: err[Error] = validate(b, ?req);
    if (sel valid.err) { ret res[Instruction, Error].err{valid.err}; }

    var out: vector.Vector[Type] = vector.init[Type](m.a);
    fin { vector.dnit[Type](?out); }
    val checked: res[bool, Error] = typed(m, f, b, ?req, md.secret, ?out);
    if (sel checked.err) { ret res[Instruction, Error].err{checked.err}; }

    var d:        InstructionData;
    val prepared: err[allocator.Error] = prepare(m, ?req, md, out.len, ?d);
    if (sel prepared.err) {
        instruction.release(?d);
        ret fail[Instruction](prepared.err);
    }
    val room: err[allocator.Error] = make_room(b, ?req, out.len);
    if (sel room.err) {
        instruction.release(?d);
        ret fail[Instruction](room.err);
    }

    val id: Instruction = Instruction{index: b.instructions.len::u32};
    var i:  usize       = 0;
    for (i < out.len) {
        vector.push[Value](?d.results, Value{index: b.values.len::u32});
        vector.push[ValueData](?b.values, ValueData{type: out.data[i], secret: checked.ok, def: Def.result{Output{instruction: id, index: i::u32}}, uses: vector.init[Instruction](m.a)});
        i = i + 1;
    }
    i = 0;
    for (i < req.operands.size) {
        vector.push[Instruction](?b.values.data[req.operands.data[i].index].uses, id);
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t: Branch = req.targets.data[i];
        vector.push[Instruction](?b.blocks.data[t.block.index].predecessors, id);
        var j: usize = 0;
        for (j < t.arguments.size) {
            vector.push[Instruction](?b.values.data[t.arguments.data[j].index].uses, id);
            j = j + 1;
        }
        i = i + 1;
    }
    vector.push[InstructionData](?b.instructions, d);
    ret res[Instruction, Error].ok{id};
}

# what an instruction is, its lists valid until the body next changes
pub fun instruction_data(m: *Module, f: Function, i: Instruction) res[InstructionData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)                 { ret res[InstructionData, Error].err{got.err}; }
    if (!has_instruction(got.ok, i)) { ret res[InstructionData, Error].err{Error.instruction{i}}; }
    ret res[InstructionData, Error].ok{got.ok.instructions.data[i.index]};
}

# replace an instruction's metadata record whole
#
# the secrecy mark may be raised and never lowered, so the secrecy of a
# declared row's results cannot drift from it.
pub fun set_metadata(m: *Module, f: Function, i: Instruction, md: Metadata) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)                                                     { ret err[Error].err{got.err}; }
    if (!has_instruction(got.ok, i))                                     { ret err[Error].err{Error.instruction{i}}; }
    if (got.ok.instructions.data[i.index].metadata.secret && !md.secret) { ret err[Error].err{Error.lowered{i}}; }
    got.ok.instructions.data[i.index].metadata = md;
    ret err[Error].ok{};
}

fun detached(b: *Body, i: Instruction) err[Error] {
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val at: Place = b.instructions.data[i.index].place;
    if (sel at.placed) { ret err[Error].err{Error.placed{i}}; }
    if (sel at.erased) { ret err[Error].err{Error.erased{i}}; }
    ret err[Error].ok{};
}

fun placed(b: *Body, i: Instruction) res[Block, Error] {
    if (!has_instruction(b, i)) { ret res[Block, Error].err{Error.instruction{i}}; }
    val at: Place = b.instructions.data[i.index].place;
    if (sel at.erased) { ret res[Block, Error].err{Error.erased{i}}; }
    if (sel at.placed) { ret res[Block, Error].ok{at.placed}; }
    ret res[Block, Error].err{Error.detached{i}};
}

# the position of a placed instruction in its block's list
fun slot(b: *Body, k: Block, i: Instruction) usize {
    val list_of: *vector.Vector[Instruction] = ?b.blocks.data[k.index].instructions;
    var p:       usize                       = 0;
    for (p < list_of.len && list_of.data[p].index != i.index) { p = p + 1; }
    ret p;
}

# place a detached instruction at the end of a block
pub fun append(m: *Module, f: Function, k: Block, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    val free: err[Error] = detached(b, i);
    if (sel free.err) { ret free; }
    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?b.blocks.data[k.index].instructions, i);
    if (sel pushed.err) { ret refuse(pushed.err); }
    b.instructions.data[i.index].place = Place.placed{k};
    ret err[Error].ok{};
}

# place a detached instruction just before a placed one
pub fun insert(m: *Module, f: Function, before: Instruction, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, before);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val free: err[Error] = detached(b, i);
    if (sel free.err) { ret free; }
    val list_of: *vector.Vector[Instruction] = ?b.blocks.data[at.ok.index].instructions;
    val room:    res[usize, allocator.Error] = vector.reserve[Instruction](list_of, 1);
    if (sel room.err) { ret refuse(room.err); }
    val p: usize = slot(b, at.ok, before);
    var k: usize = list_of.len;
    for (k > p) {
        list_of.data[k] = list_of.data[k - 1];
        k               = k - 1;
    }
    list_of.data[p]                    = i;
    list_of.len                        = list_of.len + 1;
    b.instructions.data[i.index].place = Place.placed{at.ok};
    ret err[Error].ok{};
}

# replace every use of a value by another value of the same type
# ---
# m:   the module
# f:   the function
# old: the value replaced
# new: the value that takes its uses
# ret: ok, or why it was refused
pub fun replace(m: *Module, f: Function, old: Value, new: Value) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_value(b, old)) { ret err[Error].err{Error.value{old}}; }
    if (!has_value(b, new)) { ret err[Error].err{Error.value{new}}; }
    if (!types.same(b.values.data[old.index].type, b.values.data[new.index].type)) {
        ret err[Error].err{Error.mismatch{b.values.data[new.index].type}};
    }
    if (old.index == new.index)                                              { ret err[Error].ok{}; }
    if (b.values.data[new.index].secret && !b.values.data[old.index].secret) { ret err[Error].err{Error.secret{new}}; }
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[new.index].uses, b.values.data[old.index].uses.len);
    if (sel room.err) { ret refuse(room.err); }
    move_uses(b, old, new);
    ret err[Error].ok{};
}

# move one instruction's uses of a value, as operands and as arguments, to
# another value
# ---
# m:   the module
# f:   the function
# i:   the instruction, which uses old
# old: the value it stops using
# new: the value it uses in old's place, of old's type and no more secret
# ret: ok, or why it was refused
pub fun substitute(m: *Module, f: Function, i: Instruction, old: Value, new: Value) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    if (!has_value(b, old))     { ret err[Error].err{Error.value{old}}; }
    if (!has_value(b, new))     { ret err[Error].err{Error.value{new}}; }
    if (!types.same(b.values.data[old.index].type, b.values.data[new.index].type)) {
        ret err[Error].err{Error.mismatch{b.values.data[new.index].type}};
    }
    if (old.index == new.index)                                              { ret err[Error].ok{}; }
    if (b.values.data[new.index].secret && !b.values.data[old.index].secret) { ret err[Error].err{Error.secret{new}}; }
    val d:    *InstructionData = ?b.instructions.data[i.index];
    var many: usize            = 0;
    var k:    usize            = 0;
    for (k < d.operands.len) {
        if (d.operands.data[k].index == old.index) { many = many + 1; }
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val args: *vector.Vector[Value] = ?d.edges.data[e].arguments;
        k = 0;
        for (k < args.len) {
            if (args.data[k].index == old.index) { many = many + 1; }
            k = k + 1;
        }
        e = e + 1;
    }
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[new.index].uses, many);
    if (sel room.err) { ret refuse(room.err); }
    k = 0;
    for (k < d.operands.len) {
        if (d.operands.data[k].index == old.index) {
            d.operands.data[k] = new;
            drop_one(?b.values.data[old.index].uses, i);
            vector.push[Instruction](?b.values.data[new.index].uses, i);
        }
        k = k + 1;
    }
    e = 0;
    for (e < d.edges.len) {
        val args: *vector.Vector[Value] = ?d.edges.data[e].arguments;
        k = 0;
        for (k < args.len) {
            if (args.data[k].index == old.index) {
                args.data[k] = new;
                drop_one(?b.values.data[old.index].uses, i);
                vector.push[Instruction](?b.values.data[new.index].uses, i);
            }
            k = k + 1;
        }
        e = e + 1;
    }
    ret err[Error].ok{};
}

# move every use of old to new, whose use list has room for them
fun move_uses(b: *Body, old: Value, new: Value) {
    val count: usize = b.values.data[old.index].uses.len;
    var k:     usize = 0;
    for (k < count) {
        val user: Instruction      = b.values.data[old.index].uses.data[k];
        val d:    *InstructionData = ?b.instructions.data[user.index];
        var done: bool             = false;
        var i:    usize            = 0;
        for (!done && i < d.operands.len) {
            if (d.operands.data[i].index == old.index) {
                d.operands.data[i] = new;
                done               = true;
            }
            i = i + 1;
        }
        var e: usize = 0;
        for (!done && e < d.edges.len) {
            val args: *vector.Vector[Value] = ?d.edges.data[e].arguments;
            var j:    usize                 = 0;
            for (!done && j < args.len) {
                if (args.data[j].index == old.index) {
                    args.data[j] = new;
                    done         = true;
                }
                j = j + 1;
            }
            e = e + 1;
        }
        vector.push[Instruction](?b.values.data[new.index].uses, user);
        k = k + 1;
    }
    b.values.data[old.index].uses.len = 0;
}

fun is_result(d: *InstructionData, v: Value) bool {
    var k: usize = 0;
    for (k < d.results.len) {
        if (d.results.data[k].index == v.index) { ret true; }
        k = k + 1;
    }
    ret false;
}

# an instruction that uses one of the results of another
fun uses_result(user: *InstructionData, of: *InstructionData) opt[Value] {
    var i: usize = 0;
    for (i < user.operands.len) {
        if (is_result(of, user.operands.data[i])) { ret opt[Value].some{user.operands.data[i]}; }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < user.edges.len) {
        val args: *vector.Vector[Value] = ?user.edges.data[e].arguments;
        var j:    usize                 = 0;
        for (j < args.len) {
            if (is_result(of, args.data[j])) { ret opt[Value].some{args.data[j]}; }
            j = j + 1;
        }
        e = e + 1;
    }
    ret opt[Value].none{};
}

# take an instruction whose results are unused out of the body
fun take_out(b: *Body, i: Instruction) {
    val d:  *InstructionData = ?b.instructions.data[i.index];
    val at: Place            = d.place;
    if (sel at.placed) { remove_at[Instruction](?b.blocks.data[at.placed.index].instructions, slot(b, at.placed, i)); }
    var k: usize = 0;
    for (k < d.operands.len) {
        drop_one(?b.values.data[d.operands.data[k].index].uses, i);
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        drop_one(?b.blocks.data[edge.block.index].predecessors, i);
        var j: usize = 0;
        for (j < edge.arguments.len) {
            drop_one(?b.values.data[edge.arguments.data[j].index].uses, i);
            j = j + 1;
        }
        e = e + 1;
    }
    k = 0;
    for (k < d.results.len) {
        b.values.data[d.results.data[k].index].def = Def.removed{};
        k                                          = k + 1;
    }
    d.place = Place.erased{};
}

# take an instruction out of its body: out of its block, the use list of
# every value it uses and the predecessor list of every block it branches to
#
# its record stays, erased, so the ids given out stay valid.
# ---
# m:   the module
# f:   the function
# i:   the instruction, whose results must have no uses
# ret: ok, or why it was refused
pub fun erase(m: *Module, f: Function, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val d: *InstructionData = ?b.instructions.data[i.index];
    if (sel d.place.erased) { ret err[Error].err{Error.erased{i}}; }
    var k: usize = 0;
    for (k < d.results.len) {
        val r: Value = d.results.data[k];
        if (b.values.data[r.index].uses.len != 0) { ret err[Error].err{Error.used{r}}; }
        k = k + 1;
    }
    take_out(b, i);
    ret err[Error].ok{};
}

# put a detached instruction in a placed one's slot, move every use of each
# of the placed one's results to the result at the same position, and erase
# the placed one
# ---
# m:   the module
# f:   the function
# old: the placed instruction
# new: the detached one, its results as many and of the same types
# ret: ok, or why it was refused
pub fun supplant(m: *Module, f: Function, old: Instruction, new: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, old);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val free: err[Error] = detached(b, new);
    if (sel free.err) { ret free; }
    val od: *InstructionData = ?b.instructions.data[old.index];
    val nd: *InstructionData = ?b.instructions.data[new.index];
    if (od.results.len != nd.results.len) { ret err[Error].err{Error.results{nd.results.len::u32}}; }
    var k: usize = 0;
    for (k < od.results.len) {
        val ov: *ValueData = ?b.values.data[od.results.data[k].index];
        val nv: *ValueData = ?b.values.data[nd.results.data[k].index];
        if (!types.same(ov.type, nv.type)) { ret err[Error].err{Error.mismatch{nv.type}}; }
        if (nv.secret && !ov.secret)       { ret err[Error].err{Error.secret{nd.results.data[k]}}; }
        k = k + 1;
    }
    val loop: opt[Value] = uses_result(nd, od);
    if (sel loop.some) { ret err[Error].err{Error.circular{loop.some}}; }
    k = 0;
    for (k < od.results.len) {
        val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[nd.results.data[k].index].uses, b.values.data[od.results.data[k].index].uses.len);
        if (sel room.err) { ret refuse(room.err); }
        k = k + 1;
    }

    k = 0;
    for (k < od.results.len) {
        move_uses(b, od.results.data[k], nd.results.data[k]);
        k = k + 1;
    }
    b.blocks.data[at.ok.index].instructions.data[slot(b, at.ok, old)] = new;
    nd.place                                                          = od.place;
    od.place                                                          = Place.detached{};
    take_out(b, old);
    ret err[Error].ok{};
}

# drop the occurrence at position rank among a list's entries naming an instruction
fun drop_nth(v: *vector.Vector[Instruction], i: Instruction, rank: usize) {
    var seen: usize = 0;
    var k:    usize = 0;
    for (k < v.len) {
        if (v.data[k].index == i.index) {
            if (seen == rank) {
                remove_at[Instruction](v, k);
                ret;
            }
            seen = seen + 1;
        }
        k = k + 1;
    }
}

# move an edge of an instruction to another block, passing new arguments
# ---
# m:         the module
# f:         the function
# i:         the instruction
# edge:      the edge's position among the instruction's edges
# to:        the block the edge enters from now on
# arguments: one value per parameter of to, in order
# ret:       ok, or why it was refused
pub fun retarget(m: *Module, f: Function, i: Instruction, edge: u32, to: Block, arguments: Slice[Value]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val d: *InstructionData = ?b.instructions.data[i.index];
    if (sel d.place.erased)         { ret err[Error].err{Error.erased{i}}; }
    if (edge::usize >= d.edges.len) { ret err[Error].err{Error.edge{edge}}; }
    val open: err[Error] = live(b, to);
    if (sel open.err) { ret open; }
    val params: *vector.Vector[Value] = ?b.blocks.data[to.index].parameters;
    if (arguments.size != params.len) { ret err[Error].err{Error.arguments{arguments.size::u32}}; }
    var j: usize = 0;
    for (j < arguments.size) {
        val v: Value = arguments.data[j];
        if (!has_value(b, v)) { ret err[Error].err{Error.value{v}}; }
        val p: *ValueData = ?b.values.data[params.data[j].index];
        if (!types.same(b.values.data[v.index].type, p.type)) { ret err[Error].err{Error.mismatch{b.values.data[v.index].type}}; }
        if (b.values.data[v.index].secret && !p.secret)       { ret err[Error].err{Error.secret{v}}; }
        j = j + 1;
    }

    val e:    *Edge                       = ?d.edges.data[edge];
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.blocks.data[to.index].predecessors, 1);
    if (sel room.err) { ret refuse(room.err); }
    val args: res[usize, allocator.Error] = vector.reserve[Value](?e.arguments, arguments.size);
    if (sel args.err) { ret refuse(args.err); }
    j = 0;
    for (j < arguments.size) {
        var same: usize = 0;
        var k:    usize = 0;
        for (k < arguments.size) {
            if (arguments.data[k].index == arguments.data[j].index) { same = same + 1; }
            k = k + 1;
        }
        val uses: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[arguments.data[j].index].uses, same);
        if (sel uses.err) { ret refuse(uses.err); }
        j = j + 1;
    }

    val old:  Block = e.block;
    var rank: usize = 0;
    var k:    usize = 0;
    for (k < edge::usize) {
        if (d.edges.data[k].block.index == old.index) { rank = rank + 1; }
        k = k + 1;
    }
    drop_nth(?b.blocks.data[old.index].predecessors, i, rank);
    j = 0;
    for (j < e.arguments.len) {
        drop_one(?b.values.data[e.arguments.data[j].index].uses, i);
        j = j + 1;
    }
    e.arguments.len = 0;
    j               = 0;
    for (j < arguments.size) {
        vector.push[Value](?e.arguments, arguments.data[j]);
        vector.push[Instruction](?b.values.data[arguments.data[j].index].uses, i);
        j = j + 1;
    }
    e.block = to;
    vector.push[Instruction](?b.blocks.data[to.index].predecessors, i);
    ret err[Error].ok{};
}

# move the instructions of a block from a position on to the end of another
# ---
# m:    the module
# f:    the function
# from: the block they leave
# at:   the position of the first instruction moved
# to:   the block they join, in order
# ret:  ok, or why it was refused
pub fun move(m: *Module, f: Function, from: Block, at: u32, to: Block) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:      *Body      = got.ok;
    val source: err[Error] = live(b, from);
    if (sel source.err) { ret source; }
    val target: err[Error] = live(b, to);
    if (sel target.err)         { ret target; }
    if (from.index == to.index) { ret err[Error].err{Error.same{from}}; }
    val src: *vector.Vector[Instruction] = ?b.blocks.data[from.index].instructions;
    if (at::usize > src.len) { ret err[Error].err{Error.position{at}}; }
    val dst:  *vector.Vector[Instruction] = ?b.blocks.data[to.index].instructions;
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](dst, src.len - at::usize);
    if (sel room.err) { ret refuse(room.err); }
    var k: usize = at::usize;
    for (k < src.len) {
        vector.push[Instruction](dst, src.data[k]);
        b.instructions.data[src.data[k].index].place = Place.placed{to};
        k                                            = k + 1;
    }
    src.len = at::usize;
    ret err[Error].ok{};
}

# take a block out of its body, its parameters with it
#
# its record stays, erased, so the ids given out stay valid.
# ---
# m:   the module
# f:   the function
# k:   the block, entered by no edge, holding no instruction and with no
#      parameter in use
# ret: ok, or why it was refused
pub fun erase_block(m: *Module, f: Function, k: Block) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    if (k.index == 0) { ret err[Error].err{Error.entry{}}; }
    val d: *BlockData = ?b.blocks.data[k.index];
    if (d.predecessors.len != 0) { ret err[Error].err{Error.reached{k}}; }
    if (d.instructions.len != 0) { ret err[Error].err{Error.occupied{k}}; }
    var i: usize = 0;
    for (i < d.parameters.len) {
        val p: Value = d.parameters.data[i];
        if (b.values.data[p.index].uses.len != 0) { ret err[Error].err{Error.used{p}}; }
        i = i + 1;
    }
    i = 0;
    for (i < d.parameters.len) {
        b.values.data[d.parameters.data[i].index].def = Def.removed{};
        i                                             = i + 1;
    }
    d.erased = true;
    ret err[Error].ok{};
}

# put the block one branch alone enters in that branch's place: every use of
# its parameters moves to the argument the edge passes, the branch is erased,
# the block's instructions take its slot, and the block is erased
# ---
# m:    the module
# f:    the function
# jump: a placed instruction of one edge and no used result, the only edge
#       into a block other than its own and the entry
# ret:  ok, or why it was refused, the body left as it was
pub fun splice(m: *Module, f: Function, jump: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, jump);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val into: Block            = at.ok;
    val d:    *InstructionData = ?b.instructions.data[jump.index];
    if (d.edges.len != 1) { ret err[Error].err{Error.edge{d.edges.len::u32}}; }
    val k:    Block      = d.edges.data[0].block;
    val open: err[Error] = live(b, k);
    if (sel open.err)                                 { ret open; }
    if (k.index == 0)                                 { ret err[Error].err{Error.entry{}}; }
    if (k.index == into.index)                        { ret err[Error].err{Error.same{k}}; }
    if (b.blocks.data[k.index].predecessors.len != 1) { ret err[Error].err{Error.reached{k}}; }
    var i: usize = 0;
    for (i < d.results.len) {
        if (b.values.data[d.results.data[i].index].uses.len != 0) { ret err[Error].err{Error.used{d.results.data[i]}}; }
        i = i + 1;
    }
    val params: *vector.Vector[Value] = ?b.blocks.data[k.index].parameters;
    val args:   *vector.Vector[Value] = ?d.edges.data[0].arguments;
    i = 0;
    for (i < args.len) {
        var j: usize = 0;
        for (j < params.len) {
            if (args.data[i].index == params.data[j].index) { ret err[Error].err{Error.circular{args.data[i]}}; }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    for (i < args.len) {
        var moving: usize = 0;
        var j:      usize = 0;
        for (j < args.len) {
            if (args.data[j].index == args.data[i].index) { moving = moving + b.values.data[params.data[j].index].uses.len; }
            j = j + 1;
        }
        val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.values.data[args.data[i].index].uses, moving);
        if (sel room.err) { ret refuse(room.err); }
        i = i + 1;
    }
    val tail: *vector.Vector[Instruction] = ?b.blocks.data[k.index].instructions;
    val list: *vector.Vector[Instruction] = ?b.blocks.data[into.index].instructions;
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](list, tail.len);
    if (sel room.err) { ret refuse(room.err); }

    i = 0;
    for (i < params.len) {
        move_uses(b, params.data[i], args.data[i]);
        i = i + 1;
    }
    val p: usize = slot(b, into, jump);
    take_out(b, jump);
    var n: usize = list.len;
    for (n > p) {
        n                       = n - 1;
        list.data[n + tail.len] = list.data[n];
    }
    i = 0;
    for (i < tail.len) {
        list.data[p + i]                              = tail.data[i];
        b.instructions.data[tail.data[i].index].place = Place.placed{into};
        i                                             = i + 1;
    }
    list.len = list.len + tail.len;
    tail.len = 0;
    i        = 0;
    for (i < params.len) {
        b.values.data[params.data[i].index].def = Def.removed{};
        i                                       = i + 1;
    }
    b.blocks.data[k.index].erased = true;
    ret err[Error].ok{};
}

# how far a body's lists reach, so a refused edit can be taken back to it
# ---
# blocks:       its number of blocks
# values:       its number of values
# instructions: its number of instructions
pub rec Mark {
    blocks:       u32;
    values:       u32;
    instructions: u32;
}

# where a body's lists end now
pub fun mark(m: *Module, f: Function) res[Mark, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Mark, Error].err{got.err}; }
    ret res[Mark, Error].ok{Mark{blocks: got.ok.blocks.len::u32, values: got.ok.values.len::u32, instructions: got.ok.instructions.len::u32}};
}

# take back every block, value and instruction made since a mark, leaving the
# body as it was at the mark
#
# what was made since may be used, entered and listed only by what was made
# since, so what came before is left exactly as it was. it never allocates.
# ---
# m:   the module
# f:   the function
# at:  a mark of the body
# ret: ok, or why it was refused with the body left as it was, or the first
#      release the allocator refused once everything was taken back
pub fun rewind(m: *Module, f: Function, at: Mark) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (at.blocks::usize > b.blocks.len)             { ret err[Error].err{Error.block{Block{index: at.blocks}}}; }
    if (at.values::usize > b.values.len)             { ret err[Error].err{Error.value{Value{index: at.values}}}; }
    if (at.instructions::usize > b.instructions.len) { ret err[Error].err{Error.instruction{Instruction{index: at.instructions}}}; }
    var i: usize = at.values::usize;
    for (i < b.values.len) {
        val v: *ValueData = ?b.values.data[i];
        var u: usize      = 0;
        for (u < v.uses.len) {
            if (v.uses.data[u].index < at.instructions) { ret err[Error].err{Error.used{Value{index: i::u32}}}; }
            u = u + 1;
        }
        if (sel v.def.parameter) {
            if (v.def.parameter.block.index < at.blocks) { ret err[Error].err{Error.parameter{v.def.parameter.index}}; }
        }
        i = i + 1;
    }
    i = at.blocks::usize;
    for (i < b.blocks.len) {
        val k: *BlockData = ?b.blocks.data[i];
        var u: usize      = 0;
        for (u < k.predecessors.len) {
            if (k.predecessors.data[u].index < at.instructions) { ret err[Error].err{Error.reached{Block{index: i::u32}}}; }
            u = u + 1;
        }
        u = 0;
        for (u < k.instructions.len) {
            if (k.instructions.data[u].index < at.instructions) { ret err[Error].err{Error.occupied{Block{index: i::u32}}}; }
            u = u + 1;
        }
        i = i + 1;
    }

    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    i = b.instructions.len;
    for (i > at.instructions::usize) {
        i = i - 1;
        if (!(sel b.instructions.data[i].place.erased)) { take_out(b, Instruction{index: i::u32}); }
        keep(?failed, instruction.release(?b.instructions.data[i]));
    }
    b.instructions.len = at.instructions::usize;
    i                  = at.values::usize;
    for (i < b.values.len) {
        val def: Def = b.values.data[i].def;
        if (sel def.constant) {
            val key: u32 = def.constant.index;
            map.remove[u32, Value](?b.constants, ?key);
        }
        keep(?failed, vector.dnit[Instruction](?b.values.data[i].uses));
        i = i + 1;
    }
    b.values.len = at.values::usize;
    i            = at.blocks::usize;
    for (i < b.blocks.len) {
        keep(?failed, vector.dnit[Value](?b.blocks.data[i].parameters));
        keep(?failed, vector.dnit[Instruction](?b.blocks.data[i].instructions));
        keep(?failed, vector.dnit[Instruction](?b.blocks.data[i].predecessors));
        i = i + 1;
    }
    b.blocks.len = at.blocks::usize;
    if (sel failed.err) { ret refuse(failed.err); }
    ret err[Error].ok{};
}

fun dup[T](a: *allocator.Allocator, v: *vector.Vector[T]) res[vector.Vector[T], allocator.Error] {
    var out: vector.Vector[T] = vector.init[T](a);
    if (v.len == 0) { ret res[vector.Vector[T], allocator.Error].ok{out}; }
    val room: res[usize, allocator.Error] = vector.reserve[T](?out, v.len);
    if (sel room.err) { ret res[vector.Vector[T], allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < v.len) {
        out.data[i] = v.data[i];
        i           = i + 1;
    }
    out.len = v.len;
    ret res[vector.Vector[T], allocator.Error].ok{out};
}

# a list of n zeroed entries, each owning nothing
fun zeroed[T](a: *allocator.Allocator, n: usize) res[vector.Vector[T], allocator.Error] {
    var out: vector.Vector[T] = vector.init[T](a);
    if (n == 0) { ret res[vector.Vector[T], allocator.Error].ok{out}; }
    val room: res[usize, allocator.Error] = vector.reserve[T](?out, n);
    if (sel room.err) { ret res[vector.Vector[T], allocator.Error].err{room.err}; }
    var none: T;
    var i:    usize = 0;
    for (i < n) {
        out.data[i] = none;
        i           = i + 1;
    }
    out.len = n;
    ret res[vector.Vector[T], allocator.Error].ok{out};
}

fun copy_block(a: *allocator.Allocator, from: *BlockData, to: *BlockData) err[allocator.Error] {
    to.erased = from.erased;
    val name: res[opt[View], allocator.Error] = own_name(a, from.name);
    if (sel name.err) { ret err[allocator.Error].err{name.err}; }
    to.name = name.ok;
    val params: res[vector.Vector[Value], allocator.Error] = dup[Value](a, ?from.parameters);
    if (sel params.err) { ret err[allocator.Error].err{params.err}; }
    to.parameters = params.ok;
    val placed: res[vector.Vector[Instruction], allocator.Error] = dup[Instruction](a, ?from.instructions);
    if (sel placed.err) { ret err[allocator.Error].err{placed.err}; }
    to.instructions = placed.ok;
    val preds: res[vector.Vector[Instruction], allocator.Error] = dup[Instruction](a, ?from.predecessors);
    if (sel preds.err) { ret err[allocator.Error].err{preds.err}; }
    to.predecessors = preds.ok;
    ret err[allocator.Error].ok{};
}

fun copy_value(a: *allocator.Allocator, from: *ValueData, to: *ValueData) err[allocator.Error] {
    to.type   = from.type;
    to.secret = from.secret;
    to.def    = from.def;
    val name: res[opt[View], allocator.Error] = own_name(a, from.name);
    if (sel name.err) { ret err[allocator.Error].err{name.err}; }
    to.name = name.ok;
    val uses: res[vector.Vector[Instruction], allocator.Error] = dup[Instruction](a, ?from.uses);
    if (sel uses.err) { ret err[allocator.Error].err{uses.err}; }
    to.uses = uses.ok;
    ret err[allocator.Error].ok{};
}

fun copy_instruction(a: *allocator.Allocator, from: *InstructionData, to: *InstructionData) err[allocator.Error] {
    to.opcode     = from.opcode;
    to.place      = from.place;
    to.metadata   = from.metadata;
    to.immediates = vector.init[opcode.Immediate](a);
    to.edges      = vector.init[Edge](a);
    val operands: res[vector.Vector[Value], allocator.Error] = dup[Value](a, ?from.operands);
    if (sel operands.err) { ret err[allocator.Error].err{operands.err}; }
    to.operands = operands.ok;
    val results: res[vector.Vector[Value], allocator.Error] = dup[Value](a, ?from.results);
    if (sel results.err) { ret err[allocator.Error].err{results.err}; }
    to.results = results.ok;
    val owned: err[allocator.Error] = own_immediates(a, ?to.immediates, Slice[opcode.Immediate]{data: from.immediates.data, size: from.immediates.len});
    if (sel owned.err) { ret owned; }
    val room: res[usize, allocator.Error] = vector.reserve[Edge](?to.edges, from.edges.len);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    var i: usize = 0;
    for (i < from.edges.len) {
        val args: res[vector.Vector[Value], allocator.Error] = dup[Value](a, ?from.edges.data[i].arguments);
        if (sel args.err) { ret err[allocator.Error].err{args.err}; }
        to.edges.data[i] = Edge{block: from.edges.data[i].block, arguments: args.ok};
        to.edges.len     = i + 1;
        i                = i + 1;
    }
    ret err[allocator.Error].ok{};
}

fun copy_lists(a: *allocator.Allocator, from: *Body, to: *Body) err[allocator.Error] {
    val blocks: res[vector.Vector[BlockData], allocator.Error] = zeroed[BlockData](a, from.blocks.len);
    if (sel blocks.err) { ret err[allocator.Error].err{blocks.err}; }
    to.blocks = blocks.ok;
    val values: res[vector.Vector[ValueData], allocator.Error] = zeroed[ValueData](a, from.values.len);
    if (sel values.err) { ret err[allocator.Error].err{values.err}; }
    to.values = values.ok;
    val made: res[vector.Vector[InstructionData], allocator.Error] = zeroed[InstructionData](a, from.instructions.len);
    if (sel made.err) { ret err[allocator.Error].err{made.err}; }
    to.instructions = made.ok;
    val constants: res[map.Map[u32, Value], allocator.Error] = map.clone[u32, Value](?from.constants, a);
    if (sel constants.err) { ret err[allocator.Error].err{constants.err}; }
    to.constants = constants.ok;
    var i: usize = 0;
    for (i < from.blocks.len) {
        val r: err[allocator.Error] = copy_block(a, ?from.blocks.data[i], ?to.blocks.data[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    i = 0;
    for (i < from.values.len) {
        val r: err[allocator.Error] = copy_value(a, ?from.values.data[i], ?to.values.data[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    i = 0;
    for (i < from.instructions.len) {
        val r: err[allocator.Error] = copy_instruction(a, ?from.instructions.data[i], ?to.instructions.data[i]);
        if (sel r.err) { ret r; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# a copy of a function's body that shares nothing with it, every id the same,
# for `restore` to put back after an edit that has to be taken back whole
#
# unlike a mark, a snapshot takes back edits to what the body already held.
# ---
# m:   the module
# f:   the function
# ret: the copy, which the caller restores or discards, or why it was refused
pub fun snapshot(m: *Module, f: Function) res[Body, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Body, Error].err{got.err}; }
    var s: Body;
    s.blocks       = vector.init[BlockData](m.a);
    s.values       = vector.init[ValueData](m.a);
    s.instructions = vector.init[InstructionData](m.a);
    s.constants    = map.init[u32, Value](m.a);
    val copied: err[allocator.Error] = copy_lists(m.a, got.ok, ?s);
    if (sel copied.err) {
        module.release_body(m.a, ?s);
        ret fail[Body](copied.err);
    }
    ret res[Body, Error].ok{s};
}

# put a snapshot back as a function's body, giving back the body it replaces
#
# the snapshot is the function's own from then on, and is put back even when
# the release of the replaced body is refused.
# ---
# m:   the module
# f:   the function the snapshot was taken of
# s:   the snapshot
# ret: ok, the function refused, or the first release the allocator refused
pub fun restore(m: *Module, f: Function, s: *Body) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    var old: Body = @got.ok;
    @got.ok = @s;
    val released: err[allocator.Error] = module.release_body(m.a, ?old);
    if (sel released.err) { ret refuse(released.err); }
    ret err[Error].ok{};
}

# give back a snapshot that is not put back
pub fun discard(m: *Module, s: *Body) err[Error] {
    val released: err[allocator.Error] = module.release_body(m.a, s);
    if (sel released.err) { ret refuse(released.err); }
    ret err[Error].ok{};
}

fun must[T](r: res[T, Error], out: *T) bool {
    if (sel r.err) { ret false; }
    @out = r.ok;
    ret true;
}

fun ty(m: *Module, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(?m.types, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun int(m: *Module, width: u32) Type {
    ret ty(m, types.Shape.integer{types.Integer{width: width}});
}

fun public(t: Type) Declaration {
    ret Declaration{type: t, secret: false};
}

fun signature(m: *Module, params: Slice[Type], results: Slice[Type]) Type {
    ret ty(m, types.Shape.function{types.Function{params: params, results: results}});
}

fun values(data: *Value, size: usize) Slice[Value] {
    ret Slice[Value]{data: data, size: size};
}

fun no_values() Slice[Value] {
    ret Slice[Value]{data: nil, size: 0};
}

fun make(m: *Module, f: Function, req: Request) res[Instruction, Error] {
    var md: Metadata;
    ret builder_make(m, f, req, md);
}

fun op(code: opcode.Opcode, operands: Slice[Value], targets: Slice[Branch]) Request {
    var r: Request;
    r.opcode     = code;
    r.operands   = operands;
    r.immediates = Slice[opcode.Immediate]{data: nil, size: 0};
    r.targets    = targets;
    ret r;
}

fun no_targets() Slice[Branch] {
    ret Slice[Branch]{data: nil, size: 0};
}

fun module_for(a: *allocator.Allocator, m: *Module) bool {
    ret must[Module](module.init(a, View{data: "riscv64", len: 7}), m);
}

test body__replace_reaches_every_use {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    if (!module_for(?a, ?m)) { ret 1; }
    fin { module.dnit(?m); }

    var params: [2]Type = [2]Type{int(?m, 32), int(?m, 32)};
    var f:      Function;
    if (!must[Function](module.add_function(?m, FunctionData{name: View{data: "f", len: 1}, signature: signature(?m, Slice[Type]{data: ?params[0], size: 2}, Slice[Type]{data: nil, size: 0})}), ?f)) { ret 1; }
    var entry: Block;
    var next:  Block;
    var decls: [4]Declaration = [4]Declaration{public(params[0]), public(params[1]), Declaration{type: params[0], secret: true}, public(ty(?m, types.Shape.pointer{types.Pointer{space: 0}}))};
    if (!must[Block](block(?m, f, Slice[Declaration]{data: ?decls[0], size: 4}), ?entry)) { ret 2; }
    if (!must[Block](block(?m, f, Slice[Declaration]{data: ?decls[0], size: 1}), ?next))  { ret 2; }
    val e: res[BlockData, Error] = block_data(?m, f, entry);
    if (sel e.err) { ret 2; }
    val x: Value = e.ok.parameters.data[0];
    val y: Value = e.ok.parameters.data[1];
    val s: Value = e.ok.parameters.data[2];
    val p: Value = e.ok.parameters.data[3];

    var twice: [2]Value = [2]Value{x, x};
    var sum:   Instruction;
    if (!must[Instruction](make(?m, f, op(opcode.ADD, values(?twice[0], 2), no_targets())), ?sum)) { ret 3; }
    var arg:  [1]Value  = [1]Value{x};
    var edge: [1]Branch = [1]Branch{Branch{block: next, arguments: values(?arg[0], 1)}};
    var jump: Instruction;
    if (!must[Instruction](make(?m, f, op(opcode.BR, no_values(), Slice[Branch]{data: ?edge[0], size: 1})), ?jump)) { ret 3; }

    var leak:      [1]Value                = [1]Value{s};
    var leak_edge: [1]Branch               = [1]Branch{Branch{block: next, arguments: values(?leak[0], 1)}};
    val leaked:    res[Instruction, Error] = make(?m, f, op(opcode.BR, no_values(), Slice[Branch]{data: ?leak_edge[0], size: 1}));
    if (!(sel leaked.err && sel leaked.err.secret)) { ret 4; }
    val widened: res[Value, Error] = add_parameter(?m, f, next, public(params[0]), values(?leak[0], 1));
    if (!(sel widened.err && sel widened.err.secret)) { ret 4; }
    val laundered: err[Error] = replace(?m, f, x, s);
    if (!(sel laundered.err && sel laundered.err.secret)) { ret 4; }
    var marked: Metadata;
    marked.secret = true;
    val raised: err[Error] = set_metadata(?m, f, sum, marked);
    if (sel raised.err) { ret 4; }
    var plain:   Metadata;
    val lowered: err[Error] = set_metadata(?m, f, sum, plain);
    if (!(sel lowered.err && sel lowered.err.lowered)) { ret 4; }
    var pair:  [2]Value            = [2]Value{p, s};
    var align: [1]opcode.Immediate = [1]opcode.Immediate{opcode.Immediate.alignment{4}};
    var put:   Request             = op(opcode.STORE, values(?pair[0], 2), no_targets());
    put.immediates = Slice[opcode.Immediate]{data: ?align[0], size: 1};
    var stored: Instruction;
    if (!must[Instruction](make(?m, f, put), ?stored)) { ret 4; }
    val raised_store: err[Error] = set_metadata(?m, f, stored, marked);
    if (sel raised_store.err) { ret 4; }
    val lowered_store: err[Error] = set_metadata(?m, f, stored, plain);
    if (!(sel lowered_store.err && sel lowered_store.err.lowered)) { ret 4; }

    val before: res[Slice[Instruction], Error] = uses(?m, f, x);
    if (sel before.err)      { ret 4; }
    if (before.ok.size != 3) { ret 4; }

    val done: err[Error] = replace(?m, f, x, y);
    if (sel done.err) { ret 5; }
    val sd: res[InstructionData, Error] = instruction_data(?m, f, sum);
    val jd: res[InstructionData, Error] = instruction_data(?m, f, jump);
    if (sel sd.err)                                                                         { ret 6; }
    if (sel jd.err)                                                                         { ret 6; }
    if (sd.ok.operands.data[0].index != y.index || sd.ok.operands.data[1].index != y.index) { ret 6; }
    if (jd.ok.edges.data[0].arguments.data[0].index != y.index)                             { ret 7; }
    val gone: res[Slice[Instruction], Error] = uses(?m, f, x);
    val now:  res[Slice[Instruction], Error] = uses(?m, f, y);
    if (sel gone.err)                          { ret 8; }
    if (sel now.err)                           { ret 8; }
    if (gone.ok.size != 0 || now.ok.size != 3) { ret 8; }
    ret 0;
}

fun argument(m: *Module, f: Function, i: Instruction, edge: usize, at: usize) i64 {
    val d: res[InstructionData, Error] = instruction_data(m, f, i);
    if (sel d.err) { ret -1; }
    val args: vector.Vector[Value] = d.ok.edges.data[edge].arguments;
    if (at >= args.len) { ret -1; }
    ret args.data[at].index::i64;
}

fun arity(m: *Module, f: Function, i: Instruction, edge: usize) usize {
    val d: res[InstructionData, Error] = instruction_data(m, f, i);
    if (sel d.err) { ret 99; }
    ret d.ok.edges.data[edge].arguments.len;
}

test body__parameters_keep_edges_in_step {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    if (!module_for(?a, ?m)) { ret 1; }
    fin { module.dnit(?m); }

    var params: [3]Type = [3]Type{int(?m, 1), int(?m, 32), int(?m, 32)};
    var f:      Function;
    if (!must[Function](module.add_function(?m, FunctionData{name: View{data: "f", len: 1}, signature: signature(?m, Slice[Type]{data: ?params[0], size: 3}, Slice[Type]{data: nil, size: 0})}), ?f)) { ret 1; }
    var entry: Block;
    var side:  Block;
    var join:  Block;
    var decls: [3]Declaration = [3]Declaration{public(params[0]), public(params[1]), public(params[2])};
    if (!must[Block](block(?m, f, Slice[Declaration]{data: ?decls[0], size: 4}), ?entry)) { ret 2; }
    if (!must[Block](block(?m, f, Slice[Declaration]{data: nil, size: 0}), ?side))        { ret 2; }
    if (!must[Block](block(?m, f, Slice[Declaration]{data: ?decls[1], size: 1}), ?join))  { ret 2; }
    val e: res[BlockData, Error] = block_data(?m, f, entry);
    if (sel e.err) { ret 2; }
    var cond: [1]Value = [1]Value{e.ok.parameters.data[0]};
    val x:    Value    = e.ok.parameters.data[1];
    val y:    Value    = e.ok.parameters.data[2];

    var xs:    [1]Value  = [1]Value{x};
    var ys:    [1]Value  = [1]Value{y};
    var both:  [2]Branch = [2]Branch{Branch{block: join, arguments: values(?xs[0], 1)}, Branch{block: join, arguments: values(?ys[0], 1)}};
    var split: Instruction;
    if (!must[Instruction](make(?m, f, op(opcode.CBR, values(?cond[0], 1), Slice[Branch]{data: ?both[0], size: 2})), ?split)) { ret 3; }
    var one:  [1]Branch = [1]Branch{Branch{block: join, arguments: values(?xs[0], 1)}};
    var jump: Instruction;
    if (!must[Instruction](make(?m, f, op(opcode.BR, no_values(), Slice[Branch]{data: ?one[0], size: 1})), ?jump)) { ret 3; }

    var short:   [1]Value          = [1]Value{y};
    val refused: res[Value, Error] = add_parameter(?m, f, join, public(int(?m, 32)), values(?short[0], 1));
    if (sel refused.ok) { ret 4; }

    var incoming: [3]Value = [3]Value{y, x, y};
    var added:    Value;
    if (!must[Value](add_parameter(?m, f, join, public(int(?m, 32)), values(?incoming[0], 3)), ?added)) { ret 5; }
    if (argument(?m, f, split, 0, 1) != y.index::i64 || argument(?m, f, split, 1, 1) != x.index::i64)   { ret 6; }
    if (argument(?m, f, jump, 0, 1) != y.index::i64)                                                    { ret 6; }

    val j: res[BlockData, Error] = block_data(?m, f, join);
    if (sel j.err) { ret 7; }
    val first: Value      = j.ok.parameters.data[0];
    val gone:  err[Error] = remove_parameter(?m, f, join, 0);
    if (sel gone.err)                                                                                 { ret 7; }
    if (arity(?m, f, split, 0) != 1 || arity(?m, f, split, 1) != 1 || arity(?m, f, jump, 0) != 1)     { ret 8; }
    if (argument(?m, f, split, 0, 0) != y.index::i64 || argument(?m, f, split, 1, 0) != x.index::i64) { ret 8; }
    if (argument(?m, f, jump, 0, 0) != y.index::i64)                                                  { ret 8; }

    val kept: res[ValueData, Error] = value_data(?m, f, added);
    if (sel kept.err)                                                     { ret 9; }
    if (!(sel kept.ok.def.parameter && kept.ok.def.parameter.index == 0)) { ret 9; }
    val dead: res[ValueData, Error] = value_data(?m, f, first);
    if (sel dead.err)               { ret 9; }
    if (!(sel dead.ok.def.removed)) { ret 9; }
    val xu: res[Slice[Instruction], Error] = uses(?m, f, x);
    val yu: res[Slice[Instruction], Error] = uses(?m, f, y);
    if (sel xu.err)                         { ret 10; }
    if (sel yu.err)                         { ret 10; }
    if (xu.ok.size != 1 || yu.ok.size != 2) { ret 10; }
    ret 0;
}
