# the edits of a function body that keep its use lists, edges and value
# binding records in step
#
# every edit takes what it may fail on first, so a refusal leaves the body as
# it was. a use list holds an instruction once per operand or argument that
# names the value, and a block's predecessor list holds an instruction once
# per edge into the block.
#
# a record lives in the body's pool and stands in a run: each instruction holds
# the run just before it and each block the run at its end, linked through the
# pool, so every edit re-anchors a run in constant time. an instruction placed
# before another takes that one's run, and one appended takes the block's end
# run. an erased instruction leaves its run to the instruction after it, and a
# moved one takes its run along. a value's bound list names the pool position
# of every record that reads it, so when the value goes, through an erase, a
# replacement or a removed parameter, its records follow it or become
# unavailable without a walk of the body.
#
# `builder_make` is the builder's own: every other module makes instructions
# through mirl.build, and places, replaces and erases them here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.block.BlockData;
use mirl.ir.contents;
use mirl.ir.debug.place;
use mirl.ir.debug.record;
use mirl.ir.debug.record.Binding;
use debug_table: mirl.ir.debug.table;
use mirl.ir.function.Body;
use mirl.ir.function.Entry;
use mirl.ir.function.FunctionData;
use mirl.ir.id.Block;
use mirl.ir.id.Constant;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction;
use mirl.ir.instruction.Branch;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.instruction.Place;
use mirl.ir.instruction.Request;
use mirl.ir.metadata.Bindings;
use mirl.ir.metadata.Metadata;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.module.Module;
use mirl.ir.opcode.check;
use opcode_row:   mirl.ir.opcode.row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.place.Placed;
use mirl.ir.point;
use mirl.ir.point.Bits;
use mirl.ir.point.Expression;
use mirl.ir.point.Operand;
use mirl.ir.point.Part;
use mirl.ir.point.Point;
use mirl.ir.point.Reads;
use mirl.ir.point.Run;
use mirl.ir.point.Step;
use mirl.ir.pool;
use mirl.ir.pool.Growing;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Declaration;
use mirl.ir.value.Def;
use mirl.ir.value.Output;
use mirl.ir.value.Parameter;
use mirl.ir.value.ValueData;

fun fail[T](e: allocator.Error) res[T, Error] {
    ret res[T, Error].err{Error.alloc{e}};
}

fun refuse(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun has_value(b: *Body, v: Value) bool {
    ret v::usize < b.values.len;
}

fun has_block(b: *Body, k: Block) bool {
    ret k::usize < b.blocks.len;
}

fun has_instruction(b: *Body, i: Instruction) bool {
    ret i::usize < b.instructions.len;
}

# a block of the body that has not been erased
fun live(b: *Body, k: Block) err[Error] {
    if (!has_block(b, k))        { ret err[Error].err{Error.block{k}}; }
    if (b.blocks.data[k].erased) { ret err[Error].err{Error.removed{k}}; }
    ret err[Error].ok{};
}

fun known_type(m: *Module, ty: Type) err[Error] {
    val s: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel s.err) { ret err[Error].err{Error.types{s.err}}; }
    ret err[Error].ok{};
}

fun list[T](v: *vector.Vector[T]) Slice[T] {
    ret Slice[T]{data: v.data, size: v.len};
}

fun remove_at[T](v: *vector.Vector[T], at: usize) {
    var i: usize = at;
    for (i + 1 < v.len) {
        v.data[i] = v.data[i + 1];
        i         = i + 1;
    }
    vector.truncate[T](v, v.len - 1);
}

# take the entry at a position out of an instruction's list, the rest moving down
fun cut_at[T](l: *List[T], at: usize) {
    var i: usize = at;
    for (i + 1 < l.len) {
        l.data[i] = l.data[i + 1];
        i         = i + 1;
    }
    l.len = l.len - 1;
}

# a list of values copied into a run of the body's pool, which has room for it
fun held(b: *Body, s: Slice[Value]) List[Value] {
    val run: *Value = pool.claim[Value](?b.lists, s.size);
    var i:   usize  = 0;
    for (i < s.size) {
        run[i] = s.data[i];
        i      = i + 1;
    }
    ret List[Value]{data: run, len: s.size};
}

# drop one use by an instruction from a value's use list
fun drop_use(l: *Growing[Instruction], i: Instruction) {
    var k: usize = 0;
    for (k < l.len) {
        if (l.data[k] == i) {
            cut_growing(l, k);
            ret;
        }
        k = k + 1;
    }
}

fun cut_growing(l: *Growing[Instruction], at: usize) {
    var i: usize = at;
    for (i + 1 < l.len) {
        l.data[i] = l.data[i + 1];
        i         = i + 1;
    }
    l.len = l.len - 1;
}

# drop one entry naming an instruction from a list
fun drop_one(v: *vector.Vector[Instruction], i: Instruction) {
    var k: usize = 0;
    for (k < v.len) {
        if (v.data[k] == i) {
            remove_at[Instruction](v, k);
            ret;
        }
        k = k + 1;
    }
}

# drop one entry naming a record from a bound list
fun drop_record(v: *vector.Vector[u32], r: u32) {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == r) {
            remove_at[u32](v, i);
            ret;
        }
        i = i + 1;
    }
}

# the empty run
fun no_run() Run {
    ret Run{first: 0, last: 0};
}

# run y joined after run x, the records linked in order
fun join(b: *Body, x: Run, y: Run) Run {
    if (x.first == 0) { ret y; }
    if (y.first == 0) { ret x; }
    b.points.data[x.last - 1].next = y.first;
    ret Run{first: x.first, last: y.last};
}

# make every record that reads a value unavailable, the value going
fun unbind(b: *Body, v: Value) {
    val bound: *vector.Vector[u32] = ?b.values.data[v].bound;
    var e:     usize               = 0;
    for (e < bound.len) {
        b.points.data[bound.data[e]].reads = Reads.unavailable{};
        e                                  = e + 1;
    }
    vector.truncate[u32](bound, 0);
}

# move every record that reads old to read new, its expression kept, where
# new's bound list has room for them
fun move_reads(b: *Body, old: Value, new: Value) {
    val bound: *vector.Vector[u32] = ?b.values.data[old].bound;
    var e:     usize               = 0;
    for (e < bound.len) {
        val r:   u32   = bound.data[e];
        val was: Reads = b.points.data[r].reads;
        if (sel was.operand) { b.points.data[r].reads = Reads.operand{Operand{value: new, expression: was.operand.expression}}; }
        vector.push[u32](?b.values.data[new].bound, r);
        e = e + 1;
    }
    vector.truncate[u32](bound, 0);
}

# room for every use and record of old to move to new
fun room_to_move(b: *Body, old: Value, new: Value) err[allocator.Error] {
    val uses: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[new].uses, b.values.data[old].uses.len);
    if (sel uses.err) { ret err[allocator.Error].err{uses.err}; }
    val bound: res[usize, allocator.Error] = vector.reserve[u32](?b.values.data[new].bound, b.values.data[old].bound.len);
    if (sel bound.err) { ret err[allocator.Error].err{bound.err}; }
    ret err[allocator.Error].ok{};
}

# the edge of the predecessor entry at position k of a block's list
fun edge_of(b: *Body, target: Block, k: usize) *Edge {
    val preds: *vector.Vector[Instruction] = ?b.blocks.data[target].predecessors;
    val inst:  Instruction                 = preds.data[k];
    var seen:  usize                       = 0;
    var j:     usize                       = 0;
    for (j < k) {
        if (preds.data[j] == inst) { seen = seen + 1; }
        j = j + 1;
    }
    val d: *InstructionData = ?b.instructions.data[inst];
    var e: usize            = 0;
    for (e < d.edges.len) {
        if (d.edges.data[e].block == target) {
            if (seen == 0) { ret ?d.edges.data[e]; }
            seen = seen - 1;
        }
        e = e + 1;
    }
    ret nil;
}

# whether a name asked for is none or not empty
fun named(name: opt[View]) bool {
    if (sel name.some) { ret name.some.len > 0; }
    ret true;
}

# a copy of a name the module owns
fun own_name(a: *allocator.Allocator, name: opt[View]) res[opt[View], allocator.Error] {
    if (sel name.none) { ret res[opt[View], allocator.Error].ok{name}; }
    val c: res[View, allocator.Error] = slice.copy_view(a, name.some);
    if (sel c.err) { ret res[opt[View], allocator.Error].err{c.err}; }
    ret res[opt[View], allocator.Error].ok{opt[View].some{c.ok}};
}

# give back a name the module owns
pub fun release_name(a: *allocator.Allocator, name: opt[View]) err[allocator.Error] {
    if (sel name.some) { ret slice.release_view(a, name.some); }
    ret err[allocator.Error].ok{};
}

# give a value the name the text form prints it by, in place of any it had
# ---
# m:    the module
# f:    the function
# v:    the value
# name: the name, which is copied, or none to print it by number
# ret:  ok, or why it was refused
pub fun name_value(m: *Module, f: Function, v: Value, name: opt[View]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret err[Error].err{got.err}; }
    if (!has_value(got.ok, v)) { ret err[Error].err{Error.value{v}}; }
    if (!named(name))          { ret err[Error].err{Error.name{}}; }
    val owned: res[opt[View], allocator.Error] = own_name(m.a, name);
    if (sel owned.err) { ret refuse(owned.err); }
    val d: *ValueData = ?got.ok.values.data[v];
    release_name(m.a, d.name);
    d.name = owned.ok;
    ret err[Error].ok{};
}

# give a block the name the text form prints it by, in place of any it had
# ---
# m:    the module
# f:    the function
# k:    the block
# name: the name, which is copied, or none to print it by number
# ret:  ok, or why it was refused
pub fun name_block(m: *Module, f: Function, k: Block, name: opt[View]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val open: err[Error] = live(got.ok, k);
    if (sel open.err) { ret open; }
    if (!named(name)) { ret err[Error].err{Error.name{}}; }
    val owned: res[opt[View], allocator.Error] = own_name(m.a, name);
    if (sel owned.err) { ret refuse(owned.err); }
    val d: *BlockData = ?got.ok.blocks.data[k];
    release_name(m.a, d.name);
    d.name = owned.ok;
    ret err[Error].ok{};
}

# make a block
# ---
# m:          the module
# f:          the function whose body takes the block
# parameters: its parameters, in order
# ret:        the block, the entry when it is the body's first, or why it was refused
pub fun block(m: *Module, f: Function, parameters: Slice[Declaration]) res[Block, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Block, Error].err{got.err}; }
    val b: *Body = got.ok;
    var i: usize = 0;
    for (i < parameters.size) {
        val k: err[Error] = known_type(m, parameters.data[i].type);
        if (sel k.err)                       { ret res[Block, Error].err{k.err}; }
        if (!named(parameters.data[i].name)) { ret res[Block, Error].err{Error.name{}}; }
        i = i + 1;
    }

    i = 0;
    for (i < parameters.size) {
        val noted: err[allocator.Error] = contents.note_type(?b.contents, parameters.data[i].type);
        if (sel noted.err) { ret fail[Block](noted.err); }
        i = i + 1;
    }

    var d: BlockData;
    d.parameters   = vector.init[Value](m.a);
    d.instructions = vector.init[Instruction](m.a);
    d.predecessors = vector.init[Instruction](m.a);
    d.ending       = no_run();
    val room: res[usize, allocator.Error] = vector.reserve[Value](?d.parameters, parameters.size);
    if (sel room.err) { ret fail[Block](room.err); }
    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, parameters.size);
    if (sel values.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](values.err);
    }
    val blocks: res[usize, allocator.Error] = vector.reserve[BlockData](?b.blocks, 1);
    if (sel blocks.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](blocks.err);
    }
    var names: vector.Vector[opt[View]] = vector.init[opt[View]](m.a);
    fin { vector.dnit[opt[View]](?names); }
    val name_room: res[usize, allocator.Error] = vector.reserve[opt[View]](?names, parameters.size);
    if (sel name_room.err) {
        vector.dnit[Value](?d.parameters);
        ret fail[Block](name_room.err);
    }
    i = 0;
    for (i < parameters.size) {
        val owned: res[opt[View], allocator.Error] = own_name(m.a, parameters.data[i].name);
        if (sel owned.err) {
            var k: usize = 0;
            for (k < names.len) {
                release_name(m.a, names.data[k]);
                k = k + 1;
            }
            vector.dnit[Value](?d.parameters);
            ret fail[Block](owned.err);
        }
        vector.push[opt[View]](?names, owned.ok);
        i = i + 1;
    }

    val id: Block = (b.blocks.len::u32);
    i = 0;
    for (i < parameters.size) {
        val v: Value = (b.values.len::u32);
        vector.push[ValueData](?b.values, ValueData{type: parameters.data[i].type, secret: parameters.data[i].secret, def: Def.parameter{Parameter{block: id, index: i::u32}}, uses: pool.nothing[Instruction](), bound: vector.init[u32](m.a), name: names.data[i]});
        vector.push[Value](?d.parameters, v);
        i = i + 1;
    }
    vector.push[BlockData](?b.blocks, d);
    ret res[Block, Error].ok{id};
}

# what a block is, its lists valid until the body next changes
pub fun block_data(m: *Module, f: Function, k: Block) res[BlockData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret res[BlockData, Error].err{got.err}; }
    if (!has_block(got.ok, k)) { ret res[BlockData, Error].err{Error.block{k}}; }
    ret res[BlockData, Error].ok{got.ok.blocks.data[k]};
}

# how a block ends
# ---
# count:      how many instructions it lists
# terminated: whether the last of them is a terminator
pub rec Ending {
    count:      usize;
    terminated: bool;
}

# how a block ends, read in place
pub fun ending(m: *Module, f: Function, k: Block) res[Ending, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Ending, Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_block(b, k)) { ret res[Ending, Error].err{Error.block{k}}; }
    val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    if (list.len == 0) { ret res[Ending, Error].ok{Ending{count: 0, terminated: false}}; }
    val r: opt[*opcode_row.Row] = opcode_table.at(b.instructions.data[list.data[list.len - 1]].opcode);
    ret res[Ending, Error].ok{Ending{count: list.len, terminated: sel r.some && r.some.terminator}};
}

# add a parameter to a block, and its argument to every edge into it
# ---
# m:        the module
# f:        the function
# k:        the block
# declared: the parameter
# incoming: the argument each edge into the block passes, one per entry of
#           its predecessor list and in that order
# ret:      the parameter, or why it was refused
pub fun add_parameter(m: *Module, f: Function, k: Block, declared: Declaration, incoming: Slice[Value]) res[Value, Error] {
    val ty:  Type              = declared.type;
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Value, Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret res[Value, Error].err{open.err}; }
    val known: err[Error] = known_type(m, ty);
    if (sel known.err)         { ret res[Value, Error].err{known.err}; }
    if (!named(declared.name)) { ret res[Value, Error].err{Error.name{}}; }
    val preds: usize = b.blocks.data[k].predecessors.len;
    if (incoming.size != preds) { ret res[Value, Error].err{Error.incoming{incoming.size::u32}}; }

    var i: usize = 0;
    for (i < preds) {
        val v: Value = incoming.data[i];
        if (!has_value(b, v))                            { ret res[Value, Error].err{Error.value{v}}; }
        if (!table.same(b.values.data[v].type, ty))      { ret res[Value, Error].err{Error.mismatch{b.values.data[v].type}}; }
        if (b.values.data[v].secret && !declared.secret) { ret res[Value, Error].err{Error.secret{v}}; }
        i = i + 1;
    }

    val noted: err[allocator.Error] = contents.note_type(?b.contents, ty);
    if (sel noted.err) { ret fail[Value](noted.err); }
    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, 1);
    if (sel values.err) { ret fail[Value](values.err); }
    val params: res[usize, allocator.Error] = vector.reserve[Value](?b.blocks.data[k].parameters, 1);
    if (sel params.err) { ret fail[Value](params.err); }
    i = 0;
    for (i < preds) {
        var same: usize = 0;
        var j:    usize = 0;
        for (j < preds) {
            if (incoming.data[j] == incoming.data[i]) { same = same + 1; }
            j = j + 1;
        }
        val uses: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[incoming.data[i]].uses, same);
        if (sel uses.err) { ret fail[Value](uses.err); }
        i = i + 1;
    }

    var held: usize = 0;
    i = 0;
    for (i < preds) {
        held = held + edge_of(b, k, i).arguments.len + 1;
        i    = i + 1;
    }
    val args: err[allocator.Error] = pool.ensure[Value](?b.lists, held);
    if (sel args.err) { ret fail[Value](args.err); }
    val owned: res[opt[View], allocator.Error] = own_name(m.a, declared.name);
    if (sel owned.err) { ret fail[Value](owned.err); }

    val index: u32   = b.blocks.data[k].parameters.len::u32;
    val p:     Value = (b.values.len::u32);
    vector.push[ValueData](?b.values, ValueData{type: ty, secret: declared.secret, def: Def.parameter{Parameter{block: k, index: index}}, uses: pool.nothing[Instruction](), bound: vector.init[u32](m.a), name: owned.ok});
    vector.push[Value](?b.blocks.data[k].parameters, p);
    i = 0;
    for (i < preds) {
        val e:   *Edge  = edge_of(b, k, i);
        val run: *Value = pool.claim[Value](?b.lists, e.arguments.len + 1);
        var j:   usize  = 0;
        for (j < e.arguments.len) {
            run[j] = e.arguments.data[j];
            j      = j + 1;
        }
        run[e.arguments.len] = incoming.data[i];
        e.arguments          = List[Value]{data: run, len: e.arguments.len + 1};
        pool.push[Instruction](?b.lists, ?b.values.data[incoming.data[i]].uses, b.blocks.data[k].predecessors.data[i]);
        i = i + 1;
    }
    ret res[Value, Error].ok{p};
}

# take a parameter out of its block and its argument out of every edge into
# it, every record that reads it becoming unavailable
fun cut_parameter(b: *Body, k: Block, index: u32) {
    val d: *BlockData = ?b.blocks.data[k];
    val p: Value      = d.parameters.data[index];
    var i: usize      = 0;
    for (i < d.predecessors.len) {
        val e:   *Edge = edge_of(b, k, i);
        val arg: Value = e.arguments.data[index];
        cut_at[Value](?e.arguments, index::usize);
        drop_use(?b.values.data[arg].uses, d.predecessors.data[i]);
        i = i + 1;
    }
    remove_at[Value](?d.parameters, index::usize);
    i = index::usize;
    for (i < d.parameters.len) {
        b.values.data[d.parameters.data[i]].def = Def.parameter{Parameter{block: k, index: i::u32}};
        i                                       = i + 1;
    }
    unbind(b, p);
    b.values.data[p].def = Def.removed{};
}

# remove an unused parameter from a block, and its argument from every edge
# into it. every record that reads it becomes unavailable
# ---
# m:     the module
# f:     the function
# k:     the block
# index: the parameter's position
# ret:   ok, or why it was refused
pub fun remove_parameter(m: *Module, f: Function, k: Block, index: u32) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    val d: *BlockData = ?b.blocks.data[k];
    if (index::usize >= d.parameters.len) { ret err[Error].err{Error.parameter{index}}; }
    val p: Value = d.parameters.data[index];
    if (b.values.data[p].uses.len != 0) { ret err[Error].err{Error.used{p}}; }

    cut_parameter(b, k, index);
    ret err[Error].ok{};
}

# state where a function's entry parameters arrive, one place per parameter,
# once the abi legalisation has made them its pieces
# ---
# m:      the module
# f:      the function
# places: one place for each entry parameter, in order, copied
# ret:    ok, or why it was refused
pub fun place_entry(m: *Module, f: Function, places: Slice[Placed]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (b.blocks.len == 0)                              { ret err[Error].err{Error.parameter{places.size::u32}}; }
    if (b.blocks.data[0].parameters.len != places.size) { ret err[Error].err{Error.parameter{places.size::u32}}; }
    var list: vector.Vector[Placed]       = vector.init[Placed](m.a);
    val room: res[usize, allocator.Error] = vector.reserve[Placed](?list, places.size);
    if (sel room.err) { ret refuse(room.err); }
    var i: usize = 0;
    for (i < places.size) {
        vector.push[Placed](?list, places.data[i]);
        i = i + 1;
    }
    if (sel b.entry.placed) { vector.dnit[Placed](?b.entry.placed); }
    b.entry = Entry.placed{list};
    ret err[Error].ok{};
}

# the value that stands for a constant in a function, the same one each time
# ---
# m:   the module
# f:   the function
# c:   the constant
# ret: its value, or why it was refused
pub fun constant(m: *Module, f: Function, c: Constant) res[Value, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Value, Error].err{got.err}; }
    val b:     *Body       = got.ok;
    val key:   u32         = c;
    val found: opt[*Value] = map.get[u32, Value](?b.constants, ?key);
    if (sel found.some) { ret res[Value, Error].ok{@found.some}; }
    val ty: res[Type, Error] = module.constant_type(m, c);
    if (sel ty.err) { ret res[Value, Error].err{ty.err}; }
    val noted: err[allocator.Error] = contents.note_type(?b.contents, ty.ok);
    if (sel noted.err) { ret fail[Value](noted.err); }

    val room: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, 1);
    if (sel room.err) { ret fail[Value](room.err); }
    val v:      Value                      = (b.values.len::u32);
    val linked: res[bool, allocator.Error] = map.insert[u32, Value](?b.constants, key, v);
    if (sel linked.err) { ret fail[Value](linked.err); }
    vector.push[ValueData](?b.values, ValueData{type: ty.ok, secret: false, def: Def.constant{c}, uses: pool.nothing[Instruction](), bound: vector.init[u32](m.a)});
    ret res[Value, Error].ok{v};
}

# what a value is, its use list valid until the body next changes
pub fun value_data(m: *Module, f: Function, v: Value) res[ValueData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)           { ret res[ValueData, Error].err{got.err}; }
    if (!has_value(got.ok, v)) { ret res[ValueData, Error].err{Error.value{v}}; }
    ret res[ValueData, Error].ok{got.ok.values.data[v]};
}

# the instructions that use a value, once per use, valid until the body next changes
pub fun uses(m: *Module, f: Function, v: Value) res[Slice[Instruction], Error] {
    val got: res[ValueData, Error] = value_data(m, f, v);
    if (sel got.err) { ret res[Slice[Instruction], Error].err{got.err}; }
    ret res[Slice[Instruction], Error].ok{Slice[Instruction]{data: got.ok.uses.data, size: got.ok.uses.len}};
}

fun occurrences(req: *Request, v: Value) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < req.operands.size) {
        if (req.operands.data[i] == v) { n = n + 1; }
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val args: Slice[Value] = req.targets.data[i].arguments;
        var j:    usize        = 0;
        for (j < args.size) {
            if (args.data[j] == v) { n = n + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret n;
}

fun targeting(req: *Request, k: Block) usize {
    var n: usize = 0;
    var i: usize = 0;
    for (i < req.targets.size) {
        if (req.targets.data[i].block == k) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# type a request against its opcode's row, its result types left in the
# module's scratch, giving whether its results are secret
#
# each value and block it names is checked to be the body's as it is read,
# its operands first and then each target, and a value an argument passes is
# no more secret than the parameter it binds.
fun typed(m: *Module, f: Function, b: *Body, r: *opcode_row.Row, req: *Request, md: Metadata) res[bool, Error] {
    val tys:     *vector.Vector[Type]       = ?m.scratch.types;
    val secrets: *vector.Vector[bool]       = ?m.scratch.secret;
    val edges:   *vector.Vector[check.Edge] = ?m.scratch.edges;
    tys.len               = 0;
    secrets.len           = 0;
    edges.len             = 0;
    m.scratch.results.len = 0;
    val room: res[usize, allocator.Error] = vector.reserve[Type](tys, req.operands.size);
    if (sel room.err) { ret fail[bool](room.err); }
    val secret_room: res[usize, allocator.Error] = vector.reserve[bool](secrets, req.operands.size);
    if (sel secret_room.err) { ret fail[bool](secret_room.err); }

    var i: usize = 0;
    for (i < req.operands.size) {
        val v: Value = req.operands.data[i];
        if (!has_value(b, v)) { ret res[bool, Error].err{Error.value{v}}; }
        val d: *ValueData = ?b.values.data[v];
        tys.data[i]     = d.type;
        secrets.data[i] = d.secret;
        i               = i + 1;
    }
    tys.len     = req.operands.size;
    secrets.len = req.operands.size;

    if (req.targets.size != 0) {
        var total: usize = 0;
        i = 0;
        for (i < req.targets.size) {
            val t:    Branch     = req.targets.data[i];
            val open: err[Error] = live(b, t.block);
            if (sel open.err) { ret res[bool, Error].err{open.err}; }
            val params: *vector.Vector[Value] = ?b.blocks.data[t.block].parameters;
            var j:      usize                 = 0;
            for (j < t.arguments.size) {
                val v: Value = t.arguments.data[j];
                if (!has_value(b, v)) { ret res[bool, Error].err{Error.value{v}}; }
                if (j < params.len && b.values.data[v].secret && !b.values.data[params.data[j]].secret) {
                    ret res[bool, Error].err{Error.secret{v}};
                }
                j = j + 1;
            }
            total = total + t.arguments.size + params.len;
            i     = i + 1;
        }
        val more: res[usize, allocator.Error] = vector.reserve[Type](tys, total);
        if (sel more.err) { ret fail[bool](more.err); }
        val edge_room: res[usize, allocator.Error] = vector.reserve[check.Edge](edges, req.targets.size);
        if (sel edge_room.err) { ret fail[bool](edge_room.err); }
        i = 0;
        for (i < req.targets.size) {
            val t:      Branch                = req.targets.data[i];
            val params: *vector.Vector[Value] = ?b.blocks.data[t.block].parameters;
            val first:  usize                 = tys.len;
            var j:      usize                 = 0;
            for (j < t.arguments.size) {
                vector.push[Type](tys, b.values.data[t.arguments.data[j]].type);
                j = j + 1;
            }
            val second: usize = tys.len;
            j = 0;
            for (j < params.len) {
                vector.push[Type](tys, b.values.data[params.data[j]].type);
                j = j + 1;
            }
            vector.push[check.Edge](edges, check.Edge{
                arguments:  Slice[Type]{data: ?tys.data[first], size: second - first},
                parameters: Slice[Type]{data: ?tys.data[second], size: tys.len - second},
            });
            i = i + 1;
        }
    }

    var inst: check.Instance;
    inst.operands   = Slice[Type]{data: tys.data, size: req.operands.size};
    inst.secret     = list[bool](secrets);
    inst.declared   = md.secret;
    inst.kept       = md.flags.kept;
    inst.bounded    = md.flags.bounded;
    inst.checked    = md.flags.checked;
    inst.trap       = md.flags.trap;
    inst.immediates = req.immediates;
    inst.edges      = list[check.Edge](edges);
    if (check.takes_returns(r)) {
        val fd: res[FunctionData, Error] = module.function_data(m, f);
        if (sel fd.err) { ret res[bool, Error].err{fd.err}; }
        val sig: res[table.Function, table.Error] = table.signature(?m.types, fd.ok.signature);
        if (sel sig.err) { ret res[bool, Error].err{Error.types{sig.err}}; }
        inst.returns = sig.ok.results;
    }
    val checked: res[bool, check.Error] = check.check_row(?m.types, r, ?inst, ?m.scratch.results);
    if (sel checked.err) { ret res[bool, Error].err{Error.typing{checked.err}}; }
    ret res[bool, Error].ok{checked.ok};
}

# the instruction's own lists, runs of the body's pools, before anything in
# the body changes, into a zeroed record: detached, in no run and with no
# immediates yet. its results are left for the maker to fill
fun prepare(m: *Module, b: *Body, req: *Request, md: Metadata, results: usize, d: *InstructionData) err[allocator.Error] {
    d.opcode   = req.opcode;
    d.metadata = md;
    var values: usize = req.operands.size + results;
    var i:      usize = 0;
    for (i < req.targets.size) {
        values = values + req.targets.data[i].arguments.size;
        i      = i + 1;
    }
    val listed: err[allocator.Error] = pool.ensure[Value](?b.lists, values);
    if (sel listed.err) { ret listed; }
    val edged: err[allocator.Error] = pool.ensure[Edge](?b.edges, req.targets.size);
    if (sel edged.err) { ret edged; }
    val slotted: err[allocator.Error] = pool.ensure[opcode_row.Immediate](?b.immediates, req.immediates.size);
    if (sel slotted.err) { ret slotted; }
    d.operands = held(b, req.operands);
    d.results  = List[Value]{data: pool.claim[Value](?b.lists, results), len: results};
    d.edges    = List[Edge]{data: pool.claim[Edge](?b.edges, req.targets.size), len: req.targets.size};
    i          = 0;
    for (i < req.targets.size) {
        d.edges.data[i] = Edge{block: req.targets.data[i].block, arguments: held(b, req.targets.data[i].arguments)};
        i               = i + 1;
    }
    d.immediates.data = pool.claim[opcode_row.Immediate](?b.immediates, req.immediates.size);
    i                 = 0;
    for (i < req.immediates.size) {
        val kept: res[opcode_row.Immediate, allocator.Error] = instruction.own(m.a, req.immediates.data[i]);
        if (sel kept.err) { ret err[allocator.Error].err{kept.err}; }
        d.immediates.data[i] = kept.ok;
        d.immediates.len     = i + 1;
        i                    = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# record in the body's contents the opcode of an instruction, the types it
# gives and the types its immediates name
fun note(b: *Body, req: *Request, results: *vector.Vector[Type]) err[allocator.Error] {
    val coded: err[allocator.Error] = contents.note_opcode(?b.contents, req.opcode);
    if (sel coded.err) { ret coded; }
    var i: usize = 0;
    for (i < results.len) {
        val typed: err[allocator.Error] = contents.note_type(?b.contents, results.data[i]);
        if (sel typed.err) { ret typed; }
        i = i + 1;
    }
    i = 0;
    for (i < req.immediates.size) {
        val imm: opcode_row.Immediate = req.immediates.data[i];
        if (sel imm.ty) {
            val named: err[allocator.Error] = contents.note_type(?b.contents, imm.ty);
            if (sel named.err) { ret named; }
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# room in every list the instruction joins
fun make_room(b: *Body, req: *Request, results: usize) err[allocator.Error] {
    val values: res[usize, allocator.Error] = vector.reserve[ValueData](?b.values, results);
    if (sel values.err) { ret err[allocator.Error].err{values.err}; }
    val insts: res[usize, allocator.Error] = vector.reserve[InstructionData](?b.instructions, 1);
    if (sel insts.err) { ret err[allocator.Error].err{insts.err}; }
    var i: usize = 0;
    for (i < req.operands.size) {
        val v:    Value                = req.operands.data[i];
        val room: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[v].uses, occurrences(req, v));
        if (sel room.err) { ret err[allocator.Error].err{room.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t:     Branch                      = req.targets.data[i];
        val preds: res[usize, allocator.Error] = vector.reserve[Instruction](?b.blocks.data[t.block].predecessors, targeting(req, t.block));
        if (sel preds.err) { ret err[allocator.Error].err{preds.err}; }
        var j: usize = 0;
        for (j < t.arguments.size) {
            val v:    Value                = t.arguments.data[j];
            val room: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[v].uses, occurrences(req, v));
            if (sel room.err) { ret err[allocator.Error].err{room.err}; }
            j = j + 1;
        }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# make an instruction, typed by its opcode's row and placed in no block, for
# mirl.build alone
#
# its operands and arguments are used from now on, and each of its edges is
# an entry in its target's predecessor list.
# ---
# m:   the module
# f:   the function whose body takes it
# r:   the row of its opcode
# req: what it is made from, whose lists are copied
# md:  its metadata record
# ret: the instruction, or why it was refused
pub fun builder_make(m: *Module, f: Function, r: *opcode_row.Row, req: Request, md: Metadata) res[Instruction, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Instruction, Error].err{got.err}; }
    val b: *Body = got.ok;

    val checked: res[bool, Error] = typed(m, f, b, r, ?req, md);
    if (sel checked.err) { ret res[Instruction, Error].err{checked.err}; }
    val out:   *vector.Vector[Type] = ?m.scratch.results;
    val noted: err[allocator.Error] = note(b, ?req, out);
    if (sel noted.err) { ret fail[Instruction](noted.err); }

    var d:        InstructionData;
    val prepared: err[allocator.Error] = prepare(m, b, ?req, md, out.len, ?d);
    if (sel prepared.err) {
        instruction.release(m.a, ?d);
        ret fail[Instruction](prepared.err);
    }
    val room: err[allocator.Error] = make_room(b, ?req, out.len);
    if (sel room.err) {
        instruction.release(m.a, ?d);
        ret fail[Instruction](room.err);
    }

    # every list below has the room make_room took
    val id: Instruction = (b.instructions.len::u32);
    var i:  usize       = 0;
    for (i < out.len) {
        d.results.data[i]           = (b.values.len::u32);
        b.values.data[b.values.len] = ValueData{type: out.data[i], secret: checked.ok, def: Def.result{Output{instruction: id, index: i::u32}}, uses: pool.nothing[Instruction](), bound: vector.init[u32](m.a)};
        b.values.len                = b.values.len + 1;
        i                           = i + 1;
    }
    i = 0;
    for (i < req.operands.size) {
        used(?b.values.data[req.operands.data[i]].uses, id);
        i = i + 1;
    }
    i = 0;
    for (i < req.targets.size) {
        val t: Branch = req.targets.data[i];
        vector.push[Instruction](?b.blocks.data[t.block].predecessors, id);
        var j: usize = 0;
        for (j < t.arguments.size) {
            used(?b.values.data[t.arguments.data[j]].uses, id);
            j = j + 1;
        }
        i = i + 1;
    }
    b.instructions.data[b.instructions.len] = d;
    b.instructions.len                      = b.instructions.len + 1;
    ret res[Instruction, Error].ok{id};
}

# a use put at the end of a use list that has room for it
fun used(l: *Growing[Instruction], i: Instruction) {
    l.data[l.len] = i;
    l.len         = l.len + 1;
}

# what an instruction is, its lists valid until the body next changes
pub fun instruction_data(m: *Module, f: Function, i: Instruction) res[InstructionData, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)                 { ret res[InstructionData, Error].err{got.err}; }
    if (!has_instruction(got.ok, i)) { ret res[InstructionData, Error].err{Error.instruction{i}}; }
    ret res[InstructionData, Error].ok{got.ok.instructions.data[i]};
}

# the result of an instruction at a position, none past its last
pub fun result(m: *Module, f: Function, i: Instruction, index: u32) res[opt[Value], Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)                 { ret res[opt[Value], Error].err{got.err}; }
    if (!has_instruction(got.ok, i)) { ret res[opt[Value], Error].err{Error.instruction{i}}; }
    val results: *List[Value] = ?got.ok.instructions.data[i].results;
    if (index::usize >= results.len) { ret res[opt[Value], Error].ok{opt[Value].none{}}; }
    ret res[opt[Value], Error].ok{opt[Value].some{results.data[index]}};
}

# replace an instruction's metadata record whole
#
# the secrecy mark may be raised and never lowered, so the secrecy of a
# declared row's results cannot drift from it. the kept mark likewise may be
# set and never taken off.
pub fun set_metadata(m: *Module, f: Function, i: Instruction, md: Metadata) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err)                                                       { ret err[Error].err{got.err}; }
    if (!has_instruction(got.ok, i))                                       { ret err[Error].err{Error.instruction{i}}; }
    if (got.ok.instructions.data[i].metadata.secret && !md.secret)         { ret err[Error].err{Error.lowered{i}}; }
    if (got.ok.instructions.data[i].metadata.flags.kept && !md.flags.kept) { ret err[Error].err{Error.unkept{i}}; }
    got.ok.instructions.data[i].metadata = md;
    ret err[Error].ok{};
}

# refuse what a record cannot read: a value the body did not give out or has
# removed, or an expression that does not apply to the value's type
fun readable(m: *Module, b: *Body, r: Reads) err[Error] {
    if (!(sel r.operand)) { ret err[Error].ok{}; }
    val v: Value = r.operand.value;
    if (!has_value(b, v)) { ret err[Error].err{Error.value{v}}; }
    val def: Def = b.values.data[v].def;
    if (sel def.removed) { ret err[Error].err{Error.value{v}}; }
    val ty: res[Type, Error] = module.salvaged(m, b.values.data[v].type, r.operand.expression);
    if (sel ty.err) { ret err[Error].err{ty.err}; }
    ret err[Error].ok{};
}

# room in the bound list of the value a record reads
fun bound_room(b: *Body, r: Reads) err[allocator.Error] {
    if (!(sel r.operand)) { ret err[allocator.Error].ok{}; }
    val room: res[usize, allocator.Error] = vector.reserve[u32](?b.values.data[r.operand.value].bound, 1);
    if (sel room.err) { ret err[allocator.Error].err{room.err}; }
    ret err[allocator.Error].ok{};
}

# bind a variable at a point of a block, for mirl.build alone
#
# the record stands just before the instruction at position at, after the
# records already there, or at the block's end when at is the block's length.
# reading a value is no use of it.
# ---
# m:       the module
# f:       the function
# k:       the block
# at:      the position of the instruction it stands before
# binding: the variable, an entry of the module's debug table
# piece:   the bits of the variable it gives, point.WHOLE for all of them
# reads:   what it gives them from its point on
# ret:     ok, or why it was refused
pub fun builder_bind(m: *Module, f: Function, k: Block, at: u32, binding: Binding, piece: Bits, reads: Reads) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    val d: *BlockData = ?b.blocks.data[k];
    if (at::usize > d.instructions.len) { ret err[Error].err{Error.position{at}}; }
    val known: res[record.Variable, debug_table.Error] = place.variable(?m.debug, binding);
    if (sel known.err) { ret err[Error].err{Error.binding{binding}}; }
    val valid: err[Error] = readable(m, b, reads);
    if (sel valid.err) { ret valid; }
    val room: res[usize, allocator.Error] = vector.reserve[Point](?b.points, 1);
    if (sel room.err) { ret refuse(room.err); }
    val spot: err[allocator.Error] = bound_room(b, reads);
    if (sel spot.err) { ret refuse(spot.err); }

    val r: u32 = b.points.len::u32;
    vector.push[Point](?b.points, Point{binding: binding, piece: piece, reads: reads, next: 0});
    val one: Run = Run{first: r + 1, last: r + 1};
    if (at::usize < d.instructions.len) {
        val i: *InstructionData = ?b.instructions.data[d.instructions.data[at]];
        i.points = join(b, i.points, one);
    }
    or                     { d.ending = join(b, d.ending, one); }
    if (sel reads.operand) { vector.push[u32](?b.values.data[reads.operand.value].bound, r); }
    ret err[Error].ok{};
}

# give a record what it reads from now on, its point and variable kept, so a
# pass salvages a record whose value is going or makes it unavailable
# ---
# m:     the module
# f:     the function
# r:     the record's position among the body's records, as a value's bound
#        list names it
# reads: what it gives the variable from its point on
# ret:   ok, or why it was refused
pub fun rebind(m: *Module, f: Function, r: u32, reads: Reads) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (r::usize >= b.points.len) { ret err[Error].err{Error.point{r}}; }
    val valid: err[Error] = readable(m, b, reads);
    if (sel valid.err) { ret valid; }
    val spot: err[allocator.Error] = bound_room(b, reads);
    if (sel spot.err) { ret refuse(spot.err); }
    val old: opt[Value] = point.read(b.points.data[r].reads);
    if (sel old.some) { drop_record(?b.values.data[old.some].bound, r); }
    b.points.data[r].reads = reads;
    if (sel reads.operand) { vector.push[u32](?b.values.data[reads.operand.value].bound, r); }
    ret err[Error].ok{};
}

# the run that ends at a record, given the record after it now ends it
fun ended(b: *Body, last: u32, now: u32) {
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (b.blocks.data[k].ending.last == last) {
            b.blocks.data[k].ending.last = now;
            ret;
        }
        k = k + 1;
    }
    k = 0;
    for (k < b.instructions.len) {
        if (b.instructions.data[k].points.last == last) {
            b.instructions.data[k].points.last = now;
            ret;
        }
        k = k + 1;
    }
}

# how many parts from `from` on read a value
fun reading(parts: Slice[Part], from: usize, v: Value) usize {
    var n: usize = 0;
    var i: usize = from;
    for (i < parts.size) {
        val r: Reads = parts.data[i].reads;
        if (sel r.operand && r.operand.value == v) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# split a record into the parts of a composite binding at its point, as a pass
# that splits the value it reads into several does, so no part is lost to the
# split
#
# the record gives the first part and each other part is a record of its own
# just after it, in order, of the same variable, so a pass later rewrites or
# salvages one part and leaves the others.
# ---
# m:     the module
# f:     the function
# r:     the record's position among the body's records
# parts: the parts, at least one, no two sharing a bit
# ret:   ok, or why it was refused, the body left as it was
pub fun split(m: *Module, f: Function, r: u32, parts: Slice[Part]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (r::usize >= b.points.len) { ret err[Error].err{Error.point{r}}; }
    if (parts.size == 0)          { ret err[Error].err{Error.piece{r}}; }
    var i: usize = 0;
    for (i < parts.size) {
        val valid: err[Error] = readable(m, b, parts.data[i].reads);
        if (sel valid.err) { ret valid; }
        var j: usize = i + 1;
        for (j < parts.size) {
            if (point.overlap(parts.data[i].piece, parts.data[j].piece)) { ret err[Error].err{Error.piece{r}}; }
            j = j + 1;
        }
        i = i + 1;
    }
    val room: res[usize, allocator.Error] = vector.reserve[Point](?b.points, parts.size - 1);
    if (sel room.err) { ret refuse(room.err); }
    i = 0;
    for (i < parts.size) {
        val read: Reads = parts.data[i].reads;
        if (sel read.operand) {
            val v: Value = read.operand.value;
            if (reading(parts, 0, v) == reading(parts, i, v)) {
                val spot: res[usize, allocator.Error] = vector.reserve[u32](?b.values.data[v].bound, reading(parts, 0, v));
                if (sel spot.err) { ret refuse(spot.err); }
            }
        }
        i = i + 1;
    }
    val old: opt[Value] = point.read(b.points.data[r].reads);
    if (sel old.some) { drop_record(?b.values.data[old.some].bound, r); }
    val binding: Binding = b.points.data[r].binding;
    var prev:    u32     = r;
    i = 0;
    for (i < parts.size) {
        val read: Reads = parts.data[i].reads;
        var at:   u32   = r;
        if (i == 0) {
            b.points.data[r].piece = parts.data[0].piece;
            b.points.data[r].reads = read;
        }
        or {
            at = b.points.len::u32;
            val next: u32 = b.points.data[prev].next;
            vector.push[Point](?b.points, Point{binding: binding, piece: parts.data[i].piece, reads: read, next: next});
            b.points.data[prev].next = at + 1;
            if (next == 0) { ended(b, prev + 1, at + 1); }
            prev = at;
        }
        if (sel read.operand) { vector.push[u32](?b.values.data[read.operand.value].bound, at); }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the step that gives an instruction's result from its first operand, by the
# step row that names its opcode, or none
fun step_for(b: *Body, d: *InstructionData, result: Value, from: *Value) opt[Step] {
    var k: u32 = 0;
    for (k::usize < point.rows()) {
        val found: opt[point.Row] = point.row(k);
        if (sel found.some) {
            val row:   point.Row   = found.some;
            val kind:  point.Kind  = k;
            val takes: point.Takes = row.takes;
            if (row.opcode == d.opcode && sel takes.to && d.operands.len == 1) {
                @from = d.operands.data[0];
                ret opt[Step].some{Step{kind: kind, argument: point.Argument.to{b.values.data[result].type}}};
            }
            if (row.opcode == d.opcode && sel takes.constant && d.operands.len == 2) {
                val second: Def = b.values.data[d.operands.data[1]].def;
                val first:  Def = b.values.data[d.operands.data[0]].def;
                if (sel second.constant) {
                    @from = d.operands.data[0];
                    ret opt[Step].some{Step{kind: kind, argument: point.Argument.constant{second.constant}}};
                }
                or (sel first.constant) {
                    if (row.swaps) {
                        @from = d.operands.data[1];
                        ret opt[Step].some{Step{kind: kind, argument: point.Argument.constant{first.constant}}};
                    }
                }
            }
        }
        k = k + 1;
    }
    ret opt[Step].none{};
}

# what a record reads once the instruction defining its value goes: the same
# variable through a step over that instruction's first operand, by the step
# row that names its opcode, before the steps it already had, or unavailable
# when no row applies or it reads no instruction's result
#
# the operand dominates the instruction, which dominates the record, so the
# salvaged record stands where the record stood. the caller rebinds it.
# ---
# m:   the module
# f:   the function
# r:   what the record reads
# ret: what it reads salvaged, or why the expression could not be made
pub fun salvage(m: *Module, f: Function, r: Reads) res[Reads, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Reads, Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!(sel r.operand)) { ret res[Reads, Error].ok{Reads.unavailable{}}; }
    val v: Value = r.operand.value;
    if (!has_value(b, v)) { ret res[Reads, Error].err{Error.value{v}}; }
    val def: Def = b.values.data[v].def;
    if (!(sel def.result)) { ret res[Reads, Error].ok{Reads.unavailable{}}; }
    var from: Value     = v;
    val step: opt[Step] = step_for(b, ?b.instructions.data[def.result.instruction], v, ?from);
    if (sel step.none) { ret res[Reads, Error].ok{Reads.unavailable{}}; }
    val had: res[Slice[Step], Error] = module.steps(m, r.operand.expression);
    if (sel had.err) { ret res[Reads, Error].err{had.err}; }
    var steps: vector.Vector[Step] = vector.init[Step](m.a);
    fin { vector.dnit[Step](?steps); }
    val room: res[usize, allocator.Error] = vector.reserve[Step](?steps, had.ok.size + 1);
    if (sel room.err) { ret fail[Reads](room.err); }
    vector.push[Step](?steps, step.some);
    var i: usize = 0;
    for (i < had.ok.size) {
        vector.push[Step](?steps, had.ok.data[i]);
        i = i + 1;
    }
    val e: res[Expression, Error] = module.expression(m, Slice[Step]{data: steps.data, size: steps.len});
    if (sel e.err) { ret res[Reads, Error].err{e.err}; }
    ret res[Reads, Error].ok{Reads.operand{Operand{value: from, expression: e.ok}}};
}

fun detached(b: *Body, i: Instruction) err[Error] {
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val at: Place = b.instructions.data[i].place;
    if (sel at.placed) { ret err[Error].err{Error.placed{i}}; }
    if (sel at.erased) { ret err[Error].err{Error.erased{i}}; }
    ret err[Error].ok{};
}

fun placed(b: *Body, i: Instruction) res[Block, Error] {
    if (!has_instruction(b, i)) { ret res[Block, Error].err{Error.instruction{i}}; }
    val at: Place = b.instructions.data[i].place;
    if (sel at.erased) { ret res[Block, Error].err{Error.erased{i}}; }
    if (sel at.placed) { ret res[Block, Error].ok{at.placed}; }
    ret res[Block, Error].err{Error.detached{i}};
}

# the position of a placed instruction in its block's list
fun slot(b: *Body, k: Block, i: Instruction) usize {
    val list_of: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    var p:       usize                       = 0;
    for (p < list_of.len && list_of.data[p] != i) { p = p + 1; }
    ret p;
}

# place a detached instruction at the end of a block, after the records there
pub fun append(m: *Module, f: Function, k: Block, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    val free: err[Error] = detached(b, i);
    if (sel free.err) { ret free; }
    val pushed: res[usize, allocator.Error] = vector.push[Instruction](?b.blocks.data[k].instructions, i);
    if (sel pushed.err) { ret refuse(pushed.err); }
    b.instructions.data[i].points = join(b, b.instructions.data[i].points, b.blocks.data[k].ending);
    b.blocks.data[k].ending       = no_run();
    b.instructions.data[i].place  = Place.placed{k};
    ret err[Error].ok{};
}

# place a detached instruction just before a placed one, after the records
# standing before it, which stand before the new one from then on
pub fun insert(m: *Module, f: Function, before: Instruction, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, before);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val free: err[Error] = detached(b, i);
    if (sel free.err) { ret free; }
    ret put_at(b, at.ok, slot(b, at.ok, before), i);
}

# place a detached instruction at a position of a block's list, just before
# the one there, after the records standing before it, which stand before
# the new one from then on, as `insert` places it before that one
# ---
# m:     the module
# f:     the function
# k:     the block
# index: the position, below the block's count of instructions
# i:     the instruction
# ret:   ok, or why it was not placed
pub fun insert_at(m: *Module, f: Function, k: Block, index: u32, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err)                                      { ret open; }
    if (index::usize >= b.blocks.data[k].instructions.len) { ret err[Error].err{Error.position{i}}; }
    val free: err[Error] = detached(b, i);
    if (sel free.err) { ret free; }
    ret put_at(b, k, index::usize, i);
}

fun put_at(b: *Body, k: Block, p: usize, i: Instruction) err[Error] {
    val list_of: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    val room:    res[usize, allocator.Error] = vector.reserve[Instruction](list_of, 1);
    if (sel room.err) { ret refuse(room.err); }
    val before: Instruction = list_of.data[p];
    var n:      usize       = list_of.len;
    for (n > p) {
        list_of.data[n] = list_of.data[n - 1];
        n               = n - 1;
    }
    list_of.data[p] = i;
    vector.commit[Instruction](list_of, 1);
    b.instructions.data[i].place       = Place.placed{k};
    b.instructions.data[i].points      = join(b, b.instructions.data[i].points, b.instructions.data[before].points);
    b.instructions.data[before].points = no_run();
    ret err[Error].ok{};
}

# move the records standing before one placed instruction to stand before a
# later one of its block, ahead of the records already there, as a pass that
# builds a value at the head of a block makes its variables read it from
# where it is built. the edit checks no dominance, and the verifier refuses a
# record whose value does not stand at its new point
# ---
# m:    the module
# f:    the function
# from: the placed instruction the records stand before
# to:   a placed instruction after it in its block
# ret:  ok, or why it was refused
pub fun hand(m: *Module, f: Function, from: Instruction, to: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body             = got.ok;
    val here: res[Block, Error] = placed(b, from);
    if (sel here.err) { ret err[Error].err{here.err}; }
    val there: res[Block, Error] = placed(b, to);
    if (sel there.err)                                 { ret err[Error].err{there.err}; }
    if (here.ok != there.ok)                           { ret err[Error].err{Error.position{to}}; }
    if (slot(b, here.ok, to) < slot(b, here.ok, from)) { ret err[Error].err{Error.position{to}}; }
    if (from == to)                                    { ret err[Error].ok{}; }
    b.instructions.data[to].points   = join(b, b.instructions.data[from].points, b.instructions.data[to].points);
    b.instructions.data[from].points = no_run();
    ret err[Error].ok{};
}

# take a record out of the run it stands in, which holds it
fun unlink(b: *Body, run: *Run, r: u32) bool {
    if (run.first == 0) { ret false; }
    if (run.first == r + 1) {
        if (run.last == r + 1) { @run = no_run(); }
        or                     { run.first = b.points.data[r].next; }
        b.points.data[r].next = 0;
        ret true;
    }
    var p: u32 = run.first;
    for (p != 0 && p != run.last) {
        val next: u32 = b.points.data[p - 1].next;
        if (next == r + 1) {
            b.points.data[p - 1].next = b.points.data[r].next;
            if (run.last == r + 1) { run.last = p; }
            b.points.data[r].next = 0;
            ret true;
        }
        p = next;
    }
    ret false;
}

# turn a value binding record into the storage form: its variable is bound to
# the storage an instruction's result addresses, which describes it at every
# point, and the record stands nowhere from then on, so no point reads it as
# unavailable. a pass that moves a variable's value into memory does this in
# place of letting its record lose the value
# ---
# m:   the module
# f:   the function
# r:   the record's position among the body's records
# at:  the placed instruction whose result addresses the storage
# ret: ok, or why it was refused, the body left as it was
pub fun store_binding(m: *Module, f: Function, r: u32, at: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:     *Body             = got.ok;
    val where: res[Block, Error] = placed(b, at);
    if (sel where.err)            { ret err[Error].err{where.err}; }
    if (r::usize >= b.points.len) { ret err[Error].err{Error.point{r}}; }
    val named: Binding                    = b.points.data[r].binding;
    val had:   res[Slice[Binding], Error] = module.bound(m, b.instructions.data[at].metadata.bindings);
    if (sel had.err) { ret err[Error].err{had.err}; }
    var list: vector.Vector[Binding] = vector.init[Binding](m.a);
    fin { vector.dnit[Binding](?list); }
    val room: res[usize, allocator.Error] = vector.reserve[Binding](?list, had.ok.size + 1);
    if (sel room.err) { ret refuse(room.err); }
    var known: bool  = false;
    var i:     usize = 0;
    for (i < had.ok.size) {
        if (had.ok.data[i] == named) { known = true; }
        vector.push[Binding](?list, had.ok.data[i]);
        i = i + 1;
    }
    if (!known) {
        vector.push[Binding](?list, named);
        val made: res[Bindings, Error] = module.bindings(m, Slice[Binding]{data: list.data, size: list.len});
        if (sel made.err) { ret err[Error].err{made.err}; }
        b.instructions.data[at].metadata.bindings = made.ok;
    }
    var taken: bool  = false;
    var k:     usize = 0;
    for (k < b.blocks.len && !taken) {
        if (!b.blocks.data[k].erased) {
            taken = unlink(b, ?b.blocks.data[k].ending, r);
            var p: usize = 0;
            for (p < b.blocks.data[k].instructions.len && !taken) {
                taken = unlink(b, ?b.instructions.data[b.blocks.data[k].instructions.data[p]].points, r);
                p     = p + 1;
            }
        }
        k = k + 1;
    }
    val old: opt[Value] = point.read(b.points.data[r].reads);
    if (sel old.some) { drop_record(?b.values.data[old.some].bound, r); }
    b.points.data[r].reads = Reads.unavailable{};
    ret err[Error].ok{};
}

# move a placed instruction to just before another placed one, which must
# stand where the first one's operands already do: the edit checks no
# dominance, and the verifier refuses a body where it does not hold. the
# records standing before the moved instruction stay where they were, before
# the instruction after it, and the records standing before the other one stand
# before the moved one from then on. a record that reads a result keeps reading
# it, since the result stands at every point the moved instruction dominated.
# ---
# m:      the module
# f:      the function
# i:      the placed instruction, not kept and not a terminator
# before: the placed instruction it goes before, another one, and an
#         instruction asked to go before itself stays
# ret:    ok, or why it was refused, the body left as it was
pub fun relocate(m: *Module, f: Function, i: Instruction, before: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body             = got.ok;
    val from: res[Block, Error] = placed(b, i);
    if (sel from.err) { ret err[Error].err{from.err}; }
    val to: res[Block, Error] = placed(b, before);
    if (sel to.err)                                 { ret err[Error].err{to.err}; }
    if (i == before)                                { ret err[Error].ok{}; }
    if (b.instructions.data[i].metadata.flags.kept) { ret err[Error].err{Error.unkept{i}}; }
    if (b.instructions.data[i].edges.len != 0)      { ret err[Error].err{Error.terminator{i}}; }
    val dst:  *vector.Vector[Instruction] = ?b.blocks.data[to.ok].instructions;
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](dst, 1);
    if (sel room.err) { ret refuse(room.err); }

    val d:   *InstructionData            = ?b.instructions.data[i];
    val src: *vector.Vector[Instruction] = ?b.blocks.data[from.ok].instructions;
    val p:   usize                       = slot(b, from.ok, i);
    val run: Run                         = d.points;
    d.points = no_run();
    if (p + 1 < src.len) {
        val next: *InstructionData = ?b.instructions.data[src.data[p + 1]];
        next.points = join(b, run, next.points);
    }
    or { b.blocks.data[from.ok].ending = join(b, run, b.blocks.data[from.ok].ending); }
    remove_at[Instruction](src, p);

    val at: usize = slot(b, to.ok, before);
    var k:  usize = dst.len;
    for (k > at) {
        dst.data[k] = dst.data[k - 1];
        k           = k - 1;
    }
    dst.data[at] = i;
    vector.commit[Instruction](dst, 1);
    d.place                            = Place.placed{to.ok};
    d.points                           = b.instructions.data[before].points;
    b.instructions.data[before].points = no_run();
    ret err[Error].ok{};
}

# what a replacement does with the records that read the value it replaces
# ---
# follow:      the new value's definition dominates the old one's, so it stands
#              at every point a record of the old one does, and the records
#              read it from then on
# unavailable: nothing is known of where the new value stands, so the records
#              become unavailable at their points
pub tag Records: u8 {
    follow;
    unavailable;
}

# replace every use of a value by another value of the same type
#
# a record that reads the old value reads the new one when the new one is a
# constant, which stands everywhere, or when records says follow, and becomes
# unavailable otherwise. a record never refuses a replacement.
# ---
# m:       the module
# f:       the function
# old:     the value replaced
# new:     the value that takes its uses
# records: what the records reading old do
# ret:     ok, or why it was refused
pub fun replace(m: *Module, f: Function, old: Value, new: Value, records: Records) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_value(b, old)) { ret err[Error].err{Error.value{old}}; }
    if (!has_value(b, new)) { ret err[Error].err{Error.value{new}}; }
    if (!table.same(b.values.data[old].type, b.values.data[new].type)) {
        ret err[Error].err{Error.mismatch{b.values.data[new].type}};
    }
    if (old == new)                                              { ret err[Error].ok{}; }
    if (b.values.data[new].secret && !b.values.data[old].secret) { ret err[Error].err{Error.secret{new}}; }
    val def:    Def  = b.values.data[new].def;
    val follow: bool = sel records.follow || sel def.constant;
    if (follow) {
        val room: err[allocator.Error] = room_to_move(b, old, new);
        if (sel room.err) { ret refuse(room.err); }
    }
    or {
        val room: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[new].uses, b.values.data[old].uses.len);
        if (sel room.err) { ret refuse(room.err); }
        unbind(b, old);
    }
    move_uses(b, old, new);
    ret err[Error].ok{};
}

# move one instruction's uses of a value, as operands and as arguments, to
# another value
# ---
# m:   the module
# f:   the function
# i:   the instruction, which uses old
# old: the value it stops using
# new: the value it uses in old's place, of old's type and no more secret
# ret: ok, or why it was refused
pub fun substitute(m: *Module, f: Function, i: Instruction, old: Value, new: Value) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    if (!has_value(b, old))     { ret err[Error].err{Error.value{old}}; }
    if (!has_value(b, new))     { ret err[Error].err{Error.value{new}}; }
    if (!table.same(b.values.data[old].type, b.values.data[new].type)) {
        ret err[Error].err{Error.mismatch{b.values.data[new].type}};
    }
    if (old == new)                                              { ret err[Error].ok{}; }
    if (b.values.data[new].secret && !b.values.data[old].secret) { ret err[Error].err{Error.secret{new}}; }
    val d:    *InstructionData = ?b.instructions.data[i];
    var many: usize            = 0;
    var k:    usize            = 0;
    for (k < d.operands.len) {
        if (d.operands.data[k] == old) { many = many + 1; }
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val args: *List[Value] = ?d.edges.data[e].arguments;
        k = 0;
        for (k < args.len) {
            if (args.data[k] == old) { many = many + 1; }
            k = k + 1;
        }
        e = e + 1;
    }
    val room: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[new].uses, many);
    if (sel room.err) { ret refuse(room.err); }
    k = 0;
    for (k < d.operands.len) {
        if (d.operands.data[k] == old) {
            d.operands.data[k] = new;
            drop_use(?b.values.data[old].uses, i);
            pool.push[Instruction](?b.lists, ?b.values.data[new].uses, i);
        }
        k = k + 1;
    }
    e = 0;
    for (e < d.edges.len) {
        val args: *List[Value] = ?d.edges.data[e].arguments;
        k = 0;
        for (k < args.len) {
            if (args.data[k] == old) {
                args.data[k] = new;
                drop_use(?b.values.data[old].uses, i);
                pool.push[Instruction](?b.lists, ?b.values.data[new].uses, i);
            }
            k = k + 1;
        }
        e = e + 1;
    }
    ret err[Error].ok{};
}

# move every use and record of old to new, whose lists have room for them
fun move_uses(b: *Body, old: Value, new: Value) {
    move_reads(b, old, new);
    val count: usize = b.values.data[old].uses.len;
    var k:     usize = 0;
    for (k < count) {
        val user: Instruction      = b.values.data[old].uses.data[k];
        val d:    *InstructionData = ?b.instructions.data[user];
        var done: bool             = false;
        var i:    usize            = 0;
        for (!done && i < d.operands.len) {
            if (d.operands.data[i] == old) {
                d.operands.data[i] = new;
                done               = true;
            }
            i = i + 1;
        }
        var e: usize = 0;
        for (!done && e < d.edges.len) {
            val args: *List[Value] = ?d.edges.data[e].arguments;
            var j:    usize        = 0;
            for (!done && j < args.len) {
                if (args.data[j] == old) {
                    args.data[j] = new;
                    done         = true;
                }
                j = j + 1;
            }
            e = e + 1;
        }
        pool.push[Instruction](?b.lists, ?b.values.data[new].uses, user);
        k = k + 1;
    }
    b.values.data[old].uses.len = 0;
}

fun is_result(d: *InstructionData, v: Value) bool {
    var k: usize = 0;
    for (k < d.results.len) {
        if (d.results.data[k] == v) { ret true; }
        k = k + 1;
    }
    ret false;
}

# an instruction that uses one of the results of another
fun uses_result(user: *InstructionData, of: *InstructionData) opt[Value] {
    var i: usize = 0;
    for (i < user.operands.len) {
        if (is_result(of, user.operands.data[i])) { ret opt[Value].some{user.operands.data[i]}; }
        i = i + 1;
    }
    var e: usize = 0;
    for (e < user.edges.len) {
        val args: *List[Value] = ?user.edges.data[e].arguments;
        var j:    usize        = 0;
        for (j < args.len) {
            if (is_result(of, args.data[j])) { ret opt[Value].some{args.data[j]}; }
            j = j + 1;
        }
        e = e + 1;
    }
    ret opt[Value].none{};
}

fun listed(items: Slice[Instruction], i: Instruction) bool {
    var k: usize = 0;
    for (k < items.size) {
        if (items.data[k] == i) { ret true; }
        k = k + 1;
    }
    ret false;
}

# take an instruction whose results are unused out of the body, its records
# left to the instruction after it and those reading its results unavailable
fun take_out(b: *Body, i: Instruction) {
    val d:  *InstructionData = ?b.instructions.data[i];
    val at: Place            = d.place;
    if (sel at.placed) {
        val list_of: *vector.Vector[Instruction] = ?b.blocks.data[at.placed].instructions;
        val p:       usize                       = slot(b, at.placed, i);
        val run:     Run                         = d.points;
        d.points = no_run();
        if (p + 1 < list_of.len) {
            val next: *InstructionData = ?b.instructions.data[list_of.data[p + 1]];
            next.points = join(b, run, next.points);
        }
        or { b.blocks.data[at.placed].ending = join(b, run, b.blocks.data[at.placed].ending); }
        remove_at[Instruction](list_of, p);
    }
    var k: usize = 0;
    for (k < d.operands.len) {
        drop_use(?b.values.data[d.operands.data[k]].uses, i);
        k = k + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        drop_one(?b.blocks.data[edge.block].predecessors, i);
        var j: usize = 0;
        for (j < edge.arguments.len) {
            drop_use(?b.values.data[edge.arguments.data[j]].uses, i);
            j = j + 1;
        }
        e = e + 1;
    }
    k = 0;
    for (k < d.results.len) {
        unbind(b, d.results.data[k]);
        b.values.data[d.results.data[k]].def = Def.removed{};
        k                                    = k + 1;
    }
    d.place = Place.erased{};
}

# take an instruction out of its body: out of its block, the use list of
# every value it uses and the predecessor list of every block it branches to
#
# the records standing before it stand before the instruction after it, or at
# the block's end, and every record that reads one of its results becomes
# unavailable at its point. its record stays, erased, so the ids given out
# stay valid.
# ---
# a placed kept instruction is never erased alone. it goes only with a block
# that cannot run, through `erase_unreached`. a detached one was never part of
# the program and may go.
# ---
# m:   the module
# f:   the function
# i:   the instruction, whose results must have no uses
# ret: ok, or why it was refused
pub fun erase(m: *Module, f: Function, i: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val d: *InstructionData = ?b.instructions.data[i];
    if (sel d.place.erased)                          { ret err[Error].err{Error.erased{i}}; }
    if (sel d.place.placed && d.metadata.flags.kept) { ret err[Error].err{Error.unkept{i}}; }
    var k: usize = 0;
    for (k < d.results.len) {
        val r: Value = d.results.data[k];
        if (b.values.data[r].uses.len != 0) { ret err[Error].err{Error.used{r}}; }
        k = k + 1;
    }
    take_out(b, i);
    ret err[Error].ok{};
}

# the place of a value known to be a block parameter
fun param_of(b: *Body, v: Value) Parameter {
    val def: Def = b.values.data[v].def;
    if (sel def.parameter) { ret def.parameter; }
    ret Parameter{block: 0, index: 0};
}

# whether every use of a value is by an instruction taken out, or is the
# argument an edge passes for a parameter taken out
fun only_dead_use(b: *Body, v: Value, items: Slice[Instruction], dead: Slice[Value]) bool {
    var covered: usize                 = 0;
    val uses:    *Growing[Instruction] = ?b.values.data[v].uses;
    var u:       usize                 = 0;
    for (u < uses.len) {
        if (listed(items, uses.data[u])) { covered = covered + 1; }
        u = u + 1;
    }
    var c: usize = 0;
    for (c < dead.size) {
        val q:  Parameter  = param_of(b, dead.data[c]);
        val qd: *BlockData = ?b.blocks.data[q.block];
        var i:  usize      = 0;
        for (i < qd.predecessors.len) {
            if (!listed(items, qd.predecessors.data[i])) {
                if (edge_of(b, q.block, i).arguments.data[q.index] == v) { covered = covered + 1; }
            }
            i = i + 1;
        }
        c = c + 1;
    }
    ret covered == uses.len;
}

# take instructions and block parameters out of the body together, which only
# each other use
#
# a result or parameter may be used by an instruction taken out, or as the
# argument an edge passes for a parameter taken out, so values that only feed
# each other leave together. the arguments of the parameters go from every edge
# into their blocks. a placed kept instruction is refused, as `erase` refuses
# it.
# ---
# m:     the module
# f:     the function
# items: the instructions, each placed or detached and listed once
# dead:  the parameters, of blocks that have not been erased, listed once
# ret:   ok, or why it was refused with the body left as it was
pub fun remove_dead(m: *Module, f: Function, items: Slice[Instruction], dead: Slice[Value]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    var n: usize = 0;
    for (n < items.size) {
        val i: Instruction = items.data[n];
        if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
        val at: Place = b.instructions.data[i].place;
        if (sel at.erased)                                               { ret err[Error].err{Error.erased{i}}; }
        if (sel at.placed && b.instructions.data[i].metadata.flags.kept) { ret err[Error].err{Error.unkept{i}}; }
        var k: usize = 0;
        for (k < n) {
            if (items.data[k] == i) { ret err[Error].err{Error.erased{i}}; }
            k = k + 1;
        }
        n = n + 1;
    }
    n = 0;
    for (n < dead.size) {
        val p: Value = dead.data[n];
        if (!has_value(b, p)) { ret err[Error].err{Error.value{p}}; }
        val def: Def = b.values.data[p].def;
        if (!(sel def.parameter)) { ret err[Error].err{Error.value{p}}; }
        val open: err[Error] = live(b, def.parameter.block);
        if (sel open.err) { ret open; }
        var k: usize = 0;
        for (k < n) {
            if (dead.data[k] == p) { ret err[Error].err{Error.value{p}}; }
            k = k + 1;
        }
        n = n + 1;
    }
    n = 0;
    for (n < dead.size) {
        if (!only_dead_use(b, dead.data[n], items, dead)) { ret err[Error].err{Error.used{dead.data[n]}}; }
        n = n + 1;
    }
    n = 0;
    for (n < items.size) {
        val d: *InstructionData = ?b.instructions.data[items.data[n]];
        var k: usize            = 0;
        for (k < d.results.len) {
            if (!only_dead_use(b, d.results.data[k], items, dead)) { ret err[Error].err{Error.used{d.results.data[k]}}; }
            k = k + 1;
        }
        n = n + 1;
    }
    n = 0;
    for (n < dead.size) {
        val at: Parameter = param_of(b, dead.data[n]);
        cut_parameter(b, at.block, at.index);
        n = n + 1;
    }
    n = 0;
    for (n < items.size) {
        take_out(b, items.data[n]);
        n = n + 1;
    }
    ret err[Error].ok{};
}

# put a detached instruction in a placed one's slot, move every use and record
# of each of the placed one's results to the result at the same position, and
# erase the placed one, whose records stand before the new one. a kept one is
# supplanted only by a kept one.
# ---
# m:   the module
# f:   the function
# old: the placed instruction
# new: the detached one, its results as many and of the same types
# ret: ok, or why it was refused
pub fun supplant(m: *Module, f: Function, old: Instruction, new: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, old);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val free: err[Error] = detached(b, new);
    if (sel free.err) { ret free; }
    val od: *InstructionData = ?b.instructions.data[old];
    val nd: *InstructionData = ?b.instructions.data[new];
    if (od.metadata.flags.kept && !nd.metadata.flags.kept) { ret err[Error].err{Error.unkept{old}}; }
    if (od.results.len != nd.results.len)                  { ret err[Error].err{Error.results{nd.results.len::u32}}; }
    var k: usize = 0;
    for (k < od.results.len) {
        val ov: *ValueData = ?b.values.data[od.results.data[k]];
        val nv: *ValueData = ?b.values.data[nd.results.data[k]];
        if (!table.same(ov.type, nv.type)) { ret err[Error].err{Error.mismatch{nv.type}}; }
        if (nv.secret && !ov.secret)       { ret err[Error].err{Error.secret{nd.results.data[k]}}; }
        k = k + 1;
    }
    val loop: opt[Value] = uses_result(nd, od);
    if (sel loop.some) { ret err[Error].err{Error.circular{loop.some}}; }
    k = 0;
    for (k < od.results.len) {
        val room: err[allocator.Error] = room_to_move(b, od.results.data[k], nd.results.data[k]);
        if (sel room.err) { ret refuse(room.err); }
        k = k + 1;
    }

    k = 0;
    for (k < od.results.len) {
        move_uses(b, od.results.data[k], nd.results.data[k]);
        k = k + 1;
    }
    b.blocks.data[at.ok].instructions.data[slot(b, at.ok, old)] = new;
    nd.points                                                   = join(b, nd.points, od.points);
    od.points                                                   = no_run();
    nd.place                                                    = od.place;
    od.place                                                    = Place.detached{};
    take_out(b, old);
    ret err[Error].ok{};
}

# drop the occurrence at position rank among a list's entries naming an instruction
fun drop_nth(v: *vector.Vector[Instruction], i: Instruction, rank: usize) {
    var seen: usize = 0;
    var k:    usize = 0;
    for (k < v.len) {
        if (v.data[k] == i) {
            if (seen == rank) {
                remove_at[Instruction](v, k);
                ret;
            }
            seen = seen + 1;
        }
        k = k + 1;
    }
}

# move an edge of an instruction to another block, passing new arguments
# ---
# m:         the module
# f:         the function
# i:         the instruction
# edge:      the edge's position among the instruction's edges
# to:        the block the edge enters from now on
# arguments: one value per parameter of to, in order
# ret:       ok, or why it was refused
pub fun retarget(m: *Module, f: Function, i: Instruction, edge: u32, to: Block, arguments: Slice[Value]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (!has_instruction(b, i)) { ret err[Error].err{Error.instruction{i}}; }
    val d: *InstructionData = ?b.instructions.data[i];
    if (sel d.place.erased)         { ret err[Error].err{Error.erased{i}}; }
    if (edge::usize >= d.edges.len) { ret err[Error].err{Error.edge{edge}}; }
    val open: err[Error] = live(b, to);
    if (sel open.err) { ret open; }
    val params: *vector.Vector[Value] = ?b.blocks.data[to].parameters;
    if (arguments.size != params.len) { ret err[Error].err{Error.arguments{arguments.size::u32}}; }
    var j: usize = 0;
    for (j < arguments.size) {
        val v: Value = arguments.data[j];
        if (!has_value(b, v)) { ret err[Error].err{Error.value{v}}; }
        val p: *ValueData = ?b.values.data[params.data[j]];
        if (!table.same(b.values.data[v].type, p.type)) { ret err[Error].err{Error.mismatch{b.values.data[v].type}}; }
        if (b.values.data[v].secret && !p.secret)       { ret err[Error].err{Error.secret{v}}; }
        j = j + 1;
    }

    val e:    *Edge                       = ?d.edges.data[edge];
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](?b.blocks.data[to].predecessors, 1);
    if (sel room.err) { ret refuse(room.err); }
    j = 0;
    for (j < arguments.size) {
        var same: usize = 0;
        var k:    usize = 0;
        for (k < arguments.size) {
            if (arguments.data[k] == arguments.data[j]) { same = same + 1; }
            k = k + 1;
        }
        val uses: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[arguments.data[j]].uses, same);
        if (sel uses.err) { ret refuse(uses.err); }
        j = j + 1;
    }
    val args: err[allocator.Error] = pool.ensure[Value](?b.lists, arguments.size);
    if (sel args.err) { ret refuse(args.err); }

    val old:  Block = e.block;
    var rank: usize = 0;
    var k:    usize = 0;
    for (k < edge::usize) {
        if (d.edges.data[k].block == old) { rank = rank + 1; }
        k = k + 1;
    }
    drop_nth(?b.blocks.data[old].predecessors, i, rank);
    j = 0;
    for (j < e.arguments.len) {
        drop_use(?b.values.data[e.arguments.data[j]].uses, i);
        j = j + 1;
    }
    e.arguments = held(b, arguments);
    j           = 0;
    for (j < arguments.size) {
        pool.push[Instruction](?b.lists, ?b.values.data[arguments.data[j]].uses, i);
        j = j + 1;
    }
    e.block = to;
    vector.push[Instruction](?b.blocks.data[to].predecessors, i);
    ret err[Error].ok{};
}

# move the instructions of a block from a position on to the end of another,
# with the records standing before them and at the block's end, after the
# records at the other's end
# ---
# m:    the module
# f:    the function
# from: the block they leave
# at:   the position of the first instruction moved
# to:   the block they join, in order
# ret:  ok, or why it was refused
pub fun move(m: *Module, f: Function, from: Block, at: u32, to: Block) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:      *Body      = got.ok;
    val source: err[Error] = live(b, from);
    if (sel source.err) { ret source; }
    val target: err[Error] = live(b, to);
    if (sel target.err) { ret target; }
    if (from == to)     { ret err[Error].err{Error.same{from}}; }
    val src: *vector.Vector[Instruction] = ?b.blocks.data[from].instructions;
    if (at::usize > src.len) { ret err[Error].err{Error.position{at}}; }
    val dst:  *vector.Vector[Instruction] = ?b.blocks.data[to].instructions;
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](dst, src.len - at::usize);
    if (sel room.err) { ret refuse(room.err); }
    val to_end: *Run = ?b.blocks.data[to].ending;
    val leaves: *Run = ?b.blocks.data[from].ending;
    if (at::usize < src.len) {
        val lead: *InstructionData = ?b.instructions.data[src.data[at]];
        lead.points = join(b, @to_end, lead.points);
        @to_end     = @leaves;
    }
    or { @to_end = join(b, @to_end, @leaves); }
    @leaves = no_run();
    var k: usize = at::usize;
    for (k < src.len) {
        vector.push[Instruction](dst, src.data[k]);
        b.instructions.data[src.data[k]].place = Place.placed{to};
        k                                      = k + 1;
    }
    vector.truncate[Instruction](src, at::usize);
    ret err[Error].ok{};
}

# take a block out of its body, its parameters with it
#
# every record that reads a parameter becomes unavailable, and the records the
# block holds go with it, since it holds no point any more. its record stays,
# erased, so the ids given out stay valid.
# ---
# m:   the module
# f:   the function
# k:   the block, entered by no edge, holding no instruction and with no
#      parameter in use
# ret: ok, or why it was refused
pub fun erase_block(m: *Module, f: Function, k: Block) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:    *Body      = got.ok;
    val open: err[Error] = live(b, k);
    if (sel open.err) { ret open; }
    if (k == 0)       { ret err[Error].err{Error.entry{}}; }
    val d: *BlockData = ?b.blocks.data[k];
    if (d.predecessors.len != 0) { ret err[Error].err{Error.reached{k}}; }
    if (d.instructions.len != 0) { ret err[Error].err{Error.occupied{k}}; }
    var i: usize = 0;
    for (i < d.parameters.len) {
        val p: Value = d.parameters.data[i];
        if (b.values.data[p].uses.len != 0) { ret err[Error].err{Error.used{p}}; }
        i = i + 1;
    }
    drop_block(b, k);
    ret err[Error].ok{};
}

# mark an empty block erased, its parameters removed and its records gone
fun drop_block(b: *Body, k: Block) {
    val d: *BlockData = ?b.blocks.data[k];
    var i: usize      = 0;
    for (i < d.parameters.len) {
        unbind(b, d.parameters.data[i]);
        b.values.data[d.parameters.data[i]].def = Def.removed{};
        i                                       = i + 1;
    }
    var r: u32 = d.ending.first;
    for (r != 0) {
        val pt: *Point     = ?b.points.data[r - 1];
        val v:  opt[Value] = point.read(pt.reads);
        if (sel v.some) { drop_record(?b.values.data[v.some].bound, r - 1); }
        pt.reads = Reads.unavailable{};
        r        = pt.next;
    }
    d.ending = no_run();
    d.erased = true;
}

# whether every use of a value is by an instruction placed in a marked block
fun used_within(b: *Body, v: Value, marked: *vector.Vector[bool]) bool {
    val uses: *Growing[Instruction] = ?b.values.data[v].uses;
    var u:    usize                 = 0;
    for (u < uses.len) {
        val at: Place = b.instructions.data[uses.data[u]].place;
        if (!(sel at.placed && marked.data[at.placed])) { ret false; }
        u = u + 1;
    }
    ret true;
}

# take a set of blocks out of the body with every instruction they hold
#
# no edge from outside the set enters it and the entry is not in it, so no
# path from the entry reaches any of its instructions and none of them can
# run. a kept instruction goes with them, since it never runs. the set's
# values may use each other in any order, and no instruction outside it uses
# one.
# ---
# m:      the module
# f:      the function
# blocks: the blocks, each listed once and not erased
# ret:    ok, or why it was refused with the body left as it was
pub fun erase_unreached(m: *Module, f: Function, blocks: Slice[Block]) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:      *Body               = got.ok;
    var marked: vector.Vector[bool] = vector.init[bool](m.a);
    fin { vector.dnit[bool](?marked); }
    val room: res[usize, allocator.Error] = vector.reserve[bool](?marked, b.blocks.len);
    if (sel room.err) { ret refuse(room.err); }
    var n: usize = 0;
    for (n < b.blocks.len) {
        vector.push[bool](?marked, false);
        n = n + 1;
    }
    n = 0;
    for (n < blocks.size) {
        val k:    Block      = blocks.data[n];
        val open: err[Error] = live(b, k);
        if (sel open.err)   { ret open; }
        if (k == 0)         { ret err[Error].err{Error.entry{}}; }
        if (marked.data[k]) { ret err[Error].err{Error.removed{k}}; }
        marked.data[k] = true;
        n              = n + 1;
    }
    n = 0;
    for (n < blocks.size) {
        val d: *BlockData = ?b.blocks.data[blocks.data[n]];
        var i: usize      = 0;
        for (i < d.predecessors.len) {
            val at: Place = b.instructions.data[d.predecessors.data[i]].place;
            if (!(sel at.placed && marked.data[at.placed])) { ret err[Error].err{Error.reached{blocks.data[n]}}; }
            i = i + 1;
        }
        i = 0;
        for (i < d.parameters.len) {
            if (!used_within(b, d.parameters.data[i], ?marked)) { ret err[Error].err{Error.used{d.parameters.data[i]}}; }
            i = i + 1;
        }
        i = 0;
        for (i < d.instructions.len) {
            val inst: *InstructionData = ?b.instructions.data[d.instructions.data[i]];
            var r:    usize            = 0;
            for (r < inst.results.len) {
                if (!used_within(b, inst.results.data[r], ?marked)) { ret err[Error].err{Error.used{inst.results.data[r]}}; }
                r = r + 1;
            }
            i = i + 1;
        }
        n = n + 1;
    }
    n = 0;
    for (n < blocks.size) {
        val list: *vector.Vector[Instruction] = ?b.blocks.data[blocks.data[n]].instructions;
        for (list.len > 0) { take_out(b, list.data[list.len - 1]); }
        n = n + 1;
    }
    n = 0;
    for (n < blocks.size) {
        drop_block(b, blocks.data[n]);
        n = n + 1;
    }
    ret err[Error].ok{};
}

# put the block one branch alone enters in that branch's place: every use and
# record of its parameters moves to the argument the edge passes, the branch
# is erased, the block's instructions take its slot with its records after the
# branch's, and the block is erased
# ---
# m:    the module
# f:    the function
# jump: a placed instruction of one edge and no used result, the only edge
#       into a block other than its own and the entry
# ret:  ok, or why it was refused, the body left as it was
pub fun splice(m: *Module, f: Function, jump: Instruction) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b:  *Body             = got.ok;
    val at: res[Block, Error] = placed(b, jump);
    if (sel at.err) { ret err[Error].err{at.err}; }
    val into: Block            = at.ok;
    val d:    *InstructionData = ?b.instructions.data[jump];
    if (d.edges.len != 1) { ret err[Error].err{Error.edge{d.edges.len::u32}}; }
    val k:    Block      = d.edges.data[0].block;
    val open: err[Error] = live(b, k);
    if (sel open.err)                           { ret open; }
    if (k == 0)                                 { ret err[Error].err{Error.entry{}}; }
    if (k == into)                              { ret err[Error].err{Error.same{k}}; }
    if (b.blocks.data[k].predecessors.len != 1) { ret err[Error].err{Error.reached{k}}; }
    var i: usize = 0;
    for (i < d.results.len) {
        if (b.values.data[d.results.data[i]].uses.len != 0) { ret err[Error].err{Error.used{d.results.data[i]}}; }
        i = i + 1;
    }
    val params: *vector.Vector[Value] = ?b.blocks.data[k].parameters;
    val args:   *List[Value]          = ?d.edges.data[0].arguments;
    i = 0;
    for (i < args.len) {
        var j: usize = 0;
        for (j < params.len) {
            if (args.data[i] == params.data[j]) { ret err[Error].err{Error.circular{args.data[i]}}; }
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    for (i < args.len) {
        var moving: usize = 0;
        var bound:  usize = 0;
        var j:      usize = 0;
        for (j < args.len) {
            if (args.data[j] == args.data[i]) {
                moving = moving + b.values.data[params.data[j]].uses.len;
                bound  = bound + b.values.data[params.data[j]].bound.len;
            }
            j = j + 1;
        }
        val room: err[allocator.Error] = pool.reserve[Instruction](?b.lists, ?b.values.data[args.data[i]].uses, moving);
        if (sel room.err) { ret refuse(room.err); }
        val spots: res[usize, allocator.Error] = vector.reserve[u32](?b.values.data[args.data[i]].bound, bound);
        if (sel spots.err) { ret refuse(spots.err); }
        i = i + 1;
    }
    val tail: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
    val list: *vector.Vector[Instruction] = ?b.blocks.data[into].instructions;
    val room: res[usize, allocator.Error] = vector.reserve[Instruction](list, tail.len);
    if (sel room.err) { ret refuse(room.err); }

    i = 0;
    for (i < params.len) {
        move_uses(b, params.data[i], args.data[i]);
        i = i + 1;
    }
    val p:     usize            = slot(b, into, jump);
    val jd:    *InstructionData = ?b.instructions.data[jump];
    var carry: Run              = b.blocks.data[k].ending;
    b.blocks.data[k].ending = no_run();
    if (tail.len > 0) {
        val lead: *InstructionData = ?b.instructions.data[tail.data[0]];
        lead.points = join(b, jd.points, lead.points);
    }
    or { carry = join(b, jd.points, carry); }
    jd.points = no_run();
    if (p + 1 < list.len) {
        val after: *InstructionData = ?b.instructions.data[list.data[p + 1]];
        after.points = join(b, carry, after.points);
    }
    or { b.blocks.data[into].ending = join(b, carry, b.blocks.data[into].ending); }
    take_out(b, jump);
    var n: usize = list.len;
    for (n > p) {
        n                       = n - 1;
        list.data[n + tail.len] = list.data[n];
    }
    i = 0;
    for (i < tail.len) {
        list.data[p + i]                        = tail.data[i];
        b.instructions.data[tail.data[i]].place = Place.placed{into};
        i                                       = i + 1;
    }
    vector.commit[Instruction](list, tail.len);
    vector.truncate[Instruction](tail, 0);
    i = 0;
    for (i < params.len) {
        b.values.data[params.data[i]].def = Def.removed{};
        i                                 = i + 1;
    }
    b.blocks.data[k].erased = true;
    ret err[Error].ok{};
}

# how far a body's lists reach, so a refused edit can be taken back to it
# ---
# blocks:       its number of blocks
# values:       its number of values
# instructions: its number of instructions
# points:       its number of value binding records
pub rec Mark {
    blocks:       u32;
    values:       u32;
    instructions: u32;
    points:       u32;
}

# where a body's lists end now
pub fun mark(m: *Module, f: Function) res[Mark, Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret res[Mark, Error].err{got.err}; }
    ret res[Mark, Error].ok{Mark{blocks: got.ok.blocks.len::u32, values: got.ok.values.len::u32, instructions: got.ok.instructions.len::u32, points: got.ok.points.len::u32}};
}

# take back every block, value and instruction made since a mark, leaving the
# body as it was at the mark
#
# what was made since may be used, entered, listed and read by a record only
# by what was made since, and a record made since stands in a block made
# since, so what came before is left exactly as it was. it never allocates.
# ---
# m:   the module
# f:   the function
# at:  a mark of the body
# ret: ok, or why it was refused with the body left as it was, or the first
#      release the allocator refused once everything was taken back
pub fun rewind(m: *Module, f: Function, at: Mark) err[Error] {
    val got: res[*Body, Error] = module.body(m, f);
    if (sel got.err) { ret err[Error].err{got.err}; }
    val b: *Body = got.ok;
    if (at.blocks::usize > b.blocks.len)             { ret err[Error].err{Error.block{at.blocks}}; }
    if (at.values::usize > b.values.len)             { ret err[Error].err{Error.value{at.values}}; }
    if (at.instructions::usize > b.instructions.len) { ret err[Error].err{Error.instruction{at.instructions}}; }
    if (at.points::usize > b.points.len)             { ret err[Error].err{Error.point{at.points}}; }
    var i: usize = at.values::usize;
    for (i < b.values.len) {
        val v: *ValueData = ?b.values.data[i];
        var u: usize      = 0;
        for (u < v.uses.len) {
            if (v.uses.data[u] < at.instructions) { ret err[Error].err{Error.used{(i::u32)}}; }
            u = u + 1;
        }
        u = 0;
        for (u < v.bound.len) {
            if (v.bound.data[u] < at.points) { ret err[Error].err{Error.bound{(i::u32)}}; }
            u = u + 1;
        }
        if (sel v.def.parameter) {
            if (v.def.parameter.block < at.blocks) { ret err[Error].err{Error.parameter{v.def.parameter.index}}; }
        }
        i = i + 1;
    }
    i = at.blocks::usize;
    for (i < b.blocks.len) {
        val k: *BlockData = ?b.blocks.data[i];
        var u: usize      = 0;
        for (u < k.predecessors.len) {
            if (k.predecessors.data[u] < at.instructions) { ret err[Error].err{Error.reached{(i::u32)}}; }
            u = u + 1;
        }
        u = 0;
        for (u < k.instructions.len) {
            if (k.instructions.data[u] < at.instructions) { ret err[Error].err{Error.occupied{(i::u32)}}; }
            u = u + 1;
        }
        i = i + 1;
    }

    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    i = b.instructions.len;
    for (i > at.instructions::usize) {
        i = i - 1;
        if (!(sel b.instructions.data[i].place.erased)) { take_out(b, (i::u32)); }
        keep(?failed, instruction.release(m.a, ?b.instructions.data[i]));
    }
    vector.truncate[InstructionData](?b.instructions, at.instructions::usize);
    i = at.values::usize;
    for (i < b.values.len) {
        val def: Def = b.values.data[i].def;
        if (sel def.constant) {
            val key: u32 = def.constant;
            map.remove[u32, Value](?b.constants, ?key);
        }
        keep(?failed, vector.dnit[u32](?b.values.data[i].bound));
        i = i + 1;
    }
    vector.truncate[ValueData](?b.values, at.values::usize);
    i = at.blocks::usize;
    for (i < b.blocks.len) {
        keep(?failed, vector.dnit[Value](?b.blocks.data[i].parameters));
        keep(?failed, vector.dnit[Instruction](?b.blocks.data[i].instructions));
        keep(?failed, vector.dnit[Instruction](?b.blocks.data[i].predecessors));
        i = i + 1;
    }
    vector.truncate[BlockData](?b.blocks, at.blocks::usize);
    var r: usize = at.points::usize;
    for (r < b.points.len) {
        val v: opt[Value] = point.read(b.points.data[r].reads);
        if (sel v.some) {
            if (v.some < at.values) { drop_record(?b.values.data[v.some].bound, r::u32); }
        }
        r = r + 1;
    }
    vector.truncate[Point](?b.points, at.points::usize);
    if (sel failed.err) { ret refuse(failed.err); }
    ret err[Error].ok{};
}

fun ty(m: *Module, s: table.Shape) Type {
    val r: res[Type, table.Error] = table.intern(?m.types, s);
    if (sel r.err) { ret 0xffffffff; }
    ret r.ok;
}

fun values(data: *Value, size: usize) Slice[Value] {
    ret Slice[Value]{data: data, size: size};
}

fun argument(m: *Module, f: Function, i: Instruction, edge: usize, at: usize) i64 {
    val d: res[InstructionData, Error] = instruction_data(m, f, i);
    if (sel d.err) { ret -1; }
    val args: List[Value] = d.ok.edges.data[edge].arguments;
    if (at >= args.len) { ret -1; }
    ret args.data[at]::i64;
}
