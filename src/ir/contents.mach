# what a body holds: every opcode it made an instruction of and every type it
# gave a value or named in an immediate
#
# mirl.ir.body records each one as it makes the instruction, value or
# parameter, and nothing takes one out, so the contents hold at least what the
# body holds at any time. a pass that rewrites only some opcodes or types asks
# the contents first and leaves a body that holds none of them unwalked.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.opcode.row.Opcode;
use mirl.ir.type.table.Type;

# a set of ids, bit i of word i / 64 holding id i
pub def Ids: vector.Vector[u64];

# the opcodes and types a body was given
# ---
# opcodes: every opcode it made an instruction of
# types:   every type it gave a value or named in an immediate
pub rec Contents {
    opcodes: Ids;
    types:   Ids;
}

# no contents, growing in an allocator
pub fun init(a: *allocator.Allocator) Contents {
    ret Contents{opcodes: vector.init[u64](a), types: vector.init[u64](a)};
}

# give back the contents' storage
pub fun dnit(c: *Contents) err[allocator.Error] {
    val opcodes: err[allocator.Error] = vector.dnit[u64](?c.opcodes);
    val types:   err[allocator.Error] = vector.dnit[u64](?c.types);
    if (sel opcodes.err) { ret opcodes; }
    ret types;
}

# add id `x` to a set, growing it to reach it
pub fun add(s: *Ids, x: u32) err[allocator.Error] {
    val word: usize = (x / 64)::usize;
    for (s.len <= word) {
        val pushed: res[usize, allocator.Error] = vector.push[u64](s, 0);
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    }
    s.data[word] = s.data[word] | (1u64 << (x % 64)::u64);
    ret err[allocator.Error].ok{};
}

# whether a set holds id `x`
pub fun holds(s: *Ids, x: u32) bool {
    val word: usize = (x / 64)::usize;
    if (word >= s.len) { ret false; }
    ret (s.data[word] & (1u64 << (x % 64)::u64)) != 0;
}

# move `at` to the least id of a set at or past it
# ---
# s:   the set
# at:  where the search starts, the id found on return
# ret: whether one was found
pub fun seek(s: *Ids, at: *u32) bool {
    var word: usize = (@at / 64)::usize;
    if (word >= s.len) { ret false; }
    var bits: u64 = s.data[word] >> (@at % 64)::u64;
    if (bits == 0) {
        word = word + 1;
        for (word < s.len && s.data[word] == 0) { word = word + 1; }
        if (word >= s.len) { ret false; }
        bits = s.data[word];
        @at  = (word * 64)::u32;
    }
    for ((bits & 1) == 0) {
        bits = bits >> 1;
        @at  = @at + 1;
    }
    ret true;
}

# record an opcode in a body's contents
pub fun note_opcode(c: *Contents, op: Opcode) err[allocator.Error] {
    ret add(?c.opcodes, op);
}

# record a type in a body's contents
pub fun note_type(c: *Contents, ty: Type) err[allocator.Error] {
    ret add(?c.types, ty);
}

# whether a body's contents hold an opcode
pub fun has_opcode(c: *Contents, op: Opcode) bool {
    ret holds(?c.opcodes, op);
}
