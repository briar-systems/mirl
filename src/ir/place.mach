# where a call's pieces travel, as the calling convention places them
#
# the abi legalisation rewrites every call, entry and return into pieces,
# each a scalar of at most a register's width that travels at one place. a
# piece's place, how its size scales and how its place is filled past it are
# the facts the convention stated when it classified the call, kept with the
# piece so nothing after the legalisation classifies again.

use std.types.bool.bool;
use std.types.bool.false;

use rf: masc.core.register;

# how many of a call's arguments are named
# ---
# all:   every one, the call is not variadic
# first: this many, the rest being unnamed
pub tag Named: u8 {
    unstated;
    all;
    first: u32;
}

# where a piece travels
# ---
# register: in a register, by masc's identity, which holds its class
# stack:    at this byte offset in the argument area, from the stack pointer
#           at the call
# operand:  as this operand of the target's own call form, where there are no
#           registers or memory stack to place it in, as spir-v's
#           OpFunctionCall and wasm's call take their arguments
pub tag Place: u8 {
    register: rf.Id;
    stack:    u64;
    operand:  u32;
}

# how a place is filled past the piece it holds
# ---
# exact:     the piece fills it
# undefined: the bits past the piece hold anything
# sign:      sign extended from this many bits
# zero:      zero extended from this many bits
# boxed:     all ones above, as a narrower float is nan boxed
# declared:  extended from this many bits as the value's signedness gives,
#            which a convention row leaves to the signature's extension and
#            `classify` turns into sign or zero, so no assignment holds it
pub tag Fill: u8 {
    exact;
    undefined;
    sign: u32;
    zero: u32;
    boxed;
    declared: u32;
}

# how a piece's offset and size scale
# ---
# fixed:  they are bytes
# scaled: they are bytes per unit of the multiplier of this scale of the
#         convention's register file, as an sve register's size follows the
#         vector length
pub tag Scale: u8 {
    fixed;
    scaled: u8;
}

# one piece of a call, an entry or a return as it travels
# ---
# place: where it travels
# scale: how its size scales
# fill:  how its place is filled past it
pub rec Placed {
    place: Place;
    scale: Scale;
    fill:  Fill;
}

# whether two placings are the same
pub fun same(a: Placed, b: Placed) bool {
    var place: bool = false;
    if (sel a.place.register) { place = sel b.place.register && b.place.register == a.place.register; }
    or (sel a.place.stack)    { place = sel b.place.stack && b.place.stack == a.place.stack; }
    or (sel a.place.operand)  { place = sel b.place.operand && b.place.operand == a.place.operand; }
    var scale: bool = false;
    if (sel a.scale.fixed)  { scale = sel b.scale.fixed; }
    or (sel a.scale.scaled) { scale = sel b.scale.scaled && b.scale.scaled == a.scale.scaled; }
    var fill: bool = false;
    if (sel a.fill.exact)     { fill = sel b.fill.exact; }
    or (sel a.fill.undefined) { fill = sel b.fill.undefined; }
    or (sel a.fill.sign)      { fill = sel b.fill.sign && b.fill.sign == a.fill.sign; }
    or (sel a.fill.zero)      { fill = sel b.fill.zero && b.fill.zero == a.fill.zero; }
    or (sel a.fill.boxed)     { fill = sel b.fill.boxed; }
    or (sel a.fill.declared)  { fill = sel b.fill.declared && b.fill.declared == a.fill.declared; }
    ret place && scale && fill;
}
