# the one checker: types an instance of a row by interpreting the row's rules
#
# no opcode is named here. a row states its typing and this reads it, so the
# verifier, the parser and every pass that builds an instruction type it the
# same way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.opcode.row.Holds;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Allowed;
use mirl.ir.opcode.rule.Bound;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Lane;
use mirl.ir.opcode.rule.Ordering;
use mirl.ir.opcode.rule.Orderings;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.table;
use types: mirl.ir.type;
use mirl.ir.type.Type;

# one edge of an instance: the arguments it passes and the parameters of its target
pub rec Edge {
    arguments:  Slice[Type];
    parameters: Slice[Type];
}

# what the checker reads of one instruction
# ---
# operands:   the operand types, the fixed operands then the tail
# secret:     whether each operand is secret, one per operand
# declared:   the instruction's own secrecy mark
# immediates: the immediates, one per slot of the row
# edges:      the edges to its targets, in order
# returns:    the result types of the function it is in
pub rec Instance {
    operands:   Slice[Type];
    secret:     Slice[bool];
    declared:   bool;
    immediates: Slice[Immediate];
    edges:      Slice[Edge];
    returns:    Slice[Type];
}

# why the checker refused an instance
# ---
# alloc:      the allocator refused storage for a result
# types:      the type table refused a read or an intern
# opcode:     an opcode that names no row
# operands:   this many operands, not what the row takes
# secrecy:    this many secrecy marks, not one per operand
# immediates: this many immediates, not what the row takes
# immediate:  the immediate at this position holds the wrong kind
# alignment:  an alignment that is not a power of two
# targets:    this many targets, not what the row takes
# arguments:  the edge at this position passes arguments that are not its
#             target's parameters
# subject:    a rule names a subject that is not a type of the instance
# class:      the subject is not in the class
# agree:      the two subjects are different types
# parameters: the tail operands are not the parameters of the signature
# returns:    the tail operands are not the function's results
# unsized:    a subject compared by bits has no stated bit width
# conform:    one subject is a vector and the other is not, or their lane
#             counts differ
# element:    the lane types of the two subjects differ
# wider:      the left subject does not have more bits than the right
# bits:       the two subjects have different numbers of bits
# lane:       the lane immediate at this position indexes past the vectors
# count:      the lane list at this position is not one index per lane
# lanes_of:   the tail operands are not the lanes of the vector
# ordering:   the ordering immediate at this position is not one allowed
pub tag Error: u8 {
    alloc:      allocator.Error;
    types:      types.Error;
    opcode:     Opcode;
    operands:   u32;
    secrecy:    u32;
    immediates: u32;
    immediate:  u32;
    alignment:  u64;
    targets:    u32;
    arguments:  u32;
    subject:    Subject;
    class:      Bound;
    agree:      Pair;
    parameters;
    returns;
    unsized: Subject;
    conform: Pair;
    element: Pair;
    wider:   Pair;
    bits:    Pair;
    lane:    u32;
    count:   u32;
    lanes_of;
    ordering: u32;
}

fun subject(inst: *Instance, s: Subject) res[Type, Error] {
    if (sel s.operand) { ret res[Type, Error].ok{inst.operands.data[s.operand]}; }
    if (sel s.immediate) {
        val imm: Immediate = inst.immediates.data[s.immediate];
        if (sel imm.ty) { ret res[Type, Error].ok{imm.ty}; }
    }
    ret res[Type, Error].err{Error.subject{s}};
}

fun admits(t: *types.Table, r: *Row, class: Class, ty: Type) res[bool, Error] {
    var lane: Type = ty;
    if (sel r.vector.lanewise || sel r.vector.across) {
        val e: res[types.Shape, types.Error] = types.shape(t, ty);
        if (sel e.err)           { ret res[bool, Error].err{Error.types{e.err}}; }
        if (sel e.ok.vector)     { lane = e.ok.vector.element; }
        or (sel r.vector.across) { ret res[bool, Error].ok{false}; }
    }
    val got: res[bool, types.Error] = within(t, class, lane);
    if (sel got.err) { ret res[bool, Error].err{Error.types{got.err}}; }
    ret res[bool, Error].ok{got.ok};
}

# whether a type, tested whole, is in a class
# ---
# t:     the type table
# class: the class
# ty:    the type
# ret:   whether it is, or the type table's refusal
pub fun within(t: *types.Table, class: Class, ty: Type) res[bool, types.Error] {
    val got: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel got.err) { ret res[bool, types.Error].err{got.err}; }
    val s: types.Shape = got.ok;
    if (sel class.any)      { ret res[bool, types.Error].ok{true}; }
    if (sel class.integer)  { ret res[bool, types.Error].ok{sel s.integer}; }
    if (sel class.width)    { ret res[bool, types.Error].ok{sel s.integer && s.integer.width == class.width}; }
    if (sel class.float)    { ret res[bool, types.Error].ok{sel s.float}; }
    if (sel class.format)   { ret res[bool, types.Error].ok{sel s.float && s.float.format.index == class.format.index}; }
    if (sel class.pointer)  { ret res[bool, types.Error].ok{sel s.pointer}; }
    if (sel class.function) { ret res[bool, types.Error].ok{sel s.function}; }
    if (sel class.bytes)    { ret res[bool, types.Error].ok{sel s.integer && s.integer.width % 8 == 0}; }
    if (sel class.vector)   { ret res[bool, types.Error].ok{sel s.vector}; }
    if (sel class.scalar)   { ret res[bool, types.Error].ok{sel s.integer || sel s.float || sel s.pointer}; }
    ret res[bool, types.Error].ok{false};
}

# the bits of a type counted from the type table and the number format table,
# zero for a type with no stated bit width
fun bits(t: *types.Table, ty: Type) res[u64, Error] {
    val got: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel got.err)        { ret res[u64, Error].err{Error.types{got.err}}; }
    if (sel got.ok.integer) { ret res[u64, Error].ok{got.ok.integer.width::u64}; }
    if (sel got.ok.float) {
        val f: opt[types.Row] = types.row(got.ok.float.format);
        if (sel f.none) { ret res[u64, Error].err{Error.types{types.Error.format{got.ok.float.format}}}; }
        ret res[u64, Error].ok{f.some.width::u64};
    }
    if (sel got.ok.vector) {
        val e: res[u64, Error] = bits(t, got.ok.vector.element);
        if (sel e.err) { ret e; }
        ret res[u64, Error].ok{e.ok * got.ok.vector.lanes::u64};
    }
    ret res[u64, Error].ok{0};
}

# the lane count of a vector type, zero for any other
fun lane_count(t: *types.Table, ty: Type) res[u32, Error] {
    val got: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel got.err)       { ret res[u32, Error].err{Error.types{got.err}}; }
    if (sel got.ok.vector) { ret res[u32, Error].ok{got.ok.vector.lanes}; }
    ret res[u32, Error].ok{0};
}

# the lane type of a vector type, and any other type is its own
fun lane_type(t: *types.Table, ty: Type) res[Type, Error] {
    val got: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel got.err)       { ret res[Type, Error].err{Error.types{got.err}}; }
    if (sel got.ok.vector) { ret res[Type, Error].ok{got.ok.vector.element}; }
    ret res[Type, Error].ok{ty};
}

fun tail(inst: *Instance, from: u32) Slice[Type] {
    ret Slice[Type]{data: ?inst.operands.data[from], size: inst.operands.size - from::usize};
}

fun push(out: *vector.Vector[Type], ty: Type) err[Error] {
    val p: res[usize, allocator.Error] = vector.push[Type](out, ty);
    if (sel p.err) { ret err[Error].err{Error.alloc{p.err}}; }
    ret err[Error].ok{};
}

fun mask(t: *types.Table, ty: Type) res[Type, Error] {
    val bit: res[Type, types.Error] = types.intern(t, types.Shape.integer{types.Integer{width: 1}});
    if (sel bit.err) { ret res[Type, Error].err{Error.types{bit.err}}; }
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err)          { ret res[Type, Error].err{Error.types{s.err}}; }
    if (!(sel s.ok.vector)) { ret res[Type, Error].ok{bit.ok}; }
    val lanes: res[Type, types.Error] = types.intern(t, types.Shape.vector{types.Vector{lanes: s.ok.vector.lanes, element: bit.ok}});
    if (sel lanes.err) { ret res[Type, Error].err{Error.types{lanes.err}}; }
    ret res[Type, Error].ok{lanes.ok};
}

fun shape_of(r: *Row, inst: *Instance) err[Error] {
    val operands: u32 = fixed(r);
    val given:    u32 = inst.operands.size::u32;
    if ((sel r.tail.unstated && given != operands) || given < operands) { ret err[Error].err{Error.operands{given}}; }
    if (inst.secret.size != inst.operands.size)                         { ret err[Error].err{Error.secrecy{inst.secret.size::u32}}; }

    val count: u32 = slots(r);
    if (inst.immediates.size != count::usize) { ret err[Error].err{Error.immediates{inst.immediates.size::u32}}; }
    var i: u32 = 0;
    for (i < count) {
        val imm: Immediate = inst.immediates.data[i];
        if (sel r.immediates[i].holds.ty && !(sel imm.ty))             { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.ordering && !(sel imm.ordering)) { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.lane && !(sel imm.lane))         { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.lanes && !(sel imm.lanes))       { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.alignment) {
            if (!(sel imm.alignment)) { ret err[Error].err{Error.immediate{i}}; }
            val a: u64 = imm.alignment;
            if (a == 0 || (a & (a - 1)) != 0) { ret err[Error].err{Error.alignment{a}}; }
        }
        i = i + 1;
    }

    val edges: u32 = inst.edges.size::u32;
    if (sel r.targets.exact && edges != r.targets.exact)      { ret err[Error].err{Error.targets{edges}}; }
    if (sel r.targets.at_least && edges < r.targets.at_least) { ret err[Error].err{Error.targets{edges}}; }
    i = 0;
    for (i < edges) {
        val e: Edge = inst.edges.data[i];
        if (!types.same_list(e.arguments, e.parameters)) { ret err[Error].err{Error.arguments{i}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun pair_types(inst: *Instance, p: Pair, left: *Type, right: *Type) err[Error] {
    val l: res[Type, Error] = subject(inst, p.left);
    if (sel l.err) { ret err[Error].err{l.err}; }
    val r: res[Type, Error] = subject(inst, p.right);
    if (sel r.err) { ret err[Error].err{r.err}; }
    @left  = l.ok;
    @right = r.ok;
    ret err[Error].ok{};
}

fun lanes_in(t: *types.Table, inst: *Instance, ln: Lane) err[Error] {
    val a: res[Type, Error] = subject(inst, ln.over.left);
    if (sel a.err) { ret err[Error].err{a.err}; }
    val left: res[u32, Error] = lane_count(t, a.ok);
    if (sel left.err) { ret err[Error].err{left.err}; }
    var bound: u32 = left.ok;
    if (!(sel ln.over.right.unstated)) {
        val b: res[Type, Error] = subject(inst, ln.over.right);
        if (sel b.err) { ret err[Error].err{b.err}; }
        val right: res[u32, Error] = lane_count(t, b.ok);
        if (sel right.err) { ret err[Error].err{right.err}; }
        bound = bound + right.ok;
    }
    val imm: Immediate = inst.immediates.data[ln.slot];
    if (sel imm.lane && imm.lane >= bound) { ret err[Error].err{Error.lane{ln.slot}}; }
    if (sel imm.lanes) {
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (imm.lanes.data[i] >= bound) { ret err[Error].err{Error.lane{ln.slot}}; }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

fun allowed(a: Allowed, inst: *Instance) bool {
    val imm: Immediate = inst.immediates.data[a.slot];
    if (!(sel imm.ordering)) { ret false; }
    val o: Ordering = imm.ordering;
    if (sel o.relaxed) { ret a.orderings.relaxed; }
    if (sel o.acquire) { ret a.orderings.acquire; }
    if (sel o.release) { ret a.orderings.release; }
    if (sel o.acq_rel) { ret a.orderings.acq_rel; }
    ret a.orderings.seq_cst;
}

fun lanes_given(t: *types.Table, r: *Row, inst: *Instance, s: Subject) err[Error] {
    val ty: res[Type, Error] = subject(inst, s);
    if (sel ty.err) { ret err[Error].err{ty.err}; }
    val n: res[u32, Error] = lane_count(t, ty.ok);
    if (sel n.err) { ret err[Error].err{n.err}; }
    val lane: res[Type, Error] = lane_type(t, ty.ok);
    if (sel lane.err) { ret err[Error].err{lane.err}; }
    val given: Slice[Type] = tail(inst, fixed(r));
    if (n.ok == 0 || given.size != n.ok::usize) { ret err[Error].err{Error.lanes_of{}}; }
    var i: usize = 0;
    for (i < given.size) {
        if (!types.same(given.data[i], lane.ok)) { ret err[Error].err{Error.lanes_of{}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun related(t: *types.Table, inst: *Instance, rl: Rule) err[Error] {
    var left:  Type;
    var right: Type;
    val pair:  Pair       = pair_of(rl);
    val got:   err[Error] = pair_types(inst, pair, ?left, ?right);
    if (sel got.err) { ret got; }
    if (sel rl.conform) {
        val a: res[u32, Error] = lane_count(t, left);
        if (sel a.err) { ret err[Error].err{a.err}; }
        val b: res[u32, Error] = lane_count(t, right);
        if (sel b.err)    { ret err[Error].err{b.err}; }
        if (a.ok != b.ok) { ret err[Error].err{Error.conform{pair}}; }
    }
    or (sel rl.element) {
        val a: res[Type, Error] = lane_type(t, left);
        if (sel a.err) { ret err[Error].err{a.err}; }
        val b: res[Type, Error] = lane_type(t, right);
        if (sel b.err)               { ret err[Error].err{b.err}; }
        if (!types.same(a.ok, b.ok)) { ret err[Error].err{Error.element{pair}}; }
    }
    or {
        val a: res[u64, Error] = bits(t, left);
        if (sel a.err) { ret err[Error].err{a.err}; }
        val b: res[u64, Error] = bits(t, right);
        if (sel b.err)                    { ret err[Error].err{b.err}; }
        if (a.ok == 0)                    { ret err[Error].err{Error.unsized{pair.left}}; }
        if (b.ok == 0)                    { ret err[Error].err{Error.unsized{pair.right}}; }
        if (sel rl.wider && a.ok <= b.ok) { ret err[Error].err{Error.wider{pair}}; }
        if (sel rl.bits && a.ok != b.ok)  { ret err[Error].err{Error.bits{pair}}; }
    }
    ret err[Error].ok{};
}

fun pair_of(rl: Rule) Pair {
    if (sel rl.conform) { ret rl.conform; }
    if (sel rl.element) { ret rl.element; }
    if (sel rl.wider)   { ret rl.wider; }
    if (sel rl.bits)    { ret rl.bits; }
    var none: Pair;
    ret none;
}

fun rule(t: *types.Table, r: *Row, inst: *Instance, rl: Rule) err[Error] {
    if (sel rl.is) {
        val ty: res[Type, Error] = subject(inst, rl.is.subject);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val ok: res[bool, Error] = admits(t, r, rl.is.class, ty.ok);
        if (sel ok.err) { ret err[Error].err{ok.err}; }
        if (!ok.ok)     { ret err[Error].err{Error.class{rl.is}}; }
    }
    or (sel rl.agree) {
        val left: res[Type, Error] = subject(inst, rl.agree.left);
        if (sel left.err) { ret err[Error].err{left.err}; }
        val right: res[Type, Error] = subject(inst, rl.agree.right);
        if (sel right.err)                  { ret err[Error].err{right.err}; }
        if (!types.same(left.ok, right.ok)) { ret err[Error].err{Error.agree{rl.agree}}; }
    }
    or (sel rl.parameters) {
        val sig: res[Type, Error] = subject(inst, rl.parameters);
        if (sel sig.err) { ret err[Error].err{sig.err}; }
        val f: res[types.Function, types.Error] = types.signature(t, sig.ok);
        if (sel f.err)                                           { ret err[Error].err{Error.types{f.err}}; }
        if (!types.same_list(tail(inst, fixed(r)), f.ok.params)) { ret err[Error].err{Error.parameters{}}; }
    }
    or (sel rl.returns) {
        if (!types.same_list(tail(inst, fixed(r)), inst.returns)) { ret err[Error].err{Error.returns{}}; }
    }
    or (sel rl.conform || sel rl.element || sel rl.wider || sel rl.bits) {
        ret related(t, inst, rl);
    }
    or (sel rl.lane) {
        ret lanes_in(t, inst, rl.lane);
    }
    or (sel rl.count) {
        val ty: res[Type, Error] = subject(inst, rl.count.of);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val n: res[u32, Error] = lane_count(t, ty.ok);
        if (sel n.err) { ret err[Error].err{n.err}; }
        val imm: Immediate = inst.immediates.data[rl.count.slot];
        if (!(sel imm.lanes))              { ret err[Error].err{Error.count{rl.count.slot}}; }
        if (imm.lanes.size != n.ok::usize) { ret err[Error].err{Error.count{rl.count.slot}}; }
    }
    or (sel rl.lanes_of) {
        ret lanes_given(t, r, inst, rl.lanes_of);
    }
    or (sel rl.ordering) {
        if (!allowed(rl.ordering, inst)) { ret err[Error].err{Error.ordering{rl.ordering.slot}}; }
    }
    ret err[Error].ok{};
}

fun result(t: *types.Table, inst: *Instance, rs: Result, out: *vector.Vector[Type]) err[Error] {
    if (sel rs.element) {
        val ty: res[Type, Error] = subject(inst, rs.element);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val e: res[types.Shape, types.Error] = types.shape(t, ty.ok);
        if (sel e.err)          { ret err[Error].err{Error.types{e.err}}; }
        if (!(sel e.ok.vector)) { ret err[Error].err{Error.class{Bound{subject: rs.element, class: Class.vector{}}}}; }
        ret push(out, e.ok.vector.element);
    }
    if (sel rs.same) {
        val ty: res[Type, Error] = subject(inst, rs.same);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        ret push(out, ty.ok);
    }
    if (sel rs.mask) {
        val ty: res[Type, Error] = subject(inst, rs.mask);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val m: res[Type, Error] = mask(t, ty.ok);
        if (sel m.err) { ret err[Error].err{m.err}; }
        ret push(out, m.ok);
    }
    if (sel rs.results) {
        val sig: res[Type, Error] = subject(inst, rs.results);
        if (sel sig.err) { ret err[Error].err{sig.err}; }
        val f: res[types.Function, types.Error] = types.signature(t, sig.ok);
        if (sel f.err) { ret err[Error].err{Error.types{f.err}}; }
        var i: usize = 0;
        for (i < f.ok.results.size) {
            val p: err[Error] = push(out, f.ok.results.data[i]);
            if (sel p.err) { ret p; }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

fun secrecy(r: *Row, inst: *Instance) bool {
    if (sel r.secrecy.declared)      { ret inst.declared; }
    if (!(sel r.secrecy.propagates)) { ret false; }
    var i: usize = 0;
    for (i < inst.secret.size) {
        if (inst.secret.data[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

# type an instance of an opcode
# ---
# t:    the type table the instance's types are in
# op:   the opcode
# inst: the instance
# out:  where the result types are pushed, in order
# ret:  whether its results are secret, by the row's secrecy rule, or the
#       first rule the instance breaks
pub fun check(t: *types.Table, op: Opcode, inst: Instance, out: *vector.Vector[Type]) res[bool, Error] {
    val found: opt[Row] = table.row(op);
    if (sel found.none) { ret res[bool, Error].err{Error.opcode{op}}; }
    var r: Row = found.some;

    val shaped: err[Error] = shape_of(?r, ?inst);
    if (sel shaped.err) { ret res[bool, Error].err{shaped.err}; }
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel r.rules[i].unstated)) {
        val c: err[Error] = rule(t, ?r, ?inst, r.rules[i]);
        if (sel c.err) { ret res[bool, Error].err{c.err}; }
        i = i + 1;
    }
    val start: usize = out.len;
    i = 0;
    for (i < $length_of(Results) && !(sel r.results[i].unstated)) {
        val c: err[Error] = result(t, ?inst, r.results[i], out);
        if (sel c.err) {
            out.len = start;
            ret res[bool, Error].err{c.err};
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{secrecy(?r, ?inst)};
}

fun intern(t: *types.Table, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(t, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun operands(data: *Type, secret: *bool, size: usize) Instance {
    var inst: Instance;
    inst.operands = Slice[Type]{data: data, size: size};
    inst.secret   = Slice[bool]{data: secret, size: size};
    ret inst;
}

test check__compare_yields_i1_and_cbr_takes_only_i1 {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var out: vector.Vector[Type] = vector.init[Type](?a);
    fin { vector.dnit[Type](?out); }

    val i1:  Type = intern(?t, types.Shape.integer{types.Integer{width: 1}});
    val i8:  Type = intern(?t, types.Shape.integer{types.Integer{width: 8}});
    val i32: Type = intern(?t, types.Shape.integer{types.Integer{width: 32}});
    val v4:  Type = intern(?t, types.Shape.vector{types.Vector{lanes: 4, element: i32}});
    val m4:  Type = intern(?t, types.Shape.vector{types.Vector{lanes: 4, element: i1}});
    val f32: Type = intern(?t, types.Shape.float{types.Float{format: types.BINARY32}});

    var pair:   [2]Type          = [2]Type{i32, i32};
    var public: [2]bool          = [2]bool{false, false};
    var mixed:  [2]bool          = [2]bool{false, true};
    val cmp:    res[bool, Error] = check(?t, table.LT_S, operands(?pair[0], ?public[0], 2), ?out);
    if (sel cmp.err)                                  { ret 1; }
    if (out.len != 1 || !types.same(out.data[0], i1)) { ret 2; }
    if (cmp.ok)                                       { ret 2; }
    out.len = 0;
    val hidden: res[bool, Error] = check(?t, table.LT_S, operands(?pair[0], ?mixed[0], 2), ?out);
    if (sel hidden.err) { ret 1; }
    if (!hidden.ok)     { ret 2; }

    var lanes: [2]Type = [2]Type{v4, v4};
    out.len = 0;
    val vcmp: res[bool, Error] = check(?t, table.EQ, operands(?lanes[0], ?public[0], 2), ?out);
    if (sel vcmp.err)                                 { ret 3; }
    if (out.len != 1 || !types.same(out.data[0], m4)) { ret 4; }

    var none:  [1]Type;
    var edges: [2]Edge = [2]Edge{
        Edge{arguments: Slice[Type]{data: ?none[0], size: 0}, parameters: Slice[Type]{data: ?none[0], size: 0}},
        Edge{arguments: Slice[Type]{data: ?none[0], size: 0}, parameters: Slice[Type]{data: ?none[0], size: 0}},
    };
    var conds: [5]Type = [5]Type{i1, i8, i32, f32, m4};
    var i:     usize   = 0;
    for (i < 5) {
        var inst: Instance = operands(?conds[i], ?public[0], 1);
        inst.edges = Slice[Edge]{data: ?edges[0], size: 2};
        out.len    = 0;
        val got: res[bool, Error] = check(?t, table.CBR, inst, ?out);
        if (i == 0) {
            if (sel got.err)  { ret 5; }
            if (out.len != 0) { ret 6; }
        }
        or {
            if (sel got.ok)           { ret 7; }
            if (!(sel got.err.class)) { ret 8; }
        }
        i = i + 1;
    }
    ret 0;
}

# the types a generated instance draws from: scalars, vectors of them, a function
rec Kit {
    t:   *types.Table;
    n:   u32;
    u:   [15]Type;
    i1:  Type;
    i32: Type;
}

# one generated instance of a row, built from the row's own rules
# ---
# ops:      the fixed operand types then the tail
# secret:   whether each operand is secret
# has:      whether a type is chosen, operands first then the type immediates
# imms:     the immediates, one per slot
# given:    how many operands the instance passes
# lanes:    storage for a lane list immediate
# returns:  the result types of the function the instance is in
# returned: how many of those there are
# edges:    one empty edge per target
rec Case {
    row:      Row;
    fixed:    u32;
    slots:    u32;
    ops:      [12]Type;
    secret:   [12]bool;
    has:      [8]bool;
    imms:     [3]Immediate;
    given:    u32;
    lanes:    [8]u32;
    returns:  [4]Type;
    returned: u32;
    nedges:   u32;
    edges:    [4]Edge;
    none:     [1]Type;
}

fun kit(t: *types.Table) Kit {
    var k: Kit;
    k.t = t;
    val i1:  Type    = intern(t, types.Shape.integer{types.Integer{width: 1}});
    val i8:  Type    = intern(t, types.Shape.integer{types.Integer{width: 8}});
    val i32: Type    = intern(t, types.Shape.integer{types.Integer{width: 32}});
    val i64: Type    = intern(t, types.Shape.integer{types.Integer{width: 64}});
    val f16: Type    = intern(t, types.Shape.float{types.Float{format: types.BINARY16}});
    val f32: Type    = intern(t, types.Shape.float{types.Float{format: types.BINARY32}});
    val f64: Type    = intern(t, types.Shape.float{types.Float{format: types.BINARY64}});
    var one: [1]Type = [1]Type{i32};
    k.i1  = i1;
    k.i32 = i32;
    k.u   = [15]Type{
        i1,
        i8,
        i32,
        i64,
        f16,
        f32,
        f64,
        intern(t, types.Shape.pointer{types.Pointer{space: 0}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: i1}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: i8}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: i32}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: i64}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: f32}}),
        intern(t, types.Shape.vector{types.Vector{lanes: 4, element: f64}}),
        intern(t, types.Shape.function{types.Function{params: Slice[Type]{data: ?one[0], size: 1}, results: Slice[Type]{data: ?one[0], size: 1}}}),
    };
    k.n = 15;
    ret k;
}

fun at(s: Subject) u32 {
    if (sel s.immediate) { ret 4 + s.immediate; }
    if (sel s.operand)   { ret s.operand; }
    ret 0xffffffff;
}

# the type chosen for a subject
fun chosen(c: *Case, s: Subject) Type {
    if (sel s.immediate) {
        val imm: Immediate = c.imms[s.immediate];
        if (sel imm.ty) { ret imm.ty; }
    }
    if (sel s.operand) { ret c.ops[s.operand]; }
    ret Type{index: 0xffffffff};
}

fun start(c: *Case, op: Opcode) bool {
    val found: opt[Row] = table.row(op);
    if (sel found.none) { ret false; }
    c.row   = found.some;
    c.fixed = fixed(?c.row);
    c.slots = slots(?c.row);
    if (sel c.row.targets.exact)    { c.nedges = c.row.targets.exact; }
    if (sel c.row.targets.at_least) { c.nedges = c.row.targets.at_least; }
    var i: usize = 0;
    for (i < $length_of(Edges)) {
        c.edges[i] = Edge{arguments: Slice[Type]{data: ?c.none[0], size: 0}, parameters: Slice[Type]{data: ?c.none[0], size: 0}};
        i          = i + 1;
    }
    ret true;
}

def Edges: [4]Edge;

fun instance(c: *Case) Instance {
    var inst: Instance;
    inst.operands   = Slice[Type]{data: ?c.ops[0], size: c.given::usize};
    inst.secret     = Slice[bool]{data: ?c.secret[0], size: c.given::usize};
    inst.immediates = Slice[Immediate]{data: ?c.imms[0], size: c.slots::usize};
    inst.edges      = Slice[Edge]{data: ?c.edges[0], size: c.nedges::usize};
    inst.returns    = Slice[Type]{data: ?c.returns[0], size: c.returned::usize};
    ret inst;
}

fun prunable(rl: Rule) bool {
    ret sel rl.is || sel rl.agree || sel rl.conform || sel rl.element || sel rl.wider || sel rl.bits;
}

fun ready(c: *Case, rl: Rule) bool {
    if (sel rl.is)    { ret c.has[at(rl.is.subject)]; }
    if (sel rl.agree) { ret c.has[at(rl.agree.left)] && c.has[at(rl.agree.right)]; }
    val p: Pair = pair_of(rl);
    ret c.has[at(p.left)] && c.has[at(p.right)];
}

# the first ordering a rule on the slot allows, or the first it refuses
fun ordering_for(c: *Case, slot: u32, allows: bool) Ordering {
    var j: usize = 0;
    for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
        val rl: Rule = c.row.rules[j];
        if (sel rl.ordering) {
            val o: Orderings = rl.ordering.orderings;
            if (rl.ordering.slot == slot && o.relaxed == allows) { ret Ordering.relaxed{}; }
            if (rl.ordering.slot == slot && o.acquire == allows) { ret Ordering.acquire{}; }
            if (rl.ordering.slot == slot && o.release == allows) { ret Ordering.release{}; }
            if (rl.ordering.slot == slot && o.acq_rel == allows) { ret Ordering.acq_rel{}; }
            if (rl.ordering.slot == slot && o.seq_cst == allows) { ret Ordering.seq_cst{}; }
        }
        j = j + 1;
    }
    ret Ordering.relaxed{};
}

# how many lane indices a lane list slot holds, one per lane its count rule names
fun lane_total(k: *Kit, c: *Case, slot: u32) u32 {
    var j: usize = 0;
    for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
        val rl: Rule = c.row.rules[j];
        if (sel rl.count) {
            val of: Subject = rl.count.of;
            if (rl.count.slot == slot) {
                val n: res[u32, Error] = lane_count(k.t, chosen(c, of));
                if (sel n.err) { ret 1; }
                ret n.ok;
            }
        }
        j = j + 1;
    }
    ret 1;
}

# fill the tail, the immediates and the operand count from the chosen types
#
# a rule the types cannot violate is violated here when it is the one named,
# and the result is false when it could not be.
fun finish(k: *Kit, c: *Case, broken: i32) bool {
    c.given    = c.fixed;
    c.returned = 0;
    c.lanes[0] = 0;
    var applied: bool  = broken < 0;
    var j:       usize = 0;
    for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
        val rl: Rule = c.row.rules[j];
        if (sel rl.parameters) {
            val f: res[types.Function, types.Error] = types.signature(k.t, chosen(c, rl.parameters));
            if (sel f.err) { ret false; }
            var p: usize = 0;
            for (p < f.ok.params.size) {
                c.ops[c.given] = f.ok.params.data[p];
                c.given        = c.given + 1;
                p              = p + 1;
            }
        }
        or (sel rl.returns) {
            c.ops[c.given] = k.i32;
            c.returns[0]   = k.i32;
            c.returned     = 1;
            c.given        = c.given + 1;
        }
        or (sel rl.lanes_of) {
            val n:    res[u32, Error]  = lane_count(k.t, chosen(c, rl.lanes_of));
            val lane: res[Type, Error] = lane_type(k.t, chosen(c, rl.lanes_of));
            if (sel n.err)    { ret false; }
            if (sel lane.err) { ret false; }
            var p: u32 = 0;
            for (p < n.ok) {
                c.ops[c.given] = lane.ok;
                c.given        = c.given + 1;
                p              = p + 1;
            }
        }
        if (j::i32 == broken && (sel rl.parameters || sel rl.returns || sel rl.lanes_of)) {
            c.ops[c.given] = k.i1;
            c.given        = c.given + 1;
            applied        = true;
        }
        j = j + 1;
    }
    var i: u32 = 0;
    for (i < c.slots) {
        val h: Holds = c.row.immediates[i].holds;
        if (sel h.alignment) { c.imms[i] = Immediate.alignment{1}; }
        if (sel h.ordering)  { c.imms[i] = Immediate.ordering{ordering_for(c, i, true)}; }
        if (sel h.lane)      { c.imms[i] = Immediate.lane{0}; }
        if (sel h.lanes)     { c.imms[i] = Immediate.lanes{Slice[u32]{data: ?c.lanes[0], size: lane_total(k, c, i)::usize}}; }
        i = i + 1;
    }
    if (broken < 0) { ret true; }
    val rl: Rule = c.row.rules[broken];
    if (sel rl.lane) {
        val h: Holds = c.row.immediates[rl.lane.slot].holds;
        c.lanes[0] = 1000;
        if (sel h.lane) { c.imms[rl.lane.slot] = Immediate.lane{1000}; }
        applied = true;
    }
    if (sel rl.count) {
        c.imms[rl.count.slot] = Immediate.lanes{Slice[u32]{data: ?c.lanes[0], size: lane_total(k, c, rl.count.slot)::usize + 1}};
        applied               = true;
    }
    if (sel rl.ordering) {
        c.imms[rl.ordering.slot] = Immediate.ordering{ordering_for(c, rl.ordering.slot, false)};
        val inst: Instance = instance(c);
        applied = !allowed(rl.ordering, ?inst);
    }
    ret applied;
}

# every rule of the instance holds, except rule `skip` which must fail
fun leaf(k: *Kit, c: *Case, skip: i32) bool {
    if (!finish(k, c, -1)) { ret false; }
    val inst: Instance = instance(c);
    var j:    usize    = 0;
    for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
        val got: err[Error] = rule(k.t, ?c.row, ?inst, c.row.rules[j]);
        if ((j::i32 == skip) != (sel got.err)) { ret false; }
        j = j + 1;
    }
    ret true;
}

fun position(c: *Case, n: u32) u32 {
    if (n < c.fixed) { ret n; }
    var left: u32 = n - c.fixed;
    var i:    u32 = 0;
    for (i < c.slots) {
        if (sel c.row.immediates[i].holds.ty) {
            if (left == 0) { ret 4 + i; }
            left = left - 1;
        }
        i = i + 1;
    }
    ret 0xffffffff;
}

# choose the types of a case one position at a time, pruning on the rules whose
# subjects are chosen, until every rule holds and rule `skip` alone fails
fun solve(k: *Kit, c: *Case, n: u32, skip: i32) bool {
    val idx: u32 = position(c, n);
    if (idx == 0xffffffff) { ret leaf(k, c, skip); }
    var i: u32 = 0;
    for (i < k.n) {
        if (idx < 4) { c.ops[idx] = k.u[i]; }
        or           { c.imms[idx - 4] = Immediate.ty{k.u[i]}; }
        c.has[idx] = true;
        var fits: bool = true;
        c.given = c.fixed;
        val inst: Instance = instance(c);
        var j:    usize    = 0;
        for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
            val rl: Rule = c.row.rules[j];
            if (j::i32 != skip && prunable(rl) && ready(c, rl)) {
                val got: err[Error] = rule(k.t, ?c.row, ?inst, rl);
                if (sel got.err) { fits = false; }
            }
            j = j + 1;
        }
        if (fits && solve(k, c, n + 1, skip)) { ret true; }
        i = i + 1;
    }
    c.has[idx] = false;
    ret false;
}

fun fresh(c: *Case) {
    var i: usize = 0;
    for (i < $length_of(Has)) {
        c.has[i] = false;
        i        = i + 1;
    }
}

def Has: [8]bool;

fun refused(k: *Kit, c: *Case, op: Opcode, out: *vector.Vector[Type]) bool {
    out.len = 0;
    val got: res[bool, Error] = check(k.t, op, instance(c), out);
    ret sel got.err;
}

test check__table_walk_types_a_well_typed_instance_and_refuses_an_ill_typed_one {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var out: vector.Vector[Type] = vector.init[Type](?a);
    fin { vector.dnit[Type](?out); }
    val k: Kit = kit(?t);

    val hand: i32 = semantics(?k, ?out);
    if (hand != 0) { ret hand; }

    var n: u32 = 0;
    for (n < table.rows()) {
        val op:   Opcode = Opcode{index: n};
        val code: i32    = 32 + (n * 16)::i32;
        var c:    Case;
        if (!start(?c, op)) { ret code + 1; }

        if (!solve(?k, ?c, 0, -1)) { ret code + 2; }
        out.len = 0;
        val good: res[bool, Error] = check(?t, op, instance(?c), ?out);
        if (sel good.err) { ret code + 3; }
        var results: usize = 0;
        for (results < $length_of(Results) && !(sel c.row.results[results].unstated)) { results = results + 1; }
        if (out.len < results) { ret code + 4; }

        var broke: u32 = 0;
        if (sel c.row.tail.unstated || c.fixed != 0) {
            c.given = c.fixed + 1;
            if (!(sel c.row.tail.unstated)) { c.given = c.fixed - 1; }
            if (!refused(?k, ?c, op, ?out)) { ret code + 5; }
            broke = broke + 1;
        }
        var j: usize = 0;
        for (j < $length_of(Rules) && !(sel c.row.rules[j].unstated)) {
            fresh(?c);
            if (prunable(c.row.rules[j])) {
                if (solve(?k, ?c, 0, j::i32)) {
                    if (!refused(?k, ?c, op, ?out)) { ret code + 6; }
                    broke = broke + 1;
                }
            }
            or {
                if (solve(?k, ?c, 0, -1) && finish(?k, ?c, j::i32)) {
                    if (!refused(?k, ?c, op, ?out)) { ret code + 7; }
                    broke = broke + 1;
                }
            }
            j = j + 1;
        }
        if (broke == 0) { ret code + 8; }
        n = n + 1;
    }
    ret 0;
}

test check__secrecy_propagates_from_any_operand_and_declassify_alone_removes_it {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var out: vector.Vector[Type] = vector.init[Type](?a);
    fin { vector.dnit[Type](?out); }
    val k: Kit = kit(?t);

    var declassifiers: u32 = 0;
    var n:             u32 = 0;
    for (n < table.rows()) {
        val op:   Opcode = Opcode{index: n};
        val code: i32    = (n * 16)::i32;
        var c:    Case;
        if (!start(?c, op))        { ret code + 1; }
        if (!solve(?k, ?c, 0, -1)) { ret code + 2; }
        var i: u32 = 0;
        if (sel c.row.secrecy.declassifies) {
            declassifiers = declassifiers + 1;
            for (i < c.given) {
                c.secret[i] = true;
                i           = i + 1;
            }
            out.len = 0;
            val gone: res[bool, Error] = check(?t, op, instance(?c), ?out);
            if (sel gone.err) { ret code + 3; }
            if (gone.ok)      { ret code + 3; }
        }
        or (sel c.row.secrecy.propagates) {
            for (i < c.given) {
                c.secret[i] = false;
                i           = i + 1;
            }
            out.len = 0;
            val clear: res[bool, Error] = check(?t, op, instance(?c), ?out);
            if (sel clear.err) { ret code + 4; }
            if (clear.ok)      { ret code + 4; }
            i = 0;
            for (i < c.given) {
                c.secret[i] = true;
                out.len     = 0;
                val marked: res[bool, Error] = check(?t, op, instance(?c), ?out);
                if (sel marked.err) { ret code + 5; }
                if (!marked.ok)     { ret code + 5; }
                c.secret[i] = false;
                i           = i + 1;
            }
        }
        n = n + 1;
    }
    if (declassifiers != 1) { ret 1; }
    ret 0;
}

fun accepts(k: *Kit, out: *vector.Vector[Type], op: Opcode, ops: Slice[Type], imms: Slice[Immediate]) bool {
    var secret: [4]bool;
    var inst:   Instance;
    inst.operands   = ops;
    inst.secret     = Slice[bool]{data: ?secret[0], size: ops.size};
    inst.immediates = imms;
    out.len         = 0;
    val got: res[bool, Error] = check(k.t, op, inst, out);
    ret !(sel got.err);
}

# hand cases the walk cannot state, because the walk reads the rules it checks
fun semantics(k: *Kit, out: *vector.Vector[Type]) i32 {
    val i32:   Type = k.u[2];
    val i64:   Type = k.u[3];
    val f32:   Type = k.u[5];
    val ptr:   Type = k.u[7];
    val v4i32: Type = k.u[10];
    val v4i64: Type = k.u[11];

    var one:    [1]Type      = [1]Type{i64};
    var wide:   [1]Immediate = [1]Immediate{Immediate.ty{i64}};
    var narrow: [1]Immediate = [1]Immediate{Immediate.ty{i32}};
    var lanes:  [1]Immediate = [1]Immediate{Immediate.ty{v4i64}};
    var float:  [1]Immediate = [1]Immediate{Immediate.ty{f32}};
    if (!accepts(k, out, table.TRUNC, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?narrow[0], size: 1})) { ret 1; }
    if (accepts(k, out, table.TRUNC, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?wide[0], size: 1}))    { ret 2; }
    if (accepts(k, out, table.TRUNC, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?lanes[0], size: 1}))   { ret 3; }
    one[0] = i32;
    if (!accepts(k, out, table.EXT_U, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?wide[0], size: 1}))    { ret 4; }
    if (!accepts(k, out, table.BITCAST, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?float[0], size: 1})) { ret 5; }
    if (accepts(k, out, table.BITCAST, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?wide[0], size: 1}))   { ret 6; }
    one[0] = ptr;
    if (accepts(k, out, table.BITCAST, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?wide[0], size: 1})) { ret 7; }

    one[0] = v4i32;
    if (!accepts(k, out, table.REDUCE_ADD, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: nil, size: 0}))     { ret 8; }
    if (accepts(k, out, table.REDUCE_FADD_SEQ, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: nil, size: 0})) { ret 9; }
    one[0] = i32;
    if (accepts(k, out, table.REDUCE_ADD, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: nil, size: 0})) { ret 10; }
    one[0] = v4i32;
    var last: [1]Immediate = [1]Immediate{Immediate.lane{3}};
    var past: [1]Immediate = [1]Immediate{Immediate.lane{4}};
    if (!accepts(k, out, table.VEXTRACT, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?last[0], size: 1})) { ret 11; }
    if (accepts(k, out, table.VEXTRACT, Slice[Type]{data: ?one[0], size: 1}, Slice[Immediate]{data: ?past[0], size: 1}))  { ret 12; }

    var pair:    [2]Type      = [2]Type{ptr, i32};
    var release: [1]Immediate = [1]Immediate{Immediate.ordering{Ordering.release{}}};
    var acquire: [1]Immediate = [1]Immediate{Immediate.ordering{Ordering.acquire{}}};
    if (!accepts(k, out, table.ATOMIC_STORE, Slice[Type]{data: ?pair[0], size: 2}, Slice[Immediate]{data: ?release[0], size: 1})) { ret 13; }
    if (accepts(k, out, table.ATOMIC_STORE, Slice[Type]{data: ?pair[0], size: 2}, Slice[Immediate]{data: ?acquire[0], size: 1}))  { ret 14; }

    var floats: [2]Type = [2]Type{f32, f32};
    var ints:   [2]Type = [2]Type{i32, i32};
    if (!accepts(k, out, table.FLT_O, Slice[Type]{data: ?floats[0], size: 2}, Slice[Immediate]{data: nil, size: 0})) { ret 15; }
    if (accepts(k, out, table.FLT_O, Slice[Type]{data: ?ints[0], size: 2}, Slice[Immediate]{data: nil, size: 0}))    { ret 16; }
    ret 0;
}
