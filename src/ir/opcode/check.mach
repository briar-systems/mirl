# the one checker: types an instance of a row by interpreting the row's rules
#
# no opcode is named here. a row states its typing and this reads it, so the
# verifier, the parser and every pass that builds an instruction type it the
# same way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.inline;
use mirl.base.slice;
use ia: mirl.ir.assembly;
use ni: mirl.ir.native;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.divides;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Allowed;
use mirl.ir.opcode.rule.Bound;
use mirl.ir.opcode.rule.Cases;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Lane;
use mirl.ir.opcode.rule.Member;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.rule.holds;
use mirl.ir.opcode.table;
use mirl.ir.place.Named;
use mirl.ir.type.format;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;

use mo: masc.core.operand;

# one edge of an instance: the arguments it passes and the parameters of its target
pub rec Edge {
    arguments:  Slice[Type];
    parameters: Slice[Type];
}

# what the checker reads of one instruction
# ---
# operands:   the operand types, the fixed operands then the tail
# secret:     whether each operand is secret, one per operand
# declared:   the instruction's own secrecy mark
# kept:       the instruction's kept mark
# bounded:    the instruction's count-bounded mark
# checked:    the instruction's checked mark
# oriented:   whether the instruction carries an ascending or descending mark
# immediates: the immediates, one per slot of the row
# edges:      the edges to its targets, in order
# returns:    the result types of the function it is in
pub rec Instance {
    operands:   Slice[Type];
    secret:     Slice[bool];
    declared:   bool;
    kept:       bool;
    bounded:    bool;
    checked:    bool;
    oriented:   bool;
    immediates: Slice[Immediate];
    edges:      Slice[Edge];
    returns:    Slice[Type];
}

# why the checker refused an instance
# ---
# alloc:      the allocator refused storage for a result
# types:      the type table refused a read or an intern
# opcode:     an opcode that names no row
# operands:   this many operands, not what the row takes
# secrecy:    this many secrecy marks, not one per operand
# immediates: this many immediates, not what the row takes
# immediate:  the immediate at this position holds the wrong kind
# alignment:  an alignment that is not a power of two
# targets:    this many targets, not what the row takes
# arguments:  the edge at this position passes arguments that are not its
#             target's parameters
# subject:    a rule names a subject that is not a type of the instance
# class:      the subject is not in the class
# agree:      the two subjects are different types
# parameters: the tail operands are not the parameters of the signature
# returns:    the tail operands are not the function's results
# unsized:    a subject compared by bits has no stated bit width
# conform:    one subject is a vector and the other is not, or their lane
#             counts differ
# element:    the lane types of the two subjects differ
# wider:      the left subject does not have more bits than the right
# bits:       the two subjects have different numbers of bits
# lane:       the lane immediate at this position indexes past the vectors
# count:      the lane list at this position is not one index per lane
# lanes_of:   the tail operands are not the lanes of the vector
# ordering:   the ordering immediate at this position is not one allowed
# named:      the named count at this position is unstated or names more
#             arguments than the signature has
# places:     the place list at this position is not one place per piece
# member:     the member index at this position names no member of the
#             aggregate
# fits:       the subject is not the type of the member
# cases:      the case list at this position is not one value per target
#             after the first, in strictly increasing order and each within
#             the selector's width, or the selector is wider than 64 bits
# kept:       a kept mark on a row whose effects are not keepable
# bounded:    a count-bounded mark on a row with no shift count
# checked:    a checked mark on a row with no zero, overflow or exceeds trap
# oriented:   an ascending or descending mark on a row whose effects are not
#             orientable
# assembly:   the block at this position is malformed, an operand of no name
#             or of a name another has, a role its constraint takes no part
#             in, a type its constraint holds no value of, or more operands
#             than one block binds, or the tail operands are not the values
#             it binds
# op:         the target op at this position names no set or no op, states
#             a result of a type no value holds, or touches memory where its
#             row does not, or none where its row does
# words:      the tail operands are not an even count of at least two
#             integers of one width
pub tag Error: u8 {
    alloc:      allocator.Error;
    types:      type_table.Error;
    opcode:     Opcode;
    operands:   u32;
    secrecy:    u32;
    immediates: u32;
    immediate:  u32;
    alignment:  u64;
    targets:    u32;
    arguments:  u32;
    subject:    Subject;
    class:      Bound;
    agree:      Pair;
    parameters;
    returns;
    unsized: Subject;
    conform: Pair;
    element: Pair;
    wider:   Pair;
    bits:    Pair;
    lane:    u32;
    count:   u32;
    lanes_of;
    ordering: u32;
    named:    u32;
    places:   u32;
    member:   u32;
    fits:     Subject;
    cases:    u32;
    kept;
    bounded;
    checked;
    oriented;
    assembly: u32;
    op:       u32;
    words;
}

# the allocator's refusal `e` stands for, its own or a step's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    if (sel e.types) { ret type_table.starved(e.types); }
    ret opt[allocator.Error].none{};
}

fun subject(inst: *Instance, s: Subject) res[Type, Error] {
    if (sel s.operand) { ret res[Type, Error].ok{inst.operands.data[s.operand]}; }
    if (sel s.immediate) {
        val imm: Immediate = inst.immediates.data[s.immediate];
        if (sel imm.ty) { ret res[Type, Error].ok{imm.ty}; }
    }
    ret res[Type, Error].err{Error.subject{s}};
}

fun admits(t: *type_table.Table, r: *Row, class: Class, ty: Type) res[bool, Error] {
    var lane: Type = ty;
    if (sel r.vector.lanewise || sel r.vector.across) {
        val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
        if (sel res_shape_at.err)       { ret res[bool, Error].err{Error.types{res_shape_at.err}}; }
        if (sel res_shape_at.ok.vector) { lane = res_shape_at.ok.vector.element; }
        or (sel r.vector.across)        { ret res[bool, Error].ok{false}; }
    }
    val res_within: res[bool, type_table.Error] = within(t, class, lane);
    if (sel res_within.err) { ret res[bool, Error].err{Error.types{res_within.err}}; }
    ret res[bool, Error].ok{res_within.ok};
}

# whether a type, tested whole, is in a class
# ---
# t:     the type table
# class: the class
# ty:    the type
# ret:   whether it is, or the type table's refusal
pub fun within(t: *type_table.Table, class: Class, ty: Type) res[bool, type_table.Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel res_shape_at.err) { ret res[bool, type_table.Error].err{res_shape_at.err}; }
    val s: *type_table.Shape = res_shape_at.ok;
    if (sel class.any)       { ret res[bool, type_table.Error].ok{true}; }
    if (sel class.integer)   { ret res[bool, type_table.Error].ok{sel s.integer}; }
    if (sel class.width)     { ret res[bool, type_table.Error].ok{sel s.integer && s.integer.width == class.width}; }
    if (sel class.float)     { ret res[bool, type_table.Error].ok{sel s.float}; }
    if (sel class.format)    { ret res[bool, type_table.Error].ok{sel s.float && s.float.format == class.format}; }
    if (sel class.pointer)   { ret res[bool, type_table.Error].ok{sel s.pointer}; }
    if (sel class.function)  { ret res[bool, type_table.Error].ok{sel s.function}; }
    if (sel class.bytes)     { ret res[bool, type_table.Error].ok{sel s.integer && s.integer.width % 8 == 0}; }
    if (sel class.vector)    { ret res[bool, type_table.Error].ok{sel s.vector}; }
    if (sel class.scalar)    { ret res[bool, type_table.Error].ok{sel s.integer || sel s.float || sel s.pointer}; }
    if (sel class.structure) { ret res[bool, type_table.Error].ok{sel s.structure}; }
    if (sel class.array)     { ret res[bool, type_table.Error].ok{sel s.array}; }
    if (sel class.aggregate) { ret res[bool, type_table.Error].ok{sel s.structure || sel s.array || sel s.union}; }
    ret res[bool, type_table.Error].ok{false};
}

# the bits of a type counted from the type table and the number format table,
# zero for a type with no stated bit width
fun bits(t: *type_table.Table, ty: Type) res[u64, Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel res_shape_at.err)        { ret res[u64, Error].err{Error.types{res_shape_at.err}}; }
    if (sel res_shape_at.ok.integer) { ret res[u64, Error].ok{res_shape_at.ok.integer.width::u64}; }
    if (sel res_shape_at.ok.float) {
        val opt_row: opt[format.Row] = format.row(res_shape_at.ok.float.format);
        if (sel opt_row.none) { ret res[u64, Error].err{Error.types{type_table.Error.format{res_shape_at.ok.float.format}}}; }
        ret res[u64, Error].ok{opt_row.some.width::u64};
    }
    if (sel res_shape_at.ok.vector) {
        val res_bits: res[u64, Error] = bits(t, res_shape_at.ok.vector.element);
        if (sel res_bits.err) { ret res_bits; }
        ret res[u64, Error].ok{res_bits.ok * res_shape_at.ok.vector.lanes::u64};
    }
    ret res[u64, Error].ok{0};
}

# the lane count of a vector type, zero for any other
fun lane_count(t: *type_table.Table, ty: Type) res[u32, Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel res_shape_at.err)       { ret res[u32, Error].err{Error.types{res_shape_at.err}}; }
    if (sel res_shape_at.ok.vector) { ret res[u32, Error].ok{res_shape_at.ok.vector.lanes}; }
    ret res[u32, Error].ok{0};
}

# the lane type of a vector type, and any other type is its own
fun lane_type(t: *type_table.Table, ty: Type) res[Type, Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel res_shape_at.err)       { ret res[Type, Error].err{Error.types{res_shape_at.err}}; }
    if (sel res_shape_at.ok.vector) { ret res[Type, Error].ok{res_shape_at.ok.vector.element}; }
    ret res[Type, Error].ok{ty};
}

fun tail(inst: *Instance, from: u32) Slice[Type] {
    ret Slice[Type]{data: ?inst.operands.data[from], size: inst.operands.size - from::usize};
}

fun push(out: *vector.Vector[Type], ty: Type) err[Error] {
    val res_out_pushed: res[usize, allocator.Error] = vector.push[Type](out, ty);
    if (sel res_out_pushed.err) { ret err[Error].err{Error.alloc{res_out_pushed.err}}; }
    ret err[Error].ok{};
}

fun mask(t: *type_table.Table, ty: Type) res[Type, Error] {
    val res_bit: res[Type, type_table.Error] = type_table.intern(t, type_table.Shape.integer{type_table.Integer{width: 1}});
    if (sel res_bit.err) { ret res[Type, Error].err{Error.types{res_bit.err}}; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(t, ty);
    if (sel res_shape.err)          { ret res[Type, Error].err{Error.types{res_shape.err}}; }
    if (!(sel res_shape.ok.vector)) { ret res[Type, Error].ok{res_bit.ok}; }
    val res_lanes: res[Type, type_table.Error] = type_table.intern(t, type_table.Shape.vector{type_table.Vector{lanes: res_shape.ok.vector.lanes, element: res_bit.ok}});
    if (sel res_lanes.err) { ret res[Type, Error].err{Error.types{res_lanes.err}}; }
    ret res[Type, Error].ok{res_lanes.ok};
}

fun shape_of(r: *Row, inst: *Instance) err[Error] {
    val operands: u32 = fixed(r);
    val given:    u32 = inst.operands.size::u32;
    if ((sel r.tail.unstated && given != operands) || given < operands) { ret err[Error].err{Error.operands{given}}; }
    if (inst.secret.size != inst.operands.size)                         { ret err[Error].err{Error.secrecy{inst.secret.size::u32}}; }

    val count: u32 = slots(r);
    if (inst.immediates.size != count::usize) { ret err[Error].err{Error.immediates{inst.immediates.size::u32}}; }
    var i: u32 = 0;
    for (i < count) {
        val imm: Immediate = inst.immediates.data[i];
        if (sel r.immediates[i].holds.ty && !(sel imm.ty))             { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.ordering && !(sel imm.ordering)) { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.lane && !(sel imm.lane))         { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.lanes && !(sel imm.lanes))       { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.named && !(sel imm.named))       { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.places && !(sel imm.places))     { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.member && !(sel imm.member))     { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.cases && !(sel imm.cases))       { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.function && !(sel imm.function)) { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.assembly && !(sel imm.assembly)) { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.op && !(sel imm.op))             { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.state && !(sel imm.state))       { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.alignment) {
            if (!(sel imm.alignment)) { ret err[Error].err{Error.immediate{i}}; }
            val a: u64 = imm.alignment;
            if (a == 0 || (a & (a - 1)) != 0) { ret err[Error].err{Error.alignment{a}}; }
        }
        i = i + 1;
    }

    val edges: u32 = inst.edges.size::u32;
    if (sel r.targets.exact && edges != r.targets.exact)      { ret err[Error].err{Error.targets{edges}}; }
    if (sel r.targets.at_least && edges < r.targets.at_least) { ret err[Error].err{Error.targets{edges}}; }
    i = 0;
    for (i < edges) {
        val e: Edge = inst.edges.data[i];
        if (!type_table.same_list(e.arguments, e.parameters)) { ret err[Error].err{Error.arguments{i}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun pair_types(inst: *Instance, p: Pair, left: *Type, right: *Type) err[Error] {
    val res_subject: res[Type, Error] = subject(inst, p.left);
    if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
    val res_subject_inst: res[Type, Error] = subject(inst, p.right);
    if (sel res_subject_inst.err) { ret err[Error].err{res_subject_inst.err}; }
    @left  = res_subject.ok;
    @right = res_subject_inst.ok;
    ret err[Error].ok{};
}

fun lanes_in(t: *type_table.Table, inst: *Instance, ln: Lane) err[Error] {
    val res_subject: res[Type, Error] = subject(inst, ln.over.left);
    if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
    val res_left: res[u32, Error] = lane_count(t, res_subject.ok);
    if (sel res_left.err) { ret err[Error].err{res_left.err}; }
    var bound: u32 = res_left.ok;
    if (!(sel ln.over.right.unstated)) {
        val res_subject: res[Type, Error] = subject(inst, ln.over.right);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_right: res[u32, Error] = lane_count(t, res_subject.ok);
        if (sel res_right.err) { ret err[Error].err{res_right.err}; }
        bound = bound + res_right.ok;
    }
    val imm: Immediate = inst.immediates.data[ln.slot];
    if (sel imm.lane && imm.lane >= bound) { ret err[Error].err{Error.lane{ln.slot}}; }
    if (sel imm.lanes) {
        var i: usize = 0;
        for (i < imm.lanes.size) {
            if (imm.lanes.data[i] >= bound) { ret err[Error].err{Error.lane{ln.slot}}; }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

fun allowed(a: Allowed, inst: *Instance) bool {
    val imm: Immediate = inst.immediates.data[a.slot];
    if (!(sel imm.ordering)) { ret false; }
    ret holds(a.orderings, imm.ordering);
}

fun lanes_given(t: *type_table.Table, r: *Row, inst: *Instance, s: Subject) err[Error] {
    val res_subject: res[Type, Error] = subject(inst, s);
    if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
    val res_lane_count: res[u32, Error] = lane_count(t, res_subject.ok);
    if (sel res_lane_count.err) { ret err[Error].err{res_lane_count.err}; }
    val res_lane: res[Type, Error] = lane_type(t, res_subject.ok);
    if (sel res_lane.err) { ret err[Error].err{res_lane.err}; }
    val given: Slice[Type] = tail(inst, fixed(r));
    if (res_lane_count.ok == 0 || given.size != res_lane_count.ok::usize) { ret err[Error].err{Error.lanes_of{}}; }
    var i: usize = 0;
    for (i < given.size) {
        if (!type_table.same(given.data[i], res_lane.ok)) { ret err[Error].err{Error.lanes_of{}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the word type of a tail of words, an even count of at least two integers of one width
fun words_of(t: *type_table.Table, r: *Row, inst: *Instance) res[Type, Error] {
    val given: Slice[Type] = tail(inst, fixed(r));
    if (given.size < 2 || given.size % 2 != 0) { ret res[Type, Error].err{Error.words{}}; }
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, given.data[0]);
    if (sel res_shape_at.err)           { ret res[Type, Error].err{Error.types{res_shape_at.err}}; }
    if (!(sel res_shape_at.ok.integer)) { ret res[Type, Error].err{Error.words{}}; }
    var i: usize = 1;
    for (i < given.size) {
        if (!type_table.same(given.data[i], given.data[0])) { ret res[Type, Error].err{Error.words{}}; }
        i = i + 1;
    }
    ret res[Type, Error].ok{given.data[0]};
}

fun related(t: *type_table.Table, inst: *Instance, rl: Rule) err[Error] {
    var left:           Type;
    var right:          Type;
    val pair:           Pair       = pair_of(rl);
    val err_pair_types: err[Error] = pair_types(inst, pair, ?left, ?right);
    if (sel err_pair_types.err) { ret err_pair_types; }
    if (sel rl.conform) {
        val res_lane_count: res[u32, Error] = lane_count(t, left);
        if (sel res_lane_count.err) { ret err[Error].err{res_lane_count.err}; }
        val res_lane_count_right: res[u32, Error] = lane_count(t, right);
        if (sel res_lane_count_right.err)                 { ret err[Error].err{res_lane_count_right.err}; }
        if (res_lane_count.ok != res_lane_count_right.ok) { ret err[Error].err{Error.conform{pair}}; }
    }
    or (sel rl.element) {
        val res_lane_type: res[Type, Error] = lane_type(t, left);
        if (sel res_lane_type.err) { ret err[Error].err{res_lane_type.err}; }
        val res_lane_type_right: res[Type, Error] = lane_type(t, right);
        if (sel res_lane_type_right.err)                                { ret err[Error].err{res_lane_type_right.err}; }
        if (!type_table.same(res_lane_type.ok, res_lane_type_right.ok)) { ret err[Error].err{Error.element{pair}}; }
    }
    or {
        val res_bits: res[u64, Error] = bits(t, left);
        if (sel res_bits.err) { ret err[Error].err{res_bits.err}; }
        val res_bits_right: res[u64, Error] = bits(t, right);
        if (sel res_bits_right.err)                           { ret err[Error].err{res_bits_right.err}; }
        if (res_bits.ok == 0)                                 { ret err[Error].err{Error.unsized{pair.left}}; }
        if (res_bits_right.ok == 0)                           { ret err[Error].err{Error.unsized{pair.right}}; }
        if (sel rl.wider && res_bits.ok <= res_bits_right.ok) { ret err[Error].err{Error.wider{pair}}; }
        if (sel rl.bits && res_bits.ok != res_bits_right.ok)  { ret err[Error].err{Error.bits{pair}}; }
    }
    ret err[Error].ok{};
}

fun pair_of(rl: Rule) Pair {
    if (sel rl.conform) { ret rl.conform; }
    if (sel rl.element) { ret rl.element; }
    if (sel rl.wider)   { ret rl.wider; }
    if (sel rl.bits)    { ret rl.bits; }
    var none: Pair;
    ret none;
}

# the type of the member a member immediate names of an aggregate subject,
# refusing an index past its members or elements
fun member_type(t: *type_table.Table, inst: *Instance, mb: Member) res[Type, Error] {
    val res_subject: res[Type, Error] = subject(inst, mb.of);
    if (sel res_subject.err) { ret res_subject; }
    val imm: Immediate = inst.immediates.data[mb.slot];
    if (!(sel imm.member)) { ret res[Type, Error].err{Error.member{mb.slot}}; }
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, res_subject.ok);
    if (sel res_shape_at.err) { ret res[Type, Error].err{Error.types{res_shape_at.err}}; }
    if (sel res_shape_at.ok.structure) {
        if (imm.member::usize >= res_shape_at.ok.structure.members.size) { ret res[Type, Error].err{Error.member{mb.slot}}; }
        ret res[Type, Error].ok{res_shape_at.ok.structure.members.data[imm.member]};
    }
    if (sel res_shape_at.ok.array) {
        if (imm.member::u64 >= res_shape_at.ok.array.count) { ret res[Type, Error].err{Error.member{mb.slot}}; }
        ret res[Type, Error].ok{res_shape_at.ok.array.element};
    }
    if (sel res_shape_at.ok.union) {
        if (imm.member::usize >= res_shape_at.ok.union.members.size) { ret res[Type, Error].err{Error.member{mb.slot}}; }
        ret res[Type, Error].ok{res_shape_at.ok.union.members.data[imm.member]};
    }
    ret res[Type, Error].err{Error.class{Bound{subject: mb.of, class: Class.aggregate{}}}};
}

# a case list holds one value per target after the first, in strictly
# increasing order, each within the width of a selector of at most 64 bits
fun cases_hold(t: *type_table.Table, inst: *Instance, cs: Cases) err[Error] {
    val res_subject: res[Type, Error] = subject(inst, cs.of);
    if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
    val res_width: res[u32, type_table.Error] = type_table.width(t, res_subject.ok);
    if (sel res_width.err) { ret err[Error].err{Error.types{res_width.err}}; }
    if (res_width.ok > 64) { ret err[Error].err{Error.cases{cs.slot}}; }
    val imm: Immediate = inst.immediates.data[cs.slot];
    if (!(sel imm.cases)) { ret err[Error].err{Error.cases{cs.slot}}; }
    val list: Slice[u64] = imm.cases;
    if (inst.edges.size == 0 || list.size != inst.edges.size - 1) { ret err[Error].err{Error.cases{cs.slot}}; }
    var i: usize = 0;
    for (i < list.size) {
        if (res_width.ok < 64 && (list.data[i] >> res_width.ok::u64) != 0) { ret err[Error].err{Error.cases{cs.slot}}; }
        if (i > 0 && list.data[i] <= list.data[i - 1])                     { ret err[Error].err{Error.cases{cs.slot}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun rule(t: *type_table.Table, r: *Row, inst: *Instance, rl: Rule) err[Error] {
    if (sel rl.is) {
        val res_subject: res[Type, Error] = subject(inst, rl.is.subject);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_admits: res[bool, Error] = admits(t, r, rl.is.class, res_subject.ok);
        if (sel res_admits.err) { ret err[Error].err{res_admits.err}; }
        if (!res_admits.ok)     { ret err[Error].err{Error.class{rl.is}}; }
    }
    or (sel rl.agree) {
        val res_left: res[Type, Error] = subject(inst, rl.agree.left);
        if (sel res_left.err) { ret err[Error].err{res_left.err}; }
        val res_right: res[Type, Error] = subject(inst, rl.agree.right);
        if (sel res_right.err)                           { ret err[Error].err{res_right.err}; }
        if (!type_table.same(res_left.ok, res_right.ok)) { ret err[Error].err{Error.agree{rl.agree}}; }
    }
    or (sel rl.parameters) {
        val res_sig: res[Type, Error] = subject(inst, rl.parameters);
        if (sel res_sig.err) { ret err[Error].err{res_sig.err}; }
        val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(t, res_sig.ok);
        if (sel res_signature.err)                                                { ret err[Error].err{Error.types{res_signature.err}}; }
        if (!type_table.same_list(tail(inst, fixed(r)), res_signature.ok.params)) { ret err[Error].err{Error.parameters{}}; }
    }
    or (sel rl.returns) {
        if (!type_table.same_list(tail(inst, fixed(r)), inst.returns)) { ret err[Error].err{Error.returns{}}; }
    }
    or (sel rl.conform || sel rl.element || sel rl.wider || sel rl.bits) {
        ret related(t, inst, rl);
    }
    or (sel rl.lane) {
        ret lanes_in(t, inst, rl.lane);
    }
    or (sel rl.count) {
        val res_subject: res[Type, Error] = subject(inst, rl.count.of);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_lane_count: res[u32, Error] = lane_count(t, res_subject.ok);
        if (sel res_lane_count.err) { ret err[Error].err{res_lane_count.err}; }
        val imm: Immediate = inst.immediates.data[rl.count.slot];
        if (!(sel imm.lanes))                           { ret err[Error].err{Error.count{rl.count.slot}}; }
        if (imm.lanes.size != res_lane_count.ok::usize) { ret err[Error].err{Error.count{rl.count.slot}}; }
    }
    or (sel rl.lanes_of) {
        ret lanes_given(t, r, inst, rl.lanes_of);
    }
    or (sel rl.ordering) {
        if (!allowed(rl.ordering, inst)) { ret err[Error].err{Error.ordering{rl.ordering.slot}}; }
    }
    or (sel rl.named) {
        val res_sig: res[Type, Error] = subject(inst, rl.named.of);
        if (sel res_sig.err) { ret err[Error].err{res_sig.err}; }
        val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(t, res_sig.ok);
        if (sel res_signature.err) { ret err[Error].err{Error.types{res_signature.err}}; }
        val imm: Immediate = inst.immediates.data[rl.named.slot];
        if (!(sel imm.named)) { ret err[Error].err{Error.named{rl.named.slot}}; }
        val n: Named = imm.named;
        if (sel n.unstated)                                               { ret err[Error].err{Error.named{rl.named.slot}}; }
        if (sel n.first && n.first::usize > res_signature.ok.params.size) { ret err[Error].err{Error.named{rl.named.slot}}; }
    }
    or (sel rl.places) {
        var want: usize = inst.operands.size - fixed(r)::usize;
        if (!(sel rl.places.of.unstated)) {
            val res_sig: res[Type, Error] = subject(inst, rl.places.of);
            if (sel res_sig.err) { ret err[Error].err{res_sig.err}; }
            val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(t, res_sig.ok);
            if (sel res_signature.err) { ret err[Error].err{Error.types{res_signature.err}}; }
            want = res_signature.ok.params.size + res_signature.ok.results.size;
        }
        val imm: Immediate = inst.immediates.data[rl.places.slot];
        if (!(sel imm.places))       { ret err[Error].err{Error.places{rl.places.slot}}; }
        if (imm.places.size != want) { ret err[Error].err{Error.places{rl.places.slot}}; }
    }
    or (sel rl.member) {
        val res_member_type: res[Type, Error] = member_type(t, inst, rl.member);
        if (sel res_member_type.err) { ret err[Error].err{res_member_type.err}; }
    }
    or (sel rl.fits) {
        val res_subject: res[Type, Error] = subject(inst, rl.fits.subject);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_want: res[Type, Error] = member_type(t, inst, rl.fits.member);
        if (sel res_want.err)                              { ret err[Error].err{res_want.err}; }
        if (!type_table.same(res_subject.ok, res_want.ok)) { ret err[Error].err{Error.fits{rl.fits.subject}}; }
    }
    or (sel rl.cases) {
        ret cases_hold(t, inst, rl.cases);
    }
    or (sel rl.assembly) {
        ret assembly_holds(t, r, inst, rl.assembly);
    }
    or (sel rl.op) {
        ret op_holds(t, r, inst, rl.op);
    }
    or (sel rl.words) {
        val res_words_of: res[Type, Error] = words_of(t, r, inst);
        if (sel res_words_of.err) { ret err[Error].err{res_words_of.err}; }
    }
    ret err[Error].ok{};
}

# whether a type is one a value holds: anything but a function type
fun valued(t: *type_table.Table, ty: Type) res[bool, type_table.Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, ty);
    if (sel res_shape_at.err) { ret res[bool, type_table.Error].err{res_shape_at.err}; }
    ret res[bool, type_table.Error].ok{!(sel res_shape_at.ok.function)};
}

# whether the target op at slot `slot` names a set and an op, states results
# values hold, and touches memory exactly when its row may
fun op_holds(t: *type_table.Table, r: *Row, inst: *Instance, slot: u32) err[Error] {
    val imm: Immediate = inst.immediates.data[slot];
    if (!(sel imm.op)) { ret err[Error].err{Error.op{slot}}; }
    val o: *ni.Op = imm.op;
    if (o.set.len == 0 || o.name.len == 0)                      { ret err[Error].err{Error.op{slot}}; }
    if (ni.touches(o) != (r.effects.reads || r.effects.writes)) { ret err[Error].err{Error.op{slot}}; }
    var k: usize = 0;
    for (k < o.results.size) {
        val res_held: res[bool, type_table.Error] = valued(t, o.results.data[k]);
        if (sel res_held.err) { ret err[Error].err{Error.types{res_held.err}}; }
        if (!res_held.ok)     { ret err[Error].err{Error.op{slot}}; }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# whether a type is one a block's operand of placement `o` binds: a value a
# register holds for a register class or a placement by value, an address for
# memory, and an integer or, where a symbol may stand for it, an address for an
# immediate. a chosen constraint is masc's, never stated in the ir
fun binds(t: *type_table.Table, o: *ia.Operand) res[bool, type_table.Error] {
    val res_shape_at: res[*type_table.Shape, type_table.Error] = type_table.shape_at(t, o.ty);
    if (sel res_shape_at.err) { ret res[bool, type_table.Error].err{res_shape_at.err}; }
    val s:      *type_table.Shape = res_shape_at.ok;
    val scalar: bool              = sel s.integer || sel s.float || sel s.pointer || sel s.vector;
    if (sel o.placement.value) { ret res[bool, type_table.Error].ok{scalar}; }
    val c: inline.Constraint = o.placement.stated;
    if (sel c.class)  { ret res[bool, type_table.Error].ok{scalar}; }
    if (sel c.memory) { ret res[bool, type_table.Error].ok{sel s.pointer}; }
    if (sel c.immediate) {
        if (sel s.integer) { ret res[bool, type_table.Error].ok{true}; }
        ret res[bool, type_table.Error].ok{c.immediate.symbolic && sel s.pointer};
    }
    ret res[bool, type_table.Error].ok{false};
}

# whether a role is one a block's operand of its placement takes: a register
# or memory read, written or both, and an immediate read. only memory and a
# placement by value, which may be memory, state what a pointer it holds reaches
fun cast(o: *ia.Operand) bool {
    val stated_memory: bool = ia.memory(o);
    if (!(sel o.points.unstated) && !stated_memory && !(sel o.placement.value)) { ret false; }
    if (sel o.placement.stated && sel o.placement.stated.immediate)             { ret o.role == mo.READ; }
    ret o.role == mo.READ || o.role == mo.WRITE || o.role == mo.READ_WRITE;
}

# whether the block at slot `slot` is well formed and the tail operands are the values it binds
fun assembly_holds(t: *type_table.Table, r: *Row, inst: *Instance, slot: u32) err[Error] {
    val imm: Immediate = inst.immediates.data[slot];
    if (!(sel imm.assembly)) { ret err[Error].err{Error.assembly{slot}}; }
    val b: *ia.Assembly = imm.assembly;
    if (b.operands.size > ia.MOST_OPERANDS::usize) { ret err[Error].err{Error.assembly{slot}}; }
    val from: u32   = fixed(r);
    var at:   usize = from::usize;
    var k:    usize = 0;
    for (k < b.operands.size) {
        val o: *ia.Operand = ?b.operands.data[k];
        if (o.name.len == 0 || !cast(o)) { ret err[Error].err{Error.assembly{slot}}; }
        var j: usize = 0;
        for (j < k) {
            if (slice.same_view(b.operands.data[j].name, o.name)) { ret err[Error].err{Error.assembly{slot}}; }
            j = j + 1;
        }
        val res_held: res[bool, type_table.Error] = binds(t, o);
        if (sel res_held.err) { ret err[Error].err{Error.types{res_held.err}}; }
        if (!res_held.ok)     { ret err[Error].err{Error.assembly{slot}}; }
        if (ia.takes(o)) {
            if (at >= inst.operands.size)                       { ret err[Error].err{Error.assembly{slot}}; }
            if (!type_table.same(inst.operands.data[at], o.ty)) { ret err[Error].err{Error.assembly{slot}}; }
            at = at + 1;
        }
        k = k + 1;
    }
    if (at != inst.operands.size) { ret err[Error].err{Error.assembly{slot}}; }
    ret err[Error].ok{};
}

fun result(t: *type_table.Table, r: *Row, inst: *Instance, rs: Result, out: *vector.Vector[Type]) err[Error] {
    if (sel rs.words) {
        val res_words_of: res[Type, Error] = words_of(t, r, inst);
        if (sel res_words_of.err) { ret err[Error].err{res_words_of.err}; }
        var k: usize = 0;
        for (k < (inst.operands.size - fixed(r)::usize) / 2) {
            val err_out_pushed: err[Error] = push(out, res_words_of.ok);
            if (sel err_out_pushed.err) { ret err_out_pushed; }
            k = k + 1;
        }
        ret err[Error].ok{};
    }
    if (sel rs.member) {
        val res_member_type: res[Type, Error] = member_type(t, inst, rs.member);
        if (sel res_member_type.err) { ret err[Error].err{res_member_type.err}; }
        ret push(out, res_member_type.ok);
    }
    if (sel rs.element) {
        val res_subject: res[Type, Error] = subject(inst, rs.element);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(t, res_subject.ok);
        if (sel res_shape.err)          { ret err[Error].err{Error.types{res_shape.err}}; }
        if (!(sel res_shape.ok.vector)) { ret err[Error].err{Error.class{Bound{subject: rs.element, class: Class.vector{}}}}; }
        ret push(out, res_shape.ok.vector.element);
    }
    if (sel rs.same) {
        val res_subject: res[Type, Error] = subject(inst, rs.same);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        ret push(out, res_subject.ok);
    }
    if (sel rs.mask) {
        val res_subject: res[Type, Error] = subject(inst, rs.mask);
        if (sel res_subject.err) { ret err[Error].err{res_subject.err}; }
        val res_mask: res[Type, Error] = mask(t, res_subject.ok);
        if (sel res_mask.err) { ret err[Error].err{res_mask.err}; }
        ret push(out, res_mask.ok);
    }
    if (sel rs.assembly) {
        val imm: Immediate = inst.immediates.data[rs.assembly];
        if (!(sel imm.assembly)) { ret err[Error].err{Error.assembly{rs.assembly}}; }
        val b: *ia.Assembly = imm.assembly;
        var k: usize        = 0;
        for (k < b.operands.size) {
            if (ia.gives(?b.operands.data[k])) {
                val err_out_pushed: err[Error] = push(out, b.operands.data[k].ty);
                if (sel err_out_pushed.err) { ret err_out_pushed; }
            }
            k = k + 1;
        }
    }
    if (sel rs.op) {
        val imm: Immediate = inst.immediates.data[rs.op];
        if (!(sel imm.op)) { ret err[Error].err{Error.op{rs.op}}; }
        val o: *ni.Op = imm.op;
        var k: usize  = 0;
        for (k < o.results.size) {
            val err_out_pushed: err[Error] = push(out, o.results.data[k]);
            if (sel err_out_pushed.err) { ret err_out_pushed; }
            k = k + 1;
        }
    }
    if (sel rs.results) {
        val res_sig: res[Type, Error] = subject(inst, rs.results);
        if (sel res_sig.err) { ret err[Error].err{res_sig.err}; }
        val res_signature: res[type_table.Function, type_table.Error] = type_table.signature(t, res_sig.ok);
        if (sel res_signature.err) { ret err[Error].err{Error.types{res_signature.err}}; }
        var i: usize = 0;
        for (i < res_signature.ok.results.size) {
            val err_out_pushed: err[Error] = push(out, res_signature.ok.results.data[i]);
            if (sel err_out_pushed.err) { ret err_out_pushed; }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

fun secrecy(r: *Row, inst: *Instance) bool {
    if (sel r.secrecy.declared)      { ret inst.declared; }
    if (!(sel r.secrecy.propagates)) { ret false; }
    var i: usize = 0;
    for (i < inst.secret.size) {
        if (inst.secret.data[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

# type an instance of an opcode
# ---
# t:    the type table the instance's types are in
# op:   the opcode
# inst: the instance
# out:  where the result types are pushed, in order
# ret:  whether its results are secret, by the row's secrecy rule, or the
#       first rule the instance breaks
pub fun check(t: *type_table.Table, op: Opcode, inst: Instance, out: *vector.Vector[Type]) res[bool, Error] {
    val opt_found: opt[*Row] = table.at(op);
    if (sel opt_found.none) { ret res[bool, Error].err{Error.opcode{op}}; }
    ret check_row(t, opt_found.some, ?inst, out);
}

# whether a row reads the result types of the function its instance is in,
# which an instance of any other row may leave empty
pub fun takes_returns(r: *Row) bool {
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel r.rules[i].unstated)) {
        if (sel r.rules[i].returns) { ret true; }
        i = i + 1;
    }
    ret false;
}

# type an instance of a row already looked up, as `check`
pub fun check_row(t: *type_table.Table, r: *Row, inst: *Instance, out: *vector.Vector[Type]) res[bool, Error] {
    if (inst.kept && !r.effects.keepable)       { ret res[bool, Error].err{Error.kept{}}; }
    if (inst.bounded && sel r.overshift.none)   { ret res[bool, Error].err{Error.bounded{}}; }
    if (inst.checked && !divides(r))            { ret res[bool, Error].err{Error.checked{}}; }
    if (inst.oriented && !r.effects.orientable) { ret res[bool, Error].err{Error.oriented{}}; }

    val err_shaped: err[Error] = shape_of(r, inst);
    if (sel err_shaped.err) { ret res[bool, Error].err{err_shaped.err}; }
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel r.rules[i].unstated)) {
        val err_rule: err[Error] = rule(t, r, inst, r.rules[i]);
        if (sel err_rule.err) { ret res[bool, Error].err{err_rule.err}; }
        i = i + 1;
    }
    val start: usize = out.len;
    i = 0;
    for (i < $length_of(Results) && !(sel r.results[i].unstated)) {
        val err_result: err[Error] = result(t, r, inst, r.results[i], out);
        if (sel err_result.err) {
            vector.truncate[Type](out, start);
            ret res[bool, Error].err{err_result.err};
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{secrecy(r, inst)};
}
