# the one checker: types an instance of a row by interpreting the row's rules
#
# no opcode is named here. a row states its typing and this reads it, so the
# verifier, the parser and every pass that builds an instruction type it the
# same way.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Bound;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.table;
use types: mirl.ir.type;
use mirl.ir.type.Type;

# one edge of an instance: the arguments it passes and the parameters of its target
pub rec Edge {
    arguments:  Slice[Type];
    parameters: Slice[Type];
}

# what the checker reads of one instruction
# ---
# operands:   the operand types, the fixed operands then the tail
# secret:     whether each operand is secret, one per operand
# declared:   the instruction's own secrecy mark
# immediates: the immediates, one per slot of the row
# edges:      the edges to its targets, in order
# returns:    the result types of the function it is in
pub rec Instance {
    operands:   Slice[Type];
    secret:     Slice[bool];
    declared:   bool;
    immediates: Slice[Immediate];
    edges:      Slice[Edge];
    returns:    Slice[Type];
}

# why the checker refused an instance
# ---
# alloc:      the allocator refused storage for a result
# types:      the type table refused a read or an intern
# opcode:     an opcode that names no row
# operands:   this many operands, not what the row takes
# secrecy:    this many secrecy marks, not one per operand
# immediates: this many immediates, not what the row takes
# immediate:  the immediate at this position holds the wrong kind
# alignment:  an alignment that is not a power of two
# targets:    this many targets, not what the row takes
# arguments:  the edge at this position passes arguments that are not its
#             target's parameters
# subject:    a rule names a subject that is not a type of the instance
# class:      the subject is not in the class
# agree:      the two subjects are different types
# parameters: the tail operands are not the parameters of the signature
# returns:    the tail operands are not the function's results
pub tag Error: u8 {
    alloc:      allocator.Error;
    types:      types.Error;
    opcode:     Opcode;
    operands:   u32;
    secrecy:    u32;
    immediates: u32;
    immediate:  u32;
    alignment:  u64;
    targets:    u32;
    arguments:  u32;
    subject:    Subject;
    class:      Bound;
    agree:      Pair;
    parameters;
    returns;
}

fun subject(inst: *Instance, s: Subject) res[Type, Error] {
    if (sel s.operand) { ret res[Type, Error].ok{inst.operands.data[s.operand]}; }
    if (sel s.immediate) {
        val imm: Immediate = inst.immediates.data[s.immediate];
        if (sel imm.ty) { ret res[Type, Error].ok{imm.ty}; }
    }
    ret res[Type, Error].err{Error.subject{s}};
}

fun admits(t: *types.Table, r: *Row, class: Class, ty: Type) res[bool, Error] {
    var lane: Type = ty;
    if (sel r.vector.lanewise) {
        val e: res[types.Shape, types.Error] = types.shape(t, ty);
        if (sel e.err)       { ret res[bool, Error].err{Error.types{e.err}}; }
        if (sel e.ok.vector) { lane = e.ok.vector.element; }
    }
    val got: res[types.Shape, types.Error] = types.shape(t, lane);
    if (sel got.err) { ret res[bool, Error].err{Error.types{got.err}}; }
    val s: types.Shape = got.ok;
    if (sel class.any)      { ret res[bool, Error].ok{true}; }
    if (sel class.integer)  { ret res[bool, Error].ok{sel s.integer}; }
    if (sel class.width)    { ret res[bool, Error].ok{sel s.integer && s.integer.width == class.width}; }
    if (sel class.float)    { ret res[bool, Error].ok{sel s.float}; }
    if (sel class.pointer)  { ret res[bool, Error].ok{sel s.pointer}; }
    if (sel class.function) { ret res[bool, Error].ok{sel s.function}; }
    ret res[bool, Error].ok{false};
}

fun tail(inst: *Instance, from: u32) Slice[Type] {
    ret Slice[Type]{data: ?inst.operands.data[from], size: inst.operands.size - from::usize};
}

fun push(out: *vector.Vector[Type], ty: Type) err[Error] {
    val p: res[usize, allocator.Error] = vector.push[Type](out, ty);
    if (sel p.err) { ret err[Error].err{Error.alloc{p.err}}; }
    ret err[Error].ok{};
}

fun mask(t: *types.Table, ty: Type) res[Type, Error] {
    val bit: res[Type, types.Error] = types.intern(t, types.Shape.integer{types.Integer{width: 1}});
    if (sel bit.err) { ret res[Type, Error].err{Error.types{bit.err}}; }
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err)          { ret res[Type, Error].err{Error.types{s.err}}; }
    if (!(sel s.ok.vector)) { ret res[Type, Error].ok{bit.ok}; }
    val lanes: res[Type, types.Error] = types.intern(t, types.Shape.vector{types.Vector{lanes: s.ok.vector.lanes, element: bit.ok}});
    if (sel lanes.err) { ret res[Type, Error].err{Error.types{lanes.err}}; }
    ret res[Type, Error].ok{lanes.ok};
}

fun shape_of(r: *Row, inst: *Instance) err[Error] {
    val operands: u32 = fixed(r);
    val given:    u32 = inst.operands.size::u32;
    if ((sel r.tail.unstated && given != operands) || given < operands) { ret err[Error].err{Error.operands{given}}; }
    if (inst.secret.size != inst.operands.size)                         { ret err[Error].err{Error.secrecy{inst.secret.size::u32}}; }

    val count: u32 = slots(r);
    if (inst.immediates.size != count::usize) { ret err[Error].err{Error.immediates{inst.immediates.size::u32}}; }
    var i: u32 = 0;
    for (i < count) {
        val imm: Immediate = inst.immediates.data[i];
        if (sel r.immediates[i].holds.ty && !(sel imm.ty)) { ret err[Error].err{Error.immediate{i}}; }
        if (sel r.immediates[i].holds.alignment) {
            if (!(sel imm.alignment)) { ret err[Error].err{Error.immediate{i}}; }
            val a: u64 = imm.alignment;
            if (a == 0 || (a & (a - 1)) != 0) { ret err[Error].err{Error.alignment{a}}; }
        }
        i = i + 1;
    }

    val edges: u32 = inst.edges.size::u32;
    if (sel r.targets.exact && edges != r.targets.exact)      { ret err[Error].err{Error.targets{edges}}; }
    if (sel r.targets.at_least && edges < r.targets.at_least) { ret err[Error].err{Error.targets{edges}}; }
    i = 0;
    for (i < edges) {
        val e: Edge = inst.edges.data[i];
        if (!types.same_list(e.arguments, e.parameters)) { ret err[Error].err{Error.arguments{i}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun rule(t: *types.Table, r: *Row, inst: *Instance, rl: Rule) err[Error] {
    if (sel rl.is) {
        val ty: res[Type, Error] = subject(inst, rl.is.subject);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val ok: res[bool, Error] = admits(t, r, rl.is.class, ty.ok);
        if (sel ok.err) { ret err[Error].err{ok.err}; }
        if (!ok.ok)     { ret err[Error].err{Error.class{rl.is}}; }
    }
    or (sel rl.agree) {
        val left: res[Type, Error] = subject(inst, rl.agree.left);
        if (sel left.err) { ret err[Error].err{left.err}; }
        val right: res[Type, Error] = subject(inst, rl.agree.right);
        if (sel right.err)                  { ret err[Error].err{right.err}; }
        if (!types.same(left.ok, right.ok)) { ret err[Error].err{Error.agree{rl.agree}}; }
    }
    or (sel rl.parameters) {
        val sig: res[Type, Error] = subject(inst, rl.parameters);
        if (sel sig.err) { ret err[Error].err{sig.err}; }
        val f: res[types.Function, types.Error] = types.signature(t, sig.ok);
        if (sel f.err)                                           { ret err[Error].err{Error.types{f.err}}; }
        if (!types.same_list(tail(inst, fixed(r)), f.ok.params)) { ret err[Error].err{Error.parameters{}}; }
    }
    or (sel rl.returns) {
        if (!types.same_list(tail(inst, fixed(r)), inst.returns)) { ret err[Error].err{Error.returns{}}; }
    }
    ret err[Error].ok{};
}

fun result(t: *types.Table, inst: *Instance, rs: Result, out: *vector.Vector[Type]) err[Error] {
    if (sel rs.same) {
        val ty: res[Type, Error] = subject(inst, rs.same);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        ret push(out, ty.ok);
    }
    if (sel rs.mask) {
        val ty: res[Type, Error] = subject(inst, rs.mask);
        if (sel ty.err) { ret err[Error].err{ty.err}; }
        val m: res[Type, Error] = mask(t, ty.ok);
        if (sel m.err) { ret err[Error].err{m.err}; }
        ret push(out, m.ok);
    }
    if (sel rs.results) {
        val sig: res[Type, Error] = subject(inst, rs.results);
        if (sel sig.err) { ret err[Error].err{sig.err}; }
        val f: res[types.Function, types.Error] = types.signature(t, sig.ok);
        if (sel f.err) { ret err[Error].err{Error.types{f.err}}; }
        var i: usize = 0;
        for (i < f.ok.results.size) {
            val p: err[Error] = push(out, f.ok.results.data[i]);
            if (sel p.err) { ret p; }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

fun secrecy(r: *Row, inst: *Instance) bool {
    if (sel r.secrecy.declared)      { ret inst.declared; }
    if (!(sel r.secrecy.propagates)) { ret false; }
    var i: usize = 0;
    for (i < inst.secret.size) {
        if (inst.secret.data[i]) { ret true; }
        i = i + 1;
    }
    ret false;
}

# type an instance of an opcode
# ---
# t:    the type table the instance's types are in
# op:   the opcode
# inst: the instance
# out:  where the result types are pushed, in order
# ret:  whether its results are secret, by the row's secrecy rule, or the
#       first rule the instance breaks
pub fun check(t: *types.Table, op: Opcode, inst: Instance, out: *vector.Vector[Type]) res[bool, Error] {
    val found: opt[Row] = table.row(op);
    if (sel found.none) { ret res[bool, Error].err{Error.opcode{op}}; }
    var r: Row = found.some;

    val shaped: err[Error] = shape_of(?r, ?inst);
    if (sel shaped.err) { ret res[bool, Error].err{shaped.err}; }
    var i: usize = 0;
    for (i < $length_of(Rules) && !(sel r.rules[i].unstated)) {
        val c: err[Error] = rule(t, ?r, ?inst, r.rules[i]);
        if (sel c.err) { ret res[bool, Error].err{c.err}; }
        i = i + 1;
    }
    val start: usize = out.len;
    i = 0;
    for (i < $length_of(Results) && !(sel r.results[i].unstated)) {
        val c: err[Error] = result(t, ?inst, r.results[i], out);
        if (sel c.err) {
            out.len = start;
            ret res[bool, Error].err{c.err};
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{secrecy(?r, ?inst)};
}

fun intern(t: *types.Table, s: types.Shape) Type {
    val r: res[Type, types.Error] = types.intern(t, s);
    if (sel r.err) { ret Type{index: 0xffffffff}; }
    ret r.ok;
}

fun operands(data: *Type, secret: *bool, size: usize) Instance {
    var inst: Instance;
    inst.operands = Slice[Type]{data: data, size: size};
    inst.secret   = Slice[bool]{data: secret, size: size};
    ret inst;
}

test check__compare_yields_i1_and_cbr_takes_only_i1 {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var out: vector.Vector[Type] = vector.init[Type](?a);
    fin { vector.dnit[Type](?out); }

    val i1:  Type = intern(?t, types.Shape.integer{types.Integer{width: 1}});
    val i8:  Type = intern(?t, types.Shape.integer{types.Integer{width: 8}});
    val i32: Type = intern(?t, types.Shape.integer{types.Integer{width: 32}});
    val v4:  Type = intern(?t, types.Shape.vector{types.Vector{lanes: 4, element: i32}});
    val m4:  Type = intern(?t, types.Shape.vector{types.Vector{lanes: 4, element: i1}});
    val f32: Type = intern(?t, types.Shape.float{types.Float{format: types.BINARY32}});

    var pair:   [2]Type          = [2]Type{i32, i32};
    var public: [2]bool          = [2]bool{false, false};
    var mixed:  [2]bool          = [2]bool{false, true};
    val cmp:    res[bool, Error] = check(?t, table.LT_S, operands(?pair[0], ?public[0], 2), ?out);
    if (sel cmp.err)                                  { ret 1; }
    if (out.len != 1 || !types.same(out.data[0], i1)) { ret 2; }
    if (cmp.ok)                                       { ret 2; }
    out.len = 0;
    val hidden: res[bool, Error] = check(?t, table.LT_S, operands(?pair[0], ?mixed[0], 2), ?out);
    if (sel hidden.err) { ret 1; }
    if (!hidden.ok)     { ret 2; }

    var lanes: [2]Type = [2]Type{v4, v4};
    out.len = 0;
    val vcmp: res[bool, Error] = check(?t, table.EQ, operands(?lanes[0], ?public[0], 2), ?out);
    if (sel vcmp.err)                                 { ret 3; }
    if (out.len != 1 || !types.same(out.data[0], m4)) { ret 4; }

    var none:  [1]Type;
    var edges: [2]Edge = [2]Edge{
        Edge{arguments: Slice[Type]{data: ?none[0], size: 0}, parameters: Slice[Type]{data: ?none[0], size: 0}},
        Edge{arguments: Slice[Type]{data: ?none[0], size: 0}, parameters: Slice[Type]{data: ?none[0], size: 0}},
    };
    var conds: [5]Type = [5]Type{i1, i8, i32, f32, m4};
    var i:     usize   = 0;
    for (i < 5) {
        var inst: Instance = operands(?conds[i], ?public[0], 1);
        inst.edges = Slice[Edge]{data: ?edges[0], size: 2};
        out.len    = 0;
        val got: res[bool, Error] = check(?t, table.CBR, inst, ?out);
        if (i == 0) {
            if (sel got.err)  { ret 5; }
            if (out.len != 0) { ret 6; }
        }
        or {
            if (sel got.ok)           { ret 7; }
            if (!(sel got.err.class)) { ret 8; }
        }
        i = i + 1;
    }
    ret 0;
}
