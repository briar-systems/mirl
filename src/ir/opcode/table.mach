# the opcode table: one row per opcode, and the ids that name them
#
# integer arithmetic wraps, and signedness belongs to the opcode, never the
# type. division and remainder by zero is a defined trap on every target, as
# is a signed division or remainder of the least value by minus one, and so is
# a division of a two-word dividend whose quotient does not fit the word. a shift
# by the width or more is defined: logical and left shifts give zero and the
# arithmetic right shift fills with the sign.
#
# float arithmetic is in the operands' number format with its default rounding
# and never traps. a float to integer conversion rounds toward zero, saturates
# and gives zero for a nan. a copy of memory may overlap. an atomic access and
# a fence state their ordering as an immediate.

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str_equals;
use std.types.string.str_len;

use mirl.ir.opcode.row.Arity;
use mirl.ir.opcode.row.Effects;
use mirl.ir.opcode.row.Forms;
use mirl.ir.opcode.row.Holds;
use mirl.ir.opcode.row.Indexed;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Operand;
use mirl.ir.opcode.row.Operands;
use mirl.ir.opcode.row.Order;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Role;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.Slot;
use mirl.ir.opcode.row.Slots;
use mirl.ir.opcode.row.Traps;
use mirl.ir.opcode.row.VectorClass;
use mirl.ir.opcode.row.base;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Allowed;
use mirl.ir.opcode.rule.Bound;
