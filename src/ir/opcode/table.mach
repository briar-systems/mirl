use mirl.ir.opcode.rule.Fit;
use mirl.ir.opcode.rule.Lane;
use mirl.ir.opcode.rule.Listed;
use mirl.ir.opcode.rule.Member;
use mirl.ir.opcode.rule.Orderings;
use mirl.ir.opcode.rule.Overshift;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Secrecy;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.rule.Trap;

val NO_OPERAND: Operand = Operand{name: nil, role: Role.unstated{}};
val NO_SLOT:    Slot    = Slot{name: nil, holds: Holds.unstated{}};
val NO_RULE:    Rule    = Rule.unstated{};
val NO_RESULT:  Result  = Result.unstated{};
val NO_TRAP:    Trap    = Trap.unstated{};

val FIRST:  Subject = Subject.operand{0};
val SECOND: Subject = Subject.operand{1};

val NO_OPERANDS:      [4]Operand = [4]Operand{NO_OPERAND, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val UNARY:            [4]Operand = [4]Operand{Operand{name: "operand", role: Role.value{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val BINARY:           [4]Operand = [4]Operand{Operand{name: "lhs", role: Role.value{}}, Operand{name: "rhs", role: Role.value{}}, NO_OPERAND, NO_OPERAND};
val LOAD_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val STORE_OPERANDS:   [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "value", role: Role.stored{}}, NO_OPERAND, NO_OPERAND};
val PTR_ADD_OPERANDS: [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "offset", role: Role.offset{}}, NO_OPERAND, NO_OPERAND};
val CBR_OPERANDS:     [4]Operand = [4]Operand{Operand{name: "condition", role: Role.condition{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val CALL_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "callee", role: Role.callee{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};

val NO_SLOTS:     [3]Slot = [3]Slot{NO_SLOT, NO_SLOT, NO_SLOT};
val LOAD_SLOTS:   [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "align", holds: Holds.alignment{}}, NO_SLOT};
val STORE_SLOTS:  [3]Slot = [3]Slot{Slot{name: "align", holds: Holds.alignment{}}, NO_SLOT, NO_SLOT};
val ALLOCA_SLOTS: [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "pointer", holds: Holds.ty{}}, Slot{name: "align", holds: Holds.alignment{}}};
val CALL_SLOTS:   [3]Slot = [3]Slot{Slot{name: "signature", holds: Holds.ty{}}, Slot{name: "named", holds: Holds.named{}}, NO_SLOT};
val PLACED_SLOTS: [3]Slot = [3]Slot{Slot{name: "signature", holds: Holds.ty{}}, Slot{name: "places", holds: Holds.places{}}, NO_SLOT};
val PLACES_SLOTS: [3]Slot = [3]Slot{Slot{name: "places", holds: Holds.places{}}, NO_SLOT, NO_SLOT};

val NO_RULES:      [6]Rule = [6]Rule{NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val INTEGER:       [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val INTEGERS:      [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val LOAD_RULES:    [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val STORE_RULES:   [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val ALLOCA_RULES:  [6]Rule = [6]Rule{Rule.is{Bound{subject: Subject.immediate{1}, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val PTR_ADD_RULES: [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val CBR_RULES:     [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.width{1}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val CALL_RULES:    [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: Subject.immediate{0}, class: Class.function{}}}, Rule.parameters{Subject.immediate{0}}, Rule.named{Listed{slot: 1, of: Subject.immediate{0}}}, NO_RULE, NO_RULE};
val PLACED_RULES:  [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: Subject.immediate{0}, class: Class.function{}}}, Rule.parameters{Subject.immediate{0}}, Rule.places{Listed{slot: 1, of: Subject.immediate{0}}}, NO_RULE, NO_RULE};
val PLACES_RULES:  [6]Rule = [6]Rule{Rule.places{Listed{slot: 0, of: Subject.unstated{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val RET_RULES:     [6]Rule = [6]Rule{Rule.returns{}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};

val NO_RESULTS: [2]Result = [2]Result{NO_RESULT, NO_RESULT};
val SAME:       [2]Result = [2]Result{Result.same{FIRST}, NO_RESULT};
val MASK:       [2]Result = [2]Result{Result.mask{FIRST}, NO_RESULT};
val LOADED:     [2]Result = [2]Result{Result.same{Subject.immediate{0}}, NO_RESULT};
val ALLOCATED:  [2]Result = [2]Result{Result.same{Subject.immediate{1}}, NO_RESULT};
val CALLED:     [2]Result = [2]Result{Result.results{Subject.immediate{0}}, NO_RESULT};

val PURE:           Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: true, mergeable: true, keepable: false};
val DIVIDES:        Effects = Effects{traps: [2]Trap{Trap.zero{1}, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: true, keepable: false};
val SIGNED_DIVIDES: Effects = Effects{traps: [2]Trap{Trap.zero{1}, Trap.overflow{Division{dividend: 0, divisor: 1}}}, reads: false, writes: false, speculatable: false, mergeable: true, keepable: false};
val LOADS:          Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: true, writes: false, speculatable: false, mergeable: false, keepable: false};
val STORES:         Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: false, writes: true, speculatable: false, mergeable: false, keepable: true};
val ALLOCATES:      Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: false, keepable: false};
val CONTROL:        Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: false, keepable: false};
val CALLS:          Effects = Effects{traps: [2]Trap{Trap.callee{}, NO_TRAP}, reads: true, writes: true, speculatable: false, mergeable: false, keepable: false};

val THIRD: Subject = Subject.operand{2};
val IMM0:  Subject = Subject.immediate{0};
val IMM1:  Subject = Subject.immediate{1};

val TERNARY:         [4]Operand = [4]Operand{Operand{name: "first", role: Role.value{}}, Operand{name: "second", role: Role.value{}}, Operand{name: "third", role: Role.value{}}, NO_OPERAND};
val VECTOR_OPERAND:  [4]Operand = [4]Operand{Operand{name: "vector", role: Role.value{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val SCALAR_OPERAND:  [4]Operand = [4]Operand{Operand{name: "scalar", role: Role.value{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val INSERT_OPERANDS: [4]Operand = [4]Operand{Operand{name: "vector", role: Role.value{}}, Operand{name: "scalar", role: Role.value{}}, NO_OPERAND, NO_OPERAND};
val LANES_OPERANDS:  [4]Operand = [4]Operand{Operand{name: "lhs", role: Role.value{}}, Operand{name: "rhs", role: Role.value{}}, NO_OPERAND, NO_OPERAND};
val ATOMIC_RMW:      [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "value", role: Role.stored{}}, NO_OPERAND, NO_OPERAND};
val CMPXCHG:         [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "expected", role: Role.value{}}, Operand{name: "desired", role: Role.stored{}}, NO_OPERAND};
val COPY_OPERANDS:   [4]Operand = [4]Operand{Operand{name: "destination", role: Role.address{}}, Operand{name: "source", role: Role.address{}}, Operand{name: "length", role: Role.length{}}, NO_OPERAND};
val FILL_OPERANDS:   [4]Operand = [4]Operand{Operand{name: "destination", role: Role.address{}}, Operand{name: "byte", role: Role.stored{}}, Operand{name: "length", role: Role.length{}}, NO_OPERAND};
val SELECT_OPERANDS: [4]Operand = [4]Operand{Operand{name: "condition", role: Role.condition{}}, Operand{name: "then", role: Role.value{}}, Operand{name: "else", role: Role.value{}}, NO_OPERAND};
val BUILD_OPERANDS:  [4]Operand = NO_OPERANDS;

val TO_SLOTS:      [3]Slot = [3]Slot{Slot{name: "to", holds: Holds.ty{}}, NO_SLOT, NO_SLOT};
val VECTOR_SLOTS:  [3]Slot = [3]Slot{Slot{name: "vector", holds: Holds.ty{}}, NO_SLOT, NO_SLOT};
val SHUFFLE_SLOTS: [3]Slot = [3]Slot{Slot{name: "vector", holds: Holds.ty{}}, Slot{name: "lanes", holds: Holds.lanes{}}, NO_SLOT};
val LANE_SLOTS:    [3]Slot = [3]Slot{Slot{name: "lane", holds: Holds.lane{}}, NO_SLOT, NO_SLOT};
val ATOMIC_LOADED: [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "order", holds: Holds.ordering{}}, NO_SLOT};
val ORDER_SLOT:    [3]Slot = [3]Slot{Slot{name: "order", holds: Holds.ordering{}}, NO_SLOT, NO_SLOT};
val CMPXCHG_SLOTS: [3]Slot = [3]Slot{Slot{name: "success", holds: Holds.ordering{}}, Slot{name: "failure", holds: Holds.ordering{}}, NO_SLOT};
val ALIGN_SLOT:    [3]Slot = [3]Slot{Slot{name: "align", holds: Holds.alignment{}}, NO_SLOT, NO_SLOT};

val FLOATS:                [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val CONVERT_UP_INTEGER:    [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.is{Bound{subject: IMM0, class: Class.integer{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, Rule.wider{Pair{left: IMM0, right: FIRST}}, NO_RULE, NO_RULE};
val CONVERT_DOWN_INTEGER:  [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.is{Bound{subject: IMM0, class: Class.integer{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, Rule.wider{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE};
val CONVERT_INTEGER_FLOAT: [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.is{Bound{subject: IMM0, class: Class.float{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE, NO_RULE};
val CONVERT_FLOAT_INTEGER: [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, Rule.is{Bound{subject: IMM0, class: Class.integer{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE, NO_RULE};
val CONVERT_UP_FLOAT:      [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, Rule.is{Bound{subject: IMM0, class: Class.float{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, Rule.wider{Pair{left: IMM0, right: FIRST}}, NO_RULE, NO_RULE};
val BITCAST_RULES:         [6]Rule = [6]Rule{Rule.bits{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val POINTER_INTEGER:       [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: IMM0, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val SPLAT_RULES:           [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.scalar{}}}, Rule.is{Bound{subject: IMM0, class: Class.vector{}}}, Rule.element{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE, NO_RULE};
val BUILD_RULES:           [6]Rule = [6]Rule{Rule.is{Bound{subject: IMM0, class: Class.vector{}}}, Rule.lanes_of{IMM0}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val SHUFFLE_RULES:         [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.vector{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, Rule.is{Bound{subject: IMM0, class: Class.vector{}}}, Rule.element{Pair{left: FIRST, right: IMM0}}, Rule.lane{Lane{slot: 1, over: Pair{left: FIRST, right: SECOND}}}, Rule.count{Count{slot: 1, of: IMM0}}};
val EXTRACT_RULES:         [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.vector{}}}, Rule.lane{Lane{slot: 0, over: Pair{left: FIRST, right: Subject.unstated{}}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val INSERT_RULES:          [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.vector{}}}, Rule.is{Bound{subject: SECOND, class: Class.scalar{}}}, Rule.element{Pair{left: FIRST, right: SECOND}}, Rule.lane{Lane{slot: 0, over: Pair{left: FIRST, right: Subject.unstated{}}}}, NO_RULE, NO_RULE};
val FLOAT:                 [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val FMA_RULES:             [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, Rule.agree{Pair{left: FIRST, right: THIRD}}, NO_RULE, NO_RULE, NO_RULE};
val CONVERT_DOWN_FLOAT:    [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.float{}}}, Rule.is{Bound{subject: IMM0, class: Class.float{}}}, Rule.conform{Pair{left: FIRST, right: IMM0}}, Rule.wider{Pair{left: FIRST, right: IMM0}}, NO_RULE, NO_RULE};
val INTEGER_POINTER:       [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.is{Bound{subject: IMM0, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val ATOMIC_LOAD_RULES:     [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: IMM0, class: Class.integer{}}}, Rule.ordering{Allowed{slot: 1, orderings: LOAD_ORDERINGS}}, NO_RULE, NO_RULE, NO_RULE};
val ATOMIC_STORE_RULES:    [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.integer{}}}, Rule.ordering{Allowed{slot: 0, orderings: STORE_ORDERINGS}}, NO_RULE, NO_RULE, NO_RULE};
val ATOMIC_RMW_RULES:      [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.integer{}}}, Rule.ordering{Allowed{slot: 0, orderings: ANY_ORDERINGS}}, NO_RULE, NO_RULE, NO_RULE};
val CMPXCHG_RULES:         [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.integer{}}}, Rule.agree{Pair{left: SECOND, right: THIRD}}, Rule.ordering{Allowed{slot: 0, orderings: ANY_ORDERINGS}}, Rule.ordering{Allowed{slot: 1, orderings: LOAD_ORDERINGS}}, NO_RULE};
val FENCE_RULES:           [6]Rule = [6]Rule{Rule.ordering{Allowed{slot: 0, orderings: FENCE_ORDERINGS}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val COPY_RULES:            [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.pointer{}}}, Rule.is{Bound{subject: THIRD, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE};
val FILL_RULES:            [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.width{8}}}, Rule.is{Bound{subject: THIRD, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE};
val SELECT_RULES:          [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.width{1}}}, Rule.agree{Pair{left: SECOND, right: THIRD}}, Rule.conform{Pair{left: FIRST, right: SECOND}}, NO_RULE, NO_RULE, NO_RULE};
val BYTES:                 [6]Rule = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.bytes{}}}, NO_RULE, NO_RULE, NO_RULE, NO_RULE, NO_RULE};

val LOAD_ORDERINGS:  Orderings = Orderings{relaxed: true, acquire: true, release: false, acq_rel: false, seq_cst: true};
val STORE_ORDERINGS: Orderings = Orderings{relaxed: true, acquire: false, release: true, acq_rel: false, seq_cst: true};
val ANY_ORDERINGS:   Orderings = Orderings{relaxed: true, acquire: true, release: true, acq_rel: true, seq_cst: true};
val FENCE_ORDERINGS: Orderings = Orderings{relaxed: false, acquire: true, release: true, acq_rel: true, seq_cst: true};

val ELEMENT:    [2]Result = [2]Result{Result.element{FIRST}, NO_RESULT};
val CONVERTED:  [2]Result = [2]Result{Result.same{IMM0}, NO_RESULT};
val OVERFLOWED: [2]Result = [2]Result{Result.same{FIRST}, Result.mask{FIRST}};
val SWAPPED:    [2]Result = [2]Result{Result.same{SECOND}, NO_RESULT};
val EXCHANGED:  [2]Result = [2]Result{Result.same{SECOND}, Result.mask{SECOND}};
val SELECTED:   [2]Result = [2]Result{Result.same{SECOND}, NO_RESULT};

val ATOMIC_LOADS:   Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: true, writes: false, speculatable: false, mergeable: false, keepable: false};
val ATOMIC_STORES:  Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: false, writes: true, speculatable: false, mergeable: false, keepable: false};
val ATOMIC_UPDATES: Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: true, writes: true, speculatable: false, mergeable: false, keepable: false};
val FENCES:         Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: true, writes: true, speculatable: false, mergeable: false, keepable: false};
val COPIES:         Effects = Effects{traps: [2]Trap{Trap.fault{0}, Trap.fault{1}}, reads: true, writes: true, speculatable: false, mergeable: false, keepable: false};
val FILLS:          Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: false, writes: true, speculatable: false, mergeable: false, keepable: true};
val TRAPS:          Effects = Effects{traps: [2]Trap{Trap.always{}, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: false, keepable: false};

val LONG_OPERANDS: [4]Operand = [4]Operand{Operand{name: "high", role: Role.value{}}, Operand{name: "low", role: Role.value{}}, Operand{name: "divisor", role: Role.value{}}, NO_OPERAND};
val LONG_RULES:    [6]Rule    = [6]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, Rule.agree{Pair{left: FIRST, right: THIRD}}, NO_RULE, NO_RULE, NO_RULE};
val LONG_RESULTS:  [2]Result  = [2]Result{Result.same{THIRD}, Result.same{THIRD}};
val LONG_DIVIDES:  Effects    = Effects{traps: [2]Trap{Trap.zero{2}, Trap.exceeds{Division{dividend: 0, divisor: 2}}}, reads: false, writes: false, speculatable: false, mergeable: true, keepable: false};

val MEMBER_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val INDEX_OPERANDS:     [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "index", role: Role.index{}}, NO_OPERAND, NO_OPERAND};
val SWITCH_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "selector", role: Role.condition{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val AGGREGATE_OPERAND:  [4]Operand = [4]Operand{Operand{name: "aggregate", role: Role.value{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val AGGREGATE_OPERANDS: [4]Operand = [4]Operand{Operand{name: "aggregate", role: Role.value{}}, Operand{name: "value", role: Role.value{}}, NO_OPERAND, NO_OPERAND};

val TYPED_MEMBER:  Member  = Member{slot: 1, of: IMM0};
val HELD_MEMBER:   Member  = Member{slot: 0, of: FIRST};
val INDEXED_ARRAY: Indexed = Indexed{operand: 1, of: IMM0};

val MEMBER_SLOTS: [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "member", holds: Holds.member{}}, NO_SLOT};
val INDEX_SLOTS:  [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, NO_SLOT, NO_SLOT};
