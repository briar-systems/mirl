# the opcode table: one row per opcode, and the ids that name them
#
# integer arithmetic wraps, and signedness belongs to the opcode, never the
# type. division and remainder by zero is a defined trap on every target, as
# is a signed division or remainder of the least value by minus one. a shift
# by the width or more is defined: logical and left shifts give zero and the
# arithmetic right shift fills with the sign.

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.string.str_equals;
use std.types.string.str_len;

use mirl.ir.opcode.row.Arity;
use mirl.ir.opcode.row.Effects;
use mirl.ir.opcode.row.Holds;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Operand;
use mirl.ir.opcode.row.Operands;
use mirl.ir.opcode.row.Results;
use mirl.ir.opcode.row.Role;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.row.Rules;
use mirl.ir.opcode.row.Slot;
use mirl.ir.opcode.row.Slots;
use mirl.ir.opcode.row.Traps;
use mirl.ir.opcode.row.VectorClass;
use mirl.ir.opcode.row.fixed;
use mirl.ir.opcode.row.slots;
use mirl.ir.opcode.rule.Bound;
use mirl.ir.opcode.rule.Class;
use mirl.ir.opcode.rule.Division;
use mirl.ir.opcode.rule.Overshift;
use mirl.ir.opcode.rule.Pair;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Secrecy;
use mirl.ir.opcode.rule.Subject;
use mirl.ir.opcode.rule.Trap;

val NO_OPERAND: Operand = Operand{name: nil, role: Role.unstated{}};
val NO_SLOT:    Slot    = Slot{name: nil, holds: Holds.unstated{}};
val NO_RULE:    Rule    = Rule.unstated{};
val NO_RESULT:  Result  = Result.unstated{};
val NO_TRAP:    Trap    = Trap.unstated{};

val FIRST:  Subject = Subject.operand{0};
val SECOND: Subject = Subject.operand{1};

val NO_OPERANDS:      [4]Operand = [4]Operand{NO_OPERAND, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val UNARY:            [4]Operand = [4]Operand{Operand{name: "operand", role: Role.value{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val BINARY:           [4]Operand = [4]Operand{Operand{name: "lhs", role: Role.value{}}, Operand{name: "rhs", role: Role.value{}}, NO_OPERAND, NO_OPERAND};
val LOAD_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val STORE_OPERANDS:   [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "value", role: Role.stored{}}, NO_OPERAND, NO_OPERAND};
val PTR_ADD_OPERANDS: [4]Operand = [4]Operand{Operand{name: "address", role: Role.address{}}, Operand{name: "offset", role: Role.offset{}}, NO_OPERAND, NO_OPERAND};
val CBR_OPERANDS:     [4]Operand = [4]Operand{Operand{name: "condition", role: Role.condition{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};
val CALL_OPERANDS:    [4]Operand = [4]Operand{Operand{name: "callee", role: Role.callee{}}, NO_OPERAND, NO_OPERAND, NO_OPERAND};

val NO_SLOTS:     [3]Slot = [3]Slot{NO_SLOT, NO_SLOT, NO_SLOT};
val LOAD_SLOTS:   [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "align", holds: Holds.alignment{}}, NO_SLOT};
val STORE_SLOTS:  [3]Slot = [3]Slot{Slot{name: "align", holds: Holds.alignment{}}, NO_SLOT, NO_SLOT};
val ALLOCA_SLOTS: [3]Slot = [3]Slot{Slot{name: "type", holds: Holds.ty{}}, Slot{name: "pointer", holds: Holds.ty{}}, Slot{name: "align", holds: Holds.alignment{}}};
val CALL_SLOTS:   [3]Slot = [3]Slot{Slot{name: "signature", holds: Holds.ty{}}, NO_SLOT, NO_SLOT};

val NO_RULES:      [4]Rule = [4]Rule{NO_RULE, NO_RULE, NO_RULE, NO_RULE};
val INTEGER:       [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, NO_RULE, NO_RULE, NO_RULE};
val INTEGERS:      [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.integer{}}}, Rule.agree{Pair{left: FIRST, right: SECOND}}, NO_RULE, NO_RULE};
val LOAD_RULES:    [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE};
val STORE_RULES:   [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE};
val ALLOCA_RULES:  [4]Rule = [4]Rule{Rule.is{Bound{subject: Subject.immediate{1}, class: Class.pointer{}}}, NO_RULE, NO_RULE, NO_RULE};
val PTR_ADD_RULES: [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: SECOND, class: Class.integer{}}}, NO_RULE, NO_RULE};
val CBR_RULES:     [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.width{1}}}, NO_RULE, NO_RULE, NO_RULE};
val CALL_RULES:    [4]Rule = [4]Rule{Rule.is{Bound{subject: FIRST, class: Class.pointer{}}}, Rule.is{Bound{subject: Subject.immediate{0}, class: Class.function{}}}, Rule.parameters{Subject.immediate{0}}, NO_RULE};
val RET_RULES:     [4]Rule = [4]Rule{Rule.returns{}, NO_RULE, NO_RULE, NO_RULE};

val NO_RESULTS: [2]Result = [2]Result{NO_RESULT, NO_RESULT};
val SAME:       [2]Result = [2]Result{Result.same{FIRST}, NO_RESULT};
val MASK:       [2]Result = [2]Result{Result.mask{FIRST}, NO_RESULT};
val LOADED:     [2]Result = [2]Result{Result.same{Subject.immediate{0}}, NO_RESULT};
val ALLOCATED:  [2]Result = [2]Result{Result.same{Subject.immediate{1}}, NO_RESULT};
val CALLED:     [2]Result = [2]Result{Result.results{Subject.immediate{0}}, NO_RESULT};

val PURE:           Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: true, mergeable: true};
val DIVIDES:        Effects = Effects{traps: [2]Trap{Trap.zero{1}, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: true};
val SIGNED_DIVIDES: Effects = Effects{traps: [2]Trap{Trap.zero{1}, Trap.overflow{Division{dividend: 0, divisor: 1}}}, reads: false, writes: false, speculatable: false, mergeable: true};
val LOADS:          Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: true, writes: false, speculatable: false, mergeable: false};
val STORES:         Effects = Effects{traps: [2]Trap{Trap.fault{0}, NO_TRAP}, reads: false, writes: true, speculatable: false, mergeable: false};
val ALLOCATES:      Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: false};
val CONTROL:        Effects = Effects{traps: [2]Trap{NO_TRAP, NO_TRAP}, reads: false, writes: false, speculatable: false, mergeable: false};
val CALLS:          Effects = Effects{traps: [2]Trap{Trap.callee{}, NO_TRAP}, reads: true, writes: true, speculatable: false, mergeable: false};

def Rows: [33]Row;

