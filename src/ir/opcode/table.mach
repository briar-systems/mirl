# integer addition
pub val ADD: Opcode = Opcode{index: 0};

# integer subtraction
pub val SUB: Opcode = Opcode{index: 1};

# integer multiplication, the low half of the product
pub val MUL: Opcode = Opcode{index: 2};

# signed integer division, rounding toward zero
pub val DIV_S: Opcode = Opcode{index: 3};

# unsigned integer division
pub val DIV_U: Opcode = Opcode{index: 4};

# signed integer remainder, with the sign of the dividend
pub val REM_S: Opcode = Opcode{index: 5};

# unsigned integer remainder
pub val REM_U: Opcode = Opcode{index: 6};

# bitwise and
pub val AND: Opcode = Opcode{index: 7};

# bitwise or
pub val OR: Opcode = Opcode{index: 8};

# bitwise exclusive or
pub val XOR: Opcode = Opcode{index: 9};

# left shift by an unsigned amount
pub val SHL: Opcode = Opcode{index: 10};

# logical right shift by an unsigned amount
pub val SHR_U: Opcode = Opcode{index: 11};

# arithmetic right shift by an unsigned amount
pub val SHR_S: Opcode = Opcode{index: 12};

# two's complement negation
pub val NEG: Opcode = Opcode{index: 13};

# bitwise complement
pub val NOT: Opcode = Opcode{index: 14};

# integer equality
pub val EQ: Opcode = Opcode{index: 15};

# integer inequality
pub val NE: Opcode = Opcode{index: 16};

# signed less than
pub val LT_S: Opcode = Opcode{index: 17};

# signed less than or equal
pub val LE_S: Opcode = Opcode{index: 18};

# signed greater than
pub val GT_S: Opcode = Opcode{index: 19};

# signed greater than or equal
pub val GE_S: Opcode = Opcode{index: 20};

# unsigned less than
pub val LT_U: Opcode = Opcode{index: 21};

# unsigned less than or equal
pub val LE_U: Opcode = Opcode{index: 22};

# unsigned greater than
pub val GT_U: Opcode = Opcode{index: 23};

# unsigned greater than or equal
pub val GE_U: Opcode = Opcode{index: 24};

# a load of the stated type from an address
pub val LOAD: Opcode = Opcode{index: 25};

# a store of a value to an address
pub val STORE: Opcode = Opcode{index: 26};

# a stack slot of the stated type, giving its address
pub val ALLOCA: Opcode = Opcode{index: 27};

# an address plus a byte offset
pub val PTR_ADD: Opcode = Opcode{index: 28};

# an unconditional branch
pub val BR: Opcode = Opcode{index: 29};

# a branch to the first target when the condition is 1 and the second when 0
pub val CBR: Opcode = Opcode{index: 30};

# a call through an address, with the callee's signature stated
pub val CALL: Opcode = Opcode{index: 31};

# a return of the function's results
pub val RET: Opcode = Opcode{index: 32};

# float addition in the operands' number format
pub val FADD: Opcode = Opcode{index: 33};

# float less than, false when either operand is not a number
pub val FLT_O: Opcode = Opcode{index: 34};

# integer extension filling the new high bits with zeros, to the stated wider type
pub val EXT_U: Opcode = Opcode{index: 35};

# integer truncation to the stated narrower type, keeping the low bits
pub val TRUNC: Opcode = Opcode{index: 36};

# signed integer to float, rounded to nearest even
pub val ITOF_S: Opcode = Opcode{index: 37};

# float to signed integer, rounding toward zero, saturating, and zero for a nan
pub val FTOI_S: Opcode = Opcode{index: 38};

# float to a float of a wider number format, exactly
pub val FPROMOTE: Opcode = Opcode{index: 39};

# the same bits as the stated type of the same bit width
pub val BITCAST: Opcode = Opcode{index: 40};

# a pointer's address as an integer of the stated width
pub val PTRTOINT: Opcode = Opcode{index: 41};

# a vector of the stated type with every lane the scalar
pub val VSPLAT: Opcode = Opcode{index: 42};

# a vector of the stated type from one scalar per lane
pub val VBUILD: Opcode = Opcode{index: 43};

# a vector of the stated type whose lanes are picked from the two operands' lanes joined
pub val VSHUFFLE: Opcode = Opcode{index: 44};

# one lane of a vector
pub val VEXTRACT: Opcode = Opcode{index: 45};

# a vector with one lane replaced
pub val VINSERT: Opcode = Opcode{index: 46};

# the wrapping sum of the lanes of an integer vector
pub val REDUCE_ADD: Opcode = Opcode{index: 47};

# the sum of the lanes of a float vector, added in lane order
pub val REDUCE_FADD_SEQ: Opcode = Opcode{index: 48};

# an atomic load of the stated integer type with the stated ordering
pub val ATOMIC_LOAD: Opcode = Opcode{index: 49};

# an atomic store of an integer with the stated ordering
pub val ATOMIC_STORE: Opcode = Opcode{index: 50};

# an atomic add giving the value held before
pub val ATOMIC_ADD: Opcode = Opcode{index: 51};

# an atomic compare and exchange giving the value held before and whether it was exchanged
pub val ATOMIC_CMPXCHG: Opcode = Opcode{index: 52};

# a fence of the stated ordering
pub val FENCE: Opcode = Opcode{index: 53};

# a copy of a byte count between addresses, whose ranges may overlap
pub val MEM_COPY: Opcode = Opcode{index: 54};

# a fill of a byte count at an address with one byte
pub val MEM_FILL: Opcode = Opcode{index: 55};

# the then value when the condition is 1 and the else value when 0
pub val SELECT: Opcode = Opcode{index: 56};

# the operand's value as a public value, the only operation that removes secrecy
pub val DECLASSIFY: Opcode = Opcode{index: 57};

# signed addition giving the wrapped sum and whether it overflowed
pub val ADD_OV_S: Opcode = Opcode{index: 58};

# the number of one bits
pub val POPCNT: Opcode = Opcode{index: 59};

# the bytes in reverse order
pub val BSWAP: Opcode = Opcode{index: 60};

# a terminator that is a defined trap
pub val UNREACHABLE: Opcode = Opcode{index: 61};

# float subtraction
pub val FSUB: Opcode = Opcode{index: 62};

# float multiplication
pub val FMUL: Opcode = Opcode{index: 63};

# float division, giving infinity or a nan where the format does
pub val FDIV: Opcode = Opcode{index: 64};

# float remainder with the sign of the dividend
pub val FREM: Opcode = Opcode{index: 65};

# the lesser float, a nan when either is a nan, and negative zero below positive zero
pub val FMIN: Opcode = Opcode{index: 66};

# the greater float, a nan when either is a nan, and positive zero above negative zero
pub val FMAX: Opcode = Opcode{index: 67};

# the lesser float, the other operand when one is a nan
pub val FMINNUM: Opcode = Opcode{index: 68};

# the greater float, the other operand when one is a nan
pub val FMAXNUM: Opcode = Opcode{index: 69};

# the first operand with the sign of the second
pub val FCOPYSIGN: Opcode = Opcode{index: 70};

# float negation, flipping the sign bit
pub val FNEG: Opcode = Opcode{index: 71};

# float absolute value, clearing the sign bit
pub val FABS: Opcode = Opcode{index: 72};

# float square root
pub val FSQRT: Opcode = Opcode{index: 73};

# the float rounded toward negative infinity
pub val FFLOOR: Opcode = Opcode{index: 74};

# the float rounded toward positive infinity
pub val FCEIL: Opcode = Opcode{index: 75};

# the float rounded toward zero
pub val FINT: Opcode = Opcode{index: 76};

# the float rounded to the nearest integer, ties to even
pub val FNEAREST: Opcode = Opcode{index: 77};

# first times second plus third, rounded once
pub val FMA: Opcode = Opcode{index: 78};

# float equality, false when either is a nan
pub val FEQ_O: Opcode = Opcode{index: 79};

# float inequality, false when either is a nan
pub val FNE_O: Opcode = Opcode{index: 80};

# float less than or equal, false when either is a nan
pub val FLE_O: Opcode = Opcode{index: 81};

# float greater than, false when either is a nan
pub val FGT_O: Opcode = Opcode{index: 82};

# float greater than or equal, false when either is a nan
pub val FGE_O: Opcode = Opcode{index: 83};

# true when neither float is a nan
pub val FORD: Opcode = Opcode{index: 84};

# float equality, true when either is a nan
pub val FEQ_U: Opcode = Opcode{index: 85};

# float inequality, true when either is a nan
pub val FNE_U: Opcode = Opcode{index: 86};

# float less than, true when either is a nan
pub val FLT_U: Opcode = Opcode{index: 87};

# float less than or equal, true when either is a nan
pub val FLE_U: Opcode = Opcode{index: 88};

# float greater than, true when either is a nan
pub val FGT_U: Opcode = Opcode{index: 89};

# float greater than or equal, true when either is a nan
pub val FGE_U: Opcode = Opcode{index: 90};

# true when either float is a nan
pub val FUNO: Opcode = Opcode{index: 91};

# integer extension filling the new high bits with the sign, to the stated wider type
pub val EXT_S: Opcode = Opcode{index: 92};

# unsigned integer to float, rounded to nearest even
pub val ITOF_U: Opcode = Opcode{index: 93};

# float to unsigned integer, rounding toward zero, saturating, and zero for a nan
pub val FTOI_U: Opcode = Opcode{index: 94};

# float to a float of a narrower number format, rounded to nearest even
pub val FDEMOTE: Opcode = Opcode{index: 95};

# an integer as a pointer with that address
pub val INTTOPTR: Opcode = Opcode{index: 96};

# the wrapping product of the lanes of an integer vector
pub val REDUCE_MUL: Opcode = Opcode{index: 97};

# the bitwise and of the lanes of an integer vector
pub val REDUCE_AND: Opcode = Opcode{index: 98};

# the bitwise or of the lanes of an integer vector
pub val REDUCE_OR: Opcode = Opcode{index: 99};

# the bitwise exclusive or of the lanes of an integer vector
pub val REDUCE_XOR: Opcode = Opcode{index: 100};

# the least lane of an integer vector, signed
pub val REDUCE_SMIN: Opcode = Opcode{index: 101};

# the greatest lane of an integer vector, signed
pub val REDUCE_SMAX: Opcode = Opcode{index: 102};

# the least lane of an integer vector, unsigned
pub val REDUCE_UMIN: Opcode = Opcode{index: 103};

# the greatest lane of an integer vector, unsigned
pub val REDUCE_UMAX: Opcode = Opcode{index: 104};

# the sum of the lanes of a float vector, added in any order
pub val REDUCE_FADD_ANY: Opcode = Opcode{index: 105};

# the product of the lanes of a float vector, multiplied in any order
pub val REDUCE_FMUL_ANY: Opcode = Opcode{index: 106};

# the least lane of a float vector, as fmin
pub val REDUCE_FMIN: Opcode = Opcode{index: 107};

# the greatest lane of a float vector, as fmax
pub val REDUCE_FMAX: Opcode = Opcode{index: 108};

# the least lane of a float vector, as fminnum
pub val REDUCE_FMINNUM: Opcode = Opcode{index: 109};

# the greatest lane of a float vector, as fmaxnum
pub val REDUCE_FMAXNUM: Opcode = Opcode{index: 110};

# the product of the lanes of a float vector, multiplied in lane order
pub val REDUCE_FMUL_SEQ: Opcode = Opcode{index: 111};

# an atomic subtract giving the value held before
pub val ATOMIC_SUB: Opcode = Opcode{index: 112};

# an atomic bitwise and giving the value held before
pub val ATOMIC_AND: Opcode = Opcode{index: 113};

# an atomic bitwise or giving the value held before
pub val ATOMIC_OR: Opcode = Opcode{index: 114};

# an atomic bitwise exclusive or giving the value held before
pub val ATOMIC_XOR: Opcode = Opcode{index: 115};

# an atomic bitwise not of the and, giving the value held before
pub val ATOMIC_NAND: Opcode = Opcode{index: 116};

# an atomic exchange giving the value held before
pub val ATOMIC_XCHG: Opcode = Opcode{index: 117};

# an atomic signed maximum giving the value held before
pub val ATOMIC_SMAX: Opcode = Opcode{index: 118};

# an atomic signed minimum giving the value held before
pub val ATOMIC_SMIN: Opcode = Opcode{index: 119};

# an atomic unsigned maximum giving the value held before
pub val ATOMIC_UMAX: Opcode = Opcode{index: 120};

# an atomic unsigned minimum giving the value held before
pub val ATOMIC_UMIN: Opcode = Opcode{index: 121};

# unsigned addition giving the wrapped sum and whether it overflowed
pub val ADD_OV_U: Opcode = Opcode{index: 122};

# signed subtraction giving the wrapped difference and whether it overflowed
pub val SUB_OV_S: Opcode = Opcode{index: 123};

# unsigned subtraction giving the wrapped difference and whether it overflowed
pub val SUB_OV_U: Opcode = Opcode{index: 124};

# signed multiplication giving the wrapped product and whether it overflowed
pub val MUL_OV_S: Opcode = Opcode{index: 125};

# unsigned multiplication giving the wrapped product and whether it overflowed
pub val MUL_OV_U: Opcode = Opcode{index: 126};

# the number of leading zero bits, the width for zero
pub val CLZ: Opcode = Opcode{index: 127};

# the number of trailing zero bits, the width for zero
pub val CTZ: Opcode = Opcode{index: 128};

# a call in pieces, each operand and result at the place its convention gave
pub val CALL_PLACED: Opcode = Opcode{index: 129};

# a return in pieces, each operand at the place its convention gave
pub val RET_PLACED: Opcode = Opcode{index: 130};

# the unsigned quotient and remainder of a two-word dividend, its high word and
# its low word, by a word divisor
pub val DIV_WIDE_U: Opcode = Opcode{index: 131};

# the high half of the product of two operands read as unsigned: the bits of
# the exact product from the width up
pub val MUL_HIGH_U: Opcode = Opcode{index: 132};

# the high half of the product of two operands read as signed
pub val MUL_HIGH_S: Opcode = Opcode{index: 133};

# the high half of the product of the first operand read as signed and the
# second read as unsigned
pub val MUL_HIGH_SU: Opcode = Opcode{index: 134};

# the address of a member of the structure at an address, the structure's
# type and the member's index stated
pub val PTR_MEMBER: Opcode = Opcode{index: 135};

# the address of an element of the array at an address, the array's type
# stated and the element's index an operand read as signed
pub val PTR_INDEX: Opcode = Opcode{index: 136};

# a branch to the target after the first whose case is the selector's value,
# or to the first when no case is
pub val SWITCH: Opcode = Opcode{index: 137};

# one member of an aggregate value
pub val EXTRACT: Opcode = Opcode{index: 138};

# an aggregate value with one member replaced
pub val INSERT: Opcode = Opcode{index: 139};

# the address of a function of the module, the only way code names one
pub val FUNC_ADDR: Opcode = Opcode{index: 140};

# the number of rows in the table
pub fun rows() u32 {
    ret $length_of(Rows);
}

# the row an opcode names
# ---
# op:  the opcode
# ret: its row, or none when op names no row
pub fun row(op: Opcode) opt[Row] {
    if (op.index >= rows()) { ret opt[Row].none{}; }
    ret opt[Row].some{ROWS[op.index]};
}

fun names_type(r: *Row, s: Subject) u8 {
    if (sel s.operand) { ret s.operand < fixed(r); }
    if (sel s.immediate) {
        val at: u32 = s.immediate;
        if (at >= slots(r)) { ret false; }
        val slot: Slot = r.immediates[at];
        ret sel slot.holds.ty;
    }
    ret false;
}

fun holds(r: *Row, at: u32, lanes: u8) u8 {
    if (at >= slots(r)) { ret false; }
    val h: Holds = r.immediates[at].holds;
    if (lanes) { ret sel h.lanes; }
    ret sel h.lane;
}

# whether the immediate at a position holds a place list, or a named count
fun holds_kind(r: *Row, at: u32, places: u8) u8 {
    if (at >= slots(r)) { ret false; }
    val h: Holds = r.immediates[at].holds;
    if (places) { ret sel h.places; }
    ret sel h.named;
}

# whether a member immediate names a slot that holds a member index of an
# aggregate the row names
fun names_member(r: *Row, mb: Member) u8 {
    if (mb.slot >= slots(r)) { ret false; }
    val h: Holds = r.immediates[mb.slot].holds;
    ret sel h.member && names_type(r, mb.of);
}

fun holds_ordering(r: *Row, at: u32) u8 {
    if (at >= slots(r)) { ret false; }
    val h: Holds = r.immediates[at].holds;
    ret sel h.ordering;
}

# zero when the row is well formed against the schema, else the first defect
fun formed(r: *Row) u32 {
    if (r.name == nil || str_len(r.name) == 0) { ret 1; }

    val operands: u32 = fixed(r);
    var i:        u32 = 0;
    for (i < $length_of(Operands)) {
        val stated: u8 = !(sel r.operands[i].role.unstated);
        if (stated != (i < operands))              { ret 2; }
        if (stated && (r.operands[i].name == nil)) { ret 2; }
        i = i + 1;
    }
    val immediates: u32 = slots(r);
    i = 0;
    for (i < $length_of(Slots)) {
        val stated: u8 = !(sel r.immediates[i].holds.unstated);
        if (stated != (i < immediates))              { ret 3; }
        if (stated && (r.immediates[i].name == nil)) { ret 3; }
        i = i + 1;
    }

    var tail_rules: u32 = 0;
    var ended:      u8  = false;
    i = 0;
    for (i < $length_of(Rules)) {
        val rule: Rule = r.rules[i];
        if (sel rule.unstated) {
            ended = true;
        }
        or (ended) {
            ret 4;
        }
        or (sel rule.is) {
            if (!names_type(r, rule.is.subject) || sel rule.is.class.unstated) { ret 4; }
        }
        or (sel rule.agree) {
            if (!names_type(r, rule.agree.left) || !names_type(r, rule.agree.right)) { ret 4; }
        }
        or (sel rule.parameters) {
            if (!names_type(r, rule.parameters)) { ret 4; }
            tail_rules = tail_rules + 1;
        }
        or (sel rule.returns) {
            tail_rules = tail_rules + 1;
        }
        or (sel rule.conform) {
            if (!names_type(r, rule.conform.left) || !names_type(r, rule.conform.right)) { ret 4; }
        }
        or (sel rule.element) {
            if (!names_type(r, rule.element.left) || !names_type(r, rule.element.right)) { ret 4; }
        }
        or (sel rule.wider) {
            if (!names_type(r, rule.wider.left) || !names_type(r, rule.wider.right)) { ret 4; }
        }
        or (sel rule.bits) {
            if (!names_type(r, rule.bits.left) || !names_type(r, rule.bits.right)) { ret 4; }
        }
        or (sel rule.lane) {
            val ln: Lane = rule.lane;
            if (!holds(r, ln.slot, false) && !holds(r, ln.slot, true))          { ret 4; }
            if (!names_type(r, ln.over.left))                                   { ret 4; }
            if (!(sel ln.over.right.unstated) && !names_type(r, ln.over.right)) { ret 4; }
        }
        or (sel rule.count) {
            if (!holds(r, rule.count.slot, true) || !names_type(r, rule.count.of)) { ret 4; }
        }
        or (sel rule.lanes_of) {
            if (!names_type(r, rule.lanes_of)) { ret 4; }
            tail_rules = tail_rules + 1;
        }
        or (sel rule.ordering) {
            if (!holds_ordering(r, rule.ordering.slot)) { ret 4; }
        }
        or (sel rule.named) {
            if (!holds_kind(r, rule.named.slot, false) || !names_type(r, rule.named.of)) { ret 4; }
        }
        or (sel rule.places) {
            if (!holds_kind(r, rule.places.slot, true))                           { ret 4; }
            if (!(sel rule.places.of.unstated) && !names_type(r, rule.places.of)) { ret 4; }
            if (sel rule.places.of.unstated)                                      { tail_rules = tail_rules + 1; }
        }
        or (sel rule.member) {
            if (!names_member(r, rule.member)) { ret 4; }
        }
        or (sel rule.fits) {
            if (!names_type(r, rule.fits.subject) || !names_member(r, rule.fits.member)) { ret 4; }
        }
        or (sel rule.cases) {
            val cs: Cases = rule.cases;
            if (cs.slot >= slots(r)) { ret 4; }
            val h: Holds = r.immediates[cs.slot].holds;
            if (!(sel h.cases))                         { ret 4; }
            if (!names_type(r, cs.of) || !r.terminator) { ret 4; }
            if (!(sel r.targets.at_least))              { ret 4; }
            if (r.targets.at_least == 0)                { ret 4; }
        }
        i = i + 1;
    }
    if ((sel r.tail.unstated) != (tail_rules == 0)) { ret 5; }

    var results: u32 = 0;
    var masks:   u32 = 0;
    var lanes:   u32 = 0;
    ended = false;
    i     = 0;
    for (i < $length_of(Results)) {
        val res: Result = r.results[i];
        if (sel res.unstated) {
            ended = true;
        }
        or (ended) {
            ret 6;
        }
        or (sel res.same && !names_type(r, res.same))       { ret 6; }
        or (sel res.mask && !names_type(r, res.mask))       { ret 6; }
        or (sel res.results && !names_type(r, res.results)) { ret 6; }
        or (sel res.element && !names_type(r, res.element)) { ret 6; }
        or (sel res.member && !names_member(r, res.member)) { ret 6; }
        if (sel res.mask)                                   { masks = masks + 1; }
        if (sel res.element)                                { lanes = lanes + 1; }
        if (!(sel res.unstated))                            { results = results + 1; }
        i = i + 1;
    }

    val e:     *Effects = ?r.effects;
    var traps: u32      = 0;
    ended = false;
    i     = 0;
    for (i < $length_of(Traps)) {
        val t: Trap = e.traps[i];
        if (sel t.unstated) {
            ended = true;
        }
        or (ended) {
            ret 7;
        }
        or (sel t.always && !r.terminator)                                                         { ret 7; }
        or (sel t.zero && t.zero >= operands)                                                      { ret 7; }
        or (sel t.fault && t.fault >= operands)                                                    { ret 7; }
        or (sel t.overflow && (t.overflow.dividend >= operands || t.overflow.divisor >= operands)) { ret 7; }
        or (sel t.exceeds && (t.exceeds.dividend >= operands || t.exceeds.divisor >= operands))    { ret 7; }
        if (!(sel t.unstated))                                                                     { traps = traps + 1; }
        i = i + 1;
    }
    if (e.speculatable && (traps != 0 || e.reads || e.writes)) { ret 8; }
    if (e.mergeable && e.writes)                               { ret 8; }
    if (e.keepable && (!e.writes || e.reads || e.mergeable))   { ret 8; }

    var targets: u32 = 0;
    if (sel r.targets.exact)                                                { targets = r.targets.exact; }
    if (sel r.targets.at_least)                                             { targets = r.targets.at_least; }
    if (targets != 0 && !r.terminator)                                      { ret 9; }
    if (sel r.secrecy.unstated)                                             { ret 10; }
    if ((sel r.secrecy.none) != (results == 0))                             { ret 10; }
    if (sel r.vector.unstated)                                              { ret 11; }
    if (sel r.order.unstated)                                               { ret 13; }
    if ((sel r.order.ordered || sel r.order.unordered) && masks == 0)       { ret 13; }
    if ((sel r.order.sequential || sel r.order.reassociable) && lanes == 0) { ret 13; }
    i = 0;
    for (i < immediates) {
        if ((sel r.immediates[i].holds.ordering) && (e.speculatable || e.mergeable || e.keepable)) { ret 8; }
        i = i + 1;
    }
    if (!(sel r.overshift.none) && operands != 2) { ret 12; }
    val start: opt[u32] = base(r);
    if (sel r.forms.unstated)                                                                         { ret 14; }
    if ((sel r.forms.member || sel r.forms.index) && sel start.none)                                  { ret 14; }
    if (sel r.forms.member && !names_member(r, r.forms.member))                                       { ret 14; }
    if (sel r.forms.index && (r.forms.index.operand >= operands || !names_type(r, r.forms.index.of))) { ret 14; }
    if (sel r.forms.function) {
        val at: u32 = r.forms.function;
        if (at >= immediates)                          { ret 14; }
        if (!(sel r.immediates[at].holds.function))    { ret 14; }
    }
    ret 0;
}

test table__rows_well_formed {
    var i: u32 = 0;
    for (i < rows()) {
        val got: opt[Row] = row(Opcode{index: i});
        if (sel got.none) { ret 1; }
        var r:      Row = got.some;
        val defect: u32 = formed(?r);
        if (defect != 0) { ret (10 + defect)::i32; }
        var j: u32 = 0;
        for (j < i) {
            if (str_equals(ROWS[j].name, r.name)) { ret 2; }
            j = j + 1;
        }
        i = i + 1;
    }
    val past: opt[Row] = row(Opcode{index: rows()});
    if (sel past.some) { ret 3; }
    ret 0;
}
