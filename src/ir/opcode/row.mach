# the opcode row schema: everything an opcode is, stated once as data
#
# the verifier, the printer, the parser and every pass read the same row. a
# fixed list holds its stated entries first, and an unstated entry ends it.

use std.types.bool.bool;
use std.types.string.str;

use std.collections.slice.Slice;

use mirl.ir.opcode.rule.Ordering;
use mirl.ir.opcode.rule.Overshift;
use mirl.ir.opcode.rule.Result;
use mirl.ir.opcode.rule.Rule;
use mirl.ir.opcode.rule.Secrecy;
use mirl.ir.opcode.rule.Trap;
use mirl.ir.place.Named;
use mirl.ir.place.Placed;
use mirl.ir.type.Type;

# an opcode, as an id into the opcode table
# ---
# index: the opcode's row in the table
pub rec Opcode {
    index: u32;
}

# what an operand is to its operation
# ---
# value:     an ordinary input
# address:   a pointer the operation reads or writes through
# stored:    the value a store writes
# offset:    a byte count added to an address
# length:    a byte count a memory operation covers
# condition: what a branch decides on
# callee:    the address of the function called
# argument:  a value passed to the function called
# returned:  a value the function returns
pub tag Role: u8 {
    unstated;
    value;
    address;
    stored;
    offset;
    length;
    condition;
    callee;
    argument;
    returned;
}

# a fixed operand of a row
# ---
# name: its name in the text form
# role: what it is to the operation
pub rec Operand {
    name: str;
    role: Role;
}

# what an immediate holds
# ---
# ty:        a type
# alignment: a byte alignment, a power of two
# ordering:  a memory ordering
# lane:      one lane index
# lanes:     a list of lane indices
# named:     how many of a call's arguments are named
# places:    a list of the places pieces travel at
pub tag Holds: u8 {
    unstated;
    ty;
    alignment;
    ordering;
    lane;
    lanes;
    named;
    places;
}

# an immediate of a row: a fact of the instance that is not a value
# ---
# name:  its name in the text form
# holds: what it holds
pub rec Slot {
    name:  str;
    holds: Holds;
}

# the immediate an instance gives for a slot
#
# a lane list or a place list is borrowed from the caller wherever an
# immediate is passed, and an instruction keeps a copy of its own.
# ---
# ty:        a type
# alignment: a byte alignment
# ordering:  a memory ordering
# lane:      one lane index
# lanes:     a list of lane indices
# named:     how many of a call's arguments are named
# places:    one place for each piece, in order
pub tag Immediate: u8 {
    ty:        Type;
    alignment: u64;
    ordering:  Ordering;
    lane:      u32;
    lanes:     Slice[u32];
    named:     Named;
    places:    Slice[Placed];
}

# the fixed lists of a row, each its stated entries then unstated ones
pub def Operands: [4]Operand;
pub def Slots:    [3]Slot;
pub def Rules:    [6]Rule;
pub def Results:  [2]Result;
pub def Traps:    [2]Trap;

# how many of something an instance has
# ---
# exact:    exactly this many
# at_least: this many or more
pub tag Arity: u8 {
    exact:    u32;
    at_least: u32;
}

# what executing an instance may do beyond giving its results
# ---
# traps:        when it traps, none for an operation that never does
# reads:        it may read memory
# writes:       it may write memory
# speculatable: it may run where its result is not needed
# mergeable:    two instances with the same operands give the same results
#               and one may stand for both
# keepable:     an instance may be marked kept, so its write is a fixed fact
pub rec Effects {
    traps:        Traps;
    reads:        bool;
    writes:       bool;
    speculatable: bool;
    mergeable:    bool;
    keepable:     bool;
}

# how an operation applies to vectors
# ---
# none:     it takes no vector as a lane operation
# lanewise: it applies lane by lane, and its classes speak of the lanes
# across:   it takes one vector as a whole, and its classes speak of the lanes
#           of that vector
pub tag VectorClass: u8 {
    unstated;
    none;
    lanewise;
    across;
}

# how an operation orders what it combines or compares
#
# the order is stated by the row, never inferred.
# ---
# none:         the operation has no order to state
# ordered:      a compare is false when an operand is not a number, and an
#               ordered test is true only when neither is not a number
# unordered:    a compare is true when an operand is not a number, and an
#               unordered test is true when either is not a number
# sequential:   a reduction combines the lanes one after another from the
#               first, so the result is exactly the one that order gives
# reassociable: a reduction combines the lanes in any order and grouping, so
#               the result is any one such an order gives
pub tag Order: u8 {
    unstated;
    none;
    ordered;
    unordered;
    sequential;
    reassociable;
}

# one opcode
# ---
# name:       its name in the text form
# operands:   its fixed operands, in order
# tail:       the role of the operands after the fixed ones, unstated when
#             there are none
# immediates: its immediates, in order
# targets:    how many blocks it branches to
# terminator: it ends its block
# rules:      the constraints on an instance
# results:    how each result is derived, in order
# effects:    what it may do
# overshift:  what a shift by the width or more gives
# secrecy:    how its results' secrecy follows
# order:      how it orders what it combines or compares
# vector:     its vector class
pub rec Row {
    name:       str;
    operands:   Operands;
    tail:       Role;
    immediates: Slots;
    targets:    Arity;
    terminator: bool;
    rules:      Rules;
    results:    Results;
    effects:    Effects;
    overshift:  Overshift;
    secrecy:    Secrecy;
    order:      Order;
    vector:     VectorClass;
}

# the number of fixed operands a row states
pub fun fixed(r: *Row) u32 {
    var n: u32 = 0;
    for (n < $length_of(Operands) && !(sel r.operands[n].role.unstated)) { n = n + 1; }
    ret n;
}

# the number of immediates a row states
pub fun slots(r: *Row) u32 {
    var n: u32 = 0;
    for (n < $length_of(Slots) && !(sel r.immediates[n].holds.unstated)) { n = n + 1; }
    ret n;
}
