# the typing rule vocabulary: what a row states and the one checker reads
#
# a row's rules are constraints over its subjects, and its results are each
# derived from a subject. a new kind of rule is a new case here and in the
# checker, never a branch on an opcode.

use std.types.bool.bool;

use mirl.ir.type.format.Format;

# what a rule speaks of
#
# operand and immediate positions count from zero over the row's fixed
# operands and its immediates.
# ---
# operand:   the type of the fixed operand at this position
# immediate: the type the immediate at this position holds
pub tag Subject: u8 {
    unstated;
    operand:   u32;
    immediate: u32;
}

# a set of types
#
# in a lanewise row a vector subject is tested lane by lane, so `integer`
# there admits a vector of integers. in an across row the subject must be a
# vector and its lanes are tested. in any other row the subject is tested
# whole, and `vector` is the class that admits a vector.
# ---
# any:      every type
# integer:  an integer of any width
# width:    an integer of exactly this width, such as 1 for a condition
# float:    a float in any number format
# format:   a float in exactly this number format
# pointer:  a pointer in any address space
# function: a function type
# bytes:    an integer whose width is a whole number of bytes
# vector:   a vector of any lane type
# scalar:   an integer, a float or a pointer, which has no lanes
pub tag Class: u8 {
    unstated;
    any;
    integer;
    width: u32;
    float;
    format: Format;
    pointer;
    function;
    bytes;
    vector;
    scalar;
}

# a subject and the class it must be in
pub rec Bound {
    subject: Subject;
    class:   Class;
}

# two subjects
pub rec Pair {
    left:  Subject;
    right: Subject;
}

# the memory orderings an atomic access or fence can state
pub tag Ordering: u8 {
    relaxed;
    acquire;
    release;
    acq_rel;
    seq_cst;
}

# which orderings an immediate may state, each true when allowed
pub rec Orderings {
    relaxed: bool;
    acquire: bool;
    release: bool;
    acq_rel: bool;
    seq_cst: bool;
}

# whether an ordering is one of a set
pub fun holds(set: Orderings, o: Ordering) bool {
    if (sel o.relaxed) { ret set.relaxed; }
    if (sel o.acquire) { ret set.acquire; }
    if (sel o.release) { ret set.release; }
    if (sel o.acq_rel) { ret set.acq_rel; }
    ret set.seq_cst;
}

# whether an ordering acquires, as acquire, acq_rel and seq_cst do
fun acquires(o: Ordering) bool {
    ret sel o.acquire || sel o.acq_rel || sel o.seq_cst;
}

# whether an ordering releases, as release, acq_rel and seq_cst do
fun releases(o: Ordering) bool {
    ret sel o.release || sel o.acq_rel || sel o.seq_cst;
}

# the weakest ordering at least as strong as both, an acquire and a release
# joining as acq_rel, as one access that keeps both orderings must
pub fun joined(a: Ordering, b: Ordering) Ordering {
    if (sel a.seq_cst || sel b.seq_cst) { ret Ordering.seq_cst{}; }
    val acquire: bool = acquires(a) || acquires(b);
    val release: bool = releases(a) || releases(b);
    if (acquire && release) { ret Ordering.acq_rel{}; }
    if (acquire)            { ret Ordering.acquire{}; }
    if (release)            { ret Ordering.release{}; }
    ret Ordering.relaxed{};
}

# the orderings the immediate at a position may hold
# ---
# slot:      the position of the immediate
# orderings: the orderings it may hold
pub rec Allowed {
    slot:      u32;
    orderings: Orderings;
}

# a lane index immediate and the vectors it indexes
#
# a single lane or each lane of a list must be below the lane count of the
# left subject plus that of the right when it is stated.
# ---
# slot: the position of the immediate, which holds a lane or a lane list
# over: the vectors the lanes index
pub rec Lane {
    slot: u32;
    over: Pair;
}

# a lane list immediate and the vector whose lane count it must match
# ---
# slot: the position of the immediate, which holds a lane list
# of:   the vector subject
pub rec Count {
    slot: u32;
    of:   Subject;
}

# an immediate stating something of each piece or argument of a call, and the
# function type it speaks of
# ---
# slot: the position of the immediate
# of:   the function type subject, or unstated for the tail operands alone
pub rec Listed {
    slot: u32;
    of:   Subject;
}

# one constraint a row places on an instance
#
# bits are counted over a whole subject from the type table and the number
# format table alone, never a data layout, so a subject with no stated bit
# width (a pointer or an aggregate) cannot be compared by `wider` or `bits`.
# ---
# is:         the subject is in the class
# agree:      the two subjects are the same type
# parameters: the tail operands are the parameters of the function type the
#             subject is, in number and type
# returns:    the tail operands are the results of the function the
#             instruction is in, in number and type
# conform:    both subjects are scalars, or both are vectors of the same lane
#             count
# element:    the lane types of the two subjects are the same, a scalar being
#             its own lane
# wider:      the left subject has more bits than the right
# bits:       the two subjects have the same number of bits
# lane:       the lane immediate indexes within the vectors
# count:      the lane list holds one index per lane of the vector
# lanes_of:   the tail operands are the lanes of the vector type the subject
#             is, in number and type
# ordering:   the ordering immediate is one of those allowed
# named:      the named count is stated and no more than the parameters of the
#             function type
# places:     the place list holds one place per parameter and result of the
#             function type, or per tail operand when it names none
pub tag Rule: u8 {
    unstated;
    is:         Bound;
    agree:      Pair;
    parameters: Subject;
    returns;
    conform:  Pair;
    element:  Pair;
    wider:    Pair;
    bits:     Pair;
    lane:     Lane;
    count:    Count;
    lanes_of: Subject;
    ordering: Allowed;
    named:    Listed;
    places:   Listed;
}

# how a row derives its results
# ---
# same:    one result of the subject's type
# mask:    one result of i1, or of a vector of i1 with the subject's lanes when
#          the subject is a vector
# results: the results of the function type the subject is, in order
# element: one result of the lane type of the vector the subject is
pub tag Result: u8 {
    unstated;
    same:    Subject;
    mask:    Subject;
    results: Subject;
    element: Subject;
}

# a division's operand positions
# ---
# dividend: the position of the dividend, or of its high word where the
#           dividend is two words
# divisor:  the position of the divisor
pub rec Division {
    dividend: u32;
    divisor:  u32;
}

# when an instance traps, a defined trap on every target
# ---
# zero:     the fixed operand at this position is zero, in any lane
# overflow: the dividend is the least signed value and the divisor is all ones,
#           in any lane
# exceeds:  the quotient of a two-word dividend by the divisor does not fit a
#           word: the high word is no less than the divisor, both read as
#           unsigned, in any lane
# fault:    the address the fixed operand at this position holds cannot be
#           accessed
# callee:   the function called traps
# always:   every execution traps, so the row is a terminator that is a defined
#           trap and never an undefined path
pub tag Trap: u8 {
    unstated;
    zero:     u32;
    overflow: Division;
    exceeds:  Division;
    fault:    u32;
    callee;
    always;
}

# what a shift by its operand's width or more gives
# ---
# none: the row is not a shift
# zero: every bit is zero
# sign: every bit is the shifted operand's sign bit
pub tag Overshift: u8 {
    none;
    zero;
    sign;
}

# how the secrecy of the results follows from the instance
# ---
# none:         the row has no results
# propagates:   a result is secret when any operand is
# declassifies: every result is public
# declared:     a result is secret when the instruction's metadata says so
pub tag Secrecy: u8 {
    unstated;
    none;
    propagates;
    declassifies;
    declared;
}
