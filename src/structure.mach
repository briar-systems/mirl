# the structurizer that turns any graph into structured regions
#
# a target that declares structured control flow runs it as a legalisation,
# and its emitter reads each function's tree of regions as the structure
# analysis of mirl.pass.analysis.

use mirl.structure.pass;
use regions: mirl.structure.region;
use mirl.structure.shape;

fwd pass.STRUCTURIZE;

fwd regions.Kind;
fwd regions.Region;
fwd regions.Structure;
fwd regions.count;
fwd regions.region;
fwd regions.root;

fwd shape.Site;
fwd shape.Flaw;
fwd shape.Work;
fwd shape.find;
fwd shape.why;
