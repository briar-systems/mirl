# what a command is to the program: its std.args registration, its handler, and the
# context the handler runs in
#
# a command line is `mirl <command> [file] [options]`, read by std.args against the
# program's command set, so the conventions are std's: `--key value` or `--key=value`,
# `--no-key` clears a switch, and `--` ends the options. a command that takes a file
# takes one, as its operand.

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.args;
use io: std.io.writer;

# the context a command's handler runs in
# ---
# a:        the allocator the command takes its storage from
# operand:  the file operand, nil when the command takes none
# inv:      the command line, read against the command, which flags are asked of
# out:      the writer of the command's output
# diag:     the writer of its diagnostics
# commands: every command, which help lists
pub rec Call {
    a:        *A.Allocator;
    operand:  str;
    inv:      args.Invocation;
    out:      *io.Writer;
    diag:     *io.Writer;
    commands: *args.CommandSet;
}

# one command as the program runs it: its registration and its handler
# ---
# spec: the command's registration, a member of the program's command set
# run:  the handler, whose ret is the exit code
pub rec Command {
    spec: *args.CommandSpec;
    run:  fun(*Call) i64;
}

# the command whose registration a line was read against, nil when none is
# ---
# rows: first entry of the command list
# n:    length of rows
# spec: the registration the line read
pub fun command_for(rows: **Command, n: usize, spec: *args.CommandSpec) *Command {
    var i: usize = 0;
    for (i < n) {
        if (rows[i].spec == spec) { ret rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# the context a command runs in over a line read against it
# ---
# a:        the allocator the command takes its storage from
# inv:      the line, read and refused nothing
# out:      the writer of the command's output
# diag:     the writer of its diagnostics
# commands: every command, which help lists
pub fun call_of(a: *A.Allocator, inv: args.Invocation, out: *io.Writer, diag: *io.Writer, commands: *args.CommandSet) Call {
    var c:  Call       = Call{a: a, operand: nil, inv: inv, out: out, diag: diag, commands: commands};
    val at: opt[usize] = args.operand(?c.inv, 0);
    if (sel at.some) { c.operand = inv.args.argv[at.some]::str; }
    ret c;
}
