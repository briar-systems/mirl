# what a command is to the program: its std.args registration, its handler, and the
# context the handler runs in
#
# a command line is `mirl <command> [file] [options]`, read by std.args' parser against the
# program's root command: `--key value` or `--key=value`, `--no-key` clears a switch, and `--`
# ends the options. a command that takes a file takes one, as its operand. help, the version
# and the exit codes are mirl's own

use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.args;
use std.format;
use io: std.io.writer;

use mirl.cli.layout;
use mirl.cli.readout;
use mirl.cli.readout.Readout;
use mirl.failure.text;
use mirl.failure.text.Out;
use mirl.ir.module;

# the flag every command and the root read, asking for the page of the command matched
pub val HELP: args.Flag = args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show help"};

# the flag every command reads, once for a log line per stage and twice for a line per function
# and the target's facts too
pub val VERBOSE: args.Flag = args.Flag{long: "verbose", short: 'v', value: nil, repeat: true, negatable: false, help: "log each stage, and with -vv each function and the target's facts"};

# the context a command's handler runs in
# ---
# a:       the allocator the command takes its storage from
# operand: the file operand, nil when the command takes none
# p:       the command line, read against the command, which flags are asked of
# rd:      what the command writes for a person: its results, log lines and live line
# out:     the writer of the command's output, stdout through the readout
# report:  where its diagnostics go, stderr through the readout, and the file operand
pub rec Call {
    a:       *A.Allocator;
    operand: str;
    p:       *args.Parsed;
    rd:      *Readout;
    out:     *io.Writer;
    report:  Out;
}

# one command as the program runs it: its registration and its handler
# ---
# spec: the command's registration, a command nested under the program's root
# run:  the handler, whose ret is the exit code
pub rec Command {
    spec: *args.Command;
    run:  fun(*Call) i64;
}

# the command whose registration a line matched, nil when none is
# ---
# rows: first entry of the command list
# n:    length of rows
# spec: the registration the line matched
pub fun command_for(rows: **Command, n: usize, spec: *args.Command) *Command {
    var i: usize = 0;
    for (i < n) {
        if (rows[i].spec == spec) { ret rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# the context a command runs in over a line read against it
# ---
# a:  the allocator the command takes its storage from
# p:  the line, read and refused nothing, which outlives the call
# rd: the command's readout, which outlives the call
pub fun call_of(a: *A.Allocator, p: *args.Parsed, rd: *Readout) Call {
    var operand:     str      = nil;
    val opt_operand: opt[str] = args.operand(p, 0);
    if (sel opt_operand.some) { operand = opt_operand.some; }
    ret Call{a: a, operand: operand, p: p, rd: rd, out: ?rd.out, report: text.tool(a, ?rd.diag, operand)};
}

# the readout level a line asks for: results alone, a log line per stage under -v, a line per
# item too under -vv and more
pub fun level_of(p: *args.Parsed) u8 {
    val n: usize = args.occurrences(p, ?VERBOSE);
    if (n >= 2) { ret readout.ITEMS; }
    if (n == 1) { ret readout.STAGES; }
    ret readout.RESULTS;
}

# the field values a command's closing result reads, written as the result is
# ---
# name:     the storage the target's name is written into
# target:   the target the command settled, as `linux-x86_64`, nil before it settled one
# warnings: the warnings it gave
pub rec Closing {
    name:     layout.Value;
    target:   str;
    warnings: u64;
}

# a closing with nothing settled yet, made in place as its target's name points into it
pub fun closing(c: *Closing) {
    c.target   = nil;
    c.warnings = 0;
}

# the command settled its target, the module's statement as it stands
pub fun settle(c: *Closing, tuple: module.Tuple) {
    c.target = target_name(?c.name, tuple);
}

# a command that refused, its diagnostic written: the block closed, then `failed` and the
# operand, its target, its one error, its warnings and the time since it began
pub fun failed(call: *Call, c: *Closing) {
    readout.settled(call.rd);
    var w:      layout.Text;
    var t:      layout.Text;
    var fields: [4]layout.Field = [4]layout.Field{
        layout.Field{key: "target", value: c.target},
        layout.Field{key: "errors", value: "1"},
        layout.Field{key: "warnings", value: layout.nonzero(?w, c.warnings)},
        layout.Field{key: "time", value: layout.took(?t, readout.elapsed(call.rd))},
    };
    readout.result(call.rd, layout.FAILED, call.operand, ?fields[0], 4);
}

# a target as a result and a log line name it, `sys-arch`, written into v
pub fun target_name(v: *layout.Value, tuple: module.Tuple) str {
    var w: io.Writer = layout.value_writer(v);
    format.write_bytes(?w, tuple.sys.data::*u8, tuple.sys.len);
    format.write_byte(?w, '-');
    format.write_bytes(?w, tuple.arch.data::*u8, tuple.arch.len);
    ret layout.value_end(v);
}
