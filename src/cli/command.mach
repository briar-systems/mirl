# what a command is to the program: its std.args registration, its handler, and the
# context the handler runs in
#
# a command line is `mirl <command> [file] [options]`, read by std.args' parser against the
# program's root command: `--key value` or `--key=value`, `--no-key` clears a switch, and `--`
# ends the options. a command that takes a file takes one, as its operand. help, the version
# and the exit codes are mirl's own

use std.types.bool.false;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.args;
use io: std.io.writer;

# the flag every command and the root read, asking for the page of the command matched
pub val HELP: args.Flag = args.Flag{long: "help", short: 'h', value: nil, repeat: false, negatable: false, help: "show help"};

# the context a command's handler runs in
# ---
# a:       the allocator the command takes its storage from
# operand: the file operand, nil when the command takes none
# p:       the command line, read against the command, which flags are asked of
# out:     the writer of the command's output
# diag:    the writer of its diagnostics
pub rec Call {
    a:       *A.Allocator;
    operand: str;
    p:       *args.Parsed;
    out:     *io.Writer;
    diag:    *io.Writer;
}

# one command as the program runs it: its registration and its handler
# ---
# spec: the command's registration, a command nested under the program's root
# run:  the handler, whose ret is the exit code
pub rec Command {
    spec: *args.Command;
    run:  fun(*Call) i64;
}

# the command whose registration a line matched, nil when none is
# ---
# rows: first entry of the command list
# n:    length of rows
# spec: the registration the line matched
pub fun command_for(rows: **Command, n: usize, spec: *args.Command) *Command {
    var i: usize = 0;
    for (i < n) {
        if (rows[i].spec == spec) { ret rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# the context a command runs in over a line read against it
# ---
# a:    the allocator the command takes its storage from
# p:    the line, read and refused nothing, which outlives the call
# out:  the writer of the command's output
# diag: the writer of its diagnostics
pub fun call_of(a: *A.Allocator, p: *args.Parsed, out: *io.Writer, diag: *io.Writer) Call {
    var c:  Call     = Call{a: a, operand: nil, p: p, out: out, diag: diag};
    val at: opt[str] = args.operand(p, 0);
    if (sel at.some) { c.operand = at.some; }
    ret c;
}
