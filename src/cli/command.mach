# the command table: what a command is, how a command line is read against it, and the
# context a command runs in
#
# a command line is `mirl <command> [file] [options]`. the flags are read by std.args, so the
# conventions are std's: `--key value` or `--key=value`, `--no-key` clears a switch, and `--`
# ends the options. a command that takes a file takes one, as its operand.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use T: std.allocator.testing;
use std.args;
use io: std.io.writer;

# the context a command's handler runs in
# ---
# a:        the allocator the command takes its storage from
# operand:  the file operand, nil when the command takes none
# reader:   the command line, read to its end, which flags are asked of
# out:      the writer of the command's output
# diag:     the writer of its diagnostics
# commands: every command, which help lists
pub rec Call {
    a:        *A.Allocator;
    operand:  str;
    reader:   args.Reader;
    out:      *io.Writer;
    diag:     *io.Writer;
    commands: CommandSet;
}

# one command: its word, its help and what it takes
# ---
# name:    the command word, such as `verify`
# summary: one-line help text
# usage:   the synopsis help shows after `mirl`, such as `verify <file> [options]`
# file:    the command takes one file operand, which is required
# flags:   its flag rows, the first entry of a list; nil when flag_n is 0
# flag_n:  length of flags
# run:     the handler, whose ret is the exit code
pub rec Command {
    name:    str;
    summary: str;
    usage:   str;
    file:    bool;
    flags:   **args.Flag;
    flag_n:  usize;
    run:     fun(*Call) i64;
}

# the commands a command line is read against, in help order
# ---
# rows: first entry of the command list
# n:    length of rows
pub rec CommandSet {
    rows: **Command;
    n:    usize;
}

# the command a word names, nil when none does
pub fun command_for(set: CommandSet, word: str) *Command {
    var i: usize = 0;
    for (i < set.n) {
        if (str_equals(set.rows[i].name, word)) { ret set.rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# what a command line was refused for
# ---
# unknown_command: the word names no command
# unknown_option:  the spelling names no flag of the command
# missing_value:   a value flag ends the line with no value after it
# repeated:        a flag that does not repeat was given again
# unexpected:      an operand the command does not take
# missing_file:    the command takes a file and the line gives none
pub tag Usage: u8 {
    unknown_command: str;
    unknown_option:  str;
    missing_value:   str;
    repeated:        str;
    unexpected:      str;
    missing_file;
}

# why a command line did not read
# ---
# alloc: the allocator refused storage
# usage: the line is not one the command takes
pub tag Error: u8 {
    alloc: A.Error;
    usage: Usage;
}

# a command line read against its command
# ---
# operand: the file operand, nil when the command takes none
# reader:  the reader, at the end of the line
pub rec Reading {
    operand: str;
    reader:  args.Reader;
}

fun refused(u: Usage) res[Reading, Error] {
    ret res[Reading, Error].err{Error.usage{u}};
}

# the usage a std.args refusal is
fun usage_of(e: args.Error) Usage {
    if (sel e.unknown) {
        ret Usage.unknown_option{e.unknown.flag};
    }
    or (sel e.missing_value) {
        ret Usage.missing_value{e.missing_value.flag};
    }
    ret Usage.repeated{e.repeated.flag};
}

# read a command line against a command, from the token after the command word
# ---
# a:   the allocator the flag settings take their storage from
# c:   the command the line names
# all: the process arguments, the command word at index 1
# ret: the reading, or why the line is not one the command takes
pub fun read(a: *A.Allocator, c: *Command, all: args.Args) res[Reading, Error] {
    val made: res[*args.Setting, A.Error] = A.zallocate[args.Setting](a, c.flag_n + 1);
    if (sel made.err) { ret res[Reading, Error].err{Error.alloc{made.err}}; }

    var rd:      args.Reader = args.reader(all, 2, c.flags, c.flag_n, made.ok);
    var operand: str         = nil;
    for {
        val e: res[args.Event, args.Error] = args.read(?rd);
        if (sel e.err)     { ret refused(usage_of(e.err)); }
        if (sel e.ok.done) { brk; }
        if (sel e.ok.operand) {
            val tok: str = all.argv[e.ok.operand]::str;
            if (!c.file || operand != nil) { ret refused(Usage.unexpected{tok}); }
            operand = tok;
        }
    }
    if (c.file && operand == nil) { ret refused(Usage.missing_file{}); }
    ret res[Reading, Error].ok{Reading{operand: operand, reader: rd}};
}

# the context a command runs in over a line read against it
# ---
# a:        the allocator the command takes its storage from
# r:        the line, read
# out:      the writer of the command's output
# diag:     the writer of its diagnostics
# commands: every command, which help lists
pub fun call_of(a: *A.Allocator, r: Reading, out: *io.Writer, diag: *io.Writer, commands: CommandSet) Call {
    ret Call{a: a, operand: r.operand, reader: r.reader, out: out, diag: diag, commands: commands};
}

val T_WRITE: args.Flag = args.Flag{name: "--write", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.override{}, value: "", doc: ""};
val T_LEVEL: args.Flag = args.Flag{name: "--level", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.override{}, value: "n", doc: ""};

val T_FLAGS: [2]*args.Flag = [2]*args.Flag{?T_WRITE, ?T_LEVEL};

test read__switch_sets_and_clears_and_value_takes_the_next_token {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }

    var c: Command;
    c.file   = true;
    c.flags  = ?T_FLAGS[0];
    c.flag_n = 2;

    var on:    [6]*u8              = [6]*u8{"mirl", "fmt", "--level", "3", "--write", "x.mirl"};
    val a:     *A.Allocator        = T.allocator_of(?t);
    val first: res[Reading, Error] = read(a, ?c, args.of(6, ?on[0]));
    if (sel first.err) { ret 2; }
    val set: res[bool, args.Misread] = args.on(first.ok.reader, ?T_WRITE);
    if (sel set.err) { ret 3; }
    if (!set.ok)     { ret 3; }
    val level: res[str, args.Misread] = args.value(first.ok.reader, ?T_LEVEL);
    if (sel level.err)                           { ret 4; }
    if (!str_equals(level.ok, "3"))              { ret 4; }
    if (!str_equals(first.ok.operand, "x.mirl")) { ret 5; }

    var off:    [5]*u8              = [5]*u8{"mirl", "fmt", "x.mirl", "--write", "--no-write"};
    val second: res[Reading, Error] = read(a, ?c, args.of(5, ?off[0]));
    if (sel second.err) { ret 6; }
    val cleared: res[bool, args.Misread] = args.on(second.ok.reader, ?T_WRITE);
    if (sel cleared.err) { ret 7; }
    if (cleared.ok)      { ret 7; }

    var bare:  [2]*u8              = [2]*u8{"mirl", "fmt"};
    val third: res[Reading, Error] = read(a, ?c, args.of(2, ?bare[0]));
    if (sel third.ok)                        { ret 8; }
    if (sel third.err.alloc)                 { ret 9; }
    if (!(sel third.err.usage.missing_file)) { ret 10; }
    ret 0;
}
