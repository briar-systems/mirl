# the program's help: a command's page, or the overview as the root's, rendered by
# std.args.help from the line that matched it

use std.types.error.err;

use std.args;
use args_help: std.args.help;
use io:        std.io.writer;

use mirl.cli.diagnostic;
use mirl.cli.exit;

# write the page of the command a line matched
# ---
# out:  the writer the page goes to
# diag: the writer of the failure to write it
# p:    the line, its command the page's
# ret:  the exit code of the failure, or OK
pub fun show(out: *io.Writer, diag: *io.Writer, p: *args.Parsed) i64 {
    val shown: err[io.WriteError] = args_help.render(p, out, args_help.terminal_width());
    if (sel shown.err) {
        diagnostic.headline(diag, nil, "cannot write the help");
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}
