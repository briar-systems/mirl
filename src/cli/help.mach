# the program's help: a command's page, rendered by std.args.help from the line that
# matched it, and the overview, the root's page with the exit codes after it

use std.types.error.err;
use std.types.size.usize;

use std.args;
use args_help: std.args.help;
use std.format;
use io: std.io.writer;

use mirl.cli.diagnostic;
use mirl.cli.exit;

# write the page of the command a line matched
# ---
# out:  the writer the page goes to
# diag: the writer of the failure to write it
# p:    the line, its command the page's
# ret:  the exit code of the failure, or OK
pub fun show(out: *io.Writer, diag: *io.Writer, p: *args.Parsed) i64 {
    val shown: err[io.WriteError] = args_help.render(p, out, args_help.terminal_width());
    if (sel shown.err) {
        diagnostic.headline(diag, nil, "cannot write the help");
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}

# write the overview of the program: the root's page, its commands, and the exit codes
# ---
# out:  the writer the page goes to
# diag: the writer of the failure to write it
# p:    a line that matched the root
# ret:  the exit code of the failure, or OK
pub fun overview(out: *io.Writer, diag: *io.Writer, p: *args.Parsed) i64 {
    val shown: i64 = show(out, diag, p);
    if (shown != exit.OK) { ret shown; }
    val head: err[io.WriteError] = io.write_str(out, "\nexit codes:\n");
    if (sel head.err) { ret exit.ENVIRONMENT; }
    var i: usize = 0;
    for (i < exit.NOTES_N) {
        format.write_str(out, "  ");
        format.write_u64(out, exit.NOTES[i].code::u64);
        format.write_str(out, "  ");
        format.write_str(out, exit.NOTES[i].meaning);
        val ended: err[io.WriteError] = io.write_str(out, "\n");
        if (sel ended.err) { ret exit.ENVIRONMENT; }
        i = i + 1;
    }
    ret exit.OK;
}
