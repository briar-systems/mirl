# the program's help: the overview of every command and the exit codes, and the
# page a command's --help shows

use std.types.size.usize;
use std.types.string.str_len;

use std.format;
use io: std.io.writer;

use mirl.cli.command;
use mirl.cli.exit;

# the column the option and command help text starts at
val COLUMN: usize = 24;

# write spaces until a column of width has been written
fun pad(w: *io.Writer, written: usize, width: usize) {
    var n: usize = written;
    for (n < width) {
        format.write_byte(w, ' ');
        n = n + 1;
    }
}

# the overview of the program: its commands and the exit codes
# ---
# out: the writer the overview goes to
# set: every command
pub fun overview(out: *io.Writer, set: command.CommandSet) {
    format.write_str(out, "usage: mirl <command> [options]\n\n");
    format.write_str(out, "commands:\n");
    var i: usize = 0;
    for (i < set.n) {
        val c: *command.Command = set.rows[i];
        format.write_str(out, "  ");
        format.write_str(out, c.name);
        pad(out, 2 + str_len(c.name), COLUMN);
        format.write_str(out, c.summary);
        format.write_str(out, "\n");
        i = i + 1;
    }
    format.write_str(out, "\nrun 'mirl <command> --help' for a command's options.\n\n");
    format.write_str(out, "exit codes:\n");
    i = 0;
    for (i < exit.NOTES_N) {
        format.write_str(out, "  ");
        format.write_i64(out, exit.NOTES[i].code);
        format.write_str(out, "  ");
        format.write_str(out, exit.NOTES[i].meaning);
        format.write_str(out, "\n");
        i = i + 1;
    }
}

# the page a command's --help shows: its usage, its summary and its options
# ---
# out: the writer the page goes to
# c:   the command
pub fun page(out: *io.Writer, c: *command.Command) {
    format.write_str(out, "usage: mirl ");
    format.write_str(out, c.usage);
    format.write_str(out, "\n\n");
    format.write_str(out, c.summary);
    format.write_str(out, "\n");
    if (c.flag_n == 0) { ret; }
    format.write_str(out, "\noptions:\n");
    var i: usize = 0;
    for (i < c.flag_n) {
        val row: *args.Flag = c.flags[i];
        format.write_str(out, "  ");
        var written: usize = 2 + str_len(row.name);
        format.write_str(out, row.name);
        if (row.kind == args.SWITCH) {
            if (row.negatable) {
                format.write_str(out, ", --no-");
                format.write_str(out, ?row.name[2]);
                written = written + 5 + str_len(row.name);
            }
        }
        or {
            format.write_str(out, " ");
            format.write_str(out, row.value);
            written = written + 1 + str_len(row.value);
        }
        pad(out, written, COLUMN);
        format.write_str(out, row.doc);
        format.write_str(out, "\n");
        i = i + 1;
    }
}
