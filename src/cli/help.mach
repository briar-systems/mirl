# the program's help: the overview of every command and the exit codes, and the
# page a command's --help shows, rendered by std.args.help from the command set

use std.types.error.err;

use std.args;
use args_help: std.args.help;
use io:        std.io.writer;

use mirl.cli.diagnostic;
use mirl.cli.exit;

# write a page of the program's help
# ---
# out:  the writer the page goes to
# diag: the writer of the failure to write it
# set:  every command
# p:    the page: a command's, or the overview when its command is nil
# ret:  the exit code of the failure, or OK
pub fun show(out: *io.Writer, diag: *io.Writer, set: *args.CommandSet, p: args_help.Page) i64 {
    val shown: err[args_help.HelpError] = args_help.render(set, out, p, args_help.terminal_width());
    if (sel shown.err) {
        if (sel shown.err.malformed) {
            diagnostic.malformed(diag, shown.err.malformed);
            ret exit.INTERNAL;
        }
        diagnostic.headline(diag, nil, "cannot write the help");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# the overview of the program: its commands and the exit codes
pub fun overview(out: *io.Writer, diag: *io.Writer, set: *args.CommandSet) i64 {
    ret show(out, diag, set, args_help.Page{command: nil, action: nil});
}
