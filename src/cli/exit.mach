# the exit codes the program returns, the same as every tool of the toolchain by convention,
# and what the overview says each one means

use std.types.size.usize;

use std.types.string.str;

# the command did what it was asked
pub val OK: i64 = 0;

# refused input: malformed text, a verifier refusal, a bad command line, or a
# file that is not there
pub val REFUSED: i64 = 1;

# internal failure: the allocator refused storage or a broken invariant
pub val INTERNAL: i64 = 2;

# environment failure: a file that is there was not read, or the output was
# not written
pub val ENVIRONMENT: i64 = 3;

# length of NOTES
pub val NOTES_N: usize = 4;

# one exit code and what it means, as the overview lists it
# ---
# code:    the code
# meaning: what it means
pub rec Note {
    code:    i64;
    meaning: str;
}

# the codes the program exits with, in ascending order, as the overview lists them
pub val NOTES: [NOTES_N]Note = [NOTES_N]Note{
    Note{code: OK, meaning: "success"},
    Note{code: REFUSED, meaning: "refused input: malformed text, a verifier refusal, a bad command line, or a missing file"},
    Note{code: INTERNAL, meaning: "internal failure: the allocator refused storage or a broken invariant"},
    Note{code: ENVIRONMENT, meaning: "environment failure: a file that is there was not read, or the output was not written"},
};
