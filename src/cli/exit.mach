# the exit codes the program returns, and what the help says each one means

use std.types.size.usize;

use std.args;

# the command did what it was asked
pub val OK: i64 = 0;

# refused input: malformed text, a verifier refusal, a bad command line, or a
# file that is not there
pub val REFUSED: i64 = 1;

# internal failure: the allocator refused storage or a broken invariant
pub val INTERNAL: i64 = 2;

# environment failure: a file that is there was not read, or the output was
# not written
pub val ENVIRONMENT: i64 = 3;

# length of NOTES
pub val NOTES_N: usize = 4;

# the codes the program exits with, in ascending order, as every command's help shows them
pub val NOTES: [NOTES_N]args.Exit = [NOTES_N]args.Exit{
    args.Exit{code: OK, meaning: "success"},
    args.Exit{code: REFUSED, meaning: "refused input: malformed text, a verifier refusal, a bad command line, or a missing file"},
    args.Exit{code: INTERNAL, meaning: "internal failure: the allocator refused storage or a broken invariant"},
    args.Exit{code: ENVIRONMENT, meaning: "environment failure: a file that is there was not read, or the output was not written"},
};
