# the exit codes the program returns, and what the help says each one means

# the command did what it was asked
pub val OK: i64 = 0;

# refused input: malformed text, a verifier refusal, a bad command line, or a
# file that is not there
pub val REFUSED: i64 = 1;

# internal failure: the allocator refused storage, an i/o failure, or a broken
# invariant
pub val INTERNAL: i64 = 2;

# one exit code as the help documents it
# ---
# code:    the process exit code
# meaning: what the code reports
pub rec Note {
    code:    i64;
    meaning: str;
}

# length of NOTES
pub val NOTES_N: usize = 3;

# the codes the program exits with, in ascending order
pub val NOTES: [NOTES_N]Note = [NOTES_N]Note{
    Note{code: OK, meaning: "success"},
    Note{code: REFUSED, meaning: "refused input: malformed text, a verifier refusal, a bad command line, or a missing file"},
    Note{code: INTERNAL, meaning: "internal failure: the allocator refused storage, an i/o failure, or a broken invariant"},
};

use std.types.size.usize;
use std.types.string.str;
