# the exit codes the program returns, the same as every tool of the toolchain by convention

# the command did what it was asked
pub val OK: i64 = 0;

# refused input: malformed text, a verifier refusal, a bad command line, a
# file that is not there, or a valid request mirl does not do yet
pub val REFUSED: i64 = 1;

# internal failure: a broken invariant
pub val INTERNAL: i64 = 2;

# environment failure: the allocator refused storage, a file that is there was
# not read, or the output was not written
pub val ENVIRONMENT: i64 = 3;
