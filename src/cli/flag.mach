# the flags a command's handler asks of its line, read through std.args
#
# a flag a handler asks of is a row of the command's own table, read the way its
# occurrence policy allows. a read std refuses is a broken command table, so it is
# reported as an internal failure and never answered with a guess.

use std.types.bool.bool;
use std.types.result.res;
use std.types.string.str;

use std.args;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;

# report a read std refused, and the exit code of the internal failure
fun misread(call: *command.Call, m: args.Misread) i64 {
    if (sel m.unlisted) {
        diagnostic.named(call.diag, "the command's table does not list the flag", m.unlisted.name);
    }
    or (sel m.repeating) {
        diagnostic.named(call.diag, "the flag collects its values and has no single one", m.repeating.name);
    }
    ret exit.INTERNAL;
}

# whether a switch of the command's table is set, by its last occurrence
# ---
# call: the command's context
# flag: a switch row of the command's table
# ret:  whether it is set, or the exit code of the misread
pub fun on(call: *command.Call, flag: *args.Flag) res[bool, i64] {
    val got: res[bool, args.Misread] = args.on(call.reader, flag);
    if (sel got.err) { ret res[bool, i64].err{misread(call, got.err)}; }
    ret res[bool, i64].ok{got.ok};
}

# the value a flag of the command's table was given, by its last occurrence
# ---
# call: the command's context
# flag: a value row of the command's table
# ret:  the value, nil when the flag was not given, or the exit code of the misread
pub fun value(call: *command.Call, flag: *args.Flag) res[str, i64] {
    val got: res[str, args.Misread] = args.value(call.reader, flag);
    if (sel got.err) { ret res[str, i64].err{misread(call, got.err)}; }
    ret res[str, i64].ok{got.ok};
}

# a walk over every occurrence of a flag of the command's table, in the line's order
# ---
# call: the command's context
# flag: a row of the command's table
# ret:  the walk, taken with args.next_value, or the exit code of the misread
pub fun values(call: *command.Call, flag: *args.Flag) res[args.Values, i64] {
    val got: res[args.Values, args.Misread] = args.values(call.reader, flag);
    if (sel got.err) { ret res[args.Values, i64].err{misread(call, got.err)}; }
    ret res[args.Values, i64].ok{got.ok};
}
