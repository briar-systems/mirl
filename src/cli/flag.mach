# the values every occurrence of a repeating flag gives, read through std.args

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.args;
use std.collections.slice.Slice;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;

# the values every occurrence of a flag gives, in the command line's order
# ---
# call: the command's context
# f:    a flag the command reads
# ret:  the values, or the exit code of the failure to hold them
pub fun collected(call: *command.Call, f: *args.Flag) res[Slice[str], i64] {
    var w: args.Values = args.values(call.p, f);
    var n: usize       = 0;
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        n = n + 1;
    }
    if (n == 0) { ret res[Slice[str], i64].ok{Slice[str]{data: nil, size: 0}}; }
    val made: res[*str, A.Error] = A.allocate[str](call.a, n);
    if (sel made.err) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret res[Slice[str], i64].err{exit.ENVIRONMENT};
    }
    var got: Slice[str] = Slice[str]{data: made.ok, size: 0};
    w = args.values(call.p, f);
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        got.data[got.size] = hit.some.value;
        got.size           = got.size + 1;
    }
    ret res[Slice[str], i64].ok{got};
}
