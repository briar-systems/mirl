# `mirl reference`: write the opcode reference to stdout

use std.types.bool.false;
use std.types.error.err;

use mirl.cli.args;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.ir.reference;
use io: std.io.writer;

# the command row
pub val COMMAND: args.Command = args.Command{name: "reference", summary: "write the opcode reference to stdout", usage: "reference", file: false, options: nil, option_n: 0, run: handle};

fun handle(call: *args.Call) i64 {
    val written: err[io.WriteError] = reference.write(call.out);
    if (sel written.err) {
        diagnostic.headline(call.diag, nil, "cannot write the reference");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}
