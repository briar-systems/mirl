# `mirl emit <file> --kind <kind>`: compile the text for a target through
# mirl.compile and write one of what the compilation makes
#
# a kind is a row of KINDS, naming what it writes: the machine form text of
# the laid out functions, masc's listing of the object, or the object in the
# format of the target's system, through mink. the command reads the line and
# reports, and the compilation is the library's.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use masc.build.build;
use mirl.ir.text.parse;
use mirl.ir.text.sink;
use mirl.machine.emit.handover;
use mirl.target;
use A: std.allocator;
use T: std.allocator.testing;
use std.collections.slice.Slice;
use std.collections.vector;
use fs: std.filesystem;
use io: std.io.writer;

use mink.model.object;

use opt_cmd: mirl.cli.cmd.opt;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.source;
use mirl.compile;
use mirl.ir.module;
use mcompile: mirl.machine.compile;
use mirl.pass;
use mirl.target.Target;
use std.args;

# one kind of output
# ---
# name:    the --kind value that names it
# machine: it is the machine form text
# listing: it is masc's listing
# object:  it is the object's bytes
pub rec Kind {
    name:    str;
    machine: bool;
    listing: bool;
    object:  bool;
}

# every kind, in the order help lists them
pub val KINDS: [3]Kind = [3]Kind{
    Kind{name: "machine", machine: true, listing: false, object: false},
    Kind{name: "listing", machine: false, listing: true, object: false},
    Kind{name: "object", machine: false, listing: false, object: true},
};

# the flag that names the kind written
pub val KIND: args.Flag = args.Flag{name: "--kind", short: nil, kind: args.VALUE, negatable: false, repeat: true, value: "machine|listing|object", doc: "what is written: the machine form text, masc's listing, or the object in the format of the target's system"};

# the switch that verifies after every pass and stage
pub val CHECKED: args.Flag = args.Flag{name: "--checked", short: nil, kind: args.SWITCH, negatable: true, repeat: true, value: "", doc: "verify the module after every pass and every function after every stage"};

# the flag rows the command takes
pub val FLAGS: [5]*args.Flag = [5]*args.Flag{?KIND, ?opt_cmd.TARGET, ?opt_cmd.LEVEL, ?CHECKED, ?source.BODY};

# the command row
pub val COMMAND: command.Command = command.Command{name: "emit", summary: "compile a file for a register machine and write its machine text, listing or object", usage: "emit <file> --kind <kind> [options]", file: true, flags: ?FLAGS[0], flag_n: 5, run: handle};

# the kind a --kind value names, nil for none
pub fun kind_of(s: str) *Kind {
    if (s == nil) { ret nil; }
    var i: usize = 0;
    for (i < $length_of(KINDS)) {
        if (str_equals(KINDS[i].name, s)) { ret ?KINDS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun handle(call: *command.Call) i64 {
    val k: *Kind = kind_of(args.value(call.reader, ?KIND));
    if (k == nil) {
        diagnostic.named(call.diag, "not a kind of output, machine, listing or object", args.value(call.reader, ?KIND));
        ret exit.REFUSED;
    }
    val level: opt[pass.Level] = opt_cmd.asked_level(call);
    if (sel level.none) { ret exit.REFUSED; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = opt_cmd.asked_target(call, ?m);
    if (sel t.none) { ret exit.REFUSED; }

    var none:    opt[*io.Writer] = opt[*io.Writer].none{};
    var machine: opt[*io.Writer] = none;
    var listing: opt[*io.Writer] = none;
    if (k.machine) { machine = opt[*io.Writer].some{call.out}; }
    if (k.listing) { listing = opt[*io.Writer].some{call.out}; }
    val options: compile.Options = compile.Options{
        level:   level.some,
        checked: args.on(call.reader, ?CHECKED),
        added:   Slice[str]{data: nil, size: 0},
        machine: machine,
        listing: listing,
    };
    val made: res[object.Object, compile.Error] = compile.compile(call.a, ?m, t.some, options);
    if (sel made.err) { ret failed(call, ?m, made.err); }
    var o: object.Object = made.ok;
    fin { object.release(?o); }
    if (!k.object) { ret exit.OK; }
    val wrote: err[compile.Unwritten] = compile.write(call.a, ?o, t.some, call.out);
    if (sel wrote.err) { ret unwritten(call, wrote.err); }
    ret exit.OK;
}

# report a failed compilation: a target no back end serves and a module a pass
# or a stage refuses are refused input, and anything else is internal
fun failed(call: *command.Call, m: *module.Module, e: compile.Error) i64 {
    if (sel e.unserved) {
        diagnostic.headline(call.diag, nil, "no back end serves the target's declarations");
        ret exit.REFUSED;
    }
    if (sel e.schedule) { ret opt_cmd.failed(call, e.schedule); }
    if (sel e.compile)  { ret refused(call, m, e.compile); }
    diagnostic.headline(call.diag, nil, "the machine of the target was not made");
    ret exit.INTERNAL;
}

# report a module the back end refused: a function a stage refuses, a target
# mirl carries no machine for and code emission refuses are refused input, and
# a function a stage leaves invalid and anything else is internal
fun refused(call: *command.Call, m: *module.Module, c: mcompile.Error) i64 {
    if (sel c.function) {
        val f: View = m.functions.data[c.function.function.index].data.name;
        if (sel c.function.stage.verify) {
            diagnostic.headline(call.diag, nil, "a stage left a function invalid");
            diagnostic.symbol(call.diag, f);
            ret exit.INTERNAL;
        }
        diagnostic.headline(call.diag, nil, "a stage refused a function");
        diagnostic.symbol(call.diag, f);
        ret exit.REFUSED;
    }
    if (sel c.uncarried) {
        diagnostic.headline(call.diag, nil, "mirl carries no machine for the target");
        ret exit.REFUSED;
    }
    if (sel c.emit) {
        if (sel c.emit.refused || sel c.emit.global) {
            diagnostic.headline(call.diag, nil, "emission refused the module");
            ret exit.REFUSED;
        }
        if (sel c.emit.builder) {
            diagnostic.named(call.diag, "masc refused the module", c.emit.builder.message);
            ret exit.INTERNAL;
        }
    }
    diagnostic.headline(call.diag, nil, "the module was not compiled");
    ret exit.INTERNAL;
}

# report an object that was not written: a system that states no one format is
# refused input, and anything else is internal
fun unwritten(call: *command.Call, e: compile.Unwritten) i64 {
    if (sel e.formats) {
        diagnostic.headline(call.diag, nil, "the target's system states no one object format");
        ret exit.REFUSED;
    }
    diagnostic.headline(call.diag, nil, "the object was not written");
    ret exit.INTERNAL;
}

# the directory of the example programs, each a body for a register machine
#[testing]
val EXAMPLES: str = "test/example/";

# emit one file at one kind, the exit code and how many bytes were written
#[testing]
fun emitted(a: *A.Allocator, path: str, k: *Kind, written: *usize) i64 {
    var out_bytes:  sink.Sink = sink.init(a);
    var diag_bytes: sink.Sink = sink.init(a);
    fin {
        sink.dnit(?out_bytes);
        sink.dnit(?diag_bytes);
    }
    var out:  io.Writer                           = sink.writer(?out_bytes);
    var diag: io.Writer                           = sink.writer(?diag_bytes);
    var argv: [7]*u8                              = [7]*u8{"mirl", "emit", path, "--body", "--checked", "--kind", k.name};
    val read: res[command.Reading, command.Error] = command.read(a, ?COMMAND, args.of(7, ?argv[0]));
    if (sel read.err) { ret -1; }
    var call: command.Call = command.Call{a: a, operand: read.ok.operand, reader: read.ok.reader, out: ?out, diag: ?diag, commands: command.CommandSet{rows: nil, n: 0}};
    val code: i64          = handle(?call);
    @written = sink.view(?out_bytes).len;
    ret code;
}

# the examples masc refuses for now: a function aligned after a call pair the
# linker may shrink, whose padding masc realigns and so takes no fill byte
#[testing]
val REALIGNED: [3]str = [3]str{"arithmetic.mirl", "call.mirl", "recursive.mirl"};

#[testing]
fun realigned(name: str) bool {
    var i: usize = 0;
    for (i < $length_of(REALIGNED)) {
        if (str_equals(REALIGNED[i], name)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether compiling a file is refused by masc for the fill of an alignment it realigns
#[testing]
fun refused_realigned(a: *A.Allocator, path: str) bool {
    val file: res[str, fs.FsError] = fs.read_string(a, path);
    if (sel file.err) { ret false; }
    val read: res[module.Module, parse.Refusal] = parse.parse_body(a, View{data: file.ok, len: str_len(file.ok)});
    if (sel read.err) { ret false; }
    var m: module.Module = read.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = target.by_name(module.target(?m));
    if (sel t.none) { ret false; }
    val options: compile.Options                   = compile.Options{level: 0, checked: true, added: Slice[str]{data: nil, size: 0}, machine: opt[*io.Writer].none{}, listing: opt[*io.Writer].none{}};
    val made:    res[object.Object, compile.Error] = compile.compile(a, ?m, t.some, options);
    if (sel made.ok) {
        var o: object.Object = made.ok;
        object.release(?o);
        ret false;
    }
    val e: compile.Error = made.err;
    if (!(sel e.compile)) { ret false; }
    val c: mcompile.Error = e.compile;
    if (!(sel c.emit)) { ret false; }
    val h: handover.Error = c.emit;
    if (!(sel h.builder)) { ret false; }
    ret str_equals(h.builder.message, build.REALIGN_FORM);
}

# every example program emits every kind, checked after every pass and stage,
# but the ones masc refuses for now, which are refused for that reason
test emit__every_example_writes_every_kind {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:     *A.Allocator                        = T.allocator_of(?t);
    val names: res[vector.Vector[str], fs.FsError] = fs.read_dir(a, EXAMPLES);
    if (sel names.err) { ret 2; }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirl")) {
            var buf:  [256]u8;
            val path: str   = parse.path_in(?buf[0], EXAMPLES, name);
            var k:    usize = 0;
            if (realigned(name)) {
                if (!refused_realigned(a, path)) { ret 6; }
                k = $length_of(KINDS);
            }
            for (k < $length_of(KINDS)) {
                var written: usize = 0;
                if (emitted(a, path, ?KINDS[k], ?written) != exit.OK) { ret 3; }
                if (written == 0)                                     { ret 4; }
                k = k + 1;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 5; }
    ret 0;
}
