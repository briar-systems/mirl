# `mirl emit <file> -e <kind>`: compile the text for a target through
# mirl.target.compile and write what the compilation makes, of each kind -e names
#
# a kind is a row of KINDS, naming what it writes: the machine form text of
# the laid out functions, masc's listing of the object, or the object in the
# format of the target's system, through mink. the command reads the line and
# reports, and the compilation is the library's.

use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.model.object;

use opt_cmd: mirl.cli.cmd.opt;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mct: mirl.ct;
use mirl.ir.block.BlockData;
use mirl.ir.function;
use mirl.ir.id;
use mirl.ir.instruction;
use mirl.ir.module;
use ir_op: mirl.ir.opcode;
use irow:  mirl.ir.opcode.row;
use mirl.ir.text.printer;
use mirl.ir.type.Type;
use mcompile: mirl.machine.compile;
use mirl.machine.emit.handover;
use mirl.machine.frame.code;
use mirl.machine.frame.finish;
use lrow: mirl.machine.loop.row;
use mirl.machine.select.engine;
use mirl.machine.timing;
use mirl.pass;
use mirl.pass.relaxation;
use mirl.target;
use mirl.target.Target;
use target_basis: mirl.target.basis;
use mirl.target.compile;
use spirv_error: mirl.target.spirv.error;
use wasm_error:  mirl.target.wasm.error;
use std.args;

use masc_ct: masc.core.ct;

# one kind of output
# ---
# name:    the -e value that names it
# machine: it is the machine form text
# listing: it is masc's listing
# object:  it is the object's bytes
pub rec Kind {
    name:    str;
    machine: bool;
    listing: bool;
    object:  bool;
}

# every kind, in the order help lists them
pub val KINDS: [3]Kind = [3]Kind{
    Kind{name: "machine", machine: true, listing: false, object: false},
    Kind{name: "listing", machine: false, listing: true, object: false},
    Kind{name: "object", machine: false, listing: false, object: true},
};

# the flag that names one kind of output to write, given once for each
pub val EMIT: args.FlagSpec = args.FlagSpec{name: "--emit", value: "kind", arity: args.ARITY_VALUE, doc: "a kind of output to write, given once for each: machine for the machine form text, listing for masc's listing, object for the object in the format of the target's system", default: "", negatable: false, occurs: args.Occurs.collect{}, alias_of: nil};

# the short spelling of --emit
pub val EMIT_SHORT: args.FlagSpec = args.FlagSpec{name: "-e", value: "kind", arity: args.ARITY_VALUE, doc: "a kind of output to write, as --emit", default: "", negatable: false, occurs: args.Occurs.collect{}, alias_of: ?EMIT};

# the switch that verifies after every pass and stage
pub val CHECKED: args.FlagSpec = args.FlagSpec{name: "--checked", value: "", arity: args.ARITY_FLAG, doc: "verify the module after every pass and every function after every stage", default: "", negatable: true, occurs: args.Occurs.once{}, alias_of: nil};

# the switch that lets the linker relax the code, on unless negated
pub val RELAX: args.FlagSpec = args.FlagSpec{name: "--relax", value: "", arity: args.ARITY_FLAG, doc: "let the linker relax the code, marking each relocation it may resize, the default, and --no-relax to mark none", default: "", negatable: true, occurs: args.Occurs.once{}, alias_of: nil};

# the switch that asks for the final image the target loads as it is, not a relocatable object
pub val IMAGE: args.FlagSpec = args.FlagSpec{name: "--image", value: "", arity: args.ARITY_FLAG, doc: "compile to the final image the target loads as it is, as a whole wasm module, not a relocatable object a link takes", default: "", negatable: true, occurs: args.Occurs.once{}, alias_of: nil};

# the flag that asks for each symbol of one kind in a section of its own, given once for each
pub val APART: args.FlagSpec = args.FlagSpec{name: "--apart", value: "kind", arity: args.ARITY_VALUE, doc: "place each symbol of a kind that states no section in a section of its own, for the linker's garbage collection, given once for each: functions or data", default: "", negatable: false, occurs: args.Occurs.collect{}, alias_of: nil};

# the rows that name what is written
pub val EMITS: [2]*args.FlagSpec = [2]*args.FlagSpec{?EMIT, ?EMIT_SHORT};

# the flag rows of the command's own table
pub val ROWS: [4]*args.FlagSpec = [4]*args.FlagSpec{?CHECKED, ?RELAX, ?IMAGE, ?APART};

# the option tables the command takes, in the order help lists them
val TABLES: [4]args.TableRef = [4]args.TableRef{args.TableRef{rows: ?EMITS[0], n: $length_of(EMITS), accepted: nil, docs: nil}, args.TableRef{rows: ?opt_cmd.ROWS[0], n: $length_of(opt_cmd.ROWS), accepted: nil, docs: nil}, args.TableRef{rows: ?ROWS[0], n: $length_of(ROWS), accepted: nil, docs: nil}, args.TableRef{rows: ?source.ROWS[0], n: $length_of(source.ROWS), accepted: nil, docs: nil}};

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{name: "emit", id: 4, aliases: nil, alias_n: 0, grammar: " <file> -e <kind> [options]", summary: "compile a file for a register machine and write its machine text, listing or object", effect: "compile the file for a target and write what -e names of what the compilation makes: the machine form text, masc's listing, or the object", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: $length_of(TABLES), refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

# the kind an -e value names, nil for none
pub fun kind_of(s: str) *Kind {
    if (s == nil) { ret nil; }
    var i: usize = 0;
    for (i < $length_of(KINDS)) {
        if (str_equals(KINDS[i].name, s)) { ret ?KINDS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun handle(call: *command.Call) i64 {
    val asked: res[Slice[str], i64] = opt_cmd.collected(call, ?EMIT);
    if (sel asked.err) { ret asked.err; }
    if (asked.ok.size == 0) {
        diagnostic.headline(call.diag, nil, "no kind of output asked for, -e machine, listing or object");
        ret exit.REFUSED;
    }
    var k: Kind  = Kind{name: nil, machine: false, listing: false, object: false};
    var i: usize = 0;
    for (i < asked.ok.size) {
        val named: *Kind = kind_of(asked.ok.data[i]);
        if (named == nil) {
            diagnostic.named(call.diag, "not a kind of output, machine, listing or object", asked.ok.data[i]);
            ret exit.REFUSED;
        }
        k.machine = k.machine || named.machine;
        k.listing = k.listing || named.listing;
        k.object  = k.object || named.object;
        i         = i + 1;
    }
    val checked: res[bool, i64] = flag.on(call, ?CHECKED);
    if (sel checked.err) { ret checked.err; }
    var relax: bool = compile.RELAX;
    if (args.given(?call.inv, ?RELAX)) {
        val asked_relax: res[bool, i64] = flag.on(call, ?RELAX);
        if (sel asked_relax.err) { ret asked_relax.err; }
        relax = asked_relax.ok;
    }
    val image: res[bool, i64] = flag.on(call, ?IMAGE);
    if (sel image.err) { ret image.err; }
    val apart: res[compile.Apart, i64] = asked_apart(call);
    if (sel apart.err) { ret apart.err; }
    var output: compile.Output = compile.Output.object{};
    if (image.ok) { output = compile.Output.image{}; }
    val level: res[pass.Level, i64] = opt_cmd.asked_level(call);
    if (sel level.err) { ret level.err; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val t: res[Target, i64] = opt_cmd.asked_target(call, ?m);
    if (sel t.err) { ret t.err; }
    var own: Target = t.ok;
    fin { target.release(call.a, ?own); }
    val added: res[Slice[str], i64] = opt_cmd.asked_extensions(call);
    if (sel added.err) { ret added.err; }
    val floats: res[relaxation.Relaxations, i64] = opt_cmd.asked_floats(call);
    if (sel floats.err) { ret floats.err; }

    var none:    opt[*io.Writer] = opt[*io.Writer].none{};
    var machine: opt[*io.Writer] = none;
    var listing: opt[*io.Writer] = none;
    if (k.machine) { machine = opt[*io.Writer].some{call.out}; }
    if (k.listing) { listing = opt[*io.Writer].some{call.out}; }
    val options: compile.Options = compile.Options{
        output:   output,
        level:    level.ok,
        checked:  checked.ok,
        added:    added.ok,
        machine:  machine,
        listing:  listing,
        warnings: opt[*io.Writer].some{call.diag},
        relax:    relax,
        floats:   floats.ok,
        apart:    apart.ok,
    };
    val made: res[object.Object, compile.Error] = compile.compile(call.a, ?m, ?own, options);
    if (sel made.err) { ret failed(call, ?m, ?own, added.ok, made.err); }
    var o: object.Object = made.ok;
    fin { object.release(?o); }
    if (!k.object) { ret exit.OK; }
    val wrote: err[compile.Unwritten] = compile.write(call.a, ?o, ?own, call.out);
    if (sel wrote.err) { ret unwritten(call, wrote.err); }
    ret exit.OK;
}

# the symbols --apart asks to place each in a section of its own, none when it is not given
fun asked_apart(call: *command.Call) res[compile.Apart, i64] {
    val asked: res[Slice[str], i64] = opt_cmd.collected(call, ?APART);
    if (sel asked.err) { ret res[compile.Apart, i64].err{asked.err}; }
    var apart: compile.Apart = compile.SHARED;
    var i:     usize         = 0;
    for (i < asked.ok.size) {
        val kind: str = asked.ok.data[i];
        if (str_equals(kind, "functions")) { apart.code = true; }
        or (str_equals(kind, "data"))      { apart.data = true; }
        or {
            diagnostic.named(call.diag, "not a kind of symbol to place apart, functions or data", kind);
            ret res[compile.Apart, i64].err{exit.REFUSED};
        }
        i = i + 1;
    }
    ret res[compile.Apart, i64].ok{apart};
}

# report a failed compilation: a target no family serves, a build opt
# refuses to open, a module a pass or a stage refuses and a module holding an
# opcode its target's family does not serve are refused input, and anything
# else is internal
fun failed(call: *command.Call, m: *module.Module, t: *Target, added: Slice[str], e: compile.Error) i64 {
    if (sel e.unserved) {
        val why: compile.Unserved = e.unserved;
        if (sel why.none) {
            diagnostic.headline(call.diag, nil, "no family serves the target's declarations");
            ret exit.REFUSED;
        }
        diagnostic.headline(call.diag, nil, "more than one family admits the target's declarations");
        ret exit.INTERNAL;
    }
    or (sel e.schedule) { ret opt_cmd.failed(call, m, e.schedule); }
    or (sel e.back) {
        val back: compile.Back = e.back;
        if (sel back.register) { ret refused(call, m, back.register); }
        if (sel back.wasm)     { ret refused_wasm(call, m, back.wasm); }
        if (sel back.spirv)    { ret refused_spirv(call, m, back.spirv); }
    }
    or (sel e.timing) { ret timed(call, m, e.timing); }
    or (sel e.alloc) {
        diagnostic.headline(call.diag, nil, "the allocator refused storage");
        ret exit.INTERNAL;
    }
    or (sel e.output) {
        diagnostic.headline(call.diag, nil, "the target's family writes relocatable objects alone, which a link makes an image of");
        ret exit.REFUSED;
    }
    or (sel e.open)       { ret opt_cmd.unopened(call, t, added, e.open); }
    or (sel e.listing)    { ret opt_cmd.unlisted(call, e.listing); }
    or (sel e.foreign)    { ret opt_cmd.foreign(call, "the module holds an opcode the target's family does not serve", e.foreign, exit.REFUSED); }
    or (sel e.introduced) { ret opt_cmd.foreign(call, "the schedule left an opcode the target's family does not serve", e.introduced, exit.INTERNAL); }
}

# report a module the back end refused: a function a stage refuses, a target
# mirl carries no machine for, code emission refuses and a relocation the
# object's format does not map are refused input, and a function a stage
# leaves invalid and anything else is internal
fun refused(call: *command.Call, m: *module.Module, c: mcompile.Error) i64 {
    if (sel c.function) {
        val f: View = m.functions.data[c.function.function.index].data.name;
        if (sel c.function.stage.timing) {
            val found: timing.Found = c.function.stage.timing;
            ret timed(call, m, mct.refused(c.function.function, mct.Where.instruction{found.instruction}, found.refusal, c.function.location));
        }
        if (sel c.function.stage.verify) {
            diagnostic.headline(call.diag, nil, "a stage left a function invalid");
            diagnostic.source(call.diag, m, c.function.location);
            diagnostic.symbol(call.diag, f);
            ret exit.INTERNAL;
        }
        diagnostic.headline(call.diag, nil, "a stage refused a function");
        diagnostic.source(call.diag, m, c.function.location);
        diagnostic.symbol(call.diag, f);
        staged(call, m, c.function);
        ret exit.REFUSED;
    }
    if (sel c.widening) { ret widened(call, m, c.widening); }
    if (sel c.timing) {
        val unmet: mct.Unmet = c.timing;
        if (sel unmet.refused)    { ret timed(call, m, unmet.refused); }
        if (sel unmet.unfollowed) { ret unfollowed(call, m, unmet.unfollowed); }
        if (sel unmet.stale)      { ret stale(call, m, unmet.stale); }
    }
    if (sel c.uncarried) {
        diagnostic.headline(call.diag, nil, "mirl carries no selection table for the target's instruction set");
        ret exit.REFUSED;
    }
    if (sel c.emit) {
        if (sel c.emit.refused)  { ret handed(call, m, c.emit.refused); }
        if (sel c.emit.global)   { ret misplaced(call, m, c.emit.global); }
        if (sel c.emit.section)  { ret unsectioned(call, m, c.emit.section); }
        if (sel c.emit.unmapped) { ret unmapped(call, m, c.emit.unmapped); }
        if (sel c.emit.export)   { ret unexported(call, m, c.emit.export); }
        if (sel c.emit.builder) {
            diagnostic.named(call.diag, "masc refused the module", c.emit.builder.message);
            ret exit.INTERNAL;
        }
        if (sel c.emit.listing) {
            diagnostic.named(call.diag, "masc refused to list the object it made", c.emit.listing.message);
            diagnostic.placed(call.diag, c.emit.listing.section, c.emit.listing.offset);
            ret exit.INTERNAL;
        }
    }
    if (sel c.table) {
        if (sel c.table.table) {
            diagnostic.lead(call.diag, nil);
            format.write_str(call.diag, "the module was not compiled, as the target's selection table breaks its schema at ");
            if (c.table.table.constant) { format.write_str(call.diag, "materialisation "); }
            format.write_str(call.diag, "rule ");
            format.write_u64(call.diag, c.table.table.rule::u64);
            format.write_str(call.diag, ", a ");
            format.write_str(call.diag, c.table.table.what);
            format.write_str(call.diag, "\n");
            ret exit.INTERNAL;
        }
        if (sel c.table.breached) {
            val b: engine.Breached = c.table.breached;
            diagnostic.lead(call.diag, nil);
            format.write_str(call.diag, "the module was not compiled, as the loop '");
            format.write_str(call.diag, b.loop.name);
            format.write_str(call.diag, "' of the target's selection table breaks its constraint, as ");
            format.write_str(call.diag, breach(b.breach));
            format.write_str(call.diag, "\n");
            ret exit.INTERNAL;
        }
        diagnostic.lead(call.diag, nil);
        format.write_str(call.diag, "the module was not compiled, as selection refused the target's table: ");
        format.write_str(call.diag, unselected(c.table));
        format.write_str(call.diag, "\n");
        ret exit.INTERNAL;
    }
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the module was not compiled, as ");
    format.write_str(call.diag, uncompiled(c));
    format.write_str(call.diag, "\n");
    ret exit.INTERNAL;
}

# report the extensions a function admits past the build's that were not
# opened: a name the target's instruction set does not know and names whose
# closure conflicts are refused input, and anything else is internal
fun widened(call: *command.Call, m: *module.Module, w: mcompile.Widening) i64 {
    val f: View               = m.functions.data[w.function.index].data.name;
    val e: target_basis.Error = w.error;
    diagnostic.lead(call.diag, nil);
    if (sel e.named) {
        format.write_str(call.diag, "the instruction set of the target knows no extension named '");
        diagnostic.view(call.diag, e.named);
        format.write_str(call.diag, "', which a function admits\n");
        diagnostic.symbol(call.diag, f);
        ret exit.REFUSED;
    }
    format.write_str(call.diag, "the extensions a function admits past the build's were not opened, as ");
    format.write_str(call.diag, target_basis.fact(e));
    format.write_str(call.diag, "\n");
    diagnostic.symbol(call.diag, f);
    if (sel e.extensions) { ret exit.REFUSED; }
    ret exit.INTERNAL;
}

# report an instruction emission cannot hand over: why, the function, where
# the instruction was built for, and the instruction and operand. it is
# refused input
fun handed(call: *command.Call, m: *module.Module, r: handover.Refused) i64 {
    diagnostic.headline(call.diag, nil, "emission cannot hand an instruction over");
    diagnostic.source(call.diag, m, r.location);
    function_name(call, m, r.function);
    diagnostic.tagged(call.diag, "why", reason(r.reason));
    format.write_str(call.diag, "  = at: instruction ");
    format.write_u64(call.diag, r.at.index::u64);
    format.write_str(call.diag, " of the code");
    if (r.operand != handover.NO_OPERAND) {
        format.write_str(call.diag, ", operand ");
        format.write_u64(call.diag, r.operand::u64);
    }
    format.write_str(call.diag, "\n");
    ret exit.REFUSED;
}

# why emission cannot hand an instruction over
fun reason(r: handover.Reason) str {
    if (sel r.pseudo)    { ret "a pseudo-instruction or loop no stage expanded, which encodes to nothing"; }
    if (sel r.unplaced)  { ret "a virtual register or a frame slot, which allocation and the frame replace"; }
    if (sel r.cell)      { ret "a location of a memory-backed class, which no register machine holds in an object"; }
    if (sel r.shape)     { ret "an operand of a kind its position does not take, or a list longer than an instruction keeps room for"; }
    if (sel r.unbound)   { ret "a relocation kind the instruction set binds no fixup kind to"; }
    if (sel r.ambiguous) { ret "a relocation kind the instruction set binds several fixup kinds to, none the operand's own"; }
    if (sel r.label)     { ret "a label two instructions hold, or inside a sequence, or a partner naming a label no instruction holds"; }
    if (sel r.span)      { ret "a relocation covering more instructions than the block has after it"; }
    if (sel r.fact)      { ret "a call frame fact at an instruction layout left in no block"; }
    ret "a jump table on a target that states no address model or no pointer";
}

# report a global emission cannot place: the global and its fault. it is
# refused input
fun misplaced(call: *command.Call, m: *module.Module, g: handover.Misplaced) i64 {
    diagnostic.headline(call.diag, nil, "emission cannot place a global");
    if (g.global.index::usize < m.globals.len) { diagnostic.symbol(call.diag, m.globals.data[g.global.index].data.name); }
    diagnostic.tagged(call.diag, "why", fault(g.fault));
    ret exit.REFUSED;
}

# report a function whose section a global or another function names with another kind. it is refused input
fun unsectioned(call: *command.Call, m: *module.Module, f: id.Function) i64 {
    diagnostic.headline(call.diag, nil, "emission cannot place a function");
    if (f.index::usize < m.functions.len) { diagnostic.symbol(call.diag, m.functions.data[f.index].data.name); }
    diagnostic.tagged(call.diag, "why", "it names a section a global or another function names with another kind");
    ret exit.REFUSED;
}

# why emission cannot place a global
fun fault(f: handover.Fault) str {
    if (sel f.contents) { ret "the module refused a read of its initial value"; }
    if (sel f.model)    { ret "its initial value holds an address and the target states no address model"; }
    if (sel f.section)  { ret "it names a section a function or another global names with another kind"; }
    if (sel f.layout)   { ret "the data layout gives its type or a part of its initial value no extent"; }
    ret "an address in its initial value is wider than any datum masc relocates";
}

# the step a function was refused at and what refused it, under its headline
fun staged(call: *command.Call, m: *module.Module, f: mcompile.Failed) {
    format.write_str(call.diag, "  = ");
    if (sel f.step.some) {
        format.write_str(call.diag, "at the step '");
        format.write_str(call.diag, f.step.some);
        format.write_str(call.diag, "', ");
    }
    format.write_str(call.diag, stage(f.stage));
    val s: mcompile.Stage = f.stage;
    if (sel s.select) {
        if (sel s.select.machine) {
            if (sel s.select.machine.refused) {
                format.write_str(call.diag, ", a ");
                format.write_str(call.diag, s.select.machine.refused.what);
            }
        }
    }
    format.write_str(call.diag, "\n");
    if (sel s.select) {
        if (sel s.select.unmatched) { unmatched(call, m, f.function, s.select.unmatched); }
    }
}

# the operation no rule matched, `= operation: ...`, its opcode and the types
# of its operands and results, and where it stands in its function,
# `= at: ...`
fun unmatched(call: *command.Call, m: *module.Module, f: id.Function, u: engine.Unmatched) {
    var p: printer.Printer = printer.init(call.diag, m);
    fin { printer.dnit(?p); }
    var held: engine.Unmatched = u;
    format.write_str(call.diag, "  = operation: ");
    if (sel u.operation.opcode) {
        val row: opt[irow.Row] = ir_op.row(u.operation.opcode);
        if (sel row.some) { format.write_str(call.diag, row.some.name); }
        or                { format.write_str(call.diag, "an opcode with no row"); }
        format.write_str(call.diag, " ");
        typed(?p, Slice[Type]{data: ?held.operands[0], size: $length_of(ir_op.Operands)}, u.operand_count);
        format.write_str(call.diag, " -> ");
        typed(?p, Slice[Type]{data: ?held.results[0], size: $length_of(ir_op.Results)}, u.result_count);
    }
    or {
        format.write_str(call.diag, "a constant of ");
        printer.ty(?p, u.operands[0]);
        format.write_str(call.diag, " to materialise");
    }
    format.write_str(call.diag, "\n  = at: ");
    placed(call, m, f, u.instruction);
    format.write_str(call.diag, "\n");
}

# a parenthesised list of count types, of which selection kept the first
# kept.size, `...` standing for the rest
fun typed(p: *printer.Printer, kept: Slice[Type], count: u32) {
    format.write_str(p.w, "(");
    var k: usize = 0;
    for (k < count::usize && k < kept.size) {
        if (k > 0) { format.write_str(p.w, ", "); }
        printer.ty(p, kept.data[k]);
        k = k + 1;
    }
    if (count::usize > kept.size) { format.write_str(p.w, ", ..."); }
    format.write_str(p.w, ")");
}

# where an instruction stands in its function: its place in its block and
# the block's name or index when it is placed, then its index in the body
fun placed(call: *command.Call, m: *module.Module, f: id.Function, i: id.Instruction) {
    val got: res[*function.Body, module.Error] = module.body(m, f);
    if (sel got.ok) {
        val b: *function.Body = got.ok;
        if (i.index::usize < b.instructions.len) {
            val place: instruction.Place = b.instructions.data[i.index].place;
            if (sel place.placed) {
                val k:    id.Block   = place.placed;
                val held: *BlockData = ?b.blocks.data[k.index];
                var at:   usize      = 0;
                for (at < held.instructions.len && held.instructions.data[at].index != i.index) { at = at + 1; }
                format.write_str(call.diag, "instruction ");
                format.write_u64(call.diag, at::u64);
                format.write_str(call.diag, " of block ");
                val name: opt[View] = held.name;
                if (sel name.some) {
                    format.write_str(call.diag, "^");
                    diagnostic.view(call.diag, name.some);
                }
                or { format.write_u64(call.diag, k.index::u64); }
                format.write_str(call.diag, ", ");
            }
        }
    }
    format.write_str(call.diag, "instruction ");
    format.write_u64(call.diag, i.index::u64);
    format.write_str(call.diag, " of the body");
}

# what refused a function
fun stage(s: mcompile.Stage) str {
    if (sel s.select)   { ret unselected(s.select); }
    if (sel s.pointer)  { ret "the frame's need of a pointer was not read"; }
    if (sel s.allowed)  { ret "the locations the allocator may assign were not listed"; }
    if (sel s.allocate) { ret "register allocation refused it"; }
    if (sel s.frame) {
        val e: finish.Error = s.frame;
        if (sel e.lay)        { ret "its frame was not laid out"; }
        if (sel e.code)       { ret framed(e.code); }
        if (sel e.made)       { ret "a register, slot or block of its frame was not made"; }
        if (sel e.operand)    { ret "a spill, reload or address of its frame names a register past the file"; }
        if (sel e.dropped)    { ret "an instruction names a slot the frame's layout dropped"; }
        if (sel e.unnumbered) { ret "a register a call frame rule names has no dwarf column under the build"; }
        ret "a call frame rule stands at an offset that scales";
    }
    if (sel s.copies)     { ret "its copies were not lowered to the set's moves"; }
    if (sel s.configure)  { ret "the states its instructions run under were not established"; }
    if (sel s.loops)      { ret "its loops were not expanded into their steps"; }
    if (sel s.layout)     { ret "its blocks were not laid out"; }
    if (sel s.ranges)     { ret "where its variables are was not read"; }
    if (sel s.verify)     { ret "the verifier refused it after the step"; }
    if (sel s.watched)    { ret "the watch of the compilation refused it"; }
    if (sel s.misplaced)  { ret "the step reads a form of it the steps before did not leave"; }
    if (sel s.unfinished) { ret "the steps ended before it was laid out"; }
    ret "it or a call it makes is under a convention row other than the target's default";
}

# why the target's frame code refused a move of a function's frame
fun framed(r: code.Refusal) str {
    if (sel r.reach)       { ret "the target's frame code reaches no slot at an offset of the frame"; }
    if (sel r.scaled)      { ret "the target's frame code forms no offset per unit of a scale of the frame"; }
    if (sel r.mask)        { ret "the target's frame code masks to no alignment of the frame"; }
    if (sel r.access)      { ret "the target's frame code has no load or store of a register the frame moves"; }
    if (sel r.unadmitted)  { ret "the target's frame code moves through a row the selection does not admit"; }
    if (sel r.made)        { ret "the function's maker refused an instruction of the frame code"; }
    if (sel r.constrained) { ret "an instruction of the frame code breaks its row's register constraints"; }
    if (sel r.unpaired)    { ret "the target's frame code moves two registers in no one instruction"; }
    ret "the frame moves through a probe routine the target's frame code makes none of";
}

# how a loop's body breaks its constraint
fun breach(b: lrow.Breach) str {
    if (sel b.long)   { ret "it holds more instructions than the limit"; }
    if (sel b.opened) { ret "it does not open with the load of the reserved pair"; }
    if (sel b.access) { ret "a step touches memory other than as its atomic access, or a second time"; }
    if (sel b.stored) { ret "it holds no store of the pair, or no swap"; }
    if (sel b.row)    { ret "a step needs an extension past the plain ones, or serialises"; }
    if (sel b.branch) { ret "a step transfers control other than by a conditional branch"; }
    ret "it branches back to its start before the store or the swap, or twice";
}

# the fact selection refused a target's table on
fun unselected(e: engine.Error) str {
    if (sel e.alloc)     { ret "the allocator refused storage"; }
    if (sel e.module)    { ret "the module refused a read"; }
    if (sel e.types)     { ret "the type table refused a read"; }
    if (sel e.unmatched) { ret "no rule matches an operation"; }
    if (sel e.unheld)    { ret "no class the build meets holds a value of a type"; }
    if (sel e.ambiguous) { ret "more than one class the build meets holds a value of a type"; }
    if (sel e.reach)     { ret "a type the target reaches has no class or two in the table"; }
    if (sel e.removed)   { ret "a value's definition was removed"; }
    if (sel e.machine)   { ret "the machine form refused an instruction the table built"; }
    if (sel e.aggregate) { ret "a value of an aggregate type, which no register holds"; }
    if (sel e.unlocated) { ret "a register a call clobbers has no location"; }
    if (sel e.placed)    { ret "a piece stands at a place selection does not carry"; }
    if (sel e.transfer)  { ret "a piece form instruction neither calls nor returns"; }
    if (sel e.lookup)    { ret "the target's thread lookup function is not named"; }
    if (sel e.cell)      { ret "the target's thread-local index cell is not declared"; }
    if (sel e.layout)    { ret "the target's layout gives no size for a slot's type"; }
    if (sel e.unplaced)  { ret "a function's entry has parameters the abi legalisation did not place"; }
    if (sel e.undecided) { ret "an instruction's transfer turns on an operand that names no register yet"; }
    if (sel e.unchecked) { ret "a division stands with no test of the trap it gives a result for"; }
    ret "the table breaks its schema";
}

# the step a module was not compiled at and the fact it failed on, for a
# refusal `refused` reports no more closely
fun uncompiled(c: mcompile.Error) str {
    if (sel c.alloc)     { ret "the allocator refused storage"; }
    if (sel c.foreign)   { ret "the build was opened for another target than the one given"; }
    if (sel c.locations) { ret "the locations of the target's registers and memories were not numbered"; }
    if (sel c.table)     { ret "selection refused the target's table"; }
    if (sel c.moves)     { ret "the instruction set's moves were not indexed for the target"; }
    if (sel c.code)      { ret "the frame code was not bound to the target's selection"; }
    if (sel c.machine)   { ret "the machine form text was not printed"; }
    if (sel c.write)     { ret "the listing was not written"; }
    if (sel c.mark)      { ret "the object refused the mark of a timing mode the code needs"; }
    if (sel c.emit) {
        val e: handover.Error = c.emit;
        if (sel e.alloc)      { ret "the allocator refused storage while the object was made"; }
        if (sel e.symbol)     { ret "an instruction names a symbol the module does not have"; }
        if (sel e.convention) { ret "the target states no calling convention, so its objects follow no psabi row"; }
        if (sel e.abi)        { ret "the convention names no psabi row of mink's catalog for the architecture"; }
        if (sel e.fill)       { ret "the target's code fill is not one byte repeated, which masc's alignment takes"; }
        if (sel e.format)     { ret "the target's system states no object format"; }
        if (sel e.dialect)    { ret "masc states no assembly dialect of the object format, which the listing is written in"; }
        if (sel e.listing)    { ret "masc refused to list the object it made"; }
        if (sel e.debug)      { ret "the dwarf producer refused the module's debug information"; }
        if (sel e.export)     { ret "the object refused to export a symbol the module marks exported"; }
    }
    ret "the back end refused it";
}

# report a module the webassembly back end refused: what wasm has no form of
# yet, a global another module defines in a final module, an address the
# table has no slot of, an address no relocation writes and a constant-time
# function whose code holds a secret where none may be are refused input, and
# anything else is internal
fun refused_wasm(call: *command.Call, m: *module.Module, e: wasm_error.Error) i64 {
    if (sel e.unselected) {
        diagnostic.headline(call.diag, nil, "an instruction webassembly has no form of yet");
        diagnostic.source(call.diag, m, e.unselected.location);
        diagnostic.symbol(call.diag, m.functions.data[e.unselected.function.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.threads) {
        diagnostic.headline(call.diag, nil, "an atomic access on a build that runs threads, which reach no atomic yet");
        diagnostic.source(call.diag, m, e.threads.location);
        diagnostic.symbol(call.diag, m.functions.data[e.threads.function.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.unvalued) {
        diagnostic.headline(call.diag, nil, "a value of a type no webassembly value type holds");
        ret exit.REFUSED;
    }
    if (sel e.undefined) {
        diagnostic.headline(call.diag, nil, "a global another module defines, which a final webassembly module cannot import");
        diagnostic.symbol(call.diag, m.globals.data[e.undefined.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.offset) {
        diagnostic.headline(call.diag, nil, "the address of a function at an offset, which its table slot has none of");
        diagnostic.symbol(call.diag, m.functions.data[e.offset.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.width) {
        diagnostic.headline(call.diag, nil, "an address in an initial value of a width no webassembly relocation writes");
        diagnostic.symbol(call.diag, m.globals.data[e.width.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.timing)     { ret timed(call, m, e.timing); }
    if (sel e.unfollowed) { ret unfollowed(call, m, e.unfollowed); }
    if (sel e.placement) {
        diagnostic.headline(call.diag, nil, "a signature the convention does not place");
        ret exit.REFUSED;
    }
    if (sel e.encoding) {
        diagnostic.named(call.diag, "masc refused the module", e.encoding.message);
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "the module was not compiled");
    ret exit.INTERNAL;
}

fun function_name(call: *command.Call, m: *module.Module, f: id.Function) {
    if (f.index::usize < m.functions.len) { diagnostic.symbol(call.diag, m.functions.data[f.index].data.name); }
}

# report why the spir-v back end refused a module: what spir-v or the build
# cannot hold is refused input, named by its function or global, and anything
# else is internal
fun refused_spirv(call: *command.Call, m: *module.Module, e: spirv_error.Error) i64 {
    if (sel e.unselected) {
        diagnostic.headline(call.diag, nil, "an instruction spir-v has no form of yet");
        diagnostic.source(call.diag, m, e.unselected.location);
        function_name(call, m, e.unselected.function);
        ret exit.REFUSED;
    }
    if (sel e.untyped) {
        diagnostic.headline(call.diag, nil, "a type spir-v holds no value of here");
        ret exit.REFUSED;
    }
    if (sel e.unpointed) {
        diagnostic.headline(call.diag, nil, "a pointer parameter whose pointee no use states");
        diagnostic.source(call.diag, m, e.unpointed.location);
        function_name(call, m, e.unpointed.function);
        ret exit.REFUSED;
    }
    if (sel e.reinterpreted) {
        diagnostic.headline(call.diag, nil, "an access that reinterprets memory, which logical addressing cannot");
        diagnostic.source(call.diag, m, e.reinterpreted.location);
        function_name(call, m, e.reinterpreted.function);
        ret exit.REFUSED;
    }
    if (sel e.variable) {
        diagnostic.headline(call.diag, nil, "a pointer chosen at run time, which logical addressing reaches only through variable pointers");
        diagnostic.source(call.diag, m, e.variable.location);
        function_name(call, m, e.variable.function);
        ret exit.REFUSED;
    }
    if (sel e.storage) {
        diagnostic.headline(call.diag, nil, "a global used in another storage class than its own, or one its class holds no value of");
        diagnostic.symbol(call.diag, m.globals.data[e.storage.index].data.name);
        ret exit.REFUSED;
    }
    if (sel e.slot) {
        diagnostic.headline(call.diag, nil, "a stack slot whose pointer is not into the Function storage class");
        diagnostic.source(call.diag, m, e.slot.location);
        function_name(call, m, e.slot.function);
        ret exit.REFUSED;
    }
    if (sel e.entry) {
        diagnostic.headline(call.diag, nil, "an entry point that takes or returns a value, or has no body");
        function_name(call, m, e.entry);
        ret exit.REFUSED;
    }
    if (sel e.workgroup) {
        diagnostic.headline(call.diag, nil, "a workgroup dimension named by no 32-bit integer specialization constant of the module");
        function_name(call, m, e.workgroup);
        ret exit.REFUSED;
    }
    if (sel e.imported) {
        diagnostic.headline(call.diag, nil, "an image that imports what no other object defines for it");
        if (sel e.imported.function) { function_name(call, m, e.imported.function); }
        if (sel e.imported.global)   { diagnostic.symbol(call.diag, m.globals.data[e.imported.global.index].data.name); }
        ret exit.REFUSED;
    }
    if (sel e.unmet) {
        diagnostic.named(call.diag, "the module needs what the build's selection does not hold", e.unmet.name);
        ret exit.REFUSED;
    }
    if (sel e.unstructured) {
        diagnostic.headline(call.diag, nil, "a function whose structure the emitter cannot follow");
        function_name(call, m, e.unstructured);
        ret exit.INTERNAL;
    }
    if (sel e.encoding) {
        diagnostic.named(call.diag, "masc refused the module", e.encoding.message);
        ret exit.INTERNAL;
    }
    if (sel e.builder) {
        diagnostic.named(call.diag, "masc refused the module", e.builder.message);
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "the module was not compiled");
    ret exit.INTERNAL;
}

# report a function refused as constant time: masc's one wording of the
# refusal, the function, where in its code it stands and the unchecked callee
# a secret reached where the call names one. it is refused input
fun timed(call: *command.Call, m: *module.Module, r: mct.Refused) i64 {
    var words: vector.Vector[u8] = vector.init[u8](call.a);
    fin { vector.dnit[u8](?words); }
    var held:    masc_ct.Refusal = r.refusal;
    val spelled: err[A.Error]    = mct.spell(?held, ?words);
    diagnostic.lead(call.diag, nil);
    if (sel spelled.err) { format.write_str(call.diag, masc_ct.message(?held)); }
    or                   { diagnostic.view(call.diag, View{data: words.data, len: words.len}); }
    format.write_str(call.diag, "\n");
    diagnostic.source(call.diag, m, r.location);
    diagnostic.symbol(call.diag, m.functions.data[r.function.index].data.name);
    located(call, r.at);
    val callee: opt[id.Function] = r.callee;
    if (sel callee.some) {
        format.write_str(call.diag, "  = callee: @");
        diagnostic.view(call.diag, m.functions.data[callee.some.index].data.name);
        format.write_str(call.diag, "\n");
    }
    ret exit.REFUSED;
}

# where in a function's code a constant-time refusal stands, `= at: ...`
fun located(call: *command.Call, at: mct.Where) {
    if (sel at.whole) { ret; }
    format.write_str(call.diag, "  = at: ");
    if (sel at.instruction) {
        format.write_str(call.diag, "instruction ");
        format.write_u64(call.diag, at.instruction::u64);
    }
    if (sel at.offset) {
        format.write_str(call.diag, "byte ");
        format.write_u64(call.diag, at.offset);
        format.write_str(call.diag, " of its code");
    }
    format.write_str(call.diag, "\n");
}

# report a constant-time function whose code the walk could not follow on a
# set that classifies its rows, so the requirement is not met. it is refused
# input
fun unfollowed(call: *command.Call, m: *module.Module, u: mct.Unfollowed) i64 {
    diagnostic.headline(call.diag, nil, "constant time required of code the walk of its instructions could not follow");
    diagnostic.tagged(call.diag, "why", u.unread.message);
    diagnostic.source(call.diag, m, u.location);
    diagnostic.symbol(call.diag, m.functions.data[u.function.index].data.name);
    located(call, mct.Where.offset{u.unread.offset});
    ret exit.REFUSED;
}

# report a constant-time function whose own frame reads a slot no store reaches first, which its walk would take as
# public: the function and the slot's alloca, by its instruction and the name of its address where it has one. it is
# refused input
fun stale(call: *command.Call, m: *module.Module, s: mct.Stale) i64 {
    diagnostic.headline(call.diag, nil, "constant time required of a function whose own frame reads a slot no store reaches first");
    diagnostic.source(call.diag, m, s.location);
    diagnostic.symbol(call.diag, m.functions.data[s.function.index].data.name);
    located(call, s.at);
    if (sel s.at.instruction) {
        val b: *function.Body               = ?m.functions.data[s.function.index].body;
        val d: *instruction.InstructionData = ?b.instructions.data[s.at.instruction::usize];
        if (d.results.len > 0) {
            val name: opt[View] = b.values.data[d.results.data[0].index].name;
            if (sel name.some) {
                format.write_str(call.diag, "  = slot: ");
                diagnostic.view(call.diag, name.some);
                format.write_str(call.diag, "\n");
            }
        }
    }
    ret exit.REFUSED;
}

# report a relocation the target's object format does not map: the module
# needs what the target cannot write, so it is refused input, named by the
# symbol it aims at and by mink's failure, which names the kind and the format
fun unmapped(call: *command.Call, m: *module.Module, u: handover.Unmapped) i64 {
    diagnostic.headline(call.diag, nil, "the target's object format maps no relocation of a kind the module needs");
    if (sel u.symbol.some) {
        val s: id.Symbol = u.symbol.some;
        if (sel s.function) { diagnostic.symbol(call.diag, m.functions.data[s.function.index].data.name); }
        or (sel s.global)   { diagnostic.symbol(call.diag, m.globals.data[s.global.index].data.name); }
    }
    if (sel u.refusal.object.some) { diagnostic.failure(call.diag, call.a, u.refusal.object.some); }
    ret exit.REFUSED;
}

# report a symbol the module marks exported that the object refused to export,
# which is internal, as the export states nothing past its symbol and name
fun unexported(call: *command.Call, m: *module.Module, u: handover.Unexported) i64 {
    diagnostic.headline(call.diag, nil, "the object refused to export a symbol the module marks exported");
    val s: id.Symbol = u.symbol;
    if (sel s.function)     { diagnostic.symbol(call.diag, m.functions.data[s.function.index].data.name); }
    or (sel s.global)       { diagnostic.symbol(call.diag, m.globals.data[s.global.index].data.name); }
    if (sel u.failure.some) { diagnostic.failure(call.diag, call.a, u.failure.some); }
    ret exit.INTERNAL;
}

# report an object that was not written: a system that states no format is
# refused input, and anything else is internal
fun unwritten(call: *command.Call, e: compile.Unwritten) i64 {
    if (sel e.sys && sel e.sys.formats) {
        diagnostic.headline(call.diag, nil, "the target's system states no object format");
        ret exit.REFUSED;
    }
    diagnostic.headline(call.diag, nil, "the object was not written");
    ret exit.INTERNAL;
}
