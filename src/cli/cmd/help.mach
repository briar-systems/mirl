# `mirl help`: the commands and the exit codes

use std.types.bool.false;

use mirl.cli.args;
use mirl.cli.exit;
use shown: mirl.cli.help;

# the command row
pub val COMMAND: args.Command = args.Command{name: "help", summary: "show the commands and the exit codes", usage: "help", file: false, options: nil, option_n: 0, run: handle};

fun handle(call: *args.Call) i64 {
    shown.overview(call.out, call.commands);
    ret exit.OK;
}
