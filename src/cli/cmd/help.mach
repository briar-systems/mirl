# `mirl help`: the commands and the exit codes

use std.types.bool.false;

use mirl.cli.command;
use mirl.cli.exit;
use shown: mirl.cli.help;

# the command row
pub val COMMAND: command.Command = command.Command{name: "help", summary: "show the commands and the exit codes", usage: "help", file: false, flags: nil, flag_n: 0, run: handle};

fun handle(call: *command.Call) i64 {
    shown.overview(call.out, call.commands);
    ret exit.OK;
}
