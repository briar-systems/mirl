# `mirl help [<command>]`: the commands and the exit codes, or one command's page

use std.types.bool.false;

use std.args;
use args_help: std.args.help;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use shown: mirl.cli.help;

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{name: "help", id: 0, aliases: nil, alias_n: 0, grammar: " [<command>]", summary: "show the commands and the exit codes, or a command's options", effect: "write the commands and the exit codes the program returns, or the page of the command named", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    if (call.operand == nil) { ret shown.overview(call.out, call.diag, call.commands); }
    val named: *args.CommandSpec = args.command_for(call.commands, call.operand);
    if (named == nil) {
        diagnostic.named(call.diag, "no command of the name, run 'mirl help' for the commands", call.operand);
        ret exit.REFUSED;
    }
    ret shown.show(call.out, call.diag, call.commands, args_help.Page{command: named, action: nil});
}
