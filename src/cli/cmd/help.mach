# `mirl help`: the commands and the exit codes

use std.types.bool.false;

use std.args;

use mirl.cli.command;
use shown: mirl.cli.help;

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{name: "help", id: 0, aliases: nil, alias_n: 0, grammar: "", summary: "show the commands and the exit codes", effect: "write the commands and the exit codes the program returns", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 0, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    ret shown.overview(call.out, call.diag, call.commands);
}
