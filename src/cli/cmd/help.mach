# `mirl help [<command>]`: the overview, or the page of the command named

use std.types.bool.false;
use std.types.string.str;

use std.args;
use std.collections.slice.Slice;

use mirl.cli.command;

# the flags the command reads
val FLAGS: [1]*args.Flag = [1]*args.Flag{?command.HELP};

# the command's registration. the program answers it before any handler runs, as it needs the
# root to parse the command named
pub val SPEC: args.Command = args.Command{name: "help", aliases: Slice[str]{data: nil, size: 0}, help: "show help for a command", usage: "[<command>]", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 1}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 0, operand_max: 1, passthrough: false};
