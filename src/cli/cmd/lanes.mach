# `mirl lanes`: write the example lane targets to stdout, one per line

use std.types.bool.false;
use std.types.error.err;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.machine.emit.lane;

# the command row
pub val COMMAND: command.Command = command.Command{name: "lanes", summary: "write the example lane targets to stdout", usage: "lanes", file: false, flags: nil, flag_n: 0, run: handle};

fun handle(call: *command.Call) i64 {
    val written: err[lane.Error] = lane.write(call.out);
    if (sel written.err) {
        diagnostic.headline(call.diag, nil, "cannot write the lane targets");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}
