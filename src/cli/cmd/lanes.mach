# `mirl lanes`: write the example lane targets to stdout, one per line

use std.types.bool.false;
use std.types.error.err;

use std.args;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.target.lane;

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{name: "lanes", id: 6, aliases: nil, alias_n: 0, grammar: "", summary: "write the example lane targets to stdout", effect: "write the example lane targets to stdout, one per line", exits: nil, exit_n: 0, terminator: "", tables: nil, table_n: 0, refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 0, operand_max: 0, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    val written: err[lane.Error] = lane.write(call.out, call.a);
    if (sel written.err) {
        diagnostic.headline(call.diag, nil, "cannot write the lane targets");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}
