# `mirl verify <file>`: parse the text and check the module against the verifier
#
# a module is checked as one open to every pass, or with `--legal` as one
# past legalisation, whose functions' region trees the structure analysis
# reads, so the structured rule holds a target that requires structured
# control to it

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mirl.ir.module;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.target;
use mirl.target.Target;
use mirl.target.basis.Basis;
use mirl.verify;
use mirl.verify.table;
use std.args;
use std.types.option.opt;

# the flag that checks a module as past legalisation
pub val LEGAL: args.Flag = args.Flag{name: "--legal", short: nil, kind: args.SWITCH, negatable: true, occurs: args.Occurs.override{}, value: "", doc: "check the module as past legalisation, its functions' structure read from their region trees"};

# the flag rows the command takes
pub val FLAGS: [2]*args.Flag = [2]*args.Flag{?source.BODY, ?LEGAL};

# the command row
pub val COMMAND: command.Command = command.Command{name: "verify", summary: "check that a file is a valid module", usage: "verify <file> [options]", file: true, flags: ?FLAGS[0], flag_n: 2, run: handle};

fun handle(call: *command.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }

    val legal: res[bool, i64] = flag.on(call, ?LEGAL);
    if (sel legal.err) { ret legal.err; }
    var checked: err[verify.Error] = verify.check(?m);
    if (legal.ok && sel checked.ok) { checked = legalised(?m); }
    if (sel checked.err) {
        if (sel checked.err.alloc) {
            diagnostic.headline(call.diag, nil, "out of memory");
            ret exit.INTERNAL;
        }
        ret refused(call, ?m, checked.err.refused);
    }
    ret exit.OK;
}

# check a module past legalisation, against its target and the region trees
# the structure analysis reads of its functions
fun legalised(m: *module.Module) err[verify.Error] {
    val made: res[Target, target.Refusal] = target.assemble(m.a, module.target(m));
    if (sel made.err) { ret verify.check(m); }
    var t: Target = made.ok;
    fin { target.release(m.a, ?t); }
    var c: cache.Cache = cache.init(m, ?t, opt[*Basis].none{}, analysis.rows());
    fin { val dropped: err[allocator.Error] = cache.dnit(?c); }
    ret table.against(m, ?t, target.NO_BUILD, verify.Stage.legal{analysis.trees(?c)});
}

# the name of the rule a verifier refusal broke
fun rule_name(f: verify.Failure) str {
    val row: opt[table.Row] = table.row(f.rule);
    if (sel row.some) { ret row.some.name; }
    ret "rule";
}

# report a verifier refusal: the rule it broke, the fact, the source place of
# the instruction it names, and the symbol it is in
pub fun refused(call: *command.Call, m: *module.Module, f: verify.Failure) i64 {
    diagnostic.rule(call.diag, rule_name(f), f.what);
    diagnostic.in_file(call.diag, call.operand);
    diagnostic.source(call.diag, m, f.at.location);
    diagnostic.symbol(call.diag, f.at.name);
    diagnostic.op(call.diag, f.at.set, f.at.op);
    diagnostic.form(call.diag, f.at.form);
    ret exit.REFUSED;
}

# a verifier refusal under another headline: the rule, the fact, the source
# place of the instruction it names, and the symbol it is in
pub fun detail(call: *command.Call, m: *module.Module, f: verify.Failure) {
    diagnostic.tagged(call.diag, "rule", rule_name(f));
    diagnostic.tagged(call.diag, "why", f.what);
    diagnostic.source(call.diag, m, f.at.location);
    diagnostic.symbol(call.diag, f.at.name);
    diagnostic.op(call.diag, f.at.set, f.at.op);
    diagnostic.form(call.diag, f.at.form);
}
