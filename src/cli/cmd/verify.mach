# `mirl verify <file>`: parse the text and check the module against the verifier
#
# a module is checked as one open to every pass, or with `--legal` as one
# past legalisation, whose functions' region trees the structure analysis
# reads, so the structured rule holds a target that requires structured
# control to it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mirl.ir.module;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.target.assemble;
use mirl.target.basis.Basis;
use mirl.target.layout;
use mirl.target.record.Target;
use mirl.verify.failure;
use mirl.verify.table;
use std.args;
use std.collections.slice.Slice;
use std.types.option.opt;

# the flag that checks a module as past legalisation
pub val LEGAL: args.Flag = args.Flag{long: "legal", short: 0, value: nil, repeat: false, negatable: true, help: "check the module as past legalisation"};

# the flags the command reads, in the order help lists them
val FLAGS: [2]*args.Flag = [2]*args.Flag{?command.HELP, ?LEGAL};

# the command's registration
pub val SPEC: args.Command = args.Command{name: "verify", aliases: Slice[str]{data: nil, size: 0}, help: "check a module against the verifier", usage: "<file>", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 2}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 1, operand_max: 1, passthrough: false};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }

    val verdict: err[failure.Error] = checked(?m, args.on(call.p, ?LEGAL));
    if (sel verdict.err) {
        if (sel verdict.err.alloc) {
            diagnostic.headline(call.diag, nil, "out of memory");
            ret exit.ENVIRONMENT;
        }
        ret refused(call, ?m, verdict.err.refused);
    }
    ret exit.OK;
}

# check a module against the target its tuple assembles to, as a front end
# gives it, or past legalisation against the region trees the structure
# analysis reads of its functions. a tuple that does not assemble breaks the
# target rule, by the rule of assembly it breaks
fun checked(m: *module.Module, legal: bool) err[failure.Error] {
    val made: res[Target, assemble.Error] = assemble.assemble(m.a, module.target(m));
    if (sel made.err) {
        if (sel made.err.alloc) { ret err[failure.Error].err{failure.Error.alloc{made.err.alloc}}; }
        ret err[failure.Error].err{failure.Error.refused{failure.Failure{rule: table.TARGET, at: failure.module_wide(), what: assemble.rule(made.err)}}};
    }
    var t: Target = made.ok;
    fin { assemble.release(m.a, ?t); }
    if (!legal) { ret table.against(m, ?t, layout.NO_BUILD, failure.Stage.given{}, failure.Scope.whole{}); }
    var c: cache.Cache = cache.init(m, ?t, opt[*Basis].none{}, analysis.rows());
    fin { val dropped: err[allocator.Error] = cache.dnit(?c); }
    ret table.against(m, ?t, layout.NO_BUILD, failure.Stage.legal{analysis.trees(?c)}, failure.Scope.whole{});
}

# verify a module read from text once against the target it is compiled for,
# with no build open, before a command hands it to a compilation, which
# verifies nothing it is given unless it is checked
# ---
# call: the command's context, whose operand names the text's file
# m:    the module the text reads as
# t:    the target the command compiles it for
# ret:  exit.OK, or the exit code of the refusal
pub fun read(call: *command.Call, m: *module.Module, t: *Target) i64 {
    val r: err[failure.Error] = table.against(m, t, layout.NO_BUILD, failure.Stage.given{}, failure.Scope.whole{});
    if (sel r.err) {
        if (sel r.err.alloc) {
            diagnostic.headline(call.diag, nil, "out of memory");
            ret exit.ENVIRONMENT;
        }
        ret refused(call, m, r.err.refused);
    }
    ret exit.OK;
}

# the name of the rule a verifier refusal broke
fun rule_name(f: failure.Failure) str {
    val row: opt[table.Row] = table.row(f.rule);
    if (sel row.some) { ret row.some.name; }
    ret "rule";
}

# report a verifier refusal: the rule it broke, the fact, the source place of
# the instruction it names, and the symbol it is in
pub fun refused(call: *command.Call, m: *module.Module, f: failure.Failure) i64 {
    diagnostic.rule(call.diag, rule_name(f), f.what);
    diagnostic.in_file(call.diag, call.operand);
    diagnostic.source(call.diag, m, f.at.location);
    diagnostic.symbol(call.diag, f.at.name);
    diagnostic.op(call.diag, f.at.set, f.at.op);
    diagnostic.form(call.diag, f.at.form);
    diagnostic.extension(call.diag, f.at.extension);
    ret exit.REFUSED;
}

# a verifier refusal under another headline: the rule, the fact, the source
# place of the instruction it names, and the symbol it is in
pub fun detail(call: *command.Call, m: *module.Module, f: failure.Failure) {
    diagnostic.tagged(call.diag, "rule", rule_name(f));
    diagnostic.tagged(call.diag, "why", f.what);
    diagnostic.source(call.diag, m, f.at.location);
    diagnostic.symbol(call.diag, f.at.name);
    diagnostic.op(call.diag, f.at.set, f.at.op);
    diagnostic.form(call.diag, f.at.form);
    diagnostic.extension(call.diag, f.at.extension);
}
