# `mirl verify <file>`: parse the text and check the module against the verifier

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.source;
use mirl.ir.module;
use mirl.verify;
use mirl.verify.table;
use std.args;
use std.types.option.opt;

# the flag rows the command takes
pub val FLAGS: [1]*args.Flag = [1]*args.Flag{?source.BODY};

# the command row
pub val COMMAND: command.Command = command.Command{name: "verify", summary: "check that a file is a valid module", usage: "verify <file> [options]", file: true, flags: ?FLAGS[0], flag_n: 1, run: handle};

fun handle(call: *command.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }

    val checked: err[verify.Error] = verify.check(?m);
    if (sel checked.err) {
        if (sel checked.err.alloc) {
            diagnostic.headline(call.diag, nil, "out of memory");
            ret exit.INTERNAL;
        }
        ret refused(call, checked.err.refused);
    }
    ret exit.OK;
}

# report a verifier refusal: the rule it broke, the fact, and the symbol it is in
pub fun refused(call: *command.Call, f: verify.Failure) i64 {
    var name: str            = "rule";
    val row:  opt[table.Row] = table.row(f.rule);
    if (sel row.some) { name = row.some.name; }
    diagnostic.rule(call.diag, name, f.what);
    diagnostic.in_file(call.diag, call.operand);
    diagnostic.symbol(call.diag, f.at.name);
    ret exit.REFUSED;
}
