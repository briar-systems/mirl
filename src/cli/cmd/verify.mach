# `mirl verify <file>`: parse the text and check the module against the verifier
#
# a module is checked as one open to every pass, or with `--legal` as one
# past legalisation, whose functions' region trees the structure analysis
# reads, so the structured rule holds a target that requires structured
# control to it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.chrono.time.Instant;

use std.allocator;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.layout;
use mirl.cli.readout;
use mirl.cli.source;
use cli_target: mirl.cli.target;
use mirl.failure;
use mirl.failure.text;
use mirl.ir.module;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.target.assemble;
use mirl.target.basis.Basis;
use layout_rules: mirl.target.layout;
use mirl.target.record.Target;
use verify_failure: mirl.verify.failure;
use mirl.verify.table;
use std.args;
use std.collections.slice.Slice;
use std.types.option.opt;

# the flag that checks a module as past legalisation
pub val LEGAL: args.Flag = args.Flag{long: "legal", short: 0, value: nil, repeat: false, negatable: true, help: "check the module as past legalisation"};

# the flags the command reads, in the order help lists them
val FLAGS: [3]*args.Flag = [3]*args.Flag{?command.HELP, ?command.VERBOSE, ?LEGAL};

# the command's registration
pub val SPEC: args.Command = args.Command{name: "verify", aliases: Slice[str]{data: nil, size: 0}, help: "check a module against the verifier", usage: "<file>", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 3}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 1, operand_max: 1, passthrough: false};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

# `verified` and the file, its target, its functions with a body and the time, or `failed` with
# its one error
fun handle(call: *command.Call) i64 {
    var c: command.Closing;
    command.closing(?c);
    val code: i64 = checked_file(call, ?c);
    if (code != exit.OK) { command.failed(call, ?c); }
    ret code;
}

fun checked_file(call: *command.Call, c: *command.Closing) i64 {
    val res_loaded: res[module.Module, i64] = source.load(call);
    if (sel res_loaded.err) { ret res_loaded.err; }
    var m: module.Module = res_loaded.ok;
    fin { module.dnit(?m); }
    command.settle(c, module.target(?m));

    val from_target: opt[Instant]                = readout.begin(call.rd, "target");
    val res_made:    res[Target, assemble.Error] = assemble.assemble(m.a, module.target(?m));
    if (sel res_made.err) {
        if (sel res_made.err.alloc) {
            text.headline(?call.report, nil, "out of memory");
            ret exit.ENVIRONMENT;
        }
        ret exit.of(failure.verified(?call.report, ?m, verify_failure.Failure{rule: table.TARGET, at: verify_failure.module_wide(), what: assemble.rule(res_made.err)}));
    }
    var t: Target = res_made.ok;
    fin { assemble.dnit(m.a, ?t); }
    readout.end(call.rd, "target", from_target, c.target);
    cli_target.facts(call.rd, module.target(?m), ?t);

    val from_verify: opt[Instant]              = readout.begin(call.rd, "verify");
    val err_verdict: err[verify_failure.Error] = checked(?m, ?t, args.on(call.p, ?LEGAL));
    if (sel err_verdict.err) {
        if (sel err_verdict.err.alloc) {
            text.headline(?call.report, nil, "out of memory");
            ret exit.ENVIRONMENT;
        }
        ret exit.of(failure.verified(?call.report, ?m, err_verdict.err.refused));
    }
    readout.end(call.rd, "verify", from_verify, nil);

    var n:      layout.Text;
    var e:      layout.Text;
    var fields: [3]layout.Field = [3]layout.Field{
        layout.Field{key: "target", value: c.target},
        layout.Field{key: "functions", value: layout.nonzero(?n, module.size(?m).functions::u64)},
        layout.Field{key: "time", value: layout.took(?e, readout.elapsed(call.rd))},
    };
    readout.result(call.rd, layout.VERIFIED, call.operand, ?fields[0], 3);
    ret exit.OK;
}

# check a module against the target its tuple assembled to, as a front end gives it, or past
# legalisation against the region trees the structure analysis reads of its functions
fun checked(m: *module.Module, t: *Target, legal: bool) err[verify_failure.Error] {
    if (!legal) { ret table.against(m, t, layout_rules.NO_BUILD, verify_failure.Stage.given{}, verify_failure.Scope.whole{}); }
    var c: cache.Cache = cache.init(m, t, opt[*Basis].none{}, analysis.rows(), analysis.VERIFIER);
    fin { val err_dropped: err[allocator.Error] = cache.dnit(?c); }
    ret table.against(m, t, layout_rules.NO_BUILD, verify_failure.Stage.legal{analysis.trees(?c)}, verify_failure.Scope.whole{});
}

# verify a module read from text once against the target it is compiled for,
# with no build open, before a command hands it to a compilation, which
# verifies nothing it is given unless it is checked, as the stage `verify`
# ---
# call: the command's context, whose operand names the text's file
# m:    the module the text reads as
# t:    the target the command compiles it for
# ret:  exit.OK, or the exit code of the refusal
pub fun read(call: *command.Call, m: *module.Module, t: *Target) i64 {
    val from:        opt[Instant]              = readout.begin(call.rd, "verify");
    val err_against: err[verify_failure.Error] = table.against(m, t, layout_rules.NO_BUILD, verify_failure.Stage.given{}, verify_failure.Scope.whole{});
    if (sel err_against.err) {
        if (sel err_against.err.alloc) {
            text.headline(?call.report, nil, "out of memory");
            ret exit.ENVIRONMENT;
        }
        ret exit.of(failure.verified(?call.report, m, err_against.err.refused));
    }
    readout.end(call.rd, "verify", from, nil);
    ret exit.OK;
}
