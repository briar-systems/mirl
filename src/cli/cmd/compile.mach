# `mirl compile <file> [-o <path>] [--emit <kind>]`: compile the text for a
# target through mirl.target.compile and write one kind of what the
# compilation makes
#
# a kind is a row of KINDS, a stopping point as mach's --emit names it: the
# module after the pass schedule, the machine form text of the laid out
# functions, masc's listing of the object, or the object in the format of the
# target's system, through mink, the default. the command reads the line and
# reports, and the compilation is the library's.

use std.format;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use fs: std.filesystem;
use io: std.io.writer;

use mink.base.fail.Fail;

use mirl.base.stats.Stats;
use mirl.cli.build;
use verify_cmd: mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use cli_target: mirl.cli.target;
use mct:        mirl.ct;
use mirl.debug.records;
use mirl.ir.block.BlockData;
use mirl.ir.function;
use mirl.ir.id;
use mirl.ir.instruction;
use mirl.ir.module;
use irow:         mirl.ir.opcode.row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.text.item;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.ir.type.table.Type;
use mirl.machine.alloc.allocate;
use mirl.machine.alloc.check;
use mirl.machine.alloc.live;
use mirl.machine.alloc.rewrite;
use mirl.machine.alloc.scan;
use mirl.machine.alloc.spill;
use mcompile: mirl.machine.compile;
use mirl.machine.copy.lower;
use mirl.machine.emit.handover;
use mirl.machine.frame.code;
use mirl.machine.frame.finish;
use minline: mirl.machine.inline;
use lrow:    mirl.machine.loop.row;
use mirl.machine.select.engine;
use mirl.machine.timing;
use mirl.pass.relaxation;
use pass_schedule: mirl.pass.schedule;
use mirl.target.assemble;
use target_basis: mirl.target.basis;
use mirl.target.compile;
use mirl.target.family;
use thead: mirl.target.head;
use mirl.target.options;
use mirl.target.record.Target;
use spirv_error: mirl.target.spirv.error;
use mirl.target.warning.Warning;
use wasm_error: mirl.target.wasm.error;
use std.args;

use masc_ct: masc.core.ct;

# one kind of output, by the name mach's --emit gives it
# ---
# name:    the --emit value that names it
# ir:      it is the module after the pass schedule, which stops there
# machine: it is the machine form text
# listing: it is masc's listing
# object:  it is the object's bytes
pub rec Kind {
    name:    str;
    ir:      bool;
    machine: bool;
    listing: bool;
    object:  bool;
}

# the permission bits of a file -o creates, rw-r--r--
val FILE_MODE: i32 = 420;

# every kind, in the order help lists them
pub val KINDS: [4]Kind = [4]Kind{
    Kind{name: "ir", ir: true, machine: false, listing: false, object: false},
    Kind{name: "machine", ir: false, machine: true, listing: false, object: false},
    Kind{name: "asm", ir: false, machine: false, listing: true, object: false},
    Kind{name: "obj", ir: false, machine: false, listing: false, object: true},
};

# the kind written when --emit is not given
val OBJ: usize = 3;

# the flag that names the kind of output to write
pub val EMIT: args.Flag = args.Flag{long: "emit", short: 0, value: "kind", repeat: false, negatable: false, help: "the output: ir, machine, asm or obj (default: obj)"};

# the flag that names the file the output goes to, stdout when it is not given
pub val OUTPUT: args.Flag = args.Flag{long: "output", short: 'o', value: "path", repeat: false, negatable: false, help: "the file to write (default: stdout)"};

# the switch that verifies the module around every pass and every function after every stage
pub val VERIFY: args.Flag = args.Flag{long: "verify", short: 0, value: nil, repeat: false, negatable: true, help: "verify after every pass and stage, and prove every allocation"};

# the switch that lets the linker relax the code, on unless negated
pub val RELAX: args.Flag = args.Flag{long: "relax", short: 0, value: nil, repeat: false, negatable: true, help: "mark relocations the linker may relax (default: on)"};

# the switch that asks for the final image the target loads as it is, not a relocatable object
pub val IMAGE: args.Flag = args.Flag{long: "image", short: 0, value: nil, repeat: false, negatable: true, help: "write the final wasm image, not a relocatable object"};

# the flag that asks for each symbol of one kind in a section of its own, given once for each
pub val APART: args.Flag = args.Flag{long: "apart", short: 0, value: "kind", repeat: true, negatable: false, help: "a section per symbol of a kind, functions or data, once for each"};

# the flags the command reads, in the order help lists them
val FLAGS: [16]*args.Flag = [16]*args.Flag{?command.HELP, ?EMIT, ?OUTPUT, ?cli_target.TARGET, ?cli_target.ENV, ?cli_target.ABI, ?cli_target.ISA, ?cli_target.EXT, ?cli_target.CODE_MODEL, ?build.KIND, ?build.LEVEL, ?build.FLOAT_RELAX, ?VERIFY, ?RELAX, ?IMAGE, ?APART};

# the command's registration
pub val SPEC: args.Command = args.Command{name: "compile", aliases: Slice[str]{data: nil, size: 0}, help: "compile a module", usage: "<file>", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 16}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 1, operand_max: 1, passthrough: false};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

# the kind an --emit value names, nil for none
pub fun kind_of(s: str) *Kind {
    if (s == nil) { ret nil; }
    var i: usize = 0;
    for (i < $length_of(KINDS)) {
        if (str_equals(KINDS[i].name, s)) { ret ?KINDS[i]; }
        i = i + 1;
    }
    ret nil;
}

fun handle(call: *command.Call) i64 {
    val asked: str   = args.value(call.p, ?EMIT);
    var named: *Kind = ?KINDS[OBJ];
    if (asked != nil) { named = kind_of(asked); }
    if (named == nil) {
        diagnostic.named(call.diag, "not a kind of output, ir, machine, asm or obj", asked);
        ret exit.REFUSED;
    }
    val k:       Kind = @named;
    val checked: bool = args.on(call.p, ?VERIFY);
    var relax:   bool = options.RELAX;
    if (args.given(call.p, ?RELAX)) { relax = args.on(call.p, ?RELAX); }
    val image: bool                    = args.on(call.p, ?IMAGE);
    val apart: res[options.Apart, i64] = asked_apart(call);
    if (sel apart.err) { ret apart.err; }
    var output: options.Output = options.Output.object{};
    if (image) { output = options.Output.image{}; }
    val level: res[pass_schedule.Level, i64] = build.asked_level(call);
    if (sel level.err) { ret level.err; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    var added: Slice[str]       = Slice[str]{data: nil, size: 0};
    val t:     res[Target, i64] = build.asked_target(call, ?m, ?added);
    if (sel t.err) { ret t.err; }
    var own: Target = t.ok;
    fin { assemble.release(call.a, ?own); }
    val read: i64 = verify_cmd.read(call, ?m, ?own);
    if (read != exit.OK) { ret read; }
    val floats: res[relaxation.Relaxations, i64] = build.asked_floats(call);
    if (sel floats.err) { ret floats.err; }

    # the output is held until the compilation is done, so a refused one writes nothing
    var held: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?held); }
    var w:       io.Writer       = sink.writer(?held);
    var none:    opt[*io.Writer] = opt[*io.Writer].none{};
    var machine: opt[*io.Writer] = none;
    var listing: opt[*io.Writer] = none;
    if (k.machine) { machine = opt[*io.Writer].some{?w}; }
    if (k.listing) { listing = opt[*io.Writer].some{?w}; }
    val options: options.Options = options.Options{
        output:  output,
        level:   level.ok,
        checked: checked,
        machine: machine,
        listing: listing,
        relax:   relax,
        floats:  floats.ok,
        apart:   apart.ok,
        stats:   opt[*Stats].none{},
    };
    var prepared: compile.Prepared;
    val opened:   err[family.Error] = compile.open(?prepared, call.a, ?own, added);
    if (sel opened.err) { ret failed(call, ?m, ?own, added, opened.err); }
    fin { compile.close(?prepared); }
    if (k.ir) {
        val ran: err[family.Error] = compile.optimise(?prepared, ?m, options);
        if (sel ran.err) { ret failed(call, ?m, ?own, added, ran.err); }
        val printed: err[printer.Error] = item.print(?w, ?m);
        if (sel printed.err) {
            diagnostic.headline(call.diag, nil, "cannot print the module");
            ret exit.INTERNAL;
        }
        ret delivered(call, sink.view(?held));
    }
    val made: res[compile.Compiled, family.Error] = compile.compile(?prepared, call.a, ?m, options);
    if (sel made.err) { ret failed(call, ?m, ?own, added, made.err); }
    var c: compile.Compiled = made.ok;
    module.lent_to(?m, ?c.object.names);
    fin {
        module.spent(?m);
        compile.release(?c);
    }
    warned(call, ?m, ?c.warnings);
    if (k.object) {
        val wrote: err[family.Error] = compile.write(?prepared, call.a, ?c.object, output, ?w);
        if (sel wrote.err) { ret unwritten(call, wrote.err); }
    }
    ret delivered(call, sink.view(?held));
}

# write the warnings a compilation gave, each as a line `warning: <function>: ...`
fun warned(call: *command.Call, m: *module.Module, given: *vector.Vector[Warning]) {
    var i: usize = 0;
    for (i < given.len) {
        val w: Warning = given.data[i];
        if (sel w.unheld) { unheld(call, m, w.unheld); }
        i = i + 1;
    }
}

# the warning that a soft constant-time function's timing is not held, and what the walk could not follow, where it
# could not
fun unheld(call: *command.Call, m: *module.Module, u: mct.Unheld) {
    val name: View = module.name_of(m, m.functions.data[u.function].data.name);
    format.write_str(call.diag, "warning: ");
    diagnostic.view(call.diag, name);
    format.write_str(call.diag, ": ");
    format.write_str(call.diag, masc_ct.UNGUARANTEED);
    format.write_str(call.diag, "\n");
    if (sel u.unread.none) { ret; }
    format.write_str(call.diag, "warning: ");
    diagnostic.view(call.diag, name);
    format.write_str(call.diag, ": not verified: ");
    format.write_str(call.diag, u.unread.some.message);
    format.write_str(call.diag, "\n");
}

# write the output to the file -o names, or to stdout when it names none
fun delivered(call: *command.Call, bytes: View) i64 {
    val path: str = args.value(call.p, ?OUTPUT);
    if (path == nil) {
        val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
        if (sel wrote.err) {
            diagnostic.headline(call.diag, nil, "cannot write the output");
            ret exit.ENVIRONMENT;
        }
        ret exit.OK;
    }
    val put: err[fs.FsError] = fs.write_bytes(path, bytes.data::*u8, bytes.len, FILE_MODE);
    if (sel put.err) {
        diagnostic.named(call.diag, "cannot write", path);
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}

# the symbols --apart asks to place each in a section of its own, none when it is not given
fun asked_apart(call: *command.Call) res[options.Apart, i64] {
    val asked: res[Slice[str], i64] = flag.collected(call, ?APART);
    if (sel asked.err) { ret res[options.Apart, i64].err{asked.err}; }
    var apart: options.Apart = options.SHARED;
    var i:     usize         = 0;
    for (i < asked.ok.size) {
        val kind: str = asked.ok.data[i];
        if (str_equals(kind, "functions")) { apart.code = true; }
        or (str_equals(kind, "data"))      { apart.data = true; }
        or {
            diagnostic.named(call.diag, "not a kind of symbol to place apart, functions or data", kind);
            ret res[options.Apart, i64].err{exit.REFUSED};
        }
        i = i + 1;
    }
    ret res[options.Apart, i64].ok{apart};
}

# report a failed compilation: a target no family serves, a build opt
# refuses to open, a module a pass or a stage refuses and a module holding an
# opcode its target's family does not serve are refused input, and anything
# else is internal
fun failed(call: *command.Call, m: *module.Module, t: *Target, added: Slice[str], e: family.Error) i64 {
    if (sel e.unserved) {
        diagnostic.headline(call.diag, nil, "no family serves the target's declarations");
        ret exit.REFUSED;
    }
    or (sel e.several) {
        diagnostic.headline(call.diag, nil, "more than one family admits the target's declarations");
        ret exit.INTERNAL;
    }
    or (sel e.schedule) { ret build.failed(call, m, e.schedule); }
    or (sel e.register) { ret refused(call, m, e.register); }
    or (sel e.wasm)     { ret refused_wasm(call, m, e.wasm); }
    or (sel e.spirv)    { ret refused_spirv(call, m, e.spirv); }
    or (sel e.timing)   { ret timed(call, m, e.timing); }
    or (sel e.alloc) {
        diagnostic.headline(call.diag, nil, "the allocator refused storage");
        ret exit.INTERNAL;
    }
    or (sel e.format || sel e.link || sel e.write) { ret unwritten(call, e); }
    or (sel e.output) {
        diagnostic.headline(call.diag, nil, "the target's family writes relocatable objects alone, which a link makes an image of");
        ret exit.REFUSED;
    }
    or (sel e.open)       { ret build.unopened(call, t, added, e.open); }
    or (sel e.foreign)    { ret build.foreign(call, "the module holds an opcode the target's family does not serve", e.foreign, exit.REFUSED); }
    or (sel e.introduced) { ret build.foreign(call, "the schedule left an opcode the target's family does not serve", e.introduced, exit.INTERNAL); }
}

# report a module the back end refused: a function a stage refuses, a target
# mirl carries no machine for, code emission refuses and a relocation the
# object's format does not map are refused input, and a function a stage
# leaves invalid and anything else is internal
fun refused(call: *command.Call, m: *module.Module, failed: mcompile.Failed) i64 {
    val c: mcompile.Error = failed.error;
    if (sel failed.function.some) {
        val fn: id.Function = failed.function.some;
        if (sel c.widening) { ret widened(call, m, fn, c.widening); }
        val f: View = module.name_of(m, m.functions.data[fn].data.name);
        if (sel c.timing) {
            val found: timing.Error = c.timing;
            ret timed(call, m, mct.refused(fn, mct.Where.instruction{found.instruction}, found.refusal, failed.location));
        }
        if (sel c.verify) {
            diagnostic.headline(call.diag, nil, "a stage left a function invalid");
            diagnostic.source(call.diag, m, failed.location);
            diagnostic.symbol(call.diag, f);
            ret exit.INTERNAL;
        }
        diagnostic.headline(call.diag, nil, "a stage refused a function");
        diagnostic.source(call.diag, m, failed.location);
        diagnostic.symbol(call.diag, f);
        staged(call, m, fn, failed);
        ret exit.REFUSED;
    }
    if (sel c.walked) {
        val unmet: mct.Error = c.walked;
        if (sel unmet.refused)      { ret timed(call, m, unmet.refused); }
        if (sel unmet.unfollowed)   { ret unfollowed(call, m, unmet.unfollowed); }
        if (sel unmet.stale)        { ret stale(call, m, unmet.stale); }
        if (sel unmet.unguaranteed) { ret unguaranteed(call, m, unmet.unguaranteed); }
    }
    if (sel c.uncarried) {
        diagnostic.headline(call.diag, nil, "mirl carries no selection table for the target's instruction set");
        ret exit.REFUSED;
    }
    if (sel c.emit) {
        val handed_over: opt[i64] = handed(call, m, c.emit);
        if (sel handed_over.some) { ret handed_over.some; }
        val placed_global: opt[i64] = misplaced(call, m, c.emit);
        if (sel placed_global.some) { ret placed_global.some; }
        if (sel c.emit.section) {
            val named: id.Symbol = c.emit.section;
            if (sel named.function) { ret unsectioned(call, m, named.function); }
        }
        if (sel c.emit.unmapped) { ret unmapped(call, m, c.emit.unmapped); }
        if (sel c.emit.export)   { ret unexported(call, m, c.emit.export); }
        if (sel c.emit.builder) {
            var why: opt[Fail] = opt[Fail].none{};
            if (sel c.emit.builder.detail.object) { why = opt[Fail].some{c.emit.builder.detail.object}; }
            ret unmade(call, "the object was not made, as masc refused the module", opt[str].some{c.emit.builder.message}, why, exit.INTERNAL);
        }
        if (sel c.emit.lowering) { ret unmade(call, "the object was not made, as mink states no registration of its format", opt[str].none{}, opt[Fail].some{c.emit.lowering}, exit.INTERNAL); }
        if (sel c.emit.listing)  { ret unlistable(call, m, c.emit.listing); }
    }
    if (sel c.table) {
        if (sel c.table.table) {
            diagnostic.lead(call.diag, nil);
            format.write_str(call.diag, "the module was not compiled, as the target's selection table breaks its schema at ");
            if (c.table.table.constant) { format.write_str(call.diag, "materialisation "); }
            format.write_str(call.diag, "rule ");
            format.write_u64(call.diag, c.table.table.rule::u64);
            format.write_str(call.diag, ", a ");
            format.write_str(call.diag, c.table.table.what);
            format.write_str(call.diag, "\n");
            ret exit.INTERNAL;
        }
        if (sel c.table.breached) {
            val b: engine.Breached = c.table.breached;
            diagnostic.lead(call.diag, nil);
            format.write_str(call.diag, "the module was not compiled, as the loop '");
            format.write_str(call.diag, b.loop.name);
            format.write_str(call.diag, "' of the target's selection table breaks its constraint, as ");
            format.write_str(call.diag, breach(b.breach));
            format.write_str(call.diag, "\n");
            ret exit.INTERNAL;
        }
        diagnostic.lead(call.diag, nil);
        format.write_str(call.diag, "the module was not compiled, as selection refused the target's table: ");
        format.write_str(call.diag, unselected(c.table));
        format.write_str(call.diag, "\n");
        ret exit.INTERNAL;
    }
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the module was not compiled, as ");
    format.write_str(call.diag, uncompiled(c));
    format.write_str(call.diag, "\n");
    ret exit.INTERNAL;
}

# report the extensions a function admits past the build's that were not
# opened: a name the target's instruction set does not know and names whose
# closure conflicts are refused input, and anything else is internal
fun widened(call: *command.Call, m: *module.Module, fn: id.Function, e: target_basis.Error) i64 {
    val f: View = module.name_of(m, m.functions.data[fn].data.name);
    diagnostic.lead(call.diag, nil);
    if (sel e.named) {
        format.write_str(call.diag, "the instruction set of the target knows no extension named '");
        diagnostic.view(call.diag, e.named);
        format.write_str(call.diag, "', which a function admits\n");
        diagnostic.symbol(call.diag, f);
        ret exit.REFUSED;
    }
    format.write_str(call.diag, "the extensions a function admits past the build's were not opened, as ");
    format.write_str(call.diag, target_basis.fact(e));
    format.write_str(call.diag, "\n");
    diagnostic.symbol(call.diag, f);
    if (sel e.extensions) { ret exit.REFUSED; }
    ret exit.INTERNAL;
}

# report an instruction emission cannot hand over: why, the function, where
# the instruction was built for, and the instruction and operand. it is
# refused input, and none when emission refused anything else
fun handed(call: *command.Call, m: *module.Module, e: handover.Error) opt[i64] {
    val held: opt[handover.At] = instruction_at(e);
    if (sel held.none) { ret opt[i64].none{}; }
    val at: handover.At = held.some;
    diagnostic.headline(call.diag, nil, "emission cannot hand an instruction over");
    diagnostic.source(call.diag, m, at.location);
    function_name(call, m, at.function);
    if (sel e.inline) {
        format.write_str(call.diag, "  = why: masc refused an inline assembly block with its operands placed: ");
        format.write_str(call.diag, e.inline.message);
        format.write_str(call.diag, "\n");
    }
    or { diagnostic.tagged(call.diag, "why", reason(e)); }
    format.write_str(call.diag, "  = at: instruction ");
    format.write_u64(call.diag, at.at::u64);
    format.write_str(call.diag, " of the code");
    if (at.operand != handover.NO_OPERAND) {
        format.write_str(call.diag, ", operand ");
        format.write_u64(call.diag, at.operand::u64);
    }
    format.write_str(call.diag, "\n");
    ret opt[i64].some{exit.REFUSED};
}

# the instruction emission cannot hand over, none when it refused anything
# else
fun instruction_at(e: handover.Error) opt[handover.At] {
    if (sel e.inline)    { ret opt[handover.At].some{e.inline.at}; }
    if (sel e.pseudo)    { ret opt[handover.At].some{e.pseudo}; }
    if (sel e.unplaced)  { ret opt[handover.At].some{e.unplaced}; }
    if (sel e.cell)      { ret opt[handover.At].some{e.cell}; }
    if (sel e.shape)     { ret opt[handover.At].some{e.shape}; }
    if (sel e.unbound)   { ret opt[handover.At].some{e.unbound}; }
    if (sel e.ambiguous) { ret opt[handover.At].some{e.ambiguous}; }
    if (sel e.label)     { ret opt[handover.At].some{e.label}; }
    if (sel e.span)      { ret opt[handover.At].some{e.span}; }
    if (sel e.fact)      { ret opt[handover.At].some{e.fact}; }
    if (sel e.table)     { ret opt[handover.At].some{e.table}; }
    ret opt[handover.At].none{};
}

# why emission cannot hand an instruction over
fun reason(e: handover.Error) str {
    if (sel e.pseudo)    { ret "a pseudo-instruction or loop no stage expanded, which encodes to nothing"; }
    if (sel e.unplaced)  { ret "a virtual register or a frame slot, which allocation and the frame replace"; }
    if (sel e.cell)      { ret "a location of a memory-backed class, which no register machine holds in an object"; }
    if (sel e.shape)     { ret "an operand of a kind its position does not take, or a list longer than an instruction keeps room for"; }
    if (sel e.unbound)   { ret "a relocation kind the instruction set binds no fixup kind to"; }
    if (sel e.ambiguous) { ret "a relocation kind the instruction set binds several fixup kinds to, none the operand's own"; }
    if (sel e.label)     { ret "a label two instructions hold, or inside a sequence, or a partner naming a label no instruction holds"; }
    if (sel e.span)      { ret "a relocation covering more instructions than the block has after it"; }
    if (sel e.fact)      { ret "a call frame fact at an instruction layout left in no block"; }
    ret "a jump table on a target that states no address model or no pointer";
}

# report a global emission cannot place: the global and its fault. it is
# refused input, and none when emission refused anything else
fun misplaced(call: *command.Call, m: *module.Module, e: handover.Error) opt[i64] {
    val held: opt[id.Global] = global_of(e);
    if (sel held.none) { ret opt[i64].none{}; }
    val g: id.Global = held.some;
    diagnostic.headline(call.diag, nil, "emission cannot place a global");
    if (g::usize < m.globals.len) { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[g].data.name)); }
    diagnostic.tagged(call.diag, "why", fault(e));
    ret opt[i64].some{exit.REFUSED};
}

# the global emission cannot place, none when it refused anything else
fun global_of(e: handover.Error) opt[id.Global] {
    if (sel e.contents) { ret opt[id.Global].some{e.contents.global}; }
    if (sel e.model)    { ret opt[id.Global].some{e.model}; }
    if (sel e.layout)   { ret opt[id.Global].some{e.layout.global}; }
    if (sel e.width)    { ret opt[id.Global].some{e.width}; }
    if (sel e.section) {
        val named: id.Symbol = e.section;
        if (sel named.global) { ret opt[id.Global].some{named.global}; }
    }
    ret opt[id.Global].none{};
}

# why emission cannot place a global
fun fault(e: handover.Error) str {
    if (sel e.contents) { ret "the module refused a read of its initial value"; }
    if (sel e.model)    { ret "its initial value holds an address and the target states no address model"; }
    if (sel e.section)  { ret "it names a section a function or another global names with another kind"; }
    if (sel e.layout)   { ret "the data layout gives its type or a part of its initial value no extent"; }
    ret "an address in its initial value is wider than any datum masc relocates";
}

# report a function whose section a global or another function names with another kind. it is refused input
fun unsectioned(call: *command.Call, m: *module.Module, f: id.Function) i64 {
    diagnostic.headline(call.diag, nil, "emission cannot place a function");
    if (f::usize < m.functions.len) { diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[f].data.name)); }
    diagnostic.tagged(call.diag, "why", "it names a section a global or another function names with another kind");
    ret exit.REFUSED;
}

# the step a function was refused at and what refused it, under its headline
fun staged(call: *command.Call, m: *module.Module, fn: id.Function, f: mcompile.Failed) {
    format.write_str(call.diag, "  = ");
    if (sel f.step.some) {
        format.write_str(call.diag, "at the step '");
        format.write_str(call.diag, f.step.some);
        format.write_str(call.diag, "', ");
    }
    format.write_str(call.diag, stage(f.error));
    val s: mcompile.Error = f.error;
    if (sel s.select) {
        if (sel s.select.machine) {
            if (sel s.select.machine.refused) {
                format.write_str(call.diag, ", a ");
                format.write_str(call.diag, s.select.machine.refused.what);
            }
        }
    }
    if (sel s.select) {
        if (sel s.select.assembly) {
            val r: minline.Error = s.select.assembly.refusal;
            if (sel r.parsed) {
                format.write_str(call.diag, ": ");
                format.write_str(call.diag, r.parsed);
            }
            if (sel r.head) {
                format.write_str(call.diag, ": ");
                format.write_str(call.diag, thead.fact(r.head));
            }
        }
    }
    format.write_str(call.diag, "\n");
    if (sel s.select) {
        if (sel s.select.unmatched) { unmatched(call, m, fn, s.select.unmatched); }
        if (sel s.select.misaligned) {
            var p: printer.Printer = printer.init(call.diag, m);
            fin { printer.dnit(?p); }
            format.write_str(call.diag, "  = type: ");
            printer.ty(?p, s.select.misaligned);
            format.write_str(call.diag, "\n");
        }
    }
}

# the operation no rule matched, `= operation: ...`, its opcode and the types
# of its operands and results, and where it stands in its function,
# `= at: ...`
fun unmatched(call: *command.Call, m: *module.Module, f: id.Function, u: engine.Unmatched) {
    var p: printer.Printer = printer.init(call.diag, m);
    fin { printer.dnit(?p); }
    var held: engine.Unmatched = u;
    format.write_str(call.diag, "  = operation: ");
    if (sel u.operation.opcode) {
        val row: opt[*irow.Row] = opcode_table.at(u.operation.opcode);
        if (sel row.some) { format.write_str(call.diag, row.some.name); }
        or                { format.write_str(call.diag, "an opcode with no row"); }
        format.write_str(call.diag, " ");
        typed(?p, Slice[Type]{data: ?held.operands[0], size: $length_of(irow.Operands)}, u.operand_count);
        format.write_str(call.diag, " -> ");
        typed(?p, Slice[Type]{data: ?held.results[0], size: $length_of(irow.Results)}, u.result_count);
    }
    or {
        format.write_str(call.diag, "a constant of ");
        printer.ty(?p, u.operands[0]);
        format.write_str(call.diag, " to materialise");
    }
    format.write_str(call.diag, "\n  = at: ");
    placed(call, m, f, u.instruction);
    format.write_str(call.diag, "\n");
}

# a parenthesised list of count types, of which selection kept the first
# kept.size, `...` standing for the rest
fun typed(p: *printer.Printer, kept: Slice[Type], count: u32) {
    format.write_str(p.w, "(");
    var k: usize = 0;
    for (k < count::usize && k < kept.size) {
        if (k > 0) { format.write_str(p.w, ", "); }
        printer.ty(p, kept.data[k]);
        k = k + 1;
    }
    if (count::usize > kept.size) { format.write_str(p.w, ", ..."); }
    format.write_str(p.w, ")");
}

# where an instruction stands in its function: its place in its block and
# the block's name or index when it is placed, then its index in the body
fun placed(call: *command.Call, m: *module.Module, f: id.Function, i: id.Instruction) {
    val got: res[*function.Body, module.Error] = module.body(m, f);
    if (sel got.ok) {
        val b: *function.Body = got.ok;
        if (i::usize < b.instructions.len) {
            val place: instruction.Place = b.instructions.data[i].place;
            if (sel place.placed) {
                val k:    id.Block   = place.placed;
                val held: *BlockData = ?b.blocks.data[k];
                var at:   usize      = 0;
                for (at < held.instructions.len && held.instructions.data[at] != i) { at = at + 1; }
                format.write_str(call.diag, "instruction ");
                format.write_u64(call.diag, at::u64);
                format.write_str(call.diag, " of block ");
                val name: opt[View] = held.name;
                if (sel name.some) {
                    format.write_str(call.diag, "^");
                    diagnostic.view(call.diag, name.some);
                }
                or { format.write_u64(call.diag, k::u64); }
                format.write_str(call.diag, ", ");
            }
        }
    }
    format.write_str(call.diag, "instruction ");
    format.write_u64(call.diag, i::u64);
    format.write_str(call.diag, " of the body");
}

# what refused a function
fun stage(s: mcompile.Error) str {
    if (sel s.select)   { ret unselected(s.select); }
    if (sel s.effects)  { ret "what its instructions read and write was not read"; }
    if (sel s.pointer)  { ret "the frame's need of a pointer was not read"; }
    if (sel s.allowed)  { ret "the locations the allocator may assign were not listed"; }
    if (sel s.allocate) { ret unallocated(s.allocate); }
    if (sel s.frame) {
        val e: finish.Error = s.frame;
        if (sel e.lay)        { ret "its frame was not laid out"; }
        if (sel e.code)       { ret framed(e.code); }
        if (sel e.made)       { ret "a register, slot or block of its frame was not made"; }
        if (sel e.operand)    { ret "a dynamic allocation of its frame names a register past the file"; }
        if (sel e.dropped)    { ret "an instruction names a slot the frame's layout dropped"; }
        if (sel e.unnumbered) { ret "a register a call frame rule names has no dwarf column under the build"; }
        if (sel e.scavenge)   { ret "the emergency slots its frame needs were not counted"; }
        ret "a call frame rule stands at an offset that scales";
    }
    if (sel s.copies) {
        ret uncopied(s.copies);
    }
    if (sel s.configure)  { ret "the states its instructions run under were not established"; }
    if (sel s.loops)      { ret "its loops were not expanded into their steps"; }
    if (sel s.layout)     { ret "its blocks were not laid out"; }
    if (sel s.ranges)     { ret "where its variables are was not read"; }
    if (sel s.verify)     { ret "the verifier refused it after the step"; }
    if (sel s.watched)    { ret "the watch of the compilation refused it"; }
    if (sel s.misplaced)  { ret "the step reads a form of it the steps before did not leave"; }
    if (sel s.unfinished) { ret "the steps ended before it was laid out"; }
    ret "it or a call it makes is under a convention row other than the target's default";
}

# why register allocation refused a function
fun unallocated(e: allocate.Error) str {
    if (sel e.alloc)   { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.foreign) { ret "register allocation refused it: its locations are of another register file than the function's"; }
    if (sel e.clobber) { ret "register allocation refused it: a clobber names an instruction or a set the function does not have"; }
    if (sel e.form)    { ret unformed(e.form); }
    if (sel e.live)    { ret unlive(e.live); }
    if (sel e.scan)    { ret unscanned(e.scan); }
    if (sel e.rewrite) { ret unrewritten(e.rewrite); }
    if (sel e.check)   { ret unchecked_allocation(e.check); }
    ret "register allocation refused it: a value of a class never spilled would be carried in pieces";
}

# why a round's virtual form was not built
fun unformed(e: spill.Error) str {
    if (sel e.alloc)   { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.refused) { ret "register allocation refused it: the function's maker refused a spill, reload or copy"; }
    if (sel e.class)   { ret "register allocation refused it: a value in pieces of a class the target's locations do not have"; }
    ret "register allocation refused it: a value in pieces whose class's storage no slot states";
}

# why liveness was refused
fun unlive(e: live.Error) str {
    if (sel e.alloc)     { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.foreign)   { ret "register allocation refused it: its locations are of another register file than the function's"; }
    if (sel e.unlocated) { ret "register allocation refused it, at liveness: an effect register or a clobber the locations do not number"; }
    if (sel e.refused)   { ret "register allocation refused it, at liveness: an operand names a register or cell the locations refused"; }
    if (sel e.conflict)  { ret "register allocation refused it, at liveness: two values held in one location at one position"; }
    if (sel e.ungrouped) { ret "register allocation refused it, at liveness: an instruction whose grouping is refused"; }
    if (sel e.undecided) { ret "register allocation refused it, at liveness: an instruction whose footprint masc leaves undecided"; }
    ret "register allocation refused it, at liveness: its positions do not fit";
}

# why a round's scan was refused
fun unscanned(e: scan.Error) str {
    if (sel e.alloc)       { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.pinned)      { ret "register allocation refused it, scan pinned: an operand pinned to a location the target does not let the allocator assign"; }
    if (sel e.stuck)       { ret "register allocation refused it, scan stuck: values no location holds and no split helps"; }
    if (sel e.unlocated)   { ret "register allocation refused it, scan unlocated: a register a copy names that the locations refused"; }
    if (sel e.constrained) { ret "register allocation refused it, scan constrained: no location of a value's class stands under its instruction's constraints"; }
    ret "register allocation refused it, scan grouped: a value of a list's registers would be carried other than whole";
}

# why the rewrite of an allocated function was refused
fun unrewritten(e: rewrite.Error) str {
    if (sel e.alloc)      { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.refused)    { ret "register allocation refused it, at rewrite: the function's maker refused a rewritten instruction"; }
    if (sel e.unassigned) { ret "register allocation refused it, at rewrite: an operand names a value with no location"; }
    ret "register allocation refused it, at rewrite: an operand names a value through a view its location holds no register of";
}

# why the checker refused a checked allocation
fun unchecked_allocation(e: check.Error) str {
    if (sel e.alloc)      { ret "register allocation refused it: the allocator refused storage"; }
    if (sel e.live)       { ret unlive(e.live); }
    if (sel e.count)      { ret "the allocation checker refused it: it assigns another number of values than the form's"; }
    if (sel e.unassigned) { ret "the allocation checker refused it: a live value with no location"; }
    if (sel e.outside)    { ret "the allocation checker refused it: a value at a location the target does not allow"; }
    if (sel e.class)      { ret "the allocation checker refused it: a value at a location outside its class"; }
    if (sel e.meet)       { ret "the allocation checker refused it: two values in storage one location shares at one position"; }
    if (sel e.unpinned)   { ret "the allocation checker refused it: a pinned read or write outside the location its row fixes"; }
    if (sel e.shape)      { ret "the allocation checker refused it: a rewritten instruction that is not the form's"; }
    ret "the allocation checker refused it: a rewritten instruction breaks its row's register constraints";
}

# why a function's copies were not lowered to the set's moves
fun uncopied(e: lower.Error) str {
    if (sel e.alloc)     { ret "its copies were not lowered: the allocator refused storage"; }
    if (sel e.live)      { ret "its copies were not lowered: liveness of the framed function was refused"; }
    if (sel e.made)      { ret "its copies were not lowered: the function's maker refused an instruction"; }
    if (sel e.code)      { ret framed(e.code); }
    if (sel e.unlocated) { ret "its copies were not lowered: a register the frame or the convention names has no location"; }
    ret unlowered(e);
}

# why one copy was not lowered
fun unlowered(r: lower.Error) str {
    if (sel r.operand)    { ret "its copies were not lowered, operand: a copy names an operand that is no register, cell or slot"; }
    if (sel r.label)      { ret "its copies were not lowered, label: a partner names a copy, which may make no instruction"; }
    if (sel r.implied)    { ret "its copies were not lowered, implied: a copy states locations beyond its operands"; }
    if (sel r.twice)      { ret "its copies were not lowered, twice: two pairs of a copy write one storage"; }
    if (sel r.unmoved)    { ret "its copies were not lowered, unmoved: the set states no move for a pair, directly or through a register"; }
    if (sel r.scratch)    { ret "its copies were not lowered, scratch: a pair of memory locations with no free location to go through"; }
    if (sel r.sizes)      { ret "its copies were not lowered, sizes: a pair of memory locations of different sizes"; }
    if (sel r.cycle)      { ret "its copies were not lowered, cycle: a cycle with no free location to break it and no swap"; }
    if (sel r.dropped)    { ret "its copies were not lowered, dropped: a copy names a slot the frame dropped"; }
    if (sel r.unnumbered) { ret "its copies were not lowered, unnumbered: a copy names a register or cell the locations refused"; }
    ret "its copies were not lowered, constrained: no free location stands under every instruction of the moves through it";
}

# why the target's frame code refused a move of a function's frame
fun framed(r: code.Error) str {
    if (sel r.alloc)       { ret "the allocator refused storage to the target's frame code"; }
    if (sel r.foreign)     { ret "the target's frame code names a class of no row of the selection's file"; }
    if (sel r.twice)       { ret "the target's frame code admits two loads or stores of one class and one storage"; }
    if (sel r.reach)       { ret "the target's frame code reaches no slot at an offset of the frame"; }
    if (sel r.scaled)      { ret "the target's frame code forms no offset per unit of a scale of the frame"; }
    if (sel r.mask)        { ret "the target's frame code masks to no alignment of the frame"; }
    if (sel r.access)      { ret "the target's frame code has no load or store of a register the frame moves"; }
    if (sel r.unadmitted)  { ret "the target's frame code moves through a row the selection does not admit"; }
    if (sel r.made)        { ret "the function's maker refused an instruction of the frame code"; }
    if (sel r.constrained) { ret "an instruction of the frame code breaks its row's register constraints"; }
    if (sel r.unpaired)    { ret "the target's frame code moves two registers in no one instruction"; }
    if (sel r.unreserved)  { ret "the frame has no emergency slot left of the kind of a register it saves"; }
    if (sel r.unleft)      { ret "the function returns through a routine the target's frame code leaves through none of"; }
    if (sel r.unpushed)    { ret "the target's frame code pushes or pops no register the frame saves by a push"; }
    ret "the frame moves through a probe routine the target's frame code makes none of";
}

# how a loop's body breaks its constraint
fun breach(b: lrow.Breach) str {
    if (sel b.long)   { ret "it holds more instructions than the limit"; }
    if (sel b.opened) { ret "it does not open with the load of the reserved pair"; }
    if (sel b.access) { ret "a step touches memory other than as its atomic access, or a second time"; }
    if (sel b.stored) { ret "it holds no store of the pair, or no swap"; }
    if (sel b.row)    { ret "a step needs an extension past the plain ones, or serialises"; }
    if (sel b.branch) { ret "a step transfers control other than by a conditional branch"; }
    ret "it branches back to its start before the store or the swap, or twice";
}

# the fact selection refused a target's table on
fun unselected(e: engine.Error) str {
    if (sel e.alloc)      { ret "the allocator refused storage"; }
    if (sel e.module)     { ret "the module refused a read"; }
    if (sel e.types)      { ret "the type table refused a read"; }
    if (sel e.unmatched)  { ret "no rule matches an operation"; }
    if (sel e.unheld)     { ret "no class the build meets holds a value of a type"; }
    if (sel e.ambiguous)  { ret "more than one class the build meets holds a value of a type"; }
    if (sel e.reach)      { ret "a type the target reaches has no class or two in the table"; }
    if (sel e.removed)    { ret "a value's definition was removed"; }
    if (sel e.machine)    { ret "the machine form refused an instruction the table built"; }
    if (sel e.aggregate)  { ret "a value of an aggregate type, which no register holds"; }
    if (sel e.unlocated)  { ret "a register a call clobbers has no location"; }
    if (sel e.placed)     { ret "a piece stands at a place selection does not carry"; }
    if (sel e.transfer)   { ret "a piece form instruction neither calls nor returns"; }
    if (sel e.lookup)     { ret "the target's thread lookup function is not named"; }
    if (sel e.cell)       { ret "the target's thread-local index cell is not declared"; }
    if (sel e.layout)     { ret "the target's layout gives no size for a slot's type"; }
    if (sel e.unplaced)   { ret "a function's entry has parameters the abi legalisation did not place"; }
    if (sel e.undecided)  { ret "an instruction's transfer turns on an operand that names no register yet"; }
    if (sel e.unchecked)  { ret "a division stands with no test of the trap it gives a result for"; }
    if (sel e.breached)   { ret "a loop of the table breaks the constraint its body keeps"; }
    if (sel e.assembly)   { ret assembled(e.assembly.refusal); }
    if (sel e.naked)      { ret "a naked function holds an instruction other than an inline assembly block that binds nothing or an unreachable"; }
    if (sel e.switched)   { ret e.switched.why; }
    if (sel e.misaligned) { ret "a load or store states an alignment below its type's own, which the target does not carry out"; }
    ret "the table breaks its schema";
}

# why selection refused an inline assembly block
fun assembled(r: minline.Error) str {
    if (sel r.alloc)    { ret "the allocator refused storage"; }
    if (sel r.parsed)   { ret "masc refused an inline assembly block"; }
    if (sel r.head)     { ret "masc refused the selection of an inline assembly block"; }
    if (sel r.returns)  { ret "an inline assembly block may return from its function, which would skip its epilogue"; }
    if (sel r.operands) { ret "an inline assembly block binds more operands than one block may"; }
    if (sel r.class)    { ret "an inline assembly block binds an operand in another class than its constraint's"; }
    ret "an inline assembly block binds an address as an immediate, which the machine form carries no relocation for yet";
}

# why the module's debug records were not stated on the object
fun debugging(e: records.Error) str {
    if (sel e.alloc)   { ret "the allocator refused storage while the debug records were stated"; }
    if (sel e.object)  { ret "mink refused a debug record or its name"; }
    if (sel e.table)   { ret "the debug records could not read the module's debug table"; }
    if (sel e.module)  { ret "the debug records could not read the module"; }
    if (sel e.layout)  { ret "the layout gave a type of the debug table no size or offset"; }
    if (sel e.refused) { ret "dwarf does not write a variable's location"; }
    if (sel e.number)  { ret "masc's dwarf column numbers no register a variable's location names"; }
    ret "a label the debug records name has no place or symbol in the object";
}

# the step a module was not compiled at and the fact it failed on, for a
# refusal `refused` reports no more closely
fun uncompiled(c: mcompile.Error) str {
    if (sel c.alloc)     { ret "the allocator refused storage"; }
    if (sel c.foreign)   { ret "the build was opened for another target than the one given"; }
    if (sel c.locations) { ret "the locations of the target's registers and memories were not numbered"; }
    if (sel c.table)     { ret "selection refused the target's table"; }
    if (sel c.moves)     { ret "the instruction set's moves were not indexed for the target"; }
    if (sel c.code)      { ret "the frame code was not bound to the target's selection"; }
    if (sel c.machine)   { ret "the machine form text was not printed"; }
    if (sel c.write)     { ret "the listing was not written"; }
    if (sel c.emit) {
        val e: handover.Error = c.emit;
        if (sel e.alloc)      { ret "the allocator refused storage while the object was made"; }
        if (sel e.symbol)     { ret "an instruction names a symbol the module does not have"; }
        if (sel e.convention) { ret "the target states no calling convention, so its objects follow no psabi row"; }
        if (sel e.abi)        { ret "the convention names no psabi row of mink's catalog for the architecture"; }
        if (sel e.fill)       { ret "the target's code fill is not one byte repeated, which masc's alignment takes"; }
        if (sel e.dialect)    { ret "masc states no assembly dialect of the object format, which the listing is written in"; }
        if (sel e.listing)    { ret "masc refused to list the object it made"; }
        if (sel e.debug)      { ret debugging(e.debug); }
        if (sel e.lowering)   { ret "mink states no registration of the object's format"; }
        if (sel e.export)     { ret "the object refused to export a symbol the module marks exported"; }
    }
    ret "the back end refused it";
}

# report a module the webassembly back end refused: what wasm has no form of
# yet, a global another module defines in a final module, an address the
# table has no slot of, an address no relocation writes and a constant-time
# function whose code holds a secret where none may be are refused input, and
# anything else is internal
fun refused_wasm(call: *command.Call, m: *module.Module, e: wasm_error.Error) i64 {
    if (sel e.unselected) {
        diagnostic.headline(call.diag, nil, "an instruction webassembly has no form of yet");
        diagnostic.source(call.diag, m, e.unselected.location);
        diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[e.unselected.function].data.name));
        ret exit.REFUSED;
    }
    if (sel e.assembly) {
        diagnostic.named(call.diag, "an inline assembly block webassembly refused", e.assembly.message);
        diagnostic.source(call.diag, m, e.assembly.at.location);
        diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[e.assembly.at.function].data.name));
        ret exit.REFUSED;
    }
    if (sel e.threads) {
        diagnostic.headline(call.diag, nil, "an atomic access on a build that runs threads, which reach no atomic yet");
        diagnostic.source(call.diag, m, e.threads.location);
        diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[e.threads.function].data.name));
        ret exit.REFUSED;
    }
    if (sel e.unvalued) {
        diagnostic.headline(call.diag, nil, "a value of a type no webassembly value type holds");
        ret exit.REFUSED;
    }
    if (sel e.offset) {
        diagnostic.headline(call.diag, nil, "the address of a function at an offset, which its table index has none of");
        diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[e.offset].data.name));
        ret exit.REFUSED;
    }
    if (sel e.width) {
        diagnostic.headline(call.diag, nil, "an address in an initial value of a width no webassembly relocation writes");
        diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[e.width].data.name));
        ret exit.REFUSED;
    }
    if (sel e.timing)       { ret timed(call, m, e.timing); }
    if (sel e.unfollowed)   { ret unfollowed(call, m, e.unfollowed); }
    if (sel e.stale)        { ret stale(call, m, e.stale); }
    if (sel e.unguaranteed) { ret unguaranteed(call, m, e.unguaranteed); }
    if (sel e.placement) {
        diagnostic.headline(call.diag, nil, "a signature the convention does not place");
        ret exit.REFUSED;
    }
    if (sel e.encoding) {
        diagnostic.named(call.diag, "masc refused the module", e.encoding.message);
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "the module was not compiled");
    ret exit.INTERNAL;
}

fun function_name(call: *command.Call, m: *module.Module, f: id.Function) {
    if (f::usize < m.functions.len) { diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[f].data.name)); }
}

# report why the spir-v back end refused a module: what spir-v or the build
# cannot hold is refused input, named by its function or global, and anything
# else is internal
fun refused_spirv(call: *command.Call, m: *module.Module, e: spirv_error.Error) i64 {
    if (sel e.unselected) {
        diagnostic.headline(call.diag, nil, "an instruction spir-v has no form of yet");
        diagnostic.source(call.diag, m, e.unselected.location);
        function_name(call, m, e.unselected.function);
        ret exit.REFUSED;
    }
    if (sel e.untyped) {
        diagnostic.headline(call.diag, nil, "a type spir-v holds no value of here");
        ret exit.REFUSED;
    }
    if (sel e.unpointed) {
        diagnostic.headline(call.diag, nil, "a pointer parameter whose pointee no use states");
        diagnostic.source(call.diag, m, e.unpointed.location);
        function_name(call, m, e.unpointed.function);
        ret exit.REFUSED;
    }
    if (sel e.reinterpreted) {
        diagnostic.headline(call.diag, nil, "an access that reinterprets memory, which logical addressing cannot");
        diagnostic.source(call.diag, m, e.reinterpreted.location);
        function_name(call, m, e.reinterpreted.function);
        ret exit.REFUSED;
    }
    if (sel e.variable) {
        diagnostic.headline(call.diag, nil, "a pointer chosen at run time, which logical addressing reaches only through variable pointers");
        diagnostic.source(call.diag, m, e.variable.location);
        function_name(call, m, e.variable.function);
        ret exit.REFUSED;
    }
    if (sel e.storage) {
        diagnostic.headline(call.diag, nil, "a global used in another storage class than its own, or one its class holds no value of");
        diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[e.storage].data.name));
        ret exit.REFUSED;
    }
    if (sel e.slot) {
        diagnostic.headline(call.diag, nil, "a stack slot whose pointer is not into the Function storage class");
        diagnostic.source(call.diag, m, e.slot.location);
        function_name(call, m, e.slot.function);
        ret exit.REFUSED;
    }
    if (sel e.entry) {
        diagnostic.headline(call.diag, nil, "an entry point that takes or returns a value, or has no body");
        function_name(call, m, e.entry);
        ret exit.REFUSED;
    }
    if (sel e.workgroup) {
        diagnostic.headline(call.diag, nil, "a workgroup dimension named by no 32-bit integer specialization constant of the module");
        function_name(call, m, e.workgroup);
        ret exit.REFUSED;
    }
    if (sel e.imported) {
        diagnostic.headline(call.diag, nil, "an image that imports what no other object defines for it");
        if (sel e.imported.function) { function_name(call, m, e.imported.function); }
        if (sel e.imported.global)   { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[e.imported.global].data.name)); }
        ret exit.REFUSED;
    }
    if (sel e.replaceable) {
        diagnostic.headline(call.diag, nil, "a linkage unit that defines a replaceable symbol, which spir-v has no form of");
        if (sel e.replaceable.function) { function_name(call, m, e.replaceable.function); }
        if (sel e.replaceable.global)   { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[e.replaceable.global].data.name)); }
        ret exit.REFUSED;
    }
    if (sel e.unmet) {
        diagnostic.named(call.diag, "the module needs what the build's selection does not hold", e.unmet);
        ret exit.REFUSED;
    }
    if (sel e.unstructured) {
        diagnostic.headline(call.diag, nil, "a function whose structure the emitter cannot follow");
        function_name(call, m, e.unstructured);
        ret exit.INTERNAL;
    }
    if (sel e.encoding) {
        diagnostic.named(call.diag, "masc refused the module", e.encoding.message);
        ret exit.INTERNAL;
    }
    if (sel e.builder) {
        diagnostic.named(call.diag, "masc refused the module", e.builder.message);
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "the module was not compiled");
    ret exit.INTERNAL;
}

# report a function refused as constant time: masc's one wording of the
# refusal, the function, where in its code it stands and the unchecked callee
# a secret reached where the call names one. it is refused input
fun timed(call: *command.Call, m: *module.Module, r: mct.Refused) i64 {
    var words: vector.Vector[u8] = vector.init[u8](call.a);
    fin { vector.dnit[u8](?words); }
    var held:    masc_ct.Refusal = r.refusal;
    val spelled: err[A.Error]    = mct.spell(?held, ?words);
    diagnostic.lead(call.diag, nil);
    if (sel spelled.err) { format.write_str(call.diag, masc_ct.message(?held)); }
    or                   { diagnostic.view(call.diag, View{data: words.data, len: words.len}); }
    format.write_str(call.diag, "\n");
    diagnostic.source(call.diag, m, r.location);
    diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[r.function].data.name));
    located(call, r.at);
    val callee: opt[id.Function] = r.callee;
    if (sel callee.some) {
        format.write_str(call.diag, "  = callee: @");
        diagnostic.view(call.diag, module.name_of(m, m.functions.data[callee.some].data.name));
        format.write_str(call.diag, "\n");
    }
    ret exit.REFUSED;
}

# where in a function's code a constant-time refusal stands, `= at: ...`
fun located(call: *command.Call, at: mct.Where) {
    if (sel at.whole) { ret; }
    format.write_str(call.diag, "  = at: ");
    if (sel at.instruction) {
        format.write_str(call.diag, "instruction ");
        format.write_u64(call.diag, at.instruction::u64);
    }
    if (sel at.offset) {
        format.write_str(call.diag, "byte ");
        format.write_u64(call.diag, at.offset);
        format.write_str(call.diag, " of its code");
    }
    format.write_str(call.diag, "\n");
}

# report a constant-time function whose code the walk could not follow on a
# set that classifies its rows, so the requirement is not met. it is refused
# input
fun unfollowed(call: *command.Call, m: *module.Module, u: mct.Unfollowed) i64 {
    diagnostic.headline(call.diag, nil, "constant time required of code the walk of its instructions could not follow");
    diagnostic.tagged(call.diag, "why", u.unread.message);
    diagnostic.source(call.diag, m, u.location);
    diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[u.function].data.name));
    located(call, mct.Where.offset{u.unread.offset});
    ret exit.REFUSED;
}

# report a hard constant-time function whose code needs a timing mode the build does not guarantee, naming the
# feature that would guarantee it, or a set that guarantees no instruction's timing. it is refused input
fun unguaranteed(call: *command.Call, m: *module.Module, u: mct.Unguaranteed) i64 {
    diagnostic.headline(call.diag, nil, "hard constant time required of code the build's target does not guarantee the timing of");
    diagnostic.source(call.diag, m, u.location);
    diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[u.function].data.name));
    if (u.needs == mct.NO_NEEDS) {
        format.write_str(call.diag, "  = the target's instruction set guarantees no instruction's timing\n");
        ret exit.REFUSED;
    }
    var words: vector.Vector[u8] = vector.init[u8](call.a);
    fin { vector.dnit[u8](?words); }
    val spelled: err[A.Error] = mct.missing(u.set, u.needs, ?words);
    format.write_str(call.diag, "  = missing: ");
    if (sel spelled.err) { format.write_str(call.diag, "a timing mode"); }
    or                   { diagnostic.view(call.diag, View{data: words.data, len: words.len}); }
    format.write_str(call.diag, "\n");
    ret exit.REFUSED;
}

# report a constant-time function whose own frame reads a slot no store reaches first, which its walk would take as
# public: the function and the slot's alloca, by its instruction and the name of its address where it has one. it is
# refused input
fun stale(call: *command.Call, m: *module.Module, s: mct.Stale) i64 {
    diagnostic.headline(call.diag, nil, "constant time required of a function whose own frame reads a slot no store reaches first");
    diagnostic.source(call.diag, m, s.location);
    diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[s.function].data.name));
    located(call, s.at);
    if (sel s.at.instruction) {
        val b: *function.Body               = ?m.functions.data[s.function].body;
        val d: *instruction.InstructionData = ?b.instructions.data[s.at.instruction::usize];
        if (d.results.len > 0) {
            val name: opt[View] = b.values.data[d.results.data[0]].name;
            if (sel name.some) {
                format.write_str(call.diag, "  = slot: ");
                diagnostic.view(call.diag, name.some);
                format.write_str(call.diag, "\n");
            }
        }
    }
    ret exit.REFUSED;
}

# report a relocation the target's object format does not map: the module
# needs what the target cannot write, so it is refused input, named by the
# symbol it aims at and by mink's failure, which names the kind and the format
fun unmapped(call: *command.Call, m: *module.Module, u: handover.Unmapped) i64 {
    diagnostic.headline(call.diag, nil, "the target's object format maps no relocation of a kind the module needs");
    if (sel u.symbol.some) {
        val s: id.Symbol = u.symbol.some;
        if (sel s.function) { diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[s.function].data.name)); }
        or (sel s.global)   { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[s.global].data.name)); }
    }
    if (sel u.refusal.detail.object) { diagnostic.failure(call.diag, call.a, u.refusal.detail.object); }
    ret exit.REFUSED;
}

# report an object masc refused to list, which is internal: the construct the
# listing has no form of, in masc's words, the function or global it is about,
# where in the object it was found, and the printer's refusal when an
# instruction's values have no spelling
fun unlistable(call: *command.Call, m: *module.Module, u: handover.Unlisted) i64 {
    diagnostic.named(call.diag, "masc refused to list the object it made", u.refusal.failure.text);
    if (sel u.symbol.some) {
        val s: id.Symbol = u.symbol.some;
        if (sel s.function) { diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[s.function].data.name)); }
        or (sel s.global)   { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[s.global].data.name)); }
    }
    if (u.refusal.failure.at.indexed)  { diagnostic.placed(call.diag, u.refusal.failure.at.index::u32, u.refusal.failure.at.offset); }
    if (u.refusal.failure.cite != nil) { diagnostic.tagged(call.diag, "spelling", u.refusal.failure.cite); }
    ret exit.INTERNAL;
}

# report a symbol the module marks exported that the object refused to export,
# which is internal, as the export states nothing past its symbol and name
fun unexported(call: *command.Call, m: *module.Module, u: handover.Unexported) i64 {
    diagnostic.headline(call.diag, nil, "the object refused to export a symbol the module marks exported");
    val s: id.Symbol = u.symbol;
    if (sel s.function)     { diagnostic.symbol(call.diag, module.name_of(m, m.functions.data[s.function].data.name)); }
    or (sel s.global)       { diagnostic.symbol(call.diag, module.name_of(m, m.globals.data[s.global].data.name)); }
    if (sel u.failure.some) { diagnostic.failure(call.diag, call.a, u.failure.some); }
    ret exit.INTERNAL;
}

# report an object masc or mink did not make or write, the one report every
# such refusal goes through: its headline, masc's message where masc refused
# it, and mink's failure where mink refused it, so no refusal is reported
# without what refused it
fun unmade(call: *command.Call, headline: str, message: opt[str], why: opt[Fail], code: i64) i64 {
    diagnostic.headline(call.diag, nil, headline);
    if (sel message.some) { diagnostic.tagged(call.diag, "masc", message.some); }
    if (sel why.some)     { diagnostic.failure(call.diag, call.a, why.some); }
    ret code;
}

# report an object that was not written, each cause by what refused it: a
# format mink refused the object in is named by mink's failure,
# refused input where the format has no form for what the module states, as a
# protected symbol in mach-o, and internal otherwise, and output that took only part of the bytes says how many it took
fun unwritten(call: *command.Call, e: family.Error) i64 {
    val none: opt[str] = opt[str].none{};
    if (sel e.link) {
        val f:    Fail = e.link;
        var code: i64  = exit.INTERNAL;
        if (sel f.cause.unsupported || sel f.cause.malformed) { code = exit.REFUSED; }
        ret unmade(call, "the image was not written, as mink's link refused the object", none, opt[Fail].some{f}, code);
    }
    if (sel e.format) {
        val f:    Fail = e.format;
        var code: i64  = exit.INTERNAL;
        if (sel f.cause.unsupported) { code = exit.REFUSED; }
        ret unmade(call, "the object was not written, as mink refused it in the format of the target's system", none, opt[Fail].some{f}, code);
    }
    val code: i64 = unmade(call, "the object was not written, as the output took only part of its bytes", none, opt[Fail].none{}, exit.ENVIRONMENT);
    if (!(sel e.write)) { ret code; }
    val w: io.WriteError = e.write;
    if (sel w.native) {
        format.write_str(call.diag, "  = written: ");
        format.write_u64(call.diag, w.native.written::u64);
        format.write_str(call.diag, " bytes\n");
    }
    ret code;
}
