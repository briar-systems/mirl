# `mirl opt <file>`: parse the text, run the pass pipeline over it for a target
# at a level, and print the result

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use T:  std.allocator.testing;
use fs: std.filesystem;
use io: std.io.writer;

use verify_cmd: mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.source;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.item;
use mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
#[testing]
use mirl.legal.check_test.Text;
#[testing]
use mirl.legal.check_test.view;
#[testing]
use mirl.legal.helper_test.product;
use mirl.pass;
use mirl.slice;
use mirl.target;
use mirl.target.Target;
use mirl.target.capability.Condition;
use mirl.target.machine;
use mirl.target.machine.Build;
use mirl.target.machine.Machine;
use A: std.allocator;
use std.args;
use std.collections.slice.Slice;
use std.format;

use masc.core.extension;
use mset: masc.core.set;

# the flag that names the target, the module's own when it is not given
pub val TARGET: args.Flag = args.Flag{name: "--target", short: nil, kind: args.VALUE, negatable: false, repeat: true, value: "name", doc: "the target to run the pipeline for, a row of mirl.target, by default the one the module names"};

# the flag that picks the optimisation level
pub val LEVEL: args.Flag = args.Flag{name: "--level", short: nil, kind: args.VALUE, negatable: false, repeat: true, value: "0-3", doc: "the optimisation level, 2 by default"};

# the flag that names an extension the build adds to the target's baseline,
# given once for each
pub val EXTENSION: args.Flag = args.Flag{name: "--extension", short: nil, kind: args.VALUE, negatable: false, repeat: true, value: "name", doc: "an extension to add to the target's baseline, as its instruction set names it, given once for each"};

# the flag rows the command takes
pub val FLAGS: [4]*args.Flag = [4]*args.Flag{?TARGET, ?LEVEL, ?EXTENSION, ?source.BODY};

# the command row
pub val COMMAND: command.Command = command.Command{name: "opt", summary: "run the pass pipeline over a file and print the result", usage: "opt <file> [options]", file: true, flags: ?FLAGS[0], flag_n: 4, run: handle};

# the level a --level value names, none for anything but one digit from 0 to 3
fun level_of(s: str) opt[pass.Level] {
    if (s == nil)                                    { ret opt[pass.Level].some{2}; }
    if (str_len(s) != 1 || s[0] < '0' || s[0] > '3') { ret opt[pass.Level].none{}; }
    ret opt[pass.Level].some{(s[0] - '0')::pass.Level};
}

# the level the command line asks for, none when it names none, which is reported
pub fun asked_level(call: *command.Call) opt[pass.Level] {
    val l: opt[pass.Level] = level_of(args.value(call.reader, ?LEVEL));
    if (sel l.none) { diagnostic.named(call.diag, "not a level from 0 to 3", args.value(call.reader, ?LEVEL)); }
    ret l;
}

# the target the command line asks for, or the module names, none when no row
# of mirl.target is that target, which is reported
pub fun asked_target(call: *command.Call, m: *module.Module) opt[*Target] {
    var name:  View = module.target(m);
    val asked: str  = args.value(call.reader, ?TARGET);
    if (asked != nil) { name = View{data: asked, len: str_len(asked)}; }
    val t: opt[*Target] = target.by_name(name);
    if (sel t.none) {
        if (asked != nil) { diagnostic.named(call.diag, "no target of mirl.target is named", asked); }
        or                { diagnostic.headline(call.diag, nil, "no target of mirl.target is the one the module names"); }
    }
    ret t;
}

# the extensions the command line adds to the target's baseline, in its order
# ---
# call: the command's context
# ret:  the names, or the exit code of the failure to hold them
pub fun asked_extensions(call: *command.Call) res[Slice[str], i64] {
    val got: res[Slice[str], A.Error] = command.values(call.a, call, ?EXTENSION);
    if (sel got.err) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret res[Slice[str], i64].err{exit.INTERNAL};
    }
    ret res[Slice[str], i64].ok{got.ok};
}

# report a build whose machine was not opened, and the exit code: an extension
# the instruction set does not know, extensions added to a target with no
# baseline and added extensions that conflict are refused input, and anything
# else is an internal failure
# ---
# call:  the command's context
# t:     the target the build opened
# added: the extensions the build added
# e:     why the machine was not opened
pub fun unopened(call: *command.Call, t: *Target, added: Slice[str], e: machine.Error) i64 {
    if (sel e.unknown) {
        diagnostic.named(call.diag, "the instruction set of the target knows no extension named", e.unknown);
        ret exit.REFUSED;
    }
    if (sel e.baseline && added.size > 0) {
        diagnostic.named(call.diag, "extensions are added to a target that states no baseline", t.name);
        ret exit.REFUSED;
    }
    if (sel e.extensions) {
        if (sel e.extensions.conflict) {
            if (added.size > 0) { ret conflicting(call, t, e.extensions.conflict); }
        }
    }
    diagnostic.named(call.diag, "the machine of the target was not made", t.name);
    ret exit.INTERNAL;
}

# report two added extensions the selection cannot hold together, by their
# names in the target's instruction set, as refused input
fun conflicting(call: *command.Call, t: *Target, pair: extension.Conflict) i64 {
    val set: res[*mset.Set, machine.Error] = machine.set_of(t);
    if (sel set.err) {
        diagnostic.named(call.diag, "the machine of the target was not made", t.name);
        ret exit.INTERNAL;
    }
    val c: *extension.Catalog = set.ok.extensions;
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the extensions '");
    format.write_str(call.diag, c.extensions[pair.a].name);
    format.write_str(call.diag, "' and '");
    format.write_str(call.diag, c.extensions[pair.b].name);
    format.write_str(call.diag, "' cannot be selected together\n");
    ret exit.REFUSED;
}

fun handle(call: *command.Call) i64 {
    val level: opt[pass.Level] = asked_level(call);
    if (sel level.none) { ret exit.REFUSED; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = asked_target(call, ?m);
    if (sel t.none) { ret exit.REFUSED; }

    val added: res[Slice[str], i64] = asked_extensions(call);
    if (sel added.err) { ret added.err; }

    # the build's one machine, opened here and handed to every pass
    var mc:   Machine;
    val held: res[Build, machine.Error] = machine.build(?mc, call.a, t.some, added.ok);
    if (sel held.err) { ret unopened(call, t.some, added.ok, held.err); }
    fin { machine.release(held.ok); }

    val ran: err[pass.Error] = pass.run(?m, t.some, held.ok, pass.Options{level: level.some, checked: false});
    if (sel ran.err) { ret failed(call, ran.err); }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print(?w, ?m);
    if (sel printed.err) {
        diagnostic.headline(call.diag, nil, "cannot print the module");
        ret exit.INTERNAL;
    }
    val bytes: View               = sink.view(?s);
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, "cannot write the output");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# report a failed run: a module the verifier refuses and a pass that cannot
# rewrite the module are refused input, and anything else is an internal failure
# of the pipeline
pub fun failed(call: *command.Call, e: pass.Error) i64 {
    if (sel e.input) { ret verify_cmd.refused(call, e.input); }
    if (sel e.refused) {
        diagnostic.named(call.diag, "a pass refused the module", e.refused.pass);
        ret exit.REFUSED;
    }
    if (sel e.unverified) {
        diagnostic.named(call.diag, "a pass left the module invalid", e.unverified.pass);
        ret exit.INTERNAL;
    }
    if (sel e.foreign) {
        diagnostic.headline(call.diag, nil, "the machine was opened for another target than the run's");
        ret exit.INTERNAL;
    }
    if (sel e.schedule) {
        diagnostic.headline(call.diag, nil, "the pass schedule is malformed");
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "out of memory");
    ret exit.INTERNAL;
}

# what one run of the command line gave
# ---
# code: the exit code
# out:  the output
# diag: the diagnostics
#[testing]
rec Ran {
    code: i64;
    out:  sink.Sink;
    diag: sink.Sink;
}

# write a product for the target to a path and run `mirl opt` over it with one
# extension added. the run's sinks are made first, whatever the run gives
#[testing]
fun run(a: *A.Allocator, t: *Target, path: str, extension: str, text: *Text, ran: *Ran) err[fs.FsError] {
    ran.out  = sink.init(a);
    ran.diag = sink.init(a);
    text.len = 0;
    product(text, t);
    val dir: err[fs.FsError] = fs.create_dir_all(a, "out", 0o755);
    if (sel dir.err) { ret dir; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?text.data[0], text.len, 0o644);
    if (sel wrote.err) { ret wrote; }
    var out:  io.Writer                           = sink.writer(?ran.out);
    var diag: io.Writer                           = sink.writer(?ran.diag);
    var argv: [6]*u8                              = [6]*u8{"mirl", "opt", path, "--body", "--extension", extension};
    val read: res[command.Reading, command.Error] = command.read(a, ?COMMAND, args.of(6, ?argv[0]));
    if (sel read.err) {
        ran.code = -1;
        ret err[fs.FsError].ok{};
    }
    var call: command.Call = command.call_of(a, read.ok, ?out, ?diag, command.CommandSet{rows: nil, n: 0});
    ran.code = handle(?call);
    ret err[fs.FsError].ok{};
}

# the extension the multiply of a target's baseline waits for, added on the
# command line, keeps the multiply where the baseline alone calls a helper
test opt__an_added_extension_reaches_the_output {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    val row: opt[*Target] = target.first(target.multiplies_when_added);
    if (sel row.none) { ret 2; }
    val cond: Condition = row.some.caps.arithmetic.multiplied;
    if (!(sel cond.extension)) { ret 2; }
    var text: Text;
    var ran:  Ran;
    fin {
        sink.dnit(?ran.out);
        sink.dnit(?ran.diag);
    }
    val done: err[fs.FsError] = run(a, row.some, "out/opt_test_added.mirl", cond.extension, ?text, ?ran);
    if (sel done.err)        { ret 3; }
    if (ran.code != exit.OK) { ret 4; }
    val got: res[Module, Refusal] = parse.parse(a, sink.view(?ran.out));
    if (sel got.err) { ret 5; }
    var m: Module = got.ok;
    fin { module.dnit(?m); }
    val want: res[Module, Refusal] = parse.parse_body(a, view(?text));
    if (sel want.err) { ret 6; }
    var w: Module = want.ok;
    fin { module.dnit(?w); }
    val same: res[bool, printer.Error] = equal.same(?m, ?w);
    if (sel same.err) { ret 7; }
    if (!same.ok)     { ret 8; }
    ret 0;
}

# an extension the target's instruction set does not know is refused input, by its name
test opt__an_unknown_extension_is_refused_by_name {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    val row: opt[*Target] = target.first(target.multiplies_when_added);
    if (sel row.none) { ret 2; }
    var text: Text;
    var ran:  Ran;
    fin {
        sink.dnit(?ran.out);
        sink.dnit(?ran.diag);
    }
    val done: err[fs.FsError] = run(a, row.some, "out/opt_test_unknown.mirl", "no_such_extension", ?text, ?ran);
    if (sel done.err)             { ret 3; }
    if (ran.code != exit.REFUSED) { ret 4; }
    val want: str = "error: the instruction set of the target knows no extension named 'no_such_extension'\n";
    if (!slice.same_view(sink.view(?ran.diag), View{data: want, len: str_len(want)})) { ret 5; }
    ret 0;
}
