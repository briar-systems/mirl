# `mirl opt <file>`: parse the text, run the pass pipeline over it for a target
# at a level, and print the result

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use io: std.io.writer;

use verify_cmd: mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mct: mirl.ct;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.module;
use mirl.ir.text.equal;
use mirl.ir.text.item;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use mirl.pass;
use pass_failure: mirl.pass.failure;
use mirl.pass.relaxation;
use mirl.target;
use mirl.target.Target;
use mirl.target.basis;
use mirl.target.families;
use mirl.target.family;
use verify_failure: mirl.verify.failure;
use A:              std.allocator;
use std.args;
use std.collections.slice.Slice;
use std.collections.vector;
use std.format;

use masc.core.ct;
use masc.core.extension;
use masc.core.requirement;
use mset: masc.core.set;

# the flag that names the target, the module's own when it is not given
pub val TARGET: args.Flag = args.Flag{name: "--target", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.override{}, value: "arch,sys,env,abi,isa", doc: "the target to run the pipeline for, assembled from this tuple, each part as its owner spells it and none empty, the isa everything after the fourth comma, the environment `none` for a system run under none, by default the one the module names"};

# the flag that picks the optimisation level
pub val LEVEL: args.Flag = args.Flag{name: "--level", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.override{}, value: "0-3", doc: "the optimisation level, 2 by default"};

# the flag that names an extension the build adds to the target's baseline,
# given once for each
pub val EXT: args.Flag = args.Flag{name: "--ext", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "an extension to add to the target's isa, as its instruction set names it, given once for each"};

# the flag that names a float relaxation the build permits, given once for
# each, by its name in mirl.pass.relaxation
pub val FLOAT_RELAX: args.Flag = args.Flag{name: "--float-relax", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "a float relaxation the build permits, float-reassoc for reassociating float sums and products, given once for each, none by default"};

# the flag rows the command takes
pub val FLAGS: [5]*args.Flag = [5]*args.Flag{?TARGET, ?LEVEL, ?EXT, ?FLOAT_RELAX, ?source.BODY};

# the command row
pub val COMMAND: command.Command = command.Command{name: "opt", summary: "run the pass pipeline over a file and print the result", usage: "opt <file> [options]", file: true, flags: ?FLAGS[0], flag_n: $length_of(FLAGS), run: handle};

# the level a --level value names, none for anything but one digit from 0 to 3
fun level_of(s: str) opt[pass.Level] {
    if (s == nil)                                    { ret opt[pass.Level].some{2}; }
    if (str_len(s) != 1 || s[0] < '0' || s[0] > '3') { ret opt[pass.Level].none{}; }
    ret opt[pass.Level].some{(s[0] - '0')::pass.Level};
}

# the level the command line asks for, by the last --level given
# ---
# call: the command's context
# ret:  the level, or the exit code of a value that names none, which is reported
pub fun asked_level(call: *command.Call) res[pass.Level, i64] {
    val asked: res[str, i64] = flag.value(call, ?LEVEL);
    if (sel asked.err) { ret res[pass.Level, i64].err{asked.err}; }
    val l: opt[pass.Level] = level_of(asked.ok);
    if (sel l.none) {
        diagnostic.named(call.diag, "not a level from 0 to 3", asked.ok);
        ret res[pass.Level, i64].err{exit.REFUSED};
    }
    ret res[pass.Level, i64].ok{l.some};
}

# the target the command line asks for by the last --target given, or the
# module names, assembled from its tuple
# ---
# call: the command's context
# m:    the module, whose target stands when the line names none
# ret:  the target, given back by `target.release` through the command's
#       allocator, or the exit code when the tuple assembles to none, which
#       is reported with the rule it breaks
pub fun asked_target(call: *command.Call, m: *module.Module) res[Target, i64] {
    val asked: res[str, i64] = flag.value(call, ?TARGET);
    if (sel asked.err) { ret res[Target, i64].err{asked.err}; }
    var tuple: module.Tuple = module.target(m);
    if (asked.ok != nil) {
        val parts: opt[module.Tuple] = tuple_of(asked.ok);
        if (sel parts.none) {
            diagnostic.named(call.diag, "a target is five parts, arch,sys,env,abi,isa, not", asked.ok);
            ret res[Target, i64].err{exit.REFUSED};
        }
        tuple = parts.some;
    }
    val made: res[Target, target.Refusal] = target.assemble(call.a, tuple);
    if (sel made.err) {
        if (sel made.err.alloc) {
            diagnostic.headline(call.diag, nil, "the target was not assembled");
            ret res[Target, i64].err{exit.INTERNAL};
        }
        diagnostic.lead(call.diag, nil);
        format.write_str(call.diag, "the target was not assembled, as its tuple breaks the rule that ");
        format.write_str(call.diag, target.rule(made.err));
        if (asked.ok != nil) {
            format.write_str(call.diag, " '");
            format.write_str(call.diag, asked.ok);
            format.write_str(call.diag, "'");
        }
        format.write_str(call.diag, "\n");
        if (sel made.err.requires) {
            var lack: target.Unmet = made.err.requires;
            unmet_lines(call.diag, ?lack);
            target.unmet_release(call.a, ?lack);
        }
        ret res[Target, i64].err{exit.REFUSED};
    }
    ret res[Target, i64].ok{made.ok};
}

# the atoms an unmet requirement names, spelled by the architecture's catalog
fun unmet_atoms(w: *io.Writer, u: *target.Unmet, ids: requirement.Ids) {
    var i: u32 = 0;
    for (i < ids.len) {
        if (i != 0) { format.write_str(w, ", "); }
        val name: opt[str] = target.unmet_name(u, ids.at[i]);
        if (sel name.some) { format.write_str(w, name.some); }
        or                 { format.write_str(w, "an atom the catalog does not name"); }
        i = i + 1;
    }
}

# what the baseline lacks of each alternative the convention requires, the
# nearest first
fun unmet_lines(w: *io.Writer, u: *target.Unmet) {
    val near: opt[usize] = target.nearest(u);
    var i:    usize      = 0;
    for (i < u.alternatives.size) {
        val row: target.Missing = u.alternatives.data[i];
        if (sel near.some && near.some == i) { format.write_str(w, "  the baseline lacks "); }
        or                                   { format.write_str(w, "  or lacks "); }
        if (row.lacks.len != 0)              { unmet_atoms(w, u, row.lacks); }
        if (row.bars.len != 0) {
            if (row.lacks.len != 0) { format.write_str(w, " and "); }
            format.write_str(w, "holds, though barred, ");
            unmet_atoms(w, u, row.bars);
        }
        format.write_str(w, "\n");
        i = i + 1;
    }
}

# the tuple a --target value spells: four parts split at its first four
# commas and the baseline everything after the fourth, as a baseline may be
# a list of extensions, none for a value of fewer than five parts
fun tuple_of(s: str) opt[module.Tuple] {
    var parts: [5]View;
    var count: usize = 0;
    var start: usize = 0;
    val n:     usize = str_len(s);
    var i:     usize = 0;
    for (i < n && count < 4) {
        if (s[i] == ',') {
            parts[count] = View{data: ?s[start], len: i - start};
            count        = count + 1;
            start        = i + 1;
        }
        i = i + 1;
    }
    if (count != 4) { ret opt[module.Tuple].none{}; }
    parts[4] = View{data: ?s[start], len: n - start};
    ret opt[module.Tuple].some{module.Tuple{arch: parts[0], sys: parts[1], env: parts[2], abi: parts[3], isa: parts[4]}};
}

# report a failure that names the target it failed on, by its derived name
fun named_target(call: *command.Call, message: str, t: *Target) {
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, message);
    format.write_str(call.diag, " '");
    target.write_name(call.diag, call.a, t);
    format.write_str(call.diag, "'\n");
}

# the extensions the command line adds to the target's baseline, in its order
# ---
# call: the command's context
# ret:  the names, or the exit code of the failure to read or hold them
pub fun asked_extensions(call: *command.Call) res[Slice[str], i64] {
    ret collected(call, ?EXT);
}

# the float relaxations the command line permits, none when it names none
# ---
# call: the command's context
# ret:  the set, or the exit code of a name no relaxation has or one named
#       twice, which is reported naming it, or of the failure to read them
pub fun asked_floats(call: *command.Call) res[relaxation.Relaxations, i64] {
    val names: res[Slice[str], i64] = collected(call, ?FLOAT_RELAX);
    if (sel names.err) { ret res[relaxation.Relaxations, i64].err{names.err}; }
    val s: res[relaxation.Relaxations, relaxation.Refused] = relaxation.of(names.ok);
    if (sel s.err) {
        val why: relaxation.Refused = s.err;
        if (sel why.unknown) { diagnostic.named(call.diag, "not a float relaxation", why.unknown); }
        or (sel why.twice)   { diagnostic.named(call.diag, "a float relaxation named twice", why.twice); }
        ret res[relaxation.Relaxations, i64].err{exit.REFUSED};
    }
    ret res[relaxation.Relaxations, i64].ok{s.ok};
}

# the values every occurrence of a collected flag gives, in the command
# line's order
fun collected(call: *command.Call, f: *args.Flag) res[Slice[str], i64] {
    val walk: res[args.Values, i64] = flag.values(call, f);
    if (sel walk.err) { ret res[Slice[str], i64].err{walk.err}; }
    var w: args.Values = walk.ok;
    var n: usize       = 0;
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        n = n + 1;
    }
    if (n == 0) { ret res[Slice[str], i64].ok{Slice[str]{data: nil, size: 0}}; }
    val made: res[*str, A.Error] = A.allocate[str](call.a, n);
    if (sel made.err) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret res[Slice[str], i64].err{exit.INTERNAL};
    }
    var got: Slice[str] = Slice[str]{data: made.ok, size: 0};
    w = walk.ok;
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        got.data[got.size] = hit.some.value;
        got.size           = got.size + 1;
    }
    ret res[Slice[str], i64].ok{got};
}

# report a build that was not opened, and the exit code: a target mirl
# carries no convention for, an extension the instruction set does not know,
# extensions added to a target with no baseline and added extensions that
# conflict are refused input, and anything else is an internal failure
# ---
# call:  the command's context
# t:     the target the build opened
# added: the extensions the build added
# e:     why the build was not opened
pub fun unopened(call: *command.Call, t: *Target, added: Slice[str], e: basis.Error) i64 {
    if (sel e.convention) {
        if (sel e.convention.uncarried) {
            named_target(call, "mirl carries no calling convention for the target", t);
            ret exit.REFUSED;
        }
    }
    if (sel e.unknown) {
        diagnostic.named(call.diag, "the instruction set of the target knows no extension named", e.unknown);
        ret exit.REFUSED;
    }
    if (sel e.baseline && added.size > 0) {
        named_target(call, "extensions are added to a target that states no baseline", t);
        ret exit.REFUSED;
    }
    if (sel e.extensions) {
        if (sel e.extensions.conflict) {
            if (added.size > 0) { ret conflicting(call, t, e.extensions.conflict); }
        }
    }
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the build of the target was not opened, as ");
    format.write_str(call.diag, basis.fact(e));
    format.write_str(call.diag, " '");
    target.write_name(call.diag, call.a, t);
    format.write_str(call.diag, "'\n");
    ret exit.INTERNAL;
}

# report a target no one family serves: one no family admits is refused
# input when extensions are added to it, and one several admit is internal
pub fun unserved(call: *command.Call, t: *Target, e: family.Unserved) i64 {
    if (sel e.none) {
        named_target(call, "no family serves the target, so nothing selects the extensions added to it", t);
        ret exit.REFUSED;
    }
    named_target(call, "more than one family admits the target", t);
    ret exit.INTERNAL;
}

# report a schedule that did not run: a build that was not opened, a target
# no one family serves, a registry whose listings give no owners, a module
# holding an opcode its target does not admit, or a failed run
fun unscheduled(call: *command.Call, m: *module.Module, t: *Target, added: Slice[str], e: family.Error) i64 {
    if (sel e.open)       { ret unopened(call, t, added, e.open); }
    or (sel e.unserved)   { ret unserved(call, t, e.unserved); }
    or (sel e.schedule)   { ret failed(call, m, e.schedule); }
    or (sel e.listing)    { ret unlisted(call, e.listing); }
    or (sel e.foreign)    { ret foreign(call, "the module holds an opcode the target's family does not serve", e.foreign, exit.REFUSED); }
    or (sel e.introduced) { ret foreign(call, "the schedule left an opcode the target's family does not serve", e.introduced, exit.INTERNAL); }
    or (sel e.back) {
        diagnostic.headline(call.diag, nil, "a back end ran where only the schedule was asked for");
        ret exit.INTERNAL;
    }
}

# report a registry whose listings give no owners of the opcode rows, which
# is internal
pub fun unlisted(call: *command.Call, e: family.Listing) i64 {
    if (sel e.alloc) { diagnostic.headline(call.diag, nil, "out of memory"); }
    or               { diagnostic.headline(call.diag, nil, "two target families list one opcode row"); }
    ret exit.INTERNAL;
}

# report an instruction whose opcode row the target does not admit, by its
# opcode, with the exit code: refused input when the module held it, and
# internal when the schedule left it
pub fun foreign(call: *command.Call, what: str, f: family.Foreign, code: i64) i64 {
    diagnostic.headline(call.diag, nil, what);
    diagnostic.named(call.diag, "the opcode is", f.row.name);
    ret code;
}

# report two added extensions the selection cannot hold together, by their
# names in the target's instruction set, as refused input
fun conflicting(call: *command.Call, t: *Target, pair: extension.Conflict) i64 {
    val set: res[*mset.Set, basis.Error] = basis.set_of(t);
    if (sel set.err) {
        named_target(call, "the build of the target was not opened", t);
        ret exit.INTERNAL;
    }
    val c: *extension.Catalog = set.ok.extensions;
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the extensions '");
    format.write_str(call.diag, c.extensions[pair.a].name);
    format.write_str(call.diag, "' and '");
    format.write_str(call.diag, c.extensions[pair.b].name);
    format.write_str(call.diag, "' cannot be selected together\n");
    ret exit.REFUSED;
}

fun handle(call: *command.Call) i64 {
    val level: res[pass.Level, i64] = asked_level(call);
    if (sel level.err) { ret level.err; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val t: res[Target, i64] = asked_target(call, ?m);
    if (sel t.err) { ret t.err; }
    var own: Target = t.ok;
    fin { target.release(call.a, ?own); }

    val added: res[Slice[str], i64] = asked_extensions(call);
    if (sel added.err) { ret added.err; }
    val floats: res[relaxation.Relaxations, i64] = asked_floats(call);
    if (sel floats.err) { ret floats.err; }

    # the schedule the target runs, over the build its family opens
    val ran: err[family.Error] = families.optimise(call.a, ?m, ?own, added.ok, pass.Options{level: level.ok, checked: false, floats: floats.ok});
    if (sel ran.err) { ret unscheduled(call, ?m, ?own, added.ok, ran.err); }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print(?w, ?m);
    if (sel printed.err) {
        diagnostic.headline(call.diag, nil, "cannot print the module");
        ret exit.INTERNAL;
    }
    val bytes: View               = sink.view(?s);
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, "cannot write the output");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# report a failed run: a module the verifier refuses and a pass that cannot
# rewrite the module are refused input, and anything else is an internal failure
# of the pipeline
pub fun failed(call: *command.Call, m: *module.Module, e: pass.Error) i64 {
    if (sel e.input) { ret verify_cmd.refused(call, m, e.input); }
    if (sel e.refused) {
        val r: pass_failure.Refusal = e.refused;
        diagnostic.named(call.diag, "a pass refused the module", r.pass);
        if (sel r.why.slot) { diagnostic.source(call.diag, m, r.why.slot.location); }
        val f: opt[Function] = r.function;
        if (sel f.some) {
            if (f.some.index::usize < m.functions.len) { diagnostic.symbol(call.diag, m.functions.data[f.some.index].data.name); }
        }
        why(call, m, r.why);
        ret exit.REFUSED;
    }
    if (sel e.unverified) {
        diagnostic.named(call.diag, "a pass left the module invalid", e.unverified.pass);
        val v: verify_failure.Error = e.unverified.error;
        if (sel v.refused) { verify_cmd.detail(call, m, v.refused); }
        or                 { diagnostic.tagged(call.diag, "why", "the verifier had no storage"); }
        ret exit.INTERNAL;
    }
    if (sel e.foreign) {
        diagnostic.headline(call.diag, nil, "the build was opened for another target than the run's");
        ret exit.INTERNAL;
    }
    if (sel e.schedule) {
        diagnostic.headline(call.diag, nil, "the pass schedule is malformed");
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "out of memory");
    ret exit.INTERNAL;
}

# why a pass refused, `= why: ...`, with what the refusal names
pub fun why(call: *command.Call, m: *module.Module, w: pass_failure.Why) {
    if (sel w.alloc)      { diagnostic.tagged(call.diag, "why", "the allocator refused storage"); }
    or (sel w.ir)         { diagnostic.tagged(call.diag, "why", "the module or a body refused an edit or a read"); }
    or (sel w.cfg)        { diagnostic.tagged(call.diag, "why", "a graph edit or a copy was refused"); }
    or (sel w.build)      { diagnostic.tagged(call.diag, "why", "the builder stopped"); }
    or (sel w.reason)     { diagnostic.tagged(call.diag, "why", w.reason); }
    or (sel w.convention) { diagnostic.tagged(call.diag, "why", "a call, an entry or a return was not classified"); }
    or (sel w.pieces)     { diagnostic.tagged(call.diag, "why", "an assignment is not carried in pieces of the ir"); }
    or (sel w.text) {
        format.write_str(call.diag, "  = why: a function the pass delivers in the text form was not read, at line ");
        format.write_u64(call.diag, w.text.line::u64);
        format.write_str(call.diag, ", column ");
        format.write_u64(call.diag, w.text.column::u64);
        format.write_str(call.diag, " of its text\n");
    }
    or (sel w.timing) {
        var held:  ct.Refusal        = w.timing;
        var words: vector.Vector[u8] = vector.init[u8](call.a);
        fin { vector.dnit[u8](?words); }
        format.write_str(call.diag, "  = why: ");
        val spelled: err[A.Error] = mct.spell(?held, ?words);
        if (sel spelled.err) { format.write_str(call.diag, ct.message(?held)); }
        or                   { diagnostic.view(call.diag, View{data: words.data, len: words.len}); }
        format.write_str(call.diag, "\n");
    }
    or (sel w.condition) { diagnostic.tagged(call.diag, "why", "a capability's condition was not read on the build's machine"); }
    or (sel w.unheld) {
        var p: printer.Printer = printer.init(call.diag, m);
        fin { printer.dnit(?p); }
        format.write_str(call.diag, "  = why: a value of ");
        printer.ty(?p, w.unheld);
        format.write_str(call.diag, ", whose format the target holds no unit for and no legalisation computes yet\n");
    }
    or (sel w.threaded) {
        diagnostic.tagged(call.diag, "why", "a thread-local global on a target whose build runs threads, which reach no thread-local variable yet");
        global_name(call, m, w.threaded);
    }
    or (sel w.indexed) {
        diagnostic.tagged(call.diag, "why", "a thread-local global the target reaches through the runtime's index of the module's block, which no selection forms yet");
        global_name(call, m, w.indexed);
    }
    or (sel w.specialized) {
        format.write_str(call.diag, "  = why: specialization constant ");
        format.write_u64(call.diag, w.specialized.index::u64);
        format.write_str(call.diag, ", on a target that holds none\n");
    }
    or (sel w.slot) {
        format.write_str(call.diag, "  = why: a slot the target holds no pointer in stays in memory, as ");
        format.write_str(call.diag, kept(w.slot.kept));
        format.write_str(call.diag, "\n  = at: instruction ");
        format.write_u64(call.diag, w.slot.slot.index::u64);
        format.write_str(call.diag, " of the body\n");
    }
}

# why a slot stays in memory
fun kept(k: pass_failure.Kept) str {
    if (sel k.escapes)  { ret "its address is used other than by loads and stores at its type"; }
    if (sel k.held)     { ret "a kept or volatile access holds it in memory"; }
    if (sel k.merged)   { ret "the pointers stored to it are merged where paths join, which only variable pointers carry"; }
    if (sel k.unstored) { ret "a load no store reaches, which no pointer stands for"; }
    ret "a load would read a value whose secrecy differs from its own";
}

fun global_name(call: *command.Call, m: *module.Module, g: Global) {
    if (g.index::usize < m.globals.len) { diagnostic.symbol(call.diag, m.globals.data[g.index].data.name); }
}
