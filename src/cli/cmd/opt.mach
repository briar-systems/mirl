# `mirl opt <file>`: parse the text, run the pass pipeline over it for a target
# at a level, and print the result

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use T:  std.allocator.testing;
use fs: std.filesystem;
use io: std.io.writer;

use verify_cmd: mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mirl.ir.function.Body;
use mirl.ir.id;
use mirl.ir.module;
use mirl.ir.module.Module;
use ir: mirl.ir.opcode;
use mirl.ir.text.equal;
use mirl.ir.text.item;
use mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
#[testing]
use mirl.legal.check_test.Text;
#[testing]
use mirl.legal.helper_test.product;
use mirl.pass;
use mirl.slice;
use mirl.target;
use mirl.target.Target;
use mirl.target.basis;
use mirl.target.capability.Condition;
use mirl.target.register.machine;
use mirl.target.register.machine.Build;
use mirl.target.register.machine.Machine;
use A: std.allocator;
use std.args;
use std.collections.slice.Slice;
use std.format;

use masc.core.extension;
use mset: masc.core.set;

# the flag that names the target, the module's own when it is not given
pub val TARGET: args.Flag = args.Flag{name: "--target", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.override{}, value: "arch,system,convention,baseline", doc: "the target to run the pipeline for, the row of mirl.target that is this tuple, each part as its owner spells it and empty where the target carries none, by default the one the module names"};

# the flag that picks the optimisation level
pub val LEVEL: args.Flag = args.Flag{name: "--level", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.override{}, value: "0-3", doc: "the optimisation level, 2 by default"};

# the flag that names an extension the build adds to the target's baseline,
# given once for each
pub val EXTENSION: args.Flag = args.Flag{name: "--extension", short: nil, kind: args.VALUE, negatable: false, occurs: args.Occurs.collect{}, value: "name", doc: "an extension to add to the target's baseline, as its instruction set names it, given once for each"};

# the flag rows the command takes
pub val FLAGS: [4]*args.Flag = [4]*args.Flag{?TARGET, ?LEVEL, ?EXTENSION, ?source.BODY};

# the command row
pub val COMMAND: command.Command = command.Command{name: "opt", summary: "run the pass pipeline over a file and print the result", usage: "opt <file> [options]", file: true, flags: ?FLAGS[0], flag_n: 4, run: handle};

# the level a --level value names, none for anything but one digit from 0 to 3
fun level_of(s: str) opt[pass.Level] {
    if (s == nil)                                    { ret opt[pass.Level].some{2}; }
    if (str_len(s) != 1 || s[0] < '0' || s[0] > '3') { ret opt[pass.Level].none{}; }
    ret opt[pass.Level].some{(s[0] - '0')::pass.Level};
}

# the level the command line asks for, by the last --level given
# ---
# call: the command's context
# ret:  the level, or the exit code of a value that names none, which is reported
pub fun asked_level(call: *command.Call) res[pass.Level, i64] {
    val asked: res[str, i64] = flag.value(call, ?LEVEL);
    if (sel asked.err) { ret res[pass.Level, i64].err{asked.err}; }
    val l: opt[pass.Level] = level_of(asked.ok);
    if (sel l.none) {
        diagnostic.named(call.diag, "not a level from 0 to 3", asked.ok);
        ret res[pass.Level, i64].err{exit.REFUSED};
    }
    ret res[pass.Level, i64].ok{l.some};
}

# the target the command line asks for by the last --target given, or the module names
# ---
# call: the command's context
# m:    the module, whose target stands when the line names none
# ret:  the target, or the exit code when no row of mirl.target is that target, which is reported
pub fun asked_target(call: *command.Call, m: *module.Module) res[*Target, i64] {
    val asked: res[str, i64] = flag.value(call, ?TARGET);
    if (sel asked.err) { ret res[*Target, i64].err{asked.err}; }
    var tuple: module.Tuple = module.target(m);
    if (asked.ok != nil) {
        val parts: opt[module.Tuple] = tuple_of(asked.ok);
        if (sel parts.none) {
            diagnostic.named(call.diag, "a target is four parts, arch,system,convention,baseline, not", asked.ok);
            ret res[*Target, i64].err{exit.REFUSED};
        }
        tuple = parts.some;
    }
    val t: opt[*Target] = target.row_of(tuple);
    if (sel t.none) {
        if (asked.ok != nil) { diagnostic.named(call.diag, "no target of mirl.target is the tuple", asked.ok); }
        or                   { diagnostic.headline(call.diag, nil, "no target of mirl.target is the one the module names"); }
        ret res[*Target, i64].err{exit.REFUSED};
    }
    ret res[*Target, i64].ok{t.some};
}

# the tuple a --target value spells, its four parts split at commas, none
# for a value of another count of parts
fun tuple_of(s: str) opt[module.Tuple] {
    var parts: [4]View;
    var count: usize = 0;
    var start: usize = 0;
    val n:     usize = str_len(s);
    var i:     usize = 0;
    for (i <= n) {
        if (i == n || s[i] == ',') {
            if (count == 4) { ret opt[module.Tuple].none{}; }
            parts[count] = View{data: ?s[start], len: i - start};
            count        = count + 1;
            start        = i + 1;
        }
        i = i + 1;
    }
    if (count != 4) { ret opt[module.Tuple].none{}; }
    ret opt[module.Tuple].some{module.Tuple{arch: parts[0], system: parts[1], convention: parts[2], baseline: parts[3]}};
}

# report a failure that names the target it failed on, by its derived name
fun named_target(call: *command.Call, message: str, t: *Target) {
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, message);
    format.write_str(call.diag, " '");
    target.name(call.diag, t);
    format.write_str(call.diag, "'\n");
}

# the extensions the command line adds to the target's baseline, in its order
# ---
# call: the command's context
# ret:  the names, or the exit code of the failure to read or hold them
pub fun asked_extensions(call: *command.Call) res[Slice[str], i64] {
    val walk: res[args.Values, i64] = flag.values(call, ?EXTENSION);
    if (sel walk.err) { ret res[Slice[str], i64].err{walk.err}; }
    var w: args.Values = walk.ok;
    var n: usize       = 0;
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        n = n + 1;
    }
    if (n == 0) { ret res[Slice[str], i64].ok{Slice[str]{data: nil, size: 0}}; }
    val made: res[*str, A.Error] = A.allocate[str](call.a, n);
    if (sel made.err) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret res[Slice[str], i64].err{exit.INTERNAL};
    }
    var got: Slice[str] = Slice[str]{data: made.ok, size: 0};
    w = walk.ok;
    for {
        val hit: opt[args.Hit] = args.next_value(?w);
        if (sel hit.none) { brk; }
        got.data[got.size] = hit.some.value;
        got.size           = got.size + 1;
    }
    ret res[Slice[str], i64].ok{got};
}

# report a build whose machine was not opened, and the exit code: an extension
# the instruction set does not know, extensions added to a target with no
# baseline and added extensions that conflict are refused input, and anything
# else is an internal failure
# ---
# call:  the command's context
# t:     the target the build opened
# added: the extensions the build added
# e:     why the machine was not opened
pub fun unopened(call: *command.Call, t: *Target, added: Slice[str], e: basis.Error) i64 {
    if (sel e.unknown) {
        diagnostic.named(call.diag, "the instruction set of the target knows no extension named", e.unknown);
        ret exit.REFUSED;
    }
    if (sel e.baseline && added.size > 0) {
        named_target(call, "extensions are added to a target that states no baseline", t);
        ret exit.REFUSED;
    }
    if (sel e.extensions) {
        if (sel e.extensions.conflict) {
            if (added.size > 0) { ret conflicting(call, t, e.extensions.conflict); }
        }
    }
    named_target(call, "the machine of the target was not made", t);
    ret exit.INTERNAL;
}

# report two added extensions the selection cannot hold together, by their
# names in the target's instruction set, as refused input
fun conflicting(call: *command.Call, t: *Target, pair: extension.Conflict) i64 {
    val set: res[*mset.Set, basis.Error] = basis.set_of(t);
    if (sel set.err) {
        named_target(call, "the machine of the target was not made", t);
        ret exit.INTERNAL;
    }
    val c: *extension.Catalog = set.ok.extensions;
    diagnostic.lead(call.diag, nil);
    format.write_str(call.diag, "the extensions '");
    format.write_str(call.diag, c.extensions[pair.a].name);
    format.write_str(call.diag, "' and '");
    format.write_str(call.diag, c.extensions[pair.b].name);
    format.write_str(call.diag, "' cannot be selected together\n");
    ret exit.REFUSED;
}

fun handle(call: *command.Call) i64 {
    val level: res[pass.Level, i64] = asked_level(call);
    if (sel level.err) { ret level.err; }
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val t: res[*Target, i64] = asked_target(call, ?m);
    if (sel t.err) { ret t.err; }

    val added: res[Slice[str], i64] = asked_extensions(call);
    if (sel added.err) { ret added.err; }

    # the build's one machine, opened here and handed to every pass
    var mc:   Machine;
    val held: res[Build, basis.Error] = machine.build(?mc, call.a, t.ok, added.ok);
    if (sel held.err) { ret unopened(call, t.ok, added.ok, held.err); }
    fin { machine.release(held.ok); }

    val ran: err[pass.Error] = pass.run(?m, t.ok, held.ok, pass.Options{level: level.ok, checked: false});
    if (sel ran.err) { ret failed(call, ran.err); }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print(?w, ?m);
    if (sel printed.err) {
        diagnostic.headline(call.diag, nil, "cannot print the module");
        ret exit.INTERNAL;
    }
    val bytes: View               = sink.view(?s);
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, "cannot write the output");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# report a failed run: a module the verifier refuses and a pass that cannot
# rewrite the module are refused input, and anything else is an internal failure
# of the pipeline
pub fun failed(call: *command.Call, e: pass.Error) i64 {
    if (sel e.input) { ret verify_cmd.refused(call, e.input); }
    if (sel e.refused) {
        diagnostic.named(call.diag, "a pass refused the module", e.refused.pass);
        ret exit.REFUSED;
    }
    if (sel e.unverified) {
        diagnostic.named(call.diag, "a pass left the module invalid", e.unverified.pass);
        ret exit.INTERNAL;
    }
    if (sel e.foreign) {
        diagnostic.headline(call.diag, nil, "the machine was opened for another target than the run's");
        ret exit.INTERNAL;
    }
    if (sel e.schedule) {
        diagnostic.headline(call.diag, nil, "the pass schedule is malformed");
        ret exit.INTERNAL;
    }
    diagnostic.headline(call.diag, nil, "out of memory");
    ret exit.INTERNAL;
}

# what one run of the command line gave
# ---
# code: the exit code
# out:  the output
# diag: the diagnostics
#[testing]
rec Ran {
    code: i64;
    out:  sink.Sink;
    diag: sink.Sink;
}

# write a product for the target to a path and run `mirl opt` over it with two
# --extension flags, first then second. the run's sinks are made first, whatever the run gives
#[testing]
fun run(a: *A.Allocator, t: *Target, path: str, first: str, second: str, text: *Text, ran: *Ran) err[fs.FsError] {
    ran.out  = sink.init(a);
    ran.diag = sink.init(a);
    text.len = 0;
    product(text, t);
    val dir: err[fs.FsError] = fs.create_dir_all(a, "out", 0o755);
    if (sel dir.err) { ret dir; }
    val wrote: err[fs.FsError] = fs.write_bytes(path, ?text.data[0], text.len, 0o644);
    if (sel wrote.err) { ret wrote; }
    var out:  io.Writer                           = sink.writer(?ran.out);
    var diag: io.Writer                           = sink.writer(?ran.diag);
    var argv: [8]*u8                              = [8]*u8{"mirl", "opt", path, "--body", "--extension", first, "--extension", second};
    val read: res[command.Reading, command.Error] = command.read(a, ?COMMAND, args.of(8, ?argv[0]));
    if (sel read.err) {
        ran.code = -1;
        ret err[fs.FsError].ok{};
    }
    var call: command.Call = command.call_of(a, read.ok, ?out, ?diag, command.CommandSet{rows: nil, n: 0});
    ran.code = handle(?call);
    ret err[fs.FsError].ok{};
}

# the extension the multiply of a target's baseline waits for, added on the
# command line, keeps the multiply where the baseline alone calls a helper: the
# output holds the one multiply, no call and no helper. it is given twice,
# which adds it once
test opt__an_added_extension_reaches_the_output {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    val row: opt[*Target] = target.first(target.multiplies_when_added);
    if (sel row.none) { ret 2; }
    val cond: Condition = row.some.caps.arithmetic.multiplied;
    if (!(sel cond.extension)) { ret 2; }
    var text: Text;
    var ran:  Ran;
    fin {
        sink.dnit(?ran.out);
        sink.dnit(?ran.diag);
    }
    val done: err[fs.FsError] = run(a, row.some, "out/opt_test_added.mirl", cond.extension, cond.extension, ?text, ?ran);
    if (sel done.err)        { ret 3; }
    if (ran.code != exit.OK) { ret 4; }
    val got: res[Module, Refusal] = parse.parse(a, sink.view(?ran.out));
    if (sel got.err) { ret 5; }
    var m: Module = got.ok;
    fin { module.dnit(?m); }
    # the product's one function, with no helper delivered beside it
    if (m.functions.len != 1) { ret 6; }
    val body: res[*Body, module.Error] = module.body(?m, id.Function{index: 0});
    if (sel body.err) { ret 7; }
    var products: usize = 0;
    var i:        usize = 0;
    for (i < body.ok.instructions.len) {
        val code: u32 = body.ok.instructions.data[i].opcode.index;
        if (code == ir.CALL.index || code == ir.CALL_PLACED.index) { ret 8; }
        if (code == ir.MUL.index)                                  { products = products + 1; }
        i = i + 1;
    }
    if (products != 1) { ret 9; }
    ret 0;
}

# an extension the target's instruction set does not know is refused input, by its
# name, when a known one is given after it
test opt__an_unknown_extension_is_refused_by_name {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:   *A.Allocator = T.allocator_of(?t);
    val row: opt[*Target] = target.first(target.multiplies_when_added);
    if (sel row.none) { ret 2; }
    val cond: Condition = row.some.caps.arithmetic.multiplied;
    if (!(sel cond.extension)) { ret 2; }
    var text: Text;
    var ran:  Ran;
    fin {
        sink.dnit(?ran.out);
        sink.dnit(?ran.diag);
    }
    val done: err[fs.FsError] = run(a, row.some, "out/opt_test_unknown.mirl", "no_such_extension", cond.extension, ?text, ?ran);
    if (sel done.err)             { ret 3; }
    if (ran.code != exit.REFUSED) { ret 4; }
    val want: str = "error: the instruction set of the target knows no extension named 'no_such_extension'\n";
    if (!slice.same_view(sink.view(?ran.diag), View{data: want, len: str_len(want)})) { ret 5; }
    ret 0;
}

# a later --level stands over an earlier one
test opt__a_later_level_overrides_an_earlier_one {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    val a:    *A.Allocator                        = T.allocator_of(?t);
    var argv: [7]*u8                              = [7]*u8{"mirl", "opt", "x.mirl", "--level", "0", "--level", "3"};
    val read: res[command.Reading, command.Error] = command.read(a, ?COMMAND, args.of(7, ?argv[0]));
    if (sel read.err) { ret 2; }
    var out:  sink.Sink = sink.init(a);
    var diag: sink.Sink = sink.init(a);
    fin {
        sink.dnit(?out);
        sink.dnit(?diag);
    }
    var ow:   io.Writer            = sink.writer(?out);
    var dw:   io.Writer            = sink.writer(?diag);
    var call: command.Call         = command.call_of(a, read.ok, ?ow, ?dw, command.CommandSet{rows: nil, n: 0});
    val l:    res[pass.Level, i64] = asked_level(?call);
    if (sel l.err) { ret 3; }
    if (l.ok != 3) { ret 4; }
    ret 0;
}
