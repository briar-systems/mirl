# `mirl fmt <file>`: parse the text and print the module in its canonical
# form, with its comments beside what they were written beside

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.chrono.time.Instant;

use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;
use std.system.os;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.layout;
use mirl.cli.readout;
use mirl.cli.source;
use mirl.failure.text;
use mirl.ir.module;
use mirl.ir.text.item;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use std.args;
use std.collections.slice.Slice;

# the permission bits of a directory the rewrite creates, 0o755
val DIR_MODE: i32 = 493;

# the flag that rewrites the file in place instead of printing it
pub val WRITE: args.Flag = args.Flag{long: "write", short: 0, value: nil, repeat: false, negatable: true, help: "rewrite the file in place"};

# the flags the command reads, in the order help lists them
val FLAGS: [3]*args.Flag = [3]*args.Flag{?command.HELP, ?command.VERBOSE, ?WRITE};

# the command's registration
pub val SPEC: args.Command = args.Command{name: "fmt", aliases: Slice[str]{data: nil, size: 0}, help: "print a module in its canonical form", usage: "<file>", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 3}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 1, operand_max: 1, passthrough: false};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

# with --write, `formatted` and the file, `unchanged` when it was in its canonical form already,
# or `failed` with its one error. the canonical text printed to stdout is the command's output,
# and shares stdout with no result
fun handle(call: *command.Call) i64 {
    var c: command.Closing;
    command.closing(?c);
    val write: bool = args.on(call.p, ?WRITE);
    val code:  i64  = formatted(call, write);
    if (code != exit.OK && write) { command.failed(call, ?c); }
    ret code;
}

fun formatted(call: *command.Call, write: bool) i64 {
    var kept: Notes = notes.init(call.a);
    fin { notes.dnit(?kept); }
    var read:       str                     = nil;
    val res_loaded: res[module.Module, i64] = source.load_noted(call, ?kept, ?read);
    if (sel res_loaded.err) { ret res_loaded.err; }
    var m: module.Module = res_loaded.ok;
    fin { module.dnit(?m); }

    val from_format: opt[Instant] = readout.begin(call.rd, "format");
    var s:           sink.Sink    = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:           io.Writer          = sink.writer(?s);
    val err_printed: err[printer.Error] = item.print_noted(?w, ?m, false, ?kept);
    if (sel err_printed.err) {
        text.headline_because(?call.report, "cannot print the module", printer.describe(err_printed.err));
        if (sel err_printed.err.alloc) { ret exit.ENVIRONMENT; }
        ret exit.INTERNAL;
    }
    readout.end(call.rd, "format", from_format, nil);

    val bytes: View = sink.view(?s);
    if (write) {
        if (canonical(read, bytes)) {
            var t:      layout.Text;
            var fields: [1]layout.Field = [1]layout.Field{layout.Field{key: "time", value: layout.took(?t, readout.elapsed(call.rd))}};
            readout.result(call.rd, layout.UNCHANGED, call.operand, ?fields[0], 1);
            ret exit.OK;
        }
        val from_write: opt[Instant] = readout.begin(call.rd, "write");
        val rewritten:  i64          = rewrite(call, bytes);
        if (rewritten != exit.OK) { ret rewritten; }
        var z: layout.Text;
        readout.end(call.rd, "write", from_write, layout.size(?z, bytes.len::u64));
        readout.result(call.rd, layout.FORMATTED, call.operand, nil, 0);
        ret exit.OK;
    }
    val from_write: opt[Instant]       = readout.begin(call.rd, "write");
    val err_wrote:  err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel err_wrote.err) {
        diagnostic.unwritten_output(?call.report, err_wrote.err);
        ret exit.ENVIRONMENT;
    }
    var z: layout.Text;
    readout.end(call.rd, "write", from_write, layout.size(?z, bytes.len::u64));
    ret exit.OK;
}

# whether the text read is the canonical text already, byte for byte
fun canonical(read: str, bytes: View) bool {
    if (read == nil || str_len(read) != bytes.len) { ret false; }
    var i: usize = 0;
    for (i < bytes.len) {
        if (read[i] != bytes.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# replace the file with the canonical text, keeping its permission bits
fun rewrite(call: *command.Call, bytes: View) i64 {
    val res_metadata: res[fs.Metadata, io_error.Error] = fs.metadata(call.operand);
    if (sel res_metadata.err) {
        text.named_because(?call.report, "cannot inspect", call.operand, os.message(res_metadata.err));
        ret exit.ENVIRONMENT;
    }
    val err_replaced: err[fs.FsError] = fs.replace_bytes_atomic(call.a, call.operand, bytes.data::*u8, bytes.len, res_metadata.ok.mode::i32, DIR_MODE);
    if (sel err_replaced.err) {
        text.named_because(?call.report, "cannot write", call.operand, diagnostic.fs_cause(err_replaced.err));
        if (sel err_replaced.err.alloc) { ret exit.ENVIRONMENT; }
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}
