# `mirl fmt <file>`: parse the text and print the module in its canonical
# form, with its comments beside what they were written beside

use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;
use std.system.os;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mirl.ir.module;
use mirl.ir.text.item;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use std.args;
use std.collections.slice.Slice;

# the permission bits of a directory the rewrite creates, 0o755
val DIR_MODE: i32 = 493;

# the flag that rewrites the file in place instead of printing it
pub val WRITE: args.Flag = args.Flag{long: "write", short: 0, value: nil, repeat: false, negatable: true, help: "rewrite the file in place"};

# the flags the command reads, in the order help lists them
val FLAGS: [2]*args.Flag = [2]*args.Flag{?command.HELP, ?WRITE};

# the command's registration
pub val SPEC: args.Command = args.Command{name: "fmt", aliases: Slice[str]{data: nil, size: 0}, help: "print a module in its canonical form", usage: "<file>", flags: Slice[*args.Flag]{data: ?FLAGS[0], size: 2}, commands: Slice[*args.Command]{data: nil, size: 0}, operand_min: 1, operand_max: 1, passthrough: false};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    var kept: Notes = notes.init(call.a);
    fin { notes.dnit(?kept); }
    val parsed: res[module.Module, i64] = source.parse_noted(call, text.ok, ?kept);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print_noted(?w, ?m, false, ?kept);
    if (sel printed.err) {
        diagnostic.headline_because(call.diag, "cannot print the module", printer.describe(printed.err));
        ret exit.INTERNAL;
    }

    val bytes: View = sink.view(?s);
    if (args.on(call.p, ?WRITE)) {
        ret rewrite(call, bytes);
    }
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.unwritten_output(call.diag, wrote.err);
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}

# replace the file with the canonical text, keeping its permission bits
fun rewrite(call: *command.Call, bytes: View) i64 {
    val md: res[fs.Metadata, io_error.Error] = fs.metadata(call.operand);
    if (sel md.err) {
        diagnostic.named_because(call.diag, "cannot inspect", call.operand, os.message(md.err));
        ret exit.ENVIRONMENT;
    }
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(call.a, call.operand, bytes.data::*u8, bytes.len, md.ok.mode::i32, DIR_MODE);
    if (sel replaced.err) {
        diagnostic.named_because(call.diag, "cannot write", call.operand, diagnostic.fs_cause(replaced.err));
        if (sel replaced.err.alloc) { ret exit.INTERNAL; }
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}
