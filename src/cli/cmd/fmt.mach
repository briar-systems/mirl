# `mirl fmt <file>`: parse the text and print the module in its canonical form

use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;

use mirl.cli.args;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.source;
use mirl.ir.module;
use mirl.ir.text.item;
use mirl.ir.text.printer;
use mirl.ir.text.sink;

# the permission bits of a directory the rewrite creates, 0o755
val DIR_MODE: i32 = 493;

# the option that rewrites the file in place instead of printing it
pub val WRITE: args.Option = args.Option{name: "--write", off: "--no-write", value: "", arity: args.SWITCH, doc: "rewrite the file in place instead of printing it"};

# the option row list the command takes
pub val OPTIONS: [2]*args.Option = [2]*args.Option{?WRITE, ?source.BODY};

# the command row
pub val COMMAND: args.Command = args.Command{name: "fmt", summary: "print a file in its canonical form", usage: "fmt <file> [options]", file: true, options: ?OPTIONS[0], option_n: 2, run: handle};

fun handle(call: *args.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    val parsed: res[module.Module, i64] = source.parse(call, text.ok);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print(?w, ?m);
    if (sel printed.err) {
        diagnostic.headline(call.diag, nil, "cannot print the module");
        ret exit.INTERNAL;
    }

    val bytes: View = sink.view(?s);
    if (args.flag(call.inv, ?WRITE)) {
        ret rewrite(call, bytes);
    }
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, "cannot write the output");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# replace the file with the canonical text, keeping its permission bits
fun rewrite(call: *args.Call, bytes: View) i64 {
    val md: res[fs.Metadata, io_error.Error] = fs.metadata(call.inv.operand);
    if (sel md.err) {
        diagnostic.named(call.diag, "cannot read", call.inv.operand);
        ret exit.INTERNAL;
    }
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(call.a, call.inv.operand, bytes.data::*u8, bytes.len, md.ok.mode::i32, DIR_MODE);
    if (sel replaced.err) {
        diagnostic.named(call.diag, "cannot write", call.inv.operand);
        ret exit.INTERNAL;
    }
    ret exit.OK;
}
