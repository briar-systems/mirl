# `mirl fmt <file>`: parse the text and print the module in its canonical
# form, with its comments beside what they were written beside, and as a
# body again under --body

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.cli.source;
use mirl.ir.module;
use mirl.ir.text.item;
use mirl.ir.text.notes;
use mirl.ir.text.notes.Notes;
use mirl.ir.text.printer;
use mirl.ir.text.sink;
use std.args;

# the permission bits of a directory the rewrite creates, 0o755
val DIR_MODE: i32 = 493;

# the flag that rewrites the file in place instead of printing it
pub val WRITE: args.FlagSpec = args.FlagSpec{name: "--write", value: "", arity: args.ARITY_FLAG, doc: "rewrite the file in place instead of printing it", default: "", negatable: true, occurs: args.Occurs.override{}, alias_of: nil};

# the flag rows of the command's own table
pub val ROWS: [1]*args.FlagSpec = [1]*args.FlagSpec{?WRITE};

# the option tables the command takes, in the order help lists them
val TABLES: [2]args.TableRef = [2]args.TableRef{args.TableRef{rows: ?ROWS[0], n: $length_of(ROWS), accepted: nil, docs: nil}, args.TableRef{rows: ?source.ROWS[0], n: $length_of(source.ROWS), accepted: nil, docs: nil}};

# the command's registration
pub val SPEC: args.CommandSpec = args.CommandSpec{name: "fmt", id: 2, aliases: nil, alias_n: 0, grammar: " <file> [options]", summary: "print a file in its canonical form", effect: "parse the file and print the module in its canonical form, its comments beside what they were written beside", exits: nil, exit_n: 0, terminator: "", tables: ?TABLES[0], table_n: $length_of(TABLES), refused: nil, refused_n: 0, refusal: "", relations: nil, relation_n: 0, constraints: nil, constraint_n: 0, operand_min: 1, operand_max: 1, truncate_at_sep: false, actions: nil, action_n: 0, examples: nil, example_n: 0};

# the command as the program runs it
pub val COMMAND: command.Command = command.Command{spec: ?SPEC, run: handle};

fun handle(call: *command.Call) i64 {
    val text: res[str, i64] = source.text(call);
    if (sel text.err) { ret text.err; }
    var kept: Notes = notes.init(call.a);
    fin { notes.dnit(?kept); }
    val parsed: res[module.Module, i64] = source.parse_noted(call, text.ok, ?kept);
    if (sel parsed.err) { ret parsed.err; }
    var m: module.Module = parsed.ok;
    fin { module.dnit(?m); }
    val body: res[bool, i64] = flag.on(call, ?source.BODY);
    if (sel body.err) { ret body.err; }

    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:       io.Writer          = sink.writer(?s);
    val printed: err[printer.Error] = item.print_noted(?w, ?m, body.ok, ?kept);
    if (sel printed.err) {
        diagnostic.headline(call.diag, nil, "cannot print the module");
        ret exit.INTERNAL;
    }

    val bytes: View           = sink.view(?s);
    val write: res[bool, i64] = flag.on(call, ?WRITE);
    if (sel write.err) { ret write.err; }
    if (write.ok) {
        ret rewrite(call, bytes);
    }
    val wrote: err[io.WriteError] = io.write_all(call.out, bytes.data::*u8, bytes.len);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, "cannot write the output");
        ret exit.INTERNAL;
    }
    ret exit.OK;
}

# replace the file with the canonical text, keeping its permission bits
fun rewrite(call: *command.Call, bytes: View) i64 {
    val md: res[fs.Metadata, io_error.Error] = fs.metadata(call.operand);
    if (sel md.err) {
        diagnostic.named(call.diag, "cannot read", call.operand);
        ret exit.INTERNAL;
    }
    val replaced: err[fs.FsError] = fs.replace_bytes_atomic(call.a, call.operand, bytes.data::*u8, bytes.len, md.ok.mode::i32, DIR_MODE);
    if (sel replaced.err) {
        diagnostic.named(call.diag, "cannot write", call.operand);
        ret exit.INTERNAL;
    }
    ret exit.OK;
}
