# the program's own diagnostics, in mach's shape: a headline, the place it points
# at, and tagged help lines

use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.view.View;

use std.types.error.err;

use A: std.allocator;
use std.args;
use std.format;
use io: std.io.writer;

use mink.base.diag;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;

use ir_debug: mirl.ir.debug;
use mirl.ir.module.Module;

# the lead of a headline, `error[key]: ` or `error: ` when key is nil
# ---
# w:   the writer the diagnostic goes to
# key: the rule or kind the error belongs to, nil for none
pub fun lead(w: *io.Writer, key: str) {
    format.write_str(w, "error");
    if (key != nil) {
        format.write_str(w, "[");
        format.write_str(w, key);
        format.write_str(w, "]");
    }
    format.write_str(w, ": ");
}

# a headline with its message as one string
pub fun headline(w: *io.Writer, key: str, message: str) {
    lead(w, key);
    format.write_str(w, message);
    format.write_str(w, "\n");
}

# the place a diagnostic points at, `--> path:line:column`
pub fun at(w: *io.Writer, path: str, line: u64, column: u64) {
    format.write_str(w, " --> ");
    format.write_str(w, path);
    format.write_str(w, ":");
    format.write_u64(w, line);
    format.write_str(w, ":");
    format.write_u64(w, column);
    format.write_str(w, "\n");
}

# the source place the instruction a refusal names was built for,
# `--> path:line:column`, the column left out when it states none. nothing
# when it states no place
pub fun source(w: *io.Writer, m: *Module, l: opt[ir_debug.Location]) {
    if (sel l.none) { ret; }
    val p: res[ir_debug.Position, ir_debug.Error] = ir_debug.position(?m.debug, l.some);
    if (sel p.err) { ret; }
    val path: res[View, ir_debug.Error] = ir_debug.path(?m.debug, p.ok.file);
    if (sel path.err) { ret; }
    format.write_str(w, " --> ");
    view(w, path.ok);
    format.write_str(w, ":");
    format.write_u64(w, p.ok.line::u64);
    if (p.ok.column > 0) {
        format.write_str(w, ":");
        format.write_u64(w, p.ok.column::u64);
    }
    format.write_str(w, "\n");
}

# the file a diagnostic points at, when no line within it is named
pub fun in_file(w: *io.Writer, path: str) {
    format.write_str(w, " --> ");
    format.write_str(w, path);
    format.write_str(w, "\n");
}

# a tagged help line under a diagnostic
pub fun tagged(w: *io.Writer, tag: str, text: str) {
    format.write_str(w, "  = ");
    format.write_str(w, tag);
    format.write_str(w, ": ");
    format.write_str(w, text);
    format.write_str(w, "\n");
}

# a view of the text written as it is
pub fun view(w: *io.Writer, v: View) {
    format.write_bytes(w, v.data::*u8, v.len);
}

# the hint that names where a usage error is explained
fun hint(w: *io.Writer, name: str) {
    format.write_str(w, "  = help: run 'mirl ");
    if (name == nil) {
        format.write_str(w, "help");
    }
    or {
        format.write_str(w, name);
        format.write_str(w, " --help");
    }
    format.write_str(w, "' for the options\n");
}

# a command line std.args refused, in std's words, and the hint that names where the
# command's options are explained
# ---
# w:   the diagnostics writer
# inv: the line, its refusal some
pub fun refused(w: *io.Writer, inv: *args.Invocation) {
    lead(w, nil);
    val said: err[io.WriteError] = args.describe(inv, w);
    format.write_str(w, "\n");
    var name: str = nil;
    if (inv.command != nil) { name = inv.command.name; }
    hint(w, name);
}

# a command table that breaks std.args' contract, the program's own fault: why, and the
# command, action and row it breaks it in
pub fun malformed(w: *io.Writer, m: args.Malformed) {
    lead(w, nil);
    format.write_str(w, "malformed command table: ");
    format.write_str(w, m.why);
    if (m.command != nil) {
        format.write_str(w, " (command '");
        format.write_str(w, m.command.name);
        format.write_str(w, "')");
    }
    if (m.action != nil) {
        format.write_str(w, " (action '");
        format.write_str(w, m.action.name);
        format.write_str(w, "')");
    }
    if (m.row != nil) {
        format.write_str(w, " (row '");
        format.write_str(w, m.row.name);
        format.write_str(w, "')");
    }
    format.write_str(w, "\n");
}

# an error that names what it failed on, `error: message 'name'`
pub fun named(w: *io.Writer, message: str, name: str) {
    lead(w, nil);
    format.write_str(w, message);
    format.write_str(w, " '");
    format.write_str(w, name);
    format.write_str(w, "'\n");
}

# where in the object a refusal is, `= at: section n, offset 0x...`
pub fun placed(w: *io.Writer, section: u32, offset: u64) {
    format.write_str(w, "  = at: section ");
    format.write_u64(w, section::u64);
    format.write_str(w, ", offset 0x");
    format.write_hex_u64(w, offset, false);
    format.write_str(w, "\n");
}

# a verifier refusal, `error[verify.rule]: message`
pub fun rule(w: *io.Writer, name: str, message: str) {
    format.write_str(w, "error[verify.");
    format.write_str(w, name);
    format.write_str(w, "]: ");
    format.write_str(w, message);
    format.write_str(w, "\n");
}

# the symbol a refusal is in, `= in: @name`, when it names one
pub fun symbol(w: *io.Writer, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(w, "  = in: @");
    view(w, name);
    format.write_str(w, "\n");
}

# the target op a refusal names, `= op: "set" "op"`, when it names one
pub fun op(w: *io.Writer, set: View, name: View) {
    if (set.len == 0 && name.len == 0) { ret; }
    format.write_str(w, "  = op: \"");
    view(w, set);
    format.write_str(w, "\" \"");
    view(w, name);
    format.write_str(w, "\"\n");
}

# the ir form a refusal names in place of a target op, `= use: form`, when it names one
pub fun form(w: *io.Writer, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(w, "  = use: ");
    view(w, name);
    format.write_str(w, "\n");
}

# the extension a refusal names, `= extension: name`, when it names one
pub fun extension(w: *io.Writer, name: View) {
    if (name.len == 0) { ret; }
    format.write_str(w, "  = extension: ");
    view(w, name);
    format.write_str(w, "\n");
}

# a failure of mink's under a diagnostic, `  = mink: ...`, in mink's own words
pub fun failure(w: *io.Writer, a: *A.Allocator, f: Fail) {
    var line: Sink = sink.make(a, LITTLE);
    fin { sink.release(?line); }
    val drawn: err[Fail] = diag.render(f, ?line);
    if (sel drawn.err) { ret; }
    format.write_str(w, "  = ");
    format.write_bytes(w, sink.data(?line), sink.len(?line));
}
