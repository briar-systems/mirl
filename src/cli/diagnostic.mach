# the program's own causes beside mirl's failures: why the host refused a file or a write

use std.types.string.str;

use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;
use std.system.os;

use mirl.failure.text;
use mirl.failure.text.Out;

# the host's reason a filesystem operation was refused
pub fun fs_cause(e: fs.FsError) str {
    if (sel e.io)        { ret os.message(e.io); }
    if (sel e.published) { ret os.message(e.published); }
    if (sel e.alloc)     { ret "the allocator refused storage"; }
    if (sel e.write)     { ret write_cause(e.write); }
    if (sel e.read) {
        if (sel e.read.native) { ret os.message(e.read.native.error); }
        ret "the read was cut short";
    }
    if (sel e.removal) { ret io_error.kind_name(e.removal.kind); }
    ret "no free temporary name was found";
}

# the host's reason a write was refused
pub fun write_cause(e: io.WriteError) str {
    if (sel e.native)  { ret os.message(e.native.error); }
    if (sel e.stalled) { ret "the write was cut short"; }
    ret "the write would block";
}

# a refusal to write standard output, with the host's reason
pub fun unwritten_output(o: *Out, e: io.WriteError) {
    text.headline_because(o, "cannot write standard output", write_cause(e));
}
