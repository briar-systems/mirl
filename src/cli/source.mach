# the text of the file a command's operand names, and its parse as a module

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use mirl.ir.module;
use mirl.ir.text.notes.Notes;
use reader: mirl.ir.text.parse;
use mirl.ir.text.sink;
use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;

use std.format;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use std.args;

# the flag that reads a file as a body with no version statement, as test/ir files are
pub val BODY: args.FlagSpec = args.FlagSpec{name: "--body", value: "", arity: args.ARITY_FLAG, doc: "read the file as a body with no version statement, as test/ir files are", default: "", negatable: true, occurs: args.Occurs.override{}, alias_of: nil};

# the rows every command that reads a file takes
pub val ROWS: [1]*args.FlagSpec = [1]*args.FlagSpec{?BODY};

# the text of the operand file
# ---
# call: the command's context, whose operand is the path
# ret:  the text, or the exit code of the refusal or failure to read it
pub fun text(call: *command.Call) res[str, i64] {
    val r: res[str, fs.FsError] = fs.read_string(call.a, call.operand);
    if (sel r.err) {
        ret res[str, i64].err{unreadable(call, r.err)};
    }
    ret res[str, i64].ok{r.ok};
}

# report a file that could not be read, and the exit code it maps to: a missing
# file or a directory is refused input, any other failure is internal
fun unreadable(call: *command.Call, e: fs.FsError) i64 {
    if (sel e.io) {
        if (e.io.kind == io_error.NOT_FOUND) {
            diagnostic.named(call.diag, "no such file", call.operand);
            ret exit.REFUSED;
        }
        if (e.io.kind == io_error.IS_DIRECTORY) {
            diagnostic.named(call.diag, "not a file", call.operand);
            ret exit.REFUSED;
        }
    }
    diagnostic.named(call.diag, "cannot read", call.operand);
    ret exit.INTERNAL;
}

# the module a text reads as: with its version statement, or as a body under --body
# ---
# call: the command's context, whose operand names the text's file
# text: the text
# ret:  the module, which the caller releases, or the exit code of the refusal
pub fun parse(call: *command.Call, text: str) res[module.Module, i64] {
    ret parse_noted(call, text, nil);
}

# the module a text reads as, as `parse`, keeping its comments in kept when
# it is not nil
pub fun parse_noted(call: *command.Call, text: str, kept: *Notes) res[module.Module, i64] {
    val view: View           = View{data: text, len: str_len(text)};
    val body: res[bool, i64] = flag.on(call, ?BODY);
    if (sel body.err) { ret res[module.Module, i64].err{body.err}; }
    val r: res[module.Module, reader.Refusal] = reader.parse_noted(call.a, view, !body.ok, kept);
    if (sel r.err) {
        ret res[module.Module, i64].err{refusal(call, r.err)};
    }
    ret res[module.Module, i64].ok{r.ok};
}

# report a refused text as `error: reason` and ` --> file:line:column`, and
# return the exit code: refused input, or internal when the allocator refused
fun refusal(call: *command.Call, r: reader.Refusal) i64 {
    if (sel r.reason.alloc) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:      io.Writer          = sink.writer(?s);
    val worded: err[io.WriteError] = reader.reason(?w, r.reason);
    if (sel worded.err) {
        diagnostic.headline(call.diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    diagnostic.lead(call.diag, nil);
    diagnostic.view(call.diag, sink.view(?s));
    format.write_str(call.diag, "\n");
    diagnostic.at(call.diag, call.operand, r.line::u64, r.column::u64);
    ret exit.REFUSED;
}
