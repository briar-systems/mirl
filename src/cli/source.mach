# the text of the file a command's operand names, and its parse as a module

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.chrono.time.Instant;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.layout;
use mirl.cli.readout;
use words: mirl.failure.text;
use mirl.ir.module;
use mirl.ir.text.notes.Notes;
use reader: mirl.ir.text.parse;
use mirl.ir.text.parse.reason;
use parse_refusal: mirl.ir.text.parse.refusal;
use mirl.ir.text.sink;
use fs:       std.filesystem;
use io_error: std.io.error;
use io:       std.io.writer;

use std.allocator;
use std.format;

# the text of the operand file
# ---
# call: the command's context, whose operand is the path
# ret:  the text, or the exit code of the refusal or failure to read it
pub fun text(call: *command.Call) res[str, i64] {
    val res_read_string: res[str, fs.FsError] = fs.read_string(call.a, call.operand);
    if (sel res_read_string.err) {
        ret res[str, i64].err{unreadable(call, res_read_string.err)};
    }
    ret res[str, i64].ok{res_read_string.ok};
}

# report a file that could not be read, and the exit code it maps to: a missing
# file or a directory is refused input, and any other failure, a refused
# allocation included, is the environment's
fun unreadable(call: *command.Call, e: fs.FsError) i64 {
    if (sel e.alloc) {
        words.named_because(?call.report, "cannot read", call.operand, diagnostic.fs_cause(e));
        ret exit.ENVIRONMENT;
    }
    if (sel e.io) {
        if (e.io.kind == io_error.NOT_FOUND) {
            words.named(?call.report, "no such file", call.operand);
            ret exit.REFUSED;
        }
        if (e.io.kind == io_error.IS_DIRECTORY) {
            words.named(?call.report, "not a file", call.operand);
            ret exit.REFUSED;
        }
    }
    words.named_because(?call.report, "cannot read", call.operand, diagnostic.fs_cause(e));
    ret exit.ENVIRONMENT;
}

# the module the operand file reads as, read and parsed as the stage `load`, whose log line
# counts its functions with a body
# ---
# call: the command's context, whose operand is the path
# ret:  the module, which the caller releases, or the exit code of the refusal
pub fun load(call: *command.Call) res[module.Module, i64] {
    ret load_noted(call, nil, nil);
}

# the module the operand file reads as, as `load`, keeping its comments in kept and its text in
# read where each is not nil
pub fun load_noted(call: *command.Call, kept: *Notes, read: *str) res[module.Module, i64] {
    val from:     opt[Instant]  = readout.begin(call.rd, "load");
    val res_text: res[str, i64] = text(call);
    if (sel res_text.err) { ret res[module.Module, i64].err{res_text.err}; }
    if (read != nil)      { @read = res_text.ok; }
    val res_parsed: res[module.Module, i64] = parse_noted(call, res_text.ok, kept);
    if (sel res_parsed.err) { ret res_parsed; }
    var m: module.Module = res_parsed.ok;
    var n: layout.Text;
    readout.end(call.rd, "load", from, layout.counted(?n, module.size(?m).functions::u64, "function", "functions"));
    ret res_parsed;
}

# the module a text reads as, its version statement first
# ---
# call: the command's context, whose operand names the text's file
# text: the text
# ret:  the module, which the caller releases, or the exit code of the refusal
pub fun parse(call: *command.Call, text: str) res[module.Module, i64] {
    ret parse_noted(call, text, nil);
}

# the module a text reads as, as `parse`, keeping its comments in kept when
# it is not nil
pub fun parse_noted(call: *command.Call, text: str, kept: *Notes) res[module.Module, i64] {
    val view:            View                                    = View{data: text, len: str_len(text)};
    val res_parse_noted: res[module.Module, parse_refusal.Error] = reader.parse_noted(call.a, view, true, kept);
    if (sel res_parse_noted.err) {
        ret res[module.Module, i64].err{refusal(call, res_parse_noted.err)};
    }
    ret res[module.Module, i64].ok{res_parse_noted.ok};
}

# report a refused text as `error reason` and `@ file:line:column`, and
# return the exit code: refused input, or the environment when the allocator refused
fun refusal(call: *command.Call, r: parse_refusal.Error) i64 {
    val opt_starved: opt[allocator.Error] = reason.starved(r.reason);
    if (sel opt_starved.some) {
        words.headline(?call.report, nil, "out of memory");
        ret exit.ENVIRONMENT;
    }
    var s: sink.Sink = sink.init(call.a);
    fin { sink.dnit(?s); }
    var w:          io.Writer          = sink.writer(?s);
    val err_worded: err[io.WriteError] = reason.describe(?w, r.reason);
    if (sel err_worded.err) {
        words.headline(?call.report, nil, "out of memory");
        ret exit.ENVIRONMENT;
    }
    words.lead(?call.report, nil);
    words.view(?call.report, sink.view(?s));
    format.write_str(call.report.w, "\n");
    words.at(?call.report, call.operand, r.line::u64, r.column::u64);
    ret exit.REFUSED;
}
