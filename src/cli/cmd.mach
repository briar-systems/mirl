# the command set and dispatch: every command's registration and the route from argv to the
# handler of the command the line names. help, --help, -h, --version and the exit codes are
# mirl's own, the same as every tool of the toolchain by convention

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;

use A: std.allocator;
use std.allocator.arena;
use std.args;
use std.collections.slice.Slice;
use io: std.io.writer;

use mirl.cli.cmd.compile;
use mirl.cli.cmd.fmt;
use help_cmd: mirl.cli.cmd.help;
use mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use shown: mirl.cli.help;

# length of COMMANDS
pub val COMMANDS_N: usize = 3;

# every command a handler runs. a command is its own file's registration and handler, and its
# row here and in ROOT_COMMANDS; nothing else registers one
pub val COMMANDS: [COMMANDS_N]*command.Command = [COMMANDS_N]*command.Command{
    ?compile.COMMAND,
    ?verify.COMMAND,
    ?fmt.COMMAND,
};

# the commands nested under the root, in the order help lists them
val ROOT_COMMANDS: [4]*args.Command = [4]*args.Command{?compile.SPEC, ?verify.SPEC, ?fmt.SPEC, ?help_cmd.SPEC};

# the flag the root reads asking for the version alone on one line
val VERSION: args.Flag = args.Flag{long: "version", short: 0, value: nil, repeat: false, negatable: false, help: "print the version"};

# the flags the root reads
val ROOT_FLAGS: [2]*args.Flag = [2]*args.Flag{?command.HELP, ?VERSION};

# the program's root command, which the line is read against
pub val ROOT: args.Command = args.Command{name: "mirl", aliases: Slice[str]{data: nil, size: 0}, help: "the intermediate representation and code generator of the mach toolchain", usage: "", flags: Slice[*args.Flag]{data: ?ROOT_FLAGS[0], size: 2}, commands: Slice[*args.Command]{data: ?ROOT_COMMANDS[0], size: 4}, operand_min: 0, operand_max: 0, passthrough: false};

# the size of the arena each command's storage is drawn from
val ARENA_CAP: usize = 65536;

# write the program's version alone on one line
fun version(out: *io.Writer, diag: *io.Writer) i64 {
    val err_version: err[io.WriteError] = io.write_str(out, $mach.project.version);
    if (sel err_version.err) {
        diagnostic.unwritten_output(diag, err_version.err);
        ret exit.ENVIRONMENT;
    }
    val err_ended: err[io.WriteError] = io.write_str(out, "\n");
    if (sel err_ended.err) {
        diagnostic.unwritten_output(diag, err_ended.err);
        ret exit.ENVIRONMENT;
    }
    ret exit.OK;
}

# report a line std.args refused, in its words, and the exit code of a user error
fun refused(diag: *io.Writer, p: *args.Parsed) i64 {
    diagnostic.lead(diag, nil);
    val said:  err[io.WriteError] = args.describe(p, diag);
    val ended: err[io.WriteError] = io.write_str(diag, "\n  = help: run 'mirl help' for the commands, or 'mirl help <command>' for one's options\n");
    if ((sel said.err) || (sel ended.err)) { ret exit.ENVIRONMENT; }
    ret exit.REFUSED;
}

# whether a refused line still asks for a page: --help with the wrong number of operands, as
# `mirl compile --help` with no file
fun helps_anyway(p: *args.Parsed) bool {
    if (!args.given(p, ?command.HELP)) { ret false; }
    if (sel p.refusal.some) {
        val r: args.Refusal = p.refusal.some;
        ret sel r.operands;
    }
    ret false;
}

# the page `mirl help` names: the overview, or the page of the command its operand names, read
# as that command's own line without its operands
fun help_page(out: *io.Writer, diag: *io.Writer, line: *args.Parsed) i64 {
    val topic: opt[str] = args.operand(line, 0);
    if (sel topic.none) {
        var root: args.Parsed = args.parse(?ROOT, args.of(1, line.args.argv));
        ret shown.show(out, diag, ?root);
    }
    var words: [3]*u8      = [3]*u8{line.args.argv[0], topic.some::*u8, nil};
    var named: args.Parsed = args.parse(?ROOT, args.of(2, ?words[0]));
    if (sel named.refusal.some) {
        val why: args.Refusal = named.refusal.some;
        if (sel why.unknown_command) { ret refused(diag, ?named); }
    }
    ret shown.show(out, diag, ?named);
}

# run the program over its arguments
# ---
# a:    the allocator the program draws its storage from
# argc: length of argv
# argv: the process arguments, argv[0] the program
# out:  the writer of the command's output
# diag: the writer of its diagnostics
# ret:  the exit code
pub fun dispatch(a: *A.Allocator, argc: usize, argv: **u8, out: *io.Writer, diag: *io.Writer) i64 {
    var p: args.Parsed = args.parse(?ROOT, args.of(argc, argv));
    if (sel p.refusal.some) {
        if (helps_anyway(?p)) { ret shown.show(out, diag, ?p); }
        ret refused(diag, ?p);
    }
    if (p.command == ?help_cmd.SPEC) { ret help_page(out, diag, ?p); }
    if (args.given(?p, ?command.HELP)) {
        if (p.command == ?ROOT) { ret shown.show(out, diag, ?p); }
        ret shown.show(out, diag, ?p);
    }
    if (p.command == ?ROOT) {
        if (args.given(?p, ?VERSION)) { ret version(out, diag); }
        val listed: i64 = shown.show(out, diag, ?p);
        if (listed != exit.OK) { ret listed; }
        ret exit.REFUSED;
    }
    val c: *command.Command = command.command_for(?COMMANDS[0], COMMANDS_N, p.command);
    if (c == nil) {
        diagnostic.named(diag, "no handler is registered for the command", p.command.name);
        ret exit.INTERNAL;
    }

    var ar:     arena.Arena;
    val inited: err[A.Error] = arena.init(?ar, a, ARENA_CAP);
    if (sel inited.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    fin { arena.dnit(?ar); }
    var la:   A.Allocator;
    val made: err[A.Error] = arena.make(?la, ?ar);
    if (sel made.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }

    var call: command.Call           = command.call_of(?la, ?p, out, diag);
    val run:  fun(*command.Call) i64 = c.run;
    ret run(?call);
}
