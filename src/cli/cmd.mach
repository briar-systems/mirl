# the command table and dispatch: one row per command, and the route from argv to
# the row's handler

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.arena;
use io: std.io.writer;

use mirl.cli.cmd.emit;
use mirl.cli.cmd.fmt;
use mirl.cli.cmd.help;
use mirl.cli.cmd.lanes;
use mirl.cli.cmd.opt;
use mirl.cli.cmd.reference;
use mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use shown: mirl.cli.help;
use std.args;

# length of COMMANDS
pub val COMMANDS_N: usize = 7;

# every command, in the order help lists them. a command is its own file's
# command.Command, and its row here; nothing else registers one
pub val COMMANDS: [COMMANDS_N]*command.Command = [COMMANDS_N]*command.Command{
    ?help.COMMAND,
    ?verify.COMMAND,
    ?fmt.COMMAND,
    ?opt.COMMAND,
    ?emit.COMMAND,
    ?reference.COMMAND,
    ?lanes.COMMAND,
};

# the command table as the command line is read against it
pub fun commands() command.CommandSet {
    ret command.CommandSet{rows: ?COMMANDS[0], n: COMMANDS_N};
}

# the size of the arena each command's storage is drawn from
val ARENA_CAP: usize = 65536;

# whether a command word or one of its options asks for the command's help
fun wants_help(argc: usize, argv: **u8) bool {
    var i: usize = 2;
    for (i < argc) {
        val tok: str = argv[i]::str;
        if (str_equals(tok, "--help") || str_equals(tok, "-h")) { ret true; }
        i = i + 1;
    }
    ret false;
}

# run the program over its arguments
# ---
# a:    the allocator the program draws its storage from
# argc: length of argv
# argv: the process arguments, argv[0] the program
# out:  the writer of the command's output
# diag: the writer of its diagnostics
# ret:  the exit code
pub fun dispatch(a: *A.Allocator, argc: usize, argv: **u8, out: *io.Writer, diag: *io.Writer) i64 {
    val set: command.CommandSet = commands();
    if (argc < 2) {
        shown.overview(out, set);
        ret exit.REFUSED;
    }
    val word: str = argv[1]::str;
    if (str_equals(word, "--help") || str_equals(word, "-h")) {
        shown.overview(out, set);
        ret exit.OK;
    }
    val c: *command.Command = command.command_for(set, word);
    if (c == nil) {
        diagnostic.usage(diag, command.Usage.unknown_command{word}, nil);
        ret exit.REFUSED;
    }
    if (wants_help(argc, argv)) {
        shown.page(out, c);
        ret exit.OK;
    }

    var ar:     arena.Arena;
    val inited: err[A.Error] = arena.init(?ar, a, ARENA_CAP);
    if (sel inited.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    fin { arena.dnit(?ar); }
    var la:   A.Allocator;
    val made: err[A.Error] = arena.make(?la, ?ar);
    if (sel made.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }

    val read: res[command.Reading, command.Error] = command.read(?la, c, args.of(argc, argv));
    if (sel read.err) {
        if (sel read.err.alloc) {
            diagnostic.headline(diag, nil, "out of memory");
            ret exit.INTERNAL;
        }
        diagnostic.usage(diag, read.err.usage, c.name);
        ret exit.REFUSED;
    }
    var call: command.Call           = command.call_of(?la, read.ok, out, diag, set);
    val run:  fun(*command.Call) i64 = c.run;
    ret run(?call);
}
