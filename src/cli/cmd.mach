# the command set and dispatch: every command's registration, the options they share, and
# the route from argv to the handler of the command the line names

use std.types.bool.false;
use std.types.error.err;
use std.types.size.usize;

use A: std.allocator;
use std.allocator.arena;
use std.args;
use args_help: std.args.help;
use io:        std.io.writer;

use mirl.cli.cmd.emit;
use mirl.cli.cmd.fmt;
use mirl.cli.cmd.help;
use mirl.cli.cmd.lanes;
use mirl.cli.cmd.opt;
use mirl.cli.cmd.reference;
use mirl.cli.cmd.verify;
use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use shown: mirl.cli.help;

# length of COMMANDS
pub val COMMANDS_N: usize = 7;

# every command as the program runs it, in the order help lists them. a command is its own
# file's registration and handler, and its row here and in SPECS; nothing else registers one
pub val COMMANDS: [COMMANDS_N]*command.Command = [COMMANDS_N]*command.Command{
    ?help.COMMAND,
    ?verify.COMMAND,
    ?fmt.COMMAND,
    ?opt.COMMAND,
    ?emit.COMMAND,
    ?reference.COMMAND,
    ?lanes.COMMAND,
};

# every command's registration, in COMMANDS' order
val SPECS: [COMMANDS_N]*args.CommandSpec = [COMMANDS_N]*args.CommandSpec{
    ?help.SPEC,
    ?verify.SPEC,
    ?fmt.SPEC,
    ?opt.SPEC,
    ?emit.SPEC,
    ?reference.SPEC,
    ?lanes.SPEC,
};

# the flag that asks for a command's page, or the overview in place of a command word
pub val HELP: args.FlagSpec = args.FlagSpec{name: "--help", value: "", arity: args.ARITY_FLAG, doc: "show this help", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the short spelling of --help
pub val HELP_SHORT: args.FlagSpec = args.FlagSpec{name: "-h", value: "", arity: args.ARITY_FLAG, doc: "show this help", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: ?HELP};

# the rows every command takes
val COMMON_ROWS: [2]*args.FlagSpec = [2]*args.FlagSpec{?HELP, ?HELP_SHORT};

# the tables every command takes before its own
val COMMON: [1]args.TableRef = [1]args.TableRef{args.TableRef{rows: ?COMMON_ROWS[0], n: $length_of(COMMON_ROWS), accepted: nil, docs: nil}};

# spellings an earlier mirl took, refused by name with what replaced them
val REMOVED: [1]args.Removed = [1]args.Removed{args.Removed{name: "--kind", use: "-e or --emit, given once for each kind"}};

# --help in place of a command word, read as `mirl help --help`, the overview
val GLOBALS: [1]args.Global = [1]args.Global{args.Global{row: ?HELP, command: ?help.SPEC}};

# the command set the command line is read against
pub val SET: args.CommandSet = args.CommandSet{
    program:    "mirl",
    title:      "mirl - the intermediate representation and code generator of the mach toolchain",
    footer:     "run 'mirl <command> --help' for a command's options.",
    specs:      ?SPECS[0],
    n:          COMMANDS_N,
    help:       ?help.SPEC,
    help_flag:  ?HELP,
    common:     ?COMMON[0],
    common_n:   $length_of(COMMON),
    relations:  nil,
    relation_n: 0,
    removed:    ?REMOVED[0],
    removed_n:  $length_of(REMOVED),
    exits:      ?exit.NOTES[0],
    exit_n:     exit.NOTES_N,
    globals:    ?GLOBALS[0],
    global_n:   $length_of(GLOBALS),
};

# the size of the arena each command's storage is drawn from
val ARENA_CAP: usize = 65536;

# run the program over its arguments
# ---
# a:    the allocator the program draws its storage from
# argc: length of argv
# argv: the process arguments, argv[0] the program
# out:  the writer of the command's output
# diag: the writer of its diagnostics
# ret:  the exit code
pub fun dispatch(a: *A.Allocator, argc: usize, argv: **u8, out: *io.Writer, diag: *io.Writer) i64 {
    var inv: args.Invocation = args.parse(?SET, args.of(argc, argv), 1);
    if (sel inv.refusal.some) {
        diagnostic.refused(diag, ?inv);
        if (sel inv.refusal.some.malformed) { ret exit.INTERNAL; }
        ret exit.REFUSED;
    }
    if (inv.command == nil) {
        val shown_code: i64 = shown.overview(out, diag, ?SET);
        if (shown_code != exit.OK) { ret shown_code; }
        ret exit.REFUSED;
    }
    if (args.help_requested(?inv)) { ret shown.show(out, diag, ?SET, args_help.page_of(?inv)); }
    val c: *command.Command = command.command_for(?COMMANDS[0], COMMANDS_N, inv.command);
    if (c == nil) {
        diagnostic.named(diag, "no handler is registered for the command", inv.command.name);
        ret exit.INTERNAL;
    }

    var ar:     arena.Arena;
    val inited: err[A.Error] = arena.init(?ar, a, ARENA_CAP);
    if (sel inited.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }
    fin { arena.dnit(?ar); }
    var la:   A.Allocator;
    val made: err[A.Error] = arena.make(?la, ?ar);
    if (sel made.err) {
        diagnostic.headline(diag, nil, "out of memory");
        ret exit.INTERNAL;
    }

    var call: command.Call           = command.call_of(?la, inv, out, diag, ?SET);
    val run:  fun(*command.Call) i64 = c.run;
    ret run(?call);
}
