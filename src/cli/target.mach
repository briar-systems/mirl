# the target a command compiles for: the module's own target statement, or the
# one -t spells with the narrowing flags, which mink's catalog parses and
# resolves and masc's instruction set checks. mirl parses no target text and
# fills in no part of one itself
#
# -t replaces the module's target statement whole, through module.retarget,
# so the module is verified and compiled as one built for it. the narrowing flags narrow
# a spelling, so they are refused without -t, as the statement states every
# part already

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.args;
use std.collections.slice.Slice;
use std.format;
use io: std.io.writer;

use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Abi;
use mink.catalog.code.CodeModel;
use mtarget: mink.catalog.target;

use masc_isa: masc.isa.isa;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.ir.module;
use mirl.target.record;

# the flag that names the target, the module's own when it is not given
pub val TARGET: args.FlagSpec = args.FlagSpec{name: "--target", value: "sys-arch", arity: args.ARITY_VALUE, doc: "the target to compile for, a system and an architecture as `mach info targets` lists them, every part the narrowing flags leave out taking the catalog's default, by default the target statement of the module", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the short spelling of --target
pub val TARGET_SHORT: args.FlagSpec = args.FlagSpec{name: "-t", value: "sys-arch", arity: args.ARITY_VALUE, doc: "short for --target", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: ?TARGET};

# the flag that narrows the target's environment
pub val ENV: args.FlagSpec = args.FlagSpec{name: "--env", value: "name", arity: args.ARITY_VALUE, doc: "the environment of the system the target runs under, by default the system's", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the flag that narrows the target's calling convention
pub val ABI: args.FlagSpec = args.FlagSpec{name: "--abi", value: "name", arity: args.ARITY_VALUE, doc: "the calling convention, by its psabi name, by default the host's", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the flag that narrows the target's instruction set
pub val ISA: args.FlagSpec = args.FlagSpec{name: "--isa", value: "selection", arity: args.ARITY_VALUE, doc: "the instruction set, in masc's selection spelling, by default the host's floor", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the flag that names an extension the target adds to its instruction set, given once for each
pub val EXT: args.FlagSpec = args.FlagSpec{name: "--ext", value: "name", arity: args.ARITY_VALUE, doc: "an extension to add to the target's instruction set, as masc names it, given once for each", default: "", negatable: false, occurs: args.Occurs.collect{}, alias_of: nil};

# the flag that picks the target's code model
pub val CODE_MODEL: args.FlagSpec = args.FlagSpec{name: "--code-model", value: "name", arity: args.ARITY_VALUE, doc: "the code model the target's addresses are reached under, as mink's catalog names it, pie or pic on linux, medlow or medany for riscv64 freestanding, by default the host's", default: "", negatable: false, occurs: args.Occurs.override{}, alias_of: nil};

# the flag rows that name the target, which every compiling command takes
pub val ROWS: [7]*args.FlagSpec = [7]*args.FlagSpec{?TARGET, ?TARGET_SHORT, ?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL};

# the narrowing rows, refused without -t
val NARROWING: [5]*args.FlagSpec = [5]*args.FlagSpec{?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL};

# the target a command line asks for, as the library assembles it
# ---
# tuple: the five parts, borrowing the catalog's rows and the line's text
# code:  the code model, none for the one mink's hosts take
# added: the extensions the line adds to the instruction set, in its order
# named: -t named it, so it replaces the module's target statement
pub rec Asked {
    tuple: module.Tuple;
    code:  opt[*CodeModel];
    added: Slice[str];
    named: bool;
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

# report a refusal mink's catalog or masc wrote, in their words
fun refused(call: *command.Call, r: mtarget.Refusal) i64 {
    var line: Sink = sink.make(call.a, LITTLE);
    fin { sink.release(?line); }
    val wrote: err[Fail] = mtarget.write(?r, ?line);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, r.why);
        ret exit.REFUSED;
    }
    diagnostic.lead(call.diag, nil);
    format.write_bytes(call.diag, sink.data(?line), sink.len(?line));
    format.write_str(call.diag, "\n");
    ret exit.REFUSED;
}

# the target the command line asks for: the module's statement when -t is not
# given, or what -t and the narrowing flags resolve to in mink's catalog,
# checked by masc's instruction set
# ---
# call: the command's context
# m:    the module, whose target statement stands when -t is not given
# ret:  the target asked for, or the exit code of a refusal, which is reported
pub fun asked(call: *command.Call, m: *module.Module) res[Asked, i64] {
    val spelled: res[str, i64] = flag.value(call, ?TARGET);
    if (sel spelled.err) { ret res[Asked, i64].err{spelled.err}; }
    val ext: res[Slice[str], i64] = flag.collected(call, ?EXT);
    if (sel ext.err) { ret res[Asked, i64].err{ext.err}; }
    if (spelled.ok == nil) {
        var i: usize = 0;
        for (i < $length_of(NARROWING)) {
            if (args.given(?call.inv, NARROWING[i])) {
                diagnostic.named(call.diag, "a narrowing flag narrows a target named with -t, and the module's target statement states every part", NARROWING[i].name);
                ret res[Asked, i64].err{exit.REFUSED};
            }
            i = i + 1;
        }
        ret res[Asked, i64].ok{Asked{tuple: module.target(m), code: opt[*CodeModel].none{}, added: ext.ok, named: false}};
    }
    val env: res[str, i64] = flag.value(call, ?ENV);
    if (sel env.err) { ret res[Asked, i64].err{env.err}; }
    val abi: res[str, i64] = flag.value(call, ?ABI);
    if (sel abi.err) { ret res[Asked, i64].err{abi.err}; }
    val isa: res[str, i64] = flag.value(call, ?ISA);
    if (sel isa.err) { ret res[Asked, i64].err{isa.err}; }
    val code: res[str, i64] = flag.value(call, ?CODE_MODEL);
    if (sel code.err) { ret res[Asked, i64].err{code.err}; }

    val spec: res[mtarget.Spec, mtarget.Refusal] = mtarget.parse(spelled.ok);
    if (sel spec.err) { ret res[Asked, i64].err{refused(call, spec.err)}; }
    var n: mtarget.Narrowing                    = mtarget.Narrowing{env: env.ok, abi: abi.ok, isa: isa.ok, ext: ext.ok.data, ext_count: ext.ok.size, code_model: code.ok};
    val t: res[mtarget.Target, mtarget.Refusal] = mtarget.resolve(spec.ok, ?n);
    if (sel t.err) { ret res[Asked, i64].err{refused(call, t.err)}; }
    var row:     mtarget.Target       = t.ok;
    val checked: err[mtarget.Refusal] = masc_isa.check(call.a, ?row);
    if (sel checked.err) { ret res[Asked, i64].err{refused(call, checked.err)}; }
    val bounded: res[str, mtarget.Refusal] = mtarget.isa(?row);
    if (sel bounded.err) { ret res[Asked, i64].err{refused(call, bounded.err)}; }
    val convention: res[opt[*Abi], mtarget.Refusal] = mtarget.abi(?row);
    if (sel convention.err) { ret res[Asked, i64].err{refused(call, convention.err)}; }
    if (sel convention.ok.none) {
        diagnostic.named(call.diag, "the target's family names no calling convention, which mirl compiles under", spelled.ok);
        ret res[Asked, i64].err{exit.REFUSED};
    }
    var env_name: str = record.NONE;
    if (sel row.env.some) { env_name = row.env.some.name; }
    val tuple: module.Tuple = module.Tuple{arch: view_of(row.arch.name), sys: view_of(row.sys.name), env: view_of(env_name), abi: view_of(convention.ok.some.name), isa: view_of(bounded.ok)};
    ret res[Asked, i64].ok{Asked{tuple: tuple, code: row.code_model, added: ext.ok, named: true}};
}
