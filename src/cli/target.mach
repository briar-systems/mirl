# the target a command compiles for: the module's own target statement, or the
# one -t spells with the narrowing flags, which mink's catalog parses and
# resolves and masc's instruction set checks. mirl parses no target text and
# fills in no part of one itself
#
# -t replaces the module's target statement whole, through module.retarget,
# so the module is verified and compiled as one built for it. the narrowing flags narrow
# a spelling, so they are refused without -t, as the statement states every
# part already

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.args;
use std.collections.slice.Slice;
use std.format;
use io: std.io.writer;

use mink.base.diag;
use mink.base.fail.Fail;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.arch.Abi;
use mink.catalog.code.CodeModel;
use mtarget: mink.catalog.target;

use masc_isa: masc.isa;

use mirl.cli.command;
use mirl.cli.diagnostic;
use mirl.cli.exit;
use mirl.cli.flag;
use mirl.ir.module;
use mirl.target.record;

# the flag that names the target, the module's own when it is not given
pub val TARGET: args.Flag = args.Flag{long: "target", short: 't', value: "sys-arch", repeat: false, negatable: false, help: "the target to compile for (default: the module's)"};

# the flag that narrows the target's environment
pub val ENV: args.Flag = args.Flag{long: "env", short: 0, value: "name", repeat: false, negatable: false, help: "the environment (default: the target's)"};

# the flag that narrows the target's calling convention
pub val ABI: args.Flag = args.Flag{long: "abi", short: 0, value: "name", repeat: false, negatable: false, help: "the calling convention (default: the target's)"};

# the flag that narrows the target's instruction set
pub val ISA: args.Flag = args.Flag{long: "isa", short: 0, value: "selection", repeat: false, negatable: false, help: "the instruction set (default: the target's)"};

# the flag that names an extension the target adds to its instruction set, given once for each
pub val EXT: args.Flag = args.Flag{long: "ext", short: 0, value: "name", repeat: true, negatable: false, help: "an instruction set extension to add, once for each"};

# the flag that picks the target's code model
pub val CODE_MODEL: args.Flag = args.Flag{long: "code-model", short: 0, value: "name", repeat: false, negatable: false, help: "the code model (default: the target's)"};

# the narrowing flags, refused without -t
val NARROWING: [5]*args.Flag = [5]*args.Flag{?ENV, ?ABI, ?ISA, ?EXT, ?CODE_MODEL};

# the target a command line asks for, as the library assembles it
# ---
# tuple: the five parts, borrowing the catalog's rows and the line's text
# code:  the code model, none for the one mink's hosts take
# added: the extensions the line adds to the instruction set, in its order
# named: -t named it, so it replaces the module's target statement
pub rec Asked {
    tuple: module.Tuple;
    code:  opt[*CodeModel];
    added: Slice[str];
    named: bool;
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

# report a refusal mink's catalog or masc wrote, in their words, under mirl's own head
fun refused(call: *command.Call, f: Fail) i64 {
    var line: Sink = sink.make(call.a, LITTLE);
    fin { sink.release(?line); }
    val wrote: err[Fail] = diag.render(nil, f, ?line);
    if (sel wrote.err) {
        diagnostic.headline(call.diag, nil, f.text);
        ret exit.REFUSED;
    }
    diagnostic.lead(call.diag, nil);
    format.write_bytes(call.diag, sink.data(?line), sink.len(?line));
    ret exit.REFUSED;
}

# the target the command line asks for: the module's statement when -t is not
# given, or what -t and the narrowing flags resolve to in mink's catalog,
# checked by masc's instruction set
# ---
# call: the command's context
# m:    the module, whose target statement stands when -t is not given
# ret:  the target asked for, or the exit code of a refusal, which is reported
pub fun asked(call: *command.Call, m: *module.Module) res[Asked, i64] {
    val spelled: str                  = args.value(call.p, ?TARGET);
    val ext:     res[Slice[str], i64] = flag.collected(call, ?EXT);
    if (sel ext.err) { ret res[Asked, i64].err{ext.err}; }
    if (spelled == nil) {
        var i: usize = 0;
        for (i < $length_of(NARROWING)) {
            if (args.given(call.p, NARROWING[i])) {
                diagnostic.lead(call.diag, nil);
                format.write_str(call.diag, "--");
                format.write_str(call.diag, NARROWING[i].long);
                format.write_str(call.diag, " narrows a target named with -t, and the module's target statement states every part\n");
                ret res[Asked, i64].err{exit.REFUSED};
            }
            i = i + 1;
        }
        ret res[Asked, i64].ok{Asked{tuple: module.target(m), code: opt[*CodeModel].none{}, added: ext.ok, named: false}};
    }
    val env:  str = args.value(call.p, ?ENV);
    val abi:  str = args.value(call.p, ?ABI);
    val isa:  str = args.value(call.p, ?ISA);
    val code: str = args.value(call.p, ?CODE_MODEL);

    val spec: res[mtarget.Spec, Fail] = mtarget.parse(spelled);
    if (sel spec.err) { ret res[Asked, i64].err{refused(call, spec.err)}; }
    var n: mtarget.Narrowing         = mtarget.Narrowing{env: env, abi: abi, isa: isa, ext: ext.ok.data, ext_count: ext.ok.size, code_model: code};
    val t: res[mtarget.Target, Fail] = mtarget.resolve(spec.ok, ?n);
    if (sel t.err) { ret res[Asked, i64].err{refused(call, t.err)}; }
    var row:     mtarget.Target                   = t.ok;
    val checked: res[opt[masc_isa.Checked], Fail] = masc_isa.check(call.a, ?row);
    if (sel checked.err) { ret res[Asked, i64].err{refused(call, checked.err)}; }
    if (sel checked.ok.some) {
        var held: masc_isa.Checked = checked.ok.some;
        masc_isa.release(?held);
    }
    val bounded: res[str, Fail] = mtarget.isa(?row);
    if (sel bounded.err) { ret res[Asked, i64].err{refused(call, bounded.err)}; }
    val convention: res[opt[*Abi], Fail] = mtarget.abi(?row);
    if (sel convention.err) { ret res[Asked, i64].err{refused(call, convention.err)}; }
    if (sel convention.ok.none) {
        diagnostic.named(call.diag, "the target's family names no calling convention, which mirl compiles under", spelled);
        ret res[Asked, i64].err{exit.REFUSED};
    }
    var env_name: str = record.NONE;
    if (sel row.env.some) { env_name = row.env.some.name; }
    val tuple: module.Tuple = module.Tuple{arch: view_of(row.arch.name), sys: view_of(row.sys.name), env: view_of(env_name), abi: view_of(convention.ok.some.name), isa: view_of(bounded.ok)};
    ret res[Asked, i64].ok{Asked{tuple: tuple, code: row.code_model, added: ext.ok, named: true}};
}
