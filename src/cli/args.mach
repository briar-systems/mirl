# the command line: a command's options, how argv is read against them, and the
# invocation a command runs with
#
# a command line is `mirl <command> [file] [options]`. an option is `--key value`,
# or a switch: `--key` sets it and `--no-key` clears it. the last spelling given
# wins. a command that takes a file takes one, as its operand.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_starts_with;

use A:  std.allocator;
use T:  std.allocator.testing;
use io: std.io.writer;

# how an option takes its value
pub def Arity: u8;

# the option is a switch: `--key` sets it and its `off` spelling clears it
pub val SWITCH: Arity = 0;

# the option takes the next argv token as its value
pub val VALUE: Arity = 1;

# one option a command takes
# ---
# name:  its spelling, such as `--write`
# off:   the spelling that clears a switch, such as `--no-write`; nil for a value
# value: the placeholder help shows for a value, empty for a switch
# arity: SWITCH or VALUE
# doc:   one-line help text
pub rec Option {
    name:  str;
    off:   str;
    value: str;
    arity: Arity;
    doc:   str;
}

# the context a command's handler runs in
# ---
# a:        the allocator the command takes its storage from
# inv:      the invocation being run
# out:      the writer of the command's output
# diag:     the writer of its diagnostics
# commands: every command, which help lists
pub rec Call {
    a:        *A.Allocator;
    inv:      *Invocation;
    out:      *io.Writer;
    diag:     *io.Writer;
    commands: CommandSet;
}

# one command: its word, its help and what it takes
# ---
# name:     the command word, such as `verify`
# summary:  one-line help text
# usage:    the synopsis help shows after `mirl`, such as `verify <file> [options]`
# file:     the command takes one file operand, which is required
# options:  its options, the first entry of a list of option rows; nil when option_n is 0
# option_n: length of options
# run:      the handler, whose ret is the exit code
pub rec Command {
    name:     str;
    summary:  str;
    usage:    str;
    file:     bool;
    options:  **Option;
    option_n: usize;
    run:      fun(*Call) i64;
}

# the commands a command line is read against, in help order
# ---
# rows: first entry of the command list
# n:    length of rows
pub rec CommandSet {
    rows: **Command;
    n:    usize;
}

# the command argv names, nil when none does
pub fun command_for(set: CommandSet, word: str) *Command {
    var i: usize = 0;
    for (i < set.n) {
        if (str_equals(set.rows[i].name, word)) { ret set.rows[i]; }
        i = i + 1;
    }
    ret nil;
}

# what a command line was refused for
# ---
# unknown_command: the word names no command
# unknown_option:  the spelling names no option of the command
# missing_value:   a value option ends the line with no value after it
# unexpected:      an operand the command does not take
# missing_file:    the command takes a file and the line gives none
pub tag Usage: u8 {
    unknown_command: str;
    unknown_option:  str;
    missing_value:   str;
    unexpected:      str;
    missing_file;
}

# why a command line did not read
# ---
# alloc: the allocator refused storage
# usage: the line is not one the command takes
pub tag Error: u8 {
    alloc: A.Error;
    usage: Usage;
}

# what one option was given
# ---
# on:    a switch is set, or a value option was given
# value: the value of a value option, nil when none was given
pub rec Setting {
    on:    bool;
    value: str;
}

# a command line read against its command
# ---
# command:  the command the line names
# operand:  the file operand, nil when the command takes none
# settings: one setting per option row of command, in row order
pub rec Invocation {
    command:  *Command;
    operand:  str;
    settings: *Setting;
}

# the row index of an option spelling in a command, -1 when it names none
fun index_of(c: *Command, tok: str) i64 {
    var j: usize = 0;
    for (j < c.option_n) {
        val row: *Option = c.options[j];
        if (str_equals(tok, row.name))                  { ret j::i64; }
        if (row.off != nil && str_equals(tok, row.off)) { ret j::i64; }
        j = j + 1;
    }
    ret -1;
}

fun refused(u: Usage) res[Invocation, Error] {
    ret res[Invocation, Error].err{Error.usage{u}};
}

# read argv against a command, from the token after the command word
# ---
# a:    the allocator the settings take their storage from
# c:    the command argv names
# argc: length of argv
# argv: the process arguments, argv[1] the command word
# ret:  the invocation, or why the line is not one the command takes
pub fun parse(a: *A.Allocator, c: *Command, argc: usize, argv: **u8) res[Invocation, Error] {
    val made: res[*Setting, A.Error] = A.zallocate[Setting](a, c.option_n + 1);
    if (sel made.err) { ret res[Invocation, Error].err{Error.alloc{made.err}}; }

    var inv: Invocation = Invocation{command: c, operand: nil, settings: made.ok};
    var i:   usize      = 2;
    for (i < argc) {
        val tok: str = argv[i]::str;
        if (str_starts_with(tok, "-")) {
            val k: i64 = index_of(c, tok);
            if (k < 0) { ret refused(Usage.unknown_option{tok}); }
            val row: *Option = c.options[k::usize];
            if (row.arity == SWITCH) {
                inv.settings[k::usize].on = str_equals(tok, row.name);
            }
            or {
                if (i + 1 >= argc) { ret refused(Usage.missing_value{tok}); }
                i                            = i + 1;
                inv.settings[k::usize].on    = true;
                inv.settings[k::usize].value = argv[i]::str;
            }
        }
        or {
            if (!c.file || inv.operand != nil) { ret refused(Usage.unexpected{tok}); }
            inv.operand = tok;
        }
        i = i + 1;
    }
    if (c.file && inv.operand == nil) { ret refused(Usage.missing_file{}); }
    ret res[Invocation, Error].ok{inv};
}

# the setting of an option row of the invocation's command, nil when the command
# does not take the row
fun setting(inv: *Invocation, row: *Option) *Setting {
    var j: usize = 0;
    for (j < inv.command.option_n) {
        if (inv.command.options[j] == row) { ret ?inv.settings[j]; }
        j = j + 1;
    }
    ret nil;
}

# whether a switch row is set in the invocation
pub fun flag(inv: *Invocation, row: *Option) bool {
    val s: *Setting = setting(inv, row);
    if (s == nil) { ret false; }
    ret s.on;
}

# the value a value row was given, nil when it was not
pub fun value(inv: *Invocation, row: *Option) str {
    val s: *Setting = setting(inv, row);
    if (s == nil) { ret nil; }
    ret s.value;
}

test parse__switch_sets_and_clears_and_value_takes_the_next_token {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }

    var write: Option = Option{name: "--write", off: "--no-write", value: "", arity: SWITCH, doc: ""};
    var level: Option = Option{name: "--level", off: nil, value: "n", arity: VALUE, doc: ""};
    var rows:  [2]*Option;
    rows[0] = ?write;
    rows[1] = ?level;
    var c: Command;
    c.options  = ?rows[0];
    c.option_n = 2;

    var on: [5]*u8;
    on[0] = "mirl";
    on[1] = "fmt";
    on[2] = "--level";
    on[3] = "3";
    on[4] = "--write";
    val a:     *A.Allocator           = T.allocator_of(?t);
    val first: res[Invocation, Error] = parse(a, ?c, 5, ?on[0]);
    if (sel first.err) { ret 2; }
    var set: Invocation = first.ok;
    if (!flag(?set, ?write))                   { ret 3; }
    if (!str_equals(value(?set, ?level), "3")) { ret 4; }

    var off: [4]*u8;
    off[0] = "mirl";
    off[1] = "fmt";
    off[2] = "--write";
    off[3] = "--no-write";
    val second: res[Invocation, Error] = parse(a, ?c, 4, ?off[0]);
    if (sel second.err) { ret 5; }
    var cleared: Invocation = second.ok;
    if (flag(?cleared, ?write)) { ret 6; }
    ret 0;
}
