# how every line the command line prints for a person is laid out, in the one output language
# of the toolchain mach states: results, and the one written form of a duration, a size and a
# count
#
# a result is a verb from one closed table and what it acted on, on one line, then its fields
# beneath it, one a line, indented INDENT, each key padded to the result's widest and GAP before
# its value. a field with nothing to say is left out, so a count of zero never prints.
#
# a number is rounded to the nearest of its last digit, and shows a tenth while it is under ten
# of its unit: a size is exact bytes below a KiB, then KiB, MiB or GiB (`1.5 KiB`, `51 KiB`); a
# measured duration is microseconds below a millisecond, milliseconds below a second (`1.5ms`,
# `468ms`), seconds to a tenth below a minute (`18.5s`), then minutes and whole seconds. a count
# of one takes the singular noun, and a count shown among others groups its digits by three
# (`30,634`). mach's `mach.report.layout` is the reference, and the two agree line for line.

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.chrono.duration;
use std.format;
use io: std.io.writer;

# the spaces between a key and its value
pub val GAP: usize = 2;

# the spaces a result's fields are indented by
pub val INDENT: usize = 2;

# write n spaces
pub fun spaces(w: *io.Writer, n: usize) {
    var i: usize = 0;
    for (i < n) {
        format.write_byte(w, ' ');
        i = i + 1;
    }
}

# s right-aligned in `width`, spaces alone for nil
pub fun right(w: *io.Writer, s: str, width: usize) {
    var l: usize = 0;
    if (s != nil)  { l = str_len(s); }
    if (l < width) { spaces(w, width - l); }
    if (s != nil)  { format.write_str(w, s); }
}

# s left-aligned in `width`
pub fun left(w: *io.Writer, s: str, width: usize) {
    var l: usize = 0;
    if (s != nil) {
        format.write_str(w, s);
        l = str_len(s);
    }
    if (l < width) { spaces(w, width - l); }
}

# the room one written number, duration or size takes, its terminator included
pub val TEXT_CAP: usize = 48;

# storage one written value lives in while its line is written, and how much a text writer
# has put in it
pub rec Text {
    bytes: [TEXT_CAP]u8;
    len:   usize;
}

# a writer into t, from its start: what does not fit is dropped, and text_end closes it
pub fun text_writer(t: *Text) io.Writer {
    t.len = 0;
    ret io.Writer{ctx: t::ptr, fn_write: text_write};
}

# what a text writer wrote into t
pub fun text_end(t: *Text) str {
    ret finish(t, t.len);
}

fun text_write(ctx: ptr, buf: *u8, len: usize) res[usize, io.WriteError] {
    val t: *Text = ctx::*Text;
    t.len = bounded(?t.bytes[0], TEXT_CAP, t.len, buf, len);
    ret res[usize, io.WriteError].ok{len};
}

# the room one field's value takes when it is written of parts, as `linux-x86_64`, its
# terminator included
pub val VALUE_CAP: usize = 256;

# storage one field's value lives in while its result is written, and how much a value writer
# has put in it
pub rec Value {
    bytes: [VALUE_CAP]u8;
    len:   usize;
}

# a writer into v, from its start: what does not fit is dropped, and value_end closes it
pub fun value_writer(v: *Value) io.Writer {
    v.len = 0;
    ret io.Writer{ctx: v::ptr, fn_write: value_write};
}

# what a value writer wrote into v
pub fun value_end(v: *Value) str {
    v.bytes[v.len] = 0;
    ret (?v.bytes[0])::str;
}

fun value_write(ctx: ptr, buf: *u8, len: usize) res[usize, io.WriteError] {
    val v: *Value = ctx::*Value;
    v.len = bounded(?v.bytes[0], VALUE_CAP, v.len, buf, len);
    ret res[usize, io.WriteError].ok{len};
}

# copy what of buf fits after `at` bytes of a store of `cap`, a terminator's room kept, and
# answer the length it reaches
fun bounded(bytes: *u8, cap: usize, at: usize, buf: *u8, len: usize) usize {
    var l: usize = at;
    var i: usize = 0;
    for (i < len && l + 1 < cap) {
        bytes[l] = buf[i];
        l        = l + 1;
        i        = i + 1;
    }
    ret l;
}

# a count in decimal
pub fun count(t: *Text, n: u64) str {
    ret finish(t, put_u64(t, 0, n));
}

# a count as a field's value: nil for none, which leaves the field out
pub fun nonzero(t: *Text, n: u64) str {
    if (n == 0) { ret nil; }
    ret count(t, n);
}

# a count with its noun, as `3 functions`, the singular for one
pub fun counted(t: *Text, n: u64, one: str, many: str) str {
    var l: usize = put_u64(t, 0, n);
    l = put(t, l, " ");
    ret finish(t, put(t, l, noun(n, one, many)));
}

# a measured duration, rounded to the nearest of its last digit: a tenth below ten of
# microseconds or milliseconds and whole above, seconds to a tenth below a minute, then minutes
# and whole seconds. zero is `0us`
pub fun took(t: *Text, d: duration.Duration) str {
    if (d <= 0) { ret finish(t, put(t, 0, "0us")); }
    ret nanoseconds(t, d::u64);
}

# a duration given in nanoseconds, written as `took` writes one
pub fun nanoseconds(t: *Text, n: u64) str {
    if (n == 0) { ret finish(t, put(t, 0, "0us")); }
    val us: u64 = duration.MICROSECOND::u64;
    val ms: u64 = duration.MILLISECOND::u64;
    val s:  u64 = duration.SECOND::u64;
    if (tenths(n, us) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, us)), "us")); }
    if (whole(n, us) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, us)), "us")); }
    if (tenths(n, ms) < 100) { ret finish(t, put(t, put_tenths(t, tenths(n, ms)), "ms")); }
    if (whole(n, ms) < 1000) { ret finish(t, put(t, put_u64(t, 0, whole(n, ms)), "ms")); }
    if (tenths(n, s) < 600)  { ret finish(t, put(t, put_tenths(t, tenths(n, s)), "s")); }
    val all: u64   = whole(n, s);
    var l:   usize = put_u64(t, 0, all / 60);
    l = put(t, l, "m");
    l = put_u64(t, l, all % 60);
    ret finish(t, put(t, l, "s"));
}

# a size in bytes: exact below a KiB, then the largest binary unit it holds one of, rounded to
# the nearest tenth below ten of the unit and to the nearest whole above
pub fun size(t: *Text, bytes: u64) str {
    val ki: u64 = 1024;
    if (bytes < ki) { ret finish(t, put(t, put_u64(t, 0, bytes), " B")); }
    val units: [3]str = [3]str{" KiB", " MiB", " GiB"};
    var per:   u64    = ki;
    var k:     usize  = 0;
    for (k < 2 && whole(bytes, per) >= ki) {
        per = per * ki;
        k   = k + 1;
    }
    if (tenths(bytes, per) < 100) { ret finish(t, put(t, put_tenths(t, tenths(bytes, per)), units[k])); }
    ret finish(t, put(t, put_u64(t, 0, whole(bytes, per)), units[k]));
}

# a count with a comma between each group of three digits
pub fun grouped(t: *Text, n: u64) str {
    var digits: Text;
    val l:      usize = format.put_u64(?digits.bytes[0], n);
    var at:     usize = 0;
    var i:      usize = 0;
    for (i < l) {
        if (i > 0 && (l - i) % 3 == 0) {
            t.bytes[at] = ',';
            at          = at + 1;
        }
        t.bytes[at] = digits.bytes[i];
        at          = at + 1;
        i           = i + 1;
    }
    ret finish(t, at);
}

# the noun a count takes
pub fun noun(n: u64, one: str, many: str) str {
    if (n == 1) { ret one; }
    ret many;
}

# n in tenths of `per`, rounded to nearest
fun tenths(n: u64, per: u64) u64 {
    ret (n * 10 + per / 2) / per;
}

# n in wholes of `per`, rounded to nearest
fun whole(n: u64, per: u64) u64 {
    ret (n + per / 2) / per;
}

# tenths written as `<whole>.<tenth>` at the start of t
fun put_tenths(t: *Text, n: u64) usize {
    var l: usize = put_u64(t, 0, n / 10);
    l = put(t, l, ".");
    ret put_u64(t, l, n % 10);
}

fun put_u64(t: *Text, at: usize, n: u64) usize {
    ret at + format.put_u64(?t.bytes[at], n);
}

fun put(t: *Text, at: usize, s: str) usize {
    var l: usize = at;
    var i: usize = 0;
    for (s[i] != 0 && l + 1 < TEXT_CAP) {
        t.bytes[l] = s[i];
        l          = l + 1;
        i          = i + 1;
    }
    ret l;
}

fun finish(t: *Text, l: usize) str {
    t.bytes[l] = 0;
    ret (?t.bytes[0])::str;
}

# what a result says was done, the word that opens it. the table is mach's, whole, so a verb
# means the same in every tool of the toolchain
pub def Verb: u8;

pub val CREATED:    Verb = 0;
pub val REALIZED:   Verb = 1;
pub val UPDATED:    Verb = 2;
pub val UNCHANGED:  Verb = 3;
pub val ADDED:      Verb = 4;
pub val REMOVED:    Verb = 5;
pub val BUILT:      Verb = 6;
pub val CHECKED:    Verb = 7;
pub val FORMATTED:  Verb = 8;
pub val DIFFERS:    Verb = 9;
pub val DOCUMENTED: Verb = 10;
pub val VERIFIED:   Verb = 11;
pub val FETCHED:    Verb = 12;
pub val PASSED:     Verb = 13;
pub val FAILED:     Verb = 14;
pub val SKIPPED:    Verb = 15;
pub val MIGRATED:   Verb = 16;

val VERB_COUNT: usize = 17;

val VERBS: [VERB_COUNT]str = [VERB_COUNT]str{
    "created", "realized", "updated", "unchanged", "added", "removed", "built", "checked", "formatted",
    "differs", "documented", "verified", "fetched", "passed", "failed", "skipped", "migrated",
};

# the word a verb says, as `built`
pub fun verb_word(v: Verb) str {
    ret VERBS[v];
}

# one line of a result's block: what the value is, then the value
# ---
# key:   the field's name, as `time`
# value: what the result has for it, nil or empty for nothing, which leaves the field out
pub rec Field {
    key:   str;
    value: str;
}

# a result: its verb and what it acted on on one line, then each field that has a value on a line
# of its own, indented INDENT, its key padded to the widest key shown and GAP before its value
# ---
# w:       where the result goes
# v:       what was done
# subject: what it was done to
# fields:  the result's fields in the order they show, n of them
pub fun result(w: *io.Writer, v: Verb, subject: str, fields: *Field, n: usize) {
    format.write_str(w, VERBS[v]);
    format.write_byte(w, ' ');
    format.write_str(w, subject);
    format.write_newline(w);
    var width: usize = 0;
    var i:     usize = 0;
    for (i < n) {
        if (shown(?fields[i]) && str_len(fields[i].key) > width) { width = str_len(fields[i].key); }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        val f: *Field = ?fields[i];
        i = i + 1;
        if (!shown(f)) { cnt; }
        spaces(w, INDENT);
        format.write_str(w, f.key);
        spaces(w, width - str_len(f.key) + GAP);
        format.write_str(w, f.value);
        format.write_newline(w);
    }
}

fun shown(f: *Field) bool {
    ret f.value != nil && f.value[0] != 0;
}
