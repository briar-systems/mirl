# the analysis cache: each analysis of a function computed on request and kept
# until a pass that does not preserve it changes the function
#
# an analysis is a row of a registry, keyed by its position. a row may need
# rows before it, and dropping an analysis drops every analysis that needs it,
# so nothing is served that was computed from something stale. a pass that
# changes a function and then asks about it again forgets it first.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.refusal;
use mirl.target.basis.Basis;
use mirl.target.record.Target;

# an analysis, as its row in the registry
pub def Analysis: u32;

# a set of analyses, bit i holding registry row i
pub def Set: u64;

# the most rows a registry may have
pub val ROWS: u32 = 64;

# no analysis
pub val NONE: Set = 0;

# every analysis
pub val ALL: Set = 0xffffffffffffffff;

# a set of one analysis
pub fun one(a: Analysis) Set {
    ret 1u64 << a::u64;
}

# a set with an analysis added
pub fun with(s: Set, a: Analysis) Set {
    ret s | one(a);
}

# whether a set holds an analysis
pub fun holds(s: Set, a: Analysis) bool {
    ret (s & one(a)) != 0;
}

# compute an analysis of a function, asking the cache for the ones it needs
pub def Compute: fun(*Cache, Function) res[ptr, refusal.Error];

# give back an analysis a compute made
pub def Release: fun(*allocator.Allocator, ptr) err[allocator.Error];

# one analysis of the registry
# ---
# name:    its name
# needs:   the analyses before it that it is computed from
# compute: how it is computed
# release: how it is given back
pub rec Row {
    name:    str;
    needs:   Set;
    compute: Compute;
    release: Release;
}

# the analyses of a module's functions
# ---
# m:       the module, whose allocator the analyses take
# t:       the target the module is built for, which analyses of sizes read
# basis:   the build's selection, none when no family opened a build, which
#          analyses of sizes read for the layout of vectors
# rows:    the registry
# slots:   each function's analyses, a row's apart, nil where none is held
# allowed: the rows the reader running now may ask for, closed over what each needs
pub rec Cache {
    m:       *Module;
    t:       *Target;
    basis:   opt[*Basis];
    rows:    Slice[Row];
    slots:   vector.Vector[ptr];
    allowed: Set;
}

# the first registry row that needs itself or a row after it, or the row
# count when the registry is too large for a set
pub fun check(rows: Slice[Row]) opt[u32] {
    if (rows.size > ROWS::usize) { ret opt[u32].some{ROWS}; }
    var i: usize = 0;
    for (i < rows.size) {
        val later: u64 = ~((1u64 << i::u64) - 1);
        if ((rows.data[i].needs & later) != 0) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the rows of `s` and every row they need, through the rows those need, over a registry `check` accepts
pub fun closed(rows: Slice[Row], s: Set) Set {
    var out: Set   = s;
    var i:   usize = rows.size;
    for (i > 0) {
        i = i - 1;
        if (holds(out, (i::u32))) { out = out | rows.data[i].needs; }
    }
    ret out;
}

# an empty cache over a registry that `check` accepts, for a reader that asks for the rows `reads` and the rows
# they need. the driver names the rows of each pass as it runs it
pub fun init(m: *Module, t: *Target, basis: opt[*Basis], rows: Slice[Row], reads: Set) Cache {
    ret Cache{m: m, t: t, basis: basis, rows: rows, slots: vector.init[ptr](m.a), allowed: closed(rows, reads)};
}

# let the reader that runs next ask for the rows `reads` and the rows they need, and no other
pub fun reader(c: *Cache, reads: Set) {
    c.allowed = closed(c.rows, reads);
}

# give back every analysis held, and the cache's storage
pub fun dnit(c: *Cache) err[allocator.Error] {
    var err_failed: err[allocator.Error] = drop_all(c, NONE);
    keep(?err_failed, vector.dnit[ptr](?c.slots));
    ret err_failed;
}

fun width(c: *Cache) usize {
    ret c.rows.size;
}

# the slot of an analysis of a function, grown to reach it
fun slot(c: *Cache, f: Function, a: Analysis) res[*ptr, allocator.Error] {
    val at: usize = f::usize * width(c) + a::usize;
    for (c.slots.len <= at) {
        val res_pushed: res[usize, allocator.Error] = vector.push[ptr](?c.slots, nil);
        if (sel res_pushed.err) { ret res[*ptr, allocator.Error].err{res_pushed.err}; }
    }
    ret res[*ptr, allocator.Error].ok{?c.slots.data[at]};
}

# an analysis of a function, computed now unless the cache holds it
# ---
# c:   the cache
# f:   the function
# a:   the analysis, a row of the registry
# ret: the analysis, valid until the cache drops it, or why it was refused: a row
#      the reader did not name is a defect of its record
pub fun get(c: *Cache, f: Function, a: Analysis) res[ptr, refusal.Error] {
    if (a::usize >= width(c)) { ret res[ptr, refusal.Error].err{refusal.Error.reason{"no registry row has this analysis"}}; }
    if (!holds(c.allowed, a)) { ret res[ptr, refusal.Error].err{refusal.Error.unneeded{a}}; }
    val res_slot: res[*ptr, allocator.Error] = slot(c, f, a);
    if (sel res_slot.err)    { ret res[ptr, refusal.Error].err{refusal.Error.alloc{res_slot.err}}; }
    if (@res_slot.ok != nil) { ret res[ptr, refusal.Error].ok{@res_slot.ok}; }
    val compute:  Compute                 = c.rows.data[a].compute;
    val res_made: res[ptr, refusal.Error] = compute(c, f);
    if (sel res_made.err) { ret res_made; }
    # the compute may have grown the slots, so the slot is found again
    val res_again: res[*ptr, allocator.Error] = slot(c, f, a);
    if (sel res_again.err) {
        c.rows.data[a].release(c.m.a, res_made.ok);
        ret res[ptr, refusal.Error].err{refusal.Error.alloc{res_again.err}};
    }
    @res_again.ok = res_made.ok;
    ret res_made;
}

# the analyses a kept set leaves: those it holds whose needs it leaves too
fun closure(c: *Cache, kept: Set) Set {
    var left: Set   = NONE;
    var i:    usize = 0;
    for (i < width(c)) {
        val a:     Analysis = (i::u32);
        val needs: Set      = c.rows.data[i].needs;
        if (holds(kept, a) && (needs & left) == needs) { left = with(left, a); }
        i = i + 1;
    }
    ret left;
}

# give back every analysis of the function at slot base outside left, the
# ones that need others first
fun drop_from(c: *Cache, base: usize, left: Set) err[allocator.Error] {
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:          usize                = width(c);
    for (i > 0) {
        i = i - 1;
        val at: usize = base + i;
        if (at < c.slots.len && c.slots.data[at] != nil && !holds(left, (i::u32))) {
            keep(?err_failed, c.rows.data[i].release(c.m.a, c.slots.data[at]));
            c.slots.data[at] = nil;
        }
    }
    ret err_failed;
}

# drop every analysis of a function outside kept, and every one that needs a
# dropped one
# ---
# c:    the cache
# f:    the function
# kept: the analyses that stay valid
# ret:  ok, or the first release the allocator refused
pub fun drop(c: *Cache, f: Function, kept: Set) err[allocator.Error] {
    ret drop_from(c, f::usize * width(c), closure(c, kept));
}

# drop every analysis of every function outside kept, and every one that
# needs a dropped one
pub fun drop_all(c: *Cache, kept: Set) err[allocator.Error] {
    if (width(c) == 0) { ret err[allocator.Error].ok{}; }
    val left:       Set                  = closure(c, kept);
    var err_failed: err[allocator.Error] = err[allocator.Error].ok{};
    var base:       usize                = 0;
    for (base < c.slots.len) {
        keep(?err_failed, drop_from(c, base, left));
        base = base + width(c);
    }
    ret err_failed;
}

# drop every analysis of a function, which its pass changed
pub fun forget(c: *Cache, f: Function) err[allocator.Error] {
    ret drop(c, f, NONE);
}
