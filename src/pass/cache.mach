# the analysis cache: each analysis of a function computed on request and kept
# until a pass that does not preserve it changes the function
#
# an analysis is a row of a registry, keyed by its position. a row may need
# rows before it, and dropping an analysis drops every analysis that needs it,
# so nothing is served that was computed from something stale. a pass that
# changes a function and then asks about it again forgets it first.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.failure.Why;
use mirl.target.record.Target;

# an analysis, as its row in the registry
# ---
# index: the row's position
pub rec Analysis {
    index: u32;
}

# a set of analyses, bit i holding registry row i
pub def Set: u64;

# the most rows a registry may have
pub val ROWS: u32 = 64;

# no analysis
pub val NONE: Set = 0;

# every analysis
pub val ALL: Set = 0xffffffffffffffff;

# a set of one analysis
pub fun one(a: Analysis) Set {
    ret 1u64 << a.index::u64;
}

# a set with an analysis added
pub fun with(s: Set, a: Analysis) Set {
    ret s | one(a);
}

# whether a set holds an analysis
pub fun holds(s: Set, a: Analysis) bool {
    ret (s & one(a)) != 0;
}

# compute an analysis of a function, asking the cache for the ones it needs
pub def Compute: fun(*Cache, Function) res[ptr, Why];

# give back an analysis a compute made
pub def Release: fun(*allocator.Allocator, ptr) err[allocator.Error];

# one analysis of the registry
# ---
# name:    its name
# needs:   the analyses before it that it is computed from
# compute: how it is computed
# release: how it is given back
pub rec Row {
    name:    str;
    needs:   Set;
    compute: Compute;
    release: Release;
}

# the analyses of a module's functions
# ---
# m:     the module, whose allocator the analyses take
# t:     the target the module is built for, which analyses of sizes read
# rows:  the registry
# slots: each function's analyses, a row's apart, nil where none is held
pub rec Cache {
    m:     *Module;
    t:     *Target;
    rows:  Slice[Row];
    slots: vector.Vector[ptr];
}

# the first registry row that needs itself or a row after it, or the row
# count when the registry is too large for a set
pub fun check(rows: Slice[Row]) opt[u32] {
    if (rows.size > ROWS::usize) { ret opt[u32].some{ROWS}; }
    var i: usize = 0;
    for (i < rows.size) {
        val later: u64 = ~((1u64 << i::u64) - 1);
        if ((rows.data[i].needs & later) != 0) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# an empty cache over a registry that `check` accepts
pub fun init(m: *Module, t: *Target, rows: Slice[Row]) Cache {
    ret Cache{m: m, t: t, rows: rows, slots: vector.init[ptr](m.a)};
}

# give back every analysis held, and the cache's storage
pub fun dnit(c: *Cache) err[allocator.Error] {
    var failed: err[allocator.Error] = drop_all(c, NONE);
    keep(?failed, vector.dnit[ptr](?c.slots));
    ret failed;
}

fun width(c: *Cache) usize {
    ret c.rows.size;
}

# the slot of an analysis of a function, grown to reach it
fun slot(c: *Cache, f: Function, a: Analysis) res[*ptr, allocator.Error] {
    val at: usize = f.index::usize * width(c) + a.index::usize;
    for (c.slots.len <= at) {
        val pushed: res[usize, allocator.Error] = vector.push[ptr](?c.slots, nil);
        if (sel pushed.err) { ret res[*ptr, allocator.Error].err{pushed.err}; }
    }
    ret res[*ptr, allocator.Error].ok{?c.slots.data[at]};
}

# an analysis of a function, computed now unless the cache holds it
# ---
# c:   the cache
# f:   the function
# a:   the analysis, a row of the registry
# ret: the analysis, valid until the cache drops it, or why it was refused
pub fun get(c: *Cache, f: Function, a: Analysis) res[ptr, Why] {
    if (a.index::usize >= width(c)) { ret res[ptr, Why].err{Why.reason{"no registry row has this analysis"}}; }
    val s: res[*ptr, allocator.Error] = slot(c, f, a);
    if (sel s.err)    { ret res[ptr, Why].err{Why.alloc{s.err}}; }
    if (@s.ok != nil) { ret res[ptr, Why].ok{@s.ok}; }
    val compute: Compute       = c.rows.data[a.index].compute;
    val made:    res[ptr, Why] = compute(c, f);
    if (sel made.err) { ret made; }
    # the compute may have grown the slots, so the slot is found again
    val again: res[*ptr, allocator.Error] = slot(c, f, a);
    if (sel again.err) {
        c.rows.data[a.index].release(c.m.a, made.ok);
        ret res[ptr, Why].err{Why.alloc{again.err}};
    }
    @again.ok = made.ok;
    ret made;
}

# whether the cache holds an analysis of a function
pub fun held(c: *Cache, f: Function, a: Analysis) bool {
    val at: usize = f.index::usize * width(c) + a.index::usize;
    ret a.index::usize < width(c) && at < c.slots.len && c.slots.data[at] != nil;
}

# the analyses a kept set leaves: those it holds whose needs it leaves too
fun closure(c: *Cache, kept: Set) Set {
    var left: Set   = NONE;
    var i:    usize = 0;
    for (i < width(c)) {
        val a:     Analysis = Analysis{index: i::u32};
        val needs: Set      = c.rows.data[i].needs;
        if (holds(kept, a) && (needs & left) == needs) { left = with(left, a); }
        i = i + 1;
    }
    ret left;
}

# give back every analysis of the function at slot base outside left, the
# ones that need others first
fun drop_from(c: *Cache, base: usize, left: Set) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = width(c);
    for (i > 0) {
        i = i - 1;
        val at: usize = base + i;
        if (at < c.slots.len && c.slots.data[at] != nil && !holds(left, Analysis{index: i::u32})) {
            keep(?failed, c.rows.data[i].release(c.m.a, c.slots.data[at]));
            c.slots.data[at] = nil;
        }
    }
    ret failed;
}

# drop every analysis of a function outside kept, and every one that needs a
# dropped one
# ---
# c:    the cache
# f:    the function
# kept: the analyses that stay valid
# ret:  ok, or the first release the allocator refused
pub fun drop(c: *Cache, f: Function, kept: Set) err[allocator.Error] {
    ret drop_from(c, f.index::usize * width(c), closure(c, kept));
}

# drop every analysis of every function outside kept, and every one that
# needs a dropped one
pub fun drop_all(c: *Cache, kept: Set) err[allocator.Error] {
    if (width(c) == 0) { ret err[allocator.Error].ok{}; }
    val left:   Set                  = closure(c, kept);
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var base:   usize                = 0;
    for (base < c.slots.len) {
        keep(?failed, drop_from(c, base, left));
        base = base + width(c);
    }
    ret failed;
}

# drop every analysis of a function, which its pass changed
pub fun forget(c: *Cache, f: Function) err[allocator.Error] {
    ret drop(c, f, NONE);
}
