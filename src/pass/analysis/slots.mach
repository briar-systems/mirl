# the slots analysis: what each stack slot of a function is, the one rule every reader of a slot's facts takes
#
# it is two analyses, the second reading the first. the addresses (`Addresses`) say per alloca whether the slot
# escapes, whether a secret offset moves its address and whether a kept or volatile access touches it. they are read
# from the operands and edge arguments of the instructions the body places, their opcodes, flags and the values they
# name alone, so they do not change when an instruction moves between blocks or when an edge enters a block of its
# own, and never read the graph. the slots (`Slots`) say per alloca the parts its accesses cut it into and whether
# some path from the entry reads it before any store writes it, which reads where every access stands and the graph.
# the analysis cache holds each in a schedule, the memory analysis reads which slots escape, and the constant-time
# checks compute both afresh at emission (`mirl.ct.fresh`), so a slot is judged by one rule wherever it is asked about.
#
# a function's walk follows the stores it makes to its own frame, below its
# caller's stack pointer, so a read of a slot holds what the function stored
# there. three things break that. a slot whose address escapes, as an operand
# of anything but a load's or a store's address or the base of a `ptr.add`,
# `ptr.member` or `ptr.index`, or as the argument of an edge, may be written by
# another party unseen: that slot is escaped, and nothing but the accesses
# whose address is formed from it through those moves reaches it while it is
# not. a secret offset moving its address is a secret address as any other:
# that slot is moved. a read no store reaches on some path from the entry reads
# stale stack an earlier frame may have left a secret in, while the walk seeds
# no frame memory: that slot is stale. a slot any of the three holds of is not
# readable, so a callee reading one may read its caller's secrets, and a
# constant-time function whose own frame has a stale slot is refused, as its
# walk takes the stale read as public.
#
# the stale part is a backward problem over the graph view, of the bytes of
# each slot that is not escaped, in parts: the runs between the first and
# last byte of each access whose bytes it knows, so a slot of any size takes
# as many parts as its accesses make. an access reaches its slot at a byte
# offset where every step moving the address is constant: a `ptr.add` of a
# constant, a `ptr.member` at its member's offset or a `ptr.index` of a
# constant index at its stride, as the front end and the legalisations that
# take an aggregate apart form them. a store writes the bytes of its value's
# type there and a load reads the bytes of its result's, a fill of a constant
# length writes that many and a copy of one reads that many of its source
# before it writes as many of its destination, so a fill a front end makes
# before it writes a secret aggregate's members covers the aggregate's padding
# (the ir spec's rule that a secret aggregate's padding is zero, mirl#560),
# while padding no fill or whole store writes is read stale by a load of the
# whole. a load or store that states a frame extent (`mirl.ir.metadata.Extent`)
# reads or writes the whole range it states, as each access of the loop the
# bulk legalisation makes of a copy or fill stands for the copy or fill: a
# load reads every byte of it and a store writes every byte of it before the
# loop leaves, which is the statement trusted. a load at an offset not known
# reads every byte, a store at one writes none, and a slot of no size the
# layout states is written by none. a byte live into the entry is read stale.
#
# a `slot.begin` or `slot.end` of a slot makes its bytes unwritten again, as
# its storage may have held another slot's: a read of a byte no store reaches
# since the slot's last marker reads stale. in a block, a marker kills every
# part of its slot and marks it begun, a read of a begun part written since by
# no store is stale where it stands, and a part begun and not written again
# by the block's end that is live out of the block is stale. a marker is a
# use that keeps its slot's address within the body.
#
# cost: the addresses are one scan of the body's operands and edges, each address traced back through its moves. the
# slots are two scans of its accesses, a sort of the cuts, and one backward problem over the graph whose facts are the
# parts of every slot (`mirl.ir.cfg.flow`), held as lists, so it grows with the parts each block reads, writes and
# holds live, not with the blocks times the parts.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;

use mirl.base.slice;
use secret_globals: mirl.ct.global;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.cfg.view;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use mirl.ir.metadata;
use mirl.ir.module;
use mirl.ir.module.Error;
use mirl.ir.module.Module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Row;
use mirl.ir.opcode.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use address_steps: mirl.target.steps;

# what the uses of each slot's address say of it, one bit per instruction of the body in each set, set where the
# instruction is an alloca whose slot is so
# ---
# count:   the instructions the body had when they were found, which the sets cover
# escaped: the slots whose address escapes
# moved:   the slots a secret offset moves the address of
# touched: the slots a kept or volatile access reaches
pub rec Addresses {
    count:   u32;
    escaped: vector.Vector[u64];
    moved:   vector.Vector[u64];
    touched: vector.Vector[u64];
}

# the slots of one function, one bit per instruction of its body in its set, set where the instruction is an alloca
# whose slot is so
# ---
# words:     the words of the set
# addresses: the addresses the slots were found from, which say which slots escape or move, valid as long as the
#            slots are
# stale:     the slots neither escaped nor moved that some path from the entry reads before any store writes them
# parts:     the parts each slot's accesses cut it into
pub rec Slots {
    words:     u32;
    addresses: *Addresses;
    stale:     vector.Vector[u64];
    parts:     Parts;
}

# the alloca address `v` of body `b` is formed from and whether every offset
# moving it is public
rec Traced {
    slot:   u32;
    public: bool;
}

# the bytes of its slot an access reaches, from `at`, `len` of them, none where its offset is not known
rec Span {
    at:  u64;
    len: u64;
}

# the parts of every slot of a body, the first part of each alloca's, their count and its size, by instruction, and the
# offsets the parts run between
# ---
# total: how many parts every slot has together
# first: the first part of each alloca
# count: the parts of each alloca, none for any other instruction: one fewer than its cuts, or 1 for a slot of no size
#        the layout states
# size:  the bytes of each alloca, 0 where the layout states none
# base:  where each alloca's cuts start in `cuts`
# cuts:  each alloca's offsets in ascending order, 0, its size and each first and one past the last byte of an access
#        within it, part `k` running from cut `k` to cut `k + 1`
pub rec Parts {
    total: u32;
    first: vector.Vector[u32];
    count: vector.Vector[u32];
    size:  vector.Vector[u64];
    base:  vector.Vector[u32];
    cuts:  vector.Vector[u64];
}

# an offset of a slot a part starts or ends at
rec Cut {
    slot: u32;
    at:   u64;
}

# what the analysis keeps of one part, each mark one more than a block
# ---
# since: the mark of the block the scan is in, where the block wrote the part since its start or its slot's last marker
# begun: the mark of the block the scan is in, where a marker in the block began the part
# live:  the mark of the block the part is live out of, as the stale reads are read off
# owner: the alloca the part is of
rec Part {
    since: u32;
    begun: u32;
    live:  u32;
    owner: u32;
}

# what a scan of a body gathers: in `cutting`, the offsets each access's bytes start and end at, else each block's
# stale reads and writes. `held` marks each part with the block's `mark`, `opened` lists the parts a marker in the
# block began, `unset` lists each block's parts begun and not written again by its end, and `direct` holds the slots a
# read of a begun part no store wrote reads stale
rec Scan {
    m:       *Module;
    l:       *Layout;
    b:       *Body;
    p:       *Parts;
    cutting: bool;
    found:   vector.Vector[Cut];
    gen:     *Lists[u32];
    kill:    *Lists[u32];
    held:    *vector.Vector[Part];
    opened:  *vector.Vector[u32];
    unset:   *Lists[u32];
    direct:  *vector.Vector[u64];
    mark:    u32;
    failed:  err[allocator.Error];
}

fun bit(s: *vector.Vector[u64], base: usize, n: u32) bool {
    ret ((s.data[base + (n / 64)::usize] >> (n % 64)::u64) & 1) != 0;
}

fun set(s: *vector.Vector[u64], base: usize, n: u32) {
    val at: usize = base + (n / 64)::usize;
    s.data[at] = s.data[at] | (1u64 << (n % 64)::u64);
}

# the slot address `v` of body `b` is formed from past its steps
# (`mirl.target.steps`), none for an address of no alloca of the body
fun traced(b: *Body, v: Value) opt[Traced] {
    var at:     Value = v;
    var public: bool  = true;
    var steps:  usize = 0;
    for (steps <= b.values.len) {
        val def: Def = b.values.data[at].def;
        if (!(sel def.result))                                                  { ret opt[Traced].none{}; }
        if (b.instructions.data[def.result.instruction].opcode == table.ALLOCA) { ret opt[Traced].some{Traced{slot: def.result.instruction, public: public}}; }
        val opt_step: opt[Instruction] = address_steps.former(b, at);
        if (sel opt_step.none) { ret opt[Traced].none{}; }
        val d: *InstructionData = ?b.instructions.data[opt_step.some];
        var k: usize            = 1;
        for (k < d.operands.len) {
            if (b.values.data[d.operands.data[k]].secret) { public = false; }
            k = k + 1;
        }
        at    = d.operands.data[0];
        steps = steps + 1;
    }
    ret opt[Traced].none{};
}

# the alloca address `v` of body `b` is formed from through moves, none for an address of no alloca of the body
pub fun slot_of(b: *Body, v: Value) opt[Instruction] {
    val opt_traced: opt[Traced] = traced(b, v);
    if (sel opt_traced.none) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{opt_traced.some.slot};
}

# the bytes the slot of alloca `slot` of body `b` takes under layout `l`, none where the layout states none
pub fun slot_size(l: *Layout, b: *Body, slot: Instruction) opt[u64] {
    val opt_allocated: opt[Type] = allocated(b, slot);
    if (sel opt_allocated.none) { ret opt[u64].none{}; }
    ret size_of(l, opt_allocated.some);
}

# the bytes a value of type `ty` takes under layout `l` in the slot space, none where the layout states none
pub fun bytes_of(l: *Layout, ty: Type) opt[u64] {
    ret size_of(l, ty);
}

# the type immediate `i` of instruction `d` holds, none for none
fun type_at(d: *InstructionData, i: usize) opt[Type] {
    if (i >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[i];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

# the type alloca `slot` allocates, none where its immediate states none
fun allocated(b: *Body, slot: u32) opt[Type] {
    ret type_at(?b.instructions.data[slot::usize], 0);
}

# the bytes a value of type `ty` takes in the slot space, every slot's and so every slot address's, none where the
# layout states none
fun size_of(l: *Layout, ty: Type) opt[u64] {
    val res_space: res[u32, record.Error] = record.slot_space(l.target);
    if (sel res_space.err) { ret opt[u64].none{}; }
    val res_size: res[u64, record.Error] = layout.size(l, ty, res_space.ok);
    if (sel res_size.err) { ret opt[u64].none{}; }
    ret opt[u64].some{res_size.ok};
}

# the byte offset from its slot address `v` of body `b` of `m` is at under layout `l`, as its steps move it
# (`mirl.target.steps`), none where a step moving it is not constant, it is formed from no alloca or it lies below
# the slot
pub fun offset_in(m: *Module, l: *Layout, b: *Body, v: Value) opt[u64] {
    val f:   address_steps.Formed = address_steps.formed(m, l, b, v);
    val def: Def                  = b.values.data[f.root].def;
    if (!f.known || f.offset < 0)                                           { ret opt[u64].none{}; }
    if (!(sel def.result))                                                  { ret opt[u64].none{}; }
    if (b.instructions.data[def.result.instruction].opcode != table.ALLOCA) { ret opt[u64].none{}; }
    ret opt[u64].some{f.offset::u64};
}

# the bytes of its slot access `d` reaches through address `v`, `len` of them, none where their offset is not known
fun span(m: *Module, l: *Layout, b: *Body, v: Value, len: opt[u64]) opt[Span] {
    if (sel len.none) { ret opt[Span].none{}; }
    val opt_offset_of: opt[u64] = offset_in(m, l, b, v);
    if (sel opt_offset_of.none) { ret opt[Span].none{}; }
    ret opt[Span].some{Span{at: opt_offset_of.some, len: len.some}};
}

# the bytes load `d` reads, by its result's type
fun loaded(l: *Layout, b: *Body, d: *InstructionData) opt[u64] {
    if (d.results.len == 0) { ret opt[u64].none{}; }
    ret size_of(l, b.values.data[d.results.data[0]].type);
}

# the bytes store `d` writes, by its value's type
fun stored(l: *Layout, b: *Body, d: *InstructionData) opt[u64] {
    if (d.operands.len < 2) { ret opt[u64].none{}; }
    ret size_of(l, b.values.data[d.operands.data[1]].type);
}

# the bytes fill `d` writes, its length where it is constant
fun filled(m: *Module, b: *Body, d: *InstructionData) opt[u64] {
    if (d.operands.len < 3) { ret opt[u64].none{}; }
    val opt_constant_of: opt[i64] = secret_globals.constant_of(m, b, d.operands.data[2]);
    if (sel opt_constant_of.none) { ret opt[u64].none{}; }
    if (opt_constant_of.some < 0) { ret opt[u64].none{}; }
    ret opt[u64].some{opt_constant_of.some::u64};
}

# the bytes copy `d` moves, its length where it is constant
fun copied(m: *Module, b: *Body, d: *InstructionData) opt[u64] {
    ret filled(m, b, d);
}

# the bytes of its slot the load or store `d` reaches through address `v`: the range it states where it states a frame
# extent, else the bytes of `len` at the offset it is at
fun reached(m: *Module, l: *Layout, b: *Body, d: *InstructionData, v: Value, len: opt[u64]) opt[Span] {
    if (metadata.states_extent(?d.metadata)) { ret opt[Span].some{Span{at: d.metadata.extent.offset, len: d.metadata.extent.length}}; }
    ret span(m, l, b, v, len);
}

fun compare_cuts(x: *Cut, y: *Cut) i64 {
    if (x.slot != y.slot) {
        if (x.slot < y.slot) { ret -1; }
        ret 1;
    }
    if (x.at < y.at) { ret -1; }
    if (x.at > y.at) { ret 1; }
    ret 0;
}

# note a cut of `slot` at `at`, a refused push kept as the scan's failure
fun cut(sc: *Scan, slot: u32, at: u64) {
    val res_pushed: res[usize, allocator.Error] = vector.push[Cut](?sc.found, Cut{slot: slot, at: at});
    if (sel res_pushed.err) { sc.failed = err[allocator.Error].err{res_pushed.err}; }
}

# the size of every alloca of body `b` of `m`, as the parts of a slot of no access, and the cuts at 0 and its size
fun sized(sc: *Scan) err[allocator.Error] {
    val b:          *Body                = sc.b;
    var err_failed: err[allocator.Error] = slice.fill[u32](?sc.p.first, b.instructions.len, 0);
    if (!(sel err_failed.err)) { err_failed = slice.fill[u32](?sc.p.count, b.instructions.len, 0); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?sc.p.size, b.instructions.len, 0); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u32](?sc.p.base, b.instructions.len, 0); }
    if (sel err_failed.err)    { ret err_failed; }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                val n: u32 = i;
                if (b.instructions.data[n].opcode == table.ALLOCA) {
                    val opt_slot_size: opt[u64] = slot_size(sc.l, b, n);
                    sc.p.count.data[n] = 1;
                    if (sel opt_slot_size.some) {
                        if (opt_slot_size.some > 0) {
                            sc.p.size.data[n] = opt_slot_size.some;
                            cut(sc, n, 0);
                            cut(sc, n, opt_slot_size.some);
                        }
                    }
                }
                i = b.instructions.data[i].next;
            }
        }
        k = k + 1;
    }
    ret sc.failed;
}

# the parts of every alloca of `sc.b` from the cuts its scan found: one between each two cuts of a slot of known size,
# else one
fun parted(sc: *Scan) err[allocator.Error] {
    val p: *Parts = sc.p;
    sort.sort_by[Cut](sc.found.data, sc.found.len, compare_cuts);
    var total: u32   = 0;
    var i:     usize = 0;
    for (i < sc.found.len) {
        val c: Cut = sc.found.data[i];
        if (p.size.data[c.slot::usize] == 0) {
            i = i + 1;
            cnt;
        }
        if (p.cuts.len == 0 || i == 0 || sc.found.data[i - 1].slot != c.slot) { p.base.data[c.slot::usize] = p.cuts.len::u32; }
        or (sc.found.data[i - 1].at == c.at) {
            i = i + 1;
            cnt;
        }
        val res_pushed: res[usize, allocator.Error] = vector.push[u64](?p.cuts, c.at);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        i = i + 1;
    }
    val b: *Body = sc.b;
    var n: usize = 0;
    for (n < b.instructions.len) {
        if (p.count.data[n] != 0) {
            if (p.size.data[n] != 0) {
                var end: usize = p.base.data[n]::usize + 1;
                for (end < p.cuts.len && p.cuts.data[end] < p.size.data[n]) { end = end + 1; }
                p.count.data[n] = (end - p.base.data[n]::usize)::u32;
            }
            p.first.data[n] = total;
            total           = total + p.count.data[n];
        }
        n = n + 1;
    }
    p.total = total;
    ret err[allocator.Error].ok{};
}

# the index among `slot`'s cuts of the cut at `at`, which the scan made one
fun cut_at(p: *Parts, slot: u32, at: u64) u32 {
    val from: usize = p.base.data[slot::usize]::usize;
    var lo:   u32   = 0;
    var hi:   u32   = p.count.data[slot::usize];
    for (lo < hi) {
        val mid: u32 = (lo + hi) / 2;
        if (p.cuts.data[from + mid::usize] < at) { lo = mid + 1; }
        or                                       { hi = mid; }
    }
    ret lo;
}

# the parts of `slot` a span covers, as the first and one past the last, none for a span of no byte within a slot of
# known size
fun covered(p: *Parts, slot: u32, s: Span, first: *u32, last: *u32) bool {
    val size: u64 = p.size.data[slot::usize];
    if (size == 0 || s.len == 0 || s.at >= size) { ret false; }
    var end: u64 = s.at + s.len;
    if (end > size || end < s.at) { end = size; }
    @first = cut_at(p, slot, s.at);
    @last  = cut_at(p, slot, end);
    ret @first < @last;
}

# a read of `slot` by the block at `sc.mark` of the bytes `s` names, every byte where it names none: each part it
# reads that the block has not written yet, stale at once where a marker in the block began it
fun read(sc: *Scan, s: opt[Span], slot: u32) {
    val p:     *Parts = sc.p;
    val first: u32    = p.first.data[slot::usize];
    var from:  u32    = 0;
    var to:    u32    = p.count.data[slot::usize];
    if (sel s.some) {
        if (p.size.data[slot::usize] != 0) {
            var a: u32 = 0;
            var z: u32 = 0;
            if (!covered(p, slot, s.some, ?a, ?z)) { ret; }
            from = a;
            to   = z;
        }
    }
    var n: u32 = from;
    for (n < to) {
        if (sc.held.data[first + n].since != sc.mark) {
            if (sc.held.data[first + n].begun == sc.mark) { set(sc.direct, 0, slot); }
            or                                            { kept_failure(sc, flow.fact(sc.gen, first + n)); }
        }
        n = n + 1;
    }
}

# a refused push kept as the scan's failure
fun kept_failure(sc: *Scan, e: err[allocator.Error]) {
    if (sel e.err) { sc.failed = e; }
}

# a write of `slot` by the block at `sc.mark` of the bytes `s` names, none where it names none
fun wrote(sc: *Scan, s: opt[Span], slot: u32) {
    if (sel s.none) { ret; }
    val p:     *Parts = sc.p;
    val first: u32    = p.first.data[slot::usize];
    var a:     u32    = 0;
    var z:     u32    = 0;
    if (!covered(p, slot, s.some, ?a, ?z)) { ret; }
    var n: u32 = a;
    for (n < z) {
        kept_failure(sc, flow.fact(sc.kill, first + n));
        sc.held.data[first + n].since = sc.mark;
        n                             = n + 1;
    }
}

# a marker of `slot` by the block at `sc.mark`: every part killed, begun and unwritten
fun marked(sc: *Scan, slot: u32) {
    val p:     *Parts = sc.p;
    val first: u32    = p.first.data[slot::usize];
    var n:     u32    = 0;
    for (n < p.count.data[slot::usize]) {
        kept_failure(sc, flow.fact(sc.kill, first + n));
        if (sc.held.data[first + n].begun != sc.mark) {
            sc.held.data[first + n].begun = sc.mark;
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](sc.opened, first + n);
            if (sel res_pushed.err) { sc.failed = err[allocator.Error].err{res_pushed.err}; }
        }
        sc.held.data[first + n].since = 0;
        n                             = n + 1;
    }
}

# whether operand `k` of `d` is a use of a slot's address that keeps it within the body: an address a load or store
# reaches through, a base a move moves, the slot a marker names, the destination of a fill of a constant length, or
# either address of a copy of one
fun kept(m: *Module, b: *Body, d: *InstructionData, row: *Row, k: usize) bool {
    if (address_steps.past(d.opcode) || table.marks(d.opcode)) { ret k == 0; }
    if (d.opcode == table.MEM_FILL) {
        val opt_filled: opt[u64] = filled(m, b, d);
        ret k == 0 && (sel opt_filled.some);
    }
    if (d.opcode == table.MEM_COPY) {
        val opt_copied: opt[u64] = copied(m, b, d);
        ret k < 2 && (sel opt_copied.some);
    }
    if (d.opcode != table.LOAD && d.opcode != table.STORE) { ret false; }
    if (k >= $length_of(opcode_row.Operands))              { ret false; }
    ret sel row.operands[k].role.address;
}

# an access through address `v` of the bytes `s` names, a write where `writes`: in a scan cutting, the offsets they start
# and end at, else a read or write of the block's set. none of a slot a secret offset moves
fun access(sc: *Scan, v: Value, s: opt[Span], writes: bool) {
    val opt_traced: opt[Traced] = traced(sc.b, v);
    if (sel opt_traced.none)     { ret; }
    if (!opt_traced.some.public) { ret; }
    if (sc.cutting) {
        if (sel s.some) {
            if (s.some.len != 0) {
                cut(sc, opt_traced.some.slot, s.some.at);
                # a span past the last offset a word holds ends past every slot, whose size is cut already
                if (s.some.len <= ~(0::u64) - s.some.at) { cut(sc, opt_traced.some.slot, s.some.at + s.some.len); }
            }
        }
        ret;
    }
    if (writes) { wrote(sc, s, opt_traced.some.slot); }
    or          { read(sc, s, opt_traced.some.slot); }
}

# the accesses of instruction `d` to the slots, what a copy reads before what it writes, and the parts a marker begins
# again
fun accesses(sc: *Scan, d: *InstructionData) {
    val m: *Module = sc.m;
    val l: *Layout = sc.l;
    val b: *Body   = sc.b;
    if (d.opcode == table.LOAD && d.operands.len > 0)     { access(sc, d.operands.data[0], reached(m, l, b, d, d.operands.data[0], loaded(l, b, d)), false); }
    or (d.opcode == table.STORE && d.operands.len > 0)    { access(sc, d.operands.data[0], reached(m, l, b, d, d.operands.data[0], stored(l, b, d)), true); }
    or (d.opcode == table.MEM_FILL && d.operands.len > 0) { access(sc, d.operands.data[0], span(m, l, b, d.operands.data[0], filled(m, b, d)), true); }
    or (d.opcode == table.MEM_COPY && d.operands.len > 1) {
        access(sc, d.operands.data[1], span(m, l, b, d.operands.data[1], copied(m, b, d)), false);
        access(sc, d.operands.data[0], span(m, l, b, d.operands.data[0], copied(m, b, d)), true);
    }
    or (table.marks(d.opcode) && d.operands.len == 1 && !sc.cutting) {
        val opt_traced: opt[Traced] = traced(b, d.operands.data[0]);
        if (sel opt_traced.some) { marked(sc, opt_traced.some.slot); }
    }
}

# mark the slot of each operand and edge argument of `d` that lets its address escape, that a secret offset moves or
# that a kept or volatile access reaches
fun uses(ad: *Addresses, m: *Module, b: *Body, d: *InstructionData, row: opt[*Row]) {
    val marked: bool  = d.metadata.flags.kept || d.metadata.flags.volatile;
    var j:      usize = 0;
    for (j < d.operands.len) {
        val opt_traced: opt[Traced] = traced(b, d.operands.data[j]);
        if (sel opt_traced.some) {
            var held: bool = false;
            if (sel row.some)            { held = kept(m, b, d, row.some, j); }
            if (!held)                   { set(?ad.escaped, 0, opt_traced.some.slot); }
            if (!opt_traced.some.public) { set(?ad.moved, 0, opt_traced.some.slot); }
            if (marked)                  { set(?ad.touched, 0, opt_traced.some.slot); }
        }
        j = j + 1;
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val edge: *Edge = ?d.edges.data[e];
        var n:    usize = 0;
        for (n < edge.arguments.len) {
            val opt_traced: opt[Traced] = traced(b, edge.arguments.data[n]);
            if (sel opt_traced.some) { set(?ad.escaped, 0, opt_traced.some.slot); }
            n = n + 1;
        }
        e = e + 1;
    }
}

# gather each block's stale reads and writes of the parts of the slots, or in a scan cutting the offsets the parts
# run between
fun scan(sc: *Scan) {
    val b: *Body = sc.b;
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            sc.mark = (k + 1)::u32;
            vector.clear[u32](sc.opened);
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                accesses(sc, ?b.instructions.data[i]);
                i = b.instructions.data[i].next;
            }
            var o: usize = 0;
            for (!sc.cutting && o < sc.opened.len) {
                if (sc.held.data[sc.opened.data[o]].since != sc.mark) { kept_failure(sc, flow.fact(sc.unset, sc.opened.data[o])); }
                o = o + 1;
            }
        }
        if (!sc.cutting) {
            kept_failure(sc, flow.next(sc.gen));
            kept_failure(sc, flow.next(sc.kill));
            kept_failure(sc, flow.next(sc.unset));
        }
        k = k + 1;
    }
}

# the addresses of function `f` of `m`
# ---
# a:   the allocator the result takes
# m:   the module
# f:   the function, which has a body
# ret: its addresses, or why they could not be found
pub fun addresses(a: *allocator.Allocator, m: *Module, f: Function) res[Addresses, Error] {
    val res_body: res[*Body, Error] = module.body(m, f);
    if (sel res_body.err) { ret res[Addresses, Error].err{res_body.err}; }
    val b:          *Body                = res_body.ok;
    val count:      u32                  = b.instructions.len::u32;
    val words:      u32                  = (count + 63) / 64;
    var ad:         Addresses            = Addresses{count: count, escaped: vector.init[u64](a), moved: vector.init[u64](a), touched: vector.init[u64](a)};
    var err_failed: err[allocator.Error] = slice.fill[u64](?ad.escaped, words::usize, 0);
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?ad.moved, words::usize, 0); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?ad.touched, words::usize, 0); }
    if (sel err_failed.err) {
        addresses_dnit(?ad);
        ret res[Addresses, Error].err{Error.alloc{err_failed.err}};
    }
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            var i: Instruction = b.blocks.data[k].first;
            for (i != NO_INSTRUCTION) {
                val d: *InstructionData = ?b.instructions.data[i];
                uses(?ad, m, b, d, table.at(d.opcode));
                i = d.next;
            }
        }
        k = k + 1;
    }
    ret res[Addresses, Error].ok{ad};
}

# give back the storage of a function's addresses
pub fun addresses_dnit(ad: *Addresses) {
    vector.dnit[u64](?ad.escaped);
    vector.dnit[u64](?ad.moved);
    vector.dnit[u64](?ad.touched);
}

# give back the storage of a function's slots, not the addresses they were found from
pub fun dnit(s: *Slots) {
    vector.dnit[u64](?s.stale);
    parts_dnit(?s.parts);
}

fun parts_dnit(p: *Parts) {
    vector.dnit[u32](?p.first);
    vector.dnit[u32](?p.count);
    vector.dnit[u64](?p.size);
    vector.dnit[u32](?p.base);
    vector.dnit[u64](?p.cuts);
}

# the slots of function `f` of `m`, computed afresh over a graph view of its own
# ---
# a:   the allocator the result takes
# m:   the module
# l:   the module's layout, which sizes each slot and access and places each member and element
# f:   the function, which has a body
# ad:  its addresses, which the slots read for as long as they are held
# ret: its slots, or why they could not be found
pub fun of(a: *allocator.Allocator, m: *Module, l: *Layout, f: Function, ad: *Addresses) res[Slots, Error] {
    val res_made: res[Graph, Error] = view.of(m, f);
    if (sel res_made.err) { ret res[Slots, Error].err{res_made.err}; }
    var g: Graph = res_made.ok;
    fin { graph.dnit(?g); }
    ret compute(a, m, l, f, ?g, ad);
}

# the slots of function `f` of `m` over `g`, the graph view of its body, and `ad`, its addresses, the one compute of
# the analysis
pub fun compute(a: *allocator.Allocator, m: *Module, l: *Layout, f: Function, g: *Graph, ad: *Addresses) res[Slots, Error] {
    val res_body: res[*Body, Error] = module.body(m, f);
    if (sel res_body.err) { ret res[Slots, Error].err{res_body.err}; }
    val b:      *Body               = res_body.ok;
    val words:  u32                 = (b.instructions.len::u32 + 63) / 64;
    var s:      Slots               = Slots{words: words, addresses: ad, stale: vector.init[u64](a), parts: Parts{total: 0, first: vector.init[u32](a), count: vector.init[u32](a), size: vector.init[u64](a), base: vector.init[u32](a), cuts: vector.init[u64](a)}};
    var gen:    Lists[u32]          = graph.lists_init[u32](a);
    var kill:   Lists[u32]          = graph.lists_init[u32](a);
    var into:   Lists[u32]          = graph.lists_init[u32](a);
    var out:    Lists[u32]          = graph.lists_init[u32](a);
    var unset:  Lists[u32]          = graph.lists_init[u32](a);
    var held:   vector.Vector[Part] = vector.init[Part](a);
    var opened: vector.Vector[u32]  = vector.init[u32](a);
    var dirs:   vector.Vector[u64]  = vector.init[u64](a);
    var w:      flow.Work           = flow.work(a);
    fin {
        graph.lists_dnit[u32](?gen);
        graph.lists_dnit[u32](?kill);
        graph.lists_dnit[u32](?into);
        graph.lists_dnit[u32](?out);
        graph.lists_dnit[u32](?unset);
        vector.dnit[Part](?held);
        vector.dnit[u32](?opened);
        vector.dnit[u64](?dirs);
        flow.work_dnit(?w);
    }
    var sc: Scan = Scan{m: m, l: l, b: b, p: ?s.parts, cutting: true, found: vector.init[Cut](a), gen: ?gen, kill: ?kill, held: ?held, opened: ?opened, unset: ?unset, direct: ?dirs, mark: 0, failed: err[allocator.Error].ok{}};
    fin { vector.dnit[Cut](?sc.found); }
    var err_failed: err[allocator.Error] = sized(?sc);
    if (!(sel err_failed.err)) {
        scan(?sc);
        err_failed = sc.failed;
    }
    if (!(sel err_failed.err)) { err_failed = parted(?sc); }
    val parts: usize = s.parts.total::usize;
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?s.stale, words::usize, 0); }
    if (!(sel err_failed.err)) { err_failed = flow.rows(?gen); }
    if (!(sel err_failed.err)) { err_failed = flow.rows(?kill); }
    if (!(sel err_failed.err)) { err_failed = flow.rows(?unset); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[Part](?held, parts, Part{}); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u64](?dirs, words::usize, 0); }
    if (!(sel err_failed.err)) {
        sc.cutting = false;
        scan(?sc);
        err_failed = sc.failed;
    }
    if (!(sel err_failed.err)) { err_failed = flow.backward(?w, g, flow.Problem{facts: s.parts.total, gen: ?gen, kill: ?kill}, ?into, ?out); }
    if (sel err_failed.err) {
        dnit(?s);
        ret res[Slots, Error].err{Error.alloc{err_failed.err}};
    }
    val p: *Parts = ?s.parts;
    var i: usize  = 0;
    for (i < b.instructions.len) {
        var k: u32 = 0;
        for (k < p.count.data[i]) {
            held.data[(p.first.data[i] + k)::usize].owner = i::u32;
            k                                             = k + 1;
        }
        i = i + 1;
    }
    var n: u32 = 0;
    for (n::usize < b.blocks.len) {
        val mark:        u32        = n + 1;
        val live:        Slice[u32] = flow.row(?out, n);
        val begun_unset: Slice[u32] = flow.row(?unset, n);
        var k:           usize      = 0;
        for (k < live.size) {
            held.data[live.data[k]].live = mark;
            k                            = k + 1;
        }
        k = 0;
        for (k < begun_unset.size) {
            val part: Part = held.data[begun_unset.data[k]];
            if (part.live == mark) { set(?dirs, 0, part.owner); }
            k = k + 1;
        }
        n = n + 1;
    }
    val at_entry: u32 = (b.blocks.len + 1)::u32;
    if (b.blocks.len != 0) {
        val entry: Slice[u32] = flow.row(?into, 0);
        var k:     usize      = 0;
        for (k < entry.size) {
            held.data[entry.data[k]].live = at_entry;
            k                             = k + 1;
        }
    }
    i = 0;
    for (i < b.instructions.len) {
        val slot: u32  = i::u32;
        val free: bool = p.count.data[i] != 0 && !escaped(ad, slot) && !moved(ad, slot);
        if (free && bit(?dirs, 0, slot)) { set(?s.stale, 0, slot); }
        or (b.blocks.len != 0 && free) {
            var k: u32 = 0;
            for (k < p.count.data[i]) {
                if (held.data[p.first.data[i] + k].live == at_entry) {
                    set(?s.stale, 0, slot);
                    k = p.count.data[i];
                }
                or { k = k + 1; }
            }
        }
        i = i + 1;
    }
    ret res[Slots, Error].ok{s};
}

# whether the address of the slot of alloca `i` escapes, so something other than an access formed from it through
# moves may reach it. this and the two below answer yes for an instruction past what the sets cover: the cache keeps
# the addresses across an edit that adds instructions (`analysis.GATHERS`), and an instruction made since was never
# looked at, so nothing may be taken to hold of it
pub fun escaped(ad: *Addresses, i: Instruction) bool {
    ret i >= ad.count || bit(?ad.escaped, 0, i);
}

# whether a secret offset moves the address of the slot of alloca `i`
pub fun moved(ad: *Addresses, i: Instruction) bool {
    ret i >= ad.count || bit(?ad.moved, 0, i);
}

# whether a kept or volatile access reaches the slot of alloca `i`
pub fun touched(ad: *Addresses, i: Instruction) bool {
    ret i >= ad.count || bit(?ad.touched, 0, i);
}

# the offsets the parts of the slot of alloca `i` run between, ascending from 0 to its size, part `k` from offset `k`
# to offset `k + 1`, empty for a slot of no size the layout states, which is one part
pub fun cuts(s: *Slots, i: Instruction) Slice[u64] {
    val p: *Parts = ?s.parts;
    if (p.size.data[i::usize] == 0) { ret Slice[u64]{data: nil, size: 0}; }
    ret Slice[u64]{data: ?p.cuts.data[p.base.data[i::usize]::usize], size: p.count.data[i::usize]::usize + 1};
}

# the first alloca of `s` whose slot is stale, by its instruction, none when no slot is
pub fun stale(s: *Slots) opt[u32] {
    var w: usize = 0;
    for (w < s.words::usize) {
        val word: u64 = s.stale.data[w];
        if (word != 0) {
            var n: u32 = 0;
            for (((word >> n::u64) & 1) == 0) { n = n + 1; }
            ret opt[u32].some{(w::u32 * 64) + n};
        }
        w = w + 1;
    }
    ret opt[u32].none{};
}
