# what the analyses read of a function's values: a constant's number and the
# instruction that defines a value

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_row:   mirl.ir.opcode.row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.value.ValueData;

# a value read as a number
# ---
# ok:    the value is an integer constant or a zero constant
# value: its bits, zero extended
pub rec Konst {
    ok:    bool;
    value: Wide;
}

# the number a value holds when it is an integer constant or a zero constant
pub fun konst(m: *Module, b: *Body, v: Value) res[Konst, module.Error] {
    var k: Konst;
    if (v::usize >= b.values.len) { ret res[Konst, module.Error].err{module.Error.value{v}}; }
    val vd: *ValueData = ?b.values.data[v];
    if (!(sel vd.def.constant)) { ret res[Konst, module.Error].ok{k}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, vd.def.constant);
    if (sel res_constant_data.err) { ret res[Konst, module.Error].err{res_constant_data.err}; }
    if (sel res_constant_data.ok.integer) {
        k.ok    = true;
        k.value = word.of(res_constant_data.ok.integer.words);
    }
    or (sel res_constant_data.ok.zero) {
        k.ok = true;
    }
    ret res[Konst, module.Error].ok{k};
}

# the instruction whose result a value is, none for a parameter or constant
pub fun made(b: *Body, v: Value) opt[*InstructionData] {
    val vd: *ValueData = ?b.values.data[v];
    if (!(sel vd.def.result)) { ret opt[*InstructionData].none{}; }
    ret opt[*InstructionData].some{?b.instructions.data[vd.def.result.instruction]};
}

# the function whose address an instruction's row forms, none for any other
pub fun function_of(ins: *InstructionData) opt[Function] {
    val opt_opcode_at: opt[*opcode_row.Row] = opcode_table.at(ins.opcode);
    if (sel opt_opcode_at.none)                   { ret opt[Function].none{}; }
    if (!(sel opt_opcode_at.some.forms.function)) { ret opt[Function].none{}; }
    val at: u32 = opt_opcode_at.some.forms.function;
    if (at::usize >= ins.immediates.len) { ret opt[Function].none{}; }
    val imm: opcode_row.Immediate = ins.immediates.data[at];
    if (!(sel imm.function)) { ret opt[Function].none{}; }
    ret opt[Function].some{imm.function};
}

# whether an instruction is a call, before or after the abi placed its pieces
pub fun calls(ins: *InstructionData) bool {
    ret ins.opcode == opcode_table.CALL || ins.opcode == opcode_table.CALL_PLACED;
}

# the function a call calls, by its callee operand: the address of a function as a constant of no offset or as the
# result of an instruction whose row forms it, none for a callee of any other kind
pub fun callee(m: *Module, b: *Body, ins: *InstructionData) opt[Function] {
    if (!calls(ins) || ins.operands.len == 0) { ret opt[Function].none{}; }
    val v: Value = ins.operands.data[0];
    if (v::usize >= b.values.len) { ret opt[Function].none{}; }
    val vd: *ValueData = ?b.values.data[v];
    if (sel vd.def.constant) {
        val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, vd.def.constant);
        if (sel res_constant_data.err)                           { ret opt[Function].none{}; }
        if (!(sel res_constant_data.ok.address))                 { ret opt[Function].none{}; }
        if (!(sel res_constant_data.ok.address.symbol.function)) { ret opt[Function].none{}; }
        if (res_constant_data.ok.address.offset != 0)            { ret opt[Function].none{}; }
        ret opt[Function].some{res_constant_data.ok.address.symbol.function};
    }
    val opt_made: opt[*InstructionData] = made(b, v);
    if (sel opt_made.none) { ret opt[Function].none{}; }
    ret function_of(opt_made.some);
}
