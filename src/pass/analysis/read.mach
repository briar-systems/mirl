# what the analyses read of a function's values: a constant's number and the
# instruction that defines a value

use std.types.bool.bool;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.value.ValueData;

# a value read as a number
# ---
# ok:    the value is an integer constant
# value: its bits, zero extended
pub rec Konst {
    ok:    bool;
    value: Wide;
}

# the number a value holds when it is an integer constant
pub fun konst(m: *Module, b: *Body, v: Value) res[Konst, module.Error] {
    var k: Konst;
    if (v.index::usize >= b.values.len) { ret res[Konst, module.Error].err{module.Error.value{v}}; }
    val vd: *ValueData = ?b.values.data[v.index];
    if (!(sel vd.def.constant)) { ret res[Konst, module.Error].ok{k}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, vd.def.constant);
    if (sel got.err) { ret res[Konst, module.Error].err{got.err}; }
    if (sel got.ok.integer) {
        k.ok    = true;
        k.value = word.of(got.ok.integer.words);
    }
    or (sel got.ok.zero) {
        k.ok = true;
    }
    ret res[Konst, module.Error].ok{k};
}

# the instruction whose result a value is, none for a parameter or constant
pub fun made(b: *Body, v: Value) opt[*InstructionData] {
    val vd: *ValueData = ?b.values.data[v.index];
    if (!(sel vd.def.result)) { ret opt[*InstructionData].none{}; }
    ret opt[*InstructionData].some{?b.instructions.data[vd.def.result.instruction.index]};
}
