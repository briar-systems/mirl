# liveness of ir values: which values are live into and out of each block
#
# it reads the body and the graph view alone, so it needs no register file
# and serves every family that assigns values to storage of its own, as
# registers or locals. a value is defined by its block parameter at the top
# of its block or by its instruction where it stands. an instruction reads its
# operands and its edges' arguments where it stands, so an argument is live up
# to the edge that passes it and no further, and a block parameter is defined
# by the edge into it, never live into its block. a constant is defined by no
# block and is no member of any set, and a value binding record is no use.
#
# the sets are the backward dataflow of mirl.ir.cfg.flow over every block,
# held as lists. with b blocks, v values, u operands and arguments and l the
# values live into or out of a block, summed over the blocks, they take
# O(v + b + u + l) and the edges of each block a value is live into. a query
# lists a block's values.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.base.fail.keep;
use mirl.base.slice;
use mirl.ir.block.BlockData;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.graph.Lists;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.value.Def;

# the values live into and out of each block of a function
# ---
# values:   how many values the body had, each below it
# live_in:  per block, the values live on entry, after its parameters, ascending
# live_out: per block, the values live on exit, after its last instruction, ascending
pub rec Liveness {
    values:   u32;
    live_in:  Lists[u32];
    live_out: Lists[u32];
}

# whether a value takes part in liveness: one a block or an instruction defines
fun tracked(b: *Body, v: Value) bool {
    val def: Def = b.values.data[v].def;
    ret !(sel def.constant) && !(sel def.removed);
}

# a read where the block's own writes so far have not defined it, `defined` holding the block's mark where they have
fun read(b: *Body, gen: *Lists[u32], defined: *vector.Vector[u32], mark: u32, v: Value) err[allocator.Error] {
    if (!tracked(b, v) || defined.data[v] == mark) { ret err[allocator.Error].ok{}; }
    ret flow.fact(gen, v);
}

# a value the block defines
fun write(kill: *Lists[u32], defined: *vector.Vector[u32], mark: u32, v: Value) err[allocator.Error] {
    if (defined.data[v] == mark) { ret err[allocator.Error].ok{}; }
    defined.data[v] = mark;
    ret flow.fact(kill, v);
}

# each block's values read before it defines them, and the values it defines
fun local(a: *allocator.Allocator, b: *Body, gen: *Lists[u32], kill: *Lists[u32]) err[allocator.Error] {
    var defined: vector.Vector[u32] = vector.init[u32](a);
    fin { vector.dnit[u32](?defined); }
    var err_failed: err[allocator.Error] = slice.fill[u32](?defined, b.values.len, 0);
    keep(?err_failed, flow.rows(gen));
    keep(?err_failed, flow.rows(kill));
    var k: usize = 0;
    for (!(sel err_failed.err) && k < b.blocks.len) {
        val blk:  *BlockData = ?b.blocks.data[k];
        val mark: u32        = (k + 1)::u32;
        if (!blk.erased) {
            var p: usize = 0;
            for (p < blk.parameters.len) {
                keep(?err_failed, write(kill, ?defined, mark, blk.parameters.data[p]));
                p = p + 1;
            }
            var i: Instruction = blk.first;
            for (i != NO_INSTRUCTION) {
                val d: *InstructionData = ?b.instructions.data[i];
                var o: usize            = 0;
                for (o < d.operands.len) {
                    keep(?err_failed, read(b, gen, ?defined, mark, d.operands.data[o]));
                    o = o + 1;
                }
                var e: usize = 0;
                for (e < d.edges.len) {
                    var x: usize = 0;
                    for (x < d.edges.data[e].arguments.len) {
                        keep(?err_failed, read(b, gen, ?defined, mark, d.edges.data[e].arguments.data[x]));
                        x = x + 1;
                    }
                    e = e + 1;
                }
                var r: usize = 0;
                for (r < d.results.len) {
                    keep(?err_failed, write(kill, ?defined, mark, d.results.data[r]));
                    r = r + 1;
                }
                i = b.instructions.data[i].next;
            }
        }
        keep(?err_failed, flow.next(gen));
        keep(?err_failed, flow.next(kill));
        k = k + 1;
    }
    ret err_failed;
}

# the liveness of a function's values
# ---
# a:   the allocator the result takes
# b:   the function's body
# g:   its graph view
# ret: the liveness, or the allocator's refusal
pub fun compute(a: *allocator.Allocator, b: *Body, g: *Graph) res[Liveness, allocator.Error] {
    var l:    Liveness   = Liveness{values: b.values.len::u32, live_in: graph.lists_init[u32](a), live_out: graph.lists_init[u32](a)};
    var gen:  Lists[u32] = graph.lists_init[u32](a);
    var kill: Lists[u32] = graph.lists_init[u32](a);
    var w:    flow.Work  = flow.work(a);
    fin {
        graph.lists_dnit[u32](?gen);
        graph.lists_dnit[u32](?kill);
        flow.work_dnit(?w);
    }
    var err_failed: err[allocator.Error] = local(a, b, ?gen, ?kill);
    if (!(sel err_failed.err)) { err_failed = flow.backward(?w, g, flow.Problem{facts: l.values, gen: ?gen, kill: ?kill}, ?l.live_in, ?l.live_out); }
    if (sel err_failed.err) {
        dnit(?l);
        ret res[Liveness, allocator.Error].err{err_failed.err};
    }
    ret res[Liveness, allocator.Error].ok{l};
}

# give back a liveness's storage
pub fun dnit(l: *Liveness) err[allocator.Error] {
    var err_failed: err[allocator.Error] = graph.lists_dnit[u32](?l.live_in);
    keep(?err_failed, graph.lists_dnit[u32](?l.live_out));
    ret err_failed;
}
