# liveness of ir values: which values are live into and out of each block
#
# it reads the body and the graph view alone, so it needs no register file
# and serves every family that assigns values to storage of its own, as
# registers or locals. a value is defined by its block parameter at the top
# of its block or by its instruction where it stands. an instruction reads its
# operands and its edges' arguments where it stands, so an argument is live up
# to the edge that passes it and no further, and a block parameter is defined
# by the edge into it, never live into its block. a constant is defined by no
# block and is no member of any set, and a value binding record is no use.
#
# the sets are the backward dataflow of mirl.ir.cfg.flow over the reachable
# blocks in reverse postorder, then every other block in its own order. with
# b blocks, v values and u operands and arguments, the sets take O(u + b v / 64)
# and each pass of the dataflow O(b v / 64) plus the edges. a query is O(1).

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fail.keep;
use mirl.ir.block.BlockData;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.flow;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.value.Def;
use mirl.slice;

# the values live into and out of each block of a function
# ---
# words:    the words of one block's set
# live_in:  per block, the values live on entry, after its parameters
# live_out: per block, the values live on exit, after its last instruction
pub rec Liveness {
    words:    u32;
    live_in:  vector.Vector[u64];
    live_out: vector.Vector[u64];
}

fun bit(v: *vector.Vector[u64], base: usize, w: u32) bool {
    ret ((v.data[base + (w / 64)::usize] >> (w % 64)::u64) & 1) != 0;
}

fun set(v: *vector.Vector[u64], base: usize, w: u32) {
    val k: usize = base + (w / 64)::usize;
    v.data[k] = v.data[k] | ((1::u64) << (w % 64)::u64);
}

# whether a value takes part in liveness: one a block or an instruction defines
fun tracked(b: *Body, v: Value) bool {
    val def: Def = b.values.data[v.index].def;
    ret !(sel def.constant) && !(sel def.removed);
}

# a read where the block's own writes so far have not defined it
fun read(b: *Body, gen: *vector.Vector[u64], kill: *vector.Vector[u64], base: usize, v: Value) {
    if (tracked(b, v) && !bit(kill, base, v.index)) { set(gen, base, v.index); }
}

# each block's values read before it defines them, and the values it defines
fun local(b: *Body, words: u32, gen: *vector.Vector[u64], kill: *vector.Vector[u64]) {
    var k: usize = 0;
    for (k < b.blocks.len) {
        val blk:  *BlockData = ?b.blocks.data[k];
        val base: usize      = k * words::usize;
        if (!blk.erased) {
            var p: usize = 0;
            for (p < blk.parameters.len) {
                set(kill, base, blk.parameters.data[p].index);
                p = p + 1;
            }
            var i: usize = 0;
            for (i < blk.instructions.len) {
                val d: *InstructionData = ?b.instructions.data[blk.instructions.data[i].index];
                var o: usize            = 0;
                for (o < d.operands.len) {
                    read(b, gen, kill, base, d.operands.data[o]);
                    o = o + 1;
                }
                var e: usize = 0;
                for (e < d.edges.len) {
                    var x: usize = 0;
                    for (x < d.edges.data[e].arguments.len) {
                        read(b, gen, kill, base, d.edges.data[e].arguments.data[x]);
                        x = x + 1;
                    }
                    e = e + 1;
                }
                var r: usize = 0;
                for (r < d.results.len) {
                    set(kill, base, d.results.data[r].index);
                    r = r + 1;
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
}

# the reachable blocks in reverse postorder, then every block the entry does
# not reach in its own order
fun ordered(a: *allocator.Allocator, count: usize, d: *Dominance) res[vector.Vector[u32], allocator.Error] {
    var order: vector.Vector[u32]          = vector.init[u32](a);
    val room:  res[usize, allocator.Error] = vector.reserve[u32](?order, count);
    if (sel room.err) { ret res[vector.Vector[u32], allocator.Error].err{room.err}; }
    val rpo: Slice[u32] = dominance.order(d);
    var i:   usize      = 0;
    for (i < rpo.size) {
        vector.push[u32](?order, rpo.data[i]);
        i = i + 1;
    }
    var k: usize = 0;
    for (k < count) {
        if (!dominance.reachable(d, k::u32)) { vector.push[u32](?order, k::u32); }
        k = k + 1;
    }
    ret res[vector.Vector[u32], allocator.Error].ok{order};
}

# the liveness of a function's values
# ---
# a:   the allocator the result takes
# b:   the function's body
# g:   its graph view
# d:   the dominance over that graph
# ret: the liveness, or the allocator's refusal
pub fun compute(a: *allocator.Allocator, b: *Body, g: *Graph, d: *Dominance) res[Liveness, allocator.Error] {
    val values: u32                = b.values.len::u32;
    val words:  u32                = (values + 63) / 64;
    val size:   usize              = b.blocks.len * words::usize;
    var l:      Liveness           = Liveness{words: words, live_in: vector.init[u64](a), live_out: vector.init[u64](a)};
    var gen:    vector.Vector[u64] = vector.init[u64](a);
    var kill:   vector.Vector[u64] = vector.init[u64](a);
    fin {
        vector.dnit[u64](?gen);
        vector.dnit[u64](?kill);
    }
    var failed: err[allocator.Error] = slice.fill[u64](?gen, size, 0);
    keep(?failed, slice.fill[u64](?kill, size, 0));
    keep(?failed, slice.fill[u64](?l.live_in, size, 0));
    keep(?failed, slice.fill[u64](?l.live_out, size, 0));
    if (sel failed.err) {
        dnit(?l);
        ret res[Liveness, allocator.Error].err{failed.err};
    }
    local(b, words, ?gen, ?kill);
    val made: res[vector.Vector[u32], allocator.Error] = ordered(a, b.blocks.len, d);
    if (sel made.err) {
        dnit(?l);
        ret res[Liveness, allocator.Error].err{made.err};
    }
    var order: vector.Vector[u32] = made.ok;
    fin { vector.dnit[u32](?order); }
    flow.backward(g, Slice[u32]{data: order.data, size: order.len}, flow.Sets{words: words, gen: ?gen, kill: ?kill, live_in: ?l.live_in, live_out: ?l.live_out});
    ret res[Liveness, allocator.Error].ok{l};
}

# give back a liveness's storage
pub fun dnit(l: *Liveness) err[allocator.Error] {
    var failed: err[allocator.Error] = vector.dnit[u64](?l.live_in);
    keep(?failed, vector.dnit[u64](?l.live_out));
    ret failed;
}

# whether a value of the body it was computed over is live on entry to a
# block, after its parameters
pub fun live_in(l: *Liveness, k: Block, v: Value) bool {
    ret bit(?l.live_in, k.index::usize * l.words::usize, v.index);
}

# whether a value of the body it was computed over is live on exit from a
# block, after its last instruction
pub fun live_out(l: *Liveness, k: Block, v: Value) bool {
    ret bit(?l.live_out, k.index::usize * l.words::usize, v.index);
}
