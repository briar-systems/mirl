# the call graph of a unit: the direct calls its functions make of functions the unit follows, and the strongly
# connected groups of that graph
#
# the unit follows a function that has a body here and that no other definition may stand for at link time, as a
# replaceable one may. a weak instance is every definition of its name, so its body speaks for it. a call is direct
# when its callee is the address of a function (`read.callee`).
#
# the groups are found by one iterative walk (tarjan's) that takes the functions by index and closes each group as
# the walk leaves its head, so every group closes after every group it calls: the closing order is bottom up, the
# callees first. a group of more than one function, or of one that calls itself, is a recursion.
#
# cost: linear in the unit's functions and the calls listed.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.function.Body;
use mirl.ir.function.Node;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.module.Module;
use mirl.pass.analysis.read;

# no function, and no group
pub val NONE: u32 = 0xffffffff;

# the calls of each function of the unit the unit follows, function by function in index order
# ---
# first:   where each function's callees start in `callees`, then one past the last
# callees: the callee of each call listed, as many times as it is called
pub rec Calls {
    first:   vector.Vector[u32];
    callees: vector.Vector[u32];
}

# the strongly connected groups of a call graph
# ---
# group:  each function's group, numbered in the order the groups close, NONE for a function the unit does not follow
# order:  the functions the unit follows, group by group in the order the groups close
# starts: where each group starts in `order`, then one past the last
pub rec Groups {
    group:  vector.Vector[u32];
    order:  vector.Vector[u32];
    starts: vector.Vector[u32];
}

# whether the unit follows a function: it has a body here and no other definition may stand for it
pub fun followed(m: *Module, f: Function) bool {
    if (f::usize >= m.functions.len) { ret false; }
    val n: *Node = ?m.functions.data[f];
    ret n.body.blocks.len != 0 && !n.data.linkage.replaceable;
}

# no calls, listed for no function yet
pub fun init(a: *allocator.Allocator) Calls {
    ret Calls{first: vector.init[u32](a), callees: vector.init[u32](a)};
}

# give back the storage of a call graph
pub fun dnit(c: *Calls) {
    vector.dnit[u32](?c.first);
    vector.dnit[u32](?c.callees);
}

# begin listing the calls of the next function by index, every function of the unit begun in order
pub fun begin(c: *Calls) err[allocator.Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?c.first, c.callees.len::u32);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# list a call of `callee` by the function being listed
pub fun add(c: *Calls, callee: Function) err[allocator.Error] {
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?c.callees, callee);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# end the listing once every function of a unit of `n` functions has begun
pub fun end(c: *Calls, n: usize) err[allocator.Error] {
    for (c.first.len <= n) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?c.first, c.callees.len::u32);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    ret err[allocator.Error].ok{};
}

# the callee of a direct call the unit follows, none for any other instruction
pub fun direct(m: *Module, b: *Body, i: Instruction) opt[Function] {
    val opt_callee: opt[Function] = read.callee(m, b, ?b.instructions.data[i]);
    if (sel opt_callee.some) {
        if (followed(m, opt_callee.some)) { ret opt_callee; }
    }
    ret opt[Function].none{};
}

# list the direct calls every function of the unit the unit follows makes of the functions it follows
pub fun of(m: *Module, out: *Calls) err[allocator.Error] {
    var f: usize = 0;
    for (f < m.functions.len) {
        val err_begun: err[allocator.Error] = begin(out);
        if (sel err_begun.err) { ret err_begun; }
        if (followed(m, f::u32)) {
            val b: *Body = ?m.functions.data[f].body;
            var k: usize = 0;
            for (k < b.blocks.len) {
                if (!b.blocks.data[k].erased) {
                    var i: Instruction = b.blocks.data[k].first;
                    for (i != NO_INSTRUCTION) {
                        val opt_callee: opt[Function] = direct(m, b, i);
                        if (sel opt_callee.some) {
                            val err_added: err[allocator.Error] = add(out, opt_callee.some);
                            if (sel err_added.err) { ret err_added; }
                        }
                        i = b.instructions.data[i].next;
                    }
                }
                k = k + 1;
            }
        }
        f = f + 1;
    }
    ret end(out, m.functions.len);
}

# a function of the walk and how far through its calls it is
rec Frame {
    f:  u32;
    at: u32;
}

# one walk of a call graph
# ---
# index: the order each function was reached in, NONE before it is
# low:   the earliest reached function each one reaches back to
# open:  whether each function is on the stack
# stack: the functions reached whose group is not closed
# walk:  the functions being walked and how far through their calls
# count: how many functions were reached
rec Walk {
    index: vector.Vector[u32];
    low:   vector.Vector[u32];
    open:  vector.Vector[bool];
    stack: vector.Vector[u32];
    walk:  vector.Vector[Frame];
    count: u32;
}

# give back the storage of a walk
fun walk_dnit(w: *Walk) {
    vector.dnit[u32](?w.index);
    vector.dnit[u32](?w.low);
    vector.dnit[bool](?w.open);
    vector.dnit[u32](?w.stack);
    vector.dnit[Frame](?w.walk);
}

# enter function `f`: number it, open it on the stack and push its frame of the walk
fun reach(c: *Calls, w: *Walk, f: u32) err[allocator.Error] {
    w.index.data[f] = w.count;
    w.low.data[f]   = w.count;
    w.open.data[f]  = true;
    w.count         = w.count + 1;
    val res_stacked: res[usize, allocator.Error] = vector.push[u32](?w.stack, f);
    if (sel res_stacked.err) { ret err[allocator.Error].err{res_stacked.err}; }
    val res_walked: res[usize, allocator.Error] = vector.push[Frame](?w.walk, Frame{f: f, at: c.first.data[f]});
    if (sel res_walked.err) { ret err[allocator.Error].err{res_walked.err}; }
    ret err[allocator.Error].ok{};
}

# close the group `f` heads: its members are the stack from `f` up
fun close(w: *Walk, out: *Groups, f: u32) err[allocator.Error] {
    var from: usize = w.stack.len;
    for (w.stack.data[from - 1] != f) { from = from - 1; }
    from = from - 1;
    val g:          u32                         = (out.starts.len::u32);
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?out.starts, out.order.len::u32);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    var k: usize = from;
    for (k < w.stack.len) {
        val x: u32 = w.stack.data[k];
        out.group.data[x] = g;
        w.open.data[x]    = false;
        val res_ordered: res[usize, allocator.Error] = vector.push[u32](?out.order, x);
        if (sel res_ordered.err) { ret err[allocator.Error].err{res_ordered.err}; }
        k = k + 1;
    }
    vector.truncate[u32](?w.stack, from);
    ret err[allocator.Error].ok{};
}

# walk the graph from function `root`, closing each group as the walk leaves its head
fun walk_from(c: *Calls, w: *Walk, out: *Groups, root: u32) err[allocator.Error] {
    val err_reached: err[allocator.Error] = reach(c, w, root);
    if (sel err_reached.err) { ret err_reached; }
    for (w.walk.len > 0) {
        val top: *Frame = ?w.walk.data[w.walk.len - 1];
        val f:   u32    = top.f;
        if (top.at < c.first.data[f + 1]) {
            val to: u32 = c.callees.data[top.at];
            top.at = top.at + 1;
            if (w.index.data[to] == NONE) {
                val err_next: err[allocator.Error] = reach(c, w, to);
                if (sel err_next.err) { ret err_next; }
            }
            or (w.open.data[to] && w.index.data[to] < w.low.data[f]) { w.low.data[f] = w.index.data[to]; }
        }
        or {
            vector.truncate[Frame](?w.walk, w.walk.len - 1);
            if (w.walk.len > 0) {
                val up: u32 = w.walk.data[w.walk.len - 1].f;
                if (w.low.data[f] < w.low.data[up]) { w.low.data[up] = w.low.data[f]; }
            }
            if (w.low.data[f] == w.index.data[f]) {
                val err_closed: err[allocator.Error] = close(w, out, f);
                if (sel err_closed.err) { ret err_closed; }
            }
        }
    }
    ret err[allocator.Error].ok{};
}

# the groups of the graph `c` lists over the functions of `m`, into `out`, which is empty
pub fun groups(a: *allocator.Allocator, m: *Module, c: *Calls, out: *Groups) err[allocator.Error] {
    val n: usize = m.functions.len;
    var w: Walk  = Walk{index: vector.init[u32](a), low: vector.init[u32](a), open: vector.init[bool](a), stack: vector.init[u32](a), walk: vector.init[Frame](a), count: 0};
    fin { walk_dnit(?w); }
    var err_failed: err[allocator.Error] = slice.fill[u32](?w.index, n, NONE);
    if (!(sel err_failed.err)) { err_failed = slice.fill[u32](?w.low, n, NONE); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[bool](?w.open, n, false); }
    if (!(sel err_failed.err)) { err_failed = slice.fill[u32](?out.group, n, NONE); }
    if (sel err_failed.err)    { ret err_failed; }
    var f: usize = 0;
    for (f < n) {
        if (followed(m, f::u32) && w.index.data[f] == NONE) {
            val err_walked: err[allocator.Error] = walk_from(c, ?w, out, f::u32);
            if (sel err_walked.err) { ret err_walked; }
        }
        f = f + 1;
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](?out.starts, out.order.len::u32);
    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    ret err[allocator.Error].ok{};
}

# no groups yet
pub fun groups_init(a: *allocator.Allocator) Groups {
    ret Groups{group: vector.init[u32](a), order: vector.init[u32](a), starts: vector.init[u32](a)};
}

# give back the storage of the groups
pub fun groups_dnit(g: *Groups) {
    vector.dnit[u32](?g.group);
    vector.dnit[u32](?g.order);
    vector.dnit[u32](?g.starts);
}

# how many groups there are
pub fun count(g: *Groups) usize {
    if (g.starts.len == 0) { ret 0; }
    ret g.starts.len - 1;
}

# whether a call from `caller` of `callee` is a recursion: both are in one group
pub fun recursive(g: *Groups, caller: Function, callee: Function) bool {
    if (caller::usize >= g.group.len || callee::usize >= g.group.len) { ret false; }
    ret g.group.data[caller] != NONE && g.group.data[caller] == g.group.data[callee];
}
