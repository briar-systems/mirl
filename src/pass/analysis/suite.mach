# the tests of the range and memory analyses, read from ir text through the
# analysis cache. they sit in a module of their own because the driver, which
# builds the cache, is above the analyses. a module read from text has its
# values, blocks and instructions found by the names the text gave them

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;
use std.format;
use io: std.io.writer;

use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.function.Body;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.parse.Refusal;
use mirl.ir.text.parse.parse_body;
use mirl.ir.text.sink;
use mirl.pass.analysis;
use mirl.pass.analysis.memory;
use mirl.pass.analysis.memory.Carried;
use mirl.pass.analysis.memory.Effect;
use mirl.pass.analysis.memory.Memory;
use mirl.pass.analysis.memory.Reduction;
use mirl.pass.analysis.range.Range;
use mirl.pass.analysis.range.Ranges;
use mirl.pass.analysis.range.range_at;
use mirl.pass.driver;
use mirl.pass.failure.Why;
use mirl.slice;
use targets: mirl.target;
use mirl.target.capability.Space;
use mirl.target.record.Target;

#[testing]
val ABSENT: u32 = 0xffffffff;

#[testing]
fun spelled(name: str) View {
    ret View{data: name, len: str_len(name)};
}

# the value of a function the text named, or one with the id ABSENT
#[testing]
fun value(m: *Module, f: Function, name: str) Value {
    val got: res[*Body, module.Error] = module.body(m, f);
    if (sel got.err) { ret Value{index: ABSENT}; }
    var i: usize = 0;
    for (i < got.ok.values.len) {
        val n: opt[View] = got.ok.values.data[i].name;
        if (sel n.some) {
            if (slice.same_view(n.some, spelled(name))) { ret Value{index: i::u32}; }
        }
        i = i + 1;
    }
    ret Value{index: ABSENT};
}

# the block of a function the text named, or one with the id ABSENT
#[testing]
fun block(m: *Module, f: Function, name: str) Block {
    val got: res[*Body, module.Error] = module.body(m, f);
    if (sel got.err) { ret Block{index: ABSENT}; }
    var i: usize = 0;
    for (i < got.ok.blocks.len) {
        val n: opt[View] = got.ok.blocks.data[i].name;
        if (sel n.some) {
            if (slice.same_view(n.some, spelled(name))) { ret Block{index: i::u32}; }
        }
        i = i + 1;
    }
    ret Block{index: ABSENT};
}

# the k-th instruction of a block the text named, or one with the id ABSENT
#[testing]
fun instruction(m: *Module, f: Function, name: str, k: usize) Instruction {
    val b:   Block                    = block(m, f, name);
    val got: res[*Body, module.Error] = module.body(m, f);
    if (sel got.err)       { ret Instruction{index: ABSENT}; }
    if (b.index == ABSENT) { ret Instruction{index: ABSENT}; }
    val list: *vector.Vector[Instruction] = ?got.ok.blocks.data[b.index].instructions;
    if (k >= list.len) { ret Instruction{index: ABSENT}; }
    ret list.data[k];
}

#[testing]
fun addressable(t: *Target) bool {
    val rows: Slice[Space] = t.caps.widths.pointers;
    var i:    usize        = 0;
    for (i < rows.size) {
        if (rows.data[i].space == 0) { ret sel rows.data[i].pointer.physical; }
        i = i + 1;
    }
    ret false;
}

# read a body of ir text for a target that addresses memory, and start a run over it
#[testing]
fun opened(a: *allocator.Allocator, body: str, m: *Module, d: *driver.Driver) bool {
    ret opened_on(a, addressable, body, m, d);
}

# read a body of ir text for the first target a predicate picks, and start a run over it
#[testing]
fun opened_on(a: *allocator.Allocator, want: fun(*Target) bool, body: str, m: *Module, d: *driver.Driver) bool {
    val row: opt[*Target] = targets.first(want);
    if (sel row.none) { ret false; }
    var text: sink.Sink = sink.init(a);
    fin { sink.dnit(?text); }
    var w: io.Writer = sink.writer(?text);
    format.write_str(?w, "target \"");
    format.write_str(?w, row.some.name);
    format.write_str(?w, "\"\n");
    format.write_str(?w, body);
    val parsed: res[Module, Refusal] = parse_body(a, sink.view(?text));
    if (sel parsed.err) { ret false; }
    @m = parsed.ok;
    @d = driver.init(m, row.some, driver.Options{level: 2, checked: true});
    ret true;
}

#[testing]
fun at(d: *driver.Driver, f: Function, v: Value, blk: Block) res[Range, Why] {
    val got: res[*Ranges, Why] = analysis.ranges_of(?d.cache, f);
    if (sel got.err) { ret res[Range, Why].err{got.err}; }
    ret range_at(got.ok, v, blk);
}

# whether a query answered the range from lo to hi
#[testing]
fun spans(r: res[Range, Why], lo: Wide, hi: Wide) bool {
    if (sel r.err) { ret false; }
    ret word.compare(r.ok.lo, lo) == 0 && word.compare(r.ok.hi, hi) == 0;
}

#[testing]
fun effect(d: *driver.Driver, f: Function, name: str, k: usize) res[Effect, Why] {
    val got: res[*Memory, Why] = analysis.memory_of(?d.cache, f);
    if (sel got.err) { ret res[Effect, Why].err{got.err}; }
    ret memory.effect_of(got.ok, instruction(got.ok.m, f, name, k));
}

# whether the effects of two instructions of a block keep their order
#[testing]
fun ordered(d: *driver.Driver, f: Function, name: str, j: usize, k: usize, want: bool) bool {
    val a: res[Effect, Why] = effect(d, f, name, j);
    if (sel a.err) { ret false; }
    var ea: Effect = a.ok;
    fin { memory.release(?ea); }
    val b: res[Effect, Why] = effect(d, f, name, k);
    if (sel b.err) { ret false; }
    var eb: Effect = b.ok;
    fin { memory.release(?eb); }
    ret memory.conflicts(ea, eb) == want;
}

val NARROWING: str = "function @narrow: fun(i256) -> (i256) linkage global visibility default {\n^entry(%x: i256):\n    %c = lt.u %x, i256 10\n    cbr %c, ^small, ^big\n^small:\n    %y = add %x, i256 1\n    ret %y\n^big:\n    ret %x\n}\n";

val LOOPING: str = "function @spin: fun(i32) -> (i32) linkage global visibility default {\n^entry(%n: i32):\n    br ^head(i32 0)\n^head(%i: i32):\n    %next = add %i, i32 1\n    %c = ne %next, %n\n    cbr %c, ^head(%next), ^out\n^out:\n    ret %i\n}\nfunction @counted: fun() -> (i32) linkage global visibility default {\n^entry:\n    br ^head(i32 0)\n^head(%j: i32):\n    %c = lt.u %j, i32 100\n    cbr %c, ^body, ^out\n^body:\n    %more = add %j, i32 1\n    br ^head(%more)\n^out:\n    ret %j\n}\n";

val DISTINCT: str = "global @g1: i32 linkage global visibility default\nglobal @g2: i32 linkage global visibility default\nfunction @distinct: fun(ptr) -> () linkage global visibility default {\n^entry(%p: ptr):\n    %a = alloca type i32, pointer ptr, align 4\n    %b = alloca type i32, pointer ptr, align 4\n    store %a, i32 1, align 4\n    store %b, i32 2, align 4\n    store ptr @g1, i32 3, align 4\n    store ptr @g2, i32 4, align 4\n    store %p, i32 5, align 4\n    ret\n}\n";

val OVERLAP: str = "function @overlap: fun() -> () linkage global visibility default {\n^entry:\n    %p = alloca type array<16, i8>, pointer ptr, align 8\n    %q = ptr.add %p, i64 4\n    %r = ptr.add %p, i64 2\n    store %p, i32 1, align 4\n    store %q, i32 2, align 4\n    store %r, i32 3, align 4\n    ret\n}\nfunction @carry: fun() -> (i32) linkage global visibility default {\n^entry:\n    %buf = alloca type array<100, i32>, pointer ptr, align 4\n    br ^head(i64 0, i32 0)\n^head(%i: i64, %acc: i32):\n    %c = lt.u %i, i64 100\n    cbr %c, ^body, ^out\n^body:\n    %o = shl %i, i64 2\n    %cur = ptr.add %buf, %o\n    %prev = ptr.add %cur, i64 -4\n    store %cur, i32 7, align 4\n    %v = load %prev, type i32, align 4\n    %acc2 = add %acc, %v\n    %next = add %i, i64 1\n    br ^head(%next, %acc2)\n^out:\n    ret %acc\n}\n";

test range__narrows_through_a_guarded_branch {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened(?a, NARROWING, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }
    val f:   Function = Function{index: 0};
    val x:   Value    = value(?m, f, "x");
    val y:   Value    = value(?m, f, "y");
    val top: Wide     = word.ones(256);
    if (!spans(at(?d, f, x, block(?m, f, "entry")), word.zero(), top))              { ret 2; }
    if (!spans(at(?d, f, x, block(?m, f, "small")), word.zero(), word.small(9)))    { ret 3; }
    if (!spans(at(?d, f, y, block(?m, f, "small")), word.small(1), word.small(10))) { ret 4; }
    if (!spans(at(?d, f, x, block(?m, f, "big")), word.small(10), top))             { ret 5; }
    ret 0;
}

test range__widens_to_the_full_type_at_a_loop {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened(?a, LOOPING, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }

    # a loop no bound is read from widens to every value of the type
    val spin: Function = Function{index: 0};
    if (!spans(at(?d, spin, value(?m, spin, "i"), block(?m, spin, "head")), word.zero(), word.ones(32))) { ret 2; }

    # a counted loop is bounded by its test and its step
    val count: Function = Function{index: 1};
    val j:     Value    = value(?m, count, "j");
    if (!spans(at(?d, count, j, block(?m, count, "head")), word.zero(), word.small(100))) { ret 3; }
    if (!spans(at(?d, count, j, block(?m, count, "body")), word.zero(), word.small(99)))  { ret 4; }
    ret 0;
}

test memory__distinct_allocations_do_not_alias {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened(?a, DISTINCT, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }
    val f: Function = Function{index: 0};
    # the stores in order: slot a, slot b, global g1, global g2, a parameter
    if (!ordered(?d, f, "entry", 2, 3, false)) { ret 2; }
    if (!ordered(?d, f, "entry", 2, 4, false)) { ret 3; }
    if (!ordered(?d, f, "entry", 4, 5, false)) { ret 4; }
    if (!ordered(?d, f, "entry", 2, 2, true))  { ret 5; }
    # a pointer nothing is known of may alias a slot and a global
    if (!ordered(?d, f, "entry", 2, 6, true)) { ret 6; }
    if (!ordered(?d, f, "entry", 4, 6, true)) { ret 7; }
    ret 0;
}

test memory__one_base_at_overlapping_offsets_alias {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened(?a, OVERLAP, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }
    # stores of four bytes at offsets 0, 4 and 2 of one slot
    val f: Function = Function{index: 0};
    if (!ordered(?d, f, "entry", 3, 4, false)) { ret 2; }
    if (!ordered(?d, f, "entry", 3, 5, true))  { ret 3; }
    if (!ordered(?d, f, "entry", 4, 5, true))  { ret 4; }

    # a store of element i and a load of element i - 1 depend one trip apart,
    # and the load of one trip never reads what a later trip stores
    val g:   Function          = Function{index: 1};
    val got: res[*Memory, Why] = analysis.memory_of(?d.cache, g);
    if (sel got.err) { ret 5; }
    val store: res[Effect, Why] = effect(?d, g, "body", 3);
    val load:  res[Effect, Why] = effect(?d, g, "body", 4);
    if (sel store.err) { ret 6; }
    var es: Effect = store.ok;
    fin { memory.release(?es); }
    if (sel load.err) { ret 6; }
    var el: Effect = load.ok;
    fin { memory.release(?el); }
    if (es.places.len != 1 || el.places.len != 1) { ret 6; }
    val after: res[Carried, Why] = memory.carried(got.ok, 0, es.places.data[0], el.places.data[0]);
    if (sel after.err)            { ret 7; }
    if (!(sel after.ok.distance)) { ret 8; }
    if (after.ok.distance != 1)   { ret 8; }
    val before: res[Carried, Why] = memory.carried(got.ok, 0, el.places.data[0], es.places.data[0]);
    if (sel before.err)        { ret 9; }
    if (!(sel before.ok.none)) { ret 10; }

    # the accumulator is an integer sum, and the induction variable is not one
    val acc: res[opt[Reduction], Why] = memory.reduction(got.ok, 0, value(?m, g, "acc"));
    if (sel acc.err)                                                          { ret 11; }
    if (sel acc.ok.none)                                                      { ret 12; }
    if (acc.ok.some.float || !acc.ok.some.exact || !(sel acc.ok.some.op.sum)) { ret 13; }
    val index: res[opt[Reduction], Why] = memory.reduction(got.ok, 0, value(?m, g, "i"));
    if (sel index.err)     { ret 14; }
    if (sel index.ok.some) { ret 15; }
    ret 0;
}

val NARROW32: str = "function @pair: fun(i32) -> () linkage global visibility default {\n^entry(%n: i32):\n    %s = alloca type array<64, i8>, pointer ptr, align 4\n    %m = add %n, i32 4\n    %p = ptr.add %s, %n\n    %q = ptr.add %s, %m\n    store %p, i32 1, align 4\n    store %q, i32 2, align 4\n    ret\n}\nfunction @wrap: fun(i8) -> () linkage global visibility default {\n^entry(%n: i8):\n    %s = alloca type array<64, i8>, pointer ptr, align 4\n    %m = add %n, i8 100\n    %e = ext.s %n, to i32\n    %f = ext.s %m, to i32\n    %p = ptr.add %s, %e\n    %q = ptr.add %s, %f\n    store %p, i32 1, align 4\n    store %q, i32 2, align 4\n    ret\n}\nfunction @carry: fun() -> () linkage global visibility default {\n^entry:\n    %buf = alloca type array<100, i32>, pointer ptr, align 4\n    br ^head(i32 0)\n^head(%i: i32):\n    %c = lt.u %i, i32 100\n    cbr %c, ^body, ^out\n^body:\n    %o = shl %i, i32 2\n    %cur = ptr.add %buf, %o\n    %prev = ptr.add %cur, i32 -4\n    store %cur, i32 7, align 4\n    %v = load %prev, type i32, align 4\n    %next = add %i, i32 1\n    br ^head(%next)\n^out:\n    ret\n}\n";

val EXTENDED64: str = "function @extended: fun(i32) -> () linkage global visibility default {\n^entry(%n: i32):\n    %g = lt.u %n, i32 100\n    cbr %g, ^body, ^out\n^body:\n    %s = alloca type array<64, i8>, pointer ptr, align 4\n    %m = add %n, i32 4\n    %e = ext.s %n, to i64\n    %f = ext.s %m, to i64\n    %p = ptr.add %s, %e\n    %q = ptr.add %s, %f\n    store %p, i32 1, align 4\n    store %q, i32 2, align 4\n    ret\n^out:\n    ret\n}\n";

test memory__offsets_are_followed_at_a_four_byte_pointer {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened_on(?a, targets.four_byte_pointer, NARROW32, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }
    # stores of four bytes at i and i + 4 of one slot
    val f: Function = Function{index: 0};
    if (!ordered(?d, f, "entry", 4, 5, false)) { ret 2; }

    # an i8 index that wraps when 100 is added may land anywhere near the first
    if (!ordered(?d, Function{index: 1}, "entry", 6, 7, true)) { ret 7; }

    # a store of element i and a load of element i - 1 depend one trip apart
    val g:   Function          = Function{index: 2};
    val got: res[*Memory, Why] = analysis.memory_of(?d.cache, g);
    if (sel got.err) { ret 3; }
    val store: res[Effect, Why] = effect(?d, g, "body", 3);
    val load:  res[Effect, Why] = effect(?d, g, "body", 4);
    if (sel store.err) { ret 4; }
    var es: Effect = store.ok;
    fin { memory.release(?es); }
    if (sel load.err) { ret 4; }
    var el: Effect = load.ok;
    fin { memory.release(?el); }
    if (es.places.len != 1 || el.places.len != 1) { ret 4; }
    val after: res[Carried, Why] = memory.carried(got.ok, 0, es.places.data[0], el.places.data[0]);
    if (sel after.err)            { ret 5; }
    if (!(sel after.ok.distance)) { ret 6; }
    if (after.ok.distance != 1)   { ret 6; }
    ret 0;
}

test memory__a_narrow_index_is_followed_through_its_extension {
    var a: allocator.Allocator;
    page.make(?a);
    var m: Module;
    var d: driver.Driver;
    if (!opened_on(?a, targets.eight_byte_pointer, EXTENDED64, ?m, ?d)) { ret 1; }
    fin { module.dnit(?m); }
    fin { driver.dnit(?d); }
    # stores of four bytes at the extension of i and of i + 4, where i is below 100
    if (!ordered(?d, Function{index: 0}, "body", 4, 5, false)) { ret 2; }
    ret 0;
}
