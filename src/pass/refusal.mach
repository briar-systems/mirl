# why a pass or an analysis refused a function or a module, the level below a
# run's failure, which names the pass and the function

use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use std.types.size.usize;

use std.allocator;

use mirl.build.failure;
use cfg: mirl.ir.cfg.failure;
use mirl.ir.debug.record.Location;
use mirl.ir.function;
use mirl.ir.id.Constant;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use mirl.ir.type.table.Type;
use mirl.target.abi.call;
use mirl.target.abi.piece.Uncarried;
use mirl.target.basis;

use masc.core.ct;

# the place in a text a pass delivers where the reading stopped, which a
# refusal keeps since the text does not outlive the pass
# ---
# line:   the line, from one
# column: the byte on that line, from one
pub rec Unread {
    line:   u32;
    column: u32;
}

# why a slot of a pointer type stays in memory, where a legalisation must take
# it out
# ---
# escapes:  its address is used other than by loads and stores at its type
# held:     a kept or volatile access holds it in memory
# merged:   the pointers stored to it are merged where paths join, which
#           only variable pointers carry
# unstored: a load no store reaches, which no pointer stands for
# secrecy:  a load would read a value whose secrecy differs from its own
pub tag Kept: u8 {
    escapes;
    held;
    merged;
    unstored;
    secrecy;
}

# an exported thread-local global on a target whose build runs one thread
# ---
# global: the global
# arch:   the target's architecture
# sys:    the target's system
pub rec Exported {
    global: Global;
    arch:   str;
    sys:    str;
}

# a symbol the source defines under a name mirl gives a symbol it delivers,
# as a helper's, a pooled constant's or the availability byte's, which mirl
# never takes for its own
# ---
# symbol:   the symbol
# wanted:   what mirl would have delivered under the name, in a few words
# location: where the source defines it, the location of its body's first
#           instruction that states one, none for a global or a declaration
pub rec Taken {
    symbol:   Symbol;
    wanted:   str;
    location: opt[Location];
}

# the refusal of the symbol `s` of `m`, which has the name mirl delivers what
# `wanted` names under
pub fun taken(m: *module.Module, s: Symbol, wanted: str) Error {
    var at: opt[Location] = opt[Location].none{};
    if (sel s.function) {
        val b: *function.Body = ?m.functions.data[s.function].body;
        var i: usize          = 0;
        for (i < b.instructions.len && sel at.none) {
            at = function.location(b, i::Instruction);
            i  = i + 1;
        }
    }
    ret Error.taken{Taken{symbol: s, wanted: wanted, location: at}};
}

# a slot a legalisation must take out of memory and cannot
# ---
# slot:     the slot's alloca
# kept:     why it stays
# location: the source location the alloca was built for, none for none
pub rec Unpromoted {
    slot:     Instruction;
    kept:     Kept;
    location: opt[Location];
}

# a secret a function that requires constant time reaches, which a pass refuses
# with no condition that would have cleared it, so masc's record is rebuilt from
# these two where it is spelled
# ---
# reason:  what the secret reached
# operand: the operand holding the secret, masc's NO_OPERAND when none names it
pub rec Timed {
    reason:  ct.Reason;
    operand: u8;
}

# why a pass or an analysis refused a function or a module
# ---
# alloc:       the allocator refused storage
# ir:          the module or a body refused an edit or a read
# cfg:         a graph edit or a copy was refused
# build:       the builder stopped
# reason:      the pass cannot do what it is for here, said in a few words. a pass
#              never falls back to a weaker form without refusing so
# convention:  a call, an entry or a return was not classified
# pieces:      an assignment is not carried in pieces of the ir
# text:        a function a pass delivers in the text form was not read, at
#              this place of its text
# timing:      a function that requires constant time would take a time that
#              depends on a secret, as masc's refusal of it names
# condition:   a capability's condition was not read on the build's machine
# unheld:      a value of this float type, whose format the target holds no
#              unit for and no legalisation computes yet
# threaded:    this thread-local global, on a target whose build runs threads
#              and whose threads reach no thread-local variable yet
# indexed:     this thread-local global, which the target reaches through the
#              runtime's index of the module's block on a model that names
#              no cell holding that index, as uefi's
# exported:    this exported thread-local global, on a target whose build runs
#              one thread, which no image exports as a thread-local variable
# specialized: this specialization constant, on a target that holds none
# slot:        a slot the target holds no pointer in, which promotion cannot
#              take out of memory
# taken:       a symbol the source defines under a name mirl delivers a
#              symbol of its own under
pub tag Error: u8 {
    alloc:       allocator.Error;
    ir:          module.Error;
    cfg:         cfg.Error;
    build:       failure.Error;
    reason:      str;
    convention:  call.Error;
    pieces:      Uncarried;
    text:        Unread;
    timing:      Timed;
    condition:   basis.Error;
    unheld:      Type;
    threaded:    Global;
    indexed:     Global;
    exported:    Exported;
    specialized: Constant;
    slot:        Unpromoted;
    taken:       Taken;
}

# a refusal of the allocator, as a pass's failure
pub fun lost(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

# the outcome of an edit of a body, as a pass's failure
pub fun edit(r: err[module.Error]) err[Error] {
    if (sel r.err) { ret err[Error].err{Error.ir{r.err}}; }
    ret err[Error].ok{};
}
