# the schedule: tables of rows, and the one walk that checks them
#
# a row names a pass, the levels that run it, the verification after it, and
# the rows to run after it when it changed something. the passes of the
# table's own rows are its registered passes, and a follow-up names one of
# them. a neutral row runs a `Pass`, so it runs on every target. a family's
# row may run a `Lowering` as well, so it runs only over the build the family
# opened, after the neutral prefix. the two kinds of row are two types, so no
# row is ever handed a build that may be absent.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.collections.slice.Slice;

use std.types.result.res;

use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.failure.Defect;
use mirl.pass.failure.Problem;
use mirl.pass.failure.Why;
use mirl.pass.record.Lowering;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Unit;

# an optimisation level, 0 to 3
pub def Level: u8;

# a set of optimisation levels, bit i holding level i
pub def Levels: u8;

# no level, for a row only a follow-up or a legalisation runs
pub val NEVER: Levels = 0x0;
# every level
pub val EVERY: Levels = 0xf;
# level 1 and above
pub val FROM_1: Levels = 0xe;
# level 2 and above
pub val FROM_2: Levels = 0xc;
# level 3
pub val FROM_3: Levels = 0x8;

# whether a set holds a level
pub fun at(l: Levels, level: Level) bool {
    ret level < 8 && (l & (1u8 << level)) != 0;
}

# when the verifier runs after a row, beside every pass of a checked run
# ---
# never:   not at all
# changed: when the row's pass changed something
# always:  whatever the pass did
pub tag Verify: u8 {
    never;
    changed;
    always;
}

# one row of the neutral schedule, which every target runs
# ---
# pass:   the pass, which reads the target and the selection alone
# levels: the levels that run an optimisation. a legalisation runs at every
#         level whatever its row says
# verify: when the verifier runs after it and its follow-ups
# after:  the rows run, in order, when it changed something
pub rec Row {
    pass:   *Pass;
    levels: Levels;
    verify: Verify;
    after:  Slice[Row];
}

# what a family's row runs
# ---
# unstated: nothing, a defect of the row
# pass:     a pass that reads the target and the selection alone, as a
#           neutral row the family runs again among its own
# lowering: a pass that reads the build the family opened
pub tag Runs: u8 {
    unstated;
    pass:     *Pass;
    lowering: *Lowering;
}

# one row of a family's schedule, which runs only over the build the family
# opened, after the neutral prefix
# ---
# runs:   what it runs
# levels: the levels that run an optimisation. a legalisation runs at every
#         level whatever its row says
# verify: when the verifier runs after it and its follow-ups
# after:  the rows run, in order, when it changed something
pub rec Step {
    runs:   Runs;
    levels: Levels;
    verify: Verify;
    after:  Slice[Step];
}

# what the walk reads of a row's pass, whichever kind it is
# ---
# id:        the pass record, nil for none
# name:      its name
# scoped:    whether it states a scope with a visit or a run
# preserves: the analyses it preserves
rec Entry {
    id:        ptr;
    name:      str;
    scoped:    bool;
    preserves: cache.Set;
}

fun of_pass(p: *Pass) Entry {
    if (p == nil) { ret Entry{id: nil, name: nil, scoped: false, preserves: 0}; }
    var scoped: bool = false;
    if (sel p.scope.function) { scoped = p.scope.function != nil; }
    or (sel p.scope.module)   { scoped = p.scope.module != nil; }
    ret Entry{id: p::ptr, name: p.name, scoped: scoped, preserves: p.preserves};
}

fun of_lowering(p: *Lowering) Entry {
    if (p == nil) { ret Entry{id: nil, name: nil, scoped: false, preserves: 0}; }
    var scoped: bool = false;
    if (sel p.scope.function) { scoped = p.scope.function != nil; }
    or (sel p.scope.module)   { scoped = p.scope.module != nil; }
    ret Entry{id: p::ptr, name: p.name, scoped: scoped, preserves: p.preserves};
}

fun of_step(s: *Step) Entry {
    val r: Runs = s.runs;
    if (sel r.pass)     { ret of_pass(r.pass); }
    if (sel r.lowering) { ret of_lowering(r.lowering); }
    ret Entry{id: nil, name: nil, scoped: false, preserves: 0};
}

# the rows a run checks as one table: neutral rows, then a family's
# ---
# rows:  the neutral rows
# steps: the family's rows after them, none for a neutral run
rec Plan {
    rows:  Slice[Row];
    steps: Slice[Step];
}

fun count(p: Plan) usize {
    ret p.rows.size + p.steps.size;
}

fun entry_at(p: Plan, i: usize) Entry {
    if (i < p.rows.size) { ret of_pass(p.rows.data[i].pass); }
    ret of_step(?p.steps.data[i - p.rows.size]);
}

# the follow-ups taken so far on the way to a row
# ---
# id: the pass of a row on the way
# up: the way to that row, nil at a row of the table
rec Path {
    id: ptr;
    up: *Path;
}

fun defect(e: Entry, problem: Problem) err[Defect] {
    ret err[Defect].err{Defect{pass: e.name, problem: problem}};
}

fun on(path: *Path, id: ptr) bool {
    var up: *Path = path;
    for (up != nil) {
        if (up.id == id) { ret true; }
        up = up.up;
    }
    ret false;
}

fun registered(p: Plan, id: ptr) bool {
    var i: usize = 0;
    for (i < count(p)) {
        if (entry_at(p, i).id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a row of the table: a named, scoped pass whose name no other record has,
# preserving only registered analyses
fun entry(p: Plan, i: usize, analyses: usize) err[Defect] {
    val e: Entry = entry_at(p, i);
    if (e.id == nil || e.name == nil || str_len(e.name) == 0) { ret defect(e, Problem.unnamed{}); }
    if (!e.scoped)                                            { ret defect(e, Problem.unscoped{}); }
    var unregistered: u64 = 0;
    if (analyses < cache.ROWS::usize)                                  { unregistered = ~((1u64 << analyses::u64) - 1); }
    if ((e.preserves & unregistered) != 0 && e.preserves != cache.ALL) { ret defect(e, Problem.preserves{}); }
    var k: usize = 0;
    for (k < i) {
        val q: Entry = entry_at(p, k);
        if (q.id != e.id && str_equals(q.name, e.name)) { ret defect(e, Problem.renamed{}); }
        k = k + 1;
    }
    ret err[Defect].ok{};
}

# one follow-up, naming a registered pass not on its way
fun follow_one(p: Plan, e: Entry, path: *Path) err[Defect] {
    if (!registered(p, e.id)) { ret defect(e, Problem.unregistered{}); }
    if (on(path, e.id))       { ret defect(e, Problem.cycle{}); }
    ret err[Defect].ok{};
}

# the follow-ups of a neutral row
fun follow_rows(p: Plan, after: Slice[Row], path: *Path) err[Defect] {
    var i: usize = 0;
    for (i < after.size) {
        val e:   Entry       = of_pass(after.data[i].pass);
        val one: err[Defect] = follow_one(p, e, path);
        if (sel one.err) { ret one; }
        var next: Path        = Path{id: e.id, up: path};
        val deep: err[Defect] = follow_rows(p, after.data[i].after, ?next);
        if (sel deep.err) { ret deep; }
        i = i + 1;
    }
    ret err[Defect].ok{};
}

# the follow-ups of a family's row
fun follow_steps(p: Plan, after: Slice[Step], path: *Path) err[Defect] {
    var i: usize = 0;
    for (i < after.size) {
        val e:   Entry       = of_step(?after.data[i]);
        val one: err[Defect] = follow_one(p, e, path);
        if (sel one.err) { ret one; }
        var next: Path        = Path{id: e.id, up: path};
        val deep: err[Defect] = follow_steps(p, after.data[i].after, ?next);
        if (sel deep.err) { ret deep; }
        i = i + 1;
    }
    ret err[Defect].ok{};
}

fun check_plan(p: Plan, analyses: Slice[cache.Row]) err[Defect] {
    val ordered: opt[u32] = cache.check(analyses);
    if (sel ordered.some) { ret err[Defect].err{Defect{pass: nil, problem: Problem.analysis{ordered.some}}}; }
    var i: usize = 0;
    for (i < count(p)) {
        val whole: err[Defect] = entry(p, i, analyses.size);
        if (sel whole.err) { ret whole; }
        i = i + 1;
    }
    i = 0;
    for (i < p.rows.size) {
        var root:  Path        = Path{id: p.rows.data[i].pass::ptr, up: nil};
        val after: err[Defect] = follow_rows(p, p.rows.data[i].after, ?root);
        if (sel after.err) { ret after; }
        i = i + 1;
    }
    i = 0;
    for (i < p.steps.size) {
        var root:  Path        = Path{id: of_step(?p.steps.data[i]).id, up: nil};
        val after: err[Defect] = follow_steps(p, p.steps.data[i].after, ?root);
        if (sel after.err) { ret after; }
        i = i + 1;
    }
    ret err[Defect].ok{};
}

# check a neutral schedule and the analysis registry its passes preserve rows of
#
# every row names a registered pass, every pass record is whole, and no pass
# follows itself through its follow-ups, so a run of the schedule ends.
# ---
# table:    the schedule's rows
# analyses: the analysis registry
# ret:      ok, or the first defect
pub fun check(table: Slice[Row], analyses: Slice[cache.Row]) err[Defect] {
    ret check_plan(Plan{rows: table, steps: Slice[Step]{data: nil, size: 0}}, analyses);
}

# check a family's run, the neutral prefix and the family's rows after it, as
# one table, as `check` checks one
# ---
# prefix:   the neutral rows the run starts with
# steps:    the family's rows
# analyses: the analysis registry
# ret:      ok, or the first defect
pub fun check_family(prefix: Slice[Row], steps: Slice[Step], analyses: Slice[cache.Row]) err[Defect] {
    ret check_plan(Plan{rows: prefix, steps: steps}, analyses);
}

#[testing]
fun unchanged(u: *Unit) res[bool, Why] {
    ret res[bool, Why].ok{false};
}

#[testing]
val P:       Pass = Pass{name: "p", scope: Scope.function{unchanged}};
#[testing]
val Q:       Pass = Pass{name: "q", scope: Scope.function{unchanged}};
#[testing]
val R:       Pass = Pass{name: "r", scope: Scope.function{unchanged}};
#[testing]
val P_AGAIN: Pass = Pass{name: "p", scope: Scope.function{unchanged}};

#[testing]
val THEN_Q: [1]Row = [1]Row{Row{pass: ?Q, levels: EVERY}};
#[testing]
val GOOD:   [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_Q[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val THEN_R:       [1]Row = [1]Row{Row{pass: ?R, levels: EVERY}};
#[testing]
val UNREGISTERED: [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_R[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val THEN_P:   [1]Row = [1]Row{Row{pass: ?P, levels: EVERY}};
#[testing]
val THEN_Q_P: [1]Row = [1]Row{Row{pass: ?Q, levels: EVERY, after: Slice[Row]{data: ?THEN_P[0], size: 1}}};
#[testing]
val CYCLE:    [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_Q_P[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val RENAMED: [2]Row = [2]Row{Row{pass: ?P, levels: EVERY}, Row{pass: ?P_AGAIN, levels: EVERY}};

#[testing]
val UNNAMED: [1]Row = [1]Row{Row{pass: nil, levels: EVERY}};

#[testing]
fun found(table: *Row, size: usize, problem: u8) bool {
    val r: err[Defect] = check(Slice[Row]{data: table, size: size}, analysis.rows());
    if (sel r.ok) { ret false; }
    ret (sel r.err.problem.unregistered && problem == 0) || (sel r.err.problem.cycle && problem == 1) || (sel r.err.problem.renamed && problem == 2) || (sel r.err.problem.unnamed && problem == 3);
}

test schedule__walk_checks_registration_and_order {
    val good: err[Defect] = check(Slice[Row]{data: ?GOOD[0], size: 2}, analysis.rows());
    if (sel good.err)                   { ret 1; }
    if (!found(?UNREGISTERED[0], 2, 0)) { ret 2; }
    if (!found(?CYCLE[0], 2, 1))        { ret 3; }
    if (!found(?RENAMED[0], 2, 2))      { ret 4; }
    if (!found(?UNNAMED[0], 1, 3))      { ret 5; }
    var later:   [1]cache.Row = [1]cache.Row{cache.Row{name: "later", needs: 0x1}};
    val ordered: err[Defect]  = check(Slice[Row]{data: ?GOOD[0], size: 2}, Slice[cache.Row]{data: ?later[0], size: 1});
    if (!(sel ordered.err))                  { ret 6; }
    if (!(sel ordered.err.problem.analysis)) { ret 6; }
    ret 0;
}
