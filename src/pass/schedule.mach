# the schedule: tables of rows, and the one walk that checks them
#
# a row names a pass and the rows to run after it when it changed something.
# the passes of the table's own rows are its registered passes, and a
# follow-up names one of them. a neutral row runs a
# `Pass`, so it runs on every target. a family's row may run a `Lowering` as
# well, so it runs only over the build the family opened, after the neutral
# prefix. the two kinds of row are two types, so no row is ever handed a build
# that may be absent.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.collections.slice.Slice;

use mirl.pass.cache;
use mirl.pass.failure.Defect;
use mirl.pass.failure.Error;
use mirl.pass.failure.Problem;
use mirl.pass.record.Frames;
use mirl.pass.record.Lowering;
use mirl.pass.record.Pass;
use mirl.pass.setting;

# one row of the neutral schedule, which every target runs
# ---
# pass:  the pass, which reads the target and the selection alone
# after: the rows run, in order, when it changed something, a function pass
#        among them visiting only the functions it changed
pub rec Row {
    pass:  *Pass;
    after: Slice[Row];
}

# a family's own row of a lowering, which runs only over the build the
# family opened
# ---
# pass:  the lowering
# after: the rows run, in order, when it changed something, a function pass
#        among them visiting only the functions it changed
pub rec LoweringRow {
    pass:  *Lowering;
    after: Slice[Step];
}

# one row of a family's schedule, which runs after the neutral prefix over the
# build the family opened. a family runs a neutral row again by naming it
# ---
# unstated: nothing, a defect of the schedule
# row:      a row of a `Pass`: a neutral row the family runs again, or one of
#           the family's own
# lowering: the family's own row of a lowering
pub tag Step: u8 {
    unstated;
    row:      *Row;
    lowering: *LoweringRow;
}

# what the walk reads of a row's pass, whichever kind it is
# ---
# id:        the pass record, nil for none
# name:      its name
# scoped:    whether it states a scope with a visit or a run
# needs:     the analyses it reads
# preserves: the analyses it preserves
# optimises: whether it is of the optimise kind
# frames:    what it states of the frame accesses of a function it changes
rec Entry {
    id:        ptr;
    name:      str;
    scoped:    bool;
    needs:     cache.Set;
    preserves: cache.Set;
    optimises: bool;
    frames:    Frames;
}

fun of_pass(p: *Pass) Entry {
    if (p == nil) { ret Entry{id: nil, name: nil, scoped: false, needs: 0, preserves: 0, optimises: false}; }
    var scoped: bool = false;
    if (sel p.scope.function) { scoped = p.scope.function != nil; }
    or (sel p.scope.module)   { scoped = p.scope.module != nil; }
    ret Entry{id: p::ptr, name: p.name, scoped: scoped, needs: p.needs, preserves: p.preserves, optimises: sel p.kind.optimise, frames: p.frames};
}

fun of_lowering(p: *Lowering) Entry {
    if (p == nil) { ret Entry{id: nil, name: nil, scoped: false, needs: 0, preserves: 0, optimises: false}; }
    var scoped: bool = false;
    if (sel p.scope.function) { scoped = p.scope.function != nil; }
    or (sel p.scope.module)   { scoped = p.scope.module != nil; }
    ret Entry{id: p::ptr, name: p.name, scoped: scoped, needs: p.needs, preserves: p.preserves, optimises: sel p.kind.optimise, frames: p.frames};
}

fun of_step(s: Step) Entry {
    if (sel s.row)      { ret of_pass(s.row.pass); }
    if (sel s.lowering) { ret of_lowering(s.lowering.pass); }
    ret Entry{id: nil, name: nil, scoped: false, needs: 0, preserves: 0, optimises: false};
}

# the rows a run checks as one table: neutral rows, then a family's
# ---
# rows:   the neutral rows
# steps:  the family's rows after them, none for a neutral run
# listed: every optimisation pass a setting names
rec Plan {
    rows:   Slice[Row];
    steps:  Slice[Step];
    listed: Slice[*Pass];
}

fun count(p: Plan) usize {
    ret p.rows.size + p.steps.size;
}

fun entry_at(p: Plan, i: usize) Entry {
    if (i < p.rows.size) { ret of_pass(p.rows.data[i].pass); }
    ret of_step(p.steps.data[i - p.rows.size]);
}

# the follow-ups taken so far on the way to a row
# ---
# id: the pass of a row on the way
# up: the way to that row, nil at a row of the table
rec Path {
    id: ptr;
    up: *Path;
}

fun defect(e: Entry, problem: Problem) err[Error] {
    ret err[Error].err{Error.schedule{Defect{pass: e.name, problem: problem}}};
}

# whether a pass stands on a way of follow-ups
fun on(path: *Path, id: ptr) bool {
    var up: *Path = path;
    for (up != nil) {
        if (up.id == id) { ret true; }
        up = up.up;
    }
    ret false;
}

# whether a pass is the pass of one of the plan's own rows
fun registered(p: Plan, id: ptr) bool {
    var i: usize = 0;
    for (i < count(p)) {
        if (entry_at(p, i).id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether the list of optimisation passes holds the record `id`
fun listed(p: Plan, id: ptr) bool {
    var i: usize = 0;
    for (i < p.listed.size) {
        if (p.listed.data[i]::ptr == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a row of the table: a named, scoped pass whose name no other record has,
# preserving only registered analyses, and an optimisation pass a setting names
fun entry(p: Plan, i: usize, analyses: usize) err[Error] {
    val e: Entry = entry_at(p, i);
    if (e.id == nil || e.name == nil || str_len(e.name) == 0) { ret defect(e, Problem.unnamed{}); }
    if (!e.scoped)                                            { ret defect(e, Problem.unscoped{}); }
    if (e.optimises && !listed(p, e.id))                      { ret defect(e, Problem.unlisted{}); }
    var unregistered: u64 = 0;
    if (analyses < cache.ROWS::usize)                                  { unregistered = ~((1u64 << analyses::u64) - 1); }
    if ((e.preserves & unregistered) != 0 && e.preserves != cache.ALL) { ret defect(e, Problem.preserves{}); }
    if ((e.needs & unregistered) != 0)                                 { ret defect(e, Problem.needs{}); }
    var k: usize = 0;
    for (k < i) {
        val q: Entry = entry_at(p, k);
        if (q.id != e.id && str_equals(q.name, e.name)) { ret defect(e, Problem.renamed{}); }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# one follow-up, naming a registered pass not on its way, which is not the stale rule's row, and which keeps the frame
# accesses where it follows a row after that row
fun follow_one(p: Plan, e: Entry, path: *Path, past: bool) err[Error] {
    if (!registered(p, e.id))       { ret defect(e, Problem.unregistered{}); }
    if (on(path, e.id))             { ret defect(e, Problem.cycle{}); }
    if (sel e.frames.judged)        { ret defect(e, Problem.judged{}); }
    if (past && !sel e.frames.kept) { ret defect(e, Problem.unkept{}); }
    ret err[Error].ok{};
}

# the stale rule's row judges the frame accesses of a body as final (`mirl.ct.fresh`): the plan holds it once at most,
# and every row after it, and every follow-up of one, states that it keeps them (`mirl.pass.record.Frames`), so the
# verdict stands for the code the target emits
fun final_frames(p: Plan) err[Error] {
    var past: bool  = false;
    var i:    usize = 0;
    for (i < count(p)) {
        val e: Entry = entry_at(p, i);
        if (sel e.frames.judged) {
            if (past) { ret defect(e, Problem.judged{}); }
            past = true;
        }
        or (past && !sel e.frames.kept) { ret defect(e, Problem.unkept{}); }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# whether the row at `i` of the plan is the stale rule's row or runs after it, so its follow-ups keep the frame
# accesses
fun after_judged(p: Plan, i: usize) bool {
    var k: usize = 0;
    for (k <= i) {
        val e: Entry = entry_at(p, k);
        if (sel e.frames.judged) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the follow-ups of a neutral row, `past` whether the row they follow runs after the stale rule's row
fun follow_rows(p: Plan, after: Slice[Row], path: *Path, past: bool) err[Error] {
    var i: usize = 0;
    for (i < after.size) {
        val e:       Entry      = of_pass(after.data[i].pass);
        val err_one: err[Error] = follow_one(p, e, path, past);
        if (sel err_one.err) { ret err_one; }
        var next:     Path       = Path{id: e.id, up: path};
        val err_deep: err[Error] = follow_rows(p, after.data[i].after, ?next, past);
        if (sel err_deep.err) { ret err_deep; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the follow-ups of a family's row, as its row or lowering states them, `past` whether that row runs after the stale
# rule's row
fun follow_step(p: Plan, s: Step, path: *Path, past: bool) err[Error] {
    if (sel s.row)      { ret follow_rows(p, s.row.after, path, past); }
    if (sel s.lowering) { ret follow_steps(p, s.lowering.after, path, past); }
    ret err[Error].ok{};
}

# the follow-ups of a family's lowering
fun follow_steps(p: Plan, after: Slice[Step], path: *Path, past: bool) err[Error] {
    var i: usize = 0;
    for (i < after.size) {
        val e:       Entry      = of_step(after.data[i]);
        val err_one: err[Error] = follow_one(p, e, path, past);
        if (sel err_one.err) { ret err_one; }
        var next:     Path       = Path{id: e.id, up: path};
        val err_deep: err[Error] = follow_step(p, after.data[i], ?next, past);
        if (sel err_deep.err) { ret err_deep; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# check the analysis registry, then every row of a plan, then the follow-ups
# of each, giving the first defect
fun check_plan(p: Plan, analyses: Slice[cache.Row]) err[Error] {
    val opt_ordered: opt[u32] = cache.check(analyses);
    if (sel opt_ordered.some)         { ret err[Error].err{Error.schedule{Defect{pass: nil, problem: Problem.analysis{opt_ordered.some}}}}; }
    if (p.listed.size > setting.MOST) { ret err[Error].err{Error.schedule{Defect{pass: nil, problem: Problem.listed{}}}}; }
    var i: usize = 0;
    for (i < count(p)) {
        val err_whole: err[Error] = entry(p, i, analyses.size);
        if (sel err_whole.err) { ret err_whole; }
        i = i + 1;
    }
    val err_final: err[Error] = final_frames(p);
    if (sel err_final.err) { ret err_final; }
    i = 0;
    for (i < p.rows.size) {
        var root:      Path       = Path{id: p.rows.data[i].pass::ptr, up: nil};
        val err_after: err[Error] = follow_rows(p, p.rows.data[i].after, ?root, after_judged(p, i));
        if (sel err_after.err) { ret err_after; }
        i = i + 1;
    }
    i = 0;
    for (i < p.steps.size) {
        var root:      Path       = Path{id: of_step(p.steps.data[i]).id, up: nil};
        val err_after: err[Error] = follow_step(p, p.steps.data[i], ?root, after_judged(p, p.rows.size + i));
        if (sel err_after.err) { ret err_after; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# check a family's run, the neutral prefix and the family's rows after it, as
# one table, and the analysis registry its passes read and preserve rows of
#
# every row names a registered pass, every pass record is whole, and no pass
# follows itself through its follow-ups, so a run of the schedule ends.
# ---
# prefix:   the neutral rows the run starts with
# steps:    the family's rows
# analyses: the analysis registry
# listed:   every optimisation pass a setting names
# ret:      ok, or the first defect
pub fun check_family(prefix: Slice[Row], steps: Slice[Step], analyses: Slice[cache.Row], listed: Slice[*Pass]) err[Error] {
    ret check_plan(Plan{rows: prefix, steps: steps, listed: listed}, analyses);
}
