# the schedule: a table of steps, and the one walk that checks it
#
# a row names a pass, the levels that run it, the verification after it, and
# the rows to run after it when it changed something. the passes of the
# table's own rows are its registered passes, and a follow-up names one of
# them. a new pass is a module declaring its record and one row here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.collections.slice.Slice;

use std.types.result.res;

use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.failure.Defect;
use mirl.pass.failure.Problem;
use mirl.pass.failure.Why;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Unit;

# an optimisation level, 0 to 3
pub def Level: u8;

# a set of optimisation levels, bit i holding level i
pub def Levels: u8;

# no level, for a row only a follow-up or a legalisation runs
pub val NEVER: Levels = 0x0;
# every level
pub val EVERY: Levels = 0xf;
# level 1 and above
pub val FROM_1: Levels = 0xe;
# level 2 and above
pub val FROM_2: Levels = 0xc;
# level 3
pub val FROM_3: Levels = 0x8;

# whether a set holds a level
pub fun at(l: Levels, level: Level) bool {
    ret level < 8 && (l & (1u8 << level)) != 0;
}

# when the verifier runs after a row, beside every pass of a checked run
# ---
# never:   not at all
# changed: when the row's pass changed something
# always:  whatever the pass did
pub tag Verify: u8 {
    never;
    changed;
    always;
}

# one step
# ---
# pass:   the pass
# levels: the levels that run an optimisation. a legalisation runs at every
#         level whatever its row says
# verify: when the verifier runs after it and its follow-ups
# after:  the rows run, in order, when it changed something
pub rec Row {
    pass:   *Pass;
    levels: Levels;
    verify: Verify;
    after:  Slice[Row];
}

# the follow-ups taken so far on the way to a row
# ---
# pass: the pass of a row on the way
# up:   the way to that row, nil at a row of the table
rec Path {
    pass: *Pass;
    up:   *Path;
}

fun defect(p: *Pass, problem: Problem) err[Defect] {
    var name: str = nil;
    if (p != nil) { name = p.name; }
    ret err[Defect].err{Defect{pass: name, problem: problem}};
}

fun on(path: *Path, p: *Pass) bool {
    var at: *Path = path;
    for (at != nil) {
        if (at.pass == p) { ret true; }
        at = at.up;
    }
    ret false;
}

fun registered(table: Slice[Row], p: *Pass) bool {
    var i: usize = 0;
    for (i < table.size) {
        if (table.data[i].pass == p) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun scoped(p: *Pass) bool {
    if (sel p.scope.function) { ret p.scope.function != nil; }
    if (sel p.scope.module)   { ret p.scope.module != nil; }
    ret false;
}

# a row of the table: a named, scoped pass whose name no other record has,
# preserving only registered analyses
fun entry(table: Slice[Row], i: usize, analyses: usize) err[Defect] {
    val p: *Pass = table.data[i].pass;
    if (p == nil || p.name == nil || str_len(p.name) == 0) { ret defect(p, Problem.unnamed{}); }
    if (!scoped(p))                                        { ret defect(p, Problem.unscoped{}); }
    var unregistered: u64 = 0;
    if (analyses < cache.ROWS::usize)                                  { unregistered = ~((1u64 << analyses::u64) - 1); }
    if ((p.preserves & unregistered) != 0 && p.preserves != cache.ALL) { ret defect(p, Problem.preserves{}); }
    var k: usize = 0;
    for (k < i) {
        val q: *Pass = table.data[k].pass;
        if (q != p && str_equals(q.name, p.name)) { ret defect(p, Problem.renamed{}); }
        k = k + 1;
    }
    ret err[Defect].ok{};
}

# the follow-ups of a row, each naming a registered pass not on its way
fun follow(table: Slice[Row], after: Slice[Row], path: *Path) err[Defect] {
    var i: usize = 0;
    for (i < after.size) {
        val p: *Pass = after.data[i].pass;
        if (!registered(table, p)) { ret defect(p, Problem.unregistered{}); }
        if (on(path, p))           { ret defect(p, Problem.cycle{}); }
        var next: Path        = Path{pass: p, up: path};
        val deep: err[Defect] = follow(table, after.data[i].after, ?next);
        if (sel deep.err) { ret deep; }
        i = i + 1;
    }
    ret err[Defect].ok{};
}

# check a schedule and the analysis registry its passes preserve rows of
#
# every row names a registered pass, every pass record is whole, and no pass
# follows itself through its follow-ups, so a run of the schedule ends.
# ---
# table:    the schedule's rows
# analyses: the analysis registry
# ret:      ok, or the first defect
pub fun check(table: Slice[Row], analyses: Slice[cache.Row]) err[Defect] {
    val ordered: opt[u32] = cache.check(analyses);
    if (sel ordered.some) { ret err[Defect].err{Defect{pass: nil, problem: Problem.analysis{ordered.some}}}; }
    var i: usize = 0;
    for (i < table.size) {
        val whole: err[Defect] = entry(table, i, analyses.size);
        if (sel whole.err) { ret whole; }
        i = i + 1;
    }
    i = 0;
    for (i < table.size) {
        var root:  Path        = Path{pass: table.data[i].pass, up: nil};
        val after: err[Defect] = follow(table, table.data[i].after, ?root);
        if (sel after.err) { ret after; }
        i = i + 1;
    }
    ret err[Defect].ok{};
}

#[testing]
fun unchanged(u: *Unit) res[bool, Why] {
    ret res[bool, Why].ok{false};
}

#[testing]
val P:       Pass = Pass{name: "p", scope: Scope.function{unchanged}};
#[testing]
val Q:       Pass = Pass{name: "q", scope: Scope.function{unchanged}};
#[testing]
val R:       Pass = Pass{name: "r", scope: Scope.function{unchanged}};
#[testing]
val P_AGAIN: Pass = Pass{name: "p", scope: Scope.function{unchanged}};

#[testing]
val THEN_Q: [1]Row = [1]Row{Row{pass: ?Q, levels: EVERY}};
#[testing]
val GOOD:   [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_Q[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val THEN_R:       [1]Row = [1]Row{Row{pass: ?R, levels: EVERY}};
#[testing]
val UNREGISTERED: [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_R[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val THEN_P:   [1]Row = [1]Row{Row{pass: ?P, levels: EVERY}};
#[testing]
val THEN_Q_P: [1]Row = [1]Row{Row{pass: ?Q, levels: EVERY, after: Slice[Row]{data: ?THEN_P[0], size: 1}}};
#[testing]
val CYCLE:    [2]Row = [2]Row{Row{pass: ?P, levels: EVERY, after: Slice[Row]{data: ?THEN_Q_P[0], size: 1}}, Row{pass: ?Q, levels: EVERY}};

#[testing]
val RENAMED: [2]Row = [2]Row{Row{pass: ?P, levels: EVERY}, Row{pass: ?P_AGAIN, levels: EVERY}};

#[testing]
val UNNAMED: [1]Row = [1]Row{Row{pass: nil, levels: EVERY}};

#[testing]
fun found(table: *Row, size: usize, problem: u8) bool {
    val r: err[Defect] = check(Slice[Row]{data: table, size: size}, analysis.rows());
    if (sel r.ok) { ret false; }
    ret (sel r.err.problem.unregistered && problem == 0) || (sel r.err.problem.cycle && problem == 1) || (sel r.err.problem.renamed && problem == 2) || (sel r.err.problem.unnamed && problem == 3);
}

test schedule__walk_checks_registration_and_order {
    val good: err[Defect] = check(Slice[Row]{data: ?GOOD[0], size: 2}, analysis.rows());
    if (sel good.err)                   { ret 1; }
    if (!found(?UNREGISTERED[0], 2, 0)) { ret 2; }
    if (!found(?CYCLE[0], 2, 1))        { ret 3; }
    if (!found(?RENAMED[0], 2, 2))      { ret 4; }
    if (!found(?UNNAMED[0], 1, 3))      { ret 5; }
    var later:   [1]cache.Row = [1]cache.Row{cache.Row{name: "later", needs: 0x1}};
    val ordered: err[Defect]  = check(Slice[Row]{data: ?GOOD[0], size: 2}, Slice[cache.Row]{data: ?later[0], size: 1});
    if (!(sel ordered.err))                  { ret 6; }
    if (!(sel ordered.err.problem.analysis)) { ret 6; }
    ret 0;
}
