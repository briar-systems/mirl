# how a schedule is run
# ---
# optimise: whether the build optimises, and the passes it turns on or off one by one
# checked:  verify the module before the first pass and after every pass,
#           off for none
# floats:   the float relaxations the build permits, none for exact semantics
# stats:    where the time of the passes, the lowerings and the verifier runs
#           and the count of verifier runs are added, none for none
# warnings: the list each pass appends the warnings it gives to
pub rec Options {
    optimise: Optimise;
    checked:  bool;
    floats:   Relaxations;
    stats:    opt[*Stats];
    warnings: *vector.Vector[Warning];
}

# a run in progress
# ---
# m:       the module
# t:       the target
# basis:   the selection the run reads, the build's when a family opened one
#          and none otherwise
# cache:   the analyses of the module's functions
# options: how it runs
# legal:   whether the run has reached the last legalisation of its plan, so
#          the module is verified as legal code from that pass on
# changed: a mark per function the running pass changed
# whole:   whether the next verification walks every body, since no earlier
#          one holds the bodies the pass did not mark
pub rec Driver {
    m:       *Module;
    t:       *Target;
    basis:   opt[*Basis];
    cache:   Cache;
    options: Options;
    legal:   bool;
    changed: vector.Vector[bool];
    whole:   bool;
}

# a run over a module for a target and the selection it reads, with an empty
# cache over the analysis registry, before any legalisation. every pass of
# the run reads the selection through its context
# ---
# ret: the run, or foreign when the basis was selected for another target, the
#      one check that the selection every pass reads is the run's target's
pub fun init(m: *Module, t: *Target, basis: opt[*Basis], options: Options) res[Driver, Error] {
    if (sel basis.some) {
        if (basis.some.target != t) { ret res[Driver, Error].err{Error.foreign{}}; }
    }
    ret res[Driver, Error].ok{Driver{m: m, t: t, basis: basis, cache: cache.init(m, t, basis, analysis.rows(), cache.NONE), options: options, legal: false, changed: vector.init[bool](m.a), whole: true}};
}

# give back the run's analyses
pub fun dnit(d: *Driver) err[allocator.Error] {
    vector.dnit[bool](?d.changed);
    ret cache.dnit(?d.cache);
}

# clear the marks of the functions a pass changed before it runs, one per
# function of the module
fun unmark(d: *Driver) err[allocator.Error] {
    vector.truncate[bool](?d.changed, 0);
    ret slice.fill[bool](?d.changed, d.m.functions.len, false);
}

# mark every function the running pass added to the module as changed
fun added(d: *Driver) err[allocator.Error] {
    for (d.changed.len < d.m.functions.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[bool](?d.changed, true);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    ret err[allocator.Error].ok{};
}

# mark function `f` as one the running pass changed
fun mark(d: *Driver, f: Function) {
    if (f::usize < d.changed.len) { d.changed.data[f] = true; }
}

fun refused(name: str, f: opt[Function], why: refusal.Error) res[bool, Error] {
    ret res[bool, Error].err{Error.refused{Refusal{pass: name, function: f, why: why}}};
}

fun lost(e: allocator.Error) res[bool, Error] {
    ret res[bool, Error].err{Error.alloc{e}};
}

# verify the module, as legal code once the run is past legalisation, naming
# the pass that left it so
fun verified(d: *Driver, name: str) err[Error] {
    cache.reader(?d.cache, analysis.VERIFIER);
    var stage: failure.Stage = failure.Stage.open{};
    if (d.legal) { stage = failure.Stage.legal{analysis.trees(?d.cache)}; }
    var scope: failure.Scope = failure.Scope.changed{Slice[bool]{data: d.changed.data, size: d.changed.len}};
    if (d.whole) { scope = failure.Scope.whole{}; }
    d.whole = false;
    val err_against: err[failure.Error] = against(d.options.stats, d.m, d.t, d.basis, stage, scope);
    if (sel err_against.err) { ret err[Error].err{Error.unverified{Unverified{pass: name, error: err_against.err}}}; }
    ret err[Error].ok{};
}

# the verifier's run over the module, timed and counted in the stats
fun against(s: opt[*Stats], m: *Module, t: *Target, basis: opt[*Basis], stage: failure.Stage, scope: failure.Scope) err[failure.Error] {
    val opt_from:    opt[Instant]       = stats.start(s);
    val err_against: err[failure.Error] = verify_table.against(m, t, target_basis.context_of(basis), stage, scope);
    stats.stop(s, stats.Stage.verify{}, opt_from);
    if (sel s.some) { s.some.verified = s.some.verified + 1; }
    ret err_against;
}

# a lowering's visit and the build it is given
rec Lowers {
    visit: Lower;
    build: *Build;
}

# a lowering's run and the build it is given
rec LowersAll {
    run:   LowerAll;
    build: *Build;
}

# what a function visit calls: a pass's visit, or a lowering's with its build
tag Visiting: u8 {
    pass:     Visit;
    lowering: Lowers;
}

# what a module run calls: a pass's run, or a lowering's with its build
tag Running: u8 {
    pass:     Run;
    lowering: LowersAll;
}

fun visit_of(v: Visiting, u: *Unit) res[bool, refusal.Error] {
    if (sel v.pass)     { ret v.pass(u); }
    or (sel v.lowering) { ret v.lowering.visit(u, v.lowering.build); }
}

fun run_of(r: Running, c: *Context, marks: *Changed) res[bool, refusal.Error] {
    if (sel r.pass)     { ret r.pass(c, marks); }
    or (sel r.lowering) { ret r.lowering.run(c, r.lowering.build, marks); }
}

# call a visit on every function the context touches, marking each one it
# changed and dropping the analyses it does not preserve. a refusal names
# that function and gives the module up
fun each_function(d: *Driver, c: *Context, name: str, preserves: cache.Set, call: Visiting) res[bool, Error] {
    val count:   usize = d.m.functions.len;
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < count) {
        val f: Function = (i::u32);
        if (record.touches(c, f)) {
            var u:            Unit                     = Unit{context: c, f: f};
            val res_visit_of: res[bool, refusal.Error] = visit_of(call, ?u);
            if (sel res_visit_of.err) { ret refused(name, opt[Function].some{f}, res_visit_of.err); }
            if (res_visit_of.ok) {
                changed = true;
                mark(d, f);
                val err_dropped: err[allocator.Error] = cache.drop(?d.cache, f, preserves);
                if (sel err_dropped.err) { ret lost(err_dropped.err); }
            }
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{changed};
}

# call a module run once, marking each function it changed and each one it
# added, and dropping the analyses of those it does not preserve. a refusal names
# the pass and gives the module up
fun whole_module(d: *Driver, c: *Context, name: str, preserves: cache.Set, call: Running) res[bool, Error] {
    var marks:      Changed                  = Changed{marks: Slice[bool]{data: d.changed.data, size: d.changed.len}};
    val res_run_of: res[bool, refusal.Error] = run_of(call, c, ?marks);
    if (sel res_run_of.err) { ret refused(name, opt[Function].none{}, res_run_of.err); }
    if (!res_run_of.ok)     { ret res[bool, Error].ok{false}; }
    val err_grown: err[allocator.Error] = added(d);
    if (sel err_grown.err) { ret lost(err_grown.err); }
    var i: usize = 0;
    for (i < d.changed.len) {
        if (d.changed.data[i]) {
            val err_dropped: err[allocator.Error] = cache.drop(?d.cache, (i::u32), preserves);
            if (sel err_dropped.err) { ret lost(err_dropped.err); }
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{true};
}

# the oblivious check of every function the pass changed that requires constant time, in a checked run
fun oblivious_after(d: *Driver, name: str) err[Error] {
    var i: usize = 0;
    for (i < d.changed.len && i < d.m.functions.len) {
        val n: *Node = ?d.m.functions.data[i];
        if (d.changed.data[i] && in_constant_time(n.data.constant_time) && n.body.blocks.len > 0) {
            val res_checked: res[opt[mct.Refused], allocator.Error] = oblivious.check(d.m.a, d.m, (i::u32));
            if (sel res_checked.err)     { ret err[Error].err{Error.alloc{res_checked.err}}; }
            if (sel res_checked.ok.some) { ret err[Error].err{Error.oblivious{Oblivious{pass: name, refused: res_checked.ok.some}}}; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# verify the module after a pass in a checked run, passing on what the pass
# gave unless the verifier fails it
fun checked(d: *Driver, name: str, changed: res[bool, Error]) res[bool, Error] {
    if (sel changed.err) { ret changed; }
    if (d.options.checked) {
        val err_verified: err[Error] = verified(d, name);
        if (sel err_verified.err) { ret res[bool, Error].err{err_verified.err}; }
        val err_oblivious: err[Error] = oblivious_after(d, name);
        if (sel err_oblivious.err) { ret res[bool, Error].err{err_oblivious.err}; }
    }
    ret changed;
}

# the ground the run's choices stand on: its target, its selection and the
# float relaxations it permits
fun ground(d: *Driver) Ground {
    ret Ground{t: d.t, basis: d.basis, floats: d.options.floats};
}

# the context a pass of this time runs in, the cache held to the rows it needs
fun context(d: *Driver, time: Time, needs: cache.Set) Context {
    cache.reader(?d.cache, needs);
    ret Context{m: d.m, t: d.t, basis: d.basis, cache: ?d.cache, time: time, floats: d.options.floats, warnings: d.options.warnings};
}

# run one pass over the module, verifying it after when the run is checked
# ---
# d:   the run
# p:   the pass
# ret: whether it changed anything, or why the run fails, the module given up
#      when the pass refused
pub fun apply(d: *Driver, p: *Pass) res[bool, Error] {
    var c:           Context              = context(d, p.time, p.needs);
    var res_changed: res[bool, Error];
    val err_cleared: err[allocator.Error] = unmark(d);
    if (sel err_cleared.err) { ret lost(err_cleared.err); }
    val opt_from: opt[Instant] = stats.start(d.options.stats);
    if (sel p.scope.function) { res_changed = each_function(d, ?c, p.name, p.preserves, Visiting.pass{p.scope.function}); }
    or (sel p.scope.module)   { res_changed = whole_module(d, ?c, p.name, p.preserves, Running.pass{p.scope.module}); }
    or                        { ret refused(p.name, opt[Function].none{}, refusal.Error.reason{"the pass states no scope"}); }
    stats.stop(d.options.stats, stats.Stage.passes{}, opt_from);
    ret checked(d, p.name, res_changed);
}

# run one lowering over the module with the build its family opened, as
# `apply` runs a pass
# ---
# d:   the run, whose selection is the build's
# p:   the lowering
# b:   the build
# ret: whether it changed anything, or why the run fails, the module given up
#      when it refused
pub fun lower(d: *Driver, p: *Lowering, b: *Build) res[bool, Error] {
    var c:           Context              = context(d, p.time, p.needs);
    var res_changed: res[bool, Error];
    val err_cleared: err[allocator.Error] = unmark(d);
    if (sel err_cleared.err) { ret lost(err_cleared.err); }
    val opt_from: opt[Instant] = stats.start(d.options.stats);
    if (sel p.scope.function) { res_changed = each_function(d, ?c, p.name, p.preserves, Visiting.lowering{Lowers{visit: p.scope.function, build: b}}); }
    or (sel p.scope.module)   { res_changed = whole_module(d, ?c, p.name, p.preserves, Running.lowering{LowersAll{run: p.scope.module, build: b}}); }
    or                        { ret refused(p.name, opt[Function].none{}, refusal.Error.reason{"the lowering states no scope"}); }
    stats.stop(d.options.stats, stats.Stage.lower{}, opt_from);
    ret checked(d, p.name, res_changed);
}

# run one neutral row: its pass and its follow-ups when the pass changed
# something
pub fun step(d: *Driver, row: *Row) err[Error] {
    val res_changed: res[bool, Error] = apply(d, row.pass);
    if (sel res_changed.err) { ret err[Error].err{res_changed.err}; }
    if (res_changed.ok) {
        var g: Ground = ground(d);
        var i: usize  = 0;
        for (i < row.after.size) {
            if (pipeline.selected(?row.after.data[i], ?g, ?d.options.optimise)) {
                val err_data_stepped: err[Error] = step(d, ?row.after.data[i]);
                if (sel err_data_stepped.err) { ret err_data_stepped; }
            }
            i = i + 1;
        }
    }
    ret err[Error].ok{};
}

# run one family's row over the build: a row of a pass as `step` runs it, and
# a lowering's row as `step` runs a neutral row
pub fun step_family(d: *Driver, s: Step, b: *Build) err[Error] {
    if (sel s.row) { ret step(d, s.row); }
    or (sel s.lowering) {
        val l:           *LoweringRow     = s.lowering;
        val res_changed: res[bool, Error] = lower(d, l.pass, b);
        if (sel res_changed.err) { ret err[Error].err{res_changed.err}; }
        if (res_changed.ok) {
            var g: Ground = ground(d);
            var i: usize  = 0;
            for (i < l.after.size) {
                if (pipeline.stepped(l.after.data[i], ?g, ?d.options.optimise)) {
                    val err_done: err[Error] = step_family(d, l.after.data[i], b);
                    if (sel err_done.err) { ret err_done; }
                }
                i = i + 1;
            }
        }
        ret err[Error].ok{};
    }
    or (sel s.unstated) { ret err[Error].err{Error.schedule{Defect{pass: nil, problem: Problem.unnamed{}}}}; }
}

# run a plan the schedule was checked for, the module verified before it when
# the run is checked
fun run_plan(m: *Module, t: *Target, basis: opt[*Basis], rows: Slice[Row], steps: Slice[Step], b: *Build, options: Options) err[Error] {
    if (options.checked) {
        val err_given: err[failure.Error] = against(options.stats, m, t, basis, failure.Stage.given{}, failure.Scope.whole{});
        if (sel err_given.err) {
            if (sel err_given.err.alloc) { ret err[Error].err{Error.alloc{err_given.err.alloc}}; }
            ret err[Error].err{Error.input{err_given.err.refused}};
        }
    }
    val res_started: res[Driver, Error] = init(m, t, basis, options);
    if (sel res_started.err) { ret err[Error].err{res_started.err}; }
    var d:        Driver               = res_started.ok;
    val err_ran:  err[Error]           = follow(?d, rows, steps, b);
    val err_gone: err[allocator.Error] = dnit(?d);
    if (sel err_ran.err)  { ret err_ran; }
    if (sel err_gone.err) { ret err[Error].err{Error.alloc{err_gone.err}}; }
    ret err[Error].ok{};
}

# choose the plan of a checked schedule and run it over the run's module
fun follow(d: *Driver, rows: Slice[Row], steps: Slice[Step], b: *Build) err[Error] {
    # the given module is verified before the run, or not at all in an unchecked run
    d.whole = false;
    var g:          Ground                                     = ground(d);
    val res_chosen: res[vector.Vector[Taken], allocator.Error] = pipeline.choose(d.m.a, rows, steps, ?g, ?d.options.optimise);
    if (sel res_chosen.err) { ret err[Error].err{Error.alloc{res_chosen.err}}; }
    var plan: vector.Vector[Taken] = res_chosen.ok;
    fin { vector.dnit[Taken](?plan); }
    var last: usize = plan.len;
    var i:    usize = 0;
    for (i < plan.len) {
        if (pipeline.legalises(plan.data[i])) { last = i; }
        i = i + 1;
    }
    i = 0;
    for (i < plan.len) {
        # the module is legal from the last legalisation on, every body held to
        # the legal rules after it
        if (i == last) {
            d.legal = true;
            d.whole = true;
        }
        val taken:           Taken = plan.data[i];
        var err_row_stepped: err[Error];
        if (sel taken.row)           { err_row_stepped = step(d, taken.row); }
        or (sel taken.step)          { err_row_stepped = step_family(d, taken.step, b); }
        if (sel err_row_stepped.err) { ret err_row_stepped; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# run the neutral prefix and then a family's rows over a module, with the
# build the family opened for its target
# ---
# m:       the module, verified against the open rules before anything runs
#          when the run is checked
# t:       the target the module is built for, the one the build was opened for
# b:       the build
# legal:   the family's rows, checked with the prefix before anything runs
# options: how it runs
# ret:     ok, or why the run failed
pub fun drive_family(m: *Module, t: *Target, b: *Build, legal: Slice[Step], options: Options) err[Error] {
    val err_whole: err[Error] = schedule.check_family(rows.prefix(), legal, analysis.rows(), rows.optimisations());
    if (sel err_whole.err) { ret err_whole; }
    ret run_plan(m, t, opt[*Basis].some{?b.basis}, rows.prefix(), legal, b, options);
}
