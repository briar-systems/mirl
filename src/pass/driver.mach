# how a schedule is run
# ---
# level:   the optimisation level
# checked: verify the module after every pass, as every build that tests does
pub rec Options {
    level:   Level;
    checked: bool;
}

# a run in progress
# ---
# m:       the module
# t:       the target
# basis:   the selection the run reads, the build's when a family opened one
#          and none otherwise
# cache:   the analyses of the module's functions
# options: how it runs
# legal:   whether the run has reached the last legalisation of its plan, so
#          the module is verified as legal code from that pass on
pub rec Driver {
    m:       *Module;
    t:       *Target;
    basis:   opt[*Basis];
    cache:   Cache;
    options: Options;
    legal:   bool;
}

# a run over a module for a target and the selection it reads, with an empty
# cache over the analysis registry, before any legalisation. every pass of
# the run reads the selection through its context
# ---
# ret: the run, or foreign when the basis was selected for another target, the
#      one check that the selection every pass reads is the run's target's
pub fun init(m: *Module, t: *Target, basis: opt[*Basis], options: Options) res[Driver, Error] {
    if (sel basis.some) {
        if (basis.some.target != t) { ret res[Driver, Error].err{Error.foreign{}}; }
    }
    ret res[Driver, Error].ok{Driver{m: m, t: t, basis: basis, cache: cache.init(m, t, analysis.rows()), options: options, legal: false}};
}

# give back the run's analyses
pub fun dnit(d: *Driver) err[allocator.Error] {
    ret cache.dnit(?d.cache);
}

fun refused(name: str, f: opt[Function], why: Why) res[bool, Error] {
    ret res[bool, Error].err{Error.refused{Refusal{pass: name, function: f, why: why}}};
}

fun lost(e: allocator.Error) res[bool, Error] {
    ret res[bool, Error].err{Error.alloc{e}};
}

# the allocator's refusal of a release, the only refusal a body the driver
# took from the module can give
fun released(r: err[module.Error]) err[allocator.Error] {
    if (sel r.err) {
        if (sel r.err.alloc) { ret err[allocator.Error].err{r.err.alloc}; }
    }
    ret err[allocator.Error].ok{};
}

# verify the module, as legal code once the run is past legalisation, naming
# the pass that left it so
fun verified(d: *Driver, name: str) err[Error] {
    var stage: verify.Stage = verify.Stage.open{};
    if (d.legal) { stage = verify.Stage.legal{analysis.trees(?d.cache)}; }
    val r: err[verify.Error] = verify.against(d.m, d.t, stage);
    if (sel r.err) { ret err[Error].err{Error.unverified{Unverified{pass: name, error: r.err}}}; }
    ret err[Error].ok{};
}

# a lowering's visit and the build it is given
rec Lowers {
    visit: Lower;
    build: *Build;
}

# a lowering's run and the build it is given
rec LowersAll {
    run:   LowerAll;
    build: *Build;
}

# what a function visit calls: a pass's visit, or a lowering's with its build
tag Visiting: u8 {
    pass:     Visit;
    lowering: Lowers;
}

# what a module run calls: a pass's run, or a lowering's with its build
tag Running: u8 {
    pass:     Run;
    lowering: LowersAll;
}

fun visit_of(v: Visiting, u: *Unit) res[bool, Why] {
    if (sel v.pass)     { ret v.pass(u); }
    or (sel v.lowering) { ret v.lowering.visit(u, v.lowering.build); }
}

fun run_of(r: Running, c: *Context) res[bool, Why] {
    if (sel r.pass)     { ret r.pass(c); }
    or (sel r.lowering) { ret r.lowering.run(c, r.lowering.build); }
}

fun each_function(d: *Driver, c: *Context, name: str, preserves: cache.Set, call: Visiting) res[bool, Error] {
    val count:   usize = d.m.functions.len;
    var changed: bool  = false;
    var i:       usize = 0;
    for (i < count) {
        val f: Function = Function{index: i::u32};
        if (record.touches(c, f)) {
            val taken: res[Snapshot, module.Error] = snapshot.take(d.m, Reach.function{f});
            if (sel taken.err) { ret refused(name, opt[Function].some{f}, Why.ir{taken.err}); }
            var kept: Snapshot       = taken.ok;
            var u:    Unit           = Unit{context: c, f: f};
            val r:    res[bool, Why] = visit_of(call, ?u);
            if (sel r.err) {
                snapshot.restore(d.m, ?kept);
                cache.forget(?d.cache, f);
                ret refused(name, opt[Function].some{f}, r.err);
            }
            val given: err[allocator.Error] = released(snapshot.discard(d.m, ?kept));
            if (sel given.err) { ret lost(given.err); }
            if (r.ok) {
                changed = true;
                val dropped: err[allocator.Error] = cache.drop(?d.cache, f, preserves);
                if (sel dropped.err) { ret lost(dropped.err); }
            }
        }
        i = i + 1;
    }
    ret res[bool, Error].ok{changed};
}

fun whole_module(d: *Driver, c: *Context, name: str, preserves: cache.Set, call: Running) res[bool, Error] {
    val taken: res[Snapshot, module.Error] = snapshot.take(d.m, Reach.module{});
    if (sel taken.err) { ret refused(name, opt[Function].none{}, Why.ir{taken.err}); }
    var kept: Snapshot       = taken.ok;
    val r:    res[bool, Why] = run_of(call, c);
    if (sel r.err) {
        snapshot.restore(d.m, ?kept);
        cache.drop_all(?d.cache, cache.NONE);
        ret refused(name, opt[Function].none{}, r.err);
    }
    val given: err[allocator.Error] = released(snapshot.discard(d.m, ?kept));
    if (sel given.err) { ret lost(given.err); }
    if (r.ok) {
        val dropped: err[allocator.Error] = cache.drop_all(?d.cache, preserves);
        if (sel dropped.err) { ret lost(dropped.err); }
    }
    ret res[bool, Error].ok{r.ok};
}

fun checked(d: *Driver, name: str, changed: res[bool, Error]) res[bool, Error] {
    if (sel changed.err) { ret changed; }
    if (d.options.checked) {
        val v: err[Error] = verified(d, name);
        if (sel v.err) { ret res[bool, Error].err{v.err}; }
    }
    ret changed;
}

fun context(d: *Driver, time: Time, skips: record.Filter) Context {
    ret Context{m: d.m, t: d.t, basis: d.basis, cache: ?d.cache, time: time, skips: skips};
}

# run one pass over the module, verifying it after when the run is checked
# ---
# d:   the run
# p:   the pass
# ret: whether it changed anything, or why the run fails, with every
#      function as it was before the pass when the pass refused
pub fun apply(d: *Driver, p: *Pass) res[bool, Error] {
    var c:       Context = context(d, p.time, p.skips);
    var changed: res[bool, Error];
    if (sel p.scope.function) { changed = each_function(d, ?c, p.name, p.preserves, Visiting.pass{p.scope.function}); }
    or (sel p.scope.module)   { changed = whole_module(d, ?c, p.name, p.preserves, Running.pass{p.scope.module}); }
    or                        { ret refused(p.name, opt[Function].none{}, Why.reason{"the pass states no scope"}); }
    ret checked(d, p.name, changed);
}

# run one lowering over the module with the build its family opened, as
# `apply` runs a pass
# ---
# d:   the run, whose selection is the build's
# p:   the lowering
# b:   the build
# ret: whether it changed anything, or why the run fails, with every
#      function as it was before the lowering when it refused
pub fun lower(d: *Driver, p: *Lowering, b: *Build) res[bool, Error] {
    var c:       Context = context(d, p.time, p.skips);
    var changed: res[bool, Error];
    if (sel p.scope.function) { changed = each_function(d, ?c, p.name, p.preserves, Visiting.lowering{Lowers{visit: p.scope.function, build: b}}); }
    or (sel p.scope.module)   { changed = whole_module(d, ?c, p.name, p.preserves, Running.lowering{LowersAll{run: p.scope.module, build: b}}); }
    or                        { ret refused(p.name, opt[Function].none{}, Why.reason{"the lowering states no scope"}); }
    ret checked(d, p.name, changed);
}

fun verify_after(d: *Driver, name: str, verify: Verify, changed: bool) err[Error] {
    if (d.options.checked)                                    { ret err[Error].ok{}; }
    if (sel verify.always || (changed && sel verify.changed)) { ret verified(d, name); }
    ret err[Error].ok{};
}

# run one neutral row: its pass, its follow-ups when the pass changed
# something, and its verification
pub fun step(d: *Driver, row: *Row) err[Error] {
    val changed: res[bool, Error] = apply(d, row.pass);
    if (sel changed.err) { ret err[Error].err{changed.err}; }
    if (changed.ok) {
        var i: usize = 0;
        for (i < row.after.size) {
            if (pipeline.selected(?row.after.data[i], d.t, d.options.level)) {
                val r: err[Error] = step(d, ?row.after.data[i]);
                if (sel r.err) { ret r; }
            }
            i = i + 1;
        }
    }
    ret verify_after(d, row.pass.name, row.verify, changed.ok);
}

# run one family's row over the build, as `step` runs a neutral row
pub fun step_family(d: *Driver, s: *Step, b: *Build) err[Error] {
    val r:       Runs = s.runs;
    var changed: res[bool, Error];
    var name:    str;
    if (sel r.pass) {
        changed = apply(d, r.pass);
        name    = r.pass.name;
    }
    or (sel r.lowering) {
        changed = lower(d, r.lowering, b);
        name    = r.lowering.name;
    }
    or                   { ret err[Error].err{Error.schedule{Defect{pass: nil, problem: Problem.unnamed{}}}}; }
    if (sel changed.err) { ret err[Error].err{changed.err}; }
    if (changed.ok) {
        var i: usize = 0;
        for (i < s.after.size) {
            if (pipeline.stepped(?s.after.data[i], d.t, d.options.level)) {
                val done: err[Error] = step_family(d, ?s.after.data[i], b);
                if (sel done.err) { ret done; }
            }
            i = i + 1;
        }
    }
    ret verify_after(d, name, s.verify, changed.ok);
}

# run a plan the schedule was checked for, the module verified before it
fun run_plan(m: *Module, t: *Target, basis: opt[*Basis], rows: Slice[Row], steps: Slice[Step], b: *Build, options: Options) err[Error] {
    val given: err[verify.Error] = verify.against(m, t, verify.Stage.open{});
    if (sel given.err) {
        if (sel given.err.alloc) { ret err[Error].err{Error.alloc{given.err.alloc}}; }
        ret err[Error].err{Error.input{given.err.refused}};
    }
    val started: res[Driver, Error] = init(m, t, basis, options);
    if (sel started.err) { ret err[Error].err{started.err}; }
    var d: Driver = started.ok;
    fin { dnit(?d); }
    val chosen: res[vector.Vector[Taken], allocator.Error] = pipeline.choose(m.a, rows, steps, t, options.level);
    if (sel chosen.err) { ret err[Error].err{Error.alloc{chosen.err}}; }
    var plan: vector.Vector[Taken] = chosen.ok;
    fin { vector.dnit[Taken](?plan); }
    var last: usize = plan.len;
    var i:    usize = 0;
    for (i < plan.len) {
        if (pipeline.legalises(plan.data[i])) { last = i; }
        i = i + 1;
    }
    i = 0;
    for (i < plan.len) {
        # the module is legal from the last legalisation's own verification on
        if (i == last) { d.legal = true; }
        val taken: Taken = plan.data[i];
        var r:     err[Error];
        if (sel taken.row)  { r = step(?d, taken.row); }
        or (sel taken.step) { r = step_family(?d, taken.step, b); }
        if (sel r.err)      { ret r; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# run a neutral schedule over a module for a target
# ---
# m:       the module, verified against the open rules before anything runs
# t:       the target the module is built for
# basis:   the selection the run reads, none when no family opened a build
# table:   the schedule, checked before anything runs
# options: how it runs
# ret:     ok, or why the run failed
pub fun drive(m: *Module, t: *Target, basis: opt[*Basis], table: Slice[Row], options: Options) err[Error] {
    val whole: err[Defect] = schedule.check(table, analysis.rows());
    if (sel whole.err) { ret err[Error].err{Error.schedule{whole.err}}; }
    ret run_plan(m, t, basis, table, Slice[Step]{data: nil, size: 0}, nil, options);
}

# run the neutral prefix and then a family's rows over a module, with the
# build the family opened for its target
# ---
# m:       the module, verified against the open rules before anything runs
# t:       the target the module is built for, the one the build was opened for
# b:       the build
# legal:   the family's rows, checked with the prefix before anything runs
# options: how it runs
# ret:     ok, or why the run failed
pub fun drive_family(m: *Module, t: *Target, b: *Build, legal: Slice[Step], options: Options) err[Error] {
    val whole: err[Defect] = schedule.check_family(rows.prefix(), legal, analysis.rows());
    if (sel whole.err) { ret err[Error].err{Error.schedule{whole.err}}; }
    ret run_plan(m, t, opt[*Basis].some{?b.basis}, rows.prefix(), legal, b, options);
}

# run mirl's neutral schedule over a module for a target no family serves,
# with no selection
# ---
# m:       the module
# t:       the target the module is built for
# options: the level, and whether every pass is verified
# ret:     ok, or why the run failed
pub fun run(m: *Module, t: *Target, options: Options) err[Error] {
    ret drive(m, t, opt[*Basis].none{}, rows.neutral(), options);
}

# the module, its target and its one function f(x: i32) i32, which returns
# x + x
#[testing]
rec Fixture {
    m: Module;
    t: Target;
    f: Function;
}

#[testing]
fun request(code: opcode.Opcode, operands: Slice[Value]) Request {
    ret Request{opcode: code, operands: operands, immediates: Slice[opcode.Immediate]{data: nil, size: 0}, targets: Slice[Branch]{data: nil, size: 0}};
}

#[testing]
fun fixture(a: *allocator.Allocator, x: *Fixture) bool {
    val row: opt[*Target] = targets.first(targets.register_machine);
    if (sel row.none) { ret false; }
    x.t = @row.some;
    val name: str                       = row.some.name;
    val made: res[Module, module.Error] = module.init(a, View{data: name, len: str_len(name)});
    if (sel made.err) { ret false; }
    x.m = made.ok;
    val i32: res[Type, types.Error] = types.intern(?x.m.types, types.Shape.integer{types.Integer{width: 32}});
    if (sel i32.err) { ret false; }
    var one: [1]Type                = [1]Type{i32.ok};
    val sig: res[Type, types.Error] = types.intern(?x.m.types, types.Shape.function{types.plain(Slice[Type]{data: ?one[0], size: 1}, Slice[Type]{data: ?one[0], size: 1})});
    if (sel sig.err) { ret false; }
    var b: Builder = build.init(?x.m);
    x.f = build.function(?b, FunctionData{name: View{data: "f", len: 1}, signature: sig.ok, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    build.enter(?b, x.f);
    var decl:  [1]Declaration = [1]Declaration{Declaration{type: i32.ok, secret: false}};
    val entry: Block          = build.block(?b, Slice[Declaration]{data: ?decl[0], size: 1});
    val v:     Value          = build.parameter(?b, entry, 0);
    build.at_end(?b, entry);
    var xx:  [2]Value    = [2]Value{v, v};
    val sum: Instruction = build.emit(?b, request(opcode.ADD, Slice[Value]{data: ?xx[0], size: 2}));
    var y:   [1]Value    = [1]Value{build.result(?b, sum, 0)};
    build.emit(?b, request(opcode.RET, Slice[Value]{data: ?y[0], size: 1}));
    val ended: err[build.Failure] = build.done(?b);
    ret sel ended.ok;
}

#[testing]
fun changes(u: *Unit) res[bool, Why] {
    ret res[bool, Why].ok{true};
}

#[testing]
fun leaves(u: *Unit) res[bool, Why] {
    ret res[bool, Why].ok{false};
}

#[testing]
val KEEPS_SHAPE:     Pass = Pass{name: "keeps-shape", scope: record.Scope.function{changes}, preserves: analysis.SHAPE};
#[testing]
val KEEPS_DOMINANCE: Pass = Pass{name: "keeps-dominance", scope: record.Scope.function{changes}, preserves: 0x2};
#[testing]
val CHANGES_NOTHING: Pass = Pass{name: "changes-nothing", scope: record.Scope.function{leaves}};

#[testing]
fun holding(d: *Driver, f: Function) u8 {
    var bits: u8 = 0;
    if (cache.held(?d.cache, f, analysis.GRAPH))     { bits = bits | 1; }
    if (cache.held(?d.cache, f, analysis.DOMINANCE)) { bits = bits | 2; }
    if (cache.held(?d.cache, f, analysis.LOOPS))     { bits = bits | 4; }
    ret bits;
}

test pass__unpreserved_analysis_is_dropped {
    var a: allocator.Allocator;
    page.make(?a);
    var x: Fixture;
    if (!fixture(?a, ?x)) { ret 1; }
    fin { module.dnit(?x.m); }
    val started: res[Driver, Error] = init(?x.m, ?x.t, target_basis.NONE, Options{level: 2, checked: true});
    if (sel started.err) { ret 90; }
    var d: Driver = started.ok;
    fin { dnit(?d); }

    val first: res[*loops.Loops, Why] = analysis.loops_of(?d.cache, x.f);
    if (sel first.err)         { ret 2; }
    if (holding(?d, x.f) != 7) { ret 2; }
    val shaped: res[bool, Error] = apply(?d, ?KEEPS_SHAPE);
    if (sel shaped.err || holding(?d, x.f) != 3) { ret 3; }
    # dominance is kept but the graph it is computed from is not
    val dominated: res[bool, Error] = apply(?d, ?KEEPS_DOMINANCE);
    if (sel dominated.err || holding(?d, x.f) != 0) { ret 4; }
    val again: res[*loops.Loops, Why] = analysis.loops_of(?d.cache, x.f);
    if (sel again.err) { ret 5; }
    val left: res[bool, Error] = apply(?d, ?CHANGES_NOTHING);
    if (sel left.err || holding(?d, x.f) != 7) { ret 5; }
    ret 0;
}

# a module breaking the width rule is refused as input before any pass runs
test pass__refuses_an_input_that_breaks_an_open_rule_before_any_pass {
    var a: allocator.Allocator;
    page.make(?a);
    var x: Fixture;
    if (!fixture(?a, ?x)) { ret 1; }
    fin { module.dnit(?x.m); }
    val i32: res[Type, types.Error] = types.intern(?x.m.types, types.Shape.integer{types.Integer{width: 32}});
    if (sel i32.err) { ret 1; }
    x.m.types.nodes.data[i32.ok.index].shape = types.Shape.integer{types.Integer{width: 12}};
    val r: err[Error] = run(?x.m, ?x.t, Options{level: 2, checked: false});
    if (!(sel r.err))                                       { ret 2; }
    if (!(sel r.err.input))                                 { ret 3; }
    if (r.err.input.rule.index != verify_table.WIDTH.index) { ret 4; }
    ret 0;
}

#[testing]
var EDITED: bool = false;

# put a new x + x in place of the old one, erase the old one, then refuse
#[testing]
fun breaks(u: *Unit) res[bool, Why] {
    val m:   *Module                  = u.context.m;
    val got: res[*Body, module.Error] = module.body(m, u.f);
    if (sel got.err) { ret res[bool, Why].err{Why.ir{got.err}}; }
    val sum: Instruction = got.ok.blocks.data[0].instructions.data[0];
    val old: Value       = got.ok.instructions.data[sum.index].results.data[0];
    var xx:  [2]Value    = [2]Value{got.ok.blocks.data[0].parameters.data[0], got.ok.blocks.data[0].parameters.data[0]};
    var b:   Builder     = build.init(m);
    build.enter(?b, u.f);
    build.at(?b, Block{index: 0}, 1);
    val more:  Instruction        = build.emit(?b, request(opcode.ADD, Slice[Value]{data: ?xx[0], size: 2}));
    val new:   Value              = build.result(?b, more, 0);
    val ended: err[build.Failure] = build.done(?b);
    if (sel ended.err) { ret res[bool, Why].err{Why.build{ended.err}}; }
    val replaced: err[module.Error] = body.replace(m, u.f, old, new, body.Records.follow{});
    if (sel replaced.err) { ret res[bool, Why].err{Why.ir{replaced.err}}; }
    val erased: err[module.Error] = body.erase(m, u.f, sum);
    if (sel erased.err) { ret res[bool, Why].err{Why.ir{erased.err}}; }
    EDITED = true;
    ret res[bool, Why].err{Why.reason{"refused after an edit"}};
}

#[testing]
val BREAKS:   Pass   = Pass{name: "breaks", kind: record.Kind.legalise{}, scope: record.Scope.function{breaks}};
#[testing]
val BREAKING: [1]Row = [1]Row{Row{pass: ?BREAKS}};

# grow the module with a function, a global, its constant, an export, an
# attribute on f, a type and a debug file, then refuse
#[testing]
fun grows(c: *Context) res[bool, Why] {
    val m:   *Module                = c.m;
    val i64: res[Type, types.Error] = types.intern(?m.types, types.Shape.integer{types.Integer{width: 64}});
    if (sel i64.err) { ret res[bool, Why].err{Why.reason{"no type"}}; }
    val sig: Type                        = m.functions.data[0].data.signature;
    val g:   res[Function, module.Error] = module.add_function(m, FunctionData{name: View{data: "g", len: 1}, signature: sig, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    if (sel g.err) { ret res[bool, Why].err{Why.ir{g.err}}; }
    var seven: [1]u64                      = [1]u64{7};
    val k:     res[Constant, module.Error] = module.add_constant(m, ConstantData.integer{Bits{type: i64.ok, words: Slice[u64]{data: ?seven[0], size: 1}}});
    if (sel k.err) { ret res[bool, Why].err{Why.ir{k.err}}; }
    val v: res[Global, module.Error] = module.add_global(m, GlobalData{name: View{data: "counter", len: 7}, type: i64.ok, initial: opt[Constant].some{k.ok}, linkage: Linkage{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT}});
    if (sel v.err) { ret res[bool, Why].err{Why.ir{v.err}}; }
    val e: err[module.Error] = module.export(m, Symbol.global{v.ok});
    if (sel e.err) { ret res[bool, Why].err{Why.ir{e.err}}; }
    val at: err[module.Error] = module.attach(m, Symbol.function{Function{index: 0}}, Attribute{family: View{data: "spirv", len: 5}, name: View{data: "stage", len: 5}, datum: Datum.integer{1}});
    if (sel at.err) { ret res[bool, Why].err{Why.ir{at.err}}; }
    val file: res[ir_debug.File, ir_debug.Error] = ir_debug.file(?m.debug, View{data: "x.mach", len: 6});
    if (sel file.err) { ret res[bool, Why].err{Why.reason{"no file"}}; }
    EDITED = true;
    ret res[bool, Why].err{Why.reason{"refused after growing the module"}};
}

#[testing]
val GROWS:   Pass   = Pass{name: "grows", kind: record.Kind.legalise{}, scope: record.Scope.module{grows}};
#[testing]
val GROWING: [1]Row = [1]Row{Row{pass: ?GROWS}};

#[testing]
var VISITS: u32 = 0;

#[testing]
fun counts(u: *Unit) res[bool, Why] {
    VISITS = VISITS + 1;
    ret res[bool, Why].ok{false};
}

#[testing]
val KEEPS:   Pass   = Pass{name: "keeps", kind: record.Kind.legalise{}, scope: record.Scope.function{counts}, time: record.Time.keeps{}};
#[testing]
val KEEPING: [1]Row = [1]Row{Row{pass: ?KEEPS}};

#[testing]
fun printed(a: *allocator.Allocator, m: *Module, out: *text.Sink) bool {
    @out = text.init(a);
    var w: io.Writer       = text.writer(out);
    val r: err[text.Error] = text.print(?w, m);
    ret sel r.ok;
}

test pass__refusal_leaves_the_function_unchanged {
    var a: allocator.Allocator;
    page.make(?a);
    var x: Fixture;
    if (!fixture(?a, ?x)) { ret 1; }
    fin { module.dnit(?x.m); }
    var before: text.Sink;
    if (!printed(?a, ?x.m, ?before)) { ret 2; }
    fin { text.dnit(?before); }

    val r: err[Error] = drive(?x.m, ?x.t, target_basis.NONE, Slice[Row]{data: ?BREAKING[0], size: 1}, Options{level: 0, checked: true});
    if (!EDITED)                                   { ret 3; }
    if (!(sel r.err))                              { ret 4; }
    if (!(sel r.err.refused))                      { ret 4; }
    if (!str_equals(r.err.refused.pass, "breaks")) { ret 4; }

    var after: text.Sink;
    if (!printed(?a, ?x.m, ?after)) { ret 5; }
    fin { text.dnit(?after); }
    if (!slice.same_view(text.view(?before), text.view(?after))) { ret 6; }
    val v: err[verify.Error] = verify.against(?x.m, ?x.t, verify.Stage.open{});
    if (sel v.err) { ret 7; }

    # a module pass that refuses takes back all it added and attached
    val types_before:     u32   = types.mark(?x.m.types);
    val constants_before: usize = x.m.constants.len;
    EDITED = false;
    val grown: err[Error] = drive(?x.m, ?x.t, target_basis.NONE, Slice[Row]{data: ?GROWING[0], size: 1}, Options{level: 0, checked: true});
    if (!EDITED || !(sel grown.err))                                                                        { ret 10; }
    if (types.mark(?x.m.types) != types_before || x.m.constants.len != constants_before)                    { ret 11; }
    if (x.m.functions.len != 1 || x.m.globals.len != 0 || x.m.exports.len != 0 || x.m.debug.files.len != 0) { ret 11; }
    var restored: text.Sink;
    if (!printed(?a, ?x.m, ?restored)) { ret 12; }
    fin { text.dnit(?restored); }
    if (!slice.same_view(text.view(?before), text.view(?restored))) { ret 12; }

    # a pass that breaks constant time never visits a function requiring it
    x.m.functions.data[x.f.index].data.constant_time = true;
    EDITED                                           = false;
    val skipped: err[Error] = drive(?x.m, ?x.t, target_basis.NONE, Slice[Row]{data: ?BREAKING[0], size: 1}, Options{level: 0, checked: true});
    if (sel skipped.err || EDITED) { ret 8; }
    val kept: err[Error] = drive(?x.m, ?x.t, target_basis.NONE, Slice[Row]{data: ?KEEPING[0], size: 1}, Options{level: 0, checked: true});
    if (sel kept.err || VISITS != 1) { ret 9; }
    ret 0;
}

# a build opened for one target is refused for a run on another before
# anything runs, the module as it was
test pass__a_build_opened_for_another_target_is_refused {
    var a: allocator.Allocator;
    page.make(?a);
    var x: Fixture;
    if (!fixture(?a, ?x)) { ret 1; }
    fin { module.dnit(?x.m); }
    val opened_for: opt[*Target] = targets.first(machine.stated);
    if (sel opened_for.none) { ret 1; }
    var run_on: opt[*Target] = opt[*Target].none{};
    var i:      usize        = 0;
    for (i < targets.rows() && sel run_on.none) {
        val row: opt[*Target] = targets.row(i);
        if (sel row.some) {
            if (row.some != opened_for.some && machine.stated(row.some)) { run_on = row; }
        }
        i = i + 1;
    }
    if (sel run_on.none) { ret 1; }
    var b:      Build;
    val opened: err[target_basis.Error] = machine.open(?b, ?a, opened_for.some, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 2; }
    fin { machine.close(?b); }
    var before: text.Sink;
    if (!printed(?a, ?x.m, ?before)) { ret 3; }
    fin { text.dnit(?before); }

    val started: res[Driver, Error] = init(?x.m, run_on.some, opt[*Basis].some{?b.basis}, Options{level: 2, checked: true});
    if (sel started.ok) {
        var d: Driver = started.ok;
        dnit(?d);
        ret 4;
    }
    val why: Error = started.err;
    if (!(sel why.foreign)) { ret 5; }

    var after: text.Sink;
    if (!printed(?a, ?x.m, ?after)) { ret 6; }
    fin { text.dnit(?after); }
    if (!slice.same_view(text.view(?before), text.view(?after))) { ret 7; }
    ret 0;
}
