# the driver: one pass, one row or a whole schedule over a module
#
# a pass that refuses aborts the run with its diagnostic and the module is
# given up: the driver takes no mark of the module, so a refusing pass may leave its edits
# in the function it was visiting.
# the driver keeps the set of functions each pass changed: a function pass
# changed each function whose visit said so, and a module pass each function
# it marks and each one it added. after a pass, every analysis it does not
# preserve is dropped for the functions it changed. a pass reads only the
# analyses its record needs, the rows those need with them, which the cache
# holds it to. the verifier runs only in a checked run: on the module it is
# given before the first pass and after every pass, and from the last
# legalisation of the plan on it holds the module to the rules of legal code
# over the trees the structure analysis holds. after a pass it walks the bodies
# of only the functions that pass changed, beside the module's own facts, and
# every body after the last legalisation. then the oblivious check runs over
# each changed function that requires constant time, so a pass that left a
# secret where none may be is named. an unchecked run verifies nothing, so a
# caller that reads a module from text verifies it before handing it over.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.chrono.time.Instant;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.base.stats;
use mirl.base.stats.Stats;
use mct: mirl.ct;
use mirl.ct.oblivious;
use mirl.ir.function.Node;
use mirl.ir.function.in_constant_time;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.analysis;
use mirl.pass.cache;
use mirl.pass.cache.Cache;
use mirl.pass.failure.Defect;
use mirl.pass.failure.Error;
use mirl.pass.failure.Oblivious;
use mirl.pass.failure.Problem;
use mirl.pass.failure.Refusal;
use mirl.pass.failure.Unverified;
use mirl.pass.pipeline;
use mirl.pass.pipeline.Taken;
use mirl.pass.record;
use mirl.pass.record.Changed;
use mirl.pass.record.Context;
use mirl.pass.record.Ground;
use mirl.pass.record.Lower;
use mirl.pass.record.LowerAll;
use mirl.pass.record.Lowering;
use mirl.pass.record.Pass;
use mirl.pass.record.Run;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.record.Visit;
use mirl.pass.refusal;
use mirl.pass.relaxation.Relaxations;
use mirl.pass.rows;
use mirl.pass.schedule;
