# the neutral schedule: the rows every target runs, one row per step, in order
#
# a target-neutral pass joins the pipeline as one row here, its comment saying
# why it sits where it does. the rows read the target and the selection alone.
# a served target runs the prefix and then its family's rows, which run every
# legalisation over the build the family opened and run again the neutral
# rows that read what the legalisations leave. a target no family serves runs
# the prefix and then the rest, the neutral rows alone.
#
# promotion runs first, so every pass after it sees values in place of the
# memory the front end lowered locals to. a typed address is folded to a byte
# offset next where addressing is physical, and a multi-way branch to a
# compare chain where control is free, ahead of every family's legalisations,
# which legalise the offset arithmetic and the compares they make as any
# other. folding follows, since promotion is
# what puts constants where the operations read them, then algebraic
# simplification, which reads the constants folding left as the elements of
# identities, then common subexpression elimination, which sees the
# simplified values, then loop invariant code motion, which moves what is
# left once per loop out of it, then dead code removal, and the structurizer
# runs last, after every pass that reshapes the graph. each verifies when it
# changed something

use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.legal.address.ADDRESS;
use mirl.legal.chain.CHAIN;
use mirl.opt.algebraic.ALGEBRAIC;
use mirl.opt.cse.CSE;
use mirl.opt.dce.DCE;
use mirl.opt.fold.FOLD;
use mirl.opt.licm.LICM;
use mirl.opt.promote.PROMOTE;
use mirl.pass.schedule.FROM_1;
use mirl.pass.schedule.FROM_2;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Verify;
use mirl.structure.STRUCTURIZE;

# each neutral row, the one owner of its levels and its verification, which a
# family's rows name to run it again among their own
pub val PROMOTE_ROW:   Row = Row{pass: ?PROMOTE, levels: FROM_1, verify: Verify.changed{}};
pub val ADDRESS_ROW:   Row = Row{pass: ?ADDRESS, verify: Verify.changed{}};
pub val CHAIN_ROW:     Row = Row{pass: ?CHAIN, verify: Verify.changed{}};
pub val FOLD_ROW:      Row = Row{pass: ?FOLD, levels: FROM_1, verify: Verify.changed{}};
pub val ALGEBRAIC_ROW: Row = Row{pass: ?ALGEBRAIC, levels: FROM_1, verify: Verify.changed{}};
pub val CSE_ROW:       Row = Row{pass: ?CSE, levels: FROM_1, verify: Verify.changed{}};
pub val LICM_ROW:      Row = Row{pass: ?LICM, levels: FROM_2, verify: Verify.changed{}};
pub val DCE_ROW:       Row = Row{pass: ?DCE, levels: FROM_1, verify: Verify.changed{}};
pub val STRUCTURE_ROW: Row = Row{pass: ?STRUCTURIZE, verify: Verify.changed{}};

val ROWS: [9]Row = [9]Row{PROMOTE_ROW, ADDRESS_ROW, CHAIN_ROW, FOLD_ROW, ALGEBRAIC_ROW, CSE_ROW, LICM_ROW, DCE_ROW, STRUCTURE_ROW};

# the rows ahead of every family's rows: promotion, which every pass after it
# reads, and the folding of typed addresses and multi-way branches, which
# apply by the target's addressing and control alone
val PREFIX: usize = 3;

# the neutral rows in order, the whole schedule of a target no family serves
pub fun neutral() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: 9};
}

# the neutral rows every served target runs ahead of its family's rows
pub fun prefix() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: PREFIX};
}
