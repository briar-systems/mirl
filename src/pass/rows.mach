# the neutral schedule: the rows every target runs, one row per step, in order
#
# a target-neutral pass joins the pipeline as one row here, its comment saying
# why it sits where it does. the rows read the target and the selection alone.
# every target runs the prefix and then its family's rows, which run every
# legalisation over the build the family opened and run again the neutral
# rows after the prefix where they read what the legalisations leave.
#
# specialization constants a target holds no consumer of are made their
# defaults first, so every pass after it reads them as the numbers they are.
# the optimisations of open ir follow, before any legalisation adds to the ir
# and before the timing rows exist: inlining first, so every pass after it
# sees each expanded body joined to its caller and promotion runs once over
# the joined body, then the end of every body another module defines, which
# only the inliner reads and which runs whatever the setting, then the
# splitting of slots into one slot per
# part their accesses reach, so promotion takes each part, then promotion, so
# every pass after it sees
# values in place of the memory the front end lowered locals to, then
# reassociation where the build permits it, ahead of every legalisation that
# could take a sequential reduction apart in its order, then folding, since
# promotion is what puts constants where the operations read them, then
# algebraic simplification, which reads the constants folding left as the
# elements of identities and gives the canonical forms every later row and
# rule reads, a compare's constant on its right, a product by a power of two
# as a shift and the unsigned division and signed conversion the value ranges
# admit, then the reduction of divisions by constants to multiplies and
# shifts, which reads the constants the two leave and the unsigned forms, then the
# statement of each function's call effects,
# which the memory analysis reads of every call, then common subexpression
# elimination, which sees the simplified values, then the forwarding of a
# stored value to a later load of its bytes in its block, which takes the loads
# common subexpression elimination leaves, then the removal of a store a
# later store of its block writes again before anything reads it, which the
# forwarded loads leave, then dead code removal, so the blocks the next two
# rows read hold nothing the rows before left unread (a dead widening of a
# test, a value folding replaced), then the bypass of each block that only
# jumps on, so the edges that enter it pass its target what it passed, which
# takes the return blocks inlining left and the jumps folding left of decided
# branches, then the threading of an edge that passes a block the constant its
# branch decides on straight to the branch's target, which reads the constants
# the bypass made direct, then the conversion of a branch whose arms only compute values for the block
# they join into a select of each value, then the removal of a mask that
# changes no bit any reader of its result reads, then loop invariant code
# motion, which moves what is left once per loop out of it, then the
# vectorisation of a counted loop over arrays, which reads the loop as licm
# left it and before unrolling copies its body, then the copying of each
# small innermost loop once, so a trip runs its body twice, then the rotation
# of each loop tested at its top into a guard and a test at its bottom, after
# the two rows that read a loop tested at its top, with loop invariant code
# motion again over the functions it changed, since the body is then the
# header that motion takes loads and traps from, then dead code
# removal, then the bypass again, of the blocks dead code removal emptied,
# then the recognition of a chain of tests of one value against
# constants as a multi-way branch, which reads the chains the earlier rows left
# with every dead widening of a test gone. folding runs again after algebraic simplification and common
# subexpression elimination over the functions they changed, as each leaves
# constants and decided branches. none runs after vectorisation: its copies and fills stay packed loops (mirl#751).
# a typed address is folded to a byte offset
# where addressing is physical, and a multi-way branch to a compare chain
# where control is free, after them and ahead of every family's
# legalisations, which legalise the offset arithmetic and the compares they
# make as any other. a family runs folding, simplification, the effects,
# common subexpression elimination and dead code removal again over the legal
# ir, rows that move no instruction, so none crosses a timing switch, and the
# structurizer runs last, after every pass that reshapes the graph. the
# carrying of a constant a loop reads through its header (`HOIST_ROW`) is no
# row of the prefix: a register family runs it after its legalisations, which
# make constants of their own, and no other family makes a constant at each
# read. each
# verifies after it runs when the run is checked.
#
# the markers of where a slot's storage begins and ends (`slot.begin`,
# `slot.end`) stand through every row here: each pass that orders accesses
# reads them as writes of their slot (`mirl.pass.analysis.memory`), the passes
# that remove, split or copy a slot do the same to its markers, and a family
# whose frames never lay two slots in one storage erases them after the last
# of its own rows that may make one (`mirl.legal.unscoped`)

use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.legal.address.ADDRESS;
use mirl.legal.available.AVAILABLE;
use mirl.legal.chain.CHAIN;
use mirl.legal.specialize.SPECIALIZE;
use mirl.opt.algebraic.ALGEBRAIC;
use mirl.opt.bypass.BYPASS;
use mirl.opt.cse.CSE;
use mirl.opt.dce.DCE;
use mirl.opt.demanded.DEMANDED;
use mirl.opt.dse.DSE;
use mirl.opt.effects.EFFECTS;
use mirl.opt.fold.FOLD;
use mirl.opt.forward.FORWARD;
use mirl.opt.hoist.HOIST;
use mirl.opt.ifconvert.IFCONVERT;
use mirl.opt.inline.INLINE;
use mirl.opt.licm.LICM;
use mirl.opt.promote.PROMOTE;
use mirl.opt.reassociate.REASSOCIATE;
use mirl.opt.reduce.REDUCE;
use mirl.opt.rotate.ROTATE;
use mirl.opt.split.SPLIT;
use mirl.opt.switch.SWITCH;
use mirl.opt.thread.THREAD;
use mirl.opt.unroll.UNROLL;
use mirl.opt.vectorise.VECTORISE;
use mirl.pass.record.Pass;
use mirl.pass.schedule.Row;
use mirl.structure.pass.STRUCTURIZE;

# each neutral row, which a family's rows name to run it again among their own
pub val SPECIALIZE_ROW:  Row = Row{pass: ?SPECIALIZE};
pub val INLINE_ROW:      Row = Row{pass: ?INLINE};
pub val AVAILABLE_ROW:   Row = Row{pass: ?AVAILABLE};
pub val SPLIT_ROW:       Row = Row{pass: ?SPLIT};
pub val PROMOTE_ROW:     Row = Row{pass: ?PROMOTE};
pub val ADDRESS_ROW:     Row = Row{pass: ?ADDRESS};
pub val CHAIN_ROW:       Row = Row{pass: ?CHAIN};
pub val REASSOCIATE_ROW: Row = Row{pass: ?REASSOCIATE};
pub val FOLD_ROW:        Row = Row{pass: ?FOLD};
pub val ALGEBRAIC_ROW:   Row = Row{pass: ?ALGEBRAIC, after: Slice[Row]{data: ?FOLDED[0], size: 1}};
pub val REDUCE_ROW:      Row = Row{pass: ?REDUCE};
pub val EFFECTS_ROW:     Row = Row{pass: ?EFFECTS};
pub val CSE_ROW:         Row = Row{pass: ?CSE, after: Slice[Row]{data: ?FOLDED[0], size: 1}};
pub val FORWARD_ROW:     Row = Row{pass: ?FORWARD};
pub val DSE_ROW:         Row = Row{pass: ?DSE};
pub val BYPASS_ROW:      Row = Row{pass: ?BYPASS};
pub val THREAD_ROW:      Row = Row{pass: ?THREAD};
pub val IFCONVERT_ROW:   Row = Row{pass: ?IFCONVERT};
pub val DEMANDED_ROW:    Row = Row{pass: ?DEMANDED};
pub val LICM_ROW:        Row = Row{pass: ?LICM};
pub val VECTORISE_ROW:   Row = Row{pass: ?VECTORISE};
pub val HOIST_ROW:       Row = Row{pass: ?HOIST};
pub val UNROLL_ROW:      Row = Row{pass: ?UNROLL};
pub val ROTATE_ROW:      Row = Row{pass: ?ROTATE, after: Slice[Row]{data: ?HOISTED[0], size: 1}};
pub val DCE_ROW:         Row = Row{pass: ?DCE};
pub val SWITCH_ROW:      Row = Row{pass: ?SWITCH};
pub val STRUCTURE_ROW:   Row = Row{pass: ?STRUCTURIZE};

# the follow-up of a row that leaves constants: folding over the functions it changed
val FOLDED: [1]Row = [1]Row{FOLD_ROW};

# the follow-up of loop rotation: loop invariant code motion over the functions it changed
val HOISTED: [1]Row = [1]Row{LICM_ROW};

val ROWS: [27]Row = [27]Row{SPECIALIZE_ROW, INLINE_ROW, AVAILABLE_ROW, SPLIT_ROW, PROMOTE_ROW, REASSOCIATE_ROW, FOLD_ROW, ALGEBRAIC_ROW, REDUCE_ROW, EFFECTS_ROW, CSE_ROW, FORWARD_ROW, DSE_ROW, DCE_ROW, BYPASS_ROW, THREAD_ROW, IFCONVERT_ROW, DEMANDED_ROW, LICM_ROW, VECTORISE_ROW, UNROLL_ROW, ROTATE_ROW, DCE_ROW, BYPASS_ROW, SWITCH_ROW, ADDRESS_ROW, CHAIN_ROW};

# the rows ahead of every family's rows: the folding of specialization
# constants, which applies by the target's specialization alone, the
# optimisations of open ir, and the folding of typed addresses and multi-way
# branches, which apply by the target's addressing and control alone
val PREFIX: usize = 27;

# the neutral rows every served target runs ahead of its family's rows
pub fun prefix() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: PREFIX};
}

# every optimisation pass, in the order a setting numbers them, each by the name a build turns it on or off by.
# a pass of the optimise kind joins this list as it joins a schedule, which refuses one the list does not hold
val OPTIMISATIONS: [22]*Pass = [22]*Pass{?INLINE, ?SPLIT, ?PROMOTE, ?REASSOCIATE, ?FOLD, ?ALGEBRAIC, ?REDUCE, ?EFFECTS, ?CSE, ?FORWARD, ?DSE, ?BYPASS, ?THREAD, ?IFCONVERT, ?DEMANDED, ?LICM, ?VECTORISE, ?HOIST, ?UNROLL, ?ROTATE, ?DCE, ?SWITCH};

# every optimisation pass, which `mirl.pass.setting` numbers
pub fun optimisations() Slice[*Pass] {
    ret Slice[*Pass]{data: ?OPTIMISATIONS[0], size: $length_of(OPTIMISATIONS)};
}
