# the schedule mirl runs: one row per step, in order
#
# a pass joins the pipeline as one row here, its comment saying why it sits
# where it does.

use std.collections.slice.Slice;

use mirl.legal.multiply.MULTIPLY_FORMS;
use mirl.legal.narrow.NARROW;
use mirl.legal.shift.SHIFT_BOUND;
use mirl.legal.wide.WIDE;
use mirl.opt.algebraic.ALGEBRAIC;
use mirl.opt.cse.CSE;
use mirl.opt.dce.DCE;
use mirl.opt.fold.FOLD;
use mirl.opt.licm.LICM;
use mirl.opt.promote.PROMOTE;
use mirl.pass.schedule.FROM_1;
use mirl.pass.schedule.FROM_2;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Verify;
use mirl.structure.STRUCTURIZE;

# promotion runs first, so every pass after it sees values in place of the
# memory the front end lowered locals to. narrow arithmetic is widened next,
# so every pass after it sees the extensions and truncations it leaves and
# folds the ones of constants, and integers wider than the target computes at
# are split into words after it, so every pass after it optimises the words.
# the splitting reads a wide value at a call, an entry or a return as the abi
# legalisation leaves it, in register pieces, so that legalisation runs ahead
# of it. folding follows, since promotion is what puts
# constants where the operations read them, then algebraic
# simplification, which reads the constants folding left as the elements of
# identities, then common subexpression elimination, which sees the simplified
# values, then loop invariant code motion, which moves what is left once per
# loop out of it, then the legalisations of what the target cannot do, which
# read the code the optimisations left and run on it last: the multiply forms
# first, since the split product they build is made of shifts, and the shift
# bounding after it, which marks every shift whose count is below its width,
# then dead code removal, which takes out what the legalisations replaced, and
# the structurizer runs last, after every pass that reshapes the graph. each
# verifies when it changed something
val ROWS: [11]Row = [11]Row{
    Row{pass: ?PROMOTE, levels: FROM_1, verify: Verify.changed{}},
    Row{pass: ?NARROW, verify: Verify.changed{}},
    Row{pass: ?WIDE, verify: Verify.changed{}},
    Row{pass: ?FOLD, levels: FROM_1, verify: Verify.changed{}},
    Row{pass: ?ALGEBRAIC, levels: FROM_1, verify: Verify.changed{}},
    Row{pass: ?CSE, levels: FROM_1, verify: Verify.changed{}},
    Row{pass: ?LICM, levels: FROM_2, verify: Verify.changed{}},
    Row{pass: ?MULTIPLY_FORMS, verify: Verify.changed{}},
    Row{pass: ?SHIFT_BOUND, verify: Verify.changed{}},
    Row{pass: ?DCE, levels: FROM_1, verify: Verify.changed{}},
    Row{pass: ?STRUCTURIZE, verify: Verify.changed{}},
};

# the rows, in order
pub fun schedule() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: 11};
}
