# the neutral schedule: the rows every target runs, one row per step, in order
#
# a target-neutral pass joins the pipeline as one row here, its comment saying
# why it sits where it does. the rows read the target and the selection alone.
# every target runs the prefix and then its family's rows, which run every
# legalisation over the build the family opened and run again the neutral
# rows after the prefix where they read what the legalisations leave.
#
# specialization constants a target holds no consumer of are made their
# defaults first, so every pass after it reads them as the numbers they are.
# promotion runs next, so every pass after it sees values in place of the
# memory the front end lowered locals to. a typed address is folded to a byte
# offset next where addressing is physical, and a multi-way branch to a
# compare chain where control is free, ahead of every family's legalisations,
# which legalise the offset arithmetic and the compares they make as any
# other. reassociation follows where the build permits it, ahead of every
# legalisation that could take a sequential reduction apart in its order, so
# a family's lowering of a reduction reads the grouping the build permits.
# folding follows, since promotion is
# what puts constants where the operations read them, then algebraic
# simplification, which reads the constants folding left as the elements of
# identities, then common subexpression elimination, which sees the
# simplified values, then loop invariant code motion, which moves what is
# left once per loop out of it, then dead code removal, and the structurizer
# runs last, after every pass that reshapes the graph. each verifies after it
# runs when the run is checked

use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.legal.address.ADDRESS;
use mirl.legal.chain.CHAIN;
use mirl.legal.specialize.SPECIALIZE;
use mirl.opt.algebraic.ALGEBRAIC;
use mirl.opt.cse.CSE;
use mirl.opt.dce.DCE;
use mirl.opt.fold.FOLD;
use mirl.opt.licm.LICM;
use mirl.opt.promote.PROMOTE;
use mirl.opt.reassociate.REASSOCIATE;
use mirl.pass.record.Pass;
use mirl.pass.schedule.Row;
use mirl.structure.pass.STRUCTURIZE;

# each neutral row, which a family's rows name to run it again among their own
pub val SPECIALIZE_ROW:  Row = Row{pass: ?SPECIALIZE};
pub val PROMOTE_ROW:     Row = Row{pass: ?PROMOTE};
pub val ADDRESS_ROW:     Row = Row{pass: ?ADDRESS};
pub val CHAIN_ROW:       Row = Row{pass: ?CHAIN};
pub val REASSOCIATE_ROW: Row = Row{pass: ?REASSOCIATE};
pub val FOLD_ROW:        Row = Row{pass: ?FOLD};
pub val ALGEBRAIC_ROW:   Row = Row{pass: ?ALGEBRAIC};
pub val CSE_ROW:         Row = Row{pass: ?CSE};
pub val LICM_ROW:        Row = Row{pass: ?LICM};
pub val DCE_ROW:         Row = Row{pass: ?DCE};
pub val STRUCTURE_ROW:   Row = Row{pass: ?STRUCTURIZE};

val ROWS: [5]Row = [5]Row{SPECIALIZE_ROW, PROMOTE_ROW, ADDRESS_ROW, CHAIN_ROW, REASSOCIATE_ROW};

# the rows ahead of every family's rows: the folding of specialization
# constants, which applies by the target's specialization alone, promotion,
# which every pass after it reads, the folding of typed addresses and multi-way branches, which apply
# by the target's addressing and control alone, and reassociation, which
# applies by the build's float relaxations alone
val PREFIX: usize = 5;

# the neutral rows every served target runs ahead of its family's rows
pub fun prefix() Slice[Row] {
    ret Slice[Row]{data: ?ROWS[0], size: PREFIX};
}

# every optimisation pass, in the order a setting numbers them, each by the name a build turns it on or off by.
# a pass of the optimise kind joins this list as it joins a schedule, which refuses one the list does not hold
val OPTIMISATIONS: [7]*Pass = [7]*Pass{?PROMOTE, ?REASSOCIATE, ?FOLD, ?ALGEBRAIC, ?CSE, ?LICM, ?DCE};

# every optimisation pass, which `mirl.pass.setting` numbers
pub fun optimisations() Slice[*Pass] {
    ret Slice[*Pass]{data: ?OPTIMISATIONS[0], size: $length_of(OPTIMISATIONS)};
}
