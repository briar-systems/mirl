# why a run of the schedule stopped

use std.types.option.opt;
use std.types.string.str;

use std.allocator;

use mirl.ir.id.Function;
use mirl.pass.refusal;
use verify: mirl.verify.failure;

# what a walk of the schedule found wrong with it
# ---
# unnamed:      a row with no pass, or a pass with no name
# unscoped:     a pass with no visit or run to call
# renamed:      two different pass records with one name
# unregistered: a follow-up whose pass has no row of its own
# cycle:        a pass that follows itself through its follow-ups
# preserves:    a pass that preserves an analysis no registry row declares
# analysis:     a registry row that needs itself or a row after it, or a
#               registry too large for a set to hold
pub tag Problem: u8 {
    unnamed;
    unscoped;
    renamed;
    unregistered;
    cycle;
    preserves;
    analysis: u32;
}

# a defect of the schedule
# ---
# pass:    the name of the pass it was found at, nil when it has none
# problem: what is wrong
pub rec Defect {
    pass:    str;
    problem: Problem;
}

# a pass that refused, after the function or module was put back as it was
# ---
# pass:     the pass's name
# function: the function it refused, none for a pass over the whole module
# why:      why
pub rec Refusal {
    pass:     str;
    function: opt[Function];
    why:      refusal.Error;
}

# a module the verifier refused after a pass
# ---
# pass:  the name of the pass that left it so
# error: the verifier's answer
pub rec Unverified {
    pass:  str;
    error: verify.Error;
}

# why a run of the schedule failed
# ---
# schedule:   the schedule is malformed, and nothing ran
# input:      the module given breaks a rule of the verifier, and nothing ran
# foreign:    the machine given was opened for another target than the run's,
#             and nothing ran
# refused:    a pass refused
# unverified: the verifier refused the module after a pass
# alloc:      the allocator refused the run's own storage
pub tag Error: u8 {
    schedule: Defect;
    input:    verify.Failure;
    foreign;
    refused:    Refusal;
    unverified: Unverified;
    alloc:      allocator.Error;
}
