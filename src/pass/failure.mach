# why a pass, an analysis or a run of the schedule stopped

use std.types.error.err;
use std.types.option.opt;
use std.types.string.str;

use std.allocator;

use mirl.build.Failure;
use cfg: mirl.ir.cfg.failure;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.target.abi.call;
use mirl.target.abi.piece.Uncarried;
use mirl.target.machine;
use verify: mirl.verify.failure;

# why a pass or an analysis refused a function or a module
# ---
# alloc:      the allocator refused storage
# ir:         the module or a body refused an edit or a read
# cfg:        a graph edit or a copy was refused
# build:      the builder stopped
# reason:     the pass cannot do what it is for here, said in a few words. a pass
#             never falls back to a weaker form without refusing so
# unmachined: the pass needs the build's machine and the run carries none
# convention: a call, an entry or a return was not classified
# pieces:     an assignment is not carried in pieces of the ir
# condition:  a capability's condition was not read on the build's machine
pub tag Why: u8 {
    alloc:  allocator.Error;
    ir:     module.Error;
    cfg:    cfg.Error;
    build:  Failure;
    reason: str;
    unmachined;
    convention: call.Error;
    pieces:     Uncarried;
    condition:  machine.Error;
}

# a refusal of the allocator, as a pass's failure
pub fun lost(e: allocator.Error) err[Why] {
    ret err[Why].err{Why.alloc{e}};
}

# the outcome of an edit of a body, as a pass's failure
pub fun edit(r: err[module.Error]) err[Why] {
    if (sel r.err) { ret err[Why].err{Why.ir{r.err}}; }
    ret err[Why].ok{};
}

# what a walk of the schedule found wrong with it
# ---
# unnamed:      a row with no pass, or a pass with no name
# unscoped:     a pass with no visit or run to call
# renamed:      two different pass records with one name
# unregistered: a follow-up whose pass has no row of its own
# cycle:        a pass that follows itself through its follow-ups
# preserves:    a pass that preserves an analysis no registry row declares
# analysis:     a registry row that needs itself or a row after it, or a
#               registry too large for a set to hold
pub tag Problem: u8 {
    unnamed;
    unscoped;
    renamed;
    unregistered;
    cycle;
    preserves;
    analysis: u32;
}

# a defect of the schedule
# ---
# pass:    the name of the pass it was found at, nil when it has none
# problem: what is wrong
pub rec Defect {
    pass:    str;
    problem: Problem;
}

# a pass that refused, after the function or module was put back as it was
# ---
# pass:     the pass's name
# function: the function it refused, none for a pass over the whole module
# why:      why
pub rec Refusal {
    pass:     str;
    function: opt[Function];
    why:      Why;
}

# a module the verifier refused after a pass
# ---
# pass:  the name of the pass that left it so
# error: the verifier's answer
pub rec Unverified {
    pass:  str;
    error: verify.Error;
}

# why a run of the schedule failed
# ---
# schedule:   the schedule is malformed, and nothing ran
# input:      the module given breaks a rule of the verifier, and nothing ran
# foreign:    the machine given was opened for another target than the run's,
#             and nothing ran
# refused:    a pass refused
# unverified: the verifier refused the module after a pass
# alloc:      the allocator refused the run's own storage
pub tag Error: u8 {
    schedule: Defect;
    input:    verify.Failure;
    foreign;
    refused:    Refusal;
    unverified: Unverified;
    alloc:      allocator.Error;
}
