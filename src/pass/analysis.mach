# the analysis registry: the analyses a pass may ask of a function
#
# each analysis is a row, and its id is its position. an analysis reads only
# the ones it needs through the cache, so a new analysis is a new row that
# names what it needs, and the cache drops it whenever one of those drops.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.fail.keep;
use mirl.ir.cfg;
use mirl.ir.cfg.dominance;
use mirl.ir.cfg.dominance.Dominance;
use mirl.ir.cfg.graph;
use mirl.ir.cfg.graph.Graph;
use mirl.ir.cfg.loops;
use mirl.ir.cfg.loops.Loops;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.pass.analysis.live;
use mirl.pass.analysis.live.Liveness;
use mirl.pass.analysis.memory;
use mirl.pass.analysis.memory.Memory;
use mirl.pass.analysis.range;
use mirl.pass.analysis.range.Ranges;
use mirl.pass.cache;
use mirl.pass.cache.Analysis;
use mirl.pass.cache.Cache;
use mirl.pass.cache.Row;
use mirl.pass.cache.Set;
use mirl.pass.failure.Why;
use mirl.structure.region;
use mirl.structure.region.Structure;
use mirl.structure.shape;
use mirl.structure.shape.Flaw;
use mirl.structure.shape.Work;
use mirl.verify.failure.Missing;
use mirl.verify.failure.Trees;

# the graph view of the function's blocks, read from its edges alone
pub val GRAPH: Analysis = Analysis{index: 0};
# the dominator tree and frontiers over the graph
pub val DOMINANCE: Analysis = Analysis{index: 1};
# the natural loops over the graph and its dominator tree
pub val LOOPS: Analysis = Analysis{index: 2};

# the unsigned ranges of the function's integer values, read from its body,
# so any pass that changes an instruction drops it
pub val RANGES: Analysis = Analysis{index: 3};
# the memory dependence and alias of the function's accesses, read from its
# body and the target's data layout
pub val MEMORY: Analysis = Analysis{index: 4};
# the tree of regions a structured target's emitter reads, refused while the
# graph is not structured
pub val STRUCTURE: Analysis = Analysis{index: 5};
# the values live into and out of each block, read from the body and the
# graph with no register file, so any pass that changes an instruction drops it
pub val LIVENESS: Analysis = Analysis{index: 6};

# what a pass that adds, removes and redirects no edge and no block keeps
pub val SHAPE: Set = 0x3;
# the control flow analyses, which a pass that leaves every edge and block
# alone keeps whatever else it changes: the graph, dominance and loops
pub val FLOW: Set = 0x7;

val COUNT: usize      = 7;
val TABLE: [COUNT]Row = [COUNT]Row{
    Row{name: "graph", needs: 0x0, compute: graph_compute, release: graph_release},
    Row{name: "dominance", needs: 0x1, compute: dominance_compute, release: dominance_release},
    Row{name: "loops", needs: 0x3, compute: loops_compute, release: loops_release},
    Row{name: "ranges", needs: 0x6, compute: ranges_compute, release: ranges_release},
    Row{name: "memory", needs: 0xc, compute: memory_compute, release: memory_release},
    Row{name: "structure", needs: 0x7, compute: structure_compute, release: structure_release},
    Row{name: "liveness", needs: 0x3, compute: liveness_compute, release: liveness_release},
};

# the registry
pub fun rows() Slice[Row] {
    ret Slice[Row]{data: ?TABLE[0], size: COUNT};
}

# keep a computed analysis in storage of its own
fun hold[T](a: *allocator.Allocator, value: T, release: fun(*T) err[allocator.Error]) res[ptr, Why] {
    var v:    T                        = value;
    val room: res[*T, allocator.Error] = allocator.allocate[T](a, 1);
    if (sel room.err) {
        release(?v);
        ret res[ptr, Why].err{Why.alloc{room.err}};
    }
    room.ok[0] = v;
    ret res[ptr, Why].ok{room.ok::ptr};
}

fun give_back[T](a: *allocator.Allocator, p: ptr, release: fun(*T) err[allocator.Error]) err[allocator.Error] {
    val held:   *T                   = p::*T;
    var failed: err[allocator.Error] = release(held);
    keep(?failed, allocator.deallocate[T](a, held, 1));
    ret failed;
}

fun graph_compute(c: *Cache, f: Function) res[ptr, Why] {
    val g: res[Graph, module.Error] = cfg.graph_of(c.m, f);
    if (sel g.err) { ret res[ptr, Why].err{Why.ir{g.err}}; }
    ret hold[Graph](c.m.a, g.ok, graph.dnit);
}

fun graph_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Graph](a, p, graph.dnit);
}

fun dominance_compute(c: *Cache, f: Function) res[ptr, Why] {
    val g: res[*Graph, Why] = graph_of(c, f);
    if (sel g.err) { ret res[ptr, Why].err{g.err}; }
    val d: res[Dominance, allocator.Error] = dominance.compute(c.m.a, g.ok);
    if (sel d.err) { ret res[ptr, Why].err{Why.alloc{d.err}}; }
    ret hold[Dominance](c.m.a, d.ok, dominance.dnit);
}

fun dominance_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Dominance](a, p, dominance.dnit);
}

fun loops_compute(c: *Cache, f: Function) res[ptr, Why] {
    val g: res[*Graph, Why] = graph_of(c, f);
    if (sel g.err) { ret res[ptr, Why].err{g.err}; }
    val d: res[*Dominance, Why] = dominance_of(c, f);
    if (sel d.err) { ret res[ptr, Why].err{d.err}; }
    val l: res[Loops, allocator.Error] = loops.compute(c.m.a, g.ok, d.ok);
    if (sel l.err) { ret res[ptr, Why].err{Why.alloc{l.err}}; }
    ret hold[Loops](c.m.a, l.ok, loops.dnit);
}

fun loops_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Loops](a, p, loops.dnit);
}

fun ranges_compute(c: *Cache, f: Function) res[ptr, Why] {
    val g: res[*Graph, Why] = graph_of(c, f);
    if (sel g.err) { ret res[ptr, Why].err{g.err}; }
    val d: res[*Dominance, Why] = dominance_of(c, f);
    if (sel d.err) { ret res[ptr, Why].err{d.err}; }
    val l: res[*Loops, Why] = loops_of(c, f);
    if (sel l.err) { ret res[ptr, Why].err{l.err}; }
    ret hold[Ranges](c.m.a, range.init(c.m, f, g.ok, d.ok, l.ok), no_release[Ranges]);
}

fun ranges_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Ranges](a, p, no_release[Ranges]);
}

fun memory_compute(c: *Cache, f: Function) res[ptr, Why] {
    val l: res[*Loops, Why] = loops_of(c, f);
    if (sel l.err) { ret res[ptr, Why].err{l.err}; }
    val r: res[*Ranges, Why] = ranges_of(c, f);
    if (sel r.err) { ret res[ptr, Why].err{r.err}; }
    ret hold[Memory](c.m.a, memory.init(c.m, c.t, f, l.ok, r.ok), no_release[Memory]);
}

fun memory_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Memory](a, p, no_release[Memory]);
}

fun structure_compute(c: *Cache, f: Function) res[ptr, Why] {
    val g: res[*Graph, Why] = graph_of(c, f);
    if (sel g.err) { ret res[ptr, Why].err{g.err}; }
    val d: res[*Dominance, Why] = dominance_of(c, f);
    if (sel d.err) { ret res[ptr, Why].err{d.err}; }
    val l: res[*Loops, Why] = loops_of(c, f);
    if (sel l.err) { ret res[ptr, Why].err{l.err}; }
    var w: Work      = shape.init(c.m.a);
    var s: Structure = region.init(c.m.a);
    fin { shape.dnit(?w); }
    val found: res[opt[Flaw], allocator.Error] = shape.find(c.m.a, g.ok, d.ok, l.ok, ?w, ?s);
    if (sel found.err) {
        region.dnit(?s);
        ret res[ptr, Why].err{Why.alloc{found.err}};
    }
    if (sel found.ok.some) {
        region.dnit(?s);
        ret res[ptr, Why].err{Why.reason{shape.why(found.ok.some)}};
    }
    ret hold[Structure](c.m.a, s, region.dnit);
}

fun structure_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Structure](a, p, region.dnit);
}

fun liveness_compute(c: *Cache, f: Function) res[ptr, Why] {
    val b: res[*Body, module.Error] = module.body(c.m, f);
    if (sel b.err) { ret res[ptr, Why].err{Why.ir{b.err}}; }
    val g: res[*Graph, Why] = graph_of(c, f);
    if (sel g.err) { ret res[ptr, Why].err{g.err}; }
    val d: res[*Dominance, Why] = dominance_of(c, f);
    if (sel d.err) { ret res[ptr, Why].err{d.err}; }
    val l: res[Liveness, allocator.Error] = live.compute(c.m.a, b.ok, g.ok, d.ok);
    if (sel l.err) { ret res[ptr, Why].err{Why.alloc{l.err}}; }
    ret hold[Liveness](c.m.a, l.ok, live.dnit);
}

fun liveness_release(a: *allocator.Allocator, p: ptr) err[allocator.Error] {
    ret give_back[Liveness](a, p, live.dnit);
}

# an analysis that owns nothing but its record
fun no_release[T](v: *T) err[allocator.Error] {
    ret err[allocator.Error].ok{};
}

# the graph of a function, valid until the cache drops it
pub fun graph_of(c: *Cache, f: Function) res[*Graph, Why] {
    val got: res[ptr, Why] = cache.get(c, f, GRAPH);
    if (sel got.err) { ret res[*Graph, Why].err{got.err}; }
    ret res[*Graph, Why].ok{got.ok::*Graph};
}

# the dominance of a function, valid until the cache drops it
pub fun dominance_of(c: *Cache, f: Function) res[*Dominance, Why] {
    val got: res[ptr, Why] = cache.get(c, f, DOMINANCE);
    if (sel got.err) { ret res[*Dominance, Why].err{got.err}; }
    ret res[*Dominance, Why].ok{got.ok::*Dominance};
}

# the loops of a function, valid until the cache drops it
pub fun loops_of(c: *Cache, f: Function) res[*Loops, Why] {
    val got: res[ptr, Why] = cache.get(c, f, LOOPS);
    if (sel got.err) { ret res[*Loops, Why].err{got.err}; }
    ret res[*Loops, Why].ok{got.ok::*Loops};
}

# the value ranges of a function, valid until the cache drops them
pub fun ranges_of(c: *Cache, f: Function) res[*Ranges, Why] {
    val got: res[ptr, Why] = cache.get(c, f, RANGES);
    if (sel got.err) { ret res[*Ranges, Why].err{got.err}; }
    ret res[*Ranges, Why].ok{got.ok::*Ranges};
}

# the memory analysis of a function, valid until the cache drops it
pub fun memory_of(c: *Cache, f: Function) res[*Memory, Why] {
    val got: res[ptr, Why] = cache.get(c, f, MEMORY);
    if (sel got.err) { ret res[*Memory, Why].err{got.err}; }
    ret res[*Memory, Why].ok{got.ok::*Memory};
}

# the structure of a function, valid until the cache drops it, or why its
# graph is not structured
pub fun structure_of(c: *Cache, f: Function) res[*Structure, Why] {
    val got: res[ptr, Why] = cache.get(c, f, STRUCTURE);
    if (sel got.err) { ret res[*Structure, Why].err{got.err}; }
    ret res[*Structure, Why].ok{got.ok::*Structure};
}

# the liveness of a function's values, valid until the cache drops it
pub fun liveness_of(c: *Cache, f: Function) res[*Liveness, Why] {
    val got: res[ptr, Why] = cache.get(c, f, LIVENESS);
    if (sel got.err) { ret res[*Liveness, Why].err{got.err}; }
    ret res[*Liveness, Why].ok{got.ok::*Liveness};
}

fun tree_of(holder: ptr, f: Function) res[*Structure, Missing] {
    val s: res[*Structure, Why] = structure_of(holder::*Cache, f);
    if (sel s.err) {
        if (sel s.err.alloc)  { ret res[*Structure, Missing].err{Missing.alloc{s.err.alloc}}; }
        if (sel s.err.reason) { ret res[*Structure, Missing].err{Missing.reason{s.err.reason}}; }
        ret res[*Structure, Missing].err{Missing.reason{"the structure analysis could not read the function"}};
    }
    ret res[*Structure, Missing].ok{s.ok};
}

# the region trees a cache's structure analysis holds, computing any it has
# dropped, for the verifier past legalisation
pub fun trees(c: *Cache) Trees {
    ret Trees{holder: c::ptr, of: tree_of};
}
