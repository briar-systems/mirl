# the pass record: what every pass declares of itself, once, in its own module
#
# a function pass is a visit to one function that answers whether it changed
# it, and the driver walks the module for it. a module pass runs over the
# whole module. a pass reads the target's declarations and never its name.
#
# a pass is one of two kinds by its type. a `Pass` reads the target and the
# selection, if a family opened one, so any row may run it. a `Lowering`
# reads the build its family opened as well, so only a family's rows run it
# and it is never given a build that may be absent.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.function.Node;
use mirl.ir.function.in_constant_time;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.cache.Cache;
use mirl.pass.cache.Set;
use mirl.pass.refusal;
use mirl.pass.relaxation;
use mirl.pass.relaxation.Relaxations;
use mirl.target.basis.Basis;
use mirl.target.build.Build;
use mirl.target.record.Target;
use mirl.target.warning.Warning;

# whether a pass optimises or legalises
# ---
# optimise: it improves the code, and runs when the build optimises or names it on, never when it names it off
# legalise: it rewrites what the target cannot do, and runs whatever the build's setting
pub tag Kind: u8 {
    optimise;
    legalise;
}

# whether a pass keeps a function's constant-time requirement
# ---
# breaks: it may branch on a value or otherwise change how long the code
#         takes, so every function that requires constant time is skipped
# keeps:  it never changes how long the code takes
pub tag Time: u8 {
    breaks;
    keeps;
}

# what a run of a pass reads
# ---
# m:        the module
# t:        the target, for its declarations and data layout
# basis:    the selection the run reads, none when no family opened a build:
#           in a function visit the visited function's, the build's widened
#           by the extensions it names (`mirl.target.widening`), and in a
#           module run the build's. every extension condition is read against it
# build:    the build's selection, which every function a pass adds stands on,
#           as a helper it delivers, so what is made for one reads it
# cache:    the analyses of the module's functions, of which the pass being run reads only those it needs
# time:     whether the pass being run keeps a constant-time requirement
# floats:   the float relaxations the build permits, none for exact semantics
# warnings: the list a pass appends the warnings it gives to
pub rec Context {
    m:        *Module;
    t:        *Target;
    basis:    opt[*Basis];
    build:    opt[*Basis];
    cache:    *Cache;
    time:     Time;
    floats:   Relaxations;
    warnings: *vector.Vector[Warning];
}

# the one function a visit is given
# ---
# context: the run
# f:       the function
pub rec Unit {
    context: *Context;
    f:       Function;
}

# the functions a run over the whole module changed: one mark per function the module held when the run
# began, which the run sets for each function whose body, signature, linkage or any fact a pass or the
# verifier reads of it the run changed, or whose meaning changed with a constant or global it reads. a function
# the run added is changed whether or not it is marked
# ---
# marks: the marks, all clear when the run begins
pub rec Changed {
    marks: Slice[bool];
}

# mark function `f` as one the run changed
pub fun changed(c: *Changed, f: Function) {
    if (f::usize < c.marks.size) { c.marks.data[f] = true; }
}

# a visit to one function, true when it changed it
pub def Visit: fun(*Unit) res[bool, refusal.Error];

# a run over the whole module, true when it changed it, marking every function it changed
pub def Run: fun(*Context, *Changed) res[bool, refusal.Error];

# a lowering's visit to one function, given the build, true when it changed it
pub def Lower: fun(*Unit, *Build) res[bool, refusal.Error];

# a lowering's run over the whole module, given the build, true when it changed it, marking every function it
# changed
pub def LowerAll: fun(*Context, *Build, *Changed) res[bool, refusal.Error];

# what a pass's choice reads: the target's declarations, the build's
# selection, which every condition is read against, and the float
# relaxations the build permits
# ---
# t:      the target
# basis:  the build's selection, none when no family opened a build
# floats: the float relaxations the build permits, none for exact semantics
pub rec Ground {
    t:      *Target;
    basis:  opt[*Basis];
    floats: Relaxations;
}

# whether a pass applies to a build, from the target's declarations and the
# build's selection
pub def Applies: fun(*Ground) bool;

# what a pass works on
# ---
# unstated: nothing, a defect of the record
# function: one function at a time, by this visit
# module:   the whole module, by this run
pub tag Scope: u8 {
    unstated;
    function: Visit;
    module:   Run;
}

# what a lowering works on, each given the build
# ---
# unstated: nothing, a defect of the record
# function: one function at a time, by this visit
# module:   the whole module, by this run
pub tag Lowered: u8 {
    unstated;
    function: Lower;
    module:   LowerAll;
}

# one pass of either kind, the kind its scope's type
# ---
# name:      its name, unique among the passes of a schedule
# kind:      whether it optimises or legalises
# scope:     what it works on, a `Scope` or a `Lowered`
# needs:     the analyses it reads, which the schedule closes over the rows each needs. the cache refuses it
#            any other
# preserves: the analyses every run of it leaves valid, whatever it changed
# time:      whether it keeps a constant-time requirement
# applies:   the builds it applies to, from the target's declarations and
#            the build's selection, nil for every build. a legalisation
#            applies where the build lacks what it rewrites
pub rec Record[S] {
    name:      str;
    kind:      Kind;
    scope:     S;
    needs:     Set;
    preserves: Set;
    time:      Time;
    applies:   Applies;
}

# a pass that reads the target and the selection alone, which a neutral row
# and a family's row may both run
pub def Pass: Record[Scope];

# a pass that reads the build, which only a family's rows run
pub def Lowering: Record[Lowered];

# whether a pass applies to a build on this ground
pub fun applies[S](p: *Record[S], g: *Ground) bool {
    ret p.applies == nil || p.applies(g);
}

# the ground a build with no selection stands on, as a target no family serves
pub fun bare(t: *Target) Ground {
    ret Ground{t: t, basis: opt[*Basis].none{}, floats: relaxation.EXACT};
}

# whether the pass of a run may rewrite a function: one with a body that
# does not require constant time when the pass may break it. a module pass
# asks this of every function it rewrites
pub fun touches(c: *Context, f: Function) bool {
    if (f::usize >= c.m.functions.len) { ret false; }
    val n: *Node = ?c.m.functions.data[f];
    if (n.body.blocks.len == 0) { ret false; }
    ret !(in_constant_time(n.data.constant_time) && sel c.time.breaks);
}
