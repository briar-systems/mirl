# the pass record: what every pass declares of itself, once, in its own module
#
# a function pass is a visit to one function that answers whether it changed
# it, and the driver walks the module for it. a module pass runs over the
# whole module. a pass reads the target's declarations and never its name.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use mirl.ir.function.Node;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.pass.cache.Cache;
use mirl.pass.cache.Set;
use mirl.pass.failure.Why;
use mirl.target.Target;
use mirl.target.machine.Machine;

# whether a pass optimises or legalises
# ---
# optimise: it improves the code, and runs only at the levels its row names
# legalise: it rewrites what the target cannot do, and runs at every level
pub tag Kind: u8 {
    optimise;
    legalise;
}

# whether a pass keeps a function's constant-time requirement
# ---
# breaks: it may branch on a value or otherwise change how long the code
#         takes, so every function that requires constant time is skipped
# keeps:  it never changes how long the code takes
pub tag Time: u8 {
    breaks;
    keeps;
}

# what a run of a pass reads
# ---
# m:     the module
# t:     the target, for its declarations and data layout
# mc:    the build's one machine for the target, none when the build has none.
#        a pass reads the machine it is given and never opens one
# cache: the analyses of the module's functions
# pass:  the pass being run
pub rec Context {
    m:     *Module;
    t:     *Target;
    mc:    opt[*Machine];
    cache: *Cache;
    pass:  *Pass;
}

# the one function a visit is given
# ---
# context: the run
# f:       the function
pub rec Unit {
    context: *Context;
    f:       Function;
}

# a visit to one function, true when it changed it
pub def Visit: fun(*Unit) res[bool, Why];

# a run over the whole module, true when it changed it
pub def Run: fun(*Context) res[bool, Why];

# whether a pass applies to a target, from its declarations alone
pub def Applies: fun(*Target) bool;

# whether a pass visits a function the driver would otherwise give it
pub def Filter: fun(*Unit) bool;

# what a pass works on
# ---
# unstated: nothing, a defect of the record
# function: one function at a time, by this visit
# module:   the whole module, by this run
pub tag Scope: u8 {
    unstated;
    function: Visit;
    module:   Run;
}

# one pass
# ---
# name:      its name, unique among the passes of a schedule
# kind:      whether it optimises or legalises
# scope:     what it works on
# preserves: the analyses every run of it leaves valid, whatever it changed
# time:      whether it keeps a constant-time requirement
# skips:     the functions it leaves alone beside those the driver skips, nil
#            for none
# applies:   the targets it applies to, from their declarations, nil for every
#            target. a legalisation applies where the target lacks what it
#            rewrites
pub rec Pass {
    name:      str;
    kind:      Kind;
    scope:     Scope;
    preserves: Set;
    time:      Time;
    skips:     Filter;
    applies:   Applies;
}

# whether a pass applies to a target with these declarations
pub fun applies(p: *Pass, t: *Target) bool {
    ret p.applies == nil || p.applies(t);
}

# whether the pass of a run may rewrite a function: one with a body, that
# does not require constant time when the pass may break it, and that the
# pass does not skip. a module pass asks this of every function it rewrites
pub fun touches(c: *Context, f: Function) bool {
    if (f.index::usize >= c.m.functions.len) { ret false; }
    val n: *Node = ?c.m.functions.data[f.index];
    if (n.body.blocks.len == 0)                         { ret false; }
    if (n.data.constant_time && sel c.pass.time.breaks) { ret false; }
    if (c.pass.skips == nil)                            { ret true; }
    var u: Unit = Unit{context: c, f: f};
    ret c.pass.skips(?u);
}
