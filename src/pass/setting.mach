# whether a build optimises, and the passes it turns on or off one by one
#
# a build optimises or does not, and each optimisation pass follows that unless the build names the pass, by the
# name its record gives it, on or off. a legalisation runs whatever the setting says. a pass is named by its place
# in the list of every optimisation pass (`mirl.pass.rows.optimisations`), so a setting is a few words that a build's hash
# reads and a copy carries whole

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.collections.slice.Slice;

use mirl.pass.record.Pass;

# how many optimisation passes a setting can name, the bits of a word
pub val MOST: usize = 64;

# whether a build optimises and the passes it names
# ---
# on:     whether it optimises, which every pass it does not name follows
# named:  bit i set when the build names optimisation pass i
# chosen: bit i set when the build turns pass i on, read only where `named` holds bit i
pub rec Optimise {
    on:     bool;
    named:  u64;
    chosen: u64;
}

# a build that does not optimise and names no pass
pub val OFF: Optimise = Optimise{on: false, named: 0, chosen: 0};

# a build that optimises and names no pass
pub val ON: Optimise = Optimise{on: true, named: 0, chosen: 0};

# the place in `listed`, the list of every optimisation pass, of the one named `name`, none for a name no pass
# has
pub fun index_of(listed: Slice[*Pass], name: str) opt[u32] {
    var i: usize = 0;
    for (i < listed.size) {
        if (str_equals(listed.data[i].name, name)) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the place in `listed`, the list of every optimisation pass, of the pass `p`, none for a pass it does not hold
pub fun place_of(listed: Slice[*Pass], p: *Pass) opt[u32] {
    var i: usize = 0;
    for (i < listed.size) {
        if (listed.data[i] == p) { ret opt[u32].some{i::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the setting `o` with optimisation pass `i` turned on or off, the last word on it
pub fun chose(o: Optimise, i: u32, on: bool) Optimise {
    var out: Optimise = o;
    val bit: u64      = 1u64 << i::u64;
    out.named = out.named | bit;
    if (on) { out.chosen = out.chosen | bit; }
    or      { out.chosen = out.chosen & ~bit; }
    ret out;
}

# whether optimisation pass `i` runs under `o`: as the build names it, or as the build optimises
pub fun runs(o: *Optimise, i: u32) bool {
    val bit: u64 = 1u64 << i::u64;
    if ((o.named & bit) != 0) { ret (o.chosen & bit) != 0; }
    ret o.on;
}
