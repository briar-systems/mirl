# the float relaxations a build permits: the departures from exact float
# semantics the optimiser and selection may take, as one stated set
#
# every member is off unless the build names it, and a build that names none
# keeps exact semantics. a member is one row of the table below, so a
# relaxation is added as data, and a pass or a selection rule that takes a
# liberty reads its member here and never a name. the set is independent of
# the nan rule a format states: holding a member changes no nan fact. the
# members are mach's `relax` set (mach doc/language/manifest.md, "float
# reassociation"), named as mach's manifest names them.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.collections.slice.Slice;

# one relaxation, by its bit in a set
pub rec Member {
    bit: u32;
}

# floating-point `+` and `*` may be treated as associative, so a sum, a
# product or a dot product reduction may be regrouped. it licenses nothing
# else: no reciprocal for a division, no assumption that an operand is finite
# or no nan, no contraction into a fused multiply-add and no flush of a
# subnormal
pub val FLOAT_REASSOC: Member = Member{bit: 0};

# a set of relaxations, one bit per member
pub rec Relaxations {
    bits: u32;
}

# the set of a build that permits no departure, the default
pub val EXACT: Relaxations = Relaxations{bits: 0};

# one member a set may name
# ---
# member: the member
# name:   as a build names it
rec Row {
    member: Member;
    name:   str;
}

val ROWS: [1]Row = [1]Row{
    Row{member: FLOAT_REASSOC, name: "float-reassoc"},
};

# whether a set holds a member
pub fun holds(s: Relaxations, m: Member) bool {
    ret (s.bits & (1u32 << m.bit)) != 0;
}

# a set with a member added
pub fun add(s: Relaxations, m: Member) Relaxations {
    ret Relaxations{bits: s.bits | (1u32 << m.bit)};
}

# the member a name names, none for a name no row declares
pub fun named(name: str) opt[Member] {
    var i: usize = 0;
    for (i < $length_of(ROWS)) {
        if (str_equals(ROWS[i].name, name)) { ret opt[Member].some{ROWS[i].member}; }
        i = i + 1;
    }
    ret opt[Member].none{};
}

# how many members a set may name
pub fun count() usize {
    ret $length_of(ROWS);
}

# the name of the member at a position of the table, in declaration order
pub fun name_at(i: usize) str {
    ret ROWS[i].name;
}

# why a list of names gives no set
# ---
# unknown: a name no row declares
# twice:   a name the list gives more than once
pub tag Refused: u8 {
    unknown: str;
    twice:   str;
}

# the set a list of names states, each named once
# ---
# names: the names, as a build gives them
# ret:   the set, or the first name refused and why
pub fun of(names: Slice[str]) res[Relaxations, Refused] {
    var s: Relaxations = EXACT;
    var i: usize       = 0;
    for (i < names.size) {
        val m: opt[Member] = named(names.data[i]);
        if (sel m.none)       { ret res[Relaxations, Refused].err{Refused.unknown{names.data[i]}}; }
        if (holds(s, m.some)) { ret res[Relaxations, Refused].err{Refused.twice{names.data[i]}}; }
        s = add(s, m.some);
        i = i + 1;
    }
    ret res[Relaxations, Refused].ok{s};
}
