# the choice of a pipeline: the rows of a schedule a build and a level run
#
# the choice reads the target's declarations and the build's selection and
# nothing else of either, so two builds that declare and select the same run
# the same pipeline.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.pass.record;
use mirl.pass.record.Ground;
use mirl.pass.record.Record;
use mirl.pass.schedule.Level;
use mirl.pass.schedule.Levels;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Step;
use mirl.pass.schedule.at;

# whether a pass of either kind runs for a build on this ground at a level: a
# legalisation at every level and an optimisation at its row's, each only
# where it applies
fun admitted[S](p: *Record[S], levels: Levels, g: *Ground, level: Level) bool {
    if (sel p.kind.optimise && !at(levels, level)) { ret false; }
    ret record.applies[S](p, g);
}

# whether a neutral row runs for a build on this ground at a level
pub fun selected(row: *Row, g: *Ground, level: Level) bool {
    ret admitted[Scope](row.pass, row.levels, g, level);
}

# whether a family's row runs for a build on this ground at a level
pub fun stepped(step: Step, g: *Ground, level: Level) bool {
    if (sel step.row)      { ret selected(step.row, g, level); }
    if (sel step.lowering) { ret admitted[record.Lowered](step.lowering.pass, step.lowering.levels, g, level); }
    ret false;
}

# one row a run takes, of either table
pub tag Taken: u8 {
    row:  *Row;
    step: Step;
}

# whether a row a run takes legalises
pub fun legalises(t: Taken) bool {
    if (sel t.row) { ret sel t.row.pass.kind.legalise; }
    val s: Step = t.step;
    if (sel s.row)      { ret sel s.row.pass.kind.legalise; }
    if (sel s.lowering) { ret sel s.lowering.pass.kind.legalise; }
    ret false;
}

# the rows a build on this ground runs at a level, in order: the neutral
# rows, then the family's rows after them
# ---
# a:     the allocator the list takes
# rows:  the neutral rows
# steps: the family's rows, none for a neutral run
# g:     the target's declarations and the build's selection
# level: the level
# ret:   the rows, or the allocator's refusal
pub fun choose(a: *allocator.Allocator, rows: Slice[Row], steps: Slice[Step], g: *Ground, level: Level) res[vector.Vector[Taken], allocator.Error] {
    var out: vector.Vector[Taken] = vector.init[Taken](a);
    var i:   usize                = 0;
    for (i < rows.size) {
        if (selected(?rows.data[i], g, level)) {
            val pushed: res[usize, allocator.Error] = vector.push[Taken](?out, Taken.row{?rows.data[i]});
            if (sel pushed.err) {
                vector.dnit[Taken](?out);
                ret res[vector.Vector[Taken], allocator.Error].err{pushed.err};
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < steps.size) {
        if (stepped(steps.data[i], g, level)) {
            val pushed: res[usize, allocator.Error] = vector.push[Taken](?out, Taken.step{steps.data[i]});
            if (sel pushed.err) {
                vector.dnit[Taken](?out);
                ret res[vector.Vector[Taken], allocator.Error].err{pushed.err};
            }
        }
        i = i + 1;
    }
    ret res[vector.Vector[Taken], allocator.Error].ok{out};
}
