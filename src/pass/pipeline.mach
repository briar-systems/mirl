# the choice of a pipeline: the rows of a schedule a target and a level run
#
# the choice reads the target's declared capabilities and nothing else of it,
# so two targets that declare the same run the same pipeline.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.pass.failure.Why;
use mirl.pass.record;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Unit;
use mirl.pass.schedule.FROM_1;
use mirl.pass.schedule.Level;
use mirl.pass.schedule.NEVER;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.at;
use targets: mirl.target;
use mirl.target.Capabilities;
use mirl.target.Target;
use VectorUnit: mirl.target.Unit;
use mirl.target.Vectors;

# whether a row runs for a target with these declarations at a level: a
# legalisation at every level and an optimisation at its row's, each only
# where its pass applies
pub fun selected(row: *Row, caps: *Capabilities, level: Level) bool {
    if (sel row.pass.kind.optimise && !at(row.levels, level)) { ret false; }
    ret record.applies(row.pass, caps);
}

# the rows of a schedule a target with these declarations runs at a level,
# in order
# ---
# a:     the allocator the list takes
# table: the schedule
# caps:  the target's declarations
# level: the level
# ret:   the rows, or the allocator's refusal
pub fun choose(a: *allocator.Allocator, table: Slice[Row], caps: *Capabilities, level: Level) res[vector.Vector[*Row], allocator.Error] {
    var out: vector.Vector[*Row] = vector.init[*Row](a);
    var i:   usize               = 0;
    for (i < table.size) {
        if (selected(?table.data[i], caps, level)) {
            val pushed: res[usize, allocator.Error] = vector.push[*Row](?out, ?table.data[i]);
            if (sel pushed.err) {
                vector.dnit[*Row](?out);
                ret res[vector.Vector[*Row], allocator.Error].err{pushed.err};
            }
        }
        i = i + 1;
    }
    ret res[vector.Vector[*Row], allocator.Error].ok{out};
}

#[testing]
fun unchanged(u: *Unit) res[bool, Why] {
    ret res[bool, Why].ok{false};
}

#[testing]
fun lacks_vectors(caps: *Capabilities) bool {
    ret sel caps.vectors.none;
}

#[testing]
val SCALARISE: Pass   = Pass{name: "scalarise", kind: Kind.legalise{}, scope: Scope.function{unchanged}, applies: lacks_vectors};
#[testing]
val FOLD:      Pass   = Pass{name: "fold", kind: Kind.optimise{}, scope: Scope.function{unchanged}};
#[testing]
val TABLE:     [2]Row = [2]Row{Row{pass: ?SCALARISE, levels: NEVER}, Row{pass: ?FOLD, levels: FROM_1}};

# the passes chosen, as a bit per row of TABLE
#[testing]
fun plan(caps: *Capabilities, level: Level) u8 {
    var a: allocator.Allocator;
    page.make(?a);
    val got: res[vector.Vector[*Row], allocator.Error] = choose(?a, Slice[Row]{data: ?TABLE[0], size: 2}, caps, level);
    if (sel got.err) { ret 0xff; }
    var rows: vector.Vector[*Row] = got.ok;
    fin { vector.dnit[*Row](?rows); }
    var bits: u8    = 0;
    var i:    usize = 0;
    for (i < rows.len) {
        if (rows.data[i].pass == ?SCALARISE) { bits = bits | 1; }
        if (rows.data[i].pass == ?FOLD)      { bits = bits | 2; }
        i = i + 1;
    }
    ret bits;
}

#[testing]
#[embed("../pass.mach")]
val SURFACE:  [_]u8;
#[testing]
#[embed("analysis.mach")]
val ANALYSIS: [_]u8;
#[testing]
#[embed("cache.mach")]
val CACHE:    [_]u8;
#[testing]
#[embed("driver.mach")]
val DRIVER:   [_]u8;
#[testing]
#[embed("failure.mach")]
val FAILURE:  [_]u8;
#[testing]
#[embed("pipeline.mach")]
val PIPELINE: [_]u8;
#[testing]
#[embed("record.mach")]
val RECORD:   [_]u8;
#[testing]
#[embed("rows.mach")]
val ROWS:     [_]u8;
#[testing]
#[embed("schedule.mach")]
val SCHEDULE: [_]u8;

# whether a source holds a followed directly by b, the two written apart here
# so the needles never match themselves
#[testing]
fun mentions(src: *u8, size: usize, a: str, b: str) bool {
    val la: usize = str_len(a);
    val lb: usize = str_len(b);
    var i:  usize = 0;
    for (i + la + lb <= size) {
        var k:    usize = 0;
        var same: bool  = true;
        for (same && k < la + lb) {
            var want: u8 = 0;
            if (k < la)             { want = a[k]; }
            or                      { want = b[k - la]; }
            if (src[i + k] != want) { same = false; }
            k = k + 1;
        }
        if (same) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a source reads a target's identity: its name, architecture or
# system, a target row by name, or the module's target name
#[testing]
fun identity(src: *u8, size: usize) bool {
    ret mentions(src, size, ".", "arch") || mentions(src, size, ".", "system") || mentions(src, size, "by_", "name") || mentions(src, size, "t.", "name") || mentions(src, size, "m.", "target") || mentions(src, size, "module.", "target(") || mentions(src, size, "verify.", "check(") || mentions(src, size, "RV", "64");
}

#[testing]
fun no_vectors(t: *Target) bool {
    ret sel t.caps.vectors.none;
}

test pipeline__chosen_from_declarations {
    val row: opt[*Target] = targets.first(no_vectors);
    if (sel row.none) { ret 1; }
    val named: *Target = row.some;
    var bare:  Target;
    bare.caps = named.caps;
    if (plan(?named.caps, 0) != 1 || plan(?bare.caps, 0) != 1) { ret 2; }
    if (plan(?named.caps, 2) != 3 || plan(?bare.caps, 2) != 3) { ret 3; }
    var vectored: Capabilities = named.caps;
    vectored.vectors = Vectors.unit{VectorUnit{}};
    if (plan(?vectored, 0) != 0 || plan(?vectored, 2) != 2) { ret 4; }

    if (identity(?SURFACE[0], $length_of(SURFACE)))   { ret 5; }
    if (identity(?ANALYSIS[0], $length_of(ANALYSIS))) { ret 5; }
    if (identity(?CACHE[0], $length_of(CACHE)))       { ret 5; }
    if (identity(?DRIVER[0], $length_of(DRIVER)))     { ret 5; }
    if (identity(?FAILURE[0], $length_of(FAILURE)))   { ret 5; }
    if (identity(?PIPELINE[0], $length_of(PIPELINE))) { ret 5; }
    if (identity(?RECORD[0], $length_of(RECORD)))     { ret 5; }
    if (identity(?ROWS[0], $length_of(ROWS)))         { ret 5; }
    if (identity(?SCHEDULE[0], $length_of(SCHEDULE))) { ret 5; }
    # the scan finds what is there
    if (!mentions(?PIPELINE[0], $length_of(PIPELINE), "lacks_", "vectors")) { ret 6; }
    ret 0;
}
