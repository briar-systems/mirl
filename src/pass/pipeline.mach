# the choice of a pipeline: the rows of a schedule a build and its setting run
#
# the choice reads the target's declarations, the build's selection and its setting, and
# nothing else of either, so two builds that declare and select the same run
# the same pipeline.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.pass.record;
use mirl.pass.record.Ground;
use mirl.pass.record.Scope;
use mirl.pass.rows;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Step;
use mirl.pass.setting;
use mirl.pass.setting.Optimise;

# whether a neutral row runs for a build on this ground under its setting: a legalisation always and an
# optimisation as the setting says, each only where it applies. an optimisation the list of them does not hold
# never runs, which the schedule's check refuses before any row is chosen
pub fun selected(row: *Row, g: *Ground, o: *Optimise) bool {
    if (sel row.pass.kind.optimise) {
        val opt_place: opt[u32] = setting.place_of(rows.optimisations(), row.pass);
        if (sel opt_place.none)               { ret false; }
        if (!setting.runs(o, opt_place.some)) { ret false; }
    }
    ret record.applies[Scope](row.pass, g);
}

# whether a family's row runs for a build on this ground under its setting. a lowering is never an
# optimisation, which the schedule's check holds
pub fun stepped(step: Step, g: *Ground, o: *Optimise) bool {
    if (sel step.row)      { ret selected(step.row, g, o); }
    if (sel step.lowering) { ret !(sel step.lowering.pass.kind.optimise) && record.applies[record.Lowered](step.lowering.pass, g); }
    ret false;
}

# one row a run takes, of either table
pub tag Taken: u8 {
    row:  *Row;
    step: Step;
}

# whether a row a run takes legalises
pub fun legalises(t: Taken) bool {
    if (sel t.row) { ret sel t.row.pass.kind.legalise; }
    val s: Step = t.step;
    if (sel s.row)      { ret sel s.row.pass.kind.legalise; }
    if (sel s.lowering) { ret sel s.lowering.pass.kind.legalise; }
    ret false;
}

# the rows a build on this ground runs under its setting, in order: the neutral
# rows, then the family's rows after them
# ---
# a:     the allocator the list takes
# rows:  the neutral rows
# steps: the family's rows, none for a neutral run
# g:     the target's declarations and the build's selection
# o:     whether the build optimises, and the passes it names
# ret:   the rows, or the allocator's refusal
pub fun choose(a: *allocator.Allocator, rows: Slice[Row], steps: Slice[Step], g: *Ground, o: *Optimise) res[vector.Vector[Taken], allocator.Error] {
    var out: vector.Vector[Taken] = vector.init[Taken](a);
    var i:   usize                = 0;
    for (i < rows.size) {
        if (selected(?rows.data[i], g, o)) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Taken](?out, Taken.row{?rows.data[i]});
            if (sel res_pushed.err) {
                vector.dnit[Taken](?out);
                ret res[vector.Vector[Taken], allocator.Error].err{res_pushed.err};
            }
        }
        i = i + 1;
    }
    i = 0;
    for (i < steps.size) {
        if (stepped(steps.data[i], g, o)) {
            val res_pushed: res[usize, allocator.Error] = vector.push[Taken](?out, Taken.step{steps.data[i]});
            if (sel res_pushed.err) {
                vector.dnit[Taken](?out);
                ret res[vector.Vector[Taken], allocator.Error].err{res_pushed.err};
            }
        }
        i = i + 1;
    }
    ret res[vector.Vector[Taken], allocator.Error].ok{out};
}
