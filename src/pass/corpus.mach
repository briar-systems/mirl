# the schedule over the corpus: every IR text file under test/ir goes through
# the whole schedule at every level with the verifier after every pass
#
# the walk takes each file as it finds it, so a file added later and a pass
# added later are covered with no change here. the file names its target, and
# this reads that declared fact to pick the row the schedule runs for.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.filesystem;
use std.print;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.equal;
use mirl.ir.text.parse;
use mirl.ir.text.printer;
use mirl.pass.driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.failure.Why;
use mirl.pass.schedule.Level;
use targets: mirl.target;
use mirl.target.Target;
use mirl.verify.table;

# the highest optimisation level
#[testing]
pub val TOP: Level = 3;

# say which pass and which rule or reason a run failed at
#[testing]
pub fun report(path: str, level: Level, e: Error) {
    if (sel e.refused) {
        val why: Why = e.refused.why;
        if (sel why.reason)     { print.eprintlnf("{}: level {}: pass {} refused: {}", path, level::u32, e.refused.pass, why.reason); }
        or (sel why.machine)    { print.eprintlnf("{}: level {}: pass {} refused: the target's machine was not made", path, level::u32, e.refused.pass); }
        or (sel why.convention) { print.eprintlnf("{}: level {}: pass {} refused: a call was not classified", path, level::u32, e.refused.pass); }
        or (sel why.pieces)     { print.eprintlnf("{}: level {}: pass {} refused: an assignment is not carried in pieces", path, level::u32, e.refused.pass); }
        or (sel why.ir)         { print.eprintlnf("{}: level {}: pass {} refused: an edit of the ir", path, level::u32, e.refused.pass); }
        or (sel why.build)      { print.eprintlnf("{}: level {}: pass {} refused: the builder stopped", path, level::u32, e.refused.pass); }
        or                      { print.eprintlnf("{}: level {}: pass {} refused", path, level::u32, e.refused.pass); }
        ret;
    }
    if (sel e.input) {
        val row: opt[table.Row] = table.row(e.input.rule);
        if (sel row.some) {
            print.eprintlnf("{}: level {}: before any pass the verifier refuses {}: {}", path, level::u32, row.some.name, e.input.what);
            ret;
        }
        print.eprintlnf("{}: level {}: before any pass the verifier fails", path, level::u32);
        ret;
    }
    if (sel e.unverified) {
        val pass: str = e.unverified.pass;
        if (sel e.unverified.error.refused) {
            val row: opt[table.Row] = table.row(e.unverified.error.refused.rule);
            if (sel row.some) {
                print.eprintlnf("{}: level {}: after pass {} the verifier refuses {}: {}", path, level::u32, pass, row.some.name, e.unverified.error.refused.what);
                ret;
            }
        }
        print.eprintlnf("{}: level {}: after pass {} the verifier failed", path, level::u32, pass);
        ret;
    }
    print.eprintlnf("{}: level {}: the schedule did not run", path, level::u32);
}

# read the text afresh, run the schedule at one level for the target the
# module declares, and verify after every pass
#[testing]
fun at_level(a: *allocator.Allocator, source: View, path: str, level: Level) u32 {
    var r: res[Module, parse.Refusal] = parse.parse_body(a, source);
    if (sel r.err) { ret 1; }
    var m: Module = r.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = targets.by_name(module.target(?m));
    if (sel t.none) {
        print.eprintlnf("{}: no row of mirl.target is the one the file names", path);
        ret 2;
    }
    val ran: err[Error] = driver.run(?m, t.some, Options{level: level, checked: true});
    if (sel ran.err) {
        report(path, level, ran.err);
        ret 3;
    }
    ret 0;
}

# what a walk does with one file of test/ir
# ---
# a:      the allocator the file's reading takes
# source: the file's text
# path:   the file's path, for diagnostics
# tally:  how many runs the visit covered, which it adds to
# ret:    0, or why the visit failed
#[testing]
pub def Visit: fun(*allocator.Allocator, View, str, *usize) u32;

# every file of test/ir through a visit, in directory order
# ---
# visit: what is done with each file
# ret:   0, or the first visit's failure once every file was visited, or why
#        the walk could not run, or that the visits covered nothing
#[testing]
pub fun walk(visit: Visit) u32 {
    var a: allocator.Allocator;
    page.make(?a);
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(?a, "test/ir");
    if (sel names.err) { ret 1; }
    fin { vector.dnit[str](?names.ok); }
    var seen:   usize = 0;
    var failed: u32   = 0;
    var i:      usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirl")) {
            var buf:  [256]u8;
            val path: str                                        = parse.path_of(?buf[0], name);
            val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, path);
            if (sel file.err) { ret 2; }
            fin { vector.dnit[u8](?file.ok); }
            val code: u32 = visit(?a, View{data: file.ok.data, len: file.ok.len}, path, ?seen);
            if (code != 0 && failed == 0) { failed = 10 + code; }
        }
        i = i + 1;
    }
    if (failed != 0) { ret failed; }
    if (seen == 0)   { ret 3; }
    ret 0;
}

# a file at every level
#[testing]
fun every_level(a: *allocator.Allocator, source: View, path: str, tally: *usize) u32 {
    var level: Level = 0;
    for (level <= TOP) {
        val code: u32 = at_level(a, source, path, level);
        if (code != 0) { ret code; }
        level = level + 1;
    }
    @tally = @tally + 1;
    ret 0;
}

# every file of test/ir through the production schedule at every level with the
# verifier after every pass, a file or a pass added later covered unchanged
test pass__every_ir_text_file_runs_the_schedule_at_every_level_and_verifies {
    ret walk(every_level)::i32;
}

# a slot about to leave scope, its last store kept, and the value read before it
#[testing]
val KEPT: str = "target \"riscv64-linux\"\nfunction @wipe: fun(i64) -> (i64) {\n^entry(%key: i64):\n    %slot = alloca type i64, pointer ptr, align 8\n    store %slot, %key, align 8\n    %v = load %slot, type i64, align 8\n    store %slot, i64 0, align 8 kept\n    ret %v\n}\n";

# the same slot once the schedule leaves it, its entry and return in the
# convention's pieces and nothing else changed
#[testing]
val KEPT_PLACED: str = "target \"riscv64-linux\"\nfunction @wipe: fun(i64) -> (i64) placed [register 0 10 fixed exact] {\n^entry(%key: i64):\n    %slot = alloca type i64, pointer ptr, align 8\n    store %slot, %key, align 8\n    %v = load %slot, type i64, align 8\n    store %slot, i64 0, align 8 kept\n    ret.placed %v, places [register 0 10 fixed exact]\n}\n";

# a kept store into a slot that is dead afterwards leaves the whole schedule,
# at every level, as it came in but for its pieces, its mark and its slot
# still there
test pass__kept_store_into_a_dead_slot_survives_the_schedule_at_every_level {
    var a: allocator.Allocator;
    page.make(?a);
    val source: View  = View{data: KEPT, len: str_len(KEPT)};
    var level:  Level = 0;
    for (level <= TOP) {
        var r: res[Module, parse.Refusal] = parse.parse_body(?a, source);
        if (sel r.err) { ret 1; }
        var m: Module = r.ok;
        fin { module.dnit(?m); }
        var w: res[Module, parse.Refusal] = parse.parse_body(?a, View{data: KEPT_PLACED, len: str_len(KEPT_PLACED)});
        if (sel w.err) { ret 1; }
        var want: Module = w.ok;
        fin { module.dnit(?want); }
        val t: opt[*Target] = targets.by_name(module.target(?m));
        if (sel t.none) { ret 2; }
        val ran: err[Error] = driver.run(?m, t.some, Options{level: level, checked: true});
        if (sel ran.err) {
            report("kept", level, ran.err);
            ret 3;
        }
        val same: res[bool, printer.Error] = equal.same(?m, ?want);
        if (sel same.err) { ret 4; }
        if (!same.ok)     { ret 5; }
        level = level + 1;
    }
    ret 0;
}
