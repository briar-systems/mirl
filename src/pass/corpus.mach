# the schedule over the corpus: every IR text file under test/ir goes through
# the whole schedule at every level with the verifier after every pass
#
# the walk takes each file as it finds it, so a file added later and a pass
# added later are covered with no change here. the file names its target, and
# this reads that declared fact to pick the row the schedule runs for.

use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_ends_with;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.vector;
use std.filesystem;
use std.print;

use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.text.parse;
use mirl.pass.driver;
use mirl.pass.driver.Options;
use mirl.pass.failure.Error;
use mirl.pass.failure.Why;
use mirl.pass.schedule.Level;
use targets: mirl.target;
use mirl.target.Target;
use mirl.verify.table;

# the highest optimisation level
#[testing]
val TOP: Level = 3;

# say which pass and which rule or reason a run failed at
#[testing]
fun report(path: str, level: Level, e: Error) {
    if (sel e.refused) {
        val why: Why = e.refused.why;
        if (sel why.reason) { print.eprintlnf("{}: level {}: pass {} refused: {}", path, level::u32, e.refused.pass, why.reason); }
        or                  { print.eprintlnf("{}: level {}: pass {} refused", path, level::u32, e.refused.pass); }
        ret;
    }
    if (sel e.unverified) {
        var pass: str = "(before any pass)";
        if (sel e.unverified.pass.some) { pass = e.unverified.pass.some; }
        if (sel e.unverified.error.refused) {
            val row: opt[table.Row] = table.row(e.unverified.error.refused.rule);
            if (sel row.some) {
                print.eprintlnf("{}: level {}: after pass {} the verifier refuses {}: {}", path, level::u32, pass, row.some.name, e.unverified.error.refused.what);
                ret;
            }
        }
        print.eprintlnf("{}: level {}: after pass {} the verifier failed", path, level::u32, pass);
        ret;
    }
    print.eprintlnf("{}: level {}: the schedule did not run", path, level::u32);
}

# read the text afresh, run the schedule at one level for the target the
# module declares, and verify after every pass
#[testing]
fun at_level(a: *allocator.Allocator, source: View, path: str, level: Level) u32 {
    var r: res[Module, parse.Refusal] = parse.parse_body(a, source);
    if (sel r.err) { ret 1; }
    var m: Module = r.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = targets.by_name(module.target(?m));
    if (sel t.none) {
        print.eprintlnf("{}: no row of mirl.target is the one the file names", path);
        ret 2;
    }
    val ran: err[Error] = driver.run(?m, t.some, Options{level: level, checked: true});
    if (sel ran.err) {
        report(path, level, ran.err);
        ret 3;
    }
    ret 0;
}

# every file of test/ir through the production schedule at every level with the
# verifier after every pass, a file or a pass added later covered unchanged
test pass__every_ir_text_file_runs_the_schedule_at_every_level_and_verifies {
    var a: allocator.Allocator;
    page.make(?a);
    val names: res[vector.Vector[str], filesystem.FsError] = filesystem.read_dir(?a, "test/ir");
    if (sel names.err) { ret 1; }
    fin { vector.dnit[str](?names.ok); }
    var seen: usize = 0;
    var i:    usize = 0;
    for (i < names.ok.len) {
        val name: str = names.ok.data[i];
        if (str_ends_with(name, ".mirl")) {
            var buf:  [256]u8;
            val path: str                                        = parse.path_of(?buf[0], name);
            val file: res[vector.Vector[u8], filesystem.FsError] = filesystem.read_bytes(?a, path);
            if (sel file.err) { ret 2; }
            fin { vector.dnit[u8](?file.ok); }
            var level: Level = 0;
            for (level <= TOP) {
                val code: u32 = at_level(?a, View{data: file.ok.data, len: file.ok.len}, path, level);
                if (code != 0) { ret 10 + code::i32; }
                level = level + 1;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    if (seen == 0) { ret 3; }
    ret 0;
}
