# why a builder stopped, and what it was building when it did

use std.types.option.opt;

use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.opcode.Opcode;

# why a builder refused a call
# ---
# ir:         the module or the function's body refused it
# function:   an instruction, block or constant value asked for with no
#             function entered
# terminated: building at the end of a block that already ends in a terminator
# position:   an insertion position the block does not have, or one past its
#             terminator
# terminator: a terminator where it cannot end its block, or a replacement
#             that does not end its block exactly when the one it replaces did
# result:     a result position the instruction does not have
pub tag Error: u8 {
    ir: module.Error;
    function;
    terminated: Block;
    position:   u32;
    terminator;
    result: u32;
}

# what a builder was building
# ---
# instruction: an instruction of this opcode
# copy:        a copy of this instruction
# result:      a result of this instruction
# derive:      the attributes of this instruction, taken as the sticky ones
# block:       a block
# parameter:   a parameter of this block
# constant:    a constant, or its value in the function
# global:      a global
# function:    a function declaration
# name:        the name of this value
# label:       the name of this block
pub tag Work: u8 {
    instruction: Opcode;
    copy:        Instruction;
    result:      Instruction;
    derive:      Instruction;
    block;
    parameter: Block;
    constant;
    global;
    function;
    name:  Value;
    label: Block;
}

# the first failure of a builder
# ---
# error:    why it was refused
# work:     what was being built
# function: the function it was built in, none outside one
pub rec Failure {
    error:    Error;
    work:     Work;
    function: opt[Function];
}
