# why a builder stopped, and what it was building when it did

use std.types.option.opt;

use mirl.build.error;
use mirl.ir.debug.Binding;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.opcode.Opcode;

# what a builder was building
# ---
# instruction: an instruction of this opcode
# copy:        a copy of this instruction
# result:      a result of this instruction
# derive:      the attributes of this instruction, taken as the sticky ones
# block:       a block
# parameter:   a parameter of this block
# constant:    a constant, or its value in the function
# global:      a global
# function:    a function declaration
# signature:   a function type
# symbol:      the symbol name of a function or global
# name:        the name of this value
# label:       the name of this block
# bind:        a value binding record of this variable
pub tag Work: u8 {
    instruction: Opcode;
    copy:        Instruction;
    result:      Instruction;
    derive:      Instruction;
    block;
    parameter: Block;
    constant;
    global;
    function;
    signature;
    symbol;
    name:  Value;
    label: Block;
    bind:  Binding;
}

# the first failure of a builder
# ---
# error:    why it was refused
# work:     what was being built
# function: the function it was built in, none outside one
pub rec Error {
    error:    error.Error;
    work:     Work;
    function: opt[Function];
}
