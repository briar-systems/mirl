# the values and blocks a copy stands for, from the source to the copy

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use std.allocator;
use std.collections.map;

use mirl.ir.id.Block;
use mirl.ir.id.Value;

# a map from source values and blocks to their copies
# ---
# values: each source value's copy, keyed by its index
# blocks: each source block's copy, keyed by its index
pub rec Remap {
    values: map.Map[u32, Value];
    blocks: map.Map[u32, Block];
}

# an empty map
pub fun init(a: *allocator.Allocator) Remap {
    ret Remap{values: map.init[u32, Value](a), blocks: map.init[u32, Block](a)};
}

# release a map
pub fun dnit(r: *Remap) err[allocator.Error] {
    val values: err[allocator.Error] = map.dnit[u32, Value](?r.values);
    val blocks: err[allocator.Error] = map.dnit[u32, Block](?r.blocks);
    if (sel values.err) { ret values; }
    ret blocks;
}

fun stored(r: res[bool, allocator.Error]) err[allocator.Error] {
    if (sel r.err) { ret err[allocator.Error].err{r.err}; }
    ret err[allocator.Error].ok{};
}

# bind a source value to its copy
pub fun bind_value(r: *Remap, from: Value, to: Value) err[allocator.Error] {
    ret stored(map.insert[u32, Value](?r.values, from.index, to));
}

# bind a source block to its copy
pub fun bind_block(r: *Remap, from: Block, to: Block) err[allocator.Error] {
    ret stored(map.insert[u32, Block](?r.blocks, from.index, to));
}

# the copy of a source value, none when unbound
pub fun value(r: *Remap, from: Value) opt[Value] {
    val key:   u32         = from.index;
    val found: opt[*Value] = map.get[u32, Value](?r.values, ?key);
    if (sel found.some) { ret opt[Value].some{@found.some}; }
    ret opt[Value].none{};
}

# the copy of a source block, none when unbound
pub fun block(r: *Remap, from: Block) opt[Block] {
    val key:   u32         = from.index;
    val found: opt[*Block] = map.get[u32, Block](?r.blocks, ?key);
    if (sel found.some) { ret opt[Block].some{@found.some}; }
    ret opt[Block].none{};
}
