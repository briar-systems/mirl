# why a builder refused a call, the level below the failure that names what
# it was building

use std.allocator;
use std.types.option.opt;

use mirl.ir.id.Block;
use mirl.ir.module;

# why a builder refused a call
# ---
# ir:         the module or the function's body refused it
# function:   an instruction, block or constant value asked for with no
#             function entered
# terminated: building at the end of a block that already ends in a terminator
# position:   building just past this instruction, its block's terminator
# terminator: a terminator where it cannot end its block, or a replacement
#             that does not end its block exactly when the one it replaces did
# result:     a result position the instruction does not have
# unplaced:   a binding asked for with the cursor in no block, so at no point
pub tag Error: u8 {
    ir: module.Error;
    function;
    terminated: Block;
    position:   u32;
    terminator;
    result: u32;
    unplaced;
}

# the allocator's refusal `e` stands for, the body's it carries, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.ir) { ret module.starved(e.ir); }
    ret opt[allocator.Error].none{};
}
