# the folder's request and result records

use std.types.bool.bool;
use std.types.error.err;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;

use mirl.fail.keep;
use mirl.ir.constant.Bits;
use checker: mirl.ir.opcode.check;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.rule.Trap;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.slice;

# a constant as the folder reads and gives it, lane by lane
# ---
# type:  its type, an integer, a float or a vector of either
# lanes: its bits, one per lane of the lane type, a scalar being one lane
pub rec Value {
    type:  Type;
    lanes: Slice[Bits];
}

# one constant operand of an operation
# ---
# value:  the constant
# secret: the operand is secret
pub rec Operand {
    value:  Value;
    secret: bool;
}

# one operation of the opcode table to evaluate on constants
#
# lists are borrowed for the call.
# ---
# opcode:     the operation
# operands:   its operands in order, the fixed ones then the tail, each
#             holding its type
# immediates: its immediates, one per slot of the row
pub rec Request {
    opcode:     Opcode;
    operands:   Slice[Operand];
    immediates: Slice[Immediate];
}

# the constant results of an operation, owned by the caller until `release`
# ---
# results: one value per result of the row, in order
# secret:  the results are secret, by the row's secrecy rule
pub rec Folded {
    results: Slice[Value];
    secret:  bool;
}

# why the folder gave no constant
# ---
# unfoldable: the row is not evaluated on constants, such as one that reads
#             memory, transfers control or computes an address
# trap:       the operation would trap, by this trap of its row
# check:      the request breaks this rule of its row
# operand:    the operand at this position does not hold one lane of bits per
#             lane of its type
# types:      the type table refused a read
# alloc:      the allocator refused storage for a result
pub tag Refusal: u8 {
    unfoldable;
    trap:    Trap;
    check:   checker.Error;
    operand: u32;
    types:   types.Error;
    alloc:   allocator.Error;
}

# what the folder gives
# ---
# refused: no constant, and why
# folded:  the constant results
pub tag Outcome: u8 {
    refused: Refusal;
    folded:  Folded;
}

# give back the lists of a value the folder made
pub fun release_value(a: *allocator.Allocator, v: Value) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < v.lanes.size) {
        keep(?failed, slice.release[u64](a, v.lanes.data[i].words));
        i = i + 1;
    }
    keep(?failed, slice.release[Bits](a, v.lanes));
    ret failed;
}

# give back the results the folder made
# ---
# a:   the allocator the fold was given
# f:   the results
# ret: ok, or the allocator's refusal of the first release that failed
pub fun release(a: *allocator.Allocator, f: Folded) err[allocator.Error] {
    var failed: err[allocator.Error] = err[allocator.Error].ok{};
    var i:      usize                = 0;
    for (i < f.results.size) {
        keep(?failed, release_value(a, f.results.data[i]));
        i = i + 1;
    }
    keep(?failed, slice.release[Value](a, f.results));
    ret failed;
}
