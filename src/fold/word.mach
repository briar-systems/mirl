# multiword integers: the one arithmetic every integer width and float significand folds through
#
# a number is a fixed run of words, low word first, wide enough for the exact
# product of two of the widest integers and for a float's exact intermediate.
# an operation at a width reads only the bits below it and gives zero above it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use std.collections.slice.Slice;

# a number, low word first
pub def Wide: [16]u64;

# the number of words in a number
pub fun words() u32 {
    ret $length_of(Wide);
}

# the number of bits in a number
pub fun capacity() u32 {
    ret 64 * words();
}

# the number with every bit zero
pub fun zero() Wide {
    var r: Wide;
    ret r;
}

# the number with the value of one word
pub fun small(v: u64) Wide {
    var r: Wide;
    r[0] = v;
    ret r;
}

# the number a list of words holds, low word first
pub fun of(s: Slice[u64]) Wide {
    var r: Wide;
    var i: usize = 0;
    for (i < s.size && i < words()::usize) {
        r[i] = s.data[i];
        i    = i + 1;
    }
    ret r;
}

# the words a width takes
pub fun words_for(width: u32) u32 {
    ret (width + 63) / 64;
}

# whether bit i is set
pub fun bit(x: Wide, i: u32) bool {
    if (i >= capacity()) { ret false; }
    ret ((x[i / 64] >> (i % 64)::u64) & 1) != 0;
}

# whether every bit is zero
pub fun is_zero(x: Wide) bool {
    var i: u32 = 0;
    for (i < words()) {
        if (x[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the bits below a width, the rest zero
pub fun mask(x: Wide, width: u32) Wide {
    if (width >= capacity()) { ret x; }
    var r: Wide = x;
    var i: u32  = width / 64;
    val b: u64  = (width % 64)::u64;
    if (b != 0) {
        r[i] = r[i] & ((1::u64 << b) - 1);
        i    = i + 1;
    }
    for (i < words()) {
        r[i] = 0;
        i    = i + 1;
    }
    ret r;
}

# every bit below a width set
pub fun ones(width: u32) Wide {
    ret mask(bit_not(zero()), width);
}

# the bits below a width with bit width - 1 copied into every bit above
pub fun sext(x: Wide, width: u32) Wide {
    val low: Wide = mask(x, width);
    if (width == 0 || !bit(x, width - 1)) { ret low; }
    ret bit_or(low, bit_not(ones(width)));
}

# the complement of every bit
pub fun bit_not(x: Wide) Wide {
    var r: Wide;
    var i: u32 = 0;
    for (i < words()) {
        r[i] = ~x[i];
        i    = i + 1;
    }
    ret r;
}

# the bitwise and
pub fun bit_and(x: Wide, y: Wide) Wide {
    var r: Wide;
    var i: u32 = 0;
    for (i < words()) {
        r[i] = x[i] & y[i];
        i    = i + 1;
    }
    ret r;
}

# the bitwise or
pub fun bit_or(x: Wide, y: Wide) Wide {
    var r: Wide;
    var i: u32 = 0;
    for (i < words()) {
        r[i] = x[i] | y[i];
        i    = i + 1;
    }
    ret r;
}

# the bitwise exclusive or
pub fun bit_xor(x: Wide, y: Wide) Wide {
    var r: Wide;
    var i: u32 = 0;
    for (i < words()) {
        r[i] = x[i] ^ y[i];
        i    = i + 1;
    }
    ret r;
}

# the sum, wrapping at the capacity
pub fun add(x: Wide, y: Wide) Wide {
    var r:     Wide;
    var carry: u128 = 0;
    var i:     u32  = 0;
    for (i < words()) {
        val s: u128 = x[i]::u128 + y[i]::u128 + carry;
        r[i]  = s::u64;
        carry = s >> 64;
        i     = i + 1;
    }
    ret r;
}

# the difference, wrapping at the capacity
pub fun sub(x: Wide, y: Wide) Wide {
    ret add(add(x, bit_not(y)), small(1));
}

# the two's complement negation, wrapping at the capacity
pub fun neg(x: Wide) Wide {
    ret add(bit_not(x), small(1));
}

# the low capacity bits of the product
pub fun mul(x: Wide, y: Wide) Wide {
    var r: Wide;
    var i: u32 = 0;
    for (i < words()) {
        var carry: u128 = 0;
        var j:     u32  = 0;
        for (i + j < words()) {
            val p: u128 = x[i]::u128 * y[j]::u128 + r[i + j]::u128 + carry;
            r[i + j] = p::u64;
            carry    = p >> 64;
            j        = j + 1;
        }
        i = i + 1;
    }
    ret r;
}

# the bits moved toward the top by n, zero for n at or past the capacity
pub fun shl(x: Wide, n: u32) Wide {
    var r: Wide;
    if (n >= capacity()) { ret r; }
    val ws: u32 = n / 64;
    val bs: u64 = (n % 64)::u64;
    var i:  u32 = words();
    for (i > ws) {
        i = i - 1;
        var v: u64 = x[i - ws] << bs;
        if (bs != 0 && i > ws) { v = v | (x[i - ws - 1] >> (64 - bs)); }
        r[i] = v;
    }
    ret r;
}

# the bits moved toward the bottom by n, zero for n at or past the capacity
pub fun shr(x: Wide, n: u32) Wide {
    var r: Wide;
    if (n >= capacity()) { ret r; }
    val ws: u32 = n / 64;
    val bs: u64 = (n % 64)::u64;
    var i:  u32 = 0;
    for (i + ws < words()) {
        var v: u64 = x[i + ws] >> bs;
        if (bs != 0 && i + ws + 1 < words()) { v = v | (x[i + ws + 1] << (64 - bs)); }
        r[i] = v;
        i    = i + 1;
    }
    ret r;
}

# the order of two numbers as unsigned: -1 below, 0 equal, 1 above
pub fun compare(x: Wide, y: Wide) i32 {
    var i: u32 = words();
    for (i > 0) {
        i = i - 1;
        if (x[i] < y[i]) { ret -1; }
        if (x[i] > y[i]) { ret 1; }
    }
    ret 0;
}

# the number of bits up to and including the highest set bit, zero for zero
pub fun length(x: Wide) u32 {
    var i: u32 = words();
    for (i > 0) {
        i = i - 1;
        if (x[i] != 0) {
            var n: u32 = 64;
            for (((x[i] >> (n - 1)::u64) & 1) == 0) { n = n - 1; }
            ret 64 * i + n;
        }
    }
    ret 0;
}

# the position of the lowest set bit, the capacity for zero
pub fun lowest(x: Wide) u32 {
    var i: u32 = 0;
    for (i < capacity()) {
        if (bit(x, i)) { ret i; }
        i = i + 1;
    }
    ret capacity();
}

# the number of set bits
pub fun count(x: Wide) u32 {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < capacity()) {
        if (bit(x, i)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# the unsigned quotient and remainder, the divisor nonzero
# ---
# x:   the dividend
# y:   the divisor
# rem: where the remainder is written
# ret: the quotient
pub fun divide(x: Wide, y: Wide, rem: *Wide) Wide {
    var q: Wide;
    var r: Wide;
    var i: u32 = length(x);
    for (i > 0) {
        i = i - 1;
        r = shl(r, 1);
        if (bit(x, i)) { r[0] = r[0] | 1; }
        if (compare(r, y) >= 0) {
            r         = sub(r, y);
            q[i / 64] = q[i / 64] | (1::u64 << (i % 64)::u64);
        }
    }
    @rem = r;
    ret q;
}

# the integer square root and its remainder
# ---
# x:   the radicand
# rem: where x minus the root squared is written
# ret: the greatest number whose square is at most x
pub fun root(x: Wide, rem: *Wide) Wide {
    var v:   Wide = x;
    var r:   Wide;
    var top: u32  = length(x);
    if (top % 2 == 1) { top = top + 1; }
    var b: Wide = zero();
    if (top >= 2) { b = shl(small(1), top - 2); }
    for (!is_zero(b)) {
        val t: Wide = add(r, b);
        if (compare(v, t) >= 0) {
            v = sub(v, t);
            r = add(shr(r, 1), b);
        }
        or {
            r = shr(r, 1);
        }
        b = shr(b, 2);
    }
    @rem = v;
    ret r;
}

# whether a number at a width is negative read as signed
pub fun negative(x: Wide, width: u32) bool {
    ret width != 0 && bit(x, width - 1);
}

# the order of two numbers at a width read as signed: -1 below, 0 equal, 1 above
pub fun compare_signed(x: Wide, y: Wide, width: u32) i32 {
    val nx: bool = negative(x, width);
    val ny: bool = negative(y, width);
    if (nx && !ny) { ret -1; }
    if (ny && !nx) { ret 1; }
    ret compare(mask(x, width), mask(y, width));
}

# the least signed value at a width: only the sign bit set
pub fun least(width: u32) Wide {
    if (width == 0) { ret zero(); }
    ret shl(small(1), width - 1);
}

# the wrapping sum at a width
pub fun add_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(add(x, y), width);
}

# the wrapping difference at a width
pub fun sub_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(sub(x, y), width);
}

# the wrapping product at a width
pub fun mul_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(mul(x, y), width);
}

# the unsigned quotient at a width, the divisor nonzero
pub fun div_u(x: Wide, y: Wide, width: u32) Wide {
    var r: Wide;
    ret divide(mask(x, width), mask(y, width), ?r);
}

# the unsigned remainder at a width, the divisor nonzero
pub fun rem_u(x: Wide, y: Wide, width: u32) Wide {
    var r: Wide;
    divide(mask(x, width), mask(y, width), ?r);
    ret r;
}

fun magnitude(x: Wide, width: u32) Wide {
    if (negative(x, width)) { ret mask(neg(sext(x, width)), width + 1); }
    ret mask(x, width);
}

# the signed quotient at a width rounded toward zero, the divisor nonzero
pub fun div_s(x: Wide, y: Wide, width: u32) Wide {
    var r: Wide;
    val q: Wide = divide(magnitude(x, width), magnitude(y, width), ?r);
    if (negative(x, width) != negative(y, width)) { ret mask(neg(q), width); }
    ret mask(q, width);
}

# the signed remainder at a width with the sign of the dividend, the divisor nonzero
pub fun rem_s(x: Wide, y: Wide, width: u32) Wide {
    var r: Wide;
    divide(magnitude(x, width), magnitude(y, width), ?r);
    if (negative(x, width)) { ret mask(neg(r), width); }
    ret mask(r, width);
}

# the bitwise and at a width
pub fun and_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(bit_and(x, y), width);
}

# the bitwise or at a width
pub fun or_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(bit_or(x, y), width);
}

# the bitwise exclusive or at a width
pub fun xor_at(x: Wide, y: Wide, width: u32) Wide {
    ret mask(bit_xor(x, y), width);
}

# the lesser at a width read as signed
pub fun min_s(x: Wide, y: Wide, width: u32) Wide {
    if (compare_signed(x, y, width) <= 0) { ret mask(x, width); }
    ret mask(y, width);
}

# the greater at a width read as signed
pub fun max_s(x: Wide, y: Wide, width: u32) Wide {
    if (compare_signed(x, y, width) >= 0) { ret mask(x, width); }
    ret mask(y, width);
}

# the lesser at a width read as unsigned
pub fun min_u(x: Wide, y: Wide, width: u32) Wide {
    if (compare(mask(x, width), mask(y, width)) <= 0) { ret mask(x, width); }
    ret mask(y, width);
}

# the greater at a width read as unsigned
pub fun max_u(x: Wide, y: Wide, width: u32) Wide {
    if (compare(mask(x, width), mask(y, width)) >= 0) { ret mask(x, width); }
    ret mask(y, width);
}

# the left shift at a width by a count below it
pub fun shl_at(x: Wide, n: u32, width: u32) Wide {
    ret mask(shl(x, n), width);
}

# the logical right shift at a width by a count below it
pub fun shr_u(x: Wide, n: u32, width: u32) Wide {
    ret shr(mask(x, width), n);
}

# the arithmetic right shift at a width by a count below it
pub fun shr_s(x: Wide, n: u32, width: u32) Wide {
    ret mask(shr(sext(x, width), n), width);
}

# the two's complement negation at a width
pub fun neg_at(x: Wide, width: u32) Wide {
    ret mask(neg(x), width);
}

# the bitwise complement at a width
pub fun not_at(x: Wide, width: u32) Wide {
    ret mask(bit_not(x), width);
}

# the number of set bits at a width
pub fun popcnt(x: Wide, width: u32) Wide {
    ret small(count(mask(x, width))::u64);
}

# the bytes at a width, a whole number of bytes, in reverse order
pub fun bswap(x: Wide, width: u32) Wide {
    var r: Wide;
    val n: u32 = width / 8;
    var i: u32 = 0;
    for (i < n) {
        val byte: Wide = bit_and(shr(x, 8 * i), small(0xff));
        r = bit_or(r, shl(byte, 8 * (n - 1 - i)));
        i = i + 1;
    }
    ret r;
}

# the number of leading zero bits at a width, the width for zero
pub fun clz(x: Wide, width: u32) Wide {
    ret small((width - length(mask(x, width)))::u64);
}

# the number of trailing zero bits at a width, the width for zero
pub fun ctz(x: Wide, width: u32) Wide {
    val m: Wide = mask(x, width);
    if (is_zero(m)) { ret small(width::u64); }
    ret small(lowest(m)::u64);
}

# the wrapping signed sum at a width, flagging a sum the width cannot hold
pub fun add_ov_s(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    val s: Wide = add(sext(x, width), sext(y, width));
    @over = compare(sext(s, width), s) != 0;
    ret mask(s, width);
}

# the wrapping unsigned sum at a width, flagging a carry out
pub fun add_ov_u(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    val s: Wide = add(mask(x, width), mask(y, width));
    @over = length(s) > width;
    ret mask(s, width);
}

# the wrapping signed difference at a width, flagging one the width cannot hold
pub fun sub_ov_s(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    val d: Wide = sub(sext(x, width), sext(y, width));
    @over = compare(sext(d, width), d) != 0;
    ret mask(d, width);
}

# the wrapping unsigned difference at a width, flagging a borrow
pub fun sub_ov_u(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    @over = compare(mask(x, width), mask(y, width)) < 0;
    ret sub_at(x, y, width);
}

# the wrapping signed product at a width, flagging one the width cannot hold
pub fun mul_ov_s(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    val p: Wide = mul(sext(x, width), sext(y, width));
    @over = compare(sext(p, width), p) != 0;
    ret mask(p, width);
}

# the wrapping unsigned product at a width, flagging one the width cannot hold
pub fun mul_ov_u(x: Wide, y: Wide, width: u32, over: *bool) Wide {
    val p: Wide = mul(mask(x, width), mask(y, width));
    @over = length(p) > width;
    ret mask(p, width);
}

# integer extension from one width to a wider one, filling with zeros
pub fun ext_u(x: Wide, from: u32, to: u32) Wide {
    ret mask(x, from);
}

# integer extension from one width to a wider one, filling with the sign
pub fun ext_s(x: Wide, from: u32, to: u32) Wide {
    ret mask(sext(x, from), to);
}

# integer truncation from one width to a narrower one, keeping the low bits
pub fun trunc(x: Wide, from: u32, to: u32) Wide {
    ret mask(x, to);
}
