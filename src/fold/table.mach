    UNFOLDABLE,
    UNFOLDABLE,
    Entry.long{word.div_wide_u},
};

# the entry of an opcode's row, unstated when the opcode names no entry
pub fun entry(op: Opcode) Entry {
    if (op.index >= $length_of(Entries)) { ret Entry.unstated{}; }
    ret ENTRIES[op.index];
}

# the comparison an opcode is, none when it is not an integer comparison
pub fun comparison(op: Opcode) opt[Comparison] {
    val e: Entry = entry(op);
    if (sel e.compare) { ret opt[Comparison].some{e.compare}; }
    ret opt[Comparison].none{};
}

# whether a row can be evaluated on constants at all: it touches no memory,
# transfers no control, has results whose secrecy the operands decide, and
# traps only on what its operands' values show
fun computable(r: *Row) bool {
    if (r.effects.reads || r.effects.writes || r.terminator)          { ret false; }
    if (!(sel r.secrecy.propagates) && !(sel r.secrecy.declassifies)) { ret false; }
    var i: u32 = 0;
    for (i < $length_of(Traps)) {
        val t: opcodes.Trap = r.effects.traps[i];
        if (!(sel t.unstated) && !(sel t.zero) && !(sel t.overflow) && !(sel t.exceeds)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun traps(r: *Row) bool {
    ret !(sel r.effects.traps[0].unstated);
}

# the fixed operands an entry reads
fun arity(e: Entry) u32 {
    if (sel e.build)                                                                                                                                  { ret 0; }
    if (sel e.binary || sel e.shift || sel e.overflow || sel e.compare || sel e.float_binary || sel e.float_compare || sel e.shuffle || sel e.insert) { ret 2; }
    if (sel e.float_ternary || sel e.select || sel e.long)                                                                                            { ret 3; }
    ret 1;
}

fun integer_entry(e: Entry) bool {
    ret sel e.unary || sel e.binary || sel e.shift || sel e.overflow || sel e.long || sel e.compare || sel e.reduce || sel e.resize || sel e.to_float;
}

fun float_entry(e: Entry) bool {
    ret sel e.float_unary || sel e.float_binary || sel e.float_ternary || sel e.float_compare || sel e.float_reduce || sel e.to_integer || sel e.reformat;
}

# the class the row's rules bound its first operand to, unstated when none
fun first_class(r: *Row) Class {
    var i: u32 = 0;
    for (i < $length_of(Rules)) {
        val rl: Rule = r.rules[i];
        if (sel rl.is) {
            val b: opcodes.Bound = rl.is;
            if (sel b.subject.operand && b.subject.operand == 0) { ret b.class; }
        }
        i = i + 1;
    }
    ret Class.unstated{};
}

# zero when the entry agrees with its row, else the first disagreement
fun agrees(r: *Row, e: Entry) u32 {
    if (sel e.unstated)               { ret 1; }
    if (sel e.unfoldable)             { ret 0; }
    if (!computable(r))               { ret 2; }
    if (arity(e) != opcodes.fixed(r)) { ret 3; }

    val masks:  bool           = sel e.compare || sel e.float_compare;
    val first:  opcodes.Result = r.results[0];
    val second: opcodes.Result = r.results[1];
    if (sel e.overflow) {
        if (!(sel first.same) || !(sel second.mask)) { ret 4; }
    }
    or (sel e.long) {
        if (!(sel first.same) || !(sel second.same)) { ret 4; }
    }
    or {
        if (sel first.unstated || !(sel second.unstated)) { ret 4; }
        if ((sel first.mask) != masks)                    { ret 4; }
    }

    if (traps(r) && !(sel e.binary) && !(sel e.long))                                 { ret 5; }
    if (!(sel r.overshift.none) != (sel e.shift))                                     { ret 6; }
    if ((sel r.order.ordered || sel r.order.unordered) != (sel e.float_compare))      { ret 7; }
    if ((sel r.order.sequential || sel r.order.reassociable) != (sel e.float_reduce)) { ret 7; }
    if ((sel r.vector.across) != (sel e.reduce || sel e.float_reduce))                { ret 8; }

    val class: Class = first_class(r);
    if (integer_entry(e) && !(sel class.integer) && !(sel class.bytes)) { ret 9; }
    if (float_entry(e) && !(sel class.float))                           { ret 9; }
    ret 0;
}

test table__every_row_has_an_agreeing_entry {
    if ($length_of(Entries) != opcodes.rows()) { ret 1; }
    var i: u32 = 0;
    for (i < opcodes.rows()) {
        val got: opt[Row] = opcodes.row(Opcode{index: i});
        if (sel got.none) { ret 2; }
        var r:      Row = got.some;
        val defect: u32 = agrees(?r, entry(Opcode{index: i}));
        if (defect != 0) { ret (10 + defect)::i32; }
        i = i + 1;
    }

    # the multiword capacity holds the widest product and every format's intermediates
    i = 0;
    for (i < $length_of(types.Widths)) {
        if (2 * types.WIDTHS[i] > word.capacity()) { ret 3; }
        i = i + 1;
    }
    i = 0;
    for (i < types.rows()) {
        val fr: opt[types.Row] = types.row(types.Format{index: i});
        if (sel fr.none) { ret 4; }
        val s: opt[Spec] = float.spec(fr.some);
        if (sel s.none) { ret 5; }
        var sp: Spec = s.some;
        if (sp.width > word.capacity() || 4 * float.precision(?sp) + 8 > word.capacity()) { ret 6; }
        i = i + 1;
    }
    ret 0;
}
