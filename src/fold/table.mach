# the evaluation table: one entry per row of the opcode table, at the row's index
#
# an entry says how its row evaluates on constants, or that the row is not
# evaluated on constants. the walk below holds every row to an entry that
# agrees with it, so a row added without one fails there.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mirl.fold.float;
use mirl.fold.float.Spec;
use mirl.fold.word;
use mirl.fold.word.Wide;
use opcodes: mirl.ir.opcode;
use mirl.ir.opcode.Class;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Rule;
use mirl.ir.opcode.Rules;
use mirl.ir.opcode.Traps;
use types: mirl.ir.type;

# an integer operation of one operand at a width
pub def Unary: fun(Wide, u32) Wide;

# an integer operation of two operands at a width
pub def Binary: fun(Wide, Wide, u32) Wide;

# a shift at a width by a count below it
pub def Shift: fun(Wide, u32, u32) Wide;

# an integer operation of two operands at a width that flags an overflow
pub def Overflow: fun(Wide, Wide, u32, *bool) Wide;

# an integer conversion from one width to another
pub def Resize: fun(Wide, u32, u32) Wide;

# an unsigned division of a two-word dividend, its high word and its low word,
# by a word divisor at a width, giving the quotient and writing the remainder
pub def Long: fun(Wide, Wide, Wide, u32, *Wide) Wide;

# a float operation of one operand in a format
pub def FloatUnary: fun(*Spec, Wide) Wide;

# a float operation of two operands in a format
pub def FloatBinary: fun(*Spec, Wide, Wide) Wide;

# a float operation of three operands in a format
pub def FloatTernary: fun(*Spec, Wide, Wide, Wide) Wide;

# the orderings a comparison is true for
pub rec Relation {
    less:    bool;
    equal:   bool;
    greater: bool;
}

# an integer comparison
# ---
# relation: the orderings it is true for
# signed:   it reads its operands as signed
pub rec Comparison {
    relation: Relation;
    signed:   bool;
}

# how a row evaluates on constants
#
# a lanewise entry applies to each lane, an across entry combines the lanes of
# its one vector in lane order, and the rest are the vector operations by
# their lanes. traps, shifts past the width, nan comparisons, secrecy and
# result types are read from the row, never stated here.
# ---
# unfoldable:    the row is not evaluated on constants
# unary:         an integer operation of one operand
# binary:        an integer operation of two operands
# shift:         a shift, whose count at or past the width the row's overshift
#                decides
# overflow:      an integer operation giving its value and an overflow flag
# long:          a division of a two-word dividend giving the quotient and the
#                remainder
# compare:       an integer comparison giving i1
# reduce:        the lanes of an integer vector combined by the operation
# resize:        an integer conversion to the stated integer type
# float_unary:   a float operation of one operand
# float_binary:  a float operation of two operands
# float_ternary: a float operation of three operands
# float_compare: a float comparison giving i1, whose answer for a nan the
#                row's order decides
# float_reduce:  the lanes of a float vector combined by the operation
# to_float:      an integer to the stated float type, signed when true
# to_integer:    a float to the stated integer type, signed when true
# reformat:      a float to the stated float type
# bitcast:       the same bits as the stated type
# select:        the second operand where the condition is 1, else the third
# identity:      the operand itself
# splat:         every lane of the stated vector type the scalar
# build:         the stated vector type from one scalar per lane
# shuffle:       the lanes the lane list picks from the two vectors joined
# extract:       the lane the immediate names
# insert:        the vector with the lane the immediate names replaced
pub tag Entry: u8 {
    unstated;
    unfoldable;
    unary:         Unary;
    binary:        Binary;
    shift:         Shift;
    overflow:      Overflow;
    long:          Long;
    compare:       Comparison;
    reduce:        Binary;
    resize:        Resize;
    float_unary:   FloatUnary;
    float_binary:  FloatBinary;
    float_ternary: FloatTernary;
    float_compare: Relation;
    float_reduce:  FloatBinary;
    to_float:      bool;
    to_integer:    bool;
    reformat;
    bitcast;
    select;
    identity;
    splat;
    build;
    shuffle;
    extract;
    insert;
}

val NO:  bool     = false;
val YES: bool     = true;
val LT:  Relation = Relation{less: true, equal: false, greater: false};
val LE:  Relation = Relation{less: true, equal: true, greater: false};
val GT:  Relation = Relation{less: false, equal: false, greater: true};
val GE:  Relation = Relation{less: false, equal: true, greater: true};
val EQ:  Relation = Relation{less: false, equal: true, greater: false};
val NE:  Relation = Relation{less: true, equal: false, greater: true};
val ANY: Relation = Relation{less: true, equal: true, greater: true};
val NIL: Relation = Relation{less: false, equal: false, greater: false};

val UNFOLDABLE: Entry = Entry.unfoldable{};

def Entries: [132]Entry;

val ENTRIES: Entries = [132]Entry{
    Entry.binary{word.add_at},
    Entry.binary{word.sub_at},
    Entry.binary{word.mul_at},
    Entry.binary{word.div_s},
    Entry.binary{word.div_u},
    Entry.binary{word.rem_s},
    Entry.binary{word.rem_u},
    Entry.binary{word.and_at},
    Entry.binary{word.or_at},
    Entry.binary{word.xor_at},
    Entry.shift{word.shl_at},
    Entry.shift{word.shr_u},
    Entry.shift{word.shr_s},
    Entry.unary{word.neg_at},
    Entry.unary{word.not_at},
    Entry.compare{Comparison{relation: EQ, signed: NO}},
    Entry.compare{Comparison{relation: NE, signed: NO}},
    Entry.compare{Comparison{relation: LT, signed: YES}},
    Entry.compare{Comparison{relation: LE, signed: YES}},
    Entry.compare{Comparison{relation: GT, signed: YES}},
    Entry.compare{Comparison{relation: GE, signed: YES}},
    Entry.compare{Comparison{relation: LT, signed: NO}},
    Entry.compare{Comparison{relation: LE, signed: NO}},
    Entry.compare{Comparison{relation: GT, signed: NO}},
    Entry.compare{Comparison{relation: GE, signed: NO}},
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    Entry.float_binary{float.fadd},
    Entry.float_compare{LT},
    Entry.resize{word.ext_u},
    Entry.resize{word.trunc},
    Entry.to_float{YES},
    Entry.to_integer{YES},
    Entry.reformat{},
    Entry.bitcast{},
    UNFOLDABLE,
    Entry.splat{},
    Entry.build{},
    Entry.shuffle{},
    Entry.extract{},
    Entry.insert{},
    Entry.reduce{word.add_at},
    Entry.float_reduce{float.fadd},
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    Entry.select{},
    Entry.identity{},
    Entry.overflow{word.add_ov_s},
    Entry.unary{word.popcnt},
    Entry.unary{word.bswap},
    UNFOLDABLE,
    Entry.float_binary{float.fsub},
    Entry.float_binary{float.fmul},
    Entry.float_binary{float.fdiv},
    Entry.float_binary{float.frem},
    Entry.float_binary{float.fmin},
    Entry.float_binary{float.fmax},
    Entry.float_binary{float.fminnum},
    Entry.float_binary{float.fmaxnum},
    Entry.float_binary{float.fcopysign},
    Entry.float_unary{float.fneg},
    Entry.float_unary{float.fabs},
    Entry.float_unary{float.fsqrt},
    Entry.float_unary{float.ffloor},
    Entry.float_unary{float.fceil},
    Entry.float_unary{float.fint},
    Entry.float_unary{float.fnearest},
    Entry.float_ternary{float.fma},
    Entry.float_compare{EQ},
    Entry.float_compare{NE},
    Entry.float_compare{LE},
    Entry.float_compare{GT},
    Entry.float_compare{GE},
    Entry.float_compare{ANY},
    Entry.float_compare{EQ},
    Entry.float_compare{NE},
    Entry.float_compare{LT},
    Entry.float_compare{LE},
    Entry.float_compare{GT},
    Entry.float_compare{GE},
    Entry.float_compare{NIL},
    Entry.resize{word.ext_s},
    Entry.to_float{NO},
    Entry.to_integer{NO},
    Entry.reformat{},
    UNFOLDABLE,
    Entry.reduce{word.mul_at},
    Entry.reduce{word.and_at},
    Entry.reduce{word.or_at},
    Entry.reduce{word.xor_at},
    Entry.reduce{word.min_s},
    Entry.reduce{word.max_s},
    Entry.reduce{word.min_u},
    Entry.reduce{word.max_u},
    Entry.float_reduce{float.fadd},
    Entry.float_reduce{float.fmul},
    Entry.float_reduce{float.fmin},
    Entry.float_reduce{float.fmax},
    Entry.float_reduce{float.fminnum},
    Entry.float_reduce{float.fmaxnum},
    Entry.float_reduce{float.fmul},
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    UNFOLDABLE,
    Entry.overflow{word.add_ov_u},
    Entry.overflow{word.sub_ov_s},
