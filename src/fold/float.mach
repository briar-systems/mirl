# soft float: every float operation over any binary number format, read from its row
#
# a value is unpacked to a sign and an exact significand and exponent, an
# operation computes its exact result or that result's leading bits and a
# sticky bit, and one rounding packs it in the format. nothing here names a
# format, so a new row of the number format table folds as it stands.
#
# a nan operand gives itself quieted, the first such operand when several are,
# and an invalid operation gives the format's canonical quiet nan.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mirl.fold.word;
use mirl.fold.word.Wide;
use types: mirl.ir.type;
use mirl.ir.type.Nan;
use mirl.ir.type.Rounding;

# a binary number format as the folder computes in it
# ---
# width:    bits of the encoding
# signed:   the format has a sign bit
# exponent: bits of the exponent field
# fraction: bits of the significand below its leading bit
# implicit: the leading significand bit is not stored
# bias:     the exponent bias
# rounding: the rounding rule its arithmetic applies
# nan:      its not-a-number rule
pub rec Spec {
    width:    u32;
    signed:   bool;
    exponent: u32;
    fraction: u32;
    implicit: bool;
    bias:     i64;
    rounding: Rounding;
    nan:      Nan;
}

# the spec of a number format row, none for an encoding the folder does not read
pub fun spec(r: types.Row) opt[Spec] {
    if (!(sel r.encoding.binary)) { ret opt[Spec].none{}; }
    val b: types.Binary = r.encoding.binary;
    var s: Spec;
    s.width    = r.width;
    s.signed   = b.sign != 0;
    s.exponent = b.exponent;
    s.fraction = b.significand;
    if (!b.implicit) { s.fraction = b.significand - 1; }
    s.implicit = b.implicit;
    s.bias     = b.bias::i64;
    s.rounding = r.rounding;
    s.nan      = r.nan;
    ret opt[Spec].some{s};
}

# the bits of the significand, its leading bit included
pub fun precision(s: *Spec) u32 {
    ret s.fraction + 1;
}

fun exponent_at(s: *Spec) u32 {
    if (s.implicit) { ret s.fraction; }
    ret s.fraction + 1;
}

fun sign_at(s: *Spec) u32 {
    ret exponent_at(s) + s.exponent;
}

fun top_exponent(s: *Spec) u64 {
    ret (1::u64 << s.exponent::u64) - 1;
}

# the kinds of value an encoding holds
tag Class: u8 {
    zero;
    finite;
    infinite;
    nan;
}

# an unpacked value: a finite one is m times two to the e, m holding exactly
# the format's precision
rec Unpacked {
    class:    Class;
    negative: bool;
    m:        Wide;
    e:        i64;
}

fun field(s: *Spec, x: Wide) u64 {
    ret word.mask(word.shr(x, exponent_at(s)), s.exponent)[0];
}

fun unpack(s: *Spec, x: Wide) Unpacked {
    var u: Unpacked;
    u.negative = s.signed && word.bit(x, sign_at(s));
    val e:    u64  = field(s, x);
    val frac: Wide = word.mask(x, s.fraction);
    if (e == top_exponent(s)) {
        if (word.is_zero(frac)) { u.class = Class.infinite{}; }
        or                      { u.class = Class.nan{}; }
        ret u;
    }
    if (e == 0) {
        if (word.is_zero(frac)) {
            u.class = Class.zero{};
            ret u;
        }
        u.m = frac;
        u.e = 1 - s.bias - s.fraction::i64;
    }
    or {
        u.m = word.bit_or(frac, word.shl(word.small(1), s.fraction));
        u.e = e::i64 - s.bias - s.fraction::i64;
    }
    u.class = Class.finite{};
    val n: u32 = word.length(u.m);
    if (n < precision(s)) {
        u.m = word.shl(u.m, precision(s) - n);
        u.e = u.e - (precision(s) - n)::i64;
    }
    ret u;
}

fun encode(s: *Spec, negative: bool, e: u64, frac: Wide) Wide {
    var x: Wide = word.bit_or(word.mask(frac, s.fraction), word.shl(word.small(e), exponent_at(s)));
    if (!s.implicit && e != 0) { x = word.bit_or(x, word.shl(word.small(1), s.fraction)); }
    if (negative && s.signed)  { x = word.bit_or(x, word.shl(word.small(1), sign_at(s))); }
    ret x;
}

fun zero_of(s: *Spec, negative: bool) Wide {
    ret encode(s, negative, 0, word.zero());
}

fun infinity(s: *Spec, negative: bool) Wide {
    ret encode(s, negative, top_exponent(s), word.zero());
}

fun quiet_bit(s: *Spec) Wide {
    if (sel s.nan.ieee) { ret word.shl(word.small(1), s.fraction - 1); }
    ret word.zero();
}

# the canonical quiet nan: positive, the quiet bit alone
fun canonical(s: *Spec) Wide {
    ret encode(s, false, top_exponent(s), quiet_bit(s));
}

fun quiet(s: *Spec, x: Wide) Wide {
    ret word.bit_or(x, quiet_bit(s));
}

fun is_nan(s: *Spec, x: Wide) bool {
    ret field(s, x) == top_exponent(s) && !word.is_zero(word.mask(x, s.fraction));
}

fun sign_bit(s: *Spec) Wide {
    if (!s.signed) { ret word.zero(); }
    ret word.shl(word.small(1), sign_at(s));
}

fun flip(s: *Spec, x: Wide) Wide {
    ret word.bit_xor(x, sign_bit(s));
}

fun increments(r: Rounding, negative: bool, odd: bool, half: bool, rest: bool) bool {
    if (sel r.nearest_even) { ret half && (rest || odd); }
    ret false;
}

# the format's value nearest m times two to the e, by its rounding rule
#
# sticky says bits below m are lost and nonzero, which the caller states only
# when m carries at least two bits past the precision.
fun round(s: *Spec, negative: bool, m: Wide, e: i64, sticky: bool) Wide {
    if (word.is_zero(m) && !sticky) { ret zero_of(s, negative); }
    val p:     i64 = precision(s)::i64;
    val n:     i64 = word.length(m)::i64;
    val least: i64 = 1 - s.bias - s.fraction::i64;
    var q:     i64 = e + n - p;
    if (q < least) { q = least; }
    val shift: i64 = q - e;

    var r:    Wide;
    var half: bool = false;
    var rest: bool = sticky;
    if (shift > 0) {
        val cap: i64 = word.capacity()::i64;
        if (shift > cap) {
            rest = rest || !word.is_zero(m);
        }
        or {
            r    = word.shr(m, shift::u32);
            half = word.bit(m, (shift - 1)::u32);
            rest = rest || !word.is_zero(word.mask(m, (shift - 1)::u32));
        }
    }
    or {
        r = word.shl(m, (0 - shift)::u32);
    }
    if (increments(s.rounding, negative, word.bit(r, 0), half, rest)) { r = word.add(r, word.small(1)); }
    if (word.length(r)::i64 > p) {
        r = word.shr(r, 1);
        q = q + 1;
    }
    if (negative && !s.signed && !word.is_zero(r)) { ret canonical(s); }
    if (word.is_zero(r))                           { ret zero_of(s, negative); }
    if (word.length(r)::i64 < p)                   { ret encode(s, negative, 0, r); }
    val biased: i64 = q + s.fraction::i64 + s.bias;
    if (biased >= top_exponent(s)::i64) { ret infinity(s, negative); }
    ret encode(s, negative, biased::u64, r);
}

# the exact sum of two finite values, or its leading bits and a sticky bit
rec Exact {
    negative: bool;
    m:        Wide;
    e:        i64;
    sticky:   bool;
}

fun sum(na: bool, ma: Wide, ea: i64, nb: bool, mb: Wide, eb: i64) Exact {
    var x:  Exact;
    var an: bool = na;
    var am: Wide = ma;
    var ae: i64  = ea;
    var bn: bool = nb;
    var bm: Wide = mb;
    var be: i64  = eb;
    if (be + word.length(bm)::i64 > ae + word.length(am)::i64) {
        an = nb;
        am = mb;
        ae = eb;
        bn = na;
        bm = ma;
        be = ea;
    }
    if (word.is_zero(bm)) {
        x.negative = an;
        x.m        = am;
        x.e        = ae;
        ret x;
    }
    if (be + word.length(bm)::i64 <= ae - 3) {
        x.negative = an;
        x.m        = word.shl(am, 3);
        x.e        = ae - 3;
        x.sticky   = true;
        if (an != bn) { x.m = word.sub(x.m, word.small(1)); }
        ret x;
    }
    var e: i64 = ae;
    if (be < e) { e = be; }
    val a: Wide = word.shl(am, (ae - e)::u32);
    val b: Wide = word.shl(bm, (be - e)::u32);
    x.e = e;
    if (an == bn) {
        x.negative = an;
        x.m        = word.add(a, b);
        ret x;
    }
    val order: i32 = word.compare(a, b);
    if (order == 0) {
        x.negative = false;
        x.m        = word.zero();
        ret x;
    }
    if (order > 0) {
        x.negative = an;
        x.m        = word.sub(a, b);
    }
    or {
        x.negative = bn;
        x.m        = word.sub(b, a);
    }
    ret x;
}

fun rounded(s: *Spec, x: Exact) Wide {
    ret round(s, x.negative, x.m, x.e, x.sticky);
}

fun first_nan(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a)) { ret quiet(s, a); }
    ret quiet(s, b);
}

fun added(s: *Spec, a: Wide, b: Wide, subtract: bool) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    val x: Unpacked = unpack(s, a);
    var y: Unpacked = unpack(s, b);
    if (subtract) { y.negative = !y.negative; }
    if (sel x.class.infinite) {
        if (sel y.class.infinite && x.negative != y.negative) { ret canonical(s); }
        ret infinity(s, x.negative);
    }
    if (sel y.class.infinite)                 { ret infinity(s, y.negative); }
    if (sel x.class.zero && sel y.class.zero) { ret zero_of(s, x.negative && y.negative); }
    if (sel x.class.zero)                     { ret encode_unpacked(s, y); }
    if (sel y.class.zero)                     { ret a; }
    ret rounded(s, sum(x.negative, x.m, x.e, y.negative, y.m, y.e));
}

fun encode_unpacked(s: *Spec, u: Unpacked) Wide {
    ret round(s, u.negative, u.m, u.e, false);
}

# the sum
pub fun fadd(s: *Spec, a: Wide, b: Wide) Wide {
    ret added(s, a, b, false);
}

# the difference
pub fun fsub(s: *Spec, a: Wide, b: Wide) Wide {
    ret added(s, a, b, true);
}

# the product
pub fun fmul(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    val x:        Unpacked = unpack(s, a);
    val y:        Unpacked = unpack(s, b);
    val negative: bool     = x.negative != y.negative;
    if (sel x.class.infinite || sel y.class.infinite) {
        if (sel x.class.zero || sel y.class.zero) { ret canonical(s); }
        ret infinity(s, negative);
    }
    if (sel x.class.zero || sel y.class.zero) { ret zero_of(s, negative); }
    ret round(s, negative, word.mul(x.m, y.m), x.e + y.e, false);
}

# the quotient
pub fun fdiv(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    val x:        Unpacked = unpack(s, a);
    val y:        Unpacked = unpack(s, b);
    val negative: bool     = x.negative != y.negative;
    if (sel x.class.infinite) {
        if (sel y.class.infinite) { ret canonical(s); }
        ret infinity(s, negative);
    }
    if (sel y.class.infinite) { ret zero_of(s, negative); }
    if (sel y.class.zero) {
        if (sel x.class.zero) { ret canonical(s); }
        ret infinity(s, negative);
    }
    if (sel x.class.zero) { ret zero_of(s, negative); }
    val extra: u32  = precision(s) + 3;
    var r:     Wide;
    val q:     Wide = word.divide(word.shl(x.m, extra), y.m, ?r);
    ret round(s, negative, q, x.e - y.e - extra::i64, !word.is_zero(r));
}

# the remainder of the quotient truncated toward zero, with the sign of the dividend
pub fun frem(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    val x: Unpacked = unpack(s, a);
    val y: Unpacked = unpack(s, b);
    if (sel x.class.infinite || sel y.class.zero) { ret canonical(s); }
    if (sel x.class.zero || sel y.class.infinite) { ret a; }
    if (x.e < y.e)                                { ret a; }
    var r:   Wide;
    var off: i64 = x.e - y.e;
    word.divide(x.m, y.m, ?r);
    for (off > 0) {
        r = word.shl(r, 1);
        if (word.compare(r, y.m) >= 0) { r = word.sub(r, y.m); }
        off = off - 1;
    }
    ret round(s, x.negative, r, y.e, false);
}

fun ordered_min(s: *Spec, a: Wide, b: Wide, least: bool) Wide {
    val x: Unpacked = unpack(s, a);
    val y: Unpacked = unpack(s, b);
    if (sel x.class.zero && sel y.class.zero) {
        if (x.negative == least) { ret a; }
        ret b;
    }
    val order: i32 = compare_values(s, a, b);
    if ((order <= 0) == least) { ret a; }
    ret b;
}

# the lesser, a nan when either is, and negative zero below positive zero
pub fun fmin(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    ret ordered_min(s, a, b, true);
}

# the greater, a nan when either is, and positive zero above negative zero
pub fun fmax(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    ret ordered_min(s, a, b, false);
}

# the lesser, the other operand when one is a nan
pub fun fminnum(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) && is_nan(s, b)) { ret first_nan(s, a, b); }
    if (is_nan(s, a))                 { ret b; }
    if (is_nan(s, b))                 { ret a; }
    ret ordered_min(s, a, b, true);
}

# the greater, the other operand when one is a nan
pub fun fmaxnum(s: *Spec, a: Wide, b: Wide) Wide {
    if (is_nan(s, a) && is_nan(s, b)) { ret first_nan(s, a, b); }
    if (is_nan(s, a))                 { ret b; }
    if (is_nan(s, b))                 { ret a; }
    ret ordered_min(s, a, b, false);
}

# the first operand with the sign of the second
pub fun fcopysign(s: *Spec, a: Wide, b: Wide) Wide {
    val sign: Wide = sign_bit(s);
    ret word.bit_or(word.bit_and(a, word.bit_not(sign)), word.bit_and(b, sign));
}

# the sign flipped
pub fun fneg(s: *Spec, a: Wide) Wide {
    ret flip(s, a);
}

# the sign cleared
pub fun fabs(s: *Spec, a: Wide) Wide {
    ret word.bit_and(a, word.bit_not(sign_bit(s)));
}

# the square root
pub fun fsqrt(s: *Spec, a: Wide) Wide {
    if (is_nan(s, a)) { ret quiet(s, a); }
    val x: Unpacked = unpack(s, a);
    if (sel x.class.zero)     { ret a; }
    if (x.negative)           { ret canonical(s); }
    if (sel x.class.infinite) { ret a; }
    var k: i64 = precision(s)::i64 + 4;
    if ((x.e - k) % 2 != 0) { k = k + 1; }
    var r:  Wide;
    val rt: Wide = word.root(word.shl(x.m, k::u32), ?r);
    ret round(s, false, rt, (x.e - k) / 2, !word.is_zero(r));
}

# first times second plus third, rounded once
pub fun fma(s: *Spec, a: Wide, b: Wide, c: Wide) Wide {
    if (is_nan(s, a) || is_nan(s, b)) { ret first_nan(s, a, b); }
    if (is_nan(s, c))                 { ret quiet(s, c); }
    val x:        Unpacked = unpack(s, a);
    val y:        Unpacked = unpack(s, b);
    val z:        Unpacked = unpack(s, c);
    val negative: bool     = x.negative != y.negative;
    if (sel x.class.infinite || sel y.class.infinite) {
        if (sel x.class.zero || sel y.class.zero)           { ret canonical(s); }
        if (sel z.class.infinite && z.negative != negative) { ret canonical(s); }
        ret infinity(s, negative);
    }
    if (sel z.class.infinite) { ret c; }
    if (sel x.class.zero || sel y.class.zero) {
        if (sel z.class.zero) { ret zero_of(s, negative && z.negative); }
        ret c;
    }
    val pm: Wide = word.mul(x.m, y.m);
    val pe: i64  = x.e + y.e;
    if (sel z.class.zero) { ret round(s, negative, pm, pe, false); }
    ret rounded(s, sum(negative, pm, pe, z.negative, z.m, z.e));
}

# how an integral rounding breaks a fraction
tag Toward: u8 {
    down;
    up;
    zero;
    even;
}

fun integral(s: *Spec, a: Wide, mode: Toward) Wide {
    if (is_nan(s, a)) { ret quiet(s, a); }
    val x: Unpacked = unpack(s, a);
    if (!(sel x.class.finite) || x.e >= 0) { ret a; }
    val shift: i64  = 0 - x.e;
    var k:     Wide;
    var half:  bool = false;
    var rest:  bool = false;
    if (shift > word.capacity()::i64) {
        rest = true;
    }
    or {
        k    = word.shr(x.m, shift::u32);
        half = word.bit(x.m, (shift - 1)::u32);
        rest = !word.is_zero(word.mask(x.m, (shift - 1)::u32));
    }
    var up: bool = false;
    if (sel mode.down) { up = x.negative && (half || rest); }
    or (sel mode.up)   { up = !x.negative && (half || rest); }
    or (sel mode.even) { up = half && (rest || word.bit(k, 0)); }
    if (up)            { k = word.add(k, word.small(1)); }
    ret round(s, x.negative, k, 0, false);
}

# rounded toward negative infinity
pub fun ffloor(s: *Spec, a: Wide) Wide {
    ret integral(s, a, Toward.down{});
}

# rounded toward positive infinity
pub fun fceil(s: *Spec, a: Wide) Wide {
    ret integral(s, a, Toward.up{});
}

# rounded toward zero
pub fun fint(s: *Spec, a: Wide) Wide {
    ret integral(s, a, Toward.zero{});
}

# rounded to the nearest integer, ties to even
pub fun fnearest(s: *Spec, a: Wide) Wide {
    ret integral(s, a, Toward.even{});
}

# the order of two values that are not nans: -1 below, 0 equal, 1 above
fun compare_values(s: *Spec, a: Wide, b: Wide) i32 {
    val x: Unpacked = unpack(s, a);
    val y: Unpacked = unpack(s, b);
    if (sel x.class.zero && sel y.class.zero) { ret 0; }
    val ma: Wide = word.mask(a, sign_at(s));
    val mb: Wide = word.mask(b, sign_at(s));
    val an: bool = x.negative && !(sel x.class.zero);
    val bn: bool = y.negative && !(sel y.class.zero);
    if (an && !bn) { ret -1; }
    if (bn && !an) { ret 1; }
    val order: i32 = word.compare(ma, mb);
    if (an) { ret 0 - order; }
    ret order;
}

# how two values order
# ---
# unordered: either is a nan
# less:      the first is below the second
# equal:     they are equal, a zero equal to a zero of either sign
# greater:   the first is above the second
pub tag Ordering: u8 {
    unordered;
    less;
    equal;
    greater;
}

# how two values order
pub fun order(s: *Spec, a: Wide, b: Wide) Ordering {
    if (is_nan(s, a) || is_nan(s, b)) { ret Ordering.unordered{}; }
    val c: i32 = compare_values(s, a, b);
    if (c < 0)  { ret Ordering.less{}; }
    if (c == 0) { ret Ordering.equal{}; }
    ret Ordering.greater{};
}

# a value in one format converted to another, rounded once
#
# a nan keeps its sign and the top of its payload, quieted.
pub fun convert(from: *Spec, to: *Spec, a: Wide) Wide {
    if (is_nan(from, a)) {
        val payload: Wide = word.mask(a, from.fraction);
        var moved:   Wide = word.zero();
        if (to.fraction >= from.fraction) { moved = word.shl(payload, to.fraction - from.fraction); }
        or                                { moved = word.shr(payload, from.fraction - to.fraction); }
        val negative: bool = from.signed && word.bit(a, sign_at(from));
        ret quiet(to, encode(to, negative, top_exponent(to), moved));
    }
    val x: Unpacked = unpack(from, a);
    if (sel x.class.infinite) { ret infinity(to, x.negative); }
    if (sel x.class.zero)     { ret zero_of(to, x.negative); }
    ret round(to, x.negative, x.m, x.e, false);
}

# an integer of a width converted to the format, rounded once
pub fun from_integer(to: *Spec, a: Wide, width: u32, signed: bool) Wide {
    val negative: bool = signed && word.negative(a, width);
    var m:        Wide = word.mask(a, width);
    if (negative) { m = word.neg_at(word.sext(a, width), width + 1); }
    ret round(to, negative, m, 0, false);
}

# a value converted to an integer of a width: truncated toward zero, saturated
# at the width's range, and zero for a nan
pub fun to_integer(from: *Spec, a: Wide, width: u32, signed: bool) Wide {
    if (is_nan(from, a)) { ret word.zero(); }
    val x: Unpacked = unpack(from, a);
    if (sel x.class.zero) { ret word.zero(); }
    var high: Wide = word.ones(width);
    var low:  Wide = word.zero();
    if (signed) {
        high = word.ones(width - 1);
        low  = word.least(width);
    }
    if (sel x.class.infinite) {
        if (x.negative) { ret low; }
        ret high;
    }
    var k: Wide;
    if (x.e >= 0) {
        if (word.length(x.m)::i64 + x.e > width::i64) {
            if (x.negative) { ret low; }
            ret high;
        }
        k = word.shl(x.m, x.e::u32);
    }
    or (0 - x.e < word.capacity()::i64) {
        k = word.shr(x.m, (0 - x.e)::u32);
    }
    if (x.negative) {
        if (!signed)                  { ret word.zero(); }
        if (word.compare(k, low) > 0) { ret low; }
        ret word.neg_at(k, width);
    }
    if (word.compare(k, high) > 0) { ret high; }
    ret k;
}
