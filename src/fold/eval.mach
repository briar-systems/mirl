        Case{op: opcodes.FDEMOTE, ty: F64, to: F16, n: 1, x: [3][8]u64{[8]u64{0x7ff4000000000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x7f00, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.FDEMOTE, ty: F64, to: F32, n: 1, x: [3][8]u64{[8]u64{0x7e37e43c8800759c, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x7f800000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.BITCAST, ty: F32, to: I32, n: 1, x: [3][8]u64{[8]u64{0x3f800000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x3f800000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DECLASSIFY, ty: F64, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x400921fb54442d18, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x400921fb54442d18, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.ADD, ty: V_I32X4, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x1, 0x2, 0x3, 0x4, 0x0, 0x0, 0x0, 0x0}, [8]u64{0xffffffff, 0x1, 0x1, 0x1, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x3, 0x4, 0x5, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.LT_S, ty: V_I8X4, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x80, 0x1, 0x2, 0x3, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.BITCAST, ty: V_I8X4, to: I32, n: 1, x: [3][8]u64{[8]u64{0x11, 0x22, 0x33, 0x44, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x44332211, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REDUCE_ADD, ty: V_I32X4, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x1, 0x2, 0x3, 0xffffffff, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x5, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REDUCE_UMAX, ty: V_I8X4, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x1, 0x80, 0x3, 0x4, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x80, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REDUCE_SMAX, ty: V_I8X4, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x1, 0x80, 0x3, 0x4, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x4, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REDUCE_FADD_SEQ, ty: V_F32X4, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x4b800000, 0x3f800000, 0x3f800000, 0x3f800000, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x4b800000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REDUCE_FADD_ANY, ty: V_F32X4, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x4b800000, 0x3f800000, 0x3f800000, 0x3f800000, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x4b800000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
    };

    var i: usize = 0;
    for (i < $length_of([99]Case)) {
        var c:    Case    = cases[i];
        var laid: Laid;
        val got:  Outcome = fold(?a, ?t, lay(?t, ?k, ?c, PUBLIC, ?laid));
        if (sel got.refused) { ret (1 + i)::i32; }
        val done: Folded = got.folded;
        var ok:   bool   = done.results.size >= 1 && matches(done.results.data[0], c.want[0]);
        if (done.results.size == 2) { ok = ok && matches(done.results.data[1], c.want[1]); }
        release(?a, done);
        if (!ok) { ret (101 + i)::i32; }
        i = i + 1;
    }
    ret 0;
}

fun refused_by(o: Outcome, tr: Trap) bool {
    if (!(sel o.refused)) { ret false; }
    val r: Refusal = o.refused;
    if (!(sel r.trap)) { ret false; }
    val got: Trap = r.trap;
    if (sel tr.zero)     { ret sel got.zero && got.zero == tr.zero; }
    if (sel tr.overflow) { ret sel got.overflow; }
    if (sel tr.exceeds)  { ret sel got.exceeds; }
    if (sel tr.always)   { ret sel got.always; }
    ret false;
}

test fold__trapping_operation_is_refused_with_its_trap {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var k: Kit = kit(?t);

    # every trap the table states, at several widths, and a lane of a vector
    val widths: [4]u32 = [4]u32{I1, I8, I512, V_I32X4};
    var i:      u32    = 0;
    for (i < opcodes.rows()) {
        val op: Opcode   = Opcode{index: i};
        val rw: opt[Row] = opcodes.row(op);
        if (sel rw.none) { ret 1; }
        var r: Row = rw.some;
        var j: u32 = 0;
        for (j < $length_of(Traps)) {
            val tr: Trap = r.effects.traps[j];
            if (sel tr.always) {
                var c:    Case;
                var laid: Laid;
                c.op = op;
                c.to = NONE;
                if (!refused_by(fold(?a, ?t, lay(?t, ?k, ?c, PUBLIC, ?laid)), tr)) { ret 2; }
            }
            var w: u32 = 0;
            for (w < 4 && (sel tr.zero || sel tr.overflow || sel tr.exceeds)) {
                var c: Case;
                c.op = op;
                c.ty = widths[w];
                c.to = NONE;
                c.n  = opcodes.fixed(?r);
                var lanes: u32 = 1;
                if (widths[w] == V_I32X4) { lanes = 4; }
                var l: u32 = 0;
                for (l < lanes) {
                    var o: u32 = 0;
                    for (o < c.n) {
                        c.x[o][l] = 1;
                        o         = o + 1;
                    }
                    l = l + 1;
                }
                if (sel tr.zero) {
                    if (widths[w] == V_I32X4) { c.x[tr.zero][2] = 0; }
                    or                        { c.x[tr.zero][0] = 0; }
                }
                if (sel tr.exceeds) {
                    l = 0;
                    for (l < lanes) {
                        c.x[tr.exceeds.dividend][l] = 0;
                        l                           = l + 1;
                    }
                    if (widths[w] == V_I32X4) { c.x[tr.exceeds.dividend][1] = 1; }
                    or                        { c.x[tr.exceeds.dividend][0] = 1; }
                }
                if (sel tr.overflow) {
                    val bits:  res[u32, Refusal] = bits_of(?t, k[widths[w]]);
                    var width: u32               = 32;
                    if (sel bits.ok) { width = bits.ok; }
                    val least: Wide = word.least(width);
                    val ones:  Wide = word.ones(width);
                    if (widths[w] == V_I32X4) {
                        c.x[tr.overflow.dividend][1] = least[0];
                        c.x[tr.overflow.divisor][1]  = ones[0];
                    }
                    or {
                        l = 0;
                        for (l < 8) {
                            c.x[tr.overflow.dividend][l] = least[l];
                            c.x[tr.overflow.divisor][l]  = ones[l];
                            l                            = l + 1;
                        }
                    }
                }
                var laid: Laid;
                if (!refused_by(fold(?a, ?t, lay(?t, ?k, ?c, PUBLIC, ?laid)), tr)) { ret (10 + i)::i32; }
                w = w + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun secret_of(a: *allocator.Allocator, t: *types.Table, k: *Kit, op: Opcode, ty: u32, n: u32, secret: [3]bool) i32 {
    var c:    Case;
    var laid: Laid;
    c.op      = op;
    c.ty      = ty;
    c.to      = NONE;
    c.n       = n;
    c.x[0][0] = 1;
    c.x[1][0] = 2;
    val got: Outcome = fold(a, t, lay(t, k, ?c, secret, ?laid));
    if (sel got.refused) { ret -1; }
    val s: bool = got.folded.secret;
    release(a, got.folded);
    if (s) { ret 1; }
    ret 0;
}

test fold__secret_operand_gives_secret_result {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var k: Kit = kit(?t);

    val second: [3]bool = [3]bool{false, true, false};
    val first:  [3]bool = [3]bool{true, false, false};
    if (secret_of(?a, ?t, ?k, opcodes.ADD, I512, 2, PUBLIC) != 0)         { ret 1; }
    if (secret_of(?a, ?t, ?k, opcodes.ADD, I512, 2, second) != 1)         { ret 2; }
    if (secret_of(?a, ?t, ?k, opcodes.FMUL, F16, 2, first) != 1)          { ret 3; }
    if (secret_of(?a, ?t, ?k, opcodes.LT_U, V_I32X4, 2, second) != 1)     { ret 4; }
    if (secret_of(?a, ?t, ?k, opcodes.REDUCE_ADD, V_I8X4, 1, first) != 1) { ret 5; }
    if (secret_of(?a, ?t, ?k, opcodes.DECLASSIFY, I64, 1, first) != 0)    { ret 6; }
    ret 0;
}
