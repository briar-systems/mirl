# the folder: one operation of the opcode table evaluated on constants
#
# the row decides everything but the arithmetic: its rules type the request
# through the one checker, its traps refuse what would trap, its overshift and
# order settle shifts past the width and nan comparisons, and its secrecy rule
# marks the results. the row's entry in the evaluation table does the rest.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.fold.float;
use mirl.fold.float.Spec;
use mirl.fold.record.Folded;
use mirl.fold.record.Operand;
use mirl.fold.record.Outcome;
use mirl.fold.record.Refusal;
use mirl.fold.record.Request;
use mirl.fold.record.Value;
use mirl.fold.record.release;
use mirl.fold.table;
use mirl.fold.table.Entry;
use mirl.fold.table.Relation;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.constant.Bits;
use opcodes: mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Overshift;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Trap;
use mirl.ir.opcode.Traps;
use checker: mirl.ir.opcode.check;
use types:   mirl.ir.type;
use mirl.ir.type.Type;
use mirl.slice;

fun refuse(r: Refusal) Outcome {
    ret Outcome.refused{r};
}

fun take[T](a: *allocator.Allocator, n: usize) res[Slice[T], allocator.Error] {
    var s: Slice[T];
    s.data = nil;
    s.size = n;
    if (n == 0) { ret res[Slice[T], allocator.Error].ok{s}; }
    val got: res[*T, allocator.Error] = allocator.zallocate[T](a, n);
    if (sel got.err) { ret res[Slice[T], allocator.Error].err{got.err}; }
    s.data = got.ok;
    ret res[Slice[T], allocator.Error].ok{s};
}

# a type read as its lanes: a vector's lane count and lane type, a scalar one lane of itself
rec Lanes {
    count: u32;
    lane:  Type;
}

fun lanes_of(t: *types.Table, ty: Type) res[Lanes, Refusal] {
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err)       { ret res[Lanes, Refusal].err{Refusal.types{s.err}}; }
    if (sel s.ok.vector) { ret res[Lanes, Refusal].ok{Lanes{count: s.ok.vector.lanes, lane: s.ok.vector.element}}; }
    ret res[Lanes, Refusal].ok{Lanes{count: 1, lane: ty}};
}

# the bits of a lane type: an integer's width or a float format's
pub fun bits_of(t: *types.Table, lane: Type) res[u32, Refusal] {
    val s: res[types.Shape, types.Error] = types.shape(t, lane);
    if (sel s.err)        { ret res[u32, Refusal].err{Refusal.types{s.err}}; }
    if (sel s.ok.integer) { ret res[u32, Refusal].ok{s.ok.integer.width}; }
    if (sel s.ok.float) {
        val r: opt[types.Row] = types.row(s.ok.float.format);
        if (sel r.none) { ret res[u32, Refusal].err{Refusal.types{types.Error.format{s.ok.float.format}}}; }
        ret res[u32, Refusal].ok{r.some.width};
    }
    ret res[u32, Refusal].err{Refusal.unfoldable{}};
}

fun spec_of(t: *types.Table, lane: Type) res[Spec, Refusal] {
    val f: res[types.Format, types.Error] = types.format(t, lane);
    if (sel f.err) { ret res[Spec, Refusal].err{Refusal.types{f.err}}; }
    val r: opt[types.Row] = types.row(f.ok);
    if (sel r.none) { ret res[Spec, Refusal].err{Refusal.types{types.Error.format{f.ok}}}; }
    val s: opt[Spec] = float.spec(r.some);
    if (sel s.none) { ret res[Spec, Refusal].err{Refusal.unfoldable{}}; }
    ret res[Spec, Refusal].ok{s.some};
}

# what the evaluation reads: the row, the request and its operands lane by lane
rec Frame {
    a:       *allocator.Allocator;
    t:       *types.Table;
    row:     Row;
    req:     Request;
    x:       Slice[Slice[Wide]];
    widths:  Slice[u32];
    results: Slice[Type];
    got:     [2]Slice[Wide];
}

fun release_frame(f: *Frame) {
    var i: usize = 0;
    for (i < f.x.size) {
        slice.release[Wide](f.a, f.x.data[i]);
        i = i + 1;
    }
    slice.release[Slice[Wide]](f.a, f.x);
    slice.release[u32](f.a, f.widths);
    slice.release[Wide](f.a, f.got[0]);
    slice.release[Wide](f.a, f.got[1]);
}

# read each operand into lanes, refusing one whose bits do not fit its type
fun read(f: *Frame) err[Refusal] {
    val n: usize                                    = f.req.operands.size;
    val x: res[Slice[Slice[Wide]], allocator.Error] = take[Slice[Wide]](f.a, n);
    if (sel x.err) { ret err[Refusal].err{Refusal.alloc{x.err}}; }
    f.x = x.ok;
    val w: res[Slice[u32], allocator.Error] = take[u32](f.a, n);
    if (sel w.err) { ret err[Refusal].err{Refusal.alloc{w.err}}; }
    f.widths = w.ok;
    var i: usize = 0;
    for (i < n) {
        val v:  Value               = f.req.operands.data[i].value;
        val ln: res[Lanes, Refusal] = lanes_of(f.t, v.type);
        if (sel ln.err) { ret err[Refusal].err{ln.err}; }
        val bits: res[u32, Refusal] = bits_of(f.t, ln.ok.lane);
        if (sel bits.err) { ret err[Refusal].err{bits.err}; }
        f.widths.data[i] = bits.ok;
        if (v.lanes.size != ln.ok.count::usize) { ret err[Refusal].err{Refusal.operand{i::u32}}; }
        val lanes: res[Slice[Wide], allocator.Error] = take[Wide](f.a, v.lanes.size);
        if (sel lanes.err) { ret err[Refusal].err{Refusal.alloc{lanes.err}}; }
        f.x.data[i] = lanes.ok;
        var l: usize = 0;
        for (l < v.lanes.size) {
            val b: Bits = v.lanes.data[l];
            if (!types.same(b.type, ln.ok.lane))                { ret err[Refusal].err{Refusal.operand{i::u32}}; }
            if (b.words.size != word.words_for(bits.ok)::usize) { ret err[Refusal].err{Refusal.operand{i::u32}}; }
            if (b.words.size > word.words()::usize)             { ret err[Refusal].err{Refusal.operand{i::u32}}; }
            val k: Wide = word.of(b.words);
            if (word.compare(word.mask(k, bits.ok), k) != 0) { ret err[Refusal].err{Refusal.operand{i::u32}}; }
            f.x.data[i].data[l] = k;
            l                   = l + 1;
        }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

fun any_zero(lanes: Slice[Wide]) bool {
    var l: usize = 0;
    for (l < lanes.size) {
        if (word.is_zero(lanes.data[l])) { ret true; }
        l = l + 1;
    }
    ret false;
}

fun any_overflow(dividend: Slice[Wide], divisor: Slice[Wide], width: u32) bool {
    var l: usize = 0;
    for (l < dividend.size && l < divisor.size) {
        val least: bool = word.compare(dividend.data[l], word.least(width)) == 0;
        val ones:  bool = word.compare(divisor.data[l], word.ones(width)) == 0;
        if (least && ones) { ret true; }
        l = l + 1;
    }
    ret false;
}

fun any_exceeding(high: Slice[Wide], divisor: Slice[Wide], width: u32) bool {
    var l: usize = 0;
    for (l < high.size && l < divisor.size) {
        if (word.compare(word.mask(high.data[l], width), word.mask(divisor.data[l], width)) >= 0) { ret true; }
        l = l + 1;
    }
    ret false;
}

# the first trap of the row the operands would take
fun trapped(f: *Frame) opt[Trap] {
    var i: u32 = 0;
    for (i < $length_of(Traps)) {
        val tr: Trap = f.row.effects.traps[i];
        if (sel tr.zero && any_zero(f.x.data[tr.zero])) { ret opt[Trap].some{tr}; }
        if (sel tr.overflow) {
            val d: opcodes.Division = tr.overflow;
            if (any_overflow(f.x.data[d.dividend], f.x.data[d.divisor], f.widths.data[d.dividend])) { ret opt[Trap].some{tr}; }
        }
        if (sel tr.exceeds) {
            val d: opcodes.Division = tr.exceeds;
            if (any_exceeding(f.x.data[d.dividend], f.x.data[d.divisor], f.widths.data[d.divisor])) { ret opt[Trap].some{tr}; }
        }
        i = i + 1;
    }
    ret opt[Trap].none{};
}

fun result_lanes(f: *Frame, j: usize) res[Lanes, Refusal] {
    ret lanes_of(f.t, f.results.data[j]);
}

fun overshift(o: Overshift, x: Wide, width: u32) Wide {
    if (sel o.sign && word.negative(x, width)) { ret word.ones(width); }
    ret word.zero();
}

fun holds(r: Relation, order: i32) bool {
    if (order < 0)  { ret r.less; }
    if (order == 0) { ret r.equal; }
    ret r.greater;
}

fun flag(b: bool) Wide {
    if (b) { ret word.small(1); }
    ret word.zero();
}

fun lane_immediate(f: *Frame, at: usize) res[u32, Refusal] {
    if (at < f.req.immediates.size) {
        val im: Immediate = f.req.immediates.data[at];
        if (sel im.lane) { ret res[u32, Refusal].ok{im.lane}; }
    }
    ret res[u32, Refusal].err{Refusal.check{checker.Error.immediate{at::u32}}};
}

fun result_spec(f: *Frame) res[Spec, Refusal] {
    val ln: res[Lanes, Refusal] = result_lanes(f, 0);
    if (sel ln.err) { ret res[Spec, Refusal].err{ln.err}; }
    ret spec_of(f.t, ln.ok.lane);
}

fun result_width(f: *Frame) res[u32, Refusal] {
    val ln: res[Lanes, Refusal] = result_lanes(f, 0);
    if (sel ln.err) { ret res[u32, Refusal].err{ln.err}; }
    ret bits_of(f.t, ln.ok.lane);
}

fun operand_spec(f: *Frame) res[Spec, Refusal] {
    val ln: res[Lanes, Refusal] = lanes_of(f.t, f.req.operands.data[0].value.type);
    if (sel ln.err) { ret res[Spec, Refusal].err{ln.err}; }
    ret spec_of(f.t, ln.ok.lane);
}

# the same bits laid lane after lane, the first lane lowest
fun recast(f: *Frame, out: Slice[Wide], width: u32) {
    val src:  Slice[Wide] = f.x.data[0];
    val from: u32         = f.widths.data[0];
    var l:    usize       = 0;
    for (l < out.size) {
        var r: Wide;
        var b: u32 = 0;
        for (b < width) {
            val g: u32 = l::u32 * width + b;
            if (word.bit(src.data[g / from], g % from)) { r[b / 64] = r[b / 64] | (1::u64 << (b % 64)::u64); }
            b = b + 1;
        }
        out.data[l] = r;
        l           = l + 1;
    }
}

# evaluate the entry into the result lanes
fun evaluate(f: *Frame, e: Entry) err[Refusal] {
    var j: usize = 0;
    for (j < f.results.size) {
        val ln: res[Lanes, Refusal] = result_lanes(f, j);
        if (sel ln.err) { ret err[Refusal].err{ln.err}; }
        val got: res[Slice[Wide], allocator.Error] = take[Wide](f.a, ln.ok.count::usize);
        if (sel got.err) { ret err[Refusal].err{Refusal.alloc{got.err}}; }
        f.got[j] = got.ok;
        j        = j + 1;
    }
    val out: Slice[Wide] = f.got[0];
    val n:   usize       = out.size;
    var x0:  Slice[Wide];
    var x1:  Slice[Wide];
    var x2:  Slice[Wide];
    var w:   u32         = 0;
    if (f.x.size > 0) {
        x0 = f.x.data[0];
        w  = f.widths.data[0];
    }
    if (f.x.size > 1) { x1 = f.x.data[1]; }
    if (f.x.size > 2) { x2 = f.x.data[2]; }
    var l: usize = 0;

    if (sel e.unary) {
        for (l < n) {
            out.data[l] = e.unary(x0.data[l], w);
            l           = l + 1;
        }
    }
    or (sel e.binary) {
        for (l < n) {
            out.data[l] = e.binary(x0.data[l], x1.data[l], w);
            l           = l + 1;
        }
    }
    or (sel e.shift) {
        for (l < n) {
            val count: Wide = x1.data[l];
            if (word.compare(count, word.small(w::u64)) >= 0) { out.data[l] = overshift(f.row.overshift, x0.data[l], w); }
            or                                                { out.data[l] = e.shift(x0.data[l], count[0]::u32, w); }
            l = l + 1;
        }
    }
    or (sel e.overflow) {
        for (l < n) {
            var over: bool = false;
            out.data[l]      = e.overflow(x0.data[l], x1.data[l], w, ?over);
            f.got[1].data[l] = flag(over);
            l                = l + 1;
        }
    }
    or (sel e.long) {
        for (l < n) {
            var rem: Wide;
            out.data[l]      = e.long(x0.data[l], x1.data[l], x2.data[l], w, ?rem);
            f.got[1].data[l] = rem;
            l                = l + 1;
        }
    }
    or (sel e.compare) {
        for (l < n) {
            var order: i32 = 0;
            if (e.compare.signed) { order = word.compare_signed(x0.data[l], x1.data[l], w); }
            or                    { order = word.compare(x0.data[l], x1.data[l]); }
            out.data[l] = flag(holds(e.compare.relation, order));
            l           = l + 1;
        }
    }
    or (sel e.reduce) {
        var acc: Wide = x0.data[0];
        l = 1;
        for (l < x0.size) {
            acc = e.reduce(acc, x0.data[l], w);
            l   = l + 1;
        }
        out.data[0] = acc;
    }
    or (sel e.resize) {
        val to: res[u32, Refusal] = result_width(f);
        if (sel to.err) { ret err[Refusal].err{to.err}; }
        for (l < n) {
            out.data[l] = e.resize(x0.data[l], w, to.ok);
            l           = l + 1;
        }
    }
    or (sel e.float_unary) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            out.data[l] = e.float_unary(?sp, x0.data[l]);
            l           = l + 1;
        }
    }
    or (sel e.float_binary) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            out.data[l] = e.float_binary(?sp, x0.data[l], x1.data[l]);
            l           = l + 1;
        }
    }
    or (sel e.float_ternary) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            out.data[l] = e.float_ternary(?sp, x0.data[l], x1.data[l], x2.data[l]);
            l           = l + 1;
        }
    }
    or (sel e.float_compare) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            val o: float.Ordering = float.order(?sp, x0.data[l], x1.data[l]);
            var t: bool           = false;
            if (sel o.unordered) { t = sel f.row.order.unordered; }
            or (sel o.less)      { t = e.float_compare.less; }
            or (sel o.equal)     { t = e.float_compare.equal; }
            or                   { t = e.float_compare.greater; }
            out.data[l] = flag(t);
            l           = l + 1;
        }
    }
    or (sel e.float_reduce) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp:  Spec = s.ok;
        var acc: Wide = x0.data[0];
        l = 1;
        for (l < x0.size) {
            acc = e.float_reduce(?sp, acc, x0.data[l]);
            l   = l + 1;
        }
        out.data[0] = acc;
    }
    or (sel e.to_float) {
        val s: res[Spec, Refusal] = result_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            out.data[l] = float.from_integer(?sp, x0.data[l], w, e.to_float);
            l           = l + 1;
        }
    }
    or (sel e.to_integer) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        val to: res[u32, Refusal] = result_width(f);
        if (sel to.err) { ret err[Refusal].err{to.err}; }
        var sp: Spec = s.ok;
        for (l < n) {
            out.data[l] = float.to_integer(?sp, x0.data[l], to.ok, e.to_integer);
            l           = l + 1;
        }
    }
    or (sel e.reformat) {
        val s: res[Spec, Refusal] = operand_spec(f);
        if (sel s.err) { ret err[Refusal].err{s.err}; }
        val d: res[Spec, Refusal] = result_spec(f);
        if (sel d.err) { ret err[Refusal].err{d.err}; }
        var from: Spec = s.ok;
        var to:   Spec = d.ok;
        for (l < n) {
            out.data[l] = float.convert(?from, ?to, x0.data[l]);
            l           = l + 1;
        }
    }
    or (sel e.bitcast) {
        val to: res[u32, Refusal] = result_width(f);
        if (sel to.err) { ret err[Refusal].err{to.err}; }
        recast(f, out, to.ok);
    }
    or (sel e.select) {
        for (l < n) {
            if (word.is_zero(x0.data[l])) { out.data[l] = x2.data[l]; }
            or                            { out.data[l] = x1.data[l]; }
            l = l + 1;
        }
    }
    or (sel e.identity) {
        for (l < n) {
            out.data[l] = x0.data[l];
            l           = l + 1;
        }
    }
    or (sel e.splat) {
        for (l < n) {
            out.data[l] = x0.data[0];
            l           = l + 1;
        }
    }
    or (sel e.build) {
        for (l < n) {
            out.data[l] = f.x.data[l].data[0];
            l           = l + 1;
        }
    }
    or (sel e.shuffle) {
        val im: Immediate = f.req.immediates.data[1];
        if (!(sel im.lanes)) { ret err[Refusal].err{Refusal.check{checker.Error.immediate{1}}}; }
        for (l < n) {
            val k: usize = im.lanes.data[l]::usize;
            if (k < x0.size) { out.data[l] = x0.data[k]; }
            or               { out.data[l] = x1.data[k - x0.size]; }
            l = l + 1;
        }
    }
    or (sel e.extract) {
        val at: res[u32, Refusal] = lane_immediate(f, 0);
        if (sel at.err) { ret err[Refusal].err{at.err}; }
        out.data[0] = x0.data[at.ok];
    }
    or (sel e.insert) {
        val at: res[u32, Refusal] = lane_immediate(f, 0);
        if (sel at.err) { ret err[Refusal].err{at.err}; }
        for (l < n) {
            out.data[l] = x0.data[l];
            l           = l + 1;
        }
        out.data[at.ok] = x1.data[0];
    }
    or {
        ret err[Refusal].err{Refusal.unfoldable{}};
    }
    ret err[Refusal].ok{};
}

# fill the result values, their bits copied from the evaluated lanes
fun fill(f: *Frame, done: *Folded) err[Refusal] {
    val vs: res[Slice[Value], allocator.Error] = take[Value](f.a, f.results.size);
    if (sel vs.err) { ret err[Refusal].err{Refusal.alloc{vs.err}}; }
    done.results = vs.ok;
    var j: usize = 0;
    for (j < f.results.size) {
        val ln: res[Lanes, Refusal] = result_lanes(f, j);
        if (sel ln.err) { ret err[Refusal].err{ln.err}; }
        val bits: res[u32, Refusal] = bits_of(f.t, ln.ok.lane);
        if (sel bits.err) { ret err[Refusal].err{bits.err}; }
        val lanes: res[Slice[Bits], allocator.Error] = take[Bits](f.a, ln.ok.count::usize);
        if (sel lanes.err) { ret err[Refusal].err{Refusal.alloc{lanes.err}}; }
        done.results.data[j] = Value{type: f.results.data[j], lanes: lanes.ok};
        val size: usize = word.words_for(bits.ok)::usize;
        var l:    usize = 0;
        for (l < lanes.ok.size) {
            val ws: res[Slice[u64], allocator.Error] = take[u64](f.a, size);
            if (sel ws.err) { ret err[Refusal].err{Refusal.alloc{ws.err}}; }
            val k: Wide  = word.mask(f.got[j].data[l], bits.ok);
            var i: usize = 0;
            for (i < size) {
                ws.ok.data[i] = k[i];
                i             = i + 1;
            }
            lanes.ok.data[l] = Bits{type: ln.ok.lane, words: ws.ok};
            l                = l + 1;
        }
        j = j + 1;
    }
    ret err[Refusal].ok{};
}

# type the request by the one checker, giving its result types and whether they are secret
fun typed(f: *Frame, out: *vector.Vector[Type]) res[bool, Refusal] {
    val n:  usize                             = f.req.operands.size;
    val ty: res[Slice[Type], allocator.Error] = take[Type](f.a, n);
    if (sel ty.err) { ret res[bool, Refusal].err{Refusal.alloc{ty.err}}; }
    fin { slice.release[Type](f.a, ty.ok); }
    val sc: res[Slice[bool], allocator.Error] = take[bool](f.a, n);
    if (sel sc.err) { ret res[bool, Refusal].err{Refusal.alloc{sc.err}}; }
    fin { slice.release[bool](f.a, sc.ok); }
    var i: usize = 0;
    for (i < n) {
        ty.ok.data[i] = f.req.operands.data[i].value.type;
        sc.ok.data[i] = f.req.operands.data[i].secret;
        i             = i + 1;
    }
    var inst: checker.Instance;
    inst.operands   = ty.ok;
    inst.secret     = sc.ok;
    inst.declared   = false;
    inst.immediates = f.req.immediates;
    val checked: res[bool, checker.Error] = checker.check(f.t, f.req.opcode, inst, out);
    if (sel checked.err) { ret res[bool, Refusal].err{Refusal.check{checked.err}}; }
    ret res[bool, Refusal].ok{checked.ok};
}

# evaluate one operation on constants
#
# a fold gives exactly what the operation gives when it runs, or refuses: an
# operation that would trap is refused by the trap, never answered.
# ---
# a:   the allocator the results are taken from
# t:   the type table the request's types are in, which may intern a mask type
# req: the operation and its constant operands
# ret: the results, owned by the caller until `release`, or why there are none
pub fun fold(a: *allocator.Allocator, t: *types.Table, req: Request) Outcome {
    val found: opt[Row] = opcodes.row(req.opcode);
    if (sel found.none) { ret refuse(Refusal.check{checker.Error.opcode{req.opcode}}); }
    var f: Frame;
    f.a   = a;
    f.t   = t;
    f.row = found.some;
    f.req = req;

    var i: u32 = 0;
    for (i < $length_of(Traps)) {
        val tr: Trap = f.row.effects.traps[i];
        if (sel tr.always) { ret refuse(Refusal.trap{tr}); }
        i = i + 1;
    }
    val e: Entry = table.entry(req.opcode);
    if (sel e.unfoldable || sel e.unstated) { ret refuse(Refusal.unfoldable{}); }

    var out: vector.Vector[Type] = vector.init[Type](a);
    fin { vector.dnit[Type](?out); }
    val secret: res[bool, Refusal] = typed(?f, ?out);
    if (sel secret.err) { ret refuse(secret.err); }
    f.results = Slice[Type]{data: out.data, size: out.len};

    fin { release_frame(?f); }
    val read_in: err[Refusal] = read(?f);
    if (sel read_in.err) { ret refuse(read_in.err); }
    val trap: opt[Trap] = trapped(?f);
    if (sel trap.some) { ret refuse(Refusal.trap{trap.some}); }
    val evaluated: err[Refusal] = evaluate(?f, e);
    if (sel evaluated.err) { ret refuse(evaluated.err); }
    var done: Folded;
    done.secret = secret.ok;
    val filled: err[Refusal] = fill(?f, ?done);
    if (sel filled.err) {
        release(a, done);
        ret refuse(filled.err);
    }
    ret Outcome.folded{done};
}

# the lane types and vectors the tests draw from, by position in a kit
val I1:      u32 = 0;
val I8:      u32 = 1;
val I32:     u32 = 2;
val I64:     u32 = 3;
val I128:    u32 = 4;
val I512:    u32 = 5;
val F16:     u32 = 6;
val F32:     u32 = 7;
val F64:     u32 = 8;
val V_I8X4:  u32 = 9;
val V_I32X4: u32 = 10;
val V_F32X4: u32 = 11;
val NONE:    u32 = 0xffffffff;

def Kit:  [12]Type;
def Word: [8]u64;

fun kit(t: *types.Table) Kit {
    var k:      Kit;
    val shapes: [9]types.Shape = [9]types.Shape{
        types.Shape.integer{types.Integer{width: 1}},
        types.Shape.integer{types.Integer{width: 8}},
        types.Shape.integer{types.Integer{width: 32}},
        types.Shape.integer{types.Integer{width: 64}},
        types.Shape.integer{types.Integer{width: 128}},
        types.Shape.integer{types.Integer{width: 512}},
        types.Shape.float{types.Float{format: types.BINARY16}},
        types.Shape.float{types.Float{format: types.BINARY32}},
        types.Shape.float{types.Float{format: types.BINARY64}},
    };
    var i: u32 = 0;
    for (i < 9) {
        val got: res[Type, types.Error] = types.intern(t, shapes[i]);
        if (sel got.ok) { k[i] = got.ok; }
        i = i + 1;
    }
    val v8: res[Type, types.Error] = types.intern(t, types.Shape.vector{types.Vector{lanes: 4, element: k[I8]}});
    if (sel v8.ok) { k[V_I8X4] = v8.ok; }
    val v32: res[Type, types.Error] = types.intern(t, types.Shape.vector{types.Vector{lanes: 4, element: k[I32]}});
    if (sel v32.ok) { k[V_I32X4] = v32.ok; }
    val vf: res[Type, types.Error] = types.intern(t, types.Shape.vector{types.Vector{lanes: 4, element: k[F32]}});
    if (sel vf.ok) { k[V_F32X4] = vf.ok; }
    ret k;
}

# one operation of the walk: its operands share one type, and a vector's
# lanes are one word each
# ---
# op:   the operation
# ty:   the operands' type in the kit
# to:   the type its immediate states, or NONE
# n:    the number of operands
# x:    the operands' words
# want: the expected words of each result
rec Case {
    op:   Opcode;
    ty:   u32;
    to:   u32;
    n:    u32;
    x:    [3]Word;
    want: [2]Word;
}

# the operands of a case laid out for a request, borrowing its own storage
rec Laid {
    words:    [3]Word;
    bits:     [3][8]Bits;
    operands: [3]Operand;
    imm:      [1]Immediate;
}

fun lay(t: *types.Table, k: *Kit, c: *Case, secret: [3]bool, out: *Laid) Request {
    val kinds: Kit = @k;
    out.words = c.x;
    var req: Request;
    req.opcode = c.op;
    if (c.to != NONE) {
        out.imm[0]     = Immediate.ty{kinds[c.to]};
        req.immediates = Slice[Immediate]{data: ?out.imm[0], size: 1};
    }
    if (c.n == 0) { ret req; }
    val ty: Type                = kinds[c.ty];
    val ln: res[Lanes, Refusal] = lanes_of(t, ty);
    if (sel ln.err) { ret req; }
    val bits: res[u32, Refusal] = bits_of(t, ln.ok.lane);
    if (sel bits.err) { ret req; }
    var i: u32 = 0;
    for (i < c.n) {
        var l: u32 = 0;
        for (l < ln.ok.count) {
            if (ln.ok.count == 1) { out.bits[i][l] = Bits{type: ln.ok.lane, words: Slice[u64]{data: ?out.words[i][0], size: word.words_for(bits.ok)::usize}}; }
            or                    { out.bits[i][l] = Bits{type: ln.ok.lane, words: Slice[u64]{data: ?out.words[i][l], size: 1}}; }
            l = l + 1;
        }
        out.operands[i] = Operand{value: Value{type: ty, lanes: Slice[Bits]{data: ?out.bits[i][0], size: ln.ok.count::usize}}, secret: secret[i]};
        i               = i + 1;
    }
    req.operands = Slice[Operand]{data: ?out.operands[0], size: c.n::usize};
    ret req;
}

fun matches(v: Value, want: Word) bool {
    if (v.lanes.size == 1) {
        val ws: Slice[u64] = v.lanes.data[0].words;
        var i:  usize      = 0;
        for (i < 8) {
            var got: u64 = 0;
            if (i < ws.size)    { got = ws.data[i]; }
            if (got != want[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    var l: usize = 0;
    for (l < v.lanes.size) {
        if (v.lanes.data[l].words.data[0] != want[l]) { ret false; }
        l = l + 1;
    }
    ret true;
}

val PUBLIC: [3]bool = [3]bool{false, false, false};

test fold__walk_evaluates_each_case {
    var a: allocator.Allocator;
    page.make(?a);
    var t: types.Table = types.init(?a);
    fin { types.dnit(?t); }
    var k:     Kit      = kit(?t);
    val cases: [99]Case = [99]Case{
        Case{op: opcodes.ADD, ty: I1, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.ADD, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x2, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.SUB, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.MUL, ty: I64, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xffffffffffffffff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0xffffffffffffffff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.MUL, ty: I128, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x8000000000000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x8000000000000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DIV_S, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xf9, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x2, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0xfd, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REM_S, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xf9, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x2, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DIV_U, ty: I128, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xffffffffffffffff, 0xffffffffffffffff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x3, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x5555555555555555, 0x5555555555555555, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.REM_U, ty: I64, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x64, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x7, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x2, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DIV_WIDE_U, ty: I8, to: NONE, n: 3, x: [3][8]u64{[8]u64{0x12, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x34, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x56, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x36, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x10, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DIV_WIDE_U, ty: I64, to: NONE, n: 3, x: [3][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x3, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x5555555555555555, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.DIV_WIDE_U, ty: I128, to: NONE, n: 3, x: [3][8]u64{[8]u64{0x0, 0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x2, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x8000000000000000, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.SHL, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x8, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.SHR_S, ty: I8, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x80, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x9, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0xff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.SHR_U, ty: I512, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8000000000000000}, [8]u64{0x1ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.SHL, ty: I512, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x1ff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8000000000000000}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.ADD, ty: I512, to: NONE, n: 2, x: [3][8]u64{[8]u64{0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff, 0x0}, [8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x1}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.MUL, ty: I512, to: NONE, n: 2, x: [3][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x1, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x8000000000000000, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x8000000000000000}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.NEG, ty: I64, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0xffffffffffffffff, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
        Case{op: opcodes.NOT, ty: I1, to: NONE, n: 1, x: [3][8]u64{[8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}, want: [2][8]u64{[8]u64{0x1, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}, [8]u64{0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0}}},
