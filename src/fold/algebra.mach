# the algebra table: one entry per row of the opcode table, at the row's index
#
# an entry says what an integer operation is algebraically, so a pass that
# bounds, reassociates, strength-reduces or vectorises reads the fact here and
# states no list of opcodes of its own. a row that is not one of these is
# opaque. the walk below holds every row to a stated entry that agrees with
# it, so a row added without one fails there.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use opcodes: mirl.ir.opcode;
use mirl.ir.opcode.Class;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Result;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Rule;
use mirl.ir.opcode.Rules;
use mirl.ir.opcode.Subject;

# what an operation is
# ---
# unstated:      the table states nothing for the row
# opaque:        no algebraic fact is stated for the row
# sum:           the first operand plus the second
# difference:    the first operand minus the second
# product:       the first operand times the second
# shift_left:    the first operand shifted left by the second
# shift_right_u: the first operand shifted right, filling with zeros
# shift_right_s: the first operand shifted right, filling with its sign bit
# quotient_s:    the signed quotient of the first operand by the second
# quotient_u:    the unsigned quotient of the first operand by the second
# remainder_s:   the signed remainder
# remainder_u:   the unsigned remainder
# both:          the bitwise and
# either:        the bitwise or
# differ:        the bitwise exclusive or
# extend_u:      the operand widened with zeros
# extend_s:      the operand widened with copies of its sign bit
# truncate:      the low bits of the operand
# select:        the second operand where the condition is 1, else the third
# count:         a count of bits of the operand, at most its width
# negate:        the two's complement negation of the operand
# complement:    the bitwise complement of the operand
# compare:       an integer comparison, a condition of the two operands
# flip:          the operand with its sign bit inverted and no other bit changed
# magnitude:     the operand with its sign bit cleared and no other bit changed
pub tag Op: u8 {
    unstated;
    opaque;
    sum;
    difference;
    product;
    shift_left;
    shift_right_u;
    shift_right_s;
    quotient_s;
    quotient_u;
    remainder_s;
    remainder_u;
    both;
    either;
    differ;
    extend_u;
    extend_s;
    truncate;
    select;
    count;
    negate;
    complement;
    compare;
    flip;
    magnitude;
}

# a value an operation's operand can be, in every lane and at every width
# ---
# none: no value is stated
# zero: every bit zero
# one:  the integer one
# ones: every bit one
pub tag Element: u8 {
    none;
    zero;
    one;
    ones;
}

# what an operation of two operands gives on two equal operands
# ---
# unknown: nothing is stated
# operand: the value itself
# zero:    zero
# settled: one constant for every value, that the operation gives on any
#          pair of equal operands, found by the folder
pub tag Same: u8 {
    unknown;
    operand;
    zero;
    settled;
}

# what an operation of one operand gives itself applied twice
# ---
# unknown: nothing is stated
# undo:    the original operand
# same:    what one application gives
pub tag Twice: u8 {
    unknown;
    undo;
    same;
}

# the identities of an operation, each exact for every value of every width
# and, for the one float pair that states any, for every bit pattern
# ---
# neutral:   the element e where the operation of x and e is x, the second
#            operand only unless the operation is commutative
# absorbing: the element e where the operation of x and e is e, with the same
#            sides
# vanishing: the element e where the operation of x and e is zero, the second
#            operand only
# same:      the operation of x and x, for an operation of two operands
# twice:     the operation of the operation of x, for an operation of one
pub rec Facts {
    neutral:   Element;
    absorbing: Element;
    vanishing: Element;
    same:      Same;
    twice:     Twice;
}

# an operation and how its operands combine
# ---
# op:          what it is
# associative: grouping its operands differently gives the same result, which
#              no float operation does
# commutative: swapping its two operands gives the same result
# facts:       its identities
pub rec Algebra {
    op:          Op;
    associative: bool;
    commutative: bool;
    facts:       Facts;
}

val NO_FACTS: Facts = Facts{neutral: Element.none{}, absorbing: Element.none{}, vanishing: Element.none{}, same: Same.unknown{}, twice: Twice.unknown{}};

val OPAQUE: Algebra = Algebra{op: Op.opaque{}, associative: false, commutative: false, facts: NO_FACTS};

def Entries: [129]Algebra;

val ENTRIES: Entries = [129]Algebra{
    Algebra{op: Op.sum{}, associative: true, commutative: true, facts: Facts{neutral: Element.zero{}, absorbing: Element.none{}, vanishing: Element.none{}, same: Same.unknown{}, twice: Twice.unknown{}}},
