};

# the algebra of an opcode's row, unstated when the opcode names no entry
pub fun algebra(op: Opcode) Algebra {
    if (op.index >= $length_of(Entries)) { ret Algebra{op: Op.unstated{}, associative: false, commutative: false}; }
    ret ENTRIES[op.index];
}

# the fixed operands an operation reads, zero when it states none
fun arity(a: Algebra) u32 {
    if (sel a.op.opaque || sel a.op.unstated)                     { ret 0; }
    if (sel a.op.extend_u || sel a.op.truncate || sel a.op.count) { ret 1; }
    if (sel a.op.select)                                          { ret 3; }
    ret 2;
}

# the class the row's rules bound its first operand to, unstated when none
fun first_class(r: *Row) Class {
    var i: u32 = 0;
    for (i < $length_of(Rules)) {
        val rl: Rule = r.rules[i];
        if (sel rl.is) {
            val b: opcodes.Bound = rl.is;
            if (sel b.subject.operand && b.subject.operand == 0) { ret b.class; }
        }
        i = i + 1;
    }
    ret Class.unstated{};
}

# zero when the entry agrees with its row, else the first disagreement
fun agrees(r: *Row, a: Algebra) u32 {
    if (sel a.op.unstated) { ret 1; }
    if (sel a.op.opaque) {
        if (a.associative || a.commutative) { ret 2; }
        ret 0;
    }
    if (arity(a) != opcodes.fixed(r))    { ret 3; }
    if (a.associative && !a.commutative) { ret 4; }
    val class: Class = first_class(r);
    if (a.associative && !(sel class.integer)) { ret 5; }
    ret 0;
}

test algebra__every_row_has_an_agreeing_entry {
    if ($length_of(Entries) != opcodes.rows()) { ret 1; }
    var i: u32 = 0;
    for (i < opcodes.rows()) {
        val got: opt[Row] = opcodes.row(Opcode{index: i});
        if (sel got.none) { ret 2; }
        var r:      Row = got.some;
        val defect: u32 = agrees(?r, algebra(Opcode{index: i}));
        if (defect != 0) { ret (10 + defect)::i32; }
        i = i + 1;
    }
    ret 0;
}
