# the algebra table: one entry per row of the opcode table, at the row's index
#
# an entry says what an integer operation is algebraically, so a pass that
# bounds, reassociates, strength-reduces or vectorises reads the fact here and
# states no list of opcodes of its own. a row that is not one of these is
# opaque. the walk below holds every row to a stated entry that agrees with
# it, so a row added without one fails there.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use mirl.fold.table;
use opcodes: mirl.ir.opcode;
use mirl.ir.opcode.Class;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Result;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Rule;
use mirl.ir.opcode.Rules;
use mirl.ir.opcode.Subject;

# what an operation is
# ---
# unstated:           the table states nothing for the row
# opaque:             no algebraic fact is stated for the row
# sum:                the first operand plus the second
# difference:         the first operand minus the second
# product:            the first operand times the second
# shift_left:         the first operand shifted left by the second
# shift_right_u:      the first operand shifted right, filling with zeros
# shift_right_s:      the first operand shifted right, filling with its sign bit
# quotient_s:         the signed quotient of the first operand by the second
# quotient_u:         the unsigned quotient of the first operand by the second
# remainder_s:        the signed remainder
# remainder_u:        the unsigned remainder
# both:               the bitwise and
# either:             the bitwise or
# differ:             the bitwise exclusive or
# extend_u:           the operand widened with zeros
# extend_s:           the operand widened with copies of its sign bit
# truncate:           the low bits of the operand
# select:             the second operand where the condition is 1, else the
#                     third
# population:         the number of one bits of the operand
# leading_zeros:      the number of zero bits above the operand's highest one
#                     bit, its width when it is zero
# trailing_zeros:     the number of zero bits below the operand's lowest one
#                     bit, its width when it is zero
# swap:               the operand with its bytes in reverse order
# negate:             the two's complement negation of the operand
# complement:         the bitwise complement of the operand
# compare:            an integer comparison, a condition of the two operands
# flip:               the operand with its sign bit inverted and no other bit
#                     changed
# magnitude:          the operand with its sign bit cleared and no other bit
#                     changed
# checked_sum:        the sum and whether it overflows, the operands read as
#                     signed when true and as unsigned when false
# checked_difference: the difference and whether it overflows, read as
#                     checked_sum reads them
# checked_product:    the product and whether it overflows, read as checked_sum
#                     reads them
pub tag Op: u8 {
    unstated;
    opaque;
    sum;
    difference;
    product;
    shift_left;
    shift_right_u;
    shift_right_s;
    quotient_s;
    quotient_u;
    remainder_s;
    remainder_u;
    both;
    either;
    differ;
    extend_u;
    extend_s;
    truncate;
    select;
    population;
    leading_zeros;
    trailing_zeros;
    swap;
    negate;
    complement;
    compare;
    flip;
    magnitude;
    checked_sum:        bool;
    checked_difference: bool;
    checked_product:    bool;
}

# a value an operation's operand can be, in every lane and at every width
# ---
# none: no value is stated
# zero: every bit zero
# one:  the integer one
# ones: every bit one
pub tag Element: u8 {
    none;
    zero;
    one;
    ones;
}

# which operand of an operation a fact is about
# ---
# right: the second operand is the element. an operation that is commutative
#        states its facts here and they hold for either operand
# left:  the first operand is the element, for an operation that is not
#        commutative
pub tag Side: u8 {
    right;
    left;
}

# an element and the operand it stands as
# ---
# element: the value
# side:    the operand
pub rec Fact {
    element: Element;
    side:    Side;
}

# what an operation of two operands gives on two equal operands
# ---
# unknown: nothing is stated
# operand: the value itself
# zero:    zero
# settled: one constant for every value, that the operation gives on any
#          pair of equal operands, found by the folder
pub tag Same: u8 {
    unknown;
    operand;
    zero;
    settled;
}

# what an operation of one operand gives itself applied twice
# ---
# unknown: nothing is stated
# undo:    the original operand
# same:    what one application gives
pub tag Twice: u8 {
    unknown;
    undo;
    same;
}

# the identities of an operation, each exact for every value of every width
# and, for the one float pair that states any, for every bit pattern
# ---
# neutral:   the element e where the operation with e as the operand its side
#            names gives the other operand
# absorbing: the element e where the operation with e as the operand its side
#            names gives e, at every value of the other operand, a shift past
#            the width included
# vanishing: the element e where the operation with e as the operand its side
#            names gives zero
# same:      the operation of x and x, for an operation of two operands
# twice:     the operation of the operation of x, for an operation of one
pub rec Facts {
    neutral:   Fact;
    absorbing: Fact;
    vanishing: Fact;
    same:      Same;
    twice:     Twice;
}

# an operation and how its operands combine
# ---
# op:          what it is
# associative: grouping its operands differently gives the same result, which
#              no float operation does
# commutative: swapping its two operands gives the same result
# facts:       its identities
pub rec Algebra {
    op:          Op;
    associative: bool;
    commutative: bool;
    facts:       Facts;
}

val NO_FACTS: Facts = Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}};

val OPAQUE: Algebra = Algebra{op: Op.opaque{}, associative: false, commutative: false, facts: NO_FACTS};

def Entries: [131]Algebra;

val ENTRIES: Entries = [131]Algebra{
    Algebra{op: Op.sum{}, associative: true, commutative: true, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.difference{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.zero{}, twice: Twice.unknown{}}},
    Algebra{op: Op.product{}, associative: true, commutative: true, facts: Facts{neutral: Fact{element: Element.one{}, side: Side.right{}}, absorbing: Fact{element: Element.zero{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.quotient_s{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.one{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.quotient_u{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.one{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.remainder_s{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.one{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.remainder_u{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.one{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.both{}, associative: true, commutative: true, facts: Facts{neutral: Fact{element: Element.ones{}, side: Side.right{}}, absorbing: Fact{element: Element.zero{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.operand{}, twice: Twice.unknown{}}},
    Algebra{op: Op.either{}, associative: true, commutative: true, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.ones{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.operand{}, twice: Twice.unknown{}}},
    Algebra{op: Op.differ{}, associative: true, commutative: true, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.zero{}, twice: Twice.unknown{}}},
    Algebra{op: Op.shift_left{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.zero{}, side: Side.left{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.shift_right_u{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.zero{}, side: Side.left{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.shift_right_s{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.zero{}, side: Side.right{}}, absorbing: Fact{element: Element.zero{}, side: Side.left{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.unknown{}}},
    Algebra{op: Op.negate{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.undo{}}},
    Algebra{op: Op.complement{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.undo{}}},
    Algebra{op: Op.compare{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.settled{}, twice: Twice.unknown{}}},
    Algebra{op: Op.compare{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.settled{}, twice: Twice.unknown{}}},
