    Algebra{op: Op.magnitude{}, associative: false, commutative: false, facts: Facts{neutral: Fact{element: Element.none{}, side: Side.right{}}, absorbing: Fact{element: Element.none{}, side: Side.right{}}, vanishing: Fact{element: Element.none{}, side: Side.right{}}, same: Same.unknown{}, twice: Twice.same{}}},
