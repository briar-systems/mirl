# the algebra of an opcode's row, unstated when the opcode names no entry
pub fun algebra(op: Opcode) Algebra {
    if (op.index >= $length_of(Entries)) { ret Algebra{op: Op.unstated{}, associative: false, commutative: false, facts: NO_FACTS}; }
    ret ENTRIES[op.index];
}

# whether an operation is a count of bits of its operand
pub fun counts(op: Op) bool {
    ret sel op.population || sel op.leading_zeros || sel op.trailing_zeros;
}

# whether an operation is exact on single bits held as 0 or 1: its operands
# read at any wider width give the result of one bit, 0 or 1, with nothing to
# truncate. the bitwise and, or and exclusive or are, and so is a comparison
# that reads its operands as unsigned
pub fun single_bit(op: Opcode) bool {
    val a: Algebra = algebra(op);
    if (sel a.op.both || sel a.op.either || sel a.op.differ) { ret true; }
    if (!(sel a.op.compare))                                 { ret false; }
    val c: opt[table.Comparison] = table.comparison(op);
    ret sel c.some && !c.some.signed;
}

# the fixed operands an operation reads, zero when it states none
fun arity(a: Algebra) u32 {
    if (sel a.op.opaque || sel a.op.unstated)                                          { ret 0; }
    if (sel a.op.extend_u || sel a.op.extend_s || sel a.op.truncate || counts(a.op))   { ret 1; }
    if (sel a.op.negate || sel a.op.complement || sel a.op.flip || sel a.op.magnitude) { ret 1; }
    if (sel a.op.swap)                                                                 { ret 1; }
    if (sel a.op.select)                                                               { ret 3; }
    ret 2;
}

# the class the row's rules bound its first operand to, unstated when none
fun first_class(r: *Row) Class {
    var i: u32 = 0;
    for (i < $length_of(Rules)) {
        val rl: Rule = r.rules[i];
        if (sel rl.is) {
            val b: opcodes.Bound = rl.is;
            if (sel b.subject.operand && b.subject.operand == 0) { ret b.class; }
        }
        i = i + 1;
    }
    ret Class.unstated{};
}

fun given(f: Fact) bool {
    ret !(sel f.element.none);
}

fun stated(f: Facts) bool {
    ret given(f.neutral) || given(f.absorbing) || given(f.vanishing) || !(sel f.same.unknown) || !(sel f.twice.unknown);
}

fun gives_first(r: *Row) bool {
    val got: Result = r.results[0];
    if (!(sel got.same)) { ret false; }
    val of: Subject = got.same;
    ret sel of.operand && of.operand == 0;
}

# whether two facts name one element at one operand
fun clash(a: Fact, b: Fact) bool {
    val element: bool = (sel a.element.zero && sel b.element.zero) || (sel a.element.one && sel b.element.one) || (sel a.element.ones && sel b.element.ones);
    val side:    bool = (sel a.side.right && sel b.side.right) || (sel a.side.left && sel b.side.left);
    ret element && side;
}

# zero when the identities agree with the row they are stated for: the
# elements and equal operands of integers only, an operation of one operand
# for integers or floats, a result of the type of the operand wherever the
# identity gives the operand or an element, and a left element only for an
# operation that is not commutative, since a commutative one states the right
fun facts_agree(r: *Row, a: Algebra, class: Class) u32 {
    val f:      Facts = a.facts;
    val binary: bool  = given(f.neutral) || given(f.absorbing) || given(f.vanishing) || !(sel f.same.unknown);
    if (binary && (opcodes.fixed(r) != 2 || !(sel class.integer)))                                    { ret 6; }
    if (!(sel f.twice.unknown) && (opcodes.fixed(r) != 1 || !(sel class.integer || sel class.float))) { ret 7; }
    if (clash(f.neutral, f.absorbing) || clash(f.neutral, f.vanishing))                               { ret 8; }
    val keeps: bool = given(f.neutral) || given(f.absorbing) || sel f.same.operand || !(sel f.twice.unknown);
    if (keeps && !gives_first(r))                                                                             { ret 9; }
    if (a.commutative && (sel f.neutral.side.left || sel f.absorbing.side.left || sel f.vanishing.side.left)) { ret 10; }
    ret 0;
}

# zero when the entry agrees with its row, else the first disagreement
fun agrees(r: *Row, a: Algebra) u32 {
    if (sel a.op.unstated) { ret 1; }
    if (sel a.op.opaque) {
        if (a.associative || a.commutative || stated(a.facts)) { ret 2; }
        ret 0;
    }
    if (arity(a) != opcodes.fixed(r))    { ret 3; }
    if (a.associative && !a.commutative) { ret 4; }
    val class: Class = first_class(r);
    if (a.associative && !(sel class.integer)) { ret 5; }
    ret facts_agree(r, a, class);
}

test algebra__every_row_has_an_agreeing_entry {
    if ($length_of(Entries) != opcodes.rows()) { ret 1; }
    var i: u32 = 0;
    for (i < opcodes.rows()) {
        val got: opt[Row] = opcodes.row(Opcode{index: i});
        if (sel got.none) { ret 2; }
        var r:      Row = got.some;
        val defect: u32 = agrees(?r, algebra(Opcode{index: i}));
        if (defect != 0) { ret (10 + defect)::i32; }
        i = i + 1;
    }
    ret 0;
}
