# the warnings a compilation gives, which it returns as data and never writes,
# so a front end decides how to show them, or to refuse one its build does not
# accept. a back end or a pass of the
# schedule appends each to the list the compilation hands it, and a new kind
# of warning is a new case of `Warning`, with no change to how one is handed
# back

use std.types.option.opt;

use mct: mirl.ct;
use mirl.ir.debug.record.Location;
use mirl.ir.id.Function;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.type.table.Type;

# why a vector operation of the source runs as scalar code
# ---
# computed: a vector unit of the target holds its lanes and none the build
#           meets computes it
# unheld:   no vector unit the build meets holds some of its lanes
# unitless: the build meets no vector unit of the target
# timed:    its function requires constant time, and the build's code for its
#           lanes or its operation on a unit is not timed relative to the
#           lanes taken one by one under the modes the function is read under
#           (`mirl.machine.select.served`)
pub tag Cause: u8 {
    computed;
    unheld;
    unitless;
    timed;
}

# a lanewise operation or a reduction of the source that the vector
# legalisation takes lane by lane, in whole or in part (`mirl.legal.vector`),
# given in every build. one is given per operation, type and source position
# where the operation carries a location, and per operation, type and function
# where it does not.
# a front end shows the computed ones as warnings where it has the location,
# and one whose build requires packed vector forms refuses every one
# ---
# function: the function holding it
# location: its source location, none in a module lowered without debug
#           information
# opcode:   the operation
# vector:   the vector type it is stated at, its first vector operand's, or a
#           select's first selected vector's
# cause:    why it runs as scalar code
pub rec Scalarized {
    function: Function;
    location: opt[Location];
    opcode:   Opcode;
    vector:   Type;
    cause:    Cause;
}

# one warning a compilation gave
# ---
# unheld:     a soft constant-time function on a set that guarantees no
#             instruction's timing, compiled with its timing not held
# scalarized: a vector operation of the source taken lane by lane
pub tag Warning: u8 {
    unheld:     mct.Unheld;
    scalarized: Scalarized;
}
