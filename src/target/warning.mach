# the warnings a compilation gives, which it returns as data and never writes,
# so a front end decides how to show them. a back end appends each to the list
# the compilation hands it, and a new kind of warning is a new case of
# `Warning`, with no change to how a back end hands one back

use mct: mirl.ct;

# one warning a compilation gave
# ---
# unheld: a soft constant-time function on a set that guarantees no
#         instruction's timing, compiled with its timing not held
pub tag Warning: u8 {
    unheld: mct.Unheld;
}
