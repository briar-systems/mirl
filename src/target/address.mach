# how code on a target reaches an address: the relocation model and how each
# thread-local model of the ir is reached
#
# selection reads these and nothing else to choose the sequence that forms
# an address, so a target states its model once and every address follows it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.string.str;

use mirl.ir.global.Tls;
use mirl.ir.linkage;
use mirl.ir.linkage.Linkage;

use mink.model.symbol;

# how code reaches the address of a symbol
# ---
# static: by its absolute address, fixed at link time
# pie:    relative to the code, for an executable loaded anywhere, where a
#         preemptible symbol is reached through the global offset table
# pic:    relative to the code, for a shared object, where a preemptible
#         symbol is reached through the global offset table
pub tag Relocation: u8 {
    static;
    pie;
    pic;
}

# how a thread-local variable is reached
# ---
# local_exec:      at an offset from the thread pointer fixed at link time
# initial_exec:    at an offset from the thread pointer the global offset
#                  table holds, fixed at load
# general_dynamic: through the runtime's lookup of its module and offset
# descriptor:      through a descriptor the runtime resolves and calls
# variable:        through a thunk per variable the runtime binds, as
#                  darwin's thread-local variables are
# indexed:         through the thread's table of module blocks, at the index
#                  the runtime gives the module, as windows' tls index is
pub tag Access: u8 {
    local_exec;
    initial_exec;
    general_dynamic;
    descriptor;
    variable;
    indexed;
}

# how each thread-local model of the ir is reached, one row per model
# ---
# general_dynamic: a variable of any module
# local_dynamic:   a variable of this module, loaded at any time
# initial_exec:    a variable of a module loaded at start
# local_exec:      a variable of the executable itself
# lookup:          the runtime function general dynamic access calls
pub rec Threads {
    general_dynamic: Access;
    local_dynamic:   Access;
    initial_exec:    Access;
    local_exec:      Access;
    lookup:          str;
}

# a target's address model
# ---
# relocation: how the address of a symbol is reached
# threads:    how a thread-local variable is reached
pub rec Model {
    relocation: Relocation;
    threads:    Threads;
}

# what a target states of its addresses
# ---
# unstated:  nothing, a defect of the row
# uncarried: the target has no address model yet, so no address is selected
# model:     this model
pub tag Addresses: u8 {
    unstated;
    uncarried;
    model: Model;
}

# how a model reaches a thread-local variable of an ir model
pub fun access(m: *Model, tls: Tls) Access {
    if (sel tls.general_dynamic) { ret m.threads.general_dynamic; }
    if (sel tls.local_dynamic)   { ret m.threads.local_dynamic; }
    if (sel tls.initial_exec)    { ret m.threads.initial_exec; }
    ret m.threads.local_exec;
}

# how code reaches the address of one symbol under a model
# ---
# absolute: by its absolute address
# relative: by its distance from the code
# table:    through its entry in the global offset table
# thread:   a thread-local variable, by this access
pub tag Reach: u8 {
    absolute;
    relative;
    table;
    thread: Access;
}

# whether a symbol may resolve to a definition in another image at load,
# for what a relocation model builds
#
# a local symbol resolves in its object, and a hidden or internal one in its
# image. an executable, built static or pie, keeps every symbol it defines,
# and a shared object, built pic, may have one of default visibility
# preempted. a symbol another module defines may be in another image unless
# it is hidden or internal.
# ---
# r:       the relocation model the code is built for
# l:       the symbol's linkage
# defined: the module defines the symbol
pub fun preemptible(r: Relocation, l: Linkage, defined: bool) bool {
    if (!linkage.external(l)) { ret false; }
    if (!defined)             { ret symbol.shows(l.visibility, symbol.EXPORTED); }
    if (!(sel r.pic))         { ret false; }
    ret symbol.shows(l.visibility, symbol.PREEMPTIBLE);
}

# how a model reaches a symbol: absolutely under static, and under a model with
# a global offset table through it when the symbol is preemptible and by its
# distance from the code when it is not
# ---
# m:       the model
# defined: the module defines the symbol
# l:       the symbol's linkage
# tls:     how the ir reaches it when it is thread-local, none otherwise
pub fun reach(m: *Model, defined: bool, l: Linkage, tls: opt[Tls]) Reach {
    if (sel tls.some)                          { ret Reach.thread{access(m, tls.some)}; }
    if (sel m.relocation.static)               { ret Reach.absolute{}; }
    if (preemptible(m.relocation, l, defined)) { ret Reach.table{}; }
    ret Reach.relative{};
}
