# the axes a target is assembled from, each a list of rows of its own
#
# a target is never a row. its tuple names an architecture, a system and an
# environment, rows of mink's catalogs, a member of the architecture's
# convention axis and a baseline over masc's catalog of the architecture's
# set, and every fact it holds is read from the row of the axis that owns it:
# its capabilities from its architecture's row, read under its baseline, its
# data layout from its convention member, which is of one architecture, and
# its address model from the row of its architecture and system. a family
# states its rows on each axis, so a new architecture, convention or system
# is one row on its own axis and never a row per combination.

use std.collections.slice.Slice;
use std.types.option.opt;
use std.types.string.str;

use arches:  mink.catalog.arch;
use systems: mink.catalog.os;

use mirl.target.abi.convention.Convention;
use mirl.target.address.Addresses;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Data;

# the capabilities of one architecture of a family, whose conditions the
# build reads under the baseline
# ---
# arch: the architecture's row in mink's catalog
# caps: its code generation declarations
pub rec Machine {
    arch: *arches.Arch;
    caps: Capabilities;
}

# one member of an architecture's convention axis
# ---
# arch: the architecture it is a convention of
# name: its spelling, mink's psABI name, which a tuple names it by
# row:  the row its calls are made under, none for a member mirl carries no
#       row for yet, whose calls are refused and whose requirements are not
#       read
# data: the data layout of the architecture under it
pub rec Member {
    arch: *arches.Arch;
    name: str;
    row:  opt[*Convention];
    data: Data;
}

# the address model of one architecture under one system
# ---
# arch:      the architecture's row in mink's catalog
# system:    the system's row in mink's catalog
# addresses: how its code reaches an address
pub rec Model {
    arch:      *arches.Arch;
    system:    *systems.System;
    addresses: Addresses;
}

# a family's rows on every axis
# ---
# machines: one per architecture it serves
# members:  every convention of its architectures
# models:   the address models it carries, a pair of architecture and system
#           with no row carrying none
pub rec Axes {
    machines: Slice[Machine];
    members:  Slice[Member];
    models:   Slice[Model];
}
