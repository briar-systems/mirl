# the test tuples by the target each names, as indices of TUPLES
#[testing]
pub val RV64_LINUX:            usize = 0;
#[testing]
pub val X86_64_LINUX:          usize = 1;
#[testing]
pub val X86_64_DARWIN:         usize = 2;
#[testing]
pub val X86_64_WINDOWS:        usize = 3;
#[testing]
pub val X86_64_FREESTANDING:   usize = 4;
#[testing]
pub val AARCH64_LINUX:         usize = 5;
#[testing]
pub val AARCH64_DARWIN:        usize = 6;
#[testing]
pub val AARCH64_WINDOWS:       usize = 7;
#[testing]
pub val AARCH64_FREESTANDING:  usize = 8;
#[testing]
pub val RV64_FREESTANDING:     usize = 9;
#[testing]
pub val RV32_LINUX:            usize = 10;
#[testing]
pub val RV32_FREESTANDING:     usize = 11;
#[testing]
pub val SPIRV_VULKAN:          usize = 12;
#[testing]
pub val RV64IMAC_FREESTANDING: usize = 13;
#[testing]
pub val RV32IMAC_FREESTANDING: usize = 14;

#[testing]
var PAGE:         A.Allocator;
#[testing]
var PAGED:        bool = false;
#[testing]
var MADE:         [15]bool;
#[testing]
var MADE_TARGETS: [15]Target;

# the allocator the process keeps its assembled targets in
#[testing]
fun keeping() *A.Allocator {
    if (!PAGED) {
        page.make(?PAGE);
        PAGED = true;
    }
    ret ?PAGE;
}

# the number of test tuples
#[testing]
pub fun count() usize {
    ret $length_of(Tuples);
}

# the target of the test tuple at an index, none past the last or for a tuple
# that does not assemble
#[testing]
pub fun at(index: usize) opt[*Target] {
    if (index >= count()) { ret opt[*Target].none{}; }
    if (!MADE[index]) {
        val made: res[Target, assemble.Refusal] = assemble.assemble(keeping(), TUPLES[index]);
        if (sel made.err) { ret opt[*Target].none{}; }
        MADE_TARGETS[index] = made.ok;
        MADE[index]         = true;
    }
    ret opt[*Target].some{?MADE_TARGETS[index]};
}

# the target of the test tuple at an index, which the tests know assembles.
# one that does not is a target that declares nothing, which every check refuses
#[testing]
pub fun of(index: usize) *Target {
    val t: opt[*Target] = at(index);
    if (sel t.some) { ret t.some; }
    ret ?MADE_TARGETS[0];
}

# the target a tuple assembles to, kept for the process, none for a tuple
# that does not assemble
#[testing]
pub fun assembled(a: *A.Allocator, t: Tuple) opt[*Target] {
    val made: res[Target, assemble.Refusal] = assemble.assemble(keeping(), t);
    if (sel made.err) { ret opt[*Target].none{}; }
    val held: res[*Target, A.Error] = A.zallocate[Target](keeping(), 1);
    if (sel held.err) { ret opt[*Target].none{}; }
    held.ok[0] = made.ok;
    ret opt[*Target].some{held.ok};
}

# the first test target the predicate accepts, none when none does
#[testing]
pub fun first(want: fun(*Target) bool) opt[*Target] {
    var i: usize = 0;
    for (i < count()) {
        val t: opt[*Target] = at(i);
        if (sel t.some) {
            if (want(t.some)) { ret t; }
        }
        i = i + 1;
    }
    ret opt[*Target].none{};
}

#[testing]
var E_BASE: Target;
#[testing]
var E_MADE: bool = false;

# riscv64e freestanding, rv64emc under lp64e, whose row mirl carries for the
# tests of the e base alone, so the target its tuple assembles to is given
# the row
#[testing]
pub fun e_base() *Target {
    if (!E_MADE) {
        val made: res[Target, assemble.Refusal] = assemble.assemble(keeping(), tuple("riscv64e", "freestanding", "none", "lp64e", "rv64emc"));
        if (sel made.ok) {
            E_BASE            = made.ok;
            E_BASE.convention = Declared.rows{Conventions{default: ?LP64E, rows: ALONE}};
        }
        E_MADE = true;
    }
    ret ?E_BASE;
}

# a target that allocates registers and has free control flow
#[testing]
pub fun register_machine(t: *Target) bool {
    ret sel t.caps.registers.allocated && sel t.caps.control.free;
}

# the bytes of a target's pointer in space 0, zero when it states none
fun pointer_bytes(t: *Target) u64 {
    val rows: Slice[Space] = t.caps.widths.pointers;
    var i:    usize        = 0;
    for (i < rows.size) {
        if (rows.data[i].space == 0) {
            val p: Pointer = record.pointer_of(t, ?rows.data[i]);
            if (sel p.physical) { ret p.physical.size; }
            ret 0;
        }
        i = i + 1;
    }
    ret 0;
}

# a target whose pointer in space 0 is four bytes
#[testing]
pub fun four_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 4;
}

# a target whose pointer in space 0 is eight bytes
#[testing]
pub fun eight_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 8;
}

# a target whose control flow must be structured
#[testing]
pub fun requires_structure(t: *Target) bool {
    ret sel t.caps.control.structured;
}

# a target whose shifts take a count modulo the width
#[testing]
pub fun wraps_shifts(t: *Target) bool {
    ret sel t.caps.arithmetic.shifts.wraps;
}

# a target with a multiply form beyond the low half
#[testing]
pub fun multiplies_wide(t: *Target) bool {
    ret sel t.caps.arithmetic.products.forms;
}

# a copy of a target with no convention row, which holds a basis and no
# machine
#[testing]
pub fun unconventional(t: *Target) Target {
    var bare: Target = @t;
    bare.convention = Declared.uncarried{"uncarried"};
    ret bare;
}

# a target whose control flow is free
#[testing]
pub fun leaves_control_free(t: *Target) bool {
    ret sel t.caps.control.free;
}

# a target of 64 bit words that divides at the word with no trap, and has no
# instruction that copies or fills
#[testing]
pub fun divides_quietly(t: *Target) bool {
    val top: opt[u32] = capability.widest(?t.caps);
    if (!(sel top.some))                                          { ret false; }
    if (top.some != 64)                                           { ret false; }
    if (!capability.holds(t.caps.arithmetic.division.widths, 64)) { ret false; }
    ret sel t.caps.arithmetic.division.zero.quiet && sel t.caps.arithmetic.division.overflow.quiet && sel t.caps.bulk.fill.none && sel t.caps.addressing.physical;
}

# a target of 64 bit words that divides a two-word dividend by a word divisor
# at the word, under no condition
#[testing]
pub fun divides_long(t: *Target) bool {
    val top: opt[u32] = capability.widest(?t.caps);
    if (!(sel top.some))                                    { ret false; }
    if (top.some != 64)                                     { ret false; }
    if (!(sel t.caps.arithmetic.division.condition.always)) { ret false; }
    ret capability.runs_long(?t.caps.arithmetic.division, 64);
}

val LONG_WIDENED: [1]u32 = [1]u32{128};

test tuples__refuse_a_long_division_at_a_width_they_widen {
    val row: opt[*Target] = first(divides_long);
    if (!(sel row.some)) { ret 1; }
    var wide: Target = @row.some;
    val l:    Long   = Long{widths: Slice[u32]{data: ?LONG_WIDENED[0], size: 1}, zero: Fault.traps{}, exceeds: Fault.traps{}};
    wide.caps.arithmetic.division.long = LongDivision.native{l};
    val f: opt[Fact] = capability.missing(?wide.caps);
    if (!(sel f.some))            { ret 2; }
    if (!(sel f.some.long_width)) { ret 2; }
    if (f.some.long_width != 128) { ret 3; }
    val d: err[Error] = declared(?wide);
    if (!(sel d.err && sel d.err.unstated)) { ret 4; }
    ret 0;
}

#[testing]
fun kept(a: *Attached) opt[*Violation] {
    ret opt[*Violation].none{};
}

#[testing]
val UNSORTED_ENTRIES: [2]Entry = [2]Entry{
    Entry{name: "b", datum: Kind.integer{}, attaches: Attaches.function{}, check: kept},
    Entry{name: "a", datum: Kind.integer{}, attaches: Attaches.function{}, check: kept},
};

# a schema whose entries are out of order, which leaves a target's attributes unstated
#[testing]
val UNSORTED: Schema = Schema{family: "f", entries: Slice[Entry]{data: ?UNSORTED_ENTRIES[0], size: 2}};

test tuples__declare_every_capability {
    var i: usize = 0;
    for (i < count()) {
        val got: opt[*Target] = at(i);
        if (sel got.none) { ret 1; }
        val t: *Target    = got.some;
        val d: err[Error] = declared(t);
        if (sel d.err) { ret 1; }
        var bare: Target = @t;
        var caps: Capabilities;
        bare.caps = caps;
        val c: err[Error] = declared(?bare);
        if (!(sel c.err && sel c.err.unstated)) { ret 2; }
        var unsaid: Functions;
        bare                = @t;
        bare.caps.functions = unsaid;
        val fn: err[Error] = declared(?bare);
        if (!(sel fn.err))                    { ret 2; }
        if (!(sel fn.err.unstated))           { ret 2; }
        if (!(sel fn.err.unstated.functions)) { ret 2; }
        var open: Attributes;
        bare                 = @t;
        bare.caps.attributes = open;
        val f: err[Error] = declared(?bare);
        if (!(sel f.err))                     { ret 2; }
        if (!(sel f.err.unstated))            { ret 2; }
        if (!(sel f.err.unstated.attributes)) { ret 2; }
        bare.caps.attributes = Attributes.schema{?UNSORTED};
        val u: err[Error] = declared(?bare);
        if (!(sel u.err))                     { ret 2; }
        if (!(sel u.err.unstated))            { ret 2; }
        if (!(sel u.err.unstated.attributes)) { ret 2; }
        var data: Data;
        bare      = @t;
        bare.data = data;
        val l: err[Error] = declared(?bare);
        if (!(sel l.err && sel l.err.unstated)) { ret 3; }
        var k: usize = 0;
        for (k < i) {
            val other: opt[*Target] = at(k);
            if (sel other.none)             { ret 4; }
            if (record.same(other.some, t)) { ret 4; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# a target that states two rows of its first held format
#[testing]
fun states_a_format_twice(t: *Target) bool {
    if (!(sel t.caps.formats.held)) { ret false; }
    val list: Slice[Held] = t.caps.formats.held;
    var i:    usize       = 1;
    for (i < list.size) {
        if (list.data[i].format.index == list.data[0].format.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

#[testing]
val PAST_ATOMS:        [1]requirement.Id          = [1]requirement.Id{0xffffffff};
#[testing]
val PAST_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?PAST_ATOMS[0], len: 1}, none: requirement.NO_IDS}};

# whether a target with these held rows is refused by the fact
#[testing]
fun refused_by(t: *Target, held: *[2]Held, conditions: bool) bool {
    var bare: Target = @t;
    bare.caps.formats = Formats.held{Slice[Held]{data: ?(@held)[0], size: 2}};
    val d: err[Error] = declared(?bare);
    if (!(sel d.err))          { ret false; }
    if (!(sel d.err.unstated)) { ret false; }
    if (conditions)            { ret sel d.err.unstated.conditions; }
    ret sel d.err.unstated.formats;
}

# the rows of one format stand under conditions no build meets together, and
# every condition names an atom of the target's set: a row stated twice, or
# beside one that always holds, overlaps, and a row past the catalog is not
# read
test tuples__refuse_rows_of_one_format_a_build_meets_together {
    val row: opt[*Target] = first(states_a_format_twice);
    if (sel row.none) { ret 1; }
    val formats: Formats = row.some.caps.formats;
    if (!(sel formats.held)) { ret 1; }
    val first_row: Held    = formats.held.data[0];
    var twice:     [2]Held = [2]Held{first_row, first_row};
    if (!refused_by(row.some, ?twice, false)) { ret 2; }
    var always: [2]Held = [2]Held{first_row, first_row};
    always[1].condition = Condition.always{};
    if (!refused_by(row.some, ?always, false)) { ret 3; }
    var past: [2]Held = [2]Held{first_row, first_row};
    past[1].condition = Condition.requires{requirement.Requirement{at: ?PAST_ALTERNATIVES[0], len: 1}};
    if (!refused_by(row.some, ?past, true)) { ret 4; }
    ret 0;
}
