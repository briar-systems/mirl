#[testing]
fun spelled(s: str) View {
    ret View{data: s, len: str_len(s)};
}

#[testing]
fun tuple(arch: str, system: str, env: str, convention: str, baseline: str) Tuple {
    ret Tuple{arch: spelled(arch), system: spelled(system), env: spelled(env), convention: spelled(convention), baseline: spelled(baseline)};
}

#[testing]
def Tuples: [15]Tuple;

# the tuples of the tests' targets, the first the one the ir's own tests name.
# an x86-64 baseline is the psabi's first level
#[testing]
val TUPLES: Tuples = [15]Tuple{
    Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}},
    Tuple{arch: View{data: "x86_64", len: 6}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "sysv64", len: 6}, baseline: View{data: "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2", len: 41}},
    Tuple{arch: View{data: "x86_64", len: 6}, system: View{data: "darwin", len: 6}, env: View{data: "macos", len: 5}, convention: View{data: "sysv64", len: 6}, baseline: View{data: "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2", len: 41}},
    Tuple{arch: View{data: "x86_64", len: 6}, system: View{data: "windows", len: 7}, env: View{data: "msvc", len: 4}, convention: View{data: "win64", len: 5}, baseline: View{data: "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2", len: 41}},
    Tuple{arch: View{data: "x86_64", len: 6}, system: View{data: "freestanding", len: 12}, env: View{data: "none", len: 4}, convention: View{data: "sysv64", len: 6}, baseline: View{data: "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2", len: 41}},
    Tuple{arch: View{data: "aarch64", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "aapcs64", len: 7}, baseline: View{data: "armv8-a", len: 7}},
    Tuple{arch: View{data: "aarch64", len: 7}, system: View{data: "darwin", len: 6}, env: View{data: "macos", len: 5}, convention: View{data: "darwinpcs", len: 9}, baseline: View{data: "armv8-a", len: 7}},
    Tuple{arch: View{data: "aarch64", len: 7}, system: View{data: "windows", len: 7}, env: View{data: "msvc", len: 4}, convention: View{data: "aapcs64win", len: 10}, baseline: View{data: "armv8-a", len: 7}},
    Tuple{arch: View{data: "aarch64", len: 7}, system: View{data: "freestanding", len: 12}, env: View{data: "none", len: 4}, convention: View{data: "aapcs64", len: 7}, baseline: View{data: "armv8-a", len: 7}},
    Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "freestanding", len: 12}, env: View{data: "none", len: 4}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64ifd", len: 7}},
    Tuple{arch: View{data: "riscv32", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "ilp32d", len: 6}, baseline: View{data: "rv32gc", len: 6}},
    Tuple{arch: View{data: "riscv32", len: 7}, system: View{data: "freestanding", len: 12}, env: View{data: "none", len: 4}, convention: View{data: "ilp32", len: 5}, baseline: View{data: "rv32i", len: 5}},
    Tuple{arch: View{data: "spirv", len: 5}, system: View{data: "vulkan", len: 6}, env: View{data: "vulkan1.0", len: 9}, convention: View{data: "shader", len: 6}, baseline: View{data: "spv1.0,Shader", len: 13}},
