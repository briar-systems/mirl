# the selection an inline assembly block states, read over the context of the
# function it stands in
#
# a block's head is masc's own spelling of a selection of the set
# (`mirl.ir.assembly.Assembly.selection`), read by masc and never by mirl. it
# only adds: a block is read under its function's context with the head's
# extensions added, closed over their implications, so what the function holds
# stays admitted and a row past both is refused. a head that adds nothing reads
# the block under the function's own context, and one that states a value of a
# state axis the function does not run at is refused, as a block cannot change
# what the code around it was made for. every family reads a head here, once
# for each distinct head over each context, and what it made lives as long as
# the blocks read under it.
#
# what a head adds is rows and never a timing promise. a row's timing class is
# read under the context the walk is given for timing, which the function's
# alone makes (`mirl.ct.check`), so a head can't lift a row. the code of a
# function with such a block holds rows its function's context does not admit,
# so the walk decodes it under a context of its own (`Reading`), its function's
# with what every head of it adds. an atom a head adds may gate timing
# (`gates_timing`) by being held or by being absent, so `Reading.gated` names
# those, and the walk holds the code under them as well, which can only refuse
# more.

use std.types.char.char;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.requirement;
use mset:       masc.core.set;
use core_state: masc.core.state;

use mirl.base.slice;
use mirl.ir.assembly.Assembly;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.instruction.InstructionData;
use mirl.ir.opcode;
use mirl.target.basis;
use mirl.target.basis.Widened;
use mirl.target.record.Target;

# why a block's head was not read
# ---
# alloc:   the allocator refused storage
# spelled: masc refused the spelling, in its words
# stated:  it states a value of a state axis its function does not run at
# opened:  what it adds was not opened over the function's context
pub tag Refusal: u8 {
    alloc:   allocator.Error;
    spelled: str;
    stated;
    opened: basis.Error;
}

# the fact a head was not read on, for diagnostics
pub fun fact(r: Refusal) str {
    if (sel r.alloc)   { ret "the allocator refused storage"; }
    if (sel r.spelled) { ret r.spelled; }
    if (sel r.opened)  { ret basis.fact(r.opened); }
    ret "a block's selection states an execution state its function does not run at";
}

# one head read over one context
# ---
# spelling: the head, in storage of its own
# over:     the context it was read over
# context:  the context a block under it is read and encoded under, `over` where it adds nothing
# added:    the atoms `context` holds past `over`
# gated:    those of them that gate timing in the set
# widened:  what `context` stands in where it adds something
pub rec Head {
    spelling: View;
    over:     *core_state.Context;
    context:  *core_state.Context;
    added:    Slice[requirement.Id];
    gated:    Slice[requirement.Id];
    widened:  Widened;
}

# every head one compilation read, each held until the compilation is done, as
# masc's blocks and builder keep the contexts they were read and written under
# ---
# a:    the allocator each is taken from
# held: each head, at an address of its own
pub rec Heads {
    a:    *allocator.Allocator;
    held: vector.Vector[*Head];
}

pub fun init(a: *allocator.Allocator) Heads {
    ret Heads{a: a, held: vector.init[*Head](a)};
}

fun release_one(a: *allocator.Allocator, h: *Head) {
    if (h.context != h.over) { basis.narrow(?h.widened); }
    slice.release[requirement.Id](a, h.added);
    slice.release[requirement.Id](a, h.gated);
    slice.release_view(a, h.spelling);
    allocator.deallocate[Head](a, h, 1);
}

# give back every head held
pub fun release(h: *Heads) {
    var i: usize = 0;
    for (i < h.held.len) {
        release_one(h.a, h.held.data[i]);
        i = i + 1;
    }
    vector.dnit[*Head](?h.held);
}

# `w` widened over `ctx` by `ids`, its stream the one `ctx` is in, which a typed
# stream keeps across the instructions of every context of its code
fun widened(w: *Widened, a: *allocator.Allocator, t: *Target, ctx: *core_state.Context, ids: requirement.Ids) err[Refusal] {
    val opened: err[basis.Error] = basis.widen_atoms(w, a, t, ctx, ids);
    if (sel opened.err) { ret err[Refusal].err{Refusal.opened{opened.err}}; }
    w.context.stream = ctx.stream;
    ret err[Refusal].ok{};
}

# the selection `spelling` spells in the catalog of `s`, or why masc refused it
fun spelled(a: *allocator.Allocator, s: *mset.Set, spelling: View) res[extension.Selection, Refusal] {
    val text: res[*char, allocator.Error] = allocator.zallocate[char](a, spelling.len + 1);
    if (sel text.err) { ret res[extension.Selection, Refusal].err{Refusal.alloc{text.err}}; }
    var i: usize = 0;
    for (i < spelling.len) {
        text.ok[i] = spelling.data[i];
        i          = i + 1;
    }
    val made: res[extension.Selection, extension.Error] = extension.select(a, s.extensions, text.ok, diagnostic.START);
    allocator.deallocate[char](a, text.ok, spelling.len + 1);
    if (sel made.err) {
        if (sel made.err.memory)  { ret res[extension.Selection, Refusal].err{Refusal.alloc{made.err.memory}}; }
        if (sel made.err.refused) { ret res[extension.Selection, Refusal].err{Refusal.spelled{made.err.refused.message}}; }
        ret res[extension.Selection, Refusal].err{Refusal.opened{basis.Error.extensions{made.err}}};
    }
    ret res[extension.Selection, Refusal].ok{made.ok};
}

# the atoms of `s` the selection `of` does not hold, into `out`
fun past(s: *extension.Selection, of: *extension.Selection, out: *vector.Vector[requirement.Id]) err[allocator.Error] {
    var id: requirement.Id = 0;
    for (id < s.catalog.count) {
        if (extension.has(s, id) && !extension.has(of, id)) {
            val pushed: res[usize, allocator.Error] = vector.push[requirement.Id](out, id);
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        }
        id = id + 1;
    }
    ret err[allocator.Error].ok{};
}

# what `h` adds written into it: its atoms and those of them that gate timing
fun noted(a: *allocator.Allocator, s: *mset.Set, h: *Head) err[allocator.Error] {
    var added: vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?added); }
    var gated: vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?gated); }
    val listed: err[allocator.Error] = past(h.context.selection, h.over.selection, ?added);
    if (sel listed.err) { ret listed; }
    # each answer scans the set's rows, so a head asks it of each atom once
    var i: usize = 0;
    for (i < added.len) {
        if (mset.gates_timing(s, added.data[i])) {
            val pushed: res[usize, allocator.Error] = vector.push[requirement.Id](?gated, added.data[i]);
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        }
        i = i + 1;
    }
    val kept: res[Slice[requirement.Id], allocator.Error] = slice.copy[requirement.Id](a, Slice[requirement.Id]{data: added.data, size: added.len});
    if (sel kept.err) { ret err[allocator.Error].err{kept.err}; }
    h.added = kept.ok;
    val also: res[Slice[requirement.Id], allocator.Error] = slice.copy[requirement.Id](a, Slice[requirement.Id]{data: gated.data, size: gated.len});
    if (sel also.err) { ret err[allocator.Error].err{also.err}; }
    h.gated = also.ok;
    ret err[allocator.Error].ok{};
}

# `one` made the head `chosen` is the selection of, over `ctx`
fun made(a: *allocator.Allocator, s: *mset.Set, t: *Target, ctx: *core_state.Context, chosen: *extension.Selection, one: *Head) err[Refusal] {
    var i: u32 = 0;
    for (i < chosen.stated.len) {
        if (!core_state.holds(ctx, chosen.stated.at[i])) { ret err[Refusal].err{Refusal.stated{}}; }
        i = i + 1;
    }
    var ids: vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?ids); }
    val listed: err[allocator.Error] = past(chosen, ctx.selection, ?ids);
    if (sel listed.err) { ret err[Refusal].err{Refusal.alloc{listed.err}}; }
    if (ids.len == 0)   { ret err[Refusal].ok{}; }
    val opened: err[Refusal] = widened(?one.widened, a, t, ctx, requirement.Ids{at: ids.data, len: ids.len::u32});
    if (sel opened.err) { ret opened; }
    one.context = ?one.widened.context;
    val kept: err[allocator.Error] = noted(a, s, one);
    if (sel kept.err) { ret err[Refusal].err{Refusal.alloc{kept.err}}; }
    ret err[Refusal].ok{};
}

# the head `spelling` read over `ctx`, the context of a function of target `t`
# ---
# ret: the head, held by `h`, or why it was not read
pub fun of(h: *Heads, t: *Target, ctx: *core_state.Context, spelling: View) res[*Head, Refusal] {
    var k: usize = 0;
    for (k < h.held.len) {
        if (h.held.data[k].over == ctx && slice.same_view(h.held.data[k].spelling, spelling)) { ret res[*Head, Refusal].ok{h.held.data[k]}; }
        k = k + 1;
    }
    val a:   *allocator.Allocator        = h.a;
    val set: res[*mset.Set, basis.Error] = basis.set_of(t);
    if (sel set.err) { ret res[*Head, Refusal].err{Refusal.opened{set.err}}; }
    val read: res[extension.Selection, Refusal] = spelled(a, set.ok, spelling);
    if (sel read.err) { ret res[*Head, Refusal].err{read.err}; }
    var chosen: extension.Selection = read.ok;
    fin { extension.release(?chosen); }
    val room: res[*Head, allocator.Error] = allocator.allocate[Head](a, 1);
    if (sel room.err) { ret res[*Head, Refusal].err{Refusal.alloc{room.err}}; }
    val one:  *Head                      = room.ok;
    val text: res[View, allocator.Error] = slice.copy_view(a, spelling);
    if (sel text.err) {
        allocator.deallocate[Head](a, one, 1);
        ret res[*Head, Refusal].err{Refusal.alloc{text.err}};
    }
    one.spelling = text.ok;
    one.over     = ctx;
    one.context  = ctx;
    one.added    = Slice[requirement.Id]{data: nil, size: 0};
    one.gated    = Slice[requirement.Id]{data: nil, size: 0};
    val done: err[Refusal] = made(a, set.ok, t, ctx, ?chosen, one);
    if (sel done.err) {
        release_one(a, one);
        ret res[*Head, Refusal].err{done.err};
    }
    val kept: res[usize, allocator.Error] = vector.push[*Head](?h.held, one);
    if (sel kept.err) {
        release_one(a, one);
        ret res[*Head, Refusal].err{Refusal.alloc{kept.err}};
    }
    ret res[*Head, Refusal].ok{one};
}

# how a walk reads the code of one function
# ---
# context: the context it decodes under, the function's where no head adds anything
# gated:   the atoms past the function's its heads add that gate timing, each a head states
# widened: what `context` stands in where the function's heads add something
# ids:     the atoms they add
# held:    the storage of `gated`
pub rec Reading {
    context: *core_state.Context;
    gated:   requirement.Ids;
    widened: Widened;
    ids:     vector.Vector[requirement.Id];
    held:    vector.Vector[requirement.Id];
}

# give back what a reading holds
pub fun finish(r: *Reading, over: *core_state.Context) {
    if (r.context != over) { basis.narrow(?r.widened); }
    vector.dnit[requirement.Id](?r.ids);
    vector.dnit[requirement.Id](?r.held);
}

fun added_to(out: *vector.Vector[requirement.Id], s: Slice[requirement.Id]) err[allocator.Error] {
    var i: usize = 0;
    for (i < s.size) {
        val pushed: res[usize, allocator.Error] = vector.push[requirement.Id](out, s.data[i]);
        if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# what the head of the block of instruction `d`, if it has one, adds written into `r`
fun gathered(r: *Reading, h: *Heads, t: *Target, ctx: *core_state.Context, d: *InstructionData) err[Refusal] {
    if (d.opcode.index != opcode.ASM.index || d.immediates.len == 0) { ret err[Refusal].ok{}; }
    val imm: opcode.Immediate = d.immediates.data[0];
    if (!(sel imm.assembly)) { ret err[Refusal].ok{}; }
    val b: *Assembly = imm.assembly;
    if (b.selection.len == 0) { ret err[Refusal].ok{}; }
    val one: res[*Head, Refusal] = of(h, t, ctx, b.selection);
    if (sel one.err) { ret err[Refusal].err{one.err}; }
    val listed: err[allocator.Error] = added_to(?r.ids, one.ok.added);
    if (sel listed.err) { ret err[Refusal].err{Refusal.alloc{listed.err}}; }
    val gated: err[allocator.Error] = added_to(?r.held, one.ok.gated);
    if (sel gated.err) { ret err[Refusal].err{Refusal.alloc{gated.err}}; }
    ret err[Refusal].ok{};
}

# `r` made how a walk reads the code of a function of body `b` and context
# `ctx`, every head in its blocks read through `h`
# ---
# r:   where it is made, given back with `finish`, with `ctx`, whatever this answers
# ret: ok, or why not, as heads two blocks of the function state that no one
#      context holds
pub fun read(r: *Reading, h: *Heads, t: *Target, b: *Body, ctx: *core_state.Context) err[Refusal] {
    r.context = ctx;
    r.gated   = requirement.NO_IDS;
    r.ids     = vector.init[requirement.Id](h.a);
    r.held    = vector.init[requirement.Id](h.a);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                val got: err[Refusal] = gathered(r, h, t, ctx, ?b.instructions.data[list.data[i].index]);
                if (sel got.err) { ret got; }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    r.gated = requirement.Ids{at: r.held.data, len: r.held.len::u32};
    if (r.ids.len == 0) { ret err[Refusal].ok{}; }
    val opened: err[Refusal] = widened(?r.widened, h.a, t, ctx, requirement.Ids{at: r.ids.data, len: r.ids.len::u32});
    if (sel opened.err) { ret opened; }
    r.context = ?r.widened.context;
    ret err[Refusal].ok{};
}
