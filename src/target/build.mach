# what a build holds of its target once the family serving it opened it
#
# a build exists only once a family's open succeeds, so every field is
# stated: the selection, every convention row of the target resolved through
# it, mink's format registry and what the family keeps of its own. it is made
# in place, since the conventions point into the basis, and only the family
# that opened it closes it.

use std.types.option.opt;
use std.types.size.usize;
use std.types.view.View;

use std.collections.slice.Slice;

use mink.format.registry;

use mirl.target.abi.convention;
use mirl.target.abi.convention.Registers;
use mirl.target.abi.convention.Resolved;
use mirl.target.basis.Basis;

# a build of a target
# ---
# basis:       the one selection and context every consumer reads
# conventions: every convention row of the target resolved through that
#              context, its default first and then its other rows in order
# formats:     mink's format registry, built once per build and lent to
#              whatever writes or reads an object of it
# state:       what the family that opened the build keeps of its own, which
#              only that family reads and gives back, nil when it keeps none
pub rec Build {
    basis:       Basis;
    conventions: Slice[Resolved];
    formats:     registry.Registry;
    state:       ptr;
}

# the target's default convention row, resolved
pub fun default_row(b: *Build) *Resolved {
    ret ?b.conventions.data[0];
}

# the registers of the target's default convention row, nil for a row with
# no register file, which a register machine's build never has
pub fun registers(b: *Build) *Registers {
    ret convention.held(default_row(b));
}

# the index in `conventions` of the row a function type's convention name
# picks, none when the target states no row of it
pub fun index_of(b: *Build, name: View) opt[usize] {
    val d: convention.Declared = b.basis.target.convention;
    if (!(sel d.rows)) { ret opt[usize].none{}; }
    var rows: convention.Conventions = d.rows;
    val at:   opt[usize]             = convention.position(?rows, name);
    if (sel at.none)                   { ret opt[usize].none{}; }
    if (at.some >= b.conventions.size) { ret opt[usize].none{}; }
    ret at;
}

# the resolved row a function type's convention name picks, none when the
# target states no row of it
pub fun under(b: *Build, name: View) opt[*Resolved] {
    val at: opt[usize] = index_of(b, name);
    if (sel at.none) { ret opt[*Resolved].none{}; }
    ret opt[*Resolved].some{?b.conventions.data[at.some]};
}
