# what a build holds of its target once the family serving it opened it
#
# a build exists only once a family's open succeeds, so every field is
# stated: the selection, the convention resolved through it, and what the
# family keeps of its own. it is made in place, since the convention points
# into the family's state, and only the family that opened it closes it.

use mirl.target.abi.convention.Resolved;
use mirl.target.basis.Basis;

# a build of a target
# ---
# basis:      the one selection every consumer reads
# convention: the calling convention resolved through that selection
# state:      what the family that opened the build keeps of its own, which
#             only that family reads and gives back
pub rec Build {
    basis:      Basis;
    convention: Resolved;
    state:      ptr;
}
