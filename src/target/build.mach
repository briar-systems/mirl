# what a build holds of its target once the family serving it opened it
#
# a build exists only once a family's open succeeds, so every field is
# stated: the selection, the convention resolved through it, mink's format
# registry and what the family keeps of its own. it is made in place, since
# the convention points into the basis, and only the family that opened it
# closes it.

use mink.format.registry;

use mirl.target.abi.convention.Resolved;
use mirl.target.basis.Basis;

# a build of a target
# ---
# basis:      the one selection and context every consumer reads
# convention: the calling convention resolved through that context
# formats:    mink's format registry, built once per build and lent to
#             whatever writes or reads an object of it
# state:      what the family that opened the build keeps of its own, which
#             only that family reads and gives back, nil when it keeps none
pub rec Build {
    basis:      Basis;
    convention: Resolved;
    formats:    registry.Registry;
    state:      ptr;
}
