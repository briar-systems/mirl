use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.base.fail.Fail;
use mink.bytes.compress.Method;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.output;
use mink.catalog.subsystem.Subsystem;
use mink.format.contract;
use mink.format.registry;
use mink.link.input.Given;
use mink.link.input.Request;
use mink.link.input.Source;
use link_options: mink.link.options;
use mink.link.search;
use link_state: mink.link.state;
use mink.link.write.Written;
use mink.model.object;

use masc.core.ct;

use mct: mirl.ct;
use mirl.ct.oblivious;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.pass.driver;
use mirl.pass.failure;
use mirl.target.basis.Basis;
use mirl.target.build.Build;
use mirl.target.families;
use mirl.target.families.Owners;
use mirl.target.family;
use mirl.target.family.Error;
use mirl.target.family.Family;
use mirl.target.family.Foreign;
use mirl.target.options.Options;
use mirl.target.options.Output;
use mirl.target.record;
use mirl.target.record.Target;
use mirl.target.warning.Warning;
use mirl.target.widening;
use mirl.target.widening.Unwidened;
use mirl.target.widening.Widenings;

# a target made ready once per build, which every module the build compiles
# for it reads: the one family that serves it, the owners of the registry's
# opcode rows and the build the family opened, with its format registry and
# what the family keeps of its own. the caller makes it with `init` before
# its first module, hands it to `compile` and `write` for each, and gives it
# back with `dnit` after its last. it is made in place and stays put until
# `dnit`, since the build points into itself
# ---
# target: the target, which outlives it
# family: the family that serves the target
# owners: the owners of the registry's opcode rows
# build:  the build the family opened for the target
# found:  what mink's link of an image holds, the names its refusal carries,
#         so a refusal `write` returns holds until `dnit`
pub rec Prepared {
    target: *Target;
    family: *Family;
    owners: Owners;
    build:  Build;
    found:  search.Found;
}

# make a target ready over mirl's registry, once per build
# ---
# p:     where it is made, and stays until `dnit`
# a:     the allocator the owners index and the build take
# t:     the target, which outlives it
# added: extension names the build adds to the target's baseline
# ret:   ok, or why it was not made, leaving nothing to close
pub fun init(p: *Prepared, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    ret init_in(p, families.rows(), a, t, added);
}

# make a target ready over a registry of families, once per build: a target
# no one family serves is refused, and so is one whose index of the owners of
# the opcode rows the allocator refuses storage for
# ---
# p:        where it is made, and stays until `dnit`
# registry: the families, which outlive it
# a:        the allocator the owners index and the build take
# t:        the target, which outlives it
# added:    extension names the build adds to the target's baseline
# ret:      ok, or why it was not made, leaving nothing to close
pub fun init_in(p: *Prepared, registry: Slice[*Family], a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val res_served: res[*Family, Error] = families.serving(registry, ?t.caps);
    if (sel res_served.err) { ret err[Error].err{res_served.err}; }
    val res_built: res[Owners, Error] = families.owners(a, registry);
    if (sel res_built.err) { ret err[Error].err{res_built.err}; }
    p.target = t;
    p.family = res_served.ok;
    p.owners = res_built.ok;
    val err_opened: err[Error] = p.family.open(?p.build, a, t, added);
    if (sel err_opened.err) {
        families.dnit(?p.owners);
        ret err_opened;
    }
    p.found = search.init(a);
    ret err[Error].ok{};
}

# give back what `init` made, once no module is being compiled over it
pub fun dnit(p: *Prepared) {
    val err_dropped: err[Fail] = search.dnit(?p.found);
    p.family.close(?p.build);
    families.dnit(?p.owners);
}

# what a compilation made: the object and the warnings it gave, which the
# caller owns and gives back with `compiled_dnit`
# ---
# object:   mink's object in memory
# warnings: the warnings the compilation gave, in the order it gave them
pub rec Compiled {
    object:   object.Object;
    warnings: vector.Vector[Warning];
}

# compile a module for a prepared target. a checked build refuses a module
# holding an opcode row the target does not admit before the schedule, and one
# the schedule left holding such a row before the back end. the object states
# the target's operating system and environment whatever family made it. a
# warning is returned with the object, never written, and a refused module
# returns none
# ---
# p:   the target, made ready for the build
# a:   the allocator every stage, the object and the warnings take
# m:   the module, which the pass schedule rewrites
# o:   the setting, whether it is checked, and the texts it writes besides the object
# ret: the object and the warnings, or why it was not made
pub fun compile(p: *Prepared, a: *allocator.Allocator, m: *Module, o: Options) res[Compiled, Error] {
    val f: *Family = p.family;
    # a listing asked of a family that writes none is refused, never written empty
    if (sel o.listing.some && !f.lists) { ret res[Compiled, Error].err{Error.unlisted{}}; }
    var w:          Widenings;
    val err_scoped: err[Error] = widen(p, a, m, ?w);
    fin { widening.dnit(?w); }
    if (sel err_scoped.err) { ret res[Compiled, Error].err{err_scoped.err}; }
    var warnings:      vector.Vector[Warning] = vector.init[Warning](a);
    val err_scheduled: err[Error]             = optimise(p, m, o, ?w, ?warnings);
    if (sel err_scheduled.err) {
        vector.dnit[Warning](?warnings);
        ret res[Compiled, Error].err{err_scheduled.err};
    }
    val res_timed: res[opt[mct.Refused], allocator.Error] = gate(a, m, ?p.build);
    if (sel res_timed.err) {
        vector.dnit[Warning](?warnings);
        ret res[Compiled, Error].err{Error.alloc{res_timed.err}};
    }
    if (sel res_timed.ok.some) {
        vector.dnit[Warning](?warnings);
        ret res[Compiled, Error].err{Error.timing{res_timed.ok.some}};
    }
    val res_made: res[object.Object, Error] = f.back(a, m, ?p.build, p.target, o, ?w, ?warnings);
    if (sel res_made.err) {
        vector.dnit[Warning](?warnings);
        ret res[Compiled, Error].err{res_made.err};
    }
    var obj: object.Object = res_made.ok;
    record.state(p.target, ?obj.target);
    ret res[Compiled, Error].ok{Compiled{object: obj, warnings: warnings}};
}

# the selection each function of `m` stands on, the module's table made in
# place of `w` before the schedule, which the schedule and the back end read.
# `widening.dnit` gives it back, refused or not
# ---
# p:   the target, made ready for the build, whose family decides whether any set is opened
# a:   the allocator the table's storage comes from
# m:   the module
# w:   where the table is made
# ret: ok, or the first function whose extensions were not opened
pub fun widen(p: *Prepared, a: *allocator.Allocator, m: *Module, w: *Widenings) err[Error] {
    val err_opened: err[Unwidened] = widening.init(w, a, opt[*Basis].some{?p.build.basis}, p.family.widens, m);
    if (sel err_opened.err) { ret err[Error].err{Error.widened{err_opened.err}}; }
    ret err[Error].ok{};
}

# give back what a compilation made: its object and its warnings
pub fun compiled_dnit(c: *Compiled) {
    object.dnit(?c.object);
    vector.dnit[Warning](?c.warnings);
}

# run the pass schedule a prepared target runs over a module, without
# compiling it: the neutral prefix and the family's rows over the build. a
# checked build refuses a module holding an opcode row the target does not
# admit before the schedule, and one the schedule left holding such a row
# after it. the caller upholds that rule, so an unchecked build reads neither
# ---
# p:        the target, made ready for the build
# m:        the module, which the schedule rewrites
# o:        how the module is compiled, of which the schedule reads the
#           setting, whether every pass is verified, the float relaxations
#           and the counters it fills
# w:        the module's table, from `widen`, whose function passes each read
#           the selection their function stands on
# warnings: the list the schedule's passes append the warnings they give to
# ret:      ok, or why the schedule refused the module
pub fun optimise(p: *Prepared, m: *Module, o: Options, w: *Widenings, warnings: *vector.Vector[Warning]) err[Error] {
    val options:    driver.Options = driver.Options{optimise: o.optimise, checked: o.checked, floats: o.floats, stats: o.stats, warnings: warnings, widenings: opt[*Widenings].some{w}};
    val opt_family: opt[*Family]   = opt[*Family].some{p.family};
    if (options.checked) {
        val opt_held: opt[Foreign] = families.foreign(?p.owners, opt_family, m);
        if (sel opt_held.some) { ret err[Error].err{Error.foreign{opt_held.some}}; }
    }
    val err_ran: err[failure.Error] = driver.drive_family(m, p.target, ?p.build, p.family.legal, options);
    if (sel err_ran.err) { ret err[Error].err{Error.schedule{err_ran.err}}; }
    if (sel options.stats.some) {
        val size: module.Size = module.size(m);
        options.stats.some.functions    = size.functions::u64;
        options.stats.some.instructions = size.instructions::u64;
    }
    if (options.checked) {
        val opt_left: opt[Foreign] = families.foreign(?p.owners, opt_family, m);
        if (sel opt_left.some) { ret err[Error].err{Error.introduced{opt_left.some}}; }
    }
    ret err[Error].ok{};
}

# the constant-time gate of a scheduled module: the first function that
# requires constant time refused whole when the build's set classifies no
# timing, else the first secret the oblivious check finds where it may be none
fun gate(a: *allocator.Allocator, m: *Module, b: *Build) res[opt[mct.Refused], allocator.Error] {
    val opt_held: opt[Function] = oblivious.requires(m);
    if (sel opt_held.none) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].none{}}; }
    val asked: ct.Required = ct.required(b.basis.set.ct);
    if (sel asked.refused) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].some{mct.refused(opt_held.some, mct.Where.whole{}, asked.refused, mct.location(m, opt_held.some))}}; }
    ret oblivious.module_check(a, m);
}

# write an object in the object format of the target's system, through the
# build's format registry: as the object it is, or where the output is the
# final image and the object is relocatable, as the module mink's link makes
# of it alone
# ---
# p:      the target the object was made for, made ready for the build
# a:      the allocator the format's model and its bytes take
# o:      the object, as compile made it
# output: what is written, the output compile was asked for
# w:      where the bytes are written
# ret:    ok, or why nothing or only part was written
pub fun write(p: *Prepared, a: *allocator.Allocator, o: *object.Object, output: Output, w: *io.Writer) err[Error] {
    val format: *Format = record.format(p.target);
    if (sel output.image && o.kind == ?catalog_kind.RELOCATABLE) { ret linked(p, a, o, w); }
    val res_built: res[contract.Model, Fail] = registry.from_neutral(p.build.formats, a, format, o);
    if (sel res_built.err) { ret err[Error].err{Error.format{res_built.err}}; }
    var model: contract.Model = res_built.ok;
    fin { contract.dnit(?model); }
    val res_laid: res[Sink, Fail] = contract.write(?model);
    if (sel res_laid.err) { ret err[Error].err{Error.format{res_laid.err}}; }
    var bytes: Sink = res_laid.ok;
    fin { sink.dnit(?bytes); }
    val err_wrote: err[io.WriteError] = io.write_all(w, sink.data(?bytes), sink.len(?bytes));
    if (sel err_wrote.err) { ret err[Error].err{Error.write{err_wrote.err}}; }
    ret err[Error].ok{};
}

# the module mink's link makes of the relocatable object `o` alone, for the
# target mink's catalog resolved, written whole
fun linked(p: *Prepared, a: *allocator.Allocator, o: *object.Object, w: *io.Writer) err[Error] {
    val options: link_options.Options = link_options.Options{
        kind:             ?output.MODULE,
        target:           p.target.resolved,
        version:          opt[os.Version].none{},
        sdk:              opt[os.Version].none{},
        subsystem:        opt[*Subsystem].none{},
        entry:            nil,
        keep:             nil,
        keep_count:       0,
        sections:         nil,
        section_count:    0,
        base:             opt[u64].none{},
        regions:          nil,
        region_count:     0,
        runs:             nil,
        run_count:        0,
        loads:            nil,
        load_count:       0,
        offsets:          nil,
        offset_count:     0,
        size:             opt[u64].none{},
        fill:             opt[u8].none{},
        stack_reserve:    opt[u64].none{},
        stack_commit:     opt[u64].none{},
        gc_sections:      opt[bool].none{},
        keep_temporaries: opt[bool].none{},
        tail_merge:       opt[bool].none{},
        output:           "module",
        sign:             opt[bool].none{},
        compress:         opt[*Method].none{},
        sysroot:          nil,
        libdirs:          nil,
        libdir_count:     0,
        fwdirs:           nil,
        fwdir_count:      0,
    };
    var request: Request = Request.source{Source.object{Given{name: "module", object: o}}};
    var notes:   Sink    = sink.init(a, LITTLE);
    fin { val err_dropped: err[Fail] = sink.dnit(?notes); }
    val res_made: res[Written, Fail] = link_state.link(?p.found, p.build.formats, options, ?request, 1, ?notes);
    if (sel res_made.err) { ret err[Error].err{Error.link{res_made.err}}; }
    var written: Written = res_made.ok;
    fin {
        val err_image: err[Fail] = sink.dnit(?written.image);
        if (sel written.interface.some) { val err_face: err[Fail] = sink.dnit(?written.interface.some); }
    }
    val err_wrote: err[io.WriteError] = io.write_all(w, sink.data(?written.image), sink.len(?written.image));
    if (sel err_wrote.err) { ret err[Error].err{Error.write{err_wrote.err}}; }
    ret err[Error].ok{};
}
