use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.base.fail;
use mink.base.fail.Detached;
use mink.base.fail.Fail;
use mink.bytes.compress.Method;
use mink.bytes.reader.LITTLE;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use catalog_kind: mink.catalog.kind;
use mink.catalog.os;
use mink.catalog.output;
use mink.catalog.subsystem.Subsystem;
use mink.format.contract;
use mink.format.registry;
use mink.link.input.Claimant;
use mink.link.input.Given;
use mink.link.input.Source;
use link_options: mink.link.options;
use link_state:   mink.link.state;
use mink.link.write.Written;
use mink.model.claim.Claim;
use mink.model.object;

use masc.core.ct;

use mct: mirl.ct;
use mirl.ct.oblivious;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.pass;
use mirl.target.Target;
use mirl.target.build.Build;
use mirl.target.families;
use mirl.target.families.Owners;
use mirl.target.family;
use mirl.target.family.Error;
use mirl.target.family.Family;
use mirl.target.family.Foreign;
use mirl.target.options.Options;
use mirl.target.options.Output;
use mirl.target.record;
use mirl.target.warning.Warning;

# a target made ready once per build, which every module the build compiles
# for it reads: the one family that serves it, the owners of the registry's
# opcode rows and the build the family opened, with its format registry and
# what the family keeps of its own. the caller makes it with `open` before
# its first module, hands it to `compile` and `write` for each, and gives it
# back with `close` after its last. it is made in place and stays put until
# `close`, since the build points into itself
# ---
# target: the target, which outlives it
# family: the family that serves the target
# owners: the owners of the registry's opcode rows
# build:  the build the family opened for the target
pub rec Prepared {
    target: *Target;
    family: *Family;
    owners: Owners;
    build:  Build;
}

# make a target ready over mirl's registry, once per build
# ---
# p:     where it is made, and stays until `close`
# a:     the allocator the owners index and the build take
# t:     the target, which outlives it
# added: extension names the build adds to the target's baseline
# ret:   ok, or why it was not made, leaving nothing to close
pub fun open(p: *Prepared, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    ret open_in(p, families.rows(), a, t, added);
}

# make a target ready over a registry of families, once per build: a target
# no one family serves is refused, and so is a registry whose listings give
# no owners of the opcode rows
# ---
# p:        where it is made, and stays until `close`
# registry: the families, which outlive it
# a:        the allocator the owners index and the build take
# t:        the target, which outlives it
# added:    extension names the build adds to the target's baseline
# ret:      ok, or why it was not made, leaving nothing to close
pub fun open_in(p: *Prepared, registry: Slice[*Family], a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val served: res[*Family, Error] = families.serving(registry, ?t.caps);
    if (sel served.err) { ret err[Error].err{served.err}; }
    val built: res[Owners, Error] = families.owners(a, registry);
    if (sel built.err) { ret err[Error].err{built.err}; }
    p.target = t;
    p.family = served.ok;
    p.owners = built.ok;
    val opened: err[Error] = p.family.open(?p.build, a, t, added);
    if (sel opened.err) {
        families.release(?p.owners);
        ret opened;
    }
    ret err[Error].ok{};
}

# give back what `open` made, once no module is being compiled over it
pub fun close(p: *Prepared) {
    p.family.close(?p.build);
    families.release(?p.owners);
}

# what a compilation made: the object and the warnings it gave, which the
# caller owns and gives back with `release`
# ---
# object:   mink's object in memory
# warnings: the warnings the compilation gave, in the order it gave them
pub rec Compiled {
    object:   object.Object;
    warnings: vector.Vector[Warning];
}

# compile a module for a prepared target. a checked build refuses a module
# holding an opcode row the target does not admit before the schedule, and one
# the schedule left holding such a row before the back end. the object states
# the target's operating system and environment whatever family made it. a
# warning is returned with the object, never written, and a refused module
# returns none
# ---
# p:   the target, made ready for the build
# a:   the allocator every stage, the object and the warnings take
# m:   the module, which the pass schedule rewrites
# o:   the level, whether it is checked, and the texts it writes besides the object
# ret: the object and the warnings, or why it was not made
pub fun compile(p: *Prepared, a: *allocator.Allocator, m: *Module, o: Options) res[Compiled, Error] {
    val f:         *Family    = p.family;
    val scheduled: err[Error] = optimise(p, m, o);
    if (sel scheduled.err) { ret res[Compiled, Error].err{scheduled.err}; }
    val timed: res[opt[mct.Refused], allocator.Error] = gate(a, m, ?p.build);
    if (sel timed.err)     { ret res[Compiled, Error].err{Error.alloc{timed.err}}; }
    if (sel timed.ok.some) { ret res[Compiled, Error].err{Error.timing{timed.ok.some}}; }
    var warnings: vector.Vector[Warning]    = vector.init[Warning](a);
    val made:     res[object.Object, Error] = f.back(a, m, ?p.build, p.target, o, ?warnings);
    if (sel made.err) {
        vector.dnit[Warning](?warnings);
        ret res[Compiled, Error].err{made.err};
    }
    var obj: object.Object = made.ok;
    record.state(p.target, ?obj.target);
    ret res[Compiled, Error].ok{Compiled{object: obj, warnings: warnings}};
}

# give back what a compilation made: its object and its warnings
pub fun release(c: *Compiled) {
    object.release(?c.object);
    vector.dnit[Warning](?c.warnings);
}

# run the pass schedule a prepared target runs over a module, without
# compiling it: the neutral prefix and the family's rows over the build. a
# checked build refuses a module holding an opcode row the target does not
# admit before the schedule, and one the schedule left holding such a row
# after it. the caller upholds that rule, so an unchecked build reads neither
# ---
# p:   the target, made ready for the build
# m:   the module, which the schedule rewrites
# o:   how the module is compiled, of which the schedule reads the
#      level, whether every pass is verified, the float relaxations and
#      the counters it fills
# ret: ok, or why the schedule refused the module
pub fun optimise(p: *Prepared, m: *Module, o: Options) err[Error] {
    val options: pass.Options = pass.Options{level: o.level, checked: o.checked, floats: o.floats, stats: o.stats};
    val f:       opt[*Family] = opt[*Family].some{p.family};
    if (options.checked) {
        val held: opt[Foreign] = families.foreign(?p.owners, f, m);
        if (sel held.some) { ret err[Error].err{Error.foreign{held.some}}; }
    }
    val ran: err[pass.Error] = pass.drive_family(m, p.target, ?p.build, p.family.legal, options);
    if (sel ran.err) { ret err[Error].err{Error.schedule{ran.err}}; }
    if (sel options.stats.some) {
        val size: module.Size = module.size(m);
        options.stats.some.functions    = size.functions::u64;
        options.stats.some.instructions = size.instructions::u64;
    }
    if (options.checked) {
        val left: opt[Foreign] = families.foreign(?p.owners, f, m);
        if (sel left.some) { ret err[Error].err{Error.introduced{left.some}}; }
    }
    ret err[Error].ok{};
}

# the constant-time gate of a scheduled module: the first function that
# requires constant time refused whole when the build's set classifies no
# timing, else the first secret the oblivious check finds where it may be none
fun gate(a: *allocator.Allocator, m: *Module, b: *Build) res[opt[mct.Refused], allocator.Error] {
    val held: opt[Function] = oblivious.requires(m);
    if (sel held.none) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].none{}}; }
    val asked: ct.Required = ct.required(b.basis.set.ct);
    if (sel asked.refused) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].some{mct.refused(held.some, mct.Where.whole{}, asked.refused, mct.location(m, held.some))}}; }
    ret oblivious.module_check(a, m);
}

# write an object in the object format of the target's system, through the
# build's format registry: as the object it is, or where the output is the
# final image and the object is relocatable, as the module mink's link makes
# of it alone
# ---
# p:      the target the object was made for, made ready for the build
# a:      the allocator the format's model and its bytes take
# o:      the object, as compile made it
# output: what is written, the output compile was asked for
# w:      where the bytes are written
# ret:    ok, or why nothing or only part was written
pub fun write(p: *Prepared, a: *allocator.Allocator, o: *object.Object, output: Output, w: *io.Writer) err[Error] {
    val format: *Format = record.format(p.target);
    if (sel output.image && o.kind == ?catalog_kind.RELOCATABLE) { ret linked(p, a, o, w); }
    val built: res[contract.Model, Fail] = registry.from_neutral(p.build.formats, format, a, o);
    if (sel built.err) { ret err[Error].err{Error.format{built.err}}; }
    var model: contract.Model = built.ok;
    fin { contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret err[Error].err{Error.format{laid.err}}; }
    var bytes: Sink = laid.ok;
    fin { sink.release(?bytes); }
    val wrote: err[io.WriteError] = io.write_all(w, sink.data(?bytes), sink.len(?bytes));
    if (sel wrote.err) { ret err[Error].err{Error.write{wrote.err}}; }
    ret err[Error].ok{};
}

# refuse every claim of a link, as an object compile makes names no library
fun unclaimed(context: ptr, c: *Claim, out: *vector.Vector[Source]) err[Fail] {
    ret err[Fail].err{fail.unsupported("the object names a library, which a link of it alone does not find")};
}

# the module mink's link makes of the relocatable object `o` alone, for the
# target mink's catalog resolved, written whole
fun linked(p: *Prepared, a: *allocator.Allocator, o: *object.Object, w: *io.Writer) err[Error] {
    val options: link_options.Options = link_options.Options{
        kind:             ?output.MODULE,
        target:           p.target.resolved,
        version:          opt[os.Version].none{},
        sdk:              opt[os.Version].none{},
        subsystem:        opt[*Subsystem].none{},
        entry:            nil,
        keep:             nil,
        keep_count:       0,
        sections:         nil,
        section_count:    0,
        base:             opt[u64].none{},
        regions:          nil,
        region_count:     0,
        runs:             nil,
        run_count:        0,
        loads:            nil,
        load_count:       0,
        offsets:          nil,
        offset_count:     0,
        size:             opt[u64].none{},
        fill:             opt[u8].none{},
        stack_reserve:    opt[u64].none{},
        stack_commit:     opt[u64].none{},
        gc_sections:      opt[bool].none{},
        keep_temporaries: opt[bool].none{},
        tail_merge:       opt[bool].none{},
        output:           "module",
        sign:             opt[bool].none{},
        compress:         opt[*Method].none{},
        sysroot:          nil,
        libdirs:          nil,
        libdir_count:     0,
        fwdirs:           nil,
        fwdir_count:      0,
        timing_mode:      false,
    };
    var source:   Source   = Source.object{Given{name: "module", object: o}};
    var claimant: Claimant = Claimant{context: nil, find: unclaimed};
    var notes:    Sink     = sink.make(a, LITTLE);
    fin { val dropped: err[Fail] = sink.release(?notes); }
    val made: res[Written, Detached] = link_state.link(a, p.build.formats, options, ?source, 1, ?claimant, ?notes);
    if (sel made.err) { ret err[Error].err{Error.link{made.err}}; }
    var written: Written = made.ok;
    fin {
        val image: err[Fail] = sink.release(?written.image);
        if (sel written.interface.some) { val face: err[Fail] = sink.release(?written.interface.some); }
    }
    val wrote: err[io.WriteError] = io.write_all(w, sink.data(?written.image), sink.len(?written.image));
    if (sel wrote.err) { ret err[Error].err{Error.write{wrote.err}}; }
    ret err[Error].ok{};
}
