use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use io: std.io.writer;

use mink.base.fail.Fail;
use mink.bytes.sink;
use mink.bytes.sink.Sink;
use mink.catalog.format.Format;
use mink.format.contract;
use mink.format.registry;
use mink.model.object;

use masc.core.ct;

use mct: mirl.ct;
use mirl.ct.oblivious;
use mirl.ir.debug.Location;
use mirl.ir.id.Function;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.pass;
use mirl.target.Target;
use mirl.target.build.Build;
use mirl.target.families;
use mirl.target.families.Owners;
use mirl.target.family;
use mirl.target.family.Family;
use mirl.target.record;

fwd family.Options;
fwd family.RELAX;
fwd family.Output;
fwd family.Error;
fwd family.Back;
fwd family.Unserved;
fwd family.Listing;
fwd family.Foreign;
fwd mirl.machine.emit.handover.Apart;
fwd mirl.machine.emit.handover.SHARED;

# a target made ready once per build, which every module the build compiles
# for it reads: the one family that serves it, the owners of the registry's
# opcode rows and the build the family opened, with its format registry and
# what the family keeps of its own. the caller makes it with `open` before
# its first module, hands it to `compile` and `write` for each, and gives it
# back with `close` after its last. it is made in place and stays put until
# `close`, since the build points into itself
# ---
# target: the target, which outlives it
# family: the family that serves the target
# owners: the owners of the registry's opcode rows
# build:  the build the family opened for the target
pub rec Prepared {
    target: *Target;
    family: *Family;
    owners: Owners;
    build:  Build;
}

# make a target ready over mirl's registry, once per build
# ---
# p:     where it is made, and stays until `close`
# a:     the allocator the owners index and the build take
# t:     the target, which outlives it
# added: extension names the build adds to the target's baseline
# ret:   ok, or why it was not made, leaving nothing to close
pub fun open(p: *Prepared, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    ret open_in(p, families.rows(), a, t, added);
}

# make a target ready over a registry of families, once per build: a target
# no one family serves is refused, and so is a registry whose listings give
# no owners of the opcode rows
# ---
# p:        where it is made, and stays until `close`
# registry: the families, which outlive it
# a:        the allocator the owners index and the build take
# t:        the target, which outlives it
# added:    extension names the build adds to the target's baseline
# ret:      ok, or why it was not made, leaving nothing to close
pub fun open_in(p: *Prepared, registry: Slice[*Family], a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val served: res[*Family, Unserved] = families.serving(registry, ?t.caps);
    if (sel served.err) { ret err[Error].err{Error.unserved{served.err}}; }
    val built: res[Owners, Listing] = families.owners(a, registry);
    if (sel built.err) { ret err[Error].err{Error.listing{built.err}}; }
    p.target = t;
    p.family = served.ok;
    p.owners = built.ok;
    val opened: err[Error] = p.family.open(?p.build, a, t, added);
    if (sel opened.err) {
        families.release(?p.owners);
        ret opened;
    }
    ret err[Error].ok{};
}

# give back what `open` made, once no module is being compiled over it
pub fun close(p: *Prepared) {
    p.family.close(?p.build);
    families.release(?p.owners);
}

# compile a module for a prepared target. a checked build refuses a module
# holding an opcode row the target does not admit before the schedule, and one
# the schedule left holding such a row before the back end. the object states
# the target's operating system and environment whatever family made it
# ---
# p:   the target, made ready for the build
# a:   the allocator every stage and the object take
# m:   the module, which the pass schedule rewrites
# o:   the level, whether it is checked, and the texts it writes besides the object
# ret: mink's object in memory, or why it was not made
pub fun compile(p: *Prepared, a: *allocator.Allocator, m: *Module, o: Options) res[object.Object, Error] {
    val f:         *Family    = p.family;
    val scheduled: err[Error] = optimise(p, m, pass.Options{level: o.level, checked: o.checked, floats: o.floats, stats: o.stats});
    if (sel scheduled.err) { ret res[object.Object, Error].err{scheduled.err}; }
    val timed: res[opt[mct.Refused], allocator.Error] = gate(a, m, ?p.build);
    if (sel timed.err)     { ret res[object.Object, Error].err{Error.alloc{timed.err}}; }
    if (sel timed.ok.some) { ret res[object.Object, Error].err{Error.timing{timed.ok.some}}; }
    val made: res[object.Object, Error] = f.back(a, m, ?p.build, p.target, o);
    if (sel made.err) { ret made; }
    var obj: object.Object = made.ok;
    record.state(p.target, ?obj.target);
    ret res[object.Object, Error].ok{obj};
}

# run the pass schedule a prepared target runs over a module, without
# compiling it: the neutral prefix and the family's rows over the build. a
# checked build refuses a module holding an opcode row the target does not
# admit before the schedule, and one the schedule left holding such a row
# after it. the caller upholds that rule, so an unchecked build reads neither
# ---
# p:       the target, made ready for the build
# m:       the module, which the schedule rewrites
# options: the level, whether every pass is verified, the float
#          relaxations and the counters it fills
# ret:     ok, or why the schedule refused the module
pub fun optimise(p: *Prepared, m: *Module, options: pass.Options) err[Error] {
    val f: opt[*Family] = opt[*Family].some{p.family};
    if (options.checked) {
        val held: opt[Foreign] = families.foreign(?p.owners, f, m);
        if (sel held.some) { ret err[Error].err{Error.foreign{held.some}}; }
    }
    val ran: err[pass.Error] = pass.drive_family(m, p.target, ?p.build, p.family.legal, options);
    if (sel ran.err) { ret err[Error].err{Error.schedule{ran.err}}; }
    if (sel options.stats.some) {
        val size: module.Size = module.size(m);
        options.stats.some.functions    = size.functions::u64;
        options.stats.some.instructions = size.instructions::u64;
    }
    if (options.checked) {
        val left: opt[Foreign] = families.foreign(?p.owners, f, m);
        if (sel left.some) { ret err[Error].err{Error.introduced{left.some}}; }
    }
    ret err[Error].ok{};
}

# the constant-time gate of a scheduled module: the first function that
# requires constant time refused whole when the build's set classifies no
# timing, else the first secret the oblivious check finds where it may be none
fun gate(a: *allocator.Allocator, m: *Module, b: *Build) res[opt[mct.Refused], allocator.Error] {
    val held: opt[Function] = oblivious.requires(m);
    if (sel held.none) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].none{}}; }
    val asked: ct.Required = ct.required(b.basis.set.ct);
    if (sel asked.refused) { ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].some{mct.refused(held.some, mct.Where.whole{}, asked.refused, opt[Location].none{})}}; }
    ret oblivious.module_check(a, m);
}

# why an object was not written
# ---
# sys:    the target's system names no row of mink's catalog, or states no object format
# format: mink does not lay out the system's format, or refused the object
# write:  the bytes were not written
pub tag Unwritten: u8 {
    sys:    record.Error;
    format: Fail;
    write:  io.WriteError;
}

# write an object in the object format of the target's system, through the
# build's format registry
# ---
# p:   the target the object was made for, made ready for the build
# a:   the allocator the format's model and its bytes take
# o:   the object, as compile made it
# w:   where the bytes are written
# ret: ok, or why nothing or only part was written
pub fun write(p: *Prepared, a: *allocator.Allocator, o: *object.Object, w: *io.Writer) err[Unwritten] {
    val format: res[*Format, record.Error] = record.format(p.target);
    if (sel format.err) { ret err[Unwritten].err{Unwritten.sys{format.err}}; }
    val built: res[contract.Model, Fail] = registry.from_neutral(?p.build.formats, format.ok, a, o);
    if (sel built.err) { ret err[Unwritten].err{Unwritten.format{built.err}}; }
    var model: contract.Model = built.ok;
    fin { contract.release(?model); }
    val laid: res[Sink, Fail] = contract.write(?model);
    if (sel laid.err) { ret err[Unwritten].err{Unwritten.format{laid.err}}; }
    var bytes: Sink = laid.ok;
    fin { sink.release(?bytes); }
    val wrote: err[io.WriteError] = io.write_all(w, sink.data(?bytes), sink.len(?bytes));
    if (sel wrote.err) { ret err[Unwritten].err{Unwritten.write{wrote.err}}; }
    ret err[Unwritten].ok{};
}
