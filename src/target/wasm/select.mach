# the wasm instruction each ir operation is at each value type, where it is one
#
# a value type is a class: i32, i64, f32 or f64. an operation that is one
# instruction of its operands' class is a row here, by its opcode, with the
# instruction of each class it is defined at. what takes more than one
# instruction, or reads its operands in another order, is the code
# emitter's own.

use std.types.bool.bool;
use std.types.option.opt;
use std.types.size.usize;

use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;

use masc.isa.wasm.gen_row_index;

# the classes, as a row's column
pub val I32: u32 = 0;
pub val I64: u32 = 1;
pub val F32: u32 = 2;
pub val F64: u32 = 3;

# no instruction at the class
pub val NO: u32 = 0xFFFF_FFFF;

# one operation and its instruction at each class
rec Simple {
    opcode: Opcode;
    at:     [4]u32;
}

val SIMPLE: [43]Simple = [43]Simple{
    Simple{opcode: opcode.ADD, at: [4]u32{gen_row_index.I32ADD, gen_row_index.I64ADD, NO, NO}},
    Simple{opcode: opcode.SUB, at: [4]u32{gen_row_index.I32SUB, gen_row_index.I64SUB, NO, NO}},
    Simple{opcode: opcode.MUL, at: [4]u32{gen_row_index.I32MUL, gen_row_index.I64MUL, NO, NO}},
    Simple{opcode: opcode.DIV_S, at: [4]u32{gen_row_index.I32DIVS, gen_row_index.I64DIVS, NO, NO}},
    Simple{opcode: opcode.DIV_U, at: [4]u32{gen_row_index.I32DIVU, gen_row_index.I64DIVU, NO, NO}},
    Simple{opcode: opcode.REM_S, at: [4]u32{gen_row_index.I32REMS, gen_row_index.I64REMS, NO, NO}},
    Simple{opcode: opcode.REM_U, at: [4]u32{gen_row_index.I32REMU, gen_row_index.I64REMU, NO, NO}},
    Simple{opcode: opcode.AND, at: [4]u32{gen_row_index.I32AND, gen_row_index.I64AND, NO, NO}},
    Simple{opcode: opcode.OR, at: [4]u32{gen_row_index.I32OR, gen_row_index.I64OR, NO, NO}},
    Simple{opcode: opcode.XOR, at: [4]u32{gen_row_index.I32XOR, gen_row_index.I64XOR, NO, NO}},
    Simple{opcode: opcode.SHL, at: [4]u32{gen_row_index.I32SHL, gen_row_index.I64SHL, NO, NO}},
    Simple{opcode: opcode.SHR_U, at: [4]u32{gen_row_index.I32SHRU, gen_row_index.I64SHRU, NO, NO}},
    Simple{opcode: opcode.SHR_S, at: [4]u32{gen_row_index.I32SHRS, gen_row_index.I64SHRS, NO, NO}},
    Simple{opcode: opcode.EQ, at: [4]u32{gen_row_index.I32EQ, gen_row_index.I64EQ, NO, NO}},
    Simple{opcode: opcode.NE, at: [4]u32{gen_row_index.I32NE, gen_row_index.I64NE, NO, NO}},
    Simple{opcode: opcode.LT_S, at: [4]u32{gen_row_index.I32LTS, gen_row_index.I64LTS, NO, NO}},
    Simple{opcode: opcode.LE_S, at: [4]u32{gen_row_index.I32LES, gen_row_index.I64LES, NO, NO}},
    Simple{opcode: opcode.GT_S, at: [4]u32{gen_row_index.I32GTS, gen_row_index.I64GTS, NO, NO}},
    Simple{opcode: opcode.GE_S, at: [4]u32{gen_row_index.I32GES, gen_row_index.I64GES, NO, NO}},
    Simple{opcode: opcode.LT_U, at: [4]u32{gen_row_index.I32LTU, gen_row_index.I64LTU, NO, NO}},
    Simple{opcode: opcode.LE_U, at: [4]u32{gen_row_index.I32LEU, gen_row_index.I64LEU, NO, NO}},
    Simple{opcode: opcode.GT_U, at: [4]u32{gen_row_index.I32GTU, gen_row_index.I64GTU, NO, NO}},
    Simple{opcode: opcode.GE_U, at: [4]u32{gen_row_index.I32GEU, gen_row_index.I64GEU, NO, NO}},
    Simple{opcode: opcode.CLZ, at: [4]u32{gen_row_index.I32CLZ, gen_row_index.I64CLZ, NO, NO}},
    Simple{opcode: opcode.CTZ, at: [4]u32{gen_row_index.I32CTZ, gen_row_index.I64CTZ, NO, NO}},
    Simple{opcode: opcode.POPCNT, at: [4]u32{gen_row_index.I32POPCNT, gen_row_index.I64POPCNT, NO, NO}},
    Simple{opcode: opcode.FADD, at: [4]u32{NO, NO, gen_row_index.F32ADD, gen_row_index.F64ADD}},
    Simple{opcode: opcode.FSUB, at: [4]u32{NO, NO, gen_row_index.F32SUB, gen_row_index.F64SUB}},
    Simple{opcode: opcode.FMUL, at: [4]u32{NO, NO, gen_row_index.F32MUL, gen_row_index.F64MUL}},
    Simple{opcode: opcode.FDIV, at: [4]u32{NO, NO, gen_row_index.F32DIV, gen_row_index.F64DIV}},
    Simple{opcode: opcode.FMIN, at: [4]u32{NO, NO, gen_row_index.F32MIN, gen_row_index.F64MIN}},
    Simple{opcode: opcode.FMAX, at: [4]u32{NO, NO, gen_row_index.F32MAX, gen_row_index.F64MAX}},
    Simple{opcode: opcode.FCOPYSIGN, at: [4]u32{NO, NO, gen_row_index.F32COPYSIGN, gen_row_index.F64COPYSIGN}},
    Simple{opcode: opcode.FNEG, at: [4]u32{NO, NO, gen_row_index.F32NEG, gen_row_index.F64NEG}},
    Simple{opcode: opcode.FABS, at: [4]u32{NO, NO, gen_row_index.F32ABS, gen_row_index.F64ABS}},
    Simple{opcode: opcode.FSQRT, at: [4]u32{NO, NO, gen_row_index.F32SQRT, gen_row_index.F64SQRT}},
    Simple{opcode: opcode.FFLOOR, at: [4]u32{NO, NO, gen_row_index.F32FLOOR, gen_row_index.F64FLOOR}},
    Simple{opcode: opcode.FCEIL, at: [4]u32{NO, NO, gen_row_index.F32CEIL, gen_row_index.F64CEIL}},
    Simple{opcode: opcode.FINT, at: [4]u32{NO, NO, gen_row_index.F32TRUNC, gen_row_index.F64TRUNC}},
    Simple{opcode: opcode.FNEAREST, at: [4]u32{NO, NO, gen_row_index.F32NEAREST, gen_row_index.F64NEAREST}},
    Simple{opcode: opcode.FEQ_O, at: [4]u32{NO, NO, gen_row_index.F32EQ, gen_row_index.F64EQ}},
    Simple{opcode: opcode.FLT_O, at: [4]u32{NO, NO, gen_row_index.F32LT, gen_row_index.F64LT}},
    Simple{opcode: opcode.FNE_U, at: [4]u32{NO, NO, gen_row_index.F32NE, gen_row_index.F64NE}},
};

# the ordered compares and the rows of each, which wasm states for ordered
# lt, le, gt and ge and for eq, and the unordered ne
val ORDERED: [3]Simple = [3]Simple{
    Simple{opcode: opcode.FLE_O, at: [4]u32{NO, NO, gen_row_index.F32LE, gen_row_index.F64LE}},
    Simple{opcode: opcode.FGT_O, at: [4]u32{NO, NO, gen_row_index.F32GT, gen_row_index.F64GT}},
    Simple{opcode: opcode.FGE_O, at: [4]u32{NO, NO, gen_row_index.F32GE, gen_row_index.F64GE}},
};

fun lookup(rows: *Simple, count: usize, op: Opcode, class: u32) opt[u32] {
    var i: usize = 0;
    for (i < count) {
        if (rows[i].opcode.index == op.index) {
            val r: u32 = rows[i].at[class::usize];
            if (r == NO) { ret opt[u32].none{}; }
            ret opt[u32].some{r};
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the one instruction an operation is at a class, none when it is not one
pub fun simple(op: Opcode, class: u32) opt[u32] {
    val got: opt[u32] = lookup(?SIMPLE[0], $length_of([43]Simple), op, class);
    if (sel got.some) { ret got; }
    ret lookup(?ORDERED[0], $length_of([3]Simple), op, class);
}

# whether an operation's integer result is exact at a narrow width when its
# operands are: it sets no bit above the width of its operands
pub fun exact(op: Opcode) bool {
    val i: u32 = op.index;
    ret i == opcode.AND.index || i == opcode.OR.index || i == opcode.XOR.index || i == opcode.SHR_U.index || i == opcode.DIV_U.index || i == opcode.REM_U.index || i == opcode.POPCNT.index;
}

# whether an integer operation reads its operands as signed
pub fun signed(op: Opcode) bool {
    val i: u32 = op.index;
    ret i == opcode.DIV_S.index || i == opcode.REM_S.index || i == opcode.SHR_S.index || i == opcode.LT_S.index || i == opcode.LE_S.index || i == opcode.GT_S.index || i == opcode.GE_S.index;
}

# whether an operation is a compare, whose i1 result is exact
pub fun compare(op: Opcode) bool {
    val i: u32 = op.index;
    ret (i >= opcode.EQ.index && i <= opcode.GE_U.index) || i == opcode.FEQ_O.index || i == opcode.FLT_O.index || i == opcode.FLE_O.index || i == opcode.FGT_O.index || i == opcode.FGE_O.index || i == opcode.FNE_U.index;
}
