# the wasm instruction each ir operation is at each value type, where it is one
#
# a value type is a class: i32, i64, f32, f64 or v128. an operation that is one
# instruction of its operands' class is a row here, by its opcode, with the
# instruction of each class it is defined at. a v128 instruction depends on
# the lanes it reads as well, so a lanewise operation of simd128 is a row of
# its own, by its opcode, with the instruction at each lane type. every row
# the simd128 unit states (`mirl.target.wasm.axes`) has its instruction here,
# which opening the build checks (`mirl.target.wasm.family`). what
# takes more than one instruction, or reads its operands in another order,
# is the code emitter's own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.table;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;

use masc.isa.wasm.gen_row_index;

# the classes, as a row's column
pub val I32: u32 = 0;
pub val I64: u32 = 1;
pub val F32: u32 = 2;
pub val F64: u32 = 3;
# simd128's vector, whose operations are keyed on their lane type
pub val V128: u32 = 4;

# no instruction at the class
pub val NO: u32 = 0xFFFF_FFFF;

# the lane types of a v128, as a lanewise row's column
pub val LANE_I8:  u32 = 0;
pub val LANE_I16: u32 = 1;
pub val LANE_I32: u32 = 2;
pub val LANE_I64: u32 = 3;
pub val LANE_F32: u32 = 4;
pub val LANE_F64: u32 = 5;

# one lanewise operation of simd128 and its instruction at each lane type,
# NO where simd128 has none: a v128 instruction depends on the lanes it reads
rec Lanewise {
    opcode: Opcode;
    at:     [6]u32;
}

# one operation and its instruction at each class
rec Simple {
    opcode: Opcode;
    at:     [4]u32;
}

val SIMPLE: [43]Simple = [43]Simple{
    Simple{opcode: table.ADD, at: [4]u32{gen_row_index.I32ADD, gen_row_index.I64ADD, NO, NO}},
    Simple{opcode: table.SUB, at: [4]u32{gen_row_index.I32SUB, gen_row_index.I64SUB, NO, NO}},
    Simple{opcode: table.MUL, at: [4]u32{gen_row_index.I32MUL, gen_row_index.I64MUL, NO, NO}},
    Simple{opcode: table.DIV_S, at: [4]u32{gen_row_index.I32DIVS, gen_row_index.I64DIVS, NO, NO}},
    Simple{opcode: table.DIV_U, at: [4]u32{gen_row_index.I32DIVU, gen_row_index.I64DIVU, NO, NO}},
    Simple{opcode: table.REM_S, at: [4]u32{gen_row_index.I32REMS, gen_row_index.I64REMS, NO, NO}},
    Simple{opcode: table.REM_U, at: [4]u32{gen_row_index.I32REMU, gen_row_index.I64REMU, NO, NO}},
    Simple{opcode: table.AND, at: [4]u32{gen_row_index.I32AND, gen_row_index.I64AND, NO, NO}},
    Simple{opcode: table.OR, at: [4]u32{gen_row_index.I32OR, gen_row_index.I64OR, NO, NO}},
    Simple{opcode: table.XOR, at: [4]u32{gen_row_index.I32XOR, gen_row_index.I64XOR, NO, NO}},
    Simple{opcode: table.SHL, at: [4]u32{gen_row_index.I32SHL, gen_row_index.I64SHL, NO, NO}},
    Simple{opcode: table.SHR_U, at: [4]u32{gen_row_index.I32SHRU, gen_row_index.I64SHRU, NO, NO}},
    Simple{opcode: table.SHR_S, at: [4]u32{gen_row_index.I32SHRS, gen_row_index.I64SHRS, NO, NO}},
    Simple{opcode: table.EQ, at: [4]u32{gen_row_index.I32EQ, gen_row_index.I64EQ, NO, NO}},
    Simple{opcode: table.NE, at: [4]u32{gen_row_index.I32NE, gen_row_index.I64NE, NO, NO}},
    Simple{opcode: table.LT_S, at: [4]u32{gen_row_index.I32LTS, gen_row_index.I64LTS, NO, NO}},
    Simple{opcode: table.LE_S, at: [4]u32{gen_row_index.I32LES, gen_row_index.I64LES, NO, NO}},
    Simple{opcode: table.GT_S, at: [4]u32{gen_row_index.I32GTS, gen_row_index.I64GTS, NO, NO}},
    Simple{opcode: table.GE_S, at: [4]u32{gen_row_index.I32GES, gen_row_index.I64GES, NO, NO}},
    Simple{opcode: table.LT_U, at: [4]u32{gen_row_index.I32LTU, gen_row_index.I64LTU, NO, NO}},
    Simple{opcode: table.LE_U, at: [4]u32{gen_row_index.I32LEU, gen_row_index.I64LEU, NO, NO}},
    Simple{opcode: table.GT_U, at: [4]u32{gen_row_index.I32GTU, gen_row_index.I64GTU, NO, NO}},
    Simple{opcode: table.GE_U, at: [4]u32{gen_row_index.I32GEU, gen_row_index.I64GEU, NO, NO}},
    Simple{opcode: table.CLZ, at: [4]u32{gen_row_index.I32CLZ, gen_row_index.I64CLZ, NO, NO}},
    Simple{opcode: table.CTZ, at: [4]u32{gen_row_index.I32CTZ, gen_row_index.I64CTZ, NO, NO}},
    Simple{opcode: table.POPCNT, at: [4]u32{gen_row_index.I32POPCNT, gen_row_index.I64POPCNT, NO, NO}},
    Simple{opcode: table.FADD, at: [4]u32{NO, NO, gen_row_index.F32ADD, gen_row_index.F64ADD}},
    Simple{opcode: table.FSUB, at: [4]u32{NO, NO, gen_row_index.F32SUB, gen_row_index.F64SUB}},
    Simple{opcode: table.FMUL, at: [4]u32{NO, NO, gen_row_index.F32MUL, gen_row_index.F64MUL}},
    Simple{opcode: table.FDIV, at: [4]u32{NO, NO, gen_row_index.F32DIV, gen_row_index.F64DIV}},
    Simple{opcode: table.FMIN, at: [4]u32{NO, NO, gen_row_index.F32MIN, gen_row_index.F64MIN}},
    Simple{opcode: table.FMAX, at: [4]u32{NO, NO, gen_row_index.F32MAX, gen_row_index.F64MAX}},
    Simple{opcode: table.FCOPYSIGN, at: [4]u32{NO, NO, gen_row_index.F32COPYSIGN, gen_row_index.F64COPYSIGN}},
    Simple{opcode: table.FNEG, at: [4]u32{NO, NO, gen_row_index.F32NEG, gen_row_index.F64NEG}},
    Simple{opcode: table.FABS, at: [4]u32{NO, NO, gen_row_index.F32ABS, gen_row_index.F64ABS}},
    Simple{opcode: table.FSQRT, at: [4]u32{NO, NO, gen_row_index.F32SQRT, gen_row_index.F64SQRT}},
    Simple{opcode: table.FFLOOR, at: [4]u32{NO, NO, gen_row_index.F32FLOOR, gen_row_index.F64FLOOR}},
    Simple{opcode: table.FCEIL, at: [4]u32{NO, NO, gen_row_index.F32CEIL, gen_row_index.F64CEIL}},
    Simple{opcode: table.FINT, at: [4]u32{NO, NO, gen_row_index.F32TRUNC, gen_row_index.F64TRUNC}},
    Simple{opcode: table.FNEAREST, at: [4]u32{NO, NO, gen_row_index.F32NEAREST, gen_row_index.F64NEAREST}},
    Simple{opcode: table.FEQ_O, at: [4]u32{NO, NO, gen_row_index.F32EQ, gen_row_index.F64EQ}},
    Simple{opcode: table.FLT_O, at: [4]u32{NO, NO, gen_row_index.F32LT, gen_row_index.F64LT}},
    Simple{opcode: table.FNE_U, at: [4]u32{NO, NO, gen_row_index.F32NE, gen_row_index.F64NE}},
};

# the ordered compares and the rows of each, which wasm states for ordered
# lt, le, gt and ge and for eq, and the unordered ne
val ORDERED: [3]Simple = [3]Simple{
    Simple{opcode: table.FLE_O, at: [4]u32{NO, NO, gen_row_index.F32LE, gen_row_index.F64LE}},
    Simple{opcode: table.FGT_O, at: [4]u32{NO, NO, gen_row_index.F32GT, gen_row_index.F64GT}},
    Simple{opcode: table.FGE_O, at: [4]u32{NO, NO, gen_row_index.F32GE, gen_row_index.F64GE}},
};

# the simd128 instruction of each lanewise opcode at the six lane columns (i8, i16, i32, i64, f32,
# f64), `NO` where simd128 has none
val LANEWISE: [33]Lanewise = [33]Lanewise{
    Lanewise{opcode: table.ADD, at: [6]u32{gen_row_index.I8X16ADD, gen_row_index.I16X8ADD, gen_row_index.I32X4ADD, gen_row_index.I64X2ADD, NO, NO}},
    Lanewise{opcode: table.SUB, at: [6]u32{gen_row_index.I8X16SUB, gen_row_index.I16X8SUB, gen_row_index.I32X4SUB, gen_row_index.I64X2SUB, NO, NO}},
    Lanewise{opcode: table.MUL, at: [6]u32{NO, gen_row_index.I16X8MUL, gen_row_index.I32X4MUL, gen_row_index.I64X2MUL, NO, NO}},
    Lanewise{opcode: table.AND, at: [6]u32{gen_row_index.V128AND, gen_row_index.V128AND, gen_row_index.V128AND, gen_row_index.V128AND, NO, NO}},
    Lanewise{opcode: table.OR, at: [6]u32{gen_row_index.V128OR, gen_row_index.V128OR, gen_row_index.V128OR, gen_row_index.V128OR, NO, NO}},
    Lanewise{opcode: table.XOR, at: [6]u32{gen_row_index.V128XOR, gen_row_index.V128XOR, gen_row_index.V128XOR, gen_row_index.V128XOR, NO, NO}},
    Lanewise{opcode: table.NOT, at: [6]u32{gen_row_index.V128NOT, gen_row_index.V128NOT, gen_row_index.V128NOT, gen_row_index.V128NOT, NO, NO}},
    Lanewise{opcode: table.NEG, at: [6]u32{gen_row_index.I8X16NEG, gen_row_index.I16X8NEG, gen_row_index.I32X4NEG, gen_row_index.I64X2NEG, NO, NO}},
    Lanewise{opcode: table.EQ, at: [6]u32{gen_row_index.I8X16EQ, gen_row_index.I16X8EQ, gen_row_index.I32X4EQ, gen_row_index.I64X2EQ, NO, NO}},
    Lanewise{opcode: table.NE, at: [6]u32{gen_row_index.I8X16NE, gen_row_index.I16X8NE, gen_row_index.I32X4NE, gen_row_index.I64X2NE, NO, NO}},
    Lanewise{opcode: table.LT_S, at: [6]u32{gen_row_index.I8X16LTS, gen_row_index.I16X8LTS, gen_row_index.I32X4LTS, gen_row_index.I64X2LTS, NO, NO}},
    Lanewise{opcode: table.LE_S, at: [6]u32{gen_row_index.I8X16LES, gen_row_index.I16X8LES, gen_row_index.I32X4LES, gen_row_index.I64X2LES, NO, NO}},
    Lanewise{opcode: table.LT_U, at: [6]u32{gen_row_index.I8X16LTU, gen_row_index.I16X8LTU, gen_row_index.I32X4LTU, NO, NO, NO}},
    Lanewise{opcode: table.LE_U, at: [6]u32{gen_row_index.I8X16LEU, gen_row_index.I16X8LEU, gen_row_index.I32X4LEU, NO, NO, NO}},
    Lanewise{opcode: table.FADD, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4ADD, gen_row_index.F64X2ADD}},
    Lanewise{opcode: table.FSUB, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4SUB, gen_row_index.F64X2SUB}},
    Lanewise{opcode: table.FMUL, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4MUL, gen_row_index.F64X2MUL}},
    Lanewise{opcode: table.FDIV, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4DIV, gen_row_index.F64X2DIV}},
    Lanewise{opcode: table.FSQRT, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4SQRT, gen_row_index.F64X2SQRT}},
    Lanewise{opcode: table.FNEG, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4NEG, gen_row_index.F64X2NEG}},
    Lanewise{opcode: table.FABS, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4ABS, gen_row_index.F64X2ABS}},
    Lanewise{opcode: table.FEQ_O, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4EQ, gen_row_index.F64X2EQ}},
    Lanewise{opcode: table.FNE_U, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4NE, gen_row_index.F64X2NE}},
    Lanewise{opcode: table.FLT_O, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4LT, gen_row_index.F64X2LT}},
    Lanewise{opcode: table.FLE_O, at: [6]u32{NO, NO, NO, NO, gen_row_index.F32X4LE, gen_row_index.F64X2LE}},
    Lanewise{opcode: table.VSPLAT, at: [6]u32{gen_row_index.I8X16SPLAT, gen_row_index.I16X8SPLAT, gen_row_index.I32X4SPLAT, gen_row_index.I64X2SPLAT, gen_row_index.F32X4SPLAT, gen_row_index.F64X2SPLAT}},
    Lanewise{opcode: table.VEXTRACT, at: [6]u32{gen_row_index.I8X16EXTRACTLANEU, gen_row_index.I16X8EXTRACTLANEU, gen_row_index.I32X4EXTRACTLANE, gen_row_index.I64X2EXTRACTLANE, gen_row_index.F32X4EXTRACTLANE, gen_row_index.F64X2EXTRACTLANE}},
    Lanewise{opcode: table.VINSERT, at: [6]u32{gen_row_index.I8X16REPLACELANE, gen_row_index.I16X8REPLACELANE, gen_row_index.I32X4REPLACELANE, gen_row_index.I64X2REPLACELANE, gen_row_index.F32X4REPLACELANE, gen_row_index.F64X2REPLACELANE}},
    Lanewise{opcode: table.VSHUFFLE, at: [6]u32{gen_row_index.I8X16SHUFFLE, gen_row_index.I8X16SHUFFLE, gen_row_index.I8X16SHUFFLE, gen_row_index.I8X16SHUFFLE, gen_row_index.I8X16SHUFFLE, gen_row_index.I8X16SHUFFLE}},
    Lanewise{opcode: table.ITOF_S, at: [6]u32{NO, NO, gen_row_index.F32X4CONVERTI32X4S, NO, NO, NO}},
    Lanewise{opcode: table.ITOF_U, at: [6]u32{NO, NO, gen_row_index.F32X4CONVERTI32X4U, NO, NO, NO}},
    Lanewise{opcode: table.FTOI_S, at: [6]u32{NO, NO, NO, NO, gen_row_index.I32X4TRUNCSATF32X4S, NO}},
    Lanewise{opcode: table.FTOI_U, at: [6]u32{NO, NO, NO, NO, gen_row_index.I32X4TRUNCSATF32X4U, NO}},
};

# the instruction of `op` at `class` among `count` rows, none where no row has one
fun lookup(rows: *Simple, count: usize, op: Opcode, class: u32) opt[u32] {
    if (class >= $length_of([4]u32)) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < count) {
        if (rows[i].opcode == op) {
            val r: u32 = rows[i].at[class::usize];
            if (r == NO) { ret opt[u32].none{}; }
            ret opt[u32].some{r};
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the one instruction an operation is at a class, none when it is not one
pub fun simple(op: Opcode, class: u32) opt[u32] {
    val opt_lookup: opt[u32] = lookup(?SIMPLE[0], $length_of([43]Simple), op, class);
    if (sel opt_lookup.some) { ret opt_lookup; }
    ret lookup(?ORDERED[0], $length_of([3]Simple), op, class);
}

# the lane column of an integer lane of `width` bits, none for a width
# simd128 does not pack
pub fun integer_lane(width: u32) opt[u32] {
    if (width == 8)  { ret opt[u32].some{LANE_I8}; }
    if (width == 16) { ret opt[u32].some{LANE_I16}; }
    if (width == 32) { ret opt[u32].some{LANE_I32}; }
    if (width == 64) { ret opt[u32].some{LANE_I64}; }
    ret opt[u32].none{};
}

# the lane column of a vector type, none for a type that is no vector or
# whose lanes simd128 does not pack
pub fun column_of(types: *type_table.Table, ty: Type) opt[u32] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(types, ty);
    if (sel res_shape.err)          { ret opt[u32].none{}; }
    if (!(sel res_shape.ok.vector)) { ret opt[u32].none{}; }
    val res_lane: res[type_table.Shape, type_table.Error] = type_table.shape(types, res_shape.ok.vector.element);
    if (sel res_lane.err) { ret opt[u32].none{}; }
    val lane: type_table.Shape = res_lane.ok;
    if (sel lane.integer) { ret integer_lane(lane.integer.width); }
    if (sel lane.float) {
        if (lane.float.format == BINARY32) { ret opt[u32].some{LANE_F32}; }
        if (lane.float.format == BINARY64) { ret opt[u32].some{LANE_F64}; }
    }
    ret opt[u32].none{};
}

# whether a lanewise operation at a lane column is a sequence of simd128
# instructions, as no one instruction computes it, which pushes its operands
# itself: a product of bytes, through the products of their halves widened to
# words, and an unsigned order of quadwords, as the signed one of both
# operands with their sign bits flipped
pub fun sequenced(op: Opcode, column: u32) bool {
    if (op == table.MUL && column == LANE_I8) { ret true; }
    ret (op == table.LT_U || op == table.LE_U) && column == LANE_I64;
}

# the bytes of a lane of a column
pub fun lane_bytes(column: u32) u32 {
    if (column == LANE_I8)                        { ret 1; }
    if (column == LANE_I16)                       { ret 2; }
    if (column == LANE_I32 || column == LANE_F32) { ret 4; }
    ret 8;
}

# whether an operation is a lanewise row of simd128 at some lane type
pub fun lanewise_row(op: Opcode) bool {
    var i: usize = 0;
    for (i < $length_of(LANEWISE)) {
        if (LANEWISE[i].opcode == op) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the one simd128 instruction a lanewise operation is at a lane column, none
# where it is not one
pub fun lanewise(op: Opcode, column: u32) opt[u32] {
    if (column >= 6) { ret opt[u32].none{}; }
    var i: usize = 0;
    for (i < $length_of(LANEWISE)) {
        if (LANEWISE[i].opcode == op) {
            val r: u32 = LANEWISE[i].at[column::usize];
            if (r == NO) { ret opt[u32].none{}; }
            ret opt[u32].some{r};
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# whether an operation's integer result is exact at a narrow width when its
# operands are: it sets no bit above the width of its operands
pub fun exact(op: Opcode) bool {
    val i: u32 = op;
    ret i == table.AND || i == table.OR || i == table.XOR || i == table.SHR_U || i == table.DIV_U || i == table.REM_U || i == table.POPCNT;
}

# whether an integer operation reads its operands as signed
pub fun signed(op: Opcode) bool {
    val i: u32 = op;
    ret i == table.DIV_S || i == table.REM_S || i == table.SHR_S || i == table.LT_S || i == table.LE_S || i == table.GT_S || i == table.GE_S;
}

# whether an operation is a compare, whose i1 result is exact
pub fun compare(op: Opcode) bool {
    val i: u32 = op;
    ret (i >= table.EQ && i <= table.GE_U) || i == table.FEQ_O || i == table.FLT_O || i == table.FLE_O || i == table.FGT_O || i == table.FGE_O || i == table.FNE_U;
}
