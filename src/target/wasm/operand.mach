# how the code of an instruction reads its operands off the operand stack
#
# wasm pops an instruction's operands in the order its signature states, so
# each ir operation pushes its operands in an order of its own: a select its
# arms before its condition, a call its arguments by the operand each is
# placed at and its callee last when it calls indirectly, and every other
# operation in operand order. an operation whose code reads an operand more
# than once, as an unordered compare tests both operands twice and an
# overflow form reads them again for its flag, and an inline assembly block,
# which reads its operands into locals its text names, reads every
# operand from where it is held, so no operand of it stays on the stack. the
# stackifier and the emitter read both facts here, so they agree.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.table;
use mirl.ir.place.Place;
use mirl.ir.place.Placed;
use mirl.ir.value.Def;

# the most a switch's table spans per case before it is a chain of tests
pub val DENSE: u64 = 4;

# the function a callee names when it is the address of one, at no offset
pub fun direct(m: *Module, b: *Body, callee: Value) opt[Function] {
    val d: Def = b.values.data[callee].def;
    if (!(sel d.constant)) { ret opt[Function].none{}; }
    val c: res[ConstantData, module.Error] = module.constant_data(m, d.constant);
    if (sel c.err) { ret opt[Function].none{}; }
    val data: ConstantData = c.ok;
    if (!(sel data.address))      { ret opt[Function].none{}; }
    if (data.address.offset != 0) { ret opt[Function].none{}; }
    val s: Symbol = data.address.symbol;
    if (!(sel s.function)) { ret opt[Function].none{}; }
    ret opt[Function].some{s.function};
}

# the operand a place names, 0 for any other place
pub fun at(p: Placed) u32 {
    val place: Place = p.place;
    if (sel place.operand) { ret place.operand; }
    ret 0;
}

# the places of a placed call or return
pub fun places(d: *InstructionData) *Placed {
    val slot: usize = if_call(d);
    if (slot >= d.immediates.len) { ret nil; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.places) { ret imm.places.data; }
    ret nil;
}

fun if_call(d: *InstructionData) usize {
    if (d.opcode == table.CALL_PLACED) { ret 1; }
    ret 0;
}

# whether a switch is dense enough for one table of its targets: a selector
# of at most 32 bits whose cases span few values per case
pub fun dense(m: *Module, d: *InstructionData, width: u32) bool {
    if (width > 32 || d.immediates.len == 0) { ret false; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.cases))    { ret false; }
    if (imm.cases.size == 0) { ret false; }
    val low:  u64 = imm.cases.data[0];
    val high: u64 = imm.cases.data[imm.cases.size - 1];
    ret high - low < DENSE * imm.cases.size::u64 + DENSE;
}

fun rmw(op: Opcode) bool {
    val i: u32 = op;
    ret i == table.ATOMIC_ADD || i == table.ATOMIC_SUB || i == table.ATOMIC_AND || i == table.ATOMIC_OR || i == table.ATOMIC_XOR || i == table.ATOMIC_NAND || i == table.ATOMIC_XCHG || i == table.ATOMIC_SMAX || i == table.ATOMIC_SMIN || i == table.ATOMIC_UMAX || i == table.ATOMIC_UMIN;
}

# whether an operation is an atomic read, modify and write
pub fun updates(op: Opcode) bool {
    ret rmw(op) || op == table.ATOMIC_CMPXCHG;
}

# whether an operation is an overflow form, its result and whether it overflowed
pub fun checked(op: Opcode) bool {
    val i: u32 = op;
    ret i == table.ADD_OV_S || i == table.ADD_OV_U || i == table.SUB_OV_S || i == table.SUB_OV_U || i == table.MUL_OV_S || i == table.MUL_OV_U;
}

# whether the code of an instruction reads an operand more than once
# ---
# width: the width of its first operand, as a switch's selector
pub fun rereads(m: *Module, d: *InstructionData, width: u32) bool {
    val i: u32 = d.opcode;
    if (i == table.FNE_O || i == table.FEQ_U || i == table.FORD || i == table.FUNO) { ret true; }
    if (updates(d.opcode) || checked(d.opcode) || i == table.ASM)                                     { ret true; }
    if (i == table.SWITCH)                                                                            { ret !dense(m, d, width); }
    ret false;
}

# the operands of an instruction in the order its code pushes them
# ---
# m:   the module
# b:   the body
# d:   the instruction
# out: the operand positions, in push order
pub fun order(m: *Module, b: *Body, d: *InstructionData, out: *vector.Vector[usize]) res[bool, allocator.Error] {
    vector.truncate[usize](out, 0);
    val i: u32 = d.opcode;
    if (i == table.SELECT && d.operands.len == 3) {
        val one:   res[usize, allocator.Error] = vector.push[usize](out, 1);
        val two:   res[usize, allocator.Error] = vector.push[usize](out, 2);
        val three: res[usize, allocator.Error] = vector.push[usize](out, 0);
        if (sel one.err)   { ret res[bool, allocator.Error].err{one.err}; }
        if (sel two.err)   { ret res[bool, allocator.Error].err{two.err}; }
        if (sel three.err) { ret res[bool, allocator.Error].err{three.err}; }
        ret res[bool, allocator.Error].ok{true};
    }
    if (i == table.CALL_PLACED || i == table.RET_PLACED) {
        var first: usize = 0;
        if (i == table.CALL_PLACED) { first = 1; }
        val listed: *Placed = places(d);
        var k:      u32     = 0;
        var placed: usize   = 0;
        for (placed < d.operands.len - first) {
            var j: usize = first;
            for (j < d.operands.len) {
                if (listed != nil && at(listed[j - first]) == k) {
                    val pushed: res[usize, allocator.Error] = vector.push[usize](out, j);
                    if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
                    placed = placed + 1;
                }
                j = j + 1;
            }
            k = k + 1;
            if (k > (d.operands.len * 2)::u32 + 2) { ret res[bool, allocator.Error].ok{false}; }
        }
        if (i == table.CALL_PLACED) {
            val callee: opt[Function] = direct(m, b, d.operands.data[0]);
            if (sel callee.none) {
                val pushed: res[usize, allocator.Error] = vector.push[usize](out, 0);
                if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
            }
        }
        ret res[bool, allocator.Error].ok{true};
    }
    var j: usize = 0;
    for (j < d.operands.len) {
        val pushed: res[usize, allocator.Error] = vector.push[usize](out, j);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        j = j + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# the results of a placed call in the order its code leaves them, by the
# operand each is placed at, the rest in result order
pub fun result_order(d: *InstructionData, out: *vector.Vector[usize]) res[bool, allocator.Error] {
    vector.truncate[usize](out, 0);
    if (d.opcode != table.CALL_PLACED) {
        var j: usize = 0;
        for (j < d.results.len) {
            val pushed: res[usize, allocator.Error] = vector.push[usize](out, j);
            if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
            j = j + 1;
        }
        ret res[bool, allocator.Error].ok{true};
    }
    val listed: *Placed = places(d);
    val args:   usize   = d.operands.len - 1;
    var k:      u32     = 0;
    var placed: usize   = 0;
    for (placed < d.results.len) {
        var j: usize = 0;
        for (j < d.results.len) {
            if (listed != nil && at(listed[args + j]) == k) {
                val pushed: res[usize, allocator.Error] = vector.push[usize](out, j);
                if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
                placed = placed + 1;
            }
            j = j + 1;
        }
        k = k + 1;
        if (k > (d.results.len * 2)::u32 + 2) { ret res[bool, allocator.Error].ok{false}; }
    }
    ret res[bool, allocator.Error].ok{true};
}
