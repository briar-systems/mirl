# why the webassembly back end refused a scheduled module

use std.types.option.opt;
use std.types.string.str;

use std.allocator;

use mink.base.fail.Fail;

use mct: mirl.ct;
use mirl.ir.debug.Location;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.module;
use mirl.ir.type.Type;
use mirl.legal.abi.Unplaced;
use mirl.machine.emit.data;
use mirl.pass.failure.Why;
use mirl.target.record;

# an instruction of a function
# ---
# function:    the function
# instruction: the instruction
# location:    the source location it was built for, none for none
pub rec At {
    function:    Function;
    instruction: Instruction;
    location:    opt[Location];
}

# what masc refused of a function's code
# ---
# function: the function, or the module's own expressions where it is past
#           the module's functions
# message:  masc's words
pub rec Encoding {
    function: Function;
    message:  str;
}

# why a module was not compiled
# ---
# alloc:        the allocator refused storage
# ir:           the module refused a read
# layout:       the data layout gave a type no extent
# analysis:     a function's structure or liveness was not read
# placement:    a signature was not placed
# unvalued:     a value of this type, which no value type of wasm holds
# unselected:   an instruction wasm has no form of, which is one of: a vector
#               operation or a reduction, as the back end writes no simd128
#               code and wasm's steps run no vector legalisation; a float
#               operation of a held format wasm has no instruction for and
#               the float legalisation has no stand in for, such as a fused
#               multiply-add, which wasm's core instructions do not fuse; an
#               overflow form of a 64-bit product, as wasm has no product of
#               two 64-bit operands wider than 64 bits; an inline assembly
#               block, which no wasm form is written for; and a target op, as
#               the wasm family states no op set
# invariant:    an instruction in a shape no verified module brings to the
#               back end once wasm's legalisations ran: an immediate or a
#               placement the verifier or the abi legalisation states
#               otherwise, a bitcast between types of different sizes, a
#               narrow or wide integer operation the narrow or wide
#               legalisation rewrites, or an operation a legalisation always
#               lowers (mirl.target.wasm.code's `lowered`)
# threads:      an atomic access or a fence on a build that runs threads
# undefined:    a global another module defines, which a final module has no
#               import of
# offset:       an address of this function at an offset, which a table slot has none
# width:        an address in this global's initial value of a width no
#               relocation of an object writes
# unstructured: a function whose graph the structure analysis lays out in no
#               regions its code can follow
# timing:       a constant-time function the walk of its code found a secret
#               in where none may be, at the byte of its body it was found at
# unfollowed:   a constant-time function whose code the walk could not follow
#               on a set that classifies its rows
# stale:        a constant-time function whose own frame reads a slot no
#               store reaches first
# image:        a global's initial value was not laid out
# encoding:     masc refused an instruction or a definition
# container:    mink's container refused the module
pub tag Error: u8 {
    alloc:        allocator.Error;
    ir:           module.Error;
    layout:       record.Error;
    analysis:     Why;
    placement:    Unplaced;
    unvalued:     Type;
    unselected:   At;
    invariant:    At;
    threads:      At;
    undefined:    Global;
    offset:       Function;
    width:        Global;
    unstructured: Function;
    timing:       mct.Refused;
    unfollowed:   mct.Unfollowed;
    stale:        mct.Stale;
    image:        data.Error;
    encoding:     Encoding;
    container:    Fail;
}
