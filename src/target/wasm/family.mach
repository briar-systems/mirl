# the webassembly family: the targets whose values live in the locals of a
# function, whose control is structured, whose addresses are physical and
# which evaluate on an operand stack
#
# its build is masc's wasm set with the target's baseline and the extensions
# a build adds, its one convention row the basic c abi resolved with no
# register file, and its back end mirl.target.wasm.module, which writes one
# module of mink's wasm container. its rows are the register family's, in
# their order, after the thread-local variables a target with one thread
# reaches as ordinary ones are made so: helpers, the abi's pieces, the float
# stand ins, narrow arithmetic widened and wide integers split, the neutral
# optimisations, the multiply forms and shift bounding, dead code removal,
# and the structurizer last, so the region tree the emitter reads is the
# graph as it is.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use core_state: masc.core.state;
use mink_fail:  mink.base.fail;
use mink.format.registry;
use mink.model.object;

use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.legal.abi.ABI;
use mirl.legal.floats.FLOATS;
use mirl.legal.helper.HELPERS;
use mirl.legal.multiply.MULTIPLY_FORMS;
use mirl.legal.narrow.NARROW;
use mirl.legal.pool.POOL;
use mirl.legal.shift.SHIFT_BOUND;
use mirl.legal.threadless.THREADLESS;
use mirl.legal.wide.WIDE;
use mirl.pass.rows;
use mirl.pass.schedule.LoweringRow;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Step;
use mirl.pass.schedule.Verify;
use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Unresolved;
use mirl.target.basis;
use mirl.target.build.Build;
use mirl.target.capability.Capabilities;
use mirl.target.family.Back;
use mirl.target.family.Error;
use mirl.target.family.Family;
use mirl.target.family.Options;
use mirl.target.record.Target;
use WasmError:   mirl.target.wasm.error.Error;
use wasm_module: mirl.target.wasm.module;

val THREADLESS_ROW: Row         = Row{pass: ?THREADLESS, verify: Verify.changed{}};
val HELPERS_ROW:    Row         = Row{pass: ?HELPERS, verify: Verify.changed{}};
val ABI_ROW:        LoweringRow = LoweringRow{pass: ?ABI, verify: Verify.changed{}};
val FLOATS_ROW:     Row         = Row{pass: ?FLOATS, verify: Verify.changed{}};
val NARROW_ROW:     Row         = Row{pass: ?NARROW, verify: Verify.changed{}};
val WIDE_ROW:       Row         = Row{pass: ?WIDE, verify: Verify.changed{}};
val POOL_ROW:       Row         = Row{pass: ?POOL, verify: Verify.changed{}};
val MULTIPLY_ROW:   Row         = Row{pass: ?MULTIPLY_FORMS, verify: Verify.changed{}};
val SHIFT_ROW:      Row         = Row{pass: ?SHIFT_BOUND, verify: Verify.changed{}};

val STEPS: [15]Step = [15]Step{
    Step.row{?THREADLESS_ROW},
    Step.row{?HELPERS_ROW},
    Step.lowering{?ABI_ROW},
    Step.row{?FLOATS_ROW},
    Step.row{?NARROW_ROW},
    Step.row{?WIDE_ROW},
    Step.row{?rows.FOLD_ROW},
    Step.row{?rows.ALGEBRAIC_ROW},
    Step.row{?rows.CSE_ROW},
    Step.row{?rows.LICM_ROW},
    Step.row{?POOL_ROW},
    Step.row{?MULTIPLY_ROW},
    Step.row{?SHIFT_ROW},
    Step.row{?rows.DCE_ROW},
    Step.row{?rows.STRUCTURE_ROW},
};

# a stack machine: values in locals, structured control, physical
# addressing and stack evaluation
fun admits(c: *Capabilities) bool {
    ret sel c.registers.locals && sel c.control.structured && sel c.addressing.physical && sel c.evaluation.stack;
}

# open the build: the basis, mink's formats and the convention rows resolved
# under its context, leaving nothing to close when it refuses
fun open(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val rows: res[Conventions, call.Error] = call.conventions(t);
    if (sel rows.err) { ret err[Error].err{Error.open{basis.Error.convention{rows.err}}}; }
    var set:    Conventions      = rows.ok;
    val chosen: err[basis.Error] = basis.choose(?b.basis, a, t, added);
    if (sel chosen.err) { ret err[Error].err{Error.open{chosen.err}}; }
    val formats: res[registry.Registry, mink_fail.Fail] = registry.builtin(a);
    if (sel formats.err) {
        basis.drop(?b.basis);
        ret err[Error].err{Error.open{basis.Error.formats{formats.err}}};
    }
    b.formats = formats.ok;
    val resolved: res[Slice[Resolved], Unresolved] = convention.resolve_all(a, ?set, opt[*core_state.Context].some{?b.basis.context});
    if (sel resolved.err) {
        registry.release(?b.formats);
        basis.drop(?b.basis);
        ret err[Error].err{Error.open{basis.Error.unresolved{resolved.err}}};
    }
    b.conventions = resolved.ok;
    b.state       = nil;
    ret err[Error].ok{};
}

fun back(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: Options) res[object.Object, Error] {
    val made: res[object.Object, WasmError] = wasm_module.compile(a, m, b, t, o.warnings);
    if (sel made.err) { ret res[object.Object, Error].err{Error.back{Back.wasm{made.err}}}; }
    ret res[object.Object, Error].ok{made.ok};
}

fun close(b: *Build) {
    convention.release_rows(b.conventions);
    registry.release(?b.formats);
    basis.drop(?b.basis);
}

# the webassembly family
pub val FAMILY: Family = Family{
    name:    "wasm",
    admits:  admits,
    legal:   Slice[Step]{data: ?STEPS[0], size: 15},
    open:    open,
    back:    back,
    close:   close,
    opcodes: Slice[*opcode.Row]{data: nil, size: 0},
};
