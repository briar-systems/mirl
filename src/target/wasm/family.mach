val UNSCOPED_ROW:      Row         = Row{pass: ?UNSCOPED};
val THREADLESS_ROW:    Row         = Row{pass: ?THREADLESS};
val AGGREGATE_ROW:     Row         = Row{pass: ?AGGREGATES};
val VECTOR_ROW:        Row         = Row{pass: ?VECTORS};
val HALF_ROW:          Row         = Row{pass: ?HALF};
val HELPERS_ROW:       Row         = Row{pass: ?HELPERS};
val ABI_ROW:           LoweringRow = LoweringRow{pass: ?ABI};
val PLACED_ROW:        Row         = Row{pass: ?PLACED_AGGREGATES};
val PLACED_VECTOR_ROW: Row         = Row{pass: ?PLACED_VECTORS};
val RECAST_ROW:        Row         = Row{pass: ?RECASTS};
val BULK_ROW:          Row         = Row{pass: ?BULK};
val FLOATS_ROW:        Row         = Row{pass: ?FLOATS};
val NARROW_ROW:        Row         = Row{pass: ?NARROW};
val WIDE_ROW:          Row         = Row{pass: ?WIDE};
val POOL_ROW:          Row         = Row{pass: ?POOL};
val MULTIPLY_ROW:      Row         = Row{pass: ?MULTIPLY_FORMS};
val SHIFT_ROW:         Row         = Row{pass: ?SHIFT_BOUND};

val STEPS: [24]Step = [24]Step{
    Step.row{?UNSCOPED_ROW},
    Step.row{?THREADLESS_ROW},
    Step.row{?AGGREGATE_ROW},
    Step.row{?VECTOR_ROW},
    Step.row{?HALF_ROW},
    Step.row{?HELPERS_ROW},
    Step.lowering{?ABI_ROW},
    Step.row{?PLACED_ROW},
    Step.row{?PLACED_VECTOR_ROW},
    Step.row{?RECAST_ROW},
    Step.row{?BULK_ROW},
    Step.row{?HALF_ROW},
    Step.row{?FLOATS_ROW},
    Step.row{?NARROW_ROW},
    Step.row{?WIDE_ROW},
    Step.row{?rows.FOLD_ROW},
    Step.row{?rows.ALGEBRAIC_ROW},
    Step.row{?rows.EFFECTS_ROW},
    Step.row{?rows.CSE_ROW},
    Step.row{?rows.DCE_ROW},
    Step.row{?POOL_ROW},
    Step.row{?MULTIPLY_ROW},
    Step.row{?SHIFT_ROW},
    Step.row{?rows.STRUCTURE_ROW},
};

# a stack machine: values in locals, structured control, physical
# addressing and stack evaluation
fun admits(c: *Capabilities) bool {
    ret sel c.registers.locals && sel c.control.structured && sel c.addressing.physical && sel c.evaluation.stack;
}

# check that every vector a unit the build meets admits is a value of wasm's
# own, since the vector legalisation keeps such a vector whole and the back
# end holds no other
fun held(c: *Capabilities, ctx: opt[*core_state.Context]) err[Error] {
    val v: Vectors = c.vectors;
    if (!(sel v.units)) { ret err[Error].ok{}; }
    var u: usize = 0;
    for (u < v.units.size) {
        val unit: *Unit = ?v.units.data[u];
        var i:    usize = 0;
        for (i < unit.lanes.size) {
            val lane: LaneType = unit.lanes.data[i].lane;
            val bits: u32      = units.bits_of(lane);
            var k:    u32      = 1;
            for (bits != 0 && k * bits <= 128) {
                val res_held: res[bool, units.Error] = units.holds(ctx, unit, lane, k);
                if (sel res_held.err) {
                    if (sel res_held.err.condition) { ret err[Error].err{Error.open{res_held.err.condition}}; }
                    ret err[Error].err{Error.open{basis.Error.unstated{}}};
                }
                if (res_held.ok && !value.vector_held(bits, k)) { ret err[Error].err{Error.wasm{WasmError.unheld{Unheld{lane: lane, lanes: k}}}}; }
                k = k + 1;
            }
            i = i + 1;
        }
        u = u + 1;
    }
    ret err[Error].ok{};
}

# check that every operation row a unit of the target states is one simd128
# instruction at its lane type or a sequence the code emitter writes
# (`select.sequenced`), as the vector legalisation leaves such an operation
# packed and the code emitter writes it by those alone
fun served(c: *Capabilities) err[Error] {
    val v: Vectors = c.vectors;
    if (!(sel v.units)) { ret err[Error].ok{}; }
    var u: usize = 0;
    for (u < v.units.size) {
        val rows: capability.Operations = v.units.data[u].operations;
        if (sel rows.rows) {
            var i: usize = 0;
            for (i < rows.rows.size) {
                val o:          Operation = rows.rows.data[i];
                val opt_column: opt[u32]  = column_of(o.lane);
                var found:      bool      = false;
                if (sel opt_column.some) {
                    val opt_row: opt[u32] = select.lanewise(o.opcode, opt_column.some);
                    found = sel opt_row.some || select.sequenced(o.opcode, opt_column.some);
                }
                if (!found) { ret err[Error].err{Error.wasm{WasmError.unserved{Unserved{opcode: o.opcode, lane: o.lane}}}}; }
                i = i + 1;
            }
        }
        u = u + 1;
    }
    ret err[Error].ok{};
}

# the column of `mirl.target.wasm.select`'s lanewise rows a lane type is at,
# none for one simd128 does not pack
fun column_of(lane: LaneType) opt[u32] {
    val bits: u32 = units.bits_of(lane);
    if (sel lane.integer) { ret select.integer_lane(bits); }
    if (bits == 32)       { ret opt[u32].some{select.LANE_F32}; }
    if (bits == 64)       { ret opt[u32].some{select.LANE_F64}; }
    ret opt[u32].none{};
}

# open the build: the basis, mink's formats and the convention rows resolved
# under its context, leaving nothing to close when it refuses
fun init(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val res_rows: res[Conventions, call.Error] = call.conventions(t);
    if (sel res_rows.err) { ret err[Error].err{Error.open{basis.Error.convention{res_rows.err}}}; }
    var set:        Conventions      = res_rows.ok;
    val err_chosen: err[basis.Error] = basis.choose(?b.basis, a, t, added);
    if (sel err_chosen.err) { ret err[Error].err{Error.open{err_chosen.err}}; }
    val err_held: err[Error] = held(?t.caps, opt[*core_state.Context].some{?b.basis.context});
    if (sel err_held.err) {
        basis.dnit(?b.basis);
        ret err_held;
    }
    val err_served: err[Error] = served(?t.caps);
    if (sel err_served.err) {
        basis.dnit(?b.basis);
        ret err_served;
    }
    b.formats = registry.builtin();
    val res_resolved: res[Slice[Resolved], convention.Error] = convention.resolve_all(a, ?set, opt[*core_state.Context].some{?b.basis.context});
    if (sel res_resolved.err) {
        basis.dnit(?b.basis);
        ret err[Error].err{Error.open{basis.Error.unresolved{res_resolved.err}}};
    }
    b.conventions = res_resolved.ok;
    b.state       = nil;
    ret err[Error].ok{};
}

# the back end: the scheduled module made one relocatable wasm object, its
# time stated as the emit stage. the module's table `w` is not read, since
# the family compiles no function past the build's selection
fun back(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: Options, w: *Widenings, warnings: *vector.Vector[Warning]) res[object.Object, Error] {
    val opt_from: opt[Instant]                  = stats.start(o.stats);
    val res_made: res[object.Object, WasmError] = wasm_module.compile(a, m, b, t, warnings);
    stats.stop(o.stats, stats.Stage.emit{}, opt_from);
    if (sel res_made.err) { ret res[object.Object, Error].err{Error.wasm{res_made.err}}; }
    ret res[object.Object, Error].ok{res_made.ok};
}

# close the build: its convention rows and its basis given back
fun dnit(b: *Build) {
    convention.rows_dnit(b.conventions);
    basis.dnit(?b.basis);
}

# the webassembly family
pub val FAMILY: Family = Family{
    name:    "wasm",
    admits:  admits,
    legal:   Slice[Step]{data: ?STEPS[0], size: $length_of(STEPS)},
    open:    init,
    back:    back,
    close:   dnit,
    opcodes: Slice[*row.Row]{data: ?opcode_table.WASM_ROWS[0], size: 1},
    lists:   false,
    grain:   Grain.module{},
    widens:  opt[Judge].none{},
};
