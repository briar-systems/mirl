# what the code of every function of a module is emitted against
#
# the module is laid out before any body: each function's index and its
# type, each global's address in the object's own layout, and the global
# that holds the stack pointer. a body reads them and changes none, naming
# each of them by its symbol, its index or address the provisional value its
# site holds.

use std.types.bool.bool;

use std.allocator;
use std.collections.vector;

use masc.core.dispatch;
use masc.core.state;

use mirl.ir.module.Module;
use mirl.pass.cache.Cache;
use mirl.target.build.Build;
use mirl.target.head.Heads;
use mirl.target.layout.Layout;
use mirl.target.record.Target;
use mirl.target.warning.Warning;
use mirl.target.wasm.line;
use mirl.target.wasm.signature.Signature;
use mirl.target.wasm.writer.Features;

# a module laid out for its bodies
# ---
# a:          the allocator every body takes
# m:          the module
# b:          the build
# t:          the target
# l:          the layout of the module's types
# cache:      the analyses of the module's functions
# pointer:    the value type of an address
# bytes:      the bytes of an address
# codec:      the codec of the build's set
# ctx:        the build's context, its stream the module's
# index:      per function, its index in the function space
# types:      per function, the index of its type
# signatures: per function, its type
# addresses:  per global, its address in the object's own layout, 0 for
#             one another module defines
# stack:      the index of the global that holds the stack pointer
# threadless: one thread runs, so an atomic access is an ordinary one
# warnings:   the list each warning the module gives is appended to
# lines:      per defined function, in definition order, the rows of its
#             body, each empty where the module states no line records
# heads:      the selections of the module's inline blocks, read once each
# features:   the target features the module's code uses
pub rec Unit {
    a:          *allocator.Allocator;
    m:          *Module;
    b:          *Build;
    t:          *Target;
    l:          *Layout;
    cache:      *Cache;
    pointer:    u32;
    bytes:      u64;
    codec:      *dispatch.Codec;
    ctx:        *state.Context;
    index:      vector.Vector[u32];
    types:      vector.Vector[u32];
    signatures: vector.Vector[Signature];
    addresses:  vector.Vector[u64];
    stack:      u32;
    threadless: bool;
    warnings:   *vector.Vector[Warning];
    lines:      vector.Vector[line.Body];
    heads:      Heads;
    features:   Features;
}
