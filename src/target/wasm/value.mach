# the wasm value type of an ir type
#
# an integer of at most 32 bits is an i32, a narrower one held zero
# extended so every bit above its width is clear, a 64-bit integer an i64,
# a pointer the index type of the memory, and binary32 and binary64 f32 and
# f64. no other type is a value of wasm's own.

use std.types.option.opt;
use std.types.result.res;

use wasm_stream: masc.isa.wasm.stream;

use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.target.wasm.select;

pub val I32: u32 = 0x7F;
pub val I64: u32 = 0x7E;
pub val F32: u32 = 0x7D;
pub val F64: u32 = 0x7C;

# the value type of a type, none for one wasm holds no value of
# ---
# t:       the module's type table
# ty:      the type
# pointer: the value type of the memory's index type
pub fun of(t: *types.Table, ty: Type, pointer: u32) opt[u32] {
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err) { ret opt[u32].none{}; }
    val shape: types.Shape = s.ok;
    if (sel shape.integer) {
        if (shape.integer.width <= 32) { ret opt[u32].some{I32}; }
        if (shape.integer.width == 64) { ret opt[u32].some{I64}; }
        ret opt[u32].none{};
    }
    if (sel shape.pointer) { ret opt[u32].some{pointer}; }
    if (sel shape.float) {
        if (shape.float.format.index == BINARY32.index) { ret opt[u32].some{F32}; }
        if (shape.float.format.index == BINARY64.index) { ret opt[u32].some{F64}; }
    }
    ret opt[u32].none{};
}

# the class of a value type, the column of the selection table
pub fun class(code: u32) u32 {
    if (code == I64) { ret select.I64; }
    if (code == F32) { ret select.F32; }
    if (code == F64) { ret select.F64; }
    ret select.I32;
}

# the width of an integer type, 0 for any other
pub fun width(t: *types.Table, ty: Type) u32 {
    val w: res[u32, types.Error] = types.width(t, ty);
    if (sel w.ok) { ret w.ok; }
    ret 0;
}

# the memory's index type for a pointer of `bytes`
pub fun pointer(bytes: u64) u32 {
    if (bytes == 8) { ret wasm_stream.I64; }
    ret wasm_stream.I32;
}
