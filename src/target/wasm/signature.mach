# the wasm function type of an ir signature, read from its placement
#
# the basic c abi places every piece as an operand of wasm's call, numbered
# from the first param, so a function's params and results are its pieces in
# operand order, each the value type its piece is held in: the address of a
# copy for a value by reference, the value's own type for a scalar a piece
# carries whole, and the integer of a piece's bytes otherwise, as the abi
# legalisation types every piece. a declaration, a definition and a direct
# call all read their type here, so they agree by construction.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.module;
use mirl.ir.place.Named;
use mirl.ir.place.Place;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.legal.abi;
use mirl.legal.abi.Passage;
use mirl.legal.abi.Unplaced;
use mirl.target.abi.piece;
use mirl.target.abi.piece.Assignment;
use mirl.target.abi.piece.Passed;
use mirl.target.abi.piece.Piece;
use mirl.target.build.Build;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.wasm.error.Error;
use mirl.target.wasm.value;

# a function type's params and results, by their value type codes
pub rec Signature {
    params:  vector.Vector[u32];
    results: vector.Vector[u32];
}

# an empty signature
pub fun make(a: *allocator.Allocator) Signature {
    ret Signature{params: vector.init[u32](a), results: vector.init[u32](a)};
}

# give back a signature's storage
pub fun release(s: *Signature) {
    vector.dnit[u32](?s.params);
    vector.dnit[u32](?s.results);
}

fun lost(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

# put a code at operand `k` of a list, growing it with zeros to reach it
fun put(list: *vector.Vector[u32], k: u32, code: u32) err[Error] {
    for (list.len <= k::usize) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](list, 0);
        if (sel pushed.err) { ret lost(pushed.err); }
    }
    list.data[k::usize] = code;
    ret err[Error].ok{};
}

# the operand a piece is placed at
fun operand(p: Piece) u32 {
    val place: Place = p.place;
    if (sel place.operand) { ret place.operand; }
    ret 0;
}

# the code of a piece of a value of type `ty` that travels as `passed`
fun piece_code(l: *Layout, ty: Type, passed: Passed, p: Piece, whole: bool, pointer: u32) res[u32, Error] {
    if (sel passed.passing.reference) { ret res[u32, Error].ok{pointer}; }
    if (whole && p.size == 16) {
        val s: res[types.Shape, types.Error] = types.shape(l.types, ty);
        if (sel s.ok) {
            val shape: types.Shape = s.ok;
            if (sel shape.vector) { ret res[u32, Error].ok{value.V128}; }
        }
    }
    if (whole) {
        val own: opt[u32] = value.of(l.types, ty, pointer);
        if (sel own.some) { ret res[u32, Error].ok{own.some}; }
    }
    val member: opt[Type] = abi.carried(l, ty, p.offset, p.size);
    if (sel member.some) {
        val held: opt[u32] = value.of(l.types, member.some, pointer);
        if (sel held.some) { ret res[u32, Error].ok{held.some}; }
    }
    if (p.size <= 4) { ret res[u32, Error].ok{value.I32}; }
    if (p.size == 8) { ret res[u32, Error].ok{value.I64}; }
    ret res[u32, Error].err{Error.unvalued{ty}};
}

# the codes of one value's pieces, each at its operand of a list
fun pieces(l: *Layout, asg: *Assignment, ty: Type, passed: Passed, pointer: u32, out: *vector.Vector[u32]) err[Error] {
    if (passed.count == 0) { ret err[Error].ok{}; }
    var whole: bool = false;
    if (!(sel passed.passing.reference) && passed.count == 1) {
        val s: res[types.Shape, types.Error] = types.shape(l.types, ty);
        if (sel s.err) { ret err[Error].err{Error.ir{module.Error.types{s.err}}}; }
        val shape: types.Shape = s.ok;
        if (!(sel shape.structure) && !(sel shape.array) && !(sel shape.union)) {
            val size: res[u64, record.Error] = layout.size(l, ty, types.DEFAULT_SPACE);
            if (sel size.err) { ret err[Error].err{Error.layout{size.err}}; }
            val p: Piece = piece.piece(asg, passed.first);
            whole = p.offset == 0 && p.size == size.ok;
        }
    }
    var n: u32 = 0;
    for (n < passed.count) {
        val p:    Piece           = piece.piece(asg, passed.first + n);
        val code: res[u32, Error] = piece_code(l, ty, passed, p, whole, pointer);
        if (sel code.err) { ret err[Error].err{code.err}; }
        val set: err[Error] = put(out, operand(p), code.ok);
        if (sel set.err) { ret set; }
        n = n + 1;
    }
    ret err[Error].ok{};
}

# the wasm function type of a signature under the build's convention rows
# ---
# a:         the allocator the placement takes
# b:         the build
# l:         the layout of the module's types
# signature: the function type
# pointer:   the value type of an address
# out:       an empty signature, filled
pub fun of(a: *allocator.Allocator, b: *Build, l: *Layout, signature: Type, pointer: u32, out: *Signature) err[Error] {
    val f: res[types.Function, types.Error] = types.signature(l.types, signature);
    if (sel f.err) { ret err[Error].err{Error.ir{module.Error.types{f.err}}}; }
    val placed: res[Passage, Unplaced] = abi.placement(a, b, l, signature, Named.all{});
    if (sel placed.err) { ret err[Error].err{Error.placement{placed.err}}; }
    var p: Passage = placed.ok;
    fin { val released: err[allocator.Error] = abi.release(?p); }
    val asg: *Assignment = ?p.assignment;
    if (sel asg.address.some) {
        val at: err[Error] = put(?out.params, operand(asg.address.some), pointer);
        if (sel at.err) { ret at; }
    }
    var i: usize = 0;
    for (i < asg.arguments.len) {
        val got: err[Error] = pieces(l, asg, f.ok.params.data[i], asg.arguments.data[i], pointer, ?out.params);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    i = 0;
    for (i < asg.results.len) {
        val got: err[Error] = pieces(l, asg, f.ok.results.data[i], asg.results.data[i], pointer, ?out.results);
        if (sel got.err) { ret got; }
        i = i + 1;
    }
    ret err[Error].ok{};
}
