# the webassembly rows of every axis a target is assembled from
#
# wasm32 and wasm64 compute alike and differ in the index type of their
# memory, so every row but the pointers is one for both. values live in the
# locals of a function, which mirl assigns by live range, control is
# structured, memory is linear and addressed physically, a function's address
# is a slot of the indirect call table and every operation takes its operands
# from the operand stack. the one convention is the basic c abi, and its data
# layout is that abi's for each width. wasi runs wasm32 alone, and no system of
# mink's catalog runs wasm64 yet, so wasm64 is a row with no address model.

use std.collections.slice.Slice;
use std.types.option.opt;

use masc.core.requirement;
use wasm_extension: masc.isa.wasm.gen_extension;

use mink.catalog.arch.wasm;
use mink.catalog.os.wasi.WASI;

use ir: mirl.ir.opcode;
use mirl.ir.type.format.BINARY16;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.target.abi.convention.Convention;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Model;
use mirl.target.address.Relocation;
use mirl.target.address.Threads;
use mirl.target.axis;
use mirl.target.capability.Addressing;
use mirl.target.capability.Align;
use mirl.target.capability.Arithmetic;
use mirl.target.capability.Attributes;
use mirl.target.capability.Bits;
use mirl.target.capability.Bulk;
use mirl.target.capability.BulkMemory;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Code;
use mirl.target.capability.Condition;
use mirl.target.capability.Constants;
use mirl.target.capability.Control;
use mirl.target.capability.Counts;
use mirl.target.capability.Data;
use mirl.target.capability.Division;
use mirl.target.capability.Evaluation;
use mirl.target.capability.Fault;
use mirl.target.capability.Fill;
use mirl.target.capability.Fit;
use mirl.target.capability.FloatLayout;
use mirl.target.capability.Form;
use mirl.target.capability.Formats;
use mirl.target.capability.Functions;
use mirl.target.capability.Held;
use mirl.target.capability.IntegerLayout;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.LongDivision;
use mirl.target.capability.Models;
use mirl.target.capability.Nans;
use mirl.target.capability.Native;
use mirl.target.capability.Natives;
use mirl.target.capability.Ops;
use mirl.target.capability.Pointer;
use mirl.target.capability.Products;
use mirl.target.capability.Registers;
use mirl.target.capability.Rules;
use mirl.target.capability.Scalar;
use mirl.target.capability.Stored;
use mirl.target.capability.Set;
use mirl.target.capability.Shifts;
use mirl.target.capability.Single;
use mirl.target.capability.SlotSpace;
use mirl.target.capability.Space;
use mirl.target.capability.Specialization;
use mirl.target.capability.Tables;
use mirl.target.capability.Unit;
use mirl.target.capability.Values;
use mirl.target.capability.VectorRegister;
use mirl.target.capability.VectorRule;
use mirl.target.capability.Vectors;
use mirl.target.capability.Width;
use mirl.target.capability.Widths;
use mirl.target.wasm.abi.BASIC;

val CONDITION_ATOMS: [2]requirement.Id = [2]requirement.Id{wasm_extension.SIMD128, wasm_extension.ATOMICS};

val CONDITION_ALTERNATIVES: [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[1], len: 1}, none: requirement.NO_IDS},
};

val UNDER_SIMD128: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[0], len: 1}};
# the threads proposal: atomics and shared memory
val UNDER_ATOMICS: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[1], len: 1}};

# one linear memory, laid out as c lays it out
val WASM32_POINTERS: [1]Space = [1]Space{Space{space: 0, pointer: Pointer.physical{Scalar{size: 4, align: 4}}, layout: Rules.c{}}};
val WASM64_POINTERS: [1]Space = [1]Space{Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}, layout: Rules.c{}}};

val WASM_ALU: [2]u32 = [2]u32{32, 64};

# min and max are ieee 754-2019's minimum and maximum, a nan for a nan
# operand and -0 below +0, the roundings are floor, ceil, trunc and nearest,
# and select takes any value type. there is no fminnum, fmaxnum or remainder
val WASM_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMIN, condition: Condition.always{}},
    Native{opcode: ir.FMAX, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};

# a nan result is a canonical or an arithmetic nan as the engine chooses,
# its sign undetermined, by the core specification's nan propagation
# (webassembly 3.0, 4.3.3 floating-point operations). only the deterministic
# profile fixes it, as the positive canonical nan, and a build here runs
# under the default profile, so the nan is unspecified
val WASM_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.always{}, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?WASM_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: Condition.always{}, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?WASM_NATIVES[0], size: 7}}, constants: Constants.made{}},
};

val WASM_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};

# v128 under simd128
val WASM_UNITS: [1]Unit = [1]Unit{
    Unit{requires: UNDER_SIMD128, width: Width.fixed{128}, counts: Counts.any{}, lanes: Slice[Lane]{data: ?WASM_LANES[0], size: 6}},
};

val WASM_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
    multiplied: Condition.always{},
    products:   Products.none{},
    # a shift count is taken modulo the width
    shifts: Shifts.wraps{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
    single: Single.none{},
    # a zero divisor traps, and so does an overflowing div_s, but an
    # overflowing rem_s gives 0, so overflow is tested
    division: Division{widths: Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.traps{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};

# code is no bytes of memory, so it states no alignment or fill
val WASM_CODE: Code = Code{
    function: Align.none{},
    text:     Align.none{},
    data:     Align.none{},
    fill:     Fill.none{},
};

# memory.copy and memory.fill are the bulk memory extension's, which the
# helpers stand in for
val WASM32_CAPS: Capabilities = Capabilities{
    registers:      Registers.locals{},
    control:        Control.structured{},
    tables:         Tables.none{},
    addressing:     Addressing.physical{},
    functions:      Functions.slots{},
    specialization: Specialization.fold{},
    values:         Values.typed{},
    evaluation:     Evaluation.stack{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?WASM32_POINTERS[0], size: 1},
        slots:    SlotSpace.space{0},
        models:   Models.none{},
        register: Bits.none{},
        alu:      Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
        integers: Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?WASM_UNITS[0], size: 1}},
    formats:    Formats.held{Slice[Held]{data: ?WASM_HELD[0], size: 2}},
    arithmetic: WASM_ARITHMETIC,
    bulk:       BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    code:       WASM_CODE,
    attributes: Attributes.none{},
    ops:        Ops.none{},
};

val WASM64_CAPS: Capabilities = Capabilities{
    registers:      Registers.locals{},
    control:        Control.structured{},
    tables:         Tables.none{},
    addressing:     Addressing.physical{},
    functions:      Functions.slots{},
    specialization: Specialization.fold{},
    values:         Values.typed{},
    evaluation:     Evaluation.stack{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?WASM64_POINTERS[0], size: 1},
        slots:    SlotSpace.space{0},
        models:   Models.none{},
        register: Bits.none{},
        alu:      Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
        integers: Set.widths{Slice[u32]{data: ?WASM_ALU[0], size: 2}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?WASM_UNITS[0], size: 1}},
    formats:    Formats.held{Slice[Held]{data: ?WASM_HELD[0], size: 2}},
    arithmetic: WASM_ARITHMETIC,
    bulk:       BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    code:       WASM_CODE,
    attributes: Attributes.none{},
    ops:        Ops.none{},
};

# the integers of the basic c abi (tool-conventions, BasicCABI.md, "data
# representation") at either width: bool and the integers to long long at
# their size and __int128_t at 16. it supports _BitInt(N) up to 128 bits
# alone, so a wider integer is held nowhere in memory
val WASM_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.refused{}},
    IntegerLayout{width: 512, stored: Stored.refused{}},
};
# float and double at their size. the basic c abi states no 16-bit float, so
# one is held nowhere in memory
val WASM_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.refused{}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# a vector at least as wide as v128 aligns to its 16 bytes
val WASM_VECTOR_REGISTERS: [1]VectorRegister = [1]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
};

val WASM_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?WASM_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?WASM_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?WASM_VECTOR_REGISTERS[0], size: 1}}},
};

val MACHINES: [2]axis.Machine = [2]axis.Machine{
    axis.Machine{arch: ?wasm.WASM32, caps: WASM32_CAPS},
    axis.Machine{arch: ?wasm.WASM64, caps: WASM64_CAPS},
};

# the basic c abi at either width, its data layout the same: the pointers
# the capabilities state are the one difference
val MEMBERS: [2]axis.Member = [2]axis.Member{
    axis.Member{arch: ?wasm.WASM32, name: "basic", row: opt[*Convention].some{?BASIC}, data: WASM_DATA},
    axis.Member{arch: ?wasm.WASM64, name: "basic", row: opt[*Convention].some{?BASIC}, data: WASM_DATA},
};

# a wasi module is laid out at the addresses its one memory holds, so every
# address is absolute. one thread runs unless the build takes the threads
# proposal, so a thread-local variable of any model is an ordinary one
val WASI_ADDRESSES: Model = Model{
    relocation: Relocation.static{},
    threads:    Threads{
        general_dynamic: Access.single{UNDER_ATOMICS},
        local_dynamic:   Access.single{UNDER_ATOMICS},
        initial_exec:    Access.single{UNDER_ATOMICS},
        local_exec:      Access.single{UNDER_ATOMICS},
        lookup:          "",
    },
};

val MODELS: [1]axis.Model = [1]axis.Model{
    axis.Model{arch: ?wasm.WASM32, system: ?WASI, addresses: Addresses.model{WASI_ADDRESSES}},
};

# the webassembly rows of every axis
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 2},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 2},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 1},
};
