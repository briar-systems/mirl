# the bytes of a page of linear memory
pub val PAGE: u64 = 0x1_0000;

# the module imports come from where the environment names none
pub val IMPORTS: str = "env";

val NO_NAME: View = View{data: nil, len: 0};

fun lost(e: allocator.Error) err[Error] {
    ret err[Error].err{Error.alloc{e}};
}

fun refused(f: Fail) err[Error] {
    ret err[Error].err{Error.object{f}};
}

fun kept(got: err[Fail]) err[Error] {
    if (sel got.err) { ret refused(got.err); }
    ret err[Error].ok{};
}

fun defined(p: ptr, at: u16, code: u32) res[u32, Error] {
    val got: res[u32, str] = wasm_stream.define(p, at, code, NO_NAME);
    if (sel got.err) { ret res[u32, Error].err{Error.encoding{Encoding{function: 0xFFFF_FFFF, message: got.err}}}; }
    ret res[u32, Error].ok{got.ok};
}

fun declared(m: *Module, f: usize) bool {
    ret m.functions.data[f].body.blocks.len == 0;
}

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# the module the environment names for the imports of the functions another module defines
fun import_module(t: *Target) str {
    if (sel t.env.none) { ret IMPORTS; }
    val e: *systems.Env = t.env.some;
    var i: usize        = 0;
    for (i < e.fact_count) {
        if (e.facts[i].role == ?systems.IMPORT_MODULE) { ret e.facts[i].name; }
        i = i + 1;
    }
    ret IMPORTS;
}

# whether one thread runs, by the target's statement of how a thread-local
# variable is reached: one is an ordinary variable exactly where one thread
# runs. a target that states no model states no threads, and reaches no
# atomic as an ordinary access
fun threadless(b: *Build, t: *Target) res[bool, Error] {
    val a: Addresses = t.addresses;
    if (!(sel a.model)) { ret res[bool, Error].ok{false}; }
    val access: Access = a.model.threads.local_exec;
    if (!(sel access.single)) { ret res[bool, Error].ok{false}; }
    val met: res[bool, basis.Error] = basis.meets(opt[*basis.Basis].some{?b.basis}, access.single);
    if (sel met.err) { ret res[bool, Error].ok{false}; }
    ret res[bool, Error].ok{!met.ok};
}

# a constant expression of one constant of the address type `code`, its end opcode included, held by the module
fun expression(u: *Unit, mm: *wasm_object.Module, code: u32, n: u64) res[wasm_object.Span, Error] {
    var w: Writer = writer.make(u.a, u.codec, u.ctx, ?u.features);
    fin { writer.release(?w); }
    w.observe = false;
    if (code == value.I64) { writer.i64(?w, n:~i64); }
    or                     { writer.i32(?w, n:~i64); }
    writer.plain(?w, gen_row_index.END);
    if (sel w.refused.some) { ret res[wasm_object.Span, Error].err{Error.encoding{Encoding{function: 0xFFFF_FFFF, message: w.refused.some}}}; }
    val held: res[wasm_object.Span, Fail] = wasm_object.hold(mm, w.out.data, w.out.len);
    if (sel held.err) { ret res[wasm_object.Span, Error].err{Error.object{held.err}}; }
    ret res[wasm_object.Span, Error].ok{held.ok};
}

# the type index of a signature, the stream's first of it or a new one
fun type_index(p: ptr, s: *Signature) res[u32, Error] {
    val found: opt[u32] = wasm_stream.find_type(p, s.params.data, s.params.len::u32, s.results.data, s.results.len::u32);
    if (sel found.some) { ret res[u32, Error].ok{found.some}; }
    val made: res[u32, str] = wasm_stream.add_type(p, s.params.data, s.params.len::u32, s.results.data, s.results.len::u32, NO_NAME);
    if (sel made.err) { ret res[u32, Error].err{Error.encoding{Encoding{function: 0xFFFF_FFFF, message: made.err}}}; }
    ret res[u32, Error].ok{made.ok};
}

# simd128 as a feature used where a function type holds a v128
fun vectored(u: *Unit, s: *Signature) {
    var k: usize = 0;
    for (k < s.params.len) {
        if (s.params.data[k] == value.V128) { writer.uses(?u.features, wasm_extension.SIMD128); }
        k = k + 1;
    }
    k = 0;
    for (k < s.results.len) {
        if (s.results.data[k] == value.V128) { writer.uses(?u.features, wasm_extension.SIMD128); }
        k = k + 1;
    }
}

# every function's type and index, each another module defines imported first and then each the module defines
fun functions(u: *Unit, mm: *wasm_object.Module) err[Error] {
    val m: *Module = u.m;
    val n: usize   = m.functions.len;
    var i: usize   = 0;
    for (i < n) {
        var s:      Signature                   = signature.make(u.a);
        val got:    err[Error]                  = signature.of(u.a, u.b, u.l, m.functions.data[i].data.signature, u.pointer, ?s);
        val pushed: res[usize, allocator.Error] = vector.push[Signature](?u.signatures, s);
        if (sel pushed.err) {
            signature.release(?s);
            ret lost(pushed.err);
        }
        if (sel got.err) { ret got; }
        vectored(u, ?u.signatures.data[i]);
        val t: res[u32, Error] = type_index(u.ctx.stream, ?u.signatures.data[i]);
        if (sel t.err) { ret err[Error].err{t.err}; }
        val typed: res[usize, allocator.Error] = vector.push[u32](?u.types, t.ok);
        if (sel typed.err) { ret lost(typed.err); }
        val indexed: res[usize, allocator.Error] = vector.push[u32](?u.index, 0);
        if (sel indexed.err) { ret lost(indexed.err); }
        i = i + 1;
    }
    val from: View = view_of(import_module(u.t));
    i = 0;
    for (i < n) {
        if (declared(m, i)) {
            val at: res[u32, Error] = defined(u.ctx.stream, wasm_kind.FUNCS, u.types.data[i]);
            if (sel at.err) { ret err[Error].err{at.err}; }
            u.index.data[i] = at.ok;
            val put: err[Error] = kept(wasm_object.import(mm, from, module.name_of(m, m.functions.data[i].data.name), wasm_object.Desc.function{u.types.data[i]}));
            if (sel put.err) { ret put; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < n) {
        if (!declared(m, i)) {
            val at: res[u32, Error] = defined(u.ctx.stream, wasm_kind.FUNCS, u.types.data[i]);
            if (sel at.err) { ret err[Error].err{at.err}; }
            u.index.data[i] = at.ok;
            val put: err[Error] = kept(wasm_object.define(mm, wasm_object.Desc.function{u.types.data[i]}));
            if (sel put.err) { ret put; }
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the alignment of a global: the one it states, else its type's, 1 for none
fun align_of(u: *Unit, g: *GlobalData) res[u64, Error] {
    var align: u64 = 0;
    if (sel g.alignment.some) { align = g.alignment.some; }
    or {
        val own: res[u64, record.Error] = layout.align(u.l, g.type, type_table.DEFAULT_SPACE);
        if (sel own.err) { ret res[u64, Error].err{Error.layout{own.err}}; }
        align = own.ok;
    }
    if (align == 0) { align = 1; }
    ret res[u64, Error].ok{align};
}

# the globals the object defines laid out from 0, each at its alignment, a global another module defines at 0, and
# the linear memory, the stack pointer and, where a body calls through it, the table imported
fun memory(u: *Unit, mm: *wasm_object.Module) err[Error] {
    val m:  *Module = u.m;
    var at: u64     = 0;
    var i:  usize   = 0;
    for (i < m.globals.len) {
        val g:     *GlobalData = ?m.globals.data[i].data;
        var place: u64         = 0;
        if (sel g.initial.some) {
            val align: res[u64, Error] = align_of(u, g);
            if (sel align.err) { ret err[Error].err{align.err}; }
            at = (at + align.ok - 1) / align.ok * align.ok;
            val size: res[u64, record.Error] = layout.size(u.l, g.type, type_table.DEFAULT_SPACE);
            if (sel size.err) { ret err[Error].err{Error.layout{size.err}}; }
            place = at;
            at    = at + size.ok;
        }
        val pushed: res[usize, allocator.Error] = vector.push[u64](?u.addresses, place);
        if (sel pushed.err) { ret lost(pushed.err); }
        i = i + 1;
    }
    val env:    View        = view_of(IMPORTS);
    val limits: fact.Limits = fact.Limits{min: (at + PAGE - 1) / PAGE, max: opt[u64].none{}, shared: false, wide: u.pointer == value.I64};
    val mem:    err[Error]  = kept(wasm_object.import(mm, env, view_of("__linear_memory"), wasm_object.Desc.memory{limits}));
    if (sel mem.err) { ret mem; }
    val defined_mem: res[u32, Error] = defined(u.ctx.stream, wasm_kind.MEMORIES, u.pointer);
    if (sel defined_mem.err) { ret err[Error].err{defined_mem.err}; }
    val gt: wasm_object.Global = wasm_object.Global{value: u.pointer::i64, mutable: true, init: opt[wasm_object.Span].none{}};
    val sp: err[Error]         = kept(wasm_object.import(mm, env, view_of("__stack_pointer"), wasm_object.Desc.global{gt}));
    if (sel sp.err) { ret sp; }
    writer.uses(?u.features, wasm_extension.MUTABLE_GLOBALS);
    val stack: res[u32, Error] = defined(u.ctx.stream, wasm_kind.GLOBALS, u.pointer);
    if (sel stack.err) { ret err[Error].err{stack.err}; }
    u.stack = stack.ok;
    if (!indirect(m)) { ret err[Error].ok{}; }
    val none: fact.Limits           = fact.Limits{min: 0, max: opt[u64].none{}, shared: false, wide: false};
    val tt:   wasm_object.TableType = wasm_object.TableType{elem: wasm_valtype.FUNCREF::i64, limits: none, init: opt[wasm_object.Span].none{}};
    val tab:  err[Error]            = kept(wasm_object.import(mm, env, view_of("__indirect_function_table"), wasm_object.Desc.table{tt}));
    if (sel tab.err) { ret tab; }
    val defined_tab: res[u32, Error] = defined(u.ctx.stream, wasm_kind.TABLES, wasm_stream.I32);
    if (sel defined_tab.err) { ret err[Error].err{defined_tab.err}; }
    ret err[Error].ok{};
}

# whether a body of the module calls through the table
fun indirect(m: *Module) bool {
    var i: usize = 0;
    for (i < m.functions.len) {
        val b: *Body = ?m.functions.data[i].body;
        var k: usize = 0;
        for (k < b.instructions.len) {
            val d: *InstructionData = ?b.instructions.data[k];
            if (d.opcode == opcode_table.CALL_PLACED && d.operands.len > 0) {
                val callee: opt[Function] = wasm_operand.direct(m, b, d.operands.data[0]);
                if (sel callee.none) { ret true; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# the fixups of one section of the object, which become its relocations once its symbols are
# ---
# section: the section
# fixups:  its fixups, each at its offset in the section
rec Pending {
    section: Id[object.Section];
    fixups:  vector.Vector[field.Fixup];
}

fun release_pending(p: *vector.Vector[Pending]) {
    var i: usize = 0;
    for (i < p.len) {
        vector.dnit[field.Fixup](?p.data[i].fixups);
        i = i + 1;
    }
    vector.dnit[Pending](p);
}

# what the object is stated from
# ---
# pending:  the fixups of each body and segment section
# segments: per global, the section of its data segment, none for one another module defines
rec Made {
    pending:  vector.Vector[Pending];
    segments: vector.Vector[opt[Id[object.Section]]];
}

# every defined function's body, a text section of the object, the fixups of its symbolic operands kept at their
# offsets in it and its rows kept for its line records
fun bodies(u: *Unit, mm: *wasm_object.Module, made: *Made) err[Error] {
    val m: *Module = u.m;
    var k: usize   = 0;
    var i: usize   = 0;
    for (i < m.functions.len) {
        if (!declared(m, i)) {
            var out: vector.Vector[u8] = vector.init[u8](u.a);
            fin { vector.dnit[u8](?out); }
            var fixups:    vector.Vector[field.Fixup] = vector.init[field.Fixup](u.a);
            var kept_rows: line.Body                  = line.Body{rows: vector.init[line.Row](u.a), size: 0};
            val got:       err[Error]                 = code.function(u, (i::u32), ?out, ?fixups, ?kept_rows.rows);
            kept_rows.size = out.len::u64;
            val listed: res[usize, allocator.Error] = vector.push[line.Body](?u.lines, kept_rows);
            if (sel listed.err) {
                line.release(?kept_rows);
                vector.dnit[field.Fixup](?fixups);
                ret lost(listed.err);
            }
            if (sel got.err) {
                vector.dnit[field.Fixup](?fixups);
                ret got;
            }
            val s: res[Id[object.Section], Fail] = wasm_object.body(mm, k, out.data, out.len);
            if (sel s.err) {
                vector.dnit[field.Fixup](?fixups);
                ret refused(s.err);
            }
            val noted: res[usize, allocator.Error] = vector.push[Pending](?made.pending, Pending{section: s.ok, fixups: fixups});
            if (sel noted.err) {
                vector.dnit[field.Fixup](?fixups);
                ret lost(noted.err);
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# the name of a global's data segment: the section it names, else the name mink gives a data segment of the kind
# its placement takes, then a dot and its name
fun segment_name(u: *Unit, g: *GlobalData, initial: Constant, bytes: *vector.Vector[u8]) res[View, Error] {
    if (sel g.section.some) { ret res[View, Error].ok{g.section.some.name}; }
    val held: res[module.Contents, module.Error] = module.contents(u.m, initial);
    if (sel held.err) { ret res[View, Error].err{Error.ir{held.err}}; }
    val kind:   *section.Kind  = address.placement(g.constant, false, held.ok, false);
    val prefix: res[str, Fail] = mink_neutral.segment_name(section.Key{kind: kind, entsize: 0});
    if (sel prefix.err) { ret res[View, Error].err{Error.object{prefix.err}}; }
    val called: View  = module.name_of(u.m, g.name);
    val n:      usize = str_len(prefix.ok);
    var i:      usize = 0;
    for (i < n + 1 + called.len) {
        var c: u8 = '.';
        if (i < n) { c = prefix.ok[i]; }
        or (i > n) { c = called.data[i - n - 1]; }
        val pushed: res[usize, allocator.Error] = vector.push[u8](bytes, c);
        if (sel pushed.err) { ret res[View, Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    ret res[View, Error].ok{View{data: bytes.data, len: bytes.len}};
}

# where a global's data segment lies: its section named by segment_name, of the kind mink reads that name as, at the
# global's alignment
fun placed(u: *Unit, g: *GlobalData, initial: Constant, bytes: *vector.Vector[u8]) res[wasm_object.Placed, Error] {
    val align: res[u64, Error] = align_of(u, g);
    if (sel align.err) { ret res[wasm_object.Placed, Error].err{align.err}; }
    val named: res[View, Error] = segment_name(u, g, initial, bytes);
    if (sel named.err) { ret res[wasm_object.Placed, Error].err{named.err}; }
    val kind: *section.Kind = mink_neutral.segment_kind(Bytes{data: named.ok.data, len: named.ok.len});
    ret res[wasm_object.Placed, Error].ok{wasm_object.Placed{name: opt[View].some{named.ok}, kind: kind, flags: kind.flags, align: align.ok}};
}

# each global the object defines as a data segment of its own, active at its address, every address in its initial
# value a fixup kept at its offset in the segment, which holds its provisional value
fun segments(u: *Unit, mm: *wasm_object.Module, made: *Made) err[Error] {
    val m: *Module = u.m;
    var i: usize   = 0;
    for (i < m.globals.len) {
        val g:       *GlobalData   = ?m.globals.data[i].data;
        val initial: opt[Constant] = g.initial;
        val owner:   Global        = (i::u32);
        i = i + 1;
        if (sel initial.none) {
            val none: res[usize, allocator.Error] = vector.push[opt[Id[object.Section]]](?made.segments, opt[Id[object.Section]].none{});
            if (sel none.err) { ret lost(none.err); }
            cnt;
        }
        val size: res[u64, record.Error] = layout.size(u.l, g.type, type_table.DEFAULT_SPACE);
        if (sel size.err) { ret err[Error].err{Error.layout{size.err}}; }
        val image_of: res[data.Image, data.Error] = data.image(u.a, m, u.l, type_table.DEFAULT_SPACE, binary.LITTLE, initial.some, size.ok);
        if (sel image_of.err) { ret err[Error].err{Error.image{image_of.err}}; }
        var image: data.Image = image_of.ok;
        fin { data.release(?image); }
        var fixups: vector.Vector[field.Fixup] = vector.init[field.Fixup](u.a);
        var k:      usize                      = 0;
        for (k < image.datums.len) {
            val d:    data.Datum                  = image.datums.data[k];
            val kind: opt[masc_operand.FixupKind] = relocation.datum_kind(d);
            if (sel kind.none) {
                vector.dnit[field.Fixup](?fixups);
                ret err[Error].err{Error.width{owner}};
            }
            if (sel d.symbol.function) {
                if (d.addend != 0) {
                    vector.dnit[field.Fixup](?fixups);
                    ret err[Error].err{Error.offset{d.symbol.function}};
                }
            }
            val listed: res[usize, allocator.Error] = vector.push[field.Fixup](?fixups, relocation.datum_fixup(u, d, kind.some, d.offset));
            if (sel listed.err) {
                vector.dnit[field.Fixup](?fixups);
                ret lost(listed.err);
            }
            k = k + 1;
        }
        val settled: err[Error] = relocation.settle(u, ?image.bytes, ?fixups);
        if (sel settled.err) {
            vector.dnit[field.Fixup](?fixups);
            ret settled;
        }
        val start: res[wasm_object.Span, Error] = expression(u, mm, u.pointer, u.addresses.data[owner]);
        if (sel start.err) {
            vector.dnit[field.Fixup](?fixups);
            ret err[Error].err{start.err};
        }
        var named: vector.Vector[u8] = vector.init[u8](u.a);
        fin { vector.dnit[u8](?named); }
        val at: res[wasm_object.Placed, Error] = placed(u, g, initial.some, ?named);
        if (sel at.err) {
            vector.dnit[field.Fixup](?fixups);
            ret err[Error].err{at.err};
        }
        val head: wasm_object.Head              = wasm_object.Head.active{wasm_object.At{index: opt[u32].none{}, offset: start.ok}};
        val s:    res[Id[object.Section], Fail] = wasm_object.segment(mm, head, at.ok, image.bytes.data, image.bytes.len);
        if (sel s.err) {
            vector.dnit[field.Fixup](?fixups);
            ret refused(s.err);
        }
        val noted: res[usize, allocator.Error] = vector.push[Pending](?made.pending, Pending{section: s.ok, fixups: fixups});
        if (sel noted.err) {
            vector.dnit[field.Fixup](?fixups);
            ret lost(noted.err);
        }
        val segment: res[usize, allocator.Error] = vector.push[opt[Id[object.Section]]](?made.segments, opt[Id[object.Section]].some{s.ok});
        if (sel segment.err) { ret lost(segment.err); }
    }
    ret err[Error].ok{};
}

fun release_unit(u: *Unit) {
    head.release(?u.heads);
    var i: usize = 0;
    for (i < u.signatures.len) {
        signature.release(?u.signatures.data[i]);
        i = i + 1;
    }
    vector.dnit[Signature](?u.signatures);
    vector.dnit[u32](?u.index);
    vector.dnit[u32](?u.types);
    vector.dnit[u64](?u.addresses);
    i = 0;
    for (i < u.lines.len) {
        line.release(?u.lines.data[i]);
        i = i + 1;
    }
    vector.dnit[line.Body](?u.lines);
}

# the binding of a linkage: local where other objects do not see it, weak, or global
fun binding_of(l: Linkage) *symbol.Binding {
    if (!symbol.binds(l.binding, symbol.EXTERNAL)) { ret ?symbol.LOCAL; }
    if (symbol.binds(l.binding, symbol.WEAK))      { ret ?symbol.WEAKLY; }
    ret ?symbol.GLOBAL;
}

# the visibility of a linkage: hidden where other images do not see it
fun visibility_of(l: Linkage) *symbol.Visibility {
    if ((l.visibility.caps & symbol.EXPORTED) == 0) { ret ?symbol.HIDDEN; }
    ret ?symbol.DEFAULT;
}

# the entry of the index `index` of a space whose entries `list` lists
fun nth_entry(list: *table.Table[Id[object.Entry]], index: u32) res[Id[object.Entry], Error] {
    if (index::usize >= table.count[Id[object.Entry]](list)) { ret res[Id[object.Entry], Error].err{Error.object{fail.internal("an index lies past its space")}}; }
    ret res[Id[object.Entry], Error].ok{@table.at[Id[object.Entry]](list, table.nth[Id[object.Entry]](index::usize))};
}

# the import entry `e` named by the symbol `sym`, standing where nothing defines it when `stays` holds
fun names_import(o: *object.Object, e: Id[object.Entry], sym: Id[object.Symbol], stays: bool) err[Error] {
    val en: *object.Entry = table.at[object.Entry](?o.entries, e);
    if (!sel en.import.some) { ret refused(fail.internal("an undefined symbol names an entry that is no import")); }
    ret import_named(en, en.import.some, sym, stays);
}

fun import_named(en: *object.Entry, was: object.Import, sym: Id[object.Symbol], stays: bool) err[Error] {
    var imp: object.Import = was;
    imp.symbol = opt[Id[object.Symbol]].some{sym};
    imp.stays  = stays;
    en.import  = opt[object.Import].some{imp};
    ret err[Error].ok{};
}

# what a symbol is, as its linkage and the object state it
# ---
# binding:    its binding
# visibility: its visibility
# export:     whether the module marks it exported
# kind:       its kind
# def:        its definition
# size:       its size, none for none
rec Stated {
    binding:    *symbol.Binding;
    visibility: *symbol.Visibility;
    export:     bool;
    kind:       *symbol.Kind;
    def:        object.Definition;
    size:       opt[u64];
}

# a symbol stated by its linkage
fun linked(l: Linkage, kind: *symbol.Kind, def: object.Definition, size: opt[u64]) Stated {
    ret Stated{binding: binding_of(l), visibility: visibility_of(l), export: l.export, kind: kind, def: def, size: size};
}

# one symbol of the object named by the handle `n` of its names, listed in `out`, an export directive where the module
# marks it exported
fun symbol_of(o: *object.Object, n: Id[Name], st: Stated, out: *vector.Vector[Id[object.Symbol]]) res[Id[object.Symbol], Error] {
    val added: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: n, binding: st.binding, visibility: st.visibility, kind: st.kind, def: st.def, size: st.size, retain: false});
    if (sel added.err) { ret res[Id[object.Symbol], Error].err{Error.object{added.err}}; }
    val listed: res[usize, allocator.Error] = vector.push[Id[object.Symbol]](out, added.ok);
    if (sel listed.err) { ret res[Id[object.Symbol], Error].err{Error.alloc{listed.err}}; }
    if (st.export) {
        val d: res[Id[object.Directive], Fail] = object.add_directive(o, object.Directive{kind: ?directive.EXPORT, text: n, symbol: opt[Id[Name]].some{n}});
        if (sel d.err) { ret res[Id[object.Symbol], Error].err{Error.object{d.err}}; }
    }
    ret res[Id[object.Symbol], Error].ok{added.ok};
}

# the symbols in the order mirl.target.wasm.relocation gives: every function, every global, then the stack pointer.
# where the target's environment names a module of imports, a function another module defines names its import to
# stay, so a function no object of the link defines stays an import of that module, the host's own interface
fun symbols(u: *Unit, o: *object.Object, made: *Made, out: *vector.Vector[Id[object.Symbol]]) err[Error] {
    val m:      *Module               = u.m;
    val hosted: bool                  = import_module(u.t) != IMPORTS;
    val ix:     res[fact.Index, Fail] = fact.indexed(o);
    if (sel ix.err) { ret refused(ix.err); }
    var index: fact.Index = ix.ok;
    fin { val gone: err[Fail] = fact.release_index(?index); }
    var i: usize = 0;
    for (i < m.functions.len) {
        val f: *Node                        = ?m.functions.data[i];
        val e: res[Id[object.Entry], Error] = nth_entry(?index.functions, u.index.data[i]);
        if (sel e.err) { ret err[Error].err{e.err}; }
        var def: object.Definition = object.Definition.entry{e.ok};
        if (declared(m, i)) { def = object.Definition.undefined{}; }
        val sym: res[Id[object.Symbol], Error] = symbol_of(o, f.data.name, linked(f.data.linkage, ?symbol.FUNCTION, def, opt[u64].none{}), out);
        if (sel sym.err) { ret err[Error].err{sym.err}; }
        if (declared(m, i)) {
            val named: err[Error] = names_import(o, e.ok, sym.ok, hosted);
            if (sel named.err) { ret named; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < m.globals.len) {
        val g:       *GlobalData             = ?m.globals.data[i].data;
        val segment: opt[Id[object.Section]] = made.segments.data[i];
        var def:     object.Definition       = object.Definition.undefined{};
        var size:    opt[u64]                = opt[u64].none{};
        if (sel segment.some) {
            val got: res[u64, record.Error] = layout.size(u.l, g.type, type_table.DEFAULT_SPACE);
            if (sel got.err) { ret err[Error].err{Error.layout{got.err}}; }
            def  = object.Definition.placed{object.Place{section: segment.some, offset: 0}};
            size = object.sized(got.ok);
        }
        val sym: res[Id[object.Symbol], Error] = symbol_of(o, g.name, linked(g.linkage, ?symbol.DATA, def, size), out);
        if (sel sym.err) { ret err[Error].err{sym.err}; }
        i = i + 1;
    }
    val stack: res[Id[object.Entry], Error] = nth_entry(?index.globals, u.stack);
    if (sel stack.err) { ret err[Error].err{stack.err}; }
    val plain:  Stated              = Stated{binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, export: false, kind: ?symbol.INDEXED, def: object.Definition.undefined{}, size: opt[u64].none{}};
    val called: res[Id[Name], Fail] = object.name_str(o, "__stack_pointer");
    if (sel called.err) { ret refused(called.err); }
    val sp: res[Id[object.Symbol], Error] = symbol_of(o, called.ok, plain, out);
    if (sel sp.err) { ret err[Error].err{sp.err}; }
    ret names_import(o, stack.ok, sp.ok, false);
}

# a symbol for each import no symbol names, the memory and the table, named by its field so a link resolves the
# import by that name, and a fact recording it, as wasm writes no symbol of a memory and the conventions name the
# table by its import alone (mink.format.wasm.fact, FIELD_SYMBOL)
fun fielded(o: *object.Object) err[Error] {
    var i: usize = 0;
    for (i < table.count[object.Entry](?o.entries)) {
        val e:  Id[object.Entry] = table.nth[object.Entry](i);
        val en: *object.Entry    = table.at[object.Entry](?o.entries, e);
        i = i + 1;
        if (!sel en.import.some)            { cnt; }
        if (sel en.import.some.symbol.some) { cnt; }
        val added: res[Id[object.Symbol], Fail] = object.add_symbol(o, object.Symbol{name: en.import.some.field, binding: ?symbol.GLOBAL, visibility: ?symbol.DEFAULT, kind: ?symbol.INDEXED, def: object.Definition.undefined{}});
        if (sel added.err) { ret refused(added.err); }
        val named: err[Error] = names_import(o, e, added.ok, false);
        if (sel named.err) { ret named; }
        val f: res[Id[object.Fact], Fail] = object.add_fact(o, object.Fact{format: ?format.WASM, key: fact.FIELD_SYMBOL, value: added.ok.index::u64, data: object.Contents.zero{0}});
        if (sel f.err) { ret refused(f.err); }
    }
    ret err[Error].ok{};
}

# every kept fixup a relocation of its section
fun relocations(o: *object.Object, made: *Made, out: *vector.Vector[Id[object.Symbol]]) err[Error] {
    val ix: res[fact.Index, Fail] = fact.indexed(o);
    if (sel ix.err) { ret refused(ix.err); }
    var index: fact.Index = ix.ok;
    fin { val gone: err[Fail] = fact.release_index(?index); }
    var i: usize = 0;
    for (i < made.pending.len) {
        val p: *Pending = ?made.pending.data[i];
        var k: usize    = 0;
        for (k < p.fixups.len) {
            val r: res[object.Reloc, Error] = relocation.record(?p.fixups.data[k], p.section, out, ?index.types);
            if (sel r.err) { ret err[Error].err{r.err}; }
            val added: res[Id[object.Reloc], Fail] = object.add_reloc(o, r.ok);
            if (sel added.err) { ret refused(added.err); }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# a feature of the set, its mark and its name
rec Marked {
    mark: u8;
    name: str;
}

fun before(a: str, b: str) bool {
    var i: usize = 0;
    for (a[i] != 0 && b[i] != 0) {
        if (a[i] != b[i]) { ret a[i] < b[i]; }
        i = i + 1;
    }
    ret a[i] == 0 && b[i] != 0;
}

# the target features of the code (tool-conventions, Linking.md, "Target Features Section") as the object's
# wasm-features trait, none where it states nothing: each feature the code uses marked `+`, by its extension's name in
# masc's wasm catalog, which is the name the conventions give it, and `shared-mem` marked `-` where the code relies on
# one thread, as the conventions' producers mark code whose atomics were made ordinary accesses, so no link puts it in a
# shared memory. the trait states them in name order
fun features(u: *Unit, o: *object.Object) err[Error] {
    var marked: vector.Vector[Marked] = vector.init[Marked](u.a);
    fin { vector.dnit[Marked](?marked); }
    var id: u32 = 0;
    for (id < wasm_extension.COUNT && id < 64) {
        if ((u.features.used & (1u64 << id::u64)) != 0) {
            val put: res[usize, allocator.Error] = vector.push[Marked](?marked, Marked{mark: '+', name: wasm_extension.ROWS[id].name});
            if (sel put.err) { ret lost(put.err); }
        }
        id = id + 1;
    }
    if (u.features.single) {
        val put: res[usize, allocator.Error] = vector.push[Marked](?marked, Marked{mark: '-', name: "shared-mem"});
        if (sel put.err) { ret lost(put.err); }
    }
    if (marked.len == 0) { ret err[Error].ok{}; }
    var i: usize = 1;
    for (i < marked.len) {
        var k: usize = i;
        for (k > 0 && before(marked.data[k].name, marked.data[k - 1].name)) {
            val held: Marked = marked.data[k];
            marked.data[k]     = marked.data[k - 1];
            marked.data[k - 1] = held;
            k                  = k - 1;
        }
        i = i + 1;
    }
    var text: vector.Vector[u8] = vector.init[u8](u.a);
    fin { vector.dnit[u8](?text); }
    i = 0;
    for (i < marked.len) {
        val put: err[allocator.Error] = feature(?text, marked.data[i].mark, marked.data[i].name);
        if (sel put.err) { ret lost(put.err); }
        i = i + 1;
    }
    val held: res[Held, Fail] = store.own(?o.store, text.data, text.len);
    if (sel held.err) { ret refused(held.err); }
    ret kept(object.state(o, ?wasm_arch.WASM_FEATURES, Setting.set{held.ok}));
}

# one feature of the set mink's target features trait spells: its mark and
# name, after a comma where one comes before it
fun feature(text: *vector.Vector[u8], mark: u8, called: str) err[allocator.Error] {
    if (text.len != 0) {
        val comma: res[usize, allocator.Error] = vector.push[u8](text, ',');
        if (sel comma.err) { ret err[allocator.Error].err{comma.err}; }
    }
    val marked: res[usize, allocator.Error] = vector.push[u8](text, mark);
    if (sel marked.err) { ret err[allocator.Error].err{marked.err}; }
    var i: usize = 0;
    for (i < str_len(called)) {
        val got: res[usize, allocator.Error] = vector.push[u8](text, called[i]);
        if (sel got.err) { ret err[allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the object's entries, stated through masc's module maker: the functions, the memory and what else is imported, each
# body, then each data segment
fun stated(u: *Unit, mm: *wasm_object.Module, made: *Made) err[Error] {
    val listed: err[Error] = functions(u, mm);
    if (sel listed.err) { ret listed; }
    val laid: err[Error] = memory(u, mm);
    if (sel laid.err) { ret laid; }
    val written: err[Error] = bodies(u, mm, made);
    if (sel written.err) { ret written; }
    ret segments(u, mm, made);
}

# the object's symbols, relocations, target features and line records, once its entries are
fun complete(u: *Unit, o: *object.Object, made: *Made) err[Error] {
    var out: vector.Vector[Id[object.Symbol]] = vector.init[Id[object.Symbol]](u.a);
    fin { vector.dnit[Id[object.Symbol]](?out); }
    val named: err[Error] = symbols(u, o, made, ?out);
    if (sel named.err) { ret named; }
    val fields: err[Error] = fielded(o);
    if (sel fields.err) { ret fields; }
    val relocated: err[Error] = relocations(o, made, ?out);
    if (sel relocated.err) { ret relocated; }
    val featured: err[Error] = features(u, o);
    if (sel featured.err) { ret featured; }
    ret line.records(u.a, u.m, ?u.lines, o);
}

# compile a scheduled module into mink's relocatable object of one wasm module
# ---
# a:        the allocator every stage and the object take
# m:        the module, scheduled
# b:        the build the family opened
# t:        the target
# warnings: the list each warning the module gives is appended to
# ret:      the object, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, warnings: *vector.Vector[Warning]) res[object.Object, Error] {
    var l:       Layout                                 = layout.of(t, ?m.types, basis.context_of(opt[*basis.Basis].some{?b.basis}));
    val address: res[type_table.Type, type_table.Error] = type_table.intern(?m.types, type_table.Shape.pointer{type_table.Pointer{space: type_table.DEFAULT_SPACE}});
    if (sel address.err) { ret res[object.Object, Error].err{Error.ir{module.Error.types{address.err}}}; }
    val bytes: res[u64, record.Error] = layout.size(?l, address.ok, type_table.DEFAULT_SPACE);
    if (sel bytes.err) { ret res[object.Object, Error].err{Error.layout{bytes.err}}; }
    val alone: res[bool, Error] = threadless(b, t);
    if (sel alone.err) { ret res[object.Object, Error].err{alone.err}; }

    val hooks:  *Hooks                    = b.basis.set.codec.stream;
    val opened: res[ptr, allocator.Error] = hooks.make(a);
    if (sel opened.err) { ret res[object.Object, Error].err{Error.alloc{opened.err}}; }
    fin { hooks.release(a, opened.ok); }
    hooks.begin(opened.ok);
    var ctx: state.Context = b.basis.context;
    ctx.stream = opened.ok;

    var c: Cache = cache.init(m, t, opt[*basis.Basis].some{?b.basis}, analysis.rows());
    fin { val dropped: err[allocator.Error] = cache.dnit(?c); }

    var u: Unit = Unit{a: a, m: m, b: b, t: t, l: ?l, cache: ?c, pointer: value.pointer(bytes.ok), bytes: bytes.ok, codec: b.basis.set.codec, ctx: ?ctx, index: vector.init[u32](a), types: vector.init[u32](a), signatures: vector.init[Signature](a), addresses: vector.init[u64](a), stack: 0, threadless: alone.ok, warnings: warnings, lines: vector.init[line.Body](a), heads: head.init(a), features: writer.no_features()};
    fin { release_unit(?u); }

    var made: Made = Made{pending: vector.init[Pending](a), segments: vector.init[opt[Id[object.Section]]](a)};
    fin {
        release_pending(?made.pending);
        vector.dnit[opt[Id[object.Section]]](?made.segments);
    }
    var mm:   wasm_object.Module = wasm_object.make(a, t.arch, ?catalog_kind.RELOCATABLE);
    val took: err[Fail]          = object.take_names(?mm.o, module.lend(m));
    if (sel took.err) {
        module.spent(m);
        wasm_object.release(?mm);
        ret res[object.Object, Error].err{Error.object{took.err}};
    }
    module.lent_to(m, ?mm.o.names);
    val entered: err[Error] = stated(?u, ?mm, ?made);
    if (sel entered.err) {
        module.take_back(m, ?mm.o);
        wasm_object.release(?mm);
        ret res[object.Object, Error].err{entered.err};
    }
    val finished: res[object.Object, Fail] = wasm_object.finish(?mm, opened.ok);
    if (sel finished.err) {
        module.spent(m);
        ret res[object.Object, Error].err{Error.object{finished.err}};
    }
    var o: object.Object = finished.ok;
    module.lent_to(m, ?o.names);
    val done: err[Error] = complete(?u, ?o, ?made);
    if (sel done.err) {
        module.take_back(m, ?o);
        val dropped: err[Fail] = object.release(?o);
        ret res[object.Object, Error].err{done.err};
    }
    module.spent(m);
    ret res[object.Object, Error].ok{o};
}
