# the line records of a module's code, stated on mink's object
#
# a module whose debug table states a source file states each change of
# source location along a function's code as a row at the offset in the body
# where the code of the instruction it was built for begins, an instruction
# with no location stated as line 0 of the first file, never as a
# neighbour's, as the register families' handover states it. every row lies
# at the start of an instruction, as tool-conventions' Dwarf.md ("code
# addresses") requires of a code address. once mink's object is made its file
# table is the module's files in table order, and each defined function's
# body is one line sequence over the text section mink's conversion makes of
# it, from the start of the body to its end.
#
# mink lowers the records as wasm's registration names: a DWARF 5 line table
# in the .debug_line custom section, as Dwarf.md embeds each DWARF section,
# its addresses offsets in the code section, which mink writes as function
# offsets its link relocates. mink lowers line records in a relocatable
# object alone, where those relocations give them their code offsets, and
# refuses a module of any other kind that holds one, so a final module states
# none.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use mink.base.fail;
use mink.base.fail.Fail;
use mink.base.intern.Name;
use mink.base.table;
use mink.base.table.Id;
use mink_line: mink.model.line;
use mink.model.object;
use mink.model.space;

use ir_debug: mirl.ir.debug;
use mirl.ir.debug.Location;
use mirl.ir.module.Module;
use mirl.target.wasm.error.Error;

# a change of source location in a function's body
# ---
# at:       the offset in the body where the code it describes begins
# location: the location, none for code with none
pub rec Row {
    at:       u64;
    location: opt[Location];
}

# the rows of one defined function's body
# ---
# rows: its rows, in ascending offset order
# size: the bytes of the body, its locals vector and its code
pub rec Body {
    rows: vector.Vector[Row];
    size: u64;
}

# give back what a body's rows hold
pub fun release(b: *Body) {
    vector.dnit[Row](?b.rows);
}

# whether a module states line records: its debug table states a source file
pub fun stated(m: *Module) bool {
    ret m.debug.files.len > 0;
}

# the location `loc` stated at offset `at` after `rows`, none when it is the
# location the rows last state. a row at the offset the last one is at
# replaces it, as no code lies between them
pub fun state(rows: *vector.Vector[Row], at: u64, loc: opt[Location]) err[allocator.Error] {
    if (rows.len > 0) {
        val last: *Row = ?rows.data[rows.len - 1];
        if (last.at == at) {
            last.location = loc;
            ret err[allocator.Error].ok{};
        }
        if (sel loc.none && sel last.location.none) { ret err[allocator.Error].ok{}; }
        if (sel loc.some) {
            val was: opt[Location] = last.location;
            if (sel was.some) {
                if (was.some.index == loc.some.index) { ret err[allocator.Error].ok{}; }
            }
        }
    }
    val pushed: res[usize, allocator.Error] = vector.push[Row](rows, Row{at: at, location: loc});
    if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
    ret err[allocator.Error].ok{};
}

fun failed(f: Fail) err[Error] {
    ret err[Error].err{Error.container{f}};
}

# the file of the object's table of a name, added when the table holds none
fun file(o: *object.Object, name: View) res[Id[mink_line.File], Fail] {
    val n: res[Id[Name], Fail] = object.name(o, name.data, name.len);
    if (sel n.err) { ret res[Id[mink_line.File], Fail].err{n.err}; }
    val held: opt[Id[mink_line.File]] = object.file_named(o, opt[Id[Name]].none{}, n.ok);
    if (sel held.some) { ret res[Id[mink_line.File], Fail].ok{held.some}; }
    ret object.add_file(o, mink_line.File{directory: opt[Id[Name]].none{}, name: n.ok, md5: opt[mink_line.Md5].none{}});
}

# the object's row of a row of a body
# a row of a body as the object's row, of line 0 of the first file where its
# location is none or names no position or file the debug table holds
fun row_of(m: *Module, files: *vector.Vector[Id[mink_line.File]], r: Row) mink_line.Row {
    var made: mink_line.Row = mink_line.Row{at: r.at, file: files.data[0], line: 0, column: 0, end_column: opt[u32].none{}, flags: 0, isa: 0, discriminator: 0};
    val loc:  opt[Location] = r.location;
    if (sel loc.none) { ret made; }
    val p: res[ir_debug.Position, ir_debug.Error] = ir_debug.position(?m.debug, loc.some);
    if (sel p.err)                           { ret made; }
    if (p.ok.file.index::usize >= files.len) { ret made; }
    made.file   = files.data[p.ok.file.index];
    made.line   = p.ok.line;
    made.column = p.ok.column;
    made.flags  = mink_line.STATEMENT;
    ret made;
}

# one body's rows as a line sequence over its section
fun sequence(m: *Module, o: *object.Object, files: *vector.Vector[Id[mink_line.File]], b: *Body, at: Id[object.Section]) err[Error] {
    if (b.rows.len == 0) { ret err[Error].ok{}; }
    val seq: res[Id[object.Sequence], Fail] = object.add_sequence(o, object.Place{section: at, offset: 0}, b.size);
    if (sel seq.err) { ret failed(seq.err); }
    var i: usize = 0;
    for (i < b.rows.len) {
        val added: res[Id[mink_line.Row], Fail] = object.add_row(o, seq.ok, row_of(m, files, b.rows.data[i]));
        if (sel added.err) { ret failed(added.err); }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# state the line records of a module's bodies on its relocatable object
# ---
# a:      the allocator the working table takes
# m:      the module
# bodies: per defined function, in definition order, the rows of its body
# o:      the object mink's conversion made of the module, whose function
#         entries with a body are the defined functions in that order
pub fun records(a: *allocator.Allocator, m: *Module, bodies: *vector.Vector[Body], o: *object.Object) err[Error] {
    if (!stated(m)) { ret err[Error].ok{}; }
    var files: vector.Vector[Id[mink_line.File]] = vector.init[Id[mink_line.File]](a);
    fin { vector.dnit[Id[mink_line.File]](?files); }
    var k: usize = 0;
    for (k < m.debug.files.len) {
        val got: res[Id[mink_line.File], Fail] = file(o, m.debug.files.data[k]);
        if (sel got.err) { ret failed(got.err); }
        val pushed: res[usize, allocator.Error] = vector.push[Id[mink_line.File]](?files, got.ok);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        k = k + 1;
    }
    var defined: usize = 0;
    var i:       usize = 0;
    for (i < table.count[object.Entry](?o.entries)) {
        val e:    *object.Entry     = table.at[object.Entry](?o.entries, table.nth[object.Entry](i));
        val body: opt[object.Place] = e.body;
        if (e.space == ?space.FUNCTIONS) {
            if (sel body.some) {
                if (defined >= bodies.len) { ret failed(fail.internal("the object holds a function body the module does not define")); }
                val done: err[Error] = sequence(m, o, ?files, ?bodies.data[defined], body.some.section);
                if (sel done.err) { ret done; }
                defined = defined + 1;
            }
        }
        i = i + 1;
    }
    if (defined != bodies.len) { ret failed(fail.internal("the object holds fewer function bodies than the module defines")); }
    ret err[Error].ok{};
}
