# the code of one function: its structured control from the region tree, and
# the selection of each instruction
#
# the regions are laid out in their tree's order. a block's instructions run
# in their own order, each that is no operand on the stack pushing its
# operands and leaving its results in their locals. a selection is an `if`
# for a two-way branch, and for a switch a block per target nested about a
# `br_table` or a chain of tests, its merge the result of the construct, so
# one block parameter of a merge is a block result: every edge into the merge
# pushes its argument and branches out, and the merge takes it off the stack
# into its parameter's local. a merge of several parameters is entered by a
# parallel copy into their locals before the branch, as a block of several
# results needs multivalue, which no build of wasm1 holds. a loop is a `loop` whose label is its
# header, inside a block whose result is its merge, about a block whose
# result is its latch when the latch is not the header. an edge to the next
# block in a sequence or into an arm writes the target's parameters' locals
# as a parallel copy, every argument pushed before any is written, and so
# does an edge back to a loop's header before its branch. no code falls off
# the end of a construct: every arm ends in a branch, so after a construct
# no edge leaves, the code is unreachable and says so.
#
# a frame of linear memory is taken from the stack pointer's global at entry
# when the function has stack slots and given back before every return, its
# base in a local. the stack pointer is 16 aligned, so a frame holding a slot
# aligned past that has its base aligned down to the slot's alignment, and the
# stack pointer at entry is kept in a local of its own to give back. an atomic
# access is an ordinary one where one thread runs, and refused where threads
# run, which reach no atomic yet.
#
# a block that ends in a return of the results of the call just before it, as
# the call leaves them, makes the call a tail call through the tail call
# proposal's `return_call` or `return_call_indirect` where the build holds
# that proposal, the function keeps no frame of linear memory and is not held
# to constant time. where the build does not hold it the call and the return
# are written as they stand, which mean the same, as the ir states no call
# that must be a tail call.
#
# where the module states source files and is written as a relocatable
# object, each change of source location along the code is a row at the
# offset its code begins at (mirl.target.wasm.line): an instruction's tree
# at its start, the instruction's own code again after the operands it
# pushes, and a terminator before the code of its edges.
#
# an inline assembly block (mirl.target.wasm.assembly) reads every operand from
# where it is held into a local of its own, so no operand of it stays on the
# stack, and pushes each result from its local once its code has run. in a
# constant-time function each of its instructions is an inline seed
# (`walk.Seed.inline`), so a secret it stores is refused, as nothing states
# what memory a block writes.
#
# a constant-time function's code is walked once written. each memory
# instruction a load, a store or an atomic access is written in whose metadata
# states its secrecy, secret with its secret mark or public with the public
# flag, seeds the walk with that secrecy at its offset (`walk.Seed.access`), by
# its one access, the first of its footprint, as on a machine target. a load or
# store of a frame slot is placed in the frame off the frame base local
# (`placement`, a within seed of origin `walk.Origin.base`), and each slot is
# stated private, or one object with its public bytes typed, as on a machine
# target (`frame_seeds`).
#
# each call in such a function is walked through a model of its callee
# (`mirl.machine.emit.timed`, `stream_model`), its extents off the local that
# holds the base of the frame, the decisions those of every other target. each
# result of a call the ir declares secret seeds the walk at the call
# (`walk.Seed.after`), as a load's does through its access, since nothing the
# walk reads there need hold the secret.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc_ct: masc.core.ct;
use masc.core.field;
use masc_operand:   masc.core.operand;
use core_state:     masc.core.state;
use masc_inline:    masc.inline;
use wasm_fixup:     masc.isa.wasm.fixup;
use wasm_extension: masc.isa.wasm.gen_extension;
use masc.isa.wasm.gen_row_index;
use wasm_kind:   masc.isa.wasm.kind;
use wasm_stream: masc.isa.wasm.stream;
use masc.walk;

use mirl.ct;
use secret_globals: mirl.ct.global;
use ia:             mirl.ir.assembly;
use mirl.ir.cfg.graph.NONE;
use mirl.ir.constant.ConstantData;
use mirl.ir.debug.record.Location;
use ir_function: mirl.ir.function;
use mirl.ir.function.Body;
use mirl.ir.function.in_constant_time;
use mirl.ir.global.Range;
use mirl.ir.id.Constant;
use mirl.ir.id.Declared;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.NO_INSTRUCTION;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.Edge;
use mirl.ir.instruction.InstructionData;
use Spot: mirl.ir.instruction.Place;
use mirl.ir.metadata;
use mirl.ir.module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.table;
use mirl.ir.place.Place;
use mirl.ir.place.Placed;
use type_table: mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use timing: mirl.machine.emit.timed;
use mirl.pass.analysis;
use mirl.pass.analysis.live.Liveness;
use slots_of: mirl.pass.analysis.slots;
use mirl.pass.refusal;
use mirl.structure.region;
use mirl.structure.region.Region;
use mirl.structure.region.Structure;
use mirl.target.head;
use mirl.target.layout;
use mirl.target.record;
use mirl.target.warning.Warning;
use mirl.target.wasm.assembly;
use wasm_error: mirl.target.wasm.error;
use mirl.target.wasm.error.Assembly;
use mirl.target.wasm.error.At;
use mirl.target.wasm.error.Encoding;
use mirl.target.wasm.error.Error;
use mirl.target.wasm.line;
use mirl.target.wasm.local;
use mirl.target.wasm.local.Locals;
use mirl.target.wasm.operand;
use mirl.target.wasm.relocation;
use mirl.target.wasm.select;
use mirl.target.wasm.signature.Signature;
use mirl.target.wasm.unit.Unit;
use mirl.target.wasm.value;
use mirl.target.wasm.writer;
use mirl.target.wasm.writer.Writer;

# the empty name, as nothing the code defines is named
val NO_NAME: View = View{data: nil, len: 0};

# one open block, loop or if of the code
# ---
# block:    the ir block a branch to it reaches, NONE for one none reaches by
#           its label alone
# carries:  a branch to it carries its block's parameters, as a merge's
# branched: some branch reaches it
pub rec Frame {
    block:    u32;
    carries:  bool;
    branched: bool;
}

# a call in a constant-time function's code
# ---
# at:     where the call instruction starts
# callee: the declaration it trusts its callee to keep: the function it names, or the declaration a call through the
#         table states (`Metadata.stated`), none for one stating none
# call:   the instruction it is written for
pub rec Site {
    at:     u64;
    callee: opt[Declared];
    call:   Instruction;
}

# what the code of one function is emitted with
# ---
# opened: where the code of the instruction being selected begins, the pushes of its operands included
pub rec Emitter {
    u:      *Unit;
    f:      Function;
    b:      *Body;
    s:      *Structure;
    l:      *Locals;
    w:      *Writer;
    frames: vector.Vector[Frame];
    slots:  vector.Vector[u64];
    frame:  u64;
    base:   u32;
    entry:  u32;
    stated: vector.Vector[walk.Seed];
    points: vector.Vector[walk.Declassify];
    opened: usize;
    sites:  vector.Vector[Site];
    rows:   vector.Vector[line.Row];
    tail:   u32;
    failed: opt[Error];
}

# keep `why` as the emitter's failure unless one is already kept
fun fail(e: *Emitter, why: Error) {
    val first: bool = sel e.failed.none;
    if (first) { e.failed = opt[Error].some{why}; }
}

fun lost(e: *Emitter, why: allocator.Error) {
    fail(e, Error.alloc{why});
}

# instruction `i` of the function, with its source location
fun at_instruction(e: *Emitter, i: Instruction) At {
    ret At{function: e.f, instruction: i, location: ir_function.location(e.b, i)};
}

fun unselected(e: *Emitter, i: Instruction) {
    fail(e, Error.unselected{at_instruction(e, i)});
}

fun invariant(e: *Emitter, i: Instruction) {
    fail(e, Error.invariant{at_instruction(e, i)});
}

# the source location of instruction `i` stated at the code written next,
# where the module states line records
fun here(e: *Emitter, i: Instruction) {
    if (!line.stated(e.u.m)) { ret; }
    val err_stated: err[allocator.Error] = line.state(?e.rows, e.w.out.len::u64, e.b.instructions.data[i].metadata.location);
    if (sel err_stated.err) { lost(e, err_stated.err); }
}

fun unstructured(e: *Emitter) {
    fail(e, Error.unstructured{e.f});
}

fun ok(e: *Emitter) bool {
    ret sel e.failed.none;
}

# the value type of a value
fun code_of(e: *Emitter, v: Value) u32 {
    val opt_types_of: opt[u32] = value.of(?e.u.m.types, e.b.values.data[v].type, e.u.pointer);
    if (sel opt_types_of.none) {
        fail(e, Error.unvalued{e.b.values.data[v].type});
        ret value.I32;
    }
    ret opt_types_of.some;
}

fun class_of(e: *Emitter, v: Value) u32 {
    ret value.class(code_of(e, v));
}

fun width_of(e: *Emitter, v: Value) u32 {
    ret value.width(?e.u.m.types, e.b.values.data[v].type);
}

# whether the address type is i64, as on wasm64
fun wide(e: *Emitter) bool {
    ret e.u.pointer == value.I64;
}

# a constant of the address type
fun address(e: *Emitter, n: u64) {
    if (wide(e)) { writer.i64(e.w, n:~i64); }
    or           { writer.i32(e.w, n:~i64); }
}

# a constant of the address type naming a symbol
fun symbol_address(e: *Emitter, v: masc_operand.Value) {
    if (wide(e)) { writer.one(e.w, gen_row_index.I64CONST, v); }
    or           { writer.one(e.w, gen_row_index.I32CONST, v); }
}

# the address of a function: its symbol's table index
fun function_address(e: *Emitter, f: Function) {
    symbol_address(e, relocation.symbolic(relocation.function_symbol(e.u, f), 0, wasm_fixup.TABLE_INDEX_SLEB));
}

# the address of a global at an offset: its symbol's
fun global_address(e: *Emitter, g: Global, offset: i64) {
    symbol_address(e, relocation.symbolic(relocation.global_symbol(e.u, g), offset, masc_operand.NO_FIXUP));
}

# an operation of the address type: row `narrow` at i32, row `broad` at i64
fun pointer_op(e: *Emitter, narrow: u32, broad: u32) {
    if (wide(e)) { writer.plain(e.w, broad); }
    or           { writer.plain(e.w, narrow); }
}

# clear the bits of an i32 above a width below 32, which a narrow value holds zero
fun mask(e: *Emitter, width: u32) {
    if (width == 0 || width >= 32) { ret; }
    writer.i32(e.w, ((1::u64 << width::u64) - 1)::i64);
    writer.plain(e.w, gen_row_index.I32AND);
}

# sign extend an i32 holding a narrow value of a width below 32 to all 32 bits
fun sign(e: *Emitter, width: u32) {
    if (width == 0 || width >= 32) { ret; }
    val shift: i64 = (32 - width)::i64;
    writer.i32(e.w, shift);
    writer.plain(e.w, gen_row_index.I32SHL);
    writer.i32(e.w, shift);
    writer.plain(e.w, gen_row_index.I32SHRS);
}

# push a constant
fun constant(e: *Emitter, v: Value, c: Constant) {
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, c);
    if (sel res_constant_data.err) {
        fail(e, Error.ir{res_constant_data.err});
        ret;
    }
    val data: ConstantData = res_constant_data.ok;
    val code: u32          = code_of(e, v);
    if (code == value.V128) {
        vector_constant(e, v, data);
        ret;
    }
    if (sel data.integer || sel data.float) {
        var bits: u64 = 0;
        if (sel data.integer) {
            if (data.integer.words.size > 0) { bits = data.integer.words.data[0]; }
        }
        if (sel data.float) {
            if (data.float.words.size > 0) { bits = data.float.words.data[0]; }
        }
        if (code == value.I32) { writer.i32(e.w, bits:~i64); }
        or (code == value.I64) { writer.i64(e.w, bits:~i64); }
        or (code == value.F32) { writer.immediate(e.w, gen_row_index.F32CONST, (bits & 0xFFFF_FFFF):~i64); }
        or                     { writer.immediate(e.w, gen_row_index.F64CONST, bits:~i64); }
        ret;
    }
    if (sel data.zero) {
        if (code == value.I32) { writer.i32(e.w, 0); }
        or (code == value.I64) { writer.i64(e.w, 0); }
        or (code == value.F32) { writer.immediate(e.w, gen_row_index.F32CONST, 0); }
        or                     { writer.immediate(e.w, gen_row_index.F64CONST, 0); }
        ret;
    }
    if (sel data.address) {
        val s: Symbol = data.address.symbol;
        if (sel s.function) {
            if (data.address.offset != 0) {
                fail(e, Error.offset{s.function});
                ret;
            }
            function_address(e, s.function);
            ret;
        }
        global_address(e, s.global, data.address.offset);
        ret;
    }
    fail(e, Error.unvalued{e.b.values.data[v].type});
}

# push a v128 constant, its lanes laid out little endian, lane 0 lowest
fun vector_constant(e: *Emitter, v: Value, data: ConstantData) {
    var bytes: [16]u8;
    var k:     usize = 0;
    for (k < 16) {
        bytes[k] = 0;
        k        = k + 1;
    }
    if (sel data.aggregate) {
        val lanes: Slice[Constant] = data.aggregate.elements;
        if (lanes.size == 0) {
            fail(e, Error.unvalued{e.b.values.data[v].type});
            ret;
        }
        val size: usize = 16 / lanes.size;
        var n:    usize = 0;
        for (n < lanes.size) {
            val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, lanes.data[n]);
            if (sel res_constant_data.err) {
                fail(e, Error.ir{res_constant_data.err});
                ret;
            }
            var bits: u64 = 0;
            if (sel res_constant_data.ok.integer) {
                if (res_constant_data.ok.integer.words.size > 0) { bits = res_constant_data.ok.integer.words.data[0]; }
            }
            or (sel res_constant_data.ok.float) {
                if (res_constant_data.ok.float.words.size > 0) { bits = res_constant_data.ok.float.words.data[0]; }
            }
            or (!(sel res_constant_data.ok.zero)) {
                fail(e, Error.unvalued{e.b.values.data[v].type});
                ret;
            }
            var b: usize = 0;
            for (b < size) {
                bytes[n * size + b] = ((bits >> (8 * b)::u64) & 0xFF)::u8;
                b                   = b + 1;
            }
            n = n + 1;
        }
    }
    or (!(sel data.zero)) {
        fail(e, Error.unvalued{e.b.values.data[v].type});
        ret;
    }
    writer.one(e.w, gen_row_index.V128CONST, masc_operand.Value.literal{masc_operand.Bytes{at: ?bytes[0], len: 16}});
}

# push a value: its tree when it stays on the stack, else its constant or its local
fun push(e: *Emitter, v: Value) {
    if (!ok(e)) { ret; }
    if (e.l.stacked.data[v]) {
        val d: Def = e.b.values.data[v].def;
        if (sel d.result) { tree(e, d.result.instruction); }
        ret;
    }
    val d: Def = e.b.values.data[v].def;
    if (sel d.constant) {
        constant(e, v, d.constant);
        ret;
    }
    val home: u32 = e.l.home.data[v];
    if (home == local.NONE) {
        fail(e, Error.encoding{Encoding{function: e.f, message: "a value is read that no local holds"}});
        ret;
    }
    writer.index(e.w, gen_row_index.LOCALGET, home);
}

# an instruction and the operands it pushes before it, each at its own
# source location, the instruction's stated again before its own code
fun tree(e: *Emitter, i: Instruction) {
    here(e, i);
    val start:  usize            = e.w.out.len;
    val d:      *InstructionData = ?e.b.instructions.data[i];
    var first:  u32              = 0;
    var column: opt[u32]         = opt[u32].none{};
    if (d.operands.len > 0) {
        first  = width_of(e, d.operands.data[0]);
        column = lane_column(e, e.b.values.data[d.operands.data[0]].type);
    }
    if (!operand.rereads(e.u.m, d, first, column)) {
        var pushes: vector.Vector[usize] = vector.init[usize](e.u.a);
        fin { vector.dnit[usize](?pushes); }
        val res_ordered: res[bool, allocator.Error] = operand.order(e.u.m, e.b, d, ?pushes);
        if (sel res_ordered.err) {
            lost(e, res_ordered.err);
            ret;
        }
        if (!res_ordered.ok) {
            invariant(e, i);
            ret;
        }
        var k: usize = 0;
        for (k < pushes.len) {
            push(e, d.operands.data[pushes.data[k]]);
            k = k + 1;
        }
        if (pushes.len > 0) { here(e, i); }
    }
    if (!ok(e)) { ret; }
    e.opened = start;
    instruction(e, i, d);
}

# an instruction that stays on no stack: its tree, then its results into their locals
fun root(e: *Emitter, i: Instruction) {
    tree(e, i);
    if (!ok(e)) { ret; }
    val d: *InstructionData = ?e.b.instructions.data[i];
    if (d.results.len == 0) { ret; }
    var order: vector.Vector[usize] = vector.init[usize](e.u.a);
    fin { vector.dnit[usize](?order); }
    val res_result_order: res[bool, allocator.Error] = operand.result_order(d, ?order);
    if (sel res_result_order.err) {
        lost(e, res_result_order.err);
        ret;
    }
    var k: usize = order.len;
    for (k > 0) {
        k = k - 1;
        val r:    Value = d.results.data[order.data[k]];
        val home: u32   = e.l.home.data[r];
        if (home != local.NONE) { writer.index(e.w, gen_row_index.LOCALSET, home); }
        or                      { writer.plain(e.w, gen_row_index.DROP); }
    }
}

# the instructions of a block before its terminator, but for a call its
# return is made as
fun body(e: *Emitter, k: u32) {
    val last: Instruction = e.b.blocks.data[k].last;
    if (last == NO_INSTRUCTION) {
        unstructured(e);
        ret;
    }
    e.tail = tail_of(e, k);
    var i: Instruction = e.b.blocks.data[k].first;
    for (i != last && ok(e)) {
        val r:     *InstructionData = ?e.b.instructions.data[i];
        var stays: bool             = i == e.tail;
        if (r.results.len == 1) { stays = stays || e.l.stacked.data[r.results.data[0]]; }
        if (!stays)             { root(e, i); }
        i = e.b.instructions.data[i].next;
    }
}

# whether the results of `call`, a placed call, are the operands of `back`,
# a placed return, each placed at the operand the call leaves it at, and
# every argument of the call travels as an operand, none in the argument area
fun returned(call: *InstructionData, back: *InstructionData) bool {
    if (back.operands.len != call.results.len) { ret false; }
    val given:  *Placed = operand.places(call);
    val placed: *Placed = operand.places(back);
    if (given == nil || placed == nil) { ret false; }
    val args: usize = call.operands.len - 1;
    var j:    usize = 0;
    for (j < args) {
        val p: Place = given[j].place;
        if (!(sel p.operand)) { ret false; }
        j = j + 1;
    }
    j = 0;
    for (j < back.operands.len) {
        if (back.operands.data[j] != call.results.data[j])        { ret false; }
        if (operand.at(given[args + j]) != operand.at(placed[j])) { ret false; }
        j = j + 1;
    }
    ret true;
}

# whether the results a placed call leaves are of the function's own result
# types, in order, as a tail call's must be
fun same_results(e: *Emitter, call: *InstructionData) bool {
    val own:        *vector.Vector[u32] = ?e.u.signatures.data[e.f].results;
    val opt_callee: opt[Function]       = operand.direct(e.u.m, e.b, call.operands.data[0]);
    if (sel opt_callee.some) {
        val theirs: *vector.Vector[u32] = ?e.u.signatures.data[opt_callee.some].results;
        if (theirs.len != own.len) { ret false; }
        var j: usize = 0;
        for (j < own.len) {
            if (theirs.data[j] != own.data[j]) { ret false; }
            j = j + 1;
        }
        ret true;
    }
    var order: vector.Vector[usize] = vector.init[usize](e.u.a);
    fin { vector.dnit[usize](?order); }
    val res_result_order: res[bool, allocator.Error] = operand.result_order(call, ?order);
    if (sel res_result_order.err) {
        lost(e, res_result_order.err);
        ret false;
    }
    if (!res_result_order.ok || order.len != own.len) { ret false; }
    var j: usize = 0;
    for (j < order.len) {
        if (code_of(e, call.results.data[order.data[j]]) != own.data[j]) { ret false; }
        j = j + 1;
    }
    ret true;
}

# the call block `k`'s return is made as, a tail call, NONE for none: the
# call just before a placed return of its results as it leaves them, made
# through the tail call proposal's `return_call` or `return_call_indirect`
# where the build holds that proposal. the basic convention's tail rule
# (mirl.target.wasm.abi) admits a call that passes nothing in the argument
# area, and the function must have no frame of linear memory, whose slots a
# callee may be handed the address of and which a return gives back before
# it leaves. the callee's results must be the function's own, as the
# proposal types a tail call, and a function held to constant time makes
# none, as the walk of its code follows no call
fun tail_of(e: *Emitter, k: u32) u32 {
    if (!core_state.holds(e.u.ctx, wasm_extension.TAIL_CALL))           { ret NONE; }
    if (e.base != local.NONE)                                           { ret NONE; }
    if (in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret NONE; }
    val last: Instruction = e.b.blocks.data[k].last;
    if (last == NO_INSTRUCTION)                             { ret NONE; }
    if (e.b.instructions.data[last].prev == NO_INSTRUCTION) { ret NONE; }
    val back: *InstructionData = ?e.b.instructions.data[last];
    if (back.opcode != table.RET_PLACED) { ret NONE; }
    val at:   Instruction      = back.prev;
    val call: *InstructionData = ?e.b.instructions.data[at];
    if (call.opcode != table.CALL_PLACED)                { ret NONE; }
    if (!returned(call, back) || !same_results(e, call)) { ret NONE; }
    ret at;
}

fun terminator(e: *Emitter, k: u32) *InstructionData {
    ret ?e.b.instructions.data[e.b.blocks.data[k].last];
}

fun terminator_id(e: *Emitter, k: u32) Instruction {
    ret e.b.blocks.data[k].last;
}

# the index of a function type, the stream's first of it or a new one
fun typed(e: *Emitter, params: *u32, np: u32, results: *u32, nr: u32) u32 {
    val opt_found: opt[u32] = wasm_stream.find_type(e.u.ctx.stream, params, np, results, nr);
    if (sel opt_found.some) { ret opt_found.some; }
    val res_made: res[u32, str] = wasm_stream.add_type(e.u.ctx.stream, params, np, results, nr, NO_NAME);
    if (sel res_made.err) {
        fail(e, Error.encoding{Encoding{function: e.f, message: res_made.err}});
        ret 0;
    }
    ret res_made.ok;
}

# open a block, loop or if of no result
fun frame_begin(e: *Emitter, row: u32, frame: Frame) {
    writer.begin(e.w, row);
    val res_pushed: res[usize, allocator.Error] = vector.push[Frame](?e.frames, frame);
    if (sel res_pushed.err) { lost(e, res_pushed.err); }
}

# open a block or if a merge, NONE for none, follows: its one parameter its
# result, and several its edges' to write
fun merge_frame_begin(e: *Emitter, row: u32, merge: u32) {
    var count: usize = 0;
    if (merge != NONE) { count = e.b.blocks.data[merge].parameters.len; }
    if (count != 1) {
        frame_begin(e, row, Frame{block: merge, carries: false, branched: false});
        ret;
    }
    writer.begin_valued(e.w, row, code_of(e, e.b.blocks.data[merge].parameters.data[0]));
    val res_pushed: res[usize, allocator.Error] = vector.push[Frame](?e.frames, Frame{block: merge, carries: true, branched: false});
    if (sel res_pushed.err) { lost(e, res_pushed.err); }
}

# close the innermost frame, its block's parameters taken off the stack when it carries them
fun frame_end(e: *Emitter) {
    if (e.frames.len == 0) {
        unstructured(e);
        ret;
    }
    val f: Frame = e.frames.data[e.frames.len - 1];
    vector.truncate[Frame](?e.frames, e.frames.len - 1);
    writer.plain(e.w, gen_row_index.END);
    if (!f.branched) {
        writer.plain(e.w, gen_row_index.UNREACHABLE);
        ret;
    }
    if (f.carries && f.block != NONE) { take(e, f.block); }
}

# a merge's parameters off the stack, the last first
fun take(e: *Emitter, k: u32) {
    val params: *vector.Vector[Value] = ?e.b.blocks.data[k].parameters;
    var j:      usize                 = params.len;
    for (j > 0) {
        j = j - 1;
        val home: u32 = e.l.home.data[params.data[j]];
        if (home != local.NONE) { writer.index(e.w, gen_row_index.LOCALSET, home); }
        or                      { writer.plain(e.w, gen_row_index.DROP); }
    }
}

# an edge's arguments into its target's parameters' locals, as one parallel copy
fun deliver(e: *Emitter, edge: *Edge) {
    val params: *vector.Vector[Value] = ?e.b.blocks.data[edge.block].parameters;
    if (params.len != edge.arguments.len) {
        unstructured(e);
        ret;
    }
    var j: usize = 0;
    for (j < params.len) {
        if (copied(e, params.data[j], edge.arguments.data[j])) { push(e, edge.arguments.data[j]); }
        j = j + 1;
    }
    j = params.len;
    for (j > 0) {
        j = j - 1;
        if (copied(e, params.data[j], edge.arguments.data[j])) { writer.index(e.w, gen_row_index.LOCALSET, e.l.home.data[params.data[j]]); }
    }
}

# whether an edge writes parameter `param` from argument `arg`: a local holds
# the parameter and the argument is another value
fun copied(e: *Emitter, param: Value, arg: Value) bool {
    ret e.l.home.data[param] != local.NONE && param != arg;
}

# the depth of the innermost frame a branch to a block reaches, NONE for none
fun depth(e: *Emitter, k: u32) u32 {
    var i: usize = e.frames.len;
    for (i > 0) {
        i = i - 1;
        if (e.frames.data[i].block == k) { ret (e.frames.len - 1 - i)::u32; }
    }
    ret NONE;
}

# an edge out through a frame: a merge's carries its arguments, a header's
# takes them in its locals first
fun branch(e: *Emitter, edge: *Edge) {
    val d: u32 = depth(e, edge.block);
    if (d == NONE) {
        unstructured(e);
        ret;
    }
    val at: usize = e.frames.len - 1 - d::usize;
    if (e.frames.data[at].carries) {
        var j: usize = 0;
        for (j < edge.arguments.len) {
            push(e, edge.arguments.data[j]);
            j = j + 1;
        }
    }
    or { deliver(e, edge); }
    e.frames.data[at].branched = true;
    writer.index(e.w, gen_row_index.BR, d);
}

# the first block a region's code runs
fun first(e: *Emitter, r: u32) u32 {
    if (r == NONE) { ret NONE; }
    val g: Region      = region.region(e.s, r);
    val k: region.Kind = g.kind;
    if (sel k.sequence) { ret first(e, g.child); }
    ret g.block;
}

# a sequence's regions in order
fun sequence(e: *Emitter, r: u32) {
    var c: u32 = region.region(e.s, r).child;
    for (c != NONE && ok(e)) {
        val next: u32 = region.region(e.s, c).next;
        emit(e, c, next);
        c = next;
    }
}

# one region, the region after it among its parent's children `next`
fun emit(e: *Emitter, r: u32, next: u32) {
    val g: Region      = region.region(e.s, r);
    val k: region.Kind = g.kind;
    if (sel k.sequence)  { sequence(e, r); }
    or (sel k.selection) { selection(e, r); }
    or (sel k.loop)      { looped(e, r); }
    or {
        body(e, g.block);
        if (ok(e)) { ending(e, g.block, next); }
    }
}

# a block's terminator, its successor the next region's first block or one a
# frame reaches, a return made as the call before it where that call is its
# tail call
fun ending(e: *Emitter, k: u32, next: u32) {
    val i:    Instruction      = terminator_id(e, k);
    val d:    *InstructionData = terminator(e, k);
    val code: u32              = d.opcode;
    here(e, i);
    if (code == table.RET_PLACED && e.tail != NONE) {
        tree(e, e.tail);
        ret;
    }
    if (code == table.BR) {
        val edge: *Edge = ?d.edges.data[0];
        if (next != NONE && first(e, next) == edge.block) { deliver(e, edge); }
        or                                                { branch(e, edge); }
        ret;
    }
    if (code == table.RET_PLACED || code == table.UNREACHABLE) {
        tree(e, i);
        ret;
    }
    unstructured(e);
}

# an arm of a selection: the edge into it, and its sequence when it has one
fun arm(e: *Emitter, r: u32, edge: *Edge) {
    if (r == NONE || region.region(e.s, r).child == NONE) {
        branch(e, edge);
        ret;
    }
    if (first(e, r) != edge.block) {
        unstructured(e);
        ret;
    }
    deliver(e, edge);
    sequence(e, r);
}

fun plain_frame() Frame {
    ret Frame{block: NONE, carries: false, branched: false};
}

# a selection: its header, then its arms by its terminator's targets
fun selection(e: *Emitter, r: u32) {
    val g: Region = region.region(e.s, r);
    body(e, g.block);
    if (!ok(e)) { ret; }
    val d:    *InstructionData = terminator(e, g.block);
    val code: u32              = d.opcode;
    here(e, terminator_id(e, g.block));
    var arms: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin { vector.dnit[u32](?arms); }
    var c: u32 = g.child;
    for (c != NONE) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?arms, c);
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        c = region.region(e.s, c).next;
    }
    if (arms.len != d.edges.len) {
        unstructured(e);
        ret;
    }
    if (code == table.CBR) {
        push(e, d.operands.data[0]);
        merge_frame_begin(e, gen_row_index.IF, g.merge);
        arm(e, arms.data[0], ?d.edges.data[0]);
        writer.plain(e.w, gen_row_index.ELSE);
        arm(e, arms.data[1], ?d.edges.data[1]);
        frame_end(e);
        ret;
    }
    if (code == table.BR) {
        merge_frame_begin(e, gen_row_index.BLOCK, g.merge);
        arm(e, arms.data[0], ?d.edges.data[0]);
        frame_end(e);
        ret;
    }
    if (code == table.SWITCH) {
        switched(e, terminator_id(e, g.block), d, g.merge, ?arms);
        ret;
    }
    unstructured(e);
}

# a switch: one block per target about its dispatch, each closed before its arm
fun switched(e: *Emitter, i: Instruction, d: *InstructionData, merge: u32, arms: *vector.Vector[u32]) {
    val n: usize = d.edges.len;
    if (merge != NONE) { merge_frame_begin(e, gen_row_index.BLOCK, merge); }
    var k: usize = 0;
    for (k < n) {
        frame_begin(e, gen_row_index.BLOCK, plain_frame());
        k = k + 1;
    }
    if (!ok(e)) { ret; }
    val base: usize     = e.frames.len - n;
    val imm:  Immediate = d.immediates.data[0];
    if (!(sel imm.cases)) {
        invariant(e, i);
        ret;
    }
    val cases: Slice[u64] = imm.cases;
    if (cases.size + 1 != n) {
        invariant(e, i);
        ret;
    }
    val selector: Value = d.operands.data[0];
    val width:    u32   = width_of(e, selector);
    val wide64:   bool  = class_of(e, selector) == select.I64;
    # arm t's block is t from the innermost, where the dispatch stands
    k = 0;
    for (k < n) {
        e.frames.data[base + n - 1 - k].branched = true;
        k                                        = k + 1;
    }
    if (operand.dense(e.u.m, d, width) && !wide64) {
        val low:  u64 = cases.data[0];
        val high: u64 = cases.data[cases.size - 1];
        push(e, selector);
        if (low != 0) {
            writer.i32(e.w, low:~i64);
            writer.plain(e.w, gen_row_index.I32SUB);
        }
        var depths: vector.Vector[u32] = vector.init[u32](e.u.a);
        fin { vector.dnit[u32](?depths); }
        var x: u64   = low;
        var c: usize = 0;
        for (x <= high) {
            var t: u32 = 0;
            if (c < cases.size && cases.data[c] == x) {
                t = (c + 1)::u32;
                c = c + 1;
            }
            val res_pushed: res[usize, allocator.Error] = vector.push[u32](?depths, t);
            if (sel res_pushed.err) {
                lost(e, res_pushed.err);
                ret;
            }
            x = x + 1;
        }
        val res_fallback: res[usize, allocator.Error] = vector.push[u32](?depths, 0);
        if (sel res_fallback.err) {
            lost(e, res_fallback.err);
            ret;
        }
        writer.table(e.w, e.u.a, ?depths);
    }
    or {
        var c: usize = 0;
        for (c < cases.size) {
            push(e, selector);
            if (wide64) {
                writer.i64(e.w, cases.data[c]:~i64);
                writer.plain(e.w, gen_row_index.I64EQ);
            }
            or {
                writer.i32(e.w, cases.data[c]:~i64);
                writer.plain(e.w, gen_row_index.I32EQ);
            }
            writer.index(e.w, gen_row_index.BRIF, (c + 1)::u32);
            c = c + 1;
        }
        writer.index(e.w, gen_row_index.BR, 0);
    }
    k = 0;
    for (k < n && ok(e)) {
        frame_end(e);
        arm(e, arms.data[k], ?d.edges.data[k]);
        k = k + 1;
    }
    if (merge != NONE) { frame_end(e); }
}

# a loop: its merge's block about its header's loop, about its latch's block
fun looped(e: *Emitter, r: u32) {
    val g:    Region = region.region(e.s, r);
    val body: u32    = g.child;
    if (body == NONE) {
        unstructured(e);
        ret;
    }
    val rest: u32 = region.region(e.s, body).next;
    if (g.merge != NONE) { merge_frame_begin(e, gen_row_index.BLOCK, g.merge); }
    frame_begin(e, gen_row_index.LOOP, Frame{block: g.block, carries: false, branched: false});
    val latched: bool = g.latch != NONE && g.latch != g.block && rest != NONE;
    if (latched) { merge_frame_begin(e, gen_row_index.BLOCK, g.latch); }
    sequence(e, body);
    if (latched && ok(e)) {
        frame_end(e);
        sequence(e, rest);
    }
    if (!ok(e)) { ret; }
    # a branch to a loop's label runs it again, so its end is never reached
    e.frames.data[e.frames.len - 1].branched = false;
    frame_end(e);
    if (g.merge != NONE) { frame_end(e); }
}

# the address of a stack slot
fun slot(e: *Emitter, i: Instruction) {
    writer.index(e.w, gen_row_index.LOCALGET, e.base);
    val at: u64 = e.slots.data[i];
    if (at != 0) {
        address(e, at);
        pointer_op(e, gen_row_index.I32ADD, gen_row_index.I64ADD);
    }
}

# the stack pointer given back before a return
fun unwind(e: *Emitter) {
    if (e.base == local.NONE) { ret; }
    if (e.entry != local.NONE) {
        writer.index(e.w, gen_row_index.LOCALGET, e.entry);
        writer.one(e.w, gen_row_index.GLOBALSET, relocation.stack(e.u));
        ret;
    }
    writer.index(e.w, gen_row_index.LOCALGET, e.base);
    address(e, e.frame);
    pointer_op(e, gen_row_index.I32ADD, gen_row_index.I64ADD);
    writer.one(e.w, gen_row_index.GLOBALSET, relocation.stack(e.u));
}

# the access seed of the memory instruction written next for instruction `d`, for a constant-time function where `d`
# states its access: secret with its secret mark, public with the public flag. its access is the first of its
# footprint, as a wasm load or store makes one
fun state(e: *Emitter, d: *InstructionData) {
    if (!in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret; }
    val opt_row: opt[*opcode_row.Row] = table.at(d.opcode);
    if (sel opt_row.none)                                                                  { ret; }
    if (!opcode_row.states_access(opt_row.some) && !opcode_row.states_write(opt_row.some)) { ret; }
    if (!d.metadata.secret && !d.metadata.flags.public)                                    { ret; }
    val seed:       walk.Seed                   = walk.Seed.access{walk.Access{at: e.w.out.len::u64, access: walk.Accessor.index{0}, secret: d.metadata.secret}};
    val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?e.stated, seed);
    if (sel res_pushed.err) { lost(e, res_pushed.err); }
}

# the frame base of `e`'s function, the origin of each frame statement of its walk
fun frame_origin(e: *Emitter) walk.Origin {
    ret walk.Origin.base{walk.Entry{space: wasm_kind.LOCALS, index: e.base}};
}

# the local holding the frame's base of `e`'s function, none for a function of no frame
fun frame_entry(e: *Emitter) opt[walk.Entry] {
    if (e.base == local.NONE) { ret opt[walk.Entry].none{}; }
    ret opt[walk.Entry].some{walk.Entry{space: wasm_kind.LOCALS, index: e.base}};
}

# where a load or store `d` of `bytes` through address `at` of `e`'s function lies, from the frame base local: exactly
# at its bytes where `at` is the address of a frame slot moved only by constants and the access lies within the slot,
# else within the range of the slot `d` states (`metadata.Extent`), as each access of a loop the bulk legalisation
# makes of a copy or fill states the range it moves, which an index moves the address over. the first holds by
# construction: `slot` writes a slot's address as the frame base local plus the slot's offset, a move by a constant
# adds the constant, the memory instruction adds no offset of its own, and nothing writes the frame base local after
# the frame code takes the frame, as no other code of the emitter names it and an inline block names no local but its
# operands' own (`assembly`). the second is the legalisation's statement, as a machine target's within seed is. none
# for an address formed any other way, as by an index known only when the code runs
fun placement(e: *Emitter, d: *InstructionData, at: Value, bytes: u64) opt[walk.Within] {
    if (e.base == local.NONE || bytes == 0) { ret opt[walk.Within].none{}; }
    val opt_slot: opt[Instruction] = slots_of.slot_of(e.b, at);
    if (sel opt_slot.none) { ret opt[walk.Within].none{}; }
    val slot: Instruction = opt_slot.some;
    if (!(sel e.b.instructions.data[slot].place.placed)) { ret opt[walk.Within].none{}; }
    val opt_size: opt[u64] = slots_of.slot_size(e.u.l, e.b, slot);
    if (sel opt_size.none) { ret opt[walk.Within].none{}; }
    var where:         walk.Within           = walk.Within{at: e.w.out.len::u64, access: walk.Accessor.index{0}, offset: 0, length: bytes, origin: frame_origin(e)};
    val opt_addressed: opt[timing.Addressed] = addressed(e, at);
    if (sel opt_addressed.some) {
        if (bytes <= opt_addressed.some.room) {
            where.offset = opt_addressed.some.offset;
            ret opt[walk.Within].some{where};
        }
    }
    val x: metadata.Extent = d.metadata.extent;
    if (x.length < bytes || x.offset + x.length < x.offset || x.offset + x.length > opt_size.some) { ret opt[walk.Within].none{}; }
    where.offset = (e.slots.data[slot] + x.offset)::i64;
    where.length = x.length;
    ret opt[walk.Within].some{where};
}

# the frame slot address `v` of `e`'s function addresses, off the frame base local: where `v` is the address of a slot
# moved only by constants, the slot's offset plus theirs and the bytes from there to the slot's end. it holds by
# construction as `placement` says, for a call's operand as for a load's or store's address. none for an address
# formed any other way
fun addressed(e: *Emitter, v: Value) opt[timing.Addressed] {
    if (e.base == local.NONE) { ret opt[timing.Addressed].none{}; }
    val opt_slot: opt[Instruction] = slots_of.slot_of(e.b, v);
    if (sel opt_slot.none) { ret opt[timing.Addressed].none{}; }
    val slot: Instruction = opt_slot.some;
    if (!(sel e.b.instructions.data[slot].place.placed)) { ret opt[timing.Addressed].none{}; }
    val opt_size: opt[u64] = slots_of.slot_size(e.u.l, e.b, slot);
    if (sel opt_size.none) { ret opt[timing.Addressed].none{}; }
    val opt_offset: opt[u64] = slots_of.offset_in(e.u.m, e.u.l, e.b, v);
    if (sel opt_offset.none)             { ret opt[timing.Addressed].none{}; }
    if (opt_offset.some > opt_size.some) { ret opt[timing.Addressed].none{}; }
    ret opt[timing.Addressed].some{timing.Addressed{offset: (e.slots.data[slot] + opt_offset.some)::i64, room: opt_size.some - opt_offset.some}};
}

# the within seed of the load or store `d` of `bytes` written next through address `at`, for a constant-time function,
# where `placement` places it
fun placed(e: *Emitter, d: *InstructionData, at: Value, bytes: u64) {
    if (!in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret; }
    val opt_where: opt[walk.Within] = placement(e, d, at, bytes);
    if (sel opt_where.none) { ret; }
    val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?e.stated, walk.Seed.within{opt_where.some});
    if (sel res_pushed.err) { lost(e, res_pushed.err); }
}

# the declassify point of a declassify, for a constant-time function. it writes no code, so the value its operand's
# push leaves on top of the stack is its result: the point stands after the last instruction written, which pushed it.
# an operand that pushes no code of its own names no instruction to stand after, and is refused
fun declassified(e: *Emitter, i: Instruction) {
    if (!in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret; }
    if (e.w.out.len == e.opened || e.w.last < e.opened) {
        invariant(e, i);
        ret;
    }
    val point:      walk.Declassify             = walk.Declassify{at: e.w.last::u64, length: (e.w.out.len - e.w.last)::u64, side: walk.Side.after{}, place: walk.Place.value{0}};
    val res_pushed: res[usize, allocator.Error] = vector.push[walk.Declassify](?e.points, point);
    if (sel res_pushed.err) { lost(e, res_pushed.err); }
}

# the site of the call written next for instruction `d`, for a constant-time function, and the written seed of each
# result of it the ir declares secret
fun site(e: *Emitter, i: Instruction, d: *InstructionData, named: opt[Function]) {
    if (!in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret; }
    var callee: opt[Declared] = opt[Declared].none{};
    if (sel named.some)             { callee = opt[Declared].some{Declared.function{named.some}}; }
    or (sel d.metadata.stated.some) { callee = opt[Declared].some{Declared.stated{d.metadata.stated.some}}; }
    val at:         u64                         = e.w.out.len::u64;
    val res_listed: res[usize, allocator.Error] = vector.push[Site](?e.sites, Site{at: at, callee: callee, call: i});
    if (sel res_listed.err) {
        lost(e, res_listed.err);
        ret;
    }
    var order: vector.Vector[usize] = vector.init[usize](e.u.a);
    fin { vector.dnit[usize](?order); }
    val res_result_order: res[bool, allocator.Error] = operand.result_order(d, ?order);
    if (sel res_result_order.err) {
        lost(e, res_result_order.err);
        ret;
    }
    var k: usize = 0;
    for (k < order.len) {
        if (e.b.values.data[d.results.data[order.data[k]]].secret) {
            val seed:       walk.Seed                   = walk.Seed.after{walk.Written{at: at, place: walk.Place.value{(order.len - 1 - k)::u32}}};
            val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?e.stated, seed);
            if (sel res_pushed.err) {
                lost(e, res_pushed.err);
                ret;
            }
        }
        k = k + 1;
    }
}

# the load of a value type of a width from memory
fun load_row(code: u32, width: u32) u32 {
    if (code == value.V128)        { ret gen_row_index.V128LOAD; }
    if (code == value.F32)         { ret gen_row_index.F32LOAD; }
    if (code == value.F64)         { ret gen_row_index.F64LOAD; }
    if (code == value.I64)         { ret gen_row_index.I64LOAD; }
    if (width != 0 && width <= 8)  { ret gen_row_index.I32LOAD8U; }
    if (width != 0 && width <= 16) { ret gen_row_index.I32LOAD16U; }
    ret gen_row_index.I32LOAD;
}

# the store of a value type of a width to memory
fun store_row(code: u32, width: u32) u32 {
    if (code == value.V128)        { ret gen_row_index.V128STORE; }
    if (code == value.F32)         { ret gen_row_index.F32STORE; }
    if (code == value.F64)         { ret gen_row_index.F64STORE; }
    if (code == value.I64)         { ret gen_row_index.I64STORE; }
    if (width != 0 && width <= 8)  { ret gen_row_index.I32STORE8; }
    if (width != 0 && width <= 16) { ret gen_row_index.I32STORE16; }
    ret gen_row_index.I32STORE;
}

# the bytes an access of a value type of a width moves
fun natural(code: u32, width: u32) u64 {
    if (code == value.V128)                     { ret 16; }
    if (code == value.F32)                      { ret 4; }
    if (code == value.F64 || code == value.I64) { ret 8; }
    if (width != 0 && width <= 8)               { ret 1; }
    if (width != 0 && width <= 16)              { ret 2; }
    ret 4;
}

# the alignment an access states, `most` where it states none or more than that
fun aligned(stated: u64, most: u64) u64 {
    if (stated == 0 || stated > most) { ret most; }
    ret stated;
}

# the alignment immediate `slot` of `d` states, 0 for none
fun alignment_of(d: *InstructionData, slot: usize) u64 {
    if (slot >= d.immediates.len) { ret 0; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.alignment) { ret imm.alignment; }
    ret 0;
}

# the type immediate `slot` of `d` states, none for none
fun type_of(d: *InstructionData, slot: usize) opt[Type] {
    if (slot >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

# a value of the class of an integer `from` converted to the address type
fun to_pointer(e: *Emitter, from: u32) {
    if (wide(e) && from == select.I32)  { writer.plain(e.w, gen_row_index.I64EXTENDI32S); }
    or (!wide(e) && from == select.I64) { writer.plain(e.w, gen_row_index.I32WRAPI64); }
}

# the number an immediate of a block stands for, none for one no integer
# constant states
fun block_immediate(e: *Emitter, v: Value, signed: bool) opt[i64] {
    val def: Def = e.b.values.data[v].def;
    if (!(sel def.constant)) { ret opt[i64].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, def.constant);
    if (sel res_constant_data.err) { ret opt[i64].none{}; }
    val data: ConstantData = res_constant_data.ok;
    if (sel data.zero)                { ret opt[i64].some{0}; }
    if (!(sel data.integer))          { ret opt[i64].none{}; }
    if (data.integer.words.size == 0) { ret opt[i64].none{}; }
    var bits:  u64 = data.integer.words.data[0];
    val width: u32 = width_of(e, v);
    if (width < 64) {
        val top: u64 = 1::u64 << (width - 1)::u64;
        bits = bits & (top + top - 1);
        if (signed && (bits & top) != 0) { bits = bits | ~(top + top - 1); }
    }
    ret opt[i64].some{bits:~i64};
}

fun block_refused(e: *Emitter, i: Instruction, what: wasm_error.Refused, why: str) {
    fail(e, Error.assembly{Assembly{at: at_instruction(e, i), what: what, message: why}});
}

# the code of an inline assembly block: each operand into the local its name
# stands for, the block's text, and each result pushed from its local, a
# narrow one cleared above its width as the block need not keep it so
fun assembled(e: *Emitter, i: Instruction, d: *InstructionData) {
    val slot: Immediate = d.immediates.data[0];
    if (!(sel slot.assembly)) {
        invariant(e, i);
        ret;
    }
    val b:     *ia.Assembly                 = slot.assembly;
    var binds: vector.Vector[assembly.Bind] = vector.init[assembly.Bind](e.u.a);
    fin { vector.dnit[assembly.Bind](?binds); }
    var reads:  bool  = b.reads;
    var writes: bool  = b.writes;
    var at:     usize = 0;
    var k:      usize = 0;
    for (k < b.operands.size && ok(e)) {
        val o:    *ia.Operand   = ?b.operands.data[k];
        var bind: assembly.Bind = assembly.Bind{name: o.name, number: 0, local: true};
        # a placement by value is a local holding the value, as the one class is
        var c: masc_inline.Constraint = masc_inline.Constraint.class{0};
        if (sel o.placement.stated) { c = o.placement.stated; }
        if (sel c.immediate) {
            val opt_block_immediate: opt[i64] = block_immediate(e, d.operands.data[at], c.immediate.signed);
            if (sel opt_block_immediate.none) {
                block_refused(e, i, wasm_error.OPERAND, assembly.IMMEDIATE);
                ret;
            }
            bind.number = opt_block_immediate.some;
            bind.local  = false;
            at          = at + 1;
        }
        or {
            if (!(sel c.class) && !(sel c.memory)) {
                block_refused(e, i, wasm_error.OPERAND, assembly.CLASS);
                ret;
            }
            if (sel c.class && c.class != 0) {
                block_refused(e, i, wasm_error.OPERAND, assembly.CLASS);
                ret;
            }
            if (sel c.memory) {
                reads  = reads || (o.role & masc_operand.READ) != 0;
                writes = writes || (o.role & masc_operand.WRITE) != 0;
            }
            val opt_code: opt[u32] = value.of(?e.u.m.types, o.ty, e.u.pointer);
            if (sel opt_code.none) {
                fail(e, Error.unvalued{o.ty});
                ret;
            }
            val held: u32 = scratch(e, opt_code.some);
            bind.number = held::i64;
            if (ia.takes(o)) {
                push(e, d.operands.data[at]);
                writer.index(e.w, gen_row_index.LOCALSET, held);
                at = at + 1;
            }
        }
        val res_pushed: res[usize, allocator.Error] = vector.push[assembly.Bind](?binds, bind);
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
    if (!ok(e) || sel e.w.refused.some) { ret; }
    var under: *core_state.Context = e.u.ctx;
    if (b.selection.len > 0) {
        val res_stated: res[*head.Head, head.Error] = head.of(?e.u.heads, e.u.t, e.u.ctx, b.selection);
        if (sel res_stated.err) {
            val why: head.Error = res_stated.err;
            if (sel why.alloc) { lost(e, why.alloc); }
            or                 { block_refused(e, i, wasm_error.HEAD, head.fact(why)); }
            ret;
        }
        under = res_stated.ok.context;
    }
    val res_read: res[assembly.Read, assembly.Error] = assembly.read(e.u.a, e.u.codec, under, b.text, Slice[assembly.Bind]{data: binds.data, size: binds.len}, reads, writes, e.w.features);
    if (sel res_read.err) {
        val why: assembly.Error = res_read.err;
        if (sel why.alloc)   { lost(e, why.alloc); }
        or (sel why.text)    { block_refused(e, i, wasm_error.TEXT, why.text); }
        or (sel why.refused) { block_refused(e, i, wasm_error.DEED, why.refused); }
        ret;
    }
    var code: assembly.Read = res_read.ok;
    fin { assembly.dnit(?code); }
    if (code.fenced) { writer.begin(e.w, gen_row_index.BLOCK); }
    inlined(e, ?code);
    var n: usize = 0;
    for (n < code.code.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](?e.w.out, code.code.data[n]);
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        n = n + 1;
    }
    if (code.fenced) { writer.plain(e.w, gen_row_index.END); }
    var r: usize = 0;
    k = 0;
    for (k < b.operands.size) {
        if (ia.gives(?b.operands.data[k])) {
            writer.index(e.w, gen_row_index.LOCALGET, binds.data[k].number::u32);
            mask(e, width_of(e, d.results.data[r]));
            r = r + 1;
        }
        k = k + 1;
    }
}

# the inline seed of each instruction of block `code` about to be written, for a constant-time function: the walk takes
# a secret such an instruction stores as stored where nothing states memory may hold one
fun inlined(e: *Emitter, code: *assembly.Read) {
    if (!in_constant_time(e.u.m.functions.data[e.f].data.constant_time)) { ret; }
    var k: usize = 0;
    for (k < code.starts.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?e.stated, walk.Seed.inline{(e.w.out.len + code.starts.data[k])::u64});
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
}

# a local of a value type that holds a step of an instruction's code
fun scratch(e: *Emitter, code: u32) u32 {
    val res_made: res[u32, allocator.Error] = local.add(e.l, code);
    if (sel res_made.err) {
        lost(e, res_made.err);
        ret 0;
    }
    val res_defined: res[u32, str] = wasm_stream.define(e.u.ctx.stream, wasm_kind.LOCALS, code, NO_NAME);
    if (sel res_defined.err) { fail(e, Error.encoding{Encoding{function: e.f, message: res_defined.err}}); }
    ret res_made.ok;
}

# an operation of one instruction at a class, refused where it has none
fun simple(e: *Emitter, i: Instruction, op: Opcode, class: u32) {
    val opt_simple: opt[u32] = select.simple(op, class);
    if (sel opt_simple.none) {
        unselected(e, i);
        ret;
    }
    writer.plain(e.w, opt_simple.some);
}

# the lane column of a vector type's lanes, none for a type that is no
# vector or whose lanes simd128 does not pack
fun lane_column(e: *Emitter, ty: Type) opt[u32] {
    ret select.column_of(?e.u.m.types, ty);
}

# the lanes of a vector of conditions, a comparison's mask, 0 for any other type
fun mask_lanes(e: *Emitter, ty: Type) u32 {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, ty);
    if (sel res_shape.err)          { ret 0; }
    if (!(sel res_shape.ok.vector)) { ret 0; }
    val res_width: res[u32, type_table.Error] = type_table.width(?e.u.m.types, res_shape.ok.vector.element);
    if (sel res_width.err) { ret 0; }
    if (res_width.ok != 1) { ret 0; }
    ret res_shape.ok.vector.lanes;
}

# a lanewise operation of simd128, keyed on its lane type: the lanes of its
# first operand where that is a vector, as a comparison's or a conversion's,
# and else of its result, as a splat's. a comparison's mask is a v128 holding
# each lane all ones or zeros at the width of the lanes compared
# (`mirl.target.wasm.value`), so the sign extension of it to lanes that wide,
# the one reader the vector legalisation leaves it, writes nothing. false for
# an instruction with no vector operand or result, or one that is no
# lanewise row
fun vectored(e: *Emitter, i: Instruction, d: *InstructionData) bool {
    if (d.results.len != 1) { ret false; }
    var ty: Type = e.b.values.data[d.results.data[0]].type;
    if (d.operands.len > 0) {
        val first: Type = e.b.values.data[d.operands.data[0]].type;
        val lanes: u32  = mask_lanes(e, first);
        if (d.opcode == table.EXT_S && lanes != 0) {
            val opt_wide: opt[u32] = lane_column(e, ty);
            if (sel opt_wide.none) {
                invariant(e, i);
                ret true;
            }
            if (select.lane_bytes(opt_wide.some) * lanes != 16) { invariant(e, i); }
            ret true;
        }
        val opt_first: opt[u32] = lane_column(e, first);
        if (sel opt_first.some) { ty = first; }
    }
    val opt_column: opt[u32] = lane_column(e, ty);
    if (sel opt_column.none)            { ret false; }
    if (!select.lanewise_row(d.opcode)) { ret false; }
    val opt_row: opt[u32] = select.lanewise(d.opcode, opt_column.some);
    if (sel opt_row.none) {
        unselected(e, i);
        ret true;
    }
    val row: u32 = opt_row.some;
    if (d.opcode == table.VEXTRACT || d.opcode == table.VINSERT) {
        val at: Immediate = d.immediates.data[0];
        if (!(sel at.lane)) {
            invariant(e, i);
            ret true;
        }
        writer.immediate(e.w, row, at.lane::i64);
        ret true;
    }
    if (d.opcode == table.VSHUFFLE) {
        shuffled(e, i, d, row, opt_column.some);
        ret true;
    }
    writer.plain(e.w, row);
    ret true;
}

# a lanewise operation simd128 has no one instruction for, as a sequence
# that pushes its operands itself (`select.sequenced`): a product of bytes as
# the unsigned products of the low and of the high halves widened to words,
# each masked to its low byte and narrowed back unsigned, which is exact below
# 256, and an unsigned order of quadwords as the signed one with the sign bit
# of both operands flipped. false for any other instruction
fun sequenced(e: *Emitter, i: Instruction, d: *InstructionData) bool {
    if (d.results.len != 1 || d.operands.len != 2) { ret false; }
    val x:          Value    = d.operands.data[0];
    val y:          Value    = d.operands.data[1];
    val opt_column: opt[u32] = lane_column(e, e.b.values.data[x].type);
    if (sel opt_column.none)                          { ret false; }
    if (!select.sequenced(d.opcode, opt_column.some)) { ret false; }
    if (d.opcode == table.MUL) {
        push(e, x);
        push(e, y);
        writer.plain(e.w, gen_row_index.I16X8EXTMULLOWI8X16U);
        low_bytes(e);
        push(e, x);
        push(e, y);
        writer.plain(e.w, gen_row_index.I16X8EXTMULHIGHI8X16U);
        low_bytes(e);
        writer.plain(e.w, gen_row_index.I8X16NARROWI16X8U);
        ret true;
    }
    push(e, x);
    sign_flipped(e);
    push(e, y);
    sign_flipped(e);
    if (d.opcode == table.LT_U) { writer.plain(e.w, gen_row_index.I64X2LTS); }
    or                          { writer.plain(e.w, gen_row_index.I64X2LES); }
    ret true;
}

# the low byte of each word of the v128 on the stack
fun low_bytes(e: *Emitter) {
    writer.i32(e.w, 255);
    writer.plain(e.w, gen_row_index.I16X8SPLAT);
    writer.plain(e.w, gen_row_index.V128AND);
}

# the v128 on the stack with the sign bit of each quadword flipped
fun sign_flipped(e: *Emitter) {
    writer.i64(e.w, -9223372036854775808);
    writer.plain(e.w, gen_row_index.I64X2SPLAT);
    writer.plain(e.w, gen_row_index.V128XOR);
}

# a shuffle of two vectors joined, by the bytes of each lane its list picks
fun shuffled(e: *Emitter, i: Instruction, d: *InstructionData, row: u32, column: u32) {
    val list: Immediate = d.immediates.data[0];
    if (!(sel list.lanes)) {
        invariant(e, i);
        ret;
    }
    val bytes: u32 = select.lane_bytes(column);
    if (list.lanes.size::u32 * bytes != 16) {
        invariant(e, i);
        ret;
    }
    var picked: [16]u8;
    var k:      usize = 0;
    for (k < list.lanes.size) {
        val from: u32 = list.lanes.data[k];
        if (from * bytes >= 32) {
            invariant(e, i);
            ret;
        }
        var b: u32 = 0;
        for (b < bytes) {
            picked[k::u32 * bytes + b] = (from * bytes + b)::u8;
            b                          = b + 1;
        }
        k = k + 1;
    }
    writer.one(e.w, row, masc_operand.Value.literal{masc_operand.Bytes{at: ?picked[0], len: 16}});
}

# an atomic read, modify and write where one thread runs: the value held
# before, read once into a local, and the update stored over it
fun update(e: *Emitter, i: Instruction, d: *InstructionData) {
    if (!e.u.threadless) {
        fail(e, Error.threads{at_instruction(e, i)});
        ret;
    }
    e.u.features.single = true;
    val at:   Value = d.operands.data[0];
    val held: Value = d.results.data[0];
    val code: u32   = code_of(e, held);
    val w:    u32   = width_of(e, held);
    val n:    u64   = natural(code, w);
    val old:  u32   = scratch(e, code);
    push(e, at);
    state(e, d);
    writer.memory(e.w, load_row(code, w), 0, n);
    writer.index(e.w, gen_row_index.LOCALSET, old);
    push(e, at);
    val op:    u32 = d.opcode;
    val class: u32 = value.class(code);
    if (op == table.ATOMIC_CMPXCHG) {
        val expected: Value = d.operands.data[1];
        push(e, d.operands.data[2]);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        push(e, expected);
        simple(e, i, table.EQ, class);
        writer.plain(e.w, gen_row_index.SELECT);
        state(e, d);
        writer.memory(e.w, store_row(code, w), 0, n);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        push(e, expected);
        simple(e, i, table.EQ, class);
        ret;
    }
    val v: Value = d.operands.data[1];
    if (op == table.ATOMIC_XCHG) {
        push(e, v);
    }
    or (op == table.ATOMIC_SMAX || op == table.ATOMIC_SMIN || op == table.ATOMIC_UMAX || op == table.ATOMIC_UMIN) {
        # a narrow signed bound compares the two sign extended and keeps the one it picks as it is held
        val narrow: u32 = if_bound(op == table.ATOMIC_SMAX || op == table.ATOMIC_SMIN, w);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        push(e, v);
        writer.index(e.w, gen_row_index.LOCALGET, old);
        sign(e, narrow);
        push(e, v);
        sign(e, narrow);
        var cmp: Opcode = table.GT_S;
        if (op == table.ATOMIC_SMIN) { cmp = table.LT_S; }
        or (op == table.ATOMIC_UMAX) { cmp = table.GT_U; }
        or (op == table.ATOMIC_UMIN) { cmp = table.LT_U; }
        simple(e, i, cmp, class);
        writer.plain(e.w, gen_row_index.SELECT);
    }
    or {
        writer.index(e.w, gen_row_index.LOCALGET, old);
        push(e, v);
        var with: Opcode = table.ADD;
        if (op == table.ATOMIC_SUB)                            { with = table.SUB; }
        or (op == table.ATOMIC_AND || op == table.ATOMIC_NAND) { with = table.AND; }
        or (op == table.ATOMIC_OR)                             { with = table.OR; }
        or (op == table.ATOMIC_XOR)                            { with = table.XOR; }
        simple(e, i, with, class);
        if (op == table.ATOMIC_NAND) {
            if (class == select.I64) { writer.i64(e.w, -1); }
            or                       { writer.i32(e.w, -1); }
            simple(e, i, table.XOR, class);
        }
        if (class == select.I32) { mask(e, w); }
    }
    state(e, d);
    writer.memory(e.w, store_row(code, w), 0, n);
    writer.index(e.w, gen_row_index.LOCALGET, old);
}

# a float compare wasm has no one instruction of, each operand read twice
fun unordered(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:     Value = d.operands.data[0];
    val y:     Value = d.operands.data[1];
    val class: u32   = class_of(e, x);
    val op:    u32   = d.opcode;
    if (op == table.FNE_O || op == table.FEQ_U) {
        push(e, x);
        push(e, y);
        simple(e, i, table.FLT_O, class);
        push(e, x);
        push(e, y);
        simple(e, i, table.FGT_O, class);
        writer.plain(e.w, gen_row_index.I32OR);
        if (op == table.FEQ_U) { writer.plain(e.w, gen_row_index.I32EQZ); }
        ret;
    }
    var test: Opcode = table.FEQ_O;
    var join: u32    = gen_row_index.I32AND;
    if (op == table.FUNO) {
        test = table.FNE_U;
        join = gen_row_index.I32OR;
    }
    push(e, x);
    push(e, x);
    simple(e, i, test, class);
    push(e, y);
    push(e, y);
    simple(e, i, test, class);
    writer.plain(e.w, join);
}

# the width a signed bound sign extends its operands from, 0 for an unsigned one
fun if_bound(signed: bool, width: u32) u32 {
    if (signed) { ret width; }
    ret 0;
}

# an integer constant of a class
fun integer_constant(e: *Emitter, class: u32, n: i64) {
    if (class == select.I64) { writer.i64(e.w, n); }
    or                       { writer.i32(e.w, n); }
}

# the float compares that are the negation of one wasm states
fun negated(op: Opcode) opt[Opcode] {
    val i: u32 = op;
    if (i == table.FLT_U) { ret opt[Opcode].some{table.FGE_O}; }
    if (i == table.FLE_U) { ret opt[Opcode].some{table.FGT_O}; }
    if (i == table.FGT_U) { ret opt[Opcode].some{table.FLE_O}; }
    if (i == table.FGE_U) { ret opt[Opcode].some{table.FLT_O}; }
    ret opt[Opcode].none{};
}

# a conversion between integers, a narrow one held zero extended in an i32
fun integer(e: *Emitter, i: Instruction, op: u32, from: Value, to: Value) {
    val fw: u32 = width_of(e, from);
    val tw: u32 = width_of(e, to);
    val fc: u32 = class_of(e, from);
    val tc: u32 = class_of(e, to);
    if (op == table.TRUNC) {
        if (fc == select.I64 && tc == select.I32) { writer.plain(e.w, gen_row_index.I32WRAPI64); }
        if (tc == select.I32)                     { mask(e, tw); }
        ret;
    }
    if (op == table.EXT_U) {
        if (fc == select.I32 && tc == select.I64) { writer.plain(e.w, gen_row_index.I64EXTENDI32U); }
        ret;
    }
    if (fw == 1) {
        writer.i32(e.w, -1);
        writer.plain(e.w, gen_row_index.I32MUL);
    }
    or                                        { sign(e, fw); }
    if (tc == select.I64 && fc == select.I32) { writer.plain(e.w, gen_row_index.I64EXTENDI32S); }
    or (tc == select.I32)                     { mask(e, tw); }
}

# a conversion between an integer and a float, or between two floats
fun numeric(e: *Emitter, i: Instruction, op: u32, from: Value, to: Value) {
    val fc: u32 = class_of(e, from);
    val tc: u32 = class_of(e, to);
    if (op == table.FPROMOTE) {
        writer.plain(e.w, gen_row_index.F64PROMOTEF32);
        ret;
    }
    if (op == table.FDEMOTE) {
        writer.plain(e.w, gen_row_index.F32DEMOTEF64);
        ret;
    }
    val signed: bool = op == table.ITOF_S || op == table.FTOI_S;
    if (op == table.ITOF_S || op == table.ITOF_U) {
        if (signed && fc == select.I32) { sign(e, width_of(e, from)); }
        var r: u32 = 0;
        if (tc == select.F32) {
            if (fc == select.I32) { r = if_signed(signed, gen_row_index.F32CONVERTI32S, gen_row_index.F32CONVERTI32U); }
            or                    { r = if_signed(signed, gen_row_index.F32CONVERTI64S, gen_row_index.F32CONVERTI64U); }
        }
        or {
            if (fc == select.I32) { r = if_signed(signed, gen_row_index.F64CONVERTI32S, gen_row_index.F64CONVERTI32U); }
            or                    { r = if_signed(signed, gen_row_index.F64CONVERTI64S, gen_row_index.F64CONVERTI64U); }
        }
        writer.plain(e.w, r);
        ret;
    }
    # a float to an integer saturates at the bounds of the result's width and gives 0 for a nan, which
    # wasm's saturating truncation gives at 32 and 64 bits and bounds below them, and which a build
    # without that extension makes of the trapping truncation. one wider than 64 bits is the wide
    # integer splitting's, which converts it word by word
    val tw: u32 = width_of(e, to);
    if (tw > 64) {
        invariant(e, i);
        ret;
    }
    if (core_state.holds(e.u.ctx, wasm_extension.NONTRAPPING_FPTOINT)) {
        var r: u32 = 0;
        if (tc == select.I32) {
            if (fc == select.F32) { r = if_signed(signed, gen_row_index.I32TRUNCSATF32S, gen_row_index.I32TRUNCSATF32U); }
            or                    { r = if_signed(signed, gen_row_index.I32TRUNCSATF64S, gen_row_index.I32TRUNCSATF64U); }
        }
        or {
            if (fc == select.F32) { r = if_signed(signed, gen_row_index.I64TRUNCSATF32S, gen_row_index.I64TRUNCSATF32U); }
            or                    { r = if_signed(signed, gen_row_index.I64TRUNCSATF64S, gen_row_index.I64TRUNCSATF64U); }
        }
        writer.plain(e.w, r);
    }
    or                        { saturated(e, fc, tc, signed); }
    if (tw != 32 && tw != 64) { bounded(e, i, tc, tw, signed); }
}

# 2^p or -2^p as a constant of a float class, p within the exponents of both
fun power(e: *Emitter, class: u32, p: u64, negative: bool) {
    if (class == select.F32) {
        var bits: u64 = (127 + p) << 23;
        if (negative) { bits = bits | (1::u64 << 31); }
        writer.immediate(e.w, gen_row_index.F32CONST, bits:~i64);
        ret;
    }
    var bits: u64 = (1023 + p) << 52;
    if (negative) { bits = bits | (1::u64 << 63); }
    writer.immediate(e.w, gen_row_index.F64CONST, bits:~i64);
}

# the saturating truncation of the float on the stack, by the core set's
# trapping truncation, with no branch so it keeps constant time. a value at or
# past the least integer of the width and below 2^w or 2^(w-1) truncates in
# range, so the truncation is handed it, and 0 in place of any other, which
# never traps. the result is then the truncation for a value in range, the
# greatest integer at or above the upper bound, 0 for a nan, and the least
# integer below the lower bound, which is what truncating a value between the
# least integer less one and the least integer gives too
fun saturated(e: *Emitter, fc: u32, tc: u32, signed: bool) {
    var code:  u32 = value.F64;
    var below: u32 = gen_row_index.F64LT;
    var least: u32 = gen_row_index.F64GE;
    var same:  u32 = gen_row_index.F64EQ;
    var zero:  u32 = gen_row_index.F64CONST;
    if (fc == select.F32) {
        code  = value.F32;
        below = gen_row_index.F32LT;
        least = gen_row_index.F32GE;
        same  = gen_row_index.F32EQ;
        zero  = gen_row_index.F32CONST;
    }
    var w: u64 = 32;
    var r: u32 = 0;
    if (tc == select.I32) {
        if (fc == select.F32) { r = if_signed(signed, gen_row_index.I32TRUNCF32S, gen_row_index.I32TRUNCF32U); }
        or                    { r = if_signed(signed, gen_row_index.I32TRUNCF64S, gen_row_index.I32TRUNCF64U); }
    }
    or {
        w = 64;
        if (fc == select.F32) { r = if_signed(signed, gen_row_index.I64TRUNCF32S, gen_row_index.I64TRUNCF32U); }
        or                    { r = if_signed(signed, gen_row_index.I64TRUNCF64S, gen_row_index.I64TRUNCF64U); }
    }
    var top:  u64 = w;
    var high: i64 = -1;
    var low:  i64 = 0;
    if (signed) {
        top  = w - 1;
        high = ((1::u64 << top) - 1)::i64;
        low  = (1::u64 << top):~i64;
    }
    val x:  u32 = scratch(e, code);
    val ok: u32 = scratch(e, value.I32);
    writer.index(e.w, gen_row_index.LOCALSET, x);
    writer.index(e.w, gen_row_index.LOCALGET, x);
    if (signed) { power(e, fc, top, true); }
    or          { writer.immediate(e.w, zero, 0); }
    writer.plain(e.w, least);
    writer.index(e.w, gen_row_index.LOCALGET, x);
    power(e, fc, top, false);
    writer.plain(e.w, below);
    writer.plain(e.w, gen_row_index.I32AND);
    writer.index(e.w, gen_row_index.LOCALSET, ok);

    writer.index(e.w, gen_row_index.LOCALGET, x);
    writer.immediate(e.w, zero, 0);
    writer.index(e.w, gen_row_index.LOCALGET, ok);
    writer.plain(e.w, gen_row_index.SELECT);
    writer.plain(e.w, r);

    integer_constant(e, tc, high);
    integer_constant(e, tc, low);
    writer.index(e.w, gen_row_index.LOCALGET, x);
    power(e, fc, top, false);
    writer.plain(e.w, least);
    writer.plain(e.w, gen_row_index.SELECT);
    integer_constant(e, tc, 0);
    writer.index(e.w, gen_row_index.LOCALGET, x);
    writer.index(e.w, gen_row_index.LOCALGET, x);
    writer.plain(e.w, same);
    writer.plain(e.w, gen_row_index.SELECT);

    writer.index(e.w, gen_row_index.LOCALGET, ok);
    writer.plain(e.w, gen_row_index.SELECT);
}

# a saturated conversion's result of value type class `class` bounded to an
# integer of width `w` narrower than it: kept at the greatest value of the
# width above it and at the least below it, an unsigned one below no bound as
# wasm's unsigned truncation gives none below 0, and a narrow value of an i32
# held masked to its width
fun bounded(e: *Emitter, i: Instruction, class: u32, w: u32, signed: bool) {
    var code: u32 = value.I32;
    if (class == select.I64) { code = value.I64; }
    val t:     u32    = scratch(e, code);
    var high:  i64    = ((1::u64 << w::u64) - 1)::i64;
    var low:   i64    = 0;
    var above: Opcode = table.GT_U;
    if (signed) {
        high  = ((1::u64 << (w - 1)::u64) - 1)::i64;
        low   = -(1::u64 << (w - 1)::u64)::i64;
        above = table.GT_S;
    }
    writer.index(e.w, gen_row_index.LOCALSET, t);
    integer_constant(e, class, high);
    writer.index(e.w, gen_row_index.LOCALGET, t);
    writer.index(e.w, gen_row_index.LOCALGET, t);
    integer_constant(e, class, high);
    simple(e, i, above, class);
    writer.plain(e.w, gen_row_index.SELECT);
    if (signed) {
        writer.index(e.w, gen_row_index.LOCALSET, t);
        integer_constant(e, class, low);
        writer.index(e.w, gen_row_index.LOCALGET, t);
        writer.index(e.w, gen_row_index.LOCALGET, t);
        integer_constant(e, class, low);
        simple(e, i, table.LT_S, class);
        writer.plain(e.w, gen_row_index.SELECT);
    }
    if (class == select.I32) { mask(e, w); }
}

# an overflow form, each operand read from where it is held: the result at
# the operands' width, then whether the operation overflowed it. a sum or a
# difference overflows unsigned where it carries or borrows and signed where
# its sign is neither operand's, or is the first's and not the second's for a
# difference, and a 32-bit product is made exactly at 64 bits and overflows
# where its high half is not the extension of its low. wasm has no product of
# two 64-bit operands of more than 64 bits, so a 64-bit product's overflow
# has no form here. a narrow one is the narrow legalisation's, which computes
# it at 32 bits
fun overflow(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:     Value = d.operands.data[0];
    val y:     Value = d.operands.data[1];
    val code:  u32   = code_of(e, x);
    val class: u32   = value.class(code);
    val w:     u32   = width_of(e, x);
    val op:    u32   = d.opcode;
    if (w != 32 && w != 64) {
        invariant(e, i);
        ret;
    }
    if (op == table.MUL_OV_U || op == table.MUL_OV_S) {
        if (class != select.I32) {
            unselected(e, i);
            ret;
        }
        var widen: u32 = gen_row_index.I64EXTENDI32U;
        if (op == table.MUL_OV_S) { widen = gen_row_index.I64EXTENDI32S; }
        val p: u32 = scratch(e, value.I64);
        push(e, x);
        writer.plain(e.w, widen);
        push(e, y);
        writer.plain(e.w, widen);
        writer.plain(e.w, gen_row_index.I64MUL);
        writer.index(e.w, gen_row_index.LOCALTEE, p);
        writer.plain(e.w, gen_row_index.I32WRAPI64);
        writer.index(e.w, gen_row_index.LOCALGET, p);
        if (op == table.MUL_OV_U) {
            writer.i64(e.w, 32);
            writer.plain(e.w, gen_row_index.I64SHRU);
            writer.i64(e.w, 0);
        }
        or {
            writer.index(e.w, gen_row_index.LOCALGET, p);
            writer.plain(e.w, gen_row_index.I32WRAPI64);
            writer.plain(e.w, gen_row_index.I64EXTENDI32S);
        }
        writer.plain(e.w, gen_row_index.I64NE);
        ret;
    }
    val sum: bool = op == table.ADD_OV_U || op == table.ADD_OV_S;
    push(e, x);
    push(e, y);
    if (sum) { simple(e, i, table.ADD, class); }
    or       { simple(e, i, table.SUB, class); }
    if (op == table.SUB_OV_U) {
        push(e, x);
        push(e, y);
        simple(e, i, table.LT_U, class);
        ret;
    }
    val t: u32 = scratch(e, code);
    writer.index(e.w, gen_row_index.LOCALTEE, t);
    if (op == table.ADD_OV_U) {
        writer.index(e.w, gen_row_index.LOCALGET, t);
        push(e, x);
        simple(e, i, table.LT_U, class);
        ret;
    }
    if (sum) {
        writer.index(e.w, gen_row_index.LOCALGET, t);
        push(e, x);
        simple(e, i, table.XOR, class);
        writer.index(e.w, gen_row_index.LOCALGET, t);
        push(e, y);
        simple(e, i, table.XOR, class);
    }
    or {
        push(e, x);
        push(e, y);
        simple(e, i, table.XOR, class);
        push(e, x);
        writer.index(e.w, gen_row_index.LOCALGET, t);
        simple(e, i, table.XOR, class);
    }
    simple(e, i, table.AND, class);
    integer_constant(e, class, 0);
    simple(e, i, table.LT_S, class);
}

# a byte swap at 32 or 64 bits, its operand read once into a local: at 32
# bits the bytes rotated each way by 8 and the two halves masked together,
# and at 64 the bytes of each 16 bits swapped, then the 16-bit halves of
# each 32, then the two 32-bit halves by a rotate. a narrower one is the
# narrow legalisation's, which swaps at the wide width and shifts its bytes
# back down
fun swapped(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:    Value = d.operands.data[0];
    val code: u32   = code_of(e, x);
    val w:    u32   = width_of(e, x);
    if (w != 32 && w != 64) {
        invariant(e, i);
        ret;
    }
    val t: u32 = scratch(e, code);
    writer.index(e.w, gen_row_index.LOCALTEE, t);
    if (w == 32) {
        writer.i32(e.w, 8);
        writer.plain(e.w, gen_row_index.I32ROTL);
        writer.i32(e.w, 0x00FF_00FF);
        writer.plain(e.w, gen_row_index.I32AND);
        writer.index(e.w, gen_row_index.LOCALGET, t);
        writer.i32(e.w, 8);
        writer.plain(e.w, gen_row_index.I32ROTR);
        writer.i32(e.w, 0xFF00_FF00);
        writer.plain(e.w, gen_row_index.I32AND);
        writer.plain(e.w, gen_row_index.I32OR);
        ret;
    }
    swap_step(e, t, 8, 0x00FF_00FF_00FF_00FF);
    writer.index(e.w, gen_row_index.LOCALTEE, t);
    swap_step(e, t, 16, 0x0000_FFFF_0000_FFFF);
    writer.i64(e.w, 32);
    writer.plain(e.w, gen_row_index.I64ROTL);
}

# one step of a 64-bit byte swap: the value on the stack, also in local `t`,
# shifted down by `by` and masked, joined with its masked bits shifted up
fun swap_step(e: *Emitter, t: u32, by: i64, keep: i64) {
    writer.i64(e.w, by);
    writer.plain(e.w, gen_row_index.I64SHRU);
    writer.i64(e.w, keep);
    writer.plain(e.w, gen_row_index.I64AND);
    writer.index(e.w, gen_row_index.LOCALGET, t);
    writer.i64(e.w, keep);
    writer.plain(e.w, gen_row_index.I64AND);
    writer.i64(e.w, by);
    writer.plain(e.w, gen_row_index.I64SHL);
    writer.plain(e.w, gen_row_index.I64OR);
}

# whether an operation is one a legalisation of wasm's steps always lowers
# before code is written, so a verified module never brings it here: a call
# or a return the abi legalisation places, a bulk copy or fill and a
# division of a two-word dividend the helpers call for, as wasm states no
# bulk memory and no long division, a high multiply the multiply forms build
# from the multiplies wasm has, and a compare and exchange of two words the
# wide integer splitting takes, as wasm states no paired atomic
fun lowered(op: Opcode) bool {
    val i: u32 = op;
    if (i == table.CALL || i == table.RET)                                        { ret true; }
    if (i == table.MEM_COPY || i == table.MEM_FILL || i == table.DIV_WIDE_U)      { ret true; }
    if (i == table.MUL_HIGH_U || i == table.MUL_HIGH_S || i == table.MUL_HIGH_SU) { ret true; }
    ret i == table.ATOMIC_CMPXCHG_WORDS;
}

fun if_signed(signed: bool, yes: u32, no: u32) u32 {
    if (signed) { ret yes; }
    ret no;
}

# the code of one instruction, its operands pushed as it pushes them
fun instruction(e: *Emitter, i: Instruction, d: *InstructionData) {
    val op: u32 = d.opcode;
    if (op == table.RET_PLACED) {
        unwind(e);
        writer.plain(e.w, gen_row_index.RETURN);
        ret;
    }
    if (op == table.UNREACHABLE) {
        writer.plain(e.w, gen_row_index.UNREACHABLE);
        ret;
    }
    if (op == table.CALL_PLACED) {
        call(e, i, d);
        ret;
    }
    if (op == table.DECLASSIFY) {
        declassified(e, i);
        ret;
    }
    if (op == table.ASM) {
        assembled(e, i, d);
        ret;
    }
    if (op == table.FENCE) {
        if (!e.u.threadless) { fail(e, Error.threads{at_instruction(e, i)}); }
        e.u.features.single = true;
        ret;
    }
    if (operand.updates(d.opcode)) {
        update(e, i, d);
        ret;
    }
    if (sequenced(e, i, d)) { ret; }
    if (vectored(e, i, d))  { ret; }
    if (op == table.FNE_O || op == table.FEQ_U || op == table.FORD || op == table.FUNO) {
        unordered(e, i, d);
        ret;
    }
    if (op == table.LOAD || op == table.ATOMIC_LOAD) {
        if (op == table.ATOMIC_LOAD && !e.u.threadless) {
            fail(e, Error.threads{at_instruction(e, i)});
            ret;
        }
        if (op == table.ATOMIC_LOAD) { e.u.features.single = true; }
        val r:     Value = d.results.data[0];
        val code:  u32   = code_of(e, r);
        val w:     u32   = width_of(e, r);
        var align: u64   = 0;
        if (op == table.LOAD) { align = alignment_of(d, 1); }
        state(e, d);
        if (op == table.LOAD) { placed(e, d, d.operands.data[0], natural(code, w)); }
        writer.memory(e.w, load_row(code, w), 0, aligned(align, natural(code, w)));
        ret;
    }
    if (op == table.STORE || op == table.ATOMIC_STORE) {
        if (op == table.ATOMIC_STORE && !e.u.threadless) {
            fail(e, Error.threads{at_instruction(e, i)});
            ret;
        }
        if (op == table.ATOMIC_STORE) { e.u.features.single = true; }
        val v:     Value = d.operands.data[1];
        val code:  u32   = code_of(e, v);
        val w:     u32   = width_of(e, v);
        var align: u64   = 0;
        state(e, d);
        if (op == table.STORE) {
            align = alignment_of(d, 0);
            placed(e, d, d.operands.data[0], natural(code, w));
        }
        writer.memory(e.w, store_row(code, w), 0, aligned(align, natural(code, w)));
        ret;
    }
    if (op == table.ALLOCA) {
        slot(e, i);
        ret;
    }
    if (op == table.FUNC_ADDR) {
        val imm: Immediate = d.immediates.data[0];
        if (!(sel imm.function)) {
            invariant(e, i);
            ret;
        }
        function_address(e, imm.function);
        ret;
    }
    if (op == table.PTR_ADD) {
        to_pointer(e, class_of(e, d.operands.data[1]));
        pointer_op(e, gen_row_index.I32ADD, gen_row_index.I64ADD);
        ret;
    }
    if (op == table.PTR_MEMBER) {
        val opt_type_of: opt[Type] = type_of(d, 0);
        val member:      Immediate = d.immediates.data[1];
        if (sel opt_type_of.none) {
            invariant(e, i);
            ret;
        }
        if (!(sel member.member)) {
            invariant(e, i);
            ret;
        }
        val res_offset: res[u64, record.Error] = layout.offset(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE, member.member);
        if (sel res_offset.err) {
            fail(e, Error.layout{res_offset.err});
            ret;
        }
        if (res_offset.ok != 0) {
            address(e, res_offset.ok);
            pointer_op(e, gen_row_index.I32ADD, gen_row_index.I64ADD);
        }
        ret;
    }
    if (op == table.PTR_INDEX) {
        val opt_type_of: opt[Type] = type_of(d, 0);
        if (sel opt_type_of.none) {
            invariant(e, i);
            ret;
        }
        val res_step: res[u64, record.Error] = layout.stride(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE);
        if (sel res_step.err) {
            fail(e, Error.layout{res_step.err});
            ret;
        }
        val index: Value = d.operands.data[1];
        if (class_of(e, index) == select.I32) { sign(e, width_of(e, index)); }
        to_pointer(e, class_of(e, index));
        address(e, res_step.ok);
        pointer_op(e, gen_row_index.I32MUL, gen_row_index.I64MUL);
        pointer_op(e, gen_row_index.I32ADD, gen_row_index.I64ADD);
        ret;
    }
    if (op == table.SELECT) {
        writer.plain(e.w, gen_row_index.SELECT);
        ret;
    }
    if (op == table.EXT_U || op == table.EXT_S || op == table.TRUNC) {
        integer(e, i, op, d.operands.data[0], d.results.data[0]);
        ret;
    }
    if (op == table.ITOF_S || op == table.ITOF_U || op == table.FTOI_S || op == table.FTOI_U || op == table.FPROMOTE || op == table.FDEMOTE) {
        numeric(e, i, op, d.operands.data[0], d.results.data[0]);
        ret;
    }
    if (op == table.BITCAST || op == table.PTRTOINT || op == table.INTTOPTR) {
        cast(e, i, op, d.operands.data[0], d.results.data[0]);
        ret;
    }
    if (lowered(d.opcode)) {
        invariant(e, i);
        ret;
    }
    if (operand.checked(d.opcode)) {
        overflow(e, i, d);
        ret;
    }
    if (op == table.BSWAP) {
        swapped(e, i, d);
        ret;
    }
    if (d.operands.len == 0 || d.results.len != 1) {
        unselected(e, i);
        ret;
    }
    val x:     Value = d.operands.data[0];
    val class: u32   = class_of(e, x);
    val w:     u32   = width_of(e, x);
    if (op == table.NEG) {
        if (class == select.I64) { writer.i64(e.w, -1); }
        or                       { writer.i32(e.w, -1); }
        simple(e, i, table.MUL, class);
        if (class == select.I32) { mask(e, w); }
        ret;
    }
    if (op == table.NOT) {
        if (class == select.I64) { writer.i64(e.w, -1); }
        or                       { if_narrow_not(e, w); }
        simple(e, i, table.XOR, class);
        ret;
    }
    val opt_flipped: opt[Opcode] = negated(d.opcode);
    if (sel opt_flipped.some) {
        simple(e, i, opt_flipped.some, class);
        writer.plain(e.w, gen_row_index.I32EQZ);
        ret;
    }
    if (class == select.I32 && w != 0 && w < 32) {
        # the narrow legalisation extends a signed operation's operands to 32 bits
        if (select.signed(d.opcode)) {
            invariant(e, i);
            ret;
        }
        if (op == table.CTZ) {
            writer.i32(e.w, (1::u64 << w::u64)::i64);
            writer.plain(e.w, gen_row_index.I32OR);
        }
    }
    simple(e, i, d.opcode, class);
    if (class == select.I32 && w != 0 && w < 32) {
        if (op == table.CLZ) {
            writer.i32(e.w, (32 - w)::i64);
            writer.plain(e.w, gen_row_index.I32SUB);
        }
        or (!select.exact(d.opcode) && !select.compare(d.opcode) && op != table.CTZ) { mask(e, w); }
    }
}

# the all-ones mask of an i32 at a width, as a narrow not flips it
fun if_narrow_not(e: *Emitter, w: u32) {
    if (w != 0 && w < 32) { writer.i32(e.w, ((1::u64 << w::u64) - 1)::i64); }
    or                    { writer.i32(e.w, -1); }
}

# the same bits as another type, or an address as an integer and back
fun cast(e: *Emitter, i: Instruction, op: u32, from: Value, to: Value) {
    val fc: u32 = class_of(e, from);
    val tc: u32 = class_of(e, to);
    if (fc == tc) {
        if (op == table.PTRTOINT) { mask(e, width_of(e, to)); }
        ret;
    }
    if (fc == select.I32 && tc == select.F32) { writer.plain(e.w, gen_row_index.F32REINTERPRETI32); }
    or (fc == select.I64 && tc == select.F64) { writer.plain(e.w, gen_row_index.F64REINTERPRETI64); }
    or (fc == select.F32 && tc == select.I32) { writer.plain(e.w, gen_row_index.I32REINTERPRETF32); }
    or (fc == select.F64 && tc == select.I64) { writer.plain(e.w, gen_row_index.I64REINTERPRETF64); }
    or (fc == select.I64 && tc == select.I32) {
        writer.plain(e.w, gen_row_index.I32WRAPI64);
        mask(e, width_of(e, to));
    }
    or (fc == select.I32 && tc == select.I64) { writer.plain(e.w, gen_row_index.I64EXTENDI32U); }
    or                                        { invariant(e, i); }
}

# a placed call: a function by its index, or an address through the table
# by the type its operands and results are, made as a tail call where it is
# the one its block's return is made as
fun call(e: *Emitter, i: Instruction, d: *InstructionData) {
    val tail:       bool          = i == e.tail;
    val opt_callee: opt[Function] = operand.direct(e.u.m, e.b, d.operands.data[0]);
    if (sel opt_callee.some) {
        var row: u32 = gen_row_index.CALL;
        if (tail) { row = gen_row_index.RETURNCALL; }
        site(e, i, d, opt_callee);
        writer.one(e.w, row, relocation.function(e.u, opt_callee.some));
        ret;
    }
    if (wide(e)) { writer.plain(e.w, gen_row_index.I32WRAPI64); }
    var params:  vector.Vector[u32] = vector.init[u32](e.u.a);
    var results: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin {
        vector.dnit[u32](?params);
        vector.dnit[u32](?results);
    }
    var order: vector.Vector[usize] = vector.init[usize](e.u.a);
    fin { vector.dnit[usize](?order); }
    val res_order: res[bool, allocator.Error] = operand.order(e.u.m, e.b, d, ?order);
    if (sel res_order.err) {
        lost(e, res_order.err);
        ret;
    }
    var k: usize = 0;
    for (k + 1 < order.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?params, code_of(e, d.operands.data[order.data[k]]));
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
    val res_listed: res[bool, allocator.Error] = operand.result_order(d, ?order);
    if (sel res_listed.err) {
        lost(e, res_listed.err);
        ret;
    }
    k = 0;
    for (k < order.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?results, code_of(e, d.results.data[order.data[k]]));
        if (sel res_pushed.err) {
            lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
    var row: u32 = gen_row_index.CALLINDIRECT;
    if (tail) { row = gen_row_index.RETURNCALLINDIRECT; }
    site(e, i, d, opt_callee);
    writer.indirect(e.w, row, relocation.type(e.u, typed(e, params.data, params.len::u32, results.data, results.len::u32)));
}

# the alignment the stack pointer keeps at every call, by the c abi of the tool conventions
val STACK_ALIGN: u64 = 16;

# lay out the function's stack slots in its frame, each at its alignment
fun frame(e: *Emitter) {
    var at:   u64   = 0;
    var most: u64   = 1;
    var any:  bool  = false;
    var k:    usize = 0;
    for (k < e.b.instructions.len) {
        val d:      *InstructionData = ?e.b.instructions.data[k];
        val placed: Spot             = d.place;
        if (d.opcode == table.ALLOCA && sel placed.placed) {
            val opt_type_of: opt[Type] = type_of(d, 0);
            if (sel opt_type_of.none) {
                invariant(e, (k::u32));
                ret;
            }
            val res_size: res[u64, record.Error] = layout.size(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE);
            if (sel res_size.err) {
                fail(e, Error.layout{res_size.err});
                ret;
            }
            var align: u64 = alignment_of(d, 2);
            if (align == 0) {
                val res_own: res[u64, record.Error] = layout.align(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE);
                if (sel res_own.err) {
                    fail(e, Error.layout{res_own.err});
                    ret;
                }
                align = res_own.ok;
            }
            if (align == 0)   { align = 1; }
            if (align > most) { most = align; }
            at              = (at + align - 1) / align * align;
            e.slots.data[k] = at;
            at              = at + res_size.ok;
            any             = true;
        }
        k = k + 1;
    }
    if (!any) { ret; }
    e.frame = (at + 15) / 16 * 16;
    e.base  = scratch(e, e.u.pointer);
    writer.one(e.w, gen_row_index.GLOBALGET, relocation.stack(e.u));
    if (most > STACK_ALIGN) {
        e.entry = scratch(e, e.u.pointer);
        writer.index(e.w, gen_row_index.LOCALTEE, e.entry);
    }
    address(e, e.frame);
    pointer_op(e, gen_row_index.I32SUB, gen_row_index.I64SUB);
    if (most > STACK_ALIGN) {
        address(e, ~(most - 1));
        pointer_op(e, gen_row_index.I32AND, gen_row_index.I64AND);
    }
    writer.index(e.w, gen_row_index.LOCALTEE, e.base);
    writer.one(e.w, gen_row_index.GLOBALSET, relocation.stack(e.u));
}

# the blocks of a region in the order their code is laid out
fun lay(s: *Structure, r: u32, out: *vector.Vector[u32]) err[allocator.Error] {
    if (r == NONE) { ret err[allocator.Error].ok{}; }
    val g: Region      = region.region(s, r);
    val k: region.Kind = g.kind;
    if (sel k.block || sel k.selection) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](out, g.block);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
    }
    if (sel k.block) { ret err[allocator.Error].ok{}; }
    var c: u32 = g.child;
    for (c != NONE) {
        val err_lay: err[allocator.Error] = lay(s, c, out);
        if (sel err_lay.err) { ret err_lay; }
        c = region.region(s, c).next;
    }
    ret err[allocator.Error].ok{};
}

# an analysis's result, its refusal as the back end's error
fun analysed[T](got: res[*T, refusal.Error]) res[*T, Error] {
    if (sel got.err) { ret res[*T, Error].err{Error.analysis{got.err}}; }
    ret res[*T, Error].ok{got.ok};
}

# the body of one defined function: its locals vector, then its code
# ---
# u:      the module laid out
# f:      the function
# out:    where the body is written
# fixups: where a fixup of each symbolic operand is added, its offset from
#         the start of the body, its site holding its provisional value
# rows:   where each change of source location is added, its offset from the
#         start of the body, none where the module states no line records
# ret:    ok, or why the function's code was refused
pub fun function(u: *Unit, f: Function, out: *vector.Vector[u8], fixups: *vector.Vector[field.Fixup], rows: *vector.Vector[line.Row]) err[Error] {
    val b:            *Body                  = ?u.m.functions.data[f].body;
    val res_analysed: res[*Structure, Error] = analysed[Structure](analysis.structure_of(u.cache, f));
    if (sel res_analysed.err) { ret err[Error].err{res_analysed.err}; }
    val res_live: res[*Liveness, Error] = analysed[Liveness](analysis.liveness_of(u.cache, f));
    if (sel res_live.err) { ret err[Error].err{res_live.err}; }
    var order: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?order); }
    val err_laid: err[allocator.Error] = lay(res_analysed.ok, region.root(res_analysed.ok), ?order);
    if (sel err_laid.err) { ret err[Error].err{Error.alloc{err_laid.err}}; }
    val sig:          *Signature         = ?u.signatures.data[f];
    val res_assigned: res[Locals, Error] = local.assign(u.a, u.m, b, ?order, res_live.ok, ?sig.params, u.pointer);
    if (sel res_assigned.err) { ret err[Error].err{res_assigned.err}; }
    var l: Locals = res_assigned.ok;
    fin { local.dnit(?l); }

    val err_entered: err[str] = wasm_stream.enter(u.ctx.stream, u.types.data[f]);
    if (sel err_entered.err) { ret err[Error].err{Error.encoding{Encoding{function: f, message: err_entered.err}}}; }
    var n: usize = 0;
    for (n < l.types.len) {
        val res_defined: res[u32, str] = wasm_stream.define(u.ctx.stream, wasm_kind.LOCALS, l.types.data[n], NO_NAME);
        if (sel res_defined.err) { ret err[Error].err{Error.encoding{Encoding{function: f, message: res_defined.err}}}; }
        n = n + 1;
    }
    n = 0;
    for (n < l.types.len) {
        if (l.types.data[n] == value.V128) { writer.uses(?u.features, wasm_extension.SIMD128); }
        n = n + 1;
    }
    var w: Writer = writer.init(u.a, u.codec, u.ctx, ?u.features);
    fin { writer.dnit(?w); }
    var e: Emitter = Emitter{u: u, f: f, b: b, s: res_analysed.ok, l: ?l, w: ?w, frames: vector.init[Frame](u.a), slots: vector.init[u64](u.a), frame: 0, base: local.NONE, entry: local.NONE, stated: vector.init[walk.Seed](u.a), points: vector.init[walk.Declassify](u.a), opened: 0, sites: vector.init[Site](u.a), rows: vector.init[line.Row](u.a), tail: NONE, failed: opt[Error].none{}};
    fin {
        vector.dnit[Frame](?e.frames);
        vector.dnit[u64](?e.slots);
        vector.dnit[walk.Seed](?e.stated);
        vector.dnit[walk.Declassify](?e.points);
        vector.dnit[Site](?e.sites);
        vector.dnit[line.Row](?e.rows);
    }
    n = 0;
    for (n < b.instructions.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u64](?e.slots, 0);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        n = n + 1;
    }
    frame(?e);
    if (ok(?e)) { sequence(?e, region.root(res_analysed.ok)); }
    writer.plain(?w, gen_row_index.END);
    if (sel e.failed.some)  { ret err[Error].err{e.failed.some}; }
    if (sel w.refused.some) { ret err[Error].err{Error.encoding{Encoding{function: f, message: w.refused.some}}}; }
    val err_settled: err[Error] = relocation.settle(u, ?w.out, ?w.fixups);
    if (sel err_settled.err) { ret err_settled; }

    val start: usize = out.len;
    writer.locals(out, ?l.types);
    val code: usize = out.len - start;
    n = 0;
    for (n < w.fixups.len) {
        var moved: field.Fixup = w.fixups.data[n];
        moved.offset = moved.offset + code;
        val res_pushed: res[usize, allocator.Error] = vector.push[field.Fixup](fixups, moved);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        n = n + 1;
    }
    n = 0;
    for (n < e.rows.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[line.Row](rows, line.Row{at: e.rows.data[n].at + code::u64, location: e.rows.data[n].location});
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        n = n + 1;
    }
    n = 0;
    for (n < w.out.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](out, w.out.data[n]);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        n = n + 1;
    }
    if (in_constant_time(u.m.functions.data[f].data.constant_time)) { ret timed(u, f, b, ?l, ?e); }
    ret err[Error].ok{};
}

# whether every use of the address of alloca `slot` of `e`'s function is a move towards, and finally the address of, a
# load or a store `placement` places: so no access the walk does not place reaches the slot. an address an access it
# does not place takes, as one moved by an index, an atomic access's, or one used any other way, as passed to a call or
# an inline block or stored, makes it not so. an instruction taken out of the body, as a copy or fill the legalisation
# lowered, uses nothing
fun sealed_slot(e: *Emitter, slot: Instruction) bool {
    var k: usize = 0;
    for (k < e.b.instructions.len) {
        val d:    *InstructionData = ?e.b.instructions.data[k];
        val spot: Spot             = d.place;
        var n:    usize            = 0;
        if (!(sel spot.placed)) { n = d.operands.len; }
        for (n < d.operands.len) {
            val opt_from: opt[Instruction] = slots_of.slot_of(e.b, d.operands.data[n]);
            if (sel opt_from.some && opt_from.some == slot) {
                var fine: bool = false;
                if (n == 0 && (d.opcode == table.PTR_ADD || d.opcode == table.PTR_MEMBER || d.opcode == table.PTR_INDEX)) { fine = true; }
                if (n == 0 && d.opcode == table.LOAD && d.results.len == 1) {
                    val opt_load: opt[walk.Within] = placement(e, d, d.operands.data[0], natural(code_of(e, d.results.data[0]), width_of(e, d.results.data[0])));
                    fine = sel opt_load.some;
                }
                if (n == 0 && d.opcode == table.STORE && d.operands.len == 2) {
                    val opt_store: opt[walk.Within] = placement(e, d, d.operands.data[0], natural(code_of(e, d.operands.data[1]), width_of(e, d.operands.data[1])));
                    fine = sel opt_store.some;
                }
                if (!fine) { ret false; }
            }
            n = n + 1;
        }
        k = k + 1;
    }
    ret true;
}

# the frame statements of `e`'s function into `seeds`, for a constant-time function, each off its frame base: a private
# seed for each slot `sealed_slot` holds of, and for every other slot a local seed, one object a pointer into it stays
# within, with a typed seed for each range of it its alloca states public, the bytes its front end's type lays out as
# public (`metadata.Publics`). none for a function of no frame
fun frame_seeds(e: *Emitter, seeds: *vector.Vector[walk.Seed]) err[Error] {
    if (e.base == local.NONE) { ret err[Error].ok{}; }
    val origin: walk.Origin = frame_origin(e);
    var k:      usize       = 0;
    for (k < e.b.instructions.len) {
        val d:      *InstructionData = ?e.b.instructions.data[k];
        val placed: Spot             = d.place;
        k = k + 1;
        if (d.opcode != table.ALLOCA || !(sel placed.placed)) { cnt; }
        val opt_type_of: opt[Type] = type_of(d, 0);
        if (sel opt_type_of.none) { cnt; }
        val res_size: res[u64, record.Error] = layout.size(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE);
        if (sel res_size.err) { ret err[Error].err{Error.layout{res_size.err}}; }
        if (res_size.ok == 0) { cnt; }
        val at: i64 = e.slots.data[k - 1]::i64;
        if (sealed_slot(e, (k - 1)::u32)) {
            val res_private: res[usize, allocator.Error] = vector.push[walk.Seed](seeds, walk.Seed.private{walk.Private{offset: at, length: res_size.ok, origin: origin}});
            if (sel res_private.err) { ret err[Error].err{Error.alloc{res_private.err}}; }
            cnt;
        }
        val publics:   metadata.Publics            = d.metadata.publics;
        val res_local: res[usize, allocator.Error] = vector.push[walk.Seed](seeds, walk.Seed.local{walk.Local{offset: at, length: res_size.ok, stated: publics != metadata.NO_PUBLICS, origin: origin}});
        if (sel res_local.err) { ret err[Error].err{Error.alloc{res_local.err}}; }
        val res_ranges: res[Slice[Range], module.Error] = module.public_ranges(e.u.m, publics);
        if (sel res_ranges.err) { ret err[Error].err{Error.ir{res_ranges.err}}; }
        var r: usize = 0;
        for (r < res_ranges.ok.size) {
            val range:     Range                       = res_ranges.ok.data[r];
            val res_typed: res[usize, allocator.Error] = vector.push[walk.Seed](seeds, walk.Seed.typed{walk.Private{offset: at + range.offset::i64, length: range.length, origin: origin}});
            if (sel res_typed.err) { ret err[Error].err{Error.alloc{res_typed.err}}; }
            r = r + 1;
        }
    }
    ret err[Error].ok{};
}

# the extents of the frame of `e`'s function, off the local holding its base: all of it into `kept`, and each slot whose
# address its code lets out into `touched`, which a pointer argument may reach. none for a function of no frame
fun frame_extents(e: *Emitter, kept: *vector.Vector[walk.Extent], touched: *vector.Vector[walk.Extent]) err[Error] {
    if (e.base == local.NONE) { ret err[Error].ok{}; }
    val opt_base:  opt[walk.Entry]             = frame_entry(e);
    val res_whole: res[usize, allocator.Error] = vector.push[walk.Extent](kept, walk.Extent{offset: 0, length: e.frame, entry: opt_base});
    if (sel res_whole.err) { ret err[Error].err{Error.alloc{res_whole.err}}; }
    val res_found: res[slots_of.Addresses, module.Error] = slots_of.addresses(e.u.a, e.u.m, e.f);
    if (sel res_found.err) { ret err[Error].err{Error.ir{res_found.err}}; }
    var addresses: slots_of.Addresses = res_found.ok;
    fin { slots_of.addresses_dnit(?addresses); }
    var k: usize = 0;
    for (k < e.b.instructions.len) {
        val d:      *InstructionData = ?e.b.instructions.data[k];
        val placed: Spot             = d.place;
        if (d.opcode == table.ALLOCA && sel placed.placed && (slots_of.escaped(?addresses, (k::u32)) || slots_of.moved(?addresses, (k::u32)))) {
            val opt_type_of: opt[Type] = type_of(d, 0);
            if (sel opt_type_of.some) {
                val res_size: res[u64, record.Error] = layout.size(e.u.l, opt_type_of.some, type_table.DEFAULT_SPACE);
                if (sel res_size.err) { ret err[Error].err{Error.layout{res_size.err}}; }
                val res_pushed: res[usize, allocator.Error] = vector.push[walk.Extent](touched, walk.Extent{offset: e.slots.data[k]::i64, length: res_size.ok, entry: opt_base});
                if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
            }
        }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# the slot each operand of call `d` addresses (`addressed`), into `out` by the number of the operand of the call form
# it travels as, none for one that addresses none
fun call_addresses(e: *Emitter, d: *InstructionData, out: *vector.Vector[opt[timing.Addressed]]) err[allocator.Error] {
    vector.truncate[opt[timing.Addressed]](out, 0);
    val listed: *Placed = operand.places(d);
    if (listed == nil || d.operands.len == 0) { ret err[allocator.Error].ok{}; }
    var j: usize = 1;
    for (j < d.operands.len) {
        val k: usize = operand.at(listed[j - 1])::usize;
        for (out.len <= k) {
            val res_pushed: res[usize, allocator.Error] = vector.push[opt[timing.Addressed]](out, opt[timing.Addressed].none{});
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        }
        out.data[k] = addressed(e, d.operands.data[j]);
        j           = j + 1;
    }
    ret err[allocator.Error].ok{};
}

# the model of each call of `e`'s function, into `x`
fun models(u: *Unit, e: *Emitter, x: *timing.Models) err[Error] {
    var kept: vector.Vector[walk.Extent] = vector.init[walk.Extent](u.a);
    fin { vector.dnit[walk.Extent](?kept); }
    var touched: vector.Vector[walk.Extent] = vector.init[walk.Extent](u.a);
    fin { vector.dnit[walk.Extent](?touched); }
    var addresses: vector.Vector[opt[timing.Addressed]] = vector.init[opt[timing.Addressed]](u.a);
    fin { vector.dnit[opt[timing.Addressed]](?addresses); }
    val err_framed: err[Error] = frame_extents(e, ?kept, ?touched);
    if (sel err_framed.err) { ret err_framed; }
    val base: opt[walk.Entry] = frame_entry(e);
    var i:    usize           = 0;
    for (i < e.sites.len) {
        val s:           *Site                = ?e.sites.data[i];
        val err_located: err[allocator.Error] = call_addresses(e, ?e.b.instructions.data[s.call], ?addresses);
        if (sel err_located.err) { ret err[Error].err{Error.alloc{err_located.err}}; }
        val err_made: err[allocator.Error] = timing.stream_model(x, u.m, u.b, u.l, e.f, s.at, s.callee, Slice[walk.Extent]{data: kept.data, size: kept.len}, Slice[walk.Extent]{data: touched.data, size: touched.len}, base, Slice[opt[timing.Addressed]]{data: addresses.data, size: addresses.len});
        if (sel err_made.err) { ret err[Error].err{Error.alloc{err_made.err}}; }
        i = i + 1;
    }
    val err_done: err[allocator.Error] = timing.complete(x);
    if (sel err_done.err) { ret err[Error].err{Error.alloc{err_done.err}}; }
    ret err[Error].ok{};
}

# a constant-time function's code walked from its secret params, the secret ranges of every global of the module and the
# access seeds of the emitter, each call through its model: refused where the walk finds a secret where none may be, and
# warned of where wasm cannot guarantee its timing. no site places a global's address in wasm code, so an access the walk
# cannot place and no seed states reads a secret. the stale rule's row has refused a function whose own frame reads a
# slot no store reaches first, judged ahead of the structurizer (`mirl.ct.fresh`). its entry is seeded where the ir
# marks a parameter secret, which the verifier holds to its declaration (`mirl.ct.contract`)
fun timed(u: *Unit, f: Function, b: *Body, l: *Locals, e: *Emitter) err[Error] {
    val code:    *vector.Vector[u8]                  = ?e.w.out;
    val stated:  *vector.Vector[walk.Seed]           = ?e.stated;
    val err_entered: err[str] = wasm_stream.enter(u.ctx.stream, u.types.data[f]);
    if (sel err_entered.err) { ret err[Error].err{Error.encoding{Encoding{function: f, message: err_entered.err}}}; }
    var n: usize = 0;
    for (n < l.types.len) {
        val res_defined: res[u32, str] = wasm_stream.define(u.ctx.stream, wasm_kind.LOCALS, l.types.data[n], NO_NAME);
        if (sel res_defined.err) { ret err[Error].err{Error.encoding{Encoding{function: f, message: res_defined.err}}}; }
        n = n + 1;
    }
    var seeds: vector.Vector[walk.Seed] = vector.init[walk.Seed](u.a);
    fin { vector.dnit[walk.Seed](?seeds); }
    if (b.blocks.len > 0) {
        val entry: *vector.Vector[Value] = ?b.blocks.data[0].parameters;
        var j:     usize                 = 0;
        for (j < entry.len) {
            val v: Value = entry.data[j];
            if (b.values.data[v].secret) {
                val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?seeds, walk.Seed.entry{walk.Entry{space: wasm_kind.LOCALS, index: l.home.data[v]}});
                if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
            }
            j = j + 1;
        }
    }
    val err_globals: err[allocator.Error] = secret_globals.seeds(u.m, u.l, ?seeds);
    if (sel err_globals.err) { ret err[Error].err{Error.alloc{err_globals.err}}; }
    val err_framed: err[Error] = frame_seeds(e, ?seeds);
    if (sel err_framed.err) { ret err_framed; }
    var k: usize = 0;
    for (k < stated.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](?seeds, stated.data[k]);
        if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
        k = k + 1;
    }
    var reading:  head.Reading;
    val err_read: err[head.Error] = head.read(?reading, ?u.heads, u.t, b, u.ctx);
    fin { head.finish(?reading, u.ctx); }
    if (sel err_read.err) {
        val why: head.Error = err_read.err;
        if (sel why.alloc) { ret err[Error].err{Error.alloc{why.alloc}}; }
        ret err[Error].err{Error.unfollowed{ct.Unfollowed{function: f, unread: walk.Unread{message: head.fact(why), offset: 0}, location: source_at(e, 0)}}};
    }
    var x: timing.Models = timing.models_of(u.a);
    fin { timing.models_dnit(?x); }
    val err_modelled: err[Error] = models(u, e, ?x);
    if (sel err_modelled.err) { ret err_modelled; }
    val res_left: res[opt[masc_operand.Positions], allocator.Error] = timing.stream_results(u.a, u.m, u.b, u.l, Declared.function{f});
    if (sel res_left.err) { ret err[Error].err{Error.alloc{res_left.err}}; }
    var left: walk.Results = walk.NO_RESULTS;
    left.stack = res_left.ok;
    var walked:     walk.Code                       = walk.Code{set: u.b.basis.set, data: code.data, len: code.len, sites: walk.NO_SITES};
    var secrets:    walk.Secrets                    = walk.Secrets{at: seeds.data, len: seeds.len::u32};
    var declared:   walk.Declassified               = walk.Declassified{at: e.points.data, len: e.points.len::u32};
    var calls:      walk.Calls                      = walk.Calls{at: x.calls.data, len: x.calls.len::u32};
    val res_answer: res[ct.Answer, allocator.Error] = ct.check(u.a, ?walked, u.ctx, reading.context, reading.gated, u.ctx, ?secrets, ?declared, ?calls, ?left, u.m.functions.data[f].data.constant_time);
    if (sel res_answer.err) { ret err[Error].err{Error.alloc{res_answer.err}}; }
    val got: ct.Answer = res_answer.ok;
    if (sel got.refused) {
        var refused: ct.Refused = ct.refused(f, ct.Where.offset{got.refused.offset}, got.refused.refusal, source_at(e, got.refused.offset));
        if (got.refused.refusal.reason == masc_ct.UNCHECKED) { refused.callee = timing.callee_at(?x, got.refused.offset); }
        ret err[Error].err{Error.timing{refused}};
    }
    if (sel got.unread)       { ret err[Error].err{Error.unfollowed{ct.Unfollowed{function: f, unread: got.unread, location: source_at(e, got.unread.offset)}}}; }
    if (sel got.unguaranteed) { ret err[Error].err{Error.unguaranteed{ct.Unguaranteed{function: f, needs: got.unguaranteed, set: u.b.basis.set, location: ct.location(u.m, f)}}}; }
    if (sel got.warned)       { ret warn(u, f, got.warned); }
    ret err[Error].ok{};
}

# the source location of the instruction at offset `at` of the function's code: that of the last line record stated at
# or before it, none when none is, as where the module states no source files
fun source_at(e: *Emitter, at: u64) opt[Location] {
    var opt_found: opt[Location] = opt[Location].none{};
    var i:         usize         = 0;
    for (i < e.rows.len && e.rows.data[i].at <= at) {
        opt_found = e.rows.data[i].location;
        i         = i + 1;
    }
    ret opt_found;
}

# the warning that wasm cannot hold soft function `f` to constant time, with what the walk could not follow, where it
# could not, appended to the unit's warnings
fun warn(u: *Unit, f: Function, unread: opt[walk.Unread]) err[Error] {
    val held:       Warning                     = Warning.unheld{ct.Unheld{function: f, location: ct.location(u.m, f), unread: unread}};
    val res_pushed: res[usize, allocator.Error] = vector.push[Warning](u.warnings, held);
    if (sel res_pushed.err) { ret err[Error].err{Error.alloc{res_pushed.err}}; }
    ret err[Error].ok{};
}
