# the hand-over of wasm instructions to masc, one at a time
#
# every instruction is a row of masc's wasm set and its operand values,
# encoded by masc's codec under the build's context and observed by the
# stream that context holds, so a label's depth, a local, a type and a
# memory's address width are the stream's to check. mirl never encodes a
# byte: a body's locals vector and its code are masc's encoding. a writer
# keeps the first refusal and encodes nothing after it, so a run of
# instructions is checked once at its end. an index, a type or an address
# that names a symbol of a relocatable object is a symbolic operand, which
# masc writes as its site's padded zero and records a fixup of, at the
# site's offset in the writer's bytes.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.vector;

use masc.codec.walk;
use masc.core.dispatch;
use masc.core.field;
use masc.core.form;
use masc.core.inst;
use masc.core.operand;
use masc.core.state;
use masc.isa.wasm.gen_row;
use masc.isa.wasm.gen_row_index;
use wasm_leb:    masc.isa.wasm.leb;
use wasm_stream: masc.isa.wasm.stream;

# where instructions are encoded
# ---
# codec:   the codec of the build's set
# ctx:     the build's context, whose stream holds the module
# out:     the bytes of the body or expression being written
# fixups:  a fixup at the padded site of each symbolic operand, its offset
#          from the start of `out`
# observe: whether each instruction is observed by the stream, as a body's
#          are and a constant expression's are not
# refused: the first refusal, after which nothing is encoded
pub rec Writer {
    codec:   *dispatch.Codec;
    ctx:     *state.Context;
    out:     vector.Vector[u8];
    fixups:  vector.Vector[field.Fixup];
    observe: bool;
    refused: opt[str];
}

# a writer of no bytes under a context
pub fun make(a: *allocator.Allocator, codec: *dispatch.Codec, ctx: *state.Context) Writer {
    ret Writer{codec: codec, ctx: ctx, out: vector.init[u8](a), fixups: vector.init[field.Fixup](a), observe: true, refused: opt[str].none{}};
}

# give back what a writer holds
pub fun release(w: *Writer) {
    vector.dnit[u8](?w.out);
    vector.dnit[field.Fixup](?w.fixups);
}

fun refuse(w: *Writer, message: str) {
    val first: bool = sel w.refused.none;
    if (first) { w.refused = opt[str].some{message}; }
}

# the instruction of row `r` and `count` operand values at `values`
pub fun put(w: *Writer, r: u32, values: *operand.Value, count: u32) {
    if (sel w.refused.some) { ret; }
    val start: usize                     = w.out.len;
    val noted: usize                     = w.fixups.len;
    var ins:   inst.Inst                 = inst.Inst{row: ?gen_row.ROWS[r], values: values, count: count, form: form.PREFERRED};
    val done:  res[usize, field.Refusal] = walk.encode(w.codec, w.ctx, ?ins, ?w.out, ?w.fixups);
    if (sel done.err) {
        refuse(w, done.err.message);
        ret;
    }
    var k: usize = noted;
    for (k < w.fixups.len) {
        w.fixups.data[k].offset = w.fixups.data[k].offset + start;
        k                       = k + 1;
    }
    if (!w.observe) { ret; }
    val seen: err[field.Refusal] = wasm_stream.HOOKS.observe(w.ctx.stream, ?ins);
    if (sel seen.err) { refuse(w, seen.err.message); }
}

# an instruction of no operands
pub fun plain(w: *Writer, r: u32) {
    put(w, r, nil, 0);
}

# an instruction of one operand
pub fun one(w: *Writer, r: u32, value: operand.Value) {
    var v: [1]operand.Value = [1]operand.Value{value};
    put(w, r, ?v[0], 1);
}

# an instruction of one index operand: a local, a global, a function or a label's depth
pub fun index(w: *Writer, r: u32, n: u32) {
    one(w, r, operand.Value.id{n});
}

# an instruction of one immediate, a constant or a float's bits
pub fun immediate(w: *Writer, r: u32, n: i64) {
    var v: [1]operand.Value = [1]operand.Value{operand.Value.immediate{n}};
    put(w, r, ?v[0], 1);
}

pub fun i32(w: *Writer, n: i64) {
    immediate(w, gen_row_index.I32CONST, (n::u64 & 0xFFFF_FFFF)::u32:~i32::i64);
}

pub fun i64(w: *Writer, n: i64) {
    immediate(w, gen_row_index.I64CONST, n);
}

# an access of memory 0 at an offset, its alignment in bytes
pub fun memory(w: *Writer, r: u32, offset: u64, align: u64) {
    var v: [3]operand.Value = [3]operand.Value{operand.Value.none{}, operand.Value.immediate{offset::i64}, operand.Value.immediate{align::i64}};
    put(w, r, ?v[0], 3);
}

# a block, loop or if of no type
pub fun open(w: *Writer, r: u32) {
    var v: [1]operand.Value = [1]operand.Value{operand.Value.none{}};
    put(w, r, ?v[0], 1);
}

# a block, loop or if of one result of a value type
pub fun open_valued(w: *Writer, r: u32, valtype: u32) {
    var g: [2]operand.Value = [2]operand.Value{operand.Value.immediate{valtype::i64}, operand.Value.none{}};
    var v: [1]operand.Value = [1]operand.Value{operand.Value.group{operand.Values{at: ?g[0], len: 2}}};
    put(w, r, ?v[0], 1);
}

# a block, loop or if of a function type, its index or a symbol of it
pub fun open_typed(w: *Writer, r: u32, type: operand.Value) {
    var g: [2]operand.Value = [2]operand.Value{operand.Value.none{}, type};
    var v: [1]operand.Value = [1]operand.Value{operand.Value.group{operand.Values{at: ?g[0], len: 2}}};
    put(w, r, ?v[0], 1);
}

# a br_table of label depths, the default last
pub fun table(w: *Writer, a: *allocator.Allocator, depths: *vector.Vector[u32]) {
    var labels: vector.Vector[operand.Value] = vector.init[operand.Value](a);
    fin { vector.dnit[operand.Value](?labels); }
    var i: usize = 0;
    for (i < depths.len) {
        val pushed: res[usize, allocator.Error] = vector.push[operand.Value](?labels, operand.Value.id{depths.data[i]});
        if (sel pushed.err) {
            refuse(w, field.MEMORY);
            ret;
        }
        i = i + 1;
    }
    var v: [1]operand.Value = [1]operand.Value{operand.Value.list{operand.Values{at: labels.data, len: labels.len::u32}}};
    put(w, gen_row_index.BRTABLE, ?v[0], 1);
}

# an indirect call of a function type, its index or a symbol of it, through table 0
pub fun indirect(w: *Writer, type: operand.Value) {
    var v: [2]operand.Value = [2]operand.Value{type, operand.Value.none{}};
    put(w, gen_row_index.CALLINDIRECT, ?v[0], 2);
}

# a locals vector: each run of locals of one value type as its count and its
# type, encoded as masc encodes it
pub fun locals(out: *vector.Vector[u8], types: *vector.Vector[u32]) {
    var runs: u64   = 0;
    var i:    usize = 0;
    for (i < types.len) {
        if (i == 0 || types.data[i] != types.data[i - 1]) { runs = runs + 1; }
        i = i + 1;
    }
    wasm_leb.put_unsigned(out, runs);
    i = 0;
    for (i < types.len) {
        var n: usize = i;
        for (n < types.len && types.data[n] == types.data[i]) { n = n + 1; }
        wasm_leb.put_unsigned(out, (n - i)::u64);
        wasm_leb.put_unsigned(out, types.data[i]::u64);
        i = n;
    }
}
