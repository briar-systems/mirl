# the attribute schema of the spir-v family
#
# an entry point is a function with a `stage`, its execution model by the
# value spir-v gives it, and states its `entry` name when that is not its
# symbol's, the argument-less execution `modes` it runs under and, on a
# compute stage, its `workgroup` size and the dimensions of it
# `workgroup_spec` names by a specialization constant, pairs of a dimension
# and the constant's id. a global states the storage class it
# lives in by `storage`, Private when it states none, and as the interface
# its class takes: a resource its descriptor `set` and `binding`, a stage
# input or output its `location` and `component` or the `builtin` it is,
# and any argument-less `decorate` values, as Flat, NoPerspective or
# NonWritable. every value is checked against masc's enumerations of the
# spir-v grammar, so the schema states no list of its own.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;

use mo: masc.core.operand;
use masc.isa.spirv.gen_operand;

use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.attribute.Kind;
use mirl.ir.id.Constant;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.target.capability.Attached;
use mirl.target.capability.Attaches;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Entry;
use mirl.target.capability.Schema;
use mirl.target.capability.Violation;

# the family word every spir-v attribute is spelled with
pub val FAMILY: str = "spirv";

# the storage classes the schema names by their spir-v values
pub val UNIFORM_CONSTANT: u64 = 0;
pub val INPUT:            u64 = 1;
pub val UNIFORM:          u64 = 2;
pub val OUTPUT:           u64 = 3;
pub val WORKGROUP:        u64 = 4;
pub val PRIVATE:          u64 = 6;
pub val FUNCTION:         u64 = 7;
pub val PUSH_CONSTANT:    u64 = 9;
pub val IMAGE:            u64 = 11;
pub val STORAGE_BUFFER:   u64 = 12;

# the execution models a workgroup size applies to: GLCompute, Kernel,
# TaskNV, MeshNV, TaskEXT and MeshEXT
val COMPUTE: [6]u64 = [6]u64{5, 6, 0x1493, 0x1494, 0x14F4, 0x14F5};

pub val UNKNOWN_STAGE:      Violation = Violation{name: "stage", what: "a stage that is no execution model of spir-v"};
pub val NO_STAGE:           Violation = Violation{name: "entry", what: "an entry point fact on a function that states no stage"};
pub val UNKNOWN_MODE:       Violation = Violation{name: "mode", what: "a mode that is no execution mode of spir-v taking no operand"};
pub val WORKGROUP_SIZE:     Violation = Violation{name: "workgroup", what: "a workgroup size that is not three sizes of at least one"};
pub val NOT_COMPUTE:        Violation = Violation{name: "compute", what: "a workgroup size on a stage that takes none"};
pub val WORKGROUP_SPEC:     Violation = Violation{name: "workgroup_spec", what: "a specialized workgroup dimension that is not one of three, is named twice, or is named by no 32-bit integer specialization constant of the module"};
pub val UNKNOWN_STORAGE:    Violation = Violation{name: "storage", what: "a storage class the target holds no global in"};
pub val NOT_RESOURCE:       Violation = Violation{name: "resource", what: "a descriptor set or binding on a global that is no resource, or one without the other"};
pub val NOT_INTERFACE:      Violation = Violation{name: "interface", what: "a location, component or built-in on a global that is no stage input or output"};
pub val UNKNOWN_BUILTIN:    Violation = Violation{name: "builtin", what: "a built-in that is no built-in of spir-v"};
pub val LOCATED_BUILTIN:    Violation = Violation{name: "located", what: "a location on a built-in, or a component with no location"};
pub val UNKNOWN_DECORATION: Violation = Violation{name: "decoration", what: "a decoration that is no decoration of spir-v taking no operand"};

# whether a view spells a string
pub fun named(v: View, s: str) bool {
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the spir-v attribute of a name among a symbol's, none when it states none
pub fun find(list: Slice[Attribute], name: str) opt[*Attribute] {
    var i: usize = 0;
    for (i < list.size) {
        if (named(list.data[i].family, FAMILY) && named(list.data[i].name, name)) { ret opt[*Attribute].some{?list.data[i]}; }
        i = i + 1;
    }
    ret opt[*Attribute].none{};
}

# the number a symbol's attribute of a name states, none when it states none
pub fun integer(list: Slice[Attribute], name: str) opt[u64] {
    val got: opt[*Attribute] = find(list, name);
    if (sel got.none) { ret opt[u64].none{}; }
    val d: Datum = got.some.datum;
    if (sel d.integer) { ret opt[u64].some{d.integer}; }
    ret opt[u64].none{};
}

# the numbers a symbol's attribute of a name states, empty when it states none
pub fun integers(list: Slice[Attribute], name: str) Slice[u64] {
    val got: opt[*Attribute] = find(list, name);
    if (sel got.none) { ret Slice[u64]{data: nil, size: 0}; }
    val d: Datum = got.some.datum;
    if (sel d.integers) { ret d.integers; }
    ret Slice[u64]{data: nil, size: 0};
}

# the name a symbol's attribute of a name states, none when it states none
pub fun text(list: Slice[Attribute], name: str) opt[View] {
    val got: opt[*Attribute] = find(list, name);
    if (sel got.none) { ret opt[View].none{}; }
    val d: Datum = got.some.datum;
    if (sel d.text) { ret opt[View].some{d.text}; }
    ret opt[View].none{};
}

# the storage class a global lives in, Private where it states none
pub fun storage(list: Slice[Attribute]) u64 {
    val got: opt[u64] = integer(list, "storage");
    if (sel got.some) { ret got.some; }
    ret PRIVATE;
}

# whether a storage class holds resources a descriptor names
pub fun resource(class: u64) bool {
    ret class == UNIFORM_CONSTANT || class == UNIFORM || class == STORAGE_BUFFER;
}

# whether a storage class holds a stage's inputs or outputs
pub fun interface(class: u64) bool {
    ret class == INPUT || class == OUTPUT;
}

# the member of an enumeration of a value, nil when it has none
pub fun member(members: *mo.Enumerant, count: usize, value: u64) *mo.Enumerant {
    if (value > 0xFFFF_FFFF) { ret nil; }
    var i: usize = 0;
    for (i < count) {
        if (members[i].value::u64 == value) { ret ?members[i]; }
        i = i + 1;
    }
    ret nil;
}

fun plain_member(members: *mo.Enumerant, count: usize, value: u64) bool {
    val m: *mo.Enumerant = member(members, count, value);
    ret m != nil && m.params.len == 0;
}

fun violated(v: *Violation) opt[*Violation] {
    ret opt[*Violation].some{v};
}

fun kept() opt[*Violation] {
    ret opt[*Violation].none{};
}

fun number(d: Datum) u64 {
    if (sel d.integer) { ret d.integer; }
    ret 0xFFFF_FFFF_FFFF_FFFF;
}

fun numbers(d: Datum) Slice[u64] {
    if (sel d.integers) { ret d.integers; }
    ret Slice[u64]{data: nil, size: 0};
}

fun stage(a: *Attached) opt[*Violation] {
    if (member(?gen_operand.EXECUTIONMODEL_MEMBERS[0], $length_of(gen_operand.EXECUTIONMODEL_MEMBERS), number(a.datum)) == nil) { ret violated(?UNKNOWN_STAGE); }
    ret kept();
}

fun staged(a: *Attached) opt[*Violation] {
    val model: opt[u64] = integer(a.symbol, "stage");
    if (sel model.none) { ret violated(?NO_STAGE); }
    ret kept();
}

fun entry(a: *Attached) opt[*Violation] {
    ret staged(a);
}

fun modes(a: *Attached) opt[*Violation] {
    val s: opt[*Violation] = staged(a);
    if (sel s.some) { ret s; }
    val list: Slice[u64] = numbers(a.datum);
    var i:    usize      = 0;
    for (i < list.size) {
        if (!plain_member(?gen_operand.EXECUTIONMODE_MEMBERS[0], $length_of(gen_operand.EXECUTIONMODE_MEMBERS), list.data[i])) { ret violated(?UNKNOWN_MODE); }
        i = i + 1;
    }
    ret kept();
}

fun workgroup(a: *Attached) opt[*Violation] {
    val model: opt[u64] = integer(a.symbol, "stage");
    if (sel model.none) { ret violated(?NO_STAGE); }
    val list: Slice[u64] = numbers(a.datum);
    if (list.size != 3) { ret violated(?WORKGROUP_SIZE); }
    var i: usize = 0;
    for (i < 3) {
        if (list.data[i] == 0 || list.data[i] > 0xFFFF_FFFF) { ret violated(?WORKGROUP_SIZE); }
        i = i + 1;
    }
    if (!computes(model.some)) { ret violated(?NOT_COMPUTE); }
    ret kept();
}

# whether a module's specialization constant of an id is a 32-bit integer
fun word_spec(m: *module.Module, id: u64) bool {
    if (id > 0xFFFF_FFFF) { ret false; }
    val c: opt[Constant] = module.specialization(m, id::u32);
    if (sel c.none) { ret false; }
    val ty: res[Type, module.Error] = module.constant_type(m, c.some);
    if (sel ty.err) { ret false; }
    val s: res[types.Shape, types.Error] = types.shape(?m.types, ty.ok);
    if (sel s.err)           { ret false; }
    if (!(sel s.ok.integer)) { ret false; }
    ret s.ok.integer.width == 32;
}

fun workgroup_spec(a: *Attached) opt[*Violation] {
    val model: opt[u64] = integer(a.symbol, "stage");
    if (sel model.none)        { ret violated(?NO_STAGE); }
    if (!computes(model.some)) { ret violated(?NOT_COMPUTE); }
    val list: Slice[u64] = numbers(a.datum);
    if (list.size == 0 || list.size % 2 != 0 || list.size > 6) { ret violated(?WORKGROUP_SPEC); }
    var seen: [3]bool = [3]bool{false, false, false};
    var k:    usize   = 0;
    for (k + 1 < list.size) {
        val dim: u64 = list.data[k];
        if (dim > 2)                                { ret violated(?WORKGROUP_SPEC); }
        if (seen[dim::usize])                       { ret violated(?WORKGROUP_SPEC); }
        if (!word_spec(a.module, list.data[k + 1])) { ret violated(?WORKGROUP_SPEC); }
        seen[dim::usize] = true;
        k                = k + 2;
    }
    ret kept();
}

# whether an execution model takes a workgroup size
pub fun computes(model: u64) bool {
    var i: usize = 0;
    for (i < $length_of(COMPUTE)) {
        if (COMPUTE[i] == model) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun class_held(c: *Capabilities, class: u64) bool {
    if (class == FUNCTION) { ret false; }
    var i: usize = 0;
    for (i < c.widths.pointers.size) {
        if (c.widths.pointers.data[i].space::u64 == class) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun storage_check(a: *Attached) opt[*Violation] {
    val class: u64 = number(a.datum);
    if (member(?gen_operand.STORAGECLASS_MEMBERS[0], $length_of(gen_operand.STORAGECLASS_MEMBERS), class) == nil) { ret violated(?UNKNOWN_STORAGE); }
    if (!class_held(a.caps, class))                                                                               { ret violated(?UNKNOWN_STORAGE); }
    ret kept();
}

# a set and a binding come together, on a resource
fun described(a: *Attached) opt[*Violation] {
    if (!resource(storage(a.symbol))) { ret violated(?NOT_RESOURCE); }
    val set:     opt[u64] = integer(a.symbol, "set");
    val binding: opt[u64] = integer(a.symbol, "binding");
    if (sel set.none || sel binding.none) { ret violated(?NOT_RESOURCE); }
    ret kept();
}

fun location(a: *Attached) opt[*Violation] {
    if (!interface(storage(a.symbol))) { ret violated(?NOT_INTERFACE); }
    val built: opt[u64] = integer(a.symbol, "builtin");
    if (sel built.some)                { ret violated(?LOCATED_BUILTIN); }
    if (number(a.datum) > 0xFFFF_FFFF) { ret violated(?NOT_INTERFACE); }
    ret kept();
}

fun component(a: *Attached) opt[*Violation] {
    if (!interface(storage(a.symbol))) { ret violated(?NOT_INTERFACE); }
    val located: opt[u64] = integer(a.symbol, "location");
    if (sel located.none)    { ret violated(?LOCATED_BUILTIN); }
    if (number(a.datum) > 3) { ret violated(?NOT_INTERFACE); }
    ret kept();
}

fun builtin(a: *Attached) opt[*Violation] {
    if (!interface(storage(a.symbol)))                                                                            { ret violated(?NOT_INTERFACE); }
    if (member(?gen_operand.BUILTIN_MEMBERS[0], $length_of(gen_operand.BUILTIN_MEMBERS), number(a.datum)) == nil) { ret violated(?UNKNOWN_BUILTIN); }
    ret kept();
}

fun decorate(a: *Attached) opt[*Violation] {
    val list: Slice[u64] = numbers(a.datum);
    var i:    usize      = 0;
    for (i < list.size) {
        if (!plain_member(?gen_operand.DECORATION_MEMBERS[0], $length_of(gen_operand.DECORATION_MEMBERS), list.data[i])) { ret violated(?UNKNOWN_DECORATION); }
        i = i + 1;
    }
    ret kept();
}

val ENTRIES: [12]Entry = [12]Entry{
    Entry{name: "binding", datum: Kind.integer{}, attaches: Attaches.global{}, check: described},
    Entry{name: "builtin", datum: Kind.integer{}, attaches: Attaches.global{}, check: builtin},
    Entry{name: "component", datum: Kind.integer{}, attaches: Attaches.global{}, check: component},
    Entry{name: "decorate", datum: Kind.integers{}, attaches: Attaches.global{}, check: decorate},
    Entry{name: "entry", datum: Kind.text{}, attaches: Attaches.function{}, check: entry},
    Entry{name: "location", datum: Kind.integer{}, attaches: Attaches.global{}, check: location},
    Entry{name: "modes", datum: Kind.integers{}, attaches: Attaches.function{}, check: modes},
    Entry{name: "set", datum: Kind.integer{}, attaches: Attaches.global{}, check: described},
    Entry{name: "stage", datum: Kind.integer{}, attaches: Attaches.function{}, check: stage},
    Entry{name: "storage", datum: Kind.integer{}, attaches: Attaches.global{}, check: storage_check},
    Entry{name: "workgroup", datum: Kind.integers{}, attaches: Attaches.function{}, check: workgroup},
    Entry{name: "workgroup_spec", datum: Kind.integers{}, attaches: Attaches.function{}, check: workgroup_spec},
};

# the spir-v family's schema
pub val SCHEMA: Schema = Schema{family: FAMILY, entries: Slice[Entry]{data: ?ENTRIES[0], size: 12}};
