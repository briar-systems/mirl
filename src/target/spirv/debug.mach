# where a module's code came from
#
# a module whose ir names source files states them by
# NonSemantic.Shader.DebugInfo.100 where the build holds the non-semantic
# instructions, SPV_KHR_non_semantic_info or spir-v 1.6: a DebugSource per
# file under one DebugCompilationUnit, the scope every block's code opens
# and a DebugLine wherever an instruction's location changes. a build that
# holds neither states the same lines by core spir-v's OpString and OpLine.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use core_state: masc.core.state;
use masc.isa.spirv.gen_extension;
use masc.isa.spirv.gen_row_index;

use mirl.ir.debug.record.Location;
use mirl.ir.debug.record.Position;
use mirl.ir.instruction.InstructionData;
use mirl.target.spirv.buffer;
use mirl.target.spirv.buffer.Slot;
use mirl.target.spirv.emitter;
use mirl.target.spirv.emitter.Emitter;
use spirv_types: mirl.target.spirv.types;
use mirl.target.spirv.unit;
use mirl.target.spirv.unit.Lines;
use mirl.target.spirv.unit.Unit;

# the version of NonSemantic.Shader.DebugInfo.100 a compilation unit states
val VERSION: u64 = 100;

# the dwarf version its records follow
val DWARF: u64 = 5;

# the source language, unknown
val UNKNOWN: u64 = 0;

fun push(u: *Unit, v: *vector.Vector[u32], x: u32) {
    val pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel pushed.err) { unit.lost(u, pushed.err); }
}

# the strings and sources of a module's files, and how its lines are stated
pub fun open(u: *Unit) {
    val files: usize = u.m.debug.files.len;
    if (files == 0) { ret; }
    val ctx: *core_state.Context = ?u.b.basis.context;
    if (core_state.holds(ctx, gen_extension.SPV_KHR_NON_SEMANTIC_INFO) || core_state.holds(ctx, gen_extension.SPV1_6)) { u.debug.lines = Lines.semantic{}; }
    or                                                                                                                 { u.debug.lines = Lines.lines{}; }
    var k: usize = 0;
    for (k < files && unit.ok(u)) {
        val id: u32     = unit.fresh(u);
        var s:  [2]Slot = [2]Slot{Slot.id{id}, Slot.literal{unit.text(u, u.m.debug.files.data[k])}};
        unit.put(u, buffer.STRINGS, gen_row_index.OPSTRING, ?s[0], 2);
        push(u, ?u.debug.files, id);
        k = k + 1;
    }
    val semantic: Lines = u.debug.lines;
    if (!(sel semantic.semantic)) { ret; }
    u.debug.set = unit.import_of(u, View{data: "NonSemantic.Shader.DebugInfo.100", len: 32});
    val void: u32 = spirv_types.void(u);
    k = 0;
    for (k < files && unit.ok(u)) {
        val id: u32     = unit.fresh(u);
        var s:  [5]Slot = [5]Slot{Slot.id{void}, Slot.id{id}, Slot.id{u.debug.set}, Slot.id{u.debug.files.data[k]}, Slot.none{}};
        unit.put(u, buffer.TYPES, gen_row_index.OPEXTINST_NONSEMANTIC_SHADER_DEBUGINFO_100_DEBUGSOURCE, ?s[0], 5);
        push(u, ?u.debug.sources, id);
        k = k + 1;
    }
    u.debug.unit = unit.fresh(u);
    var cu: [7]Slot = [7]Slot{
        Slot.id{void},
        Slot.id{u.debug.unit},
        Slot.id{u.debug.set},
        Slot.id{spirv_types.uint(u, 32, VERSION)},
        Slot.id{spirv_types.uint(u, 32, DWARF)},
        Slot.id{u.debug.sources.data[0]},
        Slot.id{spirv_types.uint(u, 32, UNKNOWN)},
    };
    unit.put(u, buffer.TYPES, gen_row_index.OPEXTINST_NONSEMANTIC_SHADER_DEBUGINFO_100_DEBUGCOMPILATIONUNIT, ?cu[0], 7);
}

# the scope a block's code opens, the compilation unit, and no line stated yet
pub fun scope(e: *Emitter) {
    e.line = 0xFFFF_FFFF;
    val semantic: Lines = e.u.debug.lines;
    if (!(sel semantic.semantic)) { ret; }
    var s: [5]Slot = [5]Slot{Slot.id{spirv_types.void(e.u)}, Slot.id{emitter.fresh(e)}, Slot.id{e.u.debug.set}, Slot.id{e.u.debug.unit}, Slot.none{}};
    emitter.put(e, gen_row_index.OPEXTINST_NONSEMANTIC_SHADER_DEBUGINFO_100_DEBUGSCOPE, ?s[0], 5);
}

# the line an instruction came from, where it is not the last one stated
pub fun line(e: *Emitter, d: *InstructionData) {
    val stated: Lines = e.u.debug.lines;
    if (sel stated.none) { ret; }
    val loc: opt[Location] = d.metadata.location;
    if (sel loc.none) { ret; }
    val at: u32 = loc.some.index;
    if (at == e.line || at::usize >= e.u.m.debug.positions.len) { ret; }
    val p: Position = e.u.m.debug.positions.data[at];
    if (p.file.index::usize >= e.u.debug.files.len) { ret; }
    e.line = at;
    if (sel stated.lines) {
        var s: [3]Slot = [3]Slot{Slot.id{e.u.debug.files.data[p.file.index]}, Slot.immediate{p.line::i64}, Slot.immediate{p.column::i64}};
        emitter.put(e, gen_row_index.OPLINE, ?s[0], 3);
        ret;
    }
    val n: u32     = spirv_types.uint(e.u, 32, p.line::u64);
    val c: u32     = spirv_types.uint(e.u, 32, p.column::u64);
    var s: [8]Slot = [8]Slot{Slot.id{spirv_types.void(e.u)}, Slot.id{emitter.fresh(e)}, Slot.id{e.u.debug.set}, Slot.id{e.u.debug.sources.data[p.file.index]}, Slot.id{n}, Slot.id{n}, Slot.id{c}, Slot.id{c}};
    emitter.put(e, gen_row_index.OPEXTINST_NONSEMANTIC_SHADER_DEBUGINFO_100_DEBUGLINE, ?s[0], 8);
}
