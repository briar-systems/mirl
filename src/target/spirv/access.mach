# memory through logical pointers
#
# a pointer is a variable or an access chain into one, and what it points to
# is the type its variable holds or the member a chain reaches. an access at
# the type a pointer points to reads or writes it whole. one at a type the
# pointer's pointee starts with descends to it through the pointee's first
# members, a union being its largest member, and one at a scalar of the
# width of the scalar the pointee starts with reads or writes that scalar
# and casts its bits, so a union's member of another type is reached with no
# reinterpretation of memory. any other access reinterprets memory, which
# logical addressing cannot, and is refused. a value moved between a layout
# its storage class fixes and the plain one is rebuilt member by member.
#
# an f16 in memory a host shares, where the build holds no Float16, is read
# and written as the encoding the function keeps it as (mirl.legal.half), and
# the 16-bit storage capabilities reach it through a width-only conversion
# alone, never a reinterpretation (spir-v 2.16.1, "data rules"): a load
# converts it to binary32 and takes its encoding with PackHalf2x16, and a
# store makes binary32 of the encoding with UnpackHalf2x16 and converts it.
# both are exact, since binary32 holds every binary16 value.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use core_state: masc.core.state;
use masc.isa.spirv.gen_extension;
use masc.isa.spirv.gen_row_index;

use mirl.ir.constant.ConstantData;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.rule.Ordering;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.record;
use mirl.target.spirv.buffer.Slot;
use mirl.target.spirv.emitter;
use mirl.target.spirv.emitter.Emitter;
use mirl.target.spirv.emitter.Pointer;
use mirl.target.spirv.error.Error;
use mirl.target.spirv.schema;
use spirv_types: mirl.target.spirv.types;
use mirl.target.spirv.unit;
use mirl.target.spirv.unit.NONE;

# the memory access operand of a volatile access
pub val VOLATILE: u32 = 0x1;

# the memory access operand that states an access's alignment
val ALIGNED: u32 = 0x2;

# the memory access operands of an access under the vulkan memory model that
# makes its writes available or its reads visible, through a pointer it holds
# no private
val AVAILABLE:   u32 = 0x8;
val VISIBLE:     u32 = 0x10;
val NON_PRIVATE: u32 = 0x20;

# the scope of every atomic, the device
val DEVICE: u64 = 1;

# the memory semantics of an ordering and of the storage class it orders
val ACQUIRE:          u32 = 0x2;
val RELEASE:          u32 = 0x4;
val ACQUIRE_RELEASE:  u32 = 0x8;
val SEQUENTIAL:       u32 = 0x10;
val UNIFORM_MEMORY:   u32 = 0x40;
val WORKGROUP_MEMORY: u32 = 0x100;
val IMAGE_MEMORY:     u32 = 0x800;

fun same(x: Type, y: Type) bool {
    ret x == y;
}

fun reinterpreted(e: *Emitter, i: Instruction) {
    emitter.fail(e, Error.reinterpreted{emitter.at(e, i)});
}

# the pointer a value is, refused where it is chosen at run time. a physical pointer is its
# address, whatever made it
pub fun pointer_of(e: *Emitter, v: Value, i: Instruction) opt[Pointer] {
    if (spirv_types.physical(e.u, emitter.value_type(e, v))) {
        ret opt[Pointer].some{Pointer{id: emitter.id_of(e, v), pointee: 0, key: spirv_types.physical_key(e.u), class: schema.PHYSICAL_STORAGE_BUFFER::u32, known: true, declared: false, scope: opt[u32].none{}, address: true}};
    }
    val d: Def = e.b.values.data[v].def;
    if (sel d.constant) {
        val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, d.constant);
        if (sel res_constant_data.err) {
            emitter.fail(e, Error.ir{res_constant_data.err});
            ret opt[Pointer].none{};
        }
        val c: ConstantData = res_constant_data.ok;
        if (sel c.address) {
            val s: Symbol = c.address.symbol;
            if (sel s.global) {
                val g:         u32                           = s.global;
                val res_shape: res[table.Shape, table.Error] = table.shape(?e.u.m.types, c.address.type);
                if (sel res_shape.ok) {
                    val k: table.Shape = res_shape.ok;
                    if (sel k.pointer && k.pointer.space != e.u.classes.data[g]) {
                        emitter.fail(e, Error.storage{s.global});
                        ret opt[Pointer].none{};
                    }
                }
                if (c.address.offset == 0) { ret opt[Pointer].some{Pointer{id: e.u.globals.data[g], pointee: e.u.m.globals.data[g].data.type, key: e.u.keys.data[g], class: e.u.classes.data[g], known: true, declared: true, scope: e.u.scopes.data[g]}}; }
            }
        }
        emitter.unselected(e, i);
        ret opt[Pointer].none{};
    }
    val p: Pointer = e.pointers.data[v];
    if (!p.known) {
        emitter.fail(e, Error.variable{emitter.at(e, i)});
        ret opt[Pointer].none{};
    }
    ret opt[Pointer].some{p};
}

# a pointer's type
pub fun pointer_type(e: *Emitter, p: Pointer) u32 {
    val pointee: u32 = spirv_types.type_of(e.u, p.pointee, p.key);
    if (pointee == NONE) { ret NONE; }
    ret spirv_types.pointer_type(e.u, p.class, pointee);
}

# a pointer to a member of what a pointer points to, through an access chain
# of constant indices
fun chained(e: *Emitter, p: Pointer, member: Type, index: u32) Pointer {
    val q:     Pointer = Pointer{id: emitter.fresh(e), pointee: member, key: spirv_types.member_key(p.key), class: p.class, known: true, declared: false, scope: p.scope};
    val t:     u32     = pointer_type(e, q);
    var at:    [1]u32  = [1]u32{spirv_types.uint(e.u, 32, index::u64)};
    var slots: [4]Slot = [4]Slot{Slot.id{t}, Slot.id{q.id}, Slot.id{p.id}, Slot.list{unit.list(e.u, ?at[0], 1)}};
    emitter.put(e, gen_row_index.OPACCESSCHAIN, ?slots[0], 4);
    ret q;
}

# a pointer's pointee taken through a union to the member it is held as
fun held(e: *Emitter, p: Pointer) Pointer {
    var q: Pointer = p;
    var n: u32     = 0;
    for (n < 16) {
        val opt_union_member: opt[Type] = spirv_types.union_member(e.u, q.pointee, q.key);
        if (sel opt_union_member.none) { ret q; }
        q.pointee = opt_union_member.some;
        n         = n + 1;
    }
    ret q;
}

# the first member of an aggregate a pointer points to, none for any other
fun first(e: *Emitter, p: Pointer) opt[Pointer] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?e.u.m.types, p.pointee);
    if (sel res_shape.err) { ret opt[Pointer].none{}; }
    val k: table.Shape = res_shape.ok;
    if (sel k.structure) {
        val st: table.Structure = k.structure;
        if (st.members.size == 0) { ret opt[Pointer].none{}; }
        if (sel st.offsets.some) {
            val at: Slice[u64] = st.offsets.some;
            if (at.size > 0 && at.data[0] != 0) { ret opt[Pointer].none{}; }
        }
        ret opt[Pointer].some{chained(e, p, st.members.data[0], 0)};
    }
    if (sel k.array) { ret opt[Pointer].some{chained(e, p, k.array.element, 0)}; }
    ret opt[Pointer].none{};
}

# a physical pointer's address as a pointer to a type, which every type the address holds is
# reached as, since the memory a physical pointer reaches is addressed and no variable's
fun typed(e: *Emitter, p: Pointer, want: Type) opt[Pointer] {
    val t: u32 = spirv_types.physical_pointer(e.u, want);
    if (t == NONE) { ret opt[Pointer].none{}; }
    val q: Pointer = Pointer{id: emitter.fresh(e), pointee: want, key: p.key, class: p.class, known: true, declared: false, scope: opt[u32].none{}, address: false};
    emitter.one(e, gen_row_index.OPBITCAST, t, q.id, p.id);
    ret opt[Pointer].some{q};
}

# a physical pointer `q` as the address a value of it is held as, into the id `into`
fun addressed(e: *Emitter, q: Pointer, into: u32) {
    emitter.one(e, gen_row_index.OPBITCAST, spirv_types.address_type(e.u), into, q.id);
}

# a pointer to a type at the start of what a pointer points to, none where
# none starts there
pub fun reach(e: *Emitter, p: Pointer, want: Type) opt[Pointer] {
    if (p.address) { ret typed(e, p, want); }
    var q: Pointer = held(e, p);
    var n: u32     = 0;
    for (n < 16) {
        if (same(q.pointee, want))         { ret opt[Pointer].some{q}; }
        if (!descends(e, q.pointee, want)) { ret opt[Pointer].none{}; }
        val opt_down: opt[Pointer] = first(e, q);
        if (sel opt_down.none) { ret opt[Pointer].none{}; }
        q = held(e, opt_down.some);
        n = n + 1;
    }
    ret opt[Pointer].none{};
}

# whether a type starts, through first members and unions, with another
fun descends(e: *Emitter, from: Type, want: Type) bool {
    var t: Type = from;
    var n: u32  = 0;
    for (n < 16) {
        if (same(t, want)) { ret true; }
        val opt_union_member: opt[Type] = spirv_types.union_member(e.u, t, spirv_types.PLAIN);
        if (sel opt_union_member.some) { t = opt_union_member.some; }
        or {
            val opt_member_of: opt[Type] = spirv_types.member_of(e.u, t, 0);
            if (sel opt_member_of.none)                                { ret false; }
            if (spirv_types.count_of(e.u, t) == 0 && !aggregate(e, t)) { ret false; }
            t = opt_member_of.some;
        }
        n = n + 1;
    }
    ret false;
}

fun aggregate(e: *Emitter, t: Type) bool {
    val res_shape: res[table.Shape, table.Error] = table.shape(?e.u.m.types, t);
    if (sel res_shape.err) { ret false; }
    val k: table.Shape = res_shape.ok;
    ret sel k.structure || sel k.array;
}

# the scalar or vector a pointer's pointee starts with
fun leading(e: *Emitter, p: Pointer) opt[Pointer] {
    var q: Pointer = held(e, p);
    var n: u32     = 0;
    for (n < 16) {
        if (spirv_types.scalar_or_vector(e.u, q.pointee)) { ret opt[Pointer].some{q}; }
        val opt_down: opt[Pointer] = first(e, q);
        if (sel opt_down.none) { ret opt[Pointer].none{}; }
        q = held(e, opt_down.some);
        n = n + 1;
    }
    ret opt[Pointer].none{};
}

fun bits(e: *Emitter, t: Type) u32 {
    ret spirv_types.bits_of(e.u, t) * spirv_types.lanes_of(e.u, t);
}

# a value of a type held in one layout as the same value in another,
# rebuilt member by member where the layouts differ, into an id or a fresh one
pub fun coerce(e: *Emitter, id: u32, ty: Type, from: u32, to: u32, into: u32) u32 {
    val f: u32 = spirv_types.norm(e.u, ty, from);
    val t: u32 = spirv_types.norm(e.u, ty, to);
    if (f == t) {
        if (into == NONE) { ret id; }
        emitter.copy(e, spirv_types.type_of(e.u, ty, to), into, id);
        ret into;
    }
    var dest: u32 = into;
    if (dest == NONE) { dest = emitter.fresh(e); }
    val opt_held_as: opt[Type] = spirv_types.union_member(e.u, ty, from);
    if (sel opt_held_as.some) { ret coerce(e, id, opt_held_as.some, from, to, into); }
    val n: u64 = spirv_types.count_of(e.u, ty);
    if (n == 0 || n > 0xFFFF) {
        emitter.fail(e, Error.untyped{ty});
        ret NONE;
    }
    var members: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin { vector.dnit[u32](?members); }
    var k: u64 = 0;
    for (k < n && emitter.ok(e)) {
        val opt_member_of: opt[Type] = spirv_types.member_of(e.u, ty, k::u32);
        if (sel opt_member_of.none) {
            emitter.fail(e, Error.untyped{ty});
            ret NONE;
        }
        val part: u32 = emitter.fresh(e);
        emitter.extract(e, spirv_types.type_of(e.u, opt_member_of.some, spirv_types.member_key(from)), part, id, k::u32);
        val moved:      u32                         = coerce(e, part, opt_member_of.some, spirv_types.member_key(from), spirv_types.member_key(to), NONE);
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?members, moved);
        if (sel res_pushed.err) {
            emitter.lost(e, res_pushed.err);
            ret NONE;
        }
        k = k + 1;
    }
    emitter.construct(e, spirv_types.type_of(e.u, ty, to), dest, members.data, members.len);
    ret dest;
}

# the memory operands of a load or store through a pointer: Volatile where the
# access is, and under the vulkan memory model, where an access is private
# unless it says otherwise, one through a pointer that holds a scope made
# available by a store or visible to a load at that scope, as
# NonPrivatePointer: a Workgroup variable's at the Workgroup scope and a
# coherent buffer's at the QueueFamily scope
fun access(e: *Emitter, p: Pointer, d: *InstructionData, stored: bool) Slot {
    var bits: u32 = 0;
    if (d.metadata.flags.volatile)                      { bits = VOLATILE; }
    if (p.class::u64 == schema.PHYSICAL_STORAGE_BUFFER) { ret aligned(e, p, bits); }
    if (sel p.scope.none) {
        if (bits == 0) { ret Slot.none{}; }
        ret unit.enumerant(bits);
    }
    bits = bits | NON_PRIVATE;
    if (stored) { bits = bits | AVAILABLE; }
    or          { bits = bits | VISIBLE; }
    var scope: [1]Slot = [1]Slot{Slot.id{spirv_types.uint(e.u, 32, p.scope.some::u64)}};
    ret unit.enumerant_of(bits, unit.slots(e.u, ?scope[0], 1));
}

# the memory operands of an access through a physical pointer, which carries the alignment of
# what it reaches, as PhysicalStorageBuffer64 requires of every one, and is private, since no
# coherent buffer names the memory (types.md, "pointers on spir-v")
fun aligned(e: *Emitter, p: Pointer, bits: u32) Slot {
    val res_align: res[u64, record.Error] = layout.align(e.u.l, p.pointee, p.class);
    if (sel res_align.err) {
        emitter.fail(e, Error.layout{res_align.err});
        ret Slot.none{};
    }
    var at: [1]Slot = [1]Slot{Slot.immediate{res_align.ok::i64}};
    ret unit.enumerant_of(bits | ALIGNED, unit.slots(e.u, ?at[0], 1));
}

fun type_slot(d: *InstructionData, slot: usize) opt[Type] {
    if (slot >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

fun member_slot(d: *InstructionData, slot: usize) opt[u32] {
    if (slot >= d.immediates.len) { ret opt[u32].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.member) { ret opt[u32].some{imm.member}; }
    ret opt[u32].none{};
}

# a load: the value whole where the pointer points to its type, else the
# scalar of its width the pointee starts with, its bits cast
pub fun load(e: *Emitter, i: Instruction, d: *InstructionData) {
    val opt_pointer_of: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_pointer_of.none) { ret; }
    val r:         Value        = d.results.data[0];
    val want:      Type         = emitter.value_type(e, r);
    val opt_reach: opt[Pointer] = reach(e, opt_pointer_of.some, want);
    if (sel opt_reach.some) {
        val t:     u32  = spirv_types.type_of(e.u, want, opt_reach.some.key);
        var got:   u32  = e.ids.data[r];
        val moved: bool = spirv_types.norm(e.u, want, opt_reach.some.key) != spirv_types.PLAIN;
        if (moved) { got = emitter.fresh(e); }
        var slots: [4]Slot = [4]Slot{Slot.id{t}, Slot.id{got}, Slot.id{opt_reach.some.id}, access(e, opt_reach.some, d, false)};
        emitter.put(e, gen_row_index.OPLOAD, ?slots[0], 4);
        if (moved) { coerce(e, got, want, opt_reach.some.key, spirv_types.PLAIN, e.ids.data[r]); }
        ret;
    }
    val opt_scalar: opt[Pointer] = scalar(e, opt_pointer_of.some, want, i);
    if (sel opt_scalar.none) { ret; }
    val raw:   u32     = emitter.fresh(e);
    var slots: [4]Slot = [4]Slot{Slot.id{spirv_types.type_of(e.u, opt_scalar.some.pointee, opt_scalar.some.key)}, Slot.id{raw}, Slot.id{opt_scalar.some.id}, access(e, opt_scalar.some, d, false)};
    emitter.put(e, gen_row_index.OPLOAD, ?slots[0], 4);
    if (bridged(e, opt_scalar.some.pointee, want)) {
        val wide:   u32 = spirv_types.float_type(e.u, 32);
        val word:   u32 = spirv_types.int_type(e.u, 32);
        val single: u32 = emitter.fresh(e);
        emitter.one(e, gen_row_index.OPFCONVERT, wide, single, raw);
        val pair:  u32    = emitter.fresh(e);
        var lanes: [2]u32 = [2]u32{single, spirv_types.null(e.u, wide)};
        emitter.construct(e, spirv_types.vector_type(e.u, wide, 2), pair, ?lanes[0], 2);
        val packed: u32 = emitter.fresh(e);
        emitter.glsl_one(e, gen_row_index.OPEXTINST_GLSL_STD_450_PACKHALF2X16, word, packed, pair);
        emitter.one(e, gen_row_index.OPUCONVERT, emitter.type_id(e, r), e.ids.data[r], packed);
        ret;
    }
    emitter.one(e, gen_row_index.OPBITCAST, emitter.type_id(e, r), e.ids.data[r], raw);
}

# whether an access to a scalar of memory as a value of another type of its
# width takes a width-only conversion in place of a reinterpretation: an f16
# a 16-bit integer encoding reads or writes, where the build holds no Float16
fun bridged(e: *Emitter, memory: Type, value: Type) bool {
    if (!spirv_types.floating(e.u, memory) || spirv_types.floating(e.u, value))           { ret false; }
    if (spirv_types.lanes_of(e.u, memory) != 1 || spirv_types.bits_of(e.u, memory) != 16) { ret false; }
    ret !core_state.holds(?e.u.b.basis.context, gen_extension.FLOAT16);
}

# the scalar of a value's width a pointer's pointee starts with, refused as
# a reinterpretation where there is none
fun scalar(e: *Emitter, p: Pointer, want: Type, i: Instruction) opt[Pointer] {
    if (spirv_types.scalar_or_vector(e.u, want) && !spirv_types.boolean(e.u, want)) {
        val opt_leading: opt[Pointer] = leading(e, p);
        if (sel opt_leading.some) {
            val lead: Pointer = opt_leading.some;
            if (!spirv_types.boolean(e.u, lead.pointee) && bits(e, lead.pointee) == bits(e, want)) { ret opt_leading; }
        }
    }
    reinterpreted(e, i);
    ret opt[Pointer].none{};
}

# a store, as a load reaches what it writes
pub fun store(e: *Emitter, i: Instruction, d: *InstructionData) {
    val opt_pointer_of: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_pointer_of.none) { ret; }
    val v:    Value = d.operands.data[1];
    val want: Type  = emitter.value_type(e, v);
    if (spirv_types.pointer(e.u, want)) {
        emitter.fail(e, Error.untyped{want});
        ret;
    }
    val opt_reach: opt[Pointer] = reach(e, opt_pointer_of.some, want);
    if (sel opt_reach.some) {
        val moved: u32     = coerce(e, emitter.id_of(e, v), want, spirv_types.PLAIN, opt_reach.some.key, NONE);
        var slots: [3]Slot = [3]Slot{Slot.id{opt_reach.some.id}, Slot.id{moved}, access(e, opt_reach.some, d, true)};
        emitter.put(e, gen_row_index.OPSTORE, ?slots[0], 3);
        ret;
    }
    val opt_scalar: opt[Pointer] = scalar(e, opt_pointer_of.some, want, i);
    if (sel opt_scalar.none) { ret; }
    val cast:   u32 = emitter.fresh(e);
    val memory: u32 = spirv_types.type_of(e.u, opt_scalar.some.pointee, opt_scalar.some.key);
    if (bridged(e, opt_scalar.some.pointee, want)) {
        val wide: u32 = spirv_types.float_type(e.u, 32);
        val word: u32 = spirv_types.int_type(e.u, 32);
        val bits: u32 = emitter.fresh(e);
        emitter.one(e, gen_row_index.OPUCONVERT, word, bits, emitter.id_of(e, v));
        val pair: u32 = emitter.fresh(e);
        emitter.glsl_one(e, gen_row_index.OPEXTINST_GLSL_STD_450_UNPACKHALF2X16, spirv_types.vector_type(e.u, wide, 2), pair, bits);
        val single: u32 = emitter.fresh(e);
        emitter.extract(e, wide, single, pair, 0);
        emitter.one(e, gen_row_index.OPFCONVERT, memory, cast, single);
    }
    or { emitter.one(e, gen_row_index.OPBITCAST, memory, cast, emitter.id_of(e, v)); }
    var slots: [3]Slot = [3]Slot{Slot.id{opt_scalar.some.id}, Slot.id{cast}, access(e, opt_scalar.some, d, true)};
    emitter.put(e, gen_row_index.OPSTORE, ?slots[0], 3);
}

# the length a copy states, none where it is no constant
fun length_of(e: *Emitter, v: Value) opt[u64] {
    val d: Def = e.b.values.data[v].def;
    if (!(sel d.constant)) { ret opt[u64].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, d.constant);
    if (sel res_constant_data.err) { ret opt[u64].none{}; }
    val c: ConstantData = res_constant_data.ok;
    if (sel c.integer) {
        if (c.integer.words.size > 0) { ret opt[u64].some{c.integer.words.data[0]}; }
    }
    ret opt[u64].none{};
}

# a copy of a constant length, which logical addressing makes of whole
# objects only: the object its destination points to, or starts with, whose
# plain extent is the length, loaded whole from the source where the source
# reaches its type too and stored, rebuilt member by member where the two
# layouts differ. any other copy reinterprets memory and is refused
pub fun copy(e: *Emitter, i: Instruction, d: *InstructionData) {
    if (d.operands.len != 3) {
        emitter.unselected(e, i);
        ret;
    }
    val opt_length: opt[u64] = length_of(e, d.operands.data[2]);
    if (sel opt_length.none) {
        reinterpreted(e, i);
        ret;
    }
    if (opt_length.some == 0) { ret; }
    val opt_to: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_to.none) { ret; }
    val opt_from: opt[Pointer] = pointer_of(e, d.operands.data[1], i);
    if (sel opt_from.none) { ret; }
    # a physical destination has no object of its own, so the copy moves the source's
    var opt_whole: opt[Pointer] = opt[Pointer].none{};
    if (opt_to.some.address && !opt_from.some.address) {
        val opt_moved: opt[Pointer] = whole(e, opt_from.some, opt_length.some);
        if (sel opt_moved.some) { opt_whole = typed(e, opt_to.some, opt_moved.some.pointee); }
    }
    or (!opt_to.some.address) { opt_whole = whole(e, opt_to.some, opt_length.some); }
    if (sel opt_whole.none) {
        if (emitter.ok(e)) { reinterpreted(e, i); }
        ret;
    }
    val to:        Pointer      = opt_whole.some;
    val opt_reach: opt[Pointer] = reach(e, opt_from.some, to.pointee);
    if (sel opt_reach.none) {
        reinterpreted(e, i);
        ret;
    }
    val from: Pointer = opt_reach.some;
    val got:  u32     = emitter.fresh(e);
    var load: [4]Slot = [4]Slot{Slot.id{spirv_types.type_of(e.u, to.pointee, from.key)}, Slot.id{got}, Slot.id{from.id}, access(e, from, d, false)};
    emitter.put(e, gen_row_index.OPLOAD, ?load[0], 4);
    val moved: u32     = coerce(e, got, to.pointee, from.key, to.key, NONE);
    var store: [3]Slot = [3]Slot{Slot.id{to.id}, Slot.id{moved}, access(e, to, d, true)};
    emitter.put(e, gen_row_index.OPSTORE, ?store[0], 3);
}

# a fill of a constant length with zero, which logical addressing makes of
# whole objects only: a store of the null of the type its destination points
# to, or starts with, whose plain extent is the length. a fill of another
# byte, or of another length, reinterprets memory and is refused
pub fun fill(e: *Emitter, i: Instruction, d: *InstructionData) {
    if (d.operands.len != 3) {
        emitter.unselected(e, i);
        ret;
    }
    val opt_length: opt[u64] = length_of(e, d.operands.data[2]);
    if (sel opt_length.none) {
        reinterpreted(e, i);
        ret;
    }
    val opt_byte: opt[u64] = length_of(e, d.operands.data[1]);
    if (sel opt_byte.none) {
        reinterpreted(e, i);
        ret;
    }
    if (opt_byte.some != 0) {
        reinterpreted(e, i);
        ret;
    }
    if (opt_length.some == 0) { ret; }
    val opt_to: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_to.none) { ret; }
    if (opt_to.some.address) {
        reinterpreted(e, i);
        ret;
    }
    val opt_whole: opt[Pointer] = whole(e, opt_to.some, opt_length.some);
    if (sel opt_whole.none) {
        if (emitter.ok(e)) { reinterpreted(e, i); }
        ret;
    }
    val to:    Pointer = opt_whole.some;
    val zero:  u32     = spirv_types.null(e.u, spirv_types.type_of(e.u, to.pointee, to.key));
    var store: [3]Slot = [3]Slot{Slot.id{to.id}, Slot.id{zero}, access(e, to, d, true)};
    emitter.put(e, gen_row_index.OPSTORE, ?store[0], 3);
}

# a pointer to the object a pointer points to, or starts with, whose plain
# extent is a length, none where none is
fun whole(e: *Emitter, p: Pointer, length: u64) opt[Pointer] {
    var to: Pointer = held(e, p);
    var n:  u32     = 0;
    for (n < 16) {
        val res_size: res[u64, record.Error] = layout.size(e.u.l, to.pointee, schema.FUNCTION::u32);
        if (sel res_size.err) {
            emitter.fail(e, Error.layout{res_size.err});
            ret opt[Pointer].none{};
        }
        if (res_size.ok == length) { ret opt[Pointer].some{to}; }
        if (res_size.ok < length)  { ret opt[Pointer].none{}; }
        val opt_down: opt[Pointer] = first(e, to);
        if (sel opt_down.none) { ret opt[Pointer].none{}; }
        to = held(e, opt_down.some);
        n  = n + 1;
    }
    ret opt[Pointer].none{};
}

# a pointer to a member of a structure or an element of an array, by an
# access chain from a pointer to the aggregate
pub fun member(e: *Emitter, i: Instruction, d: *InstructionData) {
    val opt_type_slot: opt[Type] = type_slot(d, 0);
    val opt_index:     opt[u32]  = member_slot(d, 1);
    if (sel opt_type_slot.none) {
        emitter.unselected(e, i);
        ret;
    }
    if (sel opt_index.none) {
        emitter.unselected(e, i);
        ret;
    }
    val opt_member_of: opt[Type] = spirv_types.member_of(e.u, opt_type_slot.some, opt_index.some);
    if (sel opt_member_of.none) {
        emitter.unselected(e, i);
        ret;
    }
    val chain: u32 = spirv_types.uint(e.u, 32, opt_index.some::u64);
    chain_to(e, i, d, opt_type_slot.some, opt_member_of.some, chain);
}

# a pointer to an element of an array by a run-time index
pub fun index(e: *Emitter, i: Instruction, d: *InstructionData) {
    val opt_type_slot: opt[Type] = type_slot(d, 0);
    if (sel opt_type_slot.none) {
        emitter.unselected(e, i);
        ret;
    }
    val opt_member_of: opt[Type] = spirv_types.member_of(e.u, opt_type_slot.some, 0);
    if (sel opt_member_of.none) {
        emitter.unselected(e, i);
        ret;
    }
    chain_to(e, i, d, opt_type_slot.some, opt_member_of.some, emitter.id_of(e, d.operands.data[1]));
}

fun chain_to(e: *Emitter, i: Instruction, d: *InstructionData, aggregate: Type, member: Type, chain: u32) {
    val opt_pointer_of: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_pointer_of.none) { ret; }
    if (opt_pointer_of.some.address) {
        stepped(e, d, opt_pointer_of.some, aggregate, member, chain);
        ret;
    }
    val opt_reach: opt[Pointer] = reach(e, opt_pointer_of.some, aggregate);
    if (sel opt_reach.none) {
        reinterpreted(e, i);
        ret;
    }
    val r:     Value   = d.results.data[0];
    val made:  Pointer = Pointer{id: e.ids.data[r], pointee: member, key: spirv_types.member_key(opt_reach.some.key), class: opt_reach.some.class, known: true, declared: false, scope: opt_reach.some.scope};
    var at:    [1]u32  = [1]u32{chain};
    var slots: [4]Slot = [4]Slot{Slot.id{pointer_type(e, made)}, Slot.id{made.id}, Slot.id{opt_reach.some.id}, Slot.list{unit.list(e.u, ?at[0], 1)}};
    emitter.put(e, gen_row_index.OPACCESSCHAIN, ?slots[0], 4);
    e.pointers.data[r] = made;
}

# a member or an element through a physical pointer, itself a physical pointer held as its
# address. an element is reached by an OpPtrAccessChain stepping a pointer to it, which steps
# across whole objects as a pointer does and within an array alike, the array's stride being its
# element's; a structure's member by an access chain
fun stepped(e: *Emitter, d: *InstructionData, p: Pointer, aggregate: Type, member: Type, chain: u32) {
    val r:         Value                         = d.results.data[0];
    val res_shape: res[table.Shape, table.Error] = table.shape(?e.u.m.types, aggregate);
    if (sel res_shape.err) {
        emitter.fail(e, Error.ir{module.Error.types{res_shape.err}});
        ret;
    }
    val k: table.Shape = res_shape.ok;
    if (sel k.structure) {
        val opt_whole: opt[Pointer] = typed(e, p, aggregate);
        if (sel opt_whole.none) { ret; }
        val made:  Pointer = Pointer{id: emitter.fresh(e), pointee: member, key: p.key, class: p.class, known: true, declared: false, scope: opt[u32].none{}, address: false};
        var at:    [1]u32  = [1]u32{chain};
        var slots: [4]Slot = [4]Slot{Slot.id{spirv_types.physical_pointer(e.u, member)}, Slot.id{made.id}, Slot.id{opt_whole.some.id}, Slot.list{unit.list(e.u, ?at[0], 1)}};
        emitter.put(e, gen_row_index.OPACCESSCHAIN, ?slots[0], 4);
        addressed(e, made, e.ids.data[r]);
        ret;
    }
    val opt_first: opt[Pointer] = typed(e, p, member);
    if (sel opt_first.none) { ret; }
    val t:     u32     = spirv_types.physical_pointer(e.u, member);
    val made:  Pointer = Pointer{id: emitter.fresh(e), pointee: member, key: p.key, class: p.class, known: true, declared: false, scope: opt[u32].none{}, address: false};
    var slots: [5]Slot = [5]Slot{Slot.id{t}, Slot.id{made.id}, Slot.id{opt_first.some.id}, Slot.id{chain}, Slot.list{unit.list(e.u, nil, 0)}};
    emitter.put(e, gen_row_index.OPPTRACCESSCHAIN, ?slots[0], 5);
    addressed(e, made, e.ids.data[r]);
}

# an address read as an integer, an integer as an address, or an address a byte offset past
# another, of a physical pointer: its words as the u64 they are, which needs Int64 as any u64
# does (types.md, "pointers on spir-v"). a logical pointer has no address, which mirl's verifier
# refuses before the module is emitted
pub fun address(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32   = d.opcode;
    val r:    Value = d.results.data[0];
    val x:    Value = d.operands.data[0];
    val wide: u32   = spirv_types.int_type(e.u, 64);
    if (code == opcode_table.PTRTOINT && spirv_types.physical(e.u, emitter.value_type(e, x)) && spirv_types.bits_of(e.u, emitter.value_type(e, r)) == 64) {
        emitter.one(e, gen_row_index.OPBITCAST, wide, e.ids.data[r], emitter.id_of(e, x));
        ret;
    }
    if (code == opcode_table.INTTOPTR && spirv_types.physical(e.u, emitter.value_type(e, r)) && spirv_types.bits_of(e.u, emitter.value_type(e, x)) == 64) {
        emitter.one(e, gen_row_index.OPBITCAST, spirv_types.address_type(e.u), e.ids.data[r], emitter.id_of(e, x));
        ret;
    }
    if (code == opcode_table.PTR_ADD && d.operands.len == 2 && spirv_types.physical(e.u, emitter.value_type(e, x))) {
        val y:     Value = d.operands.data[1];
        var bytes: u32   = emitter.id_of(e, y);
        if (spirv_types.bits_of(e.u, emitter.value_type(e, y)) != 64) {
            bytes = emitter.fresh(e);
            emitter.one(e, gen_row_index.OPSCONVERT, wide, bytes, emitter.id_of(e, y));
        }
        val from: u32 = emitter.fresh(e);
        emitter.one(e, gen_row_index.OPBITCAST, wide, from, emitter.id_of(e, x));
        val sum: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPIADD, wide, sum, from, bytes);
        emitter.one(e, gen_row_index.OPBITCAST, spirv_types.address_type(e.u), e.ids.data[r], sum);
        ret;
    }
    emitter.unselected(e, i);
}

fun ordering_bits(o: Ordering) u32 {
    if (sel o.acquire) { ret ACQUIRE; }
    if (sel o.release) { ret RELEASE; }
    if (sel o.acq_rel) { ret ACQUIRE_RELEASE; }
    if (sel o.seq_cst) { ret SEQUENTIAL; }
    ret 0;
}

fun class_bits(class: u32) u32 {
    val c: u64 = class::u64;
    if (c == schema.UNIFORM || c == schema.STORAGE_BUFFER || c == 5349) { ret UNIFORM_MEMORY; }
    if (c == schema.WORKGROUP)                                          { ret WORKGROUP_MEMORY; }
    if (c == schema.IMAGE)                                              { ret IMAGE_MEMORY; }
    ret 0;
}

fun ordering_at(d: *InstructionData, slot: usize) Ordering {
    if (slot < d.immediates.len) {
        val imm: Immediate = d.immediates.data[slot];
        if (sel imm.ordering) { ret imm.ordering; }
    }
    ret Ordering.seq_cst{};
}

# the memory semantics of an ordering of an access to a storage class
fun semantics(e: *Emitter, o: Ordering, class: u32) u32 {
    val order: u32 = ordering_bits(o);
    var bits:  u32 = order;
    if (order != 0) { bits = bits | class_bits(class); }
    ret spirv_types.uint(e.u, 32, bits::u64);
}

# the device scope every atomic and fence is made at, which under the vulkan
# memory model needs VulkanMemoryModelDeviceScope
fun scope(e: *Emitter) u32 {
    spirv_types.scoped(e.u, DEVICE);
    ret spirv_types.uint(e.u, 32, DEVICE);
}

# the atomic row of a read, modify and write, NO_ROW where spir-v has none
fun update_row(code: u32) u32 {
    if (code == opcode_table.ATOMIC_ADD)  { ret gen_row_index.OPATOMICIADD; }
    if (code == opcode_table.ATOMIC_SUB)  { ret gen_row_index.OPATOMICISUB; }
    if (code == opcode_table.ATOMIC_AND)  { ret gen_row_index.OPATOMICAND; }
    if (code == opcode_table.ATOMIC_OR)   { ret gen_row_index.OPATOMICOR; }
    if (code == opcode_table.ATOMIC_XOR)  { ret gen_row_index.OPATOMICXOR; }
    if (code == opcode_table.ATOMIC_XCHG) { ret gen_row_index.OPATOMICEXCHANGE; }
    if (code == opcode_table.ATOMIC_SMAX) { ret gen_row_index.OPATOMICSMAX; }
    if (code == opcode_table.ATOMIC_SMIN) { ret gen_row_index.OPATOMICSMIN; }
    if (code == opcode_table.ATOMIC_UMAX) { ret gen_row_index.OPATOMICUMAX; }
    if (code == opcode_table.ATOMIC_UMIN) { ret gen_row_index.OPATOMICUMIN; }
    ret emitter.NO_ROW;
}

# whether an opcode is an atomic access
pub fun atomic(code: u32) bool {
    ret code == opcode_table.ATOMIC_LOAD || code == opcode_table.ATOMIC_STORE || code == opcode_table.ATOMIC_CMPXCHG || code == opcode_table.ATOMIC_NAND || update_row(code) != emitter.NO_ROW;
}

# an atomic access at the device scope, of the integer a pointer points to
pub fun atomically(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32 = d.opcode;
    if (code == opcode_table.ATOMIC_NAND) {
        emitter.unselected(e, i);
        ret;
    }
    val opt_pointer_of: opt[Pointer] = pointer_of(e, d.operands.data[0], i);
    if (sel opt_pointer_of.none) { ret; }
    var want: Type = 0;
    if (code == opcode_table.ATOMIC_LOAD) { want = emitter.value_type(e, d.results.data[0]); }
    or                                    { want = emitter.value_type(e, d.operands.data[1]); }
    val opt_reach: opt[Pointer] = reach(e, opt_pointer_of.some, want);
    if (sel opt_reach.none) {
        reinterpreted(e, i);
        ret;
    }
    val at: u32 = opt_reach.some.id;
    if (code == opcode_table.ATOMIC_LOAD) {
        val r:     Value   = d.results.data[0];
        var slots: [5]Slot = [5]Slot{Slot.id{emitter.type_id(e, r)}, Slot.id{e.ids.data[r]}, Slot.id{at}, Slot.id{scope(e)}, Slot.id{semantics(e, ordering_at(d, 1), opt_reach.some.class)}};
        emitter.put(e, gen_row_index.OPATOMICLOAD, ?slots[0], 5);
        ret;
    }
    if (code == opcode_table.ATOMIC_STORE) {
        var slots: [4]Slot = [4]Slot{Slot.id{at}, Slot.id{scope(e)}, Slot.id{semantics(e, ordering_at(d, 0), opt_reach.some.class)}, Slot.id{emitter.id_of(e, d.operands.data[1])}};
        emitter.put(e, gen_row_index.OPATOMICSTORE, ?slots[0], 4);
        ret;
    }
    if (code == opcode_table.ATOMIC_CMPXCHG) {
        val old:      Value   = d.results.data[0];
        val expected: u32     = emitter.id_of(e, d.operands.data[1]);
        var slots:    [8]Slot = [8]Slot{
            Slot.id{emitter.type_id(e, old)},
            Slot.id{e.ids.data[old]},
            Slot.id{at},
            Slot.id{scope(e)},
            Slot.id{semantics(e, ordering_at(d, 0), opt_reach.some.class)},
            Slot.id{semantics(e, ordering_at(d, 1), opt_reach.some.class)},
            Slot.id{emitter.id_of(e, d.operands.data[2])},
            Slot.id{expected},
        };
        emitter.put(e, gen_row_index.OPATOMICCOMPAREEXCHANGE, ?slots[0], 8);
        if (d.results.len > 1) {
            val ok: Value = d.results.data[1];
            emitter.two(e, gen_row_index.OPIEQUAL, emitter.type_id(e, ok), e.ids.data[ok], e.ids.data[old], expected);
        }
        ret;
    }
    val r:     Value   = d.results.data[0];
    var slots: [6]Slot = [6]Slot{Slot.id{emitter.type_id(e, r)}, Slot.id{e.ids.data[r]}, Slot.id{at}, Slot.id{scope(e)}, Slot.id{semantics(e, ordering_at(d, 0), opt_reach.some.class)}, Slot.id{emitter.id_of(e, d.operands.data[1])}};
    emitter.put(e, update_row(code), ?slots[0], 6);
}

# a fence, a barrier of the device's memory
pub fun fence(e: *Emitter, d: *InstructionData) {
    val order: u32     = ordering_bits(ordering_at(d, 0)) | UNIFORM_MEMORY | WORKGROUP_MEMORY;
    var slots: [2]Slot = [2]Slot{Slot.id{scope(e)}, Slot.id{spirv_types.uint(e.u, 32, order::u64)}};
    emitter.put(e, gen_row_index.OPMEMORYBARRIER, ?slots[0], 2);
}
