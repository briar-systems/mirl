# what the code of one function is emitted with, and the steps every
# instruction is made of
#
# every value a function defines has its id before any code is made, so a
# block parameter's OpPhi names a value its back edge carries before the
# value's instruction is reached. a pointer is no value logical addressing
# holds in memory or passes through a phi: it is the variable or access
# chain it was made by, with the type it points to, the layout that type is
# held by and its storage class.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use masc.isa.spirv.gen_row_index;

use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.structure.region.Structure;
use mirl.target.spirv.buffer;
use mirl.target.spirv.buffer.Slot;
use mirl.target.spirv.error.At;
use mirl.target.spirv.error.Error;
use spirv_types: mirl.target.spirv.types;
use mirl.target.spirv.unit;
use mirl.target.spirv.unit.NONE;
use mirl.target.spirv.unit.Unit;

# no row
pub val NO_ROW: u32 = 0xFFFF_FFFF;

# an instruction past every function's, for what is no instruction's
pub val NOWHERE: Instruction = Instruction{index: 0xFFFF_FFFF};

# a pointer as logical addressing holds it
# ---
# id:      the variable or access chain it is
# pointee: the ir type it points to
# key:     the layout that type is held by
# class:   its storage class
# known:   it is stated
pub rec Pointer {
    id:      u32;
    pointee: Type;
    key:     u32;
    class:   u32;
    known:   bool;
}

pub val UNKNOWN: Pointer = Pointer{id: NONE, pointee: Type{index: 0}, key: 0, class: 0, known: false};

# a loop the code is within
# ---
# header: its header block
# merge:  its merge block, NONE when control never leaves it
# latch:  its latch block, NONE when the header is its own
pub rec Frame {
    header: u32;
    merge:  u32;
    latch:  u32;
}

# what one function's code is made with
# ---
# u:        the module's unit
# f:        the function
# b:        its body
# s:        its region tree
# ids:      each value's id, NONE for one that is no value's of its own
# pointers: each pointer value as logical addressing holds it
# labels:   each block's label, where its phis are
# bodies:   each block's label where its code is, its label but for a loop
#           header, whose phis and loop merge stand in a block of their own
# cts:      a loop header that is its own latch's continue target, NONE for
#           any other block
# reached:  each block the region tree holds
# loops:    the loops the code is within, the innermost last
# line:     the location the last line instruction stated, past every one
#           for none
pub rec Emitter {
    u:        *Unit;
    f:        Function;
    b:        *Body;
    s:        *Structure;
    ids:      vector.Vector[u32];
    pointers: vector.Vector[Pointer];
    labels:   vector.Vector[u32];
    bodies:   vector.Vector[u32];
    cts:      vector.Vector[u32];
    reached:  vector.Vector[bool];
    loops:    vector.Vector[Frame];
    line:     u32;
}

pub fun ok(e: *Emitter) bool {
    ret unit.ok(e.u);
}

pub fun fail(e: *Emitter, why: Error) {
    unit.fail(e.u, why);
}

pub fun at(e: *Emitter, i: Instruction) At {
    ret At{function: e.f, instruction: i};
}

pub fun unselected(e: *Emitter, i: Instruction) {
    fail(e, Error.unselected{at(e, i)});
}

pub fun unstructured(e: *Emitter) {
    fail(e, Error.unstructured{e.f});
}

pub fun fresh(e: *Emitter) u32 {
    ret unit.fresh(e.u);
}

# hold an instruction of the function's code
pub fun put(e: *Emitter, row: u32, slots: *Slot, n: usize) {
    unit.put(e.u, buffer.DEFINITIONS, row, slots, n);
}

# the type of a value
pub fun value_type(e: *Emitter, v: Value) Type {
    ret e.b.values.data[v.index].type;
}

# the id of a value's type, plainly laid out
pub fun type_id(e: *Emitter, v: Value) u32 {
    ret spirv_types.type_of(e.u, value_type(e, v), spirv_types.PLAIN);
}

# the id of a value: its constant's, or the one it was given
pub fun id_of(e: *Emitter, v: Value) u32 {
    val d: Def = e.b.values.data[v.index].def;
    if (sel d.constant) { ret spirv_types.constant_of(e.u, d.constant, spirv_types.PLAIN); }
    ret e.ids.data[v.index];
}

# an integer type of a width and a lane count, made in the module's table
pub fun integer(e: *Emitter, width: u32, lanes: u32) Type {
    val scalar: res[Type, types.Error] = types.intern(?e.u.m.types, types.Shape.integer{types.Integer{width: width}});
    if (sel scalar.err) {
        fail(e, Error.ir{module.Error.types{scalar.err}});
        ret Type{index: 0};
    }
    if (lanes <= 1) { ret scalar.ok; }
    val v: res[Type, types.Error] = types.intern(?e.u.m.types, types.Shape.vector{types.Vector{lanes: lanes, element: scalar.ok}});
    if (sel v.err) {
        fail(e, Error.ir{module.Error.types{v.err}});
        ret Type{index: 0};
    }
    ret v.ok;
}

# the type a type's lanes are as integers of their width: an i1's an i32's
pub fun as_integer(e: *Emitter, ty: Type) Type {
    var w: u32 = spirv_types.bits_of(e.u, ty);
    if (w == 1) { w = 32; }
    ret integer(e, w, spirv_types.lanes_of(e.u, ty));
}

# the id of the bool type of a type's lanes
pub fun bool_of(e: *Emitter, ty: Type) u32 {
    val b:     u32 = spirv_types.bool_type(e.u);
    val lanes: u32 = spirv_types.lanes_of(e.u, ty);
    if (lanes <= 1) { ret b; }
    ret spirv_types.vector_type(e.u, b, lanes);
}

pub fun one(e: *Emitter, row: u32, t: u32, r: u32, x: u32) {
    var s: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{r}, Slot.id{x}};
    put(e, row, ?s[0], 3);
}

pub fun two(e: *Emitter, row: u32, t: u32, r: u32, x: u32, y: u32) {
    var s: [4]Slot = [4]Slot{Slot.id{t}, Slot.id{r}, Slot.id{x}, Slot.id{y}};
    put(e, row, ?s[0], 4);
}

pub fun three(e: *Emitter, row: u32, t: u32, r: u32, x: u32, y: u32, z: u32) {
    var s: [5]Slot = [5]Slot{Slot.id{t}, Slot.id{r}, Slot.id{x}, Slot.id{y}, Slot.id{z}};
    put(e, row, ?s[0], 5);
}

# the id of the GLSL.std.450 import, made when first asked for
pub fun glsl(e: *Emitter) u32 {
    if (e.u.glsl != NONE) { ret e.u.glsl; }
    val id:   u32     = fresh(e);
    val name: View    = View{data: "GLSL.std.450", len: 12};
    var s:    [2]Slot = [2]Slot{Slot.id{id}, Slot.literal{unit.text(e.u, name)}};
    unit.put(e.u, buffer.IMPORTS, gen_row_index.OPEXTINSTIMPORT, ?s[0], 2);
    e.u.glsl = id;
    ret id;
}

pub fun glsl_one(e: *Emitter, row: u32, t: u32, r: u32, x: u32) {
    var s: [4]Slot = [4]Slot{Slot.id{t}, Slot.id{r}, Slot.id{glsl(e)}, Slot.id{x}};
    put(e, row, ?s[0], 4);
}

pub fun glsl_two(e: *Emitter, row: u32, t: u32, r: u32, x: u32, y: u32) {
    var s: [5]Slot = [5]Slot{Slot.id{t}, Slot.id{r}, Slot.id{glsl(e)}, Slot.id{x}, Slot.id{y}};
    put(e, row, ?s[0], 5);
}

pub fun glsl_three(e: *Emitter, row: u32, t: u32, r: u32, x: u32, y: u32, z: u32) {
    var s: [6]Slot = [6]Slot{Slot.id{t}, Slot.id{r}, Slot.id{glsl(e)}, Slot.id{x}, Slot.id{y}, Slot.id{z}};
    put(e, row, ?s[0], 6);
}

# a member of a composite by its index
pub fun extract(e: *Emitter, t: u32, r: u32, composite: u32, index: u32) {
    var at: [1]u32  = [1]u32{index};
    var s:  [4]Slot = [4]Slot{Slot.id{t}, Slot.id{r}, Slot.id{composite}, Slot.list{unit.numbers(e.u, ?at[0], 1)}};
    put(e, row_extract(), ?s[0], 4);
}

fun row_extract() u32 {
    ret gen_row_index.OPCOMPOSITEEXTRACT;
}

# a composite of its members
pub fun construct(e: *Emitter, t: u32, r: u32, members: *u32, n: usize) {
    var s: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{r}, Slot.list{unit.list(e.u, members, n)}};
    put(e, gen_row_index.OPCOMPOSITECONSTRUCT, ?s[0], 3);
}

# a value copied into the id another value was given
pub fun copy(e: *Emitter, t: u32, r: u32, x: u32) {
    one(e, gen_row_index.OPCOPYOBJECT, t, r, x);
}

# whether every instruction a value is used by is one of an opcode, at an operand
pub fun used_only(e: *Emitter, v: Value, code: u32, operand: usize) bool {
    val uses: *vector.Vector[Instruction] = ?e.b.values.data[v.index].uses;
    var k:    usize                       = 0;
    for (k < uses.len) {
        val d: *InstructionData = ?e.b.instructions.data[uses.data[k].index];
        if (d.opcode.index != code)                                                 { ret false; }
        if (d.operands.len <= operand || d.operands.data[operand].index != v.index) { ret false; }
        var j: usize = 0;
        for (j < d.operands.len) {
            if (j != operand && d.operands.data[j].index == v.index) { ret false; }
            j = j + 1;
        }
        k = k + 1;
    }
    ret true;
}

# an allocator's refusal
pub fun lost(e: *Emitter, why: allocator.Error) {
    unit.lost(e.u, why);
}
