# the spir-v family: the targets with no registers, whose control is
# structured, whose addresses are logical and which evaluate in registers of
# their own, the values of an ssa module
#
# its build is masc's spir-v set with the target's baseline and the
# extensions a build adds, with no convention row resolved, since a call
# passes every value whole as its OpFunction states it, and its back end
# mirl.target.spirv.module, which writes one module of mink's spir-v
# container. its rows are the register family's but the aggregate and abi ones,
# after the promotion of the slots of a pointer type at every level, since
# logical addressing holds no pointer in memory: binary16 computed in binary32
# where the build holds no Float16, helpers, the float stand ins, narrow
# arithmetic widened and wide integers split, the neutral optimisations, the
# multiply forms and shift bounding, dead code removal, and the structurizer
# last, so the region tree the emitter reads is the graph as it is. it owns
# no opcode rows of its own.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mink_fail: mink.base.fail;
use mink.format.registry;
use mink.model.object;

use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.legal.floats.FLOATS;
use mirl.legal.half.HALF;
use mirl.legal.helper.HELPERS;
use mirl.legal.multiply.MULTIPLY_FORMS;
use mirl.legal.narrow.NARROW;
use mirl.legal.pool.POOL;
use mirl.legal.shift.SHIFT_BOUND;
use mirl.legal.wide.WIDE;
use mirl.pass.rows;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Step;
use mirl.pass.schedule.Verify;
use mirl.target.abi.convention.Resolved;
use mirl.target.basis;
use mirl.target.build.Build;
use mirl.target.capability.Capabilities;
use mirl.target.family.Back;
use mirl.target.family.Error;
use mirl.target.family.Family;
use mirl.target.family.Options;
use mirl.target.record.Target;
use SpirvError:   mirl.target.spirv.error.Error;
use spirv_module: mirl.target.spirv.module;
use mirl.target.spirv.slots.POINTER_SLOTS;

val SLOTS_ROW:    Row = Row{pass: ?POINTER_SLOTS, verify: Verify.changed{}};
val HALF_ROW:     Row = Row{pass: ?HALF, verify: Verify.changed{}};
val HELPERS_ROW:  Row = Row{pass: ?HELPERS, verify: Verify.changed{}};
val FLOATS_ROW:   Row = Row{pass: ?FLOATS, verify: Verify.changed{}};
val NARROW_ROW:   Row = Row{pass: ?NARROW, verify: Verify.changed{}};
val WIDE_ROW:     Row = Row{pass: ?WIDE, verify: Verify.changed{}};
val POOL_ROW:     Row = Row{pass: ?POOL, verify: Verify.changed{}};
val MULTIPLY_ROW: Row = Row{pass: ?MULTIPLY_FORMS, verify: Verify.changed{}};
val SHIFT_ROW:    Row = Row{pass: ?SHIFT_BOUND, verify: Verify.changed{}};

val STEPS: [15]Step = [15]Step{
    Step.row{?SLOTS_ROW},
    Step.row{?HALF_ROW},
    Step.row{?HELPERS_ROW},
    Step.row{?FLOATS_ROW},
    Step.row{?NARROW_ROW},
    Step.row{?WIDE_ROW},
    Step.row{?rows.FOLD_ROW},
    Step.row{?rows.ALGEBRAIC_ROW},
    Step.row{?rows.CSE_ROW},
    Step.row{?rows.LICM_ROW},
    Step.row{?POOL_ROW},
    Step.row{?MULTIPLY_ROW},
    Step.row{?SHIFT_ROW},
    Step.row{?rows.DCE_ROW},
    Step.row{?rows.STRUCTURE_ROW},
};

# no registers, structured control, logical addressing and evaluation in
# the target's own registers
fun admits(c: *Capabilities) bool {
    ret sel c.registers.none && sel c.control.structured && sel c.addressing.logical && sel c.evaluation.register;
}

# open the build: the basis and mink's formats, leaving nothing to close
# when it refuses
fun open(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val chosen: err[basis.Error] = basis.choose(?b.basis, a, t, added);
    if (sel chosen.err) { ret err[Error].err{Error.open{chosen.err}}; }
    val formats: res[registry.Registry, mink_fail.Fail] = registry.builtin(a);
    if (sel formats.err) {
        basis.drop(?b.basis);
        ret err[Error].err{Error.open{basis.Error.formats{formats.err}}};
    }
    b.formats     = formats.ok;
    b.conventions = Slice[Resolved]{data: nil, size: 0};
    b.state       = nil;
    ret err[Error].ok{};
}

fun back(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: Options) res[object.Object, Error] {
    val made: res[object.Object, SpirvError] = spirv_module.compile(a, m, b, t, o.warnings, sel o.output.object);
    if (sel made.err) { ret res[object.Object, Error].err{Error.back{Back.spirv{made.err}}}; }
    ret res[object.Object, Error].ok{made.ok};
}

fun close(b: *Build) {
    registry.release(?b.formats);
    basis.drop(?b.basis);
}

# the spir-v family
pub val FAMILY: Family = Family{
    name:    "spirv",
    admits:  admits,
    legal:   Slice[Step]{data: ?STEPS[0], size: 15},
    open:    open,
    back:    back,
    close:   close,
    opcodes: Slice[*opcode.Row]{data: nil, size: 0},
};
