# the spir-v target rows

use std.collections.slice.Slice;

use ir: mirl.ir.opcode;
use mirl.ir.type.format.BINARY16;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.target.abi.convention.Declared;
use mirl.target.address.Addresses;
use mirl.target.capability;
use mirl.target.capability.Addressing;
use mirl.target.capability.Align;
use mirl.target.capability.Arithmetic;
use mirl.target.capability.Attributes;
use mirl.target.capability.Bits;
use mirl.target.capability.Bulk;
use mirl.target.capability.BulkMemory;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Code;
use mirl.target.capability.Condition;
use mirl.target.capability.Constants;
use mirl.target.capability.Control;
use mirl.target.capability.Counts;
use mirl.target.capability.Data;
use mirl.target.capability.Division;
use mirl.target.capability.Evaluation;
use mirl.target.capability.Fault;
use mirl.target.capability.Fill;
use mirl.target.capability.FloatLayout;
use mirl.target.capability.Form;
use mirl.target.capability.Formats;
use mirl.target.capability.Functions;
use mirl.target.capability.Held;
use mirl.target.capability.IntegerLayout;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.LongDivision;
use mirl.target.capability.Nans;
use mirl.target.capability.Native;
use mirl.target.capability.Natives;
use mirl.target.capability.Pointer;
use mirl.target.capability.Products;
use mirl.target.capability.Registers;
use mirl.target.capability.Rules;
use mirl.target.capability.Scalar;
use mirl.target.capability.Set;
use mirl.target.capability.Shifts;
use mirl.target.capability.Single;
use mirl.target.capability.Space;
use mirl.target.capability.Timing;
use mirl.target.capability.Unit;
use mirl.target.capability.Values;
use mirl.target.capability.VectorRule;
use mirl.target.capability.Vectors;
use mirl.target.capability.Widths;
use mirl.target.record.Baseline;
use mirl.target.record.Target;

# spir-v for vulkan: logical pointers, with PhysicalStorageBuffer physical. a
# Uniform block is laid out by extended alignment and PushConstant,
# StorageBuffer and PhysicalStorageBuffer by base alignment, as vulkan requires
# with no layout feature enabled. vulkan fixes no layout of the other storage
# classes, so they keep the target's own
val SPIRV_POINTERS: [10]Space = [10]Space{
    Space{space: 0, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 1, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 2, pointer: Pointer.logical{}, layout: Rules.std140{}},
    Space{space: 3, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 4, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 7, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 9, pointer: Pointer.logical{}, layout: Rules.std430{}},
    Space{space: 11, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 12, pointer: Pointer.logical{}, layout: Rules.std430{}},
    Space{space: 5349, pointer: Pointer.physical{Scalar{size: 8, align: 8}}, layout: Rules.std430{}},
};
val SPIRV_ALU:      [2]u32 = [2]u32{32, 64};
val SPIRV_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
val SPIRV_COUNTS:   [3]u32 = [3]u32{2, 3, 4};
# NMin, NMax, Floor, Ceil, Trunc, RoundEven and OpSelect. FMin and FMax are
# undefined for a nan, and OpFRem is held to the precision of x - y * trunc(x/y)
# under vulkan, so it is not the exact remainder
val SPIRV_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};
# a constant is an operand of the module
val SPIRV_HELD: [3]Held = [3]Held{
    Held{format: ?BINARY16, condition: Condition.always{}, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: Condition.always{}, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: Condition.always{}, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
};
val SPIRV_LANES: [7]Lane = [7]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY16}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# i1 is one byte in memory, and wider integers are legalised to arrays of i64
val SPIRV_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 8}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val SPIRV_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# spir-v for vulkan. no clang targets it, so its layout has no golden entries
pub val SPIRV_VULKAN: Target = Target{
    arch:   "spirv",
    system: "vulkan",
    caps:   Capabilities{
        registers:  Registers.none{},
        control:    Control.structured{},
        addressing: Addressing.logical{},
        functions:  Functions.addresses{},
        values:     Values.typed{},
        evaluation: Evaluation.register{},
        widths:     Widths{
            pointers: Slice[Space]{data: ?SPIRV_POINTERS[0], size: 10},
            register: Bits.none{},
            alu:      Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
            integers: Set.widths{Slice[u32]{data: ?SPIRV_INTEGERS[0], size: 4}},
        },
        vectors: Vectors.unit{Unit{
            width:  Bits.none{},
            counts: Counts.listed{Slice[u32]{data: ?SPIRV_COUNTS[0], size: 3}},
            lanes:  Slice[Lane]{data: ?SPIRV_LANES[0], size: 7},
        }},
        formats:    Formats.held{Slice[Held]{data: ?SPIRV_HELD[0], size: 3}},
        arithmetic: Arithmetic{
            multiply:   Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
            multiplied: Condition.always{},
            products:   Products.none{},
            shifts:     Shifts.undefined{},
            single:     Single.none{},
            # a division by zero or an overflowing one gives an undefined value
            division: Division{widths: Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
        },
        # a sized copy needs the addresses capability vulkan does not have
        bulk:   BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}},
        timing: Timing.none{},
        code:   Code{
            function: Align.none{},
            text:     Align.none{},
            data:     Align.none{},
            fill:     Fill.none{},
        },
        attributes: Attributes.none{},
    },
    data: Data{
        integers: Slice[IntegerLayout]{data: ?SPIRV_INTEGER_LAYOUT[0], size: 8},
        floats:   Slice[FloatLayout]{data: ?SPIRV_FLOAT_LAYOUT[0], size: 3},
        # vulkan scalar block layout: a vector aligns to its component
        vectors: VectorRule.element{},
    },
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
};
