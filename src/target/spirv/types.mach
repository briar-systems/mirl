# the types, constants and global variables of a module
#
# a scalar, vector, pointer or function type is declared once by its shape,
# as spir-v allows no two of them alike. an aggregate is declared once for
# each layout it is held by: plainly, where its storage class fixes no
# layout, or with the offsets and strides the target's data layout gives it
# in a class that does, as a Uniform, PushConstant or StorageBuffer block's,
# whose variable's own type is decorated as the Block it is. a layout is
# named by its key, the class it is laid out in shifted up two, whether it is
# laid out and whether it is a block, so the layout of a member is its
# aggregate's without the block. a type that holds no aggregate has one
# layout, whatever key it is asked for by.
#
# an integer type is unsigned and its signedness is the instruction's, an i1
# is a bool, and a union is held as its largest member, the first of those
# alike, since logical addressing reinterprets no memory. a width of an
# integer or float that core spir-v does not hold needs its capability,
# which the module then declares.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.core.index;
use mo:   masc.core.operand;
use mrow: masc.core.row;
use masc.isa.spirv.gen_extension;
use masc.isa.spirv.gen_row;
use masc.isa.spirv.gen_row_index;

use mirl.ir.attribute.Attribute;
use mirl.ir.constant.ConstantData;
use mirl.ir.constant.Spec;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.id.Constant;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.module;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.type.format;
use mirl.target.capability.Minted;
use mirl.target.capability.Rules;
use mirl.target.capability.minted;
use mirl.target.layout;
use mirl.target.record;
use mirl.target.spirv.buffer;
use mirl.target.spirv.buffer.Slot;
use mirl.target.spirv.buffer.Span;
use mirl.target.spirv.error.Error;
use mirl.target.spirv.schema;
use mirl.target.spirv.unit;
use mirl.target.spirv.unit.Made;
use mirl.target.spirv.unit.NONE;
use mirl.target.spirv.unit.Shape;
use mirl.target.spirv.unit.Special;
use mirl.target.spirv.unit.Unit;

# the decorations the family states by their spir-v values
pub val BLOCK:              u32 = 2;
pub val ARRAY_STRIDE:       u32 = 6;
pub val BUILT_IN:           u32 = 11;
pub val LOCATION:           u32 = 30;
pub val COMPONENT:          u32 = 31;
pub val BINDING:            u32 = 33;
pub val DESCRIPTOR_SET:     u32 = 34;
pub val OFFSET:             u32 = 35;
pub val LINKAGE_ATTRIBUTES: u32 = 41;
pub val SPEC_ID:            u32 = 1;

# the plain layout, of a class that fixes none
pub val PLAIN: u32 = 0;

val LAID:      u32 = 1;
val BLOCK_BIT: u32 = 2;

# the layout key of the storage class of a pointer, laid out where the
# target's row of its space states vulkan's rules
pub fun laid(u: *Unit, class: u32) u32 {
    var i: usize = 0;
    for (i < u.t.caps.widths.pointers.size) {
        if (u.t.caps.widths.pointers.data[i].space == class) {
            val r: Rules = u.t.caps.widths.pointers.data[i].layout;
            if (sel r.std140 || sel r.std430 || sel r.scalar) { ret (class << 2) | LAID; }
            ret PLAIN;
        }
        i = i + 1;
    }
    ret PLAIN;
}

# whether a storage class holds blocks: a uniform, push constant or storage buffer
pub fun blocked(class: u32) bool {
    ret class::u64 == schema.UNIFORM || class::u64 == schema.PUSH_CONSTANT || class::u64 == schema.STORAGE_BUFFER;
}

# the layout key of what a global variable of a class holds
pub fun variable_key(u: *Unit, class: u32) u32 {
    val k: u32 = laid(u, class);
    if (blocked(class) && k != PLAIN) { ret k | BLOCK_BIT; }
    ret k;
}

# the layout of a member of an aggregate of a layout
pub fun member_key(key: u32) u32 {
    ret key & ~BLOCK_BIT;
}

fun space_of(key: u32) u32 {
    ret key >> 2;
}

fun shape(u: *Unit, ty: Type) opt[types.Shape] {
    val got: res[types.Shape, types.Error] = types.shape(?u.m.types, ty);
    if (sel got.err) {
        unit.fail(u, Error.ir{module.Error.types{got.err}});
        ret opt[types.Shape].none{};
    }
    ret opt[types.Shape].some{got.ok};
}

# whether a type holds an aggregate, so its layout matters
pub fun holds_layout(u: *Unit, ty: Type) bool {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret false; }
    val k: types.Shape = s.some;
    if (sel k.structure || sel k.array) { ret true; }
    if (sel k.union) {
        val m: opt[Type] = union_member(u, ty, PLAIN);
        if (sel m.some) { ret holds_layout(u, m.some); }
    }
    ret false;
}

# the key a type is laid out by: its own where it holds an aggregate, plain
# where its layout does not matter
pub fun norm(u: *Unit, ty: Type, key: u32) u32 {
    if (holds_layout(u, ty)) { ret key; }
    ret PLAIN;
}

# the member of a union it is held as: its largest, the first of those alike
pub fun union_member(u: *Unit, ty: Type, key: u32) opt[Type] {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret opt[Type].none{}; }
    val k: types.Shape = s.some;
    if (!(sel k.union)) { ret opt[Type].none{}; }
    val members: Slice[Type] = k.union.members;
    if (members.size == 0) { ret opt[Type].none{}; }
    var best: usize = 0;
    var most: u64   = 0;
    var i:    usize = 0;
    for (i < members.size) {
        val size: res[u64, record.Error] = layout.size(u.l, members.data[i], space_of(key));
        if (sel size.err) {
            unit.fail(u, Error.layout{size.err});
            ret opt[Type].none{};
        }
        if (i == 0 || size.ok > most) {
            best = i;
            most = size.ok;
        }
        i = i + 1;
    }
    ret opt[Type].some{members.data[best]};
}

# the type of a member of an aggregate or a lane of a vector
pub fun member_of(u: *Unit, ty: Type, index: u32) opt[Type] {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret opt[Type].none{}; }
    val k: types.Shape = s.some;
    if (sel k.structure) {
        if (index::usize < k.structure.members.size) { ret opt[Type].some{k.structure.members.data[index]}; }
        ret opt[Type].none{};
    }
    if (sel k.array)  { ret opt[Type].some{k.array.element}; }
    if (sel k.vector) { ret opt[Type].some{k.vector.element}; }
    ret opt[Type].none{};
}

# the number of members of an aggregate or lanes of a vector, 0 for any other
pub fun count_of(u: *Unit, ty: Type) u64 {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret 0; }
    val k: types.Shape = s.some;
    if (sel k.structure) { ret k.structure.members.size::u64; }
    if (sel k.array)     { ret k.array.count; }
    if (sel k.vector)    { ret k.vector.lanes::u64; }
    ret 0;
}

# the bits of an integer or float type, of the lane of a vector, 0 for any other
pub fun bits_of(u: *Unit, ty: Type) u32 {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret 0; }
    val k: types.Shape = s.some;
    if (sel k.integer) { ret k.integer.width; }
    if (sel k.float) {
        val r: opt[format.Row] = format.row(k.float.format);
        if (sel r.some) { ret r.some.width; }
        ret 0;
    }
    if (sel k.vector) { ret bits_of(u, k.vector.element); }
    ret 0;
}

# whether a type is a float or a vector of floats
pub fun floating(u: *Unit, ty: Type) bool {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret false; }
    val k: types.Shape = s.some;
    if (sel k.float)  { ret true; }
    if (sel k.vector) { ret floating(u, k.vector.element); }
    ret false;
}

# whether a type is an i1 or a vector of them, a bool in spir-v
pub fun boolean(u: *Unit, ty: Type) bool {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret false; }
    val k: types.Shape = s.some;
    if (sel k.integer) { ret k.integer.width == 1; }
    if (sel k.vector)  { ret boolean(u, k.vector.element); }
    ret false;
}

# whether a type is a pointer
pub fun pointer(u: *Unit, ty: Type) bool {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret false; }
    val k: types.Shape = s.some;
    ret sel k.pointer;
}

# whether a type is an integer, a float or a vector of either
pub fun scalar_or_vector(u: *Unit, ty: Type) bool {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret false; }
    val k: types.Shape = s.some;
    ret sel k.integer || sel k.float || sel k.vector;
}

# the lanes of a vector type, 1 for any other
pub fun lanes_of(u: *Unit, ty: Type) u32 {
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret 1; }
    val k: types.Shape = s.some;
    if (sel k.vector) { ret k.vector.lanes; }
    ret 1;
}

# the id of a type declared once by its shape, made by `declare` when no
# shape alike is held
fun shaped(u: *Unit, row: u32, a: u32, b: u32, list: *u32, n: usize) opt[u32] {
    var i: usize = 0;
    for (i < u.shapes.len) {
        val s: *Shape = ?u.shapes.data[i];
        if (s.row == row && s.a == a && s.b == b && s.list.len::usize == n) {
            var same: bool  = true;
            var k:    usize = 0;
            for (k < n && same) {
                if (u.lists.data[s.list.at + k::u32] != list[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret opt[u32].some{s.id}; }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun remember(u: *Unit, row: u32, a: u32, b: u32, list: *u32, n: usize, id: u32) {
    val kept:   Span                        = unit.keep_list(u, list, n);
    val pushed: res[usize, allocator.Error] = vector.push[Shape](?u.shapes, Shape{row: row, a: a, b: b, list: kept, id: id});
    if (sel pushed.err) { unit.lost(u, pushed.err); }
}

# a type of no operands, void or bool
fun bare(u: *Unit, row: u32) u32 {
    val got: opt[u32] = shaped(u, row, 0, 0, nil, 0);
    if (sel got.some) { ret got.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [1]Slot = [1]Slot{Slot.id{id}};
    unit.put(u, buffer.TYPES, row, ?slots[0], 1);
    remember(u, row, 0, 0, nil, 0, id);
    ret id;
}

pub fun void(u: *Unit) u32 {
    ret bare(u, gen_row_index.OPTYPEVOID);
}

pub fun bool_type(u: *Unit) u32 {
    ret bare(u, gen_row_index.OPTYPEBOOL);
}

# an unsigned integer type of a width, which needs its capability past core's 32
pub fun int_type(u: *Unit, width: u32) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPEINT, width, 0, nil, 0);
    if (sel got.some) { ret got.some; }
    if (width == 8)   { unit.need(u, gen_extension.INT8); }
    if (width == 16)  { unit.need(u, gen_extension.INT16); }
    if (width == 64)  { unit.need(u, gen_extension.INT64); }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{width::i64}, Slot.immediate{0}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEINT, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEINT, width, 0, nil, 0, id);
    ret id;
}

# a float type of a width, which needs its capability past core's 32
pub fun float_type(u: *Unit, width: u32) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPEFLOAT, width, 0, nil, 0);
    if (sel got.some) { ret got.some; }
    if (width == 16) {
        unit.need(u, gen_extension.FLOAT16);
        u.floats = u.floats | 1;
    }
    if (width == 32) { u.floats = u.floats | 2; }
    if (width == 64) {
        unit.need(u, gen_extension.FLOAT64);
        u.floats = u.floats | 4;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{width::i64}, Slot.none{}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEFLOAT, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEFLOAT, width, 0, nil, 0, id);
    ret id;
}

pub fun vector_type(u: *Unit, element: u32, lanes: u32) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPEVECTOR, element, lanes, nil, 0);
    if (sel got.some) { ret got.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.id{element}, Slot.immediate{lanes::i64}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEVECTOR, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEVECTOR, element, lanes, nil, 0, id);
    ret id;
}

# a pointer into a storage class to a type
pub fun pointer_type(u: *Unit, class: u32, pointee: u32) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPEPOINTER, class, pointee, nil, 0);
    if (sel got.some) { ret got.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, unit.enumerant(class), Slot.id{pointee}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEPOINTER, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEPOINTER, class, pointee, nil, 0, id);
    ret id;
}

# a function type of a result type and parameter types
pub fun function_type(u: *Unit, result: u32, params: *u32, n: usize) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPEFUNCTION, result, 0, params, n);
    if (sel got.some) { ret got.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.id{result}, Slot.list{unit.list(u, params, n)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEFUNCTION, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEFUNCTION, result, 0, params, n, id);
    ret id;
}

# a decoration of an id with no params or one number
pub fun decorate(u: *Unit, id: u32, decoration: u32) {
    var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant(decoration)};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
}

pub fun decorate_number(u: *Unit, id: u32, decoration: u32, n: u64) {
    var value: [1]Slot = [1]Slot{Slot.immediate{n::i64}};
    var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(decoration, unit.slots(u, ?value[0], 1))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
}

fun member_offset(u: *Unit, id: u32, member: u32, n: u64) {
    var value: [1]Slot = [1]Slot{Slot.immediate{n::i64}};
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{member::i64}, unit.enumerant_of(OFFSET, unit.slots(u, ?value[0], 1))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPMEMBERDECORATE, ?slots[0], 3);
}

fun cached(u: *Unit, ty: Type, key: u32) opt[u32] {
    var k:   u64       = unit.cache_key(ty, key);
    val got: opt[*u32] = map.get[u64, u32](?u.types, ?k);
    if (sel got.some) { ret opt[u32].some{@got.some}; }
    ret opt[u32].none{};
}

fun cache(u: *Unit, ty: Type, key: u32, id: u32) {
    val put: res[bool, allocator.Error] = map.insert[u64, u32](?u.types, unit.cache_key(ty, key), id);
    if (sel put.err) { unit.lost(u, put.err); }
}

# the id of an ir type in a layout, NONE where spir-v has no form of it,
# which is refused
pub fun type_of(u: *Unit, ty: Type, key: u32) u32 {
    if (!unit.ok(u)) { ret NONE; }
    val k:    u32      = norm(u, ty, key);
    val hold: opt[u32] = cached(u, ty, k);
    if (sel hold.some) { ret hold.some; }
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret NONE; }
    val sh: types.Shape = s.some;
    var id: u32         = NONE;
    if (sel sh.integer) {
        if (sh.integer.width == 1)  { id = bool_type(u); }
        or (sh.integer.width <= 64) { id = int_type(u, sh.integer.width); }
    }
    or (sel sh.float) {
        val r: opt[format.Row] = format.row(sh.float.format);
        if (sel r.some) { id = float_type(u, r.some.width); }
    }
    or (sel sh.vector) {
        if (sh.vector.lanes >= 2 && sh.vector.lanes <= 4) {
            val e: u32 = type_of(u, sh.vector.element, PLAIN);
            if (e != NONE) { id = vector_type(u, e, sh.vector.lanes); }
        }
    }
    or (sel sh.array)     { id = array(u, ty, sh.array, k); }
    or (sel sh.structure) { id = structure(u, sh.structure, k, ty); }
    or (sel sh.union) {
        val m: opt[Type] = union_member(u, ty, k);
        if (sel m.some) { id = type_of(u, m.some, k); }
    }
    or (sel sh.handle) { id = handle_type(u, sh.handle); }
    if (id == NONE) {
        unit.fail(u, Error.untyped{ty});
        ret NONE;
    }
    cache(u, ty, k, id);
    ret id;
}

# the id of a handle type: the type its kind's row of masc's set makes, each
# operand the row's own after its result in order, a type by its id and a
# word as the row's operand takes it, a 32-bit unsigned constant where it
# takes an id. NONE where the target mints no such kind or the row takes
# none of an operand's shape
fun handle_type(u: *Unit, h: types.Handle) u32 {
    val kind: opt[*Minted] = minted(u.t.caps.handles, h.kind);
    if (sel kind.none) { ret NONE; }
    var keys:  index.Index = index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT};
    val found: opt[u32]    = index.find(?keys, kind.some.key);
    if (sel found.none) { ret NONE; }
    val row: *mrow.Row = ?gen_row.ROWS[found.some];
    if (h.operands.size + 1 > r_len(row)::usize) { ret NONE; }
    var ids: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?ids); }
    var slots: vector.Vector[Slot] = vector.init[Slot](u.a);
    fin { vector.dnit[Slot](?slots); }
    keep_slot(u, ?slots, Slot.id{NONE});
    var i: usize = 0;
    for (i < h.operands.size && unit.ok(u)) {
        val x:    *mo.Operand         = ?row.operands.at[i + 1];
        val o:    types.HandleOperand = h.operands.data[i];
        var at:   Slot                = Slot.none{};
        var word: u32                 = 0;
        if (sel o.typed) {
            if (!(sel x.shape.id)) { ret NONE; }
            word = type_of(u, o.typed, PLAIN);
            if (word == NONE) { ret NONE; }
            at = Slot.id{word};
        }
        if (sel o.word) {
            word = o.word;
            if (sel x.shape.id)        { at = Slot.id{uint(u, 32, o.word::u64)}; }
            or (sel x.shape.enumerant) { at = unit.enumerant(o.word); }
            or (sel x.shape.immediate) { at = Slot.immediate{o.word::i64}; }
            or (sel x.shape.literal)   { at = Slot.literal{unit.words(u, o.word::u64, 1)}; }
            or                         { ret NONE; }
            if (sel x.shape.id)        { word = slot_id(at); }
        }
        keep_slot(u, ?slots, at);
        val pushed: res[usize, allocator.Error] = vector.push[u32](?ids, word);
        if (sel pushed.err) { unit.lost(u, pushed.err); }
        i = i + 1;
    }
    if (!unit.ok(u)) { ret NONE; }
    for (slots.len < r_len(row)::usize) { keep_slot(u, ?slots, Slot.none{}); }
    val got: opt[u32] = shaped(u, row.index, h.operands.size::u32, 0, ids.data, ids.len);
    if (sel got.some) { ret got.some; }
    val id: u32 = unit.fresh(u);
    slots.data[0] = Slot.id{id};
    unit.put(u, buffer.TYPES, row.index, slots.data, slots.len);
    remember(u, row.index, h.operands.size::u32, 0, ids.data, ids.len, id);
    ret id;
}

fun r_len(r: *mrow.Row) u32 {
    ret r.operands.len;
}

fun slot_id(s: Slot) u32 {
    if (sel s.id) { ret s.id; }
    ret NONE;
}

fun keep_slot(u: *Unit, v: *vector.Vector[Slot], s: Slot) {
    val pushed: res[usize, allocator.Error] = vector.push[Slot](v, s);
    if (sel pushed.err) { unit.lost(u, pushed.err); }
}

fun array(u: *Unit, ty: Type, a: types.Array, key: u32) u32 {
    val element: u32 = type_of(u, a.element, member_key(key));
    if (element == NONE) { ret NONE; }
    val laid_out: bool = (key & LAID) != 0;
    val id:       u32  = unit.fresh(u);
    if (a.count == 0) {
        if (!laid_out) { ret NONE; }
        var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.id{element}};
        unit.put(u, buffer.TYPES, gen_row_index.OPTYPERUNTIMEARRAY, ?slots[0], 2);
    }
    or {
        if (a.count > 0xFFFF_FFFF) { ret NONE; }
        val length: u32     = uint(u, 32, a.count);
        var slots:  [3]Slot = [3]Slot{Slot.id{id}, Slot.id{element}, Slot.id{length}};
        unit.put(u, buffer.TYPES, gen_row_index.OPTYPEARRAY, ?slots[0], 3);
    }
    if (laid_out) {
        val step: res[u64, record.Error] = layout.stride(u.l, ty, space_of(key));
        if (sel step.err) {
            unit.fail(u, Error.layout{step.err});
            ret NONE;
        }
        decorate_number(u, id, ARRAY_STRIDE, step.ok);
    }
    ret id;
}

fun structure(u: *Unit, s: types.Structure, key: u32, ty: Type) u32 {
    var members: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?members); }
    var i: usize = 0;
    for (i < s.members.size) {
        val m: u32 = type_of(u, s.members.data[i], member_key(key));
        if (m == NONE) { ret NONE; }
        val pushed: res[usize, allocator.Error] = vector.push[u32](?members, m);
        if (sel pushed.err) {
            unit.lost(u, pushed.err);
            ret NONE;
        }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.list{unit.list(u, members.data, members.len)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPESTRUCT, ?slots[0], 2);
    if ((key & LAID) != 0) {
        i = 0;
        for (i < s.members.size) {
            val at: res[u64, record.Error] = layout.offset(u.l, ty, space_of(key), i::u32);
            if (sel at.err) {
                unit.fail(u, Error.layout{at.err});
                ret NONE;
            }
            member_offset(u, id, i::u32, at.ok);
            i = i + 1;
        }
    }
    if ((key & BLOCK_BIT) != 0) { decorate(u, id, BLOCK); }
    ret id;
}

# a scalar constant of a type by its bits, made once
pub fun made(u: *Unit, type: u32, value: u64, words: u32) u32 {
    var i: usize = 0;
    for (i < u.made.len) {
        if (u.made.data[i].type == type && u.made.data[i].value == value) { ret u.made.data[i].id; }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{type}, Slot.id{id}, Slot.literal{unit.words(u, value, words)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANT, ?slots[0], 3);
    val pushed: res[usize, allocator.Error] = vector.push[Made](?u.made, Made{type: type, value: value, id: id});
    if (sel pushed.err) { unit.lost(u, pushed.err); }
    ret id;
}

fun words_of(width: u32) u32 {
    ret (width + 31) / 32;
}

# an unsigned integer constant of a width
pub fun uint(u: *Unit, width: u32, value: u64) u32 {
    ret made(u, int_type(u, width), value, words_of(width));
}

# a float constant of a width by its bits
pub fun float_bits(u: *Unit, width: u32, bits: u64) u32 {
    ret made(u, float_type(u, width), bits, words_of(width));
}

# a bool constant
pub fun boolean_constant(u: *Unit, value: bool) u32 {
    val t:   u32 = bool_type(u);
    var row: u32 = gen_row_index.OPCONSTANTFALSE;
    if (value) { row = gen_row_index.OPCONSTANTTRUE; }
    var b: u64 = 0;
    if (value) { b = 1; }
    var i: usize = 0;
    for (i < u.made.len) {
        if (u.made.data[i].type == t && u.made.data[i].value == b) { ret u.made.data[i].id; }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{t}, Slot.id{id}};
    unit.put(u, buffer.TYPES, row, ?slots[0], 2);
    val pushed: res[usize, allocator.Error] = vector.push[Made](?u.made, Made{type: t, value: b, id: id});
    if (sel pushed.err) { unit.lost(u, pushed.err); }
    ret id;
}

# the null of a type
pub fun null(u: *Unit, type: u32) u32 {
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{type}, Slot.id{id}};
    unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANTNULL, ?slots[0], 2);
    ret id;
}

# a constant of a scalar or vector type whose every lane is one value's bits
pub fun splat(u: *Unit, ty: Type, value: u64) u32 {
    val t: u32 = type_of(u, ty, PLAIN);
    if (t == NONE) { ret NONE; }
    val s: opt[types.Shape] = shape(u, ty);
    if (sel s.none) { ret NONE; }
    val sh: types.Shape = s.some;
    if (sel sh.vector) {
        val lane: u32 = splat(u, sh.vector.element, value);
        if (lane == NONE) { ret NONE; }
        var ids:   [4]u32  = [4]u32{lane, lane, lane, lane};
        val id:    u32     = unit.fresh(u);
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.list{unit.list(u, ?ids[0], sh.vector.lanes::usize)}};
        unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANTCOMPOSITE, ?slots[0], 3);
        ret id;
    }
    if (sel sh.integer) {
        if (sh.integer.width == 1) { ret boolean_constant(u, value != 0); }
        ret made(u, t, value, words_of(sh.integer.width));
    }
    if (sel sh.float) { ret made(u, t, value, words_of(bits_of(u, ty))); }
    ret NONE;
}

# the specialization constant of an id, made once: an OpSpecConstant of its
# default's bits, or an OpSpecConstantTrue or OpSpecConstantFalse of a
# bool's, decorated with its SpecId
fun special(u: *Unit, s: Spec) u32 {
    var i: usize = 0;
    for (i < u.specs.len) {
        if (u.specs.data[i].spec == s.id) { ret u.specs.data[i].id; }
        i = i + 1;
    }
    val ty: Type = s.default.type;
    val w:  u32  = bits_of(u, ty);
    if (w == 0 || w > 64) {
        unit.fail(u, Error.untyped{ty});
        ret NONE;
    }
    val t: u32 = type_of(u, ty, PLAIN);
    if (t == NONE) { ret NONE; }
    var bits: u64 = 0;
    if (s.default.words.size > 0) { bits = s.default.words.data[0]; }
    val id: u32 = unit.fresh(u);
    if (boolean(u, ty)) {
        var row: u32 = gen_row_index.OPSPECCONSTANTFALSE;
        if (bits != 0) { row = gen_row_index.OPSPECCONSTANTTRUE; }
        var slots: [2]Slot = [2]Slot{Slot.id{t}, Slot.id{id}};
        unit.put(u, buffer.TYPES, row, ?slots[0], 2);
    }
    or {
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.literal{unit.words(u, bits, words_of(w))}};
        unit.put(u, buffer.TYPES, gen_row_index.OPSPECCONSTANT, ?slots[0], 3);
    }
    decorate_number(u, id, SPEC_ID, s.id::u64);
    val pushed: res[usize, allocator.Error] = vector.push[Special](?u.specs, Special{spec: s.id, id: id});
    if (sel pushed.err) { unit.lost(u, pushed.err); }
    ret id;
}

fun cached_constant(u: *Unit, c: Constant, key: u32) opt[u32] {
    var k:   u64       = (c.index::u64 << 32) | key::u64;
    val got: opt[*u32] = map.get[u64, u32](?u.constants, ?k);
    if (sel got.some) { ret opt[u32].some{@got.some}; }
    ret opt[u32].none{};
}

# the id of a constant of the module in a layout: a scalar by its bits, a
# zero as the null of its type, an aggregate of its members', a specialization
# constant once by its SpecId and the address of a global as the global's
# variable. an aggregate that holds a specialization constant is a
# specialization constant of its own, an OpSpecConstantComposite. an address
# at an offset, or of a function, is no value logical addressing holds
pub fun constant_of(u: *Unit, c: Constant, key: u32) u32 {
    if (!unit.ok(u)) { ret NONE; }
    val got: res[ConstantData, module.Error] = module.constant_data(u.m, c);
    if (sel got.err) {
        unit.fail(u, Error.ir{got.err});
        ret NONE;
    }
    val d: ConstantData = got.ok;
    if (sel d.address) {
        val s: Symbol = d.address.symbol;
        if (sel s.global) {
            if (d.address.offset == 0) { ret u.globals.data[s.global.index]; }
        }
        unit.fail(u, Error.untyped{d.address.type});
        ret NONE;
    }
    if (sel d.spec) { ret special(u, d.spec); }
    var ty: Type = Type{index: 0};
    if (sel d.integer)   { ty = d.integer.type; }
    or (sel d.float)     { ty = d.float.type; }
    or (sel d.zero)      { ty = d.zero; }
    or (sel d.aggregate) { ty = d.aggregate.type; }
    val k:    u32      = norm(u, ty, key);
    val hold: opt[u32] = cached_constant(u, c, k);
    if (sel hold.some) { ret hold.some; }
    var id: u32 = NONE;
    if (sel d.integer || sel d.float) {
        var bits: u64 = 0;
        var w:    u32 = bits_of(u, ty);
        if (sel d.integer) {
            if (d.integer.words.size > 0) { bits = d.integer.words.data[0]; }
        }
        if (sel d.float) {
            if (d.float.words.size > 0) { bits = d.float.words.data[0]; }
        }
        if (w > 64) {
            unit.fail(u, Error.untyped{ty});
            ret NONE;
        }
        if (sel d.integer && w == 1) { id = boolean_constant(u, bits != 0); }
        or {
            val t: u32 = type_of(u, ty, PLAIN);
            if (t == NONE) { ret NONE; }
            id = made(u, t, bits, words_of(w));
        }
    }
    or (sel d.zero) {
        if (pointer(u, ty)) {
            unit.fail(u, Error.untyped{ty});
            ret NONE;
        }
        val t: u32 = type_of(u, ty, k);
        if (t == NONE) { ret NONE; }
        id = null(u, t);
    }
    or (sel d.aggregate) {
        val t: u32 = type_of(u, ty, k);
        if (t == NONE) { ret NONE; }
        var members: vector.Vector[u32] = vector.init[u32](u.a);
        fin { vector.dnit[u32](?members); }
        var i: usize = 0;
        for (i < d.aggregate.elements.size) {
            val m: u32 = constant_of(u, d.aggregate.elements.data[i], member_key(k));
            if (m == NONE) { ret NONE; }
            val pushed: res[usize, allocator.Error] = vector.push[u32](?members, m);
            if (sel pushed.err) {
                unit.lost(u, pushed.err);
                ret NONE;
            }
            i = i + 1;
        }
        var row: u32 = gen_row_index.OPCONSTANTCOMPOSITE;
        if (module.specialized(u.m, c)) { row = gen_row_index.OPSPECCONSTANTCOMPOSITE; }
        id = unit.fresh(u);
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.list{unit.list(u, members.data, members.len)}};
        unit.put(u, buffer.TYPES, row, ?slots[0], 3);
    }
    if (id == NONE) { ret NONE; }
    val put: res[bool, allocator.Error] = map.insert[u64, u32](?u.constants, (c.index::u64 << 32) | k::u64, id);
    if (sel put.err) { unit.lost(u, put.err); }
    ret id;
}

# a name of an id, as debuggers read it
pub fun name(u: *Unit, id: u32, v: View) {
    if (v.len == 0) { ret; }
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.literal{unit.text(u, v)}};
    unit.put(u, buffer.NAMES, gen_row_index.OPNAME, ?slots[0], 2);
}

fun decorated(u: *Unit, id: u32, list: Slice[Attribute]) {
    val set: opt[u64] = schema.integer(list, "set");
    if (sel set.some) { decorate_number(u, id, DESCRIPTOR_SET, set.some); }
    val binding: opt[u64] = schema.integer(list, "binding");
    if (sel binding.some) { decorate_number(u, id, BINDING, binding.some); }
    val location: opt[u64] = schema.integer(list, "location");
    if (sel location.some) { decorate_number(u, id, LOCATION, location.some); }
    val component: opt[u64] = schema.integer(list, "component");
    if (sel component.some) { decorate_number(u, id, COMPONENT, component.some); }
    val builtin: opt[u64] = schema.integer(list, "builtin");
    if (sel builtin.some) {
        var which: [1]Slot = [1]Slot{unit.enumerant(builtin.some::u32)};
        var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(BUILT_IN, unit.slots(u, ?which[0], 1))};
        unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
    }
    val plain: Slice[u64] = schema.integers(list, "decorate");
    var i:     usize      = 0;
    for (i < plain.size) {
        decorate(u, id, plain.data[i]::u32);
        i = i + 1;
    }
}

# whether a global of a storage class is one another unit defines: a
# Private one with no initial value, as every other class declares its
# variables wherever they are used
pub fun imported(u: *Unit, g: usize) bool {
    ret u.classes.data[g]::u64 == schema.PRIVATE && sel u.m.globals.data[g].data.initial.none;
}

# a variable for every global, in its storage class, decorated as its
# attributes state and named as its symbol is. a block's variable holds the
# Block-decorated structure of its type
pub fun variables(u: *Unit) {
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        val node:  *global.Node     = ?u.m.globals.data[g];
        val list:  Slice[Attribute] = Slice[Attribute]{data: node.attributes.data, size: node.attributes.len};
        val class: u32              = schema.storage(list)::u32;
        val key:   u32              = variable_key(u, class);
        val d:     GlobalData       = node.data;
        if (blocked(class)) {
            val s:  opt[types.Shape] = shape(u, d.type);
            var ok: bool             = false;
            if (sel s.some) {
                val sh: types.Shape = s.some;
                ok = sel sh.structure;
            }
            if (!ok) {
                unit.fail(u, Error.storage{Global{index: g::u32}});
                ret;
            }
        }
        val pointee: u32 = type_of(u, d.type, key);
        if (pointee == NONE) { ret; }
        val id: u32 = unit.fresh(u);
        unit.keep(u, pushed(vector.push[u32](?u.globals, id)));
        unit.keep(u, pushed(vector.push[u32](?u.classes, class)));
        unit.keep(u, pushed(vector.push[u32](?u.keys, key)));
        g = g + 1;
    }
    g = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        val node:  *global.Node     = ?u.m.globals.data[g];
        val list:  Slice[Attribute] = Slice[Attribute]{data: node.attributes.data, size: node.attributes.len};
        val class: u32              = u.classes.data[g];
        val key:   u32              = u.keys.data[g];
        val d:     GlobalData       = node.data;
        val ptr:   u32              = pointer_type(u, class, type_of(u, d.type, key));
        var init:  Slot             = Slot.none{};
        if (sel d.initial.some) {
            val c: u32 = constant_of(u, d.initial.some, key);
            if (c == NONE) { ret; }
            init = Slot.id{c};
        }
        var slots: [4]Slot = [4]Slot{Slot.id{ptr}, Slot.id{u.globals.data[g]}, unit.enumerant(class), init};
        unit.put(u, buffer.TYPES, gen_row_index.OPVARIABLE, ?slots[0], 4);
        decorated(u, u.globals.data[g], list);
        name(u, u.globals.data[g], d.name);
        g = g + 1;
    }
}

fun pushed(got: res[usize, allocator.Error]) err[allocator.Error] {
    if (sel got.err) { ret err[allocator.Error].err{got.err}; }
    ret err[allocator.Error].ok{};
}

# a structure of member types no ir type is, as an extended arithmetic
# instruction's result or a call's several results, made once by its members
pub fun struct_of(u: *Unit, members: *u32, n: usize) u32 {
    val got: opt[u32] = shaped(u, gen_row_index.OPTYPESTRUCT, 0, 0, members, n);
    if (sel got.some) { ret got.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.list{unit.list(u, members, n)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPESTRUCT, ?slots[0], 2);
    remember(u, gen_row_index.OPTYPESTRUCT, 0, 0, members, n, id);
    ret id;
}

# a structure of two members of one type
pub fun pair_of(u: *Unit, member: u32) u32 {
    var m: [2]u32 = [2]u32{member, member};
    ret struct_of(u, ?m[0], 2);
}
