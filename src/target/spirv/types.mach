use mirl.target.spirv.unit.Special;
use mirl.target.spirv.unit.Unit;

# the decorations the family states by their spir-v values
pub val BLOCK:              u32 = 2;
pub val BUFFER_BLOCK:       u32 = 3;
pub val ARRAY_STRIDE:       u32 = 6;
pub val BUILT_IN:           u32 = 11;
pub val COHERENT:           u32 = 23;
pub val LOCATION:           u32 = 30;
pub val COMPONENT:          u32 = 31;
pub val BINDING:            u32 = 33;
pub val DESCRIPTOR_SET:     u32 = 34;
pub val OFFSET:             u32 = 35;
pub val LINKAGE_ATTRIBUTES: u32 = 41;
pub val INPUT_ATTACHMENT:   u32 = 43;
pub val SPEC_ID:            u32 = 1;

# the WorkgroupSize built-in's value
val WORKGROUP_SIZE_BUILTIN: u32 = 25;

# the plain layout, of a class that fixes none
pub val PLAIN: u32 = 0;

val LAID:      u32 = 1;
val BLOCK_BIT: u32 = 2;

# the layout key of the storage class of a pointer, laid out where the class
# holds blocks or the target's row of its space states vulkan's rules
pub fun laid(u: *Unit, class: u32) u32 {
    var i: usize = 0;
    for (i < u.t.caps.widths.pointers.size) {
        if (u.t.caps.widths.pointers.data[i].space == class) {
            val r: Rules = u.t.caps.widths.pointers.data[i].layout;
            if (blocked(class) || class::u64 == schema.PHYSICAL_STORAGE_BUFFER || sel r.std140 || sel r.std430 || sel r.scalar) { ret (class << 2) | LAID; }
            ret PLAIN;
        }
        i = i + 1;
    }
    ret PLAIN;
}

# whether a storage class holds blocks: a uniform, push constant or storage buffer
pub fun blocked(class: u32) bool {
    ret class::u64 == schema.UNIFORM || class::u64 == schema.PUSH_CONSTANT || class::u64 == schema.STORAGE_BUFFER;
}

# whether the target's host states the fact `f` of every module it runs, as
# vulkan 1.3 states zero-initialized workgroup memory and LocalSizeId
pub fun guaranteed(u: *Unit, f: *Fact) bool {
    ret os.states(u.t.resolved.host, f);
}

# whether the module is written under the vulkan memory model, which it is
# where the build's selection holds the VulkanMemoryModel capability
pub fun vulkan_model(u: *Unit) bool {
    ret core_state.holds(?u.b.basis.context, gen_extension.VULKANMEMORYMODEL);
}

# the memory scopes an access is made available or visible at
pub val WORKGROUP_SCOPE:    u32 = 2;
pub val QUEUE_FAMILY_SCOPE: u32 = 5;

# the scope an access through a pointer into a class makes its writes
# available or its reads visible at, none for an access that is private:
# under the vulkan memory model, Workgroup memory at the Workgroup scope and a
# coherent buffer's at the QueueFamily scope, and under GLSL450 none, where
# Coherent decorates the buffer instead
pub fun scope_of(u: *Unit, class: u32, coherent: bool) opt[u32] {
    if (!vulkan_model(u)) { ret opt[u32].none{}; }
    val c: u64 = class::u64;
    if (c == schema.WORKGROUP)                                                           { ret opt[u32].some{WORKGROUP_SCOPE}; }
    if (coherent && (c == schema.STORAGE_BUFFER || c == schema.PHYSICAL_STORAGE_BUFFER)) { ret opt[u32].some{QUEUE_FAMILY_SCOPE}; }
    ret opt[u32].none{};
}

# the device memory scope
val DEVICE_SCOPE: u64 = 1;

# what a memory scope the module states needs of its memory model: what the
# grammar's member of the value requires, so QueueFamily needs
# VulkanMemoryModel, which a module under GLSL450 does not hold, and under the
# vulkan model the Device scope needs VulkanMemoryModelDeviceScope (spir-v
# 2.16.1, universal validation rules). a value the enumeration has no member of
# needs nothing here
pub fun scoped(u: *Unit, scope: u64) {
    var i: usize = 0;
    for (i < $length_of(gen_operand.SCOPE_MEMBERS)) {
        if (gen_operand.SCOPE_MEMBERS[i].value::u64 == scope) {
            unit.keep(u, buffer.need(?u.buf, gen_operand.SCOPE_MEMBERS[i].requires));
            brk;
        }
        i = i + 1;
    }
    if (scope == DEVICE_SCOPE && vulkan_model(u)) { unit.need(u, gen_extension.VULKANMEMORYMODELDEVICESCOPE); }
}

# what memory semantics the module states need of its memory model: what the
# grammar's member of each bit set requires, so MakeAvailable, MakeVisible,
# Volatile and OutputMemory need VulkanMemoryModel, which a module under
# GLSL450 does not hold
pub fun ordered(u: *Unit, semantics: u64) {
    var i: usize = 0;
    for (i < $length_of(gen_operand.MEMORYSEMANTICS_MEMBERS)) {
        val bit: u64 = gen_operand.MEMORYSEMANTICS_MEMBERS[i].value::u64;
        if (bit != 0 && (semantics & bit) == bit) { unit.keep(u, buffer.need(?u.buf, gen_operand.MEMORYSEMANTICS_MEMBERS[i].requires)); }
        i = i + 1;
    }
}

# whether a global's attributes decorate it Coherent
fun coherent(list: Slice[Attribute]) bool {
    val plain: Slice[u64] = schema.integers(list, "decorate");
    var i:     usize      = 0;
    for (i < plain.size) {
        if (plain.data[i] == COHERENT::u64) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the storage class a class is written as: a StorageBuffer one where the
# selection meets no requirement of that class, as below spir-v 1.3 with no
# SPV_KHR_storage_buffer_storage_class, is a Uniform one whose block is
# decorated BufferBlock, as vulkan 1.0 binds a storage buffer
pub fun written(u: *Unit, class: u32) u32 {
    if (class::u64 != schema.STORAGE_BUFFER) { ret class; }
    val m: *mo.Enumerant = schema.member(schema.Enumeration.storage{}, class::u64);
    if (m != nil && !unit.admits(u, m.requires)) { ret schema.UNIFORM::u32; }
    ret class;
}

# the layout key of what a global variable of a class holds
pub fun variable_key(u: *Unit, class: u32) u32 {
    val k: u32 = laid(u, class);
    if (blocked(class) && k != PLAIN) { ret k | BLOCK_BIT; }
    ret k;
}

# the layout of a member of an aggregate of a layout
pub fun member_key(key: u32) u32 {
    ret key & ~BLOCK_BIT;
}

fun space_of(key: u32) u32 {
    ret key >> 2;
}

# the array of words a wide integer is held in memory as: an integer wider than the target's widest arithmetic, which
# the wide legalisation splits into words of that width, low word first, and no spir-v type holds whole. none for a
# type that is no such integer
pub fun held_words(u: *Unit, ty: Type) opt[Type] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?u.m.types, ty);
    if (sel res_shape.err)           { ret opt[Type].none{}; }
    if (!(sel res_shape.ok.integer)) { ret opt[Type].none{}; }
    val opt_top: opt[u32] = capability.widest(?u.t.caps);
    if (sel opt_top.none) { ret opt[Type].none{}; }
    val w:   u32 = res_shape.ok.integer.width;
    val top: u32 = opt_top.some;
    if (w <= top || w % top != 0) { ret opt[Type].none{}; }
    val res_word: res[Type, table.Error] = table.intern(?u.m.types, table.Shape.integer{table.Integer{width: top}});
    if (sel res_word.err) {
        unit.fail(u, Error.ir{module.Error.types{res_word.err}});
        ret opt[Type].none{};
    }
    val res_words: res[Type, table.Error] = table.intern(?u.m.types, table.Shape.array{table.Array{count: (w / top)::u64, element: res_word.ok, stride: opt[u64].none{}}});
    if (sel res_words.err) {
        unit.fail(u, Error.ir{module.Error.types{res_words.err}});
        ret opt[Type].none{};
    }
    ret opt[Type].some{res_words.ok};
}

fun shape(u: *Unit, ty: Type) opt[table.Shape] {
    val res_shape: res[table.Shape, table.Error] = table.shape(?u.m.types, ty);
    if (sel res_shape.err) {
        unit.fail(u, Error.ir{module.Error.types{res_shape.err}});
        ret opt[table.Shape].none{};
    }
    ret opt[table.Shape].some{res_shape.ok};
}

# whether a type holds an aggregate, so its layout matters
pub fun holds_layout(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    if (sel k.structure || sel k.array) { ret true; }
    if (sel k.union) {
        val opt_union_member: opt[Type] = union_member(u, ty, PLAIN);
        if (sel opt_union_member.some) { ret holds_layout(u, opt_union_member.some); }
    }
    ret false;
}

# the key a type is laid out by: its own where it holds an aggregate, plain
# where its layout does not matter
pub fun norm(u: *Unit, ty: Type, key: u32) u32 {
    if (holds_layout(u, ty)) { ret key; }
    ret PLAIN;
}

# the member of a union it is held as: its largest, the first of those alike
pub fun union_member(u: *Unit, ty: Type, key: u32) opt[Type] {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret opt[Type].none{}; }
    val k: table.Shape = opt_shape.some;
    if (!(sel k.union)) { ret opt[Type].none{}; }
    val members: Slice[Type] = k.union.members;
    if (members.size == 0) { ret opt[Type].none{}; }
    var best: usize = 0;
    var most: u64   = 0;
    var i:    usize = 0;
    for (i < members.size) {
        val res_size: res[u64, record.Error] = layout.size(u.l, members.data[i], space_of(key));
        if (sel res_size.err) {
            unit.fail(u, Error.layout{res_size.err});
            ret opt[Type].none{};
        }
        if (i == 0 || res_size.ok > most) {
            best = i;
            most = res_size.ok;
        }
        i = i + 1;
    }
    ret opt[Type].some{members.data[best]};
}

# the type of a member of an aggregate or a lane of a vector
pub fun member_of(u: *Unit, ty: Type, index: u32) opt[Type] {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret opt[Type].none{}; }
    val k: table.Shape = opt_shape.some;
    if (sel k.structure) {
        if (index::usize < k.structure.members.size) { ret opt[Type].some{k.structure.members.data[index]}; }
        ret opt[Type].none{};
    }
    if (sel k.array)  { ret opt[Type].some{k.array.element}; }
    if (sel k.vector) { ret opt[Type].some{k.vector.element}; }
    ret opt[Type].none{};
}

# the number of members of an aggregate or lanes of a vector, 0 for any other
pub fun count_of(u: *Unit, ty: Type) u64 {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret 0; }
    val k: table.Shape = opt_shape.some;
    if (sel k.structure) { ret k.structure.members.size::u64; }
    if (sel k.array)     { ret k.array.count; }
    if (sel k.vector)    { ret k.vector.lanes::u64; }
    ret 0;
}

# the bits of an integer or float type, of the lane of a vector, 0 for any other
pub fun bits_of(u: *Unit, ty: Type) u32 {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret 0; }
    val k: table.Shape = opt_shape.some;
    if (sel k.integer) { ret k.integer.width; }
    if (sel k.float) {
        val opt_row: opt[format.Row] = format.row(k.float.format);
        if (sel opt_row.some) { ret opt_row.some.width; }
        ret 0;
    }
    if (sel k.vector) { ret bits_of(u, k.vector.element); }
    ret 0;
}

# whether a type is a float or a vector of floats
pub fun floating(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    if (sel k.float)  { ret true; }
    if (sel k.vector) { ret floating(u, k.vector.element); }
    ret false;
}

# whether a type is an i1 or a vector of them, a bool in spir-v
pub fun boolean(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    if (sel k.integer) { ret k.integer.width == 1; }
    if (sel k.vector)  { ret boolean(u, k.vector.element); }
    ret false;
}

# whether a type is a pointer as logical addressing holds it: the variable or the part of one
# it was made by, which is no value of memory, a phi or a select. a physical pointer is not one
pub fun pointer(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    ret sel k.pointer && k.pointer.space::u64 != schema.PHYSICAL_STORAGE_BUFFER;
}

# whether a type is a physical pointer, an address into the PhysicalStorageBuffer class
pub fun physical(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    ret sel k.pointer && k.pointer.space::u64 == schema.PHYSICAL_STORAGE_BUFFER;
}

# the type a physical pointer is held in as a value, in memory, across a phi and a call: its
# address as two 32-bit words, the low first, which OpBitcast makes a pointer of and back under
# PhysicalStorageBuffer64. mirl's pointers name no pointee, and a pointer type of one fixed
# pointee would hold no `nil`, since a PhysicalStorageBuffer pointer has no null constant, while
# the words have one and need no capability of their own
pub fun address_type(u: *Unit) u32 {
    unit.need(u, gen_extension.PHYSICALSTORAGEBUFFERADDRESSES);
    ret vector_type(u, int_type(u, 32), 2);
}

# the layout key of memory a physical pointer reaches, laid out as a storage buffer's
pub fun physical_key(u: *Unit) u32 {
    ret laid(u, schema.PHYSICAL_STORAGE_BUFFER::u32);
}

# a PhysicalStorageBuffer pointer to a type laid out as memory a physical pointer reaches,
# decorated with the stride an OpPtrAccessChain steps it by: the type's size rounded up to its
# alignment, as an array of it lays its elements out. memory a physical pointer reaches is a
# storage buffer's to the rules vulkan holds it to, so the pointee is refused where its layout
# breaks them, at the access `at` that first reaches it. an 8- or 16-bit scalar in it needs the
# storage capability of its width and the width's own capability as well, since the pointer to
# it is made with OpBitcast, and the storage capabilities make a pointer to such a type only as
# the result of OpVariable or an access chain (spir-v 2.16.1, "data rules")
pub fun physical_pointer(u: *Unit, pointee: Type, at: At) u32 {
    val class: u32 = schema.PHYSICAL_STORAGE_BUFFER::u32;
    val t:     u32 = type_of(u, pointee, physical_key(u));
    if (t == NONE) { ret NONE; }
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEPOINTER, class, t, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val opt_broken: opt[Broken] = broken(u, pointee, class, 0, false, guaranteed(u, ?vulkan.RELAXED_BLOCK_LAYOUT));
    if (sel opt_broken.some) {
        unit.fail(u, Error.pointee{Pointee{at: at, layout: Layout{rules: "std430", offset: opt_broken.some.offset, placed: opt_broken.some.placed}}});
        ret NONE;
    }
    shared_storage(u, 0, pointee, class);
    unshared(u, pointee);
    if (!unit.ok(u)) { ret NONE; }
    val id:        u32                    = pointer_type(u, class, t);
    val res_size:  res[u64, record.Error] = layout.size(u.l, pointee, class);
    val res_align: res[u64, record.Error] = layout.align(u.l, pointee, class);
    if (sel res_size.err) {
        unit.fail(u, Error.layout{res_size.err});
        ret NONE;
    }
    if (sel res_align.err) {
        unit.fail(u, Error.layout{res_align.err});
        ret NONE;
    }
    val step: u64 = (res_size.ok + res_align.ok - 1) / res_align.ok * res_align.ok;
    if (step != 0) { decorate_number(u, id, ARRAY_STRIDE, step); }
    ret id;
}

# whether a type is an integer, a float or a vector of either
pub fun scalar_or_vector(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    ret sel k.integer || sel k.float || sel k.vector;
}

# the lanes of a vector type, 1 for any other
pub fun lanes_of(u: *Unit, ty: Type) u32 {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret 1; }
    val k: table.Shape = opt_shape.some;
    if (sel k.vector) { ret k.vector.lanes; }
    ret 1;
}

# the id of a type declared once by its shape, made by `declare` when no
# shape alike is held
fun shaped(u: *Unit, row: u32, a: u32, b: u32, list: *u32, n: usize) opt[u32] {
    var i: usize = 0;
    for (i < u.shapes.len) {
        val s: *Shape = ?u.shapes.data[i];
        if (s.row == row && s.a == a && s.b == b && s.list.len::usize == n) {
            var same: bool  = true;
            var k:    usize = 0;
            for (k < n && same) {
                if (u.lists.data[s.list.at + k::u32] != list[k]) { same = false; }
                k = k + 1;
            }
            if (same) { ret opt[u32].some{s.id}; }
        }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun remember(u: *Unit, row: u32, a: u32, b: u32, list: *u32, n: usize, id: u32) {
    val kept:       Span                        = unit.keep_list(u, list, n);
    val res_pushed: res[usize, allocator.Error] = vector.push[Shape](?u.shapes, Shape{row: row, a: a, b: b, list: kept, id: id});
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
}

# a type of no operands, void or bool
fun bare(u: *Unit, row: u32) u32 {
    val opt_shaped: opt[u32] = shaped(u, row, 0, 0, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [1]Slot = [1]Slot{Slot.id{id}};
    unit.put(u, buffer.TYPES, row, ?slots[0], 1);
    remember(u, row, 0, 0, nil, 0, id);
    ret id;
}

pub fun void(u: *Unit) u32 {
    ret bare(u, gen_row_index.OPTYPEVOID);
}

pub fun bool_type(u: *Unit) u32 {
    ret bare(u, gen_row_index.OPTYPEBOOL);
}

# the capability an integer of a width needs where it is a value or memory no
# host shares, none for core's 32
fun width_capability(width: u32) opt[requirement.Id] {
    if (width == 8)  { ret opt[requirement.Id].some{gen_extension.INT8}; }
    if (width == 16) { ret opt[requirement.Id].some{gen_extension.INT16}; }
    if (width == 64) { ret opt[requirement.Id].some{gen_extension.INT64}; }
    ret opt[requirement.Id].none{};
}

# an unsigned integer type of a width, which needs its capability past core's
# 32 where the build holds it. a build that does not hold the width carries
# its values, and its memory states what it needs (unshared, shared_storage)
pub fun int_type(u: *Unit, width: u32) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEINT, width, 0, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val opt_needs: opt[requirement.Id] = width_capability(width);
    if (sel opt_needs.some) {
        if (width == 64 || core_state.holds(?u.b.basis.context, opt_needs.some)) { unit.need(u, opt_needs.some); }
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{width::i64}, Slot.immediate{0}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEINT, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEINT, width, 0, nil, 0, id);
    ret id;
}

# a float type of a width, which needs its capability past core's 32. a
# build that does not hold Float16 keeps every value of 16 bits as its
# encoding (mirl.legal.half), so the width is left only in memory, which
# states what it needs (unshared, shared_storage), and in the width-only
# conversions that reach memory a host shares (mirl.target.spirv.access)
pub fun float_type(u: *Unit, width: u32) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEFLOAT, width, 0, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    if (width == 16) {
        if (core_state.holds(?u.b.basis.context, gen_extension.FLOAT16)) { unit.need(u, gen_extension.FLOAT16); }
        u.floats = u.floats | 1;
    }
    if (width == 32) { u.floats = u.floats | 2; }
    if (width == 64) {
        unit.need(u, gen_extension.FLOAT64);
        u.floats = u.floats | 4;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{width::i64}, Slot.none{}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEFLOAT, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEFLOAT, width, 0, nil, 0, id);
    ret id;
}

pub fun vector_type(u: *Unit, element: u32, lanes: u32) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEVECTOR, element, lanes, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.id{element}, Slot.immediate{lanes::i64}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEVECTOR, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEVECTOR, element, lanes, nil, 0, id);
    ret id;
}

# a pointer into a storage class to a type
pub fun pointer_type(u: *Unit, class: u32, pointee: u32) u32 {
    val w:          u32      = written(u, class);
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEPOINTER, w, pointee, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, unit.enumerant(w), Slot.id{pointee}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEPOINTER, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEPOINTER, w, pointee, nil, 0, id);
    ret id;
}

# a function type of a result type and parameter types
pub fun function_type(u: *Unit, result: u32, params: *u32, n: usize) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEFUNCTION, result, 0, params, n);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.id{result}, Slot.list{unit.list(u, params, n)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEFUNCTION, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEFUNCTION, result, 0, params, n, id);
    ret id;
}

# a decoration of an id with no params or one number
pub fun decorate(u: *Unit, id: u32, decoration: u32) {
    var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant(decoration)};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
}

pub fun decorate_number(u: *Unit, id: u32, decoration: u32, n: u64) {
    var value: [1]Slot = [1]Slot{Slot.immediate{n::i64}};
    var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(decoration, unit.slots(u, ?value[0], 1))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
}

fun member_offset(u: *Unit, id: u32, member: u32, n: u64) {
    var value: [1]Slot = [1]Slot{Slot.immediate{n::i64}};
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{member::i64}, unit.enumerant_of(OFFSET, unit.slots(u, ?value[0], 1))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPMEMBERDECORATE, ?slots[0], 3);
}

fun cached(u: *Unit, ty: Type, key: u32) opt[u32] {
    var k:               u64       = unit.cache_key(ty, key);
    val opt_types_entry: opt[*u32] = map.get[u64, u32](?u.types, ?k);
    if (sel opt_types_entry.some) { ret opt[u32].some{@opt_types_entry.some}; }
    ret opt[u32].none{};
}

fun cache(u: *Unit, ty: Type, key: u32, id: u32) {
    val res_put: res[bool, allocator.Error] = map.insert[u64, u32](?u.types, unit.cache_key(ty, key), id);
    if (sel res_put.err) { unit.lost(u, res_put.err); }
}

# the id of an ir type in a layout, NONE where spir-v has no form of it,
# which is refused
pub fun type_of(u: *Unit, ty: Type, key: u32) u32 {
    if (!unit.ok(u)) { ret NONE; }
    val k:        u32      = norm(u, ty, key);
    val opt_hold: opt[u32] = cached(u, ty, k);
    if (sel opt_hold.some) { ret opt_hold.some; }
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret NONE; }
    val sh: table.Shape = opt_shape.some;
    var id: u32         = NONE;
    if (sel sh.integer) {
        if (sh.integer.width == 1)  { id = bool_type(u); }
        or (sh.integer.width <= 64) { id = int_type(u, sh.integer.width); }
        or {
            val opt_words: opt[Type] = held_words(u, ty);
            if (sel opt_words.some) { id = type_of(u, opt_words.some, key); }
        }
    }
    or (sel sh.float) {
        val opt_row: opt[format.Row] = format.row(sh.float.format);
        if (sel opt_row.some) { id = float_type(u, opt_row.some.width); }
    }
    or (sel sh.vector) {
        if (sh.vector.lanes >= 2 && sh.vector.lanes <= 4) {
            val e: u32 = type_of(u, sh.vector.element, PLAIN);
            if (e != NONE) { id = vector_type(u, e, sh.vector.lanes); }
        }
    }
    or (sel sh.array)     { id = array(u, ty, sh.array, k); }
    or (sel sh.structure) { id = structure(u, sh.structure, k, ty); }
    or (sel sh.union) {
        val opt_union_member: opt[Type] = union_member(u, ty, k);
        if (sel opt_union_member.some) { id = type_of(u, opt_union_member.some, k); }
    }
    or (sel sh.handle) { id = handle_type(u, sh.handle); }
    or (sel sh.pointer) {
        if (sh.pointer.space::u64 == schema.PHYSICAL_STORAGE_BUFFER) { id = address_type(u); }
    }
    if (id == NONE) {
        unit.fail(u, Error.untyped{ty});
        ret NONE;
    }
    cache(u, ty, k, id);
    ret id;
}

# the id of a handle type: the type its kind's row of masc's set makes, each
# operand the row's own after its result in order, a type by its id and a
# word as the row's operand takes it, a 32-bit unsigned constant where it
# takes an id. NONE where the target mints no such kind or the row takes
# none of an operand's shape
fun handle_type(u: *Unit, h: table.Handle) u32 {
    val opt_kind: opt[*Minted] = minted(u.t.caps.handles, h.kind);
    if (sel opt_kind.none) { ret NONE; }
    var keys:      index.Index = index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT};
    val opt_found: opt[u32]    = index.find(?keys, opt_kind.some.key);
    if (sel opt_found.none) { ret NONE; }
    val row: *mrow.Row = ?gen_row.ROWS[opt_found.some];
    if (h.operands.size + 1 > r_len(row)::usize) { ret NONE; }
    var ids: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?ids); }
    var slots: vector.Vector[Slot] = vector.init[Slot](u.a);
    fin { vector.dnit[Slot](?slots); }
    keep_slot(u, ?slots, Slot.id{NONE});
    var i: usize = 0;
    for (i < h.operands.size && unit.ok(u)) {
        val x:      *mo.Operand         = ?row.operands.at[i + 1];
        val o:      table.HandleOperand = h.operands.data[i];
        var at:     Slot                = Slot.none{};
        var word:   u32                 = 0;
        val opt_ty: opt[Type]           = table.operand_type(o);
        if (sel opt_ty.some) {
            if (!(sel x.shape.id)) { ret NONE; }
            word = type_of(u, opt_ty.some, PLAIN);
            if (row.index == gen_row_index.OPTYPEIMAGE && i == 0 && signed_image(u, h)) { word = signed_texel(u, bits_of(u, opt_ty.some)); }
            if (word == NONE)                                                           { ret NONE; }
            at = Slot.id{word};
        }
        if (sel o.word) {
            word = o.word;
            if (sel x.shape.id)        { at = Slot.id{uint(u, 32, o.word::u64)}; }
            or (sel x.shape.enumerant) { at = unit.enumerant(o.word); }
            or (sel x.shape.immediate) { at = Slot.immediate{o.word::i64}; }
            or (sel x.shape.literal)   { at = Slot.literal{unit.words(u, o.word::u64, 1)}; }
            or                         { ret NONE; }
            if (sel x.shape.id)        { word = slot_id(at); }
        }
        keep_slot(u, ?slots, at);
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?ids, word);
        if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
        i = i + 1;
    }
    if (!unit.ok(u)) { ret NONE; }
    for (slots.len < r_len(row)::usize) { keep_slot(u, ?slots, Slot.none{}); }
    val opt_shaped: opt[u32] = shaped(u, row.index, h.operands.size::u32, 0, ids.data, ids.len);
    if (sel opt_shaped.some)                    { ret opt_shaped.some; }
    if (row.index == gen_row_index.OPTYPEIMAGE) { image_needs(u, ids.data, ids.len); }
    val id: u32 = unit.fresh(u);
    slots.data[0] = Slot.id{id};
    unit.put(u, buffer.TYPES, row.index, slots.data, slots.len);
    remember(u, row.index, h.operands.size::u32, 0, ids.data, ids.len, id);
    ret id;
}

# whether an image handle holds integer texels it declares signed, whose
# Sampled Type is then a signed integer: vulkan's image format and type
# matching holds every access to the format's signedness, which an access
# takes from the Sampled Type where it sets neither SignExtend nor ZeroExtend
# (vulkan, signedness of spir-v image accesses), as every access here does.
# the front end holds a signed format's texel scalar signed, and an image of
# no declared format takes the signedness the declaration states
fun signed_image(u: *Unit, h: table.Handle) bool {
    if (!kind_is(h, IMAGE_KIND) || h.operands.size < 7) { ret false; }
    val texel: table.HandleOperand = h.operands.data[0];
    ret sel texel.signed;
}

# whether `ty` is an image, or a sampled image of an image, whose Sampled
# Type is a signed integer
pub fun signed_texels(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    if (!(sel k.handle)) { ret false; }
    if (kind_is(k.handle, SAMPLED_IMAGE_KIND) && k.handle.operands.size == 1) {
        val opt_inner: opt[Type] = table.operand_type(k.handle.operands.data[0]);
        if (sel opt_inner.some) { ret signed_texels(u, opt_inner.some); }
        ret false;
    }
    ret signed_image(u, k.handle);
}

val IMAGE_KIND:         str = "spirv.image";
val SAMPLED_IMAGE_KIND: str = "spirv.sampled_image";

fun kind_is(h: table.Handle, kind: str) bool {
    ret slice.order_view(h.kind, View{data: kind, len: str_len(kind)}) == 0;
}

# whether `ty` is an image handle
fun image_type(u: *Unit, ty: Type) bool {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret false; }
    val k: table.Shape = opt_shape.some;
    if (!(sel k.handle)) { ret false; }
    ret kind_is(k.handle, IMAGE_KIND);
}

# whether global `g` binds an image the program declares `"coherent"`
pub fun coherent_image(u: *Unit, g: usize) bool {
    val node: *global.Node = ?u.m.globals.data[g];
    if (!image_type(u, node.data.type)) { ret false; }
    ret coherent(Slice[Attribute]{data: node.attributes.data, size: node.attributes.len});
}

# the signed integer type of a width, the Sampled Type of an image of a signed
# format and the type its texels are accessed as
pub fun signed_texel(u: *Unit, width: u32) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPEINT, width, 1, nil, 0);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    if (width == 64)         { unit.need(u, gen_extension.INT64); }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{width::i64}, Slot.immediate{1}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPEINT, ?slots[0], 3);
    remember(u, gen_row_index.OPTYPEINT, width, 1, nil, 0, id);
    ret id;
}

# the Dim values and the image use OpTypeImage's capability rules name
val DIM_1D:     u32 = 0;
val DIM_CUBE:   u32 = 3;
val DIM_RECT:   u32 = 4;
val DIM_BUFFER: u32 = 5;
val READ_WRITE: u32 = 2;

# what an image type needs past what its Dim and format members require of
# their own, which are the sampled forms: a storage image (Sampled 2) of Dim
# 1D, Rect or Buffer needs Image1D, ImageRect or ImageBuffer, an arrayed cube
# SampledCubeArray or, in storage, ImageCubeArray, and a multisampled storage
# image StorageImageMultisample, ImageMSArray as well where it is arrayed
# (spir-v 1.6, 3.8 Dim and 3.31 Capability). its operands after the sampled
# type are its Dim, Depth, Arrayed, MS and Sampled words
fun image_needs(u: *Unit, words: *u32, n: usize) {
    if (n < 6) { ret; }
    val dim:     u32  = words[1];
    val arrayed: bool = words[3] == 1;
    val ms:      bool = words[4] == 1;
    val storage: bool = words[5] == READ_WRITE;
    if (storage && dim == DIM_1D)     { unit.need(u, gen_extension.IMAGE1D); }
    if (storage && dim == DIM_RECT)   { unit.need(u, gen_extension.IMAGERECT); }
    if (storage && dim == DIM_BUFFER) { unit.need(u, gen_extension.IMAGEBUFFER); }
    if (dim == DIM_CUBE && arrayed) {
        if (storage) { unit.need(u, gen_extension.IMAGECUBEARRAY); }
        or           { unit.need(u, gen_extension.SAMPLEDCUBEARRAY); }
    }
    if (storage && ms) {
        unit.need(u, gen_extension.STORAGEIMAGEMULTISAMPLE);
        if (arrayed) { unit.need(u, gen_extension.IMAGEMSARRAY); }
    }
}

fun r_len(r: *mrow.Row) u32 {
    ret r.operands.len;
}

fun slot_id(s: Slot) u32 {
    if (sel s.id) { ret s.id; }
    ret NONE;
}

fun keep_slot(u: *Unit, v: *vector.Vector[Slot], s: Slot) {
    val res_pushed: res[usize, allocator.Error] = vector.push[Slot](v, s);
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
}

fun array(u: *Unit, ty: Type, a: table.Array, key: u32) u32 {
    if ((key & LAID) == 0) { unshared(u, a.element); }
    val element: u32 = type_of(u, a.element, member_key(key));
    if (element == NONE) { ret NONE; }
    val laid_out: bool = (key & LAID) != 0;
    val id:       u32  = unit.fresh(u);
    if (a.count == 0) {
        if (!laid_out) { ret NONE; }
        var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.id{element}};
        unit.put(u, buffer.TYPES, gen_row_index.OPTYPERUNTIMEARRAY, ?slots[0], 2);
    }
    or {
        if (a.count > 0xFFFF_FFFF) { ret NONE; }
        val length: u32     = uint(u, 32, a.count);
        var slots:  [3]Slot = [3]Slot{Slot.id{id}, Slot.id{element}, Slot.id{length}};
        unit.put(u, buffer.TYPES, gen_row_index.OPTYPEARRAY, ?slots[0], 3);
    }
    if (laid_out) {
        val res_step: res[u64, record.Error] = layout.stride(u.l, ty, space_of(key));
        if (sel res_step.err) {
            unit.fail(u, Error.layout{res_step.err});
            ret NONE;
        }
        decorate_number(u, id, ARRAY_STRIDE, res_step.ok);
    }
    ret id;
}

fun structure(u: *Unit, s: table.Structure, key: u32, ty: Type) u32 {
    var members: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?members); }
    var i: usize = 0;
    for (i < s.members.size) {
        if ((key & LAID) == 0) { unshared(u, s.members.data[i]); }
        val m: u32 = type_of(u, s.members.data[i], member_key(key));
        if (m == NONE) { ret NONE; }
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?members, m);
        if (sel res_pushed.err) {
            unit.lost(u, res_pushed.err);
            ret NONE;
        }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.list{unit.list(u, members.data, members.len)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPESTRUCT, ?slots[0], 2);
    if ((key & LAID) != 0) {
        i = 0;
        for (i < s.members.size) {
            val res_offset: res[u64, record.Error] = layout.offset(u.l, ty, space_of(key), i::u32);
            if (sel res_offset.err) {
                unit.fail(u, Error.layout{res_offset.err});
                ret NONE;
            }
            member_offset(u, id, i::u32, res_offset.ok);
            i = i + 1;
        }
    }
    if ((key & BLOCK_BIT) != 0) {
        if (written(u, space_of(key)) != space_of(key)) { decorate(u, id, BUFFER_BLOCK); }
        or                                              { decorate(u, id, BLOCK); }
    }
    ret id;
}

# a scalar constant of a type by its bits, made once
pub fun made(u: *Unit, type: u32, value: u64, words: u32) u32 {
    var i: usize = 0;
    for (i < u.made.len) {
        if (u.made.data[i].type == type && u.made.data[i].value == value) { ret u.made.data[i].id; }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{type}, Slot.id{id}, Slot.literal{unit.words(u, value, words)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANT, ?slots[0], 3);
    val res_pushed: res[usize, allocator.Error] = vector.push[Made](?u.made, Made{type: type, value: value, id: id});
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
    ret id;
}

fun words_of(width: u32) u32 {
    ret (width + 31) / 32;
}

# an unsigned integer constant of a width
pub fun uint(u: *Unit, width: u32, value: u64) u32 {
    ret made(u, int_type(u, width), value, words_of(width));
}

# a bool constant
pub fun boolean_constant(u: *Unit, value: bool) u32 {
    val t:   u32 = bool_type(u);
    var row: u32 = gen_row_index.OPCONSTANTFALSE;
    if (value) { row = gen_row_index.OPCONSTANTTRUE; }
    var b: u64 = 0;
    if (value) { b = 1; }
    var i: usize = 0;
    for (i < u.made.len) {
        if (u.made.data[i].type == t && u.made.data[i].value == b) { ret u.made.data[i].id; }
        i = i + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{t}, Slot.id{id}};
    unit.put(u, buffer.TYPES, row, ?slots[0], 2);
    val res_pushed: res[usize, allocator.Error] = vector.push[Made](?u.made, Made{type: t, value: b, id: id});
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
    ret id;
}

# the null of a type
pub fun null(u: *Unit, type: u32) u32 {
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{type}, Slot.id{id}};
    unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANTNULL, ?slots[0], 2);
    ret id;
}

# a constant of a scalar or vector type whose every lane is one value's bits
pub fun splat(u: *Unit, ty: Type, value: u64) u32 {
    val t: u32 = type_of(u, ty, PLAIN);
    if (t == NONE) { ret NONE; }
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret NONE; }
    val sh: table.Shape = opt_shape.some;
    if (sel sh.vector) {
        val lane: u32 = splat(u, sh.vector.element, value);
        if (lane == NONE) { ret NONE; }
        var ids:   [4]u32  = [4]u32{lane, lane, lane, lane};
        val id:    u32     = unit.fresh(u);
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.list{unit.list(u, ?ids[0], sh.vector.lanes::usize)}};
        unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANTCOMPOSITE, ?slots[0], 3);
        ret id;
    }
    if (sel sh.integer) {
        if (sh.integer.width == 1) { ret boolean_constant(u, value != 0); }
        ret made(u, t, value, words_of(sh.integer.width));
    }
    if (sel sh.float) { ret made(u, t, value, words_of(bits_of(u, ty))); }
    ret NONE;
}

# the constant of a wide integer as the array of words it is held in memory as, each word its bits of the
# integer's 64-bit words, low first
fun words_constant(u: *Unit, words: Type, bits: Slice[u64]) u32 {
    val t: u32 = type_of(u, words, PLAIN);
    if (t == NONE) { ret NONE; }
    val opt_shape: opt[table.Shape] = shape(u, words);
    if (sel opt_shape.none)          { ret NONE; }
    if (!(sel opt_shape.some.array)) { ret NONE; }
    val n:    u64 = opt_shape.some.array.count;
    val word: u32 = bits_of(u, opt_shape.some.array.element);
    val wt:   u32 = type_of(u, opt_shape.some.array.element, PLAIN);
    if (wt == NONE || word == 0 || word > 64) { ret NONE; }
    var parts: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?parts); }
    var j: u64 = 0;
    for (j < n) {
        val at:  u64 = j * word::u64;
        var got: u64 = 0;
        if ((at / 64)::usize < bits.size) { got = bits.data[(at / 64)::usize] >> (at % 64); }
        if (word < 64)                    { got = got & ((1::u64 << word::u64) - 1); }
        val res_pushed: res[usize, allocator.Error] = vector.push[u32](?parts, made(u, wt, got, words_of(word)));
        if (sel res_pushed.err) {
            unit.lost(u, res_pushed.err);
            ret NONE;
        }
        j = j + 1;
    }
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.list{unit.list(u, parts.data, parts.len)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPCONSTANTCOMPOSITE, ?slots[0], 3);
    ret id;
}

# the specialization constant of an id, made once: an OpSpecConstant of its
# default's bits, or an OpSpecConstantTrue or OpSpecConstantFalse of a
# bool's, decorated with its SpecId
fun special(u: *Unit, s: Spec) u32 {
    var i: usize = 0;
    for (i < u.specs.len) {
        if (u.specs.data[i].spec == s.id) { ret u.specs.data[i].id; }
        i = i + 1;
    }
    val ty: Type = s.default.type;
    val w:  u32  = bits_of(u, ty);
    if (w == 0 || w > 64) {
        unit.fail(u, Error.untyped{ty});
        ret NONE;
    }
    val t: u32 = type_of(u, ty, PLAIN);
    if (t == NONE) { ret NONE; }
    var bits: u64 = 0;
    if (s.default.words.size > 0) { bits = s.default.words.data[0]; }
    val id: u32 = unit.fresh(u);
    if (boolean(u, ty)) {
        var row: u32 = gen_row_index.OPSPECCONSTANTFALSE;
        if (bits != 0) { row = gen_row_index.OPSPECCONSTANTTRUE; }
        var slots: [2]Slot = [2]Slot{Slot.id{t}, Slot.id{id}};
        unit.put(u, buffer.TYPES, row, ?slots[0], 2);
    }
    or {
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.literal{unit.words(u, bits, words_of(w))}};
        unit.put(u, buffer.TYPES, gen_row_index.OPSPECCONSTANT, ?slots[0], 3);
    }
    decorate_number(u, id, SPEC_ID, s.id::u64);
    val res_pushed: res[usize, allocator.Error] = vector.push[Special](?u.specs, Special{spec: s.id, id: id});
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
    ret id;
}

fun cached_constant(u: *Unit, c: Constant, key: u32) opt[u32] {
    var k:                   u64       = (c::u64 << 32) | key::u64;
    val opt_constants_entry: opt[*u32] = map.get[u64, u32](?u.constants, ?k);
    if (sel opt_constants_entry.some) { ret opt[u32].some{@opt_constants_entry.some}; }
    ret opt[u32].none{};
}

# the id of a constant of the module in a layout: a scalar by its bits, a
# zero as the null of its type, an aggregate of its members', a specialization
# constant once by its SpecId and the address of a global as the global's
# variable. an aggregate that holds a specialization constant is a
# specialization constant of its own, an OpSpecConstantComposite. an address
# at an offset, or of a function, is no value logical addressing holds
pub fun constant_of(u: *Unit, c: Constant, key: u32) u32 {
    if (!unit.ok(u)) { ret NONE; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(u.m, c);
    if (sel res_constant_data.err) {
        unit.fail(u, Error.ir{res_constant_data.err});
        ret NONE;
    }
    val d: ConstantData = res_constant_data.ok;
    if (sel d.address) {
        val s: Symbol = d.address.symbol;
        if (sel s.global) {
            if (d.address.offset == 0) { ret u.globals.data[s.global]; }
        }
        unit.fail(u, Error.untyped{d.address.type});
        ret NONE;
    }
    if (sel d.spec) { ret special(u, d.spec); }
    var ty: Type = 0;
    if (sel d.integer)   { ty = d.integer.type; }
    or (sel d.float)     { ty = d.float.type; }
    or (sel d.zero)      { ty = d.zero; }
    or (sel d.aggregate) { ty = d.aggregate.type; }
    or (sel d.bytes)     { ty = d.bytes.type; }
    val k:        u32      = norm(u, ty, key);
    val opt_hold: opt[u32] = cached_constant(u, c, k);
    if (sel opt_hold.some) { ret opt_hold.some; }
    var id: u32 = NONE;
    if (sel d.integer || sel d.float) {
        var bits: u64 = 0;
        var w:    u32 = bits_of(u, ty);
        if (sel d.integer) {
            if (d.integer.words.size > 0) { bits = d.integer.words.data[0]; }
        }
        if (sel d.float) {
            if (d.float.words.size > 0) { bits = d.float.words.data[0]; }
        }
        val opt_words: opt[Type] = held_words(u, ty);
        var held:      bool      = false;
        if (sel opt_words.some) {
            if (sel d.integer) {
                id   = words_constant(u, opt_words.some, d.integer.words);
                held = true;
                if (id == NONE) { ret NONE; }
            }
        }
        if (!held && w > 64) {
            unit.fail(u, Error.untyped{ty});
            ret NONE;
        }
        if (!held && sel d.integer && w == 1) { id = boolean_constant(u, bits != 0); }
        or (!held) {
            val t: u32 = type_of(u, ty, PLAIN);
            if (t == NONE) { ret NONE; }
            id = made(u, t, bits, words_of(w));
        }
    }
    or (sel d.zero) {
        if (pointer(u, ty)) {
            unit.fail(u, Error.untyped{ty});
            ret NONE;
        }
        val t: u32 = type_of(u, ty, k);
        if (t == NONE) { ret NONE; }
        id = null(u, t);
    }
    or (sel d.aggregate || sel d.bytes) {
        val t: u32 = type_of(u, ty, k);
        if (t == NONE) { ret NONE; }
        var members: vector.Vector[u32] = vector.init[u32](u.a);
        fin { vector.dnit[u32](?members); }
        if (sel d.aggregate) {
            var i: usize = 0;
            for (i < d.aggregate.elements.size) {
                val m: u32 = constant_of(u, d.aggregate.elements.data[i], member_key(k));
                if (m == NONE) { ret NONE; }
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?members, m);
                if (sel res_pushed.err) {
                    unit.lost(u, res_pushed.err);
                    ret NONE;
                }
                i = i + 1;
            }
        }
        or (sel d.bytes) {
            val opt_held: opt[Type] = member_of(u, ty, 0);
            if (sel opt_held.none) {
                unit.fail(u, Error.untyped{ty});
                ret NONE;
            }
            val et: u32 = type_of(u, opt_held.some, PLAIN);
            if (et == NONE) { ret NONE; }
            var i: usize = 0;
            for (i < d.bytes.data.size) {
                val res_pushed: res[usize, allocator.Error] = vector.push[u32](?members, made(u, et, d.bytes.data.data[i]::u64, words_of(8)));
                if (sel res_pushed.err) {
                    unit.lost(u, res_pushed.err);
                    ret NONE;
                }
                i = i + 1;
            }
        }
        var row: u32 = gen_row_index.OPCONSTANTCOMPOSITE;
        if (module.specialized(u.m, c)) { row = gen_row_index.OPSPECCONSTANTCOMPOSITE; }
        id = unit.fresh(u);
        var slots: [3]Slot = [3]Slot{Slot.id{t}, Slot.id{id}, Slot.list{unit.list(u, members.data, members.len)}};
        unit.put(u, buffer.TYPES, row, ?slots[0], 3);
    }
    if (id == NONE) { ret NONE; }
    val res_put: res[bool, allocator.Error] = map.insert[u64, u32](?u.constants, (c::u64 << 32) | k::u64, id);
    if (sel res_put.err) { unit.lost(u, res_put.err); }
    ret id;
}

# the WorkgroupSize built-in over the three dimensions at `dims`, each the id
# of a 32-bit constant or specialization constant: an
# OpSpecConstantComposite decorated as the built-in, which sizes every compute
# stage of the module in an environment that states no LocalSizeId (see
# guaranteed). a module holds one, so its caller makes it once
pub fun workgroup_size(u: *Unit, dims: *u32) u32 {
    val v3:    u32     = vector_type(u, int_type(u, 32), 3);
    val id:    u32     = unit.fresh(u);
    var slots: [3]Slot = [3]Slot{Slot.id{v3}, Slot.id{id}, Slot.list{unit.list(u, dims, 3)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPSPECCONSTANTCOMPOSITE, ?slots[0], 3);
    var which: [1]Slot = [1]Slot{unit.enumerant(WORKGROUP_SIZE_BUILTIN)};
    var built: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(BUILT_IN, unit.slots(u, ?which[0], 1))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?built[0], 2);
    ret id;
}

# a name of an id, as debuggers read it
pub fun name(u: *Unit, id: u32, v: View) {
    if (v.len == 0) { ret; }
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.literal{unit.text(u, v)}};
    unit.put(u, buffer.NAMES, gen_row_index.OPNAME, ?slots[0], 2);
}

# the names debuggers read of a block's record and of each of its fields, as
# the debug binding of the global holding it states them
fun block_names(u: *Unit, id: u32, binding: debug_record.Binding) {
    if (binding::usize >= u.m.debug.bindings.len) { ret; }
    val v:        debug_record.Variable        = u.m.debug.bindings.data[binding];
    val res_name: res[View, debug_table.Error] = debug_entry.name(?u.m.debug, v.type);
    if (sel res_name.ok) { name(u, id, res_name.ok); }
    val res_shape: res[debug_record.Shape, debug_table.Error] = debug_entry.shape(?u.m.debug, v.type);
    if (sel res_shape.err) { ret; }
    val k: debug_record.Shape = res_shape.ok;
    if (!(sel k.structure)) { ret; }
    var i: usize = 0;
    for (i < k.structure.size) {
        val m: debug_record.Member = k.structure.data[i];
        if (m.name.len > 0) {
            var slots: [3]Slot = [3]Slot{Slot.id{id}, Slot.immediate{m.field::i64}, Slot.literal{unit.text(u, m.name)}};
            unit.put(u, buffer.NAMES, gen_row_index.OPMEMBERNAME, ?slots[0], 3);
        }
        i = i + 1;
    }
}

fun decorated(u: *Unit, id: u32, list: Slice[Attribute]) {
    val opt_set: opt[u64] = schema.integer(list, "set");
    if (sel opt_set.some) { decorate_number(u, id, DESCRIPTOR_SET, opt_set.some); }
    val opt_binding: opt[u64] = schema.integer(list, "binding");
    if (sel opt_binding.some) { decorate_number(u, id, BINDING, opt_binding.some); }
    val opt_attachment: opt[u64] = schema.integer(list, "attachment");
    if (sel opt_attachment.some) { decorate_number(u, id, INPUT_ATTACHMENT, opt_attachment.some); }
    val opt_location: opt[u64] = schema.integer(list, "location");
    if (sel opt_location.some) { decorate_number(u, id, LOCATION, opt_location.some); }
    val opt_component: opt[u64] = schema.integer(list, "component");
    if (sel opt_component.some) { decorate_number(u, id, COMPONENT, opt_component.some); }
    val opt_builtin: opt[u64] = schema.integer(list, "builtin");
    if (sel opt_builtin.some) {
        var which: [1]Slot = [1]Slot{unit.enumerant(opt_builtin.some::u32)};
        var slots: [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(BUILT_IN, unit.slots(u, ?which[0], 1))};
        unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?slots[0], 2);
    }
    val plain: Slice[u64] = schema.integers(list, "decorate");
    var i:     usize      = 0;
    for (i < plain.size) {
        # under the vulkan memory model coherence is each access's, so Coherent is not written
        if (plain.data[i] != COHERENT::u64 || !vulkan_model(u)) { decorate(u, id, plain.data[i]::u32); }
        i = i + 1;
    }
}

# the alignment vulkan's block rules give a type: a scalar's size, a wide integer's words', a vector's
# lane twice for two lanes and four times for three or four, an array's or
# structure's strictest member's, rounded up to 16 under the extended rules
# of a uniform block. 0 where the type has no extent of vulkan's
fun ruled(u: *Unit, ty: Type, extended: bool) u64 {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret 0; }
    val k:         table.Shape = opt_shape.some;
    val opt_words: opt[Type]   = held_words(u, ty);
    if (sel opt_words.some)           { ret ruled(u, opt_words.some, extended); }
    if (sel k.integer || sel k.float) { ret ((bits_of(u, ty) + 7) / 8)::u64; }
    if (sel k.pointer)                { ret 8; }
    if (sel k.vector) {
        val lane: u64 = ((bits_of(u, ty) + 7) / 8)::u64;
        if (k.vector.lanes == 2) { ret 2 * lane; }
        ret 4 * lane;
    }
    if (sel k.union) {
        val opt_union_member: opt[Type] = union_member(u, ty, PLAIN);
        if (sel opt_union_member.some) { ret ruled(u, opt_union_member.some, extended); }
        ret 0;
    }
    var most: u64 = 0;
    if (sel k.array) { most = ruled(u, k.array.element, extended); }
    if (sel k.structure) {
        var i: usize = 0;
        for (i < k.structure.members.size) {
            val a: u64 = ruled(u, k.structure.members.data[i], extended);
            if (a > most) { most = a; }
            i = i + 1;
        }
    }
    if (extended && most < 16 && most != 0) { ret 16; }
    ret most;
}

fun rounded(x: u64, align: u64) u64 {
    if (align == 0) { ret x; }
    ret (x + align - 1) / align * align;
}

# how a block's layout breaks vulkan's rules, as the byte the layout places
# and where the rules would
rec Broken {
    offset: u64;
    placed: u64;
}

# the first place a structure laid out in a block class at a base offset
# breaks vulkan's rules for that class (vulkan, "offset and stride
# assignment"): each member at a multiple of its alignment, past the end of
# the member before it, rounded up to that member's alignment where it is an
# array or a structure, and an array's stride a multiple of the array's
# alignment. under relaxed layout a vector member is at a multiple of its
# lane's size and within one 16 byte line, or at the start of one where it
# spans more. none where it keeps them
fun broken(u: *Unit, ty: Type, class: u32, base: u64, extended: bool, relaxed: bool) opt[Broken] {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret opt[Broken].none{}; }
    val k: table.Shape = opt_shape.some;
    if (sel k.array) {
        val res_step: res[u64, record.Error] = layout.stride(u.l, ty, class);
        if (sel res_step.err) {
            unit.fail(u, Error.layout{res_step.err});
            ret opt[Broken].none{};
        }
        val a: u64 = ruled(u, ty, extended);
        if (a != 0 && res_step.ok % a != 0) { ret opt[Broken].some{Broken{offset: base + res_step.ok, placed: base + rounded(res_step.ok, a)}}; }
        ret broken(u, k.array.element, class, base, extended, relaxed);
    }
    if (!(sel k.structure)) { ret opt[Broken].none{}; }
    var next: u64   = 0;
    var i:    usize = 0;
    for (i < k.structure.members.size && unit.ok(u)) {
        val t:          Type                   = k.structure.members.data[i];
        val res_offset: res[u64, record.Error] = layout.offset(u.l, ty, class, i::u32);
        if (sel res_offset.err) {
            unit.fail(u, Error.layout{res_offset.err});
            ret opt[Broken].none{};
        }
        val res_size: res[u64, record.Error] = layout.size(u.l, t, class);
        if (sel res_size.err) {
            unit.fail(u, Error.layout{res_size.err});
            ret opt[Broken].none{};
        }
        val at:               u64              = res_offset.ok;
        val a:                u64              = ruled(u, t, extended);
        val opt_member_shape: opt[table.Shape] = shape(u, t);
        if (sel opt_member_shape.none) { ret opt[Broken].none{}; }
        val m: table.Shape = opt_member_shape.some;
        if (relaxed && sel m.vector) {
            val lane: u64 = ((bits_of(u, t) + 7) / 8)::u64;
            if (lane != 0 && at % lane != 0) { ret opt[Broken].some{Broken{offset: base + at, placed: base + rounded(at, lane)}}; }
            val spans: bool = res_size.ok > 16;
            if (spans && at % 16 != 0)                                                { ret opt[Broken].some{Broken{offset: base + at, placed: base + rounded(at, 16)}}; }
            if (!spans && res_size.ok != 0 && at / 16 != (at + res_size.ok - 1) / 16) { ret opt[Broken].some{Broken{offset: base + at, placed: base + rounded(at, 16)}}; }
        }
        or (a != 0 && at % a != 0) { ret opt[Broken].some{Broken{offset: base + at, placed: base + rounded(at, a)}}; }
        if (at < next)             { ret opt[Broken].some{Broken{offset: base + at, placed: base + next}}; }
        val opt_within: opt[Broken] = broken(u, t, class, base + at, extended, relaxed);
        if (sel opt_within.some) { ret opt_within; }
        next = at + res_size.ok;
        if (sel m.array || sel m.structure) { next = rounded(next, a); }
        i = i + 1;
    }
    ret opt[Broken].none{};
}

# refuse a block whose layout, mach's own, breaks the rules vulkan holds its
# class to: std140's extended alignment for a uniform block, std430's base
# alignment for a storage or push-constant one, and for a uniform one too in
# environments that state uniformBufferStandardLayout, as vulkan 1.2 and
# later do, each relaxed for vectors in environments that state relaxed block
# layout, as vulkan 1.1 and later do. a block is never laid out again by other
# rules, since the host writes it by mach's
fun block_rules(u: *Unit, g: usize, ty: Type, class: u32) {
    val extended:   bool        = class::u64 == schema.UNIFORM && !guaranteed(u, ?vulkan.UNIFORM_STANDARD_LAYOUT);
    val relaxed:    bool        = guaranteed(u, ?vulkan.RELAXED_BLOCK_LAYOUT);
    val opt_broken: opt[Broken] = broken(u, ty, class, 0, extended, relaxed);
    if (sel opt_broken.none) { ret; }
    var rules: str = "std430";
    if (extended) { rules = "std140"; }
    unit.fail(u, Error.interface{Interface{site: Site.global{(g::u32)}, rule: Rule.layout{Layout{rules: rules, offset: opt_broken.some.offset, placed: opt_broken.some.placed}}}});
}

# the capabilities a scalar of 8 or 16 bits needs in memory the host shares,
# by the class it is in, the width and whether the class is written as
# another: the storage feature of that width for a block, a push-constant
# block or a stage's interface, which has none of 8 bits. a storage block
# written as a Uniform BufferBlock one is no block in the StorageBuffer or
# Uniform class an 8-bit feature names (spir-v 1.6, 3.31 capability), so an
# 8-bit member needs the StorageBuffer class, which the extension that
# states it gives below spir-v 1.3
fun shared_narrow(u: *Unit, g: usize, class: u32, bits: u32) {
    val c: u64 = class::u64;
    if (c == schema.STORAGE_BUFFER || c == schema.PHYSICAL_STORAGE_BUFFER) {
        if (bits == 16)                 { unit.need(u, gen_extension.STORAGEBUFFER16BITACCESS); }
        or (written(u, class) != class) { unit.fail(u, Error.unmet{"SPV_KHR_storage_buffer_storage_class"}); }
        or                              { unit.need(u, gen_extension.STORAGEBUFFER8BITACCESS); }
        ret;
    }
    if (c == schema.UNIFORM) {
        if (bits == 16) { unit.need(u, gen_extension.UNIFORMANDSTORAGEBUFFER16BITACCESS); }
        or              { unit.need(u, gen_extension.UNIFORMANDSTORAGEBUFFER8BITACCESS); }
        ret;
    }
    if (c == schema.PUSH_CONSTANT) {
        if (bits == 16) { unit.need(u, gen_extension.STORAGEPUSHCONSTANT16); }
        or              { unit.need(u, gen_extension.STORAGEPUSHCONSTANT8); }
        ret;
    }
    if (c == schema.INPUT || c == schema.OUTPUT) {
        if (bits == 16) { unit.need(u, gen_extension.STORAGEINPUTOUTPUT16); }
        or              { unit.fail(u, Error.interface{Interface{site: Site.global{(g::u32)}, rule: Rule.narrow{bits}}}); }
    }
}

# what an integer of 8 or 16 bits or an f16 needs where no host shares the
# memory it is in, or as a member of an aggregate value: its width's own
# capability, Float16 for an f16, which the build need not hold, as a scalar
# value of the width is carried. its members and lanes are taken through
pub fun unshared(u: *Unit, ty: Type) {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret; }
    val k: table.Shape = opt_shape.some;
    if (sel k.integer || sel k.float || sel k.vector) {
        val bits: u32 = bits_of(u, ty);
        if (bits == 16 && floating(u, ty)) {
            unit.need(u, gen_extension.FLOAT16);
            ret;
        }
        if ((bits == 8 || bits == 16) && !floating(u, ty)) {
            val opt_needs: opt[requirement.Id] = width_capability(bits);
            if (sel opt_needs.some) { unit.need(u, opt_needs.some); }
        }
        ret;
    }
    if (sel k.array) {
        unshared(u, k.array.element);
        ret;
    }
    if (sel k.union) {
        val opt_union_member: opt[Type] = union_member(u, ty, PLAIN);
        if (sel opt_union_member.some) { unshared(u, opt_union_member.some); }
        ret;
    }
    if (sel k.structure) {
        var i: usize = 0;
        for (i < k.structure.members.size) {
            unshared(u, k.structure.members.data[i]);
            i = i + 1;
        }
    }
}

# the storage capabilities what a global of a class holds needs for every
# scalar of 8 or 16 bits in it, an f16 included, its members' and lanes'
fun shared_storage(u: *Unit, g: usize, ty: Type, class: u32) {
    val opt_shape: opt[table.Shape] = shape(u, ty);
    if (sel opt_shape.none) { ret; }
    val k: table.Shape = opt_shape.some;
    if (sel k.integer || sel k.float || sel k.vector) {
        val bits: u32 = bits_of(u, ty);
        if ((bits == 8 || bits == 16) && !boolean(u, ty)) { shared_narrow(u, g, class, bits); }
        ret;
    }
    if (sel k.array) {
        shared_storage(u, g, k.array.element, class);
        ret;
    }
    if (sel k.union) {
        val opt_union_member: opt[Type] = union_member(u, ty, PLAIN);
        if (sel opt_union_member.some) { shared_storage(u, g, opt_union_member.some, class); }
        ret;
    }
    if (sel k.structure) {
        var i: usize = 0;
        for (i < k.structure.members.size && unit.ok(u)) {
            shared_storage(u, g, k.structure.members.data[i], class);
            i = i + 1;
        }
    }
}

# whether a global of a storage class is one another unit defines: a
# Private one with no initial value, as every other class declares its
# variables wherever they are used
pub fun imported(u: *Unit, g: usize) bool {
    ret u.classes.data[g]::u64 == schema.PRIVATE && sel u.m.globals.data[g].data.initial.none;
}

# whether a value of `ty` is carried in 32 bits: a scalar or vector of 16 bits
# whose own capability, Int16 or Float16, the build does not hold, so no
# constant of its type can be formed (spir-v 1.6, 2.16.1: a constant of an 8-
# or 16-bit type needs the type's capability)
pub fun carried(u: *Unit, ty: Type) bool {
    if (!scalar_or_vector(u, ty) || bits_of(u, ty) != 16) { ret false; }
    ret !core_state.holds(?u.b.basis.context, carrier_capability(u, ty));
}

# the capability a 16-bit type's own constants and arithmetic need
fun carrier_capability(u: *Unit, ty: Type) requirement.Id {
    if (floating(u, ty)) { ret gen_extension.FLOAT16; }
    ret gen_extension.INT16;
}

# whether global `g` is a stage output of a carried type that starts at zero,
# its initializer zero or absent, which the stage stores itself (manifest.md,
# finished-module targets)
pub fun zero_started(u: *Unit, g: usize) bool {
    val d: GlobalData = u.m.globals.data[g].data;
    if (u.classes.data[g]::u64 != schema.OUTPUT || !carried(u, d.type)) { ret false; }
    val opt_initial: opt[Constant] = d.initial;
    if (sel opt_initial.none) { ret true; }
    val res_data: res[ConstantData, module.Error] = module.constant_data(u.m, opt_initial.some);
    if (sel res_data.err) { ret false; }
    val c: ConstantData = res_data.ok;
    if (sel c.zero)    { ret true; }
    if (sel c.integer) { ret zero_words(c.integer.words); }
    if (sel c.float)   { ret zero_words(c.float.words); }
    ret false;
}

fun zero_words(words: Slice[u64]) bool {
    var i: usize = 0;
    for (i < words.size) {
        if (words.data[i] != 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# a variable for every global, in its storage class, decorated as its
# attributes state and named as its symbol is. a block's variable holds the
# Block-decorated structure of its type
pub fun variables(u: *Unit) {
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        val node:  *global.Node     = ?u.m.globals.data[g];
        val list:  Slice[Attribute] = Slice[Attribute]{data: node.attributes.data, size: node.attributes.len};
        val class: u32              = schema.storage(list)::u32;
        val key:   u32              = variable_key(u, class);
        val d:     GlobalData       = node.data;
        if (blocked(class)) {
            val opt_shape: opt[table.Shape] = shape(u, d.type);
            var ok:        bool             = false;
            if (sel opt_shape.some) {
                val sh: table.Shape = opt_shape.some;
                ok = sel sh.structure;
            }
            if (!ok) {
                unit.fail(u, Error.storage{(g::u32)});
                ret;
            }
            block_rules(u, g, d.type, class);
            if (!unit.ok(u)) { ret; }
        }
        val c: u64 = class::u64;
        if (blocked(class) || c == schema.INPUT || c == schema.OUTPUT) {
            shared_storage(u, g, d.type, class);
            if (!unit.ok(u)) { ret; }
        }
        or { unshared(u, d.type); }
        val pointee: u32 = type_of(u, d.type, key);
        if (pointee == NONE) { ret; }
        val id: u32 = unit.fresh(u);
        unit.keep(u, pushed(vector.push[u32](?u.globals, id)));
        unit.keep(u, pushed(vector.push[u32](?u.classes, class)));
        unit.keep(u, pushed(vector.push[u32](?u.keys, key)));
        val held: bool = coherent(list);
        unit.keep(u, pushed(vector.push[opt[u32]](?u.scopes, scope_of(u, class, held))));
        if (held && (blocked(class) || c == schema.PHYSICAL_STORAGE_BUFFER)) { u.coherent = true; }
        if (held && image_type(u, d.type))                                   { u.images = true; }
        g = g + 1;
    }
    g = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        val node:  *global.Node     = ?u.m.globals.data[g];
        val list:  Slice[Attribute] = Slice[Attribute]{data: node.attributes.data, size: node.attributes.len};
        val class: u32              = u.classes.data[g];
        val key:   u32              = u.keys.data[g];
        val d:     GlobalData       = node.data;
        val ptr:   u32              = pointer_type(u, class, type_of(u, d.type, key));
        var init:  Slot             = Slot.none{};
        # workgroup memory takes its zero only where the environment zeroes it, and the stage zeroes it elsewhere
        var opt_initial: opt[Constant] = d.initial;
        if (class::u64 == schema.WORKGROUP && !guaranteed(u, ?vulkan.ZERO_INITIALIZED_WORKGROUP)) { opt_initial = opt[Constant].none{}; }
        # a carried output's zero is no constant, and the stage stores it first (module.prologue)
        if (zero_started(u, g))                                { opt_initial = opt[Constant].none{}; }
        or (class::u64 == schema.OUTPUT && carried(u, d.type)) { unit.need(u, carrier_capability(u, d.type)); }
        if (sel opt_initial.some) {
            val c: u32 = constant_of(u, opt_initial.some, key);
            if (c == NONE) { ret; }
            init = Slot.id{c};
        }
        var slots: [4]Slot = [4]Slot{Slot.id{ptr}, Slot.id{u.globals.data[g]}, unit.enumerant(written(u, class)), init};
        unit.put(u, buffer.TYPES, gen_row_index.OPVARIABLE, ?slots[0], 4);
        decorated(u, u.globals.data[g], list);
        name(u, u.globals.data[g], module.name_of(u.m, d.name));
        if (sel d.debug.some) {
            if (blocked(class)) { block_names(u, type_of(u, d.type, key), d.debug.some); }
        }
        g = g + 1;
    }
}

fun pushed(got: res[usize, allocator.Error]) err[allocator.Error] {
    if (sel got.err) { ret err[allocator.Error].err{got.err}; }
    ret err[allocator.Error].ok{};
}

# a structure of member types no ir type is, as an extended arithmetic
# instruction's result or a call's several results, made once by its members
pub fun struct_of(u: *Unit, members: *u32, n: usize) u32 {
    val opt_shaped: opt[u32] = shaped(u, gen_row_index.OPTYPESTRUCT, 0, 0, members, n);
    if (sel opt_shaped.some) { ret opt_shaped.some; }
    val id:    u32     = unit.fresh(u);
    var slots: [2]Slot = [2]Slot{Slot.id{id}, Slot.list{unit.list(u, members, n)}};
    unit.put(u, buffer.TYPES, gen_row_index.OPTYPESTRUCT, ?slots[0], 2);
    remember(u, gen_row_index.OPTYPESTRUCT, 0, 0, members, n, id);
    ret id;
}

# a structure of two members of one type
pub fun pair_of(u: *Unit, member: u32) u32 {
    var m: [2]u32 = [2]u32{member, member};
    ret struct_of(u, ?m[0], 2);
}
