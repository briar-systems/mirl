# what every instruction of a module is made against
#
# the module's ids are numbered from 1 in the order they are asked for, and
# every instruction is held in the buffer's section of the logical layout it
# belongs to. a type spir-v holds once, a scalar, vector, pointer or function
# type, is made once by its shape, and an aggregate once for each layout its
# storage classes lay it out by. every function's signature is read before
# any body, since a pointer parameter's type is what it points to, which only
# its function's code states.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.map;
use std.collections.vector;

use masc.core.requirement;
use core_state: masc.core.state;
use masc.isa.spirv.gen_extension;

use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.ir.type.Type;
use mirl.pass.cache.Cache;
use mirl.target.build.Build;
use mirl.target.layout.Layout;
use mirl.target.record.Target;
use mirl.target.spirv.buffer;
use mirl.target.spirv.buffer.Buffer;
use mirl.target.spirv.buffer.Slot;
use mirl.target.spirv.buffer.Span;
use mirl.target.spirv.error.Error;

# no id, and no type of a pointer's pointee
pub val NONE: u32 = 0;

# a type spir-v declares once by its shape
# ---
# row:  the row that declares it
# a:    its first operand
# b:    its second
# list: its operand list, a function type's parameters
# id:   its id
pub rec Shape {
    row:  u32;
    a:    u32;
    b:    u32;
    list: Span;
    id:   u32;
}

# a scalar constant made by its bits
# ---
# type:  its type's id
# value: its bits
# id:    its id
pub rec Made {
    type:  u32;
    value: u64;
    id:    u32;
}

# a specialization constant made by its id
# ---
# spec: its SpecId
# id:   its id
pub rec Special {
    spec: u32;
    id:   u32;
}

# what a function is called as
# ---
# type:     its function type's id
# result:   the id of the type it returns: void for no result, its result's
#           for one and a structure of them for more
# results:  how many results it has
# params:   the id of each parameter's type, a run of the unit's lists
# pointees: the ir type each pointer parameter points to, its index, NONE
#           for a parameter that is no pointer, a run of the unit's lists
pub rec Signature {
    type:     u32;
    result:   u32;
    results:  u32;
    params:   Span;
    pointees: Span;
}

# how a module states where its code came from
# ---
# none:     it states nothing, as its module has no source files
# lines:    by OpString and OpLine
# semantic: by NonSemantic.Shader.DebugInfo.100
pub tag Lines: u8 {
    none;
    lines;
    semantic;
}

# what a module's debug information is made of
# ---
# lines:   how it states lines
# files:   the OpString of each source file's path
# sources: the DebugSource of each source file
# set:     the NonSemantic.Shader.DebugInfo.100 import
# unit:    the DebugCompilationUnit
pub rec Debug {
    lines:   Lines;
    files:   vector.Vector[u32];
    sources: vector.Vector[u32];
    set:     u32;
    unit:    u32;
}

# a module laid out for its bodies
# ---
# a:          the allocator every stage takes
# m:          the module
# b:          the build
# t:          the target
# l:          the layout of the module's types
# cache:      the analyses of the module's functions
# buf:        the module's instructions
# next:       the next id
# shapes:     the types declared once by their shape
# lists:      the runs shapes and signatures hold
# types:      each ir type's id, by its index and the key of its layout
# constants:  each constant's id, by its index and the key of its layout
# made:       each scalar constant made by its bits
# specs:      each specialization constant made by its SpecId
# globals:    each global's variable
# classes:    each global's storage class
# keys:       the key of the layout of what each global holds
# functions:  each function's id
# signatures: each function's signature
# glsl:       the id of the GLSL.std.450 import, NONE until one is asked for
# floats:     the widths of the float types the module declares, a bit per
#             width: 1 for 16, 2 for 32 and 4 for 64
# debug:      its debug information
# failed:     the first refusal, after which nothing more is made
pub rec Unit {
    a:          *allocator.Allocator;
    m:          *Module;
    b:          *Build;
    t:          *Target;
    l:          *Layout;
    cache:      *Cache;
    buf:        Buffer;
    next:       u32;
    shapes:     vector.Vector[Shape];
    lists:      vector.Vector[u32];
    types:      map.Map[u64, u32];
    constants:  map.Map[u64, u32];
    made:       vector.Vector[Made];
    specs:      vector.Vector[Special];
    globals:    vector.Vector[u32];
    classes:    vector.Vector[u32];
    keys:       vector.Vector[u32];
    functions:  vector.Vector[u32];
    signatures: vector.Vector[Signature];
    glsl:       u32;
    floats:     u32;
    debug:      Debug;
    failed:     opt[Error];
}

# a unit of no instructions over a module and its build
pub fun make(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, l: *Layout, cache: *Cache) Unit {
    ret Unit{
        a:          a,
        m:          m,
        b:          b,
        t:          t,
        l:          l,
        cache:      cache,
        buf:        buffer.make(a),
        next:       1,
        shapes:     vector.init[Shape](a),
        lists:      vector.init[u32](a),
        types:      map.init[u64, u32](a),
        constants:  map.init[u64, u32](a),
        made:       vector.init[Made](a),
        specs:      vector.init[Special](a),
        globals:    vector.init[u32](a),
        classes:    vector.init[u32](a),
        keys:       vector.init[u32](a),
        functions:  vector.init[u32](a),
        signatures: vector.init[Signature](a),
        glsl:       NONE,
        floats:     0,
        debug:      Debug{lines: Lines.none{}, files: vector.init[u32](a), sources: vector.init[u32](a), set: NONE, unit: NONE},
        failed:     opt[Error].none{},
    };
}

# give back a unit's storage
pub fun release(u: *Unit) {
    buffer.release(?u.buf);
    vector.dnit[Shape](?u.shapes);
    vector.dnit[u32](?u.lists);
    map.dnit[u64, u32](?u.types);
    map.dnit[u64, u32](?u.constants);
    vector.dnit[Made](?u.made);
    vector.dnit[Special](?u.specs);
    vector.dnit[u32](?u.globals);
    vector.dnit[u32](?u.classes);
    vector.dnit[u32](?u.keys);
    vector.dnit[u32](?u.functions);
    vector.dnit[Signature](?u.signatures);
    vector.dnit[u32](?u.debug.files);
    vector.dnit[u32](?u.debug.sources);
}

# keep the first refusal
pub fun fail(u: *Unit, why: Error) {
    val first: bool = sel u.failed.none;
    if (first) { u.failed = opt[Error].some{why}; }
}

# keep the allocator's refusal
pub fun lost(u: *Unit, why: allocator.Error) {
    fail(u, Error.alloc{why});
}

# whether nothing was refused yet
pub fun ok(u: *Unit) bool {
    ret sel u.failed.none;
}

# keep a refusal of storage
pub fun keep(u: *Unit, got: err[allocator.Error]) {
    if (sel got.err) { lost(u, got.err); }
}

# the next id
pub fun fresh(u: *Unit) u32 {
    val id: u32 = u.next;
    u.next = u.next + 1;
    ret id;
}

# hold an instruction of a row in a section
pub fun put(u: *Unit, section: usize, row: u32, slots: *Slot, n: usize) {
    if (!ok(u)) { ret; }
    val got: err[allocator.Error] = buffer.put(?u.buf, section, row, slots, n);
    keep(u, got);
}

# whether a context holds an atom, Linkage held of every module
pub fun holds(ctx: *core_state.Context, id: requirement.Id) bool {
    ret id == gen_extension.LINKAGE || core_state.holds(ctx, id);
}

# whether a context meets one way of a requirement
pub fun meets(ctx: *core_state.Context, alt: requirement.Alternative) bool {
    var i: u32 = 0;
    for (i < alt.all.len) {
        if (!holds(ctx, alt.all.at[i])) { ret false; }
        i = i + 1;
    }
    i = 0;
    for (i < alt.none.len) {
        if (core_state.holds(ctx, alt.none.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether the build meets some way of a requirement, as a row with none is met
pub fun admits(u: *Unit, r: requirement.Requirement) bool {
    if (r.len == 0) { ret true; }
    var k: u32 = 0;
    for (k < r.len) {
        if (meets(?u.b.basis.context, r.at[k])) { ret true; }
        k = k + 1;
    }
    ret false;
}

# an atom the module needs that no row states
pub fun need(u: *Unit, id: requirement.Id) {
    keep(u, buffer.need_atom(?u.buf, id));
}

# a run of ids held as a list of slots
pub fun list(u: *Unit, ids: *u32, n: usize) Span {
    val got: res[Span, allocator.Error] = buffer.ids(?u.buf, ids, n);
    if (sel got.err) {
        lost(u, got.err);
        ret buffer.EMPTY;
    }
    ret got.ok;
}

# a run of immediates held as a list of slots
pub fun numbers(u: *Unit, values: *u32, n: usize) Span {
    val got: res[Span, allocator.Error] = buffer.immediates(?u.buf, values, n);
    if (sel got.err) {
        lost(u, got.err);
        ret buffer.EMPTY;
    }
    ret got.ok;
}

# a run of slots held
pub fun slots(u: *Unit, values: *Slot, n: usize) Span {
    val got: res[Span, allocator.Error] = buffer.run(?u.buf, values, n);
    if (sel got.err) {
        lost(u, got.err);
        ret buffer.EMPTY;
    }
    ret got.ok;
}

# a string's bytes held
pub fun text(u: *Unit, v: View) Span {
    val got: res[Span, allocator.Error] = buffer.text(?u.buf, v);
    if (sel got.err) {
        lost(u, got.err);
        ret buffer.EMPTY;
    }
    ret got.ok;
}

# a number's whole words held
pub fun words(u: *Unit, value: u64, n: u32) Span {
    val got: res[Span, allocator.Error] = buffer.words(?u.buf, value, n);
    if (sel got.err) {
        lost(u, got.err);
        ret buffer.EMPTY;
    }
    ret got.ok;
}

# a run of the unit's lists, copied
pub fun keep_list(u: *Unit, ids: *u32, n: usize) Span {
    val at: u32   = u.lists.len::u32;
    var i:  usize = 0;
    for (i < n) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?u.lists, ids[i]);
        if (sel pushed.err) {
            lost(u, pushed.err);
            ret buffer.EMPTY;
        }
        i = i + 1;
    }
    ret Span{at: at, len: n::u32};
}

# the id of an enumerant of no params
pub fun enumerant(value: u32) Slot {
    ret Slot.enumerant{buffer.Chosen{value: value, params: buffer.EMPTY}};
}

# the id of an enumerant of params
pub fun enumerant_of(value: u32, params: Span) Slot {
    ret Slot.enumerant{buffer.Chosen{value: value, params: params}};
}

# the signature of a function
pub fun signature(u: *Unit, f: Function) *Signature {
    ret ?u.signatures.data[f.index];
}

# the key an ir type and a layout are cached by
pub fun cache_key(ty: Type, key: u32) u64 {
    ret (ty.index::u64 << 32) | key::u64;
}
