# the handle kinds spir-v mints, each a type its row of masc's set makes
#
# a handle's operands are its type row's own operands in order: a type
# operand is the id of its type, and a word is an enumerant or literal as the
# row states it, or the id of a 32-bit unsigned constant where the row takes
# an id, as a cooperative matrix's scope, rows, columns and use

use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.target.capability.Admits;
use mirl.target.capability.HandlePart;
use mirl.target.capability.Minted;

val NO_PARTS: Slice[HandlePart] = Slice[HandlePart]{data: nil, size: 0};

val ANY_WORD: Slice[u32] = Slice[u32]{data: nil, size: 0};

# Dim: 1D, 2D, 3D, Cube, Rect, Buffer, SubpassData and TileImageDataEXT
val DIMS: [8]u32 = [8]u32{0, 1, 2, 3, 4, 5, 6, 4173};

# Depth: not a depth image, a depth image, unknown; and Sampled: unknown,
# sampled, storage
val THREE: [3]u32 = [3]u32{0, 1, 2};

# Arrayed and MS
val TWO: [2]u32 = [2]u32{0, 1};

# OpTypeImage: sampled type, Dim, Depth, Arrayed, MS, Sampled, Image Format
# and the optional Access Qualifier
val IMAGE: [8]HandlePart = [8]HandlePart{
    HandlePart.typed{Admits.scalar{}},
    HandlePart.word{Slice[u32]{data: ?DIMS[0], size: 8}},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
    HandlePart.word{Slice[u32]{data: ?TWO[0], size: 2}},
    HandlePart.word{Slice[u32]{data: ?TWO[0], size: 2}},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
    HandlePart.word{ANY_WORD},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
};

# OpTypeSampledImage: its image
val SAMPLED_IMAGE: [1]HandlePart = [1]HandlePart{HandlePart.typed{Admits.handle{"spirv.image"}}};

# OpTypeCooperativeMatrixKHR: component type, scope, rows, columns and use
val COOPERATIVE_MATRIX: [5]HandlePart = [5]HandlePart{
    HandlePart.typed{Admits.scalar{}},
    HandlePart.word{ANY_WORD},
    HandlePart.word{ANY_WORD},
    HandlePart.word{ANY_WORD},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
};

pub val COUNT: usize = 6;

# sorted by name
pub val KINDS: [6]Minted = [6]Minted{
    Minted{name: "spirv.acceleration_structure", operands: NO_PARTS, least: 0, key: "OpTypeAccelerationStructureKHR"},
    Minted{name: "spirv.cooperative_matrix", operands: Slice[HandlePart]{data: ?COOPERATIVE_MATRIX[0], size: 5}, least: 5, key: "OpTypeCooperativeMatrixKHR"},
    Minted{name: "spirv.image", operands: Slice[HandlePart]{data: ?IMAGE[0], size: 8}, least: 7, key: "OpTypeImage"},
    Minted{name: "spirv.ray_query", operands: NO_PARTS, least: 0, key: "OpTypeRayQueryKHR"},
    Minted{name: "spirv.sampled_image", operands: Slice[HandlePart]{data: ?SAMPLED_IMAGE[0], size: 1}, least: 1, key: "OpTypeSampledImage"},
    Minted{name: "spirv.sampler", operands: NO_PARTS, least: 0, key: "OpTypeSampler"},
};
