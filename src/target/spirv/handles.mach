# the handle kinds spir-v mints, each a type its row of masc's set makes
#
# a handle's operands are its type row's own operands in order: a type
# operand is the id of its type, and a word is an enumerant or literal as the
# row states it, or the id of a 32-bit unsigned constant where the row takes
# an id, as a cooperative matrix's scope, rows, columns and use

use std.types.option.opt;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.isa.spirv.gen_typing;
use masc.isa.spirv.typing;

use masc.isa.spirv.gen_extension;

use mirl.target.capability.Admits;
use mirl.target.capability.Apart;
use mirl.target.capability.Attachment;
use mirl.target.capability.Binding;
use mirl.target.capability.Composed;
use mirl.target.capability.Composing;
use mirl.target.capability.Confined;
use mirl.target.capability.HandlePart;
use mirl.target.capability.Holding;
use mirl.target.capability.Minted;
use mirl.target.capability.Number;
use mirl.target.capability.Numbered;
use mirl.target.capability.Texels;
use mirl.target.capability.Tie;

val NO_PARTS: Slice[HandlePart] = Slice[HandlePart]{data: nil, size: 0};

val ANY_WORD: Slice[u32] = Slice[u32]{data: nil, size: 0};

# Dim: 1D, 2D, 3D, Cube, Rect, Buffer, SubpassData and TileImageDataEXT
val DIMS: [8]u32 = [8]u32{0, 1, 2, 3, 4, 5, 6, 4173};

# Depth: not a depth image, a depth image, or no indication either way, the
# Access Qualifier: read only, write only, read and write, and a cooperative
# matrix's use
val THREE: [3]u32 = [3]u32{0, 1, 2};

# Arrayed and MS
val TWO: [2]u32 = [2]u32{0, 1};

# Sampled: sampled or storage, as vulkan takes no image whose Sampled is 0,
# known only at run time (VUID-StandaloneSpirv-OpTypeImage-04657)
val SAMPLED: [2]u32 = [2]u32{1, 2};

# OpTypeImage: sampled type, Dim, Depth, Arrayed, MS, Sampled, Image Format
# and the optional Access Qualifier
val IMAGE: [8]HandlePart = [8]HandlePart{
    HandlePart.typed{Admits.scalar{}},
    HandlePart.word{Slice[u32]{data: ?DIMS[0], size: 8}},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
    HandlePart.word{Slice[u32]{data: ?TWO[0], size: 2}},
    HandlePart.word{Slice[u32]{data: ?TWO[0], size: 2}},
    HandlePart.word{Slice[u32]{data: ?SAMPLED[0], size: 2}},
    HandlePart.word{ANY_WORD},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
};

# OpTypeSampledImage: its image
val SAMPLED_IMAGE: [1]HandlePart = [1]HandlePart{HandlePart.typed{Admits.handle{"spirv.image"}}};

# OpTypeCooperativeMatrixKHR: component type, scope, rows, columns and use
val COOPERATIVE_MATRIX: [5]HandlePart = [5]HandlePart{
    HandlePart.typed{Admits.scalar{}},
    HandlePart.word{ANY_WORD},
    HandlePart.word{ANY_WORD},
    HandlePart.word{ANY_WORD},
    HandlePart.word{Slice[u32]{data: ?THREE[0], size: 3}},
};

# the number an image of Image Format `format` reads its texels as, which
# masc's typing data states for each format, none for Unknown
fun image_format(format: u32) opt[Number] {
    val opt_format: opt[*typing.Format] = typing.format_of(?gen_typing.IMAGE_FORMATS[0], gen_typing.IMAGE_FORMAT_COUNT, format);
    if (sel opt_format.none) { ret opt[Number].none{}; }
    val f: *typing.Format = opt_format.some;
    ret opt[Number].some{Number{float: f.class == typing.FLOAT, signed: f.class == typing.SIGNED, bits: f.bits::u32, lanes: f.lanes::u32}};
}

# an image is a storage image where its Sampled operand is 2 (spir-v 1.6,
# OpTypeImage), and its texel scalar is the number its format names (vulkan,
# image format and type matching, VUID-StandaloneSpirv-Image-04965)
val STORAGE_IMAGE: Binding = Binding.storage{Holding{operand: 5, value: 2}};
val FORMATTED:     Texels  = Texels.numbered{Numbered{texel: 0, word: 6, number: image_format}};

# a sampled image composes over an image whose Sampled operand is 1 (vulkan,
# VUID-StandaloneSpirv-OpTypeSampledImage-06671), never a storage or subpass
# image, whose Sampled is 2
val SAMPLED_ONLY: Composed = Composed.holding{Composing{operand: 0, held: Holding{operand: 5, value: 1}, apart: Slice[Apart]{data: ?UNBUFFERED[0], size: 1}}};

# from spir-v 1.6 a sampled image composes over no image whose Dim is Buffer (spir-v 1.6, OpTypeSampledImage)
val UNBUFFERED: [1]Apart = [1]Apart{Apart{held: Holding{operand: 1, value: 5}, from: gen_extension.SPV1_6, why: "from SPIR-V 1.6 an OpTypeSampledImage must not have an image of Dim Buffer (spir-v 1.6, OpTypeSampledImage), so a texel buffer is read with OpImageFetch of the image itself"}};

val NO_TIES: Slice[Tie] = Slice[Tie]{data: nil, size: 0};

# a SubpassData image is a storage image of Unknown format (spir-v 1.6, OpTypeImage) and not arrayed (vulkan,
# VUID-StandaloneSpirv-OpTypeImage-06214)
val SUBPASS_WORDS: [3]Holding = [3]Holding{Holding{operand: 5, value: 2}, Holding{operand: 6, value: 0}, Holding{operand: 3, value: 0}};
val SUBPASS:       [1]Tie     = [1]Tie{Tie{when: Holding{operand: 1, value: 6}, then: Slice[Holding]{data: ?SUBPASS_WORDS[0], size: 3}, why: "a SubpassData image has Sampled 2 and Image Format Unknown (spir-v 1.6, OpTypeImage) and Arrayed 0 (vulkan's VUID-StandaloneSpirv-OpTypeImage-06214)"}};

# a SubpassData image is a subpass input, which reads the input attachment its InputAttachmentIndex names (vulkan,
# fragment input attachment interface), and which vulkan requires that decoration of where the pass does not map
# attachments by dynamic rendering local read (VUID-RuntimeSpirv-None-09558)
val SUBPASS_INPUT: Attachment = Attachment.holding{Holding{operand: 1, value: 6}};

val NO_CONFINES: Slice[Confined] = Slice[Confined]{data: nil, size: 0};

# the Fragment execution model
val FRAGMENT: [1]u32 = [1]u32{4};

# a SubpassData image exists only in the Fragment execution model (spir-v 1.6, OpTypeImage)
val SUBPASS_STAGE: [1]Confined = [1]Confined{Confined{when: Holding{operand: 1, value: 6}, models: Slice[u32]{data: ?FRAGMENT[0], size: 1}, names: "Fragment",
    why: "an image of Dim SubpassData exists only in the Fragment execution model (spir-v 1.6, OpTypeImage), since it reads the attachment at the fragment's own place"}};

pub val COUNT: usize = 6;

# sorted by name
pub val KINDS: [6]Minted = [6]Minted{
    Minted{name: "spirv.acceleration_structure", operands: NO_PARTS, least: 0, key: "OpTypeAccelerationStructureKHR", binding: Binding.sampled{}, attachment: Attachment.none{}, texels: Texels.none{}, composed: Composed.none{}, ties: NO_TIES, confined: NO_CONFINES},
    Minted{name: "spirv.cooperative_matrix", operands: Slice[HandlePart]{data: ?COOPERATIVE_MATRIX[0], size: 5}, least: 5, key: "OpTypeCooperativeMatrixKHR", binding: Binding.sampled{}, attachment: Attachment.none{}, texels: Texels.none{}, composed: Composed.none{}, ties: NO_TIES, confined: NO_CONFINES},
    Minted{name: "spirv.image", operands: Slice[HandlePart]{data: ?IMAGE[0], size: 8}, least: 7, key: "OpTypeImage", binding: STORAGE_IMAGE, attachment: SUBPASS_INPUT, texels: FORMATTED, composed: Composed.none{}, ties: Slice[Tie]{data: ?SUBPASS[0], size: 1}, confined: Slice[Confined]{data: ?SUBPASS_STAGE[0], size: 1}},
    Minted{name: "spirv.ray_query", operands: NO_PARTS, least: 0, key: "OpTypeRayQueryKHR", binding: Binding.sampled{}, attachment: Attachment.none{}, texels: Texels.none{}, composed: Composed.none{}, ties: NO_TIES, confined: NO_CONFINES},
    Minted{name: "spirv.sampled_image", operands: Slice[HandlePart]{data: ?SAMPLED_IMAGE[0], size: 1}, least: 1, key: "OpTypeSampledImage", binding: Binding.sampled{}, attachment: Attachment.none{}, texels: Texels.none{}, composed: SAMPLED_ONLY, ties: NO_TIES, confined: NO_CONFINES},
    Minted{name: "spirv.sampler", operands: NO_PARTS, least: 0, key: "OpTypeSampler", binding: Binding.sampled{}, attachment: Attachment.none{}, texels: Texels.none{}, composed: Composed.none{}, ties: NO_TIES, confined: NO_CONFINES},
};
