# the execution modes the family states of its own
val ORIGIN_UPPER_LEFT: u32 = 7;
val ORIGIN_LOWER_LEFT: u32 = 8;
val LOCAL_SIZE:        u32 = 0x11;
val LOCAL_SIZE_ID:     u32 = 0x26;
val PRESERVE:          u32 = 0x116D;

# the fragment execution model
val FRAGMENT: u64 = 4;

# the linkage types
val EXPORT: u32 = 0;
val IMPORT: u32 = 1;

# the memory model every module states, GLSL450
val GLSL450: u32 = 1;

fun push_u32(u: *Unit, v: *vector.Vector[u32], x: u32) {
    val pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel pushed.err) { unit.lost(u, pushed.err); }
}

fun attributes(list: *vector.Vector[Attribute]) Slice[Attribute] {
    ret Slice[Attribute]{data: list.data, size: list.len};
}

fun declared(u: *Unit, f: usize) bool {
    ret u.m.functions.data[f].body.blocks.len == 0;
}

fun type_at(d: *InstructionData, slot: usize) opt[Type] {
    if (slot >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

# what a pointer parameter points to, as the function's code reads it: the
# aggregate a member or element is reached in first, else the value an
# access moves. a parameter nothing uses points to an i32
fun pointee(u: *Unit, f: Function, k: usize) opt[Type] {
    val b: *Body = ?u.m.functions.data[f.index].body;
    if (b.blocks.len == 0) {
        unit.fail(u, Error.unpointed{At{function: f, instruction: NOWHERE}});
        ret opt[Type].none{};
    }
    val v:    Value                       = b.blocks.data[0].parameters.data[k];
    val uses: *vector.Vector[Instruction] = ?b.values.data[v.index].uses;
    var j:    usize                       = 0;
    for (j < uses.len) {
        val d: *InstructionData = ?b.instructions.data[uses.data[j].index];
        val c: u32              = d.opcode.index;
        if ((c == opcode.PTR_MEMBER.index || c == opcode.PTR_INDEX.index) && d.operands.data[0].index == v.index) {
            val t: opt[Type] = type_at(d, 0);
            if (sel t.some) { ret t; }
        }
        j = j + 1;
    }
    j = 0;
    for (j < uses.len) {
        val d: *InstructionData = ?b.instructions.data[uses.data[j].index];
        val c: u32              = d.opcode.index;
        if (d.operands.len > 0 && d.operands.data[0].index == v.index) {
            if ((c == opcode.LOAD.index || c == opcode.ATOMIC_LOAD.index) && d.results.len > 0) { ret opt[Type].some{b.values.data[d.results.data[0].index].type}; }
            if ((c == opcode.STORE.index || access.atomic(c)) && d.operands.len > 1)            { ret opt[Type].some{b.values.data[d.operands.data[1].index].type}; }
        }
        j = j + 1;
    }
    if (uses.len == 0) {
        val word: res[Type, types.Error] = types.intern(?u.m.types, types.Shape.integer{types.Integer{width: 32}});
        if (sel word.err) {
            unit.fail(u, Error.ir{module.Error.types{word.err}});
            ret opt[Type].none{};
        }
        ret opt[Type].some{word.ok};
    }
    unit.fail(u, Error.unpointed{At{function: f, instruction: uses.data[0]}});
    ret opt[Type].none{};
}

fun space_of(u: *Unit, ty: Type) u32 {
    val s: res[types.Shape, types.Error] = types.shape(?u.m.types, ty);
    if (sel s.ok) {
        val k: types.Shape = s.ok;
        if (sel k.pointer) { ret k.pointer.space; }
    }
    ret 0;
}

# what every function is called as
fun signatures(u: *Unit) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        val id:    Function                      = Function{index: f::u32};
        val fd:    FunctionData                  = u.m.functions.data[f].data;
        val shape: res[types.Shape, types.Error] = types.shape(?u.m.types, fd.signature);
        if (sel shape.err) {
            unit.fail(u, Error.ir{module.Error.types{shape.err}});
            ret;
        }
        val sh: types.Shape = shape.ok;
        if (!(sel sh.function)) {
            unit.fail(u, Error.untyped{fd.signature});
            ret;
        }
        val fs:      types.Function     = sh.function;
        var results: vector.Vector[u32] = vector.init[u32](u.a);
        fin { vector.dnit[u32](?results); }
        var k: usize = 0;
        for (k < fs.results.size) {
            if (spirv_types.pointer(u, fs.results.data[k])) {
                unit.fail(u, Error.variable{At{function: id, instruction: NOWHERE}});
                ret;
            }
            push_u32(u, ?results, spirv_types.type_of(u, fs.results.data[k], spirv_types.PLAIN));
            k = k + 1;
        }
        var result: u32 = spirv_types.void(u);
        if (results.len == 1) { result = results.data[0]; }
        or (results.len > 1)  { result = spirv_types.struct_of(u, results.data, results.len); }
        var params:   vector.Vector[u32] = vector.init[u32](u.a);
        var pointees: vector.Vector[u32] = vector.init[u32](u.a);
        fin {
            vector.dnit[u32](?params);
            vector.dnit[u32](?pointees);
        }
        k = 0;
        for (k < fs.params.size && unit.ok(u)) {
            val pt: Type = fs.params.data[k];
            if (spirv_types.pointer(u, pt)) {
                val to: opt[Type] = pointee(u, id, k);
                if (sel to.none) { ret; }
                val class: u32 = space_of(u, pt);
                val key:   u32 = code.unit_key(u, class, to.some);
                push_u32(u, ?params, spirv_types.pointer_type(u, class, spirv_types.type_of(u, to.some, key)));
                push_u32(u, ?pointees, to.some.index + 1);
            }
            or {
                push_u32(u, ?params, spirv_types.type_of(u, pt, spirv_types.PLAIN));
                push_u32(u, ?pointees, 0);
            }
            k = k + 1;
        }
        val sig: Signature = Signature{
            type:     spirv_types.function_type(u, result, params.data, params.len),
            result:   result,
            results:  results.len::u32,
            params:   unit.keep_list(u, params.data, params.len),
            pointees: unit.keep_list(u, pointees.data, pointees.len),
        };
        val pushed: res[usize, allocator.Error] = vector.push[Signature](?u.signatures, sig);
        if (sel pushed.err) {
            unit.lost(u, pushed.err);
            ret;
        }
        f = f + 1;
    }
}

# the globals a function names and the functions it calls
fun named(u: *Unit, f: usize, globals: *vector.Vector[bool], calls: *vector.Vector[u32]) {
    val b: *Body = ?u.m.functions.data[f].body;
    var k: usize = 0;
    for (k < b.values.len) {
        val d: Def = b.values.data[k].def;
        if (sel d.constant) {
            val c: res[ConstantData, module.Error] = module.constant_data(u.m, d.constant);
            if (sel c.ok) {
                val data: ConstantData = c.ok;
                if (sel data.address) {
                    val s: Symbol = data.address.symbol;
                    if (sel s.global)   { globals.data[s.global.index] = true; }
                    if (sel s.function) { push_u32(u, calls, s.function.index); }
                }
            }
        }
        k = k + 1;
    }
    k = 0;
    for (k < b.instructions.len) {
        val d: *InstructionData = ?b.instructions.data[k];
        if (d.opcode.index == opcode.FUNC_ADDR.index && d.immediates.len > 0) {
            val imm: Immediate = d.immediates.data[0];
            if (sel imm.function) { push_u32(u, calls, imm.function.index); }
        }
        k = k + 1;
    }
}

# the variables an entry point's call tree reaches that its interface lists
fun interface(u: *Unit, f: usize, out: *vector.Vector[u32]) {
    var globals: vector.Vector[bool] = vector.init[bool](u.a);
    var seen:    vector.Vector[bool] = vector.init[bool](u.a);
    var work:    vector.Vector[u32]  = vector.init[u32](u.a);
    fin {
        vector.dnit[bool](?globals);
        vector.dnit[bool](?seen);
        vector.dnit[u32](?work);
    }
    var k: usize = 0;
    for (k < u.m.globals.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?globals, false);
        if (sel pushed.err) {
            unit.lost(u, pushed.err);
            ret;
        }
        k = k + 1;
    }
    k = 0;
    for (k < u.m.functions.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?seen, false);
        if (sel pushed.err) {
            unit.lost(u, pushed.err);
            ret;
        }
        k = k + 1;
    }
    push_u32(u, ?work, f::u32);
    seen.data[f] = true;
    for (work.len > 0 && unit.ok(u)) {
        val next: u32 = work.data[work.len - 1];
        work.len = work.len - 1;
        var calls: vector.Vector[u32] = vector.init[u32](u.a);
        fin { vector.dnit[u32](?calls); }
        named(u, next::usize, ?globals, ?calls);
        var c: usize = 0;
        for (c < calls.len) {
            val g: u32 = calls.data[c];
            if (!seen.data[g]) {
                seen.data[g] = true;
                push_u32(u, ?work, g);
            }
            c = c + 1;
        }
    }
    val all: bool = core_state.holds(?u.b.basis.context, gen_extension.SPV1_4);
    k = 0;
    for (k < globals.len) {
        if (globals.data[k]) {
            val class: u64 = u.classes.data[k]::u64;
            if (schema.interface(class) || (all && class != schema.FUNCTION)) { push_u32(u, out, u.globals.data[k]); }
        }
        k = k + 1;
    }
}

fun mode(u: *Unit, f: u32, m: u32, params: Span) {
    var s: [2]Slot = [2]Slot{Slot.id{f}, unit.enumerant_of(m, params)};
    unit.put(u, buffer.MODES, gen_row_index.OPEXECUTIONMODE, ?s[0], 2);
}

fun stated(list: Slice[u64], m: u32) bool {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i] == m::u64) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a compute stage's workgroup size: LocalSize of its sizes, or LocalSizeId
# where it names a dimension by a specialization constant, each dimension it
# names that constant's id and every other a 32-bit constant of its size
fun workgroup(u: *Unit, f: usize, id: u32, list: Slice[Attribute]) {
    var size: [3]u32     = [3]u32{1, 1, 1};
    val got:  Slice[u64] = schema.integers(list, "workgroup");
    if (got.size == 3) {
        size[0] = got.data[0]::u32;
        size[1] = got.data[1]::u32;
        size[2] = got.data[2]::u32;
    }
    val named: Slice[u64] = schema.integers(list, "workgroup_spec");
    if (named.size == 0) {
        mode(u, id, LOCAL_SIZE, unit.numbers(u, ?size[0], 3));
        ret;
    }
    var ids: [3]Slot = [3]Slot{Slot.none{}, Slot.none{}, Slot.none{}};
    var k:   usize   = 0;
    for (k + 1 < named.size) {
        val c: opt[Constant] = module.specialization(u.m, named.data[k + 1]::u32);
        if (sel c.none) {
            unit.fail(u, Error.workgroup{Function{index: f::u32}});
            ret;
        }
        if (named.data[k] > 2) {
            unit.fail(u, Error.workgroup{Function{index: f::u32}});
            ret;
        }
        ids[named.data[k]::usize] = Slot.id{spirv_types.constant_of(u, c.some, spirv_types.PLAIN)};
        k                         = k + 2;
    }
    k = 0;
    for (k < 3) {
        val at: Slot = ids[k];
        if (sel at.none) { ids[k] = Slot.id{spirv_types.uint(u, 32, size[k]::u64)}; }
        k = k + 1;
    }
    mode_id(u, id, LOCAL_SIZE_ID, unit.slots(u, ?ids[0], 3));
}

fun mode_id(u: *Unit, f: u32, m: u32, params: Span) {
    var s: [2]Slot = [2]Slot{Slot.id{f}, unit.enumerant_of(m, params)};
    unit.put(u, buffer.MODES, gen_row_index.OPEXECUTIONMODEID, ?s[0], 2);
}

# every entry point, its interface and its execution modes: those it
# states, its workgroup size, an origin for a fragment stage that states
# none, and float controls where the build holds them
fun entries(u: *Unit) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        val list:  Slice[Attribute] = attributes(?u.m.functions.data[f].attributes);
        val stage: opt[u64]         = schema.integer(list, "stage");
        if (sel stage.some) {
            val sig: *Signature = ?u.signatures.data[f];
            if (sig.params.len != 0 || sig.results != 0 || declared(u, f)) {
                unit.fail(u, Error.entry{Function{index: f::u32}});
                ret;
            }
            var name: View      = u.m.functions.data[f].data.name;
            val own:  opt[View] = schema.text(list, "entry");
            if (sel own.some) { name = own.some; }
            var ids: vector.Vector[u32] = vector.init[u32](u.a);
            fin { vector.dnit[u32](?ids); }
            interface(u, f, ?ids);
            val id: u32     = u.functions.data[f];
            var s:  [4]Slot = [4]Slot{unit.enumerant(stage.some::u32), Slot.id{id}, Slot.literal{unit.text(u, name)}, Slot.list{unit.list(u, ids.data, ids.len)}};
            unit.put(u, buffer.ENTRIES, gen_row_index.OPENTRYPOINT, ?s[0], 4);
            val modes: Slice[u64] = schema.integers(list, "modes");
            var k:     usize      = 0;
            for (k < modes.size) {
                mode(u, id, modes.data[k]::u32, buffer.EMPTY);
                k = k + 1;
            }
            if (schema.computes(stage.some))                                                                      { workgroup(u, f, id, list); }
            if (stage.some == FRAGMENT && !stated(modes, ORIGIN_UPPER_LEFT) && !stated(modes, ORIGIN_LOWER_LEFT)) { mode(u, id, ORIGIN_UPPER_LEFT, buffer.EMPTY); }
            if (core_state.holds(?u.b.basis.context, gen_extension.SIGNEDZEROINFNANPRESERVE)) {
                var w: [3]u32 = [3]u32{16, 32, 64};
                var b: u32    = 0;
                for (b < 3) {
                    if ((u.floats & (1::u32 << b)) != 0) { mode(u, id, PRESERVE, unit.numbers(u, ?w[b], 1)); }
                    b = b + 1;
                }
            }
        }
        f = f + 1;
    }
}

# a linkage decoration of an id
fun linked(u: *Unit, id: u32, name: View, kind: u32) {
    var params: [2]Slot = [2]Slot{Slot.literal{unit.text(u, name)}, unit.enumerant(kind)};
    var s:      [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(spirv_types.LINKAGE_ATTRIBUTES, unit.slots(u, ?params[0], 2))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?s[0], 2);
}

# the names of the module's functions, and its exports and imports when it
# is an object
fun linkage_of(u: *Unit, relocatable: bool) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        val fd:   FunctionData     = u.m.functions.data[f].data;
        val list: Slice[Attribute] = attributes(?u.m.functions.data[f].attributes);
        val id:   u32              = u.functions.data[f];
        spirv_types.name(u, id, fd.name);
        val stage: opt[u64] = schema.integer(list, "stage");
        if (sel stage.none) {
            if (declared(u, f)) {
                if (relocatable) { linked(u, id, fd.name, IMPORT); }
                or               { unit.fail(u, Error.imported{Import.function{Function{index: f::u32}}}); }
            }
            or (relocatable && linkage.external(fd.linkage)) { linked(u, id, fd.name, EXPORT); }
        }
        f = f + 1;
    }
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        if (u.classes.data[g]::u64 == schema.PRIVATE) {
            val gd: GlobalData = u.m.globals.data[g].data;
            if (spirv_types.imported(u, g)) {
                if (relocatable) { linked(u, u.globals.data[g], gd.name, IMPORT); }
                or               { unit.fail(u, Error.imported{Import.global{Global{index: g::u32}}}); }
            }
            or (relocatable && linkage.external(gd.linkage)) { linked(u, u.globals.data[g], gd.name, EXPORT); }
        }
        g = g + 1;
    }
}

# the capabilities and extensions a module declares
# ---
# capabilities: their values
# extensions:   their atoms
# added:        the atoms declared that the build's selection does not hold
rec Declared {
    capabilities: vector.Vector[u32];
    extensions:   vector.Vector[requirement.Id];
    added:        vector.Vector[requirement.Id];
}

fun has_id(v: *vector.Vector[requirement.Id], id: requirement.Id) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun push_id(u: *Unit, v: *vector.Vector[requirement.Id], id: requirement.Id) {
    if (has_id(v, id)) { ret; }
    val pushed: res[usize, allocator.Error] = vector.push[requirement.Id](v, id);
    if (sel pushed.err) { unit.lost(u, pushed.err); }
}

fun capability_value(id: requirement.Id) opt[u32] {
    var i: u32 = 0;
    for (i < gen_operand.CAPABILITY_ATOM_COUNT) {
        if (gen_operand.CAPABILITY_ATOMS[i].id == id) { ret opt[u32].some{gen_operand.CAPABILITY_ATOMS[i].value::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun version(id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < gen_operand.VERSION_ATOM_COUNT) {
        if (gen_operand.VERSION_ATOMS[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# an atom the module needs, declared as a capability or an extension
fun declare(u: *Unit, d: *Declared, id: requirement.Id) {
    if (version(id))                               { ret; }
    if (!core_state.holds(?u.b.basis.context, id)) { push_id(u, ?d.added, id); }
    val cap: opt[u32] = capability_value(id);
    if (sel cap.some) {
        var i: usize = 0;
        for (i < d.capabilities.len) {
            if (d.capabilities.data[i] == cap.some) { ret; }
            i = i + 1;
        }
        push_u32(u, ?d.capabilities, cap.some);
        ret;
    }
    push_id(u, ?d.extensions, id);
}

fun unmet(u: *Unit, id: requirement.Id) {
    val named: res[str, basis.Error] = basis.extension_name(u.t, id);
    var name:  str                   = "?";
    if (sel named.ok) { name = named.ok; }
    unit.fail(u, Error.unmet{Unmet{name: name}});
}

# what the module's instructions require, met the first way the build holds
fun required(u: *Unit, d: *Declared) {
    val ctx: *core_state.Context = ?u.b.basis.context;
    var i:   usize               = 0;
    for (i < u.buf.needs.len && unit.ok(u)) {
        val r:     requirement.Requirement = u.buf.needs.data[i];
        var found: bool                    = false;
        var k:     u32                     = 0;
        for (k < r.len && !found) {
            if (unit.meets(ctx, r.at[k])) {
                found = true;
                var j: u32 = 0;
                for (j < r.at[k].all.len) {
                    declare(u, d, r.at[k].all.at[j]);
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        if (!found) {
            val first: requirement.Alternative = r.at[0];
            var named: bool                    = false;
            var j:     u32                     = 0;
            for (j < first.all.len && !named) {
                if (!unit.holds(ctx, first.all.at[j])) {
                    unmet(u, first.all.at[j]);
                    named = true;
                }
                j = j + 1;
            }
            if (!named) { unit.fail(u, Error.unmet{Unmet{name: "?"}}); }
        }
        i = i + 1;
    }
    i = 0;
    for (i < u.buf.atoms.len && unit.ok(u)) {
        val id: requirement.Id = u.buf.atoms.data[i];
        if (unit.holds(ctx, id)) { declare(u, d, id); }
        or                       { unmet(u, id); }
        i = i + 1;
    }
}

# the requirement of the GLSL450 memory model, which every module states
fun memory_model(u: *Unit) {
    var i: usize = 0;
    for (i < $length_of(gen_operand.MEMORYMODEL_MEMBERS)) {
        if (gen_operand.MEMORYMODEL_MEMBERS[i].value == GLSL450) { unit.keep(u, buffer.need(?u.buf, gen_operand.MEMORYMODEL_MEMBERS[i].requires)); }
        i = i + 1;
    }
}

# the context the module is built under: the build's, widened by what the
# module declares that the selection does not hold
rec Wide {
    selection: extension.Selection;
    view:      rf.Available;
    context:   core_state.Context;
    made:      bool;
}

fun widen(u: *Unit, d: *Declared, w: *Wide) err[Error] {
    w.made = false;
    if (d.added.len == 0) { ret err[Error].ok{}; }
    val chosen: res[extension.Selection, extension.Error] = extension.added(u.a, ?u.b.basis.selection, requirement.Ids{at: d.added.data, len: d.added.len::u32});
    if (sel chosen.err) { ret err[Error].err{Error.basis{basis.Error.extensions{chosen.err}}}; }
    w.selection = chosen.ok;
    val opened: res[core_state.Context, core_state.Opened] = mset.open(u.a, u.b.basis.set, u.b.basis.arch, ?w.selection, ?w.view);
    if (sel opened.err) {
        val dropped: err[allocator.Error] = extension.release(?w.selection);
        if (sel opened.err.state) { ret err[Error].err{Error.basis{basis.Error.state{opened.err.state}}}; }
        ret err[Error].err{Error.basis{basis.Error.registers{opened.err.view}}};
    }
    w.context = opened.ok;
    w.made    = true;
    ret err[Error].ok{};
}

fun narrow(w: *Wide) {
    if (!w.made) { ret; }
    rf.release(?w.view);
    val dropped: err[allocator.Error] = extension.release(?w.selection);
}

fun refused(r: build.Refusal) Error {
    ret Error.builder{r};
}

fun emitted(b: *build.Builder, row: u32, values: *mo.Value, n: u32) err[Error] {
    var i:   inst.Inst          = inst.Inst{row: ?gen_row.ROWS[row], values: values, count: n, form: form.PREFERRED};
    val got: err[build.Refusal] = build.emit(b, ?i, mo.NO_FIXUP);
    if (sel got.err) { ret err[Error].err{refused(got.err)}; }
    ret err[Error].ok{};
}

fun choice(b: *build.Builder, axis: *mink_trait.Axis, value: *mink_trait.Choice) err[Error] {
    val got: err[build.Refusal] = build.state(b, mink_trait.Trait{axis: axis, setting: mink_trait.Setting.choice{value}});
    if (sel got.err) { ret err[Error].err{refused(got.err)}; }
    ret err[Error].ok{};
}

# the module handed to masc's builder: its declarations, its models and
# every section of its logical layout in order
fun handed(u: *Unit, d: *Declared, ctx: *core_state.Context) res[object.Object, Error] {
    val format: res[*Format, record.Error] = record.format(u.t);
    if (sel format.err) { ret res[object.Object, Error].err{Error.layout{format.err}}; }
    val made: res[build.Builder, build.Refusal] = build.make(u.a, ?u.b.formats, u.b.basis.set, ctx, u.t.arch, format.ok);
    if (sel made.err) { ret res[object.Object, Error].err{refused(made.err)}; }
    var b: build.Builder = made.ok;
    fin { build.release(?b); }
    val begun: err[build.Refusal] = build.begin(?b, build.Spec{name: opt[str].none{}, kind: ?section.TEXT, flags: section.TEXT.flags, disposition: ?section.WHOLE, entsize: 0, apart: false});
    if (sel begun.err) { ret res[object.Object, Error].err{refused(begun.err)}; }
    var one: [1]mo.Value = [1]mo.Value{mo.Value.none{}};
    var i:   usize       = 0;
    for (i < d.capabilities.len) {
        one[0] = mo.enumerant(d.capabilities.data[i]);
        val got: err[Error] = emitted(?b, gen_row_index.OPCAPABILITY, ?one[0], 1);
        if (sel got.err) { ret res[object.Object, Error].err{got.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < d.extensions.len) {
        val name: res[str, basis.Error] = basis.extension_name(u.t, d.extensions.data[i]);
        if (sel name.err) { ret res[object.Object, Error].err{Error.basis{name.err}}; }
        one[0] = mo.Value.literal{mo.Bytes{at: name.ok, len: str_len(name.ok)::u32}};
        val got: err[Error] = emitted(?b, gen_row_index.OPEXTENSION, ?one[0], 1);
        if (sel got.err) { ret res[object.Object, Error].err{got.err}; }
        i = i + 1;
    }
    val addressed: err[Error] = choice(?b, ?spirv_arch.SPIRV_ADDRESSING_MODEL, ?spirv_arch.SPIRV_LOGICAL);
    if (sel addressed.err) { ret res[object.Object, Error].err{addressed.err}; }
    val modelled: err[Error] = choice(?b, ?spirv_arch.SPIRV_MEMORY_MODEL, ?spirv_arch.SPIRV_GLSL450);
    if (sel modelled.err) { ret res[object.Object, Error].err{modelled.err}; }
    var values: vector.Vector[mo.Value] = vector.init[mo.Value](u.a);
    fin { vector.dnit[mo.Value](?values); }
    var s: usize = 0;
    for (s < buffer.SECTIONS) {
        val list: *vector.Vector[Ins] = ?u.buf.sections[s];
        var k:    usize               = 0;
        for (k < list.len) {
            val ins: Ins                             = list.data[k];
            val got: res[*mo.Value, allocator.Error] = buffer.values(?u.buf, ins, ?values);
            if (sel got.err) { ret res[object.Object, Error].err{Error.alloc{got.err}}; }
            val put: err[Error] = emitted(?b, ins.row, got.ok, ins.count);
            if (sel put.err) { ret res[object.Object, Error].err{put.err}; }
            k = k + 1;
        }
        s = s + 1;
    }
    val finished: res[object.Object, build.Refusal] = build.finish(?b);
    if (sel finished.err) { ret res[object.Object, Error].err{refused(finished.err)}; }
    ret res[object.Object, Error].ok{finished.ok};
}

# the module laid out: its debug strings, its variables, every function's
# signature then its code, its entry points and its linkage
fun laid(u: *Unit, relocatable: bool) {
    debug.open(u);
    var f: usize = 0;
    for (f < u.m.functions.len) {
        push_u32(u, ?u.functions, unit.fresh(u));
        f = f + 1;
    }
    if (unit.ok(u)) { spirv_types.variables(u); }
    if (unit.ok(u)) { signatures(u); }
    f = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        code.function(u, Function{index: f::u32});
        f = f + 1;
    }
    if (unit.ok(u)) { entries(u); }
    if (unit.ok(u)) { linkage_of(u, relocatable); }
    if (unit.ok(u)) { memory_model(u); }
}

# compile a scheduled module into mink's object of one spir-v module
# ---
# a:           the allocator every stage and the object take
# m:           the module, scheduled
# b:           the build the family opened
# t:           the target
# warnings:    where a warning is written, none for nowhere
# relocatable: write a relocatable unit of Linkage, else a finished module
# ret:         the object, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, warnings: opt[*io.Writer], relocatable: bool) res[object.Object, Error] {
    var l: Layout = layout.of(t, ?m.types, basis.context_of(opt[*basis.Basis].some{?b.basis}));
    var c: Cache  = cache.init(m, t, opt[*basis.Basis].some{?b.basis}, analysis.rows());
    fin { val dropped: err[allocator.Error] = cache.dnit(?c); }
    var u: Unit = unit.make(a, m, b, t, ?l, ?c);
    fin { unit.release(?u); }
    laid(?u, relocatable);
    var d: Declared = Declared{capabilities: vector.init[u32](a), extensions: vector.init[requirement.Id](a), added: vector.init[requirement.Id](a)};
    fin {
        vector.dnit[u32](?d.capabilities);
        vector.dnit[requirement.Id](?d.extensions);
        vector.dnit[requirement.Id](?d.added);
    }
    if (unit.ok(?u))                { required(?u, ?d); }
    if (unit.ok(?u) && relocatable) { declare(?u, ?d, gen_extension.LINKAGE); }
    if (sel u.failed.some)          { ret res[object.Object, Error].err{u.failed.some}; }
    var w:       Wide;
    val widened: err[Error] = widen(?u, ?d, ?w);
    if (sel widened.err) { ret res[object.Object, Error].err{widened.err}; }
    fin { narrow(?w); }
    var ctx: *core_state.Context = ?b.basis.context;
    if (w.made) { ctx = ?w.context; }
    ret handed(?u, ?d, ctx);
}
