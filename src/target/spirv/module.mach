# the execution modes the family states of its own
val ORIGIN_UPPER_LEFT: u32 = 7;
val ORIGIN_LOWER_LEFT: u32 = 8;
val LOCAL_SIZE:        u32 = 0x11;
val LOCAL_SIZE_ID:     u32 = 0x26;
val PRESERVE:          u32 = 0x116D;

# the execution models the stage rules name
val VERTEX:   u64 = 0;
val FRAGMENT: u64 = 4;

# the decorations the stage rules read and write
val FLAT:         u32 = 0xE;
val NON_WRITABLE: u64 = 24;
val NON_READABLE: u64 = 25;

# the linkage types
val EXPORT:        u32 = 0;
val IMPORT:        u32 = 1;
val LINK_ONCE_ODR: u32 = 2;

# the memory models and addressing models a module states
val GLSL450:                    u32 = 1;
val VULKAN:                     u32 = 3;
val LOGICAL:                    u32 = 0;
val PHYSICAL_STORAGE_BUFFER_64: u32 = 0x14E4;

fun push_u32(u: *Unit, v: *vector.Vector[u32], x: u32) {
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
}

fun attributes(list: *vector.Vector[Attribute]) Slice[Attribute] {
    ret Slice[Attribute]{data: list.data, size: list.len};
}

fun declared(u: *Unit, f: usize) bool {
    ret u.m.functions.data[f].body.blocks.len == 0;
}

# whether the module carries nothing of function `f`: where it holds only what
# its entry points reach, one none reaches, else one it only declares and no
# function of it refers to
fun absent(u: *Unit, r: *Reach, f: usize) bool {
    if (u.closed) { ret !reach.reached_by_any(r, (f::u32)); }
    ret declared(u, f) && !reach.referenced(r, (f::u32));
}

fun type_at(d: *InstructionData, slot: usize) opt[Type] {
    if (slot >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

# what a pointer parameter points to, as the function's code reads it: the
# aggregate a member or element is reached in first, else the value an
# access moves, else what the parameter of a function it is passed on to
# points to, else what its callers pass. a parameter nothing uses and no
# call states points to an i32
fun pointee(u: *Unit, f: Function, k: usize) opt[Type] {
    val b: *Body = ?u.m.functions.data[f].body;
    if (b.blocks.len == 0) {
        unit.fail(u, Error.unpointed{At{function: f, instruction: NOWHERE, location: opt[Location].none{}}});
        ret opt[Type].none{};
    }
    val opt_read: opt[Type] = read_pointee(u, f, k, 0, false);
    if (sel opt_read.some) { ret opt_read; }
    if (!unit.ok(u))       { ret opt[Type].none{}; }
    val uses: *Growing[Instruction] = ?b.values.data[b.blocks.data[0].parameters.data[k]].uses;
    unit.fail(u, Error.unpointed{At{function: f, instruction: uses.data[0], location: ir_function.location(?u.m.functions.data[f].body, uses.data[0])}});
    ret opt[Type].none{};
}

# what parameter `k` of function `f` points to as its code reads it, else as
# a call of `f` passes it, none where nothing states it. once `upward` turns
# the search to callers it never turns back to callees, so it walks no cycle.
# `depth` counts the functions it passes through, which a module's functions
# bound, as a call graph a stage reaches holds no cycle
fun read_pointee(u: *Unit, f: Function, k: usize, depth: usize, upward: bool) opt[Type] {
    val b: *Body = ?u.m.functions.data[f].body;
    if (b.blocks.len == 0 || depth > u.m.functions.len) { ret opt[Type].none{}; }
    val v:    Value                 = b.blocks.data[0].parameters.data[k];
    val uses: *Growing[Instruction] = ?b.values.data[v].uses;
    var j:    usize                 = 0;
    for (j < uses.len) {
        val d: *InstructionData = ?b.instructions.data[uses.data[j]];
        val c: u32              = d.opcode;
        if ((c == table.PTR_MEMBER || c == table.PTR_INDEX) && d.operands.data[0] == v) {
            val opt_type_at: opt[Type] = type_at(d, 0);
            if (sel opt_type_at.some) { ret opt_type_at; }
        }
        j = j + 1;
    }
    j = 0;
    for (j < uses.len) {
        val d: *InstructionData = ?b.instructions.data[uses.data[j]];
        val c: u32              = d.opcode;
        if (d.operands.len > 0 && d.operands.data[0] == v) {
            if ((c == table.LOAD || c == table.ATOMIC_LOAD) && d.results.len > 0) { ret opt[Type].some{b.values.data[d.results.data[0]].type}; }
            if ((c == table.STORE || access.atomic(c)) && d.operands.len > 1)     { ret opt[Type].some{b.values.data[d.operands.data[1]].type}; }
        }
        j = j + 1;
    }
    j = 0;
    for (j < uses.len) {
        val opt_typed: opt[Type] = op_pointee(u, b, ?b.instructions.data[uses.data[j]], v);
        if (sel opt_typed.some) { ret opt_typed; }
        j = j + 1;
    }
    j = 0;
    for (j < uses.len && !upward) {
        val d: *InstructionData = ?b.instructions.data[uses.data[j]];
        j = j + 1;
        if (d.opcode != table.CALL || d.operands.len == 0) { cnt; }
        val opt_called: opt[Function] = reach.function_named(u.m, b, d.operands.data[0]);
        if (sel opt_called.none) { cnt; }
        var q: usize = 1;
        for (q < d.operands.len) {
            if (d.operands.data[q] == v) {
                val opt_passed: opt[Type] = read_pointee(u, opt_called.some, q - 1, depth + 1, false);
                if (sel opt_passed.some) { ret opt_passed; }
            }
            q = q + 1;
        }
    }
    val opt_given: opt[Type] = given_pointee(u, f, k, depth);
    if (sel opt_given.some) { ret opt_given; }
    if (uses.len == 0) {
        val res_word: res[Type, type_table.Error] = type_table.intern(?u.m.types, type_table.Shape.integer{type_table.Integer{width: 32}});
        if (sel res_word.err) {
            unit.fail(u, Error.ir{module.Error.types{res_word.err}});
            ret opt[Type].none{};
        }
        ret opt[Type].some{res_word.ok};
    }
    ret opt[Type].none{};
}

# what a call of function `f` passes as its pointer parameter `k` points to,
# none where no call states it
fun given_pointee(u: *Unit, f: Function, k: usize, depth: usize) opt[Type] {
    var g: usize = 0;
    for (g < u.m.functions.len) {
        val b: *Body = ?u.m.functions.data[g].body;
        var i: usize = 0;
        for (i < b.instructions.len) {
            val d:  *InstructionData = ?b.instructions.data[i];
            val at: Place            = d.place;
            i = i + 1;
            if (d.opcode != table.CALL || d.operands.len <= k + 1 || !(sel at.placed)) { cnt; }
            val opt_called: opt[Function] = reach.function_named(u.m, b, d.operands.data[0]);
            if (sel opt_called.none)  { cnt; }
            if (opt_called.some != f) { cnt; }
            val opt_argument: opt[Type] = argument_pointee(u, (g::u32), b, d.operands.data[k + 1], depth);
            if (sel opt_argument.some) { ret opt_argument; }
        }
        g = g + 1;
    }
    ret opt[Type].none{};
}

# the layout key the calls of a function pass for a pointer parameter
# ---
# none:  no call states it
# key:   every call that states it passes a pointer of this key
# mixed: two calls pass pointers of different keys
tag Keyed: u8 {
    none;
    key:   u32;
    mixed: Mixed;
}

# the layout key pointer parameter `k` of function `f`, into class `class` and pointing to `pointee`, is held by: the key
# every call passes, a whole block variable's with the block's layout and a member's or an element's without it, else
# where no call states one a block's where the pointee is a structure in a class that holds blocks and its class's
# otherwise. `depth` bounds the walk through parameters as `read_pointee`'s does
fun param_key(u: *Unit, f: Function, k: usize, class: u32, pointee: Type, depth: usize) Keyed {
    val passed: Keyed = passed_key(u, f, k, depth);
    if (!(sel passed.none)) { ret passed; }
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, pointee);
    if (sel res_shape.ok) {
        val sh: type_table.Shape = res_shape.ok;
        if (sel sh.structure) { ret Keyed.key{spirv_types.variable_key(u, class)}; }
    }
    ret Keyed.key{spirv_types.laid(u, class)};
}

# the layout key every call of function `f` passes for its pointer parameter `k`, none where no call states one
fun passed_key(u: *Unit, f: Function, k: usize, depth: usize) Keyed {
    var out: Keyed = Keyed.none{};
    if (depth > u.m.functions.len) { ret out; }
    var g: usize = 0;
    for (g < u.m.functions.len) {
        val b: *Body = ?u.m.functions.data[g].body;
        var i: usize = 0;
        for (i < b.instructions.len) {
            val d:  *InstructionData = ?b.instructions.data[i];
            val at: Place            = d.place;
            val n:  Instruction      = (i::u32);
            i = i + 1;
            if (d.opcode != table.CALL || d.operands.len <= k + 1 || !(sel at.placed)) { cnt; }
            val opt_called: opt[Function] = reach.function_named(u.m, b, d.operands.data[0]);
            if (sel opt_called.none)  { cnt; }
            if (opt_called.some != f) { cnt; }
            val given: Keyed = argument_key(u, (g::u32), b, d.operands.data[k + 1], depth);
            if (sel given.mixed)  { ret given; }
            if (!(sel given.key)) { cnt; }
            if (sel out.key && out.key != given.key) {
                val at: At = At{function: (g::u32), instruction: n, location: ir_function.location(b, n)};
                ret Keyed.mixed{Mixed{at: at, callee: f, parameter: k::u32, whole: given.key != spirv_types.member_key(given.key)}};
            }
            out = given;
        }
        g = g + 1;
    }
    ret out;
}

# the layout key of pointer `a`, an argument function `g` passes, as the emitter keys it: a global's own, a member's or
# an element's that of what it is reached in without the block's layout, a stack slot's the plain one, and what `g`'s
# own parameter is held by. none for any other pointer
fun argument_key(u: *Unit, g: Function, b: *Body, a: Value, depth: usize) Keyed {
    val d: Def = b.values.data[a].def;
    if (sel d.constant) {
        val res_data: res[ConstantData, module.Error] = module.constant_data(u.m, d.constant);
        if (sel res_data.err) { ret Keyed.none{}; }
        val c: ConstantData = res_data.ok;
        if (sel c.address) {
            val s: Symbol = c.address.symbol;
            if (sel s.global) {
                if (c.address.offset == 0) { ret Keyed.key{u.keys.data[s.global]}; }
            }
        }
        ret Keyed.none{};
    }
    if (sel d.parameter) {
        if (d.parameter.block != 0) { ret Keyed.none{}; }
        val k:        usize     = d.parameter.index::usize;
        val opt_read: opt[Type] = read_pointee(u, g, k, 0, false);
        if (sel opt_read.none) { ret Keyed.none{}; }
        ret param_key(u, g, k, space_of(u, b.values.data[a].type), opt_read.some, depth + 1);
    }
    if (sel d.result) {
        val made: *InstructionData = ?b.instructions.data[d.result.instruction];
        if (made.opcode == table.ALLOCA)                              { ret Keyed.key{spirv_types.PLAIN}; }
        if (made.opcode == table.DECLASSIFY && made.operands.len > 0) { ret argument_key(u, g, b, made.operands.data[0], depth); }
        if ((made.opcode == table.PTR_MEMBER || made.opcode == table.PTR_INDEX) && made.operands.len > 0) {
            val base: Keyed = argument_key(u, g, b, made.operands.data[0], depth);
            if (sel base.key) { ret Keyed.key{spirv_types.member_key(base.key)}; }
            ret base;
        }
    }
    ret Keyed.none{};
}

# what pointer `a`, an argument function `g` passes, points to: a global's
# type, a stack slot's, the member or element an access chain reaches, or
# what `g`'s own parameter points to. none for any other pointer
fun argument_pointee(u: *Unit, g: Function, b: *Body, a: Value, depth: usize) opt[Type] {
    val d: Def = b.values.data[a].def;
    if (sel d.constant) {
        val res_data: res[ConstantData, module.Error] = module.constant_data(u.m, d.constant);
        if (sel res_data.err) { ret opt[Type].none{}; }
        val c: ConstantData = res_data.ok;
        if (sel c.address) {
            val s: Symbol = c.address.symbol;
            if (sel s.global) {
                if (c.address.offset == 0) { ret opt[Type].some{u.m.globals.data[s.global].data.type}; }
            }
        }
        ret opt[Type].none{};
    }
    if (sel d.parameter) {
        if (d.parameter.block != 0) { ret opt[Type].none{}; }
        ret read_pointee(u, g, d.parameter.index::usize, depth + 1, true);
    }
    if (sel d.result) {
        val made:          *InstructionData = ?b.instructions.data[d.result.instruction];
        val opt_aggregate: opt[Type]        = type_at(made, 0);
        if (sel opt_aggregate.none)         { ret opt[Type].none{}; }
        if (made.opcode == table.ALLOCA)    { ret opt_aggregate; }
        if (made.opcode == table.PTR_INDEX) { ret spirv_types.member_of(u, opt_aggregate.some, 0); }
        if (made.opcode == table.PTR_MEMBER && made.immediates.len > 1) {
            val imm: Immediate = made.immediates.data[1];
            if (sel imm.member) { ret spirv_types.member_of(u, opt_aggregate.some, imm.member); }
        }
    }
    ret opt[Type].none{};
}

# what the pointer `v` points to as target op `d` reads it: the type of the
# slot whose form gives what that operand points to (code.gives_pointee), as an
# atomic's value is the type its pointer points to. none where the typing
# states no such slot
fun op_pointee(u: *Unit, b: *Body, d: *InstructionData, v: Value) opt[Type] {
    val opt_located: opt[code.Located] = code.row_typing(u, d);
    if (sel opt_located.none) { ret opt[Type].none{}; }
    val tg:   *typing.Typing = opt_located.some.typing;
    val lead: u32            = opt_located.some.lead;
    var q:    usize          = 0;
    for (q < d.operands.len) {
        if (d.operands.data[q] == v) {
            var k: u32 = 0;
            for (k < tg.count) {
                val f: *typing.Form = ?tg.forms[k];
                k = k + 1;
                if (!code.gives_pointee(f, q::u32 + lead)) { cnt; }
                if (f.slot == typing.RESULT) {
                    if (d.results.len > 0) { ret opt[Type].some{b.values.data[d.results.data[0]].type}; }
                    cnt;
                }
                if (f.slot::u32 < lead) { cnt; }
                val at: usize = (f.slot::u32 - lead)::usize;
                if (at < d.operands.len) { ret opt[Type].some{b.values.data[d.operands.data[at]].type}; }
            }
        }
        q = q + 1;
    }
    ret opt[Type].none{};
}

fun space_of(u: *Unit, ty: Type) u32 {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, ty);
    if (sel res_shape.ok) {
        val k: type_table.Shape = res_shape.ok;
        if (sel k.pointer) { ret k.pointer.space; }
    }
    ret 0;
}

# what every function is called as, an absent one keeping its place with no
# signature
fun signatures(u: *Unit, r: *Reach) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        if (absent(u, r, f)) {
            var unsigned:     Signature;
            val res_unsigned: res[usize, allocator.Error] = vector.push[Signature](?u.signatures, unsigned);
            if (sel res_unsigned.err) {
                unit.lost(u, res_unsigned.err);
                ret;
            }
            f = f + 1;
            cnt;
        }
        val id:        Function                                = (f::u32);
        val fd:        FunctionData                            = u.m.functions.data[f].data;
        val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, fd.signature);
        if (sel res_shape.err) {
            unit.fail(u, Error.ir{module.Error.types{res_shape.err}});
            ret;
        }
        val sh: type_table.Shape = res_shape.ok;
        if (!(sel sh.function)) {
            unit.fail(u, Error.untyped{fd.signature});
            ret;
        }
        val fs:      type_table.Function = sh.function;
        var results: vector.Vector[u32]  = vector.init[u32](u.a);
        fin { vector.dnit[u32](?results); }
        var k: usize = 0;
        for (k < fs.results.size) {
            if (spirv_types.pointer(u, fs.results.data[k])) {
                unit.fail(u, Error.variable{At{function: id, instruction: NOWHERE, location: opt[Location].none{}}});
                ret;
            }
            push_u32(u, ?results, spirv_types.type_of(u, fs.results.data[k], spirv_types.PLAIN));
            k = k + 1;
        }
        var result: u32 = spirv_types.void(u);
        if (results.len == 1) { result = results.data[0]; }
        or (results.len > 1)  { result = spirv_types.struct_of(u, results.data, results.len); }
        var params:   vector.Vector[u32] = vector.init[u32](u.a);
        var pointees: vector.Vector[u32] = vector.init[u32](u.a);
        var keys:     vector.Vector[u32] = vector.init[u32](u.a);
        fin {
            vector.dnit[u32](?params);
            vector.dnit[u32](?pointees);
            vector.dnit[u32](?keys);
        }
        k = 0;
        for (k < fs.params.size && unit.ok(u)) {
            val pt: Type = fs.params.data[k];
            if (spirv_types.pointer(u, pt)) {
                val opt_pointee: opt[Type] = pointee(u, id, k);
                if (sel opt_pointee.none) { ret; }
                val class: u32   = space_of(u, pt);
                val keyed: Keyed = param_key(u, id, k, class, opt_pointee.some, 0);
                if (sel keyed.mixed) {
                    unit.fail(u, Error.mixed{keyed.mixed});
                    ret;
                }
                var key: u32 = spirv_types.PLAIN;
                if (sel keyed.key) { key = keyed.key; }
                push_u32(u, ?params, spirv_types.pointer_type(u, class, spirv_types.type_of(u, opt_pointee.some, key)));
                push_u32(u, ?pointees, opt_pointee.some + 1);
                push_u32(u, ?keys, key);
            }
            or {
                push_u32(u, ?params, spirv_types.type_of(u, pt, spirv_types.PLAIN));
                push_u32(u, ?pointees, 0);
                push_u32(u, ?keys, 0);
            }
            k = k + 1;
        }
        val sig: Signature = Signature{
            type:     spirv_types.function_type(u, result, params.data, params.len),
            result:   result,
            results:  results.len::u32,
            params:   unit.keep_list(u, params.data, params.len),
            pointees: unit.keep_list(u, pointees.data, pointees.len),
            keys:     unit.keep_list(u, keys.data, keys.len),
        };
        val res_pushed: res[usize, allocator.Error] = vector.push[Signature](?u.signatures, sig);
        if (sel res_pushed.err) {
            unit.lost(u, res_pushed.err);
            ret;
        }
        f = f + 1;
    }
}

# the variables entry point `e` reaches that its interface lists
fun interface(u: *Unit, r: *Reach, e: usize, out: *vector.Vector[u32]) {
    val all: bool  = core_state.holds(?u.b.basis.context, gen_extension.SPV1_4);
    var k:   usize = 0;
    for (k < u.m.globals.len) {
        if (reach.uses(r, e, (k::u32))) {
            val class: u64 = u.classes.data[k]::u64;
            if (schema.interface(class) || (all && class != schema.FUNCTION)) { push_u32(u, out, u.globals.data[k]); }
        }
        k = k + 1;
    }
}

fun mode(u: *Unit, f: u32, m: u32, params: Span) {
    var s: [2]Slot = [2]Slot{Slot.id{f}, unit.enumerant_of(m, params)};
    unit.put(u, buffer.MODES, gen_row_index.OPEXECUTIONMODE, ?s[0], 2);
}

fun stated(list: Slice[u64], m: u32) bool {
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i] == m::u64) { ret true; }
        i = i + 1;
    }
    ret false;
}

# a compute stage's workgroup size: LocalSize of its sizes where it names no
# dimension by a specialization constant or the module's WorkgroupSize
# built-in sizes it, and LocalSizeId otherwise, each dimension it names that
# constant's id and every other a 32-bit constant of its size
fun workgroup(u: *Unit, f: usize, id: u32, list: Slice[Attribute], built: bool) {
    var size: [3]u32     = [3]u32{1, 1, 1};
    val got:  Slice[u64] = schema.integers(list, "workgroup");
    if (got.size == 3) {
        size[0] = got.data[0]::u32;
        size[1] = got.data[1]::u32;
        size[2] = got.data[2]::u32;
    }
    val named: Slice[u64] = schema.integers(list, "workgroup_spec");
    if (named.size == 0 || built) {
        mode(u, id, LOCAL_SIZE, unit.numbers(u, ?size[0], 3));
        ret;
    }
    var dims: [3]u32 = [3]u32{0, 0, 0};
    if (!dimensions(u, f, list, ?dims[0])) { ret; }
    var ids: [3]Slot = [3]Slot{Slot.id{dims[0]}, Slot.id{dims[1]}, Slot.id{dims[2]}};
    mode_id(u, id, LOCAL_SIZE_ID, unit.slots(u, ?ids[0], 3));
}

# the ids of the three dimensions of compute stage `f`'s workgroup into
# `dims`: the constant of each dimension a specialization constant names, a
# 32-bit constant of its size for every other. false where a dimension names
# no constant of the module, refused
fun dimensions(u: *Unit, f: usize, list: Slice[Attribute], dims: *u32) bool {
    var key: [3]u64 = [3]u64{0, 0, 0};
    sized_as(list, ?key[0]);
    val named: Slice[u64] = schema.integers(list, "workgroup_spec");
    var k:     usize      = 0;
    for (k + 1 < named.size) {
        val opt_specialization: opt[Constant] = module.specialization(u.m, named.data[k + 1]::u32);
        if (sel opt_specialization.none) {
            unit.fail(u, Error.workgroup{(f::u32)});
            ret false;
        }
        if (named.data[k] > 2) {
            unit.fail(u, Error.workgroup{(f::u32)});
            ret false;
        }
        dims[named.data[k]::usize] = spirv_types.constant_of(u, opt_specialization.some, spirv_types.PLAIN);
        k                          = k + 2;
    }
    k = 0;
    for (k < 3) {
        if ((key[k] & NAMED) == 0) { dims[k] = spirv_types.uint(u, 32, key[k]); }
        k = k + 1;
    }
    ret true;
}

# the bit of a dimension's key that marks it named by a specialization
# constant, the constant's id below it, its size below it otherwise
val NAMED: u64 = 0x1_0000_0000;

# the key of each of the three dimensions of a workgroup into `key`, equal
# for two dimensions that are one size wherever the host specializes the
# module. true where a specialization constant names one of them
fun sized_as(list: Slice[Attribute], key: *u64) bool {
    val got: Slice[u64] = schema.integers(list, "workgroup");
    var k:   usize      = 0;
    for (k < 3) {
        key[k] = 1;
        if (got.size == 3) { key[k] = got.data[k] & 0xFFFF_FFFF; }
        k = k + 1;
    }
    val named: Slice[u64] = schema.integers(list, "workgroup_spec");
    k = 0;
    for (k + 1 < named.size) {
        if (named.data[k] <= 2) { key[named.data[k]::usize] = NAMED | (named.data[k + 1] & 0xFFFF_FFFF); }
        k = k + 2;
    }
    ret named.size != 0;
}

# whether the module's WorkgroupSize built-in sizes its compute stages, made
# here: where a compute stage names a workgroup dimension by a specialization
# constant and the environment states no LocalSizeId, so no execution mode
# can name the constant. every compute stage of the module then has one size,
# as the built-in sizes them all, refused otherwise
fun sizing(u: *Unit) bool {
    if (spirv_types.guaranteed(u, ?vulkan.LOCAL_SIZE_ID)) { ret false; }
    var stages:   usize  = 0;
    var first:    usize  = 0;
    var second:   usize  = 0;
    var differs:  bool   = false;
    var named:    bool   = false;
    var first_at: [3]u64 = [3]u64{0, 0, 0};
    var f:        usize  = 0;
    for (f < u.m.functions.len) {
        val list:      Slice[Attribute] = attributes(?u.m.functions.data[f].attributes);
        val opt_stage: opt[u64]         = schema.integer(list, "stage");
        f = f + 1;
        if (sel opt_stage.none)               { cnt; }
        if (!schema.computes(opt_stage.some)) { cnt; }
        var key: [3]u64 = [3]u64{0, 0, 0};
        if (sized_as(list, ?key[0])) { named = true; }
        stages = stages + 1;
        if (stages == 1) {
            first    = f - 1;
            first_at = key;
            cnt;
        }
        if (!differs && (key[0] != first_at[0] || key[1] != first_at[1] || key[2] != first_at[2])) {
            differs = true;
            second  = f - 1;
        }
    }
    if (!named) { ret false; }
    if (differs) {
        val b:  *Body = ?u.m.functions.data[second].body;
        val at: At    = At{function: (second::u32), instruction: NOWHERE, location: ir_function.location(b, 0)};
        unit.fail(u, Error.interface{Interface{site: Site.at{at}, rule: Rule.workgroup{Sized{first: (first::u32), second: (second::u32)}}}});
        ret false;
    }
    var dims: [3]u32 = [3]u32{0, 0, 0};
    if (!dimensions(u, first, attributes(?u.m.functions.data[first].attributes), ?dims[0])) { ret false; }
    spirv_types.workgroup_size(u, ?dims[0]);
    ret true;
}

fun mode_id(u: *Unit, f: u32, m: u32, params: Span) {
    var s: [2]Slot = [2]Slot{Slot.id{f}, unit.enumerant_of(m, params)};
    unit.put(u, buffer.MODES, gen_row_index.OPEXECUTIONMODEID, ?s[0], 2);
}

# the LocalInvocationIndex built-in
val LOCAL_INVOCATION_INDEX: u32 = 29;

# the memory semantics of the barrier closing the zeroing of workgroup
# memory: AcquireRelease over WorkgroupMemory
val ZEROED_SEMANTICS: u32 = 0x108;

# the input variable of the LocalInvocationIndex built-in, listed in the
# interface `ids`: the module's own where a global is that built-in, else one
# made once into `made`
fun invocation_index(u: *Unit, made: *u32, ids: *vector.Vector[u32]) u32 {
    var v: u32   = @made;
    var g: usize = 0;
    for (v == NONE && g < u.m.globals.len) {
        if (!u.held.data[g]) {
            g = g + 1;
            cnt;
        }
        val opt_builtin: opt[u64] = schema.integer(global_attributes(u, g), "builtin");
        if (sel opt_builtin.some) {
            if (opt_builtin.some == LOCAL_INVOCATION_INDEX::u64 && u.classes.data[g]::u64 == schema.INPUT) { v = u.globals.data[g]; }
        }
        g = g + 1;
    }
    if (v == NONE) {
        v = unit.fresh(u);
        val ptr:   u32     = spirv_types.pointer_type(u, schema.INPUT::u32, spirv_types.int_type(u, 32));
        var slots: [4]Slot = [4]Slot{Slot.id{ptr}, Slot.id{v}, unit.enumerant(schema.INPUT::u32), Slot.none{}};
        unit.put(u, buffer.TYPES, gen_row_index.OPVARIABLE, ?slots[0], 4);
        var which: [1]Slot = [1]Slot{unit.enumerant(LOCAL_INVOCATION_INDEX)};
        var built: [2]Slot = [2]Slot{Slot.id{v}, unit.enumerant_of(spirv_types.BUILT_IN, unit.slots(u, ?which[0], 1))};
        unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?built[0], 2);
        @made = v;
    }
    var k: usize = 0;
    for (k < ids.len) {
        if (ids.data[k] == v) { ret v; }
        k = k + 1;
    }
    push_u32(u, ids, v);
    ret v;
}

fun put_label(u: *Unit, id: u32) {
    var s: [1]Slot = [1]Slot{Slot.id{id}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPLABEL, ?s[0], 1);
}

fun put_branch(u: *Unit, id: u32) {
    var s: [1]Slot = [1]Slot{Slot.id{id}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPBRANCH, ?s[0], 1);
}

fun put_two(u: *Unit, row: u32, t: u32, r: u32, x: u32, y: u32) {
    var s: [4]Slot = [4]Slot{Slot.id{t}, Slot.id{r}, Slot.id{x}, Slot.id{y}};
    unit.put(u, buffer.DEFINITIONS, row, ?s[0], 4);
}

# a store of the zero of `t` through `p` into Workgroup memory, made
# available at the scope of global `g` under the vulkan memory model
fun put_zero(u: *Unit, g: usize, p: u32, t: u32) {
    var memory:    Slot     = Slot.none{};
    val opt_scope: opt[u32] = u.scopes.data[g];
    if (sel opt_scope.some) {
        var scope: [1]Slot = [1]Slot{Slot.id{spirv_types.uint(u, 32, opt_scope.some::u64)}};
        memory = unit.enumerant_of(ZERO_STORE, unit.slots(u, ?scope[0], 1));
    }
    var s: [3]Slot = [3]Slot{Slot.id{p}, Slot.id{spirv_types.null(u, t)}, memory};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPSTORE, ?s[0], 3);
}

# the memory operands of a zeroing store: MakePointerAvailable and
# NonPrivatePointer
val ZERO_STORE: u32 = 0x28;

# the entry point stage `f` (entry `e` of the reach) is written as: where the
# stage reaches a stage output of a carried type that starts at zero, or it
# computes, its environment zeroes no workgroup memory and it reaches a
# Workgroup variable, a function that stores each such output's zero,
# converted from a 32-bit one since no constant of its type can be formed,
# zeroes each Workgroup variable it reaches and waits at a workgroup barrier,
# then calls the stage, so all of it precedes the stage's own code. an array's
# elements are zeroed by the invocations its local invocation index reaches in
# steps of the workgroup size, and the whole of any other variable by
# invocation 0. the stage's own id otherwise
fun prologue(u: *Unit, r: *Reach, e: usize, f: usize, list: Slice[Attribute], computes: bool, made: *u32, ids: *vector.Vector[u32]) u32 {
    val id:      u32                = u.functions.data[f];
    var outputs: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?outputs); }
    var reached: vector.Vector[u32] = vector.init[u32](u.a);
    fin { vector.dnit[u32](?reached); }
    val zeroes: bool  = computes && !spirv_types.guaranteed(u, ?vulkan.ZERO_INITIALIZED_WORKGROUP);
    var g:      usize = 0;
    for (g < u.m.globals.len) {
        if (reach.uses(r, e, (g::u32))) {
            if (spirv_types.zero_started(u, g))                       { push_u32(u, ?outputs, (g::u32)); }
            if (zeroes && u.classes.data[g]::u64 == schema.WORKGROUP) { push_u32(u, ?reached, (g::u32)); }
        }
        g = g + 1;
    }
    var dims: [3]u32 = [3]u32{0, 0, 0};
    if (reached.len != 0 && !dimensions(u, f, list, ?dims[0])) { vector.truncate[u32](?reached, 0); }
    if (outputs.len == 0 && reached.len == 0)                  { ret id; }
    val sig:  *Signature = ?u.signatures.data[f];
    val w:    u32        = unit.fresh(u);
    var head: [4]Slot    = [4]Slot{Slot.id{sig.result}, Slot.id{w}, unit.enumerant(0), Slot.id{sig.type}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPFUNCTION, ?head[0], 4);
    val entry: u32 = unit.fresh(u);
    put_label(u, entry);
    var k: usize = 0;
    for (k < outputs.len) {
        val x: usize = outputs.data[k]::usize;
        carried_zero(u, u.globals.data[x], u.m.globals.data[x].data.type);
        k = k + 1;
    }
    if (reached.len != 0) { zero_workgroup(u, entry, ?reached, ?dims[0], made, ids); }
    var call: [4]Slot = [4]Slot{Slot.id{sig.result}, Slot.id{unit.fresh(u)}, Slot.id{id}, Slot.list{buffer.EMPTY}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPFUNCTIONCALL, ?call[0], 4);
    var none: [1]Slot = [1]Slot{Slot.none{}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPRETURN, ?none[0], 0);
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPFUNCTIONEND, ?none[0], 0);
    ret w;
}

# a store of the zero of the carried type `ty` into output `p`: the zero of its
# shape at 32 bits, converted to its 16
fun carried_zero(u: *Unit, p: u32, ty: Type) {
    val float: bool = spirv_types.floating(u, ty);
    val n:     u32  = spirv_types.lanes_of(u, ty);
    var wide:  u32  = spirv_types.int_type(u, 32);
    var row:   u32  = gen_row_index.OPUCONVERT;
    if (float) {
        wide = spirv_types.float_type(u, 32);
        row  = gen_row_index.OPFCONVERT;
    }
    if (n > 1) { wide = spirv_types.vector_type(u, wide, n); }
    val v:    u32     = unit.fresh(u);
    var conv: [3]Slot = [3]Slot{Slot.id{spirv_types.type_of(u, ty, spirv_types.PLAIN)}, Slot.id{v}, Slot.id{spirv_types.null(u, wide)}};
    unit.put(u, buffer.DEFINITIONS, row, ?conv[0], 3);
    var store: [3]Slot = [3]Slot{Slot.id{p}, Slot.id{v}, Slot.none{}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPSTORE, ?store[0], 3);
}

# the zeroing of the Workgroup variables `reached` of a stage of workgroup
# size `dims`, then a workgroup barrier
fun zero_workgroup(u: *Unit, entry: u32, reached: *vector.Vector[u32], dims: *u32, made: *u32, ids: *vector.Vector[u32]) {
    val index:  u32     = invocation_index(u, made, ids);
    val uint_t: u32     = spirv_types.int_type(u, 32);
    val bool_t: u32     = spirv_types.bool_type(u);
    var prev:   u32     = entry;
    val at:     u32     = unit.fresh(u);
    var load:   [4]Slot = [4]Slot{Slot.id{uint_t}, Slot.id{at}, Slot.id{index}, Slot.none{}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPLOAD, ?load[0], 4);
    var arrays: usize = 0;
    var k:      usize = 0;
    for (k < reached.len) {
        if (arrayed(u, u.m.globals.data[reached.data[k]::usize].data.type)) { arrays = arrays + 1; }
        k = k + 1;
    }
    var step: u32 = NONE;
    if (arrays != 0) {
        val plane: u32 = unit.fresh(u);
        put_two(u, gen_row_index.OPIMUL, uint_t, plane, dims[0], dims[1]);
        step = unit.fresh(u);
        put_two(u, gen_row_index.OPIMUL, uint_t, step, plane, dims[2]);
    }
    if (arrays != reached.len) {
        val first: u32 = unit.fresh(u);
        put_two(u, gen_row_index.OPIEQUAL, bool_t, first, at, spirv_types.uint(u, 32, 0));
        val whole: u32 = unit.fresh(u);
        prev = unit.fresh(u);
        var merge: [2]Slot = [2]Slot{Slot.id{prev}, unit.enumerant(0)};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPSELECTIONMERGE, ?merge[0], 2);
        var cond: [4]Slot = [4]Slot{Slot.id{first}, Slot.id{whole}, Slot.id{prev}, Slot.list{buffer.EMPTY}};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPBRANCHCONDITIONAL, ?cond[0], 4);
        put_label(u, whole);
        k = 0;
        for (k < reached.len) {
            val x:  usize = reached.data[k]::usize;
            val ty: Type  = u.m.globals.data[x].data.type;
            if (!arrayed(u, ty)) { put_zero(u, x, u.globals.data[x], spirv_types.type_of(u, ty, u.keys.data[x])); }
            k = k + 1;
        }
        put_branch(u, prev);
        put_label(u, prev);
    }
    k = 0;
    for (k < reached.len && unit.ok(u)) {
        val x:   usize = reached.data[k]::usize;
        val ty:  Type  = u.m.globals.data[x].data.type;
        val key: u32   = u.keys.data[x];
        k = k + 1;
        if (!arrayed(u, ty)) { cnt; }
        val opt_element: opt[Type] = spirv_types.member_of(u, ty, 0);
        if (sel opt_element.none) { cnt; }
        val element: u32 = spirv_types.type_of(u, opt_element.some, spirv_types.member_key(key));
        val header:  u32 = unit.fresh(u);
        val check:   u32 = unit.fresh(u);
        val body:    u32 = unit.fresh(u);
        val cont:    u32 = unit.fresh(u);
        val done:    u32 = unit.fresh(u);
        val i:       u32 = unit.fresh(u);
        val next:    u32 = unit.fresh(u);
        val more:    u32 = unit.fresh(u);
        put_branch(u, header);
        put_label(u, header);
        var entered: [2]Slot = [2]Slot{Slot.id{at}, Slot.id{prev}};
        var looped:  [2]Slot = [2]Slot{Slot.id{next}, Slot.id{cont}};
        var pairs:   [2]Slot = [2]Slot{Slot.group{unit.slots(u, ?entered[0], 2)}, Slot.group{unit.slots(u, ?looped[0], 2)}};
        var phi:     [3]Slot = [3]Slot{Slot.id{uint_t}, Slot.id{i}, Slot.list{unit.slots(u, ?pairs[0], 2)}};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPPHI, ?phi[0], 3);
        var lm: [3]Slot = [3]Slot{Slot.id{done}, Slot.id{cont}, unit.enumerant(0)};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPLOOPMERGE, ?lm[0], 3);
        put_branch(u, check);
        put_label(u, check);
        put_two(u, gen_row_index.OPULESSTHAN, bool_t, more, i, spirv_types.uint(u, 32, spirv_types.count_of(u, ty)));
        var bc: [4]Slot = [4]Slot{Slot.id{more}, Slot.id{body}, Slot.id{done}, Slot.list{buffer.EMPTY}};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPBRANCHCONDITIONAL, ?bc[0], 4);
        put_label(u, body);
        val p:        u32     = unit.fresh(u);
        var index_of: [1]u32  = [1]u32{i};
        var chain:    [4]Slot = [4]Slot{Slot.id{spirv_types.pointer_type(u, u.classes.data[x], element)}, Slot.id{p}, Slot.id{u.globals.data[x]}, Slot.list{unit.list(u, ?index_of[0], 1)}};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPACCESSCHAIN, ?chain[0], 4);
        put_zero(u, x, p, element);
        put_branch(u, cont);
        put_label(u, cont);
        put_two(u, gen_row_index.OPIADD, uint_t, next, i, step);
        put_branch(u, header);
        put_label(u, done);
        prev = done;
    }
    val scope:   u32     = spirv_types.uint(u, 32, spirv_types.WORKGROUP_SCOPE::u64);
    var barrier: [3]Slot = [3]Slot{Slot.id{scope}, Slot.id{scope}, Slot.id{spirv_types.uint(u, 32, ZEROED_SEMANTICS::u64)}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPCONTROLBARRIER, ?barrier[0], 3);
}

# whether a type is an array, whose elements a zeroing strides over
fun arrayed(u: *Unit, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, ty);
    if (sel res_shape.err) { ret false; }
    val k: type_table.Shape = res_shape.ok;
    ret sel k.array;
}

# every entry point, its interface and its execution modes: those it
# states, its workgroup size, an origin for a fragment stage that states
# none, and float controls where the build holds them
fun entries(u: *Unit, r: *Reach) {
    val built: bool  = sizing(u);
    var made:  u32   = NONE;
    var f:     usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        val list:      Slice[Attribute] = attributes(?u.m.functions.data[f].attributes);
        val opt_stage: opt[u64]         = schema.integer(list, "stage");
        if (sel opt_stage.some) {
            val sig: *Signature = ?u.signatures.data[f];
            if (sig.params.len != 0 || sig.results != 0 || declared(u, f)) {
                unit.fail(u, Error.entry{(f::u32)});
                ret;
            }
            var name:    View      = module.name_of(u.m, u.m.functions.data[f].data.name);
            val opt_own: opt[View] = schema.text(list, "entry");
            if (sel opt_own.some) { name = opt_own.some; }
            var ids: vector.Vector[u32] = vector.init[u32](u.a);
            fin { vector.dnit[u32](?ids); }
            val opt_entry: opt[usize] = reach.entry_of(r, (f::u32));
            if (sel opt_entry.some) { interface(u, r, opt_entry.some, ?ids); }
            var id: u32 = u.functions.data[f];
            if (sel opt_entry.some) { id = prologue(u, r, opt_entry.some, f, list, schema.computes(opt_stage.some), ?made, ?ids); }
            var s: [4]Slot = [4]Slot{unit.enumerant(opt_stage.some::u32), Slot.id{id}, Slot.literal{unit.text(u, name)}, Slot.list{unit.list(u, ids.data, ids.len)}};
            unit.put(u, buffer.ENTRIES, gen_row_index.OPENTRYPOINT, ?s[0], 4);
            val modes: Slice[u64] = schema.integers(list, "modes");
            var k:     usize      = 0;
            for (k < modes.size) {
                mode(u, id, modes.data[k]::u32, buffer.EMPTY);
                k = k + 1;
            }
            if (schema.computes(opt_stage.some))                                                                      { workgroup(u, f, id, list, built); }
            if (opt_stage.some == FRAGMENT && !stated(modes, ORIGIN_UPPER_LEFT) && !stated(modes, ORIGIN_LOWER_LEFT)) { mode(u, id, ORIGIN_UPPER_LEFT, buffer.EMPTY); }
            if (core_state.holds(?u.b.basis.context, gen_extension.SIGNEDZEROINFNANPRESERVE)) {
                var w: [3]u32 = [3]u32{16, 32, 64};
                var b: u32    = 0;
                for (b < 3) {
                    if ((u.floats & (1::u32 << b)) != 0) { mode(u, id, PRESERVE, unit.numbers(u, ?w[b], 1)); }
                    b = b + 1;
                }
            }
        }
        f = f + 1;
    }
}

# whether function `f` of `m` is an entry point
fun staged(m: *Module, f: Function) bool {
    val list:      Slice[Attribute] = attributes(?m.functions.data[f].attributes);
    val opt_stage: opt[u64]         = schema.integer(list, "stage");
    ret sel opt_stage.some;
}

fun global_attributes(u: *Unit, g: usize) Slice[Attribute] {
    ret attributes(?u.m.globals.data[g].attributes);
}

# whether a symbol's attributes decorate it with `value`
fun decorates(list: Slice[Attribute], value: u64) bool {
    ret stated(schema.integers(list, "decorate"), value::u32);
}

# the name spir-v gives an enumerant
fun spelled_as(e: schema.Enumeration, value: u64) str {
    val m: *mo.Enumerant = schema.member(e, value);
    if (m == nil) { ret "?"; }
    ret m.name;
}

# the execution models a built-in exists in, as vulkan's built-in variables
# state them for the built-ins the family's front ends name
# ---
# pipeline: the vertex processing stages, Vertex, TessellationControl,
#           TessellationEvaluation, Geometry, MeshNV and MeshEXT
# vertex:   Vertex
# fragment: Fragment
# compute:  the stages that take a workgroup size
# every:    every stage
tag Exists: u8 {
    pipeline;
    vertex;
    fragment;
    compute;
    every;
}

# where built-in `b` exists, every stage for one the table states nothing of
fun exists(b: u64) Exists {
    if (b == 0 || b == 1)                                                          { ret Exists.pipeline{}; }
    if (b == 42 || b == 43)                                                        { ret Exists.vertex{}; }
    if (b == 15)                                                                   { ret Exists.fragment{}; }
    if (b == 24 || b == 26 || b == 27 || b == 28 || b == 29 || b == 38 || b == 40) { ret Exists.compute{}; }
    ret Exists.every{};
}

fun exists_in(x: Exists, model: u64) bool {
    if (sel x.pipeline) { ret model <= 3 || model == 0x1494 || model == 0x14F5; }
    if (sel x.vertex)   { ret model == VERTEX; }
    if (sel x.fragment) { ret model == FRAGMENT; }
    if (sel x.compute)  { ret schema.computes(model); }
    ret true;
}

fun exists_words(x: Exists) str {
    if (sel x.pipeline) { ret "Vertex, TessellationControl, TessellationEvaluation, Geometry and the mesh stages"; }
    if (sel x.vertex)   { ret "Vertex"; }
    if (sel x.fragment) { ret "Fragment"; }
    if (sel x.compute)  { ret "GLCompute and the task and mesh stages"; }
    ret "every stage";
}

# whether a type holds an integer or a 64-bit float, which a fragment stage
# reads from an input only as Flat
fun flat_typed(u: *Unit, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, ty);
    if (sel res_shape.err) { ret false; }
    val s: type_table.Shape = res_shape.ok;
    if (sel s.integer) { ret true; }
    if (sel s.float)   { ret s.float.format == type_format.BINARY64; }
    if (sel s.vector)  { ret flat_typed(u, s.vector.element); }
    if (sel s.array)   { ret flat_typed(u, s.array.element); }
    if (sel s.structure) {
        var i: usize = 0;
        for (i < s.structure.members.size) {
            if (flat_typed(u, s.structure.members.data[i])) { ret true; }
            i = i + 1;
        }
    }
    ret false;
}

# the rule of the target's handle catalog that confines a global holding `ty`
# to its stages, none for a type that is no handle or a handle no rule confines
fun confinement_of(u: *Unit, ty: Type) opt[*capability.Confined] {
    val res_handle: res[type_table.Handle, type_table.Error] = type_table.handle(?u.m.types, ty);
    if (sel res_handle.err) { ret opt[*capability.Confined].none{}; }
    val opt_minted: opt[*capability.Minted] = capability.minted(u.t.caps.handles, res_handle.ok.kind);
    if (sel opt_minted.none) { ret opt[*capability.Confined].none{}; }
    var words: capability.Words = capability.words_of(res_handle.ok);
    ret capability.confinement(opt_minted.some, ?words.at[0], words.count);
}

fun model_of(u: *Unit, f: Function) u64 {
    val opt_stage: opt[u64] = schema.integer(attributes(?u.m.functions.data[f].attributes), "stage");
    if (sel opt_stage.some) { ret opt_stage.some; }
    ret 0;
}

fun interface_refused(u: *Unit, g: usize, rule: Rule) {
    unit.fail(u, Error.interface{Interface{site: Site.global{(g::u32)}, rule: rule}});
}

# the rules of a stage's interface, over what each entry point reaches: a
# built-in exists in its stages alone, a handle in the stages the target's
# handle catalog confines it to, Workgroup memory in a stage with a
# workgroup, an Output variable in a stage that has outputs, an entry point
# uses one push-constant block, and an input a fragment stage reads only as
# Flat is no vertex stage's input as well
fun stage_rules(u: *Unit, r: *Reach) {
    var e: usize = 0;
    for (e < r.entries.len && unit.ok(u)) {
        val f:     Function    = r.entries.data[e];
        val model: u64         = model_of(u, f);
        var push:  opt[Global] = opt[Global].none{};
        var g:     usize       = 0;
        for (g < u.m.globals.len && unit.ok(u)) {
            if (reach.uses(r, e, (g::u32))) {
                val list:  Slice[Attribute] = global_attributes(u, g);
                val class: u64              = schema.storage(list);
                if (class == schema.WORKGROUP && !schema.computes(model)) { interface_refused(u, g, Rule.shared{Staged{entry: f, stage: spelled_as(schema.Enumeration.model{}, model)}}); }
                or (class == schema.OUTPUT && !schema.outputs(model))     { interface_refused(u, g, Rule.output{Staged{entry: f, stage: spelled_as(schema.Enumeration.model{}, model)}}); }
                or (class == schema.PUSH_CONSTANT) {
                    if (sel push.some) { interface_refused(u, g, Rule.push{Pushed{entry: f, other: push.some}}); }
                    push = opt[Global].some{(g::u32)};
                }
                val opt_builtin: opt[u64] = schema.integer(list, "builtin");
                if (sel opt_builtin.some) {
                    val x: Exists = exists(opt_builtin.some);
                    if (unit.ok(u) && !exists_in(x, model)) {
                        interface_refused(u, g, Rule.builtin{Builtin{entry: f, stage: spelled_as(schema.Enumeration.model{}, model), builtin: spelled_as(schema.Enumeration.builtin{}, opt_builtin.some), exists: exists_words(x)}});
                    }
                }
                val opt_confined: opt[*capability.Confined] = confinement_of(u, u.m.globals.data[g].data.type);
                if (sel opt_confined.some) {
                    val c: *capability.Confined = opt_confined.some;
                    if (unit.ok(u) && !capability.confined_to(c, model)) {
                        interface_refused(u, g, Rule.handle{Handled{entry: f, stage: spelled_as(schema.Enumeration.model{}, model), exists: c.names, why: c.why}});
                    }
                }
            }
            g = g + 1;
        }
        e = e + 1;
    }
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        if (schema.storage(global_attributes(u, g)) == schema.INPUT && flat_typed(u, u.m.globals.data[g].data.type)) {
            val opt_fragment: opt[Function] = reader(u, r, g, FRAGMENT);
            val opt_vertex:   opt[Function] = reader(u, r, g, VERTEX);
            if (sel opt_fragment.some) {
                if (sel opt_vertex.some) { interface_refused(u, g, Rule.flat{Flat{fragment: opt_fragment.some, vertex: opt_vertex.some}}); }
            }
        }
        g = g + 1;
    }
}

# an entry point of execution model `model` that reaches global `g`, none
# where none does
fun reader(u: *Unit, r: *Reach, g: usize, model: u64) opt[Function] {
    var e: usize = 0;
    for (e < r.entries.len) {
        if (model_of(u, r.entries.data[e]) == model && reach.uses(r, e, (g::u32))) { ret opt[Function].some{r.entries.data[e]}; }
        e = e + 1;
    }
    ret opt[Function].none{};
}

# the stage rule: an instruction is reached only from entry points of the
# execution models masc's typing of its row states it executes in, as the
# derivatives, the implicit-lod forms and OpImageQueryLod execute in Fragment,
# the one model whose invocations have coordinate derivatives, as no entry
# point states a derivative group
fun derivative_rules(u: *Unit, r: *Reach) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        val b: *Body       = ?u.m.functions.data[f].body;
        var k: usize       = 0;
        var j: Instruction = NO_INSTRUCTION;
        if (b.blocks.len > 0) { j = b.blocks.data[0].first; }
        for (k < b.blocks.len && unit.ok(u)) {
            if (j == NO_INSTRUCTION) {
                k = k + 1;
                if (k < b.blocks.len) { j = b.blocks.data[k].first; }
                cnt;
            }
            val i: Instruction = j;
            j = b.instructions.data[i].next;
            val opt_executes: opt[*typing.Executes] = code.executes_in(u, ?b.instructions.data[i]);
            if (sel opt_executes.some) {
                var e: usize = 0;
                for (e < r.entries.len && unit.ok(u)) {
                    val model: u64 = model_of(u, r.entries.data[e]);
                    if (!code.executes(opt_executes.some, model) && reach.reaches(r, e, (f::u32))) {
                        val at: At = At{function: (f::u32), instruction: i, location: ir_function.location(b, i)};
                        unit.fail(u, Error.executed{Executed{at: at, entry: r.entries.data[e], stage: spelled_as(schema.Enumeration.model{}, model), models: opt_executes.some.names}});
                    }
                    e = e + 1;
                }
            }
        }
        f = f + 1;
    }
}

# the access rules of the bindings: no store a function follows reaches a
# `readonly` binding or a push-constant block, and no load a `writeonly` one
fun access_rules(u: *Unit, r: *Reach) {
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        val list:  Slice[Attribute] = global_attributes(u, g);
        val class: u64              = schema.storage(list);
        val dn:    reach.Done       = reach.done(r, (g::u32));
        if (sel dn.stored.some) {
            if (class == schema.PUSH_CONSTANT) { unit.fail(u, Error.readonly{Stored{site: Site.at{dn.stored.some}, binding: (g::u32), why: Unwritable.push{}}}); }
            or (decorates(list, NON_WRITABLE)) { unit.fail(u, Error.readonly{Stored{site: Site.at{dn.stored.some}, binding: (g::u32), why: Unwritable.qualified{}}}); }
        }
        if (sel dn.loaded.some) {
            if (unit.ok(u) && decorates(list, NON_READABLE)) { unit.fail(u, Error.writeonly{Loaded{site: Site.at{dn.loaded.some}, binding: (g::u32)}}); }
        }
        g = g + 1;
    }
}

# Flat on each input of an integer or 64-bit type a fragment stage reads
# that its attributes do not decorate Flat already
fun flats(u: *Unit, r: *Reach) {
    var g: usize = 0;
    for (g < u.m.globals.len) {
        val list: Slice[Attribute] = global_attributes(u, g);
        if (schema.storage(list) == schema.INPUT && !decorates(list, FLAT::u64) && flat_typed(u, u.m.globals.data[g].data.type)) {
            val opt_fragment: opt[Function] = reader(u, r, g, FRAGMENT);
            if (sel opt_fragment.some) { spirv_types.decorate(u, u.globals.data[g], FLAT); }
        }
        g = g + 1;
    }
}

# NonWritable on each storage buffer and storage image no function stores through or lets its
# address escape from, which its attributes do not decorate NonWritable already: a store through a
# pointer read out of memory writes the buffer that pointer reaches, never this one
fun unwritten(u: *Unit, r: *Reach) {
    var g: usize = 0;
    for (g < u.m.globals.len) {
        val list:     Slice[Attribute] = global_attributes(u, g);
        val class:    u64              = schema.storage(list);
        val writable: bool             = class == schema.STORAGE_BUFFER || (class == schema.UNIFORM_CONSTANT && storage_image(u, u.m.globals.data[g].data.type));
        if (u.held.data[g] && writable && !decorates(list, NON_WRITABLE)) {
            val dn: reach.Done = reach.done(r, (g::u32));
            if (sel dn.stored.none) {
                if (!dn.escaped) { spirv_types.decorate(u, u.globals.data[g], NON_WRITABLE::u32); }
            }
        }
        g = g + 1;
    }
}

val IMAGE_KIND:      str   = "spirv.image";
val SAMPLED_INDEX:   usize = 5;
val SAMPLED_STORAGE: u32   = 2;

# whether `ty` is a storage image, an image whose Sampled operand is 2, a
# storage texel buffer among them
fun storage_image(u: *Unit, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, ty);
    if (sel res_shape.err) { ret false; }
    val sh: type_table.Shape = res_shape.ok;
    if (!(sel sh.handle))                                                                        { ret false; }
    if (slice.order_view(sh.handle.kind, View{data: IMAGE_KIND, len: str_len(IMAGE_KIND)}) != 0) { ret false; }
    if (sh.handle.operands.size <= SAMPLED_INDEX)                                                { ret false; }
    val x: type_table.HandleOperand = sh.handle.operands.data[SAMPLED_INDEX];
    if (sel x.word) { ret x.word == SAMPLED_STORAGE; }
    ret false;
}

# a linkage decoration of an id
fun linked(u: *Unit, id: u32, name: View, kind: u32) {
    var params: [2]Slot = [2]Slot{Slot.literal{unit.text(u, name)}, unit.enumerant(kind)};
    var s:      [2]Slot = [2]Slot{Slot.id{id}, unit.enumerant_of(spirv_types.LINKAGE_ATTRIBUTES, unit.slots(u, ?params[0], 2))};
    unit.put(u, buffer.ANNOTATIONS, gen_row_index.OPDECORATE, ?s[0], 2);
}

# the linkage type of a definition other objects may refer to: link-once for
# a weak one, an instance every object using it may define, of which the
# link keeps one, and export for any other
fun exported(l: linkage.Linkage) u32 {
    if (linkage.overridable(l)) { ret LINK_ONCE_ODR; }
    ret EXPORT;
}

# the names of the module's functions, and its exports and imports when it
# is an object
fun linkage_of(u: *Unit, r: *Reach, relocatable: bool) {
    var f: usize = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        if (absent(u, r, f)) {
            f = f + 1;
            cnt;
        }
        val fd:   FunctionData     = u.m.functions.data[f].data;
        val list: Slice[Attribute] = attributes(?u.m.functions.data[f].attributes);
        val id:   u32              = u.functions.data[f];
        spirv_types.name(u, id, module.name_of(u.m, fd.name));
        val opt_stage: opt[u64] = schema.integer(list, "stage");
        if (sel opt_stage.none) {
            if (declared(u, f)) {
                if (relocatable) { linked(u, id, module.name_of(u.m, fd.name), IMPORT); }
                or               { unit.fail(u, Error.imported{Import.function{(f::u32)}}); }
            }
            or (relocatable && fd.linkage.replaceable)       { unit.fail(u, Error.replaceable{Import.function{(f::u32)}}); }
            or (relocatable && linkage.external(fd.linkage)) { linked(u, id, module.name_of(u.m, fd.name), exported(fd.linkage)); }
        }
        f = f + 1;
    }
    var g: usize = 0;
    for (g < u.m.globals.len && unit.ok(u)) {
        if (u.held.data[g] && u.classes.data[g]::u64 == schema.PRIVATE) {
            val gd: GlobalData = u.m.globals.data[g].data;
            if (spirv_types.imported(u, g)) {
                if (relocatable) { linked(u, u.globals.data[g], module.name_of(u.m, gd.name), IMPORT); }
                or               { unit.fail(u, Error.imported{Import.global{(g::u32)}}); }
            }
            or (relocatable && gd.linkage.replaceable)       { unit.fail(u, Error.replaceable{Import.global{(g::u32)}}); }
            or (relocatable && linkage.external(gd.linkage)) { linked(u, u.globals.data[g], module.name_of(u.m, gd.name), exported(gd.linkage)); }
        }
        g = g + 1;
    }
}

# the capabilities and extensions a module declares
# ---
# capabilities: their values
# extensions:   their atoms
# added:        the atoms declared that the build's selection does not hold
rec Declared {
    capabilities: vector.Vector[u32];
    extensions:   vector.Vector[requirement.Id];
    added:        vector.Vector[requirement.Id];
}

fun has_id(v: *vector.Vector[requirement.Id], id: requirement.Id) bool {
    var i: usize = 0;
    for (i < v.len) {
        if (v.data[i] == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun push_id(u: *Unit, v: *vector.Vector[requirement.Id], id: requirement.Id) {
    if (has_id(v, id)) { ret; }
    val res_pushed: res[usize, allocator.Error] = vector.push[requirement.Id](v, id);
    if (sel res_pushed.err) { unit.lost(u, res_pushed.err); }
}

fun capability_value(id: requirement.Id) opt[u32] {
    var i: u32 = 0;
    for (i < gen_operand.CAPABILITY_ATOM_COUNT) {
        if (gen_operand.CAPABILITY_ATOMS[i].id == id) { ret opt[u32].some{gen_operand.CAPABILITY_ATOMS[i].value::u32}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun version(id: requirement.Id) bool {
    var i: u32 = 0;
    for (i < gen_operand.VERSION_ATOM_COUNT) {
        if (gen_operand.VERSION_ATOMS[i].id == id) { ret true; }
        i = i + 1;
    }
    ret false;
}

# an atom the module needs, declared as a capability or an extension
fun declare(u: *Unit, d: *Declared, id: requirement.Id) {
    if (version(id))                               { ret; }
    if (!core_state.holds(?u.b.basis.context, id)) { push_id(u, ?d.added, id); }
    val opt_cap: opt[u32] = capability_value(id);
    if (sel opt_cap.some) {
        var i: usize = 0;
        for (i < d.capabilities.len) {
            if (d.capabilities.data[i] == opt_cap.some) { ret; }
            i = i + 1;
        }
        push_u32(u, ?d.capabilities, opt_cap.some);
        declarable(u, opt_cap.some);
        ret;
    }
    push_id(u, ?d.extensions, id);
}

# what declaring capability `value` needs: the version or an extension its
# member of the grammar is available under, which a selection naming the
# capability alone may not hold
fun declarable(u: *Unit, value: u32) {
    var i: usize = 0;
    for (i < $length_of(gen_operand.CAPABILITY_MEMBERS)) {
        if (gen_operand.CAPABILITY_MEMBERS[i].value::u32 == value) {
            unit.keep(u, buffer.need(?u.buf, gen_operand.CAPABILITY_MEMBERS[i].requires));
            ret;
        }
        i = i + 1;
    }
}

fun unmet(u: *Unit, id: requirement.Id, at: opt[At]) {
    val res_named: res[str, basis.Error] = basis.extension_name(u.t, id);
    var name:      str                   = "?";
    if (sel res_named.ok) { name = res_named.ok; }
    unit.fail(u, Error.unmet{Unmet{name: name, at: at}});
}

# what the module's instructions require, met the first way the build holds,
# and what declaring each capability needs in turn
fun required(u: *Unit, d: *Declared) {
    val ctx:  *core_state.Context = ?u.b.basis.context;
    val from: usize               = met(u, d, 0);
    var i:    usize               = 0;
    for (i < u.buf.atoms.len && unit.ok(u)) {
        val id: requirement.Id = u.buf.atoms.data[i];
        if (unit.holds(ctx, id)) { declare(u, d, id); }
        or                       { unmet(u, id, u.buf.atom_sites.data[i]); }
        i = i + 1;
    }
    met(u, d, from);
}

# the needs from `from` on met the first way the build holds, the first
# unheld atom of the first way refused where none is, giving where they end
fun met(u: *Unit, d: *Declared, from: usize) usize {
    val ctx: *core_state.Context = ?u.b.basis.context;
    var i:   usize               = from;
    for (i < u.buf.needs.len && unit.ok(u)) {
        val r:     requirement.Requirement = u.buf.needs.data[i];
        var found: bool                    = false;
        var k:     u32                     = 0;
        for (k < r.len && !found) {
            if (unit.meets(ctx, r.at[k])) {
                found = true;
                var j: u32 = 0;
                for (j < r.at[k].all.len) {
                    declare(u, d, r.at[k].all.at[j]);
                    j = j + 1;
                }
            }
            k = k + 1;
        }
        if (!found) {
            val opt_named: opt[requirement.Id] = unit.remedy(u, r);
            if (sel opt_named.some) { unmet(u, opt_named.some, u.buf.need_sites.data[i]); }
            or                      { unit.fail(u, Error.unmet{Unmet{name: "?", at: u.buf.need_sites.data[i]}}); }
        }
        i = i + 1;
    }
    ret i;
}

# the memory model the module states: Vulkan where the build holds
# VulkanMemoryModel, GLSL450 otherwise
fun memory_model(u: *Unit) u32 {
    if (core_state.holds(?u.b.basis.context, gen_extension.VULKANMEMORYMODEL)) { ret VULKAN; }
    ret GLSL450;
}

# the addressing model the module states: PhysicalStorageBuffer64 where it
# declares a pointer into PhysicalStorageBuffer, logical otherwise
fun addressing_model(u: *Unit) u32 {
    var i: usize = 0;
    for (i < u.shapes.len) {
        val s: unit.Shape = u.shapes.data[i];
        if (s.row == gen_row_index.OPTYPEPOINTER && s.a::u64 == schema.PHYSICAL_STORAGE_BUFFER) { ret PHYSICAL_STORAGE_BUFFER_64; }
        i = i + 1;
    }
    ret LOGICAL;
}

# the requirement of the enumerant of `value` among `members`
fun enumerant_need(u: *Unit, members: Slice[mo.Enumerant], value: u32) {
    var i: usize = 0;
    for (i < members.size) {
        if (members.data[i].value == value) {
            unit.keep(u, buffer.need(?u.buf, members.data[i].requires));
            ret;
        }
        i = i + 1;
    }
}

# what the two models the module states require
fun models(u: *Unit) {
    enumerant_need(u, Slice[mo.Enumerant]{data: ?gen_operand.MEMORYMODEL_MEMBERS[0], size: $length_of(gen_operand.MEMORYMODEL_MEMBERS)}, memory_model(u));
    enumerant_need(u, Slice[mo.Enumerant]{data: ?gen_operand.ADDRESSINGMODEL_MEMBERS[0], size: $length_of(gen_operand.ADDRESSINGMODEL_MEMBERS)}, addressing_model(u));
}

# mink's choice of a model's value
fun memory_choice(model: u32) *mink_trait.Choice {
    if (model == VULKAN) { ret ?spirv_arch.SPIRV_VULKAN; }
    ret ?spirv_arch.SPIRV_GLSL450;
}

fun addressing_choice(model: u32) *mink_trait.Choice {
    if (model == PHYSICAL_STORAGE_BUFFER_64) { ret ?spirv_arch.SPIRV_PHYSICAL_STORAGE_BUFFER64; }
    ret ?spirv_arch.SPIRV_LOGICAL;
}

# the context the module is built under: the build's, widened by what the
# module declares that the selection does not hold
rec Wide {
    selection: extension.Selection;
    view:      rf.Available;
    context:   core_state.Context;
    made:      bool;
}

fun widen(u: *Unit, d: *Declared, w: *Wide) err[Error] {
    w.made = false;
    if (d.added.len == 0) { ret err[Error].ok{}; }
    val res_chosen: res[extension.Selection, extension.Error] = extension.added(u.a, ?u.b.basis.selection, requirement.Ids{at: d.added.data, len: d.added.len::u32});
    if (sel res_chosen.err) { ret err[Error].err{Error.basis{basis.Error.extensions{res_chosen.err}}}; }
    w.selection = res_chosen.ok;
    val res_opened: res[core_state.Context, core_state.Error] = mset.context_make(u.a, u.b.basis.set, u.b.basis.arch, ?w.selection, ?w.view);
    if (sel res_opened.err) {
        val err_dropped: err[allocator.Error] = extension.dnit(?w.selection);
        ret err[Error].err{Error.basis{basis.Error.state{res_opened.err}}};
    }
    w.context = res_opened.ok;
    w.made    = true;
    ret err[Error].ok{};
}

fun narrow(w: *Wide) {
    if (!w.made) { ret; }
    rf.dnit(?w.view);
    val err_dropped: err[allocator.Error] = extension.dnit(?w.selection);
}

fun refused(r: refusal.Refusal) Error {
    ret Error.builder{r};
}

fun emitted(b: *state.Builder, row: u32, values: *mo.Value, n: u32) err[Error] {
    var i:        inst.Inst            = inst.Inst{row: ?gen_row.ROWS[row], values: values, count: n, form: form.PREFERRED};
    val err_emit: err[refusal.Refusal] = emit.emit(b, ?i, mo.NO_FIXUP);
    if (sel err_emit.err) { ret err[Error].err{refused(err_emit.err)}; }
    ret err[Error].ok{};
}

fun choice(b: *state.Builder, axis: *mink_trait.Axis, value: *mink_trait.Choice) err[Error] {
    val err_state: err[refusal.Refusal] = trait.state(b, mink_trait.Trait{axis: axis, setting: mink_trait.Setting.choice{value}});
    if (sel err_state.err) { ret err[Error].err{refused(err_state.err)}; }
    ret err[Error].ok{};
}

# the module handed to masc's builder: its declarations, its models and
# every section of its logical layout in order
fun handed(u: *Unit, d: *Declared, ctx: *core_state.Context, sink: opt[*Stats]) res[object.Object, Error] {
    val format:   *Format                             = record.format(u.t);
    val res_made: res[state.Builder, refusal.Refusal] = build.init_named(u.a, u.b.formats, u.b.basis.set, ctx, u.t.arch, format, module.lend(u.m));
    if (sel res_made.err) {
        module.spent(u.m);
        ret res[object.Object, Error].err{refused(res_made.err)};
    }
    var b:     state.Builder = res_made.ok;
    var taken: bool          = false;
    module.lent_to(u.m, ?build.output(?b).names);
    fin {
        if (taken) { module.spent(u.m); }
        or         { module.take_back(u.m, build.output(?b)); }
        build.dnit(?b);
    }
    if (sel sink.some) { build.measure(?b, ?sink.some.masc); }
    val err_named: err[refusal.Refusal] = trait.traits(?b, ?spirv_arch.SPIRV_SHADER);
    if (sel err_named.err) { ret res[object.Object, Error].err{refused(err_named.err)}; }
    val err_begun: err[refusal.Refusal] = build_section.begin(?b, state.Spec{name: opt[str].none{}, kind: ?section.TEXT, flags: section.TEXT.flags, disposition: ?section.WHOLE, entsize: 0, apart: false});
    if (sel err_begun.err) { ret res[object.Object, Error].err{refused(err_begun.err)}; }
    var one: [1]mo.Value = [1]mo.Value{mo.Value.none{}};
    var i:   usize       = 0;
    for (i < d.capabilities.len) {
        one[0] = mo.enumerant(d.capabilities.data[i]);
        val err_emitted: err[Error] = emitted(?b, gen_row_index.OPCAPABILITY, ?one[0], 1);
        if (sel err_emitted.err) { ret res[object.Object, Error].err{err_emitted.err}; }
        i = i + 1;
    }
    i = 0;
    for (i < d.extensions.len) {
        val res_name: res[str, basis.Error] = basis.extension_name(u.t, d.extensions.data[i]);
        if (sel res_name.err) { ret res[object.Object, Error].err{Error.basis{res_name.err}}; }
        one[0] = mo.Value.literal{mo.Bytes{at: res_name.ok, len: str_len(res_name.ok)::u32}};
        val err_emitted: err[Error] = emitted(?b, gen_row_index.OPEXTENSION, ?one[0], 1);
        if (sel err_emitted.err) { ret res[object.Object, Error].err{err_emitted.err}; }
        i = i + 1;
    }
    val err_addressed: err[Error] = choice(?b, ?spirv_arch.SPIRV_ADDRESSING_MODEL, addressing_choice(addressing_model(u)));
    if (sel err_addressed.err) { ret res[object.Object, Error].err{err_addressed.err}; }
    val err_modelled: err[Error] = choice(?b, ?spirv_arch.SPIRV_MEMORY_MODEL, memory_choice(memory_model(u)));
    if (sel err_modelled.err) { ret res[object.Object, Error].err{err_modelled.err}; }
    var values: vector.Vector[mo.Value] = vector.init[mo.Value](u.a);
    fin { vector.dnit[mo.Value](?values); }
    var s: usize = 0;
    for (s < buffer.SECTIONS) {
        val list: *vector.Vector[Ins] = ?u.buf.sections[s];
        var k:    usize               = 0;
        for (k < list.len) {
            val ins:        Ins                             = list.data[k];
            val res_values: res[*mo.Value, allocator.Error] = buffer.values(?u.buf, ins, ?values);
            if (sel res_values.err) { ret res[object.Object, Error].err{Error.alloc{res_values.err}}; }
            val err_put: err[Error] = emitted(?b, ins.row, res_values.ok, ins.count);
            if (sel err_put.err) { ret res[object.Object, Error].err{err_put.err}; }
            k = k + 1;
        }
        s = s + 1;
    }
    val res_finished: res[*object.Object, refusal.Refusal] = build.finish(?b);
    if (sel res_finished.err) { ret res[object.Object, Error].err{refused(res_finished.err)}; }
    val res_handed_over: res[object.Object, refusal.Refusal] = build.take(?b);
    if (sel res_handed_over.err) { ret res[object.Object, Error].err{refused(res_handed_over.err)}; }
    taken = true;
    ret res[object.Object, Error].ok{res_handed_over.ok};
}

# the module laid out: its debug strings, its variables, the Flat its
# fragment stages' inputs take and the NonWritable its unwritten storage
# buffers take, every function's signature then its code, its
# entry points and its linkage
fun laid(u: *Unit, r: *Reach, relocatable: bool) {
    debug.open(u);
    var f: usize = 0;
    for (f < u.m.functions.len) {
        push_u32(u, ?u.functions, unit.fresh(u));
        f = f + 1;
    }
    var g: usize = 0;
    for (g < u.m.globals.len) {
        val res_held: res[usize, allocator.Error] = vector.push[bool](?u.held, !u.closed || reach.holds(r, (g::u32)));
        if (sel res_held.err) { unit.lost(u, res_held.err); }
        g = g + 1;
    }
    if (unit.ok(u)) { spirv_types.variables(u); }
    if (unit.ok(u)) { flats(u, r); }
    if (unit.ok(u)) { unwritten(u, r); }
    if (unit.ok(u)) { signatures(u, r); }
    f = 0;
    for (f < u.m.functions.len && unit.ok(u)) {
        if (!absent(u, r, f)) { code.function(u, (f::u32)); }
        f = f + 1;
    }
    if (unit.ok(u)) { entries(u, r); }
    if (unit.ok(u)) { linkage_of(u, r, relocatable); }
    if (unit.ok(u)) { models(u); }
}

# compile a scheduled module into mink's object of one spir-v module
# ---
# a:           the allocator every stage and the object take
# m:           the module, scheduled
# b:           the build the family opened
# t:           the target
# relocatable: write a relocatable unit of Linkage, else a finished module
# closed:      nothing outside the unit refers into it, so it holds only what its entry points reach
# sink:        where masc's layout and encode times and instruction count are kept, none for none
# ret:         the object, or why it was not made
pub fun compile(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, relocatable: bool, closed: bool, sink: opt[*Stats]) res[object.Object, Error] {
    var l: Layout = layout.of(t, ?m.types, basis.context_of(opt[*basis.Basis].some{?b.basis}));
    var c: Cache  = cache.init(m, t, opt[*basis.Basis].some{?b.basis}, analysis.rows(), analysis.OF_STRUCTURE);
    fin { val err_dropped: err[allocator.Error] = cache.dnit(?c); }
    var u: Unit = unit.init(a, m, b, t, ?l, ?c);
    fin { unit.dnit(?u); }
    u.closed = !relocatable || closed;
    val res_reach: res[Reach, allocator.Error] = reach.init(a, m, staged, t.caps.ops);
    if (sel res_reach.err) { ret res[object.Object, Error].err{Error.alloc{res_reach.err}}; }
    var r: Reach = res_reach.ok;
    fin { reach.dnit(?r); }
    if (sel r.cycle.some) { unit.fail(?u, Error.recursion{r.cycle.some}); }
    if (unit.ok(?u))      { stage_rules(?u, ?r); }
    if (unit.ok(?u))      { access_rules(?u, ?r); }
    if (unit.ok(?u))      { derivative_rules(?u, ?r); }
    if (unit.ok(?u))      { laid(?u, ?r, relocatable); }
    var d: Declared = Declared{capabilities: vector.init[u32](a), extensions: vector.init[requirement.Id](a), added: vector.init[requirement.Id](a)};
    fin {
        vector.dnit[u32](?d.capabilities);
        vector.dnit[requirement.Id](?d.extensions);
        vector.dnit[requirement.Id](?d.added);
    }
    if (unit.ok(?u))                { required(?u, ?d); }
    if (unit.ok(?u) && relocatable) { declare(?u, ?d, gen_extension.LINKAGE); }
    if (sel u.failed.some)          { ret res[object.Object, Error].err{u.failed.some}; }
    var w:           Wide;
    val err_widened: err[Error] = widen(?u, ?d, ?w);
    if (sel err_widened.err) { ret res[object.Object, Error].err{err_widened.err}; }
    fin { narrow(?w); }
    var ctx: *core_state.Context = ?b.basis.context;
    if (w.made) { ctx = ?w.context; }
    ret handed(?u, ?d, ctx, sink);
}
