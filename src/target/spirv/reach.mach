# what each entry point of a module reaches
#
# the call graph is every function a function calls or takes the address
# of, and an entry point reaches each function of its call tree and each
# global those functions name, and holds no cycle. an access is judged by the root of its
# pointer: the global an address constant names, or a parameter of the
# function it is made in, through any member or element chain into either.
# a store or an atomic other than a load writes its root, a load or an atomic
# other than a store reads it, and a call passes what the callee does to its
# parameter on to the root of the argument, so an access is followed through
# every call to a function of the module. a target op reads and writes
# through each operand as its row's effect states, and an image passed to one
# is accessed in the variable it is loaded from, while loading the image reads
# no memory. a pointer that flows anywhere else, into memory, a block
# argument, a call the module only declares or an operand of a target op its
# row states no access of, escapes: what it is used for is not followed, so
# it counts as a write and as a read, and is never the site of a refusal. a pointer loaded
# from memory or made from an integer has no root, so an access through it
# is no access of the binding it was read from.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use me: masc.core.effect;
use masc.core.field;
use mo:   masc.core.operand;
use mrow: masc.core.row;

use mirl.ir.constant.ConstantData;
use mirl.ir.debug.record.Location;
use ir_function: mirl.ir.function;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.native.Op;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.table;
use type_table: mirl.ir.type.table;
use mirl.ir.value.Def;
use mirl.target.capability;
use mirl.target.capability.Ops;
use mirl.target.spirv.access;
use mirl.target.spirv.emitter.NOWHERE;
use mirl.target.spirv.error.At;

# what an access reaches through its pointer
# ---
# none:   nothing the module names, as a pointer loaded from memory
# global: a global
# param:  a parameter of the function the access is made in, by its position
pub tag Root: u8 {
    none;
    global: Global;
    param:  u32;
}

# what is done to a global or a parameter: the first followed store and load
# that reach it, and whether its address escapes
pub rec Done {
    stored:  opt[At];
    loaded:  opt[At];
    escaped: bool;
}

# a call that passes a pointer argument
# ---
# caller: the calling function
# root:   the root of the argument
# callee: the function called
# param:  the parameter the argument is
rec Passing {
    caller: Function;
    root:   Root;
    callee: Function;
    param:  u32;
}

# the call graph of a module and what each entry point reaches
# ---
# a:       the allocator its lists take
# m:       the module
# entries: each entry point, a function with a stage
# reached: whether an entry reaches a function, at entry * functions + function
# named:   whether a function names a global, at function * globals + global
# globals: what is done to each global
# bases:   where each function's parameters begin among `params`
# params:  what is done to each parameter of each function
# cycle:   a call an entry point's call tree holds back to the function that
#          makes it, none where its call graph holds no cycle
# ops:     the instruction sets the target's catalog holds, whose rows state
#          the memory a target op reads and writes through each operand
pub rec Reach {
    a:       *allocator.Allocator;
    m:       *Module;
    entries: vector.Vector[Function];
    reached: vector.Vector[bool];
    named:   vector.Vector[bool];
    globals: vector.Vector[Done];
    bases:   vector.Vector[u32];
    params:  vector.Vector[Done];
    cycle:   opt[At];
    ops:     Ops;
}

val UNDONE: Done = Done{stored: opt[At].none{}, loaded: opt[At].none{}, escaped: false};

fun filled[T](v: *vector.Vector[T], n: usize, x: T) err[allocator.Error] {
    var i: usize = 0;
    for (i < n) {
        val res_pushed: res[usize, allocator.Error] = vector.push[T](v, x);
        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
        i = i + 1;
    }
    ret err[allocator.Error].ok{};
}

# the function an address constant names, none for any other value
fun function_named(m: *Module, b: *Body, v: Value) opt[Function] {
    val d: Def = b.values.data[v].def;
    if (sel d.constant) {
        val res_data: res[ConstantData, module.Error] = module.constant_data(m, d.constant);
        if (sel res_data.err) { ret opt[Function].none{}; }
        val data: ConstantData = res_data.ok;
        if (!(sel data.address)) { ret opt[Function].none{}; }
        val s: Symbol = data.address.symbol;
        if (sel s.function) { ret opt[Function].some{s.function}; }
        ret opt[Function].none{};
    }
    if (sel d.result) {
        val made: *InstructionData = ?b.instructions.data[d.result.instruction];
        if (made.opcode == table.FUNC_ADDR && made.immediates.len > 0) {
            val imm: Immediate = made.immediates.data[0];
            if (sel imm.function) { ret opt[Function].some{imm.function}; }
        }
    }
    ret opt[Function].none{};
}

# the root of a pointer value of a function's body
pub fun root(m: *Module, b: *Body, v: Value) Root {
    var at: Value = v;
    for (true) {
        val d: Def = b.values.data[at].def;
        if (sel d.constant) {
            val res_data: res[ConstantData, module.Error] = module.constant_data(m, d.constant);
            if (sel res_data.err) { ret Root.none{}; }
            val data: ConstantData = res_data.ok;
            if (!(sel data.address)) { ret Root.none{}; }
            val s: Symbol = data.address.symbol;
            if (sel s.global) { ret Root.global{s.global}; }
            ret Root.none{};
        }
        if (sel d.parameter) {
            if (d.parameter.block == 0) { ret Root.param{d.parameter.index}; }
            ret Root.none{};
        }
        if (sel d.result) {
            val made: *InstructionData = ?b.instructions.data[d.result.instruction];
            if ((made.opcode == table.PTR_MEMBER || made.opcode == table.PTR_INDEX) && made.operands.len > 0) {
                at = made.operands.data[0];
                cnt;
            }
        }
        ret Root.none{};
    }
    ret Root.none{};
}

fun pointer(m: *Module, b: *Body, v: Value) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?m.types, b.values.data[v].type);
    if (sel res_shape.err) { ret false; }
    val s: type_table.Shape = res_shape.ok;
    ret sel s.pointer;
}

fun site(m: *Module, f: Function, i: Instruction) At {
    ret At{function: f, instruction: i, location: ir_function.location(?m.functions.data[f].body, i)};
}

# what is done to a root of function `f`, nil for none
fun done_of(r: *Reach, f: Function, x: Root) *Done {
    if (sel x.global) { ret ?r.globals.data[x.global]; }
    if (sel x.param) {
        val k: u32 = r.bases.data[f] + x.param;
        if (k < r.bases.data[f + 1]) { ret ?r.params.data[k]; }
    }
    ret nil;
}

# record what is done to a root, true when it changed
fun note(d: *Done, stored: opt[At], loaded: opt[At], escaped: bool) bool {
    val first_store: bool = sel d.stored.none && sel stored.some;
    val first_load:  bool = sel d.loaded.none && sel loaded.some;
    val first_leak:  bool = escaped && !d.escaped;
    if (first_store) { d.stored = stored; }
    if (first_load)  { d.loaded = loaded; }
    if (first_leak)  { d.escaped = true; }
    ret first_store || first_load || first_leak;
}

# whether a value is an opaque handle, an image, a sampler or a sampled image
fun handle(m: *Module, b: *Body, v: Value) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?m.types, b.values.data[v].type);
    if (sel res_shape.err) { ret false; }
    val s: type_table.Shape = res_shape.ok;
    ret sel s.handle;
}

# the root of a handle value: the root of the pointer it is loaded through,
# as an image is read out of its UniformConstant variable, none for any other
fun held(m: *Module, b: *Body, v: Value) Root {
    val d: Def = b.values.data[v].def;
    if (!(sel d.result)) { ret Root.none{}; }
    val made: *InstructionData = ?b.instructions.data[d.result.instruction];
    if (made.opcode != table.LOAD || made.operands.len == 0) { ret Root.none{}; }
    ret root(m, b, made.operands.data[0]);
}

# the memory each operand of target op `d` is accessed through, as the role
# its row's effect states (masc.core.effect.Access) into `roles` by the op's
# operand index: READ, WRITE or READ_WRITE where the row reads or writes
# memory through that operand, NONE for every other. false where the op names
# no row of the target's catalog, or where an access lies past an operand the
# op's operands do not take one to one, a variadic list or an enumerant, so
# what the op does is not followed and its pointers escape
fun accessed(r: *Reach, d: *InstructionData, roles: *vector.Vector[u8]) res[bool, allocator.Error] {
    if (d.immediates.len == 0) { ret res[bool, allocator.Error].ok{false}; }
    val imm: Immediate = d.immediates.data[0];
    var o:   *Op       = nil;
    if (sel imm.op) { o = imm.op; }
    if (o == nil)   { ret res[bool, allocator.Error].ok{false}; }
    val held_ops: Ops = r.ops;
    if (!(sel held_ops.catalog)) { ret res[bool, allocator.Error].ok{false}; }
    val opt_set: opt[*capability.OpSet] = capability.op_set(held_ops.catalog, o.set);
    if (sel opt_set.none) { ret res[bool, allocator.Error].ok{false}; }
    val opt_row: opt[*mrow.Row] = capability.op_row(held_ops.catalog, opt_set.some, o.name);
    if (sel opt_row.none) { ret res[bool, allocator.Error].ok{false}; }
    val row:  *mrow.Row = opt_row.some;
    val lead: u32       = capability.supplies(opt_set.some, row);
    var k:    usize     = 0;
    for (k < d.operands.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](roles, mo.NONE);
        if (sel res_pushed.err) { ret res[bool, allocator.Error].err{res_pushed.err}; }
        k = k + 1;
    }
    var a: u32 = 0;
    for (a < row.effect.memory.len) {
        val x: *me.Access = ?row.effect.memory.at[a];
        a = a + 1;
        if (x.operand == field.NO_OPERAND || x.operand::u32 < lead || x.operand::u32 >= row.operands.len) { cnt; }
        var j: u32 = lead;
        for (j < x.operand::u32) {
            val before: *mo.Operand = ?row.operands.at[j];
            if (before.quantity == mo.VARIADIC || sel before.shape.enumerant) { ret res[bool, allocator.Error].ok{false}; }
            j = j + 1;
        }
        val at: usize = (x.operand::u32 - lead)::usize;
        if (at < roles.len) { roles.data[at] = roles.data[at] | capability.access_role(row, x); }
    }
    ret res[bool, allocator.Error].ok{true};
}

# what instruction `i` of function `f` does to the root of each pointer it
# takes, keeping each call that passes one to a function of the module
fun direct(r: *Reach, f: Function, b: *Body, i: Instruction, calls: *vector.Vector[Passing]) err[allocator.Error] {
    val d:     *InstructionData  = ?b.instructions.data[i];
    val code:  u32               = d.opcode;
    var roles: vector.Vector[u8] = vector.init[u8](r.a);
    fin { vector.dnit[u8](?roles); }
    var rowed: bool = false;
    if (table.target_op(code)) {
        val res_rowed: res[bool, allocator.Error] = accessed(r, d, ?roles);
        if (sel res_rowed.err) { ret err[allocator.Error].err{res_rowed.err}; }
        rowed = res_rowed.ok;
    }
    var k: usize = 0;
    for (k < d.operands.len) {
        val v: Value = d.operands.data[k];
        k = k + 1;
        var role: u8 = mo.NONE;
        if (rowed && k - 1 < roles.len) { role = roles.data[k - 1]; }
        var x: Root = Root.none{};
        if (pointer(r.m, b, v))                   { x = root(r.m, b, v); }
        or (role != mo.NONE && handle(r.m, b, v)) { x = held(r.m, b, v); }
        or                                        { cnt; }
        if (sel x.none)                           { cnt; }
        val dn:  *Done   = done_of(r, f, x);
        val at:  opt[At] = opt[At].some{site(r.m, f, i)};
        val pos: usize   = k - 1;
        if (dn == nil)                                                         { cnt; }
        if ((code == table.PTR_MEMBER || code == table.PTR_INDEX) && pos == 0) { cnt; }
        if (rowed && role != mo.NONE) {
            var stored: opt[At] = opt[At].none{};
            var loaded: opt[At] = opt[At].none{};
            if ((role & mo.WRITE) != 0) { stored = at; }
            if ((role & mo.READ) != 0)  { loaded = at; }
            val changed: bool = note(dn, stored, loaded, false);
            cnt;
        }
        # a handle loaded from its variable reads no memory: what reads or writes the image is the op it is passed to
        if (code == table.LOAD && pos == 0 && d.results.len > 0) {
            if (handle(r.m, b, d.results.data[0])) { cnt; }
        }
        if (code == table.LOAD && pos == 0) {
            val changed: bool = note(dn, opt[At].none{}, at, false);
            cnt;
        }
        if (code == table.STORE && pos == 0) {
            val changed: bool = note(dn, at, opt[At].none{}, false);
            cnt;
        }
        if (code == table.ATOMIC_LOAD && pos == 0) {
            val changed: bool = note(dn, opt[At].none{}, at, false);
            cnt;
        }
        if (code == table.ATOMIC_STORE && pos == 0) {
            val changed: bool = note(dn, at, opt[At].none{}, false);
            cnt;
        }
        if (access.atomic(code) && pos == 0) {
            val changed: bool = note(dn, at, at, false);
            cnt;
        }
        if ((code == table.CALL || code == table.CALL_PLACED) && pos > 0) {
            val opt_callee: opt[Function] = function_named(r.m, b, d.operands.data[0]);
            if (sel opt_callee.some) {
                if (r.m.functions.data[opt_callee.some].body.blocks.len != 0) {
                    val res_pushed: res[usize, allocator.Error] = vector.push[Passing](calls, Passing{caller: f, root: x, callee: opt_callee.some, param: (pos - 1)::u32});
                    if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
                    cnt;
                }
            }
        }
        val changed: bool = note(dn, opt[At].none{}, opt[At].none{}, true);
    }
    ret err[allocator.Error].ok{};
}

# the functions `f` calls or takes the address of, and the globals it names
fun graph(r: *Reach, f: Function, callees: *vector.Vector[Function]) err[allocator.Error] {
    val b: *Body = ?r.m.functions.data[f].body;
    val g: usize = r.m.globals.len;
    var k: usize = 0;
    for (k < b.values.len) {
        val d: Def = b.values.data[k].def;
        if (sel d.constant) {
            val res_data: res[ConstantData, module.Error] = module.constant_data(r.m, d.constant);
            if (sel res_data.ok) {
                val data: ConstantData = res_data.ok;
                if (sel data.address) {
                    val s: Symbol = data.address.symbol;
                    if (sel s.global) { r.named.data[f::usize * g + s.global::usize] = true; }
                    if (sel s.function) {
                        val res_pushed: res[usize, allocator.Error] = vector.push[Function](callees, s.function);
                        if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
                    }
                }
            }
        }
        k = k + 1;
    }
    k = 0;
    for (k < b.instructions.len) {
        val d: *InstructionData = ?b.instructions.data[k];
        if (d.opcode == table.FUNC_ADDR && d.immediates.len > 0) {
            val imm: Immediate = d.immediates.data[0];
            if (sel imm.function) {
                val res_pushed: res[usize, allocator.Error] = vector.push[Function](callees, imm.function);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

# mark every function entry `e` reaches from function `from`
fun tree(r: *Reach, e: usize, from: Function, edges: *vector.Vector[vector.Vector[Function]]) err[allocator.Error] {
    val n:    usize                   = r.m.functions.len;
    var work: vector.Vector[Function] = vector.init[Function](r.a);
    fin { vector.dnit[Function](?work); }
    r.reached.data[e * n + from::usize] = true;
    val res_first: res[usize, allocator.Error] = vector.push[Function](?work, from);
    if (sel res_first.err) { ret err[allocator.Error].err{res_first.err}; }
    for (work.len > 0) {
        val next: Function = work.data[work.len - 1];
        work.len = work.len - 1;
        val out: *vector.Vector[Function] = ?edges.data[next];
        var c:   usize                    = 0;
        for (c < out.len) {
            val g: Function = out.data[c];
            if (!r.reached.data[e * n + g::usize]) {
                r.reached.data[e * n + g::usize] = true;
                val res_pushed: res[usize, allocator.Error] = vector.push[Function](?work, g);
                if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            }
            c = c + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

# the first call of a function an entry point reaches whose callee leads back
# to it, none where no call does: the static call graph of an entry point
# holds no cycle, since spir-v has no call stack (2.16.1)
fun cycle(r: *Reach, edges: *vector.Vector[vector.Vector[Function]]) res[opt[At], allocator.Error] {
    val n:    usize                   = r.m.functions.len;
    var seen: vector.Vector[bool]     = vector.init[bool](r.a);
    var work: vector.Vector[Function] = vector.init[Function](r.a);
    fin {
        vector.dnit[bool](?seen);
        vector.dnit[Function](?work);
    }
    val err_seen: err[allocator.Error] = filled[bool](?seen, n, false);
    if (sel err_seen.err) { ret res[opt[At], allocator.Error].err{err_seen.err}; }
    var f: usize = 0;
    for (f < n) {
        if (!reached_by_any(r, (f::u32))) {
            f = f + 1;
            cnt;
        }
        val out: *vector.Vector[Function] = ?edges.data[f];
        var c:   usize                    = 0;
        for (c < out.len) {
            var k: usize = 0;
            for (k < n) {
                seen.data[k] = false;
                k            = k + 1;
            }
            work.len                      = 0;
            seen.data[out.data[c]::usize] = true;
            val res_first: res[usize, allocator.Error] = vector.push[Function](?work, out.data[c]);
            if (sel res_first.err) { ret res[opt[At], allocator.Error].err{res_first.err}; }
            for (work.len > 0) {
                val next: Function = work.data[work.len - 1];
                work.len = work.len - 1;
                if (next::usize == f) { ret res[opt[At], allocator.Error].ok{opt[At].some{call_of(r, (f::u32), out.data[c])}}; }
                val onward: *vector.Vector[Function] = ?edges.data[next];
                var j:      usize                    = 0;
                for (j < onward.len) {
                    if (!seen.data[onward.data[j]::usize]) {
                        seen.data[onward.data[j]::usize] = true;
                        val res_pushed: res[usize, allocator.Error] = vector.push[Function](?work, onward.data[j]);
                        if (sel res_pushed.err) { ret res[opt[At], allocator.Error].err{res_pushed.err}; }
                    }
                    j = j + 1;
                }
            }
            c = c + 1;
        }
        f = f + 1;
    }
    ret res[opt[At], allocator.Error].ok{opt[At].none{}};
}

# whether any entry point reaches function `f`
fun reached_by_any(r: *Reach, f: Function) bool {
    var e: usize = 0;
    for (e < r.entries.len) {
        if (reaches(r, e, f)) { ret true; }
        e = e + 1;
    }
    ret false;
}

# the first call function `f` makes of `callee`, or `f` as a whole where it
# only names it
fun call_of(r: *Reach, f: Function, callee: Function) At {
    val b: *Body = ?r.m.functions.data[f].body;
    var i: usize = 0;
    for (i < b.instructions.len) {
        val d: *InstructionData = ?b.instructions.data[i];
        if (d.opcode == table.CALL && d.operands.len > 0) {
            val opt_called: opt[Function] = function_named(r.m, b, d.operands.data[0]);
            if (sel opt_called.some) {
                if (opt_called.some == callee) { ret site(r.m, f, (i::u32)); }
            }
        }
        i = i + 1;
    }
    ret At{function: f, instruction: NOWHERE, location: opt[Location].none{}};
}

# the call graph of `m` and what each of its entry points reaches, where an
# entry point is a function `staged` says has a stage
pub fun init(a: *allocator.Allocator, m: *Module, staged: fun(*Module, Function) bool, ops: Ops) res[Reach, allocator.Error] {
    var r: Reach = Reach{
        a:      a, m: m, entries: vector.init[Function](a), reached: vector.init[bool](a), named: vector.init[bool](a), globals: vector.init[Done](a), bases: vector.init[u32](a),
        params: vector.init[Done](a), cycle: opt[At].none{}, ops: ops
    };
    var kept: bool = false;
    fin {
        if (!kept) { dnit(?r); }
    }
    val n:     usize                                  = m.functions.len;
    val g:     usize                                  = m.globals.len;
    var edges: vector.Vector[vector.Vector[Function]] = vector.init[vector.Vector[Function]](a);
    var calls: vector.Vector[Passing]                 = vector.init[Passing](a);
    fin {
        var j: usize = 0;
        for (j < edges.len) {
            vector.dnit[Function](?edges.data[j]);
            j = j + 1;
        }
        vector.dnit[vector.Vector[Function]](?edges);
        vector.dnit[Passing](?calls);
    }
    val err_named: err[allocator.Error] = filled[bool](?r.named, n * g, false);
    if (sel err_named.err) { ret res[Reach, allocator.Error].err{err_named.err}; }
    val err_globals: err[allocator.Error] = filled[Done](?r.globals, g, UNDONE);
    if (sel err_globals.err) { ret res[Reach, allocator.Error].err{err_globals.err}; }
    var count: u32   = 0;
    var f:     usize = 0;
    for (f < n) {
        val res_based: res[usize, allocator.Error] = vector.push[u32](?r.bases, count);
        if (sel res_based.err) { ret res[Reach, allocator.Error].err{res_based.err}; }
        val b: *Body = ?m.functions.data[f].body;
        if (b.blocks.len != 0) { count = count + b.blocks.data[0].parameters.len::u32; }
        f = f + 1;
    }
    val res_ended: res[usize, allocator.Error] = vector.push[u32](?r.bases, count);
    if (sel res_ended.err) { ret res[Reach, allocator.Error].err{res_ended.err}; }
    val err_params: err[allocator.Error] = filled[Done](?r.params, count::usize, UNDONE);
    if (sel err_params.err) { ret res[Reach, allocator.Error].err{err_params.err}; }
    f = 0;
    for (f < n) {
        val res_edged: res[usize, allocator.Error] = vector.push[vector.Vector[Function]](?edges, vector.init[Function](a));
        if (sel res_edged.err) { ret res[Reach, allocator.Error].err{res_edged.err}; }
        val err_graph: err[allocator.Error] = graph(?r, (f::u32), ?edges.data[f]);
        if (sel err_graph.err) { ret res[Reach, allocator.Error].err{err_graph.err}; }
        val b: *Body = ?m.functions.data[f].body;
        var i: usize = 0;
        for (i < b.instructions.len) {
            val err_direct: err[allocator.Error] = direct(?r, (f::u32), b, (i::u32), ?calls);
            if (sel err_direct.err) { ret res[Reach, allocator.Error].err{err_direct.err}; }
            i = i + 1;
        }
        if (staged(m, (f::u32))) {
            val res_entered: res[usize, allocator.Error] = vector.push[Function](?r.entries, (f::u32));
            if (sel res_entered.err) { ret res[Reach, allocator.Error].err{res_entered.err}; }
        }
        f = f + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        var c: usize = 0;
        for (c < calls.len) {
            val p:  Passing = calls.data[c];
            val k:  u32     = r.bases.data[p.callee] + p.param;
            val dn: *Done   = done_of(?r, p.caller, p.root);
            c = c + 1;
            if (k >= r.bases.data[p.callee + 1] || dn == nil) { cnt; }
            val from: Done = r.params.data[k];
            if (note(dn, from.stored, from.loaded, from.escaped)) { changed = true; }
        }
    }
    val err_reached: err[allocator.Error] = filled[bool](?r.reached, r.entries.len * n, false);
    if (sel err_reached.err) { ret res[Reach, allocator.Error].err{err_reached.err}; }
    var e: usize = 0;
    for (e < r.entries.len) {
        val err_tree: err[allocator.Error] = tree(?r, e, r.entries.data[e], ?edges);
        if (sel err_tree.err) { ret res[Reach, allocator.Error].err{err_tree.err}; }
        e = e + 1;
    }
    val res_cycle: res[opt[At], allocator.Error] = cycle(?r, ?edges);
    if (sel res_cycle.err) { ret res[Reach, allocator.Error].err{res_cycle.err}; }
    r.cycle = res_cycle.ok;
    kept    = true;
    ret res[Reach, allocator.Error].ok{r};
}

pub fun dnit(r: *Reach) {
    vector.dnit[Function](?r.entries);
    vector.dnit[bool](?r.reached);
    vector.dnit[bool](?r.named);
    vector.dnit[Done](?r.globals);
    vector.dnit[u32](?r.bases);
    vector.dnit[Done](?r.params);
}

# the position of function `f` among the entry points, none for a function
# with no stage
pub fun entry_of(r: *Reach, f: Function) opt[usize] {
    var e: usize = 0;
    for (e < r.entries.len) {
        if (r.entries.data[e] == f) { ret opt[usize].some{e}; }
        e = e + 1;
    }
    ret opt[usize].none{};
}

# whether entry point `e` reaches function `f`
pub fun reaches(r: *Reach, e: usize, f: Function) bool {
    ret r.reached.data[e * r.m.functions.len + f::usize];
}

# whether entry point `e` reaches global `g`: a function of its call tree
# names it
pub fun uses(r: *Reach, e: usize, g: Global) bool {
    val n: usize = r.m.functions.len;
    var f: usize = 0;
    for (f < n) {
        if (r.reached.data[e * n + f] && r.named.data[f * r.m.globals.len + g::usize]) { ret true; }
        f = f + 1;
    }
    ret false;
}

# what the module's functions do to global `g`
pub fun done(r: *Reach, g: Global) Done {
    ret r.globals.data[g];
}
