# spir-v for vulkan: logical pointers, with PhysicalStorageBuffer's an 8 byte
# address under the PhysicalStorageBuffer64 addressing model. every class
# lays a type out by the target's own rules, so a block holds a record as the
# host does, and a Uniform, PushConstant or StorageBuffer block whose layout
# breaks the rules vulkan holds its class to is refused, never laid out again
# (mirl.target.spirv.types block_rules)
val SPIRV_POINTERS: [11]Space = [11]Space{
    Space{space: 0, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 1, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 2, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 3, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 4, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 6, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 7, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 9, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 11, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 12, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 5349, pointer: Pointer.modelled{Slice[Modelled]{data: ?SPIRV_BUFFER_POINTERS[0], size: 1}}, layout: Rules.c{}},
};
val SPIRV_BUFFER_POINTERS: [1]Modelled = [1]Modelled{
    Modelled{model: ?spirv.SPIRV_PHYSICAL_STORAGE_BUFFER64, scalar: Scalar{size: 8, align: 8}},
};
val PHYSICAL_ATOMS:        [1]requirement.Id          = [1]requirement.Id{spirv_extension.PHYSICALSTORAGEBUFFERADDRESSES};
val PHYSICAL_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?PHYSICAL_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
# a build states PhysicalStorageBuffer64 where its selection holds the
# PhysicalStorageBufferAddresses capability the model requires, and logical
# otherwise
val SPIRV_MODELS: [2]AddressingModel = [2]AddressingModel{
    AddressingModel{model: ?spirv.SPIRV_PHYSICAL_STORAGE_BUFFER64, condition: Condition.requires{requirement.Requirement{at: ?PHYSICAL_ALTERNATIVES[0], len: 1}}},
    AddressingModel{model: ?spirv.SPIRV_LOGICAL, condition: Condition.always{}},
};
val SPIRV_ALU:      [2]u32                     = [2]u32{32, 64};
val SPIRV_INTEGERS: [4]u32                     = [4]u32{8, 16, 32, 64};
val SPIRV_COUNTS:   [3]u32                     = [3]u32{2, 3, 4};
val INT8_ATOMS:     [1]requirement.Id          = [1]requirement.Id{spirv_extension.INT8};
val INT8_ALTS:      [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?INT8_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
val INT16_ATOMS: [1]requirement.Id          = [1]requirement.Id{spirv_extension.INT16};
val INT16_ALTS:  [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?INT16_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
# an 8- or 16-bit integer is a value only where the build holds Int8 or Int16,
# and is carried in a 32-bit one elsewhere, which needs no capability
# (manifest.md, "finished-module targets")
val SPIRV_CARRIED: [2]Carried = [2]Carried{
    Carried{width: 8, condition: Condition.requires{requirement.Requirement{at: ?INT8_ALTS[0], len: 1}}},
    Carried{width: 16, condition: Condition.requires{requirement.Requirement{at: ?INT16_ALTS[0], len: 1}}},
};
# OpUMulExtended and OpSMulExtended give the whole product of two integers
val SPIRV_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 64},
};
# NMin, NMax, Floor, Ceil, Trunc, RoundEven, OpSelect and Fma, whose precision
# is the environment's. FMin and FMax are undefined for a nan, and OpFRem is
# held to the precision of x - y * trunc(x/y) under vulkan, so it is not the
# exact remainder
val SPIRV_NATIVES: [8]Native = [8]Native{
    Native{opcode: table.FMINNUM, condition: Condition.always{}},
    Native{opcode: table.FMAXNUM, condition: Condition.always{}},
    Native{opcode: table.FFLOOR, condition: Condition.always{}},
    Native{opcode: table.FCEIL, condition: Condition.always{}},
    Native{opcode: table.FINT, condition: Condition.always{}},
    Native{opcode: table.FNEAREST, condition: Condition.always{}},
    Native{opcode: table.SELECT, condition: Condition.always{}},
    Native{opcode: table.FMA, condition: Condition.always{}},
};
val FLOAT_CONTROLS_ATOMS: [1]requirement.Id          = [1]requirement.Id{spirv_extension.SIGNEDZEROINFNANPRESERVE};
val FLOAT_CONTROLS:       [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?FLOAT_CONTROLS_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.NO_IDS, none: requirement.Ids{at: ?FLOAT_CONTROLS_ATOMS[0], len: 1}},
};
# a build that holds the SignedZeroInfNanPreserve capability, which every
# entry point then states as its float controls mode
val HALF_ATOMS: [2]requirement.Id          = [2]requirement.Id{spirv_extension.FLOAT16, spirv_extension.SIGNEDZEROINFNANPRESERVE};
val HALF_ALTS:  [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?HALF_ATOMS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HALF_ATOMS[0], len: 1}, none: requirement.Ids{at: ?HALF_ATOMS[1], len: 1}},
};
# binary16 arithmetic is held only where the build holds the Float16
# capability, so a build without it holds no unit for binary16 and the half
# precision legalisation computes it in binary32
val HALF_PRESERVED:   Condition = Condition.requires{requirement.Requirement{at: ?HALF_ALTS[0], len: 1}};
val HALF_UNPRESERVED: Condition = Condition.requires{requirement.Requirement{at: ?HALF_ALTS[1], len: 1}};
val PRESERVED:        Condition = Condition.requires{requirement.Requirement{at: ?FLOAT_CONTROLS[0], len: 1}};
val UNPRESERVED:      Condition = Condition.requires{requirement.Requirement{at: ?FLOAT_CONTROLS[1], len: 1}};
# under SignedZeroInfNanPreserve a nan operand is kept, as the first one, and
# a nan an invalid operation gives is the positive quiet one. no order of a
# fused multiply-add's operands is fixed
val PRESERVING: Nans = Nans.propagate{Propagation{default: Default.positive{}, priority: Priority.first{}, fused: Fused.unordered{}}};
# a constant is an operand of the module. vulkan leaves a nan result
# unspecified unless an entry point states a float controls mode that keeps
# it (vulkan 1.3, "precision and operation of spir-v instructions"), so each
# format is held under two disjoint rows
val SPIRV_HELD: [6]Held = [6]Held{
    Held{format: ?BINARY16, condition: HALF_PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY16, condition: HALF_UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 8}}, constants: Constants.made{}},
};
# a build without the Float16 capability holds no row of binary16, so the half
# precision legalisation widens it exactly to binary32, or binary64 for a fused
# multiply-add, and narrows the result keeping a nan's sign and payload
# quieted, so binary16 returns their rule under the build's float controls.
# every build holds binary32 and binary64 under one of their two complementary
# rows, so no build calls a soft helper
val SPIRV_LOWERED: [3]Lowered = [3]Lowered{
    Lowered{format: ?BINARY16, widened: Narrowing.kept{}, helpers: Helpers.none{}, kept: Kept.encoding{}},
    Lowered{format: ?BINARY32, widened: Narrowing.kept{}, helpers: Helpers.none{}, kept: Kept.encoding{}},
    Lowered{format: ?BINARY64, widened: Narrowing.kept{}, helpers: Helpers.none{}, kept: Kept.encoding{}},
};
val SPIRV_LANES: [7]Lane = [7]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY16}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
val INT64_ATOMS:   [1]requirement.Id          = [1]requirement.Id{spirv_extension.INT64};
val FLOAT16_ATOMS: [1]requirement.Id          = [1]requirement.Id{spirv_extension.FLOAT16};
val FLOAT64_ATOMS: [1]requirement.Id          = [1]requirement.Id{spirv_extension.FLOAT64};
val PAIR_ATOMS:    [4]requirement.Id          = [4]requirement.Id{spirv_extension.INT64, spirv_extension.FLOAT16, spirv_extension.FLOAT64, spirv_extension.INT64};
val LANE_ALTS:     [6]requirement.Alternative = [6]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?INT64_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?FLOAT16_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?FLOAT64_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?PAIR_ATOMS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?PAIR_ATOMS[2], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?PAIR_ATOMS[1], len: 2}, none: requirement.NO_IDS},
};
val UNDER_INT64:           Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[0], len: 1}};
val UNDER_FLOAT16:         Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[1], len: 1}};
val UNDER_FLOAT64:         Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[2], len: 1}};
val UNDER_INT64_FLOAT16:   Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[3], len: 1}};
val UNDER_INT64_FLOAT64:   Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[4], len: 1}};
val UNDER_FLOAT16_FLOAT64: Condition = Condition.requires{requirement.Requirement{at: ?LANE_ALTS[5], len: 1}};
# the operations the core instructions compute on a vector, each at the lane
# types whose capability the build holds: a 64-bit integer lane under Int64,
# an f16 lane under Float16 and an f64 lane under Float64. an 8- or 16-bit
# integer lane needs none, as one the build holds no Int8 or Int16 for is
# carried at 32 bits (mirl.legal.narrow), and an f16 lane without Float16 is
# computed in binary32 lanes (mirl.legal.half). a vector of conditions is
# combined, compared and selected by the logical instructions. a float
# minimum, maximum, remainder and copysign have no exact instruction and are
# stood in for
val SPIRV_OPERATIONS: [305]Operation = [305]Operation{
    Operation{opcode: table.AND, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.NOT, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.EQ, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.NE, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SELECT, lane: LaneType.integer{1}, to: LaneType.integer{1}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.DIV_S, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_S, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_S, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_S, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.DIV_U, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_U, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_U, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.DIV_U, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.REM_S, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_S, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_S, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_S, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.REM_U, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_U, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_U, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.REM_U, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.SHL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHL, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.NEG, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.NEG, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.NEG, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.NEG, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
