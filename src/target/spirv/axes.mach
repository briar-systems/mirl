use mirl.target.capability.Shifts;
use mirl.target.capability.Sign;
use mirl.target.capability.Single;
use mirl.target.capability.SlotSpace;
use mirl.target.capability.Space;
use mirl.target.capability.Specialization;
use mirl.target.capability.Stored;
use mirl.target.capability.Tables;
use mirl.target.capability.Unit;
use mirl.target.capability.Values;
use mirl.target.capability.VectorRule;
use mirl.target.capability.Vectors;
use mirl.target.capability.Width;
use mirl.target.capability.Widths;
use mirl.target.spirv.schema;

# spir-v for vulkan: logical pointers, with PhysicalStorageBuffer's an 8 byte
# address under the PhysicalStorageBuffer64 addressing model. a Uniform block
# is laid out by extended alignment and PushConstant, StorageBuffer and
# PhysicalStorageBuffer by base alignment, as vulkan requires with no layout
# feature enabled. vulkan fixes no layout of the other storage
# classes, so they keep the target's own
val SPIRV_POINTERS: [11]Space = [11]Space{
    Space{space: 0, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 1, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 2, pointer: Pointer.logical{}, layout: Rules.std140{}},
    Space{space: 3, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 4, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 6, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 7, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 9, pointer: Pointer.logical{}, layout: Rules.std430{}},
    Space{space: 11, pointer: Pointer.logical{}, layout: Rules.c{}},
    Space{space: 12, pointer: Pointer.logical{}, layout: Rules.std430{}},
    Space{space: 5349, pointer: Pointer.modelled{Slice[Modelled]{data: ?SPIRV_BUFFER_POINTERS[0], size: 1}}, layout: Rules.std430{}},
};
val SPIRV_BUFFER_POINTERS: [1]Modelled = [1]Modelled{
    Modelled{model: ?spirv.SPIRV_PHYSICAL_STORAGE_BUFFER64, scalar: Scalar{size: 8, align: 8}},
};
val PHYSICAL_ATOMS:        [1]requirement.Id          = [1]requirement.Id{spirv_extension.PHYSICALSTORAGEBUFFERADDRESSES};
val PHYSICAL_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?PHYSICAL_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
# a build states PhysicalStorageBuffer64 where its selection holds the
# PhysicalStorageBufferAddresses capability the model requires, and logical
# otherwise
val SPIRV_MODELS: [2]AddressingModel = [2]AddressingModel{
    AddressingModel{model: ?spirv.SPIRV_PHYSICAL_STORAGE_BUFFER64, condition: Condition.requires{requirement.Requirement{at: ?PHYSICAL_ALTERNATIVES[0], len: 1}}},
    AddressingModel{model: ?spirv.SPIRV_LOGICAL, condition: Condition.always{}},
};
val SPIRV_ALU:      [2]u32 = [2]u32{32, 64};
val SPIRV_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
val SPIRV_COUNTS:   [3]u32 = [3]u32{2, 3, 4};
# OpUMulExtended and OpSMulExtended give the whole product of two integers
val SPIRV_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 64},
};
# NMin, NMax, Floor, Ceil, Trunc, RoundEven and OpSelect. FMin and FMax are
# undefined for a nan, and OpFRem is held to the precision of x - y * trunc(x/y)
# under vulkan, so it is not the exact remainder
val SPIRV_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};
val FLOAT_CONTROLS_ATOMS: [1]requirement.Id          = [1]requirement.Id{spirv_extension.SIGNEDZEROINFNANPRESERVE};
val FLOAT_CONTROLS:       [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?FLOAT_CONTROLS_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.NO_IDS, none: requirement.Ids{at: ?FLOAT_CONTROLS_ATOMS[0], len: 1}},
};
# a build that holds the SignedZeroInfNanPreserve capability, which every
# entry point then states as its float controls mode
val HALF_ATOMS: [2]requirement.Id          = [2]requirement.Id{spirv_extension.FLOAT16, spirv_extension.SIGNEDZEROINFNANPRESERVE};
val HALF_ALTS:  [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?HALF_ATOMS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HALF_ATOMS[0], len: 1}, none: requirement.Ids{at: ?HALF_ATOMS[1], len: 1}},
};
# binary16 arithmetic is held only where the build holds the Float16
# capability, so a build without it holds no unit for binary16 and the half
# precision legalisation computes it in binary32
val HALF_PRESERVED:   Condition = Condition.requires{requirement.Requirement{at: ?HALF_ALTS[0], len: 1}};
val HALF_UNPRESERVED: Condition = Condition.requires{requirement.Requirement{at: ?HALF_ALTS[1], len: 1}};
val PRESERVED:        Condition = Condition.requires{requirement.Requirement{at: ?FLOAT_CONTROLS[0], len: 1}};
val UNPRESERVED:      Condition = Condition.requires{requirement.Requirement{at: ?FLOAT_CONTROLS[1], len: 1}};
# under SignedZeroInfNanPreserve a nan operand is kept, as the first one, and
# a nan an invalid operation gives is the positive quiet one. no order of a
# fused multiply-add's operands is fixed
val PRESERVING: Nans = Nans.propagate{Propagation{default: Default.positive{}, priority: Priority.first{}, fused: Fused.unordered{}}};
# a constant is an operand of the module. vulkan leaves a nan result
# unspecified unless an entry point states a float controls mode that keeps
# it (vulkan 1.3, "precision and operation of spir-v instructions"), so each
# format is held under two disjoint rows
val SPIRV_HELD: [6]Held = [6]Held{
    Held{format: ?BINARY16, condition: HALF_PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY16, condition: HALF_UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: PRESERVED, nans: PRESERVING, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNPRESERVED, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
};
val SPIRV_LANES: [7]Lane = [7]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY16}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# vectors are values of two, three or four components, held in no register
val SPIRV_UNITS: [1]Unit = [1]Unit{
    Unit{requires: Condition.always{}, width: Width.none{}, counts: Counts.listed{Slice[u32]{data: ?SPIRV_COUNTS[0], size: 3}}, lanes: Slice[Lane]{data: ?SPIRV_LANES[0], size: 7}},
};
# i1 is one byte in memory, and wider integers are legalised to arrays of i64
val SPIRV_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 8}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 8}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 8}}},
};
val SPIRV_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

val VARIABLE_ATOMS:        [1]requirement.Id          = [1]requirement.Id{spirv_extension.VARIABLEPOINTERS};
val VARIABLE_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?VARIABLE_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
# a pointer is variable where the build holds VariablePointers, under which
# one may be merged, selected, returned or held in a variable of any class
val VARIABLE: Condition = Condition.requires{requirement.Requirement{at: ?VARIABLE_ALTERNATIVES[0], len: 1}};

# the extended instruction sets masc carries rows of, each an OpExtInst of
# the set's import: its result type, its result and the import come first,
# then the op's own operands
val SPIRV_OP_SETS: [3]OpSet = [3]OpSet{
    OpSet{name: "GLSL.std.450", prefix: "OpExtInst.GLSL.std.450.", supplied: 3},
    OpSet{name: "NonSemantic.Shader.DebugInfo.100", prefix: "OpExtInst.NonSemantic.Shader.DebugInfo.100.", supplied: 3},
    OpSet{name: "OpenCL.std", prefix: "OpExtInst.OpenCL.std.", supplied: 3},
};

val SPIRV_CATALOG: Catalog = Catalog{
    rows: mrow.Rows{at: ?gen_row.ROWS[0], len: gen_row.COUNT},
    keys: index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT},
    sets: Slice[OpSet]{data: ?SPIRV_OP_SETS[0], size: 3},
};

# spir-v, logical pointers with PhysicalStorageBuffer's under the build's
# addressing model
val SPIRV_CAPS: Capabilities = Capabilities{
    registers:      Registers.none{},
    control:        Control.structured{},
    tables:         Tables.none{},
    addressing:     Addressing.logical{Logical{variable: VARIABLE}},
    functions:      Functions.none{},
    specialization: Specialization.native{},
    values:         Values.typed{},
    evaluation:     Evaluation.register{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?SPIRV_POINTERS[0], size: 11},
        # the Function storage class
        slots:    SlotSpace.space{7},
        models:   Models.rows{Slice[AddressingModel]{data: ?SPIRV_MODELS[0], size: 2}},
        register: Bits.none{},
        alu:      Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
        integers: Set.widths{Slice[u32]{data: ?SPIRV_INTEGERS[0], size: 4}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?SPIRV_UNITS[0], size: 1}},
    formats:    Formats.held{Slice[Held]{data: ?SPIRV_HELD[0], size: 6}},
    arithmetic: Arithmetic{
        multiply:   Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
        multiplied: Condition.always{},
        products:   Products.forms{Slice[Product]{data: ?SPIRV_PRODUCTS[0], size: 4}},
        shifts:     Shifts.undefined{},
        single:     Single.none{},
        # a division by zero or an overflowing one gives an undefined value
        division: Division{widths: Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
    },
    # a sized copy needs the addresses capability vulkan does not have
    bulk: BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    code: Code{
        function: Align.none{},
        text:     Align.none{},
        data:     Align.none{},
        fill:     Fill.none{},
    },
    attributes: Attributes.schema{?schema.SCHEMA},
    ops:        Ops.catalog{?SPIRV_CATALOG},
};

# the data of a shader module
val SPIRV_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?SPIRV_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?SPIRV_FLOAT_LAYOUT[0], size: 3},
    # vulkan scalar block layout: a vector aligns to its component
    vectors: VectorRule.element{},
};

val MACHINES: [1]axis.Machine = [1]axis.Machine{axis.Machine{arch: ?spirv.SPIRV, caps: SPIRV_CAPS}};

# the one spir-v convention, the logical addressing shader model, whose
# functions are a module's own and whose entry points the module names. it
# carries no row: OpFunctionCall passes every value whole as the type
# OpFunction states, so no value is placed in pieces and the family runs no
# abi lowering
val MEMBERS: [1]axis.Member = [1]axis.Member{
    axis.Member{arch: ?spirv.SPIRV, name: "shader", row: opt[*Convention].none{}, data: SPIRV_DATA},
};

# the spir-v rows of every axis. no system carries an address model
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 1},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 1},
    models:   Slice[axis.Model]{data: nil, size: 0},
};
