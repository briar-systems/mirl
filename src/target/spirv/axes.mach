    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY16}, to: LaneType.integer{16}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY16}, to: LaneType.integer{16}, condition: UNDER_FLOAT16, expanded: false},
