    Operation{opcode: table.ITOF_U, lane: LaneType.integer{16}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY32}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY32}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{16}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{16}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY64}, to: LaneType.integer{16}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY64}, to: LaneType.integer{16}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{32}, to: LaneType.float{?BINARY16}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{32}, to: LaneType.float{?BINARY16}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY16}, to: LaneType.integer{32}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY16}, to: LaneType.integer{32}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{32}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{32}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY64}, to: LaneType.integer{32}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY64}, to: LaneType.integer{32}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{64}, to: LaneType.float{?BINARY16}, condition: UNDER_INT64_FLOAT16, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{64}, to: LaneType.float{?BINARY16}, condition: UNDER_INT64_FLOAT16, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY16}, to: LaneType.integer{64}, condition: UNDER_INT64_FLOAT16, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY16}, to: LaneType.integer{64}, condition: UNDER_INT64_FLOAT16, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{64}, to: LaneType.float{?BINARY32}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{64}, to: LaneType.float{?BINARY32}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY32}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY32}, to: LaneType.integer{64}, condition: UNDER_INT64, expanded: false},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{64}, to: LaneType.float{?BINARY64}, condition: UNDER_INT64_FLOAT64, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{64}, to: LaneType.float{?BINARY64}, condition: UNDER_INT64_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY64}, to: LaneType.integer{64}, condition: UNDER_INT64_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY64}, to: LaneType.integer{64}, condition: UNDER_INT64_FLOAT64, expanded: false},
    Operation{opcode: table.FPROMOTE, lane: LaneType.float{?BINARY16}, to: LaneType.float{?BINARY32}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.FPROMOTE, lane: LaneType.float{?BINARY16}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT16_FLOAT64, expanded: false},
    Operation{opcode: table.FDEMOTE, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY16}, condition: UNDER_FLOAT16, expanded: false},
    Operation{opcode: table.FPROMOTE, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FDEMOTE, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY16}, condition: UNDER_FLOAT16_FLOAT64, expanded: false},
    Operation{opcode: table.FDEMOTE, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY32}, condition: UNDER_FLOAT64, expanded: false},
};
# vectors are values of two, three or four components, held in no register.
# a vector of conditions is a vector of OpTypeBool, one condition per lane
val SPIRV_UNITS: [1]Unit = [1]Unit{
    Unit{requires: Condition.always{}, width: Width.none{}, counts: Counts.listed{Slice[u32]{data: ?SPIRV_COUNTS[0], size: 3}}, lanes: Slice[Lane]{data: ?SPIRV_LANES[0], size: 7}, operations: Operations.rows{Slice[Operation]{data: ?SPIRV_OPERATIONS[0], size: $length_of(SPIRV_OPERATIONS)}}, masks: Masks.held{1}, constants: Constants.made{}},
};
# i1 is one byte in memory, and wider integers are legalised to arrays of i64
val SPIRV_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 8}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 8}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 8}}},
};
val SPIRV_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

val VARIABLE_ATOMS:        [1]requirement.Id          = [1]requirement.Id{spirv_extension.VARIABLEPOINTERS};
val VARIABLE_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?VARIABLE_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
# a pointer is variable where the build holds VariablePointers, under which
# one may be merged, selected, returned or held in a variable of any class
val VARIABLE: Condition = Condition.requires{requirement.Requirement{at: ?VARIABLE_ALTERNATIVES[0], len: 1}};

# the instruction sets masc carries rows of. an extended one is an OpExtInst
# of the set's import: its result type, its result and the import come
# first, then the op's own operands. core is the instructions themselves,
# whose memory masc states for every row, so a row with no access touches none
val SPIRV_OP_SETS: [4]OpSet = [4]OpSet{
    OpSet{name: "GLSL.std.450", prefix: "OpExtInst.GLSL.std.450.", form: OpForm.extended{3}},
    OpSet{name: "NonSemantic.Shader.DebugInfo.100", prefix: "OpExtInst.NonSemantic.Shader.DebugInfo.100.", form: OpForm.extended{3}},
    OpSet{name: "OpenCL.std", prefix: "OpExtInst.OpenCL.std.", form: OpForm.extended{3}},
    OpSet{name: "core", prefix: "", form: OpForm.own{Own{
        known:   Slice[Known]{data: ?spirv_ops.KNOWN[0], size: spirv_ops.KNOWN_COUNT},
        handles: Slice[Handled]{data: ?spirv_ops.HANDLES[0], size: spirv_ops.HANDLES_COUNT},
        memory:  OpMemory.rows{},
    }}},
};

val SPIRV_CATALOG: Catalog = Catalog{
    rows: mrow.Rows{at: ?gen_row.ROWS[0], len: gen_row.COUNT},
    keys: index.Index{at: ?gen_row.KEYS[0], len: gen_row.COUNT},
    sets: Slice[OpSet]{data: ?SPIRV_OP_SETS[0], size: 4},
};

# spir-v, logical pointers with PhysicalStorageBuffer's under the build's
# addressing model
val SPIRV_CAPS: Capabilities = Capabilities{
    registers:      Registers.none{},
    control:        Control.structured{},
    tables:         Tables.none{},
    addressing:     Addressing.logical{Logical{variable: VARIABLE}},
    functions:      Functions.none{},
    specialization: Specialization.native{},
    values:         Values.typed{},
    evaluation:     Evaluation.register{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?SPIRV_POINTERS[0], size: 11},
        # the Function storage class
        slots:    SlotSpace.space{7},
        models:   Models.rows{Slice[AddressingModel]{data: ?SPIRV_MODELS[0], size: 2}},
        register: Bits.none{},
        alu:      Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
        integers: Set.widths{Slice[u32]{data: ?SPIRV_INTEGERS[0], size: 4}},
        carried:  Carriers.rows{Slice[Carried]{data: ?SPIRV_CARRIED[0], size: 2}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?SPIRV_UNITS[0], size: 1}},
    formats:    Formats.held{Slice[Held]{data: ?SPIRV_HELD[0], size: 6}},
    lowered:    Lowerings.rows{Slice[Lowered]{data: ?SPIRV_LOWERED[0], size: 3}},
    arithmetic: Arithmetic{
        multiply:   Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
        multiplied: Condition.always{},
        products:   Products.forms{Slice[Product]{data: ?SPIRV_PRODUCTS[0], size: 4}},
        shifts:     Shifts.undefined{},
        single:     Single.none{},
        # a division by zero or an overflowing one gives an undefined value
        division: Division{widths: Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
    },
    # a copy of a constant length is a load and a store of the whole object it
    # moves, and a fill of zero a store of the object's null
    # (mirl.target.spirv.access copy, fill)
    bulk:    BulkMemory{copy: Copy.whole{}, fill: Bulk.native{}, moves: 8},
    atomics: Atomics{paired: Paired.none{}},
    code:    Code{
        function: Align.none{},
        text:     Align.none{},
        fill:     Fill.none{},
    },
    # a function is an instruction of the module with no section or address
    placed:     Placed{section: Honours.none{}, alignment: Honours.none{}},
    attributes: Attributes.schema{?schema.SCHEMA},
    ops:        Ops.catalog{?SPIRV_CATALOG},
    handles:    Handles.kinds{Slice[Minted]{data: ?spirv_handles.KINDS[0], size: spirv_handles.COUNT}},
    assembly:   capability.Assembly.none{},
};

# the data of a shader module
val SPIRV_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?SPIRV_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?SPIRV_FLOAT_LAYOUT[0], size: 3},
    # vulkan scalar block layout: a vector aligns to its component
    vectors: VectorRule.element{},
};

val MACHINES: [1]axis.Machine = [1]axis.Machine{axis.Machine{arch: ?spirv.SPIRV, caps: SPIRV_CAPS}};

# the one spir-v convention, the logical addressing shader model, whose
# functions are a module's own and whose entry points the module names. it
# carries no row: OpFunctionCall passes every value whole as the type
# OpFunction states, so no value is placed in pieces and the family runs no
# abi lowering
val MEMBERS: [1]axis.Member = [1]axis.Member{
    axis.Member{abi: ?spirv.SPIRV_SHADER, row: opt[*Convention].none{}, data: SPIRV_DATA},
};

# opencl's convention, which takes a module of physical addressing under the
# OpenCL memory model, whose pointers are values in memory
val DECLINED: [1]axis.Declined = [1]axis.Declined{
    axis.Declined{abi: ?spirv.SPIRV_KERNEL, why: "the SPIR-V kernel convention is not available. the family writes modules of logical addressing under the GLSL450 memory model, and a kernel needs physical addressing under the OpenCL memory model"},
};

# the spir-v rows of every axis. no system carries an address model
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 1},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 1},
    declined: Slice[axis.Declined]{data: ?DECLINED[0], size: 1},
    models:   Slice[axis.Model]{data: nil, size: 0},
};
