    Operation{opcode: table.ITOF_U, lane: LaneType.integer{8}, to: LaneType.float{?BINARY64}, condition: UNDER_FLOAT64, expanded: false},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY64}, to: LaneType.integer{8}, condition: UNDER_FLOAT64, expanded: false},
