# no id, as unit.NONE
val NO_ID: u32 = 0;

# the function control of every function, none
val NO_CONTROL: u32 = 0;

fun ok(e: *Emitter) bool {
    ret emitter.ok(e);
}

fun push_u32(e: *Emitter, v: *vector.Vector[u32], x: u32) {
    val res_pushed: res[usize, allocator.Error] = vector.push[u32](v, x);
    if (sel res_pushed.err) { emitter.lost(e, res_pushed.err); }
}

fun terminator_id(e: *Emitter, k: u32) Instruction {
    ret e.b.blocks.data[k].last;
}

fun terminator(e: *Emitter, k: u32) *InstructionData {
    ret ?e.b.instructions.data[terminator_id(e, k)];
}

fun block_of(d: *InstructionData) u32 {
    val p: Spot = d.place;
    if (sel p.placed) { ret p.placed; }
    ret NONE;
}

# whether instruction `a` stands ahead of instruction `b` in block `k`, by
# their places in it: an instruction a pass adds ahead of another is made
# after it, so an id says nothing of order
fun ahead(e: *Emitter, k: u32, a: Instruction, b: Instruction) bool {
    var j: Instruction = e.b.blocks.data[k].first;
    for (j != NO_INSTRUCTION) {
        if (j == b) { ret false; }
        if (j == a) { ret true; }
        j = e.b.instructions.data[j].next;
    }
    ret false;
}

# the label an edge out of a block branches to: its target's, but the
# continue target of a header that is its own latch for its back edge
fun target(e: *Emitter, from: u32, edge: *Edge) u32 {
    val k: u32 = edge.block;
    if (k == from && e.cts.data[k] != NO_ID) { ret e.cts.data[k]; }
    ret e.labels.data[k];
}

# the label an edge out of a block leaves from, as a phi names it
fun parent(e: *Emitter, from: u32, to: u32) u32 {
    if (from == to && e.cts.data[to] != NO_ID) { ret e.cts.data[to]; }
    ret e.bodies.data[from];
}

# a label
fun label(e: *Emitter, id: u32) {
    var s: [1]Slot = [1]Slot{Slot.id{id}};
    emitter.put(e, gen_row_index.OPLABEL, ?s[0], 1);
    e.line = 0xFFFF_FFFF;
}

fun branch_to(e: *Emitter, id: u32) {
    var s: [1]Slot = [1]Slot{Slot.id{id}};
    emitter.put(e, gen_row_index.OPBRANCH, ?s[0], 1);
}

# a block never reached, the merge of a construct control never leaves
fun unreached(e: *Emitter, id: u32) {
    label(e, id);
    var s: [1]Slot = [1]Slot{Slot.none{}};
    emitter.put(e, gen_row_index.OPUNREACHABLE, ?s[0], 0);
}

# the phis of a block's parameters, one entry per edge into it from a block
# the tree reaches
fun phis(e: *Emitter, k: u32) {
    val params: *vector.Vector[Value] = ?e.b.blocks.data[k].parameters;
    if (params.len == 0) { ret; }
    var seen: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin { vector.dnit[u32](?seen); }
    var j: usize = 0;
    for (j < params.len && ok(e)) {
        val p: Value = params.data[j];
        if (spirv_types.pointer(e.u, emitter.value_type(e, p))) {
            emitter.fail(e, Error.variable{emitter.at(e, emitter.NOWHERE)});
            ret;
        }
        var pairs: vector.Vector[Slot] = vector.init[Slot](e.u.a);
        fin { vector.dnit[Slot](?pairs); }
        seen.len = 0;
        val preds: *vector.Vector[Instruction] = ?e.b.blocks.data[k].predecessors;
        var n:     usize                       = 0;
        for (n < preds.len && ok(e)) {
            val pi:         Instruction      = preds.data[n];
            val d:          *InstructionData = ?e.b.instructions.data[pi];
            val from:       u32              = block_of(d);
            var fresh_pred: bool             = from != NONE && e.reached.data[from];
            var s:          usize            = 0;
            for (s < seen.len) {
                if (seen.data[s] == pi) { fresh_pred = false; }
                s = s + 1;
            }
            if (fresh_pred) {
                push_u32(e, ?seen, pi);
                var edges: u32   = 0;
                var x:     usize = 0;
                for (x < d.edges.len) {
                    val edge: *Edge = ?d.edges.data[x];
                    if (edge.block == k) {
                        edges = edges + 1;
                        var pair:       [2]Slot                     = [2]Slot{Slot.id{emitter.id_of(e, edge.arguments.data[j])}, Slot.id{parent(e, from, k)}};
                        val group:      Slot                        = Slot.group{unit.slots(e.u, ?pair[0], 2)};
                        val res_pushed: res[usize, allocator.Error] = vector.push[Slot](?pairs, group);
                        if (sel res_pushed.err) {
                            emitter.lost(e, res_pushed.err);
                            ret;
                        }
                    }
                    x = x + 1;
                }
                if (edges > 1) {
                    emitter.unstructured(e);
                    ret;
                }
            }
            n = n + 1;
        }
        var slots: [3]Slot = [3]Slot{Slot.id{emitter.type_id(e, p)}, Slot.id{e.ids.data[p]}, Slot.list{unit.slots(e.u, pairs.data, pairs.len)}};
        emitter.put(e, gen_row_index.OPPHI, ?slots[0], 3);
        j = j + 1;
    }
}

# the start of a block's code: its label and phis, or a loop header's own
# label where its phis already stand, then the stack slots of the entry
fun start(e: *Emitter, k: u32) {
    if (e.bodies.data[k] != e.labels.data[k]) {
        label(e, e.bodies.data[k]);
    }
    or {
        label(e, e.labels.data[k]);
        if (k != 0) { phis(e, k); }
    }
    if (k == 0) { slots(e); }
    debug.scope(e);
}

# a variable of the target's slot class for every stack slot, which spir-v
# wants first in the entry block
fun slots(e: *Emitter) {
    var k: usize = 0;
    for (k < e.b.instructions.len && ok(e)) {
        val d:      *InstructionData = ?e.b.instructions.data[k];
        val placed: Spot             = d.place;
        if (d.opcode == table.ALLOCA && sel placed.placed) {
            val i:             Instruction = (k::u32);
            var opt_slot_type: opt[Type]   = opt[Type].none{};
            var opt_pointer:   opt[Type]   = opt[Type].none{};
            if (d.immediates.len > 1) {
                val a: Immediate = d.immediates.data[0];
                val b: Immediate = d.immediates.data[1];
                if (sel a.ty) { opt_slot_type = opt[Type].some{a.ty}; }
                if (sel b.ty) { opt_pointer = opt[Type].some{b.ty}; }
            }
            if (sel opt_slot_type.none) {
                emitter.unselected(e, i);
                ret;
            }
            if (sel opt_pointer.none) {
                emitter.unselected(e, i);
                ret;
            }
            val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, opt_pointer.some);
            var space:     u32                                     = 0xFFFF_FFFF;
            if (sel res_shape.ok) {
                val s: type_table.Shape = res_shape.ok;
                if (sel s.pointer) { space = s.pointer.space; }
            }
            val res_stated: res[u32, record.Error] = record.slot_space(e.u.t);
            var fits:       bool                   = false;
            if (sel res_stated.ok) { fits = space == res_stated.ok; }
            if (!fits) {
                emitter.fail(e, Error.slot{emitter.at(e, i)});
                ret;
            }
            val r: Value   = d.results.data[0];
            val p: Pointer = Pointer{id: e.ids.data[r], pointee: opt_slot_type.some, key: spirv_types.PLAIN, class: space, known: true, declared: true, scope: opt[u32].none{}};
            e.pointers.data[r] = p;
            var s: [4]Slot = [4]Slot{Slot.id{access.pointer_type(e, p)}, Slot.id{p.id}, unit.enumerant(space), Slot.none{}};
            emitter.put(e, gen_row_index.OPVARIABLE, ?s[0], 4);
        }
        k = k + 1;
    }
}

# the instructions of a block before its terminator
fun body(e: *Emitter, k: u32) {
    val last: Instruction = e.b.blocks.data[k].last;
    if (last == NO_INSTRUCTION) {
        emitter.unstructured(e);
        ret;
    }
    var i: Instruction = e.b.blocks.data[k].first;
    for (i != last && ok(e)) {
        debug.line(e, ?e.b.instructions.data[i]);
        e.u.buf.site = opt[At].some{emitter.at(e, i)};
        instruction(e, i, ?e.b.instructions.data[i]);
        e.u.buf.site = opt[At].none{};
        i            = e.b.instructions.data[i].next;
    }
    if (ok(e) && !op_ended(e, k)) { debug.line(e, terminator(e, k)); }
}

# whether block `k` ends at the target op before its unreachable, a row nothing falls through after, as OpKill,
# which spir-v takes as the block's terminator, so the unreachable stands for no instruction of its own
fun op_ended(e: *Emitter, k: u32) bool {
    val last: Instruction = e.b.blocks.data[k].last;
    if (last == NO_INSTRUCTION || e.b.instructions.data[last].prev == NO_INSTRUCTION || terminator(e, k).opcode != table.UNREACHABLE) { ret false; }
    val d: *InstructionData = ?e.b.instructions.data[e.b.instructions.data[last].prev];
    if (!table.target_op(d.opcode) || d.immediates.len == 0) { ret false; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.op)) { ret false; }
    val held: Ops = e.u.t.caps.ops;
    if (!(sel held.catalog)) { ret false; }
    val opt_set: opt[*OpSet] = op_set(held.catalog, imm.op.set);
    if (sel opt_set.none) { ret false; }
    val opt_found: opt[*mrow.Row] = op_row(held.catalog, opt_set.some, imm.op.name);
    if (sel opt_found.none) { ret false; }
    ret !me.falls(?opt_found.some.effect.control);
}

# the first block a region's code runs
fun first(e: *Emitter, r: u32) u32 {
    if (r == NONE) { ret NONE; }
    val g: Region      = region.region(e.s, r);
    val k: region.Kind = g.kind;
    if (sel k.sequence) { ret first(e, g.child); }
    ret g.block;
}

fun sequence(e: *Emitter, r: u32) {
    var c: u32 = region.region(e.s, r).child;
    for (c != NONE && ok(e)) {
        emit(e, c);
        c = region.region(e.s, c).next;
    }
}

fun emit(e: *Emitter, r: u32) {
    val g: Region      = region.region(e.s, r);
    val k: region.Kind = g.kind;
    if (sel k.sequence)  { sequence(e, r); }
    or (sel k.selection) { selection(e, r); }
    or (sel k.loop)      { looped(e, r); }
    or {
        start(e, g.block);
        body(e, g.block);
        if (ok(e)) { ending(e, g.block); }
    }
}

# a block's terminator that selects nothing: a branch, a return or a trap
fun ending(e: *Emitter, k: u32) {
    val i: Instruction      = terminator_id(e, k);
    val d: *InstructionData = terminator(e, k);
    val c: u32              = d.opcode;
    if (c == table.BR) {
        branch_to(e, target(e, k, ?d.edges.data[0]));
        ret;
    }
    if (c == table.RET || c == table.RET_PLACED) {
        returned(e, d);
        ret;
    }
    if (c == table.UNREACHABLE) {
        if (op_ended(e, k)) { ret; }
        var s: [1]Slot = [1]Slot{Slot.none{}};
        emitter.put(e, gen_row_index.OPUNREACHABLE, ?s[0], 0);
        ret;
    }
    emitter.unstructured(e);
}

fun returned(e: *Emitter, d: *InstructionData) {
    val sig: *Signature = unit.signature(e.u, e.f);
    if (d.operands.len == 0) {
        var s: [1]Slot = [1]Slot{Slot.none{}};
        emitter.put(e, gen_row_index.OPRETURN, ?s[0], 0);
        ret;
    }
    var value: u32 = NO_ID;
    if (d.operands.len == 1) { value = emitter.id_of(e, d.operands.data[0]); }
    or {
        var members: vector.Vector[u32] = vector.init[u32](e.u.a);
        fin { vector.dnit[u32](?members); }
        var j: usize = 0;
        for (j < d.operands.len) {
            push_u32(e, ?members, emitter.id_of(e, d.operands.data[j]));
            j = j + 1;
        }
        value = emitter.fresh(e);
        emitter.construct(e, sig.result, value, members.data, members.len);
    }
    var s: [1]Slot = [1]Slot{Slot.id{value}};
    emitter.put(e, gen_row_index.OPRETURNVALUE, ?s[0], 1);
}

# whether an edge breaks out of the innermost loop or continues it
fun exits(e: *Emitter, edge: *Edge) bool {
    if (e.loops.len == 0) { ret false; }
    val f: Frame = e.loops.data[e.loops.len - 1];
    val k: u32   = edge.block;
    ret k == f.header || (f.merge != NONE && k == f.merge) || (f.latch != NONE && k == f.latch);
}

# the arm of a selection, its code when the tree gives it any
fun arm(e: *Emitter, r: u32, edge: *Edge) {
    if (r == NONE || region.region(e.s, r).child == NONE) { ret; }
    if (first(e, r) != edge.block) {
        emitter.unstructured(e);
        ret;
    }
    sequence(e, r);
}

# the label a construct merges at: its merge block's, or a fresh one for a
# construct control never leaves, given back for the block the caller
# supplies after it
fun merge_label(e: *Emitter, merge: u32, supplied: *u32) u32 {
    if (merge != NONE) { ret e.labels.data[merge]; }
    @supplied = emitter.fresh(e);
    ret @supplied;
}

fun selection_merge(e: *Emitter, merge: u32) {
    var s: [2]Slot = [2]Slot{Slot.id{merge}, unit.enumerant(0)};
    emitter.put(e, gen_row_index.OPSELECTIONMERGE, ?s[0], 2);
}

fun selection(e: *Emitter, r: u32) {
    val g: Region = region.region(e.s, r);
    start(e, g.block);
    body(e, g.block);
    if (!ok(e)) { ret; }
    val d:    *InstructionData   = terminator(e, g.block);
    val c:    u32                = d.opcode;
    var arms: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin { vector.dnit[u32](?arms); }
    var child: u32 = g.child;
    for (child != NONE) {
        push_u32(e, ?arms, child);
        child = region.region(e.s, child).next;
    }
    if (arms.len != d.edges.len) {
        emitter.unstructured(e);
        ret;
    }
    var supplied: u32 = NO_ID;
    if (c == table.CBR) {
        val a: *Edge = ?d.edges.data[0];
        val b: *Edge = ?d.edges.data[1];
        if (!(exits(e, a) && exits(e, b))) { selection_merge(e, merge_label(e, g.merge, ?supplied)); }
        var s: [4]Slot = [4]Slot{Slot.id{emitter.id_of(e, d.operands.data[0])}, Slot.id{target(e, g.block, a)}, Slot.id{target(e, g.block, b)}, Slot.list{buffer.EMPTY}};
        emitter.put(e, gen_row_index.OPBRANCHCONDITIONAL, ?s[0], 4);
    }
    or (c == table.BR) {
        selection_merge(e, merge_label(e, g.merge, ?supplied));
        var s: [3]Slot = [3]Slot{Slot.id{spirv_types.uint(e.u, 32, 0)}, Slot.id{target(e, g.block, ?d.edges.data[0])}, Slot.list{buffer.EMPTY}};
        emitter.put(e, gen_row_index.OPSWITCH, ?s[0], 3);
    }
    or (c == table.SWITCH) {
        switched(e, g, d, ?supplied);
    }
    or {
        emitter.unstructured(e);
        ret;
    }
    var k: usize = 0;
    for (k < arms.len && ok(e)) {
        arm(e, arms.data[k], ?d.edges.data[k]);
        k = k + 1;
    }
    if (supplied != NO_ID && ok(e)) { unreached(e, supplied); }
}

# a switch: its default the first edge, then one literal of the selector's
# width per case
fun switched(e: *Emitter, g: Region, d: *InstructionData, supplied: *u32) {
    val i: Instruction = terminator_id(e, g.block);
    if (d.immediates.len == 0) {
        emitter.unselected(e, i);
        ret;
    }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.cases)) {
        emitter.unselected(e, i);
        ret;
    }
    val cases: Slice[u64] = imm.cases;
    if (cases.size + 1 != d.edges.len) {
        emitter.unselected(e, i);
        ret;
    }
    val selector: Value = d.operands.data[0];
    val width:    u32   = spirv_types.bits_of(e.u, emitter.value_type(e, selector));
    if (width == 1 || width > 64) {
        emitter.unselected(e, i);
        ret;
    }
    selection_merge(e, merge_label(e, g.merge, supplied));
    var groups: vector.Vector[Slot] = vector.init[Slot](e.u.a);
    fin { vector.dnit[Slot](?groups); }
    var k: usize = 0;
    for (k < cases.size) {
        var pair:       [2]Slot                     = [2]Slot{Slot.literal{unit.words(e.u, cases.data[k], (width + 31) / 32)}, Slot.id{target(e, g.block, ?d.edges.data[k + 1])}};
        val res_pushed: res[usize, allocator.Error] = vector.push[Slot](?groups, Slot.group{unit.slots(e.u, ?pair[0], 2)});
        if (sel res_pushed.err) {
            emitter.lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
    var s: [3]Slot = [3]Slot{Slot.id{emitter.id_of(e, selector)}, Slot.id{target(e, g.block, ?d.edges.data[0])}, Slot.list{unit.slots(e.u, groups.data, groups.len)}};
    emitter.put(e, gen_row_index.OPSWITCH, ?s[0], 3);
}

# a loop: its header's phis and loop merge in a block of their own, its
# body from the header's code, its continue sequence, and the continue
# target of a header that is its own latch
fun looped(e: *Emitter, r: u32) {
    val g:     Region = region.region(e.s, r);
    val inner: u32    = g.child;
    if (inner == NONE) {
        emitter.unstructured(e);
        ret;
    }
    val rest: u32 = region.region(e.s, inner).next;
    val h:    u32 = g.block;
    label(e, e.labels.data[h]);
    phis(e, h);
    var supplied: u32 = NO_ID;
    val merge:    u32 = merge_label(e, g.merge, ?supplied);
    var latch:    u32 = NONE;
    var cont:     u32 = e.cts.data[h];
    if (cont == NO_ID) {
        latch = g.latch;
        cont  = e.labels.data[latch];
    }
    var s: [3]Slot = [3]Slot{Slot.id{merge}, Slot.id{cont}, unit.enumerant(0)};
    emitter.put(e, gen_row_index.OPLOOPMERGE, ?s[0], 3);
    branch_to(e, e.bodies.data[h]);
    val res_pushed: res[usize, allocator.Error] = vector.push[Frame](?e.loops, Frame{header: h, merge: g.merge, latch: latch});
    if (sel res_pushed.err) {
        emitter.lost(e, res_pushed.err);
        ret;
    }
    sequence(e, inner);
    if (rest != NONE && ok(e)) { sequence(e, rest); }
    if (e.cts.data[h] != NO_ID && ok(e)) {
        label(e, e.cts.data[h]);
        branch_to(e, e.labels.data[h]);
    }
    e.loops.len = e.loops.len - 1;
    if (supplied != NO_ID && ok(e)) { unreached(e, supplied); }
}

# the rows of the instructions of two operands of one type
fun integer_row(code: u32) u32 {
    if (code == table.ADD)   { ret gen_row_index.OPIADD; }
    if (code == table.SUB)   { ret gen_row_index.OPISUB; }
    if (code == table.MUL)   { ret gen_row_index.OPIMUL; }
    if (code == table.DIV_S) { ret gen_row_index.OPSDIV; }
    if (code == table.DIV_U) { ret gen_row_index.OPUDIV; }
    if (code == table.REM_S) { ret gen_row_index.OPSREM; }
    if (code == table.REM_U) { ret gen_row_index.OPUMOD; }
    if (code == table.AND)   { ret gen_row_index.OPBITWISEAND; }
    if (code == table.OR)    { ret gen_row_index.OPBITWISEOR; }
    if (code == table.XOR)   { ret gen_row_index.OPBITWISEXOR; }
    if (code == table.SHL)   { ret gen_row_index.OPSHIFTLEFTLOGICAL; }
    if (code == table.SHR_U) { ret gen_row_index.OPSHIFTRIGHTLOGICAL; }
    if (code == table.SHR_S) { ret gen_row_index.OPSHIFTRIGHTARITHMETIC; }
    if (code == table.EQ)    { ret gen_row_index.OPIEQUAL; }
    if (code == table.NE)    { ret gen_row_index.OPINOTEQUAL; }
    if (code == table.LT_S)  { ret gen_row_index.OPSLESSTHAN; }
    if (code == table.LE_S)  { ret gen_row_index.OPSLESSTHANEQUAL; }
    if (code == table.GT_S)  { ret gen_row_index.OPSGREATERTHAN; }
    if (code == table.GE_S)  { ret gen_row_index.OPSGREATERTHANEQUAL; }
    if (code == table.LT_U)  { ret gen_row_index.OPULESSTHAN; }
    if (code == table.LE_U)  { ret gen_row_index.OPULESSTHANEQUAL; }
    if (code == table.GT_U)  { ret gen_row_index.OPUGREATERTHAN; }
    if (code == table.GE_U)  { ret gen_row_index.OPUGREATERTHANEQUAL; }
    ret emitter.NO_ROW;
}

# the rows of the same operations on bools
fun bool_row(code: u32) u32 {
    if (code == table.ADD || code == table.SUB || code == table.XOR || code == table.NE) { ret gen_row_index.OPLOGICALNOTEQUAL; }
    if (code == table.AND || code == table.MUL)                                          { ret gen_row_index.OPLOGICALAND; }
    if (code == table.OR)                                                                { ret gen_row_index.OPLOGICALOR; }
    if (code == table.EQ)                                                                { ret gen_row_index.OPLOGICALEQUAL; }
    ret emitter.NO_ROW;
}

fun float_row(code: u32) u32 {
    if (code == table.FADD)  { ret gen_row_index.OPFADD; }
    if (code == table.FSUB)  { ret gen_row_index.OPFSUB; }
    if (code == table.FMUL)  { ret gen_row_index.OPFMUL; }
    if (code == table.FDIV)  { ret gen_row_index.OPFDIV; }
    if (code == table.FREM)  { ret gen_row_index.OPFREM; }
    if (code == table.FEQ_O) { ret gen_row_index.OPFORDEQUAL; }
    if (code == table.FNE_O) { ret gen_row_index.OPFORDNOTEQUAL; }
    if (code == table.FLT_O) { ret gen_row_index.OPFORDLESSTHAN; }
    if (code == table.FLE_O) { ret gen_row_index.OPFORDLESSTHANEQUAL; }
    if (code == table.FGT_O) { ret gen_row_index.OPFORDGREATERTHAN; }
    if (code == table.FGE_O) { ret gen_row_index.OPFORDGREATERTHANEQUAL; }
    if (code == table.FEQ_U) { ret gen_row_index.OPFUNORDEQUAL; }
    if (code == table.FNE_U) { ret gen_row_index.OPFUNORDNOTEQUAL; }
    if (code == table.FLT_U) { ret gen_row_index.OPFUNORDLESSTHAN; }
    if (code == table.FLE_U) { ret gen_row_index.OPFUNORDLESSTHANEQUAL; }
    if (code == table.FGT_U) { ret gen_row_index.OPFUNORDGREATERTHAN; }
    if (code == table.FGE_U) { ret gen_row_index.OPFUNORDGREATERTHANEQUAL; }
    ret emitter.NO_ROW;
}

# the GLSL.std.450 rows of one float operand
fun glsl_unary(code: u32) u32 {
    if (code == table.FABS)     { ret gen_row_index.OPEXTINST_GLSL_STD_450_FABS; }
    if (code == table.FSQRT)    { ret gen_row_index.OPEXTINST_GLSL_STD_450_SQRT; }
    if (code == table.FFLOOR)   { ret gen_row_index.OPEXTINST_GLSL_STD_450_FLOOR; }
    if (code == table.FCEIL)    { ret gen_row_index.OPEXTINST_GLSL_STD_450_CEIL; }
    if (code == table.FINT)     { ret gen_row_index.OPEXTINST_GLSL_STD_450_TRUNC; }
    if (code == table.FNEAREST) { ret gen_row_index.OPEXTINST_GLSL_STD_450_ROUNDEVEN; }
    ret emitter.NO_ROW;
}

# how the lanes of a reduction combine
# ---
# row:  the row of two operands
# glsl: the row is of the GLSL.std.450 set
rec Combine {
    row:  u32;
    glsl: bool;
}

fun combine(code: u32, boolean: bool) Combine {
    var c: Combine = Combine{row: emitter.NO_ROW, glsl: false};
    if (code == table.REDUCE_ADD) {
        if (boolean) { c.row = gen_row_index.OPLOGICALNOTEQUAL; }
        or           { c.row = gen_row_index.OPIADD; }
    }
    or (code == table.REDUCE_MUL) {
        if (boolean) { c.row = gen_row_index.OPLOGICALAND; }
        or           { c.row = gen_row_index.OPIMUL; }
    }
    or (code == table.REDUCE_AND) {
        if (boolean) { c.row = gen_row_index.OPLOGICALAND; }
        or           { c.row = gen_row_index.OPBITWISEAND; }
    }
    or (code == table.REDUCE_OR) {
        if (boolean) { c.row = gen_row_index.OPLOGICALOR; }
        or           { c.row = gen_row_index.OPBITWISEOR; }
    }
    or (code == table.REDUCE_XOR) {
        if (boolean) { c.row = gen_row_index.OPLOGICALNOTEQUAL; }
        or           { c.row = gen_row_index.OPBITWISEXOR; }
    }
    or (boolean)                                                        { ret c; }
    or (code == table.REDUCE_SMIN)                                      { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_SMIN, glsl: true}; }
    or (code == table.REDUCE_SMAX)                                      { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_SMAX, glsl: true}; }
    or (code == table.REDUCE_UMIN)                                      { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_UMIN, glsl: true}; }
    or (code == table.REDUCE_UMAX)                                      { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_UMAX, glsl: true}; }
    or (code == table.REDUCE_FADD_SEQ || code == table.REDUCE_FADD_ANY) { c.row = gen_row_index.OPFADD; }
    or (code == table.REDUCE_FMUL_SEQ || code == table.REDUCE_FMUL_ANY) { c.row = gen_row_index.OPFMUL; }
    or (code == table.REDUCE_FMINNUM)                                   { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_NMIN, glsl: true}; }
    or (code == table.REDUCE_FMAXNUM)                                   { c = Combine{row: gen_row_index.OPEXTINST_GLSL_STD_450_NMAX, glsl: true}; }
    ret c;
}

fun reduction(code: u32) bool {
    ret code == table.REDUCE_ADD || code == table.REDUCE_MUL || code == table.REDUCE_AND || code == table.REDUCE_OR || code == table.REDUCE_XOR || code == table.REDUCE_SMIN || code == table.REDUCE_SMAX || code == table.REDUCE_UMIN || code == table.REDUCE_UMAX || code == table.REDUCE_FADD_SEQ || code == table.REDUCE_FADD_ANY || code == table.REDUCE_FMUL_SEQ || code == table.REDUCE_FMUL_ANY || code == table.REDUCE_FMIN || code == table.REDUCE_FMAX || code == table.REDUCE_FMINNUM || code == table.REDUCE_FMAXNUM;
}

# the lanes of a vector combined in order
fun reduce(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x: Value   = d.operands.data[0];
    val r: Value   = d.results.data[0];
    val c: Combine = combine(d.opcode, spirv_types.boolean(e.u, emitter.value_type(e, x)));
    if (c.row == emitter.NO_ROW) {
        emitter.unselected(e, i);
        ret;
    }
    val t:     u32 = emitter.type_id(e, r);
    val v:     u32 = emitter.id_of(e, x);
    val lanes: u32 = spirv_types.lanes_of(e.u, emitter.value_type(e, x));
    if (lanes <= 1) {
        emitter.copy(e, t, e.ids.data[r], v);
        ret;
    }
    var acc: u32 = emitter.fresh(e);
    emitter.extract(e, t, acc, v, 0);
    var k: u32 = 1;
    for (k < lanes) {
        val lane: u32 = emitter.fresh(e);
        emitter.extract(e, t, lane, v, k);
        var into: u32 = emitter.fresh(e);
        if (k + 1 == lanes) { into = e.ids.data[r]; }
        if (c.glsl)         { emitter.glsl_two(e, c.row, t, into, acc, lane); }
        or                  { emitter.two(e, c.row, t, into, acc, lane); }
        acc = into;
        k   = k + 1;
    }
}

# a constant of a type whose every lane is one value
fun splat(e: *Emitter, ty: Type, value: u64) u32 {
    ret spirv_types.splat(e.u, ty, value);
}

fun all_ones(width: u32) u64 {
    if (width >= 64) { ret 0xFFFF_FFFF_FFFF_FFFF; }
    ret (1::u64 << width::u64) - 1;
}

# a bool or a vector of them as integers of a width, one or minus one for true
fun widened(e: *Emitter, x: u32, ty: Type, signed: bool) u32 {
    val wide: Type = emitter.integer(e, 32, spirv_types.lanes_of(e.u, ty));
    var yes:  u64  = 1;
    if (signed) { yes = 0xFFFF_FFFF; }
    val r: u32 = emitter.fresh(e);
    emitter.three(e, gen_row_index.OPSELECT, spirv_types.type_of(e.u, wide, spirv_types.PLAIN), r, x, splat(e, wide, yes), splat(e, wide, 0));
    ret r;
}

# a conversion between integers of different widths, or of bools
fun converted(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32   = d.opcode;
    val x:    Value = d.operands.data[0];
    val r:    Value = d.results.data[0];
    val from: Type  = emitter.value_type(e, x);
    val to:   Type  = emitter.value_type(e, r);
    val t:    u32   = emitter.type_id(e, r);
    val into: u32   = e.ids.data[r];
    val v:    u32   = emitter.id_of(e, x);
    if (spirv_types.boolean(e.u, to)) {
        if (code != table.TRUNC) {
            emitter.unselected(e, i);
            ret;
        }
        val low: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPBITWISEAND, emitter.type_id(e, x), low, v, splat(e, from, 1));
        emitter.two(e, gen_row_index.OPINOTEQUAL, t, into, low, splat(e, from, 0));
        ret;
    }
    if (spirv_types.boolean(e.u, from)) {
        var yes: u64 = 1;
        if (code == table.EXT_S) { yes = all_ones(spirv_types.bits_of(e.u, to)); }
        emitter.three(e, gen_row_index.OPSELECT, t, into, v, splat(e, to, yes), splat(e, to, 0));
        ret;
    }
    if (code == table.EXT_S) { emitter.one(e, gen_row_index.OPSCONVERT, t, into, v); }
    or                       { emitter.one(e, gen_row_index.OPUCONVERT, t, into, v); }
}

# the bits of the float of a width that is plus or minus two to the power
# `k`, an infinity where no finite float of the width is that large
fun power_bits(width: u32, negative: bool, k: u32) u64 {
    var p:    u32 = 24;
    var bias: u32 = 127;
    if (width == 16) {
        p    = 11;
        bias = 15;
    }
    or (width == 64) {
        p    = 53;
        bias = 1023;
    }
    var sign: u64 = 0;
    if (negative) { sign = 1::u64 << (width - 1)::u64; }
    if (k > bias) { ret sign | ((2 * bias + 1)::u64 << (p - 1)::u64); }
    ret sign | ((k + bias)::u64 << (p - 1)::u64);
}

# a float to an integer, toward zero, saturating at the integer's bounds
# and zero for a nan, as spir-v's conversion leaves a value past the bounds
# undefined. a value strictly between the bounds' powers of two, the
# integer's range widened to the next whole number past each end, converts,
# and only it reaches the conversion: the largest integer is seldom a float,
# so a clamp to a float below it would give a smaller one
fun saturated(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:      Value = d.operands.data[0];
    val r:      Value = d.results.data[0];
    val from:   Type  = emitter.value_type(e, x);
    val to:     Type  = emitter.value_type(e, r);
    val fw:     u32   = spirv_types.bits_of(e.u, from);
    val tw:     u32   = spirv_types.bits_of(e.u, to);
    val signed: bool  = d.opcode == table.FTOI_S;
    if (tw <= 1 || tw > 64 || spirv_types.boolean(e.u, to)) {
        emitter.unselected(e, i);
        ret;
    }
    var low:   u64 = power_bits(fw, true, 0);
    var top:   u64 = power_bits(fw, false, tw);
    var least: u64 = 0;
    var most:  u64 = all_ones(tw);
    if (signed) {
        low   = power_bits(fw, true, tw - 1);
        top   = power_bits(fw, false, tw - 1);
        least = 1::u64 << (tw - 1)::u64;
        most  = all_ones(tw - 1);
    }
    val ft:     u32 = emitter.type_id(e, x);
    val t:      u32 = emitter.type_id(e, r);
    val bt:     u32 = emitter.bool_of(e, from);
    val v:      u32 = emitter.id_of(e, x);
    val below:  u32 = emitter.fresh(e);
    val past:   u32 = emitter.fresh(e);
    val inside: u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPFORDLESSTHAN, bt, below, v, splat(e, from, top));
    emitter.two(e, gen_row_index.OPFORDGREATERTHAN, bt, past, v, splat(e, from, low));
    emitter.two(e, gen_row_index.OPLOGICALAND, bt, inside, below, past);
    val held: u32 = emitter.fresh(e);
    emitter.three(e, gen_row_index.OPSELECT, ft, held, inside, v, splat(e, from, 0));
    val whole: u32 = emitter.fresh(e);
    if (signed) { emitter.one(e, gen_row_index.OPCONVERTFTOS, t, whole, held); }
    or          { emitter.one(e, gen_row_index.OPCONVERTFTOU, t, whole, held); }
    val under: u32 = emitter.fresh(e);
    val over:  u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPFORDLESSTHANEQUAL, bt, under, v, splat(e, from, low));
    emitter.two(e, gen_row_index.OPFORDGREATERTHANEQUAL, bt, over, v, splat(e, from, top));
    val floor: u32 = emitter.fresh(e);
    emitter.three(e, gen_row_index.OPSELECT, t, floor, under, splat(e, to, least), splat(e, to, 0));
    val bound: u32 = emitter.fresh(e);
    emitter.three(e, gen_row_index.OPSELECT, t, bound, over, splat(e, to, most), floor);
    emitter.three(e, gen_row_index.OPSELECT, t, e.ids.data[r], inside, whole, bound);
}

# an integer to a float, a bool read as one or minus one
fun floated(e: *Emitter, d: *InstructionData) {
    val x:      Value = d.operands.data[0];
    val r:      Value = d.results.data[0];
    val from:   Type  = emitter.value_type(e, x);
    val signed: bool  = d.opcode == table.ITOF_S;
    var v:      u32   = emitter.id_of(e, x);
    if (spirv_types.boolean(e.u, from)) { v = widened(e, v, from, signed); }
    if (signed)                         { emitter.one(e, gen_row_index.OPCONVERTSTOF, emitter.type_id(e, r), e.ids.data[r], v); }
    or                                  { emitter.one(e, gen_row_index.OPCONVERTUTOF, emitter.type_id(e, r), e.ids.data[r], v); }
}

# the same bits as another type
fun cast(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:    Value = d.operands.data[0];
    val r:    Value = d.results.data[0];
    val from: Type  = emitter.value_type(e, x);
    val to:   Type  = emitter.value_type(e, r);
    if (spirv_types.pointer(e.u, from) || spirv_types.pointer(e.u, to)) {
        emitter.fail(e, Error.reinterpreted{emitter.at(e, i)});
        ret;
    }
    if (spirv_types.boolean(e.u, from) || spirv_types.boolean(e.u, to)) {
        emitter.unselected(e, i);
        ret;
    }
    val t: u32 = emitter.type_id(e, r);
    if (t == emitter.type_id(e, x)) {
        emitter.copy(e, t, e.ids.data[r], emitter.id_of(e, x));
        ret;
    }
    emitter.one(e, gen_row_index.OPBITCAST, t, e.ids.data[r], emitter.id_of(e, x));
}

# a float with the sign of another, by their bits
fun copysign(e: *Emitter, d: *InstructionData) {
    val x:      Value = d.operands.data[0];
    val y:      Value = d.operands.data[1];
    val r:      Value = d.results.data[0];
    val ty:     Type  = emitter.value_type(e, x);
    val w:      u32   = spirv_types.bits_of(e.u, ty);
    val bits:   Type  = emitter.integer(e, w, spirv_types.lanes_of(e.u, ty));
    val it:     u32   = spirv_types.type_of(e.u, bits, spirv_types.PLAIN);
    val sign:   u64   = 1::u64 << (w - 1)::u64;
    val xi:     u32   = emitter.fresh(e);
    val yi:     u32   = emitter.fresh(e);
    val xm:     u32   = emitter.fresh(e);
    val ym:     u32   = emitter.fresh(e);
    val joined: u32   = emitter.fresh(e);
    emitter.one(e, gen_row_index.OPBITCAST, it, xi, emitter.id_of(e, x));
    emitter.one(e, gen_row_index.OPBITCAST, it, yi, emitter.id_of(e, y));
    emitter.two(e, gen_row_index.OPBITWISEAND, it, xm, xi, splat(e, bits, all_ones(w) ^ sign));
    emitter.two(e, gen_row_index.OPBITWISEAND, it, ym, yi, splat(e, bits, sign));
    emitter.two(e, gen_row_index.OPBITWISEOR, it, joined, xm, ym);
    emitter.one(e, gen_row_index.OPBITCAST, emitter.type_id(e, r), e.ids.data[r], joined);
}

# the bytes of an integer in the other order, by shifts and masks
fun swapped(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:  Value = d.operands.data[0];
    val r:  Value = d.results.data[0];
    val ty: Type  = emitter.value_type(e, x);
    val w:  u32   = spirv_types.bits_of(e.u, ty);
    if (w < 16 || w % 8 != 0) {
        emitter.unselected(e, i);
        ret;
    }
    val t:   u32 = emitter.type_id(e, x);
    val v:   u32 = emitter.id_of(e, x);
    val n:   u32 = w / 8;
    var acc: u32 = NO_ID;
    var k:   u32 = 0;
    for (k < n) {
        val down: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPSHIFTRIGHTLOGICAL, t, down, v, splat(e, ty, (8 * k)::u64));
        val byte: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPBITWISEAND, t, byte, down, splat(e, ty, 0xFF));
        val up: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPSHIFTLEFTLOGICAL, t, up, byte, splat(e, ty, (8 * (n - 1 - k))::u64));
        if (acc == NO_ID) { acc = up; }
        or {
            var into: u32 = emitter.fresh(e);
            if (k + 1 == n) { into = e.ids.data[r]; }
            emitter.two(e, gen_row_index.OPBITWISEOR, t, into, acc, up);
            acc = into;
        }
        k = k + 1;
    }
}

# the width masc's typing holds the first value operand of the row at `row` to, 0 for any
fun held_bits(row: u32) u32 {
    val opt_typing: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, row);
    if (sel opt_typing.none) { ret 0; }
    val t:    *typing.Typing = opt_typing.some;
    var low:  u8             = typing.RESULT;
    var bits: u32            = 0;
    var k:    u32            = 0;
    for (k < t.count) {
        val f: *typing.Form = ?t.forms[k];
        if (f.slot != typing.RESULT && f.slot < low) {
            low  = f.slot;
            bits = f.bits::u32;
        }
        k = k + 1;
    }
    ret bits;
}

# a count of one bits (OpBitCount), or of leading (FindUMsb) or trailing (FindILsb) zeros, of an integer of any width,
# made at the width masc's typing holds the instruction's operand to: a narrower value widened with zeros, which add
# no one bit and whose leading zeros the count takes away, and a wider one word by word, low word first, a zero word
# adding its width to the count of the words past it
fun counted(e: *Emitter, i: Instruction, d: *InstructionData) {
    val x:   Value = d.operands.data[0];
    val r:   Value = d.results.data[0];
    val ty:  Type  = emitter.value_type(e, x);
    val w:   u32   = spirv_types.bits_of(e.u, ty);
    var row: u32   = gen_row_index.OPBITCOUNT;
    if (d.opcode == table.CLZ) { row = gen_row_index.OPEXTINST_GLSL_STD_450_FINDUMSB; }
    or (d.opcode == table.CTZ) { row = gen_row_index.OPEXTINST_GLSL_STD_450_FINDILSB; }
    var h: u32 = held_bits(row);
    if (h == 0) { h = w; }
    if (w <= 1 || (w > h && w % h != 0)) {
        emitter.unselected(e, i);
        ret;
    }
    val word:   Type = emitter.integer(e, h, spirv_types.lanes_of(e.u, ty));
    val wt:     u32  = spirv_types.type_of(e.u, word, spirv_types.PLAIN);
    val v:      u32  = emitter.id_of(e, x);
    val into:   u32  = e.ids.data[r];
    var n:      u32  = 1;
    var narrow: u32  = w;
    if (w > h) {
        n      = w / h;
        narrow = h;
    }
    var acc: u32 = NO_ID;
    var j:   u32 = 0;
    for (j < n) {
        var k: u32 = j;
        if (d.opcode == table.CTZ) { k = n - 1 - j; }
        var part: u32 = v;
        if (w != h) {
            var shifted: u32 = v;
            if (k > 0) {
                shifted = emitter.fresh(e);
                emitter.two(e, gen_row_index.OPSHIFTRIGHTLOGICAL, emitter.type_id(e, x), shifted, v, splat(e, ty, (k * h)::u64));
            }
            part = emitter.fresh(e);
            emitter.one(e, gen_row_index.OPUCONVERT, wt, part, shifted);
        }
        var c: u32 = emitter.fresh(e);
        if (w == h) { c = into; }
        bit_scan(e, d.opcode, word, wt, part, narrow, c);
        if (acc == NO_ID) { acc = c; }
        or (d.opcode == table.POPCNT) {
            val sum: u32 = emitter.fresh(e);
            emitter.two(e, gen_row_index.OPIADD, wt, sum, acc, c);
            acc = sum;
        }
        or {
            val zero: u32 = emitter.fresh(e);
            emitter.two(e, gen_row_index.OPIEQUAL, emitter.bool_of(e, word), zero, part, splat(e, word, 0));
            val past: u32 = emitter.fresh(e);
            emitter.two(e, gen_row_index.OPIADD, wt, past, acc, splat(e, word, h::u64));
            val chosen: u32 = emitter.fresh(e);
            emitter.three(e, gen_row_index.OPSELECT, wt, chosen, zero, past, c);
            acc = chosen;
        }
        j = j + 1;
    }
    if (w != h) { emitter.one(e, gen_row_index.OPUCONVERT, emitter.type_id(e, r), into, acc); }
}

# one count of a word `part` of type `word` into `into`, of a value `narrow` bits wide widened with zeros to the word
fun bit_scan(e: *Emitter, opcode: u32, word: Type, wt: u32, part: u32, narrow: u32, into: u32) {
    if (opcode == table.POPCNT) {
        emitter.one(e, gen_row_index.OPBITCOUNT, wt, into, part);
        ret;
    }
    if (opcode == table.CLZ) {
        val msb: u32 = emitter.fresh(e);
        emitter.glsl_one(e, gen_row_index.OPEXTINST_GLSL_STD_450_FINDUMSB, wt, msb, part);
        emitter.two(e, gen_row_index.OPISUB, wt, into, splat(e, word, (narrow - 1)::u64), msb);
        ret;
    }
    val lsb: u32 = emitter.fresh(e);
    emitter.glsl_one(e, gen_row_index.OPEXTINST_GLSL_STD_450_FINDILSB, wt, lsb, part);
    val zero: u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPIEQUAL, emitter.bool_of(e, word), zero, part, splat(e, word, 0));
    emitter.three(e, gen_row_index.OPSELECT, wt, into, zero, splat(e, word, narrow::u64), lsb);
}

# the high half of a product, through the extended multiplies
fun high(e: *Emitter, d: *InstructionData) {
    val x:   Value = d.operands.data[0];
    val r:   Value = d.results.data[0];
    val xv:  u32   = emitter.id_of(e, x);
    val yv:  u32   = emitter.id_of(e, d.operands.data[1]);
    var row: u32   = gen_row_index.OPUMULEXTENDED;
    if (d.opcode == table.MUL_HIGH_S) { row = gen_row_index.OPSMULEXTENDED; }
    val t:    u32 = emitter.type_id(e, x);
    val pair: u32 = emitter.fresh(e);
    emitter.two(e, row, spirv_types.pair_of(e.u, t), pair, xv, yv);
    if (d.opcode != table.MUL_HIGH_SU) {
        emitter.extract(e, t, e.ids.data[r], pair, 1);
        ret;
    }
    # a negative signed first operand takes the second once from the unsigned high half
    val ty:  Type = emitter.value_type(e, x);
    val top: u32  = emitter.fresh(e);
    emitter.extract(e, t, top, pair, 1);
    val sign: u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPSHIFTRIGHTARITHMETIC, t, sign, xv, splat(e, ty, (spirv_types.bits_of(e.u, ty) - 1)::u64));
    val less: u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPBITWISEAND, t, less, sign, yv);
    emitter.two(e, gen_row_index.OPISUB, t, e.ids.data[r], top, less);
}

# an operation and whether it overflowed
fun overflowed(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32   = d.opcode;
    val x:    Value = d.operands.data[0];
    val y:    Value = d.operands.data[1];
    val r:    Value = d.results.data[0];
    val o:    Value = d.results.data[1];
    val ty:   Type  = emitter.value_type(e, x);
    val t:    u32   = emitter.type_id(e, x);
    val bt:   u32   = emitter.type_id(e, o);
    val xv:   u32   = emitter.id_of(e, x);
    val yv:   u32   = emitter.id_of(e, y);
    val w:    u32   = spirv_types.bits_of(e.u, ty);
    if (spirv_types.boolean(e.u, ty)) {
        emitter.unselected(e, i);
        ret;
    }
    val into: u32 = e.ids.data[r];
    val flag: u32 = e.ids.data[o];
    if (code == table.ADD_OV_U || code == table.SUB_OV_U || code == table.MUL_OV_U || code == table.MUL_OV_S) {
        var row: u32 = gen_row_index.OPIADDCARRY;
        if (code == table.SUB_OV_U) { row = gen_row_index.OPISUBBORROW; }
        or (code == table.MUL_OV_U) { row = gen_row_index.OPUMULEXTENDED; }
        or (code == table.MUL_OV_S) { row = gen_row_index.OPSMULEXTENDED; }
        val pair: u32 = emitter.fresh(e);
        emitter.two(e, row, spirv_types.pair_of(e.u, t), pair, xv, yv);
        emitter.extract(e, t, into, pair, 0);
        val top: u32 = emitter.fresh(e);
        emitter.extract(e, t, top, pair, 1);
        if (code == table.MUL_OV_S) {
            val sign: u32 = emitter.fresh(e);
            emitter.two(e, gen_row_index.OPSHIFTRIGHTARITHMETIC, t, sign, into, splat(e, ty, (w - 1)::u64));
            emitter.two(e, gen_row_index.OPINOTEQUAL, bt, flag, top, sign);
            ret;
        }
        emitter.two(e, gen_row_index.OPINOTEQUAL, bt, flag, top, splat(e, ty, 0));
        ret;
    }
    var row: u32 = gen_row_index.OPIADD;
    if (code == table.SUB_OV_S) { row = gen_row_index.OPISUB; }
    or (code != table.ADD_OV_S) {
        emitter.unselected(e, i);
        ret;
    }
    emitter.two(e, row, t, into, xv, yv);
    val a: u32 = emitter.fresh(e);
    val b: u32 = emitter.fresh(e);
    val m: u32 = emitter.fresh(e);
    if (code == table.ADD_OV_S) {
        emitter.two(e, gen_row_index.OPBITWISEXOR, t, a, xv, into);
        emitter.two(e, gen_row_index.OPBITWISEXOR, t, b, yv, into);
    }
    or {
        emitter.two(e, gen_row_index.OPBITWISEXOR, t, a, xv, yv);
        emitter.two(e, gen_row_index.OPBITWISEXOR, t, b, xv, into);
    }
    emitter.two(e, gen_row_index.OPBITWISEAND, t, m, a, b);
    emitter.two(e, gen_row_index.OPSLESSTHAN, bt, flag, m, splat(e, ty, 0));
}

# the function a callee names, none for one chosen at run time
fun callee(e: *Emitter, v: Value) opt[Function] {
    val d: Def = e.b.values.data[v].def;
    if (sel d.constant) {
        val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, d.constant);
        if (sel res_constant_data.err) { ret opt[Function].none{}; }
        val data: ConstantData = res_constant_data.ok;
        if (!(sel data.address))      { ret opt[Function].none{}; }
        if (data.address.offset != 0) { ret opt[Function].none{}; }
        val s: Symbol = data.address.symbol;
        if (sel s.function) { ret opt[Function].some{s.function}; }
        ret opt[Function].none{};
    }
    if (sel d.result) {
        val made: *InstructionData = ?e.b.instructions.data[d.result.instruction];
        if (made.opcode == table.FUNC_ADDR && made.immediates.len > 0) {
            val imm: Immediate = made.immediates.data[0];
            if (sel imm.function) { ret opt[Function].some{imm.function}; }
        }
    }
    ret opt[Function].none{};
}

# a call passes a pointer into a storage buffer only under
# VariablePointersStorageBuffer, and one into part of a Workgroup variable only
# under VariablePointers, each declared with SPV_KHR_variable_pointers below
# spir-v 1.3 (spir-v 1.6, 2.16.1, universal validation rules, as spirv-val
# reads them)
val STORAGE_ARGUMENT_ATOMS: [4]requirement.Id          = [4]requirement.Id{gen_extension.VARIABLEPOINTERSSTORAGEBUFFER, gen_extension.SPV1_3, gen_extension.VARIABLEPOINTERSSTORAGEBUFFER, gen_extension.SPV_KHR_VARIABLE_POINTERS};
val STORAGE_ARGUMENT_WAYS:  [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?STORAGE_ARGUMENT_ATOMS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?STORAGE_ARGUMENT_ATOMS[2], len: 2}, none: requirement.NO_IDS},
};
val STORAGE_ARGUMENT:  requirement.Requirement    = requirement.Requirement{at: ?STORAGE_ARGUMENT_WAYS[0], len: 2};
val SHARED_PART_ATOMS: [4]requirement.Id          = [4]requirement.Id{gen_extension.VARIABLEPOINTERS, gen_extension.SPV1_3, gen_extension.VARIABLEPOINTERS, gen_extension.SPV_KHR_VARIABLE_POINTERS};
val SHARED_PART_WAYS:  [2]requirement.Alternative = [2]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?SHARED_PART_ATOMS[0], len: 2}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?SHARED_PART_ATOMS[2], len: 2}, none: requirement.NO_IDS},
};
val SHARED_PART: requirement.Requirement = requirement.Requirement{at: ?SHARED_PART_WAYS[0], len: 2};

# the name spir-v gives a storage class
fun class_name(class: u32) str {
    var i: usize = 0;
    for (i < $length_of(gen_operand.STORAGECLASS_MEMBERS)) {
        if (gen_operand.STORAGECLASS_MEMBERS[i].value == class) { ret gen_operand.STORAGECLASS_MEMBERS[i].name; }
        i = i + 1;
    }
    ret "?";
}

# hold a call's pointer argument to what logical addressing lets a call pass
# (spir-v 1.6, 2.16.1): a whole UniformConstant, Function, Private, Workgroup
# or AtomicCounter variable or parameter with no capability, a StorageBuffer
# pointer under STORAGE_ARGUMENT, part of a Workgroup variable under
# SHARED_PART, and nothing else. a physical pointer is a value the rule leaves
# alone
fun passable(e: *Emitter, i: Instruction, p: Pointer) bool {
    val c: u64 = p.class::u64;
    if (c == schema.PHYSICAL_STORAGE_BUFFER) { ret true; }
    if (c == schema.STORAGE_BUFFER) {
        unit.keep(e.u, buffer.need(?e.u.buf, STORAGE_ARGUMENT));
        ret true;
    }
    if (c == schema.WORKGROUP && !p.declared) {
        unit.keep(e.u, buffer.need(?e.u.buf, SHARED_PART));
        ret true;
    }
    val whole: bool = c == schema.UNIFORM_CONSTANT || c == schema.FUNCTION || c == schema.PRIVATE || c == schema.WORKGROUP || c == schema.ATOMIC_COUNTER;
    if (whole && p.declared) { ret true; }
    emitter.fail(e, Error.passed{Passed{at: emitter.at(e, i), class: class_name(p.class), whole: p.declared}});
    ret false;
}

# a call of a function of the module, its several results a structure
fun call(e: *Emitter, i: Instruction, d: *InstructionData) {
    val opt_callee: opt[Function] = callee(e, d.operands.data[0]);
    if (sel opt_callee.none) {
        emitter.unselected(e, i);
        ret;
    }
    val sig:  *Signature         = unit.signature(e.u, opt_callee.some);
    var args: vector.Vector[u32] = vector.init[u32](e.u.a);
    fin { vector.dnit[u32](?args); }
    var j: usize = 1;
    for (j < d.operands.len && ok(e)) {
        val a: Value = d.operands.data[j];
        if (spirv_types.pointer(e.u, emitter.value_type(e, a))) {
            val opt_pointer_of: opt[Pointer] = access.pointer_of(e, a, i);
            if (sel opt_pointer_of.none) { ret; }
            val k: u32 = (j - 1)::u32;
            if (k >= sig.params.len || access.pointer_type(e, opt_pointer_of.some) != e.u.lists.data[sig.params.at + k]) {
                emitter.fail(e, Error.reinterpreted{emitter.at(e, i)});
                ret;
            }
            if (!passable(e, i, opt_pointer_of.some)) { ret; }
            push_u32(e, ?args, opt_pointer_of.some.id);
        }
        or { push_u32(e, ?args, emitter.id_of(e, a)); }
        j = j + 1;
    }
    var r: u32 = emitter.fresh(e);
    if (d.results.len == 1) { r = e.ids.data[d.results.data[0]]; }
    var s: [4]Slot = [4]Slot{Slot.id{sig.result}, Slot.id{r}, Slot.id{e.u.functions.data[opt_callee.some]}, Slot.list{unit.list(e.u, args.data, args.len)}};
    emitter.put(e, gen_row_index.OPFUNCTIONCALL, ?s[0], 4);
    if (d.results.len > 1) {
        var k: usize = 0;
        for (k < d.results.len) {
            val v: Value = d.results.data[k];
            emitter.extract(e, emitter.type_id(e, v), e.ids.data[v], r, k::u32);
            k = k + 1;
        }
    }
}

# the bits of an integer constant value, none for any other value
fun constant_bits(e: *Emitter, v: Value) opt[u64] {
    val d: Def = e.b.values.data[v].def;
    if (!(sel d.constant)) { ret opt[u64].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, d.constant);
    if (sel res_constant_data.err) { ret opt[u64].none{}; }
    val data: ConstantData = res_constant_data.ok;
    if (sel data.zero) { ret opt[u64].some{0}; }
    if (sel data.integer) {
        if (data.integer.words.size > 0) { ret opt[u64].some{data.integer.words.data[0]}; }
    }
    ret opt[u64].none{};
}

# the slot a value takes for one operand of a target op's row: its id, the
# pointer it is, or the integer constant it is for a constant id, an
# immediate, an enumerant or a number written inline. an enumerant takes the
# params of the members its value names after it, as the row's own operands
# do. a value where a constant is asked, or an enumerant value its operand
# does not admit, is refused naming the argument. a memory scope and memory
# semantics are held to the module's memory model
fun op_operand(e: *Emitter, i: Instruction, d: *InstructionData, x: *mo.Operand, role: Role, taken: *usize, brought: *Bringing) Slot {
    if (@taken >= d.operands.len) {
        emitter.unselected(e, i);
        ret Slot.none{};
    }
    val at: u32   = (@taken)::u32;
    val v:  Value = d.operands.data[@taken];
    @taken = @taken + 1;
    if (sel x.shape.id) {
        if (sel role.constant) {
            var opt_constant: opt[u32] = opt[u32].none{};
            if (spirv_types.pointer(e.u, emitter.value_type(e, v))) { opt_constant = slot_constant(e, v, i, 0); }
            or                                                      { opt_constant = constant_id(e, v); }
            if (sel opt_constant.none) {
                emitter.fail(e, Error.not_constant{Operand{at: emitter.at(e, i), operand: at}});
                ret Slot.none{};
            }
            ret Slot.id{opt_constant.some};
        }
        if (spirv_types.pointer(e.u, emitter.value_type(e, v))) {
            val opt_pointer_of: opt[Pointer] = access.pointer_of(e, v, i);
            if (sel opt_pointer_of.none) { ret Slot.none{}; }
            ret Slot.id{opt_pointer_of.some.id};
        }
        if (!(sel role.value)) {
            val opt_held: opt[u64] = constant_bits(e, v);
            if (sel opt_held.none) {
                emitter.fail(e, Error.not_constant{Operand{at: emitter.at(e, i), operand: at}});
                ret Slot.none{};
            }
            if (sel role.scope)     { spirv_types.scoped(e.u, opt_held.some); }
            if (sel role.semantics) { spirv_types.ordered(e.u, opt_held.some); }
            val opt_refusal: opt[str] = vulkan_refusal(role, opt_held.some);
            if (sel opt_refusal.some) {
                emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at}, value: opt_held.some::u32, why: Unadmitted.outside{opt_refusal.some}}});
                ret Slot.none{};
            }
        }
        ret Slot.id{emitter.id_of(e, v)};
    }
    val opt_bits: opt[u64] = constant_bits(e, v);
    if (sel opt_bits.none) {
        emitter.fail(e, Error.not_constant{Operand{at: emitter.at(e, i), operand: at}});
        ret Slot.none{};
    }
    if (sel x.shape.immediate) { ret Slot.immediate{opt_bits.some::i64}; }
    if (sel x.shape.enumerant) {
        val value: u32 = opt_bits.some::u32;
        if (opt_bits.some > 0xFFFF_FFFF || !admitted(x.shape.enumerant, value)) {
            emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at}, value: value, why: Unadmitted.outside{admits(e, x.shape.enumerant)}}});
            ret Slot.none{};
        }
        ret op_enumerant(e, i, d, x.shape.enumerant, value, at, taken, brought);
    }
    if (sel x.shape.literal) {
        val width: u32 = spirv_types.bits_of(e.u, emitter.value_type(e, v));
        ret Slot.literal{unit.words(e.u, opt_bits.some, (width + 31) / 32)};
    }
    emitter.unselected(e, i);
    ret Slot.none{};
}

# the memory semantics bit of a sequentially consistent order
val SEQUENTIALLY_CONSISTENT: u64 = 0x10;

# the scopes vulkan admits
val CROSS_DEVICE: u64 = 0;
val WORKGROUP:    u64 = 2;
val SUBGROUP:     u64 = 3;

# what the vulkan environment admits of a scope or semantics a call passes, none
# where it admits the value: no sequentially consistent order
# (VUID-StandaloneSpirv-MemorySemantics-10866), an execution scope of Workgroup
# or Subgroup alone, and a memory scope of any but CrossDevice, as the vulkan
# environment's standalone spir-v rules state
fun vulkan_refusal(role: Role, value: u64) opt[str] {
    if ((sel role.semantics) && (value & SEQUENTIALLY_CONSISTENT) != 0)  { ret opt[str].some{"Acquire (0x2), Release (0x4) or AcquireRelease (0x8), with the storage classes they order, and never SequentiallyConsistent (0x10), which vulkan does not define"}; }
    if ((sel role.execution) && value != WORKGROUP && value != SUBGROUP) { ret opt[str].some{"Workgroup (2) or Subgroup (3), the scopes a vulkan barrier executes at"}; }
    if ((sel role.scope) && value == CROSS_DEVICE)                       { ret opt[str].some{"Device (1), Workgroup (2), Subgroup (3), Invocation (4), QueueFamily (5) or ShaderCallKHR (6), as vulkan admits no CrossDevice scope"}; }
    ret opt[str].none{};
}

# the last enumerant value a call passes, which every argument past the row's
# operands is refused against, as operands it does not bring
# ---
# operand:   the enumerant's argument, from zero
# value:     its value
# brings:    the operands it brings
# chosen:    whether the call passes one
# constants: the mask bits whose params must be constants
rec Bringing {
    operand:   u32;
    value:     u32;
    brings:    u32;
    chosen:    bool;
    constants: u32;
}

# whether an enumeration admits `value`: one of its members, or for a mask a
# union of its members' bits
fun admitted(en: mo.Enumeration, value: u32) bool {
    var covered: u32 = 0;
    var k:       u32 = 0;
    for (k < en.count) {
        val m: u32 = en.members[k].value;
        if (!en.mask && m == value) { ret true; }
        covered = covered | m;
        k       = k + 1;
    }
    ret en.mask && (value & ~covered) == 0;
}

# the values an enumeration admits, as spir-v names them with their values,
# in a string of the unit's allocator the refusal carries out
fun admits(e: *Emitter, en: mo.Enumeration) str {
    var text: vector.Vector[u8] = vector.init[u8](e.u.a);
    fin { vector.dnit[u8](?text); }
    if (en.mask) { push_text(e, ?text, "a union of "); }
    var k: u32 = 0;
    for (k < en.count) {
        if (k > 0) { push_text(e, ?text, ", "); }
        push_text(e, ?text, en.members[k].name);
        push_text(e, ?text, " (");
        push_number(e, ?text, en.members[k].value::u64, en.mask);
        push_text(e, ?text, ")");
        k = k + 1;
    }
    val res_made: res[*u8, allocator.Error] = allocator.allocate[u8](e.u.a, text.len + 1);
    if (sel res_made.err) {
        emitter.lost(e, res_made.err);
        ret "";
    }
    val out: *u8   = res_made.ok;
    var at:  usize = 0;
    for (at < text.len) {
        out[at] = text.data[at];
        at      = at + 1;
    }
    out[text.len] = 0;
    ret out;
}

fun push_text(e: *Emitter, v: *vector.Vector[u8], t: str) {
    var k: usize = 0;
    for (t[k] != 0) {
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](v, t[k]);
        if (sel res_pushed.err) {
            emitter.lost(e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
}

# `n` in decimal, or in hexadecimal for a mask's bit
fun push_number(e: *Emitter, v: *vector.Vector[u8], n: u64, hex: bool) {
    var digits: [20]u8;
    var len:    usize = 0;
    var base:   u64   = 10;
    if (hex) {
        base = 16;
        push_text(e, v, "0x");
    }
    var left: u64 = n;
    for {
        val dg: u64 = left % base;
        digits[len] = (dg + '0'::u64)::u8;
        if (dg >= 10) { digits[len] = (dg - 10 + 'a'::u64)::u8; }
        len  = len + 1;
        left = left / base;
        if (left == 0) { brk; }
    }
    for (len > 0) {
        len = len - 1;
        val res_pushed: res[usize, allocator.Error] = vector.push[u8](v, digits[len]);
        if (sel res_pushed.err) {
            emitter.lost(e, res_pushed.err);
            ret;
        }
    }
}

# an enumerant of a target op and its params, each taking the next operand. a
# value bringing more operands than the call has left is refused naming both
fun op_enumerant(e: *Emitter, i: Instruction, d: *InstructionData, en: mo.Enumeration, value: u32, at: u32, taken: *usize, brought: *Bringing) Slot {
    val count: u32 = mo.param_count(?en, value);
    @brought = Bringing{operand: at, value: value, brings: count, chosen: true, constants: brought.constants};
    if (count == 0) { ret unit.enumerant(value); }
    val left: usize = d.operands.len - @taken;
    if (left < count::usize) {
        emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at}, value: value, why: Unadmitted.brought{Brought{brings: count, passed: left::u32}}}});
        ret Slot.none{};
    }
    var params: vector.Vector[Slot] = vector.init[Slot](e.u.a);
    fin { vector.dnit[Slot](?params); }
    var k: u32 = 0;
    for (k < count && ok(e)) {
        val p: *mo.Operand = mo.param(?en, value, k);
        if (p == nil) {
            emitter.unselected(e, i);
            ret Slot.none{};
        }
        push_slot(e, ?params, op_operand(e, i, d, p, param_role(?en, value, k, brought.constants), taken, brought));
        k = k + 1;
    }
    ret unit.enumerant_of(value, unit.slots(e.u, params.data, params.len));
}

# what an operand of a row is to the order it states, each but a value an id
# a constant must give
# ---
# value:     no part of its order
# scope:     its memory scope
# semantics: its memory semantics, or those of a compare and exchange that fails
# execution: its execution scope
# constant:  an operand an enumerant brings or the row's typing states that
#            must be a constant, a scalar or a vector of them
tag Role: u8 {
    value;
    scope;
    semantics;
    execution;
    constant;
}

# the id of a constant a value is made of constants alone, a constant, a
# vector built or splat of them or a load of one, none for any other value
fun constant_id(e: *Emitter, v: Value) opt[u32] {
    val d: Def = e.b.values.data[v].def;
    if (sel d.constant)  { ret opt[u32].some{emitter.id_of(e, v)}; }
    if (!(sel d.result)) { ret opt[u32].none{}; }
    val di: *InstructionData = ?e.b.instructions.data[d.result.instruction];
    if (di.opcode == table.LOAD && di.operands.len == 1)        { ret loaded_constant(e, v, di.operands.data[0], d.result.instruction); }
    if (di.opcode != table.VBUILD && di.opcode != table.VSPLAT) { ret opt[u32].none{}; }
    val lanes: u32 = spirv_types.lanes_of(e.u, emitter.value_type(e, v));
    if (lanes > 16) { ret opt[u32].none{}; }
    var ids: [16]u32;
    var k:   u32 = 0;
    for (k < lanes) {
        var x: Value = di.operands.data[0];
        if (di.opcode == table.VBUILD) {
            if (k::usize >= di.operands.len) { ret opt[u32].none{}; }
            x = di.operands.data[k];
        }
        val opt_lane: opt[u32] = constant_id(e, x);
        if (sel opt_lane.none) { ret opt[u32].none{}; }
        ids[k] = opt_lane.some;
        k      = k + 1;
    }
    val id:    u32     = unit.fresh(e.u);
    var slots: [3]Slot = [3]Slot{Slot.id{emitter.type_id(e, v)}, Slot.id{id}, Slot.list{unit.list(e.u, ?ids[0], lanes::usize)}};
    unit.put(e.u, buffer.TYPES, gen_row_index.OPCONSTANTCOMPOSITE, ?slots[0], 3);
    ret opt[u32].some{id};
}

# the constant the load `at` of value `v` reads through `p`: a module-scope
# `val` read whole, or a stack slot nothing writes but stores in the load's
# block, the last of them ahead of the load a constant. none for any other
fun loaded_constant(e: *Emitter, v: Value, p: Value, at: Instruction) opt[u32] {
    val pd: Def = e.b.values.data[p].def;
    if (sel pd.constant) {
        val opt_global: opt[Global] = constant_global(e, pd.constant);
        if (sel opt_global.none)                                                       { ret opt[u32].none{}; }
        if (e.u.m.globals.data[opt_global.some].data.type != emitter.value_type(e, v)) { ret opt[u32].none{}; }
        ret global_constant(e, opt_global.some);
    }
    val opt_stored: opt[Value] = slot_stored(e, p, at);
    if (sel opt_stored.none) { ret opt[u32].none{}; }
    ret constant_id(e, opt_stored.some);
}

# the value the load `at` reads from the stack slot `p` where nothing writes the slot but stores in the load's block,
# the last of them ahead of the load, none for any other
fun slot_stored(e: *Emitter, p: Value, at: Instruction) opt[Value] {
    val pd: Def = e.b.values.data[p].def;
    if (!(sel pd.result))                                                    { ret opt[Value].none{}; }
    if (e.b.instructions.data[pd.result.instruction].opcode != table.ALLOCA) { ret opt[Value].none{}; }
    val home:   u32                   = block_of(?e.b.instructions.data[at]);
    var last:   Instruction           = NONE;
    var stored: Value                 = p;
    val uses:   *Growing[Instruction] = ?e.b.values.data[p].uses;
    var j:      usize                 = 0;
    for (j < uses.len) {
        val u:  Instruction      = uses.data[j];
        val ud: *InstructionData = ?e.b.instructions.data[u];
        j = j + 1;
        if (ud.opcode == table.LOAD)                                                                              { cnt; }
        if (ud.opcode != table.STORE || ud.operands.len != 2 || ud.operands.data[0] != p || block_of(ud) != home) { ret opt[Value].none{}; }
        if (!ahead(e, home, u, at))                                                                               { cnt; }
        if (last == NONE || ahead(e, home, last, u)) {
            last   = u;
            stored = ud.operands.data[1];
        }
    }
    if (last == NONE) { ret opt[Value].none{}; }
    ret opt[Value].some{stored};
}

# the bits of the first component of the constant `v` that is not zero, none where every component is zero, read
# through the shapes constant_id makes an id of
fun nonzero(e: *Emitter, v: Value) opt[u64] {
    val d: Def = e.b.values.data[v].def;
    if (sel d.constant)  { ret nonzero_constant(e, d.constant); }
    if (!(sel d.result)) { ret opt[u64].some{1}; }
    val at: Instruction      = d.result.instruction;
    val di: *InstructionData = ?e.b.instructions.data[at];
    if (di.opcode == table.LOAD && di.operands.len == 1) {
        val pd: Def = e.b.values.data[di.operands.data[0]].def;
        if (sel pd.constant) {
            val opt_global: opt[Global] = constant_global(e, pd.constant);
            if (sel opt_global.none) { ret opt[u64].some{1}; }
            val initial: opt[Constant] = e.u.m.globals.data[opt_global.some].data.initial;
            if (sel initial.none) { ret opt[u64].none{}; }
            ret nonzero_constant(e, initial.some);
        }
        val opt_stored: opt[Value] = slot_stored(e, di.operands.data[0], at);
        if (sel opt_stored.none) { ret opt[u64].some{1}; }
        ret nonzero(e, opt_stored.some);
    }
    if (di.opcode != table.VBUILD && di.opcode != table.VSPLAT) { ret opt[u64].some{1}; }
    var k: usize = 0;
    for (k < di.operands.len) {
        val opt_lane: opt[u64] = nonzero(e, di.operands.data[k]);
        if (sel opt_lane.some) { ret opt_lane; }
        k = k + 1;
    }
    ret opt[u64].none{};
}

fun nonzero_constant(e: *Emitter, c: Constant) opt[u64] {
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, c);
    if (sel res_constant_data.err) { ret opt[u64].some{1}; }
    val data: ConstantData = res_constant_data.ok;
    if (sel data.zero) { ret opt[u64].none{}; }
    if (sel data.integer) {
        var k: usize = 0;
        for (k < data.integer.words.size) {
            if (data.integer.words.data[k] != 0) { ret opt[u64].some{data.integer.words.data[k]}; }
            k = k + 1;
        }
        ret opt[u64].none{};
    }
    if (sel data.aggregate) {
        var k: usize = 0;
        for (k < data.aggregate.elements.size) {
            val opt_element: opt[u64] = nonzero_constant(e, data.aggregate.elements.data[k]);
            if (sel opt_element.some) { ret opt_element; }
            k = k + 1;
        }
        ret opt[u64].none{};
    }
    ret opt[u64].some{1};
}

# the module-scope `val` the address constant `c` names whole, none for any
# other address
fun constant_global(e: *Emitter, c: Constant) opt[Global] {
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, c);
    if (sel res_constant_data.err) { ret opt[Global].none{}; }
    val data: ConstantData = res_constant_data.ok;
    if (!(sel data.address))      { ret opt[Global].none{}; }
    if (data.address.offset != 0) { ret opt[Global].none{}; }
    val s: Symbol = data.address.symbol;
    if (!(sel s.global))                             { ret opt[Global].none{}; }
    if (!e.u.m.globals.data[s.global].data.constant) { ret opt[Global].none{}; }
    ret opt[Global].some{s.global};
}

# the id of the constant a module-scope `val` holds, none where it holds none
fun global_constant(e: *Emitter, g: Global) opt[u32] {
    val initial: opt[Constant] = e.u.m.globals.data[g].data.initial;
    if (sel initial.none) { ret opt[u32].none{}; }
    val id: u32 = spirv_types.constant_of(e.u, initial.some, spirv_types.PLAIN);
    if (id == NONE) { ret opt[u32].none{}; }
    ret opt[u32].some{id};
}

# the most elements of an aggregate a constant operand is read from
val SLOT_ELEMENTS: u32 = 64;

# the constant a call reads from the stack slot `slot` at instruction `at`,
# none where what the slot holds there is no constant: the slot written whole,
# by a copy of a module-scope `val`, of another slot that holds a constant or
# by a fill of zero, and then any of its elements stored a constant, every
# write in the call's own block ahead of it, as an aggregate literal or a copy
# of a `val` passed whole is written. a write the slot takes any other way, a
# write a run-time value makes, or an element a whole copy of a `val` leaves
# under a store, is no constant
fun slot_constant(e: *Emitter, slot: Value, at: Instruction, depth: u32) opt[u32] {
    val d: Def = e.b.values.data[slot].def;
    if (depth > 4 || !(sel d.result)) { ret opt[u32].none{}; }
    if (sel d.result) {
        if (e.b.instructions.data[d.result.instruction].opcode != table.ALLOCA) { ret opt[u32].none{}; }
    }
    val opt_pointer: opt[Pointer] = access.pointer_of(e, slot, at);
    if (sel opt_pointer.none) { ret opt[u32].none{}; }
    val ty:   Type = opt_pointer.some.pointee;
    val n:    u64  = spirv_types.count_of(e.u, ty);
    val home: u32  = block_of(?e.b.instructions.data[at]);
    if (n == 0 || n > SLOT_ELEMENTS::u64) { ret opt[u32].none{}; }
    var stored: [64]Value;
    var when:   [64]u32;
    var k:      u32 = 0;
    for (k < n::u32) {
        when[k] = NONE;
        k       = k + 1;
    }
    var whole: Whole                 = Whole{id: NONE, null: false};
    var from:  Instruction           = NONE;
    val uses:  *Growing[Instruction] = ?e.b.values.data[slot].uses;
    var j:     usize                 = 0;
    for (j < uses.len) {
        val u:  Instruction      = uses.data[j];
        val ud: *InstructionData = ?e.b.instructions.data[u];
        j = j + 1;
        if (u == at || ud.opcode == table.LOAD)                                                                                { cnt; }
        if (ud.opcode == table.MEM_COPY && ud.operands.len == 3 && ud.operands.data[1] == slot && ud.operands.data[0] != slot) { cnt; }
        if (block_of(ud) != home || !ahead(e, home, u, at))                                                                    { ret opt[u32].none{}; }
        if ((ud.opcode == table.MEM_COPY || ud.opcode == table.MEM_FILL) && ud.operands.len == 3 && ud.operands.data[0] == slot) {
            if (from == NONE || ahead(e, home, from, u)) {
                val opt_whole: opt[Whole] = whole_constant(e, ud, ty, u, depth);
                if (sel opt_whole.none) { ret opt[u32].none{}; }
                whole = opt_whole.some;
                from  = u;
            }
            cnt;
        }
        if (ud.opcode != table.PTR_INDEX || ud.operands.len != 2 || ud.operands.data[0] != slot || ud.results.len != 1) { ret opt[u32].none{}; }
        val opt_index: opt[u64] = constant_bits(e, ud.operands.data[1]);
        if (sel opt_index.none)  { ret opt[u32].none{}; }
        if (opt_index.some >= n) { ret opt[u32].none{}; }
        val element: Value                 = ud.results.data[0];
        val writes:  *Growing[Instruction] = ?e.b.values.data[element].uses;
        var w:       usize                 = 0;
        for (w < writes.len) {
            val s:  Instruction      = writes.data[w];
            val sd: *InstructionData = ?e.b.instructions.data[s];
            w = w + 1;
            if (sd.opcode == table.LOAD)                                                                                                              { cnt; }
            if (sd.opcode != table.STORE || sd.operands.len != 2 || sd.operands.data[0] != element || block_of(sd) != home || !ahead(e, home, s, at)) { ret opt[u32].none{}; }
            val x: u32 = opt_index.some::u32;
            if (when[x] == NONE || ahead(e, home, when[x], s)) {
                when[x]   = s;
                stored[x] = sd.operands.data[1];
            }
        }
    }
    var ids:     [64]u32;
    var element: bool = false;
    k = 0;
    for (k < n::u32) {
        if (when[k] != NONE && (from == NONE || ahead(e, home, from, when[k]))) {
            val opt_lane: opt[u32] = constant_id(e, stored[k]);
            if (sel opt_lane.none) { ret opt[u32].none{}; }
            ids[k]  = opt_lane.some;
            element = true;
        }
        or {
            val opt_member: opt[Type] = spirv_types.member_of(e.u, ty, k);
            ids[k] = NONE;
            if (sel opt_member.some) {
                if (from != NONE && whole.null) { ids[k] = spirv_types.null(e.u, spirv_types.type_of(e.u, opt_member.some, spirv_types.PLAIN)); }
            }
        }
        k = k + 1;
    }
    if (!element) {
        if (from == NONE) { ret opt[u32].none{}; }
        ret opt[u32].some{whole.id};
    }
    k = 0;
    for (k < n::u32) {
        if (ids[k] == NONE) { ret opt[u32].none{}; }
        k = k + 1;
    }
    val id:    u32     = unit.fresh(e.u);
    var slots: [3]Slot = [3]Slot{Slot.id{spirv_types.type_of(e.u, ty, spirv_types.PLAIN)}, Slot.id{id}, Slot.list{unit.list(e.u, ?ids[0], n::usize)}};
    unit.put(e.u, buffer.TYPES, gen_row_index.OPCONSTANTCOMPOSITE, ?slots[0], 3);
    ret opt[u32].some{id};
}

# the constant a whole write gives a slot
# ---
# id:   the constant
# null: whether a fill of zero wrote it, whose elements are null constants a
#       store may replace one of
rec Whole {
    id:   u32;
    null: bool;
}

# the constant a write of a whole slot of type `ty` gives it: a fill of zero
# its null constant, a copy of a module-scope `val` that `val`'s value, and a
# copy of another slot what that slot holds there
fun whole_constant(e: *Emitter, ud: *InstructionData, ty: Type, u: Instruction, depth: u32) opt[Whole] {
    if (ud.opcode == table.MEM_FILL) {
        val opt_byte: opt[u64] = constant_bits(e, ud.operands.data[1]);
        if (sel opt_byte.none)  { ret opt[Whole].none{}; }
        if (opt_byte.some != 0) { ret opt[Whole].none{}; }
        ret opt[Whole].some{Whole{id: spirv_types.null(e.u, spirv_types.type_of(e.u, ty, spirv_types.PLAIN)), null: true}};
    }
    val src: Value = ud.operands.data[1];
    val sd:  Def   = e.b.values.data[src].def;
    if (sel sd.result) {
        val opt_held: opt[u32] = slot_constant(e, src, u, depth + 1);
        if (sel opt_held.none) { ret opt[Whole].none{}; }
        ret opt[Whole].some{Whole{id: opt_held.some, null: false}};
    }
    if (!(sel sd.constant)) { ret opt[Whole].none{}; }
    val opt_global: opt[Global] = constant_global(e, sd.constant);
    if (sel opt_global.none) { ret opt[Whole].none{}; }
    val opt_id: opt[u32] = global_constant(e, opt_global.some);
    if (sel opt_id.none) { ret opt[Whole].none{}; }
    ret opt[Whole].some{Whole{id: opt_id.some, null: false}};
}

# the role of param `k` of the params an enumerant value brings, a constant
# where the member bringing it is one of `constants`, as an image's
# ConstOffset brings a constant offset
fun param_role(en: *mo.Enumeration, value: u32, k: u32, constants: u32) Role {
    if (!en.mask || (value & constants) == 0) { ret Role.value{}; }
    var seen: u32 = 0;
    var bit:  u32 = 0;
    for (bit < 32) {
        val b: u32 = (1::u32) << bit;
        if ((value & b) != 0) {
            seen = seen + mo.param_count(en, b);
            if (k < seen) {
                if ((b & constants) != 0) { ret Role.constant{}; }
                ret Role.value{};
            }
        }
        bit = bit + 1;
    }
    ret Role.value{};
}

# what operand `j` of a row, by its index among the row's operands, is to the
# order the row states
fun role_of(r: *mrow.Row, j: u32) Role {
    val o: me.Order = r.effect.order;
    val n: u32      = j + 1;
    if (n == o.scope::u32)                            { ret Role.scope{}; }
    if (n == o.semantics::u32 || n == o.failure::u32) { ret Role.semantics{}; }
    if (n == o.execution::u32)                        { ret Role.execution{}; }
    ret Role.value{};
}

# a target op: an extended op is OpExtInst of its op's row, its result type
# and result, the import of its set, made once, and then its own operands;
# an own op is its row's instruction, its result type and result where the
# row gives a result, and then its own operands. the own operands are as the
# row states them, a variadic one as a list and an optional one left out as
# none. the row's requirement is the module's to declare, as every row's is
fun targeted(e: *Emitter, i: Instruction, d: *InstructionData) {
    var o: *Op = nil;
    if (d.immediates.len > 0) {
        val imm: Immediate = d.immediates.data[0];
        if (sel imm.op) { o = imm.op; }
    }
    val held: Ops = e.u.t.caps.ops;
    if (o == nil || d.results.len > 1) {
        emitter.unselected(e, i);
        ret;
    }
    if (!(sel held.catalog)) {
        emitter.unselected(e, i);
        ret;
    }
    val c:       *Catalog    = held.catalog;
    val opt_set: opt[*OpSet] = op_set(c, o.set);
    if (sel opt_set.none) {
        emitter.unselected(e, i);
        ret;
    }
    val s:         *OpSet         = opt_set.some;
    val opt_found: opt[*mrow.Row] = op_row(c, s, o.name);
    if (sel opt_found.none) {
        emitter.unselected(e, i);
        ret;
    }
    val r:     *mrow.Row           = opt_found.some;
    val typed: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, r.index);
    val lead:  u32                 = supplies(s, r);
    var t:     u32                 = 0;
    var into:  u32                 = 0;
    var addr:  u32                 = NONE;
    if (d.results.len == 1) {
        val v: Value = d.results.data[0];
        if (spirv_types.physical(e.u, emitter.value_type(e, v)) && pointed(typed, typing.RESULT) == typing.PHYSICAL) {
            t    = spirv_types.physical_pointer(e.u, word(e), emitter.at(e, i));
            addr = e.ids.data[v];
            into = emitter.fresh(e);
        }
        or (spirv_types.pointer(e.u, emitter.value_type(e, v))) {
            val opt_texel:   opt[Pointer] = texel_pointer(e, i, d, typed, lead, v);
            var opt_pointer: opt[Pointer] = opt_texel;
            if (!(sel opt_texel.some)) { opt_pointer = chain_pointer(e, i, d, typed, lead, v); }
            if (!ok(e))                { ret; }
            if (sel opt_pointer.none) {
                emitter.unselected(e, i);
                ret;
            }
            e.pointers.data[v] = opt_pointer.some;
            t                  = access.pointer_type(e, opt_pointer.some);
            if (signed_slot(e, i, d, typed, lead, typing.RESULT)) { t = spirv_types.pointer_type(e.u, schema.IMAGE::u32, signed_of(e, opt_pointer.some.pointee)); }
        }
        or                { t = emitter.type_id(e, v); }
        if (addr == NONE) { into = e.ids.data[v]; }
    }
    or (sel s.form.extended) {
        t    = spirv_types.void(e.u);
        into = emitter.fresh(e);
    }
    var truth: Truth = Truth{held: false, t: 0, into: 0};
    if (d.results.len == 1 && truth_slot(typed, typing.RESULT)) {
        if (!spirv_types.boolean(e.u, emitter.value_type(e, d.results.data[0]))) {
            val n: u32 = spirv_types.lanes_of(e.u, emitter.value_type(e, d.results.data[0]));
            truth = Truth{held: true, t: t, into: into};
            t     = spirv_types.bool_type(e.u);
            if (n > 1) { t = spirv_types.vector_type(e.u, t, n); }
            into = emitter.fresh(e);
        }
    }
    var texels: Truth = Truth{held: false, t: 0, into: 0};
    if (d.results.len == 1 && !truth.held && !spirv_types.pointer(e.u, emitter.value_type(e, d.results.data[0]))) {
        val rty: Type = emitter.value_type(e, d.results.data[0]);
        if (signed_slot(e, i, d, typed, lead, typing.RESULT)) {
            texels = Truth{held: true, t: t, into: into};
            t      = signed_of(e, rty);
            into   = emitter.fresh(e);
        }
        or (resident(e, d, typed, lead, rty)) {
            texels = Truth{held: true, t: t, into: into};
            t      = resident_type(e, rty);
            into   = emitter.fresh(e);
        }
    }
    var slots: vector.Vector[Slot] = vector.init[Slot](e.u.a);
    fin { vector.dnit[Slot](?slots); }
    var listed: vector.Vector[Slot] = vector.init[Slot](e.u.a);
    fin { vector.dnit[Slot](?listed); }
    if (sel s.form.extended) {
        push_slot(e, ?slots, Slot.id{t});
        push_slot(e, ?slots, Slot.id{into});
        push_slot(e, ?slots, Slot.id{unit.import_of(e.u, o.set)});
    }
    or {
        val values: me.Values = r.effect.values;
        if (values.defines == 0 && d.results.len != 0) {
            emitter.unselected(e, i);
            ret;
        }
        var n: u32 = 0;
        for (n < lead) {
            if (n + 1 == values.type::u32)    { push_slot(e, ?slots, Slot.id{t}); }
            or (n + 1 == values.defines::u32) { push_slot(e, ?slots, Slot.id{into}); }
            or {
                emitter.unselected(e, i);
                ret;
            }
            n = n + 1;
        }
    }
    var taken:   usize    = 0;
    var brought: Bringing = Bringing{operand: 0, value: 0, brings: 0, chosen: false, constants: 0};
    if (sel typed.some) { brought.constants = typed.some.image.constants; }
    var j: u32 = lead;
    for (j < r.operands.len && ok(e)) {
        val x: *mo.Operand = ?r.operands.at[j];
        if (x.quantity == mo.VARIADIC) {
            vector.truncate[Slot](?listed, 0);
            for (taken < d.operands.len && ok(e)) { push_slot(e, ?listed, op_operand(e, i, d, x, Role.value{}, ?taken, ?brought)); }
            push_slot(e, ?slots, Slot.list{unit.slots(e.u, listed.data, listed.len)});
        }
        or (taken >= d.operands.len) { push_slot(e, ?slots, Slot.none{}); }
        or {
            val passed:       usize             = taken;
            val ordered:      Role              = role_of(r, j);
            var role:         Role              = ordered;
            val opt_constant: opt[*typing.Form] = constant_form(e, i, d, typed, lead, j::u8);
            # a scope or semantics operand is a constant already, and keeps the rules its role holds it to
            if (sel opt_constant.some) {
                if (sel ordered.value) { role = Role.constant{}; }
            }
            var s: Slot = op_operand(e, i, d, x, role, ?taken, ?brought);
            if (sel opt_constant.some) {
                if (ok(e) && passed < d.operands.len) { constant_value(e, i, opt_constant.some, d.operands.data[passed], passed); }
            }
            if (ok(e) && passed < d.operands.len)         { pointer_kind(e, i, typed, j::u8, d.operands.data[passed], passed); }
            if (ok(e) && passed < d.operands.len)         { s = typed_address(e, i, d, typed, lead, j, d.operands.data[passed], s); }
            if (truth_slot(typed, j::u8))                 { push_slot(e, ?slots, truthful(e, d.operands.data[passed], s)); }
            or (signed_slot(e, i, d, typed, lead, j::u8)) { push_slot(e, ?slots, signed_operand(e, d.operands.data[passed], s)); }
            or                                            { push_slot(e, ?slots, s); }
        }
        j = j + 1;
    }
    if (!ok(e)) { ret; }
    # an argument past every operand is one no value the call passes brings
    if (taken < d.operands.len && brought.chosen) {
        val left: u32 = (d.operands.len - taken)::u32;
        emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: brought.operand}, value: brought.value, why: Unadmitted.brought{Brought{brings: brought.brings, passed: brought.brings + left}}}});
        ret;
    }
    if (taken < d.operands.len) {
        emitter.unselected(e, i);
        ret;
    }
    if (sel typed.some) {
        presence(e, i, d, typed.some, lead);
        if (!ok(e)) { ret; }
        alike(e, i, d, typed.some, lead);
        if (!ok(e)) { ret; }
        indexed(e, i, d, typed.some, lead);
        if (!ok(e)) { ret; }
        typed_need(e, i, d, typed.some, lead);
        if (!ok(e)) { ret; }
        imaged(e, i, d, typed.some, lead);
        if (!ok(e)) { ret; }
        coherent_texels(e, d, typed.some, lead, r, ?slots);
    }
    emitter.put(e, r.index, slots.data, slots.len);
    if (truth.held) {
        val rty: Type = emitter.value_type(e, d.results.data[0]);
        emitter.three(e, gen_row_index.OPSELECT, truth.t, truth.into, into, splat(e, rty, 1), splat(e, rty, 0));
    }
    if (texels.held)  { received(e, emitter.value_type(e, d.results.data[0]), texels, t, into); }
    if (addr != NONE) { emitter.one(e, gen_row_index.OPBITCAST, spirv_types.address_type(e.u), addr, into); }
    confined(e, i, d);
}

# the 32-bit integer, which a physical pointer an instruction reads nothing through points to, as it must point to
# some type and every module holds that one
fun word(e: *Emitter) Type {
    val res_word: res[Type, type_table.Error] = type_table.intern(?e.u.m.types, type_table.Shape.integer{type_table.Integer{width: 32}});
    if (sel res_word.err) { ret 0; }
    ret res_word.ok;
}

# the kind of pointer masc's typing of a row holds slot `slot` to where the row reads and writes nothing through it,
# typing.VALUE for a slot it holds to none
fun pointed(typed: opt[*typing.Typing], slot: u8) typing.Pointed {
    if (sel typed.none) { ret typing.VALUE; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        if (tg.forms[k].slot == slot) { ret tg.forms[k].pointer; }
        k = k + 1;
    }
    ret typing.VALUE;
}

# a pointer argument held to the kind its slot takes: an address where the slot takes a physical pointer, and where the
# instruction compares it, a logical pointer into StorageBuffer memory under VariablePointersStorageBuffer or Workgroup
# memory under VariablePointers, never a physical one (spir-v 1.6, 2.16.1, logical addressing and physical storage
# buffer)
fun pointer_kind(e: *Emitter, i: Instruction, typed: opt[*typing.Typing], slot: u8, v: Value, at: usize) {
    val want: typing.Pointed = pointed(typed, slot);
    val ty:   Type           = emitter.value_type(e, v);
    if (want == typing.VALUE) { ret; }
    val operand: Operand = Operand{at: emitter.at(e, i), operand: at::u32};
    if (spirv_types.physical(e.u, ty)) {
        if (want == typing.COMPARED) { emitter.fail(e, Error.signature{Admits{operand: operand, admits: "a logical pointer into StorageBuffer or Workgroup memory, because no instruction compares a pointer into PhysicalStorageBuffer (spir-v 1.6, 2.16.1)"}}); }
        ret;
    }
    if (!spirv_types.pointer(e.u, ty)) { ret; }
    if (want == typing.PHYSICAL) {
        emitter.fail(e, Error.signature{Admits{operand: operand, admits: "a physical pointer, an address in PhysicalStorageBuffer memory, where this pointer is logical and has no address"}});
        ret;
    }
    if (want != typing.COMPARED) { ret; }
    val opt_pointer_of: opt[Pointer] = access.pointer_of(e, v, i);
    if (sel opt_pointer_of.none) { ret; }
    val class: u32 = opt_pointer_of.some.class;
    if (class::u64 == schema.STORAGE_BUFFER) {
        unit.need(e.u, gen_extension.VARIABLEPOINTERSSTORAGEBUFFER);
        ret;
    }
    if (class::u64 == schema.WORKGROUP) {
        unit.need(e.u, gen_extension.VARIABLEPOINTERS);
        ret;
    }
    emitter.fail(e, Error.signature{Admits{operand: operand, admits: "a pointer into StorageBuffer or Workgroup memory, the classes variable pointers compare in (spir-v 1.6, 2.16.1)"}});
}

# the pointer arguments masc's typing of a row relates as the same type held to one spir-v type: what they point to
# laid out alike, as a copy's source and target, and for pointers the row compares, one storage class too
fun alike(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) {
    var k: u32 = 0;
    for (k < tg.count && ok(e)) {
        val f: *typing.Form = ?tg.forms[k];
        k = k + 1;
        if (f.relation != typing.SAME || f.slot == typing.RESULT || f.to == typing.RESULT) { cnt; }
        if (f.slot::u32 < lead || f.to::u32 < lead)                                        { cnt; }
        val mine:   usize = (f.slot::u32 - lead)::usize;
        val theirs: usize = (f.to::u32 - lead)::usize;
        if (mine >= d.operands.len || theirs >= d.operands.len) { cnt; }
        val x: Value = d.operands.data[mine];
        val y: Value = d.operands.data[theirs];
        if (!spirv_types.pointer(e.u, emitter.value_type(e, x)) || !spirv_types.pointer(e.u, emitter.value_type(e, y))) { cnt; }
        if (spirv_types.physical(e.u, emitter.value_type(e, x)) || spirv_types.physical(e.u, emitter.value_type(e, y))) { cnt; }
        val opt_x: opt[Pointer] = access.pointer_of(e, x, i);
        if (sel opt_x.none) { ret; }
        val opt_y: opt[Pointer] = access.pointer_of(e, y, i);
        if (sel opt_y.none) { ret; }
        val operand: Operand = Operand{at: emitter.at(e, i), operand: mine::u32};
        if (f.pointer == typing.COMPARED && opt_x.some.class != opt_y.some.class) {
            emitter.fail(e, Error.signature{Admits{operand: operand, admits: "a pointer into the storage class of the pointer it is compared with"}});
            ret;
        }
        if (spirv_types.type_of(e.u, opt_x.some.pointee, opt_x.some.key) != spirv_types.type_of(e.u, opt_y.some.pointee, opt_y.some.key)) {
            emitter.fail(e, Error.signature{Admits{operand: operand, admits: "a pointer to the same type as the other pointer, laid out alike, because memory a binding holds keeps an explicit layout and a variable's has none"}});
            ret;
        }
    }
}

# the values of a variadic literal masc's typing of a row says index the components of other operands, each held under
# their components together, a value of all ones indexing none (spir-v 1.6, OpVectorShuffle)
fun indexed(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) {
    var k: u32 = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        k = k + 1;
        if (f.within == 0 || f.slot == typing.RESULT || f.slot::u32 < lead) { cnt; }
        var total: u64 = 0;
        var n:     u32 = lead;
        for (n < 32) {
            if ((f.within & ((1::u32) << n)) != 0 && (n - lead)::usize < d.operands.len) { total = total + spirv_types.lanes_of(e.u, emitter.value_type(e, d.operands.data[(n - lead)::usize]))::u64; }
            n = n + 1;
        }
        var at: usize = (f.slot::u32 - lead)::usize;
        for (at < d.operands.len) {
            val opt_bits: opt[u64] = constant_bits(e, d.operands.data[at]);
            if (sel opt_bits.some) {
                val b: u64 = opt_bits.some;
                if (b != 0xFFFF_FFFF && b >= total) {
                    emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at::u32}, value: b::u32, why: Unadmitted.outside{"the index of a component of the vectors it selects from, counted across them in order, or 0xFFFFFFFF for an undefined component (spir-v 1.6, OpVectorShuffle)"}}});
                    ret;
                }
            }
            at = at + 1;
        }
    }
}

# the pointer a row's pointer result is where masc's typing of the row relates it to an index chain: a pointer into the
# storage class of its base to the type the call's indexes reach in what the base points to, a structure's member named
# by a constant (spir-v 1.6, OpAccessChain). none for any other row, and a base that is a physical pointer is refused,
# as it is an address that carries no type for the indexes to step through
fun chain_pointer(e: *Emitter, i: Instruction, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, v: Value) opt[Pointer] {
    if (sel typed.none) { ret opt[Pointer].none{}; }
    val tg:   *typing.Typing = typed.some;
    var base: u32            = NONE;
    var k:    u32            = 0;
    for (k < tg.count) {
        if (tg.forms[k].slot == typing.RESULT && tg.forms[k].relation == typing.CHAIN && tg.forms[k].to::u32 >= lead) { base = tg.forms[k].to::u32 - lead; }
        k = k + 1;
    }
    if (base == NONE || base::usize >= d.operands.len) { ret opt[Pointer].none{}; }
    val b: Value = d.operands.data[base::usize];
    if (!spirv_types.pointer(e.u, emitter.value_type(e, b))) { ret opt[Pointer].none{}; }
    val opt_base: opt[Pointer] = access.pointer_of(e, b, i);
    if (sel opt_base.none) { ret opt[Pointer].none{}; }
    if (opt_base.some.address) {
        emitter.fail(e, Error.signature{Admits{operand: Operand{at: emitter.at(e, i), operand: base}, admits: "a logical pointer, such as a variable's or a member's address, because a physical pointer carries no type for the indexes to step through"}});
        ret opt[Pointer].none{};
    }
    var pointee: Type = opt_base.some.pointee;
    var key:     u32  = opt_base.some.key;
    var at:      u32  = base + 1;
    for (at::usize < d.operands.len) {
        val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, pointee);
        if (sel res_shape.err) {
            emitter.unselected(e, i);
            ret opt[Pointer].none{};
        }
        val sh:         type_table.Shape = res_shape.ok;
        var opt_member: opt[Type]        = opt[Type].none{};
        if (sel sh.structure) {
            val opt_bits: opt[u64] = constant_bits(e, d.operands.data[at::usize]);
            if (sel opt_bits.none) {
                emitter.fail(e, Error.not_constant{Operand{at: emitter.at(e, i), operand: at}});
                ret opt[Pointer].none{};
            }
            if (opt_bits.some >= sh.structure.members.size::u64) {
                emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at}, value: opt_bits.some::u32, why: Unadmitted.outside{"the index of a member of the structure the indexes before it reach"}}});
                ret opt[Pointer].none{};
            }
            opt_member = opt[Type].some{sh.structure.members.data[opt_bits.some::usize]};
        }
        or (sel sh.array)  { opt_member = opt[Type].some{sh.array.element}; }
        or (sel sh.vector) { opt_member = opt[Type].some{sh.vector.element}; }
        if (sel opt_member.none) {
            emitter.fail(e, Error.signature{Admits{operand: Operand{at: emitter.at(e, i), operand: at}, admits: "no index, as the indexes before it reach a scalar, which has no members"}});
            ret opt[Pointer].none{};
        }
        pointee = opt_member.some;
        key     = spirv_types.member_key(key);
        at      = at + 1;
    }
    ret opt[Pointer].some{Pointer{id: e.ids.data[v], pointee: pointee, key: key, class: opt_base.some.class, known: true, declared: false, scope: opt_base.some.scope}};
}

# a physical pointer a call passes for a pointer operand, as the PhysicalStorageBuffer pointer to
# the type the row's typing relates the operand to, made of its address as an access makes one,
# or to a 32-bit integer where the typing holds it a pointer the row reads nothing through. any
# other operand the typing relates to no type has no pointee to point to, and is refused
fun typed_address(e: *Emitter, i: Instruction, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, slot: u32, v: Value, s: Slot) Slot {
    val ty: Type = emitter.value_type(e, v);
    if (!spirv_types.physical(e.u, ty)) { ret s; }
    val opt_related: opt[Type] = pointee_of(e, d, typed, lead, slot);
    var opt_pointee: opt[Type] = opt_related;
    if (!(sel opt_related.some) && pointed(typed, slot::u8) != typing.VALUE) { opt_pointee = opt[Type].some{word(e)}; }
    if (sel opt_pointee.none) {
        emitter.fail(e, Error.untyped{ty});
        ret Slot.none{};
    }
    val opt_pointer_of: opt[Pointer] = access.pointer_of(e, v, i);
    if (sel opt_pointer_of.none) { ret Slot.none{}; }
    val opt_typed: opt[Pointer] = access.typed(e, opt_pointer_of.some, opt_pointee.some, i);
    if (sel opt_typed.none) { ret Slot.none{}; }
    ret Slot.id{opt_typed.some.id};
}

# the type of the value a call passes or gives for a row slot, none for a slot it passes nothing for
fun slot_type(e: *Emitter, d: *InstructionData, lead: u32, slot: u8) opt[Type] {
    if (slot == typing.RESULT) {
        if (d.results.len == 0) { ret opt[Type].none{}; }
        ret opt[Type].some{emitter.value_type(e, d.results.data[0])};
    }
    if (slot::u32 < lead || (slot::u32 - lead)::usize >= d.operands.len) { ret opt[Type].none{}; }
    ret opt[Type].some{emitter.value_type(e, d.operands.data[(slot::u32 - lead)::usize])};
}

# the type a pointer slot points to, by the row's typing: the type of the slot its form is the
# same as, or of a slot whose form gives its pointee, as an atomic's result is its pointee, or
# the scalar or vector its own form states, as Frexp's exponent is an i32 with as many lanes as
# its value
fun pointee_of(e: *Emitter, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, slot: u32) opt[Type] {
    if (sel typed.none) { ret opt[Type].none{}; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        if (f.relation == typing.SAME && f.slot::u32 == slot) { ret slot_type(e, d, lead, f.to); }
        if (gives_pointee(f, slot))                           { ret slot_type(e, d, lead, f.slot); }
        k = k + 1;
    }
    k = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        if (f.slot::u32 == slot && f.bits != 0) { ret formed(e, d, lead, f); }
        k = k + 1;
    }
    ret opt[Type].none{};
}

# whether form `f` makes its slot's type the type pointer slot `pointer` points to, as an atomic's value is
# what its pointer points to, an integer's signedness aside
pub fun gives_pointee(f: *typing.Form, pointer: u32) bool {
    ret typing.typed_as(f.relation) && f.to::u32 == pointer && f.slot::u32 != pointer;
}

# the scalar or vector a form states whole: its class and width, and its lanes or those of the
# slot it has as many lanes as
fun formed(e: *Emitter, d: *InstructionData, lead: u32, f: *typing.Form) opt[Type] {
    var lanes: u32 = f.lanes::u32;
    if (f.relation == typing.LANES) {
        val opt_other: opt[Type] = slot_type(e, d, lead, f.to);
        if (sel opt_other.none) { ret opt_other; }
        lanes = spirv_types.lanes_of(e.u, opt_other.some);
    }
    var shape: type_table.Shape = type_table.Shape.integer{type_table.Integer{width: f.bits::u32}};
    if (f.class == typing.FLOAT) {
        if (f.bits == 16) { shape = type_table.Shape.float{type_table.Float{format: format.BINARY16}}; }
        or (f.bits == 32) { shape = type_table.Shape.float{type_table.Float{format: format.BINARY32}}; }
        or (f.bits == 64) { shape = type_table.Shape.float{type_table.Float{format: format.BINARY64}}; }
        or                { ret opt[Type].none{}; }
    }
    or (f.class != typing.INTEGER && f.class != typing.SIGNED && f.class != typing.UNSIGNED) { ret opt[Type].none{}; }
    val res_scalar: res[Type, type_table.Error] = type_table.intern(?e.u.m.types, shape);
    if (sel res_scalar.err) { ret opt[Type].none{}; }
    if (lanes <= 1)         { ret opt[Type].some{res_scalar.ok}; }
    val res_vector: res[Type, type_table.Error] = type_table.intern(?e.u.m.types, type_table.Shape.vector{type_table.Vector{lanes: lanes, element: res_scalar.ok}});
    if (sel res_vector.err) { ret opt[Type].none{}; }
    ret opt[Type].some{res_vector.ok};
}

# the pointer a row's pointer result is, where masc's typing of the row relates
# its result to the texel of an image: a pointer into the Image class to the
# image's texel scalar, as OpImageTexelPointer makes, none for any other row
fun texel_pointer(e: *Emitter, i: Instruction, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, v: Value) opt[Pointer] {
    if (sel typed.none) { ret opt[Pointer].none{}; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        if (f.slot == typing.RESULT && f.relation == typing.TEXEL && f.to::u32 >= lead) {
            val at: usize = (f.to::u32 - lead)::usize;
            if (at >= d.operands.len) { ret opt[Pointer].none{}; }
            val image: Value = d.operands.data[at];
            if (!spirv_types.pointer(e.u, emitter.value_type(e, image))) { ret opt[Pointer].none{}; }
            val opt_image: opt[Pointer] = access.pointer_of(e, image, i);
            if (sel opt_image.none) { ret opt[Pointer].none{}; }
            val opt_texel: opt[Type] = texel_type(e, opt_image.some.pointee);
            if (sel opt_texel.none) { ret opt[Pointer].none{}; }
            ret opt[Pointer].some{Pointer{id: e.ids.data[v], pointee: opt_texel.some, key: spirv_types.PLAIN, class: schema.IMAGE::u32, known: true, declared: false, scope: opt[u32].none{}}};
        }
        k = k + 1;
    }
    ret opt[Pointer].none{};
}

# the texel scalar of the image `ty` is, its Sampled Type
fun texel_type(e: *Emitter, ty: Type) opt[Type] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, ty);
    if (sel res_shape.err) { ret opt[Type].none{}; }
    val sh: type_table.Shape = res_shape.ok;
    if (!(sel sh.handle))                                          { ret opt[Type].none{}; }
    if (!handle_kind_is(sh, IMAGE) || sh.handle.operands.size < 1) { ret opt[Type].none{}; }
    ret type_table.operand_type(sh.handle.operands.data[0]);
}

# the execution models masc's typing states instruction `d` executes in, none
# for an instruction that is no target op or whose row states no models
pub fun executes_in(u: *Unit, d: *InstructionData) opt[*typing.Executes] {
    if (!table.target_op(d.opcode) || d.immediates.len == 0) { ret opt[*typing.Executes].none{}; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.op)) { ret opt[*typing.Executes].none{}; }
    val held: Ops = u.t.caps.ops;
    if (!(sel held.catalog)) { ret opt[*typing.Executes].none{}; }
    val opt_set: opt[*OpSet] = op_set(held.catalog, imm.op.set);
    if (sel opt_set.none) { ret opt[*typing.Executes].none{}; }
    val opt_row: opt[*mrow.Row] = op_row(held.catalog, opt_set.some, imm.op.name);
    if (sel opt_row.none) { ret opt[*typing.Executes].none{}; }
    val typed: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, opt_row.some.index);
    if (sel typed.none)                  { ret opt[*typing.Executes].none{}; }
    if (typed.some.executes.models == 0) { ret opt[*typing.Executes].none{}; }
    ret opt[*typing.Executes].some{?typed.some.executes};
}

# whether execution model `model` is one of the models `x` names
pub fun executes(x: *typing.Executes, model: u64) bool {
    ret model < 32 && (x.models & ((1::u32) << model::u32)) != 0;
}

# a row's result received as a truth value: the integer type and id the call's
# result has, which the boolean the row makes is selected into as 1 or 0
# ---
# held: whether the row's result is a truth value the call receives as an integer
# t:    the integer's type
# into: the call's result
rec Truth {
    held: bool;
    t:    u32;
    into: u32;
}

# the form of masc's typing of a row that asks slot `slot` be a constant in this call: in every version before the
# one its until names, and where it names Dims, where the call's image has one of them
fun constant_form(e: *Emitter, i: Instruction, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, slot: u8) opt[*typing.Form] {
    if (sel typed.none) { ret opt[*typing.Form].none{}; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        if (f.slot == slot && f.constant) {
            if (f.until != typing.NO_VERSION && core_state.holds(?e.u.b.basis.context, f.until)) { ret opt[*typing.Form].none{}; }
            if (f.dims != 0) {
                val opt_words: opt[ImageWords] = call_image(e, i, d, tg, lead);
                if (sel opt_words.none)                             { ret opt[*typing.Form].none{}; }
                if ((f.dims & (1::u32 << opt_words.some.dim)) == 0) { ret opt[*typing.Form].none{}; }
            }
            ret opt[*typing.Form].some{f};
        }
        k = k + 1;
    }
    ret opt[*typing.Form].none{};
}

# a constant argument held to the value its form asks, zero in every component or a power of two, refused naming
# the argument where it is not
fun constant_value(e: *Emitter, i: Instruction, f: *typing.Form, v: Value, at: usize) {
    if (f.value == typing.ZERO) {
        val opt_lane: opt[u64] = nonzero(e, v);
        if (sel opt_lane.some) {
            emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at::u32}, value: opt_lane.some::u32, why: Unadmitted.outside{"a constant of zero in every component, as a SubpassData image's coordinate (0, 0) (vulkan's VUID-StandaloneSpirv-SubpassData-04660)"}}});
        }
        ret;
    }
    if (f.value == typing.POWER) {
        val opt_bits: opt[u64] = constant_bits(e, v);
        if (sel opt_bits.none) { ret; }
        val b: u64 = opt_bits.some;
        if (b == 0 || (b & (b - 1)) != 0) {
            emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: at::u32}, value: b::u32, why: Unadmitted.outside{"a constant power of two, at least 1, as a ClusterSize (spir-v 1.6, the clustered group operations)"}}});
        }
    }
}

# whether masc's typing of a row holds slot `slot` a truth value
fun truth_slot(typed: opt[*typing.Typing], slot: u8) bool {
    if (sel typed.none) { ret false; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        if (tg.forms[k].slot == slot) { ret tg.forms[k].class == typing.TRUTH; }
        k = k + 1;
    }
    ret false;
}

# an integer argument passed where its row takes a truth value, as the boolean
# true where it is nonzero
fun truthful(e: *Emitter, v: Value, s: Slot) Slot {
    if (!(sel s.id)) { ret s; }
    val ty: Type = emitter.value_type(e, v);
    if (spirv_types.boolean(e.u, ty)) { ret s; }
    var bt: u32 = spirv_types.bool_type(e.u);
    val n:  u32 = spirv_types.lanes_of(e.u, ty);
    if (n > 1) { bt = spirv_types.vector_type(e.u, bt, n); }
    val r: u32 = emitter.fresh(e);
    emitter.two(e, gen_row_index.OPINOTEQUAL, bt, r, s.id, splat(e, ty, 0));
    ret Slot.id{r};
}

# a row's optional operand an enumerant value brings, passed exactly where the
# call passes that value, and a constant where the row asks one, as a
# subgroup operation's ClusterSize follows ClusteredReduce alone
fun presence(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) {
    val p: typing.Presence = tg.present;
    if (p.operand == typing.ABSENT || p.when::u32 < lead || p.operand::u32 < lead) { ret; }
    val when: usize = (p.when::u32 - lead)::usize;
    val at:   usize = (p.operand::u32 - lead)::usize;
    if (when >= d.operands.len) { ret; }
    val opt_value: opt[u64] = constant_bits(e, d.operands.data[when]);
    if (sel opt_value.none) { ret; }
    val brings: bool = opt_value.some == p.value::u64;
    val passed: bool = at < d.operands.len;
    if (brings != passed) {
        var count: u32 = 0;
        if (brings) { count = 1; }
        var given: u32 = 0;
        if (passed) { given = 1; }
        emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: when::u32}, value: opt_value.some::u32, why: Unadmitted.brought{Brought{brings: count, passed: given}}}});
        ret;
    }
    if (passed && p.constant) {
        val opt_held: opt[u64] = constant_bits(e, d.operands.data[at]);
        if (sel opt_held.none) { emitter.fail(e, Error.not_constant{Operand{at: emitter.at(e, i), operand: at::u32}}); }
    }
}

# whether an atomic may operate on memory of storage class `c`: buffer memory,
# workgroup memory or an image texel (VUID-StandaloneSpirv-None-04686)
fun atomic_class(c: u32) bool {
    val k: u64 = c::u64;
    ret k == schema.UNIFORM || k == schema.STORAGE_BUFFER || k == schema.PHYSICAL_STORAGE_BUFFER || k == schema.WORKGROUP || k == schema.IMAGE;
}

# what a typed row needs for the type of its data operand, the type it points
# to where it is a pointer, or of its result, which the row's own requirement does not state: a
# 64-bit integer atomic Int64Atomics, a dot product the input capability its
# operand's shape needs, met the first way the build holds
fun typed_need(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) {
    if (tg.data == typing.ABSENT) { ret; }
    if (tg.data == typing.RESULT) {
        if (d.results.len > 0) { typed_kind(e, tg, emitter.value_type(e, d.results.data[0])); }
        ret;
    }
    if (tg.data::u32 < lead) { ret; }
    val at: usize = (tg.data::u32 - lead)::usize;
    if (at >= d.operands.len) { ret; }
    val v:    Value = d.operands.data[at];
    var held: Type  = emitter.value_type(e, v);
    if (spirv_types.pointer(e.u, held)) {
        val opt_pointer_of: opt[Pointer] = access.pointer_of(e, v, i);
        if (sel opt_pointer_of.none) { ret; }
        if (!atomic_class(opt_pointer_of.some.class)) {
            emitter.fail(e, Error.atomic{Atomic{at: emitter.at(e, i), class: class_name(opt_pointer_of.some.class)}});
            ret;
        }
        held = opt_pointer_of.some.pointee;
    }
    typed_kind(e, tg, held);
}

# what the first of a typed row's types that holds type `held` needs
fun typed_kind(e: *Emitter, tg: *typing.Typing, held: Type) {
    var k: u32 = 0;
    for (k < tg.types) {
        val x: *typing.Typed = ?tg.typed[k];
        if (typed_holds(e, x, held)) {
            unit.keep(e.u, buffer.need(?e.u.buf, x.requires));
            ret;
        }
        k = k + 1;
    }
}

# whether typed type `x` holds type `ty`
fun typed_holds(e: *Emitter, x: *typing.Typed, ty: Type) bool {
    if (x.float != spirv_types.floating(e.u, ty))                   { ret false; }
    if (x.bits != 0 && x.bits::u32 != spirv_types.bits_of(e.u, ty)) { ret false; }
    val lanes: u32 = spirv_types.lanes_of(e.u, ty);
    if (x.lanes == 0) { ret lanes > 1; }
    ret x.lanes::u32 == lanes;
}

# a sampled image a target op makes is consumed by an image instruction in
# the block that makes it, never passed, returned, stored or carried to
# another block (spir-v 1.6, 2.16.1, universal validation rules: all
# OpSampledImage instructions are in the block their result is consumed in,
# and that result is an operand of no OpPhi, OpSelect or non-image
# instruction), so a use of it outside a target op of its block is refused
fun confined(e: *Emitter, i: Instruction, d: *InstructionData) {
    if (d.results.len != 1) { ret; }
    val v: Value = d.results.data[0];
    if (!sampled_image(e, emitter.value_type(e, v))) { ret; }
    val home: u32                  = block_of(d);
    val uses: Growing[Instruction] = e.b.values.data[v].uses;
    var k:    usize                = 0;
    for (k < uses.len) {
        val u:  Instruction      = uses.data[k];
        val ud: *InstructionData = ?e.b.instructions.data[u];
        if (!table.target_op(ud.opcode) || block_of(ud) != home) {
            emitter.fail(e, Error.flow{emitter.at(e, u)});
            ret;
        }
        k = k + 1;
    }
}

val SAMPLED_IMAGE: str = "spirv.sampled_image";
val IMAGE:         str = "spirv.image";

# the words of an image type a row reads, a sampled image's being its image's
# ---
# dim:     its Dim
# depth:   its Depth
# arrayed: its Arrayed
# ms:      its MS
# sampled: its Sampled
# format:  its Image Format
rec ImageWords {
    dim:     u32;
    depth:   u32;
    arrayed: u32;
    ms:      u32;
    sampled: u32;
    format:  u32;
}

val DIM_RECT:         u32 = 4;
val DIM_BUFFER:       u32 = 5;
val DIM_CUBE:         u32 = 3;
val DIM_SUBPASS_DATA: u32 = 6;
val FORMAT_UNKNOWN:   u32 = 0;

fun handle_kind_is(sh: type_table.Shape, kind: str) bool {
    if (!(sel sh.handle)) { ret false; }
    ret slice.order_view(sh.handle.kind, View{data: kind, len: str_len(kind)}) == 0;
}

# the words of the image `ty` is, or the image of the sampled image it is, none
# for any other type
fun image_words(e: *Emitter, ty: Type) opt[ImageWords] {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, ty);
    if (sel res_shape.err) { ret opt[ImageWords].none{}; }
    val sh: type_table.Shape = res_shape.ok;
    if (!(sel sh.handle)) { ret opt[ImageWords].none{}; }
    if (handle_kind_is(sh, SAMPLED_IMAGE) && sh.handle.operands.size >= 1) {
        val opt_inner: opt[Type] = type_table.operand_type(sh.handle.operands.data[0]);
        if (sel opt_inner.some) { ret image_words(e, opt_inner.some); }
        ret opt[ImageWords].none{};
    }
    if (!handle_kind_is(sh, IMAGE) || sh.handle.operands.size < 7) { ret opt[ImageWords].none{}; }
    var w: [6]u32;
    var k: usize = 0;
    for (k < 6) {
        val x: type_table.HandleOperand = sh.handle.operands.data[k + 1];
        if (!(sel x.word)) { ret opt[ImageWords].none{}; }
        w[k] = x.word;
        k    = k + 1;
    }
    ret opt[ImageWords].some{ImageWords{dim: w[0], depth: w[1], arrayed: w[2], ms: w[3], sampled: w[4], format: w[5]}};
}

# whether an image holds a property masc's image rules ask of it
fun holds_property(want: u8, has: bool) bool {
    if (want == typing.YES) { ret has; }
    if (want == typing.NO)  { ret !has; }
    ret true;
}

# what an image row takes of its image that the image a call passes is not,
# none where it is the image the row takes
fun image_refusal(m: *typing.Imaged, w: ImageWords) opt[str] {
    if (m.dims != 0 && (w.dim >= 32 || (m.dims & ((1::u32) << w.dim)) == 0)) { ret opt[str].some{"an image of a Dim the instruction reads"}; }
    if (m.depth && w.depth == 0)                                             { ret opt[str].some{"a depth image, whose Depth is not 0, since a depth comparison compares depth texels"}; }
    if (!holds_property(m.multisampled, w.ms == 1)) {
        if (m.multisampled == typing.YES) { ret opt[str].some{"a multisampled image, whose MS is 1"}; }
        ret opt[str].some{"a single-sampled image, whose MS is 0"};
    }
    if (!holds_property(m.arrayed, w.arrayed == 1)) {
        if (m.arrayed == typing.YES) { ret opt[str].some{"an arrayed image"}; }
        ret opt[str].some{"an image that is not arrayed"};
    }
    val levels: bool = w.ms == 0 && w.sampled == 1 && w.dim != DIM_BUFFER && w.dim != DIM_RECT;
    if (m.formats != 0 && (w.format >= 64 || (m.formats & ((1::u64) << w.format::u64)) == 0)) { ret opt[str].some{"an image of a format the instruction admits, as a texel pointer is made only into an image of R32f, R32i, R32ui, R64i or R64ui"}; }
    if (!holds_property(m.levels, levels)) {
        if (m.levels == typing.YES) { ret opt[str].some{"an image with levels of detail to choose, which is single-sampled, has Sampled 1 and has no Buffer or Rect Dim"}; }
        ret opt[str].some{"an image with no level of detail to choose, such as a multisampled image, a storage image or a texel buffer"};
    }
    ret opt[str].none{};
}

# what an image row admits of the Image Operands bits a call sets on an image
# that the bits break, none where it admits them
fun mask_refusal(m: *typing.Imaged, w: ImageWords, bits: u32) opt[str] {
    if ((bits & ~m.admits) != 0)                                    { ret opt[str].some{"the Image Operands bits the instruction takes"}; }
    if (m.one != 0 && !one_bit(bits & m.one))                       { ret opt[str].some{"exactly one of the bits the instruction requires one of, as an explicit-lod sample's Lod (0x2) and Grad (0x4)"}; }
    if ((bits & m.exclusive) != 0 && !one_bit(bits & m.exclusive))  { ret opt[str].some{"one offset bit at most, of ConstOffset (0x8), Offset (0x10) and ConstOffsets (0x20)"}; }
    if ((bits & m.paired) != 0 && (bits & m.pairing) == 0)          { ret opt[str].some{"a bit that pairs with another only beside it, as an explicit-lod sample's MinLod (0x80) only beside Grad (0x4)"}; }
    if (m.sampled != 0 && ((bits & m.sampled) != 0) != (w.ms == 1)) { ret opt[str].some{"Sample (0x40) exactly where the image is multisampled"}; }
    if ((bits & m.uncubed) != 0 && w.dim == DIM_CUBE)               { ret opt[str].some{"no offset bit on a Cube image"}; }
    ret opt[str].none{};
}

fun one_bit(x: u32) bool {
    ret x != 0 && (x & (x - 1)) == 0;
}

# an image row's call held to the image and Image Operands masc's image rules
# state for the row: the image's Dim, Depth, MS, Arrayed and levels, and the
# bits the mask sets, the image a pointer operand points to being held as the
# image itself. a call on an image of Unknown format and of no
# SubpassData Dim needs the capability the row states for it, as OpImageRead
# needs StorageImageReadWithoutFormat (spir-v 1.6, 3.3.10 image instructions)
fun imaged(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) {
    val m:         *typing.Imaged  = ?tg.image;
    val opt_words: opt[ImageWords] = call_image(e, i, d, tg, lead);
    if (sel opt_words.none) { ret; }
    val at:          usize      = (m.image::u32 - lead)::usize;
    val w:           ImageWords = opt_words.some;
    val opt_refusal: opt[str]   = image_refusal(m, w);
    if (sel opt_refusal.some) {
        emitter.fail(e, Error.image{ImageRefused{operand: Operand{at: emitter.at(e, i), operand: at::u32}, why: opt_refusal.some}});
        ret;
    }
    if (m.unformatted != typing.NO_CAPABILITY && w.format == FORMAT_UNKNOWN && w.dim != DIM_SUBPASS_DATA) { unit.need(e.u, m.unformatted); }
    if (m.mask == typing.ABSENT || m.mask::u32 < lead)                                                    { ret; }
    val mask: usize = (m.mask::u32 - lead)::usize;
    var bits: u64   = 0;
    if (mask < d.operands.len) {
        val opt_bits: opt[u64] = constant_bits(e, d.operands.data[mask]);
        if (sel opt_bits.none) { ret; }
        bits = opt_bits.some;
    }
    val opt_mask: opt[str] = mask_refusal(m, w, bits::u32);
    if (sel opt_mask.some) {
        emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: mask::u32}, value: bits::u32, why: Unadmitted.outside{opt_mask.some}}});
        ret;
    }
    if (ungathered_offset(e.u, m, bits::u32)) { emitter.fail(e, Error.operand_value{Valued{operand: Operand{at: emitter.at(e, i), operand: mask::u32}, value: bits::u32, why: Unadmitted.outside{"a ConstOffset (0x8), because a run-time Offset (0x10) outside a gather needs vulkan's maintenance8, which no vulkan version requires"}}}); }
}

# the operands of the image a call passes for its row's image operand, a pointer's being its pointee's, none where the
# row names none or the call passes no image there
fun call_image(e: *Emitter, i: Instruction, d: *InstructionData, tg: *typing.Typing, lead: u32) opt[ImageWords] {
    val m: *typing.Imaged = ?tg.image;
    if (m.image == typing.ABSENT || m.image::u32 < lead) { ret opt[ImageWords].none{}; }
    val at: usize = (m.image::u32 - lead)::usize;
    if (at >= d.operands.len) { ret opt[ImageWords].none{}; }
    var held: Type = emitter.value_type(e, d.operands.data[at]);
    if (spirv_types.pointer(e.u, held)) {
        val opt_pointer: opt[Pointer] = access.pointer_of(e, d.operands.data[at], i);
        if (sel opt_pointer.none) { ret opt[ImageWords].none{}; }
        held = opt_pointer.some.pointee;
    }
    ret image_words(e, held);
}

# the Image Operands bits of a run-time offset and of a gather's four offsets
val OFFSET:        u32 = 0x10;
val CONST_OFFSETS: u32 = 0x20;

# whether a shader module's call sets a run-time Offset on an image row that is
# no gather where its environment does not state maintenance8, which vulkan
# requires before an Offset outside OpImage*Gather (VUID-RuntimeSpirv-Offset-10213).
# a gather is a row that admits ConstOffsets, which spir-v takes only on the
# gathers (spir-v 1.6, 3.14 image operands)
fun ungathered_offset(u: *Unit, m: *typing.Imaged, bits: u32) bool {
    if ((bits & OFFSET) == 0 || (m.admits & CONST_OFFSETS) != 0)     { ret false; }
    if (!core_state.holds(?u.b.basis.context, gen_extension.SHADER)) { ret false; }
    ret !spirv_types.guaranteed(u, ?vulkan.MAINTENANCE8);
}

# whether a row's slot holds texels of an image whose Sampled Type is a signed
# integer, which the instruction then takes as that type and the program
# holds unsigned: a slot whose form relates it to the texel of such an image,
# or one of the type a texel pointer into such an image points to (spir-v
# 1.6, image instructions: a texel's component type is the Sampled Type, and
# the atomic instructions: a value's type is what its pointer points to)
fun signed_slot(e: *Emitter, i: Instruction, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, slot: u8) bool {
    if (sel typed.none) { ret false; }
    val tg: *typing.Typing = typed.some;
    var k:  u32            = 0;
    for (k < tg.count) {
        val f: *typing.Form = ?tg.forms[k];
        k = k + 1;
        if (f.slot != slot)                            { cnt; }
        if (f.to == typing.RESULT || f.to::u32 < lead) { ret false; }
        val at: usize = (f.to::u32 - lead)::usize;
        if (at >= d.operands.len) { ret false; }
        val v: Value = d.operands.data[at];
        if (f.relation == typing.TEXEL || f.relation == typing.FORMAT)                         { ret spirv_types.signed_texels(e.u, held_image(e, i, v)); }
        if (gives_pointee(f, f.to::u32) && spirv_types.pointer(e.u, emitter.value_type(e, v))) { ret texel_signed(e, i, v); }
        ret false;
    }
    ret false;
}

# the image an image operand holds, the one a pointer operand points to
fun held_image(e: *Emitter, i: Instruction, v: Value) Type {
    val ty: Type = emitter.value_type(e, v);
    if (!spirv_types.pointer(e.u, ty)) { ret ty; }
    val opt_pointer: opt[Pointer] = access.pointer_of(e, v, i);
    if (sel opt_pointer.none) { ret ty; }
    ret opt_pointer.some.pointee;
}

# whether the pointer `p` is a texel pointer into an image whose Sampled Type
# is a signed integer: the result of a target op whose typing relates its
# result to the texel of such an image. a texel pointer is never a function's
# parameter, since no call passes a pointer into the Image class (passable)
fun texel_signed(e: *Emitter, i: Instruction, p: Value) bool {
    val def: Def = e.b.values.data[p].def;
    if (!(sel def.result)) { ret false; }
    val ud:        *InstructionData = ?e.b.instructions.data[def.result.instruction];
    val opt_typed: opt[Located]     = row_typing(e.u, ud);
    if (sel opt_typed.none) { ret false; }
    ret signed_slot(e, i, ud, opt[*typing.Typing].some{opt_typed.some.typing}, opt_typed.some.lead, typing.RESULT);
}

# a target op's typing and the operands its set supplies before its own
pub rec Located {
    typing: *typing.Typing;
    lead:   u32;
}

# the typing masc states for target op `d`, none for any other instruction or
# a row with none
pub fun row_typing(u: *Unit, d: *InstructionData) opt[Located] {
    if (!table.target_op(d.opcode) || d.immediates.len == 0) { ret opt[Located].none{}; }
    val imm: Immediate = d.immediates.data[0];
    if (!(sel imm.op)) { ret opt[Located].none{}; }
    val held: Ops = u.t.caps.ops;
    if (!(sel held.catalog)) { ret opt[Located].none{}; }
    val opt_set: opt[*OpSet] = op_set(held.catalog, imm.op.set);
    if (sel opt_set.none) { ret opt[Located].none{}; }
    val opt_row: opt[*mrow.Row] = op_row(held.catalog, opt_set.some, imm.op.name);
    if (sel opt_row.none) { ret opt[Located].none{}; }
    val typed: opt[*typing.Typing] = typing.of(?gen_typing.TYPINGS[0], gen_typing.COUNT, opt_row.some.index);
    if (sel typed.none) { ret opt[Located].none{}; }
    ret opt[Located].some{Located{typing: typed.some, lead: supplies(opt_set.some, opt_row.some)}};
}

# the id of the signed integer type of the shape of the integer `ty`
fun signed_of(e: *Emitter, ty: Type) u32 {
    val s: u32 = spirv_types.signed_texel(e.u, spirv_types.bits_of(e.u, ty));
    val n: u32 = spirv_types.lanes_of(e.u, ty);
    if (n > 1) { ret spirv_types.vector_type(e.u, s, n); }
    ret s;
}

# an integer argument passed where its row takes a signed texel, reinterpreted
# as the signed integer of its shape
fun signed_operand(e: *Emitter, v: Value, s: Slot) Slot {
    if (!(sel s.id)) { ret s; }
    val r: u32 = emitter.fresh(e);
    emitter.one(e, gen_row_index.OPBITCAST, signed_of(e, emitter.value_type(e, v)), r, s.id);
    ret Slot.id{r};
}

# whether an image row's result is the residency code and the texels of an
# image whose Sampled Type is a signed integer, the structure an
# OpImageSparse instruction gives (spir-v 1.6, OpImageSparseRead: its second
# member's component type is the Sampled Type)
fun resident(e: *Emitter, d: *InstructionData, typed: opt[*typing.Typing], lead: u32, rty: Type) bool {
    if (sel typed.none) { ret false; }
    val m: *typing.Imaged = ?typed.some.image;
    if (m.image == typing.ABSENT || m.image::u32 < lead) { ret false; }
    val at: usize = (m.image::u32 - lead)::usize;
    if (at >= d.operands.len)                                                          { ret false; }
    if (spirv_types.scalar_or_vector(e.u, rty) || spirv_types.count_of(e.u, rty) != 2) { ret false; }
    val opt_texel: opt[Type] = spirv_types.member_of(e.u, rty, 1);
    if (sel opt_texel.none)                        { ret false; }
    if (spirv_types.floating(e.u, opt_texel.some)) { ret false; }
    ret spirv_types.signed_texels(e.u, emitter.value_type(e, d.operands.data[at]));
}

# the structure a resident row gives: its residency code and its texels as
# the signed integers the image holds
fun resident_type(e: *Emitter, rty: Type) u32 {
    val opt_code:  opt[Type] = spirv_types.member_of(e.u, rty, 0);
    val opt_texel: opt[Type] = spirv_types.member_of(e.u, rty, 1);
    if (sel opt_code.none)  { ret NONE; }
    if (sel opt_texel.none) { ret NONE; }
    var m: [2]u32 = [2]u32{spirv_types.type_of(e.u, opt_code.some, spirv_types.PLAIN), signed_of(e, opt_texel.some)};
    ret spirv_types.struct_of(e.u, ?m[0], 2);
}

# a row's result made as signed texels `t` into `made`, received into the
# call's result as the type the program holds: the texels reinterpreted, a
# resident row's residency code kept beside them
fun received(e: *Emitter, rty: Type, held: Truth, t: u32, made: u32) {
    if (spirv_types.scalar_or_vector(e.u, rty)) {
        emitter.one(e, gen_row_index.OPBITCAST, held.t, held.into, made);
        ret;
    }
    val opt_code:  opt[Type] = spirv_types.member_of(e.u, rty, 0);
    val opt_texel: opt[Type] = spirv_types.member_of(e.u, rty, 1);
    if (sel opt_code.none)  { ret; }
    if (sel opt_texel.none) { ret; }
    var m: [2]u32 = [2]u32{emitter.fresh(e), emitter.fresh(e)};
    val x: u32    = emitter.fresh(e);
    emitter.extract(e, spirv_types.type_of(e.u, opt_code.some, spirv_types.PLAIN), m[0], made, 0);
    emitter.extract(e, signed_of(e, opt_texel.some), x, made, 1);
    emitter.one(e, gen_row_index.OPBITCAST, spirv_types.type_of(e.u, opt_texel.some, spirv_types.PLAIN), m[1], x);
    emitter.construct(e, held.t, held.into, ?m[0], 2);
}

# the Image Operands bits that make a texel access non-private under the
# vulkan memory model
val MAKE_TEXEL_AVAILABLE: u32 = 0x100;
val MAKE_TEXEL_VISIBLE:   u32 = 0x200;
val NON_PRIVATE_TEXEL:    u32 = 0x400;

# a read of a coherent storage image under the vulkan memory model makes its
# texel visible, and a write makes it available, each non-private, at the
# QueueFamily scope, as the Coherent decoration GLSL450 writes instead states
# (spir-v 1.6, 3.14 image operands, and the vulkan memory model's
# availability and visibility). an image a function takes as a parameter is
# coherent where the module binds a coherent storage image, since no qualifier
# reaches a parameter. a call that sets the bit itself keeps its own scope
fun coherent_texels(e: *Emitter, d: *InstructionData, tg: *typing.Typing, lead: u32, r: *mrow.Row, slots: *vector.Vector[Slot]) {
    if (!spirv_types.vulkan_model(e.u)) { ret; }
    val m: *typing.Imaged = ?tg.image;
    if (m.image == typing.ABSENT || m.mask == typing.ABSENT || m.image::u32 < lead) { ret; }
    var bit: u32 = 0;
    if ((m.admits & MAKE_TEXEL_AVAILABLE) != 0) { bit = MAKE_TEXEL_AVAILABLE; }
    or ((m.admits & MAKE_TEXEL_VISIBLE) != 0)   { bit = MAKE_TEXEL_VISIBLE; }
    val at: usize = (m.image::u32 - lead)::usize;
    val k:  usize = m.mask::usize;
    if (bit == 0 || at >= d.operands.len || k >= slots.len || k >= r.operands.len::usize) { ret; }
    val v:         Value           = d.operands.data[at];
    val opt_words: opt[ImageWords] = image_words(e, emitter.value_type(e, v));
    if (sel opt_words.none)          { ret; }
    if (opt_words.some.sampled != 2) { ret; }
    if (!coherent_operand(e, v))     { ret; }
    val x: *mo.Operand = ?r.operands.at[k];
    if (!(sel x.shape.enumerant)) { ret; }
    spirv_types.scoped(e.u, spirv_types.QUEUE_FAMILY_SCOPE::u64);
    var scope: [1]Slot = [1]Slot{Slot.id{spirv_types.uint(e.u, 32, spirv_types.QUEUE_FAMILY_SCOPE::u64)}};
    val s:     Slot    = slots.data[k];
    if (sel s.none) {
        slots.data[k] = unit.enumerant_of(bit | NON_PRIVATE_TEXEL, unit.slots(e.u, ?scope[0], 1));
        ret;
    }
    if (!(sel s.enumerant))             { ret; }
    if ((s.enumerant.value & bit) != 0) { ret; }
    var en:     mo.Enumeration      = x.shape.enumerant;
    val before: u32                 = mo.param_count(?en, s.enumerant.value & (bit - 1));
    var params: vector.Vector[Slot] = vector.init[Slot](e.u.a);
    fin { vector.dnit[Slot](?params); }
    var j: u32 = 0;
    for (j < s.enumerant.params.len) {
        if (j == before) { push_slot(e, ?params, scope[0]); }
        push_slot(e, ?params, e.u.buf.slots.data[s.enumerant.params.at + j]);
        j = j + 1;
    }
    if (before >= s.enumerant.params.len) { push_slot(e, ?params, scope[0]); }
    slots.data[k] = unit.enumerant_of(s.enumerant.value | bit | NON_PRIVATE_TEXEL, unit.slots(e.u, params.data, params.len));
}

# whether an image value reaches a coherent storage image: one loaded from a
# global declared coherent, or a function's parameter in a module that binds
# a coherent storage image
fun coherent_operand(e: *Emitter, v: Value) bool {
    val def: Def = e.b.values.data[v].def;
    if (sel def.parameter) { ret e.u.images; }
    if (!(sel def.result)) { ret false; }
    val ud: *InstructionData = ?e.b.instructions.data[def.result.instruction];
    if (ud.opcode != table.LOAD || ud.operands.len == 0) { ret false; }
    val pd: Def = e.b.values.data[ud.operands.data[0]].def;
    if (!(sel pd.constant)) { ret false; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(e.u.m, pd.constant);
    if (sel res_constant_data.err) { ret false; }
    val c: ConstantData = res_constant_data.ok;
    if (!(sel c.address)) { ret false; }
    val sym: Symbol = c.address.symbol;
    if (!(sel sym.global)) { ret false; }
    ret spirv_types.coherent_image(e.u, sym.global::usize);
}

# whether `ty` is a sampled image
fun sampled_image(e: *Emitter, ty: Type) bool {
    val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?e.u.m.types, ty);
    if (sel res_shape.err) { ret false; }
    val sh: type_table.Shape = res_shape.ok;
    if (!(sel sh.handle)) { ret false; }
    ret slice.order_view(sh.handle.kind, View{data: SAMPLED_IMAGE, len: str_len(SAMPLED_IMAGE)}) == 0;
}

fun push_slot(e: *Emitter, v: *vector.Vector[Slot], s: Slot) {
    val res_pushed: res[usize, allocator.Error] = vector.push[Slot](v, s);
    if (sel res_pushed.err) { emitter.lost(e, res_pushed.err); }
}

fun lane_list(e: *Emitter, d: *InstructionData, slot: usize) opt[Slice[u32]] {
    if (slot >= d.immediates.len) { ret opt[Slice[u32]].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.lanes) { ret opt[Slice[u32]].some{imm.lanes}; }
    ret opt[Slice[u32]].none{};
}

fun index_at(d: *InstructionData, slot: usize) opt[u32] {
    if (slot >= d.immediates.len) { ret opt[u32].none{}; }
    val imm: Immediate = d.immediates.data[slot];
    if (sel imm.lane)   { ret opt[u32].some{imm.lane}; }
    if (sel imm.member) { ret opt[u32].some{imm.member}; }
    ret opt[u32].none{};
}

# a vector or aggregate made, taken apart or changed
fun composite(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32   = d.opcode;
    val r:    Value = d.results.data[0];
    val t:    u32   = emitter.type_id(e, r);
    val into: u32   = e.ids.data[r];
    if (code == table.VSPLAT || code == table.VBUILD) {
        var members: vector.Vector[u32] = vector.init[u32](e.u.a);
        fin { vector.dnit[u32](?members); }
        if (code == table.VSPLAT) {
            val lanes: u32 = spirv_types.lanes_of(e.u, emitter.value_type(e, r));
            val x:     u32 = emitter.id_of(e, d.operands.data[0]);
            var k:     u32 = 0;
            for (k < lanes) {
                push_u32(e, ?members, x);
                k = k + 1;
            }
        }
        or {
            var k: usize = 0;
            for (k < d.operands.len) {
                push_u32(e, ?members, emitter.id_of(e, d.operands.data[k]));
                k = k + 1;
            }
        }
        emitter.construct(e, t, into, members.data, members.len);
        ret;
    }
    if (code == table.VSHUFFLE) {
        val opt_lanes: opt[Slice[u32]] = lane_list(e, d, 1);
        if (sel opt_lanes.none) {
            emitter.unselected(e, i);
            ret;
        }
        var s: [5]Slot = [5]Slot{Slot.id{t}, Slot.id{into}, Slot.id{emitter.id_of(e, d.operands.data[0])}, Slot.id{emitter.id_of(e, d.operands.data[1])}, Slot.list{unit.numbers(e.u, opt_lanes.some.data, opt_lanes.some.size)}};
        emitter.put(e, gen_row_index.OPVECTORSHUFFLE, ?s[0], 5);
        ret;
    }
    val opt_index_at: opt[u32] = index_at(d, 0);
    if (sel opt_index_at.none) {
        emitter.unselected(e, i);
        ret;
    }
    if (code == table.VEXTRACT || code == table.EXTRACT) {
        emitter.extract(e, t, into, emitter.id_of(e, d.operands.data[0]), opt_index_at.some);
        ret;
    }
    var index: [1]u32  = [1]u32{opt_index_at.some};
    var s:     [5]Slot = [5]Slot{Slot.id{t}, Slot.id{into}, Slot.id{emitter.id_of(e, d.operands.data[1])}, Slot.id{emitter.id_of(e, d.operands.data[0])}, Slot.list{unit.numbers(e.u, ?index[0], 1)}};
    emitter.put(e, gen_row_index.OPCOMPOSITEINSERT, ?s[0], 5);
}

fun composite_op(code: u32) bool {
    ret code == table.VSPLAT || code == table.VBUILD || code == table.VSHUFFLE || code == table.VEXTRACT || code == table.VINSERT || code == table.EXTRACT || code == table.INSERT;
}

# whether an instruction is an operation over specialization constants
# alone, so itself one: it reads and writes no memory, branches nowhere and
# gives a result, and every operand is a constant, one at least a
# specialization constant
fun specializes(e: *Emitter, d: *InstructionData) bool {
    if (d.results.len == 0 || d.operands.len == 0 || d.edges.len != 0) { ret false; }
    val opt_opcode_at: opt[*opcode_row.Row] = table.at(d.opcode);
    if (sel opt_opcode_at.none) { ret false; }
    val row: *opcode_row.Row = opt_opcode_at.some;
    if (row.terminator || row.effects.reads || row.effects.writes) { ret false; }
    var any: bool  = false;
    var k:   usize = 0;
    for (k < d.operands.len) {
        val v: Value = d.operands.data[k];
        val w: Def   = e.b.values.data[v].def;
        if (emitter.special(e, v)) { any = true; }
        or (!(sel w.constant))     { ret false; }
        k = k + 1;
    }
    ret any;
}

# the code of one instruction, its results in the ids they were given, among
# the module's constants for an operation over specialization constants alone
# whose every step has a form there
fun instruction(e: *Emitter, i: Instruction, d: *InstructionData) {
    if (!specializes(e, d)) {
        selected(e, i, d);
        ret;
    }
    emitter.specialize(e, i);
    selected(e, i, d);
    if (!emitter.specialized(e)) { ret; }
    var k: usize = 0;
    for (k < d.results.len) {
        e.specs.data[d.results.data[k]] = true;
        k                               = k + 1;
    }
}

# the selection of one instruction
fun selected(e: *Emitter, i: Instruction, d: *InstructionData) {
    val code: u32 = d.opcode;
    if (code == table.ALLOCA) { ret; }
    if (code == table.FUNC_ADDR) {
        if (d.results.len != 1 || !emitter.used_only(e, d.results.data[0], table.CALL, 0)) { emitter.unselected(e, i); }
        ret;
    }
    if (code == table.CALL) {
        call(e, i, d);
        ret;
    }
    if (code == table.LOAD) {
        access.load(e, i, d);
        ret;
    }
    if (code == table.STORE) {
        access.store(e, i, d);
        ret;
    }
    if (code == table.PTR_MEMBER) {
        access.member(e, i, d);
        ret;
    }
    if (code == table.PTR_INDEX) {
        access.index(e, i, d);
        ret;
    }
    if (code == table.MEM_COPY) {
        access.copy(e, i, d);
        ret;
    }
    if (code == table.MEM_FILL) {
        access.fill(e, i, d);
        ret;
    }
    if (access.atomic(code)) {
        access.atomically(e, i, d);
        ret;
    }
    if (code == table.FENCE) {
        access.fence(e, d);
        ret;
    }
    if (table.target_op(d.opcode)) {
        targeted(e, i, d);
        ret;
    }
    if (d.results.len == 0 || d.operands.len == 0) {
        emitter.unselected(e, i);
        ret;
    }
    if (code == table.PTRTOINT || code == table.INTTOPTR || code == table.PTR_ADD) {
        access.address(e, i, d);
        ret;
    }
    val r: Value = d.results.data[0];
    if (spirv_types.pointer(e.u, emitter.value_type(e, r))) {
        if (code == table.DECLASSIFY) {
            val opt_pointer_of: opt[Pointer] = access.pointer_of(e, d.operands.data[0], i);
            if (sel opt_pointer_of.none) { ret; }
            var q: Pointer = opt_pointer_of.some;
            q.id       = e.ids.data[r];
            q.declared = false;
            emitter.copy(e, access.pointer_type(e, q), q.id, opt_pointer_of.some.id);
            e.pointers.data[r] = q;
            ret;
        }
        if (code == table.SELECT) {
            emitter.fail(e, Error.variable{emitter.at(e, i)});
            ret;
        }
        emitter.unselected(e, i);
        ret;
    }
    val t:    u32   = emitter.type_id(e, r);
    val into: u32   = e.ids.data[r];
    val x:    Value = d.operands.data[0];
    if (code == table.DECLASSIFY) {
        emitter.copy(e, t, into, emitter.id_of(e, x));
        ret;
    }
    if (code == table.SELECT) {
        emitter.three(e, gen_row_index.OPSELECT, t, into, emitter.id_of(e, x), emitter.id_of(e, d.operands.data[1]), emitter.id_of(e, d.operands.data[2]));
        ret;
    }
    if (composite_op(code)) {
        composite(e, i, d);
        ret;
    }
    if (reduction(code)) {
        reduce(e, i, d);
        ret;
    }
    if (code == table.EXT_U || code == table.EXT_S || code == table.TRUNC) {
        converted(e, i, d);
        ret;
    }
    if (code == table.ITOF_S || code == table.ITOF_U) {
        floated(e, d);
        ret;
    }
    if (code == table.FTOI_S || code == table.FTOI_U) {
        saturated(e, i, d);
        ret;
    }
    if (code == table.FPROMOTE || code == table.FDEMOTE) {
        emitter.one(e, gen_row_index.OPFCONVERT, t, into, emitter.id_of(e, x));
        ret;
    }
    if (code == table.BITCAST) {
        cast(e, i, d);
        ret;
    }
    if (code == table.FCOPYSIGN) {
        copysign(e, d);
        ret;
    }
    if (code == table.BSWAP) {
        swapped(e, i, d);
        ret;
    }
    if (code == table.CLZ || code == table.CTZ || (code == table.POPCNT && !spirv_types.boolean(e.u, emitter.value_type(e, x)))) {
        counted(e, i, d);
        ret;
    }
    if (code == table.MUL_HIGH_U || code == table.MUL_HIGH_S || code == table.MUL_HIGH_SU) {
        high(e, d);
        ret;
    }
    if (code == table.ADD_OV_S || code == table.ADD_OV_U || code == table.SUB_OV_S || code == table.SUB_OV_U || code == table.MUL_OV_S || code == table.MUL_OV_U) {
        overflowed(e, i, d);
        ret;
    }
    val xt:      Type = emitter.value_type(e, x);
    val boolean: bool = spirv_types.boolean(e.u, xt);
    val v:       u32  = emitter.id_of(e, x);
    if (code == table.NOT) {
        if (boolean) { emitter.one(e, gen_row_index.OPLOGICALNOT, t, into, v); }
        or           { emitter.one(e, gen_row_index.OPNOT, t, into, v); }
        ret;
    }
    if (code == table.NEG && !boolean) {
        emitter.one(e, gen_row_index.OPSNEGATE, t, into, v);
        ret;
    }
    if (code == table.NEG && boolean) {
        emitter.copy(e, t, into, v);
        ret;
    }
    if (code == table.FNEG) {
        emitter.one(e, gen_row_index.OPFNEGATE, t, into, v);
        ret;
    }
    if (code == table.FORD || code == table.FUNO) {
        val bt: u32 = emitter.bool_of(e, xt);
        val a:  u32 = emitter.fresh(e);
        val b:  u32 = emitter.fresh(e);
        emitter.one(e, gen_row_index.OPISNAN, bt, a, v);
        emitter.one(e, gen_row_index.OPISNAN, bt, b, emitter.id_of(e, d.operands.data[1]));
        if (code == table.FUNO) {
            emitter.two(e, gen_row_index.OPLOGICALOR, t, into, a, b);
            ret;
        }
        val either: u32 = emitter.fresh(e);
        emitter.two(e, gen_row_index.OPLOGICALOR, t, either, a, b);
        emitter.one(e, gen_row_index.OPLOGICALNOT, t, into, either);
        ret;
    }
    val unary: u32 = glsl_unary(code);
    if (unary != emitter.NO_ROW) {
        emitter.glsl_one(e, unary, t, into, v);
        ret;
    }
    if (code == table.FMA) {
        emitter.glsl_three(e, gen_row_index.OPEXTINST_GLSL_STD_450_FMA, t, into, v, emitter.id_of(e, d.operands.data[1]), emitter.id_of(e, d.operands.data[2]));
        ret;
    }
    if (d.operands.len != 2) {
        emitter.unselected(e, i);
        ret;
    }
    val y: u32 = emitter.id_of(e, d.operands.data[1]);
    if (code == table.FMINNUM) {
        emitter.glsl_two(e, gen_row_index.OPEXTINST_GLSL_STD_450_NMIN, t, into, v, y);
        ret;
    }
    if (code == table.FMAXNUM) {
        emitter.glsl_two(e, gen_row_index.OPEXTINST_GLSL_STD_450_NMAX, t, into, v, y);
        ret;
    }
    var row: u32 = float_row(code);
    if (row == emitter.NO_ROW) {
        if (boolean) { row = bool_row(code); }
        or           { row = integer_row(code); }
    }
    if (row == emitter.NO_ROW) {
        emitter.unselected(e, i);
        ret;
    }
    emitter.two(e, row, t, into, v, y);
}

# the blocks the region tree holds, and the loop headers among them
fun mark(e: *Emitter, r: u32) {
    if (r == NONE) { ret; }
    val g: Region      = region.region(e.s, r);
    val k: region.Kind = g.kind;
    if (!(sel k.sequence) && g.block != NONE) { e.reached.data[g.block] = true; }
    if (sel k.loop) {
        e.bodies.data[g.block] = NONE;
        val inner: u32 = g.child;
        var rest:  u32 = NONE;
        if (inner != NONE)                                         { rest = region.region(e.s, inner).next; }
        if (g.latch == NONE || g.latch == g.block || rest == NONE) { e.cts.data[g.block] = 1; }
    }
    var c: u32 = g.child;
    for (c != NONE) {
        mark(e, c);
        c = region.region(e.s, c).next;
    }
}

fun analysed[T](e: *Emitter, got: res[*T, refusal.Error]) opt[*T] {
    if (sel got.err) {
        emitter.fail(e, Error.analysis{got.err});
        ret opt[*T].none{};
    }
    ret opt[*T].some{got.ok};
}

fun filled(e: *Emitter, v: *vector.Vector[u32], n: usize, x: u32) {
    var k: usize = 0;
    for (k < n) {
        push_u32(e, v, x);
        k = k + 1;
    }
}

# the code of one function: its OpFunction, its parameters and, for one it
# defines, its blocks
pub fun function(u: *Unit, f: Function) {
    val node:     *FunctionNode = ?u.m.functions.data[f];
    val b:        *Body         = ?node.body;
    val sig:      *Signature    = unit.signature(u, f);
    val id:       u32           = u.functions.data[f];
    val declared: bool          = b.blocks.len == 0;
    var section:  usize         = buffer.DEFINITIONS;
    if (declared) { section = buffer.DECLARATIONS; }
    var head: [4]Slot = [4]Slot{Slot.id{sig.result}, Slot.id{id}, unit.enumerant(NO_CONTROL), Slot.id{sig.type}};
    unit.put(u, section, gen_row_index.OPFUNCTION, ?head[0], 4);
    if (declared) {
        var k: u32 = 0;
        for (k < sig.params.len) {
            var p: [2]Slot = [2]Slot{Slot.id{u.lists.data[sig.params.at + k]}, Slot.id{unit.fresh(u)}};
            unit.put(u, section, gen_row_index.OPFUNCTIONPARAMETER, ?p[0], 2);
            k = k + 1;
        }
        var end: [1]Slot = [1]Slot{Slot.none{}};
        unit.put(u, section, gen_row_index.OPFUNCTIONEND, ?end[0], 0);
        ret;
    }
    var e: Emitter = Emitter{
        u:        u,
        f:        f,
        b:        b,
        s:        nil,
        ids:      vector.init[u32](u.a),
        pointers: vector.init[Pointer](u.a),
        labels:   vector.init[u32](u.a),
        bodies:   vector.init[u32](u.a),
        cts:      vector.init[u32](u.a),
        reached:  vector.init[bool](u.a),
        loops:    vector.init[Frame](u.a),
        line:     0xFFFF_FFFF,
        specs:    vector.init[bool](u.a),
        special:  emitter.NOWHERE,
        held:     vector.init[emitter.Held](u.a),
    };
    fin {
        vector.dnit[u32](?e.ids);
        vector.dnit[Pointer](?e.pointers);
        vector.dnit[u32](?e.labels);
        vector.dnit[u32](?e.bodies);
        vector.dnit[u32](?e.cts);
        vector.dnit[bool](?e.reached);
        vector.dnit[Frame](?e.loops);
        vector.dnit[bool](?e.specs);
        vector.dnit[emitter.Held](?e.held);
    }
    val opt_analysed: opt[*Structure] = analysed[Structure](?e, analysis.structure_of(u.cache, f));
    if (sel opt_analysed.none) { ret; }
    e.s = opt_analysed.some;
    var k: usize = 0;
    for (k < b.values.len) {
        push_u32(?e, ?e.ids, unit.fresh(u));
        val res_pushed: res[usize, allocator.Error] = vector.push[Pointer](?e.pointers, emitter.UNKNOWN);
        if (sel res_pushed.err) {
            emitter.lost(?e, res_pushed.err);
            ret;
        }
        val res_marked: res[usize, allocator.Error] = vector.push[bool](?e.specs, false);
        if (sel res_marked.err) {
            emitter.lost(?e, res_marked.err);
            ret;
        }
        k = k + 1;
    }
    filled(?e, ?e.labels, b.blocks.len, NO_ID);
    filled(?e, ?e.bodies, b.blocks.len, NO_ID);
    filled(?e, ?e.cts, b.blocks.len, NO_ID);
    k = 0;
    for (k < b.blocks.len) {
        val res_pushed: res[usize, allocator.Error] = vector.push[bool](?e.reached, false);
        if (sel res_pushed.err) {
            emitter.lost(?e, res_pushed.err);
            ret;
        }
        k = k + 1;
    }
    if (!unit.ok(u)) { ret; }
    mark(?e, region.root(opt_analysed.some));
    k = 0;
    for (k < b.blocks.len) {
        if (e.reached.data[k]) {
            e.labels.data[k] = unit.fresh(u);
            if (e.bodies.data[k] == NONE) { e.bodies.data[k] = unit.fresh(u); }
            or                            { e.bodies.data[k] = e.labels.data[k]; }
            if (e.cts.data[k] != NO_ID)   { e.cts.data[k] = unit.fresh(u); }
        }
        k = k + 1;
    }
    if (b.blocks.data[0].predecessors.len > 0 || e.bodies.data[0] != e.labels.data[0]) {
        emitter.unstructured(?e);
        ret;
    }
    val params: *vector.Vector[Value] = ?b.blocks.data[0].parameters;
    k = 0;
    for (k < params.len && unit.ok(u)) {
        val v:       Value = params.data[k];
        var t:       u32   = u.lists.data[sig.params.at + k::u32];
        val pointee: u32   = u.lists.data[sig.pointees.at + k::u32];
        if (pointee != NO_ID) {
            val res_shape: res[type_table.Shape, type_table.Error] = type_table.shape(?u.m.types, emitter.value_type(?e, v));
            var class:     u32                                     = 0;
            if (sel res_shape.ok) {
                val sh: type_table.Shape = res_shape.ok;
                if (sel sh.pointer) { class = sh.pointer.space; }
            }
            # a parameter carries no qualifier, so one into buffer memory is coherent where the module binds a coherent buffer
            e.pointers.data[v] = Pointer{id: e.ids.data[v], pointee: (pointee - 1), key: u.lists.data[sig.keys.at + k::u32], class: class, known: true, declared: true, scope: spirv_types.scope_of(u, class, u.coherent)};
        }
        var p: [2]Slot = [2]Slot{Slot.id{t}, Slot.id{e.ids.data[v]}};
        unit.put(u, buffer.DEFINITIONS, gen_row_index.OPFUNCTIONPARAMETER, ?p[0], 2);
        k = k + 1;
    }
    sequence(?e, region.root(opt_analysed.some));
    var end: [1]Slot = [1]Slot{Slot.none{}};
    unit.put(u, buffer.DEFINITIONS, gen_row_index.OPFUNCTIONEND, ?end[0], 0);
}
