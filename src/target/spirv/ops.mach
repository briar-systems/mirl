# the tables of spir-v's core set of the target op catalog
#
# a core op is the instruction its row of masc's set is. the catalog refuses an
# op the ir has a form of, naming the form, so each operation has one spelling,
# and names the handle kinds masc's rows state for an id

use std.types.size.usize;

use spirv_kind: masc.isa.spirv.kind;

use mirl.target.capability.Handled;
use mirl.target.capability.Refused;

