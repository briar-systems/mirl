# the kinds of id masc's rows state, by the byte of each, sorted
# by byte
pub val HANDLES_COUNT: usize      = 4;
pub val HANDLES:       [4]Handled = [4]Handled{
    Handled{byte: spirv_kind.IMAGE, kind: Kinded.handle{"spirv.image"}},
    Handled{byte: spirv_kind.SAMPLER, kind: Kinded.handle{"spirv.sampler"}},
    Handled{byte: spirv_kind.SAMPLED_IMAGE, kind: Kinded.handle{"spirv.sampled_image"}},
    Handled{byte: spirv_kind.IMAGE_POINTER, kind: Kinded.pointer{}},
};
