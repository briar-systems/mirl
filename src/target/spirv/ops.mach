# the handle kinds masc's rows state for an id, by the byte of each, sorted
# by byte
pub val HANDLES_COUNT: usize      = 4;
pub val HANDLES:       [4]Handled = [4]Handled{
    Handled{byte: spirv_kind.IMAGE, kind: "spirv.image"},
    Handled{byte: spirv_kind.SAMPLER, kind: "spirv.sampler"},
    Handled{byte: spirv_kind.SAMPLED_IMAGE, kind: "spirv.sampled_image"},
    Handled{byte: spirv_kind.IMAGE_POINTER, kind: "spirv.image_pointer"},
};
