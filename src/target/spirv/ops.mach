# the tables of spir-v's core set of the target op catalog
#
# a core op is the instruction its row of masc's set is. the catalog refuses an
# op the language writes with a construct of its own, naming the construct, so
# each operation has one spelling, and an op that is no instruction a program
# writes, as a type or a decoration, saying what it is. an op the ir has a form
# of that no construct writes, as OpBitCount, is not refused. the tables also
# name the handle kinds masc's rows state for an id

use std.types.size.usize;

use spirv_kind: masc.isa.spirv.kind;

use mirl.target.capability.Handled;
use mirl.target.capability.Kinded;
use mirl.target.capability.Refused;
use mirl.target.capability.Written;

# the core ops a front end writes with a construct of its own, or that are no
# instruction a program writes, sorted by op
pub val REFUSED_COUNT: usize        = 171;
pub val REFUSED:       [171]Refused = [171]Refused{
    Refused{op: "OpAccessChain", written: Written.construct{"a member access or an index, as `r.f` or `a[i]`"}},
    Refused{op: "OpBitcast", written: Written.construct{"a reinterpreting cast, `x:~T`"}},
    Refused{op: "OpBitwiseAnd", written: Written.construct{"the `&` operator"}},
