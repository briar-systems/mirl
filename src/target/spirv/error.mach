# why the spir-v back end refused a scheduled module

use std.types.string.str;

use std.allocator;

use masc.build.build;

use mink.base.fail.Fail;

use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.module;
use mirl.ir.type.Type;
use mirl.pass.failure.Why;
use mirl.target.basis;
use mirl.target.record;

# an instruction of a function
# ---
# function:    the function
# instruction: the instruction
pub rec At {
    function:    Function;
    instruction: Instruction;
}

# what masc refused of the module
# ---
# function: the function whose code it refused, or past the module's
#           functions for the module's own instructions
# message:  masc's words
pub rec Encoding {
    function: Function;
    message:  str;
}

# a capability, an extension or a version the module needs that the build's
# selection does not hold
# ---
# name: the name masc's catalog gives the first atom of the first way the
#       module could meet the need
pub rec Unmet {
    name: str;
}

# what an image imports, which no other object defines for it
# ---
# function: a function the module only declares
# global:   a Private global the module only declares
pub tag Import: u8 {
    function: Function;
    global:   Global;
}

# why a module was not compiled
# ---
# alloc:         the allocator refused storage
# ir:            the module refused a read
# layout:        the data layout gave a type no extent
# basis:         the selection a linkage unit is read under was not opened
# analysis:      a function's structure was not read
# unselected:    an instruction spir-v has no form of yet
# untyped:       a type spir-v has no form of here, as a pointer in memory,
#                a handle of a kind the family states none of or a vector of
#                a lane count spir-v has no vector of
# unpointed:     a pointer whose pointee no definition or use states
# reinterpreted: an access through a pointer at a type other than what it
#                points to, which logical addressing cannot reach
# variable:      a pointer chosen at run time, through a block parameter, a
#                select or a call's result, which logical addressing reaches
#                only through variable pointers
# storage:       a global whose address is used in another storage class
#                than its own, or one whose class holds no value of its type
# slot:          a stack slot whose pointer is not into the target's slot class
# entry:         an entry point that takes or returns a value
# imported:      an image that imports a function or a global
# unmet:         a capability, extension or version the module needs that
#                the selection does not hold
# unstructured:  a function whose region tree the emitter cannot follow
# encoding:      masc refused an instruction
# builder:       masc's builder refused the module
# container:     mink's object refused the module
pub tag Error: u8 {
    alloc:         allocator.Error;
    ir:            module.Error;
    layout:        record.Error;
    basis:         basis.Error;
    analysis:      Why;
    unselected:    At;
    untyped:       Type;
    unpointed:     At;
    reinterpreted: At;
    variable:      At;
    storage:       Global;
    slot:          At;
    entry:         Function;
    imported:      Import;
    unmet:         Unmet;
    unstructured:  Function;
    encoding:      Encoding;
    builder:       build.Refusal;
    container:     Fail;
}
