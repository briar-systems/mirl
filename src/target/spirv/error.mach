# why the spir-v back end refused a scheduled module

use std.types.bool.bool;
use std.types.option.opt;
use std.types.string.str;

use std.allocator;

use build_refusal: masc.build.refusal;
use masc.core.extension;

use mink.base.fail.Fail;

use mirl.ir.debug.record.Location;
use mirl.ir.id.Function;
use mirl.ir.id.Global;
use mirl.ir.id.Instruction;
use mirl.ir.module;
use mirl.ir.type.table.Type;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.record;

# an instruction of a function
# ---
# function:    the function
# instruction: the instruction
# location:    the source location it was built for, none for none
pub rec At {
    function:    Function;
    instruction: Instruction;
    location:    opt[Location];
}

# a capability, extension or version the module needs that the selection
# does not hold
# ---
# name: the atom, as the target names it
# at:   the instruction that first named the need, none for one the module
#       itself needs
pub rec Unmet {
    name: str;
    at:   opt[At];
}

# a pointer a call passes into a storage class logical addressing lets no
# call pass it into
# ---
# at:    the call
# class: the storage class, as spir-v names it
# whole: it is the whole variable or a parameter, where a part of one is not
pub rec Passed {
    at:    At;
    class: str;
    whole: bool;
}

# an atomic on memory of a storage class vulkan admits no atomic in
# ---
# at:    the atomic
# class: the storage class, as spir-v names it
pub rec Atomic {
    at:    At;
    class: str;
}

# where a refusal stands
# ---
# at:     an instruction of a function
# global: a global as a whole, where no one instruction is the cause
pub tag Site: u8 {
    at:     At;
    global: Global;
}

# a built-in an entry point reaches from a stage it does not exist in
# ---
# entry:   the entry point
# stage:   its execution model, as spir-v names it
# builtin: the built-in, as spir-v names it
# exists:  the execution models the built-in exists in, as spir-v names them
pub rec Builtin {
    entry:   Function;
    stage:   str;
    builtin: str;
    exists:  str;
}

# a binding of a handle an entry point reaches from a stage the handle does not
# exist in, as the target's handle catalog states its stages
# ---
# entry:  the entry point
# stage:  its execution model, as spir-v names it
# exists: the execution models the handle exists in, as spir-v names them
# why:    the rule, as the catalog quotes it
pub rec Handled {
    entry:  Function;
    stage:  str;
    exists: str;
    why:    str;
}

# an entry point that reaches what its stage does not have
# ---
# entry: the entry point
# stage: its execution model, as spir-v names it
pub rec Staged {
    entry: Function;
    stage: str;
}

# an integer or 64-bit input a fragment stage reads, which it reads only as
# Flat, read by a vertex stage too, whose inputs Flat may not decorate
# ---
# fragment: the fragment entry point
# vertex:   the vertex entry point
pub rec Flat {
    fragment: Function;
    vertex:   Function;
}

# a push-constant block an entry point uses beside another, where it may use
# one
# ---
# entry: the entry point
# other: the other block
pub rec Pushed {
    entry: Function;
    other: Global;
}

# a specialization constant whose id another one has
# ---
# id:    the id
# other: the other constant's var
pub rec Specialized {
    id:    u32;
    other: Global;
}

# compute stages whose workgroup sizes differ, one named by a specialization
# constant, where one WorkgroupSize built-in sizes every compute stage of the
# module
# ---
# first:  one stage
# second: the other
pub rec Sized {
    first:  Function;
    second: Function;
}

# a block whose layout places a byte where the rules of its class place it
# elsewhere
# ---
# rules:  the rules, as std140 or std430
# offset: the first byte of the first scalar the two place apart, as the
#         layout places it
# placed: where the rules place that byte
pub rec Layout {
    rules:  str;
    offset: u64;
    placed: u64;
}

# memory a physical pointer reaches, laid out against the rules of a storage buffer
# ---
# at:     the access that first reaches it
# layout: where its layout and the rules place a byte apart
pub rec Pointee {
    at:     At;
    layout: Layout;
}

# the rule of a stage's interface a module breaks
# ---
# builtin:   a built-in reached from a stage it does not exist in
# handle:    a handle binding reached from a stage its handle does not exist in
# shared:    a Workgroup variable reached from a stage other than compute
# output:    an Output variable reached from a stage that has none
# flat:      an input that must be Flat for one stage and may not be for another
# push:      two push-constant blocks one entry point uses
# spec:      two specialization constants with one id
# workgroup: compute stages whose workgroup sizes disagree
# narrow:    a stage input or output of integers of this many bits, which no
#            stage's interface carries
# layout:    a block laid out against the rules of its class
pub tag Rule: u8 {
    builtin:   Builtin;
    handle:    Handled;
    shared:    Staged;
    output:    Staged;
    flat:      Flat;
    push:      Pushed;
    spec:      Specialized;
    workgroup: Sized;
    narrow:    u32;
    layout:    Layout;
}

# a stage's interface the module breaks a rule of
# ---
# site: where it breaks it
# rule: the rule
pub rec Interface {
    site: Site;
    rule: Rule;
}

# why a binding admits no store
# ---
# qualified: the program qualifies it `readonly`
# push:      it is a push-constant block, which only the host writes
pub tag Unwritable: u8 {
    qualified;
    push;
}

# a store that reaches a binding nothing may write
# ---
# site:    the store, or the global that holds the binding's address
# binding: the binding
# why:     why it admits no store
pub rec Stored {
    site:    Site;
    binding: Global;
    why:     Unwritable;
}

# a load that reaches a binding the program qualifies `writeonly`
# ---
# site:    the load, or the global that holds the binding's address
# binding: the binding
pub rec Loaded {
    site:    Site;
    binding: Global;
}

# why an operand's value was refused
# ---
# outside: no value the operand admits: the values it admits, as spir-v names
#          them or their enumeration
# brought: a value whose operands the call does not pass
pub tag Unadmitted: u8 {
    outside: str;
    brought: Brought;
}

# the operands a value brings after the instruction's others, against what a
# call passes
# ---
# brings: the operands it brings
# passed: the operands the call passes in their place
pub rec Brought {
    brings: u32;
    passed: u32;
}

# an operand of an intrinsic call
# ---
# at:      the call
# operand: the argument's position among the call's, from zero
pub rec Operand {
    at:      At;
    operand: u32;
}

# an operand value an intrinsic call passes that its instruction does not admit
# ---
# operand: the call and the operand
# value:   the value
# why:     why it is refused
pub rec Valued {
    operand: Operand;
    value:   u32;
    why:     Unadmitted;
}

# an image an intrinsic call passes that its instruction does not take
# ---
# operand: the call and the image's operand
# why:     what the instruction takes of its image or its Image Operands
pub rec Imaged {
    operand: Operand;
    why:     str;
}

# an operand of a kind its instruction does not admit there
# ---
# operand: the call and the operand
# admits:  what the operand admits, as gpu.md's operand kinds name it
pub rec Signature {
    operand: Operand;
    admits:  str;
}

# an instruction an entry point of an execution model it does not execute in
# reaches, as masc's typing of its row states the models
# ---
# at:     the instruction
# entry:  the entry point
# stage:  the entry point's execution model, as spir-v names it
# models: the models the instruction executes in, as spir-v names them
pub rec Executed {
    at:     At;
    entry:  Function;
    stage:  str;
    models: str;
}

# what masc refused of the module
# ---
# function: the function whose code it refused, or past the module's
#           functions for the module's own instructions
# message:  masc's words
pub rec Encoding {
    function: Function;
    message:  str;
}

# what an image imports, which no other object defines for it
# ---
# function: a function the module only declares
# global:   a Private global the module only declares
pub tag Import: u8 {
    function: Function;
    global:   Global;
}

# an atom of a build's selection its environment can hold no way: a
# capability past its bound that no extension the selection holds enables,
# an extension that needs a version past it, or such a version
# ---
# atom: the atom, as the instruction set names it
# env:  the environment, or the system where it has none
pub rec Bounded {
    atom: str;
    env:  str;
}

# why a module was not compiled
# ---
# alloc:         the allocator refused storage
# ir:            the module refused a read
# layout:        the data layout gave a type no extent
# basis:         the selection a linkage unit is read under was not opened
# analysis:      a function's structure was not read
# unselected:    an instruction spir-v has no form of yet
# untyped:       a type spir-v has no form of here, as a pointer in memory,
#                a handle of a kind the family states none of or a vector of
#                a lane count spir-v has no vector of
# unpointed:     a pointer whose pointee no definition or use states
# reinterpreted: an access through a pointer at a type other than what it
#                points to, which logical addressing cannot reach
# variable:      a pointer chosen at run time, through a block parameter, a
#                select or a call's result, which logical addressing reaches
#                only through variable pointers
# storage:       a global whose address is used in another storage class
#                than its own, or one whose class holds no value of its type
# slot:          a stack slot whose pointer is not into the target's slot class
# passed:        a call that passes a pointer no call may pass
# atomic:        an atomic on memory of a storage class it may not operate on
# entry:         an entry point that takes or returns a value
# workgroup:     an entry point whose workgroup names a dimension by a
#                specialization constant the module has no 32-bit integer of
# imported:      an image that imports a function or a global
# replaceable:   a linkage unit that defines a replaceable function or global,
#                which spir-v's linkage states no form of, and which binds a
#                call by the id of the definition, never by its name
# unmet:         a capability, extension or version the module needs that
#                the selection does not hold
# interface:     a rule of a stage's interface the module breaks
# pointee:       memory a physical pointer reaches laid out against the rules
#                of a storage buffer
# readonly:      a store that reaches a binding nothing may write
# writeonly:     a load that reaches a binding nothing may read
# operand_value: an intrinsic call's operand value its instruction does not
#                admit
# not_constant:  an intrinsic call's operand that must be a constant and
#                is not one
# signature:     an intrinsic call's operand of a kind its instruction does
#                not admit there
# flow:          an intrinsic call whose result is used where its
#                instruction's result cannot flow
# unstructured:  a function whose region tree the emitter cannot follow
# recursion:     a call an entry point's call tree holds back to the function
#                that makes it, which no static call graph of spir-v holds
# encoding:      masc refused an instruction
# builder:       masc's builder refused the module
# container:     mink's object refused the module
# bound:         masc did not read the bound the target's host states
# bounded:       the selection holds what the target's environment can hold
#                no way
# image:         an intrinsic call's image or Image Operands its
#                instruction does not take
# executed:      an instruction reached from an entry point of an execution
#                model it does not execute in
pub tag Error: u8 {
    alloc:         allocator.Error;
    ir:            module.Error;
    layout:        record.Error;
    basis:         basis.Error;
    analysis:      refusal.Error;
    unselected:    At;
    untyped:       Type;
    unpointed:     At;
    reinterpreted: At;
    variable:      At;
    storage:       Global;
    slot:          At;
    passed:        Passed;
    atomic:        Atomic;
    entry:         Function;
    workgroup:     Function;
    imported:      Import;
    replaceable:   Import;
    unmet:         Unmet;
    interface:     Interface;
    pointee:       Pointee;
    readonly:      Stored;
    writeonly:     Loaded;
    operand_value: Valued;
    not_constant:  Operand;
    signature:     Signature;
    flow:          At;
    unstructured:  Function;
    recursion:     At;
    encoding:      Encoding;
    builder:       build_refusal.Refusal;
    container:     Fail;
    bound:         extension.Error;
    bounded:       Bounded;
    image:         Imaged;
    executed:      Executed;
}
