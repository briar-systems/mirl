# the instructions of a module held in the sections of its logical layout
# until every one is made
#
# a spir-v module states its capabilities, extensions and types before the
# code that needs them, and its types are found while its code is walked, so
# each instruction is held in the section of the logical layout it belongs to
# (spir-v 1.6, 2.4 "logical layout of a module") and handed to masc in that
# order once the module is whole. an instruction is a row of masc's spir-v set
# and its operand values, held as slots whose lists, groups, params and
# literals are runs of the buffer's own storage, so nothing points into a
# vector that grows. the requirement of every row and of every enumerant an
# instruction names is gathered as it is held, which is what the capabilities
# and extensions the module declares are read from.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.vector;

use mo: masc.core.operand;
use masc.core.requirement;
use masc.core.row;
use masc.isa.spirv.gen_row;

# the sections of the logical layout, in order. the capabilities and the
# memory model are not held: the first is read from the gathered
# requirements and the second is stated as traits
pub val EXTENSIONS:   usize = 0;
pub val IMPORTS:      usize = 1;
pub val ENTRIES:      usize = 2;
pub val MODES:        usize = 3;
pub val STRINGS:      usize = 4;
pub val NAMES:        usize = 5;
pub val ANNOTATIONS:  usize = 6;
pub val TYPES:        usize = 7;
pub val DECLARATIONS: usize = 8;
pub val DEFINITIONS:  usize = 9;
pub val SECTIONS:     usize = 10;

# a run of the buffer's slots or bytes
# ---
# at:  its first
# len: how many
pub rec Span {
    at:  u32;
    len: u32;
}

pub val EMPTY: Span = Span{at: 0, len: 0};

# an enumerant and the params it takes
# ---
# value:  its value, or a mask's set bits
# params: its params, a run of slots
pub rec Chosen {
    value:  u32;
    params: Span;
}

# one operand value, as masc's operand value with its runs held here
pub tag Slot: u8 {
    none;
    id:        u32;
    immediate: i64;
    enumerant: Chosen;
    literal:   Span;
    list:      Span;
    group:     Span;
}

# one instruction
# ---
# row:   its row of masc's spir-v set
# at:    its first operand slot
# count: its operands, one per operand of the row
pub rec Ins {
    row:   u32;
    at:    u32;
    count: u32;
}

# a module's instructions
# ---
# a:        the allocator its storage takes
# slots:    every slot of every instruction
# bytes:    every literal's bytes
# sections: the instructions of each section, in order
# needs:    every requirement an instruction names, each once
# atoms:    every atom an instruction needs that no requirement of masc's
#           rows states, as the width of a scalar type
pub rec Buffer {
    a:        *allocator.Allocator;
    slots:    vector.Vector[Slot];
    bytes:    vector.Vector[u8];
    sections: [10]vector.Vector[Ins];
    needs:    vector.Vector[requirement.Requirement];
    atoms:    vector.Vector[requirement.Id];
}

# an empty buffer
pub fun make(a: *allocator.Allocator) Buffer {
    var b: Buffer;
    b.a     = a;
    b.slots = vector.init[Slot](a);
    b.bytes = vector.init[u8](a);
    b.needs = vector.init[requirement.Requirement](a);
    b.atoms = vector.init[requirement.Id](a);
    var i: usize = 0;
    for (i < SECTIONS) {
        b.sections[i] = vector.init[Ins](a);
        i             = i + 1;
    }
    ret b;
}

# give back a buffer's storage
pub fun release(b: *Buffer) {
    vector.dnit[Slot](?b.slots);
    vector.dnit[u8](?b.bytes);
    vector.dnit[requirement.Requirement](?b.needs);
    vector.dnit[requirement.Id](?b.atoms);
    var i: usize = 0;
    for (i < SECTIONS) {
        vector.dnit[Ins](?b.sections[i]);
        i = i + 1;
    }
}

fun held(got: res[usize, allocator.Error]) err[allocator.Error] {
    if (sel got.err) { ret err[allocator.Error].err{got.err}; }
    ret err[allocator.Error].ok{};
}

# a run of slots, copied
pub fun run(b: *Buffer, slots: *Slot, n: usize) res[Span, allocator.Error] {
    val at: u32   = b.slots.len::u32;
    var i:  usize = 0;
    for (i < n) {
        val got: err[allocator.Error] = held(vector.push[Slot](?b.slots, slots[i]));
        if (sel got.err) { ret res[Span, allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret res[Span, allocator.Error].ok{Span{at: at, len: n::u32}};
}

# a run of id slots
pub fun ids(b: *Buffer, list: *u32, n: usize) res[Span, allocator.Error] {
    val at: u32   = b.slots.len::u32;
    var i:  usize = 0;
    for (i < n) {
        val got: err[allocator.Error] = held(vector.push[Slot](?b.slots, Slot.id{list[i]}));
        if (sel got.err) { ret res[Span, allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret res[Span, allocator.Error].ok{Span{at: at, len: n::u32}};
}

# a run of immediate slots
pub fun immediates(b: *Buffer, list: *u32, n: usize) res[Span, allocator.Error] {
    val at: u32   = b.slots.len::u32;
    var i:  usize = 0;
    for (i < n) {
        val got: err[allocator.Error] = held(vector.push[Slot](?b.slots, Slot.immediate{list[i]::i64}));
        if (sel got.err) { ret res[Span, allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret res[Span, allocator.Error].ok{Span{at: at, len: n::u32}};
}

# the bytes of a string, copied, with no terminator
pub fun text(b: *Buffer, v: View) res[Span, allocator.Error] {
    val at: u32   = b.bytes.len::u32;
    var i:  usize = 0;
    for (i < v.len) {
        val got: err[allocator.Error] = held(vector.push[u8](?b.bytes, v.data[i]));
        if (sel got.err) { ret res[Span, allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret res[Span, allocator.Error].ok{Span{at: at, len: v.len::u32}};
}

# the bytes of a number of whole words, low byte first, its low bits the
# value's
pub fun words(b: *Buffer, value: u64, words: u32) res[Span, allocator.Error] {
    val at: u32 = b.bytes.len::u32;
    var i:  u32 = 0;
    for (i < words * 4) {
        var byte: u8 = 0;
        if (i < 8) { byte = ((value >> (i::u64 * 8)) & 0xFF)::u8; }
        val got: err[allocator.Error] = held(vector.push[u8](?b.bytes, byte));
        if (sel got.err) { ret res[Span, allocator.Error].err{got.err}; }
        i = i + 1;
    }
    ret res[Span, allocator.Error].ok{Span{at: at, len: words * 4}};
}

# a requirement an instruction names, kept once
pub fun need(b: *Buffer, r: requirement.Requirement) err[allocator.Error] {
    if (r.len == 0) { ret err[allocator.Error].ok{}; }
    var i: usize = 0;
    for (i < b.needs.len) {
        if (b.needs.data[i].at == r.at && b.needs.data[i].len == r.len) { ret err[allocator.Error].ok{}; }
        i = i + 1;
    }
    ret held(vector.push[requirement.Requirement](?b.needs, r));
}

# an atom an instruction needs, kept once
pub fun need_atom(b: *Buffer, id: requirement.Id) err[allocator.Error] {
    var i: usize = 0;
    for (i < b.atoms.len) {
        if (b.atoms.data[i] == id) { ret err[allocator.Error].ok{}; }
        i = i + 1;
    }
    ret held(vector.push[requirement.Id](?b.atoms, id));
}

# the requirements of the enumerant a slot holds, and of what it holds
# within it, read against the operand shape it fills
fun gather(b: *Buffer, shape: *mo.Shape, s: Slot) err[allocator.Error] {
    if (sel shape.enumerant) {
        if (!(sel s.enumerant)) { ret err[allocator.Error].ok{}; }
        val e:      *mo.Enumeration = ?shape.enumerant;
        val value:  u32             = s.enumerant.value;
        val params: Span            = s.enumerant.params;
        var i:      u32             = 0;
        for (i < e.count) {
            val m:     *mo.Enumerant = ?e.members[i];
            val named: bool          = m.value == value || (e.mask && m.value != 0 && (value & m.value) == m.value);
            if (named) {
                val got: err[allocator.Error] = need(b, m.requires);
                if (sel got.err) { ret got; }
            }
            i = i + 1;
        }
        var k: u32 = 0;
        for (k < params.len) {
            val p: *mo.Operand = mo.param(e, value, k);
            if (p != nil) {
                val got: err[allocator.Error] = gather(b, ?p.shape, b.slots.data[params.at + k]);
                if (sel got.err) { ret got; }
            }
            k = k + 1;
        }
        ret err[allocator.Error].ok{};
    }
    if (sel shape.group) {
        if (!(sel s.group)) { ret err[allocator.Error].ok{}; }
        val members: Span     = s.group;
        val g:       mo.Group = shape.group;
        var i:       u32      = 0;
        for (i < members.len && i < g.len) {
            val got: err[allocator.Error] = gather(b, ?g.at[i].shape, b.slots.data[members.at + i]);
            if (sel got.err) { ret got; }
            i = i + 1;
        }
    }
    ret err[allocator.Error].ok{};
}

# hold an instruction of a row in a section, its operand slots copied, and
# gather what it requires
pub fun put(b: *Buffer, section: usize, r: u32, slots: *Slot, n: usize) err[allocator.Error] {
    val at: res[Span, allocator.Error] = run(b, slots, n);
    if (sel at.err) { ret err[allocator.Error].err{at.err}; }
    val kept: err[allocator.Error] = held(vector.push[Ins](?b.sections[section], Ins{row: r, at: at.ok.at, count: n::u32}));
    if (sel kept.err) { ret kept; }
    val rw:   *row.Row             = ?gen_row.ROWS[r];
    val mine: err[allocator.Error] = need(b, rw.requires);
    if (sel mine.err) { ret mine; }
    var k: u32 = 0;
    for (k < n::u32 && k < rw.operands.len) {
        val desc:    *mo.Operand = ?rw.operands.at[k];
        val s:       Slot        = slots[k];
        var listed:  bool        = 0;
        var members: Span        = EMPTY;
        if (sel s.list) {
            if (desc.quantity == mo.VARIADIC) {
                listed  = 1;
                members = s.list;
            }
        }
        if (listed) {
            var i: u32 = 0;
            for (i < members.len) {
                val got: err[allocator.Error] = gather(b, ?desc.shape, b.slots.data[members.at + i]);
                if (sel got.err) { ret got; }
                i = i + 1;
            }
        }
        or {
            val got: err[allocator.Error] = gather(b, ?desc.shape, s);
            if (sel got.err) { ret got; }
        }
        k = k + 1;
    }
    ret err[allocator.Error].ok{};
}

# the number of values a slot holds within it, all the way down
fun nested(b: *Buffer, s: Slot) usize {
    var inner: Span = EMPTY;
    if (sel s.list)      { inner = s.list; }
    or (sel s.group)     { inner = s.group; }
    or (sel s.enumerant) { inner = s.enumerant.params; }
    var n: usize = inner.len::usize;
    var i: u32   = 0;
    for (i < inner.len) {
        n = n + nested(b, b.slots.data[inner.at + i]);
        i = i + 1;
    }
    ret n;
}

# the values of a run, placed at the end of the values made so far
fun values_of(b: *Buffer, inner: Span, out: *vector.Vector[mo.Value]) mo.Values {
    if (inner.len == 0) { ret mo.NO_VALUES; }
    val base: usize = out.len;
    var i:    u32   = 0;
    for (i < inner.len) {
        out.data[out.len] = mo.Value.none{};
        out.len           = out.len + 1;
        i                 = i + 1;
    }
    i = 0;
    for (i < inner.len) {
        out.data[base + i::usize] = value_of(b, b.slots.data[inner.at + i], out);
        i                         = i + 1;
    }
    ret mo.Values{at: ?out.data[base], len: inner.len};
}

fun value_of(b: *Buffer, s: Slot, out: *vector.Vector[mo.Value]) mo.Value {
    if (sel s.id)        { ret mo.Value.id{s.id}; }
    if (sel s.immediate) { ret mo.Value.immediate{s.immediate}; }
    if (sel s.literal) {
        var at: *u8 = nil;
        if (b.bytes.len > 0) { at = ?b.bytes.data[s.literal.at]; }
        ret mo.Value.literal{mo.Bytes{at: at, len: s.literal.len}};
    }
    if (sel s.enumerant) { ret mo.Value.enumerant{mo.Chosen{value: s.enumerant.value, params: values_of(b, s.enumerant.params, out)}}; }
    if (sel s.list)      { ret mo.Value.list{values_of(b, s.list, out)}; }
    if (sel s.group)     { ret mo.Value.group{values_of(b, s.group, out)}; }
    ret mo.Value.none{};
}

# the operand values of an instruction as masc reads them, in `out`, whose
# storage holds what they hold within them, valid until `out` is used again
pub fun values(b: *Buffer, ins: Ins, out: *vector.Vector[mo.Value]) res[*mo.Value, allocator.Error] {
    out.len = 0;
    var total: usize = ins.count::usize;
    var k:     u32   = 0;
    for (k < ins.count) {
        total = total + nested(b, b.slots.data[ins.at + k]);
        k     = k + 1;
    }
    val room: res[usize, allocator.Error] = vector.reserve[mo.Value](out, total + 1);
    if (sel room.err) { ret res[*mo.Value, allocator.Error].err{room.err}; }
    k = 0;
    for (k < ins.count) {
        out.data[out.len] = mo.Value.none{};
        out.len           = out.len + 1;
        k                 = k + 1;
    }
    k = 0;
    for (k < ins.count) {
        out.data[k] = value_of(b, b.slots.data[ins.at + k], out);
        k           = k + 1;
    }
    ret res[*mo.Value, allocator.Error].ok{out.data};
}
