# the target rows: one per target mirl generates code for
#
# a new target is a new row here, read through the same declarations as
# every other, and never a new case in a pass.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.types.char.char;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;

use masc.core.diagnostic;
use masc.core.extension;
use mset:      masc.core.set;
use masc_isa:  masc.isa.isa;
use arches:    mink.catalog.arch;
use arch_list: mink.catalog.arch.list;
use systems:   mink.catalog.os;
use os_list:   mink.catalog.os.list;

use mirl.base.slice;
use mirl.ir.attribute.Kind;
use mirl.ir.module.Tuple;
use mirl.target.abi.convention.Declared;
use mirl.target.capability;
use mirl.target.capability.Attached;
use mirl.target.capability.Attaches;
use mirl.target.capability.Attributes;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Data;
use mirl.target.capability.Entry;
use mirl.target.capability.Fact;
use mirl.target.capability.Fault;
use mirl.target.capability.Functions;
use mirl.target.capability.Long;
use mirl.target.capability.LongDivision;
use mirl.target.capability.Pointer;
use mirl.target.capability.Schema;
use mirl.target.capability.Space;
use mirl.target.capability.Violation;
use mirl.target.record;
use mirl.target.record.Error;
use mirl.target.record.Target;
use mirl.target.record.declared;
use mirl.target.register.aarch64.rows.AARCH64_DARWIN;
use mirl.target.register.aarch64.rows.AARCH64_FREESTANDING;
use mirl.target.register.aarch64.rows.AARCH64_LINUX;
use mirl.target.register.aarch64.rows.AARCH64_WINDOWS;
use mirl.target.register.riscv.rows.RV32IMAC_FREESTANDING;
use mirl.target.register.riscv.rows.RV32_FREESTANDING;
use mirl.target.register.riscv.rows.RV32_LINUX;
use mirl.target.register.riscv.rows.RV64IMAC_FREESTANDING;
use mirl.target.register.riscv.rows.RV64_FREESTANDING;
use mirl.target.register.riscv.rows.RV64_LINUX;
use mirl.target.register.x86.rows.X86_64_DARWIN;
use mirl.target.register.x86.rows.X86_64_FREESTANDING;
use mirl.target.register.x86.rows.X86_64_LINUX;
use mirl.target.register.x86.rows.X86_64_WINDOWS;
use mirl.target.spirv.rows.SPIRV_VULKAN;

def Rows: [15]*Target;

val ROWS: Rows = [15]*Target{
    ?RV64_LINUX, ?X86_64_LINUX, ?X86_64_DARWIN, ?X86_64_WINDOWS, ?X86_64_FREESTANDING, ?AARCH64_LINUX, ?AARCH64_DARWIN, ?AARCH64_WINDOWS, ?AARCH64_FREESTANDING, ?RV64_FREESTANDING, ?RV32_LINUX, ?RV32_FREESTANDING, ?SPIRV_VULKAN, ?RV64IMAC_FREESTANDING, ?RV32IMAC_FREESTANDING,
};

# the number of target rows
pub fun rows() usize {
    ret $length_of(Rows);
}

# the target row at an index, none past the last
pub fun row(index: usize) opt[*Target] {
    if (index >= rows()) { ret opt[*Target].none{}; }
    ret opt[*Target].some{ROWS[index]};
}

# the row of mink's architecture catalog a text spells, none when no row is
# named so
fun arch_named(v: View) opt[*arches.Arch] {
    var i: usize = 0;
    for (i < arch_list.count()) {
        val row: *arches.Arch = arch_list.at(i);
        if (slice.same_view(view_of(row.name), v)) { ret opt[*arches.Arch].some{row}; }
        i = i + 1;
    }
    ret opt[*arches.Arch].none{};
}

# the row of mink's system catalog a text spells, none when no row is named so
fun system_named(v: View) opt[*systems.System] {
    var i: usize = 0;
    for (i < os_list.count()) {
        val row: *systems.System = os_list.at(i);
        if (slice.same_view(view_of(row.name), v)) { ret opt[*systems.System].some{row}; }
        i = i + 1;
    }
    ret opt[*systems.System].none{};
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

# whether a row's default convention is the one a text names, by its name, or none
# for an empty one
fun convention_named(d: Declared, v: View) bool {
    if (sel d.rows) { ret d.rows.default != nil && slice.same_view(view_of(d.rows.default.name), v); }
    ret v.len == 0;
}

# the selection a text baseline spells in the catalog of the set of `arch`,
# none for an empty text, a set masc does not serve or a spelling it refuses
fun selection_named(a: *A.Allocator, arch: *arches.Arch, v: View) res[opt[extension.Selection], Error] {
    val none: opt[extension.Selection] = opt[extension.Selection].none{};
    if (v.len == 0) { ret res[opt[extension.Selection], Error].ok{none}; }
    val found: opt[*mset.Set] = mset.find(?masc_isa.REGISTRY, arch);
    if (sel found.none) { ret res[opt[extension.Selection], Error].ok{none}; }
    val held: res[*char, A.Error] = A.zallocate[char](a, v.len + 1);
    if (sel held.err) { ret res[opt[extension.Selection], Error].err{Error.spelling{held.err}}; }
    val text: str   = held.ok;
    var i:    usize = 0;
    for (i < v.len) {
        text[i] = v.data[i];
        i       = i + 1;
    }
    val made: res[extension.Selection, extension.Error] = extension.select(a, found.some.extensions, text, diagnostic.START);
    A.deallocate[char](a, held.ok, v.len + 1);
    if (sel made.err) {
        if (sel made.err.memory) { ret res[opt[extension.Selection], Error].err{Error.spelling{made.err.memory}}; }
        ret res[opt[extension.Selection], Error].ok{none};
    }
    ret res[opt[extension.Selection], Error].ok{opt[extension.Selection].some{made.ok}};
}

# whether a row's baseline is the one a text spells: the selection masc reads
# from the spelling is the selection of the row's baseline, and an empty text
# is a row that states none
fun baseline_named(a: *A.Allocator, row: *Target, v: View) res[bool, Error] {
    if (!(sel row.baseline.required)) { ret res[bool, Error].ok{v.len == 0}; }
    val read: res[opt[extension.Selection], Error] = selection_named(a, row.arch, v);
    if (sel read.err)     { ret res[bool, Error].err{read.err}; }
    if (sel read.ok.none) { ret res[bool, Error].ok{false}; }
    var named: extension.Selection = read.ok.some;
    fin { extension.release(?named); }
    val made: res[extension.Selection, Error] = record.selection(a, row);
    if (sel made.err) { ret res[bool, Error].err{made.err}; }
    var own: extension.Selection = made.ok;
    fin { extension.release(?own); }
    ret res[bool, Error].ok{record.same_selection(?own, ?named)};
}

# whether a text tuple, each part as its owner spells it, is a target's. the
# text is resolved to rows here, where text meets the target: the
# architecture and system rows of mink's catalogs it names, the convention
# row by its name and the baseline as the selection masc reads from its
# spelling, compared with the target's rows and its baseline's selection
# ---
# a:   the allocator the selections are made in, all given back
# t:   the text tuple
# row: the target
# ret: whether the text is the target's tuple, or why it was not read
pub fun names(a: *A.Allocator, t: Tuple, row: *Target) res[bool, Error] {
    val arch: opt[*arches.Arch]    = arch_named(t.arch);
    val sys:  opt[*systems.System] = system_named(t.system);
    if (sel arch.none)                                   { ret res[bool, Error].ok{false}; }
    if (sel sys.none)                                    { ret res[bool, Error].ok{false}; }
    if (arch.some != row.arch || sys.some != row.system) { ret res[bool, Error].ok{false}; }
    if (!convention_named(row.convention, t.convention)) { ret res[bool, Error].ok{false}; }
    ret baseline_named(a, row, t.baseline);
}

# the target row of a text tuple, none when no row is that tuple
# ---
# a:   the allocator the selections are made in, all given back
# t:   the text tuple
# ret: the row, or why the text was not read
pub fun row_of(a: *A.Allocator, t: Tuple) res[opt[*Target], Error] {
    var i: usize = 0;
    for (i < rows()) {
        val is: res[bool, Error] = names(a, t, ROWS[i]);
        if (sel is.err) { ret res[opt[*Target], Error].err{is.err}; }
        if (is.ok)      { ret res[opt[*Target], Error].ok{opt[*Target].some{ROWS[i]}}; }
        i = i + 1;
    }
    ret res[opt[*Target], Error].ok{opt[*Target].none{}};
}

# the target row of a text tuple for a test, none when no row is that tuple
# or the text was not read
#[testing]
pub fun row_named(a: *A.Allocator, t: Tuple) opt[*Target] {
    val found: res[opt[*Target], Error] = row_of(a, t);
    if (sel found.err) { ret opt[*Target].none{}; }
    ret found.ok;
}

# the first target row the predicate accepts, none when no row does
pub fun first(want: fun(*Target) bool) opt[*Target] {
    var i: usize = 0;
    for (i < rows()) {
        if (want(ROWS[i])) { ret opt[*Target].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Target].none{};
}

# a target that allocates registers and has free control flow
#[testing]
pub fun register_machine(t: *Target) bool {
    ret sel t.caps.registers.allocated && sel t.caps.control.free;
}

# a target with no vector support
#[testing]
pub fun no_vectors(t: *Target) bool {
    ret sel t.caps.vectors.none;
}

# the bytes of a target's pointer in space 0, zero when it states none
fun pointer_bytes(t: *Target) u64 {
    val rows: Slice[Space] = t.caps.widths.pointers;
    var i:    usize        = 0;
    for (i < rows.size) {
        if (rows.data[i].space == 0) {
            val p: Pointer = record.pointer_of(t, ?rows.data[i]);
            if (sel p.physical) { ret p.physical.size; }
            ret 0;
        }
        i = i + 1;
    }
    ret 0;
}

# a target whose pointer in space 0 is four bytes
#[testing]
pub fun four_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 4;
}

# a target whose pointer in space 0 is eight bytes
#[testing]
pub fun eight_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 8;
}

# a target whose control flow must be structured
#[testing]
pub fun requires_structure(t: *Target) bool {
    ret sel t.caps.control.structured;
}

# a target whose shifts take a count modulo the width
#[testing]
pub fun wraps_shifts(t: *Target) bool {
    ret sel t.caps.arithmetic.shifts.wraps;
}

# a target with a multiply form beyond the low half
#[testing]
pub fun multiplies_wide(t: *Target) bool {
    ret sel t.caps.arithmetic.products.forms;
}

# a copy of a target with no convention, which holds a basis and no machine
#[testing]
pub fun unconventional(t: *Target) Target {
    var bare: Target = @t;
    bare.convention = Declared.uncarried{};
    ret bare;
}

# a target whose control flow is free
#[testing]
pub fun leaves_control_free(t: *Target) bool {
    ret sel t.caps.control.free;
}

# a target of 64 bit words that divides at the word with no trap, and has no
# instruction that copies or fills
#[testing]
pub fun divides_quietly(t: *Target) bool {
    val top: opt[u32] = capability.widest(?t.caps);
    if (!(sel top.some))                                          { ret false; }
    if (top.some != 64)                                           { ret false; }
    if (!capability.holds(t.caps.arithmetic.division.widths, 64)) { ret false; }
    ret sel t.caps.arithmetic.division.zero.quiet && sel t.caps.arithmetic.division.overflow.quiet && sel t.caps.bulk.fill.none && sel t.caps.addressing.physical;
}

# a target of 64 bit words that divides a two-word dividend by a word divisor
# at the word, under no condition
#[testing]
pub fun divides_long(t: *Target) bool {
    val top: opt[u32] = capability.widest(?t.caps);
    if (!(sel top.some))                                    { ret false; }
    if (top.some != 64)                                     { ret false; }
    if (!(sel t.caps.arithmetic.division.condition.always)) { ret false; }
    ret capability.runs_long(?t.caps.arithmetic.division, 64);
}

val LONG_WIDENED: [1]u32 = [1]u32{128};

test rows__refuse_a_long_division_at_a_width_they_widen {
    val row: opt[*Target] = first(divides_long);
    if (!(sel row.some)) { ret 1; }
    var wide: Target = @row.some;
    val l:    Long   = Long{widths: Slice[u32]{data: ?LONG_WIDENED[0], size: 1}, zero: Fault.traps{}, exceeds: Fault.traps{}};
    wide.caps.arithmetic.division.long = LongDivision.native{l};
    val f: opt[Fact] = capability.missing(?wide.caps);
    if (!(sel f.some))            { ret 2; }
    if (!(sel f.some.long_width)) { ret 2; }
    if (f.some.long_width != 128) { ret 3; }
    val d: err[Error] = declared(?wide);
    if (!(sel d.err && sel d.err.unstated)) { ret 4; }
    ret 0;
}

#[testing]
fun kept(a: *Attached) opt[*Violation] {
    ret opt[*Violation].none{};
}

#[testing]
val UNSORTED_ENTRIES: [2]Entry = [2]Entry{
    Entry{name: "b", datum: Kind.integer{}, attaches: Attaches.function{}, check: kept},
    Entry{name: "a", datum: Kind.integer{}, attaches: Attaches.function{}, check: kept},
};

# a schema whose entries are out of order, which leaves a target's attributes unstated
#[testing]
val UNSORTED: Schema = Schema{family: "f", entries: Slice[Entry]{data: ?UNSORTED_ENTRIES[0], size: 2}};

test rows__declare_every_capability {
    var i: usize = 0;
    for (i < rows()) {
        val t: *Target    = ROWS[i];
        val d: err[Error] = declared(t);
        if (sel d.err) { ret 1; }
        var bare: Target = @t;
        var caps: Capabilities;
        bare.caps = caps;
        val c: err[Error] = declared(?bare);
        if (!(sel c.err && sel c.err.unstated)) { ret 2; }
        var unsaid: Functions;
        bare                = @t;
        bare.caps.functions = unsaid;
        val fn: err[Error] = declared(?bare);
        if (!(sel fn.err))                    { ret 2; }
        if (!(sel fn.err.unstated))           { ret 2; }
        if (!(sel fn.err.unstated.functions)) { ret 2; }
        var open: Attributes;
        bare                 = @t;
        bare.caps.attributes = open;
        val f: err[Error] = declared(?bare);
        if (!(sel f.err))                     { ret 2; }
        if (!(sel f.err.unstated))            { ret 2; }
        if (!(sel f.err.unstated.attributes)) { ret 2; }
        bare.caps.attributes = Attributes.schema{?UNSORTED};
        val u: err[Error] = declared(?bare);
        if (!(sel u.err))                     { ret 2; }
        if (!(sel u.err.unstated))            { ret 2; }
        if (!(sel u.err.unstated.attributes)) { ret 2; }
        var data: Data;
        bare      = @t;
        bare.data = data;
        val l: err[Error] = declared(?bare);
        if (!(sel l.err && sel l.err.unstated)) { ret 3; }
        var k: usize = 0;
        for (k < i) {
            if (record.same(ROWS[k], t)) { ret 4; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}
