# spir-v for vulkan: logical pointers, with PhysicalStorageBuffer physical
val SPIRV_POINTERS: [10]Space = [10]Space{
    Space{space: 0, pointer: Pointer.logical{}},
    Space{space: 1, pointer: Pointer.logical{}},
    Space{space: 2, pointer: Pointer.logical{}},
    Space{space: 3, pointer: Pointer.logical{}},
    Space{space: 4, pointer: Pointer.logical{}},
    Space{space: 7, pointer: Pointer.logical{}},
    Space{space: 9, pointer: Pointer.logical{}},
    Space{space: 11, pointer: Pointer.logical{}},
    Space{space: 12, pointer: Pointer.logical{}},
    Space{space: 5349, pointer: Pointer.physical{Scalar{size: 8, align: 8}}},
};
val SPIRV_ALU:      [2]u32 = [2]u32{32, 64};
val SPIRV_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
val SPIRV_COUNTS:   [3]u32 = [3]u32{2, 3, 4};
# NMin, NMax, Floor, Ceil, Trunc, RoundEven and OpSelect. FMin and FMax are
# undefined for a nan
val SPIRV_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};
# a constant is an operand of the module
val SPIRV_HELD: [3]Held = [3]Held{
    Held{format: ?BINARY16, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY32, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?SPIRV_NATIVES[0], size: 7}}, constants: Constants.made{}},
};
val SPIRV_LANES: [7]Lane = [7]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY16}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# i1 is one byte in memory, and wider integers are legalised to arrays of i64
val SPIRV_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 8}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val SPIRV_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# spir-v for vulkan. no clang targets it, so its layout has no golden entries
pub val SPIRV_VULKAN: Target = Target{
    name:   "spirv-vulkan",
    arch:   "spirv",
    system: "vulkan",
    caps:   Capabilities{
        registers:  Registers.none{},
        control:    Control.structured{},
        addressing: Addressing.logical{},
        values:     Values.typed{},
        evaluation: Evaluation.register{},
        widths:     Widths{
            pointers: Slice[Space]{data: ?SPIRV_POINTERS[0], size: 10},
            register: Bits.none{},
            alu:      Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
            integers: Set.widths{Slice[u32]{data: ?SPIRV_INTEGERS[0], size: 4}},
        },
        vectors: Vectors.unit{Unit{
            width:  Bits.none{},
            counts: Counts.listed{Slice[u32]{data: ?SPIRV_COUNTS[0], size: 3}},
            lanes:  Slice[Lane]{data: ?SPIRV_LANES[0], size: 7},
        }},
        formats:    Formats.held{Slice[Held]{data: ?SPIRV_HELD[0], size: 3}},
        arithmetic: Arithmetic{
            multiply:   Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}},
            multiplied: Condition.always{},
            products:   Products.none{},
            shifts:     Shifts.undefined{},
            single:     Single.none{},
            # a division by zero or an overflowing one gives an undefined value
            division: Division{widths: Set.widths{Slice[u32]{data: ?SPIRV_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}},
        },
        # a sized copy needs the addresses capability vulkan does not have
        bulk:   BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}},
        timing: Timing.none{},
        code:   Code{
            function: Align.none{},
            text:     Align.none{},
            data:     Align.none{},
            fill:     Fill.none{},
        },
        attributes: Attributes.none{},
    },
    data: Data{
        integers: Slice[IntegerLayout]{data: ?SPIRV_INTEGER_LAYOUT[0], size: 8},
        floats:   Slice[FloatLayout]{data: ?SPIRV_FLOAT_LAYOUT[0], size: 3},
        # vulkan scalar block layout: a vector aligns to its component
        vectors: VectorRule.element{},
    },
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

def Rows: [13]*Target;

val ROWS: Rows = [13]*Target{
    ?RV64_LINUX, ?X86_64_LINUX, ?X86_64_DARWIN, ?X86_64_WINDOWS, ?X86_64_FREESTANDING, ?AARCH64_LINUX, ?AARCH64_DARWIN, ?AARCH64_WINDOWS, ?AARCH64_FREESTANDING, ?RV64_FREESTANDING, ?RV32_LINUX, ?RV32_FREESTANDING, ?SPIRV_VULKAN,
};

# the number of target rows
pub fun rows() usize {
    ret $length_of(Rows);
}

# the target row at an index, none past the last
pub fun row(index: usize) opt[*Target] {
    if (index >= rows()) { ret opt[*Target].none{}; }
    ret opt[*Target].some{ROWS[index]};
}

# the target row of a name, none when no row has it
pub fun by_name(name: View) opt[*Target] {
    var i: usize = 0;
    for (i < rows()) {
        if (slice.same_view(name, View{data: ROWS[i].name, len: str_len(ROWS[i].name)})) { ret opt[*Target].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Target].none{};
}

# the first target row the predicate accepts, none when no row does
pub fun first(want: fun(*Target) bool) opt[*Target] {
    var i: usize = 0;
    for (i < rows()) {
        if (want(ROWS[i])) { ret opt[*Target].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Target].none{};
}

# a target that allocates registers and has free control flow
#[testing]
pub fun register_machine(t: *Target) bool {
    ret sel t.caps.registers.allocated && sel t.caps.control.free;
}

# a target with no vector support
#[testing]
pub fun no_vectors(t: *Target) bool {
    ret sel t.caps.vectors.none;
}

# the bytes of a target's pointer in space 0, zero when it states none
fun pointer_bytes(t: *Target) u64 {
    val rows: Slice[Space] = t.caps.widths.pointers;
    var i:    usize        = 0;
    for (i < rows.size) {
        if (rows.data[i].space == 0) {
            if (sel rows.data[i].pointer.physical) { ret rows.data[i].pointer.physical.size; }
            ret 0;
        }
        i = i + 1;
    }
    ret 0;
}

# a target whose pointer in space 0 is four bytes
#[testing]
pub fun four_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 4;
}

# a target whose pointer in space 0 is eight bytes
#[testing]
pub fun eight_byte_pointer(t: *Target) bool {
    ret pointer_bytes(t) == 8;
}

# a target whose control flow must be structured
#[testing]
pub fun requires_structure(t: *Target) bool {
    ret sel t.caps.control.structured;
}

# a target whose shifts take a count modulo the width
#[testing]
pub fun wraps_shifts(t: *Target) bool {
    ret sel t.caps.arithmetic.shifts.wraps;
}

# a target with a multiply form beyond the low half
#[testing]
pub fun multiplies_wide(t: *Target) bool {
    ret sel t.caps.arithmetic.products.forms;
}

# a target that states a baseline and no convention
#[testing]
pub fun unconventional(t: *Target) bool {
    ret sel t.baseline.extensions && !(sel t.convention.row);
}

# a target whose control flow is free
#[testing]
pub fun leaves_control_free(t: *Target) bool {
    ret sel t.caps.control.free;
}

# a target of 64 bit words that divides at the word with no trap, and has no
# instruction that copies or fills
#[testing]
pub fun divides_quietly(t: *Target) bool {
    val top: opt[u32] = capability.widest(?t.caps);
    if (!(sel top.some))                                          { ret false; }
    if (top.some != 64)                                           { ret false; }
    if (!capability.holds(t.caps.arithmetic.division.widths, 64)) { ret false; }
    ret sel t.caps.arithmetic.division.zero.quiet && sel t.caps.arithmetic.division.overflow.quiet && sel t.caps.bulk.fill.none && sel t.caps.addressing.physical;
}

test rows__declare_every_capability {
    var i: usize = 0;
    for (i < rows()) {
        val t: *Target    = ROWS[i];
        val d: err[Error] = declared(t);
        if (sel d.err) { ret 1; }
        var bare: Target = @t;
        var caps: Capabilities;
        bare.caps = caps;
        val c: err[Error] = declared(?bare);
        if (!(sel c.err && sel c.err.unstated)) { ret 2; }
        var open: Attributes;
        bare                 = @t;
        bare.caps.attributes = open;
        val f: err[Error] = declared(?bare);
        if (!(sel f.err))                     { ret 2; }
        if (!(sel f.err.unstated))            { ret 2; }
        if (!(sel f.err.unstated.attributes)) { ret 2; }
        var data: Data;
        bare      = @t;
        bare.data = data;
        val l: err[Error] = declared(?bare);
        if (!(sel l.err && sel l.err.unstated)) { ret 3; }
        var k: usize = 0;
        for (k < i) {
            if (str_equals(ROWS[k].name, t.name)) { ret 4; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}
