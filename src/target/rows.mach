# the target rows: one per target mirl generates code for
#
# a new target is a new row here, read through the same declarations as
# every other, and never a new case in a pass.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.error.err;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;

use ir: mirl.ir.opcode;
use mirl.ir.type.format.BINARY16;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.machine.class.Memory;
use mirl.slice;
use mirl.target.abi.convention.Declared;
use mirl.target.abi.lp64d.LP64D;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Model;
use mirl.target.address.Relocation;
use mirl.target.address.Threads;
use mirl.target.capability;
use mirl.target.capability.Addressing;
use mirl.target.capability.Align;
use mirl.target.capability.Arithmetic;
use mirl.target.capability.Attributes;
use mirl.target.capability.Bits;
use mirl.target.capability.Bitwise;
use mirl.target.capability.Bulk;
use mirl.target.capability.BulkMemory;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Code;
use mirl.target.capability.Condition;
use mirl.target.capability.Constants;
use mirl.target.capability.Control;
use mirl.target.capability.Counts;
use mirl.target.capability.Data;
use mirl.target.capability.Division;
use mirl.target.capability.Evaluation;
use mirl.target.capability.Fault;
use mirl.target.capability.Fill;
use mirl.target.capability.Fit;
use mirl.target.capability.FloatLayout;
use mirl.target.capability.Form;
use mirl.target.capability.Formats;
use mirl.target.capability.Held;
use mirl.target.capability.IntegerLayout;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.Nans;
use mirl.target.capability.Native;
use mirl.target.capability.Natives;
use mirl.target.capability.Operation;
use mirl.target.capability.Part;
use mirl.target.capability.Pointer;
use mirl.target.capability.Product;
use mirl.target.capability.Products;
use mirl.target.capability.Registers;
use mirl.target.capability.Scalar;
use mirl.target.capability.Set;
use mirl.target.capability.Shifts;
use mirl.target.capability.Sign;
use mirl.target.capability.Single;
use mirl.target.capability.Space;
use mirl.target.capability.Timed;
use mirl.target.capability.Timing;
use mirl.target.capability.Unit;
use mirl.target.capability.Values;
use mirl.target.capability.VectorRule;
use mirl.target.capability.Vectors;
use mirl.target.capability.Widths;
use mirl.target.record.Baseline;
use mirl.target.record.Error;
use mirl.target.record.Target;
use mirl.target.record.declared;

# x86-64 under the sysv psabi, the same for linux, darwin, windows and freestanding
val X86_64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}},
};
# the integer instructions of every width from a byte up
val X86_64_ALU:      [4]u32 = [4]u32{8, 16, 32, 64};
val X86_64_WORDS:    [2]u32 = [2]u32{32, 64};
val X86_64_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
# mul and imul with one operand give the whole product in a register pair
val X86_64_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 64},
};
# roundss and roundsd are sse4.1's. minss and maxss give the second operand
# for a nan or two zeros, so no minimum or maximum is native
val X86_64_NATIVES: [4]Native = [4]Native{
    Native{opcode: ir.FFLOOR, condition: Condition.extension{"sse4.1"}},
    Native{opcode: ir.FCEIL, condition: Condition.extension{"sse4.1"}},
    Native{opcode: ir.FINT, condition: Condition.extension{"sse4.1"}},
    Native{opcode: ir.FNEAREST, condition: Condition.extension{"sse4.1"}},
};
# sse2 computes binary32 and binary64, and returns the first nan operand. a
# float constant is loaded from memory
val X86_64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, nans: Nans.propagate{}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 4}}, constants: Constants.loaded{}},
    Held{format: ?BINARY64, nans: Nans.propagate{}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 4}}, constants: Constants.loaded{}},
};
# intel and amd hold these multiplies and shifts in constant time
val X86_64_TIMED: [5]Timed = [5]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.multiply{}, width: 64, condition: Condition.always{}},
    Timed{operation: Operation.multiply_high{}, width: 64, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 64, condition: Condition.always{}},
};
# the sse2 unit: packed integer lanes of each width, and packed binary32 and binary64
val X86_64_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# int3
val X86_64_FILL: [1]u8 = [1]u8{0xCC};
# the lp64 widths of the sysv psabi, with the c _BitInt widths of clang above 128 bits
val X86_64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 16}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val X86_64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# aarch64 under aapcs64, the same for linux, darwin, windows and freestanding
val AARCH64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}},
};
val AARCH64_ALU:      [2]u32 = [2]u32{32, 64};
val AARCH64_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
# umulh and smulh give the high half, umull and smull the whole product of 32 bit operands
val AARCH64_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
};
# fmin, fmax, the frint forms and fcsel. fminnm and fmaxnm give a nan for a
# signalling nan operand, so neither is the ir's
val AARCH64_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMIN, condition: Condition.always{}},
    Native{opcode: ir.FMAX, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};
# the first operand's nan is not the one returned, so the choice is unspecified.
# a constant is made in a general register and moved
val AARCH64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?AARCH64_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, nans: Nans.unspecified{}, natives: Natives.rows{Slice[Native]{data: ?AARCH64_NATIVES[0], size: 7}}, constants: Constants.made{}},
};
# the multiplies and shifts that are constant time with PSTATE.DIT set
val AARCH64_TIMED: [5]Timed = [5]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.multiply{}, width: 64, condition: Condition.always{}},
    Timed{operation: Operation.multiply_high{}, width: 64, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 64, condition: Condition.always{}},
};
# the neon unit: packed integer lanes of each width, and packed binary32 and binary64
val AARCH64_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# udf #0, as a four byte word
val AARCH64_FILL:           [4]u8            = [4]u8{0, 0, 0, 0};
val AARCH64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 16}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val AARCH64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# riscv64 under the lp64d psabi
val RV64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}},
};
val RV64_ALU: [2]u32 = [2]u32{32, 64};
# and, or, xor and the unsigned compares on a condition held as 0 or 1, whose
# result is 0 or 1 again
val RISCV_BITS:    [4]Bitwise = [4]Bitwise{Bitwise.both{}, Bitwise.either{}, Bitwise.differ{}, Bitwise.compare{}};
val RV64_INTEGERS: [4]u32     = [4]u32{8, 16, 32, 64};
# the M extension's mulhu, mulh and mulhsu
val RV64_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 64},
};
# fmin and fmax of F and D give the other operand for one nan and order
# negative zero below positive zero. zfa adds fminm, fmaxm and fround. no
# instruction selects between floats
val RISCV_NATIVES: [8]Native = [8]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FMIN, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FMAX, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FFLOOR, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FCEIL, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FINT, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FNEAREST, condition: Condition.extension{"zfa"}},
};
# the F and D extensions, whose results are the canonical nan. a constant is
# made in a general register and moved
val RV64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
};
# zkt makes the M extension's multiplies data independent in latency
val RV64_TIMED: [5]Timed = [5]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply{}, width: 64, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply_high{}, width: 64, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 64, condition: Condition.always{}},
};
# c.unimp, so padding traps
val RV64_FILL: [2]u8 = [2]u8{0, 0};
# the lp64 widths of the risc-v elf psabi
val RV64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 16}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# riscv32 under the ilp32d psabi
val RV32_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 4, align: 4}}},
};
val RV32_ALU:      [1]u32     = [1]u32{32};
val RV32_INTEGERS: [3]u32     = [3]u32{8, 16, 32};
val RV32_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 32},
};
# the F and D extensions, whose results are the canonical nan. a general
# register holds a binary32 constant's bits to move, and a binary64 one is
# loaded from read-only data
val RV32_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.loaded{}},
};
# zkt makes the M extension's multiplies data independent in latency
val RV32_TIMED: [3]Timed = [3]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply_high{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
};
# c.unimp, so padding traps
val RV32_FILL: [2]u8 = [2]u8{0, 0};
# the ilp32 widths of the risc-v elf psabi, with the c _BitInt widths of clang above 64 bits
val RV32_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 8}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV32_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# x86-64 linux, the sysv psabi
pub val X86_64_LINUX: Target = Target{
    name:   "x86_64-linux",
    arch:   "x86_64",
    system: "linux",
    caps:   Capabilities{
        registers:  Registers.allocated{},
        control:    Control.free{},
        addressing: Addressing.physical{},
        values:     Values.untyped{},
        evaluation: Evaluation.register{},
        widths:     Widths{
            pointers: Slice[Space]{data: ?X86_64_POINTERS[0], size: 1},
            register: Bits.bits{64},
            alu:      Set.widths{Slice[u32]{data: ?X86_64_ALU[0], size: 4}},
            integers: Set.widths{Slice[u32]{data: ?X86_64_INTEGERS[0], size: 4}},
        },
        vectors: Vectors.unit{Unit{
            width:  Bits.bits{128},
            counts: Counts.any{},
            lanes:  Slice[Lane]{data: ?X86_64_LANES[0], size: 6},
        }},
        formats:    Formats.held{Slice[Held]{data: ?X86_64_HELD[0], size: 2}},
        arithmetic: Arithmetic{
            multiply:   Set.widths{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
            multiplied: Condition.always{},
            products:   Products.forms{Slice[Product]{data: ?X86_64_PRODUCTS[0], size: 4}},
            shifts:     Shifts.wraps{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
            single:     Single.none{},
            # div and idiv raise the divide error for a zero divisor and an overflowing quotient
            division: Division{widths: Set.widths{Slice[u32]{data: ?X86_64_ALU[0], size: 4}}, condition: Condition.always{}, zero: Fault.traps{}, overflow: Fault.traps{}},
        },
        # rep movsb and rep stosb
        bulk:   BulkMemory{copy: Bulk.native{}, fill: Bulk.native{}},
        timing: Timing.rows{Slice[Timed]{data: ?X86_64_TIMED[0], size: 5}},
        code:   Code{
            function: Align.bytes{16},
            text:     Align.bytes{16},
            data:     Align.bytes{8},
            fill:     Fill.pattern{Slice[u8]{data: ?X86_64_FILL[0], size: 1}},
        },
        attributes: Attributes.none{},
    },
    data: Data{
        integers: Slice[IntegerLayout]{data: ?X86_64_INTEGER_LAYOUT[0], size: 8},
        floats:   Slice[FloatLayout]{data: ?X86_64_FLOAT_LAYOUT[0], size: 3},
        vectors:  VectorRule.register{Fit{narrow: 128, widest: 128}},
    },
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

# x86-64 darwin, the sysv psabi
pub val X86_64_DARWIN: Target = Target{
    name:       "x86_64-darwin",
    arch:       "x86_64",
    system:     "darwin",
    caps:       X86_64_LINUX.caps,
    data:       X86_64_LINUX.data,
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

# x86-64 windows, the same rows as linux: the windows difference is c's long, which no row states
pub val X86_64_WINDOWS: Target = Target{
    name:       "x86_64-windows",
    arch:       "x86_64",
    system:     "windows",
    caps:       X86_64_LINUX.caps,
    data:       X86_64_LINUX.data,
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

# x86-64 freestanding, the sysv psabi with no system
pub val X86_64_FREESTANDING: Target = Target{
    name:       "x86_64-freestanding",
    arch:       "x86_64",
    system:     "freestanding",
    caps:       X86_64_LINUX.caps,
    data:       X86_64_LINUX.data,
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

# aarch64 linux, which the system holds PSTATE.DIT set for
pub val AARCH64_LINUX: Target = Target{
    name:   "aarch64-linux",
    arch:   "aarch64",
    system: "linux",
    caps:   Capabilities{
        registers:  Registers.allocated{},
        control:    Control.free{},
        addressing: Addressing.physical{},
        values:     Values.untyped{},
        evaluation: Evaluation.register{},
        widths:     Widths{
            pointers: Slice[Space]{data: ?AARCH64_POINTERS[0], size: 1},
            register: Bits.bits{64},
            alu:      Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
            integers: Set.widths{Slice[u32]{data: ?AARCH64_INTEGERS[0], size: 4}},
        },
        vectors: Vectors.unit{Unit{
            width:  Bits.bits{128},
            counts: Counts.any{},
            lanes:  Slice[Lane]{data: ?AARCH64_LANES[0], size: 6},
        }},
        formats:    Formats.held{Slice[Held]{data: ?AARCH64_HELD[0], size: 2}},
        arithmetic: Arithmetic{
            multiply:   Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
            multiplied: Condition.always{},
            products:   Products.forms{Slice[Product]{data: ?AARCH64_PRODUCTS[0], size: 4}},
            shifts:     Shifts.wraps{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
            single:     Single.none{},
            # udiv and sdiv give 0 for a zero divisor and the dividend for an overflowing quotient
            division: Division{widths: Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}},
        },
        # the memory copy and set instructions are an optional extension the baseline lacks
        bulk:   BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}},
        timing: Timing.rows{Slice[Timed]{data: ?AARCH64_TIMED[0], size: 5}},
        code:   Code{
            function: Align.bytes{16},
            text:     Align.bytes{16},
            data:     Align.bytes{8},
            fill:     Fill.pattern{Slice[u8]{data: ?AARCH64_FILL[0], size: 4}},
        },
        attributes: Attributes.none{},
    },
    data: Data{
        integers: Slice[IntegerLayout]{data: ?AARCH64_INTEGER_LAYOUT[0], size: 8},
        floats:   Slice[FloatLayout]{data: ?AARCH64_FLOAT_LAYOUT[0], size: 3},
        vectors:  VectorRule.register{Fit{narrow: 128, widest: 128}},
    },
    convention: Declared.uncarried{},
    baseline:   Baseline.uncarried{},
    addresses:  Addresses.uncarried{},
    memories:   Slice[Memory]{data: nil, size: 0},
};

