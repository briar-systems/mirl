            data:     Align.bytes{8},
            fill:     Fill.pattern{Slice[u8]{data: ?RV32_FILL[0], size: 2}},
        },
        attributes: Attributes.none{},
    },
    data: Data{
        integers: Slice[IntegerLayout]{data: ?RV32_INTEGER_LAYOUT[0], size: 8},
        floats:   Slice[FloatLayout]{data: ?RV32_FLOAT_LAYOUT[0], size: 3},
        vectors:  VectorRule.register{Fit{narrow: 128, widest: 128}},
        stack:    Align.bytes{16},
    },
};

# riscv32 freestanding, the ilp32d psabi with no system
pub val RV32_FREESTANDING: Target = Target{
    name:   "riscv32-freestanding",
    arch:   "riscv32",
    system: "freestanding",
    caps:   RV32_LINUX.caps,
    data:   RV32_LINUX.data,
};

def Rows: [12]*Target;

val ROWS: Rows = [12]*Target{
    ?RV64_LINUX, ?X86_64_LINUX, ?X86_64_DARWIN, ?X86_64_WINDOWS, ?X86_64_FREESTANDING, ?AARCH64_LINUX, ?AARCH64_DARWIN, ?AARCH64_WINDOWS, ?AARCH64_FREESTANDING, ?RV64_FREESTANDING, ?RV32_LINUX, ?RV32_FREESTANDING,
};

# the number of target rows
pub fun rows() usize {
    ret $length_of(Rows);
}

# the target row at an index, none past the last
pub fun row(index: usize) opt[*Target] {
    if (index >= rows()) { ret opt[*Target].none{}; }
    ret opt[*Target].some{ROWS[index]};
}

# the target row of a name, none when no row has it
pub fun by_name(name: str) opt[*Target] {
    var i: usize = 0;
    for (i < rows()) {
        if (str_equals(ROWS[i].name, name)) { ret opt[*Target].some{ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Target].none{};
}

test rows__declare_every_capability {
    var i: usize = 0;
    for (i < rows()) {
        val t: *Target    = ROWS[i];
        val d: err[Error] = declared(t);
        if (sel d.err) { ret 1; }
        var bare: Target = @t;
        var caps: Capabilities;
        bare.caps = caps;
        val c: err[Error] = declared(?bare);
        if (!(sel c.err && sel c.err.unstated)) { ret 2; }
        var open: Attributes;
        bare                 = @t;
        bare.caps.attributes = open;
        val f: err[Error] = declared(?bare);
        if (!(sel f.err))                     { ret 2; }
        if (!(sel f.err.unstated))            { ret 2; }
        if (!(sel f.err.unstated.attributes)) { ret 2; }
        var data: Data;
        bare      = @t;
        bare.data = data;
        val l: err[Error] = declared(?bare);
        if (!(sel l.err && sel l.err.unstated)) { ret 3; }
        var k: usize = 0;
        for (k < i) {
            if (str_equals(ROWS[k].name, t.name)) { ret 4; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret 0;
}
