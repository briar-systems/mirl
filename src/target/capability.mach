# the capability declarations a target states and the pipeline reads
#
# every declaration's zero case is unstated, so a row left zeroed reads as
# incomplete and never as an answer. a list that may rightly be empty sits
# under a case of its own, so an empty list is a stated answer.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.collections.slice.Slice;

use mirl.ir.opcode.Opcode;
use opcodes: mirl.ir.opcode.table;
use mirl.ir.type.format.Format;
use mirl.ir.type.format.Row;
use mirl.ir.type.format.row;
use mirl.ir.type.format.rows;
use mirl.ir.type.table.WIDTHS;
use legal: mirl.ir.type.table.Widths;

# whether values live in registers the pipeline allocates
pub tag Registers: u8 {
    unstated;
    none;
    allocated;
}

# whether control flow must be structured
pub tag Control: u8 {
    unstated;
    free;
    structured;
}

# how memory is addressed
# ---
# physical: pointers are addresses, and memory can be reinterpreted
# logical:  memory is reached by access chains only, as SPIR-V's is
pub tag Addressing: u8 {
    unstated;
    physical;
    logical;
}

# whether every value carries its type into the output
pub tag Values: u8 {
    unstated;
    untyped;
    typed;
}

# how operations take their operands
# ---
# register: from named values, registers or ids
# stack:    from an operand stack, as WebAssembly does
pub tag Evaluation: u8 {
    unstated;
    register;
    stack;
}

# a width in bits, or none where the target has no such width
pub tag Bits: u8 {
    unstated;
    none;
    bits: u32;
}

# a list of widths in bits, or none where the target has none
pub tag Set: u8 {
    unstated;
    none;
    widths: Slice[u32];
}

# the size and alignment in bytes of a value in memory
# ---
# size:  bytes it occupies
# align: the alignment its address keeps, a power of two
pub rec Scalar {
    size:  u64;
    align: u64;
}

# the size and alignment of a type
# ---
# size:  bytes it occupies, a multiple of its alignment
# align: the alignment its address keeps, a power of two
pub rec Extent {
    size:  u64;
    align: u64;
}

# how a pointer into an address space is held
# ---
# logical:  the pointer has no representation in memory, as a SPIR-V
#           pointer into a logical storage class
# physical: the pointer is an address of this size and alignment
pub tag Pointer: u8 {
    unstated;
    logical;
    physical: Scalar;
}

# a pointer row: what a pointer into one address space is
# ---
# space:   the numbered address space a pointer type names
# pointer: how a pointer into it is held
pub rec Space {
    space:   u32;
    pointer: Pointer;
}

# the widths of the machine
# ---
# pointers: one row per address space the target has, and a pointer into a
#           space with no row is refused
# register: the width of a general register or value slot, none where values
#           have no register width
# alu:      the widths integer arithmetic runs at natively. an integer wider
#           than the widest is split into words of that width
# integers: the integer widths a value holds natively, none wider than the
#           widest arithmetic width, since a wider one is split
pub rec Widths {
    pointers: Slice[Space];
    register: Bits;
    alu:      Set;
    integers: Set;
}

# the type of one lane
pub tag LaneType: u8 {
    unstated;
    integer: u32;
    float:   *Format;
}

# how operations on vectors of a lane type are carried out
# ---
# packed: by vector instructions over the whole vector
# scalar: one lane at a time, by the scalar expansion
pub tag Form: u8 {
    unstated;
    packed;
    scalar;
}

# one lane row of a vector unit
# ---
# lane: the lane type
# form: how operations over it are carried out
pub rec Lane {
    lane: LaneType;
    form: Form;
}

# the lane counts a vector may have
# ---
# any:    every count up to the vector width
# listed: only these counts, as SPIR-V's two, three and four
pub tag Counts: u8 {
    unstated;
    any;
    listed: Slice[u32];
}

# a vector unit
# ---
# width:  the bits of a vector register, none where vectors are values with
#         no register width
# counts: the lane counts a vector may have
# lanes:  the lane types it operates on and the form of each
pub rec Unit {
    width:  Bits;
    counts: Counts;
    lanes:  Slice[Lane];
}

# the vectors a target operates on, none where every vector is scalarised
pub tag Vectors: u8 {
    unstated;
    none;
    unit: Unit;
}

# which not-a-number an operation returns
# ---
# canonical:   always the one canonical nan
# propagate:   the first nan operand, quieted
# unspecified: some nan, whose sign and payload are not defined
pub tag Nans: u8 {
    unstated;
    canonical;
    propagate;
    unspecified;
}

# what must hold for an operation to run in constant time, or to be native
# ---
# always:    nothing
# extension: the named extension is selected, such as RISC-V's zkt or zfa
pub tag Condition: u8 {
    unstated;
    always;
    extension: str;
}

# a float operation a held format may lack, computed natively where its
# condition holds
# ---
# opcode:    the operation, one of `OPTIONAL`
# condition: what must hold for the native form
pub rec Native {
    opcode:    Opcode;
    condition: Condition;
}

# the operations of `OPTIONAL` a format computes natively, none where it has
# none of them
pub tag Natives: u8 {
    unstated;
    none;
    rows: Slice[Native];
}

# how a constant of a format comes to be in a register
# ---
# made:   instructions make it without reading memory
# loaded: it is loaded from read-only data
pub tag Constants: u8 {
    unstated;
    made;
    loaded;
}

# a number format the target computes in natively
# ---
# format:    the row of the number format table, as its constant there
# nans:      the nan its operations return
# natives:   the operations of `OPTIONAL` it computes natively, and when.
#            every other float operation on it is native
# constants: how a constant of it comes to be in a register
pub rec Held {
    format:    *Format;
    nans:      Nans;
    natives:   Natives;
    constants: Constants;
}

# the float operations a held format may lack a native form of. a target's
# natives state which it has, and the float legalisation stands in for the
# rest from operations every held format has
pub def Optional: [9]Opcode;
pub val OPTIONAL: Optional = [9]Opcode{opcodes.FMIN, opcodes.FMAX, opcodes.FMINNUM, opcodes.FMAXNUM, opcodes.FFLOOR, opcodes.FCEIL, opcodes.FINT, opcodes.FNEAREST, opcodes.SELECT};

# whether an opcode is one a held format may lack
pub fun optional(op: Opcode) bool {
    var i: usize = 0;
    for (i < $length_of(Optional)) {
        if (OPTIONAL[i].index == op.index) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the condition under which a held format computes an operation natively,
# none when it never does
pub fun native(h: *Held, op: Opcode) opt[Condition] {
    if (!(sel h.natives.rows)) { ret opt[Condition].none{}; }
    val list: Slice[Native] = h.natives.rows;
    var i:    usize         = 0;
    for (i < list.size) {
        if (list.data[i].opcode.index == op.index) { ret opt[Condition].some{list.data[i].condition}; }
        i = i + 1;
    }
    ret opt[Condition].none{};
}

# the held row of a format, none when the target does not compute in it
pub fun held(c: *Capabilities, f: Format) opt[*Held] {
    if (!(sel c.formats.held)) { ret opt[*Held].none{}; }
    val list: Slice[Held] = c.formats.held;
    var i:    usize       = 0;
    for (i < list.size) {
        if (list.data[i].format != nil && list.data[i].format.index == f.index) { ret opt[*Held].some{?list.data[i]}; }
        i = i + 1;
    }
    ret opt[*Held].none{};
}

# how a shift treats a count at or past its operand's width
# ---
# wraps:     the count is taken modulo the width, at each width listed, and
#            any other width bounds its count first
# undefined: the result is not defined, so every shift bounds its count
# saturates: a shift by the width or more gives zero, or the sign fill for an
#            arithmetic right shift, as the ir states, so no shift needs its
#            count bounded
pub tag Shifts: u8 {
    unstated;
    wraps: Slice[u32];
    undefined;
    saturates;
}

# the number formats a target computes in natively, none where it computes
# in none and every float is expanded
pub tag Formats: u8 {
    unstated;
    none;
    held: Slice[Held];
}

# how a multiply reads its two operands
# ---
# signed:   both as signed
# unsigned: both as unsigned
# mixed:    one as signed and the other as unsigned, in either order
pub tag Sign: u8 {
    unstated;
    signed;
    unsigned;
    mixed;
}

# which part of the product of two operands a multiply form gives
# ---
# high: the upper half, the bits of the exact product from the operand width up
# full: the whole product at twice the operand width, in a register pair or a
#       register of that width. the upper half of it is read out of the pair
#       without another multiply, so a full form also states the high half
pub tag Part: u8 {
    unstated;
    high;
    full;
}

# one multiply form beyond the low half
# ---
# part:  which part of the product it gives
# sign:  how it reads its operands
# width: the width in bits of its operands
pub rec Product {
    part:  Part;
    sign:  Sign;
    width: u32;
}

# the multiply forms beyond the low half, none where the target has none
pub tag Products: u8 {
    unstated;
    none;
    forms: Slice[Product];
}

# an operation on single bits, each held as 0 or 1
# ---
# both:    the bitwise and
# either:  the bitwise or
# differ:  the bitwise exclusive or
# compare: a comparison that reads its operands as unsigned, equality included
pub tag Bitwise: u8 {
    unstated;
    both;
    either;
    differ;
    compare;
}

# the operations on single bits a target selects as they stand, none where it
# selects none and every one is widened
pub tag Single: u8 {
    unstated;
    none;
    operations: Slice[Bitwise];
}

# what a native division does with an operand the ir's division traps on
# ---
# traps: it traps, as the ir's division does
# quiet: it gives some result and goes on, so the zero divisor and the signed
#        overflow are tested before it
pub tag Fault: u8 {
    unstated;
    traps;
    quiet;
}

# the native integer division and remainder
# ---
# widths:    the widths they run at, none where the target has none and a
#            helper divides
# condition: what must hold for them to run at those widths
# zero:      what a division by zero does
# overflow:  what a signed division of the least value by minus one does
pub rec Division {
    widths:    Set;
    condition: Condition;
    zero:      Fault;
    overflow:  Fault;
}

# multiply, shift, division and single bit operations
# ---
# multiply:   the widths with a native multiply giving the low half
# multiplied: what must hold for the multiply and the products to be native
# products:   the multiply forms giving more than the low half, one row for
#             each width and sign
# shifts:     the shift count rule
# single:     the operations on single bits selected without widening
# division:   the native division
pub rec Arithmetic {
    multiply:   Set;
    multiplied: Condition;
    products:   Products;
    shifts:     Shifts;
    single:     Single;
    division:   Division;
}

# whether a target copies or fills a run of bytes in one instruction
# ---
# none:   it has no such instruction, and a helper does it
# native: one instruction does it, which selection emits
pub tag Bulk: u8 {
    unstated;
    none;
    native;
}

# the bulk memory operations
# ---
# copy: a copy of a run of bytes, whose ranges may overlap
# fill: a fill of a run of bytes with one byte
pub rec BulkMemory {
    copy: Bulk;
    fill: Bulk;
}

# an operation whose latency may depend on its operands
pub tag Operation: u8 {
    multiply;
    multiply_high;
    divide;
    shift;
}

# an operation that runs in constant time
# ---
# operation: the operation
# width:     the operand width in bits
# condition: what must hold
pub rec Timed {
    operation: Operation;
    width:     u32;
    condition: Condition;
}

# the operations that run in constant time, none where none is guaranteed
pub tag Timing: u8 {
    unstated;
    none;
    rows: Slice[Timed];
}

# an alignment in bytes, or none where placement has no addresses
pub tag Align: u8 {
    unstated;
    none;
    bytes: u64;
}

# the bytes that pad code between functions
# ---
# none:    code is not padded, as in an indexed format
# pattern: the bytes repeated into padding
pub tag Fill: u8 {
    unstated;
    none;
    pattern: Slice[u8];
}

# placement of code and data
# ---
# function: the alignment of a function's entry
# text:     the alignment of a code section
# data:     the alignment of a data section
# fill:     the code fill
pub rec Code {
    function: Align;
    text:     Align;
    data:     Align;
    fill:     Fill;
}

# the attribute families a target accepts on its functions and globals
# ---
# none:     it accepts no attribute
# families: the names of the families whose attributes it accepts, such as
#           `spirv`
pub tag Attributes: u8 {
    unstated;
    none;
    families: Slice[str];
}

# everything a target declares about generating code for it
pub rec Capabilities {
    registers:  Registers;
    control:    Control;
    addressing: Addressing;
    values:     Values;
    evaluation: Evaluation;
    widths:     Widths;
    vectors:    Vectors;
    formats:    Formats;
    arithmetic: Arithmetic;
    bulk:       BulkMemory;
    timing:     Timing;
    code:       Code;
    attributes: Attributes;
}

# the size and alignment of one integer width
# ---
# width:  the width in bits, one of the type table's legal widths
# scalar: how a value of that width is held in memory
pub rec IntegerLayout {
    width:  u32;
    scalar: Scalar;
}

# the size and alignment of one number format
# ---
# format: the row of the number format table, as its constant there
# scalar: how a value in that format is held in memory
pub rec FloatLayout {
    format: *Format;
    scalar: Scalar;
}

# the vector registers a vector's alignment is fitted to
# ---
# narrow: bits of the narrowest vector register
# widest: bits of the widest
pub rec Fit {
    narrow: u32;
    widest: u32;
}

# how a vector is aligned in memory
# ---
# element:  to its element
# register: a vector at least as wide as the narrowest register aligns to the
#           widest register it fills, and a narrower one to its element
pub tag VectorRule: u8 {
    unstated;
    element;
    register: Fit;
}

# the facts data layout reads beyond the pointer widths
# ---
# integers: one row per legal integer width
# floats:   one row per row of the number format table
# vectors:  the vector alignment rule
pub rec Data {
    integers: Slice[IntegerLayout];
    floats:   Slice[FloatLayout];
    vectors:  VectorRule;
}

# a declaration a target left unstated or stated inconsistently
pub tag Fact: u8 {
    registers;
    control;
    addressing;
    values;
    evaluation;
    pointers;
    register;
    alu;
    integers;
    vectors;
    formats;
    multiply;
    products;
    shifts;
    single;
    division;
    bulk;
    timing;
    function;
    text;
    data;
    fill;
    integer_layout;
    float_layout;
    vector_rule;
    attributes;
    convention;
    baseline;
    addresses;
}

fun listed(widths: Slice[u32]) bool {
    var i: usize = 0;
    for (i < widths.size) {
        if (widths.data[i] == 0) { ret false; }
        i = i + 1;
    }
    ret widths.size != 0;
}

fun lists(s: Set, width: u32) bool {
    if (!(sel s.widths)) { ret false; }
    var i: usize = 0;
    for (i < s.widths.size) {
        if (s.widths.data[i] == width) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether integer arithmetic runs natively at a width
pub fun computes(c: *Capabilities, width: u32) bool {
    ret lists(c.widths.alu, width);
}

# the narrowest width integer arithmetic runs at that is wider than a width,
# none when it runs at no wider width
# ---
# c:     the declarations
# width: the width in bits
# ret:   the width, whether or not arithmetic runs at width itself
pub fun wider(c: *Capabilities, width: u32) opt[u32] {
    if (!(sel c.widths.alu.widths)) { ret opt[u32].none{}; }
    val list:  Slice[u32] = c.widths.alu.widths;
    var found: bool       = false;
    var best:  u32        = 0;
    var i:     usize      = 0;
    for (i < list.size) {
        val w: u32 = list.data[i];
        if (w > width && (!found || w < best)) {
            found = true;
            best  = w;
        }
        i = i + 1;
    }
    if (!found) { ret opt[u32].none{}; }
    ret opt[u32].some{best};
}

# the widest width integer arithmetic runs at, which an integer wider than it
# is split into words of, none when it runs at none
pub fun widest(c: *Capabilities) opt[u32] {
    if (!(sel c.widths.alu.widths)) { ret opt[u32].none{}; }
    val list:  Slice[u32] = c.widths.alu.widths;
    var found: bool       = false;
    var best:  u32        = 0;
    var i:     usize      = 0;
    for (i < list.size) {
        if (!found || list.data[i] > best) {
            found = true;
            best  = list.data[i];
        }
        i = i + 1;
    }
    if (!found) { ret opt[u32].none{}; }
    ret opt[u32].some{best};
}

# whether every width a value holds natively is one arithmetic splits nothing of
fun held_within(c: *Capabilities) bool {
    if (!(sel c.widths.integers.widths)) { ret true; }
    val top: opt[u32] = widest(c);
    if (sel top.none) { ret false; }
    val list: Slice[u32] = c.widths.integers.widths;
    var i:    usize      = 0;
    for (i < list.size) {
        if (list.data[i] > top.some) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the width of a single bit, the one width the single bit operations are kept at
val BIT: u32 = 1;

# whether two single bit operations are the same
fun same_bitwise(a: Bitwise, b: Bitwise) bool {
    if (sel a.both)    { ret sel b.both; }
    if (sel a.either)  { ret sel b.either; }
    if (sel a.differ)  { ret sel b.differ; }
    if (sel a.compare) { ret sel b.compare; }
    ret sel b.unstated;
}

# whether a target selects a single bit operation on operands of a width as it
# stands, which it does only at the width of one bit and for an operation it
# declares
# ---
# c:     the declarations
# op:    the operation
# width: the operand width in bits
pub fun selects_bits(c: *Capabilities, op: Bitwise, width: u32) bool {
    if (width != BIT)                          { ret false; }
    if (!(sel c.arithmetic.single.operations)) { ret false; }
    val list: Slice[Bitwise] = c.arithmetic.single.operations;
    var i:    usize          = 0;
    for (i < list.size) {
        if (same_bitwise(list.data[i], op)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun widths_stated(s: Set) bool {
    if (sel s.widths) { ret listed(s.widths); }
    ret sel s.none;
}

fun power_of_two(n: u64) bool {
    ret n != 0 && (n & (n - 1)) == 0;
}

fun align_stated(a: Align) bool {
    if (sel a.unstated) { ret false; }
    if (sel a.bytes)    { ret power_of_two(a.bytes); }
    ret true;
}

fun pointers_stated(list: Slice[Space]) bool {
    if (list.size == 0) { ret false; }
    var i: usize = 0;
    for (i < list.size) {
        val p: Pointer = list.data[i].pointer;
        if (sel p.unstated)                                                              { ret false; }
        if (sel p.physical && (p.physical.size == 0 || !power_of_two(p.physical.align))) { ret false; }
        var k: usize = 0;
        for (k < i) {
            if (list.data[k].space == list.data[i].space) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun lane_stated(l: Lane) bool {
    if (sel l.form.unstated) { ret false; }
    if (sel l.lane.unstated) { ret false; }
    if (sel l.lane.integer)  { ret l.lane.integer != 0; }
    if (sel l.lane.float) {
        if (l.lane.float == nil) { ret false; }
        val r: opt[Row] = row(@l.lane.float);
        ret sel r.some;
    }
    ret false;
}

fun vectors_stated(v: Vectors) bool {
    if (!(sel v.unit)) { ret sel v.none; }
    val u: Unit = v.unit;
    if (sel u.width.unstated || sel u.counts.unstated)    { ret false; }
    if (sel u.counts.listed && u.counts.listed.size == 0) { ret false; }
    if (u.lanes.size == 0)                                { ret false; }
    var i: usize = 0;
    for (i < u.lanes.size) {
        if (!lane_stated(u.lanes.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a format's natives are stated: each an operation of `OPTIONAL`,
# under a stated condition, and none twice
fun natives_stated(n: Natives) bool {
    if (!(sel n.rows)) { ret sel n.none; }
    val list: Slice[Native] = n.rows;
    if (list.size == 0) { ret false; }
    var seen: [9]bool;
    var i:    usize = 0;
    for (i < list.size) {
        var at: usize = $length_of(Optional);
        var k:  usize = 0;
        for (k < $length_of(Optional)) {
            if (OPTIONAL[k].index == list.data[i].opcode.index) { at = k; }
            k = k + 1;
        }
        if (at == $length_of(Optional))                { ret false; }
        if (seen[at])                                  { ret false; }
        if (!condition_stated(list.data[i].condition)) { ret false; }
        seen[at] = true;
        i        = i + 1;
    }
    ret true;
}

fun formats_stated(f: Formats) bool {
    if (!(sel f.held)) { ret sel f.none; }
    val list: Slice[Held] = f.held;
    if (list.size == 0) { ret false; }
    var i: usize = 0;
    for (i < list.size) {
        if (list.data[i].format == nil) { ret false; }
        val r: opt[Row] = row(@list.data[i].format);
        if (sel r.none)                            { ret false; }
        if (sel list.data[i].nans.unstated)        { ret false; }
        if (sel list.data[i].constants.unstated)   { ret false; }
        if (!natives_stated(list.data[i].natives)) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun shifts_stated(s: Shifts) bool {
    if (sel s.unstated) { ret false; }
    if (sel s.wraps)    { ret listed(s.wraps); }
    ret true;
}

fun single_stated(s: Single) bool {
    if (!(sel s.operations)) { ret sel s.none; }
    val list: Slice[Bitwise] = s.operations;
    var i:    usize          = 0;
    for (i < list.size) {
        if (sel list.data[i].unstated) { ret false; }
        i = i + 1;
    }
    ret list.size != 0;
}

fun division_stated(d: Division) bool {
    ret widths_stated(d.widths) && condition_stated(d.condition) && !(sel d.zero.unstated) && !(sel d.overflow.unstated);
}

fun bulk_stated(b: BulkMemory) bool {
    ret !(sel b.copy.unstated) && !(sel b.fill.unstated);
}

fun condition_stated(c: Condition) bool {
    if (sel c.extension) { ret c.extension != nil && str_len(c.extension) != 0; }
    ret sel c.always;
}

fun product_stated(p: Product) bool {
    ret !(sel p.part.unstated) && !(sel p.sign.unstated) && p.width != 0;
}

fun products_stated(p: Products) bool {
    if (!(sel p.forms)) { ret sel p.none; }
    val list: Slice[Product] = p.forms;
    var i:    usize          = 0;
    for (i < list.size) {
        if (!product_stated(list.data[i])) { ret false; }
        i = i + 1;
    }
    ret list.size != 0;
}

fun timing_stated(t: Timing) bool {
    if (!(sel t.rows)) { ret sel t.none; }
    val list: Slice[Timed] = t.rows;
    var i:    usize        = 0;
    for (i < list.size) {
        if (list.data[i].width == 0)                   { ret false; }
        if (!condition_stated(list.data[i].condition)) { ret false; }
        i = i + 1;
    }
    ret list.size != 0;
}

fun fill_stated(f: Fill) bool {
    if (sel f.unstated) { ret false; }
    if (sel f.pattern)  { ret f.pattern.size != 0; }
    ret true;
}

fun attributes_stated(a: Attributes) bool {
    if (!(sel a.families)) { ret sel a.none; }
    val list: Slice[str] = a.families;
    var i:    usize      = 0;
    for (i < list.size) {
        if (list.data[i] == nil || str_len(list.data[i]) == 0) { ret false; }
        i = i + 1;
    }
    ret list.size != 0;
}

# the first declaration a target leaves unstated or states inconsistently
# ---
# c:   the declarations
# ret: the fact, or none when every declaration is stated
pub fun missing(c: *Capabilities) opt[Fact] {
    if (sel c.registers.unstated)                   { ret opt[Fact].some{Fact.registers{}}; }
    if (sel c.control.unstated)                     { ret opt[Fact].some{Fact.control{}}; }
    if (sel c.addressing.unstated)                  { ret opt[Fact].some{Fact.addressing{}}; }
    if (sel c.values.unstated)                      { ret opt[Fact].some{Fact.values{}}; }
    if (sel c.evaluation.unstated)                  { ret opt[Fact].some{Fact.evaluation{}}; }
    if (!pointers_stated(c.widths.pointers))        { ret opt[Fact].some{Fact.pointers{}}; }
    if (sel c.widths.register.unstated)             { ret opt[Fact].some{Fact.register{}}; }
    if (!widths_stated(c.widths.alu))               { ret opt[Fact].some{Fact.alu{}}; }
    if (!widths_stated(c.widths.integers))          { ret opt[Fact].some{Fact.integers{}}; }
    if (!held_within(c))                            { ret opt[Fact].some{Fact.integers{}}; }
    if (!vectors_stated(c.vectors))                 { ret opt[Fact].some{Fact.vectors{}}; }
    if (!formats_stated(c.formats))                 { ret opt[Fact].some{Fact.formats{}}; }
    if (!widths_stated(c.arithmetic.multiply))      { ret opt[Fact].some{Fact.multiply{}}; }
    if (!condition_stated(c.arithmetic.multiplied)) { ret opt[Fact].some{Fact.multiply{}}; }
    if (!products_stated(c.arithmetic.products))    { ret opt[Fact].some{Fact.products{}}; }
    if (!shifts_stated(c.arithmetic.shifts))        { ret opt[Fact].some{Fact.shifts{}}; }
    if (!single_stated(c.arithmetic.single))        { ret opt[Fact].some{Fact.single{}}; }
    if (!division_stated(c.arithmetic.division))    { ret opt[Fact].some{Fact.division{}}; }
    if (!bulk_stated(c.bulk))                       { ret opt[Fact].some{Fact.bulk{}}; }
    if (!timing_stated(c.timing))                   { ret opt[Fact].some{Fact.timing{}}; }
    if (!align_stated(c.code.function))             { ret opt[Fact].some{Fact.function{}}; }
    if (!align_stated(c.code.text))                 { ret opt[Fact].some{Fact.text{}}; }
    if (!align_stated(c.code.data))                 { ret opt[Fact].some{Fact.data{}}; }
    if (!fill_stated(c.code.fill))                  { ret opt[Fact].some{Fact.fill{}}; }
    if (!attributes_stated(c.attributes))           { ret opt[Fact].some{Fact.attributes{}}; }
    ret opt[Fact].none{};
}

# the signs a multiply form reads its operands as
pub def Signs: [3]Sign;
pub val SIGNS: Signs = [3]Sign{Sign.signed{}, Sign.unsigned{}, Sign.mixed{}};

# whether two signs are the same
pub fun same_sign(a: Sign, b: Sign) bool {
    if (sel a.signed)   { ret sel b.signed; }
    if (sel a.unsigned) { ret sel b.unsigned; }
    if (sel a.mixed)    { ret sel b.mixed; }
    ret sel b.unstated;
}

# whether a set of widths holds a width
pub fun holds(s: Set, width: u32) bool {
    if (!(sel s.widths)) { ret false; }
    var i: usize = 0;
    for (i < s.widths.size) {
        if (s.widths.data[i] == width) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a target has the upper half of the product of two operands of a
# width without another multiply wider than it has: a form that gives the high
# half or the full product, or a native multiply at twice the width, which the
# product of the two extended operands is
# ---
# a:     the arithmetic declarations
# width: the operand width in bits
# sign:  how the operands are read
pub fun reaches_high(a: *Arithmetic, width: u32, sign: Sign) bool {
    if (holds(a.multiply, width * 2)) { ret true; }
    if (!(sel a.products.forms))      { ret false; }
    val list: Slice[Product] = a.products.forms;
    var i:    usize          = 0;
    for (i < list.size) {
        if (list.data[i].width == width && same_sign(list.data[i].sign, sign)) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun scalar_stated(s: Scalar, bits: u32) bool {
    ret power_of_two(s.align) && s.size * 8 >= bits::u64 && s.size % s.align == 0;
}

fun integers_laid(list: Slice[IntegerLayout]) bool {
    if (list.size != $length_of(legal)) { ret false; }
    var i: usize = 0;
    for (i < $length_of(legal)) {
        var found: usize = 0;
        var k:     usize = 0;
        for (k < list.size) {
            if (list.data[k].width == WIDTHS[i]) {
                if (!scalar_stated(list.data[k].scalar, WIDTHS[i])) { ret false; }
                found = found + 1;
            }
            k = k + 1;
        }
        if (found != 1) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun floats_laid(list: Slice[FloatLayout]) bool {
    if (list.size != rows()::usize) { ret false; }
    var i: u32 = 0;
    for (i < rows()) {
        val r: opt[Row] = row(Format{index: i});
        if (sel r.none) { ret false; }
        var found: usize = 0;
        var k:     usize = 0;
        for (k < list.size) {
            if (list.data[k].format != nil && list.data[k].format.index == i) {
                if (!scalar_stated(list.data[k].scalar, r.some.width)) { ret false; }
                found = found + 1;
            }
            k = k + 1;
        }
        if (found != 1) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun rule_stated(v: VectorRule) bool {
    if (sel v.unstated) { ret false; }
    if (sel v.register) {
        val f: Fit = v.register;
        ret f.narrow % 8 == 0 && power_of_two(f.narrow::u64) && power_of_two(f.widest::u64) && f.narrow <= f.widest;
    }
    ret true;
}

# the first layout fact a target leaves unstated or states inconsistently
# ---
# d:   the layout facts
# ret: the fact, or none when every fact is stated
pub fun unlaid(d: *Data) opt[Fact] {
    if (!integers_laid(d.integers)) { ret opt[Fact].some{Fact.integer_layout{}}; }
    if (!floats_laid(d.floats))     { ret opt[Fact].some{Fact.float_layout{}}; }
    if (!rule_stated(d.vectors))    { ret opt[Fact].some{Fact.vector_rule{}}; }
    ret opt[Fact].none{};
}
