# how an address is formed: the value it starts from, the steps past it, and how far each moves it under a layout
#
# a step forms an address past the one its first operand gives: a `ptr.add` of a byte offset, a `ptr.member` of a
# structure at its member's offset, or a `ptr.index` of an array at an index times the array's stride. the address
# legalisation folds the typed two into the first (`mirl.legal.address`), so a reader of open ir and one of legalised
# ir walk the same steps. how far a step moves an address is known where its offset is constant, and it is the
# machine's: an offset or index is read as signed at its own width, an index times the stride and every sum of steps
# wrap at the width of a pointer of the address's space, and the distance is that word read as signed. where the
# space's pointer has no size, as under logical addressing, an offset is a position in a structure and never wraps.
# nothing is derived from an array's length, so a step by an index not constant moves an address by an amount not
# known.
#
# this is the one owner of the walk and of the distances. the slots analysis (`mirl.pass.analysis.slots`), the
# constant-time check of a global's secret bytes (`mirl.ct.global`) and the legalisations' reading of overlap
# (`mirl.legal.overlap`) take it, and the address legalisation folds a constant step by the same arithmetic
# (`element_offset`, `wrap`).
#
# cost: per step, a read of its operands, its immediates and the layout of the type it names.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode.row.Immediate;
use mirl.ir.opcode.row.Opcode;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.layout.Layout;
use target_record: mirl.target.record;

# an address as the value its steps start from and how far they move it
# ---
# root:   the value the steps start from
# known:  whether every step moves it by a known distance
# offset: the distance, wrapped at `bits` and read as signed, where known
# bits:   the width its distances wrap at, a pointer's of its space, 64 where no step names one or the space's
#         pointer has no size
pub rec Formed {
    root:   Value;
    known:  bool;
    offset: i64;
    bits:   u32;
}

# whether an opcode forms an address past the one its first operand gives
pub fun past(code: Opcode) bool {
    ret code == opcode_table.PTR_ADD || code == opcode_table.PTR_MEMBER || code == opcode_table.PTR_INDEX;
}

# whether use `d` of address `v` forms an address past it: a step whose first operand is `v` and no other is
pub fun from(d: *InstructionData, v: Value) bool {
    if (!past(d.opcode) || d.operands.len == 0 || d.operands.data[0] != v) { ret false; }
    var k: usize = 1;
    for (k < d.operands.len) {
        if (d.operands.data[k] == v) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the step that forms address `v` past another, none for a value no step makes
pub fun former(b: *Body, v: Value) opt[Instruction] {
    val def: Def = b.values.data[v].def;
    if (!(sel def.result)) { ret opt[Instruction].none{}; }
    val d: *InstructionData = ?b.instructions.data[def.result.instruction];
    if (!past(d.opcode) || d.operands.len == 0) { ret opt[Instruction].none{}; }
    ret opt[Instruction].some{def.result.instruction};
}

# the value an address is formed from past every step
pub fun root_of(b: *Body, v: Value) Value {
    var at: Value = v;
    for {
        val opt_step: opt[Instruction] = former(b, at);
        if (sel opt_step.none) { brk; }
        at = b.instructions.data[opt_step.some].operands.data[0];
    }
    ret at;
}

# `x` reduced to a word of `bits`, the low `bits` bits kept
pub fun wrap(x: u64, bits: u32) u64 {
    if (bits >= 64) { ret x; }
    ret x & ((1::u64 << bits::u64) - 1);
}

# a word of `bits` read as signed
fun signed(x: u64, bits: u32) i64 {
    if (bits >= 64 || bits == 0)           { ret x::i64; }
    if (((x >> (bits - 1)::u64) & 1) == 0) { ret x::i64; }
    ret (x | (~(0::u64) << bits::u64))::i64;
}

# the byte offset of the element at constant index `known`, read as signed at its type's `width`, of an array of
# stride `stride`, at a word of `bits`
pub fun element_offset(known: u64, width: u32, stride: u64, bits: u32) u64 {
    var index: u64 = known;
    if (width < 64 && width > 0) { index = signed(wrap(index, width), width)::u64; }
    ret wrap(index * stride, bits);
}

# the low word of a constant integer value and the width of its type, none for any other value or one wider than a
# word
fun constant_word(m: *Module, b: *Body, v: Value, width: *u32) opt[u64] {
    val def: Def = b.values.data[v].def;
    if (!(sel def.constant)) { ret opt[u64].none{}; }
    val res_width: res[u32, table.Error] = table.width(?m.types, b.values.data[v].type);
    if (sel res_width.err)                      { ret opt[u64].none{}; }
    if (res_width.ok == 0 || res_width.ok > 64) { ret opt[u64].none{}; }
    @width = res_width.ok;
    val res_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_data.err)           { ret opt[u64].none{}; }
    if (sel res_data.ok.zero)       { ret opt[u64].some{0}; }
    if (!(sel res_data.ok.integer)) { ret opt[u64].none{}; }
    val words: usize = res_data.ok.integer.words.size;
    if (words == 0) { ret opt[u64].some{0}; }
    var k: usize = 1;
    for (k < words) {
        if (res_data.ok.integer.words.data[k] != 0) { ret opt[u64].none{}; }
        k = k + 1;
    }
    ret opt[u64].some{wrap(res_data.ok.integer.words.data[0], res_width.ok)};
}

# the address space of the address a step moves, and the width in bits its distances wrap at: a pointer's of that
# space, or 64 where the space's addresses are no numbers the layout gives a size, as under logical addressing, where
# an offset is a position in a structure and never wraps
fun space_of(m: *Module, l: *Layout, b: *Body, base: Value, space: *u32) opt[u32] {
    val ty:        Type                          = b.values.data[base].type;
    val res_shape: res[table.Shape, table.Error] = table.shape(?m.types, ty);
    if (sel res_shape.err)           { ret opt[u32].none{}; }
    if (!(sel res_shape.ok.pointer)) { ret opt[u32].none{}; }
    @space = res_shape.ok.pointer.space;
    val res_bytes: res[u64, target_record.Error] = layout.size(l, ty, res_shape.ok.pointer.space);
    if (sel res_bytes.err)                     { ret opt[u32].some{64}; }
    if (res_bytes.ok == 0 || res_bytes.ok > 8) { ret opt[u32].none{}; }
    ret opt[u32].some{(res_bytes.ok * 8)::u32};
}

# how far a step moves its address under layout `l`, as a word of `bits` the width of a pointer of its space: a
# `ptr.add`'s constant, a member's offset, or a constant index times the array's stride. none where it is not
# constant or the layout states none
fun moved(m: *Module, l: *Layout, b: *Body, step: Instruction, bits: *u32) opt[u64] {
    val d: *InstructionData = ?b.instructions.data[step];
    if (d.operands.len == 0) { ret opt[u64].none{}; }
    var space:    u32      = table.DEFAULT_SPACE;
    val opt_bits: opt[u32] = space_of(m, l, b, d.operands.data[0], ?space);
    if (sel opt_bits.none) { ret opt[u64].none{}; }
    @bits = opt_bits.some;
    var width: u32 = 0;
    if (d.opcode == opcode_table.PTR_ADD) {
        if (d.operands.len != 2) { ret opt[u64].none{}; }
        val opt_by: opt[u64] = constant_word(m, b, d.operands.data[1], ?width);
        if (sel opt_by.none) { ret opt_by; }
        ret opt[u64].some{wrap(signed(opt_by.some, width)::u64, opt_bits.some)};
    }
    if (d.immediates.len == 0) { ret opt[u64].none{}; }
    val stated: Immediate = d.immediates.data[0];
    if (!(sel stated.ty)) { ret opt[u64].none{}; }
    if (d.opcode == opcode_table.PTR_MEMBER) {
        if (d.immediates.len < 2) { ret opt[u64].none{}; }
        val held: Immediate = d.immediates.data[1];
        if (!(sel held.member)) { ret opt[u64].none{}; }
        val res_offset: res[u64, target_record.Error] = layout.offset(l, stated.ty, space, held.member::u32);
        if (sel res_offset.err) { ret opt[u64].none{}; }
        ret opt[u64].some{wrap(res_offset.ok, opt_bits.some)};
    }
    if (d.opcode != opcode_table.PTR_INDEX || d.operands.len != 2) { ret opt[u64].none{}; }
    val opt_index: opt[u64] = constant_word(m, b, d.operands.data[1], ?width);
    if (sel opt_index.none) { ret opt_index; }
    val res_stride: res[u64, target_record.Error] = layout.stride(l, stated.ty, space);
    if (sel res_stride.err) { ret opt[u64].none{}; }
    ret opt[u64].some{element_offset(opt_index.some, width, res_stride.ok, opt_bits.some)};
}

# how far a step moves its address under layout `l`, wrapped at the width of a pointer of its space and read as
# signed, none where it is not constant or the layout states none
pub fun moved_by(m: *Module, l: *Layout, b: *Body, step: Instruction) opt[i64] {
    var bits:   u32      = 64;
    val opt_by: opt[u64] = moved(m, l, b, step, ?bits);
    if (sel opt_by.none) { ret opt[i64].none{}; }
    ret opt[i64].some{signed(opt_by.some, bits)};
}

# an address as the value its steps start from and how far they move it under layout `l`
pub fun formed(m: *Module, l: *Layout, b: *Body, v: Value) Formed {
    var f:   Formed = Formed{root: v, known: true, offset: 0, bits: 64};
    var sum: u64    = 0;
    for {
        val opt_step: opt[Instruction] = former(b, f.root);
        if (sel opt_step.none) { brk; }
        var bits:   u32      = 64;
        val opt_by: opt[u64] = moved(m, l, b, opt_step.some, ?bits);
        if (sel opt_by.some) {
            f.bits = bits;
            sum    = wrap(sum + opt_by.some, bits);
        }
        or { f.known = false; }
        f.root = b.instructions.data[opt_step.some].operands.data[0];
    }
    f.offset = signed(sum, f.bits);
    ret f;
}

# `f` moved `by` bytes further, wrapped at its pointer's width
pub fun add(f: *Formed, by: i64) {
    f.offset = signed(wrap(f.offset::u64 + by::u64, f.bits), f.bits);
}

# the distance from address `to` up to address `from` of one root, wrapped at the pointer's width and read as signed
pub fun gap(to: Formed, from: Formed) i64 {
    ret signed(wrap(from.offset::u64 - to.offset::u64, from.bits), from.bits);
}
