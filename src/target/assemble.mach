# a target assembled from the five parts of its tuple
#
# a tuple names an architecture, a system and an environment, rows of mink's
# catalogs, a member of the architecture's convention axis and a baseline
# over masc's catalog of the architecture's set. every part is stated and
# none is filled in, so mirl supplies no default for any of them. the
# combination is checked by plain rules read from each part's owner: the
# system runs the architecture under the environment, the environment is the
# system's, the baseline enters the architecture, the convention is the
# architecture's and its requirements hold over the baseline. every fact of
# the target is then read from the axis that owns it, see mirl.target.axis,
# and no list of targets exists.
#
# a caller that has resolved the target through mink and checked it through
# masc assembles it from those with `assemble_resolved`, and the tuple's text
# path is a front that spells, resolves and checks before calling it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_compare;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;

use masc.core.extension;
use masc.core.requirement;
use mset: masc.core.set;
use masc.core.state;
use masc_isa: masc.isa;
use mink.base.fail.Fail;
use arches:    mink.catalog.arch;
use arch_list: mink.catalog.arch.list;
use mink.catalog.code.CodeModel;
use systems: mink.catalog.os;
use os_list: mink.catalog.os.list;
use mink.catalog.output;
use mtarget: mink.catalog.target;

use mirl.base.slice;
use mirl.ir.module.Tuple;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.Declared;
use mirl.target.address.Addresses;
use mirl.target.address.Offer;
use mirl.target.axis;
use mirl.target.record;
use mirl.target.record.Baseline;
use mirl.target.record.Storage;
use mirl.target.record.Target;
use aarch64_axes: mirl.target.register.aarch64.axes;
use riscv_axes:   mirl.target.register.riscv.axes;
use x86_axes:     mirl.target.register.x86.axes;
use spirv_axes:   mirl.target.spirv.axes;
use wasm_axes:    mirl.target.wasm.axes;

# every family's axes. a new family is one entry here
val FAMILIES: [5]*axis.Axes = [5]*axis.Axes{?riscv_axes.AXES, ?x86_axes.AXES, ?aarch64_axes.AXES, ?spirv_axes.AXES, ?wasm_axes.AXES};

# a part of a tuple
pub tag Part: u8 {
    arch;
    sys;
    env;
    abi;
    isa;
}

# what a baseline lacks of one alternative of a requirement
# ---
# lacks: the atoms of the alternative's `all` the baseline does not hold, to add
# bars:  the atoms of the alternative's `none` the baseline holds, to drop
pub rec Lacking {
    lacks: requirement.Ids;
    bars:  requirement.Ids;
}

# what a baseline lacks of a convention's requirement, as atoms of the
# architecture's extension catalog, one entry per alternative in the order the
# requirement states them. the entry with the fewest atoms is the cheapest
# change that admits the convention, see `nearest`. the atoms lie in storage
# the refusal owns until `unmet_release`
# ---
# set:          the architecture's set, whose catalog names the atoms, none when
#               the baseline is uncarried and holds no atom
# alternatives: each alternative's missing atoms
# atoms:        the storage the alternatives' atoms point into
pub rec Requires {
    set:          opt[*mset.Set];
    alternatives: Slice[Lacking];
    atoms:        Slice[requirement.Id];
}

# why a tuple assembles to no target, by the rule it breaks
# ---
# empty:      the tuple leaves this part empty
# arch:       no row of mink's architecture catalog has the architecture's name
# sys:        no row of mink's system catalog has the system's name
# env:        the system has no environment of the name
# none:       the environment is `none` and the system runs every host under
#             an environment
# runs:       the system does not run the architecture under the environment
# machine:    no family states the capabilities of the architecture
# convention: the architecture has no convention of the name
# uncarried:  the architecture has the convention and mirl declines it, with
#             why, naming the convention
# baseline:   masc refuses the baseline's spelling in the catalog of the
#             architecture's set
# enters:     the baseline does not hold the state masc's set says the
#             architecture enters, as an rv32 baseline for riscv64
# requires:   the convention's requirements do not hold over the baseline, with
#             what the baseline lacks of each alternative, released by `unmet_release`
# code:       the build picks a code model mirl carries no row for under the
#             architecture and system
# declined:   the build picks a code model the architecture under the system
#             names and mirl does not carry, with why, naming the model and
#             the target
# alloc:      the allocator refused storage
pub tag Error: u8 {
    empty: Part;
    arch;
    sys;
    env;
    none;
    runs;
    machine;
    convention;
    uncarried: str;
    baseline;
    enters;
    requires: Requires;
    code;
    declined: str;
    alloc:    A.Error;
}

# the rule a refusal names, for diagnostics
pub fun rule(r: Error) str {
    if (sel r.empty)      { ret "a target states every part of its tuple, and none is empty"; }
    if (sel r.arch)       { ret "the architecture is a row of mink's catalog"; }
    if (sel r.sys)        { ret "the system is a row of mink's catalog"; }
    if (sel r.env)        { ret "the environment belongs to the system"; }
    if (sel r.none)       { ret "an environment of none is a system's with a host under none"; }
    if (sel r.runs)       { ret "the system runs the architecture under the environment"; }
    if (sel r.machine)    { ret "a family states the architecture's capabilities"; }
    if (sel r.convention) { ret "the convention belongs to the architecture"; }
    if (sel r.uncarried)  { ret r.uncarried; }
    if (sel r.baseline)   { ret "the baseline is a selection of the architecture's set"; }
    if (sel r.enters)     { ret "the baseline holds the state the architecture enters, its own register width and base"; }
    if (sel r.requires)   { ret "the convention's requirements hold over the baseline"; }
    if (sel r.code)       { ret "the code model the build picks is one mirl carries for the architecture under the system"; }
    if (sel r.declined)   { ret "the code model the build picks is one mirl does not decline for the architecture under the system"; }
    ret "the allocator refused storage";
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

fun named(s: str, v: View) bool {
    ret slice.same_view(view_of(s), v);
}

# the row of mink's architecture catalog a text spells
fun arch_named(v: View) opt[*arches.Arch] {
    var i: usize = 0;
    for (i < arch_list.count()) {
        val row: *arches.Arch = arch_list.at(i);
        if (named(row.name, v)) { ret opt[*arches.Arch].some{row}; }
        i = i + 1;
    }
    ret opt[*arches.Arch].none{};
}

# the row of mink's system catalog a text spells
fun system_named(v: View) opt[*systems.System] {
    var i: usize = 0;
    for (i < os_list.count()) {
        val row: *systems.System = os_list.at(i);
        if (named(row.name, v)) { ret opt[*systems.System].some{row}; }
        i = i + 1;
    }
    ret opt[*systems.System].none{};
}

# the environment of a system a text spells, read from the hosts the system
# states, none when no host of it is under one of the name
fun env_named(s: *systems.System, v: View) opt[*systems.Env] {
    var i: usize = 0;
    for (i < s.host_count) {
        val e: opt[*systems.Env] = s.hosts[i].env;
        if (sel e.some) {
            if (e.some.sys == s && named(e.some.name, v)) { ret opt[*systems.Env].some{e.some}; }
        }
        i = i + 1;
    }
    ret opt[*systems.Env].none{};
}

# whether some host of a system runs under no environment, as vulkan's beside
# its versioned ones
fun runs_bare(s: *systems.System) bool {
    var i: usize = 0;
    for (i < s.host_count) {
        if (sel s.hosts[i].env.none) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the capabilities row of an architecture
fun machine_of(arch: *arches.Arch) opt[*axis.Machine] {
    var f: usize = 0;
    for (f < $length_of([5]*axis.Axes)) {
        val rows: Slice[axis.Machine] = FAMILIES[f].machines;
        var i:    usize               = 0;
        for (i < rows.size) {
            if (rows.data[i].arch == arch) { ret opt[*axis.Machine].some{?rows.data[i]}; }
            i = i + 1;
        }
        f = f + 1;
    }
    ret opt[*axis.Machine].none{};
}

# the members of an architecture's convention axis
fun members_of(arch: *arches.Arch) Slice[axis.Member] {
    var f: usize = 0;
    for (f < $length_of([5]*axis.Axes)) {
        val rows: Slice[axis.Member] = FAMILIES[f].members;
        var i:    usize              = 0;
        for (i < rows.size) {
            if (rows.data[i].abi.arch == arch) { ret rows; }
            i = i + 1;
        }
        f = f + 1;
    }
    ret Slice[axis.Member]{data: nil, size: 0};
}

# the member of an architecture's convention axis that is a psabi row of mink's catalog
fun member_of(members: Slice[axis.Member], abi: *arches.Abi) opt[*axis.Member] {
    var i: usize = 0;
    for (i < members.size) {
        if (members.data[i].abi == abi) { ret opt[*axis.Member].some{?members.data[i]}; }
        i = i + 1;
    }
    ret opt[*axis.Member].none{};
}

# why mirl declines a psabi row of mink's catalog, none where it names no such row
fun declined_of(abi: *arches.Abi) opt[str] {
    var f: usize = 0;
    for (f < $length_of([5]*axis.Axes)) {
        val rows: Slice[axis.Declined] = FAMILIES[f].declined;
        var i:    usize                = 0;
        for (i < rows.size) {
            if (rows.data[i].abi == abi) { ret opt[str].some{rows.data[i].why}; }
            i = i + 1;
        }
        f = f + 1;
    }
    ret opt[str].none{};
}

# the address model row of an architecture under a system, none for a pair no family carries a model of
fun model_of(arch: *arches.Arch, s: *systems.System) opt[*axis.Model] {
    var f: usize = 0;
    for (f < $length_of([5]*axis.Axes)) {
        val rows: Slice[axis.Model] = FAMILIES[f].models;
        var i:    usize             = 0;
        for (i < rows.size) {
            if (rows.data[i].arch == arch && rows.data[i].sys == s) { ret opt[*axis.Model].some{?rows.data[i]}; }
            i = i + 1;
        }
        f = f + 1;
    }
    ret opt[*axis.Model].none{};
}

# whether two code models are one row of mink's catalog, or both none
fun same_model(x: opt[*CodeModel], y: opt[*CodeModel]) bool {
    if (sel x.none) { ret sel y.none; }
    ret sel y.some && y.some == x.some;
}

# whether an output is a shared object, whose exported definitions another
# image may preempt, by the capability of mink's row and never its name. an
# executable and an archive never are
fun interposed(kind: opt[*output.Kind]) bool {
    if (sel kind.none) { ret false; }
    ret output.has(kind.some, output.INTERPOSED);
}

# a row's address model under a code model and an output: the code
# model's, or the row's shared model for a shared object, once mirl carries
# the code model
fun kinded(row: *axis.Model, code: opt[*CodeModel], kind: opt[*output.Kind]) res[Addresses, Error] {
    val coded_by: res[Addresses, Error] = coded(row, code);
    if (sel coded_by.err)  { ret coded_by; }
    if (!interposed(kind)) { ret coded_by; }
    val o: Offer = row.shared;
    if (sel o.declined) { ret res[Addresses, Error].err{Error.declined{o.declined}}; }
    ret res[Addresses, Error].ok{Addresses.model{o.carried}};
}

# a row's address model under a code model of mink's catalog, keyed by its row
fun coded(row: *axis.Model, code: opt[*CodeModel]) res[Addresses, Error] {
    var i: usize = 0;
    for (i < row.codes.size) {
        if (same_model(row.codes.data[i].model, code)) {
            val o: Offer = row.codes.data[i].offer;
            if (sel o.declined) { ret res[Addresses, Error].err{Error.declined{o.declined}}; }
            ret res[Addresses, Error].ok{Addresses.model{o.carried}};
        }
        i = i + 1;
    }
    ret res[Addresses, Error].err{Error.code{}};
}

# whether a closed selection meets a requirement: one of its alternatives
# with every atom held and none of its excluded ones, or no alternative
fun holds(s: *extension.Selection, r: requirement.Requirement) bool {
    if (r.len == 0) { ret true; }
    var i: u32 = 0;
    for (i < r.len) {
        val alt: requirement.Alternative = r.at[i];
        var met: bool                    = true;
        var k:   u32                     = 0;
        for (k < alt.all.len) {
            if (!extension.has(s, alt.all.at[k])) { met = false; }
            k = k + 1;
        }
        k = 0;
        for (k < alt.none.len) {
            if (extension.has(s, alt.none.at[k])) { met = false; }
            k = k + 1;
        }
        if (met) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a carried row's requirements hold over the baseline, none for an
# uncarried baseline, over which only a row that requires nothing holds
fun admitted(s: opt[*extension.Selection], row: *Convention) bool {
    if (sel s.some) { ret holds(s.some, row.requires); }
    ret row.requires.len == 0;
}

# whether a baseline holds an atom, nothing held over an uncarried baseline
fun held(s: opt[*extension.Selection], id: requirement.Id) bool {
    if (sel s.some) { ret extension.has(s.some, id); }
    ret false;
}

# the atoms from `first` up to `end` of a storage, none for an empty run
fun ids_at(atoms: *Slice[requirement.Id], first: u32, end: u32) requirement.Ids {
    if (end == first) { ret requirement.NO_IDS; }
    ret requirement.Ids{at: ?atoms.data[first], len: end - first};
}

# what a baseline lacks of each alternative of a requirement, in storage taken
# from `a`
fun unmet_of(a: *A.Allocator, set: opt[*mset.Set], s: opt[*extension.Selection], r: requirement.Requirement) res[Requires, A.Error] {
    var n: usize = 0;
    var i: u32   = 0;
    for (i < r.len) {
        val alt: requirement.Alternative = r.at[i];
        var k:   u32                     = 0;
        for (k < alt.all.len) {
            if (!held(s, alt.all.at[k])) { n = n + 1; }
            k = k + 1;
        }
        k = 0;
        for (k < alt.none.len) {
            if (held(s, alt.none.at[k])) { n = n + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    val rows: res[*Lacking, A.Error] = A.zallocate[Lacking](a, r.len::usize);
    if (sel rows.err) { ret res[Requires, A.Error].err{rows.err}; }
    var out: Requires = Requires{set: set, alternatives: Slice[Lacking]{data: rows.ok, size: r.len::usize}, atoms: Slice[requirement.Id]{data: nil, size: 0}};
    if (n != 0) {
        val ids: res[*requirement.Id, A.Error] = A.zallocate[requirement.Id](a, n);
        if (sel ids.err) {
            unmet_release(a, ?out);
            ret res[Requires, A.Error].err{ids.err};
        }
        out.atoms = Slice[requirement.Id]{data: ids.ok, size: n};
    }
    var at: u32 = 0;
    i = 0;
    for (i < r.len) {
        val alt:   requirement.Alternative = r.at[i];
        var first: u32                     = at;
        var k:     u32                     = 0;
        for (k < alt.all.len) {
            if (!held(s, alt.all.at[k])) {
                out.atoms.data[at] = alt.all.at[k];
                at                 = at + 1;
            }
            k = k + 1;
        }
        rows.ok[i].lacks = ids_at(?out.atoms, first, at);
        first            = at;
        k                = 0;
        for (k < alt.none.len) {
            if (held(s, alt.none.at[k])) {
                out.atoms.data[at] = alt.none.at[k];
                at                 = at + 1;
            }
            k = k + 1;
        }
        rows.ok[i].bars = ids_at(?out.atoms, first, at);
        i               = i + 1;
    }
    ret res[Requires, A.Error].ok{out};
}

# release the storage a refusal for unmet requirements holds
pub fun unmet_release(a: *A.Allocator, u: *Requires) {
    if (u.atoms.size != 0)        { A.deallocate[requirement.Id](a, u.atoms.data, u.atoms.size); }
    if (u.alternatives.size != 0) { A.deallocate[Lacking](a, u.alternatives.data, u.alternatives.size); }
    u.atoms        = Slice[requirement.Id]{data: nil, size: 0};
    u.alternatives = Slice[Lacking]{data: nil, size: 0};
}

# the alternative with the fewest atoms to change, the first of equals, none
# for a requirement with no alternative
pub fun nearest(u: *Requires) opt[usize] {
    var best: opt[usize] = opt[usize].none{};
    var cost: u32        = 0;
    var i:    usize      = 0;
    for (i < u.alternatives.size) {
        val c: u32 = u.alternatives.data[i].lacks.len + u.alternatives.data[i].bars.len;
        if (sel best.none || c < cost) {
            best = opt[usize].some{i};
            cost = c;
        }
        i = i + 1;
    }
    ret best;
}

# the name the architecture's catalog gives an atom of an unmet requirement,
# none for a refusal with no set or a state value past the catalog
pub fun unmet_name(u: *Requires, id: requirement.Id) opt[str] {
    if (sel u.set.none) { ret opt[str].none{}; }
    val catalog: *extension.Catalog = u.set.some.extensions;
    if (id >= catalog.count) { ret opt[str].none{}; }
    ret opt[str].some{catalog.extensions[id].name};
}

# a text copied into storage with its terminator
fun spelled(a: *A.Allocator, v: View) res[Slice[char], A.Error] {
    val held: res[*char, A.Error] = A.zallocate[char](a, v.len + 1);
    if (sel held.err) { ret res[Slice[char], A.Error].err{held.err}; }
    var i: usize = 0;
    for (i < v.len) {
        held.ok[i] = v.data[i];
        i          = i + 1;
    }
    ret res[Slice[char], A.Error].ok{Slice[char]{data: held.ok, size: v.len + 1}};
}

fun refused(r: Error) res[Target, Error] {
    ret res[Target, Error].err{r};
}

# the baseline's one alternative over every atom a closed selection holds,
# its extensions and its state values, in the target's storage
fun baseline_of(a: *A.Allocator, s: *extension.Selection, t: *Target) res[Baseline, A.Error] {
    var n: u32 = 0;
    var i: u32 = 0;
    for (i < s.catalog.count) {
        if (extension.has(s, i)) { n = n + 1; }
        i = i + 1;
    }
    n = n + s.stated.len;
    val atoms: res[*requirement.Id, A.Error] = A.zallocate[requirement.Id](a, n::usize);
    if (sel atoms.err) { ret res[Baseline, A.Error].err{atoms.err}; }
    t.held.atoms = Slice[requirement.Id]{data: atoms.ok, size: n::usize};
    var at: u32 = 0;
    i = 0;
    for (i < s.catalog.count) {
        if (extension.has(s, i)) {
            atoms.ok[at] = i;
            at           = at + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < s.stated.len) {
        atoms.ok[at] = s.stated.at[i];
        at           = at + 1;
        i            = i + 1;
    }
    val alts: res[*requirement.Alternative, A.Error] = A.zallocate[requirement.Alternative](a, 1);
    if (sel alts.err) { ret res[Baseline, A.Error].err{alts.err}; }
    t.held.alternatives = Slice[requirement.Alternative]{data: alts.ok, size: 1};
    alts.ok[0]          = requirement.Alternative{all: requirement.Ids{at: atoms.ok, len: n}, none: requirement.NO_IDS};
    ret res[Baseline, A.Error].ok{Baseline.required{requirement.Requirement{at: alts.ok, len: 1}}};
}

# the row of a member beside a target's own convention: another carried
# member of its architecture whose requirements hold over the baseline
fun beside(m: *axis.Member, own: *axis.Member, s: opt[*extension.Selection]) opt[*Convention] {
    if (m == own || m.abi.arch != own.abi.arch) { ret opt[*Convention].none{}; }
    val row: opt[*Convention] = m.row;
    if (sel row.none)           { ret row; }
    if (!admitted(s, row.some)) { ret opt[*Convention].none{}; }
    ret row;
}

# the rows the target's own row's bridging brings, then those of an
# architecture's other carried conventions whose requirements hold over the
# baseline, in the target's storage
fun others_of(a: *A.Allocator, members: Slice[axis.Member], own: *axis.Member, s: opt[*extension.Selection], t: *Target) res[Slice[*Convention], A.Error] {
    var bridged: [3]*Convention;
    var brought: usize = 0;
    if (sel own.row.some) { brought = convention.bridged_rows(own.row.some, ?bridged[0]); }
    var n: usize = brought;
    var i: usize = 0;
    for (i < members.size) {
        val row: opt[*Convention] = beside(?members.data[i], own, s);
        if (sel row.some) { n = n + 1; }
        i = i + 1;
    }
    if (n == 0) { ret res[Slice[*Convention], A.Error].ok{Slice[*Convention]{data: nil, size: 0}}; }
    val rows: res[**Convention, A.Error] = A.zallocate[*Convention](a, n);
    if (sel rows.err) { ret res[Slice[*Convention], A.Error].err{rows.err}; }
    t.held.others = Slice[*Convention]{data: rows.ok, size: n};
    var at: usize = 0;
    for (at < brought) {
        rows.ok[at] = bridged[at];
        at          = at + 1;
    }
    i = 0;
    for (i < members.size) {
        val row: opt[*Convention] = beside(?members.data[i], own, s);
        if (sel row.some) {
            rows.ok[at] = row.some;
            at          = at + 1;
        }
        i = i + 1;
    }
    ret res[Slice[*Convention], A.Error].ok{t.held.others};
}

# whether a closed selection of a set enters an architecture the set serves:
# at the architecture's initial state with what the selection states over it,
# the context meets what the set says the architecture enters, as riscv64's
# xlen of 64 on the i base
fun entered(c: *masc_isa.Checked) err[Error] {
    val made: res[state.Context, state.Error] = state.make(?c.selection, ?c.set.states, c.arch.initial);
    if (sel made.err) { ret err[Error].err{Error.baseline{}}; }
    var ctx: state.Context = made.ok;
    if (!state.admits(?ctx, c.arch.enters)) { ret err[Error].err{Error.enters{}}; }
    ret err[Error].ok{};
}

# the target mink's catalog resolves a tuple to and the spelling of the instruction set it names, which it borrows
# ---
# target: the resolved target, whose instruction set masc checks
# isa:    the instruction set's spelling and its terminator
rec Resolved {
    target: mtarget.Target;
    isa:    Slice[char];
}

fun forget(a: *A.Allocator, s: Slice[char]) {
    if (s.size != 0) { A.deallocate[char](a, s.data, s.size); }
}

# the part of a tuple a refusal of mink's resolution names, as the rule the tuple breaks
fun resolution_refused(f: Fail) Error {
    if (sel f.refused.none) { ret Error.runs{}; }
    val p: str = f.refused.some.part;
    if (refuses(p, mtarget.Part.sys{}))        { ret Error.sys{}; }
    if (refuses(p, mtarget.Part.arch{}))       { ret Error.arch{}; }
    if (refuses(p, mtarget.Part.env{}))        { ret Error.env{}; }
    if (refuses(p, mtarget.Part.abi{}))        { ret Error.convention{}; }
    if (refuses(p, mtarget.Part.code_model{})) { ret Error.code{}; }
    if (refuses(p, mtarget.Part.isa{}))        { ret Error.baseline{}; }
    if (refuses(p, mtarget.Part.extension{}))  { ret Error.baseline{}; }
    ret Error.runs{};
}

# whether a refusal's part is `part`, by the name mink calls it
fun refuses(name: str, part: mtarget.Part) bool {
    ret str_compare(name, mtarget.part_name(part)) == 0;
}

# the target mink's catalog resolves the tuple's system and architecture to, narrowed by its environment, convention
# and instruction set and the code model the build picks. an environment of none narrows nothing, and a resolution
# that takes an environment for it is refused, as the system runs the architecture under one
fun resolved(a: *A.Allocator, t: Tuple, sys: *systems.System, arch: *arches.Arch, env: opt[*systems.Env], code: opt[*CodeModel]) res[Resolved, Error] {
    var n:   mtarget.Narrowing = mtarget.UNNARROWED;
    var own: Slice[char]       = Slice[char]{data: nil, size: 0};
    if (sel env.some) {
        val e: res[Slice[char], A.Error] = spelled(a, t.env);
        if (sel e.err) { ret res[Resolved, Error].err{Error.alloc{e.err}}; }
        own   = e.ok;
        n.env = e.ok.data;
    }
    fin { forget(a, own); }
    val b: res[Slice[char], A.Error] = spelled(a, t.abi);
    if (sel b.err) { ret res[Resolved, Error].err{Error.alloc{b.err}}; }
    var abi: Slice[char] = b.ok;
    fin { forget(a, abi); }
    n.abi = abi.data;
    val i: res[Slice[char], A.Error] = spelled(a, t.isa);
    if (sel i.err) { ret res[Resolved, Error].err{Error.alloc{i.err}}; }
    n.isa = i.ok.data;
    if (sel code.some) { n.code_model = code.some.name; }
    val got: res[mtarget.Target, Fail] = mtarget.resolve(mtarget.Spec{sys: sys, arch: arch}, ?n);
    if (sel got.err) {
        forget(a, i.ok);
        ret res[Resolved, Error].err{resolution_refused(got.err)};
    }
    if (sel env.none && sel got.ok.env.some) {
        forget(a, i.ok);
        ret res[Resolved, Error].err{Error.none{}};
    }
    ret res[Resolved, Error].ok{Resolved{target: got.ok, isa: i.ok}};
}

# assemble a target from its tuple, refusing a combination its parts' owners
# rule out, its addresses under the code model mink's catalog gives its
# architecture and system when a target names none
# ---
# a:   the allocator the target's storage comes from, given back by `release`
# t:   the tuple, each part as its owner spells it
# ret: the target, or the rule the tuple breaks, leaving nothing
pub fun assemble(a: *A.Allocator, t: Tuple) res[Target, Error] {
    ret assemble_coded(a, t, opt[*CodeModel].none{}, opt[*output.Kind].none{});
}

# assemble a target from its tuple under a code model the build picks and the
# output it builds into. neither is part of the tuple: objects of two
# code models of one target link into one image, so the build picks it as it
# picks a level, and the kind is the artifact's, which decides what another
# image may preempt. the tuple's parts are read as rows of mink's catalogs,
# resolved through mink and checked through masc, and the target is then
# assembled by `assemble_resolved`
# ---
# a:    the allocator the target's storage comes from, given back by `release`
# t:    the tuple, each part as its owner spells it
# code: the code model, a row of mink's catalog, none for the one mink's
#       hosts of the architecture and system take where a target names none
# kind: the output the code is built into, as `assemble_resolved` reads it
# ret:  the target, or the rule the tuple or the code model breaks, leaving
#       nothing
pub fun assemble_coded(a: *A.Allocator, t: Tuple, code: opt[*CodeModel], kind: opt[*output.Kind]) res[Target, Error] {
    if (t.arch.len == 0) { ret refused(Error.empty{Part.arch{}}); }
    if (t.sys.len == 0)  { ret refused(Error.empty{Part.sys{}}); }
    if (t.env.len == 0)  { ret refused(Error.empty{Part.env{}}); }
    if (t.abi.len == 0)  { ret refused(Error.empty{Part.abi{}}); }
    if (t.isa.len == 0)  { ret refused(Error.empty{Part.isa{}}); }
    val arch: opt[*arches.Arch] = arch_named(t.arch);
    if (sel arch.none) { ret refused(Error.arch{}); }
    val sys: opt[*systems.System] = system_named(t.sys);
    if (sel sys.none) { ret refused(Error.sys{}); }
    var env: opt[*systems.Env] = opt[*systems.Env].none{};
    if (named(record.NONE, t.env)) {
        if (!runs_bare(sys.some)) { ret refused(Error.none{}); }
    }
    or {
        env = env_named(sys.some, t.env);
        if (sel env.none) { ret refused(Error.env{}); }
    }
    if (!systems.runs(sys.some, env, arch.some)) { ret refused(Error.runs{}); }
    val resolving: res[Resolved, Error] = resolved(a, t, sys.some, arch.some, env, code);
    if (sel resolving.err) { ret refused(resolving.err); }
    var r:       Resolved                         = resolving.ok;
    val checked: res[opt[masc_isa.Checked], Fail] = masc_isa.check(a, ?r.target);
    if (sel checked.err) {
        forget(a, r.isa);
        ret refused(Error.baseline{});
    }
    val made: res[Target, Error] = assemble_resolved(a, r.target, checked.ok, code, kind);
    if (sel made.err) {
        forget(a, r.isa);
        ret made;
    }
    var out: Target = made.ok;
    out.held.spelling = r.isa;
    ret res[Target, Error].ok{out};
}

# assemble a target from the target mink's catalog resolved and the selection
# masc checked of its instruction set, refusing a combination mirl does not
# carry. it reads no text and resolves and selects nothing: the caller has
# made both decisions, once, through their owners. the target reaches every
# address under the resolved code model and the output, and a code model
# the build picked for a pair mirl carries no address model of is refused
# ---
# a:       the allocator the target's storage comes from, given back by `release`
# r:       the target `mink.catalog.target.resolve` gave, whose text the target
#          borrows for as long as it is read
# checked: what `masc.isa.check` gave for `r`, none where no registered set
#          serves the architecture. the assembly owns it and gives it back
#          through `masc.isa.release` whatever it returns
# code:    the code model the build picked, the one the narrowing that
#          resolved `r` names, none where `r` takes its host's default. a
#          picked one is refused on a pair no family carries an address
#          model of, whose addresses are otherwise uncarried
# kind:    the output the code is built into, a row of mink's output
#          catalog (`mink.catalog.output`). a shared library takes the
#          row's shared model, and none or any other output the code model's
# ret:     the target, or the rule the combination breaks, leaving nothing
pub fun assemble_resolved(a: *A.Allocator, r: mtarget.Target, checked: opt[masc_isa.Checked], code: opt[*CodeModel], kind: opt[*output.Kind]) res[Target, Error] {
    var chosen: masc_isa.Checked;
    var found:  opt[*mset.Set]            = opt[*mset.Set].none{};
    var picked: opt[*extension.Selection] = opt[*extension.Selection].none{};
    if (sel checked.some) {
        chosen = checked.some;
        found  = opt[*mset.Set].some{chosen.set};
        picked = opt[*extension.Selection].some{?chosen.selection};
    }
    fin {
        if (sel picked.some) { masc_isa.release(?chosen); }
    }
    val machine: opt[*axis.Machine] = machine_of(r.arch);
    if (sel machine.none) { ret refused(Error.machine{}); }
    val abi: systems.Default = r.abi;
    if (!(sel abi.row)) { ret refused(Error.convention{}); }
    val members: Slice[axis.Member] = members_of(r.arch);
    val member:  opt[*axis.Member]  = member_of(members, abi.row);
    if (sel member.none) {
        val why: opt[str] = declined_of(abi.row);
        if (sel why.some) { ret refused(Error.uncarried{why.some}); }
        ret refused(Error.convention{});
    }
    val own:        *axis.Member     = member.some;
    val model:      opt[*axis.Model] = model_of(r.arch, r.sys);
    var addresses:  Addresses        = Addresses.uncarried{};
    var misaligned: bool             = false;
    if (sel model.none && sel code.some) { ret refused(Error.code{}); }
    if (sel model.some) {
        val kinded_by: res[Addresses, Error] = kinded(model.some, r.code_model, kind);
        if (sel kinded_by.err) { ret refused(kinded_by.err); }
        addresses  = kinded_by.ok;
        misaligned = model.some.misaligned;
    }
    var out: Target = Target{arch: r.arch, sys: r.sys, env: r.env, caps: machine.some.caps, data: own.data, convention: Declared.uncarried{own.abi}, isa: Baseline.unstated{}, addresses: addresses, misaligned: misaligned, resolved: r};
    if (sel picked.some) {
        val enters: err[Error] = entered(?chosen);
        if (sel enters.err) { ret refused(enters.err); }
    }
    if (sel own.row.some) {
        if (!admitted(picked, own.row.some)) {
            val lack: res[Requires, A.Error] = unmet_of(a, found, picked, own.row.some.requires);
            if (sel lack.err) { ret refused(Error.alloc{lack.err}); }
            ret refused(Error.requires{lack.ok});
        }
    }
    if (sel picked.some) {
        val b: res[Baseline, A.Error] = baseline_of(a, picked.some, ?out);
        if (sel b.err) {
            release(a, ?out);
            ret refused(Error.alloc{b.err});
        }
        out.isa = b.ok;
    }
    or {
        val spelling: res[str, Fail] = mtarget.isa(?out.resolved);
        if (sel spelling.err) { ret refused(Error.baseline{}); }
        out.isa = Baseline.uncarried{spelling.ok};
    }
    if (sel own.row.some) {
        val rest: res[Slice[*Convention], A.Error] = others_of(a, members, own, picked, ?out);
        if (sel rest.err) {
            release(a, ?out);
            ret refused(Error.alloc{rest.err});
        }
        out.convention = Declared.rows{Conventions{default: own.row.some, rows: rest.ok}};
    }
    ret res[Target, Error].ok{out};
}

# give back the storage an assembled target holds
pub fun release(a: *A.Allocator, t: *Target) {
    if (t.held.atoms.size != 0)        { A.deallocate[requirement.Id](a, t.held.atoms.data, t.held.atoms.size); }
    if (t.held.alternatives.size != 0) { A.deallocate[requirement.Alternative](a, t.held.alternatives.data, t.held.alternatives.size); }
    if (t.held.others.size != 0)       { A.deallocate[*Convention](a, t.held.others.data, t.held.others.size); }
    if (t.held.spelling.size != 0)     { A.deallocate[char](a, t.held.spelling.data, t.held.spelling.size); }
    t.held = Storage{atoms: Slice[requirement.Id]{data: nil, size: 0}, alternatives: Slice[requirement.Alternative]{data: nil, size: 0}, others: Slice[*Convention]{data: nil, size: 0}, spelling: Slice[char]{data: nil, size: 0}};
}

# the psabi row of the convention a target's calls default to, its default
# row's or its uncarried member's
fun convention_abi(d: Declared) *arches.Abi {
    if (sel d.rows)      { ret d.rows.default.abi; }
    if (sel d.uncarried) { ret d.uncarried; }
    ret nil;
}

# whether two targets state one baseline: the same selection of their set, or
# the same uncarried spelling
fun same_baseline(a: *A.Allocator, x: *Target, y: *Target) res[bool, Error] {
    if (sel x.isa.uncarried) {
        if (!(sel y.isa.uncarried)) { ret res[bool, Error].ok{false}; }
        ret res[bool, Error].ok{named(x.isa.uncarried, view_of(y.isa.uncarried))};
    }
    if (!(sel x.isa.required) || !(sel y.isa.required)) { ret res[bool, Error].ok{false}; }
    val one: res[extension.Selection, record.Error] = record.selection(a, x);
    if (sel one.err) { ret res[bool, Error].ok{false}; }
    var p: extension.Selection = one.ok;
    fin { extension.release(?p); }
    val two: res[extension.Selection, record.Error] = record.selection(a, y);
    if (sel two.err) { ret res[bool, Error].ok{false}; }
    var q: extension.Selection = two.ok;
    fin { extension.release(?q); }
    ret res[bool, Error].ok{record.same_selection(?p, ?q)};
}

# whether a tuple assembles to a target: the same rows of mink's catalogs,
# the same convention row and the same baseline selection
# ---
# a:   the allocator the assembly takes, given back
# t:   the tuple
# of:  the target
# ret: whether the tuple is the target's, or the rule it breaks
pub fun names(a: *A.Allocator, t: Tuple, of: *Target) res[bool, Error] {
    val made: res[Target, Error] = assemble(a, t);
    if (sel made.err) { ret res[bool, Error].err{made.err}; }
    var own: Target = made.ok;
    fin { release(a, ?own); }
    if (own.arch != of.arch || own.sys != of.sys) { ret res[bool, Error].ok{false}; }
    if (sel own.env.some) {
        if (!(sel of.env.some))          { ret res[bool, Error].ok{false}; }
        if (own.env.some != of.env.some) { ret res[bool, Error].ok{false}; }
    }
    or (sel of.env.some) { ret res[bool, Error].ok{false}; }
    val theirs: *arches.Abi = convention_abi(of.convention);
    if (theirs == nil || convention_abi(own.convention) != theirs) { ret res[bool, Error].ok{false}; }
    ret same_baseline(a, ?own, of);
}
