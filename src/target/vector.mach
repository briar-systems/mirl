# the vector unit a build splits a fixed-length vector to
#
# a target states its units, each under its condition (`Vectors.units`). a
# vector of a lane type splits to the widest unit the build meets that packs
# that lane type, so an extension a build adds that meets a wider unit, or
# widens a scaled one, changes the pieces. a vector of conditions, a mask, is
# packed where the unit holds masks, each lane taking the bits its masks row
# states. whether an operation is packed on a unit is read from the unit's
# rows (`native`). a function's code reads the split, the holding and the
# rows through its basis and how it requires constant time (`split_for`,
# `holds_for`, `packed`), which add the verdict the family's check left on
# the basis: a function that requires constant time takes a vector of a lane
# type lane by lane where the unit's loads, stores and moves of it are not
# timed relative to scalars of the lane under the modes its code is read
# under, and a row where no rule of it is timed relative to its lanes, and
# every other function packs both. every legalisation of a function's code
# asks through these, so all give one answer for one function. the vector
# legalisation, mirl.legal.vector, reads the split and the rows here and
# never the target's identity.

use std.allocator;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.vector;

use core_state: masc.core.state;

use mirl.ir.function.ConstantTime;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.type.format.Row;
use mirl.ir.type.format.row;
use mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Counts;
use mirl.target.capability.Lane;
use mirl.target.capability.LaneType;
use mirl.target.capability.Operation;
use mirl.target.capability.Unit;
use mirl.target.capability.Vectors;
use mirl.target.capability.Width;

# why a split was not read
# ---
# unstated:  the vectors, a unit's width or the lane type are unstated
# condition: a unit's condition could not be read
# scaled:    a scaled unit was read with no build, or names a slot the
#            build's selection binds no quantity to
pub tag Error: u8 {
    unstated;
    condition: basis.Error;
    scaled;
}

# the allocator's refusal `e` stands for, its own or one a case it carries holds
# ---
# e:   the refusal
# ret: the allocator's refusal, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.condition) { ret basis.starved(e.condition); }
    ret opt[allocator.Error].none{};
}

# the pieces a vector splits into
# ---
# unit:  the unit that holds each piece
# lanes: the lanes of each piece, lane order kept, so piece k holds lanes k
#        times lanes onward. the last holds what is left, which splits again
#        by its own count
pub rec Piece {
    unit:  *Unit;
    lanes: u32;
}

# how a build legalises a vector
# ---
# scalar: one lane at a time, as no unit the build meets packs its lane type
#         in a piece of more than none
# pieces: in pieces a unit holds, a single one when it holds the vector whole
pub tag Split: u8 {
    scalar;
    pieces: Piece;
}

# whether a build meets a unit's condition
# ---
# ctx: the context the build's selection opened, none when it has none
# u:   the unit
# ret: whether it does, or why its condition could not be read
pub fun meets(ctx: opt[*core_state.Context], u: *Unit) res[bool, Error] {
    val res_met: res[bool, basis.Error] = basis.admits(ctx, u.requires);
    if (sel res_met.err) { ret res[bool, Error].err{Error.condition{res_met.err}}; }
    ret res[bool, Error].ok{res_met.ok};
}

# the bits of one lane of a lane type, zero for a condition or a lane of no
# stated width
pub fun bits_of(l: LaneType) u32 {
    if (sel l.integer)  { ret l.integer; }
    if (!(sel l.float)) { ret 0; }
    if (l.float == nil) { ret 0; }
    val opt_row: opt[Row] = row(@l.float);
    if (sel opt_row.none) { ret 0; }
    ret opt_row.some.width;
}

# whether two lane types are the same
pub fun same_lane(a: LaneType, b: LaneType) bool {
    if (sel a.integer) {
        if (!(sel b.integer)) { ret false; }
        ret a.integer == b.integer;
    }
    if (!(sel a.float))                   { ret false; }
    if (!(sel b.float))                   { ret false; }
    if (a.float == nil || b.float == nil) { ret false; }
    ret (@a.float) == (@b.float);
}

# whether a lane type is a condition, the lane of a mask
fun condition(l: LaneType) bool {
    ret sel l.integer && l.integer == 1;
}

# the bits of a unit's width one lane of a lane type takes, zero where the
# unit holds no such lane
fun taken(u: *Unit, lane: LaneType) u32 {
    if (condition(lane)) {
        if (sel u.masks.held) { ret u.masks.held; }
        ret 0;
    }
    ret bits_of(lane);
}

fun packs(u: *Unit, lane: LaneType) bool {
    if (condition(lane)) { ret sel u.masks.held && u.masks.held != 0; }
    var i: usize = 0;
    for (i < u.lanes.size) {
        val l: Lane = u.lanes.data[i];
        if (same_lane(l.lane, lane)) { ret sel l.form.packed; }
        i = i + 1;
    }
    ret false;
}

# the least bits of a unit's register the build holds a fixed-length vector
# in, read by `capability.least_bits`
fun least_bits(ctx: opt[*core_state.Context], w: Width) res[opt[u64], Error] {
    val res_bits: res[opt[u64], capability.Error] = capability.least_bits(ctx, w);
    if (sel res_bits.err) {
        if (sel res_bits.err.scaled) { ret res[opt[u64], Error].err{Error.scaled{}}; }
        ret res[opt[u64], Error].err{Error.unstated{}};
    }
    ret res[opt[u64], Error].ok{res_bits.ok};
}

# the most lanes up to `most` that a unit's counts admit, each lane taking
# `bits` of its width, zero for none
fun fit(c: Counts, most: u32, bits: u32) u32 {
    if (sel c.any) { ret most; }
    if (sel c.bytes) {
        var top: u32   = 0;
        var j:   usize = 0;
        for (j < c.bytes.size) {
            val size: u64 = c.bytes.data[j]::u64 * 8;
            if (bits != 0 && size % bits::u64 == 0) {
                val k: u64 = size / bits::u64;
                if (k <= most::u64 && k::u32 > top) { top = k::u32; }
            }
            j = j + 1;
        }
        ret top;
    }
    if (!(sel c.listed)) { ret 0; }
    var best: u32   = 0;
    var i:    usize = 0;
    for (i < c.listed.size) {
        val k: u32 = c.listed.data[i];
        if (k <= most && k > best) { best = k; }
        i = i + 1;
    }
    ret best;
}

# how a build splits a vector: to the widest unit it meets that packs the
# lane type, the one holding the most of the vector's lanes in a piece, the
# first stated on a tie. a unit holds as many lanes as its least width under
# the build has room for, every count where it has no width, and of those
# only a count it admits
# ---
# ctx:   the context the build's selection opened, none when it has none
# c:     the target's declarations
# lane:  the vector's lane type
# lanes: its lane count
# ret:   the split, or why it could not be read
pub fun split(ctx: opt[*core_state.Context], c: *Capabilities, lane: LaneType, lanes: u32) res[Split, Error] {
    ret splitting(ctx, basis.NONE, ConstantTime.none{}, c, lane, lanes);
}

# how a function's code splits a vector: as `split` does for the function's
# selection, past every unit whose vectors of the lane type the function
# takes lane by lane
# ---
# b:     the function's basis, none when the build has none
# time:  how the function requires constant time
# c:     the target's declarations
# lane:  the vector's lane type
# lanes: its lane count
# ret:   the split, or why it could not be read
pub fun split_for(b: opt[*Basis], time: ConstantTime, c: *Capabilities, lane: LaneType, lanes: u32) res[Split, Error] {
    ret splitting(basis.context_of(b), b, time, c, lane, lanes);
}

fun splitting(ctx: opt[*core_state.Context], b: opt[*Basis], time: ConstantTime, c: *Capabilities, lane: LaneType, lanes: u32) res[Split, Error] {
    val v: Vectors = c.vectors;
    if (sel v.none)                             { ret res[Split, Error].ok{Split.scalar{}}; }
    if (!(sel v.units))                         { ret res[Split, Error].err{Error.unstated{}}; }
    if (!condition(lane) && bits_of(lane) == 0) { ret res[Split, Error].err{Error.unstated{}}; }
    var best: Split = Split.scalar{};
    var most: u32   = 0;
    var i:    usize = 0;
    for (i < v.units.size) {
        val u:       *Unit            = ?v.units.data[i];
        val res_met: res[bool, Error] = meets(ctx, u);
        if (sel res_met.err) { ret res[Split, Error].err{res_met.err}; }
        if (res_met.ok && packs(u, lane) && !unheld(b, time, u, lane)) {
            val res_width: res[opt[u64], Error] = least_bits(ctx, u.width);
            if (sel res_width.err) { ret res[Split, Error].err{res_width.err}; }
            val bits: u32 = taken(u, lane);
            var room: u32 = lanes;
            if (sel res_width.ok.some) {
                val fits: u64 = res_width.ok.some / bits::u64;
                if (fits < room::u64) { room = fits::u32; }
            }
            val held: u32 = fit(u.counts, room, bits);
            if (held > most) {
                most = held;
                best = Split.pieces{Piece{unit: u, lanes: held}};
            }
        }
        i = i + 1;
    }
    ret res[Split, Error].ok{best};
}

# whether a function of `time` requires constant time the verdict `l` takes
# lane by lane
fun takes(l: *basis.Lanewise, time: ConstantTime) bool {
    if (sel time.soft) { ret l.soft; }
    if (sel time.hard) { ret l.hard; }
    ret false;
}

# whether a function of `time` on `b` takes every vector of lane type `lane`
# unit `u` holds lane by lane
fun unheld(b: opt[*Basis], time: ConstantTime, u: *Unit, lane: LaneType) bool {
    if (sel time.none) { ret false; }
    if (sel b.none)    { ret false; }
    val verdict: *vector.Vector[basis.Lanewise] = ?b.some.lanewise;
    var i:       usize                          = 0;
    for (i < verdict.len) {
        val l: *basis.Lanewise = ?verdict.data[i];
        val j: basis.Judged    = l.judged;
        if (sel j.lanes) {
            if (j.lanes.unit == u && same_lane(j.lanes.lane, lane)) { ret takes(l, time); }
        }
        i = i + 1;
    }
    ret false;
}

# whether a function of `time` on `b` takes the operation of row `r` lane by lane
fun row_unpacked(b: opt[*Basis], time: ConstantTime, r: *Operation) bool {
    if (sel time.none) { ret false; }
    if (sel b.none)    { ret false; }
    val verdict: *vector.Vector[basis.Lanewise] = ?b.some.lanewise;
    var i:       usize                          = 0;
    for (i < verdict.len) {
        val l: *basis.Lanewise = ?verdict.data[i];
        val j: basis.Judged    = l.judged;
        if (sel j.row) {
            if (j.row == r) { ret takes(l, time); }
        }
        i = i + 1;
    }
    ret false;
}

# whether a unit computes an operation over packed lanes for a build, by its
# rows: a row of the opcode at the lane type, giving the lane type a
# conversion gives, whose condition the build meets
# ---
# ctx:  the context the build's selection opened, none when it has none
# u:    the unit
# code: the operation
# lane: the lane type of the vector it reads
# to:   the lane type a conversion gives, lane for any other operation
# ret:  whether it does, or why the rows or a condition could not be read
pub fun native(ctx: opt[*core_state.Context], u: *Unit, code: Opcode, lane: LaneType, to: LaneType) res[bool, Error] {
    val res_row: res[opt[*Operation], Error] = row_of(ctx, u, code, lane, to);
    if (sel res_row.err) { ret res[bool, Error].err{res_row.err}; }
    ret res[bool, Error].ok{sel res_row.ok.some};
}

# the row of a unit that computes an operation over packed lanes for a
# build, as `native` reads it, none where no row does
fun row_of(ctx: opt[*core_state.Context], u: *Unit, code: Opcode, lane: LaneType, to: LaneType) res[opt[*Operation], Error] {
    val opt_none: opt[*Operation]       = opt[*Operation].none{};
    val ops:      capability.Operations = u.operations;
    if (sel ops.none)                     { ret res[opt[*Operation], Error].ok{opt_none}; }
    if (!(sel ops.rows))                  { ret res[opt[*Operation], Error].err{Error.unstated{}}; }
    if (!packs(u, lane) || !packs(u, to)) { ret res[opt[*Operation], Error].ok{opt_none}; }
    var i: usize = 0;
    for (i < ops.rows.size) {
        val r: *Operation = ?ops.rows.data[i];
        if (r.opcode == code && same_lane(r.lane, lane) && same_lane(r.to, to)) {
            val res_met: res[bool, basis.Error] = basis.admits(ctx, r.condition);
            if (sel res_met.err) { ret res[opt[*Operation], Error].err{Error.condition{res_met.err}}; }
            if (res_met.ok)      { ret res[opt[*Operation], Error].ok{opt[*Operation].some{r}}; }
        }
        i = i + 1;
    }
    ret res[opt[*Operation], Error].ok{opt_none};
}

# whether a function packs an operation on a unit: the unit computes it for
# the function's selection (`native`), and the function takes neither the
# row nor the vectors of its lane types lane by lane, as the basis's verdict
# states
# ---
# b:    the function's basis, none when the build has none
# time: how the function requires constant time
# u:    the unit
# code: the operation
# lane: the lane type of the vector it reads
# to:   the lane type a conversion gives, lane for any other operation
# ret:  whether it does, or why the rows or a condition could not be read
pub fun packed(b: opt[*Basis], time: ConstantTime, u: *Unit, code: Opcode, lane: LaneType, to: LaneType) res[bool, Error] {
    val res_row: res[opt[*Operation], Error] = row_of(basis.context_of(b), u, code, lane, to);
    if (sel res_row.err)     { ret res[bool, Error].err{res_row.err}; }
    if (sel res_row.ok.none) { ret res[bool, Error].ok{false}; }
    ret res[bool, Error].ok{!unheld(b, time, u, lane) && !unheld(b, time, u, to) && !row_unpacked(b, time, res_row.ok.some)};
}

# whether a unit holds a vector of a lane type and count for a build: the
# build meets it, it packs the lane type, its least width under the build has
# room for the lanes and its counts admit them
# ---
# ctx:   the context the build's selection opened, none when it has none
# u:     the unit
# lane:  the lane type
# lanes: the lane count
# ret:   whether it does, or why its condition or width could not be read
pub fun holds(ctx: opt[*core_state.Context], u: *Unit, lane: LaneType, lanes: u32) res[bool, Error] {
    val res_met: res[bool, Error] = meets(ctx, u);
    if (sel res_met.err)                { ret res_met; }
    if (!res_met.ok || !packs(u, lane)) { ret res[bool, Error].ok{false}; }
    val res_width: res[opt[u64], Error] = least_bits(ctx, u.width);
    if (sel res_width.err) { ret res[bool, Error].err{res_width.err}; }
    val bits: u32 = taken(u, lane);
    if (sel res_width.ok.some) {
        if (bits == 0 || res_width.ok.some / bits::u64 < lanes::u64) { ret res[bool, Error].ok{false}; }
    }
    ret res[bool, Error].ok{fit(u.counts, lanes, bits) == lanes};
}

# the most lanes of a lane type a unit holds in one vector for a build, as
# `holds` admits them, zero where it packs none
# ---
# ctx:  the context the build's selection opened, none when it has none
# u:    the unit
# lane: the lane type
# ret:  the count, none where the unit's width bounds no count, or why its
#       width could not be read
pub fun most_held(ctx: opt[*core_state.Context], u: *Unit, lane: LaneType) res[opt[u32], Error] {
    val bits: u32 = taken(u, lane);
    if (!packs(u, lane) || bits == 0) { ret res[opt[u32], Error].ok{opt[u32].some{0}}; }
    val res_width: res[opt[u64], Error] = least_bits(ctx, u.width);
    if (sel res_width.err)     { ret res[opt[u32], Error].err{res_width.err}; }
    if (sel res_width.ok.none) { ret res[opt[u32], Error].ok{opt[u32].none{}}; }
    val room: u64 = res_width.ok.some / bits::u64;
    if (room > 0xffff_ffff) { ret res[opt[u32], Error].ok{opt[u32].none{}}; }
    ret res[opt[u32], Error].ok{opt[u32].some{fit(u.counts, room::u32, bits)}};
}

# whether a function's code holds a vector of a lane type and count on a
# unit: the unit holds it for the function's selection (`holds`), and the
# function does not take the unit's vectors of the lane type lane by lane
# ---
# b:     the function's basis, none when the build has none
# time:  how the function requires constant time
# u:     the unit
# lane:  the lane type
# lanes: the lane count
# ret:   whether it does, or why its condition or width could not be read
pub fun holds_for(b: opt[*Basis], time: ConstantTime, u: *Unit, lane: LaneType, lanes: u32) res[bool, Error] {
    if (unheld(b, time, u, lane)) { ret res[bool, Error].ok{false}; }
    ret holds(basis.context_of(b), u, lane, lanes);
}

# whether a function of `time` on `b` takes lane by lane, by the basis's
# verdict, the vectors of lane type `lane` some unit holds or a row of `code`
# at that lane type
pub fun timed_lanewise(b: opt[*Basis], time: ConstantTime, lane: LaneType, code: Opcode) bool {
    if (sel time.none) { ret false; }
    if (sel b.none)    { ret false; }
    val verdict: *vector.Vector[basis.Lanewise] = ?b.some.lanewise;
    var i:       usize                          = 0;
    for (i < verdict.len) {
        val l:   *basis.Lanewise = ?verdict.data[i];
        val j:   basis.Judged    = l.judged;
        var hit: bool            = false;
        if (sel j.lanes)           { hit = same_lane(j.lanes.lane, lane); }
        if (sel j.row)             { hit = j.row.opcode == code && same_lane(j.row.lane, lane); }
        if (hit && takes(l, time)) { ret true; }
        i = i + 1;
    }
    ret false;
}
