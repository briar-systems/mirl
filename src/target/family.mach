# a target family: the targets one back end serves, as one registered record
#
# a family admits a target by its declared capabilities alone, opens the
# target's build, states the rows the target runs after the neutral prefix,
# hands the scheduled module to its back end and gives back what it opened.
# compile picks the one family that admits a target, so a family is added as
# one record and one row of mirl.target.families, and nothing else names it.
# a family lists the opcode rows it serves, which only a target one of the
# families listing them serves admits.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use io: std.io.writer;

use mink.base.fail.Fail;
use mink.model.object;

use mct: mirl.ct;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.module.Module;
use mirl.ir.opcode.Row;
use mcompile: mirl.machine.compile;
use pass:     mirl.pass.failure;
use mirl.pass.schedule.Step;
use mirl.target.basis;
use mirl.target.build.Build;
use mirl.target.capability.Capabilities;
use mirl.target.options.Options;
use mirl.target.options.Output;
use mirl.target.record.Target;
use spirv_error: mirl.target.spirv.error;
use mirl.target.warning.Warning;
use wasm_error: mirl.target.wasm.error;

# an instruction whose opcode row is listed only by families that do not serve
# the target
# ---
# row:         the row
# function:    the function that holds it
# instruction: the instruction
pub rec Foreign {
    row:         *Row;
    function:    Function;
    instruction: Instruction;
}

# why a module was not compiled or its object not written
# ---
# unserved:   no family serves the target's declarations, and nothing ran
# several:    more than one family admits the target's declarations, and
#             nothing ran
# foreign:    the module of a checked build holds a row the target does not
#             admit, and nothing ran
# open:       the family did not open the target's build
# schedule:   the pass schedule failed
# introduced: the schedule left a row the target does not admit in the module
#             of a checked build, and the back end did not run
# timing:     a function that requires constant time holds a secret where
#             it may hold none, or the target's set classifies no timing, and
#             the back end did not run
# alloc:      the allocator refused storage
# output:     the family's back end writes no output of this kind
# register:   the register family's back end, mirl.machine.compile, refused
#             the scheduled module, with where in it
# wasm:       the webassembly family's back end, mirl.target.wasm.module,
#             refused the scheduled module
# spirv:      the spir-v family's back end, mirl.target.spirv.module, refused
#             the scheduled module
# format:     mink does not lay out the system's object format, or refused
#             the object
# link:       mink's link of the object into the image refused it, holding until
#             the build is closed
# write:      the object's bytes were not written
pub tag Error: u8 {
    unserved;
    several;
    foreign:    Foreign;
    open:       basis.Error;
    schedule:   pass.Error;
    introduced: Foreign;
    timing:     mct.Refused;
    alloc:      allocator.Error;
    output:     Output;
    register:   mcompile.Failed;
    wasm:       wasm_error.Error;
    spirv:      spirv_error.Error;
    format:     Fail;
    link:       Fail;
    write:      io.WriteError;
}

# whether a family admits a target with these declarations
pub def Admits: fun(*Capabilities) bool;

# open a target's build in place with the extensions a build adds, leaving
# nothing to close when it refuses
pub def Open: fun(*Build, *allocator.Allocator, *Target, Slice[str]) err[Error];

# compile a scheduled module over the build into mink's object, appending each
# warning it gives to the list it is handed
pub def Compile: fun(*allocator.Allocator, *Module, *Build, *Target, Options, *vector.Vector[Warning]) res[object.Object, Error];

# give back what `open` made
pub def Close: fun(*Build);

# one family
# ---
# name:    its name, for diagnostics alone
# admits:  the targets it serves, by their declarations
# legal:   its rows, which run after the neutral prefix over the build it
#          opened: every legalisation, and the neutral rows it runs again
#          after them
# open:    the opening of a target's build
# back:    its back end
# close:   the release of a build it opened
# opcodes: the opcode rows it lists, by their identity, which a target no family
#          listing them serves refuses
pub rec Family {
    name:    str;
    admits:  Admits;
    legal:   Slice[Step];
    open:    Open;
    back:    Compile;
    close:   Close;
    opcodes: Slice[*Row];
}
