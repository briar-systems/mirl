# a target family: the targets one back end serves, as one registered record
#
# a family admits a target by its declared capabilities alone, opens the
# target's build, states the rows the target runs after the neutral prefix,
# hands the scheduled module to its back end and gives back what it opened.
# compile picks the one family that admits a target, so a family is added as
# one record and one row of mirl.target.families, and nothing else names it.
# a family lists the opcode rows it owns, which only a target it serves admits.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;
use io: std.io.writer;

use mink.model.object;

use mct: mirl.ct;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.module.Module;
use mirl.ir.opcode.Row;
use mcompile: mirl.machine.compile;
use pass:     mirl.pass.failure;
use mirl.pass.relaxation.Relaxations;
use mirl.pass.schedule.Level;
use mirl.pass.schedule.Step;
use mirl.target.basis;
use mirl.target.build.Build;
use mirl.target.capability.Capabilities;
use mirl.target.record.Target;
use spirv_error: mirl.target.spirv.error;
use wasm_error:  mirl.target.wasm.error;

# what a back end writes
# ---
# object: a relocatable object, which a link takes with others
# image:  a final image the target loads as it is, as a whole wasm module
pub tag Output: u8 {
    object;
    image;
}

# how a module is compiled
# ---
# output:   what the back end writes, a relocatable object or a final image
# level:    the optimisation level
# checked:  verify the module after every pass and every function after every
#           stage
# added:    extension names the build adds to the target's baseline
# machine:  where the machine form text of the laid out functions is written, none for none
# listing:  where masc's listing of the object is written, none for none
# warnings: where a warning the compilation gives is written, none for none
# relax:    whether the linker may relax the code, which a back end hands to
#           its set's relax mode, RELAX unless the build says otherwise
# floats:   the float relaxations the build permits, read through
#           mirl.pass.relaxation, none for exact semantics
pub rec Options {
    output:   Output;
    level:    Level;
    checked:  bool;
    added:    Slice[str];
    machine:  opt[*io.Writer];
    listing:  opt[*io.Writer];
    warnings: opt[*io.Writer];
    relax:    bool;
    floats:   Relaxations;
}

# whether a build lets the linker relax its code when it does not say
# owner ruling 2026-10-23 (#286): risc-v linker relaxation is on by default
pub val RELAX: bool = true;

# why no one family serves a target
# ---
# none:    no family admits its declarations
# several: more than one family admits them
pub tag Unserved: u8 {
    none;
    several;
}

# why a family's back end refused a scheduled module, one case per family
# ---
# register: the register family's, mirl.machine.compile
# wasm:     the webassembly family's, mirl.target.wasm.module
# spirv:    the spir-v family's, mirl.target.spirv.module
pub tag Back: u8 {
    register: mcompile.Error;
    wasm:     wasm_error.Error;
    spirv:    spirv_error.Error;
}

# why a registry's listings give no owners of the opcode rows
# ---
# alloc: the allocator refused storage
# twice: a row two listings name, which has no one owner
pub tag Listing: u8 {
    alloc: allocator.Error;
    twice: *Row;
}

# an instruction whose opcode row a family owns that does not serve the target
# ---
# row:         the row
# function:    the function that holds it
# instruction: the instruction
pub rec Foreign {
    row:         *Row;
    function:    Function;
    instruction: Instruction;
}

# why a module was not compiled
# ---
# unserved:   no one family serves the target's declarations, and nothing ran
# listing:    the registry's listings give no owners of the opcode rows, and
#             nothing ran
# foreign:    the module holds a row the target does not admit, and nothing ran
# open:       the family did not open the target's build
# schedule:   the pass schedule failed
# introduced: the schedule left a row the target does not admit, and the back
#             end did not run
# timing:     a function that requires constant time holds a secret where
#             it may hold none, or the target's set classifies no timing, and
#             the back end did not run
# alloc:      the allocator refused storage
# output:     the family's back end writes no output of this kind
# back:       the family's back end refused the scheduled module
pub tag Error: u8 {
    unserved:   Unserved;
    listing:    Listing;
    foreign:    Foreign;
    open:       basis.Error;
    schedule:   pass.Error;
    introduced: Foreign;
    timing:     mct.Refused;
    alloc:      allocator.Error;
    output:     Output;
    back:       Back;
}

# whether a family admits a target with these declarations
pub def Admits: fun(*Capabilities) bool;

# open a target's build in place with the extensions a build adds, leaving
# nothing to close when it refuses
pub def Open: fun(*Build, *allocator.Allocator, *Target, Slice[str]) err[Error];

# compile a scheduled module over the build into mink's object
pub def Compile: fun(*allocator.Allocator, *Module, *Build, *Target, Options) res[object.Object, Error];

# give back what `open` made
pub def Close: fun(*Build);

# one family
# ---
# name:    its name, for diagnostics alone
# admits:  the targets it serves, by their declarations
# legal:   its rows, which run after the neutral prefix over the build it
#          opened: every legalisation, and the neutral rows it runs again
#          after them
# open:    the opening of a target's build
# back:    its back end
# close:   the release of a build it opened
# opcodes: the opcode rows it owns, by their identity, which a target it does
#          not serve refuses
pub rec Family {
    name:    str;
    admits:  Admits;
    legal:   Slice[Step];
    open:    Open;
    back:    Compile;
    close:   Close;
    opcodes: Slice[*Row];
}
