pub val SMIN_64: Loop = Loop{name: "cas_smin_64", constraint: ?CAS, roles: ROLES, before: Parts{at: ?BEFORE_64[0], len: 1}, body: Parts{at: ?SMIN_64_BODY[0], len: 1}, after: Parts{at: ?AFTER_64[0], len: 1}, jump: JUMP};

# the greater of the value held and the operand, unsigned, of 64 bits
pub val UMAX_64: Loop = Loop{name: "cas_umax_64", constraint: ?CAS, roles: ROLES, before: Parts{at: ?BEFORE_64[0], len: 1}, body: Parts{at: ?UMAX_64_BODY[0], len: 1}, after: Parts{at: ?AFTER_64[0], len: 1}, jump: JUMP};

# the lesser of the value held and the operand, unsigned, of 64 bits
pub val UMIN_64: Loop = Loop{name: "cas_umin_64", constraint: ?CAS, roles: ROLES, before: Parts{at: ?BEFORE_64[0], len: 1}, body: Parts{at: ?UMIN_64_BODY[0], len: 1}, after: Parts{at: ?AFTER_64[0], len: 1}, jump: JUMP};

val LIST: [32]*Loop = [32]*Loop{?AND_8, ?OR_8, ?XOR_8, ?NAND_8, ?SMAX_8, ?SMIN_8, ?UMAX_8, ?UMIN_8, ?AND_16, ?OR_16, ?XOR_16, ?NAND_16, ?SMAX_16, ?SMIN_16, ?UMAX_16, ?UMIN_16, ?AND_32, ?OR_32, ?XOR_32, ?NAND_32, ?SMAX_32, ?SMIN_32, ?UMAX_32, ?UMIN_32, ?AND_64, ?OR_64, ?XOR_64, ?NAND_64, ?SMAX_64, ?SMIN_64, ?UMAX_64, ?UMIN_64};

# the x86-64 loops
pub val LOOPS: Loops = Loops{at: ?LIST[0], len: 32};
