# the x86-64 loops: the read-modify-writes no locked instruction does, each
# a compare and swap retried until it stores
#
# x86 has a locked add, exchange and compare and exchange, which the rules
# select as they stand, and no locked and, or, exclusive or, nand, minimum or
# maximum that gives the value held before. each is a loop around lock
# cmpxchg: the value held is loaded into the accumulator before the body, the
# body computes the value to store from it in a scratch register and swaps,
# and cmpxchg, which loads the value it found into the accumulator when the
# swap fails, clears zf then, so the body runs again while zf is clear. the
# value held before is the accumulator after the body. every loop shares its
# operand positions:
#
#   0  the value held before, written
#   1  the address, read
#   2  the operand, read
#   3  a scratch register, the value stored, written
#
# a field of 8 or 16 bits is swapped at its own width, so no loop works on a
# word around it. the steps between the load and the swap are the general
# instructions of the width rows, which the plain atoms admit, and the swap is
# one of them too, so a body is one access, the swap, around rows that touch
# no memory, which CAS states.

use mo: masc.core.operand;
use masc.core.requirement;
use x86_extension: masc.isa.x86.gen_extension;
use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;

use masc.isa.x86.gen_register;
use mirl.machine.loop.row.Constraint;
use mirl.machine.loop.row.Kind;
use mirl.machine.loop.row.Loop;
use mirl.machine.loop.row.Loops;
use mirl.machine.loop.row.Parts;
use mirl.machine.loop.row.Roles;
use mirl.machine.loop.row.Source;
use mirl.machine.loop.row.Sources;
use mirl.machine.loop.row.Step;
use mirl.machine.loop.row.Steps;

val JUMP: Step = Step{row: ?gen_row.ROWS[gen_row_index.JMP_REL32_E9], operands: Sources{at: ?TO[0], len: 1}};

# a body of general rows of any code width around one lock cmpxchg, which is
# one of them, held to sixteen instructions as the other targets' are
val WIDTHS: [3]requirement.Id = [3]requirement.Id{x86_extension.WIDTH_16, x86_extension.WIDTH_32, x86_extension.WIDTH_64};

pub val CAS: Constraint = Constraint{kind: Kind.cas{}, limit: 16, plain: requirement.Ids{at: ?WIDTHS[0], len: 3}, atomic: requirement.Ids{at: ?WIDTHS[0], len: 3}};

val ROLE_LIST: [4]mo.Role = [4]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.WRITE};
val ROLES:     Roles      = Roles{at: ?ROLE_LIST[0], len: 4};

val TO:              [1]Source = [1]Source{Source.target{}};
val REPEAT:          [1]Source = [1]Source{Source.head{}};
