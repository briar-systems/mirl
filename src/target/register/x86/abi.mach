# a sysv64 eightbyte class, in the order the merge prefers
# ---
# none:    nothing lies in it
# sse:     a float or vector part, in a vector register
# sseup:   the upper half of a vector register the sse eightbyte before takes
# integer: an integer or pointer part, in an integer register
# x87:     the significand of an x87 extended float
# x87up:   its sign and exponent
# memory:  it travels in memory
tag Class: u8 {
    none;
    sse;
    sseup;
    integer;
    x87;
    x87up;
    memory;
}

# the merge of the classes of two parts sharing an eightbyte, psabi 3.2.3 4(c)
fun merge(a: Class, b: Class) Class {
    if (same(a, b))                                           { ret a; }
    if (sel a.none)                                           { ret b; }
    if (sel b.none)                                           { ret a; }
    if (sel a.memory || sel b.memory)                         { ret Class.memory{}; }
    if (sel a.integer || sel b.integer)                       { ret Class.integer{}; }
    if (sel a.x87 || sel a.x87up || sel b.x87 || sel b.x87up) { ret Class.memory{}; }
    ret Class.sse{};
}

fun same(a: Class, b: Class) bool {
    if (sel a.none)    { ret sel b.none; }
    if (sel a.sse)     { ret sel b.sse; }
    if (sel a.sseup)   { ret sel b.sseup; }
    if (sel a.integer) { ret sel b.integer; }
    if (sel a.x87)     { ret sel b.x87; }
    if (sel a.x87up)   { ret sel b.x87up; }
    ret sel b.memory;
}

fun laid(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.size; }
    ret 0;
}

fun alignment(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.align; }
    ret 1;
}

fun round(v: u64, to: u64) u64 {
    ret (v + to - 1) / to * to;
}

# the eightbyte classes of a value of at most two eightbytes
rec Classes {
    at:     [2]Class;
    memory: bool;
}

fun mark(c: *Classes, offset: u64, k: Class) {
    if (offset >= 16) {
        c.memory = true;
        ret;
    }
    val e: usize = (offset / 8)::usize;
    c.at[e] = merge(c.at[e], k);
}

# classify a node lying at `base` bytes into the value, psabi 3.2.3 and
# clang's X86_64ABIInfo::classify
fun classify(v: *View, at_node: u32, base: u64, c: *Classes) {
    val n:    *Node = view.node(v, at_node);
    val size: u64   = laid(n);
    if (base % alignment(n) != 0) {
        if (size != 0) { c.memory = true; }
        ret;
    }
    if (sel n.shape.integer || sel n.shape.pointer) {
        if (size > 8) {
            mark(c, base, Class.integer{});
            mark(c, base + 8, Class.integer{});
            ret;
        }
        mark(c, base, Class.integer{});
        ret;
    }
    if (sel n.shape.float) {
        val w: u32 = n.shape.float.width;
        if (w == 80) {
            mark(c, base, Class.x87{});
            mark(c, base + 8, Class.x87up{});
            ret;
        }
        if (w == 128) {
            mark(c, base, Class.sse{});
            mark(c, base + 8, Class.sseup{});
            ret;
        }
        mark(c, base, Class.sse{});
        ret;
    }
    if (sel n.shape.vector) {
        if (size == 4) {
            mark(c, base, Class.integer{});
            ret;
        }
        if (size == 8) {
            val lane: *Node = view.node(v, view.child(v, at_node, 0));
            if (n.shape.vector == 1 && sel lane.shape.integer) { mark(c, base, Class.integer{}); }
            or                                                 { mark(c, base, Class.sse{}); }
            ret;
        }
        if (size == 16) {
            mark(c, base, Class.sse{});
            mark(c, base + 8, Class.sseup{});
            ret;
        }
        c.memory = true;
        ret;
    }
    if (sel n.shape.array) {
        if (n.shape.array.count == 0) { ret; }
        val e: u32 = view.child(v, at_node, 0);
        var i: u64 = 0;
        for (i < n.shape.array.count && !c.memory) {
            classify(v, e, base + i * n.shape.array.stride, c);
            i = i + 1;
        }
        ret;
    }
    if (sel n.shape.structure || sel n.shape.union) {
        var k: u32 = 0;
        for (k < n.count && !c.memory) {
            val m: u32 = view.child(v, at_node, k);
            classify(v, m, base + view.node(v, m).offset, c);
            k = k + 1;
        }
        ret;
    }
    c.memory = true;
}

# the classes of a value after the post merger, psabi 3.2.3 5
fun classes_of(v: *View, at_node: u32) Classes {
    var c: Classes = Classes{at: [2]Class{Class.none{}, Class.none{}}, memory: false};
    val n: *Node   = view.node(v, at_node);
    if (laid(n) > 16) {
        c.memory = true;
        ret c;
    }
    classify(v, at_node, 0, ?c);
    if (c.memory) { ret c; }
    var e: usize = 0;
    for (e < 2) {
        val k: Class = c.at[e];
        if (sel k.memory) { c.memory = true; }
        if (sel k.x87up) {
            if (e == 0) { c.memory = true; }
            or {
                val before: Class = c.at[0];
                if (!(sel before.x87)) { c.memory = true; }
            }
        }
        if (sel k.sseup) {
            var joined: bool = false;
            if (e == 1) {
                val before: Class = c.at[0];
                joined = sel before.sse;
            }
            if (!joined) { c.at[e] = Class.sse{}; }
        }
        e = e + 1;
    }
    ret c;
}

# the registers one sysv64 placement draws from, and how far it has drawn
# ---
# integers: the integer registers in order
# vectors:  the vector registers in order
# integer:  the next integer register
# vector:   the next vector register
# stack:    the next free byte of the stack area
# spill:    whether anything may go on the stack, which no result may
rec State {
    integers: Slice[rf.Id];
    vectors:  Slice[rf.Id];
    integer:  usize;
    vector:   usize;
    stack:    u64;
    spill:    bool;
}

fun state(r: *Resolved, results: bool) State {
    var s: State;
    s.integer  = 0;
    s.vector   = 0;
    s.stack    = 0;
    s.spill    = !results;
    s.integers = Slice[rf.Id]{data: nil, size: 0};
    s.vectors  = s.integers;
    val regs: *Registers = held(r);
    if (regs == nil) { ret s; }
    if (results) {
        s.integers = bank(?regs.returning, rf.GENERAL);
        s.vectors  = bank(?regs.returning, rf.VECTOR);
    }
    or {
        s.integers = bank(?regs.passing, rf.GENERAL);
        s.vectors  = bank(?regs.passing, rf.VECTOR);
    }
    ret s;
}

fun at(place: Place, offset: u64, size: u64, fill: Fill) Piece {
    ret Piece{place: place, offset: offset, size: size, scale: Scale.fixed{}, fill: fill};
}

# the fill of a sysv64 integer eightbyte in its register or slot: a scalar
# narrower than 32 bits extended as declared, and the rest of any narrower
# part undefined
fun sysv_fill(n: *Node, size: u64) Fill {
    if (sel n.shape.integer) {
        val w: u32 = n.shape.integer;
        if (w == 1) { ret Fill.zero{1}; }
        if (w < 32) { ret Fill.declared{w}; }
    }
    if (size >= 8) { ret Fill.exact{}; }
    ret Fill.undefined{};
}

# a stack slot for a value, at the greater of its alignment and eight bytes,
# in eight byte slots
fun slot(s: *State, size: u64, align: u64) u64 {
    var to: u64 = align;
    if (to < 8) { to = 8; }
    val off: u64 = round(s.stack, to);
    s.stack = off + round(size, 8);
    ret off;
}

# the piece the address of a copy travels in
fun address(s: *State) Piece {
    if (s.integer < s.integers.size) {
        s.integer = s.integer + 1;
        ret at(Place.register{s.integers.data[s.integer - 1]}, 0, 8, Fill.exact{});
    }
    ret at(stacked(slot(s, 8, 8)), 0, 8, Fill.exact{});
}

fun copied(s: *State, asg: *Assignment, n: *Node, passing: *Passing) err[Refusal] {
    @passing = Passing.reference{Copy{size: laid(n), align: alignment(n)}};
    if (!s.spill) { ret err[Refusal].ok{}; }
    ret piece.add(asg, address(s));
}

# place a sysv64 value whole on the stack
fun stacked_whole(s: *State, asg: *Assignment, n: *Node, at_node: u32) err[Refusal] {
    if (!s.spill) { ret err[Refusal].err{Refusal.room{at_node}}; }
    val size: u64  = laid(n);
    val off:  u64  = slot(s, size, alignment(n));
    var fill: Fill = Fill.undefined{};
    if (size % 8 == 0)                  { fill = Fill.exact{}; }
    if (!view.aggregate(n) && size < 8) { fill = sysv_fill(n, size); }
    ret piece.add(asg, at(stacked(off), 0, size, fill));
}

# place one sysv64 value, as an argument or a result
fun sysv_place(s: *State, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[Refusal] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[Refusal].err{Refusal.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (sel value.by.reference) { ret copied(s, asg, n, passing); }
    if (size == 0)              { ret err[Refusal].ok{}; }
    val c: Classes = classes_of(v, value.node);
    if (c.memory) {
        if (!s.spill) { ret copied(s, asg, n, passing); }
        ret stacked_whole(s, asg, n, value.node);
    }
    val first: Class = c.at[0];
    if (sel first.x87) {
        if (!s.spill) { ret err[Refusal].err{Refusal.room{value.node}}; }
        ret stacked_whole(s, asg, n, value.node);
    }
    var ints: usize = 0;
    var vecs: usize = 0;
    var e:    usize = 0;
    for (e < 2) {
        val k: Class = c.at[e];
        if (sel k.integer) { ints = ints + 1; }
        if (sel k.sse)     { vecs = vecs + 1; }
        e = e + 1;
    }
    if (s.integer + ints > s.integers.size || s.vector + vecs > s.vectors.size) { ret stacked_whole(s, asg, n, value.node); }
    e = 0;
    for (e < 2) {
        val k:      Class = c.at[e];
        val offset: u64   = 8 * e::u64;
        if (offset < size) {
            var part: u64 = size - offset;
            if (part > 8) { part = 8; }
            if (sel k.integer) {
                var fill: Fill = Fill.exact{};
                if (!view.aggregate(n)) { fill = sysv_fill(n, part); }
                or (part < 8)           { fill = Fill.undefined{}; }
                val added: err[Refusal] = piece.add(asg, at(Place.register{s.integers.data[s.integer]}, offset, part, fill));
                if (sel added.err) { ret added; }
                s.integer = s.integer + 1;
            }
            or (sel k.sse) {
                var span: u64 = part;
                if (e == 0) {
                    val next: Class = c.at[1];
                    if (sel next.sseup) { span = size; }
                }
                var fill: Fill = Fill.undefined{};
                if (span == 16) { fill = Fill.exact{}; }
                val added: err[Refusal] = piece.add(asg, at(Place.register{s.vectors.data[s.vector]}, offset, span, fill));
                if (sel added.err) { ret added; }
                s.vector = s.vector + 1;
            }
        }
        e = e + 1;
    }
    ret err[Refusal].ok{};
}

fun sysv_results(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    if (call.results.size > 1) { ret err[Refusal].err{Refusal.results{call.results.size::u32}}; }
    var s: State = state(r, true);
    var i: usize = 0;
    for (i < call.results.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = sysv_place(?s, asg, call.view, call.results.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, true, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

fun sysv_arguments(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    var s: State = state(r, false);
    var i: usize = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) { asg.address = opt[Piece].some{address(?s)}; }
        i = i + 1;
    }
    i = 0;
    for (i < call.arguments.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = sysv_place(?s, asg, call.view, call.arguments.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, false, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    asg.stack = s.stack;
    ret err[Refusal].ok{};
}

# a call may be a tail call when it passes nothing on the stack and no result
# by reference, so it needs no area of the caller's frame past the return
fun tail(r: *Resolved, asg: *Assignment) bool {
    ret asg.stack == 0 && sel asg.address.none;
}

# the registers one win64 placement draws from, by position
# ---
# integers: rcx, rdx, r8 and r9
# vectors:  xmm0 to xmm3
# position: the next argument's position
# stack:    the end of the last stack slot taken, 0 for none
# spill:    whether anything may go on the stack, which no result may
rec Slots {
    integers: Slice[rf.Id];
    vectors:  Slice[rf.Id];
    position: usize;
    stack:    u64;
    spill:    bool;
}

fun slots(r: *Resolved, results: bool) Slots {
    var s: Slots;
    s.position = 0;
    s.stack    = 0;
    s.spill    = !results;
    s.integers = Slice[rf.Id]{data: nil, size: 0};
    s.vectors  = s.integers;
    val regs: *Registers = held(r);
    if (regs == nil) { ret s; }
    if (results) {
        s.integers = bank(?regs.returning, rf.GENERAL);
        s.vectors  = bank(?regs.returning, rf.VECTOR);
    }
    or {
        s.integers = bank(?regs.passing, rf.GENERAL);
        s.vectors  = bank(?regs.passing, rf.VECTOR);
    }
    ret s;
}

# whether a win64 value travels in a register or slot by value: a float of
# at most 64 bits, or any other value of 1, 2, 4 or 8 bytes
fun win_float(n: *Node) bool {
    ret sel n.shape.float && n.shape.float.width <= 64;
}

fun win_direct(n: *Node) bool {
    if (sel n.shape.float) { ret n.shape.float.width <= 64; }
    val size: u64 = laid(n);
    ret size == 1 || size == 2 || size == 4 || size == 8;
}

fun win_fill(size: u64) Fill {
    if (size == 8) { ret Fill.exact{}; }
    ret Fill.undefined{};
}

# the slot of the next position: its register of the class, or its eight
# stack bytes past the home space
fun win_slot(s: *Slots, asg: *Assignment, float: bool, unnamed: bool, size: u64, at_node: u32) err[Refusal] {
    val k: usize = s.position;
    s.position = k + 1;
    if (float && k < s.vectors.size) {
        val added: err[Refusal] = piece.add(asg, at(Place.register{s.vectors.data[k]}, 0, size, Fill.undefined{}));
        if (sel added.err) { ret added; }
        if (!unnamed)      { ret added; }
    }
    if (k < s.integers.size) { ret piece.add(asg, at(Place.register{s.integers.data[k]}, 0, size, win_fill(size))); }
    if (!s.spill)            { ret err[Refusal].err{Refusal.room{at_node}}; }
    val off: u64 = 8 * k::u64;
    s.stack = off + 8;
    ret piece.add(asg, at(stacked(off), 0, size, win_fill(size)));
}

fun win_argument(s: *Slots, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[Refusal] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[Refusal].err{Refusal.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (!(sel value.by.reference) && win_direct(n)) { ret win_slot(s, asg, win_float(n), !value.named, size, value.node); }
    @passing = Passing.reference{Copy{size: size, align: alignment(n)}};
    ret win_slot(s, asg, false, false, 8, value.node);
}

# a win64 result: in rax by its size, a float, a 128-bit vector or a 128-bit
# integer in xmm0, any other by reference
fun win_result(s: *Slots, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[Refusal] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[Refusal].err{Refusal.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (size == 0) { ret err[Refusal].ok{}; }
    if (!(sel value.by.reference)) {
        var vector: bool = false;
        if (sel n.shape.vector)  { vector = size == 16; }
        if (sel n.shape.integer) { vector = n.shape.integer == 128; }
        if ((win_float(n) || vector) && s.vectors.size > 0) {
            var fill: Fill = Fill.undefined{};
            if (size == 16) { fill = Fill.exact{}; }
            ret piece.add(asg, at(Place.register{s.vectors.data[0]}, 0, size, fill));
        }
        if (win_direct(n) && !(sel n.shape.float) && s.integers.size > 0) {
            var fill: Fill = win_fill(size);
            if (sel n.shape.integer && n.shape.integer == 1) { fill = Fill.zero{1}; }
            ret piece.add(asg, at(Place.register{s.integers.data[0]}, 0, size, fill));
        }
    }
    @passing = Passing.reference{Copy{size: size, align: alignment(n)}};
    ret err[Refusal].ok{};
}

fun win_results(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    if (call.results.size > 1) { ret err[Refusal].err{Refusal.results{call.results.size::u32}}; }
    var s: Slots = slots(r, true);
    var i: usize = 0;
    for (i < call.results.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = win_result(?s, asg, call.view, call.results.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, true, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

fun win_arguments(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    var s: Slots = slots(r, false);
    var i: usize = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) {
            val k: usize = s.position;
            s.position = k + 1;
            if (k < s.integers.size) { asg.address = opt[Piece].some{at(Place.register{s.integers.data[k]}, 0, 8, Fill.exact{})}; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < call.arguments.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = win_argument(?s, asg, call.view, call.arguments.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, false, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    asg.stack = s.stack;
    ret err[Refusal].ok{};
}

val SYSV_CLASSIFIERS: Classifiers = Classifiers{results: sysv_results, arguments: sysv_arguments};
val WIN_CLASSIFIERS:  Classifiers = Classifiers{results: win_results, arguments: win_arguments};

val SYSV_PASSING:   [14]rf.Id = [14]rf.Id{gen.RDI, gen.RSI, gen.RDX, gen.RCX, gen.R8, gen.R9, gen.XMM0, gen.XMM1, gen.XMM2, gen.XMM3, gen.XMM4, gen.XMM5, gen.XMM6, gen.XMM7};
val SYSV_RETURNING: [4]rf.Id  = [4]rf.Id{gen.RAX, gen.RDX, gen.XMM0, gen.XMM1};
val WIN_PASSING:    [8]rf.Id  = [8]rf.Id{gen.RCX, gen.RDX, gen.R8, gen.R9, gen.XMM0, gen.XMM1, gen.XMM2, gen.XMM3};
val WIN_RETURNING:  [2]rf.Id  = [2]rf.Id{gen.RAX, gen.XMM0};

# the stack pointer and the callee-saved integer registers, each kept whole.
# a register lying within one, as ebx within rbx, is kept with it
val SYSV_PRESERVED: [7]Kept = [7]Kept{
    Kept{register: gen.RSP, bits: Part.whole{}}, Kept{register: gen.RBX, bits: Part.whole{}}, Kept{register: gen.RBP, bits: Part.whole{}},
    Kept{register: gen.R12, bits: Part.whole{}}, Kept{register: gen.R13, bits: Part.whole{}}, Kept{register: gen.R14, bits: Part.whole{}},
    Kept{register: gen.R15, bits: Part.whole{}},
};

# windows keeps rdi and rsi too, and all 128 bits of xmm6 to xmm15. a wider
# ymm or zmm register holding one is clobbered, since a callee keeps only
# that part of it
val WIN_PRESERVED: [19]Kept = [19]Kept{
    Kept{register: gen.RSP, bits: Part.whole{}}, Kept{register: gen.RBX, bits: Part.whole{}}, Kept{register: gen.RBP, bits: Part.whole{}},
    Kept{register: gen.RDI, bits: Part.whole{}}, Kept{register: gen.RSI, bits: Part.whole{}},
    Kept{register: gen.R12, bits: Part.whole{}}, Kept{register: gen.R13, bits: Part.whole{}}, Kept{register: gen.R14, bits: Part.whole{}},
    Kept{register: gen.R15, bits: Part.whole{}},
    Kept{register: gen.XMM6, bits: Part.whole{}}, Kept{register: gen.XMM7, bits: Part.whole{}}, Kept{register: gen.XMM8, bits: Part.whole{}},
    Kept{register: gen.XMM9, bits: Part.whole{}}, Kept{register: gen.XMM10, bits: Part.whole{}}, Kept{register: gen.XMM11, bits: Part.whole{}},
    Kept{register: gen.XMM12, bits: Part.whole{}}, Kept{register: gen.XMM13, bits: Part.whole{}}, Kept{register: gen.XMM14, bits: Part.whole{}},
    Kept{register: gen.XMM15, bits: Part.whole{}},
};

# the segment registers, which hold the thread pointer's segment under fs or
# gs and which no code a call reaches changes, and the x87 control word and
# mxcsr, whose rounding modes and masks are callee-saved control state of
# thread storage duration, so a call neither saves nor clobbers them
val RESERVED: [8]rf.Id = [8]rf.Id{gen.ES, gen.CS, gen.SS, gen.DS, gen.FS, gen.GS, gen.FCW, gen.MXCSR};

# a prologue moves the stack pointer by the whole frame once and saves each
# register alone, its frames described by call frame information
val SYSV_PROLOGUE: Prologue = Prologue{probe: Probe.none{}, pair_saves: false, unwind: Unwind.dwarf{}};

# a windows prologue probes a frame past its 4096 byte guard page through
# __chkstk, and its frames are described by windows' unwind codes
val WIN_PROLOGUE: Prologue = Prologue{probe: Probe.page{Page{bytes: 4096, helper: opt[str].some{"__chkstk"}}}, pair_saves: false, unwind: Unwind.seh{}};

# the call pushes the return address one word below the canonical frame
# address, and rbp points at the caller's rbp saved below it. leaves take
# the 128 byte red zone below rsp
val SYSV_FRAME: Stack = Stack.memory{Frame{align: 16, red: 128, shadow: 0, link: Link.stack{}, pointer: Pointer.register{Keeper{register: gen.RBP, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: false}}, pointer_home: Home.register{gen.RSP}, prologue: SYSV_PROLOGUE}};

# windows has no red zone, reserves 32 bytes of home space above a call's
# stack arguments, and lets rbp point where the frame chooses
val WIN_FRAME: Stack = Stack.memory{Frame{align: 16, red: 0, shadow: 32, link: Link.stack{}, pointer: Pointer.register{Keeper{register: gen.RBP, record: Record.free{}, always: false}}, pointer_home: Home.register{gen.RSP}, prologue: WIN_PROLOGUE}};

val INDIRECT: Indirect = Indirect{carrier: Carrier.first{}, returned: Returned.register{gen.RAX}};

val SYSV_VARIADIC: Variadic = Variadic{unnamed: Unnamed.named{}, count: Count.register{gen.AL}, list: List.areas{}};
val WIN_VARIADIC:  Variadic = Variadic{unnamed: Unnamed.both{}, count: Count.none{}, list: List.pointer{}};

# both rows pass in sse registers, which the baseline's sse2 holds
val SSE2_ATOMS: [1]requirement.Id          = [1]requirement.Id{x86_extension.SSE2};
val NEEDS:      [1]requirement.Alternative = [1]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?SSE2_ATOMS[0], len: 1}, none: requirement.NO_IDS},
};
val NEEDS_SSE2: requirement.Requirement = requirement.Requirement{at: ?NEEDS[0], len: 1};

# system v x86-64
pub val SYSV64: Convention = Convention{
    name:        "sysv64",
    abi:         Abi.row{?x86_arch.X86_64_SYSV64},
    requires:    NEEDS_SSE2,
    file:        opt[*rf.File].some{?gen.FILE},
    classifiers: SYSV_CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?SYSV_PASSING[0], size: 14},
    returning:   Slice[rf.Id]{data: ?SYSV_RETURNING[0], size: 4},
    preserved:   Slice[Kept]{data: ?SYSV_PRESERVED[0], size: 7},
    reserved:    Slice[rf.Id]{data: ?RESERVED[0], size: 8},
    stack:       SYSV_FRAME,
    indirect:    INDIRECT,
    variadic:    SYSV_VARIADIC,
    half:        Half.float{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        tail,
};

# windows x64
pub val WIN64: Convention = Convention{
    name:        "win64",
    abi:         Abi.row{?x86_arch.X86_64_WIN64},
    requires:    NEEDS_SSE2,
    file:        opt[*rf.File].some{?gen.FILE},
    classifiers: WIN_CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{64},
    passing:     Slice[rf.Id]{data: ?WIN_PASSING[0], size: 8},
    returning:   Slice[rf.Id]{data: ?WIN_RETURNING[0], size: 2},
    preserved:   Slice[Kept]{data: ?WIN_PRESERVED[0], size: 19},
    reserved:    Slice[rf.Id]{data: ?RESERVED[0], size: 8},
    stack:       WIN_FRAME,
    indirect:    INDIRECT,
    variadic:    WIN_VARIADIC,
    half:        Half.float{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        tail,
};
