# the x86-64 moves: the value of one register into another of its class, and
# the exchange of two
#
# a general register moves at each of its views, the 64-bit one for a whole
# value and the narrower ones where a copy places a part, the high bytes ah to
# bh moving to and from the low ones of the legacy four, which no rex prefix
# names. an xmm register moves whole by movaps. xchg exchanges two general
# registers at each view in one instruction, the swap that breaks a copy
# cycle with no scratch register free. sse has no exchange, so a cycle of xmm
# registers goes through a scratch or the stack.

use mirl.machine.copy.move.Move;
use mirl.machine.copy.move.Moves;
use mirl.machine.copy.move.Part;
use mirl.machine.copy.move.Parts;
use mirl.machine.copy.move.Table;
use mirl.machine.select.rule.Holder;

use masc.core.quantity;
use masc.isa.x86.gen_register;
use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;

val WHOLE: [2]Part = [2]Part{Part.to{}, Part.from{}};

val ROWS: [8]Move = [8]Move{
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR64_GPR64_89_O64], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR32_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR32_CLASS]}, bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR32_GPR32_89_O32], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR16_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR16_CLASS]}, bits: quantity.Scaled{fixed: 16, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR16_GPR16_89_O16], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR8_GPR8_88], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR8_GPR8_88], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR8_GPR8_88], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOV_GPR8_GPR8_88], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.XMM_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.XMM_CLASS]}, bits: quantity.Scaled{fixed: 128, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.MOVAPS_XMM_XMM_0F28], parts: Parts{at: ?WHOLE[0], len: 2}},
};

val SWAPS: [5]Move = [5]Move{
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.XCHG_GPR64_GPR64_87_O64], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR32_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR32_CLASS]}, bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.XCHG_GPR32_GPR32_87_O32], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR16_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR16_CLASS]}, bits: quantity.Scaled{fixed: 16, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.XCHG_GPR16_GPR16_87_O16], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.XCHG_GPR8_GPR8_86], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen_register.GPR8H_CLASS]}, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.XCHG_GPR8_GPR8_86], parts: Parts{at: ?WHOLE[0], len: 2}},
};

# the x86-64 moves
pub val MOVES: Table = Table{moves: Moves{at: ?ROWS[0], len: 8}, swaps: Moves{at: ?SWAPS[0], len: 5}};
