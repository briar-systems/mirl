# integers, conditions and pointers live in the general registers, and floats
# and vectors in the xmm registers sse2 gives every x86-64. the wider ymm and
# zmm hold none: a value is never wider than an xmm register on a build
# whose vectors are sse2's
val HOLDS: [5]Hold = [5]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.GPR64_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY32}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.XMM_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY64}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.XMM_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.vector{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.XMM_CLASS]}, requires: Condition.always{}},
};

val S_JUMP: [1]Source = [1]Source{Source.target{0}};
val E_JUMP: [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{?gen_row.ROWS[gen_row_index.JMP_REL32_E9]}, operands: Sources{at: ?S_JUMP[0], len: 1}, implied: NO_IMPLIED}};

# the x86-64 table
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: 1541},
    constants: Rules{at: ?CONSTANTS[0], len: 9},
    holds:     Holds{at: ?HOLDS[0], len: 5},
    jump:      Emits{at: ?E_JUMP[0], len: 1},
};
