# the orderings an atomic store is chosen for: a plain store under x86-tso
# for relaxed and release, an exchange, which is locked, for seq_cst
val PLAIN_STORES: ir.Orderings = ir.Orderings{relaxed: true, acquire: false, release: true, acq_rel: false, seq_cst: false};
val SEQ_CST:      ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: false, acq_rel: false, seq_cst: true};

