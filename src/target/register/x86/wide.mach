# the 256 bit emits of the x86-64 table: avx2's integer lanes and avx's float lanes in a ymm register
#
# every rule over them reads and writes a vector of 32 bytes (`mirl.target.register.x86.hook.bytes_32`,
# `lanes.operand_32`) through the vex encoded rows, three operands and none tied. a lane is extracted or
# inserted through the xmm half holding it, moved out by vextract and back by vinsert, the half and the
# lane within it computed from the root's lane (`lanes.upper`, `lanes.within`). a comparison gives its
# mask widened, an unsigned one of bytes, words or doublewords by the unsigned minimum or maximum, of
# quadwords by flipping the sign of both before the signed compare. a row no one instruction serves is a
# sequence: bytes multiply through words and quadwords through vpmuludq, bytes shift one bit of the count at
# a time, words through doubleword shifts of each half and an arithmetic shift of quadwords as the logical
# shift of the value flipped by its sign, those two also at 16 bytes in an xmm register, and the conversions
# between doublewords and binary32 saturate as the scalar ones do. the rules are in the table's list.

use masc.isa.x86.gen_register;
use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;

use mirl.machine.instruction.Opcode;
use mirl.machine.select.rule.Emit;
use mirl.machine.select.rule.NO_IMPLIED;
use mirl.machine.select.rule.Scratch;
use mirl.machine.select.rule.Slot;
use mirl.machine.select.rule.Source;
use mirl.machine.select.rule.Sources;
use mirl.target.register.x86.lanes;

