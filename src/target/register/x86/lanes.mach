# the x86-64 lane rules: splat, build, shuffle, extract, insert and the
# reductions, the guards they read and the immediates they compute
#
# a vector of 4, 8 or 16 bytes is held in the low bytes of an xmm register and
# the bytes above it are undefined, so a rule reads no lane past the vector's
# and a splat or a shuffle may write any. a lane's index and a shuffle's lanes
# are the root's immediates, which the computed sources turn into the
# immediates of pextr, pinsr, pshufd and insertps, and into the selector
# pshufb looks each byte of its result up by. a selector or a blend mask is
# built in a general register and moved across, as the table builds every
# other constant an expansion needs.
#
# sse2 serves every lane type of each operation but a shuffle of bytes or
# words, which needs ssse3's pshufb, and the minimum, maximum and product of
# doublewords and the signed minimum and maximum of bytes and unsigned of
# words, which sse4.1 reduces packed where sse2 biases the lanes or reduces in
# the general registers. sse4.1's pextr and pinsr and avx2's vpbroadcast are
# cheaper rules over the same operations. a reduction is a tree that folds
# the upper half of what is left onto the lower, and a sequential float
# reduction adds or multiplies the lanes in order. no float minimum or maximum
# reduces packed, since minps and maxps give the second operand for a nan or
# two zeros.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.isa.x86.gen_register;
use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;

use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use ir: mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.rule.Class;
use types: mirl.ir.type;
use mirl.ir.type.format;
use mirl.machine.instruction.Opcode;
use mirl.machine.select.match;
use mirl.machine.select.rule.Emit;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.NO_IMPLIED;
use mirl.machine.select.rule.Node;
use mirl.machine.select.rule.Ref;
use mirl.machine.select.rule.Scratch;
use mirl.machine.select.rule.Slot;
use mirl.machine.select.rule.Source;
use mirl.machine.select.rule.Sources;
use mirl.machine.select.rule.Test;
use mirl.machine.select.rule.Tie;
use mirl.machine.select.rule.Width;

# the lanes of a vector: how many and the bits of each, zero for a value
# that is no vector
rec Lanes {
    count: u32;
    bits:  u32;
}

fun lanes_of(mt: *Match, v: opt[id.Value]) Lanes {
    val none: Lanes = Lanes{count: 0, bits: 0};
    if (sel v.none) { ret none; }
    val s: res[types.Shape, types.Error] = match.shape(mt, v.some);
    if (sel s.err) { ret none; }
    val sh: types.Shape = s.ok;
    if (!(sel sh.vector)) { ret none; }
    val e: res[types.Shape, types.Error] = types.shape(?mt.module.types, sh.vector.element);
    if (sel e.err) { ret none; }
    val es:   types.Shape = e.ok;
    var bits: u32         = 0;
    if (sel es.integer) { bits = es.integer.width; }
    or (sel es.float) {
        val r: opt[types.Row] = types.row(es.float.format);
        if (sel r.none) { ret none; }
        bits = r.some.width;
    }
    ret Lanes{count: sh.vector.lanes, bits: bits};
}

fun bytes_of(l: Lanes) u64 {
    ret l.count::u64 * l.bits::u64 / 8;
}

fun operand_bytes(mt: *Match) u64 {
    ret bytes_of(lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0})));
}

# the root reads a vector of 4, 8 or 16 bytes
pub fun operand_4(mt: *Match) bool {
    ret operand_bytes(mt) == 4;
}

pub fun operand_8(mt: *Match) bool {
    ret operand_bytes(mt) == 8;
}

pub fun operand_16(mt: *Match) bool {
    ret operand_bytes(mt) == 16;
}

# the lane the root names
fun lane_of(mt: *Match) opt[u32] {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lane) { ret opt[u32].some{imm.lane}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

fun immediate(x: u64) opt[i64] {
    ret opt[i64].some{x:~i64};
}

# the root names lane 0 or lane 1
pub fun lane_zero(mt: *Match) bool {
    val l: opt[u32] = lane_of(mt);
    ret sel l.some && l.some == 0;
}

pub fun lane_one(mt: *Match) bool {
    val l: opt[u32] = lane_of(mt);
    ret sel l.some && l.some == 1;
}

# the lane, the immediate of pextr and pinsr, and the doubleword pshufd
# moves to the bottom
pub fun lane(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate(l.some::u64);
}

# the word holding a byte lane
pub fun half(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate((l.some >> 1)::u64);
}

# how far a byte lane sits above the bottom of its word
pub fun byte_shift(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate(((l.some & 1) * 8)::u64);
}

# the byte of its word a byte lane leaves as it was
pub fun byte_keep(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none)        { ret opt[i64].none{}; }
    if ((l.some & 1) != 0) { ret immediate(0xff); }
    ret immediate(0xff00);
}

# the low and the high word of a doubleword lane
pub fun word_low(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate((l.some * 2)::u64);
}

pub fun word_high(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate((l.some * 2 + 1)::u64);
}

# the pshufd immediate that moves a quadword lane to the bottom
pub fun quad(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    val lo: u64 = (l.some * 2)::u64;
    val hi: u64 = lo + 1;
    ret immediate(lo | (hi << 2) | (lo << 4) | (hi << 6));
}

# the insertps immediate that writes a binary32 lane from the bottom of its source
pub fun insertps(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate((l.some << 4)::u64);
}

# a shuffle the root states: its lanes, the lanes of each operand and of its
# result, and the bits of a lane
rec Shuffle {
    list:    Slice[u32];
    inputs:  u32;
    outputs: u32;
    bits:    u32;
}

fun shuffle_of(mt: *Match) opt[Shuffle] {
    val d:    *InstructionData = match.instruction(mt, 0);
    var list: Slice[u32]       = Slice[u32]{data: nil, size: 0};
    var i:    usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lanes) { list = imm.lanes; }
        i = i + 1;
    }
    val from: Lanes = lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
    val to:   Lanes = lanes_of(mt, match.result(mt, Slot{node: 0, index: 0}));
    if (from.count == 0 || to.count == 0 || to.bits == 0 || to.bits % 8 != 0) { ret opt[Shuffle].none{}; }
    if (list.size != to.count::usize)                                         { ret opt[Shuffle].none{}; }
    if (bytes_of(from) > 16 || bytes_of(to) > 16)                             { ret opt[Shuffle].none{}; }
    ret opt[Shuffle].some{Shuffle{list: list, inputs: from.count, outputs: to.count, bits: to.bits}};
}

# which operand lane i of the result comes from, 0 or 1, and its lane there
fun side(s: *Shuffle, i: u32) u32 {
    if (s.list.data[i] < s.inputs) { ret 0; }
    ret 1;
}

fun from(s: *Shuffle, i: u32) u32 {
    val at: u32 = s.list.data[i];
    if (at < s.inputs) { ret at; }
    ret at - s.inputs;
}

# every lane of the result comes from one operand
fun single(mt: *Match, which: u32) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret false; }
    val s: Shuffle = got.some;
    var i: u32     = 0;
    for (i < s.outputs) {
        if (side(?s, i) != which) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the result fits the low quadword, so a selector or a mask needs no upper half
pub fun narrow(mt: *Match) bool {
    ret bytes_of(lanes_of(mt, match.result(mt, Slot{node: 0, index: 0}))) <= 8;
}

pub fun single_a(mt: *Match) bool {
    ret single(mt, 0);
}

pub fun single_b(mt: *Match) bool {
    ret single(mt, 1);
}

pub fun single_a_narrow(mt: *Match) bool {
    ret single(mt, 0) && narrow(mt);
}

pub fun single_b_narrow(mt: *Match) bool {
    ret single(mt, 1) && narrow(mt);
}

# the pshufd immediate that moves each lane of the result taken from one
# operand into place, a lane of 32 or 64 bits
fun dwords(mt: *Match, which: u32) opt[i64] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[i64].none{}; }
    val s: Shuffle = got.some;
    if (s.bits != 32 && s.bits != 64) { ret opt[i64].none{}; }
    var imm: u64 = 0;
    var p:   u32 = 0;
    for (p < 4) {
        var i:    u32 = p;
        var part: u32 = 0;
        if (s.bits == 64) {
            i    = p / 2;
            part = p % 2;
        }
        var pick: u32 = p;
        if (i < s.outputs && side(?s, i) == which) { pick = from(?s, i) * (s.bits / 32) + part; }
        imm = imm | (pick::u64 << (2 * p)::u64);
        p   = p + 1;
    }
    ret immediate(imm);
}

pub fun dwords_a(mt: *Match) opt[i64] {
    ret dwords(mt, 0);
}

pub fun dwords_b(mt: *Match) opt[i64] {
    ret dwords(mt, 1);
}

# a quadword of the mask whose bytes are all ones where the result's lane
# comes from the first operand
fun blend(mt: *Match, quadword: u32) opt[i64] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[i64].none{}; }
    val s:    Shuffle = got.some;
    val each: u32     = s.bits / 8;
    var mask: u64     = 0;
    var b:    u32     = 0;
    for (b < 8) {
        val i: u32 = (quadword * 8 + b) / each;
        if (i < s.outputs && side(?s, i) == 0) { mask = mask | (0xff::u64 << (8 * b)::u64); }
        b = b + 1;
    }
    ret immediate(mask);
}

pub fun blend_low(mt: *Match) opt[i64] {
    ret blend(mt, 0);
}

pub fun blend_high(mt: *Match) opt[i64] {
    ret blend(mt, 1);
}

# a quadword of the selector pshufb looks one operand's bytes up by: the byte
# of that operand each byte of the result is, and 0x80, which gives zero, for
# a byte the other operand gives or no lane holds
fun selector(mt: *Match, which: u32, quadword: u32) opt[i64] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[i64].none{}; }
    val s:      Shuffle = got.some;
    val each:   u32     = s.bits / 8;
    var picked: u64     = 0;
    var b:      u32     = 0;
    for (b < 8) {
        val j:    u32 = quadword * 8 + b;
        val i:    u32 = j / each;
        var byte: u32 = 0x80;
        if (i < s.outputs && side(?s, i) == which) { byte = from(?s, i) * each + j % each; }
        picked = picked | (byte::u64 << (8 * b)::u64);
        b      = b + 1;
    }
    ret immediate(picked);
}

pub fun bytes_a_low(mt: *Match) opt[i64] {
    ret selector(mt, 0, 0);
}

pub fun bytes_a_high(mt: *Match) opt[i64] {
    ret selector(mt, 0, 1);
}

pub fun bytes_b_low(mt: *Match) opt[i64] {
    ret selector(mt, 1, 0);
}

pub fun bytes_b_high(mt: *Match) opt[i64] {
    ret selector(mt, 1, 1);
}

