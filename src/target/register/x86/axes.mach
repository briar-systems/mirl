# x86-64 under the sysv psabi, the same for linux, darwin, windows and freestanding
val X86_64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.architecture{}, layout: Rules.c{}},
};
# the integer instructions of every width from a byte up
val X86_64_ALU:      [4]u32 = [4]u32{8, 16, 32, 64};
val X86_64_WORDS:    [2]u32 = [2]u32{32, 64};
val X86_64_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
# mul and imul with one operand give the whole product in a register pair
val X86_64_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 64},
};
# ssse3, sse4.1 and fma, the extensions the x86-64 rows' conditions name
val SSSE3_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.SSSE3};
val SSSE3_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?SSSE3_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_SSSE3:        Condition                  = Condition.requires{requirement.Requirement{at: ?SSSE3_ALTERNATIVES[0], len: 1}};
val SSE41_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.SSE41};
val SSE41_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?SSE41_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_SSE41:        Condition                  = Condition.requires{requirement.Requirement{at: ?SSE41_ALTERNATIVES[0], len: 1}};
val FMA_ATOMS:          [1]requirement.Id          = [1]requirement.Id{x86_extension.FMA};
val FMA_ALTERNATIVES:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?FMA_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_FMA:          Condition                  = Condition.requires{requirement.Requirement{at: ?FMA_ALTERNATIVES[0], len: 1}};
# roundss and roundsd are sse4.1's and vfmadd231ss and vfmadd231sd fma's.
# minss and maxss give the second operand for a nan or two zeros, so no
# minimum or maximum is native, and sse has no remainder
val X86_64_NATIVES: [5]Native = [5]Native{
    Native{opcode: table.FFLOOR, condition: UNDER_SSE41},
    Native{opcode: table.FCEIL, condition: UNDER_SSE41},
    Native{opcode: table.FINT, condition: UNDER_SSE41},
    Native{opcode: table.FNEAREST, condition: UNDER_SSE41},
    Native{opcode: table.FMA, condition: UNDER_FMA},
};
# sse2 computes binary32 and binary64 and returns the first nan operand, and
# an invalid operation gives the negative quiet nan, the real indefinite
# (intel sdm volume 1, 4.8.3.7 "QNaN Floating-Point Indefinite"). a float
# constant is loaded from memory
val X86_64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.negative{}, priority: Priority.first{}, fused: Fused.unordered{}}}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 5}}, constants: Constants.loaded{}},
    Held{format: ?BINARY64, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.negative{}, priority: Priority.first{}, fused: Fused.unordered{}}}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 5}}, constants: Constants.loaded{}},
};
# binary16 is held by no row, as none states avx512_fp16's, so the half
# precision legalisation widens it exactly to binary32, or binary64 for a fused
# multiply-add, both always held, and narrows the result keeping a nan's sign
# and payload quieted. binary16 then returns sse's rule: the first nan
# operand, and the negative default nan for an invalid operation
val X86_64_LOWERED: [1]Lowered = [1]Lowered{
    Lowered{format: ?BINARY16, widened: Narrowing.kept{}, helpers: Helpers.none{}, kept: Kept.format{}},
};
# the sse2 unit: packed integer lanes of each width, and packed binary32 and binary64
val X86_64_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# the operations the sse rules select over packed lanes: sums, differences
# and the bitwise operations at every integer width, the multiply at every
# width (bytes through words, quadwords through pmuludq), binary32 and
# binary64 arithmetic and square root, the widening of a lane, a
# splat, a build, an extract and an insert of every lane type, a shuffle of
# every lane type, of bytes and words under ssse3's pshufb, every reduction
# but a float minimum or maximum, the comparisons the language writes with
# their mask widened, of quadwords ordered by pcmpgtq under sse4.2 and by
# doubleword compares below it, the complement, the shifts of every width by
# a count per lane (bytes one bit of the count at a time, the arithmetic one
# of quadwords as the logical shift of the value flipped by its sign): avx2's
# vpsllv, vpsrlv and vpsravd where they apply, and otherwise one psll, psrl or
# psra by a register per lane, merged by packed shuffles, and the conversions
# between doublewords and binary32 both ways, signed and unsigned, and from binary64 to
# signed doublewords and back. sse has no divide of integers. every other
# operation is taken lane by lane. expanded: the multiply of bytes and
# quadwords, the shifts of bytes and words, the arithmetic shift of
# quadwords, the unsigned less of every width and less or equal of quadwords,
# and the saturating conversions
val X86_64_OPERATIONS: [174]Operation = [174]Operation{
    Operation{opcode: table.ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.SUB, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FADD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FADD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSUB, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSUB, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FMUL, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
