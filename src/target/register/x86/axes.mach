# the byte sizes the sse2 rules load and store a vector at (movd, movq and
# movdqu), so a vector of any other size splits
val X86_64_VECTOR_BYTES: [3]u32 = [3]u32{4, 8, 16};
# avx's ymm and avx-512f's zmm, the vector registers beyond sse2's, and avx2
val AVX_ATOMS:         [1]requirement.Id          = [1]requirement.Id{x86_extension.AVX};
val AVX_ALTERNATIVES:  [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?AVX_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_AVX:         Condition                  = Condition.requires{requirement.Requirement{at: ?AVX_ALTERNATIVES[0], len: 1}};
val AVX2_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.AVX2};
val AVX2_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?AVX2_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_AVX2:        Condition                  = Condition.requires{requirement.Requirement{at: ?AVX2_ALTERNATIVES[0], len: 1}};
# avx2's 256 bit unit: sums, differences and the bitwise operations of
# integer lanes at every width, the multiply at every width (words and
# doublewords by one instruction, bytes through words, quadwords through
# vpmuludq), the comparisons with their mask widened (unsigned ones by a
# minimum or maximum, of quadwords by a flip of the sign), the shifts of every
# width by a count per lane (doublewords and quadwords by one instruction,
# words through doubleword shifts, bytes one bit of the count at a time, the
# arithmetic one of quadwords as the logical shift of the value flipped by its
# sign), the widening of a lane from an xmm register, a splat, an extract and
# an insert of every lane type, the conversions between doublewords and
# binary32 both ways, and avx's float rows: binary32 and binary64 arithmetic,
# square root and comparisons, whose masks are integer lanes this unit holds.
# every other operation is taken lane by lane. expanded: sse's, but for the
# conversion from binary64 it has no row of, and an insert, through the xmm half
val AVX2_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
