    Operation{opcode: table.EXT_U, lane: LaneType.integer{16}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.EXT_U, lane: LaneType.integer{32}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VSPLAT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: false},
