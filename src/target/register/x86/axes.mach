    Operation{opcode: table.VEXTRACT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VINSERT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.VINSERT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.MUL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.MUL, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHR_U, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.SHR_S, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.ITOF_S, lane: LaneType.integer{32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.ITOF_U, lane: LaneType.integer{32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.FTOI_S, lane: LaneType.float{?BINARY32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.FTOI_U, lane: LaneType.float{?BINARY32}, to: LaneType.integer{32}, condition: Condition.always{}, expanded: true},
};
# avx's 256 bit unit, on a build without avx2: binary32 and binary64
# arithmetic and square root, a splat, an extract and an insert. a comparison
# of its lanes is taken lane by lane, as its mask is integer lanes no unit of
# such a build holds in 32 bytes, and integer vectors split to sse2's halves.
# expanded: the insert of binary32, through the xmm half
val AVX_LANES: [2]Lane = [2]Lane{
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
val AVX_OPERATIONS: [16]Operation = [16]Operation{
    Operation{opcode: table.FADD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FADD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSUB, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSUB, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FMUL, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FMUL, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FDIV, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FDIV, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSQRT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.FSQRT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VSPLAT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VSPLAT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VEXTRACT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VEXTRACT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
    Operation{opcode: table.VINSERT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}, expanded: true},
    Operation{opcode: table.VINSERT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}, expanded: false},
};
# the byte sizes a 256 bit unit holds a vector at: 32 bytes in a ymm
# register, and 4, 8 and 16 for the operand of a widening, which reads the
# low bytes of an xmm register. sse2's unit is stated first, so a vector of
# 16 bytes or fewer splits to it, and avx2's before avx's, so a float vector
# of 32 bytes splits to avx2's where both are met
val WIDE_VECTOR_BYTES: [4]u32 = [4]u32{4, 8, 16, 32};
# sse2, which every x86-64 has, and the 256 bit units of avx2 and avx, none
# holding a mask in a register of its own: a comparison gives its mask
# widened to the lanes compared. avx-512's units are not stated
val X86_64_UNITS: [3]Unit = [3]Unit{
    Unit{requires: Condition.always{}, width: Width.fixed{128}, counts: Counts.bytes{Slice[u32]{data: ?X86_64_VECTOR_BYTES[0], size: 3}}, lanes: Slice[Lane]{data: ?X86_64_LANES[0], size: 6}, operations: Operations.rows{Slice[Operation]{data: ?X86_64_OPERATIONS[0], size: $length_of(X86_64_OPERATIONS)}}, masks: Masks.widened{}, constants: Constants.loaded{}},
    Unit{requires: UNDER_AVX2, width: Width.fixed{256}, counts: Counts.bytes{Slice[u32]{data: ?WIDE_VECTOR_BYTES[0], size: 4}}, lanes: Slice[Lane]{data: ?AVX2_LANES[0], size: 6}, operations: Operations.rows{Slice[Operation]{data: ?AVX2_OPERATIONS[0], size: $length_of(AVX2_OPERATIONS)}}, masks: Masks.widened{}, constants: Constants.loaded{}},
    Unit{requires: UNDER_AVX, width: Width.fixed{256}, counts: Counts.bytes{Slice[u32]{data: ?WIDE_VECTOR_BYTES[0], size: 4}}, lanes: Slice[Lane]{data: ?AVX_LANES[0], size: 2}, operations: Operations.rows{Slice[Operation]{data: ?AVX_OPERATIONS[0], size: $length_of(AVX_OPERATIONS)}}, masks: Masks.widened{}, constants: Constants.loaded{}},
};
val AVX512F_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.AVX512F};
val AVX512F_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?AVX512F_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
# sse2's 128 bit xmm, which every x86-64 has, widened to 256 under avx and to
# 512 under avx-512f
val X86_64_VECTOR_REGISTERS: [3]VectorRegister = [3]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
    VectorRegister{requires: UNDER_AVX, width: Width.fixed{256}},
    VectorRegister{requires: Condition.requires{requirement.Requirement{at: ?AVX512F_ALTERNATIVES[0], len: 1}}, width: Width.fixed{512}},
};
# int3
val X86_64_FILL: [1]u8 = [1]u8{0xCC};
# the lp64 widths of the sysv psabi (3.1.2 "data representation"): _Bool and
# the integers to long at their size, __int128 at 16, and above 128 bits a
# _BitInt(N), a structure of 64-bit chunks aligned to 8
val X86_64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 8}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 8}}},
};
# _Float16, float and double, each at its size
val X86_64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# the scalar types of microsoft's x64 abi ("x64 software conventions", "x64
# type and storage layout"), a condition held in its byte as an INT8. it
# states no integer wider than __int64 and no 16-bit float, so those rows are
# mirl-defined, no spec states this: i128 at 16 aligned to 16, a wider one in
# 16 byte chunks aligned to 16, and a 16-bit float at 2
val WIN64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}}, IntegerLayout{width: 128, stored: Stored.defined{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.defined{Scalar{size: 32, align: 16}}},
    IntegerLayout{width: 512, stored: Stored.defined{Scalar{size: 64, align: 16}}},
};
val WIN64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.defined{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# cx16's lock cmpxchg16b, which compares rdx:rax with memory and swaps in rcx:rbx
val CX16_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.CX16};
val CX16_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?CX16_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val X86_64_PAIRED:     Atomics                    = Atomics{paired: Paired.native{Swap{condition: Condition.requires{requirement.Requirement{at: ?CX16_ALTERNATIVES[0], len: 1}}, refusal: "a compare and exchange of two words on a build without cx16, whose cmpxchg16b compares and swaps sixteen bytes"}}};

# the jump tables x86-64 branches through: at least four cases filling at least
# two fifths of their entries
val X86_64_DENSITY: Density = Density{least: 4, fill: 40};

# x86-64, the same under every system
val X86_64_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{X86_64_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?X86_64_POINTERS[0], size: 1},
        slots:    SlotSpace.space{0},
        models:   Models.none{},
        register: Bits.bits{64},
        alu:      Set.widths{Slice[u32]{data: ?X86_64_ALU[0], size: 4}},
        integers: Set.widths{Slice[u32]{data: ?X86_64_INTEGERS[0], size: 4}},
        carried:  Carriers.none{},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?X86_64_UNITS[0], size: 3}},
    formats:    Formats.held{Slice[Held]{data: ?X86_64_HELD[0], size: 2}},
    lowered:    Lowerings.rows{Slice[Lowered]{data: ?X86_64_LOWERED[0], size: 1}},
    arithmetic: Arithmetic{
        multiply:   Set.widths{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
        multiplied: Condition.always{},
        products:   Products.forms{Slice[Product]{data: ?X86_64_PRODUCTS[0], size: 4}},
        shifts:     Shifts.wraps{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
        single:     Single.none{},
        # div and idiv raise the divide error for a zero divisor and an overflowing quotient, and
        # div divides edx:eax and rdx:rax. the byte and word forms divide ah:al and dx:ax, whose
        # halves the selection does not split, so a byte or a word divides at 32 bits
        division: Division{widths: Set.widths{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}}, condition: Condition.always{}, zero: Fault.traps{}, overflow: Fault.traps{}, long: LongDivision.native{Long{widths: Slice[u32]{data: ?X86_64_WORDS[0], size: 2}, zero: Fault.traps{}, exceeds: Fault.traps{}}}},
    },
    # rep movsb and rep stosb for a known length, packed loops for any other
    bulk:    BulkMemory{copy: Copy.ascending{}, fill: Bulk.known{}, moves: 8},
    atomics: X86_64_PAIRED,
    code:    Code{
        function: Align.bytes{16},
        text:     Align.bytes{16},
        fill:     Fill.pattern{Slice[u8]{data: ?X86_64_FILL[0], size: 1}},
    },
    placed:     Placed{section: Honours.honoured{}, alignment: Honours.honoured{}},
    attributes: Attributes.schema{?SCHEMA},
    ops:        Ops.none{},
    handles:    Handles.none{},
    assembly:   Assembly.inline{},
};

# the lp64 data of the sysv psabi
val X86_64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?X86_64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?X86_64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?X86_64_VECTOR_REGISTERS[0], size: 3}}},
};

# the data of microsoft's x64 abi
val WIN64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?WIN64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?WIN64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?X86_64_VECTOR_REGISTERS[0], size: 3}}},
};

val MACHINES: [1]axis.Machine = [1]axis.Machine{axis.Machine{arch: ?x86.X86_64, caps: X86_64_CAPS}};

# the x86-64 conventions, by mink's psabi names
val MEMBERS: [2]axis.Member = [2]axis.Member{
    axis.Member{abi: ?x86.X86_64_SYSV64, row: opt[*Convention].some{?abi.SYSV64}, data: X86_64_DATA},
    axis.Member{abi: ?x86.X86_64_WIN64, row: opt[*Convention].some{?abi.WIN64}, data: WIN64_DATA},
};

# linux code is position independent, and a thread-local variable of a module
# loaded at any time is reached through the runtime's lookup (x86-64 psabi,
# "thread-local storage"), which the selection does not reach yet
val X86_64_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    preemption: Preemption.none{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
        index:           "",
    },
};

# darwin code is position independent, and every thread-local variable is
# reached through the thunk of its descriptor the loader binds. its two-level
# namespace binds every strong definition to the image that holds it, so only
# a weak one is preempted, in an executable as in a dylib, and the model is
# the one a dylib's code takes too
val X86_64_DARWIN_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    preemption: Preemption.coalesced{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.variable{},
        local_dynamic:   Access.variable{},
        initial_exec:    Access.variable{},
        local_exec:      Access.variable{},
        lookup:          "_tlv_bootstrap",
        index:           "",
    },
};

# a pe image is rebased by its loader and resolves every symbol at link time,
# and a thread-local variable is reached through the index the loader writes
# in _tls_index, which the image's tls directory names (pe format, "the .tls
# section"). no thread-local model calls a lookup
val X86_64_WINDOWS_ADDRESSES: Model = Model{
    relocation: Relocation.image{},
    preemption: Preemption.none{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.indexed{},
        local_dynamic:   Access.indexed{},
        initial_exec:    Access.indexed{},
        local_exec:      Access.indexed{},
        lookup:          "",
        index:           "_tls_index",
    },
};

# a uefi image is a pe image whose firmware sets up no thread-local storage:
# no thread pointer, no thread's table of module blocks and no index cell, so
# it reaches no thread-local variable
val X86_64_UEFI_ADDRESSES: Model = Model{
    relocation: Relocation.image{},
    preemption: Preemption.none{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.absent{},
        local_dynamic:   Access.absent{},
        initial_exec:    Access.absent{},
        local_exec:      Access.absent{},
        lookup:          "",
        index:           "",
    },
};

# a freestanding image is linked at its address under the x86-64 psabi's
# small code model, every symbol in the low 2 GiB, which selection reaches
# rip-relative, and holds every thread-local variable itself, so each is at a
# link-time offset from the thread pointer
val X86_64_FREESTANDING_ADDRESSES: Model = Model{
    relocation: Relocation.static{},
    preemption: Preemption.none{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.local_exec{},
        local_dynamic:   Access.local_exec{},
        initial_exec:    Access.local_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "",
        index:           "",
    },
};

# a shared object's code under the pic code model: a symbol of default
# visibility it defines may be preempted, so it is reached through the global
# offset table and called through the procedure linkage table, while a
# protected, hidden or local one is reached directly. a shared object is
# never the executable, so a variable of the executable is reached at its
# offset the global offset table holds, never at a link-time one
val X86_64_LINUX_PIC: Model = Model{
    relocation: Relocation.pie{},
    preemption: Preemption.exported{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.initial_exec{},
        lookup:          "__tls_get_addr",
        index:           "",
    },
};

# what mirl makes of each code model mink's hosts offer, keyed by mink's row.
# mink offers the psabi's small model alone, which mirl carries. a
# shared object's model is the product's, see each row's `shared`: a pe
# dll is an image like an executable, so windows' is its default, and
# darwin's two-level namespace preempts a dylib's symbols as it does an
# executable's, so darwin's is its default too
val X86_64_LINUX_CODES: [1]address.Code = [1]address.Code{
    address.Code{model: opt[*CodeModel].some{?x86.X86_64_SMALL}, offer: Offer.carried{X86_64_LINUX_ADDRESSES}},
};
val X86_64_DARWIN_CODES: [1]address.Code = [1]address.Code{
    address.Code{model: opt[*CodeModel].some{?x86.X86_64_SMALL}, offer: Offer.carried{X86_64_DARWIN_ADDRESSES}},
};
val X86_64_WINDOWS_CODES: [1]address.Code = [1]address.Code{
    address.Code{model: opt[*CodeModel].some{?x86.X86_64_SMALL}, offer: Offer.carried{X86_64_WINDOWS_ADDRESSES}},
};
val X86_64_UEFI_CODES: [1]address.Code = [1]address.Code{
    address.Code{model: opt[*CodeModel].some{?x86.X86_64_SMALL}, offer: Offer.carried{X86_64_UEFI_ADDRESSES}},
};
val X86_64_FREESTANDING_CODES: [1]address.Code = [1]address.Code{
    address.Code{model: opt[*CodeModel].some{?x86.X86_64_SMALL}, offer: Offer.carried{X86_64_FREESTANDING_ADDRESSES}},
};

val MODELS: [5]axis.Model = [5]axis.Model{
    axis.Model{arch: ?x86.X86_64, sys: ?LINUX, misaligned: true, red: true, codes: Slice[address.Code]{data: ?X86_64_LINUX_CODES[0], size: 1}, shared: Offer.carried{X86_64_LINUX_PIC}},
    axis.Model{arch: ?x86.X86_64, sys: ?DARWIN, misaligned: true, red: true, codes: Slice[address.Code]{data: ?X86_64_DARWIN_CODES[0], size: 1}, shared: Offer.carried{X86_64_DARWIN_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?WINDOWS, misaligned: true, codes: Slice[address.Code]{data: ?X86_64_WINDOWS_CODES[0], size: 1}, shared: Offer.carried{X86_64_WINDOWS_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?UEFI, misaligned: true, codes: Slice[address.Code]{data: ?X86_64_UEFI_CODES[0], size: 1}, shared: Offer.declined{"x86_64 uefi builds no shared object, as its firmware loader maps no image into another"}},
    axis.Model{arch: ?x86.X86_64, sys: ?FREESTANDING, misaligned: true, codes: Slice[address.Code]{data: ?X86_64_FREESTANDING_CODES[0], size: 1}, shared: Offer.declined{"x86_64 freestanding builds no shared object, as no loader maps one into an image"}},
};

# the x86-64 rows of every axis
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 1},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 2},
    declined: Slice[axis.Declined]{data: nil, size: 0},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 5},
};
