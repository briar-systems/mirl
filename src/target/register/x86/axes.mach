# x86-64 under the sysv psabi, the same for linux, darwin, windows and freestanding
val X86_64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.architecture{}, layout: Rules.c{}},
};
# the integer instructions of every width from a byte up
val X86_64_ALU:      [4]u32 = [4]u32{8, 16, 32, 64};
val X86_64_WORDS:    [2]u32 = [2]u32{32, 64};
val X86_64_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
# mul and imul with one operand give the whole product in a register pair
val X86_64_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 64},
};
# ssse3 and sse4.1, the extensions the x86-64 rows' conditions name
val SSSE3_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.SSSE3};
val SSSE3_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?SSSE3_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_SSSE3:        Condition                  = Condition.requires{requirement.Requirement{at: ?SSSE3_ALTERNATIVES[0], len: 1}};
val SSE41_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.SSE41};
val SSE41_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?SSE41_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_SSE41:        Condition                  = Condition.requires{requirement.Requirement{at: ?SSE41_ALTERNATIVES[0], len: 1}};
# roundss and roundsd are sse4.1's. minss and maxss give the second operand
# for a nan or two zeros, so no minimum or maximum is native, and sse has no
# remainder
val X86_64_NATIVES: [4]Native = [4]Native{
    Native{opcode: ir.FFLOOR, condition: UNDER_SSE41},
    Native{opcode: ir.FCEIL, condition: UNDER_SSE41},
    Native{opcode: ir.FINT, condition: UNDER_SSE41},
    Native{opcode: ir.FNEAREST, condition: UNDER_SSE41},
};
# sse2 computes binary32 and binary64 and returns the first nan operand, and
# an invalid operation gives the negative quiet nan, the real indefinite
# (intel sdm volume 1, 4.8.3.7 "QNaN Floating-Point Indefinite"). a float
# constant is loaded from memory
val X86_64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.negative{}, priority: Priority.first{}, fused: Fused.unordered{}}}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 4}}, constants: Constants.loaded{}},
    Held{format: ?BINARY64, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.negative{}, priority: Priority.first{}, fused: Fused.unordered{}}}, natives: Natives.rows{Slice[Native]{data: ?X86_64_NATIVES[0], size: 4}}, constants: Constants.loaded{}},
};
# binary16 is held by no row, as none states avx512_fp16's, so the half
# precision legalisation widens it exactly to binary32, or binary64 for a fused
# multiply-add, both always held, and narrows the result keeping a nan's sign
# and payload quieted. binary16 then returns sse's rule: the first nan
# operand, and the negative default nan for an invalid operation
val X86_64_LOWERED: [1]Lowered = [1]Lowered{
    Lowered{format: ?BINARY16, widened: Narrowing.kept{}, helpers: Helpers.none{}},
};
# the sse2 unit: packed integer lanes of each width, and packed binary32 and binary64
val X86_64_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# the operations the sse rules select over packed lanes: sums, differences
# and the bitwise operations at every integer width, the multiply of words and
# doublewords, binary32 and binary64 arithmetic and square root, the widening
# of a lane, a splat, a build, an extract and an insert of every lane type, a
# shuffle of every lane type, of bytes and words under ssse3's pshufb, and
# every reduction but a float minimum or maximum. every other operation is
# taken lane by lane
val X86_64_OPERATIONS: [118]Operation = [118]Operation{
    Operation{opcode: ir.ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{16}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{16}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{32}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{16}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{16}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{32}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VBUILD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VINSERT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: UNDER_SSSE3},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: UNDER_SSSE3},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VSHUFFLE, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_MUL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_MUL, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_ANY, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_ANY, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMUL_ANY, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMUL_ANY, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_SEQ, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_SEQ, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMUL_SEQ, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMUL_SEQ, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
};
# the byte sizes the sse2 rules load and store a vector at (movd, movq and
# movdqu), so a vector of any other size splits
val X86_64_VECTOR_BYTES: [3]u32 = [3]u32{4, 8, 16};
# sse2, which every x86-64 has, holding no mask in a register yet
val X86_64_UNITS: [1]Unit = [1]Unit{
    Unit{requires: Condition.always{}, width: Width.fixed{128}, counts: Counts.bytes{Slice[u32]{data: ?X86_64_VECTOR_BYTES[0], size: 3}}, lanes: Slice[Lane]{data: ?X86_64_LANES[0], size: 6}, operations: Operations.rows{Slice[Operation]{data: ?X86_64_OPERATIONS[0], size: 118}}, masks: Masks.none{}},
};
# avx's ymm and avx-512f's zmm, the vector registers beyond sse2's
val AVX_ATOMS:            [1]requirement.Id          = [1]requirement.Id{x86_extension.AVX};
val AVX_ALTERNATIVES:     [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?AVX_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val AVX512F_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.AVX512F};
val AVX512F_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?AVX512F_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
# sse2's 128 bit xmm, which every x86-64 has, widened to 256 under avx and to
# 512 under avx-512f
val X86_64_VECTOR_REGISTERS: [3]VectorRegister = [3]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
    VectorRegister{requires: Condition.requires{requirement.Requirement{at: ?AVX_ALTERNATIVES[0], len: 1}}, width: Width.fixed{256}},
    VectorRegister{requires: Condition.requires{requirement.Requirement{at: ?AVX512F_ALTERNATIVES[0], len: 1}}, width: Width.fixed{512}},
};
# int3
val X86_64_FILL: [1]u8 = [1]u8{0xCC};
# the lp64 widths of the sysv psabi (3.1.2 "data representation"): _Bool and
# the integers to long at their size, __int128 at 16, and above 128 bits a
# _BitInt(N), a structure of 64-bit chunks aligned to 8
val X86_64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 8}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 8}}},
};
# _Float16, float and double, each at its size
val X86_64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# the scalar types of microsoft's x64 abi ("x64 software conventions", "x64
# type and storage layout"), a condition held in its byte as an INT8. it
# states no integer wider than __int64 and no 16-bit float, so those rows are
# mirl-defined, no spec states this: i128 at 16 aligned to 16, a wider one in
# 16 byte chunks aligned to 16, and a 16-bit float at 2
val WIN64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}}, IntegerLayout{width: 128, stored: Stored.defined{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.defined{Scalar{size: 32, align: 16}}},
    IntegerLayout{width: 512, stored: Stored.defined{Scalar{size: 64, align: 16}}},
};
val WIN64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.defined{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# cx16's lock cmpxchg16b, which compares rdx:rax with memory and swaps in rcx:rbx
val CX16_ATOMS:        [1]requirement.Id          = [1]requirement.Id{x86_extension.CX16};
val CX16_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?CX16_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val X86_64_PAIRED:     Atomics                    = Atomics{paired: Paired.native{Swap{condition: Condition.requires{requirement.Requirement{at: ?CX16_ALTERNATIVES[0], len: 1}}, refusal: "a compare and exchange of two words on a build without cx16, whose cmpxchg16b compares and swaps sixteen bytes"}}};

# x86-64, the same under every system
val X86_64_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.none{},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?X86_64_POINTERS[0], size: 1},
        slots:    SlotSpace.space{0},
        models:   Models.none{},
        register: Bits.bits{64},
        alu:      Set.widths{Slice[u32]{data: ?X86_64_ALU[0], size: 4}},
        integers: Set.widths{Slice[u32]{data: ?X86_64_INTEGERS[0], size: 4}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?X86_64_UNITS[0], size: 1}},
    formats:    Formats.held{Slice[Held]{data: ?X86_64_HELD[0], size: 2}},
    lowered:    Lowerings.rows{Slice[Lowered]{data: ?X86_64_LOWERED[0], size: 1}},
    arithmetic: Arithmetic{
        multiply:   Set.widths{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
        multiplied: Condition.always{},
        products:   Products.forms{Slice[Product]{data: ?X86_64_PRODUCTS[0], size: 4}},
        shifts:     Shifts.wraps{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}},
        single:     Single.none{},
        # div and idiv raise the divide error for a zero divisor and an overflowing quotient, and
        # div divides edx:eax and rdx:rax. the byte and word forms divide ah:al and dx:ax, whose
        # halves the selection does not split, so a byte or a word divides at 32 bits
        division: Division{widths: Set.widths{Slice[u32]{data: ?X86_64_WORDS[0], size: 2}}, condition: Condition.always{}, zero: Fault.traps{}, overflow: Fault.traps{}, long: LongDivision.native{Long{widths: Slice[u32]{data: ?X86_64_WORDS[0], size: 2}, zero: Fault.traps{}, exceeds: Fault.traps{}}}},
    },
    # rep movsb and rep stosb
    bulk:    BulkMemory{copy: Bulk.native{}, fill: Bulk.native{}, moves: 8},
    atomics: X86_64_PAIRED,
    code:    Code{
        function: Align.bytes{16},
        text:     Align.bytes{16},
        data:     Align.bytes{8},
        fill:     Fill.pattern{Slice[u8]{data: ?X86_64_FILL[0], size: 1}},
    },
    placed:     Placed{section: Honours.honoured{}, alignment: Honours.honoured{}},
    attributes: Attributes.schema{?SCHEMA},
    ops:        Ops.none{},
    handles:    Handles.none{},
};

# the lp64 data of the sysv psabi
val X86_64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?X86_64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?X86_64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?X86_64_VECTOR_REGISTERS[0], size: 3}}},
};

# the data of microsoft's x64 abi
val WIN64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?WIN64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?WIN64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?X86_64_VECTOR_REGISTERS[0], size: 3}}},
};

val MACHINES: [1]axis.Machine = [1]axis.Machine{axis.Machine{arch: ?x86.X86_64, caps: X86_64_CAPS}};

# the x86-64 conventions, by mink's psabi names
val MEMBERS: [2]axis.Member = [2]axis.Member{
    axis.Member{arch: ?x86.X86_64, name: "sysv64", row: opt[*Convention].some{?abi.SYSV64}, data: X86_64_DATA},
    axis.Member{arch: ?x86.X86_64, name: "win64", row: opt[*Convention].some{?abi.WIN64}, data: WIN64_DATA},
};

# linux code is position independent, and a thread-local variable of a module
# loaded at any time is reached through the runtime's lookup (x86-64 psabi,
# "thread-local storage"), which the selection does not reach yet
val X86_64_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
        index:           "",
    },
};

# darwin code is position independent, and every thread-local variable is
# reached through the thunk of its descriptor the loader binds
val X86_64_DARWIN_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.variable{},
        local_dynamic:   Access.variable{},
        initial_exec:    Access.variable{},
        local_exec:      Access.variable{},
        lookup:          "_tlv_bootstrap",
        index:           "",
    },
};

# a pe image is rebased by its loader and resolves every symbol at link time,
# and a thread-local variable is reached through the index the loader writes
# in _tls_index, which the image's tls directory names (pe format, "the .tls
# section"). no thread-local model calls a lookup
val X86_64_WINDOWS_ADDRESSES: Model = Model{
    relocation: Relocation.image{},
    threads:    Threads{
        general_dynamic: Access.indexed{},
        local_dynamic:   Access.indexed{},
        initial_exec:    Access.indexed{},
        local_exec:      Access.indexed{},
        lookup:          "",
        index:           "_tls_index",
    },
};

# a uefi image is a pe image whose firmware loader keeps no thread's table of
# module blocks, so it names no index cell and reaches no thread-local
# variable
val X86_64_UEFI_ADDRESSES: Model = Model{
    relocation: Relocation.image{},
    threads:    Threads{
        general_dynamic: Access.indexed{},
        local_dynamic:   Access.indexed{},
        initial_exec:    Access.indexed{},
        local_exec:      Access.indexed{},
        lookup:          "",
        index:           "",
    },
};

# a freestanding image is linked at its address and holds every thread-local
# variable itself, so each is at a link-time offset from the thread pointer
val X86_64_FREESTANDING_ADDRESSES: Model = Model{
    relocation: Relocation.static{},
    threads:    Threads{
        general_dynamic: Access.local_exec{},
        local_dynamic:   Access.local_exec{},
        initial_exec:    Access.local_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "",
        index:           "",
    },
};

val MODELS: [5]axis.Model = [5]axis.Model{
    axis.Model{arch: ?x86.X86_64, sys: ?LINUX, addresses: Addresses.model{X86_64_LINUX_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?DARWIN, addresses: Addresses.model{X86_64_DARWIN_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?WINDOWS, addresses: Addresses.model{X86_64_WINDOWS_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?UEFI, addresses: Addresses.model{X86_64_UEFI_ADDRESSES}},
    axis.Model{arch: ?x86.X86_64, sys: ?FREESTANDING, addresses: Addresses.model{X86_64_FREESTANDING_ADDRESSES}},
};

# the x86-64 rows of every axis
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 1},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 2},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 5},
};
