# the x86-64 rows written in a short form once their registers are allocated
#
# the arithmetic and test rows of a full immediate have a form one byte
# shorter for the accumulator, al, ax, eax or rax, which masc's reader takes
# for the text of the general row whenever its register is the accumulator,
# and an exchange of a register with the accumulator reads back to 90+r. each
# general row selection writes is paired with its accumulator form, the
# exchange's two forms in the order masc's rows put them, which is the order
# its reader tries them in, so the one the view admits first is taken. an
# immediate of a sign extended byte keeps its own form, which the reader
# prefers to the accumulator's.

use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;
use mirl.machine.isa.Short;
use mirl.machine.isa.Shorts;

val ROWS: [42]Short = [42]Short{
    Short{long: ?gen_row.ROWS[gen_row_index.ADD_GPR8_IMM8_80R0], short: ?gen_row.ROWS[gen_row_index.ADD_AL_IMM8_04]},
    Short{long: ?gen_row.ROWS[gen_row_index.ADD_GPR16_IMM16_81R0_O16], short: ?gen_row.ROWS[gen_row_index.ADD_AX_IMM16_05_O16]},
    Short{long: ?gen_row.ROWS[gen_row_index.ADD_GPR32_IMM32_81R0_O32], short: ?gen_row.ROWS[gen_row_index.ADD_EAX_IMM32_05_O32]},
    Short{long: ?gen_row.ROWS[gen_row_index.ADD_GPR64_IMM32_81R0_O64], short: ?gen_row.ROWS[gen_row_index.ADD_RAX_IMM32_05_O64]},
