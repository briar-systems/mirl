# the x86-64 table's guards and the immediates it computes from constants
#
# a guard reads what a type test cannot: how the target's address model
# reaches the symbol an operand is the address of, and the size of a vector a
# load or a store moves. a derived immediate is a scale or a part of a
# constant.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mink.catalog.format;
use mink.catalog.format.Format;

use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use types: mirl.ir.type;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.record;

# the address a value is, none for a value that is no symbol's address
fun address_of(mt: *Match, v: opt[id.Value]) opt[Address] {
    if (sel v.none) { ret opt[Address].none{}; }
    val got: res[opt[Address], match.Refusal] = match.address(mt, v.some);
    if (sel got.err) { ret opt[Address].none{}; }
    ret got.ok;
}

# how the target's model reaches the symbol of an address, none on a target
# with no model
fun reach_of(mt: *Match, a: Address) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val at: id.Symbol = a.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function.index];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global.index].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# whether x86-64 reaches an address from the instruction's own: one the model
# reaches by its distance from the code, or absolutely, which the small code
# model keeps within 2 GiB of it
fun near(mt: *Match, v: opt[id.Value]) bool {
    val a: opt[Address] = address_of(mt, v);
    if (sel a.none) { ret false; }
    val r: opt[Reach] = reach_of(mt, a.some);
    ret sel r.some && (sel r.some.relative || sel r.some.absolute);
}

# operand 0 of the root is the address of a symbol reached rip-relative
pub fun symbol_00(mt: *Match) bool {
    ret near(mt, match.operand(mt, Slot{node: 0, index: 0}));
}

# operand 0 of the second node is the address of a symbol reached rip-relative
pub fun symbol_10(mt: *Match) bool {
    ret near(mt, match.operand(mt, Slot{node: 1, index: 0}));
}

# the address a rule builds, a constant's or a func.addr's, is reached rip-relative
pub fun plain_built(mt: *Match) bool {
    ret near(mt, match.built(mt));
}

# the callee of a call is the address of a symbol other than a thread-local
# variable's. a call reaches it through the branch relocation under every
# model, which a format routes through the procedure linkage table where the
# symbol may be in another image
pub fun callee_00(mt: *Match) bool {
    val a: opt[Address] = address_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
    if (sel a.none) { ret false; }
    val at: id.Symbol = a.some.symbol;
    if (sel at.function) { ret true; }
    val g: *GlobalData = ?mt.module.globals.data[at.global.index].data;
    ret sel g.tls.none;
}

# the object format the target's system writes, none for a target without one
fun format_of(mt: *Match) opt[*Format] {
    val f: res[*Format, record.Error] = record.format(mt.target);
    if (sel f.err) { ret opt[*Format].none{}; }
    ret opt[*Format].some{f.ok};
}

fun elf(mt: *Match) bool {
    val f: opt[*Format] = format_of(mt);
    ret sel f.some && f.some == ?format.ELF;
}

fun macho(mt: *Match) bool {
    val f: opt[*Format] = format_of(mt);
    ret sel f.some && f.some == ?format.MACHO;
}

# how the model reaches the address a rule builds, none for a value that is
# no address. an address past its symbol is the selection's to finish where
# the relocation carries no offset, as a slot of the global offset table does
fun reached(mt: *Match) opt[Reach] {
    val a: opt[Address] = address_of(mt, match.built(mt));
    if (sel a.none) { ret opt[Reach].none{}; }
    ret reach_of(mt, a.some);
}

fun tabled(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.table;
}

# the address a rule builds is loaded from the global offset table, under
# each object format's relocation for it
pub fun elf_table(mt: *Match) bool {
    ret elf(mt) && tabled(mt);
}

pub fun macho_table(mt: *Match) bool {
    ret macho(mt) && tabled(mt);
}

fun thread(mt: *Match) opt[Access] {
    val r: opt[Reach] = reached(mt);
    if (sel r.none)           { ret opt[Access].none{}; }
    if (!(sel r.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{r.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.local_exec && elf(mt);
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.initial_exec && elf(mt);
}

# a thread-local variable reached through the thunk of its variable descriptor
pub fun variable(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.variable && macho(mt);
}

# the constant a rule builds is the null pointer, no symbol's address
pub fun null(mt: *Match) bool {
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, mt.subject);
    if (sel got.err)     { ret false; }
    if (sel got.ok.none) { ret false; }
    val c: ConstantData = got.ok.some;
    if (sel c.zero) { ret true; }
    val b: res[opt[i64], match.Refusal] = match.bits(mt, mt.subject);
    if (sel b.err)     { ret false; }
    if (sel b.ok.none) { ret false; }
    ret b.ok.some == 0;
}

# operand 1 of node 2 is the constant zero, as a guard's test of a zero divisor
pub fun zero_21(mt: *Match) bool {
    val v: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 1});
    if (sel v.none) { ret false; }
    val b: res[opt[i64], match.Refusal] = match.bits(mt, v.some);
    if (sel b.err)     { ret false; }
    if (sel b.ok.none) { ret false; }
    ret b.ok.some == 0;
}

# the constant a rule builds is below 2^32, which a 32-bit move zero extends
pub fun unsigned_32(mt: *Match) bool {
    val b: res[opt[i64], match.Refusal] = match.bits(mt, mt.subject);
    if (sel b.err)     { ret false; }
    if (sel b.ok.none) { ret false; }
    ret b.ok.some >= 0 && b.ok.some <= 0xffffffff;
}

# the bits of a type, a vector's its lanes', zero for a type with none
fun bits_of(t: *types.Table, ty: types.Type) u64 {
    val s: res[types.Shape, types.Error] = types.shape(t, ty);
    if (sel s.err) { ret 0; }
    val sh: types.Shape = s.ok;
    if (sel sh.integer) { ret sh.integer.width::u64; }
    if (sel sh.float) {
        val r: opt[types.Row] = types.row(sh.float.format);
        if (sel r.none) { ret 0; }
        ret r.some.width::u64;
    }
    if (sel sh.vector) { ret sh.vector.lanes::u64 * bits_of(t, sh.vector.element); }
    ret 0;
}

fun value_bits(mt: *Match, v: opt[id.Value]) u64 {
    if (sel v.none) { ret 0; }
    ret bits_of(?mt.module.types, match.value(mt, v.some).type);
}

fun loaded(mt: *Match, bytes: u64) bool {
    ret value_bits(mt, match.result(mt, Slot{node: 0, index: 0})) == bytes * 8;
}

fun stored(mt: *Match, bytes: u64) bool {
    ret value_bits(mt, match.operand(mt, Slot{node: 0, index: 1})) == bytes * 8;
}

# a load of a vector of 16, 8 or 4 bytes
pub fun bytes_16(mt: *Match) bool {
    ret loaded(mt, 16);
}

pub fun bytes_8(mt: *Match) bool {
    ret loaded(mt, 8);
}

pub fun bytes_4(mt: *Match) bool {
    ret loaded(mt, 4);
}

# a store of a vector of 16, 8 or 4 bytes
pub fun stored_16(mt: *Match) bool {
    ret stored(mt, 16);
}

pub fun stored_8(mt: *Match) bool {
    ret stored(mt, 8);
}

pub fun stored_4(mt: *Match) bool {
    ret stored(mt, 4);
}

# the same, from the address of a symbol reached rip-relative
pub fun bytes_16_symbol_00(mt: *Match) bool {
    ret loaded(mt, 16) && symbol_00(mt);
}

pub fun bytes_8_symbol_00(mt: *Match) bool {
    ret loaded(mt, 8) && symbol_00(mt);
}

pub fun bytes_4_symbol_00(mt: *Match) bool {
    ret loaded(mt, 4) && symbol_00(mt);
}

pub fun bytes_16_symbol_10(mt: *Match) bool {
    ret loaded(mt, 16) && symbol_10(mt);
}

pub fun bytes_8_symbol_10(mt: *Match) bool {
    ret loaded(mt, 8) && symbol_10(mt);
}

pub fun bytes_4_symbol_10(mt: *Match) bool {
    ret loaded(mt, 4) && symbol_10(mt);
}

pub fun stored_16_symbol_00(mt: *Match) bool {
    ret stored(mt, 16) && symbol_00(mt);
}

pub fun stored_8_symbol_00(mt: *Match) bool {
    ret stored(mt, 8) && symbol_00(mt);
}

pub fun stored_4_symbol_00(mt: *Match) bool {
    ret stored(mt, 4) && symbol_00(mt);
}

pub fun stored_16_symbol_10(mt: *Match) bool {
    ret stored(mt, 16) && symbol_10(mt);
}

pub fun stored_8_symbol_10(mt: *Match) bool {
    ret stored(mt, 8) && symbol_10(mt);
}

pub fun stored_4_symbol_10(mt: *Match) bool {
    ret stored(mt, 4) && symbol_10(mt);
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val v: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel v.none) { ret false; }
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, v.some);
    ret sel got.ok && sel got.ok.none;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# the power of two a multiplier is, -1 for one that is none, which no scale takes
pub fun log2(c: i64) i64 {
    if (c <= 0 || (c & (c - 1)) != 0) { ret -1; }
    ret trailing(c::u64);
}

# the scale a shift left by a constant makes
pub fun scale_of(c: i64) i64 {
    ret c;
}

# a condition's bit
pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

# a number as it is
pub fun same(c: i64) i64 {
    ret c;
}

# the low thirty two bits of a number, sign extended
pub fun low_word(c: i64) i64 {
    val l: i64 = c & 0xffffffff;
    if (l >= 0x80000000) { ret l - 0x100000000; }
    ret l;
}
