# the x86-64 table's guards and the immediates it computes from constants
#
# a guard reads what a type test cannot: how the target's address model
# reaches the symbol an operand is the address of, the size of a vector a
# load or a store moves, and a constant a row of its own states. a derived immediate is a scale or a part of a
# constant.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;

use mink.catalog.format;

use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use opcode_table: mirl.ir.opcode.table;
use type_format:  mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.value.ValueData;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.record;

# the address a value is, none for a value that is no symbol's address
fun address_of(mt: *Match, v: opt[id.Value]) opt[Address] {
    if (sel v.none) { ret opt[Address].none{}; }
    val res_address: res[opt[Address], match.Error] = match.address(mt, v.some);
    if (sel res_address.err) { ret opt[Address].none{}; }
    ret res_address.ok;
}

# how the target's model reaches the symbol of an address, none on a target
# with no model
fun reach_of(mt: *Match, a: Address) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val at: id.Symbol = a.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# whether x86-64 reaches an address from the instruction's own: one the model
# reaches by its distance from the code, or absolutely, which the small code
# model keeps within 2 GiB of it
fun near(mt: *Match, v: opt[id.Value]) bool {
    val opt_address_of: opt[Address] = address_of(mt, v);
    if (sel opt_address_of.none) { ret false; }
    val opt_reach_of: opt[Reach] = reach_of(mt, opt_address_of.some);
    ret sel opt_reach_of.some && (sel opt_reach_of.some.relative || sel opt_reach_of.some.absolute);
}

# operand 0 of the root is the address of a symbol reached rip-relative
pub fun symbol_00(mt: *Match) bool {
    ret near(mt, match.operand(mt, Slot{node: 0, index: 0}));
}

# operand 0 of the second node is the address of a symbol reached rip-relative
pub fun symbol_10(mt: *Match) bool {
    ret near(mt, match.operand(mt, Slot{node: 1, index: 0}));
}

# the address a rule builds, a constant's or a func.addr's, is reached rip-relative
pub fun plain_built(mt: *Match) bool {
    ret near(mt, match.built(mt));
}

# the callee of a call is the address of a symbol other than a thread-local
# variable's. a call reaches it through the branch relocation under every
# model, which a format routes through the procedure linkage table where the
# symbol may be in another image
pub fun callee_00(mt: *Match) bool {
    val opt_address_of: opt[Address] = address_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
    if (sel opt_address_of.none) { ret false; }
    val at: id.Symbol = opt_address_of.some.symbol;
    if (sel at.function) { ret true; }
    val g: *GlobalData = ?mt.module.globals.data[at.global].data;
    ret sel g.tls.none;
}

fun elf(mt: *Match) bool {
    ret record.format(mt.target) == ?format.ELF;
}

fun macho(mt: *Match) bool {
    ret record.format(mt.target) == ?format.MACHO;
}

fun coff(mt: *Match) bool {
    ret record.format(mt.target) == ?format.COFF;
}

# how the model reaches the address a rule builds, none for a value that is
# no address. an address past its symbol is the selection's to finish where
# the relocation carries no offset, as a slot of the global offset table does
fun reached(mt: *Match) opt[Reach] {
    val opt_address_of: opt[Address] = address_of(mt, match.built(mt));
    if (sel opt_address_of.none) { ret opt[Reach].none{}; }
    ret reach_of(mt, opt_address_of.some);
}

fun tabled(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.table;
}

# the address a rule builds is loaded from the global offset table, under
# each object format's relocation for it
pub fun elf_table(mt: *Match) bool {
    ret elf(mt) && tabled(mt);
}

# the address a rule builds is loaded from the global offset table on mach-o
# ---
# mt:  the match the guard reads
# ret: whether the format is mach-o and the model reaches the address through the table
pub fun macho_table(mt: *Match) bool {
    ret macho(mt) && tabled(mt);
}

fun thread(mt: *Match) opt[Access] {
    val opt_reached: opt[Reach] = reached(mt);
    if (sel opt_reached.none)           { ret opt[Access].none{}; }
    if (!(sel opt_reached.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{opt_reached.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.local_exec && elf(mt);
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.initial_exec && elf(mt);
}

# a thread-local variable reached through the thunk of its variable descriptor
pub fun variable(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.variable && macho(mt);
}

# the copy may run from its lowest byte up
pub fun ascending(mt: *Match) bool {
    ret match.ascending(mt, 0);
}

# a thread-local variable reached through the module's block in the thread's
# table, at the index the loader writes in the cell the model names
pub fun indexed(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.indexed && coff(mt);
}

# a switch whose cases index a table of its targets, on a target whose
# address model places the table. lea reaches the function's own table from
# the instruction's address under every relocation model, so no model chooses
# the sequence
pub fun jump_table(mt: *Match) bool {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret false; }
    ret match.indexed(mt);
}

# the constant a rule builds is the null pointer, no symbol's address
pub fun null(mt: *Match) bool {
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, mt.subject);
    if (sel res_constant.err)     { ret false; }
    if (sel res_constant.ok.none) { ret false; }
    val c: ConstantData = res_constant.ok.some;
    if (sel c.zero) { ret true; }
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, mt.subject);
    if (sel res_bits.err)     { ret false; }
    if (sel res_bits.ok.none) { ret false; }
    ret res_bits.ok.some == 0;
}

# operand 1 of node 1 is the constant zero, a compare a branch makes with zero
pub fun zero_11(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 1, index: 1});
    if (sel opt_operand.none) { ret false; }
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, opt_operand.some);
    if (sel res_bits.err)     { ret false; }
    if (sel res_bits.ok.none) { ret false; }
    ret res_bits.ok.some == 0;
}

# operand 1 of node 2 is the constant zero, as a guard's test of a zero divisor
pub fun zero_21(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 1});
    if (sel opt_operand.none) { ret false; }
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, opt_operand.some);
    if (sel res_bits.err)     { ret false; }
    if (sel res_bits.ok.none) { ret false; }
    ret res_bits.ok.some == 0;
}

# operand 1 of the root is the constant one, a shift count the row of count
# one states and the row of an immediate count does not, whose text masc
# reads back to the row of count one
pub fun one_01(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 1});
    if (sel opt_operand.none) { ret false; }
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, opt_operand.some);
    if (sel res_bits.err)     { ret false; }
    if (sel res_bits.ok.none) { ret false; }
    ret res_bits.ok.some == 1;
}

# the constant a rule builds is below 2^32, which a 32-bit move zero extends
pub fun unsigned_32(mt: *Match) bool {
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, mt.subject);
    if (sel res_bits.err)     { ret false; }
    if (sel res_bits.ok.none) { ret false; }
    ret res_bits.ok.some >= 0 && res_bits.ok.some <= 0xffffffff;
}

# operand 0 of the root, an integer of at most 64 bits, is held zero extended
# through its whole register, so its zero extension is the value as it
# stands: the result of an integer load, which every load rule of the table
# and the frame code's reload of a slot write by movzx or a 32-bit or 64-bit
# move, a constant whose bits are not negative, which the constant rules build
# by a move of at least 32 bits, or the zero extension of either, which every
# extension rule writes whole
pub fun extended_00(mt: *Match) bool {
    if (value_bits(mt, match.result(mt, Slot{node: 0, index: 0})) > 64) { ret false; }
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel opt_operand.none) { ret false; }
    var v: id.Value = opt_operand.some;
    for {
        val res_bits: res[opt[i64], match.Error] = match.bits(mt, v);
        if (sel res_bits.err)     { ret false; }
        if (sel res_bits.ok.some) { ret res_bits.ok.some >= 0; }
        val d: *ValueData = match.value(mt, v);
        if (!(sel d.def.result)) { ret false; }
        val i: *InstructionData = ?mt.body.instructions.data[d.def.result.instruction];
        if (i.opcode == opcode_table.LOAD || i.opcode == opcode_table.ATOMIC_LOAD) { ret value_bits(mt, opt[id.Value].some{v}) <= 32; }
        if (i.opcode != opcode_table.EXT_U)                                        { ret false; }
        v = i.operands.data[0];
    }
    ret false;
}

# the bits of a type, a vector's its lanes', zero for a type with none
fun bits_of(t: *table.Table, ty: table.Type) u64 {
    val res_shape: res[table.Shape, table.Error] = table.shape(t, ty);
    if (sel res_shape.err) { ret 0; }
    val sh: table.Shape = res_shape.ok;
    if (sel sh.integer) { ret sh.integer.width::u64; }
    if (sel sh.float) {
        val opt_row: opt[type_format.Row] = type_format.row(sh.float.format);
        if (sel opt_row.none) { ret 0; }
        ret opt_row.some.width::u64;
    }
    if (sel sh.vector) { ret sh.vector.lanes::u64 * bits_of(t, sh.vector.element); }
    ret 0;
}

fun value_bits(mt: *Match, v: opt[id.Value]) u64 {
    if (sel v.none) { ret 0; }
    ret bits_of(?mt.module.types, match.value(mt, v.some).type);
}

fun loaded(mt: *Match, bytes: u64) bool {
    ret value_bits(mt, match.result(mt, Slot{node: 0, index: 0})) == bytes * 8;
}

fun stored(mt: *Match, bytes: u64) bool {
    ret value_bits(mt, match.operand(mt, Slot{node: 0, index: 1})) == bytes * 8;
}

# a vector of 32 bytes the root gives, as a load, a lanewise operation or the
# widened mask of a comparison does, and a store of one
pub fun bytes_32(mt: *Match) bool {
    ret loaded(mt, 32);
}

pub fun stored_32(mt: *Match) bool {
    ret stored(mt, 32);
}

pub fun bytes_32_symbol_00(mt: *Match) bool {
    ret loaded(mt, 32) && symbol_00(mt);
}

pub fun bytes_32_symbol_10(mt: *Match) bool {
    ret loaded(mt, 32) && symbol_10(mt);
}

pub fun stored_32_symbol_00(mt: *Match) bool {
    ret stored(mt, 32) && symbol_00(mt);
}

pub fun stored_32_symbol_10(mt: *Match) bool {
    ret stored(mt, 32) && symbol_10(mt);
}

# a load of a vector of 16, 8 or 4 bytes
pub fun bytes_16(mt: *Match) bool {
    ret loaded(mt, 16);
}

# a load of a vector of 8 bytes
# ---
# mt:  the match the guard reads
# ret: whether the root's result is 64 bits wide
pub fun bytes_8(mt: *Match) bool {
    ret loaded(mt, 8);
}

# a load of a vector of 4 bytes
# ---
# mt:  the match the guard reads
# ret: whether the root's result is 32 bits wide
pub fun bytes_4(mt: *Match) bool {
    ret loaded(mt, 4);
}

# a store of a vector of 16, 8 or 4 bytes
pub fun stored_16(mt: *Match) bool {
    ret stored(mt, 16);
}

# a store of a vector of 8 bytes
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is 64 bits wide
pub fun stored_8(mt: *Match) bool {
    ret stored(mt, 8);
}

# a store of a vector of 4 bytes
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is 32 bits wide
pub fun stored_4(mt: *Match) bool {
    ret stored(mt, 4);
}

# the same, from the address of a symbol reached rip-relative
pub fun bytes_16_symbol_00(mt: *Match) bool {
    ret loaded(mt, 16) && symbol_00(mt);
}

# a load of 8 bytes from the address of a symbol reached rip-relative at operand 0 of the root
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun bytes_8_symbol_00(mt: *Match) bool {
    ret loaded(mt, 8) && symbol_00(mt);
}

# a load of 4 bytes from the address of a symbol reached rip-relative at operand 0 of the root
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun bytes_4_symbol_00(mt: *Match) bool {
    ret loaded(mt, 4) && symbol_00(mt);
}

# a load of 16 bytes from the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun bytes_16_symbol_10(mt: *Match) bool {
    ret loaded(mt, 16) && symbol_10(mt);
}

# a load of 8 bytes from the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun bytes_8_symbol_10(mt: *Match) bool {
    ret loaded(mt, 8) && symbol_10(mt);
}

# a load of 4 bytes from the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun bytes_4_symbol_10(mt: *Match) bool {
    ret loaded(mt, 4) && symbol_10(mt);
}

# a store of 16 bytes to the address of a symbol reached rip-relative at operand 0 of the root
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_16_symbol_00(mt: *Match) bool {
    ret stored(mt, 16) && symbol_00(mt);
}

# a store of 8 bytes to the address of a symbol reached rip-relative at operand 0 of the root
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_8_symbol_00(mt: *Match) bool {
    ret stored(mt, 8) && symbol_00(mt);
}

# a store of 4 bytes to the address of a symbol reached rip-relative at operand 0 of the root
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_4_symbol_00(mt: *Match) bool {
    ret stored(mt, 4) && symbol_00(mt);
}

# a store of 16 bytes to the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_16_symbol_10(mt: *Match) bool {
    ret stored(mt, 16) && symbol_10(mt);
}

# a store of 8 bytes to the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_8_symbol_10(mt: *Match) bool {
    ret stored(mt, 8) && symbol_10(mt);
}

# a store of 4 bytes to the address of a symbol reached rip-relative at operand 0 of the second node
# ---
# mt:  the match the guard reads
# ret: whether both hold
pub fun stored_4_symbol_10(mt: *Match) bool {
    ret stored(mt, 4) && symbol_10(mt);
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel opt_operand.none) { ret false; }
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, opt_operand.some);
    ret sel res_constant.ok && sel res_constant.ok.none;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# the power of two a multiplier is, -1 for one that is none, which no scale takes
pub fun log2(c: i64) i64 {
    if (c <= 0 || (c & (c - 1)) != 0) { ret -1; }
    ret trailing(c::u64);
}

# the scale a shift left by a constant makes
pub fun scale_of(c: i64) i64 {
    ret c;
}

# a condition's bit
pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

# a number as it is
pub fun same(c: i64) i64 {
    ret c;
}

# the low thirty two bits of a number, sign extended
pub fun low_word(c: i64) i64 {
    val l: i64 = c & 0xffffffff;
    if (l >= 0x80000000) { ret l - 0x100000000; }
    ret l;
}
