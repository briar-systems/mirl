# the operations the x86-64 table has no rule for, and why
#
# an operation here is taken out before selection or waits for the job that
# closes it, and the table's test walks every opcode of the ir against this
# list, the table's rules and the operations the helpers legalisation takes
# out on every build by the target's formats and bulk capability, so an opcode
# in none is a failing test. the
# types a native type excludes (integers wider than the register, half
# precision without Zfh, vectors a build holds in no register) are removed by
# their legalisation and are not opcodes, so they have no entry. an operand a
# rule's type test does not admit is refused by the engine, naming it.

use std.types.string.str;

use ir: mirl.ir.opcode;

# why an opcode has no rule
# ---
# opcode: the opcode
# why:    what takes it out of selection
# owner:  the issue of the job that closes it, zero when no job does yet
pub rec Declared {
    opcode: ir.Opcode;
    why:    str;
    owner:  u32;
}

pub val MINIMUM:    str = "minps and maxps give the second operand for a nan or two zeros, so no float minimum or maximum reduces packed and the vector legalisation takes it lane by lane";
pub val PRODUCT:    str = "the multiply legalisation builds the high half of a signed by unsigned product from the products x86 has";
pub val CONVENTION: str = "the abi legalisation puts a call and a return in piece form, which the rules select";
pub val ADDRESS:    str = "the address legalisation folds a typed address to a ptr.add of its byte offset, which the rules select";
pub val CHAIN:      str = "the compare chain legalisation lowers a multi-way branch to eq and cbr, which the rules select";
pub val AGGREGATE:  str = "an aggregate value is held in no register, so it is taken apart before selection";

pub val DECLARED: [12]Declared = [12]Declared{
    Declared{opcode: ir.REDUCE_FMIN, why: MINIMUM, owner: 0},
    Declared{opcode: ir.REDUCE_FMAX, why: MINIMUM, owner: 0},
    Declared{opcode: ir.REDUCE_FMINNUM, why: MINIMUM, owner: 0},
    Declared{opcode: ir.REDUCE_FMAXNUM, why: MINIMUM, owner: 0},
    Declared{opcode: ir.MUL_HIGH_SU, why: PRODUCT, owner: 0},
    Declared{opcode: ir.CALL, why: CONVENTION, owner: 29},
    Declared{opcode: ir.RET, why: CONVENTION, owner: 29},
    Declared{opcode: ir.PTR_MEMBER, why: ADDRESS, owner: 300},
    Declared{opcode: ir.PTR_INDEX, why: ADDRESS, owner: 300},
    Declared{opcode: ir.SWITCH, why: CHAIN, owner: 300},
    Declared{opcode: ir.EXTRACT, why: AGGREGATE, owner: 178},
    Declared{opcode: ir.INSERT, why: AGGREGATE, owner: 178},
};
