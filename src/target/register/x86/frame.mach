# the x86-64 frame code: the instructions of each move the frame makes
#
# an offset is a 32-bit displacement of the address it is added at, so an add
# is a lea, which sets no flag, and a load or store addresses its slot as
# base plus displacement. an offset past 32 bits is refused `reach`, as no
# frame reaches that far. a load or store is the row of the width the frame
# code's binding chose for the register and the slot's size, from the widths
# below: the general moves at each size and the xmm moves of a binary32, a
# binary64 and a whole register.
#
# windows x64 moves the stack pointer down past a page through __chkstk,
# which takes the bytes in eax, touches each page and leaves rsp as it was,
# so the move is `mov eax, n; call __chkstk; sub rsp, rax`. x86 has no offset
# that scales: a selection's vector registers have one width.

use std.types.bool.bool;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;

use std.collections.slice.Slice;

use mo: masc.core.operand;
use masc.core.quantity;
use rf: masc.core.register;
use masc.core.row.Row;
use masc.isa.x86.gen_register;
use masc.isa.x86.gen_row;
use masc.isa.x86.gen_row_index;
use mink.model.reloc;

use mirl.ir.id;
use mirl.machine.class.Physical;
use mirl.machine.frame.code;
use mirl.machine.frame.code.Code;
use mirl.machine.frame.code.Emit;
use mirl.machine.frame.code.Probes;
use mirl.machine.frame.code.Refusal;
use mirl.machine.frame.code.Steps;
use mirl.machine.frame.code.Width;
use mirl.machine.frame.code.Widths;
use mirl.machine.frame.record.Offset;
use mirl.machine.operand;
use mirl.machine.operand.Operand;
use mirl.machine.operand.Register;

fun physical(r: rf.Id) Operand {
    ret Operand.physical{Physical.register{r}};
}

fun two(e: *Emit, row: *Row, a: Operand, b: Operand) err[Refusal] {
    var ops: [2]Operand = [2]Operand{a, b};
    ret code.append(e, row, Slice[Operand]{data: ?ops[0], size: 2});
}

fun one(e: *Emit, row: *Row, a: Operand) err[Refusal] {
    var ops: [1]Operand = [1]Operand{a};
    ret code.append(e, row, Slice[Operand]{data: ?ops[0], size: 1});
}

# a register as the view a row's register position names, the register of
# the position's class with the same number, as eax of rax
fun viewed(row: *Row, position: u32, r: rf.Id) rf.Id {
    if (position >= row.operands.len) { ret r; }
    val sh: *mo.Shape = ?row.operands.at[position].shape;
    if (!(sel sh.register))           { ret r; }
    if (sh.register.classes.len == 0) { ret r; }
    val class: u16 = sh.register.classes.at[0];
    if (class == rf.class_of(r)) { ret r; }
    ret rf.make(class, rf.number_of(r));
}

fun fits32(v: i64) bool {
    ret v >= -2147483648 && v <= 2147483647;
}

# the memory at a base register plus a displacement
fun at(base: rf.Id, disp: i64) Operand {
    ret Operand.address{operand.Address{base: opt[Register].some{Register.physical{Physical.register{base}}}, index: opt[Register].none{}, segment: opt[Register].none{}, scale: 0, disp: disp, symbol: opt[operand.Symbol].none{}, mode: mo.OFFSET, extend: 0, broadcast: 0}};
}

fun add(e: *Emit, dest: rf.Id, src: rf.Id, by: Offset) err[Refusal] {
    if (by.per != 0)       { ret err[Refusal].err{Refusal.scaled{by}}; }
    if (!fits32(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    ret two(e, ?gen_row.ROWS[gen_row_index.LEA_GPR64_AGEN_8D_O64], physical(dest), at(src, by.fixed));
}

fun mask(e: *Emit, dest: rf.Id, src: rf.Id, align: u64) err[Refusal] {
    if (align > 0x4000_0000) { ret err[Refusal].err{Refusal.mask{align}}; }
    if (dest != src) {
        val moved: err[Refusal] = two(e, ?gen_row.ROWS[gen_row_index.MOV_GPR64_GPR64_89_O64], physical(dest), physical(src));
        if (sel moved.err) { ret moved; }
    }
    ret two(e, ?gen_row.ROWS[gen_row_index.AND_GPR64_IMM32_81R4_O64], physical(dest), Operand.immediate{0 - align::i64});
}

fun sub(e: *Emit, dest: rf.Id, a: rf.Id, b: rf.Id) err[Refusal] {
    val minus: *Row = ?gen_row.ROWS[gen_row_index.SUB_GPR64_GPR64_29_O64];
    if (dest == a) { ret two(e, minus, physical(dest), physical(b)); }
    if (dest != b) {
        val moved: err[Refusal] = two(e, ?gen_row.ROWS[gen_row_index.MOV_GPR64_GPR64_89_O64], physical(dest), physical(a));
        if (sel moved.err) { ret moved; }
        ret two(e, minus, physical(dest), physical(b));
    }
    # dest is b: a - b is -b + a
    val negated: err[Refusal] = one(e, ?gen_row.ROWS[gen_row_index.NEG_GPR64_F7R3_O64], physical(dest));
    if (sel negated.err) { ret negated; }
    ret two(e, ?gen_row.ROWS[gen_row_index.ADD_GPR64_GPR64_01_O64], physical(dest), physical(a));
}

fun store(e: *Emit, w: *Width, value: rf.Id, base: rf.Id, by: Offset) err[Refusal] {
    if (by.per != 0)       { ret err[Refusal].err{Refusal.scaled{by}}; }
    if (!fits32(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    ret two(e, w.store, at(base, by.fixed), physical(viewed(w.store, 1, value)));
}

fun load(e: *Emit, w: *Width, dest: rf.Id, base: rf.Id, by: Offset) err[Refusal] {
    if (by.per != 0)       { ret err[Refusal].err{Refusal.scaled{by}}; }
    if (!fits32(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    ret two(e, w.load, physical(viewed(w.load, 0, dest)), at(base, by.fixed));
}

# windows x64's page probe: the bytes in eax, the call, then the move
fun probe(e: *Emit, stack: rf.Id, bytes: u64, helper: id.Symbol) err[Refusal] {
    if (bytes > 0x7fff_ffff) { ret err[Refusal].err{Refusal.reach{Offset{fixed: bytes::i64, per: 0, scale: 0}}}; }
    val counted: err[Refusal] = two(e, ?gen_row.ROWS[gen_row_index.MOV_GPR32_IMM32_B8_O32], physical(gen_register.EAX), Operand.immediate{bytes::i64});
    if (sel counted.err) { ret counted; }
    val called: err[Refusal] = one(e, ?gen_row.ROWS[gen_row_index.CALL_NEAR_REL32_E8], Operand.symbol{operand.Symbol{symbol: helper, addend: 0, kind: ?reloc.BRANCH32}});
    if (sel called.err) { ret called; }
    ret two(e, ?gen_row.ROWS[gen_row_index.SUB_GPR64_GPR64_29_O64], physical(stack), physical(gen_register.RAX));
}

val WIDTHS: [7]Width = [7]Width{
    Width{class: ?gen_register.CLASSES[gen_register.GPR64_CLASS], bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOVZX_GPR32_MEM8_0FB6_O32], store: ?gen_row.ROWS[gen_row_index.MOV_MEM8_GPR8_88], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.GPR64_CLASS], bits: quantity.Scaled{fixed: 16, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOVZX_GPR32_MEM16_0FB7_O32], store: ?gen_row.ROWS[gen_row_index.MOV_MEM16_GPR16_89_O16], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.GPR64_CLASS], bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOV_GPR32_MEM32_8B_O32], store: ?gen_row.ROWS[gen_row_index.MOV_MEM32_GPR32_89_O32], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.GPR64_CLASS], bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOV_GPR64_MEM64_8B_O64], store: ?gen_row.ROWS[gen_row_index.MOV_MEM64_GPR64_89_O64], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.XMM_CLASS], bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOVSS_XMM_MEM32_0F10_PF3], store: ?gen_row.ROWS[gen_row_index.MOVSS_MEM32_XMM_0F11_PF3], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.XMM_CLASS], bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOVSD_XMM_XMM_MEM64_0F10_PF2], store: ?gen_row.ROWS[gen_row_index.MOVSD_XMM_MEM64_XMM_0F11_PF2], offset: true},
    Width{class: ?gen_register.CLASSES[gen_register.XMM_CLASS], bits: quantity.Scaled{fixed: 128, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.MOVUPS_XMM_MEM128_0F10], store: ?gen_row.ROWS[gen_row_index.MOVUPS_MEM128_XMM_0F11], offset: true},
};

# x86 has no offset that scales
fun scaled(o: Offset) Steps {
    ret Steps.none{};
}

# the x86-64 frame code
pub val FRAME: Code = Code{add: add, mask: mask, sub: sub, store: store, load: load, widths: Widths{at: ?WIDTHS[0], len: 7}, scaled: scaled, probe: Probes.called{probe}};
