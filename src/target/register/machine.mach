# the machine code for a target may assume: masc's instruction set for its
# architecture, the target's baseline extensions and the ones a build adds
# selected from it once, the registers that selection gives and the calling
# convention resolved through it
#
# the selection is a fact of its own: a target with a baseline and no
# convention has a basis and no machine
#
# a machine is made in place and holds pointers into itself, so it is opened
# where it stays and closed there.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use rf: masc.core.register;

use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Unresolved;
use mirl.target.record.Target;

use mirl.target.basis.Basis;
use mirl.target.basis.Error;
use mirl.target.basis.choose;
use mirl.target.basis.drop;

# a target's machine
# ---
# basis:      the one selection every consumer reads
# registers:  the registers the selection gives
# convention: the convention resolved through those registers
pub rec Machine {
    basis:      Basis;
    registers:  rf.Available;
    convention: Resolved;
}

# what a build holds of its target
# ---
# basis:   the build's selection, none when the target states no baseline
# machine: the whole machine, none when the target states no convention. its
#          basis is the one above
pub rec Build {
    basis:   opt[*Basis];
    machine: opt[*Machine];
}

# a build that holds nothing of its target
pub val BARE: Build = Build{basis: opt[*Basis].none{}, machine: opt[*Machine].none{}};

# what a build holds when it opened a whole machine
pub fun whole(m: *Machine) Build {
    ret Build{basis: opt[*Basis].some{?m.basis}, machine: opt[*Machine].some{m}};
}

# make a target's machine in place with its baseline extensions
# ---
# m:   where it is made, and stays until `close`
# a:   the allocator its storage comes from
# t:   the target
# ret: ok, or why it was not made, leaving nothing to close
pub fun open(m: *Machine, a: *allocator.Allocator, t: *Target) err[Error] {
    ret open_with(m, a, t, Slice[str]{data: nil, size: 0});
}

# make a target's machine in place with its baseline extensions and the ones
# a build adds, the one entry through which a build extends a selection
# ---
# m:     where it is made, and stays until `close`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to close
pub fun open_with(m: *Machine, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val chosen: err[Error] = choose(?m.basis, a, t, added);
    if (sel chosen.err) { ret chosen; }
    val row: res[*Convention, call.Error] = call.of(t);
    if (sel row.err) {
        drop(?m.basis);
        ret err[Error].err{Error.convention{row.err}};
    }
    val viewed: res[rf.Available, rf.Error] = rf.select(a, row.ok.file, ?m.basis.selection);
    if (sel viewed.err) {
        drop(?m.basis);
        ret err[Error].err{Error.registers{viewed.err}};
    }
    m.registers = viewed.ok;
    val resolved: res[Resolved, Unresolved] = convention.resolve(a, row.ok, ?m.registers);
    if (sel resolved.err) {
        rf.release(?m.registers);
        drop(?m.basis);
        ret err[Error].err{Error.unresolved{resolved.err}};
    }
    m.convention = resolved.ok;
    ret err[Error].ok{};
}

# give back a machine's storage
pub fun close(m: *Machine) {
    convention.release(?m.convention);
    rf.release(?m.registers);
    drop(?m.basis);
}

# whether a target states a machine: a baseline to select from and a
# convention row to resolve through its registers
pub fun stated(t: *Target) bool {
    ret sel t.baseline.extensions && sel t.convention.row;
}

# open what a build holds of its target in place: the basis of every target
# that states a baseline, and the whole machine around it when the target
# states a convention too
# ---
# m:     where it is made, and stays until `release`. a target with no
#        convention holds only its basis there
# a:     the allocator its storage comes from
# t:     the target
# added: extension names the build adds to the baseline
# ret:   what the build holds, or why what the target states was not made,
#        leaving nothing to release. a target with no baseline holds nothing,
#        and refuses extensions added with nothing to add them to
pub fun build(m: *Machine, a: *allocator.Allocator, t: *Target, added: Slice[str]) res[Build, Error] {
    if (!(sel t.baseline.extensions) && added.size == 0) { ret res[Build, Error].ok{BARE}; }
    if (!(sel t.convention.row)) {
        val chosen: err[Error] = choose(?m.basis, a, t, added);
        if (sel chosen.err) { ret res[Build, Error].err{chosen.err}; }
        ret res[Build, Error].ok{Build{basis: opt[*Basis].some{?m.basis}, machine: opt[*Machine].none{}}};
    }
    val opened: err[Error] = open_with(m, a, t, added);
    if (sel opened.err) { ret res[Build, Error].err{opened.err}; }
    ret res[Build, Error].ok{whole(m)};
}

# give back what `build` opened
pub fun release(h: Build) {
    if (sel h.machine.some) { close(h.machine.some); }
    or (sel h.basis.some)   { drop(h.basis.some); }
}
