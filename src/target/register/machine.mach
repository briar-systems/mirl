# the build of a register machine: masc's instruction set for its
# architecture, the target's baseline extensions and the ones a build adds
# selected from it once, the registers that selection gives and the calling
# convention resolved through them
#
# the registers are the basis's view, which its context reads, and the
# convention resolved through the context points at it, so the build stays
# put until `close`. the build holds the one format registry of mink a
# compile lends its object writer and round trip. a target that states no convention row is
# refused before anything is selected.

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mink_fail: mink.base.fail;
use mink.format.registry;

use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Unresolved;
use mirl.target.basis.Error;
use mirl.target.basis.choose;
use mirl.target.basis.drop;
use mirl.target.build.Build;
use mirl.target.record.Target;

# open a register machine's build in place
# ---
# b:     where it is made, and stays until `close`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to close: the target
#        states no convention row, its selection or context was refused,
#        mink's format registry was not built or the convention did not
#        resolve through the context
pub fun open(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val row: res[*Convention, call.Error] = call.of(t);
    if (sel row.err) { ret err[Error].err{Error.convention{row.err}}; }
    val chosen: err[Error] = choose(?b.basis, a, t, added);
    if (sel chosen.err) { ret chosen; }
    val formats: res[registry.Registry, mink_fail.Fail] = registry.builtin(a);
    if (sel formats.err) {
        drop(?b.basis);
        ret err[Error].err{Error.formats{formats.err}};
    }
    b.formats = formats.ok;
    val resolved: res[Resolved, Unresolved] = convention.resolve(a, row.ok, ?b.basis.context);
    if (sel resolved.err) {
        registry.release(?b.formats);
        drop(?b.basis);
        ret err[Error].err{Error.unresolved{resolved.err}};
    }
    b.convention = resolved.ok;
    b.state      = nil;
    ret err[Error].ok{};
}

# give back what `open` made
pub fun close(b: *Build) {
    convention.release(?b.convention);
    registry.release(?b.formats);
    drop(?b.basis);
}

# whether a target states what a register machine's build opens: a baseline
# to select from and a convention row to resolve through its registers
pub fun stated(t: *Target) bool {
    ret sel t.baseline.required && sel t.convention.row;
}
