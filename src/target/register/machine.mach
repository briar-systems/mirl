# the build of a register machine: masc's instruction set for its
# architecture, the target's baseline extensions and the ones a build adds
# selected from it once, the registers that selection gives and every calling
# convention row of the target resolved through them
#
# the registers are the basis's view, which its context reads, and the
# convention resolved through the context points at it, so the build stays
# put until `dnit`. the build holds the one format registry of mink a
# compile lends its object writer and round trip. a target that states no convention row is
# refused before anything is selected.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use core_state: masc.core.state;
use mink.format.registry;

use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.Resolved;
use mirl.target.basis;
use mirl.target.basis.Error;
use mirl.target.basis.choose;
use mirl.target.build.Build;
use mirl.target.record.Target;

# open a register machine's build in place
# ---
# b:     where it is made, and stays until `dnit`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to close: the target
#        states no convention rows or one with no register file, its
#        selection or context was refused or a row did not resolve through
#        the context
pub fun init(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val res_rows: res[Conventions, call.Error] = call.conventions(t);
    if (sel res_rows.err) { ret err[Error].err{Error.convention{res_rows.err}}; }
    var set: Conventions = res_rows.ok;
    if (!filed(?set)) { ret err[Error].err{Error.unresolved{convention.Error.file{}}}; }
    val err_chosen: err[Error] = choose(?b.basis, a, t, added);
    if (sel err_chosen.err) { ret err_chosen; }
    b.formats = registry.builtin();
    val res_resolved: res[Slice[Resolved], convention.Error] = convention.resolve_all(a, ?set, opt[*core_state.Context].some{?b.basis.context});
    if (sel res_resolved.err) {
        basis.dnit(?b.basis);
        ret err[Error].err{Error.unresolved{res_resolved.err}};
    }
    b.conventions = res_resolved.ok;
    b.state       = nil;
    ret err[Error].ok{};
}

# whether every row of a set has a register file, as a register machine's do
fun filed(set: *Conventions) bool {
    if (sel set.default.file.none) { ret false; }
    var i: usize = 0;
    for (i < set.rows.size) {
        if (sel set.rows.data[i].file.none) { ret false; }
        i = i + 1;
    }
    ret true;
}

# give back what `init` made
pub fun dnit(b: *Build) {
    convention.rows_dnit(b.conventions);
    basis.dnit(?b.basis);
}

# whether a target states what a register machine's build opens: a baseline
# to select from and convention rows to resolve through its registers
pub fun stated(t: *Target) bool {
    ret sel t.isa.required && sel t.convention.rows;
}
