use mirl.target.abi.convention.Unnamed;
use mirl.target.abi.convention.Value;
use mirl.target.abi.convention.Variadic;
use mirl.target.abi.convention.bank;
use mirl.target.abi.convention.held;
use mirl.target.abi.piece;
use mirl.target.abi.piece.Assignment;
use mirl.target.abi.piece.Copy;
use mirl.target.abi.piece.Passing;
use mirl.target.abi.piece.Piece;
use mirl.target.abi.piece.Refusal;
use mirl.target.abi.view;
use mirl.target.abi.view.Node;
use mirl.target.abi.view.View;
use mirl.target.capability.Bits;

# the registers one placement draws from, and how far it has drawn
# ---
# integers: the integer registers in order
# floats:   the float registers in order
# integer:  the next integer register
# float:    the next float register
# stack:    the next free byte of the stack area
# spill:    whether anything may go on the stack, which no result may
# word:     the bytes of a word
# widest:   the bits of the widest float passed in a float register, 0 for none
# align:    the stack's alignment at a call
# half:     how a 16-bit float travels
# even:     whether an unnamed two-word value starts at an even register
# natural:  whether stack arguments pack at their own size and alignment
rec State {
    integers: Slice[rf.Id];
    floats:   Slice[rf.Id];
    integer:  usize;
    float:    usize;
    stack:    u64;
    spill:    bool;
    word:     u64;
    widest:   u64;
    align:    u64;
    half:     Half;
    even:     bool;
    natural:  bool;
}

# a scalar leaf a structure flattens to
# ---
# node:   its node
# offset: its offset in the flattened value
# float:  whether it takes a float register
rec Leaf {
    node:   u32;
    offset: u64;
    float:  bool;
}

fun state(r: *Resolved, results: bool) State {
    var s: State;
    s.integer = 0;
    s.float   = 0;
    s.stack   = 0;
    s.word    = 0;
    if (sel r.row.word.bits) { s.word = r.row.word.bits::u64 / 8; }
    s.widest = 0;
    if (sel r.row.floats.widest) { s.widest = r.row.floats.widest::u64; }
    s.align = 0;
    if (sel r.row.stack.memory) { s.align = r.row.stack.memory.align; }
    s.half     = r.row.half;
    s.even     = sel r.row.pairs.even;
    s.natural  = sel r.row.packing.natural;
    s.integers = Slice[rf.Id]{data: nil, size: 0};
    s.floats   = s.integers;
    s.spill    = !results;
    val regs: *Registers = held(r);
    if (regs == nil) { ret s; }
    if (results) {
        s.integers = bank(?regs.returning, rf.GENERAL);
        s.floats   = bank(?regs.returning, rf.FLOAT);
    }
    or {
        s.integers = bank(?regs.passing, rf.GENERAL);
        s.floats   = bank(?regs.passing, rf.FLOAT);
    }
    ret s;
}

fun round(v: u64, to: u64) u64 {
    ret (v + to - 1) / to * to;
}

fun laid(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.size; }
    ret 0;
}

fun alignment(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.align; }
    ret 1;
}

# whether a float node travels as a float under the half rule
fun real(s: *State, n: *Node) bool {
    if (!(sel n.shape.float))      { ret false; }
    if (n.shape.float.width == 16) { ret sel s.half.float; }
    ret true;
}

# whether a float node fits a float register
fun fits(s: *State, n: *Node) bool {
    if (sel n.shape.float) { ret real(s, n) && n.shape.float.width::u64 <= s.widest; }
    ret false;
}

fun fill_float(s: *State, n: *Node) Fill {
    if (sel n.shape.float && n.shape.float.width::u64 < s.widest) { ret Fill.boxed{}; }
    ret Fill.exact{};
}

# the fill of a scalar's word in an integer register or a stack slot
fun fill_integer(s: *State, n: *Node, size: u64) Fill {
    if (sel n.shape.integer) {
        val w: u32 = n.shape.integer;
        if (w == 1)                     { ret Fill.zero{1}; }
        if (w < 32)                     { ret Fill.declared{w}; }
        if (w == 32 && s.word * 8 > 32) { ret Fill.sign{32}; }
    }
    if (size >= s.word) { ret Fill.exact{}; }
    ret Fill.undefined{};
}

# the fill of a flattened integer leaf, which no rule extends
fun fill_leaf(s: *State, n: *Node) Fill {
    if (laid(n) >= s.word) { ret Fill.exact{}; }
    ret Fill.undefined{};
}

fun at(place: Place, offset: u64, size: u64, fill: Fill) Piece {
    ret Piece{place: place, offset: offset, size: size, scale: Scale.fixed{}, fill: fill};
}

# a slot on the stack for `size` bytes at `align`, taking it from the state:
# in word slots, or at its own size and alignment where the row packs naturally
fun slot(s: *State, size: u64, align: u64) u64 {
    var to:   u64 = align;
    var used: u64 = size;
    if (!s.natural) {
        if (to < s.word) { to = s.word; }
        used = round(size, s.word);
    }
    if (to > s.align) { to = s.align; }
    val off: u64 = round(s.stack, to);
    s.stack = off + used;
    ret off;
}

# place a value of `size` bytes by the integer rule
fun integer(s: *State, asg: *Assignment, v: *View, at_node: u32, named: bool) err[Refusal] {
    val n:     *Node = view.node(v, at_node);
    val size:  u64   = laid(n);
    val align: u64   = alignment(n);
    if (size <= s.word) {
        val fill: Fill = fill_integer(s, n, size);
        if (s.integer < s.integers.size) {
            s.integer = s.integer + 1;
            ret piece.add(asg, at(Place.register{s.integers.data[s.integer - 1]}, 0, size, fill));
        }
        if (!s.spill) { ret err[Refusal].err{Refusal.room{at_node}}; }
        ret piece.add(asg, at(stacked(slot(s, size, align)), 0, size, fill));
    }
    if (!named && s.even && align == 2 * s.word && s.integer % 2 == 1) { s.integer = s.integer + 1; }
    val high: u64  = size - s.word;
    val fill: Fill = fill_integer(s, n, high);
    if (s.integer + 2 <= s.integers.size) {
        val low: err[Refusal] = piece.add(asg, at(Place.register{s.integers.data[s.integer]}, 0, s.word, Fill.exact{}));
        if (sel low.err) { ret low; }
        s.integer = s.integer + 2;
        ret piece.add(asg, at(Place.register{s.integers.data[s.integer - 1]}, s.word, high, fill));
    }
    if (!s.spill) { ret err[Refusal].err{Refusal.room{at_node}}; }
    if (s.integer + 1 == s.integers.size) {
        val low: err[Refusal] = piece.add(asg, at(Place.register{s.integers.data[s.integer]}, 0, s.word, Fill.exact{}));
        if (sel low.err) { ret low; }
        s.integer = s.integers.size;
        ret piece.add(asg, at(stacked(slot(s, high, s.word)), s.word, high, fill));
    }
    s.integer = s.integers.size;
    val off: u64          = slot(s, size, align);
    val low: err[Refusal] = piece.add(asg, at(stacked(off), 0, s.word, Fill.exact{}));
    if (sel low.err) { ret low; }
    ret piece.add(asg, at(stacked(off + s.word), s.word, high, fill));
}

# the piece the address of a copy travels in, an integer word
fun address(s: *State) Piece {
    if (s.integer < s.integers.size) {
        s.integer = s.integer + 1;
        ret at(Place.register{s.integers.data[s.integer - 1]}, 0, s.word, Fill.exact{});
    }
    ret at(stacked(slot(s, s.word, s.word)), 0, s.word, Fill.exact{});
}

# flatten a node into at most two leaves, false when it cannot be flattened:
# a union, a vector, a handle, a pointer, an integer wider than a word or a
# float that no float register takes. empty structures and arrays add nothing
fun flatten(s: *State, v: *View, at_node: u32, base: u64, out: *Leaf, count: *u32) bool {
    val n: *Node = view.node(v, at_node);
    if (sel n.shape.structure) {
        var k: u32 = 0;
        for (k < n.count) {
            val c: u32 = view.child(v, at_node, k);
            if (!flatten(s, v, c, base + view.node(v, c).offset, out, count)) { ret false; }
            k = k + 1;
        }
        ret true;
    }
    if (sel n.shape.array) {
        if (n.shape.array.count == 0) { ret true; }
        val e:      u32 = view.child(v, at_node, 0);
        var inside: [2]Leaf;
        var leaves: u32 = 0;
        if (!flatten(s, v, e, 0, ?inside[0], ?leaves)) { ret false; }
        if (leaves == 0)                               { ret true; }
        if (n.shape.array.count > 2)                   { ret false; }
        var i: u64 = 0;
        for (i < n.shape.array.count) {
            if (!flatten(s, v, e, base + i * n.shape.array.stride, out, count)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel n.shape.union) { ret laid(n) == 0; }
    var float: bool = false;
    if (sel n.shape.integer) {
        if (laid(n) > s.word) { ret false; }
    }
    or (fits(s, n)) {
        float = true;
    }
    or {
        ret false;
    }
    if (@count == 2) { ret false; }
    out[@count] = Leaf{node: at_node, offset: base, float: float};
    @count      = @count + 1;
    ret true;
}

# place a named structure or array in float registers when it flattens to
# leaves they take and enough are free, true when it was placed
fun flattened(s: *State, asg: *Assignment, v: *View, at_node: u32, out: *bool) err[Refusal] {
    @out = false;
    var leaves: [2]Leaf;
    var count:  u32 = 0;
    if (!flatten(s, v, at_node, 0, ?leaves[0], ?count)) { ret err[Refusal].ok{}; }
    var floats: usize = 0;
    var ints:   usize = 0;
    var i:      u32   = 0;
    for (i < count) {
        if (leaves[i].float) { floats = floats + 1; }
        or                   { ints = ints + 1; }
        i = i + 1;
    }
    if (floats == 0)                        { ret err[Refusal].ok{}; }
    if (s.float + floats > s.floats.size)   { ret err[Refusal].ok{}; }
    if (s.integer + ints > s.integers.size) { ret err[Refusal].ok{}; }
    i = 0;
    for (i < count) {
        val leaf: *Node = view.node(v, leaves[i].node);
        var p:    Piece;
        if (leaves[i].float) {
            p       = at(Place.register{s.floats.data[s.float]}, leaves[i].offset, laid(leaf), fill_float(s, leaf));
            s.float = s.float + 1;
        }
        or {
            p         = at(Place.register{s.integers.data[s.integer]}, leaves[i].offset, laid(leaf), fill_leaf(s, leaf));
            s.integer = s.integer + 1;
        }
        val added: err[Refusal] = piece.add(asg, p);
        if (sel added.err) { ret added; }
        i = i + 1;
    }
    @out = true;
    ret err[Refusal].ok{};
}

# pass a value by reference to a copy, its address taking a word where it may spill
fun copied(s: *State, asg: *Assignment, n: *Node, passing: *Passing) err[Refusal] {
    @passing = Passing.reference{Copy{size: laid(n), align: alignment(n)}};
    if (!s.spill) { ret err[Refusal].ok{}; }
    ret piece.add(asg, address(s));
}

# place one value, as an argument or a result, and say how it travels
fun place(s: *State, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[Refusal] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[Refusal].err{Refusal.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (sel value.by.reference) { ret copied(s, asg, n, passing); }
    if (size == 0)              { ret err[Refusal].ok{}; }
    if (value.named && fits(s, n) && s.float < s.floats.size) {
        s.float = s.float + 1;
        ret piece.add(asg, at(Place.register{s.floats.data[s.float - 1]}, 0, size, fill_float(s, n)));
    }
    if (value.named && (sel n.shape.structure || sel n.shape.array)) {
        var done: bool         = false;
        val flat: err[Refusal] = flattened(s, asg, v, value.node, ?done);
        if (sel flat.err) { ret flat; }
        if (done)         { ret flat; }
    }
    if (size > 2 * s.word) { ret copied(s, asg, n, passing); }
    ret integer(s, asg, v, value.node, value.named);
}

# the result classifier of every risc-v row
fun results(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    if (call.results.size > 1) { ret err[Refusal].err{Refusal.results{call.results.size::u32}}; }
    var s: State = state(r, true);
    var i: usize = 0;
    for (i < call.results.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = place(?s, asg, call.view, call.results.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, true, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    ret err[Refusal].ok{};
}

# the argument classifier of every risc-v row
fun arguments(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    var s: State = state(r, false);
    var i: usize = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) { asg.address = opt[Piece].some{address(?s)}; }
        i = i + 1;
    }
    i = 0;
    for (i < call.arguments.size) {
        val first:   u32          = piece.open(asg);
        var passing: Passing;
        val placed:  err[Refusal] = place(?s, asg, call.view, call.arguments.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[Refusal] = piece.close(asg, false, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    asg.stack = s.stack;
    ret err[Refusal].ok{};
}

# the tail rule of every risc-v row: nothing on the stack and no result by
# reference
fun tail(r: *Resolved, asg: *Assignment) bool {
    ret asg.stack == 0 && sel asg.address.none;
}

val CLASSIFIERS: Classifiers = Classifiers{results: results, arguments: arguments};

# the integer argument registers, then the float ones, which a soft float row
# leaves off
val PASSING: [16]rf.Id = [16]rf.Id{
    gen.X10, gen.X11, gen.X12, gen.X13, gen.X14, gen.X15, gen.X16, gen.X17,
    gen.F10, gen.F11, gen.F12, gen.F13, gen.F14, gen.F15, gen.F16, gen.F17,
};

val RETURNING: [4]rf.Id = [4]rf.Id{gen.X10, gen.X11, gen.F10, gen.F11};

# the stack pointer and the saved registers, each kept whole, then the saved
# float registers, of which a callee keeps flen bits: 32 under the single
# rows and 64 under the double ones. a soft float row leaves them off
val SINGLE_PRESERVED: [25]Kept = [25]Kept{
    Kept{register: gen.X2, bits: Part.whole{}}, Kept{register: gen.X8, bits: Part.whole{}}, Kept{register: gen.X9, bits: Part.whole{}},
    Kept{register: gen.X18, bits: Part.whole{}}, Kept{register: gen.X19, bits: Part.whole{}}, Kept{register: gen.X20, bits: Part.whole{}},
    Kept{register: gen.X21, bits: Part.whole{}}, Kept{register: gen.X22, bits: Part.whole{}}, Kept{register: gen.X23, bits: Part.whole{}},
    Kept{register: gen.X24, bits: Part.whole{}}, Kept{register: gen.X25, bits: Part.whole{}}, Kept{register: gen.X26, bits: Part.whole{}},
    Kept{register: gen.X27, bits: Part.whole{}},
    Kept{register: gen.F8, bits: Part.low{32}}, Kept{register: gen.F9, bits: Part.low{32}}, Kept{register: gen.F18, bits: Part.low{32}},
    Kept{register: gen.F19, bits: Part.low{32}}, Kept{register: gen.F20, bits: Part.low{32}}, Kept{register: gen.F21, bits: Part.low{32}},
    Kept{register: gen.F22, bits: Part.low{32}}, Kept{register: gen.F23, bits: Part.low{32}}, Kept{register: gen.F24, bits: Part.low{32}},
    Kept{register: gen.F25, bits: Part.low{32}}, Kept{register: gen.F26, bits: Part.low{32}}, Kept{register: gen.F27, bits: Part.low{32}},
};
val DOUBLE_PRESERVED: [25]Kept = [25]Kept{
    Kept{register: gen.X2, bits: Part.whole{}}, Kept{register: gen.X8, bits: Part.whole{}}, Kept{register: gen.X9, bits: Part.whole{}},
    Kept{register: gen.X18, bits: Part.whole{}}, Kept{register: gen.X19, bits: Part.whole{}}, Kept{register: gen.X20, bits: Part.whole{}},
    Kept{register: gen.X21, bits: Part.whole{}}, Kept{register: gen.X22, bits: Part.whole{}}, Kept{register: gen.X23, bits: Part.whole{}},
    Kept{register: gen.X24, bits: Part.whole{}}, Kept{register: gen.X25, bits: Part.whole{}}, Kept{register: gen.X26, bits: Part.whole{}},
    Kept{register: gen.X27, bits: Part.whole{}},
    Kept{register: gen.F8, bits: Part.low{64}}, Kept{register: gen.F9, bits: Part.low{64}}, Kept{register: gen.F18, bits: Part.low{64}},
    Kept{register: gen.F19, bits: Part.low{64}}, Kept{register: gen.F20, bits: Part.low{64}}, Kept{register: gen.F21, bits: Part.low{64}},
    Kept{register: gen.F22, bits: Part.low{64}}, Kept{register: gen.F23, bits: Part.low{64}}, Kept{register: gen.F24, bits: Part.low{64}},
    Kept{register: gen.F25, bits: Part.low{64}}, Kept{register: gen.F26, bits: Part.low{64}}, Kept{register: gen.F27, bits: Part.low{64}},
};

# the global and thread pointers, which no code a call reaches may change, and
# the float control and status register, whose rounding mode and accrued flags
# have thread storage duration, so a call neither saves nor clobbers them. a
# soft float row uses no float register and leaves the last three off, so it
# resolves on a selection with no float registers
val RESERVED: [5]rf.Id = [5]rf.Id{gen.X3, gen.X4, gen.FFLAGS, gen.FRM, gen.FCSR};

val SOFT_PASSING:   Slice[rf.Id] = Slice[rf.Id]{data: ?PASSING[0], size: 8};
val SOFT_RETURNING: Slice[rf.Id] = Slice[rf.Id]{data: ?RETURNING[0], size: 2};
val SOFT_PRESERVED: Slice[Kept]  = Slice[Kept]{data: ?DOUBLE_PRESERVED[0], size: 13};
val SOFT_RESERVED:  Slice[rf.Id] = Slice[rf.Id]{data: ?RESERVED[0], size: 2};
val HARD_PASSING:   Slice[rf.Id] = Slice[rf.Id]{data: ?PASSING[0], size: 16};
val HARD_RETURNING: Slice[rf.Id] = Slice[rf.Id]{data: ?RETURNING[0], size: 4};
val SINGLE_KEPT:    Slice[Kept]  = Slice[Kept]{data: ?SINGLE_PRESERVED[0], size: 25};
val DOUBLE_KEPT:    Slice[Kept]  = Slice[Kept]{data: ?DOUBLE_PRESERVED[0], size: 25};
val HARD_RESERVED:  Slice[rf.Id] = Slice[rf.Id]{data: ?RESERVED[0], size: 5};

# s0 points at the canonical frame address, with the return address one word
# below it and the caller's frame pointer one word below that. the stack
# pointer lives in sp
val FRAME_64: Stack = Stack.memory{Frame{align: 16, red: 0, shadow: 0, link: Link.register{gen.X1}, pointer: Pointer.register{Keeper{register: gen.X8, record: Record.linked{Linked{pointer: 0, previous: -16, link: -8}}, always: false}}, pointer_home: Home.register{gen.X2}}};
val FRAME_32: Stack = Stack.memory{Frame{align: 16, red: 0, shadow: 0, link: Link.register{gen.X1}, pointer: Pointer.register{Keeper{register: gen.X8, record: Record.linked{Linked{pointer: 0, previous: -8, link: -4}}, always: false}}, pointer_home: Home.register{gen.X2}}};

val INDIRECT: Indirect = Indirect{carrier: Carrier.first{}, returned: Returned.none{}};
val VARIADIC: Variadic = Variadic{unnamed: Unnamed.integer{}, count: Count.none{}, list: List.pointer{}};

# lp64, rv64 with every float in integer registers
pub val LP64: Convention = Convention{
    name:        "lp64",
    abi:         Abi.named{"lp64"},
    file:        opt[*rf.File].some{?gen.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.none{},
    passing:     SOFT_PASSING,
    returning:   SOFT_RETURNING,
    preserved:   SOFT_PRESERVED,
    reserved:    SOFT_RESERVED,
    stack:       FRAME_64,
    indirect:    INDIRECT,
    variadic:    VARIADIC,
    half:        Half.float{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
};

# the e base's argument and saved registers, which x16 to x31 it lacks leave
# out, and its frame, whose stack lp64e aligns to eight bytes
#[testing]
val E_PASSING:   [6]rf.Id = [6]rf.Id{gen.X10, gen.X11, gen.X12, gen.X13, gen.X14, gen.X15};
#[testing]
val E_PRESERVED: [3]Kept  = [3]Kept{Kept{register: gen.X2, bits: Part.whole{}}, Kept{register: gen.X8, bits: Part.whole{}}, Kept{register: gen.X9, bits: Part.whole{}}};
#[testing]
val E_FRAME_64:  Stack    = Stack.memory{Frame{align: 8, red: 0, shadow: 0, link: Link.register{gen.X1}, pointer: Pointer.register{Keeper{register: gen.X8, record: Record.linked{Linked{pointer: 0, previous: -16, link: -8}}, always: false}}, pointer_home: Home.register{gen.X2}}};

# lp64e, rv64e with every float in integer registers, a row for the tests of
# the e base and no target's. like ilp32e it starts an unnamed two-word value
# at any register, not an even one
#[testing]
pub val LP64E: Convention = Convention{
    name:        "lp64e",
    abi:         Abi.named{"lp64e"},
    file:        opt[*rf.File].some{?gen.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.none{},
    passing:     Slice[rf.Id]{data: ?E_PASSING[0], size: 6},
    returning:   SOFT_RETURNING,
    preserved:   Slice[Kept]{data: ?E_PRESERVED[0], size: 3},
    reserved:    SOFT_RESERVED,
    stack:       E_FRAME_64,
    indirect:    INDIRECT,
    variadic:    VARIADIC,
    half:        Half.float{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        tail,
};

# lp64f, rv64 with single precision floats in float registers
pub val LP64F: Convention = Convention{
    name:        "lp64f",
    abi:         Abi.named{"lp64f"},
    file:        opt[*rf.File].some{?gen.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{32},
    passing:     HARD_PASSING,
    returning:   HARD_RETURNING,
    preserved:   SINGLE_KEPT,
    reserved:    HARD_RESERVED,
    stack:       FRAME_64,
    indirect:    INDIRECT,
    variadic:    VARIADIC,
    half:        Half.float{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
};

