# the extensions the holds' conditions name, each a requirement of its own: a
# build meets one where its context holds the extension
val HOLD_ATOMS:        [6]requirement.Id          = [6]requirement.Id{riscv_extension.F, riscv_extension.ZFINX, riscv_extension.D, riscv_extension.ZDINX, riscv_extension.ZHINX, riscv_extension.V};
val HOLD_ALTERNATIVES: [6]requirement.Alternative = [6]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[1], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[2], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[3], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[4], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?HOLD_ATOMS[5], len: 1}, none: requirement.NO_IDS},
};
val UNDER_F:     Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[0], len: 1}};
val UNDER_ZFINX: Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[1], len: 1}};
val UNDER_D:     Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[2], len: 1}};
val UNDER_ZDINX: Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[3], len: 1}};
val UNDER_ZHINX: Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[4], len: 1}};
val UNDER_V:     Condition = Condition.requires{requirement.Requirement{at: ?HOLD_ALTERNATIVES[5], len: 1}};

# integers and pointers live in the general registers on every build. a float
# lives in the float registers where the f registers exist, under f, d for
# binary64, and zfh or zfhmin, which imply f, for binary16. under zfinx,
# zdinx and zhinx, which conflict with f, it lives in the general registers,
# a binary64 of rv32 in an even pair of them (Zdinx, unprivileged spec
# chapter "Zfinx"). the catalog's conflicts keep each format's two rows apart.
# vectors, which a build reaches only under v, live in the vector registers
val HOLDS: [9]Hold = [9]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{gen_register.X}, requires: Condition.always{}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{gen_register.X}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY16}, holder: Holder.hardware{gen_register.F}, requires: UNDER_F},
    Hold{class: Class.format{format.BINARY16}, holder: Holder.hardware{gen_register.X}, requires: UNDER_ZHINX},
    Hold{class: Class.format{format.BINARY32}, holder: Holder.hardware{gen_register.F}, requires: UNDER_F},
    Hold{class: Class.format{format.BINARY32}, holder: Holder.hardware{gen_register.X}, requires: UNDER_ZFINX},
    Hold{class: Class.format{format.BINARY64}, holder: Holder.hardware{gen_register.F}, requires: UNDER_D},
    Hold{class: Class.format{format.BINARY64}, holder: Holder.hardware{gen_register.X}, requires: UNDER_ZDINX},
    Hold{class: Class.vector{}, holder: Holder.hardware{gen_register.V}, requires: UNDER_V},
};

