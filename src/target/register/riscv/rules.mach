# the table for RV32 and RV64, one table for both widths
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: $length_of(RULES)},
    constants: Rules{at: ?CONSTANTS[0], len: $length_of(CONSTANTS)},
    holds:     Holds{at: ?HOLDS[0], len: $length_of(HOLDS)},
    jump:      Emits{at: ?E_JUMP[0], len: $length_of(E_JUMP)},
    offsets:   Rules{at: ?OFFSETS[0], len: $length_of(OFFSETS)},
};
