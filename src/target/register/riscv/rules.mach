# the RVWMO mapping of the ir's orderings, from the RISC-V unprivileged
# spec's memory model appendix, Table A.6, "Mappings from C/C++ primitives to
# RISC-V primitives": the aq (2) and rl (1) bits an amo takes, and those of
# the load reserved and of the store conditional of a loop. an access that
# states two orderings, as a compare and exchange does, takes their join
val AMO:      Forms = Forms{relaxed: 0, acquire: 2, release: 1, acq_rel: 3, seq_cst: 3};
val RESERVED: Forms = Forms{relaxed: 0, acquire: 2, release: 0, acq_rel: 2, seq_cst: 3};
val STORED:   Forms = Forms{relaxed: 0, acquire: 0, release: 1, acq_rel: 1, seq_cst: 1};

# the orderings a rule of a load, a store or a fence is chosen for, each form
# of the same table: a load is plain when relaxed, followed by fence r,rw when
# acquire, and between fence rw,rw and fence r,rw when seq_cst. a store is
# plain when relaxed and after fence rw,w when release or seq_cst. a fence is
# fence r,rw, fence rw,w, fence.tso and fence rw,rw for acquire, release,
# acq_rel and seq_cst. each width's atomic load is one list, its seq_cst
# form, of which the acquire form is the tail and the relaxed form the load
# alone, and its atomic store one list, of which the relaxed form is the store
val RELAXED:   ir.Orderings = ir.Orderings{relaxed: true, acquire: false, release: false, acq_rel: false, seq_cst: false};
val ACQUIRE:   ir.Orderings = ir.Orderings{relaxed: false, acquire: true, release: false, acq_rel: false, seq_cst: false};
val RELEASE:   ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: true, acq_rel: false, seq_cst: false};
val ACQ_REL:   ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: false, acq_rel: true, seq_cst: false};
val SEQ_CST:   ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: false, acq_rel: false, seq_cst: true};
val RELEASING: ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: true, acq_rel: false, seq_cst: true};

