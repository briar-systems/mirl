# integers and pointers live in the general registers, floats in the float registers
val HOLDS: [3]Hold = [3]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{riscv_register.X}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{riscv_register.X}},
    Hold{class: Class.float{}, holder: Holder.hardware{riscv_register.F}},
};

val S_JUMP: [2]Source = [2]Source{Source.fixed{gen_register.X0}, Source.target{0}};
val E_JUMP: [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{gen_row.JAL}, operands: Sources{at: ?S_JUMP[0], len: 2}, implied: NO_IMPLIED}};

# the table for RV32 and RV64, one table for both widths
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: 468},
    constants: Rules{at: ?CONSTANTS[0], len: 25},
    holds:     Holds{at: ?HOLDS[0], len: 3},
    jump:      Emits{at: ?E_JUMP[0], len: 1},
};
