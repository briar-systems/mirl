#[testing]
val MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\nfunction @g: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# the extensions a test adds on top of the baseline of its target
#[testing]
val NONE: Slice[str] = Slice[str]{data: nil, size: 0};

#[testing]
val VECTOR_NAMES: [1]str = [1]str{"v"};

#[testing]
val VECTOR: Slice[str] = Slice[str]{data: ?VECTOR_NAMES[0], size: 1};

# a test's module, selection, view, convention and locations
#[testing]
rec Fixture {
    a:    allocator.Allocator;
    m:    Module;
    base: Basis;
    row:  Convention;
    r:    Resolved;
    at:   Locations;
}

# open a fixture over the module's target with `added` on top of its baseline,
# its convention row changed by `change` when it is not nil
#[testing]
fun open(x: *Fixture, added: Slice[str], change: fun(*Convention)) bool {
    ret open_on(x, MODULE, added, change);
}

# open a fixture over the target of module text `module_text` with `added`
# on top of its baseline, its convention row changed by `change` when it is
# not nil
#[testing]
fun open_on(x: *Fixture, module_text: str, added: Slice[str], change: fun(*Convention)) bool {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, view_of(module_text));
    if (sel made.err) { ret false; }
    x.m = made.ok;
    val tg: opt[*Target] = targets.row_named(x.m.a, x.m.target);
    if (sel tg.none) { ret false; }
    val row: res[*Convention, call.Error] = call.of(tg.some);
    if (sel row.err) { ret false; }
    x.row = @row.ok;
    if (change != nil) { change(?x.row); }
    val chosen: err[basis.Error] = basis.choose(?x.base, ?x.a, tg.some, added);
    if (sel chosen.err) { ret false; }
    val resolved: res[Resolved, Unresolved] = convention.resolve(?x.a, ?x.row, opt[*core_state.Context].some{?x.base.context});
    if (sel resolved.err) { ret false; }
    x.r = resolved.ok;
    if (!(sel x.row.file.some)) { ret false; }
    val got: res[Locations, location.Error] = location.init(?x.a, x.row.file.some, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret false; }
    x.at = got.ok;
    ret true;
}

#[testing]
fun close(x: *Fixture) {
    location.dnit(?x.at);
    convention.release(?x.r);
    basis.drop(?x.base);
    module.dnit(?x.m);
}

#[testing]
fun read(x: *Fixture, text: str) opt[reader.Unit] {
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, ?register_isa.ISAS, view_of(text));
    if (sel read.err) { ret opt[reader.Unit].none{}; }
    ret opt[reader.Unit].some{read.ok};
}

# print a function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, f: Function) {
    var items: [1]item.Item;
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print(?out, m, ?register_isa.ISAS, Slice[item.Item]{data: ?items[0], size: 1});
}

#[testing]
fun request(x: *Fixture) Request {
    ret Request{convention: ?x.r, at: ?x.at};
}

# frame the allocated @f of a text and compare it with the expected text
# ---
# x:    the fixture
# text: the machine text of @f, every operand a location
# want: the expected text of the framed @f
# out:  the framed function, kept for further checks
# ret:  0, or the step that failed
#[testing]
fun frames(x: *Fixture, text: str, want: str, out: *Framed) i32 {
    val input: opt[reader.Unit] = read(x, text);
    if (sel input.none) { ret 1; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val expected: opt[reader.Unit] = read(x, want);
    if (sel expected.none) { ret 2; }
    var w: reader.Unit = expected.some;
    fin { reader.dnit(?w); }
    val f:    *Function            = ?u.items.data[0].function;
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, f, Slice[u32]{data: nil, size: 0}, request(x));
    if (sel laid.err) { ret 3; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val bound: res[code.Admitted, code.Error] = code.admit(?x.a, ?FRAME, ?x.base.context);
    if (sel bound.err) { ret 4; }
    var admitted: code.Admitted = bound.ok;
    fin { code.dnit(?admitted); }
    val done: res[Framed, finish.Error] = finish.finish(?x.a, f, ?p, ?admitted);
    if (sel done.err) { ret 4; }
    @out = done.ok;
    val same: res[bool, printer.Error] = equal.same_function(?x.m, ?out.function, ?x.m, ?w.items.data[0].function);
    if (sel same.err) { ret 5; }
    if (!same.ok) {
        show(?x.m, out.function);
        ret 6;
    }
    ret 0;
}

#[testing]
fun named(x: *Fixture, name: str) rf.Id {
    val found: res[rf.Id, rf.Absent] = rf.lookup(?x.base.view, view_of(name));
    if (sel found.err) { ret rf.NONE; }
    ret found.ok;
}

#[testing]
fun fixed_at(p: Place) opt[i64] {
    if (sel p.dropped)        { ret opt[i64].none{}; }
    if (p.at.offset.per != 0) { ret opt[i64].none{}; }
    ret opt[i64].some{p.at.offset.fixed};
}

# a call with a local slot, an outgoing stack argument and a saved register:
# the return address and s1 are saved, the outgoing area is at the stack
# pointer, and the frame is a multiple of sixteen bytes so the call sees the
# stack pointer aligned
#[testing]
val CALLS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 24 align 8\n    slot [1]: size 8 align 8 outgoing 8\n^0:\n    addi x9, x0, 1\n    pseudo address x10, [0]\n    pseudo spill [1], x11\n    jal x1, @g : jal20\n    jalr x0, x1, 0\n}\n";

#[testing]
val CALLS_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 24 align 8\n    slot [1]: size 8 align 8 outgoing 8\n    slot [2]: size 8 align 8\n    slot [3]: size 8 align 8\n^0:\n    addi x2, x2, -64\n    sd x2, x1, 56\n    sd x2, x9, 48\n    addi x9, x0, 1\n    addi x10, x2, 16\n    sd x2, x11, 8\n    jal x1, @g : jal20\n    ld x9, x2, 48\n    ld x1, x2, 56\n    addi x2, x2, 64\n    jalr x0, x1, 0\n}\n";

# two vector values live at once over one vector register: one is spilled to
# a slot whose size follows the vector length, laid out in the scaled area
#[testing]
val SCALED: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n^0:\n    pseudo copy %0, v8\n    pseudo copy %1, v9\n    pseudo copy v10, %1\n    pseudo copy v11, %0\n    jalr x0, x1, 0\n}\n";

test frame__keeps_the_declared_stack_alignment_at_every_call {
    var x: Fixture;
    if (!open(?x, NONE, nil)) { ret 1; }
    fin { close(?x); }
    var out:  Framed;
    val same: i32 = frames(?x, CALLS, CALLS_OUT, ?out);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?out); }
    val st: Stack = x.row.stack;
    if (!(sel st.memory)) { ret 2; }
    val align: u64 = st.memory.align;
    if (out.layout.size.per != 0 || out.layout.size.fixed::u64 % align != 0 || out.layout.outgoing != 16) { ret 2; }

    # a scaled spill slot keeps the alignment at every multiplier
    var v: Fixture;
    if (!open(?v, VECTOR, nil)) { ret 3; }
    fin { close(?v); }
    val input: opt[reader.Unit] = read(?v, SCALED);
    if (sel input.none) { ret 4; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    var one:  [1]Physical                     = [1]Physical{Physical.register{named(?v, "v2")}};
    val done: res[Allocation, allocate.Error] = allocate.allocate(?v.a, ?u.items.data[0].function, allocate.Request{at: ?v.at, context: ?v.base.context, allowed: Slice[Physical]{data: ?one[0], size: 1}, clobbers: Slice[Clobber]{data: nil, size: 0}});
    if (sel done.err) { ret 5; }
    var al: Allocation = done.ok;
    fin { allocate.release(?al); }
    if (al.spills.len != 1) { ret 6; }
    val spilled: function.SlotData = al.function.slots.data[al.spills.data[0].index];
    if (spilled.per == 0 || spilled.size != 0) { ret 7; }
    val laid: res[Plan, lay.Error] = lay.lay(?v.a, ?al.function, Slice[u32]{data: al.used.data, size: al.used.len}, request(?v));
    if (sel laid.err) { ret 8; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val size: Offset = p.layout.size;
    if (size.per == 0 || size.per::u64 % align != 0 || size.fixed::u64 % align != 0 || size.scale != spilled.scale) { ret 9; }
    val at: Place = p.layout.slots.data[al.spills.data[0].index];
    if (sel at.dropped)                                                      { ret 10; }
    if (at.at.offset.per == 0 || at.at.offset.per::u64 % spilled.align != 0) { ret 10; }
    # the frame's scaled part is measured through vlenb, and an offset of the
    # integer registers' scale, which a selection fixes, is formed by none
    val steps: code.Steps = FRAME.scaled(size);
    if (!(sel steps.measured)) { ret 11; }
    val fixed: code.Steps = FRAME.scaled(Offset{fixed: 0, per: 8, scale: 0});
    if (!(sel fixed.none)) { ret 12; }
    ret 0;
}

#[testing]
fun red_zone(c: *Convention) {
    val st: Stack = c.stack;
    if (!(sel st.memory)) { ret; }
    val f: Frame = st.memory;
    c.stack = Stack.memory{Frame{align: f.align, red: 64, shadow: 0, link: f.link, pointer: f.pointer, pointer_home: f.pointer_home, prologue: f.prologue}};
}

#[testing]
fun shadow_space(c: *Convention) {
    val st: Stack = c.stack;
    if (!(sel st.memory)) { ret; }
    val f: Frame = st.memory;
    c.stack = Stack.memory{Frame{align: f.align, red: 0, shadow: 32, link: f.link, pointer: f.pointer, pointer_home: f.pointer_home, prologue: f.prologue}};
}

# a leaf in the red zone moves no stack pointer, its save and slot below it
#[testing]
val LEAF: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n^0:\n    addi x9, x0, 1\n    pseudo address x10, [0]\n    jalr x0, x1, 0\n}\n";

#[testing]
val LEAF_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    sd x2, x9, -8\n    addi x9, x0, 1\n    addi x10, x2, -32\n    ld x9, x2, -8\n    jalr x0, x1, 0\n}\n";

# a call under a row with shadow space reserves it at the stack pointer
#[testing]
val CALL: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    jal x1, @g : jal20\n    jalr x0, x1, 0\n}\n";

#[testing]
val CALL_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n^0:\n    addi x2, x2, -48\n    sd x2, x1, 40\n    jal x1, @g : jal20\n    ld x1, x2, 40\n    addi x2, x2, 48\n    jalr x0, x1, 0\n}\n";

test frame__uses_the_red_zone_and_shadow_space_as_the_row_declares {
    var red: Fixture;
    if (!open(?red, NONE, red_zone)) { ret 1; }
    fin { close(?red); }
    var leaf: Framed;
    val same: i32 = frames(?red, LEAF, LEAF_OUT, ?leaf);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?leaf); }
    if (leaf.layout.red != 32 || leaf.layout.size.fixed != 0) { ret 2; }
    # without a red zone the same leaf moves its stack pointer
    var none: Fixture;
    if (!open(?none, NONE, nil)) { ret 3; }
    fin { close(?none); }
    val input: opt[reader.Unit] = read(?none, LEAF);
    if (sel input.none) { ret 4; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val laid: res[Plan, lay.Error] = lay.lay(?none.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, request(?none));
    if (sel laid.err) { ret 5; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    if (p.layout.red != 0 || p.layout.size.fixed != 32) { ret 6; }

    var shadow: Fixture;
    if (!open(?shadow, NONE, shadow_space)) { ret 7; }
    fin { close(?shadow); }
    var called: Framed;
    val again:  i32 = frames(?shadow, CALL, CALL_OUT, ?called);
    if (again != 0) { ret 20 + again; }
    fin { record.release(?called); }
    if (called.layout.outgoing != 32) { ret 8; }
    ret 0;
}

# a call that saves the return address and s1
#[testing]
val SAVES: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    addi x9, x0, 1\n    jal x1, @g : jal20\n    jalr x0, x1, 0\n}\n";

#[testing]
val SAVES_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    addi x2, x2, -16\n    sd x2, x1, 8\n    sd x2, x9, 0\n    addi x9, x0, 1\n    jal x1, @g : jal20\n    ld x9, x2, 0\n    ld x1, x2, 8\n    addi x2, x2, 16\n    jalr x0, x1, 0\n}\n";

# the dwarf numbers of the risc-v psabi, x0 to x31 numbered 0 to 31
#[testing]
val DWARF_RA: u16 = 1;
#[testing]
val DWARF_SP: u16 = 2;
#[testing]
val DWARF_S1: u16 = 9;

#[testing]
fun is_cfa(f: Fact, at: u32, after: bool, reg: u16, offset: i64) bool {
    val r: frame.Rule = f.rule;
    ret f.at.index == at && f.after == after && (sel r.def_cfa && (r.def_cfa.reg == reg && r.def_cfa.offset == offset));
}

#[testing]
fun is_saved(f: Fact, at: u32, reg: u16, offset: i64) bool {
    val r: frame.Rule = f.rule;
    ret f.at.index == at && f.after && (sel r.offset && (r.offset.reg == reg && r.offset.offset == offset));
}

#[testing]
fun is_restored(f: Fact, at: u32, reg: u16) bool {
    val r: frame.Rule = f.rule;
    ret f.at.index == at && f.after && (sel r.restore && r.restore == reg);
}

#[testing]
fun dwarf(x: *Fixture, reg: rf.Id) u16 {
    val n: opt[u32] = core_state.debug_number(x.base.view.file, reg, rf.DWARF, ?x.base.context);
    if (sel n.none) { ret 0xffff; }
    ret n.some::u16;
}

test frame__the_cfi_describes_every_saved_register_at_its_slot {
    var x: Fixture;
    if (!open(?x, NONE, nil)) { ret 1; }
    fin { close(?x); }
    var out:  Framed;
    val same: i32 = frames(?x, SAVES, SAVES_OUT, ?out);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?out); }
    if (out.layout.saves.len != 2) { ret 2; }
    # every save is at its slot: the canonical frame address is the stack
    # pointer plus the frame's size, so each slot's offset from the stack
    # pointer less that size is the offset its rule states
    var k: usize = 0;
    for (k < out.layout.saves.len) {
        val s:  Save     = out.layout.saves.data[k];
        val at: opt[i64] = fixed_at(out.layout.slots.data[s.slot.index]);
        if (sel at.none)                                       { ret 3; }
        if (at.some - out.layout.size.fixed != s.offset.fixed) { ret 3; }
        var found: bool  = false;
        var n:     usize = 0;
        for (n < out.facts.len) {
            val r: frame.Rule = out.facts.data[n].rule;
            if (sel r.offset && (r.offset.reg == dwarf(?x, s.register) && r.offset.offset == s.offset.fixed)) { found = true; }
            n = n + 1;
        }
        if (!found) { ret 4; }
        k = k + 1;
    }
    # the prologue and the epilogue, rule by rule, as mink's frame records
    # with the registers by their psabi dwarf numbers
    if (out.facts.len != 8) { ret 5; }
    val f:        *Fact      = out.facts.data;
    val remember: frame.Rule = f[3].rule;
    val restore:  frame.Rule = f[7].rule;
    if (!is_cfa(f[0], 0, true, DWARF_SP, 16))                                  { ret 6; }
    if (!is_saved(f[1], 1, DWARF_RA, -8) || !is_saved(f[2], 2, DWARF_S1, -16)) { ret 7; }
    if (f[3].at.index != 5 || f[3].after || !(sel remember.remember))          { ret 8; }
    if (!is_restored(f[4], 5, DWARF_S1) || !is_restored(f[5], 6, DWARF_RA))    { ret 9; }
    if (!is_cfa(f[6], 7, true, DWARF_SP, 0))                                   { ret 10; }
    if (f[7].at.index != 8 || !f[7].after || !(sel restore.restore_state))     { ret 11; }
    ret 0;
}

# a dynamic allocation moves the stack pointer below the frame, which keeps
# its frame pointer and its frame record, and its slot from the frame pointer
#[testing]
val DYNAMIC: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n^0:\n    pseudo dynamic x10, x11\n    pseudo address x12, [0]\n    jalr x0, x1, 0\n}\n";

#[testing]
val DYNAMIC_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n    slot [2]: size 8 align 8\n^0:\n    addi x2, x2, -32\n    sd x2, x8, 16\n    sd x2, x1, 24\n    addi x8, x2, 32\n    addi x10, x11, 15\n    andi x10, x10, -16\n    sub x2, x2, x10\n    addi x10, x2, 0\n    addi x12, x8, -32\n    addi x2, x8, -16\n    ld x1, x2, 8\n    ld x8, x2, 0\n    addi x2, x2, 16\n    jalr x0, x1, 0\n}\n";

test frame__a_dynamic_allocation_keeps_the_frame_addressable {
    var x: Fixture;
    if (!open(?x, NONE, nil)) { ret 1; }
    fin { close(?x); }
    var out:  Framed;
    val same: i32 = frames(?x, DYNAMIC, DYNAMIC_OUT, ?out);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?out); }
    if (out.layout.pointer != named(?x, "s0")) { ret 2; }
    # every slot of the frame is addressed from the frame pointer
    var k: usize = 0;
    for (k < out.layout.slots.len) {
        val p: Place = out.layout.slots.data[k];
        if (sel p.dropped)          { ret 3; }
        if (!(sel p.at.base.frame)) { ret 4; }
        k = k + 1;
    }
    ret 0;
}

#[testing]
val ZACAS_NAMES: [1]str = [1]str{"zacas"};

#[testing]
val RV32_MODULE: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# amocas.d on rv32 writes the even pair x18 and x19, s2 and s3, both of which
# ilp32d preserves, so both are saved and restored though its operand names
# only x18: two 4 byte slots in a frame rounded up to ilp32d's 16 byte stack
# alignment with no red zone, saved from the top in register order and
# restored in reverse
#[testing]
val PAIR: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n^0:\n    amocas.d.rv32 x18, x10, x14, 0\n    jalr x0, x1, 0\n}\n";

#[testing]
val PAIR_OUT: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n    slot [0]: size 4 align 4\n    slot [1]: size 4 align 4\n^0:\n    addi x2, x2, -16\n    sw x2, x18, 12\n    sw x2, x19, 8\n    amocas.d.rv32 x18, x10, x14, 0\n    lw x19, x2, 8\n    lw x18, x2, 12\n    addi x2, x2, 16\n    jalr x0, x1, 0\n}\n";

test frame__a_written_register_pair_saves_both_its_registers {
    var x: Fixture;
    if (!open_on(?x, RV32_MODULE, Slice[str]{data: ?ZACAS_NAMES[0], size: 1}, nil)) { ret 1; }
    fin { close(?x); }
    var out:  Framed;
    val same: i32 = frames(?x, PAIR, PAIR_OUT, ?out);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?out); }
    ret 0;
}

# a row's prologue changed to `p`
#[testing]
fun shaped(c: *Convention, p: Prologue) {
    val st: Stack = c.stack;
    if (!(sel st.memory)) { ret; }
    var f: Frame = st.memory;
    f.prologue = p;
    c.stack    = Stack.memory{f};
}

#[testing]
fun page_of(c: *Convention, bytes: u64) {
    shaped(c, Prologue{probe: Probe.page{Page{bytes: bytes, helper: opt[str].none{}}}, pair_saves: false, unwind: Unwind.dwarf{}});
}

#[testing]
fun pages_of_32(c: *Convention) {
    page_of(c, 32);
}

#[testing]
fun pages_of_64(c: *Convention) {
    page_of(c, 64);
}

#[testing]
fun paired(c: *Convention) {
    shaped(c, Prologue{probe: Probe.none{}, pair_saves: true, unwind: Unwind.dwarf{}});
}

#[testing]
fun unwound_by_seh(c: *Convention) {
    shaped(c, Prologue{probe: Probe.none{}, pair_saves: false, unwind: Unwind.seh{}});
}

#[testing]
fun never_unwound(c: *Convention) {
    shaped(c, Prologue{probe: Probe.none{}, pair_saves: false, unwind: Unwind.none{}});
}

# why the frame of `text` was not laid out under the fixture's row, none
# when it was or the text was not read
#[testing]
fun lay_refused(x: *Fixture, text: str) opt[lay.Error] {
    val input: opt[reader.Unit] = read(x, text);
    if (sel input.none) { ret opt[lay.Error].none{}; }
    var u: reader.Unit = input.some;
    fin { reader.dnit(?u); }
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, request(x));
    if (sel laid.err) { ret opt[lay.Error].some{laid.err}; }
    var p: Plan = laid.ok;
    lay.release(?p);
    ret opt[lay.Error].none{};
}

# a row's prologue shape: CALLS moves its stack pointer by 64 bytes, which a
# row probing every 32 bytes refuses until the frame writes probes and one
# probing every 64 frames as it would unprobed. SAVES saves ra and s1, which
# a row saving in pairs or unwound by seh refuses until the frame keeps those
# shapes, and a row no unwinder walks frames with no call frame rule
test frame__keeps_the_prologue_shape_the_row_states {
    var small: Fixture;
    if (!open(?small, NONE, pages_of_32)) { ret 1; }
    fin { close(?small); }
    val probed: opt[lay.Error] = lay_refused(?small, CALLS);
    if (!(sel probed.some && sel probed.some.probe)) { ret 2; }
    var page: Fixture;
    if (!open(?page, NONE, pages_of_64)) { ret 3; }
    fin { close(?page); }
    var within: Framed;
    val same:   i32 = frames(?page, CALLS, CALLS_OUT, ?within);
    if (same != 0) { ret 10 + same; }
    fin { record.release(?within); }

    var pairs: Fixture;
    if (!open(?pairs, NONE, paired)) { ret 4; }
    fin { close(?pairs); }
    val unpaired: opt[lay.Error] = lay_refused(?pairs, SAVES);
    if (!(sel unpaired.some && sel unpaired.some.pairs)) { ret 5; }
    var seh: Fixture;
    if (!open(?seh, NONE, unwound_by_seh)) { ret 6; }
    fin { close(?seh); }
    val coded: opt[lay.Error] = lay_refused(?seh, SAVES);
    if (!(sel coded.some && sel coded.some.unwind)) { ret 7; }

    var bare: Fixture;
    if (!open(?bare, NONE, never_unwound)) { ret 8; }
    fin { close(?bare); }
    var out:   Framed;
    val again: i32 = frames(?bare, SAVES, SAVES_OUT, ?out);
    if (again != 0) { ret 20 + again; }
    fin { record.release(?out); }
    if (out.facts.len != 0) { ret 9; }
    ret 0;
}
