#[testing]
val MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\nfunction @g: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# f calls g, g returns
#[testing]
val CALLS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    jal x1, @g : jal20\n}\nfunction @g {\n^0:\n    jalr x0, x1, 0\n}\n";

# f takes the address of g with a pc-relative pair, calls it, and branches over nothing
#[testing]
val PAIRS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    auipc x10, @g : pcrel_hi20 label 7\n    addi x10, x10, partner 7 : pcrel_lo12_i\n    auipc x1, @g : call_plt_pair\n    jalr x1, x1, 0\n    beq x10, x0, ^1\n^1:\n    jalr x0, x1, 0\n}\n";

# a global the code takes the address of, and one zero filled
#[testing]
val DATA: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nglobal @counter: i32 linkage global visibility default = i32 7\nglobal @zeroed: array<16, i32> linkage local visibility default = array<16, i32> zero\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# an array whose elements are 2 bytes at a stated stride of 4
#[testing]
val STRIDED: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nglobal @strided: array<2, i16, stride 4> linkage local visibility default = array<2, i16, stride 4> {i16 1, i16 -2}\n";

# f takes the address of counter with a pc-relative pair
#[testing]
val ADDRESS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    auipc x10, @counter : pcrel_hi20 label 1\n    addi x10, x10, partner 1 : pcrel_lo12_i\n    jalr x0, x1, 0\n}\n";

#[testing]
val FILL: [2]u8 = [2]u8{0xAB, 0xAB};

# a test's allocator, module, target and its machine
#[testing]
pub rec Fixture {
    a:    allocator.Allocator;
    m:    Module;
    t:    Target;
    mach: Build;
}

# open a fixture over the module's target, changed by `change` when it is not nil
#[testing]
pub fun open(x: *Fixture, change: fun(*Target)) bool {
    ret open_over(x, MODULE, change);
}

# open a fixture over a module's text and its target, changed by `change` when it is not nil
#[testing]
pub fun open_over(x: *Fixture, text: str, change: fun(*Target)) bool {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, view_of(text));
    if (sel made.err) { ret false; }
    x.m = made.ok;
    val row: opt[*Target] = targets.row_named(x.m.a, x.m.target);
    if (sel row.none) { ret false; }
    x.t = @row.some;
    if (change != nil) { change(?x.t); }
    val opened: err[basis.Error] = machine.open(?x.mach, ?x.a, ?x.t, Slice[str]{data: nil, size: 0});
    ret sel opened.ok;
}

#[testing]
pub fun close(x: *Fixture) {
    machine.close(?x.mach);
    module.dnit(?x.m);
}

# the target changed to align functions to eight bytes and pad code with 0xAB
#[testing]
fun padded(t: *Target) {
    t.caps.code.function = Align.bytes{8};
    t.caps.code.fill     = Fill.pattern{Slice[u8]{data: ?FILL[0], size: 2}};
}

# the register named
#[testing]
fun named(x: *Fixture, name: str) rf.Id {
    val found: res[rf.Id, rf.Absent] = rf.lookup(build_record.registers(?x.mach).context.view, view_of(name));
    if (sel found.err) { ret rf.NONE; }
    ret found.ok;
}

# lay out each function of a text and emit them
#[testing]
pub fun object_of(x: *Fixture, u: *reader.Unit, out: *object.Object) i32 {
    var laid:  [2]Laid;
    var units: [2]Unit;
    var n:     usize = 0;
    for (n < u.items.len) {
        val made: res[Laid, lay.Error] = lay.lay(?x.a, ?u.items.data[n].function);
        if (sel made.err) { ret 1; }
        laid[n] = made.ok;
        val s: id.Symbol = u.items.data[n].symbol;
        if (!(sel s.function)) { ret 2; }
        units[n] = Unit{function: s.function, code: ?u.items.data[n].function, laid: ?laid[n]};
        n        = n + 1;
    }
    val done: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: ?units[0], size: u.items.len}, opt[*vector.Vector[u8]].none{});
    n = 0;
    for (n < u.items.len) {
        lay.release(?laid[n]);
        n = n + 1;
    }
    if (sel done.err) { ret 3; }
    @out = done.ok;
    ret 0;
}

# function alignment, the section's alignment and the pad between functions are the target's declaration, and no function's size counts the pad
test emit__function_alignment_and_code_fill_follow_the_target {
    var x: Fixture;
    if (!open(?x, padded)) { ret 1; }
    fin { close(?x); }
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, view_of(CALLS));
    if (sel read.err) { ret 2; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var o:    object.Object;
    val made: i32 = object_of(?x, ?u, ?o);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?o); }
    # f is one four byte jump, g starts at the next eight and the gap is the target's fill
    if (placed_at(?o, "g") != 8) { ret 3; }
    # neither size counts the gap, by hand from the encodings: f is jal x1, 4, which has no compressed form
    # on rv64, and g is jalr x0, x1, 0, compressed to c.jr, 2. neither depends on masc#234, as jal x1
    # stays four bytes and c.jr names no symbol
    if (size_of(?o, "f") != 4) { ret 14; }
    if (size_of(?o, "g") != 2) { ret 15; }
    val text: *object.Section = text_of(?o);
    if (text.align != 16) { ret 5; }
    val bytes: store.Bytes = object.bytes(?o, ?text.contents);
    if (bytes.len < 8) { ret 6; }
    var i: usize = 4;
    for (i < 8) {
        if (bytes.data[i] != 0xAB) { ret 7; }
        i = i + 1;
    }
    # the object states the float ABI its convention does
    val abi: opt[*trait.Trait] = trait.find(?o.traits, ?arch_riscv.RISCV_FLOAT_ABI);
    if (sel abi.none)                                        { ret 11; }
    if (!(sel abi.some.setting.choice))                      { ret 12; }
    if (abi.some.setting.choice != ?arch_riscv.RISCV_DOUBLE) { ret 13; }
    # the target's own declaration, unchanged, aligns to two bytes and pads with zeros
    var plain: Fixture;
    if (!open(?plain, nil)) { ret 8; }
    fin { close(?plain); }
    val again: res[reader.Unit, reader.Refusal] = reader.parse_body(?plain.a, ?plain.m, view_of(CALLS));
    if (sel again.err) { ret 9; }
    var v: reader.Unit = again.ok;
    fin { reader.dnit(?v); }
    var p:      object.Object;
    val second: i32 = object_of(?plain, ?v, ?p);
    if (second != 0) { ret 20 + second; }
    fin { object.release(?p); }
    if (placed_at(?p, "g") != 4) { ret 21; }
    ret 0;
}

# an append of a row with its operands, to a block of a function built in memory
#[testing]
fun append(f: *Function, b: Block, row: *rows.Row, operands: Slice[Operand], label: u32) bool {
    var md:   Metadata;
    val made: res[Instruction, function.Error] = function.append(f, b, Opcode.row{row}, operands, md, false, vstate.NONE);
    if (sel made.err) { ret false; }
    function.label(f, made.ok, label);
    ret true;
}

#[testing]
fun reg(x: *Fixture, name: str) Operand {
    ret Operand.physical{Physical.register{named(x, name)}};
}

# the function of PAIRS built in memory
#[testing]
fun pairs(x: *Fixture, f: *Function) bool {
    val g: id.Symbol                  = id.Symbol.function{id.Function{index: 1}};
    val a: res[Block, function.Error] = function.block(f);
    val z: res[Block, function.Error] = function.block(f);
    if (sel a.err) { ret false; }
    if (sel z.err) { ret false; }
    var hi: [2]Operand = [2]Operand{reg(x, "x10"), Operand.symbol{Symbol{symbol: g, addend: 0, kind: ?kinds.PCREL_HI20}}};
    var lo: [3]Operand = [3]Operand{reg(x, "x10"), reg(x, "x10"), Operand.partner{Partner{label: 7, kind: ?kinds.PCREL_LO12_I}}};
    var up: [2]Operand = [2]Operand{reg(x, "x1"), Operand.symbol{Symbol{symbol: g, addend: 0, kind: ?kinds.CALL_PLT_PAIR}}};
    var jr: [3]Operand = [3]Operand{reg(x, "x1"), reg(x, "x1"), Operand.immediate{0}};
    var br: [3]Operand = [3]Operand{reg(x, "x10"), reg(x, "x0"), Operand.block{z.ok}};
    var rt: [3]Operand = [3]Operand{reg(x, "x0"), reg(x, "x1"), Operand.immediate{0}};
    if (!append(f, a.ok, gen_row.AUIPC, Slice[Operand]{data: ?hi[0], size: 2}, 7))                    { ret false; }
    if (!append(f, a.ok, gen_row.ADDI, Slice[Operand]{data: ?lo[0], size: 3}, instruction.NO_LABEL))  { ret false; }
    if (!append(f, a.ok, gen_row.AUIPC, Slice[Operand]{data: ?up[0], size: 2}, instruction.NO_LABEL)) { ret false; }
    if (!append(f, a.ok, gen_row.JALR, Slice[Operand]{data: ?jr[0], size: 3}, instruction.NO_LABEL))  { ret false; }
    if (!append(f, a.ok, gen_row.BEQ, Slice[Operand]{data: ?br[0], size: 3}, instruction.NO_LABEL))   { ret false; }
    ret append(f, z.ok, gen_row.JALR, Slice[Operand]{data: ?rt[0], size: 3}, instruction.NO_LABEL);
}

# the same function handed over from memory and from its text is the same object
test emit__a_function_in_memory_and_as_text_gives_one_object {
    var x: Fixture;
    if (!open(?x, nil)) { ret 1; }
    fin { close(?x); }
    var f: Function = function.init(?x.a, x.mach.basis.set);
    fin { function.dnit(?f); }
    if (!pairs(?x, ?f)) { ret 2; }
    var laid: res[Laid, lay.Error] = lay.lay(?x.a, ?f);
    if (sel laid.err) { ret 3; }
    var l: Laid = laid.ok;
    fin { lay.release(?l); }
    var one:    [1]Unit                            = [1]Unit{Unit{function: id.Function{index: 0}, code: ?f, laid: ?l}};
    val direct: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: ?one[0], size: 1}, opt[*vector.Vector[u8]].none{});
    if (sel direct.err) { ret 4; }
    var a: object.Object = direct.ok;
    fin { object.release(?a); }
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, view_of(PAIRS));
    if (sel read.err) { ret 5; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var b:    object.Object;
    val made: i32 = object_of(?x, ?u, ?b);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?b); }
    if (!same_object(?a, ?b)) { ret 6; }
    # the high part and its low part, the call and the marker its span states
    if (a.relocs.count != 4)                                                                          { ret 7; }
    if (a.relocs.items[0].kind != ?kinds.PCREL_HI20 || a.relocs.items[1].kind != ?kinds.PCREL_LO12_I) { ret 8; }
    if (a.relocs.items[2].kind != ?kinds.CALL_PLT_PAIR || a.relocs.items[3].kind != ?kinds.RELAX)     { ret 9; }
    # the low part names the instruction its partner operand labels, the high part
    val named: object.Target = a.relocs.items[1].target;
    if (!(sel named.symbol)) { ret 11; }
    val lo: *object.Symbol = object.symbol_at(?a, named.symbol);
    if (placed_in(lo) != a.relocs.items[0].offset::i64) { ret 10; }
    ret 0;
}

# the address of a global is the pc-relative pair against its symbol, which is its data
test emit__the_address_of_a_global_is_the_sets_pair_against_its_data {
    var x: Fixture;
    if (!open_over(?x, DATA, nil)) { ret 1; }
    fin { close(?x); }
    val read: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, view_of(ADDRESS));
    if (sel read.err) { ret 2; }
    var u: reader.Unit = read.ok;
    fin { reader.dnit(?u); }
    var o:    object.Object;
    val made: i32 = object_of(?x, ?u, ?o);
    if (made != 0) { ret 10 + made; }
    fin { object.release(?o); }
    if (o.relocs.count != 2)                                                                          { ret 3; }
    if (o.relocs.items[0].kind != ?kinds.PCREL_HI20 || o.relocs.items[1].kind != ?kinds.PCREL_LO12_I) { ret 4; }
    # the high part names counter, the low part the high part
    val high: object.Target = o.relocs.items[0].target;
    if (!(sel high.symbol)) { ret 5; }
    val counter: opt[*object.Symbol] = symbol_named(?o, "counter");
    if (sel counter.none)                                  { ret 6; }
    if (object.symbol_at(?o, high.symbol) != counter.some) { ret 7; }
    if (counter.some.kind != ?symbol.DATA)                 { ret 8; }
    val size: opt[u64] = counter.some.size;
    if (sel size.none)  { ret 9; }
    if (size.some != 4) { ret 19; }
    val low: object.Target = o.relocs.items[1].target;
    if (!(sel low.symbol))                                                            { ret 20; }
    if (placed_in(object.symbol_at(?o, low.symbol)) != o.relocs.items[0].offset::i64) { ret 21; }
    # counter's four bytes, little endian, in data at its alignment
    val data: opt[*object.Section] = section_of(?o, "counter");
    if (sel data.none)                                        { ret 22; }
    if (data.some.kind != ?section.DATA)                      { ret 23; }
    if (data.some.align < 4 || placed_at(?o, "counter") != 0) { ret 24; }
    val bytes: store.Bytes = object.bytes(?o, ?data.some.contents);
    if (bytes.len != 4)                                                                       { ret 25; }
    if (bytes.data[0] != 7 || bytes.data[1] != 0 || bytes.data[2] != 0 || bytes.data[3] != 0) { ret 26; }
    ret 0;
}

# a global whose initial value is every bit zero is zero fill in bss, with no bytes
test emit__a_zero_initialised_global_is_bss_with_no_bytes {
    var x: Fixture;
    if (!open_over(?x, DATA, nil)) { ret 1; }
    fin { close(?x); }
    val done: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: nil, size: 0}, opt[*vector.Vector[u8]].none{});
    if (sel done.err) { ret 2; }
    var o: object.Object = done.ok;
    fin { object.release(?o); }
    val bss: opt[*object.Section] = section_of(?o, "zeroed");
    if (sel bss.none)                  { ret 3; }
    if (bss.some.kind != ?section.BSS) { ret 4; }
    val fill: object.Contents = bss.some.contents;
    if (!(sel fill.zero))   { ret 5; }
    if (fill.zero != 64)    { ret 6; }
    if (bss.some.align < 4) { ret 7; }
    val zeroed: opt[*object.Symbol] = symbol_named(?o, "zeroed");
    if (sel zeroed.none)              { ret 8; }
    if (placed_at(?o, "zeroed") != 0) { ret 9; }
    val size: opt[u64] = zeroed.some.size;
    if (sel size.none)   { ret 10; }
    if (size.some != 64) { ret 11; }
    ret 0;
}

# an array at a stated stride has each element at it, little endian, with the
# bytes between them zero, and is the stride times its count long
test emit__an_array_at_a_stated_stride_keeps_its_elements_there {
    var x: Fixture;
    if (!open_over(?x, STRIDED, nil)) { ret 1; }
    fin { close(?x); }
    val done: res[object.Object, handover.Error] = handover.emit(?x.a, ?x.m, ?x.mach, ?x.t, Slice[Unit]{data: nil, size: 0}, opt[*vector.Vector[u8]].none{});
    if (sel done.err) { ret 2; }
    var o: object.Object = done.ok;
    fin { object.release(?o); }
    if (size_of(?o, "strided") != 8) { ret 3; }
    val data: opt[*object.Section] = section_of(?o, "strided");
    if (sel data.none) { ret 4; }
    val at: i64 = placed_at(?o, "strided");
    if (at < 0) { ret 5; }
    val bytes: store.Bytes = object.bytes(?o, ?data.some.contents);
    if (bytes.len < at::usize + 8) { ret 6; }
    val want: [8]u8 = [8]u8{1, 0, 0, 0, 0xfe, 0xff, 0, 0};
    var i:    usize = 0;
    for (i < 8) {
        if (bytes.data[at::usize + i] != want[i]) { ret 7; }
        i = i + 1;
    }
    ret 0;
}
