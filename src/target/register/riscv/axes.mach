# the address space of every risc-v row, its pointer the width the
# architecture's row states
val POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.architecture{}, layout: Rules.c{}},
};

# riscv64 under the lp64d psabi
val RV64_ALU: [2]u32 = [2]u32{32, 64};
# and, or, xor and the unsigned compares on a condition held as 0 or 1, whose
# result is 0 or 1 again
val RISCV_BITS:    [4]Bitwise = [4]Bitwise{Bitwise.both{}, Bitwise.either{}, Bitwise.differ{}, Bitwise.compare{}};
val RV64_INTEGERS: [4]u32     = [4]u32{8, 16, 32, 64};
# the M extension's mulhu, mulh and mulhsu
val RV64_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 64},
};
# the extensions the risc-v rows' conditions name, each a requirement of its
# own: a build meets one where its context holds the extension
val CONDITION_ATOMS:        [9]requirement.Id          = [9]requirement.Id{riscv_extension.F, riscv_extension.ZFINX, riscv_extension.D, riscv_extension.ZFA, riscv_extension.ZMMUL, riscv_extension.M, riscv_extension.V, riscv_extension.ZDINX, riscv_extension.XLEN_64};
val CONDITION_ALTERNATIVES: [9]requirement.Alternative = [9]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[1], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[2], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[3], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[4], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[5], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[6], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[7], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[8], len: 1}, none: requirement.NO_IDS},
};
val UNDER_F:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[0], len: 1}};
val UNDER_ZFINX: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[1], len: 1}};
val UNDER_D:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[2], len: 1}};
val UNDER_ZFA:   Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[3], len: 1}};
val UNDER_ZMMUL: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[4], len: 1}};
val UNDER_M:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[5], len: 1}};
val UNDER_V:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[6], len: 1}};
val UNDER_ZDINX: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[7], len: 1}};
val UNDER_RV64:  Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[8], len: 1}};

# fmin and fmax of F and D give the other operand for one nan and order
# negative zero below positive zero. zfa adds fminm, fmaxm and fround. no
# instruction selects between floats or gives a remainder
val RISCV_NATIVES: [8]Native = [8]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FMIN, condition: UNDER_ZFA},
    Native{opcode: ir.FMAX, condition: UNDER_ZFA},
    Native{opcode: ir.FFLOOR, condition: UNDER_ZFA},
    Native{opcode: ir.FCEIL, condition: UNDER_ZFA},
    Native{opcode: ir.FINT, condition: UNDER_ZFA},
    Native{opcode: ir.FNEAREST, condition: UNDER_ZFA},
};
# binary32 under the F extension or under Zfinx, which computes it in the
# general registers and which the catalog states F conflicts with, and
# binary64 under D or under Zdinx, which computes it in one general register,
# each held where the build selects it, whose results are the canonical nan.
# zfa needs F, so no build meets its natives under Zfinx or Zdinx. a constant
# is made in a general register, and moved where F holds it
val RV64_HELD: [4]Held = [4]Held{
    Held{format: ?BINARY32, condition: UNDER_F, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNDER_ZFINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_D, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_ZDINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
};
# a format a build holds no row of is widened through binary32 or binary64
# where the build holds one that admits it, whose canonical nan narrows to the
# canonical one, and computed by the soft helpers otherwise, which give the
# canonical nan for every nan result, conversions included, matching the
# hardware's rule
val RISCV_LOWERED: [3]Lowered = [3]Lowered{
    Lowered{format: ?BINARY16, widened: Narrowing.kept{}, helpers: Helpers.rule{Nans.canonical{}}},
    Lowered{format: ?BINARY32, widened: Narrowing.kept{}, helpers: Helpers.rule{Nans.canonical{}}},
    Lowered{format: ?BINARY64, widened: Narrowing.kept{}, helpers: Helpers.rule{Nans.canonical{}}},
};
# the v extension's lanes, its elements of 8 to 64 bits and the binary32 and
# binary64 of the zve64d it implies (rvv 1.0, section 18.3 "v: vector
# extension for application processors"), each packed in its registers
val RISCV_VECTOR_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# the operations the rvv rules (mirl.target.register.riscv.lanes) select over
# packed lanes: integer sums, differences, products, the bitwise operations,
# negation and complement at every width, binary32 and binary64 arithmetic,
# square root, negation, absolute value, fused multiply-add, minnum and maxnum,
# the widening of a lane to any wider width and the narrowing to any narrower
# one, a splat, an extract and an insert of every lane type, the sum, and, or,
# exclusive or, minimum and maximum of integer lanes, and the reassociable and
# sequential sum and the minnum and maxnum of float lanes. a splat, an extract,
# an insert and a reduction of 64 bit integers move a lane through a general
# register, so they are packed on rv64 alone. every other operation is taken
# lane by lane: a build and a shuffle, which rvv makes only from a vector of
# indices no rule builds, a product, ieee minimum or maximum reduction, which
# rvv has no instruction for, and the comparisons and selects, since the unit
# holds no mask yet
val RISCV_OPERATIONS: [128]Operation = [128]Operation{
    Operation{opcode: ir.ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FNEG, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FNEG, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FABS, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FABS, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMA, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMA, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMINNUM, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMINNUM, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMAXNUM, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMAXNUM, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{8}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{8}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{16}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{16}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{16}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{16}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_S, lane: LaneType.integer{32}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.EXT_U, lane: LaneType.integer{32}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{16}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{32}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{32}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{64}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{64}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.TRUNC, lane: LaneType.integer{64}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.VEXTRACT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
