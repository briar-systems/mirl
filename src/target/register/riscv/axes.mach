pub val RV64IMAC:      requirement.Requirement    = requirement.Requirement{at: ?RV64IMAC_ALL[0], len: 1};
#[testing]
val     RV64EMC_ATOMS: [4]requirement.Id          = [4]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_E, riscv_extension.M, riscv_extension.C};
#[testing]
val     RV64EMC_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV64EMC_ATOMS[0], len: 4}, none: requirement.NO_IDS}};
# rv64emc
#[testing]
pub val RV64EMC:     requirement.Requirement    = requirement.Requirement{at: ?RV64EMC_ALL[0], len: 1};
#[testing]
val     RV64I_ATOMS: [3]requirement.Id          = [3]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_I, riscv_extension.I};
#[testing]
val     RV64I_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV64I_ATOMS[0], len: 3}, none: requirement.NO_IDS}};
# rv64i, the base integer set alone
#[testing]
pub val RV64I:        requirement.Requirement    = requirement.Requirement{at: ?RV64I_ALL[0], len: 1};
#[testing]
val     RV32GC_ATOMS: [10]requirement.Id         = [10]requirement.Id{riscv_extension.XLEN_32, riscv_extension.BASE_I, riscv_extension.I, riscv_extension.M, riscv_extension.A, riscv_extension.F, riscv_extension.D, riscv_extension.ZICSR, riscv_extension.ZIFENCEI, riscv_extension.C};
#[testing]
val     RV32GC_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV32GC_ATOMS[0], len: 10}, none: requirement.NO_IDS}};
