# the riscv32 widths, arithmetic and code every float abi shares
val RV32_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?POINTERS[0], size: 1},
    slots:    SlotSpace.space{0},
    models:   Models.none{},
    register: Bits.bits{32},
    alu:      Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    integers: Set.widths{Slice[u32]{data: ?RV32_INTEGERS[0], size: 3}},
};
val RV32_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    multiplied: UNDER_ZMMUL,
    products:   Products.forms{Slice[Product]{data: ?RV32_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    division:   Division{widths: Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}}, condition: UNDER_M, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV32_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV32_FILL[0], size: 2}},
};

# riscv32, which computes in binary32 where the build selects the F extension
# or Zfinx and in binary64 where it selects D, and in software where it does
# not
val RV32_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{RISCV_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         RV32_WIDTHS,
    vectors:        Vectors.units{Slice[Unit]{data: ?RISCV_UNITS[0], size: 1}},
    formats:        Formats.held{Slice[Held]{data: ?RV32_HELD[0], size: 3}},
    arithmetic:     RV32_ARITHMETIC,
    bulk:           BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    code:           RV32_CODE,
    attributes:     Attributes.schema{?SCHEMA},
    ops:            Ops.none{},
};

# the ilp32 data of the psabi, the same under every float abi
val RV32_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV32_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV32_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?RISCV_VECTOR_REGISTERS[0], size: 1}}},
};

# the risc-v machines, each the capabilities of one architecture. an e base
# architecture computes as its xlen does
val MACHINES: [4]axis.Machine = [4]axis.Machine{
    axis.Machine{arch: ?riscv.RISCV64, caps: RV64_CAPS},
    axis.Machine{arch: ?riscv.RISCV64E, caps: RV64_CAPS},
    axis.Machine{arch: ?riscv.RISCV32, caps: RV32_CAPS},
    axis.Machine{arch: ?riscv.RISCV32E, caps: RV32_CAPS},
};

# the risc-v conventions, by mink's psabi names, each with the data layout of
# its architecture under it: lp64 under every lp64 abi and ilp32 under every
# ilp32 one. lp64e and ilp32e are rows of the e architectures alone, whose
# selections hold x0 to x15
val MEMBERS: [8]axis.Member = [8]axis.Member{
    axis.Member{arch: ?riscv.RISCV64, name: "lp64", row: opt[*Convention].some{?LP64}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV64, name: "lp64f", row: opt[*Convention].some{?LP64F}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV64, name: "lp64d", row: opt[*Convention].some{?LP64D}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV64E, name: "lp64e", row: opt[*Convention].some{?LP64E}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32", row: opt[*Convention].some{?ILP32}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32f", row: opt[*Convention].some{?ILP32F}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32d", row: opt[*Convention].some{?ILP32D}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32E, name: "ilp32e", row: opt[*Convention].some{?ILP32E}, data: RV32_DATA},
};

# risc-v linux at either xlen. no other system carries a model yet
val MODELS: [2]axis.Model = [2]axis.Model{
    axis.Model{arch: ?riscv.RISCV64, system: ?LINUX, addresses: Addresses.model{RISCV_LINUX_ADDRESSES}},
    axis.Model{arch: ?riscv.RISCV32, system: ?LINUX, addresses: Addresses.model{RISCV_LINUX_ADDRESSES}},
};

# the risc-v rows of every axis
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 4},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 8},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 2},
};
