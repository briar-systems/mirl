    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMIN, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_SMAX, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMIN, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_UMAX, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: UNDER_RV64},
    Operation{opcode: ir.REDUCE_FADD_ANY, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_ANY, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_SEQ, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FADD_SEQ, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMINNUM, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMINNUM, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMAXNUM, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_FMAXNUM, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
};
# the v extension's registers, masc's v class, vlen wide, so a fixed-length
# vector splits to the least vlen the build's zvl extensions allow, one rule
# setting the vector length to the vector's lanes, so any count is held. it
# holds no mask in a register yet, so a vector of conditions is taken lane by
# lane
val RISCV_UNITS: [1]Unit = [1]Unit{
    Unit{requires: UNDER_V, width: Width.scaled{Scaled{class: riscv_register.V, length: Length.least{}}}, counts: Counts.any{}, lanes: Slice[Lane]{data: ?RISCV_VECTOR_LANES[0], size: 6}, operations: Operations.rows{Slice[Operation]{data: ?RISCV_OPERATIONS[0], size: 128}}, masks: Masks.none{}},
};
# c.unimp, so padding traps
val RV64_FILL: [2]u8 = [2]u8{0, 0};
# the lp64 widths of the risc-v psabi's current riscv-cc.adoc, which v1.0
# predates for _BitInt ("c/c++ type sizes and alignments"): bool and the
# integers to long at their size, __int128 at 16, and above 128 bits a
# _BitInt(N), in 16 byte chunks aligned to 16
val RV64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 16}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 16}}},
};
val RV64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# riscv32 under the ilp32d psabi
val RV32_ALU:      [1]u32     = [1]u32{32};
val RV32_INTEGERS: [3]u32     = [3]u32{8, 16, 32};
val RV32_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 32},
};
# binary32 under the F extension or under Zfinx, and binary64 under D or under
# Zdinx, which computes it in an even pair of general registers, each held
# where the build selects it, whose results are the canonical nan. a general
# register holds a binary32 constant's bits, and a binary64 one is loaded
# from read-only data
val RV32_HELD: [3]Held = [3]Held{
    Held{format: ?BINARY32, condition: UNDER_F, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNDER_ZFINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_D, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.loaded{}},
};
# c.unimp, so padding traps
val RV32_FILL: [2]u8 = [2]u8{0, 0};
# the ilp32 widths of the risc-v psabi's current riscv-cc.adoc ("c/c++ type
# sizes and alignments"): bool and the integers to long long at their size,
# and above 64 bits a _BitInt(N), in 8 byte chunks aligned to 8
val RV32_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 8}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 8}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 8}}},
};
val RV32_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# risc-v linux code is position independent at either xlen, and a variable of
# a module loaded at any time is reached as one of any module, since the
# psabi's local dynamic sequence saves only a lookup the general one makes
val RISCV_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    span:       Span.bits{31},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
        index:           "",
    },
};

# the thread-local accesses of a freestanding image, which holds every
# thread-local variable itself, so each is at a link-time offset from tp,
# which the psabi's integer convention names the thread pointer under every
# system
val RISCV_FREESTANDING_THREADS: Threads = Threads{
    general_dynamic: Access.local_exec{},
    local_dynamic:   Access.local_exec{},
    initial_exec:    Access.local_exec{},
    local_exec:      Access.local_exec{},
    lookup:          "",
    index:           "",
};

# a freestanding image is linked at its address. by default code reaches a
# symbol under the psabi's medlow code model (riscv-elf.adoc, "code models"),
# its absolute address formed by lui and addi through R_RISCV_HI20 and
# R_RISCV_LO12_I, which at xlen 32 reaches the whole address space and at
# xlen 64 the 2 GiB about address zero
val RISCV_MEDLOW_ADDRESSES: Model = Model{
    relocation: Relocation.static{},
    span:       Span.bits{31},
    threads:    RISCV_FREESTANDING_THREADS,
};

# the psabi's medany code model, which an image linked anywhere in the
# address space takes, as at the 0x80000000 qemu's virt machine and opensbi
# put ram at: code reaches a symbol by its distance, formed by auipc and addi
# through R_RISCV_PCREL_HI20 and R_RISCV_PCREL_LO12_I, within 2 GiB of the
# code, and the image is never moved, so a constant holding an address is
# read-only data as under medlow
val RISCV_MEDANY_ADDRESSES: Model = Model{
    relocation: Relocation.near{},
    span:       Span.bits{31},
    threads:    RISCV_FREESTANDING_THREADS,
};

# the code models riscv64 freestanding offers a build, medlow its default.
# at xlen 32 medlow reaches every address, so riscv32 offers none to pick
val RV64_FREESTANDING_CODES: [2]address.Code = [2]address.Code{
    address.Code{name: "medlow", model: RISCV_MEDLOW_ADDRESSES},
    address.Code{name: "medany", model: RISCV_MEDANY_ADDRESSES},
};

# the riscv64 widths, arithmetic and code every float abi shares
val RV64_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?POINTERS[0], size: 1},
    slots:    SlotSpace.space{0},
    models:   Models.none{},
    register: Bits.bits{64},
    alu:      Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    integers: Set.widths{Slice[u32]{data: ?RV64_INTEGERS[0], size: 4}},
};
val RV64_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    multiplied: UNDER_ZMMUL,
    products:   Products.forms{Slice[Product]{data: ?RV64_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    # the M extension's div and rem give all ones and the dividend for a zero
    # divisor, and the dividend for an overflowing quotient
    division: Division{widths: Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}}, condition: UNDER_M, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV64_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV64_FILL[0], size: 2}},
};

# a switch of four cases or more whose cases fill two fifths of their span
# branches through a table, which costs a bounds check, a load and an
# indirect jump where a chain costs a compare and branch per case
val RISCV_DENSITY: Density = Density{least: 4, fill: 40};

# Zacas's amocas.d at rv32 and amocas.q at rv64, which compare and swap an
# even pair of x registers
val ZACAS_ATOMS:        [1]requirement.Id          = [1]requirement.Id{riscv_extension.ZACAS};
val ZACAS_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?ZACAS_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val RISCV_PAIRED:       Atomics                    = Atomics{paired: Paired.native{Swap{condition: Condition.requires{requirement.Requirement{at: ?ZACAS_ALTERNATIVES[0], len: 1}}, refusal: "a compare and exchange of two words on a build without Zacas, whose amocas compares and swaps a pair of registers"}}};

# riscv64, which computes in binary32 where the build selects the F extension
# or Zfinx and in binary64 where it selects D, and in software where it does
# not
val RV64_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{RISCV_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         RV64_WIDTHS,
    vectors:        Vectors.units{Slice[Unit]{data: ?RISCV_UNITS[0], size: 1}},
    formats:        Formats.held{Slice[Held]{data: ?RV64_HELD[0], size: 4}},
    lowered:        Lowerings.rows{Slice[Lowered]{data: ?RISCV_LOWERED[0], size: 3}},
    arithmetic:     RV64_ARITHMETIC,
    bulk:           BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    atomics:        RISCV_PAIRED,
    code:           RV64_CODE,
    attributes:     Attributes.schema{?SCHEMA},
    ops:            Ops.none{},
    handles:        Handles.none{},
};

# the 128 bit vector register the vector rule fits to, under every build
val RISCV_VECTOR_REGISTERS: [1]VectorRegister = [1]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
};

# the lp64 data of the psabi, the same under every float abi
val RV64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?RISCV_VECTOR_REGISTERS[0], size: 1}}},
};

# the riscv32 widths, arithmetic and code every float abi shares
val RV32_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?POINTERS[0], size: 1},
    slots:    SlotSpace.space{0},
    models:   Models.none{},
    register: Bits.bits{32},
    alu:      Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    integers: Set.widths{Slice[u32]{data: ?RV32_INTEGERS[0], size: 3}},
};
val RV32_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    multiplied: UNDER_ZMMUL,
    products:   Products.forms{Slice[Product]{data: ?RV32_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    division:   Division{widths: Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}}, condition: UNDER_M, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV32_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV32_FILL[0], size: 2}},
};

# riscv32, which computes in binary32 where the build selects the F extension
# or Zfinx and in binary64 where it selects D, and in software where it does
# not
val RV32_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{RISCV_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         RV32_WIDTHS,
    vectors:        Vectors.units{Slice[Unit]{data: ?RISCV_UNITS[0], size: 1}},
    formats:        Formats.held{Slice[Held]{data: ?RV32_HELD[0], size: 3}},
    lowered:        Lowerings.rows{Slice[Lowered]{data: ?RISCV_LOWERED[0], size: 3}},
    arithmetic:     RV32_ARITHMETIC,
    bulk:           BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    atomics:        RISCV_PAIRED,
    code:           RV32_CODE,
    attributes:     Attributes.schema{?SCHEMA},
    ops:            Ops.none{},
    handles:        Handles.none{},
};

# the ilp32 data of the psabi, the same under every float abi
val RV32_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV32_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV32_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?RISCV_VECTOR_REGISTERS[0], size: 1}}},
};

# the risc-v machines, each the capabilities of one architecture. an e base
# architecture computes as its xlen does
val MACHINES: [4]axis.Machine = [4]axis.Machine{
    axis.Machine{arch: ?riscv.RISCV64, caps: RV64_CAPS},
    axis.Machine{arch: ?riscv.RISCV64E, caps: RV64_CAPS},
    axis.Machine{arch: ?riscv.RISCV32, caps: RV32_CAPS},
    axis.Machine{arch: ?riscv.RISCV32E, caps: RV32_CAPS},
};

# the risc-v conventions, by mink's psabi names, each with the data layout of
# its architecture under it: lp64 under every lp64 abi and ilp32 under every
# ilp32 one. ilp32e is a row of riscv32e alone, whose selections hold x0 to
# x15. riscv64e has no convention, as the psabi states no such abi
val MEMBERS: [7]axis.Member = [7]axis.Member{
    axis.Member{arch: ?riscv.RISCV64, name: "lp64", row: opt[*Convention].some{?LP64}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV64, name: "lp64f", row: opt[*Convention].some{?LP64F}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV64, name: "lp64d", row: opt[*Convention].some{?LP64D}, data: RV64_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32", row: opt[*Convention].some{?ILP32}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32f", row: opt[*Convention].some{?ILP32F}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32, name: "ilp32d", row: opt[*Convention].some{?ILP32D}, data: RV32_DATA},
    axis.Member{arch: ?riscv.RISCV32E, name: "ilp32e", row: opt[*Convention].some{?ILP32E}, data: RV32_DATA},
};

# the risc-v address models by exact architecture, as the axis matches them.
# linux at either xlen, and freestanding at either xlen and on riscv32e.
# riscv64e carries none, as it has no convention
val MODELS: [5]axis.Model = [5]axis.Model{
    axis.Model{arch: ?riscv.RISCV64, sys: ?LINUX, addresses: Addresses.model{RISCV_LINUX_ADDRESSES}, codes: address.NO_CODES},
    axis.Model{arch: ?riscv.RISCV32, sys: ?LINUX, addresses: Addresses.model{RISCV_LINUX_ADDRESSES}, codes: address.NO_CODES},
    axis.Model{arch: ?riscv.RISCV64, sys: ?FREESTANDING, addresses: Addresses.model{RISCV_MEDLOW_ADDRESSES}, codes: Slice[address.Code]{data: ?RV64_FREESTANDING_CODES[0], size: 2}},
    axis.Model{arch: ?riscv.RISCV32, sys: ?FREESTANDING, addresses: Addresses.model{RISCV_MEDLOW_ADDRESSES}, codes: address.NO_CODES},
    axis.Model{arch: ?riscv.RISCV32E, sys: ?FREESTANDING, addresses: Addresses.model{RISCV_MEDLOW_ADDRESSES}, codes: address.NO_CODES},
};

# the risc-v rows of every axis
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 4},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 7},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 5},
};
