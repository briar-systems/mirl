use mirl.target.register.riscv.abi.ILP32;
use mirl.target.register.riscv.abi.ILP32D;
use mirl.target.register.riscv.abi.ILP32E;
use mirl.target.register.riscv.abi.ILP32F;
use mirl.target.register.riscv.abi.LP64;
use mirl.target.register.riscv.abi.LP64D;
use mirl.target.register.riscv.abi.LP64E;
use mirl.target.register.riscv.abi.LP64F;
use mirl.target.register.schema.SCHEMA;

# the address space of every risc-v row, its pointer the width the
# architecture's row states
val POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.architecture{}, layout: Rules.c{}},
};

# riscv64 under the lp64d psabi
val RV64_ALU: [2]u32 = [2]u32{32, 64};
# and, or, xor and the unsigned compares on a condition held as 0 or 1, whose
# result is 0 or 1 again
val RISCV_BITS:    [4]Bitwise = [4]Bitwise{Bitwise.both{}, Bitwise.either{}, Bitwise.differ{}, Bitwise.compare{}};
val RV64_INTEGERS: [4]u32     = [4]u32{8, 16, 32, 64};
# the M extension's mulhu, mulh and mulhsu
val RV64_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 64},
};
# the extensions the risc-v rows' conditions name, each a requirement of its
# own: a build meets one where its context holds the extension
val CONDITION_ATOMS:        [8]requirement.Id          = [8]requirement.Id{riscv_extension.F, riscv_extension.ZFINX, riscv_extension.D, riscv_extension.ZFA, riscv_extension.ZMMUL, riscv_extension.M, riscv_extension.V, riscv_extension.ZDINX};
val CONDITION_ALTERNATIVES: [8]requirement.Alternative = [8]requirement.Alternative{
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[0], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[1], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[2], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[3], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[4], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[5], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[6], len: 1}, none: requirement.NO_IDS},
    requirement.Alternative{all: requirement.Ids{at: ?CONDITION_ATOMS[7], len: 1}, none: requirement.NO_IDS},
};
val UNDER_F:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[0], len: 1}};
val UNDER_ZFINX: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[1], len: 1}};
val UNDER_D:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[2], len: 1}};
val UNDER_ZFA:   Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[3], len: 1}};
val UNDER_ZMMUL: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[4], len: 1}};
val UNDER_M:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[5], len: 1}};
val UNDER_V:     Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[6], len: 1}};
val UNDER_ZDINX: Condition = Condition.requires{requirement.Requirement{at: ?CONDITION_ALTERNATIVES[7], len: 1}};

# fmin and fmax of F and D give the other operand for one nan and order
# negative zero below positive zero. zfa adds fminm, fmaxm and fround. no
# instruction selects between floats or gives a remainder
val RISCV_NATIVES: [8]Native = [8]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FMIN, condition: UNDER_ZFA},
    Native{opcode: ir.FMAX, condition: UNDER_ZFA},
    Native{opcode: ir.FFLOOR, condition: UNDER_ZFA},
    Native{opcode: ir.FCEIL, condition: UNDER_ZFA},
    Native{opcode: ir.FINT, condition: UNDER_ZFA},
    Native{opcode: ir.FNEAREST, condition: UNDER_ZFA},
};
# binary32 under the F extension or under Zfinx, which computes it in the
# general registers and which the catalog states F conflicts with, and
# binary64 under D or under Zdinx, which computes it in one general register,
# each held where the build selects it, whose results are the canonical nan.
# zfa needs F, so no build meets its natives under Zfinx or Zdinx. a constant
# is made in a general register, and moved where F holds it
val RV64_HELD: [4]Held = [4]Held{
    Held{format: ?BINARY32, condition: UNDER_F, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNDER_ZFINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_D, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_ZDINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
};
# the v extension's lanes, its elements of 8 to 64 bits and the binary32 and
# binary64 of the zve64d it implies
val RISCV_VECTOR_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# the v extension's registers, masc's v class, vlen wide, so a fixed-length
# vector splits to the least vlen the build's zvl extensions allow
val RISCV_UNITS: [1]Unit = [1]Unit{
    Unit{requires: UNDER_V, width: Width.scaled{Scaled{class: riscv_register.V, length: Length.least{}}}, counts: Counts.any{}, lanes: Slice[Lane]{data: ?RISCV_VECTOR_LANES[0], size: 6}},
};
# c.unimp, so padding traps
val RV64_FILL: [2]u8 = [2]u8{0, 0};
# the lp64 widths of the risc-v elf psabi
val RV64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 16}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# riscv32 under the ilp32d psabi
val RV32_ALU:      [1]u32     = [1]u32{32};
val RV32_INTEGERS: [3]u32     = [3]u32{8, 16, 32};
val RV32_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 32},
};
# binary32 under the F extension or under Zfinx, and binary64 under D or under
# Zdinx, which computes it in an even pair of general registers, each held
# where the build selects it, whose results are the canonical nan. a general
# register holds a binary32 constant's bits, and a binary64 one is loaded
# from read-only data
val RV32_HELD: [3]Held = [3]Held{
    Held{format: ?BINARY32, condition: UNDER_F, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY32, condition: UNDER_ZFINX, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: UNDER_D, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.loaded{}},
};
# c.unimp, so padding traps
val RV32_FILL: [2]u8 = [2]u8{0, 0};
# the ilp32 widths of the risc-v elf psabi, with the c _BitInt widths of clang above 64 bits
val RV32_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 8}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV32_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# risc-v linux code is position independent at either xlen, and a variable of
# a module loaded at any time is reached as one of any module, since the
# psabi's local dynamic sequence saves only a lookup the general one makes
val RISCV_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
    },
};

# the riscv64 widths, arithmetic and code every float abi shares
val RV64_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?POINTERS[0], size: 1},
    slots:    SlotSpace.space{0},
    models:   Models.none{},
    register: Bits.bits{64},
    alu:      Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    integers: Set.widths{Slice[u32]{data: ?RV64_INTEGERS[0], size: 4}},
};
val RV64_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    multiplied: UNDER_ZMMUL,
    products:   Products.forms{Slice[Product]{data: ?RV64_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    # the M extension's div and rem give all ones and the dividend for a zero
    # divisor, and the dividend for an overflowing quotient
    division: Division{widths: Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}}, condition: UNDER_M, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV64_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV64_FILL[0], size: 2}},
};

# a switch of four cases or more whose cases fill two fifths of their span
# branches through a table, which costs a bounds check, a load and an
# indirect jump where a chain costs a compare and branch per case
val RISCV_DENSITY: Density = Density{least: 4, fill: 40};

# riscv64, which computes in binary32 where the build selects the F extension
# or Zfinx and in binary64 where it selects D, and in software where it does
# not
val RV64_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{RISCV_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         RV64_WIDTHS,
    vectors:        Vectors.units{Slice[Unit]{data: ?RISCV_UNITS[0], size: 1}},
    formats:        Formats.held{Slice[Held]{data: ?RV64_HELD[0], size: 4}},
    arithmetic:     RV64_ARITHMETIC,
    bulk:           BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    code:           RV64_CODE,
    attributes:     Attributes.schema{?SCHEMA},
    ops:            Ops.none{},
};

# the 128 bit vector register the vector rule fits to, under every build
val RISCV_VECTOR_REGISTERS: [1]VectorRegister = [1]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
};

# the lp64 data of the psabi, the same under every float abi
val RV64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?RISCV_VECTOR_REGISTERS[0], size: 1}}},
};

# the baselines the tests name, each the one alternative of the atoms its
# isa string names: the xlen and base it states and the extensions it enables
#[testing]
val RV64GC_ATOMS: [10]requirement.Id         = [10]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_I, riscv_extension.I, riscv_extension.M, riscv_extension.A, riscv_extension.F, riscv_extension.D, riscv_extension.ZICSR, riscv_extension.ZIFENCEI, riscv_extension.C};
#[testing]
val RV64GC_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV64GC_ATOMS[0], len: 10}, none: requirement.NO_IDS}};
# rv64gc
#[testing]
pub val RV64GC:        requirement.Requirement    = requirement.Requirement{at: ?RV64GC_ALL[0], len: 1};
#[testing]
val     RV64IFD_ATOMS: [5]requirement.Id          = [5]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_I, riscv_extension.I, riscv_extension.F, riscv_extension.D};
#[testing]
val     RV64IFD_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV64IFD_ATOMS[0], len: 5}, none: requirement.NO_IDS}};
# rv64ifd
#[testing]
pub val RV64IFD:        requirement.Requirement    = requirement.Requirement{at: ?RV64IFD_ALL[0], len: 1};
#[testing]
val     RV64IMAC_ATOMS: [6]requirement.Id          = [6]requirement.Id{riscv_extension.XLEN_64, riscv_extension.BASE_I, riscv_extension.I, riscv_extension.M, riscv_extension.A, riscv_extension.C};
#[testing]
val     RV64IMAC_ALL:   [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?RV64IMAC_ATOMS[0], len: 6}, none: requirement.NO_IDS}};
# rv64imac
