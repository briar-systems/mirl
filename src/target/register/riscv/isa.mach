# the RISC-V selection table, one table for RV32 and RV64
#
# a target supplies a table and nothing else: this is RISC-V's. it names the
# masc rows it emits, guards on the target's declared register width and on
# the extensions masc admits for a row, and states which operations it leaves
# to a legalisation that comes before selection. its loops, in
# mirl.target.register.riscv.loop, are the read-modify-writes no instruction does, which
# its rules select to.

use mirl.target.register.riscv.declared;
use mirl.target.register.riscv.frame;
use mirl.target.register.riscv.move;
use mirl.target.register.riscv.rules;

fwd rules.TABLE;
fwd declared.Declared;
fwd declared.DECLARED;
fwd frame.FRAME;
fwd move.MOVES;

#[testing]
use mirl.target.register.riscv.abi_test;
#[testing]
use mirl.target.register.riscv.field_test;
#[testing]
use mirl.target.register.riscv.order_test;
