# what mirl writes for RISC-V, one of each for RV32 and RV64: the selection
# table, the frame code, the moves and the loops its record in
# mirl.target.register.isa joins to masc's set
#
# the table names the masc rows it emits, guards on the target's declared
# register width and on the extensions masc admits for a row, and states
# which operations it leaves to a legalisation that comes before selection.
# its loops, in mirl.target.register.riscv.loop, are the read-modify-writes no
# instruction does, which its rules select to.

use masc.core.mode;
use riscv_mode: masc.isa.riscv.mode;
use mirl.machine.isa.Relaxing;

use mirl.target.register.riscv.declared;
use mirl.target.register.riscv.frame;
use mirl.target.register.riscv.loop;
use mirl.target.register.riscv.move;
use mirl.target.register.riscv.rules;
use mirl.target.register.riscv.vtype;

fwd rules.TABLE;
fwd declared.Declared;
fwd declared.DECLARED;
fwd frame.FRAME;
fwd move.MOVES;
fwd loop.LOOPS;
fwd vtype.STATE;

# the relax mode of masc's set, whose relax value marks each relocation the
# linker may relax with R_RISCV_RELAX and whose norelax value marks none
pub val RELAXING: Relaxing = Relaxing{on: mode.Setting{mode: ?riscv_mode.RELAXING, value: ?riscv_mode.RELAX}, off: mode.Setting{mode: ?riscv_mode.RELAXING, value: ?riscv_mode.NORELAX}};
