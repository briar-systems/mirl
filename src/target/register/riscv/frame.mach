# the RISC-V frame code: the instructions of each move the frame makes
#
# an offset of twelve signed bits is an immediate. a larger one up to 31 bits
# is built with lui and addi in the scratch register, or in the destination
# when it is not the source and not the stack pointer, whose value a signal
# must always find valid. a load or store is the row of the width the frame
# code's binding chose for the register and the slot's size, from the widths
# below: the base loads and stores of x at each size, f's at each float
# width, and the whole register load and store of v, which take their address
# in a register alone, so an offset is added into the scratch first. no
# offset that scales is formed: the vector length is read from a csr, which
# the machine form names no operand for yet.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.isa.riscv.gen_row;
use riscv_register: masc.isa.riscv.register;
use mirl.machine.class.Physical;
use mirl.machine.frame.code;
use mirl.machine.frame.code.Code;
use mirl.machine.frame.code.Emit;
use mirl.machine.frame.code.Refusal;
use mirl.machine.frame.code.Width;
use mirl.machine.frame.code.Widths;
use mirl.machine.frame.record.Offset;
use mirl.machine.function;
use mirl.machine.operand.Operand;
use mirl.target.register.riscv.hook.hi20;
use mirl.target.register.riscv.hook.lo12;

use rf: masc.core.register;
use masc.core.row.Row;

fun reg(r: rf.Id) Operand {
    ret Operand.physical{Physical.register{r}};
}

fun emit(e: *Emit, row: *Row, ops: *Operand, n: usize) err[Refusal] {
    ret code.append(e, row, Slice[Operand]{data: ops, size: n});
}

fun two(e: *Emit, row: *Row, a: Operand, b: Operand) err[Refusal] {
    var ops: [2]Operand = [2]Operand{a, b};
    ret emit(e, row, ?ops[0], 2);
}

fun three(e: *Emit, row: *Row, a: Operand, b: Operand, c: Operand) err[Refusal] {
    var ops: [3]Operand = [3]Operand{a, b, c};
    ret emit(e, row, ?ops[0], 3);
}

fun fits12(v: i64) bool {
    ret v >= -2048 && v <= 2047;
}

# a value lui and addi build exactly at either register width
fun builds(v: i64) bool {
    ret v >= -2147481600 && v <= 2147481599;
}

# the register a large constant is built in
fun temporary(e: *Emit, dest: rf.Id, src: rf.Id) opt[rf.Id] {
    if (sel e.scratch.some)             { ret e.scratch; }
    if (dest != src && dest != e.stack) { ret opt[rf.Id].some{dest}; }
    ret opt[rf.Id].none{};
}

fun build(e: *Emit, t: rf.Id, v: i64) err[Refusal] {
    var ops:   [2]Operand   = [2]Operand{reg(t), Operand.immediate{hi20(v)}};
    val upper: err[Refusal] = emit(e, gen_row.LUI, ?ops[0], 2);
    if (sel upper.err) { ret upper; }
    if (lo12(v) == 0)  { ret upper; }
    ret three(e, gen_row.ADDI, reg(t), reg(t), Operand.immediate{lo12(v)});
}

fun add(e: *Emit, dest: rf.Id, src: rf.Id, by: Offset) err[Refusal] {
    if (by.per != 0)      { ret err[Refusal].err{Refusal.scaled{by}}; }
    if (fits12(by.fixed)) { ret three(e, gen_row.ADDI, reg(dest), reg(src), Operand.immediate{by.fixed}); }
    val t: opt[rf.Id] = temporary(e, dest, src);
    if (sel t.none)        { ret err[Refusal].err{Refusal.reach{by}}; }
    if (!builds(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    val built: err[Refusal] = build(e, t.some, by.fixed);
    if (sel built.err) { ret built; }
    ret three(e, gen_row.ADD, reg(dest), reg(src), reg(t.some));
}

fun mask(e: *Emit, dest: rf.Id, src: rf.Id, align: u64) err[Refusal] {
    if (align > 0x4000_0000) { ret err[Refusal].err{Refusal.mask{align}}; }
    val v: i64 = 0 - align::i64;
    if (fits12(v)) { ret three(e, gen_row.ANDI, reg(dest), reg(src), Operand.immediate{v}); }
    val t: opt[rf.Id] = temporary(e, dest, src);
    if (sel t.none) { ret err[Refusal].err{Refusal.mask{align}}; }
    val built: err[Refusal] = build(e, t.some, v);
    if (sel built.err) { ret built; }
    ret three(e, gen_row.AND, reg(dest), reg(src), reg(t.some));
}

fun sub(e: *Emit, dest: rf.Id, a: rf.Id, b: rf.Id) err[Refusal] {
    ret three(e, gen_row.SUB, reg(dest), reg(a), reg(b));
}

# the base register and offset an access reaches, building the high part of
# a large offset into a temporary added to the base
fun reach(e: *Emit, base: rf.Id, at: Offset, temp: opt[rf.Id], low: *i64) res[rf.Id, Refusal] {
    if (at.per != 0) { ret res[rf.Id, Refusal].err{Refusal.scaled{at}}; }
    if (fits12(at.fixed)) {
        @low = at.fixed;
        ret res[rf.Id, Refusal].ok{base};
    }
    if (sel temp.none)     { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    if (!builds(at.fixed)) { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    var ops:   [2]Operand   = [2]Operand{reg(temp.some), Operand.immediate{hi20(at.fixed)}};
    val upper: err[Refusal] = emit(e, gen_row.LUI, ?ops[0], 2);
    if (sel upper.err) { ret res[rf.Id, Refusal].err{upper.err}; }
    val added: err[Refusal] = three(e, gen_row.ADD, reg(temp.some), reg(base), reg(temp.some));
    if (sel added.err) { ret res[rf.Id, Refusal].err{added.err}; }
    @low = lo12(at.fixed);
    ret res[rf.Id, Refusal].ok{temp.some};
}

# the register holding a whole register access's address: the base, or the
# base plus the offset added into the temporary
fun whole(e: *Emit, base: rf.Id, at: Offset, temp: opt[rf.Id]) res[rf.Id, Refusal] {
    if (at.fixed == 0 && at.per == 0) { ret res[rf.Id, Refusal].ok{base}; }
    if (sel temp.none)                { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    val added: err[Refusal] = add(e, temp.some, base, at);
    if (sel added.err) { ret res[rf.Id, Refusal].err{added.err}; }
    ret res[rf.Id, Refusal].ok{temp.some};
}

fun store(e: *Emit, w: *Width, value: rf.Id, base: rf.Id, at: Offset) err[Refusal] {
    if (!w.offset) {
        val held: res[rf.Id, Refusal] = whole(e, base, at, e.scratch);
        if (sel held.err) { ret err[Refusal].err{held.err}; }
        ret two(e, w.store, reg(value), reg(held.ok));
    }
    var low: i64                 = 0;
    val b:   res[rf.Id, Refusal] = reach(e, base, at, e.scratch, ?low);
    if (sel b.err) { ret err[Refusal].err{b.err}; }
    ret three(e, w.store, reg(b.ok), reg(value), Operand.immediate{low});
}

fun load(e: *Emit, w: *Width, dest: rf.Id, base: rf.Id, at: Offset) err[Refusal] {
    # a general destination is written anyway, so it can hold the high part
    var temp: opt[rf.Id] = e.scratch;
    if (sel temp.none && function.file(e.f).classes[rf.class_of(dest)].kind == rf.GENERAL && dest != base) { temp = opt[rf.Id].some{dest}; }
    if (!w.offset) {
        val held: res[rf.Id, Refusal] = whole(e, base, at, temp);
        if (sel held.err) { ret err[Refusal].err{held.err}; }
        ret two(e, w.load, reg(dest), reg(held.ok));
    }
    var low: i64                 = 0;
    val b:   res[rf.Id, Refusal] = reach(e, base, at, temp, ?low);
    if (sel b.err) { ret err[Refusal].err{b.err}; }
    ret three(e, w.load, reg(dest), reg(b.ok), Operand.immediate{low});
}

# the bits of one v register
val VLEN: rf.Scaled = rf.Scaled{fixed: 0, per: 32, scale: 2};

val WIDTHS: [9]Width = [9]Width{
    Width{class: riscv_register.X, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, load: gen_row.LB, store: gen_row.SB, offset: true},
    Width{class: riscv_register.X, bits: rf.Scaled{fixed: 16, per: 0, scale: 0}, load: gen_row.LH, store: gen_row.SH, offset: true},
    Width{class: riscv_register.X, bits: rf.Scaled{fixed: 32, per: 0, scale: 0}, load: gen_row.LW, store: gen_row.SW, offset: true},
    Width{class: riscv_register.X, bits: rf.Scaled{fixed: 64, per: 0, scale: 0}, load: gen_row.LD, store: gen_row.SD, offset: true},
    Width{class: riscv_register.F, bits: rf.Scaled{fixed: 16, per: 0, scale: 0}, load: gen_row.FLH, store: gen_row.FSH, offset: true},
    Width{class: riscv_register.F, bits: rf.Scaled{fixed: 32, per: 0, scale: 0}, load: gen_row.FLW, store: gen_row.FSW, offset: true},
    Width{class: riscv_register.F, bits: rf.Scaled{fixed: 64, per: 0, scale: 0}, load: gen_row.FLD, store: gen_row.FSD, offset: true},
    Width{class: riscv_register.F, bits: rf.Scaled{fixed: 128, per: 0, scale: 0}, load: gen_row.FLQ, store: gen_row.FSQ, offset: true},
    Width{class: riscv_register.V, bits: VLEN, load: gen_row.VL1RE8_V, store: gen_row.VS1R_V, offset: false},
};

# the RISC-V frame code
pub val FRAME: Code = Code{add: add, mask: mask, sub: sub, store: store, load: load, widths: Widths{at: ?WIDTHS[0], len: 9}};
