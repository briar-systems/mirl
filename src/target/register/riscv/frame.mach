# the RISC-V frame code: the instructions of each move the frame makes
#
# an offset of twelve signed bits is an immediate. a larger one up to 31 bits
# is built with lui and addi in the scratch register, or in the destination
# when it is not the source and not the stack pointer, whose value a signal
# must always find valid. a load or store is the row of the width the frame
# code's binding chose for the register and the slot's size, from the widths
# below: the base loads and stores of x at each size, f's at each float
# width, and the whole register load and store of v, which take their address
# in a register alone, so an offset is added into the scratch first.
#
# an offset that scales is formed through the register masc names on the
# scale's quantity as measuring it, vlenb for the v registers' vlen: `csrrs`
# reads it into the temporary, its system register at the row's id position,
# a shift scales the bytes it reads by the offset's share of each, a power
# of two as every frame slot's is, negated below the base, and the fixed part
# is added after. an offset whose share is no power of two is refused
# `scaled`.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.core.quantity;
use rf: masc.core.register;
use masc.core.row.Row;
use core_state:     masc.core.state;
use riscv_register: masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;
use mirl.machine.class.Physical;
use mirl.machine.frame.code;
use mirl.machine.frame.code.Code;
use mirl.machine.frame.code.Emit;
use mirl.machine.frame.code.Probes;
use mirl.machine.frame.code.Refusal;
use mirl.machine.frame.code.Steps;
use mirl.machine.frame.code.Width;
use mirl.machine.frame.code.Widths;
use mirl.machine.frame.record.Offset;
use mirl.machine.function;
use mirl.machine.operand.Operand;
use mirl.target.register.riscv.hook.hi20;
use mirl.target.register.riscv.hook.lo12;

fun reg(r: rf.Id) Operand {
    ret Operand.physical{Physical.register{r}};
}

fun emit(e: *Emit, row: *Row, ops: *Operand, n: usize) err[Refusal] {
    ret code.append(e, row, Slice[Operand]{data: ops, size: n});
}

fun two(e: *Emit, row: *Row, a: Operand, b: Operand) err[Refusal] {
    var ops: [2]Operand = [2]Operand{a, b};
    ret emit(e, row, ?ops[0], 2);
}

fun three(e: *Emit, row: *Row, a: Operand, b: Operand, c: Operand) err[Refusal] {
    var ops: [3]Operand = [3]Operand{a, b, c};
    ret emit(e, row, ?ops[0], 3);
}

fun fits12(v: i64) bool {
    ret v >= -2048 && v <= 2047;
}

# a value lui and addi build exactly at either register width
fun builds(v: i64) bool {
    ret v >= -2147481600 && v <= 2147481599;
}

# the register a large constant is built in
fun temporary(e: *Emit, dest: rf.Id, src: rf.Id) opt[rf.Id] {
    if (sel e.scratch.some)             { ret e.scratch; }
    if (dest != src && dest != e.stack) { ret opt[rf.Id].some{dest}; }
    ret opt[rf.Id].none{};
}

fun build(e: *Emit, t: rf.Id, v: i64) err[Refusal] {
    var ops:   [2]Operand   = [2]Operand{reg(t), Operand.immediate{hi20(v)}};
    val upper: err[Refusal] = emit(e, ?gen_row.ROWS[gen_row_index.LUI], ?ops[0], 2);
    if (sel upper.err) { ret upper; }
    if (lo12(v) == 0)  { ret upper; }
    ret three(e, ?gen_row.ROWS[gen_row_index.ADDI], reg(t), reg(t), Operand.immediate{lo12(v)});
}

# the first of two rows the selection admits, one of each register width
fun either(e: *Emit, a: *Row, b: *Row) *Row {
    if (core_state.admits(e.admitted.context, a.requires)) { ret a; }
    ret b;
}

# the register that measures an offset's scale and the bytes of the offset
# per count it reads, none for a scale no register measures
fun measured(e: *Emit, o: Offset, share: *i64) opt[rf.Id] {
    val view: *rf.Available = e.admitted.context.view;
    val q:    opt[u8]       = rf.bound(view, o.scale);
    if (sel q.none) { ret opt[rf.Id].none{}; }
    val qq: *quantity.Quantity = ?view.file.quantities.at[q.some];
    if (!(sel qq.measure.register)) { ret opt[rf.Id].none{}; }
    val row: u32 = qq.measure.register.row::u32;
    if (row >= view.file.register_count) { ret opt[rf.Id].none{}; }
    val s: opt[i64] = quantity.share(qq, o.per);
    if (sel s.none) { ret opt[rf.Id].none{}; }
    @share = s.some;
    ret opt[rf.Id].some{rf.id_of(?view.file.registers[row])};
}

# the scaled part of an offset formed in t: the measuring register read and
# scaled by its share, a power of two
fun scaled_into(e: *Emit, t: rf.Id, o: Offset) err[Refusal] {
    var share: i64        = 0;
    val m:     opt[rf.Id] = measured(e, o, ?share);
    if (sel m.none) { ret err[Refusal].err{Refusal.scaled{o}}; }
    var mag: i64 = share;
    if (mag < 0)                            { mag = 0 - mag; }
    if (mag == 0 || (mag & (mag - 1)) != 0) { ret err[Refusal].err{Refusal.scaled{o}}; }
    val read: err[Refusal] = three(e, ?gen_row.ROWS[gen_row_index.CSRRS], reg(t), reg(m.some), reg(riscv_register.X0));
    if (sel read.err) { ret read; }
    var shift: i64 = 0;
    for ((1::i64 << shift::u64) < mag) {
        shift = shift + 1;
    }
    if (shift > 0) {
        val shifted: err[Refusal] = three(e, either(e, ?gen_row.ROWS[gen_row_index.SLLI], ?gen_row.ROWS[gen_row_index.SLLI_RV32]), reg(t), reg(t), Operand.immediate{shift});
        if (sel shifted.err) { ret shifted; }
    }
    if (share < 0) { ret sub(e, t, riscv_register.X0, t); }
    ret err[Refusal].ok{};
}

# dest is src plus an offset that scales: the scaled part formed in the
# temporary and added, then the fixed part
fun add_scaled(e: *Emit, dest: rf.Id, src: rf.Id, by: Offset) err[Refusal] {
    val t: opt[rf.Id] = temporary(e, dest, src);
    if (sel t.none) { ret err[Refusal].err{Refusal.reach{by}}; }
    val formed: err[Refusal] = scaled_into(e, t.some, by);
    if (sel formed.err) { ret formed; }
    val summed: err[Refusal] = three(e, ?gen_row.ROWS[gen_row_index.ADD], reg(dest), reg(src), reg(t.some));
    if (sel summed.err)                      { ret summed; }
    if (by.fixed == 0)                       { ret summed; }
    if (fits12(by.fixed))                    { ret three(e, ?gen_row.ROWS[gen_row_index.ADDI], reg(dest), reg(dest), Operand.immediate{by.fixed}); }
    if (t.some == dest || !builds(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    val built: err[Refusal] = build(e, t.some, by.fixed);
    if (sel built.err) { ret built; }
    ret three(e, ?gen_row.ROWS[gen_row_index.ADD], reg(dest), reg(dest), reg(t.some));
}

fun add(e: *Emit, dest: rf.Id, src: rf.Id, by: Offset) err[Refusal] {
    if (by.per != 0)      { ret add_scaled(e, dest, src, by); }
    if (fits12(by.fixed)) { ret three(e, ?gen_row.ROWS[gen_row_index.ADDI], reg(dest), reg(src), Operand.immediate{by.fixed}); }
    val t: opt[rf.Id] = temporary(e, dest, src);
    if (sel t.none)        { ret err[Refusal].err{Refusal.reach{by}}; }
    if (!builds(by.fixed)) { ret err[Refusal].err{Refusal.reach{by}}; }
    val built: err[Refusal] = build(e, t.some, by.fixed);
    if (sel built.err) { ret built; }
    ret three(e, ?gen_row.ROWS[gen_row_index.ADD], reg(dest), reg(src), reg(t.some));
}

fun mask(e: *Emit, dest: rf.Id, src: rf.Id, align: u64) err[Refusal] {
    if (align > 0x4000_0000) { ret err[Refusal].err{Refusal.mask{align}}; }
    val v: i64 = 0 - align::i64;
    if (fits12(v)) { ret three(e, ?gen_row.ROWS[gen_row_index.ANDI], reg(dest), reg(src), Operand.immediate{v}); }
    val t: opt[rf.Id] = temporary(e, dest, src);
    if (sel t.none) { ret err[Refusal].err{Refusal.mask{align}}; }
    val built: err[Refusal] = build(e, t.some, v);
    if (sel built.err) { ret built; }
    ret three(e, ?gen_row.ROWS[gen_row_index.AND], reg(dest), reg(src), reg(t.some));
}

fun sub(e: *Emit, dest: rf.Id, a: rf.Id, b: rf.Id) err[Refusal] {
    ret three(e, ?gen_row.ROWS[gen_row_index.SUB], reg(dest), reg(a), reg(b));
}

# the base register and offset an access reaches, building the high part of
# a large offset into a temporary added to the base
fun reach(e: *Emit, base: rf.Id, at: Offset, temp: opt[rf.Id], low: *i64) res[rf.Id, Refusal] {
    if (at.per != 0) {
        if (sel temp.none) { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
        val formed: err[Refusal] = scaled_into(e, temp.some, at);
        if (sel formed.err) { ret res[rf.Id, Refusal].err{formed.err}; }
        val summed: err[Refusal] = three(e, ?gen_row.ROWS[gen_row_index.ADD], reg(temp.some), reg(base), reg(temp.some));
        if (sel summed.err)    { ret res[rf.Id, Refusal].err{summed.err}; }
        if (!fits12(at.fixed)) { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
        @low = at.fixed;
        ret res[rf.Id, Refusal].ok{temp.some};
    }
    if (fits12(at.fixed)) {
        @low = at.fixed;
        ret res[rf.Id, Refusal].ok{base};
    }
    if (sel temp.none)     { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    if (!builds(at.fixed)) { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    var ops:   [2]Operand   = [2]Operand{reg(temp.some), Operand.immediate{hi20(at.fixed)}};
    val upper: err[Refusal] = emit(e, ?gen_row.ROWS[gen_row_index.LUI], ?ops[0], 2);
    if (sel upper.err) { ret res[rf.Id, Refusal].err{upper.err}; }
    val added: err[Refusal] = three(e, ?gen_row.ROWS[gen_row_index.ADD], reg(temp.some), reg(base), reg(temp.some));
    if (sel added.err) { ret res[rf.Id, Refusal].err{added.err}; }
    @low = lo12(at.fixed);
    ret res[rf.Id, Refusal].ok{temp.some};
}

# the register holding a whole register access's address: the base, or the
# base plus the offset added into the temporary
fun whole(e: *Emit, base: rf.Id, at: Offset, temp: opt[rf.Id]) res[rf.Id, Refusal] {
    if (at.fixed == 0 && at.per == 0) { ret res[rf.Id, Refusal].ok{base}; }
    if (sel temp.none)                { ret res[rf.Id, Refusal].err{Refusal.reach{at}}; }
    val added: err[Refusal] = add(e, temp.some, base, at);
    if (sel added.err) { ret res[rf.Id, Refusal].err{added.err}; }
    ret res[rf.Id, Refusal].ok{temp.some};
}

fun store(e: *Emit, w: *Width, value: rf.Id, base: rf.Id, at: Offset) err[Refusal] {
    if (!w.offset) {
        val held: res[rf.Id, Refusal] = whole(e, base, at, e.scratch);
        if (sel held.err) { ret err[Refusal].err{held.err}; }
        ret two(e, w.store, reg(value), reg(held.ok));
    }
    var low: i64                 = 0;
    val b:   res[rf.Id, Refusal] = reach(e, base, at, e.scratch, ?low);
    if (sel b.err) { ret err[Refusal].err{b.err}; }
    ret three(e, w.store, reg(b.ok), reg(value), Operand.immediate{low});
}

fun load(e: *Emit, w: *Width, dest: rf.Id, base: rf.Id, at: Offset) err[Refusal] {
    # a general destination is written anyway, so it can hold the high part
    var temp: opt[rf.Id] = e.scratch;
    if (sel temp.none && function.file(e.f).classes[rf.class_of(dest)].kind == rf.GENERAL && dest != base) { temp = opt[rf.Id].some{dest}; }
    if (!w.offset) {
        val held: res[rf.Id, Refusal] = whole(e, base, at, temp);
        if (sel held.err) { ret err[Refusal].err{held.err}; }
        ret two(e, w.load, reg(dest), reg(held.ok));
    }
    var low: i64                 = 0;
    val b:   res[rf.Id, Refusal] = reach(e, base, at, temp, ?low);
    if (sel b.err) { ret err[Refusal].err{b.err}; }
    ret three(e, w.load, reg(dest), reg(b.ok), Operand.immediate{low});
}

# the bits of one v register
val VLEN: quantity.Scaled = quantity.Scaled{fixed: 0, per: 32, scale: 2};

val WIDTHS: [9]Width = [9]Width{
    Width{class: riscv_register.X, bits: quantity.Scaled{fixed: 8, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.LB], store: ?gen_row.ROWS[gen_row_index.SB], offset: true},
    Width{class: riscv_register.X, bits: quantity.Scaled{fixed: 16, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.LH], store: ?gen_row.ROWS[gen_row_index.SH], offset: true},
    Width{class: riscv_register.X, bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.LW], store: ?gen_row.ROWS[gen_row_index.SW], offset: true},
    Width{class: riscv_register.X, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.LD], store: ?gen_row.ROWS[gen_row_index.SD], offset: true},
    Width{class: riscv_register.F, bits: quantity.Scaled{fixed: 16, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.FLH], store: ?gen_row.ROWS[gen_row_index.FSH], offset: true},
    Width{class: riscv_register.F, bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.FLW], store: ?gen_row.ROWS[gen_row_index.FSW], offset: true},
    Width{class: riscv_register.F, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.FLD], store: ?gen_row.ROWS[gen_row_index.FSD], offset: true},
    Width{class: riscv_register.F, bits: quantity.Scaled{fixed: 128, per: 0, scale: 0}, load: ?gen_row.ROWS[gen_row_index.FLQ], store: ?gen_row.ROWS[gen_row_index.FSQ], offset: true},
    Width{class: riscv_register.V, bits: VLEN, load: ?gen_row.ROWS[gen_row_index.VL1RE8_V], store: ?gen_row.ROWS[gen_row_index.VS1R_V], offset: false},
};

# an offset of the v registers' scale is measured through vlenb. a selection
# fixes every other scale of the file, so no offset scales by one
fun scaled(o: Offset) Steps {
    if (o.scale == riscv_register.V.width.scale) { ret Steps.measured{}; }
    ret Steps.none{};
}

# the RISC-V frame code
pub val FRAME: Code = Code{add: add, mask: mask, sub: sub, store: store, load: load, widths: Widths{at: ?WIDTHS[0], len: 9}, scaled: scaled, probe: Probes.none{}};
