    mo.Operand{shape: mo.Shape.register{mo.Register{classes: mo.Classes{at: ?S_L[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}, fields: 1}}, role: mo.READ, width: 8, quantity: mo.ONE},
