#[testing]
val S_MOVE_ROWS: [3]move.Move = [3]move.Move{
    move.Move{to: Holder.hardware{?S_CLASSES[0]}, from: Holder.hardware{?S_CLASSES[0]}, bits: rf.Scaled{fixed: 16, per: 0, scale: 0}, row: ?S_ROWS[0], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
    move.Move{to: Holder.hardware{?S_CLASSES[1]}, from: Holder.hardware{?S_CLASSES[1]}, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, row: ?S_ROWS[1], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
    move.Move{to: Holder.hardware{?S_CLASSES[2]}, from: Holder.hardware{?S_CLASSES[2]}, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, row: ?S_ROWS[2], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
};

#[testing]
val S_MOVES: move.Table = move.Table{moves: move.Moves{at: ?S_MOVE_ROWS[0], len: 3}, swaps: move.Moves{at: nil, len: 0}};

# the moves between the 8-bit classes only across them and within h: l has no
# move into itself, so a value held in an l register cannot move to another
#[testing]
val S_CROSS_ROWS: [3]move.Move = [3]move.Move{
    move.Move{to: Holder.hardware{?S_CLASSES[2]}, from: Holder.hardware{?S_CLASSES[2]}, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, row: ?S_ROWS[2], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
    move.Move{to: Holder.hardware{?S_CLASSES[1]}, from: Holder.hardware{?S_CLASSES[2]}, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, row: ?S_ROWS[3], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
    move.Move{to: Holder.hardware{?S_CLASSES[2]}, from: Holder.hardware{?S_CLASSES[1]}, bits: rf.Scaled{fixed: 8, per: 0, scale: 0}, row: ?S_ROWS[4], parts: move.Parts{at: ?S_WHOLE[0], len: 2}},
};

#[testing]
val S_CROSS: move.Table = move.Table{moves: move.Moves{at: ?S_CROSS_ROWS[0], len: 3}, swaps: move.Moves{at: nil, len: 0}};

# the set has no frame code, and a copy that names no slot never asks for it
#[testing]
fun s_add(e: *code.Emit, dest: rf.Id, src: rf.Id, by: record.Offset) err[code.Refusal] {
    ret err[code.Refusal].err{code.Refusal.access{dest}};
}

#[testing]
fun s_mask(e: *code.Emit, dest: rf.Id, src: rf.Id, align: u64) err[code.Refusal] {
    ret err[code.Refusal].err{code.Refusal.access{dest}};
}

#[testing]
fun s_sub(e: *code.Emit, dest: rf.Id, a: rf.Id, b: rf.Id) err[code.Refusal] {
    ret err[code.Refusal].err{code.Refusal.access{dest}};
}

#[testing]
fun s_access(e: *code.Emit, w: *code.Width, register: rf.Id, base: rf.Id, at: record.Offset) err[code.Refusal] {
    ret err[code.Refusal].err{code.Refusal.access{register}};
}

#[testing]
val S_CODE: code.Code = code.Code{add: s_add, mask: s_mask, sub: s_sub, store: s_access, load: s_access, widths: code.Widths{at: nil, len: 0}};

#[testing]
val S_MODULE: str = "target \"mtest\" \"linux\" \"\" \"\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# lower the copies of an unframed function whose slots stand one after
# another from the stack pointer, the function replaced by the lowered one
# ---
# a:     the allocator
# f:     the function, every operand a location or a slot
# r:     the request, every register it allows clobbered
# stack: the stack pointer, rf.NONE for a function with no slot
# ret:   0, or the step that failed
#[testing]
fun unframed(a: *allocator.Allocator, f: *Function, r: *lower.Request, stack: rf.Id) i32 {
    var layout: record.Layout = record.Layout{entry: 0, size: record.bytes(0), outgoing: 0, red: 0, stack: stack, pointer: rf.NONE, at: 0, realign: 0, slots: vector.init[record.Place](a), saves: vector.init[record.Save](a)};
    var at:     i64           = 0;
    var i:      usize         = 0;
    for (i < f.slots.len) {
        val placed: res[usize, allocator.Error] = vector.push[record.Place](?layout.slots, record.Place.at{record.Address{base: record.Base.stack{}, offset: record.bytes(at)}});
        if (sel placed.err) {
            record.release_layout(?layout);
            ret 20;
        }
        at = at + f.slots.data[i].size::i64;
        i  = i + 1;
    }
    var x: Framed = Framed{function: @f, layout: layout, facts: vector.init[record.Fact](a), origins: vector.init[u32](a)};
    fin {
        record.release_layout(?x.layout);
        vector.dnit[record.Fact](?x.facts);
        vector.dnit[u32](?x.origins);
    }
    i = 0;
    for (i < x.function.instructions.len) {
        val pushed: res[usize, allocator.Error] = vector.push[u32](?x.origins, i::u32);
        if (sel pushed.err) { ret 21; }
        i = i + 1;
    }
    val done: err[lower.Error] = lower.lower(a, ?x, r);
    @f = x.function;
    if (sel done.err) { ret 22; }
    ret 0;
}

# lower the copies of @f of a text of the sharing set, unframed and with no
# slot, every register allowed and clobbered, and compare it with the
# expected text
# ---
# text: the machine text of @f, every operand a register
# want: the expected text of @f lowered
# ret:  0, or the step that failed
#[testing]
fun shared_lowers(text: str, want: str) i32 {
    ret shared_in(text, want, ?S_MOVES, ?S_CODE, rf.NONE, 15);
}

# lower the copies of @f of a text of the sharing set with a table of moves
# and frame code, the first registers of the file allowed and clobbered
# ---
# text:  the machine text of @f, every operand a register or a slot
# want:  the expected text of @f lowered
# moves: the set's moves
# c:     the set's frame code
# stack: the stack pointer, rf.NONE for a function with no slot
# count: how many registers are allowed
# ret:   0, or the step that failed
#[testing]
fun shared_in(text: str, want: str, moves_of: *move.Table, c: *code.Code, stack: rf.Id, count: usize) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(S_MODULE));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val input: res[reader.Unit, reader.Refusal] = reader.parse_body_in(?a, ?m, ?S_REGISTRY, ?synthetic.ARCH, synthetic.MEMORIES, view_of(text));
    if (sel input.err) { ret 2; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val expected: res[reader.Unit, reader.Refusal] = reader.parse_body_in(?a, ?m, ?S_REGISTRY, ?synthetic.ARCH, synthetic.MEMORIES, view_of(want));
    if (sel expected.err) { ret 3; }
    var e: reader.Unit = expected.ok;
    fin { reader.dnit(?e); }
    val got: res[Locations, location.Error] = location.init(?a, ?S_FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 4; }
    var at: Locations = got.ok;
    fin { location.dnit(?at); }
    val viewed: res[rf.Available, rf.Error] = rf.select(?a, ?S_FILE, nil);
    if (sel viewed.err) { ret 5; }
    var regs: rf.Available = viewed.ok;
    fin { rf.release(?regs); }
    val indexed: res[move.Index, move.Error] = move.index(?a, moves_of, ?at, ?regs);
    if (sel indexed.err) { ret 6; }
    var moves: move.Index = indexed.ok;
    fin { move.dnit(?moves); }
    val bound: res[code.Admitted, code.Error] = code.admit(?a, c, ?regs);
    if (sel bound.err) { ret 6; }
    var admitted: code.Admitted = bound.ok;
    fin { code.dnit(?admitted); }
    var ids:  [15]rf.Id;
    var each: [15]Physical;
    var i:    usize = 0;
    for (i < count) {
        ids[i]  = rf.id_of(?S_REGISTERS[i]);
        each[i] = Physical.register{ids[i]};
        i       = i + 1;
    }
    var request: lower.Request = lower.Request{
        at:        ?at,
        registers: ?regs,
        clobbered: Slice[rf.Id]{data: ?ids[0], size: count},
        allowed:   Slice[Physical]{data: ?each[0], size: count},
        code:      ?admitted,
        moves:     ?moves,
    };
    val done: i32 = unframed(?a, ?u.items.data[0].function, ?request, stack);
    if (done != 0) { ret done; }
    val same: res[bool, printer.Error] = equal.same_function(?m, ?u.items.data[0].function, ?m, ?e.items.data[0].function);
    if (sel same.err) { ret 9; }
    if (!same.ok) {
        var items: [1]item.Item;
        items[0].function = u.items.data[0].function;
        var out: io.Writer = filesystem.writer(filesystem.STDERR);
        printing.print_in(?out, ?m, ?S_REGISTRY, ?synthetic.ARCH, synthetic.MEMORIES, Slice[item.Item]{data: ?items[0], size: 1});
        ret 10;
    }
    ret 0;
}

# a parallel copy of w1 into w0 and l0 into l1, w3 into w2 and h2 into h1: no
# two pairs name one location, yet l1 and h1 are part of w1, which the first
# pair reads, h2 is part of w2, and l0 is part of w0. the two first pairs form
# a cycle, broken by saving w1 in w4, the one w register free across the copy,
# after which the high bytes move, then w2, then l1 and last w0 from w4
#[testing]
val SHARED: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n^0:\n    pseudo parallel_copy l1, w0, h1, w2, l0, w1, h2, w3\n}\n";

#[testing]
val SHARED_OUT: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n^0:\n    movw w4, w1\n    movh h1, h2\n    movw w2, w3\n    movl l1, l0\n    movw w0, w4\n}\n";

test copy__a_parallel_copy_over_shared_storage_reads_each_value_before_writing_over_it {
    ret shared_lowers(SHARED, SHARED_OUT);
}

# a parallel copy exchanging h0 and l1, which the set moves only across the two
# classes: l has no move into itself. h0 is saved to break the cycle, and the
# value is later moved out into l1, so an l register cannot hold it though the
# set moves h into l and back. the first free h register, h1 (the high byte of l1's bank, a different byte), takes it
#[testing]
val CROSS: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n^0:\n    pseudo parallel_copy h0, l1, l1, h0\n}\n";

#[testing]
val CROSS_OUT: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n^0:\n    movh h1, h0\n    movhl h0, l1\n    movlh l1, h1\n}\n";

test copy__a_cycle_save_skips_a_location_its_value_cannot_be_moved_out_of_to_the_destination {
    ret shared_in(CROSS, CROSS_OUT, ?S_CROSS, ?S_CODE, rf.NONE, 15);
}

# a load or store of the sharing set, the address copied into the scratch
# register and the value moved through it, so the text shows the scratch used
#[testing]
fun s_through(e: *code.Emit, w: *code.Width, register: rf.Id, base: rf.Id, at: record.Offset) err[code.Refusal] {
    if (sel e.scratch.none) { ret err[code.Refusal].err{code.Refusal.access{register}}; }
    var ops:  [2]Operand        = [2]Operand{Operand.physical{Physical.register{e.scratch.some}}, Operand.physical{Physical.register{base}}};
    val held: err[code.Refusal] = code.append(e, w.load, Slice[Operand]{data: ?ops[0], size: 2});
    if (sel held.err) { ret held; }
    ops[0] = Operand.physical{Physical.register{register}};
    ops[1] = Operand.physical{Physical.register{e.scratch.some}};
    ret code.append(e, w.load, Slice[Operand]{data: ?ops[0], size: 2});
}

#[testing]
val S_WIDTHS: [1]code.Width = [1]code.Width{code.Width{class: ?S_CLASSES[0], bits: rf.Scaled{fixed: 16, per: 0, scale: 0}, load: ?S_ROWS[0], store: ?S_ROWS[0], offset: false}};

#[testing]
val S_SLOT_CODE: code.Code = code.Code{add: s_add, mask: s_mask, sub: s_sub, store: s_through, load: s_through, widths: code.Widths{at: ?S_WIDTHS[0], len: 1}};

# a parallel copy exchanging w0 and a 2 byte slot at the stack pointer w4,
# with w1 and w2 free. the slot's value is saved in w1, whose load takes its
# address in a scratch that is w2: w1 is taken for the save, so the frame code
# is not offered it. the store of w0 then goes through w2 too
#[testing]
val SLOT: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n    slot [0]: size 2 align 2\n^0:\n    pseudo parallel_copy [0], w0, w0, [0]\n}\n";

#[testing]
val SLOT_OUT: str = "target \"mtest\" \"linux\" \"\" \"\"\n\nfunction @f {\n    slot [0]: size 2 align 2\n^0:\n    movw w2, w4\n    movw w1, w2\n    movw w2, w4\n    movw w0, w2\n    movw w0, w1\n}\n";

test copy__a_cycle_save_through_a_slot_keeps_its_location_from_the_frame_codes_scratch {
    ret shared_in(SLOT, SLOT_OUT, ?S_MOVES, ?S_SLOT_CODE, rf.id_of(?S_REGISTERS[4]), 3);
}

# lower the copies of @f of a text for a risc-v target, unframed with its
# slots one after another from the stack pointer and only the registers
# named free, and compare it with the expected text, so a target that states
# no convention is lowered too
# ---
# module: an ir module on the target
# text:   the machine text of @f, every operand a location or a slot
# want:   the expected text of @f lowered
# free:   the registers allowed and clobbered, by name
# ret:    0, or the step that failed
#[testing]
fun placed_lowers(module_text: str, text: str, want: str, free: Slice[str]) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, view_of(module_text));
    if (sel made.err) { ret 1; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val t: opt[*Target] = targets.row_of(m.target);
    if (sel t.none) { ret 2; }
    var basis:  target_basis.Basis;
    val chosen: err[target_basis.Error] = target_basis.choose(?basis, ?a, t.some, Slice[str]{data: nil, size: 0});
    if (sel chosen.err) { ret 3; }
    fin { target_basis.drop(?basis); }
    val file:   *rf.File                    = basis.set.codec.registers;
    val viewed: res[rf.Available, rf.Error] = rf.select(?a, file, ?basis.selection);
    if (sel viewed.err) { ret 4; }
    var regs: rf.Available = viewed.ok;
    fin { rf.release(?regs); }
    val got: res[Locations, location.Error] = location.init(?a, file, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 5; }
    var at: Locations = got.ok;
    fin { location.dnit(?at); }
    val indexed: res[move.Index, move.Error] = move.index(?a, ?MOVES, ?at, ?regs);
    if (sel indexed.err) { ret 6; }
    var moves: move.Index = indexed.ok;
    fin { move.dnit(?moves); }
    val bound: res[code.Admitted, code.Error] = code.admit(?a, ?FRAME, ?regs);
    if (sel bound.err) { ret 7; }
    var admitted: code.Admitted = bound.ok;
    fin { code.dnit(?admitted); }
    val input: res[reader.Unit, reader.Refusal] = reader.parse_body(?a, ?m, view_of(text));
    if (sel input.err) { ret 8; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val expected: res[reader.Unit, reader.Refusal] = reader.parse_body(?a, ?m, view_of(want));
    if (sel expected.err) { ret 9; }
    var e: reader.Unit = expected.ok;
    fin { reader.dnit(?e); }
    var ids:  [4]rf.Id;
    var each: [4]Physical;
    if (free.size > 4) { ret 10; }
    var i: usize = 0;
    for (i < free.size) {
        val id: opt[rf.Id] = rf.named(file, view_of(free.data[i]), false);
        if (sel id.none) { ret 11; }
        ids[i]  = id.some;
        each[i] = Physical.register{id.some};
        i       = i + 1;
    }
    val sp: opt[rf.Id] = rf.named(file, view_of("x2"), false);
    if (sel sp.none) { ret 12; }
    var request: lower.Request = lower.Request{
        at:        ?at,
        registers: ?regs,
        clobbered: Slice[rf.Id]{data: ?ids[0], size: free.size},
        allowed:   Slice[Physical]{data: ?each[0], size: free.size},
        code:      ?admitted,
        moves:     ?moves,
    };
    val done: i32 = unframed(?a, ?u.items.data[0].function, ?request, sp.some);
    if (done != 0) { ret done; }
    val same: res[bool, printer.Error] = equal.same_function(?m, ?u.items.data[0].function, ?m, ?e.items.data[0].function);
    if (sel same.err) { ret 13; }
    if (!same.ok) {
        show(?m, u.items.data[0].function);
        ret 14;
    }
    ret 0;
}

#[testing]
val SIXTEEN: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 16 align 16\n    slot [1]: size 16 align 16\n^0:\n    pseudo copy [0], [1]\n    jalr x0, x1, 0\n}\n";

# no register of rv64gc holds 16 bytes, so the copy is two 8 byte parts
# through x5, [1] at 16 and [0] at 0 in a 32 byte frame
#[testing]
val SIXTEEN_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 16 align 16\n    slot [1]: size 16 align 16\n^0:\n    addi x2, x2, -32\n    ld x5, x2, 16\n    sd x2, x5, 0\n    ld x5, x2, 24\n    sd x2, x5, 8\n    addi x2, x2, 32\n    jalr x0, x1, 0\n}\n";

test copy__a_slot_to_slot_copy_of_sixteen_bytes_moves_all_sixteen {
    ret lowers(SIXTEEN, SIXTEEN_OUT);
}

#[testing]
val RV64_MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

#[testing]
val RV32_MODULE: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

#[testing]
val X5_F0: [2]str = [2]str{"x5", "f0"};

#[testing]
val X5: [1]str = [1]str{"x5"};

#[testing]
val DOUBLE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    pseudo copy [0], [1]\n    add x5, x5, x5\n    jalr x0, x1, 0\n}\n";

# x5 holds a value across the copy, so the 8 bytes go through f0, which d
# makes 64 bits wide
#[testing]
val DOUBLE_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    fld f0, x2, 8\n    fsd x2, f0, 0\n    add x5, x5, x5\n    jalr x0, x1, 0\n}\n";

test copy__a_slot_to_slot_copy_goes_through_a_float_register_when_no_general_one_is_free {
    ret placed_lowers(RV64_MODULE, DOUBLE, DOUBLE_OUT, Slice[str]{data: ?X5_F0[0], size: 2});
}

#[testing]
val NARROW: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    pseudo copy [0], [1]\n    jalr x0, x1, 0\n}\n";

# an rv32 x register holds 4 bytes and rv32 has no ld, so the 8 bytes are two
# 4 byte parts through x5
#[testing]
val NARROW_OUT: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    lw x5, x2, 8\n    sw x2, x5, 0\n    lw x5, x2, 12\n    sw x2, x5, 4\n    jalr x0, x1, 0\n}\n";

test copy__an_rv32_eight_byte_slot_copy_never_loads_a_doubleword {
    ret placed_lowers(RV32_MODULE, NARROW, NARROW_OUT, Slice[str]{data: ?X5[0], size: 1});
}
