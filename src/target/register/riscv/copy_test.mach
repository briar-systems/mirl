    flags:    effect.Flags{read: effect.Set{words: nil, len: 0}, written: effect.Set{words: nil, len: 0}, undefined: effect.Set{words: nil, len: 0}, kept: effect.Set{words: nil, len: 0}},
    memory:   effect.Accesses{at: nil, len: 0},
    control:  effect.Control{transfer: effect.NONE, target: effect.UNTARGETED, conditional: false, operand: field.NO_OPERAND},
    stack:    effect.Stack.none{},
    latency:  effect.ONE,
    fixed:    effect.Fixeds{at: nil, len: 0},
