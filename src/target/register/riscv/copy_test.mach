#[testing]
val MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a test's module, machine, locations, allowed locations and moves
#[testing]
rec Fixture {
    a:       allocator.Allocator;
    m:       Module;
    mach:    Build;
    at:      Locations;
    allowed: vector.Vector[Physical];
    moves:   move.Index;
}

#[testing]
fun open(x: *Fixture) i32 {
    page.make(?x.a);
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, view_of(MODULE));
    if (sel made.err) { ret 1; }
    x.m = made.ok;
    val t: opt[*Target] = targets.row_of(x.m.target);
    if (sel t.none) { ret 2; }
    val opened: err[target_basis.Error] = machine.open(?x.mach, ?x.a, t.some, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 3; }
    val got: res[Locations, location.Error] = location.init(?x.a, x.mach.convention.registers.file, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 4; }
    x.at = got.ok;
    val listed: res[vector.Vector[Physical], allowed.Failure] = allowed.of_build(?x.a, ?x.mach, ?x.at, false);
    if (sel listed.err) { ret 5; }
    x.allowed = listed.ok;
    val indexed: res[move.Index, move.Error] = move.index(?x.a, ?MOVES, ?x.at, x.mach.convention.registers);
    if (sel indexed.err) { ret 6; }
    x.moves = indexed.ok;
    ret 0;
}

#[testing]
fun close(x: *Fixture) {
    move.dnit(?x.moves);
    vector.dnit[Physical](?x.allowed);
    location.dnit(?x.at);
    machine.close(?x.mach);
    module.dnit(?x.m);
}

# print a function to standard error, so a failing comparison shows what came out
#[testing]
fun show(m: *Module, f: Function) {
    var items: [1]item.Item;
    items[0].function = f;
    var out: io.Writer = filesystem.writer(filesystem.STDERR);
    printing.print(?out, m, Slice[item.Item]{data: ?items[0], size: 1});
}

# frame @f of a text, lower its copies and compare it with the expected text
# ---
# text: the machine text of @f, every operand a location or a slot
# want: the expected text of @f framed and lowered
# ret:  0, or the step that failed
#[testing]
fun lowers(text: str, want: str) i32 {
    var x:      Fixture;
    val opened: i32 = open(?x);
    if (opened != 0) { ret opened; }
    fin { close(?x); }
    val input: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, view_of(text));
    if (sel input.err) { ret 10; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val expected: res[reader.Unit, reader.Refusal] = reader.parse_body(?x.a, ?x.m, view_of(want));
    if (sel expected.err) { ret 11; }
    var e: reader.Unit = expected.ok;
    fin { reader.dnit(?e); }
    val r:    lay.Request          = lay.Request{convention: ?x.mach.convention, at: ?x.at};
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, r);
    if (sel laid.err) { ret 12; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val bound: res[code.Admitted, code.Error] = code.admit(?x.a, ?FRAME, x.mach.convention.registers);
    if (sel bound.err) { ret 13; }
    var admitted: code.Admitted = bound.ok;
    fin { code.dnit(?admitted); }
    val framed: res[Framed, finish.Error] = finish.finish(?x.a, ?u.items.data[0].function, ?p, ?admitted);
    if (sel framed.err) { ret 13; }
    var out: Framed = framed.ok;
    fin { record.release(?out); }
    var request: lower.Request = lower.Request{
        at:        ?x.at,
        registers: x.mach.convention.registers,
        clobbered: x.mach.convention.clobbered,
        allowed:   Slice[Physical]{data: x.allowed.data, size: x.allowed.len},
        code:      ?admitted,
        moves:     ?x.moves,
    };
    val done: err[lower.Error] = lower.lower(?x.a, ?out, ?request);
    if (sel done.err) { ret 14; }
    val same: res[bool, printer.Error] = equal.same_function(?x.m, ?out.function, ?x.m, ?e.items.data[0].function);
    if (sel same.err) { ret 15; }
    if (!same.ok) {
        show(?x.m, out.function);
        ret 16;
    }
    ret 0;
}

# a parallel copy exchanging a0 and a1, both read after it, with t0 free
#[testing]
val SWAP: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo parallel_copy x10, x11, x11, x10\n    add x12, x10, x11\n    jalr x0, x1, 0\n}\n";

#[testing]
val SWAP_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    addi x5, x10, 0\n    addi x10, x11, 0\n    addi x11, x5, 0\n    add x12, x10, x11\n    jalr x0, x1, 0\n}\n";

test copy__a_two_register_cycle_moves_through_a_free_scratch_register {
    ret lowers(SWAP, SWAP_OUT);
}

#[testing]
val SAME: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy x10, x10\n    jalr x0, x1, 0\n}\n";

#[testing]
val SAME_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    jalr x0, x1, 0\n}\n";

test copy__a_copy_to_its_own_location_disappears {
    ret lowers(SAME, SAME_OUT);
}

#[testing]
val SLOTS: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    pseudo copy [0], [1]\n    jalr x0, x1, 0\n}\n";

#[testing]
val SLOTS_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    slot [0]: size 8 align 8\n    slot [1]: size 8 align 8\n^0:\n    addi x2, x2, -16\n    ld x5, x2, 8\n    sd x2, x5, 0\n    addi x2, x2, 16\n    jalr x0, x1, 0\n}\n";

test copy__a_slot_to_slot_copy_goes_through_a_register {
    ret lowers(SLOTS, SLOTS_OUT);
}

# a register file whose registers share storage, as x86's ax holds al and ah:
# each of five banks is one 16-bit w register, its low byte l and its high byte h
#[testing]
val S_CLASSES: [3]rf.Class = [3]rf.Class{
    rf.Class{name: "w", kind: rf.GENERAL, width: rf.Scaled{fixed: 16, per: 0, scale: 0}, count: 5},
    rf.Class{name: "l", kind: rf.GENERAL, width: rf.Scaled{fixed: 8, per: 0, scale: 0}, count: 5},
    rf.Class{name: "h", kind: rf.GENERAL, width: rf.Scaled{fixed: 8, per: 0, scale: 0}, count: 5},
};

#[testing]
val S_LOW: rf.Scaled = rf.Scaled{fixed: 0, per: 0, scale: 0};

#[testing]
val S_HIGH: rf.Scaled = rf.Scaled{fixed: 8, per: 0, scale: 0};

#[testing]
val S_ONE: rf.Scaled = rf.Scaled{fixed: 1, per: 0, scale: 0};

#[testing]
val S_REGISTERS: [15]rf.Register = [15]rf.Register{
    rf.Register{name: "w0", class: 0, number: 0, bank: 0, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "w1", class: 0, number: 1, bank: 1, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "w2", class: 0, number: 2, bank: 2, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "w3", class: 0, number: 3, bank: 3, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "w4", class: 0, number: 4, bank: 4, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "l0", class: 1, number: 0, bank: 0, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "l1", class: 1, number: 1, bank: 1, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "l2", class: 1, number: 2, bank: 2, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "l3", class: 1, number: 3, bank: 3, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "l4", class: 1, number: 4, bank: 4, offset: S_LOW, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "h0", class: 2, number: 0, bank: 0, offset: S_HIGH, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "h1", class: 2, number: 1, bank: 1, offset: S_HIGH, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "h2", class: 2, number: 2, bank: 2, offset: S_HIGH, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "h3", class: 2, number: 3, bank: 3, offset: S_HIGH, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
    rf.Register{name: "h4", class: 2, number: 4, bank: 4, offset: S_HIGH, stride: S_LOW, count: S_ONE, flags: 0, requires: requirement.NONE, extend: rf.KEEP},
};

