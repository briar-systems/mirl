    mo.Operand{shape: mo.Shape.register{mo.Register{classes: mo.Classes{at: ?S_H[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}, fields: 1}}, role: mo.READ, width: 8, quantity: mo.ONE},
};

#[testing]
val S_LH_OPERANDS: [2]mo.Operand = [2]mo.Operand{
    mo.Operand{shape: mo.Shape.register{mo.Register{classes: mo.Classes{at: ?S_L[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}, fields: 1}}, role: mo.WRITE, width: 8, quantity: mo.ONE},
    mo.Operand{shape: mo.Shape.register{mo.Register{classes: mo.Classes{at: ?S_H[0], len: 1}, first: 0, count: 0, excluded: mo.Numbers{at: nil, len: 0}, fields: 1}}, role: mo.READ, width: 8, quantity: mo.ONE},
