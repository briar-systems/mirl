# the RISC-V moves: the whole value of one register into another of its class
#
# a general register moves by adding zero to it, at every width. a float
# register moves by taking its own sign, at the width its storage takes
# through the selection, so a selection of f, d or q admits the one row that
# moves all of it. a vector register moves whole, and so does an aligned group
# of two, four or eight of them, a register of vg2, vg4 or vg8, by vmv<n>r.v.
# the set has no exchange of two registers, so it states no swap, and a cycle
# of groups goes through a free group of the same size. it states no move
# between classes, since no copy selection places is one.

use mirl.machine.copy.move.Move;
use mirl.machine.copy.move.Moves;
use mirl.machine.copy.move.Part;
use mirl.machine.copy.move.Parts;
use mirl.machine.copy.move.Table;
use mirl.machine.select.rule.Holder;

use masc.core.quantity;
use riscv_register: masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;

val ADDED:  [3]Part = [3]Part{Part.to{}, Part.from{}, Part.literal{0}};
val SIGNED: [3]Part = [3]Part{Part.to{}, Part.from{}, Part.from{}};
val WHOLE:  [2]Part = [2]Part{Part.to{}, Part.from{}};

val ROWS: [8]Move = [8]Move{
    Move{to: Holder.hardware{riscv_register.X}, from: Holder.hardware{riscv_register.X}, bits: quantity.Scaled{fixed: 0, per: 32, scale: 0}, row: ?gen_row.ROWS[gen_row_index.ADDI], parts: Parts{at: ?ADDED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: quantity.Scaled{fixed: 32, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.FSGNJ_S], parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.FSGNJ_D], parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: quantity.Scaled{fixed: 128, per: 0, scale: 0}, row: ?gen_row.ROWS[gen_row_index.FSGNJ_Q], parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.V}, from: Holder.hardware{riscv_register.V}, bits: quantity.Scaled{fixed: 0, per: 32, scale: 2}, row: ?gen_row.ROWS[gen_row_index.VMV1R_V], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{riscv_register.VG2}, from: Holder.hardware{riscv_register.VG2}, bits: quantity.Scaled{fixed: 0, per: 64, scale: 2}, row: ?gen_row.ROWS[gen_row_index.VMV2R_V], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{riscv_register.VG4}, from: Holder.hardware{riscv_register.VG4}, bits: quantity.Scaled{fixed: 0, per: 128, scale: 2}, row: ?gen_row.ROWS[gen_row_index.VMV4R_V], parts: Parts{at: ?WHOLE[0], len: 2}},
    Move{to: Holder.hardware{riscv_register.VG8}, from: Holder.hardware{riscv_register.VG8}, bits: quantity.Scaled{fixed: 0, per: 256, scale: 2}, row: ?gen_row.ROWS[gen_row_index.VMV8R_V], parts: Parts{at: ?WHOLE[0], len: 2}},
};

# the RISC-V moves
pub val MOVES: Table = Table{moves: Moves{at: ?ROWS[0], len: 8}, swaps: Moves{at: nil, len: 0}};
