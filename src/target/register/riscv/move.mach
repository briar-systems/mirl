# the RISC-V moves: the whole value of one register into another of its class
#
# a general register moves by adding zero to it, at every width. a float
# register moves by taking its own sign, at the width its storage takes
# through the selection, so a selection of f, d or q admits the one row that
# moves all of it. a vector register moves whole. the set has no exchange of
# two registers, so it states no swap, and it states no move between classes,
# since no copy selection places is one.

use mirl.machine.copy.move.Move;
use mirl.machine.copy.move.Moves;
use mirl.machine.copy.move.Part;
use mirl.machine.copy.move.Parts;
use mirl.machine.copy.move.Table;
use mirl.machine.select.rule.Holder;

use rf: masc.core.register;
use masc.isa.riscv.gen_row;
use riscv_register: masc.isa.riscv.register;

val ADDED:  [3]Part = [3]Part{Part.to{}, Part.from{}, Part.literal{0}};
val SIGNED: [3]Part = [3]Part{Part.to{}, Part.from{}, Part.from{}};
val WHOLE:  [2]Part = [2]Part{Part.to{}, Part.from{}};

val ROWS: [5]Move = [5]Move{
    Move{to: Holder.hardware{riscv_register.X}, from: Holder.hardware{riscv_register.X}, bits: rf.Scaled{fixed: 0, per: 32, scale: 0}, row: gen_row.ADDI, parts: Parts{at: ?ADDED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: rf.Scaled{fixed: 32, per: 0, scale: 0}, row: gen_row.FSGNJ_S, parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: rf.Scaled{fixed: 64, per: 0, scale: 0}, row: gen_row.FSGNJ_D, parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.F}, from: Holder.hardware{riscv_register.F}, bits: rf.Scaled{fixed: 128, per: 0, scale: 0}, row: gen_row.FSGNJ_Q, parts: Parts{at: ?SIGNED[0], len: 3}},
    Move{to: Holder.hardware{riscv_register.V}, from: Holder.hardware{riscv_register.V}, bits: rf.Scaled{fixed: 0, per: 32, scale: 2}, row: gen_row.VMV1R_V, parts: Parts{at: ?WHOLE[0], len: 2}},
};

# the RISC-V moves
pub val MOVES: Table = Table{moves: Moves{at: ?ROWS[0], len: 5}, swaps: Moves{at: nil, len: 0}};
