# the risc-v target rows

use std.collections.slice.Slice;

use ir: mirl.ir.opcode;
use mirl.ir.type.format.BINARY16;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.target.abi.convention.Declared;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Model;
use mirl.target.address.Relocation;
use mirl.target.address.Threads;
use mirl.target.capability.Addressing;
use mirl.target.capability.Align;
use mirl.target.capability.Arithmetic;
use mirl.target.capability.Attributes;
use mirl.target.capability.Bits;
use mirl.target.capability.Bitwise;
use mirl.target.capability.Bulk;
use mirl.target.capability.BulkMemory;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Code;
use mirl.target.capability.Condition;
use mirl.target.capability.Constants;
use mirl.target.capability.Control;
use mirl.target.capability.Data;
use mirl.target.capability.Division;
use mirl.target.capability.Evaluation;
use mirl.target.capability.Fault;
use mirl.target.capability.Fill;
use mirl.target.capability.Fit;
use mirl.target.capability.FloatLayout;
use mirl.target.capability.Formats;
use mirl.target.capability.Functions;
use mirl.target.capability.Held;
use mirl.target.capability.IntegerLayout;
use mirl.target.capability.LongDivision;
use mirl.target.capability.Nans;
use mirl.target.capability.Native;
use mirl.target.capability.Natives;
use mirl.target.capability.Operation;
use mirl.target.capability.Part;
use mirl.target.capability.Pointer;
use mirl.target.capability.Product;
use mirl.target.capability.Products;
use mirl.target.capability.Registers;
use mirl.target.capability.Rules;
use mirl.target.capability.Scalar;
use mirl.target.capability.Set;
use mirl.target.capability.Shifts;
use mirl.target.capability.Sign;
use mirl.target.capability.Single;
use mirl.target.capability.Space;
use mirl.target.capability.Timed;
use mirl.target.capability.Timing;
use mirl.target.capability.Values;
use mirl.target.capability.VectorRule;
use mirl.target.capability.Vectors;
use mirl.target.capability.Widths;
use mirl.target.record.Baseline;
use mirl.target.record.Target;
use mirl.target.register.riscv.abi.ILP32;
use mirl.target.register.riscv.abi.ILP32D;
use mirl.target.register.riscv.abi.LP64;
use mirl.target.register.riscv.abi.LP64D;
use mirl.target.register.schema.SCHEMA;

# riscv64 under the lp64d psabi
val RV64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}, layout: Rules.c{}},
};
val RV64_ALU: [2]u32 = [2]u32{32, 64};
# and, or, xor and the unsigned compares on a condition held as 0 or 1, whose
# result is 0 or 1 again
val RISCV_BITS:    [4]Bitwise = [4]Bitwise{Bitwise.both{}, Bitwise.either{}, Bitwise.differ{}, Bitwise.compare{}};
val RV64_INTEGERS: [4]u32     = [4]u32{8, 16, 32, 64};
# the M extension's mulhu, mulh and mulhsu
val RV64_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 64},
};
# fmin and fmax of F and D give the other operand for one nan and order
# negative zero below positive zero. zfa adds fminm, fmaxm and fround. no
# instruction selects between floats or gives a remainder
val RISCV_NATIVES: [8]Native = [8]Native{
    Native{opcode: ir.FMINNUM, condition: Condition.always{}},
    Native{opcode: ir.FMAXNUM, condition: Condition.always{}},
    Native{opcode: ir.FMIN, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FMAX, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FFLOOR, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FCEIL, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FINT, condition: Condition.extension{"zfa"}},
    Native{opcode: ir.FNEAREST, condition: Condition.extension{"zfa"}},
};
# the F and D extensions, held where the build selects them, whose results are
# the canonical nan. a constant is made in a general register and moved
val RV64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.extension{"f"}, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: Condition.extension{"d"}, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
};
# zkt makes the M extension's multiplies data independent in latency
val RV64_TIMED: [5]Timed = [5]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply{}, width: 64, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply_high{}, width: 64, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
    Timed{operation: Operation.shift{}, width: 64, condition: Condition.always{}},
};
# c.unimp, so padding traps
val RV64_FILL: [2]u8 = [2]u8{0, 0};
# the lp64 widths of the risc-v elf psabi
val RV64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 16}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# riscv32 under the ilp32d psabi
val RV32_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 4, align: 4}}, layout: Rules.c{}},
};
val RV32_ALU:      [1]u32     = [1]u32{32};
val RV32_INTEGERS: [3]u32     = [3]u32{8, 16, 32};
val RV32_PRODUCTS: [3]Product = [3]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 32},
    Product{part: Part.high{}, sign: Sign.mixed{}, width: 32},
};
# the F and D extensions, held where the build selects them, whose results are
# the canonical nan. a general register holds a binary32 constant's bits to move, and a binary64 one is
# loaded from read-only data
val RV32_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.extension{"f"}, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: Condition.extension{"d"}, nans: Nans.canonical{}, natives: Natives.rows{Slice[Native]{data: ?RISCV_NATIVES[0], size: 8}}, constants: Constants.loaded{}},
};
# zkt makes the M extension's multiplies data independent in latency
val RV32_TIMED: [3]Timed = [3]Timed{
    Timed{operation: Operation.multiply{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.multiply_high{}, width: 32, condition: Condition.extension{"zkt"}},
    Timed{operation: Operation.shift{}, width: 32, condition: Condition.always{}},
};
# c.unimp, so padding traps
val RV32_FILL: [2]u8 = [2]u8{0, 0};
# the ilp32 widths of the risc-v elf psabi, with the c _BitInt widths of clang above 64 bits
val RV32_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 8, scalar: Scalar{size: 1, align: 1}},
    IntegerLayout{width: 16, scalar: Scalar{size: 2, align: 2}},
    IntegerLayout{width: 32, scalar: Scalar{size: 4, align: 4}},
    IntegerLayout{width: 64, scalar: Scalar{size: 8, align: 8}},
    IntegerLayout{width: 128, scalar: Scalar{size: 16, align: 8}},
    IntegerLayout{width: 256, scalar: Scalar{size: 32, align: 8}},
    IntegerLayout{width: 512, scalar: Scalar{size: 64, align: 8}},
};
val RV32_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, scalar: Scalar{size: 2, align: 2}},
    FloatLayout{format: ?BINARY32, scalar: Scalar{size: 4, align: 4}},
    FloatLayout{format: ?BINARY64, scalar: Scalar{size: 8, align: 8}},
};

# risc-v linux code is position independent at either xlen, and a variable of
# a module loaded at any time is reached as one of any module, since the
# psabi's local dynamic sequence saves only a lookup the general one makes
val RISCV_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.general_dynamic{},
        local_dynamic:   Access.general_dynamic{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
    },
};

# the riscv64 widths, arithmetic, timing and code every float abi shares
val RV64_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?RV64_POINTERS[0], size: 1},
    register: Bits.bits{64},
    alu:      Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    integers: Set.widths{Slice[u32]{data: ?RV64_INTEGERS[0], size: 4}},
};
val RV64_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    multiplied: Condition.extension{"zmmul"},
    products:   Products.forms{Slice[Product]{data: ?RV64_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV64_ALU[0], size: 2}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    # the M extension's div and rem give all ones and the dividend for a zero
    # divisor, and the dividend for an overflowing quotient
    division: Division{widths: Set.widths{Slice[u32]{data: ?RV64_ALU[0], size: 2}}, condition: Condition.extension{"m"}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV64_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV64_FILL[0], size: 2}},
};

# riscv64, which computes in binary32 and binary64 where the build selects
# the F and D extensions, and in software where it does not
val RV64_CAPS: Capabilities = Capabilities{
    registers:  Registers.allocated{},
    control:    Control.free{},
    addressing: Addressing.physical{},
    functions:  Functions.addresses{},
    values:     Values.untyped{},
    evaluation: Evaluation.register{},
    widths:     RV64_WIDTHS,
    vectors:    Vectors.none{},
    formats:    Formats.held{Slice[Held]{data: ?RV64_HELD[0], size: 2}},
    arithmetic: RV64_ARITHMETIC,
    bulk:       BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}},
    timing:     Timing.rows{Slice[Timed]{data: ?RV64_TIMED[0], size: 5}},
    code:       RV64_CODE,
    attributes: Attributes.schema{?SCHEMA},
};

# the lp64 data of the psabi, the same under every float abi
val RV64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, widest: 128}},
};

# riscv64 linux, rv64gc under the lp64d psabi
pub val RV64_LINUX: Target = Target{
    arch:       "riscv64",
    system:     "linux",
    caps:       RV64_CAPS,
    data:       RV64_DATA,
    convention: Declared.row{?LP64D},
    baseline:   Baseline.extensions{"rv64gc"},
    addresses:  Addresses.model{RISCV_LINUX_ADDRESSES},
};

# riscv64 freestanding under the lp64d psabi with no system. its floor is
# the least lp64d needs, the double float registers and nothing else
pub val RV64_FREESTANDING: Target = Target{
    arch:       "riscv64",
    system:     "freestanding",
    caps:       RV64_CAPS,
    data:       RV64_DATA,
    convention: Declared.row{?LP64D},
    baseline:   Baseline.extensions{"rv64ifd"},
    addresses:  Addresses.uncarried{},
};

# riscv64 freestanding with soft float, rv64imac under the lp64 psabi
pub val RV64IMAC_FREESTANDING: Target = Target{
    arch:       "riscv64",
    system:     "freestanding",
    caps:       RV64_CAPS,
    data:       RV64_DATA,
    convention: Declared.row{?LP64},
    baseline:   Baseline.extensions{"rv64imac"},
    addresses:  Addresses.uncarried{},
};

# the riscv32 widths, arithmetic, timing and code every float abi shares
val RV32_WIDTHS: Widths = Widths{
    pointers: Slice[Space]{data: ?RV32_POINTERS[0], size: 1},
    register: Bits.bits{32},
    alu:      Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    integers: Set.widths{Slice[u32]{data: ?RV32_INTEGERS[0], size: 3}},
};
val RV32_ARITHMETIC: Arithmetic = Arithmetic{
    multiply:   Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    multiplied: Condition.extension{"zmmul"},
    products:   Products.forms{Slice[Product]{data: ?RV32_PRODUCTS[0], size: 3}},
    shifts:     Shifts.wraps{Slice[u32]{data: ?RV32_ALU[0], size: 1}},
    single:     Single.operations{Slice[Bitwise]{data: ?RISCV_BITS[0], size: 4}},
    division:   Division{widths: Set.widths{Slice[u32]{data: ?RV32_ALU[0], size: 1}}, condition: Condition.extension{"m"}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
};
val RV32_CODE: Code = Code{
    function: Align.bytes{2},
    text:     Align.bytes{16},
    data:     Align.bytes{8},
    fill:     Fill.pattern{Slice[u8]{data: ?RV32_FILL[0], size: 2}},
};

# riscv32, which computes in binary32 and binary64 where the build selects
# the F and D extensions, and in software where it does not
val RV32_CAPS: Capabilities = Capabilities{
    registers:  Registers.allocated{},
    control:    Control.free{},
    addressing: Addressing.physical{},
    functions:  Functions.addresses{},
    values:     Values.untyped{},
    evaluation: Evaluation.register{},
    widths:     RV32_WIDTHS,
    vectors:    Vectors.none{},
    formats:    Formats.held{Slice[Held]{data: ?RV32_HELD[0], size: 2}},
    arithmetic: RV32_ARITHMETIC,
    bulk:       BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}},
    timing:     Timing.rows{Slice[Timed]{data: ?RV32_TIMED[0], size: 3}},
    code:       RV32_CODE,
    attributes: Attributes.schema{?SCHEMA},
};

# the ilp32 data of the psabi, the same under every float abi
val RV32_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?RV32_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?RV32_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, widest: 128}},
};

# riscv32 linux, rv32gc under the ilp32d psabi
pub val RV32_LINUX: Target = Target{
    arch:       "riscv32",
    system:     "linux",
    caps:       RV32_CAPS,
    data:       RV32_DATA,
    convention: Declared.row{?ILP32D},
    baseline:   Baseline.extensions{"rv32gc"},
    addresses:  Addresses.model{RISCV_LINUX_ADDRESSES},
};

# riscv32 freestanding with soft float under the ilp32 psabi with no system.
# its floor is the least ilp32 needs, the base integer set and nothing else
pub val RV32_FREESTANDING: Target = Target{
    arch:       "riscv32",
    system:     "freestanding",
    caps:       RV32_CAPS,
    data:       RV32_DATA,
    convention: Declared.row{?ILP32},
    baseline:   Baseline.extensions{"rv32i"},
    addresses:  Addresses.uncarried{},
};

# riscv32 freestanding with soft float, rv32imac under the ilp32 psabi
pub val RV32IMAC_FREESTANDING: Target = Target{
    arch:       "riscv32",
    system:     "freestanding",
    caps:       RV32_CAPS,
    data:       RV32_DATA,
    convention: Declared.row{?ILP32},
    baseline:   Baseline.extensions{"rv32imac"},
    addresses:  Addresses.uncarried{},
};
