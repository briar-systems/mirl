# the guards and derived immediates the RISC-V table's rules need beyond a type test
#
# a hook reads the values of instructions the verifier accepted, so a read the
# module or its type table refuses means a corrupted module, and the hook then
# says its guard does not hold. the engine names the instruction unmatched.
# the register width is read from the target's declarations and never from its
# name, and every fact about an operand is read through the match. a rule's
# register width is its type tests', so a hook states only what a test cannot.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use mirl.ir.type.table;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.capability.Bits;
use mirl.target.capability.Set;

use masc.core.effect;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;

fun register(mt: *Match) u32 {
    val b: Bits = mt.target.caps.widths.register;
    if (sel b.bits) { ret b.bits; }
    ret 0;
}

# the register is 64 bits wide
fun xlen64(mt: *Match) bool {
    ret register(mt) == 64;
}

# the register is 32 bits wide
fun xlen32(mt: *Match) bool {
    ret register(mt) == 32;
}

# whether an operand is an integer constant of any width equal to n
fun operand_is(mt: *Match, node: u8, index: u8, n: u64) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret false; }
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, opt_operand.some);
    if (sel res_constant.err)                { ret false; }
    if (sel res_constant.ok.none)            { ret false; }
    if (!(sel res_constant.ok.some.integer)) { ret false; }
    val words: Slice[u64] = res_constant.ok.some.integer.words;
    if (words.size == 0 || words.data[0] != n) { ret false; }
    var k: usize = 1;
    for (k < words.size) {
        if (words.data[k] != 0) { ret false; }
        k = k + 1;
    }
    ret true;
}

# the shift of a high multiply takes the product down by the register width
pub fun high(mt: *Match) bool {
    ret operand_is(mt, 1, 1, register(mt)::u64);
}

# the shift's count is below its operand's width, which the bounding marks
pub fun bounded(mt: *Match) bool {
    ret match.bounded(mt, 0);
}

# the bits of an integer type, zero for any other type
fun width_of(mt: *Match, v: id.Value) u32 {
    val res_shape: res[table.Shape, table.Error] = match.shape(mt, v);
    if (sel res_shape.err)           { ret 0; }
    if (!(sel res_shape.ok.integer)) { ret 0; }
    ret res_shape.ok.integer.width;
}

fun operand_width(mt: *Match, node: u8, index: u8) u32 {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret 0; }
    ret width_of(mt, opt_operand.some);
}

fun result_width(mt: *Match, node: u8, index: u8) u32 {
    val opt_result: opt[id.Value] = match.result(mt, Slot{node: node, index: index});
    if (sel opt_result.none) { ret 0; }
    ret width_of(mt, opt_result.some);
}

fun bits_of(mt: *Match, v: id.Value) opt[i64] {
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, v);
    if (sel res_bits.err) { ret opt[i64].none{}; }
    ret res_bits.ok;
}

# the bits of the constant an operand is, none when it is not one
fun operand_bits(mt: *Match, node: u8, index: u8) opt[i64] {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret opt[i64].none{}; }
    ret bits_of(mt, opt_operand.some);
}

# the bits of the constant a materialisation rule builds
fun subject_bits(mt: *Match) opt[i64] {
    ret bits_of(mt, mt.subject);
}

fun subject_width(mt: *Match) u32 {
    ret width_of(mt, mt.subject);
}

fun one_bit(x: u64) bool {
    ret x != 0 && (x & (x - 1)) == 0;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# whether an immediate position of twelve signed bits takes a value
fun fits12(c: i64) bool {
    ret c >= -2048 && c <= 2047;
}

# the register holds an integer operand 0 of 1 to 64 bits at most as wide as itself
pub fun narrow0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 1 && w <= register(mt);
}

pub fun narrow1(mt: *Match) bool {
    val w: u32 = operand_width(mt, 1, 0);
    ret w >= 1 && w <= register(mt);
}

# operand 0 is an integer of 2 bits or more that the register holds, which excludes a condition
pub fun narrow_word0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 2 && w <= register(mt);
}

pub fun narrow_word1(mt: *Match) bool {
    val w: u32 = operand_width(mt, 1, 0);
    ret w >= 2 && w <= register(mt);
}

# operand 0 is an integer of 2 to 32 bits
pub fun word0(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 2 && w <= 32;
}

# the result is an integer the register holds
pub fun result_narrow(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w <= register(mt);
}

# the bits of the word the field loops reserve, the one access of lr.w's
# row, none when the row states no single access of a fixed width
fun reserved() u32 {
    val e: *effect.Effect = gen_row.ROWS[gen_row_index.LR_W].effect;
    if (e == nil || e.memory.len != 1) { ret 0; }
    val w: effect.Width = e.memory.at[0].width;
    if (!(sel w.count.one) || w.element.per != 0) { ret 0; }
    ret w.element.fixed;
}

# whether the target states an integer width a value holds natively
fun stated(mt: *Match, w: u32) bool {
    val set: Set = mt.target.caps.widths.integers;
    if (!(sel set.widths)) { ret false; }
    var k: usize = 0;
    for (k < set.widths.size) {
        if (set.widths.data[k] == w) { ret true; }
        k = k + 1;
    }
    ret false;
}

# the result is a field of the word the reserved pair holds: an integer of
# a width the target states, narrower than that word
pub fun field(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w < reserved() && stated(mt, w);
}

# a sign extension of a value that is not a condition
pub fun ext_s_copy(mt: *Match) bool {
    ret operand_width(mt, 0, 0) >= 2 && result_narrow(mt);
}

# the offset of an address is a register or a 32 bit integer sign extended in one
pub fun offset(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 1);
    ret w == register(mt) || w == 32;
}

pub fun mul_pow2(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some > 0 && one_bit(opt_operand_bits.some::u64) && trailing(opt_operand_bits.some::u64) < operand_width(mt, 0, 0)::i64;
}

# a constant of a power of two and one, above three
pub fun mul_pow2_plus(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some > 3 && one_bit((opt_operand_bits.some - 1)::u64) && trailing((opt_operand_bits.some - 1)::u64) < operand_width(mt, 0, 0)::i64;
}

# a constant of a power of two less one, and not one a power of two and one
pub fun mul_pow2_minus(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some > 1 && one_bit((opt_operand_bits.some + 1)::u64) && !one_bit((opt_operand_bits.some - 1)::u64) && trailing((opt_operand_bits.some + 1)::u64) < operand_width(mt, 0, 0)::i64;
}

fun mul_by(mt: *Match, k: i64) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some == k;
}

fun shift_by(mt: *Match, k: i64) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 1, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some == k;
}

# an add of a value shifted left by 1, 2 or 3, or a multiply by 3, 5 or 9,
# which one shift-add of zba computes
pub fun shadd1(mt: *Match) bool {
    ret shift_by(mt, 1);
}

pub fun shadd2(mt: *Match) bool {
    ret shift_by(mt, 2);
}

pub fun shadd3(mt: *Match) bool {
    ret shift_by(mt, 3);
}

pub fun mul_3(mt: *Match) bool {
    ret mul_by(mt, 3);
}

pub fun mul_5(mt: *Match) bool {
    ret mul_by(mt, 5);
}

pub fun mul_9(mt: *Match) bool {
    ret mul_by(mt, 9);
}

pub fun single_bit(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret one_bit(opt_operand_bits.some::u64) && !fits12(opt_operand_bits.some) && trailing(opt_operand_bits.some::u64) < register(mt)::i64;
}

pub fun single_clear(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret one_bit((~opt_operand_bits.some)::u64) && !fits12(opt_operand_bits.some) && trailing((~opt_operand_bits.some)::u64) < register(mt)::i64;
}

pub fun bit_test(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some == 1;
}

# two shifts of one value that together turn it round its width
pub fun rotate(mt: *Match) bool {
    val opt_operand:      opt[id.Value] = match.operand(mt, Slot{node: 1, index: 0});
    val opt_operand_slot: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 0});
    if (sel opt_operand.none)      { ret false; }
    if (sel opt_operand_slot.none) { ret false; }
    val x: id.Value = opt_operand.some;
    val y: id.Value = opt_operand_slot.some;
    if (x != y) { ret false; }
    val opt_operand_bits: opt[i64] = operand_bits(mt, 1, 1);
    val opt_i64:          opt[i64] = operand_bits(mt, 2, 1);
    if (sel opt_operand_bits.none) { ret false; }
    if (sel opt_i64.none)          { ret false; }
    val left:  i64 = opt_operand_bits.some;
    val right: i64 = opt_i64.some;
    ret left > 0 && right > 0 && left + right == operand_width(mt, 1, 0)::i64;
}

# constants: a number fits the immediate of a twelve bit add when its row says so, so
# these only choose among the longer sequences

fun fits32(c: i64) bool {
    ret c >= -2147483648 && c <= 2147483647;
}

# the offset an address constant lies past its symbol fits a word, which an
# upper immediate and an add build on a 64 or a 32 bit register
fun offset_word(mt: *Match) bool {
    val res_offset: res[opt[i64], match.Error] = match.offset(mt);
    if (sel res_offset.err)     { ret false; }
    if (sel res_offset.ok.none) { ret false; }
    ret fits32(res_offset.ok.some);
}

pub fun offset_word_64(mt: *Match) bool {
    ret xlen64(mt) && offset_word(mt);
}

pub fun offset_word_32(mt: *Match) bool {
    ret xlen32(mt) && offset_word(mt);
}

# the offset is built a word at a time, on a 64 bit register
pub fun offset_wide_64(mt: *Match) bool {
    ret xlen64(mt);
}

# the constant is an integer wider than a condition
pub fun const_not_bit(mt: *Match) bool {
    ret subject_width(mt) > 1;
}

# a nonzero constant a single upper immediate builds
pub fun const_lui(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret subject_width(mt) > 1 && opt_subject_bits.some != 0 && (opt_subject_bits.some & 0xfff) == 0 && fits32(opt_subject_bits.some);
}

pub fun const_i32_64(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret xlen64(mt) && subject_width(mt) > 1 && fits32(opt_subject_bits.some);
}

pub fun const_i32_32(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret xlen32(mt) && subject_width(mt) > 1 && fits32(opt_subject_bits.some);
}

pub fun const_wide_64(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret xlen64(mt) && subject_width(mt) != 1;
}

pub fun const_zero(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret opt_subject_bits.some == 0;
}

fun fits_u32(c: i64) bool {
    ret c >= 0 && c <= 4294967295;
}

pub fun const_float_lui(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret opt_subject_bits.some != 0 && fits_u32(opt_subject_bits.some) && (opt_subject_bits.some & 0xfff) == 0;
}

pub fun const_float_u32_64(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret xlen64(mt) && fits_u32(opt_subject_bits.some);
}

pub fun const_float_u32_32(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    ret xlen32(mt) && fits_u32(opt_subject_bits.some);
}

# the immediates a constant splits into
# ---
# lo12: the low twelve bits as a signed immediate
# hi20: the upper twenty bits that, with the signed low twelve, rebuild the low thirty two bits

pub fun negate(c: i64) i64 {
    ret 0 - c;
}

pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

pub fun log2_of(c: i64) i64 {
    ret trailing(c::u64);
}

pub fun log2_below(c: i64) i64 {
    ret trailing((c - 1)::u64);
}

pub fun log2_above(c: i64) i64 {
    ret trailing((c + 1)::u64);
}

pub fun log2_of_not(c: i64) i64 {
    ret trailing((~c)::u64);
}

pub fun same(c: i64) i64 {
    ret c;
}

pub fun lo12(c: i64) i64 {
    val l: i64 = c & 0xfff;
    if (l >= 0x800) { ret l - 0x1000; }
    ret l;
}

pub fun hi20(c: i64) i64 {
    ret ((c - lo12(c)) >> 12) & 0xfffff;
}

# the low thirty two bits of a number, sign extended
fun low_word(c: i64) i64 {
    val l: i64 = c & 0xffffffff;
    if (l >= 0x80000000) { ret l - 0x100000000; }
    ret l;
}

# the number above its low word, as a word
fun high_word(c: i64) i64 {
    ret (c - low_word(c)) >> 32;
}

pub fun lo_lo12(c: i64) i64 {
    ret lo12(low_word(c));
}

pub fun lo_hi20(c: i64) i64 {
    ret hi20(low_word(c));
}

pub fun hi_lo12(c: i64) i64 {
    ret lo12(high_word(c));
}

pub fun hi_hi20(c: i64) i64 {
    ret hi20(high_word(c));
}

# how the target's model reaches the link-time address a rule builds, the
# constant of a materialisation or the function's address of a func.addr,
# none for a value that is no address or a target with no model
fun reached(mt: *Match) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val opt_built: opt[id.Value] = match.built(mt);
    if (sel opt_built.none) { ret opt[Reach].none{}; }
    val res_address: res[opt[Address], match.Error] = match.address(mt, opt_built.some);
    if (sel res_address.err)     { ret opt[Reach].none{}; }
    if (sel res_address.ok.none) { ret opt[Reach].none{}; }
    val at: id.Symbol = res_address.ok.some.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# the address is reached absolutely
pub fun absolute(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.absolute;
}

# the address is reached by its distance from the code
pub fun relative(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.relative;
}

# the address is loaded from the global offset table, on a 64 or 32 bit register
pub fun table_64(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.table && xlen64(mt);
}

pub fun table_32(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.table && xlen32(mt);
}

# a switch whose cases index a table of its targets, under the target's
# relocation model: a table is the function's own and never preempted, so
# it is reached absolutely under static and by its distance otherwise, near
# among them
fun indexed(mt: *Match, relative: bool) bool {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret false; }
    if (!match.indexed(mt)) { ret false; }
    ret (sel model.model.relocation.static) != relative;
}

# a jump table of 64 or 32 bit entries reached absolutely
pub fun table_absolute_64(mt: *Match) bool {
    ret indexed(mt, false) && xlen64(mt);
}

pub fun table_absolute_32(mt: *Match) bool {
    ret indexed(mt, false) && xlen32(mt);
}

# a jump table of 64 or 32 bit entries reached by its distance from the code
pub fun table_relative_64(mt: *Match) bool {
    ret indexed(mt, true) && xlen64(mt);
}

pub fun table_relative_32(mt: *Match) bool {
    ret indexed(mt, true) && xlen32(mt);
}

fun thread(mt: *Match) opt[Access] {
    val opt_reached: opt[Reach] = reached(mt);
    if (sel opt_reached.none)           { ret opt[Access].none{}; }
    if (!(sel opt_reached.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{opt_reached.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.local_exec;
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec_64(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.initial_exec && xlen64(mt);
}

pub fun initial_exec_32(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.initial_exec && xlen32(mt);
}

# a thread-local variable reached through the runtime's lookup
pub fun general_dynamic(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.general_dynamic;
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel opt_operand.none) { ret false; }
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, opt_operand.some);
    ret sel res_constant.ok && sel res_constant.ok.none;
}
