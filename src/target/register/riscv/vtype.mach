# how risc-v establishes its vector type
#
# a vector instruction's register groups follow the vtype in force, which
# vsetvli sets to the vtype its immediate encodes, masc's configuration state.
# the configure stage writes `vsetvli rd, x0, vtype` with rd a free register,
# which sets vl to vlmax for the new vtype and writes it to rd (unprivileged
# spec, chapter "Vector Extension", section "vsetvli/vsetivli/vsetvl
# instructions": rs1 = x0 with rd != x0 sets vl to vlmax).

use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;

use mirl.machine.configure.Part;
use mirl.machine.configure.Parts;
use mirl.machine.configure.StateRules;

val PARTS: [3]Part = [3]Part{Part.scratch{}, Part.fixed{gen_register.X0}, Part.state{}};

# vsetvli with a scratch destination, x0 as its requested length and the
# vtype as its immediate
pub val STATE: StateRules = StateRules{row: gen_row.VSETVLI, parts: Parts{at: ?PARTS[0], len: 3}};
