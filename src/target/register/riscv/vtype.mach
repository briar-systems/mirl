# how risc-v establishes its vector type and vector length
#
# a vector instruction's register groups follow the vtype in force and it
# runs over the vl in force, which vsetivli, vsetvli and vsetvl set, together
# masc's configuration state (`masc.isa.riscv.config`). the configure stage
# writes `vsetivli x0, n, vtype` for a length that fits its five bits,
# `addi t, x0, n` and `vsetvli x0, t, vtype` for a longer one, and
# `vsetvli t, x0, vtype` for vlmax, t a free register (unprivileged spec,
# chapter "Vector Extension", section "vsetvli/vsetivli/vsetvl instructions":
# rs1 = x0 with rd != x0 sets vl to vlmax).

use std.types.bool.bool;

use riscv_config: masc.isa.riscv.config;
use masc.isa.riscv.gen_register;
use masc.isa.riscv.gen_row;
use masc.isa.riscv.gen_row_index;

use mirl.machine.configure.Form;
use mirl.machine.configure.Part;
use mirl.machine.configure.Parts;
use mirl.machine.configure.StateRules;
use mirl.machine.configure.Step;
use mirl.machine.configure.Steps;
use mirl.machine.vstate;

# the most vsetivli's unsigned five bits hold, and the most addi's twelve
# signed bits hold
val SHORT: u64 = 31;
val LONG:  u64 = 2047;

# the vtype immediate of state `st`
fun vtype_of(st: vstate.State) i64 {
    ret riscv_config.vtype(st.config):~i64;
}

# the vector length of state `st`, 0 for vlmax
fun length_of(st: vstate.State) i64 {
    ret riscv_config.length(st.config):~i64;
}

# whether state `st` names a length vsetivli's immediate holds
fun short(st: vstate.State) bool {
    val n: u64 = riscv_config.length(st.config);
    ret n != 0 && n <= SHORT;
}

# whether state `st` names a length past vsetivli's immediate that addi's holds
fun long(st: vstate.State) bool {
    val n: u64 = riscv_config.length(st.config);
    ret n > SHORT && n <= LONG;
}

# whether state `st` asks for vlmax
fun most(st: vstate.State) bool {
    ret riscv_config.length(st.config) == 0;
}

# vsetivli orders its operands by its encoding's fields, the vtype before the
# length
val SHORT_PARTS: [3]Part = [3]Part{Part.fixed{gen_register.X0}, Part.field{vtype_of}, Part.field{length_of}};
val COUNT_PARTS: [3]Part = [3]Part{Part.scratch{0}, Part.fixed{gen_register.X0}, Part.field{length_of}};
val LONG_PARTS:  [3]Part = [3]Part{Part.fixed{gen_register.X0}, Part.scratch{0}, Part.field{vtype_of}};
val MOST_PARTS:  [3]Part = [3]Part{Part.scratch{0}, Part.fixed{gen_register.X0}, Part.field{vtype_of}};

val SHORT_STEPS: [1]Step = [1]Step{Step{row: ?gen_row.ROWS[gen_row_index.VSETIVLI], parts: Parts{at: ?SHORT_PARTS[0], len: 3}}};
val LONG_STEPS:  [2]Step = [2]Step{Step{row: ?gen_row.ROWS[gen_row_index.ADDI], parts: Parts{at: ?COUNT_PARTS[0], len: 3}}, Step{row: ?gen_row.ROWS[gen_row_index.VSETVLI], parts: Parts{at: ?LONG_PARTS[0], len: 3}}};
val MOST_STEPS:  [1]Step = [1]Step{Step{row: ?gen_row.ROWS[gen_row_index.VSETVLI], parts: Parts{at: ?MOST_PARTS[0], len: 3}}};

val FORMS: [3]Form = [3]Form{
    Form{fits: short, steps: Steps{at: ?SHORT_STEPS[0], len: 1}},
    Form{fits: long, steps: Steps{at: ?LONG_STEPS[0], len: 2}},
    Form{fits: most, steps: Steps{at: ?MOST_STEPS[0], len: 1}},
};

# how the configure stage establishes a vector state: the first form whose
# length fits, vsetivli, addi and vsetvli, or vsetvli for vlmax
pub val STATE: StateRules = StateRules{at: ?FORMS[0], len: 3};
