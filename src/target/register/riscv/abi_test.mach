# the target whose calls are made under lp64d
fun lp64d(t: *Target) bool {
    ret sel t.convention.rows && t.convention.rows.default == ?LP64D;
}

# the target whose calls are made under ilp32d
fun ilp32d(t: *Target) bool {
    ret sel t.convention.rows && t.convention.rows.default == ?ILP32D;
}

val I1:   u32 = 0;
val I8:   u32 = 1;
val I16:  u32 = 2;
val I32:  u32 = 3;
val I64:  u32 = 4;
val I128: u32 = 5;
val I256: u32 = 6;
val F16:  u32 = 7;
val F32:  u32 = 8;
val F64:  u32 = 9;
val PTR:  u32 = 10;
val DD:   u32 = 11;
val FI:   u32 = 12;
val ID:   u32 = 13;
val C3:   u32 = 14;
val LL:   u32 = 15;
val LLL:  u32 = 16;
val NEST: u32 = 17;
val FU:   u32 = 18;
val DF:   u32 = 19;
val FQ:   u32 = 20;
val V4I:  u32 = 21;
val V8I:  u32 = 22;
val FP:   u32 = 23;
val E:    u32 = 24;
val FEF:  u32 = 25;
val DC:   u32 = 26;
val HH:   u32 = 27;
val FFF:  u32 = 28;
val F1:   u32 = 29;
val POOL: u32 = 30;

# no result, or every argument named
val NONE: u32 = 0xffff_ffff;

# one expected piece
# ---
# reg:    the register it travels in, by its abi name, nil for the stack
# stack:  its stack offset when reg is nil
# offset: its offset in its value
# size:   its bytes
# fill:   how its place is filled past it
rec Want {
    reg:    str;
    stack:  u64;
    offset: u64;
    size:   u64;
    fill:   Fill;
}

# one call and what clang does with it under one row
# ---
# row:     the row, whose cases run on the machine of a target whose row has
#          its word
# source:  the c declaration clang classified, its struct types as named below
# args:    the argument types, as pool codes
# count:   how many arguments
# result:  the result type, NONE for void
# named:   how many arguments are named, NONE for all
# refs:    the values passed by reference, bit i for argument i and bit 31 for
#          the result
# pieces:  how many pieces the call has, its wants following the cases
#          before it in WANT, results' pieces first
# address: the register an indirect result's address travels in, nil for none
rec Case {
    row:     *Convention;
    source:  str;
    args:    [12]u32;
    count:   u32;
    result:  u32;
    named:   u32;
    refs:    u32;
    pieces:  u32;
    address: str;
}

fun r(reg: str, offset: u64, size: u64, fill: Fill) Want {
    ret Want{reg: reg, stack: 0, offset: offset, size: size, fill: fill};
}

fun s(stack: u64, offset: u64, size: u64, fill: Fill) Want {
    ret Want{reg: nil, stack: stack, offset: offset, size: size, fill: fill};
}

def Wants: [540]Want;

