def Cases: [147]Case;

# the golden table, from clang 23.1.1 -O1 -S and -emit-llvm over one c function
# per case: a callee storing each argument to a volatile global, read from the
# registers and stack slots it loads, or a caller of an external variadic
# function, read from the registers it sets, and the extension of each value
# read from the attributes the ir states. the lp64d cases ran under
# --target=riscv64-linux-gnu -march=rv64gc -mabi=lp64d. the other rows ran every
# function of one file under -mabi=<row>, with riscv64-linux-gnu and rv64gc for
# lp64 and lp64f and riscv32-linux-gnu and rv32gc for the ilp32 rows. the struct
# types are
#   dd { double a, b; }  fi { float f; int i; }  id { int i; double d; }
#   c3 { char c[3]; }  ll { int64_t a, b; }  lll { int64_t a, b, c; }
#   nest { struct { float f[1]; } g[2]; }  union fu { float f; int i; }
#   df { double d; float f; }  fq { float f; __int128 q; }
#   v4i int vector_size(16)  v8i int vector_size(32)  fp { float f; void *p; }
#   e { }  fef { float f; struct e e; float g; }  dc { double d; char c; }
#   hh { _Float16 h, k; }  fff { float a, b, c; }  f1 { float f; }
# and long is int64_t in the lp64d cases
val CASES: Cases = [147]Case{
