# the lanes of a vector: how many and the bits of each, zero for a value
# that is no vector
rec Lanes {
    count: u32;
    bits:  u32;
}

fun lanes_of(mt: *Match, v: opt[id.Value]) Lanes {
    val none: Lanes = Lanes{count: 0, bits: 0};
    if (sel v.none) { ret none; }
    val res_shape: res[table.Shape, table.Error] = match.shape(mt, v.some);
    if (sel res_shape.err) { ret none; }
    val sh: table.Shape = res_shape.ok;
    if (!(sel sh.vector)) { ret none; }
    val res_shape_types: res[table.Shape, table.Error] = table.shape(?mt.module.types, sh.vector.element);
    if (sel res_shape_types.err) { ret none; }
    val es:   table.Shape = res_shape_types.ok;
    var bits: u32         = 0;
    if (sel es.integer) { bits = es.integer.width; }
    or (sel es.float) {
        val opt_row: opt[format.Row] = format.row(es.float.format);
        if (sel opt_row.none) { ret none; }
        bits = opt_row.some.width;
    }
    ret Lanes{count: sh.vector.lanes, bits: bits};
}

fun result_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.result(mt, Slot{node: 0, index: 0}));
}

fun operand_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
}

# the vector a store writes, its second operand
fun stored_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.operand(mt, Slot{node: 0, index: 1}));
}

fun immediate(x: u64) opt[i64] {
    ret opt[i64].some{x:~i64};
}

fun count_of(l: Lanes) opt[i64] {
    if (l.count == 0) { ret opt[i64].none{}; }
    ret immediate(l.count::u64);
}

fun bytes_of(l: Lanes) opt[i64] {
    if (l.count == 0 || l.bits % 8 != 0) { ret opt[i64].none{}; }
    ret immediate(l.count::u64 * l.bits::u64 / 8);
}

# the vector length a rule runs at: the lanes of the vector the root gives,
# reads or stores, or its bytes for a load or a store of bytes
pub fun result_count(mt: *Match) opt[i64] {
    ret count_of(result_lanes(mt));
}

# the lane count of the vector the root reads
# ---
# mt:  the match the immediate is computed from
# ret: the lanes of operand 0, none for a value that is no vector
pub fun operand_count(mt: *Match) opt[i64] {
    ret count_of(operand_lanes(mt));
}

# the lane count of the vector a store writes
# ---
# mt:  the match the immediate is computed from
# ret: the lanes of operand 1, none for a value that is no vector
pub fun stored_count(mt: *Match) opt[i64] {
    ret count_of(stored_lanes(mt));
}

# the bytes of the vector a load gives, the length of a load of bytes
# ---
# mt:  the match the immediate is computed from
# ret: the bytes of the result, none for a value that is no vector or whose
#      lanes are not whole bytes
pub fun result_bytes(mt: *Match) opt[i64] {
    ret bytes_of(result_lanes(mt));
}

# the bytes of the vector a store writes, the length of a store of bytes
# ---
# mt:  the match the immediate is computed from
# ret: the bytes of operand 1, none for a value that is no vector or whose
#      lanes are not whole bytes
pub fun stored_bytes(mt: *Match) opt[i64] {
    ret bytes_of(stored_lanes(mt));
}

# the lane the root names
fun lane_of(mt: *Match) opt[u32] {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lane) { ret opt[u32].some{imm.lane}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the lane, the offset of a slide
pub fun lane(mt: *Match) opt[i64] {
    val opt_lane_of: opt[u32] = lane_of(mt);
    if (sel opt_lane_of.none) { ret opt[i64].none{}; }
    ret immediate(opt_lane_of.some::u64);
}

# the lane plus one, the vector length an insert writes up to
pub fun lane_after(mt: *Match) opt[i64] {
    val opt_lane_of: opt[u32] = lane_of(mt);
    if (sel opt_lane_of.none) { ret opt[i64].none{}; }
    ret immediate(opt_lane_of.some::u64 + 1);
}

# the root names lane 0
pub fun lane_zero(mt: *Match) bool {
    val opt_lane_of: opt[u32] = lane_of(mt);
    ret sel opt_lane_of.some && opt_lane_of.some == 0;
}

# the root reduces a vector of one lane, or of more
pub fun single(mt: *Match) bool {
    ret operand_lanes(mt).count == 1;
}

# the root reduces a vector of more than one lane
# ---
# mt:  the match the guard reads
# ret: whether the guard holds
pub fun several(mt: *Match) bool {
    ret operand_lanes(mt).count > 1;
}

# the alignment the root's access states, zero where it states none
fun alignment(mt: *Match) u64 {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.alignment) { ret imm.alignment; }
        i = i + 1;
    }
    ret 0;
}

fun aligned(mt: *Match, l: Lanes) bool {
    ret l.bits != 0 && alignment(mt) * 8 >= l.bits::u64;
}

# the access is aligned to a lane of the vector it loads or stores
pub fun load_aligned(mt: *Match) bool {
    ret aligned(mt, result_lanes(mt));
}

# the store is aligned to a lane of the vector it writes
# ---
# mt:  the match the guard reads
# ret: whether the guard holds
pub fun store_aligned(mt: *Match) bool {
    ret aligned(mt, stored_lanes(mt));
}

# the state an instruction runs under: its vtype and the vector length the root gives, reads or stores, or
# one for an instruction that moves a scalar into or out of lane 0, or the lane plus one for an insert
fun stated(vtype: u64, n: opt[i64]) opt[vstate.State] {
    if (sel n.none)  { ret opt[vstate.State].none{}; }
    if (n.some <= 0) { ret opt[vstate.State].none{}; }
    ret opt[vstate.State].some{vstate.State{config: riscv_config.configured(vtype, n.some:~u64)}};
}

# a vector length of one, for an instruction that moves a scalar into or out of lane 0
fun one(mt: *Match) opt[i64] {
    ret opt[i64].some{1};
}

fun e16_mf2_result_count(mt: *Match) opt[vstate.State] {
    ret stated(207, result_count(mt));
}

fun e16_mf4_result_count(mt: *Match) opt[vstate.State] {
    ret stated(206, result_count(mt));
}

fun e16_one(mt: *Match) opt[vstate.State] {
    ret stated(200, one(mt));
}

fun e16_operand_count(mt: *Match) opt[vstate.State] {
