use mirl.machine.select.rule.Width;
use mirl.machine.vstate;

# the lanes of a vector: how many and the bits of each, zero for a value
# that is no vector
rec Lanes {
    count: u32;
    bits:  u32;
}

fun lanes_of(mt: *Match, v: opt[id.Value]) Lanes {
    val none: Lanes = Lanes{count: 0, bits: 0};
    if (sel v.none) { ret none; }
    val s: res[types.Shape, types.Error] = match.shape(mt, v.some);
    if (sel s.err) { ret none; }
    val sh: types.Shape = s.ok;
    if (!(sel sh.vector)) { ret none; }
    val e: res[types.Shape, types.Error] = types.shape(?mt.module.types, sh.vector.element);
    if (sel e.err) { ret none; }
    val es:   types.Shape = e.ok;
    var bits: u32         = 0;
    if (sel es.integer) { bits = es.integer.width; }
    or (sel es.float) {
        val r: opt[types.Row] = types.row(es.float.format);
        if (sel r.none) { ret none; }
        bits = r.some.width;
    }
    ret Lanes{count: sh.vector.lanes, bits: bits};
}

fun result_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.result(mt, Slot{node: 0, index: 0}));
}

fun operand_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
}

# the vector a store writes, its second operand
fun stored_lanes(mt: *Match) Lanes {
    ret lanes_of(mt, match.operand(mt, Slot{node: 0, index: 1}));
}

fun immediate(x: u64) opt[i64] {
    ret opt[i64].some{x:~i64};
}

fun count_of(l: Lanes) opt[i64] {
    if (l.count == 0) { ret opt[i64].none{}; }
    ret immediate(l.count::u64);
}

fun bytes_of(l: Lanes) opt[i64] {
    if (l.count == 0 || l.bits % 8 != 0) { ret opt[i64].none{}; }
    ret immediate(l.count::u64 * l.bits::u64 / 8);
}

# the vector length a rule runs at: the lanes of the vector the root gives,
# reads or stores, or its bytes for a load or a store of bytes
pub fun result_count(mt: *Match) opt[i64] {
    ret count_of(result_lanes(mt));
}

pub fun operand_count(mt: *Match) opt[i64] {
    ret count_of(operand_lanes(mt));
}

pub fun stored_count(mt: *Match) opt[i64] {
    ret count_of(stored_lanes(mt));
}

pub fun result_bytes(mt: *Match) opt[i64] {
    ret bytes_of(result_lanes(mt));
}

pub fun stored_bytes(mt: *Match) opt[i64] {
    ret bytes_of(stored_lanes(mt));
}

# the lane the root names
fun lane_of(mt: *Match) opt[u32] {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lane) { ret opt[u32].some{imm.lane}; }
        i = i + 1;
    }
    ret opt[u32].none{};
}

# the lane, the offset of a slide
pub fun lane(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate(l.some::u64);
}

# the lane plus one, the vector length an insert writes up to
pub fun lane_after(mt: *Match) opt[i64] {
    val l: opt[u32] = lane_of(mt);
    if (sel l.none) { ret opt[i64].none{}; }
    ret immediate(l.some::u64 + 1);
}

# the root names lane 0
pub fun lane_zero(mt: *Match) bool {
    val l: opt[u32] = lane_of(mt);
    ret sel l.some && l.some == 0;
}

# the root reduces a vector of one lane, or of more
pub fun single(mt: *Match) bool {
    ret operand_lanes(mt).count == 1;
}

pub fun several(mt: *Match) bool {
    ret operand_lanes(mt).count > 1;
}

# the alignment the root's access states, zero where it states none
fun alignment(mt: *Match) u64 {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.alignment) { ret imm.alignment; }
        i = i + 1;
    }
    ret 0;
}

fun aligned(mt: *Match, l: Lanes) bool {
    ret l.bits != 0 && alignment(mt) * 8 >= l.bits::u64;
}

# the access is aligned to a lane of the vector it loads or stores
pub fun load_aligned(mt: *Match) bool {
    ret aligned(mt, result_lanes(mt));
}

pub fun store_aligned(mt: *Match) bool {
    ret aligned(mt, stored_lanes(mt));
}

val VT_E16:     opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 200}}};
val VT_E16_MF2: opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 207}}};
val VT_E16_MF4: opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 206}}};
val VT_E16_TU:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 136}}};
val VT_E32:     opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 208}}};
val VT_E32_MF2: opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 215}}};
val VT_E32_TU:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 144}}};
val VT_E64:     opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 216}}};
val VT_E64_TU:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 152}}};
val VT_E8:      opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 192}}};
val VT_E8_MF2:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 199}}};
val VT_E8_MF4:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 198}}};
val VT_E8_MF8:  opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 197}}};
val VT_E8_TU:   opt[vstate.State] = opt[vstate.State].some{vstate.State{config: config.State{bits: 128}}};

