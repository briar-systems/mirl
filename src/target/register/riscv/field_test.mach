#[testing]
fun text_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a byte and a halfword of each atomic read-modify-write and compare and exchange
#[testing]
val NARROW: str = "function @narrow: fun(ptr, i8, i16) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {\n^entry(%p: ptr, %b: i8, %h: i16):\n    %b0 = atomic.xchg %p, %b, order seq_cst\n    %b1 = atomic.add %p, %b, order seq_cst\n    %b2 = atomic.sub %p, %b, order seq_cst\n    %b3 = atomic.and %p, %b, order seq_cst\n    %b4 = atomic.or %p, %b, order seq_cst\n    %b5 = atomic.xor %p, %b, order seq_cst\n    %b6 = atomic.nand %p, %b, order seq_cst\n    %b7 = atomic.umax %p, %b, order seq_cst\n    %b8 = atomic.umin %p, %b, order seq_cst\n    %b9 = atomic.smax %p, %b, order seq_cst\n    %b10 = atomic.smin %p, %b, order seq_cst\n    %b11, %bw = atomic.cmpxchg %p, %b, %b0, success seq_cst, failure seq_cst\n    %h0 = atomic.xchg %p, %h, order seq_cst\n    %h1 = atomic.add %p, %h, order seq_cst\n    %h2 = atomic.sub %p, %h, order seq_cst\n    %h3 = atomic.and %p, %h, order seq_cst\n    %h4 = atomic.or %p, %h, order seq_cst\n    %h5 = atomic.xor %p, %h, order seq_cst\n    %h6 = atomic.nand %p, %h, order seq_cst\n    %h7 = atomic.umax %p, %h, order seq_cst\n    %h8 = atomic.umin %p, %h, order seq_cst\n    %h9 = atomic.smax %p, %h, order seq_cst\n    %h10 = atomic.smin %p, %h, order seq_cst\n    %h11, %hw = atomic.cmpxchg %p, %h, %h0, success seq_cst, failure seq_cst\n    ret.placed places []\n}\n";

# a text of growing bytes, kept as a vector
#[testing]
pub fun put(v: *vector.Vector[u8], s: str) bool {
    var i: usize = 0;
    for (i < str_len(s)) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, s[i]);
        if (sel pushed.err) { ret false; }
        i = i + 1;
    }
    ret true;
}

#[testing]
pub fun number(v: *vector.Vector[u8], n: u64) bool {
    var digits: [24]u8;
    var count:  usize = 0;
    var left:   u64   = n;
    for {
        digits[count] = (48 + left % 10)::u8;
        count         = count + 1;
        left          = left / 10;
        if (left == 0) { brk; }
    }
    for (count > 0) {
        count = count - 1;
        val pushed: res[usize, allocator.Error] = vector.push[u8](v, digits[count]);
        if (sel pushed.err) { ret false; }
    }
    ret true;
}

# the narrow function on a target's row with a baseline and the extensions
# added to it, selected, and the loops and direct narrow instructions it
# holds counted
# ---
# loops:  how many field loops, by name, the same name counted in `named`
# named:  the loop counted in `loops`
# direct: how many rows of a byte or halfword read-modify-write
#[testing]
rec Count {
    loops:  u32;
    named:  u32;
    direct: u32;
}

# whether a mnemonic is one of Zabha's, a read-modify-write of a byte or a halfword
#[testing]
fun narrow_row(name: str) bool {
    val n: usize = str_len(name);
    if (n < 5 || name[0] != 97 || name[1] != 109 || name[2] != 111) { ret false; }
    ret name[n - 2] == 46 && (name[n - 1] == 98 || name[n - 1] == 104);
}

#[testing]
fun counted(name: str, baseline: str, added: Slice[str], loop_name: str, out: *Count) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    var text: vector.Vector[u8] = vector.init[u8](?a);
    fin { vector.dnit[u8](?text); }
    if (!put(?text, "target \"") || !put(?text, name) || !put(?text, "\"\n") || !put(?text, NARROW)) { ret 1; }
    val made: res[Module, Refusal] = ir_reader.parse_body(?a, View{data: text.data, len: text.len});
    if (sel made.err) { ret 2; }
    var m: Module = made.ok;
    fin { module.dnit(?m); }
    val row: opt[*Target] = targets.by_name(m.target);
    if (sel row.none) { ret 3; }
    var t: Target = @row.some;
    t.baseline = Baseline.extensions{baseline};
    var basis:  target_basis.Basis;
    val chosen: err[target_basis.Error] = target_basis.choose(?basis, ?a, ?t, added);
    if (sel chosen.err) { ret 4; }
    fin { target_basis.drop(?basis); }
    val at_made: res[Locations, location.Error] = location.init(?a, ?riscv_register.FILE, Slice[*Memory]{data: nil, size: 0});
    if (sel at_made.err) { ret 5; }
    var at: Locations = at_made.ok;
    fin { location.dnit(?at); }
    val ready: res[Selector, engine.Error] = engine.init(?a, ?TABLE, ?t, ?riscv_set.SET, ?basis.selection);
    if (sel ready.err) { ret 6; }
    var s: Selector = ready.ok;
    fin { engine.dnit(?s); }
    var calls:  Calls                       = Calls{clobbered: Slice[rf.Id]{data: nil, size: 0}, at: ?at};
    val picked: res[Selected, engine.Error] = engine.select(?s, ?m, id.Function{index: 0}, ?calls);
    if (sel picked.err) { ret 7; }
    var got: Selected = picked.ok;
    fin { engine.release(?got); }
    out.loops  = 0;
    out.named  = 0;
    out.direct = 0;
    var b: usize = 0;
    for (b < got.function.blocks.len) {
        val list: Slice[Instruction] = mf.instructions(?got.function, Block{index: b::u32});
        var k:    usize              = 0;
        for (k < list.size) {
            val op: mi.Opcode = mf.data(?got.function, list.data[k]).opcode;
            if (sel op.loop) {
                if (op.loop.name[0] == 102)              { out.loops = out.loops + 1; }
                if (str_equals(op.loop.name, loop_name)) { out.named = out.named + 1; }
            }
            or (sel op.row) {
                if (narrow_row(op.row.mnemonic)) { out.direct = out.direct + 1; }
            }
            k = k + 1;
        }
        b = b + 1;
    }
    ret 0;
}

#[testing]
val NO_ADDED: Slice[str] = Slice[str]{data: nil, size: 0};

#[testing]
val ZABHA_NAMES: [1]str = [1]str{"zabha"};

#[testing]
val ZABHA: Slice[str] = Slice[str]{data: ?ZABHA_NAMES[0], size: 1};

# with no direct narrow instruction admitted, every byte and halfword
# read-modify-write and compare and exchange selects to a field loop, on
# RV64 and RV32 alike. once Zabha is admitted, read from its rows'
# requirements, its direct instructions take every operation it has, and
# only the nand and the compare and exchange stay loops
test riscv__a_narrow_atomic_selects_a_field_loop_and_zabha_its_direct_instruction {
    var c:    Count;
    val wide: i32 = counted("riscv64-linux", "rv64imac", NO_ADDED, "field_cmpxchg", ?c);
    if (wide != 0)                                      { ret wide; }
    if (c.loops != 24 || c.named != 2 || c.direct != 0) { ret 10; }
    val narrow: i32 = counted("riscv32-linux", "rv32imac", NO_ADDED, "field_smin", ?c);
    if (narrow != 0)                                    { ret 20 + narrow; }
    if (c.loops != 24 || c.named != 2 || c.direct != 0) { ret 30; }
    val direct: i32 = counted("riscv64-linux", "rv64imac", ZABHA, "field_nand", ?c);
    if (direct != 0)                                    { ret 40 + direct; }
    if (c.loops != 4 || c.named != 2 || c.direct != 20) { ret 50; }
    ret 0;
}

# the address of the word a run's field stands in
#[testing]
val BASE: u64 = 0x1000;

# the bits around a field, each byte's top bit set or clear so a stray sign extension shows
#[testing]
val AROUND: u64 = 0x96_3C_A5_69;

# a register no step should read before it writes it
#[testing]
val GARBAGE: u64 = 0xDEAD_BEEF_F00D_CAFE;

# one run of an expansion on a word
# ---
# a:    the allocator the folder takes
# t:    the type table its types are made in
# xlen: the bits of a register
# x:    the integer registers, x0 never written
# word: the word at BASE
#[testing]
rec Run {
    a:    *allocator.Allocator;
    t:    *types.Table;
    xlen: u32;
    x:    [32]u64;
    word: u64;
}

#[testing]
fun ones(bits: u32) u64 {
    if (bits >= 64) { ret 0xFFFF_FFFF_FFFF_FFFF; }
    ret (1::u64 << bits::u64) - 1;
}

# the low `from` bits of a value sign extended to `to` bits
#[testing]
fun extend(v: u64, from: u32, to: u32) u64 {
    var x: u64 = v & ones(from);
    if (((x >> (from - 1)::u64) & 1) != 0) { x = x | (ones(to) & ~ones(from)); }
    ret x & ones(to);
}

# the folder's answer for an operation of the opcode table on integers of a width
#[testing]
fun fold(r: *Run, op: Opcode, width: u32, x: u64, y: u64, n: usize) opt[u64] {
    val ty: res[Type, types.Error] = types.intern(r.t, types.Shape.integer{types.Integer{width: width}});
    if (sel ty.err) { ret opt[u64].none{}; }
    var first:  [1]u64 = [1]u64{x & ones(width)};
    var second: [1]u64 = [1]u64{y & ones(width)};
    var lanes:  [2]Bits;
    lanes[0] = Bits{type: ty.ok, words: Slice[u64]{data: ?first[0], size: 1}};
    lanes[1] = Bits{type: ty.ok, words: Slice[u64]{data: ?second[0], size: 1}};
    var ops: [2]folder.Operand;
    ops[0] = folder.Operand{value: folder.Value{type: ty.ok, lanes: Slice[Bits]{data: ?lanes[0], size: 1}}, secret: false};
    ops[1] = folder.Operand{value: folder.Value{type: ty.ok, lanes: Slice[Bits]{data: ?lanes[1], size: 1}}, secret: false};
    val req: folder.Request = folder.Request{opcode: op, operands: Slice[folder.Operand]{data: ?ops[0], size: n}, immediates: Slice[Immediate]{data: nil, size: 0}};
    val out: folder.Outcome = folder.fold(r.a, r.t, req);
    if (sel out.refused) { ret opt[u64].none{}; }
    val v:        u64                  = out.folded.results.data[0].lanes.data[0].words.data[0];
    val released: err[allocator.Error] = folder.release(r.a, out.folded);
    if (sel released.err) { ret opt[u64].none{}; }
    ret opt[u64].some{v};
}

# the integer register an operand names, none for any other operand
#[testing]
fun register_of(o: Operand) opt[u32] {
    if (!(sel o.physical)) { ret opt[u32].none{}; }
    val p: Physical = o.physical;
    if (!(sel p.register))                                             { ret opt[u32].none{}; }
    if (p.register < gen_register.X0 || p.register > gen_register.X31) { ret opt[u32].none{}; }
    ret opt[u32].some{p.register - gen_register.X0};
}

# the value an operand gives, a register or an immediate at the register's width
#[testing]
fun operand_value(r: *Run, o: Operand) opt[u64] {
    if (sel o.immediate) { ret opt[u64].some{o.immediate::u64 & ones(r.xlen)}; }
    val n: opt[u32] = register_of(o);
    if (sel n.none)  { ret opt[u64].none{}; }
    if (n.some == 0) { ret opt[u64].some{0}; }
    ret opt[u64].some{r.x[n.some]};
}

#[testing]
fun write(r: *Run, o: Operand, v: u64) bool {
    val n: opt[u32] = register_of(o);
    if (sel n.none)  { ret false; }
    if (n.some != 0) { r.x[n.some] = v & ones(r.xlen); }
    ret true;
}

# what an arithmetic row is in the opcode table
# ---
# row:     the row
# op:      the operation it is, at the register's width
# shift:   its count is taken modulo the register's width, as RISC-V's shifts take it
# compare: its result is a condition, 1 or 0
#[testing]
rec Meaning {
    row:     *rows.Row;
    op:      Opcode;
    shift:   bool;
    compare: bool;
}

#[testing]
val MEANINGS: [13]Meaning = [13]Meaning{
    Meaning{row: gen_row.ADD, op: opcodes.ADD, shift: false, compare: false},
    Meaning{row: gen_row.ADDI, op: opcodes.ADD, shift: false, compare: false},
    Meaning{row: gen_row.SUB, op: opcodes.SUB, shift: false, compare: false},
    Meaning{row: gen_row.AND, op: opcodes.AND, shift: false, compare: false},
    Meaning{row: gen_row.ANDI, op: opcodes.AND, shift: false, compare: false},
    Meaning{row: gen_row.OR, op: opcodes.OR, shift: false, compare: false},
    Meaning{row: gen_row.XOR, op: opcodes.XOR, shift: false, compare: false},
    Meaning{row: gen_row.XORI, op: opcodes.XOR, shift: false, compare: false},
    Meaning{row: gen_row.SLL, op: opcodes.SHL, shift: true, compare: false},
    Meaning{row: gen_row.SRL, op: opcodes.SHR_U, shift: true, compare: false},
    Meaning{row: gen_row.SRA, op: opcodes.SHR_S, shift: true, compare: false},
    Meaning{row: gen_row.SLT, op: opcodes.LT_S, shift: false, compare: true},
    Meaning{row: gen_row.SLTU, op: opcodes.LT_U, shift: false, compare: true},
};

# the word operation of a read-modify-write of a word
#[testing]
fun amo_of(row: *rows.Row) opt[Opcode] {
    if (row == gen_row.AMOAND_W) { ret opt[Opcode].some{opcodes.AND}; }
    if (row == gen_row.AMOOR_W)  { ret opt[Opcode].some{opcodes.OR}; }
    if (row == gen_row.AMOXOR_W) { ret opt[Opcode].some{opcodes.XOR}; }
    ret opt[Opcode].none{};
}

# one arithmetic row on its operands, the result written
#[testing]
fun arithmetic(r: *Run, row: *rows.Row, o: Slice[Operand]) i32 {
    var k: usize = 0;
    for (k < $length_of(MEANINGS)) {
        val m: Meaning = MEANINGS[k];
        if (m.row == row) {
            val x: opt[u64] = operand_value(r, o.data[1]);
            val y: opt[u64] = operand_value(r, o.data[2]);
            if (sel x.none) { ret 50; }
            if (sel y.none) { ret 50; }
            var count: u64 = y.some;
            if (m.shift) { count = count & (r.xlen - 1)::u64; }
            val got: opt[u64] = fold(r, m.op, r.xlen, x.some, count, 2);
            if (sel got.none)                   { ret 51; }
            if (!write(r, o.data[0], got.some)) { ret 52; }
            ret 0;
        }
        k = k + 1;
    }
    ret 53;
}

# run a function's blocks from the first until its return, 0 when every row
# it meets is one the model knows and every access is of the word at BASE
#[testing]
fun execute(r: *Run, f: *mf.Function) i32 {
    var b:     u32   = 0;
    var k:     usize = 0;
    var steps: u32   = 0;
    for (steps < 10000) {
        steps = steps + 1;
        val list: Slice[Instruction] = mf.instructions(f, Block{index: b});
        if (k >= list.size) { ret 40; }
        val d: *InstructionData = mf.data(f, list.data[k]);
        k = k + 1;
        if (!(sel d.opcode.row)) { ret 41; }
        val row: *rows.Row      = d.opcode.row;
        val o:   Slice[Operand] = d.operands;
        if (row == gen_row.JALR) { ret 0; }
        if (row == gen_row.JAL) {
            val to: Operand = o.data[1];
            if (!(sel to.block)) { ret 42; }
            b = to.block.index;
            k = 0;
            cnt;
        }
        if (row == gen_row.BNE) {
            val x:  opt[u64] = operand_value(r, o.data[0]);
            val y:  opt[u64] = operand_value(r, o.data[1]);
            val to: Operand  = o.data[2];
            if (sel x.none)      { ret 43; }
            if (sel y.none)      { ret 43; }
            if (!(sel to.block)) { ret 43; }
            if (x.some != y.some) {
                b = to.block.index;
                k = 0;
            }
            cnt;
        }
        val amo: opt[Opcode] = amo_of(row);
        if (row == gen_row.LR_W || row == gen_row.SC_W || sel amo.some) {
            val at: opt[u64] = operand_value(r, o.data[1]);
            if (sel at.none)     { ret 44; }
            if (at.some != BASE) { ret 44; }
            val old: u64 = r.word;
            if (row == gen_row.SC_W) {
                val v: opt[u64] = operand_value(r, o.data[2]);
                if (sel v.none) { ret 45; }
                r.word = v.some & ones(32);
                if (!write(r, o.data[0], 0)) { ret 45; }
                cnt;
            }
            if (sel amo.some) {
                val v: opt[u64] = operand_value(r, o.data[2]);
                if (sel v.none) { ret 46; }
                val got: opt[u64] = fold(r, amo.some, 32, old, v.some, 2);
                if (sel got.none) { ret 46; }
                r.word = got.some;
            }
            if (!write(r, o.data[0], extend(old, 32, r.xlen))) { ret 47; }
            cnt;
        }
        val done: i32 = arithmetic(r, row, o);
        if (done != 0) { ret done; }
    }
    ret 48;
}

# an operation on a field and what it is
# ---
# loop:    the field loop
# op:      the plain operation on the field, the folder's
# plain:   `op` gives the field, which an exchange, storing the operand, does not
# not:     the result of `op` is inverted, as a nand's is
# choose:  `op` is a comparison, and the operand is stored where it does not hold
# compare: the operand is the value expected, and the one after it stored where it is held
# others:  the loop has a position past the parameters and the scratch register
#[testing]
rec Case {
    loop:    *lrow.Loop;
    op:      Opcode;
    plain:   bool;
    not:     bool;
    choose:  bool;
    compare: bool;
    others:  bool;
}

#[testing]
val CASES: [12]Case = [12]Case{
    Case{loop: ?loop.FIELD_XCHG, op: opcodes.ADD, plain: false, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_ADD, op: opcodes.ADD, plain: true, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_SUB, op: opcodes.SUB, plain: true, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_NAND, op: opcodes.AND, plain: true, not: true, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_AND, op: opcodes.AND, plain: true, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_OR, op: opcodes.OR, plain: true, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_XOR, op: opcodes.XOR, plain: true, not: false, choose: false, compare: false, others: false},
    Case{loop: ?loop.FIELD_UMAX, op: opcodes.GT_U, plain: true, not: false, choose: true, compare: false, others: true},
    Case{loop: ?loop.FIELD_UMIN, op: opcodes.LT_U, plain: true, not: false, choose: true, compare: false, others: true},
    Case{loop: ?loop.FIELD_SMAX, op: opcodes.GT_S, plain: true, not: false, choose: true, compare: false, others: true},
    Case{loop: ?loop.FIELD_SMIN, op: opcodes.LT_S, plain: true, not: false, choose: true, compare: false, others: true},
    Case{loop: ?loop.FIELD_CMPXCHG, op: opcodes.EQ, plain: true, not: false, choose: false, compare: true, others: true},
};

# the field an operation leaves, by the folder at the field's width
#[testing]
fun reference(r: *Run, c: Case, width: u32, held: u64, v: u64, stored: u64) opt[u64] {
    if (!c.plain) { ret opt[u64].some{v}; }
    val got: opt[u64] = fold(r, c.op, width, held, v, 2);
    if (sel got.none) { ret got; }
    if (c.not)        { ret fold(r, opcodes.NOT, width, got.some, 0, 1); }
    if (c.choose) {
        if (got.some == 1) { ret opt[u64].some{held}; }
        ret opt[u64].some{v};
    }
    if (c.compare) {
        if (got.some == 1) { ret opt[u64].some{stored}; }
        ret opt[u64].some{held};
    }
    ret got;
}

# the values a field and an operand take: the ends, the neighbours of the sign bit and a pattern
#[testing]
fun sample(width: u32, at: usize) u64 {
    val top: u64 = 1::u64 << (width - 1)::u64;
    var v:   u64 = 0x5A5A;
    if (at == 0) { v = 0; }
    if (at == 1) { v = 1; }
    if (at == 2) { v = top - 1; }
    if (at == 3) { v = top; }
    if (at == 4) { v = ones(width); }
    ret v & ones(width);
}

#[testing]
val SAMPLES: usize = 6;

# the loop of a case at a width and register width, as machine text over
# placed registers: the field's word in x10, its address in x11, the operand
# in x12, the value a compare and exchange stores in x13, its pair ordered as
# seq_cst
#[testing]
fun loop_text(v: *vector.Vector[u8], c: Case, width: u32, xlen: u32) bool {
    if (!put(v, "target \"riscv64-linux\"\n\nfunction @f {\n^0:\n    loop ") || !put(v, c.loop.name) || !put(v, " x10, x11, x12, ")) { ret false; }
    if (!number(v, width::u64) || !put(v, ", ") || !number(v, xlen::u64) || !put(v, ", 3, 1, x5, x6, x7, x28, x29"))                 { ret false; }
    if (c.compare) {
        if (!put(v, ", x13")) { ret false; }
    }
    or (c.others) {
        if (!put(v, ", x30")) { ret false; }
    }
    ret put(v, "\n    jalr x0, x1, 0\n}\n");
}

# a module, its target's machine and the locations of its registers
#[testing]
rec Fixture {
    a:     allocator.Allocator;
    folds: allocator.Allocator;
    heap:  heap.Heap;
    m:     Module;
    mach:  Build;
    at:    Locations;
}

#[testing]
val MODULE: str = "target \"riscv64-linux\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# one field loop at a width and register width, expanded, run on every
# sample of field and operand at every offset of the field in the word
#[testing]
fun runs(x: *Fixture, c: Case, width: u32, xlen: u32) i32 {
    var text: vector.Vector[u8] = vector.init[u8](?x.a);
    fin { vector.dnit[u8](?text); }
    if (!loop_text(?text, c, width, xlen)) { ret 1; }
    val input: res[reader.Unit, Refusal] = reader.parse_body(?x.a, ?x.m, View{data: text.data, len: text.len});
    if (sel input.err) { ret 2; }
    var u: reader.Unit = input.ok;
    fin { reader.dnit(?u); }
    val laid: res[Plan, lay.Error] = lay.lay(?x.a, ?u.items.data[0].function, Slice[u32]{data: nil, size: 0}, lay.Request{convention: ?x.mach.convention, at: ?x.at});
    if (sel laid.err) { ret 3; }
    var p: Plan = laid.ok;
    fin { lay.release(?p); }
    val bound: res[code.Admitted, code.Error] = code.admit(?x.a, ?FRAME, x.mach.convention.registers);
    if (sel bound.err) { ret 4; }
    var admitted: code.Admitted = bound.ok;
    fin { code.dnit(?admitted); }
    val framed: res[Framed, finish.Error] = finish.finish(?x.a, ?u.items.data[0].function, ?p, ?admitted);
    if (sel framed.err) { ret 4; }
    var out: Framed = framed.ok;
    fin { record.release(?out); }
    val done: err[expand.Error] = expand.expand(?x.a, ?out);
    if (sel done.err) { ret 5; }
    var r: Run;
    r.a    = ?x.folds;
    r.t    = ?x.m.types;
    r.xlen = xlen;
    var offset: u64 = 0;
    for (offset < 4) {
        val shift: u64   = offset * 8;
        var i:     usize = 0;
        for (i < SAMPLES) {
            var j: usize = 0;
            for (j < SAMPLES) {
                val held:   u64   = sample(width, i);
                val v:      u64   = sample(width, j);
                val stored: u64   = sample(width, (i + j + 2) % SAMPLES);
                val mask:   u64   = ones(width) << shift;
                val word:   u64   = (AROUND & ~mask) | (held << shift);
                var k:      usize = 0;
                for (k < 32) {
                    r.x[k] = GARBAGE & ones(xlen);
                    k      = k + 1;
                }
                r.x[0]  = 0;
                r.x[11] = BASE + offset;
                r.x[12] = extend(v, width, xlen);
                r.x[13] = extend(stored, width, xlen);
                r.word  = word;
                val ran: i32 = execute(?r, ?out.function);
                if (ran != 0) { ret ran; }
                val want: opt[u64] = reference(?r, c, width, held, v, stored);
                if (sel want.none)                                                                                           { ret 6; }
                if (r.word != ((word & ~mask) | (want.some << shift)))                                                       { ret 7; }
                if (r.x[10] != extend(held, width, xlen))                                                                    { ret 8; }
                if (r.x[11] != BASE + offset || r.x[12] != extend(v, width, xlen) || r.x[13] != extend(stored, width, xlen)) { ret 9; }
                j = j + 1;
            }
            i = i + 1;
        }
        offset = offset + width::u64 / 8;
    }
    ret 0;
}

# each field loop, at i8 and i16 and at either register width, expanded and
# run on a word at every offset its field can stand at, leaves the word with
# the field the plain operation at the field's width gives and every other
# byte as it was, and gives back the field it held, sign extended. the rows
# of a field loop are one row at either register width, so the expansion read
# at 32 bits is the one RV32 takes
test riscv__each_field_loop_leaves_the_field_the_plain_operation_gives {
    var x: Fixture;
    page.make(?x.a);
    var source: heap.Source;
    heap.native_source(?source);
    val heaped: err[allocator.Error] = heap.init(?x.heap, ?source, 0);
    if (sel heaped.err) { ret 1; }
    fin { heap.dnit(?x.heap); }
    val wired: err[allocator.Error] = heap.make(?x.folds, ?x.heap);
    if (sel wired.err) { ret 1; }
    val made: res[Module, Refusal] = ir_reader.parse_body(?x.a, text_of(MODULE));
    if (sel made.err) { ret 1; }
    x.m = made.ok;
    fin { module.dnit(?x.m); }
    val t: opt[*Target] = targets.by_name(x.m.target);
    if (sel t.none) { ret 2; }
    val opened: err[target_basis.Error] = machine.open(?x.mach, ?x.a, t.some, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 3; }
    fin { machine.close(?x.mach); }
    val got: res[Locations, location.Error] = location.init(?x.a, x.mach.convention.registers.file, Slice[*Memory]{data: nil, size: 0});
    if (sel got.err) { ret 4; }
    x.at = got.ok;
    fin { location.dnit(?x.at); }
    var k: usize = 0;
    for (k < $length_of(CASES)) {
        var w: u32 = 8;
        for (w <= 16) {
            var xlen: u32 = 32;
            for (xlen <= 64) {
                val ran: i32 = runs(?x, CASES[k], w, xlen);
                if (ran != 0) { ret ran; }
                xlen = xlen + 32;
            }
            w = w + 8;
        }
        k = k + 1;
    }
    ret 0;
}
