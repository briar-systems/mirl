# tests of allocation over risc-v's register file, its vector groups and its
# even pairs, machine form text in and text out

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.filesystem;
use io: std.io.writer;

use mirl.ir.module;
use mirl.ir.module.Module;
use ir_reader: mirl.ir.text.parse;
use mirl.ir.text.parse.refusal.Refusal;
use mirl.ir.text.printer;
use mirl.machine.alloc.alloc_test.Outcome;
use mirl.machine.alloc.alloc_test.allocated;
use mirl.machine.alloc.alloc_test.breached;
use mirl.machine.alloc.allocate;
use mirl.machine.alloc.allocate.Allocation;
use mirl.machine.class.Memory;
use mirl.machine.class.Physical;
use mirl.machine.constraint;
use mirl.machine.text.equal;
use mirl.machine.text.item;
use reader:   mirl.machine.text.parse;
use printing: mirl.machine.text.print;
use targets:  mirl.target;
use mirl.target.Target;
use mirl.target.basis;
use mirl.target.basis.Basis;

use rf: masc.core.register;
use masc.isa.riscv.gen_register;

#[testing]
fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}

#[testing]
val VECTOR_NAMES: [1]str = [1]str{"v"};

#[testing]
val VECTOR_MODULE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# `n` vector registers of risc-v from v`from`, written to `out`
#[testing]
fun vregs(out: *Physical, from: u16, n: u16) Slice[Physical] {
    var k: u16 = 0;
    for (k < n) {
        out[k] = Physical.register{rf.make(rf.class_of(gen_register.V1), rf.number_of(gen_register.V1) - 1 + from + k)};
        k      = k + 1;
    }
    ret Slice[Physical]{data: out, size: n::usize};
}

# risc-v integer register x`n`
#[testing]
fun reg_x(n: u16) Physical {
    ret Physical.register{rf.make(rf.class_of(gen_register.X1), n)};
}

# the module, the selection admitting the extensions a test names and the
# unit of a risc-v function's text that an allocation test reads
#[testing]
rec Vectors {
    m:    Module;
    base: Basis;
    u:    reader.Unit;
}

# read a risc-v function's text under a selection admitting the vector
# extension, 0 or the step that failed
#[testing]
fun open_vectors(a: *allocator.Allocator, x: *Vectors, text: str) i32 {
    ret open_selected(a, x, VECTOR_MODULE, Slice[str]{data: ?VECTOR_NAMES[0], size: 1}, text);
}

# read a function's text of the module's target under a selection admitting
# the extensions named, 0 or the step that failed
#[testing]
fun open_selected(a: *allocator.Allocator, x: *Vectors, module_text: str, names: Slice[str], text: str) i32 {
    val made: res[Module, Refusal] = ir_reader.parse_body(a, view_of(module_text));
    if (sel made.err) { ret 1; }
    x.m = made.ok;
    val tg: opt[*Target] = targets.row_of(x.m.target);
    if (sel tg.none) {
        module.dnit(?x.m);
        ret 1;
    }
    val chosen: err[basis.Error] = basis.choose(?x.base, a, tg.some, names);
    if (sel chosen.err) {
        module.dnit(?x.m);
        ret 1;
    }
    val input: res[reader.Unit, reader.Refusal] = reader.parse_body(a, ?x.m, view_of(text));
    if (sel input.err) {
        basis.drop(?x.base);
        module.dnit(?x.m);
        ret 2;
    }
    x.u = input.ok;
    ret 0;
}

#[testing]
fun close_vectors(x: *Vectors) {
    reader.dnit(?x.u);
    basis.drop(?x.base);
    module.dnit(?x.m);
}

# allocate a risc-v function's text over the vector registers given and
# compare the result with the expected text, 0 or the step that failed
#[testing]
fun vector_allocates(text: str, given: Slice[Physical], want: str) i32 {
    ret selected_allocates(VECTOR_MODULE, Slice[str]{data: ?VECTOR_NAMES[0], size: 1}, text, given, want);
}

# allocate a function's text of the module's target, under a selection
# admitting the extensions named, over the registers given and compare the
# result with the expected text, 0 or the step that failed
#[testing]
fun selected_allocates(module_text: str, names: Slice[str], text: str, given: Slice[Physical], want: str) i32 {
    var a: allocator.Allocator;
    page.make(?a);
    var x:      Vectors;
    val opened: i32 = open_selected(?a, ?x, module_text, names, text);
    if (opened != 0) { ret opened; }
    fin { close_vectors(?x); }
    val expected: res[reader.Unit, reader.Refusal] = reader.parse_body(?a, ?x.m, view_of(want));
    if (sel expected.err) { ret 3; }
    var w: reader.Unit = expected.ok;
    fin { reader.dnit(?w); }
    val done: Outcome = allocated(?a, ?x.u.items.data[0].function, ?x.base.context, Slice[*Memory]{data: nil, size: 0}, given);
    if (sel done.setup)   { ret done.setup; }
    or (sel done.refused) { ret 5; }
    var out: Allocation = done.allocated;
    fin { allocate.release(?out); }
    val same: res[bool, printer.Error] = equal.same_function(?x.m, ?out.function, ?x.m, ?w.items.data[0].function);
    if (sel same.err) { ret 6; }
    if (!same.ok) {
        var items: [1]item.Item;
        items[0].function = out.function;
        var err_out: io.Writer = filesystem.writer(filesystem.STDERR);
        printing.print(?err_out, ?x.m, Slice[item.Item]{data: ?items[0], size: 1});
        ret 7;
    }
    ret 0;
}

# the breach of instruction `at` that refuses allocating a risc-v function's
# text over the vector registers given, none when it is not so refused
#[testing]
fun vector_breached(text: str, given: Slice[Physical], at: u32) opt[constraint.Breach] {
    var a: allocator.Allocator;
    page.make(?a);
    var x: Vectors;
    if (open_vectors(?a, ?x, text) != 0) { ret opt[constraint.Breach].none{}; }
    fin { close_vectors(?x); }
    ret breached(?a, ?x.u.items.data[0].function, ?x.base.context, Slice[*Memory]{data: nil, size: 0}, given, at);
}

# a widening add under e32 and m1 writes a group of two registers, and keeps
# its destination's elements past the tail, so it reads the group too and the
# group is live from the start: over v2 to v5 it takes v2 and v3, and the
# sources take neither register of it
#[testing]
val WIDENING: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n    virtual %2: class v\n^0:\n    pseudo copy %0, v20\n    pseudo copy %1, v21\n    vwadd.vv %2, %0, %1, 1 vtype e32, m1, ta, ma\n    pseudo copy v22, %2\n    jalr x0, x1, 0\n}\n";

#[testing]
val WIDENING_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v4, v20\n    pseudo copy v5, v21\n    vwadd.vv v2, v4, v5, 1 vtype e32, m1, ta, ma\n    pseudo copy v22, v2\n    jalr x0, x1, 0\n}\n";

test allocate__a_widening_vector_add_takes_a_group_clear_of_its_sources {
    var four: [4]Physical;
    ret vector_allocates(WIDENING, vregs(?four[0], 2, 4), WIDENING_OUT);
}

# a fourfold extension under e32 and m1 reads its source at a quarter of a
# register, and its destination takes no register of it
#[testing]
val EXTENSION: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n^0:\n    pseudo copy %0, v20\n    vzext.vf4 %1, %0, 1 vtype e32, m1, ta, ma\n    pseudo copy v21, %1\n    jalr x0, x1, 0\n}\n";

#[testing]
val EXTENSION_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v2, v20\n    vzext.vf4 v1, v2, 1 vtype e32, m1, ta, ma\n    pseudo copy v21, v1\n    jalr x0, x1, 0\n}\n";

test allocate__a_fourfold_vector_extension_takes_no_register_of_its_source {
    var seven: [7]Physical;
    ret vector_allocates(EXTENSION, vregs(?seven[0], 1, 7), EXTENSION_OUT);
}

# a gather reading its index at 16 bits under e32 takes a register apart from
# both sources
#[testing]
val GATHER: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n    virtual %2: class v\n^0:\n    pseudo copy %0, v20\n    pseudo copy %1, v21\n    vrgatherei16.vv %2, %0, %1, 1 vtype e32, m1, ta, ma\n    pseudo copy v22, %2\n    jalr x0, x1, 0\n}\n";

#[testing]
val GATHER_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v2, v20\n    pseudo copy v3, v21\n    vrgatherei16.vv v1, v2, v3, 1 vtype e32, m1, ta, ma\n    pseudo copy v22, v1\n    jalr x0, x1, 0\n}\n";

# a gather of one value by itself reads it at 32 bits as data and at 16 as the
# index, which the rule reserves whatever its register, so every register
# breaks it and the refusal names the rule
#[testing]
val SELF_GATHER: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n^0:\n    pseudo copy %0, v20\n    vrgatherei16.vv %1, %0, %0, 1 vtype e32, m1, ta, ma\n    pseudo copy v22, %1\n    jalr x0, x1, 0\n}\n";

test allocate__a_gather_takes_a_register_apart_from_its_sources_or_is_refused_naming_the_rule {
    var three: [3]Physical;
    val took:  i32 = vector_allocates(GATHER, vregs(?three[0], 1, 3), GATHER_OUT);
    if (took != 0) { ret 10 + took; }
    val got: opt[constraint.Breach] = vector_breached(SELF_GATHER, vregs(?three[0], 1, 3), 1);
    if (sel got.none) { ret 2; }
    val b: constraint.Breach = got.some;
    if (!(sel b.broken)) { ret 3; }
    ret 0;
}

# a widening add writes v8 and v9 from v8, and a value made while the group
# is live takes neither: v10 is the first register its group leaves free
#[testing]
val OCCUPIED: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n    virtual %2: class v\n    virtual %3: class v\n^0:\n    pseudo copy %0, v10\n    pseudo copy %1, v11\n    vwadd.vv %2, %0, %1, 1 vtype e32, m1, ta, ma\n    pseudo copy %3, v20\n    pseudo copy v21, %2\n    pseudo copy v22, %3\n    jalr x0, x1, 0\n}\n";

#[testing]
val OCCUPIED_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v10, v10\n    pseudo copy v11, v11\n    vwadd.vv v8, v10, v11, 1 vtype e32, m1, ta, ma\n    pseudo copy v10, v20\n    pseudo copy v21, v8\n    pseudo copy v22, v10\n    jalr x0, x1, 0\n}\n";

test allocate__a_value_live_across_a_group_never_takes_a_register_of_it {
    var four: [4]Physical;
    ret vector_allocates(OCCUPIED, vregs(?four[0], 8, 4), OCCUPIED_OUT);
}

# a whole register load of two registers states no vtype and loads a group
# aligned to two: over v1 to v5, with %1 in v3, v1 is off the alignment and
# v2 would cover v3, so the group takes v4 and v5
#[testing]
val WHOLE: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n    virtual %1: class v\n^0:\n    pseudo copy %1, v3\n    vl2re8.v %0, x10\n    pseudo copy v21, %0\n    pseudo copy v22, %1\n    jalr x0, x1, 0\n}\n";

#[testing]
val WHOLE_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v3, v3\n    vl2re8.v v4, x10\n    pseudo copy v21, v4\n    pseudo copy v22, v3\n    jalr x0, x1, 0\n}\n";

test allocate__a_whole_register_load_takes_an_aligned_group_clear_of_live_values {
    var five: [5]Physical;
    ret vector_allocates(WHOLE, vregs(?five[0], 1, 5), WHOLE_OUT);
}

# a whole register load of two registers writes v4 and v5 from v4, and a
# value live across it takes neither: v5 is held from the load's def slot,
# so of v5 and v6 the value takes v6
#[testing]
val DEFINED: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n    virtual %0: class v\n^0:\n    pseudo copy %0, v20\n    vl2re8.v v4, x10\n    pseudo copy v21, %0\n    pseudo copy v22, v4\n    jalr x0, x1, 0\n}\n";

#[testing]
val DEFINED_OUT: str = "target \"riscv64\" \"linux\" \"lp64d\" \"rv64gc\"\n\nfunction @f {\n^0:\n    pseudo copy v6, v20\n    vl2re8.v v4, x10\n    pseudo copy v21, v6\n    pseudo copy v22, v4\n    jalr x0, x1, 0\n}\n";

test allocate__a_value_live_across_a_group_definition_never_takes_its_second_register {
    var two: [2]Physical;
    ret vector_allocates(DEFINED, vregs(?two[0], 5, 2), DEFINED_OUT);
}

#[testing]
val PAIR_NAMES: [1]str = [1]str{"zacas"};

#[testing]
val PAIR_MODULE: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\nfunction @f: fun() -> () linkage global visibility default {\n^entry:\n    ret\n}\n";

# amocas.d on rv32 reads and writes the even pair x12 and x13 and reads the
# pair x14 and x15, so both pairs are live in to it, and a value live across
# it takes neither odd register: of x13, x15 and x16 it takes x16
#[testing]
val PAIRED: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n    virtual %0: class x\n^0:\n    pseudo copy %0, x20\n    amocas.d.rv32 x12, x10, x14, 0\n    pseudo copy x21, %0\n    jalr x0, x1, 0\n}\n";

#[testing]
val PAIRED_OUT: str = "target \"riscv32\" \"linux\" \"ilp32d\" \"rv32gc\"\n\nfunction @f {\n^0:\n    pseudo copy x16, x20\n    amocas.d.rv32 x12, x10, x14, 0\n    pseudo copy x21, x16\n    jalr x0, x1, 0\n}\n";

test allocate__a_value_live_across_a_register_pair_never_takes_its_odd_register {
    var odd: [3]Physical = [3]Physical{reg_x(13), reg_x(15), reg_x(16)};
    ret selected_allocates(PAIR_MODULE, Slice[str]{data: ?PAIR_NAMES[0], size: 1}, PAIRED, Slice[Physical]{data: ?odd[0], size: 3}, PAIRED_OUT);
}
