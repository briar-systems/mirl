# the loops mirl carries, by the instruction set they are written for
#
# a set's loops are found by the set alone, so the text form spells a loop by
# its name without reaching a selection table. there is one row per carried
# set, and a set mirl writes no loops for has none.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;

use masc.core.set.Set;
use arches:     mink.catalog.arch;
use arch_riscv: mink.catalog.arch.riscv;

use mirl.machine.loop.row;
use mirl.machine.loop.row.Loops;
use mirl.target.register.riscv.loop;

# one carried set's loops, by the architecture family of mink's catalog the set serves
rec Carried {
    family: *arches.Family;
    loops:  *Loops;
}

val ROWS: [1]Carried = [1]Carried{
    Carried{family: ?arch_riscv.RISCV_FAMILY, loops: ?loop.LOOPS},
};

# whether set `s` serves an architecture of family `f`
pub fun serves(s: *Set, f: *arches.Family) bool {
    var i: u32 = 0;
    for (i < s.arches.len) {
        if (s.arches.at[i].arch.family == f) { ret true; }
        i = i + 1;
    }
    ret false;
}

# the loops written for a set, none when mirl writes it none
pub fun of(s: *Set) Loops {
    var i: usize = 0;
    for (i < $length_of(ROWS)) {
        if (serves(s, ROWS[i].family)) { ret @ROWS[i].loops; }
        i = i + 1;
    }
    ret row.NONE;
}
