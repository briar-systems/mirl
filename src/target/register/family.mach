# the register family: the targets whose values live in registers the
# pipeline allocates, whose control is unstructured, whose addresses are
# physical and which evaluate in registers
#
# its build is the register machine of mirl.target.register.machine, and its
# back end is mirl.machine.compile, handed the registry of the sets the
# family carries, mirl.target.register.isa. its rows run after the neutral prefix,
# which promotes, so every row here sees values in place of the memory the
# front end lowered locals to. an aggregate value is taken apart into its
# scalars first, and again after the abi legalisation places the calls. a
# float of a format the build holds no unit
# for is computed in a wider one it holds first, so the helpers and every
# legalisation after see only the formats the build holds and the integers of
# the encodings. what the target has no instruction for among
# divisions, multiplies, conversions, copies and fills becomes a call of a
# helper first, and a division whose hardware does not trap is given its
# tests, at the widths the source states, so the helpers' calls and entries
# are lowered with every other and their bodies legalised as any function.
# calls, entries and returns are lowered to the convention's pieces next,
# before any legalisation of types, which leaves piece form alone. the abi
# legalisation runs after the helpers, since every call they make and every
# helper entry is lowered with the rest, so a copy it makes past the bound the
# target has no instruction for calls the copy helper it delivers itself, and
# lowers that call and the helper's entry with every other. the float
# operations a format has no native form of are stood in for next, ahead of
# the integer legalisations, which widen and split the integers the stand ins
# are made of as any other. narrow arithmetic is widened next, so every pass
# after it sees the extensions and truncations it leaves and folds the ones
# of constants, and integers wider than the target computes at are split into
# words after it, so every pass after it optimises the words. the splitting
# reads a wide value at a call, an entry or a return as the abi legalisation
# leaves it, in register pieces, so that legalisation runs ahead of it. the
# neutral optimisations run next, each the row of the neutral schedule named
# here, in its order: folding, algebraic simplification, common
# subexpression elimination and loop invariant code motion. then the legalisations of what the target
# cannot do, which read the code the optimisations left and run on it last:
# the float constants a target loads first, after every pass that makes or
# folds a constant, then the multiply forms, since the split product they
# build is made of shifts, and the shift bounding after it, which marks every
# shift whose count is below its width, then dead code removal, which takes
# out what the legalisations replaced, and the structurizer last, after every
# pass that reshapes the graph, both neutral rows too. each of the family's
# own rows verifies when it changed something. it owns the inline assembly
# row, which masc reads in the sets of register machines alone, so a target
# of another family refuses an inline block by declaration

use std.types.bool.bool;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use std.allocator;
use std.collections.slice.Slice;

use mink.model.object;

use mirl.ir.module.Module;
use mirl.ir.opcode;
use opcode_table: mirl.ir.opcode.table;
use mirl.legal.abi.ABI;
use mirl.legal.aggregate.AGGREGATES;
use mirl.legal.aggregate.PLACED_AGGREGATES;
use mirl.legal.floats.FLOATS;
use mirl.legal.half.HALF;
use mirl.legal.helper.HELPERS;
use mirl.legal.multiply.MULTIPLY_FORMS;
use mirl.legal.narrow.NARROW;
use mirl.legal.pool.POOL;
use mirl.legal.shift.SHIFT_BOUND;
use mirl.legal.wide.WIDE;
use mcompile: mirl.machine.compile;
use mirl.pass.rows;
use mirl.pass.schedule.LoweringRow;
use mirl.pass.schedule.Row;
use mirl.pass.schedule.Step;
use mirl.pass.schedule.Verify;
use mirl.target.basis;
use mirl.target.build.Build;
use mirl.target.capability.Capabilities;
use mirl.target.family.Back;
use mirl.target.family.Error;
use mirl.target.family.Family;
use mirl.target.family.Options;
use mirl.target.record.Target;
use mirl.target.register.isa;
use mirl.target.register.machine;

val AGGREGATE_ROW: Row         = Row{pass: ?AGGREGATES, verify: Verify.changed{}};
val PLACED_ROW:    Row         = Row{pass: ?PLACED_AGGREGATES, verify: Verify.changed{}};
val HALF_ROW:      Row         = Row{pass: ?HALF, verify: Verify.changed{}};
val HELPERS_ROW:   Row         = Row{pass: ?HELPERS, verify: Verify.changed{}};
val ABI_ROW:       LoweringRow = LoweringRow{pass: ?ABI, verify: Verify.changed{}};
val FLOATS_ROW:    Row         = Row{pass: ?FLOATS, verify: Verify.changed{}};
val NARROW_ROW:    Row         = Row{pass: ?NARROW, verify: Verify.changed{}};
val WIDE_ROW:      Row         = Row{pass: ?WIDE, verify: Verify.changed{}};
val POOL_ROW:      Row         = Row{pass: ?POOL, verify: Verify.changed{}};
val MULTIPLY_ROW:  Row         = Row{pass: ?MULTIPLY_FORMS, verify: Verify.changed{}};
val SHIFT_ROW:     Row         = Row{pass: ?SHIFT_BOUND, verify: Verify.changed{}};

val STEPS: [17]Step = [17]Step{
    Step.row{?AGGREGATE_ROW},
    Step.row{?HALF_ROW},
    Step.row{?HELPERS_ROW},
    Step.lowering{?ABI_ROW},
    Step.row{?PLACED_ROW},
    Step.row{?FLOATS_ROW},
    Step.row{?NARROW_ROW},
    Step.row{?WIDE_ROW},
    Step.row{?rows.FOLD_ROW},
    Step.row{?rows.ALGEBRAIC_ROW},
    Step.row{?rows.CSE_ROW},
    Step.row{?rows.LICM_ROW},
    Step.row{?POOL_ROW},
    Step.row{?MULTIPLY_ROW},
    Step.row{?SHIFT_ROW},
    Step.row{?rows.DCE_ROW},
    Step.row{?rows.STRUCTURE_ROW},
};

# a register machine: allocated registers, free control, physical addressing
# and register evaluation
fun admits(c: *Capabilities) bool {
    ret sel c.registers.allocated && sel c.control.free && sel c.addressing.physical && sel c.evaluation.register;
}

fun open(b: *Build, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val opened: err[basis.Error] = machine.open(b, a, t, added);
    if (sel opened.err) { ret err[Error].err{Error.open{opened.err}}; }
    ret err[Error].ok{};
}

# the register family writes relocatable objects alone, which a link makes an image of
fun back(a: *allocator.Allocator, m: *Module, b: *Build, t: *Target, o: Options) res[object.Object, Error] {
    if (sel o.output.image) { ret res[object.Object, Error].err{Error.output{o.output}}; }
    val made: res[object.Object, mcompile.Error] = mcompile.compile(a, m, b, t, ?isa.ISAS, mcompile.Options{checked: o.checked, machine: o.machine, listing: o.listing, relax: o.relax});
    if (sel made.err) { ret res[object.Object, Error].err{Error.back{Back.register{made.err}}}; }
    ret res[object.Object, Error].ok{made.ok};
}

fun close(b: *Build) {
    machine.close(b);
}

# the register family
pub val FAMILY: Family = Family{
    name:    "register",
    admits:  admits,
    legal:   Slice[Step]{data: ?STEPS[0], size: 17},
    open:    open,
    back:    back,
    close:   close,
    opcodes: Slice[*opcode.Row]{data: ?opcode_table.ASSEMBLY_ROWS[0], size: 1},
};
