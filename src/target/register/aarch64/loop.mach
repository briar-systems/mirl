val LIST: [48]*Loop = [48]*Loop{?ADD_B, ?SUB_B, ?AND_B, ?OR_B, ?XOR_B, ?NAND_B, ?XCHG_B, ?SMAX_B, ?SMIN_B, ?UMAX_B, ?UMIN_B, ?CMPXCHG_B, ?ADD_H, ?SUB_H, ?AND_H, ?OR_H, ?XOR_H, ?NAND_H, ?XCHG_H, ?SMAX_H, ?SMIN_H, ?UMAX_H, ?UMIN_H, ?CMPXCHG_H, ?ADD_W, ?SUB_W, ?AND_W, ?OR_W, ?XOR_W, ?NAND_W, ?XCHG_W, ?SMAX_W, ?SMIN_W, ?UMAX_W, ?UMIN_W, ?CMPXCHG_W, ?ADD_X, ?SUB_X, ?AND_X, ?OR_X, ?XOR_X, ?NAND_X, ?XCHG_X, ?SMAX_X, ?SMIN_X, ?UMAX_X, ?UMIN_X, ?CMPXCHG_X};

