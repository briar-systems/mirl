# the aarch64 loops: the read-modify-writes the base set has no instruction
# for, each an exclusive pair, selected where lse is not admitted
#
# a body opens with the load-acquire exclusive, computes the value to store
# with the base integer rows, stores it with the store-release exclusive and
# runs again while the store reports it failed, its status register nonzero.
# no load, store or taken branch stands between the pair but a compare and
# exchange's branch out, so the body keeps the architecture's rules for an
# exclusive monitor's forward progress (arm arm, "load-exclusive and
# store-exclusive instruction usage restrictions"), which LLSC states and the
# loop check holds every body to. the acquire and release forms serve every
# ordering of the ir, the strongest of them included.
#
# a byte and a halfword have exclusives of their own, so no loop works on a
# field of a word. a minimum or maximum of a narrow value compares the low
# bits alone, extended as the order reads them, and the value it keeps is
# the one held or the operand whole, whose low bits the store writes.
#
# every read-modify-write shares its operand positions:
#
#   0  the value held, written
#   1  the address, read
#   2  the operand, read
#   3  the value stored, written
#   4  the status of the store, written
#
# and a compare and exchange its own:
#
#   0  the value held, written
#   1  the address, read
#   2  the value expected, read
#   3  the value stored where it is held, read
#   4  the status of the store, written
#
# and a compare and exchange of two words, low word first, its own again:
#
#   0, 1  the words held, written
#   2     the address, read
#   3, 4  the words expected, read
#   5, 6  the words stored where they are held, read
#   7, 8  the words stored, written
#   9     the status of the store, written
#
# an exclusive pair of two words is single-copy atomic only where its store
# succeeds (arm arm, "ldxp"), so that loop stores in every case: the desired
# words where the words held are the expected ones and the words held again
# otherwise, chosen by csel after a compare and ccmp, and has no branch out.

use mo: masc.core.operand;
use masc.core.requirement;
use masc.isa.aarch64.gen_register;
use masc.isa.aarch64.gen_row;

use mirl.machine.loop.row.Constraint;
use mirl.machine.loop.row.Kind;
use mirl.machine.loop.row.Loop;
use mirl.machine.loop.row.Loops;
use mirl.machine.loop.row.NO_PARTS;
use mirl.machine.loop.row.Parts;
use mirl.machine.loop.row.Roles;
use mirl.machine.loop.row.Source;
use mirl.machine.loop.row.Sources;
use mirl.machine.loop.row.Step;
use mirl.machine.loop.row.Steps;

# the branch back to the head of a body
val TO:   [1]Source = [1]Source{Source.target{}};
val JUMP: Step      = Step{row: gen_row.B_ONLY_BRANCH_IMM, operands: Sources{at: ?TO[0], len: 1}};

# the exclusive pair and the base integer rows, sixteen instructions at most,
# a bound of mirl's own since the architecture states none
pub val LLSC: Constraint = Constraint{kind: Kind.llsc{}, limit: 16, plain: requirement.NO_IDS, atomic: requirement.NO_IDS};

# how a read-modify-write and a compare and exchange use their positions, as
# the head of the file lays out
val RMW_ROLES:     [5]mo.Role = [5]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.WRITE, mo.WRITE};
val CMPXCHG_ROLES: [5]mo.Role = [5]mo.Role{mo.WRITE, mo.READ, mo.READ, mo.READ, mo.WRITE};

# and a compare and exchange of two words
val PAIR_ROLES: [10]mo.Role = [10]mo.Role{mo.WRITE, mo.WRITE, mo.READ, mo.READ, mo.READ, mo.READ, mo.READ, mo.WRITE, mo.WRITE, mo.WRITE};

# the operands of each step: the exclusive load of the value held, the value
# stored computed from it and the operand, the exclusive store and its status,
# the retry while that status is nonzero, and the steps a minimum, a maximum,
# a nand and a compare and exchange add: the narrow value extended as its
# order reads it, the comparison, the condition the value kept is chosen by
# (gt, lt, hi and lo), the inversion and the branch out when the value held is
# not the one expected
val LOAD_HELD:           [2]Source = [2]Source{Source.operand{0}, Source.operand{1}};
val COMPUTE_STORED:      [5]Source = [5]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}, Source.literal{0}, Source.literal{0}};
val STORE_STORED:        [3]Source = [3]Source{Source.operand{4}, Source.operand{3}, Source.operand{1}};
val RETRY:               [2]Source = [2]Source{Source.operand{4}, Source.head{}};
val INVERT_STORED_W:     [5]Source = [5]Source{Source.operand{3}, Source.fixed{gen_register.WZR}, Source.operand{3}, Source.literal{0}, Source.literal{0}};
val STORE_OPERAND:       [3]Source = [3]Source{Source.operand{4}, Source.operand{2}, Source.operand{1}};
val SIGNED_HELD_B:       [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.literal{0}, Source.literal{7}};
val STORED_AGAINST_SXTB: [5]Source = [5]Source{Source.fixed{gen_register.WZR}, Source.operand{3}, Source.operand{2}, Source.literal{4}, Source.literal{0}};
val KEEP_GREATER:        [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}, Source.literal{12}};
val KEEP_LESS:           [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}, Source.literal{11}};
val HELD_AGAINST:        [5]Source = [5]Source{Source.fixed{gen_register.WZR}, Source.operand{0}, Source.operand{2}, Source.literal{0}, Source.literal{0}};
val KEEP_HIGHER:         [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}, Source.literal{8}};
val KEEP_LOWER:          [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.operand{2}, Source.literal{3}};
val OUT_UNEQUAL:         [2]Source = [2]Source{Source.literal{1}, Source.exit{}};
val SIGNED_HELD_H:       [4]Source = [4]Source{Source.operand{3}, Source.operand{0}, Source.literal{0}, Source.literal{15}};
val STORED_AGAINST_SXTH: [5]Source = [5]Source{Source.fixed{gen_register.WZR}, Source.operand{3}, Source.operand{2}, Source.literal{5}, Source.literal{0}};
val HELD_AGAINST_UXTH:   [5]Source = [5]Source{Source.fixed{gen_register.WZR}, Source.operand{0}, Source.operand{2}, Source.literal{1}, Source.literal{0}};
val INVERT_STORED_X:     [5]Source = [5]Source{Source.operand{3}, Source.fixed{gen_register.XZR}, Source.operand{3}, Source.literal{0}, Source.literal{0}};
val HELD_AGAINST_X:      [5]Source = [5]Source{Source.fixed{gen_register.XZR}, Source.operand{0}, Source.operand{2}, Source.literal{0}, Source.literal{0}};
val LOAD_PAIR:           [3]Source = [3]Source{Source.operand{0}, Source.operand{1}, Source.operand{2}};
val LOW_AGAINST:         [5]Source = [5]Source{Source.fixed{gen_register.XZR}, Source.operand{0}, Source.operand{3}, Source.literal{0}, Source.literal{0}};
val HIGH_AGAINST:        [4]Source = [4]Source{Source.operand{1}, Source.operand{4}, Source.literal{0}, Source.literal{0}};
val KEEP_LOW:            [4]Source = [4]Source{Source.operand{7}, Source.operand{5}, Source.operand{0}, Source.literal{0}};
val KEEP_HIGH:           [4]Source = [4]Source{Source.operand{8}, Source.operand{6}, Source.operand{1}, Source.literal{0}};
val STORE_PAIR:          [4]Source = [4]Source{Source.operand{9}, Source.operand{7}, Source.operand{8}, Source.operand{2}};
val RETRY_PAIR:          [2]Source = [2]Source{Source.operand{9}, Source.head{}};

# each operation's body at each size, b, h, w and x, and its loop
val ADD_B_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.ADD_32_ADDSUB_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val ADD_B_BODY:      [1]Steps = [1]Steps{Steps{at: ?ADD_B_STEPS[0], len: 4}};
val SUB_B_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SUB_32_ADDSUB_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SUB_B_BODY:      [1]Steps = [1]Steps{Steps{at: ?SUB_B_STEPS[0], len: 4}};
val AND_B_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.AND_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val AND_B_BODY:      [1]Steps = [1]Steps{Steps{at: ?AND_B_STEPS[0], len: 4}};
val OR_B_STEPS:      [4]Step  = [4]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.ORR_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val OR_B_BODY:       [1]Steps = [1]Steps{Steps{at: ?OR_B_STEPS[0], len: 4}};
val XOR_B_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.EOR_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val XOR_B_BODY:      [1]Steps = [1]Steps{Steps{at: ?XOR_B_STEPS[0], len: 4}};
val NAND_B_STEPS:    [5]Step  = [5]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.AND_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.ORN_32_LOG_SHIFT, operands: Sources{at: ?INVERT_STORED_W[0], len: 5}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val NAND_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?NAND_B_STEPS[0], len: 5}};
val XCHG_B_STEPS:    [3]Step  = [3]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_OPERAND[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val XCHG_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?XCHG_B_STEPS[0], len: 3}};
val SMAX_B_STEPS:    [6]Step  = [6]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SBFM_32M_BITFIELD, operands: Sources{at: ?SIGNED_HELD_B[0], len: 4}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?STORED_AGAINST_SXTB[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_GREATER[0], len: 4}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SMAX_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?SMAX_B_STEPS[0], len: 6}};
val SMIN_B_STEPS:    [6]Step  = [6]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SBFM_32M_BITFIELD, operands: Sources{at: ?SIGNED_HELD_B[0], len: 4}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?STORED_AGAINST_SXTB[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_LESS[0], len: 4}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SMIN_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?SMIN_B_STEPS[0], len: 6}};
val UMAX_B_STEPS:    [5]Step  = [5]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?HELD_AGAINST[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_HIGHER[0], len: 4}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val UMAX_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?UMAX_B_STEPS[0], len: 5}};
val UMIN_B_STEPS:    [5]Step  = [5]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?HELD_AGAINST[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_LOWER[0], len: 4}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val UMIN_B_BODY:     [1]Steps = [1]Steps{Steps{at: ?UMIN_B_STEPS[0], len: 5}};
val CMPXCHG_B_STEPS: [5]Step  = [5]Step{Step{row: gen_row.LDAXRB_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?HELD_AGAINST[0], len: 5}}, Step{row: gen_row.B_ONLY_CONDBRANCH, operands: Sources{at: ?OUT_UNEQUAL[0], len: 2}}, Step{row: gen_row.STLXRB_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val CMPXCHG_B_BODY:  [1]Steps = [1]Steps{Steps{at: ?CMPXCHG_B_STEPS[0], len: 5}};
val ADD_H_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.ADD_32_ADDSUB_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val ADD_H_BODY:      [1]Steps = [1]Steps{Steps{at: ?ADD_H_STEPS[0], len: 4}};
val SUB_H_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SUB_32_ADDSUB_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SUB_H_BODY:      [1]Steps = [1]Steps{Steps{at: ?SUB_H_STEPS[0], len: 4}};
val AND_H_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.AND_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val AND_H_BODY:      [1]Steps = [1]Steps{Steps{at: ?AND_H_STEPS[0], len: 4}};
val OR_H_STEPS:      [4]Step  = [4]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.ORR_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val OR_H_BODY:       [1]Steps = [1]Steps{Steps{at: ?OR_H_STEPS[0], len: 4}};
val XOR_H_STEPS:     [4]Step  = [4]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.EOR_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val XOR_H_BODY:      [1]Steps = [1]Steps{Steps{at: ?XOR_H_STEPS[0], len: 4}};
val NAND_H_STEPS:    [5]Step  = [5]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.AND_32_LOG_SHIFT, operands: Sources{at: ?COMPUTE_STORED[0], len: 5}}, Step{row: gen_row.ORN_32_LOG_SHIFT, operands: Sources{at: ?INVERT_STORED_W[0], len: 5}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val NAND_H_BODY:     [1]Steps = [1]Steps{Steps{at: ?NAND_H_STEPS[0], len: 5}};
val XCHG_H_STEPS:    [3]Step  = [3]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_OPERAND[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val XCHG_H_BODY:     [1]Steps = [1]Steps{Steps{at: ?XCHG_H_STEPS[0], len: 3}};
val SMAX_H_STEPS:    [6]Step  = [6]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SBFM_32M_BITFIELD, operands: Sources{at: ?SIGNED_HELD_H[0], len: 4}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?STORED_AGAINST_SXTH[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_GREATER[0], len: 4}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SMAX_H_BODY:     [1]Steps = [1]Steps{Steps{at: ?SMAX_H_STEPS[0], len: 6}};
val SMIN_H_STEPS:    [6]Step  = [6]Step{Step{row: gen_row.LDAXRH_LR32_LDSTEXCLR, operands: Sources{at: ?LOAD_HELD[0], len: 2}}, Step{row: gen_row.SBFM_32M_BITFIELD, operands: Sources{at: ?SIGNED_HELD_H[0], len: 4}}, Step{row: gen_row.SUBS_32S_ADDSUB_EXT, operands: Sources{at: ?STORED_AGAINST_SXTH[0], len: 5}}, Step{row: gen_row.CSEL_32_CONDSEL, operands: Sources{at: ?KEEP_LESS[0], len: 4}}, Step{row: gen_row.STLXRH_SR32_LDSTEXCLR, operands: Sources{at: ?STORE_STORED[0], len: 3}}, Step{row: gen_row.CBNZ_32_COMPBRANCH, operands: Sources{at: ?RETRY[0], len: 2}}};
val SMIN_H_BODY:     [1]Steps = [1]Steps{Steps{at: ?SMIN_H_STEPS[0], len: 6}};
