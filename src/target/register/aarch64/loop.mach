pub val NAND_W: Loop = Loop{name: "nand_w", constraint: ?LLSC, roles: Roles{at: ?RMW_ROLES[0], len: 5}, before: NO_PARTS, body: Parts{at: ?NAND_W_BODY[0], len: 1}, after: NO_PARTS, jump: JUMP};

