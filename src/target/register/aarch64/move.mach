# the aarch64 moves: the whole value of one register into another of its class
#
# an x register moves by adding zero to it, which takes the stack pointer as
# well. a v register moves whole by or-ing it with itself, so a float in its
# s or d view and a vector move alike, and z and p, under sve, the same way
# at the vector length. the set has no exchange of two registers, so it
# states no swap, and no copy selection places is a move between classes.

use mirl.machine.copy.move.Move;
use mirl.machine.copy.move.Moves;
use mirl.machine.copy.move.Part;
use mirl.machine.copy.move.Parts;
use mirl.machine.copy.move.Table;
use mirl.machine.select.rule.Holder;

use masc.core.quantity;
use masc.isa.aarch64.gen_register;
use masc.isa.aarch64.gen_row;
use gen: mirl.target.register.aarch64.register;

val ADDED:     [4]Part = [4]Part{Part.to{}, Part.from{}, Part.literal{0}, Part.literal{0}};
val ORED:      [3]Part = [3]Part{Part.to{}, Part.from{}, Part.from{}};
val PREDICATE: [4]Part = [4]Part{Part.to{}, Part.from{}, Part.from{}, Part.from{}};

val ROWS: [4]Move = [4]Move{
    Move{to: Holder.hardware{?gen_register.CLASSES[gen.X_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen.X_CLASS]}, bits: quantity.Scaled{fixed: 64, per: 0, scale: 0}, row: gen_row.ADD_64_ADDSUB_IMM, parts: Parts{at: ?ADDED[0], len: 4}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen.V_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen.V_CLASS]}, bits: quantity.Scaled{fixed: 128, per: 0, scale: 0}, row: gen_row.ORR_ASIMDSAME_ONLY_16B, parts: Parts{at: ?ORED[0], len: 3}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen.Z_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen.Z_CLASS]}, bits: quantity.Scaled{fixed: 0, per: 128, scale: 0}, row: gen_row.ORR_Z_ZZ_, parts: Parts{at: ?ORED[0], len: 3}},
    Move{to: Holder.hardware{?gen_register.CLASSES[gen.P_CLASS]}, from: Holder.hardware{?gen_register.CLASSES[gen.P_CLASS]}, bits: quantity.Scaled{fixed: 0, per: 16, scale: 0}, row: gen_row.ORR_P_P_PP_Z, parts: Parts{at: ?PREDICATE[0], len: 4}},
};

# the aarch64 moves
pub val MOVES: Table = Table{moves: Moves{at: ?ROWS[0], len: 4}, swaps: Moves{at: nil, len: 0}};
