# aarch64 under aapcs64, the same for linux, darwin, windows and freestanding
val AARCH64_POINTERS: [1]Space = [1]Space{
    Space{space: 0, pointer: Pointer.architecture{}, layout: Rules.c{}},
};
val AARCH64_ALU:      [2]u32 = [2]u32{32, 64};
val AARCH64_INTEGERS: [4]u32 = [4]u32{8, 16, 32, 64};
# umulh and smulh give the high half, umull and smull the whole product of 32 bit operands
val AARCH64_PRODUCTS: [4]Product = [4]Product{
    Product{part: Part.high{}, sign: Sign.unsigned{}, width: 64},
    Product{part: Part.high{}, sign: Sign.signed{}, width: 64},
    Product{part: Part.full{}, sign: Sign.unsigned{}, width: 32},
    Product{part: Part.full{}, sign: Sign.signed{}, width: 32},
};
# fmin, fmax, the frint forms and fcsel. fminnm and fmaxnm give a nan for a
# signalling nan operand, so neither is the ir's, and no instruction gives a
# remainder
val AARCH64_NATIVES: [7]Native = [7]Native{
    Native{opcode: ir.FMIN, condition: Condition.always{}},
    Native{opcode: ir.FMAX, condition: Condition.always{}},
    Native{opcode: ir.FFLOOR, condition: Condition.always{}},
    Native{opcode: ir.FCEIL, condition: Condition.always{}},
    Native{opcode: ir.FINT, condition: Condition.always{}},
    Native{opcode: ir.FNEAREST, condition: Condition.always{}},
    Native{opcode: ir.SELECT, condition: Condition.always{}},
};
# with fpcr.dn clear, as linux and darwin run every thread, an operation on
# nans gives its first signalling nan operand quieted, else its first quiet
# nan operand, and an invalid operation the default nan, the positive quiet
# nan with no payload, which is the canonical one (arm arm, fpprocessnans,
# fpprocessnan and fpdefaultnan). with fpcr.dn set every nan result is the
# default nan, which is the canonical rule, but no row runs a thread so. a
# constant is made in a general register and moved
val AARCH64_HELD: [2]Held = [2]Held{
    Held{format: ?BINARY32, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.positive{}, priority: Priority.signalling{}, fused: Fused.addend{}}}, natives: Natives.rows{Slice[Native]{data: ?AARCH64_NATIVES[0], size: 7}}, constants: Constants.made{}},
    Held{format: ?BINARY64, condition: Condition.always{}, nans: Nans.propagate{Propagation{default: Default.positive{}, priority: Priority.signalling{}, fused: Fused.addend{}}}, natives: Natives.rows{Slice[Native]{data: ?AARCH64_NATIVES[0], size: 7}}, constants: Constants.made{}},
};
# the neon unit: packed integer lanes of each width, and packed binary32 and binary64
val AARCH64_LANES: [6]Lane = [6]Lane{
    Lane{lane: LaneType.integer{8}, form: Form.packed{}},
    Lane{lane: LaneType.integer{16}, form: Form.packed{}},
    Lane{lane: LaneType.integer{32}, form: Form.packed{}},
    Lane{lane: LaneType.integer{64}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY32}, form: Form.packed{}},
    Lane{lane: LaneType.float{?BINARY64}, form: Form.packed{}},
};
# sve, the one extension the aarch64 vector registers name
val SVE_ATOMS:        [1]requirement.Id          = [1]requirement.Id{aarch64_extension.SVE};
val SVE_ALTERNATIVES: [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?SVE_ATOMS[0], len: 1}, none: requirement.NO_IDS}};
val UNDER_SVE:        Condition                  = Condition.requires{requirement.Requirement{at: ?SVE_ALTERNATIVES[0], len: 1}};
# neon's 128 bit v, which every aarch64 has, and under sve masc's z class,
# 128 bits per unit of the vector length, which fixed-length vectors never
# split to, so it widens no vector's alignment
val AARCH64_VECTOR_REGISTERS: [2]VectorRegister = [2]VectorRegister{
    VectorRegister{requires: Condition.always{}, width: Width.fixed{128}},
    VectorRegister{requires: UNDER_SVE, width: Width.scaled{Scaled{class: ?gen_register.CLASSES[gen_register.Z_CLASS], length: Length.agnostic{}}}},
};
# the operations the neon rules select over packed lanes: the integer
# arithmetic and bitwise operations, a multiply of every width but a
# doubleword, binary32 and binary64 arithmetic, negation, absolute value and
# square root, a splat of every lane type and the sum of a vector's lanes.
# every other operation is taken lane by lane
val AARCH64_OPERATIONS: [55]Operation = [55]Operation{
    Operation{opcode: ir.ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.SUB, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.MUL, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.AND, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.OR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.XOR, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.NOT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.NEG, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.VSPLAT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FADD, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSUB, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FMUL, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FDIV, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FNEG, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FNEG, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FABS, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FABS, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY32}, to: LaneType.float{?BINARY32}, condition: Condition.always{}},
    Operation{opcode: ir.FSQRT, lane: LaneType.float{?BINARY64}, to: LaneType.float{?BINARY64}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{8}, to: LaneType.integer{8}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{16}, to: LaneType.integer{16}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{32}, to: LaneType.integer{32}, condition: Condition.always{}},
    Operation{opcode: ir.REDUCE_ADD, lane: LaneType.integer{64}, to: LaneType.integer{64}, condition: Condition.always{}},
};
# the byte sizes the neon rules load and store a vector at, h, s, d and q
# registers, so a vector of any other size splits
val AARCH64_VECTOR_BYTES: [4]u32 = [4]u32{2, 4, 8, 16};
# neon, which every aarch64 has and which holds no mask in a register yet, and under sve the scalable unit of masc's z
# class, 128 bits per unit of the vector length, which fixed-length vectors
# never split to, so its size is read through the vector length alone
val AARCH64_UNITS: [2]Unit = [2]Unit{
    Unit{requires: Condition.always{}, width: Width.fixed{128}, counts: Counts.bytes{Slice[u32]{data: ?AARCH64_VECTOR_BYTES[0], size: 4}}, lanes: Slice[Lane]{data: ?AARCH64_LANES[0], size: 6}, operations: Operations.rows{Slice[Operation]{data: ?AARCH64_OPERATIONS[0], size: 55}}, masks: Masks.none{}},
    Unit{requires: UNDER_SVE, width: Width.scaled{Scaled{class: ?gen_register.CLASSES[gen_register.Z_CLASS], length: Length.agnostic{}}}, counts: Counts.any{}, lanes: Slice[Lane]{data: ?AARCH64_LANES[0], size: 6}, operations: Operations.none{}, masks: Masks.none{}},
};
# udf #0, as a four byte word
val AARCH64_FILL: [4]u8 = [4]u8{0, 0, 0, 0};
# an integer wider than 128 bits is held as _BitInt(N) is under the aapcs64,
# in 16 byte chunks aligned as __int128 is
val AARCH64_INTEGER_LAYOUT: [8]IntegerLayout = [8]IntegerLayout{
    IntegerLayout{width: 1, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 8, stored: Stored.scalar{Scalar{size: 1, align: 1}}},
    IntegerLayout{width: 16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    IntegerLayout{width: 32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    IntegerLayout{width: 64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
    IntegerLayout{width: 128, stored: Stored.scalar{Scalar{size: 16, align: 16}}},
    IntegerLayout{width: 256, stored: Stored.scalar{Scalar{size: 32, align: 16}}},
    IntegerLayout{width: 512, stored: Stored.scalar{Scalar{size: 64, align: 16}}},
};
val AARCH64_FLOAT_LAYOUT: [3]FloatLayout = [3]FloatLayout{
    FloatLayout{format: ?BINARY16, stored: Stored.scalar{Scalar{size: 2, align: 2}}},
    FloatLayout{format: ?BINARY32, stored: Stored.scalar{Scalar{size: 4, align: 4}}},
    FloatLayout{format: ?BINARY64, stored: Stored.scalar{Scalar{size: 8, align: 8}}},
};

# a switch of four cases or more whose cases fill two fifths of their span
# branches through a table, which costs a bounds check, the table's address,
# a load and an indirect jump where a chain costs a compare and branch per case
val AARCH64_DENSITY: Density = Density{least: 4, fill: 40};
# lse's casp on an even pair of x registers, and under any build a loop over
# ldaxp and stlxp, so a build always swaps two words
val AARCH64_PAIRED: Atomics = Atomics{paired: Paired.native{Swap{condition: Condition.always{}, refusal: "a compare and exchange of two words, which every aarch64 build swaps"}}};

# aarch64, the same under every system
val AARCH64_CAPS: Capabilities = Capabilities{
    registers:      Registers.allocated{},
    control:        Control.free{},
    tables:         Tables.dense{AARCH64_DENSITY},
    addressing:     Addressing.physical{},
    functions:      Functions.addresses{},
    specialization: Specialization.fold{},
    values:         Values.untyped{},
    evaluation:     Evaluation.register{},
    widths:         Widths{
        pointers: Slice[Space]{data: ?AARCH64_POINTERS[0], size: 1},
        slots:    SlotSpace.space{0},
        models:   Models.none{},
        register: Bits.bits{64},
        alu:      Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
        integers: Set.widths{Slice[u32]{data: ?AARCH64_INTEGERS[0], size: 4}},
    },
    vectors:    Vectors.units{Slice[Unit]{data: ?AARCH64_UNITS[0], size: 2}},
    formats:    Formats.held{Slice[Held]{data: ?AARCH64_HELD[0], size: 2}},
    arithmetic: Arithmetic{
        multiply:   Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
        multiplied: Condition.always{},
        products:   Products.forms{Slice[Product]{data: ?AARCH64_PRODUCTS[0], size: 4}},
        shifts:     Shifts.wraps{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}},
        single:     Single.none{},
        # udiv and sdiv give 0 for a zero divisor and the dividend for an overflowing quotient
        division: Division{widths: Set.widths{Slice[u32]{data: ?AARCH64_ALU[0], size: 2}}, condition: Condition.always{}, zero: Fault.quiet{}, overflow: Fault.quiet{}, long: LongDivision.none{}},
    },
    # the memory copy and set instructions are an optional extension the baseline lacks
    bulk:    BulkMemory{copy: Bulk.none{}, fill: Bulk.none{}, moves: 8},
    atomics: AARCH64_PAIRED,
    code:    Code{
        function: Align.bytes{16},
        text:     Align.bytes{16},
        data:     Align.bytes{8},
        fill:     Fill.pattern{Slice[u8]{data: ?AARCH64_FILL[0], size: 4}},
    },
    attributes: Attributes.schema{?SCHEMA},
    ops:        Ops.none{},
    handles:    Handles.none{},
};

# the lp64 data of aapcs64, which darwinpcs and the windows abi lay out the same
val AARCH64_DATA: Data = Data{
    integers: Slice[IntegerLayout]{data: ?AARCH64_INTEGER_LAYOUT[0], size: 8},
    floats:   Slice[FloatLayout]{data: ?AARCH64_FLOAT_LAYOUT[0], size: 3},
    vectors:  VectorRule.register{Fit{narrow: 128, registers: Slice[VectorRegister]{data: ?AARCH64_VECTOR_REGISTERS[0], size: 2}}},
};

val MACHINES: [1]axis.Machine = [1]axis.Machine{axis.Machine{arch: ?aarch64.AARCH64, caps: AARCH64_CAPS}};

# the aarch64 conventions, by mink's psabi names. the windows row waits on
# mink's pe images (mink#70) and is not carried yet
val MEMBERS: [3]axis.Member = [3]axis.Member{
    axis.Member{arch: ?aarch64.AARCH64, name: "aapcs64", row: opt[*Convention].some{?AAPCS64}, data: AARCH64_DATA},
    axis.Member{arch: ?aarch64.AARCH64, name: "darwinpcs", row: opt[*Convention].some{?DARWINPCS}, data: AARCH64_DATA},
    axis.Member{arch: ?aarch64.AARCH64, name: "aapcs64win", row: opt[*Convention].none{}, data: AARCH64_DATA},
};

# linux code is position independent, and a thread-local variable of a module
# loaded at any time is reached through its tls descriptor (aaelf64,
# "thread-local storage descriptors"), of the two general dynamic dialects
# aaelf64 states the one whose resolver call keeps the most registers. its
# lookup is never called
val AARCH64_LINUX_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.descriptor{},
        local_dynamic:   Access.descriptor{},
        initial_exec:    Access.initial_exec{},
        local_exec:      Access.local_exec{},
        lookup:          "__tls_get_addr",
        index:           "",
    },
};

# darwin code is position independent, and every thread-local variable is
# reached through the thunk of its descriptor the loader binds
val AARCH64_DARWIN_ADDRESSES: Model = Model{
    relocation: Relocation.pie{},
    threads:    Threads{
        general_dynamic: Access.variable{},
        local_dynamic:   Access.variable{},
        initial_exec:    Access.variable{},
        local_exec:      Access.variable{},
        lookup:          "_tlv_bootstrap",
        index:           "",
    },
};

val MODELS: [2]axis.Model = [2]axis.Model{
    axis.Model{arch: ?aarch64.AARCH64, sys: ?LINUX, addresses: Addresses.model{AARCH64_LINUX_ADDRESSES}},
    axis.Model{arch: ?aarch64.AARCH64, sys: ?DARWIN, addresses: Addresses.model{AARCH64_DARWIN_ADDRESSES}},
};

# the aarch64 rows of every axis. windows and freestanding carry no address
# model yet
pub val AXES: axis.Axes = axis.Axes{
    machines: Slice[axis.Machine]{data: ?MACHINES[0], size: 1},
    members:  Slice[axis.Member]{data: ?MEMBERS[0], size: 3},
    models:   Slice[axis.Model]{data: ?MODELS[0], size: 2},
};
