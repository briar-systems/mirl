# the registers one placement draws from, and how far it has drawn
# ---
# integers: the general registers in order
# vectors:  the vector registers in order
# integer:  the next general register
# vector:   the next vector register
# stack:    the next free byte of the stack area
# spill:    whether anything may go on the stack, which no result may
# align:    the stack's alignment at a call
# even:     whether a value of 16 byte alignment starts at an even register
# natural:  whether stack arguments pack at their own size and alignment
# unnamed:  where an unnamed value travels
# extended: whether an integer narrower than 32 bits is extended by its
#           signedness, as darwinpcs has the caller extend it to 32 bits
# defined:  the row's passings for what the standards state none for
rec State {
    integers: Slice[rf.Id];
    vectors:  Slice[rf.Id];
    integer:  usize;
    vector:   usize;
    stack:    u64;
    spill:    bool;
    align:    u64;
    even:     bool;
    natural:  bool;
    unnamed:  Unnamed;
    extended: bool;
    defined:  Defined;
}

# what a homogeneous aggregate is made of
# ---
# size:  the bytes of one member
# float: whether the members are floats, else short vectors
# width: the bits of the members' float format, 0 for vectors
# count: how many members it has
rec Base {
    size:  u64;
    float: bool;
    width: u32;
    count: u32;
}

# one member of a homogeneous aggregate, at its offset
rec Member {
    offset: u64;
}

fun state(r: *Resolved, results: bool) State {
    var s: State;
    s.integer  = 0;
    s.vector   = 0;
    s.stack    = 0;
    s.align    = 0;
    s.spill    = !results;
    s.even     = sel r.row.pairs.even;
    s.natural  = sel r.row.packing.natural;
    s.unnamed  = r.row.variadic.unnamed;
    s.extended = sel r.row.narrow.declared;
    s.defined  = r.row.defined;
    if (sel r.row.stack.memory) { s.align = r.row.stack.memory.align; }
    s.integers = Slice[rf.Id]{data: nil, size: 0};
    s.vectors  = s.integers;
    val regs: *Registers = held(r);
    if (regs == nil) { ret s; }
    if (results) {
        s.integers = bank(?regs.returning, rf.GENERAL);
        s.vectors  = bank(?regs.returning, rf.VECTOR);
    }
    or {
        s.integers = bank(?regs.passing, rf.GENERAL);
        s.vectors  = bank(?regs.passing, rf.VECTOR);
    }
    ret s;
}

fun round(v: u64, to: u64) u64 {
    ret (v + to - 1) / to * to;
}

fun laid(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.size; }
    ret 0;
}

fun alignment(n: *Node) u64 {
    if (sel n.room.laid) { ret n.room.laid.align; }
    ret 1;
}

fun at(place: Place, offset: u64, size: u64, fill: Fill) Piece {
    ret Piece{place: place, offset: offset, size: size, scale: Scale.fixed{}, fill: fill};
}

# a short vector, of 8 or 16 bytes, which a vector register takes whole
fun short(n: *Node) bool {
    ret sel n.shape.vector && (laid(n) == 8 || laid(n) == 16);
}

# a float or a short vector, which a vector register takes
fun real(n: *Node) bool {
    ret sel n.shape.float || short(n);
}

# the fill of an integer in a general register or a slot: a condition is a
# byte of 0 or 1 above which nothing is stated, and under darwinpcs an integer
# narrower than 32 bits is extended to 32. a pointer and a 64 bit integer fill
# the register, and nothing else is stated
fun fill_integer(s: *State, n: *Node, size: u64) Fill {
    if (sel n.shape.integer) {
        val w: u32 = n.shape.integer;
        if (s.extended && w < 32) { ret Fill.declared{w}; }
    }
    if (size >= 8) { ret Fill.exact{}; }
    ret Fill.undefined{};
}

# a slot on the stack for `size` bytes at `align`, taking it from the state:
# at its own size and alignment where the row packs naturally, and in 8 byte
# slots otherwise, never aligned past the stack
fun slot(s: *State, size: u64, align: u64, natural: bool) u64 {
    var to:   u64 = align;
    var used: u64 = size;
    if (!natural) {
        if (to < 8) { to = 8; }
        used = round(size, 8);
    }
    if (to > s.align) { to = s.align; }
    val off: u64 = round(s.stack, to);
    s.stack = off + used;
    ret off;
}

# the base of a homogeneous aggregate a node is, by aapcs64's definition
# (section "homogeneous aggregates"): every leaf is a float of one format or a
# short vector of one size, a union counting its largest member, with no
# padding, one to four members. false when it is none
fun homogeneous(v: *View, at_node: u32, base: *Base) bool {
    val n: *Node = view.node(v, at_node);
    if (sel n.shape.float) {
        if (base.count == 0) {
            base.size  = laid(n);
            base.float = true;
            base.width = n.shape.float.width;
        }
        or (!base.float || base.width != n.shape.float.width) {
            ret false;
        }
        base.count = base.count + 1;
        ret true;
    }
    if (short(n)) {
        if (base.count == 0) {
            base.size  = laid(n);
            base.float = false;
            base.width = 0;
        }
        or (base.float || base.size != laid(n)) {
            ret false;
        }
        base.count = base.count + 1;
        ret true;
    }
    if (sel n.shape.structure) {
        var k: u32 = 0;
        for (k < n.count) {
            if (!homogeneous(v, view.child(v, at_node, k), base)) { ret false; }
            k = k + 1;
        }
        ret true;
    }
    if (sel n.shape.array) {
        val e: u32 = view.child(v, at_node, 0);
        var i: u64 = 0;
        for (i < n.shape.array.count) {
            if (!homogeneous(v, e, base)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel n.shape.union) {
        var most: u32 = 0;
        var k:    u32 = 0;
        for (k < n.count) {
            val before: u32 = base.count;
            if (!homogeneous(v, view.child(v, at_node, k), base)) { ret false; }
            val took: u32 = base.count - before;
            base.count = before;
            if (took > most) { most = took; }
            k = k + 1;
        }
        base.count = base.count + most;
        ret true;
    }
    ret false;
}

# the base of a node that is a homogeneous aggregate, none when it is not one
fun aggregate_base(v: *View, at_node: u32) opt[Base] {
    val n: *Node = view.node(v, at_node);
    if (!view.aggregate(n)) { ret opt[Base].none{}; }
    var b: Base = Base{size: 0, float: false, width: 0, count: 0};
    if (!homogeneous(v, at_node, ?b))     { ret opt[Base].none{}; }
    if (b.count == 0 || b.count > 4)      { ret opt[Base].none{}; }
    if (b.size * b.count::u64 != laid(n)) { ret opt[Base].none{}; }
    ret opt[Base].some{b};
}

# the offsets of a homogeneous aggregate's members, in order
fun members(v: *View, at_node: u32, base: u64, out: *Member, count: *u32) {
    val n: *Node = view.node(v, at_node);
    if (sel n.shape.float || short(n)) {
        out[@count] = Member{offset: base};
        @count      = @count + 1;
        ret;
    }
    if (sel n.shape.structure) {
        var k: u32 = 0;
        for (k < n.count) {
            val c: u32 = view.child(v, at_node, k);
            members(v, c, base + view.node(v, c).offset, out, count);
            k = k + 1;
        }
        ret;
    }
    if (sel n.shape.array) {
        val e: u32 = view.child(v, at_node, 0);
        var i: u64 = 0;
        for (i < n.shape.array.count) {
            members(v, e, base + i * n.shape.array.stride, out, count);
            i = i + 1;
        }
        ret;
    }
    if (sel n.shape.union) {
        # the largest member, which every other overlays at offset 0
        var best: u32 = 0;
        var most: u32 = 0;
        var k:    u32 = 0;
        for (k < n.count) {
            var b: Base = Base{size: 0, float: false, width: 0, count: 0};
            val c: u32  = view.child(v, at_node, k);
            if (homogeneous(v, c, ?b) && b.count > most) {
                most = b.count;
                best = c;
            }
            k = k + 1;
        }
        if (most > 0) { members(v, best, base, out, count); }
    }
}

# place a value on the stack whole, at its alignment, a composite rounded to
# 8, a composite or an integer wider than 8 bytes in a piece per 8 bytes
fun stacked_value(s: *State, asg: *Assignment, n: *Node, natural: bool) err[piece.Error] {
    var size: u64 = laid(n);
    if (view.aggregate(n)) { size = round(size, 8); }
    val off: u64 = slot(s, size, alignment(n), natural);
    if (view.aggregate(n) || (sel n.shape.integer && laid(n) > 8)) { ret piece.add_laid(asg, off, laid(n), 8, Fill.exact{}); }
    if (laid(n) > 8)                                               { ret piece.add(asg, at(stacked(off), 0, laid(n), Fill.exact{})); }
    ret piece.add(asg, at(stacked(off), 0, laid(n), fill_integer(s, n, laid(n))));
}

# the address of a copy, in a general register or a slot
fun address(s: *State) Piece {
    if (s.integer < s.integers.size) {
        s.integer = s.integer + 1;
        ret at(Place.register{s.integers.data[s.integer - 1]}, 0, 8, Fill.exact{});
    }
    ret at(stacked(slot(s, 8, 8, false)), 0, 8, Fill.exact{});
}

# pass a value by reference to a copy, its address taking a word where it may spill
fun copied(s: *State, asg: *Assignment, n: *Node, passing: *Passing) err[piece.Error] {
    @passing = Passing.reference{Copy{size: laid(n), align: alignment(n)}};
    if (!s.spill) { ret err[piece.Error].ok{}; }
    ret piece.add(asg, address(s));
}

# a homogeneous aggregate in consecutive vector registers, true when they were free
fun vectors(s: *State, asg: *Assignment, v: *View, at_node: u32, b: Base, out: *bool) err[piece.Error] {
    @out = false;
    if (s.vector + b.count::usize > s.vectors.size) {
        s.vector = s.vectors.size;
        ret err[piece.Error].ok{};
    }
    var list:  [4]Member;
    var count: u32 = 0;
    members(v, at_node, 0, ?list[0], ?count);
    var i: u32 = 0;
    for (i < count) {
        val added: err[piece.Error] = piece.add(asg, at(Place.register{s.vectors.data[s.vector]}, list[i].offset, b.size, Fill.undefined{}));
        if (sel added.err) { ret added; }
        s.vector = s.vector + 1;
        i        = i + 1;
    }
    @out = true;
    ret err[piece.Error].ok{};
}

# an integer, a pointer or a composite of up to 16 bytes in general registers
fun integer(s: *State, asg: *Assignment, n: *Node, at_node: u32) err[piece.Error] {
    val size:  u64 = laid(n);
    val words: u64 = round(size, 8) / 8;
    if (size <= 8 && s.integer < s.integers.size) {
        var fill: Fill = fill_integer(s, n, size);
        if (view.aggregate(n)) { fill = Fill.undefined{}; }
        if (size == 8)         { fill = Fill.exact{}; }
        s.integer = s.integer + 1;
        ret piece.add(asg, at(Place.register{s.integers.data[s.integer - 1]}, 0, size, fill));
    }
    if (s.even && alignment(n) == 16 && s.integer % 2 == 1) { s.integer = s.integer + 1; }
    if (words == 2 && s.integer + 2 <= s.integers.size) {
        val low: err[piece.Error] = piece.add(asg, at(Place.register{s.integers.data[s.integer]}, 0, 8, Fill.exact{}));
        if (sel low.err) { ret low; }
        s.integer = s.integer + 2;
        var fill: Fill = Fill.undefined{};
        if (size == 16) { fill = Fill.exact{}; }
        ret piece.add(asg, at(Place.register{s.integers.data[s.integer - 1]}, 8, size - 8, fill));
    }
    if (!s.spill) { ret err[piece.Error].err{piece.Error.room{at_node}}; }
    s.integer = s.integers.size;
    ret stacked_value(s, asg, n, s.natural);
}

# place one value, as an argument or a result, and say how it travels
# place one argument of a variadic call under a row that places every one as
# the words of one area whose first 64 bytes x0 to x7 hold and the rest are
# the stack's (microsoft's arm64 abi, "addendum: variadic functions", which
# states it as rules c.12 to c.15 over that area): no vector register is
# taken and no composite is an hfa or hva, so a composite wider than 16 bytes
# travels by reference (b.3), and each value starts at the larger of 8 and
# its alignment, its size rounded up to 8, a value the registers' end
# crosses split between x7 and the stack
fun general(s: *State, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[piece.Error] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[piece.Error].err{piece.Error.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (sel n.shape.vector && !short(n)) {
        if (sel s.defined.vectors.reference) { ret copied(s, asg, n, passing); }
        ret err[piece.Error].err{piece.Error.unstated{value.node}};
    }
    if (sel value.by.reference)         { ret copied(s, asg, n, passing); }
    if (size == 0)                      { ret err[piece.Error].ok{}; }
    if (view.aggregate(n) && size > 16) { ret copied(s, asg, n, passing); }
    val held: u64 = s.integers.size::u64 * 8;
    var area: u64 = held + s.stack;
    if (s.integer < s.integers.size) { area = s.integer::u64 * 8; }
    var to: u64 = alignment(n);
    if (to < 8)       { to = 8; }
    if (to > s.align) { to = s.align; }
    val start: u64 = round(area, to);
    val used:  u64 = round(size, 8);
    var word:  u64 = 0;
    for (word < used) {
        var bytes: u64 = size - word;
        if (bytes > 8) { bytes = 8; }
        var fill: Fill = Fill.undefined{};
        if (bytes == 8)                                  { fill = Fill.exact{}; }
        or (used == 8 && !view.aggregate(n) && !real(n)) { fill = fill_integer(s, n, size); }
        val off:   u64   = start + word;
        var where: Place = stacked(0);
        if (off < held) { where = Place.register{s.integers.data[off / 8]}; }
        or              { where = stacked(off - held); }
        val added: err[piece.Error] = piece.add(asg, at(where, word, bytes, fill));
        if (sel added.err) { ret added; }
        word = word + 8;
    }
    val end: u64 = start + used;
    if (end <= held) { s.integer = (end / 8)::usize; }
    or {
        s.integer = s.integers.size;
        s.stack   = end - held;
    }
    ret err[piece.Error].ok{};
}

# place one argument of a variadic call under a row that places every one as
# a word of its own, as x64 does (microsoft's "x64 calling convention",
# "parameter passing" and "varargs", which arm64ec follows for a variadic
# call): a composite of 1, 2, 4 or 8 bytes and a scalar of up to 8 travel in
# the word, a float as its bits, and anything else by reference, its address
# taking the word. the words fill the general registers the state holds,
# which `arguments` cuts to the row's, and then 8 byte slots
fun word(s: *State, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[piece.Error] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[piece.Error].err{piece.Error.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (sel n.shape.vector && !short(n)) {
        if (sel s.defined.vectors.reference) { ret copied(s, asg, n, passing); }
        ret err[piece.Error].err{piece.Error.unstated{value.node}};
    }
    if (sel value.by.reference) { ret copied(s, asg, n, passing); }
    if (size == 0)              { ret err[piece.Error].ok{}; }
    val whole: bool = size == 1 || size == 2 || size == 4 || size == 8;
    if (size > 8 || (view.aggregate(n) && !whole)) { ret copied(s, asg, n, passing); }
    var fill: Fill = Fill.undefined{};
    if (size == 8)                      { fill = Fill.exact{}; }
    or (!view.aggregate(n) && !real(n)) { fill = fill_integer(s, n, size); }
    if (s.integer < s.integers.size) {
        s.integer = s.integer + 1;
        ret piece.add(asg, at(Place.register{s.integers.data[s.integer - 1]}, 0, size, fill));
    }
    ret piece.add(asg, at(stacked(slot(s, 8, 8, false)), 0, size, fill));
}

fun place(s: *State, asg: *Assignment, v: *View, value: Value, passing: *Passing) err[piece.Error] {
    val n: *Node = view.node(v, value.node);
    if (sel n.room.unsized) { ret err[piece.Error].err{piece.Error.unsized{value.node}}; }
    val size: u64 = laid(n);
    @passing = Passing.value{};
    if (sel n.shape.vector && !short(n)) {
        if (sel s.defined.vectors.reference) { ret copied(s, asg, n, passing); }
        ret err[piece.Error].err{piece.Error.unstated{value.node}};
    }
    if (sel value.by.reference) { ret copied(s, asg, n, passing); }
    if (size == 0)              { ret err[piece.Error].ok{}; }
    if (!value.named && sel s.unnamed.stack) {
        val whole: opt[Base] = aggregate_base(v, value.node);
        if (view.aggregate(n) && size > 16 && sel whole.none) { ret copied(s, asg, n, passing); }
        ret stacked_value(s, asg, n, false);
    }
    if (real(n)) {
        if (s.vector < s.vectors.size) {
            s.vector = s.vector + 1;
            ret piece.add(asg, at(Place.register{s.vectors.data[s.vector - 1]}, 0, size, Fill.undefined{}));
        }
        if (!s.spill) { ret err[piece.Error].err{piece.Error.room{value.node}}; }
        ret stacked_value(s, asg, n, s.natural);
    }
    val b: opt[Base] = aggregate_base(v, value.node);
    if (sel b.some) {
        var done: bool             = false;
        val regs: err[piece.Error] = vectors(s, asg, v, value.node, b.some, ?done);
        if (sel regs.err) { ret regs; }
        if (done)         { ret regs; }
        if (!s.spill)     { ret err[piece.Error].err{piece.Error.room{value.node}}; }
        ret stacked_value(s, asg, n, s.natural);
    }
    if (size > 16) { ret copied(s, asg, n, passing); }
    ret integer(s, asg, n, value.node);
}

# mirl-defined, no spec states this: a vector of another size than a short
# vector's travels by reference to a copy, as a composite wider than 16
# bytes does (b.4)
val AARCH64_DEFINED: Defined = Defined{vectors: Passage.reference{}, wide: Passage.stated{}, halves: Passage.stated{}};

# the result classifier of both rows
fun results(r: *Resolved, call: *Call, asg: *Assignment) err[piece.Error] {
    if (call.results.size > 1) { ret err[piece.Error].err{piece.Error.results{call.results.size::u32}}; }
    var s: State = state(r, true);
    var i: usize = 0;
    for (i < call.results.size) {
        val first:   u32              = piece.open(asg);
        var passing: Passing;
        val placed:  err[piece.Error] = place(?s, asg, call.view, call.results.data[i], ?passing);
        if (sel placed.err) { ret placed; }
        val closed: err[piece.Error] = piece.close(asg, true, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    ret err[piece.Error].ok{};
}

# the argument classifier of both rows. a result by reference has its address
# in the row's indirect register, which takes no argument register
fun arguments(r: *Resolved, call: *Call, asg: *Assignment) err[piece.Error] {
    var s:       State   = state(r, false);
    val carrier: Carrier = r.row.indirect.carrier;
    var i:       usize   = 0;
    for (i < asg.results.len) {
        if (sel asg.results.data[i].passing.reference) {
            if (sel carrier.register) { asg.address = opt[Piece].some{at(Place.register{carrier.register}, 0, 8, Fill.exact{})}; }
        }
        i = i + 1;
    }
    # a row placing a variadic call's arguments as words takes only its first
    # general registers for them
    var worded: bool = false;
    if (call.variadic) {
        if (sel s.unnamed.words) {
            worded = true;
            val k: usize = s.unnamed.words.registers::usize;
            if (s.integers.size > k) { s.integers.size = k; }
        }
    }
    i = 0;
    for (i < call.arguments.size) {
        val first:   u32              = piece.open(asg);
        var passing: Passing;
        var placed:  err[piece.Error] = err[piece.Error].ok{};
        if (call.variadic && sel s.unnamed.general) { placed = general(?s, asg, call.view, call.arguments.data[i], ?passing); }
        or (worded)                                 { placed = word(?s, asg, call.view, call.arguments.data[i], ?passing); }
        or                                          { placed = place(?s, asg, call.view, call.arguments.data[i], ?passing); }
        if (sel placed.err)                         { ret placed; }
        val closed: err[piece.Error] = piece.close(asg, false, passing, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    asg.stack = round(s.stack, 8);
    ret err[piece.Error].ok{};
}

# the tail rule of both rows: nothing on the stack and no result by reference
fun tail(r: *Resolved, asg: *Assignment) bool {
    ret asg.stack == 0 && sel asg.address.none;
}

val CLASSIFIERS: Classifiers = Classifiers{results: results, arguments: arguments};

# x0 to x7 and v0 to v7, for arguments and results alike
val PASSING: [16]rf.Id = [16]rf.Id{
    gen_register.X0, gen_register.X1, gen_register.X2, gen_register.X3, gen_register.X4, gen_register.X5, gen_register.X6, gen_register.X7,
    gen_register.V0, gen_register.V1, gen_register.V2, gen_register.V3, gen_register.V4, gen_register.V5, gen_register.V6, gen_register.V7,
};

# the stack pointer, x19 to x29, kept whole, and the low 64 bits of v8 to
# v15, which a callee keeps (aapcs64 "simd and floating-point registers"). a
# view within a kept register, as w19 of x19, is kept with it, and the frame
# saves the register it lies within
val PRESERVED: [20]Kept = [20]Kept{
    Kept{register: gen_register.SP, bits: Part.whole{}},
    Kept{register: gen_register.X19, bits: Part.whole{}}, Kept{register: gen_register.X20, bits: Part.whole{}}, Kept{register: gen_register.X21, bits: Part.whole{}},
    Kept{register: gen_register.X22, bits: Part.whole{}}, Kept{register: gen_register.X23, bits: Part.whole{}}, Kept{register: gen_register.X24, bits: Part.whole{}},
    Kept{register: gen_register.X25, bits: Part.whole{}}, Kept{register: gen_register.X26, bits: Part.whole{}}, Kept{register: gen_register.X27, bits: Part.whole{}},
    Kept{register: gen_register.X28, bits: Part.whole{}}, Kept{register: gen_register.X29, bits: Part.whole{}},
    Kept{register: gen_register.V8, bits: Part.low{64}}, Kept{register: gen_register.V9, bits: Part.low{64}}, Kept{register: gen_register.V10, bits: Part.low{64}},
    Kept{register: gen_register.V11, bits: Part.low{64}}, Kept{register: gen_register.V12, bits: Part.low{64}}, Kept{register: gen_register.V13, bits: Part.low{64}},
    Kept{register: gen_register.V14, bits: Part.low{64}}, Kept{register: gen_register.V15, bits: Part.low{64}},
};

# the float control and status registers, whose modes and accrued flags have
# thread storage duration, and the thread pointer, which no call changes.
# darwinpcs reserves the platform register x18 as well, and aapcs64win
# reserves it as the pointer to the thread's teb (microsoft's arm64 abi,
# "integer registers")
val RESERVED: [5]rf.Id = [5]rf.Id{gen_register.FPCR, gen_register.FPSR, gen_register.TPIDR_EL0, gen_register.X18, gen_register.W18};

# what a call to a thread-local descriptor's resolver leaves undefined. the
# elf tlsdesc resolver keeps every register but x0, the link register and the
# flags (the tls descriptors proposal aaelf64 cites for them), and the thunk of a mach-o thread-local
# variable descriptor may also clobber x9 to x17 (the mach-o tlv abi of ld64
# and dyld)
val ELF_DESCRIPTOR:    [5]rf.Id  = [5]rf.Id{gen_register.X0, gen_register.W0, gen_register.X30, gen_register.W30, gen_register.NZCV_FLAGS};
val DARWIN_DESCRIPTOR: [23]rf.Id = [23]rf.Id{
    gen_register.X0, gen_register.W0, gen_register.X9, gen_register.W9, gen_register.X10, gen_register.W10, gen_register.X11, gen_register.W11, gen_register.X12, gen_register.W12, gen_register.X13, gen_register.W13,
    gen_register.X14, gen_register.W14, gen_register.X15, gen_register.W15, gen_register.X16, gen_register.W16, gen_register.X17, gen_register.W17, gen_register.X30, gen_register.W30, gen_register.NZCV_FLAGS,
};

# x29 heads a record of the caller's frame pointer and the return address,
# 16 bytes below the canonical frame address, and the link register is x30.
# saves are paired, the record first. darwin keeps the frame pointer in every
# function and describes its frames by compact unwind, and leaves 128 bytes
# below the stack pointer to a leaf
val AAPCS64_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          0,
    shadow:       0,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: false}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.none{}, pair_saves: true, apart: false, unwind: Unwind.dwarf{}},
}};
val DARWIN_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          128,
    shadow:       0,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: true}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.none{}, pair_saves: true, apart: false, unwind: Unwind.compact{}},
}};

# windows keeps the frame pointer in every function, pointing at the record
# of the caller's x29 and x30 (microsoft's arm64 abi, "integer registers" and
# "stack walking"), leaves no red zone a leaf may use, since the 16 bytes
# below the stack pointer are reserved for patching ("red zone"), and
# touches each page of a frame of 4096 bytes or more through __mirl_chkstk,
# mirl's own routine of the c run time's __chkstk contract, which takes the
# bytes over 16 in x15 ("stack"). the saves take a move of their
# own and the locals a second, so the frame pointer set at the saves is in
# reach of the unwind codes and the probe's call finds the link register
# saved ("arm64 exception handling", the canonical prologue)
val AAPCS64WIN_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          0,
    shadow:       0,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: true}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.page{Page{bytes: 4096, helper: opt[str].some{"__mirl_chkstk"}}}, pair_saves: true, apart: true, unwind: Unwind.seh_arm64{}},
}};

# a result too wide for registers travels by reference, its address in x8
val INDIRECT: Indirect = Indirect{carrier: Carrier.register{gen_register.X8}, returned: Returned.none{}};

# aapcs64 passes an unnamed value as a named one and its va_list is a record
# of 32 bytes, aligned to 8 ("appendix: variable argument lists", "the
# va_list type")
val AAPCS64_VARIADIC: Variadic = Variadic{unnamed: Unnamed.named{}, count: Count.none{}, list: List.areas{Areas{size: 32, align: 8}}};
# darwinpcs passes every unnamed value on the stack and its va_list is a char
# pointer walking it (apple's "writing arm64 code for apple platforms",
# "update code that passes arguments to variadic functions")
val DARWIN_VARIADIC: Variadic = Variadic{unnamed: Unnamed.stack{}, count: Count.none{}, list: List.pointer{}};
# aapcs64win passes every argument of a variadic call in x0 to x7 and then
# on the stack, as one area, and its va_list is one pointer into the area the
# callee stores x0 to x7 to just below the stack arguments (microsoft's arm64
# abi, "addendum: variadic functions")
val AAPCS64WIN_VARIADIC: Variadic = Variadic{unnamed: Unnamed.general{}, count: Count.none{}, list: List.pointer{}};

# both rows need the floating-point and advanced simd registers they pass in,
# which every aarch64 linux and darwin baseline holds
val FP_ATOMS: [2]requirement.Id          = [2]requirement.Id{aarch64_extension.FP, aarch64_extension.SIMD};
val NEEDS:    [1]requirement.Alternative = [1]requirement.Alternative{requirement.Alternative{all: requirement.Ids{at: ?FP_ATOMS[0], len: 2}, none: requirement.NO_IDS}};
val NEEDS_FP: requirement.Requirement    = requirement.Requirement{at: ?NEEDS[0], len: 1};

# aapcs64, linux's and freestanding's
pub val AAPCS64: Convention = Convention{
    abi:         ?arch_aarch64.AARCH64_AAPCS64,
    role:        Role.own{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?PASSING[0], size: 16},
    returning:   Slice[rf.Id]{data: ?PASSING[0], size: 16},
    preserved:   Slice[Kept]{data: ?PRESERVED[0], size: $length_of(PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?RESERVED[0], size: 3},
    stack:       AAPCS64_FRAME,
    indirect:    INDIRECT,
    variadic:    AAPCS64_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
    descriptor:  opt[Slice[rf.Id]].some{Slice[rf.Id]{data: ?ELF_DESCRIPTOR[0], size: 5}},
};

# darwinpcs, apple's arm64 abi
pub val DARWINPCS: Convention = Convention{
    abi:         ?arch_aarch64.AARCH64_DARWINPCS,
    role:        Role.own{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?PASSING[0], size: 16},
    returning:   Slice[rf.Id]{data: ?PASSING[0], size: 16},
    preserved:   Slice[Kept]{data: ?PRESERVED[0], size: $length_of(PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?RESERVED[0], size: 5},
    stack:       DARWIN_FRAME,
    indirect:    INDIRECT,
    variadic:    DARWIN_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.declared{},
    pairs:       Pairs.even{},
    packing:     Packing.natural{},
    tail:        tail,
    descriptor:  opt[Slice[rf.Id]].some{Slice[rf.Id]{data: ?DARWIN_DESCRIPTOR[0], size: 23}},
};

# aapcs64win, windows' arm64 abi, which follows aapcs64 for every call but a
# variadic one (microsoft's arm64 abi, "parameter passing"): x0 to x7 and v0
# to v7 pass and return, a wide result's address travels in x8 ("return
# values"), x19 to x29 and the low 64 bits of v8 to v15 are kept ("integer
# registers" and "floating-point/simd registers"), and x18 is reserved.
# narrow integers, 16 byte alignment pairing and slot packing are aapcs64's,
# which the abi states it follows, and a vector of no short vector's size is
# mirl-defined as under aapcs64
pub val AAPCS64WIN: Convention = Convention{
    abi:         ?arch_aarch64.AARCH64_AAPCS64WIN,
    role:        Role.own{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?PASSING[0], size: 16},
    returning:   Slice[rf.Id]{data: ?PASSING[0], size: 16},
    preserved:   Slice[Kept]{data: ?PRESERVED[0], size: $length_of(PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?RESERVED[0], size: 5},
    stack:       AAPCS64WIN_FRAME,
    indirect:    INDIRECT,
    variadic:    AAPCS64WIN_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
};

# the registers arm64ec maps to x64's, so that an x64 register context can
# always be taken of a thread running it (microsoft's arm64ec abi, "register
# mapping"): x13, x14, x23, x24 and x28 and v16 to v31 map to none and are
# never used, so no call clobbers them and nothing allocates them, each with
# every view of it. x18 holds the teb, as under aapcs64win
val ARM64EC_RESERVED: [127]rf.Id = [127]rf.Id{
    gen_register.FPCR, gen_register.FPSR, gen_register.TPIDR_EL0, gen_register.X18, gen_register.W18,
    gen_register.X13, gen_register.W13, gen_register.X14, gen_register.W14, gen_register.X23, gen_register.W23, gen_register.X24, gen_register.W24, gen_register.X28, gen_register.W28,
    gen_register.V16, gen_register.V17, gen_register.V18, gen_register.V19, gen_register.V20, gen_register.V21, gen_register.V22, gen_register.V23, gen_register.V24, gen_register.V25, gen_register.V26, gen_register.V27, gen_register.V28, gen_register.V29, gen_register.V30, gen_register.V31,
    gen_register.Q16, gen_register.Q17, gen_register.Q18, gen_register.Q19, gen_register.Q20, gen_register.Q21, gen_register.Q22, gen_register.Q23, gen_register.Q24, gen_register.Q25, gen_register.Q26, gen_register.Q27, gen_register.Q28, gen_register.Q29, gen_register.Q30, gen_register.Q31,
    gen_register.D16, gen_register.D17, gen_register.D18, gen_register.D19, gen_register.D20, gen_register.D21, gen_register.D22, gen_register.D23, gen_register.D24, gen_register.D25, gen_register.D26, gen_register.D27, gen_register.D28, gen_register.D29, gen_register.D30, gen_register.D31,
    gen_register.S16, gen_register.S17, gen_register.S18, gen_register.S19, gen_register.S20, gen_register.S21, gen_register.S22, gen_register.S23, gen_register.S24, gen_register.S25, gen_register.S26, gen_register.S27, gen_register.S28, gen_register.S29, gen_register.S30, gen_register.S31,
    gen_register.H16, gen_register.H17, gen_register.H18, gen_register.H19, gen_register.H20, gen_register.H21, gen_register.H22, gen_register.H23, gen_register.H24, gen_register.H25, gen_register.H26, gen_register.H27, gen_register.H28, gen_register.H29, gen_register.H30, gen_register.H31,
    gen_register.B16, gen_register.B17, gen_register.B18, gen_register.B19, gen_register.B20, gen_register.B21, gen_register.B22, gen_register.B23, gen_register.B24, gen_register.B25, gen_register.B26, gen_register.B27, gen_register.B28, gen_register.B29, gen_register.B30, gen_register.B31,
    gen_register.Z16, gen_register.Z17, gen_register.Z18, gen_register.Z19, gen_register.Z20, gen_register.Z21, gen_register.Z22, gen_register.Z23, gen_register.Z24, gen_register.Z25, gen_register.Z26, gen_register.Z27, gen_register.Z28, gen_register.Z29, gen_register.Z30, gen_register.Z31,
};

# the registers an arm64ec callee keeps: aapcs64win's but x23, x24 and x28,
# which it never uses ("register mapping for integer registers"), and the low
# 64 bits of v8 to v15 ("register mapping for vector registers")
val ARM64EC_PRESERVED: [17]Kept = [17]Kept{
    Kept{register: gen_register.SP, bits: Part.whole{}}, Kept{register: gen_register.X19, bits: Part.whole{}}, Kept{register: gen_register.X20, bits: Part.whole{}}, Kept{register: gen_register.X21, bits: Part.whole{}}, Kept{register: gen_register.X22, bits: Part.whole{}}, Kept{register: gen_register.X25, bits: Part.whole{}}, Kept{register: gen_register.X26, bits: Part.whole{}}, Kept{register: gen_register.X27, bits: Part.whole{}}, Kept{register: gen_register.X29, bits: Part.whole{}},
    Kept{register: gen_register.V8, bits: Part.low{64}}, Kept{register: gen_register.V9, bits: Part.low{64}}, Kept{register: gen_register.V10, bits: Part.low{64}}, Kept{register: gen_register.V11, bits: Part.low{64}}, Kept{register: gen_register.V12, bits: Part.low{64}}, Kept{register: gen_register.V13, bits: Part.low{64}}, Kept{register: gen_register.V14, bits: Part.low{64}}, Kept{register: gen_register.V15, bits: Part.low{64}},
};

# arm64ec's frame is aapcs64win's, its probe the routine of its own name,
# __mirl_chkstk_arm64ec, mirl's own of __chkstk_arm64ec's contract, which
# takes the same x15 ("register mapping", the helper
# routines' registers being in the subset)
val ARM64EC_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          0,
    shadow:       0,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: true}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.page{Page{bytes: 4096, helper: opt[str].some{"__mirl_chkstk_arm64ec"}}}, pair_saves: true, apart: true, unwind: Unwind.seh_arm64{}},
}};

# arm64ec places a variadic call's arguments as x64 does, one word each, the
# first four in x0 to x3, which map to rcx, rdx, r8 and r9, and the rest in
# the stack's slots, the callee finding them through x4, the address of the
# first stack word, and x5, their bytes. its va_list is one pointer, x64's
val ARM64EC_VARIADIC: Variadic = Variadic{unnamed: Unnamed.words{Words{registers: 4, address: gen_register.X4, size: gen_register.X5}}, count: Count.none{}, list: List.pointer{}};

# arm64ec, the arm64 code of an image whose code interoperates with x64's
# (microsoft's "overview of arm64ec abi conventions"). its calling convention
# maps directly to arm64's ("register mapping"), so a call passes and returns
# as under aapcs64win in x0 to x7 and v0 to v7, a wide result's address in
# x8, but a variadic one, which follows x64. it keeps fewer registers and
# reserves the ones it maps to no x64 register. its data is laid out as
# x64's is ("struct packing"), which for every type the ir has is the lp64
# layout aapcs64 states
pub val ARM64EC: Convention = Convention{
    abi:         ?arch_aarch64.ARM64EC_ARM64EC,
    role:        Role.own{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?PASSING[0], size: 16},
    returning:   Slice[rf.Id]{data: ?PASSING[0], size: 16},
    preserved:   Slice[Kept]{data: ?ARM64EC_PRESERVED[0], size: $length_of(ARM64EC_PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?ARM64EC_RESERVED[0], size: $length_of(ARM64EC_RESERVED)},
    stack:       ARM64EC_FRAME,
    indirect:    INDIRECT,
    variadic:    ARM64EC_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
    bridging:    opt[*Bridging].some{?ARM64EC_BRIDGING},
};

# the x64 registers arm64ec maps x64's nonvolatile ones to ("register
# mapping"): rsp the stack pointer, rbx x27, rbp x29, rsi x25, rdi x26, r12
# to r15 x19 to x22, and xmm6 to xmm15 v6 to v15, each kept whole, which a
# function x64 code calls keeps (microsoft's "x64 calling convention",
# "callee/caller saved registers"). arm64's unwinder restores a vector
# register's low 64 bits of a save that states no width, so each vector one
# states that, and its saves state their 16 bytes
val ARM64EC_X64_PRESERVED: [19]Kept = [19]Kept{
    Kept{register: gen_register.SP, bits: Part.whole{}}, Kept{register: gen_register.X27, bits: Part.whole{}}, Kept{register: gen_register.X29, bits: Part.whole{}},
    Kept{register: gen_register.X25, bits: Part.whole{}}, Kept{register: gen_register.X26, bits: Part.whole{}},
    Kept{register: gen_register.X19, bits: Part.whole{}}, Kept{register: gen_register.X20, bits: Part.whole{}}, Kept{register: gen_register.X21, bits: Part.whole{}}, Kept{register: gen_register.X22, bits: Part.whole{}},
    Kept{register: gen_register.V6, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V7, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V8, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V9, bits: Part.whole{}, natural: 64},
    Kept{register: gen_register.V10, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V11, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V12, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V13, bits: Part.whole{}, natural: 64},
    Kept{register: gen_register.V14, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V15, bits: Part.whole{}, natural: 64},
};

# x64's argument registers in the arm64 registers they map to: rcx, rdx, r8
# and r9 in x0 to x3, xmm0 to xmm3 in v0 to v3, and its result registers, rax
# in x8 and xmm0 in v0
val ARM64EC_X64_PASSING:   [8]rf.Id = [8]rf.Id{gen_register.X0, gen_register.X1, gen_register.X2, gen_register.X3, gen_register.V0, gen_register.V1, gen_register.V2, gen_register.V3};
val ARM64EC_X64_RETURNING: [2]rf.Id = [2]rf.Id{gen_register.X8, gen_register.V0};

# an x64 caller passes a result's address as its first argument and is handed
# it back in rax, x8
val ARM64EC_X64_INDIRECT: Indirect = Indirect{carrier: Carrier.first{}, returned: Returned.register{gen_register.X8}};

# a thunk is of no variadic signature
val ARM64EC_THUNK_VARIADIC: Variadic = Variadic{unnamed: Unnamed.none{}, count: Count.none{}, list: List.pointer{}};

# the frame of a function x64 code enters, an entry thunk: arm64ec's, which
# leaves through __os_arm64x_dispatch_ret in place of returning, the link
# register holding the x64 caller's return address ("entry thunks")
val ARM64EC_X64_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          0,
    shadow:       0,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: true}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.page{Page{bytes: 4096, helper: opt[str].some{"__mirl_chkstk_arm64ec"}}}, pair_saves: true, apart: true, unwind: Unwind.seh_arm64{}},
    exit:         opt[str].some{"__os_arm64x_dispatch_ret"},
}};

# the frame of a function that calls x64 code, an exit thunk: arm64ec's, with
# x64's 32 bytes of home space above the arguments it passes ("exit thunks")
val ARM64EC_NATIVE_FRAME: Stack = Stack.memory{Frame{
    align:        16,
    red:          0,
    shadow:       32,
    link:         Link.register{gen_register.X30},
    pointer:      Pointer.register{Keeper{register: gen_register.X29, record: Record.linked{Linked{pointer: -16, previous: -16, link: -8}}, always: true}},
    pointer_home: Home.register{gen_register.SP},
    prologue:     Prologue{probe: Probe.page{Page{bytes: 4096, helper: opt[str].some{"__mirl_chkstk_arm64ec"}}}, pair_saves: true, apart: true, unwind: Unwind.seh_arm64{}},
}};

# the x64 side of an arm64ec bridge: x64's placement by position in the arm64
# registers x64's map to, the callee's address leading in x9 ("entry thunks",
# "exit thunks"). an entry thunk is entered under it and an exit thunk calls
# the emulator under it. x64 code keeps more than arm64ec code, so an entry
# thunk saves what its native callee does not keep, xmm6 to xmm15 whole among
# it
pub val ARM64EC_X64: Convention = Convention{
    abi:         ?arch_aarch64.ARM64EC_ARM64EC,
    role:        Role.x64{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: x86_abi.WIN_CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{64},
    passing:     Slice[rf.Id]{data: ?ARM64EC_X64_PASSING[0], size: 8},
    returning:   Slice[rf.Id]{data: ?ARM64EC_X64_RETURNING[0], size: 2},
    preserved:   Slice[Kept]{data: ?ARM64EC_X64_PRESERVED[0], size: $length_of(ARM64EC_X64_PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?ARM64EC_RESERVED[0], size: $length_of(ARM64EC_RESERVED)},
    stack:       ARM64EC_X64_FRAME,
    indirect:    ARM64EC_X64_INDIRECT,
    variadic:    ARM64EC_THUNK_VARIADIC,
    half:        Half.float{},
    defined:     x86_abi.WIN_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        tail,
    leading:     opt[rf.Id].some{gen_register.X9},
};

# arm64ec with the callee's address leading in x9, which a checked call
# hands the address the check found and an exit thunk takes it in ("exit
# thunks"). a native callee leaves x9 alone, as no argument travels in it
pub val ARM64EC_NATIVE: Convention = Convention{
    abi:         ?arch_aarch64.ARM64EC_ARM64EC,
    role:        Role.native{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?PASSING[0], size: 16},
    returning:   Slice[rf.Id]{data: ?PASSING[0], size: 16},
    preserved:   Slice[Kept]{data: ?ARM64EC_PRESERVED[0], size: $length_of(ARM64EC_PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?ARM64EC_RESERVED[0], size: $length_of(ARM64EC_RESERVED)},
    stack:       ARM64EC_NATIVE_FRAME,
    indirect:    INDIRECT,
    variadic:    ARM64EC_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.even{},
    packing:     Packing.slot{},
    tail:        tail,
    leading:     opt[rf.Id].some{gen_register.X9},
};

# what the check of an indirect callee keeps: arm64ec's, the argument
# registers x0 to x8 and v0 to v7 whole, so a call's arguments may be placed
# before it, and x15 (llvm's CSR_Win_AArch64_Arm64EC_CFGuard_Check, over
# microsoft's "understanding arm64ec abi and assembly code", calling
# checkers)
val ARM64EC_CHECK_PRESERVED: [35]Kept = [35]Kept{
    Kept{register: gen_register.SP, bits: Part.whole{}}, Kept{register: gen_register.X19, bits: Part.whole{}}, Kept{register: gen_register.X20, bits: Part.whole{}}, Kept{register: gen_register.X21, bits: Part.whole{}}, Kept{register: gen_register.X22, bits: Part.whole{}}, Kept{register: gen_register.X25, bits: Part.whole{}}, Kept{register: gen_register.X26, bits: Part.whole{}}, Kept{register: gen_register.X27, bits: Part.whole{}}, Kept{register: gen_register.X29, bits: Part.whole{}},
    Kept{register: gen_register.V8, bits: Part.low{64}}, Kept{register: gen_register.V9, bits: Part.low{64}}, Kept{register: gen_register.V10, bits: Part.low{64}}, Kept{register: gen_register.V11, bits: Part.low{64}}, Kept{register: gen_register.V12, bits: Part.low{64}}, Kept{register: gen_register.V13, bits: Part.low{64}}, Kept{register: gen_register.V14, bits: Part.low{64}}, Kept{register: gen_register.V15, bits: Part.low{64}},
    Kept{register: gen_register.X0, bits: Part.whole{}}, Kept{register: gen_register.X1, bits: Part.whole{}}, Kept{register: gen_register.X2, bits: Part.whole{}}, Kept{register: gen_register.X3, bits: Part.whole{}}, Kept{register: gen_register.X4, bits: Part.whole{}}, Kept{register: gen_register.X5, bits: Part.whole{}}, Kept{register: gen_register.X6, bits: Part.whole{}}, Kept{register: gen_register.X7, bits: Part.whole{}}, Kept{register: gen_register.X8, bits: Part.whole{}},
    Kept{register: gen_register.V0, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V1, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V2, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V3, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V4, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V5, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V6, bits: Part.whole{}, natural: 64}, Kept{register: gen_register.V7, bits: Part.whole{}, natural: 64},
    Kept{register: gen_register.X15, bits: Part.whole{}},
};

# the check takes the callee in x11 and its exit thunk in x10, and hands back
# what to call in x11 and the address an exit thunk leaves for in x9
val ARM64EC_CHECK_PASSING:   [2]rf.Id = [2]rf.Id{gen_register.X11, gen_register.X10};
val ARM64EC_CHECK_RETURNING: [2]rf.Id = [2]rf.Id{gen_register.X11, gen_register.X9};

# each of the check's words in the next general register of its bank
fun checked(r: *Resolved, call: *Call, asg: *Assignment, results: bool) err[piece.Error] {
    val regs: *Registers = held(r);
    if (regs == nil) { ret err[piece.Error].ok{}; }
    var list:  Slice[Value] = call.arguments;
    var bank_: Slice[rf.Id] = bank(?regs.passing, rf.GENERAL);
    if (results) {
        list  = call.results;
        bank_ = bank(?regs.returning, rf.GENERAL);
    }
    var i: usize = 0;
    for (i < list.size) {
        val n: *Node = view.node(call.view, list.data[i].node);
        if (i >= bank_.size || laid(n) != 8 || view.aggregate(n)) { ret err[piece.Error].err{piece.Error.room{list.data[i].node}}; }
        val first: u32              = piece.open(asg);
        val added: err[piece.Error] = piece.add(asg, at(Place.register{bank_.data[i]}, 0, 8, Fill.exact{}));
        if (sel added.err) { ret added; }
        val closed: err[piece.Error] = piece.close(asg, results, Passing.value{}, first);
        if (sel closed.err) { ret closed; }
        i = i + 1;
    }
    ret err[piece.Error].ok{};
}

fun check_results(r: *Resolved, call: *Call, asg: *Assignment) err[piece.Error] {
    ret checked(r, call, asg, true);
}

fun check_arguments(r: *Resolved, call: *Call, asg: *Assignment) err[piece.Error] {
    ret checked(r, call, asg, false);
}

val CHECK_CLASSIFIERS: Classifiers = Classifiers{results: check_results, arguments: check_arguments};

# the call that checks an indirect callee of arm64ec code before the call
# itself, through __os_arm64x_check_icall ("calling checkers")
pub val ARM64EC_CHECK: Convention = Convention{
    abi:         ?arch_aarch64.ARM64EC_ARM64EC,
    role:        Role.check{},
    requires:    NEEDS_FP,
    file:        opt[*rf.File].some{?aarch64_register.FILE},
    classifiers: CHECK_CLASSIFIERS,
    word:        Bits.bits{64},
    floats:      Floats.widest{128},
    passing:     Slice[rf.Id]{data: ?ARM64EC_CHECK_PASSING[0], size: 2},
    returning:   Slice[rf.Id]{data: ?ARM64EC_CHECK_RETURNING[0], size: 2},
    preserved:   Slice[Kept]{data: ?ARM64EC_CHECK_PRESERVED[0], size: $length_of(ARM64EC_CHECK_PRESERVED)},
    reserved:    Slice[rf.Id]{data: ?ARM64EC_RESERVED[0], size: $length_of(ARM64EC_RESERVED)},
    stack:       ARM64EC_FRAME,
    indirect:    INDIRECT,
    variadic:    ARM64EC_THUNK_VARIADIC,
    half:        Half.float{},
    defined:     AARCH64_DEFINED,
    narrow:      Narrow.undefined{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        tail,
};

# one class of msvc's spelling of a thunk's signature ("understanding arm64ec
# abi and assembly code", entry thunks, as llvm's
# AArch64Arm64ECCallLowering::canonicalizeThunkType spells it), the first
# class that admits a value spelling it
# ---
# admits: whether it spells the value, a result when the flag says so
# spell:  its spelling, written to the end of a vector
# word:   whether the value travels through the thunk as a whole general
#         register's word
rec Spelling {
    admits: fun(*View, u32, bool) bool;
    spell:  fun(*View, u32, bool, *Vector[u8]) res[bool, allocator.Error];
    word:   bool;
}

fun put(out: *Vector[u8], text: str) res[bool, allocator.Error] {
    var i: usize = 0;
    for (i < str_len(text)) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](out, text[i]::u8);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

fun put_view(out: *Vector[u8], text: Name) res[bool, allocator.Error] {
    var i: usize = 0;
    for (i < text.len) {
        val pushed: res[usize, allocator.Error] = vector.push[u8](out, text.data[i]::u8);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

fun put_number(out: *Vector[u8], n: u64) res[bool, allocator.Error] {
    var digits: [20]u8;
    var count:  usize = 0;
    var left:   u64   = n;
    for (count == 0 || left != 0) {
        digits[count] = (0x30 + left % 10)::u8;
        left          = left / 10;
        count         = count + 1;
    }
    for (count > 0) {
        count = count - 1;
        val pushed: res[usize, allocator.Error] = vector.push[u8](out, digits[count]);
        if (sel pushed.err) { ret res[bool, allocator.Error].err{pushed.err}; }
    }
    ret res[bool, allocator.Error].ok{true};
}

fun float_of(v: *View, at_node: u32, width: u32) bool {
    val n: *Node = view.node(v, at_node);
    ret sel n.shape.float && n.shape.float.width == width;
}

fun single(v: *View, at_node: u32, result: bool) bool {
    ret float_of(v, at_node, 32);
}

fun double(v: *View, at_node: u32, result: bool) bool {
    ret float_of(v, at_node, 64);
}

fun spell_single(v: *View, at_node: u32, result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    ret put(out, "f");
}

fun spell_double(v: *View, at_node: u32, result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    ret put(out, "d");
}

# a homogeneous aggregate of floats of 32 or 64 bits, `F` or `D` and its bytes
fun floats(v: *View, at_node: u32, result: bool) bool {
    val b: opt[Base] = aggregate_base(v, at_node);
    if (sel b.none) { ret false; }
    ret b.some.float && (b.some.width == 32 || b.some.width == 64);
}

fun spell_floats(v: *View, at_node: u32, result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    val b: opt[Base] = aggregate_base(v, at_node);
    if (sel b.none) { ret res[bool, allocator.Error].ok{false}; }
    var mark: str = "D";
    if (b.some.width == 32) { mark = "F"; }
    val marked: res[bool, allocator.Error] = put(out, mark);
    if (sel marked.err) { ret marked; }
    ret put_number(out, laid(view.node(v, at_node)));
}

# an integer or a pointer of at most 64 bits, which travels as one word, `i8`
fun word_of(v: *View, at_node: u32, result: bool) bool {
    val n: *Node = view.node(v, at_node);
    if (sel n.shape.pointer) { ret laid(n) <= 8; }
    ret sel n.shape.integer && n.shape.integer <= 64;
}

fun spell_word(v: *View, at_node: u32, result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    ret put(out, "i8");
}

# any other value with a size in memory, `m` and its bytes but 4, and for an
# argument aligned to 16 or more `a` and its alignment
fun memory(v: *View, at_node: u32, result: bool) bool {
    val n: *Node = view.node(v, at_node);
    if (sel n.shape.float) { ret false; }
    ret sel n.room.laid && laid(n) != 0;
}

fun spell_memory(v: *View, at_node: u32, result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    val n:      *Node                      = view.node(v, at_node);
    val marked: res[bool, allocator.Error] = put(out, "m");
    if (sel marked.err) { ret marked; }
    if (laid(n) != 4) {
        val sized: res[bool, allocator.Error] = put_number(out, laid(n));
        if (sel sized.err) { ret sized; }
    }
    if (result || alignment(n) < 16) { ret res[bool, allocator.Error].ok{true}; }
    val a: res[bool, allocator.Error] = put(out, "a");
    if (sel a.err) { ret a; }
    ret put_number(out, alignment(n));
}

val SPELLINGS: [5]Spelling = [5]Spelling{
    Spelling{admits: single, spell: spell_single, word: false},
    Spelling{admits: double, spell: spell_double, word: false},
    Spelling{admits: floats, spell: spell_floats, word: false},
    Spelling{admits: word_of, spell: spell_word, word: true},
    Spelling{admits: memory, spell: spell_memory, word: false},
};

fun spelling_of(v: *View, at_node: u32, result: bool) opt[*Spelling] {
    var i: usize = 0;
    for (i < $length_of(SPELLINGS)) {
        if (SPELLINGS[i].admits(v, at_node, result)) { ret opt[*Spelling].some{?SPELLINGS[i]}; }
        i = i + 1;
    }
    ret opt[*Spelling].none{};
}

# the values of a signature spelled in order, `v` for none
fun spell_all(v: *View, nodes: Slice[u32], result: bool, out: *Vector[u8]) res[bool, allocator.Error] {
    if (nodes.size == 0) { ret put(out, "v"); }
    var i: usize = 0;
    for (i < nodes.size) {
        val s: opt[*Spelling] = spelling_of(v, nodes.data[i], result);
        if (sel s.none) { ret res[bool, allocator.Error].ok{false}; }
        val done: res[bool, allocator.Error] = s.some.spell(v, nodes.data[i], result, out);
        if (sel done.err) { ret done; }
        if (!done.ok)     { ret done; }
        i = i + 1;
    }
    ret res[bool, allocator.Error].ok{true};
}

# a thunk's name: its kind's prefix, the result, `$` and the parameters, as
# `$ientry_thunk$cdecl$i8$i8d`. a signature of more than one result is none
# msvc spells
fun thunk_name(kind: Thunk, v: *View, results: Slice[u32], params: Slice[u32], out: *Vector[u8]) res[bool, allocator.Error] {
    if (results.size > 1) { ret res[bool, allocator.Error].ok{false}; }
    var prefix: str = "$iexit_thunk$cdecl$";
    if (sel kind.entry) { prefix = "$ientry_thunk$cdecl$"; }
    val head: res[bool, allocator.Error] = put(out, prefix);
    if (sel head.err) { ret head; }
    val back: res[bool, allocator.Error] = spell_all(v, results, true, out);
    if (sel back.err) { ret back; }
    if (!back.ok)     { ret back; }
    val mid: res[bool, allocator.Error] = put(out, "$");
    if (sel mid.err) { ret mid; }
    ret spell_all(v, params, false, out);
}

fun worded(v: *View, at_node: u32) bool {
    val s: opt[*Spelling] = spelling_of(v, at_node, false);
    ret sel s.some && s.some.word;
}

fun blob(mark: *tables.Blob) Name {
    ret Name{data: mark.data::*char, len: mark.len};
}

fun text(t: str) Name {
    ret Name{data: t, len: str_len(t)};
}

fun starts(name: Name, mark: Name) bool {
    if (name.len < mark.len) { ret false; }
    var i: usize = 0;
    for (i < mark.len) {
        if (name.data[i] != mark.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# where `mark` first stands in `name`, none when it does not
fun find(name: Name, mark: Name) opt[usize] {
    var at: usize = 0;
    for (at + mark.len <= name.len) {
        if (starts(Name{data: ?name.data[at], len: name.len - at}, mark)) { ret opt[usize].some{at}; }
        at = at + 1;
    }
    ret opt[usize].none{};
}

# `name` with `insert` written at `at`
fun spliced(name: Name, at: usize, insert: Name, out: *Vector[u8]) res[bool, allocator.Error] {
    val head: res[bool, allocator.Error] = put_view(out, Name{data: name.data, len: at});
    if (sel head.err) { ret head; }
    val mid: res[bool, allocator.Error] = put_view(out, insert);
    if (sel mid.err) { ret mid; }
    ret put_view(out, Name{data: ?name.data[at], len: name.len - at});
}

# the name arm64ec code reaches a function by ("arm64ec function name
# decoration", overview of arm64ec abi conventions, as llvm's
# getArm64ECMangledFunctionName writes it): a c name marked with `#`, and a
# c++ name with the `$$h` tag after its qualified name, past the first `@@`
# that starts no `@@@`, else past its first `@`. a name marked already, or a
# c++ name tagged already, is native as it is
fun decorate(name: Name, out: *Vector[u8]) res[bool, allocator.Error] {
    if (name.len == 0 || starts(name, blob(?tables.ARM64EC_CODE_MARK))) { ret res[bool, allocator.Error].ok{false}; }
    if (!starts(name, blob(?tables.ARM64EC_CPP_MARK)))                  { ret spliced(name, 0, blob(?tables.ARM64EC_CODE_MARK), out); }
    val tagged: opt[usize] = find(name, blob(?tables.ARM64EC_CPP_TAG));
    if (sel tagged.some) { ret res[bool, allocator.Error].ok{false}; }
    val two: opt[usize] = find(name, text("@@"));
    if (sel two.some) {
        var past:  bool       = true;
        val three: opt[usize] = find(name, text("@@@"));
        if (sel three.some) { past = three.some != two.some; }
        if (past)           { ret spliced(name, two.some + 2, blob(?tables.ARM64EC_CPP_TAG), out); }
    }
    var at:  usize      = name.len;
    val one: opt[usize] = find(name, text("@"));
    if (sel one.some) { at = one.some + 1; }
    ret spliced(name, at, blob(?tables.ARM64EC_CPP_TAG), out);
}

# the guest exit thunk of a decorated name: the name and `$exit_thunk`, a c++
# name's before its first `@` (llvm's buildGuestExitThunk)
fun guest(name: Name, out: *Vector[u8]) res[bool, allocator.Error] {
    val one: opt[usize] = find(name, text("@"));
    if (sel one.some) {
        if (starts(name, blob(?tables.ARM64EC_CPP_MARK))) { ret spliced(name, one.some, text("$exit_thunk"), out); }
    }
    ret spliced(name, name.len, text("$exit_thunk"), out);
}

# arm64ec's bridge to x64 code ("understanding arm64ec abi and assembly code")
val ARM64EC_BRIDGING: Bridging = Bridging{
    foreign:  ?ARM64EC_X64,
    native:   ?ARM64EC_NATIVE,
    check:    ?ARM64EC_CHECK,
    checker:  "__os_arm64x_check_icall",
    dispatch: "__os_arm64x_dispatch_call_no_redirect",
    name:     thunk_name,
    worded:   worded,
    decorate: decorate,
    guest:    guest,
};
