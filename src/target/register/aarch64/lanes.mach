# the aarch64 lane rules: build, shuffle, extract, insert and the reductions
# beyond a sum, the guards they read and the immediates they compute
#
# a vector of 2, 4, 8 or 16 bytes is held in the low bytes of a v register and
# the bytes above it are undefined, so a rule reads no lane past the vector's
# and a build or a shuffle may write any. a lane's index and a shuffle's lanes
# are the root's immediates, which the computed sources turn into the lane
# immediates of umov, ins and dup, the byte count of ext, and the selector tbl
# looks each byte of its result up by. a selector is built in a general
# register by movz and movk and moved across, as the table builds every other
# constant an expansion needs.
#
# a shuffle that is a broadcast of one lane is dup, one that takes consecutive
# lanes of one operand or of the two joined is ext, the interleavings and
# deinterleavings of whole vectors are zip, uzp and trn, a reversal within
# groups is rev16, rev32 or rev64, and any other is tbl on one operand and tbx
# on the other, so a shuffle of every lane type and count is selected. an
# integer reduction is addv, smaxv, sminv, umaxv or uminv across the lanes
# where neon has one, the pairwise form for two lanes of 32 bits, and
# otherwise a tree that folds the upper half of what is left onto the lower by
# ext. a reduction of two doublewords that neon has no form for is taken in
# the general registers. a reassociable float sum is faddp, a float product
# fmul by element, and a sequential one adds or multiplies the lanes in order,
# faddp giving the first lane plus the second as fadd does. a float minimum or
# maximum is fminp or fminv, which combine as fmin and fmax do. fminnm and
# fmaxnm give a nan for a signalling nan operand where fminnum and fmaxnum
# give the other operand, so neither reduces packed.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.isa.aarch64.gen_register;
use masc.isa.aarch64.gen_row;

use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use ir: mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use mirl.ir.opcode.rule.Class;
use types: mirl.ir.type;
use mirl.ir.type.format;
use mirl.machine.instruction.Opcode;
use mirl.machine.select.match;
use mirl.machine.select.rule.Emit;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.NO_IMPLIED;
use mirl.machine.select.rule.Node;
use mirl.machine.select.rule.Ref;
use mirl.machine.select.rule.Scratch;
use mirl.machine.select.rule.Slot;
use mirl.machine.select.rule.Source;
use mirl.machine.select.rule.Sources;
use mirl.machine.select.rule.Test;
use mirl.machine.select.rule.Tie;
use mirl.machine.select.rule.Width;

# the lanes of a vector: how many and the bits of each, zero for a value
# that is no vector
rec Lanes {
    count: u32;
    bits:  u32;
}

fun lanes_of(mt: *Match, v: opt[id.Value]) Lanes {
    val none: Lanes = Lanes{count: 0, bits: 0};
    if (sel v.none) { ret none; }
    val s: res[types.Shape, types.Error] = match.shape(mt, v.some);
    if (sel s.err) { ret none; }
    val sh: types.Shape = s.ok;
    if (!(sel sh.vector)) { ret none; }
    val e: res[types.Shape, types.Error] = types.shape(?mt.module.types, sh.vector.element);
    if (sel e.err) { ret none; }
    val es:   types.Shape = e.ok;
    var bits: u32         = 0;
    if (sel es.integer) { bits = es.integer.width; }
    or (sel es.float) {
        val r: opt[types.Row] = types.row(es.float.format);
        if (sel r.none) { ret none; }
        bits = r.some.width;
    }
    ret Lanes{count: sh.vector.lanes, bits: bits};
}

fun bytes_of(l: Lanes) u64 {
    ret l.count::u64 * l.bits::u64 / 8;
}

fun operand_bytes(mt: *Match) u64 {
    ret bytes_of(lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0})));
}

fun result_bytes(mt: *Match) u64 {
    ret bytes_of(lanes_of(mt, match.result(mt, Slot{node: 0, index: 0})));
}

# the root reads a vector of 2, 4, 8 or 16 bytes
pub fun operand_2(mt: *Match) bool {
    ret operand_bytes(mt) == 2;
}

pub fun operand_4(mt: *Match) bool {
    ret operand_bytes(mt) == 4;
}

pub fun operand_8(mt: *Match) bool {
    ret operand_bytes(mt) == 8;
}

pub fun operand_16(mt: *Match) bool {
    ret operand_bytes(mt) == 16;
}

# the root gives a vector of 2, 4, 8 or 16 bytes
pub fun result_2(mt: *Match) bool {
    ret result_bytes(mt) == 2;
}

pub fun result_4(mt: *Match) bool {
    ret result_bytes(mt) == 4;
}

pub fun result_8(mt: *Match) bool {
    ret result_bytes(mt) == 8;
}

pub fun result_16(mt: *Match) bool {
    ret result_bytes(mt) == 16;
}

fun immediate(x: u64) opt[i64] {
    ret opt[i64].some{x:~i64};
}

# the lane the root names, the immediate of umov, ins and dup
pub fun lane(mt: *Match) opt[i64] {
    val d: *InstructionData = match.instruction(mt, 0);
    var i: usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lane) { ret immediate(imm.lane::u64); }
        i = i + 1;
    }
    ret opt[i64].none{};
}

# a shuffle the root states: its lanes, the lanes of each operand and of its
# result, and the bits of a lane
rec Shuffle {
    list:    Slice[u32];
    inputs:  u32;
    outputs: u32;
    bits:    u32;
}

fun shuffle_of(mt: *Match) opt[Shuffle] {
    val d:    *InstructionData = match.instruction(mt, 0);
    var list: Slice[u32]       = Slice[u32]{data: nil, size: 0};
    var i:    usize            = 0;
    for (i < d.immediates.len) {
        val imm: Immediate = d.immediates.data[i];
        if (sel imm.lanes) { list = imm.lanes; }
        i = i + 1;
    }
    val from: Lanes = lanes_of(mt, match.operand(mt, Slot{node: 0, index: 0}));
    val to:   Lanes = lanes_of(mt, match.result(mt, Slot{node: 0, index: 0}));
    if (from.count == 0 || to.count == 0 || to.bits == 0 || to.bits % 8 != 0) { ret opt[Shuffle].none{}; }
    if (from.bits != to.bits || list.size != to.count::usize)                 { ret opt[Shuffle].none{}; }
    if (bytes_of(from) > 16 || bytes_of(to) > 16)                             { ret opt[Shuffle].none{}; }
    ret opt[Shuffle].some{Shuffle{list: list, inputs: from.count, outputs: to.count, bits: to.bits}};
}

fun input_bytes(s: *Shuffle) u64 {
    ret s.inputs::u64 * s.bits::u64 / 8;
}

fun output_bytes(s: *Shuffle) u64 {
    ret s.outputs::u64 * s.bits::u64 / 8;
}

# which operand lane i of the result comes from, 0 or 1, and its lane there
fun side(s: *Shuffle, i: u32) u32 {
    if (s.list.data[i] < s.inputs) { ret 0; }
    ret 1;
}

fun from(s: *Shuffle, i: u32) u32 {
    val at: u32 = s.list.data[i];
    if (at < s.inputs) { ret at; }
    ret at - s.inputs;
}

# whether a result of this many bytes is written by a 64-bit arrangement
# (wide false) or needs the 128-bit one (wide true)
fun fits(bytes: u64, wide: bool) bool {
    if (wide) { ret bytes > 8; }
    ret bytes > 0 && bytes <= 8;
}

# the lane of one operand every lane of the result is, none where the lanes
# differ or another operand gives one
fun broadcast(mt: *Match, which: u32) opt[u32] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[u32].none{}; }
    val s:  Shuffle = got.some;
    val at: u32     = from(?s, 0);
    var i:  u32     = 0;
    for (i < s.outputs) {
        if (side(?s, i) != which || from(?s, i) != at) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{at};
}

fun dup(mt: *Match, which: u32, wide: bool) bool {
    if (!fits(result_bytes(mt), wide)) { ret false; }
    val at: opt[u32] = broadcast(mt, which);
    ret sel at.some;
}

# a broadcast of a lane of the first or the second operand, into a result of
# at most 8 bytes or of 16
pub fun dup_a_8(mt: *Match) bool {
    ret dup(mt, 0, false);
}

pub fun dup_a_16(mt: *Match) bool {
    ret dup(mt, 0, true);
}

pub fun dup_b_8(mt: *Match) bool {
    ret dup(mt, 1, false);
}

pub fun dup_b_16(mt: *Match) bool {
    ret dup(mt, 1, true);
}

# the lane dup broadcasts
pub fun dup_lane_a(mt: *Match) opt[i64] {
    val at: opt[u32] = broadcast(mt, 0);
    if (sel at.none) { ret opt[i64].none{}; }
    ret immediate(at.some::u64);
}

pub fun dup_lane_b(mt: *Match) opt[i64] {
    val at: opt[u32] = broadcast(mt, 1);
    if (sel at.none) { ret opt[i64].none{}; }
    ret immediate(at.some::u64);
}

# the first of the consecutive lanes of one operand the result is, none where
# it is not such a run
fun run(s: *Shuffle, which: u32) opt[u32] {
    val at: u32 = from(s, 0);
    var i:  u32 = 0;
    for (i < s.outputs) {
        if (side(s, i) != which || from(s, i) != at + i) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{at};
}

# a run of one operand's lanes moved to the bottom by ext of the operand with
# itself, in the 64-bit form for an operand of at most 8 bytes and the 128-bit
# one for 16. the run lies within the operand, so ext reads no undefined byte
fun ext_one(mt: *Match, which: u32, wide: bool) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret false; }
    val s: Shuffle = got.some;
    if (!fits(input_bytes(?s), wide)) { ret false; }
    val at: opt[u32] = run(?s, which);
    ret sel at.some;
}

pub fun ext_a_8(mt: *Match) bool {
    ret ext_one(mt, 0, false);
}

pub fun ext_a_16(mt: *Match) bool {
    ret ext_one(mt, 0, true);
}

pub fun ext_b_8(mt: *Match) bool {
    ret ext_one(mt, 1, false);
}

pub fun ext_b_16(mt: *Match) bool {
    ret ext_one(mt, 1, true);
}

fun ext_bytes(mt: *Match, which: u32) opt[i64] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[i64].none{}; }
    val s:  Shuffle  = got.some;
    val at: opt[u32] = run(?s, which);
    if (sel at.none) { ret opt[i64].none{}; }
    ret immediate((at.some * s.bits / 8)::u64);
}

# the bytes ext moves the run down by
pub fun ext_a_bytes(mt: *Match) opt[i64] {
    ret ext_bytes(mt, 0);
}

pub fun ext_b_bytes(mt: *Match) opt[i64] {
    ret ext_bytes(mt, 1);
}

# the first of the consecutive lanes of the two operands joined the result
# is, operands of exactly 8 or 16 bytes, so ext of the two in the form of
# that size joins them as the shuffle does
fun span(mt: *Match, bytes: u64) opt[u32] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[u32].none{}; }
    val s: Shuffle = got.some;
    if (input_bytes(?s) != bytes || output_bytes(?s) > bytes) { ret opt[u32].none{}; }
    val at: u32 = s.list.data[0];
    var i:  u32 = 0;
    for (i < s.outputs) {
        if (s.list.data[i] != at + i) { ret opt[u32].none{}; }
        i = i + 1;
    }
    ret opt[u32].some{at * s.bits / 8};
}

pub fun ext_ab_8(mt: *Match) bool {
    val at: opt[u32] = span(mt, 8);
    ret sel at.some;
}

pub fun ext_ab_16(mt: *Match) bool {
    val at: opt[u32] = span(mt, 16);
    ret sel at.some;
}

pub fun ext_ab_bytes(mt: *Match) opt[i64] {
    val low: opt[u32] = span(mt, 8);
    if (sel low.some) { ret immediate(low.some::u64); }
    val high: opt[u32] = span(mt, 16);
    if (sel high.none) { ret opt[i64].none{}; }
    ret immediate(high.some::u64);
}

# the lane of the two operands joined that lane i of a zip1, zip2, uzp1,
# uzp2, trn1 or trn2 of operands of n lanes gives
fun permuted(kind: u32, i: u32, n: u32) u32 {
    val even: bool = i % 2 == 0;
    if (kind == 0) {
        if (even) { ret i / 2; }
        ret n + i / 2;
    }
    if (kind == 1) {
        if (even) { ret n / 2 + i / 2; }
        ret n + n / 2 + i / 2;
    }
    if (kind == 2) { ret 2 * i; }
    if (kind == 3) { ret 2 * i + 1; }
    if (kind == 4) {
        if (even) { ret i; }
        ret n + i - 1;
    }
    if (even) { ret i + 1; }
    ret n + i;
}

# a shuffle of two vectors of exactly 8 or 16 bytes into one of the same
# type, lane for lane the permutation `kind` gives
fun perm(mt: *Match, kind: u32, bytes: u64) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret false; }
    val s: Shuffle = got.some;
    if (s.outputs != s.inputs || s.inputs < 2 || input_bytes(?s) != bytes) { ret false; }
    var i: u32 = 0;
    for (i < s.outputs) {
        if (s.list.data[i] != permuted(kind, i, s.inputs)) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun zip1_8(mt: *Match) bool {
    ret perm(mt, 0, 8);
}

pub fun zip1_16(mt: *Match) bool {
    ret perm(mt, 0, 16);
}

pub fun zip2_8(mt: *Match) bool {
    ret perm(mt, 1, 8);
}

pub fun zip2_16(mt: *Match) bool {
    ret perm(mt, 1, 16);
}

pub fun uzp1_8(mt: *Match) bool {
    ret perm(mt, 2, 8);
}

pub fun uzp1_16(mt: *Match) bool {
    ret perm(mt, 2, 16);
}

pub fun uzp2_8(mt: *Match) bool {
    ret perm(mt, 3, 8);
}

pub fun uzp2_16(mt: *Match) bool {
    ret perm(mt, 3, 16);
}

pub fun trn1_8(mt: *Match) bool {
    ret perm(mt, 4, 8);
}

pub fun trn1_16(mt: *Match) bool {
    ret perm(mt, 4, 16);
}

pub fun trn2_8(mt: *Match) bool {
    ret perm(mt, 5, 8);
}

pub fun trn2_16(mt: *Match) bool {
    ret perm(mt, 5, 16);
}

# a reversal of the first operand's lanes within each group of `group` bytes,
# in the 64-bit form for an operand of at most 8 bytes and the 128-bit one
# for 16, each lane of the result one the operand holds
fun reversed(mt: *Match, group: u32, wide: bool) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret false; }
    val s: Shuffle = got.some;
    if (!fits(input_bytes(?s), wide) || !fits(output_bytes(?s), wide)) { ret false; }
    val per: u32 = group * 8 / s.bits;
    if (per < 2) { ret false; }
    var i: u32 = 0;
    for (i < s.outputs) {
        val want: u32 = i / per * per + (per - 1 - i % per);
        if (want >= s.inputs || s.list.data[i] != want) { ret false; }
        i = i + 1;
    }
    ret true;
}

pub fun rev16_8(mt: *Match) bool {
    ret reversed(mt, 2, false);
}

pub fun rev16_16(mt: *Match) bool {
    ret reversed(mt, 2, true);
}

pub fun rev32_8(mt: *Match) bool {
    ret reversed(mt, 4, false);
}

pub fun rev32_16(mt: *Match) bool {
    ret reversed(mt, 4, true);
}

pub fun rev64_8(mt: *Match) bool {
    ret reversed(mt, 8, false);
}

pub fun rev64_16(mt: *Match) bool {
    ret reversed(mt, 8, true);
}

# every lane of the result comes from one operand
fun single(mt: *Match, which: u32) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret false; }
    val s: Shuffle = got.some;
    var i: u32     = 0;
    for (i < s.outputs) {
        if (side(?s, i) != which) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun looked_up(mt: *Match, wide: bool) bool {
    val got: opt[Shuffle] = shuffle_of(mt);
    ret sel got.some && fits(result_bytes(mt), wide);
}

# a shuffle tbl looks up in one operand, a result of at most 8 bytes or of 16
pub fun single_a_8(mt: *Match) bool {
    ret single(mt, 0) && looked_up(mt, false);
}

pub fun single_a_16(mt: *Match) bool {
    ret single(mt, 0) && looked_up(mt, true);
}

pub fun single_b_8(mt: *Match) bool {
    ret single(mt, 1) && looked_up(mt, false);
}

pub fun single_b_16(mt: *Match) bool {
    ret single(mt, 1) && looked_up(mt, true);
}

# a shuffle tbl and tbx look up in both operands
pub fun pair_8(mt: *Match) bool {
    ret looked_up(mt, false);
}

pub fun pair_16(mt: *Match) bool {
    ret looked_up(mt, true);
}

# a sixteen-bit chunk of a doubleword of the selector tbl and tbx look one
# operand's bytes up by: the byte of that operand each byte of the result
# is, and 0xff, which tbl gives zero for and tbx leaves as it was, for a byte
# the other operand gives or no lane holds
fun selector(mt: *Match, which: u32, doubleword: u32, chunk: u32) opt[i64] {
    val got: opt[Shuffle] = shuffle_of(mt);
    if (sel got.none) { ret opt[i64].none{}; }
    val s:      Shuffle = got.some;
    val each:   u32     = s.bits / 8;
    var picked: u64     = 0;
    var b:      u32     = 0;
    for (b < 8) {
        val j:    u32 = doubleword * 8 + b;
        val i:    u32 = j / each;
        var byte: u32 = 0xff;
        if (i < s.outputs && side(?s, i) == which) { byte = from(?s, i) * each + j % each; }
        picked = picked | (byte::u64 << (8 * b)::u64);
        b      = b + 1;
    }
    ret immediate((picked >> (16 * chunk)::u64) & 0xffff);
}

pub fun sel_a_low_0(mt: *Match) opt[i64] {
    ret selector(mt, 0, 0, 0);
}

pub fun sel_a_low_1(mt: *Match) opt[i64] {
    ret selector(mt, 0, 0, 1);
}

pub fun sel_a_low_2(mt: *Match) opt[i64] {
    ret selector(mt, 0, 0, 2);
}

pub fun sel_a_low_3(mt: *Match) opt[i64] {
    ret selector(mt, 0, 0, 3);
}

pub fun sel_b_low_0(mt: *Match) opt[i64] {
    ret selector(mt, 1, 0, 0);
}

pub fun sel_b_low_1(mt: *Match) opt[i64] {
    ret selector(mt, 1, 0, 1);
}

pub fun sel_b_low_2(mt: *Match) opt[i64] {
    ret selector(mt, 1, 0, 2);
}

pub fun sel_b_low_3(mt: *Match) opt[i64] {
    ret selector(mt, 1, 0, 3);
}

pub fun sel_a_high_0(mt: *Match) opt[i64] {
    ret selector(mt, 0, 1, 0);
}

pub fun sel_a_high_1(mt: *Match) opt[i64] {
    ret selector(mt, 0, 1, 1);
}

pub fun sel_a_high_2(mt: *Match) opt[i64] {
    ret selector(mt, 0, 1, 2);
}

pub fun sel_a_high_3(mt: *Match) opt[i64] {
    ret selector(mt, 0, 1, 3);
}

pub fun sel_b_high_0(mt: *Match) opt[i64] {
    ret selector(mt, 1, 1, 0);
}

pub fun sel_b_high_1(mt: *Match) opt[i64] {
    ret selector(mt, 1, 1, 1);
}

pub fun sel_b_high_2(mt: *Match) opt[i64] {
    ret selector(mt, 1, 1, 2);
}

pub fun sel_b_high_3(mt: *Match) opt[i64] {
    ret selector(mt, 1, 1, 3);
}

pub val N_EXT_S:              [1]Node = [1]Node{Node{opcode: ir.EXT_S, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_EXT_S_VSHUFFLEP0O0: [2]Node = [2]Node{Node{opcode: ir.EXT_S, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.VSHUFFLE, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_EXT_U:              [1]Node = [1]Node{Node{opcode: ir.EXT_U, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_EXT_U_VSHUFFLEP0O0: [2]Node = [2]Node{Node{opcode: ir.EXT_U, parent: 0, operand: 0, result: 0, constants: 0}, Node{opcode: ir.VSHUFFLE, parent: 0, operand: 0, result: 0, constants: 0}};
