pub val N_REDUCE_AND:         [1]Node = [1]Node{Node{opcode: ir.REDUCE_AND, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FADD_ANY:    [1]Node = [1]Node{Node{opcode: ir.REDUCE_FADD_ANY, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FADD_SEQ:    [1]Node = [1]Node{Node{opcode: ir.REDUCE_FADD_SEQ, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FMAX:        [1]Node = [1]Node{Node{opcode: ir.REDUCE_FMAX, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FMIN:        [1]Node = [1]Node{Node{opcode: ir.REDUCE_FMIN, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FMUL_ANY:    [1]Node = [1]Node{Node{opcode: ir.REDUCE_FMUL_ANY, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_FMUL_SEQ:    [1]Node = [1]Node{Node{opcode: ir.REDUCE_FMUL_SEQ, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_MUL:         [1]Node = [1]Node{Node{opcode: ir.REDUCE_MUL, parent: 0, operand: 0, result: 0, constants: 0}};
pub val N_REDUCE_OR:          [1]Node = [1]Node{Node{opcode: ir.REDUCE_OR, parent: 0, operand: 0, result: 0, constants: 0}};
