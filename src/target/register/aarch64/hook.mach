# the guards and derived immediates the aarch64 table's rules need beyond a type test
#
# a hook reads the values of instructions the verifier accepted, so a read the
# module or its type table refuses means a corrupted module, and the hook then
# says its guard does not hold. every fact about an operand is read through
# the match, the register width through the rule's type tests, and the object
# format through the target's record, so no hook names a system.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use mo: masc.core.operand;
use masc.core.row.Row;
use masc.isa.aarch64.gen_row;
use mink.catalog.format;
use mink.catalog.format.Format;

use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use mirl.ir.opcode.row.Immediate;
use types: mirl.ir.type;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.record;

# the bits of an integer type, zero for any other type
fun width_of(mt: *Match, v: id.Value) u32 {
    val s: res[types.Shape, types.Error] = match.shape(mt, v);
    if (sel s.err)           { ret 0; }
    if (!(sel s.ok.integer)) { ret 0; }
    ret s.ok.integer.width;
}

fun operand_width(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret width_of(mt, v.some);
}

fun result_width(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.result(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret width_of(mt, v.some);
}

fun bits_of(mt: *Match, v: id.Value) opt[i64] {
    val b: res[opt[i64], match.Refusal] = match.bits(mt, v);
    if (sel b.err) { ret opt[i64].none{}; }
    ret b.ok;
}

# the bits of the constant an operand is, none when it is not one
fun operand_bits(mt: *Match, node: u8, index: u8) opt[i64] {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret opt[i64].none{}; }
    ret bits_of(mt, v.some);
}

# the bits of the constant a materialisation rule builds
fun subject_bits(mt: *Match) opt[i64] {
    ret bits_of(mt, mt.subject);
}

# the bits a vector type holds, its lanes times its lane's bits, zero for a
# type that is no vector or a lane of no fixed width
fun vector_bits(mt: *Match, v: id.Value) u32 {
    val s: res[types.Shape, types.Error] = match.shape(mt, v);
    if (sel s.err)          { ret 0; }
    if (!(sel s.ok.vector)) { ret 0; }
    val lanes: u32                           = s.ok.vector.lanes;
    val lane:  res[types.Shape, types.Error] = types.shape(?mt.module.types, s.ok.vector.element);
    if (sel lane.err)        { ret 0; }
    if (sel lane.ok.integer) { ret lanes * lane.ok.integer.width; }
    if (sel lane.ok.float) {
        val w: res[u32, types.Error] = types.width(?mt.module.types, s.ok.vector.element);
        if (sel w.err) { ret 0; }
        ret lanes * w.ok;
    }
    ret 0;
}

# the lanes of a vector type and the bits of its lane, zero for any other type
fun lanes_of(mt: *Match, v: id.Value) u32 {
    val s: res[types.Shape, types.Error] = match.shape(mt, v);
    if (sel s.err)          { ret 0; }
    if (!(sel s.ok.vector)) { ret 0; }
    ret s.ok.vector.lanes;
}

fun result_vector(mt: *Match, node: u8) u32 {
    val v: opt[id.Value] = match.result(mt, Slot{node: node, index: 0});
    if (sel v.none) { ret 0; }
    ret vector_bits(mt, v.some);
}

fun operand_vector(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret vector_bits(mt, v.some);
}

fun operand_lanes(mt: *Match, node: u8, index: u8) u32 {
    val v: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel v.none) { ret 0; }
    ret lanes_of(mt, v.some);
}

fun result_lanes(mt: *Match, node: u8) u32 {
    val v: opt[id.Value] = match.result(mt, Slot{node: node, index: 0});
    if (sel v.none) { ret 0; }
    ret lanes_of(mt, v.some);
}

# a vector of at most 64 bits, which a d view holds and a 64-bit arrangement computes on
fun narrow_vector(bits: u32) bool {
    ret bits > 0 && bits <= 64;
}

pub fun vector16(mt: *Match) bool {
    ret result_vector(mt, 0) == 16;
}

pub fun vector32(mt: *Match) bool {
    ret result_vector(mt, 0) == 32;
}

pub fun vector64(mt: *Match) bool {
    ret narrow_vector(result_vector(mt, 0));
}

pub fun vector128(mt: *Match) bool {
    ret result_vector(mt, 0) == 128;
}

pub fun operand_vector64(mt: *Match) bool {
    ret narrow_vector(operand_vector(mt, 0, 0));
}

pub fun operand_vector128(mt: *Match) bool {
    ret operand_vector(mt, 0, 0) == 128;
}

pub fun operand1_vector16(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 16;
}

pub fun operand1_vector32(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 32;
}

pub fun operand1_vector64(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 64;
}

pub fun operand1_vector128(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 128;
}

# an extension of node `ext` doubles its lanes' width, keeping their count
fun doubles(mt: *Match, ext: u8) bool {
    val from: u32 = operand_vector(mt, ext, 0);
    ret from > 0 && result_vector(mt, ext) == 2 * from && result_lanes(mt, ext) == operand_lanes(mt, ext, 0);
}

# a sum across the lanes of a vector extended to twice their width, the vector of 64 or 128 bits
pub fun widened_vector64(mt: *Match) bool {
    ret doubles(mt, 1) && operand_vector(mt, 1, 0) == 64;
}

pub fun widened_vector128(mt: *Match) bool {
    ret doubles(mt, 1) && operand_vector(mt, 1, 0) == 128;
}

# whether a shuffle takes the high half of its first operand, a 128-bit vector, in order
fun high_half(mt: *Match, node: u8) bool {
    if (operand_vector(mt, node, 0) != 128) { ret false; }
    val from: u32              = operand_lanes(mt, node, 0);
    val d:    *InstructionData = match.instruction(mt, node);
    var k:    usize            = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.lanes) {
            val lanes: Slice[u32] = imm.lanes;
            if (lanes.size::u32 * 2 != from) { ret false; }
            var i: usize = 0;
            for (i < lanes.size) {
                if (lanes.data[i] != from / 2 + i::u32) { ret false; }
                i = i + 1;
            }
            ret true;
        }
        k = k + 1;
    }
    ret false;
}

# a product of two extensions to twice the width of 64-bit vectors
pub fun widening_low(mt: *Match) bool {
    ret doubles(mt, 1) && doubles(mt, 2) && operand_vector(mt, 1, 0) == 64 && operand_vector(mt, 2, 0) == 64;
}

# a product of two extensions of the high halves of 128-bit vectors
pub fun widening_high(mt: *Match) bool {
    ret doubles(mt, 1) && doubles(mt, 2) && high_half(mt, 3) && high_half(mt, 4);
}

# the widening multiply-accumulate rows, whose accumulator the rules tie
val ACCUMULATING: [12]*Row = [12]*Row{
    gen_row.SMLAL_ASIMDDIFF_L__8H_8B, gen_row.SMLAL_ASIMDDIFF_L__4S_4H, gen_row.SMLAL_ASIMDDIFF_L__2D_2S,
    gen_row.SMLAL_ASIMDDIFF_L_2_8H_16B, gen_row.SMLAL_ASIMDDIFF_L_2_4S_8H, gen_row.SMLAL_ASIMDDIFF_L_2_2D_4S,
    gen_row.UMLAL_ASIMDDIFF_L__8H_8B, gen_row.UMLAL_ASIMDDIFF_L__4S_4H, gen_row.UMLAL_ASIMDDIFF_L__2D_2S,
    gen_row.UMLAL_ASIMDDIFF_L_2_8H_16B, gen_row.UMLAL_ASIMDDIFF_L_2_4S_8H, gen_row.UMLAL_ASIMDDIFF_L_2_2D_4S,
};

# whether masc states each accumulator read and written, which a tie needs
fun accumulates() bool {
    var k: usize = 0;
    for (k < $length_of(ACCUMULATING)) {
        val r: *Row = ACCUMULATING[k];
        if (r.operands.len == 0 || r.operands.at[0].role != mo.READ_WRITE) { ret false; }
        k = k + 1;
    }
    ret true;
}

# a sum of a value and a widening product of 64-bit vectors
pub fun accumulated_low(mt: *Match) bool {
    ret accumulates() && doubles(mt, 2) && doubles(mt, 3) && operand_vector(mt, 2, 0) == 64 && operand_vector(mt, 3, 0) == 64;
}

# a sum of a value and a widening product of high halves
pub fun accumulated_high(mt: *Match) bool {
    ret accumulates() && doubles(mt, 2) && doubles(mt, 3) && high_half(mt, 4) && high_half(mt, 5);
}

fun one_bit(x: u64) bool {
    ret x != 0 && (x & (x - 1)) == 0;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# the shift's count is below its operand's width, which the bounding marks
pub fun bounded(mt: *Match) bool {
    ret match.bounded(mt, 0);
}

# the result is an integer an x register holds
pub fun result_held(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w <= 64;
}

# operand 0 is an integer an x register holds
pub fun operand_held(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 1 && w <= 64;
}

# operand 1 of node 1 is the constant zero
pub fun zero_right(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 1, 1);
    ret sel c.some && c.some == 0;
}

# a branch on one bit: node 1 compares the and of node 2 with zero, and the and's constant is one bit below its width
pub fun bit_tested(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 2, 1);
    if (sel c.none)      { ret false; }
    if (!zero_right(mt)) { ret false; }
    val x: u64 = c.some::u64;
    ret one_bit(x) && trailing(x) < operand_width(mt, 2, 0)::i64;
}

# an add's constant is twelve bits shifted up by twelve
pub fun shifted12(mt: *Match) bool {
    val c: opt[i64] = operand_bits(mt, 0, 1);
    if (sel c.none) { ret false; }
    val x: i64 = c.some;
    ret x > 0 && (x & 0xfff) == 0 && (x >> 12) <= 0xfff;
}

# two shifts of one value that together turn it round its width
pub fun rotate(mt: *Match) bool {
    val a: opt[id.Value] = match.operand(mt, Slot{node: 1, index: 0});
    val b: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 0});
    if (sel a.none)                   { ret false; }
    if (sel b.none)                   { ret false; }
    if (a.some.index != b.some.index) { ret false; }
    val l: opt[i64] = operand_bits(mt, 1, 1);
    val r: opt[i64] = operand_bits(mt, 2, 1);
    if (sel l.none) { ret false; }
    if (sel r.none) { ret false; }
    ret l.some > 0 && r.some > 0 && l.some + r.some == operand_width(mt, 1, 0)::i64;
}

# a constant's sixteen-bit chunks: the one nonzero chunk of a value, or of its
# inverse, at a width of 32 or 64 bits

fun chunk_at(c: i64, k: i64) i64 {
    ret (c >> (16 * k)::u64) & 0xffff;
}

fun low_word(c: i64) i64 {
    ret c & 0xffffffff;
}

# the one chunk of `c` below `chunks` that is nonzero, none when another is or none is
fun only(c: i64, chunks: i64) opt[i64] {
    var found: i64 = -1;
    var k:     i64 = 0;
    for (k < chunks) {
        if (chunk_at(c, k) != 0) {
            if (found >= 0) { ret opt[i64].none{}; }
            found = k;
        }
        k = k + 1;
    }
    if (found < 0) { ret opt[i64].none{}; }
    ret opt[i64].some{found};
}

fun only_at(c: i64, chunks: i64) i64 {
    val k: opt[i64] = only(c, chunks);
    if (sel k.none) { ret 0; }
    ret k.some;
}

pub fun one_chunk_32(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    val k: opt[i64] = only(low_word(c.some), 2);
    ret sel k.some;
}

pub fun one_inverted_32(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    val k: opt[i64] = only(low_word(~c.some), 2);
    ret sel k.some;
}

pub fun one_chunk_64(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    val k: opt[i64] = only(c.some, 4);
    ret sel k.some;
}

pub fun one_inverted_64(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    if (sel c.none) { ret false; }
    val k: opt[i64] = only(~c.some, 4);
    ret sel k.some;
}

# a constant whose upper word is zero
pub fun word(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    ret sel c.some && (c.some >> 32) == 0;
}

# a constant that is a number, not the address of a symbol
pub fun integral(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    ret sel c.some;
}

pub fun const_zero(mt: *Match) bool {
    val c: opt[i64] = subject_bits(mt);
    ret sel c.some && c.some == 0;
}

pub fun chunk_32(c: i64) i64 {
    ret chunk_at(low_word(c), only_at(low_word(c), 2));
}

pub fun chunk_shift_32(c: i64) i64 {
    ret 16 * only_at(low_word(c), 2);
}

pub fun inverted_32(c: i64) i64 {
    ret chunk_at(low_word(~c), only_at(low_word(~c), 2));
}

pub fun inverted_shift_32(c: i64) i64 {
    ret 16 * only_at(low_word(~c), 2);
}

pub fun chunk_64(c: i64) i64 {
    ret chunk_at(c, only_at(c, 4));
}

pub fun chunk_shift_64(c: i64) i64 {
    ret 16 * only_at(c, 4);
}

pub fun inverted_64(c: i64) i64 {
    ret chunk_at(~c, only_at(~c, 4));
}

pub fun inverted_shift_64(c: i64) i64 {
    ret 16 * only_at(~c, 4);
}

pub fun chunk0(c: i64) i64 {
    ret chunk_at(c, 0);
}

pub fun chunk1(c: i64) i64 {
    ret chunk_at(c, 1);
}

pub fun chunk2(c: i64) i64 {
    ret chunk_at(c, 2);
}

pub fun chunk3(c: i64) i64 {
    ret chunk_at(c, 3);
}

pub fun low16(c: i64) i64 {
    ret c & 0xffff;
}

pub fun low32(c: i64) i64 {
    ret low_word(c);
}

pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

pub fun negate(c: i64) i64 {
    ret 0 - c;
}

pub fun high12(c: i64) i64 {
    ret c >> 12;
}

pub fun log2_of(c: i64) i64 {
    ret trailing(c::u64);
}

# a shift left by c as ubfm: the rotation right and the top bit kept
pub fun lsl_immr_32(c: i64) i64 {
    ret (32 - c) & 31;
}

pub fun lsl_imms_32(c: i64) i64 {
    ret 31 - c;
}

pub fun lsl_immr_64(c: i64) i64 {
    ret (64 - c) & 63;
}

pub fun lsl_imms_64(c: i64) i64 {
    ret 63 - c;
}

# the object format the target's system writes, none for a target without one
fun format_of(mt: *Match) opt[*Format] {
    val f: res[*Format, record.Error] = record.format(mt.target);
    if (sel f.err) { ret opt[*Format].none{}; }
    ret opt[*Format].some{f.ok};
}

fun elf(mt: *Match) bool {
    val f: opt[*Format] = format_of(mt);
    ret sel f.some && f.some == ?format.ELF;
}

fun macho(mt: *Match) bool {
    val f: opt[*Format] = format_of(mt);
    ret sel f.some && f.some == ?format.MACHO;
}

# how the target's model reaches the link-time address a rule builds, the
# constant of a materialisation or the function's address of a func.addr,
# none for a value that is no address or a target with no model
fun reached(mt: *Match) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val v: opt[id.Value] = match.built(mt);
    if (sel v.none) { ret opt[Reach].none{}; }
    val got: res[opt[Address], match.Refusal] = match.address(mt, v.some);
    if (sel got.err)     { ret opt[Reach].none{}; }
    if (sel got.ok.none) { ret opt[Reach].none{}; }
    val at: id.Symbol = got.ok.some.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function.index];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global.index].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# an address the code reaches by its page and the offset in it, which an
# absolute one is too within the small code model
fun near(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && (sel r.some.relative || sel r.some.absolute);
}

fun tabled(mt: *Match) bool {
    val r: opt[Reach] = reached(mt);
    ret sel r.some && sel r.some.table;
}

pub fun elf_relative(mt: *Match) bool {
    ret elf(mt) && near(mt);
}

pub fun elf_table(mt: *Match) bool {
    ret elf(mt) && tabled(mt);
}

pub fun macho_relative(mt: *Match) bool {
    ret macho(mt) && near(mt);
}

pub fun macho_table(mt: *Match) bool {
    ret macho(mt) && tabled(mt);
}

fun thread(mt: *Match) opt[Access] {
    val r: opt[Reach] = reached(mt);
    if (sel r.none)           { ret opt[Access].none{}; }
    if (!(sel r.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{r.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.local_exec;
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.initial_exec;
}

# a thread-local variable reached through its tls descriptor
pub fun descriptor(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.descriptor;
}

# a thread-local variable reached through the thunk of its variable descriptor
pub fun variable(mt: *Match) bool {
    val a: opt[Access] = thread(mt);
    ret sel a.some && sel a.some.variable;
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val v: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel v.none) { ret false; }
    val got: res[opt[ConstantData], match.Refusal] = match.constant(mt, v.some);
    ret sel got.ok && sel got.ok.none;
}

# a call of a symbol, under each object format's branch relocation
pub fun elf_direct(mt: *Match) bool {
    ret elf(mt);
}

pub fun macho_direct(mt: *Match) bool {
    ret macho(mt);
}
