# the guards and derived immediates the aarch64 table's rules need beyond a type test
#
# a hook reads the values of instructions the verifier accepted, so a read the
# module or its type table refuses means a corrupted module, and the hook then
# says its guard does not hold. every fact about an operand is read through
# the match, the register width through the rule's type tests, and the object
# format through the target's record, so no hook names a system.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.collections.slice.Slice;

use aarch64_field: masc.isa.aarch64.field;
use masc.isa.aarch64.gen_row;
use mink.catalog.format;

use mirl.ir.constant.Address;
use mirl.ir.constant.ConstantData;
use mirl.ir.function;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Tls;
use mirl.ir.id;
use mirl.ir.instruction.InstructionData;
use mirl.ir.opcode.row.Immediate;
use type_format: mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.machine.select.match;
use mirl.machine.select.rule.Match;
use mirl.machine.select.rule.Slot;
use mirl.target.address;
use mirl.target.address.Access;
use mirl.target.address.Addresses;
use mirl.target.address.Reach;
use mirl.target.record;

# the bits of an integer type, zero for any other type
fun width_of(mt: *Match, v: id.Value) u32 {
    val res_shape: res[table.Shape, table.Error] = match.shape(mt, v);
    if (sel res_shape.err)           { ret 0; }
    if (!(sel res_shape.ok.integer)) { ret 0; }
    ret res_shape.ok.integer.width;
}

fun operand_width(mt: *Match, node: u8, index: u8) u32 {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret 0; }
    ret width_of(mt, opt_operand.some);
}

fun result_width(mt: *Match, node: u8, index: u8) u32 {
    val opt_result: opt[id.Value] = match.result(mt, Slot{node: node, index: index});
    if (sel opt_result.none) { ret 0; }
    ret width_of(mt, opt_result.some);
}

fun bits_of(mt: *Match, v: id.Value) opt[i64] {
    val res_bits: res[opt[i64], match.Error] = match.bits(mt, v);
    if (sel res_bits.err) { ret opt[i64].none{}; }
    ret res_bits.ok;
}

# the bits of the constant an operand is, none when it is not one
fun operand_bits(mt: *Match, node: u8, index: u8) opt[i64] {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret opt[i64].none{}; }
    ret bits_of(mt, opt_operand.some);
}

# the bits of the constant a materialisation rule builds
fun subject_bits(mt: *Match) opt[i64] {
    ret bits_of(mt, mt.subject);
}

# the bits a vector type holds, its lanes times its lane's bits, zero for a
# type that is no vector or a lane of no fixed width
fun vector_bits(mt: *Match, v: id.Value) u32 {
    val res_shape: res[table.Shape, table.Error] = match.shape(mt, v);
    if (sel res_shape.err)          { ret 0; }
    if (!(sel res_shape.ok.vector)) { ret 0; }
    val lanes:    u32                           = res_shape.ok.vector.lanes;
    val res_lane: res[table.Shape, table.Error] = table.shape(?mt.module.types, res_shape.ok.vector.element);
    if (sel res_lane.err)        { ret 0; }
    if (sel res_lane.ok.integer) { ret lanes * res_lane.ok.integer.width; }
    if (sel res_lane.ok.float) {
        val opt_row: opt[type_format.Row] = type_format.row(res_lane.ok.float.format);
        if (sel opt_row.none) { ret 0; }
        ret lanes * opt_row.some.width;
    }
    ret 0;
}

# the lanes of a vector type, zero for any other type
fun lanes_of(mt: *Match, v: id.Value) u32 {
    val res_shape: res[table.Shape, table.Error] = match.shape(mt, v);
    if (sel res_shape.err)          { ret 0; }
    if (!(sel res_shape.ok.vector)) { ret 0; }
    ret res_shape.ok.vector.lanes;
}

fun result_vector(mt: *Match, node: u8) u32 {
    val opt_result: opt[id.Value] = match.result(mt, Slot{node: node, index: 0});
    if (sel opt_result.none) { ret 0; }
    ret vector_bits(mt, opt_result.some);
}

fun operand_vector(mt: *Match, node: u8, index: u8) u32 {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret 0; }
    ret vector_bits(mt, opt_operand.some);
}

fun operand_lanes(mt: *Match, node: u8, index: u8) u32 {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: node, index: index});
    if (sel opt_operand.none) { ret 0; }
    ret lanes_of(mt, opt_operand.some);
}

fun result_lanes(mt: *Match, node: u8) u32 {
    val opt_result: opt[id.Value] = match.result(mt, Slot{node: node, index: 0});
    if (sel opt_result.none) { ret 0; }
    ret lanes_of(mt, opt_result.some);
}

# a vector of at most 64 bits, which a d view holds and a 64-bit arrangement computes on
fun narrow_vector(bits: u32) bool {
    ret bits > 0 && bits <= 64;
}

# the result is a vector of 16 bits
# ---
# mt:  the match the guard reads
# ret: whether the root's result is a vector of exactly 16 bits
pub fun vector16(mt: *Match) bool {
    ret result_vector(mt, 0) == 16;
}

# the result is a vector of 32 bits
# ---
# mt:  the match the guard reads
# ret: whether the root's result is a vector of exactly 32 bits
pub fun vector32(mt: *Match) bool {
    ret result_vector(mt, 0) == 32;
}

# the result is a vector a d view holds
# ---
# mt:  the match the guard reads
# ret: whether the root's result is a vector of at most 64 bits
pub fun vector64(mt: *Match) bool {
    ret narrow_vector(result_vector(mt, 0));
}

# the result is a vector of 128 bits
# ---
# mt:  the match the guard reads
# ret: whether the root's result is a vector of exactly 128 bits
pub fun vector128(mt: *Match) bool {
    ret result_vector(mt, 0) == 128;
}

# operand 0 is a vector a d view holds
# ---
# mt:  the match the guard reads
# ret: whether operand 0 of the root is a vector of at most 64 bits
pub fun operand_vector64(mt: *Match) bool {
    ret narrow_vector(operand_vector(mt, 0, 0));
}

# operand 0 is a vector of 128 bits
# ---
# mt:  the match the guard reads
# ret: whether operand 0 of the root is a vector of exactly 128 bits
pub fun operand_vector128(mt: *Match) bool {
    ret operand_vector(mt, 0, 0) == 128;
}

# operand 1 is a vector of 16 bits
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is a vector of exactly 16 bits
pub fun operand1_vector16(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 16;
}

# operand 1 is a vector of 32 bits
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is a vector of exactly 32 bits
pub fun operand1_vector32(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 32;
}

# operand 1 is a vector of 64 bits
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is a vector of exactly 64 bits
pub fun operand1_vector64(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 64;
}

# operand 1 is a vector of 128 bits
# ---
# mt:  the match the guard reads
# ret: whether operand 1 of the root is a vector of exactly 128 bits
pub fun operand1_vector128(mt: *Match) bool {
    ret operand_vector(mt, 0, 1) == 128;
}

# an extension of node `ext` doubles its lanes' width, keeping their count
fun doubles(mt: *Match, ext: u8) bool {
    val from: u32 = operand_vector(mt, ext, 0);
    ret from > 0 && result_vector(mt, ext) == 2 * from && result_lanes(mt, ext) == operand_lanes(mt, ext, 0);
}

# a sum across the lanes of a vector extended to twice their width, the vector of 64 or 128 bits
pub fun widened_vector64(mt: *Match) bool {
    ret doubles(mt, 1) && operand_vector(mt, 1, 0) == 64;
}

# a sum across the lanes of a 128-bit vector extended to twice their width
# ---
# mt:  the match the guard reads
# ret: whether node 1 doubles its lanes' width and its operand is a vector of 128 bits
pub fun widened_vector128(mt: *Match) bool {
    ret doubles(mt, 1) && operand_vector(mt, 1, 0) == 128;
}

# whether a shuffle takes the high half of its first operand, a 128-bit vector, in order
fun high_half(mt: *Match, node: u8) bool {
    if (operand_vector(mt, node, 0) != 128) { ret false; }
    val from: u32              = operand_lanes(mt, node, 0);
    val d:    *InstructionData = match.instruction(mt, node);
    var k:    usize            = 0;
    for (k < d.immediates.len) {
        val imm: Immediate = d.immediates.data[k];
        if (sel imm.lanes) {
            val lanes: Slice[u32] = imm.lanes;
            if (lanes.size::u32 * 2 != from) { ret false; }
            var i: usize = 0;
            for (i < lanes.size) {
                if (lanes.data[i] != from / 2 + i::u32) { ret false; }
                i = i + 1;
            }
            ret true;
        }
        k = k + 1;
    }
    ret false;
}

# an extension of each lane of a vector of at most 64 bits to twice its width
pub fun widen_low(mt: *Match) bool {
    ret doubles(mt, 0) && narrow_vector(operand_vector(mt, 0, 0));
}

# an extension of each lane of the high half of a 128-bit vector a shuffle takes
pub fun widen_high(mt: *Match) bool {
    ret doubles(mt, 0) && high_half(mt, 1);
}

# a product of two extensions to twice the width of 64-bit vectors
pub fun widening_low(mt: *Match) bool {
    ret doubles(mt, 1) && doubles(mt, 2) && operand_vector(mt, 1, 0) == 64 && operand_vector(mt, 2, 0) == 64;
}

# a product of two extensions of the high halves of 128-bit vectors
pub fun widening_high(mt: *Match) bool {
    ret doubles(mt, 1) && doubles(mt, 2) && high_half(mt, 3) && high_half(mt, 4);
}

# a sum of a value and a widening product of 64-bit vectors
pub fun accumulated_low(mt: *Match) bool {
    ret doubles(mt, 2) && doubles(mt, 3) && operand_vector(mt, 2, 0) == 64 && operand_vector(mt, 3, 0) == 64;
}

# a sum of a value and a widening product of high halves
pub fun accumulated_high(mt: *Match) bool {
    ret doubles(mt, 2) && doubles(mt, 3) && high_half(mt, 4) && high_half(mt, 5);
}

fun one_bit(x: u64) bool {
    ret x != 0 && (x & (x - 1)) == 0;
}

fun trailing(x: u64) i64 {
    var n: i64 = 0;
    var v: u64 = x;
    for (n < 64 && (v & 1) == 0) {
        v = v >> 1;
        n = n + 1;
    }
    ret n;
}

# the shift's count is below its operand's width, which the bounding marks
pub fun bounded(mt: *Match) bool {
    ret match.bounded(mt, 0);
}

# the result is an integer an x register holds
pub fun result_held(mt: *Match) bool {
    val w: u32 = result_width(mt, 0, 0);
    ret w >= 1 && w <= 64;
}

# operand 0 is an integer an x register holds
pub fun operand_held(mt: *Match) bool {
    val w: u32 = operand_width(mt, 0, 0);
    ret w >= 1 && w <= 64;
}

# operand 1 of node 1 is the constant zero
pub fun zero_right(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 1, 1);
    ret sel opt_operand_bits.some && opt_operand_bits.some == 0;
}

# operand 1 of node 2 is the constant zero, as a guard's test of a zero divisor
pub fun zero_21(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 2, 1);
    ret sel opt_operand_bits.some && opt_operand_bits.some == 0;
}

# a branch on one bit: node 1 compares the and of node 2 with zero, and the and's constant is one bit below its width
pub fun bit_tested(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 2, 1);
    if (sel opt_operand_bits.none) { ret false; }
    if (!zero_right(mt))           { ret false; }
    val x: u64 = opt_operand_bits.some::u64;
    ret one_bit(x) && trailing(x) < operand_width(mt, 2, 0)::i64;
}

# whether the constant operand of the index node of a load's register offset
# is `k`, the shift or the multiplier its scale takes
fun index_by(mt: *Match, k: i64) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 2, 1);
    if (sel opt_operand_bits.none) { ret false; }
    ret opt_operand_bits.some == k;
}

# an index shifted by one, the scale of a halfword's register offset
pub fun index_shl1(mt: *Match) bool {
    ret index_by(mt, 1);
}

# an index shifted by two, the scale of a word's register offset
pub fun index_shl2(mt: *Match) bool {
    ret index_by(mt, 2);
}

# an index shifted by three, the scale of a doubleword's register offset
pub fun index_shl3(mt: *Match) bool {
    ret index_by(mt, 3);
}

# an index times one, a byte's register offset
pub fun index_mul1(mt: *Match) bool {
    ret index_by(mt, 1);
}

# an index times two, the scale of a halfword's register offset
pub fun index_mul2(mt: *Match) bool {
    ret index_by(mt, 2);
}

# an index times four, the scale of a word's register offset
pub fun index_mul4(mt: *Match) bool {
    ret index_by(mt, 4);
}

# an index times eight, the scale of a doubleword's register offset
pub fun index_mul8(mt: *Match) bool {
    ret index_by(mt, 8);
}

# an add's constant is twelve bits shifted up by twelve
pub fun shifted12(mt: *Match) bool {
    val opt_operand_bits: opt[i64] = operand_bits(mt, 0, 1);
    if (sel opt_operand_bits.none) { ret false; }
    val x: i64 = opt_operand_bits.some;
    ret x > 0 && (x & 0xfff) == 0 && (x >> 12) <= 0xfff;
}

# two shifts of one value that together turn it round its width
pub fun rotate(mt: *Match) bool {
    val opt_operand:      opt[id.Value] = match.operand(mt, Slot{node: 1, index: 0});
    val opt_operand_slot: opt[id.Value] = match.operand(mt, Slot{node: 2, index: 0});
    if (sel opt_operand.none)                      { ret false; }
    if (sel opt_operand_slot.none)                 { ret false; }
    if (opt_operand.some != opt_operand_slot.some) { ret false; }
    val opt_operand_bits: opt[i64] = operand_bits(mt, 1, 1);
    val opt_rotate_bits:  opt[i64] = operand_bits(mt, 2, 1);
    if (sel opt_operand_bits.none) { ret false; }
    if (sel opt_rotate_bits.none)  { ret false; }
    ret opt_operand_bits.some > 0 && opt_rotate_bits.some > 0 && opt_operand_bits.some + opt_rotate_bits.some == operand_width(mt, 1, 0)::i64;
}

# a constant's sixteen-bit chunks: the one nonzero chunk of a value, or of its
# inverse, at a width of 32 or 64 bits

fun chunk_at(c: i64, k: i64) i64 {
    ret (c >> (16 * k)::u64) & 0xffff;
}

fun low_word(c: i64) i64 {
    ret c & 0xffffffff;
}

# the one chunk of `c` below `chunks` that is nonzero, none when another is or none is
fun only(c: i64, chunks: i64) opt[i64] {
    var found: i64 = -1;
    var k:     i64 = 0;
    for (k < chunks) {
        if (chunk_at(c, k) != 0) {
            if (found >= 0) { ret opt[i64].none{}; }
            found = k;
        }
        k = k + 1;
    }
    if (found < 0) { ret opt[i64].none{}; }
    ret opt[i64].some{found};
}

fun only_at(c: i64, chunks: i64) i64 {
    val opt_only: opt[i64] = only(c, chunks);
    if (sel opt_only.none) { ret 0; }
    ret opt_only.some;
}

# a constant whose low word has one nonzero sixteen-bit chunk, which movz builds
# ---
# mt:  the match the guard reads
# ret: whether exactly one chunk of the constant's low 32 bits is nonzero
pub fun one_chunk_32(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    val opt_only: opt[i64] = only(low_word(opt_subject_bits.some), 2);
    ret sel opt_only.some;
}

# a constant whose inverted low word has one nonzero sixteen-bit chunk, which movn builds
# ---
# mt:  the match the guard reads
# ret: whether exactly one chunk of the inverse's low 32 bits is nonzero
pub fun one_inverted_32(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    val opt_only: opt[i64] = only(low_word(~opt_subject_bits.some), 2);
    ret sel opt_only.some;
}

# a constant with one nonzero sixteen-bit chunk, which movz builds
# ---
# mt:  the match the guard reads
# ret: whether exactly one chunk of the constant's 64 bits is nonzero
pub fun one_chunk_64(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    val opt_only: opt[i64] = only(opt_subject_bits.some, 4);
    ret sel opt_only.some;
}

# a constant whose inverse has one nonzero sixteen-bit chunk, which movn builds
# ---
# mt:  the match the guard reads
# ret: whether exactly one chunk of the inverse's 64 bits is nonzero
pub fun one_inverted_64(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    if (sel opt_subject_bits.none) { ret false; }
    val opt_only: opt[i64] = only(~opt_subject_bits.some, 4);
    ret sel opt_only.some;
}

# a logical immediate: the constant's low `domain` bits, 32 or 64, are a
# value masc encodes as a bitmask immediate, which no value of all zeros or
# all ones is
fun bitmask(c: opt[i64], domain: u32) bool {
    if (sel c.none) { ret false; }
    val opt_code: opt[u64] = aarch64_field.encode_bitmask(c.some:~u64, domain);
    ret sel opt_code.some;
}

# a constant a 32-bit orr from the zero register builds
pub fun bitmask_32(mt: *Match) bool {
    ret bitmask(subject_bits(mt), 32);
}

# a constant a 64-bit orr from the zero register builds
pub fun bitmask_64(mt: *Match) bool {
    ret bitmask(subject_bits(mt), 64);
}

# a 32-bit logic operation whose second operand is a bitmask immediate
pub fun operand_bitmask_32(mt: *Match) bool {
    ret bitmask(operand_bits(mt, 0, 1), 32);
}

# a 64-bit logic operation whose second operand is a bitmask immediate
pub fun operand_bitmask_64(mt: *Match) bool {
    ret bitmask(operand_bits(mt, 0, 1), 64);
}

# a constant whose upper word is zero
pub fun word(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    ret sel opt_subject_bits.some && (opt_subject_bits.some >> 32) == 0;
}

# a constant that is a number, not the address of a symbol
pub fun integral(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    ret sel opt_subject_bits.some;
}

# a constant that is the number zero
# ---
# mt:  the match the guard reads
# ret: whether the constant the rule builds is a number and zero
pub fun const_zero(mt: *Match) bool {
    val opt_subject_bits: opt[i64] = subject_bits(mt);
    ret sel opt_subject_bits.some && opt_subject_bits.some == 0;
}

# the one nonzero sixteen-bit chunk of a constant's low word
# ---
# c:   the constant's bits
# ret: the chunk, or the lowest chunk when no single one is nonzero
pub fun chunk_32(c: i64) i64 {
    ret chunk_at(low_word(c), only_at(low_word(c), 2));
}

# the shift of the one nonzero sixteen-bit chunk of a constant's low word
# ---
# c:   the constant's bits
# ret: 0 or 16, and 0 when no single chunk is nonzero
pub fun chunk_shift_32(c: i64) i64 {
    ret 16 * only_at(low_word(c), 2);
}

# the one nonzero sixteen-bit chunk of a constant's inverted low word
# ---
# c:   the constant's bits
# ret: the chunk, or the lowest chunk when no single one is nonzero
pub fun inverted_32(c: i64) i64 {
    ret chunk_at(low_word(~c), only_at(low_word(~c), 2));
}

# the shift of the one nonzero sixteen-bit chunk of a constant's inverted low word
# ---
# c:   the constant's bits
# ret: 0 or 16, and 0 when no single chunk is nonzero
pub fun inverted_shift_32(c: i64) i64 {
    ret 16 * only_at(low_word(~c), 2);
}

# the one nonzero sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: the chunk, or the lowest chunk when no single one is nonzero
pub fun chunk_64(c: i64) i64 {
    ret chunk_at(c, only_at(c, 4));
}

# the shift of the one nonzero sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: 0, 16, 32 or 48, and 0 when no single chunk is nonzero
pub fun chunk_shift_64(c: i64) i64 {
    ret 16 * only_at(c, 4);
}

# the one nonzero sixteen-bit chunk of a constant's inverse
# ---
# c:   the constant's bits
# ret: the chunk, or the lowest chunk when no single one is nonzero
pub fun inverted_64(c: i64) i64 {
    ret chunk_at(~c, only_at(~c, 4));
}

# the shift of the one nonzero sixteen-bit chunk of a constant's inverse
# ---
# c:   the constant's bits
# ret: 0, 16, 32 or 48, and 0 when no single chunk is nonzero
pub fun inverted_shift_64(c: i64) i64 {
    ret 16 * only_at(~c, 4);
}

# a constant as it is
# ---
# c:   the constant's bits
# ret: `c` unchanged
pub fun same(c: i64) i64 {
    ret c;
}

# the lowest sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: bits 0 to 15 of `c`
pub fun chunk0(c: i64) i64 {
    ret chunk_at(c, 0);
}

# the second sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: bits 16 to 31 of `c`
pub fun chunk1(c: i64) i64 {
    ret chunk_at(c, 1);
}

# the third sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: bits 32 to 47 of `c`
pub fun chunk2(c: i64) i64 {
    ret chunk_at(c, 2);
}

# the highest sixteen-bit chunk of a constant
# ---
# c:   the constant's bits
# ret: bits 48 to 63 of `c`
pub fun chunk3(c: i64) i64 {
    ret chunk_at(c, 3);
}

# the low 16 bits of a constant
# ---
# c:   the constant's bits
# ret: `c` masked to its low 16 bits
pub fun low16(c: i64) i64 {
    ret c & 0xffff;
}

# the low 32 bits of a constant
# ---
# c:   the constant's bits
# ret: `c` masked to its low 32 bits
pub fun low32(c: i64) i64 {
    ret low_word(c);
}

# the lowest bit of a constant
# ---
# c:   the constant's bits
# ret: 0 or 1
pub fun low_bit(c: i64) i64 {
    ret c & 1;
}

# the negation of a constant
# ---
# c:   the constant's bits
# ret: `0 - c`
pub fun negate(c: i64) i64 {
    ret 0 - c;
}

# the immediate of an add whose constant is shifted up by twelve
# ---
# c:   the constant's bits
# ret: `c` shifted right by 12
pub fun high12(c: i64) i64 {
    ret c >> 12;
}

# the base 2 logarithm of a constant that is a power of two
# ---
# c:   the constant's bits
# ret: the count of trailing zero bits, 64 for zero
pub fun log2_of(c: i64) i64 {
    ret trailing(c::u64);
}

# a shift left by c as ubfm: the rotation right and the top bit kept
pub fun lsl_immr_32(c: i64) i64 {
    ret (32 - c) & 31;
}

# the top bit ubfm keeps for a 32-bit shift left by `c`
# ---
# c:   the constant's bits
# ret: `31 - c`
pub fun lsl_imms_32(c: i64) i64 {
    ret 31 - c;
}

# the rotation right ubfm takes for a 64-bit shift left by `c`
# ---
# c:   the constant's bits
# ret: `(64 - c) & 63`
pub fun lsl_immr_64(c: i64) i64 {
    ret (64 - c) & 63;
}

# the top bit ubfm keeps for a 64-bit shift left by `c`
# ---
# c:   the constant's bits
# ret: `63 - c`
pub fun lsl_imms_64(c: i64) i64 {
    ret 63 - c;
}

fun elf(mt: *Match) bool {
    ret record.format(mt.target) == ?format.ELF;
}

fun macho(mt: *Match) bool {
    ret record.format(mt.target) == ?format.MACHO;
}

fun coff(mt: *Match) bool {
    ret record.format(mt.target) == ?format.COFF;
}

# how the target's model reaches the link-time address a rule builds, the
# constant of a materialisation or the function's address of a func.addr,
# none for a value that is no address or a target with no model
fun reached(mt: *Match) opt[Reach] {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret opt[Reach].none{}; }
    val opt_built: opt[id.Value] = match.built(mt);
    if (sel opt_built.none) { ret opt[Reach].none{}; }
    val res_address: res[opt[Address], match.Error] = match.address(mt, opt_built.some);
    if (sel res_address.err)     { ret opt[Reach].none{}; }
    if (sel res_address.ok.none) { ret opt[Reach].none{}; }
    val at: id.Symbol = res_address.ok.some.symbol;
    if (sel at.function) {
        val f: *function.Node = ?mt.module.functions.data[at.function];
        ret opt[Reach].some{address.reach(?model.model, f.body.blocks.len > 0, f.data.linkage, opt[Tls].none{})};
    }
    val g: *GlobalData = ?mt.module.globals.data[at.global].data;
    ret opt[Reach].some{address.reach(?model.model, sel g.initial.some, g.linkage, g.tls)};
}

# an address the code reaches by its page and the offset in it, which an
# absolute one is too within the small code model
fun near(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && (sel opt_reached.some.relative || sel opt_reached.some.absolute);
}

fun tabled(mt: *Match) bool {
    val opt_reached: opt[Reach] = reached(mt);
    ret sel opt_reached.some && sel opt_reached.some.table;
}

# an address the code reaches by its page and offset on elf
# ---
# mt:  the match the guard reads
# ret: whether the format is elf and the model reaches the address relative or absolute
pub fun elf_relative(mt: *Match) bool {
    ret elf(mt) && near(mt);
}

# an address loaded from the global offset table on elf
# ---
# mt:  the match the guard reads
# ret: whether the format is elf and the model reaches the address through the table
pub fun elf_table(mt: *Match) bool {
    ret elf(mt) && tabled(mt);
}

# an address the code reaches by its page and offset on mach-o
# ---
# mt:  the match the guard reads
# ret: whether the format is mach-o and the model reaches the address relative or absolute
pub fun macho_relative(mt: *Match) bool {
    ret macho(mt) && near(mt);
}

# an address loaded from the global offset table on mach-o
# ---
# mt:  the match the guard reads
# ret: whether the format is mach-o and the model reaches the address through the table
pub fun macho_table(mt: *Match) bool {
    ret macho(mt) && tabled(mt);
}

# an address the code reaches by its page and offset on coff
# ---
# mt:  the match the guard reads
# ret: whether the format is coff and the model reaches the address relative or absolute
pub fun coff_relative(mt: *Match) bool {
    ret coff(mt) && near(mt);
}

fun thread(mt: *Match) opt[Access] {
    val opt_reached: opt[Reach] = reached(mt);
    if (sel opt_reached.none)           { ret opt[Access].none{}; }
    if (!(sel opt_reached.some.thread)) { ret opt[Access].none{}; }
    ret opt[Access].some{opt_reached.some.thread};
}

# a thread-local variable at a link-time offset from the thread pointer
pub fun local_exec(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.local_exec;
}

# a thread-local variable at an offset the global offset table holds
pub fun initial_exec(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.initial_exec;
}

# a thread-local variable reached through its tls descriptor
pub fun descriptor(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.descriptor;
}

# a thread-local variable reached through the thunk of its variable descriptor
pub fun variable(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.variable;
}

# a thread-local variable reached through the module's block in the thread's
# table, at the index the loader writes in the cell the model names
pub fun thread_indexed(mt: *Match) bool {
    val opt_thread: opt[Access] = thread(mt);
    ret sel opt_thread.some && sel opt_thread.some.indexed && coff(mt);
}

# a call whose callee is a value in a register, not the address of a symbol
pub fun indirect(mt: *Match) bool {
    val opt_operand: opt[id.Value] = match.operand(mt, Slot{node: 0, index: 0});
    if (sel opt_operand.none) { ret false; }
    val res_constant: res[opt[ConstantData], match.Error] = match.constant(mt, opt_operand.some);
    ret sel res_constant.ok && sel res_constant.ok.none;
}

# a call of a symbol, under each object format's branch relocation
pub fun elf_direct(mt: *Match) bool {
    ret elf(mt);
}

# a call of a symbol under mach-o's branch relocation
# ---
# mt:  the match the guard reads
# ret: whether the target's object format is mach-o
pub fun macho_direct(mt: *Match) bool {
    ret macho(mt);
}

# a call of a symbol under coff's branch relocation
# ---
# mt:  the match the guard reads
# ret: whether the target's object format is coff
pub fun coff_direct(mt: *Match) bool {
    ret coff(mt);
}

# a switch whose cases index a table of its targets, on a target whose
# address model places the table. adrp and add reach the function's own
# table under every relocation model, so no model chooses the sequence
pub fun indexed(mt: *Match) bool {
    val model: Addresses = mt.target.addresses;
    if (!(sel model.model)) { ret false; }
    ret match.indexed(mt);
}

# a jump table whose count of entries movz and movk build in two chunks
pub fun indexed_word(mt: *Match) bool {
    if (!indexed(mt)) { ret false; }
    val d: *InstructionData = match.instruction(mt, 0);
    ret d.edges.len - 1 <= 0xffffffff;
}
