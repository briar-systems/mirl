    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.bitmask_64, expansion: Emits{at: ?E_CONSTANT_X_ORRI[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.one_chunk_64, expansion: Emits{at: ?E_CONSTANT_X_ONE_CHUNK_64_MOVZ[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.one_inverted_64, expansion: Emits{at: ?E_CONSTANT_X_ONE_INVERTED_64[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.word, expansion: Emits{at: ?E_CONSTANT_X_WORD[0], len: 2}, cost: 4},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.integral, expansion: Emits{at: ?E_CONSTANT_X_MOVZMOVK_I64[0], len: 4}, cost: 8},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: nil, len: 0}, orderings: nil, hook: hook.elf_relative, expansion: Emits{at: ?E_CONSTANT_X_ELF_RELATIVE[0], len: 2}, cost: 4},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: nil, len: 0}, orderings: nil, hook: hook.elf_table, expansion: Emits{at: ?E_CONSTANT_X_ELF_TABLE[0], len: 2}, cost: 4},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: nil, len: 0}, orderings: nil, hook: hook.macho_relative, expansion: Emits{at: ?E_CONSTANT_X_MACHO_RELATIVE[0], len: 2}, cost: 4},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: nil, len: 0}, orderings: nil, hook: hook.macho_table, expansion: Emits{at: ?E_CONSTANT_X_MACHO_TABLE[0], len: 2}, cost: 4},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.local_exec, expansion: Emits{at: ?E_CONSTANT_X_LOCAL_EXEC[0], len: 3}, cost: 6},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.initial_exec, expansion: Emits{at: ?E_CONSTANT_X_INITIAL_EXEC[0], len: 4}, cost: 8},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.descriptor, expansion: Emits{at: ?E_CONSTANT_X_DESCRIPTOR[0], len: 6}, cost: 12},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: hook.variable, expansion: Emits{at: ?E_CONSTANT_X_VARIABLE[0], len: 5}, cost: 10},
