};

# integers and pointers live in the x registers, and floats and vectors in
# the v registers, on every build: fp and simd are the baseline aapcs64 and
# darwinpcs require
val HOLDS: [5]Hold = [5]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.X_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.X_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY32}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.V_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY64}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.V_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.vector{}, holder: Holder.hardware{?gen_register.CLASSES[gen_register.V_CLASS]}, requires: Condition.always{}},
};

# the offset of an address past its symbol, added after a relocation that
# carries none built the symbol's address: by an add or a sub of twelve bits,
# and through a register movz and movk build otherwise
val S_R0_R0_OFF_L0:      [4]Source = [4]Source{Source.result{0}, Source.result{0}, Source.offset{hook.same}, Source.literal{0}};
val S_R0_R0_OFFNEG_L0:   [4]Source = [4]Source{Source.result{0}, Source.result{0}, Source.offset{hook.negate}, Source.literal{0}};
val S_Q0X_OFFCHUNK0_L0:  [3]Source = [3]Source{Source.scratch{Scratch{index: 0, class: ?gen_register.CLASSES[gen_register.X_CLASS]}}, Source.offset{hook.chunk0}, Source.literal{0}};
val S_Q0X_OFFCHUNK1_L16: [3]Source = [3]Source{Source.scratch{Scratch{index: 0, class: ?gen_register.CLASSES[gen_register.X_CLASS]}}, Source.offset{hook.chunk1}, Source.literal{16}};
val S_Q0X_OFFCHUNK2_L32: [3]Source = [3]Source{Source.scratch{Scratch{index: 0, class: ?gen_register.CLASSES[gen_register.X_CLASS]}}, Source.offset{hook.chunk2}, Source.literal{32}};
val S_Q0X_OFFCHUNK3_L48: [3]Source = [3]Source{Source.scratch{Scratch{index: 0, class: ?gen_register.CLASSES[gen_register.X_CLASS]}}, Source.offset{hook.chunk3}, Source.literal{48}};
val S_R0_R0_Q0X_L0_L0:   [5]Source = [5]Source{Source.result{0}, Source.result{0}, Source.scratch{Scratch{index: 0, class: ?gen_register.CLASSES[gen_register.X_CLASS]}}, Source.literal{0}, Source.literal{0}};
val E_OFFSET_ADD:        [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{gen_row.ADD_64_ADDSUB_IMM}, operands: Sources{at: ?S_R0_R0_OFF_L0[0], len: 4}, implied: NO_IMPLIED}};
val E_OFFSET_SUB:        [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{gen_row.SUB_64_ADDSUB_IMM}, operands: Sources{at: ?S_R0_R0_OFFNEG_L0[0], len: 4}, implied: NO_IMPLIED}};
val E_OFFSET_WIDE:       [5]Emit   = [5]Emit{Emit{opcode: Opcode.row{gen_row.MOVZ_64_MOVEWIDE}, operands: Sources{at: ?S_Q0X_OFFCHUNK0_L0[0], len: 3}, implied: NO_IMPLIED}, Emit{opcode: Opcode.row{gen_row.MOVK_64_MOVEWIDE}, operands: Sources{at: ?S_Q0X_OFFCHUNK1_L16[0], len: 3}, implied: NO_IMPLIED}, Emit{opcode: Opcode.row{gen_row.MOVK_64_MOVEWIDE}, operands: Sources{at: ?S_Q0X_OFFCHUNK2_L32[0], len: 3}, implied: NO_IMPLIED}, Emit{opcode: Opcode.row{gen_row.MOVK_64_MOVEWIDE}, operands: Sources{at: ?S_Q0X_OFFCHUNK3_L48[0], len: 3}, implied: NO_IMPLIED}, Emit{opcode: Opcode.row{gen_row.ADD_64_ADDSUB_SHIFT}, operands: Sources{at: ?S_R0_R0_Q0X_L0_L0[0], len: 5}, implied: NO_IMPLIED}};

val OFFSETS: [3]Rule = [3]Rule{
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: nil, expansion: Emits{at: ?E_OFFSET_ADD[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: nil, expansion: Emits{at: ?E_OFFSET_SUB[0], len: 1}, cost: 2},
    Rule{nodes: Nodes{at: nil, len: 0}, tests: Tests{at: ?T_K_PTRR[0], len: 1}, orderings: nil, hook: nil, expansion: Emits{at: ?E_OFFSET_WIDE[0], len: 5}, cost: 10},
};

# the jump every block that falls nowhere ends with
val S_JUMP: [1]Source = [1]Source{Source.target{0}};
val E_JUMP: [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{gen_row.B_ONLY_BRANCH_IMM}, operands: Sources{at: ?S_JUMP[0], len: 1}, implied: NO_IMPLIED}};

# the aarch64 table
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: $length_of(RULES)},
    constants: Rules{at: ?CONSTANTS[0], len: $length_of(CONSTANTS)},
    holds:     Holds{at: ?HOLDS[0], len: $length_of(HOLDS)},
    jump:      Emits{at: ?E_JUMP[0], len: $length_of(E_JUMP)},
    offsets:   Rules{at: ?OFFSETS[0], len: $length_of(OFFSETS)},
};
