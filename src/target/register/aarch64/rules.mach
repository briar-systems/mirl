# the orderings a rule of an atomic access or a fence is chosen for, each a
# column of the mapping in doc/isa/aarch64.md: relaxed, acquire, release and
# acq_rel with seq_cst for a read-modify-write, an acquiring load and a
# releasing store, which seq_cst takes too, and the fences that order stores
val RELAXED:   ir.Orderings = ir.Orderings{relaxed: true, acquire: false, release: false, acq_rel: false, seq_cst: false};
val ACQUIRE:   ir.Orderings = ir.Orderings{relaxed: false, acquire: true, release: false, acq_rel: false, seq_cst: false};
val RELEASE:   ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: true, acq_rel: false, seq_cst: false};
val STRONG:    ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: false, acq_rel: true, seq_cst: true};
val ACQUIRING: ir.Orderings = ir.Orderings{relaxed: false, acquire: true, release: false, acq_rel: false, seq_cst: true};
val RELEASING: ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: true, acq_rel: false, seq_cst: true};
val FENCED:    ir.Orderings = ir.Orderings{relaxed: false, acquire: false, release: true, acq_rel: true, seq_cst: true};

# the ir patterns: each node an opcode, the node it is an operand of and at
# which operand, and how many of its operands must be constants
