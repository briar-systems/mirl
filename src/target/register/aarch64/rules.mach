# integers and pointers live in the x registers, and floats and vectors in
# the v registers, on every build: fp and simd are the baseline aapcs64 and
# darwinpcs require
val HOLDS: [5]Hold = [5]Hold{
    Hold{class: Class.integer{}, holder: Holder.hardware{?gen_register.CLASSES[gen.X_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.pointer{}, holder: Holder.hardware{?gen_register.CLASSES[gen.X_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY32}, holder: Holder.hardware{?gen_register.CLASSES[gen.V_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.format{format.BINARY64}, holder: Holder.hardware{?gen_register.CLASSES[gen.V_CLASS]}, requires: Condition.always{}},
    Hold{class: Class.vector{}, holder: Holder.hardware{?gen_register.CLASSES[gen.V_CLASS]}, requires: Condition.always{}},
};

val S_JUMP: [1]Source = [1]Source{Source.target{0}};
val E_JUMP: [1]Emit   = [1]Emit{Emit{opcode: Opcode.row{gen_row.B_ONLY_BRANCH_IMM}, operands: Sources{at: ?S_JUMP[0], len: 1}, implied: NO_IMPLIED}};

# the aarch64 table
pub val TABLE: Table = Table{
    rules:     Rules{at: ?RULES[0], len: 1407},
    constants: Rules{at: ?CONSTANTS[0], len: 31},
    holds:     Holds{at: ?HOLDS[0], len: 5},
    jump:      Emits{at: ?E_JUMP[0], len: 1},
};
