# what mirl writes for aarch64: the selection table, the frame code, the
# moves and the loops its record in mirl.target.register.isa joins to masc's
# set
#
# the table names the masc rows it emits and guards on the extensions masc
# admits for a row, so lse's atomics, cssc's counts and sve's whole register
# moves are chosen where the build holds them and the base rows or the
# exclusive loops of mirl.target.register.aarch64.loop otherwise. aarch64
# establishes no configuration state: the vector length is the
# implementation's, read through the scale of masc's z class.

use mirl.target.register.aarch64.declared;
use mirl.target.register.aarch64.frame;
use mirl.target.register.aarch64.loop;
use mirl.target.register.aarch64.move;
use mirl.target.register.aarch64.rules;

fwd rules.TABLE;
fwd declared.Declared;
fwd declared.DECLARED;
fwd frame.FRAME;
fwd move.MOVES;
fwd loop.LOOPS;
