# stands in for the aarch64 register and class handles masc generates, and is deleted at the masc take that publishes them (masc#440)
#
# each class is masc's class row by its place in CLASS_NAMES order at masc ad1c60c, and each register its
# `register.make(class, number)` identity, named as masc's generator names a handle. only the handles mirl reads are here. a class is its place, read as `?gen_register.CLASSES[gen.X_CLASS]`.

use masc.core.register;
use masc.isa.aarch64.gen_register;

pub val X_CLASS: u16 = 0;
pub val V_CLASS: u16 = 11;
pub val Z_CLASS: u16 = 12;
pub val P_CLASS: u16 = 13;

