# the operations the aarch64 table has no rule for, and why
#
# an operation here is taken out before selection or waits for the job that
# closes it. an operand a rule's type test does not admit, as a vector of a
# lane count no neon arrangement holds or a select of vectors, is refused by
# the engine, naming it.

use std.types.string.str;

use ir: mirl.ir.opcode;

# why an opcode has no rule
# ---
# opcode: the opcode
# why:    what takes it out of selection
# owner:  the issue of the job that closes it, zero when no job does yet
pub rec Declared {
    opcode: ir.Opcode;
    why:    str;
    owner:  u32;
}

pub val VECTOR:     str = "a vector operation the neon subset does not select, a lane named by an immediate no source reads, a shuffle other than a high half and every reduction but a sum, waits for the vector job";
pub val CONVENTION: str = "the abi legalisation puts a call and a return in piece form, which the rules select";
pub val ADDRESS:    str = "the address legalisation folds a typed address to a ptr.add of its byte offset, which the rules select";
pub val CHAIN:      str = "the compare chain legalisation lowers a multi-way branch to eq and cbr, which the rules select";
pub val AGGREGATE:  str = "an aggregate value is held in no register, so it is taken apart before selection";

pub val DECLARED: [27]Declared = [27]Declared{
    Declared{opcode: ir.VBUILD, why: VECTOR, owner: 72},
    Declared{opcode: ir.VSHUFFLE, why: VECTOR, owner: 72},
    Declared{opcode: ir.VEXTRACT, why: VECTOR, owner: 72},
    Declared{opcode: ir.VINSERT, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FADD_SEQ, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_MUL, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_AND, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_OR, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_XOR, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_SMIN, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_SMAX, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_UMIN, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_UMAX, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FADD_ANY, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMUL_ANY, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMIN, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMAX, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMINNUM, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMAXNUM, why: VECTOR, owner: 72},
    Declared{opcode: ir.REDUCE_FMUL_SEQ, why: VECTOR, owner: 72},
    Declared{opcode: ir.CALL, why: CONVENTION, owner: 29},
    Declared{opcode: ir.RET, why: CONVENTION, owner: 29},
    Declared{opcode: ir.PTR_MEMBER, why: ADDRESS, owner: 300},
    Declared{opcode: ir.PTR_INDEX, why: ADDRESS, owner: 300},
    Declared{opcode: ir.SWITCH, why: CHAIN, owner: 300},
    Declared{opcode: ir.EXTRACT, why: AGGREGATE, owner: 178},
    Declared{opcode: ir.INSERT, why: AGGREGATE, owner: 178},
};
