# the attribute schema of the register family
#
# a function that states `naked` with the datum 1 is its body as written:
# selection moves none of its parameters, which arrive where the convention
# places them, and the frame lays no prologue, epilogue or save around it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;

use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.attribute.Kind;
use mirl.ir.id;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.target.capability.Attached;
use mirl.target.capability.Attaches;
use mirl.target.capability.Entry;
use mirl.target.capability.Schema;
use mirl.target.capability.Violation;

# the family word every register attribute is spelled with
pub val FAMILY: str = "register";

pub val NAKED_DATUM: Violation = Violation{name: "naked", what: "a naked function whose datum is not 1"};

fun named(v: View, s: str) bool {
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether function `f` of `m` states `naked`
pub fun naked(m: *Module, f: id.Function) bool {
    val list: res[Slice[Attribute], module.Error] = module.attributes(m, id.Symbol.function{f});
    if (sel list.err) { ret false; }
    var i: usize = 0;
    for (i < list.ok.size) {
        val at: *Attribute = ?list.ok.data[i];
        if (named(at.family, FAMILY) && named(at.name, "naked")) { ret unit(at.datum); }
        i = i + 1;
    }
    ret false;
}

fun unit(d: Datum) bool {
    if (!(sel d.integer)) { ret false; }
    ret d.integer == 1;
}

fun naked_check(a: *Attached) opt[*Violation] {
    if (unit(a.datum)) { ret opt[*Violation].none{}; }
    ret opt[*Violation].some{?NAKED_DATUM};
}

val ENTRIES: [1]Entry = [1]Entry{
    Entry{name: "naked", datum: Kind.integer{}, attaches: Attaches.function{}, check: naked_check},
};

pub val SCHEMA: Schema = Schema{family: FAMILY, entries: Slice[Entry]{data: ?ENTRIES[0], size: 1}};
