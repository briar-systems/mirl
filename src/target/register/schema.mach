# the attribute schema of the register family
#
# a function that states `naked` with the datum 1 is its body as written:
# selection moves none of its parameters, which arrive where the convention
# places them, and the frame lays no prologue, epilogue or save around it.
#
# a thunk of a bridge between two conventions' code states each function it
# serves by name, as `entry`, `exit` or `guest`, which the emitter states to
# the object as its bridges.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.collections.slice.Slice;

use mirl.ir.attribute.Attribute;
use mirl.ir.attribute.Datum;
use mirl.ir.attribute.Kind;
use mirl.ir.id;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.target.capability.Attached;
use mirl.target.capability.Attaches;
use mirl.target.capability.Entry;
use mirl.target.capability.Schema;
use mirl.target.capability.Violation;

# the family word every register attribute is spelled with
pub val FAMILY: str = "register";

pub val NAKED_DATUM: Violation = Violation{name: "naked", what: "a naked function whose datum is not 1"};

fun named(v: View, s: str) bool {
    val n: usize = str_len(s);
    if (v.len != n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (v.data[i] != s[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether function `f` of `m` states `naked`
pub fun naked(m: *Module, f: id.Function) bool {
    val list: res[Slice[Attribute], module.Error] = module.attributes(m, id.Symbol.function{f});
    if (sel list.err) { ret false; }
    var i: usize = 0;
    for (i < list.ok.size) {
        val at: *Attribute = ?list.ok.data[i];
        if (named(at.family, FAMILY) && named(at.name, "naked")) { ret unit(at.datum); }
        i = i + 1;
    }
    ret false;
}

fun unit(d: Datum) bool {
    if (!(sel d.integer)) { ret false; }
    ret d.integer == 1;
}

fun naked_check(a: *Attached) opt[*Violation] {
    if (unit(a.datum)) { ret opt[*Violation].none{}; }
    ret opt[*Violation].some{?NAKED_DATUM};
}

fun served_check(a: *Attached) opt[*Violation] {
    if (sel a.datum.text && a.datum.text.len != 0) { ret opt[*Violation].none{}; }
    ret opt[*Violation].some{?SERVED_DATUM};
}

pub val SERVED_DATUM: Violation = Violation{name: "entry, exit or guest", what: "a bridge thunk whose datum names no function"};

# the roles a thunk of a bridge serves a function in, each datum the name of
# the function served: an entry thunk the function an emulated caller
# enters, an exit thunk the callee a native caller leaves for, and a guest
# exit thunk the callee it stands in for
pub val ENTRY: str = "entry";
pub val EXIT:  str = "exit";
pub val GUEST: str = "guest";

# sorted by name
val ENTRIES: [4]Entry = [4]Entry{
    Entry{name: ENTRY, datum: Kind.text{}, attaches: Attaches.function{}, check: served_check},
    Entry{name: EXIT, datum: Kind.text{}, attaches: Attaches.function{}, check: served_check},
    Entry{name: GUEST, datum: Kind.text{}, attaches: Attaches.function{}, check: served_check},
    Entry{name: "naked", datum: Kind.integer{}, attaches: Attaches.function{}, check: naked_check},
};

pub val SCHEMA: Schema = Schema{family: FAMILY, entries: Slice[Entry]{data: ?ENTRIES[0], size: $length_of(ENTRIES)}};

# whether an attribute is the register family's of a name
pub fun is(at: *Attribute, name: str) bool {
    ret named(at.family, FAMILY) && named(at.name, name);
}
