# the attribute schema of the register family
#
# no register stage reads a fact only this family needs about a function or
# global, so the schema defines no attribute and refuses every one by name.

use std.collections.slice.Slice;

use mirl.target.capability.Entry;
use mirl.target.capability.Schema;

pub val SCHEMA: Schema = Schema{family: "register", entries: Slice[Entry]{data: nil, size: 0}};
