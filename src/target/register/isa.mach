# the instruction sets the register family carries, one record each
#
# this is the one registry of mirl.machine.isa records. the family hands it to
# the compilation, which hands it to the selection engine and the machine
# text, so none of them imports a set. a record names masc's set by the record
# masc's registry holds, the one the target's machine selects from, and a
# second set is a record beside the first.

use std.collections.slice.Slice;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use x86_set:     masc.isa.x86.set;

use mirl.machine.class.Memory;
use mirl.machine.isa.Isa;
use mirl.machine.isa.Isas;
use mirl.machine.isa.NO_SHORTS;
use aarch64:     mirl.target.register.aarch64.isa;
use written:     mirl.target.register.riscv.isa;
use x86_written: mirl.target.register.x86.isa;

val RECORDS: [3]Isa = [3]Isa{
    Isa{set: ?riscv_set.SET, table: ?written.TABLE, frame: ?written.FRAME, moves: ?written.MOVES, loops: written.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: ?written.STATE, relax: ?written.RELAXING, shorts: NO_SHORTS},
    Isa{set: ?x86_set.SET, table: ?x86_written.TABLE, frame: ?x86_written.FRAME, moves: ?x86_written.MOVES, loops: x86_written.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: nil, relax: nil, shorts: x86_written.SHORTS},
    Isa{set: ?aarch64_set.SET, table: ?aarch64.TABLE, frame: ?aarch64.FRAME, moves: ?aarch64.MOVES, loops: aarch64.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: nil, relax: nil, shorts: NO_SHORTS},
};

# every carried set
pub val ISAS: Isas = Isas{at: ?RECORDS[0], len: 3};
