# the instruction sets mirl carries, one row each
#
# a row joins the architecture family of mink's catalog a set serves to the
# selection table, the frame code and the moves written for it. masc finds
# the set serving a target's architecture once, when the target's machine is
# opened, and the row is the one whose family the set serves, so no consumer
# spells a set, a table or a frame code of its own and a second set is a row
# beside the first.

use std.types.option.opt;
use std.types.size.usize;

use std.collections.slice.Slice;

use masc.core.set.Set;
use arches:     mink.catalog.arch;
use arch_riscv: mink.catalog.arch.riscv;

use mirl.machine.class.Memory;
use mirl.machine.configure.StateRules;
use mirl.machine.copy.move;
use mirl.machine.frame.code.Code;
use mirl.machine.select.rule.Table;
use mirl.target.register.loops;
use riscv: mirl.target.register.riscv.isa;

# one carried instruction set
# ---
# family:   the architecture family of mink's catalog the set serves
# table:    the selection table for it
# frame:    the code of its frame moves
# moves:    its moves between locations
# memories: the memory-backed register classes it supplies, each named, none
#           for a set whose registers are all in its register file
# state:    how it establishes its configuration state, nil for a set with none
pub rec Row {
    family:   *arches.Family;
    table:    *Table;
    frame:    *Code;
    moves:    *move.Table;
    memories: Slice[Memory];
    state:    *StateRules;
}

def Rows: [1]Row;

val ROWS: Rows = [1]Row{
    Row{family: ?arch_riscv.RISCV_FAMILY, table: ?riscv.TABLE, frame: ?riscv.FRAME, moves: ?riscv.MOVES, memories: Slice[Memory]{data: nil, size: 0}, state: ?riscv.STATE},
};

# the row carrying masc's instruction set, none when mirl carries no table for it
# ---
# s:   the set, as the open machine's basis holds it
# ret: the row, one per carried set
pub fun of(s: *Set) opt[*Row] {
    var i: usize = 0;
    for (i < $length_of(Rows)) {
        if (loops.serves(s, ROWS[i].family)) { ret opt[*Row].some{?ROWS[i]}; }
        i = i + 1;
    }
    ret opt[*Row].none{};
}
