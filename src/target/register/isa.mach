# the instruction sets the register family carries, one record each
#
# this is the one registry of mirl.machine.isa records. the family hands it to
# the compilation, which hands it to the selection engine and the machine
# text, so none of them imports a set. a record names masc's set by the record
# masc's registry holds, the one the target's machine selects from, and a
# second set is a record beside the first.

use std.collections.slice.Slice;

use aarch64_set: masc.isa.aarch64.set;
use riscv_set:   masc.isa.riscv.set;
use x86_set:     masc.isa.x86.set;

use mirl.machine.class.Memory;
use mirl.machine.isa.Isa;
use mirl.machine.isa.Isas;
use mirl.machine.isa.NO_SHORTS;
use aarch64_frame: mirl.target.register.aarch64.frame;
use aarch64_loop:  mirl.target.register.aarch64.loop;
use aarch64_move:  mirl.target.register.aarch64.move;
use aarch64_rules: mirl.target.register.aarch64.rules;
use riscv_frame:   mirl.target.register.riscv.frame;
use written:       mirl.target.register.riscv.isa;
use mirl.target.register.riscv.loop;
use mirl.target.register.riscv.move;
use mirl.target.register.riscv.rules;
use mirl.target.register.riscv.vtype;
use x86_frame: mirl.target.register.x86.frame;
use x86_loop:  mirl.target.register.x86.loop;
use x86_move:  mirl.target.register.x86.move;
use x86_rules: mirl.target.register.x86.rules;
use mirl.target.register.x86.short;

val RECORDS: [3]Isa = [3]Isa{
    Isa{set: ?riscv_set.SET, table: ?rules.TABLE, frame: ?riscv_frame.FRAME, moves: ?move.MOVES, loops: loop.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: ?vtype.STATE, relax: ?written.RELAXING, shorts: NO_SHORTS},
    Isa{set: ?x86_set.SET, table: ?x86_rules.TABLE, frame: ?x86_frame.FRAME, moves: ?x86_move.MOVES, loops: x86_loop.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: nil, relax: nil, shorts: short.SHORTS},
    Isa{set: ?aarch64_set.SET, table: ?aarch64_rules.TABLE, frame: ?aarch64_frame.FRAME, moves: ?aarch64_move.MOVES, loops: aarch64_loop.LOOPS, memories: Slice[Memory]{data: nil, size: 0}, state: nil, relax: nil, shorts: NO_SHORTS},
};

# every carried set
pub val ISAS: Isas = Isas{at: ?RECORDS[0], len: 3};
