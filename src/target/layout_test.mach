    Golden{target: ?RV64_LINUX, long: 64, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV64_LINUX, long: 64, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV64_LINUX, long: 64, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: ?RV64_LINUX, long: 64, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # riscv64-freestanding, clang --target=riscv64-unknown-elf
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 3, union: false, count: 3, members: [3]u32{C_SHORT, C_INT128, C_CHAR}, size: 48, align: 16, offsets: [3]u64{0, 16, 32}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 16, align: 8, offsets: [3]u64{0, 4, 8}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: ?RV64_FREESTANDING, long: 64, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # riscv32-linux, clang --target=riscv32-linux-gnu
    Golden{target: ?RV32_LINUX, long: 32, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 12, align: 4, offsets: [3]u64{0, 4, 8}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 12, align: 4, offsets: [3]u64{0, 4, 8}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: ?RV32_LINUX, long: 32, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # riscv32-freestanding, clang --target=riscv32-unknown-elf
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 12, align: 4, offsets: [3]u64{0, 4, 8}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 12, align: 4, offsets: [3]u64{0, 4, 8}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: ?RV32_FREESTANDING, long: 32, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
};

test layout__golden {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var pool: [GOLD + 10]Type;
    if (!int(?t, 8, ?pool[C_CHAR]))                                                    { ret 1; }
    if (!int(?t, 1, ?pool[C_BOOL]))                                                    { ret 1; }
    if (!int(?t, 16, ?pool[C_SHORT]))                                                  { ret 1; }
    if (!int(?t, 32, ?pool[C_INT]))                                                    { ret 1; }
    if (!int(?t, 128, ?pool[C_INT128]))                                                { ret 1; }
    if (!real(?t, BINARY16, ?pool[C_HALF]))                                            { ret 1; }
    if (!real(?t, BINARY32, ?pool[C_FLOAT]))                                           { ret 1; }
    if (!real(?t, BINARY64, ?pool[C_DOUBLE]))                                          { ret 1; }
    if (!must(table.intern(?t, Shape.pointer{table.Pointer{space: 0}}), ?pool[C_PTR])) { ret 1; }
    if (!int(?t, 256, ?pool[C_BIG]))                                                   { ret 1; }
    if (!bytes(?t, 3, pool[C_CHAR], ?pool[C_CHAR3]))                                   { ret 1; }
    if (!bytes(?t, 3, pool[C_INT], ?pool[C_INT3]))                                     { ret 1; }
    if (!bytes(?t, 5, pool[C_CHAR], ?pool[C_CHAR5]))                                   { ret 1; }

    var r: u32 = 0;
    for (r < $length_of(Goldens)) {
        val g: Golden = GOLDEN[r];
        if (g.kind >= 10)                    { ret 2; }
        if (!int(?t, g.long, ?pool[C_LONG])) { ret 1; }
        var ms: [3]Type;
        var i:  u32 = 0;
        for (i < g.count) {
            ms[i] = pool[g.members[i]];
            i     = i + 1;
        }
        val shape: Shape = Shape.structure{Structure{members: list(?ms[0], g.count::usize), offsets: opt[Slice[u64]].none{}}};
        if (g.union) {
            if (!must(table.intern(?t, Shape.union{table.Union{members: list(?ms[0], g.count::usize)}}), ?pool[GOLD + g.kind])) { ret 2; }
        }
        or {
            if (!must(table.intern(?t, shape), ?pool[GOLD + g.kind])) { ret 2; }
        }
        var l: Layout             = of(g.target, ?t);
        val e: res[Extent, Error] = extent(?l, pool[GOLD + g.kind], DEFAULT_SPACE);
        if (sel e.err)                                    { ret 3; }
        if (e.ok.size != g.size || e.ok.align != g.align) { ret 4; }
        i = 0;
        for (i < g.count) {
            val o: res[u64, Error] = offset(?l, pool[GOLD + g.kind], DEFAULT_SPACE, i);
            if (sel o.err)            { ret 5; }
            if (o.ok != g.offsets[i]) { ret 6; }
            i = i + 1;
        }
        r = r + 1;
    }
    ret 0;
}

test layout__refuses_misaligned_offset {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var ms: [2]Type;
    if (!int(?t, 8, ?ms[0]))  { ret 1; }
    if (!int(?t, 32, ?ms[1])) { ret 1; }
    var honoured: [2]u64 = [2]u64{0, 8};
    var refused:  [2]u64 = [2]u64{0, 2};
    var good:     Type;
    var bad:      Type;
    if (!must(table.intern(?t, Shape.structure{Structure{members: list(?ms[0], 2), offsets: opt[Slice[u64]].some{Slice[u64]{data: ?honoured[0], size: 2}}}}), ?good)) { ret 1; }
    if (!must(table.intern(?t, Shape.structure{Structure{members: list(?ms[0], 2), offsets: opt[Slice[u64]].some{Slice[u64]{data: ?refused[0], size: 2}}}}), ?bad))   { ret 1; }

    var target: Target             = RV64_LINUX;
    var l:      Layout             = of(?target, ?t);
    val g:      res[Extent, Error] = extent(?l, good, DEFAULT_SPACE);
    if (sel g.err)                          { ret 2; }
    if (g.ok.size != 12 || g.ok.align != 4) { ret 3; }
    val at: res[u64, Error] = offset(?l, good, DEFAULT_SPACE, 1);
    if (sel at.err) { ret 4; }
    if (at.ok != 8) { ret 4; }

    val b: res[Extent, Error] = extent(?l, bad, DEFAULT_SPACE);
    if (sel b.ok)                { ret 5; }
    if (!(sel b.err.misaligned)) { ret 6; }
    val p: Placement = b.err.misaligned;
    if (p.member != 1 || p.offset != 2 || p.align != 4) { ret 7; }
    val off: res[u64, Error] = offset(?l, bad, DEFAULT_SPACE, 0);
    if (sel off.ok) { ret 8; }
    ret 0;
}

test layout__union_largest_at_strictest {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var c:  Type;
    var ms: [3]Type;
    if (!int(?t, 8, ?c))          { ret 1; }
    if (!bytes(?t, 9, c, ?ms[0])) { ret 1; }
    if (!int(?t, 32, ?ms[1]))     { ret 1; }
    if (!int(?t, 16, ?ms[2]))     { ret 1; }
    var u: Type;
    if (!must(table.intern(?t, Shape.union{table.Union{members: list(?ms[0], 3)}}), ?u)) { ret 1; }

    var target: Target             = RV64_LINUX;
    var l:      Layout             = of(?target, ?t);
    val e:      res[Extent, Error] = extent(?l, u, DEFAULT_SPACE);
    if (sel e.err)                          { ret 2; }
    if (e.ok.size != 12 || e.ok.align != 4) { ret 3; }
    var i: u32 = 0;
    for (i < 3) {
        val o: res[u64, Error] = offset(?l, u, DEFAULT_SPACE, i);
        if (sel o.err) { ret 4; }
        if (o.ok != 0) { ret 4; }
        i = i + 1;
    }
    ret 0;
}

# a space of each rule, for a test target whose scalars are riscv64's
val RULED: [4]Space = [4]Space{
    Space{space: 0, pointer: Pointer.physical{Scalar{size: 8, align: 8}}, layout: Rules.c{}},
    Space{space: 1, pointer: Pointer.logical{}, layout: Rules.std140{}},
    Space{space: 2, pointer: Pointer.logical{}, layout: Rules.std430{}},
    Space{space: 3, pointer: Pointer.logical{}, layout: Rules.scalar{}},
};
val UNIFORM: u32 = 1;
val STORAGE: u32 = 2;
val PACKED:  u32 = 3;

fun ruled_target() Target {
    var t: Target = RV64_LINUX;
    t.caps.widths.pointers = Slice[Space]{data: ?RULED[0], size: 4};
    ret t;
}

fun lanes(t: *table.Table, count: u32, element: Type, out: *Type) bool {
    ret must(table.intern(t, Shape.vector{table.Vector{lanes: count, element: element}}), out);
}

fun strided(t: *table.Table, count: u64, element: Type, step: u64, out: *Type) bool {
    ret must(table.intern(t, Shape.array{table.Array{count: count, element: element, stride: opt[u64].some{step}}}), out);
}

# one type in one space and its layout, worked out by hand from the vulkan
# specification's offset and stride rules
# ---
# space:   the space, of a rule
# kind:    0 for the block, 1 for array<4, f32>, 2 for array<2, vec<2, f32>>
# size:    its size
# align:   its alignment
# offsets: the block's member offsets, or an array's stride first
rec Ruled {
    space:   u32;
    kind:    u32;
    size:    u64;
    align:   u64;
    offsets: [7]u64;
}

# the block is struct { f32 a; vec3 b; f32 c; vec2 d; f32 e[2]; struct { f32 } f; f32 g; }
#
# std140, extended alignment: a at 0, b a three lane vector at 4 * 4 = 16 and
# 12 long, c fits at 28, d at 2 * 4 = 8 so 32, e at 4 rounded up to 16 so 48
# with a stride of 16 and 32 long, f at 4 rounded up to 16 so 80 and 16 long,
# g at 96 and ending at 100. the block aligns to 16 and its size rounds up to 112
# std430, base alignment: as std140 to d, then e at 4 so 40 with a stride of 4
# and 8 long, f at 4 so 48, g at 52 and ending at 56, which rounds up to 64
# scalar, scalar alignment: every member at 4, so a 0, b 4, c 16, d 20, e 28,
# f 36, g 40, ending at 44 with an alignment of 4
def Ruleds: [9]Ruled;
val RULEDS: Ruleds = [9]Ruled{
    Ruled{space: UNIFORM, kind: 0, size: 112, align: 16, offsets: [7]u64{0, 16, 28, 32, 48, 80, 96}},
    Ruled{space: STORAGE, kind: 0, size: 64, align: 16, offsets: [7]u64{0, 16, 28, 32, 40, 48, 52}},
    Ruled{space: PACKED, kind: 0, size: 44, align: 4, offsets: [7]u64{0, 4, 16, 20, 28, 36, 40}},
    # array<4, f32>: a stride of 4 rounded up to 16 under std140
    Ruled{space: UNIFORM, kind: 1, size: 64, align: 16, offsets: [7]u64{16, 0, 0, 0, 0, 0, 0}},
    Ruled{space: STORAGE, kind: 1, size: 16, align: 4, offsets: [7]u64{4, 0, 0, 0, 0, 0, 0}},
    Ruled{space: PACKED, kind: 1, size: 16, align: 4, offsets: [7]u64{4, 0, 0, 0, 0, 0, 0}},
    # array<2, vec<2, f32>>: an element of 8 at 8, rounded up to 16 under std140
    # and kept at its lane's 4 under scalar
    Ruled{space: UNIFORM, kind: 2, size: 32, align: 16, offsets: [7]u64{16, 0, 0, 0, 0, 0, 0}},
    Ruled{space: STORAGE, kind: 2, size: 16, align: 8, offsets: [7]u64{8, 0, 0, 0, 0, 0, 0}},
    Ruled{space: PACKED, kind: 2, size: 16, align: 4, offsets: [7]u64{8, 0, 0, 0, 0, 0, 0}},
};

test layout__rules_of_each_space {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var f:     Type;
    var two:   Type;
    var three: Type;
    var pair:  Type;
    var one:   Type;
    var kinds: [3]Type;
    if (!real(?t, BINARY32, ?f))       { ret 1; }
    if (!lanes(?t, 2, f, ?two))        { ret 1; }
    if (!lanes(?t, 3, f, ?three))      { ret 1; }
    if (!bytes(?t, 2, f, ?pair))       { ret 1; }
    if (!bare(?t, list(?f, 1), ?one))  { ret 1; }
    if (!bytes(?t, 4, f, ?kinds[1]))   { ret 1; }
    if (!bytes(?t, 2, two, ?kinds[2])) { ret 1; }
    var ms: [7]Type = [7]Type{f, three, f, two, pair, one, f};
    if (!bare(?t, list(?ms[0], 7), ?kinds[0])) { ret 1; }

    var target: Target = ruled_target();
    var l:      Layout = of(?target, ?t);
    var r:      usize  = 0;
    for (r < $length_of(Ruleds)) {
        val g: Ruled              = RULEDS[r];
        val e: res[Extent, Error] = extent(?l, kinds[g.kind], g.space);
        if (sel e.err)                                    { ret 2; }
        if (e.ok.size != g.size || e.ok.align != g.align) { ret 3; }
        if (g.kind == 0) {
            var at:   [7]u64;
            val laid: err[Error] = offsets(?l, kinds[0], g.space, ?at[0]);
            if (sel laid.err) { ret 4; }
            var i: usize = 0;
            for (i < 7) {
                if (at[i] != g.offsets[i]) { ret 5; }
                i = i + 1;
            }
        }
        or {
            val step: res[u64, Error] = stride(?l, kinds[g.kind], g.space);
            if (sel step.err)            { ret 6; }
            if (step.ok != g.offsets[0]) { ret 7; }
        }
        r = r + 1;
    }
    ret 0;
}

test layout__stated_stride_and_what_the_rules_refuse {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var f:     Type;
    var eight: Type;
    var short: Type;
    var five:  Type;
    var u:     Type;
    if (!real(?t, BINARY32, ?f))                                                     { ret 1; }
    if (!strided(?t, 4, f, 8, ?eight))                                               { ret 1; }
    if (!strided(?t, 4, f, 2, ?short))                                               { ret 1; }
    if (!lanes(?t, 5, f, ?five))                                                     { ret 1; }
    if (!must(table.intern(?t, Shape.union{table.Union{members: list(?f, 1)}}), ?u)) { ret 1; }

    var target: Target = ruled_target();
    var l:      Layout = of(?target, ?t);

    # a stride of 8 keeps std430's alignment of 4, and the array is 4 * 8 long
    val kept: res[Extent, Error] = extent(?l, eight, STORAGE);
    if (sel kept.err)                             { ret 2; }
    if (kept.ok.size != 32 || kept.ok.align != 4) { ret 3; }
    val step: res[u64, Error] = stride(?l, eight, STORAGE);
    if (sel step.err) { ret 4; }
    if (step.ok != 8) { ret 4; }

    # std140 aligns the array to 16, which 8 is not a multiple of, and a stride
    # of 2 is shorter than the element under c
    val unaligned: res[Extent, Error] = extent(?l, eight, UNIFORM);
    if (!(sel unaligned.err && sel unaligned.err.stride)) { ret 5; }
    val overlapping: res[Extent, Error] = extent(?l, short, DEFAULT_SPACE);
    if (!(sel overlapping.err && sel overlapping.err.stride)) { ret 6; }

    # no rule of vulkan's lays out a union or a vector of five lanes, which c does
    val joined: res[Extent, Error] = extent(?l, u, STORAGE);
    if (!(sel joined.err && sel joined.err.ruled)) { ret 7; }
    val wide: res[Extent, Error] = extent(?l, five, UNIFORM);
    if (!(sel wide.err && sel wide.err.ruled)) { ret 8; }
    val c: res[Extent, Error] = extent(?l, u, DEFAULT_SPACE);
    if (sel c.err) { ret 9; }

    val none: res[Extent, Error] = extent(?l, f, 9);
    if (!(sel none.err && sel none.err.space)) { ret 10; }
    ret 0;
}
