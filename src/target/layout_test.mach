    Golden{target: ?X86_64_LINUX, long: 64, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: ?X86_64_LINUX, long: 64, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
