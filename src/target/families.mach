# the family registry: every target family mirl serves, one row each
#
# a target is served by the one family that admits its declarations. none or
# several is refused as unserved, so no family is a default and no order of
# the rows decides. the pass schedule a target runs is the neutral prefix and
# its family's rows over the build the family opened, made once per build
# in mirl.target.compile's `Prepared`, which a compilation and a run of the
# schedule alone both read.
#
# an opcode row a family lists is that family's own, and only a target the
# family serves admits it. a row no family lists is a core row every target
# admits, and a row two listings name has no one owner and is refused.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.allocator;
use std.collections.map;
use std.collections.slice.Slice;

use mirl.ir.block.BlockData;
use mirl.ir.function.Body;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Row;
use mirl.target.capability.Capabilities;
use mirl.target.family.Family;
use mirl.target.family.Foreign;
use mirl.target.family.Listing;
use mirl.target.family.Unserved;
use mirl.target.record.Target;
use register: mirl.target.register.family;
use spirv:    mirl.target.spirv.family;
use wasm:     mirl.target.wasm.family;

val ROWS: [3]*Family = [3]*Family{?register.FAMILY, ?wasm.FAMILY, ?spirv.FAMILY};

# the registry
pub fun rows() Slice[*Family] {
    ret Slice[*Family]{data: ?ROWS[0], size: 3};
}

# the one family of a registry that admits a target with these declarations
# ---
# registry: the families
# c:        the target's declarations
# ret:      the family, or why no one family serves it
pub fun serving(registry: Slice[*Family], c: *Capabilities) res[*Family, Unserved] {
    var found: *Family = nil;
    var i:     usize   = 0;
    for (i < registry.size) {
        if (registry.data[i].admits(c)) {
            if (found != nil) { ret res[*Family, Unserved].err{Unserved.several{}}; }
            found = registry.data[i];
        }
        i = i + 1;
    }
    if (found == nil) { ret res[*Family, Unserved].err{Unserved.none{}}; }
    ret res[*Family, Unserved].ok{found};
}

# the family of each opcode row a registry's families list, keyed by the row's
# identity
# ---
# by: the owning family of each listed row
pub rec Owners {
    by: map.MapBy[*Row, *Family];
}

fun hash_row(r: **Row) u64 {
    var h: u64 = (@r)::ptr::u64;
    h = (h ^ (h >> 33)) * 0xff51afd7ed558ccd;
    ret h ^ (h >> 33);
}

fun same_row(a: **Row, b: **Row) bool {
    ret @a == @b;
}

# index the opcode rows a registry's families list by their owners
# ---
# a:        the allocator the index takes
# registry: the families
# ret:      the index, released with `release`, or why there is none, after
#           which nothing is held
pub fun owners(a: *allocator.Allocator, registry: Slice[*Family]) res[Owners, Listing] {
    var o: Owners = Owners{by: map.init_by[*Row, *Family](a, hash_row, same_row)};
    var i: usize  = 0;
    for (i < registry.size) {
        val f: *Family = registry.data[i];
        var j: usize   = 0;
        for (j < f.opcodes.size) {
            val r:     *Row                       = f.opcodes.data[j];
            val fresh: res[bool, allocator.Error] = map.insert_by[*Row, *Family](?o.by, r, f);
            if (sel fresh.err) {
                release(?o);
                ret res[Owners, Listing].err{Listing.alloc{fresh.err}};
            }
            if (!fresh.ok) {
                release(?o);
                ret res[Owners, Listing].err{Listing.twice{r}};
            }
            j = j + 1;
        }
        i = i + 1;
    }
    ret res[Owners, Listing].ok{o};
}

# give back what `owners` made
pub fun release(o: *Owners) {
    map.dnit_by[*Row, *Family](?o.by);
}

# the family that owns a row, none for a core row
pub fun owner(o: *Owners, r: *Row) opt[*Family] {
    var key: *Row          = r;
    val got: opt[**Family] = map.get_by[*Row, *Family](?o.by, ?key);
    if (sel got.none) { ret opt[*Family].none{}; }
    ret opt[*Family].some{@got.some};
}

# whether a target admits a row: a core row stands on every target, and a
# family's row only on a target that family serves, told by identity
# ---
# o:       the owners of the registry's rows
# serving: the family that serves the target, none when no one family does
# r:       the row
pub fun admits(o: *Owners, serving: opt[*Family], r: *Row) bool {
    val own: opt[*Family] = owner(o, r);
    if (sel own.none)     { ret true; }
    if (sel serving.none) { ret false; }
    ret own.some == serving.some;
}

# the first instruction of a module whose row a family that does not serve
# the target owns, none when the target admits every one
# ---
# o:       the owners of the registry's rows
# serving: the family that serves the target, none when no one family does
# m:       the module
pub fun foreign(o: *Owners, serving: opt[*Family], m: *Module) opt[Foreign] {
    if (map.length_by[*Row, *Family](o.by) == 0) { ret opt[Foreign].none{}; }
    var f: usize = 0;
    for (f < m.functions.len) {
        val b: *Body = ?m.functions.data[f].body;
        var k: usize = 0;
        for (k < b.blocks.len) {
            val bd: *BlockData = ?b.blocks.data[k];
            if (!bd.erased) {
                var i: usize = 0;
                for (i < bd.instructions.len) {
                    val inst: Instruction = bd.instructions.data[i];
                    val r:    opt[*Row]   = opcode.at(b.instructions.data[inst.index].opcode);
                    if (sel r.some) {
                        if (!admits(o, serving, r.some)) { ret opt[Foreign].some{Foreign{row: r.some, function: Function{index: f::u32}, instruction: inst}}; }
                    }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
        f = f + 1;
    }
    ret opt[Foreign].none{};
}

# the family of mirl's registry that serves a target
pub fun served(t: *Target) res[*Family, Unserved] {
    ret serving(rows(), ?t.caps);
}
