# calling conventions: how a call's arguments and results are passed
#
# a front end never computes how an argument is passed. it asks `classify`
# with a function type, the resolved convention and what the call states, and
# the pipeline asks the same routine, once per call site, and reads the
# assignment it returns from then on. `classify` is the only caller of a
# convention's classifiers.

use mirl.target.abi.call;
use mirl.target.abi.convention;
#[testing]
use mirl.target.abi.lp64d_test;
use mirl.target.abi.piece;
use mirl.target.abi.view;

