# tests of a target's machine: the baseline selection every consumer reads and
# the extensions a build adds on top of it

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.requirement;

use mirl.ir.type.format;
use mirl.ir.type.format.Format;
use target_basis: mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.build.Build;
use mirl.target.capability.Held;
use mirl.target.record.Target;
use mirl.target.register.machine;
use targets: mirl.target.rows;

# whether two selections of one catalog hold the same extensions
fun same(a: *extension.Selection, b: *extension.Selection) bool {
    var i: u32 = 0;
    for (i < a.catalog.count) {
        if (extension.has(a, i) != extension.has(b, i)) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a target states a baseline that leaves the condition of its
# multiply unmet, so only an extension a build adds meets it
#[testing]
pub fun multiplies_when_added(t: *Target) bool {
    if (!(sel t.baseline.extensions))                  { ret false; }
    if (!(sel t.caps.arithmetic.multiplied.extension)) { ret false; }
    var a: allocator.Allocator;
    page.make(?a);
    var b:      Basis;
    val chosen: err[target_basis.Error] = target_basis.choose(?b, ?a, t, Slice[str]{data: nil, size: 0});
    if (sel chosen.err) { ret false; }
    val met: res[bool, target_basis.Error] = target_basis.meets(opt[*Basis].some{?b}, t.caps.arithmetic.multiplied);
    target_basis.drop(?b);
    if (sel met.err) { ret false; }
    ret !met.ok;
}

# a target that states a baseline under which it holds no float format, so a
# build that adds no extension computes every float in software
#[testing]
pub fun holds_no_float(t: *Target) bool {
    if (!(sel t.baseline.extensions)) { ret false; }
    var a: allocator.Allocator;
    page.make(?a);
    var b:      Basis;
    val chosen: err[target_basis.Error] = target_basis.choose(?b, ?a, t, Slice[str]{data: nil, size: 0});
    if (sel chosen.err) { ret false; }
    fin { target_basis.drop(?b); }
    var i: u32 = 0;
    for (i < format.rows()) {
        val h: res[opt[*Held], target_basis.Error] = target_basis.held(opt[*Basis].some{?b}, ?t.caps, Format{index: i});
        if (sel h.err)     { ret false; }
        if (sel h.ok.some) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the target's baseline resolves into the machine's one selection, and an
# extension the baseline lacks is held after it is added on top
test machine__a_baseline_resolves_and_the_extensions_added_to_it_are_selected {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(machine.stated);
    if (sel row.none) { ret 1; }
    var m:      Build;
    val opened: err[target_basis.Error] = machine.open(?m, ?a, row.some, Slice[str]{data: nil, size: 0});
    if (sel opened.err) { ret 2; }
    fin { machine.close(?m); }
    if (!(sel row.some.baseline.extensions)) { ret 7; }
    val catalog: *extension.Catalog                        = m.basis.set.extensions;
    val made:    res[extension.Selection, extension.Error] = extension.select(?a, catalog, row.some.baseline.extensions, diagnostic.START);
    if (sel made.err) { ret 3; }
    var expected: extension.Selection = made.ok;
    fin { extension.release(?expected); }
    if (!same(?m.basis.selection, ?expected)) { ret 4; }

    # the first extension the baseline lacks that it can take on
    var grown: bool = false;
    var i:     u32  = 0;
    for (i < catalog.count && !grown) {
        if (!extension.has(?m.basis.selection, i)) {
            var one:   [1]str                  = [1]str{catalog.extensions[i].name};
            var basis: Basis;
            val added: err[target_basis.Error] = target_basis.choose(?basis, ?a, row.some, Slice[str]{data: ?one[0], size: 1});
            if (sel added.ok) {
                if (!extension.has(?basis.selection, i)) { ret 5; }
                grown = true;
                target_basis.drop(?basis);
            }
        }
        i = i + 1;
    }
    if (!grown) { ret 6; }
    ret 0;
}

# an extension the instruction set does not know is refused by name
test machine__an_unknown_extension_is_refused_by_its_name {
    var a: allocator.Allocator;
    page.make(?a);
    val row: opt[*Target] = targets.first(machine.stated);
    if (sel row.none) { ret 1; }
    var one: [1]str                  = [1]str{"no_such_extension"};
    var m:   Build;
    val got: err[target_basis.Error] = machine.open(?m, ?a, row.some, Slice[str]{data: ?one[0], size: 1});
    if (sel got.ok) {
        machine.close(?m);
        ret 2;
    }
    val why: target_basis.Error = got.err;
    if (!(sel why.unknown))                            { ret 3; }
    if (!str_equals(why.unknown, "no_such_extension")) { ret 4; }
    ret 0;
}

# a target whose convention passes no float in a float register
fun soft(t: *Target) bool {
    if (!(sel t.baseline.extensions)) { ret false; }
    if (!(sel t.convention.row))      { ret false; }
    ret sel t.convention.row.floats.none;
}

# every soft float target opens a machine whose floor selects neither F nor D,
# so its convention resolves with no float register
test machine__a_soft_float_target_opens_with_no_float_extension {
    var a: allocator.Allocator;
    page.make(?a);
    var floats: [2]str = [2]str{"f", "d"};
    var seen:   bool   = false;
    var i:      usize  = 0;
    for (i < targets.rows()) {
        val row: opt[*Target] = targets.row(i);
        if (sel row.none) { ret 1; }
        if (soft(row.some)) {
            seen = true;
            var m:      Build;
            val opened: err[target_basis.Error] = machine.open(?m, ?a, row.some, Slice[str]{data: nil, size: 0});
            if (sel opened.err) { ret 2; }
            var k: usize = 0;
            for (k < 2) {
                val id: opt[requirement.Id] = extension.lookup(m.basis.set.extensions, floats[k], 0, str_len(floats[k]));
                if (sel id.none) {
                    machine.close(?m);
                    ret 3;
                }
                if (extension.has(?m.basis.selection, id.some)) {
                    machine.close(?m);
                    ret 4;
                }
                k = k + 1;
            }
            machine.close(?m);
        }
        i = i + 1;
    }
    if (!seen) { ret 5; }
    ret 0;
}
