# how a module is compiled for a target, the one record every layer of a
# compilation reads: the pass schedule, the family's back end and the
# register machine's steps

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;

use io: std.io.writer;

use mirl.base.stats.Stats;
use mirl.pass.relaxation.Relaxations;
use mirl.pass.schedule.Level;

# what a back end writes
# ---
# object: a relocatable object, which a link takes with others
# image:  a final image the target loads as it is, as a whole wasm module
pub tag Output: u8 {
    object;
    image;
}

# how a module is compiled
# ---
# output:  what the back end writes, a relocatable object or a final image
# level:   the optimisation level
# checked: turn on every opt-in check together, off by default: verify the
#          module before the first pass and after every pass, every function
#          after every stage, prove every allocation and check every
#          machine instruction against its row as it is appended. a module read from
#          text is verified by its reader's caller whatever this says
# machine: where the machine form text of the laid out functions is written, none for none
# listing: where masc's listing of the object is written, none for none
# relax:   whether the linker may relax the code, which a back end hands to
#          its set's relax mode, RELAX unless the build says otherwise
# floats:  the float relaxations the build permits, read through
#          mirl.pass.relaxation, none for exact semantics
# apart:   which symbols a back end places each in a section of its own, for
#          the linker's garbage collection, none unless the build asks. a
#          symbol that states a section keeps it
# stats:   where the compilation adds the time of each stage and its counts,
#          read through mirl.base.stats, none to time and count nothing
pub rec Options {
    output:  Output;
    level:   Level;
    checked: bool;
    machine: opt[*io.Writer];
    listing: opt[*io.Writer];
    relax:   bool;
    floats:  Relaxations;
    apart:   Apart;
    stats:   opt[*Stats];
}

# which symbols a build asks to place each in a section of its own, so the
# linker can collect each apart. a symbol that states a section keeps it
# ---
# code: each function a unit emits, with its jump tables
# data: each global the module defines
pub rec Apart {
    code: bool;
    data: bool;
}

# no symbol apart: every kind keeps one section per object
pub val SHARED: Apart = Apart{code: false, data: false};

# whether a build lets the linker relax its code when it does not say
# owner ruling 2026-10-23 (#286): risc-v linker relaxation is on by default
pub val RELAX: bool = true;
