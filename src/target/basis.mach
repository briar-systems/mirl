# the basis a build stands on: masc's instruction set for a target's
# architecture and the extensions selected from it once, the baseline and
# the ones a build adds, under a context that admits the baseline

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.core.extension;
use rf: masc.core.register;
use masc.core.requirement;
use mset:       masc.core.set;
use core_state: masc.core.state;
use mink_fail:  mink.base.fail;

use fmt: mirl.ir.type.format;
use mirl.ir.type.format.Format;
use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Unresolved;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Condition;
use mirl.target.capability.Held;
use mirl.target.capability.Lowered;
use mirl.target.capability.Nans;
use mirl.target.capability.Propagation;
use mirl.target.record;
use mirl.target.record.Target;

# the instruction set, selection and context a build stands on, made in
# place, as the context points at the selection and the view
# ---
# target:    the target it was selected for
# set:       masc's instruction set for the architecture
# arch:      the set's row of the target's architecture
# selection: the baseline's atoms and the extensions added, closed over their implications
# view:      the set's registers the context admits
# context:   the selection under the architecture's state, which every reader of the set takes
pub rec Basis {
    target:    *Target;
    set:       *mset.Set;
    arch:      *mset.Arch;
    selection: extension.Selection;
    view:      rf.Available;
    context:   core_state.Context;
}

# why a target's build was not opened
# ---
# alloc:      the allocator refused storage
# set:        masc serves the architecture with no instruction set
# baseline:   the target states no baseline
# extensions: masc refused the baseline's request or the closed selection
# admitted:   the context the selection opens does not admit the baseline,
#             as an added extension the baseline rules out
# unknown:    a requested extension the instruction set does not know, by name
# named:      an extension a function names past the build's that the
#             instruction set does not know, by name
# state:      the selection states the set's state axes wrongly
# registers:  the registers of the context were not viewed
# formats:    mink's format registry was not built
# convention: the target's convention was not found
# unresolved: the convention did not resolve through the context
# unstated:   a condition read against the selection is unstated, or names
#             an atom past the set's catalog and state values
pub tag Error: u8 {
    alloc: allocator.Error;
    set;
    baseline;
    extensions: extension.Error;
    admitted;
    unknown:    str;
    named:      View;
    state:      core_state.Error;
    registers:  rf.Error;
    formats:    mink_fail.Fail;
    convention: call.Error;
    unresolved: Unresolved;
    unstated;
}

# the fact a build was not opened on, for diagnostics
pub fun fact(e: Error) str {
    if (sel e.alloc)      { ret "the allocator refused storage"; }
    if (sel e.set)        { ret "masc serves the architecture with no instruction set"; }
    if (sel e.baseline)   { ret "the target states no baseline"; }
    if (sel e.extensions) { ret "masc refused the selection, the baseline's or a widening of it"; }
    if (sel e.admitted)   { ret "the context the selection opens does not admit the baseline"; }
    if (sel e.unknown)    { ret "the instruction set knows no extension of the name"; }
    if (sel e.named)      { ret "the instruction set knows no extension of a name the function admits"; }
    if (sel e.state)      { ret "the selection states the set's state axes wrongly"; }
    if (sel e.registers)  { ret "masc did not view the registers of the context"; }
    if (sel e.formats)    { ret "mink's format registry was not built"; }
    if (sel e.convention) { ret "the target's convention was not found"; }
    if (sel e.unresolved) { ret convention.unresolved(e.unresolved); }
    ret "a condition read against the selection is unstated";
}

# no selection, as a run reads where no family opened a build
pub val NONE: opt[*Basis] = opt[*Basis].none{};

# masc's instruction set for a target's architecture, whose catalog names the
# extensions a selection for it holds
# ---
# t:   the target
# ret: the set, or why there is none: masc serves the architecture with no
#      instruction set
pub fun set_of(t: *Target) res[*mset.Set, Error] {
    val found: opt[*mset.Set] = record.set_of(t);
    if (sel found.none) { ret res[*mset.Set, Error].err{Error.set{}}; }
    ret res[*mset.Set, Error].ok{found.some};
}

# the name the instruction set of a target's architecture gives the extension
# of handle `id`, as a build's added names spell it
# ---
# ret: the name, or why there is none: the target's set was not found, or
#      `id` is past its catalog
pub fun extension_name(t: *Target, id: requirement.Id) res[str, Error] {
    val found: res[*mset.Set, Error] = set_of(t);
    if (sel found.err) { ret res[str, Error].err{found.err}; }
    val catalog: *extension.Catalog = found.ok.extensions;
    if (id >= catalog.count) { ret res[str, Error].err{Error.unstated{}}; }
    ret res[str, Error].ok{catalog.extensions[id].name};
}

# select a target's baseline and the extensions a build adds on top of it,
# and open the context the selection stands under, which must admit the
# baseline
# ---
# b:     where it is made, released by `drop`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to drop
pub fun choose(b: *Basis, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    if (!(sel t.isa.required)) { ret err[Error].err{Error.baseline{}}; }
    val found: res[*mset.Set, Error] = set_of(t);
    if (sel found.err) { ret err[Error].err{found.err}; }
    val row: opt[*mset.Arch] = mset.arch_of(found.ok, t.arch);
    if (sel row.none) { ret err[Error].err{Error.set{}}; }
    val catalog: *extension.Catalog                   = found.ok.extensions;
    val made:    res[extension.Request, record.Error] = record.request(a, t, catalog);
    if (sel made.err) {
        if (sel made.err.selection) { ret err[Error].err{Error.extensions{made.err.selection}}; }
        ret err[Error].err{Error.baseline{}};
    }
    var r: extension.Request = made.ok;
    var i: usize             = 0;
    for (i < added.size) {
        val id: opt[requirement.Id] = extension.lookup(catalog, added.data[i], 0, str_len(added.data[i]));
        if (sel id.none) {
            extension.request_release(?r);
            ret err[Error].err{Error.unknown{added.data[i]}};
        }
        extension.request_add(?r, id.some);
        i = i + 1;
    }
    val chosen: res[extension.Selection, extension.Error] = extension.close(r);
    if (sel chosen.err) { ret err[Error].err{Error.extensions{chosen.err}}; }
    b.target    = t;
    b.set       = found.ok;
    b.arch      = row.some;
    b.selection = chosen.ok;
    val opened: res[core_state.Context, core_state.Opened] = mset.open(a, found.ok, row.some, ?b.selection, ?b.view);
    if (sel opened.err) {
        extension.release(?b.selection);
        if (sel opened.err.state) { ret err[Error].err{Error.state{opened.err.state}}; }
        ret err[Error].err{Error.registers{opened.err.view}};
    }
    b.context = opened.ok;
    if (!core_state.admits(?b.context, t.isa.required)) {
        drop(b);
        ret err[Error].err{Error.admitted{}};
    }
    ret err[Error].ok{};
}

# give back a basis's storage
pub fun drop(b: *Basis) {
    rf.release(?b.view);
    extension.release(?b.selection);
}

# a build's selection widened by the extensions one function names past it,
# and the context the widened selection opens, made in place, as the context
# points at the selection and the view. it only adds to the build's
# selection, so its context views the build's register file under the same
# axes
# ---
# selection: the build's selection with the named extensions added, closed
#            over their implications
# view:      the set's registers the context admits
# context:   the widened selection under the architecture's state
pub rec Widened {
    selection: extension.Selection;
    view:      rf.Available;
    context:   core_state.Context;
}

# widen a build's selection by the extensions a function names, and open the
# context the widened selection stands under
# ---
# w:     where it is made, released by `narrow`
# a:     the allocator its storage comes from
# b:     the build's basis
# names: the extension names, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to narrow: a name the
#        set does not know, a conflict the closure holds, or the context not
#        opened
pub fun widen(w: *Widened, a: *allocator.Allocator, b: *Basis, names: Slice[View]) err[Error] {
    ret widen_over(w, a, b.set, b.arch, ?b.selection, names);
}

# widen the selection a build's context stands under by the extensions a
# function names, as `widen` does the basis that opened the context, for a
# reader that holds the context and the target but not the basis
# ---
# w:     where it is made, released by `narrow`
# a:     the allocator its storage comes from
# t:     the target the build was opened for
# ctx:   the context the build's basis opened
# names: the extension names, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to narrow: the target's
#        set or its architecture's row was not found, or as `widen`
pub fun widen_context(w: *Widened, a: *allocator.Allocator, t: *Target, ctx: *core_state.Context, names: Slice[View]) err[Error] {
    val found: res[*mset.Set, Error] = set_of(t);
    if (sel found.err) { ret err[Error].err{found.err}; }
    val row: opt[*mset.Arch] = mset.arch_of(found.ok, t.arch);
    if (sel row.none) { ret err[Error].err{Error.set{}}; }
    ret widen_over(w, a, found.ok, row.some, ctx.selection, names);
}

# widen a selection of an instruction set by the extensions a function
# names, and open the context under the set's architecture
fun widen_over(w: *Widened, a: *allocator.Allocator, set: *mset.Set, arch: *mset.Arch, selection: *extension.Selection, names: Slice[View]) err[Error] {
    val catalog: *extension.Catalog            = set.extensions;
    var ids:     vector.Vector[requirement.Id] = vector.init[requirement.Id](a);
    fin { vector.dnit[requirement.Id](?ids); }
    var i: usize = 0;
    for (i < names.size) {
        val id: opt[requirement.Id] = extension.lookup(catalog, names.data[i].data, 0, names.data[i].len);
        if (sel id.none) { ret err[Error].err{Error.named{names.data[i]}}; }
        val pushed: res[usize, allocator.Error] = vector.push[requirement.Id](?ids, id.some);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    val chosen: res[extension.Selection, extension.Error] = extension.added(a, selection, requirement.Ids{at: ids.data, len: ids.len::u32});
    if (sel chosen.err) { ret err[Error].err{Error.extensions{chosen.err}}; }
    w.selection = chosen.ok;
    val opened: res[core_state.Context, core_state.Opened] = mset.open(a, set, arch, ?w.selection, ?w.view);
    if (sel opened.err) {
        extension.release(?w.selection);
        if (sel opened.err.state) { ret err[Error].err{Error.state{opened.err.state}}; }
        ret err[Error].err{Error.registers{opened.err.view}};
    }
    w.context = opened.ok;
    ret err[Error].ok{};
}

# give back a widened selection's storage
pub fun narrow(w: *Widened) {
    rf.release(?w.view);
    extension.release(?w.selection);
}

# whether a capability's condition holds for a build: always, or when the
# context the build's basis opened admits its requirement, read by `admits`.
# with no basis there is no context, so only an unconditional one holds
# ---
# b:   the build's basis, none when the build has none
# c:   the condition
# ret: whether it holds, or why it could not be read: it is unstated, or it
#      names an atom past the basis's catalog and state values
pub fun meets(b: opt[*Basis], c: Condition) res[bool, Error] {
    ret admits(context_of(b), c);
}

# the context a build's basis opened, none when the build has none
pub fun context_of(b: opt[*Basis]) opt[*core_state.Context] {
    if (sel b.none) { ret opt[*core_state.Context].none{}; }
    ret opt[*core_state.Context].some{?b.some.context};
}

# whether a capability's condition holds under a context a build's selection
# opened, through masc's `state.admits`, as `meets` reads it of the basis that
# holds the context
# ---
# ctx: the context, none when the build has none, where only an
#      unconditional condition holds
# c:   the condition
# ret: whether it holds, or why it could not be read: it is unstated, or it
#      names an atom past the context's catalog and state values
pub fun admits(ctx: opt[*core_state.Context], c: Condition) res[bool, Error] {
    val met: res[bool, capability.Unread] = capability.admits(ctx, c);
    if (sel met.err) { ret res[bool, Error].err{Error.unstated{}}; }
    ret res[bool, Error].ok{met.ok};
}

# whether a build carries a variable pointer: one merged where paths join,
# selected, a call's result or held in memory. physical addressing carries
# one always, and logical addressing where the build meets its `variable`
# condition, as SPIR-V's VariablePointers
# ---
# b:   the build's basis, none when the build has none
# c:   the target's declarations
# ret: whether it carries one, or why the condition could not be read
pub fun variable(b: opt[*Basis], c: *Capabilities) res[bool, Error] {
    if (sel c.addressing.logical) { ret meets(b, c.addressing.logical.variable); }
    ret res[bool, Error].ok{sel c.addressing.physical};
}

# the row of a format a build computes in natively: the target's row of it
# whose condition the build meets. the rows of one format hold under disjoint
# conditions, so a build meets at most one
# ---
# b:   the build's basis, none when the build has none
# c:   the target's declarations
# f:   the format
# ret: the row, none when the target states none or the build meets the
#      condition of none, or why a condition could not be read
pub fun held(b: opt[*Basis], c: *Capabilities, f: Format) res[opt[*Held], Error] {
    if (!(sel c.formats.held)) { ret res[opt[*Held], Error].ok{opt[*Held].none{}}; }
    val list: Slice[Held] = c.formats.held;
    var i:    usize       = 0;
    for (i < list.size) {
        if (list.data[i].format != nil && list.data[i].format.index == f.index) {
            val met: res[bool, Error] = meets(b, list.data[i].condition);
            if (sel met.err) { ret res[opt[*Held], Error].err{met.err}; }
            if (met.ok)      { ret res[opt[*Held], Error].ok{opt[*Held].some{?list.data[i]}}; }
        }
        i = i + 1;
    }
    ret res[opt[*Held], Error].ok{opt[*Held].none{}};
}

# the nan a build's float operations in a format return: the rule of the row
# it holds the format under, or where it holds none and the target lowers the
# format, the rule its lowering gives. an operation widened through a held
# format gives that format's rule carried through the row's narrowing, and one
# no held format admits gives the rule of the row's helpers. the basic
# operations and the fused multiply-add may compute differently, so the rule
# is theirs where the two agree, the fused one's order of operands read from
# the fused one, and unspecified where they do not. unstated where the target
# does not compute the format at all
# ---
# b:   the build's basis, none when the build has none
# c:   the target's declarations
# f:   the format
# ret: the rule, or why a row's condition could not be read
pub fun nans(b: opt[*Basis], c: *Capabilities, f: Format) res[Nans, Error] {
    val h: res[opt[*Held], Error] = held(b, c, f);
    if (sel h.err)     { ret res[Nans, Error].err{h.err}; }
    if (sel h.ok.some) { ret res[Nans, Error].ok{h.ok.some.nans}; }
    val l: opt[*Lowered] = capability.lowered(c, f);
    if (sel l.none) { ret res[Nans, Error].ok{Nans.unstated{}}; }
    val basic: res[Nans, Error] = lowered_rule(b, c, f, l.some, false);
    if (sel basic.err) { ret basic; }
    val fused: res[Nans, Error] = lowered_rule(b, c, f, l.some, true);
    if (sel fused.err) { ret fused; }
    ret res[Nans, Error].ok{joined(basic.ok, fused.ok)};
}

# the rule one kind of operation of a lowered format gives: the rule of the
# held format it widens through, carried through the narrowing, or the
# helpers' where none admits it. unstated where the helpers compute none
fun lowered_rule(b: opt[*Basis], c: *Capabilities, f: Format, l: *Lowered, fused: bool) res[Nans, Error] {
    val wide: res[opt[Format], Error] = through(b, c, f, fused);
    if (sel wide.err) { ret res[Nans, Error].err{wide.err}; }
    if (sel wide.ok.some) {
        val h: res[opt[*Held], Error] = held(b, c, wide.ok.some);
        if (sel h.err)     { ret res[Nans, Error].err{h.err}; }
        if (sel h.ok.none) { ret res[Nans, Error].ok{Nans.unstated{}}; }
        ret res[Nans, Error].ok{capability.carried(h.ok.some.nans, l.widened)};
    }
    if (sel l.helpers.rule) { ret res[Nans, Error].ok{l.helpers.rule}; }
    ret res[Nans, Error].ok{Nans.unstated{}};
}

# the rule of a format whose basic operations give one rule and whose fused
# multiply-add gives another: the one rule where they agree, the fused one
# fixing the order of a fused multiply-add's operands, unstated where either
# is, and unspecified where they part
fun joined(basic: Nans, fused: Nans) Nans {
    if (sel basic.unstated || sel fused.unstated)       { ret Nans.unstated{}; }
    if (sel basic.canonical && sel fused.canonical)     { ret basic; }
    if (sel basic.unspecified && sel fused.unspecified) { ret basic; }
    if (sel basic.propagate) {
        if (sel fused.propagate) {
            val p: Propagation = basic.propagate;
            val q: Propagation = fused.propagate;
            if (capability.same_default(p.default, q.default) && capability.same_priority(p.priority, q.priority)) {
                ret Nans.propagate{Propagation{default: p.default, priority: p.priority, fused: q.fused}};
            }
        }
    }
    ret Nans.unspecified{};
}

# the format a build computes a lowered format's operations in: the narrowest
# format it holds whose precision is at least twice the narrow one's plus two,
# four times for a fused multiply-add, and whose exponent range holds every
# narrow value, and for a fused multiply-add the exact product, as a normal
# number. the one rounding of the narrowing then gives the correctly rounded
# narrow result, see `mirl.legal.half`
# ---
# b:     the build's basis, none when the build has none
# c:     the target's declarations
# f:     the narrow format
# fused: whether the operation is a fused multiply-add
# ret:   the format, none where the format is no binary encoding rounding to
#        nearest even or no held format admits it, or why a row's condition
#        could not be read
pub fun through(b: opt[*Basis], c: *Capabilities, f: Format, fused: bool) res[opt[Format], Error] {
    val none: opt[Format]     = opt[Format].none{};
    val n:    opt[fmt.Binary] = binary(f);
    if (sel n.none) { ret res[opt[Format], Error].ok{none}; }
    var times: u32 = 2;
    if (fused) { times = 4; }
    var best:  opt[Format] = none;
    var width: u32         = 0;
    var i:     u32         = 0;
    for (i < fmt.rows()) {
        val w: Format                 = Format{index: i};
        val h: res[opt[*Held], Error] = held(b, c, w);
        if (sel h.err) { ret res[opt[Format], Error].err{h.err}; }
        val e: opt[fmt.Binary] = binary(w);
        if (sel h.ok.some) {
            if (sel e.some) {
                if (computes(n.some, e.some, times, fused)) {
                    val r: opt[fmt.Row] = fmt.row(w);
                    if (sel r.some) {
                        if (width == 0 || r.some.width < width) {
                            best  = opt[Format].some{w};
                            width = r.some.width;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    ret res[opt[Format], Error].ok{best};
}

# the binary encoding of a format that rounds to nearest even, none otherwise
pub fun binary(f: Format) opt[fmt.Binary] {
    val r: opt[fmt.Row] = fmt.row(f);
    if (sel r.none) { ret opt[fmt.Binary].none{}; }
    val row: fmt.Row      = r.some;
    val e:   fmt.Encoding = row.encoding;
    if (!(sel row.rounding.nearest_even)) { ret opt[fmt.Binary].none{}; }
    if (sel e.binary)                     { ret opt[fmt.Binary].some{e.binary}; }
    ret opt[fmt.Binary].none{};
}

# the precision of a binary format, its significand bits and the implicit one
pub fun precision(b: fmt.Binary) u32 {
    if (b.implicit) { ret b.significand + 1; }
    ret b.significand;
}

# the largest exponent of a finite value
pub fun emax(b: fmt.Binary) i64 {
    ret ((1::i64 << b.exponent::i64) - 2) - b.bias::i64;
}

# the exponent of the least normal value
pub fun emin(b: fmt.Binary) i64 {
    ret 1 - b.bias::i64;
}

# whether a wide format computes an operation of a narrow one by the rule:
# its precision at least `times` the narrow one's plus two, and its exponent
# range holding every narrow value, and for a fused multiply-add the exact
# product, as a normal number
fun computes(n: fmt.Binary, w: fmt.Binary, times: u32, fused: bool) bool {
    if (precision(w) < times * precision(n) + 2) { ret false; }
    var top:    i64 = emax(n) + 1;
    var bottom: i64 = emin(n) - (precision(n)::i64 - 1);
    if (fused) {
        top    = 2 * top;
        bottom = 2 * bottom;
    }
    ret emax(w) >= top && emin(w) <= bottom;
}
