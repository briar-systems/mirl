# the type view: an ir type as a calling convention reads it
#
# a convention derives its own aggregate facts, such as eightbyte classes,
# homogeneous aggregates or flattened leaves, by walking a view. every size,
# alignment and offset in a view was asked of the target's data layout when
# the view was described, so no convention computes one. an array keeps one
# child for its element however long it is.

use std.types.bool.bool;
use std.types.size.usize;

use std.collections.vector.Vector;

use mirl.ir.type.format.Format;
use mirl.ir.type.table.Type;
use mirl.target.capability.Extent;

# a float and the width its number format row states
# ---
# format: the row of the number format table
# width:  the row's width in bits
pub rec Real {
    format: Format;
    width:  u32;
}

# what a node is
# ---
# integer:   a signless integer of this many bits
# pointer:   a pointer into this address space
# float:     a float in a number format
# vector:    this many lanes, its one child being the lane
# array:     this many elements, its one child being the element
# structure: its children are the members, at their offsets
# union:     its children are the members, each at offset 0
# handle:    an opaque value the target declares
pub tag Shape: u8 {
    integer: u32;
    pointer: u32;
    float:   Real;
    vector:  u32;
    array:   u64;
    structure;
    union;
    handle;
}

# how much memory a node takes
# ---
# unsized: none, as a handle or a pointer into a logical space has
# laid:    its size and alignment
pub tag Room: u8 {
    unsized;
    laid: Extent;
}

# one node of a view
# ---
# ty:     the ir type it describes
# shape:  what it is
# room:   how much memory it takes
# offset: its byte offset in its parent, 0 for a root, an element, a lane or
#         a union member
# first:  the index of its first child, a node's children stored together
# count:  how many children it has
pub rec Node {
    ty:     Type;
    shape:  Shape;
    room:   Room;
    offset: u64;
    first:  u32;
    count:  u32;
}

# the nodes of every value of one call
pub rec View {
    nodes: Vector[Node];
}

# the node at an index
pub fun node(v: *View, at: u32) *Node {
    ret ?v.nodes.data[at::usize];
}

# the index of child `k` of the node at `at`, which has more than k children
pub fun child(v: *View, at: u32, k: u32) u32 {
    ret v.nodes.data[at::usize].first + k;
}

# whether a node is an aggregate: a structure, an array or a union
pub fun aggregate(n: *Node) bool {
    ret sel n.shape.structure || sel n.shape.array || sel n.shape.union;
}
