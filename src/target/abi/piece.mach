# the pieces a classifier returns, and the assignment of one call site
#
# a call site is classified once. its assignment states, for each argument
# and result, whether it travels by value or by reference and the pieces it
# travels in, and everything after classification reads those pieces.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;
use std.collections.vector.Vector;

use rf: masc.core.register;

# where a piece travels
# ---
# register: in a register, by masc's identity, which holds its class
# stack:    at this byte offset in the outgoing argument area, from the
#           stack pointer at the call
# operand:  as this operand of the target's own call form, where there are no
#           registers or memory stack to place it in, as spir-v's
#           OpFunctionCall and wasm's call take their arguments
pub tag Place: u8 {
    register: rf.Id;
    stack:    u64;
    operand:  u32;
}

# how a place is filled past the piece it holds
# ---
# exact:     the piece fills it
# undefined: the bits past the piece hold anything
# sign:      sign extended from this many bits
# zero:      zero extended from this many bits
# boxed:     all ones above, as a narrower float is nan boxed
# declared:  extended from this many bits as the value's signedness gives,
#            which the call states and the ir does not carry
pub tag Fill: u8 {
    exact;
    undefined;
    sign: u32;
    zero: u32;
    boxed;
    declared: u32;
}

# how a piece's offset and size scale
# ---
# fixed:  they are bytes
# scaled: they are bytes per unit of the multiplier of this scale of the
#         convention's register file, as an sve register's size follows the
#         vector length
pub tag Scale: u8 {
    fixed;
    scaled: u8;
}

# one piece of a value
# ---
# place:  where it travels
# offset: where in the value's memory image it starts
# size:   how many bytes of the value it carries
# scale:  how offset and size scale
# fill:   how its place is filled past it
pub rec Piece {
    place:  Place;
    offset: u64;
    size:   u64;
    scale:  Scale;
    fill:   Fill;
}

# the copy a caller makes of a value it passes by reference, and owns
# ---
# size:  its bytes
# align: the alignment it is made at
pub rec Copy {
    size:  u64;
    align: u64;
}

# how a value travels
# ---
# value:     its pieces carry its own bytes, none for a value of no bytes
# reference: its pieces carry the address of a copy the caller makes and owns
pub tag Passing: u8 {
    value;
    reference: Copy;
}

# how one argument or result travels
# ---
# passing: by value or by reference
# first:   its first piece in the assignment
# count:   how many pieces it has
pub rec Passed {
    passing: Passing;
    first:   u32;
    count:   u32;
}

# the classification of one call site
# ---
# arguments: one per argument, in order
# results:   one per result, in order. a result by reference has no pieces:
#            the caller passes its copy's address, which travels as `address`
# address:   the piece the address of a result by reference travels in, none
#            when no result travels by reference
# pieces:    every piece, each value's stored together
# stack:     the bytes of the outgoing argument area the arguments take
pub rec Assignment {
    arguments: Vector[Passed];
    results:   Vector[Passed];
    address:   opt[Piece];
    pieces:    Vector[Piece];
    stack:     u64;
}

# why a convention refused to classify a call
# ---
# alloc:    the allocator refused storage for the pieces
# results:  the call has more results than the convention returns
# unsized:  a value with no memory form that the convention cannot pass, by
#           its node in the call's view
# room:     a value that may not go on the stack finds too few registers,
#           as a result the row gives too few result registers for, by its
#           node in the call's view
# variadic: the convention has no unnamed arguments
pub tag Refusal: u8 {
    alloc:   allocator.Error;
    results: u32;
    unsized: u32;
    room:    u32;
    variadic;
}

# an empty assignment
pub fun init(a: *allocator.Allocator) Assignment {
    ret Assignment{
        arguments: vector.init[Passed](a),
        results:   vector.init[Passed](a),
        address:   opt[Piece].none{},
        pieces:    vector.init[Piece](a),
        stack:     0,
    };
}

# give back an assignment's storage
pub fun dnit(asg: *Assignment) err[allocator.Error] {
    val a: err[allocator.Error] = vector.dnit[Passed](?asg.arguments);
    val r: err[allocator.Error] = vector.dnit[Passed](?asg.results);
    val p: err[allocator.Error] = vector.dnit[Piece](?asg.pieces);
    if (sel a.err) { ret a; }
    if (sel r.err) { ret r; }
    ret p;
}

# begin a value's pieces
pub fun open(asg: *Assignment) u32 {
    ret asg.pieces.len::u32;
}

# add a piece to the value begun last
pub fun add(asg: *Assignment, p: Piece) err[Refusal] {
    val pushed: res[usize, allocator.Error] = vector.push[Piece](?asg.pieces, p);
    if (sel pushed.err) { ret err[Refusal].err{Refusal.alloc{pushed.err}}; }
    ret err[Refusal].ok{};
}

# close a value begun at `first` as an argument or, when `result`, a result
pub fun close(asg: *Assignment, result: bool, passing: Passing, first: u32) err[Refusal] {
    val passed: Passed = Passed{passing: passing, first: first, count: asg.pieces.len::u32 - first};
    var pushed: res[usize, allocator.Error];
    if (result)         { pushed = vector.push[Passed](?asg.results, passed); }
    or                  { pushed = vector.push[Passed](?asg.arguments, passed); }
    if (sel pushed.err) { ret err[Refusal].err{Refusal.alloc{pushed.err}}; }
    ret err[Refusal].ok{};
}

# the piece at an index
pub fun piece(asg: *Assignment, at: u32) Piece {
    ret asg.pieces.data[at::usize];
}
