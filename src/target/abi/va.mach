# the va_list a front end hands on, read from the convention it calls under
#
# no function with a body is variadic, so nothing mirl compiles reads a
# va_list. a c function may still take one as a fixed parameter, as a logging
# callback does, and a front end hands it on as an opaque token, so it needs
# the size and alignment the convention's row states in its variadic model's
# `list`. a new convention states its `list` and needs nothing here.

use std.types.option.opt;
use std.types.result.res;

use std.allocator;

use mirl.ir.type.calling.Calling;
use mirl.ir.type.table;
use mirl.ir.type.table.DEFAULT_SPACE;
use mirl.ir.type.table.Shape;
use mirl.ir.type.table.Type;
use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.List;
use mirl.target.capability.Extent;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

# a convention's va_list as a module declares it
# ---
# size:  its bytes under the target's data layout
# align: its alignment under the target's data layout
pub rec Listed {
    size:  u64;
    align: u64;
}

# why a va_list was not answered
# ---
# alloc:       the allocator refused storage
# conventions: the target states no convention mirl carries
# named:       the name picks no row of the target's
# unstated:    the row leaves its va_list unstated
# layout:      the target does not lay the type out
pub tag Error: u8 {
    alloc:       allocator.Error;
    conventions: call.Error;
    named;
    unstated;
    layout: record.Error;
}

# the va_list of the convention a function type names on a module's target
# ---
# l:    the module's types laid out for its target
# name: the convention a function type names, none for the target's
#       default row
# ret:  the va_list, none where the convention has none, or why it was not
#       answered
pub fun va_list(l: *Layout, name: opt[Calling]) res[opt[Listed], Error] {
    val rows: res[Conventions, call.Error] = call.conventions(l.target);
    if (sel rows.err) { ret res[opt[Listed], Error].err{Error.conventions{rows.err}}; }
    var set:    Conventions      = rows.ok;
    val picked: opt[*Convention] = convention.pick(?set, name);
    if (sel picked.none) { ret res[opt[Listed], Error].err{Error.named{}}; }
    val list: List = picked.some.variadic.list;
    if (sel list.none)    { ret res[opt[Listed], Error].ok{opt[Listed].none{}}; }
    if (sel list.areas)   { ret res[opt[Listed], Error].ok{opt[Listed].some{Listed{size: list.areas.size, align: list.areas.align}}}; }
    if (sel list.pointer) { ret pointer(l); }
    ret res[opt[Listed], Error].err{Error.unstated{}};
}

# a va_list of one pointer, as the target lays one out
fun pointer(l: *Layout) res[opt[Listed], Error] {
    val p: res[Type, table.Error] = table.intern(l.types, Shape.pointer{table.Pointer{space: DEFAULT_SPACE}});
    if (sel p.err) {
        if (sel p.err.alloc) { ret res[opt[Listed], Error].err{Error.alloc{p.err.alloc}}; }
        ret res[opt[Listed], Error].err{Error.layout{record.Error.types{p.err}}};
    }
    val e: res[Extent, record.Error] = layout.extent(l, p.ok, DEFAULT_SPACE);
    if (sel e.err) { ret res[opt[Listed], Error].err{Error.layout{e.err}}; }
    ret res[opt[Listed], Error].ok{opt[Listed].some{Listed{size: e.ok.size, align: e.ok.align}}};
}
