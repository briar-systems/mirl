# the va_list a front end declares, read from the convention it calls under
#
# a convention's row states its va_list as data, in its variadic model's
# `list`: none, one pointer, or a record of save areas whose members the row
# states by role, ir type and offset as the convention's specification gives
# them. `va_list` interns that type in a module's table and lays it out for
# the module's target, refusing a row the target's data layout disagrees
# with. a lowering of va_start and va_arg reads the same `list`, so the row
# is the one statement of it. a new convention states its `list` and needs
# nothing here.

use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;

use mirl.ir.type.table;
use mirl.ir.type.table.DEFAULT_SPACE;
use mirl.ir.type.table.Shape;
use mirl.ir.type.table.Type;
use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Areas;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.Held;
use mirl.target.abi.convention.List;
use mirl.target.abi.convention.Member;
use mirl.target.capability.Extent;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

# a convention's va_list as a module declares it
# ---
# type:    its ir type, interned in the layout's table: `ptr` for a pointer,
#          the record for a record, and an array of one record where the
#          convention's va_list is one
# record:  the record's ir type, none for a pointer
# size:    its bytes under the target's data layout
# align:   its alignment under the target's data layout
# members: the record's members as the row states them, by role, ir type and
#          offset, empty for a pointer
pub rec Listed {
    type:    Type;
    record:  opt[Type];
    size:    u64;
    align:   u64;
    members: Slice[Member];
}

# why a va_list was not answered
# ---
# alloc:       the allocator refused storage
# conventions: the target states no convention mirl carries
# named:       the name picks no row of the target's
# unstated:    the row leaves its va_list unstated
# layout:      the target does not lay the type out
# size:        the target lays the record out at this many bytes, not the
#              row's
# align:       the target aligns the record to this, not the row's alignment
pub tag Error: u8 {
    alloc:       allocator.Error;
    conventions: call.Error;
    named;
    unstated;
    layout: record.Error;
    size:   u64;
    align:  u64;
}

# the va_list of the convention a function type names on a module's target
# ---
# l:    the module's types laid out for its target
# name: the convention's name as a function type spells it, empty for the
#       target's default row
# ret:  the va_list, none where the convention has none, or why it was not
#       answered
pub fun va_list(l: *Layout, name: View) res[opt[Listed], Error] {
    val rows: res[Conventions, call.Error] = call.conventions(l.target);
    if (sel rows.err) { ret res[opt[Listed], Error].err{Error.conventions{rows.err}}; }
    var set:    Conventions      = rows.ok;
    val picked: opt[*Convention] = convention.pick(?set, name);
    if (sel picked.none) { ret res[opt[Listed], Error].err{Error.named{}}; }
    ret of(l, picked.some);
}

# the va_list of one row on a module's target, as `va_list` answers it
pub fun of(l: *Layout, c: *Convention) res[opt[Listed], Error] {
    val list: List = c.variadic.list;
    if (sel list.none) { ret res[opt[Listed], Error].ok{opt[Listed].none{}}; }
    if (sel list.pointer) {
        val p: res[Type, Error] = intern(l, Shape.pointer{table.Pointer{space: DEFAULT_SPACE}});
        if (sel p.err) { ret res[opt[Listed], Error].err{p.err}; }
        val e: res[Extent, record.Error] = layout.extent(l, p.ok, DEFAULT_SPACE);
        if (sel e.err) { ret res[opt[Listed], Error].err{Error.layout{e.err}}; }
        val none: Slice[Member] = Slice[Member]{data: nil, size: 0};
        ret res[opt[Listed], Error].ok{opt[Listed].some{Listed{type: p.ok, record: opt[Type].none{}, size: e.ok.size, align: e.ok.align, members: none}}};
    }
    if (sel list.areas) { ret areas(l, list.areas); }
    ret res[opt[Listed], Error].err{Error.unstated{}};
}

fun intern(l: *Layout, shape: Shape) res[Type, Error] {
    val t: res[Type, table.Error] = table.intern(l.types, shape);
    if (sel t.err) { ret res[Type, Error].err{Error.layout{record.Error.types{t.err}}}; }
    ret res[Type, Error].ok{t.ok};
}

fun held(l: *Layout, h: Held) res[Type, Error] {
    if (sel h.integer) { ret intern(l, Shape.integer{table.Integer{width: h.integer}}); }
    ret intern(l, Shape.pointer{table.Pointer{space: DEFAULT_SPACE}});
}

# the record at the row's offsets, which the layout refuses where a member
# is misaligned or overlaps the one before, and the row's size and alignment
# held against the layout's
fun areas(l: *Layout, r: Areas) res[opt[Listed], Error] {
    val a:     *allocator.Allocator        = l.types.a;
    val n:     usize                       = r.members.size;
    val types: res[*Type, allocator.Error] = allocator.allocate[Type](a, n);
    if (sel types.err) { ret res[opt[Listed], Error].err{Error.alloc{types.err}}; }
    fin { allocator.deallocate[Type](a, types.ok, n); }
    val offsets: res[*u64, allocator.Error] = allocator.allocate[u64](a, n);
    if (sel offsets.err) { ret res[opt[Listed], Error].err{Error.alloc{offsets.err}}; }
    fin { allocator.deallocate[u64](a, offsets.ok, n); }
    var i: usize = 0;
    for (i < n) {
        val m: Member           = r.members.data[i];
        val t: res[Type, Error] = held(l, m.held);
        if (sel t.err) { ret res[opt[Listed], Error].err{t.err}; }
        types.ok[i]   = t.ok;
        offsets.ok[i] = m.offset;
        i             = i + 1;
    }
    val placed: opt[Slice[u64]]  = opt[Slice[u64]].some{Slice[u64]{data: offsets.ok, size: n}};
    val rec_t:  res[Type, Error] = intern(l, Shape.structure{table.Structure{members: Slice[Type]{data: types.ok, size: n}, offsets: placed}});
    if (sel rec_t.err) { ret res[opt[Listed], Error].err{rec_t.err}; }
    val e: res[Extent, record.Error] = layout.extent(l, rec_t.ok, DEFAULT_SPACE);
    if (sel e.err)             { ret res[opt[Listed], Error].err{Error.layout{e.err}}; }
    if (e.ok.size != r.size)   { ret res[opt[Listed], Error].err{Error.size{e.ok.size}}; }
    if (e.ok.align != r.align) { ret res[opt[Listed], Error].err{Error.align{e.ok.align}}; }
    var whole: Type = rec_t.ok;
    if (r.array) {
        val arr: res[Type, Error] = intern(l, Shape.array{table.Array{count: 1, element: rec_t.ok, stride: opt[u64].none{}}});
        if (sel arr.err) { ret res[opt[Listed], Error].err{arr.err}; }
        whole = arr.ok;
    }
    ret res[opt[Listed], Error].ok{opt[Listed].some{Listed{type: whole, record: opt[Type].some{rec_t.ok}, size: r.size, align: r.align, members: r.members}}};
}
