# the calling convention contract every convention fills
#
# a convention is a row for one architecture, system and abi, as data: its
# classifiers, the registers it passes, returns and preserves by masc's names,
# its stack, its indirect results, its variadic model and its half precision
# rule. a target declares the row it calls under. nothing reads a row's name to
# decide what to do: a classifier reads the row it is called through and the
# register rows masc states for the names, resolved once against a selection.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;

use rf: masc.core.register;
use mink.catalog.trait.Trait;

use mirl.ir.type.table.Extension;
use mirl.slice;
use mirl.target.abi.piece.Assignment;
use mirl.target.abi.piece.Refusal;
use mirl.target.abi.view;
use mirl.target.capability.Bits;

# how a call's statement passes one value
# ---
# platform:  as the convention's own rules place it
# reference: by reference to a copy the caller makes and owns, whatever the
#            convention would do
pub tag By: u8 {
    platform;
    reference;
}

# one argument or result of a call, as a classifier reads it
# ---
# node:      its root in the call's view
# named:     whether it is a named argument, true for every result
# by:        how the call's statement passes it
# extension: how the signature extends it, which `classify` applies to the
#            pieces a row fills as declared
pub rec Value {
    node:      u32;
    named:     bool;
    by:        By;
    extension: Extension;
}

# a call as its classifiers read it
# ---
# view:      the nodes of every value
# arguments: the arguments, in order
# results:   the results, in order
pub rec Call {
    view:      *view.View;
    arguments: Slice[Value];
    results:   Slice[Value];
}

# a classifier: it reads the resolved row it is called through and the call,
# and adds to the assignment. the result classifier runs first and the
# argument classifier after it, so the arguments see which results travel by
# reference
pub def Classifier: fun(*Resolved, *Call, *Assignment) err[Refusal];

# where a call leaves the address it returns to
# ---
# none:     in no place code can reach, as wasm's call stack keeps it
# stack:    pushed by the call, one word below the canonical frame address,
#           as x86-64 places it
# register: in this register, as risc-v's ra and aarch64's x30
pub tag Link: u8 {
    unstated;
    none;
    stack;
    register: str;
}

# a frame record the frame pointer heads, by byte offsets from the canonical
# frame address, the stack pointer's value at the call
# ---
# pointer:  where the frame pointer points, as 0 on risc-v and -16 on x86-64
#           and aarch64
# previous: where the caller's frame pointer is saved
# link:     where the return address is saved, or was pushed
pub rec Linked {
    pointer:  i64;
    previous: i64;
    link:     i64;
}

# what a kept frame pointer heads
# ---
# free:   no record, the frame pointer pointing where the frame chooses, as
#         windows x64 lets it
# linked: a frame record of the caller's frame pointer and the return address
pub tag Record: u8 {
    unstated;
    free;
    linked: Linked;
}

# a frame pointer register
# ---
# name:   the register
# record: what it heads
# always: whether every function keeps it, as darwin's arm64 does, rather than
#         only the functions whose frame the stack pointer cannot address
pub rec Keeper {
    name:   str;
    record: Record;
    always: bool;
}

# the frame pointer a convention keeps
# ---
# none:     there is none, as on wasm, so no frame moves its stack pointer
#           past a fixed size
# register: the register and its record
pub tag Pointer: u8 {
    unstated;
    none;
    register: Keeper;
}

# a stack in memory
# ---
# align:   the alignment the stack pointer keeps at a call, a power of two
# red:     the bytes below the stack pointer a leaf may use
# shadow:  the bytes the caller reserves above its arguments for the callee,
#          as on windows x64
# link:    where a call leaves its return address
# pointer: the frame pointer
pub rec Frame {
    align:   u64;
    red:     u64;
    shadow:  u64;
    link:    Link;
    pointer: Pointer;
}

# the stack a convention passes and keeps
# ---
# none:   there is no stack in memory, as on spir-v
# memory: a stack in memory
pub tag Stack: u8 {
    unstated;
    none;
    memory: Frame;
}

# what carries the address of a result that travels by reference
# ---
# none:     no result travels by reference, as on spir-v
# first:    an implicit first argument, placed as the first argument would be
# register: this register, outside the argument registers, as aarch64's x8
pub tag Carrier: u8 {
    unstated;
    none;
    first;
    register: str;
}

# where a callee hands back the address of a result that traveled by reference
# ---
# none:     nowhere
# register: this register, as system v x86-64's rax
pub tag Returned: u8 {
    unstated;
    none;
    register: str;
}

# indirect results
# ---
# carrier:  what carries the address in
# returned: where the callee hands it back
pub rec Indirect {
    carrier:  Carrier;
    returned: Returned;
}

# where unnamed arguments travel
# ---
# none:    the convention has no unnamed arguments
# named:   as named ones of their types would
# integer: by the integer rule alone, as on risc-v
# stack:   all on the stack, as apple's arm64 places them
# both:    as named ones, a float also copied to the integer register of its
#          position, as windows x64 does
pub tag Unnamed: u8 {
    unstated;
    none;
    named;
    integer;
    stack;
    both;
}

# a count the caller of a variadic function sets
# ---
# none:     there is none
# register: this register holds how many vector registers carry arguments, as
#           system v x86-64's al
pub tag Count: u8 {
    unstated;
    none;
    register: str;
}

# how a variadic callee reaches its unnamed arguments
# ---
# none:    it does not, the convention having no unnamed arguments
# pointer: one pointer walking one save area that the argument registers are
#          stored to just below the stack arguments
# areas:   a record of separate save areas, one per register class, as system
#          v x86-64 and aapcs64 keep
pub tag List: u8 {
    unstated;
    none;
    pointer;
    areas;
}

# the variadic model
# ---
# unnamed: where unnamed arguments travel
# count:   the count a caller sets
# list:    how a callee reaches them
pub rec Variadic {
    unnamed: Unnamed;
    count:   Count;
    list:    List;
}

# how a float of a 16-bit format travels
# ---
# float:   as the convention's other floats do
# integer: as an integer of its 16 bits
pub tag Half: u8 {
    unstated;
    float;
    integer;
}

# the floats a convention passes in float registers
# ---
# none:   it passes no float in float registers
# widest: it passes a float this many bits wide or narrower there
pub tag Floats: u8 {
    unstated;
    none;
    widest: u32;
}

# one calling convention
# ---
# name:      its spelling, for diagnostics only
# file:      the register file its registers are named in, nil where there
#            is none, as on spir-v and wasm
# results:   the result classifier
# arguments: the argument classifier
# word:      the bits of one argument word, the width of its integer argument
#            registers and of the stack slots it rounds to
# floats:    the floats it passes in float registers
# passing:   the argument registers, each class in the order they are taken
# returning: the result registers, each class in the order they are taken
# preserved: the registers a callee preserves, each whole
# reserved:  the registers no call clobbers and nothing allocates
# stack:     its stack
# indirect:  its indirect results
# variadic:  its variadic model
# half:      how a 16-bit float travels
# traits:    the traits of the architecture's objects that are the
#            convention's to state, as mink's rows, such as the float ABI of
#            a risc-v object
pub rec Convention {
    name:      str;
    file:      *rf.File;
    results:   Classifier;
    arguments: Classifier;
    word:      Bits;
    floats:    Floats;
    passing:   Slice[str];
    returning: Slice[str];
    preserved: Slice[str];
    reserved:  Slice[str];
    stack:     Stack;
    indirect:  Indirect;
    variadic:  Variadic;
    half:      Half;
    traits:    Traits;
}

# the traits a convention states for the objects of its calls
# ---
# unstated: a defect of the row
# none:     the convention has none to state, as x86-64's has not
# rows:     the traits, one for each axis it owns
pub tag Traits: u8 {
    unstated;
    none;
    rows: Slice[Trait];
}

# the convention a target declares its calls under
# ---
# uncarried: the target has a convention mirl has no row for yet, so its
#            calls are refused
# row:       the convention's row
pub tag Declared: u8 {
    unstated;
    uncarried;
    row: *Convention;
}

fun named(s: str) bool {
    ret s != nil && str_len(s) != 0;
}

fun names(list: Slice[str]) bool {
    var i: usize = 0;
    for (i < list.size) {
        if (!named(list.data[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun power_of_two(n: u64) bool {
    ret n != 0 && (n & (n - 1)) == 0;
}

# whether a memory stack states every field, consistently
fun framed(f: Frame) bool {
    if (!power_of_two(f.align) || sel f.link.unstated || sel f.pointer.unstated) { ret false; }
    if (sel f.link.register && !named(f.link.register))                          { ret false; }
    if (sel f.pointer.register) {
        val k: Keeper = f.pointer.register;
        if (!named(k.name) || sel k.record.unstated) { ret false; }
    }
    ret true;
}

# whether a row states every field, consistently
pub fun stated(c: *Convention) bool {
    if (!named(c.name) || c.results == nil || c.arguments == nil)                              { ret false; }
    if (sel c.word.unstated || (sel c.word.bits && c.word.bits == 0))                          { ret false; }
    if (sel c.floats.unstated || (sel c.floats.widest && c.floats.widest == 0))                { ret false; }
    if (!names(c.passing) || !names(c.returning) || !names(c.preserved) || !names(c.reserved)) { ret false; }
    if (sel c.stack.unstated || (sel c.stack.memory && !framed(c.stack.memory)))               { ret false; }
    if (sel c.indirect.carrier.unstated || sel c.indirect.returned.unstated)                   { ret false; }
    if (sel c.indirect.carrier.register && !named(c.indirect.carrier.register))                { ret false; }
    if (sel c.indirect.returned.register && !named(c.indirect.returned.register))              { ret false; }
    val v: Variadic = c.variadic;
    if (sel v.unnamed.unstated || sel v.count.unstated || sel v.list.unstated)                           { ret false; }
    if (sel v.count.register && !named(v.count.register))                                                { ret false; }
    if (sel c.half.unstated)                                                                             { ret false; }
    if (sel c.traits.unstated)                                                                           { ret false; }
    if (c.file != nil)                                                                                   { ret true; }
    if (sel c.stack.memory && (sel c.stack.memory.link.register || sel c.stack.memory.pointer.register)) { ret false; }
    ret c.passing.size == 0 && c.returning.size == 0 && c.preserved.size == 0 && c.reserved.size == 0;
}

# the registers of one class in a list, in the order the list takes them
# ---
# class: the class's row in the register file
# kind:  what its members hold
# first: its first register in the list's grouped registers
# count: how many it has
pub rec Bank {
    class: u16;
    kind:  rf.Kind;
    first: u32;
    count: u32;
}

# a list of registers resolved and grouped by class
# ---
# registers: the registers, each class's together in the list's order
# banks:     one per class, in the order each class first appears
pub rec Banks {
    registers: Slice[rf.Id];
    banks:     Slice[Bank];
}

# a register a row names that the selection does not hold
# ---
# name:   the row's spelling
# absent: why the selection refuses it
pub rec Missing {
    name:   str;
    absent: rf.Absent;
}

# why a row did not resolve against a selection
# ---
# alloc:    the allocator refused storage
# unstated: the row leaves a field unstated or states it inconsistently
# file:     the selection is of another register file than the row's
# register: a name the selection does not hold
# kinds:    two classes of one kind in one list, by the second class's row
# word:     an integer argument register whose width is not the row's word
# floats:   a float argument register narrower than the widest float the row
#           passes in one
# coverage: a register sharing storage with a preserved or reserved one
#           without being one, which masc states no coverage to resolve
pub tag Unresolved: u8 {
    alloc: allocator.Error;
    unstated;
    file;
    register: Missing;
    kinds:    u16;
    word:     rf.Id;
    floats:   rf.Id;
    coverage: rf.Id;
}

# a row resolved against a selection of its register file, once per target
# ---
# a:         the allocator its storage came from
# row:       the row
# registers: the selection's view of the row's file, which must outlive it
# passing:   the argument registers
# returning: the result registers
# preserved: the preserved registers, sorted
# reserved:  the reserved registers, sorted
# clobbered: the registers a call under the row leaves undefined, sorted:
#            every register the selection holds that is neither preserved
#            nor reserved nor masc's zero or program counter
# carrier:   the register carrying an indirect result's address, when the
#            row names one
# returned:  the register a callee hands that address back in, when named
# count:     the register a variadic caller sets its count in, when named
# link:      the register a call leaves its return address in, when named
# pointer:   the frame pointer register, when the row has one
pub rec Resolved {
    a:         *allocator.Allocator;
    row:       *Convention;
    registers: *rf.Available;
    passing:   Banks;
    returning: Banks;
    preserved: Slice[rf.Id];
    reserved:  Slice[rf.Id];
    clobbered: Slice[rf.Id];
    carrier:   opt[rf.Id];
    returned:  opt[rf.Id];
    count:     opt[rf.Id];
    link:      opt[rf.Id];
    pointer:   opt[rf.Id];
}

# the registers of the first bank of a kind, empty when the list has none
pub fun bank(b: *Banks, kind: rf.Kind) Slice[rf.Id] {
    var i: usize = 0;
    for (i < b.banks.size) {
        val k: Bank = b.banks.data[i];
        if (k.kind == kind) { ret Slice[rf.Id]{data: ?b.registers.data[k.first::usize], size: k.count::usize}; }
        i = i + 1;
    }
    ret Slice[rf.Id]{data: nil, size: 0};
}

# the width in bits of a register through the selection, none when its scale
# is unfixed
pub fun width(r: *Resolved, reg: rf.Id) opt[u64] {
    val w: res[opt[u64], rf.Absent] = rf.width(r.registers, reg);
    if (sel w.err) { ret opt[u64].none{}; }
    ret w.ok;
}

fun lookup(regs: *rf.Available, name: str) res[rf.Id, Unresolved] {
    val found: res[rf.Id, rf.Absent] = rf.lookup(regs, View{data: name, len: str_len(name)});
    if (sel found.err) { ret res[rf.Id, Unresolved].err{Unresolved.register{Missing{name: name, absent: found.err}}}; }
    ret res[rf.Id, Unresolved].ok{found.ok};
}

fun optional(regs: *rf.Available, name: opt[str]) res[opt[rf.Id], Unresolved] {
    if (sel name.none) { ret res[opt[rf.Id], Unresolved].ok{opt[rf.Id].none{}}; }
    val r: res[rf.Id, Unresolved] = lookup(regs, name.some);
    if (sel r.err) { ret res[opt[rf.Id], Unresolved].err{r.err}; }
    ret res[opt[rf.Id], Unresolved].ok{opt[rf.Id].some{r.ok}};
}

fun ids(a: *allocator.Allocator, regs: *rf.Available, names: Slice[str]) res[Slice[rf.Id], Unresolved] {
    var out: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: names.size};
    if (names.size == 0) { ret res[Slice[rf.Id], Unresolved].ok{out}; }
    val got: res[*rf.Id, allocator.Error] = allocator.allocate[rf.Id](a, names.size);
    if (sel got.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{got.err}}; }
    out.data = got.ok;
    var i: usize = 0;
    for (i < names.size) {
        val r: res[rf.Id, Unresolved] = lookup(regs, names.data[i]);
        if (sel r.err) {
            allocator.deallocate[rf.Id](a, out.data, out.size);
            ret res[Slice[rf.Id], Unresolved].err{r.err};
        }
        out.data[i] = r.ok;
        i           = i + 1;
    }
    ret res[Slice[rf.Id], Unresolved].ok{out};
}

fun sorted(a: *allocator.Allocator, regs: *rf.Available, names: Slice[str]) res[Slice[rf.Id], Unresolved] {
    val r: res[Slice[rf.Id], Unresolved] = ids(a, regs, names);
    if (sel r.err)     { ret r; }
    if (r.ok.size > 1) { sort.sort[rf.Id](r.ok.data, r.ok.size); }
    ret r;
}

fun release_ids(a: *allocator.Allocator, s: Slice[rf.Id]) {
    if (s.size != 0) { allocator.deallocate[rf.Id](a, s.data, s.size); }
}

fun release_banks(a: *allocator.Allocator, b: Banks) {
    release_ids(a, b.registers);
    if (b.banks.size != 0) { allocator.deallocate[Bank](a, b.banks.data, b.banks.size); }
}

# group a list's registers by class, a counting sort over the file's classes
# that keeps the list's order within each class
fun group(a: *allocator.Allocator, file: *rf.File, regs: *rf.Available, names: Slice[str]) res[Banks, Unresolved] {
    var out: Banks = Banks{registers: Slice[rf.Id]{data: nil, size: 0}, banks: Slice[Bank]{data: nil, size: 0}};
    if (names.size == 0) { ret res[Banks, Unresolved].ok{out}; }
    val listed: res[Slice[rf.Id], Unresolved] = ids(a, regs, names);
    if (sel listed.err) { ret res[Banks, Unresolved].err{listed.err}; }
    val list:    Slice[rf.Id]               = listed.ok;
    val classes: usize                      = file.class_count::usize;
    val counted: res[*u32, allocator.Error] = allocator.zallocate[u32](a, classes * 2);
    if (sel counted.err) {
        release_ids(a, list);
        ret res[Banks, Unresolved].err{Unresolved.alloc{counted.err}};
    }
    val count: *u32 = counted.ok;
    val start: *u32 = ?counted.ok[classes];
    fin { allocator.deallocate[u32](a, count, classes * 2); }
    var used: usize = 0;
    var i:    usize = 0;
    for (i < list.size) {
        val c: usize = rf.class_of(list.data[i])::usize;
        if (count[c] == 0) { used = used + 1; }
        count[c] = count[c] + 1;
        i        = i + 1;
    }
    val made: res[*Bank, allocator.Error] = allocator.allocate[Bank](a, used);
    if (sel made.err) {
        release_ids(a, list);
        ret res[Banks, Unresolved].err{Unresolved.alloc{made.err}};
    }
    val grouped: res[*rf.Id, allocator.Error] = allocator.allocate[rf.Id](a, list.size);
    if (sel grouped.err) {
        allocator.deallocate[Bank](a, made.ok, used);
        release_ids(a, list);
        ret res[Banks, Unresolved].err{Unresolved.alloc{grouped.err}};
    }
    out.registers = Slice[rf.Id]{data: grouped.ok, size: list.size};
    out.banks     = Slice[Bank]{data: made.ok, size: used};
    # banks in the order each class first appears, each starting after the one before
    var next: u32   = 0;
    var b:    usize = 0;
    var seen: [256]u8;
    i = 0;
    for (i < list.size) {
        val c: u16 = rf.class_of(list.data[i]);
        if (count[c::usize] != 0) {
            val kind: rf.Kind = file.classes[c].kind;
            if (seen[kind::usize] != 0) {
                release_ids(a, list);
                release_banks(a, out);
                ret res[Banks, Unresolved].err{Unresolved.kinds{c}};
            }
            seen[kind::usize] = 1;
            out.banks.data[b] = Bank{class: c, kind: kind, first: next, count: count[c::usize]};
            start[c::usize]   = next;
            next              = next + count[c::usize];
            count[c::usize]   = 0;
            b                 = b + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < list.size) {
        val c: usize = rf.class_of(list.data[i])::usize;
        out.registers.data[start[c]::usize] = list.data[i];
        start[c]                            = start[c] + 1;
        i                                   = i + 1;
    }
    release_ids(a, list);
    ret res[Banks, Unresolved].ok{out};
}

fun holds(s: Slice[rf.Id], reg: rf.Id) bool {
    if (s.size == 0) { ret false; }
    var want: rf.Id               = reg;
    val at:   sort.SearchPosition = sort.binary_search[rf.Id](s.data, s.size, ?want);
    ret sel at.found;
}

fun by_bank(a: **rf.Register, b: **rf.Register) i64 {
    if (a[0].bank < b[0].bank) { ret -1; }
    if (a[0].bank > b[0].bank) { ret 1; }
    ret 0;
}

# whether a row shares storage with a kept row, which are sorted by bank, by
# testing only the kept rows of its bank
fun shares(file: *rf.File, kept: Vector[*rf.Register], row: *rf.Register) bool {
    var lo: usize = 0;
    var hi: usize = kept.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (kept.data[mid].bank < row.bank) { lo = mid + 1; }
        or                                  { hi = mid; }
    }
    for (lo < kept.len && kept.data[lo].bank == row.bank) {
        if (rf.overlap(file, row, kept.data[lo])) { ret true; }
        lo = lo + 1;
    }
    ret false;
}

# the registers a call clobbers: every register row the selection holds that
# is not preserved, reserved, zero or the program counter. a row sharing
# storage with a preserved or reserved row is refused, since masc states
# whether two rows overlap and not whether one covers the other
fun clobbers(a: *allocator.Allocator, regs: *rf.Available, kept: Slice[rf.Id], reserved: Slice[rf.Id]) res[Slice[rf.Id], Unresolved] {
    val file: *rf.File             = regs.file;
    var keep: Vector[*rf.Register] = vector.init[*rf.Register](a);
    var out:  Vector[rf.Id]        = vector.init[rf.Id](a);
    fin {
        vector.dnit[*rf.Register](?keep);
        vector.dnit[rf.Id](?out);
    }
    var i: u32 = 0;
    for (i < file.register_count) {
        val row: *rf.Register = ?file.registers[i];
        val id:  rf.Id        = rf.id_of(row);
        if (holds(kept, id) || holds(reserved, id)) {
            val pushed: res[usize, allocator.Error] = vector.push[*rf.Register](?keep, row);
            if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    if (keep.len > 1) { sort.sort_by[*rf.Register](keep.data, keep.len, by_bank); }
    i = 0;
    for (i < file.register_count) {
        val row: *rf.Register   = ?file.registers[i];
        val id:  rf.Id          = rf.id_of(row);
        val in:  err[rf.Absent] = rf.admitted(regs, id);
        if (sel in.ok && (row.flags & (rf.ZERO | rf.PC)) == 0 && !holds(kept, id) && !holds(reserved, id)) {
            if (shares(file, keep, row)) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.coverage{id}}; }
            val pushed: res[usize, allocator.Error] = vector.push[rf.Id](?out, id);
            if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    if (out.len > 1) { sort.sort[rf.Id](out.data, out.len); }
    val copied: res[Slice[rf.Id], allocator.Error] = slice.copy[rf.Id](a, Slice[rf.Id]{data: out.data, size: out.len});
    if (sel copied.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{copied.err}}; }
    ret res[Slice[rf.Id], Unresolved].ok{copied.ok};
}

fun register_name(r: Carrier) opt[str] {
    if (sel r.register) { ret opt[str].some{r.register}; }
    ret opt[str].none{};
}

fun returned_name(r: Returned) opt[str] {
    if (sel r.register) { ret opt[str].some{r.register}; }
    ret opt[str].none{};
}

fun count_name(c: Count) opt[str] {
    if (sel c.register) { ret opt[str].some{c.register}; }
    ret opt[str].none{};
}

fun link_name(s: Stack) opt[str] {
    if (!(sel s.memory)) { ret opt[str].none{}; }
    val l: Link = s.memory.link;
    if (sel l.register) { ret opt[str].some{l.register}; }
    ret opt[str].none{};
}

fun pointer_name(s: Stack) opt[str] {
    if (!(sel s.memory)) { ret opt[str].none{}; }
    val p: Pointer = s.memory.pointer;
    if (sel p.register) { ret opt[str].some{p.register.name}; }
    ret opt[str].none{};
}

# check each register of a bank of `kind` against a width rule
fun widths(r: *Resolved, kind: rf.Kind, bits: u64, exact: bool) opt[rf.Id] {
    val regs: Slice[rf.Id] = bank(?r.passing, kind);
    var i:    usize        = 0;
    for (i < regs.size) {
        val w: opt[u64] = width(r, regs.data[i]);
        if (sel w.none)              { ret opt[rf.Id].some{regs.data[i]}; }
        if (exact && w.some != bits) { ret opt[rf.Id].some{regs.data[i]}; }
        if (!exact && w.some < bits) { ret opt[rf.Id].some{regs.data[i]}; }
        i = i + 1;
    }
    ret opt[rf.Id].none{};
}

# resolve a row against a selection of its register file
# ---
# a:    the allocator the resolution's storage comes from
# row:  the row
# regs: the selection's view of the row's file, which must outlive the result
# ret:  the resolved row, or why it did not resolve
pub fun resolve(a: *allocator.Allocator, row: *Convention, regs: *rf.Available) res[Resolved, Unresolved] {
    if (!stated(row))          { ret res[Resolved, Unresolved].err{Unresolved.unstated{}}; }
    if (regs.file != row.file) { ret res[Resolved, Unresolved].err{Unresolved.file{}}; }
    var r: Resolved = Resolved{
        a:         a,
        row:       row,
        registers: regs,
        passing:   Banks{registers: Slice[rf.Id]{data: nil, size: 0}, banks: Slice[Bank]{data: nil, size: 0}},
        returning: Banks{registers: Slice[rf.Id]{data: nil, size: 0}, banks: Slice[Bank]{data: nil, size: 0}},
        preserved: Slice[rf.Id]{data: nil, size: 0},
        reserved:  Slice[rf.Id]{data: nil, size: 0},
        clobbered: Slice[rf.Id]{data: nil, size: 0},
        carrier:   opt[rf.Id].none{},
        returned:  opt[rf.Id].none{},
        count:     opt[rf.Id].none{},
        link:      opt[rf.Id].none{},
        pointer:   opt[rf.Id].none{},
    };
    if (row.file == nil) { ret res[Resolved, Unresolved].ok{r}; }
    val passing: res[Banks, Unresolved] = group(a, row.file, regs, row.passing);
    if (sel passing.err) { ret res[Resolved, Unresolved].err{passing.err}; }
    r.passing = passing.ok;
    val returning: res[Banks, Unresolved] = group(a, row.file, regs, row.returning);
    if (sel returning.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{returning.err};
    }
    r.returning = returning.ok;
    val preserved: res[Slice[rf.Id], Unresolved] = sorted(a, regs, row.preserved);
    if (sel preserved.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{preserved.err};
    }
    r.preserved = preserved.ok;
    val reserved: res[Slice[rf.Id], Unresolved] = sorted(a, regs, row.reserved);
    if (sel reserved.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{reserved.err};
    }
    r.reserved = reserved.ok;
    val clobbered: res[Slice[rf.Id], Unresolved] = clobbers(a, regs, r.preserved, r.reserved);
    if (sel clobbered.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{clobbered.err};
    }
    r.clobbered = clobbered.ok;
    val carrier: res[opt[rf.Id], Unresolved] = optional(regs, register_name(row.indirect.carrier));
    if (sel carrier.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{carrier.err};
    }
    r.carrier = carrier.ok;
    val returned: res[opt[rf.Id], Unresolved] = optional(regs, returned_name(row.indirect.returned));
    if (sel returned.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{returned.err};
    }
    r.returned = returned.ok;
    val count: res[opt[rf.Id], Unresolved] = optional(regs, count_name(row.variadic.count));
    if (sel count.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{count.err};
    }
    r.count = count.ok;
    val link: res[opt[rf.Id], Unresolved] = optional(regs, link_name(row.stack));
    if (sel link.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{link.err};
    }
    r.link = link.ok;
    val pointer: res[opt[rf.Id], Unresolved] = optional(regs, pointer_name(row.stack));
    if (sel pointer.err) {
        release(?r);
        ret res[Resolved, Unresolved].err{pointer.err};
    }
    r.pointer = pointer.ok;
    if (sel row.word.bits) {
        val off: opt[rf.Id] = widths(?r, rf.GENERAL, row.word.bits::u64, true);
        if (sel off.some) {
            release(?r);
            ret res[Resolved, Unresolved].err{Unresolved.word{off.some}};
        }
    }
    if (sel row.floats.widest) {
        val off: opt[rf.Id] = widths(?r, rf.FLOAT, row.floats.widest::u64, false);
        if (sel off.some) {
            release(?r);
            ret res[Resolved, Unresolved].err{Unresolved.floats{off.some}};
        }
    }
    ret res[Resolved, Unresolved].ok{r};
}

# give back a resolved row's storage
pub fun release(r: *Resolved) {
    release_banks(r.a, r.passing);
    release_banks(r.a, r.returning);
    release_ids(r.a, r.preserved);
    release_ids(r.a, r.reserved);
    release_ids(r.a, r.clobbered);
    r.passing   = Banks{registers: Slice[rf.Id]{data: nil, size: 0}, banks: Slice[Bank]{data: nil, size: 0}};
    r.returning = r.passing;
    r.preserved = Slice[rf.Id]{data: nil, size: 0};
    r.reserved  = r.preserved;
    r.clobbered = r.preserved;
}
