# the calling convention contract every convention fills
#
# a convention is a row for one architecture, system and abi, as data: its
# classifiers, the registers it passes, returns and preserves by masc's handles
# and how much of each preserved one it keeps, its stack and where its stack
# pointer lives, its indirect results, its variadic model, its half precision
# rule, its register pairing, its stack packing and its tail call rule. a
# target declares the rows it calls under, one the default and the others a
# function type names. nothing reads a row's name to decide what to do: a
# classifier reads the row it is called through and the register rows masc
# states for the handles, resolved once against a selection. a row with no
# register file, as wasm's and spir-v's, resolves with no selection and holds
# no registers.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.sort;
use std.collections.vector;
use std.collections.vector.Vector;

use rf:         masc.core.register;
use core_state: masc.core.state;
use arches:     mink.catalog.arch;

use mirl.base.slice;
use mirl.ir.type.table.Extension;
use mirl.target.abi.piece.Assignment;
use mirl.target.abi.piece.Refusal;
use mirl.target.abi.view;
use mirl.target.capability.Bits;

# how a call's statement passes one value
# ---
# platform:  as the convention's own rules place it
# reference: by reference to a copy the caller makes and owns, whatever the
#            convention would do
pub tag By: u8 {
    platform;
    reference;
}

# one argument or result of a call, as a classifier reads it
# ---
# node:      its root in the call's view
# named:     whether it is a named argument, true for every result
# by:        how the call's statement passes it
# extension: how the signature extends it, which `classify` applies to the
#            pieces a row fills as declared
pub rec Value {
    node:      u32;
    named:     bool;
    by:        By;
    extension: Extension;
}

# a call as its classifiers read it
# ---
# view:      the nodes of every value
# arguments: the arguments, in order
# results:   the results, in order
pub rec Call {
    view:      *view.View;
    arguments: Slice[Value];
    results:   Slice[Value];
}

# a classifier: it reads the resolved row it is called through and the call,
# and adds to the assignment. the result classifier runs first and the
# argument classifier after it, so the arguments see which results travel by
# reference
pub def Classifier: fun(*Resolved, *Call, *Assignment) err[Refusal];

# a row's classifiers
# ---
# results:   the result classifier
# arguments: the argument classifier
pub rec Classifiers {
    results:   Classifier;
    arguments: Classifier;
}

# whether a call of this assignment may be made as a tail call under the
# resolved row it was classified through, which reads only the row and the
# assignment
pub def Tail: fun(*Resolved, *Assignment) bool;

# where a call leaves the address it returns to
# ---
# none:     in no place code can reach, as wasm's call stack keeps it
# stack:    pushed by the call, one word below the canonical frame address,
#           as x86-64 places it
# register: in this register, as risc-v's ra and aarch64's x30
pub tag Link: u8 {
    unstated;
    none;
    stack;
    register: rf.Id;
}

# a frame record the frame pointer heads, by byte offsets from the canonical
# frame address, the stack pointer's value at the call
# ---
# pointer:  where the frame pointer points, as 0 on risc-v and -16 on x86-64
#           and aarch64
# previous: where the caller's frame pointer is saved
# link:     where the return address is saved, or was pushed
pub rec Linked {
    pointer:  i64;
    previous: i64;
    link:     i64;
}

# what a kept frame pointer heads
# ---
# free:   no record, the frame pointer pointing where the frame chooses, as
#         windows x64 lets it
# linked: a frame record of the caller's frame pointer and the return address
pub tag Record: u8 {
    unstated;
    free;
    linked: Linked;
}

# a frame pointer register
# ---
# register: the register
# record:   what it heads
# always:   whether every function keeps it, as darwin's arm64 does, rather than
#           only the functions whose frame the stack pointer cannot address
pub rec Keeper {
    register: rf.Id;
    record:   Record;
    always:   bool;
}

# the frame pointer a convention keeps
# ---
# none:     there is none, as on wasm, so no frame moves its stack pointer
#           past a fixed size
# register: the register and its record
pub tag Pointer: u8 {
    unstated;
    none;
    register: Keeper;
}

# where a stack's stack pointer lives
# ---
# register: in this register, as risc-v's sp and x86-64's rsp
# global:   in the global of this symbol, as wasm's __stack_pointer
pub tag Home: u8 {
    unstated;
    register: rf.Id;
    global:   str;
}

# a stack in memory
# ---
# align:        the alignment the stack pointer keeps at a call, a power of two
# red:          the bytes below the stack pointer a leaf may use
# shadow:       the bytes the caller reserves above its arguments for the
#               callee, as on windows x64
# link:         where a call leaves its return address
# pointer:      the frame pointer
# pointer_home: where the stack pointer lives
pub rec Frame {
    align:        u64;
    red:          u64;
    shadow:       u64;
    link:         Link;
    pointer:      Pointer;
    pointer_home: Home;
}

# the stack a convention passes and keeps
# ---
# none:   there is no stack in memory, as on spir-v
# memory: a stack in memory
pub tag Stack: u8 {
    unstated;
    none;
    memory: Frame;
}

# what carries the address of a result that travels by reference
# ---
# none:     no result travels by reference, as on spir-v
# first:    an implicit first argument, placed as the first argument would be
# register: this register, outside the argument registers, as aarch64's x8
pub tag Carrier: u8 {
    unstated;
    none;
    first;
    register: rf.Id;
}

# where a callee hands back the address of a result that traveled by reference
# ---
# none:     nowhere
# register: this register, as system v x86-64's rax
pub tag Returned: u8 {
    unstated;
    none;
    register: rf.Id;
}

# indirect results
# ---
# carrier:  what carries the address in
# returned: where the callee hands it back
pub rec Indirect {
    carrier:  Carrier;
    returned: Returned;
}

# where unnamed arguments travel
# ---
# none:    the convention has no unnamed arguments
# named:   as named ones of their types would
# integer: by the integer rule alone, as on risc-v
# stack:   all on the stack, as apple's arm64 places them
# both:    as named ones, a float also copied to the integer register of its
#          position, as windows x64 does
pub tag Unnamed: u8 {
    unstated;
    none;
    named;
    integer;
    stack;
    both;
}

# a count the caller of a variadic function sets
# ---
# none:     there is none
# register: this register holds how many vector registers carry arguments, as
#           system v x86-64's al
pub tag Count: u8 {
    unstated;
    none;
    register: rf.Id;
}

# how a variadic callee reaches its unnamed arguments
# ---
# none:    it does not, the convention having no unnamed arguments
# pointer: one pointer walking one save area that the argument registers are
#          stored to just below the stack arguments
# areas:   a record of separate save areas, one per register class, as system
#          v x86-64 and aapcs64 keep
pub tag List: u8 {
    unstated;
    none;
    pointer;
    areas;
}

# the variadic model
# ---
# unnamed: where unnamed arguments travel
# count:   the count a caller sets
# list:    how a callee reaches them
pub rec Variadic {
    unnamed: Unnamed;
    count:   Count;
    list:    List;
}

# how a float of a 16-bit format travels
# ---
# float:   as the convention's other floats do
# integer: as an integer of its 16 bits
pub tag Half: u8 {
    unstated;
    float;
    integer;
}

# the floats a convention passes in float registers
# ---
# none:   it passes no float in float registers
# widest: it passes a float this many bits wide or narrower there
pub tag Floats: u8 {
    unstated;
    none;
    widest: u32;
}

# how much of a preserved register a callee keeps
# ---
# whole: all of it, at whatever width the selection gives the register
# low:   its low this many bits, as risc-v keeps flen bits of a wider float
#        register and aapcs64 the low 64 bits of v8 to v15. a call clobbers
#        the rest, so where the selection's register is wider the register
#        is preserved by a callee and clobbered for a caller
pub tag Part: u8 {
    unstated;
    whole;
    low: u32;
}

# a register a callee preserves
# ---
# register: the register
# bits:     how much of it the callee keeps
pub rec Kept {
    register: rf.Id;
    bits:     Part;
}

# which argument register a two-word value starts at, for the values the
# row's classifier pairs, as risc-v's unnamed ones and aapcs64's named ones
# ---
# even: an even numbered one, skipping an odd one left free
# any:  the next free one, as darwin's arm64 and risc-v's e rows take it
pub tag Pairs: u8 {
    unstated;
    even;
    any;
}

# how arguments are packed in the stack area
# ---
# slot:    each in its own slots of the row's word, as risc-v and system v
#          place them
# natural: each at its own alignment and size, as darwin's arm64 packs them
pub tag Packing: u8 {
    unstated;
    slot;
    natural;
}

# one calling convention
# ---
# name:        its spelling, which a function type names it by and
#              diagnostics show
# abi:         the psABI row of mink's catalog it is
# file:        the register file its registers are named in, none where
#              there is none, as on spir-v and wasm
# classifiers: its result and argument classifiers
# word:        the bits of one argument word, the width of its integer
#              argument registers and of the stack slots it rounds to
# floats:      the floats it passes in float registers
# passing:     the argument registers, each class in the order they are taken
# returning:   the result registers, each class in the order they are taken
# preserved:   the registers a callee preserves, and how much of each
# reserved:    the registers no call clobbers and nothing allocates
# stack:       its stack
# indirect:    its indirect results
# variadic:    its variadic model
# half:        how a 16-bit float travels
# pairs:       which register a two-word value its classifier pairs starts at
# packing:     how its stack arguments are packed
# tail:        its tail call rule
pub rec Convention {
    name:        str;
    abi:         Abi;
    file:        opt[*rf.File];
    classifiers: Classifiers;
    word:        Bits;
    floats:      Floats;
    passing:     Slice[rf.Id];
    returning:   Slice[rf.Id];
    preserved:   Slice[Kept];
    reserved:    Slice[rf.Id];
    stack:       Stack;
    indirect:    Indirect;
    variadic:    Variadic;
    half:        Half;
    pairs:       Pairs;
    packing:     Packing;
    tail:        Tail;
}

# the psABI row of mink's catalog a convention is, whose traits its objects
# state, as the float ABI of a risc-v object. the row is named by its
# spelling, which `abi_row` finds among the rows of an architecture's family,
# and is admitted only on the architecture mink states it for, so ilp32e and
# lp64e are rows of riscv32e and riscv64e alone
# ---
# unstated: a defect of the row
# none:     the architecture's family names no psABI rows, as x86-64's
# named:    the row of this name, as `lp64d`
pub tag Abi: u8 {
    unstated;
    none;
    named: str;
}

# why a convention's psABI name gives no row of mink's catalog for an
# architecture
# ---
# unstated: the convention leaves its abi unstated
# absent:   the architecture's family has no row of that name
# arch:     the family's row of that name is for this other architecture
pub tag Misnamed: u8 {
    unstated;
    absent;
    arch: *arches.Arch;
}

# the psABI row of mink's catalog a convention is on an architecture, none
# for a convention whose family names none
pub fun abi_row(c: *Convention, arch: *arches.Arch) res[opt[*arches.Abi], Misnamed] {
    val stated: Abi = c.abi;
    if (sel stated.none)     { ret res[opt[*arches.Abi], Misnamed].ok{opt[*arches.Abi].none{}}; }
    if (!(sel stated.named)) { ret res[opt[*arches.Abi], Misnamed].err{Misnamed.unstated{}}; }
    if (arch.family == nil)  { ret res[opt[*arches.Abi], Misnamed].err{Misnamed.absent{}}; }
    var other: *arches.Arch   = nil;
    val f:     *arches.Family = arch.family;
    var i:     usize          = 0;
    for (i < f.abi_count) {
        val b: *arches.Abi = f.abis[i];
        if (str_equals(b.name, stated.named)) {
            if (b.arch == arch) { ret res[opt[*arches.Abi], Misnamed].ok{opt[*arches.Abi].some{b}}; }
            other = b.arch;
        }
        i = i + 1;
    }
    if (other != nil) { ret res[opt[*arches.Abi], Misnamed].err{Misnamed.arch{other}}; }
    ret res[opt[*arches.Abi], Misnamed].err{Misnamed.absent{}};
}

# the rows a target's calls are made under
# ---
# default: the row of every call and function whose type names none
# rows:    the other rows a function type may name, as the sve pcs beside
#          aapcs64 or an internal convention beside a platform's
pub rec Conventions {
    default: *Convention;
    rows:    Slice[*Convention];
}

# no rows beside the default
pub val ALONE: Slice[*Convention] = Slice[*Convention]{data: nil, size: 0};

# the conventions a target declares its calls under
# ---
# uncarried: the target has a convention mirl has no row for yet, so its
#            calls are refused
# rows:      its rows
pub tag Declared: u8 {
    unstated;
    uncarried;
    rows: Conventions;
}

fun spelled(s: str, v: View) bool {
    if (s == nil) { ret v.len == 0; }
    ret slice.same_view(View{data: s, len: str_len(s)}, v);
}

# the row a function type's convention name picks: the default for an empty
# name, and otherwise the default or the other row of that name, none when
# the target states no row of it
pub fun pick(c: *Conventions, name: View) opt[*Convention] {
    if (name.len == 0 || spelled(c.default.name, name)) { ret opt[*Convention].some{c.default}; }
    var i: usize = 0;
    for (i < c.rows.size) {
        if (spelled(c.rows.data[i].name, name)) { ret opt[*Convention].some{c.rows.data[i]}; }
        i = i + 1;
    }
    ret opt[*Convention].none{};
}

# the position of the row a name picks among every row of a set, the default
# first and then the others in order, none when it picks none
pub fun position(c: *Conventions, name: View) opt[usize] {
    if (name.len == 0 || spelled(c.default.name, name)) { ret opt[usize].some{0}; }
    var i: usize = 0;
    for (i < c.rows.size) {
        if (spelled(c.rows.data[i].name, name)) { ret opt[usize].some{i + 1}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}

# whether a set states every row and no two rows of one name
pub fun stated_rows(c: *Conventions) bool {
    if (c.default == nil || !stated(c.default)) { ret false; }
    var i: usize = 0;
    for (i < c.rows.size) {
        val row: *Convention = c.rows.data[i];
        if (row == nil || !stated(row))           { ret false; }
        if (str_equals(row.name, c.default.name)) { ret false; }
        var k: usize = 0;
        for (k < i) {
            if (str_equals(row.name, c.rows.data[k].name)) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

fun named(s: str) bool {
    ret s != nil && str_len(s) != 0;
}

fun power_of_two(n: u64) bool {
    ret n != 0 && (n & (n - 1)) == 0;
}

# whether a memory stack states every field, consistently
fun framed(f: Frame) bool {
    if (!power_of_two(f.align) || sel f.link.unstated || sel f.pointer.unstated) { ret false; }
    if (sel f.pointer.register && sel f.pointer.register.record.unstated)        { ret false; }
    if (sel f.pointer_home.unstated)                                             { ret false; }
    if (sel f.pointer_home.global && !named(f.pointer_home.global))              { ret false; }
    ret true;
}

# whether every preserved register states how much of it is kept
fun kept_stated(list: Slice[Kept]) bool {
    var i: usize = 0;
    for (i < list.size) {
        val p: Part = list.data[i].bits;
        if (sel p.unstated)          { ret false; }
        if (sel p.low && p.low == 0) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether a memory stack names a register anywhere
fun stack_registers(s: Stack) bool {
    if (!(sel s.memory)) { ret false; }
    val f: Frame = s.memory;
    ret sel f.link.register || sel f.pointer.register || sel f.pointer_home.register;
}

# whether a row states every field, consistently
pub fun stated(c: *Convention) bool {
    if (!named(c.name) || c.classifiers.results == nil || c.classifiers.arguments == nil || c.tail == nil) { ret false; }
    if (sel c.word.unstated || (sel c.word.bits && c.word.bits == 0))                                      { ret false; }
    if (sel c.floats.unstated || (sel c.floats.widest && c.floats.widest == 0))                            { ret false; }
    if (sel c.stack.unstated || (sel c.stack.memory && !framed(c.stack.memory)))                           { ret false; }
    if (sel c.indirect.carrier.unstated || sel c.indirect.returned.unstated)                               { ret false; }
    val v: Variadic = c.variadic;
    if (sel v.unnamed.unstated || sel v.count.unstated || sel v.list.unstated)                       { ret false; }
    if (sel c.half.unstated || sel c.abi.unstated)                                                   { ret false; }
    if (sel c.pairs.unstated || sel c.packing.unstated)                                              { ret false; }
    if (!kept_stated(c.preserved))                                                                   { ret false; }
    if (sel c.file.some)                                                                             { ret c.file.some != nil; }
    if (stack_registers(c.stack))                                                                    { ret false; }
    if (sel c.indirect.carrier.register || sel c.indirect.returned.register || sel v.count.register) { ret false; }
    ret c.passing.size == 0 && c.returning.size == 0 && c.preserved.size == 0 && c.reserved.size == 0;
}

# the registers of one class in a list, in the order the list takes them
# ---
# class: the class's row in the register file
# kind:  what its members hold
# first: its first register in the list's grouped registers
# count: how many it has
pub rec Bank {
    class: u16;
    kind:  rf.Kind;
    first: u32;
    count: u32;
}

# a list of registers resolved and grouped by class
# ---
# registers: the registers, each class's together in the list's order
# banks:     one per class, in the order each class first appears
pub rec Banks {
    registers: Slice[rf.Id];
    banks:     Slice[Bank];
}

# a register a row names that the selection does not hold
# ---
# register: the row's register
# absent:   why the selection refuses it
pub rec Missing {
    register: rf.Id;
    absent:   rf.Absent;
}

# why a row did not resolve against a selection
# ---
# alloc:    the allocator refused storage
# unstated: the row leaves a field unstated or states it inconsistently
# file:     the row has a register file and the selection is of another
#           one, or there is no selection to resolve it through
# register: a register the selection does not hold
# kinds:    two classes of one kind in one list, by the second class's row
# word:     an integer argument register whose width is not the row's word
# floats:   a float argument register narrower than the widest float the row
#           passes in one
# coverage: a register sharing storage with a preserved or reserved one
#           without being one, which masc states no coverage to resolve
# kept:     a preserved register the row keeps more bits of than the
#           selection gives it
# home:     the register the row homes its stack pointer in, which masc does
#           not flag the stack pointer
pub tag Unresolved: u8 {
    alloc: allocator.Error;
    unstated;
    file;
    register: Missing;
    kinds:    u16;
    word:     rf.Id;
    floats:   rf.Id;
    coverage: rf.Id;
    kept:     rf.Id;
    home:     rf.Id;
}

# a row's registers resolved against a selection of its register file
# ---
# context:   the build's context, whose view of the row's file the row is
#            resolved through, which must outlive it
# passing:   the argument registers
# returning: the result registers
# preserved: every register a callee preserves, wholly or in part, sorted.
#            a callee saves each it writes whole
# partial:   the preserved registers the row keeps in part under the
#            selection, sorted, each also clobbered
# reserved:  the reserved registers, sorted
# clobbered: the registers a call under the row leaves undefined, sorted:
#            every register the selection holds that is neither wholly
#            preserved nor reserved nor masc's zero or program counter
# carrier:   the register carrying an indirect result's address, when the
#            row names one
# returned:  the register a callee hands that address back in, when named
# count:     the register a variadic caller sets its count in, when named
# link:      the register a call leaves its return address in, when named
# pointer:   the frame pointer register, when the row has one
# stack:     the stack pointer register, when the row homes it in one
pub rec Registers {
    context:   *core_state.Context;
    passing:   Banks;
    returning: Banks;
    preserved: Slice[rf.Id];
    partial:   Slice[rf.Id];
    reserved:  Slice[rf.Id];
    clobbered: Slice[rf.Id];
    carrier:   opt[rf.Id];
    returned:  opt[rf.Id];
    count:     opt[rf.Id];
    link:      opt[rf.Id];
    pointer:   opt[rf.Id];
    stack:     opt[rf.Id];
}

# a row resolved for a target, once per build
# ---
# a:         the allocator its storage came from
# row:       the row
# registers: its registers resolved against the build's selection, none for
#            a row with no register file, which resolves with no selection
pub rec Resolved {
    a:         *allocator.Allocator;
    row:       *Convention;
    registers: opt[Registers];
}

# a resolved row's registers, nil for a row with no register file. a
# register machine's build always holds them, as its open refuses a row
# with none
pub fun held(r: *Resolved) *Registers {
    if (sel r.registers.some) { ret ?r.registers.some; }
    ret nil;
}

# the registers of the first bank of a kind, empty when the list has none
pub fun bank(b: *Banks, kind: rf.Kind) Slice[rf.Id] {
    var i: usize = 0;
    for (i < b.banks.size) {
        val k: Bank = b.banks.data[i];
        if (k.kind == kind) { ret Slice[rf.Id]{data: ?b.registers.data[k.first::usize], size: k.count::usize}; }
        i = i + 1;
    }
    ret Slice[rf.Id]{data: nil, size: 0};
}

# the width in bits of a register through the selection, none when its scale
# is unfixed
pub fun width(r: *Registers, reg: rf.Id) opt[u64] {
    val w: res[opt[u64], rf.Absent] = rf.width(r.context.view, reg);
    if (sel w.err) { ret opt[u64].none{}; }
    ret w.ok;
}

fun admit(regs: *rf.Available, reg: rf.Id) err[Unresolved] {
    val held: err[rf.Absent] = rf.admitted(regs, reg);
    if (sel held.err) { ret err[Unresolved].err{Unresolved.register{Missing{register: reg, absent: held.err}}}; }
    ret err[Unresolved].ok{};
}

fun optional(regs: *rf.Available, reg: opt[rf.Id]) res[opt[rf.Id], Unresolved] {
    if (sel reg.none) { ret res[opt[rf.Id], Unresolved].ok{opt[rf.Id].none{}}; }
    val held: err[Unresolved] = admit(regs, reg.some);
    if (sel held.err) { ret res[opt[rf.Id], Unresolved].err{held.err}; }
    ret res[opt[rf.Id], Unresolved].ok{reg};
}

fun ids(a: *allocator.Allocator, regs: *rf.Available, list: Slice[rf.Id]) res[Slice[rf.Id], Unresolved] {
    var i: usize = 0;
    for (i < list.size) {
        val held: err[Unresolved] = admit(regs, list.data[i]);
        if (sel held.err) { ret res[Slice[rf.Id], Unresolved].err{held.err}; }
        i = i + 1;
    }
    val copied: res[Slice[rf.Id], allocator.Error] = slice.copy[rf.Id](a, list);
    if (sel copied.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{copied.err}}; }
    ret res[Slice[rf.Id], Unresolved].ok{copied.ok};
}

fun sorted(a: *allocator.Allocator, regs: *rf.Available, list: Slice[rf.Id]) res[Slice[rf.Id], Unresolved] {
    val r: res[Slice[rf.Id], Unresolved] = ids(a, regs, list);
    if (sel r.err)     { ret r; }
    if (r.ok.size > 1) { sort.sort[rf.Id](r.ok.data, r.ok.size); }
    ret r;
}

fun release_ids(a: *allocator.Allocator, s: Slice[rf.Id]) {
    if (s.size != 0) { allocator.deallocate[rf.Id](a, s.data, s.size); }
}

fun release_banks(a: *allocator.Allocator, b: Banks) {
    release_ids(a, b.registers);
    if (b.banks.size != 0) { allocator.deallocate[Bank](a, b.banks.data, b.banks.size); }
}

# group a list's registers by class, a counting sort over the file's classes
# that keeps the list's order within each class
fun group(a: *allocator.Allocator, file: *rf.File, regs: *rf.Available, list: Slice[rf.Id]) res[Banks, Unresolved] {
    var out: Banks = Banks{registers: Slice[rf.Id]{data: nil, size: 0}, banks: Slice[Bank]{data: nil, size: 0}};
    if (list.size == 0) { ret res[Banks, Unresolved].ok{out}; }
    val listed: res[Slice[rf.Id], Unresolved] = ids(a, regs, list);
    if (sel listed.err) { ret res[Banks, Unresolved].err{listed.err}; }
    val picked:  Slice[rf.Id]               = listed.ok;
    val classes: usize                      = file.class_count::usize;
    val counted: res[*u32, allocator.Error] = allocator.zallocate[u32](a, classes * 2);
    if (sel counted.err) {
        release_ids(a, picked);
        ret res[Banks, Unresolved].err{Unresolved.alloc{counted.err}};
    }
    val count: *u32 = counted.ok;
    val start: *u32 = ?counted.ok[classes];
    fin { allocator.deallocate[u32](a, count, classes * 2); }
    var used: usize = 0;
    var i:    usize = 0;
    for (i < picked.size) {
        val c: usize = rf.class_of(picked.data[i])::usize;
        if (count[c] == 0) { used = used + 1; }
        count[c] = count[c] + 1;
        i        = i + 1;
    }
    val made: res[*Bank, allocator.Error] = allocator.allocate[Bank](a, used);
    if (sel made.err) {
        release_ids(a, picked);
        ret res[Banks, Unresolved].err{Unresolved.alloc{made.err}};
    }
    val grouped: res[*rf.Id, allocator.Error] = allocator.allocate[rf.Id](a, picked.size);
    if (sel grouped.err) {
        allocator.deallocate[Bank](a, made.ok, used);
        release_ids(a, picked);
        ret res[Banks, Unresolved].err{Unresolved.alloc{grouped.err}};
    }
    out.registers = Slice[rf.Id]{data: grouped.ok, size: picked.size};
    out.banks     = Slice[Bank]{data: made.ok, size: used};
    # banks in the order each class first appears, each starting after the one before
    var next: u32   = 0;
    var b:    usize = 0;
    var seen: [256]u8;
    i = 0;
    for (i < picked.size) {
        val c: u16 = rf.class_of(picked.data[i]);
        if (count[c::usize] != 0) {
            val kind: rf.Kind = file.classes[c].kind;
            if (seen[kind::usize] != 0) {
                release_ids(a, picked);
                release_banks(a, out);
                ret res[Banks, Unresolved].err{Unresolved.kinds{c}};
            }
            seen[kind::usize] = 1;
            out.banks.data[b] = Bank{class: c, kind: kind, first: next, count: count[c::usize]};
            start[c::usize]   = next;
            next              = next + count[c::usize];
            count[c::usize]   = 0;
            b                 = b + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < picked.size) {
        val c: usize = rf.class_of(picked.data[i])::usize;
        out.registers.data[start[c]::usize] = picked.data[i];
        start[c]                            = start[c] + 1;
        i                                   = i + 1;
    }
    release_ids(a, picked);
    ret res[Banks, Unresolved].ok{out};
}

fun holds(s: Slice[rf.Id], reg: rf.Id) bool {
    if (s.size == 0) { ret false; }
    var want: rf.Id               = reg;
    val at:   sort.SearchPosition = sort.binary_search[rf.Id](s.data, s.size, ?want);
    ret sel at.found;
}

fun by_bank(a: **rf.Register, b: **rf.Register) i64 {
    if (a[0].bank < b[0].bank) { ret -1; }
    if (a[0].bank > b[0].bank) { ret 1; }
    ret 0;
}

# whether a row shares storage with a kept row, which are sorted by bank, by
# testing only the kept rows of its bank
fun shares(file: *rf.File, kept: Vector[*rf.Register], row: *rf.Register) bool {
    var lo: usize = 0;
    var hi: usize = kept.len;
    for (lo < hi) {
        val mid: usize = lo + (hi - lo) / 2;
        if (kept.data[mid].bank < row.bank) { lo = mid + 1; }
        or                                  { hi = mid; }
    }
    for (lo < kept.len && kept.data[lo].bank == row.bank) {
        if (rf.overlap(file, row, kept.data[lo])) { ret true; }
        lo = lo + 1;
    }
    ret false;
}

# the registers a call clobbers: every register row the selection holds that
# is not wholly preserved, reserved, zero or the program counter. a row kept
# in part is clobbered too. a row sharing storage with a wholly preserved or
# reserved row is refused, since masc states whether two rows overlap and not
# whether one covers the other
fun clobbers(a: *allocator.Allocator, regs: *rf.Available, kept: Slice[rf.Id], partial: Slice[rf.Id], reserved: Slice[rf.Id]) res[Slice[rf.Id], Unresolved] {
    val file: *rf.File             = regs.file;
    var keep: Vector[*rf.Register] = vector.init[*rf.Register](a);
    var out:  Vector[rf.Id]        = vector.init[rf.Id](a);
    fin {
        vector.dnit[*rf.Register](?keep);
        vector.dnit[rf.Id](?out);
    }
    var i: u32 = 0;
    for (i < file.register_count) {
        val row: *rf.Register = ?file.registers[i];
        val id:  rf.Id        = rf.id_of(row);
        if ((holds(kept, id) && !holds(partial, id)) || holds(reserved, id)) {
            val pushed: res[usize, allocator.Error] = vector.push[*rf.Register](?keep, row);
            if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    if (keep.len > 1) { sort.sort_by[*rf.Register](keep.data, keep.len, by_bank); }
    i = 0;
    for (i < file.register_count) {
        val row:   *rf.Register   = ?file.registers[i];
        val id:    rf.Id          = rf.id_of(row);
        val in:    err[rf.Absent] = rf.admitted(regs, id);
        val whole: bool           = holds(kept, id) && !holds(partial, id);
        if (sel in.ok && (row.flags & (rf.ZERO | rf.PC)) == 0 && !whole && !holds(reserved, id)) {
            if (shares(file, keep, row)) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.coverage{id}}; }
            val pushed: res[usize, allocator.Error] = vector.push[rf.Id](?out, id);
            if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
        }
        i = i + 1;
    }
    if (out.len > 1) { sort.sort[rf.Id](out.data, out.len); }
    val copied: res[Slice[rf.Id], allocator.Error] = slice.copy[rf.Id](a, Slice[rf.Id]{data: out.data, size: out.len});
    if (sel copied.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{copied.err}}; }
    ret res[Slice[rf.Id], Unresolved].ok{copied.ok};
}

# the preserved registers of a row, admitted, sorted
fun kept_ids(a: *allocator.Allocator, regs: *rf.Available, list: Slice[Kept]) res[Slice[rf.Id], Unresolved] {
    var ids_of: Vector[rf.Id] = vector.init[rf.Id](a);
    fin { vector.dnit[rf.Id](?ids_of); }
    var i: usize = 0;
    for (i < list.size) {
        val pushed: res[usize, allocator.Error] = vector.push[rf.Id](?ids_of, list.data[i].register);
        if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
        i = i + 1;
    }
    ret sorted(a, regs, Slice[rf.Id]{data: ids_of.data, size: ids_of.len});
}

# the preserved registers a row keeps in part under the selection, sorted: a
# low part narrower than the register's width there, or of a register whose
# width scales. a low part wider than the register is refused
fun partial_ids(a: *allocator.Allocator, regs: *rf.Available, list: Slice[Kept]) res[Slice[rf.Id], Unresolved] {
    var out: Vector[rf.Id] = vector.init[rf.Id](a);
    fin { vector.dnit[rf.Id](?out); }
    var i: usize = 0;
    for (i < list.size) {
        val k: Kept = list.data[i];
        if (sel k.bits.low) {
            val w:    res[opt[u64], rf.Absent] = rf.width(regs, k.register);
            val low:  u64                      = k.bits.low::u64;
            var part: bool                     = true;
            if (sel w.ok) {
                val fixed: opt[u64] = w.ok;
                if (sel fixed.some) {
                    if (low > fixed.some) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.kept{k.register}}; }
                    part = low < fixed.some;
                }
            }
            if (part) {
                val pushed: res[usize, allocator.Error] = vector.push[rf.Id](?out, k.register);
                if (sel pushed.err) { ret res[Slice[rf.Id], Unresolved].err{Unresolved.alloc{pushed.err}}; }
            }
        }
        i = i + 1;
    }
    ret sorted(a, regs, Slice[rf.Id]{data: out.data, size: out.len});
}

fun carrier_of(r: Carrier) opt[rf.Id] {
    if (sel r.register) { ret opt[rf.Id].some{r.register}; }
    ret opt[rf.Id].none{};
}

fun returned_of(r: Returned) opt[rf.Id] {
    if (sel r.register) { ret opt[rf.Id].some{r.register}; }
    ret opt[rf.Id].none{};
}

fun count_of(c: Count) opt[rf.Id] {
    if (sel c.register) { ret opt[rf.Id].some{c.register}; }
    ret opt[rf.Id].none{};
}

fun link_of(s: Stack) opt[rf.Id] {
    if (!(sel s.memory)) { ret opt[rf.Id].none{}; }
    val l: Link = s.memory.link;
    if (sel l.register) { ret opt[rf.Id].some{l.register}; }
    ret opt[rf.Id].none{};
}

fun pointer_of(s: Stack) opt[rf.Id] {
    if (!(sel s.memory)) { ret opt[rf.Id].none{}; }
    val p: Pointer = s.memory.pointer;
    if (sel p.register) { ret opt[rf.Id].some{p.register.register}; }
    ret opt[rf.Id].none{};
}

fun home_of(s: Stack) opt[rf.Id] {
    if (!(sel s.memory)) { ret opt[rf.Id].none{}; }
    val h: Home = s.memory.pointer_home;
    if (sel h.register) { ret opt[rf.Id].some{h.register}; }
    ret opt[rf.Id].none{};
}

# the stack pointer's home register, which masc must flag the stack pointer
fun homed(regs: *rf.Available, reg: opt[rf.Id]) res[opt[rf.Id], Unresolved] {
    val held_reg: res[opt[rf.Id], Unresolved] = optional(regs, reg);
    if (sel held_reg.err) { ret held_reg; }
    val got: opt[rf.Id] = held_reg.ok;
    if (sel got.none) { ret held_reg; }
    val id:  rf.Id             = got.some;
    val row: opt[*rf.Register] = rf.row_of(regs.file, id);
    if (sel row.none)                     { ret res[opt[rf.Id], Unresolved].err{Unresolved.home{id}}; }
    if ((row.some.flags & rf.STACK) == 0) { ret res[opt[rf.Id], Unresolved].err{Unresolved.home{id}}; }
    ret held_reg;
}

# check each register of a bank of `kind` against a width rule
fun widths(r: *Registers, kind: rf.Kind, bits: u64, exact: bool) opt[rf.Id] {
    val regs: Slice[rf.Id] = bank(?r.passing, kind);
    var i:    usize        = 0;
    for (i < regs.size) {
        val w: opt[u64] = width(r, regs.data[i]);
        if (sel w.none)              { ret opt[rf.Id].some{regs.data[i]}; }
        if (exact && w.some != bits) { ret opt[rf.Id].some{regs.data[i]}; }
        if (!exact && w.some < bits) { ret opt[rf.Id].some{regs.data[i]}; }
        i = i + 1;
    }
    ret opt[rf.Id].none{};
}

fun empty_registers(ctx: *core_state.Context) Registers {
    val none: Slice[rf.Id] = Slice[rf.Id]{data: nil, size: 0};
    val list: Banks        = Banks{registers: none, banks: Slice[Bank]{data: nil, size: 0}};
    ret Registers{
        context:   ctx,
        passing:   list,
        returning: list,
        preserved: none,
        partial:   none,
        reserved:  none,
        clobbered: none,
        carrier:   opt[rf.Id].none{},
        returned:  opt[rf.Id].none{},
        count:     opt[rf.Id].none{},
        link:      opt[rf.Id].none{},
        pointer:   opt[rf.Id].none{},
        stack:     opt[rf.Id].none{},
    };
}

fun release_registers(a: *allocator.Allocator, r: *Registers) {
    release_banks(a, r.passing);
    release_banks(a, r.returning);
    release_ids(a, r.preserved);
    release_ids(a, r.partial);
    release_ids(a, r.reserved);
    release_ids(a, r.clobbered);
    @r = empty_registers(r.context);
}

fun lost(a: *allocator.Allocator, r: *Registers, why: Unresolved) res[Registers, Unresolved] {
    release_registers(a, r);
    ret res[Registers, Unresolved].err{why};
}

# a row's registers resolved through a context's view of its register file
fun registers(a: *allocator.Allocator, row: *Convention, file: *rf.File, ctx: *core_state.Context) res[Registers, Unresolved] {
    val regs: *rf.Available = ctx.view;
    if (regs.file != file) { ret res[Registers, Unresolved].err{Unresolved.file{}}; }
    var r:       Registers              = empty_registers(ctx);
    val passing: res[Banks, Unresolved] = group(a, file, regs, row.passing);
    if (sel passing.err) { ret res[Registers, Unresolved].err{passing.err}; }
    r.passing = passing.ok;
    val returning: res[Banks, Unresolved] = group(a, file, regs, row.returning);
    if (sel returning.err) { ret lost(a, ?r, returning.err); }
    r.returning = returning.ok;
    val preserved: res[Slice[rf.Id], Unresolved] = kept_ids(a, regs, row.preserved);
    if (sel preserved.err) { ret lost(a, ?r, preserved.err); }
    r.preserved = preserved.ok;
    val partial: res[Slice[rf.Id], Unresolved] = partial_ids(a, regs, row.preserved);
    if (sel partial.err) { ret lost(a, ?r, partial.err); }
    r.partial = partial.ok;
    val reserved: res[Slice[rf.Id], Unresolved] = sorted(a, regs, row.reserved);
    if (sel reserved.err) { ret lost(a, ?r, reserved.err); }
    r.reserved = reserved.ok;
    val clobbered: res[Slice[rf.Id], Unresolved] = clobbers(a, regs, r.preserved, r.partial, r.reserved);
    if (sel clobbered.err) { ret lost(a, ?r, clobbered.err); }
    r.clobbered = clobbered.ok;
    val carrier: res[opt[rf.Id], Unresolved] = optional(regs, carrier_of(row.indirect.carrier));
    if (sel carrier.err) { ret lost(a, ?r, carrier.err); }
    r.carrier = carrier.ok;
    val returned: res[opt[rf.Id], Unresolved] = optional(regs, returned_of(row.indirect.returned));
    if (sel returned.err) { ret lost(a, ?r, returned.err); }
    r.returned = returned.ok;
    val count: res[opt[rf.Id], Unresolved] = optional(regs, count_of(row.variadic.count));
    if (sel count.err) { ret lost(a, ?r, count.err); }
    r.count = count.ok;
    val link: res[opt[rf.Id], Unresolved] = optional(regs, link_of(row.stack));
    if (sel link.err) { ret lost(a, ?r, link.err); }
    r.link = link.ok;
    val pointer: res[opt[rf.Id], Unresolved] = optional(regs, pointer_of(row.stack));
    if (sel pointer.err) { ret lost(a, ?r, pointer.err); }
    r.pointer = pointer.ok;
    val stack: res[opt[rf.Id], Unresolved] = homed(regs, home_of(row.stack));
    if (sel stack.err) { ret lost(a, ?r, stack.err); }
    r.stack = stack.ok;
    if (sel row.word.bits) {
        val off: opt[rf.Id] = widths(?r, rf.GENERAL, row.word.bits::u64, true);
        if (sel off.some) { ret lost(a, ?r, Unresolved.word{off.some}); }
    }
    if (sel row.floats.widest) {
        val off: opt[rf.Id] = widths(?r, rf.FLOAT, row.floats.widest::u64, false);
        if (sel off.some) { ret lost(a, ?r, Unresolved.floats{off.some}); }
    }
    ret res[Registers, Unresolved].ok{r};
}

# resolve a row for a target: a row with a register file through a context's
# view of that file, and a row with none with no selection at all
# ---
# a:   the allocator the resolution's storage comes from
# row: the row
# ctx: the build's context, which must outlive the result, none for a build
#      with no selection
# ret: the resolved row, or why it did not resolve
pub fun resolve(a: *allocator.Allocator, row: *Convention, ctx: opt[*core_state.Context]) res[Resolved, Unresolved] {
    if (!stated(row)) { ret res[Resolved, Unresolved].err{Unresolved.unstated{}}; }
    var r: Resolved = Resolved{a: a, row: row, registers: opt[Registers].none{}};
    if (sel row.file.none) { ret res[Resolved, Unresolved].ok{r}; }
    if (sel ctx.none)      { ret res[Resolved, Unresolved].err{Unresolved.file{}}; }
    val made: res[Registers, Unresolved] = registers(a, row, row.file.some, ctx.some);
    if (sel made.err) { ret res[Resolved, Unresolved].err{made.err}; }
    r.registers = opt[Registers].some{made.ok};
    ret res[Resolved, Unresolved].ok{r};
}

# give back a resolved row's storage
pub fun release(r: *Resolved) {
    if (sel r.registers.some) { release_registers(r.a, ?r.registers.some); }
}

# every row of a set resolved for a target, the default first and then the
# others in order
# ---
# a:    the allocator the storage comes from
# rows: every row
# ctx:  the build's context, none for a build with no selection
# ret:  the resolved rows, given back with `release_rows`, or why one did not
#       resolve, leaving nothing
pub fun resolve_all(a: *allocator.Allocator, rows: *Conventions, ctx: opt[*core_state.Context]) res[Slice[Resolved], Unresolved] {
    val count: usize                           = rows.rows.size + 1;
    val made:  res[*Resolved, allocator.Error] = allocator.allocate[Resolved](a, count);
    if (sel made.err) { ret res[Slice[Resolved], Unresolved].err{Unresolved.alloc{made.err}}; }
    var out: Slice[Resolved] = Slice[Resolved]{data: made.ok, size: 0};
    var i:   usize           = 0;
    for (i < count) {
        var row: *Convention = rows.default;
        if (i > 0) { row = rows.rows.data[i - 1]; }
        val one: res[Resolved, Unresolved] = resolve(a, row, ctx);
        if (sel one.err) {
            release_all(out);
            allocator.deallocate[Resolved](a, made.ok, count);
            ret res[Slice[Resolved], Unresolved].err{one.err};
        }
        out.data[i] = one.ok;
        out.size    = i + 1;
        i           = i + 1;
    }
    ret res[Slice[Resolved], Unresolved].ok{out};
}

fun release_all(s: Slice[Resolved]) {
    var i: usize = 0;
    for (i < s.size) {
        release(?s.data[i]);
        i = i + 1;
    }
}

# give back what `resolve_all` made, through the allocator its rows came from
pub fun release_rows(s: Slice[Resolved]) {
    if (s.size == 0) { ret; }
    val a: *allocator.Allocator = s.data[0].a;
    release_all(s);
    allocator.deallocate[Resolved](a, s.data, s.size);
}

#[testing]
fun placed_nothing(r: *Resolved, call: *Call, asg: *Assignment) err[Refusal] {
    ret err[Refusal].ok{};
}

#[testing]
fun no_tail(r: *Resolved, asg: *Assignment) bool {
    ret false;
}

# a row with no register file, its stack pointer homed in a global, as wasm's
# basic c abi keeps it
#[testing]
val OPERANDS: Convention = Convention{
    name:        "operands",
    abi:         Abi.none{},
    file:        opt[*rf.File].none{},
    classifiers: Classifiers{results: placed_nothing, arguments: placed_nothing},
    word:        Bits.bits{32},
    floats:      Floats.none{},
    passing:     Slice[rf.Id]{data: nil, size: 0},
    returning:   Slice[rf.Id]{data: nil, size: 0},
    preserved:   Slice[Kept]{data: nil, size: 0},
    reserved:    Slice[rf.Id]{data: nil, size: 0},
    stack:       Stack.memory{Frame{align: 16, red: 0, shadow: 0, link: Link.none{}, pointer: Pointer.none{}, pointer_home: Home.global{"__stack_pointer"}}},
    indirect:    Indirect{carrier: Carrier.first{}, returned: Returned.none{}},
    variadic:    Variadic{unnamed: Unnamed.named{}, count: Count.none{}, list: List.pointer{}},
    half:        Half.float{},
    pairs:       Pairs.any{},
    packing:     Packing.natural{},
    tail:        no_tail,
};

test convention__a_row_with_no_register_file_resolves_with_no_selection {
    var a: allocator.Allocator;
    page.make(?a);
    val got: res[Resolved, Unresolved] = resolve(?a, ?OPERANDS, opt[*core_state.Context].none{});
    if (sel got.err) { ret 1; }
    var r: Resolved = got.ok;
    fin { release(?r); }
    if (r.row != ?OPERANDS || sel r.registers.some || held(?r) != nil) { ret 2; }
    # a row with no file names no register, its stack pointer's home included
    var homed: Convention = OPERANDS;
    homed.stack = Stack.memory{Frame{align: 16, red: 0, shadow: 0, link: Link.none{}, pointer: Pointer.none{}, pointer_home: Home.register{rf.make(0, 2)}}};
    if (stated(?homed)) { ret 3; }
    val refused: res[Resolved, Unresolved] = resolve(?a, ?homed, opt[*core_state.Context].none{});
    if (!(sel refused.err && sel refused.err.unstated)) { ret 4; }
    ret 0;
}

#[testing]
val SECOND: Convention = Convention{
    name:        "second",
    abi:         Abi.none{},
    file:        opt[*rf.File].none{},
    classifiers: Classifiers{results: placed_nothing, arguments: placed_nothing},
    word:        Bits.bits{32},
    floats:      Floats.none{},
    passing:     Slice[rf.Id]{data: nil, size: 0},
    returning:   Slice[rf.Id]{data: nil, size: 0},
    preserved:   Slice[Kept]{data: nil, size: 0},
    reserved:    Slice[rf.Id]{data: nil, size: 0},
    stack:       Stack.none{},
    indirect:    Indirect{carrier: Carrier.none{}, returned: Returned.none{}},
    variadic:    Variadic{unnamed: Unnamed.none{}, count: Count.none{}, list: List.none{}},
    half:        Half.float{},
    pairs:       Pairs.any{},
    packing:     Packing.slot{},
    tail:        no_tail,
};

#[testing]
val BESIDE: [1]*Convention = [1]*Convention{?SECOND};
#[testing]
val TWICE:  [2]*Convention = [2]*Convention{?SECOND, ?SECOND};

#[testing]
fun named_view(s: str) View {
    ret View{data: s, len: str_len(s)};
}

# a name picks the default when empty or the default's, another row by its
# own name, and nothing for a name no row has. a set of two rows of one name
# is not stated
test convention__a_name_picks_the_row_its_target_states {
    var rows:  Conventions      = Conventions{default: ?OPERANDS, rows: Slice[*Convention]{data: ?BESIDE[0], size: 1}};
    val empty: opt[*Convention] = pick(?rows, View{data: nil, len: 0});
    val own:   opt[*Convention] = pick(?rows, named_view("operands"));
    val other: opt[*Convention] = pick(?rows, named_view("second"));
    val none:  opt[*Convention] = pick(?rows, named_view("absent"));
    if (!(sel empty.some))       { ret 1; }
    if (empty.some != ?OPERANDS) { ret 1; }
    if (!(sel own.some))         { ret 2; }
    if (own.some != ?OPERANDS)   { ret 2; }
    if (!(sel other.some))       { ret 3; }
    if (other.some != ?SECOND)   { ret 3; }
    if (!(sel none.none))        { ret 4; }
    val at: opt[usize] = position(?rows, named_view("second"));
    if (!(sel at.some))      { ret 5; }
    if (at.some != 1)        { ret 5; }
    if (!stated_rows(?rows)) { ret 6; }
    var twice: Conventions = Conventions{default: ?OPERANDS, rows: Slice[*Convention]{data: ?TWICE[0], size: 2}};
    if (stated_rows(?twice)) { ret 7; }
    var shadowed: Conventions = Conventions{default: ?SECOND, rows: Slice[*Convention]{data: ?BESIDE[0], size: 1}};
    if (stated_rows(?shadowed)) { ret 8; }
    ret 0;
}
