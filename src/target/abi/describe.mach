# describe an ir type as the type view, asking the target's data layout for
# every size, alignment and offset
#
# a handle and a pointer into a logical space are described with no memory
# form, so a convention that passes such values whole can place them. any
# other type layout refuses is refused here as layout refused it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Shape;
use mirl.ir.type.table.Type;
use mirl.target.abi.view;
use mirl.target.abi.view.Elements;
use mirl.target.abi.view.Node;
use mirl.target.abi.view.Real;
use mirl.target.abi.view.Room;
use mirl.target.abi.view.View;
use mirl.target.capability.Extent;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

# why a type was not described
# ---
# alloc:  the allocator refused storage for the nodes
# layout: the data layout refused the type, or it is a function type, which
#         is no value
pub tag Error: u8 {
    alloc:  allocator.Error;
    layout: record.Error;
}

fun refused(e: record.Error) res[Node, Error] {
    ret res[Node, Error].err{Error.layout{e}};
}

fun types(e: table.Error) res[Node, Error] {
    ret refused(record.Error.types{e});
}

# the node of one type at an offset in its parent, its children not yet made
fun make(l: *Layout, space: u32, ty: Type, offset: u64) res[Node, Error] {
    val s: res[Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret types(s.err); }
    var n: Node;
    n.ty     = ty;
    n.offset = offset;
    n.first  = 0;
    n.count  = 0;
    var bare: bool = false;
    if (sel s.ok.integer) { n.shape = view.Shape.integer{s.ok.integer.width}; }
    or (sel s.ok.float) {
        val r: opt[format.Row] = format.row(s.ok.float.format);
        if (sel r.none) { ret types(table.Error.format{s.ok.float.format}); }
        n.shape = view.Shape.float{Real{format: s.ok.float.format, width: r.some.width}};
    }
    or (sel s.ok.pointer) {
        n.shape = view.Shape.pointer{s.ok.pointer.space};
        bare    = true;
    }
    or (sel s.ok.vector) { n.shape = view.Shape.vector{s.ok.vector.lanes}; }
    or (sel s.ok.array) {
        val step: res[u64, record.Error] = layout.stride(l, ty, space);
        if (sel step.err) { ret refused(step.err); }
        n.shape = view.Shape.array{Elements{count: s.ok.array.count, stride: step.ok}};
    }
    or (sel s.ok.structure) { n.shape = view.Shape.structure{}; }
    or (sel s.ok.union)     { n.shape = view.Shape.union{}; }
    or (sel s.ok.handle) {
        n.shape = view.Shape.handle{};
        bare    = true;
    }
    or {
        ret refused(record.Error.unsized{ty});
    }
    val e: res[Extent, record.Error] = layout.extent(l, ty, space);
    if (sel e.ok) {
        n.room = Room.laid{e.ok};
        ret res[Node, Error].ok{n};
    }
    if (sel e.err.unsized && bare) {
        n.room = Room.unsized{};
        ret res[Node, Error].ok{n};
    }
    ret refused(e.err);
}

# make the children of the node at `at`, and theirs, stored together: a
# structure's or union's members, or a vector's lane or an array's element
fun fill(l: *Layout, space: u32, v: *View, a: *allocator.Allocator, at: u32) err[Error] {
    val ty: Type                    = view.node(v, at).ty;
    val s:  res[Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret err[Error].err{Error.layout{record.Error.types{s.err}}}; }
    var members: Slice[Type] = Slice[Type]{data: nil, size: 0};
    var single:  Type;
    var count:   u32         = 1;
    var placed:  bool        = false;
    if (sel s.ok.structure) {
        members = s.ok.structure.members;
        count   = members.size::u32;
        placed  = true;
    }
    or (sel s.ok.union) {
        members = s.ok.union.members;
        count   = members.size::u32;
    }
    or (sel s.ok.vector) { single = s.ok.vector.element; }
    or (sel s.ok.array)  { single = s.ok.array.element; }
    or                   { ret err[Error].ok{}; }
    if (count == 0)      { ret err[Error].ok{}; }
    val room: res[*u64, allocator.Error] = allocator.zallocate[u64](a, count::usize);
    if (sel room.err) { ret err[Error].err{Error.alloc{room.err}}; }
    val offsets: *u64 = room.ok;
    fin { allocator.deallocate[u64](a, offsets, count::usize); }
    if (placed) {
        val laid: err[record.Error] = layout.offsets(l, ty, space, offsets);
        if (sel laid.err) { ret err[Error].err{Error.layout{laid.err}}; }
    }
    val first: u32 = v.nodes.len::u32;
    view.node(v, at).first = first;
    view.node(v, at).count = count;
    var k: u32 = 0;
    for (k < count) {
        var m: Type = single;
        if (members.size != 0) { m = members.data[k::usize]; }
        val c: res[Node, Error] = make(l, space, m, offsets[k::usize]);
        if (sel c.err) { ret err[Error].err{c.err}; }
        val pushed: res[usize, allocator.Error] = vector.push[Node](?v.nodes, c.ok);
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        k = k + 1;
    }
    k = 0;
    for (k < count) {
        val below: err[Error] = fill(l, space, v, a, first + k);
        if (sel below.err) { ret below; }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# describe a type into a view
# ---
# l:     the layout of the module the type is in
# space: the address space whose rules the type is laid out by
# v:     the view the nodes are added to
# ty:    the type
# ret:   the index of its node, or why it was not described
pub fun describe(l: *Layout, space: u32, v: *View, ty: Type) res[u32, Error] {
    val root: res[Node, Error] = make(l, space, ty, 0);
    if (sel root.err) { ret res[u32, Error].err{root.err}; }
    val at:     u32                         = v.nodes.len::u32;
    val pushed: res[usize, allocator.Error] = vector.push[Node](?v.nodes, root.ok);
    if (sel pushed.err) { ret res[u32, Error].err{Error.alloc{pushed.err}}; }
    val below: err[Error] = fill(l, space, v, v.nodes.a, at);
    if (sel below.err) { ret res[u32, Error].err{below.err}; }
    ret res[u32, Error].ok{at};
}
