# describe an ir type as the type view, asking the target's data layout for
# every size, alignment and offset
#
# a handle and a pointer into a logical space are described with no memory
# form, so a convention that passes such values whole can place them. any
# other type layout refuses is refused here as layout refused it.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.ir.type.format;
use mirl.ir.type.table;
use mirl.ir.type.table.Shape;
use mirl.ir.type.table.Type;
use mirl.target.abi.view;
use mirl.target.abi.view.Elements;
use mirl.target.abi.view.Node;
use mirl.target.abi.view.Real;
use mirl.target.abi.view.Room;
use mirl.target.abi.view.View;
use mirl.target.capability.Extent;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

# why a type was not described
# ---
# alloc:  the allocator refused storage for the nodes
# layout: the data layout refused the type, or it is a function type, which
#         is no value
pub tag Error: u8 {
    alloc:  allocator.Error;
    layout: record.Error;
}

# the allocator's refusal `e` stands for, its own or one a case it carries holds
# ---
# e:   the refusal
# ret: the allocator's refusal, none for any other
pub fun starved(e: Error) opt[allocator.Error] {
    if (sel e.alloc) { ret opt[allocator.Error].some{e.alloc}; }
    ret opt[allocator.Error].none{};
}

fun refused(e: record.Error) err[Error] {
    ret err[Error].err{Error.layout{e}};
}

fun types(e: table.Error) err[Error] {
    ret refused(record.Error.types{e});
}

# write the node of one type at an offset in its parent, its children not yet
# made, into `n`
fun make(l: *Layout, space: u32, ty: Type, offset: u64, n: *Node) err[Error] {
    val res_shape_at: res[*Shape, table.Error] = table.shape_at(l.types, ty);
    if (sel res_shape_at.err) { ret types(res_shape_at.err); }
    n.ty     = ty;
    n.offset = offset;
    n.first  = 0;
    n.count  = 0;
    var bare: bool = false;
    if (sel res_shape_at.ok.integer) { n.shape = view.Shape.integer{res_shape_at.ok.integer.width}; }
    or (sel res_shape_at.ok.float) {
        val opt_row: opt[format.Row] = format.row(res_shape_at.ok.float.format);
        if (sel opt_row.none) { ret types(table.Error.format{res_shape_at.ok.float.format}); }
        n.shape = view.Shape.float{Real{format: res_shape_at.ok.float.format, width: opt_row.some.width}};
    }
    or (sel res_shape_at.ok.pointer) {
        n.shape = view.Shape.pointer{res_shape_at.ok.pointer.space};
        bare    = true;
    }
    or (sel res_shape_at.ok.vector) { n.shape = view.Shape.vector{res_shape_at.ok.vector.lanes}; }
    or (sel res_shape_at.ok.array) {
        val res_step: res[u64, record.Error] = layout.stride(l, ty, space);
        if (sel res_step.err) { ret refused(res_step.err); }
        n.shape = view.Shape.array{Elements{count: res_shape_at.ok.array.count, stride: res_step.ok}};
    }
    or (sel res_shape_at.ok.structure) { n.shape = view.Shape.structure{}; }
    or (sel res_shape_at.ok.union)     { n.shape = view.Shape.union{}; }
    or (sel res_shape_at.ok.handle) {
        n.shape = view.Shape.handle{};
        bare    = true;
    }
    or {
        ret refused(record.Error.unsized{ty});
    }
    val res_extent: res[Extent, record.Error] = layout.extent(l, ty, space);
    if (sel res_extent.ok) {
        n.room = Room.laid{res_extent.ok};
        ret err[Error].ok{};
    }
    if (sel res_extent.err.unsized && bare) {
        n.room = Room.unsized{};
        ret err[Error].ok{};
    }
    ret refused(res_extent.err);
}

# a new node at the end of a view, its index
fun add_node(v: *View) res[u32, Error] {
    var none:       Node;
    val at:         u32                         = v.nodes.len::u32;
    val res_pushed: res[usize, allocator.Error] = vector.push[Node](?v.nodes, none);
    if (sel res_pushed.err) { ret res[u32, Error].err{Error.alloc{res_pushed.err}}; }
    ret res[u32, Error].ok{at};
}

# make the children of the node at `at`, and theirs, stored together: a
# structure's or union's members, or a vector's lane or an array's element
fun fill(l: *Layout, space: u32, v: *View, at: u32) err[Error] {
    val ty:           Type                     = view.node(v, at).ty;
    val res_shape_at: res[*Shape, table.Error] = table.shape_at(l.types, ty);
    if (sel res_shape_at.err) { ret err[Error].err{Error.layout{record.Error.types{res_shape_at.err}}}; }
    var members: Slice[Type] = Slice[Type]{data: nil, size: 0};
    var single:  Type;
    var count:   u32         = 1;
    var placed:  bool        = false;
    if (sel res_shape_at.ok.structure) {
        members = res_shape_at.ok.structure.members;
        count   = members.size::u32;
        placed  = true;
    }
    or (sel res_shape_at.ok.union) {
        members = res_shape_at.ok.union.members;
        count   = members.size::u32;
    }
    or (sel res_shape_at.ok.vector) { single = res_shape_at.ok.vector.element; }
    or (sel res_shape_at.ok.array)  { single = res_shape_at.ok.array.element; }
    or                              { ret err[Error].ok{}; }
    if (count == 0)                 { ret err[Error].ok{}; }
    val first: u32 = v.nodes.len::u32;
    view.node(v, at).first = first;
    view.node(v, at).count = count;
    var k: u32 = 0;
    for (k < count) {
        var m:      Type = single;
        var offset: u64  = 0;
        if (members.size != 0) { m = members.data[k::usize]; }
        if (placed) {
            val res_laid: res[u64, record.Error] = layout.offset(l, ty, space, k);
            if (sel res_laid.err) { ret err[Error].err{Error.layout{res_laid.err}}; }
            offset = res_laid.ok;
        }
        val res_slot: res[u32, Error] = add_node(v);
        if (sel res_slot.err) { ret err[Error].err{res_slot.err}; }
        val err_made: err[Error] = make(l, space, m, offset, view.node(v, res_slot.ok));
        if (sel err_made.err) { ret err_made; }
        k = k + 1;
    }
    k = 0;
    for (k < count) {
        val err_below: err[Error] = fill(l, space, v, first + k);
        if (sel err_below.err) { ret err_below; }
        k = k + 1;
    }
    ret err[Error].ok{};
}

# describe a type into a view
# ---
# l:     the layout of the module the type is in
# space: the address space whose rules the type is laid out by
# v:     the view the nodes are added to
# ty:    the type
# ret:   the index of its node, or why it was not described, the view then
#        holding some of its nodes
pub fun describe(l: *Layout, space: u32, v: *View, ty: Type) res[u32, Error] {
    val res_slot: res[u32, Error] = add_node(v);
    if (sel res_slot.err) { ret res_slot; }
    val at:       u32        = res_slot.ok;
    val err_made: err[Error] = make(l, space, ty, 0, view.node(v, at));
    if (sel err_made.err) { ret res[u32, Error].err{err_made.err}; }
    val err_below: err[Error] = fill(l, space, v, at);
    if (sel err_below.err) { ret res[u32, Error].err{err_below.err}; }
    ret res[u32, Error].ok{at};
}
