# the classification of a call site, the one caller of a convention's
# classifiers

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;
use std.collections.vector.Vector;

use mirl.ir.place.Fill;
use mirl.ir.place.Named;
use mirl.ir.type.table;
use mirl.ir.type.table.Extension;
use mirl.ir.type.table.Type;
use mirl.target.abi.convention;
use mirl.target.abi.convention.By;
use mirl.target.abi.convention.Call;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Value;
use mirl.target.abi.describe;
use mirl.target.abi.piece;
use mirl.target.abi.piece.Assignment;
use mirl.target.abi.piece.Passed;
use mirl.target.abi.piece.Refusal;
use mirl.target.abi.view;
use mirl.target.abi.view.View;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.record.Target;

# how a call's language passes aggregates by value
# ---
# platform:  as the convention's c rules place them
# reference: each by reference to a copy the caller makes and owns
pub tag Aggregates: u8 {
    unstated;
    platform;
    reference;
}

# what a call states about its own language
# ---
# aggregates: how it passes aggregates by value
# named:      how many of its arguments are named
pub rec Statement {
    aggregates: Aggregates;
    named:      Named;
}

# a parameter or result of a signature
# ---
# result: whether it is a result, a parameter otherwise
# index:  its position among the parameters or among the results
pub rec Subject {
    result: bool;
    index:  u32;
}

# why a call was not classified
# ---
# alloc:      the allocator refused storage
# unstated:   the target states no convention
# uncarried:  the target's convention has no row yet
# statement:  the call leaves its statement unstated
# signature:  the type is not a function type, which is of this kind
# named:      the call names more arguments than the signature has
# variadic:   the convention has no unnamed arguments
# describe:   a value's type was not described
# refused:    the convention refused the call
# undeclared: the convention fills a piece of this parameter or result as the
#             call declares, and the signature states no extension for it
pub tag Error: u8 {
    alloc: allocator.Error;
    unstated;
    uncarried;
    statement;
    signature: table.Kind;
    named:     u32;
    variadic;
    describe:   describe.Error;
    refused:    Refusal;
    undeclared: Subject;
}

# the convention a target's calls are made under
pub fun of(t: *Target) res[*Convention, Error] {
    if (sel t.convention.row)       { ret res[*Convention, Error].ok{t.convention.row}; }
    if (sel t.convention.uncarried) { ret res[*Convention, Error].err{Error.uncarried{}}; }
    ret res[*Convention, Error].err{Error.unstated{}};
}

fun values(a: *allocator.Allocator, l: *Layout, v: *View, types: Slice[Type], ext: Slice[Extension], named: u64, by: Aggregates, out: *Vector[Value]) err[Error] {
    var i: usize = 0;
    for (i < types.size) {
        val d: res[u32, describe.Error] = describe.describe(l, v, types.data[i]);
        if (sel d.err) { ret err[Error].err{Error.describe{d.err}}; }
        var how: By = By.platform{};
        if (sel by.reference && view.aggregate(view.node(v, d.ok))) { how = By.reference{}; }
        val pushed: res[usize, allocator.Error] = vector.push[Value](out, Value{node: d.ok, named: i::u64 < named, by: how, extension: table.extension(ext, i)});
        if (sel pushed.err) { ret err[Error].err{Error.alloc{pushed.err}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# resolve the pieces a row fills as declared from the extension the signature
# states for their value
fun declare(asg: *Assignment, list: *Vector[Passed], values: Slice[Value], result: bool) err[Error] {
    var i: usize = 0;
    for (i < list.len) {
        val passed: Passed    = list.data[i];
        val ext:    Extension = values.data[i].extension;
        var k:      u32       = passed.first;
        for (k < passed.first + passed.count) {
            val p:    *piece.Piece = ?asg.pieces.data[k];
            var fill: Fill         = p.fill;
            if (sel p.fill.declared) {
                val w: u32 = p.fill.declared;
                if (sel ext.sext) { fill = Fill.sign{w}; }
                or (sel ext.zext) { fill = Fill.zero{w}; }
                or                { ret err[Error].err{Error.undeclared{Subject{result: result, index: i::u32}}}; }
            }
            p.fill = fill;
            k      = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# classify a call site
# ---
# a:         the allocator the assignment's storage comes from
# l:         the layout of the module the signature is in
# r:         the convention, resolved for the target
# signature: the function type the call is made through
# statement: what the call states about its language
# ret:       the assignment, owned by the caller and given back with `dnit`,
#            or why the call was not classified
pub fun classify(a: *allocator.Allocator, l: *Layout, r: *Resolved, signature: Type, statement: Statement) res[Assignment, Error] {
    if (sel statement.aggregates.unstated || sel statement.named.unstated) { ret res[Assignment, Error].err{Error.statement{}}; }
    val s: res[table.Shape, table.Error] = table.shape(l.types, signature);
    if (sel s.err) { ret res[Assignment, Error].err{Error.describe{describe.Error.layout{record.Error.types{s.err}}}}; }
    if (!(sel s.ok.function)) {
        val k: res[table.Kind, table.Error] = table.kind(l.types, signature);
        if (sel k.err) { ret res[Assignment, Error].err{Error.describe{describe.Error.layout{record.Error.types{k.err}}}}; }
        ret res[Assignment, Error].err{Error.signature{k.ok}};
    }
    val params: Slice[Type] = s.ok.function.params;
    var named:  u64         = params.size::u64;
    if (sel statement.named.first) {
        if (statement.named.first::u64 > named)                                    { ret res[Assignment, Error].err{Error.named{statement.named.first}}; }
        if (statement.named.first::u64 < named && sel r.row.variadic.unnamed.none) { ret res[Assignment, Error].err{Error.variadic{}}; }
        named = statement.named.first::u64;
    }

    var v:       View          = View{nodes: vector.init[view.Node](a)};
    var args:    Vector[Value] = vector.init[Value](a);
    var results: Vector[Value] = vector.init[Value](a);
    fin {
        vector.dnit[view.Node](?v.nodes);
        vector.dnit[Value](?args);
        vector.dnit[Value](?results);
    }
    val described: err[Error] = values(a, l, ?v, params, s.ok.function.param_ext, named, statement.aggregates, ?args);
    if (sel described.err) { ret res[Assignment, Error].err{described.err}; }
    val returned: err[Error] = values(a, l, ?v, s.ok.function.results, s.ok.function.result_ext, s.ok.function.results.size::u64, statement.aggregates, ?results);
    if (sel returned.err) { ret res[Assignment, Error].err{returned.err}; }

    var call: Call         = Call{view: ?v, arguments: Slice[Value]{data: args.data, size: args.len}, results: Slice[Value]{data: results.data, size: results.len}};
    var asg:  Assignment   = piece.init(a);
    val back: err[Refusal] = r.row.results(r, ?call, ?asg);
    if (sel back.err) {
        piece.dnit(?asg);
        ret res[Assignment, Error].err{Error.refused{back.err}};
    }
    val placed: err[Refusal] = r.row.arguments(r, ?call, ?asg);
    if (sel placed.err) {
        piece.dnit(?asg);
        ret res[Assignment, Error].err{Error.refused{placed.err}};
    }
    val stated: err[Error] = declare(?asg, ?asg.results, call.results, true);
    if (sel stated.err) {
        piece.dnit(?asg);
        ret res[Assignment, Error].err{stated.err};
    }
    val given: err[Error] = declare(?asg, ?asg.arguments, call.arguments, false);
    if (sel given.err) {
        piece.dnit(?asg);
        ret res[Assignment, Error].err{given.err};
    }
    ret res[Assignment, Error].ok{asg};
}
