# data layout: the size, alignment and member offsets of any ir type
#
# the one routine every reader asks, the front end, the backend and each debug
# producer alike, so no other module computes a size, an alignment or an
# offset. it reads the type table and the target's widths and alignments.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;

use mirl.ir.type.format.BINARY16;
use mirl.ir.type.format.BINARY32;
use mirl.ir.type.format.BINARY64;
use mirl.ir.type.format.Format;
use mirl.ir.type.table;
use mirl.ir.type.table.Shape;
use mirl.ir.type.table.Structure;
use mirl.ir.type.table.Type;
use mirl.target.capability.Fact;
use mirl.target.capability.Fit;
use mirl.target.capability.FloatLayout;
use mirl.target.capability.IntegerLayout;
use mirl.target.capability.Pointer;
use mirl.target.capability.Scalar;
use mirl.target.capability.Space;
use mirl.target.capability.VectorRule;
use mirl.target.record.Error;
use mirl.target.record.Placement;
use mirl.target.record.Target;
use mirl.target.rows.RV64_LINUX;
use mirl.target.rows.by_name;
use mirl.target.rows.row;
use mirl.target.rows.rows;

# the size and alignment of a type
# ---
# size:  bytes it occupies, a multiple of its alignment
# align: the alignment its address keeps, a power of two
pub rec Extent {
    size:  u64;
    align: u64;
}

# the types of one module laid out for one target
# ---
# target: the target the module names
# types:  the module's type table
pub rec Layout {
    target: *Target;
    types:  *table.Table;
}

# the layout of a module's types for a target
pub fun of(target: *Target, types: *table.Table) Layout {
    ret Layout{target: target, types: types};
}

# the size and alignment of a type
# ---
# l:   the layout
# ty:  the type
# ret: its extent, or why it has none on this target
pub fun extent(l: *Layout, ty: Type) res[Extent, Error] {
    ret walk(l, ty);
}

# the size in bytes of a type
pub fun size(l: *Layout, ty: Type) res[u64, Error] {
    val e: res[Extent, Error] = walk(l, ty);
    if (sel e.err) { ret res[u64, Error].err{e.err}; }
    ret res[u64, Error].ok{e.ok.size};
}

# the alignment in bytes of a type
pub fun align(l: *Layout, ty: Type) res[u64, Error] {
    val e: res[Extent, Error] = walk(l, ty);
    if (sel e.err) { ret res[u64, Error].err{e.err}; }
    ret res[u64, Error].ok{e.ok.align};
}

# the byte offset of a member of a structure or union
# ---
# l:      the layout
# ty:     the structure or union
# member: the member's index
# ret:    its offset, answered only when the whole type lays out
pub fun offset(l: *Layout, ty: Type, member: u32) res[u64, Error] {
    val s: res[Shape, table.Error] = table.shape(l.types, ty);
    if (sel s.err) { ret res[u64, Error].err{Error.types{s.err}}; }
    var at: u64 = 0;
    if (sel s.ok.structure) {
        if (member::usize >= s.ok.structure.members.size) { ret res[u64, Error].err{Error.member{member}}; }
        val e: res[Extent, Error] = structure(l, ty, s.ok.structure, member, ?at);
        if (sel e.err) { ret res[u64, Error].err{e.err}; }
        ret res[u64, Error].ok{at};
    }
    if (sel s.ok.union) {
        if (member::usize >= s.ok.union.members.size) { ret res[u64, Error].err{Error.member{member}}; }
        val e: res[Extent, Error] = walk(l, ty);
        if (sel e.err) { ret res[u64, Error].err{e.err}; }
        ret res[u64, Error].ok{0};
    }
    val k: res[table.Kind, table.Error] = table.kind(l.types, ty);
    if (sel k.err) { ret res[u64, Error].err{Error.types{k.err}}; }
    ret res[u64, Error].err{Error.kind{k.ok}};
}

val MAX: u64 = 0xffff_ffff_ffff_ffff;

fun round_up(value: u64, align: u64) opt[u64] {
    val rem: u64 = value % align;
    if (rem == 0)                    { ret opt[u64].some{value}; }
    if (value > MAX - (align - rem)) { ret opt[u64].none{}; }
    ret opt[u64].some{value + (align - rem)};
}

fun unstated(f: Fact) res[Extent, Error] {
    ret res[Extent, Error].err{Error.unstated{f}};
}

fun scalar(s: Scalar) res[Extent, Error] {
    ret res[Extent, Error].ok{Extent{size: s.size, align: s.align}};
}

fun overflow(ty: Type) res[Extent, Error] {
    ret res[Extent, Error].err{Error.overflow{ty}};
}

fun integer(l: *Layout, width: u32) res[Extent, Error] {
    val rows: Slice[IntegerLayout] = l.target.data.integers;
    var i:    usize                = 0;
    for (i < rows.size) {
        if (rows.data[i].width == width) { ret scalar(rows.data[i].scalar); }
        i = i + 1;
    }
    ret unstated(Fact.integer_layout{});
}

fun float(l: *Layout, f: Format) res[Extent, Error] {
    val rows: Slice[FloatLayout] = l.target.data.floats;
    var i:    usize              = 0;
    for (i < rows.size) {
        if (rows.data[i].format != nil && rows.data[i].format.index == f.index) { ret scalar(rows.data[i].scalar); }
        i = i + 1;
    }
    ret unstated(Fact.float_layout{});
}

fun pointer(l: *Layout, ty: Type, space: u32) res[Extent, Error] {
    val rows: Slice[Space] = l.target.caps.widths.pointers;
    var i:    usize        = 0;
    for (i < rows.size) {
        if (rows.data[i].space == space) {
            val p: Pointer = rows.data[i].pointer;
            if (sel p.physical) { ret scalar(p.physical); }
            if (sel p.logical)  { ret res[Extent, Error].err{Error.unsized{ty}}; }
            ret unstated(Fact.pointers{});
        }
        i = i + 1;
    }
    ret res[Extent, Error].err{Error.space{space}};
}

fun vector(l: *Layout, ty: Type, lanes: u32, element: Type) res[Extent, Error] {
    val e: res[Extent, Error] = walk(l, element);
    if (sel e.err)                                      { ret e; }
    if (e.ok.size != 0 && lanes::u64 > MAX / e.ok.size) { ret overflow(ty); }
    val bytes: u64        = e.ok.size * lanes::u64;
    val rule:  VectorRule = l.target.data.vectors;
    if (sel rule.element)     { ret res[Extent, Error].ok{Extent{size: bytes, align: e.ok.align}}; }
    if (!(sel rule.register)) { ret unstated(Fact.vector_rule{}); }
    val fit:    Fit = rule.register;
    var to:     u64 = e.ok.align;
    val narrow: u64 = fit.narrow::u64 / 8;
    if (bytes >= narrow) {
        to = narrow;
        for (to * 2 <= bytes && to * 2 <= fit.widest::u64 / 8) { to = to * 2; }
    }
    val rounded: opt[u64] = round_up(bytes, to);
    if (sel rounded.none) { ret overflow(ty); }
    ret res[Extent, Error].ok{Extent{size: rounded.some, align: to}};
}

fun array(l: *Layout, ty: Type, count: u64, element: Type) res[Extent, Error] {
    val e: res[Extent, Error] = walk(l, element);
    if (sel e.err)                                 { ret e; }
    if (e.ok.size != 0 && count > MAX / e.ok.size) { ret overflow(ty); }
    ret res[Extent, Error].ok{Extent{size: e.ok.size * count, align: e.ok.align}};
}

# lay a structure's members out, by the target's rules or at its stated
# offsets, and give the offset of member `stop` through `at`
fun structure(l: *Layout, ty: Type, s: Structure, stop: u32, at: *u64) res[Extent, Error] {
    var align: u64   = 1;
    var end:   u64   = 0;
    var i:     usize = 0;
    for (i < s.members.size) {
        val e: res[Extent, Error] = walk(l, s.members.data[i]);
        if (sel e.err)          { ret e; }
        if (e.ok.align > align) { align = e.ok.align; }
        var place: u64 = 0;
        if (sel s.offsets.some) {
            place = s.offsets.some.data[i];
            val p: Placement = Placement{member: i::u32, offset: place, align: e.ok.align};
            if (place % e.ok.align != 0) { ret res[Extent, Error].err{Error.misaligned{p}}; }
            if (place < end)             { ret res[Extent, Error].err{Error.overlap{p}}; }
        }
        or {
            val rounded: opt[u64] = round_up(end, e.ok.align);
            if (sel rounded.none) { ret overflow(ty); }
            place = rounded.some;
        }
        if (i == stop::usize)        { @at = place; }
        if (place > MAX - e.ok.size) { ret overflow(ty); }
        end = place + e.ok.size;
        i   = i + 1;
    }
    val total: opt[u64] = round_up(end, align);
    if (sel total.none) { ret overflow(ty); }
    ret res[Extent, Error].ok{Extent{size: total.some, align: align}};
}

fun union_of(l: *Layout, ty: Type, members: Slice[Type]) res[Extent, Error] {
    var align:  u64   = 1;
    var widest: u64   = 0;
    var i:      usize = 0;
    for (i < members.size) {
        val e: res[Extent, Error] = walk(l, members.data[i]);
        if (sel e.err)          { ret e; }
        if (e.ok.align > align) { align = e.ok.align; }
        if (e.ok.size > widest) { widest = e.ok.size; }
        i = i + 1;
    }
    val total: opt[u64] = round_up(widest, align);
    if (sel total.none) { ret overflow(ty); }
    ret res[Extent, Error].ok{Extent{size: total.some, align: align}};
}

# members are interned before their owner, so a walk never meets its own type
fun walk(l: *Layout, ty: Type) res[Extent, Error] {
    val got: res[Shape, table.Error] = table.shape(l.types, ty);
    if (sel got.err) { ret res[Extent, Error].err{Error.types{got.err}}; }
    val s: Shape = got.ok;
    if (sel s.integer) { ret integer(l, s.integer.width); }
    if (sel s.float)   { ret float(l, s.float.format); }
    if (sel s.pointer) { ret pointer(l, ty, s.pointer.space); }
    if (sel s.vector)  { ret vector(l, ty, s.vector.lanes, s.vector.element); }
    if (sel s.array)   { ret array(l, ty, s.array.count, s.array.element); }
    if (sel s.structure) {
        var at: u64 = 0;
        ret structure(l, ty, s.structure, 0, ?at);
    }
    if (sel s.union) { ret union_of(l, ty, s.union.members); }
    ret res[Extent, Error].err{Error.unsized{ty}};
}

fun must(r: res[Type, table.Error], out: *Type) bool {
    if (sel r.err) { ret false; }
    @out = r.ok;
    ret true;
}

fun list(data: *Type, size: usize) Slice[Type] {
    ret Slice[Type]{data: data, size: size};
}

fun bare(t: *table.Table, members: Slice[Type], out: *Type) bool {
    ret must(table.intern(t, Shape.structure{Structure{members: members, offsets: opt[Slice[u64]].none{}}}), out);
}

fun int(t: *table.Table, width: u32, out: *Type) bool {
    ret must(table.intern(t, Shape.integer{table.Integer{width: width}}), out);
}

fun real(t: *table.Table, f: Format, out: *Type) bool {
    ret must(table.intern(t, Shape.float{table.Float{format: f}}), out);
}

fun bytes(t: *table.Table, count: u64, element: Type, out: *Type) bool {
    ret must(table.intern(t, Shape.array{table.Array{count: count, element: element}}), out);
}

val C_CHAR:   u32 = 0;
val C_BOOL:   u32 = 1;
val C_SHORT:  u32 = 2;
val C_INT:    u32 = 3;
val C_LONG:   u32 = 4;
val C_INT128: u32 = 5;
val C_HALF:   u32 = 6;
val C_FLOAT:  u32 = 7;
val C_DOUBLE: u32 = 8;
val C_PTR:    u32 = 9;
val C_BIG:    u32 = 10;
val C_CHAR3:  u32 = 11;
val C_INT3:   u32 = 12;
val C_CHAR5:  u32 = 13;
val GOLD:     u32 = 14;

# a C structure or union and what clang gives it on one target
# ---
# target:  the row it is laid out for, by name
# long:    the width in bits of C's long on that target
# kind:    the structure's slot in the pool, one of the kinds below
# union:   whether it is a union
# count:   how many members
# members: the member types, as C_ codes, GOLD plus an earlier kind, or
#          GOLD plus 6 for the union of kind 6
# size:    sizeof
# align:   _Alignof
# offsets: offsetof each member
#
# the kinds, by their slot:
#   0: struct { char c; int i; }
#   1: struct { char c; double d; short s; }
#   2: struct { _Bool b; void *p; char c; }
#   3: struct { short s; __int128 q; char c; }, absent where clang has no __int128
#   4: struct { char c; kind 0 a; char d[3]; }
#   5: struct { _Float16 h; float f; long l; }
#   6: union { char c; double d; int i[3]; }
#   7: union { short s; char c[5]; }
#   8: struct { char c; kind 6 u; }
#   9: struct { char c; _BitInt(256) w; }, absent where clang has no _BitInt(256)
rec Golden {
    target:  str;
    long:    u32;
    kind:    u32;
    union:   bool;
    count:   u32;
    members: [3]u32;
    size:    u64;
    align:   u64;
    offsets: [3]u64;
}

def Goldens: [50]Golden;

val GOLDEN: Goldens = [50]Golden{
    # x86_64-linux, clang --target=x86_64-linux-gnu
    Golden{target: "x86_64-linux", long: 64, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: "x86_64-linux", long: 64, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-linux", long: 64, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-linux", long: 64, kind: 3, union: false, count: 3, members: [3]u32{C_SHORT, C_INT128, C_CHAR}, size: 48, align: 16, offsets: [3]u64{0, 16, 32}},
    Golden{target: "x86_64-linux", long: 64, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: "x86_64-linux", long: 64, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 16, align: 8, offsets: [3]u64{0, 4, 8}},
    Golden{target: "x86_64-linux", long: 64, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-linux", long: 64, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-linux", long: 64, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: "x86_64-linux", long: 64, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # x86_64-darwin, clang --target=x86_64-apple-darwin
    Golden{target: "x86_64-darwin", long: 64, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: "x86_64-darwin", long: 64, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-darwin", long: 64, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-darwin", long: 64, kind: 3, union: false, count: 3, members: [3]u32{C_SHORT, C_INT128, C_CHAR}, size: 48, align: 16, offsets: [3]u64{0, 16, 32}},
    Golden{target: "x86_64-darwin", long: 64, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: "x86_64-darwin", long: 64, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 16, align: 8, offsets: [3]u64{0, 4, 8}},
    Golden{target: "x86_64-darwin", long: 64, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-darwin", long: 64, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-darwin", long: 64, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: "x86_64-darwin", long: 64, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # x86_64-windows, clang --target=x86_64-pc-windows-msvc
    Golden{target: "x86_64-windows", long: 32, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: "x86_64-windows", long: 32, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-windows", long: 32, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "x86_64-windows", long: 32, kind: 3, union: false, count: 3, members: [3]u32{C_SHORT, C_INT128, C_CHAR}, size: 48, align: 16, offsets: [3]u64{0, 16, 32}},
    Golden{target: "x86_64-windows", long: 32, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: "x86_64-windows", long: 32, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 12, align: 4, offsets: [3]u64{0, 4, 8}},
    Golden{target: "x86_64-windows", long: 32, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-windows", long: 32, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: "x86_64-windows", long: 32, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: "x86_64-windows", long: 32, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
    # x86_64-freestanding, clang --target=x86_64-unknown-none-elf
