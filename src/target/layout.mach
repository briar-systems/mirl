    Golden{target: "riscv64-linux", long: 64, kind: 0, union: false, count: 2, members: [3]u32{C_CHAR, C_INT, 0}, size: 8, align: 4, offsets: [3]u64{0, 4, 0}},
    Golden{target: "riscv64-linux", long: 64, kind: 1, union: false, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_SHORT}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "riscv64-linux", long: 64, kind: 2, union: false, count: 3, members: [3]u32{C_BOOL, C_PTR, C_CHAR}, size: 24, align: 8, offsets: [3]u64{0, 8, 16}},
    Golden{target: "riscv64-linux", long: 64, kind: 3, union: false, count: 3, members: [3]u32{C_SHORT, C_INT128, C_CHAR}, size: 48, align: 16, offsets: [3]u64{0, 16, 32}},
    Golden{target: "riscv64-linux", long: 64, kind: 4, union: false, count: 3, members: [3]u32{C_CHAR, GOLD + 0, C_CHAR3}, size: 16, align: 4, offsets: [3]u64{0, 4, 12}},
    Golden{target: "riscv64-linux", long: 64, kind: 5, union: false, count: 3, members: [3]u32{C_HALF, C_FLOAT, C_LONG}, size: 16, align: 8, offsets: [3]u64{0, 4, 8}},
    Golden{target: "riscv64-linux", long: 64, kind: 6, union: true, count: 3, members: [3]u32{C_CHAR, C_DOUBLE, C_INT3}, size: 16, align: 8, offsets: [3]u64{0, 0, 0}},
    Golden{target: "riscv64-linux", long: 64, kind: 7, union: true, count: 2, members: [3]u32{C_SHORT, C_CHAR5, 0}, size: 6, align: 2, offsets: [3]u64{0, 0, 0}},
    Golden{target: "riscv64-linux", long: 64, kind: 8, union: false, count: 2, members: [3]u32{C_CHAR, GOLD + 6, 0}, size: 24, align: 8, offsets: [3]u64{0, 8, 0}},
    Golden{target: "riscv64-linux", long: 64, kind: 9, union: false, count: 2, members: [3]u32{C_CHAR, C_BIG, 0}, size: 40, align: 8, offsets: [3]u64{0, 8, 0}},
};

test layout__golden {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var pool: [GOLD + 10]Type;
    if (!int(?t, 8, ?pool[C_CHAR]))                                                    { ret 1; }
    if (!int(?t, 1, ?pool[C_BOOL]))                                                    { ret 1; }
    if (!int(?t, 16, ?pool[C_SHORT]))                                                  { ret 1; }
    if (!int(?t, 32, ?pool[C_INT]))                                                    { ret 1; }
    if (!int(?t, 128, ?pool[C_INT128]))                                                { ret 1; }
    if (!real(?t, BINARY16, ?pool[C_HALF]))                                            { ret 1; }
    if (!real(?t, BINARY32, ?pool[C_FLOAT]))                                           { ret 1; }
    if (!real(?t, BINARY64, ?pool[C_DOUBLE]))                                          { ret 1; }
    if (!must(table.intern(?t, Shape.pointer{table.Pointer{space: 0}}), ?pool[C_PTR])) { ret 1; }
    if (!int(?t, 256, ?pool[C_BIG]))                                                   { ret 1; }
    if (!bytes(?t, 3, pool[C_CHAR], ?pool[C_CHAR3]))                                   { ret 1; }
    if (!bytes(?t, 3, pool[C_INT], ?pool[C_INT3]))                                     { ret 1; }
    if (!bytes(?t, 5, pool[C_CHAR], ?pool[C_CHAR5]))                                   { ret 1; }

    var r: u32 = 0;
    for (r < $length_of(Goldens)) {
        val g:  Golden       = GOLDEN[r];
        val tg: opt[*Target] = by_name(g.target);
        if (sel tg.none)                     { ret 2; }
        if (g.kind >= 10)                    { ret 2; }
        if (!int(?t, g.long, ?pool[C_LONG])) { ret 1; }
        var ms: [3]Type;
        var i:  u32 = 0;
        for (i < g.count) {
            ms[i] = pool[g.members[i]];
            i     = i + 1;
        }
        val shape: Shape = Shape.structure{Structure{members: list(?ms[0], g.count::usize), offsets: opt[Slice[u64]].none{}}};
        if (g.union) {
            if (!must(table.intern(?t, Shape.union{table.Union{members: list(?ms[0], g.count::usize)}}), ?pool[GOLD + g.kind])) { ret 2; }
        }
        or {
            if (!must(table.intern(?t, shape), ?pool[GOLD + g.kind])) { ret 2; }
        }
        var l: Layout             = of(tg.some, ?t);
        val e: res[Extent, Error] = extent(?l, pool[GOLD + g.kind]);
        if (sel e.err)                                    { ret 3; }
        if (e.ok.size != g.size || e.ok.align != g.align) { ret 4; }
        i = 0;
        for (i < g.count) {
            val o: res[u64, Error] = offset(?l, pool[GOLD + g.kind], i);
            if (sel o.err)            { ret 5; }
            if (o.ok != g.offsets[i]) { ret 6; }
            i = i + 1;
        }
        r = r + 1;
    }
    var k: usize = 0;
    for (k < rows()) {
        val o: opt[*Target] = row(k);
        if (sel o.none) { ret 7; }
        var seen: bool = false;
        var n:    u32  = 0;
        for (n < $length_of(Goldens)) {
            if (str_equals(GOLDEN[n].target, o.some.name)) { seen = true; }
            n = n + 1;
        }
        if (!seen) { ret 8; }
        k = k + 1;
    }
    ret 0;
}

test layout__refuses_misaligned_offset {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var ms: [2]Type;
    if (!int(?t, 8, ?ms[0]))  { ret 1; }
    if (!int(?t, 32, ?ms[1])) { ret 1; }
    var honoured: [2]u64 = [2]u64{0, 8};
    var refused:  [2]u64 = [2]u64{0, 2};
    var good:     Type;
    var bad:      Type;
    if (!must(table.intern(?t, Shape.structure{Structure{members: list(?ms[0], 2), offsets: opt[Slice[u64]].some{Slice[u64]{data: ?honoured[0], size: 2}}}}), ?good)) { ret 1; }
    if (!must(table.intern(?t, Shape.structure{Structure{members: list(?ms[0], 2), offsets: opt[Slice[u64]].some{Slice[u64]{data: ?refused[0], size: 2}}}}), ?bad))   { ret 1; }

    var target: Target             = RV64_LINUX;
    var l:      Layout             = of(?target, ?t);
    val g:      res[Extent, Error] = extent(?l, good);
    if (sel g.err)                          { ret 2; }
    if (g.ok.size != 12 || g.ok.align != 4) { ret 3; }
    val at: res[u64, Error] = offset(?l, good, 1);
    if (sel at.err) { ret 4; }
    if (at.ok != 8) { ret 4; }

    val b: res[Extent, Error] = extent(?l, bad);
    if (sel b.ok)                { ret 5; }
    if (!(sel b.err.misaligned)) { ret 6; }
    val p: Placement = b.err.misaligned;
    if (p.member != 1 || p.offset != 2 || p.align != 4) { ret 7; }
    val off: res[u64, Error] = offset(?l, bad, 0);
    if (sel off.ok) { ret 8; }
    ret 0;
}

test layout__union_largest_at_strictest {
    var a: allocator.Allocator;
    page.make(?a);
    var t: table.Table = table.init(?a);
    fin { table.dnit(?t); }

    var c:  Type;
    var ms: [3]Type;
    if (!int(?t, 8, ?c))          { ret 1; }
    if (!bytes(?t, 9, c, ?ms[0])) { ret 1; }
    if (!int(?t, 32, ?ms[1]))     { ret 1; }
    if (!int(?t, 16, ?ms[2]))     { ret 1; }
    var u: Type;
    if (!must(table.intern(?t, Shape.union{table.Union{members: list(?ms[0], 3)}}), ?u)) { ret 1; }

    var target: Target             = RV64_LINUX;
    var l:      Layout             = of(?target, ?t);
    val e:      res[Extent, Error] = extent(?l, u);
    if (sel e.err)                          { ret 2; }
    if (e.ok.size != 12 || e.ok.align != 4) { ret 3; }
    var i: u32 = 0;
    for (i < 3) {
        val o: res[u64, Error] = offset(?l, u, i);
        if (sel o.err) { ret 4; }
        if (o.ok != 0) { ret 4; }
        i = i + 1;
    }
    ret 0;
}
