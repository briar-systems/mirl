# the machine code for a target may assume: masc's instruction set for its
# architecture, the target's baseline extensions selected from it, the
# registers they give and the calling convention resolved through them
#
# a machine is made in place and holds pointers into itself, so it is opened
# where it stays and closed there.

use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;

use std.allocator;

use arches: mink.catalog.arch;

use masc.core.diagnostic;
use masc.core.extension;
use rf:   masc.core.register;
use mset: masc.core.set;
use masc.isa.isa;

use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Unresolved;
use mirl.target.record;
use mirl.target.record.Target;

# a target's machine
# ---
# set:        masc's instruction set for the architecture
# selection:  the baseline extensions
# registers:  the registers the selection gives
# convention: the convention resolved through those registers
pub rec Machine {
    set:        *mset.Set;
    selection:  extension.Selection;
    registers:  rf.Available;
    convention: Resolved;
}

# why a target's machine was not made
# ---
# arch:       the target's architecture names no row of mink's catalog
# set:        masc serves the architecture with no instruction set
# baseline:   the target states no baseline extensions
# extensions: masc refused the baseline's spelling
# registers:  the registers of the selection were not viewed
# convention: the target's convention was not found
# unresolved: the convention did not resolve through the registers
pub tag Error: u8 {
    arch: record.Error;
    set;
    baseline;
    extensions: extension.Error;
    registers:  rf.Error;
    convention: call.Error;
    unresolved: Unresolved;
}

# make a target's machine in place
# ---
# m:   where it is made, and stays until `close`
# a:   the allocator its storage comes from
# t:   the target
# ret: ok, or why it was not made, leaving nothing to close
pub fun open(m: *Machine, a: *allocator.Allocator, t: *Target) err[Error] {
    if (!(sel t.baseline.extensions)) { ret err[Error].err{Error.baseline{}}; }
    val arch: res[*arches.Arch, record.Error] = record.arch(t);
    if (sel arch.err) { ret err[Error].err{Error.arch{arch.err}}; }
    val found: opt[*mset.Set] = mset.find(?isa.REGISTRY, arch.ok);
    if (sel found.none) { ret err[Error].err{Error.set{}}; }
    val row: res[*Convention, call.Error] = call.of(t);
    if (sel row.err) { ret err[Error].err{Error.convention{row.err}}; }
    m.set = found.some;
    val chosen: res[extension.Selection, extension.Error] = extension.select(a, m.set.extensions, t.baseline.extensions, diagnostic.START);
    if (sel chosen.err) { ret err[Error].err{Error.extensions{chosen.err}}; }
    m.selection = chosen.ok;
    val viewed: res[rf.Available, rf.Error] = rf.select(a, row.ok.file, ?m.selection);
    if (sel viewed.err) {
        extension.release(?m.selection);
        ret err[Error].err{Error.registers{viewed.err}};
    }
    m.registers = viewed.ok;
    val resolved: res[Resolved, Unresolved] = convention.resolve(a, row.ok, ?m.registers);
    if (sel resolved.err) {
        rf.release(?m.registers);
        extension.release(?m.selection);
        ret err[Error].err{Error.unresolved{resolved.err}};
    }
    m.convention = resolved.ok;
    ret err[Error].ok{};
}

# give back a machine's storage
pub fun close(m: *Machine) {
    convention.release(?m.convention);
    rf.release(?m.registers);
    extension.release(?m.selection);
}
