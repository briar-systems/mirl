# the machine code for a target may assume: masc's instruction set for its
# architecture, the target's baseline extensions and the ones a build adds
# selected from it once, the registers that selection gives and the calling
# convention resolved through it
#
# the selection is a fact of its own: a target with a baseline and no
# convention has a basis and no machine
#
# a machine is made in place and holds pointers into itself, so it is opened
# where it stays and closed there.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;

use std.allocator;
use std.collections.slice.Slice;

use arches: mink.catalog.arch;

use masc.core.diagnostic;
use masc.core.extension;
use rf: masc.core.register;
use masc.core.requirement;
use mset: masc.core.set;
use masc.isa.isa;

use mirl.target.abi.call;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Resolved;
use mirl.target.abi.convention.Unresolved;
use mirl.target.capability.Condition;
use mirl.target.record;
use mirl.target.record.Target;

# the instruction set and selection a build stands on
# ---
# target:    the target it was selected for
# set:       masc's instruction set for the architecture
# selection: the baseline extensions and the ones added, closed over their implications
pub rec Basis {
    target:    *Target;
    set:       *mset.Set;
    selection: extension.Selection;
}

# a target's machine
# ---
# basis:      the one selection every consumer reads
# registers:  the registers the selection gives
# convention: the convention resolved through those registers
pub rec Machine {
    basis:      Basis;
    registers:  rf.Available;
    convention: Resolved;
}

# what a build holds of its target
# ---
# basis:   the build's selection, none when the target states no baseline
# machine: the whole machine, none when the target states no convention. its
#          basis is the one above
pub rec Build {
    basis:   opt[*Basis];
    machine: opt[*Machine];
}

# a build that holds nothing of its target
pub val BARE: Build = Build{basis: opt[*Basis].none{}, machine: opt[*Machine].none{}};

# what a build holds when it opened a whole machine
pub fun whole(m: *Machine) Build {
    ret Build{basis: opt[*Basis].some{?m.basis}, machine: opt[*Machine].some{m}};
}

# why a target's machine was not made
# ---
# arch:       the target's architecture names no row of mink's catalog
# set:        masc serves the architecture with no instruction set
# baseline:   the target states no baseline extensions
# extensions: masc refused the baseline's spelling or the closed selection
# unknown:    a requested extension the instruction set does not know, by name
# registers:  the registers of the selection were not viewed
# convention: the target's convention was not found
# unresolved: the convention did not resolve through the registers
# unstated:   a condition read against the selection is unstated
pub tag Error: u8 {
    arch: record.Error;
    set;
    baseline;
    extensions: extension.Error;
    unknown:    str;
    registers:  rf.Error;
    convention: call.Error;
    unresolved: Unresolved;
    unstated;
}

# masc's instruction set for a target's architecture, whose catalog names the
# extensions a selection for it holds
# ---
# t:   the target
# ret: the set, or why there is none: the architecture names no row of mink's
#      catalog, or masc serves it with no instruction set
pub fun set_of(t: *Target) res[*mset.Set, Error] {
    val arch: res[*arches.Arch, record.Error] = record.arch(t);
    if (sel arch.err) { ret res[*mset.Set, Error].err{Error.arch{arch.err}}; }
    val found: opt[*mset.Set] = mset.find(?isa.REGISTRY, arch.ok);
    if (sel found.none) { ret res[*mset.Set, Error].err{Error.set{}}; }
    ret res[*mset.Set, Error].ok{found.some};
}

# select a target's baseline extensions and the ones a build adds on top of them
# ---
# b:     where it is made, released by `drop`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to drop
pub fun choose(b: *Basis, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    if (!(sel t.baseline.extensions)) { ret err[Error].err{Error.baseline{}}; }
    val found: res[*mset.Set, Error] = set_of(t);
    if (sel found.err) { ret err[Error].err{found.err}; }
    val catalog: *extension.Catalog                      = found.ok.extensions;
    val made:    res[extension.Request, extension.Error] = extension.request(a, catalog, t.baseline.extensions, diagnostic.START);
    if (sel made.err) { ret err[Error].err{Error.extensions{made.err}}; }
    var r:      extension.Request    = made.ok;
    val parsed: err[extension.Error] = catalog.syntax.parse(?r);
    if (sel parsed.err) {
        extension.request_release(?r);
        ret err[Error].err{Error.extensions{parsed.err}};
    }
    var i: usize = 0;
    for (i < added.size) {
        val id: opt[requirement.Id] = extension.lookup(catalog, added.data[i], 0, str_len(added.data[i]));
        if (sel id.none) {
            extension.request_release(?r);
            ret err[Error].err{Error.unknown{added.data[i]}};
        }
        extension.request_add(?r, id.some);
        i = i + 1;
    }
    val chosen: res[extension.Selection, extension.Error] = extension.close(r);
    if (sel chosen.err) { ret err[Error].err{Error.extensions{chosen.err}}; }
    b.target    = t;
    b.set       = found.ok;
    b.selection = chosen.ok;
    ret err[Error].ok{};
}

# give back a basis's storage
pub fun drop(b: *Basis) {
    extension.release(?b.selection);
}

# make a target's machine in place with its baseline extensions
# ---
# m:   where it is made, and stays until `close`
# a:   the allocator its storage comes from
# t:   the target
# ret: ok, or why it was not made, leaving nothing to close
pub fun open(m: *Machine, a: *allocator.Allocator, t: *Target) err[Error] {
    ret open_with(m, a, t, Slice[str]{data: nil, size: 0});
}

# make a target's machine in place with its baseline extensions and the ones
# a build adds, the one entry through which a build extends a selection
# ---
# m:     where it is made, and stays until `close`
# a:     the allocator its storage comes from
# t:     the target
# added: extension names to add to the baseline, as the instruction set names them
# ret:   ok, or why it was not made, leaving nothing to close
pub fun open_with(m: *Machine, a: *allocator.Allocator, t: *Target, added: Slice[str]) err[Error] {
    val chosen: err[Error] = choose(?m.basis, a, t, added);
    if (sel chosen.err) { ret chosen; }
    val row: res[*Convention, call.Error] = call.of(t);
    if (sel row.err) {
        drop(?m.basis);
        ret err[Error].err{Error.convention{row.err}};
    }
    val viewed: res[rf.Available, rf.Error] = rf.select(a, row.ok.file, ?m.basis.selection);
    if (sel viewed.err) {
        drop(?m.basis);
        ret err[Error].err{Error.registers{viewed.err}};
    }
    m.registers = viewed.ok;
    val resolved: res[Resolved, Unresolved] = convention.resolve(a, row.ok, ?m.registers);
    if (sel resolved.err) {
        rf.release(?m.registers);
        drop(?m.basis);
        ret err[Error].err{Error.unresolved{resolved.err}};
    }
    m.convention = resolved.ok;
    ret err[Error].ok{};
}

# give back a machine's storage
pub fun close(m: *Machine) {
    convention.release(?m.convention);
    rf.release(?m.registers);
    drop(?m.basis);
}

# whether a target states a machine: a baseline to select from and a
# convention row to resolve through its registers
pub fun stated(t: *Target) bool {
    ret sel t.baseline.extensions && sel t.convention.row;
}

# open what a build holds of its target in place: the basis of every target
# that states a baseline, and the whole machine around it when the target
# states a convention too
# ---
# m:     where it is made, and stays until `release`. a target with no
#        convention holds only its basis there
# a:     the allocator its storage comes from
# t:     the target
# added: extension names the build adds to the baseline
# ret:   what the build holds, or why what the target states was not made,
#        leaving nothing to release. a target with no baseline holds nothing,
#        and refuses extensions added with nothing to add them to
pub fun build(m: *Machine, a: *allocator.Allocator, t: *Target, added: Slice[str]) res[Build, Error] {
    if (!(sel t.baseline.extensions) && added.size == 0) { ret res[Build, Error].ok{BARE}; }
    if (!(sel t.convention.row)) {
        val chosen: err[Error] = choose(?m.basis, a, t, added);
        if (sel chosen.err) { ret res[Build, Error].err{chosen.err}; }
        ret res[Build, Error].ok{Build{basis: opt[*Basis].some{?m.basis}, machine: opt[*Machine].none{}}};
    }
    val opened: err[Error] = open_with(m, a, t, added);
    if (sel opened.err) { ret res[Build, Error].err{opened.err}; }
    ret res[Build, Error].ok{whole(m)};
}

# give back what `build` opened
pub fun release(h: Build) {
    if (sel h.machine.some) { close(h.machine.some); }
    or (sel h.basis.some)   { drop(h.basis.some); }
}

# whether a capability's condition holds for a build: always, or when the
# build's basis selects the extension it names. with no basis an extension is
# selected by nothing, so only an unconditional one holds
# ---
# b:   the build's basis, none when the build has none
# c:   the condition
# ret: whether it holds, or why it could not be read: it is unstated, or it
#      names an extension the basis's instruction set does not know
pub fun meets(b: opt[*Basis], c: Condition) res[bool, Error] {
    if (sel c.always)       { ret res[bool, Error].ok{true}; }
    if (!(sel c.extension)) { ret res[bool, Error].err{Error.unstated{}}; }
    if (sel b.none)         { ret res[bool, Error].ok{false}; }
    val id: opt[requirement.Id] = extension.lookup(b.some.set.extensions, c.extension, 0, str_len(c.extension));
    if (sel id.none) { ret res[bool, Error].err{Error.unknown{c.extension}}; }
    ret res[bool, Error].ok{extension.has(?b.some.selection, id.some)};
}
