# the example lane: the targets every example program is emitted, listed and
# run for, see doc/machine/emit.md
#
# LANES is the one list of their tuples, each assembled like any other. the
# round trip and emit tests walk it, and `mirl lanes` writes it for
# test/example.sh, which keeps no copy. covering a target is adding its tuple
# here.

use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use masc.core.requirement;
use A: std.allocator;
use std.collections.slice.Slice;
use io: std.io.writer;
use std.io.writer.WriteError;

use mink.catalog.format.Format;

use mirl.ir.module.Tuple;

use mirl.target.abi.call;
use mirl.target.abi.convention.Convention;
use mirl.target.assemble;
use mirl.target.record;
use mirl.target.record.Target;

def Lanes: [4]Tuple;

val LANES: Lanes = [4]Tuple{
    Tuple{arch: View{data: "riscv64", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "lp64d", len: 5}, baseline: View{data: "rv64gc", len: 6}},
    Tuple{arch: View{data: "riscv32", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "ilp32d", len: 6}, baseline: View{data: "rv32gc", len: 6}},
    Tuple{arch: View{data: "x86_64", len: 6}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "sysv64", len: 6}, baseline: View{data: "cmov,cx8,x87,fxsr,mmx,osfxsr,sce,sse,sse2", len: 41}},
    Tuple{arch: View{data: "aarch64", len: 7}, system: View{data: "linux", len: 5}, env: View{data: "gnu", len: 3}, convention: View{data: "aapcs64", len: 7}, baseline: View{data: "armv8-a+fp+simd", len: 15}},
};

# the tuple of every lane target
pub fun lanes() Slice[Tuple] {
    ret Slice[Tuple]{data: ?LANES[0], size: $length_of(Lanes)};
}

# why the lane was not written
# ---
# write:      the writer refused
# assembled:  a lane tuple assembles to no target, the refusal's unmet atoms given back already
# format:     a lane target's system states no object format
# convention: a lane target declares no calling convention
# baseline:   a lane target names no extensions
# spelled:    a lane target's tuple was not spelled
pub tag Error: u8 {
    write:      WriteError;
    assembled:  assemble.Refusal;
    format:     record.Error;
    convention: call.Error;
    baseline;
    spelled: record.Error;
}

# a refusal with the storage it owns given back, so it only names its rule
fun refused(a: *A.Allocator, r: assemble.Refusal) assemble.Refusal {
    discard(a, r);
    if (sel r.requires) {
        var lack: assemble.Unmet = r.requires;
        ret assemble.Refusal.requires{assemble.Unmet{set: lack.set, alternatives: Slice[assemble.Missing]{data: nil, size: 0}, atoms: Slice[requirement.Id]{data: nil, size: 0}}};
    }
    ret r;
}

# give back the storage a refusal owns
fun discard(a: *A.Allocator, r: assemble.Refusal) {
    if (sel r.requires) {
        var lack: assemble.Unmet = r.requires;
        assemble.unmet_release(a, ?lack);
    }
}

# write every lane target, one line each: its derived name, its architecture's
# and its system's rows in mink's catalog, its environment, its baseline as
# masc's selection, its convention's name and its object format's row in
# mink's catalog, separated by single spaces
# ---
# out: the writer of the lines
# a:   the allocator the spellings take, given back
# ret: ok, or why a line was not written
pub fun write(out: *io.Writer, a: *A.Allocator) err[Error] {
    val all: Slice[Tuple] = lanes();
    var i:   usize        = 0;
    for (i < all.size) {
        val made: res[Target, assemble.Refusal] = assemble.assemble(a, all.data[i]);
        if (sel made.err) { ret err[Error].err{Error.assembled{refused(a, made.err)}}; }
        var own: Target = made.ok;
        fin { assemble.release(a, ?own); }
        val t:      *Target                      = ?own;
        val format: res[*Format, record.Error]   = record.format(t);
        val conv:   res[*Convention, call.Error] = call.of(t);
        if (sel format.err)             { ret err[Error].err{Error.format{format.err}}; }
        if (sel conv.err)               { ret err[Error].err{Error.convention{conv.err}}; }
        if (!(sel t.baseline.required)) { ret err[Error].err{Error.baseline{}}; }
        val wrote: res[record.Spelled, record.Error] = record.spell(a, t);
        if (sel wrote.err) { ret err[Error].err{Error.spelled{wrote.err}}; }
        var spelled: record.Spelled = wrote.ok;
        fin { record.unspell(?spelled); }
        val named: err[WriteError] = record.name(out, ?spelled);
        if (sel named.err) { ret err[Error].err{Error.write{named.err}}; }
        val fields: [6]View = [6]View{spelled.tuple.arch, spelled.tuple.system, spelled.tuple.env, spelled.tuple.baseline, view_of(conv.ok.name), view_of(format.ok.name)};
        var k:      usize   = 0;
        for (k < $length_of([6]View)) {
            val before: err[WriteError] = io.write_str(out, " ");
            if (sel before.err) { ret err[Error].err{Error.write{before.err}}; }
            val field: err[WriteError] = io.write_all(out, fields[k].data::*u8, fields[k].len);
            if (sel field.err) { ret err[Error].err{Error.write{field.err}}; }
            k = k + 1;
        }
        val ended: err[WriteError] = io.write_str(out, "\n");
        if (sel ended.err) { ret err[Error].err{Error.write{ended.err}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

fun view_of(s: str) View {
    ret View{data: s, len: str_len(s)};
}
