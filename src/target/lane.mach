# the example lane: the targets every example program is emitted, listed and
# run for, see doc/machine/emit.md
#
# LANES is the one list of them. the round trip and emit tests walk it, and
# `mirl lanes` writes it for test/example.sh, which keeps no copy. covering a
# target is adding its row here.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use T: std.allocator.testing;
use std.collections.slice.Slice;
use io: std.io.writer;
use std.io.writer.WriteError;

use mink.catalog.format.Format;

use mirl.ir.text.sink;
use mirl.slice;

use mirl.target.abi.call;
use mirl.target.abi.convention.Convention;
use mirl.target.record;
use mirl.target.record.Target;
use mirl.target.register.riscv.rows.RV32_LINUX;
use mirl.target.register.riscv.rows.RV64_LINUX;

# the directory of the example programs, each a body for a register machine
#[testing]
pub val EXAMPLES: str = "test/example/";

def Lanes: [2]*Target;

val LANES: Lanes = [2]*Target{?RV64_LINUX, ?RV32_LINUX};

# every lane target
pub fun lanes() Slice[*Target] {
    ret Slice[*Target]{data: ?LANES[0], size: $length_of(Lanes)};
}

# why the lane was not written
# ---
# write:      the writer refused
# format:     a lane target states no one object format
# convention: a lane target declares no calling convention
# baseline:   a lane target names no extensions
pub tag Error: u8 {
    write:      WriteError;
    format:     record.Error;
    convention: call.Error;
    baseline;
}

# write every lane target, one line each: its name, its architecture's row in
# mink's catalog, its baseline as masc's selection, its convention's name and
# its object format's row in mink's catalog, separated by single spaces
# ---
# out: the writer of the lines
# ret: ok, or why a line was not written
pub fun write(out: *io.Writer) err[Error] {
    val all: Slice[*Target] = lanes();
    var i:   usize          = 0;
    for (i < all.size) {
        val t:      *Target                      = all.data[i];
        val format: res[*Format, record.Error]   = record.format(t);
        val conv:   res[*Convention, call.Error] = call.of(t);
        if (sel format.err)               { ret err[Error].err{Error.format{format.err}}; }
        if (sel conv.err)                 { ret err[Error].err{Error.convention{conv.err}}; }
        if (!(sel t.baseline.extensions)) { ret err[Error].err{Error.baseline{}}; }
        val fields: [5]str = [5]str{t.name, t.arch, t.baseline.extensions, conv.ok.name, format.ok.name};
        var k:      usize  = 0;
        for (k < $length_of([5]str)) {
            var sep: str = " ";
            if (k + 1 == $length_of([5]str)) { sep = "\n"; }
            val field: err[WriteError] = io.write_str(out, fields[k]);
            if (sel field.err) { ret err[Error].err{Error.write{field.err}}; }
            val after: err[WriteError] = io.write_str(out, sep);
            if (sel after.err) { ret err[Error].err{Error.write{after.err}}; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# write an example's text as built for a lane target: its first line, its
# target line, names the target, and the rest is unchanged
# ---
# out:  the writer of the copy
# text: the example's text
# t:    the lane target
# ret:  whether the copy was written, false for a text whose first line is no target line or a writer that refused
#[testing]
pub fun retarget(out: *io.Writer, text: View, t: *Target) bool {
    val head: str   = "target \"";
    val n:    usize = str_len(head);
    if (text.len < n) { ret false; }
    var i: usize = 0;
    for (i < n) {
        if (text.data[i] != head[i]) { ret false; }
        i = i + 1;
    }
    for (i < text.len && text.data[i] != '\n') { i = i + 1; }
    if (i == text.len) { ret false; }
    val opened: err[WriteError] = io.write_str(out, head);
    if (sel opened.err) { ret false; }
    val named: err[WriteError] = io.write_str(out, t.name);
    if (sel named.err) { ret false; }
    val closed: err[WriteError] = io.write_str(out, "\"");
    if (sel closed.err) { ret false; }
    val rest: err[WriteError] = io.write_all(out, (?text.data[i])::*u8, text.len - i);
    if (sel rest.err) { ret false; }
    ret true;
}

# the lane writes one line for each lane target, led by its name
test lane__writes_a_line_for_each_target {
    var t:    T.Testing;
    val made: err[A.Error] = T.make(?t);
    if (sel made.err) { ret 1; }
    var lines: sink.Sink = sink.init(T.allocator_of(?t));
    fin { sink.dnit(?lines); }
    var out:     io.Writer  = sink.writer(?lines);
    val written: err[Error] = write(?out);
    if (sel written.err) { ret 2; }
    val text: View           = sink.view(?lines);
    val all:  Slice[*Target] = lanes();
    var at:   usize          = 0;
    var i:    usize          = 0;
    for (i < all.size) {
        val name: str   = all.data[i].name;
        val n:    usize = str_len(name);
        if (at + n >= text.len)                                                             { ret 3; }
        if (!slice.same_view(View{data: ?text.data[at], len: n}, View{data: name, len: n})) { ret 3; }
        if (text.data[at + n] != ' ')                                                       { ret 3; }
        for (at < text.len && text.data[at] != '\n') { at = at + 1; }
        at = at + 1;
        i  = i + 1;
    }
    if (at != text.len || all.size == 0) { ret 4; }
    ret 0;
}
