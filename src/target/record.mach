# the target record: which architecture and system, and what they declare
#
# a target is the tuple of its architecture and system, rows of mink's
# catalogs, its calling convention, a row of mirl's, and its baseline, as masc
# spells the selection. it adds only the facts code generation reads. its name
# is derived from the tuple for diagnostics and never looked up: a target is
# found by its tuple, and every decision reads a declaration.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use arches: mink.catalog.arch;
use mink.catalog.format.Format;
use systems: mink.catalog.os;
use mink.fail.Fail;

use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.ir.module.Tuple;

use mirl.ir.type.table;
use mirl.ir.type.table.Kind;
use mirl.ir.type.table.Type;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Declared;
use mirl.target.address.Addresses;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Data;
use mirl.target.capability.Fact;

# one target
# ---
# arch:       the name of its row in mink's architecture catalog
# system:     the name of its row in mink's system catalog
# caps:       the code generation declarations
# data:       the facts data layout reads
# convention: the calling convention its calls are made under
# baseline:   the extensions every machine of the target has
# addresses:  how its code reaches an address
pub rec Target {
    arch:       str;
    system:     str;
    caps:       Capabilities;
    data:       Data;
    convention: Declared;
    baseline:   Baseline;
    addresses:  Addresses;
}

# the extensions every machine of a target has, which code for it may assume
# ---
# unstated:   nothing, a defect of the row
# uncarried:  the target names no extensions yet, so no convention resolves
# extensions: as masc's catalog of the architecture's instruction set spells
#             a selection
pub tag Baseline: u8 {
    unstated;
    uncarried;
    extensions: str;
}

# a member of a structure and where it was asked to be
# ---
# member: the member's index
# offset: its stated offset
# align:  the alignment the target requires of it
pub rec Placement {
    member: u32;
    offset: u64;
    align:  u64;
}

# why a target or its data layout refused a request
# ---
# types:      the type table refused a read
# unstated:   the target leaves this fact unstated or states it inconsistently
# arch:       the architecture names no row of mink's catalog
# system:     the system names no row of mink's catalog, or does not run the
#             architecture
# space:      a pointer into an address space the target has no row for
# unsized:    a type with no representation in memory on this target
# misaligned: a stated offset the member's alignment does not divide
# overlap:    a stated offset inside the member before it
# member:     a member index past the type's member count
# kind:       an offset asked of a type that is not a structure or union
# overflow:   a type whose size does not fit in 64 bits
# formats:    the system states no one object format, but this many
pub tag Error: u8 {
    types:      table.Error;
    unstated:   Fact;
    arch:       Fail;
    system:     Fail;
    space:      u32;
    unsized:    Type;
    misaligned: Placement;
    overlap:    Placement;
    member:     u32;
    kind:       Kind;
    overflow:   Type;
    formats:    usize;
}

# the architecture row a target names
pub fun arch(t: *Target) res[*arches.Arch, Error] {
    val r: res[*arches.Arch, Fail] = arches.by_name(t.arch);
    if (sel r.err) { ret res[*arches.Arch, Error].err{Error.arch{r.err}}; }
    ret res[*arches.Arch, Error].ok{r.ok};
}

# the system row a target names
pub fun system(t: *Target) res[*systems.Os, Error] {
    val r: res[*systems.Os, Fail] = systems.by_name(t.system);
    if (sel r.err) { ret res[*systems.Os, Error].err{Error.system{r.err}}; }
    ret res[*systems.Os, Error].ok{r.ok};
}

# the one object format a target's system writes
pub fun format(t: *Target) res[*Format, Error] {
    val system: res[*systems.Os, Error] = system(t);
    if (sel system.err)              { ret res[*Format, Error].err{system.err}; }
    if (system.ok.format_count != 1) { ret res[*Format, Error].err{Error.formats{system.ok.format_count}}; }
    ret res[*Format, Error].ok{system.ok.formats[0]};
}

# whether a target is complete: its architecture and system rows of mink's
# catalogs with the system running the architecture, every
# declaration and layout fact stated, and its convention, baseline and
# addresses declared
# ---
# t:   the target
# ret: ok, or the first thing it leaves out
pub fun declared(t: *Target) err[Error] {
    val a: res[*arches.Arch, Error] = arch(t);
    if (sel a.err) { ret err[Error].err{a.err}; }
    val o: res[*systems.Os, Error] = system(t);
    if (sel o.err) { ret err[Error].err{o.err}; }
    val h: res[*systems.Host, Fail] = systems.host(o.ok, a.ok);
    if (sel h.err) { ret err[Error].err{Error.system{h.err}}; }
    val c: opt[Fact] = capability.missing(?t.caps);
    if (sel c.some) { ret err[Error].err{Error.unstated{c.some}}; }
    val d: opt[Fact] = capability.unlaid(?t.data);
    if (sel d.some)                                                                                         { ret err[Error].err{Error.unstated{d.some}}; }
    if (sel t.convention.unstated)                                                                          { ret err[Error].err{Error.unstated{Fact.convention{}}}; }
    if (sel t.convention.row && (t.convention.row == nil || !convention.stated(t.convention.row)))          { ret err[Error].err{Error.unstated{Fact.convention{}}}; }
    if (sel t.baseline.unstated)                                                                            { ret err[Error].err{Error.unstated{Fact.baseline{}}}; }
    if (sel t.baseline.extensions && (t.baseline.extensions == nil || str_len(t.baseline.extensions) == 0)) { ret err[Error].err{Error.unstated{Fact.baseline{}}}; }
    if (sel t.addresses.unstated)                                                                           { ret err[Error].err{Error.unstated{Fact.addresses{}}}; }
    ret err[Error].ok{};
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

# a target's tuple, each part as its owner spells it, an empty part one the
# target does not carry. the views are of the target's own strings
pub fun tuple(t: *Target) Tuple {
    var convention: View = View{data: nil, len: 0};
    if (sel t.convention.row) {
        if (t.convention.row != nil) { convention = view_of(t.convention.row.name); }
    }
    var baseline: View = View{data: nil, len: 0};
    if (sel t.baseline.extensions) { baseline = view_of(t.baseline.extensions); }
    ret Tuple{arch: view_of(t.arch), system: view_of(t.system), convention: convention, baseline: baseline};
}

# whether two targets are one tuple: the same architecture and system rows of
# mink's catalogs, the same convention row and the same baseline selection
pub fun same(a: *Target, b: *Target) bool {
    val aa: res[*arches.Arch, Error] = arch(a);
    val ba: res[*arches.Arch, Error] = arch(b);
    if (sel aa.err)     { ret false; }
    if (sel ba.err)     { ret false; }
    if (aa.ok != ba.ok) { ret false; }
    val ao: res[*systems.Os, Error] = system(a);
    val bo: res[*systems.Os, Error] = system(b);
    if (sel ao.err)     { ret false; }
    if (sel bo.err)     { ret false; }
    if (ao.ok != bo.ok) { ret false; }
    ret same_convention(a.convention, b.convention) && same_baseline(a.baseline, b.baseline);
}

fun same_convention(a: Declared, b: Declared) bool {
    if (sel a.row) {
        if (sel b.row) { ret a.row == b.row; }
        ret false;
    }
    if (sel a.uncarried) { ret sel b.uncarried; }
    ret sel b.unstated;
}

fun same_baseline(a: Baseline, b: Baseline) bool {
    if (sel a.extensions) {
        if (sel b.extensions) { ret str_equals(a.extensions, b.extensions); }
        ret false;
    }
    if (sel a.uncarried) { ret sel b.uncarried; }
    ret sel b.unstated;
}

# write a target's name, derived from its tuple for diagnostics: the parts it
# carries in order, joined by `-`
pub fun name(w: *io.Writer, t: *Target) err[WriteError] {
    val tp:    Tuple   = tuple(t);
    val parts: [4]View = [4]View{tp.arch, tp.system, tp.convention, tp.baseline};
    var first: bool    = true;
    var i:     usize   = 0;
    for (i < 4) {
        if (parts[i].len != 0) {
            if (!first) {
                val dash: err[WriteError] = io.write_str(w, "-");
                if (sel dash.err) { ret dash; }
            }
            val part: err[WriteError] = io.write_all(w, parts[i].data::*u8, parts[i].len);
            if (sel part.err) { ret part; }
            first = false;
        }
        i = i + 1;
    }
    ret err[WriteError].ok{};
}
