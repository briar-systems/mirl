# the target record: which architecture and system, and what they declare
#
# a target is the tuple of rows the lower layers own: its architecture,
# system and environment, rows of mink's catalogs, its calling convention, a
# member of the architecture's convention axis, and its baseline, a
# requirement over the atoms of masc's catalog of the architecture's
# instruction set. it is assembled from those parts by
# mirl.target.assemble, every fact it holds read from the axis that owns it,
# and adds only the facts code generation reads. its text tuple and name are
# spelled from those rows for text and diagnostics, and every decision reads
# a declaration.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.char.char;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use masc.core.diagnostic;
use masc.core.extension;
use masc.core.requirement;
use mset:       masc.core.set;
use core_state: masc.core.state;
use masc.isa.isa;
use arches: mink.catalog.arch;
use mink.catalog.format.Format;
use systems: mink.catalog.os;
use mink.catalog.trait.Choice;

use io: std.io.writer;
use std.io.writer.WriteError;

use mirl.ir.module.Tuple;

use mirl.ir.type.table;
use mirl.ir.type.table.Kind;
use mirl.ir.type.table.Type;
use mirl.target.abi.convention;
use mirl.target.abi.convention.Convention;
use mirl.target.abi.convention.Conventions;
use mirl.target.abi.convention.Declared;
use mirl.target.abi.convention.Unadmitted;
use mirl.target.address.Addresses;
use mirl.target.capability;
use mirl.target.capability.Capabilities;
use mirl.target.capability.Condition;
use mirl.target.capability.Data;
use mirl.target.capability.Fact;
use mirl.target.capability.Held;
use mirl.target.capability.Pointer;
use mirl.target.capability.Scalar;
use mirl.target.capability.Space;

# one target, read-only from its assembly until its release so compiles may share it (see doc/ir/target.md, Sharing a target)
# ---
# arch:       its row in mink's architecture catalog
# system:     its row in mink's system catalog
# env:        the system's environment it runs under, none for a system run
#             with none
# caps:       the code generation declarations
# data:       the facts data layout reads
# convention: the calling conventions its calls are made under
# baseline:   the extensions and state every machine of the target has
# addresses:  how its code reaches an address
# held:       the storage its assembly took, given back by its release
pub rec Target {
    arch:       *arches.Arch;
    system:     *systems.System;
    env:        opt[*systems.Env];
    caps:       Capabilities;
    data:       Data;
    convention: Declared;
    baseline:   Baseline;
    addresses:  Addresses;
    held:       Storage;
}

# the storage an assembled target holds
# ---
# atoms:        the atoms of its baseline's one alternative
# alternatives: that alternative
# others:       its convention rows beside the default
# spelling:     an uncarried baseline's spelling and its terminator
pub rec Storage {
    atoms:        Slice[requirement.Id];
    alternatives: Slice[requirement.Alternative];
    others:       Slice[*Convention];
    spelling:     Slice[char];
}

# the extensions and state every machine of a target has, which code for it
# may assume
# ---
# unstated:  nothing, a defect of the target
# uncarried: masc serves the architecture with no set yet, so the baseline is
#            this spelling, read by no catalog, and no convention resolves
# required:  one alternative over the atoms of masc's catalog of the
#            architecture's instruction set, stated through its extension
#            handles: the extensions and state values every machine holds,
#            and those none holds. it holds no atom at a level of the set's
#            core alone, as wasm's mvp
pub tag Baseline: u8 {
    unstated;
    uncarried: str;
    required:  requirement.Requirement;
}

# a member of a structure and where it was asked to be
# ---
# member: the member's index
# offset: its stated offset
# align:  the alignment the target requires of it
pub rec Placement {
    member: u32;
    offset: u64;
    align:  u64;
}

# a pointer in memory the addressing model the build states gives no
# representation
# ---
# pointer: the pointer type
# model:   the model, mink's choice of it
pub rec Unmodelled {
    pointer: Type;
    model:   *Choice;
}

# why a target or its data layout refused a request
# ---
# types:      the type table refused a read
# unstated:   the target leaves this fact unstated or states it inconsistently
# arch:       the target names no architecture row
# system:     the target names no system row
# runs:       the system runs the architecture under no host for the target's
#             environment
# space:      a pointer into an address space the target has no row for
# unsized:    a type with no representation in memory on this target
# unmodelled: a pointer with no representation in memory under the
#             addressing model the build states, named by the model
# misaligned: a stated offset the member's alignment does not divide
# overlap:    a stated offset inside the member before it
# member:     a member index past the type's member count
# kind:       an offset asked of a type that is not a structure or union
# overflow:   a type whose size does not fit in 64 bits
# formats:    the system states no object format
# stride:     an array whose stated stride its alignment does not divide, or
#             that is shorter than its element
# ruled:      a type the rules of the space it is asked in do not lay out,
#             such as a union or a vector of five lanes under std140
# set:        masc serves the architecture with no instruction set
# baseline:   the target states no baseline to select
# selection:  masc refused the baseline's selection
# spelling:   the storage of a spelling was refused
# abi:        a convention row's psABI name gives no row of mink's catalog for
#             the target's architecture, as ilp32e on riscv32
pub tag Error: u8 {
    types:    table.Error;
    unstated: Fact;
    arch;
    system;
    runs;
    space:      u32;
    unsized:    Type;
    unmodelled: Unmodelled;
    misaligned: Placement;
    overlap:    Placement;
    member:     u32;
    kind:       Kind;
    overflow:   Type;
    formats;
    stride: Type;
    ruled:  Type;
    set;
    baseline;
    selection: extension.Error;
    spelling:  A.Error;
    abi:       Unadmitted;
}

# the object format a target's system writes, the default one of the formats
# mink's row states, which it lists first
pub fun format(t: *Target) res[*Format, Error] {
    if (t.system == nil)            { ret res[*Format, Error].err{Error.system{}}; }
    if (t.system.format_count == 0) { ret res[*Format, Error].err{Error.formats{}}; }
    ret res[*Format, Error].ok{t.system.formats[0]};
}

# whether a target's baseline is stated: uncarried, or one alternative over
# the set's atoms. an alternative of no atoms is the set's core alone, as
# wasm's mvp, and is stated
fun stated_baseline(b: Baseline) bool {
    if (!(sel b.required))                           { ret sel b.uncarried; }
    if (b.required.len != 1 || b.required.at == nil) { ret false; }
    val alt: requirement.Alternative = b.required.at[0];
    ret (alt.all.len == 0 || alt.all.at != nil) && (alt.none.len == 0 || alt.none.at != nil);
}

# whether an atom of `ids` is one `other` rules out
fun crosses(ids: requirement.Ids, other: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        var k: u32 = 0;
        for (k < other.len) {
            if (ids.at[i] == other.at[k]) { ret true; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret false;
}

# whether extension `from` of a catalog implies `to`, itself or through the
# extensions it implies
fun reaches(catalog: *extension.Catalog, from: requirement.Id, to: requirement.Id) bool {
    if (from == to)            { ret true; }
    if (from >= catalog.count) { ret false; }
    val implies: requirement.Ids = catalog.extensions[from].implies;
    var i:       u32             = 0;
    for (i < implies.len) {
        if (reaches(catalog, implies.at[i], to)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether a selection holding every atom of `a` and of `b` holds `to`
fun brings(catalog: *extension.Catalog, a: requirement.Ids, b: requirement.Ids, to: requirement.Id) bool {
    var i: u32 = 0;
    for (i < a.len) {
        if (reaches(catalog, a.at[i], to)) { ret true; }
        i = i + 1;
    }
    i = 0;
    for (i < b.len) {
        if (reaches(catalog, b.at[i], to)) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether an atom of `ids` is a value of the axis of `p` other than its own
fun other_value(set: *mset.Set, ids: requirement.Ids, p: core_state.Placed) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        val q: opt[core_state.Placed] = core_state.place(set.extensions, ?set.states, ids.at[i]);
        if (sel q.some) {
            if (q.some.axis == p.axis && q.some.value != p.value) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether two atoms of `a` and `b` are two values of one state axis, which no
# context holds together
fun axis_split(set: *mset.Set, a: requirement.Ids, b: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < a.len) {
        val p: opt[core_state.Placed] = core_state.place(set.extensions, ?set.states, a.at[i]);
        if (sel p.some) {
            if (other_value(set, a, p.some) || other_value(set, b, p.some)) { ret true; }
        }
        i = i + 1;
    }
    i = 0;
    for (i < b.len) {
        val p: opt[core_state.Placed] = core_state.place(set.extensions, ?set.states, b.at[i]);
        if (sel p.some) {
            if (other_value(set, b, p.some)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether an atom of `ids` is one a selection holding every atom of `a` and
# `b` holds
fun brought(catalog: *extension.Catalog, a: requirement.Ids, b: requirement.Ids, ids: requirement.Ids) bool {
    var i: u32 = 0;
    for (i < ids.len) {
        if (ids.at[i] < catalog.count && brings(catalog, a, b, ids.at[i])) { ret true; }
        i = i + 1;
    }
    ret false;
}

# whether no context meets both alternatives, as the set states: one holds an
# atom the other rules out, they hold two values of one state axis, or the
# extensions they hold imply one the other rules out or a pair the catalog
# says conflict. the implications are read without the catalog's
# combinations, so two alternatives only a combination parts are not found
# apart, which refuses rows that may meet together and never admits them
fun apart(set: *mset.Set, x: requirement.Alternative, y: requirement.Alternative) bool {
    val catalog: *extension.Catalog = set.extensions;
    if (crosses(x.all, y.none) || crosses(y.all, x.none))                                 { ret true; }
    if (axis_split(set, x.all, y.all))                                                    { ret true; }
    if (brought(catalog, x.all, y.all, x.none) || brought(catalog, x.all, y.all, y.none)) { ret true; }
    var k: u32 = 0;
    for (k < catalog.conflict_count) {
        val pair: extension.Conflict = catalog.conflicts[k];
        if (brings(catalog, x.all, y.all, pair.a) && brings(catalog, x.all, y.all, pair.b)) { ret true; }
        k = k + 1;
    }
    ret false;
}

# whether every alternative of one requirement is apart from every
# alternative of the other
fun parted(set: *mset.Set, x: requirement.Requirement, y: requirement.Requirement) bool {
    var i: u32 = 0;
    for (i < x.len) {
        var k: u32 = 0;
        for (k < y.len) {
            if (!apart(set, x.at[i], y.at[k])) { ret false; }
            k = k + 1;
        }
        i = i + 1;
    }
    ret true;
}

# whether no build meets both conditions: each requires a requirement, and
# the two are parted
fun disjoint(set: *mset.Set, a: Condition, b: Condition) bool {
    if (sel a.requires) {
        if (sel b.requires) { ret parted(set, a.requires, b.requires); }
    }
    ret false;
}

# the first condition fact a target breaks: a condition naming an atom past
# masc's catalog of its architecture's instruction set and its state values,
# or two rows of one format whose conditions some build meets together. an
# architecture masc serves with no set has conditions no build meets, since
# no basis opens, and rows of one format refused as overlapping, since no
# catalog parts them
fun conditioned(t: *Target) opt[Fact] {
    val found: opt[*mset.Set] = set_of(t);
    if (sel found.some) {
        val atoms: u32 = core_state.atom_count(found.some.extensions, ?found.some.states);
        if (!capability.conditions_within(?t.caps, atoms)) { ret opt[Fact].some{Fact.conditions{}}; }
        if (!capability.data_within(?t.data, atoms))       { ret opt[Fact].some{Fact.conditions{}}; }
    }
    if (!(sel t.caps.formats.held)) { ret opt[Fact].none{}; }
    val list: Slice[Held] = t.caps.formats.held;
    var i:    usize       = 0;
    for (i < list.size) {
        var k: usize = i + 1;
        for (k < list.size) {
            if (list.data[i].format.index == list.data[k].format.index) {
                if (sel found.none)                                                        { ret opt[Fact].some{Fact.formats{}}; }
                if (!disjoint(found.some, list.data[i].condition, list.data[k].condition)) { ret opt[Fact].some{Fact.formats{}}; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    ret opt[Fact].none{};
}

# whether a target is complete: its architecture and system rows of mink's
# catalogs with the system running the architecture under its environment,
# every declaration and layout fact stated, every condition over masc's atoms
# with the rows of each format under disjoint conditions, and its convention,
# baseline and addresses declared
# ---
# t:   the target
# ret: ok, or the first thing it leaves out
pub fun declared(t: *Target) err[Error] {
    if (t.arch == nil)                          { ret err[Error].err{Error.arch{}}; }
    if (t.system == nil)                        { ret err[Error].err{Error.system{}}; }
    if (!systems.runs(t.system, t.env, t.arch)) { ret err[Error].err{Error.runs{}}; }
    val c: opt[Fact] = capability.missing(?t.caps);
    if (sel c.some) { ret err[Error].err{Error.unstated{c.some}}; }
    var k: usize = 0;
    for (k < t.caps.widths.pointers.size) {
        val p: Pointer = pointer_of(t, ?t.caps.widths.pointers.data[k]);
        if (sel p.unstated) { ret err[Error].err{Error.unstated{Fact.pointers{}}}; }
        k = k + 1;
    }
    val cond: opt[Fact] = conditioned(t);
    if (sel cond.some) { ret err[Error].err{Error.unstated{cond.some}}; }
    val d: opt[Fact] = capability.unlaid(?t.data);
    if (sel d.some)                { ret err[Error].err{Error.unstated{d.some}}; }
    if (sel t.convention.unstated) { ret err[Error].err{Error.unstated{Fact.convention{}}}; }
    if (sel t.convention.rows) {
        var rows: Conventions = t.convention.rows;
        val held: err[Error]  = conventions_declared(t, ?rows);
        if (sel held.err) { ret held; }
    }
    if (!stated_baseline(t.baseline)) { ret err[Error].err{Error.unstated{Fact.baseline{}}}; }
    if (sel t.addresses.unstated)     { ret err[Error].err{Error.unstated{Fact.addresses{}}}; }
    ret err[Error].ok{};
}

# whether a target's convention rows are each stated, of distinct names, and
# each a psABI row mink states for the target's architecture
fun conventions_declared(t: *Target, rows: *Conventions) err[Error] {
    if (!convention.stated_rows(rows)) { ret err[Error].err{Error.unstated{Fact.convention{}}}; }
    var i: usize = 0;
    for (i <= rows.rows.size) {
        var row: *Convention = rows.default;
        if (i > 0) { row = rows.rows.data[i - 1]; }
        val abi: res[opt[*arches.Abi], Unadmitted] = convention.abi_row(row, t.arch);
        if (sel abi.err) { ret err[Error].err{Error.abi{abi.err}}; }
        i = i + 1;
    }
    ret err[Error].ok{};
}

# how a pointer into address space row `s` of target `t` is held, an
# address of the width mink's row of its architecture states for one the row
# leaves to the architecture, held at its size. unstated when the target
# names no architecture row or the row states no width
pub fun pointer_of(t: *Target, s: *Space) Pointer {
    val p: Pointer = s.pointer;
    if (!(sel p.architecture)) { ret p; }
    if (t.arch == nil)         { ret Pointer.unstated{}; }
    val bytes: opt[u8] = arches.pointer_bytes(t.arch);
    if (sel bytes.none) { ret Pointer.unstated{}; }
    ret Pointer.physical{Scalar{size: bytes.some::u64, align: bytes.some::u64}};
}

# masc's instruction set for a target's architecture, whose catalog the
# atoms of its baseline are rows of, none when masc serves it with none
pub fun set_of(t: *Target) opt[*mset.Set] {
    if (t.arch == nil) { ret opt[*mset.Set].none{}; }
    ret mset.find(?isa.REGISTRY, t.arch);
}

# a request over `catalog` holding every atom a target's baseline holds, each
# extension enabled with what it implies and each state value stated
# ---
# a:       the allocator its storage comes from
# t:       the target
# catalog: the catalog of the set of the target's architecture
# ret:     the request, released by its close or `extension.request_release`,
#          or why it was not made
pub fun request(a: *A.Allocator, t: *Target, catalog: *extension.Catalog) res[extension.Request, Error] {
    if (!stated_baseline(t.baseline)) { ret res[extension.Request, Error].err{Error.baseline{}}; }
    if (!(sel t.baseline.required))   { ret res[extension.Request, Error].err{Error.baseline{}}; }
    val made: res[extension.Request, extension.Error] = extension.request(a, catalog, "", diagnostic.START);
    if (sel made.err) { ret res[extension.Request, Error].err{Error.selection{made.err}}; }
    var r:   extension.Request = made.ok;
    val all: requirement.Ids   = t.baseline.required.at[0].all;
    var i:   u32               = 0;
    for (i < all.len) {
        extension.request_add(?r, all.at[i]);
        i = i + 1;
    }
    ret res[extension.Request, Error].ok{r};
}

# the closed selection of a target's baseline in the catalog of its
# architecture's set, released by `extension.release`
pub fun selection(a: *A.Allocator, t: *Target) res[extension.Selection, Error] {
    val found: opt[*mset.Set] = set_of(t);
    if (sel found.none) { ret res[extension.Selection, Error].err{Error.set{}}; }
    val made: res[extension.Request, Error] = request(a, t, found.some.extensions);
    if (sel made.err) { ret res[extension.Selection, Error].err{made.err}; }
    val closed: res[extension.Selection, extension.Error] = extension.close(made.ok);
    if (sel closed.err) { ret res[extension.Selection, Error].err{Error.selection{closed.err}}; }
    ret res[extension.Selection, Error].ok{closed.ok};
}

# whether two closed selections of one catalog hold the same extensions and
# state the same state values
pub fun same_selection(a: *extension.Selection, b: *extension.Selection) bool {
    if (!extension.within(a, b) || !extension.within(b, a)) { ret false; }
    if (a.stated.len != b.stated.len)                       { ret false; }
    var i: u32 = 0;
    for (i < a.stated.len) {
        if (!extension.has(b, a.stated.at[i])) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the spelling of a tuple's environment part for a system run under no
# environment, which is a stated part and never an empty one
pub val NONE: str = "none";

# a target's tuple as text, each part as its owner spells it, its baseline
# spelled by masc into storage of its own
# ---
# tuple:    the tuple, its baseline a view of `baseline`
# baseline: the spelling of the baseline's selection in its catalog's syntax
pub rec Spelled {
    tuple:    Tuple;
    baseline: vector.Vector[u8];
}

fun view_of(s: str) View {
    if (s == nil) { ret View{data: nil, len: 0}; }
    ret View{data: s, len: str_len(s)};
}

# spell a target's tuple, released by `unspell`
# ---
# a:   the allocator the spelling's storage comes from
# t:   the target
# ret: the spelled tuple, or why it was not spelled, leaving nothing
pub fun spell(a: *A.Allocator, t: *Target) res[Spelled, Error] {
    if (t.arch == nil)   { ret res[Spelled, Error].err{Error.arch{}}; }
    if (t.system == nil) { ret res[Spelled, Error].err{Error.system{}}; }
    var out: Spelled = Spelled{tuple: Tuple{arch: view_of(t.arch.name), system: view_of(t.system.name), env: view_of(NONE), convention: View{data: nil, len: 0}, baseline: View{data: nil, len: 0}}, baseline: vector.init[u8](a)};
    if (sel t.env.some) { out.tuple.env = view_of(t.env.some.name); }
    if (sel t.convention.rows) {
        if (t.convention.rows.default != nil) { out.tuple.convention = view_of(t.convention.rows.default.name); }
    }
    or (sel t.convention.uncarried) { out.tuple.convention = view_of(t.convention.uncarried); }
    if (sel t.baseline.uncarried)   { out.tuple.baseline = view_of(t.baseline.uncarried); }
    if (!(sel t.baseline.required)) { ret res[Spelled, Error].ok{out}; }
    val chosen: res[extension.Selection, Error] = selection(a, t);
    if (sel chosen.err) { ret res[Spelled, Error].err{chosen.err}; }
    var s:       extension.Selection = chosen.ok;
    val written: err[A.Error]        = extension.spell(?s, ?out.baseline);
    extension.release(?s);
    if (sel written.err) {
        vector.dnit[u8](?out.baseline);
        ret res[Spelled, Error].err{Error.spelling{written.err}};
    }
    out.tuple.baseline = View{data: out.baseline.data::*char, len: out.baseline.len};
    ret res[Spelled, Error].ok{out};
}

# give back a spelled tuple's storage
pub fun unspell(s: *Spelled) {
    vector.dnit[u8](?s.baseline);
}

# whether two targets are one tuple: the same architecture, system and
# environment rows of mink's catalogs, the same convention row and the same
# baseline requirement
pub fun same(a: *Target, b: *Target) bool {
    if (a.arch != b.arch || a.system != b.system) { ret false; }
    if (sel a.env.some) {
        if (!(sel b.env.some))        { ret false; }
        if (a.env.some != b.env.some) { ret false; }
    }
    or (sel b.env.some) { ret false; }
    ret same_convention(a.convention, b.convention) && same_baseline(a.baseline, b.baseline);
}

fun same_convention(a: Declared, b: Declared) bool {
    if (sel a.rows) {
        if (!(sel b.rows))                                                            { ret false; }
        if (a.rows.default != b.rows.default || a.rows.rows.size != b.rows.rows.size) { ret false; }
        var i: usize = 0;
        for (i < a.rows.rows.size) {
            if (a.rows.rows.data[i] != b.rows.rows.data[i]) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel a.uncarried) {
        if (!(sel b.uncarried)) { ret false; }
        ret str_equals(a.uncarried, b.uncarried);
    }
    ret sel b.unstated;
}

fun same_ids(a: requirement.Ids, b: requirement.Ids) bool {
    if (a.len != b.len) { ret false; }
    var i: u32 = 0;
    for (i < a.len) {
        if (a.at[i] != b.at[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

# whether two baselines state the same requirement, alternative by
# alternative and atom by atom
fun same_baseline(a: Baseline, b: Baseline) bool {
    if (sel a.required) {
        if (!(sel b.required))                { ret false; }
        if (a.required.len != b.required.len) { ret false; }
        var i: u32 = 0;
        for (i < a.required.len) {
            if (!same_ids(a.required.at[i].all, b.required.at[i].all))   { ret false; }
            if (!same_ids(a.required.at[i].none, b.required.at[i].none)) { ret false; }
            i = i + 1;
        }
        ret true;
    }
    if (sel a.uncarried) {
        if (!(sel b.uncarried)) { ret false; }
        ret str_equals(a.uncarried, b.uncarried);
    }
    ret sel b.unstated;
}

# write a target's name, derived from its spelled tuple for diagnostics: the
# parts it carries in order, joined by `-`
pub fun name(w: *io.Writer, s: *Spelled) err[WriteError] {
    val tp:    Tuple   = s.tuple;
    val parts: [5]View = [5]View{tp.arch, tp.system, tp.env, tp.convention, tp.baseline};
    var first: bool    = true;
    var i:     usize   = 0;
    for (i < 5) {
        if (parts[i].len != 0) {
            if (!first) {
                val dash: err[WriteError] = io.write_str(w, "-");
                if (sel dash.err) { ret dash; }
            }
            val part: err[WriteError] = io.write_all(w, parts[i].data::*u8, parts[i].len);
            if (sel part.err) { ret part; }
            first = false;
        }
        i = i + 1;
    }
    ret err[WriteError].ok{};
}

# why a target's name was not written
# ---
# spelled: its tuple was not spelled
# write:   the writer refused
pub tag Naming: u8 {
    spelled: Error;
    write:   WriteError;
}

# write a target's name, its tuple spelled in storage given back
pub fun write_name(w: *io.Writer, a: *A.Allocator, t: *Target) err[Naming] {
    val made: res[Spelled, Error] = spell(a, t);
    if (sel made.err) { ret err[Naming].err{Naming.spelled{made.err}}; }
    var s: Spelled = made.ok;
    fin { unspell(?s); }
    val wrote: err[WriteError] = name(w, ?s);
    if (sel wrote.err) { ret err[Naming].err{Naming.write{wrote.err}}; }
    ret err[Naming].ok{};
}
