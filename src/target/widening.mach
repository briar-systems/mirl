# the selection each function of one module is compiled under
#
# a function may name extensions past the build's (`#[extensions]`), and its
# code is then legalised, selected and allocated under the build's selection
# widened by them, never past it for a function that names none. the module
# compile owns one table per module, made before the schedule runs: each
# distinct set of names a function with a body states is opened once, as a
# basis of its own (`mirl.target.basis.widen_basis`), in the order of the
# first function naming it, and every function names the basis it stands on.
# the schedule reads a function's basis through it, so a legalisation that
# asks what the build holds or computes asks it of the function's selection,
# and the back end compiles each function under the same one. a pass that
# names an extension for a function, as the timing switch does for the
# extension its switch needs, scopes the function again here, so the table
# stays the one place a function's selection is read. a family whose back end
# compiles no function past the build's opens none, and every function then
# stands on the build's basis.

use std.types.bool.bool;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mirl.base.slice;
use mirl.ir.id.Function;
use mirl.ir.module.Module;
use mirl.target.basis;
use mirl.target.basis.Basis;
use target_record: mirl.target.record;

# no set past the build's, a function on the build's basis
pub val BUILD_WIDE: u32 = 0xffffffff;

# a function whose extensions were not opened
# ---
# function: the function
# error:    why
pub rec Unwidened {
    function: Function;
    error:    basis.Error;
}

# the selection each function of a module stands on
# ---
# a:      the allocator the bases take
# build:  the build's basis, none for a build with none, where no function widens
# opens:  whether the family's back end compiles a function past the build's
# bases:  each distinct set of extensions a function names past the build's, opened
# scopes: per function of the module, the index of its basis in `bases`,
#         BUILD_WIDE for the build's
pub rec Widenings {
    a:      *allocator.Allocator;
    build:  opt[*Basis];
    opens:  bool;
    bases:  vector.Vector[*Basis];
    scopes: vector.Vector[u32];
}

# the table of a module, every function with a body and extensions past the
# build's scoped, in place of `w`
# ---
# w:     where it is made, released by `dnit`
# a:     the allocator its storage comes from
# build: the build's basis, none for a build with none
# opens: whether the family's back end compiles a function past the build's
# m:     the module
# ret:   ok, or the first function whose extensions were not opened, with
#        what `dnit` gives back
pub fun init(w: *Widenings, a: *allocator.Allocator, build: opt[*Basis], opens: bool, m: *Module) err[Unwidened] {
    w.a      = a;
    w.build  = build;
    w.opens  = opens;
    w.bases  = vector.init[*Basis](a);
    w.scopes = vector.init[u32](a);
    val err_filled: err[allocator.Error] = slice.fill[u32](?w.scopes, m.functions.len, BUILD_WIDE);
    if (sel err_filled.err) { ret err[Unwidened].err{Unwidened{function: 0, error: basis.Error.alloc{err_filled.err}}}; }
    var k: usize = 0;
    for (k < m.functions.len) {
        val err_scoped: err[Unwidened] = scope(w, m, k::u32);
        if (sel err_scoped.err) { ret err_scoped; }
        k = k + 1;
    }
    ret err[Unwidened].ok{};
}

# scope function `f` of `m` by the extensions it names now, opening its set
# where no basis of the table holds it, as `init` scopes each and a pass that
# names an extension for `f` scopes it again
pub fun scope(w: *Widenings, m: *Module, f: Function) err[Unwidened] {
    if (f::usize >= w.scopes.len) { ret err[Unwidened].ok{}; }
    w.scopes.data[f] = BUILD_WIDE;
    val names: Slice[View] = m.functions.data[f].data.extensions;
    if (!w.opens || names.size == 0 || m.functions.data[f].body.blocks.len == 0) { ret err[Unwidened].ok{}; }
    if (sel w.build.none)                                                        { ret err[Unwidened].ok{}; }
    val res_made: res[*Basis, allocator.Error] = allocator.allocate[Basis](w.a, 1);
    if (sel res_made.err) { ret err[Unwidened].err{Unwidened{function: f, error: basis.Error.alloc{res_made.err}}}; }
    val b:          *Basis           = res_made.ok;
    val err_opened: err[basis.Error] = basis.widen_basis(b, w.a, w.build.some, names);
    if (sel err_opened.err) {
        allocator.deallocate[Basis](w.a, b, 1);
        ret err[Unwidened].err{Unwidened{function: f, error: err_opened.err}};
    }
    if (target_record.same_selection(?b.selection, ?w.build.some.selection)) {
        basis_free(w, b);
        ret err[Unwidened].ok{};
    }
    var i: usize = 0;
    for (i < w.bases.len) {
        if (target_record.same_selection(?b.selection, ?w.bases.data[i].selection)) {
            basis_free(w, b);
            w.scopes.data[f] = i::u32;
            ret err[Unwidened].ok{};
        }
        i = i + 1;
    }
    val res_pushed: res[usize, allocator.Error] = vector.push[*Basis](?w.bases, b);
    if (sel res_pushed.err) {
        basis_free(w, b);
        ret err[Unwidened].err{Unwidened{function: f, error: basis.Error.alloc{res_pushed.err}}};
    }
    w.scopes.data[f] = (w.bases.len - 1)::u32;
    ret err[Unwidened].ok{};
}

# the basis function `f` stands on: its set's, or the build's
pub fun of(w: *Widenings, f: Function) opt[*Basis] {
    val at: u32 = index_of(w, f);
    if (at == BUILD_WIDE) { ret w.build; }
    ret opt[*Basis].some{w.bases.data[at]};
}

# the index in `bases` of the set function `f` stands on, BUILD_WIDE for the build's
pub fun index_of(w: *Widenings, f: Function) u32 {
    if (f::usize >= w.scopes.len) { ret BUILD_WIDE; }
    ret w.scopes.data[f];
}

fun basis_free(w: *Widenings, b: *Basis) {
    basis.dnit(b);
    allocator.deallocate[Basis](w.a, b, 1);
}

# give back every basis the table opened and its per function table
pub fun dnit(w: *Widenings) {
    var i: usize = 0;
    for (i < w.bases.len) {
        basis_free(w, w.bases.data[i]);
        i = i + 1;
    }
    vector.dnit[*Basis](?w.bases);
    vector.dnit[u32](?w.scopes);
}
