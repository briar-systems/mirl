# the secret globals of a module, as the constant-time walk and the verifier read them
#
# a global states its secrecy (`mirl.ir.global.Secrecy`): the whole global or
# the byte ranges of an aggregate's secret fields and elements. every walk of
# a constant-time function's code seeds each secret range of every global of
# its module as the bytes of a global off its symbol's address
# (`walk.Seed.symbol`), secret for the whole function. the walk names a symbol
# by a handle its caller gives, one per function and global of the module
# here (`handle`), the handle each site of the code names too, so the walk
# places an access of a global wherever its address is formed. an address the
# ir forms from a global's, through constant offsets, members and indexes, is
# placed here (`reached`), which the verifier holds a load of secret bytes to
# a secret result by and a callee's reads are known to be of secret globals by.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Range;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.type.table;
use mirl.ir.type.table.DEFAULT_SPACE;
use mirl.ir.type.table.Type;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;
use mirl.target.steps;

use rf: masc.core.register;
use masc.walk;

# the walk's handle of a function or global of the module, never 0, which masc keeps for no symbol
pub fun handle(s: Symbol) u32 {
    if (sel s.function) { ret s.function * 2 + 1; }
    ret s.global * 2 + 2;
}

# the size in bytes of a global laid out in an address space, 0 when its type lays out to none there, which the walk
# reads as a length it does not know
fun size(l: *Layout, d: *GlobalData, space: u32) u64 {
    val res_sized: res[u64, record.Error] = layout.size(l, d.type, space);
    if (sel res_sized.ok) { ret res_sized.ok; }
    ret 0;
}

# the secret range `i` of global `d` of `size` bytes, the whole global its one range
fun range_at(d: *GlobalData, size: u64, i: usize) Range {
    val s: global.Secrecy = d.secret;
    if (sel s.ranges) { ret s.ranges.data[i]; }
    ret Range{offset: 0, length: size};
}

# how many secret ranges global `d` states, the whole global one
fun range_count(d: *GlobalData) usize {
    val s: global.Secrecy = d.secret;
    if (sel s.ranges) { ret s.ranges.size; }
    if (sel s.whole)  { ret 1; }
    ret 0;
}

# the walk's seed of each secret range of every global of `m`, each the bytes of a global off its symbol, into `out`.
# the walk reads the placed image, whose globals the hand-over lays out in the default space
pub fun seeds(m: *Module, l: *Layout, out: *vector.Vector[walk.Seed]) err[allocator.Error] {
    var g: usize = 0;
    for (g < m.globals.len) {
        val d:     *GlobalData = ?m.globals.data[g].data;
        val n:     usize       = range_count(d);
        val bytes: u64         = size(l, d, DEFAULT_SPACE);
        var i:     usize       = 0;
        for (i < n) {
            val r:          Range                       = range_at(d, bytes, i);
            val at:         walk.Global                 = walk.Global{symbol: handle(Symbol.global{(g::u32)}), offset: r.offset::i64, length: r.length};
            val res_pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.symbol{at});
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            i = i + 1;
        }
        g = g + 1;
    }
    ret err[allocator.Error].ok{};
}

# the walk's extent of each secret range of every global of `m`, off its symbol, into `out`
pub fun extents(m: *Module, l: *Layout, out: *vector.Vector[walk.Extent]) err[allocator.Error] {
    var g: usize = 0;
    for (g < m.globals.len) {
        val d:     *GlobalData = ?m.globals.data[g].data;
        val n:     usize       = range_count(d);
        val bytes: u64         = size(l, d, DEFAULT_SPACE);
        var i:     usize       = 0;
        for (i < n) {
            val r:          Range                       = range_at(d, bytes, i);
            val at:         walk.Extent                 = walk.Extent{base: rf.NONE, symbol: handle(Symbol.global{(g::u32)}), offset: r.offset::i64, length: r.length};
            val res_pushed: res[usize, allocator.Error] = vector.push[walk.Extent](out, at);
            if (sel res_pushed.err) { ret err[allocator.Error].err{res_pushed.err}; }
            i = i + 1;
        }
        g = g + 1;
    }
    ret err[allocator.Error].ok{};
}

# whether `m` holds a global that states a secret byte
pub fun any(m: *Module) bool {
    var g: usize = 0;
    for (g < m.globals.len) {
        if (global.secret(?m.globals.data[g].data)) { ret true; }
        g = g + 1;
    }
    ret false;
}

# a global an address is formed from and where in it
# ---
# global: the global
# space:  the address space of the address, which the global is laid out in as it reads it
# offset: the byte offset from its start, none when it is not known
pub rec Reach {
    global: Global;
    space:  u32;
    offset: opt[i64];
}

# the signed value of an integer constant, none for one wider than 64 bits or no integer
fun signed(m: *Module, v: ConstantData) opt[i64] {
    if (!(sel v.integer)) { ret opt[i64].none{}; }
    val b:         Bits                  = v.integer;
    val res_width: res[u32, table.Error] = table.width(?m.types, b.type);
    if (sel res_width.err) { ret opt[i64].none{}; }
    val bits: u32 = res_width.ok;
    if (bits > 64 || bits == 0 || b.words.size == 0) { ret opt[i64].none{}; }
    var word: u64 = b.words.data[0];
    if (bits < 64) {
        val shift: u64 = (64 - bits)::u64;
        ret opt[i64].some{((word << shift)::i64) >> shift::i64};
    }
    ret opt[i64].some{word::i64};
}

# the signed value of a value of body `b` that is an integer constant, none for any other
pub fun constant_of(m: *Module, b: *Body, v: Value) opt[i64] {
    val def: Def = b.values.data[v].def;
    if (!(sel def.constant)) { ret opt[i64].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_constant_data.err) { ret opt[i64].none{}; }
    ret signed(m, res_constant_data.ok);
}

# the global address `v` of body `b` of module `m` is formed from, laid out by `l`: an address constant of a global
# past its steps (`mirl.target.steps`), its offset known where every step's is. none for an address of no global, or
# one formed any other way, as one a block parameter, a load or a call gives
pub fun reached(m: *Module, l: *Layout, b: *Body, v: Value) opt[Reach] {
    var f:   steps.Formed = steps.formed(m, l, b, v);
    val def: Def          = b.values.data[f.root].def;
    if (!(sel def.constant)) { ret opt[Reach].none{}; }
    val res_constant_data: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel res_constant_data.err)           { ret opt[Reach].none{}; }
    if (!(sel res_constant_data.ok.address)) { ret opt[Reach].none{}; }
    val s: Symbol = res_constant_data.ok.address.symbol;
    if (!(sel s.global)) { ret opt[Reach].none{}; }
    if (!f.known)        { ret opt[Reach].some{Reach{global: s.global, space: f.space, offset: opt[i64].none{}}}; }
    steps.add(?f, res_constant_data.ok.address.offset);
    ret opt[Reach].some{Reach{global: s.global, space: f.space, offset: opt[i64].some{f.offset}}};
}

# whether a read of a value of type `ty` at address `v` of body `b` may take a byte of a secret range of the global it
# is formed from, the value and the global laid out by `l` in the address's space: false for an address of no global
# the ir places, and any byte of a secret global where either size is not known
pub fun reads_secret(m: *Module, l: *Layout, b: *Body, v: Value, ty: Type) bool {
    val opt_reached: opt[Reach] = reached(m, l, b, v);
    if (sel opt_reached.none) { ret false; }
    val d:          *GlobalData            = ?m.globals.data[opt_reached.some.global].data;
    val res_length: res[u64, record.Error] = layout.size(l, ty, opt_reached.some.space);
    if (sel res_length.err) { ret global.secret(d); }
    val res_bytes: res[u64, record.Error] = layout.size(l, d.type, opt_reached.some.space);
    if (sel res_bytes.err)  { ret global.secret(d); }
    if (res_length.ok == 0) { ret global.secret(d); }
    ret global.overlaps(d, res_bytes.ok, opt_reached.some.offset, res_length.ok);
}
