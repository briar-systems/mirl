# the secret globals of a module, as the constant-time walk and the verifier read them
#
# a global states its secrecy (`mirl.ir.global.Secrecy`): the whole global or
# the byte ranges of an aggregate's secret fields and elements. every walk of
# a constant-time function's code seeds each secret range of every global of
# its module as the bytes of a global off its symbol's address
# (`walk.Seed.symbol`), secret for the whole function. the walk names a symbol
# by a handle its caller gives, one per function and global of the module
# here (`handle`), the handle each site of the code names too, so the walk
# places an access of a global wherever its address is formed. an address the
# ir forms from a global's, through constant offsets, members and indexes, is
# placed here (`reached`), which the verifier holds a load of secret bytes to
# a secret result by and a callee's reads are known to be of secret globals by.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mirl.ir.constant.Bits;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.global;
use mirl.ir.global.GlobalData;
use mirl.ir.global.Range;
use mirl.ir.id.Global;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Immediate;
use types: mirl.ir.type;
use mirl.ir.type.DEFAULT_SPACE;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.target.layout;
use mirl.target.layout.Layout;
use mirl.target.record;

use rf: masc.core.register;
use masc.walk.walk;

# the walk's handle of a function or global of the module, never 0, which masc keeps for no symbol
pub fun handle(s: Symbol) u32 {
    if (sel s.function) { ret s.function.index * 2 + 1; }
    ret s.global.index * 2 + 2;
}

# the size in bytes of a global, 0 when its type lays out to none, which the walk reads as a length it does not know
pub fun size(l: *Layout, d: *GlobalData) u64 {
    val sized: res[u64, record.Error] = layout.size(l, d.type, DEFAULT_SPACE);
    if (sel sized.ok) { ret sized.ok; }
    ret 0;
}

# the secret range `i` of global `d` of `size` bytes, the whole global its one range
fun range_at(d: *GlobalData, size: u64, i: usize) Range {
    val s: global.Secrecy = d.secret;
    if (sel s.ranges) { ret s.ranges.data[i]; }
    ret Range{offset: 0, length: size};
}

# how many secret ranges global `d` states, the whole global one
fun range_count(d: *GlobalData) usize {
    val s: global.Secrecy = d.secret;
    if (sel s.ranges) { ret s.ranges.size; }
    if (sel s.whole)  { ret 1; }
    ret 0;
}

# the walk's seed of each secret range of every global of `m`, each the bytes of a global off its symbol, into `out`
pub fun seeds(m: *Module, l: *Layout, out: *vector.Vector[walk.Seed]) err[allocator.Error] {
    var g: usize = 0;
    for (g < m.globals.len) {
        val d:     *GlobalData = ?m.globals.data[g].data;
        val n:     usize       = range_count(d);
        val bytes: u64         = size(l, d);
        var i:     usize       = 0;
        for (i < n) {
            val r:      Range                       = range_at(d, bytes, i);
            val at:     walk.Global                 = walk.Global{symbol: handle(Symbol.global{Global{index: g::u32}}), offset: r.offset::i64, length: r.length};
            val pushed: res[usize, allocator.Error] = vector.push[walk.Seed](out, walk.Seed.symbol{at});
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            i = i + 1;
        }
        g = g + 1;
    }
    ret err[allocator.Error].ok{};
}

# the walk's extent of each secret range of every global of `m`, off its symbol, into `out`
pub fun extents(m: *Module, l: *Layout, out: *vector.Vector[walk.Extent]) err[allocator.Error] {
    var g: usize = 0;
    for (g < m.globals.len) {
        val d:     *GlobalData = ?m.globals.data[g].data;
        val n:     usize       = range_count(d);
        val bytes: u64         = size(l, d);
        var i:     usize       = 0;
        for (i < n) {
            val r:      Range                       = range_at(d, bytes, i);
            val at:     walk.Extent                 = walk.Extent{base: rf.NONE, symbol: handle(Symbol.global{Global{index: g::u32}}), offset: r.offset::i64, length: r.length};
            val pushed: res[usize, allocator.Error] = vector.push[walk.Extent](out, at);
            if (sel pushed.err) { ret err[allocator.Error].err{pushed.err}; }
            i = i + 1;
        }
        g = g + 1;
    }
    ret err[allocator.Error].ok{};
}

# whether `m` holds a global that states a secret byte
pub fun any(m: *Module) bool {
    var g: usize = 0;
    for (g < m.globals.len) {
        if (global.secret(?m.globals.data[g].data)) { ret true; }
        g = g + 1;
    }
    ret false;
}

# a global an address is formed from and where in it
# ---
# global: the global
# offset: the byte offset from its start, none when it is not known
pub rec Reach {
    global: Global;
    offset: opt[i64];
}

# the signed value of an integer constant, none for one wider than 64 bits or no integer
fun signed(m: *Module, v: ConstantData) opt[i64] {
    if (!(sel v.integer)) { ret opt[i64].none{}; }
    val b:     Bits                  = v.integer;
    val width: res[u32, types.Error] = types.width(?m.types, b.type);
    if (sel width.err) { ret opt[i64].none{}; }
    val bits: u32 = width.ok;
    if (bits > 64 || bits == 0 || b.words.size == 0) { ret opt[i64].none{}; }
    var word: u64 = b.words.data[0];
    if (bits < 64) {
        val shift: u64 = (64 - bits)::u64;
        ret opt[i64].some{((word << shift)::i64) >> shift::i64};
    }
    ret opt[i64].some{word::i64};
}

# the signed value of a value of body `b` that is an integer constant, none for any other
pub fun constant_of(m: *Module, b: *Body, v: Value) opt[i64] {
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret opt[i64].none{}; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret opt[i64].none{}; }
    ret signed(m, got.ok);
}

# the type immediate `i` of an instruction holds, none for none
fun type_at(d: *InstructionData, i: usize) opt[Type] {
    if (i >= d.immediates.len) { ret opt[Type].none{}; }
    val imm: Immediate = d.immediates.data[i];
    if (sel imm.ty) { ret opt[Type].some{imm.ty}; }
    ret opt[Type].none{};
}

# the member immediate `i` of an instruction holds, none for none
fun member_at(d: *InstructionData, i: usize) opt[u32] {
    if (i >= d.immediates.len) { ret opt[u32].none{}; }
    val imm: Immediate = d.immediates.data[i];
    if (sel imm.member) { ret opt[u32].some{imm.member}; }
    ret opt[u32].none{};
}

# `offset` moved by `by`, none when either is not known
fun moved(offset: opt[i64], by: opt[i64]) opt[i64] {
    if (sel offset.some) {
        if (sel by.some) { ret opt[i64].some{offset.some + by.some}; }
    }
    ret opt[i64].none{};
}

# the global address `v` of body `b` of module `m` is formed from, laid out by `l`: an address constant of a global,
# moved by a `ptr.add`, `ptr.member` or `ptr.index`, its offset known where every step's is. none for an address of no
# global, or one formed any other way, as one a block parameter, a load or a call gives
pub fun reached(m: *Module, l: *Layout, b: *Body, v: Value) opt[Reach] {
    var at:    Value    = v;
    var by:    opt[i64] = opt[i64].some{0};
    var steps: usize    = 0;
    for (steps <= b.values.len) {
        val def: Def = b.values.data[at.index].def;
        if (sel def.constant) {
            val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
            if (sel got.err)           { ret opt[Reach].none{}; }
            if (!(sel got.ok.address)) { ret opt[Reach].none{}; }
            val s: Symbol = got.ok.address.symbol;
            if (!(sel s.global)) { ret opt[Reach].none{}; }
            ret opt[Reach].some{Reach{global: s.global, offset: moved(by, opt[i64].some{got.ok.address.offset})}};
        }
        if (!(sel def.result)) { ret opt[Reach].none{}; }
        val d: *InstructionData = ?b.instructions.data[def.result.instruction.index];
        if (d.operands.len == 0) { ret opt[Reach].none{}; }
        if (d.opcode.index == opcode.PTR_ADD.index && d.operands.len == 2) {
            by = moved(by, constant_of(m, b, d.operands.data[1]));
        }
        or (d.opcode.index == opcode.PTR_MEMBER.index) {
            val ty:     opt[Type] = type_at(d, 0);
            val member: opt[u32]  = member_at(d, 1);
            var step:   opt[i64]  = opt[i64].none{};
            if (sel ty.some) {
                if (sel member.some) {
                    val off: res[u64, record.Error] = layout.offset(l, ty.some, DEFAULT_SPACE, member.some);
                    if (sel off.ok) { step = opt[i64].some{off.ok::i64}; }
                }
            }
            by = moved(by, step);
        }
        or (d.opcode.index == opcode.PTR_INDEX.index && d.operands.len == 2) {
            val ty:    opt[Type] = type_at(d, 0);
            val index: opt[i64]  = constant_of(m, b, d.operands.data[1]);
            var step:  opt[i64]  = opt[i64].none{};
            if (sel ty.some) {
                if (sel index.some) {
                    val stride: res[u64, record.Error] = layout.stride(l, ty.some, DEFAULT_SPACE);
                    if (sel stride.ok) { step = opt[i64].some{index.some * stride.ok::i64}; }
                }
            }
            by = moved(by, step);
        }
        or { ret opt[Reach].none{}; }
        at    = d.operands.data[0];
        steps = steps + 1;
    }
    ret opt[Reach].none{};
}

# whether the `length` bytes at address `v` of body `b` may share one with a secret range of the global it is formed
# from, laid out by `l`: false for an address of no global the ir places
pub fun secret_at(m: *Module, l: *Layout, b: *Body, v: Value, length: u64) bool {
    val got: opt[Reach] = reached(m, l, b, v);
    if (sel got.none) { ret false; }
    val d: *GlobalData = ?m.globals.data[got.some.global.index].data;
    ret global.overlaps(d, size(l, d), got.some.offset, length);
}

# whether address `v` of body `b` is formed from a global that states a secret byte
pub fun of_secret(m: *Module, l: *Layout, b: *Body, v: Value) bool {
    val got: opt[Reach] = reached(m, l, b, v);
    if (sel got.none) { ret false; }
    ret global.secret(?m.globals.data[got.some.global.index].data);
}
