# tests of mirl.ct: the question and the answer read from masc's rows, under
# the selection a target's build makes or a set's own baseline

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;
use std.types.string.str_len;
use std.types.view.View;

use A: std.allocator;
use std.allocator.page;
use std.collections.slice.Slice;
use std.collections.vector;

use mct: masc.core.ct;
use masc.core.diagnostic;
use masc.core.extension;
use rf:   masc.core.register;
use mset: masc.core.set;
use masc.core.state;
use riscv_row: masc.isa.riscv.gen_row;
use spirv_set: masc.isa.spirv.set;
use wasm_set:  masc.isa.wasm.set;
use masc.walk.walk;

use mirl.ct;
use target_basis: mirl.target.basis;
use mirl.target.basis.Basis;
use mirl.target.register.riscv.rows.RV64_LINUX;

# mul a2, a0, a1, then ret
val MULTIPLY: [8]u8 = [8]u8{0x33, 0x06, 0xb5, 0x02, 0x67, 0x80, 0x00, 0x00};

# local.get 0, then end
val BODY: [3]u8 = [3]u8{0x20, 0x00, 0x0b};

val ZKT: [1]str = [1]str{"zkt"};

# the build basis of riscv64 linux, its rv64gc baseline and zkt when `zkt`
fun riscv(b: *Basis, a: *A.Allocator, zkt: bool) bool {
    var added: Slice[str] = Slice[str]{data: nil, size: 0};
    if (zkt) { added = Slice[str]{data: ?ZKT[0], size: 1}; }
    val chosen: err[target_basis.Error] = target_basis.choose(b, a, ?RV64_LINUX, added);
    ret sel chosen.ok;
}

# the register of the build's file named `name`, as a seed of the walk
fun seed(b: *Basis, name: str) opt[walk.Seed] {
    val found: res[rf.Id, rf.Absent] = rf.lookup(?b.view, View{data: name, len: str_len(name)});
    if (sel found.err) { ret opt[walk.Seed].none{}; }
    ret opt[walk.Seed].some{walk.Seed.register{found.ok}};
}

# the answer of riscv64 linux's build for MULTIPLY with a0 secret
fun multiply(a: *A.Allocator, zkt: bool) opt[ct.Answer] {
    var b: Basis;
    if (!riscv(?b, a, zkt)) { ret opt[ct.Answer].none{}; }
    fin { target_basis.drop(?b); }
    val a0: opt[walk.Seed] = seed(?b, "a0");
    if (sel a0.none) { ret opt[ct.Answer].none{}; }
    var seeds:   [1]walk.Seed            = [1]walk.Seed{a0.some};
    var secrets: walk.Secrets            = walk.Secrets{at: ?seeds[0], len: 1};
    var code:    walk.Code               = walk.Code{set: b.set, data: ?MULTIPLY[0], len: 8};
    val got:     res[ct.Answer, A.Error] = ct.check(a, ?code, ?b.context, ?secrets);
    if (sel got.err) { ret opt[ct.Answer].none{}; }
    ret opt[ct.Answer].some{got.ok};
}

# the answer for `bytes` as code of `s` under the context of its first
# architecture and its baseline, from no secret
fun answer_of(a: *A.Allocator, s: *mset.Set, bytes: *u8, len: usize) opt[ct.Answer] {
    val chosen: res[extension.Selection, extension.Error] = extension.select(a, s.extensions, "", diagnostic.START);
    if (sel chosen.err) { ret opt[ct.Answer].none{}; }
    var picked: extension.Selection = chosen.ok;
    fin { extension.release(?picked); }
    var view:   rf.Available;
    val opened: res[state.Context, state.Opened] = mset.open(a, s, s.arches.at, ?picked, ?view);
    if (sel opened.err) { ret opt[ct.Answer].none{}; }
    var ctx:     state.Context           = opened.ok;
    var code:    walk.Code               = walk.Code{set: s, data: bytes, len: len};
    var secrets: walk.Secrets            = walk.Secrets{at: nil, len: 0};
    val got:     res[ct.Answer, A.Error] = ct.check(a, ?code, ?ctx, ?secrets);
    val viewed:  err[A.Error]            = rf.release(?view);
    if (sel viewed.err) { ret opt[ct.Answer].none{}; }
    if (sel got.err)    { ret opt[ct.Answer].none{}; }
    ret opt[ct.Answer].some{got.ok};
}

# whether `r` spells as `want`, masc's one wording and what of its condition
# the context lacks
fun spelled(a: *A.Allocator, r: *mct.Refusal, want: str) bool {
    var out: vector.Vector[u8] = vector.init[u8](a);
    fin { vector.dnit[u8](?out); }
    val wrote: err[A.Error] = mct.spell(r, ?out);
    if (sel wrote.err || out.len != str_len(want)) { ret false; }
    var i: usize = 0;
    for (i < out.len) {
        if (out.data[i] != want[i]::u8) { ret false; }
        i = i + 1;
    }
    ret true;
}

# the machine form's question reads mul's class under the build's selection:
# a secret multiplicand is refused naming zkt on rv64gc and passes once the
# build adds zkt, and div, which zkt does not list, is refused under both
# naming nothing
test ct__the_question_reads_the_rows_under_the_build_selection {
    var a: A.Allocator;
    page.make(?a);
    var without: Basis;
    if (!riscv(?without, ?a, false)) { ret 1; }
    fin { target_basis.drop(?without); }
    var with: Basis;
    if (!riscv(?with, ?a, true)) { ret 1; }
    fin { target_basis.drop(?with); }
    val open: opt[mct.Refusal] = ct.latency(riscv_row.MUL, ?without.context, mct.Input.operand{1});
    val kept: opt[mct.Refusal] = ct.latency(riscv_row.MUL, ?with.context, mct.Input.operand{1});
    if (sel kept.some) { ret 2; }
    if (sel open.none) { ret 2; }
    var refused: mct.Refusal = open.some;
    if (refused.reason != mct.LATENCY || refused.operand != 1)                                             { ret 3; }
    if (!spelled(?a, ?refused, "secret value in an input the instruction's timing depends on: needs zkt")) { ret 4; }
    val divided: opt[mct.Refusal] = ct.latency(riscv_row.DIV, ?with.context, mct.Input.operand{2});
    if (sel divided.none) { ret 5; }
    var dependent: mct.Refusal = divided.some;
    if (!spelled(?a, ?dependent, "secret value in an input the instruction's timing depends on")) { ret 6; }
    ret 0;
}

# risc-v classifies its rows, so the walk decides the code: a secret
# multiplicand on rv64gc is refused at the mul, naming its operand, and under
# zkt the requirement is held
test ct__a_set_that_classifies_its_rows_holds_the_code_its_walk_clears {
    var a: A.Allocator;
    page.make(?a);
    val open: opt[ct.Answer] = multiply(?a, false);
    val held: opt[ct.Answer] = multiply(?a, true);
    if (sel open.none) { ret 1; }
    if (sel held.none) { ret 1; }
    val refused: ct.Answer = open.some;
    if (!(sel refused.refused))                                                                                               { ret 2; }
    if (refused.refused.offset != 0 || refused.refused.refusal.reason != mct.LATENCY || refused.refused.refusal.operand != 1) { ret 3; }
    val cleared: ct.Answer = held.some;
    if (!(sel cleared.held)) { ret 4; }
    ret 0;
}

# wasm cannot guarantee its timing, and until masc walks its code a walk of it
# answers unread, so the code compiles with the warning as not verified
test ct__a_set_whose_timing_is_not_guaranteed_compiles_with_the_warning {
    var a: A.Allocator;
    page.make(?a);
    val got: opt[ct.Answer] = answer_of(?a, ?wasm_set.SET, ?BODY[0], 3);
    if (sel got.none) { ret 1; }
    val warned: ct.Answer = got.some;
    if (!(sel warned.warned))                                  { ret 2; }
    if (!(sel warned.warned.some))                             { ret 3; }
    if (!str_equals(warned.warned.some.message, walk.STACKED)) { ret 4; }
    ret 0;
}

# spir-v classifies no instruction's timing, so a constant-time requirement on
# its code is refused before any walk, in masc's one wording
test ct__a_set_that_classifies_no_timing_refuses_in_one_wording {
    var a: A.Allocator;
    page.make(?a);
    val got: opt[ct.Answer] = answer_of(?a, ?spirv_set.SET, ?BODY[0], 3);
    if (sel got.none) { ret 1; }
    val refused: ct.Answer = got.some;
    if (!(sel refused.refused)) { ret 2; }
    var r: mct.Refusal = refused.refused.refusal;
    if (r.reason != mct.UNCLASSIFIED || refused.refused.offset != 0)                                                 { ret 3; }
    if (!spelled(?a, ?r, "constant time required of code whose instruction set classifies no instruction's timing")) { ret 4; }
    ret 0;
}
