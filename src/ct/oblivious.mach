# the ir's oblivious check: what a constant-time function may do with a secret
#
# a function that requires constant time branches on no secret, calls through
# no secret address, forms no address or length of a memory access from a
# secret, stores no secret into memory it states public, copies or fills no
# secret over a length known only when it runs, and returns no secret in a
# result its declaration states public.
# the check reads the secrecy of every value as the ir marks it, carried
# through every row that propagates secrecy and every edge. a `declassify`
# propagates none: its result is public for every purpose, so what it feeds is
# checked as the public value the author declared it, a division's trap test
# included. these are the secrecy facts, which `facts` gives of any function
# and `public` answers of a value, so a pass that may choose a faster form for
# public operands asks here.
#
# which instruction's timing depends on its operands is masc's to state, so
# the latency of an instruction is the machine form's question, never this
# check's. a refusal is masc's one record (`mirl.ct.Refused`), at the
# instruction and the operand that holds the secret.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;

use std.allocator;
use std.collections.vector;

use mct: mirl.ct;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.function.Node;
use mirl.ir.function.in_constant_time;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.instruction.List;
use mirl.ir.module;
use mirl.ir.module.Module;
use opcode_row: mirl.ir.opcode.row;
use mirl.ir.opcode.row.Opcode;
use mirl.ir.opcode.row.Row;
use opcode_table: mirl.ir.opcode.table;
use mirl.ir.value.Def;

use masc.core.ct;

# the secrecy facts of one function: whether each value may hold a secret
# ---
# secret: per value, whether it may hold a secret, the ir's mark carried
#         through what propagates it
pub rec Facts {
    secret: vector.Vector[bool];
}

# give back what `facts` made
pub fun release(x: *Facts) {
    vector.dnit[bool](?x.secret);
}

# whether the facts prove `v` public, so its value depends on no secret
pub fun public(x: *Facts, v: Value) bool {
    if (v::usize >= x.secret.len) { ret false; }
    ret !x.secret.data[v];
}

# whether the facts prove every operand of instruction `i` of `b`, the body they are the facts of, public
pub fun operands_public(x: *Facts, b: *Body, i: Instruction) bool {
    val d: *InstructionData = ?b.instructions.data[i];
    var n: usize            = 0;
    for (n < d.operands.len) {
        if (!public(x, d.operands.data[n])) { ret false; }
        n = n + 1;
    }
    ret true;
}

fun body_of(m: *Module, f: Function) *Body {
    ret ?m.functions.data[f].body;
}

fun data(b: *Body, i: Instruction) *InstructionData {
    ret ?b.instructions.data[i];
}

fun is(d: *InstructionData, code: Opcode) bool {
    ret d.opcode == code;
}

# the secrecy facts of function `f`: the ir's marks, passed on through every row that propagates secrecy and every
# edge, to a fixed point. a `declassify` propagates none, so its result is public
pub fun facts(a: *allocator.Allocator, m: *Module, f: Function) res[Facts, allocator.Error] {
    val b:    *Body                       = body_of(m, f);
    var x:    Facts                       = Facts{secret: vector.init[bool](a)};
    val room: res[usize, allocator.Error] = vector.reserve[bool](?x.secret, b.values.len);
    if (sel room.err) {
        release(?x);
        ret res[Facts, allocator.Error].err{room.err};
    }
    var v: usize = 0;
    for (v < b.values.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?x.secret, b.values.data[v].secret);
        if (sel pushed.err) {
            release(?x);
            ret res[Facts, allocator.Error].err{pushed.err};
        }
        v = v + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        var k: usize = 0;
        for (k < b.blocks.len) {
            if (!b.blocks.data[k].erased) {
                val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
                var i:    usize                       = 0;
                for (i < list.len) {
                    if (step(b, list.data[i], ?x)) { changed = true; }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
    }
    ret res[Facts, allocator.Error].ok{x};
}

fun mark(x: *Facts, v: Value) bool {
    if (x.secret.data[v]) { ret false; }
    x.secret.data[v] = true;
    ret true;
}

# the facts of one instruction's results and edges from its operands, whether any changed
fun step(b: *Body, i: Instruction, x: *Facts) bool {
    val d:       *InstructionData = data(b, i);
    var changed: bool             = false;
    var any:     bool             = false;
    var n:       usize            = 0;
    for (n < d.operands.len) {
        if (x.secret.data[d.operands.data[n]]) { any = true; }
        n = n + 1;
    }
    val row:     opt[*Row] = opcode_table.at(d.opcode);
    var follows: bool      = false;
    if (sel row.some) { follows = sel row.some.secrecy.propagates; }
    if (follows && any) {
        n = 0;
        for (n < d.results.len) {
            if (mark(x, d.results.data[n])) { changed = true; }
            n = n + 1;
        }
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val params: *vector.Vector[Value] = ?b.blocks.data[d.edges.data[e].block].parameters;
        val args:   *List[Value]          = ?d.edges.data[e].arguments;
        var j:      usize                 = 0;
        for (j < args.len && j < params.len) {
            if (x.secret.data[args.data[j]]) {
                if (mark(x, params.data[j])) { changed = true; }
            }
            j = j + 1;
        }
        e = e + 1;
    }
    ret changed;
}

# the refusal of a secret at fixed operand `n` of an instance of `row`, none when the operand may hold one: a secret
# that decides a branch or names the function called, or forms the address or the length of a memory access
fun refusal(row: *Row, n: u32) opt[ct.Refusal] {
    val role:   opcode_row.Role = row.operands[n].role;
    val memory: bool            = row.effects.reads || row.effects.writes;
    if (sel role.condition && row.terminator)                              { ret opt[ct.Refusal].some{ct.refusal(ct.CONTROL, n::u8)}; }
    if (sel role.callee)                                                   { ret opt[ct.Refusal].some{ct.refusal(ct.CONTROL, n::u8)}; }
    if (sel role.length)                                                   { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
    if (memory && (sel role.address || sel role.offset || sel role.index)) { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
    ret opt[ct.Refusal].none{};
}

# whether value `v` of body `b` is an integer the code states, so known before the function runs
fun stated_number(m: *Module, b: *Body, v: Value) bool {
    val def: Def = b.values.data[v].def;
    if (!(sel def.constant)) { ret false; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret false; }
    ret sel got.ok.zero || sel got.ok.integer;
}

# the operand holding the length of copy or fill `d` of body `b` where it moves a secret, as it states or as a fill of
# a secret byte does, its length is known only when it runs and it is not kept: such a run goes to a helper that
# stores through a pointer stating nothing, which constant-time code may not, so the helpers legalisation refuses it
# before it asks for the helper and this check where the target copies or fills in place, so every target refuses
# it. a kept fill, as `$zeroize` is, is a loop of its own stores where the target has no instruction for it, and never
# a helper. none for any other
pub fun unbounded(m: *Module, b: *Body, row: *Row, d: *InstructionData, x: *Facts) opt[u32] {
    if (!is(d, opcode_table.MEM_COPY) && !is(d, opcode_table.MEM_FILL)) { ret opt[u32].none{}; }
    if (d.metadata.flags.kept)                                          { ret opt[u32].none{}; }
    var secret: bool     = d.metadata.secret;
    var length: opt[u32] = opt[u32].none{};
    val fixed:  u32      = opcode_row.fixed(row);
    var n:      u32      = 0;
    for (n < fixed && n::usize < d.operands.len) {
        if (sel row.operands[n].role.length)                                   { length = opt[u32].some{n}; }
        if (sel row.operands[n].role.stored && !public(x, d.operands.data[n])) { secret = true; }
        n = n + 1;
    }
    if (!secret)                                           { ret opt[u32].none{}; }
    if (sel length.none)                                   { ret opt[u32].none{}; }
    if (stated_number(m, b, d.operands.data[length.some])) { ret opt[u32].none{}; }
    ret length;
}

# the first secret function `f` holds where constant-time code may hold none, by its facts: one that decides a branch,
# names a callee or forms an address, one a store writes into memory it states public, one a copy or fill of a length
# known only when it runs moves, or one a return leaves in a result its declaration states public whole. a result
# public in part is the machine walk's to check
fun first(m: *Module, f: Function, x: *Facts) opt[mct.Refused] {
    val b:             *Body = body_of(m, f);
    val public_result: bool  = sel m.functions.data[f].data.result.public;
    var k:             usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                val d:   *InstructionData = data(b, list.data[i]);
                val row: opt[*Row]        = opcode_table.at(d.opcode);
                if (sel row.some) {
                    val fixed: u32 = opcode_row.fixed(row.some);
                    var n:     u32 = 0;
                    for (n < fixed && n::usize < d.operands.len) {
                        if (!public(x, d.operands.data[n])) {
                            val r: opt[ct.Refusal] = refusal(row.some, n);
                            if (sel r.some) { ret opt[mct.Refused].some{mct.refused(f, mct.Where.instruction{list.data[i]}, r.some, d.metadata.location)}; }
                        }
                        n = n + 1;
                    }
                    val run: opt[u32] = unbounded(m, b, row.some, d, x);
                    if (sel run.some) { ret opt[mct.Refused].some{mct.refused(f, mct.Where.instruction{list.data[i]}, ct.refusal(ct.UNBOUNDED, run.some::u8), d.metadata.location)}; }
                    if (d.metadata.flags.public && opcode_row.states_write(row.some)) {
                        n = 0;
                        for (n < fixed && n::usize < d.operands.len) {
                            if (sel row.some.operands[n].role.stored && !public(x, d.operands.data[n])) { ret opt[mct.Refused].some{mct.refused(f, mct.Where.instruction{list.data[i]}, ct.refusal(ct.STORED, n::u8), d.metadata.location)}; }
                            n = n + 1;
                        }
                    }
                }
                if ((is(d, opcode_table.RET) || is(d, opcode_table.RET_PLACED)) && public_result) {
                    var n: usize = 0;
                    for (n < d.operands.len) {
                        if (!public(x, d.operands.data[n])) { ret opt[mct.Refused].some{mct.refused(f, mct.Where.instruction{list.data[i]}, ct.refusal(ct.RESULT, n::u8), d.metadata.location)}; }
                        n = n + 1;
                    }
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret opt[mct.Refused].none{};
}

# the oblivious check of function `f`, which requires constant time
# ---
# ret: the first secret it holds where it may hold none, none when it holds none, or why the facts had no storage
pub fun check(a: *allocator.Allocator, m: *Module, f: Function) res[opt[mct.Refused], allocator.Error] {
    val made: res[Facts, allocator.Error] = facts(a, m, f);
    if (sel made.err) { ret res[opt[mct.Refused], allocator.Error].err{made.err}; }
    var x: Facts = made.ok;
    fin { release(?x); }
    ret res[opt[mct.Refused], allocator.Error].ok{first(m, f, ?x)};
}

# the oblivious check of every function of `m` with a body that requires constant time
# ---
# ret: the first refusal, none when none is refused, or why the facts had no storage
pub fun module_check(a: *allocator.Allocator, m: *Module) res[opt[mct.Refused], allocator.Error] {
    var k: u32 = 0;
    for (k::usize < m.functions.len) {
        val node: *Node = ?m.functions.data[k];
        if (in_constant_time(node.data.constant_time) && node.body.blocks.len > 0) {
            val one: res[opt[mct.Refused], allocator.Error] = check(a, m, k);
            if (sel one.err)     { ret one; }
            if (sel one.ok.some) { ret one; }
        }
        k = k + 1;
    }
    ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].none{}};
}

# whether module `m` holds a function with a body that requires constant time
pub fun requires(m: *Module) opt[Function] {
    var k: u32 = 0;
    for (k::usize < m.functions.len) {
        if (in_constant_time(m.functions.data[k].data.constant_time) && m.functions.data[k].body.blocks.len > 0) { ret opt[Function].some{k}; }
        k = k + 1;
    }
    ret opt[Function].none{};
}
