# the ir's oblivious check: what a constant-time function may do with a secret
#
# a function that requires constant time branches on no secret, calls through
# no secret address, forms no address or length of a memory access from a
# secret, and declassifies nothing but the one test a division's traps need.
# the check reads the secrecy of every value as the ir marks it, with one
# change: a `declassify` makes its result public only in the shape the
# helpers legalisation makes it, the condition of a branch to a trap whose
# taken target is a block of one `unreachable` and whose operand is the trap
# condition of the division the other target reaches, as the division's row
# states its traps. the trap shows that condition anyway, so the branch shows
# nothing a run does not. any other `declassify` passes its operand's secrecy
# on, so what it feeds is checked as the secret it is. these are the secrecy
# facts, which `facts` gives of any function and `public` answers of a value,
# so a pass that may choose a faster form for public operands asks here.
#
# which instruction's timing depends on its operands is masc's to state, so
# the latency of an instruction is the machine form's question, never this
# check's. a refusal is masc's one record (`mirl.ct.Refused`), at the
# instruction and the operand that holds the secret.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_len;
use std.types.view.View;

use std.allocator;
use std.collections.slice.Slice;
use std.collections.vector;

use mct: mirl.ct;
use mirl.fold.word;
use mirl.fold.word.Wide;
use mirl.ir.block.BlockData;
use mirl.ir.constant.ConstantData;
use mirl.ir.function.Body;
use mirl.ir.function.Node;
use mirl.ir.id.Block;
use mirl.ir.id.Function;
use mirl.ir.id.Instruction;
use mirl.ir.id.Symbol;
use mirl.ir.id.Value;
use mirl.ir.instruction.InstructionData;
use mirl.ir.module;
use mirl.ir.module.Module;
use mirl.ir.opcode;
use mirl.ir.opcode.Opcode;
use mirl.ir.opcode.Row;
use mirl.ir.opcode.Trap;
use types: mirl.ir.type;
use mirl.ir.type.Type;
use mirl.ir.value.Def;
use mirl.legal.helper.table;

use masc.core.ct;

# the secrecy facts of one function: whether each value may hold a secret
# ---
# secret: per value, whether it may hold a secret, the ir's mark or a
#         `declassify` of a secret outside the shape the check accepts
pub rec Facts {
    secret: vector.Vector[bool];
}

# give back what `facts` made
pub fun release(x: *Facts) {
    vector.dnit[bool](?x.secret);
}

# whether the facts prove `v` public, so its value depends on no secret
pub fun public(x: *Facts, v: Value) bool {
    if (v.index::usize >= x.secret.len) { ret false; }
    ret !x.secret.data[v.index];
}

# whether the facts prove every operand of instruction `i` of `b`, the body they are the facts of, public
pub fun operands_public(x: *Facts, b: *Body, i: Instruction) bool {
    val d: *InstructionData = ?b.instructions.data[i.index];
    var n: usize            = 0;
    for (n < d.operands.len) {
        if (!public(x, d.operands.data[n])) { ret false; }
        n = n + 1;
    }
    ret true;
}

fun body_of(m: *Module, f: Function) *Body {
    ret ?m.functions.data[f.index].body;
}

fun data(b: *Body, i: Instruction) *InstructionData {
    ret ?b.instructions.data[i.index];
}

fun same(x: Value, y: Value) bool {
    ret x.index == y.index;
}

fun is(d: *InstructionData, code: Opcode) bool {
    ret d.opcode.index == code.index;
}

# the instruction that defines `v`, none for a parameter or a constant
fun defining(b: *Body, v: Value) opt[Instruction] {
    val def: Def = b.values.data[v.index].def;
    if (sel def.result) { ret opt[Instruction].some{def.result.instruction}; }
    ret opt[Instruction].none{};
}

# the width of an integer type, or of a vector's integer lanes, 0 for any other
fun lane_bits(m: *Module, ty: Type) u32 {
    val shape: res[types.Shape, types.Error] = types.shape(?m.types, ty);
    if (sel shape.err)        { ret 0; }
    if (sel shape.ok.integer) { ret shape.ok.integer.width; }
    if (sel shape.ok.vector)  { ret lane_bits(m, shape.ok.vector.element); }
    ret 0;
}

# whether the bits of one integer lane `c` are `want` at `bits`
fun lane_is(c: ConstantData, want: Wide, bits: u32) bool {
    val n: u32 = word.words_for(bits);
    if (sel c.zero) {
        var k: u32 = 0;
        for (k < n) {
            if (want[k] != 0) { ret false; }
            k = k + 1;
        }
        ret true;
    }
    if (!(sel c.integer)) { ret false; }
    var k: u32 = 0;
    for (k < n) {
        var got: u64 = 0;
        if (k::usize < c.integer.words.size) { got = c.integer.words.data[k]; }
        if (got != want[k])                  { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether `v` is a constant whose every lane is `want` at the lane width of its type
fun constant_is(m: *Module, b: *Body, v: Value, want: fun(u32) Wide) bool {
    val def: Def = b.values.data[v.index].def;
    if (!(sel def.constant)) { ret false; }
    val bits: u32 = lane_bits(m, b.values.data[v.index].type);
    if (bits == 0) { ret false; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err) { ret false; }
    val c: ConstantData = got.ok;
    if (sel c.aggregate) {
        var n: usize = 0;
        for (n < c.aggregate.elements.size) {
            val e: res[ConstantData, module.Error] = module.constant_data(m, c.aggregate.elements.data[n]);
            if (sel e.err)                        { ret false; }
            if (!lane_is(e.ok, want(bits), bits)) { ret false; }
            n = n + 1;
        }
        ret c.aggregate.elements.size > 0;
    }
    ret lane_is(c, want(bits), bits);
}

fun zero_at(bits: u32) Wide {
    ret word.zero();
}

# one term of a trap condition, as the helpers legalisation tests a trap of a division's row
# ---
# zero:     the value is zero
# exceeds:  the first is no less than the second, unsigned
# overflow: the first is the least signed value and the second all ones
tag Term: u8 {
    zero:     Value;
    exceeds:  Pair;
    overflow: Pair;
}

rec Pair {
    first:  Value;
    second: Value;
}

# the most terms a condition holds, one per trap a row states
val MOST: usize = 2;

# the terms a trap condition is read into
# ---
# at:  the terms, in the order the condition joins them
# len: how many
rec Terms {
    at:  [2]Term;
    len: usize;
}

# the operand of an instruction `code` with two operands that defines `v`, none when another does
fun binary(b: *Body, v: Value, code: Opcode) opt[Pair] {
    val at: opt[Instruction] = defining(b, v);
    if (sel at.none) { ret opt[Pair].none{}; }
    val d: *InstructionData = data(b, at.some);
    if (!is(d, code) || d.operands.len != 2) { ret opt[Pair].none{}; }
    ret opt[Pair].some{Pair{first: d.operands.data[0], second: d.operands.data[1]}};
}

# one term, under the `reduce.or` a vector's lanes are tested with
fun term(m: *Module, b: *Body, v: Value) opt[Term] {
    var x:  Value            = v;
    val at: opt[Instruction] = defining(b, v);
    if (sel at.some) {
        val d: *InstructionData = data(b, at.some);
        if (is(d, opcode.REDUCE_OR) && d.operands.len == 1) { x = d.operands.data[0]; }
    }
    val eq: opt[Pair] = binary(b, x, opcode.EQ);
    if (sel eq.some) {
        if (constant_is(m, b, eq.some.second, zero_at)) { ret opt[Term].some{Term.zero{eq.some.first}}; }
        ret opt[Term].none{};
    }
    val ge: opt[Pair] = binary(b, x, opcode.GE_U);
    if (sel ge.some) { ret opt[Term].some{Term.exceeds{ge.some}}; }
    val both: opt[Pair] = binary(b, x, opcode.AND);
    if (sel both.none) { ret opt[Term].none{}; }
    val low:   opt[Pair] = binary(b, both.some.first, opcode.EQ);
    val minus: opt[Pair] = binary(b, both.some.second, opcode.EQ);
    if (sel low.none)                                                                                        { ret opt[Term].none{}; }
    if (sel minus.none)                                                                                      { ret opt[Term].none{}; }
    if (!constant_is(m, b, low.some.second, word.least) || !constant_is(m, b, minus.some.second, word.ones)) { ret opt[Term].none{}; }
    ret opt[Term].some{Term.overflow{Pair{first: low.some.first, second: minus.some.first}}};
}

# the terms of a trap condition `v`: one term, or the `or` of the terms before and one more
fun terms(m: *Module, b: *Body, v: Value, out: *Terms) bool {
    val joined: opt[Pair] = binary(b, v, opcode.OR);
    if (sel joined.some) {
        if (!terms(m, b, joined.some.first, out)) { ret false; }
        if (out.len >= MOST)                      { ret false; }
        val t: opt[Term] = term(m, b, joined.some.second);
        if (sel t.none) { ret false; }
        out.at[out.len] = t.some;
        out.len         = out.len + 1;
        ret true;
    }
    val t: opt[Term] = term(m, b, v);
    if (sel t.none) { ret false; }
    out.at[0] = t.some;
    out.len   = 1;
    ret true;
}

# whether the terms are traps of `row`, a subset in the row's order, over the operands `ops` of what stands for the
# division, position `p` of the row at `ops[p + skip]`
fun traps_of(row: *Row, t: *Terms, ops: *vector.Vector[Value], skip: usize) bool {
    var k: usize = 0;
    var n: usize = 0;
    for (n < $length_of(opcode.Traps) && k < t.len) {
        val trap: Trap = row.effects.traps[n];
        val at:   Term = t.at[k];
        if (sel trap.zero) {
            if (sel at.zero) {
                if (operand_is(ops, trap.zero::usize + skip, at.zero)) { k = k + 1; }
            }
        }
        or (sel trap.exceeds) {
            if (sel at.exceeds) {
                if (operand_is(ops, trap.exceeds.dividend::usize + skip, at.exceeds.first) && operand_is(ops, trap.exceeds.divisor::usize + skip, at.exceeds.second)) { k = k + 1; }
            }
        }
        or (sel trap.overflow) {
            if (sel at.overflow) {
                if (operand_is(ops, trap.overflow.dividend::usize + skip, at.overflow.first) && operand_is(ops, trap.overflow.divisor::usize + skip, at.overflow.second)) { k = k + 1; }
            }
        }
        n = n + 1;
    }
    ret k == t.len && t.len > 0;
}

fun operand_is(ops: *vector.Vector[Value], at: usize, v: Value) bool {
    ret at < ops.len && same(ops.data[at], v);
}

# whether `callee` is the address of a helper of the module that divides, which stands for a division
fun divides_by_helper(m: *Module, b: *Body, callee: Value) bool {
    val def: Def = b.values.data[callee.index].def;
    if (!(sel def.constant)) { ret false; }
    val got: res[ConstantData, module.Error] = module.constant_data(m, def.constant);
    if (sel got.err)           { ret false; }
    if (!(sel got.ok.address)) { ret false; }
    val s: Symbol = got.ok.address.symbol;
    if (!(sel s.function)) { ret false; }
    val name: View             = m.functions.data[s.function.index].data.name;
    val rows: Slice[table.Row] = table.rows();
    var i:    usize            = 0;
    for (i < rows.size) {
        val r: *table.Row = ?rows.data[i];
        if (sel r.operation.quotient_u || sel r.operation.quotient_s || sel r.operation.remainder_u || sel r.operation.remainder_s) {
            if (named(name, table.PREFIX, r.stem)) { ret true; }
        }
        i = i + 1;
    }
    ret false;
}

# whether `name` is `prefix`, then `stem`, then a width
fun named(name: View, prefix: str, stem: str) bool {
    val p: usize = str_len(prefix);
    val s: usize = str_len(stem);
    if (name.len <= p + s) { ret false; }
    var i: usize = 0;
    for (i < p) {
        if (name.data[i] != prefix[i]) { ret false; }
        i = i + 1;
    }
    var j: usize = 0;
    for (j < s) {
        if (name.data[p + j] != stem[j]) { ret false; }
        j = j + 1;
    }
    var k: usize = p + s;
    for (k < name.len) {
        if (name.data[k] < '0' || name.data[k] > '9') { ret false; }
        k = k + 1;
    }
    ret true;
}

# whether some instruction of block `k` reads `v`
fun read_in(b: *Body, k: Block, v: Value) bool {
    val list: *vector.Vector[Instruction] = ?b.blocks.data[k.index].instructions;
    var i:    usize                       = 0;
    for (i < list.len) {
        val d: *InstructionData = data(b, list.data[i]);
        var n: usize            = 0;
        for (n < d.operands.len) {
            if (same(d.operands.data[n], v)) { ret true; }
            n = n + 1;
        }
        i = i + 1;
    }
    ret false;
}

# whether every value the terms test is read in block `k`
fun all_read(b: *Body, k: Block, t: *Terms) bool {
    var n: usize = 0;
    for (n < t.len) {
        val at: Term = t.at[n];
        if (sel at.zero) {
            if (!read_in(b, k, at.zero)) { ret false; }
        }
        if (sel at.exceeds) {
            if (!read_in(b, k, at.exceeds.first) || !read_in(b, k, at.exceeds.second)) { ret false; }
        }
        if (sel at.overflow) {
            if (!read_in(b, k, at.overflow.first) || !read_in(b, k, at.overflow.second)) { ret false; }
        }
        n = n + 1;
    }
    ret true;
}

# whether the terms test the traps of the division block `k` reaches: an instance of a row that divides, whose own
# traps they are, or a call of a dividing helper standing for one, placed by the abi legalisation or not, of whose
# arguments they are the traps of some row that divides. a division of a two-word dividend the target has no row for reaches a division of the dividend joined
# at twice the width, so the terms are the traps of a row that divides a two-word dividend and every value they test
# is read in `k`
fun reaches(m: *Module, b: *Body, k: Block, t: *Terms) bool {
    val list: *vector.Vector[Instruction] = ?b.blocks.data[k.index].instructions;
    var held: bool                        = false;
    var i:    usize                       = 0;
    for (i < list.len) {
        val d:   *InstructionData = data(b, list.data[i]);
        val row: opt[*Row]        = opcode.at(d.opcode);
        if (sel row.some) {
            if (opcode.divides(row.some)) {
                held = true;
                if (traps_of(row.some, t, ?d.operands, 0)) { ret true; }
            }
            or ((is(d, opcode.CALL) || is(d, opcode.CALL_PLACED)) && d.operands.len > 0 && divides_by_helper(m, b, d.operands.data[0])) {
                held = true;
                if (dividing_row(t, ?d.operands, 1, false)) { ret true; }
            }
        }
        i = i + 1;
    }
    if (!held || !all_read(b, k, t)) { ret false; }
    ret long_traps(t);
}

# whether some row that divides, two-word or not as `long` asks, has the terms as its traps over `ops`
fun dividing_row(t: *Terms, ops: *vector.Vector[Value], skip: usize, long: bool) bool {
    var n: u32 = 0;
    for (n < opcode.rows()) {
        val row: opt[*Row] = opcode.at(Opcode{index: n});
        if (sel row.some) {
            if (opcode.divides(row.some) && opcode.divides_long(row.some) == long && opcode.fixed(row.some)::usize + skip == ops.len) {
                if (traps_of(row.some, t, ops, skip)) { ret true; }
            }
        }
        n = n + 1;
    }
    ret false;
}

# whether the terms are the traps of some row that divides a two-word dividend, its operands bound by the terms
fun long_traps(t: *Terms) bool {
    var n: u32 = 0;
    for (n < opcode.rows()) {
        val row: opt[*Row] = opcode.at(Opcode{index: n});
        if (sel row.some) {
            if (opcode.divides_long(row.some) && bound(row.some, t)) { ret true; }
        }
        n = n + 1;
    }
    ret false;
}

# whether the terms are traps of `row` in its order under one binding of its operand positions to values
fun bound(row: *Row, t: *Terms) bool {
    var at:   [4]Value = [4]Value{Value{index: 0}, Value{index: 0}, Value{index: 0}, Value{index: 0}};
    var held: [4]bool  = [4]bool{false, false, false, false};
    var k:    usize    = 0;
    var n:    usize    = 0;
    for (n < $length_of(opcode.Traps) && k < t.len) {
        val trap: Trap = row.effects.traps[n];
        val term: Term = t.at[k];
        if (sel trap.zero) {
            if (sel term.zero) {
                if (bind(?at[0], ?held[0], trap.zero, term.zero)) { k = k + 1; }
            }
        }
        or (sel trap.exceeds) {
            if (sel term.exceeds) {
                if (bind(?at[0], ?held[0], trap.exceeds.dividend, term.exceeds.first) && bind(?at[0], ?held[0], trap.exceeds.divisor, term.exceeds.second)) { k = k + 1; }
            }
        }
        or (sel trap.overflow) {
            if (sel term.overflow) {
                if (bind(?at[0], ?held[0], trap.overflow.dividend, term.overflow.first) && bind(?at[0], ?held[0], trap.overflow.divisor, term.overflow.second)) { k = k + 1; }
            }
        }
        n = n + 1;
    }
    ret k == t.len && t.len > 0;
}

# position `p` bound to `v`, true when it was unbound or bound to `v` already
fun bind(at: *Value, held: *bool, p: u32, v: Value) bool {
    if (p >= 4)  { ret false; }
    if (held[p]) { ret same(at[p], v); }
    at[p]   = v;
    held[p] = true;
    ret true;
}

# whether `d`, a `declassify` at `i`, is the one the check accepts: its result's one use is the condition of a
# `cbr` whose taken target is a block of one `unreachable` with no arguments, whose other target takes none, and
# whose operand is the trap condition of the division that target reaches
pub fun accepted(m: *Module, f: Function, i: Instruction) bool {
    val b: *Body            = body_of(m, f);
    val d: *InstructionData = data(b, i);
    if (!is(d, opcode.DECLASSIFY) || d.operands.len != 1 || d.results.len != 1) { ret false; }
    val r:    Value                       = d.results.data[0];
    val uses: *vector.Vector[Instruction] = ?b.values.data[r.index].uses;
    if (uses.len != 1) { ret false; }
    val c: *InstructionData = data(b, uses.data[0]);
    if (!is(c, opcode.CBR) || c.operands.len != 1 || !same(c.operands.data[0], r) || c.edges.len != 2) { ret false; }
    if (c.edges.data[0].arguments.len != 0 || c.edges.data[1].arguments.len != 0)                      { ret false; }
    val stop: Block      = c.edges.data[0].block;
    val sb:   *BlockData = ?b.blocks.data[stop.index];
    if (sb.parameters.len != 0 || sb.instructions.len != 1)        { ret false; }
    if (!is(data(b, sb.instructions.data[0]), opcode.UNREACHABLE)) { ret false; }
    var t: Terms = Terms{at: [2]Term{Term.zero{r}, Term.zero{r}}, len: 0};
    if (!terms(m, b, d.operands.data[0], ?t)) { ret false; }
    ret reaches(m, b, c.edges.data[1].block, ?t);
}

# the secrecy facts of function `f`: the ir's marks, and a `declassify` the check does not accept passing its
# operand's secrecy on through every row that propagates it and every edge, to a fixed point
pub fun facts(a: *allocator.Allocator, m: *Module, f: Function) res[Facts, allocator.Error] {
    val b:    *Body                       = body_of(m, f);
    var x:    Facts                       = Facts{secret: vector.init[bool](a)};
    val room: res[usize, allocator.Error] = vector.reserve[bool](?x.secret, b.values.len);
    if (sel room.err) {
        release(?x);
        ret res[Facts, allocator.Error].err{room.err};
    }
    var v: usize = 0;
    for (v < b.values.len) {
        val pushed: res[usize, allocator.Error] = vector.push[bool](?x.secret, b.values.data[v].secret);
        if (sel pushed.err) {
            release(?x);
            ret res[Facts, allocator.Error].err{pushed.err};
        }
        v = v + 1;
    }
    var changed: bool = true;
    for (changed) {
        changed = false;
        var k: usize = 0;
        for (k < b.blocks.len) {
            if (!b.blocks.data[k].erased) {
                val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
                var i:    usize                       = 0;
                for (i < list.len) {
                    if (step(m, f, b, list.data[i], ?x)) { changed = true; }
                    i = i + 1;
                }
            }
            k = k + 1;
        }
    }
    ret res[Facts, allocator.Error].ok{x};
}

fun mark(x: *Facts, v: Value) bool {
    if (x.secret.data[v.index]) { ret false; }
    x.secret.data[v.index] = true;
    ret true;
}

# the facts of one instruction's results and edges from its operands, whether any changed
fun step(m: *Module, f: Function, b: *Body, i: Instruction, x: *Facts) bool {
    val d:       *InstructionData = data(b, i);
    var changed: bool             = false;
    var any:     bool             = false;
    var n:       usize            = 0;
    for (n < d.operands.len) {
        if (x.secret.data[d.operands.data[n].index]) { any = true; }
        n = n + 1;
    }
    val row:     opt[*Row] = opcode.at(d.opcode);
    var follows: bool      = false;
    if (sel row.some)                                   { follows = sel row.some.secrecy.propagates; }
    if (is(d, opcode.DECLASSIFY) && !accepted(m, f, i)) { follows = true; }
    if (follows && any) {
        n = 0;
        for (n < d.results.len) {
            if (mark(x, d.results.data[n])) { changed = true; }
            n = n + 1;
        }
    }
    var e: usize = 0;
    for (e < d.edges.len) {
        val params: *vector.Vector[Value] = ?b.blocks.data[d.edges.data[e].block.index].parameters;
        val args:   *vector.Vector[Value] = ?d.edges.data[e].arguments;
        var j:      usize                 = 0;
        for (j < args.len && j < params.len) {
            if (x.secret.data[args.data[j].index]) {
                if (mark(x, params.data[j])) { changed = true; }
            }
            j = j + 1;
        }
        e = e + 1;
    }
    ret changed;
}

# the refusal of a secret at fixed operand `n` of an instance of `row`, none when the operand may hold one: a secret
# that decides a branch or names the function called, or forms the address or the length of a memory access
fun refusal(row: *Row, n: u32) opt[ct.Refusal] {
    val role:   opcode.Role = row.operands[n].role;
    val memory: bool        = row.effects.reads || row.effects.writes;
    if (sel role.condition && row.terminator)                              { ret opt[ct.Refusal].some{ct.refusal(ct.CONTROL, n::u8)}; }
    if (sel role.callee)                                                   { ret opt[ct.Refusal].some{ct.refusal(ct.CONTROL, n::u8)}; }
    if (sel role.length)                                                   { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
    if (memory && (sel role.address || sel role.offset || sel role.index)) { ret opt[ct.Refusal].some{ct.refusal(ct.MEMORY, n::u8)}; }
    ret opt[ct.Refusal].none{};
}

# the first secret function `f` holds where constant-time code may hold none, by its facts
fun first(m: *Module, f: Function, x: *Facts) opt[mct.Refused] {
    val b: *Body = body_of(m, f);
    var k: usize = 0;
    for (k < b.blocks.len) {
        if (!b.blocks.data[k].erased) {
            val list: *vector.Vector[Instruction] = ?b.blocks.data[k].instructions;
            var i:    usize                       = 0;
            for (i < list.len) {
                val d:   *InstructionData = data(b, list.data[i]);
                val row: opt[*Row]        = opcode.at(d.opcode);
                if (sel row.some) {
                    val fixed: u32 = opcode.fixed(row.some);
                    var n:     u32 = 0;
                    for (n < fixed && n::usize < d.operands.len) {
                        if (x.secret.data[d.operands.data[n].index]) {
                            val r: opt[ct.Refusal] = refusal(row.some, n);
                            if (sel r.some) { ret opt[mct.Refused].some{mct.refused(f, mct.Where.instruction{list.data[i].index}, r.some)}; }
                        }
                        n = n + 1;
                    }
                }
                i = i + 1;
            }
        }
        k = k + 1;
    }
    ret opt[mct.Refused].none{};
}

# the oblivious check of function `f`, which requires constant time
# ---
# ret: the first secret it holds where it may hold none, none when it holds none, or why the facts had no storage
pub fun check(a: *allocator.Allocator, m: *Module, f: Function) res[opt[mct.Refused], allocator.Error] {
    val made: res[Facts, allocator.Error] = facts(a, m, f);
    if (sel made.err) { ret res[opt[mct.Refused], allocator.Error].err{made.err}; }
    var x: Facts = made.ok;
    fin { release(?x); }
    ret res[opt[mct.Refused], allocator.Error].ok{first(m, f, ?x)};
}

# the oblivious check of every function of `m` with a body that requires constant time
# ---
# ret: the first refusal, none when none is refused, or why the facts had no storage
pub fun module_check(a: *allocator.Allocator, m: *Module) res[opt[mct.Refused], allocator.Error] {
    var k: u32 = 0;
    for (k::usize < m.functions.len) {
        val node: *Node = ?m.functions.data[k];
        if (node.data.constant_time && node.body.blocks.len > 0) {
            val one: res[opt[mct.Refused], allocator.Error] = check(a, m, Function{index: k});
            if (sel one.err)     { ret one; }
            if (sel one.ok.some) { ret one; }
        }
        k = k + 1;
    }
    ret res[opt[mct.Refused], allocator.Error].ok{opt[mct.Refused].none{}};
}

# whether module `m` holds a function with a body that requires constant time
pub fun requires(m: *Module) opt[Function] {
    var k: u32 = 0;
    for (k::usize < m.functions.len) {
        if (m.functions.data[k].data.constant_time && m.functions.data[k].body.blocks.len > 0) { ret opt[Function].some{Function{index: k}}; }
        k = k + 1;
    }
    ret opt[Function].none{};
}
