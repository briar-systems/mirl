# the stale rule's row: a function that requires constant time is refused when its own frame reads a slot no store
# of it reaches first (`mirl.ct.fresh`), since its walk seeds no frame memory and would take that read as public
#
# the rule judges the body where its frame accesses are final, which each family's plan states by where it runs the
# row: last for a register family, and ahead of the structurizer for a family whose control is structured. every row
# after it states that it keeps the frame accesses along every path a run takes (`mirl.pass.record.Frames`), which
# the plan check holds (`mirl.pass.schedule`), so the verdict stands for the code the target emits. the structurizer
# is such a row: the paths its dispatch adds are paths no run takes, which the rule must not judge, since it asks of
# every path from the entry whether a read precedes every store. it changes nothing.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.option.opt;
use std.types.result.res;

use std.allocator;

use mct: mirl.ct;
use mirl.ir.function.in_constant_time;
use mirl.ir.module.Module;
use mirl.ir.function.Node;
use mirl.pass.cache;
use mirl.pass.record.Frames;
use mirl.pass.record.Kind;
use mirl.pass.record.Pass;
use mirl.pass.record.Scope;
use mirl.pass.record.Time;
use mirl.pass.record.Unit;
use mirl.pass.refusal;
use mirl.target.basis;
use mirl.target.layout;
use mirl.target.layout.Layout;

pub val FRESH: Pass = Pass{name: "fresh", kind: Kind.legalise{}, scope: Scope.function{visit}, needs: 0, preserves: cache.ALL, time: Time.keeps{}, frames: Frames.judged{}};

fun visit(u: *Unit) res[bool, refusal.Error] {
    val m: *Module = u.context.m;
    val n: *Node   = ?m.functions.data[u.f];
    if (!in_constant_time(n.data.constant_time) || n.body.blocks.len == 0) { ret res[bool, refusal.Error].ok{false}; }
    # the build's selection, as the emitter lays the frame out
    var l:         Layout                               = layout.of(u.context.t, ?m.types, basis.context_of(u.context.build));
    val res_fresh: res[opt[mct.Stale], allocator.Error] = mct.fresh(m.a, m, ?l, u.f);
    if (sel res_fresh.err)     { ret res[bool, refusal.Error].err{refusal.Error.alloc{res_fresh.err}}; }
    if (sel res_fresh.ok.some) { ret res[bool, refusal.Error].err{refusal.Error.stale{res_fresh.ok.some}}; }
    ret res[bool, refusal.Error].ok{false};
}
