target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a load through a select of two addresses of one slot, after the slot ends
pub fun select(x: i64, f: i1) i64 {
    val s: ptr = alloca[[2]i64, pointer: ptr, align: 8]();
    val a: ptr = ptr.add(s, 8::i64);
    val p: ptr = select(f, s, a);
    slot.begin(s);
    store(s, x);
    slot.end(s);
    val r: i64 = load[i64](p);
    ret(r);
}
