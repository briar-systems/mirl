target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64 windows-x86_64

# the allocation of example/remade.mirl, proved under --verify. q starts at pc and takes pa, a frame address made
# again where it is read, on the right arm, and the pressure in the loop keeps q in a slot written only on its
# edges. a value map that takes the slot for already holding pa, which nothing wrote the first time round, leaves
# the right arm's spill out, and the allocation checker refuses that on linux-x86_64 and windows-x86_64

#[inline(never)] fun keep(x: i64) i64 {
    ret(x);
}

#[inline(never)] fun put(p: ptr, v: i64) {
    store(p, v);
    ret();
}

fun main() i64 {
    val s: ptr = alloca[[4]i64, pointer: ptr, align: 8]();
    val pa: ptr = ptr.add(s, 8::i64);
    val pc: ptr = ptr.add(s, 24::i64);
    store(s, 0::i64);
    store(pa, 0::i64);
    store(pc, 0::i64);
    br head(0, pc);
head(i: i64, q: ptr):
    val c: i1 = lt.s(i, 4);
    cbr(c) body, done;
body:
    val z0: i64 = mul(i, 3);
    val z1: i64 = mul(i, 4);
    val z2: i64 = mul(i, 5);
    val z3: i64 = mul(i, 6);
    val z4: i64 = mul(i, 7);
    val z5: i64 = mul(i, 8);
    val r: i64 = call keep(i);
    val v0: i64 = add(r, z0);
    val v1: i64 = add(r, z1);
    val v2: i64 = add(r, z2);
    val v3: i64 = add(r, z3);
    val v4: i64 = add(r, z4);
    val v5: i64 = add(r, z5);
    val t0: i64 = add(r, v0);
    val u0: i64 = mul(t0, v0);
    val t1: i64 = add(u0, v1);
    val u1: i64 = mul(t1, v1);
    val t2: i64 = add(u1, v2);
    val u2: i64 = mul(t2, v2);
    val t3: i64 = add(u2, v3);
    val u3: i64 = mul(t3, v3);
    val t4: i64 = add(u3, v4);
    val u4: i64 = mul(t4, v4);
    val t5: i64 = add(u4, v5);
    val u5: i64 = mul(t5, v5);
    call put(s, u5);
    call put(q, i);
    val i1: i64 = add(i, 1);
    val o: i64 = and(i, 1);
    val odd: i1 = ne(o, 0);
    cbr(odd) left, right;
left:
    call put(s, 1);
    br head(i1, q);
right:
    call put(s, 2);
    br head(i1, pa);
done:
    val a: i64 = load[i64](pa);
    val b: i64 = load[i64](pc);
    val a10: i64 = mul(a, 10);
    val w: i64 = add(a10, b);
    ret(w);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
