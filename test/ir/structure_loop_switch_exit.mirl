target { arch: "wasm32", sys: "wasi", env: "preview1", abi: "basic", isa: "wasm1" };

# straight-line loop exit arms after a switch belong with the loop so they join
# at one merge block without creating a funnel dispatch
pub fun straight_exits(n: i32, k: i32) i32 {
    br hdr(0);
hdr(i: i32):
    val cond: i1 = lt.s(i, n);
    cbr(cond) body(i), arm_done(i);
body(v: i32):
    val tag: i32 = add(v, k);
    switch(tag) next(v), 0: arm0(v), 1: arm1(v), 2: arm2(v);
next(u: i32):
    val i1: i32 = add(u, 1);
    br hdr(i1);
arm0(x0: i32):
    val r0: i32 = add(x0, 10);
    br merge(r0);
arm1(x1: i32):
    val r1: i32 = add(x1, 20);
    br merge(r1);
arm2(x2: i32):
    val r2: i32 = add(x2, 30);
    br merge(r2);
arm_done(xd: i32):
    br merge(xd);
merge(ans: i32):
    ret(ans);
}

# externally entered targets force exits funneling; split twin trampolines
# emitted around a switch must be absorbed instead of oscillating exits <-> twin
pub fun external_switch_exits(flag: i1, s: i32) i32 {
    cbr(flag) outer_arm, loop_hdr(s);
outer_arm:
    br target_a(10);
loop_hdr(v: i32):
    val go: i1 = lt.s(v, 5);
    cbr(go) dispatch(v), target_c;
dispatch(w: i32):
    switch(w) next_iter(w), 0: target_a(1), 1: target_a(2), 2: target_b(3);
next_iter(u: i32):
    val n: i32 = add(u, 1);
    br loop_hdr(n);
target_a(ra: i32):
    val a: i32 = add(ra, 7);
    br done(a);
target_b(rb: i32):
    val b: i32 = add(rb, 9);
    br done(b);
target_c:
    br done(42);
done(out: i32):
    ret(out);
}

# when latch != header, straight-line exit arms fed from the continue sequence
# stay attached to cont while body exits stay attached to body
pub fun cont_part_exits(n: i32) i32 {
    br header(0);
header(i: i32):
    val keep: i1 = lt.s(i, n);
    cbr(keep) work(i), exit_hdr(i);
work(w: i32):
    val bump: i32 = add(w, 1);
    val early: i1 = eq(bump, 3);
    cbr(early) exit_work(bump), latch(bump);
latch(l: i32):
    switch(l) header(l), 5: exit_cont0(l), 6: exit_cont1(l);
exit_hdr(xh: i32):
    val rx: i32 = add(xh, 100);
    br finish(rx);
exit_work(xw: i32):
    val rw: i32 = add(xw, 200);
    br finish(rw);
exit_cont0(xc0: i32):
    val r0: i32 = add(xc0, 300);
    br finish(r0);
exit_cont1(xc1: i32):
    val r1: i32 = add(xc1, 400);
    br finish(r1);
finish(ans: i32):
    ret(ans);
}

# an inner loop nested inside a selection arm leaving directly to the outer
# selection's merge creates a single-pred funnel bridge whose successor belongs
# to an enclosing region; that bridge must remain outside the loop body
pub fun bridged_nested_loop_exit(cond: i1, n: i32) i32 {
    cbr(cond) outer_other, inner_hdr(0);
outer_other:
    br outer_merge(99);
inner_hdr(bi: i32):
    val b_go: i1 = lt.s(bi, n);
    cbr(b_go) inner_step(bi), outer_merge(bi);
inner_step(bn: i32):
    val b_next: i32 = add(bn, 1);
    br inner_hdr(b_next);
outer_merge(b_out: i32):
    ret(b_out);
}
