target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64 wasi-wasm32
# refuse: constant time required of a function whose own frame reads a slot no store reaches first
# a constant-time read of a slot element no store reaches: the store through a run-time index writes no byte the rule
# knows, so the read takes stale stack an earlier frame may have left a secret in, which the walk would take as public.
# the stale rule's row refuses it on every target (mirl.ct.fresh)
#[constant_time(soft)] pub fun probe(_0: ptr, _1: i64) {
    val _2: ptr = alloca[[4]i32, pointer: ptr, align: 4]();
    val _3: ptr = ptr.index[[4]i32](_2, _1);
    store[align: 4](_3, 7::i32);
    val _4: ptr = ptr.index[[4]i32](_2, 2::i64);
    val _5: i32 = load[i32](_4);
    store[align: 4](_0, _5);
    ret();
}
