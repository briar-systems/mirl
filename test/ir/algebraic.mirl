target "riscv64-linux"

; identities of integers at several widths and as vectors, a wide constant that is an identity only when every word says so, a trapping division kept, a float operation no identity reaches, a secret value kept, and a double negation and complement
function @sink: fun(i64) -> ()

function @identities: fun(i32, i8, i128, i256, vec<4, i32>, binary32) -> (i32) {
^entry(%a: i32, %b: i8, %c: i128, %d: i256, %v: vec<4, i32>, %f: binary32):
    %a0 = add %a, i32 0
    %a1 = mul %a0, i32 1
    %a2 = mul %a1, i32 0
    %a3 = xor %a, %a
    %a4 = sub %a, %a
    %a5 = and %a, i32 -1
    %a6 = or %a, i32 0
    %a7 = shl %a, i32 0
    %a8 = div.u %a, i32 1
    %a9 = rem.s %a, i32 1
    %b0 = add %b, i8 0
    %b1 = and %b0, i8 -1
    %b2 = or %b1, i8 -1
    %c0 = add %c, i128 0
    %c1 = and %c0, i128 -1
    %c2 = mul %c1, i128 0
    %d0 = or %d, i256 0
    %d1 = xor %d0, %d0
    %n0 = neg %a
    %n1 = neg %n0
    %m0 = not %a
    %m1 = not %m0
    %e0 = eq %a, %a
    %e1 = lt.s %a, %a
    %v0 = add %v, %v
    %t0 = div.u %a, %a
    %f0 = fadd %f, binary32 0x00000000
    %f1 = fmul %f, binary32 0x3f800000
    %g0 = fneg %f
    %g1 = fneg %g0
    %h0 = fabs %f
    %h1 = fabs %h0
    %s0 = add %a, i32 5 secret
    %r0 = add %a1, %a3
    %r1 = add %r0, %a4
    %r2 = add %r1, %a5
    %r3 = add %r2, %a6
    %r4 = add %r3, %a7
    %r5 = add %r4, %a8
    %r6 = add %r5, %a9
    %r7 = add %r6, %n1
    %r8 = add %r7, %m1
    %r9 = add %r8, %t0
    ret %r9
}
