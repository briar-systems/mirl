target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# identities of integers at several widths and as vectors, a wide constant that is an identity only when every word says so, a trapping division kept, a float operation no identity reaches, a secret value kept, and a double negation and complement
ext fun sink(i64);

pub fun identities(a: i32, wb: i32, c: i128, d: i256, v: vec[4, i32], f: f32) i32 {
    val b: i8 = trunc[i8](wb);
    val a0: i32 = add(a, 0);
    val a1: i32 = mul(a0, 1);
    val a2: i32 = mul(a1, 0);
    val a3: i32 = xor(a, a);
    val a4: i32 = sub(a, a);
    val a5: i32 = and(a, -1);
    val a6: i32 = or(a, 0);
    val a7: i32 = shl(a, 0);
    val a8: i32 = div.u(a, 1);
    val a9: i32 = rem.s(a, 1);
    val b0: i8 = add(b, 0);
    val b1: i8 = and(b0, -1);
    val b2: i8 = or(b1, -1);
    val c0: i128 = add(c, 0);
    val c1: i128 = and(c0, -1);
    val c2: i128 = mul(c1, 0);
    val d0: i256 = or(d, 0);
    val d1: i256 = xor(d0, d0);
    val n0: i32 = neg(a);
    val n1: i32 = neg(n0);
    val m0: i32 = not(a);
    val m1: i32 = not(m0);
    val e0: i1 = eq(a, a);
    val e1: i1 = lt.s(a, a);
    val v0: vec[4, i32] = add(v, v);
    val t0: i32 = div.u(a, a);
    val f0: f32 = fadd(f, 0x0);
    val f1: f32 = fmul(f, 0x3f800000);
    val g0: f32 = fneg(f);
    val g1: f32 = fneg(g0);
    val h0: f32 = fabs(f);
    val h1: f32 = fabs(h0);
    #[secret] val s0: i32 = add(a, 5);
    val r0: i32 = add(a1, a3);
    val r1: i32 = add(r0, a4);
    val r2: i32 = add(r1, a5);
    val r3: i32 = add(r2, a6);
    val r4: i32 = add(r3, a7);
    val r5: i32 = add(r4, a8);
    val r6: i32 = add(r5, a9);
    val r7: i32 = add(r6, n1);
    val r8: i32 = add(r7, m1);
    val r9: i32 = add(r8, t0);
    ret(r9);
}
