target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# the read-modify-writes no single instruction does: a nand and a compare and exchange of a word and of a doubleword, each a loop of a reserved load and a conditional store, with values live across them
pub fun atomics(p: ptr, x: i32, y: i64) i64 {
    val a: i32 = atomic.nand[order: seq_cst](p, x);
    val b: i64 = atomic.nand[order: acq_rel](p, y);
    val (c: i32, won: i1) = atomic.cmpxchg[success: seq_cst, failure: acquire](p, a, x);
    val (d: i64, done: i1) = atomic.cmpxchg[success: acquire, failure: relaxed](p, b, y);
    val e: i64 = ext.s[i64](c);
    val f: i64 = add(d, e);
    val g: i64 = ext.u[i64](won);
    val h: i64 = ext.u[i64](done);
    val i: i64 = add(f, g);
    val j: i64 = add(i, h);
    ret(j);
}
