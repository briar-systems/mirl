target "riscv64-linux"

; the read-modify-writes no single instruction does: a nand and a compare and exchange of a word and of a doubleword, each a loop of a reserved load and a conditional store, with values live across them
function @atomics: fun(ptr, i32, i64) -> (i64) {
^entry(%p: ptr, %x: i32, %y: i64):
    %a = atomic.nand %p, %x, order seq_cst
    %b = atomic.nand %p, %y, order acq_rel
    %c, %won = atomic.cmpxchg %p, %a, %x, success seq_cst, failure acquire
    %d, %done = atomic.cmpxchg %p, %b, %y, success acquire, failure relaxed
    %e = ext.s %c, to i64
    %f = add %d, %e
    %g = ext.u %won, to i64
    %h = ext.u %done, to i64
    %i = add %f, %g
    %j = add %i, %h
    ret %j
}
