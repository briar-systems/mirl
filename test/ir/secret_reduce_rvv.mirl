target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gcv" };

# a constant-time or of secret bytes on riscv64 with V, as std.crypto.ct.eq_bytes forms it. the reduction's rule for
# a run of several lanes is vredor.vs, whose timing depends on its lanes, beside a quiet rule for a run of one, so the
# loop stays scalar: the vectoriser's question is whether every rule that can serve the reduction is quiet, since
# selection takes whichever rule's guard holds
#[constant_time(soft)] #[secret_result] pub fun differ(a: ptr, b: ptr, n: i64) i8 zext {
    br head(0, 0);
head(i: i64, acc: ^i8):
    val more: i1 = lt.u(i, n);
    cbr(more) body, done;
body:
    val pa: ptr = ptr.index[[1]i8](a, i);
    #[secret] val x: ^i8 = load[i8](pa);
    val pb: ptr = ptr.index[[1]i8](b, i);
    #[secret] val y: ^i8 = load[i8](pb);
    val d: ^i8 = xor(x, y);
    val o: ^i8 = or(acc, d);
    val k: i64 = add(i, 1);
    br head(k, o);
done:
    ret(acc);
}
