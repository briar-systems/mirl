target { arch: "spirv", sys: "vulkan", env: "vulkan1.2", abi: "shader", isa: "spv1.5,Shader" };

# pointers merged where paths join, which logical addressing without VariablePointers chooses none of at run time:
# merges of one base carry their indices and remake the address, and merges of different bases are spread onto each
# path

rec T0 { _0: [64]i32; _1: [64]i32; }
rec T1 { _0: [64]i32; }

#[align(4)] #[spirv.storage(12)] #[spirv.set(0)] #[spirv.binding(0)] ext var a: T0;
#[align(4)] #[spirv.storage(12)] #[spirv.set(0)] #[spirv.binding(1)] ext var b: T1;

# one base on both paths: the join carries the index
pub fun same(c: i1, i: i32, j: i32) {
    cbr(c) left, right;
left:
    val l0: ptr[12] = ptr.member[T0, member: _0](?a);
    val l1: ptr[12] = ptr.index[[64]i32](l0, i);
    br join(l1);
right:
    val r0: ptr[12] = ptr.member[T0, member: _0](?a);
    val r1: ptr[12] = ptr.index[[64]i32](r0, j);
    br join(r1);
join(p: ptr[12]):
    store(p, 1::i32);
    ret();
}

# a pointer carried round a loop and out of it, as unrolling a probe loop leaves one
pub fun walk(n: i32) i32 {
    val base: ptr[12] = ptr.member[T0, member: _1](?a);
    val p0: ptr[12] = ptr.index[[64]i32](base, 0::i32);
    br head(p0, 0::i32);
head(p: ptr[12], i: i32):
    val v: i32 = load[i32](p);
    val i1: i32 = add(i, 1::i32);
    val q: ptr[12] = ptr.index[[64]i32](base, i1);
    val t: i1 = lt.s(v, n);
    cbr(t) head(q, i1), out(p);
out(r: ptr[12]):
    val w: i32 = load[i32](r);
    store(r, 0::i32);
    ret(w);
}

# a select of one base: it selects the index
pub fun chose(c: i1, i: i32, j: i32) i32 {
    val base: ptr[12] = ptr.member[T0, member: _0](?a);
    val x: ptr[12] = ptr.index[[64]i32](base, i);
    val y: ptr[12] = ptr.index[[64]i32](base, j);
    val p: ptr[12] = select(c, x, y);
    val v: i32 = load[i32](p);
    ret(v);
}

# different buffers on each path: what reads the pointer is copied onto each
pub fun apart(c: i1, v: i32) {
    cbr(c) left, right;
left:
    val l0: ptr[12] = ptr.member[T0, member: _0](?a);
    val l1: ptr[12] = ptr.index[[64]i32](l0, 3::i32);
    br join(l1);
right:
    val r0: ptr[12] = ptr.member[T1, member: _0](?b);
    val r1: ptr[12] = ptr.index[[64]i32](r0, 5::i32);
    br join(r1);
join(p: ptr[12]):
    val o: i32 = load[i32](p);
    val s: i32 = add(o, v);
    store(p, s);
    val d: i32 = mul(s, 2::i32);
    val e: i1 = lt.s(d, 9::i32);
    cbr(e) more, done;
more:
    val f: i32 = add(d, s);
    ret();
done:
    ret();
}

# a select of different buffers on a public condition: its block branches on the condition
pub fun picked(c: i1, v: i32) i32 {
    val x0: ptr[12] = ptr.member[T0, member: _1](?a);
    val x: ptr[12] = ptr.index[[64]i32](x0, v);
    val y0: ptr[12] = ptr.member[T1, member: _0](?b);
    val y: ptr[12] = ptr.index[[64]i32](y0, v);
    val p: ptr[12] = select(c, x, y);
    val o: i32 = load[i32](p);
    val s: i32 = add(o, 1::i32);
    store(p, s);
    ret(s);
}
