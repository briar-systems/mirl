target { arch: "spirv", sys: "vulkan", env: "vulkan1.2", abi: "shader", isa: "spv1.5,Shader" };

# a variable of a width the target carries in a wider one, spir-v's 8 bits without Int8, whose binding record folding
# salvages to an expression over the narrow value: carrying retypes that value, and the record reads the carrier
# through a truncation to the old width before its own steps, so it still gives the variable its value

debug {
    directory = "/tmp";
    file f0 = "carried.mach";
    loc l0 = f0:1:1;
    type t0 = "u8" "u8" base(unsigned, 8);
    var v0 = "b": t0 at l0;
}

pub fun carried(w: i32) i32 {
    #[public([0, 1])] val s: ptr[7] = alloca[i8, pointer: ptr[7]]() holds [v0];
    val n: i8 = trunc[i8](w) at l0;
    val b: i8 = add(n, 1) at l0;
    slot.begin(s) at l0;
    store(s, b) at l0;
    val c: i8 = add(b, 1) at l0;
    val e: i32 = ext.u[i32](c) at l0;
    slot.end(s) at l0;
    ret(e) at l0;
}
