target { arch: "riscv32", sys: "linux", env: "gnu", abi: "ilp32d", isa: "rv32gc" };

# negative 32-bit ptr.add offsets sign-extend during overlap analysis so overlapping copies keep their descending order

pub fun copy_back(p: ptr) {
    val src: ptr = ptr.add(p, -4::i32);
    mem.copy[align: 4](p, src, 64::i32);
    ret();
}

pub fun copy_back_short(p: ptr) {
    val src: ptr = ptr.add(p, -8::i32);
    mem.copy[align: 1](p, src, 32::i32);
    ret();
}
