target "riscv64-linux"

; a member of a structure and an element of an array, addressed by their types
function @address: fun(ptr, i32, i64) -> (i64) linkage global visibility default {
^entry(%p: ptr, %i: i32, %x: i64):
    %m = ptr.member %p, type struct {i32, i64}, member 1
    store %m, %x, align 8
    %e = ptr.index %p, %i, type array<8, i64>
    %y = load %e, type i64, align 8
    ret %y
}

; a branch on the cases of a selector, one passing an argument, and a branch on no case
function @select: fun(i32, i64) -> (i64) linkage global visibility default {
^entry(%s: i32, %x: i64):
    switch %s, cases [0, 3, 4294967295], ^other, ^zero, ^three(%x), ^last
^other:
    switch %s, cases [], ^zero
^zero:
    ret %x
^three(%t: i64):
    %u = add %t, i64 1
    ret %u
^last:
    ret i64 0
}

; a function's address taken in code, stored and called through, and a direct call naming its callee
function @dispatch: fun(ptr, i64) -> (i64) linkage global visibility default {
^entry(%p: ptr, %x: i64):
    %f = func.addr function @select, pointer ptr
    store %p, %f, align 8
    %g = load %p, type ptr, align 8
    %y = call %g, i32 3, %x, signature fun(i32, i64) -> (i64), named all
    %z = call ptr @address, %p, i32 0, %x, signature fun(ptr, i32, i64) -> (i64), named all
    %s = add %y, %z
    ret %s
}
