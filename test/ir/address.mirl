target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

rec T0 { _0: i32; _1: i64; }

# a member of a structure and an element of an array, addressed by their types
pub fun address(p: ptr, i: i32, x: i64) i64 {
    val m: ptr = ptr.member[T0, member: _1](p);
    store(m, x);
    val e: ptr = ptr.index[[8]i64](p, i);
    val y: i64 = load[i64](e);
    ret(y);
}

# a branch on the cases of a selector, one passing an argument, and a branch on no case
pub fun select(s: i32, x: i64) i64 {
    switch(s) other, 0: zero, 3: three(x), 4294967295: last;
other:
    switch(s) zero;
zero:
    ret(x);
three(t: i64):
    val u: i64 = add(t, 1);
    ret(u);
last:
    ret(0);
}

# a function's address taken in code, stored and called through, and a direct call naming its callee
pub fun dispatch(p: ptr, x: i64) i64 {
    val f: ptr = func.addr[select, pointer: ptr]();
    store[align: 8](p, f);
    val g: ptr = load[ptr, align: 8](p);
    val y: i64 = call[fun(i32, i64) i64] g(3, x);
    val z: i64 = call address(p, 0, x);
    val s: i64 = add(y, z);
    ret(s);
}
