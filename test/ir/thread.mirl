target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

rec Res { case: i8; value: i64; }

ext fun keep(ptr);

# a fallible step expanded in a loop, for forwarder bypass and jump threading: each arm passes a known case and a
# value to a return block that only forwards them to the caller's test of the case, so the test goes once the
# forwarders do; a forwarder entered by a branch whose other edge enters the test, which threading looks through;
# a forwarder whose parameter is read past it, and a loop's latch and preheader, which stay; and the same step
# returning a record, whose case member the caller tests, as an expanded call leaves a result before its parts are
# taken apart
pub fun chain(p: ptr, n: i64) i64 {
    br head(0, 0);
head(acc: i64, i: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, done;
body:
    val o: i64 = mul(i, 4);
    val a: ptr = ptr.add(p, o);
    val v: i32 = load[i32](a);
    val neg: i1 = lt.s(v, 0);
    cbr(neg) bad, good;
good:
    br good_step;
good_step:
    val w: i64 = ext.s[i64](v);
    val m: i64 = mul(w, 3);
    val s: i64 = add(m, 1);
    br back(1, s);
bad:
    br back(0, 0);
back(tag: i8, r: i64):
    br test(tag, r);
test(t: i8, x: i64):
    val e: i1 = eq(t, 0);
    cbr(e) fail, next;
next:
    br latch;
latch:
    val sum: i64 = add(acc, x);
    val ni: i64 = add(i, 1);
    br head(sum, ni);
fail:
    val minus: i64 = sub(0, 1);
    ret(minus);
done:
    ret(acc);
}

pub fun shared(f: i1, g: i1, y: i32) i32 {
    cbr(g) left, right;
left:
    cbr(f) fwd(1), test(0);
right:
    br fwd(0);
fwd(q: i32):
    br test(q);
test(t: i32):
    val e: i1 = eq(t, 0);
    cbr(e) zero, one;
zero:
    ret(y);
one:
    val z: i32 = add(y, 7);
    ret(z);
}

pub fun read_past(f: i1, y: i32) i32 {
    cbr(f) a, b;
a:
    br fwd(1);
b:
    br fwd(2);
fwd(q: i32):
    br after;
after:
    val z: i32 = add(q, y);
    ret(z);
}

pub fun latched(n: i32) i32 {
    br pre;
pre:
    br loop(0);
loop(i: i32):
    val c: i1 = lt.s(i, n);
    cbr(c) step, out;
step:
    val ni: i32 = add(i, 1);
    br tail(ni);
tail(j: i32):
    br loop(j);
out:
    ret(i);
}

pub fun member(p: ptr, n: i64) i64 {
    br head(0, 0);
head(acc: i64, i: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, done;
body:
    val o: i64 = mul(i, 4);
    val a: ptr = ptr.add(p, o);
    val v: i32 = load[i32](a);
    val neg: i1 = lt.s(v, 0);
    cbr(neg) bad, good;
good:
    val w: i64 = ext.s[i64](v);
    val m: i64 = mul(w, 3);
    val s: i64 = add(m, 1);
    val r0: Res = insert[member: value](zero, s);
    val r1: Res = insert[member: case](r0, 1);
    br back(r1);
bad:
    val e0: Res = insert[member: case](zero, 0);
    val e1: Res = insert[member: value](e0, 0);
    br back(e1);
back(r: Res):
    br test(r);
test(t: Res):
    val tag: i8 = extract[member: case](t);
    val e: i1 = eq(tag, 0);
    cbr(e) fail, latch;
latch:
    val x: i64 = extract[member: value](t);
    val sum: i64 = add(acc, x);
    val ni: i64 = add(i, 1);
    br head(sum, ni);
fail:
    val minus: i64 = sub(0, 1);
    ret(minus);
done:
    ret(acc);
}

# a deciding block holding slot markers, entered by an edge of a `cbr` that passes a known case: the edge goes to a
# block of its own that runs the markers and jumps to the arm the case takes
pub fun marked(f: i1, g: i1, y: i32, p: ptr) i32 {
    val s: ptr = alloca[i32, pointer: ptr, align: 4]();
    slot.begin(s);
    store[align: 4](s, y);
    call keep(s);
    cbr(g) left, right;
left:
    cbr(f) test(1), other;
other:
    val w: i32 = load[i32, align: 4](p);
    br test(w);
right:
    br test(y);
test(t: i32):
    slot.end(s);
    val e: i1 = eq(t, 0);
    cbr(e) zero, one;
zero:
    ret(y);
one:
    val z: i32 = add(y, 7);
    ret(z);
}
