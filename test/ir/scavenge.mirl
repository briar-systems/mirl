target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };
# targets: linux-aarch64 linux-riscv64
# a constant-time function whose frame is past the near offset range, with more secrets live than
# registers across far frame accesses, so the frame code finds no free scratch and lends a
# register through an emergency slot (mirl.machine.frame.scavenge.preserve): on aarch64 one
# holding the secret parameter. the walk of the encoded code must accept it (mirl#708)

#[constant_time(soft)] #[secret_parameters(0)] #[secret_result] #[public_pointers(1)] pub fun far(k: ^i64, p: ptr) i64 {
    #[secret] val pad: ptr = alloca[[65536]i8, pointer: ptr, align: 8]();
    #[secret] val near: ptr = alloca[i64, pointer: ptr]();
    val v0: ^i64 = add(k, 3::i64);
    val v1: ^i64 = add(k, 4::i64);
    val v2: ^i64 = add(k, 5::i64);
    val v3: ^i64 = add(k, 6::i64);
    val v4: ^i64 = add(k, 7::i64);
    val v5: ^i64 = add(k, 8::i64);
    val v6: ^i64 = add(k, 9::i64);
    val v7: ^i64 = add(k, 10::i64);
    val v8: ^i64 = add(k, 11::i64);
    val v9: ^i64 = add(k, 12::i64);
    val v10: ^i64 = add(k, 13::i64);
    val v11: ^i64 = add(k, 14::i64);
    val v12: ^i64 = add(k, 15::i64);
    val v13: ^i64 = add(k, 16::i64);
    val v14: ^i64 = add(k, 17::i64);
    val v15: ^i64 = add(k, 18::i64);
    val v16: ^i64 = add(k, 19::i64);
    val v17: ^i64 = add(k, 20::i64);
    val v18: ^i64 = add(k, 21::i64);
    val v19: ^i64 = add(k, 22::i64);
    val v20: ^i64 = add(k, 23::i64);
    val v21: ^i64 = add(k, 24::i64);
    val v22: ^i64 = add(k, 25::i64);
    val v23: ^i64 = add(k, 26::i64);
    val v24: ^i64 = add(k, 27::i64);
    val v25: ^i64 = add(k, 28::i64);
    val v26: ^i64 = add(k, 29::i64);
    val v27: ^i64 = add(k, 30::i64);
    val v28: ^i64 = add(k, 31::i64);
    val v29: ^i64 = add(k, 32::i64);
    val v30: ^i64 = add(k, 33::i64);
    val v31: ^i64 = add(k, 34::i64);
    val v32: ^i64 = add(k, 35::i64);
    val v33: ^i64 = add(k, 36::i64);
    val v34: ^i64 = add(k, 37::i64);
    val v35: ^i64 = add(k, 38::i64);
    val v36: ^i64 = add(k, 39::i64);
    val v37: ^i64 = add(k, 40::i64);
    val v38: ^i64 = add(k, 41::i64);
    val v39: ^i64 = add(k, 42::i64);
    #[secret] store(near, v0);
    val at: ptr = ptr.add(pad, 65000::i64);
    #[secret] store(at, k);
    #[secret] val back: ^i64 = load[i64](at);
    val s0: ^i64 = add(back, v0);
    val s1: ^i64 = add(s0, v1);
    val s2: ^i64 = add(s1, v2);
    val s3: ^i64 = add(s2, v3);
    val s4: ^i64 = add(s3, v4);
    val s5: ^i64 = add(s4, v5);
    val s6: ^i64 = add(s5, v6);
    val s7: ^i64 = add(s6, v7);
    val s8: ^i64 = add(s7, v8);
    val s9: ^i64 = add(s8, v9);
    val s10: ^i64 = add(s9, v10);
    val s11: ^i64 = add(s10, v11);
    val s12: ^i64 = add(s11, v12);
    val s13: ^i64 = add(s12, v13);
    val s14: ^i64 = add(s13, v14);
    val s15: ^i64 = add(s14, v15);
    val s16: ^i64 = add(s15, v16);
    val s17: ^i64 = add(s16, v17);
    val s18: ^i64 = add(s17, v18);
    val s19: ^i64 = add(s18, v19);
    val s20: ^i64 = add(s19, v20);
    val s21: ^i64 = add(s20, v21);
    val s22: ^i64 = add(s21, v22);
    val s23: ^i64 = add(s22, v23);
    val s24: ^i64 = add(s23, v24);
    val s25: ^i64 = add(s24, v25);
    val s26: ^i64 = add(s25, v26);
    val s27: ^i64 = add(s26, v27);
    val s28: ^i64 = add(s27, v28);
    val s29: ^i64 = add(s28, v29);
    val s30: ^i64 = add(s29, v30);
    val s31: ^i64 = add(s30, v31);
    val s32: ^i64 = add(s31, v32);
    val s33: ^i64 = add(s32, v33);
    val s34: ^i64 = add(s33, v34);
    val s35: ^i64 = add(s34, v35);
    val s36: ^i64 = add(s35, v36);
    val s37: ^i64 = add(s36, v37);
    val s38: ^i64 = add(s37, v38);
    val s39: ^i64 = add(s38, v39);
    ret(s39);
}
