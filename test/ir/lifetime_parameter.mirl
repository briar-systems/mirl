target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a load through a block parameter every edge passes the slot's address for, where the slot has ended on one edge
pub fun parameter(x: i64, f: i1) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, x);
    cbr(f) ended, kept;
ended:
    slot.end(s);
    br join(s);
kept:
    br join(s);
join(p: ptr):
    val v: i64 = load[i64](p);
    ret(v);
}
