target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64 windows-x86_64
# a branch on the public field of a by-value record whose middle field the declaration states secret, read through
# the parameter's own memory (mirl.legal.abi, read_in_place): the read states nothing, so the walk takes the bytes
# from the declaration, finds them public and accepts. test/ir/forwarded_secret.mirl branches on the secret field

rec T0 { _0: i64; _1: i64; _2: i64; }
#[constant_time(soft)] #[secret_parameters(0 [8, 8])] pub fun probe(_0: ^T0) i64 {
    val _1: ptr = alloca[T0, pointer: ptr, align: 8]();
    store[align: 8](_1, _0);
    val _2: ptr = ptr.member[T0, member: _2](_1);
    val _3: i64 = load[i64](_2);
    val _4: i1 = eq(_3, 0);
    cbr(_4) _0, _1;
_0:
    ret(1);
_1:
    ret(2);
}
