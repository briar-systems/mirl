target { arch: "x86_64", sys: "freestanding", env: "none", abi: "win64", isa: "x86-64" };
# flags: --emit asm

# frames under win64 in an elf object, whose unwind table is call frame information and not windows' unwind
# codes: each states every rule of its prologue and of its epilogues and marks no prologue's end, so the
# listing masc reads back from the object states the frame whole. `pushed` pushes a save and moves the
# stack pointer, and `kept` keeps its frame pointer under a slot aligned past the stack

#[public_pointers(0)] ext fun sink(ptr) i64;

pub fun pushed(_0: i64) i64 {
    val _1: ptr = alloca[[8]i64, pointer: ptr, align: 8]();
    store(_1, _0);
    val _2: i64 = call sink(_1);
    val _3: ptr = ptr.index[[8]i64](_1, 1::i64);
    val _4: i64 = call sink(_3);
    val _5: i64 = add(_2, _4);
    ret(_5);
}

pub fun kept(_0: i64) i64 {
    val _1: ptr = alloca[[8]i64, pointer: ptr, align: 64]();
    store(_1, _0);
    val _2: i64 = call sink(_1);
    val _3: i64 = add(_2, _0);
    ret(_3);
}
