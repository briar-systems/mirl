target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64 windows-x86_64
# refuse:  control transfer decided by a secret value in @probe at byte
# a load the ir holds public of the secret middle field of a by-value record, from the slot the parameter is stored
# to, and a branch on it. the ir's own checks take the value as public, so only the walk can refuse the branch. the
# abi keeps the slot (mirl.legal.abi, stated_reads), since reading the parameter's memory in place would state the
# load secret against what every use of its result holds, and the walk follows the secret bytes through the frame
# slot to the branch

rec T0 { _0: i64; _1: i64; _2: i64; }
#[constant_time(soft)] #[secret_parameters(0 [8, 8])] pub fun probe(_0: ^T0) i64 {
    val _1: ptr = alloca[T0, pointer: ptr, align: 8]();
    store[align: 8](_1, _0);
    val _2: ptr = ptr.member[T0, member: _1](_1);
    val _3: i64 = load[i64](_2);
    val _4: i1 = eq(_3, 0);
    cbr(_4) _0, _1;
_0:
    ret(1);
_1:
    ret(2);
}
