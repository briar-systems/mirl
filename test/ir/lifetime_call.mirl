target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot's address passed to a call after the slot ends, which may access it while it runs
ext fun use(ptr) i64;

pub fun call(x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, x);
    slot.end(s);
    val r: i64 = call use(s);
    ret(r);
}
