target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot's address given to an assembly block after the slot ends
pub fun assembly(x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, x);
    slot.end(s);
    val r: i64 = asm["\x0a    mov {r}, qword ptr [{p}]\x0a" {r: out value i64, p: in value ptr} under "x86-64"](s);
    ret(r);
}
