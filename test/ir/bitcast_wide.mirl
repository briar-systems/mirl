target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64,avx,avx2" };
# targets: linux-x86_64
# flags: --ext avx --ext avx2

# bitcasts between vectors of 32 bytes, which avx2 holds in one ymm register, and between a float and a vector of its
# size. a vector of 64 bytes passed by value travels as two halves the convention reinterprets
pub fun ymm(p: ptr, q: ptr) i64 {
    val a: vec[8, i32] = load[vec[8, i32]](p);
    val b: vec[8, f32] = bitcast[vec[8, f32]](a);
    val c: vec[4, f64] = bitcast[vec[4, f64]](b);
    val d: vec[32, i8] = bitcast[vec[32, i8]](c);
    store(q, d);
    ret(0::i64);
}

pub fun narrow(p: ptr, q: ptr) i64 {
    val a: f64 = load[f64](p);
    val b: vec[2, f32] = bitcast[vec[2, f32]](a);
    val c: f64 = bitcast[f64](b);
    val d: f32 = load[f32](q);
    val e: vec[4, i8] = bitcast[vec[4, i8]](d);
    val f: f32 = bitcast[f32](e);
    store(p, c);
    store(q, f);
    ret(0::i64);
}

pub fun twice(a: vec[16, f32]) vec[16, f32] {
    val b: vec[16, f32] = fadd(a, a);
    ret(b);
}
