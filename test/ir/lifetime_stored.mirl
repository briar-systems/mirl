target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot's address stored as a value before the slot begins, where another party may read it
pub fun stored(q: ptr, x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    store[align: 8](q, s);
    slot.begin(s);
    store(s, x);
    val r: i64 = load[i64](s);
    slot.end(s);
    ret(r);
}
