target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64 windows-x86_64

# a branch that passes its own condition as an argument of both its edges, into a block with another predecessor
# and into the exit, as rotation leaves a loop's bottom test. a rule that takes the compare into the branch must still
# compute the condition for the edges' copies: a selection that took the branch for the compare's only reader left
# the copies reading a register nothing wrote, which the allocation checker refuses
#[inline(never)] fun keep(x: i64) i64 {
    ret(x);
}

pub fun scan(p: ptr, n: i64) i64 {
    val c0: i1 = lt.u(0, n);
    cbr(c0) pre, out(0, c0);
pre:
    br body(0, c0);
test(i: i64):
    val c: i1 = lt.u(i, n);
    cbr(c) body(i, c), out(i, c);
body(j: i64, f: i1):
    val a: ptr = ptr.add(p, j);
    val v: i8 = load[i8](a);
    val e: i1 = eq(v, 13);
    cbr(e) out(j, f), step;
step:
    val j2: i64 = add(j, 1);
    br test(j2);
out(r: i64, g: i1):
    val w: i64 = ext.u[i64](g);
    val k: i64 = call keep(r);
    val m: i64 = mul(w, 100);
    val s: i64 = add(k, m);
    ret(s);
}
