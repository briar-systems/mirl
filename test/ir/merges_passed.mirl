target { arch: "spirv", sys: "vulkan", env: "vulkan1.2", abi: "shader", isa: "spv1.5,Shader" };
# refuse: why a pointer merged where paths join stays, which logical addressing carries only through variable pointers, as the pointer, or one made from it, is read past its block or passed on an edge

# a pointer of different buffers merged where paths join and read in a loop past its block, which no path's copy
# holds, so it is refused, named. test/ir/merges.mirl holds the merges that are taken out

rec T0 { _0: [64]i32; }

#[align(4)] #[spirv.storage(12)] #[spirv.set(0)] #[spirv.binding(0)] ext var a: T0;
#[align(4)] #[spirv.storage(12)] #[spirv.set(0)] #[spirv.binding(1)] ext var b: T0;

pub fun fill(c: i1, n: i32) {
    cbr(c) left, right;
left:
    val l0: ptr[12] = ptr.member[T0, member: _0](?a);
    val l1: ptr[12] = ptr.index[[64]i32](l0, 3::i32);
    br join(l1);
right:
    val r0: ptr[12] = ptr.member[T0, member: _0](?b);
    val r1: ptr[12] = ptr.index[[64]i32](r0, 5::i32);
    br join(r1);
join(p: ptr[12]):
    br loop(0::i32);
loop(i: i32):
    store(p, i);
    val i1: i32 = add(i, 1::i32);
    val t: i1 = lt.s(i1, n);
    cbr(t) loop(i1), done;
done:
    ret();
}
