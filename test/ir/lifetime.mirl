target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };

# uses of a marked slot's address the storage rule accepts: a slot ended and begun again in one block, its storage
# reused, and accessed after the second begin, an address formed before the slot begins and used inside
# it, a slot begun and ended once per trip of a loop with its accesses in the trip, a slot begun before a loop and
# ended after it, and an address carried through a block parameter and a select of that one slot
ext fun use(ptr) i64;

pub fun trips(n: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    val m: ptr = ptr.add(s, 0::i64);
    br head(0);
head(i: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, out;
body:
    slot.begin(s);
    store(m, i);
    val r: i64 = call use(m);
    slot.end(s);
    val j: i64 = add(i, 1);
    br head(j);
out:
    ret(i);
}

pub fun spans(n: i64, f: i1) i64 {
    val s: ptr = alloca[[4]i64, pointer: ptr, align: 8]();
    slot.begin(s);
    br head(s, 0);
head(p: ptr, i: i64):
    store(p, n);
    val q: ptr = ptr.add(p, 8::i64);
    val j: i64 = add(i, 1);
    val c: i1 = lt.u(j, 4);
    cbr(c) head(q, j), out;
out:
    val a: ptr = ptr.add(s, 8::i64);
    val t: ptr = select(f, s, a);
    val v: i64 = load[i64](t);
    slot.end(s);
    ret(v);
}

pub fun reuse(x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, x);
    slot.end(s);
    slot.begin(s);
    store(s, 7::i64);
    val r: i64 = load[i64](s);
    slot.end(s);
    ret(r);
}

# a slice over a slot, its length taken from the aggregate and passed on after the slot ends: the length is a number
# kept beside the address, not the address
rec Slice { p: ptr; n: i64; }

ext fun count(i64) i64;

pub fun slice(x: i64) i64 {
    val s: ptr = alloca[[4]i64, pointer: ptr, align: 8]();
    val a: Slice = insert[member: _0](zero::Slice, s);
    val b: Slice = insert[member: _1](a, 4::i64);
    slot.begin(s);
    val q: ptr = extract[member: _0](b);
    store(q, x);
    slot.end(s);
    val n: i64 = extract[member: _1](b);
    val r: i64 = call count(n);
    ret(r);
}
