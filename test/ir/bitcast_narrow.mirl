target { arch: "aarch64", sys: "linux", env: "gnu", abi: "aapcs64", isa: "armv8-a+fp+simd" };
# targets: linux-aarch64 linux-x86_64

# bitcasts between a vector of 32 or 16 bits and an integer or a float of its size, and between a vector of 64 bits
# and a binary64
pub fun narrow(p: ptr, q: ptr) i64 {
    val a: vec[4, i8] = load[vec[4, i8]](p);
    val b: i32 = bitcast[i32](a);
    val c: vec[2, i16] = bitcast[vec[2, i16]](b);
    val d: f32 = bitcast[f32](c);
    val e: vec[4, i8] = bitcast[vec[4, i8]](d);
    store(q, e);
    val g: vec[2, i8] = load[vec[2, i8]](q);
    val h: i16 = bitcast[i16](g);
    val k: vec[2, i8] = bitcast[vec[2, i8]](h);
    val m: f16 = bitcast[f16](k);
    val n: vec[2, i8] = bitcast[vec[2, i8]](m);
    store(p, n);
    val r: vec[2, i32] = load[vec[2, i32]](p);
    val s: f64 = bitcast[f64](r);
    val t: vec[4, i16] = bitcast[vec[4, i16]](s);
    store(q, t);
    ret(0::i64);
}
