target "spirv" "vulkan" "" ""

; a structure value taken apart and rebuilt, reached through typed addresses a logical target keeps
function @aggregate: fun(ptr, i32) -> (i32) linkage global visibility default {
^entry(%p: ptr, %i: i32):
    %s = ptr.member %p, type struct {i32, struct {i32, array<2, i32>}}, member 1
    %v = load %s, type struct {i32, array<2, i32>}, align 4
    %a = extract %v, member 0
    %r = extract %v, member 1
    %b = extract %r, member 1
    %c = add %a, %b
    %w = insert %v, %c, member 0
    store %s, %w, align 4
    %t = ptr.member %s, type struct {i32, array<2, i32>}, member 1
    %e = ptr.index %t, %i, type array<2, i32>
    store %e, %c, align 4
    ret %c
}
