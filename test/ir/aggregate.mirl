target { arch: "spirv", sys: "vulkan", env: "vulkan1.0", abi: "shader", isa: "spv1.0,Shader" };

rec T0 { _0: i32; _1: [2]i32; }
rec T1 { _0: i32; _1: T0; }

ext var texture: handle[spirv.image, f32, 1, 0, 0, 0, 1, 0];
ext var sampled: handle[spirv.sampled_image, handle[spirv.image, f32, 1, 0, 0, 0, 1, 0]];

# a structure value taken apart and rebuilt, reached through typed addresses a logical target keeps
pub fun aggregate(p: ptr, i: i32) i32 {
    val s: ptr = ptr.member[T1, member: _1](p);
    val v: T0 = load[T0, align: 4](s);
    val a: i32 = extract[member: _0](v);
    val r: [2]i32 = extract[member: _1](v);
    val b: i32 = extract[member: 1](r);
    val c: i32 = add(a, b);
    val w: T0 = insert[member: _0](v, c);
    store[align: 4](s, w);
    val t: ptr = ptr.member[T0, member: _1](s);
    val e: ptr = ptr.index[[2]i32](t, i);
    store(e, c);
    ret(c);
}
