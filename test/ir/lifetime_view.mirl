target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a store through a member's address formed from a marked slot, after the slot ends
rec Pair { a: i64; b: i64; }

pub fun view(x: i64) i64 {
    val s: ptr = alloca[Pair, pointer: ptr, align: 8]();
    val m: ptr = ptr.member[Pair, member: _1](s);
    slot.begin(s);
    store(s, x);
    val v: i64 = load[i64](s);
    slot.end(s);
    store(m, v);
    ret(v);
}
