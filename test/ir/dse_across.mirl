target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# stores into slots whose address never escapes, read or not on the paths after them before the slot's storage ends:
# one no path reads goes, one a path reads, one a later trip of a loop reads, and a volatile one stay

pub fun unread(c: i1, x: i8) i8 {
    val s: ptr = alloca[i8, pointer: ptr, align: 1]();
    slot.begin(s);
    store[align: 1](s, x);
    cbr(c) a, b;
a:
    slot.end(s);
    ret(1);
b:
    slot.end(s);
    ret(2);
}

pub fun read_on_one(c: i1, x: i8) i8 {
    val s: ptr = alloca[i8, pointer: ptr, align: 1]();
    slot.begin(s);
    store[align: 1](s, x);
    cbr(c) a, b;
a:
    val v: i8 = load[i8, align: 1](s);
    slot.end(s);
    ret(v);
b:
    slot.end(s);
    ret(2);
}

pub fun looped(n: i64, x: i8) i8 {
    val s: ptr = alloca[i8, pointer: ptr, align: 1]();
    slot.begin(s);
    store[align: 1](s, 0::i8);
    br head(0);
head(i: i64):
    val v: i8 = load[i8, align: 1](s);
    val c: i1 = lt.s(i, n);
    cbr(c) body, done;
body:
    val w: i8 = add(v, x);
    store[align: 1](s, w);
    val ni: i64 = add(i, 1);
    br head(ni);
done:
    slot.end(s);
    ret(v);
}

pub fun fixed(c: i1, x: i8) i8 {
    val s: ptr = alloca[i8, pointer: ptr, align: 1]();
    slot.begin(s);
    #[volatile] store[align: 1](s, x);
    cbr(c) a, b;
a:
    slot.end(s);
    ret(1);
b:
    slot.end(s);
    ret(2);
}
