target "riscv64-linux"

; arithmetic at 8 and 16 bits for a target that computes at 32 and 64: wrapping operations, shifts by a variable count, signed and unsigned division, comparisons that feed a branch, and a secret value. the narrow values arrive and leave as i32, since the convention extends a narrower one by a signedness the ir does not state
function @narrow: fun(i32, i32, i32, i32, i32) -> (i32) {
^entry(%wa: i32, %wb: i32, %wc: i32, %wd: i32, %ws: secret i32):
    %a = trunc %wa, to i8
    %b = trunc %wb, to i8
    %c = trunc %wc, to i16
    %d = trunc %wd, to i16
    %s = trunc %ws, to i8
    %a0 = add %a, %b
    %a1 = mul %a0, %b
    %a2 = shl %a1, %b
    %a3 = shr.s %a2, %a
    %a4 = div.s %a3, %b
    %a5 = rem.u %a4, %a
    %a6 = neg %a5
    %c0 = sub %c, %d
    %c1 = xor %c0, %d
    %c2 = shr.u %c1, %d
    %c3 = div.u %c2, %d
    %c4 = rem.s %c3, %d
    %c5 = not %c4
    %e = ext.s %a6, to i16
    %f = add %c5, %e
    %t = lt.u %a, %b
    cbr %t, ^less(%f), ^more(%f)
^less(%x: i16):
    %g = gt.s %x, %c
    %h = select %g, %x, %d
    %wh = ext.s %h, to i32
    ret %wh
^more(%y: i16):
    %k = add %s, %a
    %l = ext.u %k, to i16
    %m = or %y, %l
    %wm = ext.s %m, to i32
    ret %wm
}
