target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# arithmetic at 8 and 16 bits for a target that computes at 32 and 64: wrapping operations, shifts by a variable count, signed and unsigned division, comparisons that feed a branch, and a secret value. the narrow values arrive and leave as i32, since the convention extends a narrower one by a signedness the ir does not state
pub fun narrow(wa: i32, wb: i32, wc: i32, wd: i32, ws: ^i32) i32 {
    val a: i8 = trunc[i8](wa);
    val b: i8 = trunc[i8](wb);
    val c: i16 = trunc[i16](wc);
    val d: i16 = trunc[i16](wd);
    val s: ^i8 = trunc[i8](ws);
    val a0: i8 = add(a, b);
    val a1: i8 = mul(a0, b);
    val a2: i8 = shl(a1, b);
    val a3: i8 = shr.s(a2, a);
    val a4: i8 = div.s(a3, b);
    val a5: i8 = rem.u(a4, a);
    val a6: i8 = neg(a5);
    val c0: i16 = sub(c, d);
    val c1: i16 = xor(c0, d);
    val c2: i16 = shr.u(c1, d);
    val c3: i16 = div.u(c2, d);
    val c4: i16 = rem.s(c3, d);
    val c5: i16 = not(c4);
    val e: i16 = ext.s[i16](a6);
    val f: i16 = add(c5, e);
    val t: i1 = lt.u(a, b);
    cbr(t) less(f), more(f);
less(x: i16):
    val g: i1 = gt.s(x, c);
    val h: i16 = select(g, x, d);
    val wh: i32 = ext.s[i32](h);
    ret(wh);
more(y: i16):
    val k: ^i8 = add(s, a);
    val l: ^i16 = ext.u[i16](k);
    val m: ^i16 = or(y, l);
    val wm: ^i32 = ext.s[i32](m);
    ret(wm);
}
