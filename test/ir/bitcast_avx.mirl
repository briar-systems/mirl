target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64,avx" };
# targets: linux-x86_64
# flags: --ext avx

# bitcasts between vectors of 32 bytes under avx alone, whose float lanes a ymm register holds and whose integer lanes
# are split into halves
pub fun ymm(p: ptr, q: ptr) i64 {
    val a: vec[8, f32] = load[vec[8, f32]](p);
    val b: vec[4, f64] = bitcast[vec[4, f64]](a);
    val c: vec[8, f32] = bitcast[vec[8, f32]](b);
    store(q, c);
    val d: vec[8, i32] = load[vec[8, i32]](p);
    val e: vec[8, f32] = bitcast[vec[8, f32]](d);
    store(q, e);
    ret(0::i64);
}
