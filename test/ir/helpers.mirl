target "riscv64" "linux" "lp64d" "rv64gc"

; a division of each kind at a width the target divides at, which does not trap, one by a constant that rules every trap out, and at a width wider than its arithmetic, where the divisor may fit half a word
function @divisions: fun(i32, i32, i64, i64, i128, i128) -> (i128) linkage global visibility default {
^entry(%a: i32, %b: i32, %c: i64, %d: i64, %x: i128, %y: i128):
    %q32 = div.s %a, %b
    %r32 = rem.u %a, %b
    %k32 = div.u %a, i32 10
    %q64 = div.u %c, %d
    %r64 = rem.s %c, %d
    %t32 = add %q32, %r32
    %s32 = add %t32, %k32
    %w32 = ext.s %s32, to i64
    %s64 = add %q64, %r64
    %t64 = add %s64, %w32
    %wide = ext.s %t64, to i128
    %q = div.u %x, %y
    %r = rem.s %x, %y
    %p = div.s %x, %y
    %m = rem.u %x, %y
    %s = add %q, %r
    %u = add %p, %m
    %v = add %s, %u
    %all = add %v, %wide
    ret %all
}

; the same wide divisions where the function requires constant time, which call the helpers whatever the values
function @secrets: fun(i128, i128) -> (i128) linkage global visibility default constant_time {
^entry(%x: secret i128, %y: secret i128):
    %q = div.s %x, %y
    %r = rem.u %x, %y
    %s = add %q, %r
    %o = declassify %s
    ret %o
}

; a copy and a fill of a length known only at run time, and a kept fill, which calls nothing
function @memory: fun(ptr, ptr, i64) -> () linkage global visibility default {
^entry(%p: ptr, %q: ptr, %n: i64):
    mem.copy %p, %q, %n, align 1
    mem.fill %p, i8 7, %n, align 1
    mem.fill %q, i8 0, %n, align 1 kept
    ret
}

; divisions at a width wider than two words, whose helpers take and give their integers by reference and call one another
function @wider: fun(i256, i256) -> (i256) linkage global visibility default {
^entry(%x: i256, %y: i256):
    %q = div.s %x, %y
    %r = rem.u %q, %y
    ret %r
}

; each conversion to a float of either format from an integer wider than a word, at two words and at 256 bits, whose helpers round once
function @to_floats: fun(i128, i256) -> (binary64) linkage global visibility default {
^entry(%a: i128, %b: i256):
    %as32 = itof.s %a, to binary32
    %au32 = itof.u %a, to binary32
    %bs32 = itof.s %b, to binary32
    %bu32 = itof.u %b, to binary32
    %as64 = itof.s %a, to binary64
    %au64 = itof.u %a, to binary64
    %bs64 = itof.s %b, to binary64
    %bu64 = itof.u %b, to binary64
    %a32 = fadd %as32, %au32
    %b32 = fadd %bs32, %bu32
    %s32 = fadd %a32, %b32
    %w32 = fpromote %s32, to binary64
    %a64 = fadd %as64, %au64
    %b64 = fadd %bs64, %bu64
    %s64 = fadd %a64, %b64
    %r = fadd %s64, %w32
    ret %r
}

; each conversion from a float of either format to an integer wider than a word, at two words and at 256 bits, whose helpers saturate
function @to_integers: fun(binary32, binary64) -> (i256) linkage global visibility default {
^entry(%f: binary32, %d: binary64):
    %fs128 = ftoi.s %f, to i128
    %fu128 = ftoi.u %f, to i128
    %ds128 = ftoi.s %d, to i128
    %du128 = ftoi.u %d, to i128
    %fs256 = ftoi.s %f, to i256
    %fu256 = ftoi.u %f, to i256
    %ds256 = ftoi.s %d, to i256
    %du256 = ftoi.u %d, to i256
    %f128 = add %fs128, %fu128
    %d128 = add %ds128, %du128
    %s128 = add %f128, %d128
    %w128 = ext.s %s128, to i256
    %f256 = add %fs256, %fu256
    %d256 = add %ds256, %du256
    %s256 = add %f256, %d256
    %r = add %s256, %w128
    ret %r
}

; a float remainder of each format, which no instruction of the target gives, a call of the helper of its format
function @remainders: fun(binary32, binary32, binary64, binary64) -> (binary64) linkage global visibility default {
^entry(%a: binary32, %b: binary32, %c: binary64, %d: binary64):
    %r32 = frem %a, %b
    %w = fpromote %r32, to binary64
    %r64 = frem %c, %d
    %r = fadd %r64, %w
    ret %r
}

; a division of a two-word dividend, which the target has no instruction for: at a word it divides at twice the width, and at its own word, where the dividend joined at two words takes the chain or the helper
function @long: fun(i32, i32, i32, i64, i64, i64) -> (i64) linkage global visibility default {
^entry(%h: i32, %l: i32, %d: i32, %hh: i64, %ll: i64, %dd: i64):
    %q32, %r32 = div.wide.u %h, %l, %d
    %q64, %r64 = div.wide.u %hh, %ll, %dd
    %s32 = add %q32, %r32
    %w = ext.u %s32, to i64
    %s64 = add %q64, %r64
    %all = add %s64, %w
    ret %all
}
