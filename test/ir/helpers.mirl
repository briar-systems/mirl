target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# a division of each kind at a width the target divides at, which does not trap, one by a constant that rules every trap out, and at a width wider than its arithmetic, where the divisor may fit half a word
pub fun divisions(a: i32, b: i32, c: i64, d: i64, x: i128, y: i128) i128 {
    val q32: i32 = div.s(a, b);
    val r32: i32 = rem.u(a, b);
    val k32: i32 = div.u(a, 10);
    val q64: i64 = div.u(c, d);
    val r64: i64 = rem.s(c, d);
    val t32: i32 = add(q32, r32);
    val s32: i32 = add(t32, k32);
    val w32: i64 = ext.s[i64](s32);
    val s64: i64 = add(q64, r64);
    val t64: i64 = add(s64, w32);
    val wide: i128 = ext.s[i128](t64);
    val q: i128 = div.u(x, y);
    val r: i128 = rem.s(x, y);
    val p: i128 = div.s(x, y);
    val m: i128 = rem.u(x, y);
    val s: i128 = add(q, r);
    val u: i128 = add(p, m);
    val v: i128 = add(s, u);
    val all: i128 = add(v, wide);
    ret(all);
}

# the same wide divisions where the function requires constant time, which call the helpers whatever the values
#[oblivious] pub fun secrets(x: ^i128, y: ^i128) i128 {
    val q: ^i128 = div.s(x, y);
    val r: ^i128 = rem.u(x, y);
    val s: ^i128 = add(q, r);
    val o: i128 = declassify(s);
    ret(o);
}

# a copy and a fill of a length known only at run time, and a kept fill, which calls nothing
pub fun memory(p: ptr, q: ptr, n: i64) {
    mem.copy[align: 1](p, q, n);
    mem.fill(p, 7, n);
    #[kept] mem.fill(q, 0, n);
    ret();
}

# divisions at a width wider than two words, whose helpers take and give their integers by reference and call one another
pub fun wider(x: i256, y: i256) i256 {
    val q: i256 = div.s(x, y);
    val r: i256 = rem.u(q, y);
    ret(r);
}

# each conversion to a float of either format from an integer wider than a word, at two words and at 256 bits, whose helpers round once
pub fun to_floats(a: i128, b: i256) f64 {
    val as32: f32 = itof.s[f32](a);
    val au32: f32 = itof.u[f32](a);
    val bs32: f32 = itof.s[f32](b);
    val bu32: f32 = itof.u[f32](b);
    val as64: f64 = itof.s[f64](a);
    val au64: f64 = itof.u[f64](a);
    val bs64: f64 = itof.s[f64](b);
    val bu64: f64 = itof.u[f64](b);
    val a32: f32 = fadd(as32, au32);
    val b32: f32 = fadd(bs32, bu32);
    val s32: f32 = fadd(a32, b32);
    val w32: f64 = fpromote[f64](s32);
    val a64: f64 = fadd(as64, au64);
    val b64: f64 = fadd(bs64, bu64);
    val s64: f64 = fadd(a64, b64);
    val r: f64 = fadd(s64, w32);
    ret(r);
}

# each conversion from a float of either format to an integer wider than a word, at two words and at 256 bits, whose helpers saturate
pub fun to_integers(f: f32, d: f64) i256 {
    val fs128: i128 = ftoi.s[i128](f);
    val fu128: i128 = ftoi.u[i128](f);
    val ds128: i128 = ftoi.s[i128](d);
    val du128: i128 = ftoi.u[i128](d);
    val fs256: i256 = ftoi.s[i256](f);
    val fu256: i256 = ftoi.u[i256](f);
    val ds256: i256 = ftoi.s[i256](d);
    val du256: i256 = ftoi.u[i256](d);
    val f128: i128 = add(fs128, fu128);
    val d128: i128 = add(ds128, du128);
    val s128: i128 = add(f128, d128);
    val w128: i256 = ext.s[i256](s128);
    val f256: i256 = add(fs256, fu256);
    val d256: i256 = add(ds256, du256);
    val s256: i256 = add(f256, d256);
    val r: i256 = add(s256, w128);
    ret(r);
}

# a float remainder of each format, which no instruction of the target gives, a call of the helper of its format
pub fun remainders(a: f32, b: f32, c: f64, d: f64) f64 {
    val r32: f32 = frem(a, b);
    val w: f64 = fpromote[f64](r32);
    val r64: f64 = frem(c, d);
    val r: f64 = fadd(r64, w);
    ret(r);
}

# a division of a two-word dividend, which the target has no instruction for: at a word it divides at twice the width, and at its own word, where the dividend joined at two words takes the chain or the helper
pub fun long(h: i32, l: i32, d: i32, hh: i64, ll: i64, dd: i64) i64 {
    val (q32: i32, r32: i32) = div.wide.u(h, l, d);
    val (q64: i64, r64: i64) = div.wide.u(hh, ll, dd);
    val s32: i32 = add(q32, r32);
    val w: i64 = ext.u[i64](s32);
    val s64: i64 = add(q64, r64);
    val all: i64 = add(s64, w);
    ret(all);
}
