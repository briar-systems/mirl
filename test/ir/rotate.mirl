target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# loops for loop rotation: a counted loop whose stepping value is read after it, a loop with an exit from its body
# into the header's exit, a header whose compare the body reads, a loop around a loop, a loop whose header loads and
# so stays, and a loop with two latches
pub fun counted(p: ptr, n: i64, k: i64) i64 {
    br head(0, 0);
head(i: i64, acc: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, exit;
body:
    val q: i64 = div.s(acc, k);
    val l: i64 = load[i64](p);
    val next: i64 = add(i, 1);
    val m: i64 = add(q, l);
    br head(next, m);
exit:
    val r: i64 = add(i, acc);
    ret(r);
}

pub fun early(p: ptr, n: i64, x: i64) i64 {
    br head(0);
head(i: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, done(i);
body:
    val a: ptr = ptr.add(p, i);
    val v: i64 = load[i64](a);
    val e: i1 = eq(v, x);
    cbr(e) done(i), step;
step:
    val next: i64 = add(i, 1);
    br head(next);
done(at: i64):
    ret(at);
}

pub fun shared(n: i64) i64 {
    br head(0, 0);
head(i: i64, acc: i64):
    val j: i64 = add(i, 3);
    val c: i1 = lt.s(j, n);
    cbr(c) body, exit;
body:
    val s: i64 = add(acc, j);
    val next: i64 = add(i, 1);
    br head(next, s);
exit:
    ret(j);
}

pub fun nested(n: i64, a: i64) i64 {
    br outer(0, 0);
outer(i: i64, acc: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) enter, exit;
enter:
    br inner(0, acc);
inner(j: i64, v: i64):
    val d: i1 = lt.s(j, i);
    cbr(d) step, latch;
step:
    val nj: i64 = add(j, 1);
    val nv: i64 = add(v, a);
    br inner(nj, nv);
latch:
    val ni: i64 = add(i, 1);
    br outer(ni, v);
exit:
    ret(acc);
}

pub fun loads_in_head(p: ptr) i64 {
    br head(0);
head(i: i64):
    val a: ptr = ptr.add(p, i);
    val v: i8 = load[i8](a);
    val c: i1 = ne(v, 0);
    cbr(c) body, exit;
body:
    val next: i64 = add(i, 1);
    br head(next);
exit:
    ret(i);
}

pub fun two_latches(n: i64, g: i64) i64 {
    br head(0);
head(i: i64):
    val c: i1 = lt.s(i, n);
    cbr(c) body, exit;
body:
    val next: i64 = add(i, 1);
    val f: i1 = lt.s(i, g);
    cbr(f) head(next), other;
other:
    val two: i64 = add(i, 2);
    br head(two);
exit:
    ret(i);
}
