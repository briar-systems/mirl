target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# targets: linux-x86_64 windows-x86_64

# an inline asm block containing a call clobbers caller-saved registers early, so live inputs beyond preserved registers demote rather than sitting in caller-saved registers across the call

#[inline(never)] pub fun helper() i64 {
    ret(99);
}

pub fun call_with_many_inputs(x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64) i64 {
    val out: i64 = asm["\x0a    call helper\x0a    mov {r}, {a0}\x0a    add {r}, {a1}\x0a    add {r}, {a2}\x0a    add {r}, {a3}\x0a    add {r}, {a4}\x0a    add {r}, {a5}\x0a    add {r}, {a6}\x0a    add {r}, {a7}\x0a" {r: out value i64, a0: in value i64, a1: in value i64, a2: in value i64, a3: in value i64, a4: in value i64, a5: in value i64, a6: in value i64, a7: in value i64} under "x86-64"](x0, x1, x2, x3, x4, x5, x6, x7);
    ret(out);
}
