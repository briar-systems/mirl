target { arch: "spirv", sys: "vulkan", env: "vulkan1.0", abi: "shader", isa: "spv1.0,Shader" };

# control flow the structurizer must rewrite: a cycle entered at two blocks that both hold more than a split would copy,
# a loop whose inner body leaves past the enclosing loop, and a selection whose arms reconverge on an enclosing merge
pub fun dispatch(c: i1, x: i32) i32 {
    cbr(c) a(x), b(x);
a(p: i32):
    val q: i32 = add(p, 1);
    val t: i1 = lt.s(q, 10);
    cbr(t) b(q), out(q);
b(r: i32):
    val s: i32 = mul(r, 3);
    val u: i32 = sub(s, 1);
    br a(u);
out(v: i32):
    ret(v);
}

pub fun nest(n: i32) i32 {
    br outer(0);
outer(i: i32):
    val o: i1 = lt.s(i, n);
    cbr(o) inner(0), done;
inner(j: i32):
    val p: i1 = lt.s(j, n);
    cbr(p) body, onext;
body:
    val s: i32 = add(i, j);
    val hit: i1 = eq(s, 7);
    cbr(hit) early(s), jnext;
jnext:
    val j1: i32 = add(j, 1);
    br inner(j1);
onext:
    val i1: i32 = add(i, 1);
    br outer(i1);
early(r: i32):
    ret(r);
done:
    ret(0);
}

pub fun pick(a: i1, b: i1, x: i32) i32 {
    cbr(a) inner, other;
inner:
    cbr(b) left, right;
left:
    val l: i32 = add(x, 1);
    br join(l);
right:
    val r: i32 = add(x, 2);
    br join(r);
other:
    br join(x);
join(v: i32):
    ret(v);
}
