target "spirv-vulkan"

; control flow the structurizer must rewrite: a cycle entered at two blocks that both hold more than a split would copy,
; a loop whose inner body leaves past the enclosing loop, and a selection whose arms reconverge on an enclosing merge

function @dispatch: fun(i1, i32) -> (i32) {
^entry(%c: i1, %x: i32):
    cbr %c, ^a(%x), ^b(%x)
^a(%p: i32):
    %q = add %p, i32 1
    %t = lt.s %q, i32 10
    cbr %t, ^b(%q), ^out(%q)
^b(%r: i32):
    %s = mul %r, i32 3
    %u = sub %s, i32 1
    br ^a(%u)
^out(%v: i32):
    ret %v
}

function @nest: fun(i32) -> (i32) {
^entry(%n: i32):
    br ^outer(i32 0)
^outer(%i: i32):
    %o = lt.s %i, %n
    cbr %o, ^inner(i32 0), ^done
^inner(%j: i32):
    %p = lt.s %j, %n
    cbr %p, ^body, ^onext
^body:
    %s = add %i, %j
    %hit = eq %s, i32 7
    cbr %hit, ^early(%s), ^jnext
^jnext:
    %j1 = add %j, i32 1
    br ^inner(%j1)
^onext:
    %i1 = add %i, i32 1
    br ^outer(%i1)
^early(%r: i32):
    ret %r
^done:
    ret i32 0
}

function @pick: fun(i1, i1, i32) -> (i32) {
^entry(%a: i1, %b: i1, %x: i32):
    cbr %a, ^inner, ^other
^inner:
    cbr %b, ^left, ^right
^left:
    %l = add %x, i32 1
    br ^join(%l)
^right:
    %r = add %x, i32 2
    br ^join(%r)
^other:
    br ^join(%x)
^join(%v: i32):
    ret %v
}
