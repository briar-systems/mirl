target "riscv64-linux"

; locals lowered to stack slots, for promotion: a loop counter, a value merged at a join and a slot whose address escapes
function @sink: fun(ptr) -> ()

function @count: fun(i32) -> (i32) {
^entry(%n: i32):
    %i = alloca type i32, pointer ptr, align 4
    store %i, i32 0, align 4
    br ^head
^head:
    %cur = load %i, type i32, align 4
    %c = lt.s %cur, %n
    cbr %c, ^body, ^exit
^body:
    %next = add %cur, i32 1
    store %i, %next, align 4
    br ^head
^exit:
    %r = load %i, type i32, align 4
    ret %r
}

function @escape: fun(i32) -> (i32) {
^entry(%x: i32):
    %p = alloca type i32, pointer ptr, align 4
    store %p, %x, align 4
    call ptr @sink, %p, signature fun(ptr) -> (), named all
    %v = load %p, type i32, align 4
    ret %v
}
