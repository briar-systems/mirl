target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# locals lowered to stack slots, for promotion: a loop counter, a value merged at a join and a slot whose address escapes
ext fun sink(ptr);

pub fun count(n: i32) i32 {
    val i: ptr = alloca[i32, pointer: ptr]();
    store[align: 4](i, 0::i32);
    br head;
head:
    val cur: i32 = load[i32](i);
    val c: i1 = lt.s(cur, n);
    cbr(c) body, exit;
body:
    val next: i32 = add(cur, 1);
    store(i, next);
    br head;
exit:
    val r: i32 = load[i32](i);
    ret(r);
}

pub fun escape(x: i32) i32 {
    val p: ptr = alloca[i32, pointer: ptr]();
    store(p, x);
    call sink(p);
    val v: i32 = load[i32](p);
    ret(v);
}
