target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64

# edges that pass one value to several parameters of a block whose wide parameters are split: the edge is moved to
# the words with every old argument's use taken out first, so each use taken out must not be found again by the
# renumbering of the uses taken out after it

# a loop of two 128-bit accumulators, which after rotation passes the zero words several times on one edge
#[constant_time(soft)] #[secret_parameters(0)] #[secret_result] pub fun accumulate(a: ^i128) i128 {
    br head(0, 0, a);
head(i: i64, p: ^i128, s: ^i128):
    val more: i1 = lt.u(i, 64);
    cbr(more) body, done;
body:
    val p2: ^i128 = add(p, s);
    val n: i64 = add(i, 1);
    br head(n, p2, s);
done:
    ret(p);
}

# one wide value passed to three parameters of a loop's header, in a function that does not require constant time
pub fun repeated(a: i64, b: i64, n: i64) i64 {
    val w: i128 = ext.u[i128](a);
    val v: i128 = ext.u[i128](b);
    br head(0, w, v, w);
head(i: i64, x: i128, y: i128, z: i128):
    val more: i1 = lt.u(i, n);
    cbr(more) body, done;
body:
    val s: i128 = add(x, y);
    val t: i128 = xor(s, z);
    val k: i64 = add(i, 1);
    br head(k, t, t, t);
done:
    val r: i128 = add(x, z);
    val q: i64 = trunc[i64](r);
    ret(q);
}
