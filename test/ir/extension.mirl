target "riscv64-linux"

; signatures that state the extension of narrow parameters and results, and calls that state them: direct, to a callee that states the same, and indirect, where the call alone states them
function @callee: fun(i8 sext, i8 zext, i16, i32) -> (i16 zext)

function @caller: fun(ptr, i8, i8, i16, i32) -> (i16 zext) {
^entry(%f: ptr, %a: i8, %b: i8, %c: i16, %d: i32):
    %r = call ptr @callee, %a, %b, %c, %d, signature fun(i8 sext, i8 zext, i16, i32) -> (i16 zext)
    %s = call %f, %a, %c, signature fun(i8 zext, i16 sext) -> (i16 sext)
    %t = call %f, %a, signature fun(i8) -> (i16)
    %u = add %r, %s
    %v = add %u, %t
    ret %v
}
