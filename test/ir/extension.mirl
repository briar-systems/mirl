target "riscv64-linux"

; signatures that state the extension of narrow parameters and results, and calls that state them: direct, to a callee that states the same, and indirect, where the call alone states them or states none for a width the convention extends without one
function @callee: fun(i8 sext, i8 zext, i16 sext, i32) -> (i16 zext) linkage global visibility default

function @caller: fun(ptr, i8 sext, i8 zext, i16 sext, i32) -> (i16 zext) linkage global visibility default {
^entry(%f: ptr, %a: i8, %b: i8, %c: i16, %d: i32):
    %r = call ptr @callee, %a, %b, %c, %d, signature fun(i8 sext, i8 zext, i16 sext, i32) -> (i16 zext), named all
    %s = call %f, %a, %c, signature fun(i8 zext, i16 sext) -> (i16 sext), named all
    %t = call %f, %d, signature fun(i32) -> (i32), named all
    %w = trunc %t, to i16
    %u = add %r, %s
    %v = add %u, %w
    ret %v
}
