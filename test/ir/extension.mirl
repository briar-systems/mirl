target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# signatures that state the extension of narrow parameters and results, and calls that state them: direct, to a callee that states the same, and indirect, where the call alone states them or states none for a width the convention extends without one
ext fun callee(i8 sext, i8 zext, i16 sext, i32) i16 zext;

pub fun caller(f: ptr, a: i8 sext, b: i8 zext, c: i16 sext, d: i32) i16 zext {
    val r: i16 = call callee(a, b, c, d);
    val s: i16 = call[fun(i8 zext, i16 sext) i16 sext] f(a, c);
    val t: i32 = call[fun(i32) i32] f(d);
    val w: i16 = trunc[i16](t);
    val u: i16 = add(r, s);
    val v: i16 = add(u, w);
    ret(v);
}
