target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

rec T0 { _0: i32; _1: i32; }
uni T1 { _0: i32; _1: i8; }
rec T2 { _0: i8; _1: T1; }
rec T3 { _0: ptr; }
rec T4 { _0: i32; _1: ptr; }
rec T5 { _0: i32 at 0; _1: i64 at 8; }
uni T6 { _0: i32; _1: f32; }
rec T7 { _0: ptr; _1: ptr; }

# the debug table: an entry of every kind, one declared and not yet defined, and a type naming a later one
debug {
    file f0 = "a.mach";
    file f1 = "dir/b \"quoted\".mach";
    loc l0 = f0:3:1;
    loc l1 = f0:4:2;
    loc l2 = f1:10:7;
    site s0 = "inner" at l1;
    site s1 = "outer" at l0 in s0;
    type t0 = "i32" "i32" base(signed, 32);
    type t1 = "u8" "u8" base(unsigned, 8);
    type t2 = "f32" "f32" base(float, 32);
    type t3 = "bool" "bool" base(boolean, 1);
    type t4 = "char" "char" base(character, 8);
    type t5 = "addr" "addr" base(address, 64);
    type t6 = "point.Point" "point.Point" structure(T0) {"x": t0 field 0, "y": t0 field 1};
    type t7 = "point.Number" "point.Number" union(T1) {"i": t0 field 0, "b": t1 field 1};
    type t8 = "point.Tag" "point.Tag" tagged(T2) discriminant "tag": t1 field 0 payload 1 {"none": 0, "some": 1 payload "i": t0 field 0};
    type t9 = "point.Color" "point.Color" enumeration(t1) {"red": 0, "green": 1};
    type t10 = "point.Quad" "point.Quad" array(t0, 4);
    type t11 = "*point.Point" "*point.Point" pointer("point.Point");
    type t12 = "main.sig" "main.sig" function(t0, t13) (t0);
    type t13 = "later.Node" "later.Node" structure(T3) {"next": t11 field 0};
    type t14 = "open.Struct" "" structure(T0) open;
    type t15 = "open.Union" "" union(T1) open;
    type t16 = "open.Tag" "" tagged(T2) open;
    type t17 = "open.Enum" "" enumeration open;
    type t18 = "open.Array" "" array open;
    type t19 = "open.Fun" "" function open;
    var v0 = "x": t0 at l0 parameter 0;
    var v1 = "p": t6 at l1;
    var v2 = "weird name": t13 at l2;
    var v3 = "wide": t5 at l2;
}

# globals: every constant form, linkage, visibility, constant, alignment, section and tls
#[align(8)] #[export] pub var counter: i32 = 7;
#[visibility(hidden)] var "has space\"": i32 = 0;
#[section(".tdata", tdata)] #[tls(initial_exec)] #[export] #[weak] #[visibility(protected)] pub var slot: i64 = -1;
#[tls(general_dynamic)] #[unique] #[visibility(internal)] pub var gd: i8 = zero;
#[tls(local_dynamic)] ext var ld: i8;
#[tls(local_exec)] ext var le: i8;
pub var wide: i128 = 0x123456789abcdef0123456789abcdef0;
pub var wide_negative: i256 = -2;
pub var single: f32 = 0x3f800000;
pub var double: f64 = 0x400921fb54442d18;
pub var half: f16 = 0x3c00;
pub var bytes: [3]i8 = {1, 2, -3};
pub var lanes: vec[2, i32] = {1, -2};
pub var zeroes: [4]i32 = zero;
pub var strided: [3, stride 4]i16 = {1, 2, -3};
pub var record: T4 = {1, ?counter + 4};
#[align(16)] pub var placed: T5 = {1, 2};
pub var space: ptr[3] = zero;
pub var merged: T6 = zero;
pub var callback: ptr = ?main;
pub var behind: ptr = ?counter - 4;
pub var ping: ptr = ?pong;
pub var pong: ptr = ?ping;
pub var later: T7 = {?defined_last, ?helper};
ext var defined_last: i32;
val limit: i32 = 9;
#[visibility(hidden)] val vtable: ptr = ?main;
#[align(4)] #[section(".text.boot", text)] #[visibility(hidden)] val boot: i32 = 1;
ext val extern_limit: i32;

# a function declared here and defined by another module, referenced above before it is declared
#[weak] #[visibility(protected)] ext fun helper(i32) i32;

# a body: block parameters, branch arguments, forward references to blocks and values, names that need quoting, a metadata record and value binding records at a block's entry, before an instruction, through a salvage expression and unavailable
#[export] pub fun main(x: i32, p: ptr) i32 {
    bind v0 = x;
    val a: i32 = add(x, 1) at l0;
    bind v0 = a;
    bind v2 = 7::i32;
    #[volatile] val v: i32 = load[i32](p);
    val c: i1 = lt.s(a, v) at l1 in s1;
    cbr(c) then(a), else_block;
else_block:
    bind v3 = add(ext.s[i64](sub(a, 1)), 4);
    store(p, v);
    #[secret] val s: i32 = add(a, v);
    val slot_1: ptr = alloca[i32, pointer: ptr]() holds [v1];
    bind v2 = unavailable;
    br join(a);
then(t: i32):
    bind v0 = t;
    val odd_name: i32 = add(x, x);
    val m: i32 = mul(t, odd_name);
    val kept: i32 = call helper(m);
    br join(kept);
join(j: i32):
    val later_sum: i32 = add(j, x);
    val (r: i32, overflow: i1) = add.ov.s(j, -1);
    ret(later_sum);
}

#[oblivious] #[visibility(hidden)] fun numbers(f: f32, vec: vec[4, i32], n: ^i64) vec[4, i32] {
    val g: f32 = fadd(f, 0x40000000);
    val lane: i32 = vextract[lane: 2](vec);
    val splat: vec[4, i32] = vsplat[vec[4, i32]](lane);
    val mix: vec[4, i32] = vshuffle[vec[4, i32], lanes: [0, 5, 2, 7]](vec, splat);
    val wide_1: i64 = ext.u[i64](lane);
    val ptr: ptr = inttoptr[ptr](wide_1);
    val (old: i32, won: i1) = atomic.cmpxchg[success: seq_cst, failure: acquire](ptr, 0, 1);
    fence[order: release]();
    val same: i32 = select(1, lane, 5);
    val plain: i64 = declassify(n);
    unreachable();
}
