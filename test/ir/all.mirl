target "riscv64-linux"


; the debug table: an entry of every kind, one declared and not yet defined, and a type naming a later one
!f0 = file "a.mach"
!f1 = file "dir/b \"quoted\".mach"
!l0 = location !f0 3:1
!l1 = location !f0 4:2
!l2 = location !f1 10:7
!s0 = site !l1 "inner"
!s1 = site !l0 "outer" parent !s0
!t0 = type "i32" "i32" base signed 32
!t1 = type "u8" "u8" base unsigned 8
!t2 = type "f32" "f32" base float 32
!t3 = type "bool" "bool" base boolean 1
!t4 = type "char" "char" base character 8
!t5 = type "addr" "addr" base address 64
!t6 = type "point.Point" "point.Point" structure struct{i32, i32} {"x": !t0 field 0, "y": !t0 field 1}
!t7 = type "point.Number" "point.Number" union union{i32, i8} {"i": !t0 field 0, "b": !t1 field 1}
!t8 = type "point.Tag" "point.Tag" tagged struct{i8, union{i32, i8}} discriminant "tag": !t1 field 0 payload 1 {"none" 0, "some" 1 payload "i": !t0 field 0}
!t9 = type "point.Color" "point.Color" enumeration !t1 {"red" 0, "green" 1}
!t10 = type "point.Quad" "point.Quad" array !t0 4
!t11 = type "*point.Point" "*point.Point" pointer "point.Point"
!t12 = type "main.sig" "main.sig" function (!t0, !t13) -> (!t0)
!t13 = type "later.Node" "later.Node" structure struct{ptr} {"next": !t11 field 0}
!t14 = type "open.Struct" "" structure struct{i32, i32} open
!t15 = type "open.Union" "" union union{i32, i8} open
!t16 = type "open.Tag" "" tagged struct{i8, union{i32, i8}} open
!t17 = type "open.Enum" "" enumeration open
!t18 = type "open.Array" "" array open
!t19 = type "open.Fun" "" function open
!v0 = variable "x" !t0 declared !l0 parameter 0
!v1 = variable "p" !t6 declared !l1
!v2 = variable "weird name" !t13 declared !l2
!v3 = variable "wide" !t5 declared !l2

; globals: every constant form, linkage, visibility, constant, alignment, section and tls
export global @counter: i32 linkage global visibility default align 8 = i32 7
global @"has space\"": i32 linkage local visibility hidden = i32 0
export global @slot: i64 linkage weak visibility protected section ".tdata" tdata tls initial_exec = i64 -1
global @gd: i8 linkage unique visibility internal tls general_dynamic = i8 zero
global @ld: i8 linkage global visibility default tls local_dynamic
global @le: i8 linkage global visibility default tls local_exec
global @wide: i128 linkage global visibility default = i128 0x123456789abcdef0123456789abcdef0
global @wide_negative: i256 linkage global visibility default = i256 -2
global @single: binary32 linkage global visibility default = binary32 0x3f800000
global @double: binary64 linkage global visibility default = binary64 0x400921fb54442d18
global @half: binary16 linkage global visibility default = binary16 0x3c00
global @bytes: array<3, i8> linkage global visibility default = array<3, i8> {i8 1, i8 2, i8 -3}
global @lanes: vec<2, i32> linkage global visibility default = vec<2, i32> {i32 1, i32 -2}
global @zeroes: array<4, i32> linkage global visibility default = array<4, i32> zero
global @record: struct{i32, ptr} linkage global visibility default = struct{i32, ptr} {i32 1, ptr @counter + 4}
global @placed: struct at{0: i32, 8: i64} linkage global visibility default align 16 = struct at{0: i32, 8: i64} {i32 1, i64 2}
global @space: ptr<3> linkage global visibility default = ptr<3> zero
global @merged: union{i32, binary32} linkage global visibility default = union{i32, binary32} zero
global @opaque: handle<spirv.image> linkage global visibility default
global @callback: ptr linkage global visibility default = ptr @main
global @behind: ptr linkage global visibility default = ptr @counter - 4
global @ping: ptr linkage global visibility default = ptr @pong
global @pong: ptr linkage global visibility default = ptr @ping
global @later: struct{ptr, ptr} linkage global visibility default = struct{ptr, ptr} {ptr @defined_last, ptr @helper}
global @defined_last: i32 linkage global visibility default
global @limit: i32 linkage local visibility default constant = i32 9
global @vtable: ptr linkage local visibility hidden constant = ptr @main
global @boot: i32 linkage local visibility hidden constant align 4 section ".text.boot" text = i32 1
global @extern_limit: i32 linkage global visibility default constant

; a function declared here and defined by another module, referenced above before it is declared
function @helper: fun(i32) -> (i32) linkage weak visibility protected

; a body: block parameters, branch arguments, forward references to blocks and values, names that need quoting, a metadata record and value binding records at a block's entry, before an instruction, through a salvage expression and unavailable
export function @main: fun(i32, ptr) -> (i32) linkage global visibility default {
^entry(%x: i32, %p: ptr):
    bind !v0 = %x
    %a = add %x, i32 1 loc !l0
    bind !v0 = %a
    bind !v2 = i32 7
    %v = load %p, type i32, align 4 volatile
    %c = lt.s %a, %v loc !l1 site !s1
    cbr %c, ^then(%a), ^"else block"
^"else block":
    bind !v3 = %a, sub i32 1, ext.s i64, add i64 4
    store %p, %v, align 4
    %s = add %a, %v secret
    %slot = alloca type i32, pointer ptr, align 4 bind [!v1]
    bind !v2 unavailable
    br ^join(%a)
^then(%t: i32):
    bind !v0 = %t
    %"odd name" = add %x, %x
    %m = mul %t, %"odd name"
    %kept = call ptr @helper, %m, signature fun(i32) -> (i32), named all
    br ^join(%kept)
^join(%j: i32):
    %later_sum = add %j, %x
    %r, %overflow = add.ov.s %j, i32 -1
    ret %later_sum
}

function @numbers: fun(binary32, vec<4, i32>, i64) -> (vec<4, i32>) linkage local visibility hidden constant_time {
^entry(%f: binary32, %vec: vec<4, i32>, %n: secret i64):
    %g = fadd %f, binary32 0x40000000
    %lane = vextract %vec, lane 2
    %splat = vsplat %lane, vector vec<4, i32>
    %mix = vshuffle %vec, %splat, vector vec<4, i32>, lanes [0, 5, 2, 7]
    %wide = ext.u %lane, to i64
    %ptr = inttoptr %wide, to ptr
    %old, %won = atomic.cmpxchg %ptr, i32 0, i32 1, success seq_cst, failure acquire
    fence order release
    %same = select i1 1, %lane, i32 5
    %plain = declassify %n
    unreachable
}
