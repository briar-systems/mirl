target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot begun once before a loop and ended in the loop's body, loaded at the head: the first trip finds it begun,
# and only the back edge brings it there ended
pub fun backedge(n: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, n);
    br head(0);
head(i: i64):
    val v: i64 = load[i64](s);
    val c: i1 = lt.s(i, n);
    cbr(c) body, out;
body:
    slot.end(s);
    val j: i64 = add(i, 1);
    br head(j);
out:
    ret(v);
}
