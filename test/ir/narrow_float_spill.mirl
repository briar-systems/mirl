target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64

# narrow float spills (f32/f64) sharing vector registers must not propagate full-vector pairs or drop full-width copies under the value map

#[inline(never)] fun keep_vec(x: vec[4, f32]) vec[4, f32] {
    ret(x);
}

#[inline(never)] fun keep_f32(x: f32) f32 {
    ret(x);
}

#[inline(never)] fun keep_f64(x: f64) f64 {
    ret(x);
}

pub fun mix(v0: vec[4, f32], v1: vec[4, f32], c: i1) f64 {
    val a0: f32 = vextract[lane: 0](v0);
    val a1: f32 = fadd(a0, 0x3f800000);
    val a2: f32 = fadd(a0, 0x40000000);
    val a3: f32 = fadd(a0, 0x40400000);
    val a4: f32 = fadd(a1, a2);
    val a5: f32 = fadd(a2, a3);
    val a6: f32 = fadd(a3, a4);
    val a7: f32 = fadd(a4, a5);
    val a8: f32 = fadd(a5, a6);
    val a9: f32 = fadd(a6, a7);
    val a10: f32 = fadd(a7, a8);
    val a11: f32 = fadd(a8, a9);
    val a12: f32 = fadd(a9, a10);
    val a13: f32 = fadd(a10, a11);
    val a14: f32 = fadd(a11, a12);
    val a15: f32 = fadd(a12, a13);
    val a16: f32 = fadd(a13, a14);
    val a17: f32 = fadd(a14, a15);

    val w0: vec[4, f32] = fadd(v0, v1);
    val w1: vec[4, f32] = fsub(v0, v1);
    val d0: f64 = fpromote[f64](a0);
    val d1: f64 = fpromote[f64](a1);

    cbr(c) left, right;
left:
    val l0: vec[4, f32] = call keep_vec(w0);
    val lf: f32 = call keep_f32(a1);
    val ld: f64 = call keep_f64(d1);
    br join(l0, lf, ld);
right:
    val r0: vec[4, f32] = call keep_vec(w1);
    val rf: f32 = call keep_f32(a2);
    val rd: f64 = call keep_f64(d0);
    br join(r0, rf, rd);
join(jv: vec[4, f32], jf: f32, jd: f64):
    val e0: f32 = vextract[lane: 0](jv);
    val e1: f32 = vextract[lane: 3](jv);
    val s0: f32 = fadd(jf, a0);
    val s1: f32 = fadd(s0, a4);
    val s2: f32 = fadd(s1, a8);
    val s3: f32 = fadd(s2, a12);
    val s4: f32 = fadd(s3, a16);
    val s5: f32 = fadd(s4, a17);
    val s6: f32 = fadd(s5, e0);
    val s7: f32 = fadd(s6, e1);
    val wd: f64 = fpromote[f64](s7);
    val res0: f64 = fadd(wd, jd);
    val res1: f64 = fadd(res0, d0);
    val res2: f64 = fadd(res1, d1);
    ret(res2);
}
