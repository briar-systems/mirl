target "riscv64" "linux" "lp64d" "rv64gc"

; shifts of every kind at several widths and as vectors, a count the mask bounds, a count a comparison bounds, a constant count, a secret count in a constant time function, and a count that is out of range. the i8 arrives as i32, since the convention extends a narrower one by a signedness the ir does not state
function @counts: fun(i32, i32, i64, i128, vec<4, i32>, i1) -> (i64) linkage global visibility default {
^entry(%wa: i32, %b: i32, %c: i64, %d: i128, %v: vec<4, i32>, %f: i1):
    %a = trunc %wa, to i8
    %a0 = shl %a, %a
    %a1 = shr.s %a0, %a
    %b0 = shl %b, %b
    %b1 = shr.u %b0, %b
    %b2 = shr.s %b1, %b
    %m = and %b, i32 7
    %b3 = shl %b2, %m
    %b4 = shr.u %b3, i32 3
    %b5 = shl %b4, i32 40
    %c0 = shl %c, %c
    %c1 = shr.s %c0, %c
    %d0 = shl %d, %d
    %d1 = shr.u %d0, %d
    %v0 = shl %v, %v
    %v1 = shr.s %v0, %v
    %f0 = shl %f, %f
    %f1 = shr.s %f, %f
    %e = ext.u %a1, to i64
    %g = ext.u %b5, to i64
    %h = add %e, %g
    %i = add %h, %c1
    ret %i
}

function @guarded: fun(i32, i32) -> (i32) linkage global visibility default {
^entry(%x: i32, %c: i32):
    %in = lt.u %c, i32 32
    cbr %in, ^shift, ^out
^shift:
    %r = shl %x, %c
    ret %r
^out:
    ret i32 0
}

function @secret: fun(i64, i64) -> (i64) linkage global visibility default constant_time {
^entry(%x: i64, %k: secret i64):
    %r = shl %x, %k
    %s = shr.s %r, %k
    ret %s
}
