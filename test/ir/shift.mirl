target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# shifts of every kind at several widths and as vectors, a count the mask bounds, a count a comparison bounds, a constant count, a secret count in a constant time function, and a count that is out of range. the i8 arrives as i32, since the convention extends a narrower one by a signedness the ir does not state
pub fun counts(wa: i32, b: i32, c: i64, d: i128, v: vec[4, i32], f: i1) i64 {
    val a: i8 = trunc[i8](wa);
    val a0: i8 = shl(a, a);
    val a1: i8 = shr.s(a0, a);
    val b0: i32 = shl(b, b);
    val b1: i32 = shr.u(b0, b);
    val b2: i32 = shr.s(b1, b);
    val m: i32 = and(b, 7);
    val b3: i32 = shl(b2, m);
    val b4: i32 = shr.u(b3, 3);
    val b5: i32 = shl(b4, 40);
    val c0: i64 = shl(c, c);
    val c1: i64 = shr.s(c0, c);
    val d0: i128 = shl(d, d);
    val d1: i128 = shr.u(d0, d);
    val v0: vec[4, i32] = shl(v, v);
    val v1: vec[4, i32] = shr.s(v0, v);
    val f0: i1 = shl(f, f);
    val f1: i1 = shr.s(f, f);
    val e: i64 = ext.u[i64](a1);
    val g: i64 = ext.u[i64](b5);
    val h: i64 = add(e, g);
    val i: i64 = add(h, c1);
    ret(i);
}

pub fun guarded(x: i32, c: i32) i32 {
    val in: i1 = lt.u(c, 32);
    cbr(in) shift, out;
shift:
    val r: i32 = shl(x, c);
    ret(r);
out:
    ret(0);
}

#[oblivious] pub fun secret(x: i64, k: ^i64) i64 {
    val r: ^i64 = shl(x, k);
    val s: ^i64 = shr.s(r, k);
    ret(s);
}
