target { arch: "riscv32", sys: "linux", env: "gnu", abi: "ilp32d", isa: "rv32gc" };

# a 64 bit product by a constant, split into words whose high halves are the high multiply
pub fun f(x: i64) i64 {
    val y: i64 = mul(x, 2);
    ret(y);
}

# the high multiplies at a narrow width, at the word read each way and by a constant, and at a wide width
pub fun g(a: i32, b: i32, c: i32, d: i32, e: i64, f_1: i64) i64 {
    val a1: i16 = trunc[i16](a);
    val b1: i16 = trunc[i16](b);
    val h: i16 = mul.high.u(a1, b1);
    val i: i32 = mul.high.su(c, d);
    val j: i64 = mul.high.s(e, f_1);
    val k: i32 = mul.high.s(c, 7);
    val h0: i64 = ext.u[i64](h);
    val i0: i64 = ext.s[i64](i);
    val k0: i64 = ext.s[i64](k);
    val s0: i64 = add(h0, i0);
    val s1: i64 = add(s0, j);
    val s2: i64 = add(s1, k0);
    ret(s2);
}
