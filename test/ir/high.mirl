target "riscv32-linux"

; a 64 bit product by a constant, split into words whose high halves are the high multiply
function @f: fun(i64) -> (i64) linkage global visibility default {
^entry(%x: i64):
    %y = mul %x, i64 2
    ret %y
}

; the high multiplies at a narrow width, at the word read each way and by a constant, and at a wide width
function @g: fun(i32, i32, i32, i32, i64, i64) -> (i64) linkage global visibility default {
^entry(%a: i32, %b: i32, %c: i32, %d: i32, %e: i64, %f: i64):
    %a1 = trunc %a, to i16
    %b1 = trunc %b, to i16
    %h = mul.high.u %a1, %b1
    %i = mul.high.su %c, %d
    %j = mul.high.s %e, %f
    %k = mul.high.s %c, i32 7
    %h0 = ext.u %h, to i64
    %i0 = ext.s %i, to i64
    %k0 = ext.s %k, to i64
    %s0 = add %h0, %i0
    %s1 = add %s0, %j
    %s2 = add %s1, %k0
    ret %s2
}
