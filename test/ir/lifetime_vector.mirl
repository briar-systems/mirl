target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot's address put in a vector and taken out of a lane, loaded through after the slot ends
pub fun vector(x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    val v: vec[2, ptr] = vbuild[vec[2, ptr]](s, s);
    val p: ptr = vextract[lane: 0](v);
    slot.begin(s);
    store(s, x);
    slot.end(s);
    val r: i64 = load[i64](p);
    ret(r);
}
