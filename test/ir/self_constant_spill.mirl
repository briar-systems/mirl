target { arch: "x86_64", sys: "darwin", env: "none", abi: "sysv64", isa: "x86-64" };
# targets: darwin-x86_64 linux-x86_64
# flags: --ext ssse3

# self-constant vector and scalar idioms defined after a call and spilled across a call, in both packed vector and constant-time functions
#[constant_time(soft)] #[secret_parameters(0)] #[secret_result] ext fun touch(i64) i64;
#[constant_time(soft)] #[secret_parameters(0)] #[secret_result] ext fun keep_vec(vec[4, i32]) vec[4, i32];

#[constant_time(soft)] #[secret_parameters(0, 1)] #[secret_result] pub fun spill_after_call(s: ^i64, d: ^vec[4, i32], a: vec[16, i8], b: vec[16, i8], w: vec[8, i8]) i64 {
    val t: ^i64 = call touch(s);
    val c: vec[16, i1] = ne(a, b);
    val m: vec[16, i8] = ext.s[vec[16, i8]](c);
    val w16: vec[8, i16] = ext.u[vec[8, i16]](w);
    val z0: vec[4, i32] = vsplat[vec[4, i32]](0::i32);
    val x0: ^vec[4, i32] = xor(d, d);
    val deq: ^vec[4, i1] = eq(d, d);
    val o0: ^vec[4, i32] = ext.s[vec[4, i32]](deq);
    val d0: ^vec[4, i32] = sub(d, d);
    val i0: ^i64 = sub(t, t);
    val kept: ^vec[4, i32] = call keep_vec(d);
    val k0: ^i32 = vextract[lane: 0](kept);
    val mz: i8 = vextract[lane: 0](m);
    val wz: i16 = vextract[lane: 0](w16);
    val zz: i32 = vextract[lane: 0](z0);
    val xz: ^i32 = vextract[lane: 0](x0);
    val oz: ^i32 = vextract[lane: 0](o0);
    val dz: ^i32 = vextract[lane: 0](d0);
    val ek: ^i64 = ext.s[i64](k0);
    val em: i64 = ext.s[i64](mz);
    val ew: i64 = ext.s[i64](wz);
    val ez: i64 = ext.s[i64](zz);
    val ex: ^i64 = ext.s[i64](xz);
    val eo: ^i64 = ext.s[i64](oz);
    val ed: ^i64 = ext.s[i64](dz);
    val r0: ^i64 = add(t, i0);
    val r1: ^i64 = add(r0, ek);
    val r2: ^i64 = add(r1, em);
    val r3: ^i64 = add(r2, ew);
    val r4: ^i64 = add(r3, ez);
    val r5: ^i64 = add(r4, ex);
    val r6: ^i64 = add(r5, eo);
    val r7: ^i64 = add(r6, ed);
    ret(r7);
}

pub fun sse_packed_self_constant(d: vec[4, i32], a: vec[16, i8], b: vec[16, i8], w: vec[8, i8]) i64 {
    val c: vec[16, i1] = ne(a, b);
    val m: vec[16, i8] = ext.s[vec[16, i8]](c);
    val w16: vec[8, i16] = ext.u[vec[8, i16]](w);
    val z0: vec[4, i32] = vsplat[vec[4, i32]](0::i32);
    val x0: vec[4, i32] = xor(d, d);
    val deq: vec[4, i1] = eq(d, d);
    val o0: vec[4, i32] = ext.s[vec[4, i32]](deq);
    val kept: vec[4, i32] = call keep_vec(d);
    val k0: i32 = vextract[lane: 0](kept);
    val mz: i8 = vextract[lane: 0](m);
    val wz: i16 = vextract[lane: 0](w16);
    val zz: i32 = vextract[lane: 0](z0);
    val xz: i32 = vextract[lane: 0](x0);
    val oz: i32 = vextract[lane: 0](o0);
    val ek: i64 = ext.s[i64](k0);
    val em: i64 = ext.s[i64](mz);
    val ew: i64 = ext.s[i64](wz);
    val ez: i64 = ext.s[i64](zz);
    val ex: i64 = ext.s[i64](xz);
    val eo: i64 = ext.s[i64](oz);
    val r0: i64 = add(ek, em);
    val r1: i64 = add(r0, ew);
    val r2: i64 = add(r1, ez);
    val r3: i64 = add(r2, ex);
    val r4: i64 = add(r3, eo);
    ret(r4);
}
