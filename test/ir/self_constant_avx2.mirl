target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64,avx,avx2" };
# targets: linux-x86_64
# flags: --ext avx --ext avx2

# avx2 self-constant 256-bit vector xor, compare, not, and signed shift idioms across a call
ext fun touch(vec[8, i32]) vec[8, i32];

pub fun avx2_self_constant(d: vec[8, i32], a: vec[32, i8], b: vec[32, i8], q: vec[4, i64], sh: vec[4, i64]) i64 {
    val t: vec[8, i32] = call touch(d);
    val z0: vec[8, i32] = vsplat[vec[8, i32]](0::i32);
    val x0: vec[8, i32] = xor(t, t);
    val deq: vec[8, i1] = eq(t, t);
    val o0: vec[8, i32] = ext.s[vec[8, i32]](deq);
    val inv: vec[8, i32] = not(z0);
    val ne8: vec[32, i1] = ne(a, b);
    val m8: vec[32, i8] = ext.s[vec[32, i8]](ne8);
    val qs: vec[4, i64] = shr.s(q, sh);
    val t2: vec[8, i32] = call touch(t);
    val k0: i32 = vextract[lane: 0](t2);
    val zz: i32 = vextract[lane: 0](z0);
    val xz: i32 = vextract[lane: 0](x0);
    val oz: i32 = vextract[lane: 0](o0);
    val iz: i32 = vextract[lane: 0](inv);
    val mz: i8 = vextract[lane: 0](m8);
    val qz: i64 = vextract[lane: 0](qs);
    val ek: i64 = ext.s[i64](k0);
    val ez: i64 = ext.s[i64](zz);
    val ex: i64 = ext.s[i64](xz);
    val eo: i64 = ext.s[i64](oz);
    val ei: i64 = ext.s[i64](iz);
    val em: i64 = ext.s[i64](mz);
    val r0: i64 = add(ek, ez);
    val r1: i64 = add(r0, ex);
    val r2: i64 = add(r1, eo);
    val r3: i64 = add(r2, ei);
    val r4: i64 = add(r3, em);
    val r5: i64 = add(r4, qz);
    ret(r5);
}
