target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# targets: linux-x86_64 linux-aarch64 linux-riscv64

# secrets in functions that do not require constant time, which every pass optimises as any other value while the
# ir's typing holds: a result as secret as its row gives, no secret passed to a public parameter, no access stated
# public with a secret operand

# a sum over a public array from a secret start, which the vectoriser takes with its index as secret as the start
#[secret_parameters(1)] #[secret_result] pub fun sum_from(a: ptr, k: ^i64, n: i64) i64 {
    br head(k, 0);
head(i: ^i64, s: ^i64):
    val more: ^i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val e: ^ptr = ptr.index[[1024]i64](a, i);
    val v: i64 = load[i64](e);
    val t: ^i64 = add(s, v);
    val j: ^i64 = add(i, 1);
    br head(j, t);
done:
    ret(s);
}

# a copy of public arrays up to a secret bound with a public index, which the vectoriser leaves, as the trip count it
# would make a value would pass the public index a secret
#[secret_parameters(2)] pub fun copy_to(d: ptr, s: ptr, n: ^i64) {
    br head(0);
head(i: i64):
    val more: ^i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val f: ptr = ptr.index[[1024]i64](s, i);
    #[public] val v: i64 = load[i64](f);
    val t: ptr = ptr.index[[1024]i64](d, i);
    #[public] store(t, v);
    val j: i64 = add(i, 1);
    br head(j);
done:
    ret();
}

# a copy from a secret start to a secret bound, which becomes one copy stating nothing, as its length is secret
#[secret_parameters(2, 3)] pub fun copy_run(d: ptr, s: ptr, k: ^i64, n: ^i64) {
    br head(k);
head(i: ^i64):
    val more: ^i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val f: ^ptr = ptr.index[[1024]i64](s, i);
    val v: i64 = load[i64](f);
    val t: ^ptr = ptr.index[[1024]i64](d, i);
    store(t, v);
    val j: ^i64 = add(i, 1);
    br head(j);
done:
    ret();
}

# a fill of secret bytes up to a public bound, which becomes one fill stating its memory secret
#[secret_parameters(1)] pub fun fill_secret(d: ptr, w: ^i64, n: i64) {
    val x: ^i8 = trunc[i8](w);
    br head(0);
head(i: i64):
    val more: i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val t: ptr = ptr.index[[1024]i8](d, i);
    #[secret] store(t, x);
    val j: i64 = add(i, 1);
    br head(j);
done:
    ret();
}

# a branch on a secret into a public parameter, which if-conversion leaves, and into a secret one, which it selects
#[secret_parameters(0)] pub fun branch_public(x: ^i64, a: i64, b: i64) i64 {
    val c: ^i1 = lt.u(x, 8);
    cbr(c) t, e;
t:
    val p: i64 = add(a, 1);
    br j(p);
e:
    val q: i64 = add(b, 2);
    br j(q);
j(r: i64):
    ret(r);
}

#[secret_parameters(0)] #[secret_result] pub fun branch_secret(x: ^i64, a: i64, b: i64) i64 {
    val c: ^i1 = lt.u(x, 8);
    cbr(c) t, e;
t:
    val p: i64 = add(a, 1);
    br j(p);
e:
    val q: i64 = add(b, 2);
    br j(q);
j(r: ^i64):
    ret(r);
}

# a public store forwarded to a secret load, which lowers what used the load
pub fun forwarded(p: ptr, a: i64) i64 {
    #[secret] store(p, a);
    #[secret] val v: ^i64 = load[i64](p);
    val w: ^i64 = add(v, 1);
    val u: ^i64 = mul(w, 3);
    val o: i64 = declassify(u);
    ret(o);
}

# a secret zero and a secret parameter every edge passes one constant, folded, which lowers what used them
#[secret_parameters(0)] pub fun secret_zero(x: ^i64, y: i64) i64 {
    val z: ^i64 = xor(x, x);
    val s: ^i64 = add(z, y);
    val t: ^i64 = mul(s, 5);
    val o: i64 = declassify(t);
    ret(o);
}

#[secret_parameters(0)] pub fun constant_parameter(x: ^i64) i64 {
    br head(0, 0);
head(i: i64, k: ^i64):
    val more: i1 = lt.u(i, 4);
    cbr(more) body, done;
body:
    val n: i64 = add(i, 1);
    br head(n, 7);
done:
    val s: ^i64 = add(k, 1);
    val o: i64 = declassify(s);
    ret(o);
}

# a public argument inlined into a secret parameter, and a secret division by a constant, reduced
#[secret_parameters(0)] #[secret_result] fun callee(x: ^i64) i64 {
    val y: ^i64 = add(x, 1);
    val z: ^i64 = mul(y, y);
    ret(z);
}

pub fun caller(a: i64) i64 {
    val r: ^i64 = call callee(a);
    val s: ^i64 = add(r, 2);
    val o: i64 = declassify(s);
    ret(o);
}

#[secret_parameters(0)] #[secret_result] pub fun divide(x: ^i64) i64 {
    val d: ^i64 = div.u(x, 7);
    val m: ^i64 = rem.u(x, 7);
    val s: ^i64 = add(d, m);
    ret(s);
}

# a wide constant a loop of secret arithmetic reads, which the hoist carries in a parameter as public as the constant
#[secret_parameters(1)] pub fun wide_constant(p: ptr, x: ^i64, n: i64) {
    br head(0, x);
head(i: i64, s: ^i64):
    val more: i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val t: ^i64 = mul(s, 81985529216486895);
    val u: ^i64 = xor(t, 1311768467463790320);
    val j: i64 = add(i, 1);
    br head(j, u);
done:
    #[secret] store(p, s);
    ret();
}

# a secret record loaded from memory and passed to an inlined callee that stores it in its own slot, which the inliner
# copies straight from the caller's memory, the copy stating it secret as the store did
rec T0 { _0: i64; _1: i64; _2: i64; _3: i64; }
#[secret_parameters(0)] #[secret_result] fun held(x: ^T0) i64 {
    val s: ptr = alloca[T0, pointer: ptr, align: 8]();
    #[secret] store[align: 8](s, x);
    val m: ptr = ptr.member[T0, member: _1](s);
    val v: ^i64 = load[i64](m);
    ret(v);
}

pub fun hand(p: ptr) i64 {
    #[secret] val a: ^T0 = load[T0, align: 8](p);
    val r: ^i64 = call held(a);
    val o: i64 = declassify(r);
    ret(o);
}
