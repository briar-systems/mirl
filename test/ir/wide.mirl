target "riscv64" "linux" "lp64d" "rv64gc"

!f0 = file "a.mach"
!l0 = location !f0 3:1
!t0 = type "i64" "i64" base signed 64
!t1 = type "i128" "i128" base signed 128
!v0 = variable "low" !t0 declared !l0
!v1 = variable "all" !t1 declared !l0

; integers wider than the register: a sum, a product, shifts by a constant and by a value, a select, comparisons, a high multiply already written over words, a condition held in memory, wide block parameters and a kept store, and variables bound to a split value
function @wide: fun(ptr, i64, i1) -> (i1) linkage global visibility default {
^entry(%p: ptr, %n: i64, %c: i1):
    %x = load %p, type i128, align 16
    %y = ext.s %n, to i128
    %m = mul %x, %y
    %s = shr.s %m, i128 68
    %l = shl %x, %y
    %t = select %c, %s, %l
    %k = lt.s %t, %x
    %e = eq %t, %x
    %h0 = ext.u %n, to i128
    %h1 = mul %h0, %h0
    %h2 = shr.u %h1, i128 64
    %h3 = trunc %h2, to i64
    store %p, %h3, align 8
    store %p, %c, align 1
    %b = load %p, type i1, align 1
    %w = load %p, type i256, align 8
    %v = add %w, %w
    store %p, %v, align 8
    bind !v0 = %t, trunc i64
    bind !v1 = %t
    cbr %k, ^one(%t), ^two(%m)
^one(%a: i128):
    br ^two(%a)
^two(%z: i128):
    store %p, %z, align 16 kept
    %r = and %e, %b
    ret %r
}
