target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

debug {
    file f0 = "a.mach";
    loc l0 = f0:3:1;
    type t0 = "i64" "i64" base(signed, 64);
    type t1 = "i128" "i128" base(signed, 128);
    var v0 = "low": t0 at l0;
    var v1 = "all": t1 at l0;
}

# integers wider than the register: a sum, a product, shifts by a constant and by a value, a select, comparisons, a high multiply already written over words, a condition held in memory, wide block parameters and a kept store, and variables bound to a split value
pub fun wide(p: ptr, n: i64, c: i1) i1 {
    val x: i128 = load[i128](p);
    val y: i128 = ext.s[i128](n);
    val m: i128 = mul(x, y);
    val s: i128 = shr.s(m, 68);
    val l: i128 = shl(x, y);
    val t: i128 = select(c, s, l);
    val k: i1 = lt.s(t, x);
    val e: i1 = eq(t, x);
    val h0: i128 = ext.u[i128](n);
    val h1: i128 = mul(h0, h0);
    val h2: i128 = shr.u(h1, 64);
    val h3: i64 = trunc[i64](h2);
    store(p, h3);
    store(p, c);
    val b: i1 = load[i1](p);
    val w: i256 = load[i256, align: 8](p);
    val v: i256 = add(w, w);
    store[align: 8](p, v);
    bind v0 = trunc[i64](t);
    bind v1 = t;
    cbr(k) one(t), two(m);
one(a: i128):
    br two(a);
two(z: i128):
    #[kept] store(p, z);
    val r: i1 = and(e, b);
    ret(r);
}
