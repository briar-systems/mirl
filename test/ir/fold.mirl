target "riscv64" "linux" "lp64d" "rv64gc"

; operations on constants, a branch on a constant, a parameter fed one constant by every edge, a vector of constants, and a division by zero the folder leaves to trap
function @fold: fun(i32, i32) -> (i32) linkage global visibility default {
^entry(%x: i32, %y: i32):
    %a = add i32 2, i32 3
    %c = eq %a, i32 5
    cbr %c, ^yes(%a), ^no
^yes(%p: i32):
    %q = div.s i32 7, i32 0
    %b = ne %y, i32 0
    cbr %b, ^join(i32 1), ^other
^other:
    br ^join(i32 1)
^join(%j: i32):
    %r = add %j, %p
    %s = add %r, %q
    %v = vsplat i32 3, vector vec<4, i32>
    %w = add %v, %v
    %l = vextract %w, lane 2
    %t = add %s, %l
    ret %t
^no:
    ret %x
}
