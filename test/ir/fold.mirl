target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# operations on constants, a branch on a constant, a parameter fed one constant by every edge, a vector of constants, and a division by zero the folder leaves to trap
pub fun fold(x: i32, y: i32) i32 {
    val a: i32 = add(2, 3);
    val c: i1 = eq(a, 5);
    cbr(c) yes(a), no;
yes(p: i32):
    val q: i32 = div.s(7, 0);
    val b: i1 = ne(y, 0);
    cbr(b) join(1), other;
other:
    br join(1);
join(j: i32):
    val r: i32 = add(j, p);
    val s: i32 = add(r, q);
    val v: vec[4, i32] = vsplat[vec[4, i32]](3::i32);
    val w: vec[4, i32] = add(v, v);
    val l: i32 = vextract[lane: 2](w);
    val t: i32 = add(s, l);
    ret(t);
no:
    ret(x);
}
