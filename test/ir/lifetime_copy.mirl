target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a copy into a slot of no bytes after the slot ends: an access of no bytes is an access
pub fun copy(q: ptr) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, 1::i64);
    slot.end(s);
    mem.copy[align: 8](s, q, 0::i64);
    ret(0);
}
