target { arch: "aarch64", sys: "darwin", env: "none", abi: "darwinpcs", isa: "armv8-a+fp+simd" };
# targets: darwin-aarch64 linux-aarch64 windows-aarch64

# naturally packed narrow stack arguments under darwinpcs keep their own byte and halfword slot size instead of widening to 64-bit loads and stores that clobber adjacent stack arguments

#[inline(never)] fun take_narrow(
    x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64,
    b0: i1 zext, b1: i8 zext, b2: i8 sext, s0: i16 zext, s1: i16 sext, w0: i32, p: ptr, tail_val: i64
) i64 {
    val px: i64 = load[i64, align: 8](p);
    val eb0: i64 = ext.u[i64](b0);
    val eb1: i64 = ext.u[i64](b1);
    val eb2: i64 = ext.s[i64](b2);
    val es0: i64 = ext.u[i64](s0);
    val es1: i64 = ext.s[i64](s1);
    val ew0: i64 = ext.s[i64](w0);
    val sum0: i64 = add(x0, x1);
    val sum1: i64 = add(x2, x3);
    val sum2: i64 = add(x4, x5);
    val sum3: i64 = add(x6, x7);
    val sum4: i64 = add(eb0, eb1);
    val sum5: i64 = add(eb2, es0);
    val sum6: i64 = add(es1, ew0);
    val sum7: i64 = add(px, tail_val);
    val t0: i64 = add(sum0, sum1);
    val t1: i64 = add(sum2, sum3);
    val t2: i64 = add(sum4, sum5);
    val t3: i64 = add(sum6, sum7);
    val u0: i64 = add(t0, t1);
    val u1: i64 = add(t2, t3);
    val res_val: i64 = add(u0, u1);
    ret(res_val);
}

pub fun call_narrow(
    x0: i64, x1: i64, x2: i64, x3: i64, x4: i64, x5: i64, x6: i64, x7: i64,
    b0: i1 zext, b1: i8 zext, b2: i8 sext, s0: i16 zext, s1: i16 sext, w0: i32, p: ptr, tail_val: i64
) i64 {
    val res_call: i64 = call take_narrow(x0, x1, x2, x3, x4, x5, x6, x7, b0, b1, b2, s0, s1, w0, p, tail_val);
    ret(res_call);
}
