target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot's address put in an aggregate's pointer member and taken out, loaded through after the slot ends
rec Pair { p: ptr; n: i64; }

pub fun aggregate(x: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    val a: Pair = insert[member: _0](zero::Pair, s);
    val p: ptr = extract[member: _0](a);
    slot.begin(s);
    store(s, x);
    slot.end(s);
    val r: i64 = load[i64](p);
    ret(r);
}
