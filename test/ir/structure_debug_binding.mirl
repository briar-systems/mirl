target { arch: "wasm32", sys: "wasi", env: "preview1", abi: "basic", isa: "wasm1" };

debug {
    file f0 = "t.mach";
    loc l0 = f0:1:1;
    type t0 = "i32" "i32" base(signed, 32);
    var v0 = "live": t0 at l0;
    var v1 = "dead": t0 at l0;
}

# debug value bindings across a funneled multi-exit loop: body initially
# dominates exit_body, then loses dominance when funnel routes hdr's exit
# through a shared dispatch. live_v is rebound to the threaded parameter while
# debug-only dead_v becomes unavailable instead of breaking verify
pub fun funnel_exit_bindings(n: i32) i32 {
    br hdr(0);
hdr(i: i32):
    val go: i1 = lt.s(i, n);
    cbr(go) body(i), exit_hdr;
body(v: i32):
    val live_v: i32 = add(v, 10);
    val dead_v: i32 = add(v, 20);
    val hit: i1 = eq(v, 3);
    cbr(hit) exit_body, next(v);
next(u: i32):
    val ni: i32 = add(u, 1);
    br hdr(ni);
exit_hdr:
    ret(99);
exit_body:
    bind v0 = live_v;
    bind v1 = dead_v;
    ret(live_v);
}
