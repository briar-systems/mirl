target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# flags: --emit asm

# an exchange with memory at each width, at a plain address and at element `i + 1`, which x86-64
# writes as xchg with no lock prefix, since one with a memory operand locks itself, so the listing
# masc reads back from the object names the row written
pub fun exchanges(p: ptr, i: i64, a: i8, b: i16, c: i32, d: i64) i64 {
    val e: i8 = atomic.xchg[order: seq_cst](p, a);
    val f: i16 = atomic.xchg[order: acquire](p, b);
    val g: i32 = atomic.xchg[order: release](p, c);
    val j: i64 = add(i, 1);
    val o: i64 = shl(j, 3);
    val q: ptr = ptr.add(p, o);
    val h: i64 = atomic.xchg[order: seq_cst](q, d);
    val k: i64 = ext.s[i64](e);
    val l: i64 = ext.s[i64](f);
    val m: i64 = ext.s[i64](g);
    val n: i64 = add(k, l);
    val r: i64 = add(m, h);
    val s: i64 = add(n, r);
    ret(s);
}
