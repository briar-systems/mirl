target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# a result built in one slot, its case byte stored as a constant, and copied to another slot word by word, as the
# aggregate legalisation copies a small record: the case loaded back from the second slot is the constant, since each
# word store moves the bytes of the word it stores, which a load of the first slot just read

ext fun keep(ptr);

rec R { case: i8; value: i64; }

pub fun copied(x: i64) i64 {
    val a: ptr = alloca[R, pointer: ptr, align: 8]();
    val b: ptr = alloca[R, pointer: ptr, align: 8]();
    call keep(a);
    call keep(b);
    store[align: 8](a, 0::i64);
    store[align: 1](a, 1::i8);
    val av: ptr = ptr.member[R, member: value](a);
    store[align: 8](av, x);
    val w0: i64 = load[i64, align: 8](a);
    store[align: 8](b, w0);
    val w1: i64 = load[i64, align: 8](av);
    val bv: ptr = ptr.member[R, member: value](b);
    store[align: 8](bv, w1);
    val c: i8 = load[i8, align: 1](b);
    val e: i1 = eq(c, 0);
    cbr(e) none, some;
none:
    ret(0);
some:
    val v: i64 = load[i64, align: 8](bv);
    ret(v);
}
