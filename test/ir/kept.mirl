target "riscv64-linux"


; kept stores into a slot about to leave scope, a kept store of a secret, and a kept fill whose length is known only at run time, beside plain ones
function @wipe: fun(i64, ptr, i64) -> () constant_time {
^entry(%key: secret i64, %buf: ptr, %n: i64):
    %slot = alloca type i64, pointer ptr, align 8
    store %slot, %key, align 8
    store %slot, %key, align 8 kept
    store %slot, i64 0, align 8 kept
    %rest = ptr.add %buf, i64 8
    mem.fill %buf, i8 0, i64 8, align 8
    mem.fill %rest, i8 0, %n, align 1 kept
    ret
}
