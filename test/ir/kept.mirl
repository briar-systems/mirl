target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# kept stores into a slot about to leave scope, a kept store of a secret, and a kept fill whose length is known only at run time, beside plain ones
#[oblivious] pub fun wipe(key: ^i64, buf: ptr, n: i64) {
    val slot: ptr = alloca[i64, pointer: ptr]();
    store(slot, key);
    #[kept] store(slot, key);
    #[kept] store[align: 8](slot, 0::i64);
    val rest: ptr = ptr.add(buf, 8::i64);
    mem.fill[align: 8](buf, 0, 8::i64);
    #[kept] mem.fill(rest, 0, n);
    ret();
}
