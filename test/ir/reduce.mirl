target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };

# sequential float sums and products of a vector the unit holds whole and of one split into two runs. a split one takes its later runs lane by lane, but where the build permits float reassociation it reduces every run packed at every optimisation level, since the vector legalisation reads the relaxation itself
pub fun sum_held(v: vec[4, f32]) f32 {
    val s: f32 = reduce.fadd.seq(v);
    ret(s);
}

pub fun sum_split(v: vec[8, f32]) f32 {
    val s: f32 = reduce.fadd.seq(v);
    ret(s);
}

pub fun product_split(v: vec[4, f64]) f64 {
    val p: f64 = reduce.fmul.seq(v);
    ret(p);
}
