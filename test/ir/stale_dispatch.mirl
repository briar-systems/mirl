target { arch: "wasm32", sys: "wasi", env: "preview1", abi: "basic", isa: "wasm1" };
# targets: wasi-wasm32 linux-x86_64 linux-aarch64 linux-riscv64

# a constant-time loop with an early return, then a counter stored on the loop's normal exit and read by the next
# loop: the structurizer mends the loop's two exits with a dispatch, whose path from the return's case to the next
# loop no run takes. the stale rule judges the body ahead of the structurizer (mirl.ct.fresh), so the counter is
# stored before every read and the function is accepted, as it is on every register target
#[constant_time(soft)] pub fun probe(_0: ptr, _1: i32) {
    #[public([0, 4])] val _2: ptr = alloca[i32, pointer: ptr]();
    #[public()] val _3: ptr = alloca[[16]i32, pointer: ptr, align: 4]();
    #[public([0, 4])] val _4: ptr = alloca[i32, pointer: ptr]();
    #[public([0, 4])] val _5: ptr = alloca[i32, pointer: ptr]();
    #[public] store(_2, _1);
    slot.begin(_3);
    #[secret] mem.fill[align: 4](_3, 0, 64::i32);
    slot.begin(_4);
    #[public] store[align: 4](_4, 0::i32);
    br _0;
_0:
    #[public] val _7: i32 = load[i32](_4);
    val _8: i1 = lt.u(_7, 16);
    cbr(_8) _1, _2;
_1:
    #[public] val _10: i32 = load[i32](_4);
    val _11: i1 = eq(_10, _1);
    cbr(_11) _3, _4;
_2:
    slot.begin(_5);
    #[public] store[align: 4](_5, 0::i32);
    br _6;
_3:
    ret();
_4:
    #[public] val _13: i32 = load[i32](_4);
    val _14: ptr = ptr.index[[16]i32](_3, _13);
    #[secret] store[align: 4](_14, 0::i32);
    #[public] val _16: i32 = load[i32](_4);
    val _17: i32 = add(_16, 1);
    #[public] store(_4, _17);
    br _0;
_6:
    #[public] val _18: i32 = load[i32](_5);
    val _19: i1 = lt.u(_18, 10);
    cbr(_19) _7, _8;
_7:
    val _21: ptr = ptr.index[[16]i32](_3, 2::i32);
    val _22: ^i32 = load[i32](_21);
    val _23: ptr = ptr.index[[16]i32](_3, 1::i32);
    #[secret] store(_23, _22);
    #[public] val _24: i32 = load[i32](_5);
    val _25: i32 = add(_24, 1);
    #[public] store(_5, _25);
    br _6;
_8:
    val _26: ^i32 = load[i32](_3);
    #[secret] store(_0, _26);
    slot.end(_5);
    slot.end(_4);
    slot.end(_3);
    ret();
}

# an address formed inside the loop from an index of that trip and read on the early exit: the dispatch leaves the
# index short of the read, so the structurizer makes the address again from the slot's alloca at the exit and threads
# the index alone, and the read stays an access of the slot (mirl.structure.repair)
#[constant_time(soft)] pub fun formed(_0: ptr, _1: i32) {
    #[public()] val _3: ptr = alloca[[16]i32, pointer: ptr, align: 4]();
    #[public([0, 4])] val _4: ptr = alloca[i32, pointer: ptr]();
    #[secret] mem.fill[align: 4](_3, 0, 64::i32);
    #[public] store[align: 4](_4, 0::i32);
    br _0;
_0:
    #[public] val _7: i32 = load[i32](_4);
    val _8: i1 = lt.u(_7, 16);
    cbr(_8) _1, _2;
_1:
    #[public] val _10: i32 = load[i32](_4);
    val _30: i32 = add(_10, 1);
    val _31: ptr = ptr.index[[16]i32](_3, _30);
    val _11: i1 = eq(_10, _1);
    cbr(_11) _3, _4;
_2:
    val _26: ^i32 = load[i32](_3);
    #[secret] store(_0, _26);
    ret();
_3:
    val _32: ^i32 = load[i32](_31);
    #[secret] store(_0, _32);
    ret();
_4:
    #[public] val _16: i32 = load[i32](_4);
    val _17: i32 = add(_16, 1);
    #[public] store(_4, _17);
    br _0;
}
