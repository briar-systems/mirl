target { arch: "x86_64", sys: "linux", env: "none", abi: "sysv64", isa: "cmov,cx8,x87,fxsr,osfxsr,mmx,sce,sse,sse2" };
# targets: linux-x86_64 windows-x86_64
# refuse:  control transfer decided by a secret value in @probe at byte
# a branch on the secret middle field of a by-value record, read through the parameter's own memory
# (mirl.legal.abi, read_in_place): the read states nothing, so the abi states it secret from the declaration, the
# caller's memory on windows and the incoming area on linux. the branch is inside an assembly block, where no check
# before emission sees it, so the walk is what refuses it. test/ir/forwarded.mirl branches on the public field and is
# accepted

rec T0 { _0: i64; _1: i64; _2: i64; }
#[constant_time(soft)] #[secret_parameters(0 [8, 8])] #[secret_result] pub fun probe(_0: ^T0) i64 {
    val _1: ptr = alloca[T0, pointer: ptr, align: 8]();
    store[align: 8](_1, _0);
    val _2: ptr = ptr.member[T0, member: _1](_1);
    val _3: ^i64 = load[i64](_2);
    val (_4: ^i64, _5: ^i64) = asm["\x0a    mov rax, {k}\x0a    mov ecx, 0\x0a    cmp rax, 5\x0a    jne 1f\x0a    mov ecx, 1\x0a    1:\x0a    mov {r}, rcx\x0a" {k: inout value i64, r: inout value i64} under "x86-64"](_3, 0::i64);
    ret(_5);
}
