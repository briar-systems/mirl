target { arch: "spirv", sys: "vulkan", env: "vulkan1.0", abi: "shader", isa: "spv1.0,Shader" };

# the high half of a product of operands read as unsigned, as signed and one of each, at 32 and 64 bits, one used twice, and a shift by a variable count
pub fun high(x: i64, y: i64, u: i32, w: i32) i64 {
    val a: i128 = ext.u[i128](x);
    val b: i128 = ext.u[i128](y);
    val p: i128 = mul(a, b);
    val s: i128 = shr.u(p, 64);
    val h: i64 = trunc[i64](s);
    val c: i128 = ext.s[i128](x);
    val d: i128 = ext.s[i128](y);
    val q: i128 = mul(c, d);
    val t: i128 = shr.s(q, 64);
    val i: i64 = trunc[i64](t);
    val e: i128 = ext.s[i128](x);
    val f: i128 = ext.u[i128](y);
    val r: i128 = mul(e, f);
    val z: i128 = shr.u(r, 64);
    val j: i64 = trunc[i64](z);
    val g: i64 = ext.u[i64](u);
    val k: i64 = ext.u[i64](w);
    val m: i64 = mul(g, k);
    val n: i64 = shr.u(m, 32);
    val o: i32 = trunc[i32](n);
    val o0: i64 = ext.u[i64](o);
    val sh: i64 = shl(x, y);
    val s0: i64 = add(h, i);
    val s1: i64 = add(s0, j);
    val s2: i64 = add(s1, o0);
    val s3: i64 = add(s2, sh);
    val s4: i64 = add(s3, h);
    ret(s4);
}

# the high multiply read each way at 64 and 32 bits, on a target with no form of it
pub fun stated(x: i64, y: i64, u: i32, w: i32) i64 {
    val h: i64 = mul.high.u(x, y);
    val i: i64 = mul.high.s(x, y);
    val j: i64 = mul.high.su(x, y);
    val k: i32 = mul.high.su(u, w);
    val k0: i64 = ext.s[i64](k);
    val s0: i64 = add(h, i);
    val s1: i64 = add(s0, j);
    val s2: i64 = add(s1, k0);
    ret(s2);
}
