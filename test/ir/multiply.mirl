target "spirv" "vulkan" "" ""

; the high half of a product of operands read as unsigned, as signed and one of each, at 32 and 64 bits, one used twice, and a shift by a variable count
function @high: fun(i64, i64, i32, i32) -> (i64) linkage global visibility default {
^entry(%x: i64, %y: i64, %u: i32, %w: i32):
    %a = ext.u %x, to i128
    %b = ext.u %y, to i128
    %p = mul %a, %b
    %s = shr.u %p, i128 64
    %h = trunc %s, to i64
    %c = ext.s %x, to i128
    %d = ext.s %y, to i128
    %q = mul %c, %d
    %t = shr.s %q, i128 64
    %i = trunc %t, to i64
    %e = ext.s %x, to i128
    %f = ext.u %y, to i128
    %r = mul %e, %f
    %z = shr.u %r, i128 64
    %j = trunc %z, to i64
    %g = ext.u %u, to i64
    %k = ext.u %w, to i64
    %m = mul %g, %k
    %n = shr.u %m, i64 32
    %o = trunc %n, to i32
    %o0 = ext.u %o, to i64
    %sh = shl %x, %y
    %s0 = add %h, %i
    %s1 = add %s0, %j
    %s2 = add %s1, %o0
    %s3 = add %s2, %sh
    %s4 = add %s3, %h
    ret %s4
}

; the high multiply read each way at 64 and 32 bits, on a target with no form of it
function @stated: fun(i64, i64, i32, i32) -> (i64) linkage global visibility default {
^entry(%x: i64, %y: i64, %u: i32, %w: i32):
    %h = mul.high.u %x, %y
    %i = mul.high.s %x, %y
    %j = mul.high.su %x, %y
    %k = mul.high.su %u, %w
    %k0 = ext.s %k, to i64
    %s0 = add %h, %i
    %s1 = add %s0, %j
    %s2 = add %s1, %k0
    ret %s2
}
