target { arch: "x86_64", sys: "linux", env: "gnu", abi: "sysv64", isa: "x86-64" };
# refuse: a use of a slot's address where the slot may not be begun

# a slot begun and ended in each trip of a loop, read at the top of the next trip before it is begun again, as a value
# carried across trips in storage that ends between them
pub fun loop(n: i64) i64 {
    val s: ptr = alloca[i64, pointer: ptr, align: 8]();
    slot.begin(s);
    store(s, 0::i64);
    slot.end(s);
    br head(0);
head(i: i64):
    val v: i64 = load[i64](s);
    slot.begin(s);
    store(s, i);
    slot.end(s);
    val j: i64 = add(i, 1);
    val c: i1 = lt.s(j, n);
    cbr(c) head(j), out;
out:
    ret(v);
}
