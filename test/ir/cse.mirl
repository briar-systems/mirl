target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# repeated computations and loads, for common subexpression elimination: a swapped commutative repeat, equal constants, a repeat in a dominated block, loads across a join and a loop, a volatile load, a kept store and a secret mark
ext fun sink(ptr);

pub fun diamond(p: ptr, x: i32, y: i32) i32 {
    val a: i32 = add(x, 4);
    val b: i32 = add(4, x);
    val l: i32 = load[i32](p);
    val c: i1 = lt.s(a, y);
    cbr(c) left, right;
left:
    store(p, b);
    val m: i32 = load[i32](p);
    val d: i32 = add(x, y);
    br join(m, d);
right:
    val n: i32 = load[i32](p);
    val e: i32 = add(y, x);
    br join(n, e);
join(u: i32, v: i32):
    val o: i32 = load[i32](p);
    val f: i32 = add(u, v);
    val g: i32 = add(f, o);
    val h: i32 = add(g, l);
    val i: i32 = add(h, b);
    ret(i);
}

pub fun loop(p: ptr, n: i32) i32 {
    val s: ptr = alloca[i32, pointer: ptr]();
    val first: i32 = load[i32](p);
    br head(0, first);
head(i: i32, acc: i32):
    val again: i32 = load[i32](p);
    val t: i1 = lt.s(i, n);
    cbr(t) body, exit;
body:
    store(s, i);
    val q: i32 = load[i32](s);
    val r: i32 = load[i32](s);
    val next: i32 = add(i, 1);
    val sum: i32 = add(acc, q);
    val more: i32 = add(sum, r);
    br head(next, more);
exit:
    val z: i32 = add(acc, again);
    ret(z);
}

pub fun ordered(p: ptr, x: i32, y: i32) i32 {
    #[volatile] val v1: i32 = load[i32](p);
    #[volatile] val v2: i32 = load[i32](p);
    #[kept] store(p, x);
    val a: i32 = load[i32](p);
    #[kept] store(p, y);
    val b: i32 = load[i32](p);
    val s: i32 = add(x, y);
    #[secret] val t: i32 = add(x, y);
    call sink(p);
    val c: i32 = load[i32](p);
    val d: i32 = add(v1, v2);
    val e: i32 = add(a, b);
    val f: i32 = add(c, s);
    val g: i32 = add(d, e);
    val h: i32 = add(f, g);
    ret(h);
}
