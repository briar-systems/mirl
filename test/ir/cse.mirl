target "riscv64-linux"

; repeated computations and loads, for common subexpression elimination: a swapped commutative repeat, equal constants, a repeat in a dominated block, loads across a join and a loop, a volatile load, a kept store and a secret mark
function @sink: fun(ptr) -> ()

function @diamond: fun(ptr, i32, i32) -> (i32) {
^entry(%p: ptr, %x: i32, %y: i32):
    %a = add %x, i32 4
    %b = add i32 4, %x
    %l = load %p, type i32, align 4
    %c = lt.s %a, %y
    cbr %c, ^left, ^right
^left:
    store %p, %b, align 4
    %m = load %p, type i32, align 4
    %d = add %x, %y
    br ^join(%m, %d)
^right:
    %n = load %p, type i32, align 4
    %e = add %y, %x
    br ^join(%n, %e)
^join(%u: i32, %v: i32):
    %o = load %p, type i32, align 4
    %f = add %u, %v
    %g = add %f, %o
    %h = add %g, %l
    %i = add %h, %b
    ret %i
}

function @loop: fun(ptr, i32) -> (i32) {
^entry(%p: ptr, %n: i32):
    %s = alloca type i32, pointer ptr, align 4
    %first = load %p, type i32, align 4
    br ^head(i32 0, %first)
^head(%i: i32, %acc: i32):
    %again = load %p, type i32, align 4
    %t = lt.s %i, %n
    cbr %t, ^body, ^exit
^body:
    store %s, %i, align 4
    %q = load %s, type i32, align 4
    %r = load %s, type i32, align 4
    %next = add %i, i32 1
    %sum = add %acc, %q
    %more = add %sum, %r
    br ^head(%next, %more)
^exit:
    %z = add %acc, %again
    ret %z
}

function @ordered: fun(ptr, i32, i32) -> (i32) {
^entry(%p: ptr, %x: i32, %y: i32):
    %v1 = load %p, type i32, align 4 volatile
    %v2 = load %p, type i32, align 4 volatile
    store %p, %x, align 4 kept
    %a = load %p, type i32, align 4
    store %p, %y, align 4 kept
    %b = load %p, type i32, align 4
    %s = add %x, %y
    %t = add %x, %y secret
    call ptr @sink, %p, signature fun(ptr) -> ()
    %c = load %p, type i32, align 4
    %d = add %v1, %v2
    %e = add %a, %b
    %f = add %c, %s
    %g = add %d, %e
    %h = add %f, %g
    ret %h
}
