target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# loops with invariants, for loop invariant code motion: a product that leaves its loop, a division that may trap and a load that an aliasing store keeps, a loop entered from two blocks and a loop around a loop
ext fun sink(ptr);

pub fun invariants(p: ptr, n: i32, a: i32, b: i32) i32 {
    br head(0, 0);
head(i: i32, acc: i32):
    val k: i32 = mul(a, b);
    val c: i1 = lt.s(i, n);
    cbr(c) body, exit;
body:
    val q: i32 = div.s(k, b);
    val l: i32 = load[i32](p);
    store(p, acc);
    val next: i32 = add(i, 1);
    val m: i32 = add(q, l);
    val sum: i32 = add(acc, m);
    br head(next, sum);
exit:
    ret(acc);
}

pub fun entered_twice(f: i1, x: i32, y: i32) i32 {
    cbr(f) left, right;
left:
    br head(0);
right:
    br head(1);
head(i: i32):
    val k: i32 = add(x, y);
    val c: i1 = lt.s(i, k);
    cbr(c) body, exit;
body:
    val next: i32 = add(i, 1);
    br head(next);
exit:
    ret(i);
}

pub fun nested(n: i32, a: i32, b: i32) i32 {
    br outer(0, 0);
outer(i: i32, acc: i32):
    val c: i1 = lt.s(i, n);
    cbr(c) enter, exit;
enter:
    br inner(0, acc);
inner(j: i32, v: i32):
    val k: i32 = mul(a, b);
    val d: i1 = lt.s(j, n);
    cbr(d) step, latch;
step:
    val nj: i32 = add(j, 1);
    val nv: i32 = add(v, k);
    br inner(nj, nv);
latch:
    val ni: i32 = add(i, 1);
    br outer(ni, v);
exit:
    ret(acc);
}

pub fun volatile_and_call(p: ptr, n: i32) i32 {
    br head(0);
head(i: i32):
    #[volatile] val v: i32 = load[i32](p);
    call sink(p);
    val w: i32 = load[i32](p);
    val c: i1 = lt.s(i, n);
    cbr(c) body, exit;
body:
    val next: i32 = add(i, v);
    br head(next);
exit:
    val r: i32 = add(i, w);
    ret(r);
}
