target "riscv64-linux"

; loops with invariants, for loop invariant code motion: a product that leaves its loop, a division that may trap and a load that an aliasing store keeps, a loop entered from two blocks and a loop around a loop
function @sink: fun(ptr) -> () linkage global visibility default

function @invariants: fun(ptr, i32, i32, i32) -> (i32) linkage global visibility default {
^entry(%p: ptr, %n: i32, %a: i32, %b: i32):
    br ^head(i32 0, i32 0)
^head(%i: i32, %acc: i32):
    %k = mul %a, %b
    %c = lt.s %i, %n
    cbr %c, ^body, ^exit
^body:
    %q = div.s %k, %b
    %l = load %p, type i32, align 4
    store %p, %acc, align 4
    %next = add %i, i32 1
    %m = add %q, %l
    %sum = add %acc, %m
    br ^head(%next, %sum)
^exit:
    ret %acc
}

function @entered_twice: fun(i1, i32, i32) -> (i32) linkage global visibility default {
^entry(%f: i1, %x: i32, %y: i32):
    cbr %f, ^left, ^right
^left:
    br ^head(i32 0)
^right:
    br ^head(i32 1)
^head(%i: i32):
    %k = add %x, %y
    %c = lt.s %i, %k
    cbr %c, ^body, ^exit
^body:
    %next = add %i, i32 1
    br ^head(%next)
^exit:
    ret %i
}

function @nested: fun(i32, i32, i32) -> (i32) linkage global visibility default {
^entry(%n: i32, %a: i32, %b: i32):
    br ^outer(i32 0, i32 0)
^outer(%i: i32, %acc: i32):
    %c = lt.s %i, %n
    cbr %c, ^enter, ^exit
^enter:
    br ^inner(i32 0, %acc)
^inner(%j: i32, %v: i32):
    %k = mul %a, %b
    %d = lt.s %j, %n
    cbr %d, ^step, ^latch
^step:
    %nj = add %j, i32 1
    %nv = add %v, %k
    br ^inner(%nj, %nv)
^latch:
    %ni = add %i, i32 1
    br ^outer(%ni, %v)
^exit:
    ret %acc
}

function @volatile_and_call: fun(ptr, i32) -> (i32) linkage global visibility default {
^entry(%p: ptr, %n: i32):
    br ^head(i32 0)
^head(%i: i32):
    %v = load %p, type i32, align 4 volatile
    call ptr @sink, %p, signature fun(ptr) -> (), named all
    %w = load %p, type i32, align 4
    %c = lt.s %i, %n
    cbr %c, ^body, ^exit
^body:
    %next = add %i, %v
    br ^head(%next)
^exit:
    %r = add %i, %w
    ret %r
}
