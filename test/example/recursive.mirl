target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 120: a recursive factorial of 5
fun factorial(n: i64) i64 {
    val c: i1 = le.s(n, 1);
    cbr(c) base, step;
base:
    ret(1);
step:
    val m: i64 = sub(n, 1);
    val f: i64 = call factorial(m);
    val p: i64 = mul(n, f);
    ret(p);
}

fun main() i64 {
    val v: i64 = call factorial(5);
    ret(v);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
