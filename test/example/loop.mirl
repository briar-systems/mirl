target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 55: the sum of 1 to 10 in a loop
fun main() i64 {
    br head(1, 0);
head(i: i64, sum: i64):
    val c: i1 = le.s(i, 10);
    cbr(c) body, done;
body:
    val next: i64 = add(i, 1);
    val more: i64 = add(sum, i);
    br head(next, more);
done:
    ret(sum);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
