target "riscv64-linux"

; the sum of 1 to 10 in a loop, which is 55
function @main: fun() -> (i64) linkage local visibility default {
^entry:
    br ^head(i64 1, i64 0)
^head(%i: i64, %sum: i64):
    %c = le.s %i, i64 10
    cbr %c, ^body, ^done
^body:
    %next = add %i, i64 1
    %more = add %sum, %i
    br ^head(%next, %more)
^done:
    ret %sum
}

; the start stub: run the program and exit with its result
function @exit: fun(i64) -> () linkage global visibility default

export function @_start: fun() -> () linkage global visibility default {
^entry:
    %r = call ptr @main, signature fun() -> (i64), named all
    call ptr @exit, %r, signature fun(i64) -> (), named all
    unreachable
}

