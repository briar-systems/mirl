target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 0: copies and fills of lengths no constant states, which a build with a vector of bytes moves in
# packed loops and any other calls the helper for: every length from 0 to 70 and the lengths either side
# of 4096, each fill checked byte by byte against the bytes past it, each copy into a separate buffer and
# overlapping its source one byte above and one byte below it, which a copy must move as if through a copy
# of the source. the length comes through a call so no fold decides it

fun pass(n: i64) i64 {
    ret(n);
}

# byte i of the pattern every check reads back, in the low byte (riscv states no narrow return)
fun pattern(i: i64) i64 {
    val m: i64 = mul(i, 7);
    val k: i64 = add(m, 3);
    ret(k);
}

# write the pattern over n bytes at p
fun write(p: ptr, n: i64) {
    br head(0);
head(i: i64):
    val more: i1 = lt.s(i, n);
    cbr(more) body, done;
body:
    val at: ptr = ptr.add(p, i);
    val k: i64 = call pattern(i);
    val b: i8 = trunc[i8](k);
    store(at, b);
    val next: i64 = add(i, 1);
    br head(next);
done:
    ret();
}

# 1 where the n bytes at p hold the pattern from byte `from` on, 0 otherwise
fun holds(p: ptr, n: i64, from: i64) i64 {
    br head(0);
head(i: i64):
    val more: i1 = lt.s(i, n);
    cbr(more) body, yes;
body:
    val at: ptr = ptr.add(p, i);
    val got: i8 = load[i8](at);
    val k: i64 = add(i, from);
    val wide: i64 = call pattern(k);
    val want: i8 = trunc[i8](wide);
    val same: i1 = eq(got, want);
    val next: i64 = add(i, 1);
    cbr(same) head(next), no;
yes:
    ret(1);
no:
    ret(0);
}

# 1 where the n bytes at p are all the low byte of v
fun filled(p: ptr, n: i64, v: i64) i64 {
    val b: i8 = trunc[i8](v);
    br head(0);
head(i: i64):
    val more: i1 = lt.s(i, n);
    cbr(more) body, yes;
body:
    val at: ptr = ptr.add(p, i);
    val got: i8 = load[i8](at);
    val same: i1 = eq(got, b);
    val next: i64 = add(i, 1);
    cbr(same) head(next), no;
yes:
    ret(1);
no:
    ret(0);
}

# check one length: 0 where every copy and fill of it is right, else a code naming the check that failed
fun one(n: i64) i64 {
    val src: ptr = alloca[[4200]i8, pointer: ptr, align: 16]();
    val dst: ptr = alloca[[4200]i8, pointer: ptr, align: 16]();
    val m: i64 = call pass(n);
    val room: i64 = add(n, 2);
    call write(src, room);
    call write(dst, room);
    val d1: ptr = ptr.add(dst, 1::i64);
    mem.fill[align: 1](d1, -86::i8, m);
    val f1: i64 = call filled(d1, n, -86::i64);
    val f2: i64 = call holds(dst, 1::i64, 0::i64);
    val past: ptr = ptr.add(d1, n);
    val after: i64 = add(n, 1);
    val f3: i64 = call holds(past, 1::i64, after);
    val f12: i64 = and(f1, f2);
    val f123: i64 = and(f12, f3);
    val fok: i1 = eq(f123, 1);
    cbr(fok) apart, bad_fill;
apart:
    mem.copy[align: 1](d1, src, m);
    val c1: i64 = call holds(d1, n, 0::i64);
    val c2: i64 = call holds(past, 1::i64, after);
    val c12: i64 = and(c1, c2);
    val cok: i1 = eq(c12, 1);
    cbr(cok) up, bad_copy;
up:
    call write(src, room);
    val s1: ptr = ptr.add(src, 1::i64);
    mem.copy[align: 1](s1, src, m);
    val u1: i64 = call holds(s1, n, 0::i64);
    val uok: i1 = eq(u1, 1);
    cbr(uok) down, bad_up;
down:
    call write(src, room);
    mem.copy[align: 1](src, s1, m);
    val w1: i64 = call holds(src, n, 1::i64);
    val wok: i1 = eq(w1, 1);
    cbr(wok) good, bad_down;
good:
    ret(0);
bad_fill:
    ret(1);
bad_copy:
    ret(2);
bad_up:
    ret(3);
bad_down:
    ret(4);
}

fun main() i64 {
    br small(0);
small(n: i64):
    val r: i64 = call one(n);
    val ok: i1 = eq(r, 0);
    cbr(ok) next, fail(r, n);
next:
    val n1: i64 = add(n, 1);
    val more: i1 = lt.s(n1, 71);
    cbr(more) small(n1), large(4094);
large(k: i64):
    val q: i64 = call one(k);
    val fine: i1 = eq(q, 0);
    cbr(fine) further, fail(q, k);
further:
    val k1: i64 = add(k, 1);
    val again: i1 = lt.s(k1, 4099);
    cbr(again) large(k1), done;
done:
    ret(0);
fail(code: i64, at: i64):
    val low: i64 = and(at, 31);
    val shifted: i64 = shl(code, 5);
    val status: i64 = or(shifted, low);
    ret(status);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
