target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 42: a global read, written and read again, 40 + 2
#[align(8)] var counter: i64 = 40;

fun main() i64 {
    val v: i64 = load[i64](?counter);
    val n: i64 = add(v, 2);
    store(?counter, n);
    val w: i64 = load[i64](?counter);
    ret(w);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
