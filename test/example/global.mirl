target "riscv64-linux"

; exits 42: a global read, written and read again, 40 + 2
global @counter: i64 linkage local visibility default align 8 = i64 40

function @main: fun() -> (i64) linkage local visibility default {
^entry:
    %v = load ptr @counter, type i64, align 8
    %n = add %v, i64 2
    store ptr @counter, %n, align 8
    %w = load ptr @counter, type i64, align 8
    ret %w
}

; the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
function @__mirl_exit: fun(i64) -> () linkage global visibility default

export function @_start: fun() -> () linkage global visibility default {
^entry:
    %r = call ptr @main, signature fun() -> (i64), named all
    call ptr @__mirl_exit, %r, signature fun(i64) -> (), named all
    unreachable
}

