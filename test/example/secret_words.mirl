target { arch: "riscv32", sys: "linux", env: "gnu", abi: "ilp32d", isa: "rv32gc" };

# exits 0: a binary64 reinterpreted as words, and words as a binary64, where a word is narrower than the float, as on
# a 32-bit target, goes through a stack slot of the float. the slot's stores and loads are marked secret where the
# value is, so the verifier finds the not and the fneg that read them as secret as before, and the bits come back
# right. bit 0 of a failing status is the low word, bit 1 the float made of words

#[secret_parameters(0)] #[secret_result]
fun low(x: ^f64) i32 {
    val w: ^i64 = bitcast[i64](x);
    val l: ^i32 = trunc[i32](w);
    val n: ^i32 = not(l);
    ret(n);
}

#[secret_parameters(0)] #[secret_result]
fun negated(w: ^i64) f64 {
    val f: ^f64 = bitcast[f64](w);
    val n: ^f64 = fneg(f);
    ret(n);
}

fun main() i64 {
    val x: f64 = bitcast[f64](4609434218613702656::i64);
    val s: ^i32 = call low(x);
    val l: i32 = declassify(s);
    val bad_low: i1 = ne(l, 4294967295::i32);
    val t: ^f64 = call negated(4609434218613702656::i64);
    val y: f64 = declassify(t);
    val yb: i64 = bitcast[i64](y);
    val bad_neg: i1 = ne(yb, 13832806255468478464::i64);
    val a: i64 = ext.u[i64](bad_low);
    val b0: i64 = ext.u[i64](bad_neg);
    val b: i64 = shl(b0, 1);
    val r: i64 = or(a, b);
    ret(r);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
