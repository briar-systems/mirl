target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 0: a comparison of secret lanes that a unit does not compute is taken lane by lane, and its lanes put back
# together for the packed operation that reads them, through a slot where no unit builds a vector. the slot's
# stores and its load are marked secret, so the verifier finds the result as secret as its operands, and the lanes
# come back right at 0, 1, all ones and either side of the sign boundary. bit k of a failing status is lane k

#[constant_time(soft)] #[secret_parameters(0, 1)] #[secret_result]
fun mix(a: ^vec[4, i32], b: ^vec[4, i32]) vec[4, i32] {
    val c: ^vec[4, i1] = gt.u(a, b);
    val m: ^vec[4, i32] = ext.s[vec[4, i32]](c);
    val n: ^vec[4, i32] = not(m);
    ret(n);
}

# 1 shifted to bit k where lane k is not want
fun wrong(got: i32, k: i64, want: i32) i64 {
    val bad: i1 = ne(got, want);
    val bit: i64 = ext.u[i64](bad);
    val at: i64 = shl(bit, k);
    ret(at);
}

fun main() i64 {
    val a: vec[4, i32] = vbuild[vec[4, i32]](5::i32, 0::i32, 4294967295::i32, 2147483647::i32);
    val b: vec[4, i32] = vbuild[vec[4, i32]](3::i32, 0::i32, 1::i32, 2147483648::i32);
    val s: ^vec[4, i32] = call mix(a, b);
    val r: vec[4, i32] = declassify(s);
    val l0: i32 = vextract[lane: 0](r);
    val l1: i32 = vextract[lane: 1](r);
    val l2: i32 = vextract[lane: 2](r);
    val l3: i32 = vextract[lane: 3](r);
    val w0: i64 = call wrong(l0, 0, 0::i32);
    val w1: i64 = call wrong(l1, 1, 4294967295::i32);
    val w2: i64 = call wrong(l2, 2, 0::i32);
    val w3: i64 = call wrong(l3, 3, 4294967295::i32);
    val x: i64 = or(w0, w1);
    val y: i64 = or(w2, w3);
    val z: i64 = or(x, y);
    ret(z);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
