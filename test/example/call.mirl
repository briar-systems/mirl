target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 23: a call with arguments and a result, 3 * 7 + 2
fun scale(x: i64, k: i64, c: i64) i64 {
    val p: i64 = mul(x, k);
    val s: i64 = add(p, c);
    ret(s);
}

fun main() i64 {
    val v: i64 = call scale(3, 7, 2);
    ret(v);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
