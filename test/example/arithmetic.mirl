target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 46: arithmetic on its arguments, (6 + 8) * 3 - 12 / 8 + 17 % 6
fun compute(a: i64, b: i64) i64 {
    val s: i64 = add(a, b);
    val p: i64 = mul(s, 3);
    val q: i64 = div.s(12, b);
    val r: i64 = rem.u(17, a);
    val d: i64 = sub(p, q);
    val t: i64 = add(d, r);
    val m: i64 = and(t, 255);
    ret(m);
}

fun main() i64 {
    val v: i64 = call compute(6, 8);
    ret(v);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
