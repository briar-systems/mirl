target { arch: "riscv64", sys: "linux", env: "gnu", abi: "lp64d", isa: "rv64gc" };

# exits 168: atomics with no one instruction, each a loop. the values each gives back sum to 115, their success flags weighted 1, 2, 4, 8 and 16 to 21, and the bytes left 32 when they are 0x44237f05
#[align(4)] var word: i32 = 5;
# the bytes 0x91, 0x22, 0x33 and 0x44 from the lowest address
#[align(4)] var bytes: i32 = 1144201873;

fun main() i64 {
    # a word compare and exchange that stores, 5 to 9, giving 5, then one that does not, giving 9
    val (w1: i32, k1: i1) = atomic.cmpxchg[success: seq_cst, failure: acquire](?word, 5, 9);
    val (w2: i32, k2: i1) = atomic.cmpxchg[success: acquire, failure: relaxed](?word, 5, 1);
    # nand: the word becomes not (9 and 12), -9, giving 9
    val w3: i32 = atomic.nand[order: release](?word, 12);
    fence[order: acq_rel]();
    # a byte compare and exchange at offset 1 that stores, 0x22 to 0x7f, giving 34, then one that does not, giving 127
    val p1: ptr = ptr.add(?bytes, 1::i64);
    val (b1: i8, k3: i1) = atomic.cmpxchg[success: acq_rel, failure: acquire](p1, 34, 127);
    val (b2: i8, k4: i1) = atomic.cmpxchg[success: release, failure: relaxed](p1, 34, 1);
    # a byte compare and exchange at offset 0 of a negative byte, 0x91 to 5, giving -111
    val (b3: i8, k5: i1) = atomic.cmpxchg[success: relaxed, failure: seq_cst](?bytes, -111, 5);
    # a field add at offset 2, 0x33 less 16 to 0x23, its carry out of the byte dropped, giving 51
    val p2: ptr = ptr.add(?bytes, 2::i64);
    val b4: i8 = atomic.add[order: acquire](p2, -16);
    val w4: i32 = atomic.load[i32, order: seq_cst](?word);
    val all: i32 = atomic.load[i32, order: acquire](?bytes);
    # 5 + 9 + 9 + 34 + 127 - 111 + 51 - 9
    val e1: i64 = ext.s[i64](w1);
    val e2: i64 = ext.s[i64](w2);
    val e3: i64 = ext.s[i64](w3);
    val e4: i64 = ext.s[i64](b1);
    val e5: i64 = ext.s[i64](b2);
    val e6: i64 = ext.s[i64](b3);
    val e7: i64 = ext.s[i64](b4);
    val e8: i64 = ext.s[i64](w4);
    val s1: i64 = add(e1, e2);
    val s2: i64 = add(s1, e3);
    val s3: i64 = add(s2, e4);
    val s4: i64 = add(s3, e5);
    val s5: i64 = add(s4, e6);
    val s6: i64 = add(s5, e7);
    val s7: i64 = add(s6, e8);
    # 1 + 0 + 4 + 0 + 16
    val f1: i64 = ext.u[i64](k1);
    val f2: i64 = ext.u[i64](k2);
    val f3: i64 = ext.u[i64](k3);
    val f4: i64 = ext.u[i64](k4);
    val f5: i64 = ext.u[i64](k5);
    val g2: i64 = mul(f2, 2);
    val g3: i64 = mul(f3, 4);
    val g4: i64 = mul(f4, 8);
    val g5: i64 = mul(f5, 16);
    val t1: i64 = add(s7, f1);
    val t2: i64 = add(t1, g2);
    val t3: i64 = add(t2, g3);
    val t4: i64 = add(t3, g4);
    val t5: i64 = add(t4, g5);
    # the bytes left: 5, 0x7f, 0x23 and 0x44
    val same: i1 = eq(all, 1143176965);
    val h: i64 = ext.u[i64](same);
    val g6: i64 = mul(h, 32);
    val r: i64 = add(t5, g6);
    ret(r);
}

# the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
ext fun __mirl_exit(i64);

#[export] pub fun _start() {
    val r: i64 = call main();
    call __mirl_exit(r);
    unreachable();
}
