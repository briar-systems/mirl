target "riscv64" "linux" "lp64d" "rv64gc"

; exits 168: atomics with no one instruction, each a loop. the values each gives back sum to 115, their success flags weighted 1, 2, 4, 8 and 16 to 21, and the bytes left 32 when they are 0x44237f05
global @word: i32 linkage local visibility default align 4 = i32 5

; the bytes 0x91, 0x22, 0x33 and 0x44 from the lowest address
global @bytes: i32 linkage local visibility default align 4 = i32 1144201873

function @main: fun() -> (i64) linkage local visibility default {
^entry:
    ; a word compare and exchange that stores, 5 to 9, giving 5, then one that does not, giving 9
    %w1, %k1 = atomic.cmpxchg ptr @word, i32 5, i32 9, success seq_cst, failure acquire
    %w2, %k2 = atomic.cmpxchg ptr @word, i32 5, i32 1, success acquire, failure relaxed
    ; nand: the word becomes not (9 and 12), -9, giving 9
    %w3 = atomic.nand ptr @word, i32 12, order release
    fence order acq_rel
    ; a byte compare and exchange at offset 1 that stores, 0x22 to 0x7f, giving 34, then one that does not, giving 127
    %p1 = ptr.add ptr @bytes, i64 1
    %b1, %k3 = atomic.cmpxchg %p1, i8 34, i8 127, success acq_rel, failure acquire
    %b2, %k4 = atomic.cmpxchg %p1, i8 34, i8 1, success release, failure relaxed
    ; a byte compare and exchange at offset 0 of a negative byte, 0x91 to 5, giving -111
    %b3, %k5 = atomic.cmpxchg ptr @bytes, i8 -111, i8 5, success relaxed, failure seq_cst
    ; a field add at offset 2, 0x33 less 16 to 0x23, its carry out of the byte dropped, giving 51
    %p2 = ptr.add ptr @bytes, i64 2
    %b4 = atomic.add %p2, i8 -16, order acquire
    %w4 = atomic.load ptr @word, type i32, order seq_cst
    %all = atomic.load ptr @bytes, type i32, order acquire
    ; 5 + 9 + 9 + 34 + 127 - 111 + 51 - 9
    %e1 = ext.s %w1, to i64
    %e2 = ext.s %w2, to i64
    %e3 = ext.s %w3, to i64
    %e4 = ext.s %b1, to i64
    %e5 = ext.s %b2, to i64
    %e6 = ext.s %b3, to i64
    %e7 = ext.s %b4, to i64
    %e8 = ext.s %w4, to i64
    %s1 = add %e1, %e2
    %s2 = add %s1, %e3
    %s3 = add %s2, %e4
    %s4 = add %s3, %e5
    %s5 = add %s4, %e6
    %s6 = add %s5, %e7
    %s7 = add %s6, %e8
    ; 1 + 0 + 4 + 0 + 16
    %f1 = ext.u %k1, to i64
    %f2 = ext.u %k2, to i64
    %f3 = ext.u %k3, to i64
    %f4 = ext.u %k4, to i64
    %f5 = ext.u %k5, to i64
    %g2 = mul %f2, i64 2
    %g3 = mul %f3, i64 4
    %g4 = mul %f4, i64 8
    %g5 = mul %f5, i64 16
    %t1 = add %s7, %f1
    %t2 = add %t1, %g2
    %t3 = add %t2, %g3
    %t4 = add %t3, %g4
    %t5 = add %t4, %g5
    ; the bytes left: 5, 0x7f, 0x23 and 0x44
    %same = eq %all, i32 1143176965
    %h = ext.u %same, to i64
    %g6 = mul %h, i64 32
    %r = add %t5, %g6
    ret %r
}

; the start stub: run the program and exit with its result through __mirl_exit, which makes the exit syscall
function @__mirl_exit: fun(i64) -> () linkage global visibility default

export function @_start: fun() -> () linkage global visibility default {
^entry:
    %r = call ptr @main, signature fun() -> (i64), named all
    call ptr @__mirl_exit, %r, signature fun(i64) -> (), named all
    unreachable
}
