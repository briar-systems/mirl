; batch 8
; equality to a tag as a mask, as a constant-time compare forms it
function @probe: fun(i64) -> (i64) linkage global visibility default constant_time {
^entry(%x: secret i64):
    %d = xor %x, i64 0
    %n = sub i64 0, %d
    %o = or %d, %n
    %nz = shr.u %o, i64 63
    %eq = sub i64 1, %nz
    ret %eq
}
