# batch 8
# a choice by a secret condition through select, never a branch
#[oblivious] pub fun probe(x: ^i64) i64 {
    val low: ^i64 = and(x, 255);
    val zero_1: ^i1 = eq(low, 0);
    val a: ^i64 = xor(x, -6148914691236517206);
    val b: ^i64 = add(x, 7);
    val r: ^i64 = select(zero_1, a, b);
    ret(r);
}
