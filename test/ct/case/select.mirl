; batch 8
; a choice by a secret condition through select, never a branch
function @probe: fun(i64) -> (i64) linkage global visibility default constant_time {
^entry(%x: secret i64):
    %low = and %x, i64 255
    %zero = eq %low, i64 0
    %a = xor %x, i64 12297829382473034410
    %b = add %x, i64 7
    %r = select %zero, %a, %b
    ret %r
}
