# batch 8
# an or of a public table's entries each xored with a secret, which the vectoriser takes at -O, the case that times vectorised constant-time code
#[align(16)] var table: [256]i64 = zero;

#[constant_time(soft)] #[secret_parameters(0)] #[secret_result] pub fun probe(x: ^i64) i64 {
    br head(0, 0);
head(i: i64, acc: ^i64):
    val more: i1 = lt.u(i, 256);
    cbr(more) body, done;
body:
    val at: ptr = ptr.index[[256]i64](?table, i);
    val v: i64 = load[i64](at);
    val d: ^i64 = xor(v, x);
    val sum: ^i64 = or(acc, d);
    val next: i64 = add(i, 1);
    br head(next, sum);
done:
    ret(acc);
}
