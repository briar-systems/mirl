; batch 8
; a shift by a secret count, the count masked below the width so no saturation is needed
function @probe: fun(i64) -> (i64) linkage global visibility default constant_time {
^entry(%x: secret i64):
    %n = and %x, i64 63
    %l = shl i64 -6148914691236517206, %n
    %r = shr.u %l, %n
    %s = shr.s %l, %n
    %t = xor %r, %s
    ret %t
}
