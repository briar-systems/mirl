# batch 8
# a shift by a secret count, the count masked below the width so no saturation is needed
#[oblivious] pub fun probe(x: ^i64) i64 {
    val n: ^i64 = and(x, 63);
    val l: ^i64 = shl(-6148914691236517206, n);
    val r: ^i64 = shr.u(l, n);
    val s: ^i64 = shr.s(l, n);
    val t: ^i64 = xor(r, s);
    ret(t);
}
