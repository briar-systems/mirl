; batch 1
; a lookup at a secret index that reads every entry of the table at public addresses and keeps the one it wants by a mask
global @table: array<256, i64> linkage local visibility default align 8 = array<256, i64> zero

function @probe: fun(i64) -> (i64) linkage global visibility default constant_time {
^entry(%x: secret i64):
    %want = and %x, i64 255
    br ^head(i64 0, i64 0)
^head(%i: i64, %acc: secret i64):
    %more = lt.u %i, i64 256
    cbr %more, ^body, ^done
^body:
    %at = ptr.index ptr @table, %i, type array<256, i64>
    %v = load %at, type i64, align 8
    %hit = eq %i, %want
    %wide = ext.u %hit, to i64
    %mask = sub i64 0, %wide
    %kept = and %v, %mask
    %sum = or %acc, %kept
    %next = add %i, i64 1
    br ^head(%next, %sum)
^done:
    ret %acc
}
