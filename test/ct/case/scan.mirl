# batch 1
# a lookup at a secret index that reads every entry of the table at public addresses and keeps the one it wants by a mask
#[align(8)] var table: [256]i64 = zero;

#[oblivious] pub fun probe(x: ^i64) i64 {
    val want: ^i64 = and(x, 255);
    br head(0, 0);
head(i: i64, acc: ^i64):
    val more: i1 = lt.u(i, 256);
    cbr(more) body, done;
body:
    val at: ptr = ptr.index[[256]i64](?table, i);
    val v: i64 = load[i64](at);
    val hit: ^i1 = eq(i, want);
    val wide: ^i64 = ext.u[i64](hit);
    val mask: ^i64 = sub(0, wide);
    val kept: ^i64 = and(v, mask);
    val sum: ^i64 = or(acc, kept);
    val next: i64 = add(i, 1);
    br head(next, sum);
done:
    ret(acc);
}
