; channel memory
; batch 1
; planted: a load from a table at a secret index
global @table: array<4096, i64> linkage local visibility default align 8 = array<4096, i64> zero

function @probe: fun(i64) -> (i64) linkage global visibility default {
^entry(%x: secret i64):
    %i = and %x, i64 4095
    %at = ptr.index ptr @table, %i, type array<4096, i64>
    %v = load %at, type i64, align 8 secret
    ret %v
}
