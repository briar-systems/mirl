# channel control
# batch 8
# planted: a compare that stops at the first byte that differs, a branch on a secret
pub fun probe(x: ^i64) i64 {
    br head(0);
head(i: i64):
    val more: i1 = lt.u(i, 8);
    cbr(more) body, same;
body:
    val by: i64 = mul(i, 8);
    val b: ^i64 = shr.u(x, by);
    val byte: ^i64 = and(b, 255);
    val differs: ^i1 = ne(byte, 0);
    cbr(differs) found(i), step;
step:
    val next: i64 = add(i, 1);
    br head(next);
found(at: i64):
    ret(at);
same:
    ret(8);
}
