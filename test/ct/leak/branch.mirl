; channel control
; batch 8
; planted: a compare that stops at the first byte that differs, a branch on a secret
function @probe: fun(i64) -> (i64) linkage global visibility default {
^entry(%x: secret i64):
    br ^head(i64 0)
^head(%i: i64):
    %more = lt.u %i, i64 8
    cbr %more, ^body, ^same
^body:
    %by = mul %i, i64 8
    %b = shr.u %x, %by
    %byte = and %b, i64 255
    %differs = ne %byte, i64 0
    cbr %differs, ^found(%i), ^step
^step:
    %next = add %i, i64 1
    br ^head(%next)
^found(%at: i64):
    ret %at
^same:
    ret i64 8
}
