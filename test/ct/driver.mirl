# the dudect driver test/ct/harness.sh links with each case: a body with no
# target statement, which the harness puts after the host's target statement and the
# case's own body, with $SLOTS, $ROUNDS, $INNER, $FIXED and $DRAWN filled in. it times batches of
# $INNER calls of probe in two classes, the fixed input $FIXED and drawn
# inputs, interleaved and in alternating order, after a warmup, and writes
# each round's two batch times as two i64 to standard output, the fixed
# class's first. $DRAWN is 1 for drawn inputs and 0 for the null control,
# whose second class is the fixed input again, sampled the same way.
# __ct_ticks, __ct_write and __mirl_exit are the host's, test/ct/clock-<arch>.s
#[align(8)] var records: [$SLOTS]i64 = zero;
#[align(8)] var sink: i64 = 0;

ext fun __ct_ticks() i64;

ext fun __ct_write(ptr, i64);

ext fun __mirl_exit(i64);

# the next xorshift draw after x
fun draw(x: i64) i64 {
    val a: i64 = shl(x, 13);
    val b: i64 = xor(x, a);
    val c: i64 = shr.u(b, 7);
    val d: i64 = xor(b, c);
    val e: i64 = shl(d, 17);
    val f: i64 = xor(d, e);
    ret(f);
}

# the ticks $INNER calls of probe on x take
fun batch(x: i64) i64 {
    val t0: i64 = call __ct_ticks();
    br head(0, 0);
head(i: i64, acc: i64):
    val more: i1 = lt.u(i, $INNER);
    cbr(more) body, done;
body:
    val r: i64 = call probe(x);
    val sum: i64 = add(acc, r);
    val next: i64 = add(i, 1);
    br head(next, sum);
done:
    val t1: i64 = call __ct_ticks();
    val old: i64 = load[i64](?sink);
    val kept: i64 = add(old, acc);
    store(?sink, kept);
    val took: i64 = sub(t1, t0);
    ret(took);
}

# the warmup, then $ROUNDS rounds of one batch of each class
fun run() i64 {
    br warm(0, 2685821657736338717);
warm(w: i64, ws: i64):
    val warming: i1 = lt.u(w, 64);
    cbr(warming) warmed, start(ws);
warmed:
    val wd: i64 = call draw(ws);
    val wf: i64 = call batch($FIXED);
    val wr: i64 = call batch(wd);
    val wn: i64 = add(w, 1);
    br warm(wn, wd);
start(seed: i64):
    br round(0, seed);
round(r: i64, s: i64):
    val going: i1 = lt.u(r, $ROUNDS);
    cbr(going) time, finish;
time:
    val drawn: i64 = call draw(s);
    val use: i1 = eq($DRAWN::i64, 1::i64);
    val input: i64 = select(use, drawn, $FIXED);
    val odd: i64 = and(r, 1);
    val even: i1 = eq(odd, 0);
    cbr(even) fixed_first, drawn_first;
fixed_first:
    val f1: i64 = call batch($FIXED);
    val d1: i64 = call batch(input);
    br store(f1, d1);
drawn_first:
    val d2: i64 = call batch(input);
    val f2: i64 = call batch($FIXED);
    br store(f2, d2);
store(tf: i64, tr: i64):
    val slot: i64 = shl(r, 1);
    val at: ptr = ptr.index[[$SLOTS]i64](?records, slot);
    store(at, tf);
    val slot1: i64 = add(slot, 1);
    val at1: ptr = ptr.index[[$SLOTS]i64](?records, slot1);
    store(at1, tr);
    val rn: i64 = add(r, 1);
    br round(rn, drawn);
finish:
    val bytes: i64 = mul($ROUNDS, 16);
    call __ct_write(?records, bytes);
    ret(0);
}

#[export] pub fun _start() {
    val r: i64 = call run();
    call __mirl_exit(r);
    unreachable();
}
