; the dudect driver test/ct/harness.sh links with each case: a body with no
; target line, which the harness puts after the host's target line and the
; case's own body, with $SLOTS, $ROUNDS, $INNER, $FIXED and $DRAWN filled in. it times batches of
; $INNER calls of @probe in two classes, the fixed input $FIXED and drawn
; inputs, interleaved and in alternating order, after a warmup, and writes
; each round's two batch times as two i64 to standard output, the fixed
; class's first. $DRAWN is 1 for drawn inputs and 0 for the null control,
; whose second class is the fixed input again, sampled the same way.
; @__ct_ticks, @__ct_write and @__mirl_exit are the host's, test/ct/clock-<arch>.s

global @records: array<$SLOTS, i64> linkage local visibility default align 8 = array<$SLOTS, i64> zero

global @sink: i64 linkage local visibility default align 8 = i64 0

function @__ct_ticks: fun() -> (i64) linkage global visibility default

function @__ct_write: fun(ptr, i64) -> () linkage global visibility default

function @__mirl_exit: fun(i64) -> () linkage global visibility default

; the next xorshift draw after %x
function @draw: fun(i64) -> (i64) linkage local visibility default {
^entry(%x: i64):
    %a = shl %x, i64 13
    %b = xor %x, %a
    %c = shr.u %b, i64 7
    %d = xor %b, %c
    %e = shl %d, i64 17
    %f = xor %d, %e
    ret %f
}

; the ticks $INNER calls of @probe on %x take
function @batch: fun(i64) -> (i64) linkage local visibility default {
^entry(%x: i64):
    %t0 = call ptr @__ct_ticks, signature fun() -> (i64), named all
    br ^head(i64 0, i64 0)
^head(%i: i64, %acc: i64):
    %more = lt.u %i, i64 $INNER
    cbr %more, ^body, ^done
^body:
    %r = call ptr @probe, %x, signature fun(i64) -> (i64), named all
    %sum = add %acc, %r
    %next = add %i, i64 1
    br ^head(%next, %sum)
^done:
    %t1 = call ptr @__ct_ticks, signature fun() -> (i64), named all
    %old = load ptr @sink, type i64, align 8
    %kept = add %old, %acc
    store ptr @sink, %kept, align 8
    %took = sub %t1, %t0
    ret %took
}

; the warmup, then $ROUNDS rounds of one batch of each class
function @run: fun() -> (i64) linkage local visibility default {
^entry:
    br ^warm(i64 0, i64 2685821657736338717)
^warm(%w: i64, %ws: i64):
    %warming = lt.u %w, i64 64
    cbr %warming, ^warmed, ^start(%ws)
^warmed:
    %wd = call ptr @draw, %ws, signature fun(i64) -> (i64), named all
    %wf = call ptr @batch, i64 $FIXED, signature fun(i64) -> (i64), named all
    %wr = call ptr @batch, %wd, signature fun(i64) -> (i64), named all
    %wn = add %w, i64 1
    br ^warm(%wn, %wd)
^start(%seed: i64):
    br ^round(i64 0, %seed)
^round(%r: i64, %s: i64):
    %going = lt.u %r, i64 $ROUNDS
    cbr %going, ^time, ^finish
^time:
    %drawn = call ptr @draw, %s, signature fun(i64) -> (i64), named all
    %use = eq i64 $DRAWN, i64 1
    %input = select %use, %drawn, i64 $FIXED
    %odd = and %r, i64 1
    %even = eq %odd, i64 0
    cbr %even, ^fixed_first, ^drawn_first
^fixed_first:
    %f1 = call ptr @batch, i64 $FIXED, signature fun(i64) -> (i64), named all
    %d1 = call ptr @batch, %input, signature fun(i64) -> (i64), named all
    br ^store(%f1, %d1)
^drawn_first:
    %d2 = call ptr @batch, %input, signature fun(i64) -> (i64), named all
    %f2 = call ptr @batch, i64 $FIXED, signature fun(i64) -> (i64), named all
    br ^store(%f2, %d2)
^store(%tf: i64, %tr: i64):
    %slot = shl %r, i64 1
    %at = ptr.index ptr @records, %slot, type array<$SLOTS, i64>
    store %at, %tf, align 8
    %slot1 = add %slot, i64 1
    %at1 = ptr.index ptr @records, %slot1, type array<$SLOTS, i64>
    store %at1, %tr, align 8
    %rn = add %r, i64 1
    br ^round(%rn, %drawn)
^finish:
    %bytes = mul i64 $ROUNDS, i64 16
    call ptr @__ct_write, ptr @records, %bytes, signature fun(ptr, i64) -> (), named all
    ret i64 0
}

export function @_start: fun() -> () linkage global visibility default {
^entry:
    %r = call ptr @run, signature fun() -> (i64), named all
    call ptr @__mirl_exit, %r, signature fun(i64) -> (), named all
    unreachable
}
