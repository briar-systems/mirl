target "riscv64-linux"

; the high half of a 64 bit product, signed and unsigned, each written as the product of the extended operands shifted down and truncated, selects to one multiply
function @high: fun(i64, i64, ptr) -> () placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {
^entry(%x: i64, %y: i64, %p: ptr):
    %a = ext.s %x, to i128
    %b = ext.s %y, to i128
    %m = mul %a, %b
    %s = shr.s %m, i128 64
    %h = trunc %s, to i64
    store %p, %h, align 8
    %c = ext.u %x, to i128
    %d = ext.u %y, to i128
    %n = mul %c, %d
    %t = shr.u %n, i128 64
    %i = trunc %t, to i64
    store %p, %i, align 8
    ret.placed places []
}

; signed times unsigned, in each order of the operands of the multiply, both selecting to mulhsu with the signed operand first
function @mixed: fun(i64, i64, ptr) -> () placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {
^entry(%x: i64, %y: i64, %p: ptr):
    %a = ext.s %x, to i128
    %b = ext.u %y, to i128
    %m = mul %a, %b
    %s = shr.u %m, i128 64
    %h = trunc %s, to i64
    store %p, %h, align 8
    %c = ext.u %y, to i128
    %d = ext.s %x, to i128
    %n = mul %c, %d
    %t = shr.s %n, i128 64
    %i = trunc %t, to i64
    store %p, %i, align 8
    ret.placed places []
}
