target "riscv64" "freestanding" "lp64" "rv64imac"

; a binary64 sum on the soft float row, which its baseline holds no unit for and a build that adds d computes in the float registers
function @f: fun(ptr, ptr) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact] {
^entry(%p: ptr, %q: ptr):
    %a = load %p, type binary64, align 8
    %b = load %q, type binary64, align 8
    %s = fadd %a, %b
    store %p, %s, align 8
    ret.placed places []
}
