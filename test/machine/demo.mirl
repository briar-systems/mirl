target "mtest"

!f0 = file "demo.mach"
!l0 = location !f0 3:1
!l1 = location !f0 4:2
!s0 = site !l1 "inner"
!t0 = type "i32" "i32" base signed 32
!v0 = variable "x" !t0 declared !l0 value
!v1 = variable "y" !t0 declared !l1 value

global @g: i32 linkage global visibility default

function @f: fun(i32) -> (i32) {
^entry(%a: i32):
    ret %a
}

function @h: fun(i32) -> (i32) {
^entry(%a: i32):
    ret %a
}
