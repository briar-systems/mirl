target "riscv32-linux"

function @g {
    virtual %0: class 0
    virtual %1: class 0
    virtual %2: class 0
    virtual %3: class 0
    virtual %4: class 0
^0:
    blt %0, %1, ^1
    jal x0, ^2
^1:
    lui %3, 74565
    addi %3, %3, 1656
    add %2, %0, %3
    sw %4, %2, 0
    jalr x0, x1, 0
^2:
    jalr x0, x1, 0
}
