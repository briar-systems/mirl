target "riscv32" "linux" "ilp32d" "rv32gc"

function @g {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    blt %0, %1, ^1
    jal x0, ^2
^1:
    lui %4, 74565
    addi %4, %4, 1656
    add %3, %0, %4
    sw %2, %3, 0
    jalr x0, x1, 0
^2:
    jalr x0, x1, 0
}
