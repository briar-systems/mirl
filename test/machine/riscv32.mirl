target "riscv32-linux"

; the same compare, constant and 32 bit add on a 32 bit register, which take the plain forms
function @g: fun(i32, i32, ptr) -> () linkage global visibility default placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {
^entry(%a: i32, %b: i32, %p: ptr):
    %c = lt.s %a, %b
    cbr %c, ^l, ^r
^l:
    %v = add %a, i32 305419896
    store %p, %v, align 4
    ret.placed places []
^r:
    ret.placed places []
}
