target "riscv64-linux"

function @f {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    virtual %7: class x
    virtual %8: class x
    virtual %9: class x
    virtual %10: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    xori %3, %1, -1
    and %4, %0, %3
    slli %5, %0, 56
    srai %6, %5, 56
    addi %7, %6, 0
    add %8, %4, %7
    slli %9, %8, 3
    add %10, %9, %8
    sd %2, %10, 0
    jalr x0, x1, 0
}

function @g {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    addiw %3, %0, 0
    addiw %4, %1, 0
    blt %3, %4, ^1
    jal x0, ^2
^1:
    lui %6, 74565
    addiw %6, %6, 1656
    addw %5, %3, %6
    sw %2, %5, 0
    jalr x0, x1, 0
^2:
    jalr x0, x1, 0
}
