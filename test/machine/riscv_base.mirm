target "riscv64-linux"

function @f {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    virtual %7: class x
    virtual %8: class x
    virtual %9: class x
    virtual %10: class x
^0:
    xori %0, %1, -1
    and %2, %3, %0
    slli %4, %3, 56
    srai %5, %4, 56
    addi %6, %5, 0
    add %7, %2, %6
    slli %8, %7, 3
    add %9, %8, %7
    sd %10, %9, 0
    jalr x0, x1, 0
}

function @g {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    blt %0, %1, ^1
    jal x0, ^2
^1:
    lui %3, 74565
    addiw %3, %3, 1656
    addw %2, %0, %3
    sw %4, %2, 0
    jalr x0, x1, 0
^2:
    jalr x0, x1, 0
}
