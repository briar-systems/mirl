target "riscv64-linux"

function @f {
    virtual %0: class 0
    virtual %1: class 0
    virtual %2: class 0
    virtual %3: class 0
    virtual %4: class 0
    virtual %5: class 0
    virtual %6: class 0
    virtual %7: class 0
    virtual %8: class 0
    virtual %9: class 0
    virtual %10: class 0
^0:
    xori %0, %1, -1
    and %2, %3, %0
    slli<1> %4, %3, 56
    srai<1> %5, %4, 56
    addi %6, %5, 0
    add %7, %2, %6
    slli<1> %8, %7, 3
    add %9, %8, %7
    sd<1> %10, %9, 0
    jalr x0, x1, 0
}

function @g {
    virtual %0: class 0
    virtual %1: class 0
    virtual %2: class 0
    virtual %3: class 0
    virtual %4: class 0
^0:
    blt %0, %1, ^1
    jal x0, ^2
^1:
    lui %3, 74565
    addiw %3, %3, 1656
    addw %2, %0, %3
    sw %4, %2, 0
    jalr x0, x1, 0
^2:
    jalr x0, x1, 0
}
