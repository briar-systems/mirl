target "riscv64" "linux" "gnu" "lp64d" "rv64gc"

function @high placed [register x10 fixed exact, register x11 fixed exact, register x12 fixed exact] {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    mulh %3, %0, %1
    sd %2, %3, 0
    mulhu %4, %0, %1
    sd %2, %4, 0
    jalr x0, x1, 0
}

function @mixed placed [register x10 fixed exact, register x11 fixed exact, register x12 fixed exact] {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    mulhsu %3, %0, %1
    sd %2, %3, 0
    mulhsu %4, %0, %1
    sd %2, %4, 0
    jalr x0, x1, 0
}
