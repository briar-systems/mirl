target "riscv64-linux"

function @high {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    mulh %0, %1, %2
    sd %3, %0, 0
    mulhu %4, %1, %2
    sd %3, %4, 0
    jalr x0, x1, 0
}

function @mixed {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
^0:
    mulhsu %0, %1, %2
    sd %3, %0, 0
    mulhsu %4, %1, %2
    sd %3, %4, 0
    jalr x0, x1, 0
}
