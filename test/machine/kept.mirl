target "riscv64-linux"

; kept stores that wipe a buffer, beside a plain store of the same secret, which selection keeps whole and in order
function @wipe: fun(i64, ptr) -> () linkage global visibility default constant_time placed [register 0 10 fixed exact, register 0 11 fixed exact] {
^entry(%key: secret i64, %buf: ptr):
    store %buf, %key, align 8
    store %buf, %key, align 8 kept
    store %buf, i64 0, align 8 kept
    ret.placed places []
}
