target "riscv64-linux"

; a multiply, a masked-off operand, a narrowing and a scaled add that the m, zba and zbb extensions select as one instruction each
function @f: fun(i64, i64, ptr) -> () {
^entry(%x: i64, %y: i64, %p: ptr):
    %m = mul %x, %y
    %n = not %y
    %a = and %x, %n
    %t = trunc %m, to i8
    %e = ext.s %t, to i64
    %s = add %a, %e
    %k = mul %s, i64 9
    %c = clz %k
    store %p, %c, align 8
    ret
}
