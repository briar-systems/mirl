target "riscv64-linux"

; the same operations without those extensions, each in the base instructions, but a multiply of two registers, which has no base form
function @f: fun(i64, i64, ptr) -> () placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {
^entry(%x: i64, %y: i64, %p: ptr):
    %n = not %y
    %a = and %x, %n
    %t = trunc %x, to i8
    %e = ext.s %t, to i64
    %s = add %a, %e
    %k = mul %s, i64 9
    store %p, %k, align 8
    ret.placed places []
}

; a compare that only a branch uses, a constant of two instructions, and 32 bit operations that use the word forms
function @g: fun(i32, i32, ptr) -> () placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact] {
^entry(%x: i64, %y: i64, %p: ptr):
    %a = trunc %x, to i32
    %b = trunc %y, to i32
    %c = lt.s %a, %b
    cbr %c, ^l, ^r
^l:
    %v = add %a, i32 305419896
    store %p, %v, align 4
    ret.placed places []
^r:
    ret.placed places []
}
