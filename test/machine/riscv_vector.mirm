target "riscv64-linux"

function @widen {
    virtual %0: class v
    virtual %1: class v
    virtual %2: class v
    virtual %3: class v
^0:
    vl2re8.v %0, x10
    vwadd.vv %1, %0, %0, 1 vtype e32, m1, ta, ma
    vzext.vf4 %2, %0, 1 vtype e16, mf2, tu, mu
    vrgatherei16.vv %3, %1, %0, 0 vtype e64, m8, ta, mu
    jalr x0, x1, 0
}
