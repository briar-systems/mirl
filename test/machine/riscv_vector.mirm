target "riscv64" "linux" "gnu" "lp64d" "rv64gc"

function @widen {
    virtual %0: class vg2
    virtual %1: class v
    virtual %2: class vg2
    virtual %3: class v
    virtual %4: class vg8
    virtual %5: class vg8
^0:
    vl2re8.v %0, x10
    vl1re8.v %1, x11
    vl8re8.v %5, x12
    vwadd.vv %2, %1, %1, 1 vtype e32, m1, ta, ma
    vzext.vf4 %3, %1, 1 vtype e16, mf2, tu, mu
    vrgatherei16.vv %4, %5, %0, 0 vtype e64, m8, ta, mu
    jalr x0, x1, 0
}
