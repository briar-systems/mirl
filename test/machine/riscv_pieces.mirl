target "riscv64" "linux" "lp64d" "rv64gc"

function @two: fun(i64) -> (i64, i64) linkage global visibility default

function @sink: fun(i64, i64) -> () linkage global visibility default

; a call whose second result comes back on the stack, read from the outgoing area after the call
function @caller: fun(i64) -> (i64) linkage global visibility default placed [register 0 10 fixed exact] {
^entry(%x: i64):
    %a, %b = call.placed ptr @two, %x, signature fun(i64) -> (i64, i64), places [register 0 10 fixed exact, register 0 10 fixed exact, stack 0 fixed exact]
    %s = add %a, %b
    ret.placed %s, places [register 0 10 fixed exact]
}

; a return that leaves its second result on the stack, in the incoming area its caller passes
function @callee: fun(i64) -> (i64, i64) linkage global visibility default placed [register 0 10 fixed exact] {
^entry(%x: i64):
    ret.placed %x, %x, places [register 0 10 fixed exact, stack 0 fixed exact]
}

; an entry whose second parameter arrives at an offset that scales, and a call that passes a piece whose size scales
function @scaled: fun(i64, i64) -> () linkage global visibility default placed [register 0 10 fixed exact, stack scaled 0 16 fixed exact] {
^entry(%a: i64, %b: i64):
    call.placed ptr @sink, %a, %b, signature fun(i64, i64) -> (), places [register 0 10 fixed exact, stack 0 scaled 0 exact]
    ret.placed places []
}
