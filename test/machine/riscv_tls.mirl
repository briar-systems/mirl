target "riscv64-linux"

global @le: i64 linkage global visibility default tls local_exec = i64 0
global @ie: i64 linkage global visibility default tls initial_exec = i64 0
global @ld: i64 linkage global visibility default tls local_dynamic = i64 0
global @gd: i64 linkage global visibility default tls general_dynamic = i64 0
global @own: i64 linkage local visibility default = i64 0
global @other: i64 linkage global visibility default
function @__tls_get_addr: fun(ptr) -> (ptr)

; the address of a variable of each thread-local model, then of a variable the module defines and one another module does, under the position independent executable model
function @addresses: fun(ptr) -> () placed [register 0 10 fixed exact] {
^entry(%p: ptr):
    store %p, ptr @le, align 8
    store %p, ptr @ie, align 8
    store %p, ptr @ld, align 8
    store %p, ptr @gd, align 8
    store %p, ptr @own, align 8
    store %p, ptr @other, align 8
    ret.placed places []
}
