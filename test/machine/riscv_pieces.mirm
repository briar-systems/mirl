target "riscv64" "linux" "gnu" "lp64d" "rv64gc"

function @caller placed [register x10 fixed exact] {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    slot [0]: size 8 align 8 outgoing 0
^0:
    pseudo copy %0, x10
    pseudo copy x10, %0
    auipc x1, @two : call_plt_pair
    jalr x1, x1, 0 reads [x10] writes [x10] places [register x10 fixed exact, register x10 fixed exact, stack 0 fixed exact]
    pseudo copy %1, x10
    pseudo reload %2, [0]
    add %3, %1, %2
    pseudo copy x10, %3
    jalr x0, x1, 0 reads [x10]
}

function @callee placed [register x10 fixed exact] {
    virtual %0: class x
    slot [0]: size 8 align 8 incoming 0
^0:
    pseudo copy %0, x10
    pseudo copy x10, %0
    pseudo spill [0], %0
    jalr x0, x1, 0 reads [x10]
}

function @scaled placed [register x10 fixed exact, stack scaled 0 16 fixed exact] {
    virtual %0: class x
    virtual %1: class x
    slot [0]: size 8 per 0 scale 0 align 8 incoming 0 per 16
    slot [1]: size 0 per 8 scale 0 align 8 outgoing 0
^0:
    pseudo copy %0, x10
    pseudo reload %1, [0]
    pseudo copy x10, %0
    pseudo spill [1], %1
    auipc x1, @sink : call_plt_pair
    jalr x1, x1, 0 reads [x10] places [register x10 fixed exact, stack 0 scaled 0 exact]
    jalr x0, x1, 0
}
