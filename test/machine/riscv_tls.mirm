target "riscv64" "linux" "lp64d" "rv64gc"

function @addresses {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
^0:
    pseudo copy %0, x10
    lui %1, @le : tprel_hi20
    add %1, %1, x4
    addi %1, %1, @le : tprel_lo12_i
    sd %0, %1, 0
    auipc %2, @ie : tls_got_pcrel_hi20 label 0
    ld %2, %2, partner 0 : pcrel_lo12_i
    add %2, %2, x4
    sd %0, %2, 0
    auipc x10, @ld : tls_gd_pcrel_hi20 label 1
    addi x10, x10, partner 1 : pcrel_lo12_i
    auipc x1, @__tls_get_addr : call_plt_pair
    jalr x1, x1, 0 reads [x10] writes [x10]
    addi %3, x10, 0
    sd %0, %3, 0
    auipc x10, @gd : tls_gd_pcrel_hi20 label 2
    addi x10, x10, partner 2 : pcrel_lo12_i
    auipc x1, @__tls_get_addr : call_plt_pair
    jalr x1, x1, 0 reads [x10] writes [x10]
    addi %4, x10, 0
    sd %0, %4, 0
    auipc %5, @own : pcrel_hi20 label 3
    addi %5, %5, partner 3 : pcrel_lo12_i
    sd %0, %5, 0
    auipc %6, @other : got_pcrel_hi20 label 4
    ld %6, %6, partner 4 : pcrel_lo12_i
    sd %0, %6, 0
    jalr x0, x1, 0
}
