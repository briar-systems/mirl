target "mtest"

; every kind of operand and every part of the metadata record
function @f {
    virtual %0: class 0
    virtual %1: class 0
    virtual %2: class 0
    virtual %3: memory 0
    slot [0]: size 4 align 4
    slot [1]: size 8 align 8
^0:
    load %0, [0] loc !l0
    load %1, @g + 8 : abs32
    load r2, {0: 3}
    add %1 = %0, %2 loc !l1 site !s0 secret bind [!v0, !v1]
    load %2, [0] volatile kept declassifies
    add r2 = r2, r1 volatile
    wide r0, r1, r3
    pseudo copy %3, %2
    pseudo spill [1], %3
    pseudo reload %2, [1]
    pseudo parallel_copy %0, %1, %1, %0
    pseudo frame_setup
    bnz %1, ^2
    jump ^1
^1:
    add %2 = %2, %0
    bnz %2, ^1
    jump @h - 4 : pc32
^2:
    jump @f : pc32
}

function @h {
^0:
    jump ^0
}
