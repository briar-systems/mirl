target "riscv64" "linux" "lp64d" "rv64gc"

function @caller {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    slot [0]: size 8 align 8
    slot [1]: size 8 align 8 outgoing 0
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo address %2, [0]
    sd %2, %1, 0
    addi %3, x0, 9
    pseudo copy x10, %1
    pseudo copy x11, %1
    pseudo copy x12, %1
    pseudo copy x13, %1
    pseudo copy x14, %1
    pseudo copy x15, %1
    pseudo copy x16, %1
    pseudo copy x17, %1
    pseudo spill [1], %3
    auipc x1, @callee : call_plt_pair
    jalr x1, x1, 0 reads [x10, x11, x12, x13, x14, x15, x16, x17] writes [x10]
    pseudo copy %4, x10
    pseudo copy x10, %2
    jalr x1, %0, 0 reads [x10] writes [x10]
    pseudo copy %5, x10
    add %6, %4, %5
    pseudo copy x10, %6
    jalr x0, x1, 0 reads [x10]
}

function @wide {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    virtual %7: class x
    virtual %8: class x
    virtual %9: class x
    slot [0]: size 8 align 8 incoming 0
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    pseudo copy %3, x13
    pseudo copy %4, x14
    pseudo copy %5, x15
    pseudo copy %6, x16
    pseudo copy %7, x17
    pseudo reload %8, [0]
    add %9, %0, %8
    pseudo copy x10, %9
    jalr x0, x1, 0 reads [x10]
}
