target "riscv64-linux"

function @callee: fun(i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64)

; a direct call with eight arguments in registers, a ninth on the stack and a result, an indirect call passing the address of a slot, and a return
function @caller: fun(ptr, i64) -> (i64) placed [register 0 10 fixed exact, register 0 11 fixed exact] {
^entry(%f: ptr, %x: i64):
    %s = alloca type i64, pointer ptr, align 8
    store %s, %x, align 8
    %r = call.placed ptr @callee, %x, %x, %x, %x, %x, %x, %x, %x, i64 9, signature fun(i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64), places [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact, register 0 13 fixed exact, register 0 14 fixed exact, register 0 15 fixed exact, register 0 16 fixed exact, register 0 17 fixed exact, stack 0 fixed exact, register 0 10 fixed exact]
    %q = call.placed %f, %s, signature fun(ptr) -> (i64), places [register 0 10 fixed exact, register 0 10 fixed exact]
    %t = add %r, %q
    ret.placed %t, places [register 0 10 fixed exact]
}

; an entry whose ninth parameter arrives on the stack
function @wide: fun(i64, i64, i64, i64, i64, i64, i64, i64, i64) -> (i64) placed [register 0 10 fixed exact, register 0 11 fixed exact, register 0 12 fixed exact, register 0 13 fixed exact, register 0 14 fixed exact, register 0 15 fixed exact, register 0 16 fixed exact, register 0 17 fixed exact, stack 0 fixed exact] {
^entry(%a: i64, %b: i64, %c: i64, %d: i64, %e: i64, %f: i64, %g: i64, %h: i64, %i: i64):
    %s = add %a, %i
    ret.placed %s, places [register 0 10 fixed exact]
}
