target "riscv64-linux"

function @f {
    virtual %0: class 0
    virtual %1: class 0
    virtual %2: class 0
    virtual %3: class 0
    virtual %4: class 0
    virtual %5: class 0
    virtual %6: class 0
    virtual %7: class 0
    virtual %8: class 0
    virtual %9: class 0
^0:
    mul %0, %1, %2
    andn %3, %1, %2
    sext.b %4, %0
    addi %5, %4, 0
    add %6, %3, %5
    sh3add %7, %6, %6
    clz %8, %7
    sd<1> %9, %8, 0
    jalr x0, x1, 0
}
