target "riscv64-linux"

function @f {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    virtual %7: class x
    virtual %8: class x
    virtual %9: class x
^0:
    mul %0, %1, %2
    andn %3, %1, %2
    sext.b %4, %0
    addi %5, %4, 0
    add %6, %3, %5
    sh3add %7, %6, %6
    clz %8, %7
    sd %9, %8, 0
    jalr x0, x1, 0
}
