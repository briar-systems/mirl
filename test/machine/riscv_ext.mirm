target "riscv64" "linux" "lp64d" "rv64gc"

function @f {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class x
    virtual %3: class x
    virtual %4: class x
    virtual %5: class x
    virtual %6: class x
    virtual %7: class x
    virtual %8: class x
    virtual %9: class x
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    pseudo copy %2, x12
    mul %3, %0, %1
    andn %4, %0, %1
    sext.b %5, %3
    addi %6, %5, 0
    add %7, %4, %6
    sh3add %8, %7, %7
    clz %9, %8
    sd %2, %9, 0
    jalr x0, x1, 0
}
