target "riscv64" "freestanding" "lp64" "rv64imac"

function @f {
    virtual %0: class x
    virtual %1: class x
    virtual %2: class f
    virtual %3: class f
    virtual %4: class f
^0:
    pseudo copy %0, x10
    pseudo copy %1, x11
    fld %2, %0, 0
    fld %3, %1, 0
    fadd.d %4, %2, %3, 7
    fsd %0, %4, 0
    jalr x0, x1, 0
}
